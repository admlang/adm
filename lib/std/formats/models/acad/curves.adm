internal partial module std.formats.models.acad {
	use std.math::(*)

	// The most segments a full turn is cut into, whatever the tolerance.
	const maxTurnSegments = 16384

	// The most times a span of a spline is halved.
	const maxSplineDepth = 16

	// Plane is the coordinate system of an entity drawn in a plane: the
	// axes the arbitrary axis algorithm gives the plane's normal.
	type Plane {
		xx    float = 1.0
		xy    float
		xz    float
		yx    float
		yy    float = 1.0
		yz    float
		zx    float
		zy    float
		zz    float = 1.0
		// The normal is +z: plane coordinates are the drawing's own.
		world bool  = true

		def new(nx float, ny float, nz float) {
			let length = sqrt(nx * nx + ny * ny + nz * nz)
			return when length == 0 || (nx == 0 && ny == 0 && nz > 0)
			world = false
			zx = nx / length
			zy = ny / length
			zz = nz / length
			// The x axis is across the normal and the world's y axis when
			// the normal is close to the world's z axis, else across the
			// normal and the world's z axis.
			if zx.abs() < 1.0 / 64.0 && zy.abs() < 1.0 / 64.0 {
				xx = zz
				xy = 0
				xz = -zx
			} else {
				xx = -zy
				xy = zx
				xz = 0
			}
			let across = sqrt(xx * xx + xy * xy + xz * xz)
			xx /= across
			xy /= across
			xz /= across
			yx = zy * xz - zz * xy
			yy = zz * xx - zx * xz
			yz = zx * xy - zy * xx
		}

		// push appends the drawing coordinates of a point of the plane.
		def push(out float[], x float, y float, z float) {
			if world {
				out.push(x, y, z)
				return
			}
			out.push(x * xx + y * yx + z * zx, x * xy + y * yy + z * zy, x * xz + y * yz + z * zz)
		}
	}

	// arcSegments is how many chords an arc of the radius over the sweep
	// (radians) is cut into for none to stray further than the tolerance
	// from it: at least one every eighth of a turn.
	def arcSegments(radius float, sweep float, tolerance float) int {
		let turn = sweep.abs() / Tau
		let most = (turn * float(maxTurnSegments)).ceil().max(1.0)
		let least = (turn * 8.0).ceil().max(1.0)
		return int(most) when tolerance <= 0 || radius <= 0
		return int(least) when tolerance >= radius
		// A chord over the angle a is radius * (1 - cos(a / 2)) from its arc.
		let step = 2.0 * acos(1.0 - tolerance / radius)
		return int((sweep.abs() / step).ceil().clamp(least, most))
	}

	// flattenArc appends the points of an arc in the plane, at the height
	// z: from the angle `start` over `sweep` radians (negative clockwise),
	// without its first point when `first` is false, so arcs chain.
	def flattenArc(out float[], plane Plane, cx float, cy float, z float, radius float, start float, sweep float, tolerance float, first bool) {
		let count = arcSegments(radius, sweep, tolerance)
		for let k = first ?? (0, 1); k <= count; k++ {
			let a = start + sweep * float(k) / float(count)
			plane.push(out, cx + radius * cos(a), cy + radius * sin(a), z)
		}
	}

	// flattenBulge appends the points after (x0, y0) of the arc to (x1, y1)
	// whose bulge is the tangent of a quarter of its angle, positive
	// counter-clockwise; the end point alone for a bulge of 0.
	def flattenBulge(out float[], plane Plane, x0 float, y0 float, x1 float, y1 float, z float, bulge float, tolerance float) {
		let dx = x1 - x0
		let dy = y1 - y0
		let chord = sqrt(dx * dx + dy * dy)
		if bulge == 0 || chord == 0 {
			plane.push(out, x1, y1, z)
			return
		}
		// The centre lies on the chord's bisector, to its left for a
		// counter-clockwise arc of less than half a turn.
		let along = (1.0 - bulge * bulge) / (4.0 * bulge)
		let cx = (x0 + x1) / 2.0 - dy * along
		let cy = (y0 + y1) / 2.0 + dx * along
		let radius = chord * (1.0 + bulge * bulge) / (4.0 * bulge.abs())
		let count = arcSegments(radius, 4.0 * atan(bulge), tolerance)
		let start = atan2(y0 - cy, x0 - cx)
		let sweep = 4.0 * atan(bulge)
		for let k = 1; k < count; k++ {
			let a = start + sweep * float(k) / float(count)
			plane.push(out, cx + radius * cos(a), cy + radius * sin(a), z)
		}
		// The end as the file has it, not as the angles round it.
		plane.push(out, x1, y1, z)
	}

	// flattenEllipse appends the points of an elliptical arc: the centre
	// and the major axis in drawing coordinates, the minor axis across the
	// normal and the major one, `ratio` as long; from the parameter t0
	// counter-clockwise to t1, a whole ellipse when they are a turn apart
	// or equal.
	def flattenEllipse(out float[], e Entity, tolerance float) {
		let p = e.points
		let length = sqrt(e.nx * e.nx + e.ny * e.ny + e.nz * e.nz)
		let nx = length == 0 ?? (0.0, e.nx / length)
		let ny = length == 0 ?? (0.0, e.ny / length)
		let nz = length == 0 ?? (1.0, e.nz / length)
		let mx = p[3]
		let my = p[4]
		let mz = p[5]
		let bx = (ny * mz - nz * my) * e.ratio
		let by = (nz * mx - nx * mz) * e.ratio
		let bz = (nx * my - ny * mx) * e.ratio
		let sweep = e.end - e.start
		for sweep <= 0 {
			sweep += Tau
		}
		sweep = Tau when sweep > Tau
		// The ellipse is a circle of the major radius squeezed along one
		// axis, which brings its chords no further from it.
		let count = arcSegments(sqrt(mx * mx + my * my + mz * mz), sweep, tolerance)
		for let k = 0; k <= count; k++ {
			let t = e.start + sweep * float(k) / float(count)
			let c = cos(t)
			let s = sin(t)
			out.push(p[0] + mx * c + bx * s, p[1] + my * c + by * s, p[2] + mz * c + bz * s)
		}
	}

	// Nurbs evaluates a spline's curve from its control points, weights
	// and knots by de Boor's algorithm.
	type Nurbs {
		degree  int
		knots   float[]
		// x·w, y·w, z·w, w per control point.
		control float[]
		work    float[]
		// The point `at` found.
		x       float
		y       float
		z       float

		def new(degree int, knots float[], points float[], weights float[]) {
			self.degree = degree
			self.knots = knots
			let count = points.len() / 3
			control.len(count * 4)
			for let i = 0; i < count; i++ {
				let w = weights.len() == count && weights[i] > 0 ?? (weights[i], 1.0)
				control[i * 4] = points[i * 3] * w
				control[i * 4 + 1] = points[i * 3 + 1] * w
				control[i * 4 + 2] = points[i * 3 + 2] * w
				control[i * 4 + 3] = w
			}
			work.len((degree + 1) * 4)
		}

		// at sets x, y, z to the curve's point at the parameter u, which
		// lies in the knot span that starts at knot `span`.
		def at(span int, u float) {
			for let j = 0; j <= degree; j++ {
				let from = (span - degree + j) * 4
				work[j * 4] = control[from]
				work[j * 4 + 1] = control[from + 1]
				work[j * 4 + 2] = control[from + 2]
				work[j * 4 + 3] = control[from + 3]
			}
			for let r = 1; r <= degree; r++ {
				for let j = degree; j >= r; j-- {
					let low = knots[span - degree + j]
					let high = knots[span + 1 + j - r]
					let a = high == low ?? (0.0, (u - low) / (high - low))
					for let k = 0; k < 4; k++ {
						work[j * 4 + k] = (1.0 - a) * work[(j - 1) * 4 + k] + a * work[j * 4 + k]
					}
				}
			}
			let w = work[degree * 4 + 3]
			x = work[degree * 4] / w
			y = work[degree * 4 + 1] / w
			z = work[degree * 4 + 2] / w
		}
	}

	// offLine is how far the point is from the segment's line; from its
	// first end when the ends are one point.
	def offLine(px float, py float, pz float, ax float, ay float, az float, bx float, by float, bz float) float {
		let dx = bx - ax
		let dy = by - ay
		let dz = bz - az
		let ux = px - ax
		let uy = py - ay
		let uz = pz - az
		let length = sqrt(dx * dx + dy * dy + dz * dz)
		return sqrt(ux * ux + uy * uy + uz * uz) when length == 0
		let cx = uy * dz - uz * dy
		let cy = uz * dx - ux * dz
		let cz = ux * dy - uy * dx
		return sqrt(cx * cx + cy * cy + cz * cz) / length
	}

	// splitSpan appends the curve's points after u0 up to u1, both in the
	// span, halving while the middle strays from the chord by more than
	// the tolerance; `must` halvings are made whatever the middle says,
	// for a span that crosses its own chord. A tolerance of 0 is met by a
	// straight span only, so callers with none start `depth` near the
	// limit.
	def splitSpan(out float[], curve Nurbs, span int, u0 float, x0 float, y0 float, z0 float, u1 float, x1 float, y1 float, z1 float, tolerance float, depth int, must int) {
		let um = (u0 + u1) / 2.0
		curve.at(span, um)
		let xm = curve.x
		let ym = curve.y
		let zm = curve.z
		if depth >= maxSplineDepth || (must <= 0 && offLine(xm, ym, zm, x0, y0, z0, x1, y1, z1) <= tolerance) {
			out.push(x1, y1, z1)
			return
		}
		splitSpan(out, curve, span, u0, x0, y0, z0, um, xm, ym, zm, tolerance, depth + 1, must - 1)
		splitSpan(out, curve, span, um, xm, ym, zm, u1, x1, y1, z1, tolerance, depth + 1, must - 1)
	}

	// flattenSpline appends the points of a spline: its NURBS curve over
	// the knots' range when it has control points and knots that fit them
	// (clamped uniform knots are made when it has none), else the natural
	// cubic through its fit points; the control points themselves when
	// they are too few for the degree.
	def flattenSpline(out float[], e Entity, tolerance float) {
		let count = e.points.len() / 3
		if count == 0 {
			flattenFit(out, e, tolerance)
			return
		}
		let degree = e.degree.max(1)
		if count <= degree {
			out.push(...e.points)
			return
		}
		let knots = e.knots
		if knots.len() != count + degree + 1 {
			knots = float[]
			knots.len(count + degree + 1)
			for let i = 0; i < knots.len(); i++ {
				knots[i] = float((i - degree).clamp(0, count - degree))
			}
		}
		let curve = new Nurbs(degree, knots, e.points, e.weights)
		let started = false
		let x0 = 0.0
		let y0 = 0.0
		let z0 = 0.0
		// A cubic span may cross its chord at its middle; a parabola's
		// middle is its furthest point, and a line needs no halving.
		let must = degree >= 3 ?? (1, 0)
		let limit = tolerance <= 0 ?? (0.0, tolerance)
		for let span = degree; span < count; span++ {
			let u0 = knots[span]
			let u1 = knots[span + 1]
			continue when u1 <= u0
			if !started {
				curve.at(span, u0)
				x0 = curve.x
				y0 = curve.y
				z0 = curve.z
				out.push(x0, y0, z0)
				started = true
			}
			// The span's end is evaluated in the span, where the curve is
			// continuous from the left.
			curve.at(span, u1)
			let x1 = curve.x
			let y1 = curve.y
			let z1 = curve.z
			if degree == 1 {
				out.push(x1, y1, z1)
			} else {
				splitSpan(out, curve, span, u0, x0, y0, z0, u1, x1, y1, z1, limit, tolerance <= 0 ?? (maxSplineDepth - 6, 0), must)
			}
			x0 = x1
			y0 = y1
			z0 = z1
		}
	}

	// flattenFit appends the points of the natural cubic through the
	// spline's fit points, its parameter the length along their chords.
	def flattenFit(out float[], e Entity, tolerance float) {
		// The points without those that repeat the one before.
		let q float[]
		for let i = 0; i + 2 < e.fit.len(); i += 3 {
			let n = q.len()
			continue when n >= 3 && q[n - 3] == e.fit[i] && q[n - 2] == e.fit[i + 1] && q[n - 1] == e.fit[i + 2]
			q.push(e.fit[i], e.fit[i + 1], e.fit[i + 2])
		}
		q.push(q[0], q[1], q[2]) when e.closed && q.len() >= 9 && !(q[q.len() - 3] == q[0] && q[q.len() - 2] == q[1] && q[q.len() - 1] == q[2])
		let count = q.len() / 3
		if count < 3 {
			out.push(...q)
			return
		}
		let h float[]
		h.len(count - 1)
		for let i = 0; i + 1 < count; i++ {
			let dx = q[i * 3 + 3] - q[i * 3]
			let dy = q[i * 3 + 4] - q[i * 3 + 1]
			let dz = q[i * 3 + 5] - q[i * 3 + 2]
			h[i] = sqrt(dx * dx + dy * dy + dz * dz)
		}
		// The tangents at the points, from the tridiagonal system that
		// makes the second derivative continuous and zero at the ends.
		let tangents float[]
		tangents.len(count * 3)
		let diagonal float[]
		diagonal.len(count)
		let upper float[]
		upper.len(count)
		for let axis = 0; axis < 3; axis++ {
			diagonal[0] = 2.0
			upper[0] = 1.0
			tangents[axis] = 3.0 * (q[3 + axis] - q[axis]) / h[0]
			for let i = 1; i < count; i++ {
				let lower = i + 1 < count ?? (h[i], 1.0)
				let middle = i + 1 < count ?? (2.0 * (h[i - 1] + h[i]), 2.0)
				let right float
				if i + 1 < count {
					upper[i] = h[i - 1]
					right = 3.0 * (h[i] * (q[i * 3 + axis] - q[i * 3 - 3 + axis]) / h[i - 1] + h[i - 1] * (q[i * 3 + 3 + axis] - q[i * 3 + axis]) / h[i])
				} else {
					right = 3.0 * (q[i * 3 + axis] - q[i * 3 - 3 + axis]) / h[i - 1]
				}
				let factor = lower / diagonal[i - 1]
				diagonal[i] = middle - factor * upper[i - 1]
				tangents[i * 3 + axis] = right - factor * tangents[i * 3 - 3 + axis]
			}
			tangents[(count - 1) * 3 + axis] /= diagonal[count - 1]
			for let i = count - 2; i >= 0; i-- {
				tangents[i * 3 + axis] = (tangents[i * 3 + axis] - upper[i] * tangents[i * 3 + 3 + axis]) / diagonal[i]
			}
		}
		// Each piece is a Bézier curve, which is a spline of one span.
		out.push(q[0], q[1], q[2])
		let piece float[]
		piece.len(12)
		let limit = tolerance <= 0 ?? (0.0, tolerance)
		for let i = 0; i + 1 < count; i++ {
			for let axis = 0; axis < 3; axis++ {
				let a = q[i * 3 + axis]
				let b = q[i * 3 + 3 + axis]
				piece[axis] = a
				piece[3 + axis] = a + tangents[i * 3 + axis] * h[i] / 3.0
				piece[6 + axis] = b - tangents[i * 3 + 3 + axis] * h[i] / 3.0
				piece[9 + axis] = b
			}
			let curve = new Nurbs(3, float[0, 0, 0, 0, 1, 1, 1, 1], piece, float[])
			splitSpan(out, curve, 3, 0.0, piece[0], piece[1], piece[2], 1.0, piece[9], piece[10], piece[11], limit, tolerance <= 0 ?? (maxSplineDepth - 6, 0), 1)
		}
	}
}
