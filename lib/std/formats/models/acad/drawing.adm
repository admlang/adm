// The drawing AutoCAD's two files hold, DXF as groups of text or binary and
// DWG as a bit-coded object database: header variables, layers, blocks and
// the entities of model space; with the tessellation that makes a Model of
// one and the collection that makes one of a Model.
internal partial module std.formats.models.acad {
	// The colour numbers that name no colour of the table: the colour of the
	// INSERT that places the entity's block, and the colour of its layer.
	const colorByBlock = 0
	const colorByLayer = 256

	// EntityKind is what an Entity draws.
	enum EntityKind {
		// One position (POINT).
		Point,
		// A segment between two positions (LINE).
		Line,
		// A part of a circle in the entity's plane, counter-clockwise from
		// `start` to `end` (ARC).
		Arc,
		// A whole circle in the entity's plane (CIRCLE).
		Circle,
		// A part of an ellipse (ELLIPSE): `points` holds the centre and the
		// major axis' end relative to it, `ratio` the minor axis over the
		// major, `start` and `end` the parameters.
		Ellipse,
		// Vertices joined in order (LWPOLYLINE, POLYLINE): in the entity's
		// plane with bulges when `planar`, else in space.
		Polyline,
		// A NURBS curve of control points, or the curve through fit points
		// (SPLINE).
		Spline,
		// Three or four corners in space (3DFACE).
		Face,
		// Three or four corners in the entity's plane, around the outline
		// (SOLID, TRACE).
		Solid,
		// Vertices and the faces of up to four of them (POLYLINE as a
		// polyface mesh).
		PolyfaceMesh,
		// A grid of `m` by `n` vertices (POLYLINE as a polygon mesh).
		PolygonMesh,
		// Vertices and faces of any number of corners (MESH, its base level).
		SubdMesh,
		// A block placed, once or as a grid (INSERT).
		Insert,
	}

	// Entity is one drawn object of a drawing. The fields past the common
	// ones belong to the kinds their comments name.
	type Entity {
		kind          EntityKind
		layer         string     = "0"
		// The layer's place in Drawing.layers, once the drawing is bound.
		layerIndex    int        = 0
		// 1 to 255 a colour of the table, colorByBlock or colorByLayer.
		aci           int        = 256
		// A colour of its own as 0xRRGGBB, which then wins over `aci`; -1
		// for none.
		rgb           int        = -1
		// 0 see-through to 255 solid.
		alpha         int        = 255
		invisible     bool
		// On a paper space layout, not in the model.
		paper         bool
		// The height the entity is swept by along the normal, making a
		// surface of a curve; 0 for none.
		thickness     float
		// The normal of the entity's plane, which sets its coordinate
		// system by the arbitrary axis algorithm.
		nx            float      = 0.0
		ny            float      = 0.0
		nz            float      = 1.0
		// x, y, z per position: the corners, vertices or control points; a
		// centre; an insertion point.
		points        float[]
		// Polyline: per vertex, the tangent of a quarter of the angle of the
		// arc to the next vertex, 0 for a straight segment; empty for none.
		bulges        float[]
		// Polyline, Spline: the last vertex joins the first. PolygonMesh:
		// closed along m.
		closed        bool
		// PolygonMesh: closed along n.
		closedN       bool
		// Polyline: the vertices are in the entity's plane.
		planar        bool
		m             int
		n             int
		// PolyfaceMesh: four vertex numbers a face from 1, 0 for no fourth
		// (or third) corner, negative when the edge from it is hidden.
		// SubdMesh: per face the number of corners, then their vertices
		// from 0.
		faces         int[]
		// PolyfaceMesh: the colour number of each face, colorByLayer for
		// the entity's own; empty when no face has one.
		faceColors    int[]
		// Arc, Circle.
		radius        float
		// Arc: radians from the plane's x axis. Ellipse: parameters.
		start         float
		end           float
		ratio         float      = 1.0
		// Spline.
		degree        int        = 3
		knots         float[]
		// One per control point; empty when the curve is not rational.
		weights       float[]
		// x, y, z per point the curve passes through.
		fit           float[]
		// Insert: the block's name, its scales, its rotation in radians
		// about the normal, and the grid.
		name          string
		sx            float      = 1.0
		sy            float      = 1.0
		sz            float      = 1.0
		rotation      float
		columns       int        = 1
		rows          int        = 1
		columnSpacing float
		rowSpacing    float

		def new(kind EntityKind) {
			self.kind = kind
		}
	}

	// Layer is a named group of entities with the colour they take when
	// they have none of their own.
	type Layer {
		name   string
		aci    int    = 7
		rgb    int    = -1
		// Switched off, or frozen: not shown by the application.
		off    bool
		frozen bool

		def new(name string) {
			self.name = name
		}
	}

	// Block is a named group of entities an INSERT places, relative to the
	// block's base point.
	type Block {
		name     string
		baseX    float
		baseY    float
		baseZ    float
		entities Entity[]

		def new(name string) {
			self.name = name
			entities = Entity[]
		}
	}

	// Drawing is what a DXF or DWG file holds of a model.
	type Drawing {
		// The release that wrote it, as `$ACADVER` has it ("AC1032").
		version  string
		// Header variables by name without the `$`, as text; the parts of a
		// point separated by spaces.
		header   map<string, string>
		// In table order.
		layers   Layer[]
		blocks   Block[]
		// The entities of model space and of the active paper space.
		entities Entity[]
		// Layers and blocks by upper-case name: names do not tell case.
		layerAt  map<string, int>
		blockAt  map<string, int>
		// The place of layer "0" among the layers, once the drawing is
		// bound: what is on it in a block is on the layer of the INSERT.
		zero     int

		def new() {
			header = new map<string, string>()
			layers = Layer[]
			blocks = Block[]
			entities = Entity[]
			layerAt = new map<string, int>()
			blockAt = new map<string, int>()
		}

		// layerIndex is the place of the layer of the name among the
		// layers; the layer is made with the default colour when the
		// table has none.
		def layerIndex(name string) int {
			let key = name.upper()
			let at = layerAt.get(key)
			return at unless at is none
			layerAt.set(key, layers.len())
			layers.push(new Layer(name))
			return layers.len() - 1
		}

		// layer is the layer of the name, made when the table has none.
		def layer(name string) Layer {
			return layers[layerIndex(name)]
		}

		// addBlock appends the block; a later block of a name replaces an
		// earlier one for the INSERTs that name it.
		def addBlock(block Block) {
			blockAt.set(block.name.upper(), blocks.len())
			blocks.push(block)
		}

		// block is the block of the name, none when the drawing has none.
		def block(name string) ?Block {
			let at = blockAt.get(name.upper())
			return none when at is none
			return blocks[at]
		}

		// bind makes sure layer "0" and every layer an entity names exist,
		// and gives each entity its layer's place.
		def bind() {
			zero = layerIndex("0")
			bindAll(entities)
			for let (_, block) in blocks {
				bindAll(block.entities)
			}
		}

		internal def bindAll(list Entity[]) {
			// Entities come in runs of one layer, and name a layer as
			// its table does: the names as written are looked up first.
			let written = new map<string, int>()
			let name = ""
			let at = -1
			for let (_, e) in list {
				if at < 0 || e.layer != name {
					name = e.layer
					let known = written.get(name)
					if known is none {
						at = layerIndex(name)
						written.set(name, at)
					} else {
						at = known
					}
				}
				e.layerIndex = at
			}
		}

		// unit is the metres one drawing unit stands for, from `$INSUNITS`;
		// 1 when the drawing states none.
		def unit() float {
			let text = header.get("INSUNITS")
			return 1.0 when text is none
			let code = text.toInt<int>()
			return 1.0 when code <= 0 || code >= unitMetres.len()
			return unitMetres[code]
		}
	}

	// Metres per unit by `$INSUNITS` value: none, inches, feet, miles,
	// millimetres, centimetres, metres, kilometres, microinches, mils,
	// yards, ångströms, nanometres, microns, decimetres, decametres,
	// hectometres, gigametres, astronomical units, light years, parsecs,
	// then the US survey foot, inch, yard and mile.
	let unitMetres = float[1.0, 0.0254, 0.3048, 1609.344, 0.001, 0.01, 1.0, 1000.0, 0.0000000254, 0.0000254, 0.9144, 1e-10, 1e-9, 1e-6, 0.1, 10.0, 100.0, 1e9, 149597870700.0, 9460730472580800.0, 30856775814913673.0, 1200.0 / 3937.0, 100.0 / 3937.0, 3600.0 / 3937.0, 6336000.0 / 3937.0]

	// unitCode is the `$INSUNITS` value whose unit is the metres given,
	// 0 (no unit) when none is.
	def unitCode(metres float) int {
		for let code = 1; code < unitMetres.len(); code++ {
			return code when (unitMetres[code] - metres).abs() <= unitMetres[code] * 1e-9
		}
		return 0
	}
}
