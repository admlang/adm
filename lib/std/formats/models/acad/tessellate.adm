internal partial module std.formats.models.acad {
	use (
		std.formats.models::*
		std.formats.models.polygon::*
		std.gfx.bands
		std.gfx.color
		std.math::(*)
		std.math.geom::(Quaternion, Vec3)
	)

	// What a bucket's positions form.
	const formTriangles = 0
	const formLines = 1
	const formPoints = 2

	// The entities a band of the tessellation is given at least.
	const bandEntities = 2048

	// Bucket is the geometry of one colour and form: positions in drawing
	// coordinates and the indices that join them.
	type Bucket {
		// The colour as 0xRRGGBBAA, times four, plus the form.
		key       int
		positions float[]
		indices   uint32[]

		def new(key int) {
			self.key = key
			indices = uint32[]
		}

		def count() int {
			return positions.len() / 3
		}
	}

	// Geometry is what a set of entities tessellates to: a bucket per
	// colour and form, in the order first drawn.
	type Geometry {
		buckets Bucket[]
		at      map<int, int>

		def new() {
			buckets = Bucket[]
			at = new map<int, int>()
		}

		def bucket(colour int, form int) Bucket {
			let key = colour * 4 + form
			let found = at.get(key)
			return buckets[found] unless found is none
			let made = new Bucket(key)
			at.set(key, buckets.len())
			buckets.push(made)
			return made
		}

		def point(colour int, x float, y float, z float) {
			bucket(colour, formPoints).positions.push(x, y, z)
		}

		// polyline adds the points joined in order, and the last to the
		// first when closed.
		def polyline(colour int, points float[], closed bool) {
			let n = points.len() / 3
			return when n < 2
			let b = bucket(colour, formLines)
			let base = b.count()
			b.positions.push(...points)
			for let k = 0; k + 1 < n; k++ {
				b.indices.push(uint32(base + k), uint32(base + k + 1))
			}
			b.indices.push(uint32(base + n - 1), uint32(base)) when closed && n > 2
		}

		// wall adds the surface the points' polyline sweeps when moved by
		// (dx, dy, dz).
		def wall(colour int, points float[], closed bool, dx float, dy float, dz float) {
			let n = points.len() / 3
			return when n < 2
			let b = bucket(colour, formTriangles)
			let base = b.count()
			b.positions.push(...points)
			for let k = 0; k < n; k++ {
				b.positions.push(points[k * 3] + dx, points[k * 3 + 1] + dy, points[k * 3 + 2] + dz)
			}
			let sides = closed && n > 2 ?? (n, n - 1)
			for let k = 0; k < sides; k++ {
				let a = uint32(base + k)
				let c = uint32(base + (k + 1) % n)
				b.indices.push(a, c, c + uint32(n), a, c + uint32(n), a + uint32(n))
			}
		}

		// fan adds the convex outline as triangles about its first point,
		// moved by (dx, dy, dz).
		def fan(colour int, points float[], dx float, dy float, dz float) {
			let n = points.len() / 3
			return when n < 3
			let b = bucket(colour, formTriangles)
			let base = b.count()
			for let k = 0; k < n; k++ {
				b.positions.push(points[k * 3] + dx, points[k * 3 + 1] + dy, points[k * 3 + 2] + dz)
			}
			for let k = 1; k + 1 < n; k++ {
				b.indices.push(uint32(base), uint32(base + k), uint32(base + k + 1))
			}
		}

		// take appends another geometry's buckets to this one's.
		def take(other Geometry) {
			for let (_, from) in other.buckets {
				let into = bucket(from.key / 4, from.key % 4)
				if into.positions.len() == 0 {
					into.positions = from.positions
					into.indices = from.indices
					continue
				}
				let base = uint32(into.count())
				into.positions.push(...from.positions)
				for let (_, index) in from.indices {
					into.indices.push(index + base)
				}
			}
		}
	}

	// Setting is where an entity is drawn: in model space, or in a block
	// placed on a layer with a colour, which the block's entities on layer
	// "0" and those coloured by block take.
	struct Setting {
		inBlock bool
		layer   int
		colour  int  = 0xFFFFFFFF
	}

	// Space is the geometry of the model space entities one band drew, by
	// layer, with the layers in the order first drawn on.
	type Space {
		layers map<int, Geometry>
		order  int[]

		def new() {
			layers = new map<int, Geometry>()
			order = int[]
		}

		def on(layer int) Geometry {
			let found = layers.get(layer)
			return found unless found is none
			let made = new Geometry()
			layers.set(layer, made)
			order.push(layer)
			return made
		}
	}

	// Tessellator makes a Model of a drawing.
	type Tessellator {
		drawing       Drawing
		// The distance a flattened curve may stray from the true one.
		tolerance     float
		layersAsNodes bool
		// The codec's name and the prefix of its messages.
		format        string
		prefix        string
		model         Model
		// Materials by colour, and block meshes by block, layer and colour.
		materials     map<int, Material>
		blockMeshes   map<string, Mesh>
		// Each layer's colour as 0xRRGGBB, by its place: what the tasks
		// read instead of the layers they would share.
		layerColours  int[]
		// The place of layer "0".
		zero          int

		def new(drawing Drawing, tolerance float, layersAsNodes bool, format string, prefix string) {
			self.drawing = drawing
			self.tolerance = tolerance
			self.layersAsNodes = layersAsNodes
			self.format = format
			self.prefix = prefix
			model = new Model()
			materials = new map<int, Material>()
			blockMeshes = new map<string, Mesh>()
		}

		// colourOf is the colour, as 0xRRGGBBAA, something of the colour
		// number, own colour and layer is drawn with in the setting.
		def colourOf(aci int, rgb int, alpha int, layer int, setting Setting) int {
			return (rgb << 8) | alpha when rgb >= 0
			return (aciColor(aci) << 8) | alpha when aci > 0 && aci < 256
			if aci == colorByBlock {
				return (setting.colour & 0xFFFFFF00) | alpha when setting.inBlock
				return 0xFFFFFF00 | alpha
			}
			return (layerColours[setting.inBlock && layer == zero ?? (setting.layer, layer)] << 8) | alpha
		}

		// emit adds what the entity draws to the geometry. INSERTs are
		// placed as nodes, not drawn.
		def emit(e Entity, g Geometry, setting Setting) {
			let colour = colourOf(e.aci, e.rgb, e.alpha, e.layerIndex, setting)
			let p = e.points
			// What a thickness sweeps the entity by.
			let length = sqrt(e.nx * e.nx + e.ny * e.ny + e.nz * e.nz)
			let scale = length == 0 ?? (0.0, e.thickness / length)
			let tx = e.nx * scale
			let ty = e.ny * scale
			let tz = e.nz * scale
			let thick = e.thickness != 0 && length != 0
			match e.kind {
				case EntityKind.Point:
					return when p.len() < 3
					if thick {
						g.polyline(colour, float[p[0], p[1], p[2], p[0] + tx, p[1] + ty, p[2] + tz], false)
					} else {
						g.point(colour, p[0], p[1], p[2])
					}
				case EntityKind.Line:
					return when p.len() < 6
					if thick {
						g.wall(colour, p, false, tx, ty, tz)
					} else {
						g.polyline(colour, p, false)
					}
				case EntityKind.Arc, EntityKind.Circle:
					return when p.len() < 3
					let plane = new Plane(e.nx, e.ny, e.nz)
					let whole = e.kind == EntityKind.Circle
					let sweep = Tau
					if !whole {
						sweep = e.end - e.start
						for sweep <= 0 {
							sweep += Tau
						}
						sweep = Tau when sweep > Tau
					}
					let points float[]
					flattenArc(points, plane, p[0], p[1], p[2], e.radius, whole ?? (0.0, e.start), sweep, tolerance, true)
					// A circle's last point is its first again.
					points.len(points.len() - 3) when whole
					if thick {
						g.wall(colour, points, whole, tx, ty, tz)
						if whole {
							g.fan(colour, points, 0, 0, 0)
							g.fan(colour, points, tx, ty, tz)
						}
					} else {
						g.polyline(colour, points, whole)
					}
				case EntityKind.Ellipse:
					return when p.len() < 6
					let points float[]
					flattenEllipse(points, e, tolerance)
					g.polyline(colour, points, false)
				case EntityKind.Polyline:
					let points = polylinePoints(e)
					if thick && e.planar {
						g.wall(colour, points, e.closed, tx, ty, tz)
					} else {
						g.polyline(colour, points, e.closed)
					}
				case EntityKind.Spline:
					let points float[]
					flattenSpline(points, e, tolerance)
					g.polyline(colour, points, false)
				case EntityKind.Face:
					g.fan(colour, corners(p), 0, 0, 0)
				case EntityKind.Solid:
					let plane = new Plane(e.nx, e.ny, e.nz)
					let flat = corners(p)
					let points float[]
					for let k = 0; k + 2 < flat.len(); k += 3 {
						plane.push(points, flat[k], flat[k + 1], flat[k + 2])
					}
					g.fan(colour, points, 0, 0, 0)
					if thick {
						g.fan(colour, points, tx, ty, tz)
						g.wall(colour, points, true, tx, ty, tz)
					}
				case EntityKind.PolyfaceMesh:
					polyface(e, g, colour, setting)
				case EntityKind.PolygonMesh:
					polygonMesh(e, g, colour)
				case EntityKind.SubdMesh:
					subdMesh(e, g, colour)
				case EntityKind.Insert:
			}
		}

		// corners is the three or four corners without those that repeat
		// the corner before them (the first, for the last), as files write
		// a triangle.
		def corners(p float[]) float[] {
			let n = p.len() / 3
			let out float[]
			for let k = 0; k < n; k++ {
				let before = ((k + n - 1) % n) * 3
				continue when n > 1 && p[k * 3] == p[before] && p[k * 3 + 1] == p[before + 1] && p[k * 3 + 2] == p[before + 2]
				out.push(p[k * 3], p[k * 3 + 1], p[k * 3 + 2])
			}
			return out
		}

		// polylinePoints is the polyline's vertices in drawing coordinates,
		// with the points of its arcs between them; for a closed one the
		// arc back to the first vertex too, without that vertex again.
		def polylinePoints(e Entity) float[] {
			let p = e.points
			return p unless e.planar
			let n = p.len() / 3
			let plane = new Plane(e.nx, e.ny, e.nz)
			let out float[]
			return out when n == 0
			plane.push(out, p[0], p[1], p[2])
			let bulged = e.bulges.len() == n
			let segments = e.closed && n > 1 ?? (n, n - 1)
			for let k = 0; k < segments; k++ {
				let next = (k + 1) % n
				flattenBulge(out, plane, p[k * 3], p[k * 3 + 1], p[next * 3], p[next * 3 + 1], p[next * 3 + 2], bulged ?? (e.bulges[k], 0.0), tolerance)
			}
			out.len(out.len() - 3) when e.closed && n > 1
			return out
		}

		// polyface adds a polyface mesh: each face under its own colour,
		// else the mesh's, with the vertices the faces of one colour use
		// stored once.
		def polyface(e Entity, g Geometry, colour int, setting Setting) {
			let p = e.points
			let n = p.len() / 3
			let coloured = e.faceColors.len() * 4 == e.faces.len()
			// Per colour, where each vertex went in the colour's bucket.
			let placed = new map<int, int[]>()
			let corner = int[0, 0, 0, 0]
			for let f = 0; f + 3 < e.faces.len(); f += 4 {
				let count = 0
				for let k = 0; k < 4; k++ {
					let v = e.faces[f + k].abs()
					continue when v == 0
					count = -1 when v > n
					break when count < 0
					corner[count] = v - 1
					count++
				}
				continue when count < 3
				let own = coloured ?? (e.faceColors[f / 4], colorByLayer)
				let key = own == colorByLayer ?? (colour, colourOf(own, -1, e.alpha, e.layerIndex, setting))
				let into = g.bucket(key, formTriangles)
				if !placed.hasKey(key) {
					let fresh int[]
					fresh.len(n)
					fresh.fill(-1)
					placed.set(key, fresh)
				}
				let at = placed[key]
				for let k = 0; k < count; k++ {
					let v = corner[k]
					if at[v] < 0 {
						at[v] = into.count()
						into.positions.push(p[v * 3], p[v * 3 + 1], p[v * 3 + 2])
					}
					corner[k] = at[v]
				}
				into.indices.push(uint32(corner[0]), uint32(corner[1]), uint32(corner[2]))
				into.indices.push(uint32(corner[0]), uint32(corner[2]), uint32(corner[3])) when count == 4
			}
		}

		// polygonMesh adds an m by n grid of vertices as two triangles a
		// cell, with the cells that close it along either way.
		def polygonMesh(e Entity, g Geometry, colour int) {
			let m = e.m
			let n = e.n
			return when m < 2 || n < 2 || e.points.len() < m * n * 3
			let b = g.bucket(colour, formTriangles)
			let base = b.count()
			b.positions.push(...e.points[:m * n * 3])
			let rows = e.closed ?? (m, m - 1)
			let columns = e.closedN ?? (n, n - 1)
			for let i = 0; i < rows; i++ {
				let i1 = (i + 1) % m
				for let j = 0; j < columns; j++ {
					let j1 = (j + 1) % n
					let a = uint32(base + i * n + j)
					let c = uint32(base + i1 * n + j1)
					b.indices.push(a, uint32(base + i1 * n + j), c, a, c, uint32(base + i * n + j1))
				}
			}
		}

		// subdMesh adds a subdivision mesh's base faces, a face of more
		// than four corners cut as a polygon.
		def subdMesh(e Entity, g Geometry, colour int) {
			let p = e.points
			let n = p.len() / 3
			let b = g.bucket(colour, formTriangles)
			let base = b.count()
			b.positions.push(...p)
			let at = 0
			for at < e.faces.len() {
				let count = e.faces[at]
				let from = at + 1
				at = from + count
				break when count < 0 || at > e.faces.len()
				let valid = count >= 3
				for let k = 0; k < count && valid; k++ {
					valid = e.faces[from + k] >= 0 && e.faces[from + k] < n
				}
				continue unless valid
				if count <= 4 {
					for let k = 1; k + 1 < count; k++ {
						b.indices.push(uint32(base + e.faces[from]), uint32(base + e.faces[from + k]), uint32(base + e.faces[from + k + 1]))
					}
					continue
				}
				let around float32[]
				let order int[]
				for let k = 0; k < count; k++ {
					let v = e.faces[from + k] * 3
					around.push(float32(p[v]), float32(p[v + 1]), float32(p[v + 2]))
					order.push(k)
				}
				for let (_, k) in polygonTriangles(around, order, count) {
					b.indices.push(uint32(base + e.faces[from + k]))
				}
			}
		}

		// material is the material of a colour, made at its first use.
		def material(colour int) Material {
			let found = materials.get(colour)
			return found unless found is none
			let alpha = colour & 0xFF
			let name = "#" + "%06x".format(colour >> 8)
			name += "%02x".format(alpha) when alpha != 255
			let made = new Material(name)
			made.baseColor = new color.Color(color.RGBA{r: uint8((colour >> 24) & 0xFF), g: uint8((colour >> 16) & 0xFF), b: uint8((colour >> 8) & 0xFF), a: uint8(alpha)})
			made.metallic = 0.0
			// A drawing's faces have no side that is their outside.
			made.doubleSided = true
			if alpha != 255 {
				made.alphaMode = AlphaMode.Blend
				made.transparency = 1.0 - float(alpha) / 255.0
			}
			materials.set(colour, made)
			model.materials.push(made)
			return made
		}

		// mesh makes a mesh of the geometry, a primitive per bucket, with
		// positions relative to the origin; none when there is nothing.
		def mesh(name string, g Geometry, ox float, oy float, oz float) ?Mesh {
			let made = new Mesh(name)
			for let (_, b) in g.buckets {
				let form = b.key % 4
				continue when b.positions.len() == 0 || (form != formPoints && b.indices.len() == 0)
				let prim = new Primitive(form == formTriangles ?? (Topology.Triangles, form == formLines ?? (Topology.Lines, Topology.Points)))
				prim.material = material(b.key / 4)
				prim.positions.len(b.positions.len())
				let positions = prim.positions
				let source = b.positions
				for let i = 0; i + 2 < source.len(); i += 3 {
					positions[i] = float32(source[i] - ox)
					positions[i + 1] = float32(source[i + 1] - oy)
					positions[i + 2] = float32(source[i + 2] - oz)
				}
				prim.indices = b.indices
				made.add(prim)
			}
			return none when made.primitives.len() == 0
			model.meshes.push(made)
			return made
		}

		// blockMesh is the mesh of a block's own entities drawn in the
		// setting, the same mesh for every INSERT that shares it; none
		// when they draw nothing.
		def blockMesh(block Block, index int, setting Setting) ?Mesh {
			let key = "{index}/{setting.layer}/{setting.colour}"
			let found = blockMeshes.get(key)
			if !(found is none) {
				return none when found.primitives.len() == 0
				return found
			}
			let g = new Geometry()
			for let (_, e) in block.entities {
				emit(e, g, setting) unless e.invisible || e.paper || e.kind == EntityKind.Insert
			}
			let made = mesh(block.name, g, 0, 0, 0)
			if made is none {
				blockMeshes.set(key, new Mesh(block.name))
				return none
			}
			blockMeshes.set(key, made)
			return made
		}

		// blockNode is a node showing the block in the setting: its mesh,
		// and a child for every INSERT it holds. `open` lists the blocks
		// being placed, outermost first.
		def blockNode(block Block, index int, setting Setting, open int[]) !Node {
			let node = new Node(block.name)
			node.mesh = blockMesh(block, index, setting)
			for let (_, e) in block.entities {
				continue when e.invisible || e.paper || e.kind != EntityKind.Insert
				let child = try insertNode(e, setting, open)
				node.add(child) unless child is none
			}
			return node
		}

		// insertNode is the node an INSERT drawn in the setting makes: its
		// block's node, placed; for a grid, a node holding one per cell.
		// None when the drawing has no block of the name. Fails with a
		// ModelError when the block is being placed inside itself.
		def insertNode(e Entity, setting Setting, open int[]) !?Node {
			let index = drawing.blockAt.get(e.name.upper())
			return none when index is none || e.points.len() < 3
			let block = drawing.blocks[index]
			fail ModelError{message: "{prefix}: block \"{block.name}\" places itself", format: format, detail: block.name} when open.includes(index)
			let inner = Setting{inBlock: true, layer: setting.inBlock && e.layerIndex == zero ?? (setting.layer, e.layerIndex), colour: colourOf(e.aci, e.rgb, e.alpha, e.layerIndex, setting)}
			open.push(index)
			defer open.pop()
			let columns = e.columns.max(1)
			let rows = e.rows.max(1)
			if columns == 1 && rows == 1 {
				let node = try blockNode(block, index, inner, open)
				place(node, e, block, 0, 0)
				return node
			}
			let grid = new Node(block.name)
			for let row = 0; row < rows; row++ {
				for let column = 0; column < columns; column++ {
					let node = try blockNode(block, index, inner, open)
					place(node, e, block, column, row)
					grid.add(node)
				}
			}
			return grid
		}

		// place sets the node's transform to the INSERT's: the block's base
		// point brought to the insertion point (moved to the grid's cell),
		// scaled, turned about the normal and laid in the INSERT's plane.
		def place(node Node, e Entity, block Block, column int, row int) {
			let plane = new Plane(e.nx, e.ny, e.nz)
			let c = cos(e.rotation)
			let s = sin(e.rotation)
			let turn = matrix<float, 4, 4>[]
			turn[0][0] = plane.xx * c + plane.yx * s
			turn[1][0] = plane.xy * c + plane.yy * s
			turn[2][0] = plane.xz * c + plane.yz * s
			turn[0][1] = plane.yx * c - plane.xx * s
			turn[1][1] = plane.yy * c - plane.xy * s
			turn[2][1] = plane.yz * c - plane.xz * s
			turn[0][2] = plane.zx
			turn[1][2] = plane.zy
			turn[2][2] = plane.zz
			turn[3][3] = 1
			node.rotation = new Quaternion(turn)
			node.scale = new Vec3(e.sx, e.sy, e.sz)
			let ox = float(column) * e.columnSpacing
			let oy = float(row) * e.rowSpacing
			let at float[]
			plane.push(at, e.points[0] + ox * c - oy * s, e.points[1] + ox * s + oy * c, e.points[2])
			let bx = block.baseX * e.sx
			let by = block.baseY * e.sy
			let bz = block.baseZ * e.sz
			node.translation = new Vec3(at[0] - (turn[0][0] * bx + turn[0][1] * by + turn[0][2] * bz), at[1] - (turn[1][0] * bx + turn[1][1] * by + turn[1][2] * bz), at[2] - (turn[2][0] * bx + turn[2][1] * by + turn[2][2] * bz))
		}

		// modelSpace tessellates the drawing's own entities, in bands on
		// tasks, into a geometry per layer (one for all without layer
		// nodes), in entity order.
		def modelSpace() Space {
			let entities = drawing.entities
			let count = entities.len()
			let weight = count * (bands.bandPixels / bandEntities)
			let results Space[]
			for let b = 0; b < bands.bandCount(count, weight); b++ {
				results.push(new Space())
			}
			let outside = Setting{}
			bands.forBands(count, weight, (from int, to int) => {
				let space = results[bands.bandOf(from, count, results.len())]
				for let i = from; i < to; i++ {
					let e = entities[i]
					continue when e.invisible || e.paper || e.kind == EntityKind.Insert
					emit(e, space.on(layersAsNodes ?? (e.layerIndex, 0)), outside)
				}
			})
			return results[0] when results.len() == 1
			let whole = new Space()
			for let (_, space) in results {
				for let (_, layer) in space.order {
					whole.on(layer).take(space.on(layer))
				}
			}
			return whole
		}

		// build makes the model: a root node per layer that has entities
		// (one root for all without layer nodes) showing the layer's mesh,
		// with the nodes of its INSERTs below. Where the drawing lies far
		// from its coordinates' origin, the roots are moved to its middle
		// and the meshes hold positions relative to it, which single
		// precision then keeps. Fails with a ModelError when a block is
		// placed inside itself.
		def build() !Model {
			drawing.bind()
			zero = drawing.zero
			for let (_, layer) in drawing.layers {
				layerColours.push(layer.rgb >= 0 ?? (layer.rgb, aciColor(layer.aci)))
			}
			model.upAxis = Axis.Z
			model.unit = drawing.unit()
			model.metadata.set("version", drawing.version) when drawing.version.len() > 0
			let space = modelSpace()
			// The INSERTs of model space, by the layer they are on.
			let placed = new map<int, Node[]>()
			let outside = Setting{}
			let open int[]
			for let (_, e) in drawing.entities {
				continue when e.invisible || e.paper || e.kind != EntityKind.Insert
				let node = try insertNode(e, outside, open)
				continue when node is none
				let layer = layersAsNodes ?? (e.layerIndex, 0)
				space.on(layer)
				placed.set(layer, Node[]) unless placed.hasKey(layer)
				placed[layer].push(node)
			}
			let (ox, oy, oz) = origin(space, placed)
			let layers = space.order.clone()
			layers.sort((a int, b int) => a < b)
			for let (_, layer) in layers {
				let name = layersAsNodes ?? (drawing.layers[layer].name, "")
				let root = new Node(name)
				root.mesh = mesh(name, space.on(layer), ox, oy, oz)
				let nodes = placed.get(layer)
				if !(nodes is none) {
					for let (_, node) in nodes {
						node.translation = new Vec3(node.translation.x - ox, node.translation.y - oy, node.translation.z - oz)
						root.add(node)
					}
				}
				continue when root.mesh is none && root.children.len() == 0
				root.translation = new Vec3(ox, oy, oz)
				if layersAsNodes {
					root.metadata.set("off", "true") when drawing.layers[layer].off
					root.metadata.set("frozen", "true") when drawing.layers[layer].frozen
				}
				model.nodes.push(root)
			}
			return model
		}

		// origin is, along each axis, the middle of the box around model
		// space in whole units when it lies further than 4096 units from
		// the coordinates' origin, else 0.
		def origin(space Space, placed map<int, Node[]>) (float, float, float) {
			let low = float[0, 0, 0]
			let high = float[0, 0, 0]
			let any = false
			for let (_, layer) in space.order {
				for let (_, b) in space.on(layer).buckets {
					let p = b.positions
					for let i = 0; i + 2 < p.len(); i += 3 {
						if !any {
							low = float[p[i], p[i + 1], p[i + 2]]
							high = float[p[i], p[i + 1], p[i + 2]]
							any = true
							continue
						}
						for let k = 0; k < 3; k++ {
							low[k] = low[k].min(p[i + k])
							high[k] = high[k].max(p[i + k])
						}
					}
				}
				let nodes = placed.get(layer)
				continue when nodes is none
				for let (_, node) in nodes {
					let t = float[node.translation.x, node.translation.y, node.translation.z]
					if !any {
						low = t.clone()
						high = t.clone()
						any = true
						continue
					}
					for let k = 0; k < 3; k++ {
						low[k] = low[k].min(t[k])
						high[k] = high[k].max(t[k])
					}
				}
			}
			let middle = float[0, 0, 0]
			for let k = 0; k < 3; k++ {
				let centre = (low[k] + high[k]) / 2.0
				middle[k] = centre.round() when centre.abs() > 4096.0
			}
			return (middle[0], middle[1], middle[2])
		}
	}
}
