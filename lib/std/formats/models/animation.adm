partial module std.formats.models {
	use (
		std.math::(sqrt)
		std.math.geom::(Quaternion, Vec3)
	)

	// Interpolation is how a channel moves between its keys.
	enum Interpolation {
		Linear,
		// Holds each key's value until the next.
		Step,
		// Cubic Hermite spline with a tangent into and out of each key.
		CubicSpline,
	}

	// AnimationPath is the property of a node a channel animates.
	enum AnimationPath {
		Translation,
		Rotation,
		Scale,
		// The node's morph target weights.
		Weights,
	}

	// Channel is the keyed values of one property of one node: times in seconds
	// and the value at each.
	type Channel {
		target        Node
		path          AnimationPath
		interpolation Interpolation = Interpolation.Linear
		// Key times in seconds, ascending.
		times         float32[]
		// Per key: 3 values for Translation and Scale, 4 (x, y, z, w) for
		// Rotation, one per morph target for Weights; with CubicSpline each key
		// holds its in-tangent, value and out-tangent in turn.
		values        float32[]

		def new(target Node, path AnimationPath) {
			self.target = target
			self.path = path
			times = float32[]
			values = float32[]
		}

		// keyCount is the number of keys.
		def keyCount() int {
			return times.len()
		}

		// duration is the time of the last key, 0 with none.
		def duration() float {
			return 0.0 when times.len() == 0
			return float(times[times.len() - 1])
		}

		// valueCount is the values of one key: 3 for Translation and Scale, 4
		// for Rotation, the number of morph targets for Weights.
		def valueCount() int {
			let keys = times.len()
			return 0 when keys == 0
			let per = values.len() / keys
			return per / 3 when interpolation == Interpolation.CubicSpline
			return per
		}

		// sample writes the interpolated value at the time into out, sized for
		// one key's values; before the first key and after the last it holds
		// that key's value. A rotation is interpolated along the shorter arc
		// and normalised.
		def sample(time float, out float32[]) {
			let n = valueCount()
			out.len(n) when out.len() != n
			return when n == 0
			let keys = times.len()
			// The key at or before the time: a binary search over the sorted times.
			let lo = 0
			let hi = keys - 1
			if time <= float(times[0]) {
				hi = 0
			} else if time >= float(times[hi]) {
				lo = hi
			} else {
				for hi - lo > 1 {
					let mid = (lo + hi) / 2
					if float(times[mid]) <= time {
						lo = mid
					} else {
						hi = mid
					}
				}
			}
			let cubic = interpolation == Interpolation.CubicSpline
			// Where a key's values start: cubic keys hold in-tangent, value, out-tangent.
			let stride = cubic ?? (3 * n, n)
			let at = lo * stride + (cubic ?? (n, 0))
			if lo == hi || interpolation == Interpolation.Step {
				for let k = 0; k < n; k++ {
					out[k] = values[at + k]
				}
				return
			}
			let t0 = float(times[lo])
			let t1 = float(times[hi])
			let dt = t1 - t0
			let t = dt > 0 ?? ((time - t0) / dt, 0.0)
			let next = hi * stride + (cubic ?? (n, 0))
			if cubic {
				// Cubic Hermite with the tangents scaled by the key distance.
				let t2 = t * t
				let t3 = t2 * t
				let h00 = 2 * t3 - 3 * t2 + 1
				let h10 = t3 - 2 * t2 + t
				let h01 = -2 * t3 + 3 * t2
				let h11 = t3 - t2
				for let k = 0; k < n; k++ {
					let p0 = float(values[at + k])
					let m0 = float(values[at + n + k]) * dt
					let p1 = float(values[next + k])
					let m1 = float(values[next - n + k]) * dt
					out[k] = float32(h00 * p0 + h10 * m0 + h01 * p1 + h11 * m1)
				}
				normalise(out) when path == AnimationPath.Rotation
				return
			}
			if path == AnimationPath.Rotation && n == 4 {
				let a = new Quaternion(float(values[at]), float(values[at + 1]), float(values[at + 2]), float(values[at + 3]))
				let b = new Quaternion(float(values[next]), float(values[next + 1]), float(values[next + 2]), float(values[next + 3]))
				let q = a.slerp(b, t)
				out[0] = float32(q.x)
				out[1] = float32(q.y)
				out[2] = float32(q.z)
				out[3] = float32(q.w)
				return
			}
			for let k = 0; k < n; k++ {
				out[k] = float32(float(values[at + k]) * (1 - t) + float(values[next + k]) * t)
			}
		}

		// normalise scales four values to unit length.
		internal def normalise(q float32[]) {
			return when q.len() < 4
			let len = sqrt(float(q[0]) * float(q[0]) + float(q[1]) * float(q[1]) + float(q[2]) * float(q[2]) + float(q[3]) * float(q[3]))
			return when len == 0
			for let k = 0; k < 4; k++ {
				q[k] = float32(float(q[k]) / len)
			}
		}

		// apply writes the channel's value at the time into its target node.
		def apply(time float) {
			let n = valueCount()
			return when n == 0
			let v float32[]
			v.len(n)
			sample(time, v)
			switch path {
				case AnimationPath.Translation:
					target.translation = new Vec3(float(v[0]), float(v[1]), float(v[2])) when n >= 3
				case AnimationPath.Scale:
					target.scale = new Vec3(float(v[0]), float(v[1]), float(v[2])) when n >= 3
				case AnimationPath.Rotation:
					target.rotation = new Quaternion(float(v[0]), float(v[1]), float(v[2]), float(v[3])) when n >= 4
				default:
					let weights float[]
					weights.len(n)
					for let k = 0; k < n; k++ {
						weights[k] = float(v[k])
					}
					target.weights = weights
			}
		}
	}

	// Animation is a named set of channels that play together.
	type Animation {
		name     string
		channels Channel[]

		def new(name string = "") {
			self.name = name
			channels = Channel[]
		}

		// duration is the longest channel's duration, 0 with none.
		def duration() float {
			let d = 0.0
			for let (_, c) in channels {
				d = d.max(c.duration())
			}
			return d
		}

		// apply writes every channel's value at the time into its target node.
		def apply(time float) {
			for let (_, c) in channels {
				c.apply(time)
			}
		}
	}
}
