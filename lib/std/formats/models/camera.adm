partial module std.formats.models {
	use std.math::(tan)

	// CameraKind is the projection of a camera.
	enum CameraKind {
		Perspective,
		Orthographic,
	}

	// Camera is a view into the scene, placed by the node that holds it and
	// looking down that node's negative z axis with y up.
	type Camera {
		name   string
		kind   CameraKind = CameraKind.Perspective
		// Perspective: the vertical field of view in radians, and the width to
		// height ratio, 0 for the viewport's own.
		yfov   float      = 0.8
		aspect float      = 0.0
		// Orthographic: half the view's width and height.
		xmag   float      = 1.0
		ymag   float      = 1.0
		// The near clipping distance, and the far one, 0 for infinite.
		znear  float      = 0.1
		zfar   float      = 1000.0

		def new(name string = "", kind CameraKind = CameraKind.Perspective) {
			self.name = name
			self.kind = kind
		}

		// projection is the camera's projection matrix, column-major, mapping
		// view coordinates to clip space with depth in -1..1, for the
		// camera's own aspect ratio (1 when it has none).
		def projection() matrix<float, 4, 4> {
			return projection(aspect > 0 ?? (aspect, 1.0))
		}

		// projection is the projection matrix for a viewport of the width to
		// height ratio, which a perspective camera with no aspect of its own
		// takes; an orthographic camera's magnifications are its own.
		def projection(viewportAspect float) matrix<float, 4, 4> {
			let m = matrix<float, 4, 4>[]
			if kind == CameraKind.Orthographic {
				let far = zfar > 0 ?? (zfar, znear + 1000.0)
				m[0][0] = 1.0 / xmag
				m[1][1] = 1.0 / ymag
				m[2][2] = 2.0 / (znear - far)
				m[2][3] = (far + znear) / (znear - far)
				m[3][3] = 1
				return m
			}
			let f = 1.0 / tan(yfov / 2)
			let a = viewportAspect > 0 ?? (viewportAspect, 1.0)
			m[0][0] = f / a
			m[1][1] = f
			if zfar > 0 {
				m[2][2] = (zfar + znear) / (znear - zfar)
				m[2][3] = 2 * zfar * znear / (znear - zfar)
			} else {
				// An infinite far plane.
				m[2][2] = -1
				m[2][3] = -2 * znear
			}
			m[3][2] = -1
			return m
		}
	}
}
