partial module std.formats.models {
	use std.io

	// Dwg is AutoCAD's native drawing file, releases R13 to 2018 (`AC1012` to
	// `AC1032`): the same drawing Dxf exchanges, in its binary object database
	// (section map, object map, handles, bit-coded objects, compressed and
	// encrypted sections from 2004 on). Reads the same entities as Dxf, with
	// the same tessellation, and writes the same content as a drawing of
	// `version`. Dwg and Dxf share the drawing model and tessellation.
	@codec("DWG")
	type Dwg {
		// The greatest distance, in drawing units, a flattened curve or
		// surface may stray from the true one.
		tolerance     float  = 0.01
		// Make one node per layer with the layer's entities under it; false
		// puts every entity under the root.
		layersAsNodes bool   = true
		// The drawing version written: "AC1032" is AutoCAD 2018, "AC1015"
		// AutoCAD 2000.
		version       string = "AC1032"

		mimeType string[] {
			def get() string[] {
				return string["image/vnd.dwg", "application/acad"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".dwg"]
			}
		}

		// matchSignature tests for the version string every DWG opens with,
		// `AC10` followed by two digits.
		def matchSignature(r io.Reader) bool {
			return string(prefix(r, 4)) == "AC10"
		}

		// decode reads the whole reader as DWG. Fails with a ModelError when the
		// version is not read, a section's checksum fails or an object is
		// malformed, or with the reader's own error.
		def decode(reader io.Reader, resources ?ResourceReader) !Model {}

		// encode writes the model as a DWG drawing of `version`. Fails with the
		// writer's own error.
		def encode(model Model, writer io.Writer, resources ?ResourceWriter) !none {}
	}
}
