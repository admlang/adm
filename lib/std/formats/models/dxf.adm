partial module std.formats.models {
	use std.io

	// Dxf is AutoCAD's drawing exchange format, text and binary, releases R12
	// to 2018. A drawing is entities on layers, not meshes, so reading
	// tessellates: 3DFACE, POLYFACE and POLYLINE meshes, MESH and SOLID become
	// triangles; LINE, LWPOLYLINE, POLYLINE, ARC, CIRCLE, ELLIPSE and SPLINE
	// become Lines primitives, curves flattened within `tolerance`; INSERT
	// places a block's node under the layer's node; a layer's or entity's
	// colour (ACI or true colour) becomes its material. Text, dimensions,
	// hatches and 3DSOLID (ACIS) bodies are left out. Writing makes one layer
	// per top-level node and writes meshes as POLYFACE meshes and lines as
	// POLYLINEs. Dwg is the same drawing in AutoCAD's binary file.
	@codec("DXF")
	type Dxf {
		// The greatest distance, in drawing units, a flattened curve or
		// surface may stray from the true one.
		tolerance     float  = 0.01
		// Make one node per layer with the layer's entities under it; false
		// puts every entity under the root.
		layersAsNodes bool   = true
		// Write the binary form; false writes text.
		binary        bool   = false
		// The drawing version written, as the `$ACADVER` value: "AC1032" is
		// AutoCAD 2018, "AC1009" R12.
		version       string = "AC1032"

		mimeType string[] {
			def get() string[] {
				return string["image/vnd.dxf", "application/dxf"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".dxf"]
			}
		}

		// matchSignature tests for the text form's opening `0` / `SECTION` pair
		// and the binary form's `AutoCAD Binary DXF` sentinel.
		def matchSignature(r io.Reader) bool {
			let head = string(prefix(r, 32))
			return true when head.startsWith("AutoCAD Binary DXF")
			let lines = head.trimStart().lines()
			return false when lines.len() < 2
			return lines[0].trim() == "0" && lines[1].trim() == "SECTION"
		}

		// decode reads the whole reader as DXF. Fails with a ModelError when a
		// group code or value is malformed or a section is unterminated, or
		// with the reader's own error.
		def decode(reader io.Reader, resources ?ResourceReader) !Model {}

		// encode writes the model as a DXF drawing of `version`. Fails with the
		// writer's own error.
		def encode(model Model, writer io.Writer, resources ?ResourceWriter) !none {}
	}
}
