// DXF: a drawing as groups, each a code that says what the value after it
// is, in sections. The text form writes a group as two lines; the binary
// form as the code in one or two bytes and the value in the bytes its
// code's type takes.
internal partial module std.formats.models.dxf {
	use (
		std.data.encoding.codepages
		std.formats.models::*
		std.formats.models.text::*
		std.gfx.bands
	)

	// What the first 18 bytes of the binary form read; four more follow
	// (a line end, an end-of-file mark and a NUL).
	const dxfBinaryMark = "AutoCAD Binary DXF"
	const dxfBinaryStart = 22

	// The types a group's value has, by its code.
	const dxfText = 0
	const dxfReal = 1
	const dxfInt16 = 2
	const dxfInt32 = 3
	const dxfInt64 = 4
	const dxfByte = 5
	const dxfChunk = 6
	const dxfUnknown = -1

	// dxfKind is the type of the value a group of the code holds.
	def dxfKind(code int) int {
		return dxfUnknown when code < 0
		return dxfText when code < 10
		return dxfReal when code < 60
		return dxfInt16 when code < 80
		return dxfUnknown when code < 90
		return dxfInt32 when code < 100
		return dxfText when code := 100 || 101 || 102 || 105
		return dxfUnknown when code < 110
		return dxfReal when code < 150
		return dxfUnknown when code < 160
		return dxfInt64 when code < 170
		return dxfInt16 when code < 180
		return dxfUnknown when code < 210
		return dxfReal when code < 240
		return dxfUnknown when code < 270
		return dxfInt16 when code < 290
		return dxfByte when code < 300
		return dxfText when code < 310
		return dxfChunk when code < 320
		return dxfText when code < 370
		return dxfInt16 when code < 390
		return dxfText when code < 400
		return dxfInt16 when code < 410
		return dxfText when code < 420
		return dxfInt32 when code < 430
		return dxfText when code < 440
		return dxfInt32 when code < 460
		return dxfReal when code < 470
		return dxfText when code < 482
		return dxfUnknown when code < 999
		return dxfChunk when code == 1004
		return dxfText when code < 1010
		return dxfReal when code < 1060
		return dxfInt16 when code < 1071
		return dxfInt32 when code == 1071
		return dxfUnknown
	}

	// DxfGroups is a file's groups in order: each one's code and where its
	// value starts in the bytes. A text value runs to its line's end; a
	// binary one over the bytes of its code's type.
	type DxfGroups {
		data    byte[]
		binary  bool
		codes   int16[]
		starts  int[]
		// The byte that ends a line of the text form.
		newline byte                = 0x0A
		// Why the scan stopped before the end of the bytes, when it did:
		// what follows the last group is not a group.
		failure ?error
		// How text values are stored: UTF-8, else in the code page, else
		// (with no page) UTF-8 where the bytes are, Windows-1252 where not.
		utf8    bool
		page    ?codepages.CodePage

		def new(data byte[], binary bool) {
			self.data = data
			self.binary = binary
		}

		def count() int {
			return codes.len()
		}
	}

	// DxfScanBand is the groups one band of a text file holds.
	type DxfScanBand {
		// The line ends in the band's bytes.
		lines   int
		codes   int16[]
		starts  int[]
		failure ?error
		// The band reached the blank lines that end the file.
		ended   bool

		def new() {}
	}

	// dxfScanText finds the groups of a text file: the lines are counted
	// in bands on tasks, which tells each band whether its first line is a
	// code or a value, and the bands then read their groups at once. A
	// file whose lines end with a carriage return alone is read too.
	def dxfScanText(data byte[]) DxfGroups {
		let groups = new DxfGroups(data, false)
		let start = data.len() >= 3 && data[0] == 0xEF && data[1] == 0xBB && data[2] == 0xBF ?? (3, 0)
		let probe = data.len().min(start + 65536)
		let feeds = false
		let returns = false
		for let i = start; i < probe && !feeds; i++ {
			feeds = data[i] == 0x0A
			returns = true when data[i] == 0x0D
		}
		groups.newline = 0x0D when returns && !feeds
		let newline = groups.newline
		let size = data.len() - start
		let found DxfScanBand[]
		for let b = 0; b < bands.bandCount(size, size); b++ {
			found.push(new DxfScanBand())
		}
		bands.forBands(size, size, (from int, to int) => {
			let band = found[bands.bandOf(from, size, found.len())]
			let lines = 0
			for let i = start + from; i < start + to; i++ {
				lines++ when data[i] == newline
			}
			band.lines = lines
		})
		// The number of the first line that starts after a line end of
		// each band, lines counted from 0.
		let first int[]
		let before = 0
		for let (_, band) in found {
			first.push(before + 1)
			before += band.lines
		}
		bands.forBands(size, size, (from int, to int) => {
			let b = bands.bandOf(from, size, found.len())
			dxfScanBand(data, newline, start + from, start + to, b == 0, first[b], found[b])
		})
		let total = 0
		for let (_, band) in found {
			total += band.codes.len()
			break when band.ended || !(band.failure is none)
		}
		groups.codes.len(total)
		groups.starts.len(total)
		let at = 0
		for let (_, band) in found {
			band.codes.copy(groups.codes[at:])
			band.starts.copy(groups.starts[at:])
			at += band.codes.len()
			groups.failure = band.failure
			break when band.ended || !(band.failure is none)
		}
		return groups
	}

	// dxfScanBand reads the groups whose code line starts in the band:
	// at the band's first byte for the file's first band, else after a
	// line end among the band's bytes. `line` numbers the first line that
	// starts after one of those line ends.
	def dxfScanBand(data byte[], newline byte, from int, to int, leads bool, line int, band DxfScanBand) {
		let at = from
		if leads {
			line = 0
		} else {
			for at < to && data[at] != newline {
				at++
			}
			at++
			if line % 2 == 1 {
				// A value line: its group is the band's before.
				for at < to && data[at] != newline {
					at++
				}
				at++
				line++
			}
		}
		// `at` is where a code line starts, its line end before `to`.
		for at <= to && at < data.len() && (leads || at > from) {
			let p = at
			for p < data.len() && (data[p] == 0x20 || data[p] == 0x09) {
				p++
			}
			let code = 0
			let digits = 0
			for p < data.len() && data[p] >= 0x30 && data[p] <= 0x39 && digits < 6 {
				code = code * 10 + int(data[p] - 0x30)
				digits++
				p++
			}
			// What follows the digits on the line must be blank.
			let end = p
			let clean = true
			for end < data.len() && data[end] != newline {
				clean = false when data[end] > 0x20
				end++
			}
			if digits == 0 && clean {
				// A blank line where a code belongs is the file's end when
				// nothing but blank lines follow.
				let blank = true
				for let i = end; i < data.len() && blank; i++ {
					blank = data[i] <= 0x20
				}
				band.ended = blank
				band.failure = ModelError{message: "dxf: expected a group code, found a blank line", format: "DXF", detail: "line {line + 1}"} unless blank
				return
			}
			if digits == 0 || !clean || code > 1071 {
				band.failure = ModelError{message: "dxf: expected a group code, found `{string(data[at:end]).trim()}`", format: "DXF", detail: "line {line + 1}"}
				return
			}
			if end >= data.len() {
				band.failure = ModelError{message: "dxf: the file ends after a group code", format: "DXF", detail: "line {line + 1}"}
				return
			}
			band.codes.push(int16(code))
			band.starts.push(end + 1)
			at = end + 1
			for at < data.len() && data[at] != newline {
				at++
			}
			at++
			line += 2
		}
	}

	// dxfScanBinary finds the groups of a binary file: codes of two bytes,
	// or of one byte (255 before a code of two) as releases before R13
	// wrote them. The scan stops at the group it cannot read.
	def dxfScanBinary(data byte[]) DxfGroups {
		let groups = new DxfGroups(data, true)
		let at = dxfBinaryStart
		// A file opens with the group 0 SECTION: two zero bytes are a code
		// of two bytes, one before the `S` a code of one.
		let wide = at + 1 < data.len() && data[at] == 0 && data[at + 1] == 0
		for at < data.len() {
			let code = int(data[at])
			if wide {
				if at + 2 > data.len() {
					groups.failure = dxfShort(at)
					return groups
				}
				code |= int(data[at + 1]) << 8
				at += 2
			} else if code == 255 {
				if at + 3 > data.len() {
					groups.failure = dxfShort(at)
					return groups
				}
				code = int(data[at + 1]) | (int(data[at + 2]) << 8)
				at += 3
			} else {
				at++
			}
			let size = 0
			switch dxfKind(code) {
				case dxfText:
					let end = at
					for end < data.len() && data[end] != 0 {
						end++
					}
					size = end + 1 - at
				case dxfReal, dxfInt64:
					size = 8
				case dxfInt16:
					size = 2
				case dxfInt32:
					size = 4
				case dxfByte:
					size = 1
				case dxfChunk:
					size = at < data.len() ?? (1 + int(data[at]), 1)
				default:
					groups.failure = ModelError{message: "dxf: unknown group code {code}", format: "DXF", detail: "byte {at}"}
					return groups
			}
			if at + size > data.len() {
				groups.failure = dxfShort(at)
				return groups
			}
			groups.codes.push(int16(code))
			groups.starts.push(at)
			at += size
		}
		return groups
	}

	def dxfShort(at int) error {
		return ModelError{message: "dxf: the file ends inside a group", format: "DXF", detail: "byte {at}"}
	}

	// DxfReader reads the values of a file's groups. Each task that reads
	// has its own.
	type DxfReader {
		groups  DxfGroups
		// The groups' own fields, held here so that reading a value does
		// not go through the object the tasks share.
		data    byte[]
		codes   int16[]
		starts  int[]
		binary  bool
		newline byte
		scan    TextScanner

		def new(groups DxfGroups) {
			self.groups = groups
			data = groups.data
			codes = groups.codes
			starts = groups.starts
			binary = groups.binary
			newline = groups.newline
			scan = new TextScanner(groups.data, "DXF", "dxf")
		}

		// span is the bytes of a text value, without the line end.
		def span(i int) byte[] {
			let from = starts[i]
			let to = from
			if binary {
				for to < data.len() && data[to] != 0 {
					to++
				}
				return data[from:to]
			}
			for to < data.len() && data[to] != newline {
				to++
			}
			to-- when to > from && data[to - 1] == 0x0D
			return data[from:to]
		}

		// text is a text value as the file has it, in UTF-8, with its
		// `\U+XXXX` escapes as the characters they stand for.
		def text(i int) string {
			let raw = span(i)
			let plain = true
			for let k = 0; k < raw.len() && plain; k++ {
				plain = raw[k] < 0x80 && raw[k] != 0x5C
			}
			return string(raw) when plain
			let out string
			let page = groups.page
			if groups.utf8 || (page is none && raw.isUTF8()) {
				out = string(raw)
			} else if page is none {
				out = codepages.decode(raw, codepages.CodePage.Windows1252)
			} else {
				out = codepages.decode(raw, page)
			}
			return out unless out.contains("\\U+")
			let parts = out.split("\\U+")
			let joined = parts[0]
			for let k = 1; k < parts.len(); k++ {
				let part = parts[k]
				let hex = part.len() >= 4 ?? (part[:4], "")
				let valid = hex.len() == 4
				for let (_, c) in hex.bytes() {
					valid = false unless (c >= 0x30 && c <= 0x39) || (c >= 0x41 && c <= 0x46) || (c >= 0x61 && c <= 0x66)
				}
				if valid {
					joined += string(byte[].append(char(hex.toInt<int>(16)))) + part[4:]
				} else {
					joined += "\\U+" + part
				}
			}
			return joined
		}

		// shown is a group's value as text, whatever its type: a header
		// variable's value.
		def shown(i int) string {
			return text(i).trim() unless binary
			switch dxfKind(int(codes[i])) {
				case dxfText:
					return text(i).trim()
				case dxfReal:
					return "{float(__bitcast_f64_from_u64(bits(i, 8)))}"
				case dxfChunk:
					return ""
				default:
					let value = whole(i) onerror recover 0
					return "{value}"
			}
		}

		// name is a text value without the blanks around it: an entity's
		// type, a section, a layer or a block.
		def name(i int) string {
			return text(i).trim()
		}

		// names reports whether the value is the word, blanks around it
		// aside.
		def names(i int, word byte[]) bool {
			let from = starts[i]
			let size = data.len()
			for from < size && (data[from] == 0x20 || data[from] == 0x09) {
				from++
			}
			let count = word.len()
			return false when from + count > size
			for let k = 0; k < count; k++ {
				return false when data[from + k] != word[k]
			}
			// Only blanks may follow, up to the value's end.
			let at = from + count
			for at < size {
				let c = data[at]
				return true when c == newline || c == 0
				return false when c > 0x20
				at++
			}
			return true
		}

		// line is the line of the file a group's value is on, for errors.
		def line(i int) string {
			return "byte {starts[i]}" when binary
			return "line {i * 2 + 2}"
		}

		// bits is the unsigned integer of `size` bytes, low byte first, a
		// binary value starts with.
		def bits(i int, size int) uint64 {
			let at = starts[i]
			let v uint64 = 0
			for let k = 0; k < size; k++ {
				v |= uint64(data[at + k]) << uint64(8 * k)
			}
			return v
		}

		// real is a group's value as a number. Fails with a ModelError when
		// it is not one.
		def real(i int) !float {
			if binary {
				switch dxfKind(int(codes[i])) {
					case dxfReal:
						return float(__bitcast_f64_from_u64(bits(i, 8)))
					case dxfText, dxfChunk:
						fail ModelError{message: "dxf: group {codes[i]} holds no number", format: "DXF", detail: line(i)}
					default:
						return float(try whole(i))
				}
			}
			let at = starts[i]
			for at < data.len() && (data[at] == 0x20 || data[at] == 0x09) {
				at++
			}
			fail ModelError{message: "dxf: expected a number for group {codes[i]}, found nothing", format: "DXF", detail: line(i)} when at >= data.len() || data[at] == 0x0A || data[at] == 0x0D
			scan.pos = at
			scan.line = i * 2 + 2
			return scan.value()
		}

		// whole is a group's value as an integer. Fails with a ModelError
		// when it is not a number.
		def whole(i int) !int {
			if binary {
				switch dxfKind(int(codes[i])) {
					case dxfInt16:
						return int(int16(bits(i, 2)))
					case dxfInt32:
						return int(int32(bits(i, 4)))
					case dxfInt64:
						return int(bits(i, 8))
					case dxfByte:
						return int(bits(i, 1))
					case dxfReal:
						return int(__bitcast_f64_from_u64(bits(i, 8)))
					default:
						fail ModelError{message: "dxf: group {codes[i]} holds no number", format: "DXF", detail: line(i)}
				}
			}
			let at = starts[i]
			for at < data.len() && (data[at] == 0x20 || data[at] == 0x09) {
				at++
			}
			fail ModelError{message: "dxf: expected a number for group {codes[i]}, found nothing", format: "DXF", detail: line(i)} when at >= data.len() || data[at] == 0x0A || data[at] == 0x0D
			scan.pos = at
			scan.line = i * 2 + 2
			return scan.integer()
		}
	}
}
