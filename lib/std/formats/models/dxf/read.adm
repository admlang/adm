internal partial module std.formats.models.dxf {
	use (
		std.data.encoding.codepages
		std.formats.models::*
		std.formats.models.acad::*
		std.gfx.bands
		std.math::(*)
	)

	// The words the reader looks for among entity types.
	let dxfEndSection = "ENDSEC".bytes()
	let dxfEndBlock = "ENDBLK".bytes()
	let dxfVertex = "VERTEX".bytes()
	let dxfAttribute = "ATTRIB".bytes()
	let dxfSequenceEnd = "SEQEND".bytes()
	let dxfSection = "SECTION".bytes()
	let dxfEnd = "EOF".bytes()

	// The entity types read, the common ones first, and what each is read
	// as: an entity of so many positions, or one of the kinds below.
	let dxfTypes = byte[]["LINE".bytes(), "3DFACE".bytes(), "POLYLINE".bytes(), "LWPOLYLINE".bytes(), "CIRCLE".bytes(), "ARC".bytes(), "INSERT".bytes(), "POINT".bytes(), "SOLID".bytes(), "TRACE".bytes(), "ELLIPSE".bytes(), "SPLINE".bytes(), "MESH".bytes()]
	const dxfLine = 0
	const dxfFace = 1
	const dxfPolyline = 2
	const dxfLightPolyline = 3
	const dxfCircle = 4
	const dxfArc = 5
	const dxfInsert = 6
	const dxfPoint = 7
	const dxfSolid = 8
	const dxfTrace = 9
	const dxfEllipse = 10
	const dxfSpline = 11
	const dxfMesh = 12

	// The groups a band of the entity reader is given at least.
	const dxfBandGroups = 16384

	// dxfDecode reads a text or binary DXF into a model.
	def dxfDecode(data byte[], tolerance float, layersAsNodes bool) !Model {
		let drawing = try dxfDrawing(data)
		return new Tessellator(drawing, tolerance, layersAsNodes, "DXF", "dxf").build()
	}

	// dxfDrawing reads the drawing a text or binary DXF holds: the header
	// variables, the layer table, the blocks and the entities; the other
	// sections and tables are read past. Fails with a ModelError when a
	// group's code or a value read is malformed, or a section has no end.
	def dxfDrawing(data byte[]) !Drawing {
		let binary = data.len() >= dxfBinaryStart && string(data[:dxfBinaryMark.len()]) == dxfBinaryMark
		let groups = binary ?? (dxfScanBinary(data), dxfScanText(data))
		let source = new DxfSource(groups)
		return source.read()
	}

	// DxfEntityBand is the entities one band read, and the error that
	// stopped it.
	type DxfEntityBand {
		entities Entity[]
		failure  ?error

		def new() {
			entities = Entity[]
		}
	}

	// DxfSource reads a drawing from a file's groups.
	type DxfSource {
		groups  DxfGroups
		reader  DxfReader
		// The groups of code 0, which start a section, a table, a table
		// entry, a block or an entity.
		zeros   int[]
		drawing Drawing

		def new(groups DxfGroups) {
			self.groups = groups
			reader = new DxfReader(groups)
			drawing = new Drawing()
			let codes = groups.codes
			for let i = 0; i < codes.len(); i++ {
				zeros.push(i) when codes[i] == 0
			}
		}

		// read walks the sections up to EOF. A scan that stopped early
		// fails here unless the file's EOF came before the stop.
		def read() !Drawing {
			let z = 0
			let ended = false
			for z < zeros.len() {
				let i = zeros[z]
				if reader.names(i, dxfEnd) {
					ended = true
					break
				}
				fail ModelError{message: "dxf: expected SECTION, found `{reader.name(i)}`", format: "DXF", detail: reader.line(i)} unless reader.names(i, dxfSection)
				let section = i + 1 < groups.count() && groups.codes[i + 1] == 2 ?? (reader.name(i + 1).upper(), "")
				let end = z + 1
				for end < zeros.len() && !reader.names(zeros[end], dxfEndSection) {
					end++
				}
				if end >= zeros.len() {
					let failure = groups.failure
					fail failure unless failure is none
					fail ModelError{message: "dxf: section {section} has no ENDSEC", format: "DXF", detail: reader.line(i)}
				}
				match section {
					case "HEADER":
						try header(i + 2, zeros[end])
					case "TABLES":
						try tables(z + 1, end)
					case "BLOCKS":
						try blocks(z + 1, end)
					case "ENTITIES":
						drawing.entities.push(...try entities(z + 1, end))
					default:
				}
				z = end + 1
			}
			let failure = groups.failure
			fail failure unless ended || failure is none
			fail ModelError{message: "dxf: the file has no section", format: "DXF"} when zeros.len() == 0
			return drawing
		}

		// header reads the variables: a group 9 names one, the groups up
		// to the next are its value. The release and the code page set how
		// text is read from here on.
		def header(from int, to int) !none {
			let name = ""
			let value = ""
			for let i = from; i <= to; i++ {
				if i == to || groups.codes[i] == 9 {
					drawing.header.set(name, value) when name.len() > 0
					break when i == to
					name = reader.name(i)
					name = name[1:] when name.startsWith("$")
					value = ""
					continue
				}
				let part = reader.shown(i)
				value = value.len() == 0 ?? (part, value + " " + part)
			}
			let version = drawing.header.get("ACADVER")
			drawing.version = version unless version is none
			// AutoCAD 2007 and later write UTF-8; the releases before, the
			// code page the header names.
			groups.utf8 = drawing.version >= "AC1021"
			let page = drawing.header.get("DWGCODEPAGE")
			return none when page is none || groups.utf8
			let label = page.lower()
			if label.startsWith("ansi_") {
				groups.page = codepages.forCharset("windows-" + label[5:])
			} else if label.startsWith("dos") {
				groups.page = codepages.forCharset("cp" + label[3:])
			} else if label.startsWith("iso") {
				groups.page = codepages.forCharset("iso-" + label[3:].replace("_", "-").trimStart("-"))
			} else {
				groups.page = codepages.forCharset(label)
			}
			return none
		}

		// tables reads the entries of the LAYER table: a layer's name, its
		// colour (negative for a layer switched off), its own colour and
		// whether it is frozen.
		def tables(from int, to int) !none {
			let layers = false
			for let z = from; z < to; z++ {
				let i = zeros[z]
				let word = reader.name(i).upper()
				if word == "TABLE" {
					layers = i + 1 < groups.count() && groups.codes[i + 1] == 2 && reader.name(i + 1).upper() == "LAYER"
					continue
				}
				layers = false when word == "ENDTAB"
				continue unless layers && word == "LAYER"
				let name = ""
				let aci = 7
				let rgb = -1
				let flags = 0
				for let g = i + 1; g < zeros[z + 1]; g++ {
					switch int(groups.codes[g]) {
						case 2:
							name = reader.name(g)
						case 62:
							aci = try reader.whole(g)
						case 420:
							rgb = (try reader.whole(g)) & 0xFFFFFF
						case 70:
							flags = try reader.whole(g)
						default:
					}
				}
				let layer = drawing.layer(name)
				layer.off = aci < 0
				layer.aci = aci.abs()
				layer.rgb = rgb
				layer.frozen = flags & 1 != 0
			}
			return none
		}

		// blocks reads each BLOCK: its name, its base point and the
		// entities up to its ENDBLK.
		def blocks(from int, to int) !none {
			let z = from
			for z < to {
				let i = zeros[z]
				if reader.name(i).upper() != "BLOCK" {
					z++
					continue
				}
				let block = new Block("")
				for let g = i + 1; g < zeros[z + 1]; g++ {
					switch int(groups.codes[g]) {
						case 2:
							block.name = reader.name(g)
						case 10:
							block.baseX = try reader.real(g)
						case 20:
							block.baseY = try reader.real(g)
						case 30:
							block.baseZ = try reader.real(g)
						default:
					}
				}
				let end = z + 1
				for end < to && !reader.names(zeros[end], dxfEndBlock) {
					end++
				}
				block.entities = try entities(z + 1, end)
				drawing.addBlock(block)
				z = end + 1
			}
			return none
		}

		// entities reads the entities whose first groups are the zeros
		// from `from` up to `to`, in bands on tasks. A VERTEX, ATTRIB or
		// SEQEND belongs to the POLYLINE or INSERT before it. Fails with
		// the error of the first band, in file order, that has one.
		def entities(from int, to int) !Entity[] {
			let tops int[]
			for let z = from; z < to; z++ {
				let i = zeros[z]
				tops.push(z) unless reader.names(i, dxfVertex) || reader.names(i, dxfAttribute) || reader.names(i, dxfSequenceEnd)
			}
			let out Entity[]
			return out when tops.len() == 0
			let count = tops.len()
			let weight = (zeros[to] - zeros[from]) * (bands.bandPixels / dxfBandGroups)
			let found DxfEntityBand[]
			for let b = 0; b < bands.bandCount(count, weight); b++ {
				found.push(new DxfEntityBand())
			}
			bands.forBands(count, weight, (first int, last int) => {
				let band = found[bands.bandOf(first, count, found.len())]
				let own = new DxfEntities(groups, zeros)
				// The task's own names for what the tasks share, taken once:
				// read through the closure, each use would count on the one
				// object from every task.
				let starts = tops
				let into = band.entities
				let failed = false
				for let t = first; t < last && !failed; t++ {
					let made ?Entity
					made = own.entity(starts[t], t + 1 < count ?? (starts[t + 1], to)) onerror (err error) {
						band.failure = err
						failed = true
						recover none
					}
					into.push(made) unless made is none
				}
				band.entities = into
			})
			return found[0].entities when found.len() == 1 && found[0].failure is none
			for let (_, band) in found {
				out.push(...band.entities)
				let failure = band.failure
				fail failure unless failure is none
			}
			return out
		}
	}

	// DxfEntities reads entities from their groups, for one task.
	type DxfEntities {
		reader         DxfReader
		codes          int16[]
		zeros          int[]
		// The layer name read last, and its bytes in the file.
		lastLayer      string
		lastLayerBytes byte[]
		// The words looked for, copied for this task: tasks that compared
		// against the module's own would each count their use of them.
		types          byte[][]
		vertex         byte[]
		sequenceEnd    byte[]

		def new(groups DxfGroups, zeros int[]) {
			self.zeros = zeros
			codes = groups.codes
			reader = new DxfReader(groups)
			for let (_, word) in dxfTypes {
				types.push(word.clone())
			}
			vertex = dxfVertex.clone()
			sequenceEnd = dxfSequenceEnd.clone()
		}

		// entity reads the entity at the zero `z`, with the VERTEX records
		// after it up to the zero `end` for a POLYLINE. None for a type
		// that is not drawn: text, dimensions, hatches, solids' bodies,
		// rays and whatever else the model has no place for.
		def entity(z int, end int) !?Entity {
			let from = zeros[z] + 1
			let to = zeros[z + 1]
			let kind = -1
			for let k = 0; k < types.len() && kind < 0; k++ {
				kind = k when reader.names(zeros[z], types[k])
			}
			switch kind {
				case dxfPoint:
					return fixed(new Entity(EntityKind.Point), 1, from, to)
				case dxfLine:
					return fixed(new Entity(EntityKind.Line), 2, from, to)
				case dxfCircle:
					return fixed(new Entity(EntityKind.Circle), 1, from, to)
				case dxfArc:
					return fixed(new Entity(EntityKind.Arc), 1, from, to)
				case dxfEllipse:
					return fixed(new Entity(EntityKind.Ellipse), 2, from, to)
				case dxfFace:
					return fixed(new Entity(EntityKind.Face), 4, from, to)
				case dxfSolid, dxfTrace:
					return fixed(new Entity(EntityKind.Solid), 4, from, to)
				case dxfInsert:
					return fixed(new Entity(EntityKind.Insert), 1, from, to)
				case dxfLightPolyline:
					return lightPolyline(from, to)
				case dxfSpline:
					return spline(from, to)
				case dxfMesh:
					return mesh(from, to)
				case dxfPolyline:
					return polyline(z, end)
				default:
					return none
			}
		}

		// layer is the layer a group names: the string made for the group
		// before when it names the same one, as entities come in runs of a
		// layer.
		def layer(g int) string {
			return lastLayer when lastLayer.len() > 0 && reader.names(g, lastLayerBytes)
			lastLayer = reader.name(g)
			lastLayerBytes = lastLayer.bytes()
			return lastLayer
		}

		// common reads a group every entity may have into the entity and
		// reports whether the code was one of them.
		def common(e Entity, code int, g int) !bool {
			switch code {
				case 8:
					e.layer = layer(g)
				case 62:
					e.aci = try reader.whole(g)
				case 420:
					e.rgb = (try reader.whole(g)) & 0xFFFFFF
				case 440:
					// The low byte is the opacity when the value says it
					// holds one; else it is the layer's or the block's.
					let value = try reader.whole(g)
					e.alpha = value & 0xFF when value & 0x03000000 == 0x02000000
				case 60:
					e.invisible = (try reader.whole(g)) != 0
				case 67:
					e.paper = (try reader.whole(g)) != 0
				case 39:
					e.thickness = try reader.real(g)
				case 210:
					e.nx = try reader.real(g)
				case 220:
					e.ny = try reader.real(g)
				case 230:
					e.nz = try reader.real(g)
				default:
					return false
			}
			return true
		}

		// fixed reads an entity of `corners` positions, the groups 10 to 13
		// with their 20s and 30s, and the values of its kind.
		def fixed(e Entity, corners int, from int, to int) !Entity {
			e.points.len(corners * 3)
			let fourth = false
			for let g = from; g < to; g++ {
				let code = int(codes[g])
				continue when try common(e, code, g)
				if code >= 10 && code < 40 && code % 10 < corners {
					e.points[(code % 10) * 3 + code / 10 - 1] = try reader.real(g)
					fourth = true when code % 10 == 3
					continue
				}
				switch code {
					case 2:
						e.name = reader.name(g)
					case 40:
						if e.kind == EntityKind.Ellipse {
							e.ratio = try reader.real(g)
						} else {
							e.radius = try reader.real(g)
						}
					case 41:
						if e.kind == EntityKind.Ellipse {
							e.start = try reader.real(g)
						} else {
							e.sx = try reader.real(g)
						}
					case 42:
						if e.kind == EntityKind.Ellipse {
							e.end = try reader.real(g)
						} else {
							e.sy = try reader.real(g)
						}
					case 43:
						e.sz = try reader.real(g)
					case 44:
						e.columnSpacing = try reader.real(g)
					case 45:
						e.rowSpacing = try reader.real(g)
					case 50:
						if e.kind == EntityKind.Arc {
							e.start = (try reader.real(g)) * Pi / 180.0
						} else {
							e.rotation = (try reader.real(g)) * Pi / 180.0
						}
					case 51:
						e.end = (try reader.real(g)) * Pi / 180.0
					case 70:
						e.columns = try reader.whole(g) when e.kind == EntityKind.Insert
					case 71:
						e.rows = try reader.whole(g) when e.kind == EntityKind.Insert
					default:
				}
			}
			if corners == 4 {
				e.points.len(9) unless fourth
				// A SOLID's third and fourth corners are written across
				// its outline.
				if fourth && e.kind == EntityKind.Solid {
					for let k = 0; k < 3; k++ {
						let held = e.points[6 + k]
						e.points[6 + k] = e.points[9 + k]
						e.points[9 + k] = held
					}
				}
			}
			return e
		}

		// lightPolyline reads an LWPOLYLINE: vertices of x and y at one
		// elevation, each with the bulge of the arc to the next.
		def lightPolyline(from int, to int) !Entity {
			let e = new Entity(EntityKind.Polyline)
			e.planar = true
			let elevation = 0.0
			let bulged = false
			for let g = from; g < to; g++ {
				let code = int(codes[g])
				continue when try common(e, code, g)
				switch code {
					case 10:
						e.points.push(try reader.real(g), 0.0, 0.0)
						e.bulges.push(0.0)
					case 20:
						e.points[e.points.len() - 2] = try reader.real(g) when e.points.len() > 0
					case 42:
						if e.bulges.len() > 0 {
							e.bulges[e.bulges.len() - 1] = try reader.real(g)
							bulged = true
						}
					case 38:
						elevation = try reader.real(g)
					case 70:
						e.closed = (try reader.whole(g)) & 1 != 0
					default:
				}
			}
			for let k = 2; k < e.points.len(); k += 3 {
				e.points[k] = elevation
			}
			e.bulges = float[] unless bulged
			return e
		}

		// spline reads a SPLINE: degree, knots, control points with their
		// weights, and fit points.
		def spline(from int, to int) !Entity {
			let e = new Entity(EntityKind.Spline)
			for let g = from; g < to; g++ {
				let code = int(codes[g])
				continue when try common(e, code, g)
				switch code {
					case 70:
						e.closed = (try reader.whole(g)) & 1 != 0
					case 71:
						e.degree = try reader.whole(g)
					case 40:
						e.knots.push(try reader.real(g))
					case 41:
						e.weights.push(try reader.real(g))
					case 10:
						e.points.push(try reader.real(g), 0.0, 0.0)
					case 20:
						e.points[e.points.len() - 2] = try reader.real(g) when e.points.len() > 0
					case 30:
						e.points[e.points.len() - 1] = try reader.real(g) when e.points.len() > 0
					case 11:
						e.fit.push(try reader.real(g), 0.0, 0.0)
					case 21:
						e.fit[e.fit.len() - 2] = try reader.real(g) when e.fit.len() > 0
					case 31:
						e.fit[e.fit.len() - 1] = try reader.real(g) when e.fit.len() > 0
					default:
				}
			}
			return e
		}

		// mesh reads a MESH's base level: the vertices after their count
		// (92), then the face list after its length (93), each face a
		// count and that many vertices in groups 90. The edges and creases
		// that follow are read past.
		def mesh(from int, to int) !Entity {
			let e = new Entity(EntityKind.SubdMesh)
			let vertices = 0
			let listed = 0
			let seen = false
			for let g = from; g < to; g++ {
				let code = int(codes[g])
				continue when try common(e, code, g)
				switch code {
					case 92:
						vertices = try reader.whole(g) unless seen
						seen = true
					case 10:
						e.points.push(try reader.real(g), 0.0, 0.0) when e.points.len() < vertices * 3
					case 20:
						e.points[e.points.len() - 2] = try reader.real(g) when e.points.len() > 0 && listed == 0 && e.faces.len() == 0
					case 30:
						e.points[e.points.len() - 1] = try reader.real(g) when e.points.len() > 0 && listed == 0 && e.faces.len() == 0
					case 93:
						listed = try reader.whole(g) when e.faces.len() == 0
					case 90:
						if listed > 0 {
							e.faces.push(try reader.whole(g))
							listed--
						}
					default:
				}
			}
			return e
		}

		// polyline reads a POLYLINE and its VERTEX records up to SEQEND:
		// a polyface mesh, a polygon mesh, or a polyline in space or in
		// the entity's plane, as its flags say. The control points a
		// fitted spline or smoothed surface keeps beside its own vertices
		// are left out.
		def polyline(z int, end int) !Entity {
			let e = new Entity(EntityKind.Polyline)
			let flags = 0
			let counts = int[0, 0, 0, 0]
			let smooth = 0
			let elevation = 0.0
			for let g = zeros[z] + 1; g < zeros[z + 1]; g++ {
				let code = int(codes[g])
				continue when try common(e, code, g)
				switch code {
					case 30:
						elevation = try reader.real(g)
					case 70:
						flags = try reader.whole(g)
					case 71, 72, 73, 74:
						counts[code - 71] = try reader.whole(g)
					case 75:
						smooth = try reader.whole(g)
					default:
				}
			}
			let polyface = flags & 64 != 0
			let grid = !polyface && flags & 16 != 0
			e.kind = EntityKind.PolyfaceMesh when polyface
			e.kind = EntityKind.PolygonMesh when grid
			e.planar = !polyface && !grid && flags & 8 == 0
			e.closed = flags & 1 != 0
			e.closedN = flags & 32 != 0
			let bulged = false
			let coloured = false
			for let v = z + 1; v < end; v++ {
				let i = zeros[v]
				break when reader.names(i, sequenceEnd)
				continue unless reader.names(i, vertex)
				let x = 0.0
				let y = 0.0
				let height = 0.0
				let bulge = 0.0
				let kind = 0
				let face = int[0, 0, 0, 0]
				let colour = colorByLayer
				for let g = i + 1; g < zeros[v + 1]; g++ {
					switch int(codes[g]) {
						case 10:
							x = try reader.real(g)
						case 20:
							y = try reader.real(g)
						case 30:
							height = try reader.real(g)
						case 42:
							bulge = try reader.real(g)
						case 62:
							colour = try reader.whole(g)
						case 70:
							kind = try reader.whole(g)
						case 71, 72, 73, 74:
							face[int(codes[g]) - 71] = try reader.whole(g)
						default:
					}
				}
				if polyface && kind & 128 != 0 && kind & 64 == 0 {
					e.faces.push(...face)
					e.faceColors.push(colour)
					coloured = true when colour != colorByLayer
					continue
				}
				continue when kind & 16 != 0
				e.points.push(x, y, e.planar ?? (elevation, height))
				if e.planar {
					e.bulges.push(bulge)
					bulged = true when bulge != 0
				}
			}
			e.bulges = float[] unless bulged
			e.faceColors = int[] unless coloured
			if grid {
				let fits = smooth != 0 && counts[2] * counts[3] * 3 == e.points.len()
				e.m = fits ?? (counts[2], counts[0])
				e.n = fits ?? (counts[3], counts[1])
			}
			return e
		}
	}
}
