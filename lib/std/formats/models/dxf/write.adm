internal partial module std.formats.models.dxf {
	use (
		std.formats.models::*
		std.formats.models.acad::*
		std.gfx.bands
		std.io
	)

	// The releases a drawing is written as: R12, R13, R14, 2000, 2004,
	// 2007, 2010, 2013 and 2018.
	let dxfVersions = string["AC1009", "AC1012", "AC1014", "AC1015", "AC1018", "AC1021", "AC1024", "AC1027", "AC1032"]

	// The handles of the objects every drawing from R13 on has: the nine
	// tables, the two dictionaries, the tables' fixed entries and the two
	// layout blocks. Layers and entities take the handles from
	// dxfFirstHandle on.
	const dxfViewportTable = 0x1
	const dxfLinetypeTable = 0x2
	const dxfLayerTable = 0x3
	const dxfStyleTable = 0x4
	const dxfViewTable = 0x5
	const dxfUcsTable = 0x6
	const dxfAppTable = 0x7
	const dxfDimStyleTable = 0x8
	const dxfBlockTable = 0x9
	const dxfRootDictionary = 0xA
	const dxfGroupDictionary = 0xB
	const dxfViewport = 0xC
	const dxfLinetypes = 0xD
	const dxfStyle = 0x10
	const dxfApp = 0x11
	const dxfDimStyle = 0x12
	const dxfModelRecord = 0x13
	const dxfPaperRecord = 0x14
	const dxfModelBlock = 0x15
	const dxfPaperBlock = 0x17
	const dxfFirstHandle = 0x20

	// The points a band of the entity writer is given at least.
	const dxfBandPoints = 8192

	// dxfEncode writes the model as a DXF drawing of the release, in text
	// or binary. Fails with a ModelError for a release that is not one of
	// dxfVersions, or with the writer's own error.
	def dxfEncode(model Model, writer io.Writer, binary bool, version string) !none {
		let release = version.trim().upper()
		fail ModelError{message: "dxf: no release \"{version}\" is written; the releases are {dxfVersions.join(", ")}", format: "DXF", detail: version} unless dxfVersions.includes(release)
		let drawing = new Collector(model, release == "AC1009").collect()
		drawing.version = release
		return new DxfWriter(drawing, binary).write(writer)
	}

	// DxfOut writes groups as text or as binary.
	type DxfOut {
		out    byte[]
		binary bool
		// Binary codes take one byte, as releases before R13 wrote them.
		narrow bool
		// Text is UTF-8; else ASCII with `\U+XXXX` for the other characters.
		utf8   bool

		def new(binary bool, narrow bool, utf8 bool) {
			self.binary = binary
			self.narrow = narrow
			self.utf8 = utf8
		}

		// digits appends a whole number in decimal.
		def digits(value int) {
			if value < 0 {
				out.push(0x2D)
				value = -value
			}
			let from = out.len()
			for {
				out.push(byte(0x30 + value % 10))
				value /= 10
				break when value == 0
			}
			let last = out.len() - 1
			for let a = from; a < last; a++ {
				let held = out[a]
				out[a] = out[last]
				out[last] = held
				last--
			}
		}

		def code(c int) {
			if !binary {
				digits(c)
				out.push(0x0A)
			} else if !narrow {
				out.push(byte(c & 0xFF), byte(c >> 8))
			} else if c < 255 {
				out.push(byte(c))
			} else {
				out.push(0xFF, byte(c & 0xFF), byte(c >> 8))
			}
		}

		def text(c int, value string) {
			code(c)
			if utf8 || value.isASCII() {
				out.push(...value.bytes())
			} else {
				for let (_, letter) in value {
					let point = int(letter)
					if point < 0x80 {
						out.push(byte(point))
					} else if point < 0x10000 {
						out.push(..."\\U+{"%04X".format(point)}".bytes())
					} else {
						out.push(0x5F)
					}
				}
			}
			out.push(binary ?? (byte(0), byte(0x0A)))
		}

		def handle(c int, value int) {
			text(c, "%X".format(value))
		}

		def whole(c int, value int) {
			code(c)
			if !binary {
				digits(value)
				out.push(0x0A)
				return
			}
			let size = 2
			switch dxfKind(c) {
				case dxfInt32:
					size = 4
				case dxfInt64:
					size = 8
				case dxfByte:
					size = 1
				default:
			}
			for let k = 0; k < size; k++ {
				out.push(byte((value >> (8 * k)) & 0xFF))
			}
		}

		def real(c int, value float) {
			code(c)
			if binary {
				let bits = __bitcast_u64_from_f64(value)
				for let k = 0; k < 8; k++ {
					out.push(byte((bits >> uint64(8 * k)) & 0xFF))
				}
				return
			}
			let from = out.len()
			out.push(..."%.15g".format(value).bytes())
			// A whole number is written with its point, as a real is.
			let whole = true
			for let k = from; k < out.len() && whole; k++ {
				whole = out[k] == 0x2D || (out[k] >= 0x30 && out[k] <= 0x39)
			}
			out.push(0x2E, 0x30) when whole
			out.push(0x0A)
		}

		def point(x float, y float, z float) {
			real(10, x)
			real(20, y)
			real(30, z)
		}
	}

	// DxfWriter writes a drawing of polyface meshes, polylines in space
	// and points on its layers.
	type DxfWriter {
		drawing Drawing
		binary  bool
		// From R13 on objects have handles, owners and subclass markers,
		// and the file a CLASSES and an OBJECTS section.
		handles bool
		// From 2004 on an entity may have a colour and an opacity of its
		// own beside its colour number.
		colours bool
		utf8    bool

		def new(drawing Drawing, binary bool) {
			self.drawing = drawing
			self.binary = binary
			handles = drawing.version != "AC1009"
			colours = drawing.version >= "AC1018"
			utf8 = drawing.version >= "AC1021"
		}

		def fresh() DxfOut {
			return new DxfOut(binary, !handles, utf8)
		}

		// handlesOf is how many handles an entity takes: its own, and for
		// a polyline one per vertex and face and one for its end.
		def handlesOf(e Entity) int {
			return 1 when e.kind == EntityKind.Point
			return 2 + e.points.len() / 3 + e.faces.len() / 4
		}

		def write(writer io.Writer) !none {
			drawing.bind()
			let entities = drawing.entities
			// The handle each entity starts at, and the one after the last.
			let starts int[]
			let next = dxfFirstHandle + drawing.layers.len()
			let points = 0
			for let (_, e) in entities {
				starts.push(next)
				next += handlesOf(e)
				points += e.points.len() / 3 + e.faces.len() / 4
			}
			let head = fresh()
			head.out.push(...dxfBinaryMark.bytes(), 0x0D, 0x0A, 0x1A, 0x00) when binary
			header(head, next)
			if handles {
				section(head, "CLASSES")
				head.text(0, "ENDSEC")
			}
			tables(head)
			blocks(head)
			section(head, "ENTITIES")
			try writer.write(head.out)
			// The entities are written in bands on tasks, each band into
			// its own bytes.
			let count = entities.len()
			let weight = points * (bands.bandPixels / dxfBandPoints)
			let parts DxfOut[]
			for let b = 0; b < bands.bandCount(count, weight); b++ {
				parts.push(fresh())
			}
			if count > 0 {
				bands.forBands(count, weight, (from int, to int) => {
					let out = parts[bands.bandOf(from, count, parts.len())]
					for let i = from; i < to; i++ {
						entity(out, entities[i], starts[i])
					}
				})
			}
			for let (_, part) in parts {
				try writer.write(part.out)
			}
			let tail = fresh()
			tail.text(0, "ENDSEC")
			if handles {
				section(tail, "OBJECTS")
				tail.text(0, "DICTIONARY")
				tail.handle(5, dxfRootDictionary)
				tail.handle(330, 0)
				tail.text(100, "AcDbDictionary")
				tail.whole(281, 1)
				tail.text(3, "ACAD_GROUP")
				tail.handle(350, dxfGroupDictionary)
				tail.text(0, "DICTIONARY")
				tail.handle(5, dxfGroupDictionary)
				tail.handle(330, dxfRootDictionary)
				tail.text(100, "AcDbDictionary")
				tail.whole(281, 1)
				tail.text(0, "ENDSEC")
			}
			tail.text(0, "EOF")
			try writer.write(tail.out)
			return none
		}

		def section(out DxfOut, name string) {
			out.text(0, "SECTION")
			out.text(2, name)
		}

		// extents is the box around every entity's points: its least and
		// greatest corner, the pair AutoCAD writes for an vacant drawing
		// when there are none.
		def extents() float[] {
			let box = float[1e20, 1e20, 1e20, -1e20, -1e20, -1e20]
			for let (_, e) in drawing.entities {
				let p = e.points
				for let i = 0; i + 2 < p.len(); i += 3 {
					for let k = 0; k < 3; k++ {
						box[k] = box[k].min(p[i + k])
						box[3 + k] = box[3 + k].max(p[i + k])
					}
				}
			}
			return box
		}

		// header writes the variables a reader needs: the release, the
		// code page of releases that have one, the drawing's box, its unit
		// and the next free handle.
		def header(out DxfOut, seed int) {
			section(out, "HEADER")
			out.text(9, "$ACADVER")
			out.text(1, drawing.version)
			if handles {
				out.text(9, "$DWGCODEPAGE")
				out.text(3, "ANSI_1252")
			}
			let box = extents()
			out.text(9, "$INSBASE")
			out.point(0, 0, 0)
			out.text(9, "$EXTMIN")
			out.point(box[0], box[1], box[2])
			out.text(9, "$EXTMAX")
			out.point(box[3], box[4], box[5])
			if drawing.version >= "AC1015" {
				out.text(9, "$INSUNITS")
				let units = drawing.header.get("INSUNITS")
				out.whole(70, units is none ?? (0, units.toInt<int>()))
			}
			if handles {
				out.text(9, "$HANDSEED")
				out.handle(5, seed)
			}
			out.text(0, "ENDSEC")
		}

		// table opens a table of `count` entries.
		def table(out DxfOut, name string, handle int, count int) {
			out.text(0, "TABLE")
			out.text(2, name)
			if handles {
				out.handle(5, handle)
				out.handle(330, 0)
				out.text(100, "AcDbSymbolTable")
			}
			out.whole(70, count)
		}

		// entry opens a table's entry.
		def entry(out DxfOut, kind string, handle int, owner int, class string, name string) {
			out.text(0, kind)
			if handles {
				// A dimension style's handle has a code of its own.
				out.handle(kind == "DIMSTYLE" ?? (105, 5), handle)
				out.handle(330, owner)
				out.text(100, "AcDbSymbolTableRecord")
				out.text(100, class)
			}
			out.text(2, name)
			out.whole(70, 0) unless kind == "BLOCK_RECORD"
		}

		def linetype(out DxfOut, handle int, name string, description string) {
			entry(out, "LTYPE", handle, dxfLinetypeTable, "AcDbLinetypeTableRecord", name)
			out.text(3, description)
			out.whole(72, 65)
			out.whole(73, 0)
			out.real(40, 0)
		}

		// tables writes the layer table and, from R13 on, the tables a
		// drawing must have with the one entry each needs: a viewport on
		// the drawing's box, the three line types, the text style, the
		// application name, the dimension style and the two layout blocks'
		// records.
		def tables(out DxfOut) {
			section(out, "TABLES")
			if handles {
				let box = extents()
				let vacant = box[0] > box[3]
				table(out, "VPORT", dxfViewportTable, 1)
				entry(out, "VPORT", dxfViewport, dxfViewportTable, "AcDbViewportTableRecord", "*Active")
				out.real(10, 0)
				out.real(20, 0)
				out.real(11, 1)
				out.real(21, 1)
				// The view's centre and height.
				out.real(12, vacant ?? (0.0, (box[0] + box[3]) / 2.0))
				out.real(22, vacant ?? (0.0, (box[1] + box[4]) / 2.0))
				out.real(13, 0)
				out.real(23, 0)
				out.real(14, 0.5)
				out.real(24, 0.5)
				out.real(15, 0.5)
				out.real(25, 0.5)
				out.real(16, 0)
				out.real(26, 0)
				out.real(36, 1)
				out.real(17, 0)
				out.real(27, 0)
				out.real(37, 0)
				out.real(40, vacant ?? (1000.0, (box[4] - box[1]).max(box[3] - box[0]).max(1e-9)))
				out.real(41, 1.34)
				out.real(42, 50)
				out.real(43, 0)
				out.real(44, 0)
				out.real(50, 0)
				out.real(51, 0)
				out.whole(71, 0)
				out.whole(72, 1000)
				out.whole(73, 1)
				out.whole(74, 3)
				out.whole(75, 0)
				out.whole(76, 0)
				out.whole(77, 0)
				out.whole(78, 0)
				out.text(0, "ENDTAB")
				table(out, "LTYPE", dxfLinetypeTable, 3)
				linetype(out, dxfLinetypes, "ByBlock", "")
				linetype(out, dxfLinetypes + 1, "ByLayer", "")
				linetype(out, dxfLinetypes + 2, "Continuous", "Solid line")
			} else {
				table(out, "LTYPE", 0, 1)
				linetype(out, 0, "CONTINUOUS", "Solid line")
			}
			out.text(0, "ENDTAB")
			table(out, "LAYER", dxfLayerTable, drawing.layers.len())
			for let (i, layer) in drawing.layers {
				entry(out, "LAYER", dxfFirstHandle + i, dxfLayerTable, "AcDbLayerTableRecord", layer.name)
				out.whole(62, layer.aci)
				out.text(6, handles ?? ("Continuous", "CONTINUOUS"))
			}
			out.text(0, "ENDTAB")
			if handles {
				table(out, "STYLE", dxfStyleTable, 1)
				entry(out, "STYLE", dxfStyle, dxfStyleTable, "AcDbTextStyleTableRecord", "Standard")
				out.real(40, 0)
				out.real(41, 1)
				out.real(50, 0)
				out.whole(71, 0)
				out.real(42, 2.5)
				out.text(3, "txt")
				out.text(4, "")
				out.text(0, "ENDTAB")
				table(out, "VIEW", dxfViewTable, 0)
				out.text(0, "ENDTAB")
				table(out, "UCS", dxfUcsTable, 0)
				out.text(0, "ENDTAB")
				table(out, "APPID", dxfAppTable, 1)
				entry(out, "APPID", dxfApp, dxfAppTable, "AcDbRegAppTableRecord", "ACAD")
				out.text(0, "ENDTAB")
				table(out, "DIMSTYLE", dxfDimStyleTable, 1)
				out.text(100, "AcDbDimStyleTable")
				entry(out, "DIMSTYLE", dxfDimStyle, dxfDimStyleTable, "AcDbDimStyleTableRecord", "Standard")
				out.text(0, "ENDTAB")
				table(out, "BLOCK_RECORD", dxfBlockTable, 2)
				entry(out, "BLOCK_RECORD", dxfModelRecord, dxfBlockTable, "AcDbBlockTableRecord", "*Model_Space")
				entry(out, "BLOCK_RECORD", dxfPaperRecord, dxfBlockTable, "AcDbBlockTableRecord", "*Paper_Space")
				out.text(0, "ENDTAB")
			}
			out.text(0, "ENDSEC")
		}

		// blocks writes the two layout blocks a drawing from R13 on has,
		// both vacant: model space's entities are in the ENTITIES section.
		def blocks(out DxfOut) {
			section(out, "BLOCKS")
			if handles {
				block(out, dxfModelBlock, dxfModelRecord, "*Model_Space")
				block(out, dxfPaperBlock, dxfPaperRecord, "*Paper_Space")
			}
			out.text(0, "ENDSEC")
		}

		def block(out DxfOut, handle int, record int, name string) {
			out.text(0, "BLOCK")
			out.handle(5, handle)
			out.handle(330, record)
			out.text(100, "AcDbEntity")
			out.text(8, "0")
			out.text(100, "AcDbBlockBegin")
			out.text(2, name)
			out.whole(70, 0)
			out.point(0, 0, 0)
			out.text(3, name)
			out.text(1, "")
			out.text(0, "ENDBLK")
			out.handle(5, handle + 1)
			out.handle(330, record)
			out.text(100, "AcDbEntity")
			out.text(8, "0")
			out.text(100, "AcDbBlockEnd")
		}

		// opening writes what every entity starts with: its type, handle
		// and owner, its layer, and its colour when it has one of its own.
		def opening(out DxfOut, kind string, e Entity, handle int, owner int, coloured bool) {
			out.text(0, kind)
			if handles {
				out.handle(5, handle)
				out.handle(330, owner)
				out.text(100, "AcDbEntity")
			}
			out.text(8, e.layer)
			return unless coloured && e.aci != colorByLayer
			out.whole(62, e.aci)
			return unless colours
			out.whole(420, e.rgb) when e.rgb >= 0 && e.rgb != aciColor(e.aci)
			out.whole(440, 0x02000000 | e.alpha) when e.alpha < 255
		}

		def class(out DxfOut, name string) {
			out.text(100, name) when handles
		}

		// entity writes a point, a polyline in space or a polyface mesh,
		// the latter two with a VERTEX per position (and per face) and a
		// SEQEND, taking handles from `handle` on.
		def entity(out DxfOut, e Entity, handle int) {
			let p = e.points
			if e.kind == EntityKind.Point {
				opening(out, "POINT", e, handle, dxfModelRecord, true)
				class(out, "AcDbPoint")
				out.point(p[0], p[1], p[2])
				return
			}
			return unless e.kind == EntityKind.Polyline || e.kind == EntityKind.PolyfaceMesh
			let mesh = e.kind == EntityKind.PolyfaceMesh
			opening(out, "POLYLINE", e, handle, dxfModelRecord, true)
			class(out, mesh ?? ("AcDbPolyFaceMesh", "AcDb3dPolyline"))
			out.whole(66, 1)
			out.point(0, 0, 0)
			out.whole(70, mesh ?? (64, e.closed ?? (9, 8)))
			if mesh {
				out.whole(71, p.len() / 3)
				out.whole(72, e.faces.len() / 4)
			}
			let next = handle + 2
			for let i = 0; i + 2 < p.len(); i += 3 {
				opening(out, "VERTEX", e, next, handle, false)
				class(out, "AcDbVertex")
				class(out, mesh ?? ("AcDbPolyFaceMeshVertex", "AcDb3dPolylineVertex"))
				out.point(p[i], p[i + 1], p[i + 2])
				out.whole(70, mesh ?? (192, 32))
				next++
			}
			for let f = 0; f + 3 < e.faces.len(); f += 4 {
				opening(out, "VERTEX", e, next, handle, false)
				class(out, "AcDbFaceRecord")
				out.point(0, 0, 0)
				out.whole(70, 128)
				for let k = 0; k < 4; k++ {
					out.whole(71 + k, e.faces[f + k]) when e.faces[f + k] != 0
				}
				next++
			}
			opening(out, "SEQEND", e, handle + 1, handle, false)
		}
	}
}
