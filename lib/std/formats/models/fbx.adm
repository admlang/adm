partial module std.formats.models {
	use std.io

	// Fbx is Autodesk FBX, binary (versions 7100 to 7700) and text. Reads the
	// node hierarchy with its transforms (pre- and post-rotation, pivots and
	// offsets folded into the node's transform), meshes with normals, tangents,
	// texture coordinate and colour layers and polygons of any size
	// (triangulated), Phong and Lambert materials and the FBX PBR properties,
	// textures with their files through the ResourceReader or embedded, cameras,
	// lights, skin deformers and blend shapes, and animation stacks as
	// animations (curves sampled at their keys). Writes the binary form by
	// default with the same content; constraints, NURBS and video are left out.
	@codec("FBX")
	type Fbx {
		// Write the binary form; false writes text.
		binary  bool = true
		// The FBX version written, 7100 to 7700.
		version int  = 7400

		mimeType string[] {
			def get() string[] {
				return string["application/vnd.autodesk.fbx"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".fbx"]
			}
		}

		// matchSignature tests for the binary magic `Kaydara FBX Binary` and the
		// `; FBX` comment the text form opens with.
		def matchSignature(r io.Reader) bool {
			let b = prefix(r, 18)
			return false when b.len() < 5
			let head = string(b)
			return head.startsWith("Kaydara FBX Binary") || head.startsWith("; FBX")
		}

		// decode reads the whole reader as FBX. Fails with a ModelError when the
		// file is not FBX, the version is not read, or a record is truncated,
		// or with the reader's own error.
		def decode(reader io.Reader, resources ?ResourceReader) !Model {}

		// encode writes the model as FBX of `version`, textures as files through
		// resources or embedded without one. Fails with the writer's own error,
		// or a texture file's.
		def encode(model Model, writer io.Writer, resources ?ResourceWriter) !none {}
	}
}
