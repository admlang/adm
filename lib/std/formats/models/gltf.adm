partial module std.formats.models {
	use (
		std.formats.models.gltf::*
		std.io
	)

	// Gltf is glTF 2.0 as JSON (`.gltf`): the scene in text, with its buffers
	// and images in files beside it or embedded as data URIs. Reads every core
	// feature (scenes, nodes, meshes with every attribute and morph targets,
	// materials, textures and samplers, cameras, skins, animations) and the
	// `KHR_lights_punctual`, `KHR_materials_emissive_strength`,
	// `KHR_materials_unlit` and `KHR_texture_transform` extensions; other
	// extensions are kept in the metadata as text. Writes the same, with
	// buffers and images as files through the ResourceWriter, or as data URIs
	// when there is none. Glb is the binary form.
	@codec("glTF")
	type Gltf {
		// Write buffers and images as data URIs inside the JSON even when there
		// is somewhere to put files.
		embed bool = false

		mimeType string[] {
			def get() string[] {
				return string["model/gltf+json"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".gltf"]
			}
		}

		// matchSignature is always false: the JSON form has no signature, so it
		// is found by its file extension.
		def matchSignature(r io.Reader) bool {
			return false
		}

		// decode reads the whole reader as glTF JSON. Fails with a ModelError
		// when the JSON is not a glTF asset or refers to a buffer that cannot be
		// opened, or with the reader's own error.
		def decode(reader io.Reader, resources ?ResourceReader) !Model {
			let data = try io.readAll(reader)
			return gltfDecode(data, resources)
		}

		// encode writes the model as glTF JSON. Fails with the writer's own
		// error, or a resource file's.
		def encode(model Model, writer io.Writer, resources ?ResourceWriter) !none {
			return gltfEncode(model, writer, resources, embed)
		}
	}

	// Glb is glTF 2.0 in its binary container (`.glb`): the JSON chunk and one
	// binary chunk holding the buffers, and images either in that buffer or in
	// files beside it. Reads and writes what Gltf does; the writer puts every
	// buffer and image into the binary chunk.
	@codec("glTF Binary")
	type Glb {
		mimeType string[] {
			def get() string[] {
				return string["model/gltf-binary"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".glb"]
			}
		}

		// matchSignature tests for the `glTF` magic.
		def matchSignature(r io.Reader) bool {
			let b = prefix(r, 4)
			return b.len() == 4 && b[0] == 0x67 && b[1] == 0x6C && b[2] == 0x54 && b[3] == 0x46
		}

		// decode reads the whole reader as a GLB container. Fails with a
		// ModelError when the container or its JSON is malformed, or with the
		// reader's own error.
		def decode(reader io.Reader, resources ?ResourceReader) !Model {
			let data = try io.readAll(reader)
			return glbDecode(data, resources)
		}

		// encode writes the model as one GLB file. Fails with the writer's own
		// error.
		def encode(model Model, writer io.Writer, resources ?ResourceWriter) !none {
			return glbEncode(model, writer)
		}
	}
}
