internal partial module std.formats.models.gltf {
	use (
		std.data.encoding::(JSON, base64decode)
		std.formats
		std.formats.models::*
		std.gfx.bands
		std.gfx.color
		std.io
		std.math.geom::(Quaternion, Vec3)
		std.net.url::(unescape)
		std.simd
	)

	const gltfFormat = "glTF"
	const glbFormat = "glTF Binary"

	// Accessor component types.
	const gltfCompByte = 5120
	const gltfCompUnsignedByte = 5121
	const gltfCompShort = 5122
	const gltfCompUnsignedShort = 5123
	const gltfCompUnsignedInt = 5125
	const gltfCompFloat = 5126

	// GLB chunk types.
	const glbChunkJson = 0x4E4F534A
	const glbChunkBin = 0x004E4942

	// glbDecode reads a GLB container: the JSON chunk and the binary chunk
	// the buffers without a uri take.
	def glbDecode(data byte[], resources ?ResourceReader) !Model {
		fail ModelError{message: "not a GLB container: no glTF magic", format: glbFormat} when data.len() < 20 || data[0] != 0x67 || data[1] != 0x6C || data[2] != 0x54 || data[3] != 0x46
		let version = int(gltfLE32(data, 4))
		fail ModelError{message: "GLB version {version} is not 2", format: glbFormat} when version != 2
		let length = int(gltfLE32(data, 8))
		fail ModelError{message: "GLB declares {length} bytes, the file holds {data.len()}", format: glbFormat} when length > data.len() || length < 12
		let json ?byte[]
		let bin ?byte[]
		let pos = 12
		for pos + 8 <= length {
			let size = int(gltfLE32(data, pos))
			let kind = int(gltfLE32(data, pos + 4))
			fail ModelError{message: "GLB chunk at {pos} reaches past the end of the file", format: glbFormat, detail: "chunk {kind}"} when size < 0 || pos + 8 + size > length
			if kind == glbChunkJson && json is none {
				json = data[pos + 8:pos + 8 + size]
			} else if kind == glbChunkBin && bin is none {
				bin = data[pos + 8:pos + 8 + size]
			}
			pos += 8 + size
		}
		fail ModelError{message: "GLB has no JSON chunk", format: glbFormat} when json is none
		return gltfDecodeDocument(json, bin, resources, glbFormat)
	}

	// gltfDecode reads glTF JSON with its buffers and images in files beside
	// it or in data URIs.
	def gltfDecode(data byte[], resources ?ResourceReader) !Model {
		return gltfDecodeDocument(data, none, resources, gltfFormat)
	}

	def gltfLE32(data byte[], at int) uint32 {
		return uint32(data[at]) | (uint32(data[at + 1]) << 8) | (uint32(data[at + 2]) << 16) | (uint32(data[at + 3]) << 24)
	}

	// gltfDecodeDocument reads the asset's JSON into a Model; bin is the GLB
	// binary chunk, taken by the first buffer without a uri.
	def gltfDecodeDocument(json byte[], bin ?byte[], resources ?ResourceReader, format string) !Model {
		let parsed = new JSON().parse(json) onerror (err error) {
			fail ModelError{message: "not glTF JSON: {err.message}", format: format, cause: err}
		}
		fail ModelError{message: "not a glTF asset: the JSON is not an object", format: format} unless parsed is map<string, any>
		let asset = gltfObject(parsed, "asset")
		fail ModelError{message: "not a glTF asset: no asset.version", format: format} when asset is none
		let version = gltfString(asset, "version", "")
		fail ModelError{message: "glTF version \"{version}\" is not 2.x", format: format} unless version.startsWith("2.") || version == "2"
		let reader = new GltfReader(parsed, bin, resources, format)
		return reader.read()
	}

	// The object member, none when absent or not an object.
	def gltfObject(m map<string, any>, key string) ?map<string, any> {
		let v = m.get(key)
		return v when v is map<string, any>
		return none
	}

	// The array member, empty when absent or not an array.
	def gltfArray(m map<string, any>, key string) any[] {
		let v = m.get(key)
		return v when v is any[]
		let nothing any[]
		return nothing
	}

	// A JSON number as a float, none for anything else.
	def gltfNumber(v ?any) ?float {
		return float(v) when v is int
		return v when v is float
		return none
	}

	def gltfFloat(m map<string, any>, key string, fallback float) float {
		let n = gltfNumber(m.get(key))
		return fallback when n is none
		return n
	}

	def gltfInt(m map<string, any>, key string, fallback int) int {
		let v = m.get(key)
		return v when v is int
		return int(v) when v is float
		return fallback
	}

	def gltfString(m map<string, any>, key string, fallback string) string {
		let v = m.get(key)
		return v when v is string
		return fallback
	}

	def gltfBool(m map<string, any>, key string, fallback bool) bool {
		let v = m.get(key)
		return v when v is bool
		return fallback
	}

	// The numbers of an array member, in order; values that are not numbers
	// are dropped.
	def gltfFloats(m map<string, any>, key string) float[] {
		let out float[]
		for let v in gltfArray(m, key) {
			let n = gltfNumber(v)
			out.push(n) unless n is none
		}
		return out
	}

	// gltfText is a JSON value as text: a string as it is, anything else
	// re-encoded as JSON.
	def gltfText(v any) string {
		return v when v is string
		return string(new JSON().encode(v))
	}

	// gltfDataUri decodes a base64 data URI into its bytes and media type.
	// Fails when the URI is not base64 data.
	def gltfDataUri(uri string, what string, format string) !(byte[], string) {
		let comma = uri.indexOf(",")
		fail ModelError{message: "{what} has a data URI with no data", format: format, detail: uri[:uri.len().min(64)]} when comma < 0
		let header = uri[5:comma]
		fail ModelError{message: "{what} has a data URI that is not base64", format: format, detail: header} unless header.endsWith(";base64")
		let mime = header[:header.len() - 7]
		let semicolon = mime.indexOf(";")
		mime = mime[:semicolon] when semicolon >= 0
		let data = base64decode(uri[comma + 1:]) onerror (err error) {
			fail ModelError{message: "{what} has a data URI that is not base64: {err.message}", format: format, cause: err}
		}
		return (data, mime)
	}

	// gltfOpen opens a file through the resources, none when it is not there.
	def gltfOpen(resources ResourceReader, name string) ?io.Reader {
		let r ?io.Reader
		r = resources.open(name) onerror (err error) {
			return none
		}
		return r
	}

	// gltfClose closes a reader that can be closed.
	def gltfClose(r io.Reader) {
		if r is io.Closer {
			r.close() onerror recover none
		}
	}

	// gltfExtension is the file extension of a media type, with its dot;
	// empty for an unknown type.
	def gltfExtension(mime string) string {
		return "" when mime.len() == 0
		let known = formats.extensionsByType(mime)
		return known[0] when known.len() > 0
		return ""
	}

	// GltfView is a bufferView: a range of a buffer and the stride its
	// vertex attributes are laid out at, 0 for packed.
	struct GltfView {
		buffer int
		offset int
		length int
		stride int
	}

	// GltfAccessor is a typed view into a bufferView: `count` elements of
	// `components` values of the component type, from the view's start
	// plus `offset`. `viewIndex` is -1 for an accessor of zeros (sparse ones
	// start from them).
	struct GltfAccessor {
		index         int
		componentType int
		componentSize int
		components    int
		count         int
		normalized    bool
		viewIndex     int
		offset        int
		sparse        ?map<string, any>
	}

	// GltfReader turns one parsed asset into a Model, in dependency order:
	// buffers, views, images, textures, materials, meshes, cameras, lights,
	// nodes, skins, animations, then the scene.
	type GltfReader {
		doc         map<string, any>
		bin         ?byte[]
		resources   ?ResourceReader
		format      string
		model       Model
		buffers     byte[][]
		views       GltfView[]
		accessors   any[]
		imageNames  string[]
		imageMimes  string[]
		textures    Texture[]
		materials   Material[]
		meshes      Mesh[]
		// Per mesh, its default morph target weights.
		meshWeights float[][]
		cameras     Camera[]
		lights      Light[]
		nodes       Node[]
		skins       Skin[]

		def new(doc map<string, any>, bin ?byte[], resources ?ResourceReader, format string) {
			self.doc = doc
			self.bin = bin
			self.resources = resources
			self.format = format
			model = new Model()
			buffers = byte[][]
			views = GltfView[]
			accessors = gltfArray(doc, "accessors")
			imageNames = string[]
			imageMimes = string[]
			textures = Texture[]
			materials = Material[]
			meshes = Mesh[]
			meshWeights = float[][]
			cameras = Camera[]
			lights = Light[]
			nodes = Node[]
			skins = Skin[]
		}

		def refuse(message string, detail string = "") ModelError {
			return ModelError{message: message, format: format, detail: detail}
		}

		def read() !Model {
			try readBuffers()
			try readViews()
			try readImages()
			try readTextures()
			try readMaterials()
			try readMeshes()
			try readCameras()
			try readLights()
			try readNodes()
			try readSkins()
			try readAnimations()
			try readScene()
			readMetadata()
			return model
		}

		// item is the i-th object of a top-level list. Fails when there is
		// none.
		def item(list string, i int) !map<string, any> {
			let items = gltfArray(doc, list)
			fail refuse("{list}[{i}] does not exist: the asset has {items.len()}", "{list}[{i}]") when i < 0 || i >= items.len()
			let v = items[i]
			fail refuse("{list}[{i}] is not an object", "{list}[{i}]") unless v is map<string, any>
			return v
		}

		// --- buffers and accessors ---

		def readBuffers() !none {
			for let (i, v) in gltfArray(doc, "buffers") {
				fail refuse("buffers[{i}] is not an object") unless v is map<string, any>
				let length = gltfInt(v, "byteLength", 0)
				let uri = gltfString(v, "uri", "")
				let data byte[]
				if uri.len() == 0 {
					let b = bin
					fail refuse("buffers[{i}] has no uri and the file has no binary chunk", "buffers[{i}]") when b is none
					data = b
				} else if uri.startsWith("data:") {
					let (bytes, _) = try gltfDataUri(uri, "buffers[{i}]", format)
					data = bytes
				} else {
					data = try openResource(uri, "buffers[{i}]")
				}
				fail refuse("buffers[{i}] holds {data.len()} bytes, {length} declared", uri) when data.len() < length
				buffers.push(data)
			}
			return none
		}

		// openResource reads a file beside the model through the resources.
		// Fails when there are none or the file cannot be read.
		def openResource(uri string, what string) !byte[] {
			let res = resources
			fail refuse("{what} refers to \"{uri}\" and there is nowhere to read it from", uri) when res is none
			let name = unescape(uri) onerror recover uri
			let r = res.open(name) onerror (err error) {
				fail ModelError{message: "{what}: cannot open \"{name}\": {err.message}", format: format, detail: name, cause: err}
			}
			let data = io.readAll(r) onerror (err error) {
				gltfClose(r)
				fail ModelError{message: "{what}: cannot read \"{name}\": {err.message}", format: format, detail: name, cause: err}
			}
			gltfClose(r)
			return data
		}

		def readViews() !none {
			for let (i, v) in gltfArray(doc, "bufferViews") {
				fail refuse("bufferViews[{i}] is not an object") unless v is map<string, any>
				let buffer = gltfInt(v, "buffer", -1)
				fail refuse("bufferViews[{i}] names buffer {buffer}, the asset has {buffers.len()}", "bufferViews[{i}]") when buffer < 0 || buffer >= buffers.len()
				let bv = GltfView{buffer: buffer, offset: gltfInt(v, "byteOffset", 0), length: gltfInt(v, "byteLength", 0), stride: gltfInt(v, "byteStride", 0)}
				fail refuse("bufferViews[{i}] reaches past buffer {buffer}", "bufferViews[{i}]") when bv.offset < 0 || bv.length < 0 || bv.offset + bv.length > buffers[buffer].len()
				views.push(bv)
			}
			return none
		}

		// accessor reads the i-th accessor's description, checked against its
		// bv. Fails when it is malformed or reaches past its bv.
		def accessor(i int) !GltfAccessor {
			fail refuse("accessors[{i}] does not exist: the asset has {accessors.len()}", "accessors[{i}]") when i < 0 || i >= accessors.len()
			let v = accessors[i]
			fail refuse("accessors[{i}] is not an object") unless v is map<string, any>
			let componentType = gltfInt(v, "componentType", 0)
			let size = gltfComponentSize(componentType)
			fail refuse("accessors[{i}] has component type {componentType}, which glTF does not define", "accessors[{i}]") when size == 0
			let components = gltfComponentCount(gltfString(v, "type", ""))
			fail refuse("accessors[{i}] has type \"{gltfString(v, "type", "")}\", which glTF does not define", "accessors[{i}]") when components == 0
			let count = gltfInt(v, "count", -1)
			fail refuse("accessors[{i}] has no count", "accessors[{i}]") when count < 0
			let acc = GltfAccessor{index: i, componentType: componentType, componentSize: size, components: components, count: count, normalized: gltfBool(v, "normalized", false), viewIndex: gltfInt(v, "bufferView", -1), offset: gltfInt(v, "byteOffset", 0), sparse: gltfObject(v, "sparse")}
			if acc.viewIndex >= 0 {
				fail refuse("accessors[{i}] names bufferView {acc.viewIndex}, the asset has {views.len()}", "accessors[{i}]") when acc.viewIndex >= views.len()
				let bv = views[acc.viewIndex]
				let stride = strideOf(acc, bv)
				let need = count == 0 ?? (0, acc.offset + (count - 1) * stride + components * size)
				fail refuse("accessors[{i}] reaches past bufferView {acc.viewIndex}: {need} bytes of {bv.length}", "accessors[{i}]") when acc.offset < 0 || need > bv.length
			}
			return acc
		}

		// strideOf is the distance between two elements of the accessor.
		def strideOf(acc GltfAccessor, bv GltfView) int {
			return bv.stride when bv.stride > 0
			return acc.components * acc.componentSize
		}

		// readFloats reads an accessor as float32 values, `components` per
		// element, integer components converted (normalized ones to -1..1 or
		// 0..1) and a sparse accessor's substitutions applied.
		def readFloats(i int) !float32[] {
			let acc = try accessor(i)
			let out float32[]
			out.len(acc.count * acc.components)
			if acc.viewIndex >= 0 {
				let bv = views[acc.viewIndex]
				let buf = buffers[bv.buffer]
				let base = bv.offset + acc.offset
				let stride = strideOf(acc, bv)
				let c = acc.components
				if acc.componentType == gltfCompFloat && stride == 4 * c {
					copyFloats(buf, base, out)
				} else {
					let kind = acc.componentType
					let normalized = acc.normalized
					let size = acc.componentSize
					bands.forBands(acc.count, acc.count * c, (from int, to int) => {
						for let e = from; e < to; e++ {
							let at = base + e * stride
							for let k = 0; k < c; k++ {
								out[e * c + k] = gltfComponent(buf, at + k * size, kind, normalized)
							}
						}
					})
				}
			}
			try applySparseFloats(acc, out)
			return out
		}

		// copyFloats copies packed float32 values out of the buffer, four a
		// vector, in bands.
		def copyFloats(buf byte[], base int, out float32[]) {
			let n = out.len()
			bands.forBands(n, n, (from int, to int) => {
				let i = from
				for i + 4 <= to {
					simd.store4(out, i, simd.loadBytes16(buf, base + 4 * i).bitcast4<float32>())
					i += 4
				}
				for i < to {
					out[i] = __bitcast_f32_from_u32(gltfLE32(buf, base + 4 * i))
					i++
				}
			})
		}

		// readUints reads an integer accessor as uint32 values, for indices
		// and joints. Fails when the component type is not an integer.
		def readUints(i int) !uint32[] {
			let acc = try accessor(i)
			fail refuse("accessors[{i}] holds floats where integers are needed", "accessors[{i}]") when acc.componentType == gltfCompFloat
			let out uint32[]
			out.len(acc.count * acc.components)
			if acc.viewIndex >= 0 {
				let bv = views[acc.viewIndex]
				let buf = buffers[bv.buffer]
				let base = bv.offset + acc.offset
				let stride = strideOf(acc, bv)
				let c = acc.components
				let size = acc.componentSize
				let kind = acc.componentType
				if kind == gltfCompUnsignedInt && stride == 4 * c {
					let n = out.len()
					bands.forBands(n, n, (from int, to int) => {
						let k = from
						for k + 4 <= to {
							simd.store4(out, k, simd.loadBytes16(buf, base + 4 * k).bitcast4<uint32>())
							k += 4
						}
						for k < to {
							out[k] = gltfLE32(buf, base + 4 * k)
							k++
						}
					})
				} else {
					for let e = 0; e < acc.count; e++ {
						let at = base + e * stride
						for let k = 0; k < c; k++ {
							out[e * c + k] = gltfUint(buf, at + k * size, kind)
						}
					}
				}
			}
			try applySparseUints(acc, out)
			return out
		}

		// sparseParts reads a sparse accessor's indices and the start of its
		// values, checked against their views: the element indices, the
		// values' buffer and the offset of the first value in it.
		def sparseParts(acc GltfAccessor, sparse map<string, any>) !(int[], byte[], int) {
			let count = gltfInt(sparse, "count", 0)
			let indices = gltfObject(sparse, "indices")
			let values = gltfObject(sparse, "values")
			fail refuse("accessors[{acc.index}] has a sparse part without indices or values", "accessors[{acc.index}]") when indices is none || values is none
			let iv = gltfInt(indices, "bufferView", -1)
			let vv = gltfInt(values, "bufferView", -1)
			fail refuse("accessors[{acc.index}] sparse part names a bufferView the asset does not have", "accessors[{acc.index}]") when iv < 0 || iv >= views.len() || vv < 0 || vv >= views.len()
			let kind = gltfInt(indices, "componentType", gltfCompUnsignedInt)
			let isize = gltfComponentSize(kind)
			fail refuse("accessors[{acc.index}] sparse indices have component type {kind}", "accessors[{acc.index}]") when isize == 0 || kind == gltfCompFloat || kind == gltfCompByte || kind == gltfCompShort
			let iview = views[iv]
			let ioffset = gltfInt(indices, "byteOffset", 0)
			fail refuse("accessors[{acc.index}] sparse indices reach past their bufferView", "accessors[{acc.index}]") when ioffset < 0 || ioffset + count * isize > iview.length
			let vview = views[vv]
			let voffset = gltfInt(values, "byteOffset", 0)
			fail refuse("accessors[{acc.index}] sparse values reach past their bufferView", "accessors[{acc.index}]") when voffset < 0 || voffset + count * acc.components * acc.componentSize > vview.length
			let ibuf = buffers[iview.buffer]
			let out int[]
			out.len(count)
			for let j = 0; j < count; j++ {
				let idx = int(gltfUint(ibuf, iview.offset + ioffset + j * isize, kind))
				fail refuse("accessors[{acc.index}] sparse index {idx} is past its {acc.count} elements", "accessors[{acc.index}]") when idx < 0 || idx >= acc.count
				out[j] = idx
			}
			return (out, buffers[vview.buffer], vview.offset + voffset)
		}

		def applySparseFloats(acc GltfAccessor, out float32[]) !none {
			let sparse = acc.sparse
			return none when sparse is none
			let (indices, vbuf, vbase) = try sparseParts(acc, sparse)
			let c = acc.components
			for let (j, idx) in indices {
				for let k = 0; k < c; k++ {
					out[idx * c + k] = gltfComponent(vbuf, vbase + (j * c + k) * acc.componentSize, acc.componentType, acc.normalized)
				}
			}
			return none
		}

		def applySparseUints(acc GltfAccessor, out uint32[]) !none {
			let sparse = acc.sparse
			return none when sparse is none
			let (indices, vbuf, vbase) = try sparseParts(acc, sparse)
			let c = acc.components
			for let (j, idx) in indices {
				for let k = 0; k < c; k++ {
					out[idx * c + k] = gltfUint(vbuf, vbase + (j * c + k) * acc.componentSize, acc.componentType)
				}
			}
			return none
		}

		// readMatrices reads a MAT4 accessor as column-major matrices.
		def readMatrices(i int) !matrix<float, 4, 4>[] {
			let f = try readFloats(i)
			let out matrix<float, 4, 4>[]
			for let k = 0; k + 16 <= f.len(); k += 16 {
				let m = matrix<float, 4, 4>[]
				for let col = 0; col < 4; col++ {
					for let row = 0; row < 4; row++ {
						m[row][col] = float(f[k + col * 4 + row])
					}
				}
				out.push(m)
			}
			return out
		}

		// --- images, textures and materials ---

		def readImages() !none {
			for let (i, v) in gltfArray(doc, "images") {
				fail refuse("images[{i}] is not an object") unless v is map<string, any>
				let uri = gltfString(v, "uri", "")
				let mime = gltfString(v, "mimeType", "")
				let name = ""
				let data byte[]
				if uri.startsWith("data:") {
					let (bytes, kind) = try gltfDataUri(uri, "images[{i}]", format)
					data = bytes
					mime = kind when mime.len() == 0
					name = imageName(v, i, mime)
				} else if uri.len() > 0 {
					name = unescape(uri) onerror recover uri
					let res = resources
					if !(res is none) {
						let r = gltfOpen(res, name)
						if !(r is none) {
							data = io.readAll(r) onerror recover byte[]
							gltfClose(r)
						}
					}
				} else {
					let vi = gltfInt(v, "bufferView", -1)
					fail refuse("images[{i}] has neither a uri nor a bufferView", "images[{i}]") when vi < 0
					fail refuse("images[{i}] names bufferView {vi}, the asset has {views.len()}", "images[{i}]") when vi >= views.len()
					let bv = views[vi]
					data = buffers[bv.buffer][bv.offset:bv.offset + bv.length].clone()
					name = imageName(v, i, mime)
				}
				mime = formats.detectContentType(data) when mime.len() == 0 && data.len() > 0
				imageNames.push(name)
				imageMimes.push(mime)
				model.resources.set(name, data) when data.len() > 0 && !model.resources.hasKey(name)
			}
			return none
		}

		// imageName names an embedded image: its own name with the type's
		// extension, else image<n>.
		def imageName(v map<string, any>, i int, mime string) string {
			let ext = gltfExtension(mime)
			let own = gltfString(v, "name", "").replace("/", "_").replace("\\", "_")
			let base = own.len() > 0 ?? (own, "image{i}")
			base += ext unless ext.len() == 0 || base.lower().endsWith(ext)
			base = "image{i}" + ext when model.resources.hasKey(base)
			return base
		}

		def readTextures() !none {
			let samplers = gltfArray(doc, "samplers")
			for let (i, v) in gltfArray(doc, "textures") {
				fail refuse("textures[{i}] is not an object") unless v is map<string, any>
				let source = gltfInt(v, "source", -1)
				if source < 0 {
					// An extension's image (KHR_texture_basisu, EXT_texture_webp)
					// stands in when there is no core one.
					let exts = gltfObject(v, "extensions")
					if !(exts is none) {
						for let key in exts.keys() {
							let e = gltfObject(exts, key)
							continue when e is none
							source = gltfInt(e, "source", -1)
							break when source >= 0
						}
					}
				}
				fail refuse("textures[{i}] names image {source}, the asset has {imageNames.len()}", "textures[{i}]") when source >= imageNames.len()
				let t = new Texture(source >= 0 ?? (imageNames[source], ""))
				t.name = gltfString(v, "name", "")
				t.mimeType = imageMimes[source] when source >= 0
				let sampler = gltfInt(v, "sampler", -1)
				if sampler >= 0 && sampler < samplers.len() {
					let s = samplers[sampler]
					applySampler(t, s) when s is map<string, any>
				}
				textures.push(t)
				model.textures.push(t)
			}
			return none
		}

		def applySampler(t Texture, s map<string, any>) {
			t.wrapS = gltfWrap(gltfInt(s, "wrapS", 10497))
			t.wrapT = gltfWrap(gltfInt(s, "wrapT", 10497))
			t.magFilter = gltfFilter(gltfInt(s, "magFilter", 9729), Filter.Linear)
			t.minFilter = gltfFilter(gltfInt(s, "minFilter", 9987), Filter.LinearMipmapLinear)
		}

		def readMaterials() !none {
			for let (i, v) in gltfArray(doc, "materials") {
				fail refuse("materials[{i}] is not an object") unless v is map<string, any>
				let m = new Material(gltfString(v, "name", ""))
				let pbr = gltfObject(v, "pbrMetallicRoughness")
				if !(pbr is none) {
					let base = gltfFloats(pbr, "baseColorFactor")
					m.baseColor = gltfColor(base, true) when base.len() >= 3
					m.metallic = gltfFloat(pbr, "metallicFactor", 1.0)
					m.roughness = gltfFloat(pbr, "roughnessFactor", 1.0)
					m.baseColorTexture = try textureRef(pbr, "baseColorTexture", m, "")
					m.metallicRoughnessTexture = try textureRef(pbr, "metallicRoughnessTexture", m, "")
				}
				m.normalTexture = try textureRef(v, "normalTexture", m, "scale")
				m.occlusionTexture = try textureRef(v, "occlusionTexture", m, "strength")
				let emissive = gltfFloats(v, "emissiveFactor")
				m.emissive = gltfColorOf(emissive[0], emissive[1], emissive[2], 1.0) when emissive.len() >= 3
				let exts = gltfObject(v, "extensions")
				if !(exts is none) {
					m.unlit = exts.hasKey("KHR_materials_unlit")
					let es = gltfObject(exts, "KHR_materials_emissive_strength")
					m.emissiveStrength = gltfFloat(es, "emissiveStrength", 1.0) unless es is none
					for let key in exts.keys() {
						continue when key := "KHR_materials_unlit" || "KHR_materials_emissive_strength"
						let e = exts.get(key)
						m.metadata.set("extensions." + key, gltfText(e)) unless e is none
					}
				}
				readExtras(gltfObject(v, "extras"), m.metadata)
				m.emissiveTexture = try textureRef(v, "emissiveTexture", m, "")
				match gltfString(v, "alphaMode", "OPAQUE") {
					case "MASK":
						m.alphaMode = AlphaMode.Mask
					case "BLEND":
						m.alphaMode = AlphaMode.Blend
					default:
						m.alphaMode = AlphaMode.Opaque
				}
				m.alphaCutoff = gltfFloat(v, "alphaCutoff", 0.5)
				m.doubleSided = gltfBool(v, "doubleSided", false)
				materials.push(m)
				model.materials.push(m)
			}
			return none
		}

		// textureRef reads a textureInfo member of the material: the texture,
		// its coordinate set, the strength under `strengthKey` (empty for
		// none) and a KHR_texture_transform. Fails when the texture index is
		// out of range.
		def textureRef(v map<string, any>, key string, m Material, strengthKey string) !?TextureRef {
			let info = gltfObject(v, key)
			return none when info is none
			let index = gltfInt(info, "index", -1)
			fail refuse("material \"{m.name}\" {key} names texture {index}, the asset has {textures.len()}", key) when index < 0 || index >= textures.len()
			let strength = strengthKey.len() > 0 ?? (gltfFloat(info, strengthKey, 1.0), 1.0)
			let ref = TextureRef{texture: textures[index], uv: gltfInt(info, "texCoord", 0), strength: strength}
			let exts = gltfObject(info, "extensions")
			if !(exts is none) {
				let tt = gltfObject(exts, "KHR_texture_transform")
				if !(tt is none) {
					let offset = gltfFloats(tt, "offset")
					let scale = gltfFloats(tt, "scale")
					let t = TextureTransform{offsetU: offset.len() > 1 ?? (offset[0], 0.0), offsetV: offset.len() > 1 ?? (offset[1], 0.0), rotation: gltfFloat(tt, "rotation", 0.0), scaleU: scale.len() > 1 ?? (scale[0], 1.0), scaleV: scale.len() > 1 ?? (scale[1], 1.0)}
					let identity = t.offsetU == 0 && t.offsetV == 0 && t.rotation == 0 && t.scaleU == 1 && t.scaleV == 1
					ref.transform = t unless identity
					let tc = tt.get("texCoord")
					ref.uv = tc when tc is int
				}
			}
			return ref
		}

		// --- meshes ---

		def readMeshes() !none {
			for let (i, v) in gltfArray(doc, "meshes") {
				fail refuse("meshes[{i}] is not an object") unless v is map<string, any>
				let mesh = new Mesh(gltfString(v, "name", ""))
				let names string[]
				let extras = gltfObject(v, "extras")
				if !(extras is none) {
					for let n in gltfArray(extras, "targetNames") {
						names.push(n) when n is string
					}
				}
				for let (p, pv) in gltfArray(v, "primitives") {
					fail refuse("meshes[{i}].primitives[{p}] is not an object") unless pv is map<string, any>
					mesh.add(try readPrimitive(pv, i, p, names))
				}
				meshes.push(mesh)
				meshWeights.push(gltfFloats(v, "weights"))
				model.meshes.push(mesh)
			}
			return none
		}

		def readPrimitive(v map<string, any>, meshIndex int, p int, targetNames string[]) !Primitive {
			let site = "meshes[{meshIndex}].primitives[{p}]"
			let prim = new Primitive(gltfTopology(gltfInt(v, "mode", 4)))
			let attributes = gltfObject(v, "attributes")
			fail refuse("{site} has no attributes", site) when attributes is none
			let count = -1
			for let key in attributes.keys() {
				let index = gltfInt(attributes, key, -1)
				fail refuse("{site} attribute {key} is not an accessor index", site) when index < 0
				let acc = try accessor(index)
				fail refuse("{site} attribute {key} has {acc.count} elements, POSITION {count}", site) when count >= 0 && acc.count != count
				count = acc.count when count < 0
				if key == "POSITION" {
					fail refuse("{site} POSITION is not VEC3", site) when acc.components != 3
					prim.positions = try readFloats(index)
				} else if key == "NORMAL" {
					fail refuse("{site} NORMAL is not VEC3", site) when acc.components != 3
					prim.normals = try readFloats(index)
				} else if key == "TANGENT" {
					fail refuse("{site} TANGENT is not VEC4", site) when acc.components != 4
					prim.tangents = try readFloats(index)
				} else if key.startsWith("TEXCOORD_") {
					fail refuse("{site} {key} is not VEC2", site) when acc.components != 2
					let set = gltfSetIndex(key[9:])
					fail refuse("{site} has attribute {key}", site) when set < 0
					for prim.uvs.len() <= set {
						prim.uvs.push(float32[])
					}
					prim.uvs[set] = try readFloats(index)
				} else if key.startsWith("COLOR_") {
					fail refuse("{site} {key} is not VEC3 or VEC4", site) when acc.components != 3 && acc.components != 4
					let set = gltfSetIndex(key[6:])
					fail refuse("{site} has attribute {key}", site) when set < 0
					for prim.colors.len() <= set {
						prim.colors.push(float32[])
					}
					let values = try readFloats(index)
					values = gltfWithAlpha(values) when acc.components == 3
					prim.colors[set] = values
				} else if key == "JOINTS_0" {
					fail refuse("{site} JOINTS_0 is not VEC4", site) when acc.components != 4
					let joints = try readUints(index)
					prim.joints.len(joints.len())
					for let k = 0; k < joints.len(); k++ {
						prim.joints[k] = uint16(joints[k])
					}
				} else if key == "WEIGHTS_0" {
					fail refuse("{site} WEIGHTS_0 is not VEC4", site) when acc.components != 4
					prim.weights = try readFloats(index)
				}
			}
			fail refuse("{site} has no POSITION", site) when prim.positions.len() == 0 && count != 0
			let indices = gltfInt(v, "indices", -1)
			if indices >= 0 {
				let acc = try accessor(indices)
				fail refuse("{site} indices are not SCALAR", site) when acc.components != 1
				prim.indices = try readUints(indices)
				for let (k, idx) in prim.indices {
					fail refuse("{site} index {idx} is past its {count} vertices", site) when int(idx) >= count
				}
			}
			let material = gltfInt(v, "material", -1)
			if material >= 0 {
				fail refuse("{site} names material {material}, the asset has {materials.len()}", site) when material >= materials.len()
				prim.material = materials[material]
			}
			for let (t, tv) in gltfArray(v, "targets") {
				fail refuse("{site}.targets[{t}] is not an object", site) unless tv is map<string, any>
				let target = new MorphTarget(t < targetNames.len() ?? (targetNames[t], ""))
				for let key in tv.keys() {
					let index = gltfInt(tv, key, -1)
					continue when index < 0
					let acc = try accessor(index)
					fail refuse("{site}.targets[{t}] {key} has {acc.count} elements, the primitive {count}", site) when acc.count != count
					fail refuse("{site}.targets[{t}] {key} is not VEC3", site) when acc.components != 3
					if key == "POSITION" {
						target.positions = try readFloats(index)
					} else if key == "NORMAL" {
						target.normals = try readFloats(index)
					} else if key == "TANGENT" {
						target.tangents = try readFloats(index)
					}
				}
				prim.targets.push(target)
			}
			return prim
		}

		// --- cameras, lights, nodes, skins, animations ---

		def readCameras() !none {
			for let (i, v) in gltfArray(doc, "cameras") {
				fail refuse("cameras[{i}] is not an object") unless v is map<string, any>
				let kind = gltfString(v, "type", "perspective")
				let cam = new Camera(gltfString(v, "name", ""), kind == "orthographic" ?? (CameraKind.Orthographic, CameraKind.Perspective))
				let p = gltfObject(v, "perspective")
				if !(p is none) {
					cam.yfov = gltfFloat(p, "yfov", 0.8)
					cam.aspect = gltfFloat(p, "aspectRatio", 0.0)
					cam.znear = gltfFloat(p, "znear", 0.1)
					cam.zfar = gltfFloat(p, "zfar", 0.0)
				}
				let o = gltfObject(v, "orthographic")
				if !(o is none) {
					cam.xmag = gltfFloat(o, "xmag", 1.0)
					cam.ymag = gltfFloat(o, "ymag", 1.0)
					cam.znear = gltfFloat(o, "znear", 0.1)
					cam.zfar = gltfFloat(o, "zfar", 1000.0)
				}
				cameras.push(cam)
				model.cameras.push(cam)
			}
			return none
		}

		def readLights() !none {
			let exts = gltfObject(doc, "extensions")
			return none when exts is none
			let punctual = gltfObject(exts, "KHR_lights_punctual")
			return none when punctual is none
			for let (i, v) in gltfArray(punctual, "lights") {
				fail refuse("KHR_lights_punctual.lights[{i}] is not an object") unless v is map<string, any>
				let light = new Light(gltfString(v, "name", ""))
				match gltfString(v, "type", "point") {
					case "directional":
						light.kind = LightKind.Directional
					case "spot":
						light.kind = LightKind.Spot
					default:
						light.kind = LightKind.Point
				}
				let rgb = gltfFloats(v, "color")
				light.color = gltfColor(rgb, false) when rgb.len() >= 3
				light.intensity = gltfFloat(v, "intensity", 1.0)
				light.range = gltfFloat(v, "range", 0.0)
				let spot = gltfObject(v, "spot")
				if !(spot is none) {
					light.innerCone = gltfFloat(spot, "innerConeAngle", 0.0)
					light.outerCone = gltfFloat(spot, "outerConeAngle", 0.7853981633974483)
				}
				lights.push(light)
				model.lights.push(light)
			}
			return none
		}

		def readNodes() !none {
			let items = gltfArray(doc, "nodes")
			for let (i, v) in items {
				fail refuse("nodes[{i}] is not an object") unless v is map<string, any>
				nodes.push(new Node(gltfString(v, "name", "")))
			}
			for let (i, v) in items {
				continue unless v is map<string, any>
				let n = nodes[i]
				let m = gltfFloats(v, "matrix")
				if m.len() == 16 {
					let t = matrix<float, 4, 4>[]
					for let col = 0; col < 4; col++ {
						for let row = 0; row < 4; row++ {
							t[row][col] = m[col * 4 + row]
						}
					}
					n.transform = t
				} else {
					let tr = gltfFloats(v, "translation")
					n.translation = new Vec3(tr[0], tr[1], tr[2]) when tr.len() == 3
					let r = gltfFloats(v, "rotation")
					n.rotation = new Quaternion(r[0], r[1], r[2], r[3]) when r.len() == 4
					let s = gltfFloats(v, "scale")
					n.scale = new Vec3(s[0], s[1], s[2]) when s.len() == 3
				}
				for let c in gltfArray(v, "children") {
					let child = gltfNumber(c)
					fail refuse("nodes[{i}] has a child that is not a node index", "nodes[{i}]") when child is none
					let ci = int(child)
					fail refuse("nodes[{i}] names child {ci}, the asset has {nodes.len()} nodes", "nodes[{i}]") when ci < 0 || ci >= nodes.len()
					fail refuse("nodes[{i}] is its own child", "nodes[{i}]") when ci == i
					fail refuse("node {ci} has two parents", "nodes[{ci}]") unless nodes[ci].parent is none
					n.add(nodes[ci])
				}
				let mesh = gltfInt(v, "mesh", -1)
				if mesh >= 0 {
					fail refuse("nodes[{i}] names mesh {mesh}, the asset has {meshes.len()}", "nodes[{i}]") when mesh >= meshes.len()
					n.mesh = meshes[mesh]
					let weights = gltfFloats(v, "weights")
					weights = meshWeights[mesh] when weights.len() == 0
					n.weights = weights
				}
				let camera = gltfInt(v, "camera", -1)
				if camera >= 0 {
					fail refuse("nodes[{i}] names camera {camera}, the asset has {cameras.len()}", "nodes[{i}]") when camera >= cameras.len()
					n.camera = cameras[camera]
				}
				let exts = gltfObject(v, "extensions")
				if !(exts is none) {
					for let key in exts.keys() {
						let e = exts.get(key)
						if key == "KHR_lights_punctual" && e is map<string, any> {
							let light = gltfInt(e, "light", -1)
							fail refuse("nodes[{i}] names light {light}, the asset has {lights.len()}", "nodes[{i}]") when light < 0 || light >= lights.len()
							n.light = lights[light]
						} else {
							n.metadata.set("extensions." + key, gltfText(e)) unless e is none
						}
					}
				}
				readExtras(gltfObject(v, "extras"), n.metadata)
			}
			// A node under another is not a root even when no scene lists it.
			for let (i, n) in nodes {
				fail refuse("the node tree has a cycle through nodes[{i}]", "nodes[{i}]") when gltfHasCycle(n)
			}
			return none
		}

		// readExtras copies an extras object into metadata: strings as they
		// are, other values as JSON text.
		def readExtras(extras ?map<string, any>, into map<string, string>) {
			return when extras is none
			for let key in extras.keys() {
				let e = extras.get(key)
				into.set(key, gltfText(e)) unless e is none
			}
		}

		def readSkins() !none {
			for let (i, v) in gltfArray(doc, "skins") {
				fail refuse("skins[{i}] is not an object") unless v is map<string, any>
				let skin = new Skin(gltfString(v, "name", ""))
				for let j in gltfArray(v, "joints") {
					let n = gltfNumber(j)
					fail refuse("skins[{i}] has a joint that is not a node index", "skins[{i}]") when n is none
					let ji = int(n)
					fail refuse("skins[{i}] names joint {ji}, the asset has {nodes.len()} nodes", "skins[{i}]") when ji < 0 || ji >= nodes.len()
					skin.joints.push(nodes[ji])
				}
				let ibm = gltfInt(v, "inverseBindMatrices", -1)
				if ibm >= 0 {
					let acc = try accessor(ibm)
					fail refuse("skins[{i}] inverseBindMatrices is not MAT4", "skins[{i}]") when acc.components != 16
					skin.inverseBindMatrices = try readMatrices(ibm)
					fail refuse("skins[{i}] has {skin.inverseBindMatrices.len()} inverse bind matrices for {skin.joints.len()} joints", "skins[{i}]") when skin.inverseBindMatrices.len() < skin.joints.len()
				}
				let skeleton = gltfInt(v, "skeleton", -1)
				if skeleton >= 0 {
					fail refuse("skins[{i}] names skeleton {skeleton}, the asset has {nodes.len()} nodes", "skins[{i}]") when skeleton >= nodes.len()
					skin.skeleton = nodes[skeleton]
				}
				skins.push(skin)
				model.skins.push(skin)
			}
			for let (i, v) in gltfArray(doc, "nodes") {
				continue unless v is map<string, any>
				let skin = gltfInt(v, "skin", -1)
				continue when skin < 0
				fail refuse("nodes[{i}] names skin {skin}, the asset has {skins.len()}", "nodes[{i}]") when skin >= skins.len()
				nodes[i].skin = skins[skin]
			}
			return none
		}

		def readAnimations() !none {
			for let (i, v) in gltfArray(doc, "animations") {
				fail refuse("animations[{i}] is not an object") unless v is map<string, any>
				let anim = new Animation(gltfString(v, "name", ""))
				let samplers = gltfArray(v, "samplers")
				for let (c, cv) in gltfArray(v, "channels") {
					let site = "animations[{i}].channels[{c}]"
					fail refuse("{site} is not an object", site) unless cv is map<string, any>
					let target = gltfObject(cv, "target")
					fail refuse("{site} has no target", site) when target is none
					let node = gltfInt(target, "node", -1)
					// A channel with no node is for an extension; nothing here to animate.
					continue when node < 0
					fail refuse("{site} names node {node}, the asset has {nodes.len()}", site) when node >= nodes.len()
					let path AnimationPath
					match gltfString(target, "path", "") {
						case "translation":
							path = AnimationPath.Translation
						case "rotation":
							path = AnimationPath.Rotation
						case "scale":
							path = AnimationPath.Scale
						case "weights":
							path = AnimationPath.Weights
						default:
							fail refuse("{site} animates \"{gltfString(target, "path", "")}\", which glTF does not define", site)
					}
					let s = gltfInt(cv, "sampler", -1)
					fail refuse("{site} names sampler {s}, the animation has {samplers.len()}", site) when s < 0 || s >= samplers.len()
					let sv = samplers[s]
					fail refuse("{site} sampler is not an object", site) unless sv is map<string, any>
					let channel = new Channel(nodes[node], path)
					match gltfString(sv, "interpolation", "LINEAR") {
						case "STEP":
							channel.interpolation = Interpolation.Step
						case "CUBICSPLINE":
							channel.interpolation = Interpolation.CubicSpline
						default:
							channel.interpolation = Interpolation.Linear
					}
					let input = gltfInt(sv, "input", -1)
					let output = gltfInt(sv, "output", -1)
					fail refuse("{site} sampler has no input or output", site) when input < 0 || output < 0
					channel.times = try readFloats(input)
					channel.values = try readFloats(output)
					anim.channels.push(channel)
				}
				model.animations.push(anim)
			}
			return none
		}

		// readScene places the default scene's root nodes (every parentless
		// node when the asset has no scenes).
		def readScene() !none {
			let scenes = gltfArray(doc, "scenes")
			if scenes.len() == 0 {
				for let (_, n) in nodes {
					model.nodes.push(n) when n.parent is none
				}
				return none
			}
			let index = gltfInt(doc, "scene", 0)
			fail refuse("the default scene is {index}, the asset has {scenes.len()} scenes", "scene") when index < 0 || index >= scenes.len()
			let scene = scenes[index]
			fail refuse("scenes[{index}] is not an object", "scenes[{index}]") unless scene is map<string, any>
			model.name = gltfString(scene, "name", "")
			for let r in gltfArray(scene, "nodes") {
				let n = gltfNumber(r)
				fail refuse("scenes[{index}] lists a root that is not a node index", "scenes[{index}]") when n is none
				let ri = int(n)
				fail refuse("scenes[{index}] names node {ri}, the asset has {nodes.len()}", "scenes[{index}]") when ri < 0 || ri >= nodes.len()
				fail refuse("scenes[{index}] lists node {ri}, which has a parent", "scenes[{index}]") unless nodes[ri].parent is none
				model.nodes.push(nodes[ri])
			}
			model.metadata.set("scenes", "{scenes.len()}") when scenes.len() > 1
			return none
		}

		// readMetadata copies the asset fields, the root extras and the
		// extensions this reader does not model into the model's metadata.
		def readMetadata() {
			let asset = gltfObject(doc, "asset")
			if !(asset is none) {
				for let key in string["generator", "copyright", "version", "minVersion"] {
					let v = gltfString(asset, key, "")
					model.metadata.set(key, v) when v.len() > 0
				}
			}
			let extras = gltfObject(doc, "extras")
			if !(extras is none) {
				for let key in extras.keys() {
					let e = extras.get(key)
					model.metadata.set("extras." + key, gltfText(e)) unless e is none
				}
			}
			let exts = gltfObject(doc, "extensions")
			if !(exts is none) {
				for let key in exts.keys() {
					continue when key == "KHR_lights_punctual"
					let e = exts.get(key)
					model.metadata.set("extensions." + key, gltfText(e)) unless e is none
				}
			}
		}
	}

	// gltfHasCycle reports whether following parents from the node comes
	// back to it.
	def gltfHasCycle(node Node) bool {
		let cur = node
		for let steps = 0; steps <= 1000000; steps++ {
			let p = cur.parent
			return false when p is none
			return true when p == node
			cur = p
		}
		return true
	}

	// gltfComponentSize is the bytes of one component, 0 for an unknown type.
	def gltfComponentSize(componentType int) int {
		switch componentType {
			case gltfCompByte, gltfCompUnsignedByte:
				return 1
			case gltfCompShort, gltfCompUnsignedShort:
				return 2
			case gltfCompUnsignedInt, gltfCompFloat:
				return 4
			default:
				return 0
		}
	}

	// gltfComponentCount is the components of an accessor type, 0 for an
	// unknown one.
	def gltfComponentCount(kind string) int {
		switch kind {
			case "SCALAR":
				return 1
			case "VEC2":
				return 2
			case "VEC3":
				return 3
			case "VEC4", "MAT2":
				return 4
			case "MAT3":
				return 9
			case "MAT4":
				return 16
			default:
				return 0
		}
	}

	// gltfComponent reads one component as a float32, integers converted
	// (normalized to -1..1 or 0..1).
	def gltfComponent(buf byte[], at int, componentType int, normalized bool) float32 {
		switch componentType {
			case gltfCompFloat:
				return __bitcast_f32_from_u32(gltfLE32(buf, at))
			case gltfCompUnsignedByte:
				let v = int(buf[at])
				return float32(float(v) / 255.0) when normalized
				return float32(v)
			case gltfCompByte:
				let v = int(buf[at])
				v -= 256 when v > 127
				return float32((float(v) / 127.0).max(-1.0)) when normalized
				return float32(v)
			case gltfCompUnsignedShort:
				let v = int(buf[at]) | (int(buf[at + 1]) << 8)
				return float32(float(v) / 65535.0) when normalized
				return float32(v)
			case gltfCompShort:
				let v = int(buf[at]) | (int(buf[at + 1]) << 8)
				v -= 65536 when v > 32767
				return float32((float(v) / 32767.0).max(-1.0)) when normalized
				return float32(v)
			default:
				return float32(gltfLE32(buf, at))
		}
	}

	// gltfUint reads one integer component as a uint32; a signed type reads
	// as its two's complement bits.
	def gltfUint(buf byte[], at int, componentType int) uint32 {
		switch componentType {
			case gltfCompUnsignedByte, gltfCompByte:
				return uint32(buf[at])
			case gltfCompUnsignedShort, gltfCompShort:
				return uint32(buf[at]) | (uint32(buf[at + 1]) << 8)
			default:
				return gltfLE32(buf, at)
		}
	}

	// gltfWithAlpha widens RGB triples to RGBA with alpha 1.
	def gltfWithAlpha(rgb float32[]) float32[] {
		let n = rgb.len() / 3
		let out float32[]
		out.len(n * 4)
		for let i = 0; i < n; i++ {
			out[i * 4] = rgb[i * 3]
			out[i * 4 + 1] = rgb[i * 3 + 1]
			out[i * 4 + 2] = rgb[i * 3 + 2]
			out[i * 4 + 3] = 1.0
		}
		return out
	}

	// gltfColor is a colour from three or four 0..1 factors.
	def gltfColor(f float[], withAlpha bool) color.Color {
		let a = withAlpha && f.len() >= 4 ?? (f[3], 1.0)
		return gltfColorOf(f[0], f[1], f[2], a)
	}

	// gltfColorOf is the colour of 0..1 factors, rounded to the 8 bits a
	// Color holds; values outside are clamped.
	def gltfColorOf(r float, g float, b float, a float) color.Color {
		return new color.Color(color.RGBA{r: gltfChannel(r), g: gltfChannel(g), b: gltfChannel(b), a: gltfChannel(a)})
	}

	def gltfChannel(v float) uint8 {
		return uint8((v.clamp(0.0, 1.0) * 255.0).round())
	}

	// gltfSetIndex is the number after an attribute's underscore (TEXCOORD_1),
	// -1 when it is not plain digits.
	def gltfSetIndex(suffix string) int {
		return -1 when suffix.len() == 0 || suffix.len() > 3
		for let c in suffix.bytes() {
			return -1 when c < 0x30 || c > 0x39
		}
		return parseInt<int>(suffix)
	}

	def gltfTopology(mode int) Topology {
		switch mode {
			case 0:
				return Topology.Points
			case 1:
				return Topology.Lines
			case 2:
				return Topology.LineLoop
			case 3:
				return Topology.LineStrip
			case 5:
				return Topology.TriangleStrip
			case 6:
				return Topology.TriangleFan
			default:
				return Topology.Triangles
		}
	}

	def gltfWrap(code int) Wrap {
		switch code {
			case 33071:
				return Wrap.Clamp
			case 33648:
				return Wrap.Mirror
			default:
				return Wrap.Repeat
		}
	}

	def gltfFilter(code int, fallback Filter) Filter {
		switch code {
			case 9728:
				return Filter.Nearest
			case 9729:
				return Filter.Linear
			case 9984:
				return Filter.NearestMipmapNearest
			case 9985:
				return Filter.LinearMipmapNearest
			case 9986:
				return Filter.NearestMipmapLinear
			case 9987:
				return Filter.LinearMipmapLinear
			default:
				return fallback
		}
	}
}
