internal partial module std.formats.models.gltf {
	use (
		std.bytes
		std.data.encoding::(Base64, JSON)
		std.formats
		std.formats.models::*
		std.gfx.bands
		std.gfx.color
		std.io
		std.net.url::(escape)
		std.simd
	)

	// Buffer view targets.
	const gltfTargetArray = 34962
	const gltfTargetElementArray = 34963

	// gltfEncode writes the model as glTF JSON. With resources and `embed`
	// off, the one buffer goes to `<model name>.bin` and the images to files
	// of their names beside the model; otherwise both are data URIs in the
	// JSON.
	def gltfEncode(model Model, writer io.Writer, resources ?ResourceWriter, embed bool) !none {
		let w = new GltfWriter(model, false)
		let res = resources
		if res is none || embed {
			w.imagesAsDataUris()
			let doc = w.document()
			let uri = "data:application/octet-stream;base64," + new Base64().encode(w.binary.data)
			w.setBuffer(doc, uri)
			try w.emit(doc, writer)
			return none
		}
		let files = w.imagesAsFiles()
		let doc = w.document()
		let name = gltfBufferName(model)
		w.setBuffer(doc, escape(name, "/"))
		try w.emit(doc, writer)
		if w.binary.data.len() > 0 {
			let bw = try res.create(name)
			try bw.write(w.binary.data)
			try gltfCloseWriter(bw)
		}
		for let (_, f) in files {
			let (file, data) = f
			let fw = try res.create(file)
			try fw.write(data)
			try gltfCloseWriter(fw)
		}
		return none
	}

	// glbEncode writes the model as one GLB: the JSON chunk and a binary
	// chunk holding the buffer, images included.
	def glbEncode(model Model, writer io.Writer) !none {
		let w = new GltfWriter(model, true)
		w.imagesInBinary()
		let doc = w.document()
		w.setBuffer(doc, "")
		let json = new bytes.Buffer()
		try w.emit(doc, json)
		let text = json.bytes()
		let jsonLength = (text.len() + 3) / 4 * 4
		let bin = w.binary.data
		let binLength = (bin.len() + 3) / 4 * 4
		let total = 12 + 8 + jsonLength + (bin.len() > 0 ?? (8 + binLength, 0))
		// The header and the JSON chunk (padded with spaces) go out as one
		// write, the binary chunk as itself plus its zero padding, so the
		// buffer is never copied into a whole-file array.
		let head byte[]
		head.len(20 + jsonLength)
		head[0] = 0x67
		head[1] = 0x6C
		head[2] = 0x54
		head[3] = 0x46
		gltfPutLE32(head, 4, 2)
		gltfPutLE32(head, 8, uint32(total))
		gltfPutLE32(head, 12, uint32(jsonLength))
		gltfPutLE32(head, 16, glbChunkJson)
		text.copy(head[20:20 + text.len()])
		for let k = text.len(); k < jsonLength; k++ {
			head[20 + k] = 0x20
		}
		try writer.write(head)
		if bin.len() > 0 {
			let chunk byte[]
			chunk.len(8)
			gltfPutLE32(chunk, 0, uint32(binLength))
			gltfPutLE32(chunk, 4, glbChunkBin)
			try writer.write(chunk)
			try writer.write(bin)
			if binLength > bin.len() {
				let pad byte[]
				pad.len(binLength - bin.len())
				try writer.write(pad)
			}
		}
		return none
	}

	def gltfCloseWriter(w io.Writer) !none {
		if w is io.Closer {
			try w.close()
		}
		return none
	}

	// gltfBufferName is the file the buffer goes to beside a `.gltf`: the
	// model's name, else `buffer`.
	def gltfBufferName(model Model) string {
		let name = gltfFileName(model.name)
		name = "buffer" when name.len() == 0
		return name + ".bin"
	}

	// gltfFileName strips what a file name cannot hold from a name.
	def gltfFileName(name string) string {
		let out = ""
		for let c in name {
			let s = "{c}"
			out += s unless s := "/" || "\\" || ":" || "*" || "?" || "\"" || "<" || ">" || "|" || "\n" || "\r" || "\t"
		}
		return out.trim()
	}

	// GltfRaw is JSON text written as it is: an extension or extras value
	// the reader kept as text.
	type GltfRaw {
		text string

		def new(text string) {
			self.text = text
		}
	}

	// GltfBinary accumulates the one buffer every accessor and embedded
	// image points into, with its bufferViews and accessors.
	type GltfBinary {
		data      byte[]
		views     any[]
		accessors any[]

		def new() {
			data = byte[]
			views = any[]
			accessors = any[]
		}

		// reserve appends `size` zero bytes at a 4-byte boundary and returns
		// their offset.
		def reserve(size int) int {
			for data.len() % 4 != 0 {
				data.push(0)
			}
			let at = data.len()
			data.len(at + size)
			return at
		}

		// addView appends a bufferView over the bytes at `offset` and returns
		// its index.
		def addView(offset int, length int, target int, stride int) int {
			let v = new map<string, any>()
			v.set("buffer", 0)
			v.set("byteOffset", offset)
			v.set("byteLength", length)
			v.set("byteStride", stride) when stride > 0
			v.set("target", target) when target > 0
			views.push(v)
			return views.len() - 1
		}

		def addAccessor(viewIndex int, componentType int, count int, kind string, normalized bool) map<string, any> {
			let a = new map<string, any>()
			a.set("bufferView", viewIndex)
			a.set("componentType", componentType)
			a.set("normalized", true) when normalized
			a.set("count", count)
			a.set("type", kind)
			accessors.push(a)
			return a
		}

		// addFloats appends a float accessor of `components` values per
		// element, with min and max when asked, and returns its index.
		def addFloats(values float32[], components int, withBounds bool, target int) int {
			let count = values.len() / components
			let at = reserve(values.len() * 4)
			gltfPutFloats(data, at, values)
			let v = addView(at, values.len() * 4, target, 0)
			let a = addAccessor(v, gltfCompFloat, count, gltfTypeName(components), false)
			if withBounds && count > 0 {
				let (lo, hi) = gltfMinMax(values, components)
				a.set("min", lo)
				a.set("max", hi)
			}
			return accessors.len() - 1
		}

		// addIndices appends an index accessor, 16-bit when the vertices fit.
		def addIndices(indices uint32[], vertexCount int) int {
			let count = indices.len()
			if vertexCount <= 65535 {
				let at = reserve(count * 2)
				for let k = 0; k < count; k++ {
					let i = int(indices[k])
					data[at + k * 2] = byte(i & 0xFF)
					data[at + k * 2 + 1] = byte((i >> 8) & 0xFF)
				}
				let v = addView(at, count * 2, gltfTargetElementArray, 0)
				addAccessor(v, gltfCompUnsignedShort, count, "SCALAR", false)
			} else {
				let at = reserve(count * 4)
				gltfPutUints(data, at, indices)
				let v = addView(at, count * 4, gltfTargetElementArray, 0)
				addAccessor(v, gltfCompUnsignedInt, count, "SCALAR", false)
			}
			return accessors.len() - 1
		}

		// addJoints appends a VEC4 unsigned short accessor.
		def addJoints(joints uint16[]) int {
			let at = reserve(joints.len() * 2)
			for let k = 0; k < joints.len(); k++ {
				let j = int(joints[k])
				data[at + k * 2] = byte(j & 0xFF)
				data[at + k * 2 + 1] = byte((j >> 8) & 0xFF)
			}
			let v = addView(at, joints.len() * 2, gltfTargetArray, 0)
			addAccessor(v, gltfCompUnsignedShort, joints.len() / 4, "VEC4", false)
			return accessors.len() - 1
		}

		// addMatrices appends a MAT4 accessor, column-major.
		def addMatrices(ms matrix<float, 4, 4>[]) int {
			let values float32[]
			values.len(ms.len() * 16)
			for let (k, m) in ms {
				for let col = 0; col < 4; col++ {
					for let row = 0; row < 4; row++ {
						values[k * 16 + col * 4 + row] = float32(m[row][col])
					}
				}
			}
			return addFloats(values, 16, false, 0)
		}

		// addBytes appends raw bytes (an image) as a bufferView and returns
		// its index.
		def addBytes(bytes byte[]) int {
			let at = reserve(bytes.len())
			bytes.copy(data[at:at + bytes.len()])
			return addView(at, bytes.len(), 0, 0)
		}
	}

	// gltfPutFloats copies the values into the buffer at `at`, four a
	// vector, in bands.
	def gltfPutFloats(data byte[], at int, values float32[]) {
		let n = values.len()
		bands.forBands(n, n, (from int, to int) => {
			let i = from
			for i + 4 <= to {
				simd.storeBytes16(data, at + 4 * i, simd.load4<float32>(values, i).bitcast16<byte>())
				i += 4
			}
			for i < to {
				gltfPutLE32(data, at + 4 * i, __bitcast_u32_from_f32(values[i]))
				i++
			}
		})
	}

	def gltfPutUints(data byte[], at int, values uint32[]) {
		let n = values.len()
		bands.forBands(n, n, (from int, to int) => {
			let i = from
			for i + 4 <= to {
				simd.storeBytes16(data, at + 4 * i, simd.load4<uint32>(values, i).bitcast16<byte>())
				i += 4
			}
			for i < to {
				gltfPutLE32(data, at + 4 * i, values[i])
				i++
			}
		})
	}

	def gltfPutLE32(data byte[], at int, v uint32) {
		data[at] = byte(v & 0xFF)
		data[at + 1] = byte((v >> 8) & 0xFF)
		data[at + 2] = byte((v >> 16) & 0xFF)
		data[at + 3] = byte((v >> 24) & 0xFF)
	}

	// gltfMinMax is the least and greatest value per component over the
	// elements, as floats for the accessor's min and max.
	def gltfMinMax(values float32[], components int) (float[], float[]) {
		let lo float[]
		let hi float[]
		if components == 3 {
			// The SIMD box of a Primitive over the values.
			let p = new Primitive()
			p.positions = values
			let box = p.bounds()
			if !(box is none) {
				let (a, b) = box
				lo.push(a.x, a.y, a.z)
				hi.push(b.x, b.y, b.z)
				return (lo, hi)
			}
		}
		lo.len(components)
		hi.len(components)
		for let k = 0; k < components; k++ {
			lo[k] = float(values[k])
			hi[k] = float(values[k])
		}
		for let i = components; i + components <= values.len(); i += components {
			for let k = 0; k < components; k++ {
				let v = float(values[i + k])
				lo[k] = lo[k].min(v)
				hi[k] = hi[k].max(v)
			}
		}
		return (lo, hi)
	}

	def gltfTypeName(components int) string {
		switch components {
			case 1:
				return "SCALAR"
			case 2:
				return "VEC2"
			case 3:
				return "VEC3"
			case 4:
				return "VEC4"
			case 9:
				return "MAT3"
			default:
				return "MAT4"
		}
	}

	// GltfWriter builds the JSON document of a model: the lists in glTF's
	// order, every object a map in the order its members are written.
	type GltfWriter {
		model      Model
		glb        bool
		binary     GltfBinary
		nodes      Node[]
		// Per texture of the model, the image it shows (index into `images`),
		// -1 when it has none.
		imageOf    int[]
		images     any[]
		extensions string[]
		required   string[]

		def new(model Model, glb bool) {
			self.model = model
			self.glb = glb
			binary = new GltfBinary()
			nodes = Node[]
			imageOf = int[]
			images = any[]
			extensions = string[]
			required = string[]
		}

		def useExtension(name string, mustHave bool = false) {
			extensions.push(name) when extensions.indexOf(name) < 0
			required.push(name) when mustHave && required.indexOf(name) < 0
		}

		// --- images: three placements ---

		// imageSources lists the model's textures' distinct image sources,
		// with each texture's position in it (-1 with no bytes), for the
		// three placements.
		def imageSources() (string[], int[]) {
			let sources string[]
			let of int[]
			for let (_, t) in model.textures {
				let data = model.resources.get(t.source)
				if data is none || t.source.len() == 0 {
					of.push(-1)
					continue
				}
				let at = sources.indexOf(t.source)
				if at < 0 {
					sources.push(t.source)
					at = sources.len() - 1
				}
				of.push(at)
			}
			return (sources, of)
		}

		def imageObject(source string) map<string, any> {
			let img = new map<string, any>()
			let name = gltfImageName(source)
			img.set("name", name) when name.len() > 0
			return img
		}

		// imageMime is the media type of a source's bytes.
		def imageMime(source string, data byte[]) string {
			for let (_, t) in model.textures {
				return t.mimeType when t.source == source && t.mimeType.len() > 0
			}
			return formats.detectContentType(data)
		}

		def imagesAsDataUris() {
			let (sources, of) = imageSources()
			imageOf = of
			for let (_, source) in sources {
				let data = model.resources.get(source)
				continue when data is none
				let img = imageObject(source)
				let mime = imageMime(source, data)
				img.set("uri", "data:{mime};base64," + new Base64().encode(data))
				img.set("mimeType", mime) when mime.len() > 0
				images.push(img)
			}
		}

		def imagesInBinary() {
			let (sources, of) = imageSources()
			imageOf = of
			for let (_, source) in sources {
				let data = model.resources.get(source)
				continue when data is none
				let img = imageObject(source)
				img.set("mimeType", imageMime(source, data))
				img.set("bufferView", binary.addBytes(data))
				images.push(img)
			}
		}

		// imagesAsFiles names a file per image, unique within the model, and
		// returns the files to write.
		def imagesAsFiles() (string, byte[])[] {
			let (sources, of) = imageSources()
			imageOf = of
			let files (string, byte[])[]
			let taken = new map<string, bool>()
			for let (_, source) in sources {
				let data = model.resources.get(source)
				continue when data is none
				let mime = imageMime(source, data)
				let file = gltfImageFile(source, mime)
				if taken.hasKey(file) {
					let dot = file.lastIndexOf(".")
					let stem = dot > 0 ?? (file[:dot], file)
					let ext = dot > 0 ?? (file[dot:], "")
					for let n = 2; taken.hasKey(file); n++ {
						file = "{stem}_{n}{ext}"
					}
				}
				taken.set(file, true)
				let img = imageObject(source)
				img.set("uri", escape(file, "/"))
				img.set("mimeType", mime) when mime.len() > 0
				images.push(img)
				files.push((file, data))
			}
			return files
		}

		// --- the document ---

		// collectNodes lists the nodes of the tree, then those skins and
		// animations reach outside it.
		def collectNodes() {
			for let (_, n) in model.nodes {
				collect(n)
			}
			for let (_, skin) in model.skins {
				for let (_, j) in skin.joints {
					collect(j)
				}
				let s = skin.skeleton
				collect(s) unless s is none
			}
			for let (_, anim) in model.animations {
				for let (_, ch) in anim.channels {
					collect(ch.target)
				}
			}
		}

		// collect adds the node and those below it to the node list.
		def collect(n Node) {
			return when gltfNodeIndex(nodes, n) >= 0
			nodes.push(n)
			for let (_, c) in n.children {
				collect(c)
			}
		}

		// document builds the JSON document, filling the binary buffer as it
		// goes; the buffer itself is set after, when its size is known.
		def document() map<string, any> {
			collectNodes()
			let doc = new map<string, any>()
			doc.set("asset", assetObject())
			let scenes any[]
			let scene = new map<string, any>()
			scene.set("name", model.name) when model.name.len() > 0
			let roots int[]
			for let (_, n) in model.nodes {
				roots.push(gltfNodeIndex(nodes, n))
			}
			scene.set("nodes", roots) when roots.len() > 0
			scenes.push(scene)
			doc.set("scene", 0)
			doc.set("scenes", scenes)
			let nodeList = nodesList()
			doc.set("nodes", nodeList) when nodeList.len() > 0
			let meshes = meshesList()
			doc.set("meshes", meshes) when meshes.len() > 0
			let materials = materialsList()
			doc.set("materials", materials) when materials.len() > 0
			let (textures, samplers) = texturesList()
			doc.set("textures", textures) when textures.len() > 0
			doc.set("images", images) when images.len() > 0
			doc.set("samplers", samplers) when samplers.len() > 0
			let cameras = camerasList()
			doc.set("cameras", cameras) when cameras.len() > 0
			let skins = skinsList()
			doc.set("skins", skins) when skins.len() > 0
			let animations = animationsList()
			doc.set("animations", animations) when animations.len() > 0
			let exts = new map<string, any>()
			if model.lights.len() > 0 {
				let punctual = new map<string, any>()
				punctual.set("lights", lightsList())
				exts.set("KHR_lights_punctual", punctual)
				useExtension("KHR_lights_punctual")
			}
			let extras = new map<string, any>()
			for let key in model.metadata.keys() {
				let v = model.metadata.get(key)
				continue when v is none
				if key.startsWith("extensions.") {
					let name = key[11:]
					exts.set(name, new GltfRaw(v))
					useExtension(name)
				} else if key.startsWith("extras.") {
					extras.set(key[7:], gltfRawOrText(v))
				}
			}
			doc.set("extensions", exts) when exts.len() > 0
			doc.set("extras", extras) when extras.len() > 0
			doc.set("extensionsUsed", extensions) when extensions.len() > 0
			doc.set("extensionsRequired", required) when required.len() > 0
			return doc
		}

		// setBuffer adds the accessors, bufferViews and the one buffer, with
		// the uri (empty for a GLB's binary chunk), to a built document.
		def setBuffer(doc map<string, any>, uri string) {
			doc.set("accessors", binary.accessors) when binary.accessors.len() > 0
			doc.set("bufferViews", binary.views) when binary.views.len() > 0
			return when binary.data.len() == 0
			let b = new map<string, any>()
			b.set("byteLength", binary.data.len())
			b.set("uri", uri) when uri.len() > 0
			let buffers any[]
			buffers.push(b)
			doc.set("buffers", buffers)
		}

		// emit writes the document as JSON.
		def emit(doc map<string, any>, writer io.Writer) !none {
			let out = new bytes.Buffer()
			try gltfWriteJson(out, doc)
			try writer.write(out.bytes())
			return none
		}

		def assetObject() map<string, any> {
			let asset = new map<string, any>()
			asset.set("version", "2.0")
			asset.set("generator", "ADM std.formats.models")
			let copyright = model.metadata.get("copyright")
			asset.set("copyright", copyright) unless copyright is none
			return asset
		}

		def nodesList() any[] {
			let out any[]
			for let (_, n) in nodes {
				let o = new map<string, any>()
				o.set("name", n.name) when n.name.len() > 0
				let children int[]
				for let (_, c) in n.children {
					children.push(gltfNodeIndex(nodes, c))
				}
				o.set("children", children) when children.len() > 0
				let mesh = n.mesh
				if !(mesh is none) {
					let mi = gltfMeshIndex(model.meshes, mesh)
					o.set("mesh", mi) when mi >= 0
					o.set("weights", gltfFloatList(n.weights)) when mi >= 0 && n.weights.len() > 0
				}
				let camera = n.camera
				if !(camera is none) {
					let ci = gltfCameraIndex(model.cameras, camera)
					o.set("camera", ci) when ci >= 0
				}
				let skin = n.skin
				if !(skin is none) {
					let si = gltfSkinIndex(model.skins, skin)
					o.set("skin", si) when si >= 0
				}
				let t = n.translation
				o.set("translation", float[t.x, t.y, t.z]) unless t.x == 0 && t.y == 0 && t.z == 0
				let r = n.rotation
				o.set("rotation", float[r.x, r.y, r.z, r.w]) unless r.x == 0 && r.y == 0 && r.z == 0 && r.w == 1
				let s = n.scale
				o.set("scale", float[s.x, s.y, s.z]) unless s.x == 1 && s.y == 1 && s.z == 1
				let exts = new map<string, any>()
				let light = n.light
				if !(light is none) {
					let li = gltfLightIndex(model.lights, light)
					if li >= 0 {
						let ref = new map<string, any>()
						ref.set("light", li)
						exts.set("KHR_lights_punctual", ref)
					}
				}
				let extras = new map<string, any>()
				for let key in n.metadata.keys() {
					let v = n.metadata.get(key)
					continue when v is none
					if key.startsWith("extensions.") {
						exts.set(key[11:], new GltfRaw(v))
						useExtension(key[11:])
					} else {
						extras.set(key, gltfRawOrText(v))
					}
				}
				o.set("extensions", exts) when exts.len() > 0
				o.set("extras", extras) when extras.len() > 0
				out.push(o)
			}
			return out
		}

		def meshesList() any[] {
			let out any[]
			for let (_, mesh) in model.meshes {
				let o = new map<string, any>()
				o.set("name", mesh.name) when mesh.name.len() > 0
				let prims any[]
				let targetNames string[]
				let anyName = false
				for let (_, prim) in mesh.primitives {
					continue when prim.vertexCount() == 0
					prims.push(primitiveObject(prim))
					if targetNames.len() == 0 {
						for let (_, t) in prim.targets {
							targetNames.push(t.name)
							anyName = anyName || t.name.len() > 0
						}
					}
				}
				o.set("primitives", prims)
				if anyName {
					let extras = new map<string, any>()
					extras.set("targetNames", targetNames)
					o.set("extras", extras)
				}
				out.push(o)
			}
			return out
		}

		def primitiveObject(prim Primitive) map<string, any> {
			let count = prim.vertexCount()
			let o = new map<string, any>()
			let attributes = new map<string, any>()
			attributes.set("POSITION", binary.addFloats(prim.positions, 3, true, gltfTargetArray))
			attributes.set("NORMAL", binary.addFloats(prim.normals, 3, false, gltfTargetArray)) when prim.normals.len() == count * 3
			attributes.set("TANGENT", binary.addFloats(prim.tangents, 4, false, gltfTargetArray)) when prim.tangents.len() == count * 4
			for let (k, set) in prim.uvs {
				attributes.set("TEXCOORD_{k}", binary.addFloats(set, 2, false, gltfTargetArray)) when set.len() == count * 2
			}
			for let (k, set) in prim.colors {
				attributes.set("COLOR_{k}", binary.addFloats(set, 4, false, gltfTargetArray)) when set.len() == count * 4
			}
			if prim.joints.len() == count * 4 && prim.weights.len() == count * 4 {
				attributes.set("JOINTS_0", binary.addJoints(prim.joints))
				attributes.set("WEIGHTS_0", binary.addFloats(prim.weights, 4, false, gltfTargetArray))
			}
			o.set("attributes", attributes)
			o.set("indices", binary.addIndices(prim.indices, count)) when prim.indices.len() > 0
			let material = prim.material
			if !(material is none) {
				let mi = gltfMaterialIndex(model.materials, material)
				o.set("material", mi) when mi >= 0
			}
			o.set("mode", gltfMode(prim.topology)) when prim.topology != Topology.Triangles
			let targets any[]
			for let (_, t) in prim.targets {
				let target = new map<string, any>()
				target.set("POSITION", binary.addFloats(t.positions, 3, true, gltfTargetArray)) when t.positions.len() == count * 3
				target.set("NORMAL", binary.addFloats(t.normals, 3, false, gltfTargetArray)) when t.normals.len() == count * 3
				target.set("TANGENT", binary.addFloats(t.tangents, 3, false, gltfTargetArray)) when t.tangents.len() == count * 3
				targets.push(target)
			}
			o.set("targets", targets) when targets.len() > 0
			return o
		}

		def materialsList() any[] {
			let out any[]
			for let (_, m) in model.materials {
				let o = new map<string, any>()
				o.set("name", m.name) when m.name.len() > 0
				let pbr = new map<string, any>()
				let base = gltfColorList(m.baseColor, true)
				pbr.set("baseColorFactor", base) unless base[0] == 1 && base[1] == 1 && base[2] == 1 && base[3] == 1
				let bct = textureInfo(m.baseColorTexture, "")
				pbr.set("baseColorTexture", bct) unless bct is none
				pbr.set("metallicFactor", m.metallic) unless m.metallic == 1
				pbr.set("roughnessFactor", m.roughness) unless m.roughness == 1
				let mrt = textureInfo(m.metallicRoughnessTexture, "")
				pbr.set("metallicRoughnessTexture", mrt) unless mrt is none
				o.set("pbrMetallicRoughness", pbr) when pbr.len() > 0
				let nt = textureInfo(m.normalTexture, "scale")
				o.set("normalTexture", nt) unless nt is none
				let ot = textureInfo(m.occlusionTexture, "strength")
				o.set("occlusionTexture", ot) unless ot is none
				let emissive = gltfColorList(m.emissive, false)
				o.set("emissiveFactor", emissive) unless emissive[0] == 0 && emissive[1] == 0 && emissive[2] == 0
				let et = textureInfo(m.emissiveTexture, "")
				o.set("emissiveTexture", et) unless et is none
				o.set("alphaMode", "MASK") when m.alphaMode == AlphaMode.Mask
				o.set("alphaMode", "BLEND") when m.alphaMode == AlphaMode.Blend
				o.set("alphaCutoff", m.alphaCutoff) when m.alphaMode == AlphaMode.Mask && m.alphaCutoff != 0.5
				o.set("doubleSided", true) when m.doubleSided
				let exts = new map<string, any>()
				if m.unlit {
					exts.set("KHR_materials_unlit", new map<string, any>())
					useExtension("KHR_materials_unlit")
				}
				if m.emissiveStrength != 1 {
					let es = new map<string, any>()
					es.set("emissiveStrength", m.emissiveStrength)
					exts.set("KHR_materials_emissive_strength", es)
					useExtension("KHR_materials_emissive_strength")
				}
				let extras = new map<string, any>()
				for let key in m.metadata.keys() {
					let v = m.metadata.get(key)
					continue when v is none
					if key.startsWith("extensions.") {
						exts.set(key[11:], new GltfRaw(v))
						useExtension(key[11:])
					} else {
						extras.set(key, gltfRawOrText(v))
					}
				}
				o.set("extensions", exts) when exts.len() > 0
				o.set("extras", extras) when extras.len() > 0
				out.push(o)
			}
			return out
		}

		// textureInfo is a textureInfo object for the reference, none when
		// there is none or its texture is not the model's.
		def textureInfo(ref ?TextureRef, strengthKey string) ?map<string, any> {
			return none when ref is none
			let ti = gltfTextureIndex(model.textures, ref.texture)
			return none when ti < 0
			let o = new map<string, any>()
			o.set("index", ti)
			o.set("texCoord", ref.uv) when ref.uv != 0
			o.set(strengthKey, ref.strength) when strengthKey.len() > 0 && ref.strength != 1
			let t = ref.transform
			if !(t is none) {
				let tt = new map<string, any>()
				tt.set("offset", float[t.offsetU, t.offsetV]) unless t.offsetU == 0 && t.offsetV == 0
				tt.set("rotation", t.rotation) unless t.rotation == 0
				tt.set("scale", float[t.scaleU, t.scaleV]) unless t.scaleU == 1 && t.scaleV == 1
				let exts = new map<string, any>()
				exts.set("KHR_texture_transform", tt)
				o.set("extensions", exts)
				// A reader without the extension would place the texture wrongly.
				useExtension("KHR_texture_transform", true)
			}
			return o
		}

		// texturesList is the textures with their samplers, one sampler per
		// distinct wrap and filter setting.
		def texturesList() (any[], any[]) {
			let textures any[]
			let samplers any[]
			let keys string[]
			for let (i, t) in model.textures {
				let o = new map<string, any>()
				o.set("name", t.name) when t.name.len() > 0
				let img = i < imageOf.len() ?? (imageOf[i], -1)
				o.set("source", img) when img >= 0
				let key = "{gltfWrapCode(t.wrapS)} {gltfWrapCode(t.wrapT)} {gltfFilterCode(t.magFilter)} {gltfFilterCode(t.minFilter)}"
				let defaults = t.wrapS == Wrap.Repeat && t.wrapT == Wrap.Repeat && t.magFilter == Filter.Linear && t.minFilter == Filter.LinearMipmapLinear
				if !defaults {
					let at = keys.indexOf(key)
					if at < 0 {
						let s = new map<string, any>()
						s.set("magFilter", gltfFilterCode(t.magFilter))
						s.set("minFilter", gltfFilterCode(t.minFilter))
						s.set("wrapS", gltfWrapCode(t.wrapS))
						s.set("wrapT", gltfWrapCode(t.wrapT))
						samplers.push(s)
						keys.push(key)
						at = keys.len() - 1
					}
					o.set("sampler", at)
				}
				textures.push(o)
			}
			return (textures, samplers)
		}

		def camerasList() any[] {
			let out any[]
			for let (_, c) in model.cameras {
				let o = new map<string, any>()
				o.set("name", c.name) when c.name.len() > 0
				if c.kind == CameraKind.Orthographic {
					o.set("type", "orthographic")
					let p = new map<string, any>()
					p.set("xmag", c.xmag)
					p.set("ymag", c.ymag)
					p.set("zfar", c.zfar > 0 ?? (c.zfar, 1000.0))
					p.set("znear", c.znear)
					o.set("orthographic", p)
				} else {
					o.set("type", "perspective")
					let p = new map<string, any>()
					p.set("aspectRatio", c.aspect) when c.aspect > 0
					p.set("yfov", c.yfov)
					p.set("zfar", c.zfar) when c.zfar > 0
					p.set("znear", c.znear)
					o.set("perspective", p)
				}
				out.push(o)
			}
			return out
		}

		def lightsList() any[] {
			let out any[]
			for let (_, l) in model.lights {
				let o = new map<string, any>()
				o.set("name", l.name) when l.name.len() > 0
				let rgb = gltfColorList(l.color, false)
				o.set("color", rgb) unless rgb[0] == 1 && rgb[1] == 1 && rgb[2] == 1
				o.set("intensity", l.intensity) unless l.intensity == 1
				switch l.kind {
					case LightKind.Directional:
						o.set("type", "directional")
					case LightKind.Spot:
						o.set("type", "spot")
						let spot = new map<string, any>()
						spot.set("innerConeAngle", l.innerCone)
						spot.set("outerConeAngle", l.outerCone)
						o.set("spot", spot)
					default:
						o.set("type", "point")
				}
				o.set("range", l.range) when l.range > 0
				out.push(o)
			}
			return out
		}

		def skinsList() any[] {
			let out any[]
			for let (_, skin) in model.skins {
				let o = new map<string, any>()
				o.set("name", skin.name) when skin.name.len() > 0
				o.set("inverseBindMatrices", binary.addMatrices(skin.inverseBindMatrices)) when skin.inverseBindMatrices.len() >= skin.joints.len() && skin.joints.len() > 0
				let s = skin.skeleton
				if !(s is none) {
					let si = gltfNodeIndex(nodes, s)
					o.set("skeleton", si) when si >= 0
				}
				let joints int[]
				for let (_, j) in skin.joints {
					joints.push(gltfNodeIndex(nodes, j))
				}
				o.set("joints", joints)
				out.push(o)
			}
			return out
		}

		def animationsList() any[] {
			let out any[]
			for let (_, anim) in model.animations {
				let o = new map<string, any>()
				o.set("name", anim.name) when anim.name.len() > 0
				let channels any[]
				let samplers any[]
				for let (_, ch) in anim.channels {
					continue when ch.times.len() == 0
					let node = gltfNodeIndex(nodes, ch.target)
					continue when node < 0
					let components = 1
					let path = "weights"
					switch ch.path {
						case AnimationPath.Translation:
							components = 3
							path = "translation"
						case AnimationPath.Scale:
							components = 3
							path = "scale"
						case AnimationPath.Rotation:
							components = 4
							path = "rotation"
						default:
					}
					let s = new map<string, any>()
					s.set("input", binary.addFloats(ch.times, 1, true, 0))
					let interpolation = "LINEAR"
					interpolation = "STEP" when ch.interpolation == Interpolation.Step
					interpolation = "CUBICSPLINE" when ch.interpolation == Interpolation.CubicSpline
					s.set("interpolation", interpolation) unless interpolation == "LINEAR"
					s.set("output", binary.addFloats(ch.values, components, false, 0))
					samplers.push(s)
					let c = new map<string, any>()
					c.set("sampler", samplers.len() - 1)
					let target = new map<string, any>()
					target.set("node", node)
					target.set("path", path)
					c.set("target", target)
					channels.push(c)
				}
				continue when channels.len() == 0
				o.set("channels", channels)
				o.set("samplers", samplers)
				out.push(o)
			}
			return out
		}
	}

	// gltfRawOrText is a metadata value for extras: JSON text (an object,
	// array, number or literal the reader kept) as it is, any other text as
	// a string.
	def gltfRawOrText(v string) any {
		let t = v.trim()
		return new GltfRaw(t) when t.len() > 0 && (t.startsWith("\{") && t.endsWith("}") || t.startsWith("[") && t.endsWith("]")) && new JSON().isValid(t)
		return v
	}

	// gltfImageName is the display name of an image: its source without
	// folders and extension.
	def gltfImageName(source string) string {
		let name = source.replace("\\", "/")
		let slash = name.lastIndexOf("/")
		name = name[slash + 1:] when slash >= 0
		let dot = name.lastIndexOf(".")
		name = name[:dot] when dot > 0
		return name
	}

	// gltfImageFile is the file an image is written to beside the model: its
	// source's name, with the type's extension when it has none.
	def gltfImageFile(source string, mime string) string {
		let name = source.replace("\\", "/")
		let slash = name.lastIndexOf("/")
		name = name[slash + 1:] when slash >= 0
		name = "image" when name.len() == 0
		let dot = name.lastIndexOf(".")
		return name when dot > 0 && dot < name.len() - 1
		return name + gltfExtension(mime)
	}

	// gltfColorList is a colour as 0..1 factors, three or four.
	def gltfColorList(c color.Color, withAlpha bool) float[] {
		let out = float[float(c.red) / 255.0, float(c.green) / 255.0, float(c.blue) / 255.0]
		out.push(float(c.alpha) / 255.0) when withAlpha
		return out
	}

	def gltfFloatList(v float[]) float[] {
		return v
	}

	def gltfNodeIndex(list Node[], item Node) int {
		for let (i, v) in list {
			return i when v == item
		}
		return -1
	}

	def gltfMeshIndex(list Mesh[], item Mesh) int {
		for let (i, v) in list {
			return i when v == item
		}
		return -1
	}

	def gltfMaterialIndex(list Material[], item Material) int {
		for let (i, v) in list {
			return i when v == item
		}
		return -1
	}

	def gltfTextureIndex(list Texture[], item Texture) int {
		for let (i, v) in list {
			return i when v == item
		}
		return -1
	}

	def gltfCameraIndex(list Camera[], item Camera) int {
		for let (i, v) in list {
			return i when v == item
		}
		return -1
	}

	def gltfLightIndex(list Light[], item Light) int {
		for let (i, v) in list {
			return i when v == item
		}
		return -1
	}

	def gltfSkinIndex(list Skin[], item Skin) int {
		for let (i, v) in list {
			return i when v == item
		}
		return -1
	}

	def gltfMode(t Topology) int {
		switch t {
			case Topology.Points:
				return 0
			case Topology.Lines:
				return 1
			case Topology.LineLoop:
				return 2
			case Topology.LineStrip:
				return 3
			case Topology.TriangleStrip:
				return 5
			case Topology.TriangleFan:
				return 6
			default:
				return 4
		}
	}

	def gltfWrapCode(w Wrap) int {
		switch w {
			case Wrap.Clamp:
				return 33071
			case Wrap.Mirror:
				return 33648
			default:
				return 10497
		}
	}

	def gltfFilterCode(f Filter) int {
		switch f {
			case Filter.Nearest:
				return 9728
			case Filter.Linear:
				return 9729
			case Filter.NearestMipmapNearest:
				return 9984
			case Filter.LinearMipmapNearest:
				return 9985
			case Filter.NearestMipmapLinear:
				return 9986
			default:
				return 9987
		}
	}

	// gltfWriteJson writes a value as JSON: maps in their key order,
	// floats with nine significant digits (a float32 reads back exactly),
	// GltfRaw text as it is.
	def gltfWriteJson(out bytes.Buffer, v any) !none {
		if v is none {
			try out.writeString("null")
			return none
		}
		match v {
			case GltfRaw:
				try out.writeString(v.text)
			case string:
				try out.write(new JSON().encode(v))
			case bool:
				try out.writeString(v ?? ("true", "false"))
			case int:
				try out.writeString("{v}")
			case float:
				try out.writeString(gltfNumber(v))
			case map<string, any>:
				try out.writeString("\{")
				let first = true
				for let key in v.keys() {
					try out.writeString(",") unless first
					first = false
					try out.write(new JSON().encode(key))
					try out.writeString(":")
					let member = v.get(key)
					if member is none {
						try out.writeString("null")
					} else {
						try gltfWriteJson(out, member)
					}
				}
				try out.writeString("\}")
			case any[]:
				try out.writeString("[")
				for let (i, e) in v {
					try out.writeString(",") when i > 0
					try gltfWriteJson(out, e)
				}
				try out.writeString("]")
			case int[]:
				try out.writeString("[")
				for let (i, e) in v {
					try out.writeString(",") when i > 0
					try out.writeString("{e}")
				}
				try out.writeString("]")
			case float[]:
				try out.writeString("[")
				for let (i, e) in v {
					try out.writeString(",") when i > 0
					try out.writeString(gltfNumber(e))
				}
				try out.writeString("]")
			case string[]:
				try out.writeString("[")
				for let (i, e) in v {
					try out.writeString(",") when i > 0
					try out.write(new JSON().encode(e))
				}
				try out.writeString("]")
			default:
				try out.writeString("null")
		}
		return none
	}

	// gltfNumber is a float as a JSON number: an integer as such, else nine
	// significant digits; a value JSON cannot hold (infinite, not a number)
	// is 0.
	def gltfNumber(v float) string {
		return "0" when v != v || v > 1.0e300 || v < -1.0e300
		return "{int(v)}" when v == v.floor() && v.abs() < 1.0e15
		return "%.9g".format(v)
	}
}
