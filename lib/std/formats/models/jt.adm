partial module std.formats.models {
	use std.io

	// Jt is Siemens JT, versions 8 to 10.5: a product structure (assembly,
	// part and instance nodes with transforms, names and properties), each
	// part's tessellated levels of detail (triangle strips with normals,
	// texture coordinates and colours, in the format's compressed encodings)
	// and materials. Reads the structure as nodes with the chosen level of
	// detail as the meshes, properties into the node metadata; B-rep (XT and
	// JT B-rep) and PMI are left out. Writes an assembly with one part per
	// mesh and one level of detail.
	@codec("JT")
	type Jt {
		// The level of detail read: 0 the finest, higher coarser; a part with
		// fewer levels gives its coarsest.
		lod     int    = 0
		// The JT version written.
		version string = "10.5"

		mimeType string[] {
			def get() string[] {
				return string["model/jt"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".jt"]
			}
		}

		// matchSignature tests for the version line every JT file opens with,
		// `Version <n> JT`.
		def matchSignature(r io.Reader) bool {
			let head = string(prefix(r, 24))
			return head.startsWith("Version ") && head.contains(" JT")
		}

		// decode reads the whole reader as JT. Fails with a ModelError when the
		// version is not read, a segment is missing or an encoding is unknown,
		// or with the reader's own error.
		def decode(reader io.Reader, resources ?ResourceReader) !Model {}

		// encode writes the model as a JT file of `version`. Fails with the
		// writer's own error.
		def encode(model Model, writer io.Writer, resources ?ResourceWriter) !none {}
	}
}
