partial module std.formats.models {
	use std.gfx.color

	// LightKind is the shape of a light.
	enum LightKind {
		// Parallel light from the node's negative z direction, everywhere.
		Directional,
		// Light in every direction from the node's position.
		Point,
		// A cone of light down the node's negative z axis.
		Spot,
	}

	// Light is a light source, placed by the node that holds it.
	type Light {
		name      string
		kind      LightKind   = LightKind.Point
		// The light's colour; white by default.
		color     color.Color
		// Candela for a point or spot light, lux for a directional one.
		intensity float       = 1.0
		// The distance beyond which the light has no effect, 0 for none.
		range     float       = 0.0
		// Spot: the half angles in radians within which the light is full and
		// beyond which there is none, with a falloff between.
		innerCone float       = 0.0
		outerCone float       = 0.7853981633974483

		def new(name string = "", kind LightKind = LightKind.Point) {
			self.name = name
			self.kind = kind
			color = new color.Color("#ffffff")
		}
	}
}
