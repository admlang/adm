partial module std.formats.models {
	use (
		std.bytes
		std.errors
		std.formats
		std.io
		std.os
		std.reflection
	)

	// ModelError is the payload of a model that does not decode or encode.
	struct ModelError {
		message string
		code    string            = "model"
		cause   ?error
		stack   errors.StackTrace
		// Name of the codec that failed, as registered with `codec`.
		format  string
		// What the file lacked or held that the codec refused: a chunk, an
		// entity, a line of text; empty when the message says it all.
		detail  string
	}

	// ResourceReader opens the files a model refers to beside its own: glTF
	// buffers and images, OBJ material libraries, FBX and 3DS textures.
	interface ResourceReader {
		// open opens the file of the name, relative to the model's. Fails when
		// there is no such file or it cannot be read.
		def open(name string) !io.Reader
	}

	// ResourceWriter creates the files a model is written beside: what a format
	// keeps outside the model file when it is given somewhere to put them.
	interface ResourceWriter {
		// create creates the file of the name, relative to the model's,
		// replacing one that is there. Fails when it cannot be created.
		def create(name string) !io.Writer
	}

	// DirectoryResources reads and writes the files of one directory, the one a
	// model file is in. `load(path)` and `Model.save(path)` use it.
	type DirectoryResources {
		dir string

		def new(dir string) {
			self.dir = dir
		}

		// open opens the file of the name in the directory. Fails when there is
		// no such file or it cannot be read.
		def open(name string) !io.Reader {
			return os.open(os.join(dir, name))
		}

		// create creates the file of the name in the directory, replacing one
		// that is there. Fails when it cannot be created.
		def create(name string) !io.Writer {
			return os.open(os.join(dir, name), "w")
		}
	}

	// ModelDecoder reads a model from a reader.
	interface ModelDecoder {
		// decode reads the whole reader. Files the model refers to are opened
		// through resources; with none, a referred-to buffer fails the decode
		// and a referred-to texture is left out. Fails with a ModelError when
		// the content is not valid for the format, or with the reader's own
		// error.
		def decode(reader io.Reader, resources ?ResourceReader) !Model
	}

	// ModelEncoder writes a model to a writer.
	interface ModelEncoder {
		// encode writes the model in the codec's format. Files the format keeps
		// beside the model are created through resources; with none, the codec
		// embeds what it can and leaves the rest out. What the format cannot
		// express is simplified or left out, never an error. Fails with the
		// writer's own error, or with a ModelError for a format that cannot be
		// written at all.
		def encode(model Model, writer io.Writer, resources ?ResourceWriter) !none
	}

	// ModelCodec is what a model format registers: a decoder, an encoder and
	// the file format description.
	type ModelCodec = ModelDecoder & ModelEncoder & formats.FileFormat

	// codec registers a type as the model codec of the named format, found
	// through discovery.
	meta def codec<ModelCodec>(ctx reflection.DiscoveryMetaContext<reflection.TypeMetaContext>, name string) {}

	internal let codecRegistry = new formats.CodecRegistry<ModelCodec>("model", codec)

	// load reads the model in the file, with the files it refers to taken from
	// the same directory. The codec is found by the file's signature, then by
	// its extension, since text formats have no signature. Fails when the file
	// cannot be read, no codec claims it, or decoding does.
	def load(path string) !Model {
		let f = try os.open(path)
		defer f.close()

		let resources = new DirectoryResources(os.dir(path))
		let r = new bytes.RewindableReader(f)
		let found = sniff(r) onerror recover none
		if found is none {
			let byExtension = codecRegistry.matchExt(os.extension(path))
			fail "no model codec reads \"{path}\"" when byExtension is none
			r.rewind().freeze()
			return byExtension.decode(r, resources)
		}

		let (dec, body) = found
		return dec.decode(body, resources)
	}

	// load reads a model from the bytes, the codec found by signature; files it
	// refers to are not available. Fails when no codec claims the data, or
	// decoding does.
	def load(data byte[]) !Model {
		let (dec, r) = try codecRegistry.probe(data)
		return dec.decode(r, none)
	}

	// load reads a model from the reader, the codec found by signature; files
	// it refers to are not available. Fails when no codec claims the data, or
	// decoding does.
	def load(reader io.Reader) !Model {
		let (dec, r) = try codecRegistry.probe(reader)
		return dec.decode(r, none)
	}

	// load reads a model from the reader with the codec registered for the file
	// extension (".obj", ".gltf"), for formats that have no signature; files it
	// refers to are not available. Fails when no codec has the extension, or
	// decoding does.
	def load(reader io.Reader, extension string) !Model {
		let dec = codecRegistry.matchExt(extension)
		fail "no model codec has the extension \"{extension}\"" when dec is none
		return dec.decode(reader, none)
	}

	// load reads a model from the reader with the codec registered for the file
	// extension, opening the files it refers to through resources. Fails when
	// no codec has the extension, or decoding does.
	def load(reader io.Reader, extension string, resources ResourceReader) !Model {
		let dec = codecRegistry.matchExt(extension)
		fail "no model codec has the extension \"{extension}\"" when dec is none
		return dec.decode(reader, resources)
	}

	// sniff returns the codec whose signature the reader carries, with a reader
	// rewound to the start, none when there is no such codec.
	internal def sniff(reader io.Reader) !?(ModelCodec, io.Reader) {
		return try codecRegistry.probe(reader)
	}

	// prefix reads up to n bytes from the start of the reader for a signature
	// test: fewer when the content is shorter.
	internal def prefix(r io.Reader, n int) byte[] {
		let b byte[]
		b.len(n)
		let got = r.read(b) onerror recover 0
		b.len(got)
		return b
	}
}
