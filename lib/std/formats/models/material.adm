partial module std.formats.models {
	use (
		std.formats.image
		std.formats.image::(load as loadImage)
		std.gfx.color
	)

	// AlphaMode is how a material's alpha is drawn.
	enum AlphaMode {
		// Alpha is ignored; the surface is solid.
		Opaque,
		// Alpha below the cutoff is not drawn, the rest is solid.
		Mask,
		// Alpha blends the surface over what is behind it.
		Blend,
	}

	// Wrap is what a texture shows outside 0..1 coordinates.
	enum Wrap {
		Repeat,
		Clamp,
		Mirror,
	}

	// Filter is how a texture is sampled when magnified or minified.
	enum Filter {
		Nearest,
		Linear,
		NearestMipmapNearest,
		LinearMipmapNearest,
		NearestMipmapLinear,
		LinearMipmapLinear,
	}

	// TextureTransform moves a texture over the surface: a texture coordinate
	// is scaled, rotated about the origin and then offset before the texture
	// is read, as glTF's KHR_texture_transform has it:
	// `u' = cos·su·u − sin·sv·v + ou`, `v' = sin·su·u + cos·sv·v + ov`.
	struct TextureTransform {
		offsetU  float = 0.0
		offsetV  float = 0.0
		// Radians, counter-clockwise in texture space.
		rotation float = 0.0
		scaleU   float = 1.0
		scaleV   float = 1.0
	}

	// TextureRef is a material's use of a texture: which one, read with which
	// of the primitive's texture coordinate sets, how strongly, and moved how.
	struct TextureRef {
		texture   Texture
		// The index into Primitive.uvs the texture is read with.
		uv        int               = 0
		// The scale of a normal texture's xy, or the strength of an occlusion
		// texture; 1.0 for the others.
		strength  float             = 1.0
		// How the coordinates are moved before the texture is read; none for
		// as they are.
		transform ?TextureTransform
	}

	// Texture is an image and how it is sampled. The image is named by
	// `source`: an entry of Model.resources, else a URI relative to the file
	// the model came from.
	type Texture {
		name      string
		source    string
		// The image's media type when the file stated it ("image/png"), else
		// empty and found from the image's own signature.
		mimeType  string
		wrapS     Wrap   = Wrap.Repeat
		wrapT     Wrap   = Wrap.Repeat
		magFilter Filter = Filter.Linear
		minFilter Filter = Filter.LinearMipmapLinear

		def new(source string = "") {
			self.source = source
		}

		// image decodes the texture's image from the model's resources through
		// std.formats.image. Fails when the model has no resource of the name
		// (an external file is read by the codec that loaded the model, through
		// its ResourceReader, into the resources) or no image codec reads it.
		def image(model Model) !image.Image {
			let data = model.resource(source)
			fail ModelError{message: "texture \"{name}\" has no image: the model holds no resource \"{source}\"", format: "model", detail: source} when data is none
			return loadImage(data)
		}
	}

	// Material is how a surface is shaded, in the metallic-roughness model of
	// glTF: a base colour, how metallic and how rough it is, emission, a normal
	// map and ambient occlusion, each as a value and as a texture that
	// modulates it. Formats with classic Phong shading (OBJ, 3DS, FBX, DXF)
	// read into the base colour and the classic fields, and write from them,
	// taking `baseColor` for the diffuse colour.
	type Material {
		name                     string
		// Red, green, blue and alpha of the surface; white by default.
		baseColor                color.Color
		baseColorTexture         ?TextureRef
		// 0 a dielectric, 1 a metal.
		metallic                 float               = 1.0
		// 0 a mirror, 1 fully diffuse.
		roughness                float               = 1.0
		// Roughness in the green channel, metalness in the blue.
		metallicRoughnessTexture ?TextureRef
		normalTexture            ?TextureRef
		occlusionTexture         ?TextureRef
		// Light the surface gives off; black by default.
		emissive                 color.Color
		// Multiplies the emissive colour, for light brighter than a colour
		// holds; 1 for the colour as it is.
		emissiveStrength         float               = 1.0
		emissiveTexture          ?TextureRef
		alphaMode                AlphaMode           = AlphaMode.Opaque
		// The alpha below which a Mask material is not drawn.
		alphaCutoff              float               = 0.5
		// Whether back faces are drawn too.
		doubleSided              bool
		// Drawn in its base colour with no lighting.
		unlit                    bool
		// Classic shading, from formats that have it; none when the source has
		// no such value and the encoders derive one.
		ambient                  ?color.Color
		specular                 ?color.Color
		// The specular exponent of classic shading, 0 when unknown.
		shininess                float
		// How transparent classic shading makes the surface, 0 solid to 1
		// invisible; the base colour's alpha carries it for the others.
		transparency             float
		// Properties the source attached to the material that the fields do
		// not hold (glTF extras, and its extensions this model does not
		// have fields for, as `extensions.<name>` JSON text), as text.
		metadata                 map<string, string>

		def new(name string = "") {
			self.name = name
			baseColor = new color.Color("#ffffff")
			emissive = new color.Color("#000000")
			metadata = new map<string, string>()
		}
	}
}
