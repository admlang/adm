partial module std.formats.models {
	use (
		std.math::(*)
		std.math.geom::(Vec3)
		std.simd
	)

	// Topology is how a primitive's vertices form its shape.
	enum Topology {
		// Every vertex on its own.
		Points,
		// Every two vertices a segment.
		Lines,
		// Each vertex joined to the one before.
		LineStrip,
		// A LineStrip whose last vertex is joined to the first.
		LineLoop,
		// Every three vertices a triangle, counter-clockwise seen from outside.
		Triangles,
		// Each vertex a triangle with the two before.
		TriangleStrip,
		// Each vertex a triangle with the one before and the first.
		TriangleFan,
	}

	// MorphTarget is a displacement of a primitive's vertices, added to the
	// primitive's own attributes in the proportion of the node's weight for it.
	type MorphTarget {
		name      string
		// 3 per vertex, added to the primitive's positions.
		positions float32[]
		// 3 per vertex, added to the normals; empty when the normals do not move.
		normals   float32[]
		// 3 per vertex, added to the tangents' xyz; empty when they do not move.
		tangents  float32[]

		def new(name string = "") {
			self.name = name
			positions = float32[]
			normals = float32[]
			tangents = float32[]
		}
	}

	// Primitive is one drawable part of a mesh: its vertices as flat attribute
	// arrays (a vertex is one index into each), the indices that join them
	// into points, lines or triangles, and the material they are drawn with.
	// Attributes a primitive does not have are empty arrays; the ones it has
	// hold values for every vertex.
	type Primitive {
		topology  Topology      = Topology.Triangles
		// None draws with the format's default material.
		material  ?Material
		// 3 per vertex: x, y, z in the node's coordinates.
		positions float32[]
		// 3 per vertex, unit length; empty when the file had none (see
		// computeNormals).
		normals   float32[]
		// 4 per vertex: a unit xyz along the texture's u axis and the
		// handedness, 1 or -1, of the bitangent.
		tangents  float32[]
		// Texture coordinate sets, 2 per vertex each (u, v with v down, as glTF
		// has it). A material's TextureRef names the set it reads.
		uvs       float32[][]
		// Vertex colour sets, 4 per vertex each: red, green, blue, alpha in 0..1.
		colors    float32[][]
		// 4 per vertex: the indices into the skin's joints that move the vertex.
		joints    uint16[]
		// 4 per vertex: how much each joint moves it, summing to 1.
		weights   float32[]
		// Vertex indices in the order the topology reads them; empty draws the
		// vertices in the order they are stored.
		indices   uint32[]
		targets   MorphTarget[]

		def new(topology Topology = Topology.Triangles) {
			self.topology = topology
			positions = float32[]
			normals = float32[]
			tangents = float32[]
			uvs = float32[][]
			colors = float32[][]
			joints = uint16[]
			weights = float32[]
			indices = uint32[]
			targets = MorphTarget[]
		}

		// vertexCount is the number of vertices stored: positions.len() / 3.
		def vertexCount() int {
			return positions.len() / 3
		}

		// indexCount is the number of indices drawn: indices.len(), or
		// vertexCount() when there are none.
		def indexCount() int {
			return indices.len() when indices.len() > 0
			return vertexCount()
		}

		// faceCount is the number of points, segments or triangles the
		// topology makes of the indices.
		def faceCount() int {
			let n = indexCount()
			match topology {
				case Topology.Points:
					return n
				case Topology.Lines:
					return n / 2
				case Topology.LineStrip:
					return (n - 1).max(0)
				case Topology.LineLoop:
					return n >= 2 ?? (n, 0)
				case Topology.Triangles:
					return n / 3
				case Topology.TriangleStrip, Topology.TriangleFan:
					return (n - 2).max(0)
			}
			return 0
		}

		// position is the vertex's position.
		def position(index int) Vec3 {
			let i = index * 3
			return new Vec3(float(positions[i]), float(positions[i + 1]), float(positions[i + 2]))
		}

		// normal is the vertex's normal, none when the primitive has none.
		def normal(index int) ?Vec3 {
			return none when normals.len() < (index + 1) * 3
			let i = index * 3
			return new Vec3(float(normals[i]), float(normals[i + 1]), float(normals[i + 2]))
		}

		// bounds is the axis-aligned box around the positions: its least and
		// greatest corner. None when there are no vertices.
		def bounds() ?(Vec3, Vec3) {
			let n = positions.len()
			return none when n < 3
			if n < 12 {
				let minX = positions[0]
				let minY = positions[1]
				let minZ = positions[2]
				let maxX = minX
				let maxY = minY
				let maxZ = minZ
				for let i = 3; i + 3 <= n; i += 3 {
					minX = minX.min(positions[i])
					minY = minY.min(positions[i + 1])
					minZ = minZ.min(positions[i + 2])
					maxX = maxX.max(positions[i])
					maxY = maxY.max(positions[i + 1])
					maxZ = maxZ.max(positions[i + 2])
				}
				return (new Vec3(float(minX), float(minY), float(minZ)), new Vec3(float(maxX), float(maxY), float(maxZ)))
			}
			// Three accumulators over the x y z x | y z x y | z x y z lane
			// pattern of four packed vertices, so every lane always sees one
			// component; the lanes are gathered per component at the end. Each
			// starts from the first four vertices, so no lane holds another
			// component's value.
			let lo0 = simd.load4<float32>(positions, 0)
			let lo1 = simd.load4<float32>(positions, 4)
			let lo2 = simd.load4<float32>(positions, 8)
			let hi0 = lo0
			let hi1 = lo1
			let hi2 = lo2
			let i = 12
			for i + 12 <= n {
				let a = simd.load4<float32>(positions, i)
				let b = simd.load4<float32>(positions, i + 4)
				let c = simd.load4<float32>(positions, i + 8)
				lo0 = lo0.min(a)
				lo1 = lo1.min(b)
				lo2 = lo2.min(c)
				hi0 = hi0.max(a)
				hi1 = hi1.max(b)
				hi2 = hi2.max(c)
				i += 12
			}
			let minX = lo0.lane(0).min(lo0.lane(3)).min(lo1.lane(2)).min(lo2.lane(1))
			let minY = lo0.lane(1).min(lo1.lane(0)).min(lo1.lane(3)).min(lo2.lane(2))
			let minZ = lo0.lane(2).min(lo1.lane(1)).min(lo2.lane(0)).min(lo2.lane(3))
			let maxX = hi0.lane(0).max(hi0.lane(3)).max(hi1.lane(2)).max(hi2.lane(1))
			let maxY = hi0.lane(1).max(hi1.lane(0)).max(hi1.lane(3)).max(hi2.lane(2))
			let maxZ = hi0.lane(2).max(hi1.lane(1)).max(hi2.lane(0)).max(hi2.lane(3))
			for i + 3 <= n {
				minX = minX.min(positions[i])
				minY = minY.min(positions[i + 1])
				minZ = minZ.min(positions[i + 2])
				maxX = maxX.max(positions[i])
				maxY = maxY.max(positions[i + 1])
				maxZ = maxZ.max(positions[i + 2])
				i += 3
			}
			return (new Vec3(float(minX), float(minY), float(minZ)), new Vec3(float(maxX), float(maxY), float(maxZ)))
		}

		// triangleIndices lists the primitive's triangles as plain index
		// triples: strips and fans unrolled, sequential indices when there are
		// none. Empty for points and lines.
		def triangleIndices() uint32[] {
			let out uint32[]
			let n = indexCount()
			match topology {
				case Topology.Triangles:
					return indices.clone() when indices.len() > 0
					out.len(n - n % 3)
					for let i = 0; i < out.len(); i++ {
						out[i] = uint32(i)
					}
				case Topology.TriangleStrip:
					return out when n < 3
					out.len((n - 2) * 3)
					for let t = 0; t + 2 < n; t++ {
						// Every second triangle swaps two corners to keep the winding.
						let even = t % 2 == 0
						out[t * 3] = indexAt(t)
						out[t * 3 + 1] = indexAt(even ?? (t + 1, t + 2))
						out[t * 3 + 2] = indexAt(even ?? (t + 2, t + 1))
					}
				case Topology.TriangleFan:
					return out when n < 3
					out.len((n - 2) * 3)
					for let t = 0; t + 2 < n; t++ {
						out[t * 3] = indexAt(0)
						out[t * 3 + 1] = indexAt(t + 1)
						out[t * 3 + 2] = indexAt(t + 2)
					}
				default:
			}
			return out
		}

		// indexAt is the vertex the k-th drawn index names.
		internal def indexAt(k int) uint32 {
			return indices[k] when indices.len() > 0
			return uint32(k)
		}

		// computeNormals writes `normals` from the triangles: the face normal
		// of each triangle, averaged at a vertex over the triangles that share
		// it (weighted by their area) when smooth, else repeated per face
		// (vertices shared by faces are split first). Does nothing for points
		// and lines.
		def computeNormals(smooth bool = true) {
			return when topology == Topology.Points || topology == Topology.Lines || topology == Topology.LineStrip || topology == Topology.LineLoop
			unindexed() unless smooth
			let tris = triangleIndices()
			let count = vertexCount()
			let sum float[]
			sum.len(count * 3)
			for let t = 0; t + 2 < tris.len(); t += 3 {
				let a = int(tris[t]) * 3
				let b = int(tris[t + 1]) * 3
				let c = int(tris[t + 2]) * 3
				let ux = float(positions[b] - positions[a])
				let uy = float(positions[b + 1] - positions[a + 1])
				let uz = float(positions[b + 2] - positions[a + 2])
				let vx = float(positions[c] - positions[a])
				let vy = float(positions[c + 1] - positions[a + 1])
				let vz = float(positions[c + 2] - positions[a + 2])
				// The cross product's length is twice the area, which weights
				// the average.
				let nx = uy * vz - uz * vy
				let ny = uz * vx - ux * vz
				let nz = ux * vy - uy * vx
				sum[a] += nx
				sum[a + 1] += ny
				sum[a + 2] += nz
				sum[b] += nx
				sum[b + 1] += ny
				sum[b + 2] += nz
				sum[c] += nx
				sum[c + 1] += ny
				sum[c + 2] += nz
			}
			normals.len(count * 3)
			for let i = 0; i < count * 3; i += 3 {
				let len = sqrt(sum[i] * sum[i] + sum[i + 1] * sum[i + 1] + sum[i + 2] * sum[i + 2])
				if len == 0 {
					normals[i] = 0
					normals[i + 1] = 0
					normals[i + 2] = 1
					continue
				}
				normals[i] = float32(sum[i] / len)
				normals[i + 1] = float32(sum[i + 1] / len)
				normals[i + 2] = float32(sum[i + 2] / len)
			}
		}

		// computeTangents writes `tangents` from the positions, normals and the
		// texture coordinate set: per-triangle tangents along u accumulated at
		// each vertex, made perpendicular to the normal, with the handedness
		// of the bitangent in w. Fails when the primitive has no normals or no
		// such set.
		def computeTangents(uv int = 0) !none {
			fail ModelError{message: "tangents need normals; call computeNormals first", format: "model"} when normals.len() < positions.len()
			fail ModelError{message: "tangents need texture coordinate set {uv}, which the primitive does not have", format: "model"} when uv < 0 || uv >= uvs.len()
			let tex = uvs[uv]
			let count = vertexCount()
			let tan float[]
			tan.len(count * 3)
			let bitan float[]
			bitan.len(count * 3)
			let tris = triangleIndices()
			for let t = 0; t + 2 < tris.len(); t += 3 {
				let ia = int(tris[t])
				let ib = int(tris[t + 1])
				let ic = int(tris[t + 2])
				let a = ia * 3
				let b = ib * 3
				let c = ic * 3
				let e1x = float(positions[b] - positions[a])
				let e1y = float(positions[b + 1] - positions[a + 1])
				let e1z = float(positions[b + 2] - positions[a + 2])
				let e2x = float(positions[c] - positions[a])
				let e2y = float(positions[c + 1] - positions[a + 1])
				let e2z = float(positions[c + 2] - positions[a + 2])
				let du1 = float(tex[ib * 2] - tex[ia * 2])
				let dv1 = float(tex[ib * 2 + 1] - tex[ia * 2 + 1])
				let du2 = float(tex[ic * 2] - tex[ia * 2])
				let dv2 = float(tex[ic * 2 + 1] - tex[ia * 2 + 1])
				let det = du1 * dv2 - du2 * dv1
				continue when det == 0
				let r = 1.0 / det
				let tx = (e1x * dv2 - e2x * dv1) * r
				let ty = (e1y * dv2 - e2y * dv1) * r
				let tz = (e1z * dv2 - e2z * dv1) * r
				let bx = (e2x * du1 - e1x * du2) * r
				let by = (e2y * du1 - e1y * du2) * r
				let bz = (e2z * du1 - e1z * du2) * r
				for let (_, v) in int[a, b, c] {
					tan[v] += tx
					tan[v + 1] += ty
					tan[v + 2] += tz
					bitan[v] += bx
					bitan[v + 1] += by
					bitan[v + 2] += bz
				}
			}
			tangents.len(count * 4)
			for let v = 0; v < count; v++ {
				let i = v * 3
				let nx = float(normals[i])
				let ny = float(normals[i + 1])
				let nz = float(normals[i + 2])
				// Gram-Schmidt: the tangent less its part along the normal.
				let d = nx * tan[i] + ny * tan[i + 1] + nz * tan[i + 2]
				let tx = tan[i] - nx * d
				let ty = tan[i + 1] - ny * d
				let tz = tan[i + 2] - nz * d
				let len = sqrt(tx * tx + ty * ty + tz * tz)
				if len == 0 {
					// No texture gradient here: any unit vector perpendicular to the normal.
					if nx.abs() < 0.9 {
						tx = 0
						ty = -nz
						tz = ny
					} else {
						tx = nz
						ty = 0
						tz = -nx
					}
					len = sqrt(tx * tx + ty * ty + tz * tz)
				}
				tangents[v * 4] = float32(tx / len)
				tangents[v * 4 + 1] = float32(ty / len)
				tangents[v * 4 + 2] = float32(tz / len)
				// Handedness: the sign of (n × t) · b.
				let cx = ny * tz - nz * ty
				let cy = nz * tx - nx * tz
				let cz = nx * ty - ny * tx
				let h = cx * bitan[i] + cy * bitan[i + 1] + cz * bitan[i + 2]
				tangents[v * 4 + 3] = h < 0 ?? (-1.0, 1.0)
			}
			return none
		}

		// indexed merges vertices whose every attribute is equal into one and
		// writes `indices`, which is how STL and unindexed OBJ geometry becomes
		// a mesh with shared vertices. With a tolerance, positions are compared
		// on a grid of that spacing (two positions in one cell are equal; two
		// across a cell boundary are not); 0 compares them exactly. Morph
		// targets are merged with their vertices.
		def indexed(tolerance float = 0.0) {
			let count = vertexCount()
			return when count == 0
			// Open addressing over the vertex indices, 0 for an empty slot.
			let size = 1
			for size < count * 2 {
				size *= 2
			}
			let table uint32[]
			table.len(size)
			let mask = uint64(size - 1)
			let remap uint32[]
			remap.len(count)
			let keep int[]
			let inv = tolerance > 0 ?? (1.0 / tolerance, 0.0)
			for let v = 0; v < count; v++ {
				let h = positionHash(v, inv)
				let slot = int(h & mask)
				for {
					let held = int(table[slot])
					if held == 0 {
						table[slot] = uint32(keep.len() + 1)
						remap[v] = uint32(keep.len())
						keep.push(v)
						break
					}
					let other = keep[held - 1]
					if sameVertex(v, other, inv) {
						remap[v] = uint32(held - 1)
						break
					}
					slot = int((uint64(slot) + 1) & mask)
				}
			}
			return when keep.len() == count && indices.len() > 0
			if indices.len() == 0 {
				indices.len(count)
				for let v = 0; v < count; v++ {
					indices[v] = remap[v]
				}
			} else {
				for let k = 0; k < indices.len(); k++ {
					indices[k] = remap[int(indices[k])]
				}
			}
			return when keep.len() == count
			positions = gather(positions, keep, 3)
			normals = gather(normals, keep, 3)
			tangents = gather(tangents, keep, 4)
			for let s = 0; s < uvs.len(); s++ {
				uvs[s] = gather(uvs[s], keep, 2)
			}
			for let s = 0; s < colors.len(); s++ {
				colors[s] = gather(colors[s], keep, 4)
			}
			joints = gatherJoints(joints, keep)
			weights = gather(weights, keep, 4)
			for let (_, target) in targets {
				target.positions = gather(target.positions, keep, 3)
				target.normals = gather(target.normals, keep, 3)
				target.tangents = gather(target.tangents, keep, 3)
			}
		}

		// positionHash mixes the vertex's position, exact or on the grid.
		internal def positionHash(v int, inv float) uint64 {
			let i = v * 3
			let a uint64
			let b uint64
			let c uint64
			if inv == 0 {
				a = uint64(normalizedBits(positions[i]))
				b = uint64(normalizedBits(positions[i + 1]))
				c = uint64(normalizedBits(positions[i + 2]))
			} else {
				a = uint64(int64((float(positions[i]) * inv).round()))
				b = uint64(int64((float(positions[i + 1]) * inv).round()))
				c = uint64(int64((float(positions[i + 2]) * inv).round()))
			}
			let h = a * 0x9E3779B97F4A7C15 ^ b * 0xC2B2AE3D27D4EB4F ^ c * 0x165667B19E3779F9
			h ^= h >> 29
			h *= 0xBF58476D1CE4E5B9
			h ^= h >> 32
			return h
		}

		// normalizedBits is the float's bits with -0 read as 0, so the two
		// hash alike as they compare alike.
		internal def normalizedBits(v float32) uint32 {
			let b = __bitcast_u32_from_f32(v)
			return b == 0x80000000 ?? (0, b)
		}

		// sameVertex reports whether two vertices are equal in every attribute,
		// positions exactly or on the grid.
		internal def sameVertex(a int, b int, inv float) bool {
			let i = a * 3
			let j = b * 3
			if inv == 0 {
				return false when positions[i] != positions[j] || positions[i + 1] != positions[j + 1] || positions[i + 2] != positions[j + 2]
			} else {
				for let k = 0; k < 3; k++ {
					return false when (float(positions[i + k]) * inv).round() != (float(positions[j + k]) * inv).round()
				}
			}
			return false unless sameRun(normals, a, b, 3)
			return false unless sameRun(tangents, a, b, 4)
			for let (_, set) in uvs {
				return false unless sameRun(set, a, b, 2)
			}
			for let (_, set) in colors {
				return false unless sameRun(set, a, b, 4)
			}
			return false unless sameRun(weights, a, b, 4)
			if joints.len() >= (a.max(b) + 1) * 4 {
				for let k = 0; k < 4; k++ {
					return false when joints[a * 4 + k] != joints[b * 4 + k]
				}
			}
			return true
		}

		// sameRun compares `width` values of an attribute at two vertices;
		// an attribute the primitive does not have is equal everywhere.
		internal def sameRun(attr float32[], a int, b int, width int) bool {
			return true when attr.len() < (a.max(b) + 1) * width
			for let k = 0; k < width; k++ {
				return false when attr[a * width + k] != attr[b * width + k]
			}
			return true
		}

		// gather copies the kept vertices' values of an attribute, `width` per
		// vertex; an empty attribute stays empty.
		internal def gather(attr float32[], keep int[], width int) float32[] {
			return attr when attr.len() == 0
			let out float32[]
			out.len(keep.len() * width)
			for let n = 0; n < keep.len(); n++ {
				let src = keep[n] * width
				let dst = n * width
				for let k = 0; k < width; k++ {
					out[dst + k] = attr[src + k]
				}
			}
			return out
		}

		internal def gatherJoints(attr uint16[], keep int[]) uint16[] {
			return attr when attr.len() == 0
			let out uint16[]
			out.len(keep.len() * 4)
			for let n = 0; n < keep.len(); n++ {
				let src = keep[n] * 4
				for let k = 0; k < 4; k++ {
					out[n * 4 + k] = attr[src + k]
				}
			}
			return out
		}

		// unindexed expands the indices into stored vertices, one per index,
		// and empties `indices`.
		def unindexed() {
			return when indices.len() == 0
			let order int[]
			order.len(indices.len())
			for let k = 0; k < indices.len(); k++ {
				order[k] = int(indices[k])
			}
			positions = gather(positions, order, 3)
			normals = gather(normals, order, 3)
			tangents = gather(tangents, order, 4)
			for let s = 0; s < uvs.len(); s++ {
				uvs[s] = gather(uvs[s], order, 2)
			}
			for let s = 0; s < colors.len(); s++ {
				colors[s] = gather(colors[s], order, 4)
			}
			joints = gatherJoints(joints, order)
			weights = gather(weights, order, 4)
			for let (_, target) in targets {
				target.positions = gather(target.positions, order, 3)
				target.normals = gather(target.normals, order, 3)
				target.tangents = gather(target.tangents, order, 3)
			}
			indices = uint32[]
		}

		// clone is a copy of the primitive with its own attribute arrays; the
		// material is shared.
		def clone() Primitive {
			let out = new Primitive(topology)
			out.material = material
			out.positions = positions.clone()
			out.normals = normals.clone()
			out.tangents = tangents.clone()
			for let (_, set) in uvs {
				out.uvs.push(set.clone())
			}
			for let (_, set) in colors {
				out.colors.push(set.clone())
			}
			out.joints = joints.clone()
			out.weights = weights.clone()
			out.indices = indices.clone()
			for let (_, target) in targets {
				let t = new MorphTarget(target.name)
				t.positions = target.positions.clone()
				t.normals = target.normals.clone()
				t.tangents = target.tangents.clone()
				out.targets.push(t)
			}
			return out
		}

		// triangulated returns the primitive as plain Triangles: strips and fans
		// are unrolled into a copy, points and lines are returned as they are.
		def triangulated() Primitive {
			return self unless topology == Topology.TriangleStrip || topology == Topology.TriangleFan
			let out = clone()
			out.indices = triangleIndices()
			out.topology = Topology.Triangles
			return out
		}

		// transformed returns a copy with positions, normals and tangents taken
		// through the matrix (normals and tangents through its rotation and
		// scale only, normalised again).
		def transformed(m matrix<float, 4, 4>) Primitive {
			let out = clone()
			let p = out.positions
			for let i = 0; i + 2 < p.len(); i += 3 {
				let x = float(p[i])
				let y = float(p[i + 1])
				let z = float(p[i + 2])
				p[i] = float32(m[0][0] * x + m[0][1] * y + m[0][2] * z + m[0][3])
				p[i + 1] = float32(m[1][0] * x + m[1][1] * y + m[1][2] * z + m[1][3])
				p[i + 2] = float32(m[2][0] * x + m[2][1] * y + m[2][2] * z + m[2][3])
			}
			rotateRun(out.normals, m, 3)
			rotateRun(out.tangents, m, 4)
			for let (_, target) in out.targets {
				rotateRun(target.positions, m, 3)
				rotateRun(target.normals, m, 3)
				rotateRun(target.tangents, m, 3)
			}
			return out
		}

		// rotateRun takes `width`-strided direction vectors through the
		// matrix's upper-left 3×3 and normalises them.
		internal def rotateRun(attr float32[], m matrix<float, 4, 4>, width int) {
			for let i = 0; i + 2 < attr.len(); i += width {
				let x = float(attr[i])
				let y = float(attr[i + 1])
				let z = float(attr[i + 2])
				let rx = m[0][0] * x + m[0][1] * y + m[0][2] * z
				let ry = m[1][0] * x + m[1][1] * y + m[1][2] * z
				let rz = m[2][0] * x + m[2][1] * y + m[2][2] * z
				let len = sqrt(rx * rx + ry * ry + rz * rz)
				continue when len == 0
				attr[i] = float32(rx / len)
				attr[i + 1] = float32(ry / len)
				attr[i + 2] = float32(rz / len)
			}
		}
	}

	// Mesh is a named set of primitives drawn together at a node, one per
	// material it uses.
	type Mesh {
		name       string
		primitives Primitive[]

		def new(name string = "") {
			self.name = name
			primitives = Primitive[]
		}

		// add appends the primitive and returns it.
		def add(primitive Primitive) Primitive {
			primitives.push(primitive)
			return primitive
		}

		// bounds is the axis-aligned box around every primitive's positions, in
		// the mesh's own coordinates. None when no primitive has vertices.
		def bounds() ?(Vec3, Vec3) {
			let found ?(Vec3, Vec3)
			for let (_, prim) in primitives {
				let b = prim.bounds()
				continue when b is none
				if found is none {
					found = b
					continue
				}
				let (lo, hi) = found
				let (plo, phi) = b
				found = (new Vec3(lo.x.min(plo.x), lo.y.min(plo.y), lo.z.min(plo.z)), new Vec3(hi.x.max(phi.x), hi.y.max(phi.y), hi.z.max(phi.z)))
			}
			return found
		}

		// triangleCount is the number of triangles over every primitive.
		def triangleCount() int {
			let n = 0
			for let (_, prim) in primitives {
				n += prim.faceCount() when prim.topology == Topology.Triangles || prim.topology == Topology.TriangleStrip || prim.topology == Topology.TriangleFan
			}
			return n
		}

		// vertexCount is the number of stored vertices over every primitive.
		def vertexCount() int {
			let n = 0
			for let (_, prim) in primitives {
				n += prim.vertexCount()
			}
			return n
		}
	}
}
