partial module std.formats.models {
	use (
		std.bytes
		std.io
		std.math::(*)
		std.math.geom::(Quaternion, Vec3)
		std.os
	)

	// Axis names a direction of a model's coordinate system.
	enum Axis {
		X,
		Y,
		Z,
	}

	// Model is a format-neutral 3D scene: a tree of nodes placing meshes,
	// cameras and lights, the materials and textures the meshes use, skins and
	// animations, and the binary resources (texture images, buffers) the file
	// carried. Every codec of this module decodes into a Model and encodes from
	// one, so any format converts to any other; what a format cannot express is
	// simplified or left out by its encoder.
	//
	// Meshes, materials, textures, cameras, lights and skins are owned by the
	// model's lists and referred to by the nodes and primitives that use them,
	// so two nodes may show one mesh and two primitives share one material.
	//
	// Example: Load, inspect and convert
	// ```example
	// use std.formats.models
	//
	// let model = try models.load("robot.glb")
	// print("{model.triangleCount()} triangles in {model.meshes.len()} meshes")
	// try model.save("robot.obj")
	// ```
	type Model {
		name       string
		// Generator, copyright, author and whatever else the source carried.
		metadata   map<string, string>
		// Metres per model unit: 1.0 for metres, 0.001 for millimetres, 0.0254
		// for inches. Formats that state no unit leave 1.0.
		unit       float               = 1.0
		// The axis that points up. glTF, OBJ and FBX files are Y-up; 3DS, DXF,
		// DWG and JT files are Z-up, and their codecs say so here rather than
		// rotating the scene.
		upAxis     Axis                = Axis.Y
		// The root nodes.
		nodes      Node[]
		meshes     Mesh[]
		materials  Material[]
		textures   Texture[]
		cameras    Camera[]
		lights     Light[]
		skins      Skin[]
		animations Animation[]
		// Embedded binary content by name: texture images and buffers, as a
		// Texture refers to them through its source.
		resources  map<string, byte[]>

		def new(name string = "") {
			self.name = name
			metadata = new map<string, string>()
			nodes = Node[]
			meshes = Mesh[]
			materials = Material[]
			textures = Texture[]
			cameras = Camera[]
			lights = Light[]
			skins = Skin[]
			animations = Animation[]
			resources = new map<string, byte[]>()
		}

		// save writes the model to the file with the codec registered for the
		// path's extension; files the format keeps beside the model (buffers,
		// textures, material libraries) go into the same directory. Fails when
		// no codec has the extension, the model cannot be written in it, or
		// writing does.
		def save(path string) !none {
			let out = new bytes.Buffer()
			try write(out, os.extension(path), new DirectoryResources(os.dir(path)))
			return os.writeFile(path, out.bytes())
		}

		// write encodes the model to the writer with the codec registered for the
		// file extension (".glb", ".obj"). With no place for files beside it, a
		// codec embeds what it can and leaves the rest out. Fails when no codec
		// has the extension, the model cannot be written in it, or the writer
		// does.
		def write(writer io.Writer, extension string) !none {
			let enc = codecRegistry.matchExt(extension)
			fail "no model codec has the extension \"{extension}\"" when enc is none
			return enc.encode(self, writer, none)
		}

		// write encodes the model to the writer with the codec registered for the
		// file extension, creating the files the format keeps beside the model
		// through resources. Fails when no codec has the extension, the model
		// cannot be written in it, or writing does.
		def write(writer io.Writer, extension string, resources ResourceWriter) !none {
			let enc = codecRegistry.matchExt(extension)
			fail "no model codec has the extension \"{extension}\"" when enc is none
			return enc.encode(self, writer, resources)
		}

		// walk visits every node in tree order, parents before children, until
		// visit returns false.
		def walk(visit def (Node) bool) {
			for let (_, n) in nodes {
				return unless walkNodes(n, visit)
			}
		}

		// node returns the first node with the name in tree order, none when
		// there is none.
		def node(name string) ?Node {
			let found ?Node
			walk(def (n Node) bool {
				return true when n.name != name
				found = n
				return false
			})
			return found
		}

		// resource returns the embedded content stored under the name, none when
		// there is none.
		def resource(name string) ?byte[] {
			return resources.get(name)
		}

		// bounds is the axis-aligned box around every vertex of every placed
		// mesh, in scene coordinates: its least and greatest corner. None when
		// no node shows a mesh with vertices.
		def bounds() ?(Vec3, Vec3) {
			let found ?(Vec3, Vec3)
			walk(def (n Node) bool {
				let mesh = n.mesh
				return true when mesh is none
				let m = n.worldTransform()
				for let (_, prim) in mesh.primitives {
					let p = prim.positions
					for let i = 0; i + 2 < p.len(); i += 3 {
						let x = float(p[i])
						let y = float(p[i + 1])
						let z = float(p[i + 2])
						let wx = m[0][0] * x + m[0][1] * y + m[0][2] * z + m[0][3]
						let wy = m[1][0] * x + m[1][1] * y + m[1][2] * z + m[1][3]
						let wz = m[2][0] * x + m[2][1] * y + m[2][2] * z + m[2][3]
						if found is none {
							found = (new Vec3(wx, wy, wz), new Vec3(wx, wy, wz))
							continue
						}
						let (lo, hi) = found
						lo.x = lo.x.min(wx)
						lo.y = lo.y.min(wy)
						lo.z = lo.z.min(wz)
						hi.x = hi.x.max(wx)
						hi.y = hi.y.max(wy)
						hi.z = hi.z.max(wz)
					}
				}
				return true
			})
			return found
		}

		// triangleCount is the number of triangles over every mesh, each mesh
		// counted once however many nodes show it.
		def triangleCount() int {
			let n = 0
			for let (_, mesh) in meshes {
				n += mesh.triangleCount()
			}
			return n
		}

		// vertexCount is the number of vertices over every mesh, each mesh
		// counted once.
		def vertexCount() int {
			let n = 0
			for let (_, mesh) in meshes {
				n += mesh.vertexCount()
			}
			return n
		}
	}

	// Node is one place in the scene tree: a transform relative to its parent,
	// what it shows there (a mesh, a camera, a light, none of them for a plain
	// group), and its children.
	type Node {
		name        string
		translation Vec3
		rotation    Quaternion
		scale       Vec3
		children    Node[]
		weak parent ?Node
		mesh        ?Mesh
		camera      ?Camera
		light       ?Light
		// The skin that deforms `mesh`, for a skinned mesh; owned by
		// Model.skins.
		weak skin   ?Skin
		// Morph target weights, one per target of the mesh's primitives; empty
		// for the targets' own default weights.
		weights     float[]
		// Properties the source attached to the node (FBX user properties,
		// glTF extras, DXF extended data), as text.
		metadata    map<string, string>

		def new(name string = "") {
			self.name = name
			translation = new Vec3(0, 0, 0)
			rotation = new Quaternion()
			scale = new Vec3(1, 1, 1)
			children = Node[]
			weights = float[]
			metadata = new map<string, string>()
		}

		// add appends child, sets its parent to this node and returns it.
		def add(child Node) Node {
			child.parent = self
			children.push(child)
			return child
		}

		// transform is the node's transform relative to its parent as a
		// column-major 4×4 matrix: scale, then rotation, then translation.
		// Assigning one sets translation, rotation and scale from it; a shear in
		// the matrix is lost, nodes have none.
		transform matrix<float, 4, 4> {
			def get() matrix<float, 4, 4> {
				let r = rotation.matrix()
				let m = matrix<float, 4, 4>[]
				for let row = 0; row < 3; row++ {
					m[row][0] = r[row][0] * scale.x
					m[row][1] = r[row][1] * scale.y
					m[row][2] = r[row][2] * scale.z
				}
				m[0][3] = translation.x
				m[1][3] = translation.y
				m[2][3] = translation.z
				m[3][3] = 1
				return m
			}

			def set(value matrix<float, 4, 4>) {
				translation = new Vec3(value[0][3], value[1][3], value[2][3])
				let sx = sqrt(value[0][0] * value[0][0] + value[1][0] * value[1][0] + value[2][0] * value[2][0])
				let sy = sqrt(value[0][1] * value[0][1] + value[1][1] * value[1][1] + value[2][1] * value[2][1])
				let sz = sqrt(value[0][2] * value[0][2] + value[1][2] * value[1][2] + value[2][2] * value[2][2])
				// A mirrored basis keeps its handedness in a negative z scale.
				let det = value[0][0] * (value[1][1] * value[2][2] - value[1][2] * value[2][1]) - value[0][1] * (value[1][0] * value[2][2] - value[1][2] * value[2][0]) + value[0][2] * (value[1][0] * value[2][1] - value[1][1] * value[2][0])
				sz = -sz when det < 0
				scale = new Vec3(sx, sy, sz)
				rotation = new Quaternion(value)
			}
		}

		// worldTransform is the node's transform relative to the scene: the
		// product of its ancestors' transforms and its own.
		def worldTransform() matrix<float, 4, 4> {
			let p = parent
			return transform when p is none
			return p.worldTransform() * transform
		}

		// walk visits this node and every node below it in tree order, parents
		// before children, until visit returns false.
		def walk(visit def (Node) bool) {
			walkNodes(self, visit)
		}
	}

	// walkNodes visits the node and those below it, parents before children,
	// and reports whether the visit went on to the end.
	internal def walkNodes(node Node, visit def (Node) bool) bool {
		return false unless visit(node)
		for let (_, child) in node.children {
			return false unless walkNodes(child, visit)
		}
		return true
	}
}
