partial module std.formats.models {
	use (
		std.bytes
		std.math.geom::(Quaternion, Vec3)
		std.testing
	)

	check "Models" {
		// The extension of the codec whose signature the bytes carry, empty
		// when none claims them.
		def claimant(data byte[]) string {
			let found = sniff(new bytes.Reader(data)) onerror recover none
			return "" when found is none
			let (codec, _) = found
			return codec.extension[0]
		}

		@test()
		def TestExtensions() {
			assert codecRegistry.matchExt(".gltf") is Gltf
			assert codecRegistry.matchExt("GLB") is Glb
			assert codecRegistry.matchExt(".obj") is Obj
			assert codecRegistry.matchExt(".stl") is Stl
			assert codecRegistry.matchExt(".ply") is Ply
			assert codecRegistry.matchExt(".fbx") is Fbx
			assert codecRegistry.matchExt(".3ds") is ThreeDS
			assert codecRegistry.matchExt(".dxf") is Dxf
			assert codecRegistry.matchExt(".dwg") is Dwg
			assert codecRegistry.matchExt(".jt") is Jt
			assert codecRegistry.matchExt(".xyz") is none
		}

		@test()
		def TestSignatures() {
			assert claimant(byte[0x67, 0x6C, 0x54, 0x46, 2, 0, 0, 0]) == ".glb"
			assert claimant("ply\nformat ascii 1.0\n".bytes()) == ".ply"
			assert claimant("ply\r\nformat binary_little_endian 1.0\r\n".bytes()) == ".ply"
			assert claimant("solid cube\n  facet normal 0 0 1\n".bytes()) == ".stl"
			assert claimant("Kaydara FBX Binary  ".bytes() + byte[0]) == ".fbx"
			assert claimant("; FBX 7.4.0 project file\n".bytes()) == ".fbx"
			assert claimant(byte[0x4D, 0x4D, 0x10, 0x00, 0x00, 0x00]) == ".3ds"
			assert claimant("AC1032\x00\x00".bytes()) == ".dwg"
			assert claimant("  0\nSECTION\n  2\nHEADER\n".bytes()) == ".dxf"
			assert claimant("AutoCAD Binary DXF\r\n".bytes()) == ".dxf"
			assert claimant("Version 10.5 JT  \n".bytes()) == ".jt"
			// Text with no signature belongs to no codec.
			assert claimant("v 1 2 3\nf 1 2 3\n".bytes()) == ""
			assert claimant("hello".bytes()) == ""
		}

		@test()
		def TestLoadRefusesUnknown() {
			let refused = false
			load("not a model".bytes()) onerror (err error) {
				refused = true
				recover new Model()
			}
			assert refused
		}

		@test()
		def TestTree() {
			let model = new Model("scene")
			let root = new Node("root")
			model.nodes.push(root)
			let child = root.add(new Node("child"))
			assert root.children.len() == 1
			assert child.parent is Node
			let mesh = new Mesh("cube")
			let prim = mesh.add(new Primitive())
			prim.positions = float32[0, 0, 0, 1, 0, 0, 0, 1, 0]
			assert prim.vertexCount() == 3
			assert prim.indexCount() == 3
			assert prim.position(1).x == 1.0
			model.meshes.push(mesh)
			child.mesh = mesh
			assert model.meshes.len() == 1
			let skin = new Skin("rig")
			assert skin.inverseBindMatrices.len() == 0
		}

		def near(a float, b float) bool {
			return (a - b).abs() < 1e-6
		}

		@test()
		def TestCameraProjection() {
			let cam = new Camera("eye")
			cam.yfov = 1.5707963267948966
			cam.aspect = 2.0
			cam.znear = 1.0
			cam.zfar = 3.0
			let m = cam.projection()
			// f = 1/tan(45°) = 1: x scaled by 1/aspect, y by 1.
			assert near(m[0][0], 0.5) && near(m[1][1], 1.0) && m[3][2] == -1 && m[3][3] == 0
			// The near plane maps to -1 and the far plane to 1.
			let nearZ = (m[2][2] * -1.0 + m[2][3]) / (m[3][2] * -1.0)
			let farZ = (m[2][2] * -3.0 + m[2][3]) / (m[3][2] * -3.0)
			assert near(nearZ, -1.0) && near(farZ, 1.0)
			// A viewport aspect stands in when the camera has none.
			cam.aspect = 0
			assert near(cam.projection(4.0)[0][0], 0.25) && near(cam.projection()[0][0], 1.0)
			// An infinite far plane still maps the near plane to -1.
			cam.zfar = 0
			let inf = cam.projection()
			assert near((inf[2][2] * -1.0 + inf[2][3]) / 1.0, -1.0)
			let ortho = new Camera("plan", CameraKind.Orthographic)
			ortho.xmag = 2
			ortho.ymag = 4
			ortho.znear = 0
			ortho.zfar = 10
			let o = ortho.projection()
			assert near(o[0][0], 0.5) && near(o[1][1], 0.25) && o[3][3] == 1
			assert near(o[2][2] * -10.0 + o[2][3], 1.0) && near(o[2][3], -1.0)
		}

		@test()
		def TestAnimation() {
			let node = new Node("n")
			let move = new Channel(node, AnimationPath.Translation)
			move.times = float32[0, 1, 3]
			move.values = float32[0, 0, 0, 2, 0, 0, 2, 4, 0]
			assert move.duration() == 3 && move.valueCount() == 3
			let v float32[]
			move.sample(0.5, v)
			assert v.len() == 3 && v[0] == 1 && v[1] == 0
			move.sample(2, v)
			assert v[0] == 2 && v[1] == 2
			// Before the first key and after the last the ends hold.
			move.sample(-1, v)
			assert v[0] == 0
			move.sample(9, v)
			assert v[0] == 2 && v[1] == 4
			move.interpolation = Interpolation.Step
			move.sample(2.9, v)
			assert v[0] == 2 && v[1] == 0
			// A rotation goes along the arc: half way between the identity and a
			// quarter turn about y is an eighth of a turn.
			let turn = new Channel(node, AnimationPath.Rotation)
			turn.times = float32[0, 2]
			turn.values = float32[0, 0, 0, 1, 0, 0.7071068, 0, 0.7071068]
			let q float32[]
			turn.sample(1, q)
			assert q.len() == 4 && near(float(q[1]), 0.3826834) && near(float(q[3]), 0.9238795)
			// Cubic spline: zero tangents give the key values at the keys and a
			// smooth step between them.
			let weights = new Channel(node, AnimationPath.Weights)
			weights.interpolation = Interpolation.CubicSpline
			weights.times = float32[0, 1]
			weights.values = float32[0, 0, 0, 0, 1, 0]
			assert weights.valueCount() == 1
			let w float32[]
			weights.sample(0, w)
			assert w[0] == 0
			weights.sample(0.5, w)
			assert near(float(w[0]), 0.5)
			weights.sample(1, w)
			assert w[0] == 1
			let anim = new Animation("a")
			anim.channels.push(move, turn, weights)
			assert anim.duration() == 3
			anim.apply(1)
			assert node.translation.x == 2 && node.translation.y == 0
			assert near(node.rotation.y, 0.3826834)
			assert node.weights.len() == 1 && node.weights[0] == 1
		}

		@test()
		def TestJointMatrices() {
			// A skinned node at x = 10 with a joint moved up by 2 from a bind
			// pose at the origin: a bind-pose vertex moves up by 2, in the
			// skinned node's own coordinates.
			let skinned = new Node("mesh")
			skinned.translation = new Vec3(10, 0, 0)
			let root = new Node("root")
			let joint = root.add(new Node("joint"))
			joint.translation = new Vec3(0, 2, 0)
			let skin = new Skin("rig")
			skin.joints.push(joint)
			let ibm = matrix<float, 4, 4>[]
			for let k = 0; k < 4; k++ {
				ibm[k][k] = 1
			}
			skin.inverseBindMatrices.push(ibm)
			let ms = skin.jointMatrices(skinned)
			assert ms.len() == 1
			let m = ms[0]
			assert near(m[0][3], -10.0) && near(m[1][3], 2.0) && near(m[2][3], 0.0) && near(m[0][0], 1.0)
			// A rotated, scaled skinned node is inverted exactly.
			skinned.rotation = new Quaternion(new Vec3(0, 0, 1), 1.0)
			skinned.scale = new Vec3(2, 2, 2)
			let back = skinned.worldTransform() * skin.jointMatrices(skinned)[0]
			assert near(back[1][3], 2.0) && near(back[0][3], 0.0) && near(back[0][0], 1.0) && near(back[1][0], 0.0)
		}
	}
}
