partial module std.formats.models {
	use (
		std.formats.models.obj::*
		std.io
	)

	// Obj is Wavefront OBJ: text geometry (positions, normals, texture
	// coordinates, polygon faces, lines, points, groups and objects) with its
	// materials in a `.mtl` library named by `mtllib`. Reads polygons of any
	// size (triangulated), negative indices, groups and objects as nodes, and
	// the material library and its textures through the ResourceReader; writes
	// every mesh as an object with its material, and the library beside it.
	// Smoothing groups and free-form curves and surfaces are left out.
	@codec("Wavefront OBJ")
	type Obj {
		// Name of the material library written beside the model and named by
		// `mtllib`; empty writes no materials.
		materialLibrary string = "materials.mtl"

		mimeType string[] {
			def get() string[] {
				return string["model/obj"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".obj"]
			}
		}

		// matchSignature is always false: OBJ is text with no signature, so it
		// is found by its file extension.
		def matchSignature(r io.Reader) bool {
			return false
		}

		// decode reads the whole reader as OBJ. A `mtllib` the resources cannot
		// open leaves the materials as names only. Fails with a ModelError when
		// a line is malformed or an index is out of range, or with the reader's
		// own error.
		def decode(reader io.Reader, resources ?ResourceReader) !Model {
			let data = try io.readAll(reader)
			return objDecode(data, resources)
		}

		// encode writes the model as OBJ, with its materials in the library
		// through resources and no `mtllib` without one. Fails with the
		// writer's own error, or the library file's.
		def encode(model Model, writer io.Writer, resources ?ResourceWriter) !none {
			return objEncode(model, writer, resources, materialLibrary)
		}

		// decodeMaterials reads a `.mtl` library on its own into the model's
		// materials and textures, as decode does for the one `mtllib` names.
		// Fails with a ModelError when a line is malformed, or with the
		// reader's own error.
		def decodeMaterials(reader io.Reader, model Model) !none {
			let data = try io.readAll(reader)
			return objDecodeMaterials(data, model, none, "", new map<string, Texture>())
		}

		// encodeMaterials writes the model's materials as a `.mtl` library on
		// its own. Fails with the writer's own error.
		def encodeMaterials(model Model, writer io.Writer) !none {
			return objEncodeMaterials(model, writer, objMaterialNames(model))
		}
	}
}
