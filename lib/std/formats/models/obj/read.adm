internal partial module std.formats.models.obj {
	use (
		std.bytes
		std.formats.models::*
		std.formats.models.text::*
		std.gfx.color
		std.io
		std.math::(sqrt)
		std.math.geom::(Point, Polygon)
	)

	const objFormat = "Wavefront OBJ"

	// Bytes per parsing chunk, and the most chunks a file is split into.
	const objChunkBytes = 262144
	const objMaxChunks = 16

	// Element kinds in a chunk's record stream.
	const objFace = 0
	const objLine = 1
	const objPoint = 2

	// Events in a chunk, in the order of the file.
	const objEventObject = 0
	const objEventGroup = 1
	const objEventMaterial = 2
	const objEventLibrary = 3

	// objDecode reads the text as OBJ: the lines are parsed in chunks on
	// tasks, then the elements are joined into one primitive per object or
	// group, material and topology, with a vertex per distinct
	// position/texture/normal triple.
	def objDecode(data byte[], resources ?ResourceReader) !Model {
		let text = objText(data)
		let chunks = objSplit(text)
		if chunks.len() == 1 {
			chunks[0].parse()
		} else {
			let group = new AsyncScope()
			for let (_, chunk) in chunks {
				async<group> chunk.parse()
			}
			try group.wait()
		}
		for let (_, chunk) in chunks {
			let err = chunk.error
			continue when err is none
			fail ModelError{message: err.message, format: objFormat, detail: "line {chunk.fileLine(chunk.errorLine)}"}
		}
		let geometry = objJoin(chunks)
		let model = new Model()
		let build = new ObjBuild(model, geometry)
		for let (_, chunk) in chunks {
			for let e = 0; e < chunk.eventKind.len(); e++ {
				continue unless chunk.eventKind[e] == objEventLibrary
				try build.readLibrary(chunk.eventName[e], resources)
			}
		}
		for let (_, chunk) in chunks {
			try build.chunk(chunk)
		}
		build.pointCloud() when model.meshes.len() == 0
		return model
	}

	// objText is the file as UTF-8: a UTF-16 file (by its byte order mark)
	// is converted, a UTF-8 byte order mark dropped.
	def objText(data byte[]) byte[] {
		return data when data.len() < 2
		let b0 = int(data[0])
		let b1 = int(data[1])
		return data.utf16(bytes.Endian.Big).bytes() when (b0 == 0xFE && b1 == 0xFF) || (b0 == 0xFF && b1 == 0xFE)
		return data[3:] when data.len() >= 3 && b0 == 0xEF && b1 == 0xBB && int(data[2]) == 0xBF
		return data
	}

	// objSplit cuts the text into chunks at line starts, one per
	// objChunkBytes up to objMaxChunks.
	def objSplit(data byte[]) ObjChunk[] {
		let count = (data.len() / objChunkBytes).clamp(1, objMaxChunks)
		let chunks ObjChunk[]
		let start = 0
		for let b = 0; b < count && start < data.len(); b++ {
			let end = b + 1 == count ?? (data.len(), objLineStart(data, data.len() * (b + 1) / count))
			end = data.len() when end < start
			chunks.push(new ObjChunk(data, start, end, chunks.len()))
			start = end
		}
		chunks.push(new ObjChunk(data, 0, data.len(), 0)) when chunks.len() == 0
		return chunks
	}

	// objLineStart is the first start of a logical line at or after `at`: a
	// position after a newline that no `\` continues, or the text's end.
	def objLineStart(data byte[], at int) int {
		let p = at
		for {
			return 0 when p == 0
			if data[p - 1] != 0x0A {
				for p < data.len() && data[p] != 0x0A {
					p++
				}
				return data.len() when p >= data.len()
				p++
			}
			return data.len() when p >= data.len()
			let q = p - 2
			q-- when q > 0 && data[q] == 0x0D
			return p when q < 0 || data[q] != 0x5C
			// The line before ends with `\`: this is its continuation.
			p++
		}
	}

	// ObjChunk parses the lines of one part of the file: the vertex
	// attributes it declares, its elements as raw index triples, and the
	// object, group, material and library statements in order.
	type ObjChunk {
		data         byte[]
		start        int
		end          int
		positions    float32[]
		colors       float32[]
		colored      bool        = false
		uvs          float32[]
		normals      float32[]
		// Per element: kind, corner count, the chunk's v, vt and vn counts
		// before it (for negative indices), then 3 raw indices per corner, 0
		// for an absent vt or vn.
		elements     int[]
		elementCount int         = 0
		// Statements, with the index of the element they precede.
		eventAt      int[]
		eventKind    int[]
		eventName    string[]
		// The chunk's position in the file's list of chunks.
		index        int         = 0
		// Per element, the line it is on, within the chunk.
		elementLine  int[]
		error        ?ModelError
		errorLine    int         = 0
		// Lines before the chunk's start, counted when first needed.
		lineBase     int         = -1

		def new(data byte[], start int, end int, index int) {
			self.data = data
			self.start = start
			self.end = end
			self.index = index
			elementLine = int[]
			positions = float32[]
			colors = float32[]
			uvs = float32[]
			normals = float32[]
			elements = int[]
			eventAt = int[]
			eventKind = int[]
			eventName = string[]
		}

		// parse reads the chunk's lines; a malformed line is recorded in
		// `error` with its line within the chunk.
		def parse() {
			let s = new TextScanner(data, objFormat, "obj")
			s.pos = start
			parseLines(s) onerror (err error) {
				if err is ModelError {
					error = err
				} else {
					error = ModelError{message: err.message, format: objFormat}
				}
				errorLine = s.line
				recover none
			}
		}

		def parseLines(s TextScanner) !none {
			for s.pos < end {
				if s.atLineEnd() {
					s.skipLine()
					continue
				}
				let key = s.token()
				match key {
					case "v":
						try vertex(s)
					case "vt":
						try texcoord(s)
					case "vn":
						try normal(s)
					case "f":
						try element(s, objFace, 3)
					case "l":
						try element(s, objLine, 2)
					case "p":
						try element(s, objPoint, 1)
					case "o":
						event(objEventObject, s.restOfLine())
					case "g":
						event(objEventGroup, s.restOfLine())
					case "usemtl":
						event(objEventMaterial, s.restOfLine())
					case "mtllib":
						event(objEventLibrary, s.restOfLine())
					default:
						// `s`, `vp`, free-form geometry and vendor statements.
						s.skipLine()
				}
			}
			return none
		}

		def value(s TextScanner, key string) !float32 {
			let v = try s.lineNumber()
			fail ModelError{message: "obj: `{key}` has too few values", format: objFormat} when v is none
			return v
		}

		def endLine(s TextScanner, key string) !none {
			fail ModelError{message: "obj: `{key}` has more values than it takes", format: objFormat} unless s.atLineEnd()
			s.skipLine()
			return none
		}

		// vertex reads `v x y z [w]` or `v x y z r g b [a]`.
		def vertex(s TextScanner) !none {
			positions.push(try value(s, "v"))
			positions.push(try value(s, "v"))
			positions.push(try value(s, "v"))
			let extra float32[]
			for extra.len() < 4 {
				let e = try s.lineNumber()
				break when e is none
				extra.push(e)
			}
			fail ModelError{message: "obj: `v` has 5 values; it takes 3, 4 (with w) or 6 (with a colour)", format: objFormat} when extra.len() == 2
			try endLine(s, "v")
			let count = positions.len() / 3
			if extra.len() >= 3 {
				if !colored {
					colored = true
					colors.len((count - 1) * 4)
					colors.fill(1.0)
				}
				colors.push(extra[0])
				colors.push(extra[1])
				colors.push(extra[2])
				colors.push(extra.len() == 4 ?? (extra[3], float32(1.0)))
			} else {
				if colored {
					for let k = 0; k < 4; k++ {
						colors.push(1.0)
					}
				}
			}
			return none
		}

		// texcoord reads `vt u [v [w]]`, flipping v so 0 is the top.
		def texcoord(s TextScanner) !none {
			let u = try value(s, "vt")
			let v = try s.lineNumber()
			let flipped float32 = 1.0
			if !(v is none) {
				flipped = 1.0 - v
				let w = try s.lineNumber()
			}
			try endLine(s, "vt")
			uvs.push(u)
			uvs.push(flipped)
			return none
		}

		def normal(s TextScanner) !none {
			normals.push(try value(s, "vn"))
			normals.push(try value(s, "vn"))
			normals.push(try value(s, "vn"))
			try endLine(s, "vn")
			return none
		}

		// element reads the corners of an `f`, `l` or `p` line as raw
		// v[/vt[/vn]] triples.
		def element(s TextScanner, kind int, least int) !none {
			let header = elements.len()
			elementLine.push(s.line)
			elements.push(kind)
			elements.push(0)
			elements.push(positions.len() / 3)
			elements.push(uvs.len() / 2)
			elements.push(normals.len() / 3)
			let n = 0
			for !s.atLineEnd() {
				let v = try s.integer()
				let vt = 0
				let vn = 0
				if s.pos < data.len() && data[s.pos] == 0x2F {
					s.pos++
					if s.pos < data.len() && data[s.pos] == 0x2F {
						s.pos++
						vn = try s.integer()
					} else {
						vt = try s.integer()
						if s.pos < data.len() && data[s.pos] == 0x2F {
							s.pos++
							vn = try s.integer()
						}
					}
				}
				let c = s.pos < data.len() ?? (data[s.pos], byte(0x20))
				fail ModelError{message: "obj: malformed index `{objTokenAt(data, s.pos)}`", format: objFormat} unless s.isSpace(c) || c == 0x23
				fail ModelError{message: "obj: index 0; OBJ indices count from 1", format: objFormat} when v == 0
				elements.push(v)
				elements.push(vt)
				elements.push(vn)
				n++
			}
			let word = kind == objFace ?? ("f", kind == objLine ?? ("l", "p"))
			fail ModelError{message: "obj: `{word}` has {n} vertices; it needs at least {least}", format: objFormat} when n < least
			elements[header + 1] = n
			s.skipLine()
			elementCount++
			return none
		}

		// fileLine is the file's line number for a line of the chunk.
		def fileLine(local int) int {
			if lineBase < 0 {
				lineBase = 0
				for let i = 0; i < start; i++ {
					lineBase++ when data[i] == 0x0A
				}
			}
			return lineBase + local
		}

		def event(kind int, name string) {
			eventAt.push(elementCount)
			eventKind.push(kind)
			eventName.push(name)
		}
	}

	// objTokenAt is the text from `at` to the end of its token, for a
	// message.
	def objTokenAt(data byte[], at int) string {
		let end = at
		for end < data.len() && data[end] != 0x20 && data[end] != 0x09 && data[end] != 0x0A && data[end] != 0x0D {
			end++
		}
		return string(data[at:end])
	}

	// ObjGeometry is the file's vertex attributes joined over the chunks,
	// with each chunk's offsets into them.
	type ObjGeometry {
		positions float32[]
		colors    float32[]
		uvs       float32[]
		normals   float32[]
		vOffset   int[]
		vtOffset  int[]
		vnOffset  int[]

		def new() {
			positions = float32[]
			colors = float32[]
			uvs = float32[]
			normals = float32[]
			vOffset = int[]
			vtOffset = int[]
			vnOffset = int[]
		}
	}

	def objJoin(chunks ObjChunk[]) ObjGeometry {
		let g = new ObjGeometry()
		let v = 0
		let vt = 0
		let vn = 0
		let colored = false
		for let (_, c) in chunks {
			g.vOffset.push(v)
			g.vtOffset.push(vt)
			g.vnOffset.push(vn)
			v += c.positions.len() / 3
			vt += c.uvs.len() / 2
			vn += c.normals.len() / 3
			colored = colored || c.colored
		}
		g.positions.len(v * 3)
		g.uvs.len(vt * 2)
		g.normals.len(vn * 3)
		g.colors.len(v * 4) when colored
		for let (b, c) in chunks {
			objCopy(c.positions, g.positions, g.vOffset[b] * 3)
			objCopy(c.uvs, g.uvs, g.vtOffset[b] * 2)
			objCopy(c.normals, g.normals, g.vnOffset[b] * 3)
			continue unless colored
			let at = g.vOffset[b] * 4
			if c.colored {
				objCopy(c.colors, g.colors, at)
			} else {
				let end = at + (c.positions.len() / 3) * 4
				for let i = at; i < end; i++ {
					g.colors[i] = 1.0
				}
			}
		}
		return g
	}

	def objCopy(from float32[], to float32[], at int) {
		for let i = 0; i < from.len(); i++ {
			to[at + i] = from[i]
		}
	}

	// ObjPrimitive builds one primitive: a vertex per distinct corner
	// triple, found through an open-addressing table.
	type ObjPrimitive {
		prim      Primitive
		// The primitive's attribute arrays, held here so a corner's insert
		// reads no property; `uv` and `colors` join the primitive's sets when
		// first needed.
		positions float32[]
		normals   float32[]
		uv        float32[]
		colors    float32[]
		indices   uint32[]
		keyV      int[]
		keyT      int[]
		keyN      int[]
		// Vertex index + 1 per slot, 0 for an empty one.
		table     int[]
		mask      int
		hasUv     bool      = false
		hasNormal bool      = false
		colored   bool      = false

		def new(topology Topology, material ?Material, colored bool) {
			prim = new Primitive(topology)
			prim.material = material
			positions = prim.positions
			normals = prim.normals
			indices = prim.indices
			uv = float32[]
			colors = float32[]
			self.colored = colored
			prim.colors.push(colors) when colored
			keyV = int[]
			keyT = int[]
			keyN = int[]
			table = int[]
			table.len(64)
			mask = 63
		}

		// vertex is the index of the vertex for the corner, added when new.
		def vertex(v int, t int, n int, g ObjGeometry) int {
			let h = objCornerHash(v, t, n)
			let slot = int(h & uint64(mask))
			for {
				let held = table[slot]
				if held == 0 {
					break
				}
				let i = held - 1
				return i when keyV[i] == v && keyT[i] == t && keyN[i] == n
				slot = (slot + 1) & mask
			}
			let index = keyV.len()
			table[slot] = index + 1
			keyV.push(v)
			keyT.push(t)
			keyN.push(n)
			positions.push(g.positions[v * 3])
			positions.push(g.positions[v * 3 + 1])
			positions.push(g.positions[v * 3 + 2])
			if colored {
				colors.push(g.colors[v * 4])
				colors.push(g.colors[v * 4 + 1])
				colors.push(g.colors[v * 4 + 2])
				colors.push(g.colors[v * 4 + 3])
			}
			if t >= 0 {
				if !hasUv {
					hasUv = true
					uv.len(index * 2)
					prim.uvs.push(uv)
				}
				uv.push(g.uvs[t * 2])
				uv.push(g.uvs[t * 2 + 1])
			} else if hasUv {
				uv.push(0)
				uv.push(0)
			}
			if n >= 0 {
				if !hasNormal {
					hasNormal = true
					normals.len(index * 3)
				}
				normals.push(g.normals[n * 3])
				normals.push(g.normals[n * 3 + 1])
				normals.push(g.normals[n * 3 + 2])
			} else if hasNormal {
				normals.push(0)
				normals.push(0)
				normals.push(0)
			}
			grow() when (index + 1) * 2 > table.len()
			return index
		}

		internal def grow() {
			let size = table.len() * 2
			let next int[]
			next.len(size)
			let m = size - 1
			for let i = 0; i < keyV.len(); i++ {
				let slot = int(objCornerHash(keyV[i], keyT[i], keyN[i]) & uint64(m))
				for next[slot] != 0 {
					slot = (slot + 1) & m
				}
				next[slot] = i + 1
			}
			table = next
			mask = m
		}
	}

	def objCornerHash(v int, t int, n int) uint64 {
		let h = uint64(v) * 0x9E3779B97F4A7C15 ^ uint64(t + 1) * 0xC2B2AE3D27D4EB4F ^ uint64(n + 1) * 0x165667B19E3779F9
		h ^= h >> 29
		h *= 0xBF58476D1CE4E5B9
		h ^= h >> 32
		return h
	}

	// ObjTarget is where elements go: a node, its mesh once an element
	// needs one, and the primitives in the making by material and kind.
	type ObjTarget {
		node     Node
		mesh     ?Mesh
		builders map<string, ObjPrimitive>

		def new(node Node) {
			self.node = node
			builders = new map<string, ObjPrimitive>()
		}
	}

	// ObjBuild joins the chunks' elements into the model.
	type ObjBuild {
		model          Model
		g              ObjGeometry
		targets        map<string, ObjTarget>
		object         ?ObjTarget
		objectName     string                 = ""
		current        ?ObjTarget
		material       ?Material
		materialIndex  int                    = -1
		materialByName map<string, Material>
		materialAt     map<string, int>
		textures       map<string, Texture>
		// Scratch per element: the corners' global indices.
		cv             int[]
		ct             int[]
		cn             int[]
		// The builder of the last element, reused while the target, material
		// and kind stay the same.
		lastBuilder    ?ObjPrimitive
		lastKind       int                    = -1
		lastMaterial   int                    = -1
		lastTarget     ?ObjTarget

		def new(model Model, g ObjGeometry) {
			self.model = model
			self.g = g
			targets = new map<string, ObjTarget>()
			materialByName = new map<string, Material>()
			materialAt = new map<string, int>()
			textures = new map<string, Texture>()
			cv = int[]
			ct = int[]
			cn = int[]
		}

		// library reads a `mtllib` through the resources; one that cannot be
		// opened leaves its materials as names only.
		def readLibrary(name string, resources ?ResourceReader) !none {
			return none when resources is none
			let names = string[name]
			let opened = objOpen(resources, name)
			names = name.split(" ").filter(s => s.len() > 0) when opened is none && name.contains(" ")
			for let (_, lib) in names {
				let r = opened
				r = objOpen(resources, lib) when r is none
				continue when r is none
				let data = try io.readAll(r)
				objClose(r)
				let dir = objDir(lib)
				try objDecodeMaterials(data, model, resources, dir, textures)
			}
			for let (i, m) in model.materials {
				materialByName.set(m.name, m)
				materialAt.set(m.name, i)
			}
			return none
		}

		def target(key string, node Node) ObjTarget {
			let t = targets.get(key)
			return t unless t is none
			let made = new ObjTarget(node)
			targets.set(key, made)
			return made
		}

		def statement(kind int, name string) {
			switch kind {
				case objEventObject:
					let key = "o:" + name
					let t = targets.get(key)
					if t is none {
						let node = new Node(name)
						model.nodes.push(node)
						t = target(key, node)
					}
					object = t
					objectName = name
					current = t
				case objEventGroup:
					let key = "g:" + objectName + "/" + name
					let t = targets.get(key)
					if t is none {
						let node = new Node(name)
						let parent = object
						if parent is none {
							model.nodes.push(node)
						} else {
							parent.node.add(node)
						}
						t = target(key, node)
					}
					current = t
				case objEventMaterial:
					let m = materialByName.get(name)
					if m is none {
						let made = objNewMaterial(name)
						materialAt.set(name, model.materials.len())
						model.materials.push(made)
						materialByName.set(name, made)
						m = made
					}
					material = m
					let at = materialAt.get(name)
					materialIndex = at is none ?? (-1, at)
				default:
			}
		}

		// place is the target elements go to now: the current object or
		// group, else a node named after the model or `default`.
		def place() ObjTarget {
			let t = current
			return t unless t is none
			let name = model.name.len() > 0 ?? (model.name, "default")
			let node = new Node(name)
			model.nodes.push(node)
			let made = target("o:", node)
			current = made
			return made
		}

		def builder(kind int) ObjPrimitive {
			let t = place()
			let last = lastBuilder
			let lt = lastTarget
			if !(last is none) && !(lt is none) && lt == t && lastKind == kind && lastMaterial == materialIndex {
				return last
			}
			let found = findBuilder(t, kind)
			lastBuilder = found
			lastKind = kind
			lastMaterial = materialIndex
			lastTarget = t
			return found
		}

		def findBuilder(t ObjTarget, kind int) ObjPrimitive {
			let key = "{kind}:{materialIndex}"
			let b = t.builders.get(key)
			return b unless b is none
			let topology = kind == objFace ?? (Topology.Triangles, kind == objLine ?? (Topology.Lines, Topology.Points))
			let made = new ObjPrimitive(topology, material, g.colors.len() > 0)
			t.builders.set(key, made)
			let mesh = t.mesh
			if mesh is none {
				let m = new Mesh(t.node.name)
				model.meshes.push(m)
				t.node.mesh = m
				t.mesh = m
				m.add(made.prim)
			} else {
				mesh.add(made.prim)
			}
			return made
		}

		// chunk replays the chunk's statements and elements in order.
		def chunk(c ObjChunk) !none {
			let e = 0
			let at = 0
			let vCount = g.positions.len() / 3
			let vtCount = g.uvs.len() / 2
			let vnCount = g.normals.len() / 3
			for let index = 0; index < c.elementCount; index++ {
				for e < c.eventKind.len() && c.eventAt[e] <= index {
					statement(c.eventKind[e], c.eventName[e])
					e++
				}
				let kind = c.elements[at]
				let n = c.elements[at + 1]
				let vBase = g.vOffset[c.index] + c.elements[at + 2]
				let vtBase = g.vtOffset[c.index] + c.elements[at + 3]
				let vnBase = g.vnOffset[c.index] + c.elements[at + 4]
				at += 5
				cv.len(n)
				ct.len(n)
				cn.len(n)
				for let k = 0; k < n; k++ {
					let v = c.elements[at]
					let t = c.elements[at + 1]
					let nn = c.elements[at + 2]
					at += 3
					cv[k] = v < 0 ?? (vBase + v, v - 1)
					fail ModelError{message: "obj: vertex index {v} is out of range; the file has {vCount} vertices", format: objFormat, detail: "line {c.fileLine(c.elementLine[index])}"} when cv[k] < 0 || cv[k] >= vCount
					ct[k] = t == 0 ?? (-1, t < 0 ?? (vtBase + t, t - 1))
					fail ModelError{message: "obj: texture coordinate index {t} is out of range; the file has {vtCount}", format: objFormat, detail: "line {c.fileLine(c.elementLine[index])}"} when ct[k] < -1 || ct[k] >= vtCount
					cn[k] = nn == 0 ?? (-1, nn < 0 ?? (vnBase + nn, nn - 1))
					fail ModelError{message: "obj: normal index {nn} is out of range; the file has {vnCount}", format: objFormat, detail: "line {c.fileLine(c.elementLine[index])}"} when cn[k] < -1 || cn[k] >= vnCount
				}
				let b = builder(kind)
				switch kind {
					case objFace:
						face(b, n)
					case objLine:
						for let k = 0; k + 1 < n; k++ {
							b.indices.push(uint32(b.vertex(cv[k], ct[k], cn[k], g)))
							b.indices.push(uint32(b.vertex(cv[k + 1], ct[k + 1], cn[k + 1], g)))
						}
					default:
						for let k = 0; k < n; k++ {
							b.indices.push(uint32(b.vertex(cv[k], ct[k], cn[k], g)))
						}
				}
			}
			for e < c.eventKind.len() {
				statement(c.eventKind[e], c.eventName[e])
				e++
			}
			return none
		}

		// pointCloud takes every vertex of a file that has no elements as a
		// point, with its normal when the file has one per vertex, as point
		// cloud writers put them.
		def pointCloud() {
			let count = g.positions.len() / 3
			return when count == 0
			let b = builder(objPoint)
			let prim = b.prim
			prim.positions = g.positions
			prim.colors = float32[][]
			prim.colors.push(g.colors) when g.colors.len() == count * 4
			prim.normals = g.normals when g.normals.len() == count * 3
			prim.uvs.push(g.uvs) when g.uvs.len() == count * 2
		}

		// face adds the polygon's triangles: a fan when it is convex, ear
		// clipping in its own plane otherwise.
		def face(b ObjPrimitive, n int) {
			let indices = b.indices
			if n == 3 {
				for let k = 0; k < 3; k++ {
					indices.push(uint32(b.vertex(cv[k], ct[k], cn[k], g)))
				}
				return
			}
			let corners = objTriangles(g.positions, cv, n)
			for let k = 0; k < corners.len(); k++ {
				let c = corners[k]
				indices.push(uint32(b.vertex(cv[c], ct[c], cn[c], g)))
			}
		}
	}

	// objNewMaterial is a material as OBJ has it before any statement: a
	// dielectric, fully rough until `Ns` or `Pr` says otherwise.
	def objNewMaterial(name string) Material {
		let m = new Material(name)
		m.metallic = 0.0
		m.roughness = 1.0
		return m
	}

	// objRoughness is the roughness Blender reads from a specular exponent.
	def objRoughness(shininess float) float {
		return 1.0 - sqrt(shininess.clamp(0.0, 1000.0) / 1000.0)
	}

	// objTriangles cuts a polygon of n corners (positions by cv) into
	// triangles, as corner index triples.
	def objTriangles(positions float32[], cv int[], n int) int[] {
		// Newell's normal, and whether every corner turns the same way.
		let nx = 0.0
		let ny = 0.0
		let nz = 0.0
		for let i = 0; i < n; i++ {
			let a = cv[i] * 3
			let b = cv[(i + 1) % n] * 3
			let ax = float(positions[a])
			let ay = float(positions[a + 1])
			let az = float(positions[a + 2])
			let bx = float(positions[b])
			let by = float(positions[b + 1])
			let bz = float(positions[b + 2])
			nx += (ay - by) * (az + bz)
			ny += (az - bz) * (ax + bx)
			nz += (ax - bx) * (ay + by)
		}
		let out int[]
		let convex = true
		if nx != 0 || ny != 0 || nz != 0 {
			for let i = 0; i < n && convex; i++ {
				let p = cv[(i + n - 1) % n] * 3
				let q = cv[i] * 3
				let r = cv[(i + 1) % n] * 3
				let ux = float(positions[q] - positions[p])
				let uy = float(positions[q + 1] - positions[p + 1])
				let uz = float(positions[q + 2] - positions[p + 2])
				let vx = float(positions[r] - positions[q])
				let vy = float(positions[r + 1] - positions[q + 1])
				let vz = float(positions[r + 2] - positions[q + 2])
				let cx = uy * vz - uz * vy
				let cy = uz * vx - ux * vz
				let cz = ux * vy - uy * vx
				convex = cx * nx + cy * ny + cz * nz >= 0
			}
		}
		if convex {
			for let i = 1; i + 1 < n; i++ {
				out.push(0)
				out.push(i)
				out.push(i + 1)
			}
			return out
		}
		// Project onto the plane across the normal's largest axis.
		let points Point<float>[]
		let ax = nx.abs()
		let ay = ny.abs()
		let az = nz.abs()
		for let i = 0; i < n; i++ {
			let p = cv[i] * 3
			let x = float(positions[p])
			let y = float(positions[p + 1])
			let z = float(positions[p + 2])
			if ax >= ay && ax >= az {
				points.push(new Point(y, z))
			} else if ay >= az {
				points.push(new Point(z, x))
			} else {
				points.push(new Point(x, y))
			}
		}
		return new Polygon<float>(points).triangulate()
	}

	// objOpen opens a file beside the model, none when it is not there.
	def objOpen(resources ResourceReader, name string) ?io.Reader {
		let r ?io.Reader
		r = resources.open(name) onerror (err error) {
			return none
		}
		return r
	}

	def objClose(r io.Reader) {
		if r is io.Closer {
			r.close() onerror recover none
		}
	}

	// objDir is the directory part of a relative name, empty for none.
	def objDir(name string) string {
		let at = name.lastIndexOf("/")
		return "" when at < 0
		return name[:at]
	}

	// objPath normalises a file name from a library: backslashes to
	// slashes, no leading `./`.
	def objPath(name string) string {
		let p = name.replace("\\", "/").trim()
		for p.startsWith("./") {
			p = p[2:]
		}
		return p
	}

	// objDecodeMaterials reads a `.mtl` library into the model's materials
	// and textures. Texture files are read through the resources into the
	// model's resources, by the name the library gives, else by that name
	// under the library's own directory; one that cannot be read is kept by
	// name only.
	def objDecodeMaterials(data byte[], model Model, resources ?ResourceReader, dir string, textures map<string, Texture>) !none {
		let s = new TextScanner(objText(data), objFormat, "mtl")
		let current ?Material
		let first = model.materials.len()
		// Whether each material from `first` on stated `Pr`.
		let statedRoughness bool[]
		for s.pos < s.data.len() {
			if s.atLineEnd() {
				s.skipLine()
				continue
			}
			let key = s.token()
			if key == "newmtl" {
				let m = objNewMaterial(s.restOfLine())
				model.materials.push(m)
				statedRoughness.push(false)
				current = m
				continue
			}
			let m = current
			fail ModelError{message: "mtl: `{key}` before any `newmtl`", format: objFormat, detail: "line {s.line}"} when m is none
			match key {
				case "Ka":
					m.ambient = try objColor(s, m.ambient)
				case "Kd":
					let c = try objColor(s, none)
					if !(c is none) {
						c.alpha = m.baseColor.alpha
						m.baseColor = c
					}
				case "Ks":
					m.specular = try objColor(s, m.specular)
				case "Ke":
					let c = try objColor(s, none)
					m.emissive = c unless c is none
				case "Ns":
					m.shininess = try s.value()
				case "d":
					let t = s.token()
					t = s.token() when t == "-halo"
					fail ModelError{message: "mtl: expected a number after `d`, found `{t}`", format: objFormat, detail: "line {s.line}"} unless t.isNumeric()
					let d = parseFloat<float>(t)
					m.transparency = (1.0 - d).clamp(0.0, 1.0)
					m.baseColor.alpha = uint8((d.clamp(0.0, 1.0) * 255.0).round())
					m.alphaMode = AlphaMode.Blend when d < 1.0
				case "Tr":
					let tr = try s.value()
					m.transparency = tr.clamp(0.0, 1.0)
					m.baseColor.alpha = uint8(((1.0 - m.transparency) * 255.0).round())
					m.alphaMode = AlphaMode.Blend when tr > 0.0
				case "illum":
					let mode = try s.integer()
					m.unlit = mode == 0
				case "Pr":
					m.roughness = (try s.value()).clamp(0.0, 1.0)
					statedRoughness[statedRoughness.len() - 1] = true
				case "Pm":
					m.metallic = (try s.value()).clamp(0.0, 1.0)
				case "map_Kd":
					m.baseColorTexture = objTextureRef(s, model, resources, dir, textures)
				case "map_Ka":
					m.occlusionTexture = objTextureRef(s, model, resources, dir, textures)
				case "map_Ke":
					m.emissiveTexture = objTextureRef(s, model, resources, dir, textures)
				case "map_Pr", "map_Pm", "map_RMA", "map_ORM":
					let ref = objTextureRef(s, model, resources, dir, textures)
					m.metallicRoughnessTexture = ref when m.metallicRoughnessTexture is none
					if key := "map_RMA" || "map_ORM" {
						m.occlusionTexture = ref when m.occlusionTexture is none
					}
				case "map_bump", "map_Bump", "bump", "norm":
					m.normalTexture = objTextureRef(s, model, resources, dir, textures)
				case "map_d":
					// Alpha in its own file has no slot; the material is still
					// drawn blended.
					m.alphaMode = AlphaMode.Blend
				default:
			}
			s.skipLine()
		}
		// A material that stated no `Pr` takes its roughness from the
		// specular exponent.
		for let i = 0; i < statedRoughness.len(); i++ {
			continue when statedRoughness[i]
			let m = model.materials[first + i]
			m.roughness = objRoughness(m.shininess)
		}
		return none
	}

	// objColor reads `r g b`; `spectral` and `xyz` forms keep `keep`.
	def objColor(s TextScanner, keep ?color.Color) !?color.Color {
		let first = s.token()
		return keep when first := "spectral" || "xyz"
		fail ModelError{message: "mtl: expected a colour, found `{first}`", format: objFormat, detail: "line {s.line}"} unless first.isNumeric()
		let r = parseFloat<float>(first)
		let g = r
		let b = r
		let second = try s.lineValue()
		if !(second is none) {
			g = second
			b = try s.value()
		}
		return objColorOf(r, g, b, 1.0)
	}

	def objColorOf(r float, g float, b float, a float) color.Color {
		return new color.Color(color.RGBA{r: objChannel(r), g: objChannel(g), b: objChannel(b), a: objChannel(a)})
	}

	def objChannel(v float) uint8 {
		return uint8((v.clamp(0.0, 1.0) * 255.0).round())
	}

	// objTextureRef reads a map statement's options and file name and
	// returns the texture, shared with other uses of the same file.
	def objTextureRef(s TextScanner, model Model, resources ?ResourceReader, dir string, textures map<string, Texture>) ?TextureRef {
		let tokens string[]
		for !s.atLineEnd() {
			tokens.push(s.token())
		}
		let clamp = false
		let strength = 1.0
		let i = 0
		for i < tokens.len() && tokens[i].startsWith("-") && tokens[i].len() > 1 && !tokens[i][1:].isNumeric() {
			let opt = tokens[i]
			i++
			match opt {
				case "-clamp":
					clamp = i < tokens.len() && tokens[i] == "on"
					i++
				case "-bm":
					strength = parseFloat<float>(tokens[i]) when i < tokens.len() && tokens[i].isNumeric()
					i++
				case "-o", "-s", "-t":
					let taken = 0
					for taken < 3 && i < tokens.len() && tokens[i].isNumeric() {
						i++
						taken++
					}
				case "-mm":
					i += 2
				case "-blendu", "-blendv", "-boost", "-texres", "-imfchan", "-type", "-cc":
					i++
				default:
			}
		}
		return none when i >= tokens.len()
		let name = objPath(tokens[i:].join(" "))
		return none when name.len() == 0
		let key = clamp ?? (name + "|clamp", name)
		let found = textures.get(key)
		return TextureRef{texture: found, strength: strength} unless found is none
		let made = new Texture(name)
		made.name = name
		if clamp {
			made.wrapS = Wrap.Clamp
			made.wrapT = Wrap.Clamp
		}
		objLoadTexture(made, model, resources, dir)
		model.textures.push(made)
		textures.set(key, made)
		return TextureRef{texture: made, strength: strength}
	}

	// objLoadTexture reads the texture's file into the model's resources,
	// by its name, else under the library's directory.
	def objLoadTexture(t Texture, model Model, resources ?ResourceReader, dir string) {
		let res = resources
		return when res is none
		return when model.resources.hasKey(t.source)
		let names = string[t.source]
		names.push(dir + "/" + t.source) when dir.len() > 0
		for let (_, name) in names {
			let r = objOpen(res, name)
			continue when r is none
			let data = io.readAll(r) onerror recover byte[]
			objClose(r)
			continue when data.len() == 0
			t.source = name
			model.resources.set(name, data)
			return
		}
	}
}
