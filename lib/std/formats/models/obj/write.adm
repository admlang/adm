internal partial module std.formats.models.obj {
	use (
		std.bytes
		std.formats.models::*
		std.gfx.color
		std.io
	)

	// Vertices or faces per formatting band, and the most bands at once.
	const objBandRows = 16384
	const objMaxBands = 16

	// objEncode writes every placed mesh as an object in scene coordinates:
	// its vertices, texture coordinates (v flipped back) and normals, then
	// its faces, lines or points per primitive under `usemtl`. With
	// resources and a library name, the materials go into the library
	// beside the model and the textures the model holds into files of
	// their names.
	def objEncode(model Model, writer io.Writer, resources ?ResourceWriter, libraryName string) !none {
		let names = objMaterialNames(model)
		let withLibrary = !(resources is none) && libraryName.len() > 0 && model.materials.len() > 0
		let buf = new bytes.Buffer()
		try buf.writeString("# Wavefront OBJ written by ADM\n")
		try buf.writeString("mtllib {libraryName}\n") when withLibrary
		let placed = objPlaced(model)
		let vBase = 0
		let vtBase = 0
		let vnBase = 0
		for let (k, pair) in placed {
			let (node, mesh) = pair
			let name = node.name
			name = mesh.name when name.len() == 0
			name = "mesh{k + 1}" when name.len() == 0
			try buf.writeString("o {name}\n")
			let m = node.worldTransform()
			let identity = objIsIdentity(m)
			for let (_, source) in mesh.primitives {
				let prim = source
				prim = source.transformed(m) unless identity
				try objWriteVertices(buf, prim)
				let material = prim.material
				if !(material is none) {
					let at = objMaterialIndex(model, material)
					try buf.writeString("usemtl {at >= 0 ?? (names[at], material.name)}\n")
				}
				try objWriteElements(buf, prim, vBase, vtBase, vnBase)
				vBase += prim.vertexCount()
				vtBase += prim.uvs.len() > 0 ?? (prim.vertexCount(), 0)
				vnBase += prim.normals.len() > 0 ?? (prim.vertexCount(), 0)
				if buf.len() > 1048576 {
					try writer.write(buf.bytes())
					buf.reset()
				}
			}
		}
		try writer.write(buf.bytes())
		let res = resources
		return none when res is none || !withLibrary
		let w = try res.create(libraryName)
		try objEncodeMaterials(model, w, names)
		try objCloseWriter(w)
		// The textures the materials use, when the model holds their bytes.
		let written = new map<string, bool>()
		for let (_, texture) in objUsedTextures(model) {
			let file = objTextureFile(texture)
			continue when written.hasKey(file)
			let data = model.resources.get(texture.source)
			continue when data is none
			written.set(file, true)
			let tw = try res.create(file)
			try tw.write(data)
			try objCloseWriter(tw)
		}
		return none
	}

	def objCloseWriter(w io.Writer) !none {
		if w is io.Closer {
			try w.close()
		}
		return none
	}

	// objPlaced lists every node that shows a mesh, in tree order.
	def objPlaced(model Model) (Node, Mesh)[] {
		let out (Node, Mesh)[]
		model.walk(def (node Node) bool {
			let mesh = node.mesh
			out.push((node, mesh)) unless mesh is none
			return true
		})
		return out
	}

	def objIsIdentity(m matrix<float, 4, 4>) bool {
		for let r = 0; r < 4; r++ {
			for let c = 0; c < 4; c++ {
				return false when m[r][c] != (r == c ?? (1.0, 0.0))
			}
		}
		return true
	}

	// objMaterialNames gives every material a name unique in the file: its
	// own, with a number appended when another has it, `material<n>` when
	// it has none. Spaces are kept (readers take the rest of the line).
	def objMaterialNames(model Model) string[] {
		let names string[]
		let used = new map<string, bool>()
		for let (i, m) in model.materials {
			let base = m.name.trim()
			base = "material{i + 1}" when base.len() == 0
			let name = base
			let n = 2
			for used.hasKey(name) {
				name = "{base}_{n}"
				n++
			}
			used.set(name, true)
			names.push(name)
		}
		return names
	}

	def objMaterialIndex(model Model, m Material) int {
		for let i = 0; i < model.materials.len(); i++ {
			return i when model.materials[i] == m
		}
		return -1
	}

	// objUsedTextures lists the textures the materials refer to, once each.
	def objUsedTextures(model Model) Texture[] {
		let out Texture[]
		let seen = new map<string, bool>()
		for let (_, m) in model.materials {
			for let (_, ref) in objRefs(m) {
				let key = objTextureFile(ref.texture)
				continue when seen.hasKey(key)
				seen.set(key, true)
				out.push(ref.texture)
			}
		}
		return out
	}

	// objRefs is the material's texture references, those it has.
	def objRefs(m Material) TextureRef[] {
		let out TextureRef[]
		let base = m.baseColorTexture
		out.push(base) unless base is none
		let mr = m.metallicRoughnessTexture
		out.push(mr) unless mr is none
		let normal = m.normalTexture
		out.push(normal) unless normal is none
		let occlusion = m.occlusionTexture
		out.push(occlusion) unless occlusion is none
		let emissive = m.emissiveTexture
		out.push(emissive) unless emissive is none
		return out
	}

	// objTextureFile is the file name a texture is written under: its
	// source, with an extension from its media type when the source has
	// none (a glTF image named by its index).
	def objTextureFile(t Texture) string {
		let name = t.source.replace("\\", "/")
		name = t.name when name.len() == 0
		name = "texture" when name.len() == 0
		let slash = name.lastIndexOf("/")
		let dot = name.lastIndexOf(".")
		return name when dot > slash + 1 && dot < name.len() - 1
		switch t.mimeType {
			case "image/png":
				return name + ".png"
			case "image/jpeg":
				return name + ".jpg"
			case "image/webp":
				return name + ".webp"
			case "image/bmp":
				return name + ".bmp"
			case "image/gif":
				return name + ".gif"
			case "image/tiff":
				return name + ".tif"
			default:
				return name
		}
	}

	// objWriteVertices writes the primitive's `v` (with a colour when it
	// has a colour set), `vt` and `vn` lines, formatted in bands on tasks.
	def objWriteVertices(buf bytes.Buffer, prim Primitive) !none {
		let count = prim.vertexCount()
		return none when count == 0
		let p = prim.positions
		let colors = prim.colors.len() > 0 ?? (prim.colors[0], float32[])
		let colored = colors.len() >= count * 4
		try objBands(buf, count, (from int, to int, out bytes.Buffer) => {
			for let v = from; v < to; v++ {
				let i = v * 3
				if colored {
					let c = v * 4
					out.writeString("v {objText(p[i])} {objText(p[i + 1])} {objText(p[i + 2])} {objText(colors[c])} {objText(colors[c + 1])} {objText(colors[c + 2])}\n") onerror recover 0
				} else {
					out.writeString("v {objText(p[i])} {objText(p[i + 1])} {objText(p[i + 2])}\n") onerror recover 0
				}
			}
		})
		if prim.uvs.len() > 0 {
			let uv = prim.uvs[0]
			try objBands(buf, count, (from int, to int, out bytes.Buffer) => {
				for let v = from; v < to; v++ {
					out.writeString("vt {objText(uv[v * 2])} {objText(1.0 - uv[v * 2 + 1])}\n") onerror recover 0
				}
			})
		}
		if prim.normals.len() > 0 {
			let n = prim.normals
			try objBands(buf, count, (from int, to int, out bytes.Buffer) => {
				for let v = from; v < to; v++ {
					let i = v * 3
					out.writeString("vn {objText(n[i])} {objText(n[i + 1])} {objText(n[i + 2])}\n") onerror recover 0
				}
			})
		}
		return none
	}

	// objBands formats rows into `buf`: in order, each band of rows on its
	// own task into its own buffer when there are many.
	def objBands(buf bytes.Buffer, rows int, work def (int, int, bytes.Buffer)) !none {
		let bands = (rows / objBandRows).clamp(1, objMaxBands)
		if bands == 1 {
			work(0, rows, buf)
			return none
		}
		let outs bytes.Buffer[]
		for let b = 0; b < bands; b++ {
			outs.push(new bytes.Buffer())
		}
		let group = new AsyncScope()
		for let b = 0; b < bands; b++ {
			async<group> objBand(work, rows * b / bands, rows * (b + 1) / bands, outs[b])
		}
		try group.wait()
		for let (_, out) in outs {
			try buf.write(out.bytes())
		}
		return none
	}

	def objBand(work def (int, int, bytes.Buffer), from int, to int, out bytes.Buffer) {
		work(from, to, out)
	}

	// objIndexAt is the vertex the k-th drawn index names.
	def objIndexAt(prim Primitive, k int) int {
		return int(prim.indices[k]) when prim.indices.len() > 0
		return k
	}

	// objWriteElements writes the primitive's faces (strips and fans
	// unrolled), lines or points with 1-based indices from the bases.
	def objWriteElements(buf bytes.Buffer, prim Primitive, vBase int, vtBase int, vnBase int) !none {
		let hasUv = prim.uvs.len() > 0
		let hasNormal = prim.normals.len() > 0
		switch prim.topology {
			case Topology.Triangles, Topology.TriangleStrip, Topology.TriangleFan:
				let tris = prim.triangleIndices()
				let count = tris.len() / 3
				try objBands(buf, count, (from int, to int, out bytes.Buffer) => {
					for let t = from; t < to; t++ {
						let a = int(tris[t * 3])
						let b = int(tris[t * 3 + 1])
						let c = int(tris[t * 3 + 2])
						out.writeString("f {objCorner(a, vBase, vtBase, vnBase, hasUv, hasNormal)} {objCorner(b, vBase, vtBase, vnBase, hasUv, hasNormal)} {objCorner(c, vBase, vtBase, vnBase, hasUv, hasNormal)}\n") onerror recover 0
					}
				})
			case Topology.Lines:
				let n = prim.indexCount()
				for let k = 0; k + 1 < n; k += 2 {
					try buf.writeString("l {objCorner(objIndexAt(prim, k), vBase, vtBase, 0, hasUv, false)} {objCorner(objIndexAt(prim, k + 1), vBase, vtBase, 0, hasUv, false)}\n")
				}
			case Topology.LineStrip, Topology.LineLoop:
				let n = prim.indexCount()
				return none when n < 2
				try buf.writeString("l")
				for let k = 0; k < n; k++ {
					try buf.writeString(" " + objCorner(objIndexAt(prim, k), vBase, vtBase, 0, hasUv, false))
				}
				try buf.writeString(" " + objCorner(objIndexAt(prim, 0), vBase, vtBase, 0, hasUv, false)) when prim.topology == Topology.LineLoop
				try buf.writeString("\n")
			case Topology.Points:
				let n = prim.indexCount()
				for let k = 0; k < n; k += 32 {
					try buf.writeString("p")
					for let j = k; j < n && j < k + 32; j++ {
						try buf.writeString(" {objIndexAt(prim, j) + vBase + 1}")
					}
					try buf.writeString("\n")
				}
			default:
		}
		return none
	}

	// objCorner is a face corner's `v`, `v/vt`, `v//vn` or `v/vt/vn`.
	def objCorner(i int, vBase int, vtBase int, vnBase int, hasUv bool, hasNormal bool) string {
		let v = i + vBase + 1
		return "{v}/{i + vtBase + 1}/{i + vnBase + 1}" when hasUv && hasNormal
		return "{v}//{i + vnBase + 1}" when hasNormal
		return "{v}/{i + vtBase + 1}" when hasUv
		return "{v}"
	}

	// objText is the shortest text that reads back as the same float32.
	def objText(v float32) string {
		return "%.9g".format(float(v))
	}

	// objEncodeMaterials writes the materials as a `.mtl` library under the
	// names given: the classic fields, derived from the metallic-roughness
	// ones when the material has none, and the PBR extension (`Pr`, `Pm`)
	// as well.
	def objEncodeMaterials(model Model, writer io.Writer, names string[]) !none {
		let buf = new bytes.Buffer()
		try buf.writeString("# Wavefront MTL written by ADM\n")
		for let (i, m) in model.materials {
			try buf.writeString("\nnewmtl {names[i]}\n")
			let ambient = m.ambient
			try buf.writeString("Ka {objRgb(ambient is none ?? (m.baseColor, ambient))}\n")
			try buf.writeString("Kd {objRgb(m.baseColor)}\n")
			let specular = m.specular
			if specular is none {
				// A dielectric reflects a grey highlight, a metal its own colour.
				let r = objMix(0.5, float(m.baseColor.red) / 255.0, m.metallic)
				let g = objMix(0.5, float(m.baseColor.green) / 255.0, m.metallic)
				let b = objMix(0.5, float(m.baseColor.blue) / 255.0, m.metallic)
				try buf.writeString("Ks {objNumber(r)} {objNumber(g)} {objNumber(b)}\n")
			} else {
				try buf.writeString("Ks {objRgb(specular)}\n")
			}
			try buf.writeString("Ke {objRgb(m.emissive)}\n") when m.emissive.red != 0 || m.emissive.green != 0 || m.emissive.blue != 0
			let shininess = m.shininess
			shininess = (1.0 - m.roughness) * (1.0 - m.roughness) * 1000.0 when shininess <= 0
			try buf.writeString("Ns {objNumber(shininess)}\n")
			let alpha = float(m.baseColor.alpha) / 255.0
			alpha = 1.0 - m.transparency when alpha >= 1.0 && m.transparency > 0
			try buf.writeString("d {objNumber(alpha)}\n")
			try buf.writeString("illum {m.unlit ?? (0, 2)}\n")
			try buf.writeString("Pr {objNumber(m.roughness)}\nPm {objNumber(m.metallic)}\n")
			try objMap(buf, "map_Kd", m.baseColorTexture)
			try objMap(buf, "map_Ke", m.emissiveTexture)
			try objMap(buf, "map_Pr", m.metallicRoughnessTexture)
			try objMap(buf, "map_Pm", m.metallicRoughnessTexture)
			try objMap(buf, "map_Bump", m.normalTexture)
			try objMap(buf, "map_Ka", m.occlusionTexture)
			try objMap(buf, "map_d", m.baseColorTexture) when m.alphaMode != AlphaMode.Opaque
		}
		try writer.write(buf.bytes())
		return none
	}

	// objMap writes a map statement with `-clamp on` for a clamped texture
	// and `-bm` for a normal map's strength.
	def objMap(buf bytes.Buffer, key string, ref ?TextureRef) !none {
		return none when ref is none
		let options = ""
		options += " -clamp on" when ref.texture.wrapS == Wrap.Clamp
		options += " -bm {objNumber(ref.strength)}" when key == "map_Bump" && ref.strength != 1.0
		try buf.writeString("{key}{options} {objTextureFile(ref.texture)}\n")
		return none
	}

	def objMix(a float, b float, t float) float {
		return a + (b - a) * t
	}

	def objRgb(c color.Color) string {
		return "{objNumber(float(c.red) / 255.0)} {objNumber(float(c.green) / 255.0)} {objNumber(float(c.blue) / 255.0)}"
	}

	// objNumber is a material value with six decimals, as the usual
	// writers put it, without trailing zeros.
	def objNumber(v float) string {
		let text = "%.6f".format(v)
		return text unless text.contains(".")
		text = text.trimEnd("0")
		text = text.trimEnd(".")
		return text
	}
}
