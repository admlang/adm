partial module std.formats.models {
	use std.io

	// Ply is the Stanford polygon format: a text header declaring elements
	// (vertices, faces, edges) and their typed properties, then the data as
	// text or binary of either byte order. Reads positions, normals, texture
	// coordinates, colours and faces of any size (triangulated) into one mesh,
	// and edges into a Lines primitive; writes vertices with every attribute
	// the mesh has and triangle faces, binary little-endian unless the fields
	// say otherwise.
	@codec("PLY")
	type Ply {
		// Write the binary form; false writes text.
		binary    bool = true
		// Write binary big-endian.
		bigEndian bool = false

		mimeType string[] {
			def get() string[] {
				return string["application/x-ply"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".ply"]
			}
		}

		// matchSignature tests for the `ply` magic line.
		def matchSignature(r io.Reader) bool {
			let b = prefix(r, 4)
			return b.len() == 4 && string(b[:3]) == "ply" && (b[3] == 0x0A || b[3] == 0x0D)
		}

		// decode reads the whole reader as PLY. Fails with a ModelError when the
		// header is malformed, a property has an unknown type or the data is
		// short, or with the reader's own error.
		def decode(reader io.Reader, resources ?ResourceReader) !Model {}

		// encode writes the model's meshes as one PLY. Fails with the writer's
		// own error.
		def encode(model Model, writer io.Writer, resources ?ResourceWriter) !none {}
	}
}
