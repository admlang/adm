internal partial module std.formats.models.ply {
	use (
		std.formats.models::*
		std.formats.models.polygon::*
		std.formats.models.resource::*
		std.formats.models.text::*
		std.gfx.bands
		std.simd
	)

	// The scalar types of a property, in the order of `plyTypeNames`.
	const plyInt8 = 0
	const plyUint8 = 1
	const plyInt16 = 2
	const plyUint16 = 3
	const plyInt32 = 4
	const plyUint32 = 5
	const plyFloat32 = 6
	const plyFloat64 = 7

	// The three ways the data after the header is stored.
	const plyAscii = 0
	const plyLittle = 1
	const plyBig = 2

	// What a vertex property is read as: nothing, or a slot of an attribute.
	const plyNone = 0
	const plyX = 1
	const plyNx = 4
	const plyU = 7
	const plyRed = 9

	// plyType is the scalar type a header names, by either of its two
	// spellings (`uchar`, `uint8`); -1 for a name that is not a type.
	def plyType(name string) int {
		match name {
			case "char", "int8":
				return plyInt8
			case "uchar", "uint8":
				return plyUint8
			case "short", "int16":
				return plyInt16
			case "ushort", "uint16":
				return plyUint16
			case "int", "int32":
				return plyInt32
			case "uint", "uint32":
				return plyUint32
			case "float", "float32":
				return plyFloat32
			case "double", "float64":
				return plyFloat64
			default:
				return -1
		}
	}

	// plySize is the bytes a scalar of the type takes in the binary forms.
	def plySize(kind int) int {
		return 1 when kind <= plyUint8
		return 2 when kind <= plyUint16
		return 4 when kind <= plyFloat32
		return 8
	}

	// plyUnit is what a colour channel of the type is multiplied by to lie
	// in 0..1: the reciprocal of an integer type's greatest value, 1 for a
	// floating-point one.
	def plyUnit(kind int) float {
		switch kind {
			case plyInt8:
				return 1.0 / 127.0
			case plyUint8:
				return 1.0 / 255.0
			case plyInt16:
				return 1.0 / 32767.0
			case plyUint16:
				return 1.0 / 65535.0
			case plyInt32:
				return 1.0 / 2147483647.0
			case plyUint32:
				return 1.0 / 4294967295.0
			default:
				return 1.0
		}
	}

	// PlyProperty is one declared property of an element: a scalar, or a
	// list whose length is stored before its items.
	type PlyProperty {
		name      string
		kind      int
		list      bool
		// The type of a list's length.
		countKind int
		// A scalar's byte offset in the element's binary record, when the
		// element has no list.
		offset    int

		def new(name string, kind int) {
			self.name = name
			self.kind = kind
		}
	}

	// PlyElement is one declared element: its name, how many the file holds
	// and their properties in stored order.
	type PlyElement {
		name       string
		count      int
		properties PlyProperty[]
		// Whether every property is a scalar, and then the bytes of one
		// binary record.
		fixed      bool          = true
		size       int

		def new(name string, count int) {
			self.name = name
			self.count = count
			properties = PlyProperty[]
		}

		// find is the place of the first property with one of the names, -1
		// when the element has none.
		def find(names string[]) int {
			for let (i, p) in properties {
				for let (_, wanted) in names {
					return i when p.name == wanted
				}
			}
			return -1
		}
	}

	// PlyHeader is the header: the storage form, the elements in stored
	// order, the comment and obj_info lines, and where the data starts.
	type PlyHeader {
		form     int
		elements PlyElement[]
		comments string[]
		infos    string[]
		body     int

		def new() {
			elements = PlyElement[]
			comments = string[]
			infos = string[]
		}
	}

	// plyHeader reads the header lines up to `end_header`.
	def plyHeader(data byte[]) !PlyHeader {
		let s = new TextScanner(data, "PLY", "ply")
		let header = new PlyHeader()
		let magic = s.token()
		fail ModelError{message: "ply: the file does not start with `ply`", format: "PLY", detail: magic} when magic != "ply"
		s.skipLine()
		let formatSeen = false
		for {
			fail ModelError{message: "ply: the header has no `end_header`", format: "PLY"} when s.pos >= data.len()
			let key = s.token()
			match key {
				case "":
				case "format":
					let form = s.token()
					match form {
						case "ascii":
							header.form = plyAscii
						case "binary_little_endian":
							header.form = plyLittle
						case "binary_big_endian":
							header.form = plyBig
						default:
							fail ModelError{message: "ply: unknown format `{form}`; ascii, binary_little_endian and binary_big_endian are read", format: "PLY", detail: "line {s.line}"}
					}
					formatSeen = true
				case "comment":
					header.comments.push(s.restOfLine())
					continue
				case "obj_info":
					header.infos.push(s.restOfLine())
					continue
				case "element":
					let name = s.token()
					let count = s.integer() onerror (err error) {
						fail ModelError{message: "ply: element `{name}` has no count", format: "PLY", detail: "line {s.line}", cause: err}
					}
					fail ModelError{message: "ply: element `{name}` has a negative count", format: "PLY", detail: "line {s.line}"} when count < 0
					header.elements.push(new PlyElement(name, count))
				case "property":
					fail ModelError{message: "ply: a property before any element", format: "PLY", detail: "line {s.line}"} when header.elements.len() == 0
					let element = header.elements[header.elements.len() - 1]
					let first = s.token()
					if first == "list" {
						let countName = s.token()
						let itemName = s.token()
						let countKind = plyType(countName)
						let itemKind = plyType(itemName)
						fail ModelError{message: "ply: unknown list count type `{countName}`", format: "PLY", detail: "line {s.line}"} when countKind < 0 || countKind >= plyFloat32
						fail ModelError{message: "ply: unknown list item type `{itemName}`", format: "PLY", detail: "line {s.line}"} when itemKind < 0
						let p = new PlyProperty(s.token(), itemKind)
						p.list = true
						p.countKind = countKind
						element.properties.push(p)
						element.fixed = false
					} else {
						let kind = plyType(first)
						fail ModelError{message: "ply: unknown property type `{first}`", format: "PLY", detail: "line {s.line}"} when kind < 0
						let p = new PlyProperty(s.token(), kind)
						p.offset = element.size
						element.size += plySize(kind)
						element.properties.push(p)
					}
				case "end_header":
					s.skipLine()
					fail ModelError{message: "ply: the header has no `format` line", format: "PLY"} unless formatSeen
					header.body = s.pos
					return header
				default:
					// A line that starts with no keyword is kept as a comment:
					// some writers leave the word out.
					header.comments.push((key + " " + s.restOfLine()).trim())
					continue
			}
			s.skipLine()
		}
	}

	// PlySource reads the data after the header one scalar at a time, from
	// text or from either binary form.
	type PlySource {
		data byte[]
		form int
		pos  int
		text TextScanner

		def new(data byte[], form int, pos int) {
			self.data = data
			self.form = form
			self.pos = pos
			text = new TextScanner(data, "PLY", "ply")
			text.pos = pos
		}

		// scalar is the next value of the type. Fails with a ModelError when
		// the data ends before it, or the text is not a number.
		def scalar(kind int) !float {
			return text.value() when form == plyAscii
			let size = plySize(kind)
			fail ModelError{message: "ply: the data ends inside an element", format: "PLY", detail: "byte {pos}"} when pos + size > data.len()
			let v = plyScalar(data, pos, kind, form == plyBig)
			pos += size
			return v
		}
	}

	// plyBits is the unsigned integer of `size` bytes at the offset.
	def plyBits(data byte[], at int, size int, big bool) uint64 {
		let v uint64 = 0
		for let k = 0; k < size; k++ {
			let b = uint64(data[at + (big ?? (k, size - 1 - k))])
			v = (v << 8) | b
		}
		return v
	}

	// plyScalar is the binary scalar of the type at the offset.
	def plyScalar(data byte[], at int, kind int, big bool) float {
		switch kind {
			case plyInt8:
				return float(int8(data[at]))
			case plyUint8:
				return float(data[at])
			case plyInt16:
				return float(int16(uint16(plyBits(data, at, 2, big))))
			case plyUint16:
				return float(plyBits(data, at, 2, big))
			case plyInt32:
				return float(int32(uint32(plyBits(data, at, 4, big))))
			case plyUint32:
				return float(plyBits(data, at, 4, big))
			case plyFloat32:
				return float(__bitcast_f32_from_u32(uint32(plyBits(data, at, 4, big))))
			default:
				return float(__bitcast_f64_from_u64(plyBits(data, at, 8, big)))
		}
	}

	// PlyVertices is the vertex element as read: one array per attribute
	// the file has, empty for the ones it lacks.
	type PlyVertices {
		count     int
		positions float32[]
		normals   float32[]
		uvs       float32[]
		colors    float32[]
		// Per property: the slot it fills (plyNone, plyX + 0..2, plyNx + 0..2,
		// plyU + 0..1, plyRed + 0..3) and what a colour channel is scaled by.
		roles     int[]
		units     float[]

		def new(element PlyElement) {
			count = element.count
			roles = int[]
			units = float[]
			let hasNormals = false
			let hasUvs = false
			let hasColors = false
			for let (_, p) in element.properties {
				let role = p.list ?? (plyNone, plyRole(p.name))
				roles.push(role)
				units.push(plyUnit(p.kind))
				hasNormals = true when role >= plyNx && role < plyU
				hasUvs = true when role >= plyU && role < plyRed
				hasColors = true when role >= plyRed
			}
			// Three slots of slack past each array's end, which the vector
			// copies of the last records write into.
			positions.len(count * 3 + 3)
			normals.len(count * 3 + 3) when hasNormals
			uvs.len(count * 2 + 3) when hasUvs
			if hasColors {
				colors.len(count * 4)
				colors.fill(float32(1))
			}
		}

		// put stores one property's value for the vertex.
		def put(v int, property int, value float) {
			let role = roles[property]
			if role >= plyRed {
				colors[v * 4 + role - plyRed] = float32(value * units[property])
			} else if role >= plyU {
				uvs[v * 2 + role - plyU] = float32(value)
			} else if role >= plyNx {
				normals[v * 3 + role - plyNx] = float32(value)
			} else if role >= plyX {
				positions[v * 3 + role - plyX] = float32(value)
			}
		}

		// trim takes the slack off the arrays.
		def trim() {
			positions.len(count * 3)
			normals.len(count * 3) when normals.len() > 0
			uvs.len(count * 2) when uvs.len() > 0
		}
	}

	// plyRole is the slot a vertex property of the name fills.
	def plyRole(name string) int {
		match name {
			case "x":
				return plyX
			case "y":
				return plyX + 1
			case "z":
				return plyX + 2
			case "nx":
				return plyNx
			case "ny":
				return plyNx + 1
			case "nz":
				return plyNx + 2
			case "s", "u", "texture_u", "texture_s":
				return plyU
			case "t", "v", "texture_v", "texture_t":
				return plyU + 1
			case "red", "r", "diffuse_red":
				return plyRed
			case "green", "g", "diffuse_green":
				return plyRed + 1
			case "blue", "b", "diffuse_blue":
				return plyRed + 2
			case "alpha", "a", "diffuse_alpha":
				return plyRed + 3
			default:
				return plyNone
		}
	}

	// PlyFaces is what the face, tristrips and edge elements hold: the
	// triangles as vertex index triples, the texture coordinates and colour
	// a face gives its corners, and the edges as vertex index pairs.
	type PlyFaces {
		triangles uint32[]
		// Per triangle corner a texture coordinate (2 values), when faces
		// carry them, and per triangle a colour (4 values), when faces do.
		cornerUvs float32[]
		colors    float32[]
		edges     uint32[]

		def new() {
			triangles = uint32[]
			cornerUvs = float32[]
			colors = float32[]
			edges = uint32[]
		}
	}

	// plyDecode reads a PLY from the bytes into a model of one mesh at one
	// node: a Triangles primitive from the faces and triangle strips, a Lines
	// primitive from the edges, a Points primitive when the file has neither.
	def plyDecode(data byte[], resources ?ResourceReader) !Model {
		let header = try plyHeader(data)
		let source = new PlySource(data, header.form, header.body)
		let vertices ?PlyVertices
		let faces = new PlyFaces()
		// Text with one element a line is read in bands on tasks: `lines`
		// holds where each line starts, `line` the element's first.
		let lines = int[]
		lines = plyLines(data, header) when header.form == plyAscii
		let line = 0
		for let (_, element) in header.elements {
			let first = line
			line += element.count
			let banded = lines.len() > 0 && element.count > 0 && (element.name == "vertex" || element.name == "face")
			let ends = banded ?? (line < lines.len() ?? (lines[line], data.len()), 0)
			banded = false when banded && bands.bandCount(element.count, ends - lines[first]) < 2
			match element.name {
				case "vertex":
					let read = new PlyVertices(element)
					if banded {
						try plyReadVertexLines(data, lines, first, ends, element, read)
						source.text.pos = ends
						source.text.line += element.count
					} else {
						try plyReadVertices(source, element, read)
					}
					vertices = read
				case "face":
					let positions = float32[]
					let limit = 0
					let known = vertices
					if !(known is none) {
						positions = known.positions
						limit = known.count
					}
					if banded {
						try plyReadFaceLines(data, lines, first, ends, element, faces, positions, limit)
						source.text.pos = ends
						source.text.line += element.count
					} else {
						try plyReadFaces(source, element, faces, positions, limit, 0, element.count)
					}
				case "tristrips":
					let limit = 0
					let known = vertices
					limit = known.count unless known is none
					try plyReadStrips(source, element, faces, limit)
				case "edge":
					let limit = 0
					let known = vertices
					limit = known.count unless known is none
					try plyReadEdges(source, element, faces, limit)
				default:
					try plySkip(source, element)
			}
		}
		let model = new Model()
		model.metadata.set("comment", header.comments.join("\n")) when header.comments.len() > 0
		model.metadata.set("obj_info", header.infos.join("\n")) when header.infos.len() > 0
		let read = vertices
		return model when read is none
		read.trim()
		let mesh = new Mesh("")
		if faces.triangles.len() > 0 {
			let prim = mesh.add(plyTriangles(read, faces))
			plyTexture(header, model, prim, resources)
		}
		if faces.edges.len() > 0 {
			let prim = mesh.add(plyAttributes(read))
			prim.topology = Topology.Lines
			prim.indices = faces.edges
		}
		if mesh.primitives.len() == 0 && read.count > 0 {
			let prim = mesh.add(plyAttributes(read))
			prim.topology = Topology.Points
		}
		return model when mesh.primitives.len() == 0
		model.meshes.push(mesh)
		let node = new Node("")
		node.mesh = mesh
		model.nodes.push(node)
		return model
	}

	// plyAttributes is a primitive holding the vertices' attributes.
	def plyAttributes(read PlyVertices) Primitive {
		let prim = new Primitive()
		prim.positions = read.positions.clone()
		prim.normals = read.normals.clone()
		prim.uvs.push(read.uvs.clone()) when read.uvs.len() > 0
		prim.colors.push(read.colors.clone()) when read.colors.len() > 0
		return prim
	}

	// plyTriangles is the Triangles primitive: the vertices indexed by the
	// faces, or, when faces give their corners texture coordinates or a
	// colour, a vertex per corner with those, merged where corners agree.
	def plyTriangles(read PlyVertices, faces PlyFaces) Primitive {
		let prim = new Primitive()
		let perCorner = faces.cornerUvs.len() > 0 || faces.colors.len() > 0
		if !perCorner {
			prim.positions = read.positions
			prim.normals = read.normals
			prim.uvs.push(read.uvs) when read.uvs.len() > 0
			prim.colors.push(read.colors) when read.colors.len() > 0
			prim.indices = faces.triangles
			return prim
		}
		let corners = faces.triangles.len()
		prim.positions.len(corners * 3)
		prim.normals.len(corners * 3) when read.normals.len() > 0
		let uvs float32[]
		uvs.len(corners * 2) when faces.cornerUvs.len() > 0 || read.uvs.len() > 0
		let colors float32[]
		colors.len(corners * 4) when faces.colors.len() > 0 || read.colors.len() > 0
		for let c = 0; c < corners; c++ {
			let v = int(faces.triangles[c])
			for let k = 0; k < 3; k++ {
				prim.positions[c * 3 + k] = read.positions[v * 3 + k]
				prim.normals[c * 3 + k] = read.normals[v * 3 + k] when read.normals.len() > 0
			}
			if faces.cornerUvs.len() > 0 {
				uvs[c * 2] = faces.cornerUvs[c * 2]
				uvs[c * 2 + 1] = faces.cornerUvs[c * 2 + 1]
			} else if read.uvs.len() > 0 {
				uvs[c * 2] = read.uvs[v * 2]
				uvs[c * 2 + 1] = read.uvs[v * 2 + 1]
			}
			// A face's colour over its vertices' own.
			for let k = 0; k < 4 && colors.len() > 0; k++ {
				colors[c * 4 + k] = faces.colors.len() > 0 ?? (faces.colors[(c / 3) * 4 + k], read.colors[v * 4 + k])
			}
		}
		prim.uvs.push(uvs) when uvs.len() > 0
		prim.colors.push(colors) when colors.len() > 0
		prim.indexed()
		return prim
	}

	// plyTexture gives the primitive a material with the picture a
	// `comment TextureFile name` line names (MeshLab's and VCGLib's way of
	// naming one), when the primitive has texture coordinates.
	def plyTexture(header PlyHeader, model Model, prim Primitive, resources ?ResourceReader) {
		return when prim.uvs.len() == 0
		for let (_, comment) in header.comments {
			continue unless comment.startsWith("TextureFile")
			let name = comment["TextureFile".len():].trim()
			continue when name.len() == 0
			let texture = new Texture(name)
			texture.name = name
			loadTexture(texture, model, resources, "")
			model.textures.push(texture)
			let material = new Material(name)
			material.baseColorTexture = TextureRef{texture: texture}
			model.materials.push(material)
			prim.material = material
			return
		}
	}

	// plyReadVertexRange reads vertices `from` to `to` one value at a time.
	def plyReadVertexRange(source PlySource, element PlyElement, into PlyVertices, from int, to int) !none {
		for let v = from; v < to; v++ {
			for let (k, p) in element.properties {
				if p.list {
					let n = int(try source.scalar(p.countKind))
					for let i = 0; i < n; i++ {
						try source.scalar(p.kind)
					}
					continue
				}
				into.put(v, k, try source.scalar(p.kind))
			}
		}
		return none
	}

	// plyLines is where each line of the text after the header starts,
	// blank lines left out, when the file holds one element a line (as many
	// lines as elements); empty when it does not, and the text is then read
	// as one run of values.
	def plyLines(data byte[], header PlyHeader) int[] {
		let total = 0
		for let (_, element) in header.elements {
			total += element.count
		}
		let lines int[]
		let at = header.body
		for at < data.len() {
			let start = at
			let blank = true
			for at < data.len() && data[at] != 0x0A {
				blank = false when data[at] > 0x20
				at++
			}
			at++
			continue when blank
			lines.push(start)
			return int[] when lines.len() > total
		}
		return int[] when lines.len() != total
		return lines
	}

	// PlyBand is what one band of a text element came to: the faces it
	// read, and the error that stopped it.
	type PlyBand {
		faces   PlyFaces
		failure ?error

		def new() {
			faces = new PlyFaces()
		}
	}

	// plyBands is a result per band `bands.forBands` makes of the rows.
	def plyBands(rows int, bytes int) PlyBand[] {
		let out PlyBand[]
		for let b = 0; b < bands.bandCount(rows, bytes); b++ {
			out.push(new PlyBand())
		}
		return out
	}

	// plyReadVertexLines reads the vertex element of a text file with one
	// vertex a line, the lines from `first` on up to the byte `ends`, in
	// bands on tasks. Fails with the first band's error in file order.
	def plyReadVertexLines(data byte[], lines int[], first int, ends int, element PlyElement, into PlyVertices) !none {
		let count = element.count
		let bytes = ends - lines[first]
		let results = plyBands(count, bytes)
		bands.forBands(count, bytes, (from int, to int) => {
			let band = results[bands.bandOf(from, count, results.len())]
			let source = new PlySource(data, plyAscii, lines[first + from])
			plyReadVertexRange(source, element, into, from, to) onerror (err error) {
				band.failure = err
				recover none
			}
		})
		for let (_, band) in results {
			let failure = band.failure
			fail failure unless failure is none
		}
		return none
	}

	// plyReadFaceLines reads the face element of a text file with one face
	// a line, in bands on tasks, and appends the bands' faces in file order.
	def plyReadFaceLines(data byte[], lines int[], first int, ends int, element PlyElement, faces PlyFaces, positions float32[], limit int) !none {
		let count = element.count
		let bytes = ends - lines[first]
		let results = plyBands(count, bytes)
		bands.forBands(count, bytes, (from int, to int) => {
			let band = results[bands.bandOf(from, count, results.len())]
			let source = new PlySource(data, plyAscii, lines[first + from])
			plyReadFaces(source, element, band.faces, positions, limit, from, to) onerror (err error) {
				band.failure = err
				recover none
			}
		})
		for let (_, band) in results {
			let failure = band.failure
			fail failure unless failure is none
			faces.triangles.push(...band.faces.triangles)
			faces.cornerUvs.push(...band.faces.cornerUvs)
			faces.colors.push(...band.faces.colors)
		}
		return none
	}

	// plyReadVertices reads the vertex element. Binary records are read in
	// bands on tasks, each band its own vertices.
	def plyReadVertices(source PlySource, element PlyElement, into PlyVertices) !none {
		let count = element.count
		return plyReadVertexRange(source, element, into, 0, count) when source.form == plyAscii || !element.fixed
		let start = source.pos
		let size = element.size
		fail ModelError{message: "ply: the data ends inside the vertices: {count} of {size} bytes are declared, {source.data.len() - start} bytes are there", format: "PLY", detail: "byte {start}"} when start + count * size > source.data.len()
		let big = source.form == plyBig
		// Three float32 properties in a row, little-endian, filling the three
		// slots of the positions or the normals (or two of the texture
		// coordinates) are copied a vector at a time; the rest go one by one.
		let px = plyRun(element, into, plyX, 3, big)
		let pn = plyRun(element, into, plyNx, 3, big)
		let pu = plyRun(element, into, plyU, 2, big)
		let taken bool[]
		taken.len(element.properties.len())
		for let (k, _) in element.properties {
			let role = into.roles[k]
			taken[k] = role == plyNone || (px >= 0 && role >= plyX && role < plyNx) || (pn >= 0 && role >= plyNx && role < plyU) || (pu >= 0 && role >= plyU && role < plyRed)
		}
		let data = source.data
		if count > 0 {
			bands.forBands(count, count, (from int, to int) => {
				// The vector copies read 16 bytes: the last vertex of the file
				// may not have them, so the last record of all goes one by one.
				let last = to == count ?? (to - 1, to)
				plyCopyRun(data, start + px, size, into.positions, 3, from, last) when px >= 0
				plyCopyRun(data, start + pn, size, into.normals, 3, from, last) when pn >= 0
				plyCopyRun(data, start + pu, size, into.uvs, 2, from, last) when pu >= 0
				plyReadRecords(data, start, size, element, into, taken, big, from, to, last)
			})
		}
		source.pos = start + count * size
		return none
	}

	// plyRun is the record offset of `width` float32 properties in a row
	// that fill the slots `role`, `role + 1`, ... in order, in the
	// little-endian form; -1 when the element stores them otherwise.
	def plyRun(element PlyElement, into PlyVertices, role int, width int, big bool) int {
		return -1 when big
		for let (k, p) in element.properties {
			continue when into.roles[k] != role
			return -1 when k + width > element.properties.len()
			for let i = 0; i < width; i++ {
				let q = element.properties[k + i]
				return -1 when q.kind != plyFloat32 || into.roles[k + i] != role + i
			}
			return p.offset
		}
		return -1
	}

	// plyCopyRun copies `width` little-endian float32s from each record
	// `from` to `to` into the attribute, four floats a vector: the floats
	// past the width land in the next vertex's slots, which its own copy
	// overwrites.
	def plyCopyRun(data byte[], at int, size int, into float32[], width int, from int, to int) {
		for let v = from; v < to; v++ {
			simd.store4(into, v * width, simd.loadBytes16(data, at + v * size).bitcast4<float32>())
		}
	}

	// plyReadRecords reads the properties not copied as runs, for records
	// `from` to `to`, and every property of the records from `whole` on.
	def plyReadRecords(data byte[], start int, size int, element PlyElement, into PlyVertices, taken bool[], big bool, from int, to int, whole int) {
		for let (k, p) in element.properties {
			continue when into.roles[k] == plyNone
			let first = taken[k] ?? (whole, from)
			for let v = first; v < to; v++ {
				into.put(v, k, plyScalar(data, start + v * size + p.offset, p.kind, big))
			}
		}
	}

	// plyIndex is a vertex index a face, strip or edge names. Fails with a
	// ModelError when the file has no such vertex.
	def plyIndex(value float, limit int, what string) !uint32 {
		fail ModelError{message: "ply: {what} names vertex {int(value)}, and the file has {limit}", format: "PLY", detail: what} when value < 0 || value >= float(limit)
		return uint32(value)
	}

	// plyReadFaces reads the face element: each face's vertex list cut into
	// triangles, with the texture coordinates of a `texcoord` list and the
	// colour of red, green, blue and alpha properties when faces have them.
	// Reads faces `from` to `to`, the source standing at the first of them.
	def plyReadFaces(source PlySource, element PlyElement, faces PlyFaces, positions float32[], limit int, from int, to int) !none {
		let indexAt = element.find(string["vertex_indices", "vertex_index"])
		let uvAt = element.find(string["texcoord"])
		let colored = false
		let roles int[]
		for let (_, p) in element.properties {
			let role = p.list ?? (plyNone, plyRole(p.name))
			role = plyNone when role < plyRed
			colored = true when role != plyNone
			roles.push(role)
		}
		return plyReadTriangleRecords(source, element, faces, limit) when plyPlainTriangles(source, element, indexAt)
		let corners int[]
		let uv float32[]
		let color = float32[1, 1, 1, 1]
		for let f = from; f < to; f++ {
			corners.len(0)
			uv.len(0)
			for let (k, p) in element.properties {
				if !p.list {
					let value = try source.scalar(p.kind)
					color[roles[k] - plyRed] = float32(value * plyUnit(p.kind)) when roles[k] != plyNone
					continue
				}
				let n = int(try source.scalar(p.countKind))
				for let i = 0; i < n; i++ {
					let value = try source.scalar(p.kind)
					if k == indexAt {
						corners.push(int(try plyIndex(value, limit, "face {f}")))
					} else if k == uvAt {
						uv.push(float32(value))
					}
				}
			}
			let n = corners.len()
			continue when n < 3
			let cut = n == 3 ?? (int[0, 1, 2], polygonTriangles(positions, corners, n))
			for let (_, c) in cut {
				faces.triangles.push(uint32(corners[c]))
			}
			let added = cut.len() / 3
			if uvAt >= 0 {
				// A face without its coordinates gets zeros, so the list stays
				// in step with the triangles.
				for let (_, c) in cut {
					faces.cornerUvs.push(c * 2 + 1 < uv.len() ?? (uv[c * 2], float32(0)), c * 2 + 1 < uv.len() ?? (uv[c * 2 + 1], float32(0)))
				}
			}
			if colored {
				for let t = 0; t < added; t++ {
					faces.colors.push(color[0], color[1], color[2], color[3])
				}
			}
		}
		return none
	}

	// plyPlainTriangles reports whether the face element is binary, holds
	// nothing but the vertex list with a one-byte length and four-byte
	// items, and every face has three corners: then each face is a record
	// of 13 bytes.
	def plyPlainTriangles(source PlySource, element PlyElement, indexAt int) bool {
		return false when source.form == plyAscii || element.properties.len() != 1 || indexAt != 0
		let p = element.properties[0]
		return false when plySize(p.countKind) != 1 || (p.kind != plyInt32 && p.kind != plyUint32)
		return false when source.pos + element.count * 13 > source.data.len()
		for let f = 0; f < element.count; f++ {
			return false when source.data[source.pos + f * 13] != 3
		}
		return true
	}

	// plyReadTriangleRecords reads faces stored as 13-byte records of three
	// indices, in bands on tasks. Fails with a ModelError when one names a
	// vertex the file does not have.
	def plyReadTriangleRecords(source PlySource, element PlyElement, faces PlyFaces, limit int) !none {
		let count = element.count
		let start = source.pos
		let data = source.data
		let big = source.form == plyBig
		let base = faces.triangles.len()
		let out = faces.triangles
		out.len(base + count * 3)
		// The greatest index each band met; one stored negative reads as a
		// large one.
		let n = bands.bandCount(count, count)
		let highs uint64[]
		highs.len(n)
		if count > 0 {
			bands.forBands(count, count, (from int, to int) => {
				highs[bands.bandOf(from, count, n)] = plyTriangleBand(data, start, out, base, big, from, to)
			})
		}
		for let (_, high) in highs {
			fail ModelError{message: "ply: a face names vertex {high}, and the file has {limit}", format: "PLY", detail: "face"} when high >= uint64(limit)
		}
		source.pos = start + count * 13
		return none
	}

	// plyTriangleBand copies the three indices of records `from` to `to`
	// and returns the greatest.
	def plyTriangleBand(data byte[], start int, out uint32[], base int, big bool, from int, to int) uint64 {
		let high uint64 = 0
		for let f = from; f < to; f++ {
			let at = start + f * 13 + 1
			for let k = 0; k < 3; k++ {
				let v = plyBits(data, at + k * 4, 4, big)
				out[base + f * 3 + k] = uint32(v)
				high = v when v > high
			}
		}
		return high
	}

	// plyReadStrips reads the tristrips element: each list is a run of
	// triangle strips, a negative index ending one and starting the next.
	def plyReadStrips(source PlySource, element PlyElement, faces PlyFaces, limit int) !none {
		let indexAt = element.find(string["vertex_indices", "vertex_index"])
		for let s = 0; s < element.count; s++ {
			for let (k, p) in element.properties {
				if !p.list {
					try source.scalar(p.kind)
					continue
				}
				let n = int(try source.scalar(p.countKind))
				// The last two vertices of the strip under way, and how many
				// it has had.
				let a uint32 = 0
				let b uint32 = 0
				let seen = 0
				for let i = 0; i < n; i++ {
					let value = try source.scalar(p.kind)
					continue when k != indexAt
					if value < 0 {
						seen = 0
						continue
					}
					let c = try plyIndex(value, limit, "strip {s}")
					if seen >= 2 {
						// Every second triangle swaps two corners to keep the winding.
						if seen % 2 == 0 {
							faces.triangles.push(a, b, c)
						} else {
							faces.triangles.push(b, a, c)
						}
					}
					a = b
					b = c
					seen++
				}
			}
		}
		// Faces read before the strips carried per-corner values, the strips
		// carry none: zeros and white keep the lists in step.
		faces.cornerUvs.len(faces.triangles.len() * 2) when faces.cornerUvs.len() > 0
		if faces.colors.len() > 0 {
			for faces.colors.len() < faces.triangles.len() / 3 * 4 {
				faces.colors.push(float32(1))
			}
		}
		return none
	}

	// plyReadEdges reads the edge element: `vertex1` and `vertex2` of each.
	def plyReadEdges(source PlySource, element PlyElement, faces PlyFaces, limit int) !none {
		let first = element.find(string["vertex1"])
		let second = element.find(string["vertex2"])
		for let e = 0; e < element.count; e++ {
			let a = -1.0
			let b = -1.0
			for let (k, p) in element.properties {
				if p.list {
					let n = int(try source.scalar(p.countKind))
					for let i = 0; i < n; i++ {
						try source.scalar(p.kind)
					}
					continue
				}
				let value = try source.scalar(p.kind)
				a = value when k == first
				b = value when k == second
			}
			continue when first < 0 || second < 0
			faces.edges.push(try plyIndex(a, limit, "edge {e}"), try plyIndex(b, limit, "edge {e}"))
		}
		return none
	}

	// plySkip reads past an element the model has no place for.
	def plySkip(source PlySource, element PlyElement) !none {
		if source.form != plyAscii && element.fixed {
			fail ModelError{message: "ply: the data ends inside element `{element.name}`", format: "PLY", detail: "byte {source.pos}"} when source.pos + element.count * element.size > source.data.len()
			source.pos += element.count * element.size
			return none
		}
		for let i = 0; i < element.count; i++ {
			for let (_, p) in element.properties {
				let n = 1
				n = int(try source.scalar(p.countKind)) when p.list
				for let k = 0; k < n; k++ {
					try source.scalar(p.kind)
				}
			}
		}
		return none
	}
}
