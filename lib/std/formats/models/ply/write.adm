internal partial module std.formats.models.ply {
	use (
		std.bytes
		std.formats.models::*
		std.io
	)

	// PlyOut is what a PLY holds of a model: every placed mesh's vertices
	// in scene coordinates with the attributes any of them has, the
	// triangles and the edges as indices into them.
	type PlyOut {
		positions  float32[]
		normals    float32[]
		uvs        float32[]
		colors     float32[]
		triangles  uint32[]
		edges      uint32[]
		hasNormals bool
		hasUvs     bool
		hasColors  bool
		count      int

		def new() {
			triangles = uint32[]
			edges = uint32[]
		}
	}

	// plyCollect gathers the primitives of every node that shows a mesh. An
	// attribute one primitive has and another lacks is zero there (white
	// for a colour).
	def plyCollect(model Model) PlyOut {
		let out = new PlyOut()
		model.walk(def (node Node) bool {
			let mesh = node.mesh
			return true when mesh is none
			for let (_, p) in mesh.primitives {
				out.hasNormals = true when p.normals.len() == p.vertexCount() * 3 && p.normals.len() > 0
				out.hasUvs = true when p.uvs.len() > 0 && p.uvs[0].len() == p.vertexCount() * 2 && p.uvs[0].len() > 0
				out.hasColors = true when p.colors.len() > 0 && p.colors[0].len() == p.vertexCount() * 4 && p.colors[0].len() > 0
			}
			return true
		})
		model.walk(def (node Node) bool {
			let mesh = node.mesh
			return true when mesh is none
			let m = node.worldTransform()
			for let (_, source) in mesh.primitives {
				let placed = source.transformed(m)
				let n = placed.vertexCount()
				let base = out.count
				out.positions.push(...placed.positions)
				if out.hasNormals {
					out.normals.len((base + n) * 3)
					placed.normals.copy(out.normals[base * 3:]) when placed.normals.len() == n * 3
				}
				if out.hasUvs {
					out.uvs.len((base + n) * 2)
					placed.uvs[0].copy(out.uvs[base * 2:]) when placed.uvs.len() > 0 && placed.uvs[0].len() == n * 2
				}
				if out.hasColors {
					out.colors.len((base + n) * 4)
					if placed.colors.len() > 0 && placed.colors[0].len() == n * 4 {
						placed.colors[0].copy(out.colors[base * 4:])
					} else {
						out.colors[base * 4:].fill(float32(1))
					}
				}
				out.count += n
				match placed.topology {
					case Topology.Triangles, Topology.TriangleStrip, Topology.TriangleFan:
						for let (_, i) in placed.triangleIndices() {
							out.triangles.push(uint32(base) + i)
						}
					case Topology.Lines:
						for let k = 0; k + 1 < placed.indexCount(); k += 2 {
							out.edges.push(uint32(base) + plyIndexOf(placed, k), uint32(base) + plyIndexOf(placed, k + 1))
						}
					case Topology.LineStrip, Topology.LineLoop:
						let count = placed.indexCount()
						for let k = 0; k + 1 < count; k++ {
							out.edges.push(uint32(base) + plyIndexOf(placed, k), uint32(base) + plyIndexOf(placed, k + 1))
						}
						out.edges.push(uint32(base) + plyIndexOf(placed, count - 1), uint32(base) + plyIndexOf(placed, 0)) when placed.topology == Topology.LineLoop && count > 2
					default:
				}
			}
			return true
		})
		return out
	}

	// plyIndexOf is the vertex the k-th drawn index names.
	def plyIndexOf(p Primitive, k int) uint32 {
		return p.indices[k] when p.indices.len() > 0
		return uint32(k)
	}

	// plyEncode writes the model as one PLY: text, or binary of either byte
	// order. Vertices are x, y, z as float, then nx, ny, nz, then s, t, then
	// red, green, blue, alpha as uchar, each group when a mesh has it; faces
	// are triangles (`list uchar int vertex_indices`), edges `vertex1` and
	// `vertex2`. The model's `comment` and `obj_info` metadata lead the
	// header.
	def plyEncode(model Model, writer io.Writer, binary bool, bigEndian bool) !none {
		let out = plyCollect(model)
		let head = new bytes.Buffer()
		let form = binary ?? (bigEndian ?? ("binary_big_endian", "binary_little_endian"), "ascii")
		try head.writeString("ply\nformat {form} 1.0\n")
		for let (_, key) in string["comment", "obj_info"] {
			let text = model.metadata.get(key)
			continue when text is none
			for let (_, line) in text.split("\n") {
				try head.writeString("{key} {line}\n")
			}
		}
		try head.writeString("element vertex {out.count}\nproperty float x\nproperty float y\nproperty float z\n")
		try head.writeString("property float nx\nproperty float ny\nproperty float nz\n") when out.hasNormals
		try head.writeString("property float s\nproperty float t\n") when out.hasUvs
		try head.writeString("property uchar red\nproperty uchar green\nproperty uchar blue\nproperty uchar alpha\n") when out.hasColors
		try head.writeString("element face {out.triangles.len() / 3}\nproperty list uchar int vertex_indices\n") when out.triangles.len() > 0
		try head.writeString("element edge {out.edges.len() / 2}\nproperty int vertex1\nproperty int vertex2\n") when out.edges.len() > 0
		try head.writeString("end_header\n")
		try writer.write(head.bytes())
		return plyWriteBinary(out, writer, bigEndian) when binary
		return plyWriteText(out, writer)
	}

	// plyChannel is a colour channel in 0..1 as a byte.
	def plyChannel(v float32) byte {
		return byte((float(v) * 255.0).round().clamp(0.0, 255.0))
	}

	// plyPut32 stores the 32 bits at the offset in the byte order.
	def plyPut32(out byte[], at int, v uint32, big bool) {
		for let k = 0; k < 4; k++ {
			out[at + (big ?? (3 - k, k))] = byte((v >> uint32(8 * k)) & 0xFF)
		}
	}

	def plyWriteBinary(out PlyOut, writer io.Writer, big bool) !none {
		let size = 12 + (out.hasNormals ?? (12, 0)) + (out.hasUvs ?? (8, 0)) + (out.hasColors ?? (4, 0))
		let data byte[]
		data.len(out.count * size + out.triangles.len() / 3 * 13 + out.edges.len() * 4)
		for let v = 0; v < out.count; v++ {
			let at = v * size
			for let k = 0; k < 3; k++ {
				plyPut32(data, at + k * 4, __bitcast_u32_from_f32(out.positions[v * 3 + k]), big)
			}
			at += 12
			if out.hasNormals {
				for let k = 0; k < 3; k++ {
					plyPut32(data, at + k * 4, __bitcast_u32_from_f32(out.normals[v * 3 + k]), big)
				}
				at += 12
			}
			if out.hasUvs {
				for let k = 0; k < 2; k++ {
					plyPut32(data, at + k * 4, __bitcast_u32_from_f32(out.uvs[v * 2 + k]), big)
				}
				at += 8
			}
			if out.hasColors {
				for let k = 0; k < 4; k++ {
					data[at + k] = plyChannel(out.colors[v * 4 + k])
				}
			}
		}
		let at = out.count * size
		for let t = 0; t + 2 < out.triangles.len(); t += 3 {
			data[at] = 3
			for let k = 0; k < 3; k++ {
				plyPut32(data, at + 1 + k * 4, out.triangles[t + k], big)
			}
			at += 13
		}
		for let (_, v) in out.edges {
			plyPut32(data, at, v, big)
			at += 4
		}
		try writer.write(data)
		return none
	}

	def plyWriteText(out PlyOut, writer io.Writer) !none {
		let buf = new bytes.Buffer()
		for let v = 0; v < out.count; v++ {
			try buf.writeString("{plyText(out.positions[v * 3])} {plyText(out.positions[v * 3 + 1])} {plyText(out.positions[v * 3 + 2])}")
			try buf.writeString(" {plyText(out.normals[v * 3])} {plyText(out.normals[v * 3 + 1])} {plyText(out.normals[v * 3 + 2])}") when out.hasNormals
			try buf.writeString(" {plyText(out.uvs[v * 2])} {plyText(out.uvs[v * 2 + 1])}") when out.hasUvs
			try buf.writeString(" {plyChannel(out.colors[v * 4])} {plyChannel(out.colors[v * 4 + 1])} {plyChannel(out.colors[v * 4 + 2])} {plyChannel(out.colors[v * 4 + 3])}") when out.hasColors
			try buf.writeString("\n")
			if buf.len() > 65536 {
				try writer.write(buf.bytes())
				buf.reset()
			}
		}
		for let t = 0; t + 2 < out.triangles.len(); t += 3 {
			try buf.writeString("3 {out.triangles[t]} {out.triangles[t + 1]} {out.triangles[t + 2]}\n")
			if buf.len() > 65536 {
				try writer.write(buf.bytes())
				buf.reset()
			}
		}
		for let e = 0; e + 1 < out.edges.len(); e += 2 {
			try buf.writeString("{out.edges[e]} {out.edges[e + 1]}\n")
		}
		try writer.write(buf.bytes())
		return none
	}

	// plyText is the shortest text that reads back as the same float32.
	def plyText(v float32) string {
		return "%.9g".format(float(v))
	}
}
