// Reading the files a model refers to beside its own, for the codecs whose
// formats name them.
internal partial module std.formats.models.resource {
	use (
		std.formats.models::*
		std.io
	)

	// openResource opens a file beside the model, none when it is not there.
	def openResource(resources ResourceReader, name string) ?io.Reader {
		let r ?io.Reader
		r = resources.open(name) onerror (err error) {
			return none
		}
		return r
	}

	def closeResource(r io.Reader) {
		if r is io.Closer {
			r.close() onerror recover none
		}
	}

	// loadTexture reads the texture's file into the model's resources,
	// by its name, else under the library's directory.
	def loadTexture(t Texture, model Model, resources ?ResourceReader, dir string) {
		let res = resources
		return when res is none
		return when model.resources.hasKey(t.source)
		let names = string[t.source]
		names.push(dir + "/" + t.source) when dir.len() > 0
		for let (_, name) in names {
			let r = openResource(res, name)
			continue when r is none
			let data = io.readAll(r) onerror recover byte[]
			closeResource(r)
			continue when data.len() == 0
			t.source = name
			model.resources.set(name, data)
			return
		}
	}
}
