partial module std.formats.models {
	// Skin is how a mesh follows a skeleton: the joint nodes, in the order a
	// primitive's `joints` index them, and the matrix that takes each joint's
	// bind pose back to the mesh's coordinates.
	type Skin {
		name                string
		joints              Node[]
		// One per joint, column-major; empty for identity.
		inverseBindMatrices matrix<float, 4, 4>[]
		// The node the joints hang from, none when it is the scene root.
		skeleton            ?Node

		def new(name string = "") {
			self.name = name
			joints = Node[]
		}

		// jointMatrices is, per joint, the matrix that moves a bind-pose vertex
		// to where the joint's node now stands: the joint's world matrix times
		// its inverse bind matrix, in the skinned node's coordinates.
		def jointMatrices(skinned Node) matrix<float, 4, 4>[] {
			let out matrix<float, 4, 4>[]
			let toLocal = invertAffine(skinned.worldTransform())
			for let (j, joint) in joints {
				let m = toLocal * joint.worldTransform()
				m = m * inverseBindMatrices[j] when j < inverseBindMatrices.len()
				out.push(m)
			}
			return out
		}
	}

	// invertAffine inverts a transform whose last row is 0 0 0 1 (every node
	// transform is one): the inverse of its 3×3 part and the translation
	// taken back through it. A singular matrix gives the identity.
	internal def invertAffine(m matrix<float, 4, 4>) matrix<float, 4, 4> {
		let a = m[0][0]
		let b = m[0][1]
		let c = m[0][2]
		let d = m[1][0]
		let e = m[1][1]
		let f = m[1][2]
		let g = m[2][0]
		let h = m[2][1]
		let i = m[2][2]
		let det = a * (e * i - f * h) - b * (d * i - f * g) + c * (d * h - e * g)
		let out = matrix<float, 4, 4>[]
		if det == 0 {
			for let k = 0; k < 4; k++ {
				out[k][k] = 1
			}
			return out
		}
		let r = 1.0 / det
		out[0][0] = (e * i - f * h) * r
		out[0][1] = (c * h - b * i) * r
		out[0][2] = (b * f - c * e) * r
		out[1][0] = (f * g - d * i) * r
		out[1][1] = (a * i - c * g) * r
		out[1][2] = (c * d - a * f) * r
		out[2][0] = (d * h - e * g) * r
		out[2][1] = (b * g - a * h) * r
		out[2][2] = (a * e - b * d) * r
		let tx = m[0][3]
		let ty = m[1][3]
		let tz = m[2][3]
		out[0][3] = -(out[0][0] * tx + out[0][1] * ty + out[0][2] * tz)
		out[1][3] = -(out[1][0] * tx + out[1][1] * ty + out[1][2] * tz)
		out[2][3] = -(out[2][0] * tx + out[2][1] * ty + out[2][2] * tz)
		out[3][3] = 1
		return out
	}
}
