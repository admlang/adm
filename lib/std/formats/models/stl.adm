partial module std.formats.models {
	use (
		std.io
		std.formats.models.stl::*
	)

	// Stl is stereolithography: a list of triangles with face normals and no
	// materials, as text (`solid ... endsolid`) or binary (an 80-byte header,
	// a count and 50 bytes per triangle). Reads both into one mesh per solid,
	// each at a node of the solid's name, with the vertices merged
	// (Primitive.indexed) and the file's face normals dropped, since they
	// follow from the winding and are often wrong (computeNormals rebuilds
	// them); writes every placed mesh's triangles, in scene coordinates, as
	// one solid, in the binary form unless `binary` says otherwise. Colours
	// in the binary attribute word (Materialise and VisCAM conventions) are
	// read into a vertex colour set, and a colour set is written in the
	// VisCAM form. A file whose declared triangle count fits its size is
	// binary, whatever its header says.
	@codec("STL")
	type Stl {
		// Write the binary form; false writes text.
		binary bool   = true
		// The solid's name in the text form and the binary header; empty uses
		// the model's name.
		name   string = ""

		mimeType string[] {
			def get() string[] {
				return string["model/stl"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".stl"]
			}
		}

		// matchSignature tests for the text form's `solid` keyword; the binary
		// form has no signature and is found by its file extension.
		def matchSignature(r io.Reader) bool {
			return string(prefix(r, 5)) == "solid"
		}

		// decode reads the whole reader as STL, text or binary. Fails with a
		// ModelError when the text is malformed, or with the reader's own
		// error.
		def decode(reader io.Reader, resources ?ResourceReader) !Model {
			let data = try io.readAll(reader)
			return stlDecode(data)
		}

		// encode writes every placed mesh's triangles as one solid. Fails with
		// the writer's own error.
		def encode(model Model, writer io.Writer, resources ?ResourceWriter) !none {
			return stlEncode(model, writer, binary, name)
		}
	}
}
