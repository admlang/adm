internal partial module std.formats.models.stl {
	use (
		std.formats.models::*
		std.formats.models.text::*
		std.gfx.bands
		std.simd
	)

	// stlDecode reads text or binary STL from the bytes: one mesh of
	// triangles per solid, each at a node of the solid's name. A file is
	// binary when its declared triangle count fits its size, whatever its
	// header says; the file's face normals are dropped (they follow from the
	// winding, and are often wrong) and the vertices are merged.
	def stlDecode(data byte[]) !Model {
		let model = new Model()
		if stlIsBinary(data) {
			try stlDecodeBinary(data, model)
		} else {
			try stlDecodeText(data, model)
		}
		for let (_, mesh) in model.meshes {
			for let (_, prim) in mesh.primitives {
				prim.indexed()
			}
		}
		return model
	}

	// stlIsBinary reports whether the bytes are a binary STL: a header, a
	// count, and at least that many 50-byte triangles.
	def stlIsBinary(data byte[]) bool {
		return false when data.len() < 84
		let count = int(stlLE32(data, 80))
		return count >= 0 && data.len() >= 84 + 50 * count && (count > 0 || data.len() == 84)
	}

	def stlLE32(data byte[], at int) uint32 {
		return uint32(data[at]) | (uint32(data[at + 1]) << 8) | (uint32(data[at + 2]) << 16) | (uint32(data[at + 3]) << 24)
	}

	def stlFloat32At(data byte[], at int) float32 {
		return __bitcast_f32_from_u32(stlLE32(data, at))
	}

	// stlDecodeBinary appends the binary file's triangles as one mesh.
	def stlDecodeBinary(data byte[], model Model) !none {
		let count = int(stlLE32(data, 80))
		let name = stlHeaderName(data)
		let mesh = new Mesh(name)
		let prim = mesh.add(new Primitive())
		// Three slots of slack: the vector copy of a record writes 12 floats
		// where the record has 9, and the next record's copy overwrites them.
		prim.positions.len(count * 9 + 3)
		let positions = prim.positions
		if count > 0 {
			bands.forBands(count, count, (from int, to int) => {
				// All but the band's last record take the vector path, which
				// reads 10 bytes into the next record and writes 3 floats
				// into the next record's slots; the last record is the next
				// band's, or past the end of the file, so it is copied by hand.
				for let t = from; t + 1 < to; t++ {
					let at = 84 + 50 * t + 12
					simd.store4(positions, 9 * t, simd.loadBytes16(data, at).bitcast4<float32>())
					simd.store4(positions, 9 * t + 4, simd.loadBytes16(data, at + 16).bitcast4<float32>())
					simd.store4(positions, 9 * t + 8, simd.loadBytes16(data, at + 32).bitcast4<float32>())
				}
				let last = to - 1
				let at = 84 + 50 * last + 12
				for let k = 0; k < 9; k++ {
					positions[9 * last + k] = stlFloat32At(data, at + 4 * k)
				}
			})
		}
		positions.len(count * 9)
		stlDecodeColors(data, count, prim)
		model.meshes.push(mesh)
		let node = new Node(name)
		node.mesh = mesh
		model.nodes.push(node)
		model.name = name when model.name.len() == 0
		return none
	}

	// stlHeaderName is the text of the binary header up to its first NUL or
	// a Materialise `COLOR=` tag, trimmed, without a leading `solid`.
	def stlHeaderName(data byte[]) string {
		let end = 0
		for end < 80 && data[end] != 0 {
			end++
		}
		let color = stlHeaderColorAt(data)
		end = end.min(color - 6) when color >= 0
		let text = string(data[:end]).trim()
		text = text[5:].trim() when text.startsWith("solid")
		return text
	}

	// stlDecodeColors reads the per-triangle attribute words as colours when
	// any carries one: VisCAM/SolidView set bit 15 of a 5-bit RGB word;
	// Materialise Magics declare `COLOR=` in the header, with a default colour
	// after it, and clear bit 15 of a 5-bit BGR word to use the word's colour.
	def stlDecodeColors(data byte[], count int, prim Primitive) {
		let materialise = stlHeaderColorAt(data)
		let any = false
		for let t = 0; t < count && !any; t++ {
			let word = int(data[84 + 50 * t + 48]) | (int(data[84 + 50 * t + 49]) << 8)
			any = (word & 0x8000 != 0) == (materialise < 0)
		}
		return unless any
		let colors float32[]
		colors.len(count * 12)
		for let t = 0; t < count; t++ {
			let word = int(data[84 + 50 * t + 48]) | (int(data[84 + 50 * t + 49]) << 8)
			let r = 1.0
			let g = 1.0
			let b = 1.0
			if materialise >= 0 {
				if word & 0x8000 == 0 {
					r = float(word & 31) / 31.0
					g = float((word >> 5) & 31) / 31.0
					b = float((word >> 10) & 31) / 31.0
				} else {
					r = float(data[materialise]) / 255.0
					g = float(data[materialise + 1]) / 255.0
					b = float(data[materialise + 2]) / 255.0
				}
			} else if word & 0x8000 != 0 {
				b = float(word & 31) / 31.0
				g = float((word >> 5) & 31) / 31.0
				r = float((word >> 10) & 31) / 31.0
			}
			for let v = 0; v < 3; v++ {
				let at = t * 12 + v * 4
				colors[at] = float32(r)
				colors[at + 1] = float32(g)
				colors[at + 2] = float32(b)
				colors[at + 3] = 1.0
			}
		}
		prim.colors.push(colors)
	}

	// stlHeaderColorAt is the offset of the default colour's bytes after a
	// `COLOR=` in the header, -1 when the header has none.
	def stlHeaderColorAt(data byte[]) int {
		let tag = "COLOR=".bytes()
		for let i = 0; i + tag.len() + 4 <= 80; i++ {
			let hit = true
			for let k = 0; k < tag.len() && hit; k++ {
				hit = data[i + k] == tag[k]
			}
			return i + tag.len() when hit
		}
		return -1
	}

	// stlDecodeText appends the text file's solids, one mesh each.
	def stlDecodeText(data byte[], model Model) !none {
		let s = new TextScanner(data, "STL", "stl")
		for {
			let word = s.word()
			break when word.len() == 0
			fail ModelError{message: "stl: expected `solid`, found `{word}`", format: "STL", detail: "line {s.line}"} when word != "solid"
			let name = s.restOfLine()
			let mesh = new Mesh(name)
			let prim = mesh.add(new Primitive())
			let positions = prim.positions
			let open = true
			for open {
				let token = s.word()
				match token {
					case "facet":
						let kind = s.word()
						fail ModelError{message: "stl: expected `facet normal`, found `facet {kind}`", format: "STL", detail: "line {s.line}"} when kind != "normal"
						// The normal is read and dropped: it follows from the winding.
						for let k = 0; k < 3; k++ {
							try s.number()
						}
						let next = s.word()
						if next == "outer" {
							let loop = s.word()
							fail ModelError{message: "stl: expected `outer loop`, found `outer {loop}`", format: "STL", detail: "line {s.line}"} when loop != "loop"
							next = s.word()
						}
						let vertices = 0
						for next == "vertex" {
							for let k = 0; k < 3; k++ {
								positions.push(try s.number())
							}
							vertices++
							next = s.word()
						}
						fail ModelError{message: "stl: a facet has {vertices} vertices, not 3", format: "STL", detail: "line {s.line}"} when vertices != 3
						next = s.word() when next == "endloop"
						fail ModelError{message: "stl: expected `endfacet`, found `{next}`", format: "STL", detail: "line {s.line}"} when next != "endfacet"
					case "endsolid":
						s.restOfLine()
						open = false
					case "":
						fail ModelError{message: "stl: `solid {name}` has no `endsolid`", format: "STL", detail: "line {s.line}"}
					default:
						fail ModelError{message: "stl: unexpected `{token}`", format: "STL", detail: "line {s.line}"}
				}
			}
			model.meshes.push(mesh)
			let node = new Node(name)
			node.mesh = mesh
			model.nodes.push(node)
			model.name = name when model.name.len() == 0
		}
		return none
	}
}
