internal partial module std.formats.models.stl {
	use (
		std.bytes
		std.formats.models::*
		std.io
		std.math::(*)
		std.simd
	)

	// stlEncode writes every placed mesh's triangles, in scene coordinates,
	// as one solid: text or binary. A vertex colour set goes into the binary
	// attribute words in the VisCAM form.
	def stlEncode(model Model, writer io.Writer, binary bool, name string) !none {
		let solid = name.len() > 0 ?? (name, model.name)
		let triangles = stlCollect(model)
		return stlWriteBinary(triangles, writer, solid) when binary
		return stlWriteText(triangles, writer, solid)
	}

	// StlTriangles is the triangles to write: positions in scene coordinates,
	// 9 per triangle, and one colour per triangle (4 values) or none.
	type StlTriangles {
		positions float32[]
		colors    float32[]
		count     int       = 0

		def new() {}
	}

	// stlCollect gathers the triangles of every node that shows a mesh,
	// transformed to scene coordinates.
	def stlCollect(model Model) StlTriangles {
		let out = new StlTriangles()
		model.walk(def (node Node) bool {
			let mesh = node.mesh
			return true when mesh is none
			let m = node.worldTransform()
			for let (_, source) in mesh.primitives {
				continue unless source.topology == Topology.Triangles || source.topology == Topology.TriangleStrip || source.topology == Topology.TriangleFan
				let tris = source.triangleIndices()
				continue when tris.len() < 3
				let colored = source.colors.len() > 0
				let colors = colored ?? (source.colors[0], float32[])
				let p = source.positions
				let base = out.positions.len()
				out.positions.len(base + tris.len() * 3)
				for let k = 0; k < tris.len(); k++ {
					let i = int(tris[k]) * 3
					let x = float(p[i])
					let y = float(p[i + 1])
					let z = float(p[i + 2])
					out.positions[base + k * 3] = float32(m[0][0] * x + m[0][1] * y + m[0][2] * z + m[0][3])
					out.positions[base + k * 3 + 1] = float32(m[1][0] * x + m[1][1] * y + m[1][2] * z + m[1][3])
					out.positions[base + k * 3 + 2] = float32(m[2][0] * x + m[2][1] * y + m[2][2] * z + m[2][3])
				}
				let added = tris.len() / 3
				if colored || out.colors.len() > 0 {
					// Triangles added before the first coloured one are white.
					for out.colors.len() < out.count * 4 {
						out.colors.push(1.0)
					}
					for let t = 0; t < added; t++ {
						let v = int(tris[t * 3]) * 4
						for let k = 0; k < 4; k++ {
							out.colors.push(colored ?? (colors[v + k], 1.0))
						}
					}
				}
				out.count += added
			}
			return true
		})
		return out
	}

	// stlNormal is the unit normal of the triangle at the position offset,
	// from its winding; zero for a degenerate triangle.
	def stlNormal(p float32[], at int) (float, float, float) {
		let ux = float(p[at + 3] - p[at])
		let uy = float(p[at + 4] - p[at + 1])
		let uz = float(p[at + 5] - p[at + 2])
		let vx = float(p[at + 6] - p[at])
		let vy = float(p[at + 7] - p[at + 1])
		let vz = float(p[at + 8] - p[at + 2])
		let nx = uy * vz - uz * vy
		let ny = uz * vx - ux * vz
		let nz = ux * vy - uy * vx
		let len = sqrt(nx * nx + ny * ny + nz * nz)
		return (0.0, 0.0, 0.0) when len == 0
		return (nx / len, ny / len, nz / len)
	}

	def stlWriteBinary(tris StlTriangles, writer io.Writer, name string) !none {
		let out byte[]
		out.len(84 + 50 * tris.count)
		let header = name.bytes()
		for let i = 0; i < 80 && i < header.len(); i++ {
			out[i] = header[i]
		}
		let count = uint32(tris.count)
		out[80] = byte(count & 0xFF)
		out[81] = byte((count >> 8) & 0xFF)
		out[82] = byte((count >> 16) & 0xFF)
		out[83] = byte((count >> 24) & 0xFF)
		let record float32[]
		record.len(12)
		let p = tris.positions
		for let t = 0; t < tris.count; t++ {
			let (nx, ny, nz) = stlNormal(p, t * 9)
			record[0] = float32(nx)
			record[1] = float32(ny)
			record[2] = float32(nz)
			for let k = 0; k < 9; k++ {
				record[3 + k] = p[t * 9 + k]
			}
			let at = 84 + 50 * t
			simd.storeBytes16(out, at, simd.load4<float32>(record, 0).bitcast16<byte>())
			simd.storeBytes16(out, at + 16, simd.load4<float32>(record, 4).bitcast16<byte>())
			simd.storeBytes16(out, at + 32, simd.load4<float32>(record, 8).bitcast16<byte>())
			let word = 0
			if tris.colors.len() >= (t + 1) * 4 {
				let r = int((float(tris.colors[t * 4]) * 31.0).round()).clamp(0, 31)
				let g = int((float(tris.colors[t * 4 + 1]) * 31.0).round()).clamp(0, 31)
				let b = int((float(tris.colors[t * 4 + 2]) * 31.0).round()).clamp(0, 31)
				word = 0x8000 | (r << 10) | (g << 5) | b
			}
			out[at + 48] = byte(word & 0xFF)
			out[at + 49] = byte((word >> 8) & 0xFF)
		}
		try writer.write(out)
		return none
	}

	def stlWriteText(tris StlTriangles, writer io.Writer, name string) !none {
		let buf = new bytes.Buffer()
		try buf.writeString("solid {name}\n")
		let p = tris.positions
		for let t = 0; t < tris.count; t++ {
			let (nx, ny, nz) = stlNormal(p, t * 9)
			try buf.writeString("  facet normal {stlText(nx)} {stlText(ny)} {stlText(nz)}\n    outer loop\n")
			for let v = 0; v < 3; v++ {
				let at = t * 9 + v * 3
				try buf.writeString("      vertex {stlText(float(p[at]))} {stlText(float(p[at + 1]))} {stlText(float(p[at + 2]))}\n")
			}
			try buf.writeString("    endloop\n  endfacet\n")
			if buf.len() > 65536 {
				try writer.write(buf.bytes())
				buf.reset()
			}
		}
		try buf.writeString("endsolid {name}\n")
		try writer.write(buf.bytes())
		return none
	}

	// stlText is the shortest text that reads back as the same float32.
	def stlText(v float) string {
		return "%.9g".format(v)
	}
}
