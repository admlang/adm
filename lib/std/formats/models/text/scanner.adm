// The word and number scanner the text model formats (STL, OBJ and its
// material libraries, text PLY) read with.
internal module std.formats.models.text {
	use std.formats.models::*

	// Exact powers of ten for the fast float path.
	let textPow10 = float[1e0, 1e1, 1e2, 1e3, 1e4, 1e5, 1e6, 1e7, 1e8, 1e9, 1e10, 1e11, 1e12, 1e13, 1e14, 1e15, 1e16, 1e17, 1e18, 1e19, 1e20, 1e21, 1e22]

	// TextScanner walks the words and numbers of a text model file. Errors
	// name the format and the line, counted from `line`'s starting value, so
	// a scanner over a part of a file reports lines relative to that part.
	type TextScanner {
		data   byte[]
		pos    int    = 0
		// The line the scanner is on, from 1.
		line   int    = 1
		// The format named in errors, as registered with `codec`, and the
		// short name that prefixes the message (`stl`, `obj`).
		format string
		prefix string

		def new(data byte[], format string, prefix string) {
			self.data = data
			self.format = format
			self.prefix = prefix
		}

		def isSpace(c byte) bool {
			return c == 0x20 || c == 0x0A || c == 0x09 || c == 0x0D || c == 0x0B || c == 0x0C
		}

		// skipSpace skips whitespace, newlines included.
		def skipSpace() {
			for pos < data.len() {
				let c = data[pos]
				if c == 0x0A {
					line++
				} else if c != 0x20 && c != 0x09 && c != 0x0D && c != 0x0B && c != 0x0C {
					return
				}
				pos++
			}
		}

		// skipBlanks skips spaces and tabs within the line, and a `\` that
		// continues the line onto the next one.
		def skipBlanks() {
			for pos < data.len() {
				let c = data[pos]
				if c := 0x20 || 0x09 || 0x0B || 0x0C {
					pos++
				} else if c == 0x0D && pos + 1 < data.len() && data[pos + 1] != 0x0A {
					pos++
				} else if c == 0x5C && pos + 1 < data.len() && data[pos + 1] == 0x0A {
					pos += 2
					line++
				} else if c == 0x5C && pos + 2 < data.len() && data[pos + 1] == 0x0D && data[pos + 2] == 0x0A {
					pos += 3
					line++
				} else {
					return
				}
			}
		}

		// atLineEnd reports whether the rest of the line is blank or a `#`
		// comment, after skipping blanks.
		def atLineEnd() bool {
			skipBlanks()
			return true when pos >= data.len()
			let c = data[pos]
			return c == 0x0A || c == 0x0D || c == 0x23
		}

		// skipLine moves past the end of the current line.
		def skipLine() {
			for pos < data.len() && data[pos] != 0x0A {
				pos++
			}
			if pos < data.len() {
				pos++
				line++
			}
		}

		// word is the next whitespace-delimited token in lower case, empty at
		// the end.
		def word() string {
			skipSpace()
			let start = pos
			for pos < data.len() && !isSpace(data[pos]) {
				pos++
			}
			return string(data[start:pos]).lower()
		}

		// token is the next token of the current line as written, empty at
		// the end of the line.
		def token() string {
			skipBlanks()
			let start = pos
			for pos < data.len() && !isSpace(data[pos]) {
				pos++
			}
			return string(data[start:pos])
		}

		// restOfLine is the rest of the current line, trimmed, with a `#`
		// comment kept (names may hold one).
		def restOfLine() string {
			let start = pos
			for pos < data.len() && data[pos] != 0x0A {
				pos++
			}
			let text = string(data[start:pos]).trim()
			if pos < data.len() {
				pos++
				line++
			}
			return text
		}

		// integer reads the next token of the line as an int, stopping at
		// `/` as well as at whitespace. Fails when there are no digits.
		def integer() !int {
			skipBlanks()
			let start = pos
			let negative = false
			if pos < data.len() && (data[pos] == 0x2D || data[pos] == 0x2B) {
				negative = data[pos] == 0x2D
				pos++
			}
			let value = 0
			let seen = false
			for pos < data.len() && data[pos] >= 0x30 && data[pos] <= 0x39 {
				value = value * 10 + int(data[pos] - 0x30) when value < 1000000000000
				seen = true
				pos++
			}
			fail ModelError{message: "{prefix}: expected an index, found `{string(data[start:pos]).trim()}`", format: format, detail: "line {line}"} unless seen
			return negative ?? (-value, value)
		}

		// number reads the next token as a float32. Fails when it is not a
		// number.
		def number() !float32 {
			return float32(try value())
		}

		// value reads the next token as a float. Fails when it is not a
		// number.
		def value() !float {
			skipSpace()
			let start = pos
			let negative = false
			if pos < data.len() && (data[pos] == 0x2D || data[pos] == 0x2B) {
				negative = data[pos] == 0x2D
				pos++
			}
			let mantissa uint64 = 0
			let digits = 0
			let exponent = 0
			let seen = false
			for pos < data.len() && data[pos] >= 0x30 && data[pos] <= 0x39 {
				if digits < 19 {
					mantissa = mantissa * 10 + uint64(data[pos] - 0x30)
					digits++ when mantissa != 0
				} else {
					exponent++
				}
				seen = true
				pos++
			}
			if pos < data.len() && data[pos] == 0x2E {
				pos++
				for pos < data.len() && data[pos] >= 0x30 && data[pos] <= 0x39 {
					if digits < 19 {
						mantissa = mantissa * 10 + uint64(data[pos] - 0x30)
						digits++ when mantissa != 0
						exponent--
					}
					seen = true
					pos++
				}
			}
			fail ModelError{message: "{prefix}: expected a number, found `{string(data[start:pos]).trim()}`", format: format, detail: "line {line}"} unless seen
			if pos < data.len() && (data[pos] == 0x65 || data[pos] == 0x45) {
				pos++
				let expNegative = false
				if pos < data.len() && (data[pos] == 0x2D || data[pos] == 0x2B) {
					expNegative = data[pos] == 0x2D
					pos++
				}
				let e = 0
				let expDigits = false
				for pos < data.len() && data[pos] >= 0x30 && data[pos] <= 0x39 {
					e = e * 10 + int(data[pos] - 0x30) when e < 10000
					expDigits = true
					pos++
				}
				fail ModelError{message: "{prefix}: expected an exponent, found `{string(data[start:pos]).trim()}`", format: format, detail: "line {line}"} unless expDigits
				exponent += expNegative ?? (-e, e)
			}
			if pos < data.len() && !isSpace(data[pos]) {
				// Letters after the digits: the token is not a number.
				for pos < data.len() && !isSpace(data[pos]) {
					pos++
				}
				fail ModelError{message: "{prefix}: expected a number, found `{string(data[start:pos])}`", format: format, detail: "line {line}"}
			}
			let result float
			if exponent.abs() <= 22 {
				// Exact for the mantissa and the power, one rounding in the
				// multiply: within a float64 ulp, far inside a float32's.
				result = float(mantissa)
				result = exponent >= 0 ?? (result * textPow10[exponent], result / textPow10[-exponent])
			} else {
				result = parseFloat<float>(string(data[start:pos]))
			}
			return negative ?? (-result, result)
		}

		// lineNumber is the next token as a float32 when the line has one,
		// none at the line's end. Fails when the token is not a number.
		def lineNumber() !?float32 {
			return none when atLineEnd()
			return try number()
		}

		// lineValue is the next token as a float when the line has one, none
		// at the line's end. Fails when the token is not a number.
		def lineValue() !?float {
			return none when atLineEnd()
			return try value()
		}
	}
}
