partial module std.formats.playlist {
	use (
		std.io
		std.formats.playlist.loader::*
	)

	// M3U is the M3U playlist: one location per line, with the extended
	// `#EXTM3U` / `#EXTINF:<seconds>,<artist> - <title>` lines when
	// `extended`. `.m3u8` is the same format, always UTF-8.
	@codec("M3U")
	type M3U {
		// Whether `write` emits the `#EXTM3U` header and `#EXTINF` lines.
		extended bool = true

		extension string[] {
			def get() string[] {
				return string[".m3u", ".m3u8"]
			}
		}

		mimeType string[] {
			def get() string[] {
				return string["audio/x-mpegurl", "application/vnd.apple.mpegurl"]
			}
		}

		// matchSignature implements SignatureMatcher: an `#EXTM3U` first line.
		def matchSignature(r io.Reader) bool {
			return firstLine(head(r, 64)).startsWith("#EXTM3U")
		}

		// read implements PlaylistFormat. Lines starting `#` other than
		// `#EXTINF` and `#EXTALB` are skipped.
		// Fails when the reader fails.
		def read(reader io.Reader) !PlaylistEntry[] {
			let text = try readText(reader)
			let entries PlaylistEntry[]
			let title = ""
			let artist = ""
			let album = ""
			let length = 0s
			for let (_, raw) in text.lines() {
				let line = raw.trim()
				continue when line == ""
				if line.startsWith("#EXTINF:") {
					let info = line["#EXTINF:".len():]
					let comma = info.indexOf(",")
					let seconds = comma < 0 ?? (info, info[:comma])
					// Attributes (`tvg-id="…"`) may follow the seconds.
					let space = seconds.indexOf(" ")
					length = lengthOf(space < 0 ?? (seconds, seconds[:space]))
					(artist, title) = splitDisplay(comma < 0 ?? ("", info[comma + 1:]))
					continue
				}
				if line.startsWith("#EXTALB:") {
					album = line["#EXTALB:".len():].trim()
					continue
				}
				continue when line.startsWith("#")
				entries.push(PlaylistEntry{location: line, title: title, artist: artist, album: album, length: length})
				title = ""
				artist = ""
				album = ""
				length = 0s
			}
			return entries
		}

		// write implements PlaylistFormat.
		// Fails when the writer fails.
		def write(entries PlaylistEntry[], writer io.Writer) !none {
			try put(writer, "#EXTM3U\n") when extended
			for let (_, entry) in entries {
				if extended {
					try put(writer, "#EXTINF:{secondsOf(entry.length)},{display(entry)}\n")
					try put(writer, "#EXTALB:{entry.album}\n") when entry.album != ""
				}
				try put(writer, "{entry.location}\n")
			}
		}
	}
}
