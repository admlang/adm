partial module std.formats.playlist {
	use (
		std.io
		std.os
		std.bytes
		std.reflection
		std.formats
		std.formats.playlist.loader::*
	)

	// One entry of a playlist file: where the media is and what the file says
	// about it. Fields the format does not carry stay empty.
	struct PlaylistEntry {
		// The path or URL as the file writes it. `load(path)` resolves a
		// relative path against the playlist file's folder.
		location string
		title    string
		artist   string
		album    string
		// 0s when the file does not say (M3U `#EXTINF:-1`).
		length   duration
	}

	// PlaylistFormat reads and writes one playlist file format.
	interface PlaylistFormat {
		// read parses the entries of a playlist file.
		// Fails when the data is not this format, or the reader fails.
		def read(reader io.Reader) !PlaylistEntry[]

		// write writes entries in this format.
		// Fails when the writer fails.
		def write(entries PlaylistEntry[], writer io.Writer) !none
	}

	// PlaylistCodec is what a playlist format registers.
	type PlaylistCodec = PlaylistFormat & formats.FileFormat

	// codec registers a playlist format under `name`.
	meta def codec<PlaylistCodec>(ctx reflection.DiscoveryMetaContext<reflection.TypeMetaContext>, name string) {}

	// load reads the playlist file at `path`, picking the format by extension,
	// else by content. Relative locations come back resolved against the
	// file's folder.
	// Fails when no registered format reads the file, or it cannot be read.
	def load(path string) !PlaylistEntry[] {
		let data = try os.readFile(path)
		let format = codecRegistry.matchExt(os.extension(path))
		let entries PlaylistEntry[]
		if format is none {
			entries = try load(new bytes.Reader(data))
		} else {
			entries = try format.read(new bytes.Reader(data))
		}
		let folder = os.dir(path)
		let resolved PlaylistEntry[]
		for let (_, entry) in entries {
			entry.location = os.join(folder, entry.location) when !isURL(entry.location) && !os.isAbs(entry.location)
			resolved.push(entry)
		}
		return resolved
	}

	// load reads a playlist from `reader`, picking the format by content.
	// Locations come back as written.
	// Fails when no registered format reads the data, or the reader fails.
	def load(reader io.Reader) !PlaylistEntry[] {
		let (format, r) = try codecRegistry.probe(reader)
		return format.read(r)
	}

	// save writes entries to `path` in the format its extension names.
	// Locations under the file's folder are written relative to it.
	// Fails when no registered format has the extension, or the file cannot
	// be written.
	def save(entries PlaylistEntry[], path string) !none {
		let format = codecRegistry.matchExt(os.extension(path))
		fail "no playlist format has the extension \"{os.extension(path)}\"" when format is none
		let prefix = os.dir(path) + "/"
		let written PlaylistEntry[]
		for let (_, entry) in entries {
			entry.location = entry.location[prefix.len():] when prefix != "/" && entry.location.startsWith(prefix)
			written.push(entry)
		}
		let out = new bytes.Buffer()
		try format.write(written, out)
		return os.writeFile(path, out.bytes())
	}
}

internal partial module std.formats.playlist.loader {
	use (
		std.io
		std.bytes
		std.formats
		std.formats.playlist::*
	)

	let codecRegistry = new formats.CodecRegistry<PlaylistCodec>("playlist", codec)

	// Whether `location` is a URL rather than a path.
	def isURL(location string) bool {
		return location.contains("://")
	}

	// The whole of `reader` as text, without a UTF-8 byte order mark.
	// Fails when the reader does.
	def readText(reader io.Reader) !string {
		let buffer = new bytes.Buffer()
		try buffer.readFrom(reader)
		let text = string(buffer.bytes())
		return text.trimPrefix("\uFEFF")
	}

	// Up to `count` bytes from the start of `reader` as text, for a signature
	// test; what a failing reader gave before it failed.
	def head(reader io.Reader, count int) string {
		let out byte[]
		let buf byte[]
		buf.len(count)
		for out.len() < count {
			let n = reader.read(buf[:count - out.len()]) onerror recover 0
			break when n <= 0
			for let i = 0; i < n; i++ {
				out.push(buf[i])
			}
		}
		return string(out).trimPrefix("\uFEFF")
	}

	// The first line of `text` that is not blank, trimmed.
	def firstLine(text string) string {
		for let (_, line) in text.lines() {
			let trimmed = line.trim()
			return trimmed when trimmed != ""
		}
		return ""
	}

	// Splits the `Artist - Title` a playlist shows into artist and title; a
	// display without the separator is all title.
	def splitDisplay(display string) (string, string) {
		let at = display.indexOf(" - ")
		return ("", display.trim()) when at < 0
		return (display[:at].trim(), display[at + 3:].trim())
	}

	// The `Artist - Title` a playlist shows for an entry.
	def display(entry PlaylistEntry) string {
		return entry.title when entry.artist == ""
		return "{entry.artist} - {entry.title}"
	}

	// The length a playlist writes in seconds; 0 or less is unknown.
	def lengthOf(seconds string) duration {
		let value = parseFloat<float64>(seconds)
		return 0s when value <= 0.0
		return duration(int64(value * 1000000000.0))
	}

	// Whole seconds of `length` as a playlist writes them, -1 when unknown.
	def secondsOf(length duration) int64 {
		return int64(-1) when length <= 0s
		return (int64(length) + 500000000) / 1000000000
	}

	// The value numbered `n`, "" when there is none.
	def valueOf(values map<int, string>, n int) string {
		let value = values.get(n)
		return "" when value is none
		return value
	}

	// Writes `text` to `writer`.
	// Fails when the writer does.
	def put(writer io.Writer, text string) !none {
		try writer.write(text.bytes())
	}
}
