partial module std.formats.playlist {
	use (
		std.testing
		std.bytes
		std.os
		std.formats.playlist.loader::*
	)

	check "Playlist formats" {
		internal def text(content string) bytes.Reader {
			return new bytes.Reader(content.bytes())
		}

		internal def written(format PlaylistFormat, entries PlaylistEntry[]) !string {
			let out = new bytes.Buffer()
			try format.write(entries, out)
			return string(out.bytes())
		}

		internal def saves(entries PlaylistEntry[], path string) bool {
			save(entries, path) onerror (err error) {
				return false
			}
			return true
		}

		internal def scratch() !string {
			let dir = os.join(try os.appHome(), "playlist-test")
			try os.mkdir(dir) unless try os.exists(dir)
			return dir
		}

		@test()
		def TestM3URead() !none {
			let data = "﻿#EXTM3U\r\n#EXTINF:215,Artist A - Song One\r\n#EXTALB:Album\r\nmusic/one.mp3\r\n\r\n# a comment\r\n#EXTINF:-1 tvg-id=\"x\",Radio\r\nhttp://radio.example/live\r\nplain.flac\r\n"
			let entries = try new M3U().read(text(data))
			assert entries.len() == 3
			assert entries[0].location == "music/one.mp3" && entries[0].artist == "Artist A"
			assert entries[0].title == "Song One" && entries[0].album == "Album"
			assert entries[0].length == duration(int64(215) * 1000000000)
			assert entries[1].location == "http://radio.example/live" && entries[1].title == "Radio"
			assert entries[1].artist == "" && entries[1].length == 0s
			assert entries[2].location == "plain.flac" && entries[2].title == "" && entries[2].album == ""
		}

		@test()
		def TestM3UWrite() !none {
			let entries = PlaylistEntry[PlaylistEntry{location:"a.mp3", title:"One", artist:"X", album:"Al", length:duration(int64(61500) * 1000000)}, PlaylistEntry{location:"b.ogg"}]
			assert (try written(new M3U(), entries)) == "#EXTM3U\n#EXTINF:62,X - One\n#EXTALB:Al\na.mp3\n#EXTINF:-1,\nb.ogg\n"
			let plain = new M3U()
			plain.extended = false
			assert (try written(plain, entries)) == "a.mp3\nb.ogg\n"
			let back = try new M3U().read(text(try written(new M3U(), entries)))
			assert back.len() == 2 && back[0].title == "One" && back[0].artist == "X" && back[0].album == "Al"
			assert back[0].length == duration(int64(62) * 1000000000) && back[1].location == "b.ogg"
		}

		@test()
		def TestPLSRead() !none {
			let data = "[other]\nFile1=nope\n\n[Playlist]\nNumberOfEntries=2\nfile2=b.mp3\nTitle2=Band - Two\nLength2=-1\nFile1=http://radio.example/a\nTitle1=Station\nLength1=30\nVersion=2\n"
			let entries = try new PLS().read(text(data))
			assert entries.len() == 2
			assert entries[0].location == "http://radio.example/a" && entries[0].title == "Station"
			assert entries[0].length == duration(int64(30) * 1000000000)
			assert entries[1].location == "b.mp3" && entries[1].artist == "Band" && entries[1].title == "Two"
			assert entries[1].length == 0s
			let missing = new PLS().read(text("File1=a.mp3\n")) onerror recover PlaylistEntry[]
			assert missing.len() == 0
		}

		@test()
		def TestPLSWrite() !none {
			let entries = PlaylistEntry[PlaylistEntry{location:"a.mp3", title:"One", artist:"X", length:duration(int64(5) * 1000000000)}, PlaylistEntry{location:"b.ogg"}]
			assert (try written(new PLS(), entries)) == "[playlist]\nFile1=a.mp3\nTitle1=X - One\nLength1=5\nFile2=b.ogg\nLength2=-1\nNumberOfEntries=2\nVersion=2\n"
		}

		@test()
		def TestSignatures() {
			assert new M3U().matchSignature(text("\uFEFF\n#EXTM3U\n"))
			assert !new M3U().matchSignature(text("song.mp3\n"))
			assert new PLS().matchSignature(text("\n[Playlist]\nFile1=a\n"))
			assert !new PLS().matchSignature(text("[other]\n"))
		}

		@test()
		def TestLoadProbe() !none {
			let m3u = try load(text("#EXTM3U\none.mp3\n"))
			assert m3u.len() == 1 && m3u[0].location == "one.mp3"
			let pls = try load(text("[playlist]\nFile1=two.mp3\n"))
			assert pls.len() == 1 && pls[0].location == "two.mp3"
			let unknown = load(text("just words\n")) onerror recover PlaylistEntry[PlaylistEntry{location:"failed"}]
			assert unknown.len() == 1 && unknown[0].location == "failed"
		}

		@test()
		def TestLoadSavePaths() !none {
			let dir = try scratch()
			let entries = PlaylistEntry[PlaylistEntry{location:os.join(dir, "sub", "a.mp3")}, PlaylistEntry{location:"/elsewhere/b.mp3"}, PlaylistEntry{location:"https://x.example/c.mp3"}]
			let path = os.join(dir, "list.m3u8")
			try save(entries, path)
			let raw = string(try os.readFile(path))
			assert raw.contains("\nsub/a.mp3\n") && raw.contains("\n/elsewhere/b.mp3\n")
			let back = try load(path)
			assert back.len() == 3
			assert back[0].location == os.join(dir, "sub", "a.mp3")
			assert back[1].location == "/elsewhere/b.mp3" && back[2].location == "https://x.example/c.mp3"
			assert !saves(entries, os.join(dir, "list.txt"))
		}
	}
}
