partial module std.formats.playlist {
	use (
		std.io
		std.formats.playlist.loader::*
	)

	// PLS is the Winamp/Shoutcast playlist: an INI `[playlist]` section with
	// `File<n>`, `Title<n>` and `Length<n>` keys.
	@codec("PLS")
	type PLS {
		extension string[] {
			def get() string[] {
				return string[".pls"]
			}
		}

		mimeType string[] {
			def get() string[] {
				return string["audio/x-scpls"]
			}
		}

		// matchSignature implements SignatureMatcher: a `[playlist]` section.
		def matchSignature(r io.Reader) bool {
			return firstLine(head(r, 64)).lower() == "[playlist]"
		}

		// read implements PlaylistFormat. Entries come in `File<n>` number
		// order; a `Title<n>` of `Artist - Title` fills both.
		// Fails when there is no `[playlist]` section, or the reader fails.
		def read(reader io.Reader) !PlaylistEntry[] {
			let text = try readText(reader)
			let files = new map<int, string>()
			let titles = new map<int, string>()
			let lengths = new map<int, string>()
			let found = false
			let inside = false
			for let (_, raw) in text.lines() {
				let line = raw.trim()
				continue when line == "" || line.startsWith(";") || line.startsWith("#")
				if line.startsWith("[") {
					inside = line.lower() == "[playlist]"
					found = found || inside
					continue
				}
				continue unless inside
				let eq = line.indexOf("=")
				continue when eq < 0
				let key = line[:eq].trim().lower()
				let value = line[eq + 1:].trim()
				if key.startsWith("file") {
					files.set(parseInt<int>(key[4:]), value)
				} else if key.startsWith("title") {
					titles.set(parseInt<int>(key[5:]), value)
				} else if key.startsWith("length") {
					lengths.set(parseInt<int>(key[6:]), value)
				}
			}
			fail "pls: no [playlist] section" unless found
			let numbers int[]
			for let (n, _) in files {
				numbers.push(n)
			}
			numbers.sort((a, b int) => a < b)
			let entries PlaylistEntry[]
			for let (_, n) in numbers {
				let (artist, title) = splitDisplay(valueOf(titles, n))
				let length = lengthOf(valueOf(lengths, n))
				entries.push(PlaylistEntry{location: valueOf(files, n), title: title, artist: artist, length: length})
			}
			return entries
		}

		// write implements PlaylistFormat. Version 2, numbered from 1.
		// Fails when the writer fails.
		def write(entries PlaylistEntry[], writer io.Writer) !none {
			try put(writer, "[playlist]\n")
			for let (i, entry) in entries {
				let n = i + 1
				try put(writer, "File{n}={entry.location}\n")
				try put(writer, "Title{n}={display(entry)}\n") when entry.title != ""
				try put(writer, "Length{n}={secondsOf(entry.length)}\n")
			}
			try put(writer, "NumberOfEntries={entries.len()}\nVersion=2\n")
		}
	}
}
