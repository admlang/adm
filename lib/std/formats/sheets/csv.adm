partial module std.formats.sheets {
	use (
		std.bytes
		std.data.encoding::(CSV)
		std.formats.sheets.numfmt::(isNumberText, isoSerial)
		std.io
	)

	// Csv is the CSV codec: one sheet of rows of fields (RFC 4180), also
	// with `;` or tabs between them.
	//
	// Decoding gives a workbook with one sheet, `Sheet1`. With `infer`,
	// a field that reads as a number, as `true` or `false`, or as an ISO
	// date (`2026-03-01`, `2026-03-01 14:30:00`, `2026-03-01T14:30`)
	// becomes a cell of that kind and anything else a text; without it
	// every field is a text. An empty field leaves no cell.
	//
	// Encoding writes one sheet as each cell shows (`Cell.str()`), so
	// formulas are written as their last results.
	@codec("CSV")
	type Csv {
		// The field separator; empty picks it from the content when
		// decoding (`CSV.detect`) and writes commas.
		separator string = ""
		// Give numbers, bools and dates their kinds when decoding.
		infer     bool   = true
		// Which sheet of the workbook `encode` writes.
		sheet     int    = 0

		mimeType string[] {
			def get() string[] {
				return string["text/csv", "text/tab-separated-values"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".csv", ".tsv"]
			}
		}

		// CSV has no signature: it is found by extension.
		def matchSignature(r io.Reader) bool {
			return false
		}

		// decode reads the whole reader as CSV.
		// Fails when the reader does, or as decode(string) does.
		def decode(reader io.Reader) !Workbook {
			let source = new bytes.Buffer()
			try source.readFrom(reader)
			return decode(string(source.bytes()))
		}

		// decode reads the text as CSV.
		// Fails when a quoted field is never closed or text follows its
		// closing quote.
		def decode(text string) !Workbook {
			let codec = new CSV()
			if separator == "" {
				codec.detect(text[:text.len() > 65536 ?? (65536, text.len())])
			} else {
				codec.separator = separator
			}
			let rows = try codec.decode(text)
			let book = new Workbook()
			let first = book.add("Sheet1")
			for let (r, row) in rows {
				for let (c, field) in row {
					continue when field == ""
					let cell = first.cell(r, c)
					if infer {
						inferCell(cell, field)
					} else {
						cell.set(field)
					}
				}
			}
			return book
		}

		// encode writes the chosen sheet as CSV.
		// Fails when the writer does.
		def encode(book Workbook, writer io.Writer) !none {
			let _ = try writer.write(encode(book).bytes())
			return none
		}

		// encode returns the chosen sheet as CSV text, empty when the
		// workbook has no such sheet.
		def encode(book Workbook) string {
			return "" when sheet < 0 || sheet >= book.sheets.len()
			return new CSV(separator == "" ?? (",", separator)).encode(book.sheets[sheet].values())
		}
	}

	// Sets the cell from a field of text, as the kind the text reads as.
	internal def inferCell(cell Cell, field string) {
		let text = field.trim()
		if isNumberText(text) {
			cell.set(parseFloat<float>(text))
			return
		}
		let low = text.lower()
		if low == "true" || low == "false" {
			cell.set(low == "true")
			return
		}
		let serial = isoSerial(text)
		if serial is none {
			cell.set(field)
			return
		}
		cell.kind = CellKind.Date
		cell.number = serial
	}
}
