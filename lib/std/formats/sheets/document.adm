partial module std.formats.sheets {
	use (
		std.formats.docs
		std.formats.docs::(Alignment, Document)
	)

	// document turns a workbook into a prose document: each sheet with
	// cells becomes a level 2 heading with the sheet's name and a table of
	// the cells as shown (`Cell.str()`), the sheet's first row as the
	// table's header. A column whose cells below the header are all
	// numbers or dates (errors aside) is aligned right. The workbook's title and author
	// carry over. Formulas, formats and merged areas do not: a document
	// has no place for them.
	def document(book Workbook) Document {
		let doc = new Document(book.title)
		doc.authors.push(book.author) unless book.author == ""
		for let (_, sheet) in book.sheets {
			let values = sheet.values()
			continue when values.len() == 0
			doc.heading(2, sheet.name)
			let table = doc.table(values[0], values[1:])
			for let c = 0; c < sheet.columns && c < table.alignments.len(); c++ {
				let numeric = 0
				let other = 0
				for let r = 1; r < sheet.rows; r++ {
					let cell = sheet.get(r, c)
					continue when cell is none || cell.kind == CellKind.Empty || cell.kind == CellKind.Error
					if cell.kind == CellKind.Number || cell.kind == CellKind.Date {
						numeric++
					} else {
						other++
					}
				}
				table.alignments[c] = Alignment.Right when numeric > 0 && other == 0
			}
		}
		return doc
	}
}
