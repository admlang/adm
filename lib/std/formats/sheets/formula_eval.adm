// Formulas as values: the evaluator.
internal partial module std.formats.sheets.formula {
	use (
		std.formats.sheets::(Cell, CellKind, Workbook, maxColumns)
		std.formats.sheets.numfmt::(general, isDateFormat, isNumberText, isoSerial)
		std.time
	)

	// What a formula or a part of one evaluates to.
	type Value {
		// 'b' blank, 'n' number, 't' text, 'l' bool, 'e' error, 'a' an
		// array or range: `rows` by `columns` items in reading order.
		kind    char
		number  float   = 0.0
		text    string  = ""
		rows    int     = 0
		columns int     = 0
		items   Value[] = []

		def new(kind char) {
			self.kind = kind
		}

		// The value as one value: the first item of an array.
		def scalar() Value {
			return self unless kind == 'a'
			return items.len() == 0 ?? (new Value('b'), items[0].scalar())
		}

		def isError() bool {
			return kind == 'e'
		}
	}

	def num(x float) Value {
		let v = new Value('n')
		v.number = x
		return v
	}

	def txt(s string) Value {
		let v = new Value('t')
		v.text = s
		return v
	}

	def logical(flag bool) Value {
		let v = new Value('l')
		v.number = flag ?? (1.0, 0.0)
		return v
	}

	def failure(code string) Value {
		let v = new Value('e')
		v.text = code
		return v
	}

	// A value as a number: blank is 0, a bool 1 or 0, a text the number
	// it spells; an error value for a text that spells none.
	def toNumber(value Value) Value {
		let v = value.scalar()
		match v.kind {
			case 'n', 'e':
				return v
			case 'b':
				return num(0.0)
			case 'l':
				return num(v.number)
			default:
				let text = v.text.trim()
				return num(parseFloat<float>(text)) when isNumberText(text)
				let serial = isoSerial(text)
				return failure("#VALUE!") when serial is none
				return num(serial)
		}
	}

	// A value as text, as the general format shows it.
	def toText(value Value) string {
		let v = value.scalar()
		match v.kind {
			case 'n':
				return general(v.number)
			case 'l':
				return v.number != 0.0 ?? ("TRUE", "FALSE")
			case 't', 'e':
				return v.text
			default:
				return ""
		}
	}

	// A value as a condition; an error value for a text that is neither
	// TRUE nor FALSE.
	def toBool(value Value) Value {
		let v = value.scalar()
		match v.kind {
			case 'l', 'e':
				return v
			case 'n':
				return logical(v.number != 0.0)
			case 'b':
				return logical(false)
			default:
				let upper = v.text.upper()
				return logical(upper == "TRUE") when upper == "TRUE" || upper == "FALSE"
				return failure("#VALUE!")
		}
	}

	// Orders two values as spreadsheets do: numbers before texts before
	// bools, texts without regard to case; blank is 0 or "".
	def compareValues(a Value, c Value) int {
		let x = a
		let y = c
		x = y.kind == 't' ?? (txt(""), num(0.0)) when x.kind == 'b'
		y = x.kind == 't' ?? (txt(""), num(0.0)) when y.kind == 'b'
		let rank = (v Value) => v.kind == 'n' ?? (0, v.kind == 't' ?? (1, 2))
		return rank(x) < rank(y) ?? (-1, 1) when rank(x) != rank(y)
		if x.kind == 't' {
			let p = x.text.lower()
			let q = y.text.lower()
			return p == q ?? (0, p < q ?? (-1, 1))
		}
		return x.number == y.number ?? (0, x.number < y.number ?? (-1, 1))
	}

	// Where a formula is evaluated.
	struct Place {
		sheet  int
		row    int
		column int
	}

	// Calc evaluates the formulas of a workbook, each cell once, storing
	// every result in its cell.
	type Calc {
		book  Workbook
		// Per cell with a formula: 1 while it is being evaluated, 2 after.
		state map<int, int>
		depth int           = 0
		now   float

		def new(book Workbook) {
			self.book = book
			state = map<int, int>{}
			now = float(time.now().unixNs() / 1000000) / 86400000.0 + 25569.0
		}

		def all() {
			for let (index, sheet) in book.sheets {
				for let (_, position) in sheet.positions() {
					let (row, column) = position
					let cell = sheet.cell(row, column)
					ensure(index, row, column, cell) unless cell.formula == ""
				}
			}
		}

		// Evaluates the cell's formula unless it already was. A formula
		// that depends on itself gives `#REF!`.
		def ensure(index int, row int, column int, cell Cell) {
			let key = index * 17592186044416 + row * maxColumns + column
			let seen = state.get(key)
			if !(seen is none) {
				cell.setError("#REF!") when seen == 1
				return
			}
			if depth > 3000 {
				cell.setError("#REF!")
				return
			}
			state[key] = 1
			depth++
			let result = eval(new Parser(cell.formula).parse(), Place{sheet: index, row: row, column: column}).scalar()
			depth--
			store(cell, result)
			state[key] = 2
		}

		def store(cell Cell, result Value) {
			match result.kind {
				case 't':
					cell.set(result.text)
				case 'l':
					cell.set(result.number != 0.0)
				case 'e':
					cell.setError(result.text)
				default:
					let x = result.kind == 'b' ?? (0.0, result.number)
					if x != x || x - x != 0.0 {
						cell.setError("#NUM!")
					} else {
						cell.set(x)
						cell.kind = CellKind.Date when isDateFormat(cell.format)
					}
			}
		}

		def sheetIndex(name string, place Place) int {
			return place.sheet when name == ""
			let wanted = name.lower()
			for let (i, s) in book.sheets {
				return i when s.name.lower() == wanted
			}
			return -1
		}

		def cellValue(index int, row int, column int) Value {
			let cell = book.sheets[index].get(row, column)
			return new Value('b') when cell is none
			ensure(index, row, column, cell) unless cell.formula == ""
			match cell.kind {
				case CellKind.Empty:
					return new Value('b')
				case CellKind.Text:
					return txt(cell.text)
				case CellKind.Bool:
					return logical(cell.number != 0.0)
				case CellKind.Error:
					return failure(cell.text)
				default:
					return num(cell.number)
			}
		}

		// The cells of a reference: one value for a single cell, else an
		// array. Whole columns and rows, and areas far larger than the
		// sheet, end at the sheet's last row and column.
		def rangeValue(node Node, place Place) Value {
			let index = sheetIndex(node.sheet, place)
			return failure("#REF!") when index < 0
			let sheet = book.sheets[index]
			let single = node.top == node.bottom && node.left == node.right
			return cellValue(index, node.top, node.left) when single
			let bottom = node.bottom
			let right = node.right
			let open = bottom < 0 || right < 0 || (bottom - node.top + 1) * (right - node.left + 1) > 100000
			if open {
				bottom = sheet.rows - 1 when bottom < 0 || bottom >= sheet.rows
				right = sheet.columns - 1 when right < 0 || right >= sheet.columns
			}
			let out = new Value('a')
			out.rows = bottom - node.top + 1 > 0 ?? (bottom - node.top + 1, 0)
			out.columns = right - node.left + 1 > 0 ?? (right - node.left + 1, 0)
			for let r = node.top; r <= bottom; r++ {
				for let c = node.left; c <= right; c++ {
					out.items.push(cellValue(index, r, c))
				}
			}
			return out
		}

		def eval(node Node, place Place) Value {
			match node.kind {
				case 'n':
					return num(node.number)
				case 't':
					return txt(node.text)
				case 'l':
					return logical(node.number != 0.0)
				case 'e':
					return failure(node.text)
				case 'b':
					return new Value('b')
				case 'r':
					return rangeValue(node, place)
				case 'N':
					let found = ""
					for let (name, formula) in book.names {
						found = formula when name.lower() == node.text.lower()
					}
					return failure("#NAME?") when found == ""
					return eval(new Parser(found.trimPrefix("=")).parse(), place)
				case 'a':
					let out = new Value('a')
					out.rows = node.top
					out.columns = node.left
					for let (_, item) in node.args {
						out.items.push(eval(item, place).scalar())
					}
					return out
				case 'u':
					let x = toNumber(eval(node.args[0], place))
					return x when x.isError()
					return num(node.text == "-" ?? (-x.number, x.number))
				case '%':
					let x = toNumber(eval(node.args[0], place))
					return x when x.isError()
					return num(x.number / 100.0)
				case 'o':
					return operate(node.text, eval(node.args[0], place).scalar(), eval(node.args[1], place).scalar())
				case 'f':
					return callFunction(self, node.text, node.args, place)
				default:
					return failure("#NAME?")
			}
		}

		def operate(op string, a Value, c Value) Value {
			return a when a.isError()
			return c when c.isError()
			if op == "&" {
				return txt(toText(a) + toText(c))
			}
			if op := "=" || "<>" || "<" || "<=" || ">" || ">=" {
				let order = compareValues(a, c)
				match op {
					case "=":
						return logical(order == 0)
					case "<>":
						return logical(order != 0)
					case "<":
						return logical(order < 0)
					case "<=":
						return logical(order <= 0)
					case ">":
						return logical(order > 0)
					default:
						return logical(order >= 0)
				}
			}
			let x = toNumber(a)
			return x when x.isError()
			let y = toNumber(c)
			return y when y.isError()
			match op {
				case "+":
					return num(x.number + y.number)
				case "-":
					return num(x.number - y.number)
				case "*":
					return num(x.number * y.number)
				case "/":
					return failure("#DIV/0!") when y.number == 0.0
					return num(x.number / y.number)
				default:
					return failure("#NUM!") when x.number < 0.0 && y.number != y.number.floor()
					return failure("#DIV/0!") when x.number == 0.0 && y.number < 0.0
					return num(x.number ** y.number)
			}
		}
	}

	// Evaluates every formula of the workbook and stores the results in
	// the cells.
	def calculateBook(book Workbook) {
		new Calc(book).all()
	}

	// Evaluates one formula as if it stood in cell A1 of the sheet at the
	// index, and returns the result as a cell.
	def evaluateFormula(book Workbook, index int, formula string) Cell {
		let calc = new Calc(book)
		let out = new Cell()
		return out.setError("#REF!") when index < 0 || index >= book.sheets.len()
		calc.store(out, calc.eval(new Parser(formula.trimPrefix("=")).parse(), Place{sheet: index, row: 0, column: 0}).scalar())
		return out
	}
}
