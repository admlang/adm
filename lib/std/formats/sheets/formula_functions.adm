// Formulas as values: the functions.
internal partial module std.formats.sheets.formula {
	use (
		std.formats.sheets.numfmt::(dateSerial, formatNumber, isDateFormat, isNumberText)
		std.math
		std.time
	)

	// Every scalar of the arguments in order, ranges and arrays opened.
	def valuesOf(calc Calc, args Node[], place Place) Value[] {
		let out Value[] = []
		for let (_, a) in args {
			let v = calc.eval(a, place)
			if v.kind == 'a' {
				out.push(...v.items)
			} else {
				out.push(v)
			}
		}
		return out
	}

	// The numbers of the arguments, appended to `out`: every number in a
	// range or array (texts, bools and blanks there are skipped), and each
	// single argument as a number. Returns the first error met, else none.
	def numbersOf(calc Calc, args Node[], place Place, out float[]) ?Value {
		for let (_, a) in args {
			let v = calc.eval(a, place)
			if v.kind == 'a' {
				for let (_, item) in v.items {
					return item when item.isError()
					out.push(item.number) when item.kind == 'n'
				}
				continue
			}
			continue when v.kind == 'b'
			let x = toNumber(v)
			return x when x.isError()
			out.push(x.number)
		}
		return none
	}

	// Reports whether text matches a pattern where `*` is any run of
	// characters, `?` any one and `~` takes the next literally; case is
	// ignored.
	def wildcard(pattern string, text string) bool {
		let p = pattern.lower().bytes()
		let t = text.lower().bytes()
		let pi = 0
		let ti = 0
		let star = -1
		let mark = 0
		for ti < t.len() {
			if pi < p.len() && p[pi] == byte('~') && pi + 1 < p.len() && p[pi + 1] == t[ti] {
				pi += 2
				ti++
			} else if pi < p.len() && (p[pi] == byte('?') || (p[pi] == t[ti] && p[pi] != byte('*') && p[pi] != byte('~'))) {
				pi++
				ti++
			} else if pi < p.len() && p[pi] == byte('*') {
				star = pi
				mark = ti
				pi++
			} else if star >= 0 {
				pi = star + 1
				mark++
				ti = mark
			} else {
				return false
			}
		}
		for pi < p.len() && p[pi] == byte('*') {
			pi++
		}
		return pi == p.len()
	}

	// Reports whether an item meets a criterion of SUMIF and its kin: a
	// value to equal, or a text starting with `=`, `<>`, `<`, `<=`, `>`,
	// `>=`; texts compare with wildcards.
	def meets(criterion Value, item Value) bool {
		let op = "="
		let wanted = criterion
		if criterion.kind == 't' {
			let text = criterion.text
			for let (_, candidate) in ["<>", "<=", ">=", "=", "<", ">"] {
				if text.startsWith(candidate) {
					op = candidate
					text = text[candidate.len():]
					break
				}
			}
			let upper = text.upper()
			if isNumberText(text.trim()) {
				wanted = num(parseFloat<float>(text.trim()))
			} else if upper == "TRUE" || upper == "FALSE" {
				wanted = logical(upper == "TRUE")
			} else {
				wanted = txt(text)
			}
		}
		if wanted.kind == 't' {
			// An empty criterion matches blanks and empty texts.
			let same = item.kind == 't' ?? (wildcard(wanted.text, item.text), wanted.text == "" && item.kind == 'b')
			return same when op == "="
			return !same when op == "<>"
			return false unless item.kind == 't'
		} else {
			return op == "<>" when item.kind != wanted.kind
		}
		let order = compareValues(item, wanted)
		match op {
			case "=":
				return order == 0
			case "<>":
				return order != 0
			case "<":
				return order < 0
			case "<=":
				return order <= 0
			case ">":
				return order > 0
			default:
				return order >= 0
		}
	}

	def roundTo(x float, digits float, mode int) float {
		let scale = 10.0 ** digits.floor()
		let scaled = x * scale
		// Decimal fractions sit a hair off in binary: nudge before cutting.
		let nudged = scaled + (scaled < 0.0 ?? (-1.0, 1.0)) * scaled.abs() * 1e-14
		let cut = mode == 0 ?? (nudged.round(), mode > 0 ?? (nudged < 0.0 ?? (nudged.floor(), nudged.ceil()), nudged < 0.0 ?? (nudged.ceil(), nudged.floor())))
		return cut / scale
	}

	def variance(values float[], sample bool) ?float {
		let n = values.len()
		return none when n < (sample ?? (2, 1))
		let mean = 0.0
		for let (_, v) in values {
			mean += v
		}
		mean /= float(n)
		let total = 0.0
		for let (_, v) in values {
			total += (v - mean) * (v - mean)
		}
		return total / float(sample ?? (n - 1, n))
	}

	def civil(serial float) time.Time {
		return time.fromUnixNs(int64(((serial - 25569.0) * 86400000.0).round()) * 1000000)
	}

	// The day number of a year, month and day where the month and day may
	// run past their ranges, as DATE takes them.
	def looseDate(year int, month int, day int) float {
		let m = month - 1
		let y = year + (m >= 0 ?? (m / 12, -((11 - m) / 12)))
		m = ((m % 12) + 12) % 12
		return dateSerial(y, m + 1, 1) + float(day - 1)
	}

	// Finds a value in a row or column of items. mode 0 is an exact match
	// (texts with wildcards), 1 the last item not above it in ascending
	// order, -1 the last not below it in descending order. Returns the
	// position from 0, -1 for none.
	def lookupIn(items Value[], wanted Value, mode int) int {
		let best = -1
		for let (i, item) in items {
			continue when item.kind == 'b' || item.isError()
			if mode == 0 {
				if wanted.kind == 't' && item.kind == 't' {
					return i when wildcard(wanted.text, item.text)
				} else if item.kind == wanted.kind && compareValues(item, wanted) == 0 {
					return i
				}
				continue
			}
			continue unless item.kind == wanted.kind
			let order = compareValues(item, wanted)
			if (mode > 0 && order <= 0) || (mode < 0 && order >= 0) {
				best = i
			} else {
				break
			}
		}
		return best
	}

	def callFunction(calc Calc, name string, args Node[], place Place) Value {
		let n = args.len()
		// A single argument as a value, blank when it is absent.
		let arg = (i int) => i < n ?? (calc.eval(args[i], place).scalar(), new Value('b'))
		let numberArg = (i int, fallback float) => i < n ?? (toNumber(calc.eval(args[i], place)), num(fallback))

		match name {
			case "SUM", "PRODUCT", "AVERAGE", "MIN", "MAX", "COUNT", "MEDIAN", "STDEV", "STDEV.S", "STDEVP", "STDEV.P", "VAR", "VAR.S", "VARP", "VAR.P":
				let values float[] = []
				let failed = numbersOf(calc, args, place, values)
				if name == "COUNT" {
					// COUNT skips errors and texts instead of failing.
					let count = 0
					for let (_, v) in valuesOf(calc, args, place) {
						count++ when v.kind == 'n'
					}
					return num(float(count))
				}
				return failed unless failed is none
				let total = name == "PRODUCT" ?? (1.0, 0.0)
				for let (_, v) in values {
					if name == "PRODUCT" {
						total *= v
					} else {
						total += v
					}
				}
				match name {
					case "SUM", "PRODUCT":
						return num(total)
					case "AVERAGE":
						return failure("#DIV/0!") when values.len() == 0
						return num(total / float(values.len()))
					case "MIN", "MAX":
						return num(0.0) when values.len() == 0
						let best = values[0]
						for let (_, v) in values {
							best = v when (name == "MIN" && v < best) || (name == "MAX" && v > best)
						}
						return num(best)
					case "MEDIAN":
						return failure("#NUM!") when values.len() == 0
						let sorted = values.sort((a, b) => a < b)
						let mid = sorted.len() / 2
						return num(sorted.len() % 2 == 1 ?? (sorted[mid], (sorted[mid - 1] + sorted[mid]) / 2.0))
					default:
						let sample = !(name := "STDEVP" || "STDEV.P" || "VARP" || "VAR.P")
						let v = variance(values, sample)
						return failure("#DIV/0!") when v is none
						return num(name.startsWith("STDEV") ?? (math.sqrt(v), v))
				}
			case "COUNTA", "COUNTBLANK":
				let count = 0
				for let (_, v) in valuesOf(calc, args, place) {
					let blank = v.kind == 'b' || (v.kind == 't' && v.text == "")
					count++ when blank == (name == "COUNTBLANK") && (name == "COUNTBLANK" || v.kind != 'b')
				}
				return num(float(count))
			case "SUMIF", "COUNTIF", "AVERAGEIF":
				return failure("#VALUE!") when n < 2
				let tested = calc.eval(args[0], place)
				let items = tested.kind == 'a' ?? (tested.items, [tested])
				let criterion = arg(1)
				let summed = items
				if name != "COUNTIF" && n >= 3 {
					let other = calc.eval(args[2], place)
					summed = other.kind == 'a' ?? (other.items, [other])
				}
				let total = 0.0
				let count = 0
				for let (i, item) in items {
					continue unless meets(criterion, item)
					if name == "COUNTIF" {
						count++
						continue
					}
					continue unless i < summed.len() && summed[i].kind == 'n'
					total += summed[i].number
					count++
				}
				return num(float(count)) when name == "COUNTIF"
				return num(total) when name == "SUMIF"
				return failure("#DIV/0!") when count == 0
				return num(total / float(count))
			case "SUMIFS", "COUNTIFS", "AVERAGEIFS":
				let first = name == "COUNTIFS" ?? (0, 1)
				return failure("#VALUE!") when n < first + 2 || (n - first) % 2 != 0
				let ranges Value[][] = []
				let criteria Value[] = []
				for let k = first; k + 1 < n; k += 2 {
					let tested = calc.eval(args[k], place)
					ranges.push(tested.kind == 'a' ?? (tested.items, [tested]))
					criteria.push(calc.eval(args[k + 1], place).scalar())
				}
				let summed = ranges[0]
				if first == 1 {
					let target = calc.eval(args[0], place)
					summed = target.kind == 'a' ?? (target.items, [target])
				}
				let total = 0.0
				let count = 0
				for let i = 0; i < ranges[0].len(); i++ {
					let ok = true
					for let (k, items) in ranges {
						ok = ok && i < items.len() && meets(criteria[k], items[i])
					}
					continue unless ok
					if first == 1 {
						continue unless i < summed.len() && summed[i].kind == 'n'
						total += summed[i].number
					}
					count++
				}
				return num(float(count)) when name == "COUNTIFS"
				return num(total) when name == "SUMIFS"
				return failure("#DIV/0!") when count == 0
				return num(total / float(count))
			case "SUMPRODUCT":
				let columns Value[][] = []
				for let (_, a) in args {
					let v = calc.eval(a, place)
					columns.push(v.kind == 'a' ?? (v.items, [v]))
				}
				return num(0.0) when columns.len() == 0
				let total = 0.0
				for let i = 0; i < columns[0].len(); i++ {
					let product = 1.0
					for let (_, items) in columns {
						return failure("#VALUE!") when items.len() != columns[0].len()
						return items[i] when items[i].isError()
						product *= items[i].kind == 'n' ?? (items[i].number, 0.0)
					}
					total += product
				}
				return num(total)
			case "ABS", "SQRT", "EXP", "LN", "LOG10", "SIGN", "INT", "SIN", "COS", "TAN", "ATAN", "RADIANS", "DEGREES":
				let x = numberArg(0, 0.0)
				return x when x.isError()
				let v = x.number
				match name {
					case "ABS":
						return num(v.abs())
					case "SQRT":
						return failure("#NUM!") when v < 0.0
						return num(math.sqrt(v))
					case "EXP":
						return num(math.E ** v)
					case "LN":
						return failure("#NUM!") when v <= 0.0
						return num(math.ln(v))
					case "LOG10":
						return failure("#NUM!") when v <= 0.0
						return num(math.log10(v))
					case "SIGN":
						return num(v > 0.0 ?? (1.0, v < 0.0 ?? (-1.0, 0.0)))
					case "INT":
						return num(v.floor())
					case "SIN":
						return num(math.sin(v))
					case "COS":
						return num(math.cos(v))
					case "TAN":
						return num(math.tan(v))
					case "ATAN":
						return num(math.atan(v))
					case "RADIANS":
						return num(v * math.Pi / 180.0)
					default:
						return num(v * 180.0 / math.Pi)
				}
			case "PI":
				return num(math.Pi)
			case "ROUND", "ROUNDUP", "ROUNDDOWN", "TRUNC", "MOD", "POWER", "LOG", "ATAN2", "CEILING", "FLOOR", "QUOTIENT":
				let x = numberArg(0, 0.0)
				return x when x.isError()
				let y = numberArg(1, name == "LOG" ?? (10.0, name == "CEILING" || name == "FLOOR" ?? (1.0, 0.0)))
				return y when y.isError()
				match name {
					case "ROUND":
						return num(roundTo(x.number, y.number, 0))
					case "ROUNDUP":
						return num(roundTo(x.number, y.number, 1))
					case "ROUNDDOWN", "TRUNC":
						return num(roundTo(x.number, y.number, -1))
					case "MOD":
						return failure("#DIV/0!") when y.number == 0.0
						return num(x.number - y.number * (x.number / y.number).floor())
					case "QUOTIENT":
						return failure("#DIV/0!") when y.number == 0.0
						let q = x.number / y.number
						return num(q < 0.0 ?? (q.ceil(), q.floor()))
					case "POWER":
						return calc.operate("^", x, y)
					case "LOG":
						return failure("#NUM!") when x.number <= 0.0 || y.number <= 0.0 || y.number == 1.0
						return num(math.ln(x.number) / math.ln(y.number))
					case "ATAN2":
						return failure("#DIV/0!") when x.number == 0.0 && y.number == 0.0
						return num(math.atan2(y.number, x.number))
					default:
						return num(0.0) when y.number == 0.0
						let q = x.number / y.number
						let nudge = q.abs() * 1e-14
						return num((name == "CEILING" ?? ((q - nudge).ceil(), (q + nudge).floor())) * y.number)
				}
			case "IF":
				let condition = toBool(arg(0))
				return condition when condition.isError()
				return n > 1 ?? (calc.eval(args[1], place), logical(true)) when condition.number != 0.0
				return n > 2 ?? (calc.eval(args[2], place), logical(false))
			case "IFS":
				for let k = 0; k + 1 < n; k += 2 {
					let condition = toBool(arg(k))
					return condition when condition.isError()
					return calc.eval(args[k + 1], place) when condition.number != 0.0
				}
				return failure("#N/A")
			case "IFERROR", "IFNA":
				let v = arg(0)
				let caught = v.isError() && (name == "IFERROR" || v.text == "#N/A")
				return caught ?? (arg(1), v)
			case "AND", "OR", "XOR":
				let truths = 0
				let seen = 0
				for let (_, v) in valuesOf(calc, args, place) {
					continue when v.kind == 'b' || v.kind == 't'
					return v when v.isError()
					seen++
					truths++ when v.number != 0.0
				}
				return failure("#VALUE!") when seen == 0
				return logical(name == "AND" ?? (truths == seen, name == "OR" ?? (truths > 0, truths % 2 == 1)))
			case "NOT":
				let condition = toBool(arg(0))
				return condition when condition.isError()
				return logical(condition.number == 0.0)
			case "TRUE":
				return logical(true)
			case "FALSE":
				return logical(false)
			case "NA":
				return failure("#N/A")
			case "ISBLANK":
				return logical(arg(0).kind == 'b')
			case "ISNUMBER":
				return logical(arg(0).kind == 'n')
			case "ISTEXT":
				return logical(arg(0).kind == 't')
			case "ISNONTEXT":
				return logical(arg(0).kind != 't')
			case "ISLOGICAL":
				return logical(arg(0).kind == 'l')
			case "ISERROR":
				return logical(arg(0).isError())
			case "ISERR":
				let v = arg(0)
				return logical(v.isError() && v.text != "#N/A")
			case "ISNA":
				let v = arg(0)
				return logical(v.isError() && v.text == "#N/A")
			case "ISEVEN", "ISODD":
				let x = numberArg(0, 0.0)
				return x when x.isError()
				let even = int64(x.number.abs().floor()) % 2 == 0
				return logical(even == (name == "ISEVEN"))
			case "N":
				let v = arg(0)
				return v when v.isError() || v.kind == 'n'
				return num(v.kind == 'l' ?? (v.number, 0.0))
			case "T":
				let v = arg(0)
				return v.kind == 't' || v.isError() ?? (v, txt(""))
			case "CHOOSE":
				let x = numberArg(0, 0.0)
				return x when x.isError()
				let index = int(x.number.floor())
				return failure("#VALUE!") when index < 1 || index >= n
				return calc.eval(args[index], place)
			case "SWITCH":
				let subject = arg(0)
				return subject when subject.isError()
				let k = 1
				for k + 1 < n {
					let candidate = arg(k)
					return calc.eval(args[k + 1], place) when candidate.kind == subject.kind && compareValues(candidate, subject) == 0
					k += 2
				}
				return k < n ?? (calc.eval(args[k], place), failure("#N/A"))
			case "CONCATENATE", "CONCAT":
				let out = ""
				for let (_, v) in valuesOf(calc, args, place) {
					return v when v.isError()
					out += toText(v)
				}
				return txt(out)
			case "TEXTJOIN":
				let separator = toText(arg(0))
				let skipEmpty = toBool(arg(1))
				return skipEmpty when skipEmpty.isError()
				let parts string[] = []
				for let (_, v) in valuesOf(calc, args[2:], place) {
					return v when v.isError()
					let piece = toText(v)
					parts.push(piece) unless piece == "" && skipEmpty.number != 0.0
				}
				return txt(parts.join(separator))
			case "LEN", "UPPER", "LOWER", "PROPER", "TRIM", "VALUE", "CLEAN":
				let v = arg(0)
				return v when v.isError()
				let text = toText(v)
				match name {
					case "LEN":
						return num(float(text.len()))
					case "UPPER":
						return txt(text.upper())
					case "LOWER":
						return txt(text.lower())
					case "PROPER":
						let words = text.lower().split(" ")
						return txt(words.mapElem<string>(w => w.capitalize()).join(" "))
					case "TRIM":
						// Spaces at the ends go, runs inside become one.
						let words string[] = []
						for let (_, w) in text.split(" ") {
							words.push(w) unless w == ""
						}
						return txt(words.join(" "))
					case "CLEAN":
						let kept byte[] = []
						for let (_, c) in text.bytes() {
							kept.push(c) when c >= byte(32)
						}
						return txt(string(kept))
					default:
						let cleaned = text.trim().replace(",", "")
						let percent = cleaned.endsWith("%")
						cleaned = cleaned.trimSuffix("%")
						return toNumber(txt(cleaned)) unless percent
						let x = toNumber(txt(cleaned))
						return x when x.isError()
						return num(x.number / 100.0)
				}
			case "LEFT", "RIGHT":
				let v = arg(0)
				return v when v.isError()
				let x = numberArg(1, 1.0)
				return x when x.isError()
				return failure("#VALUE!") when x.number < 0.0
				let text = toText(v)
				let count = int(x.number) > text.len() ?? (text.len(), int(x.number))
				return txt(name == "LEFT" ?? (text[:count], text[text.len() - count:]))
			case "MID":
				let v = arg(0)
				return v when v.isError()
				let start = numberArg(1, 1.0)
				return start when start.isError()
				let length = numberArg(2, 0.0)
				return length when length.isError()
				return failure("#VALUE!") when start.number < 1.0 || length.number < 0.0
				let text = toText(v)
				let from = int(start.number) - 1
				return txt("") when from >= text.len()
				let to = from + int(length.number) > text.len() ?? (text.len(), from + int(length.number))
				return txt(text[from:to])
			case "FIND", "SEARCH":
				let needle = arg(0)
				return needle when needle.isError()
				let hay = arg(1)
				return hay when hay.isError()
				let start = numberArg(2, 1.0)
				return start when start.isError()
				let text = toText(hay)
				let wanted = toText(needle)
				return failure("#VALUE!") when start.number < 1.0 || int(start.number) > text.len() + 1
				let from = int(start.number) - 1
				if name == "FIND" {
					let at = text.indexOf(wanted, from)
					return at < 0 ?? (failure("#VALUE!"), num(float(at + 1)))
				}
				// SEARCH ignores case and takes wildcards.
				for let at = from; at <= text.len(); at++ {
					return num(float(at + 1)) when wildcard(wanted + "*", text[at:])
				}
				return failure("#VALUE!")
			case "SUBSTITUTE":
				let v = arg(0)
				return v when v.isError()
				let text = toText(v)
				let old = toText(arg(1))
				let fresh = toText(arg(2))
				return txt(text) when old == ""
				return txt(text.replace(old, fresh)) when n < 4
				let which = numberArg(3, 1.0)
				return which when which.isError()
				return failure("#VALUE!") when which.number < 1.0
				let at = -1
				let from = 0
				for let k = 0; k < int(which.number); k++ {
					at = text.indexOf(old, from)
					return txt(text) when at < 0
					from = at + old.len()
				}
				return txt(text[:at] + fresh + text[at + old.len():])
			case "REPLACE":
				let v = arg(0)
				return v when v.isError()
				let start = numberArg(1, 1.0)
				return start when start.isError()
				let length = numberArg(2, 0.0)
				return length when length.isError()
				return failure("#VALUE!") when start.number < 1.0 || length.number < 0.0
				let text = toText(v)
				let from = int(start.number) - 1 > text.len() ?? (text.len(), int(start.number) - 1)
				let to = from + int(length.number) > text.len() ?? (text.len(), from + int(length.number))
				return txt(text[:from] + toText(arg(3)) + text[to:])
			case "REPT":
				let v = arg(0)
				return v when v.isError()
				let times = numberArg(1, 0.0)
				return times when times.isError()
				return failure("#VALUE!") when times.number < 0.0 || times.number * float(toText(v).len()) > 32767.0
				return txt(toText(v).repeat(int(times.number)))
			case "EXACT":
				let a = arg(0)
				return a when a.isError()
				let c = arg(1)
				return c when c.isError()
				return logical(toText(a) == toText(c))
			case "TEXT":
				let v = arg(0)
				return v when v.isError()
				let code = toText(arg(1))
				return txt(v.text) when v.kind == 't' && !isNumberText(v.text.trim())
				let x = toNumber(v)
				return x when x.isError()
				return txt(formatNumber(x.number, code, isDateFormat(code)))
			case "ROW", "COLUMN", "ROWS", "COLUMNS":
				if n == 0 || args[0].kind != 'r' {
					return failure("#VALUE!") when n > 0 && args[0].kind != 'a'
					return num(float(name == "ROW" ?? (place.row + 1, place.column + 1))) when n == 0 && (name == "ROW" || name == "COLUMN")
					return failure("#VALUE!") when n == 0
					return num(float(name == "ROWS" ?? (args[0].top, args[0].left)))
				}
				let ref = args[0]
				match name {
					case "ROW":
						return num(float(ref.top + 1))
					case "COLUMN":
						return num(float(ref.left + 1))
					default:
						let v = calc.eval(ref, place)
						return num(1.0) unless v.kind == 'a'
						return num(float(name == "ROWS" ?? (v.rows, v.columns)))
				}
			case "INDEX":
				return failure("#VALUE!") when n < 2
				let table = calc.eval(args[0], place)
				let rowArg = numberArg(1, 1.0)
				return rowArg when rowArg.isError()
				let columnArg = numberArg(2, 0.0)
				return columnArg when columnArg.isError()
				if table.kind != 'a' {
					return table when rowArg.number <= 1.0 && columnArg.number <= 1.0
					return failure("#REF!")
				}
				let row = int(rowArg.number)
				let column = int(columnArg.number)
				// One index into a single row counts along it.
				if n == 2 && table.rows == 1 {
					column = row
					row = 1
				}
				row = 1 when row == 0 && table.rows == 1
				column = 1 when column == 0 && table.columns == 1
				return failure("#REF!") when row < 1 || column < 1 || row > table.rows || column > table.columns
				return table.items[(row - 1) * table.columns + column - 1]
			case "MATCH":
				return failure("#VALUE!") when n < 2
				let wanted = arg(0)
				return wanted when wanted.isError()
				let table = calc.eval(args[1], place)
				let mode = numberArg(2, 1.0)
				return mode when mode.isError()
				let items = table.kind == 'a' ?? (table.items, [table])
				let at = lookupIn(items, wanted, mode.number > 0.0 ?? (1, mode.number < 0.0 ?? (-1, 0)))
				return at < 0 ?? (failure("#N/A"), num(float(at + 1)))
			case "VLOOKUP", "HLOOKUP":
				return failure("#VALUE!") when n < 3
				let wanted = arg(0)
				return wanted when wanted.isError()
				let table = calc.eval(args[1], place)
				let indexArg = numberArg(2, 1.0)
				return indexArg when indexArg.isError()
				let sorted = n > 3 ?? (toBool(arg(3)), logical(true))
				return sorted when sorted.isError()
				if table.kind != 'a' {
					let one = new Value('a')
					one.rows = 1
					one.columns = 1
					one.items = [table]
					table = one
				}
				let vertical = name == "VLOOKUP"
				let index = int(indexArg.number)
				return failure("#VALUE!") when index < 1
				return failure("#REF!") when index > (vertical ?? (table.columns, table.rows))
				let keys Value[] = []
				let count = vertical ?? (table.rows, table.columns)
				for let k = 0; k < count; k++ {
					keys.push(vertical ?? (table.items[k * table.columns], table.items[k]))
				}
				let at = lookupIn(keys, wanted, sorted.number != 0.0 ?? (1, 0))
				return failure("#N/A") when at < 0
				return vertical ?? (table.items[at * table.columns + index - 1], table.items[(index - 1) * table.columns + at])
			case "TODAY":
				return num(calc.now.floor())
			case "NOW":
				return num(calc.now)
			case "DATE":
				let y = numberArg(0, 1900.0)
				return y when y.isError()
				let m = numberArg(1, 1.0)
				return m when m.isError()
				let d = numberArg(2, 1.0)
				return d when d.isError()
				let year = int(y.number) < 1900 ?? (int(y.number) + 1900, int(y.number))
				return num(looseDate(year, int(m.number), int(d.number)))
			case "TIME":
				let h = numberArg(0, 0.0)
				return h when h.isError()
				let m = numberArg(1, 0.0)
				return m when m.isError()
				let s = numberArg(2, 0.0)
				return s when s.isError()
				let seconds = h.number.floor() * 3600.0 + m.number.floor() * 60.0 + s.number.floor()
				return failure("#NUM!") when seconds < 0.0
				return num((seconds / 86400.0) - (seconds / 86400.0).floor())
			case "YEAR", "MONTH", "DAY", "HOUR", "MINUTE", "SECOND", "WEEKDAY":
				let x = numberArg(0, 0.0)
				return x when x.isError()
				return failure("#NUM!") when x.number < 0.0
				let t = civil(x.number)
				match name {
					case "YEAR":
						return num(float(t.year()))
					case "MONTH":
						return num(float(t.month()))
					case "DAY":
						return num(float(t.day()))
					case "HOUR":
						return num(float(t.hour()))
					case "MINUTE":
						return num(float(t.minute()))
					case "SECOND":
						return num(float(t.second()))
					default:
						let kind = numberArg(1, 1.0)
						return kind when kind.isError()
						let sunday = int(t.weekday())
						// 1: Sunday is 1; 2: Monday is 1; 3: Monday is 0.
						return num(float(sunday + 1)) when kind.number == 1.0
						return num(float((sunday + 6) % 7 + 1)) when kind.number == 2.0
						return num(float((sunday + 6) % 7)) when kind.number == 3.0
						return failure("#NUM!")
				}
			case "EDATE", "EOMONTH":
				let x = numberArg(0, 0.0)
				return x when x.isError()
				let months = numberArg(1, 0.0)
				return months when months.isError()
				let t = civil(x.number.floor())
				let shift = int(months.number < 0.0 ?? (months.number.ceil(), months.number.floor()))
				if name == "EOMONTH" {
					return num(looseDate(t.year(), t.month() + shift + 1, 1) - 1.0)
				}
				let first = looseDate(t.year(), t.month() + shift, 1)
				let target = civil(first)
				let last = time.daysInMonth(target.year(), target.month())
				return num(first + float((t.day() > last ?? (last, t.day())) - 1))
			case "DAYS":
				let end = numberArg(0, 0.0)
				return end when end.isError()
				let start = numberArg(1, 0.0)
				return start when start.isError()
				return num(end.number.floor() - start.number.floor())
			default:
				return failure("#NAME?")
		}
	}
}
