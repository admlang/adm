// Formulas as trees: the parser.
internal partial module std.formats.sheets.formula {
	// One node of a parsed formula.
	type Node {
		// 'n' number, 't' text, 'l' bool, 'e' error, 'b' blank, 'r' reference, 'N' a
		// defined name, 'u' unary and 'o' binary operator (text holds it),
		// '%' percent, 'f' function call (text holds the name in upper
		// case), 'a' array constant (top rows of left items in args).
		kind   char
		text   string = ""
		number float  = 0.0
		args   Node[] = []
		// A reference: its sheet ("" for the formula's own) and corners
		// from 0; bottom or right is -1 for a whole column or row.
		sheet  string = ""
		top    int    = 0
		left   int    = 0
		bottom int    = 0
		right  int    = 0

		def new(kind char) {
			self.kind = kind
		}

		def new(kind char, text string) {
			self.kind = kind
			self.text = text
		}
	}

	internal def errorNode(code string) Node {
		return new Node('e', code)
	}

	// Parser reads a formula (without its `=`) by precedence: comparison,
	// `&`, `+ -`, `* /`, `^`, unary sign, `%`.
	type Parser {
		b      byte[]
		i      int    = 0
		failed bool   = false

		def new(formula string) {
			b = formula.bytes()
		}

		// The formula's tree; an error node of `#NAME?` when the text is
		// not a formula.
		def parse() Node {
			let node = compare()
			skip()
			return errorNode("#NAME?") when failed || i < b.len()
			return node
		}

		def skip() {
			for i < b.len() && (b[i] == byte(' ') || b[i] == byte('\t') || b[i] == byte('\n') || b[i] == byte('\r')) {
				i++
			}
		}

		def peek() byte {
			skip()
			return i < b.len() ?? (b[i], byte(0))
		}

		def binary(op string, a Node, c Node) Node {
			let node = new Node('o', op)
			node.args = [a, c]
			return node
		}

		def compare() Node {
			let node = concat()
			for !failed {
				let c = peek()
				let op = ""
				if c == byte('=') {
					op = "="
				} else if c == byte('<') {
					op = i + 1 < b.len() && b[i + 1] == byte('=') ?? ("<=", i + 1 < b.len() && b[i + 1] == byte('>') ?? ("<>", "<"))
				} else if c == byte('>') {
					op = i + 1 < b.len() && b[i + 1] == byte('=') ?? (">=", ">")
				} else {
					break
				}
				i += op.len()
				node = binary(op, node, concat())
			}
			return node
		}

		def concat() Node {
			let node = sum()
			for !failed && peek() == byte('&') {
				i++
				node = binary("&", node, sum())
			}
			return node
		}

		def sum() Node {
			let node = product()
			for !failed {
				let c = peek()
				break unless c == byte('+') || c == byte('-')
				i++
				node = binary(string([c]), node, product())
			}
			return node
		}

		def product() Node {
			let node = power()
			for !failed {
				let c = peek()
				break unless c == byte('*') || c == byte('/')
				i++
				node = binary(string([c]), node, power())
			}
			return node
		}

		def power() Node {
			let node = unary()
			for !failed && peek() == byte('^') {
				i++
				node = binary("^", node, unary())
			}
			return node
		}

		def unary() Node {
			let c = peek()
			if c == byte('-') || c == byte('+') {
				i++
				let node = new Node('u', string([c]))
				node.args = [unary()]
				return node
			}
			let node = primary()
			for !failed && peek() == byte('%') {
				i++
				let percent = new Node('%')
				percent.args = [node]
				node = percent
			}
			return node
		}

		def primary() Node {
			let c = peek()
			if c == byte(0) {
				failed = true
				return errorNode("#NAME?")
			}
			if c == byte('(') {
				i++
				let node = compare()
				if peek() != byte(')') {
					failed = true
					return node
				}
				i++
				return node
			}
			if c == byte('"') {
				let out byte[] = []
				i++
				for i < b.len() {
					if b[i] == byte('"') {
						break unless i + 1 < b.len() && b[i + 1] == byte('"')
						i++
					}
					out.push(b[i])
					i++
				}
				failed = true when i >= b.len()
				i++
				return new Node('t', string(out))
			}
			if c == byte('{') {
				return arrayConstant()
			}
			if c == byte('#') {
				let start = i
				i++
				for i < b.len() && (isNameByte(b[i]) || b[i] == byte('/') || b[i] == byte('!') || b[i] == byte('?')) {
					i++
				}
				return errorNode(string(b.slice(start, i - start)).upper())
			}
			if (c >= byte('0') && c <= byte('9')) || c == byte('.') {
				let rows = rowRange("")
				return rows unless rows is none
				return numberLiteral()
			}
			if c == byte('\'') {
				// A quoted sheet name, then `!` and a reference.
				let start = i
				i++
				for i < b.len() && b[i] != byte('\'') {
					i++
				}
				let sheet = string(b.slice(start + 1, i - start - 1))
				i++
				if i >= b.len() || b[i] != byte('!') {
					failed = true
					return errorNode("#NAME?")
				}
				i++
				return reference(sheet)
			}
			if c == byte('$') || isNameByte(c) {
				// `Sheet!A1`: a name directly followed by `!`.
				let end = i
				for end < b.len() && isNameByte(b[end]) {
					end++
				}
				if end < b.len() && b[end] == byte('!') && c != byte('$') {
					let sheet = string(b.slice(i, end - i))
					i = end + 1
					return reference(sheet)
				}
				let found = refAt(b, i)
				if !(found is none) || columnRangeAt() {
					return reference("")
				}
				let name = string(b.slice(i, end - i))
				if end == i {
					failed = true
					return errorNode("#NAME?")
				}
				i = end
				if peek() == byte('(') {
					return call(name.upper())
				}
				let upper = name.upper()
				if upper == "TRUE" || upper == "FALSE" {
					let node = new Node('l')
					node.number = upper == "TRUE" ?? (1.0, 0.0)
					return node
				}
				return new Node('N', name)
			}
			failed = true
			return errorNode("#NAME?")
		}

		def numberLiteral() Node {
			let start = i
			for i < b.len() && ((b[i] >= byte('0') && b[i] <= byte('9')) || b[i] == byte('.')) {
				i++
			}
			if i < b.len() && (b[i] == byte('e') || b[i] == byte('E')) {
				let mark = i
				i++
				i++ when i < b.len() && (b[i] == byte('+') || b[i] == byte('-'))
				if i < b.len() && b[i] >= byte('0') && b[i] <= byte('9') {
					for i < b.len() && b[i] >= byte('0') && b[i] <= byte('9') {
						i++
					}
				} else {
					i = mark
				}
			}
			let node = new Node('n')
			node.number = parseFloat<float>(string(b.slice(start, i - start)))
			return node
		}

		// Reports whether whole columns (`A:C`, `$A:$A`) start at i.
		def columnRangeAt() bool {
			let at = i
			for let part = 0; part < 2; part++ {
				at++ when at < b.len() && b[at] == byte('$')
				let start = at
				for at < b.len() && (int(b[at]) | 32) >= 97 && (int(b[at]) | 32) <= 122 && b[at] < byte(128) {
					at++
				}
				return false when at == start || at - start > 3
				if part == 0 {
					return false unless at < b.len() && b[at] == byte(':')
					at++
				}
			}
			return !(at < b.len() && (isNameByte(b[at]) || b[at] == byte('(')))
		}

		// Whole rows (`1:3`) at i as a reference; none when the text there
		// is a number.
		def rowRange(sheet string) ?Node {
			let at = i
			let rows int[] = []
			for let part = 0; part < 2; part++ {
				at++ when at < b.len() && b[at] == byte('$')
				let start = at
				let value = 0
				for at < b.len() && b[at] >= byte('0') && b[at] <= byte('9') && at - start < 8 {
					value = value * 10 + int(b[at]) - 48
					at++
				}
				return none when at == start || value == 0
				rows.push(value - 1)
				if part == 0 {
					return none unless at < b.len() && b[at] == byte(':')
					at++
				}
			}
			return none when at < b.len() && (isNameByte(b[at]) || b[at] == byte('.'))
			i = at
			let node = new Node('r')
			node.sheet = sheet
			node.top = rows[0] < rows[1] ?? (rows[0], rows[1])
			node.bottom = rows[0] < rows[1] ?? (rows[1], rows[0])
			node.left = 0
			node.right = -1
			return node
		}

		def columnLetters() int {
			i++ when i < b.len() && b[i] == byte('$')
			let column = 0
			for i < b.len() && (int(b[i]) | 32) >= 97 && (int(b[i]) | 32) <= 122 && b[i] < byte(128) {
				column = column * 26 + (int(b[i]) | 32) - 96
				i++
			}
			return column - 1
		}

		// A cell, a range, whole columns or whole rows at i.
		def reference(sheet string) Node {
			let node = new Node('r')
			node.sheet = sheet
			let first = refAt(b, i)
			if first is none {
				if columnRangeAt() {
					let a = columnLetters()
					i++
					let c = columnLetters()
					node.left = a < c ?? (a, c)
					node.right = a < c ?? (c, a)
					node.top = 0
					node.bottom = -1
					return node
				}
				let rows = rowRange(sheet)
				return rows unless rows is none
				// `Sheet!Name` or a damaged reference.
				failed = true
				return errorNode("#REF!")
			}
			i = first.end
			node.top = first.row
			node.left = first.column
			node.bottom = first.row
			node.right = first.column
			if i < b.len() && b[i] == byte(':') {
				// The far corner may repeat the sheet name.
				let at = i + 1
				let mark = at
				for mark < b.len() && isNameByte(b[mark]) {
					mark++
				}
				at = mark + 1 when mark < b.len() && b[mark] == byte('!')
				let second = refAt(b, at)
				if !(second is none) {
					i = second.end
					node.top = first.row < second.row ?? (first.row, second.row)
					node.bottom = first.row < second.row ?? (second.row, first.row)
					node.left = first.column < second.column ?? (first.column, second.column)
					node.right = first.column < second.column ?? (second.column, first.column)
				}
			}
			return node
		}

		def call(name string) Node {
			let node = new Node('f', name)
			i++
			if peek() == byte(')') {
				i++
				return node
			}
			for !failed {
				// An argument left out (`IF(A1,,2)`) is a blank.
				if peek() == byte(',') || peek() == byte(')') {
					node.args.push(new Node('b'))
				} else {
					node.args.push(compare())
				}
				let c = peek()
				if c == byte(',') {
					i++
					continue
				}
				if c == byte(')') {
					i++
					return node
				}
				failed = true
			}
			return node
		}

		// `{1,2;3,4}`: rows parted by `;`, items by `,`.
		def arrayConstant() Node {
			let node = new Node('a')
			i++
			let rows = 1
			let width = 0
			let inRow = 0
			for !failed {
				node.args.push(unary())
				inRow++
				let c = peek()
				if c == byte(',') {
					i++
				} else if c == byte(';') {
					i++
					width = inRow when width == 0
					failed = true when inRow != width
					inRow = 0
					rows++
				} else if c == byte('}') {
					i++
					width = inRow when width == 0
					failed = true when inRow != width
					break
				} else {
					failed = true
				}
			}
			node.top = rows
			node.left = width
			return node
		}
	}
}
