// Formulas as text: finding and moving the cell references in them.
internal partial module std.formats.sheets.formula {
	use std.formats.sheets::(columnName, maxColumns)

	// Reports whether the byte can be part of a name in a formula.
	def isNameByte(c byte) bool {
		return (c >= byte('a') && c <= byte('z')) || (c >= byte('A') && c <= byte('Z')) || (c >= byte('0') && c <= byte('9')) || c == byte('_') || c == byte('.') || c >= byte(128)
	}

	// A cell reference found in formula text.
	struct RefSpan {
		// Bytes [start, end) of the formula.
		start       int
		end         int
		row         int
		column      int
		fixedRow    bool
		fixedColumn bool
	}

	// Reads a cell reference (`B2`, `$B$2`) at byte i of a formula; none
	// when the text there is a name, a function or a number.
	def refAt(b byte[], i int) ?RefSpan {
		let n = b.len()
		let at = i
		let fixedColumn = at < n && b[at] == byte('$')
		at++ when fixedColumn
		let column = 0
		let letters = 0
		for at < n && letters < 4 {
			let c = int(b[at]) | 32
			break unless c >= 97 && c <= 122 && b[at] < byte(128)
			column = column * 26 + (c - 96)
			letters++
			at++
		}
		return none unless letters >= 1 && letters <= 3 && column <= maxColumns
		let fixedRow = at < n && b[at] == byte('$')
		at++ when fixedRow
		let row = 0
		let digits = 0
		for at < n && b[at] >= byte('0') && b[at] <= byte('9') && digits < 8 {
			row = row * 10 + int(b[at]) - 48
			digits++
			at++
		}
		return none unless digits > 0 && row > 0
		// `LOG10(` is a function, `A1B` and `A1.x` are names.
		return none when at < n && (isNameByte(b[at]) || b[at] == byte('('))
		return RefSpan{start: i, end: at, row: row - 1, column: column - 1, fixedRow: fixedRow, fixedColumn: fixedColumn}
	}

	// Every cell reference in the formula, in order. Text in double
	// quotes and sheet names in single quotes are skipped.
	def refSpans(formula string) RefSpan[] {
		let out RefSpan[] = []
		let b = formula.bytes()
		let n = b.len()
		let i = 0
		for i < n {
			let c = b[i]
			if c == byte('"') || c == byte('\'') {
				i++
				for i < n && b[i] != c {
					i++
				}
				i++
				continue
			}
			if c == byte('$') || (isNameByte(c) && !(c >= byte('0') && c <= byte('9')) && c != byte('.')) {
				let found = refAt(b, i)
				if !(found is none) {
					out.push(found)
					i = found.end
					continue
				}
				// A name, a function or a sheet name: skip all of it.
				i++
				for i < n && isNameByte(b[i]) {
					i++
				}
				continue
			}
			if c >= byte('0') && c <= byte('9') {
				// A number, with its exponent.
				for i < n && (isNameByte(b[i])) {
					i++
				}
				continue
			}
			i++
		}
		return out
	}

	// shiftFormula moves the relative references of a formula by rows and
	// columns, as copying a cell does; `$` parts stay. A reference moved
	// off the sheet becomes `#REF!`.
	def shiftFormula(formula string, rows int, columns int) string {
		return formula when rows == 0 && columns == 0
		let b = formula.bytes()
		let out = ""
		let last = 0
		for let (_, span) in refSpans(formula) {
			out += string(b.slice(last, span.start - last))
			let row = span.fixedRow ?? (span.row, span.row + rows)
			let column = span.fixedColumn ?? (span.column, span.column + columns)
			if row < 0 || column < 0 || column >= maxColumns {
				out += "#REF!"
			} else {
				out += (span.fixedColumn ?? ("$", "")) + columnName(column) + (span.fixedRow ?? ("$", "")) + (row + 1).str()
			}
			last = span.end
		}
		return out + string(b.slice(last, b.len() - last))
	}

	// Where the sheet prefix (`Name!` or `'My sheet'!`) of the reference
	// starting at `at` begins; `at` itself when it has none.
	def sheetPrefixStart(b byte[], at int) int {
		return at unless at >= 2 && b[at - 1] == byte('!')
		let i = at - 2
		if b[i] == byte('\'') {
			i--
			for i >= 0 && b[i] != byte('\'') {
				i--
			}
			return i < 0 ?? (at, i)
		}
		for i >= 0 && isNameByte(b[i]) {
			i--
		}
		return i + 1 == at - 1 ?? (at, i + 1)
	}

	// toOpenFormula writes a formula in the OpenFormula syntax ODS files
	// store: references in brackets with a dot before the cell
	// (`[.B2:.B3]`, `[$Prices.B2]`), `;` between arguments.
	def toOpenFormula(formula string) string {
		let b = formula.bytes()
		let n = b.len()
		let spans = refSpans(formula)
		let starts int[] = []
		for let (_, span) in spans {
			starts.push(sheetPrefixStart(b, span.start))
		}
		let out byte[] = []
		let k = 0
		let i = 0
		let braces = 0
		for i < n {
			if k < spans.len() && i == starts[k] {
				out.push(byte('['))
				// The sheet, `$` marking it as fixed, then the cell.
				if starts[k] < spans[k].start {
					out.push(byte('$'))
					out.push(...b.slice(starts[k], spans[k].start - 1 - starts[k]))
				}
				out.push(byte('.'))
				out.push(...b.slice(spans[k].start, spans[k].end - spans[k].start))
				i = spans[k].end
				k++
				if i < n && b[i] == byte(':') && k < spans.len() && starts[k] == i + 1 {
					out.push(byte(':'))
					if starts[k] < spans[k].start {
						out.push(byte('$'))
						out.push(...b.slice(starts[k], spans[k].start - 1 - starts[k]))
					}
					out.push(byte('.'))
					out.push(...b.slice(spans[k].start, spans[k].end - spans[k].start))
					i = spans[k].end
					k++
				}
				out.push(byte(']'))
				continue
			}
			let c = b[i]
			if c == byte('"') {
				let start = i
				i++
				for i < n && b[i] != byte('"') {
					i++
				}
				i++ when i < n
				out.push(...b.slice(start, i - start))
				continue
			}
			// In an array constant `;` parts columns and `|` rows.
			braces++ when c == byte('{')
			braces-- when c == byte('}')
			if c == byte(',') {
				out.push(byte(';'))
			} else if c == byte(';') && braces > 0 {
				out.push(byte('|'))
			} else {
				out.push(c)
			}
			i++
		}
		return prefixFunctions(string(out), "COM.MICROSOFT.", openPrefixed)
	}

	// fromOpenFormula reads an OpenFormula formula (with or without its
	// `of:=` prefix) into the syntax of this library, the one XLSX uses:
	// `Prices!B2:B3`, `,` between arguments.
	def fromOpenFormula(formula string) string {
		let text = formula
		for let (_, prefix) in ["of:", "oooc:", "msoxl:"] {
			text = text[prefix.len():] when text.startsWith(prefix)
		}
		let b = text.trimPrefix("=").bytes()
		let n = b.len()
		let out byte[] = []
		let i = 0
		for i < n {
			let c = b[i]
			if c == byte('"') {
				let start = i
				i++
				for i < n && b[i] != byte('"') {
					i++
				}
				i++ when i < n
				out.push(...b.slice(start, i - start))
				continue
			}
			if c != byte('[') {
				out.push(c == byte(';') ?? (byte(','), c == byte('|') ?? (byte(';'), c)))
				i++
				continue
			}
			let close = i + 1
			let quoted = false
			for close < n && (quoted || b[close] != byte(']')) {
				quoted = !quoted when b[close] == byte('\'')
				close++
			}
			out.push(...openReference(string(b.slice(i + 1, close - i - 1))).bytes())
			i = close + 1
		}
		return unprefixFunctions(string(out))
	}

	// An OpenFormula reference without its brackets (`.B2:.B3`,
	// `$Prices.$B$2:.$B$3`, `$'My sheet'.A1`) as `Prices!$B$2:$B$3`.
	def openReference(inner string) string {
		let b = inner.bytes()
		let out = ""
		let first = ""
		let start = 0
		let quoted = false
		for let i = 0; i <= b.len(); i++ {
			if i < b.len() {
				quoted = !quoted when b[i] == byte('\'')
				continue when quoted || b[i] != byte(':')
			}
			let part = string(b.slice(start, i - start))
			start = i + 1
			// The last dot outside quotes parts the sheet from the cell.
			let pb = part.bytes()
			let dot = -1
			let inQuote = false
			for let (j, c) in pb {
				inQuote = !inQuote when c == byte('\'')
				dot = j when c == byte('.') && !inQuote
			}
			let sheet = dot <= 0 ?? ("", string(pb.slice(0, dot)).trimPrefix("$"))
			let cell = dot < 0 ?? (part, string(pb.slice(dot + 1, pb.len() - dot - 1)))
			if out == "" {
				first = sheet
				out = (sheet == "" ?? ("", sheet + "!")) + cell
			} else {
				out += ":" + (sheet == "" || sheet == first ?? ("", sheet + "!")) + cell
			}
		}
		return out
	}

	// Functions newer than the file formats: XLSX stores them with
	// `_xlfn.` before the name.
	const futureFunctions = ["IFS", "SWITCH", "CONCAT", "TEXTJOIN", "IFNA", "XOR", "DAYS", "STDEV.S", "STDEV.P", "VAR.S", "VAR.P", "MAXIFS", "MINIFS", "XLOOKUP"]

	// Those of them OpenFormula files store with `COM.MICROSOFT.` before
	// the name.
	const openPrefixed = ["IFS", "SWITCH", "CONCAT", "TEXTJOIN", "STDEV.S", "STDEV.P", "VAR.S", "VAR.P", "MAXIFS", "MINIFS", "XLOOKUP"]

	// Writes the prefix before each call of one of the named functions.
	def prefixFunctions(formula string, prefix string, names string[]) string {
		let b = formula.bytes()
		let n = b.len()
		let out byte[] = []
		let i = 0
		for i < n {
			let c = b[i]
			if c == byte('"') || c == byte('\'') {
				let start = i
				i++
				for i < n && b[i] != c {
					i++
				}
				i++ when i < n
				out.push(...b.slice(start, i - start))
				continue
			}
			if isNameByte(c) {
				let start = i
				for i < n && isNameByte(b[i]) {
					i++
				}
				let word = string(b.slice(start, i - start))
				out.push(...prefix.bytes()) when i < n && b[i] == byte('(') && names.includes(word.upper())
				out.push(...word.bytes())
				continue
			}
			out.push(c)
			i++
		}
		return string(out)
	}

	// Drops the `_xlfn.`, `_xlws.` and `COM.MICROSOFT.` marks files put
	// before newer function names.
	def unprefixFunctions(formula string) string {
		return formula unless formula.contains("_xl") || formula.contains("COM.MICROSOFT.")
		let b = formula.bytes()
		let n = b.len()
		let out byte[] = []
		let i = 0
		for i < n {
			let c = b[i]
			if c == byte('"') || c == byte('\'') {
				let start = i
				i++
				for i < n && b[i] != c {
					i++
				}
				i++ when i < n
				out.push(...b.slice(start, i - start))
				continue
			}
			if isNameByte(c) {
				let start = i
				for i < n && isNameByte(b[i]) {
					i++
				}
				let word = string(b.slice(start, i - start))
				for let (_, mark) in ["_xlfn._xlws.", "_xlfn.", "_xlws.", "COM.MICROSOFT."] {
					if word.startsWith(mark) {
						word = word[mark.len():]
						break
					}
				}
				out.push(...word.bytes())
				continue
			}
			out.push(c)
			i++
		}
		return string(out)
	}

	// A formula as XLSX stores it.
	def toStoredFormula(formula string) string {
		return prefixFunctions(formula, "_xlfn.", futureFunctions)
	}
}
