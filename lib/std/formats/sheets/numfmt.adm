// Number format codes: how a cell's number or date is shown.
internal partial module std.formats.sheets.numfmt {
	use std.time

	// The format codes spreadsheets build in, by the id XLSX files name
	// them with; "" for the general format and for ids without a code.
	def builtinFormat(id int) string {
		match id {
			case 1:
				return "0"
			case 2:
				return "0.00"
			case 3:
				return "#,##0"
			case 4:
				return "#,##0.00"
			case 9:
				return "0%"
			case 10:
				return "0.00%"
			case 11:
				return "0.00E+00"
			case 12:
				return "# ?/?"
			case 13:
				return "# ??/??"
			case 14:
				return "mm-dd-yy"
			case 15:
				return "d-mmm-yy"
			case 16:
				return "d-mmm"
			case 17:
				return "mmm-yy"
			case 18:
				return "h:mm AM/PM"
			case 19:
				return "h:mm:ss AM/PM"
			case 20:
				return "h:mm"
			case 21:
				return "h:mm:ss"
			case 22:
				return "m/d/yy h:mm"
			case 37:
				return "#,##0 ;(#,##0)"
			case 38:
				return "#,##0 ;[Red](#,##0)"
			case 39:
				return "#,##0.00;(#,##0.00)"
			case 40:
				return "#,##0.00;[Red](#,##0.00)"
			case 45:
				return "mm:ss"
			case 46:
				return "[h]:mm:ss"
			case 47:
				return "mmss.0"
			case 48:
				return "##0.0E+0"
			case 49:
				return "@"
			default:
				return ""
		}
	}

	// One piece of a format section.
	struct Token {
		// 'l' literal text, 'd' a date or time part, '0' '#' '?' digit
		// places, '.' the decimal point, ',' a comma among digit places,
		// '%' percent, 'E' an exponent (text holds its sign and digits),
		// '@' the cell's text, 'a' AM/PM, 'e' elapsed hours, minutes or
		// seconds, 'f' fractional seconds, '/' a fraction bar.
		kind char
		text string
	}

	// Splits a format code into its `;` sections, quotes and brackets
	// respected.
	def sections(code string) string[] {
		let out string[] = []
		let b = code.bytes()
		let start = 0
		let i = 0
		for i < b.len() {
			let c = b[i]
			if c == byte('"') {
				i++
				for i < b.len() && b[i] != byte('"') {
					i++
				}
			} else if c == byte('[') {
				for i < b.len() && b[i] != byte(']') {
					i++
				}
			} else if c == byte('\\') {
				i++
			} else if c == byte(';') {
				out.push(string(b.slice(start, i - start)))
				start = i + 1
			}
			i++
		}
		out.push(start <= b.len() ?? (string(b.slice(start, b.len() - start)), ""))
		return out
	}

	// Reads a section into tokens. Colours, conditions and locale marks in
	// brackets are dropped, a currency symbol in `[$€-407]` kept.
	def tokens(section string) Token[] {
		let out Token[] = []
		let b = section.bytes()
		let n = b.len()
		let i = 0
		for i < n {
			let c = b[i]
			let lower = int(c) | 32
			if c == byte('"') {
				let start = i + 1
				i++
				for i < n && b[i] != byte('"') {
					i++
				}
				out.push(Token{kind: 'l', text: string(b.slice(start, i - start))})
				i++
			} else if c == byte('\\') {
				// One character, which may be several bytes.
				let start = i + 1
				i += 2
				for i < n && (int(b[i]) & 0xC0) == 0x80 {
					i++
				}
				out.push(Token{kind: 'l', text: string(b.slice(start, i - start))}) when start < n
			} else if c == byte('_') {
				// Space as wide as the next character.
				out.push(Token{kind: 'l', text: " "})
				i += 2
			} else if c == byte('*') {
				// Fill with the next character: nothing to fill here.
				i += 2
			} else if c == byte('[') {
				let start = i + 1
				for i < n && b[i] != byte(']') {
					i++
				}
				let inner = string(b.slice(start, i - start))
				i++
				let low = inner.lower()
				if low != "" && (low.replace("h", "") == "" || low.replace("m", "") == "" || low.replace("s", "") == "") {
					out.push(Token{kind: 'e', text: low})
				} else if inner.startsWith("$") {
					let dash = inner.indexOf("-")
					let symbol = dash < 0 ?? (inner[1:], inner[1:dash])
					out.push(Token{kind: 'l', text: symbol}) unless symbol == ""
				}
			} else if c == byte('0') || c == byte('#') || c == byte('?') {
				out.push(Token{kind: char(c), text: ""})
				i++
			} else if c == byte('.') {
				// After seconds, `.000` is a fraction of a second.
				let last = out.len() > 0 ?? (out[out.len() - 1], Token{kind: 'l', text: ""})
				if last.kind == 'd' && last.text.startsWith("s") {
					let start = i + 1
					i++
					for i < n && b[i] == byte('0') {
						i++
					}
					out.push(Token{kind: 'f', text: string(b.slice(start, i - start))})
				} else {
					out.push(Token{kind: '.', text: ""})
					i++
				}
			} else if c == byte(',') || c == byte('%') || c == byte('@') || c == byte('/') {
				out.push(Token{kind: char(c), text: ""})
				i++
			} else if (c == byte('E') || c == byte('e')) && i + 1 < n && (b[i + 1] == byte('+') || b[i + 1] == byte('-')) {
				let start = i + 1
				i += 2
				for i < n && (b[i] == byte('0') || b[i] == byte('#') || b[i] == byte('?')) {
					i++
				}
				out.push(Token{kind: 'E', text: string(b.slice(start, i - start))})
			} else if lower == 97 && string(b.slice(i, n - i)).lower().startsWith("am/pm") {
				out.push(Token{kind: 'a', text: string(b.slice(i, 5))})
				i += 5
			} else if lower == 97 && string(b.slice(i, n - i)).lower().startsWith("a/p") {
				out.push(Token{kind: 'a', text: string(b.slice(i, 3))})
				i += 3
			} else if lower == 121 || lower == 109 || lower == 100 || lower == 104 || lower == 115 {
				let start = i
				for i < n && (int(b[i]) | 32) == lower {
					i++
				}
				out.push(Token{kind: 'd', text: string(b.slice(start, i - start)).lower()})
			} else if string(b.slice(i, n - i)).lower().startsWith("general") {
				out.push(Token{kind: 'G', text: ""})
				i += 7
			} else {
				// Any other character shows as itself.
				let start = i
				i++
				for i < n && (int(b[i]) & 0xC0) == 0x80 {
					i++
				}
				out.push(Token{kind: 'l', text: string(b.slice(start, i - start))})
			}
		}
		return out
	}

	// Reports whether a format code shows dates or times.
	def isDateFormat(code string) bool {
		return false when code == ""
		for let (_, t) in tokens(sections(code)[0]) {
			return true when t.kind := 'd' || 'a' || 'e'
		}
		return false
	}

	// A number as the general format shows it: up to 15 significant digits.
	def general(value float) string {
		return "0" when value == 0.0
		let magnitude = value.abs()
		if magnitude >= 1e15 || magnitude < 1e-9 {
			return "%.14E".format(value).replace("E+0", "E+").replace("E-0", "E-").replace(".00000000000000E", "E")
		}
		let text = "%.15g".format(value)
		if text.contains("e") || text.contains("E") {
			text = "%.15f".format(value)
		}
		if text.contains(".") {
			for text.endsWith("0") {
				text = text[:text.len() - 1]
			}
			text = text.trimSuffix(".")
		}
		return text
	}

	// formatNumber shows a number, or with `date` a day number, in a format
	// code; an empty code is the general format.
	def formatNumber(value float, code string, date bool) string {
		if code == "" || code.lower() == "general" {
			return general(value) unless date
			let whole = value == value.floor()
			code = whole ?? ("yyyy-mm-dd", value.abs() < 1.0 ?? ("hh:mm:ss", "yyyy-mm-dd hh:mm:ss"))
		}
		let parts = sections(code)
		let section = parts[0]
		let shown = value
		if value < 0.0 && parts.len() >= 2 {
			section = parts[1]
			shown = -value
		} else if value == 0.0 && parts.len() >= 3 {
			section = parts[2]
		}
		let toks = tokens(section)
		let isDate = false
		let isNumber = false
		for let (_, t) in toks {
			isDate = true when t.kind := 'd' || 'a' || 'e'
			isNumber = true when t.kind := '0' || '#' || '?'
		}
		return formatDate(shown, toks) when isDate
		return formatDecimal(shown, toks, value < 0.0 && parts.len() < 2) when isNumber
		// No digit places: the literals, the general number at `General`.
		let out = ""
		for let (_, t) in toks {
			out += t.text when t.kind == 'l'
			out += general(shown) when t.kind == 'G' || t.kind == '@'
		}
		return out
	}

	internal const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]
	internal const dayNames = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"]

	internal def two(n int) string {
		return n < 10 ?? ("0" + n.str(), n.str())
	}

	internal def formatDate(serial float, toks Token[]) string {
		let ms = ((serial - 25569.0) * 86400000.0).round()
		let t = time.fromUnixNs(int64(ms) * 1000000)
		let twelve = false
		for let (_, tok) in toks {
			twelve = true when tok.kind == 'a'
		}
		let out = ""
		for let (i, tok) in toks {
			match tok.kind {
				case 'l':
					out += tok.text
				case '/', ',', '.':
					out += string([byte(tok.kind)])
				case 'a':
					let pm = t.hour() >= 12
					if tok.text.len() == 3 {
						out += tok.text[0] == 'a' ?? (pm ?? ("p", "a"), pm ?? ("P", "A"))
					} else {
						out += pm ?? ("PM", "AM")
					}
				case 'f':
					let milli = t.nanosecond() / 1000000
					out += "." + (milli + 1000).str()[1:1 + (tok.text.len() > 3 ?? (3, tok.text.len()))]
				case 'e':
					let seconds = (serial * 86400.0).round()
					let unit = tok.text[0] == 'h' ?? (3600.0, tok.text[0] == 'm' ?? (60.0, 1.0))
					out += int64((seconds / unit).floor()).str().padStart(tok.text.len(), "0")
				case 'd':
					let code = tok.text
					let lead = code[0]
					if lead == 'y' {
						out += code.len() <= 2 ?? (two(t.year() % 100), t.year().str().padStart(4, "0"))
					} else if lead == 'd' {
						if code.len() == 1 {
							out += t.day().str()
						} else if code.len() == 2 {
							out += two(t.day())
						} else {
							let name = dayNames[int(t.weekday())]
							out += code.len() == 3 ?? (name[:3], name)
						}
					} else if lead == 'h' {
						let hour = t.hour()
						hour = hour % 12 == 0 ?? (12, hour % 12) when twelve
						out += code.len() == 1 ?? (hour.str(), two(hour))
					} else if lead == 's' {
						out += code.len() == 1 ?? (t.second().str(), two(t.second()))
					} else if minutesAt(toks, i) {
						out += code.len() == 1 ?? (t.minute().str(), two(t.minute()))
					} else if code.len() == 1 {
						out += t.month().str()
					} else if code.len() == 2 {
						out += two(t.month())
					} else {
						let name = monthNames[t.month() - 1]
						out += code.len() == 3 ?? (name[:3], code.len() == 5 ?? (name[:1], name))
					}
				default:
			}
		}
		return out
	}

	// Reports whether the `m` token at i stands for minutes: the date part
	// before it is hours, or the one after it seconds.
	internal def minutesAt(toks Token[], i int) bool {
		for let k = i - 1; k >= 0; k-- {
			if toks[k].kind == 'd' || toks[k].kind == 'e' {
				return true when toks[k].text.startsWith("h")
				break
			}
		}
		for let k = i + 1; k < toks.len(); k++ {
			if toks[k].kind == 'd' || toks[k].kind == 'e' {
				return toks[k].text.startsWith("s")
			}
		}
		return false
	}

	// Groups integer digits in threes with commas.
	internal def grouped(digits string) string {
		let out = ""
		let n = digits.len()
		for let (i, c) in digits.bytes() {
			out += "," when i > 0 && (n - i) % 3 == 0
			out += string([c])
		}
		return out
	}

	internal def formatDecimal(value float, toks Token[], minus bool) string {
		// What the section asks for.
		let intZeros = 0
		let fracPlaces = 0
		let fracZeros = 0
		let percent = 0
		let scale = 0
		let thousands = false
		let exponent = ""
		let fraction = false
		let seenPoint = false
		let lastDigit = -1
		for let (i, t) in toks {
			lastDigit = i when t.kind := '0' || '#' || '?'
		}
		for let (i, t) in toks {
			if t.kind := '0' || '#' || '?' {
				if seenPoint {
					fracPlaces++
					fracZeros = fracPlaces when t.kind == '0'
				} else {
					intZeros++ when t.kind == '0'
				}
			} else if t.kind == '.' {
				seenPoint = true
			} else if t.kind == ',' {
				// Between digit places a comma groups; after the last one
				// each divides by a thousand.
				if i < lastDigit {
					thousands = true
				} else {
					scale++
				}
			} else if t.kind == '%' {
				percent++
			} else if t.kind == 'E' {
				exponent = t.text
			} else if t.kind == '/' {
				fraction = true
			}
		}
		let v = value.abs()
		for let k = 0; k < percent; k++ {
			v *= 100.0
		}
		for let k = 0; k < scale; k++ {
			v /= 1000.0
		}
		return (minus ?? ("-", "")) + formatFraction(v, toks) when fraction && exponent == ""

		let power = 0
		if exponent != "" && v != 0.0 {
			for v >= 10.0 {
				v /= 10.0
				power++
			}
			for v < 1.0 {
				v *= 10.0
				power--
			}
			// Rounding may carry into a second integer digit.
			if ("%." + fracPlaces.str() + "f").format(v).startsWith("10") {
				v /= 10.0
				power++
			}
		}
		let fixed = ("%." + fracPlaces.str() + "f").format(v)
		let point = fixed.indexOf(".")
		let whole = point < 0 ?? (fixed, fixed[:point])
		let frac = point < 0 ?? ("", fixed[point + 1:])
		for frac.len() > fracZeros && frac.endsWith("0") {
			frac = frac[:frac.len() - 1]
		}
		whole = "" when whole == "0" && intZeros == 0
		whole = whole.padStart(intZeros, "0")
		whole = grouped(whole) when thousands

		let out = minus ?? ("-", "")
		let wroteInt = false
		let afterPoint = false
		for let (_, t) in toks {
			match t.kind {
				case 'l':
					out += t.text
				case '0', '#', '?':
					if !afterPoint && !wroteInt {
						out += whole
						wroteInt = true
					}
				case '.':
					afterPoint = true
					if !wroteInt {
						out += whole
						wroteInt = true
					}
					out += "." + frac unless frac == "" && fracZeros == 0 && fracPlaces > 0
					out += "." when frac == "" && fracPlaces == 0
				case '%':
					out += "%"
				case 'E':
					let digits = power.abs().str().padStart(t.text.len() - 1, "0")
					out += "E" + (power < 0 ?? ("-", t.text.startsWith("+") ?? ("+", ""))) + digits
				default:
			}
		}
		return out
	}

	// A number as an integer and a fraction (`# ?/?`, `# ??/16`): the
	// closest fraction whose denominator fits the places after the bar, or
	// the denominator written there.
	internal def formatFraction(value float, toks Token[]) string {
		let bar = 0
		for let (i, t) in toks {
			bar = i when t.kind == '/'
		}
		let places = 0
		let fixed = ""
		for let k = bar + 1; k < toks.len(); k++ {
			if toks[k].kind := '0' || '#' || '?' {
				places++
			} else if toks[k].kind == 'l' && toks[k].text.len() > 0 && toks[k].text.bytes()[0] >= byte('1') && toks[k].text.bytes()[0] <= byte('9') {
				fixed += toks[k].text
			} else {
				break
			}
		}
		// Digit places before the numerator's run are the integer part.
		let hasWhole = false
		let run = 0
		for let k = 0; k < bar; k++ {
			if toks[k].kind := '0' || '#' || '?' {
				run++
			} else if run > 0 {
				hasWhole = true
				run = 0
			}
		}
		let whole = hasWhole ?? (value.floor(), 0.0)
		let rest = value - whole
		let bestN = 0
		let bestD = 1
		if fixed != "" {
			bestD = parseInt<int>(fixed)
			bestN = int((rest * float(bestD)).round())
		} else {
			let limit = 1
			for let k = 0; k < places; k++ {
				limit *= 10
			}
			let bestError = rest
			for let d = 1; d < limit; d++ {
				let n = int((rest * float(d)).round())
				let miss = (rest - float(n) / float(d)).abs()
				if miss < bestError - 1e-12 {
					bestError = miss
					bestN = n
					bestD = d
				}
			}
		}
		if hasWhole && bestN >= bestD && bestD > 0 {
			whole += 1.0
			bestN -= bestD
		}
		let out = ""
		out = int64(whole).str() when hasWhole && (whole != 0.0 || bestN == 0)
		return out when bestN == 0 && hasWhole
		out += " " unless out == ""
		return out + bestN.str() + "/" + bestD.str()
	}

	// Reports whether text is a decimal number: sign, digits, an optional
	// fraction and exponent.
	def isNumberText(text string) bool {
		let b = text.bytes()
		let i = 0
		i++ when b.len() > 0 && (b[0] == byte('+') || b[0] == byte('-'))
		let digits = 0
		for i < b.len() && b[i] >= byte('0') && b[i] <= byte('9') {
			i++
			digits++
		}
		if i < b.len() && b[i] == byte('.') {
			i++
			for i < b.len() && b[i] >= byte('0') && b[i] <= byte('9') {
				i++
				digits++
			}
		}
		return false when digits == 0
		if i < b.len() && (b[i] == byte('e') || b[i] == byte('E')) {
			i++
			i++ when i < b.len() && (b[i] == byte('+') || b[i] == byte('-'))
			let start = i
			for i < b.len() && b[i] >= byte('0') && b[i] <= byte('9') {
				i++
			}
			return false when i == start
		}
		return i == b.len()
	}

	// The day number of a date in the proleptic Gregorian calendar.
	def dateSerial(year int, month int, day int) float {
		// Days from civil, with March as the first month of the year.
		let y = month <= 2 ?? (year - 1, year)
		let era = (y >= 0 ?? (y, y - 399)) / 400
		let yoe = y - era * 400
		let mp = (month + 9) % 12
		let doy = (153 * mp + 2) / 5 + day - 1
		let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
		// 719468 days from 0000-03-01 to 1970-01-01, 25569 from 1899-12-30.
		return float(era * 146097 + doe - 719468 + 25569)
	}

	// The day number of `yyyy-mm-dd`, optionally followed by `T` or a
	// space and `hh:mm`, `hh:mm:ss` or `hh:mm:ss.fff`, a `Z` allowed at
	// the end; none when the text is anything else.
	def isoSerial(text string) ?float {
		let b = text.trimSuffix("Z").bytes()
		return none unless b.len() >= 10 && b[4] == byte('-') && b[7] == byte('-')
		let nums int[] = []
		let seps = "--T::"
		let i = 0
		let fraction = 0.0
		for i < b.len() {
			let start = i
			let v = 0
			for i < b.len() && b[i] >= byte('0') && b[i] <= byte('9') {
				v = v * 10 + int(b[i]) - 48
				i++
			}
			return none when i == start || i - start > 4
			nums.push(v)
			break when i >= b.len()
			if nums.len() == 6 && b[i] == byte('.') {
				let digits = string(b.slice(i, b.len() - i))
				return none unless isNumberText("0" + digits)
				fraction = parseFloat<float>("0" + digits)
				break
			}
			return none when nums.len() > 5
			let want = seps.bytes()[nums.len() - 1]
			return none unless b[i] == want || (want == byte('T') && b[i] == byte(' '))
			i++
		}
		return none unless nums.len() == 3 || nums.len() == 5 || nums.len() == 6
		let (year, month, day) = (nums[0], nums[1], nums[2])
		return none unless month >= 1 && month <= 12 && day >= 1 && day <= time.daysInMonth(year, month)
		let serial = dateSerial(year, month, day)
		return serial when nums.len() == 3
		let seconds = nums.len() == 6 ?? (nums[5], 0)
		return none unless nums[3] < 24 && nums[4] < 60 && seconds < 60
		return serial + (float(nums[3] * 3600 + nums[4] * 60 + seconds) + fraction) / 86400.0
	}
}
