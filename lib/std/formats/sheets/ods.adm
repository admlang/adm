partial module std.formats.sheets {
	use (
		std.bytes
		std.formats.container::(openPackage)
		std.formats.sheets.ods::*
		std.io
	)

	// Ods is the OpenDocument spreadsheet codec, the format of LibreOffice
	// Calc.
	//
	// Decoding reads every table in order: numbers (percentages and
	// currency amounts too), texts with their line breaks, bools, dates
	// and times, errors, formulas (OpenFormula, converted to the `A1`
	// syntax XLSX uses) with their last results, each cell's number format
	// (the data style, as a format code), merged areas, column widths,
	// frozen rows and columns, named ranges, and the title and author of
	// the metadata. Fonts, colours, borders, charts, pictures, comments,
	// filters and validation are left out.
	//
	// Encoding writes a package LibreOffice and Excel open, with the same
	// content.
	@codec("OpenDocument Spreadsheet")
	type Ods {
		mimeType string[] {
			def get() string[] {
				return string["application/vnd.oasis.opendocument.spreadsheet"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".ods", ".ots"]
			}
		}

		// matchSignature reports whether the reader is a zip archive whose
		// first entry is the `mimetype` of an OpenDocument spreadsheet.
		def matchSignature(r io.Reader) bool {
			let b byte[]
			b.len(96)
			let n = 0
			for n < b.len() {
				let got = r.read(b[n:]) onerror recover 0
				break when got <= 0
				n += got
			}
			return false unless n >= 38 && string(b[30:38]) == "mimetype"
			return string(b[38:n]).startsWith("application/vnd.oasis.opendocument.spreadsheet")
		}

		// decode reads the whole reader as an ODS package.
		// Fails when the reader does, or as decode(byte[]) does.
		def decode(reader io.Reader) !Workbook {
			let source = new bytes.Buffer()
			try source.readFrom(reader)
			return decode(source.bytes())
		}

		// decode reads the bytes as an ODS package.
		// Fails when they are not a zip archive, the package has no
		// `content.xml`, or one of its parts is not well-formed XML.
		def decode(data byte[]) !Workbook {
			return readOds(try openPackage(data))
		}

		// encode writes the workbook as an ODS package.
		// Fails when the writer does.
		def encode(book Workbook, writer io.Writer) !none {
			let _ = try writer.write(try encode(book))
			return none
		}

		// encode returns the workbook as the bytes of an ODS package.
		// Fails only when the archive cannot be built.
		def encode(book Workbook) !byte[] {
			return writeOds(book)
		}
	}
}
