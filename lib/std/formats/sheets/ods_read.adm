internal partial module std.formats.sheets.ods {
	use (
		std.data.encoding::(XMLNode, XMLNodeKind)
		std.formats.container::(Package)
		std.formats.sheets::*
		std.formats.sheets.formula::(fromOpenFormula, openReference)
		std.formats.sheets.numfmt::(isDateFormat, isoSerial)
	)

	// What the style parts say that cells and columns refer to by name.
	type StyleTable {
		// Data style name to format code.
		formats map<string, string>
		// Cell style name to format code.
		cells   map<string, string>
		// Column style name to width in characters.
		widths  map<string, float>

		def new() {
			formats = map<string, string>{}
			cells = map<string, string>{}
			widths = map<string, float>{}
		}

		// Reads the styles below a `styles` or `automatic-styles` element.
		def add(holder XMLNode) {
			for let (_, node) in holder.children {
				continue unless node.kind == XMLNodeKind.Element && node.namespace == numberNS
				let name = at(node, "name", styleNS)
				formats[name] = formatOfStyle(node) unless name == ""
			}
			for let (_, node) in holder.elements("style", styleNS) {
				let name = at(node, "name", styleNS)
				let family = at(node, "family", styleNS)
				if family == "table-cell" {
					let data = at(node, "data-style-name", styleNS)
					if data != "" && formats.hasKey(data) {
						cells[name] = formats[data]
					} else {
						let parent = at(node, "parent-style-name", styleNS)
						cells[name] = cells[parent] when cells.hasKey(parent)
					}
				} else if family == "table-column" {
					let props = node.child("table-column-properties", styleNS)
					continue when props is none
					let width = lengthPixels(at(props, "column-width", styleNS))
					// To a hundredth of a character: lengths are stored in rounded units.
					widths[name] = ((width - 5.0) / 7.0 * 100.0).round() / 100.0 when width > 0.0
				}
			}
		}
	}

	// A length such as `2.258cm` or `0.889in` in pixels at 96 per inch; 0
	// when the text is not a length.
	def lengthPixels(text string) float {
		for let (_, unit) in [("cm", 96.0 / 2.54), ("mm", 96.0 / 25.4), ("in", 96.0), ("pt", 96.0 / 72.0), ("px", 1.0)] {
			let (suffix, scale) = unit
			continue unless text.endsWith(suffix)
			return parseFloat<float>(text[:text.len() - suffix.len()]) * scale
		}
		return 0.0
	}

	// The text of a cell: its paragraphs, a line break between them.
	def cellText(cell XMLNode) string {
		let lines string[] = []
		for let (_, p) in cell.elements("p", textNS) {
			lines.push(inlineText(p))
		}
		return lines.join("\n")
	}

	def inlineText(node XMLNode) string {
		let out = ""
		for let (_, part) in node.children {
			if part.kind == XMLNodeKind.Text {
				out += part.content
				continue
			}
			continue unless part.kind == XMLNodeKind.Element
			match part.localName {
				case "s":
					let n = at(part, "c", textNS)
					out += " ".repeat(n == "" ?? (1, parseInt<int>(n)))
				case "tab":
					out += "\t"
				case "line-break":
					out += "\n"
				case "note", "annotation":
					out += ""
				default:
					out += inlineText(part)
			}
		}
		return out
	}

	// An ISO 8601 duration of hours, minutes and seconds (`PT13H45M00S`)
	// as a fraction of a day; none when the text is not one.
	def durationDays(text string) ?float {
		return none unless text.startsWith("PT")
		let seconds = 0.0
		let number = ""
		for let (_, c) in text[2:].bytes() {
			if (c >= byte('0') && c <= byte('9')) || c == byte('.') || c == byte(',') {
				number += c == byte(',') ?? (".", string([c]))
				continue
			}
			return none when number == ""
			let value = parseFloat<float>(number)
			number = ""
			if c == byte('H') {
				seconds += value * 3600.0
			} else if c == byte('M') {
				seconds += value * 60.0
			} else if c == byte('S') {
				seconds += value
			} else {
				return none
			}
		}
		return seconds / 86400.0
	}

	def repeats(node XMLNode, name string) int {
		let value = at(node, name, tableNS)
		return value == "" ?? (1, parseInt<int>(value))
	}

	def readOds(pkg Package) !Workbook {
		let root = try pkg.xml("content.xml")
		fail "ods: the package has no content.xml" when root is none
		let book = new Workbook()
		let styles = new StyleTable()
		let shared = try pkg.xml("styles.xml")
		if !(shared is none) {
			for let (_, name) in ["styles", "automatic-styles"] {
				let holder = shared.child(name, officeNS)
				styles.add(holder) unless holder is none
			}
		}
		let automatic = root.child("automatic-styles", officeNS)
		styles.add(automatic) unless automatic is none

		let body = root.child("body", officeNS)
		let content = body is none ?? (none, body.child("spreadsheet", officeNS))
		fail "ods: the document is not a spreadsheet" when content is none
		for let (_, table) in content.elements("table", tableNS) {
			readTable(book.add(at(table, "name", tableNS)), table, styles)
		}

		let named = content.child("named-expressions", tableNS)
		if !(named is none) {
			for let (_, node) in named.children {
				continue unless node.kind == XMLNodeKind.Element
				let name = at(node, "name", tableNS)
				continue when name == ""
				if node.localName == "named-range" {
					book.names[name] = openReference(at(node, "cell-range-address", tableNS))
				} else if node.localName == "named-expression" {
					book.names[name] = fromOpenFormula(at(node, "expression", tableNS))
				}
			}
		}

		let info = try pkg.xml("meta.xml")
		if !(info is none) {
			let holder = info.child("meta", officeNS)
			if !(holder is none) {
				let title = holder.child("title")
				book.title = title.text() unless title is none
				let creator = holder.child("initial-creator")
				creator = holder.child("creator") when creator is none
				book.author = creator.text() unless creator is none
			}
		}

		let settings = try pkg.xml("settings.xml")
		readFrozen(book, settings) unless settings is none
		return book
	}

	// Frozen rows and columns live in the view settings, per table name.
	def readFrozen(book Workbook, settings XMLNode) {
		for let (_, entry) in settings.descendants("config-item-map-entry", configNS) {
			let sheet = book.sheet(at(entry, "name", configNS))
			continue when sheet is none
			let values = map<string, int>{}
			for let (_, item) in entry.elements("config-item", configNS) {
				let name = at(item, "name", configNS)
				continue unless name.contains("Split")
				values[name] = parseInt<int>(item.text())
			}
			// Mode 2 is frozen; 1 is a split in pixels.
			if values.hasKey("HorizontalSplitMode") && values["HorizontalSplitMode"] == 2 && values.hasKey("HorizontalSplitPosition") {
				sheet.frozenColumns = values["HorizontalSplitPosition"]
			}
			if values.hasKey("VerticalSplitMode") && values["VerticalSplitMode"] == 2 && values.hasKey("VerticalSplitPosition") {
				sheet.frozenRows = values["VerticalSplitPosition"]
			}
		}
	}

	def readTable(sheet Sheet, table XMLNode, styles StyleTable) {
		// Per column, the format its cells have when they name no style.
		let defaults string[] = []
		let column = 0
		let rowIndex = 0
		readRows(sheet, table, styles, defaults, column, rowIndex)
	}

	// Reads columns and rows below a table or one of its groups; returns
	// the column and row reached.
	def readRows(sheet Sheet, holder XMLNode, styles StyleTable, defaults string[], column int, rowIndex int) (int, int) {
		for let (_, node) in holder.children {
			continue unless node.kind == XMLNodeKind.Element
			match node.localName {
				case "table-column":
					let n = repeats(node, "number-columns-repeated")
					let width = styles.widths.get(at(node, "style-name", tableNS))
					let format = styles.cells.get(at(node, "default-cell-style-name", tableNS))
					// A run to the last column is the default, not data.
					if n <= 1024 {
						for let k = 0; k < n; k++ {
							sheet.widths[column + k] = width unless width is none
							defaults.len(column + k + 1) when defaults.len() <= column + k
							defaults[column + k] = format is none ?? ("", format)
						}
					}
					column += n
				case "table-column-group", "table-columns", "table-header-columns", "table-row-group", "table-rows", "table-header-rows":
					let (c, r) = readRows(sheet, node, styles, defaults, column, rowIndex)
					column = c
					rowIndex = r
				case "table-row":
					let n = repeats(node, "number-rows-repeated")
					let filled = readRow(sheet, node, styles, defaults, rowIndex)
					// A row with content that repeats is copied; empty runs are skipped.
					if filled && n > 1 {
						for let k = 1; k < n && k < 65536; k++ {
							let _ = readRow(sheet, node, styles, defaults, rowIndex + k)
						}
					}
					rowIndex += n
				default:
			}
		}
		return (column, rowIndex)
	}

	// Reads one row's cells into the sheet row; reports whether any cell
	// had content.
	def readRow(sheet Sheet, row XMLNode, styles StyleTable, defaults string[], rowIndex int) bool {
		let filled = false
		let column = 0
		for let (_, node) in row.children {
			continue unless node.kind == XMLNodeKind.Element
			let n = repeats(node, "number-columns-repeated")
			if node.localName != "table-cell" {
				column += n
				continue
			}
			let kind = at(node, "value-type", officeNS)
			let formula = at(node, "formula", tableNS)
			let styleName = at(node, "style-name", tableNS)
			let across = repeats(node, "number-columns-spanned")
			let down = repeats(node, "number-rows-spanned")
			if across > 1 || down > 1 {
				sheet.merges.push(Range{top: rowIndex, left: column, bottom: rowIndex + down - 1, right: column + across - 1})
				filled = true
			}
			if kind == "" && formula == "" {
				column += n
				continue
			}
			filled = true
			for let k = 0; k < n && k < maxColumns; k++ {
				let cell = sheet.cell(rowIndex, column + k)
				let format = styles.cells.get(styleName)
				if format is none {
					cell.format = defaults[column + k] when column + k < defaults.len()
				} else {
					cell.format = format
				}
				cell.formula = fromOpenFormula(formula) unless formula == ""
				match kind {
					case "float", "percentage", "currency":
						cell.set(parseFloat<float>(at(node, "value", officeNS)))
						cell.kind = CellKind.Date when isDateFormat(cell.format)
					case "boolean":
						cell.set(at(node, "boolean-value", officeNS) == "true")
					case "date":
						let serial = isoSerial(at(node, "date-value", officeNS))
						if serial is none {
							cell.set(cellText(node))
						} else {
							cell.kind = CellKind.Date
							cell.number = serial
						}
					case "time":
						let days = durationDays(at(node, "time-value", officeNS))
						if days is none {
							cell.set(cellText(node))
						} else {
							cell.kind = CellKind.Date
							cell.number = days
							cell.format = "hh:mm:ss" when cell.format == ""
						}
					case "string":
						if at(node, "value-type", calcextNS) == "error" {
							// The code is the shown text; the stored string is empty.
							cell.setError(cellText(node))
						} else {
							let stored = node.attribute("string-value", officeNS)
							cell.set(stored is none ?? (cellText(node), stored))
						}
					default:
				}
			}
			column += n
		}
		return filled
	}
}
