// ODF data styles and the number format codes they correspond to.
internal partial module std.formats.sheets.ods {
	use (
		std.data.encoding::(XMLNode, XMLNodeKind, XMLWriter)
		std.formats.sheets.numfmt::(isDateFormat, sections, tokens)
	)

	const officeNS = "urn:oasis:names:tc:opendocument:xmlns:office:1.0"
	const styleNS = "urn:oasis:names:tc:opendocument:xmlns:style:1.0"
	const textNS = "urn:oasis:names:tc:opendocument:xmlns:text:1.0"
	const tableNS = "urn:oasis:names:tc:opendocument:xmlns:table:1.0"
	const numberNS = "urn:oasis:names:tc:opendocument:xmlns:datastyle:1.0"
	const calcextNS = "urn:org:documentfoundation:names:experimental:calc:xmlns:calcext:1.0"
	const configNS = "urn:oasis:names:tc:opendocument:xmlns:config:1.0"

	// The value of an attribute in a namespace, "" when absent.
	def at(node XMLNode, name string, namespace string) string {
		let value = node.attribute(name, namespace)
		return value is none ?? ("", value)
	}

	def count(node XMLNode, name string, fallback int = 0) int {
		let value = at(node, name, numberNS)
		return value == "" ?? (fallback, parseInt<int>(value))
	}

	// A literal as a format code writes it.
	def literal(text string) string {
		return "" when text == ""
		return text when text := " " || "-" || "/" || ":" || "," || "." || "(" || ")"
		return "\"" + text.replace("\"", "") + "\""
	}

	// The digit places of a `number:number`-like element.
	def digitPlaces(node XMLNode) string {
		let whole = count(node, "min-integer-digits", 1)
		let decimals = count(node, "decimal-places")
		let fixed = at(node, "min-decimal-places", numberNS) == "" ?? (decimals, count(node, "min-decimal-places"))
		let out = whole == 0 ?? ("#", "0".repeat(whole))
		out = "#," + (whole >= 3 ?? ("", "#".repeat(3 - whole))) + out when at(node, "grouping", numberNS) == "true"
		out += "." + "0".repeat(fixed) + "#".repeat(decimals - fixed) when decimals > 0
		return out
	}

	// formatOfStyle gives the format code of an ODF data style element
	// (`number:number-style`, `-percentage-style`, `-currency-style`,
	// `-date-style`, `-time-style`, `-text-style`, `-boolean-style`).
	def formatOfStyle(node XMLNode) string {
		let out = ""
		let elapsed = at(node, "truncate-on-overflow", numberNS) == "false"
		for let (_, part) in node.children {
			continue unless part.kind == XMLNodeKind.Element
			let long = at(part, "style", numberNS) == "long"
			match part.localName {
				case "text":
					// The percent sign of a percentage style is the `%` that scales.
					out += node.localName == "percentage-style" && part.text().trim() == "%" ?? (part.text(), literal(part.text()))
				case "number":
					out += digitPlaces(part)
				case "scientific-number":
					out += digitPlaces(part) + "E+" + "0".repeat(count(part, "min-exponent-digits", 2))
				case "fraction":
					let whole = count(part, "min-integer-digits")
					out += (whole > 0 ?? ("# ", "")) + "?".repeat(count(part, "min-numerator-digits", 1)) + "/" + "?".repeat(count(part, "min-denominator-digits", 1))
				case "currency-symbol":
					out += literal(part.text())
				case "year":
					out += long ?? ("yyyy", "yy")
				case "month":
					if at(part, "textual", numberNS) == "true" {
						out += long ?? ("mmmm", "mmm")
					} else {
						out += long ?? ("mm", "m")
					}
				case "day":
					out += long ?? ("dd", "d")
				case "day-of-week":
					out += long ?? ("dddd", "ddd")
				case "hours":
					out += elapsed ?? ("[h]", long ?? ("hh", "h"))
				case "minutes":
					out += long ?? ("mm", "m")
				case "seconds":
					out += long ?? ("ss", "s")
					let places = count(part, "decimal-places")
					out += "." + "0".repeat(places) when places > 0
				case "am-pm":
					out += "AM/PM"
				case "text-content":
					out += "@"
				case "boolean":
					out += ""
				default:
			}
		}
		// The general number: one integer digit, no decimals, nothing else.
		return "" when out == "0" && node.localName == "number-style" && count(firstNumber(node), "decimal-places", -1) < 0
		return out
	}

	def firstNumber(node XMLNode) XMLNode {
		let found = node.child("number")
		return found is none ?? (node, found)
	}

	// Writes the ODF data style of a format code under the name. Only the
	// first section of the code is expressed; a code for texts or one
	// without digit places and date parts writes a number style of its
	// literals.
	def writeDataStyle(w XMLWriter, name string, code string) {
		let toks = tokens(sections(code)[0])
		if isDateFormat(code) {
			let hasDate = false
			let elapsed = false
			for let (_, t) in toks {
				hasDate = true when t.kind == 'd' && (t.text.startsWith("y") || t.text.startsWith("d"))
				elapsed = true when t.kind == 'e'
			}
			// A lone month token is a month; next to hours or seconds, minutes.
			let kinds string[] = []
			for let (i, t) in toks {
				let kind = ""
				if t.kind == 'e' {
					kind = t.text.startsWith("h") ?? ("hours", t.text.startsWith("m") ?? ("minutes", "seconds"))
				} else if t.kind == 'd' {
					let lead = t.text[0]
					kind = lead == 'y' ?? ("year", lead == 'd' ?? (t.text.len() > 2 ?? ("day-of-week", "day"), lead == 'h' ?? ("hours", lead == 's' ?? ("seconds", "month"))))
				}
				kinds.push(kind)
			}
			for let (i, kind) in kinds {
				continue unless kind == "month"
				let before = ""
				for let k = i - 1; k >= 0 && before == ""; k-- {
					before = kinds[k]
				}
				let after = ""
				for let k = i + 1; k < kinds.len() && after == ""; k++ {
					after = kinds[k]
				}
				kinds[i] = "minutes" when before == "hours" || after == "seconds"
			}
			for let (_, kind) in kinds {
				hasDate = true when kind == "month"
			}
			w.start(hasDate ?? ("number:date-style", "number:time-style"))
			w.attribute("style:name", name)
			w.attribute("number:truncate-on-overflow", "false") when elapsed
			for let (i, t) in toks {
				let kind = kinds[i]
				if kind == "" {
					if t.kind == 'a' {
						w.start("number:am-pm")
						w.end()
					} else if t.kind == 'l' || t.kind == '/' || t.kind == ',' || t.kind == '.' {
						w.element("number:text", t.kind == 'l' ?? (t.text, string([byte(t.kind)])))
					}
					continue
				}
				w.start("number:" + kind)
				let length = t.kind == 'e' ?? (2, t.text.len())
				if kind == "month" {
					w.attribute("number:style", "long") when length == 2 || length == 4
					w.attribute("number:textual", "true") when length >= 3
				} else if kind == "day-of-week" {
					w.attribute("number:style", "long") when length >= 4
				} else if kind == "year" {
					w.attribute("number:style", "long") when length > 2
				} else {
					w.attribute("number:style", "long") when length >= 2
				}
				if kind == "seconds" && i + 1 < toks.len() && toks[i + 1].kind == 'f' {
					w.attribute("number:decimal-places", toks[i + 1].text.len().str())
				}
				w.end()
			}
			w.end()
			return
		}

		let whole = 0
		let places = 0
		let fixed = 0
		let grouping = false
		let percent = false
		let seenPoint = false
		let exponent = ""
		let fraction = false
		let isText = false
		let lastDigit = -1
		let firstDigit = -1
		for let (i, t) in toks {
			if t.kind := '0' || '#' || '?' {
				lastDigit = i
				firstDigit = i when firstDigit < 0
			}
		}
		for let (i, t) in toks {
			if t.kind := '0' || '#' || '?' {
				if seenPoint {
					places++
					fixed = places when t.kind == '0'
				} else {
					whole++ when t.kind == '0'
				}
			} else if t.kind == '.' {
				seenPoint = true
			} else if t.kind == ',' {
				grouping = true when i < lastDigit
			} else if t.kind == '%' {
				percent = true
			} else if t.kind == 'E' {
				exponent = t.text
			} else if t.kind == '/' {
				fraction = true
			} else if t.kind == '@' {
				isText = true
			}
		}
		let element = isText ?? ("number:text-style", percent ?? ("number:percentage-style", "number:number-style"))
		w.start(element)
		w.attribute("style:name", name)
		let wrote = false
		for let (i, t) in toks {
			if t.kind == 'l' {
				w.element("number:text", t.text)
			} else if t.kind == '%' {
				w.element("number:text", "%")
			} else if t.kind == '@' {
				w.start("number:text-content")
				w.end()
			} else if i == firstDigit && !wrote {
				wrote = true
				if fraction && exponent == "" {
					w.start("number:fraction")
					let numerator = 0
					let denominator = 0
					let bar = false
					for let (_, d) in toks {
						bar = true when d.kind == '/'
						continue unless d.kind := '0' || '#' || '?'
						if bar {
							denominator++
						} else {
							numerator++
						}
					}
					// Places before a space belong to the integer part.
					let integer = 0
					let run = 0
					for let (_, d) in toks {
						break when d.kind == '/'
						if d.kind := '0' || '#' || '?' {
							run++
						} else if run > 0 {
							integer = run
							run = 0
						}
					}
					w.attribute("number:min-integer-digits", integer > 0 ?? ("1", "0"))
					w.attribute("number:min-numerator-digits", (numerator - integer).str())
					w.attribute("number:min-denominator-digits", (denominator == 0 ?? (1, denominator)).str())
					w.end()
				} else {
					w.start(exponent == "" ?? ("number:number", "number:scientific-number"))
					w.attribute("number:decimal-places", places.str())
					w.attribute("number:min-decimal-places", fixed.str())
					w.attribute("number:min-integer-digits", whole.str())
					w.attribute("number:grouping", "true") when grouping
					w.attribute("number:min-exponent-digits", (exponent.len() - 1).str()) unless exponent == ""
					w.end()
				}
			}
		}
		w.end()
	}
}
