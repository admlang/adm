internal partial module std.formats.sheets.ods {
	use (
		std.data.encoding::(XMLWriter)
		std.formats.container::(PackageWriter)
		std.formats.sheets::*
		std.formats.sheets.formula::(toOpenFormula)
		std.time
	)

	const mimeOds = "application/vnd.oasis.opendocument.spreadsheet"
	const odsNamespaces = "office urn:oasis:names:tc:opendocument:xmlns:office:1.0|style urn:oasis:names:tc:opendocument:xmlns:style:1.0|text urn:oasis:names:tc:opendocument:xmlns:text:1.0|table urn:oasis:names:tc:opendocument:xmlns:table:1.0|number urn:oasis:names:tc:opendocument:xmlns:datastyle:1.0|fo urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0|info urn:oasis:names:tc:opendocument:xmlns:meta:1.0|dc http://purl.org/dc/elements/1.1/|config urn:oasis:names:tc:opendocument:xmlns:config:1.0|of urn:oasis:names:tc:opendocument:xmlns:of:1.2|calcext urn:org:documentfoundation:names:experimental:calc:xmlns:calcext:1.0"

	// Opens a root element with the ODF namespaces declared.
	def root(w XMLWriter, name string) {
		w.declaration()
		w.start(name)
		for let (_, pair) in odsNamespaces.split("|") {
			let space = pair.indexOf(" ")
			w.attribute("xmlns:" + pair[:space], pair[space + 1:])
		}
		w.attribute("office:version", "1.3")
	}

	// A day number as an ISO date, with the time of day when it has one.
	def isoDate(serial float) string {
		let text = timeOf(serial).str().trimSuffix("Z")
		return text.trimSuffix("T00:00:00")
	}

	// A fraction of a day as an ISO 8601 duration.
	def isoDuration(days float) string {
		let total = (days * 86400000.0).round() / 1000.0
		let hours = (total / 3600.0).floor()
		let minutes = ((total - hours * 3600.0) / 60.0).floor()
		let seconds = total - hours * 3600.0 - minutes * 60.0
		return "PT{int(hours)}H{int(minutes)}M{seconds.str()}S"
	}

	def writeOds(book Workbook) !byte[] {
		let pkg = new PackageWriter()
		try pkg.add("mimetype", mimeOds.bytes(), true)

		let manifest = new XMLWriter()
		manifest.declaration()
		manifest.start("manifest:manifest")
		manifest.attribute("xmlns:manifest", "urn:oasis:names:tc:opendocument:xmlns:manifest:1.0")
		manifest.attribute("manifest:version", "1.3")
		for let (_, pair) in [("/", mimeOds), ("content.xml", "text/xml"), ("styles.xml", "text/xml"), ("meta.xml", "text/xml"), ("settings.xml", "text/xml")] {
			let (path, kind) = pair
			manifest.start("manifest:file-entry")
			manifest.attribute("manifest:full-path", path)
			manifest.attribute("manifest:version", "1.3") when path == "/"
			manifest.attribute("manifest:media-type", kind)
			manifest.end()
		}
		manifest.end()
		try pkg.add("META-INF/manifest.xml", manifest.bytes())

		let info = new XMLWriter()
		root(info, "office:document-meta")
		info.start("office:meta")
		info.element("dc:title", book.title) unless book.title == ""
		info.element("meta:initial-creator", book.author) unless book.author == ""
		info.element("dc:creator", book.author) unless book.author == ""
		info.end()
		info.end()
		try pkg.add("meta.xml", info.bytes())

		let shared = new XMLWriter()
		root(shared, "office:document-styles")
		shared.start("office:styles")
		shared.start("style:style")
		shared.attribute("style:name", "Default")
		shared.attribute("style:family", "table-cell")
		shared.end()
		shared.end()
		shared.end()
		try pkg.add("styles.xml", shared.bytes())

		let sheetList = book.sheets
		sheetList = [new Sheet("Sheet1")] when sheetList.len() == 0

		// Every format and width in use gets an automatic style.
		let formats string[] = []
		let formatIndex = map<string, int>{}
		let widths float[] = []
		let widthIndex = map<string, int>{}
		for let (_, sheet) in sheetList {
			for let (_, position) in sheet.positions() {
				let (row, column) = position
				let format = formatFor(sheet.cell(row, column))
				continue when format == "" || formatIndex.hasKey(format)
				formats.push(format)
				formatIndex[format] = formats.len() - 1
			}
			for let (_, width) in sheet.widths {
				continue when widthIndex.hasKey(width.str())
				widths.push(width)
				widthIndex[width.str()] = widths.len() - 1
			}
		}

		let w = new XMLWriter()
		root(w, "office:document-content")
		w.start("office:automatic-styles")
		for let (i, width) in widths {
			w.start("style:style")
			w.attribute("style:name", "co{i + 1}")
			w.attribute("style:family", "table-column")
			w.start("style:table-column-properties")
			w.attribute("style:column-width", "%.3fcm".format((width * 7.0 + 5.0) / 96.0 * 2.54))
			w.end()
			w.end()
		}
		for let (i, format) in formats {
			writeDataStyle(w, "N{i + 1}", format)
			w.start("style:style")
			w.attribute("style:name", "ce{i + 1}")
			w.attribute("style:family", "table-cell")
			w.attribute("style:parent-style-name", "Default")
			w.attribute("style:data-style-name", "N{i + 1}")
			w.end()
		}
		w.end()
		w.start("office:body")
		w.start("office:spreadsheet")
		for let (_, sheet) in sheetList {
			writeTable(w, sheet, formatIndex, widthIndex)
		}
		if book.names.len() > 0 {
			w.start("table:named-expressions")
			for let (name, formula) in book.names {
				let open = toOpenFormula(formula)
				// One reference, with nothing around it, is a named range.
				let plain = open.startsWith("[") && open.endsWith("]") && open.indexOf("[", 1) < 0
				if plain {
					w.start("table:named-range")
					w.attribute("table:name", name)
					w.attribute("table:base-cell-address", "$" + sheetList[0].name + ".$A$1")
					w.attribute("table:cell-range-address", open[1:open.len() - 1])
				} else {
					w.start("table:named-expression")
					w.attribute("table:name", name)
					w.attribute("table:base-cell-address", "$" + sheetList[0].name + ".$A$1")
					w.attribute("table:expression", "of:=" + open)
				}
				w.end()
			}
			w.end()
		}
		w.end()
		w.end()
		w.end()
		try pkg.add("content.xml", w.bytes())
		try pkg.add("settings.xml", settingsXml(sheetList))
		return pkg.bytes()
	}

	// The format a cell is written with: its own, or the default form of
	// a date.
	def formatFor(cell Cell) string {
		return cell.format unless cell.format == "" && cell.kind == CellKind.Date
		return cell.number == cell.number.floor() ?? ("yyyy-mm-dd", cell.number.abs() < 1.0 ?? ("hh:mm:ss", "yyyy-mm-dd hh:mm:ss"))
	}

	def emptyCells(w XMLWriter, n int) {
		return when n <= 0
		w.start("table:table-cell")
		w.attribute("table:number-columns-repeated", n.str()) when n > 1
		w.end()
	}

	def writeTable(w XMLWriter, sheet Sheet, formatIndex map<string, int>, widthIndex map<string, int>) {
		w.start("table:table")
		w.attribute("table:name", sheet.name)
		let columns = sheet.columns
		for let (column, _) in sheet.widths {
			columns = column + 1 when column >= columns
		}
		columns = 1 when columns == 0
		for let c = 0; c < columns; c++ {
			w.start("table:table-column")
			let width = sheet.widths.get(c)
			w.attribute("table:style-name", "co{widthIndex[width.str()] + 1}") unless width is none
			w.end()
		}
		// The cells a merged area covers beside its first, and the span of
		// each first cell.
		let covered = map<int, bool>{}
		let spans = map<int, Range>{}
		for let (_, m) in sheet.merges {
			spans[m.top * maxColumns + m.left] = m
			for let r = m.top; r <= m.bottom; r++ {
				for let c = m.left; c <= m.right; c++ {
					covered[r * maxColumns + c] = true unless r == m.top && c == m.left
				}
			}
		}
		let openRow = -1
		let nextColumn = 0
		let lastRow = -1
		// Stored cells, and the first cell of each merged area even when
		// nothing was set there.
		let keys int[] = []
		for let (_, position) in sheet.positions() {
			let (row, column) = position
			keys.push(row * maxColumns + column)
		}
		for let (key, _) in spans {
			keys.push(key) when sheet.get(key / maxColumns, key % maxColumns) is none
		}
		keys = keys.sort((a, b) => a < b)
		for let (_, key) in keys {
			let row = key / maxColumns
			let column = key % maxColumns
			let stored = sheet.get(row, column)
			let cell = stored is none ?? (new Cell(), stored)
			continue when cell.kind == CellKind.Empty && cell.formula == "" && !spans.hasKey(key)
			if row != openRow {
				w.end() when openRow >= 0
				let gap = row - lastRow - 1
				if gap > 0 {
					w.start("table:table-row")
					w.attribute("table:number-rows-repeated", gap.str()) when gap > 1
					emptyCells(w, 1)
					w.end()
				}
				w.start("table:table-row")
				openRow = row
				lastRow = row
				nextColumn = 0
			}
			// Cells skipped since the last one: empty, or covered by a merge.
			for nextColumn < column {
				if covered.hasKey(row * maxColumns + nextColumn) {
					w.start("table:covered-table-cell")
					w.end()
					nextColumn++
					continue
				}
				let run = 0
				for nextColumn + run < column && !covered.hasKey(row * maxColumns + nextColumn + run) {
					run++
				}
				emptyCells(w, run)
				nextColumn += run
			}
			w.start(covered.hasKey(key) ?? ("table:covered-table-cell", "table:table-cell"))
			let format = formatFor(cell)
			w.attribute("table:style-name", "ce{formatIndex[format] + 1}") when format != "" && formatIndex.hasKey(format)
			w.attribute("table:formula", "of:=" + toOpenFormula(cell.formula)) unless cell.formula == ""
			let span = spans.get(key)
			if !(span is none) {
				w.attribute("table:number-columns-spanned", (span.right - span.left + 1).str())
				w.attribute("table:number-rows-spanned", (span.bottom - span.top + 1).str())
			}
			match cell.kind {
				case CellKind.Number:
					w.attribute("office:value-type", format.contains("%") ?? ("percentage", "float"))
					w.attribute("office:value", numberOf(cell.number))
				case CellKind.Bool:
					w.attribute("office:value-type", "boolean")
					w.attribute("office:boolean-value", cell.number != 0.0 ?? ("true", "false"))
				case CellKind.Date:
					if cell.number.abs() < 1.0 || format.startsWith("[") {
						w.attribute("office:value-type", "time")
						w.attribute("office:time-value", isoDuration(cell.number))
					} else {
						w.attribute("office:value-type", "date")
						w.attribute("office:date-value", isoDate(cell.number))
					}
				case CellKind.Text:
					w.attribute("office:value-type", "string")
				case CellKind.Error:
					w.attribute("office:value-type", "string")
					w.attribute("calcext:value-type", "error")
				default:
			}
			if cell.kind != CellKind.Empty {
				for let (_, line) in cell.str().split("\n") {
					w.start("text:p")
					writeSpaced(w, line)
					w.end()
				}
			}
			w.end()
			nextColumn = column + 1
		}
		if openRow >= 0 {
			w.end()
		} else {
			w.start("table:table-row")
			emptyCells(w, 1)
			w.end()
		}
		w.end()
	}

	// Text with runs of spaces kept: a second and later space in a row,
	// and one at either end, are `text:s` elements.
	def writeSpaced(w XMLWriter, line string) {
		let b = line.bytes()
		let start = 0
		let i = 0
		for i < b.len() {
			if b[i] != byte(' ') {
				i++
				continue
			}
			let run = i
			for run < b.len() && b[run] == byte(' ') {
				run++
			}
			let keep = i > 0 && run < b.len() ?? (1, 0)
			let extra = run - i - keep
			if extra > 0 {
				w.text(string(b.slice(start, i + keep - start))) when i + keep > start
				w.start("text:s")
				w.attribute("text:c", extra.str()) when extra > 1
				w.end()
				start = run
			}
			i = run
		}
		w.text(string(b.slice(start, b.len() - start))) when b.len() > start
	}

	def numberOf(value float) string {
		let text = value.str()
		return text when parseFloat<float>(text) == value
		return "%.17g".format(value)
	}

	def settingsXml(sheetList Sheet[]) byte[] {
		let w = new XMLWriter()
		root(w, "office:document-settings")
		w.start("office:settings")
		w.start("config:config-item-set")
		w.attribute("config:name", "ooo:view-settings")
		w.start("config:config-item-map-indexed")
		w.attribute("config:name", "Views")
		w.start("config:config-item-map-entry")
		w.start("config:config-item")
		w.attribute("config:name", "ViewId")
		w.attribute("config:type", "string")
		w.text("view1")
		w.end()
		w.start("config:config-item-map-named")
		w.attribute("config:name", "Tables")
		for let (_, sheet) in sheetList {
			continue when sheet.frozenRows == 0 && sheet.frozenColumns == 0
			w.start("config:config-item-map-entry")
			w.attribute("config:name", sheet.name)
			let items = [("HorizontalSplitMode", sheet.frozenColumns > 0 ?? (2, 0)), ("VerticalSplitMode", sheet.frozenRows > 0 ?? (2, 0)), ("HorizontalSplitPosition", sheet.frozenColumns), ("VerticalSplitPosition", sheet.frozenRows), ("PositionRight", sheet.frozenColumns), ("PositionBottom", sheet.frozenRows)]
			for let (_, item) in items {
				let (name, value) = item
				w.start("config:config-item")
				w.attribute("config:name", name)
				w.attribute("config:type", name.endsWith("Mode") ?? ("short", "int"))
				w.text(value.str())
				w.end()
			}
			w.end()
		}
		w.end()
		w.end()
		w.end()
		w.end()
		w.end()
		w.end()
		return w.bytes()
	}
}
