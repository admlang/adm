partial module std.formats.sheets {
	use (
		std.bytes
		std.formats
		std.io
		std.os
		std.reflection
		std.time
		std.formats.sheets.formula::(calculateBook, evaluateFormula)
		std.formats.sheets.numfmt::(formatNumber)
	)

	// CellKind is what a cell holds.
	enum CellKind {
		Empty,
		Text,
		Number,
		Bool,
		// A date, a time of day or both.
		Date,
		// A formula error such as `#DIV/0!`.
		Error
	}

	// Cell is one cell of a sheet: a typed value, the formula that gives it
	// when there is one, and the number format it is shown in.
	//
	// ```
	// let cell = sheet.cell(0, 1)
	// cell.set(19.5)
	// cell.format = "0.00"
	// println(cell.str()) // 19.50
	// ```
	type Cell {
		kind    CellKind = CellKind.Empty
		// The text of a Text cell, the code of an Error cell (`#N/A`).
		text    string   = ""
		// The value of a Number cell; 1 or 0 for a Bool; for a Date the
		// days since 1899-12-30 with the time of day as the fraction, as
		// spreadsheets count them.
		number  float    = 0.0
		// The formula without its leading `=`, empty for none. The value
		// fields hold its last result.
		formula string   = ""
		// The number format code (`0.00`, `#,##0`, `0%`, `yyyy-mm-dd`),
		// empty for the general format.
		format  string   = ""

		def new() {}

		def new(text string) {
			set(text)
		}

		def new(number float) {
			set(number)
		}

		def new(value bool) {
			set(value)
		}

		def new(value time.Time) {
			set(value)
		}

		// Makes the cell a text.
		def set(text string) Cell {
			kind = CellKind.Text
			self.text = text
			number = 0.0
			return self
		}

		// Makes the cell a number.
		def set(number float) Cell {
			kind = CellKind.Number
			self.number = number
			text = ""
			return self
		}

		// Makes the cell a number.
		def set(number int) Cell {
			return set(float(number))
		}

		// Makes the cell a bool.
		def set(value bool) Cell {
			kind = CellKind.Bool
			number = value ?? (1.0, 0.0)
			text = ""
			return self
		}

		// Sets a date and time, taken in UTC.
		def set(value time.Time) Cell {
			kind = CellKind.Date
			number = serialOf(value)
			text = ""
			return self
		}

		// Makes the cell an error with the code (`#VALUE!`).
		def setError(code string) Cell {
			kind = CellKind.Error
			text = code
			number = 0.0
			return self
		}

		// Empties the value; the formula and the format stay.
		def clear() Cell {
			kind = CellKind.Empty
			text = ""
			number = 0.0
			return self
		}

		// The value of a Bool cell; for the other kinds, whether a number
		// is not zero or a text is not empty.
		def bool() bool {
			return text != "" when kind == CellKind.Text
			return number != 0.0
		}

		// The instant of a Date cell (UTC); a Number cell is read as a day
		// count, any other kind gives 1899-12-30.
		def time() time.Time {
			return timeOf(number)
		}

		// The cell as shown: a text as it is, a number, bool or date in the
		// cell's format, an error as its code, empty as "".
		def str() string {
			match kind {
				case CellKind.Empty:
					return ""
				case CellKind.Text, CellKind.Error:
					return text
				case CellKind.Bool:
					return number != 0.0 ?? ("TRUE", "FALSE")
				default:
					return formatNumber(number, format, kind == CellKind.Date)
			}
		}
	}

	// Range is a rectangle of cells, rows and columns from 0, both ends
	// included.
	struct Range {
		top    int
		left   int
		bottom int
		right  int
	}

	// The most columns a sheet has, as XLSX and ODS files allow.
	const maxColumns = 16384

	// Sheet is one sheet of a workbook: a grid of cells addressed by row and
	// column from 0, or by a reference such as `B2`. Only cells that were
	// set are stored.
	type Sheet {
		name string

		// Merged cell areas; the top left cell of each holds the value.
		merges Range[] = []

		// Column widths in characters of the default font, by column; a
		// column without an entry has the default width.
		widths map<int, float>

		// Rows and columns that stay in place when the sheet scrolls.
		frozenRows    int = 0
		frozenColumns int = 0

		internal cells  map<int, Cell>
		internal height int            = 0
		internal width  int            = 0

		def new(name string) {
			self.name = name
			widths = map<int, float>{}
			cells = map<int, Cell>{}
		}

		// The number of rows up to the last cell that was set.
		rows int {
			def get() int {
				return height
			}
		}

		// The number of columns up to the last cell that was set.
		columns int {
			def get() int {
				return width
			}
		}

		// The cell at the row and column, added empty when the sheet has
		// none there. Negative positions and columns past 16384 give a
		// cell that is not part of the sheet.
		def cell(row int, column int) Cell {
			return new Cell() when row < 0 || column < 0 || column >= maxColumns
			let key = row * maxColumns + column
			let found = cells.get(key)
			return found unless found is none
			let made = new Cell()
			cells[key] = made
			height = row + 1 when row >= height
			width = column + 1 when column >= width
			return made
		}

		// The cell at a reference (`B2`, `$B$2`), added empty when absent.
		// Fails when the text is not a cell reference.
		def cell(reference string) !Cell {
			let (row, column) = try parseReference(reference)
			return cell(row, column)
		}

		// The cell at the row and column, none when it was never set.
		def get(row int, column int) ?Cell {
			return none when row < 0 || column < 0 || column >= maxColumns
			return cells.get(row * maxColumns + column)
		}

		// Sets the cell at the row and column to a text and returns it.
		def set(row int, column int, text string) Cell {
			return cell(row, column).set(text)
		}

		// Sets the cell at the row and column to a number and returns it.
		def set(row int, column int, number float) Cell {
			return cell(row, column).set(number)
		}

		// Sets the cell at the row and column to a number and returns it.
		def set(row int, column int, number int) Cell {
			return cell(row, column).set(number)
		}

		// Sets the cell at the row and column to a bool and returns it.
		def set(row int, column int, value bool) Cell {
			return cell(row, column).set(value)
		}

		// Sets the cell at the row and column to a date and time (UTC) and
		// returns it.
		def set(row int, column int, value time.Time) Cell {
			return cell(row, column).set(value)
		}

		// Gives the cell a formula (with or without the leading `=`); its
		// value stays what it was until the workbook is calculated.
		def setFormula(row int, column int, formula string) Cell {
			let target = cell(row, column)
			target.formula = formula.trimPrefix("=")
			return target
		}

		// Removes the cell; the sheet's extent does not shrink.
		def remove(row int, column int) {
			return when row < 0 || column < 0 || column >= maxColumns
			cells.delete(row * maxColumns + column)
		}

		// Adds a row of texts below the last row.
		def append(values string[]) {
			let row = height
			for let (column, value) in values {
				cell(row, column).set(value)
			}
			height = row + 1 when values.len() == 0
		}

		// The sheet as shown: `rows` arrays of `columns` texts, each cell's
		// `str()`, "" where no cell was set.
		def values() string[][] {
			let out string[][] = []
			for let r = 0; r < height; r++ {
				let line string[] = []
				for let c = 0; c < width; c++ {
					let found = cells.get(r * maxColumns + c)
					line.push(found is none ?? ("", found.str()))
				}
				out.push(line)
			}
			return out
		}

		// The row and column of every cell that was set, in reading order.
		def positions() (int, int)[] {
			let out (int, int)[] = []
			for let (_, key) in cells.keys().sort((a, b) => a < b) {
				out.push((key / maxColumns, key % maxColumns))
			}
			return out
		}
	}

	// Workbook is a spreadsheet file as data: its sheets in tab order.
	//
	// ```
	// let book = new Workbook()
	// let sheet = book.add("Prices")
	// sheet.set(0, 0, "Item")
	// sheet.set(0, 1, "Price")
	// sheet.set(1, 0, "Tea")
	// sheet.set(1, 1, 3.5).format = "0.00"
	// try sheets.save(book, "prices.xlsx")
	// ```
	type Workbook {
		sheets Sheet[] = []

		title  string = ""
		author string = ""

		// Defined names: a name to the formula text it stands for, usually
		// a reference (`Rates` to `Prices!$B$2:$B$9`).
		names map<string, string>

		def new() {
			names = map<string, string>{}
		}

		// The sheet of that name (case ignored), none when there is none.
		def sheet(name string) ?Sheet {
			let wanted = name.lower()
			for let (_, s) in sheets {
				return s when s.name.lower() == wanted
			}
			return none
		}

		// The sheet of that name, added after the last one when absent.
		def add(name string) Sheet {
			let found = sheet(name)
			return found unless found is none
			let made = new Sheet(name)
			sheets.push(made)
			return made
		}

		// calculate evaluates every formula and stores each result in its
		// cell (`kind`, `text`, `number`), following references across
		// sheets and defined names. A formula that cannot be read gives
		// `#NAME?`, as an unknown function does; one that depends on
		// itself gives `#REF!`. A result in a cell with a date format is a
		// Date.
		def calculate() {
			calculateBook(self)
		}

		// evaluate returns the value of a formula (with or without `=`)
		// read as if it stood in cell A1 of the named sheet, the first
		// sheet when no name is given. Cells it refers to are calculated
		// as `calculate` does.
		def evaluate(formula string, sheet string = "") Cell {
			let index = sheets.len() == 0 ?? (-1, 0)
			if sheet != "" {
				index = -1
				for let (i, s) in sheets {
					index = i when s.name.lower() == sheet.lower()
				}
			}
			return evaluateFormula(self, index, formula)
		}

		// Removes the sheet; reports whether there was one.
		def remove(name string) bool {
			let wanted = name.lower()
			let kept Sheet[] = []
			for let (_, s) in sheets {
				kept.push(s) unless s.name.lower() == wanted
			}
			let removed = kept.len() != sheets.len()
			sheets = kept
			return removed
		}
	}

	// reference writes a cell position as text: (1, 1) is `B2`.
	def reference(row int, column int) string {
		return columnName(column) + (row + 1).str()
	}

	// reference writes a range as text: `A1:C3`, or one cell's reference
	// when the range is a single cell.
	def reference(range Range) string {
		let first = reference(range.top, range.left)
		return first when range.top == range.bottom && range.left == range.right
		return first + ":" + reference(range.bottom, range.right)
	}

	// columnName gives the letters of a column: 0 is `A`, 26 is `AA`.
	def columnName(column int) string {
		let out byte[] = []
		let n = column + 1
		for n > 0 {
			let digit = (n - 1) % 26
			out.push(byte(65 + digit))
			n = (n - 1) / 26
		}
		return string(out.reverse())
	}

	// parseReference reads a cell reference (`B2`, `b2`, `$B$2`) as its row
	// and column from 0.
	// Fails when the text is not letters followed by a row number, or the
	// position is outside a sheet.
	def parseReference(text string) !(int, int) {
		let b = text.trim().bytes()
		let i = 0
		let column = 0
		let letters = 0
		i++ when i < b.len() && b[i] == byte('$')
		for i < b.len() {
			let c = int(b[i]) | 32
			break unless c >= 97 && c <= 122
			column = column * 26 + (c - 96)
			letters++
			i++
		}
		i++ when i < b.len() && b[i] == byte('$')
		let row = 0
		let digits = 0
		for i < b.len() && b[i] >= byte('0') && b[i] <= byte('9') && digits < 9 {
			row = row * 10 + int(b[i]) - 48
			digits++
			i++
		}
		fail "sheets: `{text}` is not a cell reference" unless letters > 0 && letters <= 3 && digits > 0 && i == b.len() && row > 0 && column <= maxColumns
		return (row - 1, column - 1)
	}

	// parseRange reads `A1:C3`, or a single reference as a range of one
	// cell; the corners may come in any order.
	// Fails when a part is not a cell reference.
	def parseRange(text string) !Range {
		let colon = text.indexOf(":")
		if colon < 0 {
			let (row, column) = try parseReference(text)
			return Range{top: row, left: column, bottom: row, right: column}
		}
		let (r1, c1) = try parseReference(text[:colon])
		let (r2, c2) = try parseReference(text[colon + 1:])
		return Range{top: r1 < r2 ?? (r1, r2), left: c1 < c2 ?? (c1, c2), bottom: r1 < r2 ?? (r2, r1), right: c1 < c2 ?? (c2, c1)}
	}

	// The spreadsheet day number of an instant: days since 1899-12-30, the
	// time of day as the fraction.
	def serialOf(value time.Time) float {
		return float(value.unixNs() / 1000000) / 86400000.0 + 25569.0
	}

	// The instant of a spreadsheet day number, to the millisecond.
	def timeOf(serial float) time.Time {
		let ms = ((serial - 25569.0) * 86400000.0).round()
		return time.fromUnixNs(int64(ms) * 1000000)
	}

	// WorkbookDecoder reads a workbook from a reader.
	interface WorkbookDecoder {
		// decode reads the whole reader.
		// Fails when the content is not valid for the format, or the reader
		// fails.
		def decode(reader io.Reader) !Workbook
	}

	// WorkbookEncoder writes a workbook to a writer.
	interface WorkbookEncoder {
		// encode writes the workbook in the codec's format; what the format
		// cannot hold is left out.
		// Fails when the writer does.
		def encode(book Workbook, writer io.Writer) !none
	}

	// WorkbookCodec is what a spreadsheet format registers.
	type WorkbookCodec = WorkbookDecoder & WorkbookEncoder & formats.FileFormat

	// codec registers a type as the workbook codec of the named format.
	meta def codec<WorkbookCodec>(ctx reflection.DiscoveryMetaContext<reflection.TypeMetaContext>, name string) {}

	internal let codecRegistry = new formats.CodecRegistry<WorkbookCodec>("workbook", codec)

	// load reads the workbook in the file: the codec is found by the file's
	// signature, then by its extension (CSV has no signature).
	// Fails when the file cannot be read, no codec claims it, or decoding
	// does.
	def load(path string) !Workbook {
		let data = try os.readFile(path)
		let found = sniff(data) onerror recover none
		if found is none {
			let byExtension = codecRegistry.matchExt(os.extension(path))
			fail "no workbook codec reads \"{path}\"" when byExtension is none
			return byExtension.decode(new bytes.Reader(data))
		}
		let (dec, body) = found
		return dec.decode(body)
	}

	// The codec whose signature the data carries, with a reader over it.
	internal def sniff(data byte[]) !?(WorkbookCodec, io.Reader) {
		return try codecRegistry.probe(data)
	}

	// load reads a workbook from the bytes, the codec found by signature.
	// Fails when no codec claims the data, or decoding does.
	def load(data byte[]) !Workbook {
		let (dec, r) = try codecRegistry.probe(data)
		return dec.decode(r)
	}

	// load reads a workbook from the reader, the codec found by signature.
	// Fails when no codec claims the data, or decoding does.
	def load(reader io.Reader) !Workbook {
		let (dec, r) = try codecRegistry.probe(reader)
		return dec.decode(r)
	}

	// load reads a workbook from the reader with the codec registered for
	// the file extension (".csv"), for formats that have no signature.
	// Fails when no codec has the extension, or decoding does.
	def load(reader io.Reader, extension string) !Workbook {
		let dec = codecRegistry.matchExt(extension)
		fail "no workbook codec has the extension \"{extension}\"" when dec is none
		return dec.decode(reader)
	}

	// save writes the workbook to the file in the format its extension
	// names.
	// Fails when no codec has the extension, or the file cannot be written.
	def save(book Workbook, path string) !none {
		let enc = codecRegistry.matchExt(os.extension(path))
		fail "no workbook codec has the extension \"{os.extension(path)}\"" when enc is none
		let out = new bytes.Buffer()
		try enc.encode(book, out)
		return os.writeFile(path, out.bytes())
	}
}
