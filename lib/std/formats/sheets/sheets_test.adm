partial module std.formats.sheets {
	use (
		std.bytes
		std.formats.docs::(Alignment)
		std.formats.sheets.formula::(fromOpenFormula, shiftFormula, toOpenFormula)
		std.formats.sheets.numfmt::(formatNumber)
		std.os
		std.testing
		std.time
	)

	check "Sheets" {
		@test()
		def TestReferences() !none {
			assert reference(0, 0) == "A1" && reference(1, 1) == "B2" && reference(9, 25) == "Z10" && reference(0, 26) == "AA1"
			assert reference(0, 701) == "ZZ1" && reference(0, 702) == "AAA1" && reference(1048575, 16383) == "XFD1048576"
			let (row, column) = try parseReference("$xfd$1048576")
			assert row == 1048575 && column == 16383
			let (r2, c2) = try parseReference(" b2 ")
			assert r2 == 1 && c2 == 1
			let range = try parseRange("C3:A1")
			assert range.top == 0 && range.left == 0 && range.bottom == 2 && range.right == 2 && reference(range) == "A1:C3"
			assert reference(try parseRange("D4")) == "D4"
			let bad = 0
			for let (_, text) in ["", "A", "1", "A0", "XFE1", "A1B", "A-1", "ABCD1"] {
				parseReference(text) onerror (err error) {
					bad++
					recover (0, 0)
				}
			}
			assert bad == 8
		}

		@test()
		def TestModel() !none {
			let book = new Workbook()
			let sheet = book.add("Prices")
			assert book.add("prices").name == "Prices" && book.sheets.len() == 1
			sheet.set(0, 0, "Item")
			sheet.set(1, 0, "Tea")
			sheet.set(1, 1, 3.5).format = "0.00"
			sheet.set(2, 1, 4)
			sheet.set(2, 2, true)
			(try sheet.cell("D4")).set("corner")
			sheet.setFormula(3, 1, "=SUM(B2:B3)")
			assert sheet.rows == 4 && sheet.columns == 4
			assert sheet.get(0, 3) is none && sheet.get(-1, 0) is none
			let values = sheet.values()
			assert values.len() == 4 && values[1].join("|") == "Tea|3.50||" && values[2].join("|") == "|4|TRUE|" && values[3].join("|") == "|||corner"
			assert sheet.cell(3, 1).formula == "SUM(B2:B3)" && sheet.cell(3, 1).kind == CellKind.Empty
			assert sheet.positions().len() == 7
			sheet.remove(3, 3)
			assert sheet.get(3, 3) is none && sheet.columns == 4
			sheet.append(["a", "b"])
			assert sheet.rows == 5 && sheet.cell(4, 1).text == "b"
			let stamp = try time.parse("2026-03-01T14:30:00Z")
			let cell = new Cell(stamp)
			assert cell.kind == CellKind.Date && cell.str() == "2026-03-01 14:30:00" && cell.time().unixNs() == stamp.unixNs()
			assert new Cell(false).str() == "FALSE" && new Cell().str() == "" && new Cell("x").setError("#N/A").str() == "#N/A"
			assert book.remove("PRICES") && !book.remove("Prices") && book.sheet("Prices") is none
		}

		@test()
		def TestNumberFormats() {
			assert formatNumber(1234.5, "", false) == "1234.5" && formatNumber(0.1 + 0.2, "", false) == "0.3" && formatNumber(-2.0, "", false) == "-2"
			assert formatNumber(1e20, "", false) == "1E+20" && formatNumber(123456789012.0, "General", false) == "123456789012"
			assert formatNumber(1234.567, "0", false) == "1235" && formatNumber(1234.567, "0.00", false) == "1234.57"
			assert formatNumber(1234567.891, "#,##0", false) == "1,234,568" && formatNumber(-1234.5, "#,##0.00", false) == "-1,234.50"
			assert formatNumber(0.256, "0%", false) == "26%" && formatNumber(0.2567, "0.00%", false) == "25.67%"
			assert formatNumber(0.5, "#.##", false) == ".5" && formatNumber(3.0, "0.0#", false) == "3.0" && formatNumber(3.14159, "0.0#", false) == "3.14"
			assert formatNumber(7.0, "000", false) == "007" && formatNumber(12345.678, "0.00E+00", false) == "1.23E+04" && formatNumber(0.00012, "0.0E+0", false) == "1.2E-4"
			assert formatNumber(1234567.0, "0.0,,\"M\"", false) == "1.2M" && formatNumber(5.0, "\"$\"#,##0.00", false) == "$5.00"
			assert formatNumber(-5.0, "#,##0.00;(#,##0.00)", false) == "(5.00)" && formatNumber(0.0, "0;-0;\"zero\"", false) == "zero"
			assert formatNumber(-5.0, "0.0;[Red]-0.0", false) == "-5.0" && formatNumber(12.5, "[$€-407] 0.00", false) == "€ 12.50"
			assert formatNumber(2.5, "# ?/?", false) == "2 1/2" && formatNumber(0.75, "?/?", false) == "3/4" && formatNumber(1.3125, "# ??/16", false) == "1 5/16"
			// 2026-03-01 14:05:09.250, a Sunday.
			let serial = 46082.0 + (14.0 * 3600.0 + 5.0 * 60.0 + 9.25) / 86400.0
			assert formatNumber(serial, "yyyy-mm-dd", true) == "2026-03-01" && formatNumber(serial, "d/m/yy", true) == "1/3/26"
			assert formatNumber(serial, "dddd, mmmm d, yyyy", true) == "Sunday, March 1, 2026" && formatNumber(serial, "ddd d mmm", true) == "Sun 1 Mar"
			assert formatNumber(serial, "hh:mm:ss", true) == "14:05:09" && formatNumber(serial, "h:mm AM/PM", true) == "2:05 PM"
			assert formatNumber(serial, "mm/dd/yyyy hh:mm", true) == "03/01/2026 14:05" && formatNumber(serial, "mm:ss.000", true) == "05:09.250"
			assert formatNumber(1.5, "[h]:mm:ss", true) == "36:00:00" && formatNumber(serial, "", true) == "2026-03-01 14:05:09"
			assert formatNumber(46082.0, "", true) == "2026-03-01" && formatNumber(0.25, "", true) == "06:00:00"
			assert formatNumber(serial, "\"on\" yyyy\\-mm", true) == "on 2026-03"
		}

		@test()
		def TestShiftFormula() {
			assert shiftFormula("A1+B2", 1, 1) == "B2+C3"
			assert shiftFormula("SUM($A$1:A10)*LOG10(B1)+Sheet2!C$3", 2, 1) == "SUM($A$1:B12)*LOG10(C3)+Sheet2!D$3"
			assert shiftFormula("\"A1\"&'My A1'!A1&A1B+1E3+x.A1", 1, 0) == "\"A1\"&'My A1'!A2&A1B+1E3+x.A1"
			assert shiftFormula("A1+$B1", -1, -1) == "#REF!+#REF!"
			assert shiftFormula("A1", 0, 0) == "A1"
		}

		@test()
		def TestCsv() !none {
			let book = try new Csv().decode("name;price;when;ok;note\r\nTea;3,5;2026-03-01;true;\"a;b\"\r\nMilk;1.25;2026-03-01T08:30;FALSE;007\r\n")
			let sheet = book.sheets[0]
			assert sheet.name == "Sheet1" && sheet.rows == 3 && sheet.columns == 5
			assert sheet.cell(1, 1).kind == CellKind.Text && sheet.cell(2, 1).kind == CellKind.Number && sheet.cell(2, 1).number == 1.25
			assert sheet.cell(1, 2).kind == CellKind.Date && sheet.cell(1, 2).str() == "2026-03-01" && sheet.cell(2, 2).str() == "2026-03-01 08:30:00"
			assert sheet.cell(1, 3).kind == CellKind.Bool && sheet.cell(1, 3).bool() && !sheet.cell(2, 3).bool()
			assert sheet.cell(1, 4).text == "a;b" && sheet.cell(2, 4).number == 7.0
			let codec = new Csv()
			codec.infer = false
			codec.separator = ";"
			let plain = try codec.decode("1;2\n")
			assert plain.sheets[0].cell(0, 0).kind == CellKind.Text
			assert codec.encode(plain) == "1;2\r\n"
			assert new Csv().encode(book) == "name,price,when,ok,note\r\nTea,\"3,5\",2026-03-01,TRUE,a;b\r\nMilk,1.25,2026-03-01 08:30:00,FALSE,7\r\n"
			let loaded = try load(new bytes.Reader("a,b\n1,2\n".bytes()), ".csv")
			assert loaded.sheets[0].cell(1, 1).number == 2.0
		}

		def sample() Workbook {
			let book = new Workbook()
			book.title = "Prices & <more>"
			book.author = "Ada"
			let sheet = book.add("Prices")
			sheet.set(0, 0, "Item")
			sheet.set(0, 1, " padded ")
			sheet.set(1, 0, "Tea")
			sheet.set(1, 1, 3.5).format = "0.00"
			sheet.set(2, 0, "Milk")
			sheet.set(2, 1, 0.1 + 0.2)
			sheet.setFormula(3, 1, "SUM(B2:B3)").set(3.8).format = "#,##0.00"
			sheet.setFormula(3, 2, "B2>1").set(true)
			sheet.setFormula(3, 3, "A2&\"!\"").set("Tea!")
			sheet.setFormula(3, 4, "1/0").setError("#DIV/0!")
			sheet.set(4, 0, time.fromUnixNs(1772375400 * 1000000000))
			sheet.set(5, 0, time.fromUnixNs(1772323200 * 1000000000)).format = "dd/mm/yyyy"
			sheet.set(6, 0, -12345678.9012345)
			sheet.set(7, 5, "far")
			sheet.merges.push(Range{top: 0, left: 2, bottom: 0, right: 4})
			sheet.widths[0] = 24.5
			sheet.frozenRows = 1
			sheet.frozenColumns = 2
			let other = book.add("Second sheet")
			other.set(0, 0, "Tea")
			other.setFormula(0, 1, "Prices!B2*2").set(7)
			book.names["Rates"] = "Prices!$B$2:$B$3"
			return book
		}

		def checkSample(back Workbook) {
			assert back.title == "Prices & <more>" && back.author == "Ada"
			assert back.sheets.len() == 2 && back.sheets[0].name == "Prices" && back.sheets[1].name == "Second sheet"
			let sheet = back.sheets[0]
			assert sheet.rows == 8 && sheet.columns == 6
			assert sheet.cell(0, 1).text == " padded " && sheet.cell(1, 1).number == 3.5 && sheet.cell(1, 1).format == "0.00" && sheet.cell(1, 1).str() == "3.50"
			assert sheet.cell(2, 1).number == 0.1 + 0.2
			let total = sheet.cell(3, 1)
			assert total.formula == "SUM(B2:B3)" && total.number == 3.8 && total.str() == "3.80"
			assert sheet.cell(3, 2).kind == CellKind.Bool && sheet.cell(3, 2).bool() && sheet.cell(3, 2).formula == "B2>1"
			assert sheet.cell(3, 3).kind == CellKind.Text && sheet.cell(3, 3).text == "Tea!" && sheet.cell(3, 3).formula == "A2&\"!\""
			assert sheet.cell(3, 4).kind == CellKind.Error && sheet.cell(3, 4).text == "#DIV/0!"
			assert sheet.cell(4, 0).kind == CellKind.Date && sheet.cell(4, 0).time().unixNs() == 1772375400 * 1000000000 && sheet.cell(4, 0).str() == "2026-03-01 14:30:00"
			assert sheet.cell(5, 0).kind == CellKind.Date && sheet.cell(5, 0).str() == "01/03/2026"
			assert sheet.cell(6, 0).number == -12345678.9012345 && sheet.cell(7, 5).text == "far"
			assert sheet.merges.len() == 1 && reference(sheet.merges[0]) == "C1:E1"
			assert sheet.widths.len() == 1 && sheet.widths[0] == 24.5 && sheet.frozenRows == 1 && sheet.frozenColumns == 2
			assert back.sheets[1].cell(0, 1).formula == "Prices!B2*2" && back.sheets[1].cell(0, 1).number == 7.0
			assert back.names.len() == 1 && back.names["Rates"] == "Prices!$B$2:$B$3"
		}

		@test()
		def TestXlsx() !none {
			let data = try new Xlsx().encode(sample())
			checkSample(try new Xlsx().decode(data))
			checkSample(try load(data))
			let path = "/tmp/adm-sheets-{time.now().unixNs()}.xlsx"
			defer os.remove(path)
			try save(sample(), path)
			checkSample(try load(path))
			let blank = try new Xlsx().decode(try new Xlsx().encode(new Workbook()))
			assert blank.sheets.len() == 1 && blank.sheets[0].rows == 0
			let failed = false
			new Xlsx().decode("not a zip".bytes()) onerror (err error) {
				failed = true
				recover new Workbook()
			}
			assert failed
		}

		@test()
		def TestOpenFormula() {
			let pairs = [("SUM(B2:B3)", "SUM([.B2:.B3])"), ("Prices!B2*2", "[$Prices.B2]*2"), ("IF(A1>0,\"a,b\",'My sheet'!$C$3)", "IF([.A1]>0;\"a,b\";[$'My sheet'.$C$3])"), ("SUM(Data!A1:B2,LOG10(C1),x.y)", "SUM([$Data.A1:.B2];LOG10([.C1]);x.y)"), ("1+2", "1+2"), ("IFS(A1>0,\{1,2;3,4\},TRUE,TEXTJOIN(\"-\",1,B1))", "COM.MICROSOFT.IFS([.A1]>0;\{1;2|3;4\};TRUE;COM.MICROSOFT.TEXTJOIN(\"-\";1;[.B1]))")]
			for let (_, pair) in pairs {
				let (plain, open) = pair
				assert toOpenFormula(plain) == open
				assert fromOpenFormula("of:=" + open) == plain
			}
			assert fromOpenFormula("=[$Data.A1:$Other.B2]") == "Data!A1:Other!B2" && fromOpenFormula("oooc:=[.A1]") == "A1"
		}

		@test()
		def TestOds() !none {
			let data = try new Ods().encode(sample())
			checkSample(try new Ods().decode(data))
			checkSample(try load(data))
			let path = "/tmp/adm-sheets-{time.now().unixNs()}.ods"
			defer os.remove(path)
			try save(sample(), path)
			checkSample(try load(path))
			let blank = try new Ods().decode(try new Ods().encode(new Workbook()))
			assert blank.sheets.len() == 1 && blank.sheets[0].rows == 0

			let book = new Workbook()
			let sheet = book.add("T")
			sheet.set(0, 0, "a  b   c ")
			sheet.set(0, 1, "two\nlines")
			sheet.set(0, 2, 0.25).format = "0.0%"
			sheet.set(0, 3, 0.75).kind = CellKind.Date
			sheet.set(1, 0, 1234.5).format = "#,##0.00"
			sheet.set(1, 1, 12345.0).format = "0.00E+00"
			sheet.set(1, 2, 46082.5).kind = CellKind.Date
			sheet.cell(1, 2).format = "d mmm yyyy h:mm AM/PM"
			sheet.set(1, 3, 1.5).kind = CellKind.Date
			sheet.cell(1, 3).format = "[h]:mm:ss"
			sheet.merges.push(Range{top: 3, left: 0, bottom: 4, right: 1})
			sheet.set(3, 0, "merged")
			sheet.set(4, 3, "after")
			let back = (try new Ods().decode(try new Ods().encode(book))).sheets[0]
			assert back.cell(0, 0).text == "a  b   c " && back.cell(0, 1).text == "two\nlines"
			assert back.cell(0, 2).str() == "25.0%" && back.cell(0, 3).str() == "18:00:00"
			assert back.cell(1, 0).str() == "1,234.50" && back.cell(1, 1).str() == "1.23E+04"
			assert back.cell(1, 2).str() == "1 Mar 2026 12:00 PM" && back.cell(1, 3).str() == "36:00:00"
			assert back.merges.len() == 1 && reference(back.merges[0]) == "A4:B5" && back.cell(4, 3).text == "after"
		}

		// The shown value of a formula on a small fixed workbook.
		def run(book Workbook, formula string) string {
			return book.evaluate(formula).str()
		}

		def numbers() Workbook {
			let book = new Workbook()
			let sheet = book.add("Data")
			let rows = [("Tea", 3.5, 10.0, "hot"), ("Milk", 1.25, 4.0, "cold"), ("Coffee", 4.0, 7.0, "hot"), ("Water", 0.5, 20.0, "cold")]
			sheet.append(["Item", "Price", "Stock", "Kind"])
			for let (i, row) in rows {
				let (item, price, stock, kind) = row
				sheet.set(i + 1, 0, item)
				sheet.set(i + 1, 1, price)
				sheet.set(i + 1, 2, stock)
				sheet.set(i + 1, 3, kind)
			}
			sheet.set(5, 0, true)
			sheet.set(5, 1, "12")
			sheet.cell(5, 2).setError("#N/A")
			let other = book.add("Other sheet")
			other.set(0, 0, 100)
			book.names["Prices"] = "Data!$B$2:$B$5"
			book.names["Rate"] = "0.2"
			return book
		}

		@test()
		def TestFormulaOperators() !none {
			let book = numbers()
			let cases = [("1+2*3", "7"), ("(1+2)*3", "9"), ("-2^2", "4"), ("2^3^2", "64"), ("10%", "0.1"), ("50%*200", "100"), ("1/4", "0.25"), ("1/0", "#DIV/0!"), ("\"a\"&1&TRUE", "a1TRUE"), ("\"say \"\"hi\"\"\"", "say \"hi\""), ("1=1", "TRUE"), ("\"a\"=\"A\"", "TRUE"), ("\"b\">\"a\"", "TRUE"), ("2>10", "FALSE"), ("\"2\">10", "TRUE"), ("TRUE>\"z\"", "TRUE"), ("1<>2", "TRUE"), ("3<=3", "TRUE"), ("\"3\"+4", "7"), ("\"x\"+1", "#VALUE!"), ("1.5e2+.5", "150.5"), ("B2+C2", "13.5"), ("Data!B2*2", "7"), ("'Other sheet'!A1/4", "25"), ("$B$3+B3", "2.5"), ("Z99+1", "1"), ("Z99&\"x\"", "x"), ("Nope!A1", "#REF!"), ("Rate*10", "2"), ("SUM(Prices)", "9.25"), ("Unknown1", "#NAME?"), ("1+", "#NAME?"), ("FOO(1)", "#NAME?"), ("#N/A", "#N/A"), ("C6+1", "#N/A"), ("\{1,2;3,4\}", "1"), ("SUM(\{1,2;3,4\})", "10"), ("- 3 + + 4", "1")]
			for let (_, pair) in cases {
				let (formula, want) = pair
				let got = run(book, formula)
				assert got == want onerror fail "{formula} gave {got}, want {want}"
			}
			return none
		}

		@test()
		def TestFormulaFunctions() !none {
			let book = numbers()
			let cases = [("SUM(B2:B5)", "9.25"), ("SUM(B2:B5,C2,10)", "29.25"), ("SUM(B:B)", "9.25"), ("SUM(2:2)", "13.5"), ("SUM(A1:D5)", "50.25"), ("SUM(\"3\",TRUE)", "4"), ("SUM(C6)", "#N/A"), ("AVERAGE(C2:C5)", "10.25"), ("AVERAGE(A2:A5)", "#DIV/0!"), ("MIN(B2:B5)", "0.5"), ("MAX(B2:C5)", "20"), ("COUNT(A1:D6)", "8"), ("COUNTA(A1:D6)", "23"), ("COUNTBLANK(A1:E6)", "7"), ("PRODUCT(B2:B3)", "4.375"), ("MEDIAN(C2:C5)", "8.5"), ("MEDIAN(1,3,2)", "2"), ("ROUND(STDEV(C2:C5),4)", "6.9462"), ("ROUND(VARP(C2:C5),4)", "36.1875"),
				("ABS(-2)", "2"), ("SQRT(16)", "4"), ("SQRT(-1)", "#NUM!"), ("ROUND(2.5,0)", "3"), ("ROUND(-2.5,0)", "-3"), ("ROUND(1.005,2)", "1.01"), ("ROUND(1234.5,-2)", "1200"), ("ROUNDUP(1.21,1)", "1.3"), ("ROUNDDOWN(-1.29,1)", "-1.2"), ("TRUNC(8.9)", "8"), ("INT(-8.1)", "-9"), ("MOD(7,3)", "1"), ("MOD(-7,3)", "2"), ("MOD(1,0)", "#DIV/0!"), ("QUOTIENT(-7,2)", "-3"), ("POWER(2,10)", "1024"), ("ROUND(EXP(1),5)", "2.71828"), ("ROUND(LN(10),5)", "2.30259"), ("LOG(8,2)", "3"), ("LOG10(1000)", "3"), ("ROUND(PI(),4)", "3.1416"), ("SIGN(-3)", "-1"), ("CEILING(2.1,0.5)", "2.5"), ("FLOOR(2.9,0.5)", "2.5"), ("ROUND(SIN(PI()/2),6)", "1"), ("ROUND(DEGREES(ATAN2(1,1)),6)", "45"),
				("SUMIF(D2:D5,\"hot\",C2:C5)", "17"), ("SUMIF(B2:B5,\">1\")", "8.75"), ("SUMIF(A2:A5,\"*e*\",B2:B5)", "8"), ("COUNTIF(B2:B5,\"<=1.25\")", "2"), ("COUNTIF(D2:D5,\"<>hot\")", "2"), ("COUNTIF(A2:A5,\"?ea\")", "1"), ("COUNTIF(C2:C5,10)", "1"), ("AVERAGEIF(D2:D5,\"cold\",B2:B5)", "0.875"), ("AVERAGEIF(D2:D5,\"none\",B2:B5)", "#DIV/0!"), ("SUMIFS(C2:C5,D2:D5,\"hot\",B2:B5,\">3.5\")", "7"), ("COUNTIFS(D2:D5,\"cold\",C2:C5,\">5\")", "1"), ("AVERAGEIFS(B2:B5,D2:D5,\"hot\")", "3.75"), ("SUMPRODUCT(B2:B5,C2:C5)", "78"), ("SUMPRODUCT(B2:B5,C2:C4)", "#VALUE!"),
				("IF(B2>3,\"dear\",\"cheap\")", "dear"), ("IF(0,1)", "FALSE"), ("IF(1,,2)", "0"), ("IF(1,,2)&\"x\"", "x"), ("IF(TRUE,1,1/0)", "1"), ("IF(\"x\",1,2)", "#VALUE!"), ("IFS(B3>2,\"a\",B3>1,\"b\")", "b"), ("IFS(FALSE,1)", "#N/A"), ("IFERROR(1/0,\"none\")", "none"), ("IFERROR(5,\"none\")", "5"), ("IFNA(C6,0)", "0"), ("IFNA(1/0,0)", "#DIV/0!"), ("AND(TRUE,1,B2>3)", "TRUE"), ("OR(FALSE,0)", "FALSE"), ("XOR(TRUE,TRUE,TRUE)", "TRUE"), ("NOT(A6)", "FALSE"), ("AND(C6,TRUE)", "#N/A"), ("ISBLANK(Z1)", "TRUE"), ("ISNUMBER(B2)", "TRUE"), ("ISTEXT(B6)", "TRUE"), ("ISLOGICAL(A6)", "TRUE"), ("ISERROR(C6)", "TRUE"), ("ISERR(C6)", "FALSE"), ("ISNA(C6)", "TRUE"), ("ISEVEN(4)", "TRUE"), ("ISODD(4)", "FALSE"), ("N(TRUE)+N(\"x\")", "1"), ("T(5)&T(\"x\")", "x"), ("CHOOSE(2,\"a\",\"b\",\"c\")", "b"), ("CHOOSE(4,\"a\")", "#VALUE!"), ("SWITCH(D2,\"cold\",1,\"hot\",2,0)", "2"), ("SWITCH(5,1,\"a\")", "#N/A"),
				("CONCATENATE(A2,\" \",B2)", "Tea 3.5"), ("CONCAT(A2:A3)", "TeaMilk"), ("TEXTJOIN(\",\",TRUE,A2:A5,\"\",\"end\")", "Tea,Milk,Coffee,Water,end"), ("LEN(\"héllo\")", "5"), ("UPPER(A2)", "TEA"), ("LOWER(\"ABC\")", "abc"), ("PROPER(\"hello wORLD\")", "Hello World"), ("TRIM(\"  a   b  \")", "a b"), ("LEFT(\"héllo\",2)", "hé"), ("LEFT(\"ab\")", "a"), ("RIGHT(\"hello\",3)", "llo"), ("RIGHT(\"ab\",9)", "ab"), ("MID(\"hello\",2,3)", "ell"), ("MID(\"hello\",9,3)", ""), ("MID(\"hello\",0,3)", "#VALUE!"), ("FIND(\"l\",\"hello\")", "3"), ("FIND(\"l\",\"hello\",4)", "4"), ("FIND(\"L\",\"hello\")", "#VALUE!"), ("SEARCH(\"L?O\",\"hello\")", "3"), ("SUBSTITUTE(\"a-b-c\",\"-\",\"+\")", "a+b+c"), ("SUBSTITUTE(\"a-b-c\",\"-\",\"+\",2)", "a-b+c"), ("REPLACE(\"abcdef\",2,3,\"X\")", "aXef"), ("REPT(\"ab\",3)", "ababab"), ("EXACT(\"a\",\"A\")", "FALSE"), ("VALUE(\"1,234.5\")", "1234.5"), ("VALUE(\"12%\")", "0.12"), ("VALUE(\"x\")", "#VALUE!"), ("TEXT(1234.5,\"#,##0.00\")", "1,234.50"), ("TEXT(0.256,\"0%\")", "26%"), ("TEXT(DATE(2026,3,1),\"dd/mm/yyyy\")", "01/03/2026"), ("CLEAN(\"a\"&\"b\")", "ab"),
				("VLOOKUP(\"Milk\",A2:C5,2,FALSE)", "1.25"), ("VLOOKUP(\"milk\",A2:C5,3,0)", "4"), ("VLOOKUP(\"Co*\",A2:C5,2,FALSE)", "4"), ("VLOOKUP(\"Juice\",A2:C5,2,FALSE)", "#N/A"), ("VLOOKUP(\"Tea\",A2:C5,9,FALSE)", "#REF!"), ("VLOOKUP(6,\{1,\"a\";5,\"b\";10,\"c\"\},2)", "b"), ("VLOOKUP(0,\{1,\"a\";5,\"b\"\},2)", "#N/A"), ("HLOOKUP(\"Stock\",A1:D5,3,FALSE)", "4"), ("INDEX(A2:C5,3,1)", "Coffee"), ("INDEX(B2:B5,2)", "1.25"), ("INDEX(A1:D1,3)", "Stock"), ("INDEX(A2:C5,9,1)", "#REF!"), ("MATCH(\"Coffee\",A2:A5,0)", "3"), ("MATCH(1,B2:B5,0)", "#N/A"), ("MATCH(6,\{1,5,10\})", "2"), ("MATCH(6,\{10,5,1\},-1)", "1"), ("INDEX(B2:B5,MATCH(\"Water\",A2:A5,0))", "0.5"), ("ROW(B7)", "7"), ("COLUMN(C1)", "3"), ("ROW()", "1"), ("ROWS(A2:C5)", "4"), ("COLUMNS(A2:C5)", "3"), ("ROWS(\{1,2;3,4;5,6\})", "3"),
				("DATE(2026,3,1)", "46082"), ("DATE(2026,14,1)", "46419"), ("DATE(2026,3,0)", "46081"), ("DATE(2026,-1,15)", "45976"), ("YEAR(46082)", "2026"), ("MONTH(46082)", "3"), ("DAY(46082)", "1"), ("WEEKDAY(46082)", "1"), ("WEEKDAY(46082,2)", "7"), ("HOUR(0.75)", "18"), ("MINUTE(TIME(13,45,30))", "45"), ("SECOND(TIME(13,45,30))", "30"), ("ROUND(TIME(25,0,0),6)", "0.041667"), ("EDATE(DATE(2026,1,31),1)", "46081"), ("EDATE(DATE(2024,2,29),12)", "45716"), ("EOMONTH(DATE(2026,1,15),1)", "46081"), ("EOMONTH(DATE(2026,3,1),-1)", "46081"), ("DAYS(DATE(2026,3,1),DATE(2026,1,1))", "59"), ("YEAR(\"2026-03-01\")", "2026"), ("TODAY()=INT(NOW())", "TRUE")]
			for let (_, pair) in cases {
				let (formula, want) = pair
				let got = run(book, formula)
				assert got == want onerror fail "{formula} gave {got}, want {want}"
			}
			return none
		}

		@test()
		def TestCalculate() !none {
			let book = numbers()
			let sheet = book.sheets[0]
			sheet.setFormula(1, 4, "B2*C2")
			sheet.setFormula(2, 4, "B3*C3")
			sheet.setFormula(6, 4, "SUM(E2:E3)*(1+Rate)")
			sheet.setFormula(6, 0, "IF(E7>40,\"big\",\"small\")&\"!\"")
			sheet.setFormula(6, 1, "E7>40")
			sheet.setFormula(6, 2, "DATE(2026,3,1)+E2/35").format = "yyyy-mm-dd"
			sheet.setFormula(7, 0, "A9+1")
			sheet.setFormula(8, 0, "A8*2")
			sheet.setFormula(7, 1, "B8")
			sheet.setFormula(7, 2, "1/0+A8")
			book.sheets[1].setFormula(0, 1, "Data!E7+A1")
			// A chain longer than any stack of calls would need care with.
			let chain = book.add("Chain")
			chain.set(0, 0, 1)
			for let r = 1; r < 2000; r++ {
				chain.setFormula(r, 0, "A{r}+1")
			}
			book.calculate()
			assert sheet.cell(1, 4).number == 35.0 && sheet.cell(6, 4).number == 48.0
			assert sheet.cell(6, 0).kind == CellKind.Text && sheet.cell(6, 0).text == "big!" && sheet.cell(6, 0).formula != ""
			assert sheet.cell(6, 1).kind == CellKind.Bool && sheet.cell(6, 1).bool()
			assert sheet.cell(6, 2).kind == CellKind.Date && sheet.cell(6, 2).str() == "2026-03-02"
			assert sheet.cell(7, 0).str() == "#REF!" && sheet.cell(8, 0).str() == "#REF!" && sheet.cell(7, 1).str() == "#REF!"
			assert sheet.cell(7, 2).str() == "#DIV/0!"
			assert book.sheets[1].cell(0, 1).number == 148.0
			assert chain.cell(1999, 0).number == 2000.0
			// Results travel with the file, and a changed input shows after a new pass.
			let back = try new Xlsx().decode(try new Xlsx().encode(book))
			assert back.sheets[0].cell(6, 4).number == 48.0 && back.sheets[0].cell(6, 4).formula == "SUM(E2:E3)*(1+Rate)"
			back.sheets[0].set(1, 1, 10)
			back.calculate()
			assert back.sheets[0].cell(6, 4).number == 126.0 && back.sheets[1].cell(0, 1).number == 226.0
			assert book.evaluate("A1*2", "other SHEET").number == 200.0 && book.evaluate("1", "missing").str() == "#REF!"
			assert new Workbook().evaluate("1+1").str() == "#REF!"
		}

		@test()
		def TestDocument() {
			let book = numbers()
			book.title = "Stock"
			book.author = "Ada"
			book.add("Blank")
			let doc = document(book)
			assert doc.title == "Stock" && doc.authors.len() == 1 && doc.authors[0] == "Ada"
			let tables = doc.tables()
			assert tables.len() == 2 && doc.blocks.len() == 4 && doc.blocks[0].plainText() == "Data"
			let table = tables[0]
			assert table.columns() == 4 && table.children.len() == 6 && table.children[0].header
			let price = table.cell(1, 1)
			assert price.plainText() == "3.5" unless price is none
			assert !(price is none)
			assert table.alignments[2] == Alignment.Right && table.alignments[0] == Alignment.Default && table.alignments[1] == Alignment.Default
		}
	}
}
