partial module std.formats.sheets {
	use (
		std.bytes
		std.formats.container::(openPackage, zipStartsWith)
		std.formats.sheets.xlsx::*
		std.io
	)

	// Xlsx is the Office Open XML spreadsheet codec, the format of
	// Microsoft Excel since 2007.
	//
	// Decoding reads every sheet in tab order: numbers, shared and inline
	// texts (rich text as its plain text), bools, errors, dates (numbers
	// in a date format, and ISO date cells) in the 1900 or 1904 date
	// system, formulas with their last results (shared formulas written
	// out per cell), each cell's number format code, merged areas, column
	// widths, frozen rows and columns, defined names, and the title and
	// author of the document properties. Fonts, colours, borders, charts,
	// pictures, comments, filters and validation are left out.
	//
	// Encoding writes a package Excel and LibreOffice open, with the same
	// content. Texts go to the shared string table; a date cell without a
	// format is written as `yyyy-mm-dd`, with `hh:mm:ss` when it has a
	// time of day.
	//
	// ```
	// let book = try sheets.load("report.xlsx")
	// for let (_, row) in book.sheets[0].values() {
	//     println(row.join("\t"))
	// }
	// ```
	@codec("Office Open XML Workbook")
	type Xlsx {
		mimeType string[] {
			def get() string[] {
				return string["application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".xlsx", ".xlsm", ".xltx"]
			}
		}

		// matchSignature reports whether the reader is a zip archive whose
		// first entries include a part under `xl/`.
		def matchSignature(r io.Reader) bool {
			return zipStartsWith(r, "xl/")
		}

		// decode reads the whole reader as an XLSX package.
		// Fails when the reader does, or as decode(byte[]) does.
		def decode(reader io.Reader) !Workbook {
			let source = new bytes.Buffer()
			try source.readFrom(reader)
			return decode(source.bytes())
		}

		// decode reads the bytes as an XLSX package.
		// Fails when they are not a zip archive, the package has no
		// workbook part, or one of its parts is not well-formed XML.
		def decode(data byte[]) !Workbook {
			return readXlsx(try openPackage(data))
		}

		// encode writes the workbook as an XLSX package.
		// Fails when the writer does.
		def encode(book Workbook, writer io.Writer) !none {
			let _ = try writer.write(try encode(book))
			return none
		}

		// encode returns the workbook as the bytes of an XLSX package.
		// Fails only when the archive cannot be built.
		def encode(book Workbook) !byte[] {
			return writeXlsx(book)
		}
	}
}
