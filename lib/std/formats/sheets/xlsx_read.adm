internal partial module std.formats.sheets.xlsx {
	use (
		std.data.encoding::(XMLNode, XMLNodeKind)
		std.formats.container::(Package, folderOf, resolve)
		std.formats.sheets::*
		std.formats.sheets.formula::(shiftFormula, unprefixFunctions)
		std.formats.sheets.numfmt::(builtinFormat, isDateFormat, isoSerial)
	)

	const booleanFormat = "\"TRUE\";\"TRUE\";\"FALSE\""
	const relationshipsNS = "http://schemas.openxmlformats.org/officeDocument/2006/relationships"

	// The value of an attribute, "" when the element has none.
	def attr(node XMLNode, name string) string {
		let value = node.attribute(name)
		return value is none ?? ("", value)
	}

	// The target of each relationship of a part, by id, as part names.
	def relationships(pkg Package, part string) !map<string, string> {
		let out = map<string, string>{}
		let name = folderOf(part) + "_rels/" + part[folderOf(part).len():] + ".rels"
		let root = try pkg.xml(name)
		return out when root is none
		for let (_, rel) in root.elements("Relationship") {
			let id = rel.attribute("Id")
			let target = rel.attribute("Target")
			continue when id is none || target is none
			continue when attr(rel, "TargetMode") == "External"
			out[id] = resolve(part, target)
		}
		return out
	}

	// The text of a string item: its `t`, or its rich text runs joined;
	// phonetic guides are left out.
	def stringItem(item XMLNode) string {
		let out = ""
		for let (_, node) in item.children {
			continue unless node.kind == XMLNodeKind.Element
			if node.localName == "t" {
				out += node.text()
			} else if node.localName == "r" {
				for let (_, t) in node.elements("t") {
					out += t.text()
				}
			}
		}
		return out
	}

	// The number format code of each cell styleId of the styles part, by
	// styleId index.
	def styleFormats(pkg Package, part string) !string[] {
		let out string[] = []
		let root = try pkg.xml(part)
		return out when root is none
		let custom = map<int, string>{}
		let numFmts = root.child("numFmts")
		if !(numFmts is none) {
			for let (_, f) in numFmts.elements("numFmt") {
				let id = f.attribute("numFmtId")
				let code = f.attribute("formatCode")
				continue when id is none || code is none
				custom[parseInt<int>(id)] = code
			}
		}
		let xfs = root.child("cellXfs")
		return out when xfs is none
		for let (_, xf) in xfs.elements("xf") {
			let idText = xf.attribute("numFmtId")
			let id = idText is none ?? (0, parseInt<int>(idText))
			let code = custom.get(id)
			let chosen = code is none ?? (builtinFormat(id), code)
			out.push(chosen.lower() == "general" ?? ("", chosen))
		}
		return out
	}

	def readXlsx(pkg Package) !Workbook {
		let book = new Workbook()
		let top = try relationships(pkg, "")
		let bookPart = "xl/workbook.xml"
		for let (_, target) in top {
			bookPart = target when target.lower().endsWith("workbook.xml")
		}
		let root = try pkg.xml(bookPart)
		fail "xlsx: the package has no workbook part" when root is none
		let rels = try relationships(pkg, bookPart)

		let strings string[] = []
		let formats string[] = []
		for let (_, target) in rels {
			let low = target.lower()
			if low.endsWith("sharedstrings.xml") {
				let table = try pkg.xml(target)
				continue when table is none
				for let (_, item) in table.elements("si") {
					strings.push(stringItem(item))
				}
			} else if low.endsWith("styles.xml") {
				formats = try styleFormats(pkg, target)
			}
		}

		// The 1904 date system counts days from 1904-01-01: 1462 later.
		let offset = 0.0
		let props = root.child("workbookPr")
		if !(props is none) {
			let flag = attr(props, "date1904")
			offset = 1462.0 when flag == "1" || flag == "true"
		}

		let list = root.child("sheets")
		fail "xlsx: the workbook lists no sheets" when list is none
		for let (_, entry) in list.elements("sheet") {
			let name = entry.attribute("name")
			let id = entry.attribute("id", relationshipsNS)
			continue when name is none || id is none
			let part = rels.get(id)
			continue when part is none
			let sheet = book.add(name)
			let content = try pkg.xml(part)
			continue when content is none
			readSheet(sheet, content, strings, formats, offset)
		}

		let defined = root.child("definedNames")
		if !(defined is none) {
			for let (_, d) in defined.elements("definedName") {
				let name = d.attribute("name")
				continue when name is none || name.startsWith("_xlnm.")
				book.names[name] = unprefixFunctions(d.text())
			}
		}

		let core = try pkg.xml("docProps/core.xml")
		if !(core is none) {
			let title = core.child("title")
			book.title = title.text() unless title is none
			let creator = core.child("creator")
			book.author = creator.text() unless creator is none
		}
		return book
	}

	def readSheet(sheet Sheet, root XMLNode, strings string[], formats string[], offset float) {
		let views = root.child("sheetViews")
		if !(views is none) {
			let shown = views.child("sheetView")
			let pane = shown is none ?? (none, shown.child("pane"))
			if !(pane is none) {
				let state = attr(pane, "state")
				if state == "frozen" || state == "frozenSplit" {
					let x = pane.attribute("xSplit")
					let y = pane.attribute("ySplit")
					sheet.frozenColumns = int(parseFloat<float>(x)) unless x is none
					sheet.frozenRows = int(parseFloat<float>(y)) unless y is none
				}
			}
		}
		let cols = root.child("cols")
		if !(cols is none) {
			for let (_, col) in cols.elements("col") {
				let min = col.attribute("min")
				let max = col.attribute("max")
				let width = col.attribute("width")
				continue when min is none || max is none || width is none
				continue unless attr(col, "customWidth") == "1" || attr(col, "customWidth") == "true"
				let last = parseInt<int>(max)
				// A width for "every column to the right" is the default, not data.
				continue when last - parseInt<int>(min) > 1024
				for let c = parseInt<int>(min); c <= last; c++ {
					sheet.widths[c - 1] = parseFloat<float>(width)
				}
			}
		}

		// Shared formulas: the text and position of each group's first cell.
		let sharedText = map<string, string>{}
		let sharedRow = map<string, int>{}
		let sharedColumn = map<string, int>{}

		let data = root.child("sheetData")
		if !(data is none) {
			let rowIndex = -1
			for let (_, row) in data.elements("row") {
				let r = row.attribute("r")
				rowIndex = r is none ?? (rowIndex + 1, parseInt<int>(r) - 1)
				let columnIndex = -1
				for let (_, c) in row.elements("c") {
					let at = c.attribute("r")
					columnIndex++
					if !(at is none) {
						let position = parseReference(at) onerror recover (rowIndex, columnIndex)
						let (_, column) = position
						columnIndex = column
					}
					let styleId = c.attribute("s")
					let format = ""
					if !(styleId is none) {
						let index = parseInt<int>(styleId)
						format = formats[index] when index >= 0 && index < formats.len()
					}
					let kind = attr(c, "t")
					let v = c.child("v")
					let f = c.child("f")
					let inline = c.child("is")
					continue when v is none && f is none && inline is none && format == ""
					let cell = sheet.cell(rowIndex, columnIndex)
					cell.format = format

					if !(f is none) {
						let text = f.text()
						let group = f.attribute("si")
						if attr(f, "t") == "shared" && !(group is none) {
							if text != "" {
								sharedText[group] = text
								sharedRow[group] = rowIndex
								sharedColumn[group] = columnIndex
							} else if sharedText.hasKey(group) {
								text = shiftFormula(sharedText[group], rowIndex - sharedRow[group], columnIndex - sharedColumn[group])
							}
						}
						cell.formula = unprefixFunctions(text)
					}

					if !(inline is none) {
						cell.set(stringItem(inline))
						continue
					}
					continue when v is none
					let value = v.text()
					if kind == "s" {
						let index = parseInt<int>(value)
						cell.set(index >= 0 && index < strings.len() ?? (strings[index], ""))
					} else if kind == "str" || kind == "inlineStr" {
						cell.set(value)
					} else if kind == "b" {
						cell.set(value == "1" || value == "true")
					} else if kind == "e" {
						cell.setError(value)
					} else if kind == "d" {
						let serial = isoSerial(value)
						if serial is none {
							cell.set(value)
						} else {
							cell.kind = CellKind.Date
							cell.number = serial
						}
					} else {
						cell.set(parseFloat<float>(value))
						if format == booleanFormat {
							// LibreOffice writes bools as numbers in this format.
							cell.set(cell.number != 0.0)
							cell.format = ""
						} else if isDateFormat(format) {
							cell.kind = CellKind.Date
							cell.number += offset
						}
					}
				}
			}
		}

		let merges = root.child("mergeCells")
		if !(merges is none) {
			for let (_, m) in merges.elements("mergeCell") {
				let area = m.attribute("ref")
				continue when area is none
				let range = parseRange(area) onerror recover Range{top: -1, left: 0, bottom: 0, right: 0}
				sheet.merges.push(range) unless range.top < 0
			}
		}
	}
}
