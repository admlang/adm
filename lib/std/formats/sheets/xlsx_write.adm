internal partial module std.formats.sheets.xlsx {
	use (
		std.data.encoding::(XMLWriter)
		std.formats.container::(PackageWriter)
		std.formats.sheets::*
		std.formats.sheets.formula::(toStoredFormula)
	)

	const mainNS = "http://schemas.openxmlformats.org/spreadsheetml/2006/main"
	const packageRelsNS = "http://schemas.openxmlformats.org/package/2006/relationships"

	// The styleId table being built: one cell styleId per number format code.
	type Styles {
		codes string[]
		index map<string, int>

		def new() {
			codes = [""]
			index = map<string, int>{}
			index[""] = 0
		}

		// The styleId index of a format code.
		def of(code string) int {
			let found = index.get(code)
			return found unless found is none
			codes.push(code)
			index[code] = codes.len() - 1
			return codes.len() - 1
		}
	}

	// A number as XLSX stores it: the shortest text that reads back equal.
	def numberText(value float) string {
		let text = value.str()
		return text when parseFloat<float>(text) == value
		return "%.17g".format(value)
	}

	def writeXlsx(book Workbook) !byte[] {
		let pkg = new PackageWriter()
		let strings string[] = []
		let stringIndex = map<string, int>{}
		let styles = new Styles()

		let sheetList = book.sheets
		// A workbook must have a sheet to open.
		sheetList = [new Sheet("Sheet1")] when sheetList.len() == 0

		let types = new XMLWriter()
		types.declaration(true)
		types.start("Types")
		types.attribute("xmlns", "http://schemas.openxmlformats.org/package/2006/content-types")
		for let (_, pair) in [("rels", "application/vnd.openxmlformats-package.relationships+xml"), ("xml", "application/xml")] {
			let (extension, kind) = pair
			types.start("Default")
			types.attribute("Extension", extension)
			types.attribute("ContentType", kind)
			types.end()
		}
		let overrides = [("/xl/workbook.xml", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"), ("/xl/styles.xml", "application/vnd.openxmlformats-officedocument.spreadsheetml.styles+xml"), ("/xl/sharedStrings.xml", "application/vnd.openxmlformats-officedocument.spreadsheetml.sharedStrings+xml"), ("/docProps/core.xml", "application/vnd.openxmlformats-package.core-properties+xml")]
		for let (i, _) in sheetList {
			overrides.push(("/xl/worksheets/sheet{i + 1}.xml", "application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"))
		}
		for let (_, pair) in overrides {
			let (part, kind) = pair
			types.start("Override")
			types.attribute("PartName", part)
			types.attribute("ContentType", kind)
			types.end()
		}
		types.end()
		try pkg.add("[Content_Types].xml", types.bytes())

		let top = new XMLWriter()
		top.declaration(true)
		top.start("Relationships")
		top.attribute("xmlns", packageRelsNS)
		for let (i, pair) in [("http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument", "xl/workbook.xml"), ("http://schemas.openxmlformats.org/package/2006/relationships/metadata/core-properties", "docProps/core.xml")] {
			let (kind, target) = pair
			top.start("Relationship")
			top.attribute("Id", "rId{i + 1}")
			top.attribute("Type", kind)
			top.attribute("Target", target)
			top.end()
		}
		top.end()
		try pkg.add("_rels/.rels", top.bytes())

		let core = new XMLWriter()
		core.declaration(true)
		core.start("cp:coreProperties")
		core.attribute("xmlns:cp", "http://schemas.openxmlformats.org/package/2006/metadata/core-properties")
		core.attribute("xmlns:dc", "http://purl.org/dc/elements/1.1/")
		core.element("dc:title", book.title) unless book.title == ""
		core.element("dc:creator", book.author) unless book.author == ""
		core.end()
		try pkg.add("docProps/core.xml", core.bytes())

		let wb = new XMLWriter()
		wb.declaration(true)
		wb.start("workbook")
		wb.attribute("xmlns", mainNS)
		wb.attribute("xmlns:r", relationshipsNS)
		wb.start("sheets")
		for let (i, sheet) in sheetList {
			wb.start("sheet")
			wb.attribute("name", sheet.name)
			wb.attribute("sheetId", (i + 1).str())
			wb.attribute("r:id", "rId{i + 1}")
			wb.end()
		}
		wb.end()
		if book.names.len() > 0 {
			wb.start("definedNames")
			for let (name, formula) in book.names {
				wb.start("definedName")
				wb.attribute("name", name)
				wb.text(toStoredFormula(formula))
				wb.end()
			}
			wb.end()
		}
		wb.end()
		try pkg.add("xl/workbook.xml", wb.bytes())

		let rels = new XMLWriter()
		rels.declaration(true)
		rels.start("Relationships")
		rels.attribute("xmlns", packageRelsNS)
		for let (i, _) in sheetList {
			rels.start("Relationship")
			rels.attribute("Id", "rId{i + 1}")
			rels.attribute("Type", relationshipsNS + "/worksheet")
			rels.attribute("Target", "worksheets/sheet{i + 1}.xml")
			rels.end()
		}
		for let (i, pair) in [("styles", "styles.xml"), ("sharedStrings", "sharedStrings.xml")] {
			let (kind, target) = pair
			rels.start("Relationship")
			rels.attribute("Id", "rId{sheetList.len() + i + 1}")
			rels.attribute("Type", relationshipsNS + "/" + kind)
			rels.attribute("Target", target)
			rels.end()
		}
		rels.end()
		try pkg.add("xl/_rels/workbook.xml.rels", rels.bytes())

		for let (i, sheet) in sheetList {
			try pkg.add("xl/worksheets/sheet{i + 1}.xml", sheetXml(sheet, strings, stringIndex, styles))
		}

		let sst = new XMLWriter()
		sst.declaration(true)
		sst.start("sst")
		sst.attribute("xmlns", mainNS)
		sst.attribute("uniqueCount", strings.len().str())
		for let (_, text) in strings {
			sst.start("si")
			sst.start("t")
			sst.attribute("xml:space", "preserve") unless text == text.trim()
			sst.text(text)
			sst.end()
			sst.end()
		}
		sst.end()
		try pkg.add("xl/sharedStrings.xml", sst.bytes())

		let st = new XMLWriter()
		st.declaration(true)
		st.start("styleSheet")
		st.attribute("xmlns", mainNS)
		if styles.codes.len() > 1 {
			st.start("numFmts")
			st.attribute("count", (styles.codes.len() - 1).str())
			for let (i, code) in styles.codes {
				continue when i == 0
				st.start("numFmt")
				// Custom format ids start at 164.
				st.attribute("numFmtId", (163 + i).str())
				st.attribute("formatCode", code)
				st.end()
			}
			st.end()
		}
		st.raw("<fonts count=\"1\"><font><sz val=\"11\"/><name val=\"Calibri\"/></font></fonts>" + "<fills count=\"2\"><fill><patternFill patternType=\"none\"/></fill><fill><patternFill patternType=\"gray125\"/></fill></fills>" + "<borders count=\"1\"><border><left/><right/><top/><bottom/><diagonal/></border></borders>" + "<cellStyleXfs count=\"1\"><xf numFmtId=\"0\" fontId=\"0\" fillId=\"0\" borderId=\"0\"/></cellStyleXfs>")
		st.start("cellXfs")
		st.attribute("count", styles.codes.len().str())
		for let (i, _) in styles.codes {
			st.start("xf")
			st.attribute("numFmtId", i == 0 ?? ("0", (163 + i).str()))
			st.attribute("fontId", "0")
			st.attribute("fillId", "0")
			st.attribute("borderId", "0")
			st.attribute("xfId", "0")
			st.attribute("applyNumberFormat", "1") when i > 0
			st.end()
		}
		st.end()
		st.raw("<cellStyles count=\"1\"><cellStyle name=\"Normal\" xfId=\"0\" builtinId=\"0\"/></cellStyles>")
		st.end()
		try pkg.add("xl/styles.xml", st.bytes())
		return pkg.bytes()
	}

	def sheetXml(sheet Sheet, strings string[], stringIndex map<string, int>, styles Styles) byte[] {
		let w = new XMLWriter()
		w.declaration(true)
		w.start("worksheet")
		w.attribute("xmlns", mainNS)
		if sheet.frozenRows > 0 || sheet.frozenColumns > 0 {
			w.start("sheetViews")
			w.start("sheetView")
			w.attribute("workbookViewId", "0")
			w.start("pane")
			w.attribute("xSplit", sheet.frozenColumns.str()) when sheet.frozenColumns > 0
			w.attribute("ySplit", sheet.frozenRows.str()) when sheet.frozenRows > 0
			w.attribute("topLeftCell", reference(sheet.frozenRows, sheet.frozenColumns))
			w.attribute("activePane", sheet.frozenRows > 0 ?? (sheet.frozenColumns > 0 ?? ("bottomRight", "bottomLeft"), "topRight"))
			w.attribute("state", "frozen")
			w.end()
			w.end()
			w.end()
		}
		if sheet.widths.len() > 0 {
			w.start("cols")
			for let (_, column) in sheet.widths.keys().sort((a, b) => a < b) {
				w.start("col")
				w.attribute("min", (column + 1).str())
				w.attribute("max", (column + 1).str())
				w.attribute("width", numberText(sheet.widths[column]))
				w.attribute("customWidth", "1")
				w.end()
			}
			w.end()
		}
		w.start("sheetData")
		let openRow = -1
		for let (_, position) in sheet.positions() {
			let (row, column) = position
			let cell = sheet.cell(row, column)
			continue when cell.kind == CellKind.Empty && cell.formula == "" && cell.format == ""
			if row != openRow {
				w.end() when openRow >= 0
				w.start("row")
				w.attribute("r", (row + 1).str())
				openRow = row
			}
			w.start("c")
			w.attribute("r", reference(row, column))
			let format = cell.format
			if format == "" && cell.kind == CellKind.Date {
				format = cell.number == cell.number.floor() ?? ("yyyy-mm-dd", cell.number.abs() < 1.0 ?? ("hh:mm:ss", "yyyy-mm-dd hh:mm:ss"))
			}
			let styleId = styles.of(format)
			w.attribute("s", styleId.str()) when styleId > 0
			let hasFormula = cell.formula != ""
			match cell.kind {
				case CellKind.Text:
					if hasFormula {
						w.attribute("t", "str")
						w.element("f", toStoredFormula(cell.formula))
						w.element("v", cell.text)
					} else {
						let at = stringIndex.get(cell.text)
						let index = 0
						if at is none {
							strings.push(cell.text)
							index = strings.len() - 1
							stringIndex[cell.text] = index
						} else {
							index = at
						}
						w.attribute("t", "s")
						w.element("v", index.str())
					}
				case CellKind.Bool:
					w.attribute("t", "b")
					w.element("f", toStoredFormula(cell.formula)) when hasFormula
					w.element("v", cell.number != 0.0 ?? ("1", "0"))
				case CellKind.Error:
					w.attribute("t", "e")
					w.element("f", toStoredFormula(cell.formula)) when hasFormula
					w.element("v", cell.text)
				case CellKind.Number, CellKind.Date:
					w.element("f", toStoredFormula(cell.formula)) when hasFormula
					w.element("v", numberText(cell.number))
				default:
					w.element("f", toStoredFormula(cell.formula)) when hasFormula
			}
			w.end()
		}
		w.end() when openRow >= 0
		w.end()
		if sheet.merges.len() > 0 {
			w.start("mergeCells")
			w.attribute("count", sheet.merges.len().str())
			for let (_, range) in sheet.merges {
				w.start("mergeCell")
				w.attribute("ref", reference(range))
				w.end()
			}
			w.end()
		}
		w.end()
		return w.bytes()
	}
}
