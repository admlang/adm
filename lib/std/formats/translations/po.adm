partial module std.formats.translations {
	use (
		std.formats.translations.loader::*
		std.formats.translations.pofile
		std.i18n::(Catalog)
		std.io
	)

	// Po is the gettext catalog format (`.po`, and `.pot` templates): every
	// message with its context, plural forms, translator and extracted
	// comments, references, flags, previous source text and obsolete
	// messages, and the catalog's header with its plural expression.
	//
	// A message's text is read as the ICU MessageFormat syntax (see
	// `std.i18n.Message`); gettext plural forms (`msgid_plural`,
	// `msgstr[n]`) are kept as forms and picked by the header's
	// `Plural-Forms`.
	//
	// Reads UTF-8, the single-byte charsets of `std.data.encoding.codepages`
	// and Shift_JIS, by the header's `charset`; writes UTF-8, laid out as
	// `msgcat` does.
	@codec("gettext PO")
	type Po {
		// The column lines wrap at when written, as `msgcat --width`; 0
		// writes each text on one line (`--no-wrap`).
		width int = 79

		extension string[] {
			def get() string[] {
				return string[".po", ".pot"]
			}
		}

		mimeType string[] {
			def get() string[] {
				return string["text/x-gettext-translation", "text/x-po", "application/x-gettext"]
			}
		}

		// matchSignature implements SignatureMatcher: a comment or a `msgid`
		// first.
		def matchSignature(r io.Reader) bool {
			for let line in head(r, 128).split("\n") {
				let text = line.trim()
				continue when text == ""
				return text == "#" || text.startsWith("# ") || text.startsWith("#.") || text.startsWith("#:") || text.startsWith("#,") || text.startsWith("#~") || text.startsWith("msgid ") || text.startsWith("msgctxt ") || text.startsWith("domain ")
			}
			return false
		}

		// read implements CatalogFormat. The catalog's locale is the
		// header's `Language`, undetermined ("und") without one.
		// Fails with a CatalogFormatError naming the line when the file is
		// not well-formed: text outside quotes, an unknown keyword, a
		// message without `msgid` or `msgstr`, plural forms out of order, a
		// message defined twice, a charset that cannot be read; and when
		// the reader fails.
		def read(reader io.Reader) !Catalog {
			let data = try io.readAll(reader)
			return pofile.read(data)
		}

		// write implements CatalogFormat. A catalog without a header gets
		// the one the gettext tools need: its language, UTF-8, and its
		// plural expression when a message has plural forms.
		// Fails when the writer fails.
		def write(catalog Catalog, writer io.Writer) !none {
			try writer.write(pofile.write(catalog, width).bytes())
		}
	}
}
