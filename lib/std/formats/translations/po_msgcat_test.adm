	check "PoMsgcat" {
		// Whether the Po codec writes what it reads from `source` as msgcat does.
		def same(source string, want string) !bool {
			let po = new Po()
			let catalog = try po.read(new bytes.Reader(source.bytes()))
			let out = new bytes.Buffer()
			try po.write(catalog, out)
			let got = string(out.bytes())
			return true when got == want
			let a = got.split("\n")
			let b = want.split("\n")
			for let i = 0; i < a.len() && i < b.len(); i++ {
				continue when a[i] == b[i]
				println("line " + (i + 1).str() + "\n  got  " + a[i] + "\n  want " + b[i])
				break
			}
			return false
		}

