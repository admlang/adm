// The gettext PO format: reading a file into a Catalog.

internal partial module std.formats.translations.pofile {
	use (
		std.data.encoding.codepages
		std.data.encoding.shiftjis
		std.formats.translations::*
		std.i18n::(Catalog, CatalogEntry, CatalogHeader, Locale)
	)

	// Draft is the message being read: its comments, then its fields as the
	// keywords give them.
	type Draft {
		comments   string[]
		notes      string[]
		references string[]
		flags      string[]
		previous   string[]
		obsolete   bool
		context    string
		hasContext bool
		id         string
		hasId      bool
		plural     string
		hasPlural  bool
		text       string
		hasText    bool
		forms      map<int, string>
		// The field a continuation line adds to: "msgctxt", "msgid",
		// "msgid_plural", "msgstr" or "form"; "" before any.
		last       string
		lastForm   int
		// The line the message starts at.
		line       int

		def new() {}

		// Whether anything was read into it.
		def started() bool {
			return hasId || hasContext || hasText || forms.len() > 0 || comments.len() > 0 || notes.len() > 0 || references.len() > 0 || flags.len() > 0 || previous.len() > 0
		}

		// Whether a translation was read, so the next keyword or comment
		// starts another message.
		def complete() bool {
			return hasText || forms.len() > 0
		}
	}

	// Reader reads one file.
	type Reader {
		charset string
		page    ?codepages.CodePage
		catalog Catalog
		seen    map<string, int>
		draft   Draft
		line    int

		def new(charset string) {
			self.charset = charset
			page = codepages.forCharset(charset)
			catalog = new Catalog(new Locale())
			draft = new Draft()
		}

		def wrong(why string) CatalogFormatError {
			return CatalogFormatError{message: "po: line {line}: " + why, code: "po", line: line}
		}

		// Bytes of the file's charset as text.
		def decoded(data byte[]) string {
			return shiftjis.decode(data) when isShiftJis(charset)
			let single = page
			return string(data) when single is none
			return codepages.decode(data, single)
		}

		def read(text string) !Catalog {
			for let raw in text.split("\n") {
				line++
				let content = raw.trim(" \t\r")
				continue when content == ""
				if content.startsWith("#~") {
					let rest = content[2:].trimStart(" \t")
					if rest.startsWith("|") {
						try store() when draft.complete()
						draft.obsolete = true
						draft.previous.push(rest[1:].trimStart(" \t"))
					} else if rest != "" {
						try keyword(rest, true)
					}
					continue
				}
				if content.startsWith("#") {
					try store() when draft.complete()
					draft.line = line unless draft.started()
					comment(content)
					continue
				}
				try keyword(content, false)
			}
			try store()
			return catalog
		}

		def comment(content string) {
			let body = content[2:].trimStart(" \t")
			match content[1:2] {
				case ".":
					draft.notes.push(body)
				case ":":
					for let reference in references(body) {
						draft.references.push(reference)
					}
				case ",", "=":
					for let flag in body.split(",") {
						let name = flag.trim()
						draft.flags.push(name) when name != "" && !draft.flags.includes(name)
					}
				case "|":
					draft.previous.push(body)
				default:
					draft.comments.push(content[1:].trimPrefix(" "))
			}
		}

		// A keyword with its text, or a continuation of the last one.
		def keyword(content string, obsolete bool) !none {
			if content.startsWith("\"") {
				fail wrong("text without a keyword before it") when draft.last == ""
				let more = try quoted(content)
				match draft.last {
					case "msgctxt":
						draft.context += more
					case "msgid":
						draft.id += more
					case "msgid_plural":
						draft.plural += more
					case "msgstr":
						draft.text += more
					default:
						draft.forms[draft.lastForm] = draft.forms[draft.lastForm] + more
				}
				return none
			}
			let quote = content.indexOf("\"")
			fail wrong("\"" + content + "\" is neither a keyword with its text nor a comment") when quote < 0
			let name = content[:quote].trim(" \t")
			let value = try quoted(content[quote:])
			if name == "domain" {
				try store()
				return none
			}
			if name := "msgctxt" || "msgid" {
				try store() when draft.hasId || draft.complete()
			}
			draft.line = line unless draft.started()
			draft.obsolete = true when obsolete
			match name {
				case "msgctxt":
					fail wrong("a second msgctxt") when draft.hasContext
					draft.context = value
					draft.hasContext = true
				case "msgid":
					draft.id = value
					draft.hasId = true
				case "msgid_plural":
					fail wrong("msgid_plural without a msgid before it") unless draft.hasId
					fail wrong("a second msgid_plural") when draft.hasPlural
					draft.plural = value
					draft.hasPlural = true
				case "msgstr":
					fail wrong("msgstr without a msgid before it") unless draft.hasId
					fail wrong("a second msgstr") when draft.hasText
					fail wrong("msgstr beside msgstr[n]") when draft.forms.len() > 0
					draft.text = value
					draft.hasText = true
				default:
					fail wrong("unknown keyword \"" + name + "\"") unless name.startsWith("msgstr[") && name.endsWith("]")
					let number = name[7:name.len() - 1].trim()
					fail wrong("\"" + name + "\" has no form number") unless number != "" && number.isNumeric()
					fail wrong("msgstr[n] without a msgid before it") unless draft.hasId
					fail wrong("msgstr[n] beside msgstr") when draft.hasText
					let index = number.toInt<int>()
					fail wrong("a second msgstr[{index}]") when draft.forms.hasKey(index)
					fail wrong("msgstr[{index}] comes before msgstr[{draft.forms.len()}]") unless index == draft.forms.len()
					draft.forms[index] = value
					draft.lastForm = index
					draft.last = "form"
					return none
			}
			draft.last = name
			return none
		}

		// Puts the message read so far into the catalog.
		def store() !none {
			let done = draft
			draft = new Draft()
			return none unless done.started()
			// Comments after the last message belong to none.
			return none unless done.hasId || done.hasContext || done.complete()
			let at = line
			line = done.line
			fail wrong("a message without a msgid") unless done.hasId
			fail wrong("a message without a msgstr") unless done.complete()
			fail wrong("msgid_plural with a msgstr; it takes msgstr[0], msgstr[1], ...") when done.hasPlural && done.hasText
			fail wrong("msgstr[n] without a msgid_plural") when !done.hasPlural && done.forms.len() > 0
			if done.id == "" && !done.hasContext && !done.obsolete {
				fail wrong("a second header") when catalog.headers.len() > 0 || seen.hasKey("")
				seen[""] = done.line
				catalog.comments = done.comments
				catalog.flags = done.flags
				for let row in done.text.split("\n") {
					let colon = row.indexOf(":")
					continue when colon < 0
					catalog.headers.push(CatalogHeader{name: row[:colon], value: row[colon + 1:].trimPrefix(" ")})
				}
				let language = catalog.header("Language")
				catalog.locale = new Locale(language.trim()) unless language is none || language.trim() == ""
				line = at
				return none
			}
			let entry = CatalogEntry{
				key:        done.id,
				context:    done.context,
				text:       done.text,
				plural:     done.plural,
				comments:   done.comments,
				notes:      done.notes,
				references: done.references,
				flags:      done.flags,
				previous:   done.previous,
				obsolete:   done.obsolete,
			}
			for let i = 0; i < done.forms.len(); i++ {
				let form = done.forms.get(i)
				entry.forms.push(form) unless form is none
			}
			let id = (done.obsolete ?? ("~", "")) + done.context + "\u0004" + done.id
			let earlier = seen.get(id)
			fail wrong("the message is already defined at line {earlier}") unless earlier is none
			seen[id] = done.line
			// An obsolete message does not stand in for a live one with its key.
			if done.obsolete && seen.hasKey(done.context + "\u0004" + done.id) {
				line = at
				return none
			}
			catalog.add(entry)
			line = at
			return none
		}

		// The text of one quoted string, escapes resolved.
		def quoted(content string) !string {
			let chars char[]
			for let ch in content {
				chars.push(ch)
			}
			let out = ""
			// Bytes written as octal or hexadecimal escapes, in the file's charset.
			let raw byte[]
			let i = 1
			for {
				fail wrong("the text has no closing quote") when i >= chars.len()
				let c = chars[i]
				break when c == '"'
				if c != '\\' {
					if raw.len() > 0 {
						out += decoded(raw)
						raw = byte[]
					}
					out += string(c)
					i++
					continue
				}
				i++
				fail wrong("the text has no closing quote") when i >= chars.len()
				let e = chars[i]
				i++
				let value = -1
				if e >= '0' && e <= '7' {
					value = int(e) - int('0')
					for let k = 0; k < 2 && i < chars.len() && chars[i] >= '0' && chars[i] <= '7'; k++ {
						value = value * 8 + int(chars[i]) - int('0')
						i++
					}
				} else if e == 'x' {
					fail wrong("\"\\x\" without a hexadecimal digit") unless i < chars.len() && hexValue(chars[i]) >= 0
					value = 0
					for i < chars.len() && hexValue(chars[i]) >= 0 {
						value = value * 16 + hexValue(chars[i])
						i++
					}
				}
				if value >= 0 {
					raw.push(byte(value & 0xff))
					continue
				}
				if raw.len() > 0 {
					out += decoded(raw)
					raw = byte[]
				}
				match e {
					case 'n':
						out += "\n"
					case 't':
						out += "\t"
					case 'r':
						out += "\r"
					case 'a':
						out += "\u0007"
					case 'b':
						out += "\u0008"
					case 'f':
						out += "\u000c"
					case 'v':
						out += "\u000b"
					case '"':
						out += "\""
					case '\\':
						out += "\\"
					default:
						fail wrong("unknown escape \"\\" + string(e) + "\"")
				}
			}
			out += decoded(raw) when raw.len() > 0
			let rest = ""
			for let k = i + 1; k < chars.len(); k++ {
				rest += string(chars[k])
			}
			fail wrong("\"" + rest.trim() + "\" after the closing quote") when rest.trim(" \t\r") != ""
			return out
		}
	}

	def hexValue(c char) int {
		return int(c) - int('0') when c >= '0' && c <= '9'
		return int(c) - int('a') + 10 when c >= 'a' && c <= 'f'
		return int(c) - int('A') + 10 when c >= 'A' && c <= 'F'
		return -1
	}

	// The references of a "#:" line: separated by spaces, one with spaces in
	// its file name held between the isolate marks U+2068 and U+2069.
	def references(body string) string[] {
		let out string[]
		let current = ""
		let isolated = false
		for let ch in body {
			if ch == char(0x2068) {
				isolated = true
			} else if ch == char(0x2069) {
				isolated = false
			} else if (ch := ' ' || '\t') && !isolated {
				out.push(current) when current != ""
				current = ""
			} else {
				current += string(ch)
			}
		}
		out.push(current) when current != ""
		return out
	}

	def isShiftJis(charset string) bool {
		return charset.lower() := "shift_jis" || "shift-jis" || "sjis" || "cp932" || "windows-31j" || "ms_kanji"
	}

	def isUtf8(charset string) bool {
		return charset.lower() := "" || "utf-8" || "utf8" || "us-ascii" || "ascii" || "charset"
	}

	// The charset the header names: the word after "charset=" in the bytes
	// before the second message, "" when there is none.
	def charsetOf(data byte[]) string {
		let limit = data.len() < 8192 ?? (data.len(), 8192)
		let head = string(data[:limit])
		let at = head.indexOf("charset=")
		return "" when at < 0
		let name = ""
		for let ch in head[at + 8:] {
			break when ch := '\\' || '"' || ' ' || ';' || '\n' || '\r'
			name += string(ch)
		}
		return name
	}

	// Reads a PO file.
	// Fails with a CatalogFormatError when it is not well-formed, or names a
	// charset that cannot be read.
	def read(data byte[]) !Catalog {
		let charset = charsetOf(data)
		let reader = new Reader(charset)
		if !isUtf8(charset) && !isShiftJis(charset) && reader.page is none {
			fail CatalogFormatError{message: "po: the charset \"" + charset + "\" cannot be read; convert the file to UTF-8 (msgconv -t UTF-8)", code: "po", line: 0}
		}
		let text = reader.decoded(data).trimPrefix("\uFEFF")
		return reader.read(text)
	}
}
