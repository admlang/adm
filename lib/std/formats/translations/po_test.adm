partial module std.formats.translations {
	use (
		std.bytes
		std.i18n::(Catalog, CatalogEntry, Locale)
		std.os
		std.testing
		std.time
	)

	check "Po" {
		def parse(text string) !Catalog {
			return new Po().read(new bytes.Reader(text.bytes()))
		}

		// The line a file is refused at, 0 when it is read.
		def refusedAt(text string) int {
			let line = 0
			parse(text) onerror (err error) {
				if err is CatalogFormatError {
					line = err.line
				} else {
					line = -1
				}
				recover new Catalog(new Locale())
			}
			return line
		}

		// The message, or one with the key "(none)" when the catalog has none.
		def entry(catalog Catalog, key string, context string = "") CatalogEntry {
			let found = catalog.get(key, context)
			return CatalogEntry{key: "(none)"} when found is none
			return found
		}

		def text(catalog Catalog, key string, params map<string, any> = {}) string {
			let m = catalog.message(key)
			return "(none)" when m is none
			return m.format(params)
		}

		def header(catalog Catalog, name string) string {
			let value = catalog.header(name)
			return "(none)" when value is none
			return value
		}

		def named(path string) string {
			let l = localeOfName(path)
			return "" when l is none
			return l.str()
		}

		const sample = "# Translated by hand\n#\nmsgid \"\"\nmsgstr \"\"\n\"Language: pt_BR\\n\"\n\"Content-Type: text/plain; charset=UTF-8\\n\"\n\"Plural-Forms: nplurals=2; plural=(n > 1);\\n\"\n\n#  keep the tone informal\n#. shown on the first page\n#: src/home.adm:12 src/menu.adm:7\n#: \u2068src/my file.adm:3\u2069\n#, fuzzy, c-format\n#| msgid \"Hello\"\nmsgctxt \"greeting\"\nmsgid \"Hello \\\"friend\\\"\"\nmsgstr \"\"\n\"Olá \"\n\"\\\"amigo\\\"\\n\"\n\nmsgid \"file\"\nmsgid_plural \"files\"\nmsgstr[0] \"\{count\} arquivo\"\nmsgstr[1] \"\{count\} arquivos\"\n\nmsgid \"basket.count\"\nmsgstr \"\{count, plural, one\{# item\} other\{# itens\}\}\"\n\n#~ msgid \"old\"\n#~ msgstr \"velho\"\n"

		@test()
		def readsEveryPartOfAMessage() !none {
			let catalog = try parse(sample)
			assert catalog.locale.str() == "pt-BR"
			assert catalog.comments.join("|") == "Translated by hand|"
			assert header(catalog, "Plural-Forms") == "nplurals=2; plural=(n > 1);"
			assert catalog.headers.len() == 3
			assert catalog.len() == 4
			let hello = entry(catalog, "Hello \"friend\"", "greeting")
			assert hello.text == "Olá \"amigo\"\n"
			assert hello.comments.join("|") == " keep the tone informal"
			assert hello.notes.join("|") == "shown on the first page"
			assert hello.references.join("|") == "src/home.adm:12|src/menu.adm:7|src/my file.adm:3"
			assert hello.flags.join("|") == "fuzzy|c-format"
			assert hello.previous.join("|") == "msgid \"Hello\""
			assert !catalog.has("Hello \"friend\"", "greeting")
			let files = entry(catalog, "file")
			assert files.plural == "files"
			assert files.forms.join("|") == "\{count\} arquivo|\{count\} arquivos"
			let old = entry(catalog, "old")
			assert old.obsolete && old.text == "velho"
		}

		@test()
		def messagesFormatThroughTheCatalog() !none {
			let catalog = try parse(sample)
			assert text(catalog, "file", {"count": 0}) == "0 arquivo"
			assert text(catalog, "file", {"count": 1}) == "1 arquivo"
			assert text(catalog, "file", {"count": 2}) == "2 arquivos"
			assert text(catalog, "basket.count", {"count": 1500}) == "1.500 itens"
		}

		@test()
		def namesTheLineOfWhatIsWrong() {
			assert refusedAt(sample) == 0
			assert refusedAt("msgid \"a\"\nmsgstr \"b\"\n\nmsgid \"a\"\nmsgstr \"c\"\n") == 4
			assert refusedAt("msgid \"a\"\nmsgstr \"unclosed\n") == 2
			assert refusedAt("msgid \"a\"\nmsgstr \"b\" junk\n") == 2
			assert refusedAt("msgid \"a\"\n\nmsgid \"b\"\nmsgstr \"c\"\n") == 1
			assert refusedAt("msgstr \"b\"\n") == 1
			assert refusedAt("\"text\"\n") == 1
			assert refusedAt("msgid \"a\"\nmsgfoo \"b\"\n") == 2
			assert refusedAt("hello\n") == 1
			assert refusedAt("msgid \"a\"\nmsgid_plural \"b\"\nmsgstr \"c\"\n") == 1
			assert refusedAt("msgid \"a\"\nmsgstr[0] \"c\"\n") == 1
			assert refusedAt("msgid \"a\"\nmsgid_plural \"b\"\nmsgstr[1] \"c\"\n") == 3
			assert refusedAt("msgid \"a\"\nmsgstr \"\\q\"\n") == 2
		}

		@test()
		def refusesACharsetItCannotRead() {
			let message = ""
			parse("msgid \"\"\nmsgstr \"Content-Type: text/plain; charset=EUC-KR\\n\"\n") onerror (err error) {
				message = err.message
				recover new Catalog(new Locale())
			}
			assert message.contains("EUC-KR")
		}

		@test()
		def readsOtherCharsets() !none {
			let head = "msgid \"\"\nmsgstr \"Content-Type: text/plain; charset=ISO-8859-1\\n\"\n\nmsgid \"cafe\"\nmsgstr \"caf"
			let data = head.bytes()
			data.push(0xe9)
			for let b in "\"\n".bytes() {
				data.push(b)
			}
			let catalog = try new Po().read(new bytes.Reader(data))
			assert entry(catalog, "cafe").text == "café"
			// Written back in UTF-8.
			let out = new bytes.Buffer()
			try new Po().write(catalog, out)
			assert string(out.bytes()).contains("charset=UTF-8")
			assert string(out.bytes()).contains("msgstr \"café\"")
			// Bytes written as escapes are bytes of the file's charset.
			let escaped = try parse("msgid \"\"\nmsgstr \"Content-Type: text/plain; charset=UTF-8\\n\"\n\nmsgid \"a\"\nmsgstr \"caf\\303\\251 \\x41\"\n")
			assert entry(escaped, "a").text == "café A"
		}

		@test()
		def writesACatalogMadeInCode() !none {
			let catalog = new Catalog(new Locale("pt-BR"))
			catalog.add(CatalogEntry{key: "Save", context: "button", text: "Salvar", notes: ["the toolbar button"], references: ["src/toolbar.adm:9"]})
			catalog.add(CatalogEntry{key: "file", plural: "files", forms: ["um arquivo", "\{count\} arquivos"]})
			let out = new bytes.Buffer()
			try new Po().write(catalog, out)
			let want = "msgid \"\"\nmsgstr \"\"\n\"Language: pt_BR\\n\"\n\"MIME-Version: 1.0\\n\"\n\"Content-Type: text/plain; charset=UTF-8\\n\"\n\"Content-Transfer-Encoding: 8bit\\n\"\n\"Plural-Forms: nplurals=2; plural=(n != 1);\\n\"\n\n#. the toolbar button\n#: src/toolbar.adm:9\nmsgctxt \"button\"\nmsgid \"Save\"\nmsgstr \"Salvar\"\n\nmsgid \"file\"\nmsgid_plural \"files\"\nmsgstr[0] \"um arquivo\"\nmsgstr[1] \"\{count\} arquivos\"\n"
			assert string(out.bytes()) == want
			let back = try parse(want)
			assert back.locale.str() == "pt-BR"
			assert back.len() == 2
			// Without wrapping every text is one line.
			let long = new Catalog(new Locale("en"))
			long.add(CatalogEntry{key: "k", text: "aaaa bbbb cccc dddd eeee ffff gggg hhhh iiii jjjj kkkk llll mmmm nnnn oooo pppp qqqq rrrr"})
			let wide = new bytes.Buffer()
			try Po{width: 0}.write(long, wide)
			assert string(wide.bytes()).contains("msgstr \"aaaa bbbb cccc dddd eeee ffff gggg hhhh iiii jjjj kkkk llll mmmm nnnn oooo pppp qqqq rrrr\"\n")
		}

		@test()
		def loadsAndSavesFiles() !none {
			let folder = "/tmp/adm-po-{time.now().unixNs()}"
			try os.mkdir(folder, true)
			let catalog = new Catalog(new Locale("de"))
			catalog.add(CatalogEntry{key: "Save", text: "Speichern"})
			try save(catalog, folder + "/de.po")
			let back = try load(folder + "/de.po")
			assert back.locale.str() == "de"
			assert back.has("Save")
			// A file that does not say its language takes it from its name.
			try os.writeFile(folder + "/messages.pt_BR.po", "msgid \"a\"\nmsgstr \"b\"\n".bytes())
			let named = try load(folder + "/messages.pt_BR.po")
			assert named.locale.str() == "pt-BR"
			try os.writeFile(folder + "/messages.pot", "msgid \"a\"\nmsgstr \"\"\n".bytes())
			let template = try load(folder + "/messages.pot")
			assert template.locale.str() == "und"
			assert supports("x/fr.po") && supports("x/app.POT") && !supports("x/fr.txt")
			let refused = false
			save(catalog, folder + "/de.txt") onerror (err error) {
				refused = true
				recover none
			}
			assert refused
			// By content, without a name to go by.
			let probed = try load(new bytes.Reader("# comment\nmsgid \"a\"\nmsgstr \"b\"\n".bytes()))
			assert probed.has("a")
			try os.remove(folder, true)
		}

		@test()
		def localesOfFileNames() {
			assert named("locales/de.po") == "de"
			assert named("locales/pt_BR.po") == "pt-BR"
			assert named("locales/sr-Latn-RS.po") == "sr-Latn-RS"
			assert named("locales/messages.fr-CA.po") == "fr-CA"
			assert named("locales/messages.po") == ""
			assert named("po") == ""
		}
	}
}
