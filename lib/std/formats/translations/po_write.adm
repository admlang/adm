// The gettext PO format: writing a Catalog, laid out as msgcat does.

internal partial module std.formats.translations.pofile {
	use (
		std.i18n::(Catalog, CatalogEntry, CatalogHeader)
		std.text.unicode
	)

	// Writes the catalog as a PO file in UTF-8, lines wrapped at `width`
	// columns (0 for none).
	def write(catalog Catalog, width int) string {
		let lines string[]
		for let comment in catalog.comments {
			lines.push(comment == "" ?? ("#", "# " + comment))
		}
		lines.push("#, " + flagsText(catalog.flags)) when catalog.flags.len() > 0
		lines.push("msgid \"\"")
		let entries = catalog.entries()
		let description = ""
		for let h in headersToWrite(catalog, entries) {
			description += h.name + ": " + h.value + "\n"
		}
		field(lines, "msgstr", description, width, "")
		for let entry in entries {
			lines.push("")
			message(lines, entry, width)
		}
		return lines.join("\n") + "\n"
	}

	// The header as written: the catalog's own with its charset made UTF-8,
	// or the lines the gettext tools need when it has none.
	def headersToWrite(catalog Catalog, entries CatalogEntry[]) CatalogHeader[] {
		let out CatalogHeader[]
		let typed = false
		for let h in catalog.headers {
			if h.name.lower() == "content-type" {
				typed = true
				out.push(CatalogHeader{name: h.name, value: "text/plain; charset=UTF-8"})
			} else {
				out.push(CatalogHeader{name: h.name, value: h.value})
			}
		}
		return out when typed
		if catalog.header("Language") is none && catalog.locale.language.code != "und" {
			out.push(CatalogHeader{name: "Language", value: catalog.locale.posix()})
		}
		out.push(CatalogHeader{name: "MIME-Version", value: "1.0"}) when catalog.header("MIME-Version") is none
		out.push(CatalogHeader{name: "Content-Type", value: "text/plain; charset=UTF-8"})
		out.push(CatalogHeader{name: "Content-Transfer-Encoding", value: "8bit"}) when catalog.header("Content-Transfer-Encoding") is none
		if catalog.header("Plural-Forms") is none {
			for let entry in entries {
				if entry.forms.len() > 0 {
					out.push(CatalogHeader{name: "Plural-Forms", value: catalog.pluralForms()})
					break
				}
			}
		}
		return out
	}

	def message(lines string[], entry CatalogEntry, width int) {
		for let comment in entry.comments {
			lines.push(comment == "" ?? ("#", "# " + comment))
		}
		for let note in entry.notes {
			lines.push(note == "" ?? ("#.", "#. " + note))
		}
		// References fill each line up to the width.
		let row = "#:"
		for let reference in entry.references {
			let shown = reference.contains(" ") ?? ("⁨" + reference + "⁩", reference)
			if row != "#:" && width > 0 && unicode.displayWidth(row) + 1 + unicode.displayWidth(shown) > width {
				lines.push(row)
				row = "#:"
			}
			row += " " + shown
		}
		lines.push(row) when row != "#:"
		lines.push("#, " + flagsText(entry.flags)) when entry.flags.len() > 0
		let lead = entry.obsolete ?? ("#~ ", "")
		for let previous in entry.previous {
			lines.push((entry.obsolete ?? ("#~| ", "#| ")) + previous)
		}
		field(lines, lead + "msgctxt", entry.context, width, lead) when entry.context != ""
		field(lines, lead + "msgid", entry.key, width, lead)
		if entry.plural != "" || entry.forms.len() > 0 {
			field(lines, lead + "msgid_plural", entry.plural, width, lead)
			for let (i, form) in entry.forms {
				field(lines, lead + "msgstr[{i}]", form, width, lead)
			}
			field(lines, lead + "msgstr[0]", "", width, lead) when entry.forms.len() == 0
			return
		}
		field(lines, lead + "msgstr", entry.text, width, lead)
	}

	// The flags as written: "fuzzy" first, as the gettext tools put it.
	def flagsText(flags string[]) string {
		let ordered string[]
		ordered.push("fuzzy") when flags.includes("fuzzy")
		for let flag in flags {
			ordered.push(flag) unless flag == "fuzzy"
		}
		return ordered.join(", ")
	}

	// Writes a keyword with its text: on one line when it fits and holds no
	// line break but a final one; else an empty first line, then one line
	// for each line of the text, wrapped at the width.
	def field(lines string[], keyword string, text string, width int, lead string) {
		let segments string[]
		let rest = text
		for {
			let newline = rest.indexOf("\n")
			break when newline < 0
			segments.push(rest[:newline + 1])
			rest = rest[newline + 1:]
		}
		segments.push(rest) when rest != "" || segments.len() == 0
		if segments.len() == 1 {
			let escaped = new Escaped(segments[0])
			let pieces = escaped.wrap(width, width > 0 ?? (unicode.displayWidth(keyword) + 1, 0))
			if pieces.len() == 1 {
				lines.push(keyword + " \"" + pieces[0] + "\"")
				return
			}
		}
		lines.push(keyword + " \"\"")
		for let segment in segments {
			for let piece in new Escaped(segment).wrap(width > 0 ?? (width - unicode.displayWidth(lead), 0), 0) {
				lines.push(lead + "\"" + piece + "\"")
			}
		}
	}

	// Escaped is a text as a PO file writes it between quotes, with the
	// places it must not be cut: inside an escape, and before a final "\n".
	type Escaped {
		chars  char[]
		// Whether a line may not end before the character at each index.
		joined bool[]

		def new(text string) {
			for let ch in text {
				let escape = escapeOf(ch)
				if escape == "" {
					chars.push(ch)
					joined.push(false)
					continue
				}
				chars.push('\\')
				joined.push(false)
				for let e in escape {
					chars.push(e)
					joined.push(true)
				}
			}
			let n = chars.len()
			joined[n - 2] = true when n >= 2 && chars[n - 2] == '\\' && chars[n - 1] == 'n' && text.endsWith("\n")
		}

		// The text cut into lines no wider than `width` with their quotes,
		// the first one `taken` columns shorter; cut where Unicode line
		// breaking allows. A stretch with no such place stays whole.
		def wrap(width int, taken int) string[] {
			let whole = ""
			for let ch in chars {
				whole += string(ch)
			}
			return [whole] when width <= 0 || chars.len() == 0
			let allowed bool[]
			allowed.len(chars.len() + 1)
			for let place in unicode.lineBreaks(whole) {
				allowed[place.index] = true when place.index < chars.len() && !joined[place.index]
			}
			let out string[]
			let start = 0
			// The last place the line could end, and the width up to it.
			let cut = -1
			let used = 0
			let room = width - 2 - taken
			for let i = 0; i < chars.len(); i++ {
				cut = i when allowed[i] && i > start
				let w = unicode.displayWidth(chars[i])
				if used + w > room && cut > start {
					out.push(text(start, cut))
					start = cut
					cut = -1
					room = width - 2
					used = 0
					for let k = start; k < i; k++ {
						used += unicode.displayWidth(chars[k])
					}
				}
				used += w
			}
			out.push(text(start, chars.len()))
			return out
		}

		def text(from int, to int) string {
			let out = ""
			for let i = from; i < to; i++ {
				out += string(chars[i])
			}
			return out
		}
	}

	// What follows the backslash when the character is written escaped; ""
	// for a character written as it is.
	def escapeOf(ch char) string {
		match ch {
			case '\n':
				return "n"
			case '\t':
				return "t"
			case '\r':
				return "r"
			case '"':
				return "\""
			case '\\':
				return "\\"
		}
		match int(ch) {
			case 7:
				return "a"
			case 8:
				return "b"
			case 12:
				return "f"
			case 11:
				return "v"
		}
		return ""
	}
}
