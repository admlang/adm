// Translation catalog files: the formats translators and their tools
// exchange, each read into and written from `std.i18n.Catalog`.
partial module std.formats.translations {
	use (
		std.bytes
		std.errors
		std.formats
		std.formats.translations.loader::*
		std.i18n::(Catalog, Locale)
		std.io
		std.os
		std.reflection
	)

	// CatalogFormatError reports a catalog file that is not well-formed.
	struct CatalogFormatError {
		message string
		code    string
		cause   ?error
		stack   errors.StackTrace
		// The line the file goes wrong at, from 1; 0 when no line is to blame.
		line    int
	}

	// CatalogFormat reads and writes one catalog file format.
	interface CatalogFormat {
		// read parses the catalog the data holds.
		// Fails when the data is not well-formed in this format, or the
		// reader fails.
		def read(reader io.Reader) !Catalog

		// write writes the catalog in this format.
		// Fails when the writer fails.
		def write(catalog Catalog, writer io.Writer) !none
	}

	// CatalogCodec is what a catalog format registers.
	type CatalogCodec = CatalogFormat & formats.FileFormat

	// codec registers a catalog format under `name`.
	meta def codec<CatalogCodec>(ctx reflection.DiscoveryMetaContext<reflection.TypeMetaContext>, name string) {}

	// load reads the catalog in the file at `path`, picking the format by
	// extension, else by content. A file that does not say which language it
	// holds takes it from its name: `de.po`, `pt_BR.po`, `messages.fr-CA.po`.
	// Fails when no registered format reads the file, or it cannot be read.
	def load(path string) !Catalog {
		let data = try os.readFile(path)
		let format = codecRegistry.matchExt(os.extension(path))
		let catalog = format is none ?? (try load(new bytes.Reader(data)), try format.read(new bytes.Reader(data)))
		if catalog.locale.language.code == "und" {
			let named = localeOfName(path)
			catalog.locale = named unless named is none
		}
		return catalog
	}

	// load reads a catalog from `reader`, picking the format by content.
	// Fails when no registered format reads the data, or the reader fails.
	def load(reader io.Reader) !Catalog {
		let (format, r) = try codecRegistry.probe(reader)
		return format.read(r)
	}

	// save writes the catalog to `path` in the format its extension names.
	// Fails when no registered format has the extension, or the file cannot
	// be written.
	def save(catalog Catalog, path string) !none {
		let format = codecRegistry.matchExt(os.extension(path))
		fail "no catalog format has the extension \"{os.extension(path)}\"" when format is none
		let out = new bytes.Buffer()
		try format.write(catalog, out)
		return os.writeFile(path, out.bytes())
	}

	// supports reports whether a registered catalog format has the
	// extension of the file at `path`.
	def supports(path string) bool {
		return !(codecRegistry.matchExt(os.extension(path)) is none)
	}

	// localeOfName returns the language a catalog file's name gives: the
	// last part of its base name that reads as a locale ("de", "pt_BR",
	// "sr-Latn"); none when no part does.
	def localeOfName(path string) ?Locale {
		let name = path
		let slash = name.lastIndexOf("/")
		name = name[slash + 1:] when slash >= 0
		let parts = name.split(".")
		// The extension is not a language ("po" is not Polish here).
		for let i = parts.len() - 2; i >= 0; i-- {
			let part = parts[i]
			continue unless part.len() >= 2 && isLanguageTag(part)
			return new Locale(part)
		}
		return none
	}
}

internal partial module std.formats.translations.loader {
	use (
		std.formats
		std.formats.translations::*
		std.i18n::(Locale)
		std.io
	)

	let codecRegistry = new formats.CodecRegistry<CatalogCodec>("catalog", codec)

	// Up to `count` bytes from the start of `reader` as text, for a signature
	// test; what a failing reader gave before it failed.
	def head(reader io.Reader, count int) string {
		let out byte[]
		let buf byte[]
		buf.len(count)
		for out.len() < count {
			let n = reader.read(buf[:count - out.len()]) onerror recover 0
			break when n <= 0
			for let i = 0; i < n; i++ {
				out.push(buf[i])
			}
		}
		return string(out).trimPrefix("\uFEFF")
	}

	// Whether the text is a locale whose language CLDR knows by a two- or
	// three-letter code: "de", "pt_BR", "sr-Latn-RS"; not "messages".
	def isLanguageTag(text string) bool {
		let locale = new Locale(text)
		let code = locale.language.code
		return false when code == "und" || code.len() > 3
		return locale.language.name(new Locale("en")) != code
	}
}
