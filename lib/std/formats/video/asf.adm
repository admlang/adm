partial module std.formats.video {
	use (
		std.io
		std.formats.video.demux::*
		std.formats.video.media.source::*
		std.formats.video.asf::*
		std.formats.video.media.asf::*
	)

	// ASF is the Advanced Systems Format of Windows Media (`.wmv`, `.asf`,
	// `.wma`): the streams of the header object and the media objects of
	// the data packets, reassembled from their payloads. Timestamps are the
	// presentation times less the preroll. Seeking uses the simple index
	// when the file has one, else reads the packets from the start.
	@codec("ASF")
	type ASF {
		mimeType string[] {
			def get() string[] {
				return string["video/x-ms-asf", "video/x-ms-wmv", "audio/x-ms-wma"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".wmv", ".asf", ".wma"]
			}
		}

		// matchSignature reports whether the reader starts with the ASF
		// header object's GUID.
		def matchSignature(r io.Reader) bool {
			let head byte[]
			head.len(16)
			let n = io.readFull(r, head) onerror recover 0
			return n == 16 && asfIsGuid(head, 0, asfHeaderObject)
		}

		// open reads the header object and, when the reader can seek, the
		// simple index after the data.
		//
		// Fails when the file is not ASF, its header is cut short, or the
		// reader fails.
		def open(reader io.Reader) !Container {
			let c = new AsfContainer(new Source(reader))
			try c.read()
			return c
		}
	}
}
