partial module std.formats.video {
	use (
		std.testing
		std.bytes
		std.data.encoding
	)

	check "ASF" {
		@test()
		def TestAsfTracks() !none {
			let c = try new ASF().open(new bytes.Reader(tinyWmv()))
			let tracks = c.tracks()
			assert tracks.len() == 2
			assert tracks[0].kind == TrackKind.Video && tracks[0].codec == "msmpeg4v2"
			assert tracks[0].width == 64 && tracks[0].height == 48
			assert tracks[1].kind == TrackKind.Audio && tracks[1].codec == "wmav2"
			assert tracks[1].sampleRate == 8000 && tracks[1].channels == 1
			// The WAVEFORMATEX with its 10 codec-specific bytes.
			assert tracks[1].config.len() == 28
		}

		@test()
		def TestAsfPackets() !none {
			let c = try new ASF().open(new bytes.Reader(tinyWmv()))
			try testing.expectEqual("", try comparePackets(c, tinyWmvPackets(), 1000))
		}

		@test()
		def TestAsfSeek() !none {
			let c = try new ASF().open(new bytes.Reader(tinyWmv()))
			try c.seek(700ms)
			let p = try c.next()
			fail "no packet after the seek" when p is none
			let first Packet = p
			assert first.track == 0 && first.keyframe && int64(first.pts) <= 700000000
		}

		@test()
		def TestAsfSound() !none {
			let (frames, peak) = try soundOf(tinyWmv())
			assert frames >= 7680 && frames <= 8192
			assert peak > 0.1 && peak < 0.2
		}
	}

