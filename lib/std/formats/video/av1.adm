partial module std.formats.video {
	use std.formats.video.av1::*

	// AV1 decodes AV1 video in software: Main, High and Professional
	// profiles at 8, 10 and 12 bits in 4:0:0, 4:2:0, 4:2:2 and 4:4:4, with
	// every coding tool (intra block copy, palette, filter intra, CfL,
	// compound wedge and difference masks, OBMC, warped and global motion,
	// scaled references, superres), the in-loop filters (deblocking, CDEF,
	// loop restoration) and film grain synthesis.
	//
	// Packets carry the OBUs of one temporal unit; the track's `config`
	// holds the av1C record when the container has one. Frames come out in
	// output order, timed by the packet that carried them. Only the
	// layers of operating point 0 are decoded.
	@decoder("av1")
	type AV1 {
		internal core Av1Decoder

		def new() {
			core = new Av1Decoder()
		}

		// configure implements VideoDecoder: reads the av1C record in
		// `track.config` when there is one. Fails on a malformed record or
		// sequence header.
		def configure(track Track) !none {
			core = new Av1Decoder()
			try core.configure(track.config)
			return none
		}

		// decode implements VideoDecoder: decodes the temporal unit in
		// `packet` and returns the frames it shows. Fails on a malformed or
		// unsupported stream.
		def decode(packet Packet) !VideoFrame[] {
			try core.packet(packet.data, packet.pts, packet.length)
			return core.take()
		}

		// flush implements VideoDecoder: AV1 holds no frames back, so this
		// returns nothing. Fails never.
		def flush() !VideoFrame[] {
			return core.take()
		}
	}
}
