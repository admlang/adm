internal partial module std.formats.video.av1 {
	// The skip context of a transform block (get_skip_ctx) from the coef
	// contexts above (a[ai..]) and left (l[li..], wrapping at 32 * mul).
	def av1CoefSkipCtx(t Av1Tile, tx int, bs int, a int[], ai int, l int[], li int, lmask int, chroma bool) int {
		let d = tx * 8
		let lw = av1TxDims[d + 2]
		let lh = av1TxDims[d + 3]
		let nw = 1 << lw
		let nh = 1 << lh
		let bl2w = av1BlockDims[bs * 4 + 2]
		let bl2h = av1BlockDims[bs * 4 + 3]
		if chroma {
			let notOne = (bl2w - ((bl2w != 0 && t.ssHor == 1) ?? (1, 0)) > lw || bl2h - ((bl2h != 0 && t.ssVer == 1) ?? (1, 0)) > lh) ?? (1, 0)
			let ca = 0
			for let i = 0; i < nw; i++ {
				if a[ai + i] != 0x40 {
					ca = 1
					break
				}
			}
			let cl = 0
			for let i = 0; i < nh; i++ {
				if l[(li + i) & lmask] != 0x40 {
					cl = 1
					break
				}
			}
			return 7 + notOne * 3 + ca + cl
		}
		return 0 when bl2w == lw && bl2h == lh
		let la = 0
		for let i = 0; i < nw; i++ {
			la = la | a[ai + i]
		}
		let ll = 0
		for let i = 0; i < nh; i++ {
			ll = ll | l[(li + i) & lmask]
		}
		let va = la & 0x3F
		let vl = ll & 0x3F
		va = 4 when va > 4
		vl = 4 when vl > 4
		return av1SkipCtx[va * 5 + vl]
	}

	def av1DcSignCtx(tx int, a int[], ai int, l int[], li int, lmask int) int {
		let d = tx * 8
		let nw = 1 << av1TxDims[d + 2]
		let nh = 1 << av1TxDims[d + 3]
		let s = 0
		for let i = 0; i < nw; i++ {
			s += a[ai + i] >> 6
		}
		for let i = 0; i < nh; i++ {
			s += l[(li + i) & lmask] >> 6
		}
		s -= nw + nh
		return (s != 0 ?? (1, 0)) + (s > 0 ?? (1, 0))
	}

	// get_lo_ctx over `levels` (int per coefficient, lo token in bits 6-7
	// of the byte dav1d keeps, the token below): returns ctx * 64 + mag.
	def av1LoCtx(levels int[], at int, cls int, x int, y int, stride int, offsets int) int {
		let mag = levels[at + 1] + levels[at + stride]
		let offset = 0
		let hi = 0
		if cls == av1TxClass2d {
			mag += levels[at + stride + 1]
			hi = mag
			mag += levels[at + 2] + levels[at + 2 * stride]
			let yy = y < 4 ?? (y, 4)
			let xx = x < 4 ?? (x, 4)
			offset = av1LoCtxOffsets[offsets * 25 + yy * 5 + xx]
		} else {
			mag += levels[at + 2]
			hi = mag
			mag += levels[at + 3] + levels[at + 4]
			offset = 26 + (y > 1 ?? (10, y * 5))
		}
		let c = offset + (mag > 512 ?? (4, (mag + 64) >> 7))
		return c * 1024 + (hi & 1023)
	}

	def av1ReadGolomb(m Av1Msac) int {
		let len = 0
		let val = 1
		for m.boolEqui() == 0 && len < 32 {
			len++
		}
		for let i = 0; i < len; i++ {
			val = (val << 1) + m.boolEqui()
		}
		return val - 1
	}

	// decode_coefs: the coefficients of one transform block into t.cf
	// (dav1d's transposed layout), its type into t.coefTxtp (read for
	// luma, derived for chroma; `txtp` is the luma type for inter chroma)
	// and its context byte into t.coefCtx. Returns the end of block, -1
	// when all are zero.
	def av1DecodeCoefs(t Av1Tile, a int[], ai int, l int[], li int, lmask int, tx int, bs int, intra bool, plane int, txtp int) int {
		let m = t.msac
		let h = t.hdr
		let chroma = plane > 0
		let ci = chroma ?? (1, 0)
		let lossless = h.segLossless[t.bSegId]
		let d = tx * 8
		let tctx = av1TxDims[d + 7]
		let sctx = av1CoefSkipCtx(t, tx, bs, a, ai, l, li, lmask, chroma)
		let allSkip = m.boolAdapt(av1CdfCoefSkip + (tctx * 13 + sctx) * 2)
		if allSkip == 1 {
			t.coefCtx = 0x40
			t.coefTxtp = lossless ?? (av1WhtWht, av1DctDct)
			return -1
		}
		let tt = txtp
		let txMax = av1TxDims[d + 5]
		let txMin = av1TxDims[d + 4]
		if lossless {
			tt = av1WhtWht
		} else if txMax + (intra ?? (1, 0)) >= av1Tx64x64 {
			tt = av1DctDct
		} else if chroma {
			if intra {
				tt = av1TxtpFromUvMode[t.bUvMode]
			} else {
				tt = av1UvInterTxtp(tx, txtp)
			}
		} else if h.segQidx[t.bSegId] == 0 {
			tt = av1DctDct
		} else if intra {
			let ym = t.bYMode == av1FilterPred ?? (av1FilterModeToYMode[t.bYAngle], t.bYMode)
			if h.reducedTxtpSet || txMin == av1Tx16x16 {
				let idx = m.symbol(av1CdfMTxtpIntra2 + (txMin * av1NIntraPredModes + ym) * 8, 4)
				tt = av1TxTypesPerSet[idx]
			} else {
				let idx = m.symbol(av1CdfMTxtpIntra1 + (txMin * av1NIntraPredModes + ym) * 8, 6)
				tt = av1TxTypesPerSet[idx + 5]
			}
		} else {
			if h.reducedTxtpSet || txMax == av1Tx32x32 {
				let idx = m.boolAdapt(av1CdfMTxtpInter3 + txMin * 2)
				tt = idx == 1 ?? (av1DctDct, av1Idtx)
			} else if txMin == av1Tx16x16 {
				let idx = m.symbol(av1CdfMTxtpInter2, 11)
				tt = av1TxTypesPerSet[idx + 12]
			} else {
				let idx = m.symbol(av1CdfMTxtpInter1 + txMin * 16, 15)
				tt = av1TxTypesPerSet[idx + 24]
			}
		}
		t.coefTxtp = tt
		// End of block.
		let lw = av1TxDims[d + 2]
		let lh = av1TxDims[d + 3]
		let slw = lw < av1Tx32x32 ?? (lw, av1Tx32x32)
		let slh = lh < av1Tx32x32 ?? (lh, av1Tx32x32)
		let sz = slw + slh
		let cls = av1TxTypeClass[tt]
		let is1d = cls != av1TxClass2d ?? (1, 0)
		let eob = 0
		match sz {
			case 0:
				eob = m.symbol(av1CdfCoefEobBin16 + (ci * 2 + is1d) * 8, 4)
			case 1:
				eob = m.symbol(av1CdfCoefEobBin32 + (ci * 2 + is1d) * 8, 5)
			case 2:
				eob = m.symbol(av1CdfCoefEobBin64 + (ci * 2 + is1d) * 8, 6)
			case 3:
				eob = m.symbol(av1CdfCoefEobBin128 + (ci * 2 + is1d) * 8, 7)
			case 4:
				eob = m.symbol(av1CdfCoefEobBin256 + (ci * 2 + is1d) * 16, 8)
			case 5:
				eob = m.symbol(av1CdfCoefEobBin512 + ci * 16, 9)
			default:
				eob = m.symbol(av1CdfCoefEobBin1024 + ci * 16, 10)
		}
		if eob > 1 {
			let bin = eob - 2
			let hiBit = m.boolAdapt(av1CdfCoefEobHiBit + ((tctx * 2 + ci) * 9 + bin) * 2)
			eob = ((hiBit | 2) << bin) | m.bools(bin)
		}
		let cf = t.cf
		let eobCdf = av1CdfCoefEobBaseTok + (tctx * 2 + ci) * 4 * 4
		let tc = tctx < 3 ?? (tctx, 3)
		let hiCdf = av1CdfCoefBrTok + (tc * 2 + ci) * 21 * 4
		let rc = 0
		let dcTok = 0
		if eob > 0 {
			let loCdf = av1CdfCoefBaseTok + (tctx * 2 + ci) * 41 * 4
			let lev = t.levels
			let ctx = 1 + (eob > (2 << sz) ?? (1, 0)) + (eob > (4 << sz) ?? (1, 0))
			let eobTok = m.symbol(eobCdf + ctx * 4, 2)
			let tok = eobTok + 1
			let levelTok = tok * 0x41
			let stride = 0
			let shift = 0
			let shift2 = 0
			let mask = 0
			let offs = 0
			let scan = av1ScanOffset[tx]
			if cls == av1TxClass2d {
				let nonsq = tx >= av1Rtx4x8 ?? (1, 0)
				offs = nonsq + (nonsq == 1 ?? (tx & 1, 0))
				stride = 4 << slh
				shift = slh + 2
				mask = (4 << slh) - 1
				for let i = 0; i < stride * ((4 << slw) + 2); i++ {
					lev[i] = 0
				}
			} else if cls == av1TxClassH {
				stride = 16
				shift = slh + 2
				mask = (4 << slh) - 1
				for let i = 0; i < stride * ((4 << slh) + 2); i++ {
					lev[i] = 0
				}
			} else {
				stride = 16
				shift = slw + 2
				shift2 = slh + 2
				mask = (4 << slw) - 1
				for let i = 0; i < stride * ((4 << slw) + 2); i++ {
					lev[i] = 0
				}
			}
			let x = 0
			let y = 0
			if cls == av1TxClass2d {
				rc = av1ScanData[scan + eob]
				x = rc >> shift
				y = rc & mask
			} else if cls == av1TxClassH {
				x = eob & mask
				y = eob >> shift
				rc = eob
			} else {
				x = eob & mask
				y = eob >> shift
				rc = (x << shift2) | y
			}
			if eobTok == 2 {
				let c2 = cls == av1TxClass2d ?? (((x | y) > 1 ?? (14, 7)), (y != 0 ?? (14, 7)))
				tok = m.hiTok(hiCdf + c2 * 4)
				levelTok = tok + (3 << 6)
			}
			cf[rc] = int32(tok << 11)
			let lv = cls == av1TxClass2d ?? (rc, x * stride + y)
			lev[lv] = levelTok & 255
			for let i = eob - 1; i > 0; i-- {
				let rci = 0
				if cls == av1TxClass2d {
					rci = av1ScanData[scan + i]
					x = rci >> shift
					y = rci & mask
				} else if cls == av1TxClassH {
					x = i & mask
					y = i >> shift
					rci = i
				} else {
					x = i & mask
					y = i >> shift
					rci = (x << shift2) | y
				}
				let li2 = cls == av1TxClass2d ?? (rci, x * stride + y)
				let cm = av1LoCtx(lev, li2, cls, x, y, stride, offs)
				let c2 = cm >> 10
				let mag = cm & 1023
				let yy = cls == av1TxClass2d ?? (y | x, y)
				tok = m.symbol(loCdf + c2 * 4, 3)
				if tok == 3 {
					mag = mag & 63
					let c3 = (yy > (cls == av1TxClass2d ?? (1, 0)) ?? (14, 7)) + (mag > 12 ?? (6, (mag + 1) >> 1))
					tok = m.hiTok(hiCdf + c3 * 4)
					lev[li2] = (tok + (3 << 6)) & 255
					cf[rci] = int32((tok << 11) | rc)
					rc = rci
				} else {
					lev[li2] = (tok * 0x41) & 255
					if tok != 0 {
						cf[rci] = int32((tok << 11) | rc)
						rc = rci
					} else {
						cf[rci] = int32(0)
					}
				}
			}
			// DC.
			let c2 = 0
			let mag = 0
			if cls != av1TxClass2d {
				let cm = av1LoCtx(lev, 0, cls, 0, 0, stride, offs)
				c2 = cm >> 10
				mag = cm & 1023
			}
			dcTok = m.symbol(loCdf + c2 * 4, 3)
			if dcTok == 3 {
				mag = lev[1] + lev[stride] + lev[stride + 1] when cls == av1TxClass2d
				mag = mag & 63
				let c3 = mag > 12 ?? (6, (mag + 1) >> 1)
				dcTok = m.hiTok(hiCdf + c3 * 4)
			}
		} else {
			let br = m.symbol(eobCdf, 2)
			dcTok = 1 + br
			dcTok = m.hiTok(hiCdf) when br == 2
			rc = 0
		}
		// Residual magnitudes, signs and dequantization.
		let dqAt = t.bSegId * 6 + plane * 2
		let qmAt = tt < av1Idtx ?? (t.qm[plane * av1NRectTxSizes + tx], -1)
		let dqShift = tctx - 2 > 0 ?? (tctx - 2, 0)
		let bpc = t.bitDepth == 8 ?? (8, t.bitDepth)
		let cfMax = ~(~127 << bpc)
		let cul = 0
		let dcSignLevel = 1 << 6
		if dcTok != 0 {
			let dsc = av1DcSignCtx(tx, a, ai, l, li, lmask)
			let dcSign = m.boolAdapt(av1CdfCoefDcSign + (ci * 3 + dsc) * 2)
			dcSignLevel = dcSign == 1 ?? (0, 2 << 6)
			let dcDq = t.dq[dqAt]
			dcDq = (dcDq * av1QmData[qmAt] + 16) >> 5 when qmAt >= 0
			if dcTok == 15 {
				dcTok = av1ReadGolomb(m) + 15
				dcTok = dcTok & 0xFFFFF
				dcDq = ((dcDq * dcTok) & 0xFFFFFF) >> dqShift
				let lim = cfMax + dcSign
				dcDq = lim when dcDq > lim
			} else {
				dcDq = (dcDq * dcTok) >> dqShift
				if qmAt >= 0 {
					let lim = cfMax + dcSign
					dcDq = lim when dcDq > lim
				}
			}
			cul = dcTok
			cf[0] = int32(dcSign == 1 ?? (-dcDq, dcDq))
		}
		if (dcTok != 0 && rc != 0) || (dcTok == 0) {
			let acDq = t.dq[dqAt + 1]
			let cur = rc
			// With dc zero, the AC chain starts at the first coefficient.
			cur = rc when dcTok == 0
			for cur != 0 {
				let sign = m.boolEqui()
				let rcTok = int(cf[cur])
				let tokv = 0
				let dqv = acDq
				dqv = (acDq * av1QmData[qmAt + cur] + 16) >> 5 when qmAt >= 0
				if rcTok >= (15 << 11) {
					tokv = av1ReadGolomb(m) + 15
					tokv = tokv & 0xFFFFF
					dqv = ((dqv * tokv) & 0xFFFFFF) >> dqShift
					let lim = cfMax + sign
					dqv = lim when dqv > lim
				} else {
					tokv = rcTok >> 11
					dqv = (dqv * tokv) >> dqShift
					if qmAt >= 0 {
						let lim = cfMax + sign
						dqv = lim when dqv > lim
					}
				}
				cul += tokv
				cf[cur] = int32(sign == 1 ?? (-dqv, dqv))
				cur = rcTok & 0x3FF
			}
		}
		t.coefCtx = (cul < 63 ?? (cul, 63)) | dcSignLevel
		return eob
	}

	// get_uv_inter_txtp.
	def av1UvInterTxtp(tx int, ytxtp int) int {
		let d = tx * 8
		return ytxtp == av1Idtx ?? (av1Idtx, av1DctDct) when av1TxDims[d + 5] == av1Tx32x32
		return av1DctDct when av1TxDims[d + 4] == av1Tx16x16 && (ytxtp == av1HFlipadst || ytxtp == av1VFlipadst || ytxtp == av1HAdst || ytxtp == av1VAdst)
		return ytxtp
	}
}
