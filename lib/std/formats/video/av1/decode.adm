internal partial module std.formats.video.av1 {
	use std.simd

	// Av1Tile decodes the superblocks of the tiles of one frame (dav1d
	// decode.c): the frame state the blocks share, the tile's symbol
	// decoder and contexts, and the block being decoded.
	type Av1Tile {
		seq             Av1SeqHdr
		hdr             Av1FrameHdr
		cur             Av1Frame
		// The frames of references 1..7 (index 0..6).
		refs            Av1Frame[]
		edges           Av1EdgeTree
		msac            Av1Msac
		// Frame geometry in 4x4 units, superblock size.
		bw              int
		bh              int
		b4Stride        int
		sbStep          int
		sbShift         int
		layout          int
		ssHor           int
		ssVer           int
		bitDepth        int
		// Dequantizers per segment, plane, dc/ac (frame and tile), and
		// the quantizer matrix of each plane and transform size (offset in
		// av1QmData, -1 for none).
		dqFrame         int[]
		dq              int[]
		qm              int[]
		// Loop filter levels per segment, plane/direction, reference and
		// mode delta (frame and tile).
		lflvlFrame      int[]
		lflvl           int[]
		// Motion of every 4x4 block of the frame: references (0 intra, -1
		// none, else 1 + reference), vectors, block size, merge flags.
		rRef0           int8[]
		rRef1           int8[]
		rMvx0           int16[]
		rMvy0           int16[]
		rMvx1           int16[]
		rMvy1           int16[]
		rBs             byte[]
		rMf             byte[]
		// Segment ids of this frame and of the primary reference.
		curSeg          byte[]
		prevSeg         byte[]
		hasPrevSeg      bool
		// CDEF index per 64x64 block (-1: filter off), row stride sb64w.
		cdefIdx         int[]
		sb64w           int
		// Loop restoration units per plane, row stride lrW[p].
		lrUnits         Av1LrUnit[]
		lrBase          int[]
		lrW             int[]
		lrH             int[]
		lrRef           Av1LrUnit[]
		// Deblocking information per 4x4 block: filter levels (luma
		// vertical, luma horizontal, u, v) and the log2 transform size
		// (luma width, height; chroma width, height in the chroma grid).
		lfLevel         byte[]
		// Deblocking edges per 4x4 and direction (0 none, else the filter
		// class + 1; chroma on the chroma grid), and the transform classes
		// the next block's edges compare with (luma w, h, chroma w, h).
		lfEdgeY         byte[]
		lfEdgeUv        byte[]
		lpfTx           byte[]
		txaW            int[]
		txaH            int[]
		txaStepW        int[]
		txaStepH        int[]
		// Tile.
		colStart        int
		colEnd          int
		rowStart        int
		rowEnd          int
		lastQidx        int
		lastDeltaLf     int[]
		// Block position in 4x4 units.
		bx              int
		by              int
		// Above contexts over the frame width (by absolute 4x4 column)
		// and left contexts over a superblock (by 4x4 row & 31).
		aMode           int[]
		aLcoef          int[]
		aCcoef          int[]
		aSegPred        int[]
		aSkip           int[]
		aSkipMode       int[]
		aIntra          int[]
		aCompType       int[]
		aRef0           int[]
		aRef1           int[]
		aFilter0        int[]
		aFilter1        int[]
		aTxIntra        int[]
		aTx             int[]
		aPartition      int[]
		aUvMode         int[]
		aPalSz          int[]
		aPalSzUv        int[]
		aPal            int[]
		lMode           int[]
		lLcoef          int[]
		lCcoef          int[]
		lSegPred        int[]
		lSkip           int[]
		lSkipMode       int[]
		lIntra          int[]
		lCompType       int[]
		lRef0           int[]
		lRef1           int[]
		lFilter0        int[]
		lFilter1        int[]
		lTxIntra        int[]
		lTx             int[]
		lPartition      int[]
		lUvMode         int[]
		lPalSz          int[]
		lPalSzUv        int[]
		lPal            int[]
		// The block.
		bBl             int
		bBs             int
		bBp             int
		bIntra          bool
		bSegId          int
		bSkipMode       bool
		bSkip           bool
		bTx             int
		bUvtx           int
		bYMode          int
		bUvMode         int
		bPalSz0         int
		bPalSz1         int
		bYAngle         int
		bUvAngle        int
		bCflAlpha0      int
		bCflAlpha1      int
		bMv             int[]
		bWedgeIdx       int
		bMaskSign       int
		bInterintraMode int
		bInterintraType int
		bCompType       int
		bInterMode      int
		bMotionMode     int
		bDrlIdx         int
		bRef0           int
		bRef1           int
		bMaxYtx         int
		bFilter2d       int
		bTxSplit0       int
		bTxSplit1       int
		// Filters of the block (horizontal, vertical).
		bFilter         int[]
		tl4x4Filter     int
		// Local warp: type, matrix and shear (alpha, beta, gamma, delta).
		warpType        int
		warpMat         int[]
		warpAbcd        int[]
		// Current superblock's CDEF indices (index into cdefIdx, per 64x64
		// quadrant).
		sbCdef          int[]
		// Scratch.
		cf              int32[]
		tmp32           int32[]
		levels          int[]
		txtpMap         int[]
		palIdxY         int[]
		palIdxUv        int[]
		palTmp          int[]
		pal             int[]
		palOrder        int[]
		palCtx          int[]
		edgeBuf         int[]
		edgeTmp         int[]
		// Frame-level inter state: reference scale factors and steps (x, y
		// per reference), global warps usable per reference and their
		// shears, compound distance weights [ref0 * 7 + ref1].
		svcScale        int[]
		svcStep         int[]
		gmvWarp         int[]
		gmvAbcd         int[]
		jntW            int[]
		masks           Av1Masks
		emu             uint16[]
		lap             uint16[]
		iiTmp           uint16[]
		tmp0            int32[]
		tmp1            int32[]
		segMask         int[]
		mid             int32[]
		midRows         int[]
		abcdTmp         int[]
		warpTmp         int[]
		rpOk            int[]
		// CDEF: 8x8 blocks with coefficients, the deblocked planes, scratch.
		cdefNoskip      byte[]
		cdefY           uint16[]
		cdefU           uint16[]
		cdefV           uint16[]
		// The CDEF output loop restoration reads, and the post filters'
		// scratch per band.
		lrSrc           uint16[]
		scratch         Av1Scratch[]
		ang             int[]
		ac              int[]
		mvStack         int[]
		mvWeight        int[]
		mvCount         int
		mvCtx           int
		mvs             Av1Mvs
		search          Av1MvSearch
		// Outputs of av1DecodeCoefs.
		coefCtx         int
		coefTxtp        int

		def new() {
			msac = new Av1Msac()
			mvs = new Av1Mvs()
			search = new Av1MvSearch()
			edges = new Av1EdgeTree()
			refs = Av1Frame[]
			dqFrame.len(8 * 3 * 2)
			dq.len(8 * 3 * 2)
			qm.len(3 * av1NRectTxSizes)
			lflvlFrame.len(8 * 4 * 8 * 2)
			lflvl.len(8 * 4 * 8 * 2)
			lastDeltaLf.len(4)
			lrUnits = Av1LrUnit[]
			lrBase.len(3)
			lrW.len(3)
			lrH.len(3)
			lrRef = Av1LrUnit[new Av1LrUnit(), new Av1LrUnit(), new Av1LrUnit()]
			lMode.len(32)
			lLcoef.len(32)
			lCcoef.len(64)
			lSegPred.len(32)
			lSkip.len(32)
			lSkipMode.len(32)
			lIntra.len(32)
			lCompType.len(32)
			lRef0.len(32)
			lRef1.len(32)
			lFilter0.len(32)
			lFilter1.len(32)
			lTxIntra.len(32)
			lTx.len(32)
			lPartition.len(16)
			lUvMode.len(32)
			lPalSz.len(32)
			lPalSzUv.len(32)
			lPal.len(32 * 24)
			bMv.len(4)
			bFilter.len(2)
			warpMat.len(6)
			warpAbcd.len(4)
			sbCdef.len(4)
			cf.len(64 * 64)
			tmp32.len(2 * 64 * 64)
			levels.len(36 * 36)
			txtpMap.len(32 * 32)
			palIdxY.len(64 * 64)
			palIdxUv.len(64 * 64)
			palTmp.len(64 * 64)
			pal.len(3 * 8)
			palOrder.len(64 * 8)
			palCtx.len(64)
			edgeBuf.len(512)
			edgeTmp.len(320)
			svcScale.len(14)
			svcStep.len(14)
			gmvWarp.len(7)
			gmvAbcd.len(28)
			jntW.len(49)
			masks = new Av1Masks()
			emu.len(320 * 280)
			lap.len(64 * 64)
			iiTmp.len(32 * 32)
			tmp0.len(128 * 128)
			tmp1.len(128 * 128)
			segMask.len(128 * 128)
			mid.len(128 * 136)
			midRows.len(8)
			abcdTmp.len(4)
			warpTmp.len(6)
			rpOk.len(7)
			cdefY = uint16[]
			cdefU = uint16[]
			cdefV = uint16[]
			lrSrc = uint16[]
			scratch = Av1Scratch[]
			for let i = 0; i < av1MaxBands; i++ {
				scratch.push(new Av1Scratch())
			}
			ang.len(1)
			txaW.len(32 * 32)
			txaH.len(32 * 32)
			txaStepW.len(32 * 32)
			txaStepH.len(32 * 32)
			ac.len(32 * 32)
			mvStack.len(8 * 4)
			mvWeight.len(8)
		}

		// Allocates the above context and frame maps for the frame.
		def startFrame() {
			let s = seq
			let h = hdr
			bw = ((h.width + 7) >> 3) << 1
			bh = ((h.height + 7) >> 3) << 1
			b4Stride = (bw + 31) & ~31
			sbStep = s.sb128 ?? (32, 16)
			sbShift = s.sb128 ?? (5, 4)
			let n = b4Stride * (((bh + 31) & ~31) + 1)
			let aw = b4Stride + 32
			if aMode.len() != aw {
				aMode.len(aw)
				aLcoef.len(aw)
				aCcoef.len(aw * 2)
				aSegPred.len(aw)
				aSkip.len(aw)
				aSkipMode.len(aw)
				aIntra.len(aw)
				aCompType.len(aw)
				aRef0.len(aw)
				aRef1.len(aw)
				aFilter0.len(aw)
				aFilter1.len(aw)
				aTxIntra.len(aw)
				aTx.len(aw)
				aPartition.len(aw / 2)
				aUvMode.len(aw)
				aPalSz.len(aw)
				aPalSzUv.len(aw)
				aPal.len(aw * 24)
			}
			if rRef0.len() != n {
				rRef0.len(n)
				rRef1.len(n)
				rMvx0.len(n)
				rMvy0.len(n)
				rMvx1.len(n)
				rMvy1.len(n)
				rBs.len(n)
				rMf.len(n)
				curSeg.len(n)
				lfLevel.len(n * 4)
				lfEdgeY.len(n * 2)
				lfEdgeUv.len(n * 2)
				lpfTx.len(n * 4)
			}
			sb64w = (h.width + 63) >> 6
			let sb64h = (h.height + 63) >> 6
			cdefIdx.len(sb64w * sb64h)
			cdefIdx.fill(-1)
			let nsk = (b4Stride >> 1) * ((((bh + 31) & ~31) >> 1) + 16)
			cdefNoskip.len(nsk) when cdefNoskip.len() != nsk
			cdefNoskip.fill(byte(0))
			lfLevel.fill(byte(0))
			lfEdgeY.fill(byte(0))
			lfEdgeUv.fill(byte(0))
		}

		// The frame index of the 4x4 block at (x, y).
		def at(x int, y int) int {
			return y * b4Stride + x
		}

		// Resets the above contexts over the tile's columns
		// (reset_context).
		def resetAbove(keyframe bool) {
			for let x = colStart; x < colEnd + 32 && x < aMode.len(); x++ {
				aIntra[x] = keyframe ?? (1, 0)
				aUvMode[x] = av1DcPred
				aMode[x] = keyframe ?? (av1DcPred, av1Nearestmv)
				aSkip[x] = 0
				aSkipMode[x] = 0
				aTxIntra[x] = -1
				aTx[x] = av1Tx64x64
				aRef0[x] = -1
				aRef1[x] = -1
				aCompType[x] = 0
				aLcoef[x] = 0x40
				aCcoef[x] = 0x40
				aCcoef[aMode.len() + x] = 0x40
				aFilter0[x] = 3
				aFilter1[x] = 3
				aSegPred[x] = 0
				aPalSz[x] = 0
				aPalSzUv[x] = 0
				aPartition[x >> 1] = 0
			}
		}

		def resetLeft(keyframe bool) {
			for let y = 0; y < 32; y++ {
				lIntra[y] = keyframe ?? (1, 0)
				lUvMode[y] = av1DcPred
				lMode[y] = keyframe ?? (av1DcPred, av1Nearestmv)
				lSkip[y] = 0
				lSkipMode[y] = 0
				lTxIntra[y] = -1
				lTx[y] = av1Tx64x64
				lRef0[y] = -1
				lRef1[y] = -1
				lCompType[y] = 0
				lLcoef[y] = 0x40
				lCcoef[y] = 0x40
				lCcoef[32 + y] = 0x40
				lFilter0[y] = 3
				lFilter1[y] = 3
				lSegPred[y] = 0
				lPalSz[y] = 0
				lPalSzUv[y] = 0
			}
			for let y = 0; y < 16; y++ {
				lPartition[y] = 0
			}
		}

		// Decodes the superblock rows of one tile from data[start:end].
		//
		// Fails on a malformed tile.
		def decodeTile(data byte[], start int, end int, tileRow int, tileCol int, initCdf int[]) !none {
			let h = hdr
			colStart = h.colStart[tileCol] << sbShift
			colEnd = h.colStart[tileCol + 1] << sbShift
			colEnd = bw when colEnd > bw
			rowStart = h.rowStart[tileRow] << sbShift
			rowEnd = h.rowStart[tileRow + 1] << sbShift
			rowEnd = bh when rowEnd > bh
			for let i = 0; i < av1CdfSize; i++ {
				msac.cdf[i] = initCdf[i]
			}
			msac.start(data, start, end, h.disableCdfUpdate)
			lastQidx = h.yac
			for let i = 0; i < 4; i++ {
				lastDeltaLf[i] = 0
			}
			for let i = 0; i < dq.len(); i++ {
				dq[i] = dqFrame[i]
			}
			for let i = 0; i < lflvl.len(); i++ {
				lflvl[i] = lflvlFrame[i]
			}
			for let p = 0; p < 3; p++ {
				let r = lrRef[p]
				r.filterV[0] = 3
				r.filterV[1] = -7
				r.filterV[2] = 15
				r.filterH[0] = 3
				r.filterH[1] = -7
				r.filterH[2] = 15
				r.sgrWeights[0] = -32
				r.sgrWeights[1] = 31
			}
			let keyframe = h.isIntra()
			resetAbove(keyframe)
			let root = seq.sb128 ?? (av1Bl128x128, av1Bl64x64)
			let rootNode = seq.sb128 ?? (edges.root128, edges.root64)
			for by = rowStart; by < rowEnd; by += sbStep {
				resetLeft(keyframe)
				for let i = 0; i < 32; i++ {
					lPalSzUv[i] = 0
				}
				for bx = colStart; bx < colEnd; bx += sbStep {
					// CDEF indices of this superblock.
					let c64 = (by >> 4) * sb64w + (bx >> 4)
					if root == av1Bl128x128 {
						sbCdef[0] = c64
						sbCdef[1] = (bx >> 4) + 1 < sb64w ?? (c64 + 1, -1)
						sbCdef[2] = ((by >> 4) + 1) * sb64w < cdefIdx.len() ?? (c64 + sb64w, -1)
						sbCdef[3] = sbCdef[1] >= 0 && sbCdef[2] >= 0 ?? (c64 + sb64w + 1, -1)
					} else {
						sbCdef[0] = c64
					}
					try readRestoration()
					try decodeSb(root, rootNode)
				}
			}
			return none
		}

		// Reads the loop restoration units that start in the superblock
		// (read_restoration_info).
		//
		// Fails never; units of planes without restoration are skipped.
		def readRestoration() !none {
			let h = hdr
			for let p = 0; p < 3; p++ {
				continue when h.lrType[p] == 0
				continue when p > 0 && layout == 0
				let sv = p > 0 ?? (ssVer, 0)
				let sh = p > 0 ?? (ssHor, 0)
				let unitLog2 = h.lrUnit[p > 0 ?? (1, 0)]
				let unit = 1 << unitLog2
				let yy = (by * 4) >> sv
				let ph = (h.height + sv) >> sv
				continue when (yy & (unit - 1)) != 0
				let half = unit >> 1
				continue when yy != 0 && yy + half > ph
				let uy = yy >> unitLog2
				continue when uy >= lrH[p]
				if h.width != h.upscaledWidth {
					let d = h.superResDenom
					let rnd = unit * 8 - 1
					let shift = unitLog2 + 3
					let x0 = (((4 * bx * d) >> sh) + rnd) >> shift
					let x1 = (((4 * (bx + sbStep) * d) >> sh) + rnd) >> shift
					for let x = x0; x < x1 && x < lrW[p]; x++ {
						readLrUnit(p, lrUnits[lrBase[p] + uy * lrW[p] + x])
					}
				} else {
					let xx = (4 * bx) >> sh
					continue when (xx & (unit - 1)) != 0
					let pw = (h.width + sh) >> sh
					continue when xx != 0 && xx + half > pw
					let ux = xx >> unitLog2
					continue when ux >= lrW[p]
					readLrUnit(p, lrUnits[lrBase[p] + uy * lrW[p] + ux])
				}
			}
			return none
		}

		def readLrUnit(p int, lr Av1LrUnit) {
			let frameType = hdr.lrType[p]
			let ref = lrRef[p]
			if frameType == av1Dav1dRestorationSwitchable {
				let f = msac.symbol(av1CdfMRestoreSwitchable, 2)
				lr.kind = f == 0 ?? (av1Dav1dRestorationNone, f == 1 ?? (av1Dav1dRestorationWiener, av1Dav1dRestorationSgrproj))
			} else {
				let on = msac.boolAdapt(frameType == av1Dav1dRestorationWiener ?? (av1CdfMRestoreWiener, av1CdfMRestoreSgrproj))
				lr.kind = on == 1 ?? (frameType, av1Dav1dRestorationNone)
			}
			if lr.kind == av1Dav1dRestorationWiener {
				lr.filterV[0] = p > 0 ?? (0, msac.subexp(ref.filterV[0] + 5, 16, 1) - 5)
				lr.filterV[1] = msac.subexp(ref.filterV[1] + 23, 32, 2) - 23
				lr.filterV[2] = msac.subexp(ref.filterV[2] + 17, 64, 3) - 17
				lr.filterH[0] = p > 0 ?? (0, msac.subexp(ref.filterH[0] + 5, 16, 1) - 5)
				lr.filterH[1] = msac.subexp(ref.filterH[1] + 23, 32, 2) - 23
				lr.filterH[2] = msac.subexp(ref.filterH[2] + 17, 64, 3) - 17
				lr.sgrWeights[0] = ref.sgrWeights[0]
				lr.sgrWeights[1] = ref.sgrWeights[1]
				ref.copyFrom(lr)
			} else if lr.kind == av1Dav1dRestorationSgrproj {
				let idx = msac.bools(4)
				lr.sgrIdx = idx
				lr.sgrWeights[0] = av1SgrParams[idx * 2] != 0 ?? (msac.subexp(ref.sgrWeights[0] + 96, 128, 4) - 96, 0)
				lr.sgrWeights[1] = av1SgrParams[idx * 2 + 1] != 0 ?? (msac.subexp(ref.sgrWeights[1] + 32, 128, 4) - 32, 95)
				for let i = 0; i < 3; i++ {
					lr.filterV[i] = ref.filterV[i]
					lr.filterH[i] = ref.filterH[i]
				}
				ref.copyFrom(lr)
			}
		}

		// get_partition_ctx.
		def partitionCtx(bl int) int {
			let bx8 = bx >> 1
			let by8 = (by & 31) >> 1
			return ((aPartition[bx8] >> (4 - bl)) & 1) + (((lPartition[by8] >> (4 - bl)) & 1) << 1)
		}

		// decode_sb: the partition tree of a block of level `bl`.
		//
		// Fails on a malformed stream.
		def decodeSb(bl int, node int) !none {
			let hsz = 16 >> bl
			let hSplit = bw > bx + hsz
			let vSplit = bh > by + hsz
			if !hSplit && !vSplit {
				try decodeSb(bl + 1, edges.nodes[node * 11 + 7])
				return none
			}
			let n = node * 11
			let pc = av1CdfMPartition + (bl * 4 + partitionCtx(bl)) * 16
			let bp = av1PartitionSplit
			if hSplit && vSplit {
				bp = msac.symbol(pc, av1PartitionTypeCount[bl])
				fail "av1: 4:2:2 partition with a vertical split" when layout == 2 && (bp == av1PartitionV || bp == av1PartitionV4 || bp == av1PartitionTLeftSplit || bp == av1PartitionTRightSplit)
				let b0 = av1BlockSizes[(bl * av1NPartitions + bp) * 2]
				let b1 = av1BlockSizes[(bl * av1NPartitions + bp) * 2 + 1]
				match bp {
					case 0:
						try decodeB(bl, b0, bp, edges.nodes[n])
					case 1:
						try decodeB(bl, b0, bp, edges.nodes[n + 1])
						by += hsz
						try decodeB(bl, b0, bp, edges.nodes[n + 2])
						by -= hsz
					case 2:
						try decodeB(bl, b0, bp, edges.nodes[n + 3])
						bx += hsz
						try decodeB(bl, b0, bp, edges.nodes[n + 4])
						bx -= hsz
					case 3:
						if bl == av1Bl8x8 {
							try decodeB(bl, av1Bs4x4, bp, av1EdgeAllTrAndBl)
							let tlFilter = tl4x4Filter
							bx++
							try decodeB(bl, av1Bs4x4, bp, edges.nodes[n + 7])
							bx--
							by++
							try decodeB(bl, av1Bs4x4, bp, edges.nodes[n + 8])
							bx++
							tl4x4Filter = tlFilter
							try decodeB(bl, av1Bs4x4, bp, edges.nodes[n + 9])
							bx--
							by--
						} else {
							try decodeSb(bl + 1, edges.nodes[n + 7])
							bx += hsz
							try decodeSb(bl + 1, edges.nodes[n + 8])
							bx -= hsz
							by += hsz
							try decodeSb(bl + 1, edges.nodes[n + 9])
							bx += hsz
							try decodeSb(bl + 1, edges.nodes[n + 10])
							bx -= hsz
							by -= hsz
						}
					case 4:
						try decodeB(bl, b0, bp, av1EdgeAllTrAndBl)
						bx += hsz
						try decodeB(bl, b0, bp, edges.nodes[n + 4])
						bx -= hsz
						by += hsz
						try decodeB(bl, b1, bp, edges.nodes[n + 2])
						by -= hsz
					case 5:
						try decodeB(bl, b0, bp, edges.nodes[n + 1])
						by += hsz
						try decodeB(bl, b1, bp, edges.nodes[n + 3])
						bx += hsz
						try decodeB(bl, b1, bp, 0)
						bx -= hsz
						by -= hsz
					case 6:
						try decodeB(bl, b0, bp, av1EdgeAllTrAndBl)
						by += hsz
						try decodeB(bl, b0, bp, edges.nodes[n + 2])
						by -= hsz
						bx += hsz
						try decodeB(bl, b1, bp, edges.nodes[n + 4])
						bx -= hsz
					case 7:
						try decodeB(bl, b0, bp, edges.nodes[n + 3])
						bx += hsz
						try decodeB(bl, b1, bp, edges.nodes[n + 1])
						by += hsz
						try decodeB(bl, b1, bp, 0)
						by -= hsz
						bx -= hsz
					case 8:
						try decodeB(bl, b0, bp, edges.nodes[n + 1])
						by += hsz >> 1
						try decodeB(bl, b0, bp, edges.nodes[n + 5])
						by += hsz >> 1
						try decodeB(bl, b0, bp, av1EdgeAllLeftHasBottom)
						by += hsz >> 1
						if by < bh {
							try decodeB(bl, b0, bp, edges.nodes[n + 2])
						}
						by -= (hsz * 3) >> 1
					default:
						try decodeB(bl, b0, bp, edges.nodes[n + 3])
						bx += hsz >> 1
						try decodeB(bl, b0, bp, edges.nodes[n + 6])
						bx += hsz >> 1
						try decodeB(bl, b0, bp, av1EdgeAllTopHasRight)
						bx += hsz >> 1
						if bx < bw {
							try decodeB(bl, b0, bp, edges.nodes[n + 4])
						}
						bx -= (hsz * 3) >> 1
				}
			} else if hSplit {
				// Only the top half is inside: split or horizontal.
				let pr = msac.cdf[pc + av1PartitionV - 1] - msac.cdf[pc + av1PartitionTTopSplit]
				pr += msac.cdf[pc + av1PartitionTLeftSplit - 1]
				pr += msac.cdf[pc + av1PartitionV4 - 1] - msac.cdf[pc + av1PartitionTRightSplit] when bl != av1Bl128x128
				let split = msac.boolProb(pr) == 1
				if split {
					try decodeSb(bl + 1, edges.nodes[n + 7])
					bx += hsz
					try decodeSb(bl + 1, edges.nodes[n + 8])
					bx -= hsz
				} else {
					bp = av1PartitionH
					try decodeB(bl, av1BlockSizes[(bl * av1NPartitions + av1PartitionH) * 2], bp, edges.nodes[n + 1])
				}
			} else {
				let pr = msac.cdf[pc + av1PartitionH - 1] - msac.cdf[pc + av1PartitionH]
				pr += msac.cdf[pc + av1PartitionSplit - 1] - msac.cdf[pc + av1PartitionTLeftSplit]
				pr += msac.cdf[pc + av1PartitionH4 - 1] - msac.cdf[pc + av1PartitionH4] when bl != av1Bl128x128
				let split = msac.boolProb(pr) == 1
				fail "av1: 4:2:2 partition with a vertical split" when layout == 2 && !split
				if split {
					try decodeSb(bl + 1, edges.nodes[n + 7])
					by += hsz
					try decodeSb(bl + 1, edges.nodes[n + 9])
					by -= hsz
				} else {
					bp = av1PartitionV
					try decodeB(bl, av1BlockSizes[(bl * av1NPartitions + av1PartitionV) * 2], bp, edges.nodes[n + 3])
				}
			}
			if bp != av1PartitionSplit || bl == av1Bl8x8 {
				let bx8 = bx >> 1
				let by8 = (by & 31) >> 1
				let va = av1AlPartCtx[bl * av1NPartitions + bp]
				let vl = av1AlPartCtx[(av1NBlLevels + bl) * av1NPartitions + bp]
				for let i = 0; i < hsz; i++ {
					aPartition[bx8 + i] = va
					lPartition[(by8 + i) & 15] = vl
				}
			}
			return none
		}

		def fillA(arr int[], x int, n int, v int) {
			for let i = 0; i < n; i++ {
				arr[x + i] = v
			}
		}

		def fillL(arr int[], y int, n int, v int) {
			for let i = 0; i < n; i++ {
				arr[(y + i) & 31] = v
			}
		}

		// The segment id predicted from the primary reference: the lowest
		// id over the block (get_prev_frame_segid).
		def prevSegId(w4 int, h4 int) int {
			return 0 unless hasPrevSeg
			let id = 8
			for let y = 0; y < h4 && id > 0; y++ {
				for let x = 0; x < w4; x++ {
					let v = int(prevSeg[at(bx + x, by + y)])
					id = v when v < id
				}
			}
			return id
		}

		// The segment id predicted from this frame's neighbours and its
		// context (get_cur_frame_segid): returns id * 4 + ctx.
		def curSegIdCtx(haveTop bool, haveLeft bool) int {
			let k = at(bx, by)
			if haveLeft && haveTop {
				let l = int(curSeg[k - 1])
				let a = int(curSeg[k - b4Stride])
				let al = int(curSeg[k - b4Stride - 1])
				let ctx = (l == a && al == l) ?? (2, (l == a || al == l || a == al) ?? (1, 0))
				return (a == al ?? (a, l)) * 4 + ctx
			}
			return int(curSeg[k - 1]) * 4 when haveLeft
			return int(curSeg[k - b4Stride]) * 4 when haveTop
			return 0
		}

		def negDeinterleave(diff int, ref int, max int) int {
			return diff when ref == 0
			return max - diff - 1 when ref >= max - 1
			if 2 * ref < max {
				return (diff & 1) != 0 ?? (ref + ((diff + 1) >> 1), ref - (diff >> 1)) when diff <= 2 * ref
				return diff
			}
			return (diff & 1) != 0 ?? (ref + ((diff + 1) >> 1), ref - (diff >> 1)) when diff <= 2 * (max - ref - 1)
			return max - (diff + 1)
		}

		def readSegId(diffCtx int) int {
			return msac.symbol(av1CdfMSegId + diffCtx * 8, 7)
		}

		// decode_b: one block's syntax and reconstruction.
		//
		// Fails on a malformed stream.
		def decodeB(bl int, bs int, bp int, edgeFlags int) !none {
			let h = hdr
			let bw4 = av1BlockDims[bs * 4]
			let bh4 = av1BlockDims[bs * 4 + 1]
			let lw = av1BlockDims[bs * 4 + 2]
			let lh = av1BlockDims[bs * 4 + 3]
			let by4 = by & 31
			let cbx4 = bx >> ssHor
			let cby4 = by4 >> ssVer
			let w4 = bw4 < bw - bx ?? (bw4, bw - bx)
			let h4 = bh4 < bh - by ?? (bh4, bh - by)
			let cbw4 = (bw4 + ssHor) >> ssHor
			let cbh4 = (bh4 + ssVer) >> ssVer
			let haveLeft = bx > colStart
			let haveTop = by > rowStart
			let hasChroma = layout != 0 && (bw4 > ssHor || (bx & 1) != 0) && (bh4 > ssVer || (by & 1) != 0)
			bBl = bl
			bBp = bp
			bBs = bs
			bSegId = 0
			let segSet = false
			let segPred = 0
			if h.segEnabled {
				if !h.segUpdateMap {
					bSegId = prevSegId(w4, h4)
					fail "av1: bad segment id" when bSegId >= 8
					segSet = true
				} else if h.segPreskip {
					if h.segTemporal && msac.boolAdapt(av1CdfMSegPred + (aSegPred[bx] + lSegPred[by4]) * 2) == 1 {
						segPred = 1
						bSegId = prevSegId(w4, h4)
						fail "av1: bad segment id" when bSegId >= 8
					} else {
						let pc = curSegIdCtx(haveTop, haveLeft)
						let diff = readSegId(pc & 3)
						bSegId = negDeinterleave(diff, pc >> 2, h.segLastActive + 1)
						bSegId = 0 when bSegId > h.segLastActive || bSegId >= 8
					}
					segSet = true
				}
			}
			let segRef = segSet ?? (h.segRef[bSegId], -1)
			let segSkip = segSet && h.segSkip[bSegId]
			let segGlobal = segSet && h.segGlobalMv[bSegId]
			bSkipMode = false
			bSkipMode = msac.boolAdapt(av1CdfMSkipMode + (aSkipMode[bx] + lSkipMode[by4]) * 2) == 1 when (!segSet || (!segGlobal && segRef == -1 && !segSkip)) && h.skipModeEnabled && (bw4 < bh4 ?? (bw4, bh4)) > 1
			if bSkipMode || segSkip {
				bSkip = true
			} else {
				bSkip = msac.boolAdapt(av1CdfMSkip + (aSkip[bx] + lSkip[by4]) * 2) == 1
			}
			if h.segEnabled && h.segUpdateMap && !h.segPreskip {
				if !bSkip && h.segTemporal && msac.boolAdapt(av1CdfMSegPred + (aSegPred[bx] + lSegPred[by4]) * 2) == 1 {
					segPred = 1
					bSegId = prevSegId(w4, h4)
					fail "av1: bad segment id" when bSegId >= 8
				} else {
					let pc = curSegIdCtx(haveTop, haveLeft)
					if bSkip {
						bSegId = pc >> 2
					} else {
						let diff = readSegId(pc & 3)
						bSegId = negDeinterleave(diff, pc >> 2, h.segLastActive + 1)
						bSegId = 0 when bSegId > h.segLastActive
					}
					bSegId = 0 when bSegId >= 8
				}
				segSet = true
				segRef = h.segRef[bSegId]
				segSkip = h.segSkip[bSegId]
				segGlobal = h.segGlobalMv[bSegId]
			}
			// CDEF index.
			if !bSkip {
				let idx = seq.sb128 ?? (((bx & 16) >> 4) + ((by & 16) >> 3), 0)
				let c = sbCdef[idx]
				if c >= 0 && cdefIdx[c] == -1 {
					let v = msac.bools(h.cdefBits)
					cdefIdx[c] = v
					if seq.sb128 {
						cdefIdx[sbCdef[idx + 1]] = v when bw4 > 16 && sbCdef[idx + 1] >= 0
						cdefIdx[sbCdef[idx + 2]] = v when bh4 > 16 && idx + 2 < 4 && sbCdef[idx + 2] >= 0
						cdefIdx[sbCdef[3]] = v when bw4 == 32 && bh4 == 32 && sbCdef[3] >= 0
					}
				}
			}
			// Delta q and lf at the superblock start.
			if ((bx | by) & (31 >> (seq.sb128 ?? (0, 1)))) == 0 {
				let prevQidx = lastQidx
				let haveDeltaQ = h.deltaQ && (bs != (seq.sb128 ?? (av1Bs128x128, av1Bs64x64)) || !bSkip)
				let prevLf = lastDeltaLf[0] | (lastDeltaLf[1] << 8) | (lastDeltaLf[2] << 16) | (lastDeltaLf[3] << 24)
				if haveDeltaQ {
					let dqv = msac.symbol(av1CdfMDeltaQ, 3)
					if dqv == 3 {
						let nb = 1 + msac.bools(3)
						dqv = msac.bools(nb) + 1 + (1 << nb)
					}
					if dqv != 0 {
						dqv = -dqv when msac.boolEqui() == 1
						dqv = dqv * (1 << h.deltaQRes)
					}
					let q = lastQidx + dqv
					lastQidx = q < 1 ?? (1, q > 255 ?? (255, q))
					if h.deltaLf {
						let nLfs = h.deltaLfMulti ?? ((layout != 0 ?? (4, 2)), 1)
						for let i = 0; i < nLfs; i++ {
							let ctxOff = i + (h.deltaLfMulti ?? (1, 0))
							let d = msac.symbol(av1CdfMDeltaLf + ctxOff * 4, 3)
							if d == 3 {
								let nb = 1 + msac.bools(3)
								d = msac.bools(nb) + 1 + (1 << nb)
							}
							if d != 0 {
								d = -d when msac.boolEqui() == 1
								d = d * (1 << h.deltaLfRes)
							}
							let v = lastDeltaLf[i] + d
							lastDeltaLf[i] = v < -63 ?? (-63, v > 63 ?? (63, v))
						}
					}
				}
				if lastQidx == h.yac {
					for let i = 0; i < dq.len(); i++ {
						dq[i] = dqFrame[i]
					}
				} else if lastQidx != prevQidx {
					av1InitDq(self, lastQidx, dq)
				}
				let curLf = lastDeltaLf[0] | (lastDeltaLf[1] << 8) | (lastDeltaLf[2] << 16) | (lastDeltaLf[3] << 24)
				if lastDeltaLf[0] == 0 && lastDeltaLf[1] == 0 && lastDeltaLf[2] == 0 && lastDeltaLf[3] == 0 {
					for let i = 0; i < lflvl.len(); i++ {
						lflvl[i] = lflvlFrame[i]
					}
				} else if curLf != prevLf {
					av1CalcLfValues(self, lflvl, lastDeltaLf)
				}
			}
			if bSkipMode {
				bIntra = false
			} else if !h.isIntra() {
				if segSet && (segRef >= 0 || segGlobal) {
					bIntra = segRef == 0
				} else {
					let ictx = av1IntraCtx(self, haveTop, haveLeft)
					bIntra = msac.boolAdapt(av1CdfMIntra + ictx * 2) == 0
				}
			} else if h.allowIntrabc {
				bIntra = msac.boolAdapt(av1CdfMIntrabc) == 0
			} else {
				bIntra = true
			}
			if bIntra {
				try intraBlock(bs, bw4, bh4, lw, lh, w4, h4, cbw4, cbh4, cbx4, cby4, hasChroma, edgeFlags, segPred)
			} else if h.isIntra() {
				try intrabcBlock(bs, bw4, bh4, lw, lh, cbw4, cbh4, cbx4, cby4, hasChroma, edgeFlags, segPred)
			} else {
				try interBlock(bs, bw4, bh4, lw, lh, w4, h4, cbw4, cbh4, cbx4, cby4, hasChroma, haveTop, haveLeft, edgeFlags, segPred, segSet, segRef, segSkip, segGlobal)
			}
			if h.segEnabled && h.segUpdateMap {
				for let y = 0; y < bh4; y++ {
					let o = at(bx, by + y)
					for let x = 0; x < bw4; x++ {
						curSeg[o + x] = byte(bSegId)
					}
				}
			}
			return none
		}

		// Intra block syntax (y and uv modes, angles, CFL, palette, filter
		// intra, transform size) and reconstruction.
		//
		// Fails on a malformed stream.
		def intraBlock(bs int, bw4 int, bh4 int, lw int, lh int, w4 int, h4 int, cbw4 int, cbh4 int, cbx4 int, cby4 int, hasChroma bool, edgeFlags int, segPred int) !none {
			let h = hdr
			let by4 = by & 31
			let ymodeCdf = !h.isIntra() ?? (av1CdfMYMode + av1YModeSizeCtx[bs] * 16, av1CdfKfym + (av1IntraModeCtx[aMode[bx]] * 5 + av1IntraModeCtx[lMode[by4]]) * 16)
			bYMode = msac.symbol(ymodeCdf, av1NIntraPredModes - 1)
			bYAngle = 0
			bYAngle = msac.symbol(av1CdfMAngleDelta + (bYMode - av1VertPred) * 8, 6) - 3 when lw + lh >= 2 && bYMode >= av1VertPred && bYMode <= av1VertLeftPred
			bUvMode = av1DcPred
			bUvAngle = 0
			bCflAlpha0 = 0
			bCflAlpha1 = 0
			if hasChroma {
				let cflAllowed = h.segLossless[bSegId] ?? (cbw4 == 1 && cbh4 == 1, ((av1CflAllowedMask >> bs) & 1) != 0)
				let ci = cflAllowed ?? (1, 0)
				bUvMode = msac.symbol(av1CdfMUvMode + (ci * av1NIntraPredModes + bYMode) * 16, av1NUvIntraPredModes - 1 - (cflAllowed ?? (0, 1)))
				if bUvMode == av1CflPred {
					let sign = msac.symbol(av1CdfMCflSign, 7) + 1
					let signU = (sign * 0x56) >> 8
					let signV = sign - signU * 3
					if signU != 0 {
						let ctx = (signU == 2 ?? (3, 0)) + signV
						bCflAlpha0 = msac.symbol(av1CdfMCflAlpha + ctx * 16, 15) + 1
						bCflAlpha0 = -bCflAlpha0 when signU == 1
					}
					if signV != 0 {
						let ctx = (signV == 2 ?? (3, 0)) + signU
						bCflAlpha1 = msac.symbol(av1CdfMCflAlpha + ctx * 16, 15) + 1
						bCflAlpha1 = -bCflAlpha1 when signV == 1
					}
				} else if lw + lh >= 2 && bUvMode >= av1VertPred && bUvMode <= av1VertLeftPred {
					bUvAngle = msac.symbol(av1CdfMAngleDelta + (bUvMode - av1VertPred) * 8, 6) - 3
				}
			}
			bPalSz0 = 0
			bPalSz1 = 0
			if h.allowScreenContent && (bw4 > bh4 ?? (bw4, bh4)) <= 16 && bw4 + bh4 >= 4 {
				let szCtx = lw + lh - 2
				if bYMode == av1DcPred {
					let pctx = (aPalSz[bx] > 0 ?? (1, 0)) + (lPalSz[by4] > 0 ?? (1, 0))
					readPalPlane(0, szCtx) when msac.boolAdapt(av1CdfMPalY + (szCtx * 3 + pctx) * 2) == 1
				}
				if hasChroma && bUvMode == av1DcPred {
					readPalUv(szCtx) when msac.boolAdapt(av1CdfMPalUv + (bPalSz0 > 0 ?? (1, 0)) * 2) == 1
				}
			}
			if bYMode == av1DcPred && bPalSz0 == 0 && (lw > lh ?? (lw, lh)) <= 3 && seq.filterIntra {
				if msac.boolAdapt(av1CdfMUseFilterIntra + bs * 2) == 1 {
					bYMode = av1FilterPred
					bYAngle = msac.symbol(av1CdfMFilterIntra, 4)
				}
			}
			readPalIndices(palIdxY, bPalSz0, 0, w4, h4, bw4, bh4) when bPalSz0 > 0
			if hasChroma && bPalSz1 > 0 {
				let cw4 = (w4 + ssHor) >> ssHor
				let ch4 = (h4 + ssVer) >> ssVer
				readPalIndices(palIdxUv, bPalSz1, 1, cw4, ch4, cbw4, cbh4)
			}
			if h.segLossless[bSegId] {
				bTx = av1Tx4x4
				bUvtx = av1Tx4x4
			} else {
				bTx = av1MaxTxSize[bs * 4]
				bUvtx = av1MaxTxSize[bs * 4 + layout]
				if h.txMode == av1TxSwitchable && av1TxDims[bTx * 8 + 5] > av1Tx4x4 {
					let mx = av1TxDims[bTx * 8 + 5]
					let tctx = (lTxIntra[by4] >= av1TxDims[bTx * 8 + 3] ?? (1, 0)) + (aTxIntra[bx] >= av1TxDims[bTx * 8 + 2] ?? (1, 0))
					let depth = msac.symbol(av1CdfMTxsz + ((mx - 1) * 3 + tctx) * 4, mx < 2 ?? (mx, 2))
					for let i = 0; i < depth; i++ {
						bTx = av1TxDims[bTx * 8 + 6]
					}
				}
			}
			try av1ReconIntra(self, bs, edgeFlags)
			av1LfMaskIntra(self, bs, bTx, bUvtx, hasChroma) when h.lfLevelY[0] != 0 || h.lfLevelY[1] != 0
			let modeNoFilt = bYMode == av1FilterPred ?? (av1DcPred, bYMode)
			let tlw = av1TxDims[bTx * 8 + 2]
			let tlh = av1TxDims[bTx * 8 + 3]
			let inter = !hdr.isIntra()
			let palUv = hasChroma ?? (bPalSz1, 0)
			fillA(aTxIntra, bx, bw4, tlw)
			fillA(aTx, bx, bw4, tlw)
			fillA(aMode, bx, bw4, modeNoFilt)
			fillA(aPalSz, bx, bw4, bPalSz0)
			fillA(aSegPred, bx, bw4, segPred)
			fillA(aSkipMode, bx, bw4, 0)
			fillA(aIntra, bx, bw4, 1)
			fillA(aSkip, bx, bw4, bSkip ?? (1, 0))
			fillA(aPalSzUv, bx, bw4, palUv)
			fillL(lTxIntra, by4, bh4, tlh)
			fillL(lTx, by4, bh4, tlh)
			fillL(lMode, by4, bh4, modeNoFilt)
			fillL(lPalSz, by4, bh4, bPalSz0)
			fillL(lSegPred, by4, bh4, segPred)
			fillL(lSkipMode, by4, bh4, 0)
			fillL(lIntra, by4, bh4, 1)
			fillL(lSkip, by4, bh4, bSkip ?? (1, 0))
			fillL(lPalSzUv, by4, bh4, palUv)
			if inter {
				fillA(aCompType, bx, bw4, 0)
				fillA(aRef0, bx, bw4, -1)
				fillA(aRef1, bx, bw4, -1)
				fillA(aFilter0, bx, bw4, 3)
				fillA(aFilter1, bx, bw4, 3)
				fillL(lCompType, by4, bh4, 0)
				fillL(lRef0, by4, bh4, -1)
				fillL(lRef1, by4, bh4, -1)
				fillL(lFilter0, by4, bh4, 3)
				fillL(lFilter1, by4, bh4, 3)
			}
			copyPal(0, bw4, bh4) when bPalSz0 > 0
			if hasChroma {
				fillA(aUvMode, cbx4, cbw4, bUvMode)
				fillL(lUvMode, cby4, cbh4, bUvMode)
				if bPalSz1 > 0 {
					copyPal(1, bw4, bh4)
					copyPal(2, bw4, bh4)
				}
			}
			splatIntra(bs, bw4, bh4) when inter || hdr.allowIntrabc
			return none
		}

		// The motion field entries of an intra block (splat_intraref).
		def splatIntra(bs int, bw4 int, bh4 int) {
			splatMv8(bs, bw4, bh4, 0, -1, 0, av1InvalidMv, av1InvalidMv, 0, 0)
		}

		// The motion field entries of an inter block.
		def splatMv(bs int, bw4 int, bh4 int, ref0 int, ref1 int, mf int) {
			splatMv8(bs, bw4, bh4, ref0, ref1, mf, bMv[0], bMv[1], bMv[2], bMv[3])
		}

		// Fills the motion field over the block, eight entries per vector.
		def splatMv8(bs int, bw4 int, bh4 int, ref0 int, ref1 int, mf int, x0 int, y0 int, x1 int, y1 int) {
			if (bw4 & 7) == 0 {
				let r0 = simd.splat8<int8>(int8(ref0))
				let r1 = simd.splat8<int8>(int8(ref1))
				let mx0 = simd.splat8<int16>(int16(x0))
				let my0 = simd.splat8<int16>(int16(y0))
				let mx1 = simd.splat8<int16>(int16(x1))
				let my1 = simd.splat8<int16>(int16(y1))
				let vb = simd.splat8<byte>(byte(bs))
				let vf = simd.splat8<byte>(byte(mf))
				for let y = 0; y < bh4; y++ {
					let o = at(bx, by + y)
					for let x = 0; x < bw4; x += 8 {
						simd.store8<int8>(rRef0, o + x, r0)
						simd.store8<int8>(rRef1, o + x, r1)
						simd.store8<int16>(rMvx0, o + x, mx0)
						simd.store8<int16>(rMvy0, o + x, my0)
						simd.store8<int16>(rMvx1, o + x, mx1)
						simd.store8<int16>(rMvy1, o + x, my1)
						simd.store8<byte>(rBs, o + x, vb)
						simd.store8<byte>(rMf, o + x, vf)
					}
				}
				return
			}
			for let y = 0; y < bh4; y++ {
				let o = at(bx, by + y)
				for let x = 0; x < bw4; x++ {
					rRef0[o + x] = int8(ref0)
					rRef1[o + x] = int8(ref1)
					rMvx0[o + x] = int16(x0)
					rMvy0[o + x] = int16(y0)
					rMvx1[o + x] = int16(x1)
					rMvy1[o + x] = int16(y1)
					rBs[o + x] = byte(bs)
					rMf[o + x] = byte(mf)
				}
			}
		}

		// Palette colours of plane `pl` into the above/left caches
		// (copy_pal_block_y/uv).
		def copyPal(pl int, bw4 int, bh4 int) {
			let by4 = by & 31
			for let x = 0; x < bw4; x++ {
				for let k = 0; k < 8; k++ {
					aPal[(bx + x) * 24 + pl * 8 + k] = pal[pl * 8 + k]
				}
			}
			for let y = 0; y < bh4; y++ {
				for let k = 0; k < 8; k++ {
					lPal[((by4 + y) & 31) * 24 + pl * 8 + k] = pal[pl * 8 + k]
				}
			}
		}

		// read_pal_plane: the palette of plane `pl` (0 luma, 1 u).
		def readPalPlane(pl int, szCtx int) {
			let by4 = by & 31
			let size = msac.symbol(av1CdfMPalSz + (pl * 7 + szCtx) * 8, 6) + 2
			if pl == 0 {
				bPalSz0 = size
			} else {
				bPalSz1 = size
			}
			let cache int[]
			cache.len(16)
			let used int[]
			used.len(8)
			let lCount = pl > 0 ?? (lPalSzUv[by4], lPalSz[by4])
			let aCount = (by4 & 15) != 0 ?? ((pl > 0 ?? (aPalSzUv[bx], aPalSz[bx])), 0)
			let li = ((by4 & 31) * 24) + pl * 8
			let ai = bx * 24 + pl * 8
			let n = 0
			for lCount > 0 && aCount > 0 {
				let lv = lPal[li]
				let av = aPal[ai]
				if lv < av {
					if n == 0 || cache[n - 1] != lv {
						cache[n] = lv
						n++
					}
					li++
					lCount--
				} else {
					if av == lv {
						li++
						lCount--
					}
					if n == 0 || cache[n - 1] != av {
						cache[n] = av
						n++
					}
					ai++
					aCount--
				}
			}
			for lCount > 0 {
				let lv = lPal[li]
				if n == 0 || cache[n - 1] != lv {
					cache[n] = lv
					n++
				}
				li++
				lCount--
			}
			for aCount > 0 {
				let av = aPal[ai]
				if n == 0 || cache[n - 1] != av {
					cache[n] = av
					n++
				}
				ai++
				aCount--
			}
			let i = 0
			for let k = 0; k < n && i < size; k++ {
				if msac.boolEqui() == 1 {
					used[i] = cache[k]
					i++
				}
			}
			let nUsed = i
			let base = pl * 8
			if i < size {
				let bpc = bitDepth
				let prev = msac.bools(bpc)
				pal[base + i] = prev
				i++
				if i < size {
					let bits = bpc - 3 + msac.bools(2)
					let max = (1 << bpc) - 1
					let minus = pl == 0 ?? (1, 0)
					for i < size {
						let delta = msac.bools(bits)
						prev = prev + delta + minus
						prev = max when prev > max
						pal[base + i] = prev
						i++
						if prev + minus >= max {
							for i < size {
								pal[base + i] = max
								i++
							}
							break
						}
						let lim = 1 + av1Log2(max - prev - minus)
						bits = lim when lim < bits
					}
				}
				// Merge the cache and the new entries.
				let merged int[]
				merged.len(8)
				let k = 0
				let m = nUsed
				for let j = 0; j < size; j++ {
					if k < nUsed && (m >= size || used[k] <= pal[base + m]) {
						merged[j] = used[k]
						k++
					} else {
						merged[j] = pal[base + m]
						m++
					}
				}
				for let j = 0; j < size; j++ {
					pal[base + j] = merged[j]
				}
			} else {
				for let j = 0; j < nUsed; j++ {
					pal[base + j] = used[j]
				}
			}
		}

		// read_pal_uv: the u palette then the v palette.
		def readPalUv(szCtx int) {
			readPalPlane(1, szCtx)
			let bpc = bitDepth
			if msac.boolEqui() == 1 {
				let bits = bpc - 4 + msac.bools(2)
				let prev = msac.bools(bpc)
				pal[16] = prev
				let max = (1 << bpc) - 1
				for let i = 1; i < bPalSz1; i++ {
					let delta = msac.bools(bits)
					delta = -delta when delta != 0 && msac.boolEqui() == 1
					prev = (prev + delta) & max
					pal[16 + i] = prev
				}
			} else {
				for let i = 0; i < bPalSz1; i++ {
					pal[16 + i] = msac.bools(bpc)
				}
			}
		}

		// read_pal_indices: the colour index map in wavefront order, into
		// `out` (row stride bw4 * 4, padded to the block).
		def readPalIndices(out int[], size int, pl int, w4 int, h4 int, bw4 int, bh4 int) {
			let stride = bw4 * 4
			let tmp = palTmp
			// uniform(size)
			let l = av1Log2(size) + 1
			let m = (1 << l) - size
			let v = msac.bools(l - 1)
			tmp[0] = v < m ?? (v, (v << 1) - m + msac.boolEqui())
			let cdfBase = av1CdfMColorMap + (pl * 7 + (size - 2)) * 5 * 8
			for let i = 1; i < 4 * (w4 + h4) - 1; i++ {
				let first = i < w4 * 4 - 1 ?? (i, w4 * 4 - 1)
				let last = i - h4 * 4 + 1 > 0 ?? (i - h4 * 4 + 1, 0)
				orderPalette(tmp, stride, i, first, last)
				let mi = 0
				for let j = first; j >= last; j-- {
					let ci = msac.symbol(cdfBase + palCtx[mi] * 8, size - 1)
					tmp[(i - j) * stride + j] = palOrder[mi * 8 + ci]
					mi++
				}
			}
			// pal_idx_finish: pad to the block.
			let blockW = bw4 * 4
			let bhh = bh4 * 4
			let w = w4 * 4
			let hh = h4 * 4
			for let y = 0; y < hh; y++ {
				for let x = 0; x < blockW; x++ {
					out[y * blockW + x] = x < w ?? (tmp[y * stride + x], tmp[y * stride + w - 1])
				}
			}
			for let y = hh; y < bhh; y++ {
				for let x = 0; x < blockW; x++ {
					out[y * blockW + x] = out[(hh - 1) * blockW + x]
				}
			}
		}

		def orderPalette(idx int[], stride int, i int, first int, last int) {
			let haveTop = i > first
			let p = first + (i - first) * stride
			let n = 0
			for let j = first; j >= last; j-- {
				let haveLeft = j > 0
				let mask = 0
				let o = 0
				let base = n * 8
				if !haveLeft {
					palCtx[n] = 0
					let t = idx[p - stride]
					palOrder[base + o] = t
					o++
					mask = mask | (1 << t)
				} else if !haveTop {
					palCtx[n] = 0
					let l = idx[p - 1]
					palOrder[base + o] = l
					o++
					mask = mask | (1 << l)
				} else {
					let l = idx[p - 1]
					let t = idx[p - stride]
					let tl = idx[p - stride - 1]
					let sameTL = t == l
					let sameTTl = t == tl
					let sameLTl = l == tl
					if sameTL && sameTTl && sameLTl {
						palCtx[n] = 4
						palOrder[base + o] = t
						o++
						mask = mask | (1 << t)
					} else if sameTL {
						palCtx[n] = 3
						palOrder[base + o] = t
						palOrder[base + o + 1] = tl
						o += 2
						mask = mask | (1 << t) | (1 << tl)
					} else if sameTTl || sameLTl {
						palCtx[n] = 2
						let other = sameTTl ?? (l, t)
						palOrder[base + o] = tl
						palOrder[base + o + 1] = other
						o += 2
						mask = mask | (1 << tl) | (1 << other)
					} else {
						palCtx[n] = 1
						let lo = t < l ?? (t, l)
						let hi = t < l ?? (l, t)
						palOrder[base + o] = lo
						palOrder[base + o + 1] = hi
						palOrder[base + o + 2] = tl
						o += 3
						mask = mask | (1 << lo) | (1 << hi) | (1 << tl)
					}
				}
				for let bit = 0; bit < 8; bit++ {
					if (mask & (1 << bit)) == 0 {
						palOrder[base + o] = bit
						o++
					}
				}
				haveTop = true
				n++
				p += stride - 1
			}
		}

		def drlCtx(idx int) int {
			return mvWeight[idx + 1] < 640 ?? (1, 0) when mvWeight[idx] >= 640
			return mvWeight[idx + 1] < 640 ?? (2, 0)
		}

		// read_mv_component_diff.
		def mvComponent(comp int, prec int) int {
			let base = comp == 0 ?? (av1CdfMvComp0Classes, av1CdfMvComp1Classes)
			let off = base - av1CdfMvComp0Classes
			let sign = msac.boolAdapt(av1CdfMvComp0Sign + off)
			let cl = msac.symbol(av1CdfMvComp0Classes + off, 10)
			let up = 0
			let fp = 3
			let hp = 1
			if cl == 0 {
				up = msac.boolAdapt(av1CdfMvComp0Class0 + off)
				if prec >= 0 {
					fp = msac.symbol(av1CdfMvComp0Class0Fp + off + up * 4, 3)
					hp = msac.boolAdapt(av1CdfMvComp0Class0Hp + off) when prec > 0
				}
			} else {
				up = 1 << cl
				for let n = 0; n < cl; n++ {
					up = up | (msac.boolAdapt(av1CdfMvComp0ClassN + off + n * 2) << n)
				}
				if prec >= 0 {
					fp = msac.symbol(av1CdfMvComp0ClassNFp + off, 3)
					hp = msac.boolAdapt(av1CdfMvComp0ClassNHp + off) when prec > 0
				}
			}
			let diff = ((up << 3) | (fp << 1) | hp) + 1
			return sign == 1 ?? (-diff, diff)
		}

		// read_mv_residual into bMv[i * 2..].
		def mvResidual(i int, prec int) {
			let joint = msac.symbol(av1CdfMvJoint, av1NMvJoints - 1)
			bMv[i * 2 + 1] = av1Int16(bMv[i * 2 + 1] + mvComponent(0, prec)) when (joint & av1MvJointV) != 0
			bMv[i * 2] = av1Int16(bMv[i * 2] + mvComponent(1, prec)) when (joint & av1MvJointH) != 0
		}

		// read_tx_tree: the var-tx split of the transform at the block
		// offset, into the tx context and bTxSplit0/1.
		def readTxTree(from int, depth int, xOff int, yOff int) {
			let by4 = by & 31
			let d = from * 8
			let txw = av1TxDims[d + 2]
			let txh = av1TxDims[d + 3]
			let split = false
			if depth < 2 && from > av1Tx4x4 {
				let cat = 2 * (av1Tx64x64 - av1TxDims[d + 5]) - depth
				let a = aTx[bx] < txw ?? (1, 0)
				let l = lTx[by4] < txh ?? (1, 0)
				split = msac.boolAdapt(av1CdfMTxpart + (cat * 3 + a + l) * 2) == 1
				if split {
					if depth == 0 {
						bTxSplit0 = bTxSplit0 | (1 << (yOff * 4 + xOff))
					} else {
						bTxSplit1 = bTxSplit1 | (1 << (yOff * 4 + xOff))
					}
				}
			}
			if split && av1TxDims[d + 5] > av1Tx8x8 {
				let sub = av1TxDims[d + 6]
				let sw = av1TxDims[sub * 8]
				let sh = av1TxDims[sub * 8 + 1]
				readTxTree(sub, depth + 1, xOff * 2, yOff * 2)
				bx += sw
				readTxTree(sub, depth + 1, xOff * 2 + 1, yOff * 2) when txw >= txh && bx < bw
				bx -= sw
				by += sh
				if txh >= txw && by < bh {
					readTxTree(sub, depth + 1, xOff * 2, yOff * 2 + 1)
					bx += sw
					readTxTree(sub, depth + 1, xOff * 2 + 1, yOff * 2 + 1) when txw >= txh && bx < bw
					bx -= sw
				}
				by -= sh
			} else {
				let nw = 1 << av1TxDims[d + 2]
				let nh = 1 << av1TxDims[d + 3]
				fillA(aTx, bx, nw, split ?? (av1Tx4x4, txw))
				fillL(lTx, by & 31, nh, split ?? (av1Tx4x4, txh))
			}
		}

		// read_vartx_tree.
		def readVartxTree(bs int) {
			let h = hdr
			let bw4 = av1BlockDims[bs * 4]
			let bh4 = av1BlockDims[bs * 4 + 1]
			let lw = av1BlockDims[bs * 4 + 2]
			let lh = av1BlockDims[bs * 4 + 3]
			bTxSplit0 = 0
			bTxSplit1 = 0
			bMaxYtx = av1MaxTxSize[bs * 4]
			if !bSkip && (h.segLossless[bSegId] || bMaxYtx == av1Tx4x4) {
				bMaxYtx = av1Tx4x4
				bUvtx = av1Tx4x4
				if h.txMode == av1TxSwitchable {
					fillA(aTx, bx, 1 << lw, av1Tx4x4)
					fillL(lTx, by & 31, 1 << lh, av1Tx4x4)
				}
			} else if h.txMode != av1TxSwitchable || bSkip {
				if h.txMode == av1TxSwitchable {
					fillA(aTx, bx, 1 << lw, lw)
					fillL(lTx, by & 31, 1 << lh, lh)
				}
				bUvtx = av1MaxTxSize[bs * 4 + layout]
			} else {
				let tw = av1TxDims[bMaxYtx * 8]
				let th = av1TxDims[bMaxYtx * 8 + 1]
				let yOff = 0
				let y = 0
				for y < bh4 {
					let xOff = 0
					let x = 0
					for x < bw4 {
						readTxTree(bMaxYtx, 0, xOff, yOff)
						bx += tw
						x += tw
						xOff++
					}
					bx -= x
					by += th
					y += th
					yOff++
				}
				by -= y
				bUvtx = av1MaxTxSize[bs * 4 + layout]
			}
		}

		// Intra block copy (key and intra frames with allow_intrabc).
		//
		// Fails when the vector points into the current superblock.
		def intrabcBlock(bs int, bw4 int, bh4 int, lw int, lh int, cbw4 int, cbh4 int, cbx4 int, cby4 int, hasChroma bool, edgeFlags int, segPred int) !none {
			av1RefmvsFind(self, 0, -1, bs, edgeFlags)
			if mvStack[0] != 0 || mvStack[1] != 0 {
				bMv[0] = mvStack[0]
				bMv[1] = mvStack[1]
			} else if mvStack[4] != 0 || mvStack[5] != 0 {
				bMv[0] = mvStack[4]
				bMv[1] = mvStack[5]
			} else {
				let sb = seq.sb128 ?? (1, 0)
				if by - (16 << sb) < rowStart {
					bMv[1] = 0
					bMv[0] = -(512 << sb) - 2048
				} else {
					bMv[1] = -(512 << sb)
					bMv[0] = 0
				}
			}
			mvResidual(0, -1)
			// Clip into the decoded part of the tile.
			let borderLeft = colStart * 4
			let borderTop = rowStart * 4
			if hasChroma {
				borderLeft += 4 when bw4 < 2 && ssHor == 1
				borderTop += 4 when bh4 < 2 && ssVer == 1
			}
			let srcLeft = bx * 4 + (bMv[0] >> 3)
			let srcTop = by * 4 + (bMv[1] >> 3)
			let srcRight = srcLeft + bw4 * 4
			let srcBottom = srcTop + bh4 * 4
			let borderRight = ((colEnd + (bw4 - 1)) & ~(bw4 - 1)) * 4
			if srcLeft < borderLeft {
				srcRight += borderLeft - srcLeft
				srcLeft = borderLeft
			} else if srcRight > borderRight {
				srcLeft -= srcRight - borderRight
				srcRight = borderRight
			}
			if srcTop < borderTop {
				srcBottom += borderTop - srcTop
				srcTop = borderTop
			}
			let sb = seq.sb128 ?? (1, 0)
			let sbx = (bx >> (4 + sb)) << (6 + sb)
			let sby = (by >> (4 + sb)) << (6 + sb)
			let sbSize = 1 << (6 + sb)
			if srcBottom > sby && srcRight > sbx {
				if srcTop - borderTop >= srcBottom - sby {
					srcTop -= srcBottom - sby
					srcBottom = sby
				} else if srcLeft - borderLeft >= srcRight - sbx {
					srcLeft -= srcRight - sbx
					srcRight = sbx
				}
			}
			if srcBottom > sby + sbSize {
				srcTop -= srcBottom - (sby + sbSize)
				srcBottom = sby + sbSize
			}
			fail "av1: intra block copy from the current superblock" when srcBottom > sby && srcRight > sbx
			bMv[0] = (srcLeft - bx * 4) * 8
			bMv[1] = (srcTop - by * 4) * 8
			readVartxTree(bs)
			bFilter2d = av1Filter2dBilinear
			bCompType = av1CompInterNone
			bMotionMode = av1MmTranslation
			bInterintraType = av1InterIntraNone
			try av1ReconInter(self, bs)
			// The block is intra for the loop filter's purposes (splat_intrabc_mv).
			for let y = 0; y < bh4; y++ {
				let o = at(bx, by + y)
				for let x = 0; x < bw4; x++ {
					rRef0[o + x] = int8(0)
					rRef1[o + x] = int8(-1)
					rMvx0[o + x] = int16(bMv[0])
					rMvy0[o + x] = int16(bMv[1])
					rBs[o + x] = byte(bs)
					rMf[o + x] = byte(0)
				}
			}
			let by4 = by & 31
			fillA(aTxIntra, bx, bw4, lw)
			fillA(aMode, bx, bw4, av1DcPred)
			fillA(aPalSz, bx, bw4, 0)
			fillA(aPalSzUv, bx, bw4, 0)
			fillA(aSegPred, bx, bw4, segPred)
			fillA(aSkipMode, bx, bw4, 0)
			fillA(aIntra, bx, bw4, 0)
			fillA(aSkip, bx, bw4, bSkip ?? (1, 0))
			fillL(lTxIntra, by4, bh4, lh)
			fillL(lMode, by4, bh4, av1DcPred)
			fillL(lPalSz, by4, bh4, 0)
			fillL(lPalSzUv, by4, bh4, 0)
			fillL(lSegPred, by4, bh4, segPred)
			fillL(lSkipMode, by4, bh4, 0)
			fillL(lIntra, by4, bh4, 0)
			fillL(lSkip, by4, bh4, bSkip ?? (1, 0))
			if hasChroma {
				fillA(aUvMode, cbx4, cbw4, av1DcPred)
				fillL(lUvMode, cby4, cbh4, av1DcPred)
			}
			av1LfMaskInter(self, bs, bSkip, bMaxYtx, bUvtx, hasChroma, 0, false) when hdr.lfLevelY[0] != 0 || hdr.lfLevelY[1] != 0
			return none
		}

		// The motion vector of compound part `idx` for mode `m`
		// (assign_comp_mv).
		def compMv(idx int, m int) {
			if m == av1Nearmv || m == av1Nearestmv {
				bMv[idx * 2] = av1FixMv(hdr, mvStack[bDrlIdx * 4 + idx * 2])
				bMv[idx * 2 + 1] = av1FixMv(hdr, mvStack[bDrlIdx * 4 + idx * 2 + 1])
			} else if m == av1Globalmv {
				av1GmvAt(hdr, idx == 0 ?? (bRef0, bRef1), bx, by, av1BlockDims[bBs * 4], av1BlockDims[bBs * 4 + 1], bMv, idx * 2)
			} else {
				bMv[idx * 2] = mvStack[bDrlIdx * 4 + idx * 2]
				bMv[idx * 2 + 1] = mvStack[bDrlIdx * 4 + idx * 2 + 1]
				mvResidual(idx, (hdr.hp ?? (1, 0)) - (hdr.forceIntegerMv ?? (1, 0)))
			}
		}

		// Inter block syntax: references, modes, vectors, compound and
		// motion modes, filters; then reconstruction.
		//
		// Fails on a malformed stream.
		def interBlock(bs int, bw4 int, bh4 int, lw int, lh int, w4 int, h4 int, cbw4 int, cbh4 int, cbx4 int, cby4 int, hasChroma bool, haveTop bool, haveLeft bool, edgeFlags int, segPred int, segSet bool, segRef int, segSkip bool, segGlobal bool) !none {
			let h = hdr
			let by4 = by & 31
			let minWh = bw4 < bh4 ?? (bw4, bh4)
			let isComp = false
			let subpel = false
			bInterintraType = av1InterIntraNone
			bMotionMode = av1MmTranslation
			bDrlIdx = av1NearestDrl
			for let i = 0; i < 4; i++ {
				bMv[i] = 0
			}
			if bSkipMode {
				isComp = true
			} else if (!segSet || (segRef == -1 && !segGlobal && !segSkip)) && h.switchableCompRefs && minWh > 1 {
				isComp = msac.boolAdapt(av1CdfMComp + av1CompCtx(self, haveTop, haveLeft) * 2) == 1
			}
			if bSkipMode {
				bRef0 = h.skipModeRefs[0]
				bRef1 = h.skipModeRefs[1]
				bCompType = av1CompInterAvg
				bInterMode = av1NearestmvNearestmv
				av1RefmvsFind(self, bRef0 + 1, bRef1 + 1, bs, edgeFlags)
				for let i = 0; i < 4; i++ {
					bMv[i] = av1FixMv(h, mvStack[i])
				}
			} else if isComp {
				let dirCtx = av1CompDirCtx(self, haveTop, haveLeft)
				if msac.boolAdapt(av1CdfMCompDir + dirCtx * 2) == 1 {
					let c1 = av1RefCtx(self, 1, haveTop, haveLeft)
					if msac.boolAdapt(av1CdfMCompFwdRef + c1 * 2) == 1 {
						let c2 = av1RefCtx(self, 3, haveTop, haveLeft)
						bRef0 = 2 + msac.boolAdapt(av1CdfMCompFwdRef + (2 * 3 + c2) * 2)
					} else {
						let c2 = av1RefCtx(self, 2, haveTop, haveLeft)
						bRef0 = msac.boolAdapt(av1CdfMCompFwdRef + (3 + c2) * 2)
					}
					let c3 = av1RefCtx(self, 4, haveTop, haveLeft)
					if msac.boolAdapt(av1CdfMCompBwdRef + c3 * 2) == 1 {
						bRef1 = 6
					} else {
						let c4 = av1RefCtx(self, 5, haveTop, haveLeft)
						bRef1 = 4 + msac.boolAdapt(av1CdfMCompBwdRef + (3 + c4) * 2)
					}
				} else {
					let up = av1RefCtx(self, 0, haveTop, haveLeft)
					if msac.boolAdapt(av1CdfMCompUniRef + up * 2) == 1 {
						bRef0 = 4
						bRef1 = 6
					} else {
						let up1 = av1RefCtx(self, 6, haveTop, haveLeft)
						bRef0 = 0
						bRef1 = 1 + msac.boolAdapt(av1CdfMCompUniRef + (3 + up1) * 2)
						if bRef1 == 2 {
							let up2 = av1RefCtx(self, 3, haveTop, haveLeft)
							bRef1 += msac.boolAdapt(av1CdfMCompUniRef + (6 + up2) * 2)
						}
					}
				}
				av1RefmvsFind(self, bRef0 + 1, bRef1 + 1, bs, edgeFlags)
				bInterMode = msac.symbol(av1CdfMCompInterMode + mvCtx * 8, av1NCompInterPredModes - 1)
				let m0 = av1CompInterModes[bInterMode * 2]
				let m1 = av1CompInterModes[bInterMode * 2 + 1]
				bDrlIdx = av1NearestDrl
				if bInterMode == av1NewmvNewmv {
					if mvCount > 1 {
						bDrlIdx += msac.boolAdapt(av1CdfMDrlBit + drlCtx(0) * 2)
						bDrlIdx += msac.boolAdapt(av1CdfMDrlBit + drlCtx(1) * 2) when bDrlIdx == av1NearerDrl && mvCount > 2
					}
				} else if m0 == av1Nearmv || m1 == av1Nearmv {
					bDrlIdx = av1NearerDrl
					if mvCount > 2 {
						bDrlIdx += msac.boolAdapt(av1CdfMDrlBit + drlCtx(1) * 2)
						bDrlIdx += msac.boolAdapt(av1CdfMDrlBit + drlCtx(2) * 2) when bDrlIdx == av1NearDrl && mvCount > 3
					}
				}
				subpel = minWh == 1 || bInterMode != av1GlobalmvGlobalmv
				subpel = true when m0 == av1Globalmv && h.gmvType[bRef0] == av1WmTranslation
				subpel = true when m1 == av1Globalmv && h.gmvType[bRef1] == av1WmTranslation
				compMv(0, m0)
				compMv(1, m1)
				let segwedge = false
				segwedge = msac.boolAdapt(av1CdfMMaskComp + av1MaskCompCtx(self) * 2) == 1 when seq.maskedCompound
				if !segwedge {
					if seq.jntComp {
						let jctx = av1JntCompCtx(self, seq.orderHintBits, h.frameOffset, refs[bRef0].hdr.frameOffset, refs[bRef1].hdr.frameOffset)
						bCompType = av1CompInterWeightedAvg + msac.boolAdapt(av1CdfMJntComp + jctx * 2)
					} else {
						bCompType = av1CompInterAvg
					}
				} else {
					if ((av1WedgeAllowedMask >> bs) & 1) != 0 {
						let ctx = av1WedgeCtx[bs]
						bCompType = av1CompInterWedge - msac.boolAdapt(av1CdfMWedgeComp + ctx * 2)
						bWedgeIdx = msac.symbol(av1CdfMWedgeIdx + ctx * 16, 15) when bCompType == av1CompInterWedge
					} else {
						bCompType = av1CompInterSeg
					}
					bMaskSign = msac.boolEqui()
				}
			} else {
				bCompType = av1CompInterNone
				if segSet && segRef > 0 {
					bRef0 = segRef - 1
				} else if segSet && (segGlobal || segSkip) {
					bRef0 = 0
				} else {
					let c1 = av1RefCtx(self, 0, haveTop, haveLeft)
					if msac.boolAdapt(av1CdfMRef + c1 * 2) == 1 {
						let c2 = av1RefCtx(self, 4, haveTop, haveLeft)
						if msac.boolAdapt(av1CdfMRef + (3 + c2) * 2) == 1 {
							bRef0 = 6
						} else {
							let c3 = av1RefCtx(self, 5, haveTop, haveLeft)
							bRef0 = 4 + msac.boolAdapt(av1CdfMRef + (5 * 3 + c3) * 2)
						}
					} else {
						let c2 = av1RefCtx(self, 1, haveTop, haveLeft)
						if msac.boolAdapt(av1CdfMRef + (2 * 3 + c2) * 2) == 1 {
							let c3 = av1RefCtx(self, 3, haveTop, haveLeft)
							bRef0 = 2 + msac.boolAdapt(av1CdfMRef + (4 * 3 + c3) * 2)
						} else {
							let c3 = av1RefCtx(self, 2, haveTop, haveLeft)
							bRef0 = msac.boolAdapt(av1CdfMRef + (3 * 3 + c3) * 2)
						}
					}
				}
				bRef1 = -1
				av1RefmvsFind(self, bRef0 + 1, -1, bs, edgeFlags)
				let forced = segSet && (segSkip || segGlobal)
				if forced || msac.boolAdapt(av1CdfMNewmvMode + (mvCtx & 7) * 2) == 1 {
					if forced || msac.boolAdapt(av1CdfMGlobalmvMode + ((mvCtx >> 3) & 1) * 2) == 0 {
						bInterMode = av1Globalmv
						av1GmvAt(h, bRef0, bx, by, bw4, bh4, bMv, 0)
						subpel = minWh == 1 || h.gmvType[bRef0] == av1WmTranslation
					} else {
						subpel = true
						if msac.boolAdapt(av1CdfMRefmvMode + ((mvCtx >> 4) & 15) * 2) == 1 {
							bInterMode = av1Nearmv
							bDrlIdx = av1NearerDrl
							if mvCount > 2 {
								bDrlIdx += msac.boolAdapt(av1CdfMDrlBit + drlCtx(1) * 2)
								bDrlIdx += msac.boolAdapt(av1CdfMDrlBit + drlCtx(2) * 2) when bDrlIdx == av1NearDrl && mvCount > 3
							}
						} else {
							bInterMode = av1Nearestmv
							bDrlIdx = av1NearestDrl
						}
						bMv[0] = mvStack[bDrlIdx * 4]
						bMv[1] = mvStack[bDrlIdx * 4 + 1]
						if bDrlIdx < av1NearDrl {
							bMv[0] = av1FixMv(h, bMv[0])
							bMv[1] = av1FixMv(h, bMv[1])
						}
					}
				} else {
					subpel = true
					bInterMode = av1Newmv
					bDrlIdx = av1NearestDrl
					if mvCount > 1 {
						bDrlIdx += msac.boolAdapt(av1CdfMDrlBit + drlCtx(0) * 2)
						bDrlIdx += msac.boolAdapt(av1CdfMDrlBit + drlCtx(1) * 2) when bDrlIdx == av1NearerDrl && mvCount > 2
					}
					bMv[0] = mvStack[bDrlIdx * 4]
					bMv[1] = mvStack[bDrlIdx * 4 + 1]
					if mvCount <= 1 {
						bMv[0] = av1FixMv(h, bMv[0])
						bMv[1] = av1FixMv(h, bMv[1])
					}
					mvResidual(0, (h.hp ?? (1, 0)) - (h.forceIntegerMv ?? (1, 0)))
				}
				let iiGrp = av1YModeSizeCtx[bs]
				if seq.interIntra && ((av1InterIntraAllowedMask >> bs) & 1) != 0 && msac.boolAdapt(av1CdfMInterintra + iiGrp * 2) == 1 {
					bInterintraMode = msac.symbol(av1CdfMInterintraMode + iiGrp * 4, av1NInterIntraPredModes - 1)
					let wctx = av1WedgeCtx[bs]
					bInterintraType = av1InterIntraBlend + msac.boolAdapt(av1CdfMInterintraWedge + wctx * 2)
					bWedgeIdx = msac.symbol(av1CdfMWedgeIdx + wctx * 16, 15) when bInterintraType == av1InterIntraWedge
				}
				let warpedGlobal = !h.forceIntegerMv && bInterMode == av1Globalmv && h.gmvType[bRef0] > av1WmTranslation
				if h.switchableMotionMode && bInterintraType == av1InterIntraNone && minWh >= 2 && !warpedGlobal && ((haveLeft && av1OddZero(lIntra, by4 + 1, h4 >> 1, true)) || (haveTop && av1OddZero(aIntra, bx + 1, w4 >> 1, false))) {
					let nbMasks = int[0, 0]
					findMatchingRef(bw4, bh4, w4, h4, haveLeft, haveTop, bRef0, edgeFlags, nbMasks)
					let allowWarp = !av1RefScaled(self, bRef0) && !h.forceIntegerMv && h.warpMotion && (nbMasks[0] | nbMasks[1]) != 0
					if allowWarp {
						bMotionMode = msac.symbol(av1CdfMMotionMode + bs * 4, 2)
					} else {
						bMotionMode = msac.boolAdapt(av1CdfMObmc + bs * 2)
					}
					if bMotionMode == av1MmWarp {
						subpel = false
						deriveWarpmv(bw4, bh4, nbMasks)
					}
				}
			}
			// Sub-pixel filters.
			if h.subpelFilter == av1FilterSwitchable {
				if subpel {
					let comp = bCompType != av1CompInterNone ?? (1, 0)
					let c1 = av1FilterCtx(self, comp, 0, bRef0)
					bFilter[0] = msac.symbol(av1CdfMFilter + c1 * 4, 2)
					if seq.dualFilter {
						let c2 = av1FilterCtx(self, comp, 1, bRef0)
						bFilter[1] = msac.symbol(av1CdfMFilter + (8 + c2) * 4, 2)
					} else {
						bFilter[1] = bFilter[0]
					}
				} else {
					bFilter[0] = 0
					bFilter[1] = 0
				}
			} else {
				bFilter[0] = h.subpelFilter
				bFilter[1] = h.subpelFilter
			}
			bFilter2d = av1Filter2d[bFilter[1] * 4 + bFilter[0]]
			readVartxTree(bs)
			try av1ReconInter(self, bs)
			if h.lfLevelY[0] != 0 || h.lfLevelY[1] != 0 {
				let isGlobal = bInterMode == (isComp ?? (av1GlobalmvGlobalmv, av1Globalmv))
				av1LfMaskInter(self, bs, bSkip, bMaxYtx, bUvtx, hasChroma, bRef0 + 1, !isGlobal)
			}
			if isComp {
				let mf = (bInterMode == av1GlobalmvGlobalmv ?? (1, 0)) | ((((1 << bInterMode) & 0xBC) != 0) ?? (2, 0))
				splatMv(bs, bw4, bh4, bRef0 + 1, bRef1 + 1, mf)
			} else {
				let mf = ((bInterMode == av1Globalmv && minWh >= 2) ?? (1, 0)) | (bInterMode == av1Newmv ?? (2, 0))
				splatMv(bs, bw4, bh4, bRef0 + 1, bInterintraType != 0 ?? (0, -1), mf)
			}
			fillA(aSegPred, bx, bw4, segPred)
			fillA(aSkipMode, bx, bw4, bSkipMode ?? (1, 0))
			fillA(aIntra, bx, bw4, 0)
			fillA(aSkip, bx, bw4, bSkip ?? (1, 0))
			fillA(aPalSz, bx, bw4, 0)
			fillA(aPalSzUv, bx, bw4, 0)
			fillA(aTxIntra, bx, bw4, lw)
			fillA(aCompType, bx, bw4, bCompType)
			fillA(aFilter0, bx, bw4, bFilter[0])
			fillA(aFilter1, bx, bw4, bFilter[1])
			fillA(aMode, bx, bw4, bInterMode)
			fillA(aRef0, bx, bw4, bRef0)
			fillA(aRef1, bx, bw4, bRef1)
			fillL(lSegPred, by4, bh4, segPred)
			fillL(lSkipMode, by4, bh4, bSkipMode ?? (1, 0))
			fillL(lIntra, by4, bh4, 0)
			fillL(lSkip, by4, bh4, bSkip ?? (1, 0))
			fillL(lPalSz, by4, bh4, 0)
			fillL(lPalSzUv, by4, bh4, 0)
			fillL(lTxIntra, by4, bh4, lh)
			fillL(lCompType, by4, bh4, bCompType)
			fillL(lFilter0, by4, bh4, bFilter[0])
			fillL(lFilter1, by4, bh4, bFilter[1])
			fillL(lMode, by4, bh4, bInterMode)
			fillL(lRef0, by4, bh4, bRef0)
			fillL(lRef1, by4, bh4, bRef1)
			if hasChroma {
				fillA(aUvMode, cbx4, cbw4, av1DcPred)
				fillL(lUvMode, cby4, cbh4, av1DcPred)
			}
			return none
		}

		// find_matching_ref: the neighbours using the same single reference,
		// as masks of top (masks[0]) and left (masks[1]) positions; bit 32
		// of masks[1] the top-left, of masks[0] the top-right.
		def findMatchingRef(bw4 int, bh4 int, w4 int, h4 int, haveLeft bool, haveTop bool, ref int, edgeFlags int, masks int[]) {
			let count = 0
			let haveTl = haveTop && haveLeft
			let haveTr = (bw4 > bh4 ?? (bw4, bh4)) < 32 && haveTop && bx + bw4 < colEnd && (edgeFlags & av1EdgeI444TopHasRight) != 0
			if haveTop {
				let k = at(bx, by - 1)
				if int(rRef0[k]) == ref + 1 && int(rRef1[k]) == -1 {
					masks[0] = masks[0] | 1
					count = 1
				}
				let aw4 = av1BlockDims[int(rBs[k]) * 4]
				if aw4 >= bw4 {
					let off = bx & (aw4 - 1)
					haveTl = false when off != 0
					haveTr = false when aw4 - off > bw4
				} else {
					let mask = 1 << aw4
					let x = aw4
					for x < w4 {
						k += aw4
						if int(rRef0[k]) == ref + 1 && int(rRef1[k]) == -1 {
							masks[0] = masks[0] | mask
							count++
							return when count >= 8
						}
						aw4 = av1BlockDims[int(rBs[k]) * 4]
						mask = mask << aw4
						x += aw4
					}
				}
			}
			if haveLeft {
				let k = at(bx - 1, by)
				if int(rRef0[k]) == ref + 1 && int(rRef1[k]) == -1 {
					masks[1] = masks[1] | 1
					count++
					return when count >= 8
				}
				let lh4 = av1BlockDims[int(rBs[k]) * 4 + 1]
				if lh4 >= bh4 {
					haveTl = false when (by & (lh4 - 1)) != 0
				} else {
					let mask = 1 << lh4
					let y = lh4
					for y < h4 {
						k += lh4 * b4Stride
						if int(rRef0[k]) == ref + 1 && int(rRef1[k]) == -1 {
							masks[1] = masks[1] | mask
							count++
							return when count >= 8
						}
						lh4 = av1BlockDims[int(rBs[k]) * 4 + 1]
						mask = mask << lh4
						y += lh4
					}
				}
			}
			if haveTl {
				let k = at(bx - 1, by - 1)
				if int(rRef0[k]) == ref + 1 && int(rRef1[k]) == -1 {
					masks[1] = masks[1] | (1 << 32)
					count++
					return when count >= 8
				}
			}
			if haveTr {
				let k = at(bx + bw4, by - 1)
				masks[0] = masks[0] | (1 << 32) when int(rRef0[k]) == ref + 1 && int(rRef1[k]) == -1
			}
		}

		def addSample(pts int[], np int, dx int, dy int, sx int, sy int, k int) int {
			let bs = int(rBs[k])
			pts[np * 4] = 16 * (2 * dx + sx * av1BlockDims[bs * 4]) - 8
			pts[np * 4 + 1] = 16 * (2 * dy + sy * av1BlockDims[bs * 4 + 1]) - 8
			pts[np * 4 + 2] = pts[np * 4] + int(rMvx0[k])
			pts[np * 4 + 3] = pts[np * 4 + 1] + int(rMvy0[k])
			return np + 1
		}

		// derive_warpmv: the local warp of the block from its neighbours'
		// vectors, into warpType/warpMat/warpAbcd.
		def deriveWarpmv(bw4 int, bh4 int, masks int[]) {
			let pts int[]
			pts.len(32)
			let np = 0
			let m0 = masks[0] & 0xFFFFFFFF
			let m1lo = masks[1] & 0xFFFFFFFF
			if m0 == 1 && (masks[1] >> 32) == 0 {
				let k = at(bx, by - 1)
				let off = bx & (av1BlockDims[int(rBs[k]) * 4] - 1)
				np = addSample(pts, np, -off, 0, 1, -1, k)
			} else {
				let off = 0
				let xmask = m0
				for np < 8 && xmask != 0 {
					let tz = av1Ctz(xmask)
					off += tz
					xmask = xmask >> tz
					np = addSample(pts, np, off, 0, 1, -1, at(bx + off, by - 1))
					xmask = xmask & ~1
				}
			}
			if np < 8 && masks[1] == 1 {
				let k = at(bx - 1, by)
				let off = by & (av1BlockDims[int(rBs[k]) * 4 + 1] - 1)
				np = addSample(pts, np, 0, -off, -1, 1, at(bx - 1, by - off))
			} else {
				let off = 0
				let ymask = m1lo
				for np < 8 && ymask != 0 {
					let tz = av1Ctz(ymask)
					off += tz
					ymask = ymask >> tz
					np = addSample(pts, np, 0, off, -1, 1, at(bx - 1, by + off))
					ymask = ymask & ~1
				}
			}
			np = addSample(pts, np, 0, 0, -1, -1, at(bx - 1, by - 1)) when np < 8 && (masks[1] >> 32) != 0
			np = addSample(pts, np, bw4, 0, 1, -1, at(bx + bw4, by - 1)) when np < 8 && (masks[0] >> 32) != 0
			// Keep the samples close to the block's own vector.
			let mvd int[]
			mvd.len(8)
			let ret = 0
			let lim = bw4 > bh4 ?? (bw4, bh4)
			lim = lim < 4 ?? (4, lim > 28 ?? (28, lim))
			let thresh = 4 * lim
			for let i = 0; i < np; i++ {
				mvd[i] = av1Abs(pts[i * 4 + 2] - pts[i * 4] - bMv[0]) + av1Abs(pts[i * 4 + 3] - pts[i * 4 + 1] - bMv[1])
				if mvd[i] > thresh {
					mvd[i] = -1
				} else {
					ret++
				}
			}
			if ret == 0 {
				ret = 1
			} else {
				let i = 0
				let j = np - 1
				for let k = 0; k < np - ret; k++ {
					for mvd[i] != -1 {
						i++
					}
					for mvd[j] == -1 {
						j--
					}
					break when i > j
					mvd[i] = mvd[j]
					for let c = 0; c < 4; c++ {
						pts[i * 4 + c] = pts[j * 4 + c]
					}
					i++
					j--
				}
			}
			if av1FindAffine(pts, ret, bw4, bh4, bMv[0], bMv[1], warpMat, bx, by) && av1ShearParams(warpMat, warpAbcd) {
				warpType = av1WmAffine
			} else {
				warpType = av1WmIdentity
			}
		}
	}
}
