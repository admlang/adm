internal partial module std.formats.video.av1 {
	// Block sizes that allow CFL, wedges and inter-intra (dav1d tables.h).
	const av1CflAllowedMask = (1 << av1Bs32x32) | (1 << av1Bs32x16) | (1 << av1Bs32x8) | (1 << av1Bs16x32) | (1 << av1Bs16x16) | (1 << av1Bs16x8) | (1 << av1Bs16x4) | (1 << av1Bs8x32) | (1 << av1Bs8x16) | (1 << av1Bs8x8) | (1 << av1Bs8x4) | (1 << av1Bs4x16) | (1 << av1Bs4x8) | (1 << av1Bs4x4)
	const av1WedgeAllowedMask = (1 << av1Bs32x32) | (1 << av1Bs32x16) | (1 << av1Bs32x8) | (1 << av1Bs16x32) | (1 << av1Bs16x16) | (1 << av1Bs16x8) | (1 << av1Bs8x32) | (1 << av1Bs8x16) | (1 << av1Bs8x8)
	const av1InterIntraAllowedMask = (1 << av1Bs32x32) | (1 << av1Bs32x16) | (1 << av1Bs16x32) | (1 << av1Bs16x16) | (1 << av1Bs16x8) | (1 << av1Bs8x16) | (1 << av1Bs8x8)

	def av1IntraCtx(t Av1Tile, haveTop bool, haveLeft bool) int {
		let a = t.aIntra[t.bx]
		let l = t.lIntra[t.by & 31]
		if haveLeft {
			if haveTop {
				let c = l + a
				return c + (c == 2 ?? (1, 0))
			}
			return l * 2
		}
		return haveTop ?? (a * 2, 0)
	}

	def av1FilterCtx(t Av1Tile, comp int, dir int, ref int) int {
		let x = t.bx
		let y = t.by & 31
		let af = (t.aRef0[x] == ref || t.aRef1[x] == ref) ?? ((dir == 0 ?? (t.aFilter0[x], t.aFilter1[x])), 3)
		let lf = (t.lRef0[y] == ref || t.lRef1[y] == ref) ?? ((dir == 0 ?? (t.lFilter0[y], t.lFilter1[y])), 3)
		return comp * 4 + af when af == lf
		return comp * 4 + lf when af == 3
		return comp * 4 + af when lf == 3
		return comp * 4 + 3
	}

	def av1CompCtx(t Av1Tile, haveTop bool, haveLeft bool) int {
		let x = t.bx
		let y = t.by & 31
		if haveTop {
			if haveLeft {
				if t.aCompType[x] != 0 {
					return 4 when t.lCompType[y] != 0
					return 2 + ((t.lRef0[y] < 0 || t.lRef0[y] >= 4) ?? (1, 0))
				}
				return 2 + ((t.aRef0[x] < 0 || t.aRef0[x] >= 4) ?? (1, 0)) when t.lCompType[y] != 0
				return ((t.lRef0[y] >= 4) != (t.aRef0[x] >= 4)) ?? (1, 0)
			}
			return t.aCompType[x] != 0 ?? (3, t.aRef0[x] >= 4 ?? (1, 0))
		}
		return t.lCompType[y] != 0 ?? (3, t.lRef0[y] >= 4 ?? (1, 0)) when haveLeft
		return 1
	}

	def av1UniComp(r0 int, r1 int) bool {
		return (r0 < 4) == (r1 < 4)
	}

	def av1CompDirCtx(t Av1Tile, haveTop bool, haveLeft bool) int {
		let x = t.bx
		let y = t.by & 31
		if haveTop && haveLeft {
			let ai = t.aIntra[x] != 0
			let li = t.lIntra[y] != 0
			return 2 when ai && li
			if ai || li {
				let ct = ai ?? (t.lCompType[y], t.aCompType[x])
				let r0 = ai ?? (t.lRef0[y], t.aRef0[x])
				let r1 = ai ?? (t.lRef1[y], t.aRef1[x])
				return 2 when ct == 0
				return 1 + 2 * (av1UniComp(r0, r1) ?? (1, 0))
			}
			let ac = t.aCompType[x] != 0
			let lc = t.lCompType[y] != 0
			let ar0 = t.aRef0[x]
			let lr0 = t.lRef0[y]
			return 1 + 2 * (((ar0 >= 4) == (lr0 >= 4)) ?? (1, 0)) when !ac && !lc
			if !ac || !lc {
				let r0 = ac ?? (ar0, lr0)
				let r1 = ac ?? (t.aRef1[x], t.lRef1[y])
				return 1 unless av1UniComp(r0, r1)
				return 3 + (((ar0 >= 4) == (lr0 >= 4)) ?? (1, 0))
			}
			let au = av1UniComp(ar0, t.aRef1[x])
			let lu = av1UniComp(lr0, t.lRef1[y])
			return 0 when !au && !lu
			return 2 when !au || !lu
			return 3 + (((ar0 == 4) == (lr0 == 4)) ?? (1, 0))
		}
		if haveTop || haveLeft {
			let intra = haveLeft ?? (t.lIntra[y] != 0, t.aIntra[x] != 0)
			return 2 when intra
			let ct = haveLeft ?? (t.lCompType[y], t.aCompType[x])
			return 2 when ct == 0
			let r0 = haveLeft ?? (t.lRef0[y], t.aRef0[x])
			let r1 = haveLeft ?? (t.lRef1[y], t.aRef1[x])
			return 4 * (av1UniComp(r0, r1) ?? (1, 0))
		}
		return 2
	}

	def av1JntCompCtx(t Av1Tile, bits int, poc int, ref0poc int, ref1poc int) int {
		let x = t.bx
		let y = t.by & 31
		let d0 = av1Abs(av1PocDiff(bits, ref0poc, poc))
		let d1 = av1Abs(av1PocDiff(bits, poc, ref1poc))
		let offset = d0 == d1 ?? (1, 0)
		let a = (t.aCompType[x] >= av1CompInterAvg || t.aRef0[x] == 6) ?? (1, 0)
		let l = (t.lCompType[y] >= av1CompInterAvg || t.lRef0[y] == 6) ?? (1, 0)
		return 3 * offset + a + l
	}

	def av1MaskCompCtx(t Av1Tile) int {
		let x = t.bx
		let y = t.by & 31
		let a = t.aCompType[x] >= av1CompInterSeg ?? (1, t.aRef0[x] == 6 ?? (3, 0))
		let l = t.lCompType[y] >= av1CompInterSeg ?? (1, t.lRef0[y] == 6 ?? (3, 0))
		return a + l < 5 ?? (a + l, 5)
	}

	// Counts of the neighbours' references by `kind`, the dav1d
	// av1_get_*_ref_ctx family: 0 ref (fwd vs bwd), 1 fwd, 2 fwd1, 3 fwd2,
	// 4 bwd, 5 bwd1, 6 uni_p1.
	def av1RefCtx(t Av1Tile, kind int, haveTop bool, haveLeft bool) int {
		let cnt = int[0, 0, 0, 0]
		let x = t.bx
		let y = t.by & 31
		for let side = 0; side < 2; side++ {
			let have = side == 0 ?? (haveTop, haveLeft)
			continue unless have
			let intra = side == 0 ?? (t.aIntra[x], t.lIntra[y])
			continue when intra != 0
			let comp = (side == 0 ?? (t.aCompType[x], t.lCompType[y])) != 0
			for let k = 0; k < 2; k++ {
				continue when k == 1 && !comp
				let r = side == 0 ?? ((k == 0 ?? (t.aRef0[x], t.aRef1[x])), (k == 0 ?? (t.lRef0[y], t.lRef1[y])))
				match kind {
					case 0:
						cnt[r >= 4 ?? (1, 0)]++
					case 1:
						cnt[r]++ when r >= 0 && r < 4
					case 2:
						cnt[r]++ when r >= 0 && r < 2
					case 3:
						cnt[r - 2]++ when r := 2 || 3
					case 4:
						cnt[r - 4]++ when r >= 4
					case 5:
						cnt[r - 4]++ when r >= 4
					default:
						cnt[r - 1]++ when r >= 1 && r <= 3
				}
			}
		}
		let c0 = cnt[0]
		let c1 = cnt[1]
		match kind {
			case 1:
				c0 = cnt[0] + cnt[1]
				c1 = cnt[2] + cnt[3]
			case 4:
				c0 = cnt[1] + cnt[0]
				c1 = cnt[2]
			case 6:
				c0 = cnt[0]
				c1 = cnt[1] + cnt[2]
		}
		return c0 == c1 ?? (1, c0 < c1 ?? (0, 2))
	}

	// get_gmv_2d: the global motion vector of reference `r` at the block,
	// into mv[0] (x) and mv[1] (y).
	def av1GmvAt(h Av1FrameHdr, r int, bx4 int, by4 int, bw4 int, bh4 int, out int[], at int) {
		let t = h.gmvType[r]
		let m = r * 6
		if t == av1WmIdentity {
			out[at] = 0
			out[at + 1] = 0
			return
		}
		if t == av1WmTranslation {
			// As libaom: the row from matrix[0], the column from matrix[1].
			out[at] = h.gmv[m + 1] >> 13
			out[at + 1] = h.gmv[m] >> 13
		} else {
			let x = bx4 * 4 + bw4 * 2 - 1
			let y = by4 * 4 + bh4 * 2 - 1
			let xc = (h.gmv[m + 2] - (1 << 16)) * x + h.gmv[m + 3] * y + h.gmv[m]
			let yc = (h.gmv[m + 5] - (1 << 16)) * y + h.gmv[m + 4] * x + h.gmv[m + 1]
			let lowp = h.hp ?? (0, 1)
			let shift = 16 - (3 - lowp)
			let round = (1 << shift) >> 1
			out[at] = av1ApplySign(((av1Abs(xc) + round) >> shift) << lowp, xc)
			out[at + 1] = av1ApplySign(((av1Abs(yc) + round) >> shift) << lowp, yc)
		}
		if h.forceIntegerMv {
			out[at] = av1FixIntMv(out[at])
			out[at + 1] = av1FixIntMv(out[at + 1])
		}
	}

	// fix_int_mv_precision on one 16-bit component.
	def av1FixIntMv(v int) int {
		let s = v < 0 ?? (-1, 0)
		return av1Int16((v - s + 3) & ~7)
	}

	def av1Int16(v int) int {
		let u = v & 0xFFFF
		return u >= 32768 ?? (u - 65536, u)
	}

	// fix_mv_precision on one component.
	def av1FixMv(h Av1FrameHdr, v int) int {
		return av1FixIntMv(v) when h.forceIntegerMv
		if !h.hp {
			let s = v < 0 ?? (-1, 0)
			return av1Int16((v - s) & ~1)
		}
		return v
	}

	// init_quant_tables: dequantizers of every segment for base qindex
	// `qidx` into `dq` (segment * 6 + plane * 2 + ac).
	def av1InitDq(t Av1Tile, qidx int, dq int[]) {
		let h = t.hdr
		let hbd = t.bitDepth == 8 ?? (0, t.bitDepth == 10 ?? (1, 2))
		let n = h.segEnabled ?? (8, 1)
		for let i = 0; i < n; i++ {
			let yac = qidx
			yac = av1ClipU8(qidx + h.segDeltaQ[i]) when h.segEnabled
			let ydc = av1ClipU8(yac + h.ydcDelta)
			let uac = av1ClipU8(yac + h.uacDelta)
			let udc = av1ClipU8(yac + h.udcDelta)
			let vac = av1ClipU8(yac + h.vacDelta)
			let vdc = av1ClipU8(yac + h.vdcDelta)
			let b = hbd * 512
			dq[i * 6] = av1DqTable[b + ydc * 2]
			dq[i * 6 + 1] = av1DqTable[b + yac * 2 + 1]
			dq[i * 6 + 2] = av1DqTable[b + udc * 2]
			dq[i * 6 + 3] = av1DqTable[b + uac * 2 + 1]
			dq[i * 6 + 4] = av1DqTable[b + vdc * 2]
			dq[i * 6 + 5] = av1DqTable[b + vac * 2 + 1]
		}
	}

	def av1ClipU8(v int) int {
		return v < 0 ?? (0, v > 255 ?? (255, v))
	}

	def av1Clip63(v int) int {
		return v < 0 ?? (0, v > 63 ?? (63, v))
	}

	// calc_lf_value into lvl[at + r * 2 + m] for 8 references and 2 modes.
	def av1CalcLfValue(lvl int[], at int, base int, delta int, segDelta int, h Av1FrameHdr) {
		let b = av1Clip63(av1Clip63(base + delta) + segDelta)
		if !h.lfDeltaEnabled {
			for let i = 0; i < 16; i++ {
				lvl[at + i] = b
			}
			return
		}
		let sh = b >= 32 ?? (1, 0)
		let v0 = av1Clip63(b + h.lfRefDelta[0] * (1 << sh))
		lvl[at] = v0
		lvl[at + 1] = v0
		for let r = 1; r < 8; r++ {
			for let m = 0; m < 2; m++ {
				let d = h.lfModeDelta[m] + h.lfRefDelta[r]
				lvl[at + r * 2 + m] = av1Clip63(b + d * (1 << sh))
			}
		}
	}

	// dav1d_calc_lf_values: levels per segment, plane/direction (luma
	// vertical, luma horizontal, u, v), reference and mode into `lvl`.
	def av1CalcLfValues(t Av1Tile, lvl int[], delta int[]) {
		let h = t.hdr
		let n = h.segEnabled ?? (8, 1)
		for let i = 0; i < lvl.len(); i++ {
			lvl[i] = 0
		}
		return when h.lfLevelY[0] == 0 && h.lfLevelY[1] == 0
		for let s = 0; s < n; s++ {
			let at = s * 64
			let sd = s * 4
			let seg = h.segEnabled
			av1CalcLfValue(lvl, at, h.lfLevelY[0], delta[0], seg ?? (h.segDeltaLf[sd], 0), h)
			av1CalcLfValue(lvl, at + 16, h.lfLevelY[1], delta[h.deltaLfMulti ?? (1, 0)], seg ?? (h.segDeltaLf[sd + 1], 0), h)
			av1CalcLfValue(lvl, at + 32, h.lfLevelU, delta[h.deltaLfMulti ?? (2, 0)], seg ?? (h.segDeltaLf[sd + 2], 0), h) when h.lfLevelU != 0
			av1CalcLfValue(lvl, at + 48, h.lfLevelV, delta[h.deltaLfMulti ?? (3, 0)], seg ?? (h.segDeltaLf[sd + 3], 0), h) when h.lfLevelV != 0
		}
	}

	// findoddzero: whether an odd neighbour of the edge is not intra
	// (overlappable): arr[start + 2n] for n < len, row indices wrapping at
	// 32 when `wrap`.
	def av1OddZero(arr int[], start int, len int, wrap bool) bool {
		for let n = 0; n < len; n++ {
			let i = start + n * 2
			i = i & 31 when wrap
			return true when arr[i] == 0
		}
		return false
	}

	def av1Ctz(v int) int {
		let n = 0
		for ((v >> n) & 1) == 0 && n < 64 {
			n++
		}
		return n
	}

	// Whether reference `r` has another size than the frame (scaled
	// motion compensation).
	def av1RefScaled(t Av1Tile, r int) bool {
		let f = t.refs[r]
		return f.upWidth != t.hdr.width || f.height != t.hdr.height
	}
}
