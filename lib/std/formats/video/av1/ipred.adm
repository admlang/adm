internal partial module std.formats.video.av1 {
	use std.simd

	// Intra prediction (dav1d ipred_prepare_tmpl.c and ipred_tmpl.c). The
	// edge buffer `e` holds the top-left sample at index `av1Tl`, the top
	// row to its right and the left column below it going down to lower
	// indices (left sample i at av1Tl - 1 - i).
	const av1Tl = 256
	const av1AngleEdgeFilter = 1024
	const av1AngleSmooth = 512

	const av1ModeToAngle = int[90, 180, 45, 135, 113, 157, 203, 67]

	// Which edges each implementation mode needs: bit 0 left, 1 top, 2
	// top-left, 3 top-right, 4 bottom-left.
	const av1EdgeNeeds = int[3, 2, 1, 1, 2, 0, 14, 7, 21, 3, 3, 3, 7, 7]

	// dav1d_prepare_intra_edges: the substituted edges of the block at
	// (x, y) in 4x4 units of the plane (tile limits w, h) into `e`;
	// returns the implementation mode, `angle` updated through `ang[0]`.
	def av1PrepareEdges(x int, haveLeft bool, y int, haveTop bool, w int, h int, edgeFlags int, plane uint16[], dst int, stride int, mode0 int, ang int[], tw int, th int, filterEdge bool, e int[], bitDepth int) int {
		let mode = mode0
		if mode >= av1VertPred && mode <= av1VertLeftPred {
			let a = av1ModeToAngle[mode - av1VertPred] + 3 * ang[0]
			ang[0] = a
			if a <= 90 {
				mode = (a < 90 && haveTop) ?? (av1Z1Pred, av1VertPred)
			} else if a < 180 {
				mode = av1Z2Pred
			} else {
				mode = (a > 180 && haveLeft) ?? (av1Z3Pred, av1HorPred)
			}
		} else if mode == av1DcPred {
			mode = haveLeft ?? ((haveTop ?? (av1DcPred, av1LeftDcPred)), (haveTop ?? (av1TopDcPred, av1Dc128Pred)))
		} else if mode == av1PaethPred {
			mode = haveLeft ?? ((haveTop ?? (av1PaethPred, av1HorPred)), (haveTop ?? (av1VertPred, av1Dc128Pred)))
		}
		let needs = av1EdgeNeeds[mode]
		let top = dst - stride
		if (needs & 1) != 0 {
			let sz = th << 2
			if haveLeft {
				let have = sz < (h - y) << 2 ?? (sz, (h - y) << 2)
				for let i = 0; i < have; i++ {
					e[av1Tl - 1 - i] = int(plane[dst + stride * i - 1])
				}
				let fill = e[av1Tl - have]
				for let i = have; i < sz; i++ {
					e[av1Tl - 1 - i] = fill
				}
			} else {
				let v = haveTop ?? (int(plane[top]), ((1 << bitDepth) >> 1) + 1)
				for let i = 0; i < sz; i++ {
					e[av1Tl - 1 - i] = v
				}
			}
			if (needs & 16) != 0 {
				let haveBl = (haveLeft && y + th < h) && (edgeFlags & av1EdgeI444LeftHasBottom) != 0
				if haveBl {
					let have = sz < (h - y - th) << 2 ?? (sz, (h - y - th) << 2)
					for let i = 0; i < have; i++ {
						e[av1Tl - 1 - sz - i] = int(plane[dst + (sz + i) * stride - 1])
					}
					let fill = e[av1Tl - sz - have]
					for let i = have; i < sz; i++ {
						e[av1Tl - 1 - sz - i] = fill
					}
				} else {
					let fill = e[av1Tl - sz]
					for let i = 0; i < sz; i++ {
						e[av1Tl - 1 - sz - i] = fill
					}
				}
			}
		}
		if (needs & 2) != 0 {
			let sz = tw << 2
			if haveTop {
				let have = sz < (w - x) << 2 ?? (sz, (w - x) << 2)
				for let i = 0; i < have; i++ {
					e[av1Tl + 1 + i] = int(plane[top + i])
				}
				let fill = e[av1Tl + have]
				for let i = have; i < sz; i++ {
					e[av1Tl + 1 + i] = fill
				}
			} else {
				let v = haveLeft ?? (int(plane[dst - 1]), ((1 << bitDepth) >> 1) - 1)
				for let i = 0; i < sz; i++ {
					e[av1Tl + 1 + i] = v
				}
			}
			if (needs & 8) != 0 {
				let haveTr = (haveTop && x + tw < w) && (edgeFlags & av1EdgeI444TopHasRight) != 0
				if haveTr {
					let have = sz < (w - x - tw) << 2 ?? (sz, (w - x - tw) << 2)
					for let i = 0; i < have; i++ {
						e[av1Tl + 1 + sz + i] = int(plane[top + sz + i])
					}
					let fill = e[av1Tl + sz + have]
					for let i = have; i < sz; i++ {
						e[av1Tl + 1 + sz + i] = fill
					}
				} else {
					let fill = e[av1Tl + sz]
					for let i = 0; i < sz; i++ {
						e[av1Tl + 1 + sz + i] = fill
					}
				}
			}
		}
		if (needs & 4) != 0 {
			if haveLeft {
				e[av1Tl] = haveTop ?? (int(plane[top - 1]), int(plane[dst - 1]))
			} else {
				e[av1Tl] = haveTop ?? (int(plane[top]), (1 << bitDepth) >> 1)
			}
			e[av1Tl] = ((e[av1Tl - 1] + e[av1Tl + 1]) * 5 + e[av1Tl] * 6 + 8) >> 4 when mode == av1Z2Pred && tw + th >= 6 && filterEdge
		}
		return mode
	}

	def av1Fill(plane uint16[], at int, stride int, w int, h int, v int) {
		let u = uint16(v)
		if (w & 7) == 0 {
			let vv = simd.splat8<uint16>(u)
			for let y = 0; y < h; y++ {
				let o = at + y * stride
				for let x = 0; x < w; x += 8 {
					simd.store8<uint16>(plane, o + x, vv)
				}
			}
			return
		}
		for let y = 0; y < h; y++ {
			let o = at + y * stride
			for let x = 0; x < w; x++ {
				plane[o + x] = u
			}
		}
	}

	def av1DcGen(e int[], w int, h int, mode int, bitDepth int) int {
		if mode == av1TopDcPred {
			let dc = w >> 1
			for let i = 0; i < w; i++ {
				dc += e[av1Tl + 1 + i]
			}
			return dc >> av1Ctz(w)
		}
		if mode == av1LeftDcPred {
			let dc = h >> 1
			for let i = 0; i < h; i++ {
				dc += e[av1Tl - 1 - i]
			}
			return dc >> av1Ctz(h)
		}
		return (1 << bitDepth) >> 1 when mode == av1Dc128Pred
		let dc = (w + h) >> 1
		for let i = 0; i < w; i++ {
			dc += e[av1Tl + 1 + i]
		}
		for let i = 0; i < h; i++ {
			dc += e[av1Tl - 1 - i]
		}
		dc = dc >> av1Ctz(w + h)
		if w != h {
			let quad = w > h * 2 || h > w * 2
			if bitDepth == 8 {
				dc = (dc * (quad ?? (0x3334, 0x5556))) >> 16
			} else {
				dc = (dc * (quad ?? (0x6667, 0xAAAB))) >> 17
			}
		}
		return dc
	}

	def av1FilterStrength(wh int, angle int, sm bool) int {
		if sm {
			if wh <= 8 {
				return 2 when angle >= 64
				return 1 when angle >= 40
			} else if wh <= 16 {
				return 2 when angle >= 48
				return 1 when angle >= 20
			} else if wh <= 24 {
				return 3 when angle >= 4
			} else {
				return 3
			}
		} else {
			if wh <= 8 {
				return 1 when angle >= 56
			} else if wh <= 16 {
				return 1 when angle >= 40
			} else if wh <= 24 {
				return 3 when angle >= 32
				return 2 when angle >= 16
				return 1 when angle >= 8
			} else if wh <= 32 {
				return 3 when angle >= 32
				return 2 when angle >= 4
				return 1
			} else {
				return 3
			}
		}
		return 0
	}

	const av1EdgeKernel = int[0, 4, 8, 4, 0, 0, 5, 6, 5, 0, 2, 4, 4, 4, 2]

	// filter_edge: out[oat + i] for i < sz from in[iat + clip(i, from, to - 1)].
	def av1FilterEdge(out int[], oat int, sz int, limFrom int, limTo int, inp int[], iat int, from int, to int, strength int) {
		let i = 0
		let a = sz < limFrom ?? (sz, limFrom)
		for i < a {
			out[oat + i] = inp[iat + av1ClipI(i, from, to - 1)]
			i++
		}
		let b = limTo < sz ?? (limTo, sz)
		for i < b {
			let s = 0
			for let j = 0; j < 5; j++ {
				s += inp[iat + av1ClipI(i - 2 + j, from, to - 1)] * av1EdgeKernel[(strength - 1) * 5 + j]
			}
			out[oat + i] = (s + 8) >> 4
			i++
		}
		for i < sz {
			out[oat + i] = inp[iat + av1ClipI(i, from, to - 1)]
			i++
		}
	}

	def av1Upsample(out int[], oat int, hsz int, inp int[], iat int, from int, to int, maxv int) {
		let i = 0
		for i < hsz - 1 {
			out[oat + i * 2] = inp[iat + av1ClipI(i, from, to - 1)]
			let s = -inp[iat + av1ClipI(i - 1, from, to - 1)] + 9 * inp[iat + av1ClipI(i, from, to - 1)] + 9 * inp[iat + av1ClipI(i + 1, from, to - 1)] - inp[iat + av1ClipI(i + 2, from, to - 1)]
			let v = (s + 8) >> 4
			out[oat + i * 2 + 1] = v < 0 ?? (0, v > maxv ?? (maxv, v))
			i++
		}
		out[oat + i * 2] = inp[iat + av1ClipI(i, from, to - 1)]
	}

	// The intra predictors: mode `m` from edges `e` into the w x h block
	// at `at` of `plane`; `angle` carries the smooth and edge filter
	// flags; maxW/maxH the samples to the plane edge (for Z2 filtering).
	def av1IntraPred(m int, plane uint16[], at int, stride int, e int[], w int, h int, angle int, maxW int, maxH int, bitDepth int, scratch int[]) {
		let maxv = (1 << bitDepth) - 1
		if m == av1DcPred || m == av1TopDcPred || m == av1LeftDcPred || m == av1Dc128Pred {
			av1Fill(plane, at, stride, w, h, av1DcGen(e, w, h, m, bitDepth))
			return
		}
		if m == av1VertPred {
			for let y = 0; y < h; y++ {
				for let x = 0; x < w; x++ {
					plane[at + y * stride + x] = uint16(e[av1Tl + 1 + x])
				}
			}
			return
		}
		if m == av1HorPred {
			for let y = 0; y < h; y++ {
				let v = uint16(e[av1Tl - 1 - y])
				for let x = 0; x < w; x++ {
					plane[at + y * stride + x] = v
				}
			}
			return
		}
		if m == av1PaethPred {
			let tl = e[av1Tl]
			for let y = 0; y < h; y++ {
				let left = e[av1Tl - 1 - y]
				for let x = 0; x < w; x++ {
					let top = e[av1Tl + 1 + x]
					let base = left + top - tl
					let ld = av1Abs(left - base)
					let td = av1Abs(top - base)
					let tld = av1Abs(tl - base)
					plane[at + y * stride + x] = uint16((ld <= td && ld <= tld) ?? (left, td <= tld ?? (top, tl)))
				}
			}
			return
		}
		if m == av1SmoothPred {
			let right = e[av1Tl + w]
			let bottom = e[av1Tl - h]
			for let y = 0; y < h; y++ {
				let wv = av1SmWeights[h + y]
				for let x = 0; x < w; x++ {
					let wh = av1SmWeights[w + x]
					let p = wv * e[av1Tl + 1 + x] + (256 - wv) * bottom + wh * e[av1Tl - 1 - y] + (256 - wh) * right
					plane[at + y * stride + x] = uint16((p + 256) >> 9)
				}
			}
			return
		}
		if m == av1SmoothVPred {
			let bottom = e[av1Tl - h]
			for let y = 0; y < h; y++ {
				let wv = av1SmWeights[h + y]
				for let x = 0; x < w; x++ {
					plane[at + y * stride + x] = uint16((wv * e[av1Tl + 1 + x] + (256 - wv) * bottom + 128) >> 8)
				}
			}
			return
		}
		if m == av1SmoothHPred {
			let right = e[av1Tl + w]
			for let y = 0; y < h; y++ {
				for let x = 0; x < w; x++ {
					let wh = av1SmWeights[w + x]
					plane[at + y * stride + x] = uint16((wh * e[av1Tl - 1 - y] + (256 - wh) * right + 128) >> 8)
				}
			}
			return
		}
		if m == av1FilterPred {
			av1FilterIntra(plane, at, stride, e, w, h, angle & 511, maxv)
			return
		}
		let sm = ((angle >> 9) & 1) != 0
		let edgeFilter = (angle >> 10) != 0
		let a = angle & 511
		if m == av1Z1Pred {
			let dx = av1DrDerivative[a >> 1]
			let up = edgeFilter && (90 - a) < 40 && w + h <= (16 >> (sm ?? (1, 0)))
			let base0 = 0
			let src = e
			let maxBase = 0
			if up {
				av1Upsample(scratch, 0, w + h, e, av1Tl + 1, -1, w + (w < h ?? (w, h)), maxv)
				src = scratch
				base0 = 0
				maxBase = 2 * (w + h) - 2
				dx = dx << 1
			} else {
				let fs = edgeFilter ?? (av1FilterStrength(w + h, 90 - a, sm), 0)
				if fs != 0 {
					av1FilterEdge(scratch, 0, w + h, 0, w + h, e, av1Tl + 1, -1, w + (w < h ?? (w, h)), fs)
					src = scratch
					base0 = 0
					maxBase = w + h - 1
				} else {
					base0 = av1Tl + 1
					maxBase = w + (w < h ?? (w, h)) - 1
				}
			}
			let inc = up ?? (2, 1)
			let xpos = dx
			for let y = 0; y < h; y++ {
				let frac = xpos & 0x3E
				let base = xpos >> 6
				for let x = 0; x < w; x++ {
					if base < maxBase {
						let v = src[base0 + base] * (64 - frac) + src[base0 + base + 1] * frac
						plane[at + y * stride + x] = uint16((v + 32) >> 6)
					} else {
						let v = uint16(src[base0 + maxBase])
						for let k = x; k < w; k++ {
							plane[at + y * stride + k] = v
						}
						break
					}
					base += inc
				}
				xpos += dx
			}
			return
		}
		if m == av1Z2Pred {
			let dy = av1DrDerivative[(a - 90) >> 1]
			let dx = av1DrDerivative[(180 - a) >> 1]
			let upLeft = edgeFilter && (180 - a) < 40 && w + h <= (16 >> (sm ?? (1, 0)))
			let upAbove = edgeFilter && (a - 90) < 40 && w + h <= (16 >> (sm ?? (1, 0)))
			// edge[64 + 64 + 1] with the top-left at 128 of scratch.
			let tl = 128
			if upAbove {
				av1Upsample(scratch, tl, w + 1, e, av1Tl, 0, w + 1, maxv)
				dx = dx << 1
			} else {
				let fs = edgeFilter ?? (av1FilterStrength(w + h, a - 90, sm), 0)
				if fs != 0 {
					av1FilterEdge(scratch, tl + 1, w, 0, maxW, e, av1Tl + 1, -1, w, fs)
				} else {
					for let i = 0; i < w; i++ {
						scratch[tl + 1 + i] = e[av1Tl + 1 + i]
					}
				}
			}
			if upLeft {
				av1Upsample(scratch, tl - h * 2, h + 1, e, av1Tl - h, 0, h + 1, maxv)
				dy = dy << 1
			} else {
				let fs = edgeFilter ?? (av1FilterStrength(w + h, 180 - a, sm), 0)
				if fs != 0 {
					av1FilterEdge(scratch, tl - h, h, h - maxH, h, e, av1Tl - h, 0, h + 1, fs)
				} else {
					for let i = 0; i < h; i++ {
						scratch[tl - h + i] = e[av1Tl - h + i]
					}
				}
			}
			scratch[tl] = e[av1Tl]
			let incX = upAbove ?? (2, 1)
			let left = tl - (1 + (upLeft ?? (1, 0)))
			let xpos = ((1 + (upAbove ?? (1, 0))) << 6) - dx
			for let y = 0; y < h; y++ {
				let baseX = xpos >> 6
				let fracX = xpos & 0x3E
				let ypos = (y << (6 + (upLeft ?? (1, 0)))) - dy
				for let x = 0; x < w; x++ {
					let v = 0
					if baseX >= 0 {
						v = scratch[tl + baseX] * (64 - fracX) + scratch[tl + baseX + 1] * fracX
					} else {
						let baseY = ypos >> 6
						let fracY = ypos & 0x3E
						v = scratch[left - baseY] * (64 - fracY) + scratch[left - (baseY + 1)] * fracY
					}
					plane[at + y * stride + x] = uint16((v + 32) >> 6)
					baseX += incX
					ypos -= dy
				}
				xpos -= dx
			}
			return
		}
		// Z3.
		let dy = av1DrDerivative[(270 - a) >> 1]
		let up = edgeFilter && (a - 180) < 40 && w + h <= (16 >> (sm ?? (1, 0)))
		let src = e
		let leftAt = av1Tl - 1
		let maxBase = 0
		if up {
			av1Upsample(scratch, 0, w + h, e, av1Tl - (w + h), (w - h > 0 ?? (w - h, 0)), w + h + 1, maxv)
			src = scratch
			leftAt = 2 * (w + h) - 2
			maxBase = 2 * (w + h) - 2
			dy = dy << 1
		} else {
			let fs = edgeFilter ?? (av1FilterStrength(w + h, a - 180, sm), 0)
			if fs != 0 {
				av1FilterEdge(scratch, 0, w + h, 0, w + h, e, av1Tl - (w + h), (w - h > 0 ?? (w - h, 0)), w + h + 1, fs)
				src = scratch
				leftAt = w + h - 1
				maxBase = w + h - 1
			} else {
				maxBase = h + (w < h ?? (w, h)) - 1
			}
		}
		let inc = up ?? (2, 1)
		let ypos = dy
		for let x = 0; x < w; x++ {
			let frac = ypos & 0x3E
			let base = ypos >> 6
			for let y = 0; y < h; y++ {
				if base < maxBase {
					let v = src[leftAt - base] * (64 - frac) + src[leftAt - (base + 1)] * frac
					plane[at + y * stride + x] = uint16((v + 32) >> 6)
				} else {
					let v = uint16(src[leftAt - maxBase])
					for let k = y; k < h; k++ {
						plane[at + k * stride + x] = v
					}
					break
				}
				base += inc
			}
			ypos += dy
		}
	}

	// ipred_filter: the recursive filter intra of 4x2 patches.
	def av1FilterIntra(plane uint16[], at int, stride int, e int[], w int, h int, idx int, maxv int) {
		let f = idx * 56
		for let y = 0; y < h; y += 2 {
			// The top row: the edge for the first two rows, then the block.
			for let x = 0; x < w; x += 4 {
				let p0 = 0
				let p1 = 0
				let p2 = 0
				let p3 = 0
				let p4 = 0
				let p5 = 0
				let p6 = 0
				if y == 0 {
					p0 = x == 0 ?? (e[av1Tl], e[av1Tl + x])
					p1 = e[av1Tl + 1 + x]
					p2 = e[av1Tl + 2 + x]
					p3 = e[av1Tl + 3 + x]
					p4 = e[av1Tl + 4 + x]
				} else {
					let r = at + (y - 1) * stride
					p0 = x == 0 ?? (e[av1Tl - y], int(plane[r + x - 1]))
					p1 = int(plane[r + x])
					p2 = int(plane[r + x + 1])
					p3 = int(plane[r + x + 2])
					p4 = int(plane[r + x + 3])
				}
				if x == 0 {
					p5 = e[av1Tl - 1 - y]
					p6 = e[av1Tl - 2 - y]
				} else {
					p5 = int(plane[at + y * stride + x - 1])
					p6 = int(plane[at + (y + 1) * stride + x - 1])
				}
				for let yy = 0; yy < 2; yy++ {
					for let xx = 0; xx < 4; xx++ {
						let t = f + (yy * 4 + xx) * 7
						let acc = av1FilterIntraTaps[t] * p0 + av1FilterIntraTaps[t + 1] * p1 + av1FilterIntraTaps[t + 2] * p2 + av1FilterIntraTaps[t + 3] * p3 + av1FilterIntraTaps[t + 4] * p4 + av1FilterIntraTaps[t + 5] * p5 + av1FilterIntraTaps[t + 6] * p6
						let v = (acc + 8) >> 4
						plane[at + (y + yy) * stride + x + xx] = uint16(v < 0 ?? (0, v > maxv ?? (maxv, v)))
					}
				}
			}
		}
	}

	// cfl_ac: the luma AC of a w x h chroma block from the luma at
	// `yat`, padded by wPad/hPad 4-sample units, DC removed.
	def av1CflAc(ac int[], y uint16[], yat int, stride int, wPad int, hPad int, w int, h int, ssHor int, ssVer int) {
		let yy = 0
		let src = yat
		for yy < h - 4 * hPad {
			let x = 0
			for x < w - 4 * wPad {
				let s = int(y[src + (x << ssHor)])
				s += int(y[src + x * 2 + 1]) when ssHor == 1
				if ssVer == 1 {
					s += int(y[src + (x << ssHor) + stride])
					s += int(y[src + x * 2 + 1 + stride]) when ssHor == 1
				}
				ac[yy * w + x] = s << (1 + (ssVer == 0 ?? (1, 0)) + (ssHor == 0 ?? (1, 0)))
				x++
			}
			for x < w {
				ac[yy * w + x] = ac[yy * w + x - 1]
				x++
			}
			src += stride << ssVer
			yy++
		}
		for yy < h {
			for let x = 0; x < w; x++ {
				ac[yy * w + x] = ac[(yy - 1) * w + x]
			}
			yy++
		}
		let log2 = av1Ctz(w) + av1Ctz(h)
		let sum = (1 << log2) >> 1
		for let i = 0; i < w * h; i++ {
			sum += ac[i]
		}
		sum = sum >> log2
		for let i = 0; i < w * h; i++ {
			ac[i] -= sum
		}
	}

	// cfl_pred over the DC of `m` (DC, top, left or 128).
	def av1CflPredict(plane uint16[], at int, stride int, e int[], w int, h int, m int, ac int[], alpha int, bitDepth int) {
		let maxv = (1 << bitDepth) - 1
		let dc = av1DcGen(e, w, h, m, bitDepth)
		for let y = 0; y < h; y++ {
			for let x = 0; x < w; x++ {
				let diff = alpha * ac[y * w + x]
				let v = dc + av1ApplySign((av1Abs(diff) + 32) >> 6, diff)
				plane[at + y * stride + x] = uint16(v < 0 ?? (0, v > maxv ?? (maxv, v)))
			}
		}
	}

	// pal_pred: palette colours by the index map (row stride w).
	def av1PalPred(plane uint16[], at int, stride int, pal int[], palAt int, idx int[], w int, h int) {
		for let y = 0; y < h; y++ {
			for let x = 0; x < w; x++ {
				plane[at + y * stride + x] = uint16(pal[palAt + idx[y * w + x]])
			}
		}
	}
}
