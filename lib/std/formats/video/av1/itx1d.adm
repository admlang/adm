internal partial module std.formats.video.av1 {
	// The one-dimensional inverse transforms of dav1d's itx_1d.c: DCT 4 to
	// 64, ADST 4 to 16 (flipped by a negative output stride), over 32-bit
	// coefficients `c[at + k * stride]`, intermediate results clipped to
	// [mn, mx]. Generated from dav1d by a translation script; the
	// arithmetic is kept exactly.

	def av1Clip(mn int, mx int, v int) int {
		return v < mn ?? (mn, v > mx ?? (mx, v))
	}

	def av1Dct4(c int32[], at int, stride int, mn int, mx int, tx64 int) {
		let in0 = int(c[at + 0 * stride])
		let in1 = int(c[at + 1 * stride])
		let t0 = 0
		let t1 = 0
		let t2 = 0
		let t3 = 0
		if tx64 != 0 {
			t0 = (in0 * 181 + 128) >> 8
			t1 = t0
			t2 = (in1 * 1567 + 2048) >> 12
			t3 = (in1 * 3784 + 2048) >> 12
		} else {
			let in2 = int(c[at + 2 * stride])
			let in3 = int(c[at + 3 * stride])
			t0 = ((in0 + in2) * 181 + 128) >> 8
			t1 = ((in0 - in2) * 181 + 128) >> 8
			t2 = ((in1 * 1567 - in3 * (3784 - 4096) + 2048) >> 12) - in3
			t3 = ((in1 * (3784 - 4096) + in3 * 1567 + 2048) >> 12) + in1
		}
		c[at + 0 * stride] = int32(av1Clip(mn, mx, t0 + t3))
		c[at + 1 * stride] = int32(av1Clip(mn, mx, t1 + t2))
		c[at + 2 * stride] = int32(av1Clip(mn, mx, t1 - t2))
		c[at + 3 * stride] = int32(av1Clip(mn, mx, t0 - t3))
	}

	def av1Dct8(c int32[], at int, stride int, mn int, mx int, tx64 int) {
		av1Dct4(c, at, stride << 1, mn, mx, tx64)
		let in1 = int(c[at + 1 * stride])
		let in3 = int(c[at + 3 * stride])
		let t4a = 0
		let t5a = 0
		let t6a = 0
		let t7a = 0
		if tx64 != 0 {
			t4a = (in1 * 799 + 2048) >> 12
			t5a = (in3 * -2276 + 2048) >> 12
			t6a = (in3 * 3406 + 2048) >> 12
			t7a = (in1 * 4017 + 2048) >> 12
		} else {
			let in5 = int(c[at + 5 * stride])
			let in7 = int(c[at + 7 * stride])
			t4a = ((in1 * 799 - in7 * (4017 - 4096) + 2048) >> 12) - in7
			t5a = (in5 * 1703 - in3 * 1138 + 1024) >> 11
			t6a = (in5 * 1138 + in3 * 1703 + 1024) >> 11
			t7a = ((in1 * (4017 - 4096) + in7 * 799 + 2048) >> 12) + in1
		}
		let t4 = av1Clip(mn, mx, t4a + t5a)
		t5a = av1Clip(mn, mx, t4a - t5a)
		let t7 = av1Clip(mn, mx, t7a + t6a)
		t6a = av1Clip(mn, mx, t7a - t6a)
		let t5 = ((t6a - t5a) * 181 + 128) >> 8
		let t6 = ((t6a + t5a) * 181 + 128) >> 8
		let t0 = int(c[at + 0 * stride])
		let t1 = int(c[at + 2 * stride])
		let t2 = int(c[at + 4 * stride])
		let t3 = int(c[at + 6 * stride])
		c[at + 0 * stride] = int32(av1Clip(mn, mx, t0 + t7))
		c[at + 1 * stride] = int32(av1Clip(mn, mx, t1 + t6))
		c[at + 2 * stride] = int32(av1Clip(mn, mx, t2 + t5))
		c[at + 3 * stride] = int32(av1Clip(mn, mx, t3 + t4))
		c[at + 4 * stride] = int32(av1Clip(mn, mx, t3 - t4))
		c[at + 5 * stride] = int32(av1Clip(mn, mx, t2 - t5))
		c[at + 6 * stride] = int32(av1Clip(mn, mx, t1 - t6))
		c[at + 7 * stride] = int32(av1Clip(mn, mx, t0 - t7))
	}

	def av1Dct16(c int32[], at int, stride int, mn int, mx int, tx64 int) {
		av1Dct8(c, at, stride << 1, mn, mx, tx64)
		let in1 = int(c[at + 1 * stride])
		let in3 = int(c[at + 3 * stride])
		let in5 = int(c[at + 5 * stride])
		let in7 = int(c[at + 7 * stride])
		let t8a = 0
		let t9a = 0
		let t10a = 0
		let t11a = 0
		let t12a = 0
		let t13a = 0
		let t14a = 0
		let t15a = 0
		if tx64 != 0 {
			t8a = (in1 * 401 + 2048) >> 12
			t9a = (in7 * -2598 + 2048) >> 12
			t10a = (in5 * 1931 + 2048) >> 12
			t11a = (in3 * -1189 + 2048) >> 12
			t12a = (in3 * 3920 + 2048) >> 12
			t13a = (in5 * 3612 + 2048) >> 12
			t14a = (in7 * 3166 + 2048) >> 12
			t15a = (in1 * 4076 + 2048) >> 12
		} else {
			let in9 = int(c[at + 9 * stride])
			let in11 = int(c[at + 11 * stride])
			let in13 = int(c[at + 13 * stride])
			let in15 = int(c[at + 15 * stride])
			t8a = ((in1 * 401 - in15 * (4076 - 4096) + 2048) >> 12) - in15
			t9a = (in9 * 1583 - in7 * 1299 + 1024) >> 11
			t10a = ((in5 * 1931 - in11 * (3612 - 4096) + 2048) >> 12) - in11
			t11a = ((in13 * (3920 - 4096) - in3 * 1189 + 2048) >> 12) + in13
			t12a = ((in13 * 1189 + in3 * (3920 - 4096) + 2048) >> 12) + in3
			t13a = ((in5 * (3612 - 4096) + in11 * 1931 + 2048) >> 12) + in5
			t14a = (in9 * 1299 + in7 * 1583 + 1024) >> 11
			t15a = ((in1 * (4076 - 4096) + in15 * 401 + 2048) >> 12) + in1
		}
		let t8 = av1Clip(mn, mx, t8a + t9a)
		let t9 = av1Clip(mn, mx, t8a - t9a)
		let t10 = av1Clip(mn, mx, t11a - t10a)
		let t11 = av1Clip(mn, mx, t11a + t10a)
		let t12 = av1Clip(mn, mx, t12a + t13a)
		let t13 = av1Clip(mn, mx, t12a - t13a)
		let t14 = av1Clip(mn, mx, t15a - t14a)
		let t15 = av1Clip(mn, mx, t15a + t14a)
		t9a = ((t14 * 1567 - t9 * (3784 - 4096) + 2048) >> 12) - t9
		t14a = ((t14 * (3784 - 4096) + t9 * 1567 + 2048) >> 12) + t14
		t10a = ((-(t13 * (3784 - 4096) + t10 * 1567) + 2048) >> 12) - t13
		t13a = ((t13 * 1567 - t10 * (3784 - 4096) + 2048) >> 12) - t10
		t8a = av1Clip(mn, mx, t8 + t11)
		t9 = av1Clip(mn, mx, t9a + t10a)
		t10 = av1Clip(mn, mx, t9a - t10a)
		t11a = av1Clip(mn, mx, t8 - t11)
		t12a = av1Clip(mn, mx, t15 - t12)
		t13 = av1Clip(mn, mx, t14a - t13a)
		t14 = av1Clip(mn, mx, t14a + t13a)
		t15a = av1Clip(mn, mx, t15 + t12)
		t10a = ((t13 - t10) * 181 + 128) >> 8
		t13a = ((t13 + t10) * 181 + 128) >> 8
		t11 = ((t12a - t11a) * 181 + 128) >> 8
		t12 = ((t12a + t11a) * 181 + 128) >> 8
		let t0 = int(c[at + 0 * stride])
		let t1 = int(c[at + 2 * stride])
		let t2 = int(c[at + 4 * stride])
		let t3 = int(c[at + 6 * stride])
		let t4 = int(c[at + 8 * stride])
		let t5 = int(c[at + 10 * stride])
		let t6 = int(c[at + 12 * stride])
		let t7 = int(c[at + 14 * stride])
		c[at + 0 * stride] = int32(av1Clip(mn, mx, t0 + t15a))
		c[at + 1 * stride] = int32(av1Clip(mn, mx, t1 + t14))
		c[at + 2 * stride] = int32(av1Clip(mn, mx, t2 + t13a))
		c[at + 3 * stride] = int32(av1Clip(mn, mx, t3 + t12))
		c[at + 4 * stride] = int32(av1Clip(mn, mx, t4 + t11))
		c[at + 5 * stride] = int32(av1Clip(mn, mx, t5 + t10a))
		c[at + 6 * stride] = int32(av1Clip(mn, mx, t6 + t9))
		c[at + 7 * stride] = int32(av1Clip(mn, mx, t7 + t8a))
		c[at + 8 * stride] = int32(av1Clip(mn, mx, t7 - t8a))
		c[at + 9 * stride] = int32(av1Clip(mn, mx, t6 - t9))
		c[at + 10 * stride] = int32(av1Clip(mn, mx, t5 - t10a))
		c[at + 11 * stride] = int32(av1Clip(mn, mx, t4 - t11))
		c[at + 12 * stride] = int32(av1Clip(mn, mx, t3 - t12))
		c[at + 13 * stride] = int32(av1Clip(mn, mx, t2 - t13a))
		c[at + 14 * stride] = int32(av1Clip(mn, mx, t1 - t14))
		c[at + 15 * stride] = int32(av1Clip(mn, mx, t0 - t15a))
	}

	def av1Dct32(c int32[], at int, stride int, mn int, mx int, tx64 int) {
		av1Dct16(c, at, stride << 1, mn, mx, tx64)
		let in1 = int(c[at + 1 * stride])
		let in3 = int(c[at + 3 * stride])
		let in5 = int(c[at + 5 * stride])
		let in7 = int(c[at + 7 * stride])
		let in9 = int(c[at + 9 * stride])
		let in11 = int(c[at + 11 * stride])
		let in13 = int(c[at + 13 * stride])
		let in15 = int(c[at + 15 * stride])
		let t16a = 0
		let t17a = 0
		let t18a = 0
		let t19a = 0
		let t20a = 0
		let t21a = 0
		let t22a = 0
		let t23a = 0
		let t24a = 0
		let t25a = 0
		let t26a = 0
		let t27a = 0
		let t28a = 0
		let t29a = 0
		let t30a = 0
		let t31a = 0
		if tx64 != 0 {
			t16a = (in1 * 201 + 2048) >> 12
			t17a = (in15 * -2751 + 2048) >> 12
			t18a = (in9 * 1751 + 2048) >> 12
			t19a = (in7 * -1380 + 2048) >> 12
			t20a = (in5 * 995 + 2048) >> 12
			t21a = (in11 * -2106 + 2048) >> 12
			t22a = (in13 * 2440 + 2048) >> 12
			t23a = (in3 * -601 + 2048) >> 12
			t24a = (in3 * 4052 + 2048) >> 12
			t25a = (in13 * 3290 + 2048) >> 12
			t26a = (in11 * 3513 + 2048) >> 12
			t27a = (in5 * 3973 + 2048) >> 12
			t28a = (in7 * 3857 + 2048) >> 12
			t29a = (in9 * 3703 + 2048) >> 12
			t30a = (in15 * 3035 + 2048) >> 12
			t31a = (in1 * 4091 + 2048) >> 12
		} else {
			let in17 = int(c[at + 17 * stride])
			let in19 = int(c[at + 19 * stride])
			let in21 = int(c[at + 21 * stride])
			let in23 = int(c[at + 23 * stride])
			let in25 = int(c[at + 25 * stride])
			let in27 = int(c[at + 27 * stride])
			let in29 = int(c[at + 29 * stride])
			let in31 = int(c[at + 31 * stride])
			t16a = ((in1 * 201 - in31 * (4091 - 4096) + 2048) >> 12) - in31
			t17a = ((in17 * (3035 - 4096) - in15 * 2751 + 2048) >> 12) + in17
			t18a = ((in9 * 1751 - in23 * (3703 - 4096) + 2048) >> 12) - in23
			t19a = ((in25 * (3857 - 4096) - in7 * 1380 + 2048) >> 12) + in25
			t20a = ((in5 * 995 - in27 * (3973 - 4096) + 2048) >> 12) - in27
			t21a = ((in21 * (3513 - 4096) - in11 * 2106 + 2048) >> 12) + in21
			t22a = (in13 * 1220 - in19 * 1645 + 1024) >> 11
			t23a = ((in29 * (4052 - 4096) - in3 * 601 + 2048) >> 12) + in29
			t24a = ((in29 * 601 + in3 * (4052 - 4096) + 2048) >> 12) + in3
			t25a = (in13 * 1645 + in19 * 1220 + 1024) >> 11
			t26a = ((in21 * 2106 + in11 * (3513 - 4096) + 2048) >> 12) + in11
			t27a = ((in5 * (3973 - 4096) + in27 * 995 + 2048) >> 12) + in5
			t28a = ((in25 * 1380 + in7 * (3857 - 4096) + 2048) >> 12) + in7
			t29a = ((in9 * (3703 - 4096) + in23 * 1751 + 2048) >> 12) + in9
			t30a = ((in17 * 2751 + in15 * (3035 - 4096) + 2048) >> 12) + in15
			t31a = ((in1 * (4091 - 4096) + in31 * 201 + 2048) >> 12) + in1
		}
		let t16 = av1Clip(mn, mx, t16a + t17a)
		let t17 = av1Clip(mn, mx, t16a - t17a)
		let t18 = av1Clip(mn, mx, t19a - t18a)
		let t19 = av1Clip(mn, mx, t19a + t18a)
		let t20 = av1Clip(mn, mx, t20a + t21a)
		let t21 = av1Clip(mn, mx, t20a - t21a)
		let t22 = av1Clip(mn, mx, t23a - t22a)
		let t23 = av1Clip(mn, mx, t23a + t22a)
		let t24 = av1Clip(mn, mx, t24a + t25a)
		let t25 = av1Clip(mn, mx, t24a - t25a)
		let t26 = av1Clip(mn, mx, t27a - t26a)
		let t27 = av1Clip(mn, mx, t27a + t26a)
		let t28 = av1Clip(mn, mx, t28a + t29a)
		let t29 = av1Clip(mn, mx, t28a - t29a)
		let t30 = av1Clip(mn, mx, t31a - t30a)
		let t31 = av1Clip(mn, mx, t31a + t30a)
		t17a = ((t30 * 799 - t17 * (4017 - 4096) + 2048) >> 12) - t17
		t30a = ((t30 * (4017 - 4096) + t17 * 799 + 2048) >> 12) + t30
		t18a = ((-(t29 * (4017 - 4096) + t18 * 799) + 2048) >> 12) - t29
		t29a = ((t29 * 799 - t18 * (4017 - 4096) + 2048) >> 12) - t18
		t21a = (t26 * 1703 - t21 * 1138 + 1024) >> 11
		t26a = (t26 * 1138 + t21 * 1703 + 1024) >> 11
		t22a = (-(t25 * 1138 + t22 * 1703) + 1024) >> 11
		t25a = (t25 * 1703 - t22 * 1138 + 1024) >> 11
		t16a = av1Clip(mn, mx, t16 + t19)
		t17 = av1Clip(mn, mx, t17a + t18a)
		t18 = av1Clip(mn, mx, t17a - t18a)
		t19a = av1Clip(mn, mx, t16 - t19)
		t20a = av1Clip(mn, mx, t23 - t20)
		t21 = av1Clip(mn, mx, t22a - t21a)
		t22 = av1Clip(mn, mx, t22a + t21a)
		t23a = av1Clip(mn, mx, t23 + t20)
		t24a = av1Clip(mn, mx, t24 + t27)
		t25 = av1Clip(mn, mx, t25a + t26a)
		t26 = av1Clip(mn, mx, t25a - t26a)
		t27a = av1Clip(mn, mx, t24 - t27)
		t28a = av1Clip(mn, mx, t31 - t28)
		t29 = av1Clip(mn, mx, t30a - t29a)
		t30 = av1Clip(mn, mx, t30a + t29a)
		t31a = av1Clip(mn, mx, t31 + t28)
		t18a = ((t29 * 1567 - t18 * (3784 - 4096) + 2048) >> 12) - t18
		t29a = ((t29 * (3784 - 4096) + t18 * 1567 + 2048) >> 12) + t29
		t19 = ((t28a * 1567 - t19a * (3784 - 4096) + 2048) >> 12) - t19a
		t28 = ((t28a * (3784 - 4096) + t19a * 1567 + 2048) >> 12) + t28a
		t20 = ((-(t27a * (3784 - 4096) + t20a * 1567) + 2048) >> 12) - t27a
		t27 = ((t27a * 1567 - t20a * (3784 - 4096) + 2048) >> 12) - t20a
		t21a = ((-(t26 * (3784 - 4096) + t21 * 1567) + 2048) >> 12) - t26
		t26a = ((t26 * 1567 - t21 * (3784 - 4096) + 2048) >> 12) - t21
		t16 = av1Clip(mn, mx, t16a + t23a)
		t17a = av1Clip(mn, mx, t17 + t22)
		t18 = av1Clip(mn, mx, t18a + t21a)
		t19a = av1Clip(mn, mx, t19 + t20)
		t20a = av1Clip(mn, mx, t19 - t20)
		t21 = av1Clip(mn, mx, t18a - t21a)
		t22a = av1Clip(mn, mx, t17 - t22)
		t23 = av1Clip(mn, mx, t16a - t23a)
		t24 = av1Clip(mn, mx, t31a - t24a)
		t25a = av1Clip(mn, mx, t30 - t25)
		t26 = av1Clip(mn, mx, t29a - t26a)
		t27a = av1Clip(mn, mx, t28 - t27)
		t28a = av1Clip(mn, mx, t28 + t27)
		t29 = av1Clip(mn, mx, t29a + t26a)
		t30a = av1Clip(mn, mx, t30 + t25)
		t31 = av1Clip(mn, mx, t31a + t24a)
		t20 = ((t27a - t20a) * 181 + 128) >> 8
		t27 = ((t27a + t20a) * 181 + 128) >> 8
		t21a = ((t26 - t21) * 181 + 128) >> 8
		t26a = ((t26 + t21) * 181 + 128) >> 8
		t22 = ((t25a - t22a) * 181 + 128) >> 8
		t25 = ((t25a + t22a) * 181 + 128) >> 8
		t23a = ((t24 - t23) * 181 + 128) >> 8
		t24a = ((t24 + t23) * 181 + 128) >> 8
		let t0 = int(c[at + 0 * stride])
		let t1 = int(c[at + 2 * stride])
		let t2 = int(c[at + 4 * stride])
		let t3 = int(c[at + 6 * stride])
		let t4 = int(c[at + 8 * stride])
		let t5 = int(c[at + 10 * stride])
		let t6 = int(c[at + 12 * stride])
		let t7 = int(c[at + 14 * stride])
		let t8 = int(c[at + 16 * stride])
		let t9 = int(c[at + 18 * stride])
		let t10 = int(c[at + 20 * stride])
		let t11 = int(c[at + 22 * stride])
		let t12 = int(c[at + 24 * stride])
		let t13 = int(c[at + 26 * stride])
		let t14 = int(c[at + 28 * stride])
		let t15 = int(c[at + 30 * stride])
		c[at + 0 * stride] = int32(av1Clip(mn, mx, t0 + t31))
		c[at + 1 * stride] = int32(av1Clip(mn, mx, t1 + t30a))
		c[at + 2 * stride] = int32(av1Clip(mn, mx, t2 + t29))
		c[at + 3 * stride] = int32(av1Clip(mn, mx, t3 + t28a))
		c[at + 4 * stride] = int32(av1Clip(mn, mx, t4 + t27))
