	def av1Identity(c int32[], at int, stride int, n int) {
		for let i = 0; i < n; i++ {
			let v = int(c[at + stride * i])
			if n == 4 {
				c[at + stride * i] = int32(v + ((v * 1697 + 2048) >> 12))
			} else if n == 8 {
				c[at + stride * i] = int32(v * 2)
			} else if n == 16 {
				c[at + stride * i] = int32(2 * v + ((v * 1697 + 1024) >> 11))
			} else {
				c[at + stride * i] = int32(v * 4)
			}
		}
	}

	def av1Wht4(c int32[], at int, stride int) {
		let in0 = int(c[at])
		let in1 = int(c[at + stride])
		let in2 = int(c[at + 2 * stride])
		let in3 = int(c[at + 3 * stride])
		let t0 = in0 + in1
		let t2 = in2 - in3
		let t4 = (t0 - t2) >> 1
		let t3 = t4 - in3
		let t1 = t4 - in1
		c[at] = int32(t0 - t3)
		c[at + stride] = int32(t3)
		c[at + 2 * stride] = int32(t1)
		c[at + 3 * stride] = int32(t2 + t1)
	}

	// One inverse transform of `n` = 4 << log2n points of 1D type `kind`
	// (0 DCT, 1 ADST, 2 FLIPADST, 3 identity).
	def av1Itx1d(kind int, log2n int, c int32[], at int, stride int, mn int, mx int) {
		let n = 4 << log2n
		if kind == 3 {
			av1Identity(c, at, stride, n)
			return
		}
		if kind == 0 {
			match log2n {
				case 0:
					av1Dct4(c, at, stride, mn, mx, 0)
				case 1:
					av1Dct8(c, at, stride, mn, mx, 0)
				case 2:
					av1Dct16(c, at, stride, mn, mx, 0)
				case 3:
					av1Dct32(c, at, stride, mn, mx, 0)
				default:
					av1Dct64(c, at, stride, mn, mx)
			}
			return
		}
		let oat = kind == 2 ?? (at + (n - 1) * stride, at)
		let os = kind == 2 ?? (-stride, stride)
		match log2n {
			case 0:
				av1Adst4(c, at, stride, mn, mx, oat, os)
			case 1:
				av1Adst8(c, at, stride, mn, mx, oat, os)
			default:
				av1Adst16(c, at, stride, mn, mx, oat, os)
		}
	}
}
