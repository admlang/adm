		t13 = ((t13a * 799 + t12a * (4017 - 4096) + 2048) >> 12) + t12a
		t14 = ((t15a * 2276 - t14a * (3406 - 4096) + 2048) >> 12) - t14a
		t15 = ((t15a * (3406 - 4096) + t14a * 2276 + 2048) >> 12) + t15a
