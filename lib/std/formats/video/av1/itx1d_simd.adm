internal partial module std.formats.video.av1 {
	use std.simd

	// Eight 1D inverse transforms at once, generated from av1/itx1d.adm by
	// ~/.cache/adm-scratch/av1/gen_itx_simd.py: element k of lane j at
	// c[at + k * stride + j].

	def av1Dct4V(c int32[], at int, stride int, mn int, mx int, tx64 int) {
		let mnv = simd.splat8<int32>(int32(mn))
		let mxv = simd.splat8<int32>(int32(mx))
		let in0 = simd.load8<int32>(c, at + 0 * stride)
		let in1 = simd.load8<int32>(c, at + 1 * stride)
		let t0 = simd.splat8<int32>(int32(0))
		let t1 = simd.splat8<int32>(int32(0))
		let t2 = simd.splat8<int32>(int32(0))
		let t3 = simd.splat8<int32>(int32(0))
		if tx64 != 0 {
			t0 = (in0 * simd.splat8<int32>(int32(181)) + simd.splat8<int32>(int32(128))) >> 8
			t1 = t0
			t2 = (in1 * simd.splat8<int32>(int32(1567)) + simd.splat8<int32>(int32(2048))) >> 12
			t3 = (in1 * simd.splat8<int32>(int32(3784)) + simd.splat8<int32>(int32(2048))) >> 12
		} else {
			let in2 = simd.load8<int32>(c, at + 2 * stride)
			let in3 = simd.load8<int32>(c, at + 3 * stride)
			t0 = ((in0 + in2) * simd.splat8<int32>(int32(181)) + simd.splat8<int32>(int32(128))) >> 8
			t1 = ((in0 - in2) * simd.splat8<int32>(int32(181)) + simd.splat8<int32>(int32(128))) >> 8
			t2 = ((in1 * simd.splat8<int32>(int32(1567)) - in3 * (simd.splat8<int32>(int32(3784)) - simd.splat8<int32>(int32(4096))) + simd.splat8<int32>(int32(2048))) >> 12) - in3
			t3 = ((in1 * (simd.splat8<int32>(int32(3784)) - simd.splat8<int32>(int32(4096))) + in3 * simd.splat8<int32>(int32(1567)) + simd.splat8<int32>(int32(2048))) >> 12) + in1
		}
		simd.store8<int32>(c, at + 0 * stride, simd.clamp(t0 + t3, mnv, mxv))
		simd.store8<int32>(c, at + 1 * stride, simd.clamp(t1 + t2, mnv, mxv))
		simd.store8<int32>(c, at + 2 * stride, simd.clamp(t1 - t2, mnv, mxv))
		simd.store8<int32>(c, at + 3 * stride, simd.clamp(t0 - t3, mnv, mxv))
	}

	def av1Dct8V(c int32[], at int, stride int, mn int, mx int, tx64 int) {
		let mnv = simd.splat8<int32>(int32(mn))
		let mxv = simd.splat8<int32>(int32(mx))
		av1Dct4V(c, at, stride << 1, mn, mx, tx64)
		let in1 = simd.load8<int32>(c, at + 1 * stride)
		let in3 = simd.load8<int32>(c, at + 3 * stride)
		let t4a = simd.splat8<int32>(int32(0))
		let t5a = simd.splat8<int32>(int32(0))
		let t6a = simd.splat8<int32>(int32(0))
		let t7a = simd.splat8<int32>(int32(0))
		if tx64 != 0 {
			t4a = (in1 * simd.splat8<int32>(int32(799)) + simd.splat8<int32>(int32(2048))) >> 12
			t5a = (in3 * simd.splat8<int32>(int32(-2276)) + simd.splat8<int32>(int32(2048))) >> 12
			t6a = (in3 * simd.splat8<int32>(int32(3406)) + simd.splat8<int32>(int32(2048))) >> 12
			t7a = (in1 * simd.splat8<int32>(int32(4017)) + simd.splat8<int32>(int32(2048))) >> 12
		} else {
			let in5 = simd.load8<int32>(c, at + 5 * stride)
			let in7 = simd.load8<int32>(c, at + 7 * stride)
			t4a = ((in1 * simd.splat8<int32>(int32(799)) - in7 * (simd.splat8<int32>(int32(4017)) - simd.splat8<int32>(int32(4096))) + simd.splat8<int32>(int32(2048))) >> 12) - in7
			t5a = (in5 * simd.splat8<int32>(int32(1703)) - in3 * simd.splat8<int32>(int32(1138)) + simd.splat8<int32>(int32(1024))) >> 11
			t6a = (in5 * simd.splat8<int32>(int32(1138)) + in3 * simd.splat8<int32>(int32(1703)) + simd.splat8<int32>(int32(1024))) >> 11
			t7a = ((in1 * (simd.splat8<int32>(int32(4017)) - simd.splat8<int32>(int32(4096))) + in7 * simd.splat8<int32>(int32(799)) + simd.splat8<int32>(int32(2048))) >> 12) + in1
		}
		let t4 = simd.clamp(t4a + t5a, mnv, mxv)
		t5a = simd.clamp(t4a - t5a, mnv, mxv)
		let t7 = simd.clamp(t7a + t6a, mnv, mxv)
		t6a = simd.clamp(t7a - t6a, mnv, mxv)
		let t5 = ((t6a - t5a) * simd.splat8<int32>(int32(181)) + simd.splat8<int32>(int32(128))) >> 8
		let t6 = ((t6a + t5a) * simd.splat8<int32>(int32(181)) + simd.splat8<int32>(int32(128))) >> 8
		let t0 = simd.load8<int32>(c, at + 0 * stride)
		let t1 = simd.load8<int32>(c, at + 2 * stride)
		let t2 = simd.load8<int32>(c, at + 4 * stride)
		let t3 = simd.load8<int32>(c, at + 6 * stride)
		simd.store8<int32>(c, at + 0 * stride, simd.clamp(t0 + t7, mnv, mxv))
		simd.store8<int32>(c, at + 1 * stride, simd.clamp(t1 + t6, mnv, mxv))
		simd.store8<int32>(c, at + 2 * stride, simd.clamp(t2 + t5, mnv, mxv))
		simd.store8<int32>(c, at + 3 * stride, simd.clamp(t3 + t4, mnv, mxv))
		simd.store8<int32>(c, at + 4 * stride, simd.clamp(t3 - t4, mnv, mxv))
		simd.store8<int32>(c, at + 5 * stride, simd.clamp(t2 - t5, mnv, mxv))
		simd.store8<int32>(c, at + 6 * stride, simd.clamp(t1 - t6, mnv, mxv))
		simd.store8<int32>(c, at + 7 * stride, simd.clamp(t0 - t7, mnv, mxv))
	}

