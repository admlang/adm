internal partial module std.formats.video.av1 {
	// Post-filter passes in bands on tasks: every band writes only its own
	// rows (or, for horizontal deblocking edges, columns) and has its own
	// scratch, so the result does not depend on which band finishes first.

	const av1MaxBands = 8

	// Scratch of one band of the post filters.
	type Av1Scratch {
		cdefTmp int32[]
		cdefVar int[]
		cdefPs  int32[]
		lrPad   int32[]
		lrMid   int32[]
		lrA     int[]
		lrB     int[]
		lrF0    int[]
		lrF1    int[]
		line    uint16[]

		def new() {
			cdefTmp.len(144)
			cdefVar.len(9)
			cdefPs.len(136)
			lrPad = int32[]
			lrMid = int32[]
			lrA = int[]
			lrB = int[]
			lrF0 = int[]
			lrF1 = int[]
			line = uint16[]
		}
	}

	// Bands for `units` rows of work: one per 16 units, up to av1MaxBands.
	def av1BandCount(units int) int {
		return av1Max(1, av1Min(av1MaxBands, units / 16))
	}

	async def av1CdefTask(t Av1Tile, sc Av1Scratch, from int, to int, done channel<bool>) {
		av1CdefRows(t, sc, from, to)
		done <- true
	}

	async def av1DeblockTask(t Av1Tile, p uint16[], stride int, w4 int, h4 int, edges byte[], slot int, luma bool, lutE int[], lutI int[], vertical bool, from int, to int, done channel<bool>) {
		if vertical {
			av1DeblockRows(t, p, stride, w4, h4, edges, slot, luma, lutE, lutI, from, to)
		} else {
			av1DeblockCols(t, p, stride, w4, h4, edges, slot, luma, lutE, lutI, from, to)
		}
		done <- true
	}

	async def av1LrTask(t Av1Tile, sc Av1Scratch, p int, dst uint16[], src uint16[], deb uint16[], stride int, from int, to int, done channel<bool>) {
		av1LrStripes(t, sc, p, dst, src, deb, stride, from, to)
		done <- true
	}

	async def av1ResizeTask(p uint16[], stride int, from int, to int, inW int, srcW int, dstW int, maxv int, line uint16[], done channel<bool>) {
		av1Resize(p, stride, from, to, inW, srcW, dstW, maxv, line)
		done <- true
	}
}
