internal partial module std.formats.video.av1 {
	// The mv value of an intra block in the motion field.
	const av1InvalidMv = -32768

	// A decoded frame and what later frames need of it.
	type Av1Frame {
		y            uint16[]
		u            uint16[]
		v            uint16[]
		stride       int
		cstride      int
		// Coded width (before superres upscaling), height, and the
		// upscaled width the planes hold after upscaling.
		width        int
		height       int
		upWidth      int
		renderWidth  int
		renderHeight int
		bitDepth     int
		ssHor        int
		ssVer        int
		layout       int
		hdr          Av1FrameHdr
		// The CDFs at the end of the frame, for frames that load them.
		cdf          int[]
		cdfValid     bool
		// Segment ids per 4x4 block.
		segmap       byte[]
		segValid     bool
		// Temporal motion per 8x8 block: the vectors and the reference
		// (0 for none) of the last block covering it.
		rpMvx        int16[]
		rpMvy        int16[]
		rpRef        int8[]
		rpStride     int
		rpValid      bool
		// Order hints of the frame's references (ref_ref_poc).
		refPoc       int[]
		pts          duration
		hasPts       bool
		length       duration
		showable     bool

		def new() {
			hdr = new Av1FrameHdr()
			refPoc.len(7)
		}

		// Allocates the planes for `w` x `h` coded samples (planes wide
		// enough for `upW` after superres).
		def alloc(w int, h int, upW int, depth int, layout int) {
			width = w
			height = h
			upWidth = upW
			bitDepth = depth
			self.layout = layout
			ssHor = (layout == 1 || layout == 2) ?? (1, 0)
			ssVer = layout == 1 ?? (1, 0)
			let wide = upW > w ?? (upW, w)
			stride = ((wide + 127) & ~127) + 64
			let rows = ((h + 127) & ~127) + 64
			y.len(stride * rows)
			if layout != 0 {
				cstride = stride >> ssHor
				u.len(cstride * (rows >> ssVer))
				v.len(cstride * (rows >> ssVer))
			}
		}
	}

	// A loop restoration unit's parameters.
	type Av1LrUnit {
		kind       int
		// Wiener taps 0-2 vertical and horizontal, self-guided weights.
		filterV    int[]
		filterH    int[]
		sgrWeights int[]
		sgrIdx     int

		def new() {
			filterV = int[3, -7, 15]
			filterH = int[3, -7, 15]
			sgrWeights = int[-32, 31]
		}

		def copyFrom(o Av1LrUnit) {
			for let i = 0; i < 3; i++ {
				filterV[i] = o.filterV[i]
				filterH[i] = o.filterH[i]
			}
			sgrWeights[0] = o.sgrWeights[0]
			sgrWeights[1] = o.sgrWeights[1]
		}
	}
}
