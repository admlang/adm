internal partial module std.formats.video.av1 {
	// Edge flags of intra blocks (dav1d intra_edge.h).
	const (
		av1EdgeI444TopHasRight   = 1
		av1EdgeI422TopHasRight   = 2
		av1EdgeI420TopHasRight   = 4
		av1EdgeI444LeftHasBottom = 8
		av1EdgeI422LeftHasBottom = 16
		av1EdgeI420LeftHasBottom = 32
		av1EdgeAllTopHasRight    = 7
		av1EdgeAllLeftHasBottom  = 56
		av1EdgeAllTrAndBl        = 63
	)

	// The tree of intra edge flags per position in a superblock (dav1d
	// intra_edge.c): per node o, h0, h1, v0, v1, h4, v4, then four children
	// (branches) or three split flags (8x8 tips).
	type Av1EdgeTree {
		nodes   int[]
		count   int
		root128 int
		root64  int

		def new() {
			nodes.len(11 * (85 + 256 + 21 + 64))
			root128 = build(av1Bl128x128, topHasRight = true, leftHasBottom = false)
			root64 = build(av1Bl64x64, topHasRight = true, leftHasBottom = false)
		}

		def alloc() int {
			count++
			return count - 1
		}

		def initEdges(n int, bl int, flags int) {
			let b = n * 11
			nodes[b] = flags
			nodes[b + 1] = flags | av1EdgeAllLeftHasBottom
			nodes[b + 3] = flags | av1EdgeAllTopHasRight
			if bl == av1Bl8x8 {
				nodes[b + 2] = flags & (av1EdgeAllLeftHasBottom | av1EdgeI420TopHasRight)
				nodes[b + 4] = flags & (av1EdgeAllTopHasRight | av1EdgeI420LeftHasBottom | av1EdgeI422LeftHasBottom)
				nodes[b + 7] = (flags & av1EdgeAllTopHasRight) | av1EdgeI422LeftHasBottom
				nodes[b + 8] = flags | av1EdgeI444TopHasRight
				nodes[b + 9] = flags & (av1EdgeI420TopHasRight | av1EdgeI420LeftHasBottom | av1EdgeI422LeftHasBottom)
			} else {
				nodes[b + 2] = flags & av1EdgeAllLeftHasBottom
				nodes[b + 4] = flags & av1EdgeAllTopHasRight
				nodes[b + 5] = av1EdgeAllLeftHasBottom
				nodes[b + 6] = av1EdgeAllTopHasRight
				if bl == av1Bl16x16 {
					nodes[b + 5] = nodes[b + 5] | (flags & av1EdgeI420TopHasRight)
					nodes[b + 6] = nodes[b + 6] | (flags & (av1EdgeI420LeftHasBottom | av1EdgeI422LeftHasBottom))
				}
			}
		}

		def build(bl int, topHasRight bool, leftHasBottom bool) int {
			let n = alloc()
			initEdges(n, bl, (topHasRight ?? (av1EdgeAllTopHasRight, 0)) | (leftHasBottom ?? (av1EdgeAllLeftHasBottom, 0)))
			for let k = 0; k < 4; k++ {
				let tr = !(k == 3 || (k == 1 && !topHasRight))
				let bl2 = k == 0 || (k == 2 && leftHasBottom)
				if bl == av1Bl16x16 {
					let tip = alloc()
					initEdges(tip, av1Bl8x8, (tr ?? (av1EdgeAllTopHasRight, 0)) | (bl2 ?? (av1EdgeAllLeftHasBottom, 0)))
					nodes[n * 11 + 7 + k] = tip
				} else {
					nodes[n * 11 + 7 + k] = build(bl + 1, tr, bl2)
				}
			}
			return n
		}
	}
}
