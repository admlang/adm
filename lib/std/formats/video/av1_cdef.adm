internal partial module std.formats.video.av1 {
	use std.simd

	// CDEF (dav1d cdef_tmpl.c and cdef_apply_tmpl.c) over the whole frame:
	// every 8x8 block reads the deblocked picture, so the planes are copied
	// before filtering.

	const av1CdefPad = -32768
	const av1CdefUvDir422 = int[7, 0, 2, 4, 5, 6, 6, 6]

	// Marks the 8x8 blocks the tile's block covers as having coefficients.
	def av1MarkNoskip(t Av1Tile, bs int) {
		return when t.bSkip
		let bw4 = av1BlockDims[bs * 4]
		let bh4 = av1BlockDims[bs * 4 + 1]
		let st = t.b4Stride >> 1
		for let y = 0; y < bh4; y += 2 {
			let r = ((t.by + y) >> 1) * st
			for let x = 0; x < bw4; x++ {
				t.cdefNoskip[r + ((t.bx + x) >> 1)] = byte(1)
			}
		}
	}

	def av1CdefConstrain(diff int, threshold int, shift int) int {
		let a = av1Abs(diff)
		let m = threshold - (a >> shift)
		m = 0 when m < 0
		return av1ApplySign(a < m ?? (a, m), diff)
	}

	const av1Rev8 = byte[7, 6, 5, 4, 3, 2, 1, 0]
	const av1Even8 = byte[0, 2, 4, 6, 0, 0, 0, 0]
	const av1Odd8 = byte[1, 3, 5, 7, 0, 0, 0, 0]
	const av1EvenRev8 = byte[6, 4, 2, 0, 0, 0, 0, 0]
	const av1OddRev8 = byte[7, 5, 3, 1, 0, 0, 0, 0]
	const av1Low4 = int32[1, 1, 1, 1, 0, 0, 0, 0]

	// cdef_find_dir: the direction of the 8x8 block at `at` and its
	// variance into var[0]. Each row is one vector added into the partial
	// sums at its offset (ps: hv at 0 and 8, diagonals at 16 and 40, the
	// four alternates at 64, 80, 96 and 112).
	def av1CdefDir(img uint16[], at int, stride int, bd8 int, var int[], ps int32[]) int {
		let zero = simd.splat8<int32>(int32(0))
		for let i = 0; i < 128; i += 8 {
			simd.store8<int32>(ps, i, zero)
		}
		let rev = simd.load8<byte>(av1Rev8, 0)
		let even = simd.load8<byte>(av1Even8, 0)
		let odd = simd.load8<byte>(av1Odd8, 0)
		let evenRev = simd.load8<byte>(av1EvenRev8, 0)
		let oddRev = simd.load8<byte>(av1OddRev8, 0)
		let low4 = simd.ne(simd.load8<int32>(av1Low4, 0), zero)
		let c128 = simd.splat8<int32>(int32(128))
		let cols = zero
		for let y = 0; y < 8; y++ {
			let row = (simd.convert<uint16, int32>(simd.load8<uint16>(img, at + y * stride)) >> bd8) - c128
			ps[y] = int32(simd.sum(row))
			cols += row
			simd.store8<int32>(ps, 16 + y, simd.load8<int32>(ps, 16 + y) + row)
			simd.store8<int32>(ps, 40 + y, simd.load8<int32>(ps, 40 + y) + simd.shuffle(row, rev))
			let pairs = simd.blend(low4, simd.shuffle(row, even) + simd.shuffle(row, odd), zero)
			simd.store8<int32>(ps, 64 + y, simd.load8<int32>(ps, 64 + y) + pairs)
			let pairsRev = simd.blend(low4, simd.shuffle(row, evenRev) + simd.shuffle(row, oddRev), zero)
			simd.store8<int32>(ps, 80 + y, simd.load8<int32>(ps, 80 + y) + pairsRev)
			let o2 = 96 + 3 - (y >> 1)
			simd.store8<int32>(ps, o2, simd.load8<int32>(ps, o2) + row)
			let o3 = 112 + (y >> 1)
			simd.store8<int32>(ps, o3, simd.load8<int32>(ps, o3) + row)
		}
		simd.store8<int32>(ps, 8, cols)
		let cost = var
		for let i = 0; i < 8; i++ {
			cost[1 + i] = 0
		}
		for let n = 0; n < 8; n++ {
			cost[1 + 2] += int(ps[n]) * int(ps[n])
			cost[1 + 6] += int(ps[8 + n]) * int(ps[8 + n])
		}
		cost[1 + 2] *= 105
		cost[1 + 6] *= 105
		let div = int[840, 420, 280, 210, 168, 140, 120]
		for let n = 0; n < 7; n++ {
			let d = div[n]
			cost[1] += (int(ps[16 + n]) * int(ps[16 + n]) + int(ps[16 + 14 - n]) * int(ps[16 + 14 - n])) * d
			cost[1 + 4] += (int(ps[40 + n]) * int(ps[40 + n]) + int(ps[40 + 14 - n]) * int(ps[40 + 14 - n])) * d
		}
		cost[1] += int(ps[16 + 7]) * int(ps[16 + 7]) * 105
		cost[1 + 4] += int(ps[40 + 7]) * int(ps[40 + 7]) * 105
		for let n = 0; n < 4; n++ {
			let a = 64 + n * 16
			let c = 1 + n * 2 + 1
			for let m = 0; m < 5; m++ {
				cost[c] += int(ps[a + 3 + m]) * int(ps[a + 3 + m])
			}
			cost[c] *= 105
			for let m = 0; m < 3; m++ {
				let d = div[2 * m + 1]
				cost[c] += (int(ps[a + m]) * int(ps[a + m]) + int(ps[a + 10 - m]) * int(ps[a + 10 - m])) * d
			}
		}
		let best = 0
		let bestCost = cost[1]
		for let n = 1; n < 8; n++ {
			if cost[1 + n] > bestCost {
				bestCost = cost[1 + n]
				best = n
			}
		}
		var[0] = (bestCost - cost[1 + (best ^ 4)]) >> 10
		return best
	}

	def av1CdefAdjust(strength int, v int) int {
		return 0 when v == 0
		let i = (v >> 6) != 0 ?? (av1Min(av1Log2(v >> 6), 12), 0)
		return (strength * (4 + i) + 8) >> 4
	}

	// cdef_filter_block: filters the w x h block at `at` of `dst` from the
	// unfiltered copy `src`; the frame edges given by `edges` (1 left, 2
	// right, 4 top, 8 bottom) pad.
	def av1CdefBlock(dst uint16[], src uint16[], at int, stride int, w int, h int, pri int, sec int, dir int, damping int, edges int, bd8 int, tmp int32[]) {
		// tmp: 12 x 12, the block at (2, 2).
		let xs = (edges & 1) != 0 ?? (-2, 0)
		let xe = (edges & 2) != 0 ?? (w + 2, w)
		for let y = -2; y < h + 2; y++ {
			let row = (y + 2) * 12 + 2
			if (y < 0 && (edges & 4) == 0) || (y >= h && (edges & 8) == 0) {
				for let x = -2; x < w + 2; x++ {
					tmp[row + x] = int32(av1CdefPad)
				}
				continue
			}
			let o = at + y * stride
			if xs == -2 && xe == w + 2 {
				// Both sides inside the frame: whole rows by vectors.
				simd.store8<int32>(tmp, row - 2, simd.convert<uint16, int32>(simd.load8<uint16>(src, o - 2)))
				simd.store4<int32>(tmp, row + 6, simd.convert<uint16, int32>(simd.load4<uint16>(src, o + 6))) when w == 8
				continue
			}
			for let x = -2; x < xs; x++ {
				tmp[row + x] = int32(av1CdefPad)
			}
			for let x = xs; x < xe; x++ {
				tmp[row + x] = int32(int(src[o + x]))
			}
			for let x = xe; x < w + 2; x++ {
				tmp[row + x] = int32(av1CdefPad)
			}
		}
		if w == 8 {
			av1CdefBlock8(dst, at, stride, h, pri, sec, dir, damping, bd8, tmp)
			return
		}
		av1CdefBlock4(dst, at, stride, h, pri, sec, dir, damping, bd8, tmp)
	}

	// The filter of an 8-wide block from the padded tmp, a row per vector.
	def av1CdefBlock8(dst uint16[], at int, stride int, h int, pri int, sec int, dir int, damping int, bd8 int, tmp int32[]) {
		let d0 = av1CdefDirections[(dir + 2) * 2]
		let d1 = av1CdefDirections[(dir + 2) * 2 + 1]
		let s0 = av1CdefDirections[(dir + 4) * 2]
		let s1 = av1CdefDirections[(dir + 4) * 2 + 1]
		let s2 = av1CdefDirections[dir * 2]
		let s3 = av1CdefDirections[dir * 2 + 1]
		let priTap = 4 - ((pri >> bd8) & 1)
		let priShift = pri != 0 ?? (av1Max(0, damping - av1Log2(pri)), 0)
		let secShift = sec != 0 ?? (damping - av1Log2(sec), 0)
		let zero = simd.splat8<int32>(int32(0))
		let padv = simd.splat8<int32>(int32(av1CdefPad))
		let pv = simd.splat8<int32>(int32(pri))
		let sv = simd.splat8<int32>(int32(sec))
		let tap0 = simd.splat8<int32>(int32(priTap))
		let tap1 = simd.splat8<int32>(int32((priTap & 3) | 2))
		let two = simd.splat8<int32>(int32(2))
		let eight = simd.splat8<int32>(int32(8))
		let one = simd.splat8<int32>(int32(1))
		for let y = 0; y < h; y++ {
			let c = (y + 2) * 12 + 2
			let px = simd.load8<int32>(tmp, c)
			let sum = zero
			let mn = px
			let mx = px
			if pri != 0 {
				for let k = 0; k < 2; k++ {
					let off = k == 0 ?? (d0, d1)
					let tap = k == 0 ?? (tap0, tap1)
					let p0 = simd.load8<int32>(tmp, c + off)
					let p1 = simd.load8<int32>(tmp, c - off)
					let e0 = p0 - px
					let a0 = simd.abs(e0)
					let c0 = simd.min(a0, simd.max(zero, pv - (a0 >> priShift)))
					sum += tap * simd.blend(simd.lt(e0, zero), zero - c0, c0)
					let e1 = p1 - px
					let a1 = simd.abs(e1)
					let c1 = simd.min(a1, simd.max(zero, pv - (a1 >> priShift)))
					sum += tap * simd.blend(simd.lt(e1, zero), zero - c1, c1)
					mn = simd.min(mn, simd.blend(simd.eq(p0, padv), px, p0))
					mn = simd.min(mn, simd.blend(simd.eq(p1, padv), px, p1))
					mx = simd.max(mx, simd.max(p0, p1))
				}
			}
			if sec != 0 {
				for let k = 0; k < 2; k++ {
					let o2 = k == 0 ?? (s0, s1)
					let o3 = k == 0 ?? (s2, s3)
					let tap = k == 0 ?? (two, one)
					for let j = 0; j < 4; j++ {
						let off = j < 2 ?? (o2, o3)
						let q = (j & 1) == 0 ?? (simd.load8<int32>(tmp, c + off), simd.load8<int32>(tmp, c - off))
						let e = q - px
						let a = simd.abs(e)
						let cc = simd.min(a, simd.max(zero, sv - (a >> secShift)))
						sum += tap * simd.blend(simd.lt(e, zero), zero - cc, cc)
						mn = simd.min(mn, simd.blend(simd.eq(q, padv), px, q))
						mx = simd.max(mx, q)
					}
				}
			}
			let neg = simd.blend(simd.lt(sum, zero), one, zero)
			let v = px + ((sum - neg + eight) >> 4)
			v = simd.clamp(v, mn, mx) when pri != 0 && sec != 0
			simd.store8<uint16>(dst, at + y * stride, simd.convert<int32, uint16>(v))
		}
	}

	// The filter of an 4-wide block from the padded tmp, a row per vector.
	def av1CdefBlock4(dst uint16[], at int, stride int, h int, pri int, sec int, dir int, damping int, bd8 int, tmp int32[]) {
		let d0 = av1CdefDirections[(dir + 2) * 2]
		let d1 = av1CdefDirections[(dir + 2) * 2 + 1]
		let s0 = av1CdefDirections[(dir + 4) * 2]
		let s1 = av1CdefDirections[(dir + 4) * 2 + 1]
		let s2 = av1CdefDirections[dir * 2]
		let s3 = av1CdefDirections[dir * 2 + 1]
		let priTap = 4 - ((pri >> bd8) & 1)
		let priShift = pri != 0 ?? (av1Max(0, damping - av1Log2(pri)), 0)
		let secShift = sec != 0 ?? (damping - av1Log2(sec), 0)
		let zero = simd.splat4<int32>(int32(0))
		let padv = simd.splat4<int32>(int32(av1CdefPad))
		let pv = simd.splat4<int32>(int32(pri))
		let sv = simd.splat4<int32>(int32(sec))
		let tap0 = simd.splat4<int32>(int32(priTap))
		let tap1 = simd.splat4<int32>(int32((priTap & 3) | 2))
		let two = simd.splat4<int32>(int32(2))
		let eight = simd.splat4<int32>(int32(8))
		let one = simd.splat4<int32>(int32(1))
		for let y = 0; y < h; y++ {
			let c = (y + 2) * 12 + 2
			let px = simd.load4<int32>(tmp, c)
			let sum = zero
			let mn = px
			let mx = px
			if pri != 0 {
				for let k = 0; k < 2; k++ {
					let off = k == 0 ?? (d0, d1)
					let tap = k == 0 ?? (tap0, tap1)
					let p0 = simd.load4<int32>(tmp, c + off)
					let p1 = simd.load4<int32>(tmp, c - off)
					let e0 = p0 - px
					let a0 = simd.abs(e0)
					let c0 = simd.min(a0, simd.max(zero, pv - (a0 >> priShift)))
					sum += tap * simd.blend(simd.lt(e0, zero), zero - c0, c0)
					let e1 = p1 - px
					let a1 = simd.abs(e1)
					let c1 = simd.min(a1, simd.max(zero, pv - (a1 >> priShift)))
					sum += tap * simd.blend(simd.lt(e1, zero), zero - c1, c1)
					mn = simd.min(mn, simd.blend(simd.eq(p0, padv), px, p0))
					mn = simd.min(mn, simd.blend(simd.eq(p1, padv), px, p1))
					mx = simd.max(mx, simd.max(p0, p1))
				}
			}
			if sec != 0 {
				for let k = 0; k < 2; k++ {
					let o2 = k == 0 ?? (s0, s1)
					let o3 = k == 0 ?? (s2, s3)
					let tap = k == 0 ?? (two, one)
					for let j = 0; j < 4; j++ {
						let off = j < 2 ?? (o2, o3)
						let q = (j & 1) == 0 ?? (simd.load4<int32>(tmp, c + off), simd.load4<int32>(tmp, c - off))
						let e = q - px
						let a = simd.abs(e)
						let cc = simd.min(a, simd.max(zero, sv - (a >> secShift)))
						sum += tap * simd.blend(simd.lt(e, zero), zero - cc, cc)
						mn = simd.min(mn, simd.blend(simd.eq(q, padv), px, q))
						mx = simd.max(mx, q)
					}
				}
			}
			let neg = simd.blend(simd.lt(sum, zero), one, zero)
			let v = px + ((sum - neg + eight) >> 4)
			v = simd.clamp(v, mn, mx) when pri != 0 && sec != 0
			simd.store4<uint16>(dst, at + y * stride, simd.convert<int32, uint16>(v))
		}
	}

	def av1CopyPlane(dst uint16[], src uint16[]) {
		let n = src.len()
		let wide = n & ~15
		for let i = 0; i < wide; i += 16 {
			simd.store16<uint16>(dst, i, simd.load16<uint16>(src, i))
		}
		for let i = wide; i < n; i++ {
			dst[i] = src[i]
		}
	}

	// Applies CDEF to the deblocked frame; true when it ran (leaving the
	// deblocked planes in t.cdefY/U/V).
	def av1Cdef(t Av1Tile) bool {
		let h = t.hdr
		let s = t.seq
		return false unless s.cdef
		return false when h.allLossless || h.allowIntrabc
		let any = false
		for let i = 0; i < (1 << h.cdefBits); i++ {
			any = true when h.cdefY[i] != 0 || h.cdefUv[i] != 0
		}
		return false unless any
		let f = t.cur
		let ssHor = t.ssHor
		let ssVer = t.ssVer
		let mono = t.layout == 0
		// The deblocked copies the blocks read.
		t.cdefY.len(f.y.len()) when t.cdefY.len() != f.y.len()
		av1CopyPlane(t.cdefY, f.y)
		if !mono {
			if t.cdefU.len() != f.u.len() {
				t.cdefU.len(f.u.len())
				t.cdefV.len(f.v.len())
			}
			av1CopyPlane(t.cdefU, f.u)
			av1CopyPlane(t.cdefV, f.v)
		}
		let rows = (t.bh + 1) >> 1
		let bands = av1BandCount(rows)
		if bands == 1 {
			av1CdefRows(t, t.scratch[0], 0, t.bh)
			return true
		}
		let done = new channel<bool>(size = bands)
		for let b = 0; b < bands; b++ {
			async av1CdefTask(t, t.scratch[b], 2 * (rows * b / bands), 2 * (rows * (b + 1) / bands), done)
		}
		for let b = 0; b < bands; b++ {
			<-done
		}
		return true
	}

	// CDEF over the 8x8 block rows from..<to (4x4 units, even).
	def av1CdefRows(t Av1Tile, sc Av1Scratch, from int, to int) {
		let h = t.hdr
		let f = t.cur
		let bd8 = t.bitDepth - 8
		let damping = h.cdefDamping + bd8
		let ssHor = t.ssHor
		let ssVer = t.ssVer
		let mono = t.layout == 0
		let uvW = ssHor == 1 ?? (4, 8)
		let uvH = ssVer == 1 ?? (4, 8)
		let var = sc.cdefVar
		let st8 = t.b4Stride >> 1
		for let by = from; by < to && by < t.bh; by += 2 {
			let edges = (by > 0 ?? (4, 0)) | (by + 2 < t.bh ?? (8, 0))
			for let bx = 0; bx < t.bw; bx += 2 {
				let ci = t.cdefIdx[(by >> 4) * t.sb64w + (bx >> 4)]
				continue when ci == -1
				let yl = h.cdefY[ci]
				let ul = mono ?? (0, h.cdefUv[ci])
				continue when yl == 0 && ul == 0
				continue when t.cdefNoskip[(by >> 1) * st8 + (bx >> 1)] == byte(0)
				let e = edges | (bx > 0 ?? (1, 0)) | (bx + 2 < t.bw ?? (2, 0))
				let yPri = (yl >> 2) << bd8
				let ySec = yl & 3
				ySec += 1 when ySec == 3
				ySec = ySec << bd8
				let uPri = (ul >> 2) << bd8
				let uSec = ul & 3
				uSec += 1 when uSec == 3
				uSec = uSec << bd8
				let at = by * 4 * f.stride + bx * 4
				let dir = 0
				var[0] = 0
				dir = av1CdefDir(t.cdefY, at, f.stride, bd8, var, sc.cdefPs) when yPri != 0 || uPri != 0
				if yPri != 0 {
					let adj = av1CdefAdjust(yPri, var[0])
					av1CdefBlock(f.y, t.cdefY, at, f.stride, 8, 8, adj, ySec, dir, damping, e, bd8, sc.cdefTmp) when adj != 0 || ySec != 0
				} else if ySec != 0 {
					av1CdefBlock(f.y, t.cdefY, at, f.stride, 8, 8, 0, ySec, 0, damping, e, bd8, sc.cdefTmp)
				}
				continue when ul == 0
				let uvDir = uPri != 0 ?? (t.layout == 2 ?? (av1CdefUvDir422[dir], dir), 0)
				let cat = (by * 4 >> ssVer) * f.cstride + (bx * 4 >> ssHor)
				av1CdefBlock(f.u, t.cdefU, cat, f.cstride, uvW, uvH, uPri, uSec, uvDir, damping - 1, e, bd8, sc.cdefTmp)
				av1CdefBlock(f.v, t.cdefV, cat, f.cstride, uvW, uvH, uPri, uSec, uvDir, damping - 1, e, bd8, sc.cdefTmp)
			}
		}
	}
}
