internal partial module std.formats.video.av1 {
	// Film grain synthesis (dav1d filmgrain_tmpl.c and fg_apply_tmpl.c),
	// applied to a copy of the frame on output; the reference keeps the
	// grain-free picture.

	const av1GrainW = 82
	const av1GrainH = 73

	def av1GrainRandom(bits int, state int[]) int {
		let r = state[0]
		let bit = ((r >> 0) ^ (r >> 1) ^ (r >> 3) ^ (r >> 12)) & 1
		state[0] = (r >> 1) | (bit << 15)
		return (state[0] >> (16 - bits)) & ((1 << bits) - 1)
	}

	def av1Round2(x int, shift int) int {
		return (x + ((1 << shift) >> 1)) >> shift
	}

	// generate_grain_y into lut (82 x 73).
	def av1GrainY(lut int[], g Av1FilmGrain, bd8 int) {
		let seed = int[g.seed]
		let shift = 4 - bd8 + g.grainScaleShift
		let ctr = 128 << bd8
		for let y = 0; y < av1GrainH; y++ {
			for let x = 0; x < av1GrainW; x++ {
				lut[y * av1GrainW + x] = av1Round2(av1GaussianSequence[av1GrainRandom(11, seed)], shift)
			}
		}
		let lag = g.arLag
		for let y = 3; y < av1GrainH; y++ {
			for let x = 3; x < av1GrainW - 3; x++ {
				let c = 0
				let sum = 0
				for let dy = -lag; dy <= 0; dy++ {
					for let dx = -lag; dx <= lag; dx++ {
						break when dx == 0 && dy == 0
						sum += g.arCoeffsY[c] * lut[(y + dy) * av1GrainW + x + dx]
						c++
					}
				}
				let v = lut[y * av1GrainW + x] + av1Round2(sum, g.arShift)
				lut[y * av1GrainW + x] = av1ClipI(v, -ctr, ctr - 1)
			}
		}
	}

	// generate_grain_uv of plane `uv` into lut from the luma grain.
	def av1GrainUv(lut int[], ly int[], g Av1FilmGrain, uv int, sx int, sy int, bd8 int) {
		let seed = int[g.seed ^ (uv == 1 ?? (0x49D8, 0xB524))]
		let shift = 4 - bd8 + g.grainScaleShift
		let ctr = 128 << bd8
		let cw = sx == 1 ?? (44, av1GrainW)
		let ch = sy == 1 ?? (38, av1GrainH)
		for let y = 0; y < ch; y++ {
			for let x = 0; x < cw; x++ {
				lut[y * av1GrainW + x] = av1Round2(av1GaussianSequence[av1GrainRandom(11, seed)], shift)
			}
		}
		let lag = g.arLag
		for let y = 3; y < ch; y++ {
			for let x = 3; x < cw - 3; x++ {
				let c = uv * 28
				let sum = 0
				for let dy = -lag; dy <= 0; dy++ {
					for let dx = -lag; dx <= lag; dx++ {
						if dx == 0 && dy == 0 {
							break when g.numYPoints == 0
							let luma = 0
							let lx = ((x - 3) << sx) + 3
							let lyy = ((y - 3) << sy) + 3
							for let i = 0; i <= sy; i++ {
								for let j = 0; j <= sx; j++ {
									luma += ly[(lyy + i) * av1GrainW + lx + j]
								}
							}
							luma = av1Round2(luma, sx + sy)
							sum += luma * g.arCoeffsUv[c]
							break
						}
						sum += g.arCoeffsUv[c] * lut[(y + dy) * av1GrainW + x + dx]
						c++
					}
				}
				let v = lut[y * av1GrainW + x] + av1Round2(sum, g.arShift)
				lut[y * av1GrainW + x] = av1ClipI(v, -ctr, ctr - 1)
			}
		}
	}

	// generate_scaling: the scaling function of `num` points at pts[at:].
	def av1GrainScaling(bd int, pts int[], at int, num int, out int[]) {
		let shiftX = bd - 8
		let size = 1 << bd
		if num == 0 {
			for let i = 0; i < size; i++ {
				out[i] = 0
			}
			return
		}
		for let i = 0; i < (pts[at] << shiftX); i++ {
			out[i] = pts[at + 1]
		}
		for let i = 0; i < num - 1; i++ {
			let bx = pts[at + i * 2]
			let by = pts[at + i * 2 + 1]
			let dx = pts[at + i * 2 + 2] - bx
			let dy = pts[at + i * 2 + 3] - by
			let delta = dy * ((0x10000 + (dx >> 1)) / dx)
			let d = 0x8000
			for let x = 0; x < dx; x++ {
				out[(bx + x) << shiftX] = by + (d >> 16)
				d += delta
			}
		}
		let n = pts[at + (num - 1) * 2] << shiftX
		for let i = n; i < size; i++ {
			out[i] = pts[at + (num - 1) * 2 + 1]
		}
		return when shiftX == 0
		let pad = 1 << shiftX
		let rnd = pad >> 1
		for let i = 0; i < num - 1; i++ {
			let bx = pts[at + i * 2] << shiftX
			let ex = pts[at + i * 2 + 2] << shiftX
			for let x = 0; x < ex - bx; x += pad {
				let range = out[bx + x + pad] - out[bx + x]
				let r = rnd
				for let k = 1; k < pad; k++ {
					r += range
					out[bx + x + k] = out[bx + x] + (r >> shiftX)
				}
			}
		}
	}

	def av1GrainSample(lut int[], offs int[], sx int, sy int, bx int, by int, x int, y int) int {
		let rv = offs[bx * 2 + by]
		let ox = 3 + (2 >> sx) * (3 + (rv >> 4))
		let oy = 3 + (2 >> sy) * (3 + (rv & 15))
		return lut[(oy + y + (32 >> sy) * by) * av1GrainW + ox + x + (32 >> sx) * bx]
	}

	// The overlap blend of two grain values.
	def av1GrainBlend(old int, cur int, w0 int, w1 int, ctr int) int {
		return av1ClipI(av1Round2(old * w0 + cur * w1, 5), -ctr, ctr - 1)
	}

	// fgy/fguv_32x32xn for one 32-row band of a plane: `dst` gets `src`
	// plus the scaled grain; chroma planes (pl > 0) scale by the co-located
	// luma of `luma`.
	def av1GrainBand(dst uint16[], src uint16[], at int, stride int, w int, bh int, row int, g Av1FilmGrain, scaling int[], lut int[], pl int, sx int, sy int, luma uint16[], lat int, lstride int, isId bool, bd int, offs int[], seeds int[]) {
		let bd8 = bd - 8
		let ctr = 128 << bd8
		let maxv = (1 << bd) - 1
		let minV = g.clipRestricted ?? (16 << bd8, 0)
		let maxV = g.clipRestricted ?? ((pl > 0 && !isId ?? (240, 235)) << bd8, maxv)
		let rows = 1 + ((g.overlap && row > 0) ?? (1, 0))
		for let i = 0; i < rows; i++ {
			let s = g.seed
			s = s ^ ((((row - i) * 37 + 178) & 0xFF) << 8)
			s = s ^ (((row - i) * 173 + 105) & 0xFF)
			seeds[i] = s
		}
		let bsz = 32 >> sx
		let uv = pl - 1
		let one = int[0]
		for let bx = 0; bx < w; bx += bsz {
			let bw = av1Min(bsz, w - bx)
			if g.overlap && bx > 0 {
				for let i = 0; i < rows; i++ {
					offs[2 + i] = offs[i]
				}
			}
			for let i = 0; i < rows; i++ {
				one[0] = seeds[i]
				offs[i] = av1GrainRandom(8, one)
				seeds[i] = one[0]
			}
			let ystart = (g.overlap && row > 0) ?? (av1Min(2 >> sy, bh), 0)
			let xstart = (g.overlap && bx > 0) ?? (av1Min(2 >> sx, bw), 0)
			for let y = 0; y < bh; y++ {
				for let x = 0; x < bw; x++ {
					let grain = av1GrainSample(lut, offs, sx, sy, 0, 0, x, y)
					if x < xstart {
						let wx0 = sx == 1 ?? (23, x == 0 ?? (27, 17))
						let wx1 = sx == 1 ?? (22, x == 0 ?? (17, 27))
						grain = av1GrainBlend(av1GrainSample(lut, offs, sx, sy, 1, 0, x, y), grain, wx0, wx1, ctr)
						if y < ystart {
							let top = av1GrainSample(lut, offs, sx, sy, 0, 1, x, y)
							top = av1GrainBlend(av1GrainSample(lut, offs, sx, sy, 1, 1, x, y), top, wx0, wx1, ctr)
							let wy0 = sy == 1 ?? (23, y == 0 ?? (27, 17))
							let wy1 = sy == 1 ?? (22, y == 0 ?? (17, 27))
							grain = av1GrainBlend(top, grain, wy0, wy1, ctr)
						}
					} else if y < ystart {
						let wy0 = sy == 1 ?? (23, y == 0 ?? (27, 17))
						let wy1 = sy == 1 ?? (22, y == 0 ?? (17, 27))
						grain = av1GrainBlend(av1GrainSample(lut, offs, sx, sy, 0, 1, x, y), grain, wy0, wy1, ctr)
					}
					let o = at + y * stride + bx + x
					let sv = int(src[o])
					let val = sv
					if pl > 0 {
						let lo = lat + (y << sy) * lstride + ((bx + x) << sx)
						let avg = int(luma[lo])
						avg = (avg + int(luma[lo + 1]) + 1) >> 1 when sx == 1
						val = avg
						if !g.chromaFromLuma {
							let combined = avg * g.uvLumaMult[uv] + sv * g.uvMult[uv]
							val = av1ClipI((combined >> 6) + g.uvOffset[uv] * (1 << bd8), 0, maxv)
						}
					}
					let noise = av1Round2(scaling[val] * grain, g.scalingShift)
					dst[o] = uint16(av1ClipI(sv + noise, minV, maxV))
				}
			}
		}
	}

	// dav1d_apply_grain: the frame with film grain, a new picture.
	def av1ApplyGrain(f Av1Frame, g Av1FilmGrain, isId bool) Av1Frame {
		let bd = f.bitDepth
		let bd8 = bd - 8
		let o = new Av1Frame()
		o.hdr = f.hdr
		o.layout = f.layout
		o.ssHor = f.ssHor
		o.ssVer = f.ssVer
		o.bitDepth = bd
		o.stride = f.stride
		o.cstride = f.cstride
		o.y = f.y.clone()
		let mono = f.layout == 0
		if !mono {
			o.u = f.u.clone()
			o.v = f.v.clone()
		}
		let w = f.hdr.upscaledWidth
		let h = f.hdr.height
		let sx = f.ssHor
		let sy = f.ssVer
		let lutY = int[]
		lutY.len(av1GrainW * (av1GrainH + 1))
		av1GrainY(lutY, g, bd8)
		let lutU = int[]
		let lutV = int[]
		lutU.len(av1GrainW * (av1GrainH + 1))
		lutV.len(av1GrainW * (av1GrainH + 1))
		if !mono {
			av1GrainUv(lutU, lutY, g, 0, sx, sy, bd8) when g.numUvPoints[0] > 0 || g.chromaFromLuma
			av1GrainUv(lutV, lutY, g, 1, sx, sy, bd8) when g.numUvPoints[1] > 0 || g.chromaFromLuma
		}
		let size = 1 << bd
		let scY = int[]
		let scU = int[]
		let scV = int[]
		scY.len(size)
		scU.len(size)
		scV.len(size)
		av1GrainScaling(bd, g.yPoints, 0, g.numYPoints, scY) when g.numYPoints > 0 || g.chromaFromLuma
		av1GrainScaling(bd, g.uvPoints, 0, g.numUvPoints[0], scU) when g.numUvPoints[0] > 0
		av1GrainScaling(bd, g.uvPoints, 20, g.numUvPoints[1], scV) when g.numUvPoints[1] > 0
		let offs = int[0, 0, 0, 0]
		let seeds = int[0, 0]
		let cw = (w + sx) >> sx
		// The source luma, one column wider for odd widths.
		let luma = f.y
		if !mono && (w & sx) != 0 {
			luma = f.y.clone()
			for let y = 0; y < h; y++ {
				luma[y * f.stride + w] = luma[y * f.stride + w - 1]
			}
		}
		let rows = (h + 31) / 32
		for let row = 0; row < rows; row++ {
			let bh = av1Min(h - row * 32, 32)
			if g.numYPoints > 0 {
				let at = row * 32 * f.stride
				av1GrainBand(o.y, f.y, at, f.stride, w, bh, row, g, scY, lutY, 0, 0, 0, luma, 0, f.stride, isId, bd, offs, seeds)
			}
			continue when mono
			continue when g.numUvPoints[0] == 0 && g.numUvPoints[1] == 0 && !g.chromaFromLuma
			let cbh = (bh + sy) >> sy
			let cat = (row * 32 >> sy) * f.cstride
			let lat = row * 32 * f.stride
			for let pl = 0; pl < 2; pl++ {
				continue when !g.chromaFromLuma && g.numUvPoints[pl] == 0
				let sc = g.chromaFromLuma ?? (scY, pl == 0 ?? (scU, scV))
				av1GrainBand(pl == 0 ?? (o.u, o.v), pl == 0 ?? (f.u, f.v), cat, f.cstride, cw, cbh, row, g, sc, pl == 0 ?? (lutU, lutV), 1 + pl, sx, sy, luma, lat, f.stride, isId, bd, offs, seeds)
			}
		}
		return o
	}
}
