internal partial module std.formats.video.av1 {
	// Inter reconstruction (dav1d recon_tmpl.c mc, obmc, warp_affine,
	// recon_b_inter, read_coef_tree).

	def av1PlaneOf(f Av1Frame, pl int) uint16[] {
		return pl == 0 ?? (f.y, pl == 1 ?? (f.u, f.v))
	}

	// mc: the prediction of the bw4 x bh4 (4x4 luma units) block at (bx,
	// by) of plane `pl` from `ref` moved by (mvx, mvy); `refIdx` < 0 for
	// intra block copy from the frame being decoded.
	def av1Mc(t Av1Tile, prep bool, dst uint16[], dat int, dstride int, tmp int32[], bw4 int, bh4 int, bx int, by int, pl int, mvx int, mvy int, ref Av1Frame, refIdx int, f2d int) {
		let ssVer = (pl > 0 && t.layout == 1) ?? (1, 0)
		let ssHor = (pl > 0 && t.layout != 3) ?? (1, 0)
		let hMul = 4 >> ssHor
		let vMul = 4 >> ssVer
		let src = av1PlaneOf(ref, pl)
		let rs = pl == 0 ?? (ref.stride, ref.cstride)
		let bd = t.bitDepth
		let scale = refIdx >= 0 ?? (t.svcScale[refIdx * 2], 0)
		if scale == 0 {
			let mx = mvx & (15 >> (1 - ssHor))
			let my = mvy & (15 >> (1 - ssVer))
			let dx = bx * hMul + (mvx >> (3 + ssHor))
			let dy = by * vMul + (mvy >> (3 + ssVer))
			let w = 0
			let h = 0
			if refIdx >= 0 {
				w = (t.hdr.width + ssHor) >> ssHor
				h = (t.hdr.height + ssVer) >> ssVer
			} else {
				w = (t.bw * 4) >> ssHor
				h = (t.bh * 4) >> ssVer
			}
			let hx = mx != 0 ?? (1, 0)
			let hy = my != 0 ?? (1, 0)
			let bw = bw4 * hMul
			let bh = bh4 * vMul
			let s = 0
			let ss = rs
			if dx < hx * 3 || dy < hy * 3 || dx + bw + hx * 4 > w || dy + bh + hy * 4 > h {
				av1EmuEdge(bw + hx * 7, bh + hy * 7, w, h, dx - hx * 3, dy - hy * 3, t.emu, 192, src, rs)
				src = t.emu
				ss = 192
				s = 192 * hy * 3 + hx * 3
			} else {
				s = dy * rs + dx
			}
			av1McBlock(prep, dst, dat, dstride, tmp, 0, src, s, ss, bw, bh, mx << (1 - ssHor), my << (1 - ssVer), f2d, bd, t.mid)
			return
		}
		let origY = ((by * vMul) << 4) + mvy * (1 << (1 - ssVer))
		let origX = ((bx * hMul) << 4) + mvx * (1 << (1 - ssHor))
		let posX = av1ScaleMv(origX, scale)
		let posY = av1ScaleMv(origY, t.svcScale[refIdx * 2 + 1])
		let stepX = t.svcStep[refIdx * 2]
		let stepY = t.svcStep[refIdx * 2 + 1]
		let bw = bw4 * hMul
		let bh = bh4 * vMul
		let left = posX >> 10
		let top = posY >> 10
		let right = ((posX + (bw - 1) * stepX) >> 10) + 1
		let bottom = ((posY + (bh - 1) * stepY) >> 10) + 1
		let w = (ref.upWidth + ssHor) >> ssHor
		let h = (ref.height + ssVer) >> ssVer
		let s = 0
		let ss = rs
		if left < 3 || top < 3 || right + 4 > w || bottom + 4 > h {
			av1EmuEdge(right - left + 7, bottom - top + 7, w, h, left - 3, top - 3, t.emu, 320, src, rs)
			src = t.emu
			ss = 320
			s = 320 * 3 + 3
		} else {
			s = top * rs + left
		}
		av1McScaled(prep, dst, dat, dstride, tmp, 0, src, s, ss, bw, bh, posX & 0x3FF, posY & 0x3FF, stepX, stepY, f2d, bd, t.mid, t.midRows)
	}

	def av1ScaleMv(v int, scale int) int {
		let tmp = v * scale + (scale - 0x4000) * 8
		return av1ApplySign((av1Abs(tmp) + 128) >> 8, tmp) + 32
	}

	// obmc: blends the predictions of the above and left neighbours'
	// motion into the block's prediction at dst.
	def av1Obmc(t Av1Tile, dst uint16[], dat int, dstride int, bs int, pl int, w4 int, h4 int) {
		let ssVer = (pl > 0 && t.layout == 1) ?? (1, 0)
		let ssHor = (pl > 0 && t.layout != 3) ?? (1, 0)
		let hMul = 4 >> ssHor
		let vMul = 4 >> ssVer
		let bw4 = av1BlockDims[bs * 4]
		let bh4 = av1BlockDims[bs * 4 + 1]
		let lap = t.lap
		if t.by > t.rowStart && (pl == 0 || bw4 * hMul + bh4 * vMul >= 16) {
			let i = 0
			let x = 0
			let lim = av1Min(av1BlockDims[bs * 4 + 2], 4)
			for x < w4 && i < lim {
				let k = t.at(t.bx + x + 1, t.by - 1)
				let step4 = av1ClipI(av1BlockDims[int(t.rBs[k]) * 4], 2, 16)
				let r = int(t.rRef0[k])
				if r > 0 {
					let ow4 = av1Min(step4, bw4)
					let oh4 = av1Min(bh4, 16) >> 1
					let fi = t.aFilter1[t.bx + x + 1] * 4 + t.aFilter0[t.bx + x + 1]
					av1Mc(t, false, lap, 0, ow4 * hMul, t.tmp0, ow4, (oh4 * 3 + 3) >> 2, t.bx + x, t.by, pl, int(t.rMvx0[k]), int(t.rMvy0[k]), t.refs[r - 1], r - 1, av1Filter2d[fi])
					av1BlendH(dst, dat + x * hMul, dstride, lap, hMul * ow4, vMul * oh4)
					i++
				}
				x += step4
			}
		}
		if t.bx > t.colStart {
			let i = 0
			let y = 0
			let lim = av1Min(av1BlockDims[bs * 4 + 3], 4)
			for y < h4 && i < lim {
				let k = t.at(t.bx - 1, t.by + y + 1)
				let step4 = av1ClipI(av1BlockDims[int(t.rBs[k]) * 4 + 1], 2, 16)
				let r = int(t.rRef0[k])
				if r > 0 {
					let ow4 = av1Min(bw4, 16) >> 1
					let oh4 = av1Min(step4, bh4)
					let ly = (t.by + y + 1) & 31
					let fi = t.lFilter1[ly] * 4 + t.lFilter0[ly]
					av1Mc(t, false, lap, 0, hMul * ow4, t.tmp0, ow4, oh4, t.bx, t.by + y, pl, int(t.rMvx0[k]), int(t.rMvy0[k]), t.refs[r - 1], r - 1, av1Filter2d[fi])
					av1BlendV(dst, dat + y * vMul * dstride, dstride, lap, hMul * ow4, vMul * oh4)
					i++
				}
				y += step4
			}
		}
	}

	// warp_affine: the block predicted by the affine warp `mat`/`abcd`
	// in 8x8 units.
	def av1WarpAffine(t Av1Tile, prep bool, dst uint16[], dat int, dstride int, tmp int32[], bs int, pl int, ref Av1Frame, mat int[], mat0 int, abcd int[]) {
		let ssVer = (pl > 0 && t.layout == 1) ?? (1, 0)
		let ssHor = (pl > 0 && t.layout != 3) ?? (1, 0)
		let hMul = 4 >> ssHor
		let vMul = 4 >> ssVer
		let width = (ref.upWidth + ssHor) >> ssHor
		let height = (ref.height + ssVer) >> ssVer
		let src = av1PlaneOf(ref, pl)
		let rs = pl == 0 ?? (ref.stride, ref.cstride)
		let bw = av1BlockDims[bs * 4] * hMul
		let bh = av1BlockDims[bs * 4 + 1] * vMul
		for let y = 0; y < bh; y += 8 {
			let srcY = t.by * 4 + ((y + 4) << ssVer)
			let m3y = mat[mat0 + 3] * srcY + mat[mat0]
			let m5y = mat[mat0 + 5] * srcY + mat[mat0 + 1]
			for let x = 0; x < bw; x += 8 {
				let srcX = t.bx * 4 + ((x + 4) << ssHor)
				let mvx = (mat[mat0 + 2] * srcX + m3y) >> ssHor
				let mvy = (mat[mat0 + 4] * srcX + m5y) >> ssVer
				let dx = (mvx >> 16) - 4
				let mx = ((mvx & 0xFFFF) - abcd[0] * 4 - abcd[1] * 7) & ~0x3F
				let dy = (mvy >> 16) - 4
				let my = ((mvy & 0xFFFF) - abcd[2] * 4 - abcd[3] * 4) & ~0x3F
				let s = 0
				let sr = src
				let ss = rs
				if dx < 3 || dx + 8 + 4 > width || dy < 3 || dy + 8 + 4 > height {
					av1EmuEdge(15, 15, width, height, dx - 3, dy - 3, t.emu, 32, src, rs)
					sr = t.emu
					ss = 32
					s = 32 * 3 + 3
				} else {
					s = dy * rs + dx
				}
				if prep {
					av1Warp8x8(true, dst, 0, 0, tmp, y * dstride + x, dstride, sr, s, ss, abcd, mx, my, t.bitDepth, t.mid)
				} else {
					av1Warp8x8(false, dst, dat + y * dstride + x, dstride, tmp, 0, 0, sr, s, ss, abcd, mx, my, t.bitDepth, t.mid)
				}
			}
		}
	}

	// read_coef_tree: the luma transform blocks of the var-tx tree.
	def av1ReadCoefTree(t Av1Tile, bs int, ytx int, depth int, xOff int, yOff int, dst int) {
		let d = ytx * 8
		let txw = av1TxDims[d]
		let txh = av1TxDims[d + 1]
		let masks = depth == 0 ?? (t.bTxSplit0, t.bTxSplit1)
		let f = t.cur
		if depth < 2 && masks != 0 && (masks & (1 << (yOff * 4 + xOff))) != 0 {
			let sub = av1TxDims[d + 6]
			let sw = av1TxDims[sub * 8]
			let sh = av1TxDims[sub * 8 + 1]
			av1ReadCoefTree(t, bs, sub, depth + 1, xOff * 2, yOff * 2, dst)
			t.bx += sw
			av1ReadCoefTree(t, bs, sub, depth + 1, xOff * 2 + 1, yOff * 2, dst + 4 * sw) when txw >= txh && t.bx < t.bw
			t.bx -= sw
			t.by += sh
			if txh >= txw && t.by < t.bh {
				let d2 = dst + 4 * sh * f.stride
				av1ReadCoefTree(t, bs, sub, depth + 1, xOff * 2, yOff * 2 + 1, d2)
				t.bx += sw
				av1ReadCoefTree(t, bs, sub, depth + 1, xOff * 2 + 1, yOff * 2 + 1, d2 + 4 * sw) when txw >= txh && t.bx < t.bw
				t.bx -= sw
			}
			t.by -= sh
			return
		}
		let bx4 = t.bx & 31
		let by4 = t.by & 31
		let eob = av1DecodeCoefs(t, t.aLcoef, t.bx, t.lLcoef, by4, 127, ytx, bs, false, 0, 0)
		av1FillCtx(t.aLcoef, t.bx, av1Min(txw, t.bw - t.bx), t.coefCtx)
		av1FillCtx(t.lLcoef, by4, av1Min(txh, t.bh - t.by), t.coefCtx)
		let lw = 1 << av1TxDims[d + 2]
		for let y = 0; y < txh; y++ {
			for let x = 0; x < lw; x++ {
				t.txtpMap[(by4 + y) * 32 + bx4 + x] = t.coefTxtp
			}
		}
		av1InvTxfmAdd(f.y, dst, f.stride, t.cf, eob, ytx, t.coefTxtp, t.bitDepth, t.tmp32) when eob >= 0
	}

	def av1WarpMat(t Av1Tile, gmvRef int) int[] {
		return gmvRef < 0 ?? (t.warpMat, t.hdr.gmv)
	}

	// Whether the block predicts by an affine warp: its own warp (gmvRef
	// -1) or the global motion of reference gmvRef.
	def av1UsesWarp(t Av1Tile, ref int, bw4 int, bh4 int) int {
		return -2 when av1Min(bw4, bh4) <= 1
		return ref when t.bInterMode == av1Globalmv && t.gmvWarp[ref] != 0
		return -1 when t.bMotionMode == av1MmWarp && t.warpType > av1WmTranslation
		return -2
	}

	// recon_b_inter: predicts and reconstructs the inter block at the
	// tile's (bx, by).
	//
	// Fails never; the error return keeps the decode call shape.
	def av1ReconInter(t Av1Tile, bs int) !none {
		av1MarkNoskip(t, bs)
		let f = t.cur
		let h = t.hdr
		let bx = t.bx
		let by = t.by
		let bx4 = bx & 31
		let by4 = by & 31
		let ssVer = t.ssVer
		let ssHor = t.ssHor
		let cbx4 = bx >> ssHor
		let cby4 = by4 >> ssVer
		let bw4 = av1BlockDims[bs * 4]
		let bh4 = av1BlockDims[bs * 4 + 1]
		let w4 = av1Min(bw4, t.bw - bx)
		let h4 = av1Min(bh4, t.bh - by)
		let hasChroma = t.layout != 0 && (bw4 > ssHor || (bx & 1) != 0) && (bh4 > ssVer || (by & 1) != 0)
		let chrIdx = t.layout == 0 ?? (0, 3 - t.layout)
		let cbh4 = (bh4 + ssVer) >> ssVer
		let cbw4 = (bw4 + ssHor) >> ssHor
		let stride = f.stride
		let cstride = f.cstride
		let dst = 4 * (by * stride + bx)
		let uvOff = 4 * ((bx >> ssHor) + (by >> ssVer) * cstride)
		let bd = t.bitDepth
		let mvs = t.bMv
		if h.isIntra() {
			av1Mc(t, false, f.y, dst, stride, t.tmp0, bw4, bh4, bx, by, 0, mvs[0], mvs[1], f, -1, av1Filter2dBilinear)
			if hasChroma {
				for let pl = 1; pl < 3; pl++ {
					av1Mc(t, false, av1PlaneOf(f, pl), uvOff, cstride, t.tmp0, bw4 << (bw4 == ssHor ?? (1, 0)), bh4 << (bh4 == ssVer ?? (1, 0)), bx & ~ssHor, by & ~ssVer, pl, mvs[0], mvs[1], f, -1, av1Filter2dBilinear)
				}
			}
		} else if t.bCompType == av1CompInterNone {
			let r0 = t.bRef0
			let refp = t.refs[r0]
			let f2d = t.bFilter2d
			let wp = av1UsesWarp(t, r0, bw4, bh4)
			if wp >= -1 {
				av1WarpAffine(t, false, f.y, dst, stride, t.tmp0, bs, 0, refp, av1WarpMat(t, wp), wp >= 0 ?? (wp * 6, 0), wp >= 0 ?? (av1GmvAbcd(t, wp), t.warpAbcd))
			} else {
				av1Mc(t, false, f.y, dst, stride, t.tmp0, bw4, bh4, bx, by, 0, mvs[0], mvs[1], refp, r0, f2d)
				av1Obmc(t, f.y, dst, stride, bs, 0, w4, h4) when t.bMotionMode == av1MmObmc
			}
			av1InterIntra(t, bs, 0, f.y, dst, stride, bx, by, t.colStart, t.rowStart, t.colEnd, t.rowEnd, bw4, bh4, 0) when t.bInterintraType != 0
			if hasChroma {
				let sub8 = bw4 == ssHor || bh4 == ssVer
				if sub8 {
					sub8 = sub8 && int(t.rRef0[t.at(bx - 1, by)]) > 0 when bw4 == 1
					sub8 = sub8 && int(t.rRef0[t.at(bx, by - 1)]) > 0 when bh4 == ssVer
					sub8 = sub8 && int(t.rRef0[t.at(bx - 1, by - 1)]) > 0 when bw4 == 1 && bh4 == ssVer
				}
				if sub8 {
					let hOff = 0
					let vOff = 0
					if bw4 == 1 && bh4 == ssVer {
						let k = t.at(bx - 1, by - 1)
						let r = int(t.rRef0[k])
						for let pl = 0; pl < 2; pl++ {
							av1Mc(t, false, av1PlaneOf(f, 1 + pl), uvOff, cstride, t.tmp0, bw4, bh4, bx - 1, by - 1, 1 + pl, int(t.rMvx0[k]), int(t.rMvy0[k]), t.refs[r - 1], r - 1, t.tl4x4Filter)
						}
						vOff = 2 * cstride
						hOff = 2
					}
					if bw4 == 1 {
						let k = t.at(bx - 1, by)
						let r = int(t.rRef0[k])
						let lf = av1Filter2d[t.lFilter1[by4] * 4 + t.lFilter0[by4]]
						for let pl = 0; pl < 2; pl++ {
							av1Mc(t, false, av1PlaneOf(f, 1 + pl), uvOff + vOff, cstride, t.tmp0, bw4, bh4, bx - 1, by, 1 + pl, int(t.rMvx0[k]), int(t.rMvy0[k]), t.refs[r - 1], r - 1, lf)
						}
						hOff = 2
					}
					if bh4 == ssVer {
						let k = t.at(bx, by - 1)
						let r = int(t.rRef0[k])
						let tf = av1Filter2d[t.aFilter1[bx] * 4 + t.aFilter0[bx]]
						for let pl = 0; pl < 2; pl++ {
							av1Mc(t, false, av1PlaneOf(f, 1 + pl), uvOff + hOff, cstride, t.tmp0, bw4, bh4, bx, by - 1, 1 + pl, int(t.rMvx0[k]), int(t.rMvy0[k]), t.refs[r - 1], r - 1, tf)
						}
						vOff = 2 * cstride
					}
					for let pl = 0; pl < 2; pl++ {
						av1Mc(t, false, av1PlaneOf(f, 1 + pl), uvOff + hOff + vOff, cstride, t.tmp0, bw4, bh4, bx, by, 1 + pl, mvs[0], mvs[1], refp, r0, f2d)
					}
				} else {
					let cwp = av1Min(cbw4, cbh4) > 1 ?? (wp, -2)
					if cwp >= -1 {
						for let pl = 0; pl < 2; pl++ {
							av1WarpAffine(t, false, av1PlaneOf(f, 1 + pl), uvOff, cstride, t.tmp0, bs, 1 + pl, refp, av1WarpMat(t, cwp), cwp >= 0 ?? (cwp * 6, 0), cwp >= 0 ?? (av1GmvAbcd(t, cwp), t.warpAbcd))
						}
					} else {
						for let pl = 0; pl < 2; pl++ {
							av1Mc(t, false, av1PlaneOf(f, 1 + pl), uvOff, cstride, t.tmp0, bw4 << (bw4 == ssHor ?? (1, 0)), bh4 << (bh4 == ssVer ?? (1, 0)), bx & ~ssHor, by & ~ssVer, 1 + pl, mvs[0], mvs[1], refp, r0, f2d)
							av1Obmc(t, av1PlaneOf(f, 1 + pl), uvOff, cstride, bs, 1 + pl, w4, h4) when t.bMotionMode == av1MmObmc
						}
					}
					if t.bInterintraType != 0 {
						for let pl = 0; pl < 2; pl++ {
							av1InterIntra(t, bs, chrIdx, av1PlaneOf(f, 1 + pl), uvOff, cstride, bx >> ssHor, by >> ssVer, t.colStart >> ssHor, t.rowStart >> ssVer, t.colEnd >> ssHor, t.rowEnd >> ssVer, cbw4, cbh4, 1)
						}
					}
				}
			}
			t.tl4x4Filter = f2d
		} else {
			let f2d = t.bFilter2d
			let jw = 0
			let maskArr = t.segMask
			let maskAt = 0
			for let i = 0; i < 2; i++ {
				let r = i == 0 ?? (t.bRef0, t.bRef1)
				let tmp = i == 0 ?? (t.tmp0, t.tmp1)
				if t.bInterMode == av1GlobalmvGlobalmv && t.gmvWarp[r] != 0 {
					av1WarpAffine(t, true, f.y, 0, bw4 * 4, tmp, bs, 0, t.refs[r], h.gmv, r * 6, av1GmvAbcd(t, r))
				} else {
					av1Mc(t, true, f.y, 0, 0, tmp, bw4, bh4, bx, by, 0, mvs[i * 2], mvs[i * 2 + 1], t.refs[r], r, f2d)
				}
			}
			let ta = t.bMaskSign == 1 ?? (t.tmp1, t.tmp0)
			let tb = t.bMaskSign == 1 ?? (t.tmp0, t.tmp1)
			let ct = t.bCompType
			if ct == av1CompInterAvg {
				av1Avg(f.y, dst, stride, t.tmp0, t.tmp1, bw4 * 4, bh4 * 4, bd)
			} else if ct == av1CompInterWeightedAvg {
				jw = t.jntW[t.bRef0 * 7 + t.bRef1]
				av1WAvg(f.y, dst, stride, t.tmp0, t.tmp1, bw4 * 4, bh4 * 4, jw, bd)
			} else if ct == av1CompInterSeg {
				av1WMask(f.y, dst, stride, ta, tb, bw4 * 4, bh4 * 4, t.segMask, t.bMaskSign, chrIdx > 0 ?? (1, 0), chrIdx == 2 ?? (1, 0), bd)
			} else {
				let m = t.masks
				maskArr = m.data
				let b = bs - av1Bs32x32
				maskAt = m.wedge[((0 * 11 + b) * 2) * 16 + t.bWedgeIdx]
				av1MaskBlend(f.y, dst, stride, ta, tb, bw4 * 4, bh4 * 4, maskArr, maskAt, bd)
				maskAt = m.wedge[((chrIdx * 11 + b) * 2 + t.bMaskSign) * 16 + t.bWedgeIdx] when hasChroma
			}
			if hasChroma {
				for let pl = 0; pl < 2; pl++ {
					for let i = 0; i < 2; i++ {
						let r = i == 0 ?? (t.bRef0, t.bRef1)
						let tmp = i == 0 ?? (t.tmp0, t.tmp1)
						if t.bInterMode == av1GlobalmvGlobalmv && av1Min(cbw4, cbh4) > 1 && t.gmvWarp[r] != 0 {
							av1WarpAffine(t, true, f.y, 0, (bw4 * 4) >> ssHor, tmp, bs, 1 + pl, t.refs[r], h.gmv, r * 6, av1GmvAbcd(t, r))
						} else {
							av1Mc(t, true, f.y, 0, 0, tmp, bw4, bh4, bx, by, 1 + pl, mvs[i * 2], mvs[i * 2 + 1], t.refs[r], r, f2d)
						}
					}
					let uv = av1PlaneOf(f, 1 + pl)
					let cw = (bw4 * 4) >> ssHor
					let ch = (bh4 * 4) >> ssVer
					if ct == av1CompInterAvg {
						av1Avg(uv, uvOff, cstride, t.tmp0, t.tmp1, cw, ch, bd)
					} else if ct == av1CompInterWeightedAvg {
						av1WAvg(uv, uvOff, cstride, t.tmp0, t.tmp1, cw, ch, jw, bd)
					} else {
						av1MaskBlend(uv, uvOff, cstride, ta, tb, cw, ch, maskArr, maskAt, bd)
					}
				}
			}
		}
		let cw4 = (w4 + ssHor) >> ssHor
		let ch4 = (h4 + ssVer) >> ssVer
		let aw = t.aMode.len()
		if t.bSkip {
			av1FillCtx(t.aLcoef, bx, bw4, 0x40)
			av1FillCtx(t.lLcoef, by4, bh4, 0x40)
			if hasChroma {
				av1FillCtx(t.aCcoef, cbx4, cbw4, 0x40)
				av1FillCtx(t.aCcoef, aw + cbx4, cbw4, 0x40)
				av1FillCtx(t.lCcoef, cby4, cbh4, 0x40)
				av1FillCtx(t.lCcoef, 32 + cby4, cbh4, 0x40)
			}
			return none
		}
		let ud = t.bUvtx * 8
		let uw = av1TxDims[ud]
		let uh = av1TxDims[ud + 1]
		let yd = t.bMaxYtx * 8
		let yw = av1TxDims[yd]
		let yh = av1TxDims[yd + 1]
		for let initY = 0; initY < bh4; initY += 16 {
			for let initX = 0; initX < bw4; initX += 16 {
				let yOff = initY != 0 ?? (1, 0)
				for let y = initY; y < av1Min(h4, initY + 16); y += yh {
					let xOff = initX != 0 ?? (1, 0)
					t.by = by + y
					for let x = initX; x < av1Min(w4, initX + 16); x += yw {
						t.bx = bx + x
						av1ReadCoefTree(t, bs, t.bMaxYtx, 0, xOff, yOff, 4 * ((by + y) * stride + bx + x))
						xOff++
					}
					yOff++
				}
				t.bx = bx
				t.by = by
				continue when !hasChroma
				for let pl = 0; pl < 2; pl++ {
					let uv = av1PlaneOf(f, 1 + pl)
					for let y = initY >> ssVer; y < av1Min(ch4, (initY + 16) >> ssVer); y += uh {
						let lby = by + (y << ssVer)
						for let x = initX >> ssHor; x < av1Min(cw4, (initX + 16) >> ssHor); x += uw {
							let lbx = bx + (x << ssHor)
							let ytxtp = t.txtpMap[(by4 + (y << ssVer)) * 32 + bx4 + (x << ssHor)]
							let d = uvOff + 4 * (y * cstride + x)
							let eob = av1DecodeCoefs(t, t.aCcoef, pl * aw + cbx4 + x, t.lCcoef, pl * 32 + cby4 + y, 127, t.bUvtx, bs, false, 1 + pl, ytxtp)
							av1FillCtx(t.aCcoef, pl * aw + cbx4 + x, av1Min(uw, (t.bw - lbx + ssHor) >> ssHor), t.coefCtx)
							av1FillCtx(t.lCcoef, pl * 32 + cby4 + y, av1Min(uh, (t.bh - lby + ssVer) >> ssVer), t.coefCtx)
							av1InvTxfmAdd(uv, d, cstride, t.cf, eob, t.bUvtx, t.coefTxtp, bd, t.tmp32) when eob >= 0
						}
					}
				}
			}
		}
		return none
	}

	def av1GmvAbcd(t Av1Tile, r int) int[] {
		let a = t.abcdTmp
		for let i = 0; i < 4; i++ {
			a[i] = t.gmvAbcd[r * 4 + i]
		}
		return a
	}

	// The inter-intra blend of one plane: an intra prediction of the
	// block blended into the inter prediction at dst.
	def av1InterIntra(t Av1Tile, bs int, c int, pix uint16[], dst int, stride int, x4 int, y4 int, xs int, ys int, xe int, ye int, w4 int, h4 int, _ int) {
		let m = t.bInterintraMode == av1IiSmoothPred ?? (av1SmoothPred, t.bInterintraMode)
		let ang = t.ang
		ang[0] = 0
		let e = t.edgeBuf
		let im = av1PrepareEdges(x4, x4 > xs, y4, y4 > ys, xe, ye, 0, pix, dst, stride, m, ang, w4, h4, false, e, t.bitDepth)
		let tmp = t.iiTmp
		av1IntraPred(im, tmp, 0, w4 * 4, e, w4 * 4, h4 * 4, 0, 0, 0, t.bitDepth, t.edgeTmp)
		let mk = t.masks
		let b = bs - av1Bs32x32
		let at = t.bInterintraType == av1InterIntraBlend ?? (mk.ii[(c * 11 + b) * 4 + t.bInterintraMode], mk.wedge[((c * 11 + b) * 2) * 16 + t.bWedgeIdx])
		av1Blend(pix, dst, stride, tmp, w4 * 4, h4 * 4, mk.data, at)
	}
}
