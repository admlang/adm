internal partial module std.formats.video.av1 {
	use std.simd

	// Deblocking (dav1d lf_mask.c, lf_apply_tmpl.c and loopfilter_tmpl.c).
	// Blocks record their edges frame-wide as they decode: lfEdgeY and
	// lfEdgeUv hold per 4x4 and direction the filter class + 1, lfLevel
	// the levels (luma vertical, luma horizontal at the luma position, u
	// and v at the chroma position), lpfTx the transform classes a
	// neighbour's edges compare with. The filter runs over the whole frame
	// once all tiles are decoded, vertical edges first.

	def av1FillLevels(t Av1Tile, x0 int, y0 int, w int, h int, slot int, v0 int, v1 int) {
		let st = t.b4Stride
		for let y = 0; y < h; y++ {
			let o = ((y0 + y) * st + x0) * 4 + slot
			for let x = 0; x < w; x++ {
				t.lfLevel[o + x * 4] = byte(v0)
				t.lfLevel[o + x * 4 + 1] = byte(v1)
			}
		}
	}

	def av1Min(a int, b int) int {
		return a < b ?? (a, b)
	}

	// The block edges of a luma or chroma block against its left and top
	// neighbours; `w`/`h` give its own classes per row and column.
	def av1MaskBlockEdges(t Av1Tile, edges byte[], x0 int, y0 int, w4 int, h4 int, slot int, deflt int, txW int[], txH int[], uniformW int, uniformH int) {
		let st = t.b4Stride
		for let y = 0; y < h4; y++ {
			let at = (y0 + y) * st + x0
			let lc = x0 > 0 ?? (int(t.lpfTx[(at - 1) * 4 + slot]), deflt)
			let own = uniformW >= 0 ?? (uniformW, txW[y * 32])
			edges[at * 2] = byte(av1Min(own, lc) + 1)
		}
		for let x = 0; x < w4; x++ {
			let at = y0 * st + x0 + x
			let ac = y0 > 0 ?? (int(t.lpfTx[(at - st) * 4 + slot + 1]), deflt)
			let own = uniformH >= 0 ?? (uniformH, txH[x])
			edges[at * 2 + 1] = byte(av1Min(own, ac) + 1)
		}
	}

	def av1SetLpfTx(t Av1Tile, x0 int, y0 int, w4 int, h4 int, slot int, cw int, ch int) {
		let st = t.b4Stride
		for let y = 0; y < h4; y++ {
			let o = ((y0 + y) * st + x0) * 4 + slot
			for let x = 0; x < w4; x++ {
				t.lpfTx[o + x * 4] = byte(cw)
				t.lpfTx[o + x * 4 + 1] = byte(ch)
			}
		}
	}

	// Inner transform edges of a block with one transform size.
	def av1MaskInnerUniform(t Av1Tile, edges byte[], x0 int, y0 int, w4 int, h4 int, tw int, th int, cw int, ch int) {
		let st = t.b4Stride
		for let x = tw; x < w4; x += tw {
			for let y = 0; y < h4; y++ {
				edges[((y0 + y) * st + x0 + x) * 2] = byte(cw + 1)
			}
		}
		for let y = th; y < h4; y += th {
			for let x = 0; x < w4; x++ {
				edges[((y0 + y) * st + x0 + x) * 2 + 1] = byte(ch + 1)
			}
		}
	}

	// The chroma half of create_lf_mask_intra/inter.
	def av1LfMaskChroma(t Av1Tile, bs int, uvtx int, lvlAt int, skipInter bool) {
		let ssHor = t.ssHor
		let ssVer = t.ssVer
		let bx = t.bx
		let by = t.by
		let cbw4 = av1Min(((t.bw + ssHor) >> ssHor) - (bx >> ssHor), (av1BlockDims[bs * 4] + ssHor) >> ssHor)
		let cbh4 = av1Min(((t.bh + ssVer) >> ssVer) - (by >> ssVer), (av1BlockDims[bs * 4 + 1] + ssVer) >> ssVer)
		return when cbw4 <= 0 || cbh4 <= 0
		let cx = bx >> ssHor
		let cy = by >> ssVer
		av1FillLevels(t, cx, cy, cbw4, cbh4, 2, t.lflvl[lvlAt + 32], t.lflvl[lvlAt + 48])
		let d = uvtx * 8
		let cw = av1TxDims[d + 2] != 0 ?? (1, 0)
		let ch = av1TxDims[d + 3] != 0 ?? (1, 0)
		av1MaskBlockEdges(t, t.lfEdgeUv, cx, cy, cbw4, cbh4, 2, 1, t.txaW, t.txaH, cw, ch)
		av1MaskInnerUniform(t, t.lfEdgeUv, cx, cy, cbw4, cbh4, av1TxDims[d], av1TxDims[d + 1], cw, ch) unless skipInter
		av1SetLpfTx(t, cx, cy, cbw4, cbh4, 2, cw, ch)
	}

	// dav1d_create_lf_mask_intra for the tile's current block.
	def av1LfMaskIntra(t Av1Tile, bs int, ytx int, uvtx int, hasChroma bool) {
		let bw4 = av1Min(t.bw - t.bx, av1BlockDims[bs * 4])
		let bh4 = av1Min(t.bh - t.by, av1BlockDims[bs * 4 + 1])
		let lvlAt = t.bSegId * 64
		if bw4 > 0 && bh4 > 0 {
			av1FillLevels(t, t.bx, t.by, bw4, bh4, 0, t.lflvl[lvlAt], t.lflvl[lvlAt + 16])
			let d = ytx * 8
			let cw = av1Min(2, av1TxDims[d + 2])
			let ch = av1Min(2, av1TxDims[d + 3])
			av1MaskBlockEdges(t, t.lfEdgeY, t.bx, t.by, bw4, bh4, 0, 2, t.txaW, t.txaH, cw, ch)
			av1MaskInnerUniform(t, t.lfEdgeY, t.bx, t.by, bw4, bh4, av1TxDims[d], av1TxDims[d + 1], cw, ch)
			av1SetLpfTx(t, t.bx, t.by, bw4, bh4, 0, cw, ch)
		}
		av1LfMaskChroma(t, bs, uvtx, lvlAt, false) when hasChroma
	}

	// decomp_tx: the transform classes and steps of the var-tx tree.
	def av1DecompTx(t Av1Tile, from int, depth int, yOff int, xOff int, y0 int, x0 int) {
		let d = from * 8
		let masks = depth == 0 ?? (t.bTxSplit0, t.bTxSplit1)
		let split = from != av1Tx4x4 && depth <= 1 && ((masks >> (yOff * 4 + xOff)) & 1) != 0
		let w = av1TxDims[d]
		let h = av1TxDims[d + 1]
		if split {
			let sub = av1TxDims[d + 6]
			let hw = w >> 1
			let hh = h >> 1
			av1DecompTx(t, sub, depth + 1, yOff * 2, xOff * 2, y0, x0)
			av1DecompTx(t, sub, depth + 1, yOff * 2, xOff * 2 + 1, y0, x0 + hw) when w >= h
			if h >= w {
				av1DecompTx(t, sub, depth + 1, yOff * 2 + 1, xOff * 2, y0 + hh, x0)
				av1DecompTx(t, sub, depth + 1, yOff * 2 + 1, xOff * 2 + 1, y0 + hh, x0 + hw) when w >= h
			}
			return
		}
		let lw = av1Min(2, av1TxDims[d + 2])
		let lh = av1Min(2, av1TxDims[d + 3])
		for let y = 0; y < h; y++ {
			let o = (y0 + y) * 32 + x0
			for let x = 0; x < w; x++ {
				t.txaW[o + x] = lw
				t.txaH[o + x] = lh
			}
			t.txaStepW[o] = w
		}
		for let x = 0; x < w; x++ {
			t.txaStepH[y0 * 32 + x0 + x] = h
		}
	}

	// dav1d_create_lf_mask_inter for the tile's current block.
	def av1LfMaskInter(t Av1Tile, bs int, skip bool, maxYtx int, uvtx int, hasChroma bool, refPlus1 int, notGlobal bool) {
		let bw4 = av1Min(t.bw - t.bx, av1BlockDims[bs * 4])
		let bh4 = av1Min(t.bh - t.by, av1BlockDims[bs * 4 + 1])
		let lvlAt = t.bSegId * 64 + refPlus1 * 2 + (notGlobal ?? (1, 0))
		if bw4 > 0 && bh4 > 0 {
			let st = t.b4Stride
			av1FillLevels(t, t.bx, t.by, bw4, bh4, 0, t.lflvl[lvlAt], t.lflvl[lvlAt + 16])
			let d = maxYtx * 8
			let mw = av1TxDims[d]
			let mh = av1TxDims[d + 1]
			let yOff = 0
			for let y = 0; y < bh4; y += mh {
				let xOff = 0
				for let x = 0; x < bw4; x += mw {
					av1DecompTx(t, maxYtx, 0, yOff, xOff, y, x)
					xOff++
				}
				yOff++
			}
			av1MaskBlockEdges(t, t.lfEdgeY, t.bx, t.by, bw4, bh4, 0, 2, t.txaW, t.txaH, -1, -1)
			if !skip {
				for let y = 0; y < bh4; y++ {
					let ltx = t.txaW[y * 32]
					let step = t.txaStepW[y * 32]
					let x = step
					for x < bw4 {
						let rtx = t.txaW[y * 32 + x]
						t.lfEdgeY[((t.by + y) * st + t.bx + x) * 2] = byte(av1Min(rtx, ltx) + 1)
						ltx = rtx
						step = t.txaStepW[y * 32 + x]
						x += step
					}
				}
				for let x = 0; x < bw4; x++ {
					let ttx = t.txaH[x]
					let step = t.txaStepH[x]
					let y = step
					for y < bh4 {
						let btx = t.txaH[y * 32 + x]
						t.lfEdgeY[((t.by + y) * st + t.bx + x) * 2 + 1] = byte(av1Min(ttx, btx) + 1)
						ttx = btx
						step = t.txaStepH[y * 32 + x]
						y += step
					}
				}
			}
			for let y = 0; y < bh4; y++ {
				let o = ((t.by + y) * st + t.bx) * 4
				for let x = 0; x < bw4; x++ {
					t.lpfTx[o + x * 4] = byte(t.txaW[y * 32 + x])
					t.lpfTx[o + x * 4 + 1] = byte(t.txaH[y * 32 + x])
				}
			}
		}
		av1LfMaskChroma(t, bs, uvtx, lvlAt, skip) when hasChroma
	}

	// loop_filter: one edge segment of 4 lines; `sa` steps along the
	// edge, `sb` across it.
	def av1LoopFilter(p uint16[], at0 int, e0 int, i0 int, h0 int, sa int, sb int, wd int, bitDepth int) {
		let bd8 = bitDepth - 8
		let f = 1 << bd8
		let e = e0 << bd8
		let ii = i0 << bd8
		let hh = h0 << bd8
		let maxv = (1 << bitDepth) - 1
		let dmin = -128 * (1 << bd8)
		let dmax = 128 * (1 << bd8) - 1
		let at = at0
		for let n = 0; n < 4; n++ {
			let p1 = int(p[at - 2 * sb])
			let p0 = int(p[at - sb])
			let q0 = int(p[at])
			let q1 = int(p[at + sb])
			let p2 = 0
			let q2 = 0
			let p3 = 0
			let q3 = 0
			let fm = av1Abs(p1 - p0) <= ii && av1Abs(q1 - q0) <= ii && av1Abs(p0 - q0) * 2 + (av1Abs(p1 - q1) >> 1) <= e
			if wd > 4 {
				p2 = int(p[at - 3 * sb])
				q2 = int(p[at + 2 * sb])
				fm = fm && av1Abs(p2 - p1) <= ii && av1Abs(q2 - q1) <= ii
				if wd > 6 {
					p3 = int(p[at - 4 * sb])
					q3 = int(p[at + 3 * sb])
					fm = fm && av1Abs(p3 - p2) <= ii && av1Abs(q3 - q2) <= ii
				}
			}
			if !fm {
				at += sa
				continue
			}
			let flat8out = false
			let p4 = 0
			let p5 = 0
			let p6 = 0
			let q4 = 0
			let q5 = 0
			let q6 = 0
			if wd >= 16 {
				p6 = int(p[at - 7 * sb])
				p5 = int(p[at - 6 * sb])
				p4 = int(p[at - 5 * sb])
				q4 = int(p[at + 4 * sb])
				q5 = int(p[at + 5 * sb])
				q6 = int(p[at + 6 * sb])
				flat8out = av1Abs(p6 - p0) <= f && av1Abs(p5 - p0) <= f && av1Abs(p4 - p0) <= f && av1Abs(q4 - q0) <= f && av1Abs(q5 - q0) <= f && av1Abs(q6 - q0) <= f
			}
			let flat8in = false
			flat8in = av1Abs(p2 - p0) <= f && av1Abs(p1 - p0) <= f && av1Abs(q1 - q0) <= f && av1Abs(q2 - q0) <= f when wd >= 6
			flat8in = flat8in && av1Abs(p3 - p0) <= f && av1Abs(q3 - q0) <= f when wd >= 8
			if wd >= 16 && flat8out && flat8in {
				p[at - 6 * sb] = uint16((p6 * 7 + p5 * 2 + p4 * 2 + p3 + p2 + p1 + p0 + q0 + 8) >> 4)
				p[at - 5 * sb] = uint16((p6 * 5 + p5 * 2 + p4 * 2 + p3 * 2 + p2 + p1 + p0 + q0 + q1 + 8) >> 4)
				p[at - 4 * sb] = uint16((p6 * 4 + p5 + p4 * 2 + p3 * 2 + p2 * 2 + p1 + p0 + q0 + q1 + q2 + 8) >> 4)
				p[at - 3 * sb] = uint16((p6 * 3 + p5 + p4 + p3 * 2 + p2 * 2 + p1 * 2 + p0 + q0 + q1 + q2 + q3 + 8) >> 4)
				p[at - 2 * sb] = uint16((p6 * 2 + p5 + p4 + p3 + p2 * 2 + p1 * 2 + p0 * 2 + q0 + q1 + q2 + q3 + q4 + 8) >> 4)
				p[at - sb] = uint16((p6 + p5 + p4 + p3 + p2 + p1 * 2 + p0 * 2 + q0 * 2 + q1 + q2 + q3 + q4 + q5 + 8) >> 4)
				p[at] = uint16((p5 + p4 + p3 + p2 + p1 + p0 * 2 + q0 * 2 + q1 * 2 + q2 + q3 + q4 + q5 + q6 + 8) >> 4)
				p[at + sb] = uint16((p4 + p3 + p2 + p1 + p0 + q0 * 2 + q1 * 2 + q2 * 2 + q3 + q4 + q5 + q6 * 2 + 8) >> 4)
				p[at + 2 * sb] = uint16((p3 + p2 + p1 + p0 + q0 + q1 * 2 + q2 * 2 + q3 * 2 + q4 + q5 + q6 * 3 + 8) >> 4)
				p[at + 3 * sb] = uint16((p2 + p1 + p0 + q0 + q1 + q2 * 2 + q3 * 2 + q4 * 2 + q5 + q6 * 4 + 8) >> 4)
				p[at + 4 * sb] = uint16((p1 + p0 + q0 + q1 + q2 + q3 * 2 + q4 * 2 + q5 * 2 + q6 * 5 + 8) >> 4)
				p[at + 5 * sb] = uint16((p0 + q0 + q1 + q2 + q3 + q4 * 2 + q5 * 2 + q6 * 7 + 8) >> 4)
			} else if wd >= 8 && flat8in {
				p[at - 3 * sb] = uint16((p3 * 3 + 2 * p2 + p1 + p0 + q0 + 4) >> 3)
				p[at - 2 * sb] = uint16((p3 * 2 + p2 + 2 * p1 + p0 + q0 + q1 + 4) >> 3)
				p[at - sb] = uint16((p3 + p2 + p1 + 2 * p0 + q0 + q1 + q2 + 4) >> 3)
				p[at] = uint16((p2 + p1 + p0 + 2 * q0 + q1 + q2 + q3 + 4) >> 3)
				p[at + sb] = uint16((p1 + p0 + q0 + 2 * q1 + q2 + q3 * 2 + 4) >> 3)
				p[at + 2 * sb] = uint16((p0 + q0 + q1 + 2 * q2 + q3 * 3 + 4) >> 3)
			} else if wd == 6 && flat8in {
				p[at - 2 * sb] = uint16((p2 * 3 + 2 * p1 + 2 * p0 + q0 + 4) >> 3)
				p[at - sb] = uint16((p2 + 2 * p1 + 2 * p0 + 2 * q0 + q1 + 4) >> 3)
				p[at] = uint16((p1 + 2 * p0 + 2 * q0 + 2 * q1 + q2 + 4) >> 3)
				p[at + sb] = uint16((p0 + 2 * q0 + 2 * q1 + q2 * 3 + 4) >> 3)
			} else {
				let hev = av1Abs(p1 - p0) > hh || av1Abs(q1 - q0) > hh
				if hev {
					let fv = av1ClipI(p1 - q1, dmin, dmax)
					fv = av1ClipI(3 * (q0 - p0) + fv, dmin, dmax)
					let f1 = av1Min(fv + 4, dmax) >> 3
					let f2 = av1Min(fv + 3, dmax) >> 3
					p[at - sb] = uint16(av1ClipI(p0 + f2, 0, maxv))
					p[at] = uint16(av1ClipI(q0 - f1, 0, maxv))
				} else {
					let fv = av1ClipI(3 * (q0 - p0), dmin, dmax)
					let f1 = av1Min(fv + 4, dmax) >> 3
					let f2 = av1Min(fv + 3, dmax) >> 3
					p[at - sb] = uint16(av1ClipI(p0 + f2, 0, maxv))
					p[at] = uint16(av1ClipI(q0 - f1, 0, maxv))
					let g = (f1 + 1) >> 1
					p[at - 2 * sb] = uint16(av1ClipI(p1 + g, 0, maxv))
					p[at + sb] = uint16(av1ClipI(q1 - g, 0, maxv))
				}
			}
			at += sa
		}
	}

	// The level and filter width of the edge of class byte `c` at 4x4
	// block `at` (the level falls back to the neighbour at `back`).
	def av1EdgeLevel(t Av1Tile, c int, at int, back int, slot int) int {
		return 0 when c == 0
		let l = int(t.lfLevel[at * 4 + slot])
		l = int(t.lfLevel[back * 4 + slot]) when l == 0
		return l
	}

	// The deblocking of one plane: `edges` on the plane's 4x4 grid,
	// levels from `slot`, `luma` choosing the 4/8/16 or 4/6 filters. Two
	// 4-line segments go through the vector filter at a time; the few
	// edges too close to the frame's top or left for its loads take the
	// scalar one.
	def av1DeblockPlane(t Av1Tile, p uint16[], stride int, w4 int, h4 int, edges byte[], slot0 int, slot1 int, luma bool, lutE int[], lutI int[]) {
		// Vertical edges in bands of rows, then horizontal ones in bands of
		// columns.
		for let pass = 0; pass < 2; pass++ {
			let vertical = pass == 0
			let units = vertical ?? ((h4 + 1) >> 1, (w4 + 1) >> 1)
			let bands = av1BandCount(units * (vertical ?? (w4, h4)) / 64)
			let slot = vertical ?? (slot0, slot1)
			if bands == 1 {
				if vertical {
					av1DeblockRows(t, p, stride, w4, h4, edges, slot, luma, lutE, lutI, 0, h4)
				} else {
					av1DeblockCols(t, p, stride, w4, h4, edges, slot, luma, lutE, lutI, 0, w4)
				}
				continue
			}
			let done = new channel<bool>(size = bands)
			for let b = 0; b < bands; b++ {
				async av1DeblockTask(t, p, stride, w4, h4, edges, slot, luma, lutE, lutI, vertical, 2 * (units * b / bands), 2 * (units * (b + 1) / bands), done)
			}
			for let b = 0; b < bands; b++ {
				<-done
			}
		}
	}

	// The vertical edges of the 4x4 rows from..<to (even).
	def av1DeblockRows(t Av1Tile, p uint16[], stride int, w4 int, h4 int, edges byte[], slot0 int, luma bool, lutE int[], lutI int[], from int, to int) {
		let st = t.b4Stride
		let depth = t.bitDepth
		for let y = from; y < to && y < h4; y += 2 {
			for let x = 1; x < w4; x++ {
				let a0 = y * st + x
				let a1 = a0 + st
				let c0 = int(edges[a0 * 2])
				let c1 = y + 1 < h4 ?? (int(edges[a1 * 2]), 0)
				let l0 = av1EdgeLevel(t, c0, a0, a0 - 1, slot0)
				let l1 = av1EdgeLevel(t, c1, a1, a1 - 1, slot0)
				continue when l0 == 0 && l1 == 0
				let w0 = l0 == 0 ?? (0, luma ?? (4 << (c0 - 1), 4 + 2 * (c0 - 1)))
				let w1 = l1 == 0 ?? (0, luma ?? (4 << (c1 - 1), 4 + 2 * (c1 - 1)))
				if x * 4 >= 8 {
					av1Deblock8(p, y * 4 * stride + x * 4, stride, true, w0, w1, l0, l1, lutE, lutI, depth)
				} else {
					av1LoopFilter(p, y * 4 * stride + x * 4, lutE[l0], lutI[l0], l0 >> 4, stride, 1, w0, depth) when l0 != 0
					av1LoopFilter(p, (y + 1) * 4 * stride + x * 4, lutE[l1], lutI[l1], l1 >> 4, stride, 1, w1, depth) when l1 != 0
				}
			}
		}
	}

	// The horizontal edges of the 4x4 columns from..<to (even).
	def av1DeblockCols(t Av1Tile, p uint16[], stride int, w4 int, h4 int, edges byte[], slot1 int, luma bool, lutE int[], lutI int[], from int, to int) {
		let st = t.b4Stride
		let depth = t.bitDepth
		for let y = 1; y < h4; y++ {
			for let x = from; x < to && x < w4; x += 2 {
				let a0 = y * st + x
				let a1 = a0 + 1
				let c0 = int(edges[a0 * 2 + 1])
				let c1 = x + 1 < w4 ?? (int(edges[a1 * 2 + 1]), 0)
				let l0 = av1EdgeLevel(t, c0, a0, a0 - st, slot1)
				let l1 = av1EdgeLevel(t, c1, a1, a1 - st, slot1)
				continue when l0 == 0 && l1 == 0
				let w0 = l0 == 0 ?? (0, luma ?? (4 << (c0 - 1), 4 + 2 * (c0 - 1)))
				let w1 = l1 == 0 ?? (0, luma ?? (4 << (c1 - 1), 4 + 2 * (c1 - 1)))
				if y * 4 >= 8 {
					av1Deblock8(p, y * 4 * stride + x * 4, stride, false, w0, w1, l0, l1, lutE, lutI, depth)
				} else {
					av1LoopFilter(p, y * 4 * stride + x * 4, lutE[l0], lutI[l0], l0 >> 4, 1, stride, w0, depth) when l0 != 0
					av1LoopFilter(p, y * 4 * stride + (x + 1) * 4, lutE[l1], lutI[l1], l1 >> 4, 1, stride, w1, depth) when l1 != 0
				}
			}
		}
	}

	const av1Low4Lanes = int32[1, 1, 1, 1, 0, 0, 0, 0]

	// loop_filter on two edge segments of 4 lines at once, a line per
	// lane (lanes 0-3 the first segment, 4-7 the second, each with its own
	// filter width and level; width 0 leaves a segment alone). Vertical
	// edges (lines are rows) are read and written through 8x8 transposes,
	// horizontal ones (lines are columns) straight.
	def av1Deblock8(p uint16[], at int, stride int, vertical bool, wd0 int, wd1 int, l0 int, l1 int, lutE int[], lutI int[], bd int) {
		let bd8 = bd - 8
		let zero = simd.splat8<int32>(int32(0))
		let low = simd.load8<int32>(av1Low4Lanes, 0).ne(zero)
		let e = low.blend(simd.splat8<int32>(int32(lutE[l0] << bd8)), simd.splat8<int32>(int32(lutE[l1] << bd8)))
		let ii = low.blend(simd.splat8<int32>(int32(lutI[l0] << bd8)), simd.splat8<int32>(int32(lutI[l1] << bd8)))
		let hh = low.blend(simd.splat8<int32>(int32((l0 >> 4) << bd8)), simd.splat8<int32>(int32((l1 >> 4) << bd8)))
		let wd = low.blend(simd.splat8<int32>(int32(wd0)), simd.splat8<int32>(int32(wd1)))
		let f = simd.splat8<int32>(int32(1 << bd8))
		let maxv = simd.splat8<int32>(int32((1 << bd) - 1))
		let dmin = simd.splat8<int32>(int32(-128 * (1 << bd8)))
		let dmax = simd.splat8<int32>(int32(128 * (1 << bd8) - 1))
		let m6 = wd.ge(simd.splat8<int32>(int32(6)))
		let m8 = wd.ge(simd.splat8<int32>(int32(8)))
		let m16 = wd.ge(simd.splat8<int32>(int32(16)))
		let only6 = wd.eq(simd.splat8<int32>(int32(6)))
		let on = wd.gt(zero)
		let tm8 = zero
		let tm7 = zero
		let tm6 = zero
		let tm5 = zero
		let tm4 = zero
		let tm3 = zero
		let tm2 = zero
		let tm1 = zero
		let t0 = zero
		let t1 = zero
		let t2 = zero
		let t3 = zero
		let t4 = zero
		let t5 = zero
		let t6 = zero
		let t7 = zero
		if vertical {
			let a0 = simd.convert<uint16, int32>(simd.load8<uint16>(p, at - 8))
			let a1 = simd.convert<uint16, int32>(simd.load8<uint16>(p, at + stride - 8))
			let a2 = simd.convert<uint16, int32>(simd.load8<uint16>(p, at + 2 * stride - 8))
			let a3 = simd.convert<uint16, int32>(simd.load8<uint16>(p, at + 3 * stride - 8))
			let a4 = simd.convert<uint16, int32>(simd.load8<uint16>(p, at + 4 * stride - 8))
			let a5 = simd.convert<uint16, int32>(simd.load8<uint16>(p, at + 5 * stride - 8))
			let a6 = simd.convert<uint16, int32>(simd.load8<uint16>(p, at + 6 * stride - 8))
			let a7 = simd.convert<uint16, int32>(simd.load8<uint16>(p, at + 7 * stride - 8))
			(tm8, tm7, tm6, tm5, tm4, tm3, tm2, tm1) = simd.transpose8(a0, a1, a2, a3, a4, a5, a6, a7)
			let b0 = simd.convert<uint16, int32>(simd.load8<uint16>(p, at))
			let b1 = simd.convert<uint16, int32>(simd.load8<uint16>(p, at + stride))
			let b2 = simd.convert<uint16, int32>(simd.load8<uint16>(p, at + 2 * stride))
			let b3 = simd.convert<uint16, int32>(simd.load8<uint16>(p, at + 3 * stride))
			let b4 = simd.convert<uint16, int32>(simd.load8<uint16>(p, at + 4 * stride))
			let b5 = simd.convert<uint16, int32>(simd.load8<uint16>(p, at + 5 * stride))
			let b6 = simd.convert<uint16, int32>(simd.load8<uint16>(p, at + 6 * stride))
			let b7 = simd.convert<uint16, int32>(simd.load8<uint16>(p, at + 7 * stride))
			(t0, t1, t2, t3, t4, t5, t6, t7) = simd.transpose8(b0, b1, b2, b3, b4, b5, b6, b7)
		} else {
			tm7 = simd.convert<uint16, int32>(simd.load8<uint16>(p, at - 7 * stride))
			tm6 = simd.convert<uint16, int32>(simd.load8<uint16>(p, at - 6 * stride))
			tm5 = simd.convert<uint16, int32>(simd.load8<uint16>(p, at - 5 * stride))
			tm4 = simd.convert<uint16, int32>(simd.load8<uint16>(p, at - 4 * stride))
			tm3 = simd.convert<uint16, int32>(simd.load8<uint16>(p, at - 3 * stride))
			tm2 = simd.convert<uint16, int32>(simd.load8<uint16>(p, at - 2 * stride))
			tm1 = simd.convert<uint16, int32>(simd.load8<uint16>(p, at - stride))
			t0 = simd.convert<uint16, int32>(simd.load8<uint16>(p, at))
			t1 = simd.convert<uint16, int32>(simd.load8<uint16>(p, at + stride))
			t2 = simd.convert<uint16, int32>(simd.load8<uint16>(p, at + 2 * stride))
			t3 = simd.convert<uint16, int32>(simd.load8<uint16>(p, at + 3 * stride))
			t4 = simd.convert<uint16, int32>(simd.load8<uint16>(p, at + 4 * stride))
			t5 = simd.convert<uint16, int32>(simd.load8<uint16>(p, at + 5 * stride))
			t6 = simd.convert<uint16, int32>(simd.load8<uint16>(p, at + 6 * stride))
		}
		let p6 = tm7
		let p5 = tm6
		let p4 = tm5
		let p3 = tm4
		let p2 = tm3
		let p1 = tm2
		let p0 = tm1
		let q0 = t0
		let q1 = t1
		let q2 = t2
		let q3 = t3
		let q4 = t4
		let q5 = t5
		let q6 = t6
		let fm = on & (p1 - p0).abs().le(ii) & (q1 - q0).abs().le(ii) & ((p0 - q0).abs() * simd.splat8<int32>(int32(2)) + ((p1 - q1).abs() >> 1)).le(e)
		fm = fm & (m6.invert() | ((p2 - p1).abs().le(ii) & (q2 - q1).abs().le(ii)))
		fm = fm & (m8.invert() | ((p3 - p2).abs().le(ii) & (q3 - q2).abs().le(ii)))
		return unless fm.any()
		let flat8in = (p2 - p0).abs().le(f) & (p1 - p0).abs().le(f) & (q1 - q0).abs().le(f) & (q2 - q0).abs().le(f)
		flat8in = flat8in & (m8.invert() | ((p3 - p0).abs().le(f) & (q3 - q0).abs().le(f)))
		let flat8out = (p6 - p0).abs().le(f) & (p5 - p0).abs().le(f) & (p4 - p0).abs().le(f) & (q4 - q0).abs().le(f) & (q5 - q0).abs().le(f) & (q6 - q0).abs().le(f)
		let c16 = fm & m16 & flat8out & flat8in
		let c8 = fm & m8 & flat8in & c16.invert()
		let c6 = fm & only6 & flat8in
		let cn = fm & (c16 | c8 | c6).invert()
		let two = simd.splat8<int32>(int32(2))
		let three = simd.splat8<int32>(int32(3))
		let four = simd.splat8<int32>(int32(4))
		let eight = simd.splat8<int32>(int32(8))
		// Narrow filter.
		let hev = (p1 - p0).abs().gt(hh) | (q1 - q0).abs().gt(hh)
		let fa = hev.blend(simd.clamp(p1 - q1, dmin, dmax), zero)
		fa = simd.clamp((q0 - p0) * three + fa, dmin, dmax)
		let f1 = simd.min(fa + four, dmax) >> 3
		let f2 = simd.min(fa + three, dmax) >> 3
		let np0 = simd.clamp(p0 + f2, zero, maxv)
		let nq0 = simd.clamp(q0 - f1, zero, maxv)
		let g = (f1 + simd.splat8<int32>(int32(1))) >> 1
		let np1 = hev.blend(p1, simd.clamp(p1 + g, zero, maxv))
		let nq1 = hev.blend(q1, simd.clamp(q1 - g, zero, maxv))
		// 6-tap (chroma).
		let s6p1 = (p2 * three + p1 * two + p0 * two + q0 + four) >> 3
		let s6p0 = (p2 + p1 * two + p0 * two + q0 * two + q1 + four) >> 3
		let s6q0 = (p1 + p0 * two + q0 * two + q1 * two + q2 + four) >> 3
		let s6q1 = (p0 + q0 * two + q1 * two + q2 * three + four) >> 3
		// 8-tap.
		let s8p2 = (p3 * three + p2 * two + p1 + p0 + q0 + four) >> 3
		let s8p1 = (p3 * two + p2 + p1 * two + p0 + q0 + q1 + four) >> 3
		let s8p0 = (p3 + p2 + p1 + p0 * two + q0 + q1 + q2 + four) >> 3
		let s8q0 = (p2 + p1 + p0 + q0 * two + q1 + q2 + q3 + four) >> 3
		let s8q1 = (p1 + p0 + q0 + q1 * two + q2 + q3 * two + four) >> 3
		let s8q2 = (p0 + q0 + q1 + q2 * two + q3 * three + four) >> 3
		// 16-tap (luma).
		let seven = simd.splat8<int32>(int32(7))
		let five = simd.splat8<int32>(int32(5))
		let s16p5 = (p6 * seven + p5 * two + p4 * two + p3 + p2 + p1 + p0 + q0 + eight) >> 4
		let s16p4 = (p6 * five + p5 * two + p4 * two + p3 * two + p2 + p1 + p0 + q0 + q1 + eight) >> 4
		let s16p3 = (p6 * four + p5 + p4 * two + p3 * two + p2 * two + p1 + p0 + q0 + q1 + q2 + eight) >> 4
		let s16p2 = (p6 * three + p5 + p4 + p3 * two + p2 * two + p1 * two + p0 + q0 + q1 + q2 + q3 + eight) >> 4
		let s16p1 = (p6 * two + p5 + p4 + p3 + p2 * two + p1 * two + p0 * two + q0 + q1 + q2 + q3 + q4 + eight) >> 4
		let s16p0 = (p6 + p5 + p4 + p3 + p2 + p1 * two + p0 * two + q0 * two + q1 + q2 + q3 + q4 + q5 + eight) >> 4
		let s16q0 = (p5 + p4 + p3 + p2 + p1 + p0 * two + q0 * two + q1 * two + q2 + q3 + q4 + q5 + q6 + eight) >> 4
		let s16q1 = (p4 + p3 + p2 + p1 + p0 + q0 * two + q1 * two + q2 * two + q3 + q4 + q5 + q6 * two + eight) >> 4
		let s16q2 = (p3 + p2 + p1 + p0 + q0 + q1 * two + q2 * two + q3 * two + q4 + q5 + q6 * three + eight) >> 4
		let s16q3 = (p2 + p1 + p0 + q0 + q1 + q2 * two + q3 * two + q4 * two + q5 + q6 * four + eight) >> 4
		let s16q4 = (p1 + p0 + q0 + q1 + q2 + q3 * two + q4 * two + q5 * two + q6 * five + eight) >> 4
		let s16q5 = (p0 + q0 + q1 + q2 + q3 + q4 * two + q5 * two + q6 * seven + eight) >> 4
		let op0 = c16.blend(s16p0, c8.blend(s8p0, c6.blend(s6p0, cn.blend(np0, p0))))
		let oq0 = c16.blend(s16q0, c8.blend(s8q0, c6.blend(s6q0, cn.blend(nq0, q0))))
		let op1 = c16.blend(s16p1, c8.blend(s8p1, c6.blend(s6p1, cn.blend(np1, p1))))
		let oq1 = c16.blend(s16q1, c8.blend(s8q1, c6.blend(s6q1, cn.blend(nq1, q1))))
		let op2 = c16.blend(s16p2, c8.blend(s8p2, p2))
		let oq2 = c16.blend(s16q2, c8.blend(s8q2, q2))
		let op3 = c16.blend(s16p3, p3)
		let oq3 = c16.blend(s16q3, q3)
		let op4 = c16.blend(s16p4, p4)
		let oq4 = c16.blend(s16q4, q4)
		let op5 = c16.blend(s16p5, p5)
		let oq5 = c16.blend(s16q5, q5)
		if vertical {
			let (a0, a1, a2, a3, a4, a5, a6, a7) = simd.transpose8(tm8, p6, op5, op4, op3, op2, op1, op0)
			simd.store8<uint16>(p, at - 8, simd.convert<int32, uint16>(a0))
			simd.store8<uint16>(p, at + stride - 8, simd.convert<int32, uint16>(a1))
			simd.store8<uint16>(p, at + 2 * stride - 8, simd.convert<int32, uint16>(a2))
			simd.store8<uint16>(p, at + 3 * stride - 8, simd.convert<int32, uint16>(a3))
			simd.store8<uint16>(p, at + 4 * stride - 8, simd.convert<int32, uint16>(a4))
			simd.store8<uint16>(p, at + 5 * stride - 8, simd.convert<int32, uint16>(a5))
			simd.store8<uint16>(p, at + 6 * stride - 8, simd.convert<int32, uint16>(a6))
			simd.store8<uint16>(p, at + 7 * stride - 8, simd.convert<int32, uint16>(a7))
			let (b0, b1, b2, b3, b4, b5, b6, b7) = simd.transpose8(oq0, oq1, oq2, oq3, oq4, oq5, q6, t7)
			simd.store8<uint16>(p, at, simd.convert<int32, uint16>(b0))
			simd.store8<uint16>(p, at + stride, simd.convert<int32, uint16>(b1))
			simd.store8<uint16>(p, at + 2 * stride, simd.convert<int32, uint16>(b2))
			simd.store8<uint16>(p, at + 3 * stride, simd.convert<int32, uint16>(b3))
			simd.store8<uint16>(p, at + 4 * stride, simd.convert<int32, uint16>(b4))
			simd.store8<uint16>(p, at + 5 * stride, simd.convert<int32, uint16>(b5))
			simd.store8<uint16>(p, at + 6 * stride, simd.convert<int32, uint16>(b6))
			simd.store8<uint16>(p, at + 7 * stride, simd.convert<int32, uint16>(b7))
			return
		}
		simd.store8<uint16>(p, at - 6 * stride, simd.convert<int32, uint16>(op5))
		simd.store8<uint16>(p, at - 5 * stride, simd.convert<int32, uint16>(op4))
		simd.store8<uint16>(p, at - 4 * stride, simd.convert<int32, uint16>(op3))
		simd.store8<uint16>(p, at - 3 * stride, simd.convert<int32, uint16>(op2))
		simd.store8<uint16>(p, at - 2 * stride, simd.convert<int32, uint16>(op1))
		simd.store8<uint16>(p, at - stride, simd.convert<int32, uint16>(op0))
		simd.store8<uint16>(p, at, simd.convert<int32, uint16>(oq0))
		simd.store8<uint16>(p, at + stride, simd.convert<int32, uint16>(oq1))
		simd.store8<uint16>(p, at + 2 * stride, simd.convert<int32, uint16>(oq2))
		simd.store8<uint16>(p, at + 3 * stride, simd.convert<int32, uint16>(oq3))
		simd.store8<uint16>(p, at + 4 * stride, simd.convert<int32, uint16>(oq4))
		simd.store8<uint16>(p, at + 5 * stride, simd.convert<int32, uint16>(oq5))
	}

	// Deblocks the decoded frame.
	def av1Deblock(t Av1Tile) {
		let h = t.hdr
		return when h.lfLevelY[0] == 0 && h.lfLevelY[1] == 0
		let lutE = int[]
		let lutI = int[]
		lutE.len(64)
		lutI.len(64)
		let sharp = h.lfSharpness
		for let level = 0; level < 64; level++ {
			let limit = level
			if sharp > 0 {
				limit = limit >> ((sharp + 3) >> 2)
				limit = av1Min(limit, 9 - sharp)
			}
			limit = 1 when limit < 1
			lutI[level] = limit
			lutE[level] = 2 * (level + 2) + limit
		}
		let f = t.cur
		let w4 = (h.width + 3) >> 2
		let h4 = (h.height + 3) >> 2
		av1DeblockPlane(t, f.y, f.stride, w4, h4, t.lfEdgeY, 0, 1, true, lutE, lutI)
		return when t.layout == 0 || (h.lfLevelU == 0 && h.lfLevelV == 0)
		let cw4 = (w4 + t.ssHor) >> t.ssHor
		let ch4 = (h4 + t.ssVer) >> t.ssVer
		av1DeblockPlane(t, f.u, f.cstride, cw4, ch4, t.lfEdgeUv, 2, 2, false, lutE, lutI)
		av1DeblockPlane(t, f.v, f.cstride, cw4, ch4, t.lfEdgeUv, 3, 3, false, lutE, lutI)
	}
}
