internal partial module std.formats.video.av1 {
	use std.simd

	// Motion compensation kernels (dav1d mc_tmpl.c). Pixels are uint16
	// planes; compound intermediates are int arrays with row stride w.

	// Horizontal and vertical filter type of each 2D filter (regular 0,
	// smooth 1, sharp 2).
	const av1F2dH = int[0, 0, 0, 2, 2, 2, 1, 1, 1]
	const av1F2dV = int[0, 1, 2, 0, 1, 2, 0, 1, 2]

	def av1IntermediateBits(bd int) int {
		return bd == 8 ?? (4, 14 - bd)
	}

	def av1PrepBias(bd int) int {
		return bd == 8 ?? (0, 8192)
	}

	// The taps of 8-tap filter `kind` at sub-position `m` (> 0) for a
	// block dimension `n` (the 4-tap variants at 4 and below).
	def av1SubpelAt(kind int, m int, n int) int {
		let k = n > 4 ?? (kind, 3 + (kind & 1))
		return (k * 15 + m - 1) * 8
	}

	def av1Tap8(src uint16[], at int, stride int, f int) int {
		return av1McFilters[f] * int(src[at - 3 * stride]) + av1McFilters[f + 1] * int(src[at - 2 * stride]) + av1McFilters[f + 2] * int(src[at - stride]) + av1McFilters[f + 3] * int(src[at]) + av1McFilters[f + 4] * int(src[at + stride]) + av1McFilters[f + 5] * int(src[at + 2 * stride]) + av1McFilters[f + 6] * int(src[at + 3 * stride]) + av1McFilters[f + 7] * int(src[at + 4 * stride])
	}

	def av1Tap8i(src int32[], at int, stride int, f int) int {
		return av1McFilters[f] * int(src[at - 3 * stride]) + av1McFilters[f + 1] * int(src[at - 2 * stride]) + av1McFilters[f + 2] * int(src[at - stride]) + av1McFilters[f + 3] * int(src[at]) + av1McFilters[f + 4] * int(src[at + stride]) + av1McFilters[f + 5] * int(src[at + 2 * stride]) + av1McFilters[f + 6] * int(src[at + 3 * stride]) + av1McFilters[f + 7] * int(src[at + 4 * stride])
	}

	def av1Rnd(v int, sh int) int {
		return (v + ((1 << sh) >> 1)) >> sh
	}

	def av1ClipPx(v int, maxv int) int {
		return v < 0 ?? (0, v > maxv ?? (maxv, v))
	}

	// put/prep for the unscaled case: 8-tap filters or bilinear
	// (`f2d` == av1Filter2dBilinear). With `prep` the output goes to
	// tmp[tat..] (stride w) with the intermediate precision, else to the
	// pixels dst[dat..].
	def av1McBlock(prep bool, dst uint16[], dat int, dstride int, tmp int32[], tat int, src uint16[], sat int, sstride int, w int, h int, mx int, my int, f2d int, bd int, mid int32[]) {
		let ib = av1IntermediateBits(bd)
		let bias = av1PrepBias(bd)
		let maxv = (1 << bd) - 1
		if f2d == av1Filter2dBilinear {
			if mx != 0 {
				if my != 0 {
					for let y = 0; y < h + 1; y++ {
						let s = sat + y * sstride
						for let x = 0; x < w; x++ {
							let a = int(src[s + x])
							mid[y * 128 + x] = int32(av1Rnd(16 * a + mx * (int(src[s + x + 1]) - a), 4 - ib))
						}
					}
					for let y = 0; y < h; y++ {
						for let x = 0; x < w; x++ {
							let a = int(mid[y * 128 + x])
							let v = 16 * a + my * (int(mid[(y + 1) * 128 + x]) - a)
							if prep {
								tmp[tat + y * w + x] = int32(av1Rnd(v, 4) - bias)
							} else {
								dst[dat + y * dstride + x] = uint16(av1ClipPx(av1Rnd(v, 4 + ib), maxv))
							}
						}
					}
				} else {
					let r = (1 << ib) >> 1
					for let y = 0; y < h; y++ {
						let s = sat + y * sstride
						for let x = 0; x < w; x++ {
							let a = int(src[s + x])
							let px = av1Rnd(16 * a + mx * (int(src[s + x + 1]) - a), 4 - ib)
							if prep {
								tmp[tat + y * w + x] = int32(px - bias)
							} else {
								dst[dat + y * dstride + x] = uint16(av1ClipPx((px + r) >> ib, maxv))
							}
						}
					}
				}
				return
			}
			if my != 0 {
				for let y = 0; y < h; y++ {
					let s = sat + y * sstride
					for let x = 0; x < w; x++ {
						let a = int(src[s + x])
						let v = 16 * a + my * (int(src[s + x + sstride]) - a)
						if prep {
							tmp[tat + y * w + x] = int32(av1Rnd(v, 4 - ib) - bias)
						} else {
							dst[dat + y * dstride + x] = uint16(av1ClipPx(av1Rnd(v, 4), maxv))
						}
					}
				}
				return
			}
			av1McCopy(prep, dst, dat, dstride, tmp, tat, src, sat, sstride, w, h, ib, bias)
			return
		}
		let fh = mx != 0 ?? (av1SubpelAt(av1F2dH[f2d], mx, w), -1)
		let fv = my != 0 ?? (av1SubpelAt(av1F2dV[f2d], my, h), -1)
		if (w & 7) == 0 {
			av1McBlock8(prep, dst, dat, dstride, tmp, tat, src, sat, sstride, w, h, fh, fv, bd, mid)
			return
		}
		if fh >= 0 {
			if fv >= 0 {
				for let y = 0; y < h + 7; y++ {
					let s = sat + (y - 3) * sstride
					for let x = 0; x < w; x++ {
						mid[y * 128 + x] = int32(av1Rnd(av1Tap8(src, s + x, 1, fh), 6 - ib))
					}
				}
				for let y = 0; y < h; y++ {
					let m = (y + 3) * 128
					for let x = 0; x < w; x++ {
						let v = av1Tap8i(mid, m + x, 128, fv)
						if prep {
							tmp[tat + y * w + x] = int32(av1Rnd(v, 6) - bias)
						} else {
							dst[dat + y * dstride + x] = uint16(av1ClipPx(av1Rnd(v, 6 + ib), maxv))
						}
					}
				}
			} else {
				let r = 32 + ((1 << (6 - ib)) >> 1)
				for let y = 0; y < h; y++ {
					let s = sat + y * sstride
					for let x = 0; x < w; x++ {
						let v = av1Tap8(src, s + x, 1, fh)
						if prep {
							tmp[tat + y * w + x] = int32(av1Rnd(v, 6 - ib) - bias)
						} else {
							dst[dat + y * dstride + x] = uint16(av1ClipPx((v + r) >> 6, maxv))
						}
					}
				}
			}
			return
		}
		if fv >= 0 {
			for let y = 0; y < h; y++ {
				let s = sat + y * sstride
				for let x = 0; x < w; x++ {
					let v = av1Tap8(src, s + x, sstride, fv)
					if prep {
						tmp[tat + y * w + x] = int32(av1Rnd(v, 6 - ib) - bias)
					} else {
						dst[dat + y * dstride + x] = uint16(av1ClipPx(av1Rnd(v, 6), maxv))
					}
				}
			}
			return
		}
		av1McCopy(prep, dst, dat, dstride, tmp, tat, src, sat, sstride, w, h, ib, bias)
	}

	// The 8-tap put/prep of av1McBlock for widths that are multiples of
	// 8, eight samples per vector.
	def av1McBlock8(prep bool, dst uint16[], dat int, dstride int, tmp int32[], tat int, src uint16[], sat int, sstride int, w int, h int, fh int, fv int, bd int, mid int32[]) {
		let ib = av1IntermediateBits(bd)
		let bias = simd.splat8<int32>(int32(av1PrepBias(bd)))
		let lo = simd.splat8<int32>(int32(0))
		let hi = simd.splat8<int32>(int32((1 << bd) - 1))
		let hf = fh >= 0 ?? (fh, 0)
		let vf = fv >= 0 ?? (fv, 0)
		let h0 = simd.splat8<int32>(int32(av1McFilters[hf]))
		let h1 = simd.splat8<int32>(int32(av1McFilters[hf + 1]))
		let h2 = simd.splat8<int32>(int32(av1McFilters[hf + 2]))
		let h3 = simd.splat8<int32>(int32(av1McFilters[hf + 3]))
		let h4 = simd.splat8<int32>(int32(av1McFilters[hf + 4]))
		let h5 = simd.splat8<int32>(int32(av1McFilters[hf + 5]))
		let h6 = simd.splat8<int32>(int32(av1McFilters[hf + 6]))
		let h7 = simd.splat8<int32>(int32(av1McFilters[hf + 7]))
		let v0 = simd.splat8<int32>(int32(av1McFilters[vf]))
		let v1 = simd.splat8<int32>(int32(av1McFilters[vf + 1]))
		let v2 = simd.splat8<int32>(int32(av1McFilters[vf + 2]))
		let v3 = simd.splat8<int32>(int32(av1McFilters[vf + 3]))
		let v4 = simd.splat8<int32>(int32(av1McFilters[vf + 4]))
		let v5 = simd.splat8<int32>(int32(av1McFilters[vf + 5]))
		let v6 = simd.splat8<int32>(int32(av1McFilters[vf + 6]))
		let v7 = simd.splat8<int32>(int32(av1McFilters[vf + 7]))
		if fh >= 0 {
			// Horizontal pass: into mid (rows -3 .. h + 4 when vertical
			// follows), or straight to the output.
			let r0 = fv >= 0 ?? (-3, 0)
			let r1 = fv >= 0 ?? (h + 4, h)
			let sh = fv >= 0 || prep ?? (6 - ib, 6)
			let rnd = simd.splat8<int32>(int32(fv >= 0 || prep ?? ((1 << (6 - ib)) >> 1, 32 + ((1 << (6 - ib)) >> 1))))
			for let y = r0; y < r1; y++ {
				let row = sat + y * sstride - 3
				for let x = 0; x < w; x += 8 {
					let q = row + x
					let acc = h0 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q))
					acc += h1 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 1))
					acc += h2 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 2))
					acc += h3 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 3))
					acc += h4 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 4))
					acc += h5 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 5))
					acc += h6 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 6))
					acc += h7 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 7))
					let v = (acc + rnd) >> sh
					if fv >= 0 {
						simd.store8<int32>(mid, (y + 3) * 128 + x, v)
					} else if prep {
						simd.store8<int32>(tmp, tat + y * w + x, v - bias)
					} else {
						simd.store8<uint16>(dst, dat + y * dstride + x, simd.convert<int32, uint16>(simd.clamp(v, lo, hi)))
					}
				}
			}
			return when fv < 0
			let vsh = prep ?? (6, 6 + ib)
			let vrnd = simd.splat8<int32>(int32((1 << vsh) >> 1))
			for let y = 0; y < h; y++ {
				for let x = 0; x < w; x += 8 {
					let q = y * 128 + x
					let acc = v0 * simd.load8<int32>(mid, q)
					acc += v1 * simd.load8<int32>(mid, q + 128)
					acc += v2 * simd.load8<int32>(mid, q + 256)
					acc += v3 * simd.load8<int32>(mid, q + 384)
					acc += v4 * simd.load8<int32>(mid, q + 512)
					acc += v5 * simd.load8<int32>(mid, q + 640)
					acc += v6 * simd.load8<int32>(mid, q + 768)
					acc += v7 * simd.load8<int32>(mid, q + 896)
					let v = (acc + vrnd) >> vsh
					if prep {
						simd.store8<int32>(tmp, tat + y * w + x, v - bias)
					} else {
						simd.store8<uint16>(dst, dat + y * dstride + x, simd.convert<int32, uint16>(simd.clamp(v, lo, hi)))
					}
				}
			}
			return
		}
		if fv >= 0 {
			let sh = prep ?? (6 - ib, 6)
			let rnd = simd.splat8<int32>(int32((1 << sh) >> 1))
			for let y = 0; y < h; y++ {
				let row = sat + (y - 3) * sstride
				for let x = 0; x < w; x += 8 {
					let q = row + x
					let acc = v0 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q))
					acc += v1 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + sstride))
					acc += v2 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 2 * sstride))
					acc += v3 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 3 * sstride))
					acc += v4 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 4 * sstride))
					acc += v5 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 5 * sstride))
					acc += v6 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 6 * sstride))
					acc += v7 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 7 * sstride))
					let v = (acc + rnd) >> sh
					if prep {
						simd.store8<int32>(tmp, tat + y * w + x, v - bias)
					} else {
						simd.store8<uint16>(dst, dat + y * dstride + x, simd.convert<int32, uint16>(simd.clamp(v, lo, hi)))
					}
				}
			}
			return
		}
		for let y = 0; y < h; y++ {
			let row = sat + y * sstride
			for let x = 0; x < w; x += 8 {
				if prep {
					let v = simd.convert<uint16, int32>(simd.load8<uint16>(src, row + x))
					simd.store8<int32>(tmp, tat + y * w + x, (v << ib) - bias)
				} else {
					simd.store8<uint16>(dst, dat + y * dstride + x, simd.load8<uint16>(src, row + x))
				}
			}
		}
	}

	def av1McCopy(prep bool, dst uint16[], dat int, dstride int, tmp int32[], tat int, src uint16[], sat int, sstride int, w int, h int, ib int, bias int) {
		for let y = 0; y < h; y++ {
			let s = sat + y * sstride
			if prep {
				for let x = 0; x < w; x++ {
					tmp[tat + y * w + x] = int32((int(src[s + x]) << ib) - bias)
				}
			} else {
				let d = dat + y * dstride
				for let x = 0; x < w; x++ {
					dst[d + x] = src[s + x]
				}
			}
		}
	}

	// put/prep for scaled references: positions mx, my in 1/1024 with
	// steps dx, dy.
	def av1McScaled(prep bool, dst uint16[], dat int, dstride int, tmp int32[], tat int, src uint16[], sat int, sstride int, w int, h int, mx int, my0 int, dx int, dy int, f2d int, bd int, mid int32[], rows int[]) {
		let ib = av1IntermediateBits(bd)
		let bias = av1PrepBias(bd)
		let maxv = (1 << bd) - 1
		let my = my0
		if f2d == av1Filter2dBilinear {
			let inY = -2
			let s = sat
			for let y = 0; y < h; y++ {
				let sy = my >> 10
				let m1 = (sy & 1) * 128
				let m2 = ((sy + 1) & 1) * 128
				let dmy = (my & 0x3FF) >> 6
				for inY < sy {
					let imx = mx
					let ioff = 0
					let mp = (inY & 1) * 128
					for let x = 0; x < w; x++ {
						let a = int(src[s + ioff])
						mid[mp + x] = int32(av1Rnd(16 * a + (imx >> 6) * (int(src[s + ioff + 1]) - a), 4 - ib))
						imx += dx
						ioff += imx >> 10
						imx = imx & 0x3FF
					}
					s += sstride
					inY++
				}
				for let x = 0; x < w; x++ {
					let a = int(mid[m1 + x])
					let v = 16 * a + dmy * (int(mid[m2 + x]) - a)
					if prep {
						tmp[tat + y * w + x] = int32(av1Rnd(v, 4) - bias)
					} else {
						dst[dat + y * dstride + x] = uint16(av1ClipPx(av1Rnd(v, 4 + ib), maxv))
					}
				}
				my += dy
			}
			return
		}
		for let i = 0; i < 8; i++ {
			rows[i] = i * 128
		}
		let inY = -8
		let s = sat - 3 * sstride
		let th = av1F2dH[f2d]
		let tv = av1F2dV[f2d]
		let rnd = (1 << ib) >> 1
		for let y = 0; y < h; y++ {
			let sy = my >> 10
			let vm = (my & 0x3FF) >> 6
			let fv = vm != 0 ?? (av1SubpelAt(tv, vm, h), -1)
			for inY < sy {
				let imx = mx
				let ioff = 0
				let mp = rows[0]
				for let i = 0; i < 7; i++ {
					rows[i] = rows[i + 1]
				}
				rows[7] = mp
				for let x = 0; x < w; x++ {
					let hm = imx >> 6
					if hm != 0 {
						mid[mp + x] = int32(av1Rnd(av1Tap8(src, s + ioff, 1, av1SubpelAt(th, hm, w)), 6 - ib))
					} else {
						mid[mp + x] = int32(int(src[s + ioff]) << ib)
					}
					imx += dx
					ioff += imx >> 10
					imx = imx & 0x3FF
				}
				s += sstride
				inY++
			}
			for let x = 0; x < w; x++ {
				let v = 0
				if fv >= 0 {
					for let k = 0; k < 8; k++ {
						v += av1McFilters[fv + k] * int(mid[rows[k] + x])
					}
					if prep {
						tmp[tat + y * w + x] = int32(av1Rnd(v, 6) - bias)
					} else {
						dst[dat + y * dstride + x] = uint16(av1ClipPx(av1Rnd(v, 6 + ib), maxv))
					}
				} else if prep {
					tmp[tat + y * w + x] = int32(int(mid[rows[3] + x]) - bias)
				} else {
					dst[dat + y * dstride + x] = uint16(av1ClipPx((int(mid[rows[3] + x]) + rnd) >> ib, maxv))
				}
			}
			my += dy
		}
	}

	def av1Avg(dst uint16[], dat int, stride int, t1 int32[], t2 int32[], w int, h int, bd int) {
		let ib = av1IntermediateBits(bd)
		let sh = ib + 1
		let rnd = (1 << ib) + av1PrepBias(bd) * 2
		let maxv = (1 << bd) - 1
		if (w & 7) == 0 {
			let rv = simd.splat8<int32>(int32(rnd))
			let lo = simd.splat8<int32>(int32(0))
			let hi = simd.splat8<int32>(int32(maxv))
			for let y = 0; y < h; y++ {
				for let x = 0; x < w; x += 8 {
					let i = y * w + x
					let v = (simd.load8<int32>(t1, i) + simd.load8<int32>(t2, i) + rv) >> sh
					simd.store8<uint16>(dst, dat + y * stride + x, simd.convert<int32, uint16>(simd.clamp(v, lo, hi)))
				}
			}
			return
		}
		for let y = 0; y < h; y++ {
			for let x = 0; x < w; x++ {
				let i = y * w + x
				dst[dat + y * stride + x] = uint16(av1ClipPx((int(t1[i]) + int(t2[i]) + rnd) >> sh, maxv))
			}
		}
	}

	def av1WAvg(dst uint16[], dat int, stride int, t1 int32[], t2 int32[], w int, h int, weight int, bd int) {
		let ib = av1IntermediateBits(bd)
		let sh = ib + 4
		let rnd = (8 << ib) + av1PrepBias(bd) * 16
		let maxv = (1 << bd) - 1
		if (w & 7) == 0 {
			let rv = simd.splat8<int32>(int32(rnd))
			let w0 = simd.splat8<int32>(int32(weight))
			let w1 = simd.splat8<int32>(int32(16 - weight))
			let lo = simd.splat8<int32>(int32(0))
			let hi = simd.splat8<int32>(int32(maxv))
			for let y = 0; y < h; y++ {
				for let x = 0; x < w; x += 8 {
					let i = y * w + x
					let v = (simd.load8<int32>(t1, i) * w0 + simd.load8<int32>(t2, i) * w1 + rv) >> sh
					simd.store8<uint16>(dst, dat + y * stride + x, simd.convert<int32, uint16>(simd.clamp(v, lo, hi)))
				}
			}
			return
		}
		for let y = 0; y < h; y++ {
			for let x = 0; x < w; x++ {
				let i = y * w + x
				dst[dat + y * stride + x] = uint16(av1ClipPx((int(t1[i]) * weight + int(t2[i]) * (16 - weight) + rnd) >> sh, maxv))
			}
		}
	}

	def av1MaskBlend(dst uint16[], dat int, stride int, t1 int32[], t2 int32[], w int, h int, mask int[], mat int, bd int) {
		let ib = av1IntermediateBits(bd)
		let sh = ib + 6
		let rnd = (32 << ib) + av1PrepBias(bd) * 64
		let maxv = (1 << bd) - 1
		for let y = 0; y < h; y++ {
			for let x = 0; x < w; x++ {
				let i = y * w + x
				let m = mask[mat + i]
				dst[dat + y * stride + x] = uint16(av1ClipPx((int(t1[i]) * m + int(t2[i]) * (64 - m) + rnd) >> sh, maxv))
			}
		}
	}

	// w_mask: the difference-weighted blend, writing the mask (at chroma
	// resolution for ss) into mask[..].
	def av1WMask(dst uint16[], dat int, stride int, t1 int32[], t2 int32[], w int, h0 int, mask int[], sign int, ssHor int, ssVer int, bd int) {
		let ib = av1IntermediateBits(bd)
		let sh = ib + 6
		let rnd = (32 << ib) + av1PrepBias(bd) * 64
		let maskSh = bd + ib - 4
		let maskRnd = 1 << (maskSh - 5)
		let maxv = (1 << bd) - 1
		let mat = 0
		let h = h0
		let row = 0
		for h > 0 {
			let x = 0
			for x < w {
				let i = row * w + x
				let d = int(t1[i]) - int(t2[i])
				let m = av1Min(38 + ((av1Abs(d) + maskRnd) >> maskSh), 64)
				dst[dat + row * stride + x] = uint16(av1ClipPx((d * m + int(t2[i]) * 64 + rnd) >> sh, maxv))
				if ssHor == 1 {
					x++
					let d2 = int(t1[i + 1]) - int(t2[i + 1])
					let n = av1Min(38 + ((av1Abs(d2) + maskRnd) >> maskSh), 64)
					dst[dat + row * stride + x] = uint16(av1ClipPx((d2 * n + int(t2[i + 1]) * 64 + rnd) >> sh, maxv))
					let mi = mat + (x >> 1)
					if (h & ssVer) != 0 {
						mask[mi] = (m + n + mask[mi] + 2 - sign) >> 2
					} else if ssVer == 1 {
						mask[mi] = m + n
					} else {
						mask[mi] = (m + n + 1 - sign) >> 1
					}
				} else {
					mask[mat + x] = m
				}
				x++
			}
			mat += w >> ssHor when ssVer == 0 || (h & 1) != 0
			row++
			h--
		}
	}

	def av1BlendPx(a int, b int, m int) int {
		return (a * (64 - m) + b * m + 32) >> 6
	}

	def av1Blend(dst uint16[], dat int, stride int, tmp uint16[], w int, h int, mask int[], mat int) {
		for let y = 0; y < h; y++ {
			for let x = 0; x < w; x++ {
				let d = dat + y * stride + x
				dst[d] = uint16(av1BlendPx(int(dst[d]), int(tmp[y * w + x]), mask[mat + y * w + x]))
			}
		}
	}

	def av1BlendV(dst uint16[], dat int, stride int, tmp uint16[], w int, h int) {
		let n = (w * 3) >> 2
		for let y = 0; y < h; y++ {
			for let x = 0; x < n; x++ {
				let d = dat + y * stride + x
				dst[d] = uint16(av1BlendPx(int(dst[d]), int(tmp[y * w + x]), av1ObmcMasks[w + x]))
			}
		}
	}

	def av1BlendH(dst uint16[], dat int, stride int, tmp uint16[], w int, h int) {
		let n = (h * 3) >> 2
		for let y = 0; y < n; y++ {
			let m = av1ObmcMasks[h + y]
			for let x = 0; x < w; x++ {
				let d = dat + y * stride + x
				dst[d] = uint16(av1BlendPx(int(dst[d]), int(tmp[y * w + x]), m))
			}
		}
	}

	// warp_affine_8x8(t): one 8x8 block of an affine warp.
	def av1Warp8x8(prep bool, dst uint16[], dat int, dstride int, tmp int32[], tat int, tstride int, src uint16[], sat int, sstride int, abcd int[], mx0 int, my0 int, bd int, mid int32[]) {
		let ib = av1IntermediateBits(bd)
		let maxv = (1 << bd) - 1
		let mx = mx0
		for let y = 0; y < 15; y++ {
			let s = sat + (y - 3) * sstride
			let tmx = mx
			for let x = 0; x < 8; x++ {
				let f = (64 + ((tmx + 512) >> 10)) * 8
				mid[y * 8 + x] = int32(av1Rnd(av1WarpTap(src, s + x, f), 7 - ib))
				tmx += abcd[0]
			}
			mx += abcd[1]
		}
		let my = my0
		let bias = av1PrepBias(bd)
		for let y = 0; y < 8; y++ {
			let tmy = my
			for let x = 0; x < 8; x++ {
				let f = (64 + ((tmy + 512) >> 10)) * 8
				let m = (y + 3) * 8 + x
				let v = av1WarpFilter[f] * int(mid[m - 24]) + av1WarpFilter[f + 1] * int(mid[m - 16]) + av1WarpFilter[f + 2] * int(mid[m - 8]) + av1WarpFilter[f + 3] * int(mid[m]) + av1WarpFilter[f + 4] * int(mid[m + 8]) + av1WarpFilter[f + 5] * int(mid[m + 16]) + av1WarpFilter[f + 6] * int(mid[m + 24]) + av1WarpFilter[f + 7] * int(mid[m + 32])
				if prep {
					tmp[tat + y * tstride + x] = int32(av1Rnd(v, 7) - bias)
				} else {
					dst[dat + y * dstride + x] = uint16(av1ClipPx(av1Rnd(v, 7 + ib), maxv))
				}
				tmy += abcd[2]
			}
			my += abcd[3]
		}
	}

	def av1WarpTap(src uint16[], at int, f int) int {
		return av1WarpFilter[f] * int(src[at - 3]) + av1WarpFilter[f + 1] * int(src[at - 2]) + av1WarpFilter[f + 2] * int(src[at - 1]) + av1WarpFilter[f + 3] * int(src[at]) + av1WarpFilter[f + 4] * int(src[at + 1]) + av1WarpFilter[f + 5] * int(src[at + 2]) + av1WarpFilter[f + 6] * int(src[at + 3]) + av1WarpFilter[f + 7] * int(src[at + 4])
	}

	// emu_edge: the bw x bh window at (x, y) of a iw x ih plane into
	// dst (stride ds), edges replicated.
	def av1EmuEdge(bw int, bh int, iw int, ih int, x int, y int, dst uint16[], ds int, ref uint16[], rs int) {
		let r = av1ClipI(y, 0, ih - 1) * rs + av1ClipI(x, 0, iw - 1)
		let le = av1ClipI(-x, 0, bw - 1)
		let re = av1ClipI(x + bw - iw, 0, bw - 1)
		let te = av1ClipI(-y, 0, bh - 1)
		let be = av1ClipI(y + bh - ih, 0, bh - 1)
		let cw = bw - le - re
		let ch = bh - te - be
		for let j = 0; j < ch; j++ {
			let b = (te + j) * ds
			for let i = 0; i < cw; i++ {
				dst[b + le + i] = ref[r + i]
			}
			let lv = dst[b + le]
			for let i = 0; i < le; i++ {
				dst[b + i] = lv
			}
			let rv = dst[b + le + cw - 1]
			for let i = 0; i < re; i++ {
				dst[b + le + cw + i] = rv
			}
			r += rs
		}
		for let j = 0; j < te; j++ {
			for let i = 0; i < bw; i++ {
				dst[j * ds + i] = dst[te * ds + i]
			}
		}
		for let j = te + ch; j < bh; j++ {
			for let i = 0; i < bw; i++ {
				dst[j * ds + i] = dst[(j - 1) * ds + i]
			}
		}
	}

	// The wedge and inter-intra masks (dav1d wedge.c), built once per
	// decoder.
	type Av1Masks {
		data  int[]
		// wedge[c][bs - 32x32][sign][idx] and ii[c][bs - 32x32][mode]
		// offsets into data.
		wedge int[]
		ii    int[]

		def new() {
			wedge.len(3 * 11 * 2 * 16)
			ii.len(3 * 11 * 4)
			let master = int[]
			master.len(6 * 4096)
			let oddLine = int[1, 2, 6, 18, 37, 53, 60, 63]
			let evenLine = int[1, 4, 11, 27, 46, 58, 62, 63]
			let vertLine = int[0, 2, 7, 21, 43, 57, 62, 64]
			for let y = 0; y < 64; y++ {
				insertBorder(master, 1 * 4096 + y * 64, vertLine, 32)
			}
			let ctr = 48
			for let y = 0; y < 64; y += 2 {
				insertBorder(master, 3 * 4096 + y * 64, evenLine, ctr)
				insertBorder(master, 3 * 4096 + y * 64 + 64, oddLine, ctr - 1)
				ctr--
			}
			for let y = 0; y < 64; y++ {
				for let x = 0; x < 64; x++ {
					master[2 * 4096 + x * 64 + y] = master[3 * 4096 + y * 64 + x]
					master[0 * 4096 + x * 64 + y] = master[1 * 4096 + y * 64 + x]
				}
			}
			for let y = 0; y < 64; y++ {
				for let x = 0; x < 64; x++ {
					master[4 * 4096 + y * 64 + 63 - x] = master[3 * 4096 + y * 64 + x]
					master[5 * 4096 + y * 64 + 63 - x] = master[2 * 4096 + y * 64 + x]
				}
			}
			data = int[]
			// Codebooks: direction, x offset, y offset per entry.
			let hgtw = int[2, 4, 4, 3, 4, 4, 4, 4, 4, 5, 4, 4, 0, 4, 2, 0, 4, 4, 0, 4, 6, 1, 4, 4, 2, 4, 2, 2, 4, 6, 5, 4, 2, 5, 4, 6, 3, 2, 4, 3, 6, 4, 4, 2, 4, 4, 6, 4]
			let hltw = int[2, 4, 4, 3, 4, 4, 4, 4, 4, 5, 4, 4, 1, 2, 4, 1, 4, 4, 1, 6, 4, 0, 4, 4, 2, 4, 2, 2, 4, 6, 5, 4, 2, 5, 4, 6, 3, 2, 4, 3, 6, 4, 4, 2, 4, 4, 6, 4]
			let heqw = int[2, 4, 4, 3, 4, 4, 4, 4, 4, 5, 4, 4, 0, 4, 2, 0, 4, 6, 1, 2, 4, 1, 6, 4, 2, 4, 2, 2, 4, 6, 5, 4, 2, 5, 4, 6, 3, 2, 4, 3, 6, 4, 4, 2, 4, 4, 6, 4]
			fill(32, 32, 0, master, heqw, 0x7BFB)
			fill(32, 16, 1, master, hltw, 0x7BEB)
			fill(32, 8, 2, master, hltw, 0x6BEB)
			fill(16, 32, 4, master, hgtw, 0x7BEB)
			fill(16, 16, 5, master, heqw, 0x7BFB)
			fill(16, 8, 6, master, hltw, 0x7BEB)
			fill(8, 32, 8, master, hgtw, 0x7AEB)
			fill(8, 16, 9, master, hgtw, 0x7BEB)
			fill(8, 8, 10, master, heqw, 0x7BFB)
			// Inter-intra: DC, then vertical, horizontal, smooth per size.
			let dc = data.len()
			for let i = 0; i < 1024; i++ {
				data.push(32)
			}
			let n3232 = nondc(32, 32, 1)
			let n1632 = nondc(16, 32, 1)
			let n1616 = nondc(16, 16, 2)
			let n832 = nondc(8, 32, 1)
			let n816 = nondc(8, 16, 2)
			let n88 = nondc(8, 8, 4)
			let n416 = nondc(4, 16, 2)
			let n48 = nondc(4, 8, 4)
			let n44 = nondc(4, 4, 8)
			let bss = int[0, 1, 4, 5, 6, 9, 10]
			for let c = 0; c < 3; c++ {
				for let i = 0; i < 7; i++ {
					ii[(c * 11 + bss[i]) * 4] = dc
				}
			}
			for let p = 0; p < 3; p++ {
				assign(0, n3232, 32 * 32, n1632, 16 * 32, n1616, 16 * 16, p)
				assign(1, n3232, 32 * 32, n1616, 16 * 16, n1616, 16 * 16, p)
				assign(4, n1632, 16 * 32, n832, 8 * 32, n816, 8 * 16, p)
				assign(5, n1616, 16 * 16, n816, 8 * 16, n88, 8 * 8, p)
				assign(6, n1616, 16 * 16, n88, 8 * 8, n88, 8 * 8, p)
				assign(9, n816, 8 * 16, n416, 4 * 16, n48, 4 * 8, p)
				assign(10, n88, 8 * 8, n48, 4 * 8, n44, 4 * 4, p)
			}
		}

		def assign(b int, a444 int, s444 int, a422 int, s422 int, a420 int, s420 int, p int) {
			ii[(0 * 11 + b) * 4 + p + 1] = a444 + p * s444
			ii[(1 * 11 + b) * 4 + p + 1] = a422 + p * s422
			ii[(2 * 11 + b) * 4 + p + 1] = a420 + p * s420
		}

		def insertBorder(dst int[], at int, src int[], ctr int) {
			for let i = 0; i < ctr - 4; i++ {
				dst[at + i] = 0
			}
			let d = (ctr > 4 ?? (ctr, 4)) - 4
			let s = 4 - ctr > 0 ?? (4 - ctr, 0)
			let n = 64 - ctr < 8 ?? (64 - ctr, 8)
			for let i = 0; i < n; i++ {
				dst[at + d + i] = src[s + i]
			}
			for let i = ctr + 4; i < 64; i++ {
				dst[at + i] = 64
			}
		}

		def nondc(w int, h int, step int) int {
			let weights = int[60, 52, 45, 39, 34, 30, 26, 22, 19, 17, 15, 13, 11, 10, 8, 7, 6, 6, 5, 4, 4, 3, 3, 2, 2, 2, 2, 1, 1, 1, 1, 1]
			let base = data.len()
			data.len(base + 3 * w * h)
			for let y = 0; y < h; y++ {
				for let x = 0; x < w; x++ {
					let o = base + y * w + x
					data[o] = weights[y * step]
					data[o + w * h] = weights[x * step]
					data[o + 2 * w * h] = weights[(x < y ?? (x, y)) * step]
				}
			}
			return base
		}

		def chroma(luma int, sign int, w int, h int, ssVer int) int {
			let base = data.len()
			data.len(base + ((w >> 1) * (h >> ssVer)))
			let l = luma
			let c = base
			for let y = 0; y < h; y += 1 + ssVer {
				for let x = 0; x < w; x += 2 {
					let sum = data[l + x] + data[l + x + 1] + 1
					sum += data[l + w + x] + data[l + w + x + 1] + 1 when ssVer == 1
					data[c + (x >> 1)] = (sum - sign) >> (1 + ssVer)
				}
				l += w << ssVer
				c += w >> 1
			}
			return base
		}

		def fill(w int, h int, b int, master int[], cb int[], signs0 int) {
			let signs = signs0
			for let n = 0; n < 16; n++ {
				let sign = signs & 1
				let dir = cb[n * 3]
				let xo = 32 - ((w * cb[n * 3 + 1]) >> 3)
				let yo = 32 - ((h * cb[n * 3 + 2]) >> 3)
				let m = data.len()
				data.len(m + w * h)
				for let y = 0; y < h; y++ {
					for let x = 0; x < w; x++ {
						let v = master[dir * 4096 + (yo + y) * 64 + xo + x]
						data[m + y * w + x] = sign == 1 ?? (64 - v, v)
					}
				}
				wedge[((0 * 11 + b) * 2 + 0) * 16 + n] = m
				wedge[((0 * 11 + b) * 2 + 1) * 16 + n] = m
				// Subsampled masks, rounded by the compound mask sign.
				wedge[((1 * 11 + b) * 2) * 16 + n] = chroma(m, 0, w, h, 0)
				wedge[((1 * 11 + b) * 2 + 1) * 16 + n] = chroma(m, 1, w, h, 0)
				wedge[((2 * 11 + b) * 2) * 16 + n] = chroma(m, 0, w, h, 1)
				wedge[((2 * 11 + b) * 2 + 1) * 16 + n] = chroma(m, 1, w, h, 1)
				signs = signs >> 1
			}
		}
	}
}
