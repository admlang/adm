internal partial module std.formats.video.av1 {
	// OBU types (6.2.2).
	const (
		av1ObuSeqHdr            = 1
		av1ObuTd                = 2
		av1ObuFrameHdr          = 3
		av1ObuTileGrp           = 4
		av1ObuMetadata          = 5
		av1ObuFrame             = 6
		av1ObuRedundantFrameHdr = 7
		av1ObuTileList          = 8
		av1ObuPadding           = 15
	)

	// Frame types.
	const (
		av1FrameKey    = 0
		av1FrameInter  = 1
		av1FrameIntra  = 2
		av1FrameSwitch = 3
	)

	// Global and local warp types.
	const (
		av1WmIdentity    = 0
		av1WmTranslation = 1
		av1WmRotZoom     = 2
		av1WmAffine      = 3
	)

	const av1PrimaryRefNone = 7
	const av1FilterSwitchable = 4
	const av1TxLargest = 1
	const av1TxSwitchable = 2

	// A big-endian bit reader over OBU payload bytes.
	type Av1Bits {
		data  byte[]
		pos   int
		end   int
		error bool

		def new() {
			data = byte[]
		}

		def reset(src byte[], start int, stop int) {
			data = src
			pos = start * 8
			end = stop
			error = false
		}

		def bit() int {
			let byteAt = pos >> 3
			if byteAt >= end {
				error = true
				pos++
				return 0
			}
			let v = (int(data[byteAt]) >> (7 - (pos & 7))) & 1
			pos++
			return v
		}

		def flag() bool {
			return bit() == 1
		}

		// n bits (n <= 32), MSB first.
		def bits(n int) int {
			let v = 0
			for let i = 0; i < n; i++ {
				v = (v << 1) | bit()
			}
			return v
		}

		// su(n): a signed n-bit value.
		def sbits(n int) int {
			let v = bits(n)
			return v >= (1 << (n - 1)) ?? (v - (1 << n), v)
		}

		// leb128().
		def uleb128() int {
			let v = 0
			for let i = 0; i < 8; i++ {
				let b = bits(8)
				v = v | ((b & 0x7F) << (i * 7))
				return v when (b & 0x80) == 0
			}
			error = true
			return 0
		}

		// ns(max): a value in 0 ..< max.
		def uniform(max int) int {
			let l = av1Log2(max) + 1
			let m = (1 << l) - max
			let v = bits(l - 1)
			return v < m ?? (v, (v << 1) - m + bit())
		}

		// uvlc().
		def vlc() int {
			let n = 0
			for bit() == 0 {
				n++
				if n == 32 {
					error = true
					return 0
				}
			}
			return n == 0 ?? (0, ((1 << n) - 1) + bits(n))
		}

		// Global motion parameter decoding (5.9.25 decode_signed_subexp_with_ref).
		def subexp(ref int, n int) int {
			let r = ref + (1 << n)
			let mx = 2 << n
			let v = 0
			for let i = 0;; i++ {
				let b = i > 0 ?? (3 + i - 1, 3)
				if mx < v + 3 * (1 << b) {
					v += uniform(mx - v + 1)
					break
				}
				if !flag() {
					v += bits(b)
					break
				}
				v += 1 << b
			}
			let u = r * 2 <= mx ?? (av1InvRecenter(r, v), mx - av1InvRecenter(mx - r, v))
			return u - (1 << n)
		}

		def byteAlign() {
			pos = (pos + 7) & ~7
		}

		def bytePos() int {
			return pos >> 3
		}
	}

	// floor(log2(v)) for v >= 1.
	def av1Log2(v int) int {
		let n = 0
		for (v >> (n + 1)) != 0 {
			n++
		}
		return n
	}

	def av1InvRecenter(r int, v int) int {
		return v when v > 2 * r
		return r + (v >> 1) when (v & 1) == 0
		return r - ((v + 1) >> 1)
	}

	// A sequence header (5.5).
	type Av1SeqHdr {
		profile                  int
		stillPicture             bool
		reducedStill             bool
		timingInfo               bool
		numUnitsInTick           int
		timeScale                int
		equalPictureInterval     bool
		decoderModelInfo         bool
		bufferDelayLength        int
		bufferRemovalDelayLength int
		presentationDelayLength  int
		numOperatingPoints       int
		opIdc                    int[]
		opModelParams            bool[]
		widthBits                int
		heightBits               int
		maxWidth                 int
		maxHeight                int
		frameIdNumbers           bool
		deltaFrameIdBits         int
		frameIdBits              int
		sb128                    bool
		filterIntra              bool
		intraEdgeFilter          bool
		interIntra               bool
		maskedCompound           bool
		warpedMotion             bool
		dualFilter               bool
		orderHint                bool
		jntComp                  bool
		refFrameMvs              bool
		// 0, 1 or 2 (chosen per frame).
		screenContentTools       int
		forceIntegerMv           int
		orderHintBits            int
		superRes                 bool
		cdef                     bool
		restoration              bool
		bitDepth                 int
		monochrome               bool
		colorDescription         bool
		primaries                int
		transfer                 int
		matrix                   int
		fullRange                bool
		ssHor                    int
		ssVer                    int
		separateUvDeltaQ         bool
		filmGrain                bool

		def new() {
			opIdc = int[]
			opModelParams = bool[]
		}
	}

	// Parses a sequence header OBU payload.
	//
	// Fails on invalid values.
	def av1ParseSeqHdr(b Av1Bits) !Av1SeqHdr {
		let s = new Av1SeqHdr()
		s.profile = b.bits(3)
		fail "av1: bad profile" when s.profile > 2
		s.stillPicture = b.flag()
		s.reducedStill = b.flag()
		fail "av1: bad still picture flags" when s.reducedStill && !s.stillPicture
		if s.reducedStill {
			s.numOperatingPoints = 1
			s.opIdc.push(0)
			s.opModelParams.push(false)
			b.bits(5)
		} else {
			s.timingInfo = b.flag()
			if s.timingInfo {
				s.numUnitsInTick = b.bits(32)
				s.timeScale = b.bits(32)
				s.equalPictureInterval = b.flag()
				b.vlc() when s.equalPictureInterval
				s.decoderModelInfo = b.flag()
				if s.decoderModelInfo {
					s.bufferDelayLength = b.bits(5) + 1
					b.bits(32)
					s.bufferRemovalDelayLength = b.bits(5) + 1
					s.presentationDelayLength = b.bits(5) + 1
				}
			}
			let displayModel = b.flag()
			s.numOperatingPoints = b.bits(5) + 1
			for let i = 0; i < s.numOperatingPoints; i++ {
				s.opIdc.push(b.bits(12))
				let major = 2 + b.bits(3)
				b.bits(2)
				b.bits(1) when major > 3
				let present = false
				if s.decoderModelInfo {
					present = b.flag()
					if present {
						b.bits(s.bufferDelayLength)
						b.bits(s.bufferDelayLength)
						b.bits(1)
					}
				}
				s.opModelParams.push(present)
				b.bits(4) when displayModel && b.flag()
			}
		}
		s.widthBits = b.bits(4) + 1
		s.heightBits = b.bits(4) + 1
		s.maxWidth = b.bits(s.widthBits) + 1
		s.maxHeight = b.bits(s.heightBits) + 1
		if !s.reducedStill {
			s.frameIdNumbers = b.flag()
			if s.frameIdNumbers {
				s.deltaFrameIdBits = b.bits(4) + 2
				s.frameIdBits = b.bits(3) + s.deltaFrameIdBits + 1
			}
		}
		s.sb128 = b.flag()
		s.filterIntra = b.flag()
		s.intraEdgeFilter = b.flag()
		if s.reducedStill {
			s.screenContentTools = 2
			s.forceIntegerMv = 2
		} else {
			s.interIntra = b.flag()
			s.maskedCompound = b.flag()
			s.warpedMotion = b.flag()
			s.dualFilter = b.flag()
			s.orderHint = b.flag()
			if s.orderHint {
				s.jntComp = b.flag()
				s.refFrameMvs = b.flag()
			}
			s.screenContentTools = b.flag() ?? (2, b.bit())
			if s.screenContentTools != 0 {
				s.forceIntegerMv = b.flag() ?? (2, b.bit())
			} else {
				s.forceIntegerMv = 2
			}
			s.orderHintBits = b.bits(3) + 1 when s.orderHint
		}
		s.superRes = b.flag()
		s.cdef = b.flag()
		s.restoration = b.flag()
		let hbd = b.bit()
		hbd += b.bit() when s.profile == 2 && hbd == 1
		s.bitDepth = hbd == 2 ?? (12, hbd == 1 ?? (10, 8))
		s.monochrome = s.profile != 1 && b.flag()
		s.colorDescription = b.flag()
		s.primaries = 2
		s.transfer = 2
		s.matrix = 2
		if s.colorDescription {
			s.primaries = b.bits(8)
			s.transfer = b.bits(8)
			s.matrix = b.bits(8)
		}
		if s.monochrome {
			s.fullRange = b.flag()
			s.ssHor = 1
			s.ssVer = 1
		} else if s.primaries == 1 && s.transfer == 13 && s.matrix == 0 {
			s.fullRange = true
			fail "av1: sRGB outside 4:4:4 profiles" when s.profile != 1 && !(s.profile == 2 && hbd == 2)
		} else {
			s.fullRange = b.flag()
			if s.profile == 0 {
				s.ssHor = 1
				s.ssVer = 1
			} else if s.profile == 2 {
				if hbd == 2 {
					s.ssHor = b.bit()
					s.ssVer = b.bit() when s.ssHor == 1
				} else {
					s.ssHor = 1
				}
			}
			b.bits(2) when s.ssHor == 1 && s.ssVer == 1
		}
		s.separateUvDeltaQ = !s.monochrome && b.flag()
		s.filmGrain = b.flag()
		fail "av1: truncated sequence header" when b.error
		return s
	}

	// Film grain parameters (5.9.30).
	type Av1FilmGrain {
		present         bool
		seed            int
		numYPoints      int
		yPoints         int[]
		chromaFromLuma  bool
		numUvPoints     int[]
		uvPoints        int[]
		scalingShift    int
		arLag           int
		arCoeffsY       int[]
		arCoeffsUv      int[]
		arShift         int
		grainScaleShift int
		uvMult          int[]
		uvLumaMult      int[]
		uvOffset        int[]
		overlap         bool
		clipRestricted  bool

		def new() {
			yPoints.len(28)
			numUvPoints.len(2)
			uvPoints.len(2 * 20)
			arCoeffsY.len(24)
			arCoeffsUv.len(2 * 28)
			uvMult.len(2)
			uvLumaMult.len(2)
			uvOffset.len(2)
		}

		def copy() Av1FilmGrain {
			let g = new Av1FilmGrain()
			g.present = present
			g.seed = seed
			g.numYPoints = numYPoints
			yPoints.copy(g.yPoints)
			g.chromaFromLuma = chromaFromLuma
			numUvPoints.copy(g.numUvPoints)
			uvPoints.copy(g.uvPoints)
			g.scalingShift = scalingShift
			g.arLag = arLag
			arCoeffsY.copy(g.arCoeffsY)
			arCoeffsUv.copy(g.arCoeffsUv)
			g.arShift = arShift
			g.grainScaleShift = grainScaleShift
			uvMult.copy(g.uvMult)
			uvLumaMult.copy(g.uvLumaMult)
			uvOffset.copy(g.uvOffset)
			g.overlap = overlap
			g.clipRestricted = clipRestricted
			return g
		}
	}

	// A frame header (5.9) and what follows from it.
	type Av1FrameHdr {
		showExisting         bool
		existingIdx          int
		frameType            int
		showFrame            bool
		showableFrame        bool
		errorResilient       bool
		disableCdfUpdate     bool
		allowScreenContent   bool
		forceIntegerMv       bool
		frameId              int
		frameSizeOverride    bool
		frameOffset          int
		primaryRefFrame      int
		refreshFlags         int
		// Coded width (after superres downscaling), upscaled width, height.
		width                int
		upscaledWidth        int
		height               int
		renderWidth          int
		renderHeight         int
		superRes             bool
		superResDenom        int
		allowIntrabc         bool
		refIdx               int[]
		hp                   bool
		subpelFilter         int
		switchableMotionMode bool
		useRefFrameMvs       bool
		refreshContext       bool
		// Tiling.
		tileCols             int
		tileRows             int
		log2Cols             int
		log2Rows             int
		colStart             int[]
		rowStart             int[]
		contextTile          int
		tileSizeBytes        int
		// Quantizer.
		yac                  int
		ydcDelta             int
		udcDelta             int
		uacDelta             int
		vdcDelta             int
		vacDelta             int
		qm                   bool
		qmY                  int
		qmU                  int
		qmV                  int
		// Segmentation: per segment q/lf deltas, ref, skip, globalmv.
		segEnabled           bool
		segUpdateMap         bool
		segTemporal          bool
		segUpdateData        bool
		segDeltaQ            int[]
		segDeltaLf           int[]
		segRef               int[]
		segSkip              bool[]
		segGlobalMv          bool[]
		segLastActive        int
		segPreskip           bool
		segQidx              int[]
		segLossless          bool[]
		allLossless          bool
		deltaQ               bool
		deltaQRes            int
		deltaLf              bool
		deltaLfRes           int
		deltaLfMulti         bool
		// Loop filter.
		lfLevelY             int[]
		lfLevelU             int
		lfLevelV             int
		lfSharpness          int
		lfDeltaEnabled       bool
		lfDeltaUpdate        bool
		lfRefDelta           int[]
		lfModeDelta          int[]
		// CDEF.
		cdefDamping          int
		cdefBits             int
		cdefY                int[]
		cdefUv               int[]
		// Loop restoration: type per plane, log2 unit size luma/chroma.
		lrType               int[]
		lrUnit               int[]
		txMode               int
		switchableCompRefs   bool
		skipModeAllowed      bool
		skipModeEnabled      bool
		skipModeRefs         int[]
		warpMotion           bool
		reducedTxtpSet       bool
		// Global motion: type per reference 1..7 and six parameters.
		gmvType              int[]
		gmv                  int[]
		filmGrain            Av1FilmGrain
		temporalId           int
		spatialId            int
		// False for the stand-in of an empty reference slot.
		valid                bool

		def new() {
			refIdx = int[-1, -1, -1, -1, -1, -1, -1]
			colStart.len(65)
			rowStart.len(65)
			segDeltaQ.len(8)
			segDeltaLf.len(8 * 4)
			segRef = int[-1, -1, -1, -1, -1, -1, -1, -1]
			segSkip.len(8)
			segGlobalMv.len(8)
			segQidx.len(8)
			segLossless.len(8)
			lfLevelY.len(2)
			lfRefDelta = int[1, 0, 0, 0, -1, 0, -1, -1]
			lfModeDelta = int[0, 0]
			cdefY.len(8)
			cdefUv.len(8)
			lrType.len(3)
			lrUnit = int[8, 8]
			skipModeRefs.len(2)
			gmvType.len(7)
			gmv.len(7 * 6)
			for let i = 0; i < 7; i++ {
				av1DefaultWarp(gmv, i * 6)
			}
			filmGrain = new Av1FilmGrain()
			superResDenom = 8
			primaryRefFrame = av1PrimaryRefNone
		}

		def isIntra() bool {
			return frameType == av1FrameKey || frameType == av1FrameIntra
		}
	}

	// The identity warp parameters at `m[at:]`.
	def av1DefaultWarp(m int[], at int) {
		m[at] = 0
		m[at + 1] = 0
		m[at + 2] = 1 << 16
		m[at + 3] = 0
		m[at + 4] = 0
		m[at + 5] = 1 << 16
	}

	// The signed distance between two order hints (7.12.3 get_relative_dist).
	def av1PocDiff(bits int, a int, b int) int {
		return 0 when bits == 0
		let m = 1 << (bits - 1)
		let d = a - b
		return (d & (m - 1)) - (d & m)
	}

	// frame_size() and superres_params() (5.9.5-5.9.8): `refs` holds the
	// headers of the reference slots (none where empty).
	//
	// Fails on a reference slot that is empty.
	def av1FrameSize(b Av1Bits, s Av1SeqHdr, h Av1FrameHdr, refs Av1FrameHdr[], useRef bool) !none {
		if useRef {
			for let i = 0; i < 7; i++ {
				if b.flag() {
					let ref = refs[h.refIdx[i]]
					fail "av1: frame size from an empty reference" when !ref.valid
					h.upscaledWidth = ref.upscaledWidth
					h.height = ref.height
					h.renderWidth = ref.renderWidth
					h.renderHeight = ref.renderHeight
					av1SuperRes(b, s, h)
					return none
				}
			}
		}
		if h.frameSizeOverride {
			h.upscaledWidth = b.bits(s.widthBits) + 1
			h.height = b.bits(s.heightBits) + 1
		} else {
			h.upscaledWidth = s.maxWidth
			h.height = s.maxHeight
		}
		av1SuperRes(b, s, h)
		if b.flag() {
			h.renderWidth = b.bits(16) + 1
			h.renderHeight = b.bits(16) + 1
		} else {
			h.renderWidth = h.upscaledWidth
			h.renderHeight = h.height
		}
		return none
	}

	def av1SuperRes(b Av1Bits, s Av1SeqHdr, h Av1FrameHdr) {
		h.superRes = s.superRes && b.flag()
		if h.superRes {
			let d = 9 + b.bits(3)
			h.superResDenom = d
			let w = (h.upscaledWidth * 8 + (d >> 1)) / d
			let minW = h.upscaledWidth < 16 ?? (h.upscaledWidth, 16)
			h.width = w > minW ?? (w, minW)
		} else {
			h.superResDenom = 8
			h.width = h.upscaledWidth
		}
	}

	def av1TileLog2(size int, target int) int {
		let k = 0
		for (size << k) < target {
			k++
		}
		return k
	}

	// Parses an uncompressed frame header (5.9.2). `refs` holds the
	// headers of the eight reference slots, none where empty.
	//
	// Fails on invalid values or references that are missing.
	def av1ParseFrameHdr(b Av1Bits, s Av1SeqHdr, refs Av1FrameHdr[], temporalId int, spatialId int) !Av1FrameHdr {
		let h = new Av1FrameHdr()
		h.valid = true
		h.temporalId = temporalId
		h.spatialId = spatialId
		h.showExisting = !s.reducedStill && b.flag()
		if h.showExisting {
			h.existingIdx = b.bits(3)
			b.bits(s.presentationDelayLength) when s.decoderModelInfo && !s.equalPictureInterval
			b.bits(s.frameIdBits) when s.frameIdNumbers
			return h
		}
		if s.reducedStill {
			h.frameType = av1FrameKey
			h.showFrame = true
		} else {
			h.frameType = b.bits(2)
			h.showFrame = b.flag()
		}
		if h.showFrame {
			b.bits(s.presentationDelayLength) when s.decoderModelInfo && !s.equalPictureInterval
			h.showableFrame = h.frameType != av1FrameKey
		} else {
			h.showableFrame = b.flag()
		}
		h.errorResilient = (h.frameType == av1FrameKey && h.showFrame) || h.frameType == av1FrameSwitch || s.reducedStill || b.flag()
		h.disableCdfUpdate = b.flag()
		h.allowScreenContent = s.screenContentTools == 2 ?? (b.flag(), s.screenContentTools == 1)
		h.forceIntegerMv = s.forceIntegerMv == 2 ?? (b.flag(), s.forceIntegerMv == 1) when h.allowScreenContent
		h.forceIntegerMv = true when h.isIntra()
		h.frameId = b.bits(s.frameIdBits) when s.frameIdNumbers
		h.frameSizeOverride = h.frameType == av1FrameSwitch || b.flag() unless s.reducedStill
		h.frameOffset = b.bits(s.orderHintBits) when s.orderHint
		h.primaryRefFrame = b.bits(3) when !h.errorResilient && !h.isIntra()
		if s.decoderModelInfo && b.flag() {
			for let i = 0; i < s.numOperatingPoints; i++ {
				if s.opModelParams[i] {
					let idc = s.opIdc[i]
					let inTemporal = ((idc >> temporalId) & 1) != 0
					let inSpatial = ((idc >> (spatialId + 8)) & 1) != 0
					b.bits(s.bufferRemovalDelayLength) when idc == 0 || (inTemporal && inSpatial)
				}
			}
		}
		if h.isIntra() {
			h.refreshFlags = (h.frameType == av1FrameKey && h.showFrame) ?? (0xFF, b.bits(8))
			if h.refreshFlags != 0xFF && h.errorResilient && s.orderHint {
				for let i = 0; i < 8; i++ {
					b.bits(s.orderHintBits)
				}
			}
			try av1FrameSize(b, s, h, refs, false)
			h.allowIntrabc = h.allowScreenContent && !h.superRes && b.flag()
		} else {
			h.refreshFlags = h.frameType == av1FrameSwitch ?? (0xFF, b.bits(8))
			if h.errorResilient && s.orderHint {
				for let i = 0; i < 8; i++ {
					b.bits(s.orderHintBits)
				}
			}
			let shortSignaling = s.orderHint && b.flag()
			if shortSignaling {
				try av1ShortRefs(b, s, h, refs)
			}
			for let i = 0; i < 7; i++ {
				h.refIdx[i] = b.bits(3) unless shortSignaling
				fail "av1: missing reference frame" unless refs[h.refIdx[i]].valid
				b.bits(s.deltaFrameIdBits) when s.frameIdNumbers
			}
			try av1FrameSize(b, s, h, refs, !h.errorResilient && h.frameSizeOverride)
			h.hp = !h.forceIntegerMv && b.flag()
			h.subpelFilter = b.flag() ?? (av1FilterSwitchable, b.bits(2))
			h.switchableMotionMode = b.flag()
			h.useRefFrameMvs = b.flag() when !h.errorResilient && s.refFrameMvs && s.orderHint
		}
		h.refreshContext = !s.reducedStill && !h.disableCdfUpdate && !b.flag()
		av1ParseTiling(b, s, h)
		fail "av1: bad context_update_tile_id" when h.contextTile >= h.tileCols * h.tileRows
		// Quantizer (5.9.12).
		h.yac = b.bits(8)
		h.ydcDelta = b.sbits(7) when b.flag()
		if !s.monochrome {
			let diffUv = s.separateUvDeltaQ && b.flag()
			h.udcDelta = b.sbits(7) when b.flag()
			h.uacDelta = b.sbits(7) when b.flag()
			if diffUv {
				h.vdcDelta = b.sbits(7) when b.flag()
				h.vacDelta = b.sbits(7) when b.flag()
			} else {
				h.vdcDelta = h.udcDelta
				h.vacDelta = h.uacDelta
			}
		}
		h.qm = b.flag()
		if h.qm {
			h.qmY = b.bits(4)
			h.qmU = b.bits(4)
			h.qmV = s.separateUvDeltaQ ?? (b.bits(4), h.qmU)
		}
		// Segmentation (5.9.14).
		h.segEnabled = b.flag()
		if h.segEnabled {
			if h.primaryRefFrame == av1PrimaryRefNone {
				h.segUpdateMap = true
				h.segUpdateData = true
			} else {
				h.segUpdateMap = b.flag()
				h.segTemporal = h.segUpdateMap && b.flag()
				h.segUpdateData = b.flag()
			}
			if h.segUpdateData {
				h.segLastActive = -1
				for let i = 0; i < 8; i++ {
					if b.flag() {
						h.segDeltaQ[i] = b.sbits(9)
						h.segLastActive = i
					}
					for let k = 0; k < 4; k++ {
						if b.flag() {
							h.segDeltaLf[i * 4 + k] = b.sbits(7)
							h.segLastActive = i
						}
					}
					if b.flag() {
						h.segRef[i] = b.bits(3)
						h.segLastActive = i
						h.segPreskip = true
					}
					if b.flag() {
						h.segSkip[i] = true
						h.segLastActive = i
						h.segPreskip = true
					}
					if b.flag() {
						h.segGlobalMv[i] = true
						h.segLastActive = i
						h.segPreskip = true
					}
				}
			} else {
				let r = refs[h.refIdx[h.primaryRefFrame]]
				fail "av1: segmentation from an empty reference" when !r.valid
				r.segDeltaQ.copy(h.segDeltaQ)
				r.segDeltaLf.copy(h.segDeltaLf)
				r.segRef.copy(h.segRef)
				r.segSkip.copy(h.segSkip)
				r.segGlobalMv.copy(h.segGlobalMv)
				h.segLastActive = r.segLastActive
				h.segPreskip = r.segPreskip
			}
		}
		// Delta q and lf (5.9.17, 5.9.18).
		if h.yac != 0 {
			h.deltaQ = b.flag()
			if h.deltaQ {
				h.deltaQRes = b.bits(2)
				if !h.allowIntrabc {
					h.deltaLf = b.flag()
					if h.deltaLf {
						h.deltaLfRes = b.bits(2)
						h.deltaLfMulti = b.flag()
					}
				}
			}
		}
		let deltaLossless = h.ydcDelta == 0 && h.udcDelta == 0 && h.uacDelta == 0 && h.vdcDelta == 0 && h.vacDelta == 0
		h.allLossless = true
		for let i = 0; i < 8; i++ {
			let q = h.yac
			if h.segEnabled {
				q = h.yac + h.segDeltaQ[i]
				q = q < 0 ?? (0, q > 255 ?? (255, q))
			}
			h.segQidx[i] = q
			h.segLossless[i] = q == 0 && deltaLossless
			h.allLossless = false unless h.segLossless[i]
		}
		// Loop filter (5.9.11).
		if h.allLossless || h.allowIntrabc {
			h.lfDeltaEnabled = true
			h.lfDeltaUpdate = true
		} else {
			h.lfLevelY[0] = b.bits(6)
			h.lfLevelY[1] = b.bits(6)
			if !s.monochrome && (h.lfLevelY[0] != 0 || h.lfLevelY[1] != 0) {
				h.lfLevelU = b.bits(6)
				h.lfLevelV = b.bits(6)
			}
			h.lfSharpness = b.bits(3)
			if h.primaryRefFrame != av1PrimaryRefNone {
				let r = refs[h.refIdx[h.primaryRefFrame]]
				fail "av1: loop filter deltas from an empty reference" when !r.valid
				r.lfRefDelta.copy(h.lfRefDelta)
				r.lfModeDelta.copy(h.lfModeDelta)
			}
			h.lfDeltaEnabled = b.flag()
			if h.lfDeltaEnabled {
				h.lfDeltaUpdate = b.flag()
				if h.lfDeltaUpdate {
					for let i = 0; i < 8; i++ {
						h.lfRefDelta[i] = b.sbits(7) when b.flag()
					}
					for let i = 0; i < 2; i++ {
						h.lfModeDelta[i] = b.sbits(7) when b.flag()
					}
				}
			}
		}
		// CDEF (5.9.19).
		if !h.allLossless && s.cdef && !h.allowIntrabc {
			h.cdefDamping = b.bits(2) + 3
			h.cdefBits = b.bits(2)
			for let i = 0; i < (1 << h.cdefBits); i++ {
				h.cdefY[i] = b.bits(6)
				h.cdefUv[i] = b.bits(6) unless s.monochrome
			}
		}
		// Loop restoration (5.9.20).
		if (!h.allLossless || h.superRes) && s.restoration && !h.allowIntrabc {
			h.lrType[0] = b.bits(2)
			if !s.monochrome {
				h.lrType[1] = b.bits(2)
				h.lrType[2] = b.bits(2)
			}
			if h.lrType[0] != 0 || h.lrType[1] != 0 || h.lrType[2] != 0 {
				h.lrUnit[0] = 6 + (s.sb128 ?? (1, 0))
				if b.flag() {
					h.lrUnit[0]++
					h.lrUnit[0] += b.bit() unless s.sb128
				}
				h.lrUnit[1] = h.lrUnit[0]
				h.lrUnit[1] -= b.bit() when (h.lrType[1] != 0 || h.lrType[2] != 0) && s.ssHor == 1 && s.ssVer == 1
			}
		}
		h.txMode = h.allLossless ?? (0, b.flag() ?? (av1TxSwitchable, av1TxLargest))
		h.switchableCompRefs = b.flag() unless h.isIntra()
		av1SkipModeRefs(s, h, refs) when h.switchableCompRefs && s.orderHint
		h.skipModeEnabled = h.skipModeAllowed && b.flag()
		h.warpMotion = !h.errorResilient && !h.isIntra() && s.warpedMotion && b.flag()
		h.reducedTxtpSet = b.flag()
		if !h.isIntra() {
			try av1ParseGlobalMotion(b, h, refs)
		}
		if s.filmGrain && (h.showFrame || h.showableFrame) {
			try av1ParseFilmGrain(b, s, h, refs)
		}
		fail "av1: truncated frame header" when b.error
		return h
	}

	// frame_refs_short_signaling (7.8): the other references from the
	// last and golden ones.
	//
	// Fails on an empty reference slot.
	def av1ShortRefs(b Av1Bits, s Av1SeqHdr, h Av1FrameHdr, refs Av1FrameHdr[]) !none {
		h.refIdx[0] = b.bits(3)
		h.refIdx[1] = -1
		h.refIdx[2] = -1
		h.refIdx[3] = b.bits(3)
		h.refIdx[4] = -1
		h.refIdx[5] = -1
		h.refIdx[6] = -1
		let used = -(1 << 40)
		let offsets int[]
		offsets.len(8)
		let earliestRef = -1
		let earliestOffset = 1 << 30
		for let i = 0; i < 8; i++ {
			let ref = refs[i]
			fail "av1: short ref signaling with an empty slot" when !ref.valid
			let d = av1PocDiff(s.orderHintBits, ref.frameOffset, h.frameOffset)
			offsets[i] = d
			if d < earliestOffset {
				earliestOffset = d
				earliestRef = i
			}
		}
		offsets[h.refIdx[0]] = used
		offsets[h.refIdx[3]] = used
		let refidx = -1
		let latest = 0
		for let i = 0; i < 8; i++ {
			if offsets[i] >= latest {
				latest = offsets[i]
				refidx = i
			}
		}
		offsets[refidx] = used when refidx >= 0
		h.refIdx[6] = refidx
		for let i = 4; i < 6; i++ {
			// Unsigned compares: negative (used or before) values rank last.
			let best = 255
			refidx = -1
			for let j = 0; j < 8; j++ {
				let hint = offsets[j]
				if hint >= 0 && hint < best {
					best = hint
					refidx = j
				}
			}
			offsets[refidx] = used when refidx >= 0
			h.refIdx[i] = refidx
		}
		for let i = 1; i < 7; i++ {
			refidx = h.refIdx[i]
			if refidx < 0 {
				// The latest among those before the current frame, compared
				// as unsigned values from -255 up.
				let best = -(1 << 40)
				for let j = 0; j < 8; j++ {
					let hint = offsets[j]
					if hint != used && hint < 0 && hint >= -256 && hint >= best {
						best = hint
						refidx = j
					}
				}
				offsets[refidx] = used when refidx >= 0
				h.refIdx[i] = refidx >= 0 ?? (refidx, earliestRef)
			}
		}
		return none
	}

	// skip_mode_params (5.9.22).
	def av1SkipModeRefs(s Av1SeqHdr, h Av1FrameHdr, refs Av1FrameHdr[]) {
		let poc = h.frameOffset
		let offBefore = -1
		let offAfter = -1
		let beforeIdx = 0
		let afterIdx = 0
		for let i = 0; i < 7; i++ {
			let ref = refs[h.refIdx[i]]
			continue unless ref.valid
			let refPoc = ref.frameOffset
			let d = av1PocDiff(s.orderHintBits, refPoc, poc)
			if d > 0 {
				if offAfter < 0 || av1PocDiff(s.orderHintBits, offAfter, refPoc) > 0 {
					offAfter = refPoc
					afterIdx = i
				}
			} else if d < 0 && (offBefore < 0 || av1PocDiff(s.orderHintBits, refPoc, offBefore) > 0) {
				offBefore = refPoc
				beforeIdx = i
			}
		}
		if offBefore >= 0 && offAfter >= 0 {
			h.skipModeRefs[0] = beforeIdx < afterIdx ?? (beforeIdx, afterIdx)
			h.skipModeRefs[1] = beforeIdx < afterIdx ?? (afterIdx, beforeIdx)
			h.skipModeAllowed = true
		} else if offBefore >= 0 {
			let offBefore2 = -1
			let before2Idx = 0
			for let i = 0; i < 7; i++ {
				let ref = refs[h.refIdx[i]]
				continue unless ref.valid
				let refPoc = ref.frameOffset
				if av1PocDiff(s.orderHintBits, refPoc, offBefore) < 0 {
					if offBefore2 < 0 || av1PocDiff(s.orderHintBits, refPoc, offBefore2) > 0 {
						offBefore2 = refPoc
						before2Idx = i
					}
				}
			}
			if offBefore2 >= 0 {
				h.skipModeRefs[0] = beforeIdx < before2Idx ?? (beforeIdx, before2Idx)
				h.skipModeRefs[1] = beforeIdx < before2Idx ?? (before2Idx, beforeIdx)
				h.skipModeAllowed = true
			}
		}
	}

	// tile_info (5.9.15).
	def av1ParseTiling(b Av1Bits, s Av1SeqHdr, h Av1FrameHdr) {
		let uniform = b.flag()
		let sbLog2 = s.sb128 ?? (7, 6)
		let sbw = (h.width + (1 << sbLog2) - 1) >> sbLog2
		let sbh = (h.height + (1 << sbLog2) - 1) >> sbLog2
		let maxTileWidthSb = 4096 >> sbLog2
		let maxTileAreaSb = (4096 * 2304) >> (2 * sbLog2)
		let minLog2Cols = av1TileLog2(maxTileWidthSb, sbw)
		let maxLog2Cols = av1TileLog2(1, sbw < 64 ?? (sbw, 64))
		let maxLog2Rows = av1TileLog2(1, sbh < 64 ?? (sbh, 64))
		let minLog2Tiles = av1TileLog2(maxTileAreaSb, sbw * sbh)
		minLog2Tiles = minLog2Cols when minLog2Cols > minLog2Tiles
		if uniform {
			h.log2Cols = minLog2Cols
			for h.log2Cols < maxLog2Cols && b.flag() {
				h.log2Cols++
			}
			let tileW = 1 + ((sbw - 1) >> h.log2Cols)
			h.tileCols = 0
			for let x = 0; x < sbw; x += tileW {
				h.colStart[h.tileCols] = x
				h.tileCols++
			}
			let minLog2Rows = minLog2Tiles - h.log2Cols
			minLog2Rows = 0 when minLog2Rows < 0
			h.log2Rows = minLog2Rows
			for h.log2Rows < maxLog2Rows && b.flag() {
				h.log2Rows++
			}
			let tileH = 1 + ((sbh - 1) >> h.log2Rows)
			h.tileRows = 0
			for let y = 0; y < sbh; y += tileH {
				h.rowStart[h.tileRows] = y
				h.tileRows++
			}
		} else {
			h.tileCols = 0
			let widest = 0
			let x = 0
			for x < sbw && h.tileCols < 64 {
				let tileWidthSb = sbw - x < maxTileWidthSb ?? (sbw - x, maxTileWidthSb)
				let w = tileWidthSb > 1 ?? (1 + b.uniform(tileWidthSb), 1)
				h.colStart[h.tileCols] = x
				x += w
				widest = w when w > widest
				h.tileCols++
			}
			h.log2Cols = av1TileLog2(1, h.tileCols)
			let area = sbw * sbh
			area = area >> (minLog2Tiles + 1) when minLog2Tiles > 0
			let maxTileHeightSb = area / widest
			maxTileHeightSb = 1 when maxTileHeightSb < 1
			h.tileRows = 0
			let y = 0
			for y < sbh && h.tileRows < 64 {
				let tileHeightSb = sbh - y < maxTileHeightSb ?? (sbh - y, maxTileHeightSb)
				let th = tileHeightSb > 1 ?? (1 + b.uniform(tileHeightSb), 1)
				h.rowStart[h.tileRows] = y
				y += th
				h.tileRows++
			}
			h.log2Rows = av1TileLog2(1, h.tileRows)
		}
		h.colStart[h.tileCols] = sbw
		h.rowStart[h.tileRows] = sbh
		h.contextTile = 0
		h.tileSizeBytes = 4
		if h.log2Cols > 0 || h.log2Rows > 0 {
			h.contextTile = b.bits(h.log2Cols + h.log2Rows)
			h.tileSizeBytes = b.bits(2) + 1
		}
	}

	// global_motion_params (5.9.24).
	//
	// Fails on an empty primary reference.
	def av1ParseGlobalMotion(b Av1Bits, h Av1FrameHdr, refs Av1FrameHdr[]) !none {
		for let i = 0; i < 7; i++ {
			let t = av1WmIdentity
			t = b.flag() ?? (av1WmRotZoom, b.flag() ?? (av1WmTranslation, av1WmAffine)) when b.flag()
			h.gmvType[i] = t
			continue when t == av1WmIdentity
			let refm int[]
			refm.len(6)
			av1DefaultWarp(refm, 0)
			if h.primaryRefFrame != av1PrimaryRefNone {
				let r = refs[h.refIdx[h.primaryRefFrame]]
				fail "av1: global motion from an empty reference" when !r.valid
				for let k = 0; k < 6; k++ {
					refm[k] = r.gmv[i * 6 + k]
				}
			}
			let m = i * 6
			let bits = 0
			let shift = 0
			if t >= av1WmRotZoom {
				h.gmv[m + 2] = (1 << 16) + 2 * b.subexp((refm[2] - (1 << 16)) >> 1, 12)
				h.gmv[m + 3] = 2 * b.subexp(refm[3] >> 1, 12)
				bits = 12
				shift = 10
			} else {
				bits = 9 - (h.hp ?? (0, 1))
				shift = 13 + (h.hp ?? (0, 1))
			}
			if t == av1WmAffine {
				h.gmv[m + 4] = 2 * b.subexp(refm[4] >> 1, 12)
				h.gmv[m + 5] = (1 << 16) + 2 * b.subexp((refm[5] - (1 << 16)) >> 1, 12)
			} else {
				h.gmv[m + 4] = -h.gmv[m + 3]
				h.gmv[m + 5] = h.gmv[m + 2]
			}
			h.gmv[m] = b.subexp(refm[0] >> shift, bits) * (1 << shift)
			h.gmv[m + 1] = b.subexp(refm[1] >> shift, bits) * (1 << shift)
		}
		return none
	}

	// film_grain_params (5.9.30).
	//
	// Fails on invalid values or a reference that is not one of the
	// frame's.
	def av1ParseFilmGrain(b Av1Bits, s Av1SeqHdr, h Av1FrameHdr, refs Av1FrameHdr[]) !none {
		let present = b.flag()
		return none unless present
		let seed = b.bits(16)
		let update = h.frameType != av1FrameInter || b.flag()
		if !update {
			let idx = b.bits(3)
			let found = false
			for let i = 0; i < 7; i++ {
				found = true when h.refIdx[i] == idx
			}
			let ref = refs[idx]
			fail "av1: film grain from a slot the frame does not use" when !found || !ref.valid
			h.filmGrain = ref.filmGrain.copy()
			h.filmGrain.seed = seed
			h.filmGrain.present = true
			return none
		}
		let g = h.filmGrain
		g.present = true
		g.seed = seed
		g.numYPoints = b.bits(4)
		fail "av1: too many film grain points" when g.numYPoints > 14
		for let i = 0; i < g.numYPoints; i++ {
			g.yPoints[i * 2] = b.bits(8)
			fail "av1: film grain points out of order" when i > 0 && g.yPoints[(i - 1) * 2] >= g.yPoints[i * 2]
			g.yPoints[i * 2 + 1] = b.bits(8)
		}
		g.chromaFromLuma = !s.monochrome && b.flag()
		if s.monochrome || g.chromaFromLuma || (s.ssVer == 1 && s.ssHor == 1 && g.numYPoints == 0) {
			g.numUvPoints[0] = 0
			g.numUvPoints[1] = 0
		} else {
			for let pl = 0; pl < 2; pl++ {
				g.numUvPoints[pl] = b.bits(4)
				fail "av1: too many film grain points" when g.numUvPoints[pl] > 10
				for let i = 0; i < g.numUvPoints[pl]; i++ {
					g.uvPoints[pl * 20 + i * 2] = b.bits(8)
					fail "av1: film grain points out of order" when i > 0 && g.uvPoints[pl * 20 + (i - 1) * 2] >= g.uvPoints[pl * 20 + i * 2]
					g.uvPoints[pl * 20 + i * 2 + 1] = b.bits(8)
				}
			}
		}
		fail "av1: film grain chroma points of one plane only" when s.ssHor == 1 && s.ssVer == 1 && (g.numUvPoints[0] == 0) != (g.numUvPoints[1] == 0)
		g.scalingShift = b.bits(2) + 8
		g.arLag = b.bits(2)
		let numY = 2 * g.arLag * (g.arLag + 1)
		if g.numYPoints > 0 {
			for let i = 0; i < numY; i++ {
				g.arCoeffsY[i] = b.bits(8) - 128
			}
		}
		for let pl = 0; pl < 2; pl++ {
			if g.numUvPoints[pl] > 0 || g.chromaFromLuma {
				let numUv = numY + (g.numYPoints > 0 ?? (1, 0))
				for let i = 0; i < numUv; i++ {
					g.arCoeffsUv[pl * 28 + i] = b.bits(8) - 128
				}
				g.arCoeffsUv[pl * 28 + numUv] = 0 when g.numYPoints == 0
			}
		}
		g.arShift = b.bits(2) + 6
		g.grainScaleShift = b.bits(2)
		for let pl = 0; pl < 2; pl++ {
			if g.numUvPoints[pl] > 0 {
				g.uvMult[pl] = b.bits(8) - 128
				g.uvLumaMult[pl] = b.bits(8) - 128
				g.uvOffset[pl] = b.bits(9) - 256
			}
		}
		g.overlap = b.flag()
		g.clipRestricted = b.flag()
		return none
	}
}
