internal partial module std.formats.video.av1 {
	def av1SmFlag(intra int, mode int) int {
		return 0 when intra == 0
		return (mode == av1SmoothPred || mode == av1SmoothHPred || mode == av1SmoothVPred) ?? (av1AngleSmooth, 0)
	}

	def av1SmUvFlag(mode int) int {
		return (mode == av1SmoothPred || mode == av1SmoothHPred || mode == av1SmoothVPred) ?? (av1AngleSmooth, 0)
	}

	def av1FillCtx(arr int[], at int, n int, v int) {
		for let i = 0; i < n; i++ {
			arr[at + i] = v
		}
	}

	// The coefficients of one transform block of `plane` read and added
	// to the prediction at `dst`; the coef contexts updated over cw x ch
	// (or the full transform when skipped).
	def av1ResidualBlock(t Av1Tile, plane int, tx int, bs int, intra bool, a int[], ai int, l int[], li int, pix uint16[], dst int, stride int, cw int, ch int, ytxtp int) int {
		let d = tx * 8
		if t.bSkip {
			av1FillCtx(a, ai, av1TxDims[d], 0x40)
			av1FillCtx(l, li, av1TxDims[d + 1], 0x40)
			return -1
		}
		let eob = av1DecodeCoefs(t, a, ai, l, li, 127, tx, bs, intra, plane, ytxtp)
		av1FillCtx(a, ai, cw, t.coefCtx)
		av1FillCtx(l, li, ch, t.coefCtx)
		av1InvTxfmAdd(pix, dst, stride, t.cf, eob, tx, t.coefTxtp, t.bitDepth, t.tmp32) when eob >= 0
		return eob
	}

	// recon_b_intra: predicts and reconstructs the intra block at the
	// tile's (bx, by).
	//
	// Fails never; the error return keeps the call shape of inter blocks.
	def av1ReconIntra(t Av1Tile, bs int, intraEdgeFlags int) !none {
		av1MarkNoskip(t, bs)
		let f = t.cur
		let bx = t.bx
		let by = t.by
		let by4 = by & 31
		let ssHor = t.ssHor
		let ssVer = t.ssVer
		let cbx4 = bx >> ssHor
		let cby4 = by4 >> ssVer
		let bw4 = av1BlockDims[bs * 4]
		let bh4 = av1BlockDims[bs * 4 + 1]
		let w4 = bw4 < t.bw - bx ?? (bw4, t.bw - bx)
		let h4 = bh4 < t.bh - by ?? (bh4, t.bh - by)
		let cw4 = (w4 + ssHor) >> ssHor
		let ch4 = (h4 + ssVer) >> ssVer
		let hasChroma = t.layout != 0 && (bw4 > ssHor || (bx & 1) != 0) && (bh4 > ssVer || (by & 1) != 0)
		let td = t.bTx * 8
		let tw = av1TxDims[td]
		let th = av1TxDims[td + 1]
		let ud = t.bUvtx * 8
		let uw = av1TxDims[ud]
		let uh = av1TxDims[ud + 1]
		let e = t.edgeBuf
		let cbw4 = (bw4 + ssHor) >> ssHor
		let cbh4 = (bh4 + ssVer) >> ssVer
		let efFlag = t.seq.intraEdgeFilter ?? (av1AngleEdgeFilter, 0)
		let efOn = t.seq.intraEdgeFilter
		let depth = t.bitDepth
		let stride = f.stride
		let cstride = f.cstride
		let aw = t.aMode.len()
		for let initY = 0; initY < h4; initY += 16 {
			let subH4 = h4 < 16 + initY ?? (h4, 16 + initY)
			let subCh4 = ch4 < (initY + 16) >> ssVer ?? (ch4, (initY + 16) >> ssVer)
			for let initX = 0; initX < w4; initX += 16 {
				av1PalPred(f.y, 4 * (by * stride + bx), stride, t.pal, 0, t.palIdxY, bw4 * 4, bh4 * 4) when t.bPalSz0 > 0
				let intraFlags = av1SmFlag(t.aIntra[bx], t.aMode[bx]) | av1SmFlag(t.lIntra[by4], t.lMode[by4]) | efFlag
				let sbHasTr = initX + 16 < w4 ?? (true, initY != 0 ?? (false, (intraEdgeFlags & av1EdgeI444TopHasRight) != 0))
				let sbHasBl = initX != 0 ?? (false, initY + 16 < h4 ?? (true, (intraEdgeFlags & av1EdgeI444LeftHasBottom) != 0))
				let subW4 = w4 < initX + 16 ?? (w4, initX + 16)
				for let y = initY; y < subH4; y += th {
					let yy = by + y
					for let x = initX; x < subW4; x += tw {
						let xx = bx + x
						let dst = 4 * (yy * stride + xx)
						if t.bPalSz0 == 0 {
							let ang = t.ang
							ang[0] = t.bYAngle
							let ef = (((y > initY || !sbHasTr) && x + tw >= subW4) ?? (0, av1EdgeI444TopHasRight)) | ((x > initX || (!sbHasBl && y + th >= subH4)) ?? (0, av1EdgeI444LeftHasBottom))
							let m = av1PrepareEdges(xx, xx > t.colStart, yy, yy > t.rowStart, t.colEnd, t.rowEnd, ef, f.y, dst, stride, t.bYMode, ang, tw, th, efOn, e, depth)
							av1IntraPred(m, f.y, dst, stride, e, tw * 4, th * 4, ang[0] | intraFlags, 4 * t.bw - 4 * xx, 4 * t.bh - 4 * yy, depth, t.edgeTmp)
						}
						let cw = tw < t.bw - xx ?? (tw, t.bw - xx)
						let ch = th < t.bh - yy ?? (th, t.bh - yy)
						av1ResidualBlock(t, 0, t.bTx, bs, true, t.aLcoef, xx, t.lLcoef, by4 + y, f.y, dst, stride, cw, ch, 0)
					}
				}
				continue when !hasChroma
				if t.bUvMode == av1CflPred {
					let ysrc = 4 * (bx & ~ssHor) + 4 * (by & ~ssVer) * stride
					let uvOff = 4 * ((bx >> ssHor) + (by >> ssVer) * cstride)
					let furthestR = ((cw4 << ssHor) + tw - 1) & ~(tw - 1)
					let furthestB = ((ch4 << ssVer) + th - 1) & ~(th - 1)
					av1CflAc(t.ac, f.y, ysrc, stride, cbw4 - (furthestR >> ssHor), cbh4 - (furthestB >> ssVer), cbw4 * 4, cbh4 * 4, ssHor, ssVer)
					for let pl = 0; pl < 2; pl++ {
						let alpha = pl == 0 ?? (t.bCflAlpha0, t.bCflAlpha1)
						continue when alpha == 0
						let ang = t.ang
						ang[0] = 0
						let xpos = bx >> ssHor
						let ypos = by >> ssVer
						let pix = pl == 0 ?? (f.u, f.v)
						let m = av1PrepareEdges(xpos, xpos > t.colStart >> ssHor, ypos, ypos > t.rowStart >> ssVer, t.colEnd >> ssHor, t.rowEnd >> ssVer, 0, pix, uvOff, cstride, av1DcPred, ang, uw, uh, false, e, depth)
						av1CflPredict(pix, uvOff, cstride, e, uw * 4, uh * 4, m, t.ac, alpha, depth)
					}
				} else if t.bPalSz1 > 0 {
					let uvOff = 4 * ((bx >> ssHor) + (by >> ssVer) * cstride)
					av1PalPred(f.u, uvOff, cstride, t.pal, 8, t.palIdxUv, cbw4 * 4, cbh4 * 4)
					av1PalPred(f.v, uvOff, cstride, t.pal, 16, t.palIdxUv, cbw4 * 4, cbh4 * 4)
				}
				let smUv = av1SmUvFlag(t.aUvMode[cbx4]) | av1SmUvFlag(t.lUvMode[cby4])
				let lay = t.layout - 1
				let uvSbHasTr = (initX + 16) >> ssHor < cw4 ?? (true, initY != 0 ?? (false, (intraEdgeFlags & (av1EdgeI420TopHasRight >> lay)) != 0))
				let uvSbHasBl = initX != 0 ?? (false, (initY + 16) >> ssVer < ch4 ?? (true, (intraEdgeFlags & (av1EdgeI420LeftHasBottom >> lay)) != 0))
				let subCw4 = cw4 < (initX + 16) >> ssHor ?? (cw4, (initX + 16) >> ssHor)
				for let pl = 0; pl < 2; pl++ {
					let pix = pl == 0 ?? (f.u, f.v)
					let alpha = pl == 0 ?? (t.bCflAlpha0, t.bCflAlpha1)
					for let y = initY >> ssVer; y < subCh4; y += uh {
						let lby = by + (y << ssVer)
						for let x = initX >> ssHor; x < subCw4; x += uw {
							let lbx = bx + (x << ssHor)
							let dst = 4 * ((lby >> ssVer) * cstride + (lbx >> ssHor))
							if !((t.bUvMode == av1CflPred && alpha != 0) || t.bPalSz1 > 0) {
								let ang = t.ang
								ang[0] = t.bUvAngle
								let ef = (((y > (initY >> ssVer) || !uvSbHasTr) && x + uw >= subCw4) ?? (0, av1EdgeI444TopHasRight)) | ((x > (initX >> ssHor) || (!uvSbHasBl && y + uh >= subCh4)) ?? (0, av1EdgeI444LeftHasBottom))
								let uvMode = t.bUvMode == av1CflPred ?? (av1DcPred, t.bUvMode)
								let xpos = lbx >> ssHor
								let ypos = lby >> ssVer
								let m = av1PrepareEdges(xpos, xpos > t.colStart >> ssHor, ypos, ypos > t.rowStart >> ssVer, t.colEnd >> ssHor, t.rowEnd >> ssVer, ef, pix, dst, cstride, uvMode, ang, uw, uh, efOn, e, depth)
								av1IntraPred(m, pix, dst, cstride, e, uw * 4, uh * 4, ang[0] | efFlag | smUv, (4 * t.bw + ssHor - 4 * (lbx & ~ssHor)) >> ssHor, (4 * t.bh + ssVer - 4 * (lby & ~ssVer)) >> ssVer, depth, t.edgeTmp)
							}
							let cw = uw < (t.bw - lbx + ssHor) >> ssHor ?? (uw, (t.bw - lbx + ssHor) >> ssHor)
							let ch = uh < (t.bh - lby + ssVer) >> ssVer ?? (uh, (t.bh - lby + ssVer) >> ssVer)
							av1ResidualBlock(t, 1 + pl, t.bUvtx, bs, true, t.aCcoef, pl * aw + (lbx >> ssHor), t.lCcoef, pl * 32 + (cby4 + y), pix, dst, cstride, cw, ch, 0)
						}
					}
				}
			}
		}
		return none
	}
}
