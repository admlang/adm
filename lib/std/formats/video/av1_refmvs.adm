internal partial module std.formats.video.av1 {
	// Motion vector candidates (dav1d refmvs.c) over the frame-wide motion
	// field of `Av1Tile`, and the temporal motion projected from the
	// references.
	type Av1Mvs {
		// Per reference 0..6: sign bias, "before" sign, clipped POC
		// distance.
		signBias    int[]
		mfmvSign    int[]
		pocDiff     int[]
		// The references projected (up to 3): index, distance to the
		// current frame, and to each of their own references.
		mfmvRef     int[]
		mfmvRef2cur int[]
		mfmvRef2ref int[]
		nMfmvs      int
		// Projected motion per 8x8 block (ref 0 / mvx invalid: none).
		projMvx     int16[]
		projMvy     int16[]
		projRef     int8[]
		projStride  int
		iw4         int
		ih4         int
		iw8         int
		ih8         int
		// Scratch of add_compound_extended_candidate.
		same        int[]
		sameCount   int[]

		def new() {
			signBias.len(7)
			mfmvSign.len(7)
			pocDiff.len(7)
			mfmvRef.len(3)
			mfmvRef2cur.len(3)
			mfmvRef2ref.len(21)
			same.len(16)
			sameCount.len(4)
		}
	}

	const av1DivMult = int[0, 16384, 8192, 5461, 4096, 3276, 2730, 2340, 2048, 1820, 1638, 1489, 1365, 1260, 1170, 1092, 1024, 963, 910, 862, 819, 780, 744, 712, 682, 655, 630, 606, 585, 564, 546, 528]

	// mv_projection of one component.
	def av1ProjectMv(v int, num int, den int) int {
		let frac = num * av1DivMult[den]
		let p = v * frac
		let r = (p + 8192 + (p < 0 ?? (-1, 0))) >> 14
		return r < -0x3FFF ?? (-0x3FFF, r > 0x3FFF ?? (0x3FFF, r))
	}

	// dav1d_refmvs_init_frame: sign biases, distances and the projected
	// references of the frame decoded by `t`.
	def av1MvsInit(t Av1Tile, m Av1Mvs) {
		let s = t.seq
		let h = t.hdr
		m.iw8 = (h.width + 7) >> 3
		m.ih8 = (h.height + 7) >> 3
		m.iw4 = m.iw8 << 1
		m.ih4 = m.ih8 << 1
		m.projStride = m.iw8 + 1
		let n = m.projStride * (m.ih8 + 1)
		if m.projRef.len() != n {
			m.projMvx.len(n)
			m.projMvy.len(n)
			m.projRef.len(n)
		}
		let poc = h.frameOffset
		let bits = s.orderHintBits
		for let i = 0; i < 7; i++ {
			let rp = t.refs[i].hdr.frameOffset
			let d = av1PocDiff(bits, rp, poc)
			m.signBias[i] = d > 0 ?? (1, 0)
			m.mfmvSign[i] = d < 0 ?? (1, 0)
			let pd = av1PocDiff(bits, poc, rp)
			m.pocDiff[i] = pd < -31 ?? (-31, pd > 31 ?? (31, pd))
		}
		m.nMfmvs = 0
		if h.useRefFrameMvs && bits > 0 {
			let total = 2
			let r0 = t.refs[0]
			if t.rpOk[0] != 0 && r0.refPoc[6] != t.refs[3].hdr.frameOffset {
				m.mfmvRef[m.nMfmvs] = 0
				m.nMfmvs++
				total = 3
			}
			if t.rpOk[4] != 0 && av1PocDiff(bits, t.refs[4].hdr.frameOffset, poc) > 0 {
				m.mfmvRef[m.nMfmvs] = 4
				m.nMfmvs++
			}
			if t.rpOk[5] != 0 && av1PocDiff(bits, t.refs[5].hdr.frameOffset, poc) > 0 {
				m.mfmvRef[m.nMfmvs] = 5
				m.nMfmvs++
			}
			if m.nMfmvs < total && t.rpOk[6] != 0 && av1PocDiff(bits, t.refs[6].hdr.frameOffset, poc) > 0 {
				m.mfmvRef[m.nMfmvs] = 6
				m.nMfmvs++
			}
			if m.nMfmvs < total && t.rpOk[1] != 0 {
				m.mfmvRef[m.nMfmvs] = 1
				m.nMfmvs++
			}
			for let k = 0; k < m.nMfmvs; k++ {
				let rf = t.refs[m.mfmvRef[k]]
				let rpoc = rf.hdr.frameOffset
				let d1 = av1PocDiff(bits, rpoc, poc)
				if av1Abs(d1) > 31 {
					m.mfmvRef2cur[k] = -32
				} else {
					m.mfmvRef2cur[k] = m.mfmvRef[k] < 4 ?? (-d1, d1)
					for let j = 0; j < 7; j++ {
						let d2 = av1PocDiff(bits, rpoc, rf.refPoc[j])
						m.mfmvRef2ref[k * 7 + j] = (d2 < 0 || d2 > 31) ?? (0, d2)
					}
				}
			}
		}
		av1LoadTmvs(t, m) when m.nMfmvs > 0
	}

	// load_tmvs over the whole frame: each reference's saved motion
	// projected onto the current frame, within its 64x64 row and up to 8
	// blocks left or 16 right of its column group.
	def av1LoadTmvs(t Av1Tile, m Av1Mvs) {
		let st = m.projStride
		for let i = 0; i < m.projRef.len(); i++ {
			m.projRef[i] = int8(0)
			m.projMvx[i] = int16(av1InvalidMv)
		}
		for let n = 0; n < m.nMfmvs; n++ {
			let ref2cur = m.mfmvRef2cur[n]
			continue when ref2cur == -32
			let refIdx = m.mfmvRef[n]
			let rf = t.refs[refIdx]
			let refSign = refIdx - 4
			let rst = rf.rpStride
			for let y = 0; y < m.ih8; y++ {
				let yAlign = y & ~7
				let yEnd = yAlign + 8 < m.ih8 ?? (yAlign + 8, m.ih8)
				let x = 0
				for x < m.iw8 {
					let k = y * rst + x
					if y >= rf.rpRef.len() / rst || x >= rst {
						x++
						continue
					}
					let bref = int(rf.rpRef[k])
					if bref == 0 {
						x++
						continue
					}
					let ref2ref = m.mfmvRef2ref[n * 7 + bref - 1]
					if ref2ref == 0 {
						x++
						continue
					}
					let bmx = int(rf.rpMvx[k])
					let bmy = int(rf.rpMvy[k])
					let ox = av1ProjectMv(bmx, ref2cur, ref2ref)
					let oy = av1ProjectMv(bmy, ref2cur, ref2ref)
					let posX = x + av1ApplySign(av1Abs(ox) >> 6, ox ^ refSign)
					let posY = y + av1ApplySign(av1Abs(oy) >> 6, oy ^ refSign)
					let inRow = posY >= yAlign && posY < yEnd
					for {
						if inRow {
							let xAlign = x & ~7
							let lo = xAlign - 8 > 0 ?? (xAlign - 8, 0)
							let hi = xAlign + 16 < m.iw8 ?? (xAlign + 16, m.iw8)
							if posX >= lo && posX < hi {
								let p = posY * st + posX
								m.projMvx[p] = int16(bmx)
								m.projMvy[p] = int16(bmy)
								m.projRef[p] = int8(ref2ref)
							}
						}
						x++
						break when x >= m.iw8
						let k2 = y * rst + x
						break when int(rf.rpRef[k2]) != bref || int(rf.rpMvx[k2]) != bmx || int(rf.rpMvy[k2]) != bmy
						posX++
					}
				}
			}
		}
	}

	// save_tmvs over the frame: the motion of the odd 4x4 block of each
	// 8x8 block kept for later frames.
	def av1SaveTmvs(t Av1Tile, m Av1Mvs, f Av1Frame) {
		let iw8 = m.iw8
		let ih8 = m.ih8
		f.rpStride = iw8
		let n = iw8 * ih8
		if f.rpRef.len() != n {
			f.rpMvx.len(n)
			f.rpMvy.len(n)
			f.rpRef.len(n)
		}
		for let y = 0; y < ih8; y++ {
			let x = 0
			for x < iw8 {
				let k = t.at(x * 2 + 1, y * 2 + 1)
				let bw8 = (av1BlockDims[int(t.rBs[k]) * 4] + 1) >> 1
				let r1 = int(t.rRef1[k])
				let r0 = int(t.rRef0[k])
				let mx = 0
				let my = 0
				let r = 0
				if r1 > 0 && m.mfmvSign[r1 - 1] != 0 && (av1Abs(int(t.rMvy1[k])) | av1Abs(int(t.rMvx1[k]))) < 4096 {
					mx = int(t.rMvx1[k])
					my = int(t.rMvy1[k])
					r = r1
				} else if r0 > 0 && m.mfmvSign[r0 - 1] != 0 && (av1Abs(int(t.rMvy0[k])) | av1Abs(int(t.rMvx0[k]))) < 4096 {
					mx = int(t.rMvx0[k])
					my = int(t.rMvy0[k])
					r = r0
				}
				for let i = 0; i < bw8 && x < iw8; i++ {
					f.rpMvx[y * iw8 + x] = int16(mx)
					f.rpMvy[y * iw8 + x] = int16(my)
					f.rpRef[y * iw8 + x] = int8(r)
					x++
				}
			}
		}
		f.rpValid = true
	}

	// Candidate state of one search.
	type Av1MvSearch {
		gmvX       int[]
		gmvY       int[]
		gmvValid   bool[]
		tgmv       int[]
		haveNewmv  bool
		haveRowMvs bool
		haveColMvs bool
		dummy      bool

		def new() {
			gmvX.len(2)
			gmvY.len(2)
			gmvValid.len(2)
			tgmv.len(4)
		}
	}

	// add_spatial_candidate from the motion field entry `k`.
	def av1AddSpatial(t Av1Tile, s Av1MvSearch, weight int, k int, ref0 int, ref1 int, row bool, newmv bool) {
		return when int(t.rMvx0[k]) == av1InvalidMv && int(t.rMvy0[k]) == av1InvalidMv && int(t.rRef0[k]) == 0
		let br0 = int(t.rRef0[k])
		let br1 = int(t.rRef1[k])
		let mf = int(t.rMf[k])
		if ref1 == -1 {
			for let n = 0; n < 2; n++ {
				let br = n == 0 ?? (br0, br1)
				if br == ref0 {
					let cx = n == 0 ?? (int(t.rMvx0[k]), int(t.rMvx1[k]))
					let cy = n == 0 ?? (int(t.rMvy0[k]), int(t.rMvy1[k]))
					if (mf & 1) != 0 && s.gmvValid[0] {
						cx = s.gmvX[0]
						cy = s.gmvY[0]
					}
					if row {
						s.haveRowMvs = true
					} else {
						s.haveColMvs = true
					}
					s.haveNewmv = true when newmv && (mf >> 1) != 0
					let last = t.mvCount
					for let m = 0; m < last; m++ {
						if t.mvStack[m * 4] == cx && t.mvStack[m * 4 + 1] == cy {
							t.mvWeight[m] += weight
							return
						}
					}
					if last < 8 {
						t.mvStack[last * 4] = cx
						t.mvStack[last * 4 + 1] = cy
						t.mvWeight[last] = weight
						t.mvCount = last + 1
					}
					return
				}
			}
		} else if br0 == ref0 && br1 == ref1 {
			let c0x = int(t.rMvx0[k])
			let c0y = int(t.rMvy0[k])
			let c1x = int(t.rMvx1[k])
			let c1y = int(t.rMvy1[k])
			if (mf & 1) != 0 {
				if s.gmvValid[0] {
					c0x = s.gmvX[0]
					c0y = s.gmvY[0]
				}
				if s.gmvValid[1] {
					c1x = s.gmvX[1]
					c1y = s.gmvY[1]
				}
			}
			if row {
				s.haveRowMvs = true
			} else {
				s.haveColMvs = true
			}
			s.haveNewmv = true when newmv && (mf >> 1) != 0
			let last = t.mvCount
			for let m = 0; m < last; m++ {
				if t.mvStack[m * 4] == c0x && t.mvStack[m * 4 + 1] == c0y && t.mvStack[m * 4 + 2] == c1x && t.mvStack[m * 4 + 3] == c1y {
					t.mvWeight[m] += weight
					return
				}
			}
			if last < 8 {
				t.mvStack[last * 4] = c0x
				t.mvStack[last * 4 + 1] = c0y
				t.mvStack[last * 4 + 2] = c1x
				t.mvStack[last * 4 + 3] = c1y
				t.mvWeight[last] = weight
				t.mvCount = last + 1
			}
		}
	}

	// scan_row over the entries from (x, y): returns the rows it counts.
	def av1ScanRow(t Av1Tile, s Av1MvSearch, x0 int, y int, bw4 int, w4 int, maxRows int, step int, ref0 int, ref1 int, newmv bool) int {
		let k = t.at(x0, y)
		let firstBs = int(t.rBs[k])
		let cbw4 = av1BlockDims[firstBs * 4]
		let len = bw4 < cbw4 ?? (bw4, cbw4)
		len = step when step > len
		if bw4 <= cbw4 {
			let lim = 2 * maxRows < av1BlockDims[firstBs * 4 + 1] ?? (2 * maxRows, av1BlockDims[firstBs * 4 + 1])
			let weight = bw4 == 1 ?? (2, lim > 2 ?? (lim, 2))
			av1AddSpatial(t, s, len * weight, k, ref0, ref1, true, newmv)
			return weight >> 1
		}
		let x = 0
		for {
			av1AddSpatial(t, s, len * 2, k, ref0, ref1, true, newmv)
			x += len
			return 1 when x >= w4
			k = t.at(x0 + x, y)
			cbw4 = av1BlockDims[int(t.rBs[k]) * 4]
			len = step > cbw4 ?? (step, cbw4)
		}
		return 1
	}

	def av1ScanCol(t Av1Tile, s Av1MvSearch, x int, y0 int, bh4 int, h4 int, maxCols int, step int, ref0 int, ref1 int, newmv bool) int {
		let k = t.at(x, y0)
		let firstBs = int(t.rBs[k])
		let cbh4 = av1BlockDims[firstBs * 4 + 1]
		let len = bh4 < cbh4 ?? (bh4, cbh4)
		len = step when step > len
		if bh4 <= cbh4 {
			let lim = 2 * maxCols < av1BlockDims[firstBs * 4] ?? (2 * maxCols, av1BlockDims[firstBs * 4])
			let weight = bh4 == 1 ?? (2, lim > 2 ?? (lim, 2))
			av1AddSpatial(t, s, len * weight, k, ref0, ref1, false, newmv)
			return weight >> 1
		}
		let y = 0
		for {
			av1AddSpatial(t, s, len * 2, k, ref0, ref1, false, newmv)
			y += len
			return 1 when y >= h4
			k = t.at(x, y0 + y)
			cbh4 = av1BlockDims[int(t.rBs[k]) * 4 + 1]
			len = step > cbh4 ?? (step, cbh4)
		}
		return 1
	}

	// add_temporal_candidate from projected 8x8 block `p`; returns the
	// globalmv context it sets (-1 when none).
	def av1AddTemporal(t Av1Tile, m Av1Mvs, s Av1MvSearch, p int, ref0 int, ref1 int, weight int, gctx bool) int {
		return -1 when int(m.projMvx[p]) == av1InvalidMv && int(m.projRef[p]) == 0
		let pr = int(m.projRef[p])
		return -1 when pr == 0
		let pmx = int(m.projMvx[p])
		let pmy = int(m.projMvy[p])
		let h = t.hdr
		let mx = av1FixMv(h, av1ProjectMv(pmx, m.pocDiff[ref0 - 1], pr))
		let my = av1FixMv(h, av1ProjectMv(pmy, m.pocDiff[ref0 - 1], pr))
		let last = t.mvCount
		let ctx = -1
		if ref1 == -1 {
			ctx = (av1Abs(mx - s.tgmv[0]) | av1Abs(my - s.tgmv[1])) >= 16 ?? (1, 0) when gctx
			for let n = 0; n < last; n++ {
				if t.mvStack[n * 4] == mx && t.mvStack[n * 4 + 1] == my {
					t.mvWeight[n] += weight
					return ctx
				}
			}
			if last < 8 {
				t.mvStack[last * 4] = mx
				t.mvStack[last * 4 + 1] = my
				t.mvWeight[last] = weight
				t.mvCount = last + 1
			}
			return ctx
		}
		let m2x = av1FixMv(h, av1ProjectMv(pmx, m.pocDiff[ref1 - 1], pr))
		let m2y = av1FixMv(h, av1ProjectMv(pmy, m.pocDiff[ref1 - 1], pr))
		for let n = 0; n < last; n++ {
			if t.mvStack[n * 4] == mx && t.mvStack[n * 4 + 1] == my && t.mvStack[n * 4 + 2] == m2x && t.mvStack[n * 4 + 3] == m2y {
				t.mvWeight[n] += weight
				return ctx
			}
		}
		if last < 8 {
			t.mvStack[last * 4] = mx
			t.mvStack[last * 4 + 1] = my
			t.mvStack[last * 4 + 2] = m2x
			t.mvStack[last * 4 + 3] = m2y
			t.mvWeight[last] = weight
			t.mvCount = last + 1
		}
		return ctx
	}

	// add_compound_extended_candidate: `same` holds two candidates (x0, y0,
	// x1, y1) followed by the two "different" ones.
	def av1AddCompoundExt(t Av1Tile, m Av1Mvs, k int, sign0 int, sign1 int, ref0 int, ref1 int) {
		let sc = m.sameCount
		for let n = 0; n < 2; n++ {
			let cref = n == 0 ?? (int(t.rRef0[k]), int(t.rRef1[k]))
			break when cref <= 0
			let cx = n == 0 ?? (int(t.rMvx0[k]), int(t.rMvx1[k]))
			let cy = n == 0 ?? (int(t.rMvy0[k]), int(t.rMvy1[k]))
			let bias = m.signBias[cref - 1]
			if cref == ref0 {
				if sc[0] < 2 {
					m.same[sc[0] * 4] = cx
					m.same[sc[0] * 4 + 1] = cy
					sc[0]++
				}
				if sc[3] < 2 {
					let nx = (sign1 ^ bias) != 0 ?? (-cx, cx)
					let ny = (sign1 ^ bias) != 0 ?? (-cy, cy)
					m.same[8 + sc[3] * 4 + 2] = nx
					m.same[8 + sc[3] * 4 + 3] = ny
					sc[3]++
				}
			} else if cref == ref1 {
				if sc[1] < 2 {
					m.same[sc[1] * 4 + 2] = cx
					m.same[sc[1] * 4 + 3] = cy
					sc[1]++
				}
				if sc[2] < 2 {
					let nx = (sign0 ^ bias) != 0 ?? (-cx, cx)
					let ny = (sign0 ^ bias) != 0 ?? (-cy, cy)
					m.same[8 + sc[2] * 4] = nx
					m.same[8 + sc[2] * 4 + 1] = ny
					sc[2]++
				}
			} else {
				if sc[2] < 2 {
					m.same[8 + sc[2] * 4] = (sign0 ^ bias) != 0 ?? (-cx, cx)
					m.same[8 + sc[2] * 4 + 1] = (sign0 ^ bias) != 0 ?? (-cy, cy)
					sc[2]++
				}
				if sc[3] < 2 {
					m.same[8 + sc[3] * 4 + 2] = (sign1 ^ bias) != 0 ?? (-cx, cx)
					m.same[8 + sc[3] * 4 + 3] = (sign1 ^ bias) != 0 ?? (-cy, cy)
					sc[3]++
				}
			}
		}
	}

	def av1AddSingleExt(t Av1Tile, m Av1Mvs, k int, sign int) {
		for let n = 0; n < 2; n++ {
			let cref = n == 0 ?? (int(t.rRef0[k]), int(t.rRef1[k]))
			break when cref <= 0
			let cx = n == 0 ?? (int(t.rMvx0[k]), int(t.rMvx1[k]))
			let cy = n == 0 ?? (int(t.rMvy0[k]), int(t.rMvy1[k]))
			if (sign ^ m.signBias[cref - 1]) != 0 {
				cx = -cx
				cy = -cy
			}
			let last = t.mvCount
			let found = false
			for let j = 0; j < last; j++ {
				if t.mvStack[j * 4] == cx && t.mvStack[j * 4 + 1] == cy {
					found = true
					break
				}
			}
			if !found {
				t.mvStack[last * 4] = cx
				t.mvStack[last * 4 + 1] = cy
				t.mvWeight[last] = 2
				t.mvCount = last + 1
			}
		}
	}

	// dav1d_refmvs_find: the candidate stack of the block at (t.bx, t.by)
	// for references ref0 (0 intra block copy, 1..7) and ref1 (-1 single)
	// into t.mvStack/mvWeight/mvCount and the mode context t.mvCtx.
	def av1RefmvsFind(t Av1Tile, ref0 int, ref1 int, bs int, edgeFlags int) {
		let m = t.mvs
		let s = t.search
		let h = t.hdr
		let bx4 = t.bx
		let by4 = t.by
		let bw4 = av1BlockDims[bs * 4]
		let bh4 = av1BlockDims[bs * 4 + 1]
		let tileColEnd = t.colEnd < m.iw4 ?? (t.colEnd, m.iw4)
		let tileRowEnd = t.rowEnd < m.ih4 ?? (t.rowEnd, m.ih4)
		let w4 = bw4 < 16 ?? (bw4, 16)
		w4 = tileColEnd - bx4 when tileColEnd - bx4 < w4
		let h4 = bh4 < 16 ?? (bh4, 16)
		h4 = tileRowEnd - by4 when tileRowEnd - by4 < h4
		t.mvCount = 0
		for let i = 0; i < 32; i++ {
			t.mvStack[i] = 0
		}
		for let i = 0; i < 8; i++ {
			t.mvWeight[i] = 0
		}
		s.gmvValid[0] = false
		s.gmvValid[1] = false
		s.tgmv[0] = 0
		s.tgmv[1] = 0
		s.tgmv[2] = 0
		s.tgmv[3] = 0
		if ref0 > 0 {
			av1GmvAt(h, ref0 - 1, bx4, by4, bw4, bh4, s.tgmv, 0)
			if h.gmvType[ref0 - 1] > av1WmTranslation {
				s.gmvValid[0] = true
				s.gmvX[0] = s.tgmv[0]
				s.gmvY[0] = s.tgmv[1]
			}
		}
		if ref1 > 0 {
			av1GmvAt(h, ref1 - 1, bx4, by4, bw4, bh4, s.tgmv, 2)
			if h.gmvType[ref1 - 1] > av1WmTranslation {
				s.gmvValid[1] = true
				s.gmvX[1] = s.tgmv[2]
				s.gmvY[1] = s.tgmv[3]
			}
		}
		s.haveNewmv = false
		s.haveRowMvs = false
		s.haveColMvs = false
		let noScan = 1 << 30
		let maxRows = 0
		let nRows = noScan
		if by4 > t.rowStart {
			maxRows = (by4 - t.rowStart + 1) >> 1
			maxRows = 2 + (bh4 > 1 ?? (1, 0)) when maxRows > 2 + (bh4 > 1 ?? (1, 0))
			nRows = av1ScanRow(t, s, bx4, by4 - 1, bw4, w4, maxRows, bw4 >= 16 ?? (4, 1), ref0, ref1, true)
		}
		let maxCols = 0
		let nCols = noScan
		if bx4 > t.colStart {
			maxCols = (bx4 - t.colStart + 1) >> 1
			maxCols = 2 + (bw4 > 1 ?? (1, 0)) when maxCols > 2 + (bw4 > 1 ?? (1, 0))
			nCols = av1ScanCol(t, s, bx4 - 1, by4, bh4, h4, maxCols, bh4 >= 16 ?? (4, 1), ref0, ref1, true)
		}
		av1AddSpatial(t, s, 4, t.at(bx4 + bw4, by4 - 1), ref0, ref1, row = true, newmv = true) when nRows != noScan && (edgeFlags & av1EdgeI444TopHasRight) != 0 && (bw4 > bh4 ?? (bw4, bh4)) <= 16 && bw4 + bx4 < tileColEnd
		let nearestMatch = (s.haveColMvs ?? (1, 0)) + (s.haveRowMvs ?? (1, 0))
		let nearestCnt = t.mvCount
		for let n = 0; n < nearestCnt; n++ {
			t.mvWeight[n] += 640
		}
		let globalmvCtx = h.useRefFrameMvs ?? (1, 0)
		if m.nMfmvs > 0 {
			let st = m.projStride
			let by8 = by4 >> 1
			let bx8 = bx4 >> 1
			let stepH = bw4 >= 16 ?? (2, 1)
			let stepV = bh4 >= 16 ?? (2, 1)
			let w8 = (w4 + 1) >> 1 < 8 ?? ((w4 + 1) >> 1, 8)
			let h8 = (h4 + 1) >> 1 < 8 ?? ((h4 + 1) >> 1, 8)
			let first = true
			for let y = 0; y < h8; y += stepV {
				for let x = 0; x < w8; x += stepH {
					let c = av1AddTemporal(t, m, s, (by8 + y) * st + bx8 + x, ref0, ref1, 2, first)
					if first {
						globalmvCtx = c when c >= 0
						first = false
					}
				}
			}
			if (bw4 < bh4 ?? (bw4, bh4)) >= 2 && (bw4 > bh4 ?? (bw4, bh4)) < 16 {
				let bh8 = bh4 >> 1
				let bw8 = bw4 >> 1
				let rowEnd8 = (tileRowEnd >> 1) < (by8 & ~7) + 8 ?? (tileRowEnd >> 1, (by8 & ~7) + 8)
				let colEnd8 = (tileColEnd >> 1) < (bx8 & ~7) + 8 ?? (tileColEnd >> 1, (bx8 & ~7) + 8)
				let colStart8 = (t.colStart >> 1) > (bx8 & ~7) ?? (t.colStart >> 1, bx8 & ~7)
				let hasBottom = by8 + bh8 < rowEnd8
				let rb = (by8 + bh8) * st + bx8
				av1AddTemporal(t, m, s, rb - 1, ref0, ref1, 2, false) when hasBottom && bx8 - 1 >= colStart8
				if bx8 + bw8 < colEnd8 {
					av1AddTemporal(t, m, s, rb + bw8, ref0, ref1, 2, false) when hasBottom
					av1AddTemporal(t, m, s, rb + bw8 - st, ref0, ref1, 2, false) when by8 + bh8 - 1 < rowEnd8
				}
			}
		}
		av1AddSpatial(t, s, 4, t.at(bx4 - 1, by4 - 1), ref0, ref1, row = true, newmv = false) when nRows != noScan && nCols != noScan
		for let n = 2; n <= 3; n++ {
			if n > nRows && n <= maxRows {
				let yy = ((by4 & 31) - 2 * n + 1) | 1
				nRows += av1ScanRow(t, s, bx4 | 1, (by4 & ~31) + yy, bw4, w4, 1 + maxRows - n, bw4 >= 16 ?? (4, 2), ref0, ref1, false)
			}
			nCols += av1ScanCol(t, s, (bx4 - n * 2 + 1) | 1, by4 | 1, bh4, h4, 1 + maxCols - n, bh4 >= 16 ?? (4, 2), ref0, ref1, false) when n > nCols && n <= maxCols
		}
		let refMatch = (s.haveColMvs ?? (1, 0)) + (s.haveRowMvs ?? (1, 0))
		let refmvCtx = 0
		let newmvCtx = 0
		let hn = s.haveNewmv ?? (1, 0)
		match nearestMatch {
			case 0:
				refmvCtx = refMatch < 2 ?? (refMatch, 2)
				newmvCtx = refMatch > 0 ?? (1, 0)
			case 1:
				refmvCtx = refMatch * 3 < 4 ?? (refMatch * 3, 4)
				newmvCtx = 3 - hn
			default:
				refmvCtx = 5
				newmvCtx = 5 - hn
		}
		// Sort the nearest, then the rest, by weight (stable bubble).
		av1SortStack(t, 0, nearestCnt)
		av1SortStack(t, nearestCnt, t.mvCount)
		if ref1 > 0 {
			if t.mvCount < 2 {
				let sign0 = m.signBias[ref0 - 1]
				let sign1 = m.signBias[ref1 - 1]
				let sz4 = w4 < h4 ?? (w4, h4)
				for let i = 0; i < 4; i++ {
					m.sameCount[i] = 0
				}
				for let i = 0; i < 16; i++ {
					m.same[i] = 0
				}
				if nRows != noScan {
					let x = 0
					for x < sz4 {
						let k = t.at(bx4 + x, by4 - 1)
						av1AddCompoundExt(t, m, k, sign0, sign1, ref0, ref1)
						x += av1BlockDims[int(t.rBs[k]) * 4]
					}
				}
				if nCols != noScan {
					let y = 0
					for y < sz4 {
						let k = t.at(bx4 - 1, by4 + y)
						av1AddCompoundExt(t, m, k, sign0, sign1, ref0, ref1)
						y += av1BlockDims[int(t.rBs[k]) * 4 + 1]
					}
				}
				// Merge the same and different candidates.
				for let n = 0; n < 2; n++ {
					let mm = m.sameCount[n]
					continue when mm >= 2
					let l = m.sameCount[2 + n]
					let done = false
					if l > 0 {
						m.same[mm * 4 + n * 2] = m.same[8 + n * 2]
						m.same[mm * 4 + n * 2 + 1] = m.same[8 + n * 2 + 1]
						mm++
						done = true when mm == 2
						if !done && l == 2 {
							m.same[4 + n * 2] = m.same[12 + n * 2]
							m.same[4 + n * 2 + 1] = m.same[12 + n * 2 + 1]
							done = true
						}
					}
					if !done {
						for mm < 2 {
							m.same[mm * 4 + n * 2] = s.tgmv[n * 2]
							m.same[mm * 4 + n * 2 + 1] = s.tgmv[n * 2 + 1]
							mm++
						}
					}
				}
				let cnt = t.mvCount
				// `same` sits right after the existing candidates.
				for let i = 0; i < 2 - cnt; i++ {
					for let c = 0; c < 4; c++ {
						t.mvStack[(cnt + i) * 4 + c] = m.same[i * 4 + c]
					}
				}
				if cnt == 1 && t.mvStack[0] == m.same[0] && t.mvStack[1] == m.same[1] && t.mvStack[2] == m.same[2] && t.mvStack[3] == m.same[3] {
					for let c = 0; c < 4; c++ {
						t.mvStack[4 + c] = m.same[4 + c]
					}
				}
				for let n = cnt; n < 2; n++ {
					t.mvWeight[n] = 2
				}
				t.mvCount = 2
			}
			let left = -(bx4 + bw4 + 4) * 4 * 8
			let right = (m.iw4 - bx4 + 4) * 4 * 8
			let top = -(by4 + bh4 + 4) * 4 * 8
			let bottom = (m.ih4 - by4 + 4) * 4 * 8
			for let n = 0; n < t.mvCount; n++ {
				t.mvStack[n * 4] = av1ClipI(t.mvStack[n * 4], left, right)
				t.mvStack[n * 4 + 1] = av1ClipI(t.mvStack[n * 4 + 1], top, bottom)
				t.mvStack[n * 4 + 2] = av1ClipI(t.mvStack[n * 4 + 2], left, right)
				t.mvStack[n * 4 + 3] = av1ClipI(t.mvStack[n * 4 + 3], top, bottom)
			}
			match refmvCtx >> 1 {
				case 0:
					t.mvCtx = newmvCtx < 1 ?? (newmvCtx, 1)
				case 1:
					t.mvCtx = 1 + (newmvCtx < 3 ?? (newmvCtx, 3))
				default:
					let c = 3 + newmvCtx
					t.mvCtx = c < 4 ?? (4, c > 7 ?? (7, c))
			}
			return
		}
		if t.mvCount < 2 && ref0 > 0 {
			let sign = m.signBias[ref0 - 1]
			let sz4 = w4 < h4 ?? (w4, h4)
			if nRows != noScan {
				let x = 0
				for x < sz4 && t.mvCount < 2 {
					let k = t.at(bx4 + x, by4 - 1)
					av1AddSingleExt(t, m, k, sign)
					x += av1BlockDims[int(t.rBs[k]) * 4]
				}
			}
			if nCols != noScan {
				let y = 0
				for y < sz4 && t.mvCount < 2 {
					let k = t.at(bx4 - 1, by4 + y)
					av1AddSingleExt(t, m, k, sign)
					y += av1BlockDims[int(t.rBs[k]) * 4 + 1]
				}
			}
		}
		if t.mvCount > 0 {
			let left = -(bx4 + bw4 + 4) * 4 * 8
			let right = (m.iw4 - bx4 + 4) * 4 * 8
			let top = -(by4 + bh4 + 4) * 4 * 8
			let bottom = (m.ih4 - by4 + 4) * 4 * 8
			for let n = 0; n < t.mvCount; n++ {
				t.mvStack[n * 4] = av1ClipI(t.mvStack[n * 4], left, right)
				t.mvStack[n * 4 + 1] = av1ClipI(t.mvStack[n * 4 + 1], top, bottom)
			}
		}
		for let n = t.mvCount; n < 2; n++ {
			t.mvStack[n * 4] = s.tgmv[0]
			t.mvStack[n * 4 + 1] = s.tgmv[1]
		}
		t.mvCtx = (refmvCtx << 4) | (globalmvCtx << 3) | newmvCtx
	}

	def av1ClipI(v int, lo int, hi int) int {
		return v < lo ?? (lo, v > hi ?? (hi, v))
	}

	// The bubble sort of dav1d over entries [from, to) by weight.
	def av1SortStack(t Av1Tile, from int, to int) {
		let len = to
		for len > from {
			let last = from
			for let n = from + 1; n < len; n++ {
				if t.mvWeight[n - 1] < t.mvWeight[n] {
					let w = t.mvWeight[n - 1]
					t.mvWeight[n - 1] = t.mvWeight[n]
					t.mvWeight[n] = w
					for let c = 0; c < 4; c++ {
						let v = t.mvStack[(n - 1) * 4 + c]
						t.mvStack[(n - 1) * 4 + c] = t.mvStack[n * 4 + c]
						t.mvStack[n * 4 + c] = v
					}
					last = n
				}
			}
			len = last
		}
	}
}
