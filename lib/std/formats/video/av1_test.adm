		"265eca6f5daedac0ba6b54b1a64421b8",
		"265eca6f5daedac0ba6b54b1a64421b8",
		"265eca6f5daedac0ba6b54b1a64421b8",
		"265eca6f5daedac0ba6b54b1a64421b8",
		"265eca6f5daedac0ba6b54b1a64421b8"
	]

	// The stream of av1TestMain in an MP4 file (av01 sample entry with an av1C record).
	const av1TestMp4 = "AAAAIGZ0eXBpc29tAAACAGlzb21hdjAxaXNvMm1wNDEAAAAIZnJlZQAAAe9tZGF0CgoAAAACr/ebXzAIMtkCFAAuoAAAkAuAgNtx" +
		"pCzOTfN4Lwu1Oa+E52+0gHxmN6TyxkBZmBzLmb6lql4wTY5ImkCMLXrgmr2qYtov14lJxUCD1ps5I6nGzGDagrn2FqQq+sdtZxo6" +
		"UW28jNMrZOGVBc9AizhRZpLdZ/I7t2CwZ1WopuUQzuSFWrPEbTqR7dc6rj+v5l8hkuiEAa/9QgSMvMnhKKzLn/GUg24C1DaYwlgA" +
		"cMFvVy5yvKWe/Qr7bVjdaVnws95TDJB3jyqyqBCtoWCsMNnr5NxWj5PMn6Zd62u24AV5qHeIcZD1A5FRLRFLkablcRmdYualXyLo" +
		"stbeQ7lHDe+JtudYpU9jWALgaUjJsx9xps9re6aW9Qv6q/bVpPJkKua0cWZlaGqglhi6ueOzvoFSNgowYBDXb1afXntsuCQnReyD" +
		"LZ6mLIx5apDyiHWfBfwp64V6xOvscHLd6Ju0r50Ny2HMMhIzAeBAAAAGzYAAAoAAAIAAmRAyEjMCAIIAAAbEAAACgAAAgACUwDIs" +
		"MgMBBEAAA2LAEEIAFAFwBADfsqkmJ6E12950h4p3dkz5j3/NXhG0i2sr4SAyEzME4gaIAAbaACCEACgAAAgAmRAyEjMFBAaMAAba" +
		"ACCEACgAAAgAgQAAAyVtb292AAAAbG12aGQAAAAAAAAAAAAAAAAAAAPoAAAA8AABAAABAAAAAAAAAAAAAAAAAQAAAAAAAAAAAAAA" +
		"AAAAAAEAAAAAAAAAAAAAAAAAAEAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAACAAACT3RyYWsAAABcdGtoZAAAAAMAAAAA" +
		"AAAAAAAAAAEAAAAAAAAA8AAAAAAAAAAAAAAAAAAAAAAAAQAAAAAAAAAAAAAAAAAAAAEAAAAAAAAAAAAAAAAAAEAAAAAAQAAAADAA" +
		"AAAAACRlZHRzAAAAHGVsc3QAAAAAAAAAAQAAAPAAAAAAAAEAAAAAAcdtZGlhAAAAIG1kaGQAAAAAAAAAAAAAAAAAADIAAAAMAFXE" +
		"AAAAAAAtaGRscgAAAAAAAAAAdmlkZQAAAAAAAAAAAAAAAFZpZGVvSGFuZGxlcgAAAAFybWluZgAAABR2bWhkAAAAAQAAAAAAAAAA" +
		"AAAAJGRpbmYAAAAcZHJlZgAAAAAAAAABAAAADHVybCAAAAABAAABMnN0YmwAAACic3RzZAAAAAAAAAABAAAAkmF2MDEAAAAAAAAA" +
		"AQAAAAAAAAAAAAAAAAAAAAAAQAAwAEgAAABIAAAAAAAAAAEAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAY//8AAAAY" +
		"YXYxQ4EADAAKCgAAAAKv95tfMAgAAAAQcGFzcAAAAAEAAAABAAAAFGJ0cnQAAAAAAAA/aQAAP2kAAAAYc3R0cwAAAAAAAAABAAAA" +
		"BgAAAgAAAAAUc3RzcwAAAAAAAAABAAAAAQAAABxzdHNjAAAAAAAAAAEAAAABAAAABgAAAAEAAAAsc3RzegAAAAAAAAAAAAAABgAA" +
		"AWgAAAAUAAAAFAAAAC4AAAAVAAAAFAAAABRzdGNvAAAAAAAAAAEAAAAwAAAAYnVkdGEAAABabWV0YQAAAAAAAAAhaGRscgAAAAAA" +
		"AAAAbWRpcmFwcGwAAAAAAAAAAAAAAAAtaWxzdAAAACWpdG9vAAAAHWRhdGEAAAABAAAAAExhdmY2Mi4xMi4xMDM="

	// Decodes a base64 IVF file, one temporal unit per packet.
	def av1TestDecode(stream string) !VideoFrame[] {
		let ivf = try encoding.base64decode(stream)
		let dec = new AV1()
		try dec.configure(Track{index: 0, kind: TrackKind.Video, codec: "av1", config: byte[]})
		let frames = VideoFrame[]
		let p = int(ivf[6]) | (int(ivf[7]) << 8)
		for p + 12 <= ivf.len() {
			let size = int(ivf[p]) | (int(ivf[p + 1]) << 8) | (int(ivf[p + 2]) << 16) | (int(ivf[p + 3]) << 24)
			let got = try dec.decode(Packet{track: 0, data: ivf[p + 12:p + 12 + size]})
			for let f in got {
				frames.push(f)
			}
			p += 12 + size
		}
		for let f in try dec.flush() {
			frames.push(f)
		}
		return frames
	}

	// Whether the frames hash to `want`, in order.
	def av1TestMatches(frames VideoFrame[], want string[]) bool {
		return false when frames.len() != want.len()
		for let i = 0; i < frames.len(); i++ {
			let h = new hash.MD5()
			return false when encoding.hexencode(h.hash(frames[i].y + frames[i].u + frames[i].v)) != want[i]
		}
		return true
	}

	check "AV1" {
		@test()
		def TestAv1Main() {
			let frames = av1TestDecode(av1TestMain) onerror recover VideoFrame[]
			assert av1TestMatches(frames, av1TestMainMd5)
			assert frames[0].width == uint32(64) && frames[0].height == uint32(48)
			assert frames[0].bitDepth == 8 && frames[0].chroma == ChromaLayout.Yuv420
			assert frames[0].keyframe && !frames[1].keyframe
		}

		@test()
		def TestAv1High444() {
			let frames = av1TestDecode(av1TestHigh444) onerror recover VideoFrame[]
			assert av1TestMatches(frames, av1TestHigh444Md5)
			assert frames[0].bitDepth == 10 && frames[0].chroma == ChromaLayout.Yuv444
		}

		@test()
		def TestAv1Screen() {
			let frames = av1TestDecode(av1TestScreen) onerror recover VideoFrame[]
			assert av1TestMatches(frames, av1TestScreenMd5)
		}

		@test()
		def TestAv1SuperRes() {
			let frames = av1TestDecode(av1TestSuperRes) onerror recover VideoFrame[]
			assert av1TestMatches(frames, av1TestSuperResMd5)
			assert frames[0].width == uint32(64)
		}

		@test()
		def TestAv1FilmGrain() {
			let frames = av1TestDecode(av1TestFilmGrain) onerror recover VideoFrame[]
			assert av1TestMatches(frames, av1TestFilmGrainMd5)
		}

		@test()
		def TestAv1Monochrome() {
			let frames = av1TestDecode(av1TestMonochrome) onerror recover VideoFrame[]
			assert av1TestMatches(frames, av1TestMonochromeMd5)
			assert frames[0].chroma == ChromaLayout.Mono
		}

		@test()
		def TestAv1Mp4() !none {
			let data = try encoding.base64decode(av1TestMp4)
			let v = try open(data)
			let stream = try v.frames()
			let frames VideoFrame[]
			for {
				let got = try stream.next()
				break when got is none
				let f VideoFrame = got
				frames.push(f)
			}
			assert av1TestMatches(frames, av1TestMainMd5)
			assert v.info().codec == "av1"
			return none
		}

		@test()
		def TestAv1Truncated() {
			let ivf = encoding.base64decode(av1TestMain) onerror recover byte[]
			let dec = new AV1()
			let p = int(ivf[6]) | (int(ivf[7]) << 8)
			let size = int(ivf[p]) | (int(ivf[p + 1]) << 8)
			let failed = false
			dec.decode(Packet{track: 0, data: ivf[p + 12:p + 12 + size / 2]}) onerror (err error) {
				failed = true
				recover VideoFrame[]
			}
			assert failed
		}
	}
}
