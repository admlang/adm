internal partial module std.formats.video.av1 {
	// Reciprocals for the warp parameter divisions (dav1d warpmv.c).
	const av1DivLut = int[16384, 16320, 16257, 16194, 16132, 16070, 16009, 15948, 15888, 15828, 15768, 15709, 15650, 15592, 15534, 15477, 15420, 15364, 15308, 15252, 15197, 15142, 15087, 15033, 14980, 14926, 14873, 14821, 14769, 14717, 14665, 14614, 14564, 14513, 14463, 14413, 14364, 14315, 14266, 14218, 14170, 14122, 14075, 14028, 13981, 13935, 13888, 13843, 13797, 13752, 13707, 13662, 13618, 13574, 13530, 13487, 13443, 13400, 13358, 13315, 13273, 13231, 13190, 13148, 13107, 13066, 13026, 12985, 12945, 12906, 12866, 12827, 12788, 12749, 12710, 12672, 12633, 12596, 12558, 12520, 12483, 12446, 12409, 12373, 12336, 12300, 12264, 12228, 12193, 12157, 12122, 12087, 12053, 12018, 11984, 11950, 11916, 11882, 11848, 11815, 11782, 11749, 11716, 11683, 11651, 11619, 11586, 11555, 11523, 11491, 11460, 11429, 11398, 11367, 11336, 11305, 11275, 11245, 11215, 11185, 11155, 11125, 11096, 11067, 11038, 11009, 10980, 10951, 10923, 10894, 10866, 10838, 10810, 10782, 10755, 10727, 10700, 10673, 10645, 10618, 10592, 10565, 10538, 10512, 10486, 10460, 10434, 10408, 10382, 10356, 10331, 10305, 10280, 10255, 10230, 10205, 10180, 10156, 10131, 10107, 10082, 10058, 10034, 10010, 9986, 9963, 9939, 9916, 9892, 9869, 9846, 9823, 9800, 9777, 9754, 9732, 9709, 9687, 9664, 9642, 9620, 9598, 9576, 9554, 9533, 9511, 9489, 9468, 9447, 9425, 9404, 9383, 9362, 9341, 9321, 9300, 9279, 9259, 9239, 9218, 9198, 9178, 9158, 9138, 9118, 9098, 9079, 9059, 9039, 9020, 9001, 8981, 8962, 8943, 8924, 8905, 8886, 8867, 8849, 8830, 8812, 8793, 8775, 8756, 8738, 8720, 8702, 8684, 8666, 8648, 8630, 8613, 8595, 8577, 8560, 8542, 8525, 8508, 8490, 8473, 8456, 8439, 8422, 8405, 8389, 8372, 8355, 8339, 8322, 8306, 8289, 8273, 8257, 8240, 8224, 8208, 8192]

	def av1ApplySign(v int, s int) int {
		return s < 0 ?? (-v, v)
	}

	def av1Abs(v int) int {
		return v < 0 ?? (-v, v)
	}

	def av1ClipWmp(v int) int {
		let cv = v < -32768 ?? (-32768, v > 32767 ?? (32767, v))
		return av1ApplySign((av1Abs(cv) + 32) >> 6, cv) * 64
	}

	// A divisor's reciprocal from av1DivLut and its shift: returns
	// value * 64 + shift.
	def av1ResolveDivisor(d int) int {
		let shift = av1Log2(d)
		let e = d - (1 << shift)
		let f = shift > 8 ?? ((e + (1 << (shift - 9))) >> (shift - 8), e << (8 - shift))
		return av1DivLut[f] * 64 + shift + 14
	}

	// get_shear_params: alpha, beta, gamma, delta of the warp `m` into
	// `abcd`; false when the warp is invalid.
	def av1ShearParams(m int[], abcd int[]) bool {
		return false when m[2] <= 0
		abcd[0] = av1ClipWmp(m[2] - 0x10000)
		abcd[1] = av1ClipWmp(m[3])
		let r = av1ResolveDivisor(av1Abs(m[2]))
		let shift = r & 63
		let y = av1ApplySign(r >> 6, m[2])
		let v1 = (m[4] * 0x10000) * y
		let rnd = (1 << shift) >> 1
		abcd[2] = av1ClipWmp(av1ApplySign((av1Abs(v1) + rnd) >> shift, v1))
		let v2 = (m[3] * m[4]) * y
		abcd[3] = av1ClipWmp(m[5] - av1ApplySign((av1Abs(v2) + rnd) >> shift, v2) - 0x10000)
		return !(4 * av1Abs(abcd[0]) + 7 * av1Abs(abcd[1]) >= 0x10000 || 4 * av1Abs(abcd[2]) + 4 * av1Abs(abcd[3]) >= 0x10000)
	}

	def av1MultShift(px int, idet int, shift int, diag bool) int {
		let v1 = px * idet
		let v2 = av1ApplySign((av1Abs(v1) + ((1 << shift) >> 1)) >> shift, v1)
		return diag ?? ((v2 < 0xE001 ?? (0xE001, v2 > 0x11FFF ?? (0x11FFF, v2))), (v2 < -0x1FFF ?? (-0x1FFF, v2 > 0x1FFF ?? (0x1FFF, v2))))
	}

	def av1WarpTranslation(m int[], bw4 int, bh4 int, mvx int, mvy int, bx4 int, by4 int) {
		let isuy = by4 * 4 + 2 * bh4 - 1
		let isux = bx4 * 4 + 2 * bw4 - 1
		let a = mvx * 0x2000 - (isux * (m[2] - 0x10000) + isuy * m[3])
		let b = mvy * 0x2000 - (isux * m[4] + isuy * (m[5] - 0x10000))
		m[0] = a < -0x800000 ?? (-0x800000, a > 0x7FFFFF ?? (0x7FFFFF, a))
		m[1] = b < -0x800000 ?? (-0x800000, b > 0x7FFFFF ?? (0x7FFFFF, b))
	}

	// find_affine_int: the least-squares local warp from  sample
	// pairs (pts[i * 4 + 0..3] = source x, y, destination x, y); false when
	// singular.
	def av1FindAffine(pts int[], np int, bw4 int, bh4 int, mvx int, mvy int, m int[], bx4 int, by4 int) bool {
		let a00 = 0
		let a01 = 0
		let a11 = 0
		let bx0 = 0
		let bx1 = 0
		let by0 = 0
		let by1 = 0
		let rsuy = 2 * bh4 - 1
		let rsux = 2 * bw4 - 1
		let suy = rsuy * 8
		let sux = rsux * 8
		let duy = suy + mvy
		let dux = sux + mvx
		for let i = 0; i < np; i++ {
			let dx = pts[i * 4 + 2] - dux
			let dy = pts[i * 4 + 3] - duy
			let sx = pts[i * 4] - sux
			let sy = pts[i * 4 + 1] - suy
			if av1Abs(sx - dx) < 256 && av1Abs(sy - dy) < 256 {
				a00 += ((sx * sx) >> 2) + sx * 2 + 8
				a01 += ((sx * sy) >> 2) + sx + sy + 4
				a11 += ((sy * sy) >> 2) + sy * 2 + 8
				bx0 += ((sx * dx) >> 2) + sx + dx + 8
				bx1 += ((sy * dx) >> 2) + sy + dx + 4
				by0 += ((sx * dy) >> 2) + sx + dy + 4
				by1 += ((sy * dy) >> 2) + sy + dy + 8
			}
		}
		let det = a00 * a11 - a01 * a01
		return false when det == 0
		let r = av1ResolveDivisor(av1Abs(det))
		let shift = (r & 63) - 16
		let idet = av1ApplySign(r >> 6, det)
		if shift < 0 {
			idet = idet << -shift
			shift = 0
		}
		m[2] = av1MultShift(a11 * bx0 - a01 * bx1, idet, shift, true)
		m[3] = av1MultShift(a00 * bx1 - a01 * bx0, idet, shift, false)
		m[4] = av1MultShift(a11 * by0 - a01 * by1, idet, shift, false)
		m[5] = av1MultShift(a00 * by1 - a01 * by0, idet, shift, true)
		av1WarpTranslation(m, bw4, bh4, mvx, mvy, bx4, by4)
		return true
	}
}
