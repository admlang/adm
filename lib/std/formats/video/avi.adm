partial module std.formats.video {
	use (
		std.io
		std.formats.video.demux::*
		std.formats.media.source::*
		std.formats.video.riff::*
	)

	// AVI is the RIFF Audio Video Interleave container, OpenDML (AVI 2.0)
	// files over 1 GB included. Packets are the `##dc`/`##wb` chunks in
	// file order; keyframes and seeking come from the `idx1` or OpenDML
	// index, and without one every chunk counts as a keyframe.
	@codec("AVI")
	type AVI {
		mimeType string[] {
			def get() string[] {
				return string["video/x-msvideo", "video/avi", "video/msvideo"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".avi", ".divx"]
			}
		}

		// matchSignature reports whether the reader starts with a RIFF
		// header of form `AVI ` or `AVIX`.
		def matchSignature(r io.Reader) bool {
			let head byte[]
			head.len(12)
			let n = io.readFull(r, head) onerror recover 0
			return false when n != 12 || be(head, 0, 4) != riffRiff
			return be(head, 8, 4) := riffAvi || riffAvix
		}

		// open reads the header list and, when the reader can seek, the
		// index.
		//
		// Fails when the file is not AVI, it has no `movi` list, or the
		// reader fails.
		def open(reader io.Reader) !Container {
			let c = new AviContainer(new Source(reader))
			try c.read()
			return c
		}
	}
}
