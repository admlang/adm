internal partial module std.formats.video.riff {
	use (
		std.formats.video::*
		std.formats.video.demux::*
		std.formats.media.source::*
	)

	// Chunk and list identifiers, as their four bytes read big-endian.
	const (
		riffRiff = 0x52494646 // RIFF
		riffList = 0x4C495354 // LIST
		riffAvi  = 0x41564920 // "AVI "
		riffAvix = 0x41564958 // AVIX
		riffHdrl = 0x6864726C // hdrl
		riffStrl = 0x7374726C // strl
		riffStrh = 0x73747268 // strh
		riffStrf = 0x73747266 // strf
		riffStrn = 0x7374726E // strn
		riffIndx = 0x696E6478 // indx
		riffMovi = 0x6D6F7669 // movi
		riffRec  = 0x72656320 // "rec "
		riffIdx1 = 0x69647831 // idx1
		riffVids = 0x76696473 // vids
		riffAuds = 0x61756473 // auds
		riffTxts = 0x74787473 // txts
	)

	// One stream of an AVI file and how its chunks advance its clock.
	type AviStream {
		track      Track
		// The stream clock: `rate / scale` units per second, the unit a
		// frame, an audio block or, when `sampleSize` is set, that many
		// bytes.
		scale      int
		rate       int
		start      int
		sampleSize int
		blockAlign int
		// Units of the stream before the next chunk.
		units      int
		// File offsets of OpenDML standard index chunks.
		indexes    int[]

		def new() {}

		// The units one chunk of `size` bytes advances the clock by.
		def advance(size int) int {
			return 1 when sampleSize == 0
			let unit = blockAlign > sampleSize ?? (blockAlign, sampleSize)
			return size / sampleSize when unit == sampleSize
			return (size + unit - 1) / unit * unit / sampleSize
		}

		// The time of `units` units from the start.
		def time(units int) duration {
			return 0s when rate <= 0
			let v = (units + start) * scale
			return ticks(v, rate)
		}
	}

	// One chunk the index lists: where its header starts, its stream and
	// whether it is a keyframe.
	struct AviEntry {
		offset int
		stream int
		size   int
		key    bool
	}

	// The demultiplexer of an AVI file.
	type AviContainer {
		src     Source
		streams AviStream[]
		list    Track[]
		// File offset of the first chunk of the first `movi` list, and of
		// the byte after that list.
		moviAt  int
		moviEnd int
		// Index entries in file order, and keyframe flags by chunk offset.
		entries AviEntry[]
		keys    map<int, bool>
		indexed bool

		def new(src Source) {
			self.src = src
			keys = new map<int, bool>()
		}

		// Reads the RIFF header, the `hdrl` list and, when the source can
		// seek, the index; leaves the cursor at the first chunk of `movi`.
		//
		// Fails when the file is not AVI, it has no `movi` list, or the
		// reader fails.
		def read() !none {
			fail "avi: not a RIFF AVI file" when (try src.be(4)) != riffRiff
			let riffSize = try src.le(4)
			fail "avi: not a RIFF AVI file" when (try src.be(4)) != riffAvi
			let riffEnd = 8 + riffSize
			for {
				let at = src.position()
				fail "avi: the file has no movi list" when at + 8 > riffEnd || (try src.atEnd())
				let id = try src.be(4)
				let size = try src.le(4)
				if id == riffList {
					let kind = try src.be(4)
					if kind == riffMovi {
						moviAt = src.position()
						moviEnd = at + 8 + size
						break
					}
					if kind == riffHdrl {
						readHeaders(try src.read(size - 4))
					} else {
						try src.skip(size - 4 + (size & 1))
					}
				} else {
					try src.skip(size + (size & 1))
				}
			}
			if src.seekable() {
				try readIndex(riffEnd)
				try src.seek(moviAt)
			}
			return none
		}

		// Reads the `strl` lists of `hdrl`.
		def readHeaders(data byte[]) {
			let at = 0
			for at + 8 <= data.len() {
				let id = be(data, at, 4)
				let size = le(data, at + 4, 4)
				let body = at + 8
				readStream(data, body + 4, (body + size).min(data.len())) when id == riffList && be(data, body, 4) == riffStrl
				at = body + size + (size & 1)
			}
		}

		// Reads one `strl`: the stream header, its format and its OpenDML
		// super index.
		def readStream(data byte[], start int, end int) {
			let s = new AviStream()
			let t = newTrack(streams.len(), TrackKind.Data, "")
			let at = start
			let kind = 0
			let handler = 0
			for at + 8 <= end {
				let id = be(data, at, 4)
				let size = le(data, at + 4, 4)
				let body = at + 8
				let stop = (body + size).min(end)
				if id == riffStrh && size >= 36 {
					kind = be(data, body, 4)
					handler = be(data, body + 4, 4)
					s.scale = le(data, body + 20, 4)
					s.rate = le(data, body + 24, 4)
					s.start = le(data, body + 28, 4)
					let count = le(data, body + 32, 4)
					s.sampleSize = le(data, body + 44, 4)
					t.length = ticks(count * s.scale, s.rate) when s.rate > 0 && s.scale > 0
				} else if id == riffStrf {
					let format = data[body:stop].clone()
					if kind == riffVids && format.len() >= 40 {
						t.kind = TrackKind.Video
						t.width = uint32(le(format, 4, 4))
						let h = le(format, 8, 4)
						h -= 0x100000000 when h >= 0x80000000
						t.height = uint32(h < 0 ?? (-h, h))
						t.codec = bitmapCodec(be(format, 16, 4))
						t.codec = bitmapCodec(handler) when t.codec == ""
						t.config = format.len() > 40 ?? (format[40:].clone(), byte[])
					} else if kind == riffAuds && format.len() >= 16 {
						t.kind = TrackKind.Audio
						let tag = le(format, 0, 2)
						t.codec = waveCodecOf(format)
						t.channels = uint16(le(format, 2, 2))
						t.sampleRate = uint32(le(format, 4, 4))
						s.blockAlign = le(format, 12, 2)
						t.config = waveConfig(t.codec, format)
					}
				} else if id == riffIndx && size >= 24 {
					let per = le(data, body, 2)
					let count = le(data, body + 4, 4)
					let indexType = int(data[body + 3])
					if indexType == 0 && per == 4 {
						for let i = 0; i < count && body + 24 + (i + 1) * 16 <= stop; i++ {
							s.indexes.push(le(data, body + 24 + i * 16, 8))
						}
					}
				}
				at = body + size + (size & 1)
			}
			t.kind = TrackKind.Subtitle when kind == riffTxts
			if t.kind == TrackKind.Video && s.rate > 0 && s.scale > 0 {
				let g = gcd(s.rate, s.scale)
				t.frameRate = FrameRate{numerator: uint32(s.rate / g), denominator: uint32(s.scale / g)}
			}
			s.track = t
			streams.push(s)
			list.push(t)
		}

		// Reads the OpenDML indexes, or else `idx1`, into `entries` and
		// `keys`.
		//
		// Fails when the reader does.
		def readIndex(riffEnd int) !none {
			for let (n, s) in streams {
				for let (_, at) in s.indexes {
					try readStandardIndex(n, at)
				}
			}
			if entries.len() > 0 {
				entries = entries.sort((a, b AviEntry) => a.offset < b.offset)
				indexed = true
				return none
			}
			// idx1 follows the movi list inside the first RIFF.
			let at = moviEnd + (moviEnd & 1)
			for at + 8 <= riffEnd {
				try src.seek(at)
				let id = try src.be(4)
				let size = try src.le(4)
				if id == riffIdx1 {
					let data = try src.read(size)
					readLegacyIndex(data)
					break
				}
				at += 8 + size + (size & 1)
			}
			return none
		}

		// Reads one OpenDML standard index chunk of stream `n`.
		//
		// Fails when the reader does.
		def readStandardIndex(n int, at int) !none {
			try src.seek(at)
			try src.skip(4)
			let size = try src.le(4)
			let data = try src.read(size)
			return none when data.len() < 24
			let per = le(data, 0, 2)
			let count = le(data, 4, 4)
			let base = le(data, 12, 8)
			return none unless per == 2
			for let i = 0; i < count && 24 + (i + 1) * 8 <= data.len(); i++ {
				let offset = le(data, 24 + i * 8, 4)
				let raw = le(data, 28 + i * 8, 4)
				let header = base + offset - 8
				let key = raw & 0x80000000 == 0
				entries.push(AviEntry{offset: header, stream: n, size: raw & 0x7FFFFFFF, key: key})
				keys.set(header, key)
			}
			return none
		}

		// Reads `idx1`, whose offsets count from the `movi` identifier or,
		// in some files, from the start of the file.
		def readLegacyIndex(data byte[]) {
			let count = data.len() / 16
			return when count == 0
			let first = le(data, 8, 4)
			let base = first >= moviAt - 4 ?? (0, moviAt - 4)
			for let i = 0; i < count; i++ {
				let id = be(data, i * 16, 4)
				let n = chunkStream(id)
				continue when n < 0 || n >= streams.len()
				let flags = le(data, i * 16 + 4, 4)
				let offset = base + le(data, i * 16 + 8, 4)
				let key = flags & 0x10 != 0
				entries.push(AviEntry{offset: offset, stream: n, size: le(data, i * 16 + 12, 4), key: key})
				keys.set(offset, key)
			}
			indexed = entries.len() > 0
		}

		// name implements Described.
		def name() string {
			return "avi"
		}

		// seekable implements Seekable.
		def seekable() bool {
			return src.seekable() && indexed
		}

		// tracks implements Container.
		def tracks() Track[] {
			return list
		}

		// next implements Container: the next stream chunk, walking into
		// `rec ` lists and the `movi` lists of later `AVIX` parts. An empty
		// chunk advances its stream's clock without a packet.
		//
		// Fails when a chunk runs past the end of the file or the reader
		// fails.
		def next() !?Packet {
			for {
				let at = src.position()
				return none when try src.atEnd()
				let head = try src.peek(8)
				return none when head.len() < 8
				try src.skip(8)
				let id = be(head, 0, 4)
				let size = le(head, 4, 4)
				if id == riffList || id == riffRiff {
					let kind = try src.be(4)
					continue when kind := riffRec || riffMovi || riffAvix
					try src.skip(size - 4 + (size & 1))
					continue
				}
				let n = chunkStream(id)
				if n < 0 || n >= streams.len() || !isMedia(id) {
					try src.skip(size + (size & 1))
					continue
				}
				let s = streams[n]
				let data = try src.read(size)
				try src.skip(size & 1)
				let first = s.units
				s.units += s.advance(size)
				continue when size == 0
				let flagged = keys.get(at)
				let key = flagged is none ?? (true, flagged)
				let pts = s.time(first)
				return newPacket(n, data, pts, pts, s.time(s.units) - pts, key)
			}
			return none
		}

		// seek implements Container: to the last keyframe of the main video
		// stream at or before `time` in the index, with every stream's clock
		// set to what the chunks before it add up to.
		//
		// Fails when the file has no index, the source cannot seek, or the
		// reader fails.
		def seek(time duration) !none {
			fail "avi: the file cannot seek without an index" unless seekable()
			let main = 0
			for let (i, s) in streams {
				if s.track.kind == TrackKind.Video {
					main = i
					break
				}
			}
			let counts int[]
			counts.len(streams.len())
			let pick = -1
			let pickCounts int[]
			pickCounts.len(streams.len())
			for let (i, e) in entries {
				let s = streams[e.stream]
				if e.stream == main && e.key {
					break when s.time(counts[main]) > time
					pick = i
					counts.copy(pickCounts)
				}
				counts[e.stream] += s.advance(e.size)
			}
			let offset = pick < 0 ?? (moviAt, entries[pick].offset)
			for let (i, s) in streams {
				s.units = pick < 0 ?? (0, pickCounts[i])
			}
			try src.seek(offset)
			return none
		}

		// close implements io.Closer: closes the file.
		//
		// Fails when closing it does.
		def close() !none {
			return src.close()
		}
	}

	// The stream number the first two characters of a chunk id give, -1
	// when they are not digits.
	def chunkStream(id int) int {
		let hi = (id >> 24) & 0xFF
		let lo = (id >> 16) & 0xFF
		return -1 unless hi >= 0x30 && hi <= 0x39 && lo >= 0x30 && lo <= 0x39
		return (hi - 0x30) * 10 + lo - 0x30
	}

	// Whether the chunk id names media data: `dc`, `db`, `wb` or `tx`
	// rather than an index (`ix##`) or palette change (`pc`).
	def isMedia(id int) bool {
		let tail = id & 0xFFFF
		return tail := 0x6463 || 0x6462 || 0x7762 || 0x7478
	}
}
