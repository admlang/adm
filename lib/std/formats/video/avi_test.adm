partial module std.formats.video {
	use (
		std.testing
		std.bytes
		std.data.encoding
	)

	check "AVI" {
		@test()
		def TestAviTracks() !none {
			let c = try new AVI().open(new bytes.Reader(tinyAvi()))
			let tracks = c.tracks()
			assert tracks.len() == 2
			assert tracks[0].kind == TrackKind.Video && tracks[0].codec == "mpeg4"
			assert tracks[0].width == 64 && tracks[0].height == 48
			assert tracks[0].frameRate.numerator == 5 && tracks[0].frameRate.denominator == 1
			assert int64(tracks[0].length) == 1200000000
			assert tracks[1].kind == TrackKind.Audio && tracks[1].codec == "mp3"
			assert tracks[1].sampleRate == 8000 && tracks[1].channels == 1
		}

		@test()
		def TestAviPackets() !none {
			let c = try new AVI().open(new bytes.Reader(tinyAvi()))
			try testing.expectEqual("", try comparePackets(c, tinyAviPackets()))
		}

		@test()
		def TestAviSeek() !none {
			let c = try new AVI().open(new bytes.Reader(tinyAvi()))
			try c.seek(700ms)
			let p = try c.next()
			fail "no packet after the seek" when p is none
			let first Packet = p
			// Only the first frame is a keyframe; the two audio chunks
			// before it are passed over with their clock kept.
			assert first.track == 0 && first.keyframe && int64(first.pts) == 0
			let after = try c.next()
			fail "no packet after the keyframe" when after is none
			let audio Packet = after
			assert audio.track == 1 && int64(audio.pts) == 144000000
		}

		@test()
		def TestAviSound() !none {
			let (frames, peak) = try soundOf(tinyAvi())
			// Sixteen MPEG-2.5 frames of 576.
			try testing.expectEqual(9216, frames)
			assert peak > 0.1 && peak < 0.2
		}
	}

