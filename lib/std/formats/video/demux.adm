internal partial module std.formats.video.demux {
	use (
		std.formats.video::*
		std.formats.video.media.source::*
	)

	// What a container reports about itself beyond `Container`.
	interface Described {
		// Lowercase container name, as in `VideoInfo.container`.
		def name() string
	}

	// `value` ticks of a clock running at `rate` ticks per second.
	def ticks(value int, rate int) duration {
		return 0s when rate <= 0
		let whole = value / rate
		let part = value % rate
		return duration(int64(whole) * 1000000000 + int64(part) * 1000000000 / int64(rate))
	}

	// `time` in ticks of a clock running at `rate` ticks per second, rounded
	// down.
	def toTicks(time duration, rate int) int {
		let ns = int(int64(time))
		return (ns / 1000000000) * rate + (ns % 1000000000) * rate / 1000000000
	}

	// A track with every field at its zero value but those given.
	def newTrack(index int, kind TrackKind, codec string) Track {
		return Track{
			index:       index,
			kind:        kind,
			codec:       codec,
			language:    "",
			length:      0s,
			config:      byte[],
			width:       uint32(0),
			height:      uint32(0),
			sampleRate:  uint32(0),
			channels:    uint16(0),
			frameRate:   FrameRate{numerator: uint32(0), denominator: uint32(1)},
			rotation:    0,
			pixelAspect: 1.0,
		}
	}

	// A packet of the track.
	def newPacket(track int, data byte[], pts duration, dts duration, length duration, keyframe bool) Packet {
		return Packet{track: track, data: data, pts: pts, dts: dts, length: length, keyframe: keyframe}
	}

	// The codec name of PCM samples of `bits` bits, integer or `float`,
	// big-endian when `big`, as ffmpeg names them (`pcm_u8`, `pcm_s16le`,
	// `pcm_s24be`, `pcm_f32le`); 8-bit samples are unsigned.
	def pcmCodec(bits int, float bool, big bool) string {
		let end = big ?? ("be", "le")
		if float {
			return "pcm_f{bits}{end}" when bits := 32 || 64
			return "pcm"
		}
		return "pcm_u8" when bits == 8
		return "pcm_s{bits}{end}" when bits := 16 || 24 || 32
		return "pcm"
	}

	// The codec name a whole WAVEFORMATEX gives a track: the format tag's,
	// PCM named by its sample size and type (WAVE_FORMAT_EXTENSIBLE by its
	// sub-format).
	def waveCodecOf(format byte[]) string {
		return "" when format.len() < 2
		let tag = le(format, 0, 2)
		let bits = 0
		bits = le(format, 14, 2) when format.len() >= 16
		tag = le(format, 24, 2) when tag == 0xFFFE && format.len() >= 26
		return pcmCodec(bits, false, false) when tag == 0x0001
		return pcmCodec(bits, true, false) when tag == 0x0003
		return waveCodec(tag)
	}

	// The codec name of a WAVEFORMATEX format tag, as AVI, ASF and
	// Matroska's A_MS/ACM store it; empty for one this module does not name.
	def waveCodec(tag int) string {
		return "pcm" when tag := 0x0001 || 0x0003 || 0xFFFE
		return "mp2" when tag == 0x0050
		return "mp3" when tag == 0x0055
		return "amr" when tag == 0x0057
		return "amr-wb" when tag == 0x0058
		return "aac" when tag := 0x00FF || 0x1600 || 0x706D
		return "wmav1" when tag == 0x0160
		return "wmav2" when tag == 0x0161
		return "wmapro" when tag == 0x0162
		return "ac3" when tag == 0x2000
		return "vorbis" when tag := 0x674F || 0x6750 || 0x6751 || 0x676F || 0x6770 || 0x6771
		return "flac" when tag == 0xF1AC
		return "adpcm" when tag := 0x0002 || 0x0011
		return ""
	}

	// The configuration a WAVEFORMATEX gives a track: for AAC the
	// AudioSpecificConfig in its codec-specific bytes, otherwise the whole
	// structure, which is what the WMA decoder reads.
	def waveConfig(codec string, format byte[]) byte[] {
		return format unless codec == "aac"
		return byte[] when format.len() <= 18
		let extra = le(format, 16, 2).min(format.len() - 18)
		return format[18:18 + extra].clone()
	}

	// The codec name of a video FourCC as AVI's BITMAPINFOHEADER and ASF
	// store it, big-endian as read; empty for one this module does not name.
	def bitmapCodec(code int) string {
		let name = fourcc(code).lower()
		return "h264" when name := "h264" || "x264" || "avc1" || "davc" || "smv2"
		return "hevc" when name := "hevc" || "hvc1" || "h265" || "x265"
		return "mpeg4" when name := "xvid" || "divx" || "dx50" || "fmp4" || "mp4v" || "3iv2" || "m4s2"
		return "msmpeg4v1" when name == "mpg4"
		return "msmpeg4v2" when name == "mp42"
		return "msmpeg4v3" when name := "mp43" || "div3" || "div4"
		return "wmv1" when name == "wmv1"
		return "wmv2" when name == "wmv2"
		return "wmv3" when name == "wmv3"
		return "vc1" when name == "wvc1"
		return "mjpeg" when name := "mjpg" || "jpeg"
		return "mpeg1" when name == "mpg1"
		return "mpeg2" when name := "mpg2" || "mpeg"
		return "vp8" when name == "vp80"
		return "vp9" when name == "vp90"
		return "av1" when name == "av01"
		return "h263" when name == "h263"
		return "rawvideo" when code == 0
		return ""
	}

	// The greatest common divisor of two positive numbers, 1 when both are
	// zero.
	def gcd(a int, b int) int {
		let x = a
		let y = b
		for y != 0 {
			let t = x % y
			x = y
			y = t
		}
		return x == 0 ?? (1, x)
	}

	// Below this span of bytes a seek scans forward instead of bisecting.
	const seekScanBytes = 1 << 20

	// The first keyframe a probe found after an offset: its time and the
	// offset to resume reading it from.
	struct KeyProbe {
		found bool
		time  duration
		at    int
	}

	// The offset of a file without an index from which a forward scan finds
	// the last keyframe at or before `time`: bisection on byte offsets.
	// `probe(from, limit)` resyncs at `from` and reads up to `limit` for the
	// first keyframe of the main track (any packet with a time for a file
	// without video). Keyframe times grow through the file, so a keyframe
	// after `time` found past an offset puts the target before it.
	//
	// Fails when a probe does.
	def bisectSeek(size int, time duration, probe def(int, int) !KeyProbe) !int {
		let lo = 0
		let hi = size
		for hi - lo > seekScanBytes {
			let mid = lo + (hi - lo) / 2
			let key = try probe(mid, hi)
			if !key.found || key.time > time || key.at >= hi || key.at <= lo {
				hi = mid
			} else {
				lo = key.at
			}
		}
		return lo
	}
}
