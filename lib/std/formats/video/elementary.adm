partial module std.formats.video {
	use (
		std.io
		std.formats.video.demux::*
		std.formats.video.media.source::*
		std.formats.video.elementary::*
	)

	// ElementaryStream is a video stream with no container around it: H.264
	// or HEVC in Annex B byte stream form, MPEG-1/2 video or MPEG-4 Part 2
	// video,
	// one track. Packets are whole pictures (a field each for MPEG-2 field
	// pictures). The stream carries no timestamps, so every picture follows
	// the previous one by the frame period the stream declares (25 frames a
	// second when it declares none), and the length is unknown. Seeking
	// reads the stream from the start.
	@codec("ES")
	type ElementaryStream {
		mimeType string[] {
			def get() string[] {
				return string["video/h264", "video/h265", "video/mpv", "video/mp4v-es"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".h264", ".264", ".avc", ".26l", ".jsv", ".h265", ".265", ".hevc", ".m2v", ".m1v", ".mpv", ".cmp"]
			}
		}

		// matchSignature reports whether the reader starts with the start
		// code of an H.264, HEVC, MPEG-1/2 or MPEG-4 Part 2 stream.
		def matchSignature(r io.Reader) bool {
			let head byte[]
			head.len(64)
			let n = io.readFull(r, head) onerror (err error) {
				recover 0
			}
			return esCodec(head[:n]) != ""
		}

		// open reads the stream's first picture and its headers, which the
		// track is learnt from.
		//
		// Fails when the stream is none of these, or the reader fails.
		def open(reader io.Reader) !Container {
			let c = new EsContainer(new Source(reader))
			try c.read()
			return c
		}
	}
}
