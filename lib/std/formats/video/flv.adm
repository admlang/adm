partial module std.formats.video {
	use (
		std.io
		std.formats.video.demux::*
		std.formats.video.media.source::*
		std.formats.video.flash::*
	)

	// FLV is the Flash Video container: H.264 (and, in enhanced FLV, HEVC,
	// AV1 and VP9), Sorenson H.263 and VP6 video; AAC, MP3, PCM and other
	// audio. The AVC and AAC sequence headers become the tracks' `config`
	// instead of packets. Seeking reads the tag headers from the start.
	@codec("FLV")
	type FLV {
		mimeType string[] {
			def get() string[] {
				return string["video/x-flv", "video/flv"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".flv", ".f4v"]
			}
		}

		// matchSignature reports whether the reader starts with `FLV` and
		// version 1.
		def matchSignature(r io.Reader) bool {
			let head byte[]
			head.len(4)
			let n = io.readFull(r, head) onerror recover 0
			return n == 4 && be(head, 0, 3) == 0x464C56 && head[3] == 1
		}

		// open reads the header, the metadata and the first tags of each
		// stream, which the tracks are learnt from.
		//
		// Fails when the file is not FLV, or the reader fails.
		def open(reader io.Reader) !Container {
			let c = new FlvContainer(new Source(reader))
			try c.read()
			return c
		}
	}
}
