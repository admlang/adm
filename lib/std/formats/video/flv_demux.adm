internal partial module std.formats.video.flash {
	use (
		std.formats.video::*
		std.formats.video.demux::*
		std.formats.media.source::*
	)

	// Tags read ahead while the tracks are learnt, at most.
	const flvProbeTags = 64

	// The codec name of an FLV video codec id.
	def flvVideoCodec(id int) string {
		return "flv1" when id == 2
		return "flashsv" when id == 3
		return "vp6f" when id == 4
		return "vp6a" when id == 5
		return "flashsv2" when id == 6
		return "h264" when id == 7
		return "hevc" when id == 12
		return ""
	}

	// The codec name of an enhanced FLV video FourCC.
	def flvFourcc(code int) string {
		let name = fourcc(code)
		return "h264" when name == "avc1"
		return "hevc" when name == "hvc1"
		return "av1" when name == "av01"
		return "vp9" when name == "vp09"
		return "vp8" when name == "vp08"
		return ""
	}

	// The codec name of an FLV sound format; `wide` is the sound size flag
	// (16-bit rather than 8-bit samples).
	def flvAudioCodec(format int, wide bool) string {
		return (wide ?? ("pcm_s16le", "pcm_u8")) when format := 0 || 3
		return "adpcm" when format == 1
		return "mp3" when format := 2 || 14
		return "nellymoser" when format >= 4 && format <= 6
		return "pcm_alaw" when format == 7
		return "pcm_mulaw" when format == 8
		return "aac" when format == 10
		return "speex" when format == 11
		return ""
	}

	// The demultiplexer of an FLV file.
	type FlvContainer {
		src        Source
		list       Track[]
		// Track indexes of the video and audio streams, -1 when absent.
		video      int
		audio      int
		// Packets read while learning the tracks, still to return.
		held       Packet[]
		heldAt     int
		// File offset of the first tag.
		firstTag   int
		// The duration and frame rate onMetaData gives.
		metaLength duration
		metaRate   float64
		metaWidth  int
		metaHeight int
		// Packets presenting before this time are dropped: a seek target.
		dropBefore duration
		dropping   bool

		def new(src Source) {
			self.src = src
			video = -1
			audio = -1
		}

		// Reads the header and the tags up to the first packet of every
		// stream the header announces.
		//
		// Fails when the file is not FLV or the reader fails.
		def read() !none {
			let head = try src.read(9)
			fail "flv: not an FLV file" unless be(head, 0, 3) == 0x464C56
			let flags = int(head[4])
			let size = be(head, 5, 4)
			try src.skip(size - 9 + 4)
			firstTag = src.position()
			let wantVideo = flags & 1 != 0
			let wantAudio = flags & 4 != 0
			for let i = 0; i < flvProbeTags; i++ {
				break when (video >= 0 || !wantVideo) && (audio >= 0 || !wantAudio) && held.len() > 0
				let got = try readTag()
				break when got is none
				let p Packet = got
				held.push(p) when p.track >= 0
			}
			for let (_, t) in list {
				t.length = metaLength
				if t.kind == TrackKind.Video {
					t.width = uint32(metaWidth) when t.width == 0
					t.height = uint32(metaHeight) when t.height == 0
					if metaRate > 0.0 {
						let scaled = int(metaRate * 1000.0 + 0.5)
						let g = gcd(scaled, 1000)
						t.frameRate = FrameRate{numerator: uint32(scaled / g), denominator: uint32(1000 / g)}
					}
				}
			}
			return none
		}

		// The track of the kind, made on first sight; video comes first.
		def trackOf(kind TrackKind, codec string) Track {
			let at = kind == TrackKind.Video ?? (video, audio)
			return list[at] when at >= 0
			let t = newTrack(list.len(), kind, codec)
			t.length = metaLength
			list.push(t)
			if kind == TrackKind.Video {
				video = t.index
			} else {
				audio = t.index
			}
			return t
		}

		// Reads the next tag: a packet, a packet of track -1 for a tag that
		// holds none (metadata, sequence headers), none at the end.
		//
		// Fails when a tag runs past the end of the file or the reader
		// fails.
		def readTag() !?Packet {
			let header = try src.peek(11)
			return none when header.len() < 11
			try src.skip(11)
			let kind = int(header[0]) & 0x1F
			let size = be(header, 1, 3)
			let time = be(header, 4, 3) | int(header[7]) << 24
			let body = try src.read(size)
			try src.skip(4)
			let ts = duration(int64(time) * 1000000)
			let nothing = newPacket(-1, byte[], ts, ts, 0s, false)
			return nothing when size == 0
			if kind == 18 {
				readMetadata(body)
				return nothing
			}
			if kind == 9 {
				let first = int(body[0])
				if first & 0x80 != 0 && body.len() >= 5 {
					// Enhanced FLV: packet type and FourCC.
					let packetType = first & 0x0F
					let t = trackOf(TrackKind.Video, flvFourcc(be(body, 1, 4)))
					if packetType == 0 {
						t.config = body[5:].clone()
						return nothing
					}
					return nothing unless packetType := 1 || 3
					let at = 5
					let shift = 0
					if packetType == 1 && (t.codec := "h264" || "hevc") {
						shift = be(body, 5, 3)
						shift -= 0x1000000 when shift >= 0x800000
						at = 8
					}
					let key = (first >> 4) & 7 == 1
					let pts = duration(int64(time + shift) * 1000000)
					return newPacket(t.index, body[at:].clone(), pts, ts, 0s, key)
				}
				let frameType = first >> 4
				let codecId = first & 0x0F
				return nothing when frameType == 5
				let t = trackOf(TrackKind.Video, flvVideoCodec(codecId))
				let key = frameType := 1 || 4
				if codecId := 7 || 12 {
					return nothing when body.len() < 5
					let packetType = int(body[1])
					let shift = be(body, 2, 3)
					shift -= 0x1000000 when shift >= 0x800000
					if packetType == 0 {
						t.config = body[5:].clone()
						return nothing
					}
					return nothing unless packetType == 1
					let pts = duration(int64(time + shift) * 1000000)
					return newPacket(t.index, body[5:].clone(), pts, ts, 0s, key)
				}
				let skip = (codecId := 4 || 5) ?? (2, 1)
				return nothing when body.len() <= skip
				return newPacket(t.index, body[skip:].clone(), ts, ts, 0s, key)
			}
			if kind == 8 {
				let first = int(body[0])
				let format = first >> 4
				let t = trackOf(TrackKind.Audio, flvAudioCodec(format, (first & 2) != 0))
				if t.sampleRate == 0 {
					let rates = int[5512, 11025, 22050, 44100]
					t.sampleRate = uint32(rates[(first >> 2) & 3])
					t.sampleRate = uint32(8000) when format := 5 || 7 || 8 || 14
					t.sampleRate = uint32(16000) when format := 4 || 11
					t.channels = uint16((first & 1) + 1)
				}
				if format == 10 {
					return nothing when body.len() < 2
					if int(body[1]) == 0 {
						t.config = body[2:].clone()
						readAacFormat(t)
						return nothing
					}
					return newPacket(t.index, body[2:].clone(), ts, ts, 0s, true)
				}
				return newPacket(t.index, body[1:].clone(), ts, ts, 0s, true)
			}
			return nothing
		}

		// Takes the rate and channels from an AudioSpecificConfig, which
		// the tag's own fields cannot express above 44.1 kHz.
		def readAacFormat(t Track) {
			return when t.config.len() < 2
			let rates = int[96000, 88200, 64000, 48000, 44100, 32000, 24000, 22050, 16000, 12000, 11025, 8000, 7350]
			let v = be(t.config, 0, 2)
			let index = (v >> 7) & 0xF
			t.sampleRate = uint32(rates[index]) when index < 13
			let channels = (v >> 3) & 0xF
			t.channels = uint16(channels) when channels > 0 && channels < 8
		}

		// Reads the numbers onMetaData gives: duration, width, height and
		// frame rate.
		def readMetadata(data byte[]) {
			let r = new AmfReader(data)
			r.value()
			return unless r.text == "onMetaData"
			let kind = r.u8()
			return unless kind := 3 || 8
			r.at += 4 when kind == 8
			for r.at + 3 <= data.len() {
				let key = r.key()
				break when key == ""
				r.value()
				if key == "duration" {
					metaLength = duration(int64(r.number * 1000000000.0))
				} else if key == "width" {
					metaWidth = int(r.number)
				} else if key == "height" {
					metaHeight = int(r.number)
				} else if key == "framerate" {
					metaRate = r.number
				}
			}
		}

		// name implements Described.
		def name() string {
			return "flv"
		}

		// seekable implements Seekable.
		def seekable() bool {
			return src.seekable()
		}

		// tracks implements Container.
		def tracks() Track[] {
			return list
		}

		// next implements Container.
		//
		// Fails when a tag runs past the end of the file or the reader
		// fails.
		def next() !?Packet {
			for {
				let p = try pull()
				return none when p is none
				let got Packet = p
				continue when got.track < 0
				continue when dropping && got.pts < dropBefore
				dropping = false when got.track == video
				return got
			}
			return none
		}

		// The next packet read ahead, else the next tag's.
		//
		// Fails when the tag does.
		def pull() !?Packet {
			return readTag() when heldAt >= held.len()
			let p = held[heldAt]
			heldAt++
			return p
		}

		// seek implements Container: finds the last video keyframe at or
		// before `time` (bisecting on byte offsets in large files, then
		// reading tag headers forward), and drops the packets that present
		// before it.
		//
		// Fails when the source cannot seek or the reader fails.
		def seek(time duration) !none {
			fail "flv: the stream cannot seek" unless src.seekable()
			let from = firstTag
			from = (try bisectSeek(src.size(), time, (at int, limit int) => probeKey(at, limit))).max(firstTag) when src.size() > seekScanBytes
			held = Packet[]
			heldAt = 0
			try src.seek(from)
			let pick = from
			let pickTime = 0s
			for {
				let at = src.position()
				let header = try src.peek(12)
				break when header.len() < 12
				let kind = int(header[0]) & 0x1F
				let size = be(header, 1, 3)
				let ms = be(header, 4, 3) | int(header[7]) << 24
				let t = duration(int64(ms) * 1000000)
				break when t > time && (video >= 0 || kind == 8)
				if flvKey(header) || video < 0 && kind == 8 {
					pick = at
					pickTime = t
				}
				try src.skip(11 + size + 4)
			}
			try src.seek(pick)
			dropBefore = pickTime
			dropping = pickTime > 0s
			return none
		}

		// The first video keyframe (any audio tag when there is no video)
		// from the first whole tag at or after `from`, reading no further
		// than `limit`. A tag counts as found when the size after it matches
		// its own.
		//
		// Fails when the reader does.
		def probeKey(from int, limit int) !KeyProbe {
			let missing = KeyProbe{found: false, time: 0s, at: 0}
			try src.seek(from)
			for {
				return missing when src.position() >= limit
				let at = src.position()
				let header = try src.peek(12)
				return missing when header.len() < 12
				let kind = int(header[0])
				let size = be(header, 1, 3)
				if kind := 8 || 9 || 18 {
					if be(header, 8, 3) == 0 && at + 15 + size <= src.size() {
						let back = try src.bytesAt(at + 11 + size, 4)
						break when be(back, 0, 4) == 11 + size
					}
				}
				try src.skip(1)
			}
			for src.position() < limit {
				let at = src.position()
				let header = try src.peek(12)
				break when header.len() < 12
				let kind = int(header[0]) & 0x1F
				if flvKey(header) || video < 0 && kind == 8 {
					let ms = be(header, 4, 3) | int(header[7]) << 24
					return KeyProbe{found: true, time: duration(int64(ms) * 1000000), at: at}
				}
				try src.skip(11 + be(header, 1, 3) + 4)
			}
			return missing
		}

		// close implements io.Closer: closes the file.
		//
		// Fails when closing it does.
		def close() !none {
			return src.close()
		}
	}

	// Reads AMF0 values: numbers, booleans, strings, and the keys of
	// objects and ECMA arrays; other values are passed over.
	type AmfReader {
		data   byte[]
		at     int
		// The last number or string read.
		number float64
		text   string

		def new(data byte[]) {
			self.data = data
		}

		// The next byte, 0 past the end.
		def u8() int {
			return 0 when at >= data.len()
			let v = int(data[at])
			at++
			return v
		}

		// An object key: a 2-byte length and its text; empty at the object
		// end marker.
		def key() string {
			let n = be(data, at, 2)
			at += 2
			let stop = (at + n).min(data.len())
			let k = string(data[at:stop])
			at = stop
			return k
		}

		// Reads one value, leaving numbers in `number` and strings in
		// `text`. Returns its AMF type.
		def value() int {
			let kind = u8()
			if kind == 0 {
				number = __bitcast_f64_from_u64(uint64(be(data, at, 8)))
				at += 8
			} else if kind == 1 {
				number = u8() != 0 ?? (float64(1.0), float64(0.0))
			} else if kind == 2 {
				text = key()
			} else if kind := 3 || 8 {
				at += 4 when kind == 8
				for at + 3 <= data.len() {
					let k = key()
					if k == "" {
						at++
						break
					}
					value()
				}
			} else if kind == 10 {
				let count = be(data, at, 4)
				at += 4
				for let i = 0; i < count && at < data.len(); i++ {
					value()
				}
			} else if kind == 11 {
				at += 10
			} else if kind == 12 {
				let n = be(data, at, 4)
				at += 4 + n
			}
			return kind
		}
	}

	// Whether the tag whose first 12 bytes are `header` is a video
	// keyframe.
	def flvKey(header byte[]) bool {
		let first = int(header[11])
		return int(header[0]) & 0x1F == 9 && ((first & 0x80 != 0) ?? ((first >> 4) & 7 == 1, (first >> 4 := 1 || 4)))
	}
}
