partial module std.formats.video {
	use (
		std.testing
		std.bytes
		std.data.encoding
	)

	check "FLV" {
		@test()
		def TestFlvTracks() !none {
			let c = try new FLV().open(new bytes.Reader(tinyFlv()))
			let tracks = c.tracks()
			assert tracks.len() == 2
			assert tracks[0].kind == TrackKind.Video && tracks[0].codec == "h264"
			assert tracks[0].width == 64 && tracks[0].height == 48
			assert tracks[0].frameRate.numerator == 5 && tracks[0].frameRate.denominator == 1
			assert tracks[0].config.len() > 8 && tracks[0].config[0] == 1
			assert tracks[1].kind == TrackKind.Audio && tracks[1].codec == "aac"
			assert tracks[1].sampleRate == 8000 && tracks[1].channels == 1
			assert tracks[1].config.len() >= 2 && tracks[1].config[0] == 0x15
		}

		@test()
		def TestFlvPackets() !none {
			let c = try new FLV().open(new bytes.Reader(tinyFlv()))
			try testing.expectEqual("", try comparePackets(c, tinyFlvPackets(), 1000))
		}

		@test()
		def TestFlvSeek() !none {
			let c = try new FLV().open(new bytes.Reader(tinyFlv()))
			try c.seek(900ms)
			let p = try c.next()
			fail "no packet after the seek" when p is none
			let first Packet = p
			assert first.track == 0 && first.keyframe && int64(first.pts) == 128000000
		}

		@test()
		def TestFlvSound() !none {
			let (frames, peak) = try soundOf(tinyFlv())
			try testing.expectEqual(9216, frames)
			assert peak > 0.1 && peak < 0.2
		}
	}

