partial module std.formats.video {
	use (
		std.gfx
		std.gfx.processing.transform::(FitMode)
		std.formats.image
		std.formats.video.loader::*
	)

	// The picture as an RGBA image, converting its YUV values by its colour
	// matrix (BT.601 or BT.709), range and bit depth. A picture on the GPU is
	// downloaded first (`download`); one the GPU cannot give back comes out
	// black.
	def toImage(frame VideoFrame) image.Image {
		let w = int(frame.width)
		let h = int(frame.height)
		let img = new image.Image(w, h)
		download(frame) onerror recover none
		return img when frame.onGpu
		let out = img.raw()
		let stride = img.stride()
		let c = new RgbConverter(frame)
		for let row = 0; row < h; row++ {
			let yAt = row * c.yStride
			let cAt = (row >> c.shiftY) * c.cStride
			let o = row * stride
			for let col = 0; col < w; col++ {
				let luma = c.at(frame.y, yAt + col)
				let u = 128
				let v = 128
				if !c.mono {
					u = c.at(frame.u, cAt + (col >> c.shiftX))
					v = c.at(frame.v, cAt + (col >> c.shiftX))
				}
				c.put(out, o, luma, u, v)
				o += 4
			}
		}
		return img
	}

	// Draws the picture into `canvas`, converting it as `toImage` does and
	// placing it as `transform.fit` would: Contain and ScaleToFit show it
	// whole between black bars, Cover, ScaleToFill and SmartCrop fill the
	// canvas and crop it, Stretch fills the canvas by distorting it,
	// FitWidth and FitHeight scale it to one side, CenterCrop keeps its size
	// and Tile repeats it from the top-left corner. Scaled pictures are
	// sampled bilinearly. A picture on the GPU is downloaded first; one the
	// GPU cannot give back is not drawn.
	def draw(frame VideoFrame, canvas gfx.Raster, fit = FitMode.Contain) {
		download(frame) onerror recover none
		return when frame.onGpu
		let w = int(frame.width)
		let h = int(frame.height)
		let cw = int(canvas.size().width)
		let ch = int(canvas.size().height)
		return when w == 0 || h == 0 || cw == 0 || ch == 0
		let (dw, dh) = fittedSize(w, h, cw, ch, fit)
		let tile = fit == FitMode.Tile
		let left = tile ?? (0, (cw - dw) / 2)
		let top = tile ?? (0, (ch - dh) / 2)
		let c = new RgbConverter(frame)
		let chromaW = (w + (1 << c.shiftX) - 1) >> c.shiftX
		let chromaH = (h + (1 << c.shiftY) - 1) >> c.shiftY
		// Per canvas column: the luma and chroma source columns and weights
		// of the right-hand neighbour in 1/256; -1 outside the picture.
		let lx = int[]
		lx.len(cw)
		let lf = int[]
		lf.len(cw)
		let px = int[]
		px.len(cw)
		let pf = int[]
		pf.len(cw)
		for let x = 0; x < cw; x++ {
			let u = x - left
			u = ((u % dw) + dw) % dw when tile
			if u < 0 || u >= dw {
				lx[x] = -1
				continue
			}
			let (a, af) = sourceAt(u, dw, w)
			lx[x] = a
			lf[x] = af
			let (b, bf) = sourceAt(u, dw, chromaW)
			px[x] = b
			pf[x] = bf
		}
		let out = canvas.raw()
		let stride = canvas.stride()
		// Source rows interpolated across, per canvas column, in 1/256: the
		// two luma rows and two rows of each chroma plane the current canvas
		// row blends, kept while the next canvas rows blend the same ones.
		let rows = new ScaledRows(cw)
		// The conversion factors, as `RgbConverter.put` uses them.
		let ys = c.ys
		let yOff = c.yOff
		let rv = c.rv
		let gu = c.gu
		let gv = c.gv
		let bu = c.bu
		for let y = 0; y < ch; y++ {
			let o = y * stride
			let v = y - top
			v = ((v % dh) + dh) % dh when tile
			if v < 0 || v >= dh {
				for let x = 0; x < cw; x++ {
					c.black(out, o + x * 4)
				}
				continue
			}
			let (ly, lyf) = sourceAt(v, dh, h)
			rows.luma(c, frame.y, ly, (ly + 1).min(h - 1), lx, lf, w)
			let (cy, cyf) = sourceAt(v, dh, chromaH)
			if !c.mono {
				rows.chroma(c, frame.u, frame.v, cy, (cy + 1).min(chromaH - 1), px, pf, chromaW)
			}
			let l0 = rows.l0
			let l1 = rows.l1
			let u0 = rows.u0
			let u1 = rows.u1
			let v0 = rows.v0
			let v1 = rows.v1
			let mono = c.mono
			for let x = 0; x < cw; x++ {
				let at = o + x * 4
				if lx[x] < 0 {
					out[at] = byte(0)
					out[at + 1] = byte(0)
					out[at + 2] = byte(0)
					out[at + 3] = byte(255)
					continue
				}
				let l = (((l0[x] * 256 + (l1[x] - l0[x]) * lyf + 32768) >> 16) - yOff) * ys + 32768
				let cu = 0
				let cv = 0
				if !mono {
					cu = ((u0[x] * 256 + (u1[x] - u0[x]) * cyf + 32768) >> 16) - 128
					cv = ((v0[x] * 256 + (v1[x] - v0[x]) * cyf + 32768) >> 16) - 128
				}
				out[at] = byte(clip8((l + rv * cv) >> 16))
				out[at + 1] = byte(clip8((l - gu * cu - gv * cv) >> 16))
				out[at + 2] = byte(clip8((l + bu * cu) >> 16))
				out[at + 3] = byte(255)
			}
		}
	}

	// The size a `w` x `h` picture is drawn at in a `cw` x `ch` area by
	// `draw` and `DrawContext.drawVideo` with `fit`, centred there (Tile
	// repeats it at its own size instead).
	def fittedSize(w int, h int, cw int, ch int, fit FitMode) (int, int) {
		let sx = float64(cw) / float64(w)
		let sy = float64(ch) / float64(h)
		let s float64 = 1.0
		match fit {
			case FitMode.Stretch:
				return (cw, ch)
			case FitMode.Cover, FitMode.ScaleToFill, FitMode.SmartCrop:
				s = sx.max(sy)
			case FitMode.Contain, FitMode.ScaleToFit:
				s = sx.min(sy)
			case FitMode.FitWidth:
				s = sx
			case FitMode.FitHeight:
				s = sy
		}
		return (int((float64(w) * s).round()).max(1), int((float64(h) * s).round()).max(1))
	}
}

internal partial module std.formats.video.loader {
	use (
		std.gfx.processing.transform::(FitMode)
		std.formats.video::*
	)

	// Source rows of a frame interpolated across to the canvas columns, in
	// 1/256 of a sample, for the rows a canvas row blends: two of luma, two
	// of each chroma plane. A row is computed again only when another
	// source row is asked for.
	type ScaledRows {
		l0     int[]
		l1     int[]
		u0     int[]
		u1     int[]
		v0     int[]
		v1     int[]
		// Source rows now held, -1 for none.
		lRows  int[]
		cRows  int[]

		def new(width int) {
			l0 = zeros(width)
			l1 = zeros(width)
			u0 = zeros(width)
			u1 = zeros(width)
			v0 = zeros(width)
			v1 = zeros(width)
			lRows = int[-1, -1]
			cRows = int[-1, -1]
		}

		// Makes l0 and l1 luma rows `r0` and `r1`.
		def luma(c RgbConverter, plane byte[], r0 int, r1 int, xs int[], fs int[], w int) {
			return when lRows[0] == r0 && lRows[1] == r1
			if lRows[1] == r0 && r0 != r1 {
				// Moving down one row: the lower row becomes the upper.
				let t = l0
				l0 = l1
				l1 = t
			} else {
				across(c, plane, c.yStride, r0, xs, fs, w, l0)
			}
			across(c, plane, c.yStride, r1, xs, fs, w, l1)
			lRows[0] = r0
			lRows[1] = r1
		}

		// Makes u0, u1, v0 and v1 chroma rows `r0` and `r1`.
		def chroma(c RgbConverter, u byte[], v byte[], r0 int, r1 int, xs int[], fs int[], w int) {
			return when cRows[0] == r0 && cRows[1] == r1
			across(c, u, c.cStride, r0, xs, fs, w, u0)
			across(c, u, c.cStride, r1, xs, fs, w, u1)
			across(c, v, c.cStride, r0, xs, fs, w, v0)
			across(c, v, c.cStride, r1, xs, fs, w, v1)
			cRows[0] = r0
			cRows[1] = r1
		}
	}

	// Row `row` of `plane` interpolated across into `out`: per canvas column
	// with source column `xs[x]` (-1 for none) and weight `fs[x]` of the
	// next, the sample times 256 plus that weight of the step.
	def across(c RgbConverter, plane byte[], stride int, row int, xs int[], fs int[], w int, out int[]) {
		let base = row * stride
		if !c.deep {
			for let x = 0; x < out.len(); x++ {
				let sx = xs[x]
				continue when sx < 0
				let a = int(plane[base + sx])
				let b = int(plane[base + (sx + 1).min(w - 1)])
				out[x] = a * 256 + (b - a) * fs[x]
			}
			return
		}
		for let x = 0; x < out.len(); x++ {
			let sx = xs[x]
			continue when sx < 0
			let a = c.at(plane, base + sx)
			let b = c.at(plane, base + (sx + 1).min(w - 1))
			out[x] = a * 256 + (b - a) * fs[x]
		}
	}

	// Converts the samples of one frame to RGB: its colour matrix, range and
	// bit depth folded into 16.16 fixed-point factors, and the layout of its
	// planes in samples.
	type RgbConverter {
		ys      int
		yOff    int
		rv      int
		gu      int
		gv      int
		bu      int
		// Two bytes per sample, reduced to 8 bits by `shift`.
		deep    bool
		shift   int
		mono    bool
		// Chroma subsampling shifts and the strides in samples.
		shiftX  int
		shiftY  int
		yStride int
		cStride int

		def new(frame VideoFrame) {
			let bt709 = frame.matrix == 709
			let full = frame.fullRange
			ys = full ?? (65536, 76309)
			yOff = full ?? (0, 16)
			rv = full ?? (bt709 ?? (103206, 91881), bt709 ?? (117489, 104597))
			gu = full ?? (bt709 ?? (12276, 22553), bt709 ?? (13954, 25675))
			gv = full ?? (bt709 ?? (30679, 46802), bt709 ?? (34903, 53279))
			bu = full ?? (bt709 ?? (121609, 116130), bt709 ?? (138438, 132201))
			deep = frame.bitDepth > 8
			shift = frame.bitDepth - 8
			mono = frame.chroma == ChromaLayout.Mono
			shiftX = frame.chroma == ChromaLayout.Yuv444 ?? (0, 1)
			shiftY = frame.chroma == ChromaLayout.Yuv420 ?? (1, 0)
			let bytes = deep ?? (2, 1)
			yStride = frame.yStride / bytes
			cStride = frame.uvStride / bytes
		}

		// Sample `i` of `plane` as an 8-bit value.
		def at(plane byte[], i int) int {
			return int(plane[i]) unless deep
			let v = int(plane[2 * i]) | (int(plane[2 * i + 1]) << 8)
			return (v + (1 << (shift - 1))) >> shift
		}

		// The sample between columns x0, x1 and rows y0, y1 of `plane`,
		// weighted by `fx` and `fy` in 1/256 towards x1 and y1.
		def bilinear(plane byte[], stride int, x0 int, x1 int, y0 int, y1 int, fx int, fy int) int {
			let a = at(plane, y0 * stride + x0)
			let b = at(plane, y0 * stride + x1)
			let c = at(plane, y1 * stride + x0)
			let d = at(plane, y1 * stride + x1)
			let upper = a * 256 + (b - a) * fx
			let lower = c * 256 + (d - c) * fx
			return (upper * 256 + (lower - upper) * fy + 32768) >> 16
		}

		// Writes the RGBA pixel of 8-bit `luma`, `u` and `v` at `out[o]`.
		def put(out byte[], o int, luma int, u int, v int) {
			let l = (luma - yOff) * ys
			let cu = u - 128
			let cv = v - 128
			out[o] = byte(clip8((l + rv * cv + 32768) >> 16))
			out[o + 1] = byte(clip8((l - gu * cu - gv * cv + 32768) >> 16))
			out[o + 2] = byte(clip8((l + bu * cu + 32768) >> 16))
			out[o + 3] = byte(255)
		}

		// Writes an opaque black pixel at `out[o]`.
		def black(out byte[], o int) {
			out[o] = byte(0)
			out[o + 1] = byte(0)
			out[o + 2] = byte(0)
			out[o + 3] = byte(255)
		}
	}

	def zeros(n int) int[] {
		let out int[]
		out.len(n)
		return out
	}

	// `v` clipped to 0..255.
	def clip8(v int) int {
		return (v & -256) == 0 ?? (v, (~v >> 63) & 255)
	}


	// The source sample under position `u` of `n` drawn samples spanning `len`
	// source samples, centre to centre: its index and the weight of the next
	// one in 1/256.
	def sourceAt(u int, n int, len int) (int, int) {
		let p = ((2 * u + 1) * len * 128) / n - 128
		return (0, 0) when p <= 0
		let i = p >> 8
		return (len - 1, 0) when i >= len - 1
		return (i, p & 255)
	}
}
