partial module std.formats.video {
	use (
		std.testing
		std.formats.video.pictures::*
	)

	// A plane of `width` by `height` bytes of a pattern with no period
	// the vector loops could hide behind.
	internal def testPlane(width int, height int, seed int) byte[] {
		let out byte[]
		out.len(width * height)
		for let i = 0; i < out.len(); i++ {
			out[i] = byte((i * 37 + (i / 7) * 11 + seed * 53) & 0xFF)
		}
		return out
	}

	check "Pictures as 4:2:0" {
		@test()
		def TestPlain420PassesThrough() !none {
			let frame = VideoFrame{width: uint32(4), height: uint32(2), y: testPlane(4, 2, 1), u: testPlane(2, 1, 2), v: testPlane(2, 1, 3), yStride: 4, uvStride: 2}
			let same = try plain420(frame)
			assert same.y.equals(frame.y) && same.u.equals(frame.u) && same.chroma == ChromaLayout.Yuv420
		}

		@test()
		def TestPlain420FromEveryLayout() !none {
			// Odd sizes past one vector: the edges repeat the last row
			// and column.
			let width = 69
			let height = 5
			let u = testPlane(width, height, 2)
			let full = try plain420(VideoFrame{width: uint32(width), height: uint32(height), y: testPlane(width, height, 1), u: u, v: testPlane(width, height, 3), yStride: width, uvStride: width, chroma: ChromaLayout.Yuv444, time: 40ms})
			try testing.expectEqual("35 420 8 40", "{full.uvStride} {full.chroma == ChromaLayout.Yuv420 ?? (420, 0)} {full.bitDepth} {int64(full.time) / 1000000}")
			assert full.u.len() == 35 * 3 && full.v.len() == 35 * 3 && full.y.len() == width * height
			for let row = 0; row < 3; row++ {
				for let x = 0; x < 35; x++ {
					let r = (2 * x + 1).min(width - 1)
					let below = (2 * row + 1).min(height - 1) * width
					let want = (int(u[2 * row * width + 2 * x]) + int(u[2 * row * width + r]) + int(u[below + 2 * x]) + int(u[below + r]) + 2) >> 2
					fail "4:4:4 at {x},{row}: {full.u[row * 35 + x]}, want {want}" unless int(full.u[row * 35 + x]) == want
				}
			}

			let half = 35
			let hu = testPlane(half, height, 4)
			let tall = try plain420(VideoFrame{width: uint32(width), height: uint32(height), y: testPlane(width, height, 1), u: hu, v: hu.clone(), yStride: width, uvStride: half, chroma: ChromaLayout.Yuv422})
			assert tall.u.len() == half * 3
			for let row = 0; row < 3; row++ {
				for let x = 0; x < half; x++ {
					let want = (int(hu[2 * row * half + x]) + int(hu[(2 * row + 1).min(height - 1) * half + x]) + 1) >> 1
					fail "4:2:2 at {x},{row}: {tall.u[row * half + x]}, want {want}" unless int(tall.u[row * half + x]) == want
				}
			}

			let grey = try plain420(VideoFrame{width: uint32(width), height: uint32(height), y: testPlane(width, height, 1), yStride: width, chroma: ChromaLayout.Mono})
			assert grey.u.len() == 35 * 3 && grey.v.len() == 35 * 3 && grey.u[0] == 128 && grey.v[104] == 128 && grey.uvStride == 35
		}

		@test()
		def TestPlain420FromDeepSamples() !none {
			// 10-bit samples in a plane with rows longer than the picture.
			let width = 37
			let height = 2
			let stride = 2 * width + 6
			let deep byte[]
			deep.len(stride * height)
			for let row = 0; row < height; row++ {
				for let x = 0; x < width; x++ {
					let sample = (x * 29 + row * 501) % 1024
					sample = 1023 when x == 5
					deep[row * stride + 2 * x] = byte(sample & 0xFF)
					deep[row * stride + 2 * x + 1] = byte(sample >> 8)
				}
			}
			let out = try plain420(VideoFrame{width: uint32(width), height: uint32(height), y: deep, yStride: stride, chroma: ChromaLayout.Mono, bitDepth: 10})
			try testing.expectEqual("{width} 8 {width * height}", "{out.yStride} {out.bitDepth} {out.y.len()}")
			for let row = 0; row < height; row++ {
				for let x = 0; x < width; x++ {
					let sample = x == 5 ?? (1023, (x * 29 + row * 501) % 1024)
					let want = ((sample + 2) >> 2).min(255)
					fail "10 bits at {x},{row}: {out.y[row * width + x]}, want {want}" unless int(out.y[row * width + x]) == want
				}
			}
		}
	}
}
