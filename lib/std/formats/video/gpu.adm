partial module std.formats.video {
	use std.formats.video.hardware::*

	// A decoded picture that stays in the GPU's memory: the picture of a
	// frame from `Video.frames(onGpu = true)` that the GPU decoded. Such a
	// frame has `onGpu` set and empty planes; a renderer draws it with
	// `fillTextures` without the picture passing through main memory, and
	// `download` gives the frame its planes when they are wanted.
	//
	// The picture occupies one of the decoder's GPU buffers while the frame
	// is referenced. Holding many such frames makes the decoder move the
	// oldest to main memory to reuse their buffers: they still draw, through
	// `planes`.
	type GpuPicture {
		internal picture HwPicture

		def new(picture HwPicture) {
			self.picture = picture
		}

		// Fills two textures of the current OpenGL context with the picture:
		// `luma` of the picture's size with one 8-bit channel, `chroma` of
		// half its width and height with two (Cb, Cr). The caller allocates
		// both at those sizes. The picture never leaves the GPU. False when
		// it cannot be drawn that way (VA-API copies through main memory, or
		// the picture was moved there): `planes` then gives it.
		def fillTextures(luma uint32, chroma uint32) bool {
			return picture.fillTextures(luma, chroma)
		}

		// The picture's planes in main memory: 4:2:0 at 8 bits, cropped,
		// copied from the GPU the first time. Fails when the GPU cannot give
		// the picture back.
		def planes() !(byte[], byte[], byte[]) {
			return picture.planes()
		}
	}

	// Gives a frame whose picture is on the GPU (`onGpu`) its planes, copied
	// to main memory: 4:2:0 at 8 bits. The frame is then an ordinary frame.
	// Does nothing to other frames. Fails when the GPU cannot give the
	// picture back.
	def download(frame VideoFrame) !none {
		let gpu = frame.gpu
		return none when gpu is none
		let (y, u, v) = try gpu.planes()
		frame.y = y
		frame.u = u
		frame.v = v
		frame.yStride = int(frame.width)
		frame.uvStride = int(frame.width) >> 1
		frame.onGpu = false
		frame.gpu = none
		return none
	}
}
