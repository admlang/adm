partial module std.formats.video {
	use std.formats.video.h264::*

	// H264 decodes H.264 (AVC) video: Constrained Baseline, Main, High, High
	// 4:2:2 and High 4:4:4 Predictive streams, progressive or coded as field
	// pictures, 8-bit 4:2:0, 4:2:2, 4:4:4 or monochrome, with CAVLC or
	// CABAC, B frames, weighted prediction, the 8x8 transform and lossless
	// coding. A field whose other field never comes is not shown.
	//
	// Packets carry length-prefixed NAL units when the track's `config` holds
	// an avcC record, Annex B byte streams otherwise; Annex B packets may
	// split or merge pictures freely. Frames come out cropped, in display
	// order, timed by the packet that started each picture.
	//
	// MBAFF frames, bit depths above 8, slice groups, SP/SI slices and 4:4:4
	// coded as separate colour planes are refused with an error; data
	// partitions are skipped.
	@decoder("h264")
	type H264 {
		internal core H264Decoder

		def new() {
			core = new H264Decoder()
		}

		// configure implements VideoDecoder: reads the avcC record in
		// `track.config`, or selects Annex B when it is empty. Fails on a
		// malformed record or unsupported parameter sets.
		def configure(track Track) !none {
			core = new H264Decoder()
			core.trackWidth = int(track.width)
			core.trackHeight = int(track.height)
			try core.configure(track.config)
			return none
		}

		// decode implements VideoDecoder: decodes the NAL units of `packet`
		// and returns the frames whose display turn has come. Fails on a
		// malformed or unsupported stream.
		def decode(packet Packet) !VideoFrame[] {
			try core.packet(packet.data, packet.pts, packet.length)
			return core.take()
		}

		// hardware implements HardwareDecoder: whether the GPU decodes the
		// pictures (NVDEC or VA-API, 8-bit 4:2:0 streams the GPU takes) and
		// why not. Before the first picture it says whether the GPU would
		// take the stream the parameter sets describe, or a High profile
		// one of the track's size when none came yet.
		def hardware() VideoHardware {
			return core.hardware()
		}

		// keepOnGpu implements HardwareDecoder: whether the frames of pictures
		// the GPU decodes keep them there (see `Video.frames`).
		def keepOnGpu(on bool) {
			core.hw.gpu.gpuOutput = on
		}

		// flush implements VideoDecoder: decodes any buffered data and
		// returns every frame still held back. Fails on a malformed stream.
		def flush() !VideoFrame[] {
			try core.flush()
			return core.take()
		}
	}
}
