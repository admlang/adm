internal partial module std.formats.video.h264 {
	// H264BitWriter writes the bits of one RBSP (ITU-T H.264 §7.2), most
	// significant first.
	type H264BitWriter {
		data byte[]
		// Bytes written, and the bits waiting for a whole byte.
		pos  int
		acc  int
		held int

		def new() {
			data = h264Bytes(4096)
		}

		// Starts over with an empty RBSP.
		def reset() {
			pos = 0
			acc = 0
			held = 0
		}

		// Writes the low `n` bits of `v`, 32 at most.
		def put(v int, n int) {
			acc = (acc << n) | v
			held += n
			return when held < 8
			data.len(data.len() * 2) when pos + 8 > data.len()
			for held >= 8 {
				held -= 8
				data[pos] = byte((acc >> held) & 255)
				pos++
			}
			acc = acc & ((1 << held) - 1)
		}

		def flag(on bool) {
			put(on ?? (1, 0), 1)
		}

		// Writes `v` (0 to 65534) as an unsigned Exp-Golomb code.
		def ue(v int) {
			let code = v + 1
			let n = 1
			for (code >> n) != 0 {
				n++
			}
			put(code, 2 * n - 1)
		}

		// Writes `v` as a signed Exp-Golomb code.
		def se(v int) {
			ue(v > 0 ?? (2 * v - 1, 0 - 2 * v))
		}

		// The bits written so far.
		def bits() int {
			return pos * 8 + held
		}

		// Ends the RBSP: the stop bit and zeros up to a whole byte.
		def close() {
			put(1, 1)
			put(0, 8 - held) when held > 0
		}
	}

	// h264PutNal appends the NAL unit with header byte `header` and the
	// payload `rbsp[:n]` to `out` at `at` in Annex B form: a four-byte
	// start code, then the payload with an emulation prevention byte
	// wherever it would read as one (§7.4.1). `out` must have room for
	// `5 + n + n / 2` bytes there; returns where the unit ends.
	def h264PutNal(out byte[], at int, header int, rbsp byte[], n int) int {
		out[at] = 0
		out[at + 1] = 0
		out[at + 2] = 0
		out[at + 3] = 1
		out[at + 4] = byte(header)
		let o = at + 5
		let zeros = 0
		for let i = 0; i < n; i++ {
			let b = rbsp[i]
			if zeros >= 2 && b <= 3 {
				out[o] = 3
				o++
				zeros = 0
			}
			out[o] = b
			o++
			zeros = b == 0 ?? (zeros + 1, 0)
		}
		return o
	}

	// H264CavlcWriter writes CAVLC residual blocks (§9.2), the reverse of
	// `H264Cavlc.block`.
	type H264CavlcWriter {
		// The non-zero levels of the block being written and where they
		// are in its scan.
		level int[]
		place int[]

		def new() {
			level = h264Zeros(16)
			place = h264Zeros(16)
		}

		// Writes the block whose coefficient k is `lev[at + scan[first +
		// k]]`, `maxCoeff` of them, with the neighbour count `nC` (-1
		// for chroma DC). Returns the number of non-zero coefficients.
		def block(w H264BitWriter, nC int, maxCoeff int, lev int16[], at int, scan int[], first int) int {
			let total = 0
			for let k = 0; k < maxCoeff; k++ {
				let v = int(lev[at + scan[first + k]])
				continue when v == 0
				level[total] = v
				place[total] = k
				total++
			}
			let t = nC < 0 ?? (4, nC < 2 ?? (0, nC < 4 ?? (1, nC < 8 ?? (2, 3))))
			let ones = 0
			for ones < 3 && ones < total && h264Abs(level[total - 1 - ones]) == 1 {
				ones++
			}
			let sym = total * 4 + ones
			if t == 4 {
				w.put(h264ChromaDcTokenBits[sym], h264ChromaDcTokenLen[sym])
			} else {
				w.put(h264CoeffTokenBits[t * 68 + sym], h264CoeffTokenLen[t * 68 + sym])
			}
			return 0 when total == 0
			for let i = total - 1; i >= total - ones; i-- {
				w.put(level[i] < 0 ?? (1, 0), 1)
			}
			let suffixLength = (total > 10 && ones < 3) ?? (1, 0)
			for let i = total - ones - 1; i >= 0; i-- {
				let v = level[i]
				let code = v > 0 ?? (2 * v - 2, 0 - 2 * v - 1)
				code -= 2 when i == total - ones - 1 && ones < 3
				if suffixLength == 0 {
					if code < 14 {
						w.put(1, code + 1)
					} else if code < 30 {
						w.put(1, 15)
						w.put(code - 14, 4)
					} else {
						w.put(1, 16)
						w.put(code - 30, 12)
					}
				} else if code < (15 << suffixLength) {
					w.put(1, (code >> suffixLength) + 1)
					w.put(code & ((1 << suffixLength) - 1), suffixLength)
				} else {
					w.put(1, 16)
					w.put(code - (15 << suffixLength), 12)
				}
				suffixLength = 1 when suffixLength == 0
				let mag = v < 0 ?? (0 - v, v)
				suffixLength++ when mag > (3 << (suffixLength - 1)) && suffixLength < 6
			}
			let zerosLeft = place[total - 1] + 1 - total
			if total < maxCoeff {
				if t == 4 {
					let z = (total - 1) * 4 + zerosLeft
					w.put(h264ChromaDcZerosBits[z], h264ChromaDcZerosLen[z])
				} else {
					let z = (total - 1) * 16 + zerosLeft
					w.put(h264TotalZerosBits[z], h264TotalZerosLen[z])
				}
			}
			for let i = total - 1; i > 0 && zerosLeft > 0; i-- {
				let run = place[i] - place[i - 1] - 1
				let r = (zerosLeft < 7 ?? (zerosLeft - 1, 6)) * 16 + run
				w.put(h264RunBits[r], h264RunLen[r])
				zerosLeft -= run
			}
			return total
		}
	}
}
