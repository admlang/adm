internal partial module std.formats.video.h264 {
	use (
		std.formats.video::*
		std.formats.video.hardware::*
	)

	// The picture description the runtime's adm_hwvideo.c reads, index by
	// index: the header, the scaling lists, 16 reference entries, then one
	// record per slice.
	const h264HwKind = 0
	const h264HwWidthMbs = 1
	const h264HwHeightMbs = 2
	const h264HwSurface = 3
	const h264HwField = 4
	const h264HwBottom = 5
	const h264HwSecondField = 6
	const h264HwReference = 7
	const h264HwIntra = 8
	const h264HwLog2MaxFrameNum = 9
	const h264HwPocType = 10
	const h264HwLog2MaxPocLsb = 11
	const h264HwDeltaPocZero = 12
	const h264HwFrameMbsOnly = 13
	const h264HwDirect8x8 = 14
	const h264HwNumRefFrames = 15
	const h264HwDepthLuma = 16
	const h264HwDepthChroma = 17
	const h264HwTransformBypass = 18
	const h264HwCabac = 19
	const h264HwBottomPocPresent = 20
	const h264HwRefIdxL0 = 21
	const h264HwRefIdxL1 = 22
	const h264HwWeightedPred = 23
	const h264HwWeightedBipred = 24
	const h264HwInitQp = 25
	const h264HwInitQs = 26
	const h264HwDeblockControl = 27
	const h264HwRedundantPresent = 28
	const h264HwTransform8x8 = 29
	const h264HwMbaff = 30
	const h264HwConstrainedIntra = 31
	const h264HwChromaQpOffset = 32
	const h264HwSecondChromaQpOffset = 33
	const h264HwFrameNum = 34
	const h264HwPocTop = 35
	const h264HwPocBottom = 36
	const h264HwChromaFormat = 37
	const h264HwMbAdaptive = 38
	const h264HwProfile = 39
	const h264HwLevel = 40
	const h264HwSlices = 41
	const h264HwDpbCount = 42
	const h264HwGapsAllowed = 43
	const h264HwScaling4 = 48
	const h264HwScaling8 = 144
	const h264HwDpb = 272
	const h264HwDpbSize = 8
	const h264HwSliceStart = 400
	const h264HwSliceSize = 720
	const h264HwList0 = 16
	const h264HwList1 = 176
	const h264HwWeights0 = 336
	const h264HwWeights1 = 528

	// Where the H.264 decoder's pictures go to the GPU: the open session,
	// the description of the picture being gathered and its slice NAL
	// units behind start codes.
	type H264Hardware {
		gpu      HwDecoder
		desc     int[]
		data     byte[]
		dataLen  int
		slices   int
		intra    bool

		def new() {
			gpu = new HwDecoder()
			desc = int[]
			data = byte[]
		}

		// Whether the GPU decodes the pictures now.
		def active() bool {
			return gpu.active()
		}

		// The reason `s` cannot decode on the GPU, empty when it can.
		def refusal(s H264Sps) string {
			return "the stream is not 4:2:0" when s.chromaFormat != 1
			return "the stream is deeper than 8 bits" when s.bitDepthLuma != 8 || s.bitDepthChroma != 8
			return "the stream is lossless" when s.transformBypass
			return ""
		}

		// Opens a session for the pictures of `s` unless one fits already,
		// with `inFlight` pictures alive at most. A stream the GPU cannot
		// take decodes in software.
		// `fresh` says no reference decoded before is still needed, which a
		// new session cannot see.
		def configure(s H264Sps, inFlight int, fresh bool) {
			return when gpu.disabled
			let w = s.widthMbs * 16
			let h = s.heightMbs * 16
			if gpu.active() {
				let wanted = (inFlight + 3 + (gpu.gpuOutput ?? (8, 0))).min(32)
				return when gpu.fits(hwCodecH264, w, h) && refusal(s) == "" && (gpu.surfaces >= wanted || !fresh)
				gpu.close()
			}
			return unless fresh
			gpu.why = refusal(s)
			return when gpu.why != ""
			// The decoder's pictures in flight and the one decoding.
			gpu.open(hwCodecH264, s.profile, w, h, inFlight + 1)
		}

		// Gives up the GPU after `reason`: the session closes and the rest
		// of the stream decodes in software.
		def abandon(reason string) {
			gpu.abandon(reason)
		}

		// A picture buffer neither the decoder nor a frame holds, -1 when all
		// are. When only frames kept on the GPU hold the rest, the one held
		// longest is moved to main memory to free its buffer.
		def freeSurface(dpb H264Dpb, busy ?H264Picture) int {
			let used int[]
			for let p in dpb.frames {
				used.push(p.surface) when p.surface >= 0
			}
			if busy is H264Picture {
				used.push(busy.surface) when busy.surface >= 0
			}
			return gpu.freeSurface(used)
		}

		// A frame's hold on the decoded picture in `surface`, cropped, for a
		// frame kept on the GPU.
		def keep(surface int, left int, top int, w int, h int) ?GpuPicture {
			let picture = gpu.keep(surface, left, top, w, h)
			return none when picture is none
			return new GpuPicture(picture)
		}

		// The frame a picture or field view is part of.
		def frameOf(p H264Picture) H264Picture {
			let o = p.owner
			return p when o is none
			return o
		}

		// Starts the description of the picture whose first slice header is
		// `h`: its fields and the references the buffer holds now.
		def describe(h H264SliceHeader, s H264Sps, p H264Pps, cur H264Picture, structure int, second bool, dpb H264Dpb) {
			desc.len(h264HwSliceStart)
			desc.fill(0)
			dataLen = 0
			slices = 0
			intra = true
			let d = desc
			d[h264HwKind] = 1
			d[h264HwWidthMbs] = s.widthMbs
			d[h264HwHeightMbs] = s.heightMbs
			d[h264HwSurface] = cur.surface
			d[h264HwField] = structure != 3 ?? (1, 0)
			d[h264HwBottom] = structure == 2 ?? (1, 0)
			d[h264HwSecondField] = second ?? (1, 0)
			d[h264HwReference] = h.nalRefIdc != 0 ?? (1, 0)
			d[h264HwLog2MaxFrameNum] = s.log2MaxFrameNum - 4
			d[h264HwPocType] = s.pocType
			d[h264HwLog2MaxPocLsb] = (s.log2MaxPocLsb - 4).max(0)
			d[h264HwDeltaPocZero] = s.deltaPicOrderAlwaysZero ?? (1, 0)
			d[h264HwFrameMbsOnly] = s.frameMbsOnly ?? (1, 0)
			d[h264HwDirect8x8] = s.direct8x8Inference ?? (1, 0)
			d[h264HwNumRefFrames] = s.maxNumRefFrames
			d[h264HwDepthLuma] = s.bitDepthLuma - 8
			d[h264HwDepthChroma] = s.bitDepthChroma - 8
			d[h264HwTransformBypass] = s.transformBypass ?? (1, 0)
			d[h264HwCabac] = p.cabac ?? (1, 0)
			d[h264HwBottomPocPresent] = p.bottomFieldPicOrder ?? (1, 0)
			d[h264HwRefIdxL0] = p.numRefIdxL0Default - 1
			d[h264HwRefIdxL1] = p.numRefIdxL1Default - 1
			d[h264HwWeightedPred] = p.weightedPred ?? (1, 0)
			d[h264HwWeightedBipred] = p.weightedBipredIdc
			d[h264HwInitQp] = p.picInitQp - 26
			d[h264HwDeblockControl] = p.deblockingControl ?? (1, 0)
			d[h264HwRedundantPresent] = p.redundantPicCntPresent ?? (1, 0)
			d[h264HwTransform8x8] = p.transform8x8 ?? (1, 0)
			d[h264HwMbaff] = s.mbAdaptive && structure == 3 ?? (1, 0)
			d[h264HwConstrainedIntra] = p.constrainedIntraPred ?? (1, 0)
			d[h264HwChromaQpOffset] = p.chromaQpOffset
			d[h264HwSecondChromaQpOffset] = p.secondChromaQpOffset
			d[h264HwFrameNum] = h.frameNum
			d[h264HwPocTop] = structure != 2 ?? (cur.topPoc, (cur.fields & 1) != 0 ?? (cur.topPoc, 0))
			d[h264HwPocBottom] = structure != 1 ?? (cur.bottomPoc, (cur.fields & 2) != 0 ?? (cur.bottomPoc, 0))
			d[h264HwChromaFormat] = s.chromaFormat
			d[h264HwMbAdaptive] = s.mbAdaptive ?? (1, 0)
			d[h264HwProfile] = s.profile
			d[h264HwLevel] = s.level
			d[h264HwGapsAllowed] = s.gapsAllowed ?? (1, 0)
			for let i = 0; i < 96; i++ {
				d[h264HwScaling4 + i] = p.active4[i]
			}
			for let i = 0; i < 128; i++ {
				d[h264HwScaling8 + i] = p.active8[i]
			}
			let n = 0
			for let r in dpb.frames {
				// An IDR picture refers to nothing; the buffer marks the
				// older pictures unused only once it is decoded.
				break when n == 16 || h.idr
				continue when r.ref == h264RefUnused || r.refFields == 0
				r.surface = freeSurface(dpb, cur) when r.surface < 0
				let at = h264HwDpb + n * h264HwDpbSize
				let long = r.ref == h264RefLong
				d[at] = r.surface
				d[at + 1] = long ?? (r.longTermIdx, r.frameNum)
				d[at + 2] = long ?? (1, 0)
				d[at + 3] = r.nonExisting ?? (1, 0)
				d[at + 4] = r.refFields
				d[at + 5] = (r.fields & 1) != 0 ?? (r.topPoc, 0)
				d[at + 6] = (r.fields & 2) != 0 ?? (r.bottomPoc, 0)
				n++
			}
			d[h264HwDpbCount] = n
		}

		// Adds the slice whose header is `h` and whose NAL unit is
		// `raw[start:end]`, with the reference lists the buffer built for it.
		def add(h H264SliceHeader, p H264Pps, raw byte[], start int, end int, dpb H264Dpb) {
			let size = end - start
			data.len((data.len() * 2).max(dataLen + size + 3 + 4096)) when data.len() < dataLen + size + 3
			let offset = dataLen
			data[dataLen] = byte(0)
			data[dataLen + 1] = byte(0)
			data[dataLen + 2] = byte(1)
			raw[start:end].copy(data[dataLen + 3:])
			dataLen += size + 3
			intra = false unless h.isI()
			let at = h264HwSliceStart + slices * h264HwSliceSize
			desc.len(at + h264HwSliceSize)
			desc.fill(0, at)
			let d = desc
			let lists = h.sliceType == h264SliceB ?? (2, h.sliceType == h264SliceP ?? (1, 0))
			d[at] = offset
			d[at + 1] = size
			d[at + 2] = h264RawBitOffset(raw, start, end, 8 + h.dataOffset)
			d[at + 3] = h.firstMb
			d[at + 4] = h.sliceType
			d[at + 5] = h.sliceType == h264SliceB && h.directSpatial ?? (1, 0)
			d[at + 6] = lists > 0 ?? (h.numRefIdxActive[0] - 1, 0)
			d[at + 7] = lists > 1 ?? (h.numRefIdxActive[1] - 1, 0)
			d[at + 8] = h.cabacInitIdc
			d[at + 9] = h.qp - p.picInitQp
			d[at + 10] = h.disableDeblocking
			d[at + 11] = h.alphaOffset / 2
			d[at + 12] = h.betaOffset / 2
			d[at + 13] = h.lumaLog2Denom
			d[at + 14] = h.chromaLog2Denom
			d[at + 15] = h.hasWeights ?? (lists > 1 ?? (15, 3), 0)
			for let l = 0; l < 2; l++ {
				let list = l == 0 ?? (dpb.list0, dpb.list1)
				let count = l < lists ?? (l == 0 ?? (dpb.count0, dpb.count1), 0)
				let base = at + (l == 0 ?? (h264HwList0, h264HwList1))
				for let i = 0; i < 32; i++ {
					let e = base + i * 5
					if i >= count || i >= list.len() {
						d[e] = -1
						continue
					}
					let r = list[i]
					let f = frameOf(r)
					let long = f.ref == h264RefLong
					d[e] = f.surface
					d[e + 1] = long ?? (f.longTermIdx, f.frameNum)
					d[e + 2] = r.parity | (long ?? (8, 4))
					d[e + 3] = (f.fields & 1) != 0 ?? (f.topPoc, 0)
					d[e + 4] = (f.fields & 2) != 0 ?? (f.bottomPoc, 0)
				}
				let w = at + (l == 0 ?? (h264HwWeights0, h264HwWeights1))
				for let i = 0; i < 32; i++ {
					for let k = 0; k < 6; k++ {
						d[w + i * 6 + k] = h.weights[(l * 32 + i) * 6 + k]
					}
				}
			}
			slices++
		}

		// Hands the gathered picture to the GPU. Fails when the driver
		// refuses it.
		def submit() !none {
			return none when slices == 0
			desc[h264HwSlices] = slices
			desc[h264HwIntra] = intra ?? (1, 0)
			try gpu.decode(desc, data, dataLen)
			slices = 0
			return none
		}

		// The planes of the decoded picture in `surface`, cropped to the
		// rectangle: 4:2:0, 8 bits. Fails when the driver does.
		def download(surface int, left int, top int, w int, h int) !(byte[], byte[], byte[]) {
			return gpu.download(surface, left, top, w, h)
		}
	}

	// The bits from the start of the NAL unit in `raw[start:end]` (its
	// header byte) to `rbspBits` bits into it with the emulation prevention
	// bytes removed, counting those bytes back in.
	def h264RawBitOffset(raw byte[], start int, end int, rbspBits int) int {
		let target = rbspBits >> 3
		let unescaped = 0
		let zeros = 0
		let skipped = 0
		for let i = start; i < end && unescaped < target; i++ {
			let b = int(raw[i])
			if zeros >= 2 && b == 3 && i > start {
				skipped++
				zeros = 0
				continue
			}
			unescaped++
			zeros = b == 0 ?? (zeros + 1, 0)
		}
		return rbspBits + skipped * 8
	}
}
