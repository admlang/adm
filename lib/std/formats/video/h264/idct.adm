internal partial module std.formats.video.h264 {
	// `v` clipped to 0..max, `max` one less than a power of two.
	def h264ClipMax(v int, max int) int {
		return (v & ~max) == 0 ?? (v, (~v >> 63) & max)
	}

	// Adds the inverse 4x4 transform of the dequantised coefficients
	// `c[at:at + 16]` (raster order) to the block of `dst` at `off`, then
	// clears the coefficients.
	def h264Idct4Add<T: H264Sample>(dst T[], off int, stride int, c int[], at int, max int) {
		for let i = 0; i < 4; i++ {
			let o = at + i * 4
			let d0 = c[o]
			let d1 = c[o + 1]
			let d2 = c[o + 2]
			let d3 = c[o + 3]
			let e0 = d0 + d2
			let e1 = d0 - d2
			let e2 = (d1 >> 1) - d3
			let e3 = d1 + (d3 >> 1)
			c[o] = e0 + e3
			c[o + 1] = e1 + e2
			c[o + 2] = e1 - e2
			c[o + 3] = e0 - e3
		}
		for let j = 0; j < 4; j++ {
			let d0 = c[at + j]
			let d1 = c[at + 4 + j]
			let d2 = c[at + 8 + j]
			let d3 = c[at + 12 + j]
			let e0 = d0 + d2
			let e1 = d0 - d2
			let e2 = (d1 >> 1) - d3
			let e3 = d1 + (d3 >> 1)
			let p = off + j
			let v = int(dst[p]) + ((e0 + e3 + 32) >> 6)
			dst[p] = T((v & ~max) == 0 ?? (v, (~v >> 63) & max))
			p += stride
			v = int(dst[p]) + ((e1 + e2 + 32) >> 6)
			dst[p] = T((v & ~max) == 0 ?? (v, (~v >> 63) & max))
			p += stride
			v = int(dst[p]) + ((e1 - e2 + 32) >> 6)
			dst[p] = T((v & ~max) == 0 ?? (v, (~v >> 63) & max))
			p += stride
			v = int(dst[p]) + ((e0 - e3 + 32) >> 6)
			dst[p] = T((v & ~max) == 0 ?? (v, (~v >> 63) & max))
		}
		for let i = 0; i < 16; i++ {
			c[at + i] = 0
		}
	}

	// Adds a block whose only non-zero coefficient is the DC `dc`.
	def h264Idct4Dc<T: H264Sample>(dst T[], off int, stride int, dc int, max int) {
		let v = (dc + 32) >> 6
		for let y = 0; y < 4; y++ {
			let p = off + y * stride
			for let x = 0; x < 4; x++ {
				let r = int(dst[p + x]) + v
				dst[p + x] = T((r & ~max) == 0 ?? (r, (~r >> 63) & max))
			}
		}
	}

	// Adds the inverse 8x8 transform of `c[at:at + 64]` to the block of
	// `dst` at `off`, then clears the coefficients.
	def h264Idct8Add<T: H264Sample>(dst T[], off int, stride int, c int[], at int, max int) {
		for let pass = 0; pass < 2; pass++ {
			for let i = 0; i < 8; i++ {
				// Rows first, then columns.
				let o = pass == 0 ?? (at + i * 8, at + i)
				let s = pass == 0 ?? (1, 8)
				let d0 = c[o]
				let d1 = c[o + s]
				let d2 = c[o + 2 * s]
				let d3 = c[o + 3 * s]
				let d4 = c[o + 4 * s]
				let d5 = c[o + 5 * s]
				let d6 = c[o + 6 * s]
				let d7 = c[o + 7 * s]
				let a0 = d0 + d4
				let a4 = d0 - d4
				let a2 = (d2 >> 1) - d6
				let a6 = d2 + (d6 >> 1)
				let b0 = a0 + a6
				let b2 = a4 + a2
				let b4 = a4 - a2
				let b6 = a0 - a6
				let a1 = d5 - d3 - d7 - (d7 >> 1)
				let a3 = d1 + d7 - d3 - (d3 >> 1)
				let a5 = d7 - d1 + d5 + (d5 >> 1)
				let a7 = d3 + d5 + d1 + (d1 >> 1)
				let b1 = a1 + (a7 >> 2)
				let b7 = a7 - (a1 >> 2)
				let b3 = a3 + (a5 >> 2)
				let b5 = (a3 >> 2) - a5
				c[o] = b0 + b7
				c[o + s] = b2 + b5
				c[o + 2 * s] = b4 + b3
				c[o + 3 * s] = b6 + b1
				c[o + 4 * s] = b6 - b1
				c[o + 5 * s] = b4 - b3
				c[o + 6 * s] = b2 - b5
				c[o + 7 * s] = b0 - b7
			}
		}
		for let y = 0; y < 8; y++ {
			let p = off + y * stride
			let o = at + y * 8
			for let x = 0; x < 8; x++ {
				let v = int(dst[p + x]) + ((c[o + x] + 32) >> 6)
				dst[p + x] = T((v & ~max) == 0 ?? (v, (~v >> 63) & max))
				c[o + x] = 0
			}
		}
	}

	// Inverse Hadamard transform and scaling of the 16 DC levels of an Intra
	// 16x16 macroblock plane, `dc[at:at + 16]` in raster order; writes each
	// result to the DC position of its 4x4 block in `c` (block `b` at
	// `base + b * 16`).
	def h264LumaDc(dc int[], at int, c int[], base int, scale int) {
		for let i = 0; i < 4; i++ {
			let o = at + i * 4
			let a = dc[o] + dc[o + 1]
			let b = dc[o] - dc[o + 1]
			let e = dc[o + 2] + dc[o + 3]
			let d = dc[o + 2] - dc[o + 3]
			dc[o] = a + e
			dc[o + 1] = a - e
			dc[o + 2] = b - d
			dc[o + 3] = b + d
		}
		for let j = 0; j < 4; j++ {
			let a = dc[at + j] + dc[at + 4 + j]
			let b = dc[at + j] - dc[at + 4 + j]
			let e = dc[at + 8 + j] + dc[at + 12 + j]
			let d = dc[at + 8 + j] - dc[at + 12 + j]
			c[base + j * 16] = ((a + e) * scale + 32) >> 6
			c[base + (4 + j) * 16] = ((a - e) * scale + 32) >> 6
			c[base + (8 + j) * 16] = ((b - d) * scale + 32) >> 6
			c[base + (12 + j) * 16] = ((b + d) * scale + 32) >> 6
		}
		for let i = 0; i < 16; i++ {
			dc[at + i] = 0
		}
	}

	// Inverse transform and scaling of the eight chroma DC levels of a 4:2:2
	// macroblock at `dc[at:at + 8]` (block x + 2 * y of the 2x4 blocks),
	// written to the DC positions of the chroma blocks at `c[base:]`;
	// `scale` is the factor of QP'c + 3.
	def h264Chroma422Dc(dc int[], at int, c int[], base int, scale int) {
		let t = h264Zeros(8)
		for let i = 0; i < 4; i++ {
			t[2 * i] = dc[at + 2 * i] + dc[at + 2 * i + 1]
			t[2 * i + 1] = dc[at + 2 * i] - dc[at + 2 * i + 1]
		}
		for let i = 0; i < 2; i++ {
			let z0 = t[i] + t[4 + i]
			let z1 = t[i] - t[4 + i]
			let z2 = t[2 + i] - t[6 + i]
			let z3 = t[2 + i] + t[6 + i]
			c[base + i * 16] = ((z0 + z3) * scale + 32) >> 6
			c[base + (2 + i) * 16] = ((z1 + z2) * scale + 32) >> 6
			c[base + (4 + i) * 16] = ((z1 - z2) * scale + 32) >> 6
			c[base + (6 + i) * 16] = ((z0 - z3) * scale + 32) >> 6
		}
		for let i = 0; i < 8; i++ {
			dc[at + i] = 0
		}
	}

	// Inverse transform and scaling of the four chroma DC levels at
	// `dc[at:at + 4]`, written to the DC positions of the chroma blocks at
	// `c[base:]`.
	def h264ChromaDc(dc int[], at int, c int[], base int, scale int) {
		let c0 = dc[at]
		let c1 = dc[at + 1]
		let c2 = dc[at + 2]
		let c3 = dc[at + 3]
		let a = c0 + c1
		let b = c0 - c1
		let e = c2 + c3
		let d = c2 - c3
		c[base] = ((a + e) * scale) >> 5
		c[base + 16] = ((b + d) * scale) >> 5
		c[base + 32] = ((a - e) * scale) >> 5
		c[base + 48] = ((b - d) * scale) >> 5
		for let i = 0; i < 4; i++ {
			dc[at + i] = 0
		}
	}

	// Adds the `w` x `h` residual `res` (raster order, row length `w`) to
	// the samples at `off`, as a lossless (transform bypass) macroblock
	// does; with `dpcm` 0 the residual is first summed down each column
	// (vertical intra prediction), with 1 along each row (horizontal), with
	// -1 it is added as it is. Clears `res`.
	def h264AddResidual<T: H264Sample>(dst T[], off int, stride int, res int[], w int, h int, dpcm int, max int) {
		if dpcm == 0 {
			for let y = 1; y < h; y++ {
				for let x = 0; x < w; x++ {
					res[y * w + x] += res[(y - 1) * w + x]
				}
			}
		} else if dpcm == 1 {
			for let y = 0; y < h; y++ {
				for let x = 1; x < w; x++ {
					res[y * w + x] += res[y * w + x - 1]
				}
			}
		}
		for let y = 0; y < h; y++ {
			let p = off + y * stride
			for let x = 0; x < w; x++ {
				dst[p + x] = T(h264ClipMax(int(dst[p + x]) + res[y * w + x], max))
				res[y * w + x] = 0
			}
		}
	}
}
