internal partial module std.formats.video.h264 {
	// Stride of the edge-extended copy made when a reference block reaches
	// outside the picture.
	const h264EmuStride = 24

	// Copies the `w` x `h` area at (x, y) of the `sw` x `sh` plane starting
	// at `src[base]` into `emu`, repeating the edge samples for the parts
	// outside it.
	def h264EdgeCopy<T: H264Sample>(src T[], base int, stride int, sw int, sh int, x int, y int, w int, h int, emu T[]) {
		for let j = 0; j < h; j++ {
			let yy = y + j
			yy = yy < 0 ?? (0, yy >= sh ?? (sh - 1, yy))
			let row = base + yy * stride
			let o = j * h264EmuStride
			for let i = 0; i < w; i++ {
				let xx = x + i
				xx = xx < 0 ?? (0, xx >= sw ?? (sw - 1, xx))
				emu[o + i] = src[row + xx]
			}
		}
	}

	// Luma sample interpolation of a `w` x `h` block whose integer position
	// in the reference plane at `src[base]` is (x, y) and fractional
	// position (fx, fy) in quarter samples.
	// The kit's kernels do the interpolation.
	def h264McLuma<T: H264Sample>(src T[], base int, stride int, sw int, sh int, x int, y int, fx int, fy int, w int, h int, dst T[], doff int, dstride int, k H264Kit<T>, tmp int[]) {
		if x - 2 < 0 || y - 2 < 0 || x + w + 3 > sw || y + h + 3 > sh {
			h264EdgeCopy(src, base, stride, sw, sh, x - 2, y - 2, w + 5, h + 5, k.emu)
			k.qpel(k.emu, 2 * h264EmuStride + 2, h264EmuStride, fx, fy, w, h, dst, doff, dstride, tmp, k.tmp16, k.max)
		} else {
			k.qpel(src, base + y * stride + x, stride, fx, fy, w, h, dst, doff, dstride, tmp, k.tmp16, k.max)
		}
	}

	// Horizontal six-tap filter of `w` samples from `p`, unrounded, into
	// `t[at:]`. A sliding window reads each sample once.
	def h264TapRow<T: H264Sample>(s T[], p int, w int, t int[], at int) {
		let a = int(s[p - 2])
		let b = int(s[p - 1])
		let c = int(s[p])
		let d = int(s[p + 1])
		let e = int(s[p + 2])
		for let i = 0; i < w; i++ {
			let f = int(s[p + i + 3])
			t[at + i] = a + f - 5 * (b + e) + 20 * (c + d)
			a = b
			b = c
			c = d
			d = e
			e = f
		}
	}

	// Vertical six-tap filter of `h` samples down from `p`, unrounded, into
	// `t[at:]` with stride 16.
	def h264TapColumn<T: H264Sample>(s T[], p int, st int, h int, t int[], at int) {
		let a = int(s[p - 2 * st])
		let b = int(s[p - st])
		let c = int(s[p])
		let d = int(s[p + st])
		let e = int(s[p + 2 * st])
		let q = p + 3 * st
		for let j = 0; j < h; j++ {
			let f = int(s[q])
			t[at + j * 16] = a + f - 5 * (b + e) + 20 * (c + d)
			a = b
			b = c
			c = d
			d = e
			e = f
			q += st
		}
	}

	// Quarter sample luma interpolation from `s` at `so` into `d` at `doff`.
	def h264Qpel<T: H264Sample>(s T[], so int, st int, fx int, fy int, w int, h int, d T[], doff int, dst int, tmp int[], max int) {
		if fx == 0 && fy == 0 {
			for let j = 0; j < h; j++ {
				let p = so + j * st
				let o = doff + j * dst
				for let i = 0; i < w; i++ {
					d[o + i] = s[p + i]
				}
			}
			return
		}
		if fy == 0 {
			// b, and a or c: the average with the integer sample left or right.
			let other = fx == 3 ?? (1, 0)
			for let j = 0; j < h; j++ {
				let p = so + j * st
				let o = doff + j * dst
				h264TapRow(s, p, w, tmp, 0)
				for let i = 0; i < w; i++ {
					let b = (tmp[i] + 16) >> 5
					b = (b & ~max) == 0 ?? (b, (~b >> 63) & max)
					b = (int(s[p + i + other]) + b + 1) >> 1 when fx != 2
					d[o + i] = T(b)
				}
			}
			return
		}
		if fx == 0 {
			// h, and d or n: the average with the integer sample above or below.
			let other = fy == 3 ?? (st, 0)
			for let i = 0; i < w; i++ {
				h264TapColumn(s, so + i, st, h, tmp, i)
			}
			for let j = 0; j < h; j++ {
				let p = so + j * st
				let o = doff + j * dst
				let t = j * 16
				for let i = 0; i < w; i++ {
					let v = (tmp[t + i] + 16) >> 5
					v = (v & ~max) == 0 ?? (v, (~v >> 63) & max)
					v = (int(s[p + i + other]) + v + 1) >> 1 when fy != 2
					d[o + i] = T(v)
				}
			}
			return
		}
		if fx == 2 || fy == 2 {
			// The centre sample j from the unrounded horizontal taps of the
			// h + 5 rows around the block, then its averages f, q, i and k.
			for let j = 0; j < h + 5; j++ {
				h264TapRow(s, so + (j - 2) * st, w, tmp, j * 16)
			}
			let side = 21 * 16
			if fx != 2 {
				// i or k: the vertical half sample of the column left or right.
				let col = fx == 3 ?? (1, 0)
				for let i = 0; i < w; i++ {
					h264TapColumn(s, so + i + col, st, h, tmp, side + i)
				}
			}
			for let j = 0; j < h; j++ {
				let o = doff + j * dst
				for let i = 0; i < w; i++ {
					let t = (j + 2) * 16 + i
					let jj = tmp[t - 32] + tmp[t + 48] - 5 * (tmp[t - 16] + tmp[t + 32]) + 20 * (tmp[t] + tmp[t + 16])
					jj = (jj + 512) >> 10
					jj = (jj & ~max) == 0 ?? (jj, (~jj >> 63) & max)
					let v = jj
					if fx == 2 && fy != 2 {
						let b = (tmp[t + (fy == 3 ?? (16, 0))] + 16) >> 5
						b = (b & ~max) == 0 ?? (b, (~b >> 63) & max)
						v = (jj + b + 1) >> 1
					} else if fx != 2 {
						let m = (tmp[side + j * 16 + i] + 16) >> 5
						m = (m & ~max) == 0 ?? (m, (~m >> 63) & max)
						v = (jj + m + 1) >> 1
					}
					d[o + i] = T(v)
				}
			}
			return
		}
		// e, g, p and r: the average of a horizontal and a vertical half
		// sample.
		let rowOff = fy == 3 ?? (st, 0)
		let colOff = fx == 3 ?? (1, 0)
		let side = 16 * 16
		for let i = 0; i < w; i++ {
			h264TapColumn(s, so + i + colOff, st, h, tmp, side + i)
		}
		for let j = 0; j < h; j++ {
			let o = doff + j * dst
			let p = so + j * st + rowOff
			h264TapRow(s, p, w, tmp, 0)
			let t = side + j * 16
			for let i = 0; i < w; i++ {
				let b = (tmp[i] + 16) >> 5
				b = (b & ~max) == 0 ?? (b, (~b >> 63) & max)
				let v = (tmp[t + i] + 16) >> 5
				v = (v & ~max) == 0 ?? (v, (~v >> 63) & max)
				d[o + i] = T((b + v + 1) >> 1)
			}
		}
	}

	// Chroma sample interpolation of a `w` x `h` block at integer position
	// (x, y) of the plane at `src[base]` and fraction (fx, fy) in eighth
	// samples.
	// The kit's kernels do the interpolation.
	def h264McChroma<T: H264Sample>(src T[], base int, stride int, sw int, sh int, x int, y int, fx int, fy int, w int, h int, dst T[], doff int, dstride int, k H264Kit<T>) {
		if x < 0 || y < 0 || x + w + 1 > sw || y + h + 1 > sh {
			h264EdgeCopy(src, base, stride, sw, sh, x, y, w + 1, h + 1, k.emu)
			k.bilinear(k.emu, 0, h264EmuStride, fx, fy, w, h, dst, doff, dstride)
		} else {
			k.bilinear(src, base + y * stride + x, stride, fx, fy, w, h, dst, doff, dstride)
		}
	}

	// Eighth sample chroma interpolation from `s` at `so` into `dst` at `doff`.
	def h264Bilinear<T: H264Sample>(s T[], so int, st int, fx int, fy int, w int, h int, dst T[], doff int, dstride int) {
		if fx == 0 && fy == 0 {
			for let j = 0; j < h; j++ {
				let p = so + j * st
				let o = doff + j * dstride
				for let i = 0; i < w; i++ {
					dst[o + i] = s[p + i]
				}
			}
			return
		}
		let a = (8 - fx) * (8 - fy)
		let b = fx * (8 - fy)
		let c = (8 - fx) * fy
		let e = fx * fy
		for let j = 0; j < h; j++ {
			let p = so + j * st
			let o = doff + j * dstride
			for let i = 0; i < w; i++ {
				let q = p + i
				let v = a * int(s[q]) + b * int(s[q + 1]) + c * int(s[q + st]) + e * int(s[q + st + 1])
				dst[o + i] = T((v + 32) >> 6)
			}
		}
	}

	// Averages two prediction blocks (stride 16) into `dst`.
	def h264Average<T: H264Sample>(dst T[], doff int, dstride int, a T[], b T[], w int, h int) {
		for let j = 0; j < h; j++ {
			let o = doff + j * dstride
			let t = j * 16
			for let i = 0; i < w; i++ {
				dst[o + i] = T((int(a[t + i]) + int(b[t + i]) + 1) >> 1)
			}
		}
	}

	// Explicit weighting of one prediction block (stride 16) into `dst`.
	def h264WeightOne<T: H264Sample>(dst T[], doff int, dstride int, a T[], w int, h int, logWD int, wt int, off int, max int) {
		let round = logWD >= 1 ?? (1 << (logWD - 1), 0)
		for let j = 0; j < h; j++ {
			let o = doff + j * dstride
			let t = j * 16
			for let i = 0; i < w; i++ {
				let v = ((int(a[t + i]) * wt + round) >> logWD) + off
				dst[o + i] = T((v & ~max) == 0 ?? (v, (~v >> 63) & max))
			}
		}
	}

	// Weighted average of two prediction blocks (stride 16) into `dst`.
	def h264WeightBi<T: H264Sample>(dst T[], doff int, dstride int, a T[], b T[], w int, h int, logWD int, w0 int, w1 int, o0 int, o1 int, max int) {
		let round = 1 << logWD
		let off = (o0 + o1 + 1) >> 1
		let shift = logWD + 1
		for let j = 0; j < h; j++ {
			let o = doff + j * dstride
			let t = j * 16
			for let i = 0; i < w; i++ {
				let v = ((int(a[t + i]) * w0 + int(b[t + i]) * w1 + round) >> shift) + off
				dst[o + i] = T((v & ~max) == 0 ?? (v, (~v >> 63) & max))
			}
		}
	}
}
