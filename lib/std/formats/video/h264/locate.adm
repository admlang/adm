internal partial module std.formats.video.h264 {
	// H264Locator finds the macroblock and the position inside it that a
	// location next to the current macroblock falls in (H.264 6.4.12). In
	// MBAFF frames a macroblock pair is two frame macroblocks (upper and
	// lower halves) or two field macroblocks (even and odd lines), and a
	// neighbour of the other kind covers different lines.
	//
	// Macroblocks are numbered in raster order of the picture's grids,
	// `row * widthMbs + column`: in MBAFF frames the top macroblock of a
	// pair holds row 2k and the bottom one row 2k + 1, whatever the pair's
	// kind; a field macroblock's grid entries are in its own line order.
	type H264Locator {
		pic      H264Picture
		wMbs     int
		gw       int
		sliceNum int
		mbaff    bool
		// The current macroblock and, in MBAFF frames, its kind.
		mbx      int
		mby      int
		mbAddr   int
		field    bool
		// Result of `locate`: the position inside the macroblock found.
		x        int
		y        int
		// Macroblock of the last `luma` or `chroma` lookup.
		found    int

		def new() {
			pic = new H264Picture()
		}

		def slice(p H264Picture, num int, adaptive bool) {
			pic = p
			wMbs = p.widthMbs
			gw = wMbs * 4
			sliceNum = num
			mbaff = adaptive
			field = false
		}

		def at(x int, y int, fieldMb bool) {
			mbx = x
			mby = y
			mbAddr = y * wMbs + x
			field = fieldMb
		}

		// Whether macroblock `mb` is a field macroblock.
		def isField(mb int) bool {
			return (pic.mbType[mb] & h264MbField) != 0
		}

		// Whether the pair at column `x` and pair row `row` is decoded and in
		// the current slice.
		def pairAvail(x int, row int) bool {
			return false when x < 0 || x >= wMbs || row < 0
			return pic.sliceOfMb[2 * row * wMbs + x] == sliceNum
		}

		// Whether the macroblock at (x, y) is decoded and in the current
		// slice.
		def mbAvail(x int, y int) bool {
			return false when x < 0 || x >= wMbs || y < 0
			return pic.sliceOfMb[y * wMbs + x] == sliceNum
		}

		// The macroblock holding location (xN, yN), relative to the current
		// macroblock's top-left sample of a plane whose macroblocks are
		// maxW x maxH samples, or -1 when it is unavailable. Sets `x` and
		// `y` to the location inside it.
		def locate(xN int, yN int, maxW int, maxH int) int {
			x = (xN + maxW) % maxW
			if xN >= 0 && yN >= 0 && xN < maxW && yN < maxH {
				y = yN
				return mbAddr
			}
			return -1 when xN >= maxW && yN >= 0
			if !mbaff {
				y = (yN + maxH) % maxH
				let nx = mbx + (xN < 0 ?? (-1, xN >= maxW ?? (1, 0)))
				let ny = mby + (yN < 0 ?? (-1, 0))
				return mbAvail(nx, ny) ?? (ny * wMbs + nx, -1)
			}
			let top = (mby & 1) == 0
			let row = mby >> 1
			// The pair the location falls in, and the macroblock of it.
			let px = mbx + (xN < 0 ?? (-1, xN >= maxW ?? (1, 0)))
			let prow = row
			let bottom = false
			let yM = yN
			if yN >= 0 {
				// Left of the macroblock.
				return -1 unless pairAvail(px, prow)
				let frameA = !isField(2 * prow * wMbs + px)
				if !field {
					if frameA {
						bottom = !top
					} else {
						bottom = (yN & 1) == 1
						yM = top ?? (yN >> 1, (yN + maxH) >> 1)
					}
				} else if frameA {
					let lower = yN >= (maxH >> 1)
					bottom = lower
					yM = (yN << 1) - (lower ?? (maxH, 0)) + (top ?? (0, 1))
				} else {
					bottom = !top
				}
			} else if !field {
				if top {
					prow = row - 1
					return -1 unless pairAvail(px, prow)
					bottom = true
				} else if xN < 0 {
					// Above-left of a lower frame macroblock: the left pair.
					return -1 unless pairAvail(px, prow)
					if isField(2 * prow * wMbs + px) {
						bottom = true
						yM = (yN + maxH) >> 1
					}
				} else {
					return -1 when xN >= maxW
					// The upper macroblock of the pair.
					bottom = false
				}
			} else {
				prow = row - 1
				return -1 unless pairAvail(px, prow)
				if top && !isField(2 * prow * wMbs + px) {
					bottom = true
					yM = 2 * yN
				} else {
					bottom = !top
				}
			}
			y = (yM + maxH) % maxH
			return (2 * prow + (bottom ?? (1, 0))) * wMbs + px
		}

		// The luma 4x4 grid index of the block holding luma location
		// (xN, yN), -1 when unavailable. The macroblock is in `found`.
		def luma(xN int, yN int) int {
			let mb = locate(xN, yN, 16, 16)
			found = mb
			return -1 when mb < 0
			return ((mb / wMbs) * 4 + (y >> 2)) * gw + (mb % wMbs) * 4 + (x >> 2)
		}

		// The chroma 4x4 grid index of the block holding chroma location
		// (xN, yN) of a plane whose macroblocks have `rows` rows of 4x4
		// blocks, -1 when unavailable.
		def chroma(xN int, yN int, rows int) int {
			let mb = locate(xN, yN, 8, rows * 4)
			found = mb
			return -1 when mb < 0
			return ((mb / wMbs) * rows + (y >> 2)) * wMbs * 2 + (mb % wMbs) * 2 + (x >> 2)
		}
	}
}
