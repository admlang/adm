internal partial module std.formats.video.h264 {
	const h264SliceP = 0
	const h264SliceB = 1
	const h264SliceI = 2

	// H264SliceHeader is the parsed header of one slice.
	type H264SliceHeader {
		nalType             int
		nalRefIdc           int
		idr                 bool
		firstMb             int
		sliceType           int
		ppsId               int
		frameNum            int
		// A field picture, and which field.
		fieldPic            bool
		bottomField         bool
		idrPicId            int
		pocLsb              int
		deltaPocBottom      int
		deltaPoc0           int
		deltaPoc1           int
		// Non-zero for the slices of a redundant coded picture, which the
		// decoder skips.
		redundantPicCnt     int
		directSpatial       bool
		numRefIdxActive     int[]
		// Reference list modifications as triples: the list,
		// modification_of_pic_nums_idc and its value.
		modifications       int[]
		// Weighted prediction: log2 denominators, then per list and
		// reference index the luma weight and offset and the two chroma
		// weights and offsets, [list][ref][6].
		lumaLog2Denom       int
		chromaLog2Denom     int
		weights             int[]
		hasWeights          bool
		noOutputOfPriorPics bool
		longTermReference   bool
		adaptiveMarking     bool
		// Memory management operations as triples: operation, and its two
		// operands.
		mmco                int[]
		cabacInitIdc        int
		qp                  int
		disableDeblocking   int
		alphaOffset         int
		betaOffset          int
		// Bit offset of slice_data in the RBSP.
		dataOffset          int

		def new() {
			numRefIdxActive = int[0, 0]
			modifications = int[]
			weights = h264Zeros(2 * 32 * 6)
			mmco = int[]
		}

		// The picture structure: 1 top field, 2 bottom field, 3 frame.
		def structure() int {
			return 3 unless fieldPic
			return bottomField ?? (2, 1)
		}

		def isB() bool {
			return sliceType == h264SliceB
		}

		def isI() bool {
			return sliceType == h264SliceI
		}
	}

	// Parses the first fields of a slice header, which is enough to find the
	// parameter sets and whether the slice starts a new picture.
	def h264ParseSliceStart(r H264Bits, h H264SliceHeader) !none {
		h.firstMb = r.ue()
		let t = r.ue()
		fail "h264: bad slice_type" when t > 9
		t = t % 5
		fail "h264: SP and SI slices are not supported" when t > 2
		h.sliceType = t
		h.ppsId = r.ue()
		fail "h264: bad pic_parameter_set_id" when h.ppsId > 255
	}

	// Parses the rest of a slice header, after `h264ParseSliceStart`. Fails on
	// a malformed header.
	def h264ParseSliceRest(r H264Bits, h H264SliceHeader, sps H264Sps, pps H264Pps) !none {
		h.frameNum = r.u(sps.log2MaxFrameNum)
		h.fieldPic = false
		h.bottomField = false
		if !sps.frameMbsOnly {
			h.fieldPic = r.flag()
			h.bottomField = r.flag() when h.fieldPic
		}
		h.idrPicId = r.ue() when h.idr
		h.deltaPocBottom = 0
		h.deltaPoc0 = 0
		h.deltaPoc1 = 0
		if sps.pocType == 0 {
			h.pocLsb = r.u(sps.log2MaxPocLsb)
			h.deltaPocBottom = r.se() when pps.bottomFieldPicOrder && !h.fieldPic
		}
		if sps.pocType == 1 && !sps.deltaPicOrderAlwaysZero {
			h.deltaPoc0 = r.se()
			h.deltaPoc1 = r.se() when pps.bottomFieldPicOrder && !h.fieldPic
		}
		h.redundantPicCnt = pps.redundantPicCntPresent ?? (r.ue(), 0)
		h.directSpatial = r.flag() when h.sliceType == h264SliceB
		h.numRefIdxActive[0] = 0
		h.numRefIdxActive[1] = 0
		if h.sliceType != h264SliceI {
			h.numRefIdxActive[0] = pps.numRefIdxL0Default
			h.numRefIdxActive[1] = pps.numRefIdxL1Default when h.sliceType == h264SliceB
			if r.flag() {
				h.numRefIdxActive[0] = r.ue() + 1
				h.numRefIdxActive[1] = r.ue() + 1 when h.sliceType == h264SliceB
			}
			fail "h264: bad num_ref_idx_active" when h.numRefIdxActive[0] > 32 || h.numRefIdxActive[1] > 32
		}
		h.modifications.len(0)
		let lists = h.sliceType == h264SliceB ?? (2, h.sliceType == h264SliceP ?? (1, 0))
		for let l = 0; l < lists; l++ {
			continue unless r.flag()
			for {
				let idc = r.ue()
				break when idc == 3
				fail "h264: bad modification_of_pic_nums_idc" when idc > 5 || h.modifications.len() > 300
				h.modifications.push(l)
				h.modifications.push(idc)
				h.modifications.push(r.ue())
			}
		}
		h.hasWeights = false
		if (pps.weightedPred && h.sliceType == h264SliceP) || (pps.weightedBipredIdc == 1 && h.sliceType == h264SliceB) {
			h.hasWeights = true
			h264ParseWeights(r, h, lists, sps.chromaFormat != 0)
		}
		h.mmco.len(0)
		h.adaptiveMarking = false
		if h.nalRefIdc != 0 {
			if h.idr {
				h.noOutputOfPriorPics = r.flag()
				h.longTermReference = r.flag()
			} else {
				h.adaptiveMarking = r.flag()
				if h.adaptiveMarking {
					for {
						let op = r.ue()
						break when op == 0
						fail "h264: bad memory_management_control_operation" when op > 6 || h.mmco.len() > 300
						let a = 0
						let b = 0
						if op := 1 || 3 {
							a = r.ue()
						}
						a = r.ue() when op == 2
						if op := 3 || 6 {
							b = r.ue()
						}
						a = r.ue() when op == 4
						h.mmco.push(op)
						h.mmco.push(a)
						h.mmco.push(b)
					}
				}
			}
		}
		h.cabacInitIdc = 0
		if pps.cabac && h.sliceType != h264SliceI {
			h.cabacInitIdc = r.ue()
			fail "h264: bad cabac_init_idc" when h.cabacInitIdc > 2
		}
		h.qp = pps.picInitQp + r.se()
		fail "h264: bad slice_qp_delta" when h.qp < 0 - 6 * (sps.bitDepthLuma - 8) || h.qp > 51
		h.disableDeblocking = 0
		h.alphaOffset = 0
		h.betaOffset = 0
		if pps.deblockingControl {
			h.disableDeblocking = r.ue()
			fail "h264: bad disable_deblocking_filter_idc" when h.disableDeblocking > 2
			if h.disableDeblocking != 1 {
				h.alphaOffset = r.se() * 2
				h.betaOffset = r.se() * 2
				fail "h264: bad deblocking offsets" when h.alphaOffset < -12 || h.alphaOffset > 12 || h.betaOffset < -12 || h.betaOffset > 12
			}
		}
		fail "h264: truncated slice header" when r.left() < 0
		h.dataOffset = r.pos
	}

	// Reads pred_weight_table, filling in the implied defaults for the
	// entries the stream leaves out.
	def h264ParseWeights(r H264Bits, h H264SliceHeader, lists int, chroma bool) {
		h.lumaLog2Denom = r.ue() & 7
		h.chromaLog2Denom = chroma ?? (r.ue() & 7, 0)
		let w = h.weights
		for let l = 0; l < lists; l++ {
			for let i = 0; i < h.numRefIdxActive[l]; i++ {
				let o = (l * 32 + i) * 6
				w[o] = 1 << h.lumaLog2Denom
				w[o + 1] = 0
				if r.flag() {
					w[o] = r.se()
					w[o + 1] = r.se()
				}
				w[o + 2] = 1 << h.chromaLog2Denom
				w[o + 3] = 0
				w[o + 4] = 1 << h.chromaLog2Denom
				w[o + 5] = 0
				if chroma && r.flag() {
					w[o + 2] = r.se()
					w[o + 3] = r.se()
					w[o + 4] = r.se()
					w[o + 5] = r.se()
				}
			}
		}
	}
}
