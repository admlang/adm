internal partial module std.formats.video.h264 {
	// H264Vlc is a prefix code of up to 16 bits as a two-level lookup
	// table: the first 8 bits index the table, longer codes continue in a
	// second 256-entry table.
	type H264Vlc {
		// Entries are symbol * 32 + code length; 0 marks an invalid code; a
		// negative entry is the offset of a second-level table.
		table int[]

		// Builds the table from the code lengths and values of each symbol
		// (a length of 0 leaves the symbol out).
		def new(lens int[], codes int[], at int, count int) {
			table = h264Zeros(256)
			for let s = 0; s < count; s++ {
				let len = lens[at + s]
				continue when len == 0
				let code = codes[at + s]
				if len <= 8 {
					let first = code << (8 - len)
					for let k = 0; k < (1 << (8 - len)); k++ {
						table[first + k] = s * 32 + len
					}
				} else {
					let hi = code >> (len - 8)
					let e = table[hi]
					let base = 0
					if e < 0 {
						base = 0 - e
					} else {
						base = table.len()
						table.len(base + 256)
						table.fill(0, base)
						table[hi] = 0 - base
					}
					let low = code & ((1 << (len - 8)) - 1)
					let first = low << (16 - len)
					for let k = 0; k < (1 << (16 - len)); k++ {
						table[base + first + k] = s * 32 + len
					}
				}
			}
		}

		// Reads one symbol, or -1 for a code the table does not hold.
		def read(r H264Bits) int {
			let v = r.peek32()
			let e = table[v >> 24]
			e = table[(0 - e) + ((v >> 16) & 255)] when e < 0
			let len = e & 31
			return -1 when len == 0
			r.pos += len
			return e >> 5
		}
	}

	// H264Cavlc reads CAVLC residual blocks.
	type H264Cavlc {
		// coeff_token for 0 <= nC < 2, 2 <= nC < 4, 4 <= nC < 8, 8 <= nC,
		// chroma DC and 4:2:2 chroma DC.
		token     H264Vlc[]
		zeros     H264Vlc[]
		dcZeros   H264Vlc[]
		dcZeros2  H264Vlc[]
		runs      H264Vlc[]
		levels    int[]
		runBefore int[]

		def new() {
			token = H264Vlc[]
			for let i = 0; i < 4; i++ {
				token.push(new H264Vlc(h264CoeffTokenLen, h264CoeffTokenBits, i * 68, 68))
			}
			token.push(new H264Vlc(h264ChromaDcTokenLen, h264ChromaDcTokenBits, 0, 20))
			token.push(new H264Vlc(h264Chroma422DcTokenLen, h264Chroma422DcTokenBits, 0, 36))
			zeros = H264Vlc[]
			for let i = 0; i < 15; i++ {
				zeros.push(new H264Vlc(h264TotalZerosLen, h264TotalZerosBits, i * 16, 16))
			}
			dcZeros = H264Vlc[]
			for let i = 0; i < 3; i++ {
				dcZeros.push(new H264Vlc(h264ChromaDcZerosLen, h264ChromaDcZerosBits, i * 4, 4))
			}
			dcZeros2 = H264Vlc[]
			for let i = 0; i < 7; i++ {
				dcZeros2.push(new H264Vlc(h264Chroma422DcZerosLen, h264Chroma422DcZerosBits, i * 8, 8))
			}
			runs = H264Vlc[]
			for let i = 0; i < 7; i++ {
				runs.push(new H264Vlc(h264RunLen, h264RunBits, i * 16, 16))
			}
			levels = h264Zeros(16)
			runBefore = h264Zeros(16)
		}

		// Reads one residual block of up to `maxCoeff` coefficients with the
		// neighbour count `nC` (-1 for chroma DC, -2 for 4:2:2 chroma DC). Coefficient k goes to
		// `coeff[at + scan[first + k * step]]`, multiplied by
		// `dq[dqAt + position]` and scaled when `dqAt` >= 0, raw otherwise.
		// Returns the number of non-zero coefficients, or -1 on a bad code.
		def block(r H264Bits, nC int, maxCoeff int, coeff int[], at int, scan int[], first int, step int, dq int[], dqAt int, shift int) int {
			let t = nC == -2 ?? (5, 4)
			t = nC < 2 ?? (0, nC < 4 ?? (1, nC < 8 ?? (2, 3))) when nC >= 0
			let sym = token[t].read(r)
			return -1 when sym < 0
			let total = sym >> 2
			let ones = sym & 3
			return 0 when total == 0
			return -1 when total > maxCoeff || ones > total
			let suffixLength = (total > 10 && ones < 3) ?? (1, 0)
			for let i = 0; i < total; i++ {
				if i < ones {
					levels[i] = r.flag() ?? (-1, 1)
					continue
				}
				let v = r.peek32()
				let prefix = h264Clz32(v)
				return -1 when prefix > 25
				r.pos += prefix + 1
				let size = suffixLength
				if prefix == 14 && suffixLength == 0 {
					size = 4
				} else if prefix >= 15 {
					size = prefix - 3
				}
				let pmin = prefix < 15 ?? (prefix, 15)
				let code = (pmin << suffixLength) + r.u(size)
				code += 15 when prefix >= 15 && suffixLength == 0
				code += (1 << (prefix - 3)) - 4096 when prefix >= 16
				code += 2 when i == ones && ones < 3
				let level = (code & 1) == 0 ?? ((code + 2) >> 1, (0 - code - 1) >> 1)
				levels[i] = level
				suffixLength = 1 when suffixLength == 0
				let mag = level < 0 ?? (0 - level, level)
				suffixLength++ when mag > (3 << (suffixLength - 1)) && suffixLength < 6
			}
			let zerosLeft = 0
			if total < maxCoeff {
				if nC == -1 {
					zerosLeft = dcZeros[total - 1].read(r)
				} else if nC == -2 {
					zerosLeft = dcZeros2[total - 1].read(r)
				} else {
					zerosLeft = zeros[total - 1].read(r)
				}
				return -1 when zerosLeft < 0 || zerosLeft + total > maxCoeff
			}
			for let i = 0; i < total - 1; i++ {
				let run = 0
				if zerosLeft > 0 {
					let k = zerosLeft < 7 ?? (zerosLeft - 1, 6)
					run = runs[k].read(r)
					return -1 when run < 0 || run > zerosLeft
				}
				runBefore[i] = run
				zerosLeft -= run
			}
			runBefore[total - 1] = zerosLeft
			let pos = -1
			for let i = total - 1; i >= 0; i-- {
				pos += runBefore[i] + 1
				let raster = scan[first + pos * step]
				if dqAt >= 0 {
					coeff[at + raster] = (levels[i] * dq[dqAt + raster] + (1 << (shift - 1))) >> shift
				} else {
					coeff[at + raster] = levels[i]
				}
			}
			return total
		}
	}
}
