internal partial module std.formats.video.h264 {
	// H264Deblock runs the deblocking filter over a decoded picture.
	type H264Deblock {
		pic    H264Picture
		// Per macroblock luma QP and per 4x4 block coefficient counts, from
		// the slice decoder.
		qp     int[]
		nzc    int[]
		cbp    int[]
		// Per slice of the picture: disable_deblocking_filter_idc,
		// FilterOffsetA, FilterOffsetB and the two chroma QP offsets.
		params int[]
		bs     int[]
		wMbs   int
		hMbs   int
		gw     int
		chroma bool
		// Vertical motion difference that makes an edge strength 1: 4
		// quarter samples, 2 in fields, whose vectors count field lines.
		mvy    int
		// 4:4:4: the chroma planes are filtered like luma, at every edge.
		full   bool
		// 4:2:2: chroma macroblocks of 8x16, with four horizontal edges.
		c422   bool
		// MBAFF frame: macroblock pairs of two frame or two field
		// macroblocks.
		mbaff  bool
		// Bits of depth beyond 8, and the QP offset they bring (the QP grid
		// holds QP'Y); the largest sample.
		shift  int
		bd     int
		max    int
		// Strengths of the left edge of a macroblock whose left pair is of
		// the other kind: eight, per two lines.
		bs8    int[]
		// The strengths of one half of that edge.
		half   int[]
		// Rows decoded so far, sent by the decoder (-1: all of them), and
		// the end of filtering.
		progress channel<int>
		done     channel<bool>

		def new() {
			pic = new H264Picture()
			qp = int[]
			nzc = int[]
			cbp = int[]
			params = int[]
			bs = h264Zeros(32)
			bs8 = h264Zeros(8)
			half = h264Zeros(4)
			progress = new channel<int>(size = 1)
			done = new channel<bool>(size = 1)
		}

		// Starts filtering `p` while it is decoded: `advance` reports the
		// macroblock rows decoded so far, and a task of its own filters each
		// row once the row under it is decoded too, since decoding reads the
		// unfiltered samples of the row above. `complete` filters the rest and
		// waits for it. In MBAFF frames (`adaptive`) rows go pair by pair.
		def start(p H264Picture, qpGrid int[], nzcGrid int[], cbpGrid int[], sliceParams int[], chromaFormat int, adaptive bool) {
			pic = p
			chroma = chromaFormat != 0
			full = chromaFormat == 3
			c422 = chromaFormat == 2
			mbaff = adaptive
			shift = p.depth - 8
			bd = 6 * shift
			max = (1 << p.depth) - 1
			qp = qpGrid
			nzc = nzcGrid
			cbp = cbpGrid
			params = sliceParams
			wMbs = p.widthMbs
			hMbs = p.heightMbs
			gw = wMbs * 4
			progress = new channel<int>(size = hMbs + 4)
			done = new channel<bool>(size = 1)
			async work()
		}

		// Reports that the first `rows` macroblock rows are decoded.
		def advance(rows int) {
			progress <- rows
		}

		// Filters what is left and waits until the whole picture is
		// filtered.
		def complete() {
			progress <- -1
			<-done
		}

		// The filtering task: filters each row once the row under it is
		// decoded (the pair under it in MBAFF frames), the rest at the end.
		internal async def work() {
			let next = 0
			let step = mbaff ?? (2, 1)
			for {
				let rows = <-progress
				let upTo = rows < 0 ?? (hMbs, rows - step)
				// Whole rows, pairs in MBAFF frames.
				upTo = upTo - upTo % step
				if upTo > next {
					if pic.depth == 8 {
						filterRows(pic.samples8, next, upTo, h264FilterEdgeBytes)
					} else {
						filterRows(pic.samples16, next, upTo, def (s uint16[], off int, across int, along int, lines int, bs int[], ia int, ib int, chroma bool, shift int, max int) {
							h264FilterEdge(s, off, across, along, lines, bs, ia, ib, chroma, shift, max)
						})
					}
					next = upTo
				}
				break when rows < 0
			}
			done <- true
		}

		// Filters macroblock rows `from` up to `to`, in decoding order.
		// `edge` filters the luma edges of whole macroblocks (see
		// `h264FilterEdge`): the SIMD filter for 8-bit samples.
		def filterRows<T: H264Sample>(pl H264Planes<T>, from int, to int, edge def(T[], int, int, int, int, int[], int, int, bool, int, int)) {
			if mbaff {
				for let row = from; row < to; row += 2 {
					for let mbx = 0; mbx < wMbs; mbx++ {
						filterMb(pl, mbx, row, edge)
						filterMb(pl, mbx, row + 1, edge)
					}
				}
				return
			}
			for let mby = from; mby < to; mby++ {
				for let mbx = 0; mbx < wMbs; mbx++ {
					filterMb(pl, mbx, mby, edge)
				}
			}
		}

		def isField(mb int) bool {
			return mbaff && (pic.mbType[mb] & h264MbField) != 0
		}

		def isIntra(mb int) bool {
			return (pic.mbType[mb] & h264MbIntra) != 0
		}

		// Whether the 4x4 block at grid index `g` of macroblock `mb` has
		// non-zero coefficients, taking the 8x8 block for 8x8 transforms.
		def nonZero(mb int, g int) bool {
			if (pic.mbType[mb] & h264MbDct8) != 0 {
				let gx = (g % gw) & ~1
				let gy = (g / gw) & ~1
				let b = gy * gw + gx
				return nzc[b] != 0 || nzc[b + 1] != 0 || nzc[b + gw] != 0 || nzc[b + gw + 1] != 0
			}
			return nzc[g] != 0
		}

		// Boundary strength between the 4x4 blocks at grid indices gp and gq
		// of inter macroblocks mbp and mbq.
		def strength(mbp int, gp int, mbq int, gq int) int {
			return 2 when nonZero(mbp, gp) || nonZero(mbq, gq)
			let p0 = pic.uid0[gp]
			let p1 = pic.uid1[gp]
			let q0 = pic.uid0[gq]
			let q1 = pic.uid1[gq]
			let np = (p0 >= 0 ?? (1, 0)) + (p1 >= 0 ?? (1, 0))
			let nq = (q0 >= 0 ?? (1, 0)) + (q1 >= 0 ?? (1, 0))
			return 1 when np != nq
			if np == 1 {
				return 1 when (p0 >= 0 ?? (p0, p1)) != (q0 >= 0 ?? (q0, q1))
				return moved(p0 >= 0 ?? (0, 1), gp, q0 >= 0 ?? (0, 1), gq) ?? (1, 0)
			}
			return 1 unless (p0 == q0 && p1 == q1) || (p0 == q1 && p1 == q0)
			// Differences of the same-list and crossed pairings.
			let straight = moved(0, gp, 0, gq) || moved(1, gp, 1, gq)
			let crossed = moved(0, gp, 1, gq) || moved(1, gp, 0, gq)
			return (p0 == q0 ?? (straight, crossed)) ?? (1, 0) when p0 != p1
			return (straight && crossed) ?? (1, 0)
		}

		// Whether the vector of list `la` at block `a` and that of list `lb`
		// at block `b` differ by a whole sample or more (`mvy` quarters
		// vertically). The grids are indexed in place: a local alias of one
		// would be retained on every call.
		def moved(la int, a int, lb int, b int) bool {
			let ax = la == 0 ?? (pic.mv0[2 * a], pic.mv1[2 * a])
			let ay = la == 0 ?? (pic.mv0[2 * a + 1], pic.mv1[2 * a + 1])
			let bx = lb == 0 ?? (pic.mv0[2 * b], pic.mv1[2 * b])
			let by = lb == 0 ?? (pic.mv0[2 * b + 1], pic.mv1[2 * b + 1])
			let dx = ax - bx
			let dy = ay - by
			return (dx ^ (dx >> 63)) - (dx >> 63) >= 4 || (dy ^ (dy >> 63)) - (dy >> 63) >= mvy
		}

		// Filters the edges of one macroblock: vertical ones first, then
		// horizontal ones.
		def filterMb<T: H264Sample>(pl H264Planes<T>, mbx int, mby int, edge def(T[], int, int, int, int, int[], int, int, bool, int, int)) {
			// Held in locals for the edge calls: passing a field retains it
			// each time.
			let ys = pl.y
			let us = pl.u
			let vs = pl.v
			let strengths = bs
			let mb = mby * wMbs + mbx
			let slice = pic.sliceOfMb[mb]
			return when slice < 0
			let po = slice * 5
			let idc = params[po]
			return when idc == 1
			let offA = params[po + 1]
			let offB = params[po + 2]
			let cbOff = params[po + 3]
			let crOff = params[po + 4]
			let t = pic.mbType[mb]
			let intra = (t & h264MbIntra) != 0
			let dct8 = (t & h264MbDct8) != 0
			let field = isField(mb)
			// Vertical vector difference that makes a strength 1: 4 quarter
			// samples, 2 in fields, whose vectors count field lines.
			mvy = (pic.parity != 0 || field) ?? (2, 4)
			// One motion for the whole macroblock and no luma coefficients:
			// the internal edges all have strength 0.
			let plain = !intra && (t & h264Mb16x16) != 0 && (cbp[mb] & 15) == 0
			let stride = pic.stride
			let cs = pic.chromaStride
			let rows = c422 ?? (16, 8)
			// The macroblock's first luma and chroma samples and its line
			// steps: a field macroblock has every other line of its pair.
			let ls = field ?? (stride * 2, stride)
			let cls = field ?? (cs * 2, cs)
			let y0 = pic.base + mbx * 16
			let c0 = pic.cbase + mbx * 8
			if field {
				y0 += ((mby >> 1) * 32 + (mby & 1)) * stride
				c0 += ((mby >> 1) * 2 * rows + (mby & 1)) * cs
			} else {
				y0 += mby * 16 * stride
				c0 += mby * rows * cs
			}
			// The left and top neighbours whose edges are filtered, -1 when
			// none.
			let left = -1
			let mixedLeft = false
			if mbx > 0 {
				left = mb - 1
				if mbaff {
					let pairTop = (mby & ~1) * wMbs + mbx - 1
					if isField(pairTop) != field {
						mixedLeft = true
						left = pairTop
					}
				}
				left = -1 when idc == 2 && pic.sliceOfMb[left] != slice
			}
			let top = -1
			// A frame macroblock under a field pair filters its top edge
			// once per field.
			let fieldsAbove = false
			if mbaff {
				if field {
					if (mby & 1) == 1 {
						top = mby >= 3 ?? (mb - 2 * wMbs, -1)
					} else if mby >= 2 {
						top = isField(mb - 2 * wMbs) ?? (mb - 2 * wMbs, mb - wMbs)
					}
				} else if (mby & 1) == 1 {
					top = mb - wMbs
				} else if mby >= 2 {
					top = mb - wMbs
					fieldsAbove = isField(top)
				}
			} else if mby > 0 {
				top = mb - wMbs
			}
			top = -1 when top >= 0 && idc == 2 && pic.sliceOfMb[top] != slice
			let g0 = mby * 4 * gw + mbx * 4
			if mixedLeft {
				filterMixedLeft(pl, mb, left, field, mby, y0, c0, ls, cls, rows, offA, offB, cbOff, crOff)
			}
			// Vertical edges, then horizontal ones.
			for let dir = 0; dir < 2; dir++ {
				for let e = 0; e < 4; e++ {
					let edgeMb = e == 0
					// Inside an 8x8 transform only 4:2:2 chroma has
					// horizontal edges.
					let lumaEdge = true
					let mbp = mb
					if edgeMb {
						if dir == 1 && fieldsAbove && top >= 0 {
							filterFieldsAbove(pl, mb, mbx, mby, y0, c0, ls, cls, rows, offA, offB, cbOff, crOff, edge)
							continue
						}
						mbp = dir == 0 ?? (left, top)
						continue when mbp < 0 || (dir == 0 && mixedLeft)
					} else if plain {
						continue
					} else if dct8 && (e & 1) == 1 {
						continue unless c422 && dir == 1
						lumaEdge = false
					}
					let intraP = isIntra(mbp)
					// Across a horizontal macroblock edge next to a field
					// macroblock, or in a field, the lines are two apart:
					// strength 3 at most, and 1 for motion between a field
					// and a frame macroblock.
					let fieldEdge = dir == 1 && (pic.parity != 0 || field || isField(mbp))
					let mixed = edgeMb && dir == 1 && field != isField(mbp)
					let any = false
					for let k = 0; k < 4; k++ {
						let gq = dir == 0 ?? (g0 + k * gw + e, g0 + e * gw + k)
						let gp = gq - (dir == 0 ?? (1, gw))
						if edgeMb {
							let pRow = mbp / wMbs
							gp = dir == 0 ?? (gq - 1, (pRow * 4 + 3) * gw + mbx * 4 + k)
						}
						let s = 0
						if intra || intraP {
							s = (edgeMb && !fieldEdge) ?? (4, 3)
						} else if mixed {
							s = (nonZero(mbp, gp) || nonZero(mb, gq)) ?? (2, 1)
						} else {
							s = strength(mbp, gp, mb, gq)
						}
						bs[k] = s
						any = true when s > 0
					}
					continue unless any
					let across = dir == 0 ?? (1, ls)
					let lOff = y0 + (dir == 0 ?? (e * 4, e * 4 * ls))
					let cy = c422 ?? (e * 4, e * 2)
					let cOff = c0 + (dir == 0 ?? (e * 2, cy * cls))
					let chromaEdge = full || ((e & 1) == 0 || (c422 && dir == 1))
					filterEdgeOf(ys, us, vs, strengths, mbp, mb, lOff, cOff, across, dir == 0 ?? (1, cls), dir, ls, cls, rows, offA, offB, cbOff, crOff, lumaEdge, chromaEdge, edge)
				}
			}
		}

		// Filters one edge of all planes with the strengths in `bs`: luma
		// at `lOff`, chroma at `cOff`; `dir` 0 for a vertical edge. QPs are
		// averaged between `mbp` and `mbq`.
		def filterEdgeOf<T: H264Sample>(ys T[], us T[], vs T[], strengths int[], mbp int, mbq int, lOff int, cOff int, across int, cAcross int, dir int, ls int, cls int, rows int, offA int, offB int, cbOff int, crOff int, lumaEdge bool, chromaEdge bool, edge def(T[], int, int, int, int, int[], int, int, bool, int, int)) {
			let qpp = qp[mbp]
			let qpq = qp[mbq]
			let qav = ((qpp + qpq + 1) >> 1) - bd
			let along = dir == 0 ?? (ls, 1)
			edge(ys, lOff, across, along, 16, strengths, qav + offA, qav + offB, false, shift, max) when lumaEdge
			return unless chroma && chromaEdge
			let qcb = ((h264ChromaQpOf(qpp, cbOff, bd) + h264ChromaQpOf(qpq, cbOff, bd) + 1) >> 1) - bd
			let qcr = ((h264ChromaQpOf(qpp, crOff, bd) + h264ChromaQpOf(qpq, crOff, bd) + 1) >> 1) - bd
			if full {
				h264FilterEdge(us, lOff, across, along, 16, strengths, qcb + offA, qcb + offB, false, shift, max)
				h264FilterEdge(vs, lOff, across, along, 16, strengths, qcr + offA, qcr + offB, false, shift, max)
				return
			}
			let calong = dir == 0 ?? (cls, 1)
			let clines = dir == 0 ?? (rows, 8)
			h264FilterEdge(us, cOff, cAcross, calong, clines, strengths, qcb + offA, qcb + offB, true, shift, max)
			h264FilterEdge(vs, cOff, cAcross, calong, clines, strengths, qcr + offA, qcr + offB, true, shift, max)
		}

		// The top edge of a frame macroblock under a field pair: filtered
		// once per field, against the field macroblock of that parity, with
		// strength 3 at most.
		def filterFieldsAbove<T: H264Sample>(pl H264Planes<T>, mb int, mbx int, mby int, y0 int, c0 int, ls int, cls int, rows int, offA int, offB int, cbOff int, crOff int, edge def(T[], int, int, int, int, int[], int, int, bool, int, int)) {
			let stride = pic.stride
			let cs = pic.chromaStride
			let g0 = mby * 4 * gw + mbx * 4
			let intra = isIntra(mb)
			for let j = 0; j < 2; j++ {
				let mbp = mb - (2 - j) * wMbs
				for let k = 0; k < 4; k++ {
					if intra || isIntra(mbp) {
						bs[k] = 3
					} else {
						let gp = ((mby - 2 + j) * 4 + 3) * gw + mbx * 4 + k
						bs[k] = (nonZero(mb, g0 + k) || nonZero(mbp, gp)) ?? (2, 1)
					}
				}
				filterEdgeOf(pl.y, pl.u, pl.v, bs, mbp, mb, y0 + j * stride, c0 + j * cs, 2 * stride, 2 * cs, 1, ls, cls, rows, offA, offB, cbOff, crOff, true, true, edge)
			}
		}

		// The left edge of a macroblock whose left pair `leftTop` (and the
		// macroblock under it) is of the other kind: each two lines of the
		// edge meet their own neighbour, with strength 4 for intra and at
		// least 1 otherwise. A field macroblock meets the upper left
		// macroblock with its first half of lines, a frame macroblock meets
		// the upper left field with its even lines.
		def filterMixedLeft<T: H264Sample>(pl H264Planes<T>, mb int, leftTop int, field bool, mby int, y0 int, c0 int, ls int, cls int, rows int, offA int, offB int, cbOff int, crOff int) {
			let g0 = mby * 4 * gw + (mb % wMbs) * 4
			let intra = isIntra(mb)
			for let i = 0; i < 8; i++ {
				let j = field ?? (i >> 2, i & 1)
				let nb = leftTop + j * wMbs
				if intra || isIntra(nb) {
					bs8[i] = 4
					continue
				}
				// The neighbour's 4x4 row these lines meet.
				let row = field ?? (i & 3, (mby & 1) * 2 + (i >> 2))
				let gp = ((nb / wMbs) * 4 + row) * gw + (nb % wMbs) * 4 + 3
				bs8[i] = (nonZero(mb, g0 + (i >> 1) * gw) || nonZero(nb, gp)) ?? (2, 1)
			}
			let stride = pic.stride
			let cs = pic.chromaStride
			for let j = 0; j < 2; j++ {
				let nb = leftTop + j * wMbs
				for let k = 0; k < 4; k++ {
					half[k] = field ?? (bs8[j * 4 + k], bs8[2 * k + j])
				}
				// Field: lines 8j to 8j + 7 of the macroblock. Frame: its
				// even (j 0) or odd lines.
				let lOff = field ?? (y0 + 8 * j * ls, y0 + j * stride)
				let along = field ?? (ls, 2 * stride)
				let cOff = field ?? (c0 + (rows >> 1) * j * cls, c0 + j * cs)
				let calong = field ?? (cls, 2 * cs)
				filterHalf(pl, nb, mb, lOff, along, cOff, calong, rows >> 1, offA, offB, cbOff, crOff)
			}
		}

		// Filters 8 luma lines and `clines` chroma lines of a vertical edge
		// with the strengths in `half`, two luma lines each.
		def filterHalf<T: H264Sample>(pl H264Planes<T>, mbp int, mbq int, lOff int, along int, cOff int, calong int, clines int, offA int, offB int, cbOff int, crOff int) {
			let qpp = qp[mbp]
			let qpq = qp[mbq]
			let qav = ((qpp + qpq + 1) >> 1) - bd
			h264FilterEdge(pl.y, lOff, 1, along, 8, half, qav + offA, qav + offB, false, shift, max)
			return unless chroma
			let qcb = ((h264ChromaQpOf(qpp, cbOff, bd) + h264ChromaQpOf(qpq, cbOff, bd) + 1) >> 1) - bd
			let qcr = ((h264ChromaQpOf(qpp, crOff, bd) + h264ChromaQpOf(qpq, crOff, bd) + 1) >> 1) - bd
			if full {
				h264FilterEdge(pl.u, lOff, 1, along, 8, half, qcb + offA, qcb + offB, false, shift, max)
				h264FilterEdge(pl.v, lOff, 1, along, 8, half, qcr + offA, qcr + offB, false, shift, max)
				return
			}
			h264FilterEdge(pl.u, cOff, 1, calong, clines, half, qcb + offA, qcb + offB, true, shift, max)
			h264FilterEdge(pl.v, cOff, 1, calong, clines, half, qcr + offA, qcr + offB, true, shift, max)
		}
	}

	// The chroma QP'c for luma QP'y `qp` (both offset by `bd`, 6 per bit
	// beyond 8) and a chroma_qp_index_offset.
	def h264ChromaQpOf(qp int, offset int, bd int) int {
		let q = qp - bd + offset
		q = q < 0 - bd ?? (0 - bd, q > 51 ?? (51, q))
		return (q < 0 ?? (q, h264ChromaQp[q])) + bd
	}

	// Filters one edge of `lines` sample lines: `across` steps over the
	// edge, `along` from one line to the next; each strength in `bs` covers
	// a quarter of the lines.
	def h264FilterEdge<T: H264Sample>(s T[], off int, across int, along int, lines int, bs int[], indexA int, indexB int, chroma bool, shift int, max int) {
		let ia = h264Clip3(0, 51, indexA)
		let ib = h264Clip3(0, 51, indexB)
		let alpha = h264Alpha[ia] << shift
		let beta = h264Beta[ib] << shift
		return when alpha == 0 || beta == 0
		let per = lines >> 2
		let small = (alpha >> 2) + 2
		for let g = 0; g < 4; g++ {
			let strength = bs[g]
			continue when strength == 0
			let tc0 = 0
			tc0 = h264Tc0[ia * 3 + strength - 1] << shift when strength < 4
			for let k = g * per; k < (g + 1) * per; k++ {
				let p = off + k * along
				let p0 = int(s[p - across])
				let q0 = int(s[p])
				let d0 = p0 - q0
				let a0 = (d0 ^ (d0 >> 63)) - (d0 >> 63)
				continue when a0 >= alpha
				let p1 = int(s[p - 2 * across])
				let d1 = p1 - p0
				continue when ((d1 ^ (d1 >> 63)) - (d1 >> 63)) >= beta
				let q1 = int(s[p + across])
				let d2 = q1 - q0
				continue when ((d2 ^ (d2 >> 63)) - (d2 >> 63)) >= beta
				if chroma {
					if strength < 4 {
						let tc = tc0 + 1
						let delta = (((q0 - p0) << 2) + (p1 - q1) + 4) >> 3
						delta = delta < 0 - tc ?? (0 - tc, delta > tc ?? (tc, delta))
						s[p - across] = T(h264ClipMax(p0 + delta, max))
						s[p] = T(h264ClipMax(q0 - delta, max))
					} else {
						s[p - across] = T((2 * p1 + p0 + q1 + 2) >> 2)
						s[p] = T((2 * q1 + q0 + p1 + 2) >> 2)
					}
					continue
				}
				let p2 = int(s[p - 3 * across])
				let q2 = int(s[p + 2 * across])
				let dp = p2 - p0
				let dq = q2 - q0
				let pSmooth = ((dp ^ (dp >> 63)) - (dp >> 63)) < beta
				let qSmooth = ((dq ^ (dq >> 63)) - (dq >> 63)) < beta
				if strength < 4 {
					let tc = tc0 + (pSmooth ?? (1, 0)) + (qSmooth ?? (1, 0))
					let delta = (((q0 - p0) << 2) + (p1 - q1) + 4) >> 3
					delta = delta < 0 - tc ?? (0 - tc, delta > tc ?? (tc, delta))
					s[p - across] = T(h264ClipMax(p0 + delta, max))
					s[p] = T(h264ClipMax(q0 - delta, max))
					let avg = (p0 + q0 + 1) >> 1
					if pSmooth {
						let e = (p2 + avg - (p1 << 1)) >> 1
						s[p - 2 * across] = T(p1 + (e < 0 - tc0 ?? (0 - tc0, e > tc0 ?? (tc0, e))))
					}
					if qSmooth {
						let e = (q2 + avg - (q1 << 1)) >> 1
						s[p + across] = T(q1 + (e < 0 - tc0 ?? (0 - tc0, e > tc0 ?? (tc0, e))))
					}
				} else {
					let near = a0 < small
					if pSmooth && near {
						let p3 = int(s[p - 4 * across])
						s[p - across] = T((p2 + 2 * p1 + 2 * p0 + 2 * q0 + q1 + 4) >> 3)
						s[p - 2 * across] = T((p2 + p1 + p0 + q0 + 2) >> 2)
						s[p - 3 * across] = T((2 * p3 + 3 * p2 + p1 + p0 + q0 + 4) >> 3)
					} else {
						s[p - across] = T((2 * p1 + p0 + q1 + 2) >> 2)
					}
					if qSmooth && near {
						let q3 = int(s[p + 3 * across])
						s[p] = T((p1 + 2 * p0 + 2 * q0 + 2 * q1 + q2 + 4) >> 3)
						s[p + across] = T((p0 + q0 + q1 + q2 + 2) >> 2)
						s[p + 2 * across] = T((2 * q3 + 3 * q2 + q1 + q0 + p0 + 4) >> 3)
					} else {
						s[p] = T((2 * q1 + q0 + p1 + 2) >> 2)
					}
				}
			}
		}
	}
}
