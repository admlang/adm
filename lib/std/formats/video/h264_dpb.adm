internal partial module std.formats.video.h264 {
	// H264Dpb is the decoded picture buffer: the reference pictures and the
	// pictures waiting for their turn to be shown, with the picture order
	// count and reference marking state that goes with them.
	type H264Dpb {
		// Pictures held for reference or output, in decoding order.
		frames             H264Picture[]
		pool               H264Picture[]
		nextUid            int           = 1
		// Largest number of pictures held, and of pictures held back for
		// reordering.
		size               int           = 16
		reorder            int           = 16
		maxFrameNum        int           = 16
		maxLongTermIdx     int           = -1
		// Picture order count state carried from picture to picture.
		prevPocMsb         int
		prevPocLsb         int
		prevFrameNumOffset int
		prevFrameNum       int
		prevRefFrameNum    int
		prevHadMmco5       bool
		frameNumOffset     int
		pocMsb             int
		// Pictures ready to be shown, in presentation order.
		ready              H264Picture[]
		// Reference lists of the current slice.
		list0              H264Picture[]
		list1              H264Picture[]
		count0             int
		count1             int

		def new() {
			frames = H264Picture[]
			pool = H264Picture[]
			ready = H264Picture[]
			list0 = H264Picture[]
			list1 = H264Picture[]
		}

		// A picture buffer sized for `sps`, reused when one is free.
		def acquire(sps H264Sps) H264Picture {
			let pic = new H264Picture()
			pic = pool.pop() when pool.len() > 0
			pic.allocate(sps.widthMbs, sps.heightMbs, sps.chromaFormat, sps.bitDepthLuma)
			pic.start()
			// Frames take multiples of 4; their fields add their parity (1, 2).
			pic.uid = nextUid * 4
			nextUid++
			return pic
		}

		def release(pic H264Picture) {
			pool.push(pic) when pool.len() < 20
		}

		// Drops the pictures that are neither references nor waiting to be
		// shown.
		def prune() {
			let kept = H264Picture[]
			for let p in frames {
				if p.ref != h264RefUnused || p.needOutput || p.pairing {
					kept.push(p)
				} else {
					release(p)
				}
			}
			frames = kept
		}

		// Moves the waiting picture with the lowest order count to `ready`.
		def bump() bool {
			let best = -1
			for let i = 0; i < frames.len(); i++ {
				let p = frames[i]
				best = i when p.needOutput && (best < 0 || p.poc < frames[best].poc)
			}
			return false when best < 0
			let p = frames[best]
			p.needOutput = false
			ready.push(p)
			return true
		}

		def waiting() int {
			let n = 0
			for let p in frames {
				n++ when p.needOutput
			}
			return n
		}

		// Shows every waiting picture, in order.
		def flushOutput() {
			for bump() {}
			prune()
		}

		// Forgets every picture, shown or not.
		def clear() {
			for let p in frames {
				unref(p)
				p.needOutput = false
				p.pairing = false
			}
			prune()
		}

		// Marks both fields of `p` unused for reference.
		def unref(p H264Picture) {
			p.ref = h264RefUnused
			p.refFields = 0
		}

		// Marks field `bits` (1 top, 2 bottom, 3 both) of `p` unused, and
		// the whole frame once neither field is marked.
		def unrefFields(p H264Picture, bits int) {
			p.refFields = p.refFields & (3 - bits)
			p.ref = h264RefUnused when p.refFields == 0
		}

		// Stores a decoded picture and shows those whose turn has come.
		def store(pic H264Picture) {
			prune()
			let held = false
			for let p in frames {
				held = true when p.uid == pic.uid
			}
			frames.push(pic) unless held
			for waiting() > reorder || frames.len() > size {
				break unless bump()
				prune()
			}
			prune()
		}

		// Computes the picture order count of the current picture.
		// For a field (h.structure() 1 or 2) only its own order count is set,
		// and the frame's count becomes the smaller of its decoded fields'.
		def computePoc(pic H264Picture, h H264SliceHeader, sps H264Sps) {
			let st = h.structure()
			let top = pic.topPoc
			let bottom = pic.bottomPoc
			fieldPoc(pic, h, sps)
			if st == 1 {
				pic.bottomPoc = bottom
			} else if st == 2 {
				pic.topPoc = top
			}
			let decoded = pic.fields | st
			if decoded == 1 {
				pic.poc = pic.topPoc
			} else if decoded == 2 {
				pic.poc = pic.bottomPoc
			} else {
				pic.poc = pic.topPoc < pic.bottomPoc ?? (pic.topPoc, pic.bottomPoc)
			}
		}

		// The order counts of the picture `h` codes, into pic.topPoc and
		// pic.bottomPoc (both for a frame).
		def fieldPoc(pic H264Picture, h H264SliceHeader, sps H264Sps) {
			let maxFn = 1 << sps.log2MaxFrameNum
			let st = h.structure()
			if sps.pocType == 0 {
				if h.idr {
					prevPocMsb = 0
					prevPocLsb = 0
				}
				let maxLsb = 1 << sps.log2MaxPocLsb
				let lsb = h.pocLsb
				let msb = prevPocMsb
				if lsb < prevPocLsb && prevPocLsb - lsb >= maxLsb / 2 {
					msb = prevPocMsb + maxLsb
				} else if lsb > prevPocLsb && lsb - prevPocLsb > maxLsb / 2 {
					msb = prevPocMsb - maxLsb
				}
				pocMsb = msb
				pic.topPoc = msb + lsb
				pic.bottomPoc = st == 2 ?? (msb + lsb, pic.topPoc + h.deltaPocBottom)
			} else {
				let prevOffset = prevHadMmco5 ?? (0, prevFrameNumOffset)
				if h.idr {
					frameNumOffset = 0
				} else if prevFrameNum > h.frameNum {
					frameNumOffset = prevOffset + maxFn
				} else {
					frameNumOffset = prevOffset
				}
				if sps.pocType == 1 {
					let n = sps.offsetForRefFrame.len()
					let abs = n != 0 ?? (frameNumOffset + h.frameNum, 0)
					abs-- when h.nalRefIdc == 0 && abs > 0
					let expected = 0
					if abs > 0 {
						let cycles = (abs - 1) / n
						let inCycle = (abs - 1) % n
						let delta = 0
						for let i = 0; i < n; i++ {
							delta += sps.offsetForRefFrame[i]
						}
						expected = cycles * delta
						for let i = 0; i <= inCycle; i++ {
							expected += sps.offsetForRefFrame[i]
						}
					}
					expected += sps.offsetForNonRefPic when h.nalRefIdc == 0
					pic.topPoc = expected + h.deltaPoc0
					pic.bottomPoc = st == 2 ?? (expected + sps.offsetForTopToBottom + h.deltaPoc0, pic.topPoc + sps.offsetForTopToBottom + h.deltaPoc1)
				} else {
					let t = 0
					if !h.idr {
						t = 2 * (frameNumOffset + h.frameNum)
						t-- when h.nalRefIdc == 0
					}
					pic.topPoc = t
					pic.bottomPoc = t
				}
			}
		}

		// Records the state the next picture's order count derives from, once
		// the current picture is marked.
		def finishPoc(pic H264Picture, h H264SliceHeader) {
			if h.nalRefIdc != 0 {
				if pic.mmco5 {
					prevPocMsb = 0
					prevPocLsb = h.structure() == 2 ?? (0, pic.topPoc)
				} else {
					prevPocMsb = pocMsb
					prevPocLsb = h.pocLsb
				}
			}
			prevHadMmco5 = pic.mmco5
			prevFrameNumOffset = frameNumOffset
			prevFrameNum = pic.mmco5 ?? (0, h.frameNum)
			prevRefFrameNum = pic.mmco5 ?? (0, h.frameNum) when h.nalRefIdc != 0
		}

		def refCount() int {
			let n = 0
			for let p in frames {
				n++ when p.ref != h264RefUnused
			}
			return n
		}

		// Marks the oldest short-term reference unused when the window is
		// full.
		def slidingWindow(maxRefs int) {
			let limit = maxRefs < 1 ?? (1, maxRefs)
			for refCount() >= limit {
				let oldest = -1
				for let i = 0; i < frames.len(); i++ {
					let p = frames[i]
					oldest = i when p.ref == h264RefShort && (oldest < 0 || p.frameNumWrap < frames[oldest].frameNumWrap)
				}
				break when oldest < 0
				unref(frames[oldest])
			}
		}

		// Updates FrameNumWrap of the short-term references for the current
		// frame_num.
		def wrapFrameNums(frameNum int) {
			for let p in frames {
				p.frameNumWrap = p.frameNum > frameNum ?? (p.frameNum - maxFrameNum, p.frameNum) when p.ref == h264RefShort
			}
		}

		def shortByPicNum(picNum int) int {
			for let i = 0; i < frames.len(); i++ {
				let p = frames[i]
				return i when p.ref == h264RefShort && p.frameNumWrap == picNum
			}
			return -1
		}

		def longByIdx(idx int) int {
			for let i = 0; i < frames.len(); i++ {
				let p = frames[i]
				return i when p.ref == h264RefLong && p.longTermIdx == idx
			}
			return -1
		}

		// The short-term reference a picture number names: in a field (`st`
		// 1 or 2), an odd number is a field of the same parity, an even one
		// of the other. Returns the frame's index and the field bits, -1 when
		// none is marked.
		def shortByNum(num int, st int) (int, int) {
			if st == 3 {
				return (shortByPicNum(num), 3)
			}
			let bits = (num & 1) == 1 ?? (st, 3 - st)
			let wrap = num >> 1
			for let i = 0; i < frames.len(); i++ {
				let p = frames[i]
				return (i, bits) when p.ref == h264RefShort && p.frameNumWrap == wrap && (p.refFields & bits) != 0
			}
			return (-1, bits)
		}

		// The long-term reference a long-term picture number names, as
		// `shortByNum`.
		def longByNum(num int, st int) (int, int) {
			return (longByIdx(num), 3) when st == 3
			let bits = (num & 1) == 1 ?? (st, 3 - st)
			let i = longByIdx(num >> 1)
			return (i, bits) when i >= 0 && (frames[i].refFields & bits) != 0
			return (-1, bits)
		}

		// Applies the reference picture marking of the decoded picture `pic`,
		// a frame or one field of it. `second` is set for the second field of
		// a frame whose first field is already stored.
		def mark(pic H264Picture, h H264SliceHeader, sps H264Sps, second bool) {
			return when h.nalRefIdc == 0
			let st = h.structure()
			if h.idr {
				if !second {
					for let p in frames {
						unref(p) when p.uid != pic.uid
					}
				}
				pic.refFields = pic.refFields | st
				if h.longTermReference {
					pic.ref = h264RefLong
					pic.longTermIdx = 0
					maxLongTermIdx = 0
				} else {
					pic.ref = h264RefShort
					maxLongTermIdx = -1
				}
				return
			}
			// Picture numbers: 2 * frame_num + 1 for a field, frame_num for a
			// frame.
			let currNum = st == 3 ?? (h.frameNum, 2 * h.frameNum + 1)
			// The second field of a frame whose first field is a reference
			// joins it without taking another slot.
			let joins = second && pic.refFields != 0
			let current = false
			wrapFrameNums(h.frameNum)
			if h.adaptiveMarking {
				let ops = h.mmco
				for let k = 0; k + 2 < ops.len(); k += 3 {
					let op = ops[k]
					let a = ops[k + 1]
					let b = ops[k + 2]
					if op == 1 {
						let (i, bits) = shortByNum(currNum - (a + 1), st)
						unrefFields(frames[i], bits) when i >= 0
					} else if op == 2 {
						let (i, bits) = longByNum(a, st)
						unrefFields(frames[i], bits) when i >= 0
					} else if op == 3 {
						let (i, _) = shortByNum(currNum - (a + 1), st)
						if i >= 0 {
							let j = longByIdx(b)
							unref(frames[j]) when j >= 0 && j != i
							frames[i].ref = h264RefLong
							frames[i].longTermIdx = b
						}
					} else if op == 4 {
						maxLongTermIdx = a - 1
						for let p in frames {
							unref(p) when p.ref == h264RefLong && p.longTermIdx > maxLongTermIdx
						}
					} else if op == 5 {
						for let p in frames {
							unref(p)
						}
						maxLongTermIdx = -1
						pic.mmco5 = true
					} else if op == 6 {
						let j = longByIdx(b)
						unref(frames[j]) when j >= 0 && frames[j].uid != pic.uid
						pic.ref = h264RefLong
						pic.longTermIdx = b
						pic.refFields = pic.refFields | st
						current = true
					}
				}
			} else if !joins {
				slidingWindow(sps.maxNumRefFrames)
			}
			if !current {
				if joins && pic.ref == h264RefShort {
					pic.refFields = pic.refFields | st
				} else {
					pic.ref = h264RefShort
					pic.refFields = pic.refFields | st
					if !second {
						let limit = sps.maxNumRefFrames < 1 ?? (1, sps.maxNumRefFrames)
						slidingWindow(limit) when refCount() >= limit
					}
				}
			}
			if pic.mmco5 {
				if st == 3 {
					let temp = pic.poc
					pic.topPoc -= temp
					pic.bottomPoc -= temp
				} else if st == 1 {
					pic.topPoc = 0
				} else {
					pic.bottomPoc = 0
				}
				pic.poc = 0
				pic.frameNum = 0
			}
			// Stand-ins for lost pictures leave once more frame numbers than
			// the stream keeps references for lie between them and the
			// current picture: a stream joined midway would otherwise keep
			// them in its lists for good.
			for let p in frames {
				if p.invalidGap && p.ref == h264RefShort {
					unref(p) when (pic.frameNum - p.frameNum + maxFrameNum) % maxFrameNum > sps.maxNumRefFrames
				}
			}
		}

		// Inserts the frames a gap in frame_num implies, as short-term
		// references with the samples of the latest reference.
		def fillGap(h H264SliceHeader, sps H264Sps) {
			return when h.idr
			return when h.frameNum == prevRefFrameNum || h.frameNum == (prevRefFrameNum + 1) % maxFrameNum
			let source = latestRef()
			let n = (h.frameNum - prevRefFrameNum - 1 + maxFrameNum) % maxFrameNum
			n = n > sps.maxNumRefFrames + 1 ?? (sps.maxNumRefFrames + 1, n)
			let fn = (h.frameNum - n + maxFrameNum) % maxFrameNum
			for let k = 0; k < n; k++ {
				wrapFrameNums(fn)
				slidingWindow(sps.maxNumRefFrames)
				let pic = acquire(sps)
				if source is H264Picture {
					pic.copySamples(source)
					// On the GPU the stand-in shares its source's buffer.
					pic.surface = source.surface
				} else {
					pic.grey()
				}
				pic.frameNum = fn
				pic.frameNumWrap = fn
				pic.nonExisting = true
				pic.invalidGap = !sps.gapsAllowed
				pic.ref = h264RefShort
				pic.refFields = 3
				pic.poc = 0
				frames.push(pic)
				prevRefFrameNum = fn
				prevFrameNum = fn
				fn = (fn + 1) % maxFrameNum
			}
			prune()
		}

		def latestRef() ?H264Picture {
			for let i = frames.len() - 1; i >= 0; i-- {
				return frames[i] when frames[i].ref != h264RefUnused
			}
			return none
		}

		// Builds the reference lists of a slice of `pic`: the initial order
		// then the slice's modifications. Entries the stream leaves empty are
		// filled so that decoding can go on.
		def buildLists(pic H264Picture, h H264SliceHeader, sps H264Sps) {
			wrapFrameNums(h.frameNum)
			list0 = H264Picture[]
			list1 = H264Picture[]
			count0 = 0
			count1 = 0
			return when h.isI()
			if h.fieldPic {
				fieldLists(pic, h, sps)
				return
			}
			let shorts = H264Picture[]
			let longs = H264Picture[]
			for let p in frames {
				if p.ref == h264RefShort {
					shorts.push(p)
				} else if p.ref == h264RefLong {
					longs.push(p)
				}
			}
			h264SortBy(longs, 2)
			if !h.isB() {
				h264SortBy(shorts, 1)
				for let p in shorts {
					list0.push(p)
				}
				for let p in longs {
					list0.push(p)
				}
			} else {
				let before = H264Picture[]
				let after = H264Picture[]
				for let p in shorts {
					continue when p.nonExisting
					if p.poc < pic.poc {
						before.push(p)
					} else {
						after.push(p)
					}
				}
				h264SortBy(before, 3)
				h264SortBy(after, 4)
				for let p in before {
					list0.push(p)
				}
				for let p in after {
					list0.push(p)
				}
				for let p in after {
					list1.push(p)
				}
				for let p in before {
					list1.push(p)
				}
				for let p in longs {
					list0.push(p)
					list1.push(p)
				}
				if list1.len() > 1 && list0.len() == list1.len() {
					let same = true
					for let i = 0; i < list0.len(); i++ {
						same = false when list0[i].uid != list1[i].uid
					}
					if same {
						let t = list1[0]
						list1[0] = list1[1]
						list1[1] = t
					}
				}
			}
			list0 = modify(list0, 0, h, sps)
			count0 = h.numRefIdxActive[0]
			if h.isB() {
				list1 = modify(list1, 1, h, sps)
				count1 = h.numRefIdxActive[1]
			}
		}

		// The reference lists of a field: the frames holding reference fields,
		// ordered as for a frame, then split into fields alternating between
		// the current field's parity and the other, starting with its own.
		def fieldLists(pic H264Picture, h H264SliceHeader, sps H264Sps) {
			let st = h.structure()
			let curPoc = st == 1 ?? (pic.topPoc, pic.bottomPoc)
			let shorts = H264Picture[]
			let longs = H264Picture[]
			for let p in frames {
				if p.ref == h264RefShort && p.refFields != 0 {
					shorts.push(p)
				} else if p.ref == h264RefLong && p.refFields != 0 {
					longs.push(p)
				}
			}
			h264SortBy(longs, 2)
			if !h.isB() {
				h264SortBy(shorts, 1)
				for let f in splitFields(shorts, st) {
					list0.push(f)
				}
			} else {
				let before = H264Picture[]
				let after = H264Picture[]
				for let p in shorts {
					continue when p.nonExisting
					if p.poc <= curPoc {
						before.push(p)
					} else {
						after.push(p)
					}
				}
				h264SortBy(before, 3)
				h264SortBy(after, 4)
				for let f in splitFields(before.concat(after), st) {
					list0.push(f)
				}
				for let f in splitFields(after.concat(before), st) {
					list1.push(f)
				}
			}
			for let f in splitFields(longs, st) {
				list0.push(f)
				list1.push(f) when h.isB()
			}
			if h.isB() && list1.len() > 1 && list0.len() == list1.len() {
				let same = true
				for let i = 0; i < list0.len(); i++ {
					same = false when list0[i].uid != list1[i].uid
				}
				if same {
					let t = list1[0]
					list1[0] = list1[1]
					list1[1] = t
				}
			}
			list0 = modify(list0, 0, h, sps)
			count0 = h.numRefIdxActive[0]
			if h.isB() {
				list1 = modify(list1, 1, h, sps)
				count1 = h.numRefIdxActive[1]
			}
		}

		// The reference fields of `frames`, alternating between parity `st`
		// and the other: the next frame with a field of each parity marked.
		def splitFields(frames H264Picture[], st int) H264Picture[] {
			let out = H264Picture[]
			let i = int[0, 0]
			for i[0] < frames.len() || i[1] < frames.len() {
				for let k = 0; k < 2; k++ {
					let parity = k == 0 ?? (st, 3 - st)
					for i[k] < frames.len() && (frames[i[k]].refFields & parity) == 0 {
						i[k]++
					}
					if i[k] < frames.len() {
						out.push(h264FieldOf(frames[i[k]], parity))
						i[k]++
					}
				}
			}
			return out
		}

		// Applies the modifications of list `l` to the initial `list`,
		// returning a list of exactly num_ref_idx_active entries.
		def modify(initial H264Picture[], l int, h H264SliceHeader, sps H264Sps) H264Picture[] {
			let n = h.numRefIdxActive[l]
			let list = H264Picture[]
			for let i = 0; i <= n; i++ {
				if i < initial.len() && i < n {
					list.push(initial[i])
				} else {
					list.push(filler(initial, sps))
				}
			}
			let holes = bool[]
			holes.len(n + 1)
			for let i = 0; i <= n; i++ {
				holes[i] = i >= initial.len() || i >= n
			}
			let mods = h.modifications
			let st = h.structure()
			// Picture numbers count fields in a field: twice as many.
			let maxNum = st == 3 ?? (maxFrameNum, 2 * maxFrameNum)
			let currNum = st == 3 ?? (h.frameNum, 2 * h.frameNum + 1)
			let picNumPred = currNum
			let refIdx = 0
			for let k = 0; k + 2 < mods.len(); k += 3 {
				continue when mods[k] != l
				let idc = mods[k + 1]
				let val = mods[k + 2]
				let found = -1
				let bits = 3
				let longTerm = false
				let num = 0
				if idc := 0 || 1 {
					let absDiff = val + 1
					let noWrap = 0
					if idc == 0 {
						noWrap = picNumPred - absDiff
						noWrap += maxNum when noWrap < 0
					} else {
						noWrap = picNumPred + absDiff
						noWrap -= maxNum when noWrap >= maxNum
					}
					picNumPred = noWrap
					num = noWrap > currNum ?? (noWrap - maxNum, noWrap)
					let (fi, fb) = shortByNum(num, st)
					found = fi
					bits = fb
				} else if idc == 2 {
					longTerm = true
					num = val
					let (li, lb) = longByNum(val, st)
					found = li
					bits = lb
				} else {
					continue
				}
				continue when found < 0 || refIdx >= n
				let target = st == 3 ?? (frames[found], h264FieldOf(frames[found], bits))
				for let c = n; c > refIdx; c-- {
					list[c] = list[c - 1]
					holes[c] = holes[c - 1]
				}
				list[refIdx] = target
				holes[refIdx] = false
				refIdx++
				let nIdx = refIdx
				for let c = refIdx; c <= n; c++ {
					let p = list[c]
					let same = holes[c] == false && p.uid == target.uid
					if !same {
						list[nIdx] = p
						holes[nIdx] = holes[c]
						nIdx++
					}
				}
			}
			list.len(n)
			return list
		}

		// The picture used in place of a reference the stream names but the
		// buffer lacks.
		def filler(initial H264Picture[], sps H264Sps) H264Picture {
			return initial[0] when initial.len() > 0
			let latest = latestRef()
			return latest when latest is H264Picture
			for let p in frames {
				return p when p.widthMbs == sps.widthMbs && p.heightMbs == sps.heightMbs && p.chromaFormat == sps.chromaFormat && p.depth == sps.bitDepthLuma
			}
			let g = acquire(sps)
			g.grey()
			g.ref = h264RefShort
			g.refFields = 3
			g.nonExisting = true
			frames.push(g)
			return g
		}
	}

	// Sorts reference pictures: 1 by descending PicNum, 2 by ascending
	// LongTermPicNum, 3 by descending order count, 4 by ascending order
	// count.
	def h264SortBy(list H264Picture[], order int) {
		for let i = 1; i < list.len(); i++ {
			let p = list[i]
			let j = i - 1
			for j >= 0 && h264Before(p, list[j], order) {
				list[j + 1] = list[j]
				j--
			}
			list[j + 1] = p
		}
	}

	def h264Before(a H264Picture, b H264Picture, order int) bool {
		return a.frameNumWrap > b.frameNumWrap when order == 1
		return a.longTermIdx < b.longTermIdx when order == 2
		return a.poc > b.poc when order == 3
		return a.poc < b.poc
	}

	// The field `parity` of frame `f`, labelled for a reference list.
	def h264FieldOf(f H264Picture, parity int) H264Picture {
		let v = f.field(parity)
		v.poc = parity == 1 ?? (f.topPoc, f.bottomPoc)
		v.topPoc = v.poc
		v.bottomPoc = v.poc
		v.uid = f.uid + parity
		v.ref = f.ref
		v.longTermIdx = f.longTermIdx
		v.frameNum = f.frameNum
		v.frameNumWrap = f.frameNumWrap
		v.nonExisting = f.nonExisting
		return v
	}
}
