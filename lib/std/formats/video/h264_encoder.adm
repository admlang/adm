partial module std.formats.video {
	use std.formats.video.h264::(H264PictureEncoder)

	// H264Encoder encodes 8-bit 4:2:0 pictures of one size as H.264
	// (ITU-T H.264) in the Constrained Baseline profile, each from the
	// one before, with an IDR picture first, every `keyInterval`
	// pictures and on request. A packet is one access unit as an Annex B
	// byte stream; an IDR picture's starts with the parameter sets.
	//
	// The bitrate is kept as `VP8Encoder` keeps it: by a leaky bucket
	// that sets each picture's quantiser, codes an IDR picture again
	// when it misses its budget, and repeats the last picture in a few
	// bytes while it holds more than half a second of the bitrate.
	//
	//     let encoder = new video.H264Encoder(1280, 720, 1500000)
	//     let packet = try encoder.encode(frame)
	type H264Encoder {
		width             uint32
		height            uint32
		// Pictures per second the bitrate is spread over.
		frameRate         int                = 30
		// An IDR picture at least this often, in pictures; 0 for the
		// first and on request only.
		keyInterval       int                = 300
		// With 2, every other picture is one no later picture is
		// predicted from (a second temporal layer): a receiver or a
		// relay may drop those and show half the pictures. `layer` says
		// which the last picture was.
		temporalLayers    int                = 1
		internal core     H264PictureEncoder
		internal bucket   RateBucket
		internal sinceKey int                = 0
		internal upper    bool               = false
		internal skipped  bool               = false

		def new(width int, height int, bitsPerSecond int = 1000000, frameRate int = 30) {
			self.width = uint32(width)
			self.height = uint32(height)
			self.frameRate = frameRate.max(1)
			core = new H264PictureEncoder(width, height, self.frameRate)
			// A starting point that suits about 0.1 bit a pixel.
			let perPixel = bitsPerSecond.max(10000) * 1000 / (self.frameRate * width * height).max(1)
			bucket = new RateBucket(h264Steps, h264MinQp, h264MaxQp, 3, 9, bitsPerSecond, self.frameRate, (36 - perPixel / 16).max(20).min(44))
			core.qp = bucket.index
		}

		// encode implements VideoEncoder. Fails for a picture of another
		// size, with other chroma than 4:2:0 or more than 8 bits, or one
		// that is on the GPU, and for an encoder made with an odd width
		// or height.
		def encode(frame VideoFrame, forceKey bool = false) !Packet {
			fail "h264: the encoder takes pictures of even width and height, not {width}x{height}" unless width % 2 == 0 && height % 2 == 0
			fail "h264: the encoder takes {width}x{height} pictures, not {frame.width}x{frame.height}" unless frame.width == width && frame.height == height
			fail "h264: the encoder takes 8-bit 4:2:0 pictures in main memory" unless frame.bitDepth == 8 && frame.chroma == ChromaLayout.Yuv420 && !frame.onGpu
			core.load(frame.y, frame.yStride, frame.u, frame.v, frame.uvStride)
			bucket.frameRate = frameRate.max(1)
			core.frameRate = bucket.frameRate
			core.bitrate = bucket.rate
			let key = forceKey || !core.started || (keyInterval > 0 && sinceKey >= keyInterval)
			// The picture after a kept one is the droppable one.
			upper = temporalLayers > 1 && !key && sinceKey % 2 == 1
			skipped = !key && bucket.full()
			let data byte[]
			if skipped {
				data = core.encode(false, upper, true)
			} else {
				let budget = bucket.budget(key)
				bucket.aim(key, budget)
				core.qp = bucket.index
				data = core.encode(key, upper)
				// An IDR picture is what the pictures behind it are built
				// on: it is coded again, finer or coarser, until it is
				// within its budget and uses most of it (twice at most).
				for let again = 0; key && again < 2 && bucket.refit(data.len() * 8, budget); again++ {
					core.qp = bucket.index
					data = core.encode(true)
				}
				bucket.measure(data.len() * 8, key)
			}
			sinceKey = key ?? (1, sinceKey + 1)
			bucket.spend(data.len() * 8)
			return Packet{track: 0, data: data, pts: frame.time, dts: frame.time, length: frame.length, keyframe: key}
		}

		// setBitrate implements VideoEncoder.
		def setBitrate(bitsPerSecond int) {
			bucket.rate = bitsPerSecond.max(10000)
		}

		// layer is the temporal layer of the picture encoded last: 0 for
		// one later pictures need, 1 for one that may be dropped.
		def layer() int {
			return upper ?? (1, 0)
		}

		// repeated reports whether the last packet repeats the picture
		// before it because the bitrate had no room for a new one.
		def repeated() bool {
			return skipped
		}

		// quantizer is the QP the last picture was coded with, 0 (finest)
		// to 51.
		def quantizer() int {
			return core.qp
		}
	}

	// The quantiser step of each QP, sixteen times over (it doubles every
	// six), and the QPs rate control stays within.
	internal const h264Steps = int[10, 11, 13, 14, 16, 18, 20, 22, 26, 28, 32, 36, 40, 44, 52, 56, 64, 72, 80, 88, 104, 112, 128, 144, 160, 176, 208, 224, 256, 288, 320, 352, 416, 448, 512, 576, 640, 704, 832, 896, 1024, 1152, 1280, 1408, 1664, 1792, 2048, 2304, 2560, 2816, 3328, 3584]
	internal const h264MinQp = 12
	internal const h264MaxQp = 51
}
