internal partial module std.formats.video.h264 {
	// Index of the top-left neighbour in an edge array: the row above runs
	// to the right of it, the column to the left runs down to its left.
	const h264EdgeCorner = 16

	// Fills `e` with the neighbours of the n x n block of `pic` at `off`:
	// the row above (2n samples, the second half repeating the last sample
	// when the top-right is unavailable), the column to the left and the
	// corner. Unavailable neighbours are left untouched.
	def h264GatherEdge<T: H264Sample>(pic T[], off int, stride int, n int, e int[], top bool, left bool, topLeft bool, topRight bool) {
		let c = h264EdgeCorner
		if top {
			let p = off - stride
			for let x = 0; x < n; x++ {
				e[c + 1 + x] = int(pic[p + x])
			}
			if topRight {
				for let x = n; x < 2 * n; x++ {
					e[c + 1 + x] = int(pic[p + x])
				}
			} else {
				let last = e[c + n]
				for let x = n; x < 2 * n; x++ {
					e[c + 1 + x] = last
				}
			}
		}
		if left {
			let p = off - 1
			for let y = 0; y < n; y++ {
				e[c - 1 - y] = int(pic[p + y * stride])
			}
		}
		e[c] = int(pic[off - stride - 1]) when topLeft
	}

	// Smooths the neighbours of an 8x8 block before Intra 8x8 prediction.
	def h264FilterEdge8(e int[], f int[], top bool, left bool, topLeft bool) {
		let c = h264EdgeCorner
		if top {
			if topLeft {
				f[c + 1] = (e[c] + 2 * e[c + 1] + e[c + 2] + 2) >> 2
			} else {
				f[c + 1] = (3 * e[c + 1] + e[c + 2] + 2) >> 2
			}
			for let x = 1; x < 15; x++ {
				f[c + 1 + x] = (e[c + x] + 2 * e[c + 1 + x] + e[c + 2 + x] + 2) >> 2
			}
			f[c + 16] = (e[c + 15] + 3 * e[c + 16] + 2) >> 2
		}
		if topLeft {
			if top && left {
				f[c] = (e[c + 1] + 2 * e[c] + e[c - 1] + 2) >> 2
			} else if top {
				f[c] = (3 * e[c] + e[c + 1] + 2) >> 2
			} else if left {
				f[c] = (3 * e[c] + e[c - 1] + 2) >> 2
			} else {
				f[c] = e[c]
			}
		}
		if left {
			if topLeft {
				f[c - 1] = (e[c] + 2 * e[c - 1] + e[c - 2] + 2) >> 2
			} else {
				f[c - 1] = (3 * e[c - 1] + e[c - 2] + 2) >> 2
			}
			for let y = 1; y < 7; y++ {
				f[c - 1 - y] = (e[c - y] + 2 * e[c - 1 - y] + e[c - 2 - y] + 2) >> 2
			}
			f[c - 8] = (e[c - 7] + 3 * e[c - 8] + 2) >> 2
		}
	}

	// Intra 4x4 or 8x8 prediction (n = 4 or 8) of the block at `off` from
	// the edge `e`, in the mode numbering of the standard.
	def h264PredBlock<T: H264Sample>(dst T[], off int, stride int, n int, mode int, e int[], top bool, left bool, max int) {
		let c = h264EdgeCorner
		if mode == 0 {
			for let y = 0; y < n; y++ {
				let p = off + y * stride
				for let x = 0; x < n; x++ {
					dst[p + x] = T(e[c + 1 + x])
				}
			}
			return
		}
		if mode == 1 {
			for let y = 0; y < n; y++ {
				let p = off + y * stride
				let v = T(e[c - 1 - y])
				for let x = 0; x < n; x++ {
					dst[p + x] = v
				}
			}
			return
		}
		if mode == 2 {
			let shift = n == 4 ?? (2, 3)
			let sum = 0
			let v = (max + 1) >> 1
			if top && left {
				for let i = 0; i < n; i++ {
					sum += e[c + 1 + i] + e[c - 1 - i]
				}
				v = (sum + n) >> (shift + 1)
			} else if top {
				for let i = 0; i < n; i++ {
					sum += e[c + 1 + i]
				}
				v = (sum + (n >> 1)) >> shift
			} else if left {
				for let i = 0; i < n; i++ {
					sum += e[c - 1 - i]
				}
				v = (sum + (n >> 1)) >> shift
			}
			let b = T(v)
			for let y = 0; y < n; y++ {
				let p = off + y * stride
				for let x = 0; x < n; x++ {
					dst[p + x] = b
				}
			}
			return
		}
		for let y = 0; y < n; y++ {
			let p = off + y * stride
			for let x = 0; x < n; x++ {
				let v = 0
				if mode == 3 {
					if x == n - 1 && y == n - 1 {
						v = (e[c + 2 * n - 1] + 3 * e[c + 2 * n] + 2) >> 2
					} else {
						let t = c + 1 + x + y
						v = (e[t] + 2 * e[t + 1] + e[t + 2] + 2) >> 2
					}
				} else if mode == 4 {
					// Along the border, top-right to bottom-left, the corner at
					// c: sample (x, y) sits at c + x - y.
					let t = c + x - y
					v = (e[t - 1] + 2 * e[t] + e[t + 1] + 2) >> 2
				} else if mode == 5 {
					let z = 2 * x - y
					if z >= 0 && (z & 1) == 0 {
						let t = c + 1 + x - (y >> 1)
						v = (e[t - 1] + e[t] + 1) >> 1
					} else if z >= 0 {
						let t = c + 1 + x - (y >> 1)
						v = (e[t - 2] + 2 * e[t - 1] + e[t] + 2) >> 2
					} else if z == -1 {
						v = (e[c - 1] + 2 * e[c] + e[c + 1] + 2) >> 2
					} else {
						let t = c - (y - 2 * x)
						v = (e[t] + 2 * e[t + 1] + e[t + 2] + 2) >> 2
					}
				} else if mode == 6 {
					let z = 2 * y - x
					if z >= 0 && (z & 1) == 0 {
						let t = c - 1 - y + (x >> 1)
						v = (e[t + 1] + e[t] + 1) >> 1
					} else if z >= 0 {
						let t = c - 1 - y + (x >> 1)
						v = (e[t + 2] + 2 * e[t + 1] + e[t] + 2) >> 2
					} else if z == -1 {
						v = (e[c - 1] + 2 * e[c] + e[c + 1] + 2) >> 2
					} else {
						let t = c + (x - 2 * y)
						v = (e[t] + 2 * e[t - 1] + e[t - 2] + 2) >> 2
					}
				} else if mode == 7 {
					let t = c + 1 + x + (y >> 1)
					if (y & 1) == 0 {
						v = (e[t] + e[t + 1] + 1) >> 1
					} else {
						v = (e[t] + 2 * e[t + 1] + e[t + 2] + 2) >> 2
					}
				} else {
					let z = x + 2 * y
					let t = c - 1 - y - (x >> 1)
					if z > 2 * n - 3 {
						v = e[c - n]
					} else if z == 2 * n - 3 {
						v = (e[c - n + 1] + 3 * e[c - n] + 2) >> 2
					} else if (z & 1) == 0 {
						v = (e[t] + e[t - 1] + 1) >> 1
					} else {
						v = (e[t] + 2 * e[t - 1] + e[t - 2] + 2) >> 2
					}
				}
				dst[p + x] = T(v)
			}
		}
	}

	// Intra 16x16 prediction of the luma of the macroblock at `off`.
	def h264Pred16<T: H264Sample>(dst T[], off int, stride int, mode int, top bool, left bool, max int) {
		if mode == 0 {
			for let y = 0; y < 16; y++ {
				dst[off - stride:off - stride + 16].copy(dst[off + y * stride:])
			}
			return
		}
		if mode == 1 {
			for let y = 0; y < 16; y++ {
				let p = off + y * stride
				let v = dst[p - 1]
				for let x = 0; x < 16; x++ {
					dst[p + x] = v
				}
			}
			return
		}
		if mode == 2 {
			let sum = 0
			let v = (max + 1) >> 1
			if top && left {
				for let i = 0; i < 16; i++ {
					sum += int(dst[off - stride + i]) + int(dst[off + i * stride - 1])
				}
				v = (sum + 16) >> 5
			} else if top {
				for let i = 0; i < 16; i++ {
					sum += int(dst[off - stride + i])
				}
				v = (sum + 8) >> 4
			} else if left {
				for let i = 0; i < 16; i++ {
					sum += int(dst[off + i * stride - 1])
				}
				v = (sum + 8) >> 4
			}
			let b = T(v)
			for let y = 0; y < 16; y++ {
				let p = off + y * stride
				for let x = 0; x < 16; x++ {
					dst[p + x] = b
				}
			}
			return
		}
		h264PredPlane(dst, off, stride, 16, 16, max)
	}

	// Plane prediction of a 16x16 luma or 8x8 or 8x16 chroma block of
	// `w` x `h` samples.
	def h264PredPlane<T: H264Sample>(dst T[], off int, stride int, w int, h int, max int) {
		let t = off - stride
		let hh = 0
		let vv = 0
		let hw = w >> 1
		let hv = h >> 1
		for let i = 0; i < hw; i++ {
			hh += (i + 1) * (int(dst[t + hw + i]) - int(dst[t + hw - 2 - i]))
		}
		for let i = 0; i < hv; i++ {
			vv += (i + 1) * (int(dst[off + (hv + i) * stride - 1]) - int(dst[off + (hv - 2 - i) * stride - 1]))
		}
		let a = 16 * (int(dst[off + (h - 1) * stride - 1]) + int(dst[t + w - 1]))
		let b = ((w == 16 ?? (5, 34)) * hh + 32) >> 6
		let cc = ((h == 16 ?? (5, 34)) * vv + 32) >> 6
		let mx = hw - 1
		let my = hv - 1
		for let y = 0; y < h; y++ {
			let p = off + y * stride
			let base = a + cc * (y - my) + 16 - b * mx
			for let x = 0; x < w; x++ {
				dst[p + x] = T(h264ClipMax((base + b * x) >> 5, max))
			}
		}
	}

	// Intra prediction of one 8-wide chroma block of `rows` (8 or 16) at
	// `off`: DC per 4x4 block, horizontal, vertical or plane. `leftUpper`
	// and `leftLower` say whether the left samples of each half may be
	// used; horizontal and plane need both.
	def h264PredChroma<T: H264Sample>(dst T[], off int, stride int, mode int, top bool, leftUpper bool, leftLower bool, rows int, max int) {
		if mode == 1 {
			for let y = 0; y < rows; y++ {
				let p = off + y * stride
				let v = dst[p - 1]
				for let x = 0; x < 8; x++ {
					dst[p + x] = v
				}
			}
			return
		}
		if mode == 2 {
			for let y = 0; y < rows; y++ {
				dst[off - stride:off - stride + 8].copy(dst[off + y * stride:])
			}
			return
		}
		if mode == 3 {
			h264PredPlane(dst, off, stride, 8, rows, max)
			return
		}
		let blocks = rows >> 1
		for let q = 0; q < blocks; q++ {
			let bx = (q & 1) * 4
			let by = (q >> 1) * 4
			let st = 0
			let sl = 0
			let left = by < (rows >> 1) ?? (leftUpper, leftLower)
			if top {
				for let i = 0; i < 4; i++ {
					st += int(dst[off - stride + bx + i])
				}
			}
			if left {
				for let i = 0; i < 4; i++ {
					sl += int(dst[off + (by + i) * stride - 1])
				}
			}
			// Blocks on the diagonal of the block grid average both edges;
			// the others prefer the edge they touch.
			let v = (max + 1) >> 1
			if (bx == 0) == (by == 0) {
				if top && left {
					v = (st + sl + 4) >> 3
				} else if top {
					v = (st + 2) >> 2
				} else if left {
					v = (sl + 2) >> 2
				}
			} else if by == 0 {
				if top {
					v = (st + 2) >> 2
				} else if left {
					v = (sl + 2) >> 2
				}
			} else {
				if left {
					v = (sl + 2) >> 2
				} else if top {
					v = (st + 2) >> 2
				}
			}
			let b = T(v)
			for let y = 0; y < 4; y++ {
				let p = off + (by + y) * stride + bx
				for let x = 0; x < 4; x++ {
					dst[p + x] = b
				}
			}
		}
	}
}
