internal partial module std.formats.video.h264 {
	// Coefficient buffer layout of one macroblock: 16 luma 4x4 blocks (or
	// four 8x8 blocks) in raster order of blocks, then the Cb and the Cr
	// blocks (4 each in 4:2:0, 8 in 4:2:2, in raster order of 2-wide rows).
	// 4:4:4 macroblocks hold three planes laid out like luma instead, each
	// `h264CoeffPlane` apart.
	const h264CoeffCb = 256
	const h264CoeffPlane = 256

	// Bits of the per-macroblock coded block pattern word beyond the luma
	// (bits 0-3) and chroma (bits 4-5) patterns: which DC blocks had
	// coefficients.
	const h264CbpCbDc = 64
	const h264CbpCrDc = 128
	const h264CbpLumaDc = 256
	const h264CbpPcm = 0x1ef

	// H264SliceDecoder decodes the macroblocks of one slice at a time into
	// the current picture.
	type H264SliceDecoder {
		sps         H264Sps
		pps         H264Pps
		hdr         H264SliceHeader
		pic         H264Picture
		motion      H264Motion
		bits        H264Bits
		cabac       H264Cabac
		cavlc       H264Cavlc
		list0       H264Picture[]
		list1       H264Picture[]
		count0      int
		count1      int
		wMbs        int
		hMbs        int
		mbs         int
		gw          int
		cgw         int
		sliceNum    int
		useCabac    bool
		constrained bool
		// Monochrome (4:0:0): no chroma syntax, grey chroma planes.
		mono        bool
		// 4:4:4: Cb and Cr are coded, predicted and transformed like luma.
		full        bool
		// Coefficient scans of the current picture: zigzag in frames, the
		// field scans in fields.
		scan4       int[]
		scan8       int[]
		// Lossless macroblock: transform bypass with QP 0; levels are the
		// residual itself.
		bypass      bool
		// Residual of one plane of a lossless macroblock, raster order.
		res         int[]
		// The chroma intra mode the macroblock was predicted with.
		chromaUsed  int
		// Whether the stream comes from x264 before build 151, whose 4:4:4
		// coded_block_flag contexts and lossless 8x8 prediction the decoder
		// imitates.
		oldX264     bool
		// 4:2:2: chroma macroblocks of 8x16 samples.
		c422        bool
		// Chroma 4x4 blocks per component and their rows per macroblock.
		cBlocks     int
		crows       int
		sliceB      bool
		sliceP      bool
		// Work grids of the current picture: per macroblock QP, coded block
		// pattern word and chroma prediction mode; per 4x4 block coefficient
		// counts (luma and chroma grids), intra modes, motion vector
		// differences and whether the block is direct predicted.
		qpGrid      int[]
		cbpGrid     int[]
		chromaGrid  int[]
		nzc         int[]
		nzCb        int[]
		nzCr        int[]
		// Per 4x4 block coefficient counts of Cb and Cr in 4:4:4.
		nzc1        int[]
		nzc2        int[]
		modes       int[]
		mvd0        int[]
		mvd1        int[]
		direct      int[]
		// The current macroblock.
		mbx         int
		mby         int
		mbAddr      int
		mbType      int
		qp          int
		qpc0        int
		qpc1        int
		lastDqp     int
		availA      bool
		availB      bool
		i16Mode     int
		chromaMode  int
		cbp         int
		subType     int[]
		refIdx      int[]
		mvdX        int[]
		mvdY        int[]
		prevFlag    int[]
		remMode     int[]
		coeff       int[]
		lumaDc      int[]
		chromaDc    int[]
		pcm         int[]
		// Scratch for prediction.
		edge        int[]
		edgeF       int[]
		// Filters the picture as its rows are decoded: told each completed
		// row.
		deblock     H264Deblock
		// Sample code for 8-bit pictures and for deeper ones.
		kit8        H264Kit<byte>
		kit16       H264Kit<uint16>
		deep        bool
		tmp         int[]
		implicitW   int[]
		weighted    int
		// QpBdOffsetY: 6 per bit of depth beyond 8. `qp` and the QP grid
		// hold QP'Y, which adds it.
		qpBd        int
		// MBAFF frames: macroblock pairs, each coded as two frame or two field
		// macroblocks.
		mbaff       bool
		loc         H264Locator
		// Whether the current macroblock is a field macroblock, and the
		// h264MbField bit its type word carries.
		fieldMb     bool
		fieldBit    int
		// The macroblocks left of and above the current one, -1 when
		// unavailable.
		mbA         int
		mbB         int
		// Where the current macroblock's samples start in the luma and
		// chroma planes, and the line strides it steps by: twice the
		// picture's for a field macroblock.
		ly0         int
		cy0         int
		ls          int
		cls         int
		// The frame reference lists of the slice, and the field lists field
		// macroblocks use (index 2i the field of frame i with the parity of
		// the macroblock, 2i + 1 the other), per parity.
		frameList0  H264Picture[]
		frameList1  H264Picture[]
		frameCount0 int
		frameCount1 int
		fieldLists  H264Picture[][]
		// Implicit weights of field macroblocks, per parity.
		implicitF   int[]

		def new() {
			sps = new H264Sps()
			pps = new H264Pps()
			hdr = new H264SliceHeader()
			pic = new H264Picture()
			motion = new H264Motion()
			bits = new H264Bits()
			cabac = new H264Cabac()
			cavlc = new H264Cavlc()
			list0 = H264Picture[]
			list1 = H264Picture[]
			qpGrid = int[]
			cbpGrid = int[]
			chromaGrid = int[]
			nzc = int[]
			nzCb = int[]
			nzCr = int[]
			nzc1 = int[]
			nzc2 = int[]
			modes = int[]
			mvd0 = int[]
			mvd1 = int[]
			direct = int[]
			subType = h264Zeros(4)
			refIdx = h264Zeros(8)
			mvdX = h264Zeros(32)
			mvdY = h264Zeros(32)
			prevFlag = h264Zeros(16)
			remMode = h264Zeros(16)
			coeff = h264Zeros(768)
			lumaDc = h264Zeros(48)
			chromaDc = h264Zeros(16)
			pcm = h264Zeros(768)
			res = h264Zeros(256)
			scan4 = h264Zigzag4x4
			scan8 = h264Zigzag8x8
			edge = h264Zeros(33)
			edgeF = h264Zeros(33)
			kit8 = new H264Kit<byte>(def (p H264Picture) H264Planes<byte> {
				return p.samples8
			})
			kit16 = new H264Kit<uint16>(def (p H264Picture) H264Planes<uint16> {
				return p.samples16
			})
			kit8.qpel = h264QpelBytes
			kit8.bilinear = h264BilinearBytes
			kit8.idct8 = h264Idct8AddBytes
			kit8.idct4 = h264Idct4AddBytes
			kit8.dc4 = h264Idct4DcBytes
			tmp = h264Zeros(640)
			implicitW = h264Zeros(1024)
			loc = new H264Locator()
			deblock = new H264Deblock()
			frameList0 = H264Picture[]
			frameList1 = H264Picture[]
			fieldLists = H264Picture[][]
			implicitF = int[]
		}

		// Sizes the work grids for pictures of the given size.
		def resize(w int, h int) {
			return when w == wMbs && h == hMbs && qpGrid.len() > 0
			wMbs = w
			hMbs = h
			mbs = w * h
			gw = w * 4
			cgw = w * 2
			qpGrid = h264Zeros(mbs)
			cbpGrid = h264Zeros(mbs)
			chromaGrid = h264Zeros(mbs)
			nzc = h264Zeros(mbs * 16)
			nzCb = h264Zeros(mbs * 8)
			nzCr = h264Zeros(mbs * 8)
			nzc1 = h264Zeros(mbs * 16)
			nzc2 = h264Zeros(mbs * 16)
			modes = h264Zeros(mbs * 16)
			mvd0 = h264Zeros(mbs * 32)
			mvd1 = h264Zeros(mbs * 32)
			direct = h264Zeros(mbs * 16)
		}

		// Decodes the slice data of `h`, whose RBSP is `rbsp[:length]`, into
		// `p`. Fails on a malformed slice.
		def decode(h H264SliceHeader, s H264Sps, ps H264Pps, p H264Picture, rbsp byte[], length int, num int, l0 H264Picture[], c0 int, l1 H264Picture[], c1 int) !none {
			hdr = h
			sps = s
			pps = ps
			pic = p
			sliceNum = num
			frameList0 = l0
			frameList1 = l1
			list0 = l0
			list1 = l1
			count0 = c0
			count1 = c1
			frameCount0 = c0
			frameCount1 = c1
			resize(p.widthMbs, p.heightMbs)
			useCabac = ps.cabac
			constrained = ps.constrainedIntraPred
			mono = s.chromaFormat == 0
			full = s.chromaFormat == 3
			mbaff = s.mbAdaptive && p.parity == 0
			fieldMb = false
			fieldBit = 0
			let fields = p.parity != 0
			scan4 = fields ?? (h264FieldScan4x4, h264Zigzag4x4)
			scan8 = fields ?? (h264FieldScan8x8, h264Zigzag8x8)
			cabac.field = fields
			c422 = s.chromaFormat == 2
			cBlocks = c422 ?? (8, 4)
			crows = c422 ?? (4, 2)
			sliceB = h.isB()
			sliceP = h.sliceType == h264SliceP
			loc.slice(p, num, mbaff)
			motion.slice(p, l0, c0, l1, c1, num, s.direct8x8Inference, loc)
			prepareFieldLists() when mbaff
			weighted = 0
			if sliceP && ps.weightedPred {
				weighted = 1
			} else if sliceB && ps.weightedBipredIdc == 1 {
				weighted = 1
			} else if sliceB && ps.weightedBipredIdc == 2 {
				weighted = 2
				prepareImplicit()
			}
			qpBd = 6 * (s.bitDepthLuma - 8)
			deep = s.bitDepthLuma > 8
			kit16.max = (1 << s.bitDepthLuma) - 1
			qp = h.qp + qpBd
			updateChromaQp()
			lastDqp = 0
			bits.reset(rbsp, length)
			bits.pos = h.dataOffset
			if useCabac {
				bits.pos = (bits.pos + 7) & ~7
				cabac.start(rbsp, bits.pos >> 3, length)
				cabac.initContexts(h264Clip3(0, 51, h.qp), h.isI() ?? (-1, h.cabacInitIdc))
			}
			let addr = h.firstMb * (mbaff ?? (2, 1))
			fail "h264: first_mb_in_slice out of range" when addr >= mbs
			if useCabac {
				// The skip flag of a bottom macroblock, read ahead with the
				// top one's; -1 when not read.
				let skipNext = -1
				for {
					fail "h264: slice runs past the end of the picture" when addr >= mbs
					let bottom = mbaff && (addr & 1) == 1
					setField(inferField(addr)) when mbaff && !bottom
					startMb(addr)
					let skip = 0
					if !h.isI() {
						if bottom && skipNext >= 0 {
							skip = skipNext
						} else {
							skip = decodeSkipFlag()
						}
					}
					skipNext = -1
					if skip == 1 {
						if mbaff && !bottom {
							// A skipped top macroblock takes the pair's field
							// flag, which follows the bottom one's skip flag
							// when that one is coded.
							pic.mbType[mbAddr] = h264MbSkip | fieldBit
							startMb(addr + 1)
							skipNext = decodeSkipFlag()
							setField(decodeFieldFlag() == 1) when skipNext == 0
							startMb(addr)
						}
						decodeSkip()
					} else {
						if mbaff && !bottom {
							setField(decodeFieldFlag() == 1)
							startMb(addr)
						}
						try parseCabac()
						try finishMb()
					}
					rowDone()
					addr++
					continue when mbaff && !bottom
					break when cabac.terminate() == 1
					fail "h264: CABAC data runs past the end of the slice" when cabac.pos > length + 2
				}
				return none
			}
			let more = true
			for more {
				if !h.isI() {
					let run = bits.ue()
					fail "h264: bad mb_skip_run" when run > mbs - addr
					for let k = 0; k < run; k++ {
						if mbaff && (addr & 1) == 0 {
							// A run ending at a top macroblock: the bottom one
							// is coded, and its field flag comes next.
							if k == run - 1 {
								setField(bits.flag())
							} else {
								setField(inferField(addr))
							}
						}
						startMb(addr)
						decodeSkip()
						rowDone()
						addr++
					}
					if run > 0 {
						more = bits.moreData()
						break unless more
					}
				}
				fail "h264: slice runs past the end of the picture" when addr >= mbs
				setField(bits.flag()) when mbaff && (addr & 1) == 0
				startMb(addr)
				try parseCavlc()
				try finishMb()
				rowDone()
				addr++
				more = bits.moreData()
				fail "h264: CAVLC data runs past the end of the slice" when bits.left() < 0
			}
		}

		// Tells the deblocking task when the macroblock just decoded ends a
		// row (a pair row in MBAFF frames).
		def rowDone() {
			return unless mbx == wMbs - 1
			return when mbaff && (mby & 1) == 0
			deblock.advance(mby + 1)
		}

		// Sets whether the current macroblock pair is coded as fields.
		def setField(f bool) {
			fieldMb = f
			fieldBit = f ?? (h264MbField, 0)
		}

		// The field flag a pair starting at stream address `addr` has when
		// it does not code one: the left pair's, else the upper pair's, else
		// frame.
		def inferField(addr int) bool {
			let pair = addr >> 1
			let x = pair % wMbs
			let row = pair / wMbs
			return loc.isField(2 * row * wMbs + x - 1) when loc.pairAvail(x - 1, row)
			return loc.isField(2 * (row - 1) * wMbs + x) when loc.pairAvail(x, row - 1)
			return false
		}

		// mb_field_decoding_flag: its context counts the field pairs left
		// and above.
		def decodeFieldFlag() int {
			let pair = mbAddr / (2 * wMbs)
			let inc = 0
			inc++ when loc.pairAvail(mbx - 1, pair) && loc.isField(2 * pair * wMbs + mbx - 1)
			inc++ when loc.pairAvail(mbx, pair - 1) && loc.isField(2 * (pair - 1) * wMbs + mbx)
			return cabac.decision(70 + inc)
		}

		// The field reference lists of an MBAFF slice, for top and bottom
		// field macroblocks.
		def prepareFieldLists() {
			fieldLists.len(0)
			for let parity = 1; parity <= 2; parity++ {
				for let l = 0; l < 2; l++ {
					let src = l == 0 ?? (frameList0, frameList1)
					let n = l == 0 ?? (frameCount0, frameCount1)
					let out = H264Picture[]
					for let i = 0; i < n; i++ {
						out.push(h264FieldOf(src[i], parity))
						out.push(h264FieldOf(src[i], 3 - parity))
					}
					fieldLists.push(out)
				}
			}
		}

		def updateChromaQp() {
			qpc0 = h264ChromaQpOf(qp, pps.chromaQpOffset, qpBd)
			qpc1 = h264ChromaQpOf(qp, pps.secondChromaQpOffset, qpBd)
		}

		// Implicit bi-prediction weights for every pair of reference indices;
		// in MBAFF frames also those of field macroblocks, from the order
		// counts of the fields.
		def prepareImplicit() {
			implicitWeights(implicitW, 0, pic.poc, list0, list1, count0, count1, 32)
			return unless mbaff
			implicitF = h264Zeros(2 * 64 * 64)
			for let parity = 1; parity <= 2; parity++ {
				let cur = parity == 1 ?? (pic.topPoc, pic.bottomPoc)
				let l0 = fieldLists[(parity - 1) * 2]
				let l1 = fieldLists[(parity - 1) * 2 + 1]
				implicitWeights(implicitF, (parity - 1) * 4096, cur, l0, l1, l0.len(), l1.len(), 64)
			}
		}

		def implicitWeights(out int[], at int, cur int, l0 H264Picture[], l1 H264Picture[], n0 int, n1 int, row int) {
			for let i = 0; i < n0; i++ {
				for let j = 0; j < n1; j++ {
					let p0 = l0[i]
					let p1 = l1[j]
					let w = 32
					let tdRaw = p1.poc - p0.poc
					if tdRaw != 0 && p0.ref != h264RefLong && p1.ref != h264RefLong {
						let tb = h264Clip3(-128, 127, cur - p0.poc)
						let td = h264Clip3(-128, 127, tdRaw)
						let tx = (16384 + h264Abs(td / 2)) / td
						let dsf = h264Clip3(-1024, 1023, (tb * tx + 32) >> 6)
						w = 64 - (dsf >> 2) when (dsf >> 2) >= -64 && (dsf >> 2) <= 128
					}
					out[at + i * row + j] = w
				}
			}
		}

		// The implicit weight of list 0 for the reference pair (r0, r1) of
		// the current macroblock.
		def implicitOf(r0 int, r1 int) int {
			return implicitW[r0 * 32 + r1] unless fieldMb
			return implicitF[((mby & 1) * 64 + r0) * 64 + r1]
		}

		// Sets up the neighbourhood of the macroblock at stream address
		// `addr`.
		def startMb(addr int) {
			if mbaff {
				let pair = addr >> 1
				mbx = pair % wMbs
				mby = (pair / wMbs) * 2 + (addr & 1)
			} else {
				mbx = addr % wMbs
				mby = addr / wMbs
			}
			mbAddr = mby * wMbs + mbx
			bypass = false
			pic.sliceOfMb[mbAddr] = sliceNum
			loc.at(mbx, mby, fieldMb)
			mbA = loc.locate(-1, 0, 16, 16)
			mbB = loc.locate(0, -1, 16, 16)
			availA = mbA >= 0
			availB = mbB >= 0
			motion.at(mbx, mby)
			let rows = crows * 4
			if fieldMb {
				ls = pic.stride * 2
				cls = pic.chromaStride * 2
				ly0 = pic.base + ((mby >> 1) * 32 + (mby & 1)) * pic.stride + mbx * 16
				cy0 = pic.cbase + ((mby >> 1) * 2 * rows + (mby & 1)) * pic.chromaStride + mbx * 8
			} else {
				ls = pic.stride
				cls = pic.chromaStride
				ly0 = pic.base + mby * 16 * ls + mbx * 16
				cy0 = pic.cbase + mby * rows * cls + mbx * 8
			}
			return unless mbaff
			let fields = fieldMb
			scan4 = fields ?? (h264FieldScan4x4, h264Zigzag4x4)
			scan8 = fields ?? (h264FieldScan8x8, h264Zigzag8x8)
			cabac.field = fields
			if fields {
				let k = (mby & 1) * 2
				list0 = fieldLists[k]
				list1 = fieldLists[k + 1]
				count0 = list0.len()
				count1 = list1.len()
			} else {
				list0 = frameList0
				list1 = frameList1
				count0 = frameCount0
				count1 = frameCount1
			}
			motion.lists(list0, count0, list1, count1)
		}

		// The number of active references of `list` for the current
		// macroblock: twice the slice's for a field macroblock.
		def activeRefs(list int) int {
			return hdr.numRefIdxActive[list] << (fieldMb ?? (1, 0))
		}

		// Whether the samples at luma location (xN, yN), relative to the
		// macroblock, may be used for intra prediction.
		def intraAt(xN int, yN int) bool {
			let mb = loc.locate(xN, yN, 16, 16)
			return false when mb < 0
			return true when mb == mbAddr || !constrained
			return (pic.mbType[mb] & h264MbIntra) != 0
		}

		// Whether the `h` samples left of the macroblock from line `yN` may
		// be used: in MBAFF frames they can come from both macroblocks of
		// the left pair.
		def intraLeft(xN int, yN int, h int) bool {
			return intraAt(xN, yN) unless mbaff && xN < 0
			return intraAt(xN, yN) && intraAt(xN, yN + 1) && intraAt(xN, yN + h - 1)
		}

		// Fills a rectangle of a 4x4 grid (luma layout) with `v`.
		def fillGrid(g int[], bx int, by int, w int, h int, v int) {
			let base = (mby * 4 + by) * gw + mbx * 4 + bx
			for let y = 0; y < h; y++ {
				let i = base + y * gw
				for let x = 0; x < w; x++ {
					g[i + x] = v
				}
			}
		}

		def fillMvd(list int, bx int, by int, w int, h int, ax int, ay int) {
			let base = (mby * 4 + by) * gw + mbx * 4 + bx
			for let y = 0; y < h; y++ {
				let i = base + y * gw
				for let x = 0; x < w; x++ {
					if list == 0 {
						mvd0[2 * (i + x)] = ax
						mvd0[2 * (i + x) + 1] = ay
					} else {
						mvd1[2 * (i + x)] = ax
						mvd1[2 * (i + x) + 1] = ay
					}
				}
			}
		}

		// Fills the right column and the bottom row of the macroblock in a 4x4
		// grid.
		def fillEdges(g int[], v int) {
			let base = mby * 4 * gw + mbx * 4
			g[base + 3] = v
			g[base + gw + 3] = v
			g[base + 2 * gw + 3] = v
			let b = base + 3 * gw
			g[b] = v
			g[b + 1] = v
			g[b + 2] = v
			g[b + 3] = v
		}

		// Clears the motion vector differences of the right column and the
		// bottom row of the macroblock.
		def clearMvdEdges() {
			let base = mby * 4 * gw + mbx * 4
			for let k = 0; k < 3; k++ {
				let i = 2 * (base + k * gw + 3)
				mvd0[i] = 0
				mvd0[i + 1] = 0
				mvd1[i] = 0
				mvd1[i + 1] = 0
			}
			let b = 2 * (base + 3 * gw)
			for let k = 0; k < 8; k++ {
				mvd0[b + k] = 0
				mvd1[b + k] = 0
			}
		}

		// The vertical offset, in eighth chroma samples, of 4:2:0 chroma
		// predicted by a field from the field of the other parity.
		def parityShift(ref H264Picture) int {
			let parity = mbParity()
			return 0 when parity == 0 || ref.parity == parity || c422
			return parity == 2 ?? (2, -2)
		}

		// The field the current macroblock belongs to: 1 top, 2 bottom, 0
		// for a frame macroblock.
		def mbParity() int {
			return fieldMb ?? (1 + (mby & 1), pic.parity)
		}

		// Moves the coefficients of `cols` x `rows` 4x4 blocks at `base`
		// (raster order of blocks) into `res` as one raster residual.
		def gather4(base int, cols int, rows int) {
			let w = cols * 4
			for let b = 0; b < cols * rows; b++ {
				let o = ((b / cols) * 4) * w + (b % cols) * 4
				for let i = 0; i < 16; i++ {
					res[o + (i >> 2) * w + (i & 3)] = coeff[base + b * 16 + i]
					coeff[base + b * 16 + i] = 0
				}
			}
		}

		// Moves `n` coefficients at `at` into `res`.
		def take(at int, n int) {
			for let i = 0; i < n; i++ {
				res[i] = coeff[at + i]
				coeff[at + i] = 0
			}
		}

		// Where the 4x4 dequantisation factors of list `list` at `q` start,
		// -1 for a lossless macroblock, whose levels stay as they are.
		def dqAt4(list int, q int) int {
			return bypass ?? (-1, (list * h264QpSpan + q) * 16)
		}

		// Where the 8x8 dequantisation factors start, as `dqAt4`.
		def dqAt8(list int, q int) int {
			return bypass ?? (-1, (list * h264QpSpan + q) * 64)
		}

		// The coefficient count grid of plane `p`: luma, or Cb and Cr of 4:4:4.
		def nzOf(p int) int[] {
			return p == 0 ?? (nzc, p == 1 ?? (nzc1, nzc2))
		}

		// The QP of plane `p`.
		def qpOf(p int) int {
			return p == 0 ?? (qp, p == 1 ?? (qpc0, qpc1))
		}

		// The coded block pattern word bit of plane `p`'s Intra 16x16 DC
		// block.
		def dcBit(p int) int {
			return p == 0 ?? (h264CbpLumaDc, p == 1 ?? (h264CbpCbDc, h264CbpCrDc))
		}

		// Clears the coefficient counts of every plane of the macroblock.
		def clearNz() {
			fillGrid(nzc, 0, 0, 4, 4, 0)
			if full {
				fillGrid(nzc1, 0, 0, 4, 4, 0)
				fillGrid(nzc2, 0, 0, 4, 4, 0)
			} else {
				clearChromaNz()
			}
		}

		def clearChromaNz() {
			fillChromaNz(0)
		}

		// Sets the chroma coefficient counts of the macroblock to `v`.
		def fillChromaNz(v int) {
			let c0 = mby * crows * cgw + mbx * 2
			for let b = 0; b < cBlocks; b++ {
				let i = c0 + (b >> 1) * cgw + (b & 1)
				nzCb[i] = v
				nzCr[i] = v
			}
		}

		// Offset of chroma component `c` in the coefficient buffer.
		def chromaBase(c int) int {
			return h264CoeffCb + c * cBlocks * 16
		}

		// A skipped macroblock: P_Skip or B_Skip.
		def decodeSkip() {
			clearNz()
			// Later macroblocks read only the right column and bottom row of
			// these grids.
			fillEdges(modes, -1)
			if useCabac {
				fillEdges(direct, sliceB ?? (1, 0))
				clearMvdEdges()
			}
			cbpGrid[mbAddr] = 0
			chromaGrid[mbAddr] = 0
			qpGrid[mbAddr] = qp
			lastDqp = 0
			if sliceB {
				mbType = h264MbSkip | h264MbDirect | h264MbP0L0 | h264MbP0L1
				pic.mbType[mbAddr] = mbType | fieldBit
				directMotion(-1)
			} else {
				mbType = h264MbSkip | h264Mb16x16 | h264MbP0L0
				pic.mbType[mbAddr] = mbType | fieldBit
				motion.pSkip()
				motion.fill(0, 0, 0, 4, 4, 0, motion.mx, motion.my)
				motion.fill(1, 0, 0, 4, 4, -1, 0, 0)
			}
			if deep {
				interPredict(kit16)
			} else {
				interPredict(kit8)
			}
		}

		// Direct prediction of the whole macroblock (-1) or one 8x8 quarter.
		def directMotion(quarter int) {
			if hdr.directSpatial {
				motion.spatialPrepare() when quarter <= 0
				motion.spatialBlocks(quarter)
			} else {
				motion.temporalBlocks(quarter)
			}
		}

		// Sets up the macroblock type from an I mb_type value (0 to 25).
		def decodeIntraType(t int) {
			if t == 0 {
				mbType = h264MbIntra4x4
			} else if t == 25 {
				mbType = h264MbPcm
			} else {
				mbType = h264MbIntra16x16
				i16Mode = (t - 1) % 4
				cbp = (((t - 1) / 4) % 3) << 4
				cbp = cbp | 15 when t >= 13
				cbp = cbp & 15 when mono || full
			}
		}

		// Parses one macroblock with CAVLC.
		def parseCavlc() !none {
			let raw = bits.ue()
			cbp = 0
			if sliceB {
				if raw < 23 {
					mbType = h264BMbTypes[raw]
				} else {
					fail "h264: bad mb_type" when raw - 23 > 25
					decodeIntraType(raw - 23)
				}
			} else if sliceP {
				if raw < 5 {
					mbType = h264PMbTypes[raw]
				} else {
					fail "h264: bad mb_type" when raw - 5 > 25
					decodeIntraType(raw - 5)
				}
			} else {
				fail "h264: bad mb_type" when raw > 25
				decodeIntraType(raw)
			}
			if mbType == h264MbPcm {
				bits.pos = (bits.pos + 7) & ~7
				try readPcm()
				return none
			}
			let dct8Allowed = pps.transform8x8
			if (mbType & h264MbIntra) != 0 {
				if (mbType & h264MbIntra4x4) != 0 {
					mbType = mbType | h264MbDct8 when pps.transform8x8 && bits.flag()
					let n = (mbType & h264MbDct8) != 0 ?? (4, 16)
					for let i = 0; i < n; i++ {
						prevFlag[i] = bits.flag() ?? (1, 0)
						remMode[i] = bits.u(3) when prevFlag[i] == 0
					}
				}
				if !mono && !full {
					chromaMode = bits.ue()
					fail "h264: bad intra_chroma_pred_mode" when chromaMode > 3
				}
			} else if (mbType & h264Mb8x8) != 0 {
				for let i = 0; i < 4; i++ {
					let st = bits.ue()
					if sliceB {
						fail "h264: bad sub_mb_type" when st > 12
						subType[i] = h264BSubTypes[st]
					} else {
						fail "h264: bad sub_mb_type" when st > 3
						subType[i] = h264PSubTypes[st]
					}
					if (subType[i] & h264SubDirect) != 0 {
						dct8Allowed = false unless sps.direct8x8Inference
					} else if (subType[i] & 3) != 0 {
						dct8Allowed = false
					}
				}
				for let l = 0; l < 2; l++ {
					let lf = l == 0 ?? (h264SubL0, h264SubL1)
					let n = activeRefs(l)
					for let i = 0; i < 4; i++ {
						let st = subType[i]
						if (st & h264SubDirect) != 0 || (st & lf) == 0 {
							refIdx[l * 4 + i] = -1
							continue
						}
						if n > 1 && (mbType & h264MbRef0) == 0 {
							refIdx[l * 4 + i] = bits.te(n - 1)
							fail "h264: bad ref_idx" when refIdx[l * 4 + i] >= n
						} else {
							refIdx[l * 4 + i] = 0
						}
					}
				}
				for let l = 0; l < 2; l++ {
					let lf = l == 0 ?? (h264SubL0, h264SubL1)
					for let i = 0; i < 4; i++ {
						let st = subType[i]
						continue when (st & h264SubDirect) != 0 || (st & lf) == 0
						let parts = h264SubParts(st)
						for let j = 0; j < parts; j++ {
							mvdX[l * 16 + i * 4 + j] = bits.se()
							mvdY[l * 16 + i * 4 + j] = bits.se()
						}
					}
				}
			} else if (mbType & h264MbDirect) == 0 {
				let parts = (mbType & h264Mb16x16) != 0 ?? (1, 2)
				for let l = 0; l < 2; l++ {
					let n = activeRefs(l)
					for let i = 0; i < parts; i++ {
						if !h264PartUses(mbType, i, l) {
							refIdx[l * 4 + i] = -1
							continue
						}
						if n > 1 {
							refIdx[l * 4 + i] = bits.te(n - 1)
							fail "h264: bad ref_idx" when refIdx[l * 4 + i] >= n
						} else {
							refIdx[l * 4 + i] = 0
						}
					}
				}
				for let l = 0; l < 2; l++ {
					for let i = 0; i < parts; i++ {
						continue unless h264PartUses(mbType, i, l)
						mvdX[l * 16 + i] = bits.se()
						mvdY[l * 16 + i] = bits.se()
					}
				}
			}
			if (mbType & h264MbIntra16x16) == 0 {
				let code = bits.ue()
				if mono || full {
					fail "h264: bad coded_block_pattern" when code > 15
					cbp = (mbType & h264MbIntra4x4) != 0 ?? (h264IntraCbpMono[code], h264InterCbpMono[code])
				} else {
					fail "h264: bad coded_block_pattern" when code > 47
					cbp = (mbType & h264MbIntra4x4) != 0 ?? (h264IntraCbp[code], h264InterCbp[code])
				}
				if (cbp & 15) != 0 && dct8Allowed && (mbType & h264MbIntra) == 0 {
					if (mbType & h264MbDirect) == 0 || sps.direct8x8Inference {
						mbType = mbType | h264MbDct8 when bits.flag()
					}
				}
			}
			if cbp != 0 || (mbType & h264MbIntra16x16) != 0 {
				let dq = bits.se()
				fail "h264: bad mb_qp_delta" when dq < -26 - (qpBd >> 1) || dq > 25 + (qpBd >> 1)
				applyQpDelta(dq)
				try residualCavlc()
			} else {
				clearNz()
				cbpGrid[mbAddr] = 0
			}
		}

		// Reads the samples of an I_PCM macroblock, `sps` bit depth each,
		// from the byte-aligned position of `bits`.
		def readPcm() !none {
			let size = mono ?? (256, full ?? (768, 256 + cBlocks * 32))
			let depth = sps.bitDepthLuma
			fail "h264: truncated I_PCM macroblock" when (bits.pos >> 3) + ((size * depth) >> 3) > bits.limit
			for let i = 0; i < size; i++ {
				pcm[i] = bits.u(depth)
			}
		}

		// Applies mb_qp_delta to the running QP.
		def applyQpDelta(dq int) {
			lastDqp = dq
			let next = (qp + dq + 52 + qpBd) % (52 + qpBd)
			bypass = sps.transformBypass && next == 0
			if dq != 0 {
				qp = next
				updateChromaQp()
			}
		}

		// Neighbour coefficient count nC of the 4x4 block (bx, by) of the
		// macroblock in the luma-like plane whose counts are `g`.
		def lumaNc(g int[], bx int, by int) int {
			let ia = loc.luma(bx * 4 - 1, by * 4)
			let ib = loc.luma(bx * 4, by * 4 - 1)
			let na = ia >= 0 ?? (g[ia], 0)
			let nb = ib >= 0 ?? (g[ib], 0)
			return (na + nb + 1) >> 1 when ia >= 0 && ib >= 0
			return na + nb
		}

		// nC of chroma 4x4 block (bx, by) of the macroblock.
		def chromaNc(g int[], bx int, by int) int {
			let ia = loc.chroma(bx * 4 - 1, by * 4, crows)
			let ib = loc.chroma(bx * 4, by * 4 - 1, crows)
			let na = ia >= 0 ?? (g[ia], 0)
			let nb = ib >= 0 ?? (g[ib], 0)
			return (na + nb + 1) >> 1 when ia >= 0 && ib >= 0
			return na + nb
		}

		// Parses the residual of a CAVLC macroblock.
		def residualCavlc() !none {
			let intra = (mbType & h264MbIntra) != 0
			cbpGrid[mbAddr] = 0
			let planes = full ?? (3, 1)
			for let p = 0; p < planes; p++ {
				try planeCavlc(p, intra)
			}
			if full {
				cbpGrid[mbAddr] = cbpGrid[mbAddr] | cbp
				return none
			}
			try chromaCavlc(intra)
			return none
		}

		// Parses the CAVLC residual of plane `p` coded like luma: the luma
		// plane, or Cb and Cr of 4:4:4.
		def planeCavlc(p int, intra bool) !none {
			let gx0 = mbx * 4
			let gy0 = mby * 4
			let g = nzOf(p)
			let q = qpOf(p)
			let base = p * h264CoeffPlane
			let dq4 = pps.dequant4
			// Arrays passed to every block call held in locals: passing a
			// field retains it each time.
			let coeffs = coeff
			let zig4 = scan4
			let list4 = (intra ?? (0, 3)) + p
			if (mbType & h264MbIntra16x16) != 0 {
				let n = cavlc.block(bits, lumaNc(g, 0, 0), 16, lumaDc, p * 16, zig4, 0, 1, dq4, -1, 4)
				fail "h264: bad CAVLC luma DC block" when n < 0
				cbpGrid[mbAddr] = cbpGrid[mbAddr] | dcBit(p) when n > 0
				for let z = 0; z < 16; z++ {
					let r = h264Raster[z]
					let bx = r & 3
					let by = r >> 2
					let i = (gy0 + by) * gw + gx0 + bx
					if (cbp & 15) != 0 {
						let k = cavlc.block(bits, lumaNc(g, bx, by), 15, coeffs, base + r * 16, zig4, 1, 1, dq4, dqAt4(list4, q), 4)
						fail "h264: bad CAVLC luma AC block" when k < 0
						g[i] = k
					} else {
						g[i] = 0
					}
				}
				return none
			}
			let dct8 = (mbType & h264MbDct8) != 0
			let list8 = 2 * p + (intra ?? (0, 1))
			for let b8 = 0; b8 < 4; b8++ {
				let bx8 = (b8 & 1) * 2
				let by8 = (b8 >> 1) * 2
				if (cbp & (1 << b8)) == 0 {
					fillGrid(g, bx8, by8, 2, 2, 0)
					continue
				}
				for let k = 0; k < 4; k++ {
					let bx = bx8 + (k & 1)
					let by = by8 + (k >> 1)
					let nc = lumaNc(g, bx, by)
					let n = 0
					if dct8 {
						n = cavlc.block(bits, nc, 16, coeffs, base + b8 * 64, scan8, k, 4, pps.dequant8, dqAt8(list8, q), 6)
					} else {
						let r = by * 4 + bx
						n = cavlc.block(bits, nc, 16, coeffs, base + r * 16, zig4, 0, 1, dq4, dqAt4(list4, q), 4)
					}
					fail "h264: bad CAVLC luma block" when n < 0
					g[(gy0 + by) * gw + gx0 + bx] = n
				}
			}
			return none
		}

		// Parses the chroma residual of a CAVLC macroblock.
		def chromaCavlc(intra bool) !none {
			let dq4 = pps.dequant4
			// Arrays passed to every block call held in locals: passing a
			// field retains it each time.
			let coeffs = coeff
			let zig4 = scan4
			if (cbp & 0x30) != 0 {
				for let c = 0; c < 2; c++ {
					let n = 0
					if c422 {
						n = cavlc.block(bits, -2, 8, chromaDc, c * 8, h264Chroma422DcScan, 0, 1, dq4, -1, 4)
					} else {
						n = cavlc.block(bits, -1, 4, chromaDc, c * 8, h264ChromaDcScan, 0, 1, dq4, -1, 4)
					}
					fail "h264: bad CAVLC chroma DC block" when n < 0
					cbpGrid[mbAddr] = cbpGrid[mbAddr] | (c == 0 ?? (h264CbpCbDc, h264CbpCrDc)) when n > 0
				}
			}
			let c0 = mby * crows * cgw + mbx * 2
			for let c = 0; c < 2; c++ {
				let g = c == 0 ?? (nzCb, nzCr)
				let list = (intra ?? (1, 4)) + c
				let q = c == 0 ?? (qpc0, qpc1)
				for let b = 0; b < cBlocks; b++ {
					let i = c0 + (b >> 1) * cgw + (b & 1)
					if (cbp & 0x20) != 0 {
						let n = cavlc.block(bits, chromaNc(g, b & 1, b >> 1), 15, coeffs, chromaBase(c) + b * 16, zig4, 1, 1, dq4, dqAt4(list, q), 4)
						fail "h264: bad CAVLC chroma AC block" when n < 0
						g[i] = n
					} else {
						g[i] = 0
					}
				}
			}
			cbpGrid[mbAddr] = cbpGrid[mbAddr] | cbp
		}

		// ---- CABAC ----

		def decodeSkipFlag() int {
			let inc = 0
			inc++ when availA && (pic.mbType[mbA] & h264MbSkip) == 0
			inc++ when availB && (pic.mbType[mbB] & h264MbSkip) == 0
			return cabac.decision((sliceB ?? (24, 11)) + inc)
		}

		// Decodes an I mb_type with CABAC from context `base`; `intraSlice`
		// selects the I slice layout.
		def cabacIntraType(base int, intraSlice bool) int {
			let s = base
			if intraSlice {
				let inc = 0
				inc++ when availA && (pic.mbType[mbA] & (h264MbIntra16x16 | h264MbPcm)) != 0
				inc++ when availB && (pic.mbType[mbB] & (h264MbIntra16x16 | h264MbPcm)) != 0
				return 0 when cabac.decision(s + inc) == 0
				s += 2
			} else {
				return 0 when cabac.decision(s) == 0
			}
			return 25 when cabac.terminate() == 1
			let ix = intraSlice ?? (1, 0)
			let t = 1 + 12 * cabac.decision(s + 1)
			t += 4 + 4 * cabac.decision(s + 2 + ix) when cabac.decision(s + 2) == 1
			t += 2 * cabac.decision(s + 3 + ix)
			t += cabac.decision(s + 3 + 2 * ix)
			return t
		}

		def cabacMbType() int {
			if sliceB {
				let inc = 0
				inc++ when availA && (pic.mbType[mbA] & h264MbDirect) == 0
				inc++ when availB && (pic.mbType[mbB] & h264MbDirect) == 0
				return 0 when cabac.decision(27 + inc) == 0
				return 1 + cabac.decision(32) when cabac.decision(30) == 0
				let b = cabac.decision(31) << 3
				b = b | (cabac.decision(32) << 2)
				b = b | (cabac.decision(32) << 1)
				b = b | cabac.decision(32)
				return b + 3 when b < 8
				return 23 + cabacIntraType(32, false) when b == 13
				return 11 when b == 14
				return 22 when b == 15
				b = (b << 1) | cabac.decision(32)
				return b - 4
			}
			if sliceP {
				if cabac.decision(14) == 0 {
					return 3 * cabac.decision(16) when cabac.decision(15) == 0
					return 2 - cabac.decision(17)
				}
				return 5 + cabacIntraType(17, false)
			}
			return cabacIntraType(3, true)
		}

		def cabacSubType() int {
			if sliceB {
				return 0 when cabac.decision(36) == 0
				return 1 + cabac.decision(39) when cabac.decision(37) == 0
				let t = 3
				if cabac.decision(38) == 1 {
					return 11 + cabac.decision(39) when cabac.decision(39) == 1
					t += 4
				}
				t += 2 * cabac.decision(39)
				t += cabac.decision(39)
				return t
			}
			return 0 when cabac.decision(21) == 1
			return 1 when cabac.decision(22) == 0
			return 2 when cabac.decision(23) == 1
			return 3
		}

		// ref_idx of `list` for the partition whose top-left 4x4 block is
		// (bx, by).
		def cabacRef(list int, bx int, by int) int {
			let inc = refTerm(list, bx * 4 - 1, by * 4) + 2 * refTerm(list, bx * 4, by * 4 - 1)
			let ref = 0
			let ctx = inc
			for cabac.decision(54 + ctx) == 1 {
				ref++
				ctx = ctx < 4 ?? (4, 5)
				return ref when ref >= 32
			}
			return ref
		}

		// Whether the neighbouring partition at luma location (xN, yN)
		// counts for the ref_idx context: it uses `list` with an index above
		// 0 (a frame macroblock reads a field neighbour's index halved) and
		// is not direct predicted.
		def refTerm(list int, xN int, yN int) int {
			let i = loc.luma(xN, yN)
			return 0 when i < 0
			let r = list == 0 ?? (pic.ref0[i], pic.ref1[i])
			let limit = (mbaff && !fieldMb && loc.isField(loc.found)) ?? (1, 0)
			return (r > limit && !(sliceB && direct[i] != 0)) ?? (1, 0)
		}

		// One mvd component; `amvd` is the sum of the neighbours' absolute
		// values.
		def cabacMvd(base int, amvd int) int {
			let inc = amvd < 3 ?? (0, amvd > 32 ?? (2, 1))
			return 0 when cabac.decision(base + inc) == 0
			let v = 1
			let ctx = base + 3
			for v < 9 && cabac.decision(ctx) == 1 {
				ctx++ when v < 4
				v++
			}
			if v >= 9 {
				let k = 3
				for cabac.bypass() == 1 {
					v += 1 << k
					k++
					break when k > 24
				}
				for k > 0 {
					k--
					v += cabac.bypass() << k
				}
			}
			return cabac.bypass() == 1 ?? (0 - v, v)
		}

		// Parses both mvd components of `list` for the partition at (bx, by)
		// of w x h blocks into slot `slot`, and records their magnitudes.
		def cabacMvdPart(list int, bx int, by int, w int, h int, slot int) {
			let g = list == 0 ?? (mvd0, mvd1)
			let ax = 0
			let ay = 0
			let ia = loc.luma(bx * 4 - 1, by * 4)
			if ia >= 0 {
				ax += g[2 * ia]
				ay += mvdScaled(g[2 * ia + 1])
			}
			let ib = loc.luma(bx * 4, by * 4 - 1)
			if ib >= 0 {
				ax += g[2 * ib]
				ay += mvdScaled(g[2 * ib + 1])
			}
			let dx = cabacMvd(40, ax)
			let dy = cabacMvd(47, ay)
			mvdX[list * 16 + slot] = dx
			mvdY[list * 16 + slot] = dy
			fillMvd(list, bx, by, w, h, h264Abs(dx), h264Abs(dy))
		}

		// A vertical mvd magnitude of the macroblock last located, in the
		// units of the current one: field lines are half frame lines.
		def mvdScaled(v int) int {
			return v unless mbaff
			let nf = loc.isField(loc.found)
			return v * 2 when !fieldMb && nf
			return v >> 1 when fieldMb && !nf
			return v
		}

		def cabacChromaMode() int {
			let inc = 0
			inc++ when availA && (pic.mbType[mbA] & (h264MbIntra4x4 | h264MbIntra16x16)) != 0 && chromaGrid[mbA] != 0
			inc++ when availB && (pic.mbType[mbB] & (h264MbIntra4x4 | h264MbIntra16x16)) != 0 && chromaGrid[mbB] != 0
			return 0 when cabac.decision(64 + inc) == 0
			return 1 when cabac.decision(67) == 0
			return 2 when cabac.decision(67) == 0
			return 3
		}

		// The coded block pattern word of a neighbour for CABAC contexts, or
		// the stand-in for an unavailable one.
		def cbpOf(avail bool, mb int) int {
			return (mbType & h264MbIntra) != 0 ?? (0x1cf, 0x0f) unless avail
			return h264CbpPcm when (pic.mbType[mb] & h264MbPcm) != 0
			return cbpGrid[mb]
		}

		def cabacCbp() int {
			let left = cbpOf(availA, mbA)
			let top = cbpOf(availB, mbB)
			// Luma: the neighbouring 8x8 blocks, inside or outside the macroblock.
			let c = 0
			for let b8 = 0; b8 < 4; b8++ {
				let x = (b8 & 1) * 8
				let y = (b8 >> 1) * 8
				let a = cbpTerm(x - 1, y, c)
				let b = cbpTerm(x, y - 1, c)
				c = c | (cabac.decision(73 + a + 2 * b) << b8)
			}
			return c when mono || full
			let ca = (left >> 4) & 3
			let cb = (top >> 4) & 3
			let inc = (ca > 0 ?? (1, 0)) + (cb > 0 ?? (2, 0))
			return c when cabac.decision(77 + inc) == 0
			inc = 4 + (ca == 2 ?? (1, 0)) + (cb == 2 ?? (2, 0))
			return c | ((1 + cabac.decision(77 + inc)) << 4)
		}

		// Whether the 8x8 block at luma location (xN, yN) had no luma
		// coefficients, for the coded_block_pattern context; `c` holds the
		// bits of the current macroblock decoded so far.
		def cbpTerm(xN int, yN int, c int) int {
			let mb = loc.locate(xN, yN, 16, 16)
			return 0 when mb < 0
			let b8 = (loc.y >> 3) * 2 + (loc.x >> 3)
			let word = mb == mbAddr ?? (c, cbpOf(true, mb))
			return ((word >> b8) & 1) == 0 ?? (1, 0)
		}

		def cabacDct8() int {
			let inc = 0
			inc++ when availA && (pic.mbType[mbA] & h264MbDct8) != 0
			inc++ when availB && (pic.mbType[mbB] & h264MbDct8) != 0
			return cabac.decision(399 + inc)
		}

		// Parses one macroblock (not skipped) with CABAC.
		def parseCabac() !none {
			cbp = 0
			let raw = cabacMbType()
			if sliceB {
				if raw < 23 {
					mbType = h264BMbTypes[raw]
				} else {
					decodeIntraType(raw - 23)
				}
			} else if sliceP {
				if raw < 5 {
					mbType = h264PMbTypes[raw]
				} else {
					decodeIntraType(raw - 5)
				}
			} else {
				decodeIntraType(raw)
			}
			pic.mbType[mbAddr] = mbType | fieldBit
			if mbType == h264MbPcm {
				bits.pos = cabac.alignedPosition() * 8
				try readPcm()
				cabac.start(bits.data, bits.pos >> 3, bits.limit)
				lastDqp = 0
				return none
			}
			let dct8Allowed = pps.transform8x8
			if (mbType & h264MbIntra) != 0 {
				fillGrid(direct, 0, 0, 4, 4, 0)
				if (mbType & h264MbIntra4x4) != 0 {
					if pps.transform8x8 && cabacDct8() == 1 {
						mbType = mbType | h264MbDct8
						pic.mbType[mbAddr] = mbType | fieldBit
					}
					let n = (mbType & h264MbDct8) != 0 ?? (4, 16)
					for let i = 0; i < n; i++ {
						prevFlag[i] = cabac.decision(68)
						if prevFlag[i] == 0 {
							let m = cabac.decision(69)
							m = m | (cabac.decision(69) << 1)
							m = m | (cabac.decision(69) << 2)
							remMode[i] = m
						}
					}
				}
				chromaMode = (mono || full) ?? (0, cabacChromaMode())
			} else if (mbType & h264Mb8x8) != 0 {
				for let i = 0; i < 4; i++ {
					let st = cabacSubType()
					subType[i] = sliceB ?? (h264BSubTypes[st], h264PSubTypes[st])
					let d = (subType[i] & h264SubDirect) != 0 ?? (1, 0)
					fillGrid(direct, (i & 1) * 2, (i >> 1) * 2, 2, 2, d)
					if d == 1 {
						dct8Allowed = false unless sps.direct8x8Inference
					} else if (subType[i] & 3) != 0 {
						dct8Allowed = false
					}
				}
				for let l = 0; l < 2; l++ {
					let lf = l == 0 ?? (h264SubL0, h264SubL1)
					let n = activeRefs(l)
					for let i = 0; i < 4; i++ {
						let st = subType[i]
						let bx = (i & 1) * 2
						let by = (i >> 1) * 2
						if (st & h264SubDirect) != 0 {
							continue
						}
						let r = -1
						if (st & lf) != 0 {
							r = 0
							if n > 1 && (mbType & h264MbRef0) == 0 {
								r = cabacRef(l, bx, by)
								fail "h264: bad ref_idx" when r >= n
							}
						}
						refIdx[l * 4 + i] = r
						motion.fill(l, bx, by, 2, 2, r, 0, 0)
					}
				}
				for let l = 0; l < 2; l++ {
					let lf = l == 0 ?? (h264SubL0, h264SubL1)
					for let i = 0; i < 4; i++ {
						let st = subType[i]
						let bx = (i & 1) * 2
						let by = (i >> 1) * 2
						if (st & h264SubDirect) != 0 || (st & lf) == 0 {
							fillMvd(l, bx, by, 2, 2, 0, 0)
							continue
						}
						let shape = st & 3
						if shape == 0 {
							cabacMvdPart(l, bx, by, 2, 2, i * 4)
						} else if shape == 1 {
							cabacMvdPart(l, bx, by, 2, 1, i * 4)
							cabacMvdPart(l, bx, by + 1, 2, 1, i * 4 + 1)
						} else if shape == 2 {
							cabacMvdPart(l, bx, by, 1, 2, i * 4)
							cabacMvdPart(l, bx + 1, by, 1, 2, i * 4 + 1)
						} else {
							cabacMvdPart(l, bx, by, 1, 1, i * 4)
							cabacMvdPart(l, bx + 1, by, 1, 1, i * 4 + 1)
							cabacMvdPart(l, bx, by + 1, 1, 1, i * 4 + 2)
							cabacMvdPart(l, bx + 1, by + 1, 1, 1, i * 4 + 3)
						}
					}
				}
			} else if (mbType & h264MbDirect) != 0 {
				fillGrid(direct, 0, 0, 4, 4, 1)
				fillMvd(0, 0, 0, 4, 4, 0, 0)
				fillMvd(1, 0, 0, 4, 4, 0, 0)
				dct8Allowed = dct8Allowed && sps.direct8x8Inference
			} else {
				fillGrid(direct, 0, 0, 4, 4, 0)
				let parts = (mbType & h264Mb16x16) != 0 ?? (1, 2)
				let is16x8 = (mbType & h264Mb16x8) != 0
				for let l = 0; l < 2; l++ {
					let n = activeRefs(l)
					for let i = 0; i < parts; i++ {
						let bx = (parts == 2 && !is16x8) ?? (i * 2, 0)
						let by = (parts == 2 && is16x8) ?? (i * 2, 0)
						let w = (parts == 1 || is16x8) ?? (4, 2)
						let h = (parts == 1 || !is16x8) ?? (4, 2)
						let r = -1
						if h264PartUses(mbType, i, l) {
							r = 0
							if n > 1 {
								r = cabacRef(l, bx, by)
								fail "h264: bad ref_idx" when r >= n
							}
						}
						refIdx[l * 4 + i] = r
						motion.fill(l, bx, by, w, h, r, 0, 0)
					}
				}
				for let l = 0; l < 2; l++ {
					for let i = 0; i < parts; i++ {
						let bx = (parts == 2 && !is16x8) ?? (i * 2, 0)
						let by = (parts == 2 && is16x8) ?? (i * 2, 0)
						let w = (parts == 1 || is16x8) ?? (4, 2)
						let h = (parts == 1 || !is16x8) ?? (4, 2)
						if h264PartUses(mbType, i, l) {
							cabacMvdPart(l, bx, by, w, h, i)
						} else {
							fillMvd(l, bx, by, w, h, 0, 0)
						}
					}
				}
			}
			if (mbType & h264MbIntra) != 0 {
				fillMvd(0, 0, 0, 4, 4, 0, 0)
				fillMvd(1, 0, 0, 4, 4, 0, 0)
			}
			cbp = cabacCbp() when (mbType & h264MbIntra16x16) == 0
			if dct8Allowed && (cbp & 15) != 0 && (mbType & h264MbIntra) == 0 {
				mbType = mbType | h264MbDct8 when cabacDct8() == 1
			}
			pic.mbType[mbAddr] = mbType | fieldBit
			if cbp != 0 || (mbType & h264MbIntra16x16) != 0 {
				let dq = 0
				if cabac.decision(60 + (lastDqp != 0 ?? (1, 0))) == 1 {
					let k = 1
					let ctx = 62
					for cabac.decision(ctx) == 1 {
						ctx = 63
						k++
						fail "h264: bad mb_qp_delta" when k > 2 * (52 + qpBd)
					}
					dq = (k & 1) == 1 ?? ((k + 1) >> 1, 0 - (k >> 1))
					fail "h264: bad mb_qp_delta" when dq < -26 - (qpBd >> 1) || dq > 25 + (qpBd >> 1)
				}
				applyQpDelta(dq)
				residualCabac()
			} else {
				clearNz()
				cbpGrid[mbAddr] = 0
				lastDqp = 0
			}
		}

		// coded_block_flag context increment of 4x4 block (bx, by) of the
		// macroblock in the luma-like plane whose counts are `g`: whether its
		// left and top neighbours had coefficients.
		def lumaCbfInc(g int[], bx int, by int) int {
			return cbfTerm(g, loc.luma(bx * 4 - 1, by * 4)) + 2 * cbfTerm(g, loc.luma(bx * 4, by * 4 - 1))
		}

		// coded_block_flag condition of the neighbouring block at grid index
		// `i` (-1 unavailable) of the macroblock last located.
		def cbfTerm(g int[], i int) int {
			return (mbType & h264MbIntra) != 0 ?? (1, 0) when i < 0
			return 1 when loc.found != mbAddr && (pic.mbType[loc.found] & h264MbPcm) != 0
			return g[i] != 0 ?? (1, 0)
		}

		// coded_block_flag context increment of an 8x8 block of 4:4:4 whose
		// top-left 4x4 block is (bx, by): a neighbouring macroblock counts
		// only when it used the 8x8 transform.
		def cbf8Inc(g int[], bx int, by int) int {
			return cbf8Term(g, loc.luma(bx * 4 - 1, by * 4)) + 2 * cbf8Term(g, loc.luma(bx * 4, by * 4 - 1))
		}

		def cbf8Term(g int[], i int) int {
			return (mbType & h264MbIntra) != 0 ?? (1, 0) when i < 0
			return g[i] != 0 ?? (1, 0) when loc.found == mbAddr
			let t = pic.mbType[loc.found]
			return g[i] != 0 ?? (1, 0) when (t & h264MbDct8) != 0
			return (mbType & h264MbIntra) != 0 ?? (1, 0) when oldX264
			return (t & h264MbPcm) != 0 ?? (1, 0)
		}

		// coded_block_flag context increment of chroma block (bx, by).
		def chromaCbfInc(g int[], bx int, by int) int {
			return cbfTerm(g, loc.chroma(bx * 4 - 1, by * 4, crows)) + 2 * cbfTerm(g, loc.chroma(bx * 4, by * 4 - 1, crows))
		}

		// coded_block_flag context increment of a DC block from the
		// neighbours' DC flags `bit` in their coded block pattern words.
		def dcCbfInc(bit int) int {
			let left = cbpOf(availA, mbA)
			let top = cbpOf(availB, mbB)
			return ((left & bit) != 0 ?? (1, 0)) + ((top & bit) != 0 ?? (2, 0))
		}

		// Parses the residual of a CABAC macroblock.
		def residualCabac() {
			let intra = (mbType & h264MbIntra) != 0
			let word = 0
			let planes = full ?? (3, 1)
			for let p = 0; p < planes; p++ {
				word = word | planeCabac(p, intra)
			}
			if full {
				cbpGrid[mbAddr] = word | cbp
				return
			}
			let dq4 = pps.dequant4
			// Arrays passed to every block call held in locals: passing a
			// field retains it each time.
			let coeffs = coeff
			let zig4 = scan4
			if (cbp & 0x30) != 0 {
				for let c = 0; c < 2; c++ {
					let bit = c == 0 ?? (h264CbpCbDc, h264CbpCrDc)
					if cabac.decision(97 + dcCbfInc(bit)) == 1 {
						cabac.residual(3, cBlocks, chromaDc, c * 8, c422 ?? (h264Chroma422DcScan, h264ChromaDcScan), 0, dq4, -1, 4)
						word = word | bit
					}
				}
			}
			let c0 = mby * crows * cgw + mbx * 2
			for let c = 0; c < 2; c++ {
				let g = c == 0 ?? (nzCb, nzCr)
				let list = (intra ?? (1, 4)) + c
				let q = c == 0 ?? (qpc0, qpc1)
				for let b = 0; b < cBlocks; b++ {
					let i = c0 + (b >> 1) * cgw + (b & 1)
					if (cbp & 0x20) != 0 && cabac.decision(101 + chromaCbfInc(g, b & 1, b >> 1)) == 1 {
						g[i] = cabac.residual(4, 15, coeffs, chromaBase(c) + b * 16, zig4, 1, dq4, dqAt4(list, q), 4)
					} else {
						g[i] = 0
					}
				}
			}
			cbpGrid[mbAddr] = word | cbp
		}

		// Parses the CABAC residual of plane `p` coded like luma: the luma
		// plane, or Cb and Cr of 4:4:4. Returns the plane's DC bit of the
		// coded block pattern word when its Intra 16x16 DC block had
		// coefficients, 0 otherwise.
		def planeCabac(p int, intra bool) int {
			let gx0 = mbx * 4
			let gy0 = mby * 4
			let g = nzOf(p)
			let q = qpOf(p)
			let base = p * h264CoeffPlane
			let dq4 = pps.dequant4
			// Arrays passed to every block call held in locals: passing a
			// field retains it each time.
			let coeffs = coeff
			let zig4 = scan4
			let list4 = (intra ?? (0, 3)) + p
			// ctxBlockCat of the plane's DC, AC and 4x4 blocks is this plus
			// 0, 1 and 2; its 8x8 blocks are 5 + 4 * p.
			let cat0 = p == 0 ?? (0, p == 1 ?? (6, 10))
			let word = 0
			if (mbType & h264MbIntra16x16) != 0 {
				if cabac.decision(h264CbfOffset[cat0] + dcCbfInc(dcBit(p))) == 1 {
					cabac.residual(cat0, 16, lumaDc, p * 16, zig4, 0, dq4, -1, 4)
					word = dcBit(p)
				}
				for let z = 0; z < 16; z++ {
					let r = h264Raster[z]
					let bx = r & 3
					let by = r >> 2
					let i = (gy0 + by) * gw + gx0 + bx
					if (cbp & 15) != 0 && cabac.decision(h264CbfOffset[cat0 + 1] + lumaCbfInc(g, bx, by)) == 1 {
						g[i] = cabac.residual(cat0 + 1, 15, coeffs, base + r * 16, zig4, 1, dq4, dqAt4(list4, q), 4)
					} else {
						g[i] = 0
					}
				}
				return word
			}
			let dct8 = (mbType & h264MbDct8) != 0
			let cat8 = 5 + 4 * p
			let list8 = 2 * p + (intra ?? (0, 1))
			for let b8 = 0; b8 < 4; b8++ {
				let bx8 = (b8 & 1) * 2
				let by8 = (b8 >> 1) * 2
				if (cbp & (1 << b8)) == 0 {
					fillGrid(g, bx8, by8, 2, 2, 0)
					continue
				}
				if dct8 {
					// Only 4:4:4 codes coded_block_flag for 8x8 blocks.
					if full && cabac.decision(h264CbfOffset[cat8] + cbf8Inc(g, bx8, by8)) == 0 {
						fillGrid(g, bx8, by8, 2, 2, 0)
						continue
					}
					let n = cabac.residual(cat8, 64, coeffs, base + b8 * 64, scan8, 0, pps.dequant8, dqAt8(list8, q), 6)
					fillGrid(g, bx8, by8, 2, 2, n)
					continue
				}
				for let k = 0; k < 4; k++ {
					let bx = bx8 + (k & 1)
					let by = by8 + (k >> 1)
					let i = (gy0 + by) * gw + gx0 + bx
					if cabac.decision(h264CbfOffset[cat0 + 2] + lumaCbfInc(g, bx, by)) == 1 {
						let r = by * 4 + bx
						g[i] = cabac.residual(cat0 + 2, 16, coeffs, base + r * 16, zig4, 0, dq4, dqAt4(list4, q), 4)
					} else {
						g[i] = 0
					}
				}
			}
			return word
		}

		// ---- Reconstruction ----

		// Stores what later macroblocks need and reconstructs the samples of
		// the macroblock just parsed.
		def finishMb() !none {
			// A macroblock at QP 0 is lossless whether or not it has a
			// residual: old x264 predicts it differently.
			bypass = sps.transformBypass && qp == 0
			pic.mbType[mbAddr] = mbType | fieldBit
			qpGrid[mbAddr] = qp
			if mbType == h264MbPcm {
				qpGrid[mbAddr] = qpBd
				cbpGrid[mbAddr] = h264CbpPcm
				chromaGrid[mbAddr] = 0
				fillGrid(nzc, 0, 0, 4, 4, 16)
				if full {
					fillGrid(nzc1, 0, 0, 4, 4, 16)
					fillGrid(nzc2, 0, 0, 4, 4, 16)
				}
				fillChromaNz(16)
				fillGrid(modes, 0, 0, 4, 4, 2)
				fillGrid(direct, 0, 0, 4, 4, 0)
				fillMvd(0, 0, 0, 4, 4, 0, 0)
				fillMvd(1, 0, 0, 4, 4, 0, 0)
				motion.clearMb()
				reconstruct()
				return none
			}
			if (mbType & h264MbIntra) != 0 {
				motion.clearMb()
				fillGrid(direct, 0, 0, 4, 4, 0)
				chromaGrid[mbAddr] = chromaMode
				fillGrid(modes, 0, 0, 4, 4, 2) when (mbType & h264MbIntra16x16) != 0
			} else {
				chromaGrid[mbAddr] = 0
				fillGrid(modes, 0, 0, 4, 4, -1)
				if (mbType & h264MbDirect) == 0 {
					fillGrid(direct, 0, 0, 4, 4, 0) when (mbType & h264Mb8x8) == 0
				}
				interMotion()
			}
			reconstruct()
		}

		// Reconstructs the samples of the macroblock whose syntax and motion
		// are in place, in the storage of the picture's depth.
		def reconstruct() {
			if deep {
				samplesOf(kit16)
			} else {
				samplesOf(kit8)
			}
		}

		def samplesOf<T: H264Sample>(k H264Kit<T>) {
			if mbType == h264MbPcm {
				writePcm(k)
				return
			}
			if (mbType & h264MbIntra) != 0 {
				intraPlane(k, 0)
				if full {
					intraPlane(k, 1)
					intraPlane(k, 2)
				} else if !mono {
					intraChroma(k)
				}
			} else {
				interPredict(k)
				let planes = full ?? (3, 1)
				for let p = 0; p < planes; p++ {
					planeResidual(k, p)
				}
			}
			chromaResidual(k) unless full
		}

		// Copies the I_PCM samples into the picture.
		def writePcm<T: H264Sample>(k H264Kit<T>) {
			let pl = k.planes(pic)
			let y0 = ly0
			for let j = 0; j < 16; j++ {
				let o = y0 + j * ls
				for let i = 0; i < 16; i++ {
					pl.y[o + i] = T(pcm[j * 16 + i])
				}
			}
			return when mono
			if full {
				for let j = 0; j < 16; j++ {
					let o = y0 + j * ls
					for let i = 0; i < 16; i++ {
						pl.u[o + i] = T(pcm[256 + j * 16 + i])
						pl.v[o + i] = T(pcm[512 + j * 16 + i])
					}
				}
				return
			}
			let rows = crows * 4
			let c0 = cy0
			let cr = 256 + rows * 8
			for let j = 0; j < rows; j++ {
				let o = c0 + j * cls
				for let i = 0; i < 8; i++ {
					pl.u[o + i] = T(pcm[256 + j * 8 + i])
					pl.v[o + i] = T(pcm[cr + j * 8 + i])
				}
			}
		}

		// The predicted intra 4x4/8x8 mode of block (bx, by) of the
		// macroblock.
		def predictedMode(bx int, by int) int {
			let ia = loc.luma(bx * 4 - 1, by * 4)
			let ib = loc.luma(bx * 4, by * 4 - 1)
			return 2 unless ia >= 0 && ib >= 0
			let ma = modes[ia]
			let mb = modes[ib]
			if ma < 0 {
				return 2 when constrained
				ma = 2
			}
			if mb < 0 {
				return 2 when constrained
				mb = 2
			}
			return ma < mb ?? (ma, mb)
		}

		// Intra prediction and residual of plane `p` coded like luma: the luma
		// plane, or Cb and Cr of 4:4:4, which reuse the luma modes.
		def intraPlane<T: H264Sample>(k H264Kit<T>, p int) {
			let pl = k.planes(pic)
			let dst = p == 0 ?? (pl.y, p == 1 ?? (pl.u, pl.v))
			let max = k.max
			let g = nzOf(p)
			let base = p * h264CoeffPlane
			let stride = ls
			let y0 = ly0
			let gx0 = mbx * 4
			let gy0 = mby * 4
			if (mbType & h264MbIntra16x16) != 0 {
				let top = intraAt(0, -1)
				let left = intraLeft(-1, 0, 16)
				let topLeft = intraAt(-1, -1)
				let mode16 = h264Fix16Mode(i16Mode, top, left, topLeft)
				h264Pred16(dst, y0, stride, mode16, top, left, max)
				if bypass {
					// The DC levels are the blocks' DC residuals.
					if (cbpGrid[mbAddr] & dcBit(p)) != 0 {
						for let r = 0; r < 16; r++ {
							coeff[base + r * 16] = lumaDc[p * 16 + r]
							lumaDc[p * 16 + r] = 0
						}
					}
					gather4(base, 4, 4)
					h264AddResidual(dst, y0, stride, res, 16, 16, mode16 <= 1 ?? (mode16, -1), max)
					return
				}
				h264LumaDc(lumaDc, p * 16, coeff, base, pps.dequant4[(p * h264QpSpan + qpOf(p)) * 16]) when (cbpGrid[mbAddr] & dcBit(p)) != 0
				for let r = 0; r < 16; r++ {
					let bx = r & 3
					let by = r >> 2
					let off = y0 + by * 4 * stride + bx * 4
					let at = base + r * 16
					if g[(gy0 + by) * gw + gx0 + bx] != 0 {
						k.idct4(dst, off, stride, coeff, at, max)
					} else if coeff[at] != 0 {
						k.dc4(dst, off, stride, coeff[at], max)
						coeff[at] = 0
					}
				}
				return
			}
			if (mbType & h264MbDct8) != 0 {
				for let b8 = 0; b8 < 4; b8++ {
					let bx = (b8 & 1) * 2
					let by = (b8 >> 1) * 2
					let gx = gx0 + bx
					let gy = gy0 + by
					let mode = modes[gy * gw + gx]
					if p == 0 {
						let pred = predictedMode(bx, by)
						mode = prevFlag[b8] == 1 ?? (pred, remMode[b8] < pred ?? (remMode[b8], remMode[b8] + 1))
						fillGrid(modes, bx, by, 2, 2, mode)
					}
					let top = intraAt(bx * 4, by * 4 - 1)
					let left = intraLeft(bx * 4 - 1, by * 4, 8)
					let topLeft = intraAt(bx * 4 - 1, by * 4 - 1)
					let topRight = false
					if by == 0 {
						topRight = intraAt(bx * 4 + 8, -1)
					} else {
						topRight = bx == 0
					}
					let off = y0 + by * 4 * stride + bx * 4
					h264GatherEdge(dst, off, stride, 8, edge, top, left, topLeft, topRight)
					h264FilterEdge8(edge, edgeF, top, left, topLeft)
					// Old x264 predicted lossless vertical and horizontal
					// blocks from the unfiltered edge.
					let raw = bypass && oldX264 && mode <= 1
					h264PredBlock(dst, off, stride, 8, mode, raw ?? (edge, edgeF), top, left, max)
					continue when (cbp & (1 << b8)) == 0
					if bypass {
						take(base + b8 * 64, 64)
						h264AddResidual(dst, off, stride, res, 8, 8, mode <= 1 ?? (mode, -1), max)
					} else {
						k.idct8(dst, off, stride, coeff, base + b8 * 64, max)
					}
				}
				return
			}
			for let z = 0; z < 16; z++ {
				let r = h264Raster[z]
				let bx = r & 3
				let by = r >> 2
				let gx = gx0 + bx
				let gy = gy0 + by
				let mode = modes[gy * gw + gx]
				if p == 0 {
					let pred = predictedMode(bx, by)
					mode = prevFlag[z] == 1 ?? (pred, remMode[z] < pred ?? (remMode[z], remMode[z] + 1))
					modes[gy * gw + gx] = mode
				}
				let top = intraAt(bx * 4, by * 4 - 1)
				let left = intraLeft(bx * 4 - 1, by * 4, 4)
				let topLeft = intraAt(bx * 4 - 1, by * 4 - 1)
				let topRight = false
				if by == 0 {
					topRight = intraAt(bx * 4 + 4, -1)
				} else if bx < 3 {
					topRight = h264ZOrder[(by - 1) * 4 + bx + 1] < z
				}
				let off = y0 + by * 4 * stride + bx * 4
				h264GatherEdge(dst, off, stride, 4, edge, top, left, topLeft, topRight)
				h264PredBlock(dst, off, stride, 4, mode, edge, top, left, max)
				continue when g[gy * gw + gx] == 0
				if bypass {
					take(base + r * 16, 16)
					h264AddResidual(dst, off, stride, res, 4, 4, mode <= 1 ?? (mode, -1), max)
				} else {
					k.idct4(dst, off, stride, coeff, base + r * 16, max)
				}
			}
		}

		// Intra prediction of both chroma planes of the macroblock.
		def intraChroma<T: H264Sample>(k H264Kit<T>) {
			let pl = k.planes(pic)
			let cs = cls
			let rows = crows * 4
			let c0 = cy0
			let gx0 = mbx * 4
			let gy0 = mby * 4
			let top = intraAt(0, -1)
			// In MBAFF frames with constrained intra prediction, one half of
			// the left edge can be usable without the other: DC prediction
			// uses it per block.
			let upper = intraLeft(-1, 0, 8)
			let lower = intraLeft(-1, 8, 8)
			let mode = h264FixChromaMode(chromaMode, top, upper && lower, intraAt(-1, -1))
			chromaUsed = mode
			h264PredChroma(pl.u, c0, cs, mode, top, upper, lower, rows, k.max)
			h264PredChroma(pl.v, c0, cs, mode, top, upper, lower, rows, k.max)
		}

		// Adds the residual of plane `p` coded like luma to an inter
		// macroblock: the luma plane, or Cb and Cr of 4:4:4.
		def planeResidual<T: H264Sample>(k H264Kit<T>, p int) {
			return when (cbp & 15) == 0
			let pl = k.planes(pic)
			let dst = p == 0 ?? (pl.y, p == 1 ?? (pl.u, pl.v))
			let max = k.max
			let g = nzOf(p)
			let base = p * h264CoeffPlane
			let stride = ls
			let y0 = ly0
			let gx0 = mbx * 4
			let gy0 = mby * 4
			if (mbType & h264MbDct8) != 0 {
				for let b8 = 0; b8 < 4; b8++ {
					continue when (cbp & (1 << b8)) == 0
					let off = y0 + (b8 >> 1) * 8 * stride + (b8 & 1) * 8
					if bypass {
						take(base + b8 * 64, 64)
						h264AddResidual(dst, off, stride, res, 8, 8, -1, max)
					} else {
						k.idct8(dst, off, stride, coeff, base + b8 * 64, max)
					}
				}
				return
			}
			for let r = 0; r < 16; r++ {
				let bx = r & 3
				let by = r >> 2
				continue when g[(gy0 + by) * gw + gx0 + bx] == 0
				let off = y0 + by * 4 * stride + bx * 4
				if bypass {
					take(base + r * 16, 16)
					h264AddResidual(dst, off, stride, res, 4, 4, -1, max)
				} else {
					k.idct4(dst, off, stride, coeff, base + r * 16, max)
				}
			}
		}

		// Adds the chroma residual (DC and AC) of the macroblock.
		def chromaResidual<T: H264Sample>(k H264Kit<T>) {
			return when (cbp & 0x30) == 0
			let cs = cls
			let c0 = cy0
			let intra = (mbType & h264MbIntra) != 0
			let word = cbpGrid[mbAddr]
			let ci = mby * crows * cgw + mbx * 2
			for let c = 0; c < 2; c++ {
				let base = chromaBase(c)
				let pl = k.planes(pic)
				let plane = c == 0 ?? (pl.u, pl.v)
				let max = k.max
				let g = c == 0 ?? (nzCb, nzCr)
				if bypass {
					if (word & (c == 0 ?? (h264CbpCbDc, h264CbpCrDc))) != 0 {
						for let b = 0; b < cBlocks; b++ {
							coeff[base + b * 16] = chromaDc[c * 8 + b]
							chromaDc[c * 8 + b] = 0
						}
					}
					// Vertical and horizontal prediction take the residual
					// summed along their direction.
					let dpcm = !intra ?? (-1, chromaUsed == 2 ?? (0, chromaUsed == 1 ?? (1, -1)))
					gather4(base, 2, crows)
					h264AddResidual(plane, c0, cs, res, 8, crows * 4, dpcm, max)
					continue
				}
				if (word & (c == 0 ?? (h264CbpCbDc, h264CbpCrDc))) != 0 {
					let list = (intra ?? (1, 4)) + c
					let q = c == 0 ?? (qpc0, qpc1)
					if c422 {
						h264Chroma422Dc(chromaDc, c * 8, coeff, base, pps.dequant4[(list * h264QpSpan + q + 3) * 16])
					} else {
						h264ChromaDc(chromaDc, c * 8, coeff, base, pps.dequant4[(list * h264QpSpan + q) * 16])
					}
				}
				for let b = 0; b < cBlocks; b++ {
					let off = c0 + (b >> 1) * 4 * cs + (b & 1) * 4
					let at = base + b * 16
					if g[ci + (b >> 1) * cgw + (b & 1)] != 0 {
						k.idct4(plane, off, cs, coeff, at, max)
					} else if coeff[at] != 0 {
						k.dc4(plane, off, cs, coeff[at], max)
						coeff[at] = 0
					}
				}
			}
		}

		// Derives the motion vectors of a parsed inter macroblock.
		def interMotion() {
			if (mbType & h264MbDirect) != 0 {
				directMotion(-1)
				return
			}
			if (mbType & h264Mb16x16) != 0 {
				for let l = 0; l < 2; l++ {
					let r = refIdx[l * 4]
					if r < 0 {
						motion.fill(l, 0, 0, 4, 4, -1, 0, 0)
						continue
					}
					motion.predict(l, 0, 0, 4, r, h264ShapeAny)
					motion.fill(l, 0, 0, 4, 4, r, motion.mx + mvdX[l * 16], motion.my + mvdY[l * 16])
				}
				return
			}
			if (mbType & h264Mb16x8) != 0 {
				for let i = 0; i < 2; i++ {
					for let l = 0; l < 2; l++ {
						let r = refIdx[l * 4 + i]
						if r < 0 {
							motion.fill(l, 0, i * 2, 4, 2, -1, 0, 0)
							continue
						}
						motion.predict(l, 0, i * 2, 4, r, i == 0 ?? (h264Shape16x8Top, h264Shape16x8Bottom))
						motion.fill(l, 0, i * 2, 4, 2, r, motion.mx + mvdX[l * 16 + i], motion.my + mvdY[l * 16 + i])
					}
				}
				return
			}
			if (mbType & h264Mb8x16) != 0 {
				for let i = 0; i < 2; i++ {
					for let l = 0; l < 2; l++ {
						let r = refIdx[l * 4 + i]
						if r < 0 {
							motion.fill(l, i * 2, 0, 2, 4, -1, 0, 0)
							continue
						}
						motion.predict(l, i * 2, 0, 2, r, i == 0 ?? (h264Shape8x16Left, h264Shape8x16Right))
						motion.fill(l, i * 2, 0, 2, 4, r, motion.mx + mvdX[l * 16 + i], motion.my + mvdY[l * 16 + i])
					}
				}
				return
			}
			let prepared = false
			for let i = 0; i < 4; i++ {
				let st = subType[i]
				let bx = (i & 1) * 2
				let by = (i >> 1) * 2
				if (st & h264SubDirect) != 0 {
					if hdr.directSpatial && !prepared {
						motion.spatialPrepare()
						prepared = true
					}
					if hdr.directSpatial {
						motion.spatialBlocks(i)
					} else {
						motion.temporalBlocks(i)
					}
					continue
				}
				for let l = 0; l < 2; l++ {
					let r = refIdx[l * 4 + i]
					if r < 0 {
						motion.fill(l, bx, by, 2, 2, -1, 0, 0)
						continue
					}
					let shape = st & 3
					let parts = h264SubParts(st)
					for let j = 0; j < parts; j++ {
						let sx = bx
						let sy = by
						let w = 2
						let h = 2
						if shape == 1 {
							sy += j
							h = 1
						} else if shape == 2 {
							sx += j
							w = 1
						} else if shape == 3 {
							sx += j & 1
							sy += j >> 1
							w = 1
							h = 1
						}
						motion.predict(l, sx, sy, w, r, h264ShapeAny)
						motion.fill(l, sx, sy, w, h, r, motion.mx + mvdX[l * 16 + i * 4 + j], motion.my + mvdY[l * 16 + i * 4 + j])
					}
				}
			}
		}

		// Whether the 4x4 blocks of a w x h area at (bx, by) share their
		// motion.
		def uniform(bx int, by int, w int, h int) bool {
			let g0 = (mby * 4 + by) * gw + mbx * 4 + bx
			let r0 = pic.ref0[g0]
			let r1 = pic.ref1[g0]
			let a = pic.mv0[2 * g0]
			let b = pic.mv0[2 * g0 + 1]
			let c = pic.mv1[2 * g0]
			let d = pic.mv1[2 * g0 + 1]
			for let y = 0; y < h; y++ {
				for let x = 0; x < w; x++ {
					let g = g0 + y * gw + x
					return false when pic.ref0[g] != r0 || pic.ref1[g] != r1
					return false when r0 >= 0 && (pic.mv0[2 * g] != a || pic.mv0[2 * g + 1] != b)
					return false when r1 >= 0 && (pic.mv1[2 * g] != c || pic.mv1[2 * g + 1] != d)
				}
			}
			return true
		}

		// Motion-compensated prediction of the whole macroblock.
		def interPredict<T: H264Sample>(k H264Kit<T>) {
			if (mbType & h264MbDirect) != 0 {
				if uniform(0, 0, 4, 4) {
					pic.mbType[mbAddr] = pic.mbType[mbAddr] | h264Mb16x16
					mcBlock(k, 0, 0, 4, 4)
				} else {
					predictArea(k, 0, 0, 4)
				}
				return
			}
			if (mbType & h264Mb16x16) != 0 {
				mcBlock(k, 0, 0, 4, 4)
			} else if (mbType & h264Mb16x8) != 0 {
				mcBlock(k, 0, 0, 4, 2)
				mcBlock(k, 0, 2, 4, 2)
			} else if (mbType & h264Mb8x16) != 0 {
				mcBlock(k, 0, 0, 2, 4)
				mcBlock(k, 2, 0, 2, 4)
			} else {
				for let i = 0; i < 4; i++ {
					let st = subType[i]
					let bx = (i & 1) * 2
					let by = (i >> 1) * 2
					if (st & h264SubDirect) != 0 {
						predictArea(k, bx, by, 2)
						continue
					}
					let shape = st & 3
					if shape == 0 {
						mcBlock(k, bx, by, 2, 2)
					} else if shape == 1 {
						mcBlock(k, bx, by, 2, 1)
						mcBlock(k, bx, by + 1, 2, 1)
					} else if shape == 2 {
						mcBlock(k, bx, by, 1, 2)
						mcBlock(k, bx + 1, by, 1, 2)
					} else {
						mcBlock(k, bx, by, 1, 1)
						mcBlock(k, bx + 1, by, 1, 1)
						mcBlock(k, bx, by + 1, 1, 1)
						mcBlock(k, bx + 1, by + 1, 1, 1)
					}
				}
			}
		}

		// Predicts a square area of direct-predicted blocks, in the largest
		// pieces that share their motion.
		def predictArea<T: H264Sample>(k H264Kit<T>, bx int, by int, size int) {
			if uniform(bx, by, size, size) {
				mcBlock(k, bx, by, size, size)
				return
			}
			if size == 1 {
				mcBlock(k, bx, by, 1, 1)
				return
			}
			let half = size >> 1
			predictArea(k, bx, by, half)
			predictArea(k, bx + half, by, half)
			predictArea(k, bx, by + half, half)
			predictArea(k, bx + half, by + half, half)
		}

		// Predicts one partition of w x h 4x4 blocks at (bx, by) from its
		// motion in the grids.
		def mcBlock<T: H264Sample>(k H264Kit<T>, bx int, by int, w int, h int) {
			let g = (mby * 4 + by) * gw + mbx * 4 + bx
			let r0 = pic.ref0[g]
			let r1 = pic.ref1[g]
			// Field macroblocks predict from fields: half the lines.
			let px = mbx * 16 + bx * 4
			let py = (fieldMb ?? (mby >> 1, mby)) * 16 + by * 4
			let bw = w * 4
			let bh = h * 4
			let stride = ls
			let cs = cls
			let lw = wMbs * 16
			let lh = hMbs * (fieldMb ?? (8, 16))
			let dOff = ly0 + by * 4 * ls + bx * 4
			// Vertical chroma subsampling: 1 in 4:2:0, 0 in 4:2:2, whose
			// vertical vectors are in quarter chroma samples.
			let csy = c422 ?? (0, 1)
			let ch = lh >> csy
			let cOff = cy0 + ((by * 4) >> csy) * cls + bx * 2
			// Explicit weights are per frame: a field macroblock's index
			// names the frame twice.
			let wr0 = fieldMb ?? (r0 >> 1, r0)
			let wr1 = fieldMb ?? (r1 >> 1, r1)
			if r0 >= 0 && r1 >= 0 {
				let pl = k.planes(pic)
				let max = k.max
				let predA = k.predA
				let predB = k.predB
				// High bit depths scale the explicit offsets.
				let os = sps.bitDepthLuma - 8
				let a = list0[r0]
				let b = list1[r1]
				let sa0 = k.planes(a)
				let sb0 = k.planes(b)
				let ax = pic.mv0[2 * g]
				let ay = pic.mv0[2 * g + 1]
				let bxv = pic.mv1[2 * g]
				let byv = pic.mv1[2 * g + 1]
				let planes = mono ?? (1, 3)
				for let plane = 0; plane < planes; plane++ {
					if plane == 0 {
						h264McLuma(sa0.y, a.base, stride, lw, lh, px + (ax >> 2), py + (ay >> 2), ax & 3, ay & 3, bw, bh, predA, 0, 16, k, tmp)
						h264McLuma(sb0.y, b.base, stride, lw, lh, px + (bxv >> 2), py + (byv >> 2), bxv & 3, byv & 3, bw, bh, predB, 0, 16, k, tmp)
					} else if full {
						let sa = plane == 1 ?? (sa0.u, sa0.v)
						let sb = plane == 1 ?? (sb0.u, sb0.v)
						h264McLuma(sa, a.cbase, stride, lw, lh, px + (ax >> 2), py + (ay >> 2), ax & 3, ay & 3, bw, bh, predA, 0, 16, k, tmp)
						h264McLuma(sb, b.cbase, stride, lw, lh, px + (bxv >> 2), py + (byv >> 2), bxv & 3, byv & 3, bw, bh, predB, 0, 16, k, tmp)
					} else {
						let sa = plane == 1 ?? (sa0.u, sa0.v)
						let sb = plane == 1 ?? (sb0.u, sb0.v)
						h264McChroma(sa, a.cbase, cs, lw >> 1, ch, (px >> 1) + (ax >> 3), (py >> csy) + ((ay + parityShift(a)) >> (2 + csy)), ax & 7, ((ay + parityShift(a)) << (1 - csy)) & 7, bw >> 1, bh >> csy, predA, 0, 16, k)
						h264McChroma(sb, b.cbase, cs, lw >> 1, ch, (px >> 1) + (bxv >> 3), (py >> csy) + ((byv + parityShift(b)) >> (2 + csy)), bxv & 7, ((byv + parityShift(b)) << (1 - csy)) & 7, bw >> 1, bh >> csy, predB, 0, 16, k)
					}
					let dst = plane == 0 ?? (pl.y, plane == 1 ?? (pl.u, pl.v))
					let lumaSized = plane == 0 || full
					let off = lumaSized ?? (dOff, cOff)
					let st = lumaSized ?? (stride, cs)
					let ww = lumaSized ?? (bw, bw >> 1)
					let hh = lumaSized ?? (bh, bh >> csy)
					if weighted == 1 {
						let k = plane * 2
						let wa = (wr0 * 6) + k
						let wb = (32 + wr1) * 6 + k
						let log = plane == 0 ?? (hdr.lumaLog2Denom, hdr.chromaLog2Denom)
						h264WeightBi(dst, off, st, predA, predB, ww, hh, log, hdr.weights[wa], hdr.weights[wb], hdr.weights[wa + 1] << os, hdr.weights[wb + 1] << os, max)
					} else if weighted == 2 && implicitOf(r0, r1) != 32 {
						let w0 = implicitOf(r0, r1)
						h264WeightBi(dst, off, st, predA, predB, ww, hh, 5, w0, 64 - w0, 0, 0, max)
					} else {
						h264Average(dst, off, st, predA, predB, ww, hh)
					}
				}
				return
			}
			if r0 >= 0 {
				mcSingle(k, list0[r0], 0, r0, pic.mv0[2 * g], pic.mv0[2 * g + 1], px, py, bw, bh, lw, lh, ch, csy, dOff, cOff)
			} else if r1 >= 0 {
				mcSingle(k, list1[r1], 1, r1, pic.mv1[2 * g], pic.mv1[2 * g + 1], px, py, bw, bh, lw, lh, ch, csy, dOff, cOff)
			}
		}

		// Predicts a partition from one reference, `ref` at index `r` of
		// `list`, with vector (vx, vy); the partition's position, size and
		// plane geometry as `mcBlock` works them out. Arrays go to the kernels
		// straight from their objects rather than through picks between
		// planes, each of which would retain and release them.
		def mcSingle<T: H264Sample>(k H264Kit<T>, ref H264Picture, list int, r int, vx int, vy int, px int, py int, bw int, bh int, lw int, lh int, ch int, csy int, dOff int, cOff int) {
			let sr = k.planes(ref)
			let pl = k.planes(pic)
			let max = k.max
			let stride = ls
			let cs = cls
			let lx = px + (vx >> 2)
			let ly = py + (vy >> 2)
			let cx = (px >> 1) + (vx >> 3)
			let cvy = vy + parityShift(ref)
			let cy = (py >> csy) + (cvy >> (2 + csy))
			let fy = (cvy << (1 - csy)) & 7
			if weighted != 1 {
				h264McLuma(sr.y, ref.base, stride, lw, lh, lx, ly, vx & 3, vy & 3, bw, bh, pl.y, dOff, stride, k, tmp)
				return when mono
				if full {
					h264McLuma(sr.u, ref.cbase, stride, lw, lh, lx, ly, vx & 3, vy & 3, bw, bh, pl.u, dOff, stride, k, tmp)
					h264McLuma(sr.v, ref.cbase, stride, lw, lh, lx, ly, vx & 3, vy & 3, bw, bh, pl.v, dOff, stride, k, tmp)
					return
				}
				h264McChroma(sr.u, ref.cbase, cs, lw >> 1, ch, cx, cy, vx & 7, fy, bw >> 1, bh >> csy, pl.u, cOff, cs, k)
				h264McChroma(sr.v, ref.cbase, cs, lw >> 1, ch, cx, cy, vx & 7, fy, bw >> 1, bh >> csy, pl.v, cOff, cs, k)
				return
			}
			// High bit depths scale the explicit offsets.
			let os = sps.bitDepthLuma - 8
			let wi = (list * 32 + (fieldMb ?? (r >> 1, r))) * 6
			h264McLuma(sr.y, ref.base, stride, lw, lh, lx, ly, vx & 3, vy & 3, bw, bh, k.predA, 0, 16, k, tmp)
			h264WeightOne(pl.y, dOff, stride, k.predA, bw, bh, hdr.lumaLog2Denom, hdr.weights[wi], hdr.weights[wi + 1] << os, max)
			return when mono
			if full {
				h264McLuma(sr.u, ref.cbase, stride, lw, lh, lx, ly, vx & 3, vy & 3, bw, bh, k.predA, 0, 16, k, tmp)
				h264WeightOne(pl.u, dOff, stride, k.predA, bw, bh, hdr.chromaLog2Denom, hdr.weights[wi + 2], hdr.weights[wi + 3] << os, max)
				h264McLuma(sr.v, ref.cbase, stride, lw, lh, lx, ly, vx & 3, vy & 3, bw, bh, k.predA, 0, 16, k, tmp)
				h264WeightOne(pl.v, dOff, stride, k.predA, bw, bh, hdr.chromaLog2Denom, hdr.weights[wi + 4], hdr.weights[wi + 5] << os, max)
				return
			}
			h264McChroma(sr.u, ref.cbase, cs, lw >> 1, ch, cx, cy, vx & 7, fy, bw >> 1, bh >> csy, k.predA, 0, 16, k)
			h264WeightOne(pl.u, cOff, cs, k.predA, bw >> 1, bh >> csy, hdr.chromaLog2Denom, hdr.weights[wi + 2], hdr.weights[wi + 3] << os, max)
			h264McChroma(sr.v, ref.cbase, cs, lw >> 1, ch, cx, cy, vx & 7, fy, bw >> 1, bh >> csy, k.predA, 0, 16, k)
			h264WeightOne(pl.v, cOff, cs, k.predA, bw >> 1, bh >> csy, hdr.chromaLog2Denom, hdr.weights[wi + 4], hdr.weights[wi + 5] << os, max)
		}
	}

	// Chroma DC scan: raster order of the 2x2 DC coefficients.
	const h264ChromaDcScan = int[0, 1, 2, 3]

	// Number of sub-macroblock partitions of a sub-macroblock type word.
	def h264SubParts(st int) int {
		let shape = st & 3
		return shape == 0 ?? (1, shape == 3 ?? (4, 2))
	}

	// Whether partition `part` of an inter macroblock type uses `list`.
	def h264PartUses(t int, part int, list int) bool {
		let flag = list == 0 ?? (part == 0 ?? (h264MbP0L0, h264MbP1L0), part == 0 ?? (h264MbP0L1, h264MbP1L1))
		return (t & flag) != 0
	}

	// The Intra 16x16 mode to use: DC stands in when the stream names a mode
	// whose neighbours are missing.
	def h264Fix16Mode(mode int, top bool, left bool, topLeft bool) int {
		return 2 when mode == 0 && !top
		return 2 when mode == 1 && !left
		return 2 when mode == 3 && !(top && left && topLeft)
		return mode
	}

	// The chroma intra mode to use, with the same stand-in as h264Fix16Mode.
	def h264FixChromaMode(mode int, top bool, left bool, topLeft bool) int {
		return 0 when mode == 1 && !left
		return 0 when mode == 2 && !top
		return 0 when mode == 3 && !(top && left && topLeft)
		return mode
	}
}
