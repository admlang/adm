internal partial module std.formats.video.h264 {
	// Partition shapes with their own motion vector prediction rules.
	const h264ShapeAny = 0
	const h264Shape16x8Top = 1
	const h264Shape16x8Bottom = 2
	const h264Shape8x16Left = 3
	const h264Shape8x16Right = 4

	// H264Motion predicts motion vectors and derives the direct modes of B
	// slices, reading and writing the motion grids of the current picture.
	type H264Motion {
		pic        H264Picture
		col        H264Picture
		loc        H264Locator
		list0      H264Picture[]
		list1      H264Picture[]
		count0     int
		count1     int
		wMbs       int
		gw         int
		sliceNum   int
		mbx        int
		mby        int
		mbAddr     int
		direct8x8  bool
		// Result of the last prediction.
		mx         int
		my         int
		// Neighbour read by `neighbour`.
		nRef       int
		nMx        int
		nMy        int
		// Spatial direct: the references and predicted vectors of the
		// macroblock.
		dirRef0    int
		dirRef1    int
		dirMx0     int
		dirMy0     int
		dirMx1     int
		dirMy1     int
		// Temporal direct: POC distances and scale per list 0 index.
		colToList0 int[]
		mapBuilt   bool
		// Colocated block read by `colocated`.
		colRef     int
		colMx      int
		colMy      int
		colUid     int
		curPoc     int
		// How the colocated block last read relates to the current one: 0
		// the same kind; 1 a frame block read by a field (vertical vector
		// halved); 2 a field block read by a frame (vector doubled).
		colMode    int
		// The frame list 1 index 0 belongs to, and the field of it nearer
		// the current picture in order (1 top, 2 bottom), which frame
		// macroblocks read when it holds fields.
		colFrame   H264Picture
		colParity  int
		// Whether list 1 index 0 is a long-term reference.
		colLong    bool

		def new() {
			pic = new H264Picture()
			col = pic
			colFrame = pic
			loc = new H264Locator()
			list0 = H264Picture[]
			list1 = H264Picture[]
			colToList0 = h264Zeros(32)
		}

		// Prepares for a slice of `p` with the given reference lists.
		def slice(p H264Picture, l0 H264Picture[], c0 int, l1 H264Picture[], c1 int, num int, inference bool, locator H264Locator) {
			pic = p
			loc = locator
			list0 = l0
			list1 = l1
			count0 = c0
			count1 = c1
			wMbs = p.widthMbs
			gw = wMbs * 4
			sliceNum = num
			direct8x8 = inference
			curPoc = p.poc
			colMode = 0
			return when c1 == 0
			let r = l1[0]
			col = r
			colLong = r.ref == h264RefLong
			colFrame = r
			if r.parity != 0 {
				let owner = r.owner
				colFrame = owner when !(owner is none)
			}
			let f = colFrame
			colParity = h264Abs(f.topPoc - curPoc) < h264Abs(f.bottomPoc - curPoc) ?? (1, 2)
		}

		def at(x int, y int) {
			mbx = x
			mby = y
			mbAddr = y * wMbs + x
		}

		// The reference lists of the current macroblock: the field lists for
		// a field macroblock of an MBAFF frame.
		def lists(l0 H264Picture[], c0 int, l1 H264Picture[], c1 int) {
			list0 = l0
			list1 = l1
			count0 = c0
			count1 = c1
		}

		// Reads the 4x4 block holding luma location (xN, yN), relative to the
		// macroblock, of list `list` into nRef, nMx and nMy, and returns
		// whether it is available. In MBAFF frames a neighbour of the other
		// kind is read in the current macroblock's units: field indices
		// name each frame twice, field vectors count field lines.
		def neighbour(list int, xN int, yN int) bool {
			let i = loc.luma(xN, yN)
			if i < 0 {
				nRef = -1
				nMx = 0
				nMy = 0
				return false
			}
			if list == 0 {
				nRef = pic.ref0[i]
				nMx = pic.mv0[2 * i]
				nMy = pic.mv0[2 * i + 1]
			} else {
				nRef = pic.ref1[i]
				nMx = pic.mv1[2 * i]
				nMy = pic.mv1[2 * i + 1]
			}
			if loc.mbaff && nRef >= 0 && loc.found != mbAddr {
				let nf = loc.isField(loc.found)
				if loc.field && !nf {
					nRef = nRef * 2
					nMy = nMy / 2
				} else if !loc.field && nf {
					nRef = nRef >> 1
					nMy = nMy * 2
				}
			}
			return true
		}

		// Predicts the motion vector of the partition at 4x4 position (bx, by)
		// in the macroblock, `w` by `h` blocks, for reference `ref` of `list`.
		def predict(list int, bx int, by int, w int, ref int, shape int) {
			let xN = bx * 4
			let yN = by * 4
			let availA = neighbour(list, xN - 1, yN)
			let refA = nRef
			let ax = nMx
			let ay = nMy
			let availB = neighbour(list, xN, yN - 1)
			let refB = nRef
			let bxv = nMx
			let byv = nMy
			let availC = false
			if by > 0 && bx + w < 4 {
				availC = neighbour(list, xN + w * 4, yN - 1) when h264ZOrder[(by - 1) * 4 + bx + w] < h264ZOrder[by * 4 + bx]
			} else {
				availC = neighbour(list, xN + w * 4, yN - 1)
			}
			availC = neighbour(list, xN - 1, yN - 1) unless availC
			let refC = nRef
			let cx = nMx
			let cy = nMy
			if shape == h264Shape16x8Top {
				if refB == ref {
					mx = bxv
					my = byv
					return
				}
			} else if shape == h264Shape16x8Bottom {
				if refA == ref {
					mx = ax
					my = ay
					return
				}
			} else if shape == h264Shape8x16Left {
				if refA == ref {
					mx = ax
					my = ay
					return
				}
			} else if shape == h264Shape8x16Right {
				if refC == ref {
					mx = cx
					my = cy
					return
				}
			}
			if !availB && !availC && availA {
				mx = ax
				my = ay
				return
			}
			let matches = 0
			matches++ when refA == ref
			matches++ when refB == ref
			matches++ when refC == ref
			if matches == 1 {
				if refA == ref {
					mx = ax
					my = ay
				} else if refB == ref {
					mx = bxv
					my = byv
				} else {
					mx = cx
					my = cy
				}
				return
			}
			mx = h264Median(ax, bxv, cx)
			my = h264Median(ay, byv, cy)
		}

		// The motion vector of a P_Skip macroblock.
		def pSkip() {
			let availA = neighbour(0, -1, 0)
			let zeroA = nRef == 0 && nMx == 0 && nMy == 0
			let availB = neighbour(0, 0, -1)
			let zeroB = nRef == 0 && nMx == 0 && nMy == 0
			if !availA || !availB || zeroA || zeroB {
				mx = 0
				my = 0
				return
			}
			predict(0, 0, 0, 4, 0, h264ShapeAny)
		}

		// Fills the reference index and motion vector of `list` over a
		// rectangle of 4x4 blocks of the macroblock.
		def fill(list int, bx int, by int, w int, h int, ref int, vx int, vy int) {
			let base = (mby * 4 + by) * gw + mbx * 4 + bx
			if list == 0 {
				let uid = ref >= 0 && ref < count0 ?? (list0[ref].uid, -1)
				for let y = 0; y < h; y++ {
					let i = base + y * gw
					for let x = 0; x < w; x++ {
						pic.ref0[i + x] = ref
						pic.uid0[i + x] = uid
						pic.mv0[2 * (i + x)] = vx
						pic.mv0[2 * (i + x) + 1] = vy
					}
				}
			} else {
				let uid = ref >= 0 && ref < count1 ?? (list1[ref].uid, -1)
				for let y = 0; y < h; y++ {
					let i = base + y * gw
					for let x = 0; x < w; x++ {
						pic.ref1[i + x] = ref
						pic.uid1[i + x] = uid
						pic.mv1[2 * (i + x)] = vx
						pic.mv1[2 * (i + x) + 1] = vy
					}
				}
			}
		}

		// Clears the motion of both lists over the macroblock, for intra
		// macroblocks.
		def clearMb() {
			fill(0, 0, 0, 4, 4, -1, 0, 0)
			fill(1, 0, 0, 4, 4, -1, 0, 0)
		}

		// Spatial direct, first half: the reference indices and predicted
		// vectors shared by the whole macroblock.
		def spatialPrepare() {
			for let list = 0; list < 2; list++ {
				neighbour(list, -1, 0)
				let refA = nRef
				neighbour(list, 0, -1)
				let refB = nRef
				neighbour(list, -1, -1) unless neighbour(list, 16, -1)
				let refC = nRef
				let r = h264MinPositive(refA, h264MinPositive(refB, refC))
				if list == 0 {
					dirRef0 = r
				} else {
					dirRef1 = r
				}
			}
			if dirRef0 < 0 && dirRef1 < 0 {
				dirRef0 = 0
				dirRef1 = 0
				dirMx0 = 0
				dirMy0 = 0
				dirMx1 = 0
				dirMy1 = 0
				return
			}
			dirMx0 = 0
			dirMy0 = 0
			dirMx1 = 0
			dirMy1 = 0
			if dirRef0 >= 0 {
				predict(0, 0, 0, 4, dirRef0, h264ShapeAny)
				dirMx0 = mx
				dirMy0 = my
			}
			if dirRef1 >= 0 {
				predict(1, 0, 0, 4, dirRef1, h264ShapeAny)
				dirMx1 = mx
				dirMy1 = my
			}
		}

		// Reads the colocated block of 4x4 block (bx, by) of the macroblock
		// into colRef, colMx, colMy and colUid (the uid of the picture it
		// refers to); colRef is -1 for an intra block. Frame and field
		// macroblocks read a colocated macroblock of the other kind at the
		// corner blocks of their quarters (direct_8x8_inference is set in
		// interlaced streams): H.264 table 8-6.
		def colocated(bx int, by int) {
			colRef = -1
			colMx = 0
			colMy = 0
			colUid = -1
			colMode = 0
			let lower = by >= 2 ?? (1, 0)
			let f = colFrame
			let src = col
			// The colocated macroblock's row in `src` and the 4x4 row in it.
			let row = mby
			let y = by
			if pic.parity != 0 {
				// A field picture: the colocated field, or the frame
				// macroblocks at its lines.
				if !f.asFields {
					src = f
					if (f.mbType[2 * mby * wMbs + mbx] & h264MbField) != 0 {
						row = 2 * mby + pic.parity - 1
					} else {
						row = 2 * mby + lower
						y = lower * 2
						colMode = 1
					}
				}
			} else if loc.field {
				let parity = 1 + (mby & 1)
				if f.asFields {
					src = f.field(parity)
					row = mby >> 1
				} else if (f.mbType[mby * wMbs + mbx] & h264MbField) == 0 {
					src = f
					row = (mby & ~1) + lower
					y = lower * 2
					colMode = 1
				}
			} else if f.asFields {
				src = f.field(colParity)
				row = mby >> 1
				y = (mby & 1) * 2 + lower
				colMode = 2
			} else if (f.mbType[mby * wMbs + mbx] & h264MbField) != 0 {
				src = f
				row = (mby & ~1) + colParity - 1
				y = (mby & 1) * 2 + lower
				colMode = 2
			}
			let mb = row * wMbs + mbx
			return when (src.mbType[mb] & h264MbIntra) != 0
			let i = (row * 4 + y) * gw + mbx * 4 + bx
			let r0 = src.ref0[i]
			if r0 >= 0 {
				colRef = r0
				colMx = src.mv0[2 * i]
				colMy = src.mv0[2 * i + 1]
				colUid = src.uid0[i]
			} else {
				let r1 = src.ref1[i]
				if r1 >= 0 {
					colRef = r1
					colMx = src.mv1[2 * i]
					colMy = src.mv1[2 * i + 1]
					colUid = src.uid1[i]
				}
			}
			// A frame's references are read as the fields of the current
			// parity, a field's as the frames holding them.
			if colUid >= 0 && colMode == 1 {
				colUid += loc.field ?? (1 + (mby & 1), pic.parity)
			} else if colUid >= 0 && colMode == 2 {
				colUid = colUid & ~3
			}
		}

		// Spatial direct, second half: the motion of one 8x8 quarter of the
		// macroblock (all four when `quarter` is -1).
		def spatialBlocks(quarter int) {
			let from = quarter < 0 ?? (0, quarter)
			let to = quarter < 0 ?? (4, quarter + 1)
			let longCol = colLong
			if quarter < 0 && direct8x8 {
				// The four quarters of a whole direct macroblock: when their
				// colocated blocks agree, the motion is one 16x16 block.
				let zeros = 0
				for let q = 0; q < 4; q++ {
					colocated((q & 1) * 3, (q >> 1) * 3)
					let zero = !longCol && colRef == 0 && colMx >= -1 && colMx <= 1 && colMy >= -1 && colMy <= 1
					zeros = zeros | (1 << q) when zero
				}
				if zeros := 0 || 15 {
					let zero0 = zeros == 15 && dirRef0 == 0
					let zero1 = zeros == 15 && dirRef1 == 0
					fill(0, 0, 0, 4, 4, dirRef0, zero0 ?? (0, dirMx0), zero0 ?? (0, dirMy0))
					fill(1, 0, 0, 4, 4, dirRef1, zero1 ?? (0, dirMx1), zero1 ?? (0, dirMy1))
					return
				}
			}
			for let q = from; q < to; q++ {
				let qx = (q & 1) * 2
				let qy = (q >> 1) * 2
				if direct8x8 {
					colocated(qx + (q & 1), qy + (q >> 1))
					let zero = !longCol && colRef == 0 && colMx >= -1 && colMx <= 1 && colMy >= -1 && colMy <= 1
					let zero0 = zero && dirRef0 == 0
					let zero1 = zero && dirRef1 == 0
					fill(0, qx, qy, 2, 2, dirRef0, zero0 ?? (0, dirMx0), zero0 ?? (0, dirMy0))
					fill(1, qx, qy, 2, 2, dirRef1, zero1 ?? (0, dirMx1), zero1 ?? (0, dirMy1))
				} else {
					for let k = 0; k < 4; k++ {
						let bx = qx + (k & 1)
						let by = qy + (k >> 1)
						colocated(bx, by)
						let zero = !longCol && colRef == 0 && colMx >= -1 && colMx <= 1 && colMy >= -1 && colMy <= 1
						let zero0 = zero && dirRef0 == 0
						let zero1 = zero && dirRef1 == 0
						fill(0, bx, by, 1, 1, dirRef0, zero0 ?? (0, dirMx0), zero0 ?? (0, dirMy0))
						fill(1, bx, by, 1, 1, dirRef1, zero1 ?? (0, dirMx1), zero1 ?? (0, dirMy1))
					}
				}
			}
		}

		// The lowest list 0 index naming the picture with `uid`, 0 when none
		// does.
		def mapToList0(uid int) int {
			for let i = 0; i < count0; i++ {
				return i when list0[i].uid == uid
			}
			return 0
		}

		// Temporal direct: the motion of one 8x8 quarter of the macroblock
		// (all four when `quarter` is -1).
		def temporalBlocks(quarter int) {
			let from = quarter < 0 ?? (0, quarter)
			let to = quarter < 0 ?? (4, quarter + 1)
			for let q = from; q < to; q++ {
				let qx = (q & 1) * 2
				let qy = (q >> 1) * 2
				if direct8x8 {
					colocated(qx + (q & 1), qy + (q >> 1))
					temporalOne(qx, qy, 2)
				} else {
					for let k = 0; k < 4; k++ {
						let bx = qx + (k & 1)
						let by = qy + (k >> 1)
						colocated(bx, by)
						temporalOne(bx, by, 1)
					}
				}
			}
		}

		// Temporal direct motion of a square of `size` 4x4 blocks from the
		// colocated block last read.
		def temporalOne(bx int, by int, size int) {
			let ref0 = colRef < 0 ?? (0, mapToList0(colUid))
			let vx = colMx
			let vy = colMy
			// Field vectors count field lines, frame vectors frame lines.
			if colMode == 1 {
				vy = vy / 2
			} else if colMode == 2 {
				vy = vy * 2
			}
			let pic0 = list0[ref0]
			let mv0x = vx
			let mv0y = vy
			let mv1x = 0
			let mv1y = 0
			// A field macroblock of an MBAFF frame measures from its own
			// field, and its list 1 index 0 is the field of that parity.
			let cur = curPoc
			if loc.field {
				cur = (mby & 1) == 0 ?? (pic.topPoc, pic.bottomPoc)
			}
			let tdRaw = list1[0].poc - pic0.poc
			if pic0.ref != h264RefLong && tdRaw != 0 {
				let tb = h264Clip3(-128, 127, cur - pic0.poc)
				let td = h264Clip3(-128, 127, tdRaw)
				let tx = (16384 + h264Abs(td / 2)) / td
				let dsf = h264Clip3(-1024, 1023, (tb * tx + 32) >> 6)
				mv0x = (dsf * vx + 128) >> 8
				mv0y = (dsf * vy + 128) >> 8
				mv1x = mv0x - vx
				mv1y = mv0y - vy
			}
			fill(0, bx, by, size, size, ref0, mv0x, mv0y)
			fill(1, bx, by, size, size, 0, mv1x, mv1y)
		}
	}

	// The median of three values.
	def h264Median(a int, b int, c int) int {
		let lo = a < b ?? (a, b)
		let hi = a < b ?? (b, a)
		return lo when c < lo
		return hi when c > hi
		return c
	}

	// The smaller of two reference indices when both are valid, else the
	// larger.
	def h264MinPositive(a int, b int) int {
		return (a < b ?? (a, b)) when a >= 0 && b >= 0
		return a > b ?? (a, b)
	}

	def h264Clip3(lo int, hi int, v int) int {
		return lo when v < lo
		return hi when v > hi
		return v
	}

	def h264Abs(v int) int {
		return v < 0 ?? (0 - v, v)
	}
}
