internal partial module std.formats.video.h264 {
	// H264Sps is a sequence parameter set.
	type H264Sps {
		id                      int
		profile                 int
		level                   int
		constraintFlags         int
		chromaFormat            int   = 1
		bitDepthLuma            int   = 8
		bitDepthChroma          int   = 8
		// separate_colour_plane_flag: 4:4:4 coded as three monochrome
		// pictures.
		separatePlanes          bool
		transformBypass         bool
		// Scaling matrices in raster order: six 4x4 lists (intra Y, Cb, Cr,
		// inter Y, Cb, Cr) and six 8x8 lists (intra Y, inter Y, intra Cb,
		// inter Cb, intra Cr, inter Cr; the chroma ones for 4:4:4 only).
		scaling4                int[]
		scaling8                int[]
		scalingPresent          bool
		log2MaxFrameNum         int
		pocType                 int
		log2MaxPocLsb           int
		deltaPicOrderAlwaysZero bool
		offsetForNonRefPic      int
		offsetForTopToBottom    int
		offsetForRefFrame       int[]
		maxNumRefFrames         int
		gapsAllowed             bool
		widthMbs                int
		heightMbs               int
		frameMbsOnly            bool
		mbAdaptive              bool
		direct8x8Inference      bool
		cropLeft                int
		cropRight               int
		cropTop                 int
		cropBottom              int
		// VUI fields that the decoder uses; zero when absent.
		matrixCoefficients      int   = 2
		fullRange               bool
		numUnitsInTick          int
		timeScale               int
		sarWidth                int
		sarHeight               int
		maxNumReorderFrames     int   = -1
		maxDecFrameBuffering    int   = -1

		def new() {
			scaling4 = h264Filled(96, 16)
			scaling8 = h264Filled(384, 16)
			offsetForRefFrame = int[]
		}
	}

	// H264Pps is a picture parameter set.
	type H264Pps {
		id                     int
		spsId                  int
		cabac                  bool
		bottomFieldPicOrder    bool
		numSliceGroups         int
		numRefIdxL0Default     int
		numRefIdxL1Default     int
		weightedPred           bool
		weightedBipredIdc      int
		picInitQp              int
		chromaQpOffset         int
		secondChromaQpOffset   int
		deblockingControl      bool
		constrainedIntraPred   bool
		redundantPicCntPresent bool
		transform8x8           bool
		// Scaling lists sent in the PPS, with a flag per list; resolved
		// against the SPS by `dequant`.
		scalingPresent         bool
		listPresent            bool[]
		lists4                 int[]
		lists8                 int[]
		// Dequantisation factors for the active SPS: [list][qP][position]
		// for 4x4 (six lists, 16 positions) and 8x8 (six lists, 64).
		dequant4               int[]
		dequant8               int[]
		dequantSps             int    = -1
		dequantSpsSerial       int    = -1
		// The scaling lists in effect for that SPS, raster order: six 4x4
		// and six 8x8, as `H264Sps.scaling4`/`scaling8` lay them out.
		active4                int[]
		active8                int[]

		def new() {
			listPresent = bool[]
			listPresent.len(12)
			listPresent.fill(false)
			lists4 = h264Filled(96, 16)
			lists8 = h264Filled(384, 16)
			dequant4 = int[]
			dequant8 = int[]
			active4 = int[]
			active8 = int[]
		}

		// Builds the dequantisation factors for `sps` unless they are
		// already built for it.
		def prepare(sps H264Sps, serial int) {
			return when dequantSps == sps.id && dequantSpsSerial == serial
			dequantSps = sps.id
			dequantSpsSerial = serial
			let m4 = sps.scaling4.clone()
			let m8 = sps.scaling8.clone()
			if scalingPresent {
				let fallback = sps.scalingPresent
				for let i = 0; i < 6; i++ {
					if listPresent[i] {
						lists4[i * 16:(i + 1) * 16].copy(m4[i * 16:])
					} else if i == 0 || i == 3 {
						if fallback {
							sps.scaling4[i * 16:(i + 1) * 16].copy(m4[i * 16:])
						} else {
							h264DefaultScale4[(i / 3) * 16:(i / 3 + 1) * 16].copy(m4[i * 16:])
						}
					} else {
						m4[(i - 1) * 16:i * 16].copy(m4[i * 16:])
					}
				}
				for let i = 0; i < 6; i++ {
					if listPresent[6 + i] {
						lists8[i * 64:(i + 1) * 64].copy(m8[i * 64:])
					} else if i >= 2 {
						m8[(i - 2) * 64:(i - 1) * 64].copy(m8[i * 64:])
					} else if fallback {
						sps.scaling8[i * 64:(i + 1) * 64].copy(m8[i * 64:])
					} else {
						h264DefaultScale8[i * 64:(i + 1) * 64].copy(m8[i * 64:])
					}
				}
			}
			active4 = m4
			active8 = m8
			dequant4 = int[]
			dequant4.len(6 * h264QpSpan * 16)
			for let l = 0; l < 6; l++ {
				for let q = 0; q < h264QpSpan; q++ {
					let rem = q % 6
					let shift = q / 6
					for let p = 0; p < 16; p++ {
						let x = p & 3
						let y = p >> 2
						let cls = (x & 1) + (y & 1)
						dequant4[(l * h264QpSpan + q) * 16 + p] = (h264NormAdjust4[rem * 3 + cls] * m4[l * 16 + p]) << shift
					}
				}
			}
			dequant8 = int[]
			dequant8.len(6 * h264QpSpan * 64)
			for let l = 0; l < 6; l++ {
				for let q = 0; q < h264QpSpan; q++ {
					let rem = q % 6
					let shift = q / 6
					for let p = 0; p < 64; p++ {
						let x = p & 7
						let y = p >> 3
						let cls = 5
						if (x & 3) == 0 && (y & 3) == 0 {
							cls = 0
						} else if (x & 1) == 1 && (y & 1) == 1 {
							cls = 1
						} else if (x & 3) == 2 && (y & 3) == 2 {
							cls = 2
						} else if ((x & 3) == 0 && (y & 1) == 1) || ((x & 1) == 1 && (y & 3) == 0) {
							cls = 3
						} else if ((x & 3) == 0 && (y & 3) == 2) || ((x & 3) == 2 && (y & 3) == 0) {
							cls = 4
						}
						dequant8[(l * h264QpSpan + q) * 64 + p] = (h264NormAdjust8[rem * 6 + cls] * m8[l * 64 + p]) << shift
					}
				}
			}
		}
	}

	def h264Filled(n int, value int) int[] {
		let a int[]
		a.len(n)
		a.fill(value)
		return a
	}

	// A new array of `n` zeros.
	def h264Zeros(n int) int[] {
		let a int[]
		a.len(n)
		return a
	}

	// A new array of `n` zero bytes.
	def h264Bytes(n int) byte[] {
		let a byte[]
		a.len(n)
		return a
	}

	// Reads one scaling list into `dst[at:]` in raster order, falling back to
	// `defaults[defAt:]` when the stream asks for the default list.
	def h264ReadScalingList(r H264Bits, dst int[], at int, size int, defaults int[], defAt int) {
		let last = 8
		let next = 8
		for let j = 0; j < size; j++ {
			let pos = size == 16 ?? (h264Zigzag4x4[j], h264Zigzag8x8[j])
			if next != 0 {
				let delta = r.se()
				next = (last + delta + 256) % 256
				if j == 0 && next == 0 {
					defaults[defAt:defAt + size].copy(dst[at:])
					return
				}
			}
			let v = next == 0 ?? (last, next)
			dst[at + pos] = v
			last = v
		}
	}

	// Parses a sequence parameter set. Fails on a malformed set or one this
	// decoder does not support.
	def h264ParseSps(r H264Bits) !H264Sps {
		let s = new H264Sps()
		s.profile = r.u(8)
		s.constraintFlags = r.u(8)
		s.level = r.u(8)
		s.id = r.ue()
		fail "h264: bad sequence parameter set id" when s.id > 31
		let p = s.profile
		if p := 100 || 110 || 122 || 244 || 44 || 83 || 86 || 118 || 128 || 138 || 139 || 134 || 135 {
			s.chromaFormat = r.ue()
			s.separatePlanes = r.flag() when s.chromaFormat == 3
			s.bitDepthLuma = r.ue() + 8
			s.bitDepthChroma = r.ue() + 8
			s.transformBypass = r.flag()
			s.scalingPresent = r.flag()
			if s.scalingPresent {
				let count = s.chromaFormat == 3 ?? (12, 8)
				for let i = 0; i < count; i++ {
					let present = r.flag()
					if i < 6 {
						if present {
							h264ReadScalingList(r, s.scaling4, i * 16, 16, h264DefaultScale4, (i / 3) * 16)
						} else if i == 0 || i == 3 {
							h264DefaultScale4[(i / 3) * 16:(i / 3 + 1) * 16].copy(s.scaling4[i * 16:])
						} else {
							s.scaling4[(i - 1) * 16:i * 16].copy(s.scaling4[i * 16:])
						}
					} else {
						let k = i - 6
						if present {
							h264ReadScalingList(r, s.scaling8, k * 64, 64, h264DefaultScale8, (k & 1) * 64)
						} else if k < 2 {
							h264DefaultScale8[k * 64:(k + 1) * 64].copy(s.scaling8[k * 64:])
						} else {
							s.scaling8[(k - 2) * 64:(k - 1) * 64].copy(s.scaling8[k * 64:])
						}
					}
				}
			}
		}
		s.log2MaxFrameNum = r.ue() + 4
		fail "h264: bad log2_max_frame_num" when s.log2MaxFrameNum > 16
		s.pocType = r.ue()
		if s.pocType == 0 {
			s.log2MaxPocLsb = r.ue() + 4
			fail "h264: bad log2_max_pic_order_cnt_lsb" when s.log2MaxPocLsb > 16
		} else if s.pocType == 1 {
			s.deltaPicOrderAlwaysZero = r.flag()
			s.offsetForNonRefPic = r.se()
			s.offsetForTopToBottom = r.se()
			let n = r.ue()
			fail "h264: bad num_ref_frames_in_pic_order_cnt_cycle" when n > 255
			for let i = 0; i < n; i++ {
				s.offsetForRefFrame.push(r.se())
			}
		} else if s.pocType != 2 {
			fail "h264: bad pic_order_cnt_type"
		}
		s.maxNumRefFrames = r.ue()
		fail "h264: bad max_num_ref_frames" when s.maxNumRefFrames > 16
		s.gapsAllowed = r.flag()
		s.widthMbs = r.ue() + 1
		let mapUnits = r.ue() + 1
		s.frameMbsOnly = r.flag()
		s.heightMbs = s.frameMbsOnly ?? (mapUnits, mapUnits * 2)
		s.mbAdaptive = r.flag() unless s.frameMbsOnly
		s.direct8x8Inference = r.flag()
		if r.flag() {
			s.cropLeft = r.ue()
			s.cropRight = r.ue()
			s.cropTop = r.ue()
			s.cropBottom = r.ue()
		}
		h264ParseVui(r, s) when r.flag()
		fail "h264: picture too large" when s.widthMbs > 1024 || s.heightMbs > 1024 || s.widthMbs * s.heightMbs > 139264
		return s
	}

	def h264SkipHrd(r H264Bits) {
		let count = r.ue() + 1
		r.skip(8)
		for let i = 0; i < count && i < 32; i++ {
			r.ue()
			r.ue()
			r.skip(1)
		}
		r.skip(20)
	}

	// Reads the parts of the VUI the decoder uses: sample aspect ratio,
	// colour matrix, timing and the reordering limits.
	def h264ParseVui(r H264Bits, s H264Sps) {
		if r.flag() {
			let idc = r.u(8)
			if idc == 255 {
				s.sarWidth = r.u(16)
				s.sarHeight = r.u(16)
			} else if idc > 0 && idc < 17 {
				let sw = int[1, 12, 10, 16, 40, 24, 20, 32, 80, 18, 15, 64, 160, 4, 3, 2]
				let sh = int[1, 11, 11, 11, 33, 11, 11, 11, 33, 11, 11, 33, 99, 3, 2, 1]
				s.sarWidth = sw[idc - 1]
				s.sarHeight = sh[idc - 1]
			}
		}
		r.skip(1) when r.flag()
		if r.flag() {
			r.skip(3)
			s.fullRange = r.flag()
			if r.flag() {
				r.skip(16)
				s.matrixCoefficients = r.u(8)
			}
		}
		if r.flag() {
			r.ue()
			r.ue()
		}
		if r.flag() {
			s.numUnitsInTick = r.u(32)
			s.timeScale = r.u(32)
			r.skip(1)
		}
		let nalHrd = r.flag()
		h264SkipHrd(r) when nalHrd
		let vclHrd = r.flag()
		h264SkipHrd(r) when vclHrd
		r.skip(1) when nalHrd || vclHrd
		r.skip(1)
		if r.flag() {
			r.skip(1)
			r.ue()
			r.ue()
			r.ue()
			r.ue()
			s.maxNumReorderFrames = r.ue()
			s.maxDecFrameBuffering = r.ue()
			if r.left() < 0 {
				s.maxNumReorderFrames = -1
				s.maxDecFrameBuffering = -1
			}
		}
	}

	// Parses a picture parameter set against the sequence parameter sets
	// seen so far. Fails on a malformed set or one this decoder does not
	// support.
	def h264ParsePps(r H264Bits, spsById map<int, H264Sps>) !H264Pps {
		let p = new H264Pps()
		p.id = r.ue()
		fail "h264: bad picture parameter set id" when p.id > 255
		p.spsId = r.ue()
		let sps = spsById.get(p.spsId)
		fail "h264: picture parameter set refers to a missing sequence parameter set" when sps is none
		p.cabac = r.flag()
		p.bottomFieldPicOrder = r.flag()
		p.numSliceGroups = r.ue() + 1
		fail "h264: slice groups (FMO) are not supported" when p.numSliceGroups > 1
		p.numRefIdxL0Default = r.ue() + 1
		p.numRefIdxL1Default = r.ue() + 1
		fail "h264: bad num_ref_idx_default_active" when p.numRefIdxL0Default > 32 || p.numRefIdxL1Default > 32
		p.weightedPred = r.flag()
		p.weightedBipredIdc = r.u(2)
		p.picInitQp = r.se() + 26
		r.se()
		p.chromaQpOffset = r.se()
		p.secondChromaQpOffset = p.chromaQpOffset
		p.deblockingControl = r.flag()
		p.constrainedIntraPred = r.flag()
		p.redundantPicCntPresent = r.flag()
		if r.moreData() {
			p.transform8x8 = r.flag()
			p.scalingPresent = r.flag()
			if p.scalingPresent {
				let count = 6 + (sps.chromaFormat == 3 ?? (6, 2)) * (p.transform8x8 ?? (1, 0))
				for let i = 0; i < count; i++ {
					let present = r.flag()
					p.listPresent[i] = present
					continue unless present
					if i < 6 {
						h264ReadScalingList(r, p.lists4, i * 16, 16, h264DefaultScale4, (i / 3) * 16)
					} else {
						h264ReadScalingList(r, p.lists8, (i - 6) * 64, 64, h264DefaultScale8, ((i - 6) & 1) * 64)
					}
				}
			}
			p.secondChromaQpOffset = r.se()
		}
		return p
	}
}
