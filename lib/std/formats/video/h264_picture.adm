internal partial module std.formats.video.h264 {
	const h264RefUnused = 0
	const h264RefShort = 1
	const h264RefLong = 2

	// H264Picture is one decoded frame with what later pictures need from
	// it: its planes, its place in the reference and output order, and the
	// motion data that direct prediction reads back. A field of it is an
	// H264Picture too (`field`): the frame's planes every other line from
	// `base`, with motion data of its own.
	type H264Picture {
		// Samples in bytes at 8 bits, in 16 bits deeper (`depth`); the
		// other storage is empty.
		samples8     H264Planes<byte>
		samples16    H264Planes<uint16>
		depth        int
		widthMbs     int
		heightMbs    int
		stride       int
		chromaStride int
		// Where the picture's first luma and chroma samples lie in the
		// planes: 0 for frames and top fields, one frame line for bottom
		// fields.
		base         int
		cbase        int
		// 0 for a frame, 1 for a top field, 2 for a bottom field.
		parity       int
		// Frames: which fields are marked for reference (1 top, 2 bottom),
		// which were decoded, and whether they were coded as field pictures.
		refFields    int
		fields       int
		asFields     bool
		// Held for its second field: kept in the buffer though neither a
		// reference nor waiting to be shown yet.
		pairing      bool
		topView      ?H264Picture       = none
		bottomView   ?H264Picture       = none
		// Fields: the frame they belong to.
		weak owner   ?H264Picture
		// The GPU picture buffer a frame decodes into, -1 when it decodes
		// in software.
		surface      int = -1
		// chroma_format_idc the planes are sized for.
		chromaFormat int
		uid          int
		poc          int
		topPoc       int
		bottomPoc    int
		frameNum     int
		frameNumWrap int
		longTermIdx  int
		ref          int
		needOutput   bool
		idr          bool
		nonExisting  bool
		// Inserted for a frame_num gap the stream does not allow: a stand-in
		// for lost pictures, dropped once it falls far behind.
		invalidGap   bool
		mmco5        bool
		pts          duration
		hasPts       bool
		length       duration
		// Per macroblock: type flags and the slice it belongs to (-1 until
		// decoded).
		mbType       int[]
		sliceOfMb    int[]
		// Per 4x4 block, in raster order over the picture: motion vectors
		// (x, y pairs), reference indices of both lists and the uid of the
		// picture each index names (-1 when the list is unused).
		mv0          int[]
		mv1          int[]
		ref0         int[]
		ref1         int[]
		uid0         int[]
		uid1         int[]
		numSlices    int
		// Why the picture may be shown: 1 after an IDR picture, 2 at a
		// recovery point, 4 as a likely random access point; 0 while the
		// references it was predicted from may be missing.
		recovered    int
		// Whether its first slice is intra.
		intra        bool

		def new() {
			samples8 = new H264Planes<byte>(0, 0)
			samples16 = new H264Planes<uint16>(0, 0)
			depth = 8
			mbType = int[]
			sliceOfMb = int[]
			mv0 = int[]
			mv1 = int[]
			ref0 = int[]
			ref1 = int[]
			uid0 = int[]
			uid1 = int[]
		}

		// Sizes the planes and tables for a picture of the given macroblock
		// dimensions, chroma format and bit depth, keeping the buffers when
		// they already fit.
		def allocate(wMbs int, hMbs int, format int, bits int) {
			if wMbs != widthMbs || hMbs != heightMbs || format != chromaFormat || bits != depth || stride == 0 {
				widthMbs = wMbs
				heightMbs = hMbs
				chromaFormat = format
				depth = bits
				// Monochrome pictures keep 4:2:0 planes of grey.
				let cw = format == 3 ?? (16, 8)
				let ch = (format := 2 || 3) ?? (16, 8)
				stride = wMbs * 16
				chromaStride = wMbs * cw
				let ySize = stride * hMbs * 16
				let cSize = chromaStride * hMbs * ch
				samples8 = new H264Planes<byte>(bits == 8 ?? (ySize, 0), bits == 8 ?? (cSize, 0))
				samples16 = new H264Planes<uint16>(bits == 8 ?? (0, ySize), bits == 8 ?? (0, cSize))
				topView = none
				bottomView = none
				let mbs = wMbs * hMbs
				mbType = h264Zeros(mbs)
				sliceOfMb = h264Filled(mbs, -1)
				mv0 = h264Zeros(mbs * 32)
				mv1 = h264Zeros(mbs * 32)
				ref0 = h264Filled(mbs * 16, -1)
				ref1 = h264Filled(mbs * 16, -1)
				uid0 = h264Filled(mbs * 16, -1)
				uid1 = h264Filled(mbs * 16, -1)
			}
		}

		// Clears the per-picture state before decoding into this buffer.
		def start() {
			sliceOfMb.fill(-1)
			numSlices = 0
			needOutput = false
			nonExisting = false
			invalidGap = false
			mmco5 = false
			idr = false
			hasPts = false
			ref = h264RefUnused
			longTermIdx = 0
			recovered = 0
			intra = false
			refFields = 0
			fields = 0
			asFields = false
			pairing = false
			surface = -1
		}

		// Field `parity` (1 top, 2 bottom) as a picture over the same planes:
		// every other line, half as many macroblock rows, and motion grids
		// of its own. Its order count, uid and marking are set by whoever
		// uses it.
		def field(parity int) H264Picture {
			let cached = parity == 1 ?? (topView, bottomView)
			return cached unless cached is none
			let f = new H264Picture()
			f.samples8 = samples8
			f.samples16 = samples16
			f.depth = depth
			f.widthMbs = widthMbs
			f.heightMbs = heightMbs >> 1
			f.stride = stride * 2
			f.chromaStride = chromaStride * 2
			f.base = parity == 2 ?? (stride, 0)
			f.cbase = parity == 2 ?? (chromaStride, 0)
			f.parity = parity
			f.owner = self
			f.chromaFormat = chromaFormat
			let mbs = f.widthMbs * f.heightMbs
			f.mbType = h264Zeros(mbs)
			f.sliceOfMb = h264Filled(mbs, -1)
			f.mv0 = h264Zeros(mbs * 32)
			f.mv1 = h264Zeros(mbs * 32)
			f.ref0 = h264Filled(mbs * 16, -1)
			f.ref1 = h264Filled(mbs * 16, -1)
			f.uid0 = h264Filled(mbs * 16, -1)
			f.uid1 = h264Filled(mbs * 16, -1)
			if parity == 1 {
				topView = f
			} else {
				bottomView = f
			}
			return f
		}

		// Sets every sample of the picture to `value`.
		def fillSamples(value int) {
			if depth == 8 {
				samples8.fill(value)
			} else {
				samples16.fill(value)
			}
		}

		// Sets both chroma planes to `value`.
		def fillChroma(value int) {
			if depth == 8 {
				samples8.u.fill(byte(value))
				samples8.v.fill(byte(value))
			} else {
				samples16.u.fill(uint16(value))
				samples16.v.fill(uint16(value))
			}
		}

		// Numbers a new slice of the picture.
		def addSlice() int {
			numSlices++
			return numSlices - 1
		}

		// Fills the picture with mid-grey and no motion, for a reference the
		// stream names but never sent.
		def grey() {
			fillSamples(1 << (depth - 1))
			mbType.fill(h264MbIntra16x16)
			sliceOfMb.fill(0)
			ref0.fill(-1)
			ref1.fill(-1)
			uid0.fill(-1)
			uid1.fill(-1)
			mv0.fill(0)
			mv1.fill(0)
			numSlices = 1
		}

		// Copies the samples of `other`, of the same size.
		def copySamples(other H264Picture) {
			if depth == 8 {
				samples8.copyFrom(other.samples8)
			} else {
				samples16.copyFrom(other.samples16)
			}
			mbType.fill(h264MbIntra16x16)
			sliceOfMb.fill(0)
			ref0.fill(-1)
			ref1.fill(-1)
			uid0.fill(-1)
			uid1.fill(-1)
			mv0.fill(0)
			mv1.fill(0)
			numSlices = 1
		}
	}
}
