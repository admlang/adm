internal partial module std.formats.video.h264 {
	// Storage of one sample: a byte at 8 bits, 16 bits for 9 to 14.
	type H264Sample = byte | uint16

	// The luma and chroma sample planes of a picture.
	type H264Planes<T: H264Sample> {
		y T[]
		u T[]
		v T[]

		def new(ySize int, cSize int) {
			y = T[]
			y.len(ySize)
			u = T[]
			u.len(cSize)
			v = T[]
			v.len(cSize)
		}

		// Sets every sample to `v`.
		def fill(value int) {
			y.fill(T(value))
			u.fill(T(value))
			v.fill(T(value))
		}

		// Copies the samples of `other`, of the same size.
		def copyFrom(other H264Planes<T>) {
			other.y.copy(y)
			other.u.copy(u)
			other.v.copy(v)
		}
	}

	// What sample code working on one storage needs: scratch blocks of
	// that storage, the planes of a picture in it, and the largest sample.
	type H264Kit<T: H264Sample> {
		predA    T[]
		predB    T[]
		emu      T[]
		max      int
		planes   def(H264Picture) H264Planes<T>
		// The interpolation and transform kernels: the generic ones, replaced by SIMD ones
		// for 8-bit samples. `tmp16` is the SIMD luma kernel's scratch.
		qpel     def(T[], int, int, int, int, int, int, T[], int, int, int[], int16[], int)
		bilinear def(T[], int, int, int, int, int, int, T[], int, int)
		idct8    def(T[], int, int, int[], int, int)
		idct4    def(T[], int, int, int[], int, int)
		dc4      def(T[], int, int, int, int)
		tmp16    int16[]

		def new(pick def(H264Picture) H264Planes<T>) {
			planes = pick
			qpel = def (s T[], so int, st int, fx int, fy int, w int, h int, d T[], doff int, dst int, tmp int[], tmp16 int16[], max int) {
				h264Qpel(s, so, st, fx, fy, w, h, d, doff, dst, tmp, max)
			}
			bilinear = def (s T[], so int, st int, fx int, fy int, w int, h int, d T[], doff int, dst int) {
				h264Bilinear(s, so, st, fx, fy, w, h, d, doff, dst)
			}
			idct8 = def (d T[], off int, stride int, c int[], at int, max int) {
				h264Idct8Add(d, off, stride, c, at, max)
			}
			idct4 = def (d T[], off int, stride int, c int[], at int, max int) {
				h264Idct4Add(d, off, stride, c, at, max)
			}
			dc4 = def (d T[], off int, stride int, dc int, max int) {
				h264Idct4Dc(d, off, stride, dc, max)
			}
			tmp16 = int16[]
			tmp16.len(21 * 16)
			predA = T[]
			predA.len(256)
			predB = T[]
			predB.len(256)
			emu = T[]
			emu.len(h264EmuStride * h264EmuStride)
			max = 255
		}
	}
}
