internal partial module std.formats.video.h264 {
	// Storage of one sample: a byte at 8 bits, 16 bits for 9 to 14.
	type H264Sample = byte | uint16

	// The luma and chroma sample planes of a picture.
	type H264Planes<T: H264Sample> {
		y T[]
		u T[]
		v T[]

		def new(ySize int, cSize int) {
			y = T[]
			y.len(ySize)
			u = T[]
			u.len(cSize)
			v = T[]
			v.len(cSize)
		}

		// Sets every sample to `v`.
		def fill(value int) {
			y.fill(T(value))
			u.fill(T(value))
			v.fill(T(value))
		}

		// Copies the samples of `other`, of the same size.
		def copyFrom(other H264Planes<T>) {
			other.y.copy(y)
			other.u.copy(u)
			other.v.copy(v)
		}
	}

	// What sample code working on one storage needs: scratch blocks of
	// that storage, the planes of a picture in it, and the largest sample.
	type H264Kit<T: H264Sample> {
		predA  T[]
		predB  T[]
		emu    T[]
		max    int
		planes def(H264Picture) H264Planes<T>

		def new(pick def(H264Picture) H264Planes<T>) {
			planes = pick
			predA = T[]
			predA.len(256)
			predB = T[]
			predB.len(256)
			emu = T[]
			emu.len(h264EmuStride * h264EmuStride)
			max = 255
		}
	}
}
