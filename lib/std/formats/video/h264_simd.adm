internal partial module std.formats.video.h264 {
	use std.simd

	// The 8-bit sample kernels on SIMD vectors, eight samples at a time,
	// which the 8-bit `H264Kit` calls instead of the generic ones. They give
	// the generic kernels' results exactly; blocks narrower than eight
	// samples go to the generic kernels.

	// Eight samples from `s[p:]` in 16-bit lanes.
	def h264Wide8(s byte[], p int) vec8<int16> {
		return simd.convert<byte, int16>(simd.load8<byte>(s, p))
	}

	// The six-tap filter (1, -5, 20, 20, -5, 1) over six vectors, unrounded.
	def h264Tap8(a vec8<int16>, b vec8<int16>, c vec8<int16>, d vec8<int16>, e vec8<int16>, f vec8<int16>) vec8<int16> {
		return a + f - simd.splat8<int16>(int16(5)) * (b + e) + simd.splat8<int16>(int16(20)) * (c + d)
	}

	// The horizontal taps of the eight samples from `s[p:]`.
	def h264TapRow8(s byte[], p int) vec8<int16> {
		return h264Tap8(h264Wide8(s, p - 2), h264Wide8(s, p - 1), h264Wide8(s, p), h264Wide8(s, p + 1), h264Wide8(s, p + 2), h264Wide8(s, p + 3))
	}

	// The vertical taps of the eight samples from `s[p:]`, rows `st` apart.
	def h264TapColumn8(s byte[], p int, st int) vec8<int16> {
		return h264Tap8(h264Wide8(s, p - 2 * st), h264Wide8(s, p - st), h264Wide8(s, p), h264Wide8(s, p + st), h264Wide8(s, p + 2 * st), h264Wide8(s, p + 3 * st))
	}

	// A half sample from its taps: (v + 16) >> 5 clipped to 0..255.
	def h264Round8(v vec8<int16>) vec8<byte> {
		let r = (v + simd.splat8<int16>(int16(16))) >> 5
		return simd.convert<int16, byte>(simd.clamp(r, simd.splat8<int16>(int16(0)), simd.splat8<int16>(int16(255))))
	}

	// The average of two samples rounded up, (a + b + 1) >> 1 per lane (the
	// prelude's `avg` rounds down).
	def h264Avg8(a vec8<byte>, b vec8<byte>) vec8<byte> {
		return (a | b) - ((a ^ b) >> 1)
	}

	// `h264Qpel` for 8-bit samples. `tmp16` holds 21 rows of 16 taps.
	def h264QpelBytes(s byte[], so int, st int, fx int, fy int, w int, h int, d byte[], doff int, dst int, tmp int[], tmp16 int16[], max int) {
		if w < 8 {
			h264Qpel(s, so, st, fx, fy, w, h, d, doff, dst, tmp, max)
			return
		}
		if fx == 0 && fy == 0 {
			for let j = 0; j < h; j++ {
				for let i = 0; i < w; i += 8 {
					simd.store8<byte>(d, doff + j * dst + i, simd.load8<byte>(s, so + j * st + i))
				}
			}
			return
		}
		if fy == 0 {
			// b, and a or c: the average with the integer sample left or right.
			let other = fx == 3 ?? (1, 0)
			for let j = 0; j < h; j++ {
				let p = so + j * st
				for let i = 0; i < w; i += 8 {
					let b = h264Round8(h264TapRow8(s, p + i))
					b = h264Avg8(b, simd.load8<byte>(s, p + i + other)) when fx != 2
					simd.store8<byte>(d, doff + j * dst + i, b)
				}
			}
			return
		}
		if fx == 0 {
			// h, and d or n: the average with the integer sample above or below.
			let other = fy == 3 ?? (st, 0)
			for let j = 0; j < h; j++ {
				let p = so + j * st
				for let i = 0; i < w; i += 8 {
					let v = h264Round8(h264TapColumn8(s, p + i, st))
					v = h264Avg8(v, simd.load8<byte>(s, p + i + other)) when fy != 2
					simd.store8<byte>(d, doff + j * dst + i, v)
				}
			}
			return
		}
		if fx == 2 || fy == 2 {
			// The centre sample j from the unrounded horizontal taps of the
			// h + 5 rows around the block, filtered down in 32-bit lanes, then
			// its averages f, q, i and k.
			for let j = 0; j < h + 5; j++ {
				let p = so + (j - 2) * st
				for let i = 0; i < w; i += 8 {
					simd.store8<int16>(tmp16, j * 16 + i, h264TapRow8(s, p + i))
				}
			}
			let col = fx == 3 ?? (1, 0)
			let half = fy == 3 ?? (16, 0)
			let five = simd.splat8<int32>(int32(5))
			let twenty = simd.splat8<int32>(int32(20))
			for let j = 0; j < h; j++ {
				for let i = 0; i < w; i += 8 {
					let t = j * 16 + i
					let a = simd.convert<int16, int32>(simd.load8<int16>(tmp16, t))
					let b = simd.convert<int16, int32>(simd.load8<int16>(tmp16, t + 16))
					let c = simd.convert<int16, int32>(simd.load8<int16>(tmp16, t + 32))
					let e = simd.convert<int16, int32>(simd.load8<int16>(tmp16, t + 48))
					let f = simd.convert<int16, int32>(simd.load8<int16>(tmp16, t + 64))
					let g = simd.convert<int16, int32>(simd.load8<int16>(tmp16, t + 80))
					let jj = (a + g - five * (b + f) + twenty * (c + e) + simd.splat8<int32>(int32(512))) >> 10
					jj = simd.clamp(jj, simd.splat8<int32>(int32(0)), simd.splat8<int32>(int32(255)))
					let v = simd.convert<int32, byte>(jj)
					if fx == 2 && fy != 2 {
						v = h264Avg8(v, h264Round8(simd.load8<int16>(tmp16, t + 32 + half)))
					} else if fx != 2 {
						v = h264Avg8(v, h264Round8(h264TapColumn8(s, so + j * st + i + col, st)))
					}
					simd.store8<byte>(d, doff + j * dst + i, v)
				}
			}
			return
		}
		// e, g, p and r: the average of a horizontal and a vertical half
		// sample.
		let rowOff = fy == 3 ?? (st, 0)
		let colOff = fx == 3 ?? (1, 0)
		for let j = 0; j < h; j++ {
			let p = so + j * st
			for let i = 0; i < w; i += 8 {
				let b = h264Round8(h264TapRow8(s, p + rowOff + i))
				let v = h264Round8(h264TapColumn8(s, p + colOff + i, st))
				simd.store8<byte>(d, doff + j * dst + i, h264Avg8(b, v))
			}
		}
	}

	// `h264Bilinear` for 8-bit samples.
	def h264BilinearBytes(s byte[], so int, st int, fx int, fy int, w int, h int, dst byte[], doff int, dstride int) {
		if w < 8 {
			h264Bilinear4Bytes(s, so, st, fx, fy, w, h, dst, doff, dstride)
			return
		}
		let a = simd.splat8<int16>(int16((8 - fx) * (8 - fy)))
		let b = simd.splat8<int16>(int16(fx * (8 - fy)))
		let c = simd.splat8<int16>(int16((8 - fx) * fy))
		let e = simd.splat8<int16>(int16(fx * fy))
		let round = simd.splat8<int16>(int16(32))
		for let j = 0; j < h; j++ {
			let p = so + j * st
			for let i = 0; i < w; i += 8 {
				let q = p + i
				let v = a * h264Wide8(s, q) + b * h264Wide8(s, q + 1) + c * h264Wide8(s, q + st) + e * h264Wide8(s, q + st + 1)
				simd.store8<byte>(dst, doff + j * dstride + i, simd.convert<int16, byte>((v + round) >> 6))
			}
		}
	}

	// Four samples from `s[p:]` in 16-bit lanes.
	def h264Wide4(s byte[], p int) vec4<int16> {
		return simd.convert<byte, int16>(simd.load4<byte>(s, p))
	}

	// `h264Bilinear` for 8-bit samples four wide; two wide goes to the
	// generic kernel.
	def h264Bilinear4Bytes(s byte[], so int, st int, fx int, fy int, w int, h int, dst byte[], doff int, dstride int) {
		if w != 4 {
			h264Bilinear(s, so, st, fx, fy, w, h, dst, doff, dstride)
			return
		}
		let a = simd.splat4<int16>(int16((8 - fx) * (8 - fy)))
		let b = simd.splat4<int16>(int16(fx * (8 - fy)))
		let c = simd.splat4<int16>(int16((8 - fx) * fy))
		let e = simd.splat4<int16>(int16(fx * fy))
		let round = simd.splat4<int16>(int16(32))
		for let j = 0; j < h; j++ {
			let q = so + j * st
			let v = a * h264Wide4(s, q) + b * h264Wide4(s, q + 1) + c * h264Wide4(s, q + st) + e * h264Wide4(s, q + st + 1)
			simd.store4<byte>(dst, doff + j * dstride, simd.convert<int16, byte>((v + round) >> 6))
		}
	}

	// The 8-point inverse transform of `h264Idct8Add` on eight vectors at
	// once.
	def h264Idct8Pass(d0 vec8<int32>, d1 vec8<int32>, d2 vec8<int32>, d3 vec8<int32>, d4 vec8<int32>, d5 vec8<int32>, d6 vec8<int32>, d7 vec8<int32>) (vec8<int32>, vec8<int32>, vec8<int32>, vec8<int32>, vec8<int32>, vec8<int32>, vec8<int32>, vec8<int32>) {
		let a0 = d0 + d4
		let a4 = d0 - d4
		let a2 = (d2 >> 1) - d6
		let a6 = d2 + (d6 >> 1)
		let b0 = a0 + a6
		let b2 = a4 + a2
		let b4 = a4 - a2
		let b6 = a0 - a6
		let a1 = d5 - d3 - d7 - (d7 >> 1)
		let a3 = d1 + d7 - d3 - (d3 >> 1)
		let a5 = d7 - d1 + d5 + (d5 >> 1)
		let a7 = d3 + d5 + d1 + (d1 >> 1)
		let b1 = a1 + (a7 >> 2)
		let b7 = a7 - (a1 >> 2)
		let b3 = a3 + (a5 >> 2)
		let b5 = (a3 >> 2) - a5
		return (b0 + b7, b2 + b5, b4 + b3, b6 + b1, b6 - b1, b4 - b3, b2 - b5, b0 - b7)
	}

	// Row `y` of the coefficients `c[at:]` in 32-bit lanes, then cleared.
	def h264CoefRow8(c int[], at int) vec8<int32> {
		let v = simd.convert<int, int32>(simd.load8<int>(c, at))
		simd.store8<int>(c, at, simd.splat8<int>(0))
		return v
	}

	// Adds the residual row `r` ((r + 32) >> 6) to the eight samples at
	// `dst[p:]`, clipped to 0..255.
	def h264AddRow8(dst byte[], p int, r vec8<int32>) {
		let v = simd.convert<byte, int32>(simd.load8<byte>(dst, p)) + ((r + simd.splat8<int32>(int32(32))) >> 6)
		v = simd.clamp(v, simd.splat8<int32>(int32(0)), simd.splat8<int32>(int32(255)))
		simd.store8<byte>(dst, p, simd.convert<int32, byte>(v))
	}

	// `h264Idct8Add` for 8-bit samples: the rows are transformed eight at a
	// time after a transpose, then the columns after another.
	def h264Idct8AddBytes(dst byte[], off int, stride int, c int[], at int, max int) {
		let (r0, r1, r2, r3, r4, r5, r6, r7) = simd.transpose8(h264CoefRow8(c, at), h264CoefRow8(c, at + 8), h264CoefRow8(c, at + 16), h264CoefRow8(c, at + 24), h264CoefRow8(c, at + 32), h264CoefRow8(c, at + 40), h264CoefRow8(c, at + 48), h264CoefRow8(c, at + 56))
		let (e0, e1, e2, e3, e4, e5, e6, e7) = h264Idct8Pass(r0, r1, r2, r3, r4, r5, r6, r7)
		let (t0, t1, t2, t3, t4, t5, t6, t7) = simd.transpose8(e0, e1, e2, e3, e4, e5, e6, e7)
		let (o0, o1, o2, o3, o4, o5, o6, o7) = h264Idct8Pass(t0, t1, t2, t3, t4, t5, t6, t7)
		h264AddRow8(dst, off, o0)
		h264AddRow8(dst, off + stride, o1)
		h264AddRow8(dst, off + 2 * stride, o2)
		h264AddRow8(dst, off + 3 * stride, o3)
		h264AddRow8(dst, off + 4 * stride, o4)
		h264AddRow8(dst, off + 5 * stride, o5)
		h264AddRow8(dst, off + 6 * stride, o6)
		h264AddRow8(dst, off + 7 * stride, o7)
	}

	// Sixteen samples from `s[p:]` in 16-bit lanes.
	def h264Wide16(s byte[], p int) vec16<int16> {
		return simd.convert<byte, int16>(simd.load16<byte>(s, p))
	}

	// Stores 16-bit lanes back as samples, keeping their low bytes as the
	// generic filter's conversions do.
	def h264Narrow16(s byte[], p int, v vec16<int16>) {
		simd.store16<byte>(s, p, simd.convert<int16, byte>(v))
	}

	// `v` clamped to -t..t per lane.
	def h264Clamp16(v vec16<int16>, t vec16<int16>) vec16<int16> {
		return simd.clamp(v, simd.splat16<int16>(int16(0)) - t, t)
	}

	// `h264FilterEdge` for 8-bit samples: 16 luma lines when every strength
	// of the edge is below 4 or every one is 4, and 8 chroma lines. Other
	// edges go to the generic filter.
	def h264FilterEdgeBytes(s byte[], off int, across int, along int, lines int, bs int[], indexA int, indexB int, chroma bool, shift int, max int) {
		if chroma && lines == 8 && shift == 0 && (along == 1 || across == 1) {
			let ia = h264Clip3(0, 51, indexA)
			let alpha = h264Alpha[ia]
			let beta = h264Beta[h264Clip3(0, 51, indexB)]
			return when alpha == 0 || beta == 0
			h264FilterChroma8(s, off, across, along, bs, ia, alpha, beta)
			return
		}
		let strong = bs[0] == 4 && bs[1] == 4 && bs[2] == 4 && bs[3] == 4
		let normal = bs[0] < 4 && bs[1] < 4 && bs[2] < 4 && bs[3] < 4
		if chroma || lines != 16 || shift != 0 || !(strong || normal) || (along != 1 && across != 1) {
			h264FilterEdge(s, off, across, along, lines, bs, indexA, indexB, chroma, shift, max)
			return
		}
		if along != 1 {
			// A vertical edge: eight lines at a time, turned into columns.
			let ia = h264Clip3(0, 51, indexA)
			let alpha = h264Alpha[ia]
			let beta = h264Beta[h264Clip3(0, 51, indexB)]
			return when alpha == 0 || beta == 0
			h264FilterAcross8(s, off, along, bs[0], bs[1], ia, alpha, beta, strong)
			h264FilterAcross8(s, off + 8 * along, along, bs[2], bs[3], ia, alpha, beta, strong)
			return
		}
		let ia = h264Clip3(0, 51, indexA)
		let ib = h264Clip3(0, 51, indexB)
		let alpha = h264Alpha[ia]
		let beta = h264Beta[ib]
		return when alpha == 0 || beta == 0
		let p2 = h264Wide16(s, off - 3 * across)
		let p1 = h264Wide16(s, off - 2 * across)
		let p0 = h264Wide16(s, off - across)
		let q0 = h264Wide16(s, off)
		let q1 = h264Wide16(s, off + across)
		let q2 = h264Wide16(s, off + 2 * across)
		let betaV = simd.splat16<int16>(int16(beta))
		let on = (p0 - q0).abs().lt(simd.splat16<int16>(int16(alpha))) & (p1 - p0).abs().lt(betaV) & (q1 - q0).abs().lt(betaV)
		let pSmooth = (p2 - p0).abs().lt(betaV)
		let qSmooth = (q2 - q0).abs().lt(betaV)
		let zero = simd.splat16<int16>(int16(0))
		let one = simd.splat16<int16>(int16(1))
		let two = simd.splat16<int16>(int16(2))
		let four = simd.splat16<int16>(int16(4))
		if normal {
			// tc0 per four lines, and the lines whose strength is zero off.
			let tc0 = zero
			let live = zero
			for let i = 0; i < 16; i++ {
				let b = bs[i >> 2]
				if b > 0 {
					tc0 = tc0.withLane(i, int16(h264Tc0[ia * 3 + b - 1]))
					live = live.withLane(i, int16(1))
				}
			}
			on = on & live.gt(zero)
			return unless on.any()
			let tc = tc0 + pSmooth.blend(one, zero) + qSmooth.blend(one, zero)
			let delta = h264Clamp16((((q0 - p0) << 2) + (p1 - q1) + four) >> 3, tc)
			let top = simd.splat16<int16>(int16(255))
			let np0 = simd.clamp(p0 + delta, zero, top)
			let nq0 = simd.clamp(q0 - delta, zero, top)
			let avg = (p0 + q0 + one) >> 1
			let np1 = p1 + h264Clamp16((p2 + avg - (p1 << 1)) >> 1, tc0)
			let nq1 = q1 + h264Clamp16((q2 + avg - (q1 << 1)) >> 1, tc0)
			h264Narrow16(s, off - 2 * across, (on & pSmooth).blend(np1, p1))
			h264Narrow16(s, off - across, on.blend(np0, p0))
			h264Narrow16(s, off, on.blend(nq0, q0))
			h264Narrow16(s, off + across, (on & qSmooth).blend(nq1, q1))
			return
		}
		return unless on.any()
		let p3 = h264Wide16(s, off - 4 * across)
		let q3 = h264Wide16(s, off + 3 * across)
		let near = (p0 - q0).abs().lt(simd.splat16<int16>(int16((alpha >> 2) + 2)))
		let pFull = on & pSmooth & near
		let qFull = on & qSmooth & near
		let three = simd.splat16<int16>(int16(3))
		let np0 = pFull.blend((p2 + two * p1 + two * p0 + two * q0 + q1 + four) >> 3, (two * p1 + p0 + q1 + two) >> 2)
		let np1 = (p2 + p1 + p0 + q0 + two) >> 2
		let np2 = (two * p3 + three * p2 + p1 + p0 + q0 + four) >> 3
		let nq0 = qFull.blend((p1 + two * p0 + two * q0 + two * q1 + q2 + four) >> 3, (two * q1 + q0 + p1 + two) >> 2)
		let nq1 = (p0 + q0 + q1 + q2 + two) >> 2
		let nq2 = (two * q3 + three * q2 + q1 + q0 + p0 + four) >> 3
		h264Narrow16(s, off - 3 * across, pFull.blend(np2, p2))
		h264Narrow16(s, off - 2 * across, pFull.blend(np1, p1))
		h264Narrow16(s, off - across, on.blend(np0, p0))
		h264Narrow16(s, off, on.blend(nq0, q0))
		h264Narrow16(s, off + across, qFull.blend(nq1, q1))
		h264Narrow16(s, off + 2 * across, qFull.blend(nq2, q2))
	}

	// Eight samples in 16-bit lanes from a column of bytes.
	def h264Widen8(v vec8<byte>) vec8<int16> {
		return simd.convert<byte, int16>(v)
	}

	// `v` clamped to -t..t per lane.
	def h264Clamp8(v vec8<int16>, t vec8<int16>) vec8<int16> {
		return simd.clamp(v, simd.splat8<int16>(int16(0)) - t, t)
	}

	// Filters the eight lines from `s[off:]`, `stride` apart, across the
	// vertical edge in front of `off`: the first four lines with strength
	// `bs0`, the rest with `bs1`, every one 4 when `strong`. The 8 x 8
	// samples around the edge are transposed so each column is a vector.
	def h264FilterAcross8(s byte[], off int, stride int, bs0 int, bs1 int, ia int, alpha int, beta int, strong bool) {
		return when bs0 == 0 && bs1 == 0
		let o = off - 4
		let (c0, c1, c2, c3, c4, c5, c6, c7) = simd.transpose8(simd.load8<byte>(s, o), simd.load8<byte>(s, o + stride), simd.load8<byte>(s, o + 2 * stride), simd.load8<byte>(s, o + 3 * stride), simd.load8<byte>(s, o + 4 * stride), simd.load8<byte>(s, o + 5 * stride), simd.load8<byte>(s, o + 6 * stride), simd.load8<byte>(s, o + 7 * stride))
		let p3 = h264Widen8(c0)
		let p2 = h264Widen8(c1)
		let p1 = h264Widen8(c2)
		let p0 = h264Widen8(c3)
		let q0 = h264Widen8(c4)
		let q1 = h264Widen8(c5)
		let q2 = h264Widen8(c6)
		let q3 = h264Widen8(c7)
		let betaV = simd.splat8<int16>(int16(beta))
		let on = (p0 - q0).abs().lt(simd.splat8<int16>(int16(alpha))) & (p1 - p0).abs().lt(betaV) & (q1 - q0).abs().lt(betaV)
		let pSmooth = (p2 - p0).abs().lt(betaV)
		let qSmooth = (q2 - q0).abs().lt(betaV)
		let zero = simd.splat8<int16>(int16(0))
		let one = simd.splat8<int16>(int16(1))
		let two = simd.splat8<int16>(int16(2))
		let four = simd.splat8<int16>(int16(4))
		let r1 = p2
		let r2 = p1
		let r3 = p0
		let r4 = q0
		let r5 = q1
		let r6 = q2
		if strong {
			return unless on.any()
			let near = (p0 - q0).abs().lt(simd.splat8<int16>(int16((alpha >> 2) + 2)))
			let pFull = on & pSmooth & near
			let qFull = on & qSmooth & near
			let three = simd.splat8<int16>(int16(3))
			r1 = pFull.blend((two * p3 + three * p2 + p1 + p0 + q0 + four) >> 3, p2)
			r2 = pFull.blend((p2 + p1 + p0 + q0 + two) >> 2, p1)
			r3 = on.blend(pFull.blend((p2 + two * p1 + two * p0 + two * q0 + q1 + four) >> 3, (two * p1 + p0 + q1 + two) >> 2), p0)
			r4 = on.blend(qFull.blend((p1 + two * p0 + two * q0 + two * q1 + q2 + four) >> 3, (two * q1 + q0 + p1 + two) >> 2), q0)
			r5 = qFull.blend((p0 + q0 + q1 + q2 + two) >> 2, q1)
			r6 = qFull.blend((two * q3 + three * q2 + q1 + q0 + p0 + four) >> 3, q2)
		} else {
			let t0 = bs0 > 0 ?? (h264Tc0[ia * 3 + bs0 - 1], 0)
			let t1 = bs1 > 0 ?? (h264Tc0[ia * 3 + bs1 - 1], 0)
			let tc0 = zero
			let live = zero
			for let i = 0; i < 8; i++ {
				let b = i < 4 ?? (bs0, bs1)
				if b > 0 {
					tc0 = tc0.withLane(i, int16(i < 4 ?? (t0, t1)))
					live = live.withLane(i, int16(1))
				}
			}
			on = on & live.gt(zero)
			return unless on.any()
			let tc = tc0 + pSmooth.blend(one, zero) + qSmooth.blend(one, zero)
			let delta = h264Clamp8((((q0 - p0) << 2) + (p1 - q1) + four) >> 3, tc)
			let top = simd.splat8<int16>(int16(255))
			let avg = (p0 + q0 + one) >> 1
			r2 = (on & pSmooth).blend(p1 + h264Clamp8((p2 + avg - (p1 << 1)) >> 1, tc0), p1)
			r3 = on.blend(simd.clamp(p0 + delta, zero, top), p0)
			r4 = on.blend(simd.clamp(q0 - delta, zero, top), q0)
			r5 = (on & qSmooth).blend(q1 + h264Clamp8((q2 + avg - (q1 << 1)) >> 1, tc0), q1)
		}
		let (w0, w1, w2, w3, w4, w5, w6, w7) = simd.transpose8(c0, simd.convert<int16, byte>(r1), simd.convert<int16, byte>(r2), simd.convert<int16, byte>(r3), simd.convert<int16, byte>(r4), simd.convert<int16, byte>(r5), simd.convert<int16, byte>(r6), c7)
		simd.store8<byte>(s, o, w0)
		simd.store8<byte>(s, o + stride, w1)
		simd.store8<byte>(s, o + 2 * stride, w2)
		simd.store8<byte>(s, o + 3 * stride, w3)
		simd.store8<byte>(s, o + 4 * stride, w4)
		simd.store8<byte>(s, o + 5 * stride, w5)
		simd.store8<byte>(s, o + 6 * stride, w6)
		simd.store8<byte>(s, o + 7 * stride, w7)
	}

	// Filters the eight chroma lines from `s[off:]`, `along` apart, across
	// the edge `across` before `off`; each strength in `bs` covers two
	// lines. A vertical edge's 8 x 8 samples around it are transposed so
	// each column is a vector.
	def h264FilterChroma8(s byte[], off int, across int, along int, bs int[], ia int, alpha int, beta int) {
		return when bs[0] == 0 && bs[1] == 0 && bs[2] == 0 && bs[3] == 0
		let o = off - 4
		let c0 = simd.splat8<byte>(byte(0))
		let c1 = c0
		let c2 = c0
		let c3 = c0
		let c4 = c0
		let c5 = c0
		let c6 = c0
		let c7 = c0
		if along == 1 {
			c2 = simd.load8<byte>(s, off - 2 * across)
			c3 = simd.load8<byte>(s, off - across)
			c4 = simd.load8<byte>(s, off)
			c5 = simd.load8<byte>(s, off + across)
		} else {
			(c0, c1, c2, c3, c4, c5, c6, c7) = simd.transpose8(simd.load8<byte>(s, o), simd.load8<byte>(s, o + along), simd.load8<byte>(s, o + 2 * along), simd.load8<byte>(s, o + 3 * along), simd.load8<byte>(s, o + 4 * along), simd.load8<byte>(s, o + 5 * along), simd.load8<byte>(s, o + 6 * along), simd.load8<byte>(s, o + 7 * along))
		}
		let p1 = h264Widen8(c2)
		let p0 = h264Widen8(c3)
		let q0 = h264Widen8(c4)
		let q1 = h264Widen8(c5)
		let zero = simd.splat8<int16>(int16(0))
		let betaV = simd.splat8<int16>(int16(beta))
		// tc per two lines, the lines whose strength is zero off, and those
		// whose strength is 4.
		let tc = zero
		let live = zero
		let four = zero
		for let i = 0; i < 8; i++ {
			let b = bs[i >> 1]
			if b > 0 {
				live = live.withLane(i, int16(1))
				if b < 4 {
					tc = tc.withLane(i, int16(h264Tc0[ia * 3 + b - 1] + 1))
				} else {
					four = four.withLane(i, int16(1))
				}
			}
		}
		let on = (p0 - q0).abs().lt(simd.splat8<int16>(int16(alpha))) & (p1 - p0).abs().lt(betaV) & (q1 - q0).abs().lt(betaV) & live.gt(zero)
		return unless on.any()
		let strong = four.gt(zero)
		let two = simd.splat8<int16>(int16(2))
		let top = simd.splat8<int16>(int16(255))
		let delta = h264Clamp8((((q0 - p0) << 2) + (p1 - q1) + simd.splat8<int16>(int16(4))) >> 3, tc)
		let np0 = on.blend(strong.blend((two * p1 + p0 + q1 + two) >> 2, simd.clamp(p0 + delta, zero, top)), p0)
		let nq0 = on.blend(strong.blend((two * q1 + q0 + p1 + two) >> 2, simd.clamp(q0 - delta, zero, top)), q0)
		if along == 1 {
			simd.store8<byte>(s, off - across, simd.convert<int16, byte>(np0))
			simd.store8<byte>(s, off, simd.convert<int16, byte>(nq0))
			return
		}
		let (w0, w1, w2, w3, w4, w5, w6, w7) = simd.transpose8(c0, c1, c2, simd.convert<int16, byte>(np0), simd.convert<int16, byte>(nq0), c5, c6, c7)
		simd.store8<byte>(s, o, w0)
		simd.store8<byte>(s, o + along, w1)
		simd.store8<byte>(s, o + 2 * along, w2)
		simd.store8<byte>(s, o + 3 * along, w3)
		simd.store8<byte>(s, o + 4 * along, w4)
		simd.store8<byte>(s, o + 5 * along, w5)
		simd.store8<byte>(s, o + 6 * along, w6)
		simd.store8<byte>(s, o + 7 * along, w7)
	}

	// Transposes the 4x4 matrix whose rows are `r0`..`r3`.
	def h264Transpose4(r0 vec4<int32>, r1 vec4<int32>, r2 vec4<int32>, r3 vec4<int32>) (vec4<int32>, vec4<int32>, vec4<int32>, vec4<int32>) {
		let a0 = r0.zipLo(r2)
		let a1 = r0.zipHi(r2)
		let a2 = r1.zipLo(r3)
		let a3 = r1.zipHi(r3)
		return (a0.zipLo(a2), a0.zipHi(a2), a1.zipLo(a3), a1.zipHi(a3))
	}

	// The 4-point inverse transform of `h264Idct4Add` on four vectors at
	// once.
	def h264Idct4Pass(d0 vec4<int32>, d1 vec4<int32>, d2 vec4<int32>, d3 vec4<int32>) (vec4<int32>, vec4<int32>, vec4<int32>, vec4<int32>) {
		let e0 = d0 + d2
		let e1 = d0 - d2
		let e2 = (d1 >> 1) - d3
		let e3 = d1 + (d3 >> 1)
		return (e0 + e3, e1 + e2, e1 - e2, e0 - e3)
	}

	// Row `y` of the 4x4 coefficients `c[at:]` in 32-bit lanes, then
	// cleared.
	def h264CoefRow4(c int[], at int) vec4<int32> {
		let v = simd.convert<int, int32>(simd.load4<int>(c, at))
		simd.store4<int>(c, at, simd.splat4<int>(0))
		return v
	}

	// Adds the residual row `r` ((r + 32) >> 6) to the four samples at
	// `dst[p:]`, clipped to 0..255.
	def h264AddRow4(dst byte[], p int, r vec4<int32>) {
		let v = simd.convert<byte, int32>(simd.load4<byte>(dst, p)) + ((r + simd.splat4<int32>(int32(32))) >> 6)
		v = simd.clamp(v, simd.splat4<int32>(int32(0)), simd.splat4<int32>(int32(255)))
		simd.store4<byte>(dst, p, simd.convert<int32, byte>(v))
	}

	// `h264Idct4Add` for 8-bit samples: the rows are transformed four at a
	// time after a transpose, then the columns after another.
	def h264Idct4AddBytes(dst byte[], off int, stride int, c int[], at int, max int) {
		let (r0, r1, r2, r3) = h264Transpose4(h264CoefRow4(c, at), h264CoefRow4(c, at + 4), h264CoefRow4(c, at + 8), h264CoefRow4(c, at + 12))
		let (e0, e1, e2, e3) = h264Idct4Pass(r0, r1, r2, r3)
		let (t0, t1, t2, t3) = h264Transpose4(e0, e1, e2, e3)
		let (o0, o1, o2, o3) = h264Idct4Pass(t0, t1, t2, t3)
		h264AddRow4(dst, off, o0)
		h264AddRow4(dst, off + stride, o1)
		h264AddRow4(dst, off + 2 * stride, o2)
		h264AddRow4(dst, off + 3 * stride, o3)
	}

	// `h264Idct4Dc` for 8-bit samples.
	def h264Idct4DcBytes(dst byte[], off int, stride int, dc int, max int) {
		let v = simd.splat4<int32>(int32(dc))
		h264AddRow4(dst, off, v)
		h264AddRow4(dst, off + stride, v)
		h264AddRow4(dst, off + 2 * stride, v)
		h264AddRow4(dst, off + 3 * stride, v)
	}
}
