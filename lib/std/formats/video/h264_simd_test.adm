partial module std.formats.video {
	use (
		std.testing
		std.formats.video.h264::*
	)

	check "H.264 SIMD kernels" {
		// A 48x48 plane of pseudo-random samples, extremes included.
		internal def simdPlane() byte[] {
			let s byte[]
			s.len(48 * 48)
			let x = 12345
			for let i = 0; i < s.len(); i++ {
				x = (x * 1103515245 + 12345) & 0x7fffffff
				s[i] = byte((x >> 16) & 255)
			}
			s[20 * 48 + 20] = byte(255)
			s[21 * 48 + 21] = byte(0)
			return s
		}

		@test()
		def TestQpelBytesMatchesGeneric() !none {
			let s = simdPlane()
			let tmp = h264Zeros(640)
			let tmp16 int16[]
			tmp16.len(21 * 16)
			// Every partition shape.
			let sizes = int[4, 4, 8, 4, 4, 8, 8, 8, 16, 8, 8, 16, 16, 16]
			for let n = 0; n < sizes.len(); n += 2 {
				let w = sizes[n]
				let h = sizes[n + 1]
				for let fx = 0; fx < 4; fx++ {
					for let fy = 0; fy < 4; fy++ {
						let want byte[]
						want.len(16 * 16)
						let got byte[]
						got.len(16 * 16)
						h264Qpel(s, 8 * 48 + 8, 48, fx, fy, w, h, want, 0, 16, tmp, 255)
						h264QpelBytes(s, 8 * 48 + 8, 48, fx, fy, w, h, got, 0, 16, tmp, tmp16, 255)
						fail "qpel {w}x{h} fx={fx} fy={fy}" unless got.equals(want)
					}
				}
			}
		}

		@test()
		def TestBilinearBytesMatchesGeneric() !none {
			let s = simdPlane()
			for let (_, size) in int[2, 4, 8] {
				for let fx = 0; fx < 8; fx++ {
					for let fy = 0; fy < 8; fy++ {
						let want byte[]
						want.len(16 * 16)
						let got byte[]
						got.len(16 * 16)
						h264Bilinear(s, 8 * 48 + 8, 48, fx, fy, size, size, want, 0, 16)
						h264BilinearBytes(s, 8 * 48 + 8, 48, fx, fy, size, size, got, 0, 16)
						fail "bilinear {size} fx={fx} fy={fy}" unless got.equals(want)
					}
				}
			}
		}

		@test()
		def TestIdct8BytesMatchesGeneric() !none {
			let s = simdPlane()
			let x = 777
			for let round = 0; round < 40; round++ {
				let a int[]
				a.len(64)
				for let i = 0; i < 64; i++ {
					x = (x * 1103515245 + 12345) & 0x7fffffff
					// Mostly small levels, some large, as dequantised blocks have.
					let v = (x >> 8) % (round % 4 == 0 ?? (8192, 512))
					a[i] = (x & 1) == 0 ?? (v, -v)
				}
				let b = a.clone()
				let want = s.clone()
				let got = s.clone()
				h264Idct8Add(want, 5 * 48 + 3, 48, a, 0, 255)
				h264Idct8AddBytes(got, 5 * 48 + 3, 48, b, 0, 255)
				fail "idct8 round {round}" unless got.equals(want) && b.equals(a)
			}
		}

		@test()
		def TestIdct4BytesMatchesGeneric() !none {
			let s = simdPlane()
			let x = 991
			for let round = 0; round < 60; round++ {
				let a int[]
				a.len(16)
				for let i = 0; i < 16; i++ {
					x = (x * 1103515245 + 12345) & 0x7fffffff
					let v = (x >> 8) % (round % 4 == 0 ?? (8192, 512))
					a[i] = (x & 1) == 0 ?? (v, -v)
				}
				let b = a.clone()
				let want = s.clone()
				let got = s.clone()
				h264Idct4Add(want, 7 * 48 + 5, 48, a, 0, 255)
				h264Idct4AddBytes(got, 7 * 48 + 5, 48, b, 0, 255)
				fail "idct4 round {round}" unless got.equals(want) && b.equals(a)
				let wantDc = s.clone()
				let gotDc = s.clone()
				h264Idct4Dc(wantDc, 9 * 48 + 2, 48, a[0] * 4, 255)
				h264Idct4DcBytes(gotDc, 9 * 48 + 2, 48, a[0] * 4, 255)
				fail "dc4 round {round}" unless gotDc.equals(wantDc)
			}
		}

		@test()
		def TestQpelBytesSmoothCentre() !none {
			// 22 x 14 samples around a 16 x 8 block from a real stream.
			let s = byte[196, 196, 196, 196, 196, 196, 196, 194, 193, 192, 191, 191, 190, 190, 190, 190, 190, 190, 190, 190, 190, 190, 169, 169, 169, 169, 169, 169, 169, 169, 168, 168, 167, 167, 166, 166, 166, 166, 166, 166, 166, 166, 166, 166, 168, 168, 168, 168, 168, 168, 168, 168, 167, 167, 168, 168, 167, 167, 167, 167, 167, 167, 167, 167, 167, 167, 170, 170, 170, 170, 170, 170, 170, 170, 169, 169, 169, 169, 168, 168, 168, 168, 168, 168, 168, 168, 168, 168, 171, 171, 171, 171, 171, 171, 171, 171, 171, 171, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 169, 169, 169, 169, 169, 169, 169, 169, 169, 169, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 169, 169, 169, 169, 169, 169, 169, 169, 169, 169, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170, 170]
			let tmp = h264Zeros(640)
			let tmp16 int16[]
			tmp16.len(21 * 16)
			for let fy = 0; fy < 4; fy++ {
				let want byte[]
				want.len(256)
				let got byte[]
				got.len(256)
				h264Qpel(s, 2 * 22 + 2, 22, 2, fy, 16, 8, want, 0, 16, tmp, 255)
				h264QpelBytes(s, 2 * 22 + 2, 22, 2, fy, 16, 8, got, 0, 16, tmp, tmp16, 255)
				fail "smooth fy={fy}: {want[0:16]} vs {got[0:16]}" unless got.equals(want)
			}
		}

		@test()
		def TestFilterEdgeBytesMatchesGeneric() !none {
			let x = 4242
			let strengths = int[][int[0, 1, 2, 3], int[2, 2, 2, 2], int[4, 4, 4, 4], int[0, 0, 0, 0], int[1, 0, 3, 0], int[4, 3, 4, 3]]
			for let round = 0; round < 60; round++ {
				// A smooth 32 x 16 area with noise and a step at row 8.
				let plane byte[]
				plane.len(32 * 16)
				let step = (round % 5) * 6
				for let i = 0; i < plane.len(); i++ {
					x = (x * 1103515245 + 12345) & 0x7fffffff
					let noise = ((x >> 16) % (round % 3 == 0 ?? (3, 9))) - 2
					let v = 120 + noise + (i >= 8 * 32 ?? (step, 0)) + (round % 7 == 0 ?? (130, 0))
					plane[i] = byte(v.max(0).min(255))
				}
				for let (_, bs) in strengths {
					for let (_, index) in int[20, 30, 40, 51] {
						let want = plane.clone()
						let got = plane.clone()
						h264FilterEdge(want, 8 * 32 + 8, 32, 1, 16, bs, index, index - 2, false, 0, 255)
						h264FilterEdgeBytes(got, 8 * 32 + 8, 32, 1, 16, bs, index, index - 2, false, 0, 255)
						fail "edge round {round} bs {bs} index {index}" unless got.equals(want)
						// The vertical edge at column 8 of the transposed area.
						let t = plane.clone()
						for let r = 0; r < 16; r++ {
							for let c = 0; c < 32; c++ {
								t[r * 32 + c] = plane[c * 32 + r] when c < 16
							}
						}
						let wantV = t.clone()
						let gotV = t.clone()
						h264FilterEdge(wantV, 8, 1, 32, 16, bs, index, index - 2, false, 0, 255)
						h264FilterEdgeBytes(gotV, 8, 1, 32, 16, bs, index, index - 2, false, 0, 255)
						fail "vertical edge round {round} bs {bs} index {index}" unless gotV.equals(wantV)
						// Eight chroma lines across both edges.
						let wantC = plane.clone()
						let gotC = plane.clone()
						h264FilterEdge(wantC, 8 * 32 + 8, 32, 1, 8, bs, index, index - 2, true, 0, 255)
						h264FilterEdgeBytes(gotC, 8 * 32 + 8, 32, 1, 8, bs, index, index - 2, true, 0, 255)
						fail "chroma edge round {round} bs {bs} index {index}" unless gotC.equals(wantC)
						let wantCV = t.clone()
						let gotCV = t.clone()
						h264FilterEdge(wantCV, 8, 1, 32, 8, bs, index, index - 2, true, 0, 255)
						h264FilterEdgeBytes(gotCV, 8, 1, 32, 8, bs, index, index - 2, true, 0, 255)
						fail "chroma vertical edge round {round} bs {bs} index {index}" unless gotCV.equals(wantCV)
					}
				}
			}
		}
	}
}
