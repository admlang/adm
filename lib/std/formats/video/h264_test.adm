	// A video track of the given codec setup bytes.
	def h264TestTrack(config byte[]) Track {
		return Track{index: 0, kind: TrackKind.Video, codec: "h264", config: config}
	}

	// Decodes a base64 Annex B stream cut into packets of `chunk` bytes, or
	// in one packet when `chunk` is 0.
	def h264TestDecode(stream string, chunk int = 0) !VideoFrame[] {
		let data = try encoding.base64decode(stream)
		let dec = new H264()
		try dec.configure(h264TestTrack(byte[]))
		let frames = VideoFrame[]
		let p = 0
		for p < data.len() {
			let n = chunk > 0 ?? (chunk, data.len())
			n = data.len() - p when p + n > data.len()
			let got = try dec.decode(Packet{track: 0, data: data[p:p + n]})
			for let f in got {
				frames.push(f)
			}
			p += n
		}
		let rest = try dec.flush()
		for let f in rest {
			frames.push(f)
		}
		return frames
	}

	def h264TestMd5(f VideoFrame) string {
		let h = new hash.MD5()
		return encoding.hexencode(h.hash(f.y + f.u + f.v))
	}

	// Whether the frames hash to `want`, in order.
	def h264TestMatches(frames VideoFrame[], want string[]) bool {
		return false when frames.len() != want.len()
		for let i = 0; i < frames.len(); i++ {
			return false when h264TestMd5(frames[i]) != want[i]
		}
		return true
	}

	// The offsets of the NAL units of an Annex B stream, as start and end
	// pairs.
	def h264TestNals(data byte[]) int[] {
		let out = int[]
		let starts = int[]
		for let i = 0; i + 2 < data.len(); i++ {
			starts.push(i + 3) when data[i] == byte(0) && data[i + 1] == byte(0) && data[i + 2] == byte(1)
		}
		for let k = 0; k < starts.len(); k++ {
			let end = k + 1 < starts.len() ?? (starts[k + 1] - 3, data.len())
			for end > starts[k] && data[end - 1] == byte(0) {
				end--
			}
			out.push(starts[k])
			out.push(end)
		}
		return out
	}

	check "H264" {
		@test()
		def TestH264Baseline() {
			let frames = h264TestDecode(h264TestBaseline) onerror recover VideoFrame[]
			assert h264TestMatches(frames, h264TestBaselineMd5)
		}

		@test()
		def TestH264MainCabac() {
			let frames = h264TestDecode(h264TestMainCabac) onerror recover VideoFrame[]
			assert h264TestMatches(frames, h264TestMainCabacMd5)
		}

		@test()
		def TestH264High8x8() {
			let frames = h264TestDecode(h264TestHigh8x8) onerror recover VideoFrame[]
			assert h264TestMatches(frames, h264TestHigh8x8Md5)
		}

		@test()
		def TestH264HighCavlc() {
			let frames = h264TestDecode(h264TestHighCavlc) onerror recover VideoFrame[]
			assert h264TestMatches(frames, h264TestHighCavlcMd5)
		}

		@test()
		def TestH264Slices() {
			let frames = h264TestDecode(h264TestSlices) onerror recover VideoFrame[]
			assert h264TestMatches(frames, h264TestSlicesMd5)
		}

		@test()
		def TestH264WeightedPrediction() {
			let frames = h264TestDecode(h264TestWeighted) onerror recover VideoFrame[]
			assert h264TestMatches(frames, h264TestWeightedMd5)
		}

		@test()
		def TestH264TemporalDirect() {
			let frames = h264TestDecode(h264TestTemporal) onerror recover VideoFrame[]
			assert h264TestMatches(frames, h264TestTemporalMd5)
		}

		@test()
		def TestH264Cropping() {
			let frames = h264TestDecode(h264TestCropped) onerror recover VideoFrame[]
			assert h264TestMatches(frames, h264TestCroppedMd5)
			assert frames[0].width == uint32(60)
			assert frames[0].height == uint32(44)
			assert frames[0].yStride == 60
			assert frames[0].uvStride == 30
			assert frames[0].y.len() == 60 * 44
			assert frames[0].u.len() == 30 * 22
		}

		@test()
		def TestH264ElementaryStream() !none {
			let v = try open(try encoding.base64decode(h264TestScaling))
			let info = v.info()
			assert info.container == "es" && info.codec == "h264" && info.width == 64 && info.height == 48
			let stream = try v.frames()
			let frames VideoFrame[]
			for {
				let got = try stream.next()
				break when got is none
				let f VideoFrame = got
				frames.push(f)
			}
			assert h264TestMatches(frames, h264TestScalingMd5)
		}

		@test()
		def TestH264ScalingMatrices() {
			let frames = h264TestDecode(h264TestScaling) onerror recover VideoFrame[]
			assert h264TestMatches(frames, h264TestScalingMd5)
		}

		@test()
		def TestH264AnnexBPackets() {
			// Packets that split NAL units and start codes anywhere.
			for let chunk in int[1, 7, 97, 500] {
				let frames = h264TestDecode(h264TestMainCabac, chunk) onerror recover VideoFrame[]
				assert h264TestMatches(frames, h264TestMainCabacMd5)
			}
		}

		@test()
		def TestH264FrameInfo() {
			let frames = h264TestDecode(h264TestMainCabac) onerror recover VideoFrame[]
			assert frames.len() == 8
			assert frames[0].keyframe
			assert !frames[1].keyframe
			assert frames[0].matrix == 601
			for let i = 0; i < frames.len(); i++ {
				assert frames[i].time == duration(int64(i) * 40000000)
				assert frames[i].length == 40ms
			}
		}

		@test()
		def TestH264Avcc() {
			let data = encoding.base64decode(h264TestBaseline) onerror recover byte[]
			let nals = h264TestNals(data)
			let sps = byte[]
			let pps = byte[]
			for let k = 0; k < nals.len(); k += 2 {
				let t = int(data[nals[k]]) & 31
				if t == 7 {
					sps = data[nals[k]:nals[k + 1]].clone()
				} else if t == 8 {
					pps = data[nals[k]:nals[k + 1]].clone()
				}
			}
			let config = byte[1, sps[1], sps[2], sps[3], 0xff, 0xe1, byte(sps.len() >> 8), byte(sps.len() & 255)] + sps + byte[1, byte(pps.len() >> 8), byte(pps.len() & 255)] + pps
			let dec = new H264()
			let configured = true
			dec.configure(h264TestTrack(config)) onerror (err error) {
				configured = false
				recover none
			}
			assert configured
			let frames = VideoFrame[]
			let pts = 0s
			for let k = 0; k < nals.len(); k += 2 {
				let t = int(data[nals[k]]) & 31
				continue unless t := 1 || 5
				let n = nals[k + 1] - nals[k]
				let packet = byte[byte(n >> 24), byte((n >> 16) & 255), byte((n >> 8) & 255), byte(n & 255)] + data[nals[k]:nals[k + 1]]
				let got = dec.decode(Packet{track: 0, data: packet, pts: pts, length: 40ms, keyframe: t == 5}) onerror recover VideoFrame[]
				for let f in got {
					frames.push(f)
				}
				pts = pts + 40ms
			}
			let rest = dec.flush() onerror recover VideoFrame[]
			for let f in rest {
				frames.push(f)
			}
			assert h264TestMatches(frames, h264TestBaselineMd5)
			assert frames[3].time == 120ms
		}

		@test()
		def TestH264Monochrome() {
			let frames = h264TestDecode(h264TestMono) onerror recover VideoFrame[]
			assert h264TestMatches(frames, h264TestMonoMd5)
			assert frames[0].chroma == ChromaLayout.Mono
			assert frames[0].u.len() == 0 && frames[0].v.len() == 0 && frames[0].uvStride == 0
		}

		@test()
		def TestH264Yuv444() {
			let frames = h264TestDecode(h264Test444) onerror recover VideoFrame[]
			assert h264TestMatches(frames, h264Test444Md5)
			assert frames[0].chroma == ChromaLayout.Yuv444 && frames[0].uvStride == frames[0].yStride
		}

		@test()
		def TestH264Yuv444Cavlc() {
			let frames = h264TestDecode(h264Test444Cavlc, 97) onerror recover VideoFrame[]
			assert h264TestMatches(frames, h264Test444CavlcMd5)
			assert frames[0].width == 72 && frames[0].height == 40 && frames[0].u.len() == 72 * 40
		}

		@test()
		def TestH264Yuv422Cavlc() {
			let frames = h264TestDecode(h264Test422Cavlc, 97) onerror recover VideoFrame[]
			assert h264TestMatches(frames, h264Test422CavlcMd5)
			assert frames[0].chroma == ChromaLayout.Yuv422 && frames[0].uvStride == 36 && frames[0].u.len() == 36 * 40
		}

		@test()
		def TestH264Yuv422Cabac() {
			let frames = h264TestDecode(h264Test422Cabac) onerror recover VideoFrame[]
			assert h264TestMatches(frames, h264Test422CabacMd5)
		}

		@test()
		def TestH264RecoveryPoint() {
			let frames = h264TestDecode(h264TestRecovery) onerror recover VideoFrame[]
			assert h264TestMatches(frames, h264TestRecoveryMd5)
		}

		@test()
		def TestH264FieldPictures() {
			let frames = h264TestDecode(h264TestFields) onerror recover VideoFrame[]
			assert h264TestMatches(frames, h264TestFieldsMd5)
			let chunked = h264TestDecode(h264TestFields, 700) onerror recover VideoFrame[]
			assert h264TestMatches(chunked, h264TestFieldsMd5)
		}

		@test()
		def TestH264MbaffCabac() {
			let frames = h264TestDecode(h264TestMbaffCabac) onerror recover VideoFrame[]
			assert h264TestMatches(frames, h264TestMbaffCabacMd5)
		}

		@test()
		def TestH264HighBitDepth() {
			let streams = string[h264TestDeep420, h264TestDeep422, h264TestDeep444, h264TestDeepMbaff]
			let md5s = string[][h264TestDeep420Md5, h264TestDeep422Md5, h264TestDeep444Md5, h264TestDeepMbaffMd5]
			for let i = 0; i < streams.len(); i++ {
				let frames = h264TestDecode(streams[i]) onerror recover VideoFrame[]
				assert h264TestMatches(frames, md5s[i])
				assert frames.len() > 0 && frames[0].bitDepth == 10 && frames[0].yStride == 128
			}
		}

		@test()
		def TestH264MbaffCavlc() {
			let frames = h264TestDecode(h264TestMbaffCavlc) onerror recover VideoFrame[]
			assert h264TestMatches(frames, h264TestMbaffCavlcMd5)
			let chunked = h264TestDecode(h264TestMbaffCavlc, 500) onerror recover VideoFrame[]
			assert h264TestMatches(chunked, h264TestMbaffCavlcMd5)
		}

		@test()
		def TestH264Lossless() {
			let frames = h264TestDecode(h264TestLossless444) onerror recover VideoFrame[]
			assert h264TestMatches(frames, h264TestLossless444Md5)
			let plain = h264TestDecode(h264TestLossless420, 31) onerror recover VideoFrame[]
			assert h264TestMatches(plain, h264TestLossless420Md5)
		}

		@test()
		def TestH264Yuv444Cabac() {
			let frames = h264TestDecode(h264Test444Cabac) onerror recover VideoFrame[]
			assert h264TestMatches(frames, h264Test444CabacMd5)
		}
	}
}
