partial module std.formats.video {
	use (
		std.testing
		std.data.encoding
		std.formats.video.h264::*
		std.formats.video.hardware::*
	)

	// Decodes a base64 Annex B stream with the H.264 decoder, on the CPU when
	// `software`, else wherever ADM_VIDEO_HW and the machine put it, keeping
	// the pictures on the GPU when `onGpu`. Returns the frames and what the
	// GPU did.
	def hwTestDecode(stream string, software bool, onGpu bool = false) !(VideoFrame[], VideoHardware) {
		let data = try encoding.base64decode(stream)
		let core = new H264Decoder()
		core.hw.gpu.gpuOutput = onGpu
		if software {
			core.hw.gpu.disabled = true
			core.hw.gpu.why = "forced"
		}
		try core.configure(byte[])
		try core.packet(data, 0s, 0s)
		let frames = core.take()
		try core.flush()
		for let f in core.take() {
			frames.push(f)
		}
		return (frames, core.hardware())
	}

	check "Hardware video decoding" {
		@test()
		def TestGpuMatchesSoftware() !none {
			// On a machine with NVDEC or VA-API the 8-bit 4:2:0 streams decode
			// on the GPU and must give the software decoder's pictures; on one
			// without, both runs are software.
			let streams = string[h264TestBaseline, h264TestMainCabac, h264TestHigh8x8, h264TestHighCavlc, h264TestSlices, h264TestWeighted, h264TestTemporal, h264TestCropped, h264TestScaling, h264TestRecovery, h264TestFields, h264TestMbaffCabac, h264TestMbaffCavlc]
			let sums = string[][h264TestBaselineMd5, h264TestMainCabacMd5, h264TestHigh8x8Md5, h264TestHighCavlcMd5, h264TestSlicesMd5, h264TestWeightedMd5, h264TestTemporalMd5, h264TestCroppedMd5, h264TestScalingMd5, h264TestRecoveryMd5, h264TestFieldsMd5, h264TestMbaffCabacMd5, h264TestMbaffCavlcMd5]
			for let i = 0; i < streams.len(); i++ {
				let (soft, softHw) = try hwTestDecode(streams[i], true)
				assert !softHw.decoding
				assert h264TestMatches(soft, sums[i])
				let (frames, hw) = try hwTestDecode(streams[i], false)
				assert h264TestMatches(frames, sums[i])
				if hw.decoding {
					assert hw.name := "NVDEC" || "VA-API"
					assert hw.reason == ""
				} else {
					assert hw.reason != ""
				}
			}
			return none
		}

		@test()
		def TestGpuFramesDownloadAsSoftware() !none {
			// Frames kept on the GPU give the software decoder's pictures once
			// downloaded; more frames than the decoder has buffers are held, so
			// the oldest are moved to main memory on the way.
			let streams = string[h264TestMainCabac, h264TestCropped, h264TestFields]
			let sums = string[][h264TestMainCabacMd5, h264TestCroppedMd5, h264TestFieldsMd5]
			for let i = 0; i < streams.len(); i++ {
				let (frames, hw) = try hwTestDecode(streams[i], false, true)
				for let f in frames {
					assert f.onGpu == !(f.gpu is none)
					assert f.onGpu == hw.decoding
					try download(f)
					assert !f.onGpu && f.gpu is none
				}
				assert h264TestMatches(frames, sums[i])
			}
			return none
		}

		@test()
		def TestStreamsTheGpuDoesNotTake() !none {
			let (_, chroma) = try hwTestDecode(h264Test422Cavlc, false)
			assert !chroma.decoding && chroma.reason == "the stream is not 4:2:0"
			let (_, deep) = try hwTestDecode(h264TestDeep420, false)
			assert !deep.decoding && deep.reason == "the stream is deeper than 8 bits"
			let (_, lossless) = try hwTestDecode(h264TestLossless420, false)
			assert !lossless.decoding && lossless.reason == "the stream is lossless"
			let (_, forced) = try hwTestDecode(h264TestBaseline, true)
			assert !forced.decoding && forced.reason == "forced"
			return none
		}

		@test()
		def TestSliceDataOffsetCountsEmulationBytes() {
			// A NAL header, then 00 00 03 01: the 03 is an emulation
			// prevention byte, so 4 unescaped bytes span 5 escaped ones.
			let nal = byte[0x65, 0x00, 0x00, 0x03, 0x01, 0xFF]
			assert h264RawBitOffset(nal, 0, nal.len(), 8 * 3) == 8 * 3
			assert h264RawBitOffset(nal, 0, nal.len(), 8 * 4) == 8 * 5
			assert h264RawBitOffset(nal, 0, nal.len(), 8 * 4 + 3) == 8 * 5 + 3
		}
	}
}
