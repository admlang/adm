partial module std.formats.video {
	use std.formats.video.hevc::*

	// HEVC decodes H.265 (HEVC) video in software: Main, Main 10, Main
	// Still Picture and the format range extensions (4:0:0, 4:2:2 and
	// 4:4:4 at up to 14 bits, transform skip extensions, implicit and
	// explicit RDPCM, cross-component prediction, persistent Rice
	// adaptation, chroma QP offset lists), with tiles, wavefronts,
	// dependent slices, weighted prediction and long-term references.
	//
	// Packets carry length-prefixed NAL units when the track's `config`
	// holds an hvcC record, Annex B byte streams otherwise. Frames come out
	// cropped, in output order, timed by the packet that started each
	// picture. RASL pictures of a random access point the stream starts or
	// restarts at are not shown; a reference that never came is made up
	// grey.
	//
	// Layers above the base layer are skipped; extended precision
	// processing, CABAC bypass alignment and 4:4:4 coded as separate colour
	// planes are refused with an error.
	@decoder("hevc")
	type HEVC {
		internal core HevcDecoder

		def new() {
			core = new HevcDecoder()
		}

		// configure implements VideoDecoder: reads the hvcC record in
		// `track.config`, or selects Annex B when it is empty. Fails on a
		// malformed record or unsupported parameter sets.
		def configure(track Track) !none {
			core = new HevcDecoder()
			core.trackWidth = int(track.width)
			core.trackHeight = int(track.height)
			try core.configure(track.config)
			return none
		}

		// decode implements VideoDecoder: decodes the NAL units of `packet`
		// and returns the frames whose output turn has come. Fails on a
		// malformed or unsupported stream.
		def decode(packet Packet) !VideoFrame[] {
			try core.packet(packet.data, packet.pts, packet.length)
			return core.take()
		}

		// flush implements VideoDecoder: decodes any buffered data and
		// returns every frame still held back. Fails on a malformed stream.
		def flush() !VideoFrame[] {
			try core.flush()
			return core.take()
		}
	}
}
