internal partial module std.formats.video.hevc {
	use std.simd

	// The 4x4 DST of intra luma blocks (8.6.4.2), basis by position.
	const hevcDst = int[29, 55, 74, 84, 74, 74, 0, -74, 84, -29, -74, 55, 55, -84, 74, -29]

	def hevcClip16(v int) int {
		return v < -32768 ?? (-32768, v > 32767 ?? (32767, v))
	}

	// The inverse transform matrix in 32-bit lanes, row by column, for
	// vector loads of its rows.
	def hevcTransformLanes() int32[] {
		let m int32[]
		m.len(32 * 32)
		for let i = 0; i < 32 * 32; i++ {
			m[i] = int32(hevcTransform[i])
		}
		return m
	}

	// Turns the dequantised coefficients `c` of an n x n block (n = 1 <<
	// `log2`, raster order) into residuals in place (8.6.4.2): columns, a
	// 16-bit clip, then rows. `maxX` and `maxY` bound the non-zero
	// coefficients; `dst` selects the 4x4 DST. `tmp` holds n * n values,
	// `m` is `hevcTransformLanes`. Blocks of 8 and more run eight columns
	// or samples at a time.
	def hevcInverseTransform(c int32[], log2 int, maxX int, maxY int, dst bool, bitDepth int, tmp int32[], m int32[]) {
		let n = 1 << log2
		let step = 5 - log2
		let shift2 = 20 - bitDepth
		let add2 = 1 << (shift2 - 1)
		if n == 4 {
			for let x = 0; x <= maxX; x++ {
				for let y = 0; y < 4; y++ {
					let sum = 0
					for let k = 0; k <= maxY; k++ {
						let t = dst ?? (hevcDst[k * 4 + y], hevcTransform[(k << 3) * 32 + y])
						sum += t * int(c[k * 4 + x])
					}
					tmp[y * 4 + x] = int32(hevcClip16((sum + 64) >> 7))
				}
			}
			for let y = 0; y < 4; y++ {
				for let x = 0; x < 4; x++ {
					let sum = 0
					for let k = 0; k <= maxX; k++ {
						let t = dst ?? (hevcDst[k * 4 + x], hevcTransform[(k << 3) * 32 + x])
						sum += t * int(tmp[y * 4 + k])
					}
					c[y * 4 + x] = int32(hevcClip16((sum + add2) >> shift2))
				}
			}
			return
		}
		let lo = simd.splat8<int32>(int32(-32768))
		let hi = simd.splat8<int32>(int32(32767))
		let r1 = simd.splat8<int32>(int32(64))
		let r2 = simd.splat8<int32>(int32(add2))
		// Columns, eight at a time: row y of the output is the sum of the
		// coefficient rows weighted by the basis values at y.
		for let xg = 0; xg <= maxX; xg += 8 {
			for let y = 0; y < n; y++ {
				let acc = simd.splat8<int32>(int32(0))
				for let k = 0; k <= maxY; k++ {
					acc += simd.splat8<int32>(int32(hevcTransform[(k << step) * 32 + y])) * simd.load8<int32>(c, k * n + xg)
				}
				simd.store8<int32>(tmp, y * n + xg, simd.clamp((acc + r1) >> 7, lo, hi))
			}
		}
		// Rows, eight samples at a time: the basis rows weighted by the
		// column results.
		for let y = 0; y < n; y++ {
			let row = y * n
			for let xg = 0; xg < n; xg += 8 {
				let acc = simd.splat8<int32>(int32(0))
				for let k = 0; k <= maxX; k++ {
					acc += simd.splat8<int32>(tmp[row + k]) * simd.load8<int32>(m, (k << step) * 32 + xg)
				}
				simd.store8<int32>(c, row + xg, simd.clamp((acc + r2) >> shift2, lo, hi))
			}
		}
	}

	// The residuals of a transform-skipped block (8.6.4.2 with
	// transform_skip_flag): the coefficients scaled to the residual range.
	// `rotate` turns a 4x4 block by 180 degrees first.
	def hevcTransformSkip(c int32[], log2 int, bitDepth int, rotate bool) {
		let n = 1 << log2
		if rotate {
			for let i = 0; i < 8; i++ {
				let t = c[i]
				c[i] = c[15 - i]
				c[15 - i] = t
			}
		}
		let tsShift = 5 + log2
		let bdShift = 20 - bitDepth
		for let i = 0; i < n * n; i++ {
			c[i] = int32(((int(c[i]) << tsShift) + (1 << (bdShift - 1))) >> bdShift)
		}
	}

	// Residual DPCM (8.6.8): each residual adds the one left of it
	// (`vertical` false) or above it.
	def hevcRdpcm(c int32[], log2 int, vertical bool) {
		let n = 1 << log2
		if vertical {
			for let y = 1; y < n; y++ {
				for let x = 0; x < n; x++ {
					c[y * n + x] += c[(y - 1) * n + x]
				}
			}
			return
		}
		for let y = 0; y < n; y++ {
			for let x = 1; x < n; x++ {
				c[y * n + x] += c[y * n + x - 1]
			}
		}
	}

	// Adds the n x n residuals `c` to the samples at `at` of `plane`,
	// clipped to `bitDepth`.
	def hevcAddResidual(plane uint16[], at int, stride int, c int32[], log2 int, bitDepth int) {
		let n = 1 << log2
		let top = (1 << bitDepth) - 1
		if n == 4 {
			for let y = 0; y < 4; y++ {
				let o = at + y * stride
				for let x = 0; x < 4; x++ {
					let v = int(plane[o + x]) + int(c[y * 4 + x])
					plane[o + x] = uint16(v < 0 ?? (0, v > top ?? (top, v)))
				}
			}
			return
		}
		let lo = simd.splat8<int32>(int32(0))
		let hi = simd.splat8<int32>(int32(top))
		for let y = 0; y < n; y++ {
			let o = at + y * stride
			for let x = 0; x < n; x += 8 {
				let v = simd.convert<uint16, int32>(simd.load8<uint16>(plane, o + x)) + simd.load8<int32>(c, y * n + x)
				simd.store8<uint16>(plane, o + x, simd.convert<int32, uint16>(simd.clamp(v, lo, hi)))
			}
		}
	}
}
