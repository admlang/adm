internal partial module std.formats.video.hevc {
	use std.formats.video.h264::(H264Cabac)

	const hevcModeInter = 0
	const hevcModeIntra = 1
	const hevcModeSkip = 2

	const hevcPart2Nx2N = 0
	const hevcPart2NxN = 1
	const hevcPartNx2N = 2
	const hevcPartNxN = 3
	const hevcPart2NxnU = 4
	const hevcPart2NxnD = 5
	const hevcPartnLx2N = 6
	const hevcPartnRx2N = 7

	const hevcScanDiag = 0
	const hevcScanHoriz = 1
	const hevcScanVert = 2

	// The chroma intra modes intra_chroma_pred_mode 0-3 name.
	const hevcChromaModes = int[0, 26, 10, 1]

	// HevcCtu decodes the coding tree units of the slice segments of one
	// picture (7.3.8, 8.4-8.6): CABAC syntax, prediction and residuals,
	// and what the in-loop filters need (boundary strengths, QPs, SAO
	// parameters).
	type HevcCtu {
		sps            HevcSps
		pps            HevcPps
		sh             HevcSliceHeader
		pic            HevcPicture
		cabac          H264Cabac
		intra          HevcIntra
		inter          HevcInter
		coeffs         int32[]
		tmp            int32[]
		lumaRes        int32[]
		// hevcTransformLanes.
		tmatrix        int32[]
		// Reference pictures of the current slice, list 0 then list 1 (16
		// each), and the collocated picture.
		refs           HevcPicture[]
		colPic         HevcPicture
		curSlice       int
		// Per minimum coding block: coding tree depth, skip flag, QpY.
		ctDepth        byte[]
		skipMap        byte[]
		qpMap          int[]
		// Per 4x4 block: luma intra mode, deblocking/SAO bypass, whether
		// the transform block has luma coefficients, and the boundary
		// strengths of its left and top edges.
		ipm            byte[]
		noFilter       byte[]
		cbf            byte[]
		bsV            byte[]
		bsH            byte[]
		// Per CTB: SliceAddrRs (-1 until decoded), the deblocking offsets
		// and slice flags of its slice, and the SAO parameters (type, band
		// position, edge class, offsets 0-4, per component).
		sliceAddr      int[]
		ctbBeta        int[]
		ctbTc          int[]
		ctbAcross      bool[]
		saoType        int[]
		saoBand        int[]
		saoEo          int[]
		saoOffset      int[]
		sliceAddrRs    int
		// QP state (8.6.1).
		qpY            int
		qpYPred        int
		lastQpY        int
		cuQpDeltaCoded bool
		cuQpDelta      int
		cuChromaCoded  bool
		cuQpOffsetCb   int
		cuQpOffsetCr   int
		// The coding unit being decoded.
		cuX            int
		cuY            int
		cuLog2         int
		predMode       int
		partMode       int
		bypass         bool
		intraSplit     bool
		maxTrafoDepth  int
		depth          int
		mergeFlag      bool
		puMode         int[]
		puModeC        int[]
		puChroma       int[]
		tuMode         int
		tuModeC        int
		tuChroma       int
		resScale       int
		crossPf        bool
		statCoeff      int[]
		// WPP storage of the contexts after the second CTB of a row.
		wppCtx         int[]
		wppStat        int[]
		// Residual scratch: coded groups, significant positions, flags.
		sigGroup       int[]
		sigIdx         int[]
		gt1            int[]
		// Motion of the current PU and the merge candidates (flags, mv x/y
		// of both lists, reference indices).
		mPred          int
		mMv            int[]
		mRef           int[]
		cPred          int[]
		cMv            int[]
		cRef           int[]
		mvdX           int
		mvdY           int
		// Temporal candidate output.
		tmvX           int
		tmvY           int
		// Whether every reference of the current slice precedes it in
		// output order.
		noBackward     bool
		// The picture size this state was allocated for.
		allocW         int
		allocH         int
		allocCtb       int

		def new() {
			cabac = new H264Cabac()
			intra = new HevcIntra()
			inter = new HevcInter()
			coeffs.len(32 * 32)
			tmp.len(32 * 32)
			lumaRes.len(32 * 32)
			tmatrix = hevcTransformLanes()
			puMode.len(4)
			puModeC.len(4)
			puChroma.len(4)
			statCoeff.len(4)
			wppCtx.len(hevcContexts)
			wppStat.len(4)
			sigGroup.len(64)
			sigIdx.len(16)
			gt1.len(8)
			mMv.len(4)
			mRef.len(2)
			cPred.len(5)
			cMv.len(20)
			cRef.len(10)
		}

		// Readies the per-picture maps for `p` decoded with `s`.
		def startPicture(s HevcSps, p HevcPicture) {
			sps = s
			pic = p
			let cbs = s.minCbWidth * s.minCbHeight
			let n = p.w4 * p.h4
			let ctbs = s.ctbWidth * s.ctbHeight
			if allocW != s.width || allocH != s.height || allocCtb != s.log2CtbSize || ctDepth.len() != cbs {
				ctDepth.len(cbs)
				skipMap.len(cbs)
				qpMap.len(cbs)
				ipm.len(n)
				noFilter.len(n)
				cbf.len(n)
				bsV.len(n)
				bsH.len(n)
				sliceAddr.len(ctbs)
				ctbBeta.len(ctbs)
				ctbTc.len(ctbs)
				ctbAcross.len(ctbs)
				saoType.len(ctbs * 3)
				saoBand.len(ctbs * 3)
				saoEo.len(ctbs * 3)
				saoOffset.len(ctbs * 15)
				allocW = s.width
				allocH = s.height
				allocCtb = s.log2CtbSize
			}
			sliceAddr.fill(-1)
			noFilter.fill(byte(0))
			bsV.fill(byte(0))
			bsH.fill(byte(0))
			saoType.fill(0)
		}

		// Whether luma sample (xN, yN) is decoded, in the slice and tile of
		// (xC, yC), and before it (6.4.1).
		def available(xC int, yC int, xN int, yN int) bool {
			let s = sps
			return false when xN < 0 || yN < 0 || xN >= s.width || yN >= s.height
			let l = s.log2CtbSize
			let cC = (yC >> l) * s.ctbWidth + (xC >> l)
			let cN = (yN >> l) * s.ctbWidth + (xN >> l)
			if cN != cC {
				let tsN = pps.rsToTs[cN]
				let tsC = pps.rsToTs[cC]
				return false when tsN > tsC || sliceAddr[cN] != sliceAddr[cC]
				return pps.tileId[tsN] == pps.tileId[tsC]
			}
			let t = s.log2MinTbSize
			let m = s.tbMask
			return pps.zs(s, (xN >> t) & m, (yN >> t) & m) <= pps.zs(s, (xC >> t) & m, (yC >> t) & m)
		}

		// The 4x4 block index of luma sample (x, y).
		def at4(x int, y int) int {
			return (y >> 2) * pic.w4 + (x >> 2)
		}

		// Initialises the contexts for the slice (9.3.2.2).
		def initContexts() {
			let initType = 2 - sh.sliceType
			initType = initType ^ 3 when sh.cabacInit && sh.sliceType != hevcSliceI
			let q = sh.qp < 0 ?? (0, sh.qp > 51 ?? (51, sh.qp))
			let base = initType * hevcContexts
			for let i = 0; i < hevcContexts; i++ {
				let iv = hevcCabacInit[base + i]
				let m = (iv >> 4) * 5 - 45
				let n = ((iv & 15) << 3) - 16
				let pre = ((m * q) >> 4) + n
				pre = pre < 1 ?? (1, pre > 126 ?? (126, pre))
				cabac.ctx[i] = pre <= 63 ?? ((63 - pre) << 1, ((pre - 64) << 1) | 1)
			}
			statCoeff.fill(0)
		}

		// Restores the contexts saved after the CTB above-right of the one
		// at (x0, y0) when that CTB is available (9.3.2.4).
		def syncWpp(x0 int, y0 int) {
			return unless available(x0, y0, x0 + sps.ctbSize, y0 - sps.ctbSize)
			for let i = 0; i < hevcContexts; i++ {
				cabac.ctx[i] = wppCtx[i]
			}
			for let i = 0; i < 4; i++ {
				statCoeff[i] = wppStat[i]
			}
		}

		// Decodes the CTUs of one slice segment whose data is
		// `data[start:end]` (RBSP bytes).
		//
		// Fails on malformed data.
		def decodeSegment(data byte[], start int, end int) !none {
			let s = sps
			let p = pps
			let l = s.log2CtbSize
			let count = s.ctbWidth * s.ctbHeight
			let ts = p.rsToTs[sh.address]
			if !sh.dependent {
				sliceAddrRs = sh.address
				lastQpY = sh.qp
				cuQpOffsetCb = 0
				cuQpOffsetCr = 0
			}
			fail "hevc: slice data out of range" when start > end
			cabac.start(data, start, end)
			let first = true
			for {
				fail "hevc: slice runs past the picture" when ts >= count
				let rs = p.tsToRs[ts]
				let cx = rs % s.ctbWidth
				let cy = rs / s.ctbWidth
				let x0 = cx << l
				let y0 = cy << l
				fail "hevc: CTB decoded twice" when sliceAddr[rs] >= 0
				sliceAddr[rs] = sliceAddrRs
				pic.ctbSlice[rs] = curSlice
				ctbBeta[rs] = sh.betaOffset
				ctbTc[rs] = sh.tcOffset
				ctbAcross[rs] = sh.loopFilterAcrossSlices
				let tileStart = ts == 0 || p.tileId[ts] != p.tileId[ts - 1]
				let rowStart = p.entropySync && cx == p.colBd[p.colIdx[cx]]
				if first {
					if !sh.dependent || tileStart {
						initContexts()
					} else if rowStart {
						initContexts()
						syncWpp(x0, y0)
					}
					first = false
				} else if tileStart {
					initContexts()
				} else if rowStart {
					initContexts()
					syncWpp(x0, y0)
				}
				lastQpY = sh.qp when tileStart || rowStart
				saoSyntax(cx, cy, rs, x0, y0)
				try quadtree(x0, y0, l, 0)
				let last = cabac.terminate() == 1
				if p.entropySync && cx == p.colBd[p.colIdx[cx]] + 1 {
					for let i = 0; i < hevcContexts; i++ {
						wppCtx[i] = cabac.ctx[i]
					}
					for let i = 0; i < 4; i++ {
						wppStat[i] = statCoeff[i]
					}
				}
				ts++
				break when last
				fail "hevc: slice runs past the picture" when ts >= count
				let nrs = p.tsToRs[ts]
				let nx = nrs % s.ctbWidth
				if (p.tilesEnabled && p.tileId[ts] != p.tileId[ts - 1]) || (p.entropySync && nx == p.colBd[p.colIdx[nx]]) {
					fail "hevc: missing end_of_subset_one_bit" unless cabac.terminate() == 1
					cabac.start(data, cabac.alignedPosition(), end)
				}
			}
			return none
		}

		// sao() (7.3.8.3).
		def saoSyntax(cx int, cy int, rs int, x0 int, y0 int) {
			return unless sh.saoLuma || sh.saoChroma
			let from = -1
			if cx > 0 && available(x0, y0, x0 - 1, y0) && cabac.decision(hevcCtxSaoMerge) == 1 {
				from = rs - 1
			} else if cy > 0 && available(x0, y0, x0, y0 - sps.ctbSize) && cabac.decision(hevcCtxSaoMerge) == 1 {
				from = rs - sps.ctbWidth
			}
			let comps = sps.chromaFormat == 0 ?? (1, 3)
			if from >= 0 {
				for let c = 0; c < comps; c++ {
					saoType[rs * 3 + c] = saoType[from * 3 + c]
					saoBand[rs * 3 + c] = saoBand[from * 3 + c]
					saoEo[rs * 3 + c] = saoEo[from * 3 + c]
					for let i = 0; i < 5; i++ {
						saoOffset[rs * 15 + c * 5 + i] = saoOffset[from * 15 + c * 5 + i]
					}
				}
				saoType[rs * 3] = 0 unless sh.saoLuma
				if !sh.saoChroma {
					saoType[rs * 3 + 1] = 0
					saoType[rs * 3 + 2] = 0
				}
				return
			}
			let sampleDepth = sps.bitDepth
			for let c = 0; c < comps; c++ {
				let k = rs * 3 + c
				if (c == 0 && !sh.saoLuma) || (c > 0 && !sh.saoChroma) {
					saoType[k] = 0
					continue
				}
				if c == 2 {
					saoType[k] = saoType[k - 1]
					saoEo[k] = saoEo[k - 1]
				} else {
					let t = 0
					t = cabac.bypass() == 0 ?? (1, 2) when cabac.decision(hevcCtxSaoType) == 1
					saoType[k] = t
				}
				continue when saoType[k] == 0
				let bd = sampleDepth > 10 ?? (10, sampleDepth)
				let cmax = (1 << (bd - 5)) - 1
				let abs = int[0, 0, 0, 0]
				for let i = 0; i < 4; i++ {
					let v = 0
					for v < cmax && cabac.bypass() == 1 {
						v++
					}
					abs[i] = v
				}
				let scale = c == 0 ?? (pps.log2SaoOffsetScaleLuma, pps.log2SaoOffsetScaleChroma)
				saoOffset[rs * 15 + c * 5] = 0
				if saoType[k] == 1 {
					for let i = 0; i < 4; i++ {
						abs[i] = -abs[i] when abs[i] != 0 && cabac.bypass() == 1
					}
					let band = 0
					for let i = 0; i < 5; i++ {
						band = (band << 1) | cabac.bypass()
					}
					saoBand[k] = band
				} else {
					abs[2] = -abs[2]
					abs[3] = -abs[3]
					if c := 0 || 1 {
						saoEo[k] = (cabac.bypass() << 1) | cabac.bypass()
					}
				}
				for let i = 0; i < 4; i++ {
					saoOffset[rs * 15 + c * 5 + 1 + i] = abs[i] << scale
				}
			}
		}

		// coding_quadtree() (7.3.8.4).
		//
		// Fails on malformed data.
		def quadtree(x0 int, y0 int, log2 int, d int) !none {
			let s = sps
			let size = 1 << log2
			let split = log2 > s.log2MinCbSize
			if x0 + size <= s.width && y0 + size <= s.height && log2 > s.log2MinCbSize {
				let inc = 0
				if available(x0, y0, x0 - 1, y0) && int(ctDepth[(y0 >> s.log2MinCbSize) * s.minCbWidth + ((x0 - 1) >> s.log2MinCbSize)]) > d {
					inc++
				}
				if available(x0, y0, x0, y0 - 1) && int(ctDepth[((y0 - 1) >> s.log2MinCbSize) * s.minCbWidth + (x0 >> s.log2MinCbSize)]) > d {
					inc++
				}
				split = cabac.decision(hevcCtxSplitCu + inc) == 1
			}
			if log2 >= s.log2CtbSize - pps.diffCuQpDeltaDepth {
				cuQpDeltaCoded = false
				cuQpDelta = 0
				// qPY_PRED of the quantization group (8.6.1).
				let mask = s.ctbSize - 1
				let prev = lastQpY
				let a = prev
				let b = prev
				a = qpMap[(y0 >> s.log2MinCbSize) * s.minCbWidth + ((x0 - 1) >> s.log2MinCbSize)] when (x0 & mask) != 0
				b = qpMap[((y0 - 1) >> s.log2MinCbSize) * s.minCbWidth + (x0 >> s.log2MinCbSize)] when (y0 & mask) != 0
				qpYPred = (a + b + 1) >> 1
			}
			cuChromaCoded = false when sh.cuChromaQpOffset && log2 >= s.log2CtbSize - pps.diffCuChromaQpOffsetDepth
			if split {
				let half = size >> 1
				let x1 = x0 + half
				let y1 = y0 + half
				try quadtree(x0, y0, log2 - 1, d + 1)
				try quadtree(x1, y0, log2 - 1, d + 1) when x1 < s.width
				try quadtree(x0, y1, log2 - 1, d + 1) when y1 < s.height
				try quadtree(x1, y1, log2 - 1, d + 1) when x1 < s.width && y1 < s.height
				return none
			}
			depth = d
			try codingUnit(x0, y0, log2)
			return none
		}

		// Sets QpY from the prediction and CuQpDeltaVal (8.6.1).
		def updateQp() {
			let off = sps.qpBdOffset
			qpY = ((qpYPred + cuQpDelta + 52 + 2 * off) % (52 + off)) - off
		}

		// Fills the minimum-coding-block map `m` over the CU with `v`.
		def fillCb(m byte[], x0 int, y0 int, log2 int, v int) {
			let s = sps
			let n = (1 << log2) >> s.log2MinCbSize
			let xc = x0 >> s.log2MinCbSize
			let yc = y0 >> s.log2MinCbSize
			for let j = 0; j < n && yc + j < s.minCbHeight; j++ {
				for let i = 0; i < n && xc + i < s.minCbWidth; i++ {
					m[(yc + j) * s.minCbWidth + xc + i] = byte(v)
				}
			}
		}

		// Fills the 4x4 map `m` over the w x h block at (x0, y0) with `v`.
		def fill4(m byte[], x0 int, y0 int, w int, h int, v int) {
			let x4 = x0 >> 2
			let y4 = y0 >> 2
			let nw = (w + 3) >> 2
			let nh = (h + 3) >> 2
			let bv = byte(v)
			for let j = 0; j < nh; j++ {
				let o = (y4 + j) * pic.w4 + x4
				for let i = 0; i < nw; i++ {
					m[o + i] = bv
				}
			}
		}

		// coding_unit() (7.3.8.5).
		//
		// Fails on malformed data.
		def codingUnit(x0 int, y0 int, log2 int) !none {
			let s = sps
			let size = 1 << log2
			cuX = x0
			cuY = y0
			cuLog2 = log2
			predMode = hevcModeIntra
			partMode = hevcPart2Nx2N
			intraSplit = false
			mergeFlag = false
			for let i = 0; i < 4; i++ {
				puMode[i] = 1
			}
			updateQp()
			bypass = pps.transquantBypass && cabac.decision(hevcCtxTransquantBypass) == 1
			fill4(cbf, x0, y0, size, size, 0)
			let skip = false
			if sh.sliceType != hevcSliceI {
				let inc = 0
				inc++ when available(x0, y0, x0 - 1, y0) && skipMap[(y0 >> s.log2MinCbSize) * s.minCbWidth + ((x0 - 1) >> s.log2MinCbSize)] != byte(0)
				inc++ when available(x0, y0, x0, y0 - 1) && skipMap[((y0 - 1) >> s.log2MinCbSize) * s.minCbWidth + (x0 >> s.log2MinCbSize)] != byte(0)
				skip = cabac.decision(hevcCtxSkip + inc) == 1
			}
			fillCb(skipMap, x0, y0, log2, skip ?? (1, 0))
			if skip {
				predMode = hevcModeSkip
				fill4(ipm, x0, y0, size, size, 1)
				try predictionUnit(x0, y0, size, size, 0)
				strengths(x0, y0, log2) unless sh.deblockingDisabled
			} else {
				predMode = cabac.decision(hevcCtxPredMode) == 1 ?? (hevcModeIntra, hevcModeInter) when sh.sliceType != hevcSliceI
				if predMode != hevcModeIntra || log2 == s.log2MinCbSize {
					partMode = partModeSyntax(log2)
					intraSplit = partMode == hevcPartNxN && predMode == hevcModeIntra
				}
				let pcm = false
				if predMode == hevcModeIntra {
					fill4(pic.pred, x0, y0, size, size, hevcPredIntra)
					pcm = cabac.terminate() == 1 when partMode == hevcPart2Nx2N && s.pcmEnabled && log2 >= s.log2MinPcmSize && log2 <= s.log2MaxPcmSize
					if pcm {
						fill4(ipm, x0, y0, size, size, 1)
						try pcmSample(x0, y0, log2)
						fill4(noFilter, x0, y0, size, size, 1) when s.pcmLoopFilterDisabled
					} else {
						intraModes(x0, y0, log2)
					}
				} else {
					fill4(ipm, x0, y0, size, size, 1)
					let h = size >> 1
					let q = size >> 2
					match partMode {
						case 0:
							try predictionUnit(x0, y0, size, size, 0)
						case 1:
							try predictionUnit(x0, y0, size, h, 0)
							try predictionUnit(x0, y0 + h, size, h, 1)
						case 2:
							try predictionUnit(x0, y0, h, size, 0)
							try predictionUnit(x0 + h, y0, h, size, 1)
						case 4:
							try predictionUnit(x0, y0, size, q, 0)
							try predictionUnit(x0, y0 + q, size, size - q, 1)
						case 5:
							try predictionUnit(x0, y0, size, size - q, 0)
							try predictionUnit(x0, y0 + size - q, size, q, 1)
						case 6:
							try predictionUnit(x0, y0, q, size, 0)
							try predictionUnit(x0 + q, y0, size - q, size, 1)
						case 7:
							try predictionUnit(x0, y0, size - q, size, 0)
							try predictionUnit(x0 + size - q, y0, q, size, 1)
						default:
							try predictionUnit(x0, y0, h, h, 0)
							try predictionUnit(x0 + h, y0, h, h, 1)
							try predictionUnit(x0, y0 + h, h, h, 2)
							try predictionUnit(x0 + h, y0 + h, h, h, 3)
					}
				}
				if pcm {
					strengths(x0, y0, log2) unless sh.deblockingDisabled
				} else {
					let rqt = true
					rqt = cabac.decision(hevcCtxNoResidual) == 1 when predMode != hevcModeIntra && !(partMode == hevcPart2Nx2N && mergeFlag)
					if rqt {
						maxTrafoDepth = predMode == hevcModeIntra ?? (s.maxTrafoDepthIntra + (intraSplit ?? (1, 0)), s.maxTrafoDepthInter)
						try transformTree(x0, y0, x0, y0, log2, 0, 0, 0, 0, 0, 0)
					} else {
						strengths(x0, y0, log2) unless sh.deblockingDisabled
					}
				}
			}
			fill4(noFilter, x0, y0, size, size, 1) when bypass
			let n = size >> s.log2MinCbSize
			let xc = x0 >> s.log2MinCbSize
			let yc = y0 >> s.log2MinCbSize
			for let j = 0; j < n && yc + j < s.minCbHeight; j++ {
				for let i = 0; i < n && xc + i < s.minCbWidth; i++ {
					qpMap[(yc + j) * s.minCbWidth + xc + i] = qpY
				}
			}
			lastQpY = qpY
			fillCb(ctDepth, x0, y0, log2, depth)
			return none
		}

		// part_mode (9.3.4.2.? binarisation per ffmpeg's table).
		def partModeSyntax(log2 int) int {
			let s = sps
			return hevcPart2Nx2N when cabac.decision(hevcCtxPartMode) == 1
			if log2 == s.log2MinCbSize {
				return hevcPartNxN when predMode == hevcModeIntra
				return hevcPart2NxN when cabac.decision(hevcCtxPartMode + 1) == 1
				return hevcPartNx2N when log2 == 3
				return hevcPartNx2N when cabac.decision(hevcCtxPartMode + 2) == 1
				return hevcPartNxN
			}
			if !s.ampEnabled {
				return hevcPart2NxN when cabac.decision(hevcCtxPartMode + 1) == 1
				return hevcPartNx2N
			}
			if cabac.decision(hevcCtxPartMode + 1) == 1 {
				return hevcPart2NxN when cabac.decision(hevcCtxPartMode + 3) == 1
				return hevcPart2NxnD when cabac.bypass() == 1
				return hevcPart2NxnU
			}
			return hevcPartNx2N when cabac.decision(hevcCtxPartMode + 3) == 1
			return hevcPartnRx2N when cabac.bypass() == 1
			return hevcPartnLx2N
		}

		// pcm_sample() (7.3.8.7): raw samples after the aligned CABAC
		// position, then the engine restarts.
		//
		// Fails when the samples run past the slice data.
		def pcmSample(x0 int, y0 int, log2 int) !none {
			let s = sps
			let size = 1 << log2
			let data = cabac.data
			let pos = cabac.alignedPosition()
			let cw = s.chromaFormat == 0 ?? (0, size >> s.hshift[1])
			let ch = s.chromaFormat == 0 ?? (0, size >> s.vshift[1])
			let bits = size * size * s.pcmBitDepth + 2 * cw * ch * s.pcmBitDepthChroma
			fail "hevc: PCM samples run past the slice" when pos + ((bits + 7) >> 3) > cabac.end
			let bitPos = pos * 8
			let p = pic
			let shiftY = s.bitDepth - s.pcmBitDepth
			for let j = 0; j < size; j++ {
				for let i = 0; i < size; i++ {
					let v = hevcReadBits(data, bitPos, s.pcmBitDepth)
					bitPos += s.pcmBitDepth
					p.y[(y0 + j) * p.stride + x0 + i] = uint16(v << shiftY)
				}
			}
			if s.chromaFormat != 0 {
				let shiftC = s.bitDepthChroma - s.pcmBitDepthChroma
				let xc = x0 >> s.hshift[1]
				let yc = y0 >> s.vshift[1]
				for let c = 1; c <= 2; c++ {
					let plane = c == 1 ?? (p.u, p.v)
					for let j = 0; j < ch; j++ {
						for let i = 0; i < cw; i++ {
							let v = hevcReadBits(data, bitPos, s.pcmBitDepthChroma)
							bitPos += s.pcmBitDepthChroma
							plane[(yc + j) * p.cstride + xc + i] = uint16(v << shiftC)
						}
					}
				}
			}
			cabac.start(data, pos + ((bits + 7) >> 3), cabac.end)
			return none
		}

		// The intra modes of a coding unit: prev_intra_luma_pred_flag,
		// mpm_idx, rem_intra_luma_pred_mode and intra_chroma_pred_mode
		// (7.3.8.5, 8.4.2, 8.4.3).
		def intraModes(x0 int, y0 int, log2 int) {
			let s = sps
			let split = partMode == hevcPartNxN ?? (1, 0)
			let pb = (1 << log2) >> split
			let side = split + 1
			let prev = bool[false, false, false, false]
			for let i = 0; i < side * side; i++ {
				prev[i] = cabac.decision(hevcCtxPrevIntraLuma) == 1
			}
			for let i = 0; i < side; i++ {
				for let j = 0; j < side; j++ {
					let k = 2 * i + j
					let mpm = 0
					let rem = 0
					if prev[k] {
						mpm++ when cabac.bypass() == 1
						mpm++ when mpm == 1 && cabac.bypass() == 1
					} else {
						for let b = 0; b < 5; b++ {
							rem = (rem << 1) | cabac.bypass()
						}
					}
					puMode[k] = lumaMode(x0 + pb * j, y0 + pb * i, pb, prev[k], mpm, rem)
				}
			}
			if s.chromaFormat == 3 {
				for let k = 0; k < side * side; k++ {
					let cm = chromaModeSyntax()
					puChroma[k] = cm
					puModeC[k] = cm == 4 ?? (puMode[k], puMode[k] == hevcChromaModes[cm] ?? (34, hevcChromaModes[cm]))
				}
			} else if s.chromaFormat != 0 {
				let cm = chromaModeSyntax()
				puChroma[0] = cm
				let mode = cm == 4 ?? (puMode[0], puMode[0] == hevcChromaModes[cm] ?? (34, hevcChromaModes[cm]))
				puModeC[0] = s.chromaFormat == 2 ?? (hevcModeIdx422[mode], mode)
			}
		}

		def chromaModeSyntax() int {
			return 4 when cabac.decision(hevcCtxIntraChroma) == 0
			return (cabac.bypass() << 1) | cabac.bypass()
		}

		// The luma intra mode of the pb x pb block at (x0, y0) (8.4.2).
		def lumaMode(x0 int, y0 int, pb int, prevFlag bool, mpm int, rem int) int {
			let s = sps
			let a = 1
			let b = 1
			a = int(ipm[at4(x0 - 1, y0)]) when available(x0, y0, x0 - 1, y0)
			b = int(ipm[at4(x0, y0 - 1)]) when available(x0, y0, x0, y0 - 1) && y0 - 1 >= ((y0 >> s.log2CtbSize) << s.log2CtbSize)
			let c0 = a
			let c1 = b
			let c2 = 0
			if a == b {
				if a < 2 {
					c0 = 0
					c1 = 1
					c2 = 26
				} else {
					c1 = 2 + ((a - 2 - 1 + 32) & 31)
					c2 = 2 + ((a - 2 + 1) & 31)
				}
			} else if a != 0 && b != 0 {
				c2 = 0
			} else if a != 1 && b != 1 {
				c2 = 1
			} else {
				c2 = 26
			}
			let mode = 0
			if prevFlag {
				mode = mpm == 0 ?? (c0, mpm == 1 ?? (c1, c2))
			} else {
				if c0 > c1 {
					let t = c0
					c0 = c1
					c1 = t
				}
				if c0 > c2 {
					let t = c0
					c0 = c2
					c2 = t
				}
				if c1 > c2 {
					let t = c1
					c1 = c2
					c2 = t
				}
				mode = rem
				mode++ when mode >= c0
				mode++ when mode >= c1
				mode++ when mode >= c2
			}
			fill4(ipm, x0, y0, pb, pb, mode)
			return mode
		}

		// transform_tree() (7.3.8.8).
		//
		// Fails on malformed data.
		def transformTree(x0 int, y0 int, xBase int, yBase int, log2 int, d int, blk int, pcb0 int, pcb1 int, pcr0 int, pcr1 int) !none {
			let s = sps
			if intraSplit {
				if d == 1 {
					tuMode = puMode[blk]
					let k = s.chromaFormat == 3 ?? (blk, 0)
					tuModeC = puModeC[k]
					tuChroma = puChroma[k]
				}
			} else {
				tuMode = puMode[0]
				tuModeC = puModeC[0]
				tuChroma = puChroma[0]
			}
			let split = false
			if log2 <= s.log2MaxTrafoSize && log2 > s.log2MinTbSize && d < maxTrafoDepth && !(intraSplit && d == 0) {
				split = cabac.decision(hevcCtxSplitTransform + 5 - log2) == 1
			} else {
				let interSplit = s.maxTrafoDepthInter == 0 && predMode == hevcModeInter && partMode != hevcPart2Nx2N && d == 0
				split = log2 > s.log2MaxTrafoSize || (intraSplit && d == 0) || interSplit
			}
			let cb0 = pcb0
			let cb1 = pcb1
			let cr0 = pcr0
			let cr1 = pcr1
			if s.chromaFormat != 0 && (log2 > 2 || s.chromaFormat == 3) {
				let two = s.chromaFormat == 2 && (!split || log2 == 3)
				if d == 0 || pcb0 != 0 {
					cb0 = cabac.decision(hevcCtxCbfChroma + d)
					cb1 = two ?? (cabac.decision(hevcCtxCbfChroma + d), 0)
				}
				if d == 0 || pcr0 != 0 {
					cr0 = cabac.decision(hevcCtxCbfChroma + d)
					cr1 = two ?? (cabac.decision(hevcCtxCbfChroma + d), 0)
				}
			}
			if split {
				let half = 1 << (log2 - 1)
				try transformTree(x0, y0, x0, y0, log2 - 1, d + 1, 0, cb0, cb1, cr0, cr1)
				try transformTree(x0 + half, y0, x0, y0, log2 - 1, d + 1, 1, cb0, cb1, cr0, cr1)
				try transformTree(x0, y0 + half, x0, y0, log2 - 1, d + 1, 2, cb0, cb1, cr0, cr1)
				try transformTree(x0 + half, y0 + half, x0, y0, log2 - 1, d + 1, 3, cb0, cb1, cr0, cr1)
				return none
			}
			let cbfLuma = 1
			cbfLuma = cabac.decision(hevcCtxCbfLuma + (d == 0 ?? (1, 0))) when predMode == hevcModeIntra || d != 0 || cb0 != 0 || cr0 != 0 || (s.chromaFormat == 2 && (cb1 != 0 || cr1 != 0))
			try transformUnit(x0, y0, xBase, yBase, log2, blk, cbfLuma, cb0, cb1, cr0, cr1)
			let size = 1 << log2
			fill4(cbf, x0, y0, size, size, cbfLuma)
			strengths(x0, y0, log2) unless sh.deblockingDisabled
			return none
		}

		// transform_unit() (7.3.8.10) with its predictions and residuals.
		//
		// Fails on malformed data.
		def transformUnit(x0 int, y0 int, xBase int, yBase int, log2 int, blk int, cbfLuma int, cb0 int, cb1 int, cr0 int, cr1 int) !none {
			let s = sps
			let intraCu = predMode == hevcModeIntra
			let log2c = log2 - s.hshift[1]
			let f422 = s.chromaFormat == 2
			let chromaAny = cb0 != 0 || cr0 != 0 || (f422 && (cb1 != 0 || cr1 != 0))
			predictIntra(x0, y0, log2, 0) when intraCu
			if cbfLuma != 0 || chromaAny {
				if pps.cuQpDeltaEnabled && !cuQpDeltaCoded {
					let v = 0
					let inc = 0
					for v < 5 && cabac.decision(hevcCtxCuQpDelta + inc) == 1 {
						v++
						inc = 1
					}
					if v >= 5 {
						let k = 0
						let suffix = 0
						for k < 7 && cabac.bypass() == 1 {
							suffix += 1 << k
							k++
						}
						fail "hevc: bad cu_qp_delta_abs" when k == 7
						for k > 0 {
							k--
							suffix += cabac.bypass() << k
						}
						v += suffix
					}
					v = -v when v != 0 && cabac.bypass() == 1
					cuQpDeltaCoded = true
					fail "hevc: cu_qp_delta out of range" when v < -(26 + s.qpBdOffset / 2) || v > 25 + s.qpBdOffset / 2
					cuQpDelta = v
					updateQp()
				}
				if sh.cuChromaQpOffset && chromaAny && !bypass && !cuChromaCoded {
					if cabac.decision(hevcCtxChromaQpOffsetFlag) == 1 {
						let idx = 0
						if pps.chromaQpOffsetListLen > 1 {
							let cmax = pps.chromaQpOffsetListLen - 1
							for idx < cmax && cabac.decision(hevcCtxChromaQpOffsetIdx) == 1 {
								idx++
							}
						}
						cuQpOffsetCb = pps.cbQpOffsetList[idx]
						cuQpOffsetCr = pps.crQpOffsetList[idx]
					} else {
						cuQpOffsetCb = 0
						cuQpOffsetCr = 0
					}
					cuChromaCoded = true
				}
				crossPf = false
				if cbfLuma != 0 {
					try residual(x0, y0, log2, 0)
				}
				if s.chromaFormat != 0 && (log2 > 2 || s.chromaFormat == 3) {
					crossPf = pps.crossComponentPred && cbfLuma != 0 && (predMode != hevcModeIntra || tuChroma == 4)
					let parts = f422 ?? (2, 1)
					for let c = 1; c <= 2; c++ {
						resScaleSyntax(c - 1) when crossPf
						for let i = 0; i < parts; i++ {
							let yy = y0 + (i << log2c)
							predictIntra(x0, yy, log2c, c) when intraCu
							let coded = c == 1 ?? ((i == 0 ?? (cb0, cb1)), (i == 0 ?? (cr0, cr1)))
							if coded != 0 {
								try residual(x0, yy, log2c, c)
							} else if crossPf && resScale != 0 {
								let n = 1 << log2c
								for let k = 0; k < n * n; k++ {
									coeffs[k] = int32((resScale * int(lumaRes[k])) >> 3)
								}
								addTo(x0, yy, log2c, c)
							}
						}
					}
				} else if s.chromaFormat != 0 && blk == 3 {
					let parts = f422 ?? (2, 1)
					for let c = 1; c <= 2; c++ {
						for let i = 0; i < parts; i++ {
							let yy = yBase + (i << log2)
							predictIntra(xBase, yy, log2, c) when intraCu
							let coded = c == 1 ?? ((i == 0 ?? (cb0, cb1)), (i == 0 ?? (cr0, cr1)))
							if coded != 0 {
								try residual(xBase, yy, log2, c)
							}
						}
					}
				}
			} else if s.chromaFormat != 0 && intraCu {
				if log2 > 2 || s.chromaFormat == 3 {
					let parts = f422 ?? (2, 1)
					for let c = 1; c <= 2; c++ {
						for let i = 0; i < parts; i++ {
							predictIntra(x0, y0 + (i << log2c), log2c, c)
						}
					}
				} else if blk == 3 {
					let parts = f422 ?? (2, 1)
					for let c = 1; c <= 2; c++ {
						for let i = 0; i < parts; i++ {
							predictIntra(xBase, yBase + (i << log2), log2, c)
						}
					}
				}
			}
			return none
		}

		// log2_res_scale_abs_plus1 and res_scale_sign_flag (7.3.8.12).
		def resScaleSyntax(idx int) {
			let v = 0
			for v < 4 && cabac.decision(hevcCtxResScaleAbs + 4 * idx + v) == 1 {
				v++
			}
			resScale = 0
			if v != 0 {
				let sign = cabac.decision(hevcCtxResScaleSign + idx)
				resScale = (1 << (v - 1)) * (1 - 2 * sign)
			}
		}

		// Predicts the n x n block (n = 1 << log2, in component samples)
		// of component `c` at luma position (x0, y0) from its substituted
		// neighbours (8.4.4.2).
		def predictIntra(x0 int, y0 int, log2 int, c int) {
			let s = sps
			let p = pic
			let hs = c == 0 ?? (0, s.hshift[1])
			let vs = c == 0 ?? (0, s.vshift[1])
			let n = 1 << log2
			let xc = x0 >> hs
			let yc = y0 >> vs
			let plane = c == 0 ?? (p.y, c == 1 ?? (p.u, p.v))
			let stride = c == 0 ?? (p.stride, p.cstride)
			let mode = c == 0 ?? (tuMode, tuModeC)
			let bd = c == 0 ?? (s.bitDepth, s.bitDepthChroma)
			let cip = pps.constrainedIntraPred
			let l = intra.left
			let t = intra.top
			// The neighbours in substitution order live in `intra.ref`:
			// left column bottom-up, the corner, then the top row.
			let r = intra.ref
			let total = 4 * n + 1
			let unitX = 4 >> hs
			let unitY = 4 >> vs
			unitX = 1 when unitX == 0
			unitY = 1 when unitY == 0
			let any = false
			let availL = intra.avail
			let k = 0
			for k < 2 * n {
				// Left sample row yc + 2n - 1 - k.
				let row = yc + 2 * n - 1 - k
				let yN = row << vs
				let ok = available(x0, y0, x0 - 1, yN) && (!cip || p.pred[at4(x0 - 1, yN)] == byte(hevcPredIntra))
				let run = (row % unitY) + 1
				for let q = 0; q < run && k < 2 * n; q++ {
					availL[k] = ok
					if ok {
						r[k] = int(plane[(yc + 2 * n - 1 - k) * stride + xc - 1])
						any = true
					}
					k++
				}
			}
			let okC = available(x0, y0, x0 - 1, y0 - 1) && (!cip || p.pred[at4(x0 - 1, y0 - 1)] == byte(hevcPredIntra))
			availL[2 * n] = okC
			if okC {
				r[2 * n] = int(plane[(yc - 1) * stride + xc - 1])
				any = true
			}
			k = 0
			for k < 2 * n {
				let col = xc + k
				let xN = col << hs
				let ok = available(x0, y0, xN, y0 - 1) && (!cip || p.pred[at4(xN, y0 - 1)] == byte(hevcPredIntra))
				let run = unitX - (col % unitX)
				for let q = 0; q < run && k < 2 * n; q++ {
					availL[2 * n + 1 + k] = ok
					if ok {
						r[2 * n + 1 + k] = int(plane[(yc - 1) * stride + xc + k])
						any = true
					}
					k++
				}
			}
			if !any {
				let mid = 1 << (bd - 1)
				for let i = 0; i < total; i++ {
					r[i] = mid
				}
			} else {
				if !availL[0] {
					for let i = 1; i < total; i++ {
						if availL[i] {
							r[0] = r[i]
							break
						}
					}
				}
				for let i = 1; i < total; i++ {
					r[i] = r[i - 1] unless availL[i]
				}
			}
			for let i = 0; i < 2 * n; i++ {
				l[1 + i] = r[2 * n - 1 - i]
				t[1 + i] = r[2 * n + 1 + i]
			}
			l[0] = r[2 * n]
			t[0] = r[2 * n]
			let smoothing = !s.intraSmoothingDisabled && (c == 0 || s.chromaFormat == 3)
			let edges = c == 0 && !(s.implicitRdpcm && bypass)
			intra.predict(plane, yc * stride + xc, stride, log2, mode, bd, smoothing, s.strongIntraSmoothing && c == 0, edges)
		}

		// Adds the residuals now in `coeffs` to component `c` of the block
		// at luma position (x0, y0).
		def addTo(x0 int, y0 int, log2 int, c int) {
			let s = sps
			let p = pic
			if c == 0 {
				hevcAddResidual(p.y, y0 * p.stride + x0, p.stride, coeffs, log2, s.bitDepth)
				return
			}
			let at = (y0 >> s.vshift[1]) * p.cstride + (x0 >> s.hshift[1])
			hevcAddResidual(c == 1 ?? (p.u, p.v), at, p.cstride, coeffs, log2, s.bitDepthChroma)
		}

		// residual_coding() (7.3.8.11) with scaling (8.6.2-8.6.4) and the
		// reconstruction of the block.
		//
		// Fails on malformed data.
		def residual(x0 int, y0 int, log2 int, c int) !none {
			let s = sps
			let p = pps
			let n = 1 << log2
			let intraCu = predMode == hevcModeIntra
			let modeIntra = c == 0 ?? (tuMode, tuModeC)
			let scanIdx = hevcScanDiag
			if intraCu && (log2 == 2 || (log2 == 3 && (c == 0 || s.chromaFormat == 3))) {
				scanIdx = hevcScanVert when modeIntra >= 6 && modeIntra <= 14
				scanIdx = hevcScanHoriz when modeIntra >= 22 && modeIntra <= 30
			}
			let tskip = false
			let shift = 0
			let add = 0
			let scale = 0
			let useList = false
			let listBase = 0
			let dcScale = 16
			if !bypass {
				tskip = p.transformSkipEnabled && log2 <= p.log2MaxTransformSkipSize && cabac.decision(hevcCtxTransformSkip + (c == 0 ?? (0, 1))) == 1
				let qp = 0
				if c == 0 {
					qp = qpY + s.qpBdOffset
				} else {
					let off = c == 1 ?? (p.cbQpOffset + sh.cbQpOffset + cuQpOffsetCb, p.crQpOffset + sh.crQpOffset + cuQpOffsetCr)
					let qpi = qpY + off
					qpi = qpi < -s.qpBdOffset ?? (-s.qpBdOffset, qpi > 57 ?? (57, qpi))
					if s.chromaFormat == 1 {
						qp = qpi < 30 ?? (qpi, qpi > 43 ?? (qpi - 6, hevcQpC[qpi - 30]))
					} else {
						qp = qpi > 51 ?? (51, qpi)
					}
					qp += s.qpBdOffset
				}
				let bd = c == 0 ?? (s.bitDepth, s.bitDepthChroma)
				shift = bd + log2 - 5
				add = 1 << (shift - 1)
				scale = hevcLevelScale[qp % 6] << (qp / 6)
				if s.scalingEnabled && !(tskip && log2 > 2) {
					useList = true
					let list = p.scalingPresent ?? (p.scaling, s.scaling)
					let matrix = (intraCu ?? (0, 3)) + c
					listBase = ((log2 - 2) * 6 + matrix) * 64
					dcScale = log2 >= 4 ?? (list.dc[(log2 - 4) * 6 + matrix], 16)
				}
			}
			let explicitRdpcm = false
			let rdpcmDir = 0
			if predMode != hevcModeIntra && s.explicitRdpcm && (tskip || bypass) {
				explicitRdpcm = cabac.decision(hevcCtxRdpcmFlag + (c == 0 ?? (0, 1))) == 1
				rdpcmDir = cabac.decision(hevcCtxRdpcmDir + (c == 0 ?? (0, 1))) when explicitRdpcm
			}
			// last_sig_coeff_x/y_prefix and suffix.
			let maxBins = (log2 << 1) - 1
			let ctxOffset = c == 0 ?? (3 * (log2 - 2) + ((log2 - 1) >> 2), 15)
			let ctxShift = c == 0 ?? ((log2 + 1) >> 2, log2 - 2)
			let lastX = 0
			for lastX < maxBins && cabac.decision(hevcCtxLastXPrefix + (lastX >> ctxShift) + ctxOffset) == 1 {
				lastX++
			}
			let lastY = 0
			for lastY < maxBins && cabac.decision(hevcCtxLastYPrefix + (lastY >> ctxShift) + ctxOffset) == 1 {
				lastY++
			}
			if lastX > 3 {
				let len = (lastX >> 1) - 1
				let suffix = 0
				for let i = 0; i < len; i++ {
					suffix = (suffix << 1) | cabac.bypass()
				}
				lastX = (1 << ((lastX >> 1) - 1)) * (2 + (lastX & 1)) + suffix
			}
			if lastY > 3 {
				let len = (lastY >> 1) - 1
				let suffix = 0
				for let i = 0; i < len; i++ {
					suffix = (suffix << 1) | cabac.bypass()
				}
				lastY = (1 << ((lastY >> 1) - 1)) * (2 + (lastY & 1)) + suffix
			}
			if scanIdx == hevcScanVert {
				let t = lastX
				lastX = lastY
				lastY = t
			}
			let cgLastX = lastX >> 2
			let cgLastY = lastY >> 2
			// Scan tables by group and within a group.
			let cgX = hevcScan1x1
			let cgY = hevcScan1x1
			let offX = hevcDiag4x4X
			let offY = hevcDiag4x4Y
			let numCoeff = 0
			if scanIdx == hevcScanDiag {
				numCoeff = hevcDiag4x4Inv[(lastY & 3) * 4 + (lastX & 3)]
				if n == 8 {
					numCoeff += hevcDiag2x2Inv[cgLastY * 2 + cgLastX] << 4
					cgX = hevcDiag2x2X
					cgY = hevcDiag2x2Y
				} else if n == 16 {
					numCoeff += hevcDiag4x4Inv[cgLastY * 4 + cgLastX] << 4
					cgX = hevcDiag4x4X
					cgY = hevcDiag4x4Y
				} else if n == 32 {
					numCoeff += hevcDiag8x8Inv[cgLastY * 8 + cgLastX] << 4
					cgX = hevcDiag8x8X
					cgY = hevcDiag8x8Y
				}
			} else if scanIdx == hevcScanHoriz {
				cgX = hevcHoriz2x2X
				cgY = hevcHoriz2x2Y
				offX = hevcHoriz4x4X
				offY = hevcHoriz4x4Y
				numCoeff = hevcHoriz8x8Inv[lastY * 8 + lastX]
			} else {
				cgX = hevcHoriz2x2Y
				cgY = hevcHoriz2x2X
				offX = hevcHoriz4x4Y
				offY = hevcHoriz4x4X
				numCoeff = hevcHoriz8x8Inv[lastX * 8 + lastY]
			}
			numCoeff++
			let numLastSubset = (numCoeff - 1) >> 4
			for let i = 0; i < n * n; i++ {
				coeffs[i] = 0
			}
			let groups = 1 << (log2 - 2)
			for let i = 0; i < 64; i++ {
				sigGroup[i] = 0
			}
			let tsCtx = s.transformSkipContext && (tskip || bypass)
			let signHiding = p.signDataHiding
			let noHide = bypass || (intraCu && s.implicitRdpcm && tskip && (modeIntra == 10 || modeIntra == 26)) || explicitRdpcm
			let greater1Ctx = 1
			let maxX = 0
			let maxY = 0
			let sbType = 0
			sbType = 2 * (c == 0 ?? (1, 0)) + ((tskip || bypass) ?? (1, 0)) when s.persistentRice
			for let i = numLastSubset; i >= 0; i-- {
				let xCg = cgX[i]
				let yCg = cgY[i]
				let implicitNonZero = false
				let offset = i << 4
				if i < numLastSubset && i > 0 {
					let ctxCg = 0
					ctxCg += sigGroup[yCg * 8 + xCg + 1] when xCg < groups - 1
					ctxCg += sigGroup[(yCg + 1) * 8 + xCg] when yCg < groups - 1
					let inc = (ctxCg > 0 ?? (1, 0)) + (c > 0 ?? (2, 0))
					sigGroup[yCg * 8 + xCg] = cabac.decision(hevcCtxSigGroup + inc)
					implicitNonZero = true
				} else {
					sigGroup[yCg * 8 + xCg] = ((xCg == cgLastX && yCg == cgLastY) || (xCg == 0 && yCg == 0)) ?? (1, 0)
				}
				let lastScanPos = numCoeff - offset - 1
				let nEnd = 15
				let nb = 0
				if i == numLastSubset {
					nEnd = lastScanPos - 1
					sigIdx[0] = lastScanPos
					nb = 1
				}
				let prevSig = 0
				prevSig = sigGroup[yCg * 8 + xCg + 1] when xCg < groups - 1
				prevSig += sigGroup[(yCg + 1) * 8 + xCg] << 1 when yCg < groups - 1
				if sigGroup[yCg * 8 + xCg] != 0 && nEnd >= 0 {
					let mapBase = scanIdx * 80
					let scf = 0
					if tsCtx {
						mapBase += 64
						scf = c == 0 ?? (40, 14 + 27)
					} else {
						scf = c == 0 ?? (0, 27)
						if log2 != 2 {
							mapBase += (prevSig + 1) << 4
							if c == 0 {
								scf += 3 when xCg > 0 || yCg > 0
								scf += log2 == 3 ?? ((scanIdx == hevcScanDiag ?? (9, 15)), 21)
							} else {
								scf += log2 == 3 ?? (9, 12)
							}
						}
					}
					let nb0 = nb
					for let k = nEnd; k > 0; k-- {
						let sig = cabac.decision(hevcCtxSigCoeff + hevcSigCtxMap[mapBase + k] + scf)
						sigIdx[nb] = k
						nb += sig
					}
					implicitNonZero = false when nb != nb0
					if !implicitNonZero {
						let scf0 = 0
						if tsCtx {
							scf0 = c == 0 ?? (42, 16 + 27)
						} else if i == 0 {
							scf0 = c == 0 ?? (0, 27)
						} else {
							scf0 = 2 + scf
						}
						sigIdx[nb] = 0
						nb += cabac.decision(hevcCtxSigCoeff + scf0)
					} else {
						sigIdx[nb] = 0
						nb++
					}
				}
				continue when nb == 0
				let rice = 0
				rice = statCoeff[sbType] / 4 when s.persistentRice
				let riceInit = false
				let ctxSet = (i > 0 && c == 0) ?? (2, 0)
				ctxSet++ when i != numLastSubset && greater1Ctx == 0
				greater1Ctx = 1
				let firstG1 = -1
				let lim = nb > 8 ?? (8, nb)
				for let m = 0; m < lim; m++ {
					let inc = (ctxSet << 2) + greater1Ctx + (c > 0 ?? (16, 0))
					let flag = cabac.decision(hevcCtxGreater1 + inc)
					gt1[m] = flag
					if flag == 1 {
						greater1Ctx = 0
						firstG1 = m when firstG1 < 0
					} else if greater1Ctx > 0 && greater1Ctx < 3 {
						greater1Ctx++
					}
				}
				let lastNz = sigIdx[0]
				let firstNz = sigIdx[nb - 1]
				let hidden = !noHide && lastNz - firstNz >= 4
				gt1[firstG1] += cabac.decision(hevcCtxGreater2 + ctxSet + (c > 0 ?? (4, 0))) when firstG1 >= 0
				let signCount = (signHiding && hidden) ?? (nb - 1, nb)
				let signs = 0
				for let m = 0; m < signCount; m++ {
					signs = (signs << 1) | cabac.bypass()
				}
				signs = signs << (16 - signCount)
				let sumAbs = 0
				for let m = 0; m < nb; m++ {
					let k = sigIdx[m]
					let xC = (xCg << 2) + offX[k]
					let yC = (yCg << 2) + offY[k]
					let level = 0
					let needRemaining = false
					if m < 8 {
						level = 1 + gt1[m]
						needRemaining = level == (m == firstG1 ?? (3, 2))
					} else {
						level = 1
						needRemaining = true
					}
					if needRemaining {
						let remaining = try coeffRemaining(rice)
						level += remaining
						rice = s.persistentRice ?? (rice + 1, rice + 1 > 4 ?? (4, rice + 1)) when level > (3 << rice)
						if s.persistentRice && !riceInit {
							let init = statCoeff[sbType] / 4
							if remaining >= (3 << init) {
								statCoeff[sbType]++
							} else if 2 * remaining < (1 << init) && statCoeff[sbType] > 0 {
								statCoeff[sbType]--
							}
							riceInit = true
						}
					}
					if signHiding && hidden {
						sumAbs += level
						level = -level when k == firstNz && (sumAbs & 1) != 0
					}
					level = -level when (signs & 0x8000) != 0
					signs = (signs << 1) & 0xFFFF
					if !bypass {
						let m2 = 16
						if useList {
							let list = p.scalingPresent ?? (p.scaling, s.scaling)
							if xC != 0 || yC != 0 || log2 < 4 {
								let pos = 0
								match log2 {
									case 3:
										pos = (yC << 3) + xC
									case 4:
										pos = ((yC >> 1) << 3) + (xC >> 1)
									case 5:
										pos = ((yC >> 2) << 3) + (xC >> 2)
									default:
										pos = (yC << 2) + xC
								}
								m2 = list.list[listBase + pos]
							} else {
								m2 = dcScale
							}
						}
						let v = (int64(level) * int64(scale) * int64(m2) + int64(add)) >> int64(shift)
						level = int(v < -32768 ?? (-32768, v > 32767 ?? (32767, v)))
					}
					coeffs[yC * n + xC] = int32(level)
					maxX = xC when xC > maxX
					maxY = yC when yC > maxY
				}
			}
			let bdC = c == 0 ?? (s.bitDepth, s.bitDepthChroma)
			if bypass {
				if explicitRdpcm || (s.implicitRdpcm && intraCu && (modeIntra == 10 || modeIntra == 26)) {
					let vertical = s.implicitRdpcm && !explicitRdpcm ?? (modeIntra == 26, rdpcmDir == 1)
					hevcRdpcm(coeffs, log2, vertical)
				}
			} else if tskip {
				let rotate = s.transformSkipRotation && log2 == 2 && intraCu
				hevcTransformSkip(coeffs, log2, bdC, rotate)
				if explicitRdpcm || (s.implicitRdpcm && intraCu && (modeIntra == 10 || modeIntra == 26)) {
					let vertical = explicitRdpcm ?? (rdpcmDir == 1, modeIntra == 26)
					hevcRdpcm(coeffs, log2, vertical)
				}
			} else {
				let dst = intraCu && c == 0 && log2 == 2
				hevcInverseTransform(coeffs, log2, dst ?? (3, maxX), dst ?? (3, maxY), dst, bdC, tmp, tmatrix)
			}
			if crossPf && c > 0 {
				for let k = 0; k < n * n; k++ {
					coeffs[k] += int32((resScale * int(lumaRes[k])) >> 3)
				}
			}
			if c == 0 && pps.crossComponentPred {
				for let k = 0; k < n * n; k++ {
					lumaRes[k] = coeffs[k]
				}
			}
			addTo(x0, y0, log2, c)
			return none
		}

		// coeff_abs_level_remaining (9.3.3.11).
		//
		// Fails on a prefix longer than the syntax allows.
		def coeffRemaining(rice int) !int {
			let prefix = 0
			for prefix < 32 && cabac.bypass() == 1 {
				prefix++
			}
			fail "hevc: bad coeff_abs_level_remaining" when prefix == 32
			if prefix < 3 {
				let suffix = 0
				for let i = 0; i < rice; i++ {
					suffix = (suffix << 1) | cabac.bypass()
				}
				return (prefix << rice) + suffix
			}
			let k = prefix - 3 + rice
			fail "hevc: bad coeff_abs_level_remaining" when k > 16 + 6
			let suffix = 0
			for let i = 0; i < k; i++ {
				suffix = (suffix << 1) | cabac.bypass()
			}
			return (((1 << (prefix - 3)) + 3 - 1) << rice) + suffix
		}

		// Whether the prediction block at (xN, yN) is available to the one
		// at (xPb, yPb) and not intra (6.4.2).
		def puAvailable(xPb int, yPb int, w int, h int, partIdx int, xN int, yN int) bool {
			let n = 1 << cuLog2
			let sameCb = cuX <= xN && cuY <= yN && cuX + n > xN && cuY + n > yN
			let ok = false
			if !sameCb {
				ok = available(xPb, yPb, xN, yN)
			} else {
				ok = !((w << 1) == n && (h << 1) == n && partIdx == 1 && cuY + h <= yN && cuX + w > xN)
			}
			return ok && pic.pred[at4(xN, yN)] != byte(hevcPredIntra)
		}

		// Whether the motion of 4x4 blocks `a` and `b` of the current
		// picture is the same.
		def sameMotion(a int, b int) bool {
			let p = pic
			let f = int(p.pred[a])
			return false when f != int(p.pred[b])
			if (f & 1) != 0 {
				return false when p.ref0[a] != p.ref0[b] || p.mvx0[a] != p.mvx0[b] || p.mvy0[a] != p.mvy0[b]
			}
			if (f & 2) != 0 {
				return false when p.ref1[a] != p.ref1[b] || p.mvx1[a] != p.mvx1[b] || p.mvy1[a] != p.mvy1[b]
			}
			return true
		}

		// Appends the motion of 4x4 block `k` as merge candidate `i`.
		def takeCandidate(i int, k int) {
			let p = pic
			cPred[i] = int(p.pred[k])
			cMv[i * 4] = int(p.mvx0[k])
			cMv[i * 4 + 1] = int(p.mvy0[k])
			cMv[i * 4 + 2] = int(p.mvx1[k])
			cMv[i * 4 + 3] = int(p.mvy1[k])
			cRef[i * 2] = int(p.ref0[k])
			cRef[i * 2 + 1] = int(p.ref1[k])
		}

		// POC and long-term flag of entry `idx` of list `l` of the current
		// slice.
		def refPocAt(l int, idx int) int {
			return pic.refPoc[curSlice * 32 + l * 16 + idx]
		}

		def refLtAt(l int, idx int) bool {
			return pic.refLt[curSlice * 32 + l * 16 + idx]
		}

		// Merge mode motion (8.5.3.2.2-8.5.3.2.5) into mMv/mRef/mPred.
		def mergeMotion(xOrig int, yOrig int, wOrig int, hOrig int, partIdxOrig int, mergeIdx int) {
			let xPb = xOrig
			let yPb = yOrig
			let w = wOrig
			let h = hOrig
			let partIdx = partIdxOrig
			let plevel = pps.log2ParallelMergeLevel
			if plevel > 2 && cuLog2 == 3 {
				xPb = cuX
				yPb = cuY
				w = 8
				h = 8
				partIdx = 0
			}
			let count = 0
			let xA1 = xPb - 1
			let yA1 = yPb + h - 1
			let availA1 = !(partIdx == 1 && (partMode := hevcPartNx2N || hevcPartnLx2N || hevcPartnRx2N)) && !(xPb >> plevel == xA1 >> plevel && yPb >> plevel == yA1 >> plevel) && puAvailable(xPb, yPb, w, h, partIdx, xA1, yA1)
			let kA1 = at4(xA1, yA1)
			if availA1 {
				takeCandidate(count, kA1)
				count++
			}
			let xB1 = xPb + w - 1
			let yB1 = yPb - 1
			let availB1 = !(partIdx == 1 && (partMode := hevcPart2NxN || hevcPart2NxnU || hevcPart2NxnD)) && !(xPb >> plevel == xB1 >> plevel && yPb >> plevel == yB1 >> plevel) && puAvailable(xPb, yPb, w, h, partIdx, xB1, yB1)
			let kB1 = at4(xB1, yB1)
			if count <= mergeIdx && availB1 && !(availA1 && sameMotion(kB1, kA1)) {
				takeCandidate(count, kB1)
				count++
			}
			let xB0 = xPb + w
			let yB0 = yPb - 1
			let availB0 = !(xPb >> plevel == xB0 >> plevel && yPb >> plevel == yB0 >> plevel) && puAvailable(xPb, yPb, w, h, partIdx, xB0, yB0)
			if count <= mergeIdx && availB0 && !(availB1 && sameMotion(at4(xB0, yB0), kB1)) {
				takeCandidate(count, at4(xB0, yB0))
				count++
			}
			let xA0 = xPb - 1
			let yA0 = yPb + h
			let availA0 = !(xPb >> plevel == xA0 >> plevel && yPb >> plevel == yA0 >> plevel) && puAvailable(xPb, yPb, w, h, partIdx, xA0, yA0)
			if count <= mergeIdx && availA0 && !(availA1 && sameMotion(at4(xA0, yA0), kA1)) {
				takeCandidate(count, at4(xA0, yA0))
				count++
			}
			let xB2 = xPb - 1
			let yB2 = yPb - 1
			let availB2 = !(xPb >> plevel == xB2 >> plevel && yPb >> plevel == yB2 >> plevel) && puAvailable(xPb, yPb, w, h, partIdx, xB2, yB2)
			if count <= mergeIdx && availB2 && count != 4 {
				let kB2 = at4(xB2, yB2)
				if !(availA1 && sameMotion(kB2, kA1)) && !(availB1 && sameMotion(kB2, kB1)) {
					takeCandidate(count, kB2)
					count++
				}
			}
			if count <= mergeIdx && sh.temporalMvp && count < sh.maxMergeCand {
				let l0 = temporalMv(xPb, yPb, w, h, 0, 0)
				let x0 = tmvX
				let y0 = tmvY
				let l1 = false
				l1 = temporalMv(xPb, yPb, w, h, 0, 1) when sh.sliceType == hevcSliceB
				if l0 || l1 {
					cPred[count] = (l0 ?? (1, 0)) | (l1 ?? (2, 0))
					cMv[count * 4] = l0 ?? (x0, 0)
					cMv[count * 4 + 1] = l0 ?? (y0, 0)
					cMv[count * 4 + 2] = l1 ?? (tmvX, 0)
					cMv[count * 4 + 3] = l1 ?? (tmvY, 0)
					cRef[count * 2] = l0 ?? (0, -1)
					cRef[count * 2 + 1] = l1 ?? (0, -1)
					count++
				}
			}
			let orig = count
			if count <= mergeIdx && sh.sliceType == hevcSliceB && orig > 1 && orig < sh.maxMergeCand {
				let comb = 0
				for count <= mergeIdx && count < sh.maxMergeCand && comb < orig * (orig - 1) {
					let a = hevcCombL0[comb]
					let b = hevcCombL1[comb]
					comb++
					continue unless (cPred[a] & 1) != 0 && (cPred[b] & 2) != 0
					let differ = refPocAt(0, cRef[a * 2]) != refPocAt(1, cRef[b * 2 + 1]) || cMv[a * 4] != cMv[b * 4 + 2] || cMv[a * 4 + 1] != cMv[b * 4 + 3]
					continue unless differ
					cPred[count] = 3
					cMv[count * 4] = cMv[a * 4]
					cMv[count * 4 + 1] = cMv[a * 4 + 1]
					cMv[count * 4 + 2] = cMv[b * 4 + 2]
					cMv[count * 4 + 3] = cMv[b * 4 + 3]
					cRef[count * 2] = cRef[a * 2]
					cRef[count * 2 + 1] = cRef[b * 2 + 1]
					count++
				}
			}
			let numRef = sh.sliceType == hevcSliceP ?? (sh.numRefIdx[0], (sh.numRefIdx[0] < sh.numRefIdx[1] ?? (sh.numRefIdx[0], sh.numRefIdx[1])))
			let zero = 0
			for count <= mergeIdx {
				let r = zero < numRef ?? (zero, 0)
				cPred[count] = sh.sliceType == hevcSliceP ?? (1, 3)
				for let i = 0; i < 4; i++ {
					cMv[count * 4 + i] = 0
				}
				cRef[count * 2] = r
				cRef[count * 2 + 1] = sh.sliceType == hevcSliceP ?? (-1, r)
				count++
				zero++
			}
			mPred = cPred[mergeIdx]
			for let i = 0; i < 4; i++ {
				mMv[i] = cMv[mergeIdx * 4 + i]
			}
			mRef[0] = cRef[mergeIdx * 2]
			mRef[1] = cRef[mergeIdx * 2 + 1]
			if mPred == 3 && wOrig + hOrig == 12 {
				mPred = 1
				mRef[1] = -1
			}
		}

		// The temporal motion vector predictor (8.5.3.2.8) for reference
		// `refIdx` of list `X`, into tmvX/tmvY; false when there is none.
		def temporalMv(xPb int, yPb int, w int, h int, refIdx int, X int) bool {
			let s = sps
			let x = xPb + w
			let y = yPb + h
			if (yPb >> s.log2CtbSize) == (y >> s.log2CtbSize) && y < s.height && x < s.width {
				return true when colocated(x & ~15, y & ~15, refIdx, X)
			}
			return colocated((xPb + (w >> 1)) & ~15, (yPb + (h >> 1)) & ~15, refIdx, X)
		}

		// The collocated motion vector at (x, y) of the collocated picture
		// (8.5.3.2.9).
		def colocated(x int, y int, refIdx int, X int) bool {
			let col = colPic
			let k = (y >> 2) * col.w4 + (x >> 2)
			let f = int(col.pred[k])
			tmvX = 0
			tmvY = 0
			return false when f == hevcPredIntra
			let list = 0
			if f == hevcPredL1 {
				list = 1
			} else if f == hevcPredBi {
				list = noBackward ?? (X, (sh.colFromL0 ?? (1, 0)))
			}
			let mvx = list == 0 ?? (int(col.mvx0[k]), int(col.mvx1[k]))
			let mvy = list == 0 ?? (int(col.mvy0[k]), int(col.mvy1[k]))
			let r = list == 0 ?? (int(col.ref0[k]), int(col.ref1[k]))
			let slice = col.sliceAt(x, y)
			let colRefPoc = col.refPoc[slice * 32 + list * 16 + r]
			let colLt = col.refLt[slice * 32 + list * 16 + r]
			let curLt = refLtAt(X, refIdx)
			return false when curLt != colLt
			let colDiff = col.poc - colRefPoc
			let curDiff = pic.poc - refPocAt(X, refIdx)
			if curLt || colDiff == curDiff || colDiff == 0 {
				tmvX = mvx
				tmvY = mvy
			} else {
				tmvX = hevcScaleMv(mvx, colDiff, curDiff)
				tmvY = hevcScaleMv(mvy, colDiff, curDiff)
			}
			return true
		}

		// A spatial AMVP candidate of 4x4 block `k` in list `l` pointing at
		// the same picture as the target, into tmvX/tmvY.
		def amvpSame(k int, l int, target int) bool {
			let p = pic
			let f = int(p.pred[k])
			return false when (f & (1 << l)) == 0
			let r = l == 0 ?? (int(p.ref0[k]), int(p.ref1[k]))
			return false when refPocAt(l, r) != target
			tmvX = l == 0 ?? (int(p.mvx0[k]), int(p.mvx1[k]))
			tmvY = l == 0 ?? (int(p.mvy0[k]), int(p.mvy1[k]))
			return true
		}

		// A spatial AMVP candidate scaled to the target (both short-term)
		// or taken as is (both long-term), into tmvX/tmvY.
		def amvpScaled(k int, l int, target int, targetLt bool) bool {
			let p = pic
			let f = int(p.pred[k])
			return false when (f & (1 << l)) == 0
			let r = l == 0 ?? (int(p.ref0[k]), int(p.ref1[k]))
			return false when refLtAt(l, r) != targetLt
			tmvX = l == 0 ?? (int(p.mvx0[k]), int(p.mvx1[k]))
			tmvY = l == 0 ?? (int(p.mvy0[k]), int(p.mvy1[k]))
			let refPoc = refPocAt(l, r)
			if !targetLt && refPoc != target {
				let td = pic.poc - refPoc
				td = 1 when td == 0
				tmvX = hevcScaleMv(tmvX, td, pic.poc - target)
				tmvY = hevcScaleMv(tmvY, td, pic.poc - target)
			}
			return true
		}

		// The motion vector predictor of list X (8.5.3.2.6-8.5.3.2.7) into
		// mMv[2X..].
		def amvpMotion(xPb int, yPb int, w int, h int, partIdx int, X int, mvpFlag int) {
			let target = refPocAt(X, mRef[X])
			let targetLt = refLtAt(X, mRef[X])
			let Y = 1 - X
			let xA0 = xPb - 1
			let yA0 = yPb + h
			let xA1 = xPb - 1
			let yA1 = yPb + h - 1
			let availA0 = puAvailable(xPb, yPb, w, h, partIdx, xA0, yA0)
			let availA1 = puAvailable(xPb, yPb, w, h, partIdx, xA1, yA1)
			let kA0 = at4(xA0, yA0)
			let kA1 = at4(xA1, yA1)
			let scaled = availA0 || availA1
			let foundA = false
			if availA0 && (amvpSame(kA0, X, target) || amvpSame(kA0, Y, target)) {
				foundA = true
			} else if availA1 && (amvpSame(kA1, X, target) || amvpSame(kA1, Y, target)) {
				foundA = true
			} else if availA0 && (amvpScaled(kA0, X, target, targetLt) || amvpScaled(kA0, Y, target, targetLt)) {
				foundA = true
			} else if availA1 && (amvpScaled(kA1, X, target, targetLt) || amvpScaled(kA1, Y, target, targetLt)) {
				foundA = true
			}
			let ax = tmvX
			let ay = tmvY
			let xB0 = xPb + w
			let yB0 = yPb - 1
			let xB1 = xPb + w - 1
			let yB1 = yPb - 1
			let xB2 = xPb - 1
			let yB2 = yPb - 1
			let availB0 = puAvailable(xPb, yPb, w, h, partIdx, xB0, yB0)
			let availB1 = puAvailable(xPb, yPb, w, h, partIdx, xB1, yB1)
			let availB2 = puAvailable(xPb, yPb, w, h, partIdx, xB2, yB2)
			let kB0 = at4(xB0, yB0)
			let kB1 = at4(xB1, yB1)
			let kB2 = at4(xB2, yB2)
			let foundB = false
			if availB0 && (amvpSame(kB0, X, target) || amvpSame(kB0, Y, target)) {
				foundB = true
			} else if availB1 && (amvpSame(kB1, X, target) || amvpSame(kB1, Y, target)) {
				foundB = true
			} else if availB2 && (amvpSame(kB2, X, target) || amvpSame(kB2, Y, target)) {
				foundB = true
			}
			let bx = tmvX
			let by = tmvY
			if !scaled {
				if foundB {
					foundA = true
					ax = bx
					ay = by
				}
				foundB = false
				if availB0 && (amvpScaled(kB0, X, target, targetLt) || amvpScaled(kB0, Y, target, targetLt)) {
					foundB = true
				} else if availB1 && (amvpScaled(kB1, X, target, targetLt) || amvpScaled(kB1, Y, target, targetLt)) {
					foundB = true
				} else if availB2 && (amvpScaled(kB2, X, target, targetLt) || amvpScaled(kB2, Y, target, targetLt)) {
					foundB = true
				}
				bx = tmvX
				by = tmvY
			}
			let count = 0
			let cx = int[0, 0]
			let cy = int[0, 0]
			if foundA {
				cx[0] = ax
				cy[0] = ay
				count = 1
			}
			if foundB && (!foundA || ax != bx || ay != by) {
				cx[count] = bx
				cy[count] = by
				count++
			}
			if count < 2 && sh.temporalMvp && mvpFlag == count {
				if temporalMv(xPb, yPb, w, h, mRef[X], X) {
					cx[count] = tmvX
					cy[count] = tmvY
					count++
				}
			}
			mMv[X * 2] = mvpFlag < count ?? (cx[mvpFlag], 0)
			mMv[X * 2 + 1] = mvpFlag < count ?? (cy[mvpFlag], 0)
		}

		// mvd_coding() (7.3.8.9) into mvdX/mvdY.
		def mvdSyntax() {
			let gx = cabac.decision(hevcCtxMvdGreater0)
			let gy = cabac.decision(hevcCtxMvdGreater0)
			gx += cabac.decision(hevcCtxMvdGreater0 + 1) when gx == 1
			gy += cabac.decision(hevcCtxMvdGreater0 + 1) when gy == 1
			mvdX = mvdValue(gx)
			mvdY = mvdValue(gy)
		}

		def mvdValue(g int) int {
			return 0 when g == 0
			let v = 1
			if g == 2 {
				// abs_mvd_minus2 as EG1.
				v = 2
				let k = 1
				for k < 31 && cabac.bypass() == 1 {
					v += 1 << k
					k++
				}
				for k > 0 {
					k--
					v += cabac.bypass() << k
				}
			}
			return cabac.bypass() == 1 ?? (-v, v)
		}

		// ref_idx_lX (9.3.4.2.?): truncated rice with two context bins.
		def refIdxSyntax(num int) int {
			let max = num - 1
			let maxCtx = max < 2 ?? (max, 2)
			let i = 0
			for i < maxCtx && cabac.decision(hevcCtxRefIdx + i) == 1 {
				i++
			}
			if i == 2 {
				for i < max && cabac.bypass() == 1 {
					i++
				}
			}
			return i
		}

		// prediction_unit() (7.3.8.6), its motion and its prediction.
		//
		// Fails on a reference the slice does not have.
		def predictionUnit(xPb int, yPb int, w int, h int, partIdx int) !none {
			if predMode == hevcModeSkip || cabac.decision(hevcCtxMergeFlag) == 1 {
				mergeFlag = true
				let idx = 0
				if sh.maxMergeCand > 1 && cabac.decision(hevcCtxMergeIdx) == 1 {
					idx = 1
					for idx < sh.maxMergeCand - 1 && cabac.bypass() == 1 {
						idx++
					}
				}
				mergeMotion(xPb, yPb, w, h, partIdx, idx)
			} else {
				mergeFlag = false
				let idc = 0
				if sh.sliceType == hevcSliceB {
					if w + h == 12 {
						idc = cabac.decision(hevcCtxInterPredIdc + 4)
					} else if cabac.decision(hevcCtxInterPredIdc + depth) == 1 {
						idc = 2
					} else {
						idc = cabac.decision(hevcCtxInterPredIdc + 4)
					}
				}
				mPred = 0
				mRef[0] = -1
				mRef[1] = -1
				if idc != 1 {
					mRef[0] = refIdxSyntax(sh.numRefIdx[0])
					mvdSyntax()
					let flag = cabac.decision(hevcCtxMvpFlag)
					amvpMotion(xPb, yPb, w, h, partIdx, 0, flag)
					mMv[0] = hevcWrap16(mMv[0] + mvdX)
					mMv[1] = hevcWrap16(mMv[1] + mvdY)
					mPred = 1
				}
				if idc != 0 {
					mRef[1] = refIdxSyntax(sh.numRefIdx[1])
					if sh.mvdL1Zero && idc == 2 {
						mvdX = 0
						mvdY = 0
					} else {
						mvdSyntax()
					}
					let flag = cabac.decision(hevcCtxMvpFlag)
					amvpMotion(xPb, yPb, w, h, partIdx, 1, flag)
					mMv[2] = hevcWrap16(mMv[2] + mvdX)
					mMv[3] = hevcWrap16(mMv[3] + mvdY)
					mPred += 2
				}
			}
			fail "hevc: reference index out of range" when ((mPred & 1) != 0 && mRef[0] >= sh.numRefIdx[0]) || ((mPred & 2) != 0 && mRef[1] >= sh.numRefIdx[1])
			// Store the motion.
			let p = pic
			let x4 = xPb >> 2
			let y4 = yPb >> 2
			for let j = 0; j < h >> 2; j++ {
				let o = (y4 + j) * p.w4 + x4
				for let i = 0; i < w >> 2; i++ {
					p.pred[o + i] = byte(mPred)
					p.mvx0[o + i] = int16(mMv[0])
					p.mvy0[o + i] = int16(mMv[1])
					p.mvx1[o + i] = int16(mMv[2])
					p.mvy1[o + i] = int16(mMv[3])
					p.ref0[o + i] = int8(mRef[0])
					p.ref1[o + i] = int8(mRef[1])
				}
			}
			motionCompensate(xPb, yPb, w, h)
			return none
		}

		// Predicts the PU from its references (8.5.3.3).
		def motionCompensate(xPb int, yPb int, w int, h int) {
			let s = sps
			let p = pic
			let bd = s.bitDepth
			let weighted = (sh.sliceType == hevcSliceP && pps.weightedPred) || (sh.sliceType == hevcSliceB && pps.weightedBipred)
			let bi = mPred == 3
			let list = mPred == 2 ?? (1, 0)
			let r0 = refs[list * 16 + mRef[list]]
			let mx0 = mMv[list * 2]
			let my0 = mMv[list * 2 + 1]
			let k0 = list * 16 + mRef[list]
			inter.interpolate(r0.y, r0.stride, r0.width, r0.height, xPb + (mx0 >> 2), yPb + (my0 >> 2), mx0 & 3, my0 & 3, w, h, 8, hevcQpelFilter, bd, inter.pred0)
			let r1 = r0
			let k1 = 16
			if bi {
				r1 = refs[16 + mRef[1]]
				k1 = 16 + mRef[1]
				inter.interpolate(r1.y, r1.stride, r1.width, r1.height, xPb + (mMv[2] >> 2), yPb + (mMv[3] >> 2), mMv[2] & 3, mMv[3] & 3, w, h, 8, hevcQpelFilter, bd, inter.pred1)
				inter.putBi(p.y, yPb * p.stride + xPb, p.stride, w, h, bd, weighted, sh.lumaDenom, sh.lumaWeight[k0], sh.lumaOffset[k0], sh.lumaWeight[k1], sh.lumaOffset[k1])
			} else {
				inter.putUni(p.y, yPb * p.stride + xPb, p.stride, w, h, inter.pred0, bd, weighted, sh.lumaDenom, sh.lumaWeight[k0], sh.lumaOffset[k0])
			}
			return when s.chromaFormat == 0
			let hs = s.hshift[1]
			let vs = s.vshift[1]
			let xc = xPb >> hs
			let yc = yPb >> vs
			let wc = w >> hs
			let hc = h >> vs
			let bdc = s.bitDepthChroma
			for let c = 1; c <= 2; c++ {
				let src0 = c == 1 ?? (r0.u, r0.v)
				let dst = c == 1 ?? (p.u, p.v)
				inter.interpolate(src0, r0.cstride, r0.cwidth, r0.cheight, xc + (mx0 >> (2 + hs)), yc + (my0 >> (2 + vs)), (mx0 << (1 - hs)) & 7, (my0 << (1 - vs)) & 7, wc, hc, 4, hevcEpelFilter, bdc, inter.pred0)
				if bi {
					let src1 = c == 1 ?? (r1.u, r1.v)
					inter.interpolate(src1, r1.cstride, r1.cwidth, r1.cheight, xc + (mMv[2] >> (2 + hs)), yc + (mMv[3] >> (2 + vs)), (mMv[2] << (1 - hs)) & 7, (mMv[3] << (1 - vs)) & 7, wc, hc, 4, hevcEpelFilter, bdc, inter.pred1)
					inter.putBi(dst, yc * p.cstride + xc, p.cstride, wc, hc, bdc, weighted, sh.chromaDenom, sh.chromaWeight[k0 * 2 + c - 1], sh.chromaOffset[k0 * 2 + c - 1], sh.chromaWeight[k1 * 2 + c - 1], sh.chromaOffset[k1 * 2 + c - 1])
				} else {
					inter.putUni(dst, yc * p.cstride + xc, p.cstride, wc, hc, inter.pred0, bdc, weighted, sh.chromaDenom, sh.chromaWeight[k0 * 2 + c - 1], sh.chromaOffset[k0 * 2 + c - 1])
				}
			}
		}

		// The boundary strength of an edge between inter 4x4 blocks `q`
		// (current slice) and `p` (slice `sp`) from their motion (8.7.2.4).
		def motionStrength(q int, p int, sp int) int {
			let pc = pic
			let fq = int(pc.pred[q])
			let fp = int(pc.pred[p])
			let base = sp * 32
			let cur = curSlice * 32
			let q0 = (fq & 1) != 0 ?? (pc.refPoc[cur + int(pc.ref0[q])], -999999)
			let q1 = (fq & 2) != 0 ?? (pc.refPoc[cur + 16 + int(pc.ref1[q])], -999999)
			let p0 = (fp & 1) != 0 ?? (pc.refPoc[base + int(pc.ref0[p])], -999999)
			let p1 = (fp & 2) != 0 ?? (pc.refPoc[base + 16 + int(pc.ref1[p])], -999999)
			let qx0 = int(pc.mvx0[q])
			let qy0 = int(pc.mvy0[q])
			let qx1 = int(pc.mvx1[q])
			let qy1 = int(pc.mvy1[q])
			let px0 = int(pc.mvx0[p])
			let py0 = int(pc.mvy0[p])
			let px1 = int(pc.mvx1[p])
			let py1 = int(pc.mvy1[p])
			if fq == 3 && fp == 3 {
				if q0 == p0 && q0 == q1 && p0 == p1 {
					let straight = hevcMvFar(px0, py0, qx0, qy0) || hevcMvFar(px1, py1, qx1, qy1)
					let crossed = hevcMvFar(px1, py1, qx0, qy0) || hevcMvFar(px0, py0, qx1, qy1)
					return (straight && crossed) ?? (1, 0)
				}
				return (hevcMvFar(px0, py0, qx0, qy0) || hevcMvFar(px1, py1, qx1, qy1)) ?? (1, 0) when p0 == q0 && p1 == q1
				return (hevcMvFar(px1, py1, qx0, qy0) || hevcMvFar(px0, py0, qx1, qy1)) ?? (1, 0) when p1 == q0 && p0 == q1
				return 1
			}
			return 1 when fq == 3 || fp == 3
			let ra = (fq & 1) != 0 ?? (q0, q1)
			let ax = (fq & 1) != 0 ?? (qx0, qx1)
			let ay = (fq & 1) != 0 ?? (qy0, qy1)
			let rb = (fp & 1) != 0 ?? (p0, p1)
			let bx = (fp & 1) != 0 ?? (px0, px1)
			let by = (fp & 1) != 0 ?? (py0, py1)
			return 1 when ra != rb
			return hevcMvFar(ax, ay, bx, by) ?? (1, 0)
		}

		// Records the boundary strengths of the left and top edges of the
		// transform (or coding) block at (x0, y0) and of the prediction
		// edges inside it (8.7.2.3, 8.7.2.4).
		def strengths(x0 int, y0 int, log2 int) {
			let s = sps
			let p = pic
			let size = 1 << log2
			let ctbMask = s.ctbSize - 1
			let l = s.log2CtbSize
			let cur = (y0 >> l) * s.ctbWidth + (x0 >> l)
			if y0 > 0 && (y0 & 7) == 0 {
				let edge = true
				if (y0 & ctbMask) == 0 {
					let above = cur - s.ctbWidth
					edge = false when !sh.loopFilterAcrossSlices && sliceAddr[above] != sliceAddr[cur]
					edge = false when !pps.loopFilterAcrossTiles && pps.tileId[pps.rsToTs[above]] != pps.tileId[pps.rsToTs[cur]]
				}
				if edge {
					for let i = 0; i < size && x0 + i < s.width; i += 4 {
						let q = at4(x0 + i, y0)
						let a = q - p.w4
						let bs = 0
						if p.pred[q] == byte(hevcPredIntra) || p.pred[a] == byte(hevcPredIntra) {
							bs = 2
						} else if cbf[q] != byte(0) || cbf[a] != byte(0) {
							bs = 1
						} else {
							bs = motionStrength(q, a, p.sliceAt(x0 + i, y0 - 1))
						}
						bsH[q] = byte(bs)
					}
				}
			}
			if x0 > 0 && (x0 & 7) == 0 {
				let edge = true
				if (x0 & ctbMask) == 0 {
					let left = cur - 1
					edge = false when !sh.loopFilterAcrossSlices && sliceAddr[left] != sliceAddr[cur]
					edge = false when !pps.loopFilterAcrossTiles && pps.tileId[pps.rsToTs[left]] != pps.tileId[pps.rsToTs[cur]]
				}
				if edge {
					for let j = 0; j < size && y0 + j < s.height; j += 4 {
						let q = at4(x0, y0 + j)
						let a = q - 1
						let bs = 0
						if p.pred[q] == byte(hevcPredIntra) || p.pred[a] == byte(hevcPredIntra) {
							bs = 2
						} else if cbf[q] != byte(0) || cbf[a] != byte(0) {
							bs = 1
						} else {
							bs = motionStrength(q, a, p.sliceAt(x0 - 1, y0 + j))
						}
						bsV[q] = byte(bs)
					}
				}
			}
			if size > 8 && p.pred[at4(x0, y0)] != byte(hevcPredIntra) {
				for let j = 8; j < size && y0 + j < s.height; j += 8 {
					for let i = 0; i < size && x0 + i < s.width; i += 4 {
						let q = at4(x0 + i, y0 + j)
						bsH[q] = byte(motionStrength(q, q - p.w4, curSlice))
					}
				}
				for let j = 0; j < size && y0 + j < s.height; j += 4 {
					for let i = 8; i < size && x0 + i < s.width; i += 8 {
						let q = at4(x0 + i, y0 + j)
						bsV[q] = byte(motionStrength(q, q - 1, curSlice))
					}
				}
			}
		}
	}

	// The single-position scan of a 4x4 block's group.
	const hevcScan1x1 = int[0]

	// Wraps a motion vector component to 16 bits (8.5.3.2.1).
	def hevcWrap16(v int) int {
		let u = (v + 65536) & 0xFFFF
		return u >= 32768 ?? (u - 65536, u)
	}

	// Whether two motion vectors differ by a full sample or more.
	def hevcMvFar(ax int, ay int, bx int, by int) bool {
		let dx = ax - bx
		let dy = ay - by
		return dx >= 4 || dx <= -4 || dy >= 4 || dy <= -4
	}

	// Scales a motion vector component by the POC distances `td` (of the
	// candidate) and `tb` (of the target) (8.5.3.2.8).
	def hevcScaleMv(mv int, td int, tb int) int {
		let d = td < -128 ?? (-128, td > 127 ?? (127, td))
		let b = tb < -128 ?? (-128, tb > 127 ?? (127, tb))
		let half = (d < 0 ?? (-d, d)) / 2
		let tx = (16384 + half) / d
		let f = (b * tx + 32) >> 6
		f = f < -4096 ?? (-4096, f > 4095 ?? (4095, f))
		let prod = f * mv
		let v = prod < 0 ?? (-((-prod + 127) >> 8), (prod + 127) >> 8)
		return v < -32768 ?? (-32768, v > 32767 ?? (32767, v))
	}

	// Reads `n` bits (n <= 16) at bit offset `pos` of `data`, MSB first.
	def hevcReadBits(data byte[], pos int, n int) int {
		let v = 0
		for let i = 0; i < n; i++ {
			let p = pos + i
			v = (v << 1) | ((int(data[p >> 3]) >> (7 - (p & 7))) & 1)
		}
		return v
	}
}
