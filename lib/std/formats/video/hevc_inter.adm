internal partial module std.formats.video.hevc {
	use std.simd

	// Fractional sample interpolation (8.5.3.3.3) and weighted sample
	// prediction (8.5.3.3.4) on SIMD vectors, eight samples at a time.
	// Predictions are 14-bit intermediates in `pred0`/`pred1`, row stride
	// 64; rows may hold up to seven values past the block's width.
	type HevcInter {
		pred0 int32[]
		pred1 int32[]
		// Reference samples around a block that reaches out of the
		// picture, edges replicated, row stride 80.
		patch uint16[]
		// Horizontal pass output of the two-pass filters, row stride 64.
		tmp   int32[]

		def new() {
			pred0.len(64 * 64)
			pred1.len(64 * 64)
			patch.len(80 * 80)
			tmp.len(72 * 64)
		}

		// Interpolates a w x h block at integer position (x, y) plus the
		// fraction (fx, fy) of `plane` into `out`, with the `taps`-tap
		// filters `filter` (8 luma taps in quarters, 4 chroma taps in
		// eighths).
		def interpolate(plane uint16[], stride int, pw int, ph int, x int, y int, fx int, fy int, w int, h int, taps int, filter int[], bitDepth int, out int32[]) {
			let half = taps / 2 - 1
			let wide = (w + 7) & ~7
			// Where the samples come from: the plane itself when the block,
			// its filter margins and the lanes past its width lie inside,
			// else a patch with the edges replicated.
			let inside = true
			let so = y * stride + x
			let sst = stride
			let x0 = x - half
			let y0 = y - half
			let x1 = x + wide + taps - half
			let y1 = y + h + taps - half
			if x0 < 0 || y0 < 0 || x1 > pw || y1 > ph || x1 > stride {
				let maxX = pw - 1
				let maxY = ph - 1
				let cols = wide + taps
				for let j = 0; j < h + taps; j++ {
					let yy = y0 + j
					yy = yy < 0 ?? (0, yy > maxY ?? (maxY, yy))
					let o = yy * stride
					for let i = 0; i < cols; i++ {
						let xx = x0 + i
						xx = xx < 0 ?? (0, xx > maxX ?? (maxX, xx))
						patch[j * 80 + i] = plane[o + xx]
					}
				}
				inside = false
				so = half * 80 + half
				sst = 80
			}
			if inside {
				hevcInterpolate(plane, so, sst, fx, fy, w, h, taps, filter, bitDepth, out, tmp)
			} else {
				hevcInterpolate(patch, so, sst, fx, fy, w, h, taps, filter, bitDepth, out, tmp)
			}
		}

		// Writes the w x h prediction `p` (stride 64) to `plane` at `at`:
		// default weighting when `weighted` is false, else weight `w0` with
		// offset `o0` at denominator `denom`.
		def putUni(plane uint16[], at int, stride int, w int, h int, p int32[], bitDepth int, weighted bool, denom int, w0 int, o0 int) {
			let maxv = (1 << bitDepth) - 1
			let shift = 14 - bitDepth
			let lo = simd.splat8<int32>(int32(0))
			let hi = simd.splat8<int32>(int32(maxv))
			let wide = w & ~7
			if !weighted {
				let off = shift > 0 ?? (1 << (shift - 1), 0)
				let offv = simd.splat8<int32>(int32(off))
				for let j = 0; j < h; j++ {
					let o = at + j * stride
					for let i = 0; i < wide; i += 8 {
						let v = (simd.load8<int32>(p, j * 64 + i) + offv) >> shift
						simd.store8<uint16>(plane, o + i, simd.convert<int32, uint16>(simd.clamp(v, lo, hi)))
					}
					for let i = wide; i < w; i++ {
						let v = (int(p[j * 64 + i]) + off) >> shift
						plane[o + i] = uint16(v < 0 ?? (0, v > maxv ?? (maxv, v)))
					}
				}
				return
			}
			let log2Wd = denom + shift
			let round = log2Wd >= 1 ?? (1 << (log2Wd - 1), 0)
			let wv = simd.splat8<int32>(int32(w0))
			let rv = simd.splat8<int32>(int32(round))
			let ov = simd.splat8<int32>(int32(o0))
			for let j = 0; j < h; j++ {
				let o = at + j * stride
				for let i = 0; i < wide; i += 8 {
					let v = ((simd.load8<int32>(p, j * 64 + i) * wv + rv) >> log2Wd) + ov
					simd.store8<uint16>(plane, o + i, simd.convert<int32, uint16>(simd.clamp(v, lo, hi)))
				}
				for let i = wide; i < w; i++ {
					let v = ((int(p[j * 64 + i]) * w0 + round) >> log2Wd) + o0
					plane[o + i] = uint16(v < 0 ?? (0, v > maxv ?? (maxv, v)))
				}
			}
		}

		// Writes the average (or weighted sum) of `pred0` and `pred1`.
		def putBi(plane uint16[], at int, stride int, w int, h int, bitDepth int, weighted bool, denom int, w0 int, o0 int, w1 int, o1 int) {
			let maxv = (1 << bitDepth) - 1
			let a = pred0
			let b = pred1
			let lo = simd.splat8<int32>(int32(0))
			let hi = simd.splat8<int32>(int32(maxv))
			let wide = w & ~7
			if !weighted {
				let shift = 15 - bitDepth
				let off = 1 << (shift - 1)
				let offv = simd.splat8<int32>(int32(off))
				for let j = 0; j < h; j++ {
					let o = at + j * stride
					for let i = 0; i < wide; i += 8 {
						let q = j * 64 + i
						let v = (simd.load8<int32>(a, q) + simd.load8<int32>(b, q) + offv) >> shift
						simd.store8<uint16>(plane, o + i, simd.convert<int32, uint16>(simd.clamp(v, lo, hi)))
					}
					for let i = wide; i < w; i++ {
						let v = (int(a[j * 64 + i]) + int(b[j * 64 + i]) + off) >> shift
						plane[o + i] = uint16(v < 0 ?? (0, v > maxv ?? (maxv, v)))
					}
				}
				return
			}
			let log2Wd = denom + 14 - bitDepth
			let off = (o0 + o1 + 1) << log2Wd
			let w0v = simd.splat8<int32>(int32(w0))
			let w1v = simd.splat8<int32>(int32(w1))
			let offv = simd.splat8<int32>(int32(off))
			for let j = 0; j < h; j++ {
				let o = at + j * stride
				for let i = 0; i < wide; i += 8 {
					let q = j * 64 + i
					let v = (simd.load8<int32>(a, q) * w0v + simd.load8<int32>(b, q) * w1v + offv) >> (log2Wd + 1)
					simd.store8<uint16>(plane, o + i, simd.convert<int32, uint16>(simd.clamp(v, lo, hi)))
				}
				for let i = wide; i < w; i++ {
					let v = (int(a[j * 64 + i]) * w0 + int(b[j * 64 + i]) * w1 + off) >> (log2Wd + 1)
					plane[o + i] = uint16(v < 0 ?? (0, v > maxv ?? (maxv, v)))
				}
			}
		}
	}

	// The interpolation of `HevcInter.interpolate` from the samples of
	// `src` at `so` (row stride `sst`), which hold the block's filter
	// margins and the lanes past its width.
	def hevcInterpolate(src uint16[], so int, sst int, fx int, fy int, w int, h int, taps int, filter int[], bitDepth int, out int32[], tmp int32[]) {
		let shift1 = bitDepth - 8
		if fx == 0 && fy == 0 {
			let shift3 = 14 - bitDepth
			for let j = 0; j < h; j++ {
				let p = so + j * sst
				for let i = 0; i < w; i += 8 {
					let v = simd.convert<uint16, int32>(simd.load8<uint16>(src, p + i))
					simd.store8<int32>(out, j * 64 + i, v << shift3)
				}
			}
			return
		}
		if taps == 8 {
			let fh = fx * 8
			let c0 = simd.splat8<int32>(int32(filter[fh]))
			let c1 = simd.splat8<int32>(int32(filter[fh + 1]))
			let c2 = simd.splat8<int32>(int32(filter[fh + 2]))
			let c3 = simd.splat8<int32>(int32(filter[fh + 3]))
			let c4 = simd.splat8<int32>(int32(filter[fh + 4]))
			let c5 = simd.splat8<int32>(int32(filter[fh + 5]))
			let c6 = simd.splat8<int32>(int32(filter[fh + 6]))
			let c7 = simd.splat8<int32>(int32(filter[fh + 7]))
			let fv = fy * 8
			let d0 = simd.splat8<int32>(int32(filter[fv]))
			let d1 = simd.splat8<int32>(int32(filter[fv + 1]))
			let d2 = simd.splat8<int32>(int32(filter[fv + 2]))
			let d3 = simd.splat8<int32>(int32(filter[fv + 3]))
			let d4 = simd.splat8<int32>(int32(filter[fv + 4]))
			let d5 = simd.splat8<int32>(int32(filter[fv + 5]))
			let d6 = simd.splat8<int32>(int32(filter[fv + 6]))
			let d7 = simd.splat8<int32>(int32(filter[fv + 7]))
			if fy == 0 {
				for let j = 0; j < h; j++ {
					let p = so + j * sst - 3
					for let i = 0; i < w; i += 8 {
						let q = p + i
						let acc = c0 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q))
						acc += c1 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 1))
						acc += c2 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 2))
						acc += c3 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 3))
						acc += c4 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 4))
						acc += c5 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 5))
						acc += c6 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 6))
						acc += c7 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 7))
						simd.store8<int32>(out, j * 64 + i, acc >> shift1)
					}
				}
				return
			}
			if fx == 0 {
				for let j = 0; j < h; j++ {
					let p = so + (j - 3) * sst
					for let i = 0; i < w; i += 8 {
						let q = p + i
						let acc = d0 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q))
						acc += d1 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + sst))
						acc += d2 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 2 * sst))
						acc += d3 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 3 * sst))
						acc += d4 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 4 * sst))
						acc += d5 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 5 * sst))
						acc += d6 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 6 * sst))
						acc += d7 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 7 * sst))
						simd.store8<int32>(out, j * 64 + i, acc >> shift1)
					}
				}
				return
			}
			for let j = 0; j < h + 7; j++ {
				let p = so + (j - 3) * sst - 3
				for let i = 0; i < w; i += 8 {
					let q = p + i
					let acc = c0 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q))
					acc += c1 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 1))
					acc += c2 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 2))
					acc += c3 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 3))
					acc += c4 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 4))
					acc += c5 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 5))
					acc += c6 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 6))
					acc += c7 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 7))
					simd.store8<int32>(tmp, j * 64 + i, acc >> shift1)
				}
			}
			for let j = 0; j < h; j++ {
				for let i = 0; i < w; i += 8 {
					let q = j * 64 + i
					let acc = d0 * simd.load8<int32>(tmp, q)
					acc += d1 * simd.load8<int32>(tmp, q + 64)
					acc += d2 * simd.load8<int32>(tmp, q + 128)
					acc += d3 * simd.load8<int32>(tmp, q + 192)
					acc += d4 * simd.load8<int32>(tmp, q + 256)
					acc += d5 * simd.load8<int32>(tmp, q + 320)
					acc += d6 * simd.load8<int32>(tmp, q + 384)
					acc += d7 * simd.load8<int32>(tmp, q + 448)
					simd.store8<int32>(out, q, acc >> 6)
				}
			}
			return
		}
		let fh = fx * 4
		let c0 = simd.splat8<int32>(int32(filter[fh]))
		let c1 = simd.splat8<int32>(int32(filter[fh + 1]))
		let c2 = simd.splat8<int32>(int32(filter[fh + 2]))
		let c3 = simd.splat8<int32>(int32(filter[fh + 3]))
		let fv = fy * 4
		let d0 = simd.splat8<int32>(int32(filter[fv]))
		let d1 = simd.splat8<int32>(int32(filter[fv + 1]))
		let d2 = simd.splat8<int32>(int32(filter[fv + 2]))
		let d3 = simd.splat8<int32>(int32(filter[fv + 3]))
		if fy == 0 {
			for let j = 0; j < h; j++ {
				let p = so + j * sst - 1
				for let i = 0; i < w; i += 8 {
					let q = p + i
					let acc = c0 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q))
					acc += c1 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 1))
					acc += c2 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 2))
					acc += c3 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 3))
					simd.store8<int32>(out, j * 64 + i, acc >> shift1)
				}
			}
			return
		}
		if fx == 0 {
			for let j = 0; j < h; j++ {
				let p = so + (j - 1) * sst
				for let i = 0; i < w; i += 8 {
					let q = p + i
					let acc = d0 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q))
					acc += d1 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + sst))
					acc += d2 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 2 * sst))
					acc += d3 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 3 * sst))
					simd.store8<int32>(out, j * 64 + i, acc >> shift1)
				}
			}
			return
		}
		for let j = 0; j < h + 3; j++ {
			let p = so + (j - 1) * sst - 1
			for let i = 0; i < w; i += 8 {
				let q = p + i
				let acc = c0 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q))
				acc += c1 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 1))
				acc += c2 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 2))
				acc += c3 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 3))
				simd.store8<int32>(tmp, j * 64 + i, acc >> shift1)
			}
		}
		for let j = 0; j < h; j++ {
			for let i = 0; i < w; i += 8 {
				let q = j * 64 + i
				let acc = d0 * simd.load8<int32>(tmp, q)
				acc += d1 * simd.load8<int32>(tmp, q + 64)
				acc += d2 * simd.load8<int32>(tmp, q + 128)
				acc += d3 * simd.load8<int32>(tmp, q + 192)
				simd.store8<int32>(out, q, acc >> 6)
			}
		}
	}
}
