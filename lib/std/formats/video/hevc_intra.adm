internal partial module std.formats.video.hevc {
	// Intra sample prediction (8.4.4.2) of one n x n block from its
	// neighbours. `left[1 + i]` is the sample left of row i and `top[1 +
	// i]` the one above column i, for i in -1 ..< 2n (so index 0 of both is
	// the corner); the arrays are the substituted neighbours and are
	// filtered in place when the mode asks for it.
	type HevcIntra {
		left  int[]
		top   int[]
		fleft int[]
		ftop  int[]
		ref   int[]
		// Availability of each neighbour in substitution order.
		avail bool[]

		def new() {
			avail.len(4 * 64 + 1)
			left.len(130)
			top.len(130)
			fleft.len(130)
			ftop.len(130)
			ref.len(3 * 64 + 8)
		}

		// Predicts the block at `at` of `plane`. `smoothing` allows the
		// neighbour filter (luma, or 4:4:4 chroma, unless the SPS disables
		// it), `strong` the bi-linear 32x32 one; `edges` the DC and pure
		// horizontal/vertical boundary filters (luma blocks under 32).
		def predict(plane uint16[], at int, stride int, log2 int, mode int, bitDepth int, smoothing bool, strong bool, edges bool) {
			let n = 1 << log2
			let l = left
			let t = top
			if smoothing && mode != 1 && n != 4 {
				let dist = mode - 26 < 0 ?? (26 - mode, mode - 26)
				let dist2 = mode - 10 < 0 ?? (10 - mode, mode - 10)
				dist = dist2 when dist2 < dist
				let threshold = log2 == 3 ?? (7, log2 == 4 ?? (1, 0))
				if dist > threshold {
					let limit = 1 << (bitDepth - 5)
					let a = t[0] + t[64] - 2 * t[32]
					let b = l[0] + l[64] - 2 * l[32]
					a = -a when a < 0
					b = -b when b < 0
					if strong && log2 == 5 && a < limit && b < limit {
						ftop[0] = t[0]
						ftop[64] = t[64]
						fleft[0] = l[0]
						fleft[64] = l[64]
						for let i = 0; i < 63; i++ {
							ftop[1 + i] = ((63 - i) * t[0] + (i + 1) * t[64] + 32) >> 6
							fleft[1 + i] = ((63 - i) * l[0] + (i + 1) * l[64] + 32) >> 6
						}
					} else {
						let m = 2 * n
						fleft[m] = l[m]
						ftop[m] = t[m]
						for let i = 1; i < m; i++ {
							fleft[i] = (l[i + 1] + 2 * l[i] + l[i - 1] + 2) >> 2
							ftop[i] = (t[i + 1] + 2 * t[i] + t[i - 1] + 2) >> 2
						}
						let corner = (l[1] + 2 * l[0] + t[1] + 2) >> 2
						fleft[0] = corner
						ftop[0] = corner
					}
					l = fleft
					t = ftop
				}
			}
			if mode == 0 {
				let sh = log2 + 1
				for let y = 0; y < n; y++ {
					let o = at + y * stride
					for let x = 0; x < n; x++ {
						plane[o + x] = uint16(((n - 1 - x) * l[1 + y] + (x + 1) * t[1 + n] + (n - 1 - y) * t[1 + x] + (y + 1) * l[1 + n] + n) >> sh)
					}
				}
				return
			}
			if mode == 1 {
				let dc = n
				for let i = 0; i < n; i++ {
					dc += l[1 + i] + t[1 + i]
				}
				dc = dc >> (log2 + 1)
				for let y = 0; y < n; y++ {
					let o = at + y * stride
					for let x = 0; x < n; x++ {
						plane[o + x] = uint16(dc)
					}
				}
				if edges && n < 32 {
					plane[at] = uint16((l[1] + 2 * dc + t[1] + 2) >> 2)
					for let x = 1; x < n; x++ {
						plane[at + x] = uint16((t[1 + x] + 3 * dc + 2) >> 2)
					}
					for let y = 1; y < n; y++ {
						plane[at + y * stride] = uint16((l[1 + y] + 3 * dc + 2) >> 2)
					}
				}
				return
			}
			let angle = hevcIntraAngle[mode - 2]
			let maxv = (1 << bitDepth) - 1
			let r = ref
			// r[n + k] is reference sample k for k in -n ..= 2n.
			let base = n
			let last = (n * angle) >> 5
			let main = mode >= 18 ?? (t, l)
			let side = mode >= 18 ?? (l, t)
			for let k = 0; k <= 2 * n; k++ {
				r[base + k] = main[k]
			}
			if angle < 0 && last < -1 {
				let inv = hevcInvAngle[mode - 11]
				for let k = last; k <= -1; k++ {
					r[base + k] = side[((k * inv + 128) >> 8)]
				}
			}
			for let j = 0; j < n; j++ {
				let idx = ((j + 1) * angle) >> 5
				let fact = ((j + 1) * angle) & 31
				for let i = 0; i < n; i++ {
					let p = base + i + idx + 1
					let v = fact != 0 ?? (((32 - fact) * r[p] + fact * r[p + 1] + 16) >> 5, r[p])
					if mode >= 18 {
						plane[at + j * stride + i] = uint16(v)
					} else {
						plane[at + i * stride + j] = uint16(v)
					}
				}
			}
			if edges && n < 32 {
				if mode == 26 {
					for let y = 0; y < n; y++ {
						let v = t[1] + ((l[1 + y] - l[0]) >> 1)
						plane[at + y * stride] = uint16(v < 0 ?? (0, v > maxv ?? (maxv, v)))
					}
				} else if mode == 10 {
					for let x = 0; x < n; x++ {
						let v = l[1] + ((t[1 + x] - t[0]) >> 1)
						plane[at + x] = uint16(v < 0 ?? (0, v > maxv ?? (maxv, v)))
					}
				}
			}
		}
	}
}
