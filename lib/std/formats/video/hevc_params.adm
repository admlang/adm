internal partial module std.formats.video.hevc {
	use std.formats.video.h264::(H264Bits)

	// A short-term reference picture set (7.3.7, 7.4.8): POC deltas, negative
	// ones first (closest first), then positive ones, and which the current
	// picture uses.
	type HevcRps {
		deltaPoc    int[]
		used        bool[]
		numNegative int
		numDeltas   int

		def new() {
			deltaPoc.len(32)
			used.len(32)
		}
	}

	// A scaling list set (7.3.4): per size 4x4..32x32 and matrix (intra
	// Y, Cb, Cr, inter Y, Cb, Cr) the 8x8 coefficients (16 for 4x4) in
	// raster order, and the DC values of 16x16 and 32x32.
	type HevcScaling {
		list int[]
		dc   int[]

		// The default lists.
		def new() {
			list.len(4 * 6 * 64)
			dc.len(2 * 6)
			for let m = 0; m < 6; m++ {
				for let i = 0; i < 16; i++ {
					list[m * 64 + i] = 16
				}
				dc[m] = 16
				dc[6 + m] = 16
				for let size = 1; size < 4; size++ {
					let table = m < 3 ?? (hevcDefaultScalingIntra, hevcDefaultScalingInter)
					for let i = 0; i < 64; i++ {
						list[(size * 6 + m) * 64 + i] = table[i]
					}
				}
			}
		}

		// Reads scaling_list_data() (7.3.4); `chroma444` copies the 32x32
		// chroma lists from 16x16 as 4:4:4 streams require.
		//
		// Fails on an out of range reference or DC value.
		def read(b H264Bits, chroma444 bool) !none {
			for let size = 0; size < 4; size++ {
				let step = size == 3 ?? (3, 1)
				for let m = 0; m < 6; m += step {
					if !b.flag() {
						let delta = b.ue() * step
						if delta != 0 {
							fail "hevc: scaling list reference out of range" when m < delta
							let n = size > 0 ?? (64, 16)
							for let i = 0; i < n; i++ {
								list[(size * 6 + m) * 64 + i] = list[(size * 6 + m - delta) * 64 + i]
							}
							dc[(size - 2) * 6 + m] = dc[(size - 2) * 6 + m - delta] when size > 1
						}
						continue
					}
					let next = 8
					let count = size == 0 ?? (16, 64)
					if size > 1 {
						let v = b.se()
						fail "hevc: scaling list DC out of range" when v < -7 || v > 247
						next = v + 8
						dc[(size - 2) * 6 + m] = next
					}
					for let i = 0; i < count; i++ {
						let pos = size == 0 ?? (4 * hevcDiag4x4Y[i] + hevcDiag4x4X[i], 8 * hevcDiag8x8Y[i] + hevcDiag8x8X[i])
						next = (next + 256 + b.se()) % 256
						list[(size * 6 + m) * 64 + pos] = next
					}
				}
			}
			if chroma444 {
				for let (_, m) in int[1, 2, 4, 5] {
					for let i = 0; i < 64; i++ {
						list[(3 * 6 + m) * 64 + i] = list[(2 * 6 + m) * 64 + i]
					}
					dc[6 + m] = dc[m]
				}
			}
			return none
		}
	}

	// A sequence parameter set (7.3.2.2) and what follows from it.
	type HevcSps {
		id                     int
		chromaFormat           int
		width                  int
		height                 int
		// Conformance window in luma samples.
		cropLeft               int
		cropRight              int
		cropTop                int
		cropBottom             int
		bitDepth               int
		bitDepthChroma         int
		log2MaxPocLsb          int
		maxDecPicBuffering     int
		numReorderPics         int
		// sps_max_latency_increase_plus1 of the highest sub-layer.
		maxLatencyIncrease     int
		log2MinCbSize          int
		log2CtbSize            int
		log2MinTbSize          int
		log2MaxTrafoSize       int
		maxTrafoDepthInter     int
		maxTrafoDepthIntra     int
		scalingEnabled         bool
		scaling                HevcScaling
		ampEnabled             bool
		saoEnabled             bool
		pcmEnabled             bool
		pcmBitDepth            int
		pcmBitDepthChroma      int
		log2MinPcmSize         int
		log2MaxPcmSize         int
		pcmLoopFilterDisabled  bool
		rps                    HevcRps[]
		longTermPresent        bool
		ltPocLsb               int[]
		ltUsed                 bool[]
		temporalMvpEnabled     bool
		strongIntraSmoothing   bool
		fullRange              bool
		matrix                 int
		// Range extension flags (7.3.2.2.2).
		transformSkipRotation  bool
		transformSkipContext   bool
		implicitRdpcm          bool
		explicitRdpcm          bool
		extendedPrecision      bool
		intraSmoothingDisabled bool
		highPrecisionOffsets   bool
		persistentRice         bool
		cabacBypassAlignment   bool
		profile                int
		// Set by the decoder, distinct per parsed SPS.
		serial                 int
		// Derived.
		ctbSize                int
		ctbWidth               int
		ctbHeight              int
		minCbWidth             int
		minCbHeight            int
		minTbWidth             int
		minTbHeight            int
		log2MinPuSize          int
		minPuWidth             int
		minPuHeight            int
		tbMask                 int
		qpBdOffset             int
		// Chroma subsampling shifts per component.
		hshift                 int[]
		vshift                 int[]

		def new() {
			hshift.len(3)
			vshift.len(3)
			scaling = new HevcScaling()
			matrix = 709
		}
	}

	// Reads profile_tier_level() (7.3.3) and returns general_profile_idc.
	def hevcSkipPtl(b H264Bits, maxSubLayers int) int {
		b.skip(3)
		let profile = b.u(5)
		let compat = b.u(32)
		if profile == 0 {
			for let i = 1; i < 32; i++ {
				if ((compat >> (31 - i)) & 1) != 0 {
					profile = i
					break
				}
			}
		}
		b.skip(4 + 43 + 1)
		b.skip(8)
		let profilePresent bool[]
		let levelPresent bool[]
		for let i = 0; i < maxSubLayers - 1; i++ {
			profilePresent.push(b.flag())
			levelPresent.push(b.flag())
		}
		if maxSubLayers > 1 {
			for let i = maxSubLayers - 1; i < 8; i++ {
				b.skip(2)
			}
		}
		for let i = 0; i < maxSubLayers - 1; i++ {
			b.skip(88) when profilePresent[i]
			b.skip(8) when levelPresent[i]
		}
		return profile
	}

	// Skips hrd_parameters() (E.2.2).
	def hevcSkipHrd(b H264Bits, commonInf bool, maxSubLayers int) {
		let nal = false
		let vcl = false
		let subPic = false
		if commonInf {
			nal = b.flag()
			vcl = b.flag()
			if nal || vcl {
				subPic = b.flag()
				b.skip(8 + 5 + 1 + 5) when subPic
				b.skip(4 + 4)
				b.skip(4) when subPic
				b.skip(5 + 5 + 5)
			}
		}
		for let i = 0; i < maxSubLayers; i++ {
			let fixedGeneral = b.flag()
			let fixedCvs = fixedGeneral || b.flag()
			let lowDelay = false
			if fixedCvs {
				b.ue()
			} else {
				lowDelay = b.flag()
			}
			let cpbCount = 1
			cpbCount = b.ue() + 1 when !lowDelay
			let passes = (nal ?? (1, 0)) + (vcl ?? (1, 0))
			for let p = 0; p < passes; p++ {
				for let c = 0; c < cpbCount; c++ {
					b.ue()
					b.ue()
					if subPic {
						b.ue()
						b.ue()
					}
					b.skip(1)
				}
			}
		}
	}

	// Reads st_ref_pic_set(idx) (7.3.7) into `rps`; `inSlice` for the one a
	// slice header codes, which predicts from the SPS sets.
	//
	// Fails on out of range values.
	def hevcReadRps(b H264Bits, rps HevcRps, sets HevcRps[], idx int, inSlice bool) !none {
		let predict = idx != 0 && b.flag()
		if predict {
			let refIdx = idx - 1
			if inSlice {
				let delta = b.ue() + 1
				fail "hevc: RPS prediction out of range" when delta > idx
				refIdx = idx - delta
			}
			let ref = sets[refIdx]
			let sign = b.flag()
			let absDelta = b.ue() + 1
			fail "hevc: RPS delta out of range" when absDelta > 32768
			let deltaRps = sign ?? (0 - absDelta, absDelta)
			let k = 0
			let k0 = 0
			let used bool[]
			used.len(33)
			for let i = 0; i <= ref.numDeltas; i++ {
				let u = b.flag()
				let useDelta = u || b.flag()
				if useDelta {
					fail "hevc: too many RPS entries" when k >= 32
					let d = i < ref.numDeltas ?? (deltaRps + ref.deltaPoc[i], deltaRps)
					rps.deltaPoc[k] = d
					used[k] = u
					k0++ when d < 0
					k++
				}
			}
			rps.numDeltas = k
			rps.numNegative = k0
			// Increasing order, then the negative ones reversed.
			for let i = 1; i < k; i++ {
				let d = rps.deltaPoc[i]
				let u = used[i]
				let j = i - 1
				for j >= 0 && rps.deltaPoc[j] > d {
					rps.deltaPoc[j + 1] = rps.deltaPoc[j]
					used[j + 1] = used[j]
					j--
				}
				rps.deltaPoc[j + 1] = d
				used[j + 1] = u
			}
			for let i = 0; i < k0 / 2; i++ {
				let d = rps.deltaPoc[i]
				let u = used[i]
				rps.deltaPoc[i] = rps.deltaPoc[k0 - 1 - i]
				used[i] = used[k0 - 1 - i]
				rps.deltaPoc[k0 - 1 - i] = d
				used[k0 - 1 - i] = u
			}
			for let i = 0; i < 32; i++ {
				rps.used[i] = used[i]
			}
			return none
		}
		let negative = b.ue()
		let positive = b.ue()
		fail "hevc: too many reference pictures in an RPS" when negative >= 16 || positive >= 16
		rps.numNegative = negative
		rps.numDeltas = negative + positive
		let prev = 0
		for let i = 0; i < negative; i++ {
			let d = b.ue() + 1
			fail "hevc: RPS delta out of range" when d > 32768
			prev -= d
			rps.deltaPoc[i] = prev
			rps.used[i] = b.flag()
		}
		prev = 0
		for let i = 0; i < positive; i++ {
			let d = b.ue() + 1
			fail "hevc: RPS delta out of range" when d > 32768
			prev += d
			rps.deltaPoc[negative + i] = prev
			rps.used[negative + i] = b.flag()
		}
		return none
	}

	// Reads a sequence parameter set (7.3.2.2) from the RBSP after its NAL
	// header.
	//
	// Fails on invalid or unsupported values.
	def hevcParseSps(b H264Bits) !HevcSps {
		let s = new HevcSps()
		b.skip(4)
		let maxSubLayers = b.u(3) + 1
		fail "hevc: too many sub-layers" when maxSubLayers > 7
		b.skip(1)
		s.profile = hevcSkipPtl(b, maxSubLayers)
		s.id = b.ue()
		fail "hevc: SPS id out of range" when s.id >= 16
		s.chromaFormat = b.ue()
		fail "hevc: bad chroma format" when s.chromaFormat > 3
		fail "hevc: 4:4:4 coded as separate colour planes is not supported" when s.chromaFormat == 3 && b.flag()
		s.width = b.ue()
		s.height = b.ue()
		fail "hevc: bad picture size" when s.width <= 0 || s.height <= 0 || s.width > 16888 || s.height > 16888
		let subW = (s.chromaFormat := 1 || 2) ?? (2, 1)
		let subH = s.chromaFormat == 1 ?? (2, 1)
		if b.flag() {
			s.cropLeft = b.ue() * subW
			s.cropRight = b.ue() * subW
			s.cropTop = b.ue() * subH
			s.cropBottom = b.ue() * subH
			if s.cropLeft + s.cropRight >= s.width || s.cropTop + s.cropBottom >= s.height {
				s.cropLeft = 0
				s.cropRight = 0
				s.cropTop = 0
				s.cropBottom = 0
			}
		}
		s.bitDepth = b.ue() + 8
		s.bitDepthChroma = b.ue() + 8
		fail "hevc: bit depth {s.bitDepth} is not supported" when s.bitDepth > 14 || s.bitDepthChroma > 14
		fail "hevc: luma and chroma of different bit depths are not supported" when s.chromaFormat != 0 && s.bitDepth != s.bitDepthChroma
		s.log2MaxPocLsb = b.ue() + 4
		fail "hevc: bad log2_max_pic_order_cnt_lsb" when s.log2MaxPocLsb > 16
		let orderingInfo = b.flag()
		let first = orderingInfo ?? (0, maxSubLayers - 1)
		for let i = first; i < maxSubLayers; i++ {
			s.maxDecPicBuffering = b.ue() + 1
			s.numReorderPics = b.ue()
			s.maxLatencyIncrease = b.ue()
		}
		fail "hevc: DPB too large" when s.maxDecPicBuffering > 16
		s.maxDecPicBuffering = s.numReorderPics + 1 when s.numReorderPics > s.maxDecPicBuffering - 1
		s.log2MinCbSize = b.ue() + 3
		s.log2CtbSize = s.log2MinCbSize + b.ue()
		s.log2MinTbSize = b.ue() + 2
		s.log2MaxTrafoSize = s.log2MinTbSize + b.ue()
		fail "hevc: bad coding block sizes" when s.log2CtbSize > 6 || s.log2CtbSize < 4 || s.log2MinTbSize >= s.log2MinCbSize
		fail "hevc: bad transform block sizes" when s.log2MaxTrafoSize > 5 || s.log2MaxTrafoSize > s.log2CtbSize
		s.maxTrafoDepthInter = b.ue()
		s.maxTrafoDepthIntra = b.ue()
		fail "hevc: bad transform hierarchy depth" when s.maxTrafoDepthInter > s.log2CtbSize - s.log2MinTbSize || s.maxTrafoDepthIntra > s.log2CtbSize - s.log2MinTbSize
		s.scalingEnabled = b.flag()
		if s.scalingEnabled && b.flag() {
			try s.scaling.read(b, s.chromaFormat == 3)
		}
		s.ampEnabled = b.flag()
		s.saoEnabled = b.flag()
		s.pcmEnabled = b.flag()
		if s.pcmEnabled {
			s.pcmBitDepth = b.u(4) + 1
			s.pcmBitDepthChroma = b.u(4) + 1
			s.log2MinPcmSize = b.ue() + 3
			s.log2MaxPcmSize = s.log2MinPcmSize + b.ue()
			fail "hevc: PCM bit depth above the sample bit depth" when s.pcmBitDepth > s.bitDepth || s.pcmBitDepthChroma > s.bitDepthChroma
			s.pcmLoopFilterDisabled = b.flag()
		}
		let count = b.ue()
		fail "hevc: too many short-term RPS" when count > 64
		for let i = 0; i < count; i++ {
			let r = new HevcRps()
			s.rps.push(r)
			try hevcReadRps(b, r, s.rps, i, false)
		}
		s.longTermPresent = b.flag()
		if s.longTermPresent {
			let n = b.ue()
			fail "hevc: too many long-term pictures" when n > 32
			for let i = 0; i < n; i++ {
				s.ltPocLsb.push(b.u(s.log2MaxPocLsb))
				s.ltUsed.push(b.flag())
			}
		}
		s.temporalMvpEnabled = b.flag()
		s.strongIntraSmoothing = b.flag()
		hevcReadVui(b, s, maxSubLayers) when b.flag()
		if b.flag() {
			let range = b.flag()
			// The multilayer and 3D extension flags.
			b.skip(2)
			let scc = b.flag()
			b.skip(4)
			fail "hevc: screen content coding is not supported" when scc && s.profile >= 9
			if range {
				s.transformSkipRotation = b.flag()
				s.transformSkipContext = b.flag()
				s.implicitRdpcm = b.flag()
				s.explicitRdpcm = b.flag()
				s.extendedPrecision = b.flag()
				s.intraSmoothingDisabled = b.flag()
				s.highPrecisionOffsets = b.flag()
				s.persistentRice = b.flag()
				s.cabacBypassAlignment = b.flag()
			}
		}
		fail "hevc: extended precision processing is not supported" when s.extendedPrecision
		fail "hevc: CABAC bypass alignment is not supported" when s.cabacBypassAlignment
		s.ctbSize = 1 << s.log2CtbSize
		s.ctbWidth = (s.width + s.ctbSize - 1) >> s.log2CtbSize
		s.ctbHeight = (s.height + s.ctbSize - 1) >> s.log2CtbSize
		s.minCbWidth = s.width >> s.log2MinCbSize
		s.minCbHeight = s.height >> s.log2MinCbSize
		fail "hevc: picture size not a multiple of the minimum coding block" when (s.width & ((1 << s.log2MinCbSize) - 1)) != 0 || (s.height & ((1 << s.log2MinCbSize) - 1)) != 0
		s.minTbWidth = s.width >> s.log2MinTbSize
		s.minTbHeight = s.height >> s.log2MinTbSize
		s.log2MinPuSize = s.log2MinCbSize - 1
		s.minPuWidth = s.width >> s.log2MinPuSize
		s.minPuHeight = s.height >> s.log2MinPuSize
		s.tbMask = (1 << (s.log2CtbSize - s.log2MinTbSize)) - 1
		s.qpBdOffset = 6 * (s.bitDepth - 8)
		s.hshift[1] = subW - 1
		s.hshift[2] = subW - 1
		s.vshift[1] = subH - 1
		s.vshift[2] = subH - 1
		return s
	}

	// Reads the VUI (E.2.1) for the sample range and colour matrix, skipping
	// the rest.
	def hevcReadVui(b H264Bits, s HevcSps, maxSubLayers int) {
		if b.flag() {
			let idc = b.u(8)
			b.skip(32) when idc == 255
		}
		b.skip(1) when b.flag()
		if b.flag() {
			b.skip(3)
			s.fullRange = b.flag()
			if b.flag() {
				b.skip(16)
				let m = b.u(8)
				s.matrix = (m := 5 || 6) ?? (601, 709)
			}
		}
		if b.flag() {
			b.ue()
			b.ue()
		}
		b.skip(3)
		if b.flag() {
			b.ue()
			b.ue()
			b.ue()
			b.ue()
		}
		if b.flag() {
			b.skip(64)
			b.ue() when b.flag()
			hevcSkipHrd(b, true, maxSubLayers) when b.flag()
		}
		if b.flag() {
			b.skip(3)
			b.ue()
			b.ue()
			b.ue()
			b.ue()
			b.ue()
		}
	}

	// A picture parameter set (7.3.2.3) and its tile tables once set up
	// against its SPS.
	type HevcPps {
		id                        int
		spsId                     int
		dependentSlices           bool
		outputFlagPresent         bool
		extraSliceHeaderBits      int
		signDataHiding            bool
		cabacInitPresent          bool
		numRefIdxL0Default        int
		numRefIdxL1Default        int
		initQp                    int
		constrainedIntraPred      bool
		transformSkipEnabled      bool
		cuQpDeltaEnabled          bool
		diffCuQpDeltaDepth        int
		cbQpOffset                int
		crQpOffset                int
		sliceChromaQpOffsets      bool
		weightedPred              bool
		weightedBipred            bool
		transquantBypass          bool
		tilesEnabled              bool
		entropySync               bool
		numTileColumns            int
		numTileRows               int
		uniformSpacing            bool
		columnWidth               int[]
		rowHeight                 int[]
		loopFilterAcrossTiles     bool
		loopFilterAcrossSlices    bool
		deblockingOverride        bool
		deblockingDisabled        bool
		betaOffset                int
		tcOffset                  int
		scalingPresent            bool
		scaling                   HevcScaling
		listsModification         bool
		log2ParallelMergeLevel    int
		sliceHeaderExtension      bool
		log2MaxTransformSkipSize  int
		crossComponentPred        bool
		chromaQpOffsetList        bool
		diffCuChromaQpOffsetDepth int
		chromaQpOffsetListLen     int
		cbQpOffsetList            int[]
		crQpOffsetList            int[]
		log2SaoOffsetScaleLuma    int
		log2SaoOffsetScaleChroma  int
		// Tile tables against `setupFor` (6.5.1): tile column and row
		// boundaries in CTBs, raster/tile scan CTB address maps, tile index
		// per tile-scan address, z-scan order of minimum transform blocks
		// with a border of -1 (row stride tbMask + 2).
		setupFor                  ?HevcSps
		setupSerial               int         = -1
		colBd                     int[]
		rowBd                     int[]
		colIdx                    int[]
		rsToTs                    int[]
		tsToRs                    int[]
		tileId                    int[]
		minTbAddrZs               int[]

		def new() {
			loopFilterAcrossTiles = true
			numTileColumns = 1
			numTileRows = 1
			uniformSpacing = true
			log2MaxTransformSkipSize = 2
			cbQpOffsetList.len(6)
			crQpOffsetList.len(6)
			scaling = new HevcScaling()
		}

		// Builds the tile and scan tables for `s` (6.5).
		def setup(s HevcSps) {
			setupFor = s
			if uniformSpacing {
				columnWidth.len(numTileColumns)
				rowHeight.len(numTileRows)
				for let i = 0; i < numTileColumns; i++ {
					columnWidth[i] = ((i + 1) * s.ctbWidth) / numTileColumns - (i * s.ctbWidth) / numTileColumns
				}
				for let i = 0; i < numTileRows; i++ {
					rowHeight[i] = ((i + 1) * s.ctbHeight) / numTileRows - (i * s.ctbHeight) / numTileRows
				}
			}
			colBd.len(numTileColumns + 1)
			rowBd.len(numTileRows + 1)
			colBd[0] = 0
			for let i = 0; i < numTileColumns; i++ {
				colBd[i + 1] = colBd[i] + columnWidth[i]
			}
			rowBd[0] = 0
			for let i = 0; i < numTileRows; i++ {
				rowBd[i + 1] = rowBd[i] + rowHeight[i]
			}
			colIdx.len(s.ctbWidth)
			let j = 0
			for let i = 0; i < s.ctbWidth; i++ {
				j++ when i >= colBd[j + 1] && j + 1 < numTileColumns
				colIdx[i] = j
			}
			let area = s.ctbWidth * s.ctbHeight
			rsToTs.len(area)
			tsToRs.len(area)
			tileId.len(area)
			for let rs = 0; rs < area; rs++ {
				let tbX = rs % s.ctbWidth
				let tbY = rs / s.ctbWidth
				let tileX = 0
				let tileY = 0
				for let i = 0; i < numTileColumns; i++ {
					if tbX < colBd[i + 1] {
						tileX = i
						break
					}
				}
				for let i = 0; i < numTileRows; i++ {
					if tbY < rowBd[i + 1] {
						tileY = i
						break
					}
				}
				let v = 0
				for let i = 0; i < tileX; i++ {
					v += rowHeight[tileY] * columnWidth[i]
				}
				for let i = 0; i < tileY; i++ {
					v += s.ctbWidth * rowHeight[i]
				}
				v += (tbY - rowBd[tileY]) * columnWidth[tileX] + tbX - colBd[tileX]
				rsToTs[rs] = v
				tsToRs[v] = rs
			}
			let t = 0
			for let r = 0; r < numTileRows; r++ {
				for let c = 0; c < numTileColumns; c++ {
					for let y = rowBd[r]; y < rowBd[r + 1]; y++ {
						for let x = colBd[c]; x < colBd[c + 1]; x++ {
							tileId[rsToTs[y * s.ctbWidth + x]] = t
						}
					}
					t++
				}
			}
			let stride = s.tbMask + 2
			minTbAddrZs.len(stride * stride)
			minTbAddrZs.fill(-1)
			let log2Diff = s.log2CtbSize - s.log2MinTbSize
			for let y = 0; y <= s.tbMask; y++ {
				for let x = 0; x <= s.tbMask; x++ {
					let rs = s.ctbWidth * (y >> log2Diff) + (x >> log2Diff)
					let v = rsToTs[rs] << (log2Diff * 2)
					for let i = 0; i < log2Diff; i++ {
						let m = 1 << i
						v += ((m & x) != 0 ?? (m * m, 0)) + ((m & y) != 0 ?? (2 * m * m, 0))
					}
					minTbAddrZs[(y + 1) * stride + x + 1] = v
				}
			}
		}

		// The z-scan address of minimum transform block (x, y) of the CTB,
		// -1 left of and above it.
		def zs(s HevcSps, x int, y int) int {
			return minTbAddrZs[(y + 1) * (s.tbMask + 2) + x + 1]
		}
	}

	// Reads a picture parameter set (7.3.2.3).
	//
	// Fails on invalid values or an SPS it names but that has not come.
	def hevcParsePps(b H264Bits, spsById map<int, HevcSps>) !HevcPps {
		let p = new HevcPps()
		p.id = b.ue()
		fail "hevc: PPS id out of range" when p.id >= 64
		p.spsId = b.ue()
		fail "hevc: PPS names a missing SPS" unless spsById.hasKey(p.spsId)
		let s = spsById[p.spsId]
		p.dependentSlices = b.flag()
		p.outputFlagPresent = b.flag()
		p.extraSliceHeaderBits = b.u(3)
		p.signDataHiding = b.flag()
		p.cabacInitPresent = b.flag()
		p.numRefIdxL0Default = b.ue() + 1
		p.numRefIdxL1Default = b.ue() + 1
		fail "hevc: too many default references" when p.numRefIdxL0Default > 15 || p.numRefIdxL1Default > 15
		p.initQp = 26 + b.se()
		p.constrainedIntraPred = b.flag()
		p.transformSkipEnabled = b.flag()
		p.cuQpDeltaEnabled = b.flag()
		p.diffCuQpDeltaDepth = p.cuQpDeltaEnabled ?? (b.ue(), 0)
		fail "hevc: bad diff_cu_qp_delta_depth" when p.diffCuQpDeltaDepth > s.log2CtbSize - s.log2MinCbSize
		p.cbQpOffset = b.se()
		p.crQpOffset = b.se()
		fail "hevc: chroma QP offset out of range" when p.cbQpOffset < -12 || p.cbQpOffset > 12 || p.crQpOffset < -12 || p.crQpOffset > 12
		p.sliceChromaQpOffsets = b.flag()
		p.weightedPred = b.flag()
		p.weightedBipred = b.flag()
		p.transquantBypass = b.flag()
		p.tilesEnabled = b.flag()
		p.entropySync = b.flag()
		if p.tilesEnabled {
			p.numTileColumns = b.ue() + 1
			p.numTileRows = b.ue() + 1
			fail "hevc: bad tile count" when p.numTileColumns > s.ctbWidth || p.numTileRows > s.ctbHeight
			p.uniformSpacing = b.flag()
			if !p.uniformSpacing {
				p.columnWidth.len(p.numTileColumns)
				p.rowHeight.len(p.numTileRows)
				let sum = 0
				for let i = 0; i < p.numTileColumns - 1; i++ {
					p.columnWidth[i] = b.ue() + 1
					sum += p.columnWidth[i]
				}
				fail "hevc: tile columns wider than the picture" when sum >= s.ctbWidth
				p.columnWidth[p.numTileColumns - 1] = s.ctbWidth - sum
				sum = 0
				for let i = 0; i < p.numTileRows - 1; i++ {
					p.rowHeight[i] = b.ue() + 1
					sum += p.rowHeight[i]
				}
				fail "hevc: tile rows taller than the picture" when sum >= s.ctbHeight
				p.rowHeight[p.numTileRows - 1] = s.ctbHeight - sum
			}
			p.loopFilterAcrossTiles = b.flag()
		}
		p.loopFilterAcrossSlices = b.flag()
		if b.flag() {
			p.deblockingOverride = b.flag()
			p.deblockingDisabled = b.flag()
			if !p.deblockingDisabled {
				p.betaOffset = b.se() * 2
				p.tcOffset = b.se() * 2
				fail "hevc: deblocking offset out of range" when p.betaOffset < -12 || p.betaOffset > 12 || p.tcOffset < -12 || p.tcOffset > 12
			}
		}
		p.scalingPresent = b.flag()
		if p.scalingPresent {
			try p.scaling.read(b, s.chromaFormat == 3)
		}
		p.listsModification = b.flag()
		p.log2ParallelMergeLevel = b.ue() + 2
		fail "hevc: bad parallel merge level" when p.log2ParallelMergeLevel - 2 > s.log2CtbSize
		p.sliceHeaderExtension = b.flag()
		if b.flag() {
			let range = b.flag()
			// The multilayer and 3D extension flags.
			b.skip(2)
			let scc = b.flag()
			b.skip(4)
			if range && s.profile >= 4 {
				p.log2MaxTransformSkipSize = b.ue() + 2 when p.transformSkipEnabled
				p.crossComponentPred = b.flag()
				p.chromaQpOffsetList = b.flag()
				if p.chromaQpOffsetList {
					p.diffCuChromaQpOffsetDepth = b.ue()
					p.chromaQpOffsetListLen = b.ue() + 1
					fail "hevc: chroma QP offset list too long" when p.chromaQpOffsetListLen > 6
					for let i = 0; i < p.chromaQpOffsetListLen; i++ {
						p.cbQpOffsetList[i] = b.se()
						p.crQpOffsetList[i] = b.se()
					}
				}
				p.log2SaoOffsetScaleLuma = b.ue()
				p.log2SaoOffsetScaleChroma = b.ue()
			}
			// The multilayer and 3D extensions concern the layers above the
			// base one, which are not decoded; the extensions of profiles
			// that do not define them are ignored.
			fail "hevc: screen content coding is not supported" when scc && s.profile >= 9
		}
		return p
	}
}
