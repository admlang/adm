internal partial module std.formats.video.hevc {
	// Prediction of a 4x4 block of a picture: intra, list 0, list 1 or
	// both.
	const hevcPredIntra = 0
	const hevcPredL0 = 1
	const hevcPredL1 = 2
	const hevcPredBi = 3

	// A decoded picture: samples, the motion of each 4x4 block, and the
	// reference lists of its slices (what temporal prediction and the
	// deblocking filter need of it later).
	type HevcPicture {
		y          uint16[]
		u          uint16[]
		v          uint16[]
		// Luma and chroma width, height and stride (the stride is the
		// width rounded up to whole CTBs).
		width      int
		height     int
		stride     int
		cwidth     int
		cheight    int
		cstride    int
		bitDepth   int
		// The sequence parameter set the picture was decoded with: its
		// conformance window and colour description apply on output.
		sps        HevcSps
		poc        int
		// 0 unused for reference, 1 short-term, 2 long-term.
		refKind    int
		needOutput bool
		// Pictures decoded since this one while it waited for output.
		latency    int
		// Whether the picture was made up for a missing reference.
		missing    bool
		keyframe   bool
		pts        duration
		hasPts     bool
		length     duration
		// The coded video sequence the picture belongs to: output never
		// reorders across sequences.
		sequence   int
		// Per 4x4 block: prediction (hevcPred*), motion vectors of both
		// lists and their reference indices.
		w4         int
		h4         int
		pred       byte[]
		mvx0       int16[]
		mvy0       int16[]
		mvx1       int16[]
		mvy1       int16[]
		ref0       int8[]
		ref1       int8[]
		// The slice of each CTB, and per slice the POC and long-term flag
		// of each entry of both reference lists (16 each).
		ctbWidth   int
		log2Ctb    int
		ctbSlice   int[]
		refPoc     int[]
		refLt      bool[]
		slices     int

		// Allocates planes and motion for a picture of `s`.
		def new(s HevcSps) {
			sps = s
			width = s.width
			height = s.height
			stride = s.ctbWidth << s.log2CtbSize
			let rows = s.ctbHeight << s.log2CtbSize
			bitDepth = s.bitDepth
			y.len(stride * rows)
			if s.chromaFormat != 0 {
				cwidth = width >> s.hshift[1]
				cheight = height >> s.vshift[1]
				cstride = stride >> s.hshift[1]
				u.len(cstride * (rows >> s.vshift[1]))
				v.len(cstride * (rows >> s.vshift[1]))
			}
			w4 = stride >> 2
			h4 = rows >> 2
			let n = w4 * h4
			pred.len(n)
			mvx0.len(n)
			mvy0.len(n)
			mvx1.len(n)
			mvy1.len(n)
			ref0.len(n)
			ref1.len(n)
			ctbWidth = s.ctbWidth
			log2Ctb = s.log2CtbSize
			ctbSlice.len(s.ctbWidth * s.ctbHeight)
		}

		// Starts a new slice's reference lists and returns its index.
		def addSlice() int {
			slices++
			refPoc.len(slices * 32)
			refLt.len(slices * 32)
			return slices - 1
		}

		// The slice index of the CTB holding luma sample (x, y).
		def sliceAt(x int, y int) int {
			return ctbSlice[(y >> log2Ctb) * ctbWidth + (x >> log2Ctb)]
		}

		// Fills the planes with mid-grey and the motion with intra, as a
		// stand-in for a picture that never came.
		def grey() {
			let mid = uint16(1 << (bitDepth - 1))
			y.fill(mid)
			u.fill(mid)
			v.fill(mid)
			pred.fill(byte(0))
			missing = true
		}
	}
}
