internal partial module std.formats.video.hevc {
	use std.formats.video.h264::(H264Bits)

	const hevcSliceB = 0
	const hevcSliceP = 1
	const hevcSliceI = 2

	// NAL unit types (Table 7-1).
	const (
		hevcNalTrailN    = 0
		hevcNalRaslR     = 9
		hevcNalBlaWLp    = 16
		hevcNalBlaWRadl  = 17
		hevcNalBlaNLp    = 18
		hevcNalIdrWRadl  = 19
		hevcNalIdrNLp    = 20
		hevcNalCra       = 21
		hevcNalVps       = 32
		hevcNalSps       = 33
		hevcNalPps       = 34
		hevcNalAud       = 35
		hevcNalEos       = 36
		hevcNalEob       = 37
		hevcNalFd        = 38
		hevcNalSeiPrefix = 39
		hevcNalSeiSuffix = 40
	)

	// A slice segment header (7.3.6). A dependent slice segment reads only
	// its address and entry points; the rest stays from the slice segment
	// before it.
	type HevcSliceHeader {
		first                  bool
		noOutputOfPriorPics    bool
		ppsId                  int
		dependent              bool
		address                int
		sliceType              int
		picOutput              bool
		pocLsb                 int
		// The short-term RPS: one of the SPS sets, or `ownRps`.
		rps                    ?HevcRps
		ownRps                 HevcRps
		// Long-term entries: POC (LSB, or full when the MSB is present),
		// used by the current picture, whether the MSB was coded.
		ltPoc                  int[]
		ltUsed                 bool[]
		ltMsb                  bool[]
		numLt                  int
		temporalMvp            bool
		saoLuma                bool
		saoChroma              bool
		numRefIdx              int[]
		listModified           bool[]
		// list_entry_lX, 16 per list.
		listEntry              int[]
		mvdL1Zero              bool
		cabacInit              bool
		colFromL0              bool
		colRefIdx              int
		lumaDenom              int
		chromaDenom            int
		// Weights and offsets per list and reference (16 each), offsets in
		// sample units; chroma ones Cb then Cr.
		lumaWeight             int[]
		lumaOffset             int[]
		chromaWeight           int[]
		chromaOffset           int[]
		maxMergeCand           int
		qp                     int
		cbQpOffset             int
		crQpOffset             int
		cuChromaQpOffset       bool
		deblockingDisabled     bool
		betaOffset             int
		tcOffset               int
		loopFilterAcrossSlices bool
		// Entry point offsets in bytes of the escaped NAL unit.
		entryPoints            int[]
		// Byte offset of the slice data in the RBSP.
		dataOffset             int
		// Short-term RPS bits in the header, for NumPicTotalCurr.
		numPicTotalCurr        int

		def new() {
			ownRps = new HevcRps()
			numRefIdx = int[0, 0]
			listModified = bool[false, false]
			listEntry.len(32)
			lumaWeight.len(32)
			lumaOffset.len(32)
			chromaWeight.len(64)
			chromaOffset.len(64)
		}

		def isIntra() bool {
			return sliceType == hevcSliceI
		}
	}

	// Bits of Ceil(Log2(n)).
	def hevcCeilLog2(n int) int {
		let bits = 0
		for (1 << bits) < n {
			bits++
		}
		return bits
	}

	// Reads the slice segment header of a NAL unit of type `nalType` into
	// `h`. A dependent segment keeps the fields of the one before it.
	//
	// Fails on invalid values or parameter sets that have not come.
	def hevcParseSliceHeader(b H264Bits, h HevcSliceHeader, nalType int, spsById map<int, HevcSps>, ppsById map<int, HevcPps>) !none {
		h.first = b.flag()
		h.noOutputOfPriorPics = b.flag() when nalType >= hevcNalBlaWLp && nalType <= 23
		let ppsId = b.ue()
		fail "hevc: slice names a missing PPS" unless ppsById.hasKey(ppsId)
		let p = ppsById[ppsId]
		fail "hevc: PPS names a missing SPS" unless spsById.hasKey(p.spsId)
		let s = spsById[p.spsId]
		fail "hevc: PPS changed within a picture" when !h.first && ppsId != h.ppsId
		h.ppsId = ppsId
		h.dependent = false
		h.address = 0
		if !h.first {
			h.dependent = b.flag() when p.dependentSlices
			let count = s.ctbWidth * s.ctbHeight
			h.address = b.u(hevcCeilLog2(count))
			fail "hevc: slice address out of range" when h.address >= count
		}
		if !h.dependent {
			b.skip(p.extraSliceHeaderBits)
			h.sliceType = b.ue()
			fail "hevc: bad slice type" when h.sliceType > 2
			h.picOutput = !p.outputFlagPresent || b.flag()
			h.pocLsb = 0
			h.rps = none
			h.numLt = 0
			h.temporalMvp = false
			if nalType != hevcNalIdrWRadl && nalType != hevcNalIdrNLp {
				h.pocLsb = b.u(s.log2MaxPocLsb)
				if !b.flag() {
					try hevcReadRps(b, h.ownRps, s.rps, s.rps.len(), true)
					h.rps = h.ownRps
				} else {
					fail "hevc: slice uses an SPS RPS but the SPS has none" when s.rps.len() == 0
					let idx = s.rps.len() > 1 ?? (b.u(hevcCeilLog2(s.rps.len())), 0)
					fail "hevc: RPS index out of range" when idx >= s.rps.len()
					h.rps = s.rps[idx]
				}
				if s.longTermPresent {
					let numSps = s.ltPocLsb.len() > 0 ?? (b.ue(), 0)
					fail "hevc: too many long-term SPS entries" when numSps > s.ltPocLsb.len()
					let numPics = b.ue()
					h.numLt = numSps + numPics
					fail "hevc: too many long-term pictures" when h.numLt > 32
					h.ltPoc.len(h.numLt)
					h.ltUsed.len(h.numLt)
					h.ltMsb.len(h.numLt)
					let prevMsb = 0
					for let i = 0; i < h.numLt; i++ {
						if i < numSps {
							let idx = s.ltPocLsb.len() > 1 ?? (b.u(hevcCeilLog2(s.ltPocLsb.len())), 0)
							h.ltPoc[i] = s.ltPocLsb[idx]
							h.ltUsed[i] = s.ltUsed[idx]
						} else {
							h.ltPoc[i] = b.u(s.log2MaxPocLsb)
							h.ltUsed[i] = b.flag()
						}
						h.ltMsb[i] = b.flag()
						if h.ltMsb[i] {
							let cycle = b.ue()
							cycle += prevMsb unless i == 0 || i == numSps
							prevMsb = cycle
							h.ltPoc[i] = h.ltPoc[i] - cycle * (1 << s.log2MaxPocLsb)
						} else if i == 0 || i == numSps {
							prevMsb = 0
						}
					}
				}
				h.temporalMvp = b.flag() when s.temporalMvpEnabled
			}
			h.saoLuma = false
			h.saoChroma = false
			if s.saoEnabled {
				h.saoLuma = b.flag()
				h.saoChroma = b.flag() when s.chromaFormat != 0
			}
			h.numPicTotalCurr = 0
			let rps = h.rps
			if !(rps is none) {
				let r HevcRps = rps
				for let i = 0; i < r.numDeltas; i++ {
					h.numPicTotalCurr++ when r.used[i]
				}
			}
			for let i = 0; i < h.numLt; i++ {
				h.numPicTotalCurr++ when h.ltUsed[i]
			}
			h.numRefIdx[0] = 0
			h.numRefIdx[1] = 0
			h.listModified[0] = false
			h.listModified[1] = false
			h.mvdL1Zero = false
			h.cabacInit = false
			h.colFromL0 = true
			h.colRefIdx = 0
			h.maxMergeCand = 5
			if h.sliceType != hevcSliceI {
				h.numRefIdx[0] = p.numRefIdxL0Default
				h.numRefIdx[1] = h.sliceType == hevcSliceB ?? (p.numRefIdxL1Default, 0)
				if b.flag() {
					h.numRefIdx[0] = b.ue() + 1
					h.numRefIdx[1] = b.ue() + 1 when h.sliceType == hevcSliceB
				}
				fail "hevc: too many active references" when h.numRefIdx[0] > 16 || h.numRefIdx[1] > 16
				fail "hevc: inter slice without reference pictures" when h.numPicTotalCurr == 0
				if p.listsModification && h.numPicTotalCurr > 1 {
					let bits = hevcCeilLog2(h.numPicTotalCurr)
					let lists = h.sliceType == hevcSliceB ?? (2, 1)
					for let l = 0; l < lists; l++ {
						h.listModified[l] = b.flag()
						if h.listModified[l] {
							for let i = 0; i < h.numRefIdx[l]; i++ {
								h.listEntry[l * 16 + i] = b.u(bits)
							}
						}
					}
				}
				h.mvdL1Zero = b.flag() when h.sliceType == hevcSliceB
				h.cabacInit = b.flag() when p.cabacInitPresent
				if h.temporalMvp {
					h.colFromL0 = b.flag() when h.sliceType == hevcSliceB
					let list = h.colFromL0 ?? (0, 1)
					h.colRefIdx = b.ue() when h.numRefIdx[list] > 1
					fail "hevc: collocated_ref_idx out of range" when h.colRefIdx >= h.numRefIdx[list]
				}
				if (p.weightedPred && h.sliceType == hevcSliceP) || (p.weightedBipred && h.sliceType == hevcSliceB) {
					try hevcReadWeights(b, h, s)
				}
				h.maxMergeCand = 5 - b.ue()
				fail "hevc: bad five_minus_max_num_merge_cand" when h.maxMergeCand < 1 || h.maxMergeCand > 5
			}
			h.qp = p.initQp + b.se()
			fail "hevc: slice QP out of range" when h.qp < -s.qpBdOffset || h.qp > 51
			h.cbQpOffset = 0
			h.crQpOffset = 0
			if p.sliceChromaQpOffsets {
				h.cbQpOffset = b.se()
				h.crQpOffset = b.se()
				fail "hevc: slice chroma QP offset out of range" when h.cbQpOffset < -12 || h.cbQpOffset > 12 || h.crQpOffset < -12 || h.crQpOffset > 12
			}
			h.cuChromaQpOffset = p.chromaQpOffsetList && b.flag()
			h.deblockingDisabled = p.deblockingDisabled
			h.betaOffset = p.betaOffset
			h.tcOffset = p.tcOffset
			if p.deblockingOverride && b.flag() {
				h.deblockingDisabled = b.flag()
				if !h.deblockingDisabled {
					h.betaOffset = b.se() * 2
					h.tcOffset = b.se() * 2
					fail "hevc: deblocking offset out of range" when h.betaOffset < -12 || h.betaOffset > 12 || h.tcOffset < -12 || h.tcOffset > 12
				}
			}
			h.loopFilterAcrossSlices = p.loopFilterAcrossSlices
			h.loopFilterAcrossSlices = b.flag() when p.loopFilterAcrossSlices && (h.saoLuma || h.saoChroma || !h.deblockingDisabled)
		}
		h.entryPoints.len(0)
		if p.tilesEnabled || p.entropySync {
			let count = b.ue()
			fail "hevc: too many entry points" when count > s.ctbWidth * s.ctbHeight
			if count > 0 {
				let bits = b.ue() + 1
				fail "hevc: bad entry point offset length" when bits > 32
				for let i = 0; i < count; i++ {
					h.entryPoints.push(b.u(bits) + 1)
				}
			}
		}
		if p.sliceHeaderExtension {
			let n = b.ue()
			fail "hevc: slice header extension too long" when n * 8 > b.left()
			b.skip(n * 8)
		}
		// byte_alignment(): a one bit, then zeros to the byte boundary.
		fail "hevc: bad slice header alignment" unless b.flag()
		b.skip((8 - (b.pos & 7)) & 7)
		h.dataOffset = b.pos >> 3
		fail "hevc: slice header runs past the NAL unit" when b.left() < 0
		return none
	}

	// Reads pred_weight_table() (7.3.6.3).
	//
	// Fails on out of range weights.
	def hevcReadWeights(b H264Bits, h HevcSliceHeader, s HevcSps) !none {
		h.lumaDenom = b.ue()
		fail "hevc: luma weight denominator out of range" when h.lumaDenom > 7
		h.chromaDenom = h.lumaDenom
		if s.chromaFormat != 0 {
			h.chromaDenom = h.lumaDenom + b.se()
			fail "hevc: chroma weight denominator out of range" when h.chromaDenom < 0 || h.chromaDenom > 7
		}
		let shift = s.highPrecisionOffsets ?? (0, s.bitDepth - 8)
		let half = s.highPrecisionOffsets ?? (1 << (s.bitDepth - 1), 128)
		let lists = h.sliceType == hevcSliceB ?? (2, 1)
		let lumaFlags bool[]
		let chromaFlags bool[]
		lumaFlags.len(16)
		chromaFlags.len(16)
		for let l = 0; l < lists; l++ {
			let n = h.numRefIdx[l]
			for let i = 0; i < n; i++ {
				lumaFlags[i] = b.flag()
			}
			for let i = 0; i < n; i++ {
				chromaFlags[i] = s.chromaFormat != 0 && b.flag()
			}
			for let i = 0; i < n; i++ {
				let k = l * 16 + i
				h.lumaWeight[k] = 1 << h.lumaDenom
				h.lumaOffset[k] = 0
				if lumaFlags[i] {
					let dw = b.se()
					fail "hevc: luma weight out of range" when dw < -128 || dw > 127
					h.lumaWeight[k] = (1 << h.lumaDenom) + dw
					let off = b.se()
					fail "hevc: luma offset out of range" when off < -half || off >= half
					h.lumaOffset[k] = off << shift
				}
				for let c = 0; c < 2; c++ {
					h.chromaWeight[k * 2 + c] = 1 << h.chromaDenom
					h.chromaOffset[k * 2 + c] = 0
				}
				if chromaFlags[i] {
					for let c = 0; c < 2; c++ {
						let dw = b.se()
						fail "hevc: chroma weight out of range" when dw < -128 || dw > 127
						let w = (1 << h.chromaDenom) + dw
						h.chromaWeight[k * 2 + c] = w
						let d = b.se()
						fail "hevc: chroma offset out of range" when d < -4 * half || d >= 4 * half
						let off = (half - ((half * w) >> h.chromaDenom)) + d
						off = off < -half ?? (-half, off)
						off = off > half - 1 ?? (half - 1, off)
						h.chromaOffset[k * 2 + c] = off << shift
					}
				}
			}
		}
		return none
	}
}
