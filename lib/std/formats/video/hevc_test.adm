partial module std.formats.video {
	use (
		std.testing
		std.crypto.hash
		std.data.encoding
	)

	// HEVC Annex B test stream: Main profile, 8-bit 4:2:0, B frames, AMP, SAO, weighted prediction.
	const hevcTestMain = ""

	// MD5 of each frame of hevcTestMain (Y, U and V planes) in output order.
	const hevcTestMainMd5 = string[
		"2249fe89072f2ff2a17c870ec53b33bd",
		"329e599f482addcd21825c63f3344ff6",
		"62fb3fe688dfe8f38ba5b69c6f2321b2",
		"11b8e28951ecc5e4e5f09a426befbe98",
		"4b19405bb36ba4f51b57676da852d1b0",
		"90af939f462ba1a818521630179d0b1c"
	]

	// HEVC Annex B test stream: Main 10 profile, 10-bit 4:2:0, B frames.
	const hevcTestMain10 = ""

	// MD5 of each frame of hevcTestMain10 (Y, U and V planes) in output order.
	const hevcTestMain10Md5 = string[
		"bfc2228dd931344f0580fa68a8ff6d84",
		"dfa4be58b50b07a3a25c7a352a1caffc",
		"ec77589822df1f653c5c764434414f54",
		"be81942ce3786e63ff2fa9a21d6a6c7d",
		"be81942ce3786e63ff2fa9a21d6a6c7d",
		"be81942ce3786e63ff2fa9a21d6a6c7d"
	]

	// HEVC Annex B test stream: Main 4:2:2 10 profile.
	const hevcTestYuv422 = ""

	// MD5 of each frame of hevcTestYuv422 (Y, U and V planes) in output order.
	const hevcTestYuv422Md5 = string[
		"4e34b5f198b152e192a29b0db815c182",
		"68bbeae0fb4675938acc1a199f1c6c52",
		"b622b892f8175fbfee248aba30639417",
		"74a1fc154533de97795a544375e51908",
		"37cbfdf0769469ca479b39a0d394359e",
		"85e72d3483de4fa0fe1a9cad4e999f29"
	]

	// HEVC Annex B test stream: Main 4:4:4 profile with transform skip and lossless coding units.
	const hevcTestYuv444 = ""

	// MD5 of each frame of hevcTestYuv444 (Y, U and V planes) in output order.
	const hevcTestYuv444Md5 = string[
		"29f40e4e14e42d62ae6fa6283ea17c00",
		"d14cb1d3a7b260b8048761912f8b36ef",
		"47c4bee65e2e55990b46b4aee0eda0f9",
		"3616ac52962133b3a4baf1983ed6b496",
		"18440d20074a2e46481984903c88c985",
		"2ba69ca86f24216905d1b094ef22e40d"
	]

	// HEVC Annex B test stream: lossless coding (cu_transquant_bypass) throughout.
	const hevcTestLossless = ""

	// MD5 of each frame of hevcTestLossless (Y, U and V planes) in output order.
	const hevcTestLosslessMd5 = string[
		"3615caf157cebbaea8cf271708402b75",
		"3615caf157cebbaea8cf271708402b75",
		"3615caf157cebbaea8cf271708402b75",
		"c4e50111a123143e257b0eef8f9b1e7f",
		"c4e50111a123143e257b0eef8f9b1e7f",
		"c4e50111a123143e257b0eef8f9b1e7f"
	]

	// HEVC Annex B test stream: wavefront parallel processing with two slices per picture and 16x16 CTBs.
	const hevcTestWavefront = ""

	// MD5 of each frame of hevcTestWavefront (Y, U and V planes) in output order.
	const hevcTestWavefrontMd5 = string[
		"67f1dc77611c5cc172ee404e35050796",
		"7ed3455b1256d6a20ac013f90d10401d",
		"92fbdebc215a65156c41d60d676a1a40",
		"dfe74929d4ae37d8af923f813e4f9485",
		"046b2f354d8cfa73409a26528523cd71",
		"5f72daf4994d5d147e1dea720e8d7185"
	]

	// HEVC Annex B test stream: 4:0:0 monochrome.
	const hevcTestMono = ""

	// MD5 of each frame of hevcTestMono (Y, U and V planes) in output order.
	const hevcTestMonoMd5 = string[
		"c6522c630ec02353ef0f1ba04e20aafd",
		"8596780a86ccaf043a3d7362caec6ed9",
		"df18624f44d7ccb8a8bf03a308f66548",
		"b666dd1b215c0f0f9f30a4baf77b00b4",
		"500cf2178b6758e436a9afdd4ec18f01",
		"6f5674ff070241b1229bfee0351bf68e"
	]

	// HEVC Annex B test stream: a 60x44 picture coded as 64x48 with a conformance window.
	const hevcTestCropped = ""

	// MD5 of each frame of hevcTestCropped (Y, U and V planes) in output order.
	const hevcTestCroppedMd5 = string[
		"39aedff9e7a38e354d5cb8a3454c23b8",
		"39aedff9e7a38e354d5cb8a3454c23b8",
		"39aedff9e7a38e354d5cb8a3454c23b8",
		"d5ffe8cddf83bd48b5622c898ba334ba",
		"3fec279318bc72c100ae34c63494c925",
		"3fec279318bc72c100ae34c63494c925"
	]

	// The stream of hevcTestMain in an MP4 file (hvc1 sample entry with an
	// hvcC record, B frames reordered by composition offsets).
	const hevcTestMp4 = ""

	// Decodes a base64 Annex B stream cut into packets of `chunk` bytes, or
	// in one packet when `chunk` is 0.
	def hevcTestDecode(stream string, chunk int = 0) !VideoFrame[] {
		let data = try encoding.base64decode(stream)
		let dec = new HEVC()
		try dec.configure(Track{index: 0, kind: TrackKind.Video, codec: "hevc", config: byte[]})
		let frames = VideoFrame[]
		let p = 0
		for p < data.len() {
			let n = chunk > 0 ?? (chunk, data.len())
			n = data.len() - p when p + n > data.len()
			let got = try dec.decode(Packet{track: 0, data: data[p:p + n]})
			for let f in got {
				frames.push(f)
			}
			p += n
		}
		let rest = try dec.flush()
		for let f in rest {
			frames.push(f)
		}
		return frames
	}

	// Whether the frames hash to `want`, in order.
	def hevcTestMatches(frames VideoFrame[], want string[]) bool {
		return false when frames.len() != want.len()
		for let i = 0; i < frames.len(); i++ {
			let h = new hash.MD5()
			return false when encoding.hexencode(h.hash(frames[i].y + frames[i].u + frames[i].v)) != want[i]
		}
		return true
	}

	// The frames of a whole file opened with `open`.
	def hevcTestOpen(data byte[]) !VideoFrame[] {
		let v = try open(data)
		let stream = try v.frames()
		let frames VideoFrame[]
		for {
			let got = try stream.next()
			break when got is none
			let f VideoFrame = got
			frames.push(f)
		}
		return frames
	}

	check "HEVC" {
		@test()
		def TestHevcMain() {
			let frames = hevcTestDecode(hevcTestMain) onerror recover VideoFrame[]
			assert hevcTestMatches(frames, hevcTestMainMd5)
			assert frames[0].width == uint32(64) && frames[0].height == uint32(48)
			assert frames[0].bitDepth == 8 && frames[0].chroma == ChromaLayout.Yuv420
			assert frames[0].keyframe
		}

		@test()
		def TestHevcMain10() {
			let frames = hevcTestDecode(hevcTestMain10) onerror recover VideoFrame[]
			assert hevcTestMatches(frames, hevcTestMain10Md5)
			assert frames[0].bitDepth == 10 && frames[0].yStride == 128
		}

		@test()
		def TestHevcYuv422() {
			let frames = hevcTestDecode(hevcTestYuv422) onerror recover VideoFrame[]
			assert hevcTestMatches(frames, hevcTestYuv422Md5)
			assert frames[0].chroma == ChromaLayout.Yuv422
		}

		@test()
		def TestHevcYuv444() {
			let frames = hevcTestDecode(hevcTestYuv444) onerror recover VideoFrame[]
			assert hevcTestMatches(frames, hevcTestYuv444Md5)
			assert frames[0].chroma == ChromaLayout.Yuv444
		}

		@test()
		def TestHevcLossless() {
			let frames = hevcTestDecode(hevcTestLossless) onerror recover VideoFrame[]
			assert hevcTestMatches(frames, hevcTestLosslessMd5)
		}

		@test()
		def TestHevcWavefront() {
			let frames = hevcTestDecode(hevcTestWavefront) onerror recover VideoFrame[]
			assert hevcTestMatches(frames, hevcTestWavefrontMd5)
		}

		@test()
		def TestHevcMonochrome() {
			let frames = hevcTestDecode(hevcTestMono) onerror recover VideoFrame[]
			assert hevcTestMatches(frames, hevcTestMonoMd5)
			assert frames[0].chroma == ChromaLayout.Mono && frames[0].u.len() == 0
		}

		@test()
		def TestHevcCropping() {
			let frames = hevcTestDecode(hevcTestCropped) onerror recover VideoFrame[]
			assert hevcTestMatches(frames, hevcTestCroppedMd5)
			assert frames[0].width == uint32(60) && frames[0].height == uint32(44)
			assert frames[0].u.len() == 30 * 22
		}

		@test()
		def TestHevcAnnexBPackets() {
			// Packets that split NAL units and start codes anywhere.
			for let chunk in int[1, 7, 97, 500] {
				let frames = hevcTestDecode(hevcTestMain, chunk) onerror recover VideoFrame[]
				assert hevcTestMatches(frames, hevcTestMainMd5)
			}
		}

		@test()
		def TestHevcElementaryStream() !none {
			let data = try encoding.base64decode(hevcTestMain10)
			let v = try open(data)
			let info = v.info()
			assert info.container == "es" && info.codec == "hevc" && info.width == 64 && info.height == 48
			let frames = try hevcTestOpen(data)
			assert hevcTestMatches(frames, hevcTestMain10Md5)
		}

		@test()
		def TestHevcMp4() !none {
			let data = try encoding.base64decode(hevcTestMp4)
			let v = try open(data)
			assert v.info().codec == "hevc"
			let frames = try hevcTestOpen(data)
			assert hevcTestMatches(frames, hevcTestMainMd5)
		}

		@test()
		def TestHevcTruncated() {
			// A stream cut inside its last picture decodes the pictures before
			// it without failing.
			let data = encoding.base64decode(hevcTestMain) onerror recover byte[]
			let dec = new HEVC()
			dec.configure(Track{index: 0, kind: TrackKind.Video, codec: "hevc", config: byte[]}) onerror recover none
			let cut = data[:data.len() - 8]
			let got = dec.decode(Packet{track: 0, data: cut}) onerror recover VideoFrame[]
			let rest = dec.flush() onerror recover VideoFrame[]
			assert got.len() + rest.len() >= 5
		}
	}
}
