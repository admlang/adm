internal partial module std.formats.video.matroska {
	use (
		std.io
		std.os
		std.bytes
		std.formats.video::*
		std.formats.video.media.source::*
	)

	const (
		ebmlVersion            = 0x4286
		ebmlReadVersion        = 0x42F7
		ebmlMaxIdLength        = 0x42F2
		ebmlMaxSizeLength      = 0x42F3
		ebmlDocTypeVersion     = 0x4287
		ebmlDocTypeReadVersion = 0x4285
		ebmlVoid               = 0xEC
		mkvMuxingApp           = 0x4D80
		mkvWritingApp          = 0x5741
		mkvTrackUid            = 0x73C5
		mkvFlagLacing          = 0x9C
		mkvSeekPreRoll         = 0x56BB
		mkvDiscardPadding      = 0x75A2
		mkvCueRelative         = 0xF0
	)

	// What the writer names itself in MuxingApp and WritingApp.
	const mkvWriterName = "ADM std.formats.video"

	// Nanoseconds per timestamp tick the writer uses: WebM's millisecond.
	const mkvWriterScale = 1000000

	// A cluster ends after this many ticks or bytes, when no key frame
	// ended it sooner.
	const mkvClusterTicks = 5000
	const mkvClusterBytes = 5 * 1024 * 1024

	// Nanoseconds an Opus decoder needs before a seek target to converge
	// (RFC 7845 section 4.6), stored as SeekPreRoll.
	const opusSeekPreRoll = 80000000

	// Appends an element id: its bytes as they are, 1 to 4 of them.
	def putId(out byte[], id int) {
		out.push(byte(id >> 24)) when id > 0xFFFFFF
		out.push(byte((id >> 16) & 0xFF)) when id > 0xFFFF
		out.push(byte((id >> 8) & 0xFF)) when id > 0xFF
		out.push(byte(id & 0xFF))
	}

	// Appends an element size in the fewest bytes that hold it; in
	// `width` bytes when that is not 0.
	def putSize(out byte[], size int, width int = 0) {
		let n = width
		if n == 0 {
			n = 1
			// All ones is the unknown size, so a width holds one value less.
			for n < 8 && size >= (1 << (7 * n)) - 1 {
				n++
			}
		}
		out.push(byte((0x100 >> n) | ((size >> (8 * (n - 1))) & (0xFF >> n))))
		for let i = n - 2; i >= 0; i-- {
			out.push(byte((size >> (8 * i)) & 0xFF))
		}
	}

	// Appends an unsigned integer element in the fewest bytes that hold
	// the value; in `width` bytes when that is not 0.
	def putUint(out byte[], id int, value int, width int = 0) {
		let n = width
		if n == 0 {
			n = 1
			for n < 8 && (value >> (8 * n)) != 0 {
				n++
			}
		}
		putId(out, id)
		putSize(out, n)
		for let i = n - 1; i >= 0; i-- {
			out.push(byte((value >> (8 * i)) & 0xFF))
		}
	}

	// Appends a signed integer element in the fewest bytes that hold it.
	def putInt(out byte[], id int, value int) {
		let n = 1
		for n < 8 && (value < 0 - (1 << (8 * n - 1)) || value >= 1 << (8 * n - 1)) {
			n++
		}
		putId(out, id)
		putSize(out, n)
		for let i = n - 1; i >= 0; i-- {
			out.push(byte((value >> (8 * i)) & 0xFF))
		}
	}

	// Appends a floating-point element of 8 bytes.
	def putFloat(out byte[], id int, value float64) {
		let bits = __bitcast_u64_from_f64(value)
		putId(out, id)
		putSize(out, 8)
		for let i = 7; i >= 0; i-- {
			out.push(byte((bits >> uint64(8 * i)) & 0xFF))
		}
	}

	// Appends an element holding bytes as they are.
	def putBytes(out byte[], id int, data byte[]) {
		putId(out, id)
		putSize(out, data.len())
		out.push(...data)
	}

	// Appends an element holding text.
	def putText(out byte[], id int, text string) {
		putBytes(out, id, text.bytes())
	}

	// The CodecID WebM stores for a codec name, empty for a codec WebM
	// does not carry.
	def webmCodecId(codec string) string {
		return "V_VP8" when codec == "vp8"
		return "V_VP9" when codec == "vp9"
		return "V_AV1" when codec == "av1"
		return "A_VORBIS" when codec == "vorbis"
		return "A_OPUS" when codec == "opus"
		return ""
	}

	// Header packets, each preceded by its 2-byte big-endian length (as
	// `Track.config` holds them), in Xiph lacing: the inverse of
	// `xiphHeaders`.
	//
	// Fails when the lengths do not add up to the bytes, or there are
	// no packets or more than 256.
	def xiphLaced(config byte[]) !byte[] {
		let starts int[]
		let sizes int[]
		let at = 0
		for at < config.len() {
			fail "mkv: the track's header packets are cut short" when at + 2 > config.len()
			let size = be(config, at, 2)
			fail "mkv: the track's header packets are cut short" when at + 2 + size > config.len()
			starts.push(at + 2)
			sizes.push(size)
			at += 2 + size
		}
		fail "mkv: a track of {sizes.len()} header packets cannot be laced" unless sizes.len() >= 1 && sizes.len() <= 256
		let out byte[]
		out.push(byte(sizes.len() - 1))
		for let i = 0; i < sizes.len() - 1; i++ {
			let left = sizes[i]
			for left >= 255 {
				out.push(255)
				left -= 255
			}
			out.push(byte(left))
		}
		for let (i, s) in sizes {
			out.push(...config[starts[i]:starts[i] + s])
		}
		return out
	}

	// The time the frames of an Opus packet play for, from its first
	// byte and, for a packet of a counted number of frames, its second
	// (RFC 6716 section 3.1); zero for an empty packet.
	def opusPacketLength(data byte[]) duration {
		return 0s when data.len() == 0
		let toc = int(data[0])
		let config = toc >> 3
		// Samples at 48 kHz in one frame.
		let samples = 0
		if config < 12 {
			samples = config & 3 == 3 ?? (2880, 480 << (config & 3))
		} else if config < 16 {
			samples = config & 1 == 0 ?? (480, 960)
		} else {
			samples = 120 << (config & 3)
		}
		let count = 1
		if toc & 3 == 3 {
			count = data.len() > 1 ?? (int(data[1]) & 0x3F, 0)
		} else if toc & 3 != 0 {
			count = 2
		}
		return duration(int64(samples * count) * 1000000000 / 48000)
	}

	// One track as the writer stores it.
	struct MuxTrack {
		track  Track
		number int
		// Nanoseconds added to every timestamp: the codec's start-up
		// delay, which a reader takes off again.
		delay  int64
	}

	// A key frame the Cues list: its time in ticks, its track number,
	// where its cluster starts in the segment and where its block starts
	// in the cluster.
	struct MuxCue {
		time     int
		number   int
		cluster  int
		relative int
	}

	// MkvMuxer lays the packets of its tracks out as a Matroska segment
	// of the WebM subset: the EBML header, Info, Tracks, then clusters of
	// SimpleBlocks, a new one at every key frame of the first video
	// track.
	//
	// Written to a file, the segment gets its size, its Duration, and
	// Cues behind the last cluster that a SeekHead at the front points
	// to. Any other writer takes a segment of unknown size with none of
	// those, which is read from start to end (a live stream).
	type MkvMuxer {
		writer       io.Writer
		// The writer when it is a file, whose bytes can be written again.
		file         ?os.File
		parts        MuxTrack[]
		// Index into `parts` of the first video track, -1 without one.
		mainVideo    int        = -1
		started      bool
		closed       bool
		// Bytes written so far, and the file offset of the first.
		position     int
		origin       int
		// Positions of the segment's size, of its payload, of the
		// SeekHead and of the Duration value.
		segmentSize  int
		segmentStart int
		seekHeadAt   int
		infoAt       int
		tracksAt     int
		lengthAt     int
		// The open cluster: its timestamp in ticks, its blocks (header
		// then frame, in turn) and the bytes of its payload so far.
		clusterOpen  bool
		clusterTime  int
		blocks       byte[][]
		clusterBytes int
		cues         MuxCue[]
		// The latest end of any packet, in nanoseconds.
		endTime      int64

		def new(writer io.Writer) {
			self.writer = writer
			let w any = writer
			if w is os.File {
				let f os.File = w
				file = f
			}
		}

		// add takes one more track and returns its index, the `track` of
		// its packets. `kind`, `codec` and `config` are used, and by kind
		// `width`, `height`, `frameRate` and `pixelAspect`, or `channels`
		// and `sampleRate`, and `language`.
		//
		// Fails for a codec WebM does not carry (it carries VP8, VP9,
		// AV1, Vorbis and Opus), a Vorbis or Opus track whose `config`
		// is not the codec's headers, a 127th track, or once a packet
		// was written.
		def add(track Track) !int {
			fail "webm: tracks are added before the first packet" when started
			fail "webm: the file is closed" when closed
			fail "webm: a file holds at most 126 tracks" when parts.len() >= 126
			let id = webmCodecId(track.codec)
			fail "webm: WebM carries VP8, VP9, AV1, Vorbis and Opus, not \"{track.codec}\"" when id == ""
			let video = id.startsWith("V_")
			fail "webm: the {track.codec} track is not a video track" when video && track.kind != TrackKind.Video
			fail "webm: the {track.codec} track is not an audio track" when !video && track.kind != TrackKind.Audio
			let delay int64 = 0
			if track.codec == "opus" {
				let head = track.config
				fail "webm: the Opus track's config is not an OpusHead" unless head.len() >= 19 && string(head[0:8]) == "OpusHead"
				// Pre-skip: samples at 48 kHz, little-endian.
				delay = int64(int(head[10]) | int(head[11]) << 8) * 1000000000 / 48000
			}
			let index = parts.len()
			mainVideo = index when video && mainVideo < 0
			parts.push(MuxTrack{track: Track{...track, index: index}, number: index + 1, delay: delay})
			return index
		}

		// write stores one packet of the track its `track` names, as a
		// SimpleBlock at `pts`. Packets are written in the order given,
		// which is to be by time across the tracks. An Opus packet whose
		// `length` is shorter than its frames play for is stored with
		// the difference as DiscardPadding, which ends a stream between
		// two packets.
		//
		// Fails for a track that was not added, when the file is closed,
		// or when the writer fails.
		def write(packet Packet) !none {
			fail "webm: the file is closed" when closed
			fail "webm: packet for track {packet.track}, the file has {parts.len()}" unless packet.track >= 0 && packet.track < parts.len()
			try start() unless started
			let part = parts[packet.track]
			let video = part.track.kind == TrackKind.Video
			let ns = (int64(packet.pts) + part.delay).max(int64(0))
			let time = int((ns + int64(mkvWriterScale / 2)) / int64(mkvWriterScale))
			let key = packet.keyframe || !video
			let fresh = !clusterOpen || time - clusterTime > 32767 || time - clusterTime < -32768
			fresh = true when packet.track == mainVideo && key && blocks.len() > 0
			fresh = true when clusterBytes >= mkvClusterBytes || time - clusterTime >= mkvClusterTicks
			if fresh {
				try endCluster()
				clusterOpen = true
				clusterTime = time
				// The cluster's Timestamp element leads its payload.
				let stamp byte[]
				putUint(stamp, mkvClusterTimestamp, time)
				blocks.push(stamp)
				clusterBytes = stamp.len()
			}
			let cued = (video && key) || (mainVideo < 0 && blocks.len() == 1)
			cues.push(MuxCue{time: time, number: part.number, cluster: position - segmentStart, relative: clusterBytes}) when cued
			let relative = time - clusterTime
			let head byte[]
			let full = part.track.codec == "opus" ?? (opusPacketLength(packet.data), 0s)
			if packet.length > 0s && packet.length < full {
				// A group: the block, the time it plays for, and what the
				// decoder drops from its end.
				let tail byte[]
				putUint(tail, mkvBlockDuration, int((int64(packet.length) + int64(mkvWriterScale / 2)) / int64(mkvWriterScale)))
				putInt(tail, mkvDiscardPadding, int(int64(full) - int64(packet.length)))
				let block byte[]
				putId(block, mkvBlock)
				putSize(block, 4 + packet.data.len())
				putId(head, mkvBlockGroup)
				putSize(head, block.len() + 4 + packet.data.len() + tail.len())
				head.push(...block)
				head.push(byte(0x80 | part.number), byte((relative >> 8) & 0xFF), byte(relative & 0xFF), 0)
				blocks.push(head, packet.data, tail)
				clusterBytes += head.len() + packet.data.len() + tail.len()
			} else {
				putId(head, mkvSimpleBlock)
				putSize(head, 4 + packet.data.len())
				head.push(byte(0x80 | part.number), byte((relative >> 8) & 0xFF), byte(relative & 0xFF), byte(key ?? (0x80, 0)))
				blocks.push(head, packet.data)
				clusterBytes += head.len() + packet.data.len()
			}
			let end = ns + int64(packet.length).max(int64(0))
			endTime = end when end > endTime
			return none
		}

		// close writes what is left: the open cluster and, to a file, the
		// Cues, the segment's size and its Duration. The writer itself
		// stays open. Closing twice does nothing.
		//
		// Fails when the writer fails, or when no track was added.
		def close() !none {
			return none when closed
			try start() unless started
			try endCluster()
			closed = true
			return none when file is none
			let f os.File = file
			let cuesAt = position
			if cues.len() > 0 {
				let body byte[]
				for let (_, c) in cues {
					let place byte[]
					putUint(place, mkvCueTrack, c.number)
					putUint(place, mkvCueCluster, c.cluster)
					putUint(place, mkvCueRelative, c.relative)
					let point byte[]
					putUint(point, mkvCueTime, c.time)
					putBytes(point, mkvCueTrackPosition, place)
					putBytes(body, mkvCuePoint, point)
				}
				let all byte[]
				putBytes(all, mkvCues, body)
				try put(all)
				try f.writeAt(seekHead(cuesAt - segmentStart), origin + seekHeadAt)
			}
			let size byte[]
			putSize(size, position - segmentStart, 8)
			try f.writeAt(size, origin + segmentSize)
			let length byte[]
			putFloat(length, mkvDuration, float64(endTime) / float64(mkvWriterScale))
			try f.writeAt(length, origin + lengthAt)
			return none
		}

		// Writes the EBML header, the segment's start, Info and Tracks.
		//
		// Fails when the writer fails, no track was added, or a Vorbis
		// track's headers are damaged.
		def start() !none {
			fail "webm: the file has no tracks" when parts.len() == 0
			started = true
			let seekable = !(file is none)
			if !(file is none) {
				let f os.File = file
				origin = int(try f.seek(0, bytes.Whence.Current))
			}
			let head byte[]
			putUint(head, ebmlVersion, 1)
			putUint(head, ebmlReadVersion, 1)
			putUint(head, ebmlMaxIdLength, 4)
			putUint(head, ebmlMaxSizeLength, 8)
			putText(head, ebmlDocType, "webm")
			// CodecDelay, SeekPreRoll and DiscardPadding are version 4
			// elements; a version 2 reader reads the rest.
			putUint(head, ebmlDocTypeVersion, 4)
			putUint(head, ebmlDocTypeReadVersion, 2)
			let out byte[]
			putBytes(out, ebmlHeader, head)
			putId(out, mkvSegment)
			segmentSize = out.len()
			// Unknown until the end: all ones.
			out.push(0x01, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF)
			segmentStart = out.len()

			let info byte[]
			putUint(info, mkvTimestampScale, mkvWriterScale)
			putText(info, mkvMuxingApp, mkvWriterName)
			putText(info, mkvWritingApp, mkvWriterName)
			let lengthIn = info.len()
			putFloat(info, mkvDuration, 0.0) when seekable
			let infoAll byte[]
			putBytes(infoAll, mkvInfo, info)

			let tracks byte[]
			for let (_, p) in parts {
				putBytes(tracks, mkvTrackEntry, try entry(p))
			}
			let tracksAll byte[]
			putBytes(tracksAll, mkvTracks, tracks)

			if seekable {
				seekHeadAt = out.len()
				infoAt = seekHeadAt + seekHead(-1).len()
				tracksAt = infoAt + infoAll.len()
				// Where the Duration element starts: past Info's id and size.
				lengthAt = infoAt + (infoAll.len() - info.len()) + lengthIn
				out.push(...seekHead(-1))
			}
			out.push(...infoAll)
			out.push(...tracksAll)
			return put(out)
		}

		// The SeekHead: where Info and Tracks start in the segment, and
		// the Cues when `cuesAt` is not negative; else a Void element
		// holds the room of that entry, so both forms are one size.
		def seekHead(cuesAt int) byte[] {
			let body byte[]
			seekEntry(body, mkvInfo, infoAt - segmentStart)
			seekEntry(body, mkvTracks, tracksAt - segmentStart)
			let room = body.len() / 2
			let out byte[]
			if cuesAt >= 0 {
				seekEntry(body, mkvCues, cuesAt)
				putBytes(out, mkvSeekHead, body)
				return out
			}
			// One byte of size holds either body, so a third entry adds
			// exactly its own bytes.
			putBytes(out, mkvSeekHead, body)
			putId(out, ebmlVoid)
			putSize(out, room - 2)
			for let i = 0; i < room - 2; i++ {
				out.push(0)
			}
			return out
		}

		// Appends one Seek entry: the element id and its position, in 8
		// bytes whatever the value.
		def seekEntry(out byte[], id int, at int) {
			let entry byte[]
			let name byte[]
			putId(name, id)
			putBytes(entry, mkvSeekId, name)
			putUint(entry, mkvSeekPosition, at.max(0), 8)
			putBytes(out, mkvSeek, entry)
		}

		// The payload of a track's TrackEntry.
		//
		// Fails when a Vorbis track's headers are damaged.
		def entry(part MuxTrack) !byte[] {
			let t = part.track
			let out byte[]
			putUint(out, mkvTrackNumber, part.number)
			putUint(out, mkvTrackUid, part.number)
			putUint(out, mkvFlagLacing, 0)
			putText(out, mkvLanguage, t.language == "" ?? ("und", t.language))
			putText(out, mkvCodecId, webmCodecId(t.codec))
			if t.kind == TrackKind.Video {
				putUint(out, mkvTrackType, 1)
				let timed = t.frameRate.numerator > 0 && t.frameRate.denominator > 0
				putUint(out, mkvDefaultDuration, int(int64(1000000000) * int64(t.frameRate.denominator) / int64(t.frameRate.numerator))) when timed
				putBytes(out, mkvCodecPrivate, t.config) when t.config.len() > 0
				let video byte[]
				putUint(video, mkvPixelWidth, int(t.width))
				putUint(video, mkvPixelHeight, int(t.height))
				if t.pixelAspect > 0.0 && t.pixelAspect != 1.0 {
					putUint(video, mkvDisplayWidth, int((float64(t.width) * t.pixelAspect).round()))
					putUint(video, mkvDisplayHeight, int(t.height))
				}
				putBytes(out, mkvVideo, video)
				return out
			}
			putUint(out, mkvTrackType, 2)
			if t.codec == "opus" {
				putUint(out, mkvCodecDelay, int(part.delay))
				putUint(out, mkvSeekPreRoll, opusSeekPreRoll)
				putBytes(out, mkvCodecPrivate, t.config)
			} else {
				putBytes(out, mkvCodecPrivate, try xiphLaced(t.config))
			}
			let audio byte[]
			putFloat(audio, mkvSamplingRate, float64(t.sampleRate))
			putUint(audio, mkvChannels, int(t.channels).max(1))
			putBytes(out, mkvAudio, audio)
			return out
		}

		// Writes the open cluster, if any, and leaves none open.
		//
		// Fails when the writer fails.
		def endCluster() !none {
			return none unless clusterOpen
			let head byte[]
			putId(head, mkvCluster)
			putSize(head, clusterBytes)
			try put(head)
			for let (_, b) in blocks {
				try put(b)
			}
			blocks = byte[][]
			clusterBytes = 0
			clusterOpen = false
			return none
		}

		// Writes all of `data` and counts it.
		//
		// Fails when the writer fails or takes no bytes.
		def put(data byte[]) !none {
			let done = 0
			for done < data.len() {
				let n = try writer.write(done == 0 ?? (data, data[done:]))
				fail "webm: the writer took no bytes" when n <= 0
				done += n
			}
			position += data.len()
			return none
		}
	}
}
