internal partial module std.formats.video.matroska {
	use (
		std.formats.audio
		std.formats.video::*
		std.formats.video.demux::*
	)

	// Samples at 48 kHz in each Opus packet the writer makes: 20 ms.
	const webmOpusFrame = 960

	// Samples an Opus decoder drops from the start, as `OpusEncoder.config`
	// declares them.
	const webmOpusPreSkip = 120

	// WebmSound turns an audio stream into the Opus packets of a WebM
	// track, in order: the sound at 48 kHz in one or two channels, in
	// packets of 20 ms, the last one as long as the sound that is left.
	type WebmSound {
		stream     audio.AudioStream
		encoder    audio.OpusEncoder
		converter  audio.Converter
		// The index `WebMWriter.add` gave the track.
		track      int
		channels   int
		inChannels int
		inRate     int
		// What the stream gave, and what of it is converted and not yet
		// encoded.
		buf        float32[]
		ready      float32[]
		readyAt    int
		frame      float32[]
		ended      bool
		// Frames at 48 kHz the stream came to, and those encoded.
		total      int64
		sent       int64

		// A feed of the stream, which has channels and a sample rate.
		def new(stream audio.AudioStream) {
			let about = stream.info()
			inChannels = int(about.channels)
			inRate = int(about.sampleRate)
			self.stream = stream
			channels = inChannels >= 2 ?? (2, 1)
			encoder = new audio.OpusEncoder(channels, channels == 2 ?? (96000, 64000))
			converter = new audio.Converter(inRate, inChannels, 48000, channels)
			buf.len(4096 * inChannels)
			frame.len(webmOpusFrame * channels)
		}

		// The track the packets belong to, as `WebMWriter.add` takes it.
		def described() Track {
			return Track{...newTrack(0, TrackKind.Audio, "opus"), config: encoder.config(inRate), sampleRate: uint32(48000), channels: uint16(channels)}
		}

		// next encodes the next packet, none once the sound is all out.
		// Times count from the first sample of the sound, so the first
		// packet starts the decoder's start-up samples before zero.
		//
		// Fails when the stream fails.
		def next() !?Packet {
			for !ended && (ready.len() - readyAt) / channels < webmOpusFrame {
				let got = try stream.read(buf)
				let more = got == 0 ?? (converter.flush(), converter.convert(got * inChannels == buf.len() ?? (buf, buf[:got * inChannels])))
				ended = got == 0
				if readyAt > 0 {
					ready = ready[readyAt:].clone()
					readyAt = 0
				}
				ready.push(...more)
				total += int64(more.len() / channels)
			}
			let end = total + int64(webmOpusPreSkip)
			return none when sent >= end
			let have = ((ready.len() - readyAt) / channels).min(webmOpusFrame)
			for let i = 0; i < webmOpusFrame * channels; i++ {
				frame[i] = i < have * channels ?? (ready[readyAt + i], float32(0.0))
			}
			readyAt += have * channels
			let data = try encoder.encode(frame, webmOpusFrame)
			let pts = duration((sent - int64(webmOpusPreSkip)) * 1000000000 / 48000)
			// Rounded up, so that it still covers its last sample.
			let left = (end - sent).min(int64(webmOpusFrame))
			let length = duration((left * 1000000000 + 47999) / 48000)
			sent += int64(webmOpusFrame)
			return newPacket(track, data, pts, pts, length, true)
		}
	}
}
