internal std.formats partial module std.formats.video.media.asf {
	use (
		std.io
		std.formats.video.media.source::*
	)

	// The Advanced Systems Format of Windows Media, shared by WMA audio and
	// the ASF/WMV demuxer: GUIDs, the header object, the data packets and
	// their payloads, and the reassembly of media objects.

	// Object and stream type identifiers, in their registry spelling.
	const (
		asfHeaderObject             = "75B22630-668E-11CF-A6D9-00AA0062CE6C"
		asfDataObject               = "75B22636-668E-11CF-A6D9-00AA0062CE6C"
		asfSimpleIndex              = "33000890-E5B1-11CF-89F4-00A0C90349CB"
		asfFilePropertiesObject     = "8CABDCA1-A947-11CF-8EE4-00C00C205365"
		asfStreamPropertiesObject   = "B7DC0791-A9B7-11CF-8EE6-00C00C205365"
		asfHeaderExtensionObject    = "5FBF03B5-A92E-11CF-8EE3-00C00C205365"
		asfExtendedStreamProperties = "14E6A5CB-C672-4332-8399-A96952065B5A"
		asfContentDescription       = "75B22633-668E-11CF-A6D9-00AA0062CE6C"
		asfExtendedContent          = "D2D0A440-E307-11D2-97F0-00A0C95EA850"
		asfAudioMedia               = "F8699E40-5B4D-11CF-A8FD-00805F5C442B"
		asfVideoMedia               = "BC19EFC0-5B4D-11CF-A8FD-00805F5C442B"
		asfCommandMedia             = "59DACFC0-59E6-11D0-A3AC-00A0C90348F6"
		asfAudioSpread              = "BFC3CD50-618F-11CF-8BB2-00AA00B4E220"
		asfReserved1                = "ABD3D211-A9BA-11CF-8EE6-00C00C205365"
	)

	// The five fields of the Content Description object, as tag names.
	const asfDescriptionTags = string["Title", "Author", "Copyright", "Description", "Rating"]

	// The 16 bytes of a GUID in its registry spelling, laid out as ASF stores
	// it: the first three groups little-endian, the rest as written.
	def asfGuid(text string) byte[] {
		let raw byte[]
		let high = -1
		for let (_, c) in text.bytes() {
			let digit = asfHexDigit(c)
			continue when digit < 0
			if high < 0 {
				high = digit
			} else {
				raw.push(byte(high << 4 | digit))
				high = -1
			}
		}
		return byte[
			raw[3], raw[2], raw[1], raw[0], raw[5], raw[4], raw[7], raw[6],
			raw[8], raw[9], raw[10], raw[11], raw[12], raw[13], raw[14], raw[15]
		]
	}

	// The value of one hexadecimal digit, -1 for any other character.
	def asfHexDigit(c byte) int {
		let v = int(c)
		return v - 0x30 when v >= 0x30 && v <= 0x39
		return v - 0x41 + 10 when v >= 0x41 && v <= 0x46
		return v - 0x61 + 10 when v >= 0x61 && v <= 0x66
		return -1
	}

	// Whether `data` holds the GUID at `at`.
	def asfIsGuid(data byte[], at int, guid string) bool {
		return false when at + 16 > data.len()
		let want = asfGuid(guid)
		for let i = 0; i < 16; i++ {
			return false when data[at + i] != want[i]
		}
		return true
	}

	// Bytes of a packet header field of length type `kind`: none, a byte,
	// a word or a double word.
	def asfFieldSize(kind int) int {
		return kind == 3 ?? (4, kind)
	}

	// UTF-16LE text of `size` bytes at `at`, up to its first NUL.
	def asfText(data byte[], at int, size int) string {
		let out byte[]
		let i = 0
		let units = size / 2
		for i < units {
			let cp = le(data, at + i * 2, 2)
			i++
			if cp >= 0xD800 && cp < 0xDC00 && i < units {
				let lo = le(data, at + i * 2, 2)
				if lo >= 0xDC00 && lo < 0xE000 {
					cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00)
					i++
				}
			}
			break when cp == 0
			if cp < 0x80 {
				out.push(byte(cp))
			} else if cp < 0x800 {
				out.push(byte(0xC0 | (cp >> 6)))
				out.push(byte(0x80 | (cp & 0x3F)))
			} else if cp < 0x10000 {
				out.push(byte(0xE0 | (cp >> 12)))
				out.push(byte(0x80 | ((cp >> 6) & 0x3F)))
				out.push(byte(0x80 | (cp & 0x3F)))
			} else {
				out.push(byte(0xF0 | (cp >> 18)))
				out.push(byte(0x80 | ((cp >> 12) & 0x3F)))
				out.push(byte(0x80 | ((cp >> 6) & 0x3F)))
				out.push(byte(0x80 | (cp & 0x3F)))
			}
		}
		return string(out)
	}

	// The kind of media a stream carries.
	enum AsfMedia {
		Audio
		Video
		Command
		Other
	}

	// One stream a header describes. Audio streams have their WAVEFORMATEX
	// fields filled in; the other fields of the format are zero for other
	// media.
	struct AsfStream {
		// Stream number, 1 to 127.
		number         int
		media          AsfMedia
		// The type-specific data: a WAVEFORMATEX for audio, the picture
		// size, flags and BITMAPINFOHEADER for video.
		format         byte[]
		formatTag      int
		channels       int
		sampleRate     int
		bytesPerSec    int
		blockAlign     int
		bitsPerSample  int
		// Codec-specific bytes after the WAVEFORMATEX fields.
		extra          byte[]
		// Audio spread: media objects are interleaved in `span` rows of
		// `chunkSize` byte chunks, `spanPacketSize` bytes per row. A span of
		// 1 or less means no interleaving.
		span           int
		spanPacketSize int
		chunkSize      int
	}

	// A stream of the media and number whose type-specific data is
	// `format`, with the WAVEFORMATEX fields read when it is audio.
	def asfStream(number int, media AsfMedia, format byte[]) AsfStream {
		let extraLen = 0
		extraLen = le(format, 16, 2).min(format.len() - 18) when media == AsfMedia.Audio && format.len() >= 18
		let audio = media == AsfMedia.Audio
		return AsfStream{
			number:         number,
			media:          media,
			format:         format,
			formatTag:      audio ?? (le(format, 0, 2), 0),
			channels:       audio ?? (le(format, 2, 2), 0),
			sampleRate:     audio ?? (le(format, 4, 4), 0),
			bytesPerSec:    audio ?? (le(format, 8, 4), 0),
			blockAlign:     audio ?? (le(format, 12, 2), 0),
			bitsPerSample:  audio ?? (le(format, 14, 2), 0),
			extra:          format[18:18 + extraLen].clone(),
			span:           0,
			spanPacketSize: 0,
			chunkSize:      0,
		}
	}

	// A media object undone from the stream's audio spread: its chunks put
	// back in order. Objects of other streams, or of other sizes, come back
	// as they are.
	def asfUnspread(stream AsfStream, data byte[]) byte[] {
		return data unless stream.span > 1 && data.len() == stream.spanPacketSize * stream.span
		let out byte[]
		out.len(data.len())
		let chunk = stream.chunkSize
		let rows = stream.spanPacketSize / chunk
		for let offset = 0; offset < data.len(); offset += chunk {
			let off = offset / chunk
			let row = off / stream.span
			let col = off % stream.span
			let from = (row + col * rows) * chunk
			data[from:from + chunk].copy(out[offset:])
		}
		return out
	}

	// The Header Object of an ASF file and the Data Object header after it.
	type AsfHeader {
		// Milliseconds added to every presentation time.
		preroll      int
		// Duration of the file including the preroll, in 100 ns units.
		playDuration int
		sendDuration int
		// File Properties flags: 1 broadcast, 2 seekable.
		flags        int
		// Bytes per data packet.
		packetSize   int
		maxBitrate   int
		// Data packets in the Data Object, 0 when not recorded.
		packetCount  int
		// Offset of the first data packet from the start of the file.
		dataOffset   int
		// Byte size of the Data Object, 0 when not recorded.
		dataSize     int
		// Every stream, in the order the header lists them.
		streams      AsfStream[]
		// The first audio stream; its number is 0 when the file has none.
		audio        AsfStream
		// The average time per frame, in 100 ns units, of the streams the
		// Extended Stream Properties give one, by stream number.
		frameTimes   map<int, int>
		// Content Description fields and Extended Content Description
		// entries by name.
		tags         map<string, string>

		// An empty header, filled by `read`.
		def new() {
			tags = new map<string, string>()
			frameTimes = new map<int, int>()
			audio = asfStream(0, AsfMedia.Other, byte[])
		}

		// Reads the Header Object and the Data Object header, leaving the
		// reader at the first data packet, which must stand at the start of
		// the file.
		//
		// Fails when the reader does not hold an ASF file, the header is cut
		// short or gives no packet size, or the reader fails.
		def read(reader io.Reader) !none {
			let head byte[]
			head.len(30)
			try io.readFull(reader, head)
			fail "asf: not an ASF file" unless asfIsGuid(head, 0, asfHeaderObject)
			let size = le(head, 16, 8)
			fail "asf: header object of {size} bytes" when size < 30 || size > 64 * 1024 * 1024
			let body byte[]
			body.len(size - 30)
			try io.readFull(reader, body)
			parseObjects(body, 0, body.len())
			let at = size

			let obj byte[]
			obj.len(24)
			let scratch byte[]
			for {
				try io.readFull(reader, obj)
				let objSize = le(obj, 16, 8)
				at += 24
				if asfIsGuid(obj, 0, asfDataObject) {
					let rest byte[]
					rest.len(26)
					try io.readFull(reader, rest)
					at += 26
					packetCount = le(rest, 16, 8)
					dataSize = objSize
					dataOffset = at
					break
				}
				fail "asf: object of {objSize} bytes before the data" when objSize < 24
				let left = objSize - 24
				for left > 0 {
					scratch.len(64 * 1024) when scratch.len() == 0
					let part = scratch[:left.min(scratch.len())]
					try io.readFull(reader, part)
					left -= part.len()
				}
				at += objSize - 24
			}
			fail "asf: the header gives no packet size" when packetSize <= 0
			return none
		}

		// Parses the objects in `data[at:end]`, and those of the Header
		// Extension object among them.
		def parseObjects(data byte[], at int, end int) {
			let pos = at
			for pos + 24 <= end {
				let size = le(data, pos + 16, 8)
				break when size < 24 || pos + size > end
				let body = pos + 24
				if asfIsGuid(data, pos, asfFilePropertiesObject) {
					playDuration = le(data, body + 40, 8)
					sendDuration = le(data, body + 48, 8)
					preroll = le(data, body + 56, 8)
					flags = le(data, body + 64, 4)
					packetSize = le(data, body + 68, 4)
					maxBitrate = le(data, body + 76, 4)
				} else if asfIsGuid(data, pos, asfStreamPropertiesObject) {
					parseStream(data, body, pos + size)
				} else if asfIsGuid(data, pos, asfHeaderExtensionObject) && size >= 46 {
					parseObjects(data, body + 22, pos + size)
				} else if asfIsGuid(data, pos, asfExtendedStreamProperties) && size >= 24 + 64 {
					let number = le(data, body + 48, 2)
					let perFrame = le(data, body + 52, 8)
					frameTimes.set(number, perFrame) when perFrame > 0
				} else if asfIsGuid(data, pos, asfContentDescription) {
					parseDescription(data, body)
				} else if asfIsGuid(data, pos, asfExtendedContent) {
					parseExtended(data, body, pos + size)
				}
				pos += size
			}
		}

		// Reads a Stream Properties object.
		def parseStream(data byte[], at int, end int) {
			let typeLen = le(data, at + 40, 4)
			let ecLen = le(data, at + 44, 4)
			let number = le(data, at + 48, 2) & 0x7F
			let fmt = at + 54
			let media = AsfMedia.Other
			if asfIsGuid(data, at, asfAudioMedia) && typeLen >= 16 {
				media = AsfMedia.Audio
			} else if asfIsGuid(data, at, asfVideoMedia) && typeLen >= 11 + 40 {
				media = AsfMedia.Video
			} else if asfIsGuid(data, at, asfCommandMedia) {
				media = AsfMedia.Command
			}
			let stop = (fmt + typeLen).min(end).max(fmt)
			let stream = asfStream(number, media, fmt < data.len() ?? (data[fmt:stop.min(data.len())].clone(), byte[]))
			let ec = fmt + typeLen
			if media == AsfMedia.Audio && asfIsGuid(data, at + 16, asfAudioSpread) && ecLen >= 5 {
				stream.span = ec < data.len() ?? (int(data[ec]), 0)
				stream.spanPacketSize = le(data, ec + 1, 2)
				stream.chunkSize = le(data, ec + 3, 2)
				let valid = stream.chunkSize > 0 && stream.spanPacketSize / stream.chunkSize > 1 && stream.spanPacketSize % stream.chunkSize == 0
				stream.span = 0 unless valid
			}
			streams.push(stream)
			audio = stream when media == AsfMedia.Audio && audio.number == 0
		}

		// Reads the Content Description object into `tags`.
		def parseDescription(data byte[], at int) {
			let pos = at + 10
			for let i = 0; i < 5; i++ {
				let len = le(data, at + i * 2, 2)
				let text = asfText(data, pos, len)
				tags.set(asfDescriptionTags[i], text) when text.len() > 0
				pos += len
			}
		}

		// Reads the Extended Content Description object into `tags`: text,
		// numbers and flags; byte arrays are left out.
		def parseExtended(data byte[], at int, end int) {
			let count = le(data, at, 2)
			let pos = at + 2
			for let i = 0; i < count && pos + 6 <= end; i++ {
				let nameLen = le(data, pos, 2)
				let name = asfText(data, pos + 2, nameLen)
				pos += 2 + nameLen
				let kind = le(data, pos, 2)
				let valueLen = le(data, pos + 2, 2)
				let v = pos + 4
				pos = v + valueLen
				break when pos > end
				if kind == 0 {
					tags.set(name, asfText(data, v, valueLen))
				} else if kind == 2 {
					tags.set(name, le(data, v, valueLen.min(4)) != 0 ?? ("true", "false"))
				} else if kind == 3 || kind == 4 || kind == 5 {
					tags.set(name, "{le(data, v, valueLen.min(8))}")
				}
			}
		}

		// Frames of audio the header's play duration covers, 0 when it
		// records none or the file has no audio stream.
		def frames() int {
			let stream = audio
			return 0 when stream.number == 0
			let length = playDuration - preroll * 10000
			return 0 when length <= 0
			return length * stream.sampleRate / 10000000
		}
	}

	// One payload of a data packet: a fragment of a media object, or a whole
	// one out of a compressed payload.
	struct AsfPayload {
		// The stream number, and whether the object is a key frame.
		stream int
		key    bool
		// The media object's number, the payload's offset into it and the
		// object's size.
		object int
		offset int
		size   int
		// The object's presentation time in milliseconds, preroll included.
		time   int
		data   byte[]
		// The packet was cut short inside this payload: `data` holds what
		// arrived.
		cut    bool
		// `data` is a whole media object.
		whole  bool
	}

	// The send time in milliseconds of a data packet, -1 when it is damaged.
	def asfSendTime(p byte[]) int {
		let i = 0
		i = 1 + int(p[0] & 0x0F) when p[0] & 0x80 != 0
		return -1 when i + 2 > p.len()
		let lengthFlags = int(p[i])
		i += 2
		i += asfFieldSize((lengthFlags >> 5) & 3)
		i += asfFieldSize((lengthFlags >> 1) & 3)
		i += asfFieldSize((lengthFlags >> 3) & 3)
		return -1 when i + 4 > p.len()
		return le(p, i, 4)
	}

	// The payloads of a data packet `p`, a whole packet of which the first
	// `avail` bytes arrived (the rest zero). A damaged packet gives the
	// payloads before the damage.
	def asfPayloads(p byte[], avail int) AsfPayload[] {
		let out AsfPayload[]
		let size = p.len()
		let i = 0
		if p[0] & 0x80 != 0 {
			return out when p[0] & 0x60 != 0
			i = 1 + int(p[0] & 0x0F)
		}
		return out when i + 2 > size
		let lengthFlags = int(p[i])
		let props = int(p[i + 1])
		i += 2
		let packetLen = le(p, i, asfFieldSize((lengthFlags >> 5) & 3))
		i += asfFieldSize((lengthFlags >> 5) & 3)
		i += asfFieldSize((lengthFlags >> 1) & 3)
		let padding = le(p, i, asfFieldSize((lengthFlags >> 3) & 3))
		i += asfFieldSize((lengthFlags >> 3) & 3)
		i += 6
		padding += size - packetLen when packetLen > 0 && packetLen < size
		let end = size - padding
		return out when end < i

		let repType = props & 3
		let offType = (props >> 2) & 3
		let objType = (props >> 4) & 3
		let multiple = lengthFlags & 1 != 0
		let count = 1
		let payloadLenType = 0
		if multiple {
			return out when i >= end
			count = int(p[i]) & 0x3F
			payloadLenType = int(p[i]) >> 6
			i++
		}
		for let k = 0; k < count; k++ {
			return out when i >= end
			let streamByte = int(p[i])
			i++
			let objNumber = le(p, i, asfFieldSize(objType))
			i += asfFieldSize(objType)
			let offset = le(p, i, asfFieldSize(offType))
			i += asfFieldSize(offType)
			let repLen = le(p, i, asfFieldSize(repType))
			i += asfFieldSize(repType)
			let objSize = 0
			let presTime = 0
			let delta = 0
			let compressed = repLen == 1
			if compressed {
				delta = i < size ?? (int(p[i]), 0)
				presTime = offset
				i++
			} else {
				if repLen >= 8 {
					objSize = le(p, i, 4)
					presTime = le(p, i + 4, 4)
				}
				i += repLen
			}
			let len = end - i
			if multiple {
				len = le(p, i, asfFieldSize(payloadLenType))
				i += asfFieldSize(payloadLenType)
			}
			return out when len < 0 || i + len > end
			let data = p[i:(i + len).min(avail.max(i))]
			let cut = i + len > avail
			i += len
			let number = streamByte & 0x7F
			let key = streamByte & 0x80 != 0
			if !compressed {
				out.push(AsfPayload{stream: number, key: key, object: objNumber, offset: offset, size: objSize, time: presTime, data: data, cut: cut, whole: false})
				continue
			}
			// Compressed payload data: whole objects, each after its size,
			// `delta` milliseconds apart.
			let j = 0
			let t = presTime
			for j < data.len() {
				let sub = int(data[j])
				j++
				break when j + sub > data.len()
				out.push(AsfPayload{stream: number, key: key, object: objNumber, offset: 0, size: sub, time: t, data: data[j:j + sub].clone(), cut: false, whole: true})
				j += sub
				t += delta
			}
		}
		return out
	}

	// A media object reassembled from its payloads.
	struct AsfObject {
		data  byte[]
		// Presentation time in milliseconds: as the payloads give it from
		// `AsfAssembler`, with the preroll removed from `AsfPacketReader`.
		time  int
		key   bool
		// The data packet the object began in.
		began int
	}

	// Reassembles the media objects of one stream from their payloads.
	type AsfAssembler {
		current     byte[]
		// The object being reassembled, -1 when none is.
		object      int
		filled      int
		time        int
		key         bool
		began       int
		// Whether an object cut off by the start of the next one is returned
		// as far as it goes, rather than dropped.
		keepPartial bool

		// An assembler with no object begun.
		def new(keepPartial bool = false) {
			self.keepPartial = keepPartial
			object = -1
		}

		// Drops any object half read.
		def reset() {
			current = byte[]
			object = -1
			filled = 0
		}

		// Adds a payload of the stream, from data packet `packet`, and
		// returns the objects it completes. A `cut` payload ends its object
		// where it ends.
		def add(payload AsfPayload, packet int) AsfObject[] {
			let done AsfObject[]
			if payload.whole {
				done.push(AsfObject{data: payload.data, time: payload.time, key: payload.key, began: packet})
				return done
			}
			let data = payload.data
			let offset = payload.offset
			if offset == 0 {
				done.push(AsfObject{data: current[0:filled].clone(), time: time, key: key, began: began}) when keepPartial && object >= 0 && filled > 0
				current = byte[]
				current.len(payload.size.max(data.len()))
				object = payload.object
				filled = 0
				time = payload.time
				key = payload.key
				began = packet
			} else if payload.object != object || offset != filled {
				object = -1
				return done
			}
			return done when object < 0 || offset + data.len() > current.len()
			data.copy(current[offset:])
			filled = offset + data.len()
			if payload.cut && filled < current.len() {
				done.push(AsfObject{data: current[0:filled], time: time, key: key, began: began})
				object = -1
			} else if filled >= current.len() {
				done.push(AsfObject{data: current, time: time, key: key, began: began})
				object = -1
				filled = 0
			}
			return done
		}
	}

	// Reads the data packets of an ASF file and returns the media objects
	// of one stream in order.
	type AsfPacketReader {
		reader    io.Reader
		header    AsfHeader
		stream    AsfStream
		packet    byte[]
		// Index of the next packet to read.
		index     int
		ready     AsfObject[]
		head      int
		assembler AsfAssembler
		ended     bool

		// Reads packets from `reader`, which stands at the first packet.
		def new(reader io.Reader, header AsfHeader, stream AsfStream) {
			self.reader = reader
			self.header = header
			self.stream = stream
			packet.len(header.packetSize)
			assembler = new AsfAssembler()
		}

		// The next media object, or none at the end of the data.
		//
		// Fails when the reader does.
		def next() !?AsfObject {
			for head >= ready.len() {
				return none when ended
				ready = AsfObject[]
				head = 0
				try readPacket()
			}
			let obj = ready[head]
			head++
			return obj
		}

		// Positions at packet `index`, which the reader must already stand
		// at, dropping anything half read.
		def restart(index int) {
			self.index = index
			ready = AsfObject[]
			head = 0
			assembler.reset()
			ended = false
		}

		// Reads one packet and queues the objects it completes.
		def readPacket() !none {
			if header.packetCount > 0 && index >= header.packetCount {
				ended = true
				return none
			}
			let n = 0
			for n < packet.len() {
				let got = try reader.read(packet[n:])
				break when got == 0
				n += got
			}
			if n < packet.len() {
				// A file cut short: what arrived of the last packet still
				// counts, and an object it cuts off is returned as far as it
				// goes.
				ended = true
				return none when n == 0
				for let i = n; i < packet.len(); i++ {
					packet[i] = 0
				}
			}
			index++
			for let (_, payload) in asfPayloads(packet, n) {
				continue when payload.stream != stream.number
				for let (_, obj) in assembler.add(payload, index - 1) {
					obj.data = asfUnspread(stream, obj.data)
					obj.time -= header.preroll
					ready.push(obj)
				}
			}
			return none
		}

		// The packet's send time in milliseconds, -1 when it is damaged.
		def sendTime(p byte[]) int {
			return asfSendTime(p)
		}
	}
}
