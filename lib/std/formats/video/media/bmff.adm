internal std.formats partial module std.formats.video.media.bmff {
	use std.formats.video.media.source::*

	// The ISO base media file format (ISO/IEC 14496-12) box layer that MP4,
	// M4A, QuickTime and 3GP share: box headers, big-endian fields, and a
	// writer that sizes boxes as they close. Box types are held as their four
	// bytes read big-endian into an int, so `©nam` compares like any other
	// type.

	const (
		boxFtyp = 0x66747970 // ftyp
		boxMoov = 0x6D6F6F76 // moov
		boxMdat = 0x6D646174 // mdat
		boxFree = 0x66726565 // free
		boxSkip = 0x736B6970 // skip
		boxWide = 0x77696465 // wide
		boxMvhd = 0x6D766864 // mvhd
		boxTrak = 0x7472616B // trak
		boxTkhd = 0x746B6864 // tkhd
		boxEdts = 0x65647473 // edts
		boxElst = 0x656C7374 // elst
		boxMdia = 0x6D646961 // mdia
		boxMdhd = 0x6D646864 // mdhd
		boxHdlr = 0x68646C72 // hdlr
		boxMinf = 0x6D696E66 // minf
		boxSmhd = 0x736D6864 // smhd
		boxDinf = 0x64696E66 // dinf
		boxDref = 0x64726566 // dref
		boxUrl  = 0x75726C20 // "url "
		boxStbl = 0x7374626C // stbl
		boxStsd = 0x73747364 // stsd
		boxStts = 0x73747473 // stts
		boxCtts = 0x63747473 // ctts
		boxStss = 0x73747373 // stss
		boxStsc = 0x73747363 // stsc
		boxStsz = 0x7374737A // stsz
		boxStz2 = 0x73747A32 // stz2
		boxStco = 0x7374636F // stco
		boxCo64 = 0x636F3634 // co64
		boxMvex = 0x6D766578 // mvex
		boxTrex = 0x74726578 // trex
		boxMoof = 0x6D6F6F66 // moof
		boxTraf = 0x74726166 // traf
		boxTfhd = 0x74666864 // tfhd
		boxTfdt = 0x74666474 // tfdt
		boxTrun = 0x7472756E // trun
		boxMp4a = 0x6D703461 // mp4a
		boxAlac = 0x616C6163 // alac
		boxSamr = 0x73616D72 // samr
		boxSawb = 0x73617762 // sawb
		boxEsds = 0x65736473 // esds
		boxWave = 0x77617665 // wave
		boxPasp = 0x70617370 // pasp
		boxAvcC = 0x61766343 // avcC
		boxHvcC = 0x68766343 // hvcC
		boxVpcC = 0x76706343 // vpcC
		boxAv1C = 0x61763143 // av1C
		boxDOps = 0x644F7073 // dOps
		boxVide = 0x76696465 // vide
		boxSoun = 0x736F756E // soun
		boxUdta = 0x75647461 // udta
		boxMeta = 0x6D657461 // meta
		boxMdir = 0x6D646972 // mdir
		boxAppl = 0x6170706C // appl
		boxIlst = 0x696C7374 // ilst
		boxData = 0x64617461 // data
		boxName = 0x6E616D65 // name
		boxNam  = 0xA96E616D // ©nam
		boxArt  = 0xA9415254 // ©ART
		boxAlb  = 0xA9616C62 // ©alb
		boxDay  = 0xA9646179 // ©day
		boxTrkn = 0x74726B6E // trkn
		boxCovr = 0x636F7672 // covr
		boxItem = 0x2D2D2D2D // "----", a free-form iTunes item
	)

	// `ftyp` brands.
	const (
		brandM4a  = 0x4D344120 // "M4A "
		brandM4b  = 0x4D344220 // "M4B "
		brandM4p  = 0x4D345020 // "M4P "
		brandIsom = 0x69736F6D // isom
		brandIso2 = 0x69736F32 // iso2
		brandMp41 = 0x6D703431 // mp41
		brandMp42 = 0x6D703432 // mp42
		brandDash = 0x64617368 // dash
		brandQt   = 0x71742020 // "qt  "
		brand3gp4 = 0x33677034 // 3gp4
		brand3gp5 = 0x33677035 // 3gp5
		brand3gp6 = 0x33677036 // 3gp6
		brand3g2a = 0x33673261 // 3g2a
	)

	// One box: its type and the byte range of its payload in the bytes it
	// was read from.
	struct Box {
		// The box type's four bytes, big-endian.
		kind  int
		// Offset of the first payload byte, just after the header.
		start int
		// Offset one past the last payload byte.
		end   int
	}

	// Reads boxes and big-endian fields out of bytes holding boxes: a whole
	// file, a `moov` payload or a `moof` payload.
	type BoxReader {
		// The bytes the boxes lie in.
		data byte[]

		// A reader over the bytes.
		def new(data byte[]) {
			self.data = data
		}

		// The byte at `at`.
		def u8(at int) int {
			return int(data[at])
		}

		// The big-endian 16-bit value at `at`.
		def u16(at int) int {
			return int(data[at]) << 8 | int(data[at + 1])
		}

		// The big-endian 24-bit value at `at`.
		def u24(at int) int {
			return int(data[at]) << 16 | int(data[at + 1]) << 8 | int(data[at + 2])
		}

		// The big-endian 32-bit value at `at`, unsigned.
		def u32(at int) int {
			return int(data[at]) << 24 | int(data[at + 1]) << 16 | int(data[at + 2]) << 8 | int(data[at + 3])
		}

		// The big-endian 32-bit value at `at`, signed.
		def s32(at int) int {
			let v = u32(at)
			return v >= 0x80000000 ?? (v - 0x100000000, v)
		}

		// The big-endian 64-bit value at `at`.
		def u64(at int) int {
			return u32(at) << 32 | u32(at + 4)
		}

		// The boxes laid end to end in `start`..`end`.
		//
		// Fails when a box header is cut short or a box runs past `end`.
		def boxes(start int, end int) !Box[] {
			let found Box[]
			let at = start
			for at + 8 <= end {
				let size = u32(at)
				let kind = u32(at + 4)
				let header = 8
				if size == 1 {
					fail "mp4: box header cut short at {at}" when at + 16 > end
					size = u64(at + 8)
					header = 16
				} else if size == 0 {
					size = end - at
				}
				fail "mp4: box of {size} bytes at {at} is smaller than its header" when size < header
				fail "mp4: box {fourcc(kind)} at {at} runs past its parent" when at + size > end
				found.push(Box{kind: kind, start: at + header, end: at + size})
				at += size
			}
			return found
		}

		// The boxes inside `parent`'s payload.
		//
		// Fails when one of them is damaged.
		def children(parent Box) !Box[] {
			return boxes(parent.start, parent.end)
		}

		// The first box of the kind inside `parent`, none when there is none.
		//
		// Fails when a box inside `parent` is damaged.
		def child(parent Box, kind int) !?Box {
			for let (_, box) in try children(parent) {
				return box when box.kind == kind
			}
			return none
		}

		// The box at the end of the path of kinds under `parent`, none when a
		// step is missing.
		//
		// Fails when a box on the way is damaged.
		def path(parent Box, kinds ...int) !?Box {
			let at = parent
			for let (_, kind) in kinds {
				let next = try child(at, kind)
				return none when next is none
				at = next
			}
			return at
		}

		// Whether `box`'s payload holds at least `count` bytes.
		def holds(box Box, count int) bool {
			return box.end - box.start >= count
		}
	}

	// Builds boxes into bytes, filling in each box's size when it closes.
	type BoxWriter {
		// The bytes written so far.
		out byte[]

		// An empty writer.
		def new() {}

		// Appends one byte.
		def u8(v int) {
			out.push(byte(v & 0xFF))
		}

		// Appends a big-endian 16-bit value.
		def u16(v int) {
			u8(v >> 8)
			u8(v)
		}

		// Appends a big-endian 24-bit value.
		def u24(v int) {
			u8(v >> 16)
			u8(v >> 8)
			u8(v)
		}

		// Appends a big-endian 32-bit value.
		def u32(v int) {
			u8(v >> 24)
			u8(v >> 16)
			u8(v >> 8)
			u8(v)
		}

		// Appends a big-endian 64-bit value.
		def u64(v int) {
			u32(v >> 32)
			u32(v)
		}

		// Appends `count` zero bytes.
		def zeros(count int) {
			for let i = 0; i < count; i++ {
				out.push(byte(0))
			}
		}

		// Appends the bytes.
		def bytes(data byte[]) {
			for let (_, b) in data {
				out.push(b)
			}
		}

		// Opens a box of the kind and returns where it starts, for `close`.
		def box(kind int) int {
			let at = out.len()
			u32(0)
			u32(kind)
			return at
		}

		// Opens a full box (one with a version and flags) and returns where it
		// starts, for `close`.
		def fullBox(kind int, version int, flags int) int {
			let at = box(kind)
			u8(version)
			u24(flags)
			return at
		}

		// Closes the box opened at `at` by writing its size.
		def close(at int) {
			let size = out.len() - at
			out[at] = byte((size >> 24) & 0xFF)
			out[at + 1] = byte((size >> 16) & 0xFF)
			out[at + 2] = byte((size >> 8) & 0xFF)
			out[at + 3] = byte(size & 0xFF)
		}

		// How many bytes are written.
		def len() int {
			return out.len()
		}
	}
}
