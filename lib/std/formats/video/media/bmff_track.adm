internal std.formats partial module std.formats.video.media.bmff {
	// The parts of a `trak` every ISO base media reader needs: the media
	// header, the sound sample entry, the `esds` descriptors, the edit list,
	// and the sample tables flattened into one entry per sample from the
	// classic `stbl` tables or from movie fragments.

	// What `mdhd` says about a track's media.
	struct MediaHeader {
		// Ticks per second of the media's sample times.
		timescale int
		// Length of the media in `timescale` ticks.
		length    int
		// The packed ISO 639-2 language code: three five-bit letters.
		language  int
	}

	// The fields of a sound sample entry (`mp4a`, `alac`, `Opus`, ...).
	struct SoundEntry {
		// The QuickTime sound description version: 1 and 2 add fields.
		version    int
		channels   int
		// Bits per sample the entry declares.
		sampleSize int
		sampleRate int
		// Where the boxes inside the entry start.
		children   int
	}

	// What the `esds` descriptors say about an MPEG-4 elementary stream.
	struct Esds {
		// The DecoderConfigDescriptor's object type: 0x40 for MPEG-4 audio.
		objectType int
		// Average bits per second, 0 when the descriptor does not say.
		avgBitrate int
		// The DecoderSpecificInfo bytes, empty when there are none.
		config     byte[]
		// Whether a DecoderSpecificInfo was found.
		found      bool
	}

	// The first edit of an edit list that plays media, and the empty edits
	// before it.
	struct EditList {
		// Media ticks the leading empty edits delay the track by.
		delay  int
		// Where in the media playback starts, in media ticks; -1 when no edit
		// plays media.
		start  int
		// How long that edit plays, in movie ticks.
		length int
	}

	// The defaults `trex` gives the samples of a track's movie fragments.
	struct TrackDefaults {
		duration int
		size     int
		flags    int
	}

	// Reads `mdhd`.
	//
	// Fails when the box is too short or the timescale is zero.
	def mediaHeader(r BoxReader, box Box) !MediaHeader {
		let at = box.start
		let wide = r.holds(box, 4) && r.u8(at) == 1
		fail "mp4: mdhd box is too short" unless r.holds(box, wide ?? (32, 20))
		let lang = at + (wide ?? (32, 20))
		let header = MediaHeader{
			timescale: r.u32(at + (wide ?? (20, 12))),
			length:    wide ?? (r.u64(at + 24), r.u32(at + 16)),
			language:  lang + 2 <= box.end ?? (r.u16(lang), 0),
		}
		fail "mp4: the track has a zero timescale" when header.timescale == 0
		return header
	}

	// The fields of a sound sample entry, none when it is too short to hold
	// them.
	def soundEntry(r BoxReader, entry Box) ?SoundEntry {
		return none unless r.holds(entry, 28)
		let s = SoundEntry{
			version:    r.u16(entry.start + 8),
			channels:   r.u16(entry.start + 16),
			sampleSize: r.u16(entry.start + 18),
			sampleRate: r.u32(entry.start + 24) >> 16,
			children:   entry.start + 28,
		}
		if s.version == 1 {
			s.children += 16
		} else if s.version == 2 {
			return none unless r.holds(entry, 64)
			s.sampleRate = int(__bitcast_f64_from_u64(uint64(r.u64(entry.start + 32))))
			s.channels = r.u32(entry.start + 40)
			s.sampleSize = r.u32(entry.start + 48)
			s.children += 36
		}
		return none when s.children > entry.end
		return s
	}

	// The `esds` box among a sample entry's boxes, or inside QuickTime's
	// `wave` box there; none when there is none.
	//
	// Fails when a box on the way is damaged.
	def findEsds(r BoxReader, inner Box) !?Box {
		let found = try r.child(inner, boxEsds)
		return found unless found is none
		let wave = try r.child(inner, boxWave)
		return none when wave is none
		let quicktime Box = wave
		return r.child(quicktime, boxEsds)
	}

	// Reads the `esds` descriptors: the object type, the average bit rate
	// and the DecoderSpecificInfo bytes. A descriptor that runs past the box
	// ends the reading with what was found before it.
	def esds(r BoxReader, box Box) Esds {
		let out = Esds{objectType: 0, avgBitrate: 0, config: byte[], found: false}
		let at = box.start + 4
		let limit = box.end
		for at < limit {
			let tag = r.u8(at)
			at++
			let size = 0
			for let i = 0; i < 4 && at < limit; i++ {
				let b = r.u8(at)
				at++
				size = size << 7 | (b & 0x7F)
				break when b & 0x80 == 0
			}
			break when at + size > limit
			if tag == 3 {
				// ES_Descriptor: its id, flags, then the descriptors inside.
				break when size < 3
				let flags = r.u8(at + 2)
				let skip = 3
				skip += 2 when flags & 0x80 != 0
				skip += 1 + r.u8(at + skip) when flags & 0x40 != 0 && at + skip < limit
				skip += 2 when flags & 0x20 != 0
				limit = at + size
				at += skip
			} else if tag == 4 {
				// DecoderConfigDescriptor: the fixed fields, then its
				// DecoderSpecificInfo.
				break when size < 13
				out.objectType = r.u8(at)
				out.avgBitrate = r.u32(at + 9)
				limit = at + size
				at += 13
			} else if tag == 5 {
				out.config = r.data[at:at + size].clone()
				out.found = true
				return out
			} else {
				at += size
			}
		}
		return out
	}

	// The codec name of an MPEG-4 systems object type, empty when unknown.
	def objectCodec(objectType int) string {
		return "aac" when objectType := 0x40 || 0x66 || 0x67 || 0x68
		return "mp3" when objectType := 0x69 || 0x6B
		return "mpeg4" when objectType == 0x20
		return "h264" when objectType == 0x21
		return "mpeg2" when objectType >= 0x60 && objectType <= 0x65
		return "mpeg1" when objectType == 0x6A
		return "vorbis" when objectType == 0xDD
		return ""
	}

	// Reads the edit list with the movie's and the media's timescales: the
	// empty edits before the first edit that plays media, and that edit.
	// Entries the box is too short for are left out.
	def editList(r BoxReader, elst Box, movieScale int, timescale int) EditList {
		let out = EditList{delay: 0, start: -1, length: 0}
		return out unless r.holds(elst, 8)
		let wide = r.u8(elst.start) == 1
		let entries = r.u32(elst.start + 4)
		let step = wide ?? (20, 12)
		for let i = 0; i < entries && r.holds(elst, 8 + (i + 1) * step); i++ {
			let at = elst.start + 8 + i * step
			let length = wide ?? (r.u64(at), r.u32(at))
			let start = wide ?? (r.u64(at + 8), r.s32(at + 4))
			// An empty edit (media time -1) only delays the track.
			if start < 0 || wide && start == 0x7FFFFFFFFFFFFFFF {
				out.delay += movieScale > 0 ?? (length * timescale / movieScale, 0)
				continue
			}
			out.start = start
			out.length = length
			return out
		}
		return out
	}

	// The `trex` defaults for the track with the id, zero when `mvex` gives
	// none.
	//
	// Fails when a box inside `mvex` is damaged.
	def trackDefaults(r BoxReader, mvex Box, id int) !TrackDefaults {
		let out = TrackDefaults{duration: 0, size: 0, flags: 0}
		for let (_, trex) in try r.children(mvex) {
			continue unless trex.kind == boxTrex && r.holds(trex, 24)
			continue unless r.u32(trex.start + 4) == id
			out.duration = r.u32(trex.start + 12)
			out.size = r.u32(trex.start + 16)
			out.flags = r.u32(trex.start + 20)
		}
		return out
	}

	// The id of the track a `traf` adds samples to, -1 when it has no
	// `tfhd`.
	//
	// Fails when a box inside it is damaged or `tfhd` is too short.
	def fragmentTrack(r BoxReader, traf Box) !int {
		let header = try r.child(traf, boxTfhd)
		return -1 when header is none
		let tfhd Box = header
		fail "mp4: tfhd box is too short" unless r.holds(tfhd, 8)
		return r.u32(tfhd.start + 4)
	}

	// The samples of one track, one entry per sample: where each lies in the
	// file, its size, decode time, composition offset and whether it is a
	// sync sample.
	type SampleTable {
		offsets    int[]
		sizes      int[]
		// Decode time of each sample in the track's ticks, and its
		// composition offset.
		times      int[]
		shifts     int[]
		sync       bool[]
		// The sample entry of each sample, from 1 as `stsc` numbers them;
		// shorter than the table when fragments add samples, which use the
		// first.
		entries    int[]
		// Decode time one past the last sample.
		end        int
		// The tick delta of the first `stts` run, 0 when there is none.
		firstDelta int

		// An empty table.
		def new() {}

		// How many samples the table holds.
		def count() int {
			return sizes.len()
		}

		// The first sample whose time span holds tick `t`, or the sample
		// count when `t` is past the last.
		def sampleAt(t int) int {
			let lo = 0
			let hi = times.len()
			for lo < hi {
				let mid = (lo + hi) / 2
				let next = mid + 1 < times.len() ?? (times[mid + 1], end)
				if next <= t {
					lo = mid + 1
				} else {
					hi = mid
				}
			}
			return lo
		}

		// Reads stts, ctts, stss, stsz or stz2, stsc and stco or co64 out of
		// `stbl`. Returns false, reading nothing, when one of the tables every
		// track needs is missing.
		//
		// Fails when a table is damaged or the tables disagree.
		def read(r BoxReader, stbl Box) !bool {
			let sttsBox = try r.child(stbl, boxStts)
			let stscBox = try r.child(stbl, boxStsc)
			let stszBox = try r.child(stbl, boxStsz)
			stszBox = try r.child(stbl, boxStz2) when stszBox is none
			let stcoBox = try r.child(stbl, boxStco)
			stcoBox = try r.child(stbl, boxCo64) when stcoBox is none
			return false when sttsBox is none || stscBox is none || stszBox is none || stcoBox is none
			let stts Box = sttsBox
			let stsc Box = stscBox
			let stsz Box = stszBox
			let stco Box = stcoBox

			// Sizes.
			fail "mp4: stsz box is too short" unless r.holds(stsz, 12)
			let count = r.u32(stsz.start + 8)
			if stsz.kind == boxStsz {
				let fixed = r.u32(stsz.start + 4)
				fail "mp4: stsz box is too short" unless fixed != 0 || r.holds(stsz, 12 + count * 4)
				for let i = 0; i < count; i++ {
					sizes.push(fixed != 0 ?? (fixed, r.u32(stsz.start + 12 + i * 4)))
				}
			} else {
				let bits = r.u8(stsz.start + 7)
				fail "mp4: stz2 field size {bits} is not 4, 8 or 16" unless bits := 4 || 8 || 16
				fail "mp4: stz2 box is too short" unless r.holds(stsz, 12 + (count * bits + 7) / 8)
				for let i = 0; i < count; i++ {
					let at = stsz.start + 12
					if bits == 16 {
						sizes.push(r.u16(at + i * 2))
					} else if bits == 8 {
						sizes.push(r.u8(at + i))
					} else {
						let b = r.u8(at + i / 2)
						sizes.push(i % 2 == 0 ?? (b >> 4, b & 0x0F))
					}
				}
			}

			// Decode times.
			fail "mp4: stts box is too short" unless r.holds(stts, 8)
			let runs = r.u32(stts.start + 4)
			fail "mp4: stts box is too short" unless r.holds(stts, 8 + runs * 8)
			let time = 0
			for let i = 0; i < runs; i++ {
				let n = r.u32(stts.start + 8 + i * 8)
				let delta = r.u32(stts.start + 12 + i * 8)
				firstDelta = delta when i == 0
				for let k = 0; k < n && times.len() < count; k++ {
					times.push(time)
					time += delta
				}
			}
			fail "mp4: stts covers {times.len()} samples, stsz lists {count}" when times.len() != count
			end = time

			// Composition offsets.
			shifts.len(count)
			let cttsBox = try r.child(stbl, boxCtts)
			if !(cttsBox is none) {
				let ctts Box = cttsBox
				if r.holds(ctts, 8) {
					let entries = r.u32(ctts.start + 4)
					let signed = r.u8(ctts.start) == 1
					let i = 0
					for let e = 0; e < entries && r.holds(ctts, 16 + e * 8); e++ {
						let n = r.u32(ctts.start + 8 + e * 8)
						let off = signed ?? (r.s32(ctts.start + 12 + e * 8), r.u32(ctts.start + 12 + e * 8))
						off = r.s32(ctts.start + 12 + e * 8) when off >= 0x80000000
						for let k = 0; k < n && i < count; k++ {
							shifts[i] = off
							i++
						}
					}
				}
			}

			// Sync samples: all of them when there is no `stss`.
			sync.len(count)
			let stssBox = try r.child(stbl, boxStss)
			if stssBox is none {
				sync.fill(true)
			} else {
				let stss Box = stssBox
				let entries = r.holds(stss, 8) ?? (r.u32(stss.start + 4), 0)
				for let e = 0; e < entries && r.holds(stss, 12 + e * 4); e++ {
					let n = r.u32(stss.start + 8 + e * 4)
					sync[n - 1] = true when n >= 1 && n <= count
				}
			}

			// Offsets: each chunk's samples lie back to back from its offset.
			let wide = stco.kind == boxCo64
			fail "mp4: chunk offset box is too short" unless r.holds(stco, 8)
			let chunks = r.u32(stco.start + 4)
			fail "mp4: chunk offset box is too short" unless r.holds(stco, 8 + chunks * (wide ?? (8, 4)))
			fail "mp4: stsc box is too short" unless r.holds(stsc, 8)
			let entries = r.u32(stsc.start + 4)
			fail "mp4: stsc box is too short" unless r.holds(stsc, 8 + entries * 12)
			let sample = 0
			for let e = 0; e < entries; e++ {
				let first = r.u32(stsc.start + 8 + e * 12)
				let perChunk = r.u32(stsc.start + 12 + e * 12)
				let last = e + 1 < entries ?? (r.u32(stsc.start + 20 + e * 12) - 1, chunks)
				let entry = r.u32(stsc.start + 16 + e * 12)
				fail "mp4: stsc names chunk {first}, stco has {chunks}" when first < 1 || last > chunks
				for let c = first; c <= last && sample < count; c++ {
					let at = wide ?? (r.u64(stco.start + 8 + (c - 1) * 8), r.u32(stco.start + 8 + (c - 1) * 4))
					for let k = 0; k < perChunk && sample < count; k++ {
						offsets.push(at)
						self.entries.push(entry)
						at += sizes[sample]
						sample++
					}
				}
			}
			fail "mp4: stsc places {offsets.len()} samples, stsz lists {count}" when offsets.len() != count
			return true
		}

		// Adds the samples of one track fragment. `moofAt` is the file offset
		// of the first byte of the `moof` box's header, which data offsets
		// count from unless `tfhd` names a base; `defaults` are the track's
		// `trex` values.
		//
		// Fails when the fragment's boxes are damaged or too short.
		def readFragment(r BoxReader, traf Box, moofAt int, defaults TrackDefaults) !none {
			let header = try r.child(traf, boxTfhd)
			fail "mp4: track fragment without a tfhd box" when header is none
			let tfhd Box = header
			fail "mp4: tfhd box is too short" unless r.holds(tfhd, 8)
			let flags = r.u24(tfhd.start + 1)
			let base = moofAt
			let duration = defaults.duration
			let size = defaults.size
			let sampleFlags = defaults.flags
			let at = tfhd.start + 8
			if flags & 0x01 != 0 {
				fail "mp4: tfhd box is too short" when at + 8 > tfhd.end
				base = r.u64(at)
				at += 8
			}
			at += 4 when flags & 0x02 != 0
			if flags & 0x08 != 0 {
				fail "mp4: tfhd box is too short" when at + 4 > tfhd.end
				duration = r.u32(at)
				at += 4
			}
			if flags & 0x10 != 0 {
				fail "mp4: tfhd box is too short" when at + 4 > tfhd.end
				size = r.u32(at)
				at += 4
			}
			if flags & 0x20 != 0 {
				fail "mp4: tfhd box is too short" when at + 4 > tfhd.end
				sampleFlags = r.u32(at)
				at += 4
			}

			let decode = try r.child(traf, boxTfdt)
			if !(decode is none) {
				let tfdt Box = decode
				let wide = r.holds(tfdt, 4) && r.u8(tfdt.start) == 1
				fail "mp4: tfdt box is too short" unless r.holds(tfdt, wide ?? (12, 8))
				end = wide ?? (r.u64(tfdt.start + 4), r.u32(tfdt.start + 4))
			}

			let pos = base
			for let (_, trun) in try r.children(traf) {
				continue unless trun.kind == boxTrun
				fail "mp4: trun box is too short" unless r.holds(trun, 8)
				let runFlags = r.u24(trun.start + 1)
				let signed = r.u8(trun.start) == 1
				let count = r.u32(trun.start + 4)
				let field = trun.start + 8
				if runFlags & 0x01 != 0 {
					fail "mp4: trun box is too short" when field + 4 > trun.end
					pos = base + r.s32(field)
					field += 4
				}
				let firstFlags = -1
				if runFlags & 0x04 != 0 {
					fail "mp4: trun box is too short" when field + 4 > trun.end
					firstFlags = r.u32(field)
					field += 4
				}
				let stride = 0
				for let (_, bit) in int[0x100, 0x200, 0x400, 0x800] {
					stride += 4 when runFlags & bit != 0
				}
				fail "mp4: trun box is too short" when field + count * stride > trun.end
				for let i = 0; i < count; i++ {
					let d = duration
					let s = size
					let sf = i == 0 && firstFlags >= 0 ?? (firstFlags, sampleFlags)
					let shift = 0
					if runFlags & 0x100 != 0 {
						d = r.u32(field)
						field += 4
					}
					if runFlags & 0x200 != 0 {
						s = r.u32(field)
						field += 4
					}
					if runFlags & 0x400 != 0 {
						sf = r.u32(field)
						field += 4
					}
					if runFlags & 0x800 != 0 {
						shift = signed ?? (r.s32(field), r.u32(field))
						field += 4
					}
					offsets.push(pos)
					sizes.push(s)
					times.push(end)
					shifts.push(shift)
					sync.push(sf & 0x10000 == 0)
					end += d
					pos += s
				}
			}
			return none
		}
	}
}
