internal std.formats partial module std.formats.video.media.ogg {
	use (
		std.io
		std.formats.video.media.source::*
	)

	// The Ogg container's page and packet layer (RFC 3533), shared by the
	// codecs Ogg carries: Vorbis and Opus audio, Theora video. Pages, lacing,
	// the CRC and the granule position live here once; codecs and demuxers
	// read and write whole packets.

	// Page header flag: the page starts with the rest of a packet begun on an
	// earlier page.
	const oggContinued = 1

	// Page header flag: the first page of a logical stream.
	const oggBeginning = 2

	// Page header flag: the last page of a logical stream.
	const oggEnd = 4

	// Bytes in a page header before its segment table.
	const oggHeaderSize = 27

	// Body size after which the writer ends a page once a packet completes.
	const oggPageTarget = 4096

	// The page checksum table: CRC-32 with the polynomial 0x04C11DB7, most
	// significant bit first, no reflection, initial value 0 and no final xor.
	let oggCrcTable = oggBuildCrcTable()

	// The 256 entries of `oggCrcTable`.
	def oggBuildCrcTable() int[] {
		let table int[]
		table.len(256)
		for let i = 0; i < 256; i++ {
			let r = i << 24
			for let j = 0; j < 8; j++ {
				if (r & 0x80000000) != 0 {
					r = ((r << 1) ^ 0x04C11DB7) & 0xFFFFFFFF
				} else {
					r = (r << 1) & 0xFFFFFFFF
				}
			}
			table[i] = r
		}
		return table
	}

	// The page checksum continued from `crc` over `data[from:to]`.
	def oggCrc(crc int, data byte[], from int, to int) int {
		let c = crc
		for let i = from; i < to; i++ {
			c = ((c << 8) & 0xFFFFFFFF) ^ oggCrcTable[((c >> 24) ^ int(data[i])) & 0xFF]
		}
		return c
	}

	// Stores the low `size` bytes of `v` little-endian at `at`.
	def oggPutLittle(data byte[], at int, size int, v int) {
		for let i = 0; i < size; i++ {
			data[at + i] = byte((v >> (8 * i)) & 0xFF)
		}
	}

	// Whether `data` holds the capture pattern "OggS" at `at`.
	def oggCapture(data byte[], at int) bool {
		return at + 4 <= data.len() && data[at] == 79 && data[at + 1] == 103 && data[at + 2] == 103 && data[at + 3] == 83
	}

	// The header fields of an Ogg page.
	struct OggPageHeader {
		// File offset of the page.
		offset   int
		flags    int
		granule  int
		serial   int
		// The segment table, and the body length it adds up to.
		lacing   byte[]
		bodySize int
	}

	// The header of the page at file offset `offset` whose first 27 bytes are
	// `head` and whose segment table is `lacing`.
	def oggPageHeader(offset int, head byte[], lacing byte[]) OggPageHeader {
		let size = 0
		for let (_, b) in lacing {
			size += int(b)
		}
		return OggPageHeader{
			offset:   offset,
			flags:    int(head[5]),
			granule:  le(head, 6, 8),
			serial:   le(head, 14, 4),
			lacing:   lacing,
			bodySize: size,
		}
	}

	// Joins the packets of one logical stream across its pages.
	type OggJoiner {
		// The start of a packet the next page continues.
		joined byte[]
		// Skipping the tail of a packet whose start was not read.
		orphan bool

		// A joiner at the start of a stream.
		def new() {}

		// Forgets any packet begun, for reading on from a page in the middle
		// of the stream: the tail of a packet its first page continues is
		// skipped.
		def reset() {
			joined = byte[]
			orphan = true
		}

		// The whole packets the page completes, joining one begun on an
		// earlier page and keeping the start of one it leaves unfinished.
		def packets(page OggPageHeader, body byte[]) byte[][] {
			let out byte[][]
			if page.flags & oggContinued == 0 {
				// A packet left unfinished by the page before is lost.
				joined = byte[]
				orphan = false
			} else if joined.len() == 0 {
				orphan = true
			}
			let at = 0
			let size = 0
			for let (_, lace) in page.lacing {
				size += int(lace)
				continue when int(lace) == 255
				let piece = body[at:at + size]
				at += size
				size = 0
				if orphan {
					orphan = false
					continue
				}
				if joined.len() > 0 {
					out.push(joined.concat(piece))
					joined = byte[]
				} else {
					out.push(piece.clone())
				}
			}
			if size > 0 {
				return out when orphan
				joined = joined.concat(body[at:at + size])
			}
			return out
		}
	}

	// Reads the packets of one logical stream, in order, joining those that
	// span pages.
	type OggPacketReader {
		reader       io.Reader
		header       byte[]
		lacing       byte[]
		body         byte[]
		joiner       OggJoiner
		// The packets the current page completes, and the next to return.
		queue        byte[][]
		queued       int
		streamSerial uint32
		following    bool
		pageGranule  int64
		pageFlags    int
		lastGranule  int64
		lastOnPage   bool
		lastOnFinal  bool
		ended        bool

		// Reads pages from the reader.
		def new(reader io.Reader) {
			self.reader = reader
			header.len(oggHeaderSize)
			lacing.len(255)
			body.len(255 * 255)
			joiner = new OggJoiner()
			lastGranule = -1
			pageGranule = -1
		}

		// Reads only the logical stream with this serial number, instead of
		// the first one found. Used when resuming in the middle of a stream.
		def follow(serial uint32) {
			streamSerial = serial
			following = true
		}

		// The next packet, or none at the end of the stream.
		//
		// Fails when a page is damaged (bad capture pattern or CRC) or the
		// reader fails.
		def next() !?byte[] {
			for queued >= queue.len() {
				return none when ended
				let more = try readPage()
				if !more {
					ended = true
					return none
				}
			}
			let packet = queue[queued]
			queued++
			lastGranule = pageGranule
			lastOnPage = queued == queue.len()
			lastOnFinal = lastOnPage && (pageFlags & oggEnd) != 0
			return packet
		}

		// The granule position of the page the last packet returned ended on,
		// -1 when that page ends no packet.
		def granule() int64 {
			return lastGranule
		}

		// The stream's serial number, 0 before the first page.
		def serial() uint32 {
			return streamSerial
		}

		// Whether the last packet returned is the last one ending on its page,
		// the one whose end the page's granule position marks.
		def last() bool {
			return lastOnPage
		}

		// Whether the last packet returned ends the stream: the last packet
		// of the page marked end of stream.
		def final() bool {
			return lastOnFinal
		}

		// Reads bytes until `buf` is full or the stream ends, and returns how
		// many arrived.
		def fill(buf byte[]) !int {
			let n = 0
			for n < buf.len() {
				let got = try reader.read(buf[n:])
				break when got == 0
				n += got
			}
			return n
		}

		// Loads the next page of the followed stream and queues the packets
		// it completes; false at the end of the input or after the stream's
		// last page. A page cut short by the end of the input ends the stream.
		def readPage() !bool {
			for {
				let got = try fill(header)
				return false when got < oggHeaderSize
				fail "ogg: bad capture pattern" unless oggCapture(header, 0)
				fail "ogg: unsupported stream structure version {header[4]}" when header[4] != 0
				let count = int(header[26])
				let laced = lacing[0:count]
				return false when (try fill(laced)) < count
				let page = oggPageHeader(0, header, laced)
				let size = page.bodySize
				return false when (try fill(body[0:size])) < size
				let expected = le(header, 22, 4)
				header[22] = 0
				header[23] = 0
				header[24] = 0
				header[25] = 0
				let crc = oggCrc(0, header, 0, oggHeaderSize)
				crc = oggCrc(crc, lacing, 0, count)
				crc = oggCrc(crc, body, 0, size)
				fail "ogg: page checksum mismatch" when crc != expected
				let pageSerial = uint32(page.serial)
				if !following {
					streamSerial = pageSerial
					following = true
				}
				continue when pageSerial != streamSerial
				pageFlags = page.flags
				pageGranule = int64(page.granule)
				queue = joiner.packets(page, body[0:size])
				queued = 0
				ended = true when (pageFlags & oggEnd) != 0
				return true
			}
			return false
		}
	}

	// One page of a logical stream in an Ogg file held in memory: where it
	// starts and the granule position it carries.
	struct OggPage {
		offset  int
		granule int64
	}

	// Lists the pages of the logical stream with the serial number in the
	// file's bytes, reading headers only. A damaged page ends the list.
	def oggPages(data byte[], serial uint32) OggPage[] {
		let pages OggPage[]
		let at = 0
		for at + oggHeaderSize <= data.len() {
			break unless oggCapture(data, at)
			let count = int(data[at + 26])
			break when at + oggHeaderSize + count > data.len()
			let size = 0
			for let i = 0; i < count; i++ {
				size += int(data[at + oggHeaderSize + i])
			}
			let end = at + oggHeaderSize + count + size
			break when end > data.len()
			pages.push(OggPage{offset: at, granule: int64(le(data, at + 6, 8))}) when uint32(le(data, at + 14, 4)) == serial
			at = end
		}
		return pages
	}

	// Writes the packets of one logical stream as pages.
	type OggPacketWriter {
		writer       io.Writer
		streamSerial uint32
		sequence     int
		lacing       byte[]
		segments     int
		body         byte[]
		size         int
		// Granule position of the last packet ending on the page, -1 when none
		// does yet.
		granule      int64
		started      bool
		// The page being filled starts with the rest of a packet.
		continued    bool
		closed       bool

		// Writes pages of the stream with this serial number to the writer.
		def new(writer io.Writer, serial uint32) {
			self.writer = writer
			streamSerial = serial
			lacing.len(255)
			body.len(oggPageTarget * 2)
			granule = -1
		}

		// Adds a packet whose last sample is at the granule position. A packet
		// that must start a page of its own (a header) is followed by `flush`.
		//
		// Fails when the writer fails.
		def write(packet byte[], granule int64) !none {
			let at = 0
			for {
				if segments == 255 {
					try emit(false)
					continued = at > 0
				}
				let lace = packet.len() - at
				lace = 255 when lace > 255
				if size + lace > body.len() {
					let grown byte[]
					grown.len((size + lace) * 2)
					body[0:size].copy(grown) when size > 0
					body = grown
				}
				packet[at:at + lace].copy(body[size:]) when lace > 0
				size += lace
				at += lace
				lacing[segments] = byte(lace)
				segments++
				break when lace < 255
			}
			self.granule = granule
			try emit(false) when size >= oggPageTarget
			return none
		}

		// Ends the current page, even when it has room left.
		//
		// Fails when the writer fails.
		def flush() !none {
			try emit(false) when segments > 0
			return none
		}

		// Writes what is left as the last page, marked end of stream.
		//
		// Fails when the writer fails.
		def close() !none {
			return none when closed
			try emit(true)
			closed = true
			return none
		}

		// Writes the page held so far, marked end of stream when `last`.
		def emit(last bool) !none {
			let page byte[]
			page.len(oggHeaderSize + segments + size)
			page[0] = 79
			page[1] = 103
			page[2] = 103
			page[3] = 83
			let flags = 0
			flags |= oggContinued when continued
			flags |= oggBeginning unless started
			flags |= oggEnd when last
			page[5] = byte(flags)
			oggPutLittle(page, 6, 8, int(granule))
			oggPutLittle(page, 14, 4, int(streamSerial))
			oggPutLittle(page, 18, 4, sequence)
			page[26] = byte(segments)
			lacing[0:segments].copy(page[oggHeaderSize:]) when segments > 0
			body[0:size].copy(page[oggHeaderSize + segments:]) when size > 0
			let crc = oggCrc(0, page, 0, page.len())
			oggPutLittle(page, 22, 4, crc)
			let written = 0
			for written < page.len() {
				let n = try writer.write(page[written:])
				fail "ogg: the writer accepted no bytes" when n <= 0
				written += n
			}
			started = true
			sequence++
			segments = 0
			size = 0
			continued = false
			granule = -1
			return none
		}
	}
}
