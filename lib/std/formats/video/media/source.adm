internal std.formats partial module std.formats.video.media.source {
	use (
		std.io
		std.bytes
		std.os
	)

	// Bytes the window grows by when it refills.
	const sourceChunk = 64 * 1024

	// The bytes of a container file: a cursor that reads forward through a
	// window, and random access when the reader is a `bytes.Reader` or an
	// `os.File`.
	type Source {
		reader io.Reader
		random bool
		// Bytes in the source, -1 when unknown.
		total  int
		window byte[]
		// File offset of window[0] and the bytes the window holds.
		start  int
		held   int
		// File offset of the cursor.
		pos    int
		ended  bool

		// A source over the reader, which stands at its first byte.
		def new(reader io.Reader) {
			self.reader = reader
			total = -1
			let r = reader
			if r is bytes.Reader {
				random = true
				total = r.size()
			} else if r is os.File {
				random = true
				let end = r.seek(int64(0), bytes.Whence.End) onerror recover int64(-1)
				r.seek(int64(0)) onerror recover int64(0)
				total = int(end)
				random = end >= 0
			}
			window.len(sourceChunk)
		}

		// Whether `seek` can move back and `bytesAt` works.
		def seekable() bool {
			return random
		}

		// Bytes in the source, -1 when the reader does not say.
		def size() int {
			return total
		}

		// File offset of the next byte `read` returns.
		def position() int {
			return pos
		}

		// Makes the window hold `count` bytes from the cursor, or as many as
		// are left. Returns how many it holds.
		//
		// Fails when the reader does.
		def fill(count int) !int {
			let have = start + held - pos
			return count when have >= count
			if pos > start {
				let keep = held - (pos - start)
				window[pos - start:held].copy(window) when keep > 0
				start = pos
				held = keep.max(0)
			}
			window.len(count + sourceChunk) when count > window.len()
			for held < count && !ended {
				let n = try reader.read(window[held:])
				if n <= 0 {
					ended = true
					break
				}
				held += n
			}
			return held.min(count)
		}

		// Whether the cursor is at the end of the source.
		//
		// Fails when the reader does.
		def atEnd() !bool {
			return (try fill(1)) < 1
		}

		// The next `count` bytes, copied, without moving the cursor; fewer at
		// the end of the source.
		//
		// Fails when the reader does.
		def peek(count int) !byte[] {
			let n = try fill(count)
			return window[pos - start:pos - start + n].clone()
		}

		// The next `count` bytes, copied.
		//
		// Fails when the source ends first or the reader fails.
		def read(count int) !byte[] {
			expects {
				assert count >= 0 onerror fail "media: negative read of {count} bytes"
			}
			let n = try fill(count)
			fail "media: the file ends {count - n} bytes early at {pos}" when n < count
			let out = window[pos - start:pos - start + count].clone()
			pos += count
			return out
		}

		// read implements io.Reader: fills `buf` from the cursor and returns
		// how many bytes it took, 0 at the end of the source.
		//
		// Fails when the reader does.
		def read(buf byte[]) !int {
			let n = try fill(buf.len())
			window[pos - start:pos - start + n].copy(buf) when n > 0
			pos += n
			return n
		}

		// The next byte.
		//
		// Fails when the source ends or the reader fails.
		def u8() !int {
			fail "media: the file ends early at {pos}" when (try fill(1)) < 1
			let v = int(window[pos - start])
			pos++
			return v
		}

		// The next `count` bytes as a big-endian number.
		//
		// Fails when the source ends first or the reader fails.
		def be(count int) !int {
			expects {
				assert (try fill(count)) >= count onerror fail "media: the file ends early at {pos}"
			}
			let v = 0
			let at = pos - start
			for let i = 0; i < count; i++ {
				v = v << 8 | int(window[at + i])
			}
			pos += count
			return v
		}

		// The next `count` bytes as a little-endian number.
		//
		// Fails when the source ends first or the reader fails.
		def le(count int) !int {
			expects {
				assert (try fill(count)) >= count onerror fail "media: the file ends early at {pos}"
			}
			let v = 0
			let at = pos - start
			for let i = count - 1; i >= 0; i-- {
				v = v << 8 | int(window[at + i])
			}
			pos += count
			return v
		}

		// Moves the cursor forward by `count` bytes; past the end it stops at
		// the end.
		//
		// Fails when the reader does.
		def skip(count int) !none {
			return none when count <= 0
			if pos + count <= start + held {
				pos += count
				return none
			}
			if random {
				let target = pos + count
				target = total when total >= 0 && target > total
				return seek(target)
			}
			let left = count
			for left > 0 {
				let n = try fill(left.min(sourceChunk))
				break when n == 0
				pos += n
				left -= n
			}
			return none
		}

		// Moves the cursor to the file offset.
		//
		// Fails when the reader cannot seek and the offset lies behind the
		// window, or the reader fails.
		def seek(offset int) !none {
			expects {
				assert offset >= 0 onerror fail "media: seek to negative offset {offset}"
			}
			if offset >= start && offset <= start + held {
				pos = offset
				return none
			}
			if !random {
				fail "media: the stream cannot seek back to {offset}" when offset < pos
				return skip(offset - pos)
			}
			let r = reader
			if r is bytes.Reader {
				try r.seek(offset)
			} else if r is os.File {
				try r.seek(int64(offset))
			}
			start = offset
			held = 0
			pos = offset
			ended = false
			return none
		}

		// `count` bytes at the file offset, copied, leaving the cursor where
		// it is.
		//
		// Fails when the source cannot seek, the range lies past its end, or
		// the reader fails.
		def bytesAt(offset int, count int) !byte[] {
			return window[offset - start:offset - start + count].clone() when offset >= start && offset + count <= start + held
			let back = pos
			try seek(offset)
			let out = try read(count)
			try seek(back)
			return out
		}

		// Closes the file the source reads, if it is one.
		//
		// Fails when closing it does.
		def close() !none {
			let r = reader
			return r.close() when r is os.File
			return none
		}
	}

	// A source that can seek: the reader itself when it is a
	// `bytes.Reader` or an `os.File`, else its bytes read into memory.
	//
	// Fails when reading the reader does.
	def randomSource(reader io.Reader) !Source {
		let src = new Source(reader)
		return src when src.seekable()
		let buf = new bytes.Buffer()
		try buf.readFrom(reader)
		return new Source(new bytes.Reader(buf.bytes()))
	}

	// The big-endian number of `count` bytes at `at`, 0 for bytes past the
	// end.
	def be(data byte[], at int, count int) int {
		let v = 0
		for let i = 0; i < count; i++ {
			v = v << 8 | (at + i < data.len() ?? (int(data[at + i]), 0))
		}
		return v
	}

	// The little-endian number of `count` bytes at `at`, 0 for bytes past
	// the end.
	def le(data byte[], at int, count int) int {
		let v = 0
		for let i = count - 1; i >= 0; i-- {
			v = v << 8 | (at + i < data.len() ?? (int(data[at + i]), 0))
		}
		return v
	}

	// The four characters of a code as ASCII text, for messages.
	def fourcc(code int) string {
		let b byte[]
		for let shift = 24; shift >= 0; shift -= 8 {
			let c = (code >> shift) & 0xFF
			b.push(c >= 0x20 && c < 0x7F ?? (byte(c), byte(0x3F)))
		}
		return string(b)
	}
}
