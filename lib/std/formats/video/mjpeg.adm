partial module std.formats.video {
	use std.formats.image

	// MJPEG decodes Motion JPEG, the video of many cameras: every frame is a
	// JPEG picture (baseline or progressive), and frames that leave out
	// their Huffman tables use the standard ones. Pictures keep the frame's
	// own chroma sampling (4:2:0, 4:2:2 or 4:4:4, or gray) at JPEG's full
	// range.
	@decoder("mjpeg")
	type MJPEG {
		internal jpeg image.JPEG

		def new() {
			jpeg = new image.JPEG()
		}

		// Motion JPEG needs no setup bytes. Never fails.
		def configure(track Track) !none {
			return none
		}

		// Decodes one frame. Fails when it is not a JPEG picture this
		// decoder reads, is damaged, or is coded in RGB or a chroma sampling
		// no `ChromaLayout` holds. An empty packet (a dropped frame) produces
		// no picture.
		def decode(packet Packet) !VideoFrame[] {
			return [] when packet.data.len() == 0
			let found = try jpeg.planes(packet.data)
			return [try picture(found, packet)]
		}

		// Every frame stands alone: nothing is held back. Never fails.
		def flush() !VideoFrame[] {
			return []
		}

		// The planes of `p` cropped to the frame, stamped with the packet's
		// time.
		// Fails for RGB frames and samplings no ChromaLayout holds.
		internal def picture(p image.JpegPlanes, packet Packet) !VideoFrame {
			expects {
				assert !p.rgb onerror fail "mjpeg: frames coded in RGB are not supported"
			}
			let w = p.width
			let h = p.height
			let y = crop(p.data, p.offsets[0], p.strides[0], w, h)
			return VideoFrame{width: uint32(w), height: uint32(h), y: y, u: byte[], v: byte[], yStride: w, uvStride: 0, time: packet.pts, length: packet.length, keyframe: true, matrix: 601, chroma: ChromaLayout.Mono, fullRange: true} when p.offsets.len() == 1
			let full = p.hSampling[0] == p.hMax && p.vSampling[0] == p.vMax
			let same = p.hSampling[1] == p.hSampling[2] && p.vSampling[1] == p.vSampling[2]
			fail "mjpeg: unsupported chroma sampling" unless full && same && p.hMax % p.hSampling[1] == 0 && p.vMax % p.vSampling[1] == 0
			let hs = p.hMax / p.hSampling[1]
			let vs = p.vMax / p.vSampling[1]
			let layout = ChromaLayout.Yuv444
			if hs == 2 && vs == 2 {
				layout = ChromaLayout.Yuv420
			} else if hs == 2 && vs == 1 {
				layout = ChromaLayout.Yuv422
			} else if hs != 1 || vs != 1 {
				fail "mjpeg: unsupported chroma sampling {hs}x{vs}"
			}
			let cw = (w + hs - 1) / hs
			let ch = (h + vs - 1) / vs
			return VideoFrame{
				width:     uint32(w),
				height:    uint32(h),
				y:         y,
				u:         crop(p.data, p.offsets[1], p.strides[1], cw, ch),
				v:         crop(p.data, p.offsets[2], p.strides[2], cw, ch),
				yStride:   w,
				uvStride:  cw,
				time:      packet.pts,
				length:    packet.length,
				keyframe:  true,
				matrix:    601,
				chroma:    layout,
				fullRange: true
			}
		}

		// The top-left `w` x `h` samples of the plane at `offset`, `stride`
		// bytes a row, packed.
		internal def crop(data byte[], offset int, stride int, w int, h int) byte[] {
			let out byte[]
			out.len(w * h)
			for let j = 0; j < h; j++ {
				let from = offset + j * stride
				data[from:from + w].copy(out[j * w:j * w + w])
			}
			return out
		}
	}
}
