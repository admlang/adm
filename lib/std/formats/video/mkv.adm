partial module std.formats.video {
	use (
		std.io
		std.formats.video.demux::*
		std.formats.media.source::*
		std.formats.video.matroska::*
	)

	// MKV is the Matroska container and its WebM subset: EBML headers,
	// SimpleBlock and BlockGroup frames with Xiph, EBML and fixed lacing,
	// header-stripping compression, and Cues for seeking.
	// `VideoInfo.container` is "webm" or "mkv" by the file's DocType.
	@codec("MKV")
	type MKV {
		mimeType string[] {
			def get() string[] {
				return string["video/x-matroska", "video/webm", "audio/x-matroska", "audio/webm"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".mkv", ".webm", ".mka", ".mk3d"]
			}
		}

		// matchSignature reports whether the reader starts with an EBML
		// header.
		def matchSignature(r io.Reader) bool {
			let head byte[]
			head.len(4)
			let n = io.readFull(r, head) onerror recover 0
			return n == 4 && be(head, 0, 4) == ebmlHeader
		}

		// open reads the EBML header, the segment information and the
		// tracks, up to the first cluster.
		//
		// Fails when the file is not Matroska, it has no Tracks element
		// before the first cluster, or the reader fails.
		def open(reader io.Reader) !Container {
			let c = new MkvContainer(new Source(reader))
			try c.read()
			return c
		}
	}
}
