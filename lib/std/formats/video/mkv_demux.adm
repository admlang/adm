internal partial module std.formats.video.matroska {
	use (
		std.formats.video::*
		std.formats.video.demux::*
		std.formats.media.source::*
		std.bytes
		std.data.compress.bzip2
		std.data.compress.zlib
	)

	const (
		ebmlHeader          = 0x1A45DFA3
		ebmlDocType         = 0x4282
		mkvSegment          = 0x18538067
		mkvSeekHead         = 0x114D9B74
		mkvSeek             = 0x4DBB
		mkvSeekId           = 0x53AB
		mkvSeekPosition     = 0x53AC
		mkvInfo             = 0x1549A966
		mkvTimestampScale   = 0x2AD7B1
		mkvDuration         = 0x4489
		mkvTracks           = 0x1654AE6B
		mkvTrackEntry       = 0xAE
		mkvTrackNumber      = 0xD7
		mkvTrackType        = 0x83
		mkvCodecId          = 0x86
		mkvCodecPrivate     = 0x63A2
		mkvLanguage         = 0x22B59C
		mkvDefaultDuration  = 0x23E383
		mkvCodecDelay       = 0x56AA
		mkvVideo            = 0xE0
		mkvPixelWidth       = 0xB0
		mkvPixelHeight      = 0xBA
		mkvDisplayWidth     = 0x54B0
		mkvDisplayHeight    = 0x54BA
		mkvAudio            = 0xE1
		mkvSamplingRate     = 0xB5
		mkvChannels         = 0x9F
		mkvBitDepth         = 0x6264
		mkvEncodings        = 0x6D80
		mkvEncoding         = 0x6240
		mkvEncodingScope    = 0x5032
		mkvEncodingType     = 0x5033
		mkvCompression      = 0x5034
		mkvCompAlgo         = 0x4254
		mkvCompSettings     = 0x4255
		mkvCluster          = 0x1F43B675
		mkvClusterTimestamp = 0xE7
		mkvSimpleBlock      = 0xA3
		mkvBlockGroup       = 0xA0
		mkvBlock            = 0xA1
		mkvBlockDuration    = 0x9B
		mkvReferenceBlock   = 0xFB
		mkvCues             = 0x1C53BB6B
		mkvCuePoint         = 0xBB
		mkvCueTime          = 0xB3
		mkvCueTrackPosition = 0xB7
		mkvCueTrack         = 0xF7
		mkvCueCluster       = 0xF1
		mkvTags             = 0x1254C367
		mkvChapters         = 0x1043A770
		mkvAttachments      = 0x1941A469
	)

	// One EBML element held in memory: its id and the byte range of its
	// payload.
	struct Element {
		id    int
		start int
		end   int
	}

	// The length of the variable-size integer whose first byte is `b`, 0
	// for a byte that starts none.
	def vintLength(b int) int {
		for let n = 1; n <= 8; n++ {
			return n when b & (0x100 >> n) != 0
		}
		return 0
	}

	// The elements laid end to end in data[start:end]; an element that
	// runs past `end` ends the list, cut to what is there.
	def elements(data byte[], start int, end int) Element[] {
		let found Element[]
		let at = start
		for at < end {
			let idLen = vintLength(int(data[at]))
			break when idLen == 0 || idLen > 4 || at + idLen >= end
			let id = be(data, at, idLen)
			at += idLen
			let sizeLen = vintLength(int(data[at]))
			break when sizeLen == 0 || at + sizeLen > end
			let size = int(data[at]) & (0xFF >> sizeLen)
			let unknown = size == (0xFF >> sizeLen)
			for let i = 1; i < sizeLen; i++ {
				size = size << 8 | int(data[at + i])
				unknown = unknown && int(data[at + i]) == 0xFF
			}
			at += sizeLen
			let stop = unknown || at + size > end ?? (end, at + size)
			found.push(Element{id: id, start: at, end: stop})
			at = stop
		}
		return found
	}

	// The unsigned value of an element.
	def uintOf(data byte[], e Element) int {
		return be(data, e.start, e.end - e.start)
	}

	// The floating-point value of an element: 4 or 8 bytes.
	def floatOf(data byte[], e Element) float64 {
		let n = e.end - e.start
		return float64(__bitcast_f32_from_u32(uint32(be(data, e.start, 4)))) when n == 4
		return __bitcast_f64_from_u64(uint64(be(data, e.start, 8))) when n == 8
		return 0.0
	}

	// The text of an element, up to its first NUL.
	def textOf(data byte[], e Element) string {
		let end = e.start
		for end < e.end && data[end] != 0 {
			end++
		}
		return string(data[e.start:end])
	}

	// The codec name of a Matroska CodecID, empty when unknown.
	// `data` decompressed by ContentCompAlgo `algo`: 0 zlib, 1 bzip2.
	//
	// Fails when the data is damaged, or for LZO (2), which std lacks.
	def inflate(data byte[], algo int) !byte[] {
		fail "mkv: LZO-compressed tracks are not supported" when algo == 2
		fail "mkv: unknown content compression {algo}" unless algo := 0 || 1
		let src = new bytes.Reader(data)
		let out byte[]
		let buf byte[]
		buf.len(65536)
		if algo == 0 {
			let r = new zlib.Reader(src)
			for {
				let n = try r.read(buf)
				break when n <= 0
				out.push(...buf[:n])
			}
		} else {
			let r = new bzip2.Reader(src)
			for {
				let n = try r.read(buf)
				break when n <= 0
				out.push(...buf[:n])
			}
		}
		return out
	}

	def mkvCodec(id string, private byte[]) string {
		return "h264" when id == "V_MPEG4/ISO/AVC"
		return "hevc" when id == "V_MPEGH/ISO/HEVC"
		return "vp8" when id == "V_VP8"
		return "vp9" when id == "V_VP9"
		return "av1" when id == "V_AV1"
		return "theora" when id == "V_THEORA"
		return "mpeg1" when id == "V_MPEG1"
		return "mpeg2" when id == "V_MPEG2"
		return "mpeg4" when id.startsWith("V_MPEG4/ISO/")
		return "mjpeg" when id == "V_MJPEG"
		return bitmapCodec(be(private, 16, 4)) when id == "V_MS/VFW/FOURCC" && private.len() >= 20
		return "aac" when id.startsWith("A_AAC")
		return "mp3" when id == "A_MPEG/L3"
		return "mp2" when id == "A_MPEG/L2"
		return "mp1" when id == "A_MPEG/L1"
		return "vorbis" when id == "A_VORBIS"
		return "opus" when id == "A_OPUS"
		return "flac" when id == "A_FLAC"
		return "ac3" when id == "A_AC3"
		return "eac3" when id == "A_EAC3"
		return "dts" when id == "A_DTS"
		return "pcm" when id.startsWith("A_PCM")
		return waveCodecOf(private) when id == "A_MS/ACM" && private.len() >= 2
		return "text" when id == "S_TEXT/UTF8"
		return "ass" when id := "S_TEXT/ASS" || "S_TEXT/SSA" || "S_ASS" || "S_SSA"
		return "webvtt" when id == "S_TEXT/WEBVTT"
		return "dvdsub" when id == "S_VOBSUB"
		return "pgs" when id == "S_HDMV/PGS"
		return ""
	}

	// Xiph-laced header packets (a count less one, then the lengths of all
	// but the last) rewritten as each packet preceded by its 2-byte
	// big-endian length.
	def xiphHeaders(private byte[]) byte[] {
		return private when private.len() < 3
		let count = int(private[0]) + 1
		let at = 1
		let sizes int[]
		for let i = 0; i < count - 1; i++ {
			let size = 0
			for at < private.len() {
				let b = int(private[at])
				at++
				size += b
				break when b < 255
			}
			sizes.push(size)
		}
		let used = 0
		for let (_, s) in sizes {
			used += s
		}
		sizes.push(private.len() - at - used)
		let out byte[]
		for let (_, s) in sizes {
			return private when s < 0 || at + s > private.len()
			out.push(byte((s >> 8) & 0xFF), byte(s & 0xFF))
			for let i = 0; i < s; i++ {
				out.push(private[at + i])
			}
			at += s
		}
		return out
	}

	// An AudioSpecificConfig for an AAC track that names its profile in the
	// CodecID instead of storing one.
	def aacConfig(id string, rate int, channels int) byte[] {
		let objectType = 2
		objectType = 1 when id.endsWith("/MAIN")
		objectType = 3 when id.endsWith("/SSR")
		objectType = 4 when id.endsWith("/LTP")
		let rates = int[96000, 88200, 64000, 48000, 44100, 32000, 24000, 22050, 16000, 12000, 11025, 8000, 7350]
		let index = 4
		for let (i, r) in rates {
			if r == rate {
				index = i
				break
			}
		}
		let v = objectType << 11 | index << 7 | (channels & 0xF) << 3
		return byte[byte(v >> 8), byte(v & 0xFF)]
	}

	// One track of a Matroska file as the blocks name it.
	type MkvTrack {
		track           Track
		number          int
		// Nanoseconds each frame lasts, 0 when not declared.
		defaultDuration int
		// Nanoseconds taken off every timestamp: the codec's start-up delay.
		codecDelay      int
		// Bytes removed from the start of every frame by header stripping.
		stripped        byte[]
		// ContentCompAlgo of the frames: 0 zlib, 1 bzip2, 2 LZO; -1 when
		// they are stored as they are.
		compression     int    = -1

		def new() {}
	}

	// A keyframe of the main video track: the cluster it lies in and its
	// time.
	struct CuePoint {
		time    duration
		cluster int
	}

	// The demultiplexer of a Matroska or WebM file.
	type MkvContainer {
		src          Source
		docType      string
		parts        MkvTrack[]
		list         Track[]
		byNumber     map<int, int>
		// Nanoseconds per timestamp tick.
		scale        int
		// File offset of the segment's payload, which positions count from,
		// and of its end (-1 when the size is unknown).
		segmentStart int
		segmentEnd   int
		firstCluster int
		cuesAt       int
		cues         CuePoint[]
		cuesRead     bool
		// The cluster being read: its end (-1 when unknown) and timestamp.
		clusterEnd   int
		clusterTime  int
		inCluster    bool
		// Frames of the last block not yet returned.
		ready        Packet[]
		readyAt      int
		// The segment duration Info gives, zero when it gives none.
		infoLength   duration
		// Packets presenting before this time are dropped: a seek target.
		dropBefore   duration
		dropping     bool

		def new(src Source) {
			self.src = src
			byNumber = new map<int, int>()
			scale = 1000000
			segmentEnd = -1
			cuesAt = -1
			clusterEnd = -1
		}

		// The element id at the cursor, -1 at the end of the file.
		//
		// Fails when the reader does or the id is malformed.
		def readId() !int {
			return -1 when try src.atEnd()
			let first = try src.u8()
			let n = vintLength(first)
			fail "mkv: bad element id at {src.position() - 1}" when n == 0 || n > 4
			let id = first
			for let i = 1; i < n; i++ {
				id = id << 8 | (try src.u8())
			}
			return id
		}

		// The element size at the cursor, -1 when unknown.
		//
		// Fails when the reader does or the size is malformed.
		def readSize() !int {
			let first = try src.u8()
			let n = vintLength(first)
			fail "mkv: bad element size at {src.position() - 1}" when n == 0
			let size = first & (0xFF >> n)
			let unknown = size == (0xFF >> n)
			for let i = 1; i < n; i++ {
				let b = try src.u8()
				size = size << 8 | b
				unknown = unknown && b == 0xFF
			}
			return unknown ?? (-1, size)
		}

		// Reads the EBML header and the segment's elements up to its first
		// cluster.
		//
		// Fails when the file is not Matroska, it has no tracks, or the
		// reader fails.
		def read() !none {
			fail "mkv: not an EBML file" when (try readId()) != ebmlHeader
			let headerSize = try readSize()
			fail "mkv: EBML header of unknown size" when headerSize < 0
			let header = try src.read(headerSize)
			docType = "matroska"
			for let (_, e) in elements(header, 0, header.len()) {
				docType = textOf(header, e) when e.id == ebmlDocType
			}
			for {
				let id = try readId()
				fail "mkv: the file has no segment" when id < 0
				let size = try readSize()
				if id == mkvSegment {
					segmentStart = src.position()
					segmentEnd = size < 0 ?? (-1, segmentStart + size)
					break
				}
				fail "mkv: element of unknown size before the segment" when size < 0
				try src.skip(size)
			}
			let seenTracks = false
			for {
				let at = src.position()
				let id = try readId()
				break when id < 0
				let size = try readSize()
				if id == mkvCluster {
					firstCluster = at
					try src.seek(at)
					break
				}
				fail "mkv: element {id} of unknown size in the segment" when size < 0
				if id == mkvInfo {
					readInfo(try src.read(size))
				} else if id == mkvTracks {
					try readTracks(try src.read(size))
					seenTracks = true
				} else if id == mkvSeekHead {
					readSeekHead(try src.read(size))
				} else if id == mkvCues {
					readCues(try src.read(size))
				} else {
					try src.skip(size)
				}
			}
			fail "mkv: the file has no tracks" unless seenTracks
			return none
		}

		// Reads the timestamp scale and duration out of Info.
		def readInfo(data byte[]) {
			let length = float64(0.0)
			for let (_, e) in elements(data, 0, data.len()) {
				if e.id == mkvTimestampScale {
					scale = uintOf(data, e)
				} else if e.id == mkvDuration {
					length = floatOf(data, e)
				}
			}
			scale = 1000000 when scale <= 0
			let total = duration(int64(length * float64(scale)))
			for let (_, p) in parts {
				p.track.length = total
			}
			infoLength = total
		}

		// Reads each TrackEntry of Tracks.
		// Fails when a track's CodecPrivate does not decompress.
		def readTracks(data byte[]) !none {
			for let (_, entry) in elements(data, 0, data.len()) {
				continue unless entry.id == mkvTrackEntry
				let part = new MkvTrack()
				let kind = TrackKind.Data
				let codecId = ""
				let private byte[]
				let privateAlgo = -1
				let language = "eng"
				let width = 0
				let height = 0
				let displayWidth = 0
				let displayHeight = 0
				let rate = float64(0.0)
				let channels = 1
				let bitDepth = 0
				for let (_, e) in elements(data, entry.start, entry.end) {
					if e.id == mkvTrackNumber {
						part.number = uintOf(data, e)
					} else if e.id == mkvTrackType {
						let t = uintOf(data, e)
						if t == 1 {
							kind = TrackKind.Video
						} else if t == 2 {
							kind = TrackKind.Audio
						} else if t == 0x11 {
							kind = TrackKind.Subtitle
						}
					} else if e.id == mkvCodecId {
						codecId = textOf(data, e)
					} else if e.id == mkvCodecPrivate {
						private = data[e.start:e.end].clone()
					} else if e.id == mkvLanguage {
						language = textOf(data, e)
					} else if e.id == mkvDefaultDuration {
						part.defaultDuration = uintOf(data, e)
					} else if e.id == mkvCodecDelay {
						part.codecDelay = uintOf(data, e)
					} else if e.id == mkvVideo {
						for let (_, v) in elements(data, e.start, e.end) {
							if v.id == mkvPixelWidth {
								width = uintOf(data, v)
							} else if v.id == mkvPixelHeight {
								height = uintOf(data, v)
							} else if v.id == mkvDisplayWidth {
								displayWidth = uintOf(data, v)
							} else if v.id == mkvDisplayHeight {
								displayHeight = uintOf(data, v)
							}
						}
					} else if e.id == mkvAudio {
						for let (_, a) in elements(data, e.start, e.end) {
							if a.id == mkvSamplingRate {
								rate = floatOf(data, a)
							} else if a.id == mkvChannels {
								channels = uintOf(data, a)
							} else if a.id == mkvBitDepth {
								bitDepth = uintOf(data, a)
							}
						}
					} else if e.id == mkvEncodings {
						privateAlgo = readEncodings(part, data, e)
					}
				}
				private = try inflate(private, privateAlgo) when privateAlgo >= 0
				let t = newTrack(parts.len(), kind, mkvCodec(codecId, private))
				if t.codec == "pcm" {
					t.codec = pcmCodec(bitDepth, codecId == "A_PCM/FLOAT/IEEE", codecId == "A_PCM/INT/BIG")
				}
				t.language = language == "und" ?? ("", language)
				t.length = infoLength
				t.config = private
				if t.codec := "vorbis" || "theora" {
					t.config = xiphHeaders(private)
				} else if t.codec == "aac" && private.len() == 0 {
					t.config = aacConfig(codecId, int(rate), channels)
				} else if codecId == "V_MS/VFW/FOURCC" {
					t.config = private.len() > 40 ?? (private[40:].clone(), byte[])
				} else if codecId == "A_MS/ACM" {
					t.config = waveConfig(t.codec, private)
				}
				if kind == TrackKind.Video {
					t.width = uint32(width)
					t.height = uint32(height)
					if part.defaultDuration > 0 {
						let g = gcd(1000000000, part.defaultDuration)
						t.frameRate = FrameRate{numerator: uint32(1000000000 / g), denominator: uint32(part.defaultDuration / g)}
					}
					t.pixelAspect = float64(displayWidth * height) / float64(displayHeight * width) when displayWidth > 0 && displayHeight > 0 && width > 0 && height > 0
				} else if kind == TrackKind.Audio {
					// Opus always decodes at 48 kHz, whatever rate the source had.
					t.sampleRate = t.codec == "opus" ?? (uint32(48000), uint32(int(rate)))
					t.channels = uint16(channels)
				}
				part.track = t
				byNumber.set(part.number, parts.len())
				parts.push(part)
				list.push(t)
			}
			return none
		}

		// Reads the compression of ContentEncodings: header stripping and
		// zlib or bzip2 for the frames, which `frameOf` undoes; returns the
		// algorithm that also covers CodecPrivate, -1 for none. Encrypted
		// tracks are left to the codec.
		def readEncodings(part MkvTrack, data byte[], encodings Element) int {
			let privateAlgo = -1
			for let (_, enc) in elements(data, encodings.start, encodings.end) {
				continue unless enc.id == mkvEncoding
				// Scope bit 1: the frames; bit 2: CodecPrivate.
				let scope = 1
				let kind = 0
				for let (_, c) in elements(data, enc.start, enc.end) {
					if c.id == mkvEncodingScope {
						scope = uintOf(data, c)
					} else if c.id == mkvEncodingType {
						kind = uintOf(data, c)
					}
				}
				continue unless kind == 0
				for let (_, c) in elements(data, enc.start, enc.end) {
					continue unless c.id == mkvCompression
					let algo = 0
					let settings byte[]
					for let (_, f) in elements(data, c.start, c.end) {
						if f.id == mkvCompAlgo {
							algo = uintOf(data, f)
						} else if f.id == mkvCompSettings {
							settings = data[f.start:f.end].clone()
						}
					}
					if (scope & 1) != 0 {
						if algo == 3 {
							part.stripped = settings
						} else {
							part.compression = algo
						}
					}
					privateAlgo = algo when (scope & 2) != 0 && algo != 3
				}
			}
			return privateAlgo
		}

		// A stored frame with its compression undone.
		//
		// Fails when the frame does not decompress, or on LZO, which this
		// reader lacks.
		def frameOf(part MkvTrack, frame byte[]) !byte[] {
			let out = frame
			out = try inflate(out, part.compression) when part.compression >= 0
			out = part.stripped.concat(out) when part.stripped.len() > 0
			return out
		}

		// Notes where the Cues lie from the SeekHead.
		def readSeekHead(data byte[]) {
			for let (_, seek) in elements(data, 0, data.len()) {
				continue unless seek.id == mkvSeek
				let target = 0
				let position = -1
				for let (_, e) in elements(data, seek.start, seek.end) {
					if e.id == mkvSeekId {
						target = uintOf(data, e)
					} else if e.id == mkvSeekPosition {
						position = uintOf(data, e)
					}
				}
				cuesAt = segmentStart + position when target == mkvCues && position >= 0
			}
		}

		// Reads the cue points of the main video track, or of the first
		// track when there is no video.
		def readCues(data byte[]) {
			cuesRead = true
			let main = mainNumber()
			for let (_, point) in elements(data, 0, data.len()) {
				continue unless point.id == mkvCuePoint
				let time = -1
				for let (_, e) in elements(data, point.start, point.end) {
					if e.id == mkvCueTime {
						time = uintOf(data, e)
					} else if e.id == mkvCueTrackPosition {
						let track = -1
						let cluster = -1
						for let (_, f) in elements(data, e.start, e.end) {
							if f.id == mkvCueTrack {
								track = uintOf(data, f)
							} else if f.id == mkvCueCluster {
								cluster = uintOf(data, f)
							}
						}
						cues.push(CuePoint{time: duration(int64(time) * int64(scale)), cluster: segmentStart + cluster}) when track == main && cluster >= 0 && time >= 0
					}
				}
			}
		}

		// The track number of the main video track, else of the first track.
		def mainNumber() int {
			for let (_, p) in parts {
				return p.number when p.track.kind == TrackKind.Video
			}
			return parts.len() > 0 ?? (parts[0].number, -1)
		}

		// name implements Described.
		def name() string {
			return docType == "webm" ?? ("webm", "mkv")
		}

		// seekable implements Seekable.
		def seekable() bool {
			return src.seekable()
		}

		// tracks implements Container.
		def tracks() Track[] {
			return list
		}

		// next implements Container: the frames of each block in file
		// order, laced frames one by one.
		//
		// Fails when a block is damaged or the reader fails.
		def next() !?Packet {
			for {
				if readyAt < ready.len() {
					let p = ready[readyAt]
					readyAt++
					continue when dropping && p.pts < dropBefore
					return p
				}
				ready = Packet[]
				readyAt = 0
				return none unless try readBlock()
			}
			return none
		}

		// Reads elements until a block fills `ready`; false at the end of
		// the segment.
		//
		// Fails when an element is damaged or the reader fails.
		def readBlock() !bool {
			for {
				let at = src.position()
				return false when segmentEnd >= 0 && at >= segmentEnd
				inCluster = false when inCluster && clusterEnd >= 0 && at >= clusterEnd
				let id = try readId()
				return false when id < 0
				let size = try readSize()
				if id == mkvCluster {
					inCluster = true
					clusterEnd = size < 0 ?? (-1, src.position() + size)
					clusterTime = 0
					continue
				}
				if size < 0 {
					fail "mkv: element {id} of unknown size outside a cluster" unless id == mkvSegment
					continue
				}
				if id == mkvClusterTimestamp {
					clusterTime = be(try src.read(size), 0, size)
				} else if id == mkvSimpleBlock {
					// A file cut short ends in part of a block: what is
					// there is handed on, as MP4 samples are.
					let body = try src.peek(size)
					try src.skip(body.len())
					try splitBlock(body, 0, body.len(), -1, simple = true, referenced = false)
					return true when ready.len() > 0
				} else if id == mkvBlockGroup {
					let group = try src.peek(size)
					try src.skip(group.len())
					let block ?Element = none
					let length = -1
					let referenced = false
					for let (_, e) in elements(group, 0, group.len()) {
						if e.id == mkvBlock {
							block = e
						} else if e.id == mkvBlockDuration {
							length = uintOf(group, e)
						} else if e.id == mkvReferenceBlock {
							referenced = true
						}
					}
					if !(block is none) {
						let b Element = block
						try splitBlock(group, b.start, b.end, length, simple = false, referenced = referenced)
						return true when ready.len() > 0
					}
				} else if id == mkvCues && !cuesRead {
					let cues = try src.peek(size)
					try src.skip(cues.len())
					readCues(cues)
				} else {
					try src.skip(size)
				}
			}
			return false
		}

		// Splits the block in data[start:end] into its frames. `length` is
		// the BlockDuration in ticks, -1 when absent; a SimpleBlock marks its
		// keyframes in its flags, a Block is one when its group has no
		// ReferenceBlock.
		def splitBlock(data byte[], start int, end int, length int, simple bool, referenced bool) !none {
			return none when start >= end
			let n = vintLength(int(data[start]))
			return none when n == 0 || start + n + 3 > end
			let number = int(data[start]) & (0xFF >> n)
			for let i = 1; i < n; i++ {
				number = number << 8 | int(data[start + i])
			}
			let slot = byNumber.get(number)
			return none when slot is none
			let index int = slot
			let part = parts[index]
			let at = start + n
			let relative = be(data, at, 2)
			relative -= 0x10000 when relative >= 0x8000
			let flags = int(data[at + 2])
			at += 3
			let keyframe = simple ?? (flags & 0x80 != 0, !referenced)
			let sizes = lacing(data, at, end, (flags >> 1) & 3)
			return none when sizes.len() == 0
			let first = at
			at = end
			for let (_, s) in sizes {
				at -= s
			}
			// Laced frames a cut-short file lacks.
			return none when at < first
			let base = int64(clusterTime + relative) * int64(scale) - int64(part.codecDelay)
			let step = int64(part.defaultDuration)
			let total = length >= 0 ?? (int64(length) * int64(scale), step * int64(sizes.len()))
			let each = sizes.len() > 0 ?? (total / int64(sizes.len()), int64(0))
			for let (i, s) in sizes {
				let frame = try frameOf(part, data[at:at + s].clone())
				let pts = duration(base + each * int64(i))
				ready.push(newPacket(index, frame, pts, pts, duration(each), keyframe))
				at += s
			}
			return none
		}

		// The frame sizes of a block whose laced frames start at `at` and end
		// at `end`; one size for no lacing. Empty when the lacing is damaged.
		def lacing(data byte[], at int, end int, kind int) int[] {
			let sizes int[]
			if kind == 0 {
				sizes.push(end - at)
				return sizes
			}
			return sizes when at >= end
			let count = int(data[at]) + 1
			let pos = at + 1
			if kind == 1 {
				for let i = 0; i < count - 1; i++ {
					let size = 0
					for pos < end {
						let b = int(data[pos])
						pos++
						size += b
						break when b < 255
					}
					sizes.push(size)
				}
			} else if kind == 3 {
				let (first, firstLen) = readVint(data, pos, end)
				return int[] when firstLen == 0
				pos += firstLen
				let size = first
				sizes.push(size)
				for let i = 1; i < count - 1; i++ {
					let (v, vLen) = readVint(data, pos, end)
					return int[] when vLen == 0
					pos += vLen
					// Signed: the raw value less half its range.
					let bias = (1 << (7 * vLen - 1)) - 1
					size += v - bias
					sizes.push(size)
				}
			} else {
				let each = (end - pos) / count
				for let i = 0; i < count; i++ {
					sizes.push(each)
				}
				return sizes
			}
			let used = 0
			for let (_, s) in sizes {
				used += s
			}
			let last = end - pos - used
			return int[] when last < 0
			sizes.push(last)
			return sizes
		}

		// The value and length of the variable-size integer at `at`, (0, 0)
		// when there is none.
		def readVint(data byte[], at int, end int) (int, int) {
			return (0, 0) when at >= end
			let n = vintLength(int(data[at]))
			return (0, 0) when n == 0 || at + n > end
			let v = int(data[at]) & (0xFF >> n)
			for let i = 1; i < n; i++ {
				v = v << 8 | int(data[at + i])
			}
			return (v, n)
		}

		// seek implements Container: from the cue point, or else the scanned
		// keyframe, at or before `time`, dropping the packets that present
		// before it.
		//
		// Fails when the source cannot seek or the reader fails.
		def seek(time duration) !none {
			fail "mkv: the stream cannot seek" unless src.seekable()
			if !cuesRead && cuesAt >= 0 {
				let back = src.position()
				try src.seek(cuesAt)
				let id = try readId()
				let size = try readSize()
				readCues(try src.read(size)) when id == mkvCues && size > 0
				try src.seek(back)
			}
			if cues.len() == 0 {
				try scanKeyframes()
			}
			let pick = CuePoint{time: 0s, cluster: firstCluster}
			for let (_, c) in cues {
				break when c.time > time
				pick = c
			}
			try src.seek(pick.cluster)
			inCluster = false
			ready = Packet[]
			readyAt = 0
			dropBefore = pick.time
			dropping = pick.time > 0s
			return none
		}

		// Builds the cue points by reading every block header of the main
		// track, for files with no Cues.
		//
		// Fails when the reader does.
		def scanKeyframes() !none {
			cuesRead = true
			let main = mainNumber()
			try src.seek(firstCluster)
			let cluster = firstCluster
			let time = 0
			for {
				let at = src.position()
				break when segmentEnd >= 0 && at >= segmentEnd
				let id = try readId()
				break when id < 0
				let size = try readSize()
				if id == mkvCluster {
					cluster = at
					continue
				}
				break when size < 0
				if id == mkvClusterTimestamp {
					time = be(try src.read(size), 0, size)
				} else if id == mkvSimpleBlock || id == mkvBlockGroup {
					let head = try src.peek(size.min(16))
					try src.skip(size)
					let start = id == mkvBlockGroup ?? (3, 0)
					continue when start + 4 > head.len()
					if id == mkvBlockGroup {
						let first = elements(head, 0, head.len())
						continue when first.len() == 0 || first[0].id != mkvBlock
						start = first[0].start
					}
					let n = vintLength(int(head[start]))
					continue when n == 0 || start + n + 3 > head.len()
					let number = int(head[start]) & (0xFF >> n)
					for let i = 1; i < n; i++ {
						number = number << 8 | int(head[start + i])
					}
					continue unless number == main
					let relative = be(head, start + n, 2)
					relative -= 0x10000 when relative >= 0x8000
					let key = id == mkvSimpleBlock && int(head[start + n + 2]) & 0x80 != 0
					cues.push(CuePoint{time: duration(int64(time + relative) * int64(scale)), cluster: cluster}) when key
				} else {
					try src.skip(size)
				}
			}
			return none
		}

		// close implements io.Closer: closes the file.
		//
		// Fails when closing it does.
		def close() !none {
			return src.close()
		}
	}
}
