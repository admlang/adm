partial module std.formats.video {
	use (
		std.testing
		std.bytes
		std.data.encoding
		std.formats.video.demux::*
		std.formats.media.source::*
		std.formats.video.matroska::*
	)

	check "MKV" {
		@test()
		def TestMkvTracks() !none {
			let c = try new MKV().open(new bytes.Reader(tinyMkv()))
			let tracks = c.tracks()
			assert tracks.len() == 2
			assert tracks[0].kind == TrackKind.Video && tracks[0].codec == "h264"
			assert tracks[0].width == 64 && tracks[0].height == 48
			assert tracks[0].config.len() > 8 && tracks[0].config[0] == 1
			assert tracks[1].kind == TrackKind.Audio && tracks[1].codec == "aac"
			assert tracks[1].sampleRate == 8000 && tracks[1].channels == 1
			assert tracks[1].config.len() == 5
		}

		@test()
		def TestMkvPackets() !none {
			let c = try new MKV().open(new bytes.Reader(tinyMkv()))
			// Matroska stores times in milliseconds.
			try testing.expectEqual("", try comparePackets(c, tinyMkvPackets(), 1000))
		}

		@test()
		def TestMkvZlibFrames() !none {
			let plain = try new MKV().open(new bytes.Reader(tinyMkv()))
			let packed = try new MKV().open(new bytes.Reader(tinyMkvZlib()))
			assert packed.tracks()[0].config.equals(plain.tracks()[0].config)
			let n = 0
			for {
				let a = try plain.next()
				let b = try packed.next()
				assert (a is none) == (b is none)
				break when a is none || b is none
				let pa Packet = a
				let pb Packet = b
				assert pa.track == pb.track && pa.pts == pb.pts && pa.data.equals(pb.data)
				n++
			}
			assert n > 10
		}

		@test()
		def TestMkvTruncated() !none {
			// A file cut short inside its last block: the blocks before it
			// come whole, the last one as far as it goes.
			let whole = tinyMkv()
			let full = try new MKV().open(new bytes.Reader(whole))
			let cut = try new MKV().open(new bytes.Reader(whole[:whole.len() - 7]))
			let n = 0
			for {
				let b = try cut.next()
				break when b is none
				let pb Packet = b
				let a = try full.next()
				assert !(a is none)
				break when a is none
				let pa Packet = a
				assert pa.track == pb.track && pa.pts == pb.pts
				assert pb.data.len() <= pa.data.len() && pb.data.equals(pa.data[:pb.data.len()])
				n++
			}
			assert n > 10
		}

		@test()
		def TestWebmPackets() !none {
			let c = try new MKV().open(new bytes.Reader(tinyWebm()))
			let tracks = c.tracks()
			assert tracks.len() == 2
			assert tracks[0].codec == "vp8" && tracks[1].codec == "opus"
			assert tracks[1].config.len() == 19 && tracks[1].sampleRate == 48000
			try testing.expectEqual("", try comparePackets(c, tinyWebmPackets(), 1000))
		}

		@test()
		def TestMkvLacing() !none {
			let c = new MkvContainer(new Source(new bytes.Reader(byte[])))
			// Xiph: three frames of 300, 2 and the rest (5).
			let xiph = byte[2, 255, 45, 2]
			xiph.len(4 + 307)
			try testing.expectEqual("[300, 2, 5]", "{c.lacing(xiph, 0, xiph.len(), 1)}")
			// EBML: 800, then 800 - 50 as a signed difference, then the rest.
			let ebml = byte[2, 0x43, 0x20, 0x5F, 0xCD]
			ebml.len(5 + 800 + 750 + 10)
			try testing.expectEqual("[800, 750, 10]", "{c.lacing(ebml, 0, ebml.len(), 3)}")
			// Fixed: four frames of the same size.
			let fixed = byte[3]
			fixed.len(1 + 40)
			try testing.expectEqual("[10, 10, 10, 10]", "{c.lacing(fixed, 0, fixed.len(), 2)}")
			// No lacing: one frame of everything.
			try testing.expectEqual("[41]", "{c.lacing(fixed, 0, fixed.len(), 0)}")
		}

		@test()
		def TestXiphHeaders() !none {
			let laced = byte[2, 3, 1, 0xA, 0xB, 0xC, 0xD, 0xE, 0xF]
			let packed = xiphHeaders(laced)
			try testing.expectEqual("[0, 3, 10, 11, 12, 0, 1, 13, 0, 2, 14, 15]", "{packed}")
		}

		@test()
		def TestMkvSeek() !none {
			let c = try new MKV().open(new bytes.Reader(tinyMkv()))
			try c.seek(700ms)
			let p = try c.next()
			assert p is Packet && p.track == 0 && p.keyframe && p.data.len() == 1406
		}
	}

