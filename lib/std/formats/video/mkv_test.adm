	// ffprobe -show_packets of the fixture: track, size, pts in µs, keyframe.
	// tiny.mkv rewritten with zlib ContentEncoding on the video track, for
	// its frames and its CodecPrivate; SeekHead and Cues left out.
	internal def tinyMkvZlib() byte[] {
		return encoding.base64decode(
				"GkXfowEAAAAAAAAjQoaBAUL3gQFC8oEEQvOBCEKCiG1hdHJvc2thQoeBBEKFgQIYU4BnAQAAAAAAFSfsAQAAAAAAAFMAAAAAAAAA" +
