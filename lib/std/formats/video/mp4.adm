partial module std.formats.video {
	use (
		std.io
		std.formats.video.demux::*
		std.formats.media.source::*
		std.formats.video.isobmff::*
		std.formats.media.bmff::*
	)

	// MP4 is the ISO base media file format family: MP4, QuickTime MOV and
	// 3GP. It reads the sample tables of every track (edit lists, composition
	// offsets, sync samples, fragmented files) and returns the samples in
	// file order. `VideoInfo.container` is "mov" for QuickTime files, "3gp"
	// for 3GPP ones and "mp4" otherwise.
	@codec("MP4")
	type MP4 {
		mimeType string[] {
			def get() string[] {
				return string["video/mp4", "video/quicktime", "video/3gpp", "video/3gpp2"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".mp4", ".m4v", ".mov", ".qt", ".3gp", ".3g2"]
			}
		}

		// matchSignature reports whether the reader starts with an `ftyp`
		// box, or with a QuickTime `moov`, `mdat`, `free`, `skip` or `wide`
		// box.
		def matchSignature(r io.Reader) bool {
			let head byte[]
			head.len(8)
			let n = io.readFull(r, head) onerror recover 0
			return false when n != 8
			let kind = be(head, 4, 4)
			return kind := boxFtyp || boxMoov || boxMdat || boxFree || boxSkip || boxWide
		}

		// open reads the file's `moov` box and any movie fragments. A reader
		// that is neither a `bytes.Reader` nor an `os.File` is read into
		// memory first, since samples are found by offset.
		//
		// Fails when the file has no `moov` box, a box the tracks need is
		// damaged, or the reader fails.
		def open(reader io.Reader) !Container {
			let c = new Mp4Container(try randomSource(reader))
			try c.read()
			return c
		}
	}
}
