partial module std.formats.video {
	use (
		std.testing
		std.bytes
		std.data.encoding
	)

	check "MP4" {
		@test()
		def TestMp4CutShort() !none {
			let v = try open(try encoding.base64decode(cutMp4))
			let stream = try v.frames()
			let frames VideoFrame[]
			for {
				let got = try stream.next()
				break when got is none
				let f VideoFrame = got
				frames.push(f)
			}
			assert h264TestMatches(frames, cutMp4Md5)
		}

		@test()
		def TestMp4Tracks() !none {
			let c = try new MP4().open(new bytes.Reader(tinyMp4()))
			let tracks = c.tracks()
			assert tracks.len() == 2
			assert tracks[0].kind == TrackKind.Video && tracks[0].codec == "h264"
			assert tracks[0].width == 64 && tracks[0].height == 48
			assert tracks[0].frameRate.numerator == 5 && tracks[0].frameRate.denominator == 1
			assert tracks[0].config.len() > 8 && tracks[0].config[0] == 1
			assert tracks[1].kind == TrackKind.Audio && tracks[1].codec == "aac"
			assert tracks[1].sampleRate == 8000 && tracks[1].channels == 1
			assert tracks[1].config.len() == 5 && tracks[1].config[0] == 0x15 && tracks[1].config[1] == 0x88
			assert int64(tracks[0].length) == 1000000000
		}

		@test()
		def TestMp4Packets() !none {
			let c = try new MP4().open(new bytes.Reader(tinyMp4()))
			try testing.expectEqual("", try comparePackets(c, tinyMp4Packets()))
		}

		@test()
		def TestMp4Fragmented() !none {
			let c = try new MP4().open(new bytes.Reader(fragMp4()))
			assert c.tracks().len() == 2
			try testing.expectEqual("", try comparePackets(c, fragMp4Packets()))
		}

		@test()
		def TestMovPackets() !none {
			let c = try new MP4().open(new bytes.Reader(tinyMov()))
			try testing.expectEqual("", try comparePackets(c, tinyMovPackets()))
		}

		@test()
		def TestMp4Seek() !none {
			let c = try new MP4().open(new bytes.Reader(tinyMp4()))
			try c.seek(600ms)
			let p = try c.next()
			assert p is Packet && p.track == 0 && p.keyframe && p.data.len() == 1406
		}
	}

