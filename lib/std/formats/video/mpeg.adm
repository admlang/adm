partial module std.formats.video {
	use (
		std.io
		std.formats.video.demux::*
		std.formats.video.media.source::*
		std.formats.video.pes::*
	)

	// MPEG is the MPEG-1 and MPEG-2 program stream (`.mpg`, DVD `.vob`):
	// packs of PES packets. Each packet is one PES payload, which decoders
	// reassemble by start code; DVD private stream substreams (AC-3, DTS,
	// LPCM, subpictures) come without their substream header. Timestamps
	// count from the first one in the file. Seeking reads the packet
	// headers from the start.
	@codec("MPEG")
	type MPEG {
		mimeType string[] {
			def get() string[] {
				return string["video/mpeg", "video/mp2p", "video/dvd"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".mpg", ".mpeg", ".m2p", ".vob", ".mpe"]
			}
		}

		// matchSignature reports whether the reader starts with a pack
		// header.
		def matchSignature(r io.Reader) bool {
			let head byte[]
			head.len(4)
			let n = io.readFull(r, head) onerror recover 0
			return n == 4 && be(head, 0, 4) == 0x1BA
		}

		// open reads the start of the stream until it has seen each
		// stream's first packet.
		//
		// Fails when the stream holds no packet, or the reader fails.
		def open(reader io.Reader) !Container {
			let c = new PsContainer(new Source(reader))
			try c.read()
			return c
		}
	}
}
