partial module std.formats.video {
	use std.formats.video.mpeg2::*

	// Mpeg2 decodes MPEG-1 and MPEG-2 video (ISO/IEC 11172-2 and ISO/IEC
	// 13818-2 up to the 4:2:2 profile, 4:4:4 too): I, P and B pictures,
	// frame and field pictures with frame, field, 16x8 and dual prime
	// prediction, and the stream's own quantiser matrices. Packets may cut the elementary stream
	// anywhere, as MPEG program and transport streams do; pictures are
	// found by their start codes. A packet's `pts` is the time of the first
	// picture that starts in it; pictures without one follow the previous
	// picture by its frame period. D pictures are skipped.
	@decoder("mpeg2")
	@decoder("mpeg1")
	type Mpeg2 {
		internal decoder Mpeg2Decoder

		def new() {
			decoder = new Mpeg2Decoder()
		}

		// configure prepares for the track and decodes the sequence header
		// its `config` may hold. Does not fail.
		def configure(track Track) !none {
			decoder.reset()
			decoder.feed(track.config, 0s, false) when track.config.len() > 0
		}

		// decode adds the packet's bytes and returns the pictures completed,
		// in display order. Does not fail: damaged data decodes to damaged
		// pictures.
		def decode(packet Packet) !VideoFrame[] {
			return decoder.feed(packet.data, packet.pts, true)
		}

		// flush decodes the bytes still held and returns the last pictures.
		// Does not fail.
		def flush() !VideoFrame[] {
			return decoder.drain()
		}
	}
}
