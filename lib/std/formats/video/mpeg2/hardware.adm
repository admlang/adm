internal partial module std.formats.video.mpeg2 {
	use (
		std.formats.video::*
		std.formats.video.hardware::*
		std.formats.video.mpegvideo::*
	)

	// The picture description the runtime's adm_hwvideo.c reads, index by
	// index: the header, the four quantiser matrices in raster order, then
	// one record per slice.
	const m2HwKind = 0
	const m2HwWidthMbs = 1
	const m2HwHeightMbs = 2
	const m2HwSurface = 3
	const m2HwField = 4
	const m2HwBottom = 5
	const m2HwSecondField = 6
	const m2HwReference = 7
	const m2HwIntra = 8
	const m2HwWidth = 9
	const m2HwHeight = 10
	const m2HwForward = 11
	const m2HwBackward = 12
	const m2HwType = 13
	const m2HwFullPelForward = 14
	const m2HwFullPelBackward = 15
	const m2HwFCode = 16
	const m2HwDcPrecision = 20
	const m2HwStructure = 21
	const m2HwTopFirst = 22
	const m2HwFrameDct = 23
	const m2HwConcealment = 24
	const m2HwQScaleType = 25
	const m2HwIntraVlc = 26
	const m2HwAlternateScan = 27
	const m2HwRepeatFirst = 28
	const m2HwProgressive = 29
	const m2HwSlices = 30
	const m2HwMatrices = 32
	const m2HwSliceStart = 288
	const m2HwSliceSize = 8

	// Where the MPEG-1/MPEG-2 decoder's pictures go to the GPU: the
	// description of the field or frame being gathered and its slices,
	// each from its start code.
	type Mpeg2Hardware {
		gpu     HwDecoder
		desc    int[]
		data    byte[]
		dataLen int
		slices  int

		def new() {
			gpu = new HwDecoder()
			desc = int[]
			data = byte[]
		}

		// Starts the description of the field or frame `d` begins: `second`
		// for the second field of a frame.
		def describe(d Mpeg2Decoder, second bool) {
			desc.len(m2HwSliceStart)
			desc.fill(0)
			dataLen = 0
			slices = 0
			let o = desc
			let fieldPic = d.structure != framePicture
			o[m2HwKind] = d.mpeg2 ?? (hwCodecMpeg2, hwCodecMpeg1)
			o[m2HwWidthMbs] = d.mbWidth
			o[m2HwHeightMbs] = d.mbHeight
			o[m2HwSurface] = d.cur.surface
			o[m2HwField] = fieldPic ?? (1, 0)
			o[m2HwBottom] = d.structure == bottomField ?? (1, 0)
			o[m2HwSecondField] = second ?? (1, 0)
			o[m2HwReference] = d.picType != picB ?? (1, 0)
			o[m2HwIntra] = d.picType == picI ?? (1, 0)
			o[m2HwWidth] = d.width
			o[m2HwHeight] = d.height
			o[m2HwForward] = d.hasFwd ?? (d.fwd.surface, -1)
			o[m2HwBackward] = d.hasBwd ?? (d.bwd.surface, -1)
			o[m2HwType] = d.picType
			o[m2HwFullPelForward] = d.fullPel[0] ?? (1, 0)
			o[m2HwFullPelBackward] = d.fullPel[1] ?? (1, 0)
			for let i = 0; i < 4; i++ {
				o[m2HwFCode + i] = d.fCode[i]
			}
			o[m2HwDcPrecision] = d.dcPrecision
			o[m2HwStructure] = d.structure
			o[m2HwTopFirst] = d.topFirst ?? (1, 0)
			o[m2HwFrameDct] = d.frameDct ?? (1, 0)
			o[m2HwConcealment] = d.concealment ?? (1, 0)
			o[m2HwQScaleType] = d.qScaleType ?? (1, 0)
			o[m2HwIntraVlc] = d.intraVlc ?? (1, 0)
			o[m2HwAlternateScan] = d.alternateScan ?? (1, 0)
			o[m2HwRepeatFirst] = d.repeatFirst ?? (1, 0)
			o[m2HwProgressive] = d.progressiveFrame ?? (1, 0)
			for let i = 0; i < 64; i++ {
				o[m2HwMatrices + i] = d.intraMatrix[i]
				o[m2HwMatrices + 64 + i] = d.interMatrix[i]
				o[m2HwMatrices + 128 + i] = d.chromaIntra[i]
				o[m2HwMatrices + 192 + i] = d.chromaInter[i]
			}
		}

		// Adds the slice in `raw[start:end]`, from its start code: its first
		// macroblock begins `mbBits` bits after the start code, at column
		// `mbX` and row `mbY`.
		def add(raw byte[], start int, end int, mbBits int, mbX int, mbY int, qCode int, intraSlice bool) {
			let size = end - start
			data.len((data.len() * 2).max(dataLen + size + 4096)) when data.len() < dataLen + size
			raw[start:end].copy(data[dataLen:])
			let at = m2HwSliceStart + slices * m2HwSliceSize
			desc.len(at + m2HwSliceSize)
			let o = desc
			o[at] = dataLen
			o[at + 1] = size
			o[at + 2] = mbBits
			o[at + 3] = mbX
			o[at + 4] = mbY
			o[at + 5] = qCode
			o[at + 6] = intraSlice ?? (1, 0)
			o[at + 7] = 0
			dataLen += size
			slices++
		}

		// Hands the gathered field or frame to the GPU. Fails when the
		// driver refuses it.
		def submit() !none {
			return none when slices == 0
			desc[m2HwSlices] = slices
			slices = 0
			return gpu.decode(desc, data, dataLen)
		}
	}
}
