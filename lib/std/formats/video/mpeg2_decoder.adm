internal partial module std.formats.video.mpeg2 {
	use (
		std.formats.video::*
		std.formats.video.hardware::*
		std.formats.video.mpegvideo::*
	)

	// Picture coding types.
	const picI = 1
	const picP = 2
	const picB = 3

	// Picture structures.
	const topField = 1
	const bottomField = 2
	const framePicture = 3

	// Motion types, one numbering for frame and field pictures.
	const motionFrame = 0
	const motionField = 1
	const motionDualPrime = 2
	const motion16x8 = 3

	// A timestamp waiting for the first picture that starts at or after
	// `offset` in the pending bytes.
	struct Mpeg2Mark {
		offset int
		time   duration
	}

	// Decodes an MPEG-1 or MPEG-2 video elementary stream (ISO/IEC 11172-2,
	// ISO/IEC 13818-2 in 4:2:0, 4:2:2 or 4:4:4) fed in pieces cut anywhere, and hands out
	// the pictures in display order.
	type Mpeg2Decoder {
		t    Mpeg2Tables
		bits MpegBits
		edge MpegEdge

		// Bytes not yet decoded: `pending[0:pendingLen]`.
		pending    byte[]
		pendingLen int
		// Where the search for the next start code resumes.
		scanAt     int
		marks      Mpeg2Mark[]
		lastMark   duration
		markedAny  bool

		// Sequence.
		haveSequence   bool
		mpeg2          bool
		width          int
		height         int
		mbWidth        int
		mbHeight       int
		rateNum        int
		rateDen        int
		progressiveSeq bool
		// chroma_format: 1 for 4:2:0, 2 for 4:2:2, 3 for 4:4:4; blocks per
		// macroblock follow from it (6, 8 or 12).
		chromaFormat   int
		lowDelay       bool
		matrix         int
		intraMatrix    int[]
		interMatrix    int[]
		chromaIntra    int[]
		chromaInter    int[]

		// Picture header and coding extension.
		picType          int
		fullPel          bool[]
		// [direction * 2 + component]
		fCode            int[]
		dcPrecision      int
		structure        int
		topFirst         bool
		frameDct         bool
		concealment      bool
		qScaleType       bool
		intraVlc         bool
		alternateScan    bool
		repeatFirst      bool
		progressiveFrame bool
		closedGop        bool
		headerTime       duration
		headerTimed      bool

		// Pictures.
		cur         MpegPicture
		fwd         MpegPicture
		bwd         MpegPicture
		held        MpegPicture
		hasCur      bool
		hasFwd      bool
		hasBwd      bool
		hasHeld     bool
		// Whether the picture has decoded slices, and whether it is the first
		// field of a frame whose second field is still to come.
		started     bool
		firstField  bool
		skipPicture bool
		curType     int
		out         VideoFrame[]
		nextTime    duration

		// Slice and macroblock state.
		qscale      int
		dcPred      int[]
		// Motion vector predictors [(r * 2 + s) * 2 + t].
		pmv         int[]
		// Vectors of the macroblock [(s * 4 + i) * 2 + t].
		mv          int[]
		// [s * 2 + r]
		fieldSelect int[]
		mbFlags     int
		motionType  int
		fieldDct    bool
		block       int[]
		scan        int[]

		// The GPU decoding, when it takes the stream.
		hw          Mpeg2Hardware
		// Set after the GPU gave up mid-stream: pictures wait for the next
		// I picture, as the references were on the GPU.
		waitIntra   bool
		// The track's size, for saying before the first picture whether
		// the GPU would decode it.
		trackWidth  int
		trackHeight int

		def new() {
			t = new Mpeg2Tables()
			bits = new MpegBits()
			edge = new MpegEdge()
			pending.len(1 << 16)
			intraMatrix.len(64)
			interMatrix.len(64)
			chromaIntra.len(64)
			chromaInter.len(64)
			fullPel.len(2)
			fCode.len(4)
			dcPred.len(3)
			pmv.len(8)
			mv.len(16)
			fieldSelect.len(4)
			block.len(64)
			scan = mpegZigzag
			matrix = 601
			cur = new MpegPicture(16, 16)
			fwd = cur
			bwd = cur
			held = cur
			structure = framePicture
			hw = new Mpeg2Hardware()
			defaultMatrices()
		}

		def defaultMatrices() {
			for let i = 0; i < 64; i++ {
				intraMatrix[i] = mpegDefaultIntraMatrix[i]
				chromaIntra[i] = mpegDefaultIntraMatrix[i]
				interMatrix[i] = 16
				chromaInter[i] = 16
			}
		}

		// Forgets the stream, as before its first byte.
		def reset() {
			pendingLen = 0
			scanAt = 0
			marks.len(0)
			markedAny = false
			nextTime = 0s
			hasCur = false
			hasFwd = false
			hasBwd = false
			hasHeld = false
			started = false
			firstField = false
			out.len(0)
		}

		// Adds `data`, whose first picture starts at `time`, and returns the
		// pictures completed in display order.
		def feed(data byte[], time duration, timed bool) VideoFrame[] {
			if pending.len() < pendingLen + data.len() {
				let grown byte[]
				grown.len((pending.len() * 2).max(pendingLen + data.len() + 1024))
				pending[0:pendingLen].copy(grown)
				pending = grown
			}
			// A packet repeating the last timestamp carries none of its own.
			if timed && (!markedAny || time != lastMark) {
				marks.push(Mpeg2Mark{offset: pendingLen, time: time})
				lastMark = time
				markedAny = true
			}
			data.copy(pending[pendingLen:pendingLen + data.len()])
			pendingLen += data.len()
			run(false)
			return take()
		}

		// Decodes what is left and returns the pictures still held.
		def drain() VideoFrame[] {
			run(true)
			completePicture()
			if hasHeld {
				emit(held, false)
				hasHeld = false
			}
			return take()
		}

		def take() VideoFrame[] {
			let frames = out
			out = VideoFrame[]
			return frames
		}

		// Decodes every whole unit between start codes; with `last`, also the
		// one running to the end of the bytes.
		def run(last bool) {
			let start = mpegNextStartCode(pending, 0, pendingLen)
			if start < 0 {
				// Keep the last bytes, which may begin a start code.
				dropBefore((pendingLen - 3).max(0)) unless last
				pendingLen = 0 when last
				return
			}
			start = start - 3
			for {
				let next = mpegNextStartCode(pending, (start + 4).max(scanAt), pendingLen)
				if next < 0 {
					scanAt = (pendingLen - 3).max(0)
					if last {
						unit(start, pendingLen)
						start = pendingLen
					}
					break
				}
				unit(start, next - 3)
				start = next - 3
			}
			dropBefore(start)
		}

		// Discards the bytes before `at`.
		def dropBefore(at int) {
			return when at <= 0
			pending[at:pendingLen].copy(pending) when pendingLen > at
			pendingLen -= at
			scanAt = (scanAt - at).max(0)
			let kept Mpeg2Mark[]
			for let (_, m) in marks {
				kept.push(Mpeg2Mark{offset: (m.offset - at).max(0), time: m.time})
			}
			// Marks now at 0 stand for data already consumed but the last.
			let merged Mpeg2Mark[]
			for let i = 0; i < kept.len(); i++ {
				continue when kept[i].offset == 0 && i + 1 < kept.len() && kept[i + 1].offset == 0
				merged.push(kept[i])
			}
			marks = merged
		}

		// Decodes the unit whose start code prefix is at `at`, up to `end`.
		def unit(at int, end int) {
			let code = int(pending[at + 3])
			bits.reset(pending, at + 4, end)
			if code >= 0x01 && code <= 0xAF {
				slice(code, at, end)
			} else if code == 0x00 {
				completeField()
				pictureHeader(at)
			} else if code == 0xB3 {
				completePicture()
				sequenceHeader()
			} else if code == 0xB5 {
				extension()
			} else if code == 0xB8 {
				completePicture()
				bits.skip(25)
				closedGop = bits.flag()
			} else if code == 0xB7 {
				completePicture()
			}
		}

		def sequenceHeader() {
			width = bits.read(12)
			height = bits.read(12)
			bits.skip(4)
			let rate = bits.read(4)
			if rate >= 1 && rate <= 8 {
				rateNum = mpeg2FrameRates[rate * 2]
				rateDen = mpeg2FrameRates[rate * 2 + 1]
			} else {
				rateNum = 25
				rateDen = 1
			}
			bits.skip(18 + 1 + 10 + 1)
			defaultMatrices()
			if bits.flag() {
				loadMatrix(intraMatrix, true)
				for let i = 0; i < 64; i++ {
					chromaIntra[i] = intraMatrix[i]
				}
			}
			if bits.flag() {
				loadMatrix(interMatrix, false)
				for let i = 0; i < 64; i++ {
					chromaInter[i] = interMatrix[i]
				}
			}
			mpeg2 = false
			progressiveSeq = true
			chromaFormat = 1
			haveSequence = true
			resize()
		}

		// Reads 64 quantiser matrix values in zigzag order into `m`.
		def loadMatrix(m int[], intra bool) {
			for let i = 0; i < 64; i++ {
				let v = bits.read(8)
				// A zero weight is invalid; the DC weight of an intra matrix is 8.
				v = 1 when v == 0
				v = 8 when intra && i == 0
				m[mpegZigzag[i]] = v
			}
		}

		// Sizes the macroblock grid after a sequence header or extension.
		def resize() {
			mbWidth = (width + 15) >> 4
			if mpeg2 && !progressiveSeq {
				mbHeight = ((height + 31) >> 5) * 2
			} else {
				mbHeight = (height + 15) >> 4
			}
		}

		def extension() {
			let id = bits.read(4)
			if id == 1 {
				// Sequence extension.
				bits.skip(8)
				progressiveSeq = bits.flag()
				chromaFormat = bits.read(2)
				// 0 is reserved.
				chromaFormat = 1 when chromaFormat == 0
				width = width | (bits.read(2) << 12)
				height = height | (bits.read(2) << 12)
				bits.skip(12 + 1 + 8)
				lowDelay = bits.flag()
				let n = bits.read(2)
				let d = bits.read(5)
				rateNum = rateNum * (n + 1)
				rateDen = rateDen * (d + 1)
				mpeg2 = true
				resize()
			} else if id == 2 {
				// Sequence display extension.
				bits.skip(3)
				if bits.flag() {
					bits.skip(16)
					let coefficients = bits.read(8)
					matrix = coefficients == 1 ?? (709, 601)
				}
			} else if id == 3 {
				// Quantiser matrix extension.
				if bits.flag() {
					loadMatrix(intraMatrix, true)
					for let i = 0; i < 64; i++ {
						chromaIntra[i] = intraMatrix[i]
					}
				}
				if bits.flag() {
					loadMatrix(interMatrix, false)
					for let i = 0; i < 64; i++ {
						chromaInter[i] = interMatrix[i]
					}
				}
				loadMatrix(chromaIntra, true) when bits.flag()
				loadMatrix(chromaInter, false) when bits.flag()
			} else if id == 8 {
				// Picture coding extension.
				for let i = 0; i < 4; i++ {
					fCode[i] = bits.read(4)
				}
				dcPrecision = bits.read(2)
				structure = bits.read(2)
				structure = framePicture when structure == 0
				topFirst = bits.flag()
				frameDct = bits.flag()
				concealment = bits.flag()
				qScaleType = bits.flag()
				intraVlc = bits.flag()
				alternateScan = bits.flag()
				repeatFirst = bits.flag()
				bits.skip(1)
				progressiveFrame = bits.flag()
				scan = alternateScan ?? (mpegAlternateVertical, mpegZigzag)
			}
		}

		def pictureHeader(at int) {
			bits.skip(10)
			picType = bits.read(3)
			bits.skip(16)
			fullPel[0] = false
			fullPel[1] = false
			if picType == picP || picType == picB {
				fullPel[0] = bits.flag()
				fCode[0] = bits.read(3)
				fCode[1] = fCode[0]
			}
			if picType == picB {
				fullPel[1] = bits.flag()
				fCode[2] = bits.read(3)
				fCode[3] = fCode[2]
			}
			// MPEG-1 values; a picture coding extension overrides them.
			dcPrecision = 0
			structure = framePicture
			topFirst = true
			frameDct = true
			concealment = false
			qScaleType = false
			intraVlc = false
			alternateScan = false
			repeatFirst = false
			progressiveFrame = true
			scan = mpegZigzag
			// The timestamp of the last packet that began at or before this
			// picture; it is used up.
			headerTimed = false
			let kept Mpeg2Mark[]
			for let (_, m) in marks {
				if m.offset <= at {
					headerTime = m.time
					headerTimed = true
				} else {
					kept.push(m)
				}
			}
			marks = kept
		}

		// Sets up the picture the next slice belongs to.
		def beginPicture() {
			started = true
			skipPicture = false
			let second = structure != framePicture && firstField && hasCur
			if second {
				firstField = false
				curType = picType
				if picType != picI && !hasFwd {
					fwd = grey()
					hasFwd = true
				}
				hw.describe(self, true) when cur.surface >= 0 && hw.gpu.active()
				return
			}
			firstField = structure != framePicture
			if hasBwd && (bwd.stride != mbWidth * 16 || bwd.lines != mbHeight * 16 || bwd.chromaFormat != chromaFormat) {
				// Pictures of another size cannot be references.
				emit(held, false) when hasHeld
				hasHeld = false
				hasFwd = false
				hasBwd = false
			}
			curType = picType
			// D pictures and invalid types are not decoded.
			skipPicture = picType < picI || picType > picB
			skipPicture = true when waitIntra && picType != picI
			waitIntra = false when !skipPicture
			// A GPU session opens only where no reference decoded before is
			// needed.
			hwConfigure() when !skipPicture && !hasBwd && picType == picI
			if picType == picB {
				skipPicture = true when !hasFwd && !closedGop
			} else if hasBwd {
				fwd = bwd
				hasFwd = true
			}
			let onGpu = hw.gpu.active() && !skipPicture
			let p = new MpegPicture(mbWidth * 16, mbHeight * 16, chromaFormat, !onGpu)
			if onGpu {
				let busy int[]
				busy.push(fwd.surface) when hasFwd
				busy.push(bwd.surface) when hasBwd
				busy.push(held.surface) when hasHeld
				p.surface = hw.gpu.freeSurface(busy)
				if p.surface < 0 {
					hwAbandon("mpeg2: every GPU picture buffer is in use")
					skipPicture = true
				}
			}
			p.width = width
			p.height = height
			p.keyframe = picType == picI
			p.timed = headerTimed
			p.time = headerTime
			p.length = framePeriod()
			cur = p
			hasCur = true
			if picType != picB {
				bwd = p
				hasBwd = true
			}
			if picType != picI && !hasFwd {
				fwd = grey()
				hasFwd = true
			}
			hw.describe(self, false) when p.surface >= 0
		}

		// Opens a GPU session for the stream's pictures unless one fits;
		// the stream decodes in software when no GPU takes it.
		def hwConfigure() {
			let codec = mpeg2 ?? (hwCodecMpeg2, hwCodecMpeg1)
			let w = mbWidth * 16
			let h = mbHeight * 16
			return when hw.gpu.fits(codec, w, h) || hw.gpu.disabled
			hw.gpu.close()
			if chromaFormat != 1 {
				hw.gpu.why = "the stream is not 4:2:0"
				return
			}
			// The pictures in flight: two references, the picture held for
			// display and the one decoding.
			hw.gpu.open(codec, 0, w, h, 4)
		}

		// Gives up the GPU after `reason`: the stream goes on in software
		// from its next I picture, and the pictures the GPU held are not
		// shown.
		def hwAbandon(reason string) {
			hw.gpu.abandon(reason)
			hasFwd = false
			hasBwd = false
			hasHeld = false
			waitIntra = true
		}

		// Hands the field or frame gathered for the GPU over.
		def hwSubmit() {
			return unless hw.gpu.active() && hw.slices > 0
			hw.submit() onerror (err error) {
				hwAbandon("{err}")
				recover none
			}
		}

		// What the GPU does with the pictures: see `Mpeg2.hardware`.
		def hardware() VideoHardware {
			let codec = mpeg2 ?? (hwCodecMpeg2, hwCodecMpeg1)
			let open = hw.gpu.session
			return VideoHardware{decoding: true, encoding: false, name: hwName(open.backend), device: open.device, reason: ""} unless open is none
			return VideoHardware{decoding: false, encoding: false, name: "", device: "", reason: hw.gpu.why} when hw.gpu.disabled || hasBwd
			// Nothing decoded yet: what the sequence header or the track
			// promises.
			let w = haveSequence ?? (mbWidth * 16, (trackWidth + 15) & ~15)
			let h = haveSequence ?? (mbHeight * 16, (trackHeight + 15) & ~15)
			return VideoHardware{decoding: false, encoding: false, name: "", device: "", reason: "the stream is not 4:2:0"} when haveSequence && chromaFormat != 1
			let choice = hwProbe(haveSequence ?? (codec, hwCodecMpeg2), 0, 1, 8, w, h)
			return VideoHardware{decoding: false, encoding: false, name: "", device: "", reason: hwLastError()} when choice is none
			return VideoHardware{decoding: true, encoding: false, name: choice.name, device: choice.device, reason: ""}
		}

		// A mid-grey picture standing in for a missing reference.
		def grey() MpegPicture {
			let g = new MpegPicture(mbWidth * 16, mbHeight * 16, chromaFormat)
			g.width = width
			g.height = height
			for let i = 0; i < g.y.len(); i++ {
				g.y[i] = 128
			}
			for let i = 0; i < g.u.len(); i++ {
				g.u[i] = 128
				g.v[i] = 128
			}
			return g
		}

		// How long one frame shows, three fields' time when the picture
		// repeats one.
		def framePeriod() duration {
			let base = int64(1000000000) * int64(rateDen) / int64(rateNum.max(1))
			return duration(base) unless repeatFirst
			return duration(base * (topFirst ?? (3, 2))) when progressiveSeq
			return duration(base * 3 / 2)
		}

		// Ends the field just decoded: a first field waits for its pair.
		def completeField() {
			return unless started
			started = false
			hwSubmit()
			return when firstField
			finishFrame()
		}

		// Ends the picture being decoded, even a lone field.
		def completePicture() {
			return unless started
			started = false
			hwSubmit()
			finishFrame()
		}

		def finishFrame() {
			firstField = false
			return unless hasCur
			hasCur = false
			return when skipPicture
			if curType == picB {
				emit(cur, false)
				return
			}
			emit(held, true) when hasHeld
			held = cur
			hasHeld = true
		}

		// Hands out `p`, its planes copied when `copy` since it is still a
		// reference.
		def emit(p MpegPicture, copy bool) {
			p.time = nextTime unless p.timed
			nextTime = p.time + p.length
			if p.surface < 0 {
				out.push(p.frame(matrix, copy))
				return
			}
			// Decoded on the GPU: the planes come back cropped to even
			// sizes, or the frame keeps the picture there.
			return unless hw.gpu.active()
			let w = (p.width + 1) & ~1
			let h = (p.height + 1) & ~1
			let frame = p.frame(matrix, false)
			frame.yStride = w
			frame.uvStride = w >> 1
			if hw.gpu.gpuOutput {
				let kept = hw.gpu.keep(p.surface, 0, 0, w, h)
				return when kept is none
				frame.gpu = new GpuPicture(kept)
				frame.onGpu = true
			} else {
				let planes = hw.gpu.download(p.surface, 0, 0, w, h) onerror (err error) {
					hwAbandon("{err}")
					return
				}
				let (y, u, v) = planes
				frame.y = y
				frame.u = u
				frame.v = v
			}
			out.push(frame)
		}

		// Decodes one slice of the current picture, `pending[at:end]` from its
		// start code.
		def slice(code int, at int, end int) {
			return unless haveSequence
			beginPicture() unless started
			return when skipPicture
			let fieldPic = structure != framePicture
			let rows = fieldPic ?? (mbHeight >> 1, mbHeight)
			let mbY = code - 1
			mbY += bits.read(3) << 7 when height > 2800
			return when mbY >= rows
			let qCode = bits.read(5)
			qscale = quantiserScale(qCode)
			let intraSlice = bits.flag()
			if intraSlice {
				bits.skip(8)
				for bits.flag() {
					bits.skip(8)
				}
			}
			if cur.surface >= 0 {
				// The GPU decodes the macroblocks; the first one's column comes
				// from its address increment.
				let mbBits = bits.pos - at * 8
				let inc = readIncrement()
				return when inc <= 0 || inc > mbWidth
				hw.add(pending, at, end, mbBits, inc - 1, mbY, qCode, intraSlice)
				return
			}
			for let i = 0; i < 3; i++ {
				dcPred[i] = 128 << dcPrecision
			}
			for let i = 0; i < 8; i++ {
				pmv[i] = 0
			}
			let inc = readIncrement()
			return when inc <= 0
			let mbX = inc - 1
			for {
				return when mbX >= mbWidth || mbY >= rows
				return unless macroblock(mbX, mbY)
				// A start code (23 zero bits) or the end ends the slice.
				break when bits.peek(23) == 0
				inc = readIncrement()
				return when inc <= 0
				for let k = 1; k < inc; k++ {
					mbX++
					if mbX >= mbWidth {
						mbX = 0
						mbY++
					}
					return when mbY >= rows
					skipped(mbX, mbY)
				}
				mbX++
				if mbX >= mbWidth {
					mbX = 0
					mbY++
				}
			}
		}

		// The next macroblock_address_increment, escapes added up and stuffing
		// skipped; 0 when the data is invalid.
		def readIncrement() int {
			let total = 0
			for {
				let v = bits.vlc(t.increment)
				return 0 when v < 0
				if v == 34 {
					total += 33
				} else if v != 35 {
					return total + v
				}
			}
			return 0
		}

		def quantiserScale(code int) int {
			return mpeg2NonLinearScale[code] when mpeg2 && qScaleType
			return code << 1
		}

		// A skipped macroblock: a P picture copies the co-located pixels, a B
		// picture repeats the previous macroblock's prediction.
		def skipped(mbX int, mbY int) {
			for let i = 0; i < 3; i++ {
				dcPred[i] = 128 << dcPrecision
			}
			if curType == picP {
				mbFlags = mbForward
				for let i = 0; i < 8; i++ {
					pmv[i] = 0
				}
				for let i = 0; i < 16; i++ {
					mv[i] = 0
				}
				if structure == framePicture {
					motionType = motionFrame
				} else {
					motionType = motionField
					fieldSelect[0] = structure - 1
				}
			} else {
				// The previous macroblock's directions with the predictors as
				// vectors, frame prediction in a frame picture and the same
				// parity in a field picture.
				motionType = structure == framePicture ?? (motionFrame, motionField)
				for let s = 0; s < 2; s++ {
					mv[s * 8] = pmv[s * 4]
					mv[s * 8 + 1] = pmv[s * 4 + 1]
					fieldSelect[s * 2] = structure - 1 when structure != framePicture
				}
			}
			predict(mbX, mbY)
		}

		// Decodes one coded macroblock. Returns false on invalid data.
		def macroblock(mbX int, mbY int) bool {
			let table = curType == picI ?? (t.typeI, (curType == picP ?? (t.typeP, t.typeB)))
			let flags = bits.vlc(table)
			return false when flags < 0
			let fieldPic = structure != framePicture
			let moving = (flags & (mbForward | mbBackward)) != 0
			motionType = fieldPic ?? (motionField, motionFrame)
			if moving && mpeg2 {
				if !fieldPic {
					if !frameDct {
						let m = bits.read(2)
						return false when m == 0
						motionType = m == 1 ?? (motionField, (m == 2 ?? (motionFrame, motionDualPrime)))
					}
				} else {
					let m = bits.read(2)
					return false when m == 0
					motionType = m == 1 ?? (motionField, (m == 2 ?? (motion16x8, motionDualPrime)))
				}
			}
			fieldDct = false
			fieldDct = bits.flag() when mpeg2 && !fieldPic && !frameDct && (flags & (mbIntra | mbPattern)) != 0
			qscale = quantiserScale(bits.read(5)) when (flags & mbQuant) != 0
			if (flags & mbIntra) != 0 {
				if concealment && mpeg2 {
					motionType = fieldPic ?? (motionField, motionFrame)
					readVectors(0)
					bits.skip(1)
				} else {
					for let i = 0; i < 8; i++ {
						pmv[i] = 0
					}
				}
				mbFlags = flags
				intraBlocks(mbX, mbY)
				return true
			}
			for let i = 0; i < 3; i++ {
				dcPred[i] = 128 << dcPrecision
			}
			if curType == picP && (flags & mbForward) == 0 {
				// No motion compensation: a zero vector from the same parity.
				for let i = 0; i < 8; i++ {
					pmv[i] = 0
				}
				for let i = 0; i < 16; i++ {
					mv[i] = 0
				}
				flags = flags | mbForward
				fieldSelect[0] = structure - 1 when fieldPic
			} else {
				readVectors(0) when (flags & mbForward) != 0
				readVectors(1) when (flags & mbBackward) != 0
			}
			mbFlags = flags
			let cbp = 0
			if (flags & mbPattern) != 0 {
				cbp = bits.vlc(t.pattern)
				return false when cbp < 0
				// coded_block_pattern_1/2: the extra chroma blocks.
				let extra = blockCount() - 6
				cbp = (cbp << extra) | bits.read(extra) when extra > 0
			}
			predict(mbX, mbY)
			return interBlocks(mbX, mbY, cbp)
		}

		// One motion vector component: `pred` plus the coded difference,
		// wrapped into the range of `fCode`.
		def vector(s int, c int, pred int) int {
			let code = bits.vlc(t.motion)
			return pred when code == 0 || code < -16
			let rsize = fCode[s * 2 + c] - 1
			let delta = code
			if rsize > 0 {
				let mag = code < 0 ?? (0 - code, code)
				delta = ((mag - 1) << rsize) + bits.read(rsize) + 1
				delta = 0 - delta when code < 0
			}
			let v = pred + delta
			let shift = 5 + rsize.max(0)
			let range = 1 << shift
			v = ((v + (range >> 1)) & (range - 1)) - (range >> 1)
			return v
		}

		// Reads the vectors of direction `s` for the macroblock's motion type.
		def readVectors(s int) {
			let fieldPic = structure != framePicture
			let base = s * 8
			if motionType == motionFrame {
				let x = vector(s, 0, pmv[s * 4])
				let y = vector(s, 1, pmv[s * 4 + 1])
				pmv[s * 4] = x
				pmv[s * 4 + 1] = y
				pmv[s * 4 + 2] = x
				pmv[s * 4 + 3] = y
				if fullPel[s] && !mpeg2 {
					x = x * 2
					y = y * 2
				}
				mv[base] = x
				mv[base + 1] = y
			} else if motionType == motionField && !fieldPic {
				for let r = 0; r < 2; r++ {
					fieldSelect[s * 2 + r] = bits.bit()
					let p = s * 4 + r * 2
					let x = vector(s, 0, pmv[p])
					let y = vector(s, 1, pmv[p + 1] >> 1)
					pmv[p] = x
					pmv[p + 1] = y * 2
					mv[base + r * 2] = x
					mv[base + r * 2 + 1] = y
				}
			} else if motionType == motionField {
				fieldSelect[s * 2] = bits.bit()
				let x = vector(s, 0, pmv[s * 4])
				let y = vector(s, 1, pmv[s * 4 + 1])
				pmv[s * 4] = x
				pmv[s * 4 + 1] = y
				pmv[s * 4 + 2] = x
				pmv[s * 4 + 3] = y
				mv[base] = x
				mv[base + 1] = y
			} else if motionType == motion16x8 {
				for let r = 0; r < 2; r++ {
					fieldSelect[s * 2 + r] = bits.bit()
					let p = s * 4 + r * 2
					let x = vector(s, 0, pmv[p])
					let y = vector(s, 1, pmv[p + 1])
					pmv[p] = x
					pmv[p + 1] = y
					mv[base + r * 2] = x
					mv[base + r * 2 + 1] = y
				}
			} else {
				// Dual prime.
				let shift = fieldPic ?? (0, 1)
				let x = vector(s, 0, pmv[s * 4])
				let dx = bits.vlc(t.dualPrime)
				let y = vector(s, 1, pmv[s * 4 + 1] >> shift)
				let dy = bits.vlc(t.dualPrime)
				pmv[s * 4] = x
				pmv[s * 4 + 2] = x
				pmv[s * 4 + 1] = y << shift
				pmv[s * 4 + 3] = y << shift
				mv[base] = x
				mv[base + 1] = y
				mv[base + 2] = x
				mv[base + 3] = y
				let px = x > 0 ?? (1, 0)
				let py = y > 0 ?? (1, 0)
				if !fieldPic {
					let m = topFirst ?? (1, 3)
					mv[base + 4] = ((x * m + px) >> 1) + dx
					mv[base + 5] = ((y * m + py) >> 1) + dy - 1
					m = 4 - m
					mv[base + 6] = ((x * m + px) >> 1) + dx
					mv[base + 7] = ((y * m + py) >> 1) + dy + 1
				} else {
					mv[base + 4] = ((x + px) >> 1) + dx
					mv[base + 5] = ((y + py) >> 1) + dy + (structure == topField ?? (-1, 1))
				}
			}
		}

		// Forms the prediction of an inter macroblock in the current picture.
		def predict(mbX int, mbY int) {
			let first = true
			if (mbFlags & mbForward) != 0 {
				predict(fwd, 0, mbX, mbY, false)
				first = false
			}
			predict(bwd, 1, mbX, mbY, !first) when (mbFlags & mbBackward) != 0
		}

		// The prediction of direction `s` from `ref`, averaged into what is
		// there when `avg`.
		def predict(ref MpegPicture, s int, mbX int, mbY int, avg bool) {
			let base = s * 8
			if structure == framePicture {
				if motionType == motionFrame {
					block16(ref, 0, 1, cur, 0, 1, mbX * 16, mbY * 16, mv[base], mv[base + 1], 16, avg)
				} else if motionType == motionField {
					for let f = 0; f < 2; f++ {
						block16(ref, fieldSelect[s * 2 + f], 2, cur, f, 2, mbX * 16, mbY * 8, mv[base + f * 2], mv[base + f * 2 + 1], 8, avg)
					}
				} else {
					// Dual prime: same parity, then the opposite averaged in.
					for let f = 0; f < 2; f++ {
						block16(ref, f, 2, cur, f, 2, mbX * 16, mbY * 8, mv[base], mv[base + 1], 8, avg)
					}
					block16(ref, 1, 2, cur, 0, 2, mbX * 16, mbY * 8, mv[base + 4], mv[base + 5], 8, true)
					block16(ref, 0, 2, cur, 1, 2, mbX * 16, mbY * 8, mv[base + 6], mv[base + 7], 8, true)
				}
				return
			}
			let parity = structure - 1
			if motionType == motionField {
				let sel = fieldSelect[s * 2]
				block16(fieldRef(ref, sel), sel, 2, cur, parity, 2, mbX * 16, mbY * 16, mv[base], mv[base + 1], 16, avg)
			} else if motionType == motion16x8 {
				for let r = 0; r < 2; r++ {
					let sel = fieldSelect[s * 2 + r]
					block16(fieldRef(ref, sel), sel, 2, cur, parity, 2, mbX * 16, mbY * 16 + r * 8, mv[base + r * 2], mv[base + r * 2 + 1], 8, avg)
				}
			} else {
				block16(ref, parity, 2, cur, parity, 2, mbX * 16, mbY * 16, mv[base], mv[base + 1], 16, avg)
				block16(fieldRef(ref, 1 - parity), 1 - parity, 2, cur, parity, 2, mbX * 16, mbY * 16, mv[base + 4], mv[base + 5], 16, true)
			}
		}

		// The reference holding field `sel` for a field picture: the current
		// frame's first field when a P picture's second field refers to it.
		def fieldRef(ref MpegPicture, sel int) MpegPicture {
			return cur when curType != picB && !firstField && sel != structure - 1
			return ref
		}

		// Predicts a 16-wide luma block of `h` lines and its chroma into `dst`
		// at luma (`x`, `y`) of the field or frame chosen by `dLine`/`dStep`,
		// from the field or frame `sLine`/`sStep` of `ref` moved by (`mx`, `my`)
		// half pixels.
		def block16(ref MpegPicture, sLine int, sStep int, dst MpegPicture, dLine int, dStep int, x int, y int, mx int, my int, h int, avg bool) {
			let ls = dst.stride
			let lh = ref.lines / sStep
			mpegPredict(dst.y, (y * dStep + dLine) * ls + x, ls * dStep, ref.y, sLine * ls, ls * sStep, ls, lh, x + (mx >> 1), y + (my >> 1), ((my & 1) << 1) | (mx & 1), 16, h, avg, 0, edge)
			// Chroma subsampling shifts; vectors halve only along a
			// subsampled axis.
			let hx = chromaFormat == 3 ?? (0, 1)
			let hy = chromaFormat == 1 ?? (1, 0)
			let cx = hx == 1 ?? (mx / 2, mx)
			let cy = hy == 1 ?? (my / 2, my)
			let cs = dst.cstride
			let ch = ref.clines / sStep
			let cdxy = ((cy & 1) << 1) | (cx & 1)
			let sx = (x >> hx) + (cx >> 1)
			let sy = (y >> hy) + (cy >> 1)
			let dAt = ((y >> hy) * dStep + dLine) * cs + (x >> hx)
			mpegPredict(dst.u, dAt, cs * dStep, ref.u, sLine * cs, cs * sStep, cs, ch, sx, sy, cdxy, 16 >> hx, h >> hy, avg, 0, edge)
			mpegPredict(dst.v, dAt, cs * dStep, ref.v, sLine * cs, cs * sStep, cs, ch, sx, sy, cdxy, 16 >> hx, h >> hy, avg, 0, edge)
		}

		// Blocks per macroblock: four luma, then Cb and Cr alternating.
		def blockCount() int {
			return chromaFormat == 1 ?? (6, chromaFormat == 2 ?? (8, 12))
		}

		// Where block `i` of the macroblock goes: plane offset and line
		// stride, in the current picture. Chroma blocks come in Cb/Cr pairs,
		// down the left column first, then the right one (4:4:4).
		def blockDest(i int, mbX int, mbY int) int {
			let fieldPic = structure != framePicture
			if i < 4 || chromaFormat != 1 {
				let luma = i < 4
				let ls = luma ?? (cur.stride, cur.cstride)
				let k = luma ?? (i, ((i - 4) >> 1))
				// 8x8 block column and row inside the macroblock.
				let bx = luma ?? (k & 1, k >> 1)
				let by = luma ?? (k >> 1, k & 1)
				let x = mbX * ((luma || chromaFormat == 3) ?? (16, 8)) + bx * 8
				return ((mbY * 16 + by * 8) * 2 + structure - 1) * ls + x when fieldPic
				return (mbY * 16 + by) * ls + x when fieldDct
				return (mbY * 16 + by * 8) * ls + x
			}
			let cs = cur.cstride
			return (mbY * 16 + structure - 1) * cs + mbX * 8 when fieldPic
			return mbY * 8 * cs + mbX * 8
		}

		def blockStride(i int) int {
			let fieldPic = structure != framePicture
			let s = i < 4 ?? (cur.stride, cur.cstride)
			// Field DCT covers chroma too once it is 16 lines tall.
			return s * 2 when fieldPic || (fieldDct && (i < 4 || chromaFormat != 1))
			return s
		}

		def intraBlocks(mbX int, mbY int) {
			let n = blockCount()
			for let i = 0; i < n; i++ {
				let c = i < 4 ?? (0, 1 + ((i - 4) & 1))
				intraBlock(c)
				let plane = c == 0 ?? (cur.y, (c == 1 ?? (cur.u, cur.v)))
				idctPut(block, plane, blockDest(i, mbX, mbY), blockStride(i), false)
				clearBlock()
			}
		}

		def interBlocks(mbX int, mbY int, cbp int) bool {
			let n = blockCount()
			for let i = 0; i < n; i++ {
				continue when (cbp & (1 << (n - 1 - i))) == 0
				let c = i < 4 ?? (0, 1 + ((i - 4) & 1))
				return false unless interBlock(c)
				let plane = c == 0 ?? (cur.y, (c == 1 ?? (cur.u, cur.v)))
				idctPut(block, plane, blockDest(i, mbX, mbY), blockStride(i), true)
				clearBlock()
			}
			return true
		}

		def clearBlock() {
			for let i = 0; i < 64; i++ {
				block[i] = 0
			}
		}

		// Decodes and dequantises the intra block of component `c` into
		// `block`.
		def intraBlock(c int) bool {
			let size = bits.vlc(c == 0 ?? (t.dcLuma, t.dcChroma))
			let diff = 0
			if size > 0 {
				diff = bits.read(size)
				diff = diff - (1 << size) + 1 when diff < 1 << (size - 1)
			}
			dcPred[c] += diff
			let m = c == 0 ?? (intraMatrix, chromaIntra)
			let parity = 0
			if mpeg2 {
				block[0] = dcPred[c] << (3 - dcPrecision)
			} else {
				block[0] = dcPred[c] * 8
			}
			parity = block[0] & 1
			let table = mpeg2 && intraVlc ?? (t.dct1, t.dct0)
			let i = 0
			for {
				let sym = bits.vlc(table)
				break when sym == dctEnd
				let run = 0
				let level = 0
				let negative = false
				if sym == dctEscape {
					run = bits.read(6)
					level = escapeLevel()
					negative = level < 0
					level = 0 - level when negative
				} else if sym < 0 {
					return false
				} else {
					run = sym >> 8
					level = sym & 255
					negative = bits.bit() == 1
				}
				i += run + 1
				return false when i > 63
				let j = scan[i]
				level = (level * qscale * m[j]) >> 4
				level = (level - 1) | 1 unless mpeg2
				level = 0 - level when negative
				block[j] = level
				parity = parity ^ (level & 1)
			}
			block[63] = block[63] ^ 1 when mpeg2 && parity == 0
			return true
		}

		// Decodes and dequantises a non-intra block of component `c`.
		def interBlock(c int) bool {
			let m = c == 0 ?? (interMatrix, chromaInter)
			let parity = 0
			let i = -1
			let first = true
			for {
				let run = 0
				let level = 0
				let negative = false
				if first && bits.peek(1) == 1 {
					bits.skip(1)
					level = 1
					negative = bits.bit() == 1
				} else {
					let sym = bits.vlc(t.dct0)
					break when sym == dctEnd
					if sym == dctEscape {
						run = bits.read(6)
						level = escapeLevel()
						negative = level < 0
						level = 0 - level when negative
					} else if sym < 0 {
						return false
					} else {
						run = sym >> 8
						level = sym & 255
						negative = bits.bit() == 1
					}
				}
				first = false
				i += run + 1
				return false when i > 63
				let j = scan[i]
				level = ((level * 2 + 1) * qscale * m[j]) >> 5
				level = (level - 1) | 1 unless mpeg2
				level = 0 - level when negative
				block[j] = level
				parity = parity ^ (level & 1)
			}
			block[63] = block[63] ^ 1 when mpeg2 && parity == 0
			return true
		}

		// The signed level after an escape's run.
		def escapeLevel() int {
			return bits.signed(12) when mpeg2
			let level = bits.signed(8)
			if level == -128 {
				level = bits.read(8) - 256
			} else if level == 0 {
				level = bits.read(8)
			}
			return level
		}
	}
}
