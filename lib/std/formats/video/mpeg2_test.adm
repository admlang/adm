		internal const yuv422Hashes = string[
			"139113BED21E9DBD826EDE5CC2CA68DB",
			"C25BFCD377F31AC60F547FC359EE875E",
			"C25BFCD377F31AC60F547FC359EE875E",
			"2C6760731CDB13BD323906401736C0B9",
			"5E765BAD10BA2ADD26B2FC21659382EC",
			"5E765BAD10BA2ADD26B2FC21659382EC",
			"4DE80F82FCFC17EA87416B3DA095517F",
			"FAD73214F65FCB8159EB13B600FDC2DD"
		]

		internal def fixture(text string) byte[] {
			return encoding.base64decode(text) onerror recover byte[]
		}

		// The MD5 of the frame's visible planes, Y then U then V, as
		// `ffmpeg -f framemd5` computes it.
		internal def planeHash(f VideoFrame) string {
			let w = int(f.width)
			let h = int(f.height)
			let cw = f.chroma == ChromaLayout.Yuv444 ?? (w, (w + 1) / 2)
			let ch = f.chroma == ChromaLayout.Yuv420 ?? ((h + 1) / 2, h)
			let m = new hash.MD5()
			for let r = 0; r < h; r++ {
				m.write(f.y[r * f.yStride:r * f.yStride + w])
			}
			for let r = 0; r < ch; r++ {
				m.write(f.u[r * f.uvStride:r * f.uvStride + cw])
			}
			for let r = 0; r < ch; r++ {
				m.write(f.v[r * f.uvStride:r * f.uvStride + cw])
			}
			return m.hash().hex()
		}

		// Every frame of the stream fed in packets of `size` bytes, each
		// stamped `step` after the one before. The software decoder always
		// decodes them: a GPU's inverse DCT may round differently from the
		// reference hashes.
		internal def decodeAll(data byte[], size int, step duration = 0s) !VideoFrame[] {
			let dec = new Mpeg2Decoder()
			dec.hw.gpu.disabled = true
			let frames VideoFrame[]
			let at = 0
			let n = 0
			for at < data.len() {
				let end = (at + size).min(data.len())
				frames = frames + dec.feed(data[at:end], duration(int64(step) * int64(n)), true)
				at = end
				n++
			}
			return frames + dec.drain()
		}

		// Every frame of the stream in one packet, on the GPU where
		// ADM_VIDEO_HW and the machine allow, its pictures kept there when
		// `onGpu` and then downloaded; with what the GPU did.
		internal def decodeOnGpu(data byte[], onGpu bool = false) !(VideoFrame[], VideoHardware) {
			let dec = new Mpeg2Decoder()
			dec.hw.gpu.gpuOutput = onGpu
			let frames = dec.feed(data, 0s, true) + dec.drain()
			for let f in frames {
				assert f.onGpu == (onGpu && dec.hardware().decoding)
				try download(f)
			}
			return (frames, dec.hardware())
		}

		// Whether two decodes of a stream agree within what inverse DCTs may
		// differ by: the same frames, each at least 40 dB PSNR apart.
		internal def close(a VideoFrame[], b VideoFrame[]) bool {
			return false when a.len() != b.len()
			for let i = 0; i < a.len(); i++ {
				let x = a[i]
				let y = b[i]
				return false when x.width != y.width || x.height != y.height
				let w = int(x.width)
				let h = int(x.height)
				let cw = (w + 1) / 2
				let ch = (h + 1) / 2
				let sum = 0
				for let r = 0; r < h; r++ {
					for let c = 0; c < w; c++ {
						let d = int(x.y[r * x.yStride + c]) - int(y.y[r * y.yStride + c])
						sum += d * d
					}
				}
				for let r = 0; r < ch; r++ {
					for let c = 0; c < cw; c++ {
						let du = int(x.u[r * x.uvStride + c]) - int(y.u[r * y.uvStride + c])
						let dv = int(x.v[r * x.uvStride + c]) - int(y.v[r * y.uvStride + c])
						sum += du * du + dv * dv
					}
				}
				// 40 dB: a mean squared error of at most 255² / 10⁴.
				return false when sum * 10000 > 65025 * (w * h + 2 * cw * ch)
			}
			return true
		}

		internal def matches(frames VideoFrame[], hashes string[]) bool {
			return false when frames.len() != hashes.len()
			for let i = 0; i < frames.len(); i++ {
				return false when planeHash(frames[i]) != hashes[i]
			}
			return true
		}

		@test()
		def TestGpuPicturesMatchSoftware() !none {
			// With NVDEC or VA-API the 4:2:0 fixtures decode on the GPU (MPEG-1
			// on NVDEC only); without, every run is software. The field picture
			// fixture is left out: NVIDIA's decoder (ffmpeg's NVDEC path too)
			// gets its second fields wrong below the first macroblock row.
			let streams = string[mpeg2Fixture, mpeg1Fixture, interlacedFixture, dualPrimeFixture, oddFixture]
			for let i = 0; i < streams.len(); i++ {
				let soft = try decodeAll(fixture(streams[i]), 1 << 20)
				let (gpu, hw) = try decodeOnGpu(fixture(streams[i]))
				assert close(soft, gpu)
				if hw.decoding {
					assert hw.name := "NVDEC" || "VA-API"
					assert hw.reason == ""
				} else {
					assert hw.reason != ""
				}
				let (kept, _) = try decodeOnGpu(fixture(streams[i]), hw.decoding)
				assert close(soft, kept)
			}
		}

		@test()
		def TestGpuLeaves422ToSoftware() !none {
			let (frames, hw) = try decodeOnGpu(fixture(yuv422Fixture))
			assert matches(frames, yuv422Hashes)
			assert !hw.decoding && hw.reason == "the stream is not 4:2:0"
		}

		@test()
		def TestMpeg2MatchesReference() !none {
			let frames = try decodeAll(fixture(mpeg2Fixture), 1 << 20)
			assert matches(frames, mpeg2Hashes)
			assert frames[0].width == 64 && frames[0].height == 48
			assert frames[0].keyframe && !frames[1].keyframe && frames[6].keyframe
			assert frames[0].matrix == 601
			// One packet at 0: the pictures follow at the frame period, 25 Hz.
			assert frames[0].time == 0s && frames[3].time == 120ms && frames[7].time == 280ms
			assert frames[5].length == 40ms
		}

		@test()
		def TestMpeg1MatchesReference() !none {
			let frames = try decodeAll(fixture(mpeg1Fixture), 1 << 20)
			assert matches(frames, mpeg1Hashes)
		}

		@test()
		def TestInterlacedToolsMatchReference() !none {
			let frames = try decodeAll(fixture(interlacedFixture), 1 << 20)
			assert matches(frames, interlacedHashes)
			assert frames[0].matrix == 709
		}

		@test()
		def TestFieldPicturesMatchReference() !none {
			let frames = try decodeAll(fixture(fieldPictureFixture), 1 << 20)
			assert matches(frames, fieldPictureHashes)
			assert frames[0].keyframe
		}

		@test()
		def TestDualPrimeMatchesReference() !none {
			let frames = try decodeAll(fixture(dualPrimeFixture), 1 << 20)
			assert matches(frames, dualPrimeHashes)
		}

		@test()
		def TestYuv422MatchesReference() !none {
			let frames = try decodeAll(fixture(yuv422Fixture), 1 << 20)
			assert matches(frames, yuv422Hashes)
			assert frames[0].chroma == ChromaLayout.Yuv422 && frames[0].uvStride == 32
		}

		@test()
		def TestElementaryStream() !none {
			let v = try open(fixture(mpeg2Fixture))
			assert v.info().container == "es" && v.info().codec == "mpeg2" && v.info().width == 64
			let stream = try v.frames()
			let frames VideoFrame[]
			for {
				let got = try stream.next()
				break when got is none
				let f VideoFrame = got
				frames.push(f)
			}
			// The GPU may decode them: its inverse DCT may round differently.
			let soft = try decodeAll(fixture(mpeg2Fixture), 1 << 20)
			assert matches(soft, mpeg2Hashes) && close(frames, soft)
			// Seeking reads from the start to the keyframe before 200 ms and
			// decodes forward to it.
			try v.seek(200ms)
			let got = try stream.next()
			fail "no picture after the seek" when got is none
			let f VideoFrame = got
			assert f.time == 200ms && close([f], [soft[5]])
		}

		@test()
		def TestPartialMacroblocksMatchReference() !none {
			let frames = try decodeAll(fixture(oddFixture), 1 << 20)
			assert matches(frames, oddHashes)
			assert frames[0].width == 70 && frames[0].height == 50
		}

		@test()
		def TestPacketsCutAnywhere() !none {
			let data = fixture(mpeg2Fixture)
			for let (_, size) in int[1, 7, 100, 1000] {
				let frames = try decodeAll(data, size)
				assert matches(frames, mpeg2Hashes)
			}
		}

		@test()
		def TestPacketTimesGoToTheirPictures() !none {
			// Packets of 1000 bytes: the sequence and first picture start in the
			// first one, and the pictures starting in later packets take their
			// stamps.
			let frames = try decodeAll(fixture(mpeg2Fixture), 1000, 1s)
			assert matches(frames, mpeg2Hashes)
			assert frames[0].time == 0s
			let stamped = 0
			for let (_, f) in frames {
				stamped++ when f.time.seconds() >= 1.0 && f.time.seconds() == float(int(f.time.seconds()))
			}
			assert stamped >= 3
		}

		@test()
		def TestGarbageDecodesToNothing() !none {
			let noise byte[]
			for let i = 0; i < 5000; i++ {
				noise.push(byte((i * 7919 + 13) & 255))
			}
			let frames = try decodeAll(noise, 512)
			assert frames.len() == 0
			// A stream cut in the middle of a picture still yields the pictures
			// before the cut and the damaged one.
			let data = fixture(mpeg2Fixture)
			let cut = try decodeAll(data[0:data.len() / 2], 300)
			assert cut.len() > 0
		}
	}
}
