partial module std.formats.video {
	use std.formats.video.mpeg4::*

	// Mpeg4Part2 decodes MPEG-4 Visual (ISO/IEC 14496-2) Simple and Advanced
	// Simple profile video, the codec of Xvid and DivX files: I, P, B and
	// S-VOPs (global motion compensation), H.263 and MPEG quantisation, AC/DC
	// prediction, four vectors per macroblock, quarter-pel motion, interlaced
	// field DCT and field prediction, video packets, data partitioning and
	// VOPs that are not coded. Each packet holds whole VOPs, several in DivX
	// packed B-frames; the pictures come out in display order, timed by the
	// VOP time stamps from the first packet's `pts` on. Streams from the Xvid
	// encoder are reconstructed with the IDCT it used. Static sprites,
	// reversible VLCs and scalable layers are not decoded.
	@decoder("mpeg4")
	type Mpeg4Part2 {
		internal decoder Mpeg4Decoder

		def new() {
			decoder = new Mpeg4Decoder()
		}

		// configure prepares for the track and reads the VOL header its
		// `config` may hold. Does not fail.
		def configure(track Track) !none {
			decoder.reset()
			decoder.feed(track.config, 0s) when track.config.len() > 0
		}

		// decode decodes the VOPs of the packet and returns the pictures
		// completed, in display order. Fails on a Studio profile stream;
		// damaged data decodes to damaged pictures.
		def decode(packet Packet) !VideoFrame[] {
			let frames = decoder.feed(packet.data, packet.pts)
			fail "mpeg4: Studio profile streams are not supported" when decoder.studio
			return frames
		}

		// flush returns the last picture held back for B-VOPs. Does not fail.
		def flush() !VideoFrame[] {
			return decoder.drain()
		}
	}
}
