internal partial module std.formats.video.mpeg4 {
	use (
		std.formats.video::*
		std.formats.video.mpegvideo::*
	)

	// VOP coding types.
	const vopI = 0
	const vopP = 1
	const vopB = 2
	const vopS = 3

	// Macroblock kinds kept for the B-VOPs after a reference VOP: how their
	// direct mode reads the co-located vectors.
	const kindInter = 0
	const kind4mv = 1
	const kindIntra = 2
	const kindField = 3
	// Only while reading a data partitioned packet.
	const kindSkip = 4

	// Decodes an MPEG-4 Visual (ISO/IEC 14496-2) Simple and Advanced Simple
	// profile elementary stream packet by packet and hands out the pictures in
	// display order.
	type Mpeg4Decoder {
		t    Mpeg4Tables
		bits MpegBits
		edge MpegEdge
		qpel Mpeg4Qpel

		// Video object layer.
		haveVol        bool
		width          int
		height         int
		mbWidth        int
		mbHeight       int
		mbCount        int
		// The plane size motion compensation repeats the edge pixels of.
		edgeWidth      int
		edgeHeight     int
		resolution     int
		timeBits       int
		fixedIncrement int
		interlaced     bool
		spriteUsage    int
		warpPoints     int
		warpAccuracy   int
		warp           Mpeg4Warp
		// Whether this VOP is an S-VOP with global motion compensation, and
		// whether the macroblock uses it.
		sprite         bool
		mcsel          bool
		// The trajectory of the S-VOP's warp points [point * 2 + component].
		trajectory     int[]
		quantBits      int
		mpegQuant      bool
		intraMatrix    int[]
		interMatrix    int[]
		quarterSample  bool
		partitioned    bool
		reversible     bool
		lowDelay       bool
		cplxI          int
		cplxP          int
		cplxB          int
		// The Microsoft variant decoded instead: 2 for MS-MPEG4v2, 0 for
		// MPEG-4 itself.
		msVersion      int
		// MS-MPEG4v2: macroblock rows per slice, whether P pictures code
		// skipped macroblocks.
		sliceHeight    int
		skipCode       bool
		// Encoders recognised by their user data, -1 when not seen.
		xvidBuild      int
		// A Studio profile stream, which this decoder does not read.
		studio         bool
		// Colour signalling of the visual object header.
		matrix         int       = 601
		fullRange      bool
		divxVersion    int
		lavcBuild      int

		// VOP header.
		vopType       int
		noRounding    int
		dcThreshold   int
		alternateScan bool
		qscale        int
		fCode         int
		bCode         int
		yDcScale      int
		cDcScale      int
		scan          int[]

		// Times in units of 1 / `resolution`.
		timeBase     int
		lastTimeBase int
		vopTime      int64
		lastNonBTime int64
		ppTime       int64
		pbTime       int64
		// Packet time minus stream time of the first VOP, once known.
		timeOffset   duration
		haveOffset   bool
		// When the last picture made ends, and the time of the last I or P
		// picture: a clock restarted by a new video object layer shows as a
		// reference picture no later than the one before.
		shownEnd     duration
		refTime      duration
		haveRef      bool

		// Pictures: the older and newer reference, the one decoding, the
		// reference still to be shown.
		cur     MpegPicture
		fwd     MpegPicture
		bwd     MpegPicture
		held    MpegPicture
		hasFwd  bool
		hasBwd  bool
		hasHeld bool
		out     VideoFrame[]

		// Per 8x8 luma block of the newest reference: its vector, for
		// prediction and direct mode [(row * wrap + col) * 2 + component].
		motion     int[]
		wrap       int
		// Per macroblock of the newest reference: its kind and whether it was
		// skipped.
		kinds      int[]
		skips      bool[]
		// Intra prediction: DC and AC values per block (luma on the 8x8 grid,
		// chroma per macroblock), the quantiser and intra flag per macroblock.
		dcLuma     int[]
		dcU        int[]
		dcV        int[]
		acLuma     int[]
		acU        int[]
		acV        int[]
		cwrap      int
		qscales    int[]
		intraTable bool[]

		// Macroblock state.
		mbX         int
		mbY         int
		resyncX     int
		resyncY     int
		firstLine   bool
		intra       bool
		acPred      bool
		useDcVlc    bool
		fourMv      bool
		skipped     bool
		direct      bool
		// Prediction directions: 1 forward, 2 backward.
		dirs        int
		// Vectors [(direction * 4 + block) * 2 + component].
		mv          int[]
		// B-VOP vector predictors [(direction * 2 + field) * 2 + component].
		lastMv      int[]
		// Interlaced tools: field DCT and field prediction of the macroblock,
		// the source field of each [direction * 2 + field].
		topFirst    bool
		fieldDct    bool
		fieldMv     bool
		fieldSel    int[]
		// The field vectors and source fields of the newest reference's field
		// predicted macroblocks, [macroblock * 4 + field * 2 + component] and
		// [macroblock * 2 + field].
		fieldMvs    int[]
		fieldSels   int[]
		// What the first partitions of a data partitioned video packet say of
		// each macroblock: its kind, pattern (with bit 3 the quantiser change
		// until the second partition), AC prediction flag, DC prediction
		// directions (bit 5 - block set when from above) and global motion
		// flag.
		partKind    int[]
		partCbp     int[]
		partAcPred  bool[]
		partDirs    int[]
		partMcsel   bool[]
		// Field distances of direct mode in field units.
		frameUnit   int64
		ppFieldTime int64
		pbFieldTime int64
		cbp         int
		blocks      int[]
		lastIndex   int[]
		dcDir       int

		def new() {
			t = new Mpeg4Tables()
			bits = new MpegBits()
			edge = new MpegEdge()
			qpel = new Mpeg4Qpel()
			warp = new Mpeg4Warp()
			trajectory.len(8)
			intraMatrix.len(64)
			interMatrix.len(64)
			mv.len(16)
			lastMv.len(8)
			fieldSel.len(4)
			blocks.len(6 * 64)
			lastIndex.len(6)
			xvidBuild = -1
			divxVersion = -1
			lavcBuild = -1
			scan = mpegZigzag
			cur = new MpegPicture(16, 16)
			fwd = cur
			bwd = cur
			held = cur
		}

		// Forgets the pictures, as before the first packet; the stream headers
		// are kept.
		def reset() {
			hasFwd = false
			hasBwd = false
			hasHeld = false
			haveOffset = false
			haveRef = false
			shownEnd = 0s
			out.len(0)
		}

		// Decodes the headers and VOPs in `data`, a packet starting at `time`,
		// and returns the pictures completed in display order.
		def feed(data byte[], time duration) VideoFrame[] {
			if msVersion != 0 {
				msPicture(data, time) when data.len() > 0
				return take()
			}
			let at = mpegNextStartCode(data, 0, data.len())
			for at >= 0 {
				let next = mpegNextStartCode(data, at + 1, data.len())
				let end = next < 0 ?? (data.len(), next - 3)
				unit(data, at, end, time)
				at = next
			}
			return take()
		}

		// The pictures still held back.
		def drain() VideoFrame[] {
			if hasHeld {
				emit(held, false)
				hasHeld = false
			}
			return take()
		}

		def take() VideoFrame[] {
			let frames = out
			out = VideoFrame[]
			return frames
		}

		// Decodes the unit whose start code value is at `at`.
		def unit(data byte[], at int, end int, time duration) {
			let code = int(data[at])
			bits.reset(data, at + 1, end)
			if code >= 0x20 && code <= 0x2F {
				volHeader()
			} else if code == 0xB5 {
				visualObject()
			} else if code == 0xB2 {
				userData(data, at + 1, end)
			} else if code == 0xB3 {
				// Group of VOPs: the time code sets the seconds base.
				let hours = bits.read(5)
				let minutes = bits.read(6)
				bits.skip(1)
				let seconds = bits.read(6)
				timeBase = hours * 3600 + minutes * 60 + seconds
			} else if code == 0xB6 && haveVol {
				vop(time)
			}
		}

		// Reads the colour signalling of a visual object header: its range
		// and matrix.
		def visualObject() {
			if bits.flag() {
				bits.skip(4 + 3)
			}
			let kind = bits.read(4)
			return unless kind := 1 || 2
			return unless bits.flag()
			bits.skip(3)
			fullRange = bits.flag()
			if bits.flag() {
				bits.skip(8 + 8)
				matrix = bits.read(8) == 1 ?? (709, 601)
			}
		}

		def userData(data byte[], from int, end int) {
			let text = string(data[from:end.min(from + 64)])
			if text.startsWith("XviD") {
				xvidBuild = mpeg4Number(text, 4)
			} else if text.startsWith("DivX") {
				divxVersion = mpeg4Number(text, 4)
			} else if text.startsWith("Lavc") {
				lavcBuild = mpeg4Number(text, 4)
			}
		}

		def volHeader() {
			bits.skip(1)
			let objectType = bits.read(8)
			if objectType := 14 || 15 {
				// Simple and Core Studio: another syntax altogether.
				studio = true
				return
			}
			let verId = 1
			if bits.flag() {
				verId = bits.read(4)
				bits.skip(3)
			}
			bits.skip(16) when bits.read(4) == 15
			lowDelay = false
			if bits.flag() {
				bits.skip(2)
				lowDelay = bits.flag()
				bits.skip(15 + 1 + 15 + 1 + 15 + 1 + 3 + 11 + 1 + 15 + 1) when bits.flag()
			}
			let shape = bits.read(2)
			bits.skip(1)
			resolution = bits.read(16).max(1)
			timeBits = 1
			for (1 << timeBits) < resolution {
				timeBits++
			}
			bits.skip(1)
			fixedIncrement = 0
			fixedIncrement = bits.read(timeBits) when bits.flag()
			return when shape != 0
			bits.skip(1)
			width = bits.read(13)
			bits.skip(1)
			height = bits.read(13)
			bits.skip(1)
			interlaced = bits.flag()
			bits.skip(1)
			spriteUsage = verId == 1 ?? (bits.read(1), bits.read(2))
			if spriteUsage := 1 || 2 {
				bits.skip(13 + 1 + 13 + 1 + 13 + 1 + 13 + 1) when spriteUsage == 1
				warpPoints = bits.read(6)
				warpAccuracy = bits.read(2)
				bits.skip(1)
				bits.skip(1) when spriteUsage == 1
			}
			quantBits = 5
			if bits.flag() {
				quantBits = bits.read(4)
				bits.skip(4)
			}
			mpegQuant = bits.flag()
			for let i = 0; i < 64; i++ {
				intraMatrix[i] = mpeg4DefaultIntraMatrix[i]
				interMatrix[i] = mpeg4DefaultInterMatrix[i]
			}
			if mpegQuant {
				loadMatrix(intraMatrix) when bits.flag()
				loadMatrix(interMatrix) when bits.flag()
			}
			quarterSample = verId != 1 && bits.flag()
			complexity()
			bits.skip(1)
			partitioned = bits.flag()
			reversible = partitioned && bits.flag()
			if verId != 1 {
				bits.skip(2) when bits.flag()
				bits.skip(1)
			}
			setup()
		}

		// Sizes the macroblock grid and the prediction tables for the picture
		// size.
		def setup() {
			if hasBwd && (bwd.stride != ((width + 15) >> 4) * 16 || bwd.lines != ((height + 15) >> 4) * 16) {
				// Pictures of another size cannot be references.
				emit(held, false) when hasHeld
				hasHeld = false
				hasFwd = false
				hasBwd = false
			}
			mbWidth = (width + 15) >> 4
			mbHeight = (height + 15) >> 4
			mbCount = mbWidth * mbHeight
			edgeWidth = mbWidth * 16
			edgeHeight = mbHeight * 16
			wrap = mbWidth * 2 + 1
			cwrap = mbWidth + 1
			motion.len(((mbHeight * 2 + 2) * wrap + 2) * 2)
			motion.fill(0)
			kinds.len(mbCount)
			kinds.fill(0)
			skips.len(mbCount)
			skips.fill(false)
			dcLuma.len((mbHeight * 2 + 2) * wrap + 2)
			dcU.len((mbHeight + 2) * cwrap + 2)
			dcV.len((mbHeight + 2) * cwrap + 2)
			for let i = 0; i < dcLuma.len(); i++ {
				dcLuma[i] = 1024
			}
			for let i = 0; i < dcU.len(); i++ {
				dcU[i] = 1024
				dcV[i] = 1024
			}
			acLuma.len(dcLuma.len() * 16)
			acLuma.fill(0)
			acU.len(dcU.len() * 16)
			acU.fill(0)
			acV.len(dcV.len() * 16)
			acV.fill(0)
			qscales.len(mbCount)
			intraTable.len(mbCount)
			intraTable.fill(false)
			partKind.len(mbCount)
			partCbp.len(mbCount)
			partAcPred.len(mbCount)
			partDirs.len(mbCount)
			partMcsel.len(mbCount)
			fieldMvs.len(mbCount * 4)
			fieldMvs.fill(0)
			fieldSels.len(mbCount * 2)
			fieldSels.fill(0)
			frameUnit = 0
			haveVol = true
		}

		// Reads a quantiser matrix in zigzag order; a zero ends it early and
		// the last value repeats.
		def loadMatrix(m int[]) {
			let last = 0
			let i = 0
			for i < 64 {
				let v = bits.read(8)
				break when v == 0
				last = v
				m[mpegZigzag[i]] = v
				i++
			}
			for i < 64 {
				m[mpegZigzag[i]] = last
				i++
			}
		}

		// The complexity estimation header: how many bits each VOP header
		// then carries for it.
		def complexity() {
			cplxI = 0
			cplxP = 0
			cplxB = 0
			return when bits.flag()
			let method = bits.read(2)
			return when method >= 2
			if !bits.flag() {
				for let k = 0; k < 6; k++ {
					cplxI += 8 * bits.bit()
				}
			}
			if !bits.flag() {
				cplxI += 8 * bits.bit()
				cplxP += 8 * bits.bit()
				cplxP += 8 * bits.bit()
				cplxI += 8 * bits.bit()
			}
			bits.skip(1)
			if !bits.flag() {
				cplxI += 8 * bits.bit()
				cplxI += 8 * bits.bit()
				cplxI += 8 * bits.bit()
				cplxI += 4 * bits.bit()
			}
			if !bits.flag() {
				cplxP += 8 * bits.bit()
				cplxP += 8 * bits.bit()
				cplxB += 8 * bits.bit()
				cplxP += 8 * bits.bit()
				cplxP += 8 * bits.bit()
				cplxP += 8 * bits.bit()
			}
			bits.skip(1)
			if method == 1 {
				cplxI += 8 * bits.bit()
				cplxP += 8 * bits.bit()
			}
		}

		def vop(time duration) {
			vopType = bits.read(2)
			let increments = 0
			for bits.flag() {
				increments++
			}
			bits.skip(1)
			if (bits.peek(timeBits + 1) & 1) == 0 {
				// The marker after the time increment is missing: some
				// encoders write a time resolution that disagrees with the
				// increment's length. Find the length that leaves the next
				// fields where they must be: markers set, intra_dc_vlc_thr 0.
				for let n = 1; n < 16; n++ {
					if vopType == vopP || (vopType == vopS && spriteUsage == 2) {
						if (bits.peek(n + 6) & 0x37) == 0x30 {
							timeBits = n
							break
						}
					} else if (bits.peek(n + 5) & 0x1F) == 0x18 {
						timeBits = n
						break
					}
				}
			}
			let increment = bits.read(timeBits)
			bits.skip(1)
			if vopType != vopB {
				lastTimeBase = timeBase
				timeBase += increments
				vopTime = int64(timeBase) * int64(resolution) + int64(increment)
				ppTime = vopTime - lastNonBTime
				lastNonBTime = vopTime
			} else {
				vopTime = int64(lastTimeBase + increments) * int64(resolution) + int64(increment)
				pbTime = ppTime - (lastNonBTime - vopTime)
				// Field distances measured in the first B-VOP's frame interval.
				frameUnit = pbTime when frameUnit == 0
				frameUnit = 1 when frameUnit == 0
				let base = mpeg4RoundedDiv64(lastNonBTime - ppTime, frameUnit)
				ppFieldTime = (mpeg4RoundedDiv64(lastNonBTime, frameUnit) - base) * 2
				pbFieldTime = (mpeg4RoundedDiv64(vopTime, frameUnit) - base) * 2
				if ppFieldTime <= pbFieldTime || pbFieldTime <= 1 {
					pbFieldTime = 2
					ppFieldTime = 4
				}
			}
			if !haveOffset {
				timeOffset = time - streamTime(vopTime)
				haveOffset = true
			}
			if vopType != vopB {
				let t = streamTime(vopTime) + timeOffset
				// Continue after the pictures already made.
				timeOffset += shownEnd - t when haveRef && t <= refTime
				refTime = streamTime(vopTime) + timeOffset
				haveRef = true
			}
			// A VOP not coded repeats the previous picture: nothing new to show.
			return unless bits.flag()
			noRounding = 0
			noRounding = bits.bit() when vopType == vopP || (vopType == vopS && spriteUsage == 2)
			bits.skip(cplxI)
			bits.skip(cplxP) when vopType != vopI
			bits.skip(cplxB) when vopType == vopB
			dcThreshold = mpeg4DcThresholds[bits.read(3)]
			alternateScan = false
			if interlaced {
				topFirst = bits.flag()
				alternateScan = bits.flag()
			}
			scan = alternateScan ?? (mpegAlternateVertical, mpegZigzag)
			// An S-VOP is a P-VOP whose macroblocks may follow the global
			// warp; static sprites are not decoded.
			sprite = vopType == vopS && spriteUsage == 2
			if vopType == vopS {
				spriteTrajectory() when spriteUsage := 1 || 2
				vopType = vopP
			}
			useQuantiser(bits.read(quantBits))
			fCode = 1
			bCode = 1
			fCode = bits.read(3).max(1) when vopType != vopI
			bCode = bits.read(3).max(1) when vopType == vopB
			decodePicture()
		}

		// The stream time of `units` time units.
		def streamTime(units int64) duration {
			return duration(units * 1000000000 / int64(resolution))
		}

		// Reads the warp point trajectory of an S-VOP and computes its warp.
		def spriteTrajectory() {
			for let i = 0; i < 8; i++ {
				trajectory[i] = 0
			}
			for let i = 0; i < warpPoints.min(4); i++ {
				for let c = 0; c < 2; c++ {
					let length = bits.vlc(t.trajectory)
					let v = 0
					if length > 0 {
						v = bits.read(length)
						v = v - (1 << length) + 1 when v < 1 << (length - 1)
					}
					bits.skip(1)
					trajectory[i * 2 + c] = v
				}
			}
			warp.compute(trajectory, warpPoints, warpAccuracy, width, height)
		}

		// The average vector of a global motion macroblock, component `n`, in
		// the units of the VOP's vectors.
		def averageVector(n int) int {
			let len = 1 << (fCode + 4)
			let a = warpAccuracy
			let q = quarterSample ?? (1, 0)
			let sum = 0
			if warp.points == 1 {
				sum = mpeg4RoundShift(warp.offset[n] * (1 << q), a)
			} else {
				let dx = warp.delta[n * 2]
				let dy = warp.delta[n * 2 + 1]
				let shift = warp.shift[0]
				if n == 1 {
					dy -= 1 << (shift + a + 1)
				} else {
					dx -= 1 << (shift + a + 1)
				}
				let v0 = mpeg4Wrap32(warp.offset[n] + dx * mbX * 16 + dy * mbY * 16)
				for let y = 0; y < 16; y++ {
					let v = mpeg4Wrap32(v0 + dy * y)
					for let x = 0; x < 16; x++ {
						sum += v >> shift
						v = mpeg4Wrap32(v + dx)
					}
				}
				sum = mpeg4RoundShift(sum, a + 8 - q)
			}
			return sum.max(0 - len).min(len - 1)
		}

		// Makes `q`, clamped to 1..31, the quantiser, with its DC scalers.
		def useQuantiser(q int) {
			qscale = q.max(1).min(31)
			yDcScale = msVersion != 0 ?? (8, mpeg4LumaDcScale[qscale])
			cDcScale = msVersion != 0 ?? (8, mpeg4ChromaDcScale[qscale])
		}

		def decodePicture() {
			if vopType == vopB {
				// A B-VOP needs both references, and its times in order.
				return unless hasFwd && hasBwd
				return when ppTime <= pbTime || ppTime <= ppTime - pbTime || ppTime <= 0
			} else if hasBwd {
				fwd = bwd
				hasFwd = true
			}
			let p = new MpegPicture(mbWidth * 16, mbHeight * 16)
			p.width = width
			p.height = height
			p.keyframe = vopType == vopI
			p.timed = true
			p.time = streamTime(vopTime) + timeOffset
			p.length = fixedIncrement > 0 ?? (streamTime(int64(fixedIncrement)), 0s)
			let end = p.time + (p.length > 0s ?? (p.length, streamTime(int64(1))))
			shownEnd = end when end > shownEnd
			cur = p
			if vopType != vopB {
				if !hasFwd && vopType != vopI {
					fwd = mpeg4Grey(mbWidth * 16, mbHeight * 16)
					hasFwd = true
				}
			}
			macroblocks()
			if vopType == vopB {
				emit(cur, false)
				return
			}
			bwd = cur
			hasBwd = true
			emit(held, true) when hasHeld
			held = cur
			hasHeld = true
		}

		// Starts decoding MS-MPEG4v2 pictures of `w` x `h`, which have no
		// stream headers.
		def startMs(w int, h int) {
			msVersion = 2
			width = w
			height = h
			quantBits = 5
			setup()
		}

		// Decodes one MS-MPEG4v2 picture, the whole packet, shown at `time`.
		def msPicture(data byte[], time duration) {
			bits.reset(data, 0, data.len())
			return when bits.left() < mbCount
			let coding = bits.read(2)
			return when coding > 1
			vopType = coding == 0 ?? (vopI, vopP)
			useQuantiser(bits.read(5))
			return when qscale == 0
			if vopType == vopI {
				let code = bits.read(5)
				return when code < 0x17
				sliceHeight = mbHeight / (code - 0x16)
			} else {
				return when sliceHeight == 0
				skipCode = bits.flag()
			}
			noRounding = 0
			fCode = 1
			scan = mpegZigzag
			if hasBwd {
				fwd = bwd
				hasFwd = true
			}
			let p = new MpegPicture(mbWidth * 16, mbHeight * 16)
			p.width = width
			p.height = height
			p.keyframe = vopType == vopI
			p.timed = true
			p.time = time
			cur = p
			if !hasFwd && vopType != vopI {
				fwd = mpeg4Grey(mbWidth * 16, mbHeight * 16)
				hasFwd = true
			}
			mbX = 0
			mbY = 0
			for mbY < mbHeight {
				if mbY % sliceHeight == 0 {
					cleanBuffers() when mbY > 0
					startPacket()
				}
				mbX = 0
				for mbX < mbWidth {
					firstLine = false when resyncX == mbX && resyncY + 1 == mbY
					break unless msMacroblock()
					reconstruct()
					mbX++
				}
				mbX = 0
				mbY++
			}
			bwd = cur
			hasBwd = true
			emit(cur, true)
		}

		// Parses one MS-MPEG4v2 macroblock. Returns false on invalid data.
		def msMacroblock() bool {
			skipped = false
			mcsel = false
			fieldMv = false
			fieldDct = false
			direct = false
			fourMv = false
			intra = false
			acPred = false
			dirs = 1
			for let i = 0; i < 6; i++ {
				lastIndex[i] = -1
			}
			let chromaCbp = 0
			if vopType == vopP {
				if skipCode && bits.flag() {
					skipped = true
					for let i = 0; i < 8; i++ {
						mv[i] = 0
					}
					storeMotion()
					return true
				}
				let code = bits.vlc(t.msMbType)
				return false when code < 0
				intra = code >= 4
				chromaCbp = code & 3
			} else {
				intra = true
				chromaCbp = bits.vlc(t.msIntraCbpc)
				return false when chromaCbp < 0
			}
			if !intra {
				let luma = bits.vlc(t.cbpy)
				return false when luma < 0
				cbp = chromaCbp | (luma << 2)
				cbp = cbp ^ 0x3C when chromaCbp != 3
				let p = predictVector(0)
				let x = msVector(p >> 32)
				let y = msVector(mpeg4Low(p))
				for let i = 0; i < 4; i++ {
					mv[i * 2] = x
					mv[i * 2 + 1] = y
				}
				storeMotion()
				for let i = 0; i < 6; i++ {
					continue when (cbp & (32 >> i)) == 0
					let n = msCoefficients(i * 64, 0, scan, t.interCoef, 1, qscale << 1, (qscale - 1) | 1)
					return false when n < -1
					lastIndex[i] = n
				}
				return true
			}
			acPred = bits.flag()
			let luma = bits.vlc(t.cbpy)
			return false when luma < 0
			cbp = chromaCbp | (luma << 2)
			for let i = 0; i < 8; i++ {
				mv[i] = 0
			}
			storeMotion()
			for let i = 0; i < 6; i++ {
				return false unless msIntraBlock(i, (cbp & (32 >> i)) != 0)
			}
			return true
		}

		// An MS-MPEG4v2 vector component: `pred` plus the coded difference,
		// wrapped into -63 to 63.
		def msVector(pred int) int {
			let m = bits.vlc(t.motion)
			return pred when m == 0
			return 0 when m < 0
			let v = bits.flag() ?? (0 - m, m)
			v += pred
			return v + 64 when v <= -64
			return v - 64 when v >= 64
			return v
		}

		// An MS-MPEG4v2 intra block: its DC, predicted from the neighbour with
		// the smaller gradient, then the AC levels. Returns false on invalid
		// data.
		def msIntraBlock(i int, coded bool) bool {
			let b = i * 64
			let size = bits.vlc(i < 4 ?? (t.msDcLuma, t.msDcChroma))
			return false when size < 0
			let level = 0
			if size > 0 {
				level = bits.read(size)
				level = level - (1 << size) + 1 when level < 1 << (size - 1)
				bits.skip(1) when size > 8
			}
			let (dc, at, w) = dcTable(i)
			let scale = i < 4 ?? (yDcScale, cDcScale)
			let a = dc[at - 1]
			let bb = dc[at - 1 - w]
			let c = dc[at - w]
			if firstLine && (i & 2) == 0 {
				bb = 1024
				c = 1024
			}
			a = (a + (scale >> 1)) / scale
			bb = (bb + (scale >> 1)) / scale
			c = (c + (scale >> 1)) / scale
			let dir = (a - bb).abs() <= (bb - c).abs() ?? (1, 0)
			level += dir == 1 ?? (c, a)
			dc[at] = level * scale
			blocks[b] = level
			if coded {
				let s = scan
				s = dir == 0 ?? (mpegAlternateVertical, mpeg4AlternateHorizontal) when acPred
				// Chroma uses the inter table, unscaled.
				let n = msCoefficients(b, 1, s, i < 4 ?? (t.intraCoef, t.interCoef), i < 4 ?? (0, 1), 1, 0)
				return false when n < -1
				lastIndex[i] = n
			}
			predictAc(i, dir)
			lastIndex[i] = lastIndex[i].max(0)
			return true
		}

		// `coefficients` with the Microsoft escapes: 1 for the level beyond
		// the table's, 01 for the run beyond, 00 for last, run and an 8-bit
		// level spelled out.
		def msCoefficients(b int, first int, s int[], table MpegVlc, which int, qmul int, qadd int) int {
			let i = first - 1
			for {
				let sym = bits.vlc(table)
				let last = 0
				let run = 0
				let level = 0
				if sym == coefEscape {
					if bits.peek(1) == 1 {
						bits.skip(1)
						sym = bits.vlc(table)
						return -2 when sym < 0
						last = sym >> 16
						run = (sym >> 8) & 255
						level = (sym & 255) + t.maxLevel[which * 128 + last * 64 + run]
					} else if bits.peek(2) == 1 {
						bits.skip(2)
						sym = bits.vlc(table)
						return -2 when sym < 0
						last = sym >> 16
						level = sym & 255
						run = ((sym >> 8) & 255) + t.maxRun[which * 128 + last * 64 + level]
					} else {
						bits.skip(2)
						last = bits.bit()
						run = bits.read(6)
						level = bits.signed(8)
						if level > 0 {
							level = level * qmul + qadd
						} else {
							level = level * qmul - qadd
						}
						i += run + 1
						return -2 when i > 63
						blocks[b + s[i]] = level
						return i when last == 1
						continue
					}
				} else if sym < 0 {
					return -2
				} else {
					last = sym >> 16
					run = (sym >> 8) & 255
					level = sym & 255
				}
				level = level * qmul + qadd
				level = 0 - level when bits.flag()
				i += run + 1
				return -2 when i > 63
				blocks[b + s[i]] = level
				return i when last == 1
			}
			return i
		}

		def emit(p MpegPicture, copy bool) {
			out.push(p.frame(matrix, copy, fullRange))
		}

		// Decodes the macroblocks of the VOP, video packet by video packet.
		def macroblocks() {
			mbX = 0
			mbY = 0
			startPacket()
			if partitioned && vopType != vopB {
				for {
					return unless partitionedPacket()
					return when mbY >= mbHeight
					return unless packetHeader()
					cleanBuffers()
					startPacket()
				}
			}
			for mbY < mbHeight {
				let at = mbY * mbWidth + mbX
				firstLine = false when resyncX == mbX && resyncY + 1 == mbY
				return unless macroblock()
				reconstruct()
				let next = resyncAt()
				mbX++
				if mbX >= mbWidth {
					mbX = 0
					mbY++
				}
				if next != 0 {
					// In a B-VOP, macroblocks skipped with the newer reference use
					// no bits and still belong to this packet.
					continue when at + 1 < next && vopType == vopB && mbY < mbHeight && skips[mbY * mbWidth + mbX]
					return when mbY >= mbHeight || at + 1 >= mbCount
					return unless packetHeader()
					cleanBuffers()
					startPacket()
				}
			}
		}

		// Decodes one data partitioned video packet from the current macroblock:
		// the motion or DC partition, its marker, the pattern partition, then
		// the texture. Returns false on invalid data.
		def partitionedPacket() bool {
			let n = partitionA()
			return false when n <= 0
			if vopType == vopI {
				for bits.peek(9) == 1 {
					bits.skip(9)
				}
				return false when bits.read(19) != 0x6B001
			} else {
				for bits.peek(10) == 1 {
					bits.skip(10)
				}
				return false when bits.read(17) != 0x1F001
			}
			let q = qscale
			mbX = resyncX
			mbY = resyncY
			firstLine = true
			return false unless partitionB(n)
			mbX = resyncX
			mbY = resyncY
			firstLine = true
			useQuantiser(q)
			for let k = 0; k < n; k++ {
				firstLine = false when resyncX == mbX && resyncY + 1 == mbY
				return false unless texture()
				reconstruct()
				mbX++
				if mbX >= mbWidth {
					mbX = 0
					mbY++
				}
			}
			resyncAt()
			return true
		}

		// The first partition: macroblock types and vectors, or for an I-VOP
		// types, quantiser changes and DC. Returns the macroblocks in the
		// packet, or -1 on invalid data.
		def partitionA() int {
			let count = 0
			firstLine = true
			for mbY < mbHeight {
				firstLine = false when resyncX == mbX && resyncY + 1 == mbY
				let xy = mbY * mbWidth + mbX
				if vopType == vopI {
					return count when bits.peek(19) == 0x6B001
					let cbpc = 8
					for cbpc == 8 {
						cbpc = bits.vlc(t.intraMcbpc)
						return -1 when cbpc < 0
					}
					partKind[xy] = kindIntra
					partCbp[xy] = cbpc & 3
					useQuantiser(qscale + mpeg4DquantSteps[bits.read(2)]) when (cbpc & 4) != 0
					qscales[xy] = qscale
					intraTable[xy] = true
					kinds[xy] = kindIntra
					skips[xy] = false
					for let i = 0; i < 8; i++ {
						mv[i] = 0
					}
					storeMotion()
					return -1 unless partitionDc(xy)
				} else {
					return count when bits.peek(17) == 0x1F001
					partMcsel[xy] = false
					if bits.flag() {
						partKind[xy] = kindSkip
						let x = 0
						let y = 0
						if sprite {
							partMcsel[xy] = true
							x = averageVector(0)
							y = averageVector(1)
						}
						for let i = 0; i < 4; i++ {
							mv[i * 2] = x
							mv[i * 2 + 1] = y
						}
						storeMotion()
						kinds[xy] = kindInter
						skips[xy] = !sprite
						cleanIntra() when intraTable[xy]
					} else {
						let cbpc = bits.vlc(t.interMcbpc)
						return -1 when cbpc < 0
						if cbpc == 20 {
							// Stuffing: read the macroblock again.
							continue
						}
						partCbp[xy] = cbpc & 11
						skips[xy] = false
						if (cbpc & 4) != 0 {
							partKind[xy] = kindIntra
							intraTable[xy] = true
							kinds[xy] = kindIntra
							for let i = 0; i < 8; i++ {
								mv[i] = 0
							}
							storeMotion()
						} else {
							cleanIntra() when intraTable[xy]
							partMcsel[xy] = sprite && (cbpc & 16) == 0 && bits.flag()
							if (cbpc & 16) == 0 {
								partKind[xy] = kindInter
								let x = 0
								let y = 0
								if partMcsel[xy] {
									x = averageVector(0)
									y = averageVector(1)
								} else {
									let p = predictVector(0)
									x = vector(p >> 32, fCode)
									y = vector(mpeg4Low(p), fCode)
								}
								for let i = 0; i < 4; i++ {
									mv[i * 2] = x
									mv[i * 2 + 1] = y
								}
								storeMotion()
								kinds[xy] = kindInter
							} else {
								partKind[xy] = kind4mv
								for let i = 0; i < 4; i++ {
									let p = predictVector(i)
									let at = blockIndex(i)
									motion[at * 2] = vector(p >> 32, fCode)
									motion[at * 2 + 1] = vector(mpeg4Low(p), fCode)
								}
								kinds[xy] = kind4mv
							}
						}
					}
				}
				count++
				mbX++
				if mbX >= mbWidth {
					mbX = 0
					mbY++
				}
			}
			return count
		}

		// Reads the six DC differences of intra macroblock `xy` and predicts
		// them, recording the directions. Returns false on invalid data.
		def partitionDc(xy int) bool {
			let found = 0
			for let i = 0; i < 6; i++ {
				let size = bits.vlc(i < 4 ?? (t.dcLuma, t.dcChroma))
				return false when size < 0 || size > 9
				let level = 0
				if size > 0 {
					level = bits.read(size)
					level = level - (1 << size) + 1 when level < 1 << (size - 1)
					bits.skip(1) when size > 8
				}
				let (dir, pred) = dcPredict(i)
				predictDc(i, level, pred)
				found = (found << 1) | dir
			}
			partDirs[xy] = found
			return true
		}

		// The second partition over the `n` macroblocks of the packet: AC
		// prediction flags, luma patterns and quantiser changes, and the DC of
		// the intra macroblocks of a P-VOP. Returns false on invalid data.
		def partitionB(n int) bool {
			for let k = 0; k < n; k++ {
				firstLine = false when resyncX == mbX && resyncY + 1 == mbY
				let xy = mbY * mbWidth + mbX
				if vopType == vopI {
					partAcPred[xy] = bits.flag()
					let luma = bits.vlc(t.cbpy)
					return false when luma < 0
					partCbp[xy] = partCbp[xy] | (luma << 2)
				} else if partKind[xy] == kindIntra {
					partAcPred[xy] = bits.flag()
					let luma = bits.vlc(t.cbpy)
					return false when luma < 0
					useQuantiser(qscale + mpeg4DquantSteps[bits.read(2)]) when (partCbp[xy] & 8) != 0
					qscales[xy] = qscale
					return false unless partitionDc(xy)
					partCbp[xy] = (partCbp[xy] & 3) | (luma << 2)
				} else if partKind[xy] == kindSkip {
					qscales[xy] = qscale
					partCbp[xy] = 0
				} else {
					let luma = bits.vlc(t.cbpy)
					return false when luma < 0
					useQuantiser(qscale + mpeg4DquantSteps[bits.read(2)]) when (partCbp[xy] & 8) != 0
					qscales[xy] = qscale
					partCbp[xy] = (partCbp[xy] & 3) | ((luma ^ 15) << 2)
				}
				mbX++
				if mbX >= mbWidth {
					mbX = 0
					mbY++
				}
			}
			return true
		}

		// The texture of one macroblock of a data partitioned packet, with what
		// the first partitions recorded. Returns false on invalid data.
		def texture() bool {
			let xy = mbY * mbWidth + mbX
			skipped = false
			mcsel = false
			fieldMv = false
			fieldDct = false
			direct = false
			fourMv = false
			dirs = 1
			for let i = 0; i < 6; i++ {
				lastIndex[i] = -1
			}
			useDcVlc = qscale < dcThreshold
			useQuantiser(qscales[xy]) when qscales[xy] != qscale
			let kind = partKind[xy]
			cbp = partCbp[xy]
			intra = kind == kindIntra
			if kind == kindSkip {
				skipped = true
				mcsel = partMcsel[xy]
			} else if !intra {
				mcsel = partMcsel[xy]
				fourMv = kind == kind4mv
			}
			for let i = 0; i < 4; i++ {
				let at = blockIndex(i)
				mv[i * 2] = motion[at * 2]
				mv[i * 2 + 1] = motion[at * 2 + 1]
			}
			return true when skipped
			acPred = intra && partAcPred[xy]
			for let i = 0; i < 6; i++ {
				let coded = (cbp & (32 >> i)) != 0
				if intra {
					return false unless intraBlock(i, coded)
				} else if coded {
					return false unless interBlock(i)
				}
			}
			return true
		}

		def startPacket() {
			firstLine = true
			resyncX = mbX
			resyncY = mbY
		}

		// Whether a resync marker, after the stuffing that aligns it, follows:
		// the number of the macroblock it starts at, the macroblock count when
		// the VOP ends here, else 0.
		def resyncAt() int {
			let v = bits.peek(16)
			// Macroblock stuffing before the marker.
			for v <= 0xFF && vopType != vopB && !partitioned && (v >> (7 - vopType)) == 1 {
				bits.skip(9 + vopType)
				v = bits.peek(16)
			}
			let count = bits.pos
			let size = bits.end * 8
			if count + 8 >= size {
				v = v >> 8
				v = v | (0x7F >> (7 - (count & 7)))
				return mbCount when v == 0x7F
				return 0
			}
			return 0 unless v == mpeg4ResyncPrefix[count & 7]
			let saved = bits.pos
			bits.skip(1)
			bits.align()
			let len = 0
			for len < 32 && bits.bit() == 0 {
				len++
			}
			let n = bits.read(mpeg4Bits(mbCount - 1))
			let left = bits.left()
			bits.pos = saved
			return 0 when len < prefixLength()
			return -1 when n == 0 || n > mbCount || left < 6
			return n
		}

		// Zero bits before the 1 of a resync marker in this VOP.
		def prefixLength() int {
			return 16 when vopType == vopI
			return fCode + 15 when vopType == vopP
			return fCode.max(bCode).max(2) + 15
		}

		// Reads the video packet header at the next resync marker. Returns
		// false when it is damaged.
		def packetHeader() bool {
			bits.skip(1)
			bits.align()
			let len = 0
			for len < 32 && bits.bit() == 0 {
				len++
			}
			return false when len != prefixLength()
			let n = bits.read(mpeg4Bits(mbCount - 1))
			return false when n == 0 || n >= mbCount
			mbX = n % mbWidth
			mbY = n / mbWidth
			let q = bits.read(quantBits)
			useQuantiser(q) when q != 0
			if bits.flag() {
				for bits.flag() {}
				bits.skip(1 + timeBits + 1 + 2 + 3)
				bits.skip(3) when vopType != vopI
				bits.skip(3) when vopType == vopB
			}
			return true
		}

		// Clears the AC prediction values around the start of a new video
		// packet and the B-VOP vector predictors.
		def cleanBuffers() {
			let l = lumaIndex(2 * mbY - 1, 2 * mbX - 1)
			for let i = 0; i < (wrap * 2 + 1) * 16; i++ {
				acLuma[l * 16 + i] = 0
			}
			let c = chromaIndex(mbY - 1, mbX - 1)
			for let i = 0; i < (cwrap + 1) * 16; i++ {
				acU[c * 16 + i] = 0
				acV[c * 16 + i] = 0
			}
			lastMv[0] = 0
			lastMv[1] = 0
			lastMv[4] = 0
			lastMv[5] = 0
		}

		// Index of 8x8 luma block (`row`, `col`) in the block tables, which
		// have a row above and a column left of the picture.
		def lumaIndex(row int, col int) int {
			return (row + 1) * wrap + col + 1
		}

		def chromaIndex(row int, col int) int {
			return (row + 1) * cwrap + col + 1
		}

		// Parses one macroblock. Returns false on invalid data.
		def macroblock() bool {
			let xy = mbY * mbWidth + mbX
			skipped = false
			mcsel = false
			fieldMv = false
			fieldDct = false
			direct = false
			fourMv = false
			intra = false
			dirs = 1
			for let i = 0; i < 6; i++ {
				lastIndex[i] = -1
			}
			if vopType == vopI {
				kinds[xy] = kindIntra
				skips[xy] = false
				for let i = 0; i < 8; i++ {
					mv[i] = 0
				}
				storeMotion()
				let cbpc = 8
				for cbpc == 8 {
					cbpc = bits.vlc(t.intraMcbpc)
					return false when cbpc < 0
				}
				return intraMacroblock(cbpc, (cbpc & 4) != 0)
			}
			if vopType == vopP {
				mcsel = false
				if bits.flag() {
					skipped = true
					let x = 0
					let y = 0
					if sprite {
						mcsel = true
						x = averageVector(0)
						y = averageVector(1)
					}
					for let i = 0; i < 4; i++ {
						mv[i * 2] = x
						mv[i * 2 + 1] = y
					}
					storeMotion()
					kinds[xy] = kindInter
					skips[xy] = !sprite
					return true
				}
				let cbpc = 20
				for cbpc == 20 {
					cbpc = bits.vlc(t.interMcbpc)
					return false when cbpc < 0
				}
				skips[xy] = false
				if (cbpc & 4) != 0 {
					kinds[xy] = kindIntra
					for let i = 0; i < 8; i++ {
						mv[i] = 0
					}
					storeMotion()
					return intraMacroblock(cbpc & 3, (cbpc & 8) != 0)
				}
				mcsel = sprite && (cbpc & 16) == 0 && bits.flag()
				let luma = bits.vlc(t.cbpy)
				return false when luma < 0
				cbp = (cbpc & 3) | ((luma ^ 15) << 2)
				useQuantiser(qscale + mpeg4DquantSteps[bits.read(2)]) when (cbpc & 8) != 0
				fieldDct = interlaced && cbp != 0 && bits.flag()
				if mcsel {
					let x = averageVector(0)
					let y = averageVector(1)
					for let i = 0; i < 4; i++ {
						mv[i * 2] = x
						mv[i * 2 + 1] = y
					}
					storeMotion()
					kinds[xy] = kindInter
				} else if (cbpc & 16) == 0 {
					let p = predictVector(0)
					if interlaced && bits.flag() {
						// Field prediction: a vector per field, the vertical
						// predicted in field units.
						fieldMv = true
						fieldSel[0] = bits.bit()
						fieldSel[1] = bits.bit()
						for let f = 0; f < 2; f++ {
							mv[f * 2] = vector(p >> 32, fCode)
							mv[f * 2 + 1] = vector(mpeg4Low(p) / 2, fCode)
							fieldMvs[xy * 4 + f * 2] = mv[f * 2]
							fieldMvs[xy * 4 + f * 2 + 1] = mv[f * 2 + 1]
							fieldSels[xy * 2 + f] = fieldSel[f]
						}
						// The vector the neighbours predict from: the mean
						// horizontal, the vertical in frame units.
						let x = mv[0] + mv[2]
						x = (x >> 1) | (x & 1)
						let y = mv[1] + mv[3]
						for let i = 0; i < 4; i++ {
							let at = blockIndex(i)
							motion[at * 2] = x
							motion[at * 2 + 1] = y
						}
						kinds[xy] = kindField
						return inter()
					}
					let x = vector(p >> 32, fCode)
					let y = vector(mpeg4Low(p), fCode)
					for let i = 0; i < 4; i++ {
						mv[i * 2] = x
						mv[i * 2 + 1] = y
					}
					storeMotion()
					kinds[xy] = kindInter
				} else {
					fourMv = true
					for let i = 0; i < 4; i++ {
						let p = predictVector(i)
						mv[i * 2] = vector(p >> 32, fCode)
						mv[i * 2 + 1] = vector(mpeg4Low(p), fCode)
						let at = blockIndex(i)
						motion[at * 2] = mv[i * 2]
						motion[at * 2 + 1] = mv[i * 2 + 1]
					}
					kinds[xy] = kind4mv
				}
				return inter()
			}
			return bMacroblock(xy)
		}

		// Index in `motion` of block `i` of the current macroblock.
		def blockIndex(i int) int {
			return lumaIndex(2 * mbY + (i >> 1), 2 * mbX + (i & 1))
		}

		// Records the macroblock's forward vector for all four blocks.
		def storeMotion() {
			for let i = 0; i < 4; i++ {
				let at = blockIndex(i)
				motion[at * 2] = mv[i * 2]
				motion[at * 2 + 1] = mv[i * 2 + 1]
			}
		}

		// The median prediction of block `i`'s vector (x << 32 | y as
		// unsigned 32 bits) from its left, above and above right neighbours;
		// neighbours outside the video packet do not count.
		def predictVector(i int) int {
			let row = 2 * mbY + (i >> 1)
			let col = 2 * mbX + (i & 1)
			let a = lumaIndex(row, col - 1)
			let b = lumaIndex(row - 1, col)
			let c = lumaIndex(row - 1, col + (i == 3 ?? (-1, (i == 0 ?? (2, 1)))))
			let ax = motion[a * 2]
			let ay = motion[a * 2 + 1]
			let bx = motion[b * 2]
			let by = motion[b * 2 + 1]
			let cx = motion[c * 2]
			let cy = motion[c * 2 + 1]
			if firstLine && i < 3 {
				if i == 0 {
					return mpeg4Pack(0, 0) when mbX == resyncX
					if mbX + 1 == resyncX {
						return mpeg4Pack(cx, cy) when mbX == 0
						return mpeg4Pack(mpeg4Median(ax, 0, cx), mpeg4Median(ay, 0, cy))
					}
					return mpeg4Pack(ax, ay)
				}
				if i == 1 {
					return mpeg4Pack(mpeg4Median(ax, 0, cx), mpeg4Median(ay, 0, cy)) when mbX + 1 == resyncX
					return mpeg4Pack(ax, ay)
				}
				if mbX == resyncX {
					ax = 0
					ay = 0
				}
			}
			return mpeg4Pack(mpeg4Median(ax, bx, cx), mpeg4Median(ay, by, cy))
		}

		// One motion vector component: `pred` plus the coded difference,
		// wrapped into the range of `code`.
		def vector(pred int, code int) int {
			let m = bits.vlc(t.motion)
			return pred when m == 0
			return 0 when m < 0
			let negative = bits.flag()
			let shift = code - 1
			let v = m
			if shift > 0 {
				v = ((v - 1) << shift) | bits.read(shift)
				v++
			}
			v = 0 - v when negative
			v += pred
			let range = 1 << (5 + code)
			return ((v + (range >> 1)) & (range - 1)) - (range >> 1)
		}

		// The rest of an intra macroblock after its type: AC prediction flag,
		// luma pattern, quantiser change and blocks.
		def intraMacroblock(cbpc int, dquant bool) bool {
			intra = true
			acPred = bits.flag()
			let luma = bits.vlc(t.cbpy)
			return false when luma < 0
			cbp = (cbpc & 3) | (luma << 2)
			useDcVlc = qscale < dcThreshold
			useQuantiser(qscale + mpeg4DquantSteps[bits.read(2)]) when dquant
			fieldDct = interlaced && bits.flag()
			for let i = 0; i < 6; i++ {
				return false unless intraBlock(i, (cbp & (32 >> i)) != 0)
			}
			return true
		}

		// The blocks of an inter macroblock.
		def inter() bool {
			for let i = 0; i < 6; i++ {
				continue when (cbp & (32 >> i)) == 0
				return false unless interBlock(i)
			}
			return true
		}

		def bMacroblock(xy int) bool {
			if mbX == 0 {
				for let i = 0; i < 8; i++ {
					lastMv[i] = 0
				}
			}
			// Skipped in the newer reference: skipped here, copying the older
			// one.
			if skips[xy] {
				skipped = true
				for let i = 0; i < 16; i++ {
					mv[i] = 0
				}
				dirs = 1
				return true
			}
			let mode = 0
			cbp = 0
			if bits.flag() {
				mode = 0
				dirs = 3
				direct = true
				setDirect(0, 0)
				return true
			}
			let noCbp = bits.flag()
			mode = bits.vlc(t.bType)
			return false when mode < 0
			cbp = bits.read(6) unless noCbp
			useQuantiser(qscale + bits.bit() * 4 - 2) when mode != 0 && cbp != 0 && bits.flag()
			if interlaced {
				fieldDct = cbp != 0 && bits.flag()
				if mode != 0 && bits.flag() {
					fieldMv = true
					if mode != 2 {
						fieldSel[0] = bits.bit()
						fieldSel[1] = bits.bit()
					}
					if mode != 3 {
						fieldSel[2] = bits.bit()
						fieldSel[3] = bits.bit()
					}
				}
			}
			if mode == 0 {
				dirs = 3
				direct = true
				let dx = vector(0, 1)
				let dy = vector(0, 1)
				setDirect(dx, dy)
			} else {
				dirs = mode == 1 ?? (3, (mode == 2 ?? (2, 1)))
				for let d = 0; d < 2; d++ {
					continue when (dirs & (1 << d)) == 0
					let code = d == 0 ?? (fCode, bCode)
					let p = d * 4
					if fieldMv {
						for let f = 0; f < 2; f++ {
							let x = vector(lastMv[p + f * 2], code)
							let y = vector(lastMv[p + f * 2 + 1] / 2, code)
							lastMv[p + f * 2] = x
							lastMv[p + f * 2 + 1] = y * 2
							mv[d * 8 + f * 2] = x
							mv[d * 8 + f * 2 + 1] = y
						}
					} else {
						let x = vector(lastMv[p], code)
						let y = vector(lastMv[p + 1], code)
						lastMv[p] = x
						lastMv[p + 1] = y
						lastMv[p + 2] = x
						lastMv[p + 3] = y
						for let i = 0; i < 4; i++ {
							mv[d * 8 + i * 2] = x
							mv[d * 8 + i * 2 + 1] = y
						}
					}
				}
			}
			return inter()
		}

		// Direct mode vectors: the newer reference's co-located vectors scaled
		// by the B-VOP's place between the references, plus the delta.
		def setDirect(dx int, dy int) {
			let xy = mbY * mbWidth + mbX
			let kind = kinds[xy]
			if kind == kindField {
				// Each field scaled by its own field distances.
				fieldMv = true
				for let f = 0; f < 2; f++ {
					let sel = fieldSels[xy * 2 + f]
					fieldSel[f] = sel
					fieldSel[2 + f] = f
					let pp = topFirst ?? (ppFieldTime - sel + f, ppFieldTime + sel - f)
					let pb = topFirst ?? (pbFieldTime - sel + f, pbFieldTime + sel - f)
					let px = fieldMvs[xy * 4 + f * 2]
					let py = fieldMvs[xy * 4 + f * 2 + 1]
					mv[f * 2] = mpeg4Div(px * int(pb), int(pp)) + dx
					mv[f * 2 + 1] = mpeg4Div(py * int(pb), int(pp)) + dy
					mv[8 + f * 2] = dx != 0 ?? (mv[f * 2] - px, mpeg4Div(px * int(pb - pp), int(pp)))
					mv[8 + f * 2 + 1] = dy != 0 ?? (mv[f * 2 + 1] - py, mpeg4Div(py * int(pb - pp), int(pp)))
				}
				return
			}
			fourMv = kind == kind4mv || quarterSample
			for let i = 0; i < 4; i++ {
				let src = kind == kind4mv ?? (i, 0)
				let at = blockIndex(src)
				let px = motion[at * 2]
				let py = motion[at * 2 + 1]
				mv[i * 2] = mpeg4Div(px * int(pbTime), int(ppTime)) + dx
				mv[i * 2 + 1] = mpeg4Div(py * int(pbTime), int(ppTime)) + dy
				mv[8 + i * 2] = dx != 0 ?? (mv[i * 2] - px, mpeg4Div(px * int(pbTime - ppTime), int(ppTime)))
				mv[8 + i * 2 + 1] = dy != 0 ?? (mv[i * 2 + 1] - py, mpeg4Div(py * int(pbTime - ppTime), int(ppTime)))
			}
		}

		// Decodes intra block `i`: the DC, its prediction and the AC levels,
		// quantised, into `blocks`.
		def intraBlock(i int, coded bool) bool {
			let b = i * 64
			let level = 0
			let first = 0
			if partitioned && useDcVlc {
				// The DC was predicted with the first partitions.
				let (dc, at, _) = dcTable(i)
				let scale = i < 4 ?? (yDcScale, cDcScale)
				blocks[b] = (dc[at] + (scale >> 1)) / scale
				let dir = (partDirs[mbY * mbWidth + mbX] >> (5 - i)) & 1
				if coded {
					let s = scan
					s = dir == 0 ?? (mpegAlternateVertical, mpeg4AlternateHorizontal) when acPred
					let n = coefficients(b, 1, s, t.intraCoef, 0, 1, 0)
					return false when n < -1
					lastIndex[i] = n
				}
				predictAc(i, dir)
				lastIndex[i] = lastIndex[i].max(0)
				return true
			}
			if useDcVlc {
				let size = bits.vlc(i < 4 ?? (t.dcLuma, t.dcChroma))
				return false when size < 0 || size > 9
				if size > 0 {
					level = bits.read(size)
					level = level - (1 << size) + 1 when level < 1 << (size - 1)
					bits.skip(1) when size > 8
				}
				first = 1
			}
			let (dir, pred) = dcPredict(i)
			if coded {
				let s = scan
				s = dir == 0 ?? (mpegAlternateVertical, mpeg4AlternateHorizontal) when acPred
				let n = coefficients(b, first, s, t.intraCoef, 0, 1, 0)
				return false when n < -1
				lastIndex[i] = n
			}
			blocks[b] = level when useDcVlc
			blocks[b] = predictDc(i, blocks[b], pred)
			predictAc(i, dir)
			lastIndex[i] = lastIndex[i].max(0)
			return true
		}

		// Decodes inter block `i` into `blocks`, dequantised for the H.263
		// method and quantised for the MPEG one.
		def interBlock(i int) bool {
			let qmul = mpegQuant ?? (1, qscale << 1)
			let qadd = mpegQuant ?? (0, (qscale - 1) | 1)
			let n = coefficients(i * 64, 0, scan, t.interCoef, 1, qmul, qadd)
			return false when n < -1
			lastIndex[i] = n
			return true
		}

		// Decodes run/level pairs into `blocks` from `b`, the first at scan
		// position `first`, levels scaled by `qmul` and `qadd`. Returns the
		// last scan position, or -2 on invalid data.
		def coefficients(b int, first int, s int[], table MpegVlc, which int, qmul int, qadd int) int {
			let i = first - 1
			for {
				let sym = bits.vlc(table)
				let last = 0
				let run = 0
				let level = 0
				if sym == coefEscape {
					let mode = bits.peek(2)
					if mode < 2 {
						// First escape: the level exceeds the table's largest.
						bits.skip(1)
						sym = bits.vlc(table)
						return -2 when sym < 0
						last = sym >> 16
						run = (sym >> 8) & 255
						level = (sym & 255) + t.maxLevel[which * 128 + last * 64 + run]
					} else if mode == 2 {
						// Second escape: the run exceeds the table's largest.
						bits.skip(2)
						sym = bits.vlc(table)
						return -2 when sym < 0
						last = sym >> 16
						level = sym & 255
						run = ((sym >> 8) & 255) + t.maxRun[which * 128 + last * 64 + level] + 1
					} else {
						// Third escape: last, run and level spelled out.
						bits.skip(2)
						last = bits.bit()
						run = bits.read(6)
						bits.skip(1)
						level = bits.signed(12)
						bits.skip(1)
						if level > 0 {
							level = level * qmul + qadd
						} else {
							level = level * qmul - qadd
						}
						level = level.max(-2048).min(2047)
						i += run + 1
						return -2 when i > 63
						blocks[b + s[i]] = level
						return i when last == 1
						continue
					}
				} else if sym < 0 {
					return -2
				} else {
					last = sym >> 16
					run = (sym >> 8) & 255
					level = sym & 255
				}
				level = level * qmul + qadd
				level = 0 - level when bits.flag()
				i += run + 1
				return -2 when i > 63
				blocks[b + s[i]] = level
				return i when last == 1
			}
			return i
		}

		// The DC prediction of block `i`: its direction, 0 from the left and 1
		// from above, and the reconstructed DC it predicts from.
		def dcPredict(i int) (int, int) {
			let (dc, at, w) = dcTable(i)
			let a = dc[at - 1]
			let b = dc[at - 1 - w]
			let c = dc[at - w]
			if firstLine && i != 3 {
				if i != 2 {
					b = 1024
					c = 1024
				}
				if i != 1 && mbX == resyncX {
					b = 1024
					a = 1024
				}
			}
			b = 1024 when mbX == resyncX && mbY == resyncY + 1 && (i == 0 || i == 4 || i == 5)
			return (1, c) when (a - b).abs() < (b - c).abs()
			return (0, a)
		}

		// The DC table of block `i`, its index and row stride.
		def dcTable(i int) (int[], int, int) {
			return (dcLuma, blockIndex(i), wrap) when i < 4
			return (i == 4 ?? (dcU, dcV), chromaIndex(mbY, mbX), cwrap)
		}

		// Adds the prediction `pred` to the quantised DC `level` of block `i`
		// and records the reconstructed DC for the blocks after it.
		def predictDc(i int, level int, pred int) int {
			let (dc, at, _) = dcTable(i)
			let scale = i < 4 ?? (yDcScale, cDcScale)
			let q = level + (pred + (scale >> 1)) / scale
			let v = q * scale
			v = v < 0 ?? (0, 2047) when (v & (0 - 2048)) != 0
			dc[at] = v
			return q
		}

		// AC prediction of block `i` from the direction `dir`, then records
		// its first row and column.
		def predictAc(i int, dir int) {
			let b = i * 64
			let ac = i < 4 ?? (acLuma, (i == 4 ?? (acU, acV)))
			let at = i < 4 ?? (blockIndex(i), chromaIndex(mbY, mbX))
			let w = i < 4 ?? (wrap, cwrap)
			if acPred {
				if dir == 0 {
					let from = (at - 1) * 16
					let q = mbX == 0 || i == 1 || i == 3 ?? (qscale, qscales[mbY * mbWidth + mbX - 1])
					for let k = 1; k < 8; k++ {
						blocks[b + k * 8] += mpeg4Rescale(ac[from + k], q, qscale)
					}
				} else {
					let from = (at - w) * 16
					let q = mbY == 0 || i == 2 || i == 3 ?? (qscale, qscales[(mbY - 1) * mbWidth + mbX])
					for let k = 1; k < 8; k++ {
						blocks[b + k] += mpeg4Rescale(ac[from + 8 + k], q, qscale)
					}
				}
			}
			for let k = 1; k < 8; k++ {
				ac[at * 16 + k] = blocks[b + k * 8]
				ac[at * 16 + 8 + k] = blocks[b + k]
			}
		}

		// Reconstructs the macroblock parsed: prediction and residual.
		def reconstruct() {
			let xy = mbY * mbWidth + mbX
			qscales[xy] = qscale
			if intra {
				intraTable[xy] = true
				for let i = 0; i < 6; i++ {
					dequantIntra(i)
					transform(i, false)
				}
				clearBlocks()
				return
			}
			cleanIntra() when intraTable[xy]
			if vopType == vopB {
				let first = true
				if (dirs & 1) != 0 {
					predict(fwd, 0, qpelPut)
					first = false
				}
				predict(bwd, 1, first ?? (qpelPut, qpelAvg)) when (dirs & 2) != 0
			} else if mcsel {
				globalPredict(fwd)
			} else {
				predict(fwd, 0, noRounding == 1 ?? (qpelPutNoRound, qpelPut))
			}
			return when skipped
			for let i = 0; i < 6; i++ {
				continue when lastIndex[i] < 0
				dequantInter(i) when mpegQuant
				transform(i, true)
			}
			clearBlocks()
		}

		// The inverse DCT of block `i` into the current picture, added to the
		// prediction when `add`; the IDCT of the encoder that made the stream.
		def transform(i int, add bool) {
			let b = blocks[i * 64:i * 64 + 64]
			if xvidBuild >= 0 {
				xvidIdctPut(b, plane(i), blockAt(i), blockStride(i), add)
			} else {
				idctPut(b, plane(i), blockAt(i), blockStride(i), add)
			}
		}

		def clearBlocks() {
			for let i = 0; i < 6 * 64; i++ {
				blocks[i] = 0
			}
		}

		// Resets the intra prediction values of a macroblock that is not intra.
		def cleanIntra() {
			let xy = mbY * mbWidth + mbX
			for let i = 0; i < 4; i++ {
				let at = blockIndex(i)
				dcLuma[at] = 1024
				for let k = 0; k < 16; k++ {
					acLuma[at * 16 + k] = 0
				}
			}
			let c = chromaIndex(mbY, mbX)
			dcU[c] = 1024
			dcV[c] = 1024
			for let k = 0; k < 16; k++ {
				acU[c * 16 + k] = 0
				acV[c * 16 + k] = 0
			}
			intraTable[xy] = false
		}

		def plane(i int) byte[] {
			return cur.y when i < 4
			return i == 4 ?? (cur.u, cur.v)
		}

		def blockAt(i int) int {
			if i < 4 {
				let row = fieldDct ?? (i >> 1, (i >> 1) * 8)
				return (mbY * 16 + row) * cur.stride + mbX * 16 + (i & 1) * 8
			}
			return mbY * 8 * cur.cstride + mbX * 8
		}

		def blockStride(i int) int {
			return (fieldDct ?? (2, 1)) * cur.stride when i < 4
			return cur.cstride
		}

		def dequantIntra(i int) {
			let b = i * 64
			blocks[b] = blocks[b] * (i < 4 ?? (yDcScale, cDcScale))
			if mpegQuant {
				let q = qscale << 1
				for let k = 1; k < 64; k++ {
					let l = blocks[b + k]
					continue when l == 0
					let m = ((l < 0 ?? (0 - l, l)) * q * intraMatrix[k]) >> 4
					blocks[b + k] = l < 0 ?? (0 - m, m)
				}
				return
			}
			let qmul = qscale << 1
			let qadd = (qscale - 1) | 1
			for let k = 1; k < 64; k++ {
				let l = blocks[b + k]
				continue when l == 0
				blocks[b + k] = l < 0 ?? (l * qmul - qadd, l * qmul + qadd)
			}
		}

		def dequantInter(i int) {
			let b = i * 64
			let q = qscale << 1
			let sum = -1
			for let k = 0; k < 64; k++ {
				let l = blocks[b + k]
				continue when l == 0
				let m = (((l < 0 ?? (0 - l, l)) << 1) + 1) * q * interMatrix[k] >> 5
				m = 0 - m when l < 0
				blocks[b + k] = m
				sum += m
			}
			blocks[b + 63] = blocks[b + 63] ^ (sum & 1)
		}

		// Motion compensation of direction `s` from `ref` into the macroblock.
		def predict(ref MpegPicture, s int, mode int) {
			let base = s * 8
			let ls = cur.stride
			let rnd = mode == qpelPutNoRound ?? (1, 0)
			let avg = mode == qpelAvg
			let x0 = mbX * 16
			let y0 = mbY * 16
			if fieldMv {
				for let f = 0; f < 2; f++ {
					fieldPredict(ref, f, fieldSel[s * 2 + f], mv[base + f * 2], mv[base + f * 2 + 1], mode)
				}
				return
			}
			if !fourMv {
				let mx = mv[base]
				let my = mv[base + 1]
				let cx = 0
				let cy = 0
				if quarterSample {
					qpel.predict(cur.y, y0 * ls + x0, ls, ref.y, ls, edgeWidth, edgeHeight, x0 + (mx >> 2), y0 + (my >> 2), ((my & 3) << 2) | (mx & 3), 16, mode)
					cx = mx / 2
					cy = my / 2
					cx = (cx >> 1) | (cx & 1)
					cy = (cy >> 1) | (cy & 1)
				} else {
					mpegPredict(cur.y, y0 * ls + x0, ls, ref.y, 0, ls, edgeWidth, edgeHeight, x0 + (mx >> 1), y0 + (my >> 1), ((my & 1) << 1) | (mx & 1), 16, 16, avg, rnd, edge)
					cx = ((mx >> 2) << 1) | (((mx & 3) != 0) ?? (1, 0))
					cy = ((my >> 2) << 1) | (((my & 3) != 0) ?? (1, 0))
				}
				chroma(ref, cx, cy, avg, rnd, false)
				return
			}
			let sx = 0
			let sy = 0
			for let i = 0; i < 4; i++ {
				let mx = mv[base + i * 2]
				let my = mv[base + i * 2 + 1]
				let bx = x0 + (i & 1) * 8
				let by = y0 + (i >> 1) * 8
				let dAt = by * ls + bx
				if quarterSample {
					let px = bx + (mx >> 2)
					let py = by + (my >> 2)
					let dxy = ((my & 3) << 2) | (mx & 3)
					px = px.max(-16).min(width)
					dxy = dxy & 12 when px == width
					py = py.max(-16).min(height)
					dxy = dxy & 3 when py == height
					qpel.predict(cur.y, dAt, ls, ref.y, ls, edgeWidth, edgeHeight, px, py, dxy, 8, mode)
					sx += mx / 2
					sy += my / 2
				} else {
					let px = (bx + (mx >> 1)).max(-16).min(width)
					let py = (by + (my >> 1)).max(-16).min(height)
					let dxy = 0
					dxy = dxy | (mx & 1) when px != width
					dxy = dxy | ((my & 1) << 1) when py != height
					mpegPredict(cur.y, dAt, ls, ref.y, 0, ls, edgeWidth, edgeHeight, px, py, dxy, 8, 8, avg, rnd, edge)
					sx += mx
					sy += my
				}
			}
			chroma(ref, mpeg4RoundChroma(sx), mpeg4RoundChroma(sy), avg, rnd, true)
		}

		// Predicts field `f` of the macroblock (8 of its lines) from field
		// `sel` of `ref` moved by (`mx`, `my`) in field units. Pixels outside
		// the picture repeat the frame's edge lines.
		def fieldPredict(ref MpegPicture, f int, sel int, mx int, my int, mode int) {
			let ls = cur.stride
			let cs = cur.cstride
			let rnd = mode == qpelPutNoRound ?? (1, 0)
			let avg = mode == qpelAvg
			let e = edge.buf
			let dAt = (mbY * 16 + f) * ls + mbX * 16
			let cx = 0
			let cy = 0
			let cdxy = 0
			if quarterSample {
				let sx = mbX * 16 + (mx >> 2)
				let sy = mbY * 8 + (my >> 2)
				let dxy = ((my & 3) << 2) | (mx & 3)
				for let half = 0; half < 2; half++ {
					mpeg4FetchField(e, 9, ref.y, ls, edgeWidth, edgeHeight, sx + half * 8, sy, sel, 9, 9)
					qpel.predict(cur.y, dAt + half * 8, ls * 2, e, 9, 9, 9, 0, 0, dxy, 8, mode)
				}
				cx = mx / 2
				cy = my >> 1
				cx = (cx >> 1) | (cx & 1)
				cy = (cy >> 1) | (cy & 1)
				cdxy = (cx & 1) | ((cy & 1) << 1)
				cx = mbX * 8 + (cx >> 1)
				cy = mbY * 4 + (cy >> 1)
			} else {
				let sx = mbX * 16 + (mx >> 1)
				let sy = mbY * 8 + (my >> 1)
				let dxy = ((my & 1) << 1) | (mx & 1)
				mpeg4FetchField(e, 17, ref.y, ls, edgeWidth, edgeHeight, sx, sy, sel, 17, 9)
				mpegHalfPel(cur.y, dAt, ls * 2, e, 0, 17, dxy, 16, 8, avg, rnd)
				cdxy = dxy | (my & 2) | ((mx & 2) >> 1)
				cx = sx >> 1
				cy = sy >> 1
			}
			let cAt = (mbY * 8 + f) * cs + mbX * 8
			mpeg4FetchField(e, 9, ref.u, cs, edgeWidth >> 1, edgeHeight >> 1, cx, cy, sel, 9, 5)
			mpegHalfPel(cur.u, cAt, cs * 2, e, 0, 9, cdxy, 8, 4, avg, rnd)
			mpeg4FetchField(e, 9, ref.v, cs, edgeWidth >> 1, edgeHeight >> 1, cx, cy, sel, 9, 5)
			mpegHalfPel(cur.v, cAt, cs * 2, e, 0, 9, cdxy, 8, 4, avg, rnd)
		}

		// Global motion compensation of the macroblock from `ref`.
		def globalPredict(ref MpegPicture) {
			let ls = cur.stride
			let cs = cur.cstride
			let a = warpAccuracy
			if warp.points == 1 {
				let mx = warp.offset[0]
				let my = warp.offset[1]
				let sx = mbX * 16 + (mx >> (a + 1))
				let sy = mbY * 16 + (my >> (a + 1))
				mx = mx * (1 << (3 - a))
				my = my * (1 << (3 - a))
				sx = sx.max(-16).min(width)
				mx = 0 when sx == width
				sy = sy.max(-16).min(height)
				my = 0 when sy == height
				let dAt = mbY * 16 * ls + mbX * 16
				let e = edge.buf
				mpeg4Fetch(e, 17, ref.y, ls, edgeWidth, edgeHeight, sx, sy, 17)
				if ((mx | my) & 7) != 0 {
					mpeg4Gmc1Strided(cur.y, dAt, ls, e, 0, 17, 16, mx & 15, my & 15, 128 - noRounding)
					mpeg4Gmc1Strided(cur.y, dAt + 8, ls, e, 8, 17, 16, mx & 15, my & 15, 128 - noRounding)
				} else {
					let dxy = ((mx >> 3) & 1) | ((my >> 2) & 2)
					mpegHalfPel(cur.y, dAt, ls, e, 0, 17, dxy, 16, 16, false, noRounding)
				}
				mx = warp.offset[2]
				my = warp.offset[3]
				sx = mbX * 8 + (mx >> (a + 1))
				sy = mbY * 8 + (my >> (a + 1))
				mx = mx * (1 << (3 - a))
				my = my * (1 << (3 - a))
				sx = sx.max(-8).min(width >> 1)
				mx = 0 when sx == width >> 1
				sy = sy.max(-8).min(height >> 1)
				my = 0 when sy == height >> 1
				let cAt = mbY * 8 * cs + mbX * 8
				mpeg4Fetch(e, 9, ref.u, cs, edgeWidth >> 1, edgeHeight >> 1, sx, sy, 9)
				mpeg4Gmc1Strided(cur.u, cAt, cs, e, 0, 9, 8, mx & 15, my & 15, 128 - noRounding)
				mpeg4Fetch(e, 9, ref.v, cs, edgeWidth >> 1, edgeHeight >> 1, sx, sy, 9)
				mpeg4Gmc1Strided(cur.v, cAt, cs, e, 0, 9, 8, mx & 15, my & 15, 128 - noRounding)
				return
			}
			let d = warp.delta
			let r = (1 << (2 * a + 1)) - noRounding
			let ox = warp.offset[0] + d[0] * mbX * 16 + d[1] * mbY * 16
			let oy = warp.offset[1] + d[2] * mbX * 16 + d[3] * mbY * 16
			let dAt = mbY * 16 * ls + mbX * 16
			mpeg4GmcAffine(cur.y, dAt, ref.y, ls, 16, ox, oy, d[0], d[1], d[2], d[3], a + 1, r, edgeWidth, edgeHeight)
			mpeg4GmcAffine(cur.y, dAt + 8, ref.y, ls, 16, ox + d[0] * 8, oy + d[2] * 8, d[0], d[1], d[2], d[3], a + 1, r, edgeWidth, edgeHeight)
			ox = warp.offset[2] + d[0] * mbX * 8 + d[1] * mbY * 8
			oy = warp.offset[3] + d[2] * mbX * 8 + d[3] * mbY * 8
			let cAt = mbY * 8 * cs + mbX * 8
			mpeg4GmcAffine(cur.u, cAt, ref.u, cs, 8, ox, oy, d[0], d[1], d[2], d[3], a + 1, r, (edgeWidth + 1) >> 1, (edgeHeight + 1) >> 1)
			mpeg4GmcAffine(cur.v, cAt, ref.v, cs, 8, ox, oy, d[0], d[1], d[2], d[3], a + 1, r, (edgeWidth + 1) >> 1, (edgeHeight + 1) >> 1)
		}

		// Chroma prediction by the half-pel chroma vector (`cx`, `cy`).
		def chroma(ref MpegPicture, cx int, cy int, avg bool, rnd int, clip bool) {
			let cs = cur.cstride
			let dxy = ((cy & 1) << 1) | (cx & 1)
			let px = mbX * 8 + (cx >> 1)
			let py = mbY * 8 + (cy >> 1)
			if clip {
				px = px.max(-8).min(width >> 1)
				dxy = dxy & 2 when px == width >> 1
				py = py.max(-8).min(height >> 1)
				dxy = dxy & 1 when py == height >> 1
			}
			let dAt = mbY * 8 * cs + mbX * 8
			mpegPredict(cur.u, dAt, cs, ref.u, 0, cs, edgeWidth >> 1, edgeHeight >> 1, px, py, dxy, 8, 8, avg, rnd, edge)
			mpegPredict(cur.v, dAt, cs, ref.v, 0, cs, edgeWidth >> 1, edgeHeight >> 1, px, py, dxy, 8, 8, avg, rnd, edge)
		}
	}

	const mpeg4DquantSteps = int[-1, -2, 1, 2]

	// The 16-bit look ahead that starts a resync marker at each bit
	// position within a byte: stuffing 0 1..1, then zeros.
	const mpeg4ResyncPrefix = int[0x7F00, 0x7E00, 0x7C00, 0x7800, 0x7000, 0x6000, 0x4000, 0x0000]

	// Bits needed to write `n`.
	def mpeg4Bits(n int) int {
		let b = 1
		for (1 << b) <= n {
			b++
		}
		return b
	}

	def mpeg4Median(a int, b int, c int) int {
		return a.max(b).min(a.min(b).max(c))
	}

	def mpeg4Pack(x int, y int) int {
		return (x << 32) | (y & 0xFFFFFFFF)
	}

	// The low 32 bits of `p` as a signed number.
	def mpeg4Low(p int) int {
		let v = p & 0xFFFFFFFF
		return v - 0x100000000 when v >= 0x80000000
		return v
	}

	// `a / b` truncated toward zero.
	def mpeg4Div(a int, b int) int {
		return a / b
	}

	// `v * from / to` rounded half away from zero.
	def mpeg4Rescale(v int, from int, to int) int {
		return v when from == to
		let a = v * from
		return (a + (to >> 1)) / to when a > 0
		return (a - (to >> 1)) / to
	}

	// The chroma half-pel vector of four luma half-pel vectors summing to
	// `sum`.
	def mpeg4RoundChroma(sum int) int {
		return ((sum >> 4) << 1) + mpeg4ChromaRound[sum & 15]
	}

	// The decimal number at `from` in `text`, -1 when there is none.
	def mpeg4Number(text string, from int) int {
		let bytes = text.bytes()
		let v = 0
		let any = false
		for let i = from; i < bytes.len(); i++ {
			let c = int(bytes[i])
			break when c < 48 || c > 57
			v = v * 10 + c - 48
			any = true
		}
		return any ?? (v, -1)
	}

	// A mid-grey picture standing in for a missing reference.
	def mpeg4Grey(w int, h int) MpegPicture {
		let g = new MpegPicture(w, h)
		for let i = 0; i < g.y.len(); i++ {
			g.y[i] = 128
		}
		for let i = 0; i < g.u.len(); i++ {
			g.u[i] = 128
			g.v[i] = 128
		}
		return g
	}
}
