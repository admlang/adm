internal partial module std.formats.video.mpeg4 {
	use std.formats.video.mpegvideo::*

	// The inverse DCT the Xvid encoder reconstructs with, which its streams
	// must be decoded with to stay drift free: rows at 11 fractional bits
	// with per-row scaled coefficients and rounding, columns by tangent
	// butterflies at 16 bits.
	const xvidTab04 = int[22725, 21407, 19266, 16384, 12873, 8867, 4520]
	const xvidTab17 = int[31521, 29692, 26722, 22725, 17855, 12299, 6270]
	const xvidTab26 = int[29692, 27969, 25172, 21407, 16819, 11585, 5906]
	const xvidTab35 = int[26722, 25172, 22654, 19266, 15137, 10426, 5315]
	const xvidRowRound = int[65536, 3597, 2260, 1203, 0, 120, 512, 512]
	const xvidTan1 = 13036
	const xvidTan2 = 27146
	const xvidTan3 = 43790
	const xvidSqrt2 = 23170

	// The row pass of row `r` of `b`.
	def xvidRow(b int[], r int) {
		let o = r * 8
		let tab = r == 0 || r == 4 ?? (xvidTab04, (r == 1 || r == 7 ?? (xvidTab17, (r == 2 || r == 6 ?? (xvidTab26, xvidTab35)))))
		let rnd = xvidRowRound[r]
		let c1 = tab[0]
		let c2 = tab[1]
		let c3 = tab[2]
		let c4 = tab[3]
		let c5 = tab[4]
		let c6 = tab[5]
		let c7 = tab[6]
		let x0 = b[o]
		let x1 = b[o + 1]
		let x2 = b[o + 2]
		let x3 = b[o + 3]
		let x4 = b[o + 4]
		let x5 = b[o + 5]
		let x6 = b[o + 6]
		let x7 = b[o + 7]
		let right = x5 | x6 | x7
		let left = x1 | x2 | x3
		if (right | x4) == 0 {
			let k = c4 * x0 + rnd
			if left == 0 {
				let a = k >> 11
				for let i = 0; i < 8; i++ {
					b[o + i] = a
				}
				return
			}
			let a0 = k + c2 * x2
			let a1 = k + c6 * x2
			let a2 = k - c6 * x2
			let a3 = k - c2 * x2
			let b0 = c1 * x1 + c3 * x3
			let b1 = c3 * x1 - c7 * x3
			let b2 = c5 * x1 - c1 * x3
			let b3 = c7 * x1 - c5 * x3
			xvidRowOut(b, o, a0, a1, a2, a3, b0, b1, b2, b3)
			return
		}
		if (left | right) == 0 {
			let a0 = (rnd + c4 * (x0 + x4)) >> 11
			let a1 = (rnd + c4 * (x0 - x4)) >> 11
			b[o] = a0
			b[o + 3] = a0
			b[o + 4] = a0
			b[o + 7] = a0
			b[o + 1] = a1
			b[o + 2] = a1
			b[o + 5] = a1
			b[o + 6] = a1
			return
		}
		let k = c4 * x0 + rnd
		let a0 = k + c2 * x2 + c4 * x4 + c6 * x6
		let a1 = k + c6 * x2 - c4 * x4 - c2 * x6
		let a2 = k - c6 * x2 - c4 * x4 + c2 * x6
		let a3 = k - c2 * x2 + c4 * x4 - c6 * x6
		let b0 = c1 * x1 + c3 * x3 + c5 * x5 + c7 * x7
		let b1 = c3 * x1 - c7 * x3 - c1 * x5 - c5 * x7
		let b2 = c5 * x1 - c1 * x3 + c7 * x5 + c3 * x7
		let b3 = c7 * x1 - c5 * x3 + c3 * x5 - c1 * x7
		xvidRowOut(b, o, a0, a1, a2, a3, b0, b1, b2, b3)
	}

	def xvidRowOut(b int[], o int, a0 int, a1 int, a2 int, a3 int, b0 int, b1 int, b2 int, b3 int) {
		b[o] = (a0 + b0) >> 11
		b[o + 1] = (a1 + b1) >> 11
		b[o + 2] = (a2 + b2) >> 11
		b[o + 3] = (a3 + b3) >> 11
		b[o + 4] = (a3 - b3) >> 11
		b[o + 5] = (a2 - b2) >> 11
		b[o + 6] = (a1 - b1) >> 11
		b[o + 7] = (a0 - b0) >> 11
	}

	// The inverse DCT of `b` (destroyed) written to the 8x8 pixels of `dst`
	// at `at`, or added to them when `add`.
	def xvidIdctPut(b int[], dst byte[], at int, stride int, add bool) {
		for let r = 0; r < 8; r++ {
			xvidRow(b, r)
		}
		let px int[]
		px.len(8)
		for let c = 0; c < 8; c++ {
			let m4 = b[56 + c]
			let m5 = b[40 + c]
			let m6 = b[24 + c]
			let m7 = b[8 + c]
			let m0 = ((xvidTan1 * m4) >> 16) + m7
			let m1 = ((xvidTan1 * m7) >> 16) - m4
			let m2 = ((xvidTan3 * m5) >> 16) + m6
			let m3 = ((xvidTan3 * m6) >> 16) - m5
			m7 = m0 + m2
			m4 = m1 - m3
			m0 = m0 - m2
			m1 = m1 + m3
			m6 = m0 + m1
			m5 = m0 - m1
			m5 = 2 * ((xvidSqrt2 * m5) >> 16)
			m6 = 2 * ((xvidSqrt2 * m6) >> 16)
			m1 = b[16 + c]
			m2 = b[48 + c]
			m3 = ((xvidTan2 * m2) >> 16) + m1
			m2 = ((xvidTan2 * m1) >> 16) - m2
			m0 = b[c] + b[32 + c]
			m1 = b[c] - b[32 + c]
			let t = m0 + m3
			m3 = m0 - m3
			m0 = t
			t = m0 + m7
			m7 = m0 - m7
			m0 = t
			px[0] = m0 >> 6
			px[7] = m7 >> 6
			t = m3 + m4
			m4 = m3 - m4
			m3 = t
			px[3] = m3 >> 6
			px[4] = m4 >> 6
			t = m1 + m2
			m2 = m1 - m2
			m1 = t
			t = m1 + m6
			m6 = m1 - m6
			m1 = t
			px[1] = m1 >> 6
			px[6] = m6 >> 6
			t = m2 + m5
			m5 = m2 - m5
			m2 = t
			px[2] = m2 >> 6
			px[5] = m5 >> 6
			for let r = 0; r < 8; r++ {
				let o = at + r * stride + c
				if add {
					dst[o] = mpegClip(int(dst[o]) + px[r])
				} else {
					dst[o] = mpegClip(px[r])
				}
			}
		}
	}
}
