internal partial module std.formats.video.mpeg4 {
	// How a prediction is stored: put rounding half positions up, put
	// rounding them down (vop_rounding_type 1), or averaged into what is
	// there, rounding up.
	const qpelPut = 0
	const qpelPutNoRound = 1
	const qpelAvg = 2

	// Quarter-pel motion compensation of ISO/IEC 14496-2 7.6.2.1: the 8-tap
	// half-pel filter with the block's edge pixels mirrored, then bilinear
	// quarter positions, computed the way the reference decoders chain them.
	type Mpeg4Qpel {
		// The block and one extra row and column, edge pixels repeated where
		// it reaches outside the plane.
		full   byte[]
		halfH  byte[]
		halfHV byte[]
		tmp    byte[]

		def new() {
			full.len(17 * 17)
			halfH.len(17 * 16)
			halfHV.len(16 * 16)
			tmp.len(16 * 16)
		}

		// Predicts the `size` x `size` block at `dAt` in `dst` from `src`
		// (lines `sStride` apart, `pw` x `ph` pixels) at whole pixel (`x`,
		// `y`) plus the quarter pixel fraction `dxy` (y fraction << 2 | x
		// fraction), stored by `mode`.
		def predict(dst byte[], dAt int, dStride int, src byte[], sStride int, pw int, ph int, x int, y int, dxy int, size int, mode int) {
			let fs = size + 1
			for let j = 0; j < fs; j++ {
				let sy = (y + j).max(0).min(ph - 1) * sStride
				for let i = 0; i < fs; i++ {
					full[j * fs + i] = src[sy + (x + i).max(0).min(pw - 1)]
				}
			}
			let rnd = mode == qpelPutNoRound ?? (1, 0)
			let fx = dxy & 3
			let fy = dxy >> 2
			if fy == 0 {
				if fx == 0 {
					store(dst, dAt, dStride, full, 0, fs, size, mode)
				} else if fx == 2 {
					lowH(full, 0, fs, tmp, 0, size, size, size, rnd)
					store(dst, dAt, dStride, tmp, 0, size, size, mode)
				} else {
					lowH(full, 0, fs, tmp, 0, size, size, size, rnd)
					average(tmp, 0, size, full, fx == 1 ?? (0, 1), fs, tmp, 0, size, size, size, rnd)
					store(dst, dAt, dStride, tmp, 0, size, size, mode)
				}
				return
			}
			if fx == 0 {
				lowV(full, 0, fs, tmp, 0, size, size, rnd)
				average(tmp, 0, size, full, fy == 1 ?? (0, fs), fs, tmp, 0, size, size, size, rnd) when fy != 2
				store(dst, dAt, dStride, tmp, 0, size, size, mode)
				return
			}
			// Both fractions: the horizontal pass over size + 1 rows first.
			lowH(full, 0, fs, halfH, 0, size, size, fs, rnd)
			average(halfH, 0, size, full, fx == 1 ?? (0, 1), fs, halfH, 0, size, size, fs, rnd) when fx != 2
			if fy == 2 {
				lowV(halfH, 0, size, tmp, 0, size, size, rnd)
			} else {
				lowV(halfH, 0, size, halfHV, 0, size, size, rnd)
				average(halfH, fy == 1 ?? (0, size), size, halfHV, 0, size, tmp, 0, size, size, size, rnd)
			}
			store(dst, dAt, dStride, tmp, 0, size, size, mode)
		}

		// `rows` rows of the horizontal half-pel filter over `size` + 1
		// pixels of `src`, the taps past the ends mirrored.
		def lowH(src byte[], sAt int, sStride int, out byte[], oAt int, oStride int, size int, rows int, rnd int) {
			let r = 16 - rnd
			let last = size
			for let j = 0; j < rows; j++ {
				let s = sAt + j * sStride
				let o = oAt + j * oStride
				for let k = 0; k < size; k++ {
					let v = 20 * (int(src[s + k]) + int(src[s + k + 1]))
					v -= 6 * (int(src[s + qpelMirror(k - 1, last)]) + int(src[s + qpelMirror(k + 2, last)]))
					v += 3 * (int(src[s + qpelMirror(k - 2, last)]) + int(src[s + qpelMirror(k + 3, last)]))
					v -= int(src[s + qpelMirror(k - 3, last)]) + int(src[s + qpelMirror(k + 4, last)])
					out[o + k] = qpelClip((v + r) >> 5)
				}
			}
		}

		// The vertical half-pel filter over `size` + 1 rows of `src`.
		def lowV(src byte[], sAt int, sStride int, out byte[], oAt int, oStride int, size int, rnd int) {
			let r = 16 - rnd
			let last = size
			for let i = 0; i < size; i++ {
				let s = sAt + i
				for let k = 0; k < size; k++ {
					let v = 20 * (int(src[s + k * sStride]) + int(src[s + (k + 1) * sStride]))
					v -= 6 * (int(src[s + qpelMirror(k - 1, last) * sStride]) + int(src[s + qpelMirror(k + 2, last) * sStride]))
					v += 3 * (int(src[s + qpelMirror(k - 2, last) * sStride]) + int(src[s + qpelMirror(k + 3, last) * sStride]))
					v -= int(src[s + qpelMirror(k - 3, last) * sStride]) + int(src[s + qpelMirror(k + 4, last) * sStride])
					out[oAt + k * oStride + i] = qpelClip((v + r) >> 5)
				}
			}
		}

		// out = (a + b + 1 - rnd) / 2 over `w` x `h` pixels.
		def average(a byte[], aAt int, aStride int, b byte[], bAt int, bStride int, out byte[], oAt int, oStride int, w int, h int, rnd int) {
			let r = 1 - rnd
			for let j = 0; j < h; j++ {
				for let i = 0; i < w; i++ {
					out[oAt + j * oStride + i] = byte((int(a[aAt + j * aStride + i]) + int(b[bAt + j * bStride + i]) + r) >> 1)
				}
			}
		}

		// Writes the prediction `p` into `dst`, averaged in for `qpelAvg`.
		def store(dst byte[], dAt int, dStride int, p byte[], pAt int, pStride int, size int, mode int) {
			for let j = 0; j < size; j++ {
				let d = dAt + j * dStride
				let s = pAt + j * pStride
				if mode == qpelAvg {
					for let i = 0; i < size; i++ {
						dst[d + i] = byte((int(dst[d + i]) + int(p[s + i]) + 1) >> 1)
					}
				} else {
					for let i = 0; i < size; i++ {
						dst[d + i] = p[s + i]
					}
				}
			}
		}
	}

	// Tap `p` of a filter over pixels 0 to `last`, mirrored at both ends.
	def qpelMirror(p int, last int) int {
		return 0 - p - 1 when p < 0
		return 2 * last + 1 - p when p > last
		return p
	}

	def qpelClip(v int) byte {
		return byte(0) when v < 0
		return byte(255) when v > 255
		return byte(v)
	}
}
