internal partial module std.formats.video.mpeg4 {
	// Global motion compensation of S-VOPs (ISO/IEC 14496-2 7.8): the warp
	// the sprite trajectory describes, as one translation or an affine map.

	// The warp of one S-VOP in the form motion compensation applies it:
	// luma and chroma offsets, the 2x2 matrix and the fixed-point shift.
	type Mpeg4Warp {
		// [plane * 2 + component], plane 0 luma, 1 chroma.
		offset int[]
		// [row * 2 + column]
		delta  int[]
		// Fractional bits of luma and chroma positions.
		shift  int[]
		// 1 when the warp reduced to a translation.
		points int

		def new() {
			offset.len(4)
			delta.len(4)
			shift.len(2)
		}

		// Computes the warp from the trajectory `d` ([point * 2 + component]) of
		// `count` points at accuracy `accuracy` for a `w` x `h` VOP. Returns
		// false when it overflows what motion compensation can hold, leaving a
		// zero warp.
		def compute(d int[], count int, accuracy int, w int, h int) bool {
			let a = 2 << accuracy
			let rho = 3 - accuracy
			let r = 16 / a
			let alpha = 1
			let beta = 0
			for (1 << alpha) < w {
				alpha++
			}
			for (1 << beta) < h {
				beta++
			}
			let w2 = 1 << alpha
			let h2 = 1 << beta
			// Reference points of the VOP corners (0, 0), (w, 0), (0, h).
			let s0x = (a >> 1) * d[0]
			let s0y = (a >> 1) * d[1]
			let s1x = (a >> 1) * (2 * w + d[0] + d[2])
			let s1y = (a >> 1) * (d[1] + d[3])
			let s2x = (a >> 1) * (d[0] + d[4])
			let s2y = (a >> 1) * (2 * h + d[1] + d[5])
			let v0x = 16 * w2 + mpeg4RoundedDiv((w - w2) * (r * s0x) + w2 * (r * s1x - 16 * w), w)
			let v0y = mpeg4RoundedDiv((w - w2) * (r * s0y) + w2 * (r * s1y), w)
			let v1x = mpeg4RoundedDiv((h - h2) * (r * s0x) + h2 * (r * s2x), h)
			let v1y = 16 * h2 + mpeg4RoundedDiv((h - h2) * (r * s0y) + h2 * (r * s2y - 16 * h), h)
			for let i = 0; i < 4; i++ {
				offset[i] = 0
				delta[i] = 0
			}
			if count == 0 {
				delta[0] = a
				delta[3] = a
				shift[0] = 0
				shift[1] = 0
			} else if count == 1 {
				offset[0] = s0x
				offset[1] = s0y
				offset[2] = (s0x >> 1) | (s0x & 1)
				offset[3] = (s0y >> 1) | (s0y & 1)
				delta[0] = a
				delta[3] = a
				shift[0] = 0
				shift[1] = 0
			} else if count == 2 {
				let e = alpha + rho
				offset[0] = s0x * (1 << e) + (1 << (e - 1))
				offset[1] = s0y * (1 << e) + (1 << (e - 1))
				offset[2] = (0 - r * s0x + v0x) + (r * s0y - v0y) + 2 * w2 * r * s0x - 16 * w2 + (1 << (e + 1))
				offset[3] = (0 - r * s0y + v0y) + (0 - r * s0x + v0x) + 2 * w2 * r * s0y - 16 * w2 + (1 << (e + 1))
				delta[0] = 0 - r * s0x + v0x
				delta[1] = r * s0y - v0y
				delta[2] = 0 - r * s0y + v0y
				delta[3] = 0 - r * s0x + v0x
				shift[0] = e
				shift[1] = e + 2
			} else {
				let m = alpha.min(beta)
				let w3 = w2 >> m
				let h3 = h2 >> m
				let e = alpha + beta + rho - m
				offset[0] = s0x * (1 << e) + (1 << (e - 1))
				offset[1] = s0y * (1 << e) + (1 << (e - 1))
				offset[2] = (0 - r * s0x + v0x) * h3 + (0 - r * s0x + v1x) * w3 + 2 * w2 * h3 * r * s0x - 16 * w2 * h3 + (1 << (e + 1))
				offset[3] = (0 - r * s0y + v0y) * h3 + (0 - r * s0y + v1y) * w3 + 2 * w2 * h3 * r * s0y - 16 * w2 * h3 + (1 << (e + 1))
				delta[0] = (0 - r * s0x + v0x) * h3
				delta[1] = (0 - r * s0x + v1x) * w3
				delta[2] = (0 - r * s0y + v0y) * h3
				delta[3] = (0 - r * s0y + v1y) * w3
				shift[0] = e
				shift[1] = e + 2
			}
			if delta[0] == a << shift[0] && delta[1] == 0 && delta[2] == 0 && delta[3] == a << shift[0] {
				offset[0] = offset[0] >> shift[0]
				offset[1] = offset[1] >> shift[0]
				offset[2] = offset[2] >> shift[1]
				offset[3] = offset[3] >> shift[1]
				delta[0] = a
				delta[1] = 0
				delta[2] = 0
				delta[3] = a
				shift[0] = 0
				shift[1] = 0
				points = 1
				return true
			}
			let sy = 16 - shift[0]
			let sc = 16 - shift[1]
			let limit = 0x7FFFFFFF
			for let i = 0; i < 2; i++ {
				return overflow() when sc < 0 || sy < 0 || offset[i].abs() >= limit >> sy || offset[2 + i].abs() >= limit >> sc || delta[i].abs() >= limit >> sy || delta[2 + i].abs() >= limit >> sy
			}
			for let i = 0; i < 2; i++ {
				offset[i] = offset[i] * (1 << sy)
				offset[2 + i] = offset[2 + i] * (1 << sc)
				delta[i] = delta[i] * (1 << sy)
				delta[2 + i] = delta[2 + i] * (1 << sy)
				shift[i] = 16
			}
			for let i = 0; i < 2; i++ {
				let sd0 = delta[i * 2] - a * (1 << 16)
				let sd1 = delta[i * 2 + 1] - a * (1 << 16)
				return overflow() when (offset[i] + delta[i * 2] * (w + 16)).abs() >= limit || (offset[i] + delta[i * 2 + 1] * (h + 16)).abs() >= limit || (offset[i] + delta[i * 2] * (w + 16) + delta[i * 2 + 1] * (h + 16)).abs() >= limit || (delta[i * 2] * (w + 16)).abs() >= limit || (delta[i * 2 + 1] * (h + 16)).abs() >= limit || (sd0 * (w + 16)).abs() >= limit || (sd1 * (h + 16)).abs() >= limit || (sd0 * (w + 16) + sd1 * (h + 16)).abs() >= limit
			}
			points = count
			return true
		}

		def overflow() bool {
			for let i = 0; i < 4; i++ {
				offset[i] = 0
				delta[i] = 0
			}
			return false
		}
	}

	// `a / b` rounded half away from zero.
	def mpeg4RoundedDiv(a int, b int) int {
		return (a + (b >> 1)) / b when a >= 0
		return (a - (b >> 1)) / b
	}

	// `a >> b` rounded half away from zero.
	def mpeg4RoundShift(a int, b int) int {
		return (a + ((1 << b) >> 1)) >> b when a > 0
		return (a + ((1 << b) >> 1) - 1) >> b
	}

	// Bilinear prediction of an 8-wide block of `h` lines at `dAt` in `dst`
	// (lines `dStride` apart) from `src` at `sAt` (lines `sStride` apart) with
	// sixteenth-pel fractions (`x16`, `y16`).
	def mpeg4Gmc1Strided(dst byte[], dAt int, dStride int, src byte[], sAt int, sStride int, h int, x16 int, y16 int, rounder int) {
		let a = (16 - x16) * (16 - y16)
		let b = x16 * (16 - y16)
		let c = (16 - x16) * y16
		let d = x16 * y16
		for let j = 0; j < h; j++ {
			let o = dAt + j * dStride
			let s = sAt + j * sStride
			for let i = 0; i < 8; i++ {
				dst[o + i] = byte((a * int(src[s + i]) + b * int(src[s + i + 1]) + c * int(src[s + i + sStride]) + d * int(src[s + i + sStride + 1]) + rounder) >> 8)
			}
		}
	}

	// Copies the `n` x `n` pixels of `src` (lines `sStride` apart, `pw` x
	// `ph`) at (`x`, `y`) into `dst`, lines `dStride` apart, repeating the edge
	// pixels outside the plane.
	def mpeg4Fetch(dst byte[], dStride int, src byte[], sStride int, pw int, ph int, x int, y int, n int) {
		for let j = 0; j < n; j++ {
			let row = (y + j).max(0).min(ph - 1) * sStride
			for let i = 0; i < n; i++ {
				dst[j * dStride + i] = src[row + (x + i).max(0).min(pw - 1)]
			}
		}
	}

	// Copies `w` x `h` pixels of field `sel` of the frame plane `src` (lines
	// `sStride` apart, `pw` x `ph`) from field position (`x`, `y`) into `dst`,
	// lines `dStride` apart; positions outside repeat the frame's edge.
	def mpeg4FetchField(dst byte[], dStride int, src byte[], sStride int, pw int, ph int, x int, y int, sel int, w int, h int) {
		for let j = 0; j < h; j++ {
			let row = (2 * (y + j) + sel).max(0).min(ph - 1) * sStride
			for let i = 0; i < w; i++ {
				dst[j * dStride + i] = src[row + (x + i).max(0).min(pw - 1)]
			}
		}
	}

	// `a / b` rounded half away from zero.
	def mpeg4RoundedDiv64(a int64, b int64) int64 {
		return (a + (b >> 1)) / b when a >= 0
		return (a - (b >> 1)) / b
	}

	// `v` as a signed 32-bit number, wrapping like the fixed-point arithmetic
	// the warp is defined in.
	def mpeg4Wrap32(v int) int {
		return ((v + 0x80000000) & 0xFFFFFFFF) - 0x80000000
	}

	// Affine prediction of an 8-wide block of `h` lines at `dAt` in `dst`:
	// the source position starts at (`ox`, `oy`) in 16.16 fixed point and
	// steps by (`dxx`, `dyx`) along a line and (`dxy`, `dyy`) down; `shift`
	// fractional bits are interpolated, positions outside the `width` x
	// `height` plane repeat its edge.
	def mpeg4GmcAffine(dst byte[], dAt int, src byte[], stride int, h int, ox int, oy int, dxx int, dxy int, dyx int, dyy int, shift int, r int, width int, height int) {
		let s = 1 << shift
		let wl = width - 1
		let hl = height - 1
		let rx = ox
		let ry = oy
		for let y = 0; y < h; y++ {
			let vx = rx
			let vy = ry
			for let x = 0; x < 8; x++ {
				let sx = vx >> 16
				let sy = vy >> 16
				let fx = sx & (s - 1)
				let fy = sy & (s - 1)
				sx = sx >> shift
				sy = sy >> shift
				let o = dAt + y * stride + x
				let inX = sx >= 0 && sx < wl
				let inY = sy >= 0 && sy < hl
				if inX && inY {
					let i = sx + sy * stride
					dst[o] = byte(((int(src[i]) * (s - fx) + int(src[i + 1]) * fx) * (s - fy) + (int(src[i + stride]) * (s - fx) + int(src[i + stride + 1]) * fx) * fy + r) >> (shift * 2))
				} else if inX {
					let i = sx + sy.max(0).min(hl) * stride
					dst[o] = byte(((int(src[i]) * (s - fx) + int(src[i + 1]) * fx) * s + r) >> (shift * 2))
				} else if inY {
					let i = sx.max(0).min(wl) + sy * stride
					dst[o] = byte(((int(src[i]) * (s - fy) + int(src[i + stride]) * fy) * s + r) >> (shift * 2))
				} else {
					dst[o] = src[sx.max(0).min(wl) + sy.max(0).min(hl) * stride]
				}
				vx += dxx
				vy += dyx
			}
			rx += dxy
			ry += dyy
		}
	}
}
