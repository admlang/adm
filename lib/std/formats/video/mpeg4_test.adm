		// A 64x48 stream of three frames with a B-frame, followed by a 48x32
		// one: the second VOL changes the picture size mid-stream.
		internal const m4ResizeFixture = ""

		// Each half as ffmpeg decodes it alone.
		internal const m4ResizeHashes = string[
			"8CD4F6738088D7BBFC6E6290321363FD", "8CD4F6738088D7BBFC6E6290321363FD", "8CD4F6738088D7BBFC6E6290321363FD",
			"6E80CCD47BD89F827AA17F801F4F1D4E", "6E80CCD47BD89F827AA17F801F4F1D4E", "6E80CCD47BD89F827AA17F801F4F1D4E"
		]

		internal def m4Fixture(text string) byte[] {
			return encoding.base64decode(text) onerror recover byte[]
		}

		// The MD5 of the frame's visible planes, Y then U then V, as
		// `ffmpeg -f framemd5` computes it.
		internal def m4Hash(f VideoFrame) string {
			let w = int(f.width)
			let h = int(f.height)
			let cw = (w + 1) / 2
			let ch = (h + 1) / 2
			let m = new hash.MD5()
			for let r = 0; r < h; r++ {
				m.write(f.y[r * f.yStride:r * f.yStride + w])
			}
			for let r = 0; r < ch; r++ {
				m.write(f.u[r * f.uvStride:r * f.uvStride + cw])
			}
			for let r = 0; r < ch; r++ {
				m.write(f.v[r * f.uvStride:r * f.uvStride + cw])
			}
			return m.hash().hex()
		}

		// Where each VOP starts in the stream; the headers before the first
		// belong to it.
		internal def m4Vops(data byte[]) int[] {
			let starts int[]
			for let i = 0; i + 3 < data.len(); i++ {
				starts.push(starts.len() == 0 ?? (0, i)) when data[i] == 0 && data[i + 1] == 0 && data[i + 2] == 1 && data[i + 3] == 0xB6
			}
			return starts
		}

		// Every frame of the stream, one packet per VOP as AVI stores them, or
		// the whole stream in one packet.
		internal def m4Decode(data byte[], whole bool = false) !VideoFrame[] {
			let dec VideoDecoder = new Mpeg4Part2()
			try dec.configure(Track{codec: "mpeg4"})
			let frames VideoFrame[]
			if whole {
				frames = try dec.decode(Packet{data: data})
			} else {
				let starts = m4Vops(data)
				for let i = 0; i < starts.len(); i++ {
					let end = i + 1 < starts.len() ?? (starts[i + 1], data.len())
					let got = try dec.decode(Packet{data: data[starts[i]:end]})
					frames = frames + got
				}
			}
			let rest = try dec.flush()
			return frames + rest
		}

		internal def m4Matches(frames VideoFrame[], hashes string[]) bool {
			return false when frames.len() != hashes.len()
			for let i = 0; i < frames.len(); i++ {
				return false when m4Hash(frames[i]) != hashes[i]
			}
			return true
		}

		@test()
		def TestSimpleProfileMatchesReference() !none {
			let frames = try m4Decode(m4Fixture(m4SimpleFixture))
			assert m4Matches(frames, m4SimpleHashes)
			assert frames[0].width == 64 && frames[0].height == 48
			assert frames[0].keyframe && !frames[1].keyframe
		}

		@test()
		def TestColourSignalling() !none {
			// A visual object header of its own: video_signal_type with full
			// range and matrix_coefficients 1 (BT.709).
			let header = byte[0, 0, 1, 0xB5, 0x0E, 0xE0, 0x20, 0x20, 0x2F]
			let frames = try m4Decode(header + m4Fixture(m4SimpleFixture))
			assert m4Matches(frames, m4SimpleHashes)
			assert frames[0].fullRange && frames[0].matrix == 709
			let plain = try m4Decode(m4Fixture(m4SimpleFixture))
			assert !plain[0].fullRange && plain[0].matrix == 601
		}

		@test()
		def TestElementaryStream() !none {
			let v = try open(m4Fixture(m4AdvancedFixture))
			assert v.info().container == "es" && v.info().codec == "mpeg4" && v.info().width == 64 && v.info().height == 48
			let stream = try v.frames()
			let frames VideoFrame[]
			for {
				let got = try stream.next()
				break when got is none
				let f VideoFrame = got
				frames.push(f)
			}
			assert m4Matches(frames, m4AdvancedHashes)
			try v.seek(200ms)
			let got = try stream.next()
			fail "no picture after the seek" when got is none
			let f VideoFrame = got
			assert f.time == 200ms && m4Hash(f) == m4AdvancedHashes[5]
		}

		@test()
		def TestSizeChange() !none {
			let v = try open(m4Fixture(m4ResizeFixture))
			let stream = try v.frames()
			let frames VideoFrame[]
			for {
				let got = try stream.next()
				break when got is none
				let f VideoFrame = got
				frames.push(f)
			}
			assert m4Matches(frames, m4ResizeHashes)
			assert frames[2].width == 64 && frames[3].width == 48 && frames[3].height == 32
			// The second layer's clock restarts; its pictures follow on.
			for let i = 1; i < frames.len(); i++ {
				assert frames[i].time > frames[i - 1].time
			}
		}

		@test()
		def TestAdvancedSimpleMatchesReference() !none {
			let frames = try m4Decode(m4Fixture(m4AdvancedFixture))
			assert m4Matches(frames, m4AdvancedHashes)
			// Display order, timed by the VOP time stamps at 25 Hz.
			for let i = 0; i < frames.len(); i++ {
				assert frames[i].time == duration(int64(i) * 40000000)
			}
		}

		@test()
		def TestVideoPacketsMatchReference() !none {
			let frames = try m4Decode(m4Fixture(m4ResyncFixture))
			assert m4Matches(frames, m4ResyncHashes)
		}

		@test()
		def TestXvidStreamMatchesReference() !none {
			let frames = try m4Decode(m4Fixture(m4XvidFixture))
			assert m4Matches(frames, m4XvidHashes)
		}

		@test()
		def TestPartialMacroblocksMatchReference() !none {
			let frames = try m4Decode(m4Fixture(m4OddFixture))
			assert m4Matches(frames, m4OddHashes)
			assert frames[0].width == 70 && frames[0].height == 50
		}

		@test()
		def TestInterlacedToolsMatchReference() !none {
			let frames = try m4Decode(m4Fixture(m4InterlacedFixture))
			assert m4Matches(frames, m4InterlacedHashes)
		}

		@test()
		def TestDataPartitioningMatchesReference() !none {
			let frames = try m4Decode(m4Fixture(m4PartitionedFixture))
			assert m4Matches(frames, m4PartitionedHashes)
		}

		@test()
		def TestGlobalMotionMatchesReference() !none {
			let frames = try m4Decode(m4Fixture(m4GlobalFixture))
			assert m4Matches(frames, m4GlobalHashes)
		}

		@test()
		def TestPackedVopsInOnePacket() !none {
			// DivX packed B-frames put a P and a B-VOP in one packet; here the
			// whole stream is one packet.
			let frames = try m4Decode(m4Fixture(m4AdvancedFixture), true)
			assert m4Matches(frames, m4AdvancedHashes)
		}

		@test()
		def TestUncodedVopShowsNothing() !none {
			let data = m4Fixture(m4SimpleFixture)
			let dec VideoDecoder = new Mpeg4Part2()
			try dec.configure(Track{codec: "mpeg4"})
			let starts = m4Vops(data)
			let first = try dec.decode(Packet{data: data[0:starts[1]]})
			// A P-VOP with vop_coded 0: type 01, no modulo time base, marker,
			// time increment 1 in 5 bits, marker, not coded, stuffing.
			let skip = try dec.decode(Packet{data: byte[0, 0, 1, 0xB6, 0x50, 0xCF]})
			assert skip.len() == 0
			let next = try dec.decode(Packet{data: data[starts[1]:starts[2]]})
			let rest = try dec.flush()
			assert first.len() + next.len() + rest.len() == 2
			assert m4Hash(rest[0]) == m4SimpleHashes[1]
		}

		@test()
		def TestGarbageDecodesToNothing() !none {
			let noise byte[]
			for let i = 0; i < 3000; i++ {
				noise.push(byte((i * 7919 + 13) & 255))
			}
			let dec VideoDecoder = new Mpeg4Part2()
			try dec.configure(Track{codec: "mpeg4"})
			let frames = try dec.decode(Packet{data: noise})
			assert frames.len() == 0
			// A stream cut in the middle of a VOP still yields pictures.
			let data = m4Fixture(m4SimpleFixture)
			let cut = try m4Decode(data[0:data.len() / 2], true)
			assert cut.len() > 0
		}
	}
}
