internal partial module std.formats.video.pes {
	use (
		std.formats.video::*
		std.formats.video.demux::*
		std.formats.media.source::*
	)

	// Packets read ahead while the streams are learnt, at most, and bytes.
	const psProbePackets = 128
	const psProbeBytes = 1024 * 1024

	// One elementary stream of a program or transport stream.
	type PesTrack {
		track Track
		// The stream id, 0x100 plus the substream for private stream 1;
		// the PID in a transport stream.
		key   int
		// The last timestamps, for packets that carry none.
		pts   int
		dts   int

		def new(track Track, key int) {
			self.track = track
			self.key = key
			pts = -1
			dts = -1
		}
	}

	// A PES packet read out of a stream, before its timestamps are made
	// relative to the stream's first.
	struct RawPes {
		track int
		data  byte[]
		pts   int
		dts   int
		key   bool
		// File offset to resume from to read this packet again.
		at    int
	}

	// The demultiplexer of an MPEG program stream.
	type PsContainer {
		src        Source
		parts      PesTrack[]
		list       Track[]
		byKey      map<int, int>
		held       RawPes[]
		heldAt     int
		// The 90 kHz time the stream starts at, and whether it is known.
		origin     int
		// Offset of the last pack header read.
		packAt     int
		// Non-video packets presenting before this time are dropped: a
		// seek target.
		dropBefore duration
		dropping   bool
		// A seek is probing the file: unknown streams are passed over.
		probing    bool

		def new(src Source) {
			self.src = src
			byKey = new map<int, int>()
			origin = -1
		}

		// Reads packets until every stream has shown itself.
		//
		// Fails when the stream holds no packet, or the reader fails.
		def read() !none {
			for held.len() < psProbePackets && src.position() < psProbeBytes {
				let got = try readPes()
				break when got is none
				let p RawPes = got
				held.push(p)
			}
			fail "mpeg: the stream holds no packets" when parts.len() == 0
			for let (_, p) in held {
				let t = p.dts >= 0 ?? (p.dts, p.pts)
				origin = t when t >= 0 && (origin < 0 || t < origin)
			}
			origin = 0 when origin < 0
			if src.seekable() && src.size() > 0 {
				let from = (src.size() - tailBytes).max(0)
				let last = lastPsTime(try src.bytesAt(from, src.size() - from))
				let total = last > origin ?? (ticks(last - origin, 90000), 0s)
				for let (_, t) in list {
					t.length = total
				}
			}
			return none
		}

		// The track of a stream id and its first payload, made on first
		// sight.
		def trackOf(id int, payload byte[]) int {
			let slot = byKey.get(id)
			return slot when !(slot is none)
			let kind = TrackKind.Data
			let probe = new StreamProbe("")
			if id >= 0xE0 && id <= 0xEF {
				kind = TrackKind.Video
				probe.codec = "mpeg2"
				probe.video(payload)
			} else if id >= 0xC0 && id <= 0xDF {
				kind = TrackKind.Audio
				probe.codec = "mp2"
				probe.audio(payload)
			} else if id >= 0x180 && id <= 0x187 {
				kind = TrackKind.Audio
				probe.codec = "ac3"
			} else if id >= 0x188 && id <= 0x18F {
				kind = TrackKind.Audio
				probe.codec = "dts"
			} else if id >= 0x1A0 && id <= 0x1A7 {
				kind = TrackKind.Audio
				probe.codec = "pcm_dvd"
			} else if id >= 0x120 && id <= 0x13F {
				kind = TrackKind.Subtitle
				probe.codec = "dvdsub"
			}
			let t = newTrack(parts.len(), kind, "")
			probe.apply(t)
			parts.push(new PesTrack(t, id))
			list.push(t)
			byKey.set(id, t.index)
			return t.index
		}

		// Reads units until the next PES packet of an elementary stream;
		// none at the end of the stream.
		//
		// Fails when the reader does.
		def readPes() !?RawPes {
			for {
				let at = src.position()
				let head = try src.peek(14)
				return none when head.len() < 4
				if be(head, 0, 3) != 1 {
					try src.skip(1)
					continue
				}
				let code = int(head[3])
				if code == 0xBA {
					packAt = at
					let mpeg2 = head.len() >= 14 && int(head[4]) & 0xC0 == 0x40
					let size = mpeg2 ?? (14 + (int(head[13]) & 7), 12)
					try src.skip(size)
					continue
				}
				if code == 0xB9 || code < 0xB9 {
					try src.skip(4)
					continue
				}
				return none when head.len() < 6
				let length = be(head, 4, 2)
				if !pesHasHeader(code) {
					try src.skip(6 + length)
					continue
				}
				let packet = try src.read(6 + length)
				let found = pesHeader(packet, 0)
				continue when found is none
				let h PesHeader = found
				continue when h.size > packet.len()
				let payload = packet[h.size:]
				let key = code
				if code == 0xBD {
					continue when payload.len() == 0
					let sub = int(payload[0])
					key = 0x100 + sub
					let skip = 1
					skip = 4 when sub >= 0x80 && sub <= 0x8F
					skip = 7 when sub >= 0xA0 && sub <= 0xA7
					continue when payload.len() <= skip
					payload = payload[skip:]
				}
				// A probe resyncing mid-file may meet a start code inside a
				// payload: it never makes new streams.
				continue when probing && byKey.get(key) is none
				let index = trackOf(key, payload)
				let part = parts[index]
				let data = payload.clone()
				let isKey = part.track.kind != TrackKind.Video || isKeyPayload(part.track.codec, data)
				return RawPes{track: index, data: data, pts: h.pts, dts: h.dts, key: isKey, at: packAt}
			}
			return none
		}

		// The packet with its timestamps counted from the stream's start;
		// one without timestamps takes its track's last.
		def stamp(p RawPes) Packet {
			let part = parts[p.track]
			if p.pts >= 0 {
				part.pts = p.pts
				part.dts = p.dts >= 0 ?? (p.dts, p.pts)
			}
			let pts = part.pts < 0 ?? (0s, ticks(part.pts - origin, 90000))
			let dts = part.dts < 0 ?? (pts, ticks(part.dts - origin, 90000))
			return newPacket(p.track, p.data, pts, dts, 0s, p.key)
		}

		// name implements Described.
		def name() string {
			return "mpeg"
		}

		// seekable implements Seekable.
		def seekable() bool {
			return src.seekable()
		}

		// tracks implements Container.
		def tracks() Track[] {
			return list
		}

		// next implements Container.
		//
		// Fails when the reader does.
		def next() !?Packet {
			for {
				let raw = try pull()
				return none when raw is none
				let r RawPes = raw
				let p = stamp(r)
				continue when dropping && list[p.track].kind != TrackKind.Video && p.pts < dropBefore
				return p
			}
			return none
		}

		// The next packet read ahead, else the next in the stream.
		//
		// Fails when the reader does.
		def pull() !?RawPes {
			return readPes() when heldAt >= held.len()
			let p = held[heldAt]
			heldAt++
			return p
		}

		// seek implements Container: finds the last video keyframe at or
		// before `time` (bisecting on byte offsets in large files, then
		// reading packet headers forward), resumes at its pack, and drops the
		// other streams' packets that present before it.
		//
		// Fails when the source cannot seek or the reader fails.
		def seek(time duration) !none {
			fail "mpeg: the stream cannot seek" unless src.seekable()
			let main = -1
			for let (i, t) in list {
				if t.kind == TrackKind.Video {
					main = i
					break
				}
			}
			let from = 0
			if src.size() > seekScanBytes {
				from = try bisectSeek(src.size(), time, (at int, limit int) => probeKey(at, limit, main))
			}
			held = RawPes[]
			heldAt = 0
			try src.seek(from)
			packAt = from
			let pick = from
			let pickTime = 0s
			for {
				let got = try readPes()
				break when got is none
				let p RawPes = got
				continue unless p.track == main || main < 0
				continue unless p.key && p.pts >= 0
				let t = ticks(p.pts - origin, 90000)
				break when t > time
				pick = p.at
				pickTime = t
			}
			for let (_, part) in parts {
				part.pts = -1
				part.dts = -1
			}
			try src.seek(pick)
			dropBefore = pickTime
			dropping = pickTime > 0s
			return none
		}

		// The first keyframe of track `main` (any timed packet when it is
		// -1) from the first pack header at or after `from`, reading no
		// further than `limit`. Streams not seen yet are passed over.
		//
		// Fails when the reader does.
		def probeKey(from int, limit int, main int) !KeyProbe {
			let missing = KeyProbe{found: false, time: 0s, at: 0}
			held = RawPes[]
			heldAt = 0
			try src.seek(from)
			for {
				return missing when src.position() >= limit
				let head = try src.peek(4)
				return missing when head.len() < 4
				break when be(head, 0, 4) == 0x1BA
				try src.skip(1)
			}
			packAt = src.position()
			probing = true
			let key = scanKey(limit, main) onerror (err error) {
				probing = false
				fail err
			}
			probing = false
			return key
		}

		// The first keyframe of track `main` before `limit`, reading on
		// from here.
		//
		// Fails when the reader does.
		def scanKey(limit int, main int) !KeyProbe {
			for src.position() < limit {
				let got = try readPes()
				break when got is none
				let p RawPes = got
				continue unless p.track == main || main < 0
				continue unless p.key && p.pts >= 0
				return KeyProbe{found: true, time: ticks(p.pts - origin, 90000), at: p.at}
			}
			return KeyProbe{found: false, time: 0s, at: 0}
		}

		// close implements io.Closer: closes the file.
		//
		// Fails when closing it does.
		def close() !none {
			return src.close()
		}
	}
}
