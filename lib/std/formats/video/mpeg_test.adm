partial module std.formats.video {
	use (
		std.testing
		std.bytes
		std.data.encoding
		std.formats.video.demux::*
	)

	check "MPEG" {
		@test()
		def TestSeekBisection() !none {
			// A 100 MB file with a keyframe every 300 KB, 0.5 s apart, the
			// first at 1000: the offset handed to the forward scan lies at
			// or before the last keyframe not after the target, within the
			// scan window of it.
			let size = 100 * 1024 * 1024
			let step = 300 * 1024
			let probes = 0
			let probe = def (from int, limit int) !KeyProbe {
				probes++
				let k = from <= 1000 ?? (0, (from - 1000 + step - 1) / step)
				let at = 1000 + k * step
				return KeyProbe{found: false, time: 0s, at: 0} when at >= limit
				return KeyProbe{found: true, time: duration(int64(k) * 500000000), at: at}
			}
			for let target in int[0, 7, 100, 170, 999] {
				let time = duration(int64(target) * 100000000)
				let want = 1000 + (target / 5).min((size - 1000 - 1) / step) * step
				let from = try bisectSeek(size, time, probe)
				assert from <= want
				assert want - from <= (1 << 20) + step
			}
			assert probes < 100
		}

		@test()
		def TestPsTracks() !none {
			let c = try new MPEG().open(new bytes.Reader(tinyMpg()))
			let tracks = c.tracks()
			assert tracks.len() == 2
			assert tracks[0].kind == TrackKind.Video && tracks[0].codec == "mpeg2"
			assert tracks[0].width == 64 && tracks[0].height == 48
			assert tracks[0].frameRate.numerator == 25 && tracks[0].frameRate.denominator == 1
			assert tracks[1].kind == TrackKind.Audio && tracks[1].codec == "mp2"
			assert tracks[1].sampleRate == 32000 && tracks[1].channels == 1
		}

		@test()
		def TestPsPackets() !none {
			let c = try new MPEG().open(new bytes.Reader(tinyMpg()))
			try testing.expectEqual("", try comparePackets(c, tinyMpgPackets()))
		}

		@test()
		def TestVobPackets() !none {
			let c = try new MPEG().open(new bytes.Reader(tinyVob()))
			let tracks = c.tracks()
			assert tracks.len() == 2
			assert tracks[0].codec == "mpeg2" && tracks[0].width == 32
			assert tracks[1].codec == "ac3"
			try testing.expectEqual("", try comparePackets(c, tinyVobPackets()))
		}

		@test()
		def TestVobSeek() !none {
			let c = try new MPEG().open(new bytes.Reader(tinyVob()))
			try c.seek(700ms)
			let p = try c.next()
			fail "no packet after the seek" when p is none
			let first Packet = p
			assert first.track == 0 && first.keyframe && int64(first.pts) <= 700000000
		}

		@test()
		def TestTsTracks() !none {
			let c = try new TS().open(new bytes.Reader(tinyTs()))
			let tracks = c.tracks()
			assert tracks.len() == 2
			assert tracks[0].kind == TrackKind.Video && tracks[0].codec == "h264"
			assert tracks[0].config.len() == 0
			// TS declares no picture size: it comes from the first SPS.
			assert tracks[0].width == 64 && tracks[0].height == 48
			assert tracks[1].kind == TrackKind.Audio && tracks[1].codec == "aac"
			assert tracks[1].sampleRate == 8000 && tracks[1].channels == 1
		}

		@test()
		def TestTsPackets() !none {
			let c = try new TS().open(new bytes.Reader(tinyTs()))
			try testing.expectEqual("", try comparePackets(c, tinyTsPackets()))
		}

		// AC-3 in a transport stream: the sound says its rate and channels
		// when it is opened, before anything is read, and the pictures
		// asked for after it still come (from the next keyframe on).
		@test()
		def TestTsSoundLearnsItsFormat() !none {
			let v = try open(tinyAc3Ts())
			let sound = try v.audio()
			assert !(sound is none)
			if !(sound is none) {
				let info = sound.info()
				assert info.sampleRate == 48000 && info.channels == 2 && info.codec == "ac3"
				assert info.frames > 0
				let buf float32[]
				buf.len(1536 * 2)
				assert (try sound.read(buf)) == 1536
			}
			let pictures = try v.frames()
			let first = try pictures.next()
			assert !(first is none)
			try v.close()
		}

		@test()
		def TestTsSound() !none {
			let (frames, peak) = try soundOf(tinyTs())
			// Nine ADTS frames of 1024.
			try testing.expectEqual(9216, frames)
			assert peak > 0.1 && peak < 0.2
		}
	}

