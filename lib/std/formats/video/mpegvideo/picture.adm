internal partial module std.formats.video.mpegvideo {
	use std.formats.video::*

	// One decoded picture in macroblock-aligned planes, with what its display
	// needs.
	type MpegPicture {
		y            byte[]
		u            byte[]
		v            byte[]
		// Plane widths (the strides) and heights, whole macroblocks.
		stride       int
		cstride      int
		lines        int
		clines       int
		// chroma_format: 1 for 4:2:0, 2 for 4:2:2, 3 for 4:4:4.
		chromaFormat int
		// The visible size, which a frame of the picture carries even when
		// the stream has changed size before it is shown.
		width        int
		height       int
		time         duration
		length       duration
		keyframe     bool
		// Whether `time` came from the stream rather than being estimated.
		timed        bool
		// The GPU picture buffer the picture decodes into, -1 when it
		// decodes in software.
		surface      int      = -1

		// A picture of `width` x `height` in chroma format `format`; its
		// planes stay empty without `planes` (the GPU decodes it).
		def new(width int, height int, format int = 1, planes bool = true) {
			chromaFormat = format
			self.width = width
			self.height = height
			stride = width
			cstride = format == 3 ?? (width, width >> 1)
			lines = height
			clines = format == 1 ?? (height >> 1, height)
			return unless planes
			y.len(stride * lines)
			u.len(cstride * clines)
			v.len(cstride * clines)
		}

		// A frame of the picture; the planes are copied when `copy`, so the
		// frame's owner may change them.
		def frame(matrix int, copy bool, fullRange bool = false) VideoFrame {
			let fy = y
			let fu = u
			let fv = v
			if copy {
				fy = byte[]
				fy.len(y.len())
				y.copy(fy)
				fu = byte[]
				fu.len(u.len())
				u.copy(fu)
				fv = byte[]
				fv.len(v.len())
				v.copy(fv)
			}
			return VideoFrame{
				width:     uint32(width),
				height:    uint32(height),
				y:         fy,
				u:         fu,
				v:         fv,
				yStride:   stride,
				uvStride:  cstride,
				time:      time,
				length:    length,
				keyframe:  keyframe,
				matrix:    matrix,
				fullRange: fullRange,
				chroma:    chromaFormat == 3 ?? (ChromaLayout.Yuv444, chromaFormat == 2 ?? (ChromaLayout.Yuv422, ChromaLayout.Yuv420))
			}
		}
	}

	// Scratch for predictions that reach outside the reference plane: the
	// block with its edge pixels repeated.
	type MpegEdge {
		buf byte[]

		def new() {
			buf.len(32 * 32)
		}
	}

	// Predicts the `w` x `h` block at `dAt` in `dst` (lines `dStride` apart)
	// from the reference plane `src`, whose line `l` starts at
	// `sBase + l * sStride` and which is `pw` x `ph` pixels. The block's top
	// left is at whole pixel (`x`, `y`) plus half a pixel right when bit 0 of
	// `dxy` is set and half down when bit 1 is. Half positions round up, or
	// down when `rnd` is 1; the prediction is averaged into `dst`, rounding
	// up, when `avg`. Pixels outside the plane repeat its edge.
	def mpegPredict(dst byte[], dAt int, dStride int, src byte[], sBase int, sStride int, pw int, ph int, x int, y int, dxy int, w int, h int, avg bool, rnd int, edge MpegEdge) {
		let ex = dxy & 1
		let ey = dxy >> 1
		if x >= 0 && y >= 0 && x + w + ex <= pw && y + h + ey <= ph {
			mpegHalfPel(dst, dAt, dStride, src, sBase + y * sStride + x, sStride, dxy, w, h, avg, rnd)
			return
		}
		let bw = w + 1
		let e = edge.buf
		for let j = 0; j <= h; j++ {
			let sy = (y + j).max(0).min(ph - 1)
			let row = sBase + sy * sStride
			for let i = 0; i <= w; i++ {
				let sx = (x + i).max(0).min(pw - 1)
				e[j * bw + i] = src[row + sx]
			}
		}
		mpegHalfPel(dst, dAt, dStride, e, 0, bw, dxy, w, h, avg, rnd)
	}

	// The half-pel interpolation of `mpegPredict` for a block inside `src`,
	// its top left at `sAt`.
	def mpegHalfPel(dst byte[], dAt int, dStride int, src byte[], sAt int, sStride int, dxy int, w int, h int, avg bool, rnd int) {
		let d = dAt
		let s = sAt
		if dxy == 0 {
			for let j = 0; j < h; j++ {
				if avg {
					for let i = 0; i < w; i++ {
						dst[d + i] = byte((int(dst[d + i]) + int(src[s + i]) + 1) >> 1)
					}
				} else {
					for let i = 0; i < w; i++ {
						dst[d + i] = src[s + i]
					}
				}
				d += dStride
				s += sStride
			}
		} else if dxy == 1 {
			let r = 1 - rnd
			for let j = 0; j < h; j++ {
				for let i = 0; i < w; i++ {
					let p = (int(src[s + i]) + int(src[s + i + 1]) + r) >> 1
					p = (int(dst[d + i]) + p + 1) >> 1 when avg
					dst[d + i] = byte(p)
				}
				d += dStride
				s += sStride
			}
		} else if dxy == 2 {
			let r = 1 - rnd
			for let j = 0; j < h; j++ {
				for let i = 0; i < w; i++ {
					let p = (int(src[s + i]) + int(src[s + i + sStride]) + r) >> 1
					p = (int(dst[d + i]) + p + 1) >> 1 when avg
					dst[d + i] = byte(p)
				}
				d += dStride
				s += sStride
			}
		} else {
			let r = 2 - rnd
			for let j = 0; j < h; j++ {
				for let i = 0; i < w; i++ {
					let t = s + i
					let p = (int(src[t]) + int(src[t + 1]) + int(src[t + sStride]) + int(src[t + sStride + 1]) + r) >> 2
					p = (int(dst[d + i]) + p + 1) >> 1 when avg
					dst[d + i] = byte(p)
				}
				d += dStride
				s += sStride
			}
		}
	}
}
