internal partial module std.formats.video.mpegvideo {
	// Reads bits most significant first from part of a byte array. Reading
	// past the end yields zero bits, never a fault, so damaged data decodes
	// to garbage rather than stopping the program.
	type MpegBits {
		data byte[]
		// Position in bits from the start of `data`.
		pos  int
		// Byte offset where the readable part ends.
		end  int

		def new() {}

		// Points the reader at `source[start:end]`.
		def reset(source byte[], start int, end int) {
			data = source
			pos = start * 8
			self.end = end
		}

		// The next `n` bits (at most 25) without consuming them.
		def peek(n int) int {
			let at = pos >> 3
			return slowPeek(n) when at + 3 >= end
			let word = (int(data[at]) << 24) | (int(data[at + 1]) << 16) | (int(data[at + 2]) << 8) | int(data[at + 3])
			return (word >> (32 - (pos & 7) - n)) & ((1 << n) - 1)
		}

		// `peek` near the end, where missing bytes read as zero.
		def slowPeek(n int) int {
			let at = pos >> 3
			let word = 0
			for let i = 0; i < 4; i++ {
				word = word << 8
				word = word | int(data[at + i]) when at + i >= 0 && at + i < end
			}
			return (word >> (32 - (pos & 7) - n)) & ((1 << n) - 1)
		}

		// Reads `n` bits (at most 25).
		def read(n int) int {
			return 0 when n <= 0
			let v = peek(n)
			pos += n
			return v
		}

		// Reads `n` bits (at most 25) as a two's complement number.
		def signed(n int) int {
			let v = read(n)
			return v - (1 << n) when v >= 1 << (n - 1)
			return v
		}

		// Reads one bit.
		def bit() int {
			let at = pos >> 3
			let v = 0
			v = (int(data[at]) >> (7 - (pos & 7))) & 1 when at < end
			pos++
			return v
		}

		// Reads one bit as a flag.
		def flag() bool {
			return bit() == 1
		}

		// Steps over `n` bits.
		def skip(n int) {
			pos += n
		}

		// Moves to the next byte boundary.
		def align() {
			pos = (pos + 7) & (0 - 8)
		}

		// Bits left before the end.
		def left() int {
			return end * 8 - pos
		}

		// Decodes one code of `table`; its symbol, or `table.invalid` for a
		// bit pattern the table does not hold, which consumes nothing.
		def vlc(table MpegVlc) int {
			let idx = peek(table.bits)
			let l = table.lens[idx]
			if l < 0 {
				pos += table.bits
				idx = table.syms[idx] + peek(0 - l)
				l = table.lens[idx]
			}
			pos += l
			return table.syms[idx]
		}
	}

	// A two-level lookup table for a prefix code: the first `bits` bits index
	// the root, codes longer than that continue in a subtable.
	type MpegVlc {
		bits    int
		// Per entry: the code length still to consume, or minus the subtable
		// width when the entry points at a subtable.
		lens    int[]
		// Per entry: the symbol, or the subtable start.
		syms    int[]
		// Symbol of a bit pattern no code starts with.
		invalid int

		// Builds the table of the codes `codes[i]` of `lengths[i]` bits
		// standing for `symbols[i]`.
		def new(codes int[], lengths int[], symbols int[], bits int, invalid int = -1000000) {
			self.bits = bits
			self.invalid = invalid
			let size = 1 << bits
			lens.len(size)
			syms.len(size)
			for let i = 0; i < size; i++ {
				syms[i] = invalid
			}
			// Width of the subtable under each root entry.
			let subBits int[]
			subBits.len(size)
			for let i = 0; i < codes.len(); i++ {
				let l = lengths[i]
				if l <= bits {
					let first = codes[i] << (bits - l)
					for let j = 0; j < 1 << (bits - l); j++ {
						lens[first + j] = l
						syms[first + j] = symbols[i]
					}
				} else {
					let root = codes[i] >> (l - bits)
					subBits[root] = subBits[root].max(l - bits)
				}
			}
			for let r = 0; r < size; r++ {
				continue when subBits[r] == 0
				let start = lens.len()
				let width = subBits[r]
				lens.len(start + (1 << width))
				syms.len(start + (1 << width))
				for let j = 0; j < 1 << width; j++ {
					syms[start + j] = invalid
				}
				lens[r] = 0 - width
				syms[r] = start
			}
			for let i = 0; i < codes.len(); i++ {
				let l = lengths[i]
				continue when l <= bits
				let root = codes[i] >> (l - bits)
				let width = subBits[root]
				let rest = l - bits
				let sub = codes[i] & ((1 << rest) - 1)
				let first = syms[root] + (sub << (width - rest))
				for let j = 0; j < 1 << (width - rest); j++ {
					lens[first + j] = rest
					syms[first + j] = symbols[i]
				}
			}
		}
	}

	// The position after the next start code prefix (00 00 01) at or after
	// `from` and before `end`, or -1 when there is none.
	def mpegNextStartCode(data byte[], from int, end int) int {
		let i = from
		for i + 2 < end {
			let b = data[i + 2]
			if b > 1 {
				i += 3
			} else if b == 0 {
				i++
			} else if data[i] == 0 && data[i + 1] == 0 {
				return i + 3
			} else {
				i += 3
			}
		}
		return -1
	}
}
