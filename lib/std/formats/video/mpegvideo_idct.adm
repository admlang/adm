internal partial module std.formats.video.mpegvideo {
	// The 8x8 inverse DCT of MPEG video in 16-bit fixed point, accurate to
	// IEEE 1180: rows at 11 fractional bits, columns at 20, a row holding only
	// its DC term shortcut to DC * 8.

	const idctW1 = 22725
	const idctW2 = 21407
	const idctW3 = 19266
	const idctW4 = 16383
	const idctW5 = 12873
	const idctW6 = 8867
	const idctW7 = 4520
	// Rounding of the column pass: half of 1 << 20 in whole multiples of W4.
	const idctColRound = 524256

	// Transforms the rows of the 64 coefficients of `b` in place.
	def idctRows(b int[]) {
		for let r = 0; r < 64; r += 8 {
			let x1 = b[r + 1]
			let x2 = b[r + 2]
			let x3 = b[r + 3]
			let x4 = b[r + 4]
			let x5 = b[r + 5]
			let x6 = b[r + 6]
			let x7 = b[r + 7]
			if (x1 | x2 | x3 | x4 | x5 | x6 | x7) == 0 {
				let dc = (((b[r] << 3) & 0xFFFF) ^ 0x8000) - 0x8000
				b[r] = dc
				b[r + 1] = dc
				b[r + 2] = dc
				b[r + 3] = dc
				b[r + 4] = dc
				b[r + 5] = dc
				b[r + 6] = dc
				b[r + 7] = dc
				continue
			}
			let a0 = idctW4 * b[r] + 1024
			let a1 = a0 + idctW6 * x2
			let a2 = a0 - idctW6 * x2
			let a3 = a0 - idctW2 * x2
			a0 += idctW2 * x2
			let b0 = idctW1 * x1 + idctW3 * x3
			let b1 = idctW3 * x1 - idctW7 * x3
			let b2 = idctW5 * x1 - idctW1 * x3
			let b3 = idctW7 * x1 - idctW5 * x3
			if (x4 | x5 | x6 | x7) != 0 {
				a0 += idctW4 * x4 + idctW6 * x6
				a1 += 0 - idctW4 * x4 - idctW2 * x6
				a2 += idctW2 * x6 - idctW4 * x4
				a3 += idctW4 * x4 - idctW6 * x6
				b0 += idctW5 * x5 + idctW7 * x7
				b1 += 0 - idctW1 * x5 - idctW5 * x7
				b2 += idctW7 * x5 + idctW3 * x7
				b3 += idctW3 * x5 - idctW1 * x7
			}
			b[r] = (a0 + b0) >> 11
			b[r + 7] = (a0 - b0) >> 11
			b[r + 1] = (a1 + b1) >> 11
			b[r + 6] = (a1 - b1) >> 11
			b[r + 2] = (a2 + b2) >> 11
			b[r + 5] = (a2 - b2) >> 11
			b[r + 3] = (a3 + b3) >> 11
			b[r + 4] = (a3 - b3) >> 11
		}
	}

	// The inverse DCT of the coefficients of `b` (destroyed) written to the
	// 8x8 pixels of `dst` at `at`, `stride` apart; added to them when `add`.
	def idctPut(b int[], dst byte[], at int, stride int, add bool) {
		idctRows(b)
		for let c = 0; c < 8; c++ {
			let x0 = b[c]
			let x1 = b[c + 8]
			let x2 = b[c + 16]
			let x3 = b[c + 24]
			let x4 = b[c + 32]
			let x5 = b[c + 40]
			let x6 = b[c + 48]
			let x7 = b[c + 56]
			let a0 = idctW4 * x0 + idctColRound
			let a1 = a0 + idctW6 * x2 - idctW4 * x4 - idctW2 * x6
			let a2 = a0 - idctW6 * x2 - idctW4 * x4 + idctW2 * x6
			let a3 = a0 - idctW2 * x2 + idctW4 * x4 - idctW6 * x6
			a0 += idctW2 * x2 + idctW4 * x4 + idctW6 * x6
			let b0 = idctW1 * x1 + idctW3 * x3 + idctW5 * x5 + idctW7 * x7
			let b1 = idctW3 * x1 - idctW7 * x3 - idctW1 * x5 - idctW5 * x7
			let b2 = idctW5 * x1 - idctW1 * x3 + idctW7 * x5 + idctW3 * x7
			let b3 = idctW7 * x1 - idctW5 * x3 + idctW3 * x5 - idctW1 * x7
			let o = at + c
			if add {
				dst[o] = mpegClip(int(dst[o]) + ((a0 + b0) >> 20))
				dst[o + stride] = mpegClip(int(dst[o + stride]) + ((a1 + b1) >> 20))
				dst[o + 2 * stride] = mpegClip(int(dst[o + 2 * stride]) + ((a2 + b2) >> 20))
				dst[o + 3 * stride] = mpegClip(int(dst[o + 3 * stride]) + ((a3 + b3) >> 20))
				dst[o + 4 * stride] = mpegClip(int(dst[o + 4 * stride]) + ((a3 - b3) >> 20))
				dst[o + 5 * stride] = mpegClip(int(dst[o + 5 * stride]) + ((a2 - b2) >> 20))
				dst[o + 6 * stride] = mpegClip(int(dst[o + 6 * stride]) + ((a1 - b1) >> 20))
				dst[o + 7 * stride] = mpegClip(int(dst[o + 7 * stride]) + ((a0 - b0) >> 20))
			} else {
				dst[o] = mpegClip((a0 + b0) >> 20)
				dst[o + stride] = mpegClip((a1 + b1) >> 20)
				dst[o + 2 * stride] = mpegClip((a2 + b2) >> 20)
				dst[o + 3 * stride] = mpegClip((a3 + b3) >> 20)
				dst[o + 4 * stride] = mpegClip((a3 - b3) >> 20)
				dst[o + 5 * stride] = mpegClip((a2 - b2) >> 20)
				dst[o + 6 * stride] = mpegClip((a1 - b1) >> 20)
				dst[o + 7 * stride] = mpegClip((a0 - b0) >> 20)
			}
		}
	}

	// `v` clamped to a pixel value.
	def mpegClip(v int) byte {
		return byte(0) when v < 0
		return byte(255) when v > 255
		return byte(v)
	}
}
