partial module std.formats.video {
	use std.formats.video.mpeg4::*

	// Msmpeg4v2 decodes Microsoft MPEG-4 version 2 video (FourCC MP42), found
	// in older AVI and WMV files: I and P pictures with H.263 motion and
	// quantisation, each packet one picture. The picture size comes from the
	// track, since the stream carries none.
	@decoder("msmpeg4v2")
	type Msmpeg4v2 {
		internal decoder Mpeg4Decoder

		def new() {
			decoder = new Mpeg4Decoder()
		}

		// configure prepares for the track's picture size. Fails when the
		// track has no size.
		def configure(track Track) !none {
			expects {
				assert track.width != 0 && track.height != 0 onerror fail "msmpeg4v2: the track has no picture size"
			}
			decoder.reset()
			decoder.startMs(int(track.width), int(track.height))
		}

		// decode decodes the picture in the packet; an empty packet repeats
		// the previous one and yields nothing. Does not fail: damaged data
		// decodes to damaged pictures.
		def decode(packet Packet) !VideoFrame[] {
			return decoder.feed(packet.data, packet.pts)
		}

		// flush returns nothing: every picture is handed out as it is
		// decoded. Does not fail.
		def flush() !VideoFrame[] {
			return VideoFrame[]
		}
	}
}
