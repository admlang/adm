		internal const msfix2Lengths = int[2234, 235, 144, 158, 158, 180]
		// Plane hashes of each frame from `ffmpeg -threads 1 -cpuflags 0 -f framemd5`.
		internal const msfix2Hashes = string[
			"4E0115376126DA8B3F8D9EF58027667D",
			"4AF6A363CA29A5D98BAF0609D1289224",
			"F071BB0291E1DF9ABACEA113738C0368",
			"058EA78381D2019ED0395BB57A2D9621",
			"71DEBA625D1AAA25587020828BECC47C",
			"B8AC2CED014599BF0917C4ED3E9F14C7"
		]

		// The MD5 of the frame's visible planes, Y then U then V, as
		// `ffmpeg -f framemd5` computes it.
		internal def msHash(f VideoFrame) string {
			let w = int(f.width)
			let h = int(f.height)
			let cw = (w + 1) / 2
			let ch = (h + 1) / 2
			let m = new hash.MD5()
			for let r = 0; r < h; r++ {
				m.write(f.y[r * f.yStride:r * f.yStride + w])
			}
			for let r = 0; r < ch; r++ {
				m.write(f.u[r * f.uvStride:r * f.uvStride + cw])
			}
			for let r = 0; r < ch; r++ {
				m.write(f.v[r * f.uvStride:r * f.uvStride + cw])
			}
			return m.hash().hex()
		}

		// Every frame of the packets, 40 ms apart.
		internal def msDecode(text string, lengths int[], w int, h int) !VideoFrame[] {
			let data = encoding.base64decode(text) onerror recover byte[]
			let dec VideoDecoder = new Msmpeg4v2()
			try dec.configure(Track{codec: "msmpeg4v2", width: uint32(w), height: uint32(h)})
			let frames VideoFrame[]
			let at = 0
			for let i = 0; i < lengths.len(); i++ {
				let got = try dec.decode(Packet{data: data[at:at + lengths[i]], pts: duration(int64(i) * 40000000)})
				frames = frames + got
				at += lengths[i]
			}
			let rest = try dec.flush()
			return frames + rest
		}

		internal def msMatches(frames VideoFrame[], hashes string[]) bool {
			return false when frames.len() != hashes.len()
			for let i = 0; i < frames.len(); i++ {
				return false when msHash(frames[i]) != hashes[i]
			}
			return true
		}

		@test()
		def TestMsmpeg4v2MatchesReference() !none {
			let frames = try msDecode(msfixPackets, msfixLengths, 64, 48)
			assert msMatches(frames, msfixHashes)
			assert frames[0].keyframe && !frames[1].keyframe
			assert frames[3].time == 120ms
		}

		@test()
		def TestMsmpeg4v2PartialMacroblocks() !none {
			let frames = try msDecode(msfix2Packets, msfix2Lengths, 72, 40)
			assert msMatches(frames, msfix2Hashes)
			assert frames[0].width == 72 && frames[0].height == 40
		}

		@test()
		def TestMsmpeg4v2NeedsTheSize() !none {
			let dec VideoDecoder = new Msmpeg4v2()
			let failed = false
			dec.configure(Track{codec: "msmpeg4v2"}) onerror (err error) {
				failed = true
				recover none
			}
			assert failed
			// An empty packet and garbage yield nothing.
			let ok VideoDecoder = new Msmpeg4v2()
			try ok.configure(Track{codec: "msmpeg4v2", width: 64, height: 48})
			assert (try ok.decode(Packet{data: byte[]})).len() == 0
			assert (try ok.decode(Packet{data: byte[0xFF, 0xFF, 0xFF, 0xFF]})).len() == 0
		}
	}
}
