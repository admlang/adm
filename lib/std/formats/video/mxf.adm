partial module std.formats.video {
	use (
		std.io
		std.formats.video.demux::*
		std.formats.video.media.source::*
		std.formats.video.mxf::*
	)

	// MXF (Material eXchange Format, SMPTE ST 377) is the KLV container of
	// broadcast cameras and editing systems: XDCAM, XAVC, D-10, Avid and
	// OP-Atom files. The tracks are the material package's, resolved to
	// their file package and essence descriptor; packets are the
	// frame-wrapped essence elements, and clip-wrapped essence cut into
	// edit units. Seeking uses the index table segments, and without them
	// reads forward from the start.
	@codec("MXF")
	type MXF {
		mimeType string[] {
			def get() string[] {
				return string["application/mxf"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".mxf"]
			}
		}

		// matchSignature reports whether a header partition pack starts
		// within the file's first 64 KB (the run-in before it).
		def matchSignature(r io.Reader) bool {
			let head byte[]
			head.len(mxfRunIn + 16)
			let n = io.readFull(r, head) onerror recover 0
			return mxfFindHeader(head[0:n]) >= 0
		}

		// open reads the header metadata and, when the reader can seek, the
		// metadata and index tables of the other partitions.
		//
		// Fails when the file is not MXF, it has no material package, or
		// the reader fails.
		def open(reader io.Reader) !Container {
			let c = new MxfContainer(new Source(reader))
			try c.read()
			return c
		}
	}
}
