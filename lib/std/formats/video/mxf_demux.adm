internal partial module std.formats.video.mxf {
	use (
		std.formats.video::*
		std.formats.video.demux::*
		std.formats.video.pes::*
		std.formats.video.elementary::(esStartsPicture, esStartsUnit)
		std.formats.video.media.source::*
	)

	// Bytes before the header partition pack a file may carry (SMPTE ST
	// 377 run-in).
	const mxfRunIn = 65536

	// Bytes a clip-wrapped track's KLV is cut into when nothing says where
	// its edit units end.
	const mxfChunk = 1 << 20

	// The prefix every SMPTE universal label starts with.
	const mxfLabel = int[0x06, 0x0E, 0x2B, 0x34]

	// Kinds of KLV packets the demultiplexer tells apart, from the key.
	const (
		mxfOther     = 0
		mxfPartition = 1
		mxfPrimer    = 2
		mxfSet       = 3
		mxfIndex     = 4
		mxfEssence   = 5
		mxfRip       = 6
	)

	// Header metadata set types: byte 13 and 14 of the set's key.
	const (
		mxfPreface         = 0x012F
		mxfContentStorage  = 0x0118
		mxfEcData          = 0x0123
		mxfMaterialPackage = 0x0136
		mxfSourcePackage   = 0x0137
		mxfStaticTrack     = 0x013A
		mxfTimelineTrack   = 0x013B
		mxfEventTrack      = 0x0139
		mxfSequence        = 0x010F
		mxfSourceClip      = 0x0111
		mxfEssenceGroup    = 0x0105
		mxfMultiple        = 0x0144
	)

	// Where the header partition pack starts in `data`, -1 when no key
	// starts within the run-in.
	def mxfFindHeader(data byte[]) int {
		for let i = 0; i + 14 <= data.len() && i <= mxfRunIn; i++ {
			continue unless data[i] == 0x06 && data[i + 1] == 0x0E && data[i + 2] == 0x2B && data[i + 3] == 0x34
			return i when mxfMatch(data, i, int[0x06, 0x0E, 0x2B, 0x34, 0x02, 0x05, 0x01, 0x01, 0x0D, 0x01, 0x02, 0x01, 0x01, 0x02], 14)
		}
		return -1
	}

	// Whether `data` from `at` starts with the first `count` bytes of
	// `label`, the version byte (7) aside, as labels are compared.
	def mxfMatch(data byte[], at int, label int[], count int) bool {
		return false when at + count > data.len() || label.len() < count
		for let i = 0; i < count; i++ {
			continue when i == 7
			return false when int(data[at + i]) != label[i]
		}
		return true
	}

	// The kind of the KLV packet whose key is `key`.
	def mxfKind(key byte[]) int {
		return mxfOther unless mxfMatch(key, 0, mxfLabel, 4)
		let k4 = int(key[4])
		if k4 == 0x02 && key[5] == 0x05 && key[8] == 0x0D && key[9] == 0x01 && key[10] == 0x02 && key[11] == 0x01 && key[12] == 0x01 {
			return mxfPartition when int(key[13]) := 2 || 3 || 4
			return mxfPrimer when key[13] == 0x05 && key[14] == 0x01
			return mxfRip when key[13] == 0x11
		}
		if k4 == 0x02 && key[5] == 0x53 && key[8] == 0x0D && key[9] == 0x01 {
			return mxfIndex when key[10] == 0x02 && key[11] == 0x01 && key[12] == 0x01 && key[13] == 0x10 && key[14] == 0x01
			return mxfSet when key[10] == 0x01 && key[11] == 0x01 && key[12] == 0x01
			return mxfSet when key[10] == 0x04 && key[11] == 0x01
		}
		if k4 == 0x01 && key[5] == 0x02 && key[6] == 0x01 {
			return mxfEssence when key[8] == 0x0D && key[9] == 0x01 && key[10] == 0x03 && key[11] == 0x01
			return mxfEssence when key[8] == 0x0E && key[9] == 0x04 && key[10] == 0x03 && key[11] == 0x01
			return mxfEssence when key[8] == 0x0E && key[9] == 0x0F && key[10] == 0x03 && key[11] == 0x01
		}
		return mxfOther
	}

	// Hexadecimal text of bytes, the key the sets are kept by.
	def mxfHex(data byte[], at int, count int) string {
		let digits = "0123456789abcdef"
		let out string[]
		for let i = 0; i < count && at + i < data.len(); i++ {
			let b = int(data[at + i])
			out.push(digits[b >> 4:(b >> 4) + 1] + digits[b & 15:(b & 15) + 1])
		}
		return out.join("")
	}

	// A header metadata set: its type, instance UID and local tags. Tags
	// the primer maps to labels are kept by label too.
	type MxfSet {
		kind   int
		uid    string
		tags   map<int, byte[]>
		labels map<string, byte[]>

		def new(kind int) {
			self.kind = kind
			tags = new map<int, byte[]>()
			labels = new map<string, byte[]>()
		}

		// The value of the tag, empty when the set lacks it.
		def value(tag int) byte[] {
			let v = tags.get(tag)
			return byte[] when v is none
			let bytes byte[] = v
			return bytes
		}

		// The value of the tag as a big-endian number, `fallback` when the
		// set lacks it or it is empty.
		def number(tag int, fallback int) int {
			let v = value(tag)
			return fallback when v.len() == 0
			return be(v, 0, v.len().min(8))
		}

		// The value as a signed 32-bit number.
		def signed32(tag int, fallback int) int {
			let v = number(tag, fallback)
			return v >= 0x80000000 && value(tag).len() == 4 ?? (v - 0x100000000, v)
		}

		// The rational stored in the tag: two 32-bit numbers.
		def rational(tag int) (int, int) {
			let v = value(tag)
			return (0, 0) when v.len() < 8
			return (be(v, 0, 4), be(v, 4, 4))
		}

		// The references of a batch: a count, a size and 16-byte UIDs.
		def refs(tag int) string[] {
			let v = value(tag)
			let out string[]
			return out when v.len() < 8
			let count = be(v, 0, 4)
			let size = be(v, 4, 4)
			for let i = 0; i < count && 8 + i * size + 16 <= v.len() && size >= 16; i++ {
				out.push(mxfHex(v, 8 + i * size, 16))
			}
			return out
		}

		// The one reference in the tag, empty when it has none.
		def ref(tag int) string {
			let v = value(tag)
			return v.len() >= 16 ?? (mxfHex(v, 0, 16), "")
		}
	}

	// A partition pack and where its essence starts.
	type MxfPartition {
		at          int
		kind        int
		previous    int
		footer      int
		headerBytes int
		indexBytes  int
		bodyOffset  int
		bodySid     int
		// File offset of the partition's first essence element, -1 until
		// found.
		essenceAt   int

		def new(at int, kind int, value byte[]) {
			self.at = at
			self.kind = kind
			essenceAt = -1
			if value.len() >= 88 {
				previous = be(value, 16, 8)
				footer = be(value, 24, 8)
				headerBytes = be(value, 32, 8)
				indexBytes = be(value, 40, 8)
				bodyOffset = be(value, 52, 8)
				bodySid = be(value, 60, 4)
			}
		}
	}

	// An index table segment (SMPTE ST 377 section 11).
	type MxfIndex {
		rateNum   int
		rateDen   int
		start     int
		length    int
		byteCount int
		indexSid  int
		bodySid   int
		// Per edit unit: the temporal offset (indexed in shown order: the
		// picture shown at x is stored at x + temporal[x]), the flags (0x30
		// forward or backward prediction, clear on a picture that decodes on
		// its own) and the stream offset, both in stored order.
		temporal  int[]
		flags     int[]
		offsets   int[]
		// For each stored edit unit, how far later it is shown; and the
		// most any unit is shown earlier than stored, which decode times
		// are moved back by.
		shift     int[]
		delay     int

		def new() {}

		// Reads the segment's local tags from `set`.
		def read(set MxfSet) {
			(rateNum, rateDen) = set.rational(0x3F0B)
			start = set.number(0x3F0C, 0)
			length = set.number(0x3F0D, 0)
			byteCount = set.number(0x3F05, 0)
			indexSid = set.number(0x3F06, 0)
			bodySid = set.number(0x3F07, 0)
			let v = set.value(0x3F0A)
			return when v.len() < 8
			let count = be(v, 0, 4)
			let size = be(v, 4, 4)
			return when size < 11
			for let i = 0; i < count && 8 + (i + 1) * size <= v.len(); i++ {
				let at = 8 + i * size
				let t = int(v[at])
				temporal.push(t >= 128 ?? (t - 256, t))
				flags.push(int(v[at + 2]))
				offsets.push(be(v, at + 3, 8))
			}
			shift.len(temporal.len())
			for let x = 0; x < temporal.len(); x++ {
				let n = x + temporal[x]
				continue when n < 0 || n >= shift.len()
				shift[n] = x - n
				delay = (n - x).max(delay)
			}
		}

		// Whether edit unit `unit` lies in the segment.
		def holds(unit int) bool {
			return unit >= start && (length <= 0 || unit < start + length)
		}
	}

	// One track of the file: its public description and how its essence
	// is found, cut and timed.
	type MxfTrack {
		track      Track
		// The essence element key's last four bytes.
		number     int
		bodySid    int
		indexSid   int
		editNum    int
		editDen    int
		clip       bool
		// Bytes of one sample frame of PCM sound, 0 for other essence.
		blockAlign int
		rate       int
		// D-10 sound: eight AES3 channels of 4 bytes a sample.
		aes3       bool
		bits       int
		// Edit units, or sample frames for sound, handed out so far.
		count      int
		// Edit units the file declares, 0 when it does not.
		units      int
		// Clip-wrapped video cut into pictures at start codes: the bytes
		// not yet cut, where the scan stands, and whether they hold a
		// picture.
		pending    byte[]
		scanAt     int
		picture    bool

		def new(track Track) {
			self.track = track
			editNum = 25
			editDen = 1
		}

		def isSound() bool {
			return blockAlign > 0 && rate > 0
		}

		// Whether clip-wrapped essence of the track is cut at start codes.
		def cutsPictures() bool {
			return clip && (track.codec := "mpeg1" || "mpeg2" || "mpeg4" || "h264" || "hevc")
		}

		// The time of edit unit `unit`.
		def unitTime(unit int) duration {
			return ticks(unit * editDen, editNum)
		}
	}

	// The demultiplexer of an MXF file.
	type MxfContainer {
		src        Source
		runIn      int
		primer     map<int, string>
		sets       map<string, MxfSet>
		parts      MxfPartition[]
		indexes    MxfIndex[]
		streams    MxfTrack[]
		list       Track[]
		// File offset of the first essence element.
		essenceAt  int
		bodySid    int
		// The clip-wrapped KLV being cut: its track, the next byte and the
		// end.
		clipTrack  int
		clipStart  int
		clipAt     int
		clipEnd    int
		// Packets cut and not yet handed out.
		ready      Packet[]
		readyAt    int
		ended      bool
		opAtom     bool
		dropBefore duration
		dropping   bool

		def new(src Source) {
			self.src = src
			primer = new map<int, string>()
			sets = new map<string, MxfSet>()
			essenceAt = -1
			clipTrack = -1
		}

		// Reads the header partition's metadata and, in a file that can
		// seek, the metadata and index tables of every other partition;
		// then builds the tracks.
		//
		// Fails when the file is not MXF, it has no material package, or
		// the reader fails.
		def read() !none {
			let head = try src.peek(mxfRunIn + 16)
			runIn = mxfFindHeader(head)
			fail "mxf: no header partition" when runIn < 0
			try src.seek(runIn)
			try readMetadata(runIn, -1)
			fail "mxf: the header holds no essence" when essenceAt < 0 && !src.seekable()
			if src.seekable() && src.size() > 0 {
				try readPartitions()
			}
			try buildTracks()
			fail "mxf: the file has no tracks" when streams.len() == 0
			essenceAt = runIn when essenceAt < 0
			try src.seek(essenceAt)
			bodySid = bodySidAt(essenceAt)
			return none
		}

		// Reads KLV packets from `from` until the first essence element or
		// another partition pack (or `end` when not -1), taking the
		// partition pack there, the primer, the metadata sets and the index
		// segments.
		//
		// Fails when the reader does.
		def readMetadata(from int, end int) !none {
			try src.seek(from)
			let first = true
			for {
				let at = src.position()
				break when end >= 0 && at >= end
				let key = try src.peek(16)
				break when key.len() < 16
				let kind = mxfKind(key)
				try src.skip(16)
				let length = try readLength()
				break when length < 0
				if kind == mxfEssence {
					essenceAt = at when essenceAt < 0 || at < essenceAt
					notePartitionEssence(at)
					break
				}
				if kind == mxfPartition {
					break unless first
					let value = try src.read(length)
					addPartition(at, int(key[13]), value)
					opAtom = true when value.len() >= 80 && value[64 + 12] == 0x10
					first = false
					continue
				}
				first = false
				if kind == mxfRip {
					break
				}
				if length > 64 * 1024 * 1024 {
					try src.skip(length)
					continue
				}
				let value = try src.read(length)
				if kind == mxfPrimer {
					readPrimer(value)
				} else if kind == mxfSet {
					readSet(key, value)
				} else if kind == mxfIndex {
					let s = new MxfSet(0)
					readLocal(s, value)
					let index = new MxfIndex()
					index.read(s)
					indexes.push(index)
				}
			}
			return none
		}

		// A BER length at the cursor, -1 at the end of the file.
		//
		// Fails when the reader does.
		def readLength() !int {
			let b = try src.peek(1)
			return -1 when b.len() < 1
			try src.skip(1)
			let first = int(b[0])
			return first when first < 0x80
			let n = first & 0x7F
			return 0 when n == 0
			let bytes = try src.read(n)
			return -1 when bytes.len() < n
			return be(bytes, 0, n)
		}

		// Records the partition pack at file offset `at`, once.
		def addPartition(at int, kind int, value byte[]) {
			for let (_, p) in parts {
				return when p.at == at
			}
			parts.push(new MxfPartition(at, kind, value))
		}

		// Marks `at` as the first essence element of the partition before
		// it.
		def notePartitionEssence(at int) {
			let found = partitionBefore(at)
			return when found < 0
			let p = parts[found]
			p.essenceAt = at when p.essenceAt < 0 || at < p.essenceAt
		}

		// The index of the last partition starting before `at`, -1 when
		// none does.
		def partitionBefore(at int) int {
			let best = -1
			for let (i, p) in parts {
				best = i when p.at < at && (best < 0 || p.at > parts[best].at)
			}
			return best
		}

		// The body SID of the partition holding file offset `at`.
		def bodySidAt(at int) int {
			let i = partitionBefore(at + 1)
			return i < 0 ?? (0, parts[i].bodySid)
		}

		// Maps the primer's local tags to their labels.
		def readPrimer(value byte[]) {
			return when value.len() < 8
			let count = be(value, 0, 4)
			let size = be(value, 4, 4)
			return when size != 18
			for let i = 0; i < count && 8 + (i + 1) * 18 <= value.len(); i++ {
				let at = 8 + i * 18
				primer.set(be(value, at, 2), mxfHex(value, at + 2, 16))
			}
		}

		// Reads a metadata set; a set read again later replaces it.
		def readSet(key byte[], value byte[]) {
			let s = new MxfSet(int(key[13]) << 8 | int(key[14]))
			readLocal(s, value)
			s.uid = s.ref(0x3C0A)
			sets.set(s.uid, s) unless s.uid == ""
		}

		// Reads the local tags of a set's value into `s`.
		def readLocal(s MxfSet, value byte[]) {
			let at = 0
			for at + 4 <= value.len() {
				let tag = be(value, at, 2)
				let size = be(value, at + 2, 2)
				at += 4
				break when at + size > value.len()
				let v = value[at:at + size].clone()
				s.tags.set(tag, v)
				let label = primer.get(tag)
				s.labels.set(label, v) unless label is none
				at += size
			}
		}

		// Walks the partitions from the footer back to the header through
		// their `PreviousPartition` links, reading each one's metadata and
		// index segments in file order.
		//
		// Fails when the reader does.
		def readPartitions() !none {
			let footer = 0
			for let (_, p) in parts {
				footer = p.footer when p.footer > 0
			}
			footer = try footerFromRip() when footer == 0
			return none when footer <= 0
			let chain int[]
			let at = runIn + footer
			let seen = 0
			for at > runIn && at < src.size() && seen < 100000 {
				chain.push(at)
				try src.seek(at)
				let key = try src.peek(16)
				break when key.len() < 16 || mxfKind(key) != mxfPartition
				try src.skip(16)
				let length = try readLength()
				break when length < 0
				let value = try src.read(length)
				addPartition(at, int(key[13]), value)
				let p = parts[parts.len() - 1]
				break when p.previous <= 0 && at != runIn + p.previous
				at = runIn + p.previous
				seen++
			}
			chain.reverse()
			for let (_, from) in chain {
				try readMetadata(from, -1)
			}
			return none
		}

		// The footer's offset from the random index pack at the end of the
		// file, 0 without one.
		//
		// Fails when the reader does.
		def footerFromRip() !int {
			return 0 when src.size() < 20
			let tail = try src.bytesAt(src.size() - 4, 4)
			let length = be(tail, 0, 4)
			return 0 when length < 20 || length > src.size()
			let rip = try src.bytesAt(src.size() - length, length)
			return 0 unless mxfMatch(rip, 0, int[0x06, 0x0E, 0x2B, 0x34, 0x02, 0x05, 0x01, 0x01, 0x0D, 0x01, 0x02, 0x01, 0x01, 0x11], 14)
			// The pairs of body SID and partition offset follow the key and
			// its BER length.
			let at = 16
			let first = int(rip[at])
			at += first < 0x80 ?? (1, 1 + (first & 0x7F))
			let last = 0
			for at + 12 <= rip.len() - 4 {
				last = be(rip, at + 4, 8)
				at += 12
			}
			return last
		}

		// The set with the UID, none when the file lacks it.
		def set(uid string) ?MxfSet {
			return none when uid == ""
			return sets.get(uid)
		}

		// Builds the tracks from the material package: each track's source
		// clip leads to a file package track, its essence descriptor and
		// its body.
		//
		// Fails when the file has no material package.
		def buildTracks() !none {
			let material ?MxfSet = none
			for let (_, s) in sets {
				if s.kind == mxfMaterialPackage {
					material = s
					break
				}
			}
			fail "mxf: the file has no material package" when material is none
			let m MxfSet = material
			for let (_, trackRef) in m.refs(0x4403) {
				let found = set(trackRef)
				continue when found is none
				let mt MxfSet = found
				continue unless mt.kind := mxfTimelineTrack || mxfStaticTrack || mxfEventTrack
				let seq = set(mt.ref(0x4803))
				continue when seq is none
				let sequence MxfSet = seq
				try addTrack(mt, sequence)
			}
			return none
		}

		// Adds the track the material track `mt` leads to, when its source
		// clip resolves.
		//
		// Fails never; a track that does not resolve is left out.
		def addTrack(mt MxfSet, sequence MxfSet) !none {
			let clip = sourceClip(sequence)
			return none when clip is none
			let c MxfSet = clip
			let packageId = c.value(0x1101)
			return none when packageId.len() < 32
			let pkg = sourcePackage(mxfHex(packageId, 0, 32))
			return none when pkg is none
			let p MxfSet = pkg
			let trackId = c.number(0x1102, 0)
			let st ?MxfSet = none
			for let (_, r) in p.refs(0x4403) {
				let t = set(r)
				continue when t is none
				let candidate MxfSet = t
				if candidate.number(0x4801, -1) == trackId {
					st = candidate
					break
				}
			}
			return none when st is none
			let sourceTrack MxfSet = st
			let definition = sequence.value(0x0201)
			let kind = mxfDataKind(definition)
			let descriptor = descriptorOf(p, trackId)
			let t = newTrack(streams.len(), kind, "")
			let s = new MxfTrack(t)
			s.number = sourceTrack.number(0x4804, 0)
			let (en, ed) = mt.rational(0x4B01)
			if en > 0 && ed > 0 {
				s.editNum = en
				s.editDen = ed
			}
			let duration = c.number(0x0202, -1)
			s.clip = opAtom
			if !(descriptor is none) {
				let d MxfSet = descriptor
				describe(s, d, kind)
				let dd = d.number(0x3002, -1)
				duration = dd when dd >= 0 && (duration < 0 || dd < duration)
			}
			for let (_, sid) in essenceSids(mxfHex(packageId, 0, 32)) {
				(s.bodySid, s.indexSid) = sid
			}
			if duration > 0 && duration < 0x7FFFFFFFFFFF {
				s.units = duration
				t.length = s.unitTime(duration)
			}
			t.frameRate = FrameRate{numerator: uint32(s.editNum), denominator: uint32(s.editDen)} when kind == TrackKind.Video
			streams.push(s)
			list.push(t)
			return none
		}

		// The first source clip of the sequence whose package the file
		// holds, through the choices of an essence group.
		def sourceClip(sequence MxfSet) ?MxfSet {
			for let (_, r) in sequence.refs(0x1001) {
				let found = set(r)
				continue when found is none
				let s MxfSet = found
				if s.kind == mxfSourceClip {
					return s when resolves(s)
				} else if s.kind == mxfEssenceGroup {
					for let (_, choice) in s.refs(0x0501) {
						let inner = set(choice)
						continue when inner is none
						let i MxfSet = inner
						return i when i.kind == mxfSourceClip && resolves(i)
					}
				}
			}
			return none
		}

		// Whether the source clip's package is in the file.
		def resolves(clip MxfSet) bool {
			let id = clip.value(0x1101)
			return id.len() >= 32 && !(sourcePackage(mxfHex(id, 0, 32)) is none)
		}

		// The source package with the UMID.
		def sourcePackage(umid string) ?MxfSet {
			for let (_, s) in sets {
				return s when s.kind == mxfSourcePackage && mxfHex(s.value(0x4401), 0, 32) == umid
			}
			return none
		}

		// The body and index SIDs of the essence container data naming the
		// package.
		def essenceSids(umid string) (int, int)[] {
			let out (int, int)[]
			for let (_, s) in sets {
				out.push((s.number(0x3F07, 0), s.number(0x3F06, 0))) when s.kind == mxfEcData && mxfHex(s.value(0x2701), 0, 32) == umid
			}
			return out
		}

		// The package's essence descriptor for track `trackId`: its own, or
		// the sub-descriptor of a multiple descriptor linked to the track.
		def descriptorOf(p MxfSet, trackId int) ?MxfSet {
			let found = set(p.ref(0x4701))
			return none when found is none
			let d MxfSet = found
			return d unless d.kind == mxfMultiple
			let subs = d.refs(0x3F01)
			for let (_, r) in subs {
				let sub = set(r)
				continue when sub is none
				let s MxfSet = sub
				return s when s.number(0x3006, -1) == trackId
			}
			return none unless subs.len() == 1
			return set(subs[0])
		}

		// Fills the track from its essence descriptor: codec, picture size
		// or sound format, and how its essence is wrapped.
		def describe(s MxfTrack, d MxfSet, kind TrackKind) {
			let t = s.track
			let container = d.value(0x3004)
			let wrapping = mxfWrapping(container)
			s.clip = s.clip || wrapping == 2
			// Video whose label does not say how it is wrapped is cut at its
			// start codes, as a stream.
			s.clip = true when wrapping == 0 && kind == TrackKind.Video && (mxfPictureCodec(d.value(0x3201)) := "mpeg1" || "mpeg2" || "mpeg4" || "h264" || "hevc")
			if kind == TrackKind.Video {
				let coding = d.value(0x3201)
				t.codec = mxfPictureCodec(coding)
				t.codec = mxfPictureContainer(container) when t.codec == ""
				// An RGBA or CDCI descriptor naming no compression describes
				// uncompressed pictures.
				t.codec = "rawvideo" when t.codec == "" && coding.len() == 0 && (d.kind := 0x0128 || 0x0129)
				t.width = uint32(d.number(0x3203, 0))
				let height = d.number(0x3202, 0)
				let layout = d.number(0x320C, 0)
				height *= 2 when layout := 1 || 4
				t.height = uint32(height)
				let (an, ad) = d.rational(0x320E)
				t.pixelAspect = float64(an) * float64(t.height) / (float64(ad) * float64(t.width)) when an > 0 && ad > 0 && t.width > 0 && t.height > 0
				let extra = d.labels.get("060e2b34040101010e06060202010000")
				if !(extra is none) {
					let bytes byte[] = extra
					t.config = bytes
				}
			} else if kind == TrackKind.Audio {
				let (rn, rd) = d.rational(0x3D03)
				s.rate = rd > 0 ?? (rn / rd, 0)
				t.sampleRate = uint32(s.rate)
				t.channels = uint16(d.number(0x3D07, 0))
				s.bits = d.number(0x3D01, 16)
				t.codec = mxfSoundCodec(d.value(0x3D06), container, s.bits)
				s.aes3 = mxfMatch(container, 0, int[0x06, 0x0E, 0x2B, 0x34, 0x04, 0x01, 0x01, 0x01, 0x0D, 0x01, 0x03, 0x01, 0x02, 0x01], 14)
				if t.codec.startsWith("pcm_") {
					s.blockAlign = d.number(0x3D0A, 0)
					s.blockAlign = int(t.channels) * ((s.bits + 7) / 8) when s.blockAlign <= 0 || s.aes3
				}
			} else {
				t.codec = mxfDataCodec(container)
			}
		}

		// name implements Described.
		def name() string {
			return "mxf"
		}

		// seekable implements Seekable.
		def seekable() bool {
			return src.seekable()
		}

		// tracks implements Container.
		def tracks() Track[] {
			return list
		}

		// The track whose essence element key ends in `key[12..15]`, -1
		// when none does. An OP-Atom file with one track takes every
		// element.
		def trackOf(key byte[]) int {
			let number = be(key, 12, 4)
			for let (i, s) in streams {
				continue unless s.number == number
				return i when s.bodySid == 0 || bodySid == 0 || s.bodySid == bodySid
			}
			return 0 when streams.len() == 1
			return -1
		}

		// next implements Container.
		//
		// Fails when the reader does.
		def next() !?Packet {
			for {
				let got = try pull()
				return none when got is none
				let p Packet = got
				continue when dropping && list[p.track].kind != TrackKind.Video && p.pts < dropBefore
				dropping = false when list[p.track].kind == TrackKind.Video
				return p
			}
			return none
		}

		// The next packet in file order.
		//
		// Fails when the reader does.
		def pull() !?Packet {
			for {
				if readyAt < ready.len() {
					let p = ready[readyAt]
					readyAt++
					return p
				}
				ready = Packet[]
				readyAt = 0
				if clipTrack >= 0 {
					if clipAt < clipEnd {
						let s = streams[clipTrack]
						return try clipPacket() unless s.cutsPictures()
						let size = mxfChunk.min(clipEnd - clipAt)
						try src.seek(clipAt)
						let data = try src.read(size)
						clipAt += size
						clipAt = clipEnd when data.len() < size
						cut(clipTrack, data)
						continue
					}
					clipTrack = -1
					try src.seek(clipEnd)
				}
				return none when ended
				let at = src.position()
				let key = try src.peek(16)
				let length = -1
				if key.len() == 16 {
					try src.skip(16)
					length = try readLength()
				}
				if length < 0 {
					ended = true
					flushCuts()
					continue
				}
				let kind = mxfKind(key)
				if kind == mxfPartition {
					let value = try src.read(length)
					addPartition(at, int(key[13]), value)
					bodySid = parts[partitionBefore(at + 1)].bodySid
					continue
				}
				let index = kind == mxfEssence ?? (trackOf(key), -1)
				let left = src.size() > 0 ?? (src.size() - src.position(), length)
				if index < 0 {
					ended = true when length > left
					try src.skip(length.min(left))
					continue
				}
				let s = streams[index]
				if s.clip {
					clipTrack = index
					clipAt = src.position()
					clipStart = clipAt
					clipEnd = clipAt + length.min(left)
					continue
				}
				// A file cut short ends with what its last element holds.
				ended = true when length > left
				let data = try src.read(length.min(left))
				return frame(index, data, key)
			}
			return none
		}

		// Adds bytes of clip-wrapped video of track `index` and queues the
		// pictures they complete.
		def cut(index int, data byte[]) {
			let s = streams[index]
			s.pending.push(...data)
			for {
				let at = findPrefix(s.pending, s.scanAt)
				if at < 0 || at + 4 >= s.pending.len() {
					s.scanAt = (s.pending.len() - 4).max(s.scanAt).max(0)
					return
				}
				s.scanAt = at + 3
				if s.picture && esStartsUnit(s.track.codec, s.pending, at) {
					let unit = s.pending[:at].clone()
					s.pending = s.pending[at:].clone()
					s.scanAt = 0
					s.picture = false
					ready.push(frame(index, unit, byte[]))
					continue
				}
				s.picture = true when esStartsPicture(s.track.codec, s.pending, at)
			}
		}

		// Queues what the cut tracks still hold, at the end of the file.
		def flushCuts() {
			for let (i, s) in streams {
				continue when s.pending.len() == 0
				let unit = s.pending
				s.pending = byte[]
				s.scanAt = 0
				s.picture = false
				ready.push(frame(i, unit, byte[]))
			}
		}

		// A frame-wrapped element of track `index` as a packet.
		def frame(index int, value byte[], key byte[]) Packet {
			let s = streams[index]
			let data = value
			if s.isSound() {
				data = mxfAes3(value, int(s.track.channels), s.bits) when s.aes3 && key[12] == 0x06 && key[13] == 0x01 && key[14] == 0x10
				let start = s.count
				s.count += data.len() / s.blockAlign
				return newPacket(index, data, ticks(start, s.rate), ticks(start, s.rate), ticks(s.count - start, s.rate), true)
			}
			let unit = s.count
			s.count++
			let (shift, flags, delay) = entryOf(s, unit)
			let indexed = delay >= 0
			let key0 = indexed ?? ((flags & 0x30) == 0, isKeyPayload(s.track.codec, data))
			let pts = s.unitTime(unit + shift)
			let dts = s.unitTime(unit) - s.unitTime(delay.max(0))
			return newPacket(index, data, pts, dts, s.unitTime(1), key0 || s.track.kind != TrackKind.Video)
		}

		// The next piece of the clip-wrapped KLV being cut.
		//
		// Fails when the reader does.
		def clipPacket() !Packet {
			let s = streams[clipTrack]
			let size = mxfChunk
			let unit = clipUnitEnd(s)
			size = unit when unit > 0
			// Sound indexed one sample frame at a time goes out in 1/25 s
			// packets (a PAL frame's worth, 1920 at 48 kHz).
			size = s.blockAlign * (s.editNum / s.editDen.max(1) / 25).max(1) when s.isSound() && unit < 32
			size = size.min(clipEnd - clipAt)
			try src.seek(clipAt)
			let data = try src.read(size)
			clipAt += size
			if s.isSound() {
				let start = s.count
				s.count += data.len() / s.blockAlign
				return newPacket(clipTrack, data, ticks(start, s.rate), ticks(start, s.rate), ticks(s.count - start, s.rate), true)
			}
			return frame(clipTrack, data, byte[])
		}

		// Bytes of the clip-wrapped edit unit starting now, from the index
		// (a constant size or the stream offsets), 0 when nothing says.
		def clipUnitEnd(s MxfTrack) int {
			for let (_, x) in indexes {
				continue unless x.indexSid == s.indexSid || s.indexSid == 0
				return x.byteCount when x.byteCount > 0
				let i = s.count - x.start
				return x.offsets[i + 1] - x.offsets[i] when i >= 0 && i + 1 < x.offsets.len()
			}
			return 0
		}

		// The index entry of edit unit `unit` of the track: how far later
		// it is shown, its flags and the segment's reorder delay, -1 when
		// the index has no entry for it.
		def entryOf(s MxfTrack, unit int) (int, int, int) {
			for let (_, x) in indexes {
				continue unless x.indexSid == s.indexSid || s.indexSid == 0
				continue unless x.holds(unit) && x.temporal.len() > 0
				let i = unit - x.start
				continue when i >= x.shift.len()
				return (x.shift[i], x.flags[i], x.delay)
			}
			return (0, 0, -1)
		}

		// seek implements Container: to the last random access edit unit
		// of the main track at or before `time`, through the index tables;
		// without them, reading the essence from the start.
		//
		// Fails when the source cannot seek or the reader fails.
		def seek(time duration) !none {
			fail "mxf: the stream cannot seek" unless src.seekable()
			let main = 0
			for let (i, t) in list {
				if t.kind == TrackKind.Video {
					main = i
					break
				}
			}
			let s = streams[main]
			clipTrack = -1
			ready = Packet[]
			readyAt = 0
			ended = false
			for let (_, t) in streams {
				t.pending = byte[]
				t.scanAt = 0
				t.picture = false
			}
			if s.clip && s.isSound() {
				try seekClip(main, time)
			} else if s.clip || !(try seekIndexed(s, time)) {
				try seekScan(main, time)
			}
			return none
		}

		// Seeks through the index of track `s`. Returns false when the index
		// cannot place the edit unit.
		//
		// Fails when the reader does.
		def seekIndexed(s MxfTrack, time duration) !bool {
			let unit = int(int64(time) * int64(s.editNum) / (int64(s.editDen) * 1000000000))
			// Past the end, the last edit unit the index covers (files may
			// hold more essence than their material declares), else the
			// last one declared.
			let last = -1
			for let (_, x) in indexes {
				continue unless x.indexSid == s.indexSid || s.indexSid == 0
				let covered = x.length > 0 ?? (x.length, x.offsets.len())
				last = (x.start + covered - 1).max(last) when covered > 0
			}
			last = s.units - 1 when last < 0 && s.units > 0
			unit = unit.min(last) when last >= 0
			let offset = -1
			let pick = unit
			for let (_, x) in indexes {
				continue unless x.indexSid == s.indexSid || s.indexSid == 0
				continue unless x.holds(unit)
				if x.byteCount > 0 {
					offset = (unit - x.start) * x.byteCount
					break
				}
				let i = unit - x.start
				continue when i >= x.offsets.len()
				// Back to a picture that decodes on its own and is shown at
				// or before the target.
				let shown = unit - x.start
				for i > 0 && ((x.flags[i] & 0x30) != 0 || (i < x.shift.len() && i + x.shift[i] > shown)) {
					i--
				}
				pick = x.start + i
				offset = x.offsets[i]
				break
			}
			return false when offset < 0
			let at = try fileOffset(s.bodySid, offset)
			// A file cut short: the index names bytes it lacks.
			return false when at < 0 || (src.size() > 0 && at >= src.size())
			try src.seek(at)
			bodySid = bodySidAt(at)
			// Every track's count at edit unit `pick` of the main track,
			// rounded to the nearest, in exact ratios of the edit rates.
			for let (_, t) in streams {
				let num = t.isSound() ?? (pick * s.editDen * t.rate, pick * s.editDen * t.editNum)
				let den = t.isSound() ?? (s.editNum, s.editNum * t.editDen)
				t.count = (2 * num + den) / (2 * den)
			}
			dropBefore = s.unitTime(pick)
			dropping = false
			return true
		}

		// The file offset of byte `offset` of the essence container of body
		// `sid`, -1 when no partition holds it.
		//
		// Fails when the reader does.
		def fileOffset(sid int, offset int) !int {
			let best = -1
			for let (i, p) in parts {
				continue unless p.bodySid == sid || sid == 0
				continue unless p.bodyOffset <= offset
				best = i when best < 0 || p.bodyOffset > parts[best].bodyOffset || (p.bodyOffset == parts[best].bodyOffset && p.at > parts[best].at)
			}
			return -1 when best < 0
			let p = parts[best]
			if p.essenceAt < 0 {
				try readMetadata(p.at, -1)
			}
			return -1 when p.essenceAt < 0
			return p.essenceAt + offset - p.bodyOffset
		}

		// Seeks by reading the essence from the start: the packets from the
		// last keyframe of track `main` at or before `time` on are queued,
		// and the other tracks' packets presenting before it dropped.
		//
		// Fails when the reader does.
		def seekScan(main int, time duration) !none {
			try restart()
			let held Packet[]
			let keyTime = 0s
			for {
				let got = try pull()
				break when got is none
				let p Packet = got
				if p.track == main && p.keyframe {
					if p.pts <= time {
						held = Packet[]
						keyTime = p.pts
					} else if p.dts > time {
						held.push(p)
						break
					}
				}
				held.push(p)
			}
			let rest = ready[readyAt:].clone()
			ready = held.concat(rest)
			readyAt = 0
			dropBefore = keyTime
			dropping = keyTime > 0s
			return none
		}

		// Returns to the first essence element with every count at zero.
		//
		// Fails when the reader does.
		def restart() !none {
			try src.seek(essenceAt)
			bodySid = bodySidAt(essenceAt)
			clipTrack = -1
			ready = Packet[]
			readyAt = 0
			ended = false
			for let (_, t) in streams {
				t.count = 0
				t.pending = byte[]
				t.scanAt = 0
				t.picture = false
			}
			return none
		}

		// Seeks in a clip-wrapped main track: the sample frame or edit unit
		// at `time` inside its KLV.
		//
		// Fails when the reader does.
		def seekClip(main int, time duration) !none {
			let s = streams[main]
			try restart()
			let got = try pull()
			return none when got is none || clipTrack != main
			let frame = int(int64(time) * int64(s.rate) / 1000000000)
			clipAt = (clipStart + frame * s.blockAlign).min(clipEnd)
			s.count = (clipAt - clipStart) / s.blockAlign
			ready = Packet[]
			readyAt = 0
			return none
		}

		// close implements io.Closer: closes the file.
		//
		// Fails when closing it does.
		def close() !none {
			return src.close()
		}
	}

	// The track kind a sequence's data definition label names.
	def mxfDataKind(ul byte[]) TrackKind {
		if ul.len() >= 16 && ul[0] == 0x80 && ul[1] == 0x7D {
			// Avid's legacy picture and sound labels.
			return TrackKind.Video when ul[8] == 0x6F && ul[9] == 0x3C
			return TrackKind.Audio when ul[8] == 0x78 && ul[9] == 0xE1
			return TrackKind.Data
		}
		return TrackKind.Data unless mxfMatch(ul, 0, int[0x06, 0x0E, 0x2B, 0x34, 0x04, 0x01, 0x01, 0x01, 0x01, 0x03, 0x02, 0x02], 12)
		return TrackKind.Video when ul[12] == 0x01
		return TrackKind.Audio when ul[12] == 0x02
		return TrackKind.Data
	}

	// 1 when the essence container label says frame-wrapped, 2 when
	// clip-wrapped, 0 when it does not say.
	def mxfWrapping(ul byte[]) int {
		return 0 unless mxfMatch(ul, 0, int[0x06, 0x0E, 0x2B, 0x34, 0x04, 0x01, 0x01, 0x01, 0x0D, 0x01, 0x03, 0x01, 0x02], 13)
		let kind = int(ul[13])
		let at = (kind := 0x04 || 0x10 || 0x01 || 0x02 || 0x05) ?? (15, 14)
		let v = int(ul[at])
		if kind == 0x05 {
			v = v % 4
		} else if kind == 0x06 {
			v -= 2 when v := 0x03 || 0x04
		} else if kind == 0x01 {
			v = 1 when v == 2
		} else if kind == 0x0C {
			v = 1 unless v == 2
		}
		return (v := 1 || 2) ?? (v, 0)
	}

	// The codec a picture essence coding label names, empty when unknown.
	def mxfPictureCodec(ul byte[]) string {
		return "" unless mxfMatch(ul, 0, int[0x06, 0x0E, 0x2B, 0x34, 0x04, 0x01, 0x01, 0x01], 8)
		if ul[8] == 0x04 && ul[9] == 0x01 && ul[10] == 0x02 {
			let a = int(ul[11])
			let b = int(ul[12])
			let c = int(ul[13])
			if a == 0x02 {
				if b == 0x01 {
					return "mpeg4" when c == 0x20
					return "h264" when c := 0x31 || 0x32
					return "mpeg2" when c >= 0x01 && c <= 0x11
					return ""
				}
				return "dvvideo" when b == 0x02
				if b == 0x03 {
					return "jpeg2000" when c == 0x01
					return "dnxhd" when c == 0x02
					return "prores" when c == 0x06
					return "ffv1" when c == 0x09
					return ""
				}
				return "vc1" when b == 0x04
				return "dnxhd" when b == 0x71
				return ""
			}
			return "rawvideo" when a == 0x01
			return ""
		}
		return "dnxhd" when ul[8] == 0x0E && ul[9] == 0x04 && ul[10] == 0x02 && ul[11] == 0x01 && ul[12] == 0x02 && ul[13] == 0x04
		return "prores" when ul[8] == 0x0E && ul[9] == 0x04 && ul[10] == 0x02 && ul[11] == 0x01 && ul[12] == 0x02 && ul[13] == 0x11
		return ""
	}

	// The codec a picture essence container label names, empty when
	// unknown.
	def mxfPictureContainer(ul byte[]) string {
		return "" unless mxfMatch(ul, 0, int[0x06, 0x0E, 0x2B, 0x34, 0x04, 0x01, 0x01, 0x01, 0x0D, 0x01, 0x03, 0x01, 0x02], 13)
		let kind = int(ul[13])
		return "h264" when kind == 0x10
		return "dnxhd" when kind == 0x11
		return "vc1" when kind == 0x12
		return "prores" when kind == 0x1C
		return "mpeg2" when kind := 0x04 || 0x01
		return "ffv1" when kind == 0x23
		return "dvvideo" when kind == 0x02
		return "rawvideo" when kind == 0x05
		return "jpeg2000" when kind == 0x0C
		return ""
	}

	// The codec of sound: the compression label, else the essence
	// container's; uncompressed PCM named by its sample size.
	def mxfSoundCodec(compression byte[], container byte[], bits int) string {
		if mxfMatch(compression, 0, int[0x06, 0x0E, 0x2B, 0x34, 0x04, 0x01, 0x01, 0x01, 0x04, 0x02, 0x02], 11) {
			let a = int(compression[11])
			let b = int(compression[12])
			if a == 0x01 {
				return pcmCodec(bits, float = false, big = true) when b == 0x7E
				return pcmCodec(bits, float = false, big = false)
			}
			if a == 0x02 && b == 0x03 {
				let c = int(compression[13])
				let d = int(compression[14])
				return "pcm_alaw" when c == 0x01 && d == 0x01
				return "ac3" when c == 0x02 && d == 0x01
				return "mp2" when c == 0x02 && d == 0x05
				return "aac" when c := 0x03 || 0x04
			}
		}
		if mxfMatch(container, 0, int[0x06, 0x0E, 0x2B, 0x34, 0x04, 0x01, 0x01, 0x01, 0x0D, 0x01, 0x03, 0x01, 0x02], 13) {
			let kind = int(container[13])
			return pcmCodec(bits, float = false, big = false) when kind := 0x06 || 0x01
			return "mp2" when kind == 0x04
			return "aac" when kind := 0x16 || 0x17 || 0x18
		}
		return pcmCodec(bits, float = false, big = false)
	}

	// The codec of data essence: SMPTE 436M VBI and ANC, TTML.
	def mxfDataCodec(container byte[]) string {
		return "" unless mxfMatch(container, 0, int[0x06, 0x0E, 0x2B, 0x34, 0x04, 0x01, 0x01, 0x01, 0x0D, 0x01, 0x03, 0x01, 0x02], 13)
		let kind = int(container[13])
		return "smpte_436m_vbi" when kind == 0x0D
		return "smpte_436m_anc" when kind == 0x0E
		return "ttml" when kind == 0x13
		return ""
	}

	// D-10 sound (SMPTE ST 331): a 4-byte header, then eight 32-bit AES3
	// subframes a sample frame, of which the first `channels` are kept as
	// little-endian samples of `bits` bits.
	def mxfAes3(value byte[], channels int, bits int) byte[] {
		let out byte[]
		let width = bits > 16 ?? (3, 2)
		let at = 4
		for at + 32 <= value.len() || (at + channels * 4 <= value.len() && channels > 0) {
			for let c = 0; c < channels; c++ {
				let sample = le(value, at + c * 4, 4)
				let v = width == 3 ?? ((sample >> 4) & 0xFFFFFF, (sample >> 12) & 0xFFFF)
				for let k = 0; k < width; k++ {
					out.push(byte((v >> (8 * k)) & 0xFF))
				}
			}
			at += 32
		}
		return out
	}
}
