partial module std.formats.video {
	use (
		std.testing
		std.bytes
		std.os
		std.data.encoding
		std.crypto.hash
		std.formats.video.loader::*
		std.formats.video.mpeg2::*
	)

	check "MXF" {
		// 2 s of 176x144 MPEG-2 (GOPs of 12 with B-frames) and 16-bit
		// stereo PCM, OP1a from the FFmpeg muxer, with index tables.
		let op1a = "samples/video/mxf/op1a_mpeg2.mxf"
		// 0.5 s of 24-bit mono PCM, clip-wrapped OP-Atom.
		let atom = "samples/video/mxf/opatom_pcm24.mxf"

		// The MD5 of the bytes as lowercase hex.
		def md5(data byte[]) string {
			let h = new hash.MD5()
			return encoding.hexencode(h.hash(data)).lower()
		}

		// Every packet of the file, in file order.
		def packets(path string) !Packet[] {
			let c = try new MXF().open(new bytes.Reader(try os.readFile(path)))
			defer c.close()
			let out Packet[]
			for {
				let got = try c.next()
				break when got is none
				let p Packet = got
				out.push(p)
			}
			return out
		}

		@test()
		def TestTracks() !none {
			let c = try new MXF().open(new bytes.Reader(try os.readFile(op1a)))
			defer c.close()
			let tracks = c.tracks()
			try testing.expectEqual(2, tracks.len())
			assert tracks[0].kind == TrackKind.Video && tracks[0].codec == "mpeg2"
			assert tracks[0].width == 176 && tracks[0].height == 144
			assert tracks[0].frameRate.numerator == 25 && tracks[0].frameRate.denominator == 1
			try testing.expectEqual(2s, tracks[0].length)
			assert tracks[1].kind == TrackKind.Audio && tracks[1].codec == "pcm_s16le"
			assert tracks[1].sampleRate == 48000 && tracks[1].channels == 2
		}

		@test()
		def TestPacketsMatchFFmpeg() !none {
			let all = try packets(op1a)
			let video Packet[]
			let sound Packet[]
			for let p in all {
				if p.track == 0 {
					video.push(p)
				} else {
					sound.push(p)
				}
			}
			try testing.expectEqual(50, video.len())
			try testing.expectEqual(50, sound.len())
			// ffmpeg -c copy -f framemd5: the I-frame, then a P-frame shown
			// three frames later (the index's temporal offset).
			try testing.expectEqual("abbbe0262afa15458ea716836805c1dd", md5(video[0].data))
			assert video[0].keyframe
			try testing.expectEqual("00767c14e0e63f38343214644a629fb0", md5(video[1].data))
			assert !video[1].keyframe
			try testing.expectEqual(120ms, video[1].pts)
			try testing.expectEqual(0s, video[1].dts)
			try testing.expectEqual(-40ms, video[0].dts)
			try testing.expectEqual("941014bf51152bb0508023df01b316cf", md5(sound[0].data))
			try testing.expectEqual(7680, sound[0].data.len())
		}

		// The pictures of the video track decoded in software.
		def softwarePictures(path string) !VideoFrame[] {
			let all = try packets(path)
			let dec = new Mpeg2Decoder()
			dec.hw.gpu.disabled = true
			let frames VideoFrame[]
			for let p in all {
				if p.track == 0 {
					frames = frames + dec.feed(p.data, p.pts, true)
				}
			}
			return frames + dec.drain()
		}

		@test()
		def TestDecodes() !none {
			// ffmpeg -f framemd5 of the decoded pictures. ffmpeg decodes in
			// software: a GPU's inverse DCT may round differently, so the
			// pictures `open` gives are held to the hashes only where
			// ADM_VIDEO_HW and the machine leave the stream to the CPU.
			let want = string["81c467320e60471fd695df5484e4b5e3", "3940b3a20c740fc398afed510d82460f", "b8d7d63ef4c22f4898a9ff5a8194c1b5"]
			let soft = try softwarePictures(op1a)
			try testing.expectEqual(50, soft.len())
			for let i = 0; i < want.len(); i++ {
				try testing.expectEqual(want[i], md5(soft[i].y + soft[i].u + soft[i].v))
			}
			let v = try open(op1a)
			defer v.close()
			let stream = try v.frames()
			let onCpu = !v.hardware().decoding
			let count = 0
			for {
				let got = try stream.next()
				break when got is none
				let f VideoFrame = got
				try testing.expectEqual(want[count], md5(f.y + f.u + f.v)) when onCpu && count < want.len()
				if count < soft.len() {
					try testing.expectEqual(soft[count].time, f.time)
					assert f.width == soft[count].width && f.height == soft[count].height
				}
				count++
			}
			try testing.expectEqual(50, count)
		}

		@test()
		def TestSeekThroughTheIndex() !none {
			let c = try new MXF().open(new bytes.Reader(try os.readFile(op1a)))
			defer c.close()
			try c.seek(1s)
			let got = try c.next()
			fail "no packet after the seek" when got is none
			let p Packet = got
			// The last I-frame shown at or before 1 s: GOPs start every 12
			// frames, decoded one frame ahead of when they are shown.
			try testing.expectEqual(0, p.track)
			assert p.keyframe
			try testing.expectEqual(960ms, p.pts)
			try testing.expectEqual(840ms, p.dts)
		}

		@test()
		def TestClipWrappedSound() !none {
			let all = try packets(atom)
			try testing.expectEqual(13, all.len())
			// Cut into 1920-frame packets, as ffmpeg does.
			try testing.expectEqual("538288a555d754acd33654d381be4d00", md5(all[0].data))
			try testing.expectEqual(5760, all[0].data.len())
			let c = try new MXF().open(new bytes.Reader(try os.readFile(atom)))
			defer c.close()
			let t = c.tracks()[0]
			assert t.kind == TrackKind.Audio && t.codec == "pcm_s24le" && t.sampleRate == 48000 && t.channels == 1
			try c.seek(250ms)
			let got = try c.next()
			fail "no packet after the seek" when got is none
			let p Packet = got
			try testing.expectEqual(250ms, p.pts)
		}

		@test()
		def TestSignature() !none {
			assert new MXF().matchSignature(new bytes.Reader(try os.readFile(op1a)))
			assert !new MXF().matchSignature(new bytes.Reader("RIFF....AVI LIST".bytes()))
			assert new MXF().open(new bytes.Reader(byte[1, 2, 3, 4, 5, 6, 7, 8])) is error
		}
	}
}
