partial module std.formats.video {
	use (
		std.io
		std.formats.video.demux::*
		std.formats.media.source::*
		std.formats.video.ogg::*
		std.formats.media.ogg::*
	)

	// OGV is the Ogg container with video: Theora and VP8 video, Vorbis,
	// Opus, FLAC and Speex audio, each a logical stream of pages. The Xiph
	// header packets become the tracks' `config`; timestamps come from the
	// page granule positions. Seeking reads the page headers from the start.
	@codec("OGV")
	type OGV {
		mimeType string[] {
			def get() string[] {
				return string["video/ogg", "application/ogg"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".ogv", ".ogm", ".ogx"]
			}
		}

		// matchSignature reports whether the reader starts with an Ogg page.
		def matchSignature(r io.Reader) bool {
			let head byte[]
			head.len(5)
			let n = io.readFull(r, head) onerror recover 0
			return n == 5 && oggCapture(head, 0) && head[4] == 0
		}

		// open reads the pages up to the end of every stream's header
		// packets.
		//
		// Fails when the file is not Ogg, a stream's headers are cut short,
		// or the reader fails.
		def open(reader io.Reader) !Container {
			let c = new OggContainer(new Source(reader))
			try c.read()
			return c
		}
	}
}
