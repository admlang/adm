internal partial module std.formats.video.ogg {
	use (
		std.formats.video::*
		std.formats.video.demux::*
		std.formats.video.media.source::*
		std.formats.video.media.ogg::*
	)

	// One logical stream: its codec state and the packet being joined
	// across pages.
	type OggStream {
		track       Track
		serial      int
		// Header packets still expected, and those read.
		headersLeft int
		headers     byte[][]
		joiner      OggJoiner
		// Granule rate: frames or samples per second, and the rate's
		// denominator for Theora.
		rateNum     int
		rateDen     int
		// Theora: bits of the granule that count frames since the keyframe,
		// and whether granules count from one (3.2.1 and later).
		shift       int
		fromOne     bool
		// Vorbis: the two block sizes, each mode's long-block flag, the
		// mask of the mode number, and the previous block size.
		blocks      int[]
		modes       bool[]
		modeBits    int
		previous    int
		// Opus: samples dropped at the start.
		preSkip     int
		// The position (frame or sample) the next packet starts at, -1 when
		// no page has given one yet.
		position    int

		def new(serial int) {
			self.serial = serial
			joiner = new OggJoiner()
			position = -1
			rateDen = 1
		}

		// How many granule units the packet lasts.
		def units(packet byte[]) int {
			let codec = track.codec
			if codec == "vorbis" {
				return 0 when packet.len() == 0 || int(packet[0]) & 1 != 0 || blocks.len() < 2
				let mode = (int(packet[0]) >> 1) & ((1 << modeBits) - 1)
				let current = (mode < modes.len() && modes[mode]) ?? (blocks[1], blocks[0])
				let d = (previous + current) / 4
				previous = current
				return d
			}
			return opusSamples(packet) when codec == "opus"
			return 1
		}

		// The position a granule gives: frames for Theora, samples otherwise.
		def granuleUnits(granule int) int {
			if track.codec == "theora" {
				let key = granule >> shift
				let delta = granule & ((1 << shift) - 1)
				return key + delta - (fromOne ?? (1, 0))
			}
			return granule - preSkip when track.codec == "opus"
			return granule
		}

		// The time of a position in granule units.
		def time(units int) duration {
			return 0s when rateNum <= 0
			return ticks(units * rateDen, rateNum)
		}

		// Reads a header packet: the identification header names the codec.
		def header(packet byte[]) {
			headers.push(packet)
			headersLeft--
			return unless headers.len() == 1
			if packet.len() >= 42 && int(packet[0]) == 0x80 && string(packet[1:7]) == "theora" {
				track = newTrack(0, TrackKind.Video, "theora")
				headersLeft = 2
				track.width = uint32(be(packet, 14, 3))
				track.height = uint32(be(packet, 17, 3))
				rateNum = be(packet, 22, 4)
				rateDen = be(packet, 26, 4).max(1)
				let g = gcd(rateNum, rateDen)
				track.frameRate = FrameRate{numerator: uint32(rateNum / g), denominator: uint32(rateDen / g)}
				let parN = be(packet, 30, 3)
				let parD = be(packet, 33, 3)
				track.pixelAspect = float64(parN) / float64(parD) when parN > 0 && parD > 0
				shift = (be(packet, 40, 2) >> 5) & 0x1F
				fromOne = be(packet, 7, 3) >= 0x030201
			} else if packet.len() >= 30 && int(packet[0]) == 1 && string(packet[1:7]) == "vorbis" {
				track = newTrack(0, TrackKind.Audio, "vorbis")
				headersLeft = 2
				track.channels = uint16(int(packet[11]))
				rateNum = le(packet, 12, 4)
				track.sampleRate = uint32(rateNum)
				blocks = int[1 << (int(packet[28]) & 0xF), 1 << (int(packet[28]) >> 4)]
				previous = blocks[0]
			} else if packet.len() >= 19 && string(packet[0:8]) == "OpusHead" {
				track = newTrack(0, TrackKind.Audio, "opus")
				headersLeft = 1
				track.channels = uint16(int(packet[9]))
				track.sampleRate = uint32(48000)
				rateNum = 48000
				preSkip = le(packet, 10, 2)
				track.config = packet
			} else if packet.len() >= 13 && int(packet[0]) == 0x7F && string(packet[1:5]) == "FLAC" {
				track = newTrack(0, TrackKind.Audio, "flac")
				headersLeft = be(packet, 7, 2)
				let info = packet[13:]
				if info.len() >= 38 {
					rateNum = be(info, 14, 3) >> 4
					track.sampleRate = uint32(rateNum)
					track.channels = uint16(((int(info[16]) >> 1) & 7) + 1)
				}
				track.config = packet[13:].clone()
			} else if packet.len() >= 80 && string(packet[0:8]) == "Speex   " {
				track = newTrack(0, TrackKind.Audio, "speex")
				headersLeft = 1 + le(packet, 68, 4)
				rateNum = le(packet, 36, 4)
				track.sampleRate = uint32(rateNum)
				track.channels = uint16(le(packet, 48, 4))
				track.config = packet
			} else if packet.len() >= 26 && string(packet[0:5]) == "OVP80" {
				track = newTrack(0, TrackKind.Video, "vp8")
				headersLeft = 0
				track.width = uint32(be(packet, 8, 2))
				track.height = uint32(be(packet, 10, 2))
				rateNum = be(packet, 18, 4)
				rateDen = be(packet, 22, 4).max(1)
				shift = 32
			} else {
				track = newTrack(0, TrackKind.Data, "")
				headersLeft = 0
			}
		}

		// Packs the header packets into `config` once they are all read.
		def finishHeaders() {
			if track.codec := "vorbis" || "theora" {
				let out byte[]
				for let (_, h) in headers {
					out.push(byte((h.len() >> 8) & 0xFF), byte(h.len() & 0xFF))
					out = out.concat(h)
				}
				track.config = out
				readModes(headers[2]) when track.codec == "vorbis" && headers.len() == 3
			}
		}

		// Finds each mode's block flag at the end of the Vorbis setup header:
		// the modes are its last fields before the framing bit, so they are
		// read backwards without decoding the codebooks before them.
		def readModes(setup byte[]) {
			let r = new BackwardBits(setup)
			// The framing bit.
			for r.left() > 97 {
				break when r.bit() == 1
			}
			let framing = r.used
			let count = 0
			let found = 0
			for r.left() >= 97 {
				let mapping = r.bits(8)
				let transform = r.bits(16)
				let window = r.bits(16)
				break when mapping > 63 || transform != 0 || window != 0
				r.bit()
				count++
				break when count > 64
				let mark = r.used
				found = count when r.bits(6) + 1 == count
				r.used = mark
			}
			return when found == 0
			let flags bool[]
			flags.len(found)
			let s = new BackwardBits(setup)
			s.used = framing
			for let i = found - 1; i >= 0; i-- {
				s.used += 40
				flags[i] = s.bit() == 1
			}
			modes = flags
			modeBits = 0
			for (1 << modeBits) < found {
				modeBits++
			}
		}
	}

	// Reads the bits of a Vorbis packet from its last bit backwards.
	type BackwardBits {
		data byte[]
		// Bits read so far, counted from the end.
		used int

		def new(data byte[]) {
			self.data = data
		}

		// Bits not yet read.
		def left() int {
			return data.len() * 8 - used
		}

		// The next bit back.
		def bit() int {
			return 0 when used >= data.len() * 8
			let at = data.len() - 1 - used / 8
			let b = (int(data[at]) >> (7 - used % 8)) & 1
			used++
			return b
		}

		// The next `n` bits back, the first read the highest.
		def bits(n int) int {
			let v = 0
			for let i = 0; i < n; i++ {
				v = v << 1 | bit()
			}
			return v
		}
	}

	// Samples per channel an Opus packet decodes to at 48 kHz, from its TOC.
	def opusSamples(packet byte[]) int {
		return 0 when packet.len() == 0
		let toc = int(packet[0])
		let config = toc >> 3
		let size = 0
		if config < 12 {
			size = int[480, 960, 1920, 2880][config & 3]
		} else if config < 16 {
			size = (config & 1) == 0 ?? (480, 960)
		} else {
			size = int[120, 240, 480, 960][config & 3]
		}
		let code = toc & 3
		return size when code == 0
		return 2 * size when code := 1 || 2
		return 0 when packet.len() < 2
		return size * (int(packet[1]) & 0x3F)
	}

	// The demultiplexer of an Ogg file.
	type OggContainer {
		src        Source
		streams    OggStream[]
		list       Track[]
		bySerial   map<int, int>
		// File offset of the first page after the headers.
		dataStart  int
		ready      Packet[]
		readyAt    int
		// Packets presenting before this time are dropped: a seek target.
		dropBefore duration
		dropping   bool

		def new(src Source) {
			self.src = src
			bySerial = new map<int, int>()
		}

		// Reads the page header at the cursor, none at the end of the file.
		//
		// Fails when the bytes there are not an Ogg page or the reader fails.
		def pageHeader() !?OggPageHeader {
			let offset = src.position()
			let head = try src.peek(oggHeaderSize)
			return none when head.len() < oggHeaderSize
			fail "ogg: no page at {offset}" unless oggCapture(head, 0)
			try src.skip(oggHeaderSize)
			let lacing = try src.read(int(head[26]))
			return oggPageHeader(offset, head, lacing)
		}

		// Reads pages until every stream begun on the first pages has its
		// header packets.
		//
		// Fails when the file is not Ogg, it ends inside the headers, or the
		// reader fails.
		def read() !none {
			for {
				let at = src.position()
				let found = try pageHeader()
				fail "ogg: the file ends inside the headers" when found is none
				let page OggPageHeader = found
				let body = try src.read(page.bodySize)
				if page.flags & 2 != 0 && !bySerial.hasKey(page.serial) {
					let s = new OggStream(page.serial)
					s.headersLeft = 1
					bySerial.set(page.serial, streams.len())
					streams.push(s)
				}
				let slot = bySerial.get(page.serial)
				if slot is none {
					continue
				}
				let index int = slot
				let s = streams[index]
				if s.headersLeft <= 0 {
					// The first data page: read again as packets.
					try src.seek(at) when src.seekable()
					dataStart = at
					splitPage(page, body) unless src.seekable()
					break
				}
				for let (_, packet) in s.joiner.packets(page, body) {
					s.header(packet) when s.headersLeft > 0
				}
				let pending = false
				for let (_, other) in streams {
					pending = true when other.headersLeft > 0
				}
				if !pending {
					dataStart = src.position()
					break
				}
			}
			for let (i, s) in streams {
				s.finishHeaders()
				s.track.index = i
				list.push(s.track)
			}
			if src.seekable() && src.size() > 0 {
				try readLengths()
			}
			return none
		}

		// Takes each stream's length from the granule of its last page in
		// the file's last 64 KB.
		//
		// Fails when the reader does.
		def readLengths() !none {
			let from = (src.size() - 64 * 1024).max(0)
			let tail = try src.bytesAt(from, src.size() - from)
			for let i = 0; i + oggHeaderSize <= tail.len(); i++ {
				continue unless tail[i] == 0x4F && oggCapture(tail, i) && tail[i + 4] == 0
				let granule = le(tail, i + 6, 8)
				continue when granule < 0
				let slot = bySerial.get(le(tail, i + 14, 4))
				continue when slot is none
				let index int = slot
				let s = streams[index]
				let units = s.granuleUnits(granule) + (s.track.codec == "theora" ?? (1, 0))
				let t = s.time(units)
				s.track.length = t when t > s.track.length
			}
			return none
		}

		// Turns the packets a data page completes into packets with
		// timestamps: from the page's granule back, or on from the
		// stream's last position when the page gives none.
		def splitPage(page OggPageHeader, body byte[]) {
			let slot = bySerial.get(page.serial)
			return when slot is none
			let index int = slot
			let s = streams[index]
			let packets = s.joiner.packets(page, body)
			return when packets.len() == 0
			let lengths int[]
			let total = 0
			for let (_, p) in packets {
				let d = s.units(p)
				lengths.push(d)
				total += d
			}
			let start = s.position
			// The last page's granule may cut the stream short of its
			// packets, so it only places a stream nothing has placed yet.
			let last = page.flags & 4 != 0
			if page.granule >= 0 && !(last && start >= 0) {
				let end = s.granuleUnits(page.granule)
				start = s.track.codec == "theora" ?? (end - packets.len() + 1, end - total)
				if last && s.track.codec != "theora" {
					start = s.granuleUnits(0)
					start -= lengths[0] when s.track.codec == "vorbis"
				}
			}
			start = 0 when start < 0 && s.position < 0 && s.track.codec == "theora"
			if last && page.granule >= 0 && s.track.codec != "theora" {
				// The final granule ends the stream where the encoder's input
				// ended: the last packet lasts only up to it.
				let stop = s.granuleUnits(page.granule)
				let before = start + total - lengths[lengths.len() - 1]
				lengths[lengths.len() - 1] = (stop - before).max(0) when stop >= before && stop < start + total
			}
			let at = start
			for let (i, p) in packets {
				let pts = s.time(at)
				let key = s.track.codec != "theora" || (p.len() > 0 && int(p[0]) & 0x40 == 0)
				let length = s.time(at + lengths[i]) - pts
				ready.push(newPacket(index, p, pts, pts, length, key)) when p.len() > 0
				at += lengths[i]
			}
			s.position = at
		}

		// name implements Described.
		def name() string {
			return "ogg"
		}

		// seekable implements Seekable.
		def seekable() bool {
			return src.seekable()
		}

		// tracks implements Container.
		def tracks() Track[] {
			return list
		}

		// next implements Container.
		//
		// Fails when a page is damaged or the reader fails.
		def next() !?Packet {
			for {
				if readyAt < ready.len() {
					let p = ready[readyAt]
					readyAt++
					continue when dropping && p.pts < dropBefore
					dropping = false when dropping && p.keyframe && streams[p.track].track.kind == TrackKind.Video
					return p
				}
				ready = Packet[]
				readyAt = 0
				let found = try pageHeader()
				return none when found is none
				let page OggPageHeader = found
				let body = try src.read(page.bodySize)
				splitPage(page, body)
			}
			return none
		}

		// seek implements Container: reads the page headers from the first
		// data page to find the last video keyframe at or before `time`,
		// resumes at the page before the one it starts on, and drops the
		// packets that present before it.
		//
		// Fails when the source cannot seek or the reader fails.
		def seek(time duration) !none {
			fail "ogg: the stream cannot seek" unless src.seekable()
			let main = -1
			for let (i, s) in streams {
				if s.track.kind == TrackKind.Video {
					main = i
					break
				}
			}
			main = 0 when main < 0 && streams.len() > 0
			let pick = dataStart
			let pickTime = 0s
			if main >= 0 {
				let s = streams[main]
				try src.seek(dataStart)
				let key = 0
				let keyTime = 0s
				let offsets int[]
				let frames int[]
				for {
					let found = try pageHeader()
					break when found is none
					let page OggPageHeader = found
					try src.skip(page.bodySize)
					continue unless page.serial == s.serial && page.granule >= 0
					let units = s.granuleUnits(page.granule)
					break when s.time(units) > time && offsets.len() > 0
					offsets.push(page.offset)
					frames.push(units)
					if s.track.codec == "theora" {
						key = (page.granule >> s.shift) - (s.fromOne ?? (1, 0))
						key = 0 when key < 0
						keyTime = s.time(key)
					} else {
						key = units
						keyTime = s.time(units)
					}
				}
				// The last page that completes a packet before the keyframe.
				for let i = frames.len() - 1; i >= 0; i-- {
					if frames[i] < key {
						pick = offsets[i]
						break
					}
				}
				pickTime = keyTime
			}
			try src.seek(pick)
			for let (_, s) in streams {
				s.joiner.reset()
				s.position = -1
				s.previous = s.blocks.len() > 0 ?? (s.blocks[0], 0)
			}
			ready = Packet[]
			readyAt = 0
			dropBefore = pickTime
			dropping = pick != dataStart || pickTime > 0s
			return none
		}

		// close implements io.Closer: closes the file.
		//
		// Fails when closing it does.
		def close() !none {
			return src.close()
		}
	}
}
