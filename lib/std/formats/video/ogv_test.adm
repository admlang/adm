partial module std.formats.video {
	use (
		std.testing
		std.bytes
		std.data.encoding
	)

	check "OGV" {
		@test()
		def TestOgvTracks() !none {
			let c = try new OGV().open(new bytes.Reader(tinyOgv()))
			let tracks = c.tracks()
			assert tracks.len() == 2
			assert tracks[0].kind == TrackKind.Video && tracks[0].codec == "theora"
			assert tracks[0].width == 64 && tracks[0].height == 48
			assert tracks[0].frameRate.numerator == 5 && tracks[0].frameRate.denominator == 1
			// Three headers, each after a 2-byte length.
			let config = tracks[0].config
			assert config.len() > 42 && int(config[0]) << 8 | int(config[1]) == 42 && config[2] == 0x80
			assert tracks[1].kind == TrackKind.Audio && tracks[1].codec == "vorbis"
			assert tracks[1].sampleRate == 8000 && tracks[1].channels == 1
			assert tracks[1].config.len() > 30 && tracks[1].config[2] == 1
		}

		@test()
		def TestOgvPackets() !none {
			let c = try new OGV().open(new bytes.Reader(tinyOgv()))
			try testing.expectEqual("", try comparePackets(c, tinyOgvPackets()))
		}

		@test()
		def TestOgvOpusPackets() !none {
			let c = try new OGV().open(new bytes.Reader(opusOgv()))
			let tracks = c.tracks()
			assert tracks[1].codec == "opus" && tracks[1].config.len() == 19
			try testing.expectEqual("", try comparePackets(c, opusOgvPackets()))
		}

		@test()
		def TestOgvSeek() !none {
			let c = try new OGV().open(new bytes.Reader(opusOgv()))
			try c.seek(500ms)
			let p = try c.next()
			fail "no packet after the seek" when p is none
			let first Packet = p
			assert first.track == 0 && first.keyframe && int64(first.pts) == 400000000
		}

		@test()
		def TestOgvSound() !none {
			let (vorbis, vorbisPeak) = try soundOf(tinyOgv())
			assert vorbis >= 8000 && vorbis <= 8256
			assert vorbisPeak > 0.1 && vorbisPeak < 0.2
			let (opus, opusPeak) = try soundOf(opusOgv())
			assert opus >= 28800 && opus <= 28800 + 960
			assert opusPeak > 0.1 && opusPeak < 0.2
		}
	}

