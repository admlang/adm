partial module std.formats.video {
	use std.testing

	// plainUnpack is `fromPacked` a sample at a time.
	internal def plainUnpack(data byte[], width int, height int, layout PackedLayout) (byte[], byte[], byte[]) {
		let half = (width + 1) / 2
		let y byte[]
		y.len(width * height)
		let u byte[]
		u.len(half * height)
		let v byte[]
		v.len(half * height)
		let first = layout == PackedLayout.Yuyv ?? (0, 1)
		for let j = 0; j < height; j++ {
			for let i = 0; i + 1 < width; i += 2 {
				let at = j * width * 2 + 2 * i
				y[j * width + i] = data[at + first]
				y[j * width + i + 1] = data[at + first + 2]
				u[j * half + i / 2] = data[at + 1 - first]
				v[j * half + i / 2] = data[at + 3 - first]
			}
		}
		return (y, u, v)
	}

	internal def packedPicture(width int, height int) byte[] {
		let data byte[]
		data.len(width * height * 2)
		let x = 7
		for let i = 0; i < data.len(); i++ {
			x = (x * 1103515245 + 12345) & 0x7fffffff
			data[i] = byte(x >> 16)
		}
		return data
	}

	check "Packed pictures" {
		// Both byte orders, widths that are and are not whole vectors,
		// against the per-sample loop; a short buffer leaves rows black.
		@test()
		def unpacksLikeThePlainLoop() !none {
			for let layout in [PackedLayout.Yuyv, PackedLayout.Uyvy] {
				for let width in [2, 14, 16, 18, 46, 64, 1280] {
					let height = width == 1280 ?? (4, 3)
					let data = packedPicture(width, height)
					let frame = fromPacked(data, width, height, layout)
					let (y, u, v) = plainUnpack(data, width, height, layout)
					assert frame.chroma == ChromaLayout.Yuv422 && int(frame.width) == width && int(frame.height) == height && frame.yStride == width && frame.uvStride == width / 2
					assert frame.y[:width * height].equals(y) && frame.u[:width / 2 * height].equals(u) && frame.v[:width / 2 * height].equals(v)
				}
			}
			let short = fromPacked(packedPicture(16, 2), 16, 4)
			assert short.y[32] == 0 && short.u[16] == 128 && short.v[31] == 128
			return none
		}

		// Rows padded past their pixels, as a driver lays them out for
		// alignment, unpack like tight ones.
		@test()
		def unpacksPaddedRows() !none {
			let width = 46
			let height = 3
			let tight = packedPicture(width, height)
			let stride = 2 * width + 20
			let padded byte[]
			padded.len(stride * height)
			for let j = 0; j < height; j++ {
				tight.slice(j * 2 * width, 2 * width).copy(padded.slice(j * stride, 2 * width))
			}
			let frame = fromPacked(padded, width, height, PackedLayout.Yuyv, stride)
			let (y, u, v) = plainUnpack(tight, width, height, PackedLayout.Yuyv)
			assert frame.y[:width * height].equals(y) && frame.u[:width / 2 * height].equals(u) && frame.v[:width / 2 * height].equals(v)
			return none
		}

		// NV12 at widths that are and are not whole vectors, tight and with
		// padded rows, against a sample at a time; a short buffer leaves the
		// chroma grey.
		@test()
		def splitsSemiPlanarLikeThePlainLoop() !none {
			for let width in [2, 14, 32, 34, 66, 1280] {
				for let pad in [0, 24] {
					let height = 5
					let stride = width + pad
					let half = (width + 1) / 2
					let chromaRows = (height + 1) / 2
					let data = packedPicture(stride, (height + chromaRows + 1) / 2)
					data.len(stride * (height + chromaRows))
					let frame = fromSemiPlanar(data, width, height, pad == 0 ?? (0, stride))
					assert frame.chroma == ChromaLayout.Yuv420 && frame.yStride == width && frame.uvStride == half
					for let j = 0; j < height; j++ {
						for let i = 0; i < width; i++ {
							assert frame.y[j * width + i] == data[j * stride + i]
						}
					}
					for let j = 0; j < chromaRows; j++ {
						for let i = 0; i < half; i++ {
							let at = stride * height + j * stride + 2 * i
							assert frame.u[j * half + i] == data[at] && frame.v[j * half + i] == data[at + 1] onerror fail "width {width} pad {pad}: chroma {i},{j}"
						}
					}
				}
			}
			let short = fromSemiPlanar(packedPicture(16, 4), 16, 8)
			assert short.u[0] == 128 && short.v[7] == 128
			return none
		}

		// A 1280x720 picture unpacked a hundred times, with vectors and a
		// sample at a time.
		@benchmark()
		def BenchUnpack720() {
			let data = packedPicture(1280, 720)
			for let n = 0; n < 100; n++ {
				fromPacked(data, 1280, 720)
			}
		}

		@benchmark()
		def BenchUnpack720Plain() {
			let data = packedPicture(1280, 720)
			for let n = 0; n < 100; n++ {
				plainUnpack(data, 1280, 720, PackedLayout.Yuyv)
			}
		}
	}
}
