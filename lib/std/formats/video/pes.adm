internal partial module std.formats.video.pes {
	use (
		std.formats.video::*
		std.formats.video.demux::*
		std.formats.media.source::*
		std.formats.video.h264::*
	)

	// The fields of a PES packet header that the demultiplexers use.
	struct PesHeader {
		// The stream id: 0xC0-0xDF audio, 0xE0-0xEF video, 0xBD private.
		id     int
		// 90 kHz timestamps, -1 when absent.
		pts    int
		dts    int
		// Bytes from the packet's start code to its payload.
		size   int
		// PES_packet_length: the bytes after the length field, 0 when
		// unbounded.
		length int
	}

	// The 33-bit timestamp of the five bytes at `at`.
	def pesTime(data byte[], at int) int {
		return (int(data[at]) >> 1 & 7) << 30 | int(data[at + 1]) << 22 | (int(data[at + 2]) >> 1) << 15 | int(data[at + 3]) << 7 | int(data[at + 4]) >> 1
	}

	// Whether the stream id carries a PES header with timestamps (audio,
	// video, private stream 1), rather than raw bytes (padding, private
	// stream 2, maps and directories).
	def pesHasHeader(id int) bool {
		return id == 0xBD || id >= 0xC0 && id <= 0xEF || id == 0xFD
	}

	// The PES header at `at`, which starts with 00 00 01 and the stream id,
	// in MPEG-2 or MPEG-1 form; none when the bytes cut it short.
	def pesHeader(data byte[], at int) ?PesHeader {
		return none when at + 6 > data.len()
		let id = int(data[at + 3])
		let length = be(data, at + 4, 2)
		let out = PesHeader{id: id, pts: -1, dts: -1, size: 6, length: length}
		return out unless pesHasHeader(id)
		let i = at + 6
		return none when i >= data.len()
		if int(data[i]) & 0xC0 == 0x80 {
			return none when i + 3 > data.len()
			let flags = int(data[i + 1])
			let headerLength = int(data[i + 2])
			return none when i + 3 + headerLength > data.len()
			if flags & 0x80 != 0 && headerLength >= 5 {
				out.pts = pesTime(data, i + 3)
				out.dts = out.pts
			}
			out.dts = pesTime(data, i + 8) when flags & 0xC0 == 0xC0 && headerLength >= 10
			out.size = 9 + headerLength
			return out
		}
		// MPEG-1: stuffing, an optional buffer size, then the timestamps.
		for i < data.len() && data[i] == 0xFF {
			i++
		}
		return none when i >= data.len()
		i += 2 when int(data[i]) & 0xC0 == 0x40
		return none when i >= data.len()
		let marker = int(data[i]) & 0xF0
		if marker == 0x20 {
			return none when i + 5 > data.len()
			out.pts = pesTime(data, i)
			out.dts = out.pts
			i += 5
		} else if marker == 0x30 {
			return none when i + 10 > data.len()
			out.pts = pesTime(data, i)
			out.dts = pesTime(data, i + 5)
			i += 10
		} else {
			i++
		}
		out.size = i - at
		return out
	}

	// What an elementary stream's first payload says about it.
	type StreamProbe {
		codec      string
		width      int
		height     int
		rateNum    int
		rateDen    int
		aspect     float64
		sampleRate int
		channels   int

		def new(codec string) {
			self.codec = codec
			rateDen = 1
			aspect = 1.0
		}

		// Reads an MPEG-1/2 sequence header, and whether a sequence
		// extension follows it, out of a video payload.
		def video(payload byte[]) {
			let at = findCode(payload, 0, 0xB3)
			return when at < 0 || at + 12 > payload.len()
			width = be(payload, at + 4, 3) >> 12
			height = be(payload, at + 4, 3) & 0xFFF
			let rate = int(payload[at + 7]) & 0xF
			let nums = int[0, 24000, 24, 25, 30000, 30, 50, 60000, 60]
			let dens = int[1, 1001, 1, 1, 1001, 1, 1, 1001, 1]
			if rate > 0 && rate < 9 {
				rateNum = nums[rate]
				rateDen = dens[rate]
			}
			let ext = findCode(payload, at + 4, 0xB5)
			let isMpeg2 = ext >= 0 && ext + 4 < payload.len() && int(payload[ext + 4]) >> 4 == 1
			codec = isMpeg2 ?? ("mpeg2", "mpeg1")
		}

		// Reads the picture size and frame rate out of the first H.264
		// sequence parameter set of an Annex B payload.
		def h264(payload byte[]) {
			let at = 0
			for {
				at = findPrefix(payload, at)
				return when at < 0 || at + 4 > payload.len()
				break when (int(payload[at + 3]) & 0x1F) == 7
				at += 3
			}
			let end = findPrefix(payload, at + 3)
			end = payload.len() when end < 0
			let rbsp byte[]
			rbsp.len(end - at + 8)
			let n = h264Unescape(payload, at + 4, end, rbsp)
			let r = new H264Bits()
			r.reset(rbsp, n)
			let s = h264ParseSps(r) onerror return
			let (_, _, w, h) = h264Crop(s)
			width = w
			height = h
			if s.timeScale > 0 && s.numUnitsInTick > 0 {
				rateNum = s.timeScale
				rateDen = 2 * s.numUnitsInTick
			}
		}

		// Reads the first MPEG audio frame header of a payload: layer, rate
		// and channels.
		def audio(payload byte[]) {
			for let at = 0; at + 4 <= payload.len(); at++ {
				continue unless payload[at] == 0xFF && int(payload[at + 1]) & 0xE0 == 0xE0
				let b1 = int(payload[at + 1])
				let b2 = int(payload[at + 2])
				let version = (b1 >> 3) & 3
				let layer = (b1 >> 1) & 3
				let rateBits = (b2 >> 2) & 3
				continue when version == 1 || layer == 0 || rateBits == 3
				codec = layer == 3 ?? ("mp1", layer == 2 ?? ("mp2", "mp3"))
				let rates = int[44100, 48000, 32000]
				let rate = rates[rateBits]
				rate /= 2 when version == 2
				rate /= 4 when version == 0
				sampleRate = rate
				channels = (int(payload[at + 3]) >> 6) == 3 ?? (1, 2)
				return
			}
		}

		// Reads the first ADTS header of a payload: rate and channels.
		def adts(payload byte[]) {
			for let at = 0; at + 7 <= payload.len(); at++ {
				continue unless payload[at] == 0xFF && int(payload[at + 1]) & 0xF6 == 0xF0
				let index = (int(payload[at + 2]) >> 2) & 0xF
				continue when index >= 13
				let rates = int[96000, 88200, 64000, 48000, 44100, 32000, 24000, 22050, 16000, 12000, 11025, 8000, 7350]
				sampleRate = rates[index]
				channels = (int(payload[at + 2]) & 1) << 2 | int(payload[at + 3]) >> 6
				return
			}
		}

		// Fills the track's format fields from what was found.
		def apply(t Track) {
			t.codec = codec
			if t.kind == TrackKind.Video {
				t.width = uint32(width)
				t.height = uint32(height)
				if rateNum > 0 {
					let g = gcd(rateNum, rateDen)
					t.frameRate = FrameRate{numerator: uint32(rateNum / g), denominator: uint32(rateDen / g)}
				}
			} else if t.kind == TrackKind.Audio {
				t.sampleRate = uint32(sampleRate)
				t.channels = uint16(channels)
			}
		}
	}

	// The offset of the start code 00 00 01 `code` at or after `from`, -1
	// when there is none.
	def findCode(data byte[], from int, code int) int {
		for let i = from; i + 3 < data.len(); i++ {
			continue unless data[i + 2] == 1 && data[i] == 0 && data[i + 1] == 0
			return i when int(data[i + 3]) == code
		}
		return -1
	}

	// The offset of the next start code prefix 00 00 01 at or after `from`,
	// -1 when there is none.
	def findPrefix(data byte[], from int) int {
		for let i = from; i + 2 < data.len(); i++ {
			return i when data[i + 2] == 1 && data[i] == 0 && data[i + 1] == 0
		}
		return -1
	}

	// Whether a video payload starts a picture that decodes on its own: a
	// sequence header or I-picture for MPEG-1/2 and MPEG-4 Part 2, an IDR
	// slice for H.264, an IRAP picture for HEVC.
	def isKeyPayload(codec string, data byte[]) bool {
		if codec := "mpeg1" || "mpeg2" {
			return true when findCode(data, 0, 0xB3) >= 0
			let at = findCode(data, 0, 0x00)
			return at >= 0 && at + 5 < data.len() && (int(data[at + 5]) >> 3) & 7 == 1
		}
		if codec == "mpeg4" {
			let at = findCode(data, 0, 0xB6)
			return at >= 0 && at + 4 < data.len() && int(data[at + 4]) >> 6 == 0
		}
		let hevc = codec == "hevc"
		return true unless codec == "h264" || hevc
		for let i = 0; i + 3 < data.len(); i++ {
			continue unless data[i + 2] == 1 && data[i] == 0 && data[i + 1] == 0
			let header = int(data[i + 3])
			if hevc {
				let kind = (header >> 1) & 0x3F
				return true when kind >= 16 && kind <= 21
			} else {
				let kind = header & 0x1F
				return true when kind == 5
				return false when kind == 1
			}
		}
		return false
	}

	// Bytes read from the end of a program or transport stream to find its
	// last timestamp.
	const tailBytes = 512 * 1024

	// The latest PTS of the PES packets in the bytes of a program stream,
	// walked from their first pack header; -1 when there is none.
	def lastPsTime(data byte[]) int {
		let at = findCode(data, 0, 0xBA)
		return -1 when at < 0
		let best = -1
		for at + 6 <= data.len() {
			if !(data[at] == 0 && data[at + 1] == 0 && data[at + 2] == 1) {
				let next = findCode(data, at + 1, 0xBA)
				break when next < 0
				at = next
				continue
			}
			let code = int(data[at + 3])
			if code == 0xBA {
				break when at + 14 > data.len()
				let mpeg2 = int(data[at + 4]) & 0xC0 == 0x40
				at += mpeg2 ?? (14 + (int(data[at + 13]) & 7), 12)
				continue
			}
			if code <= 0xB9 {
				at += 4
				continue
			}
			let length = be(data, at + 4, 2)
			if pesHasHeader(code) && at + 6 + length <= data.len() {
				let found = pesHeader(data, at)
				if !(found is none) {
					let h PesHeader = found
					best = h.pts when h.pts > best
				}
			}
			at += 6 + length
		}
		return best
	}

	// The latest PTS of the PES packets that start in the bytes of a
	// transport stream with packets of `size` bytes, -1 when there is none.
	def lastTsTime(data byte[], size int, prefix int) int {
		let first = -1
		for let i = 0; i + 3 * size <= data.len(); i++ {
			if data[i + prefix] == 0x47 && data[i + prefix + size] == 0x47 && data[i + prefix + 2 * size] == 0x47 {
				first = i
				break
			}
		}
		return -1 when first < 0
		let best = -1
		for let at = first; at + size <= data.len(); at += size {
			let p = at + prefix
			continue unless data[p] == 0x47 && int(data[p + 1]) & 0x40 != 0
			let control = (int(data[p + 3]) >> 4) & 3
			continue when control & 1 == 0
			let i = p + 4
			i += 1 + int(data[p + 4]) when control & 2 != 0
			continue when i + 14 > p + 188 || be(data, i, 3) != 1
			let found = pesHeader(data[i:p + 188], 0)
			continue when found is none
			let h PesHeader = found
			best = h.pts when h.pts > best
		}
		return best
	}
}
