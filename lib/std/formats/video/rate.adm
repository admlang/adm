partial module std.formats.video {
	// RateBucket keeps an encoder at its bitrate with a leaky bucket:
	// every picture adds its bits and takes out its share of the bitrate,
	// and what the bucket holds is paid back over the next half second.
	// A picture's quantiser follows from the budget that leaves it and
	// from what the pictures before cost at theirs; a key frame gets
	// `keyShares` shares. `steps` holds the quantiser step of every
	// index the codec has, rising; the quantiser stays within `low` and
	// `high`, and moves at most `down` and `up` indexes from one picture
	// to the next (a key frame moves freely).
	internal type RateBucket {
		steps     int[]
		low       int
		high      int
		down      int
		up        int
		// Bits per second aimed for, and the pictures per second they
		// are spread over.
		rate      int
		frameRate int
		// The quantiser index of the picture being coded.
		index     int
		// Bits in the bucket: spent beyond the budget so far (negative:
		// saved).
		debt      int   = 0
		// What a picture costs: its bits times its quantiser step, as
		// the last pictures measured it (0 before any), for pictures
		// coded from the one before and for key frames.
		cost      int   = 0
		keyCost   int   = 0

		def new(steps int[], low int, high int, down int, up int, bitsPerSecond int, frameRate int, index int) {
			self.steps = steps
			self.low = low
			self.high = high
			self.down = down
			self.up = up
			self.frameRate = frameRate.max(1)
			rate = bitsPerSecond.max(10000)
			self.index = index
		}

		// full reports whether the bucket holds more than half a second
		// of the bitrate: the next picture is better not coded.
		def full() bool {
			return debt > rate / 2
		}

		// budget is the bits the next picture may take.
		def budget(key bool) int {
			let share = rate / frameRate
			return share * keyShares when key
			// What the bucket holds is paid back over half a second.
			return (share - debt * 2 / frameRate).max(share / 4).min(share * 2)
		}

		// aim sets the quantiser index for a picture with `budget` bits
		// from what the pictures before cost; the index stays as it is
		// before any was measured.
		def aim(key bool, budget int) {
			let known = key ?? (keyCost, cost)
			index = indexFor(known / budget, key) when known > 0
		}

		// refit moves the index of a key frame that came out as `bits`
		// more than a quarter over or under its budget, and reports
		// whether it moved: the frame is then coded again.
		def refit(bits int, budget int) bool {
			return false unless (bits > budget * 5 / 4 && index < high) || (bits < budget * 3 / 4 && index > low)
			let wanted = indexFor(bits * steps[index] / budget, true)
			return false when wanted == index
			index = wanted
			return true
		}

		// measure records what a coded picture of `bits` cost at the
		// index it was coded with.
		def measure(bits int, key bool) {
			let measured = bits * steps[index]
			if key {
				keyCost = measured
			} else {
				cost = cost == 0 ?? (measured, (cost + measured) / 2)
			}
		}

		// spend puts a packet of `bits` into the bucket and takes the
		// picture's share out. Savings count for a quarter of a second
		// at most, and what is owed for a second: more than that is not
		// paid back by repeating pictures, it is a bitrate that was too
		// low for what had to be coded (a key frame at a few kbit/s).
		def spend(bits int) {
			debt = (debt + bits - rate / frameRate).max(0 - rate / 4).min(rate)
		}

		// indexFor is the quantiser index whose step is the first not
		// below `step`, within what a picture may move from the last
		// one's.
		def indexFor(step int, key bool) int {
			let from = key ?? (low, (index - down).max(low))
			let to = key ?? (high, (index + up).min(high))
			for let i = from; i < to; i++ {
				return i when steps[i] >= step
			}
			return to
		}
	}

	// The shares of the bitrate a key frame may take.
	internal const keyShares = 4
}
