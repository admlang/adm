partial module std.formats.video {
	use std.formats.video.theora::*

	// Theora decodes Theora video (the Theora I specification), the codec of
	// Ogg video: intra and inter frames with the golden frame, four-vector
	// macroblocks, per-block quantisers and the loop filter, in the 4:2:0,
	// 4:2:2 and 4:4:4 pixel formats. The picture region comes out cropped.
	@decoder("theora")
	type Theora {
		// The frame rate the identification header gives; zero until it is
		// read.
		frameRate       FrameRate
		internal dec    TheoraDecoder
		internal frames int

		def new() {
			dec = new TheoraDecoder()
			frameRate = FrameRate{numerator: uint32(0), denominator: uint32(0)}
			frames = 0
		}

		// Reads the three header packets from the track's `config`. An empty
		// `config` leaves them to the first packets. Fails when a header is
		// malformed.
		def configure(track Track) !none {
			dec = new TheoraDecoder()
			frames = 0
			let c = track.config
			let p = 0
			for p + 2 <= c.len() {
				let n = (int(c[p]) << 8) | int(c[p + 1])
				fail "theora: truncated setup bytes" when p + 2 + n > c.len()
				try header(c[p + 2:p + 2 + n].clone())
				p += 2 + n
			}
			return none
		}

		// Decodes one packet: a header packet sets the decoder up and yields
		// nothing, an empty packet repeats the last frame, anything else is a
		// frame. Fails when the packet is damaged, the headers are missing, or
		// the stream starts with an inter frame.
		def decode(packet Packet) !VideoFrame[] {
			let data = packet.data
			if data.len() == 0 {
				return [] when frames == 0
				let again = picture(packet)
				again.keyframe = false
				return [again]
			}
			if (int(data[0]) & 0x80) != 0 {
				try header(data)
				return []
			}
			try dec.decode(data)
			frames++
			return [picture(packet)]
		}

		// Theora holds no frames back, so this is always empty and never fails.
		def flush() !VideoFrame[] {
			return []
		}

		internal def header(data byte[]) !none {
			try dec.header(data)
			if dec.haveInfo {
				frameRate = FrameRate{numerator: uint32(dec.frn), denominator: uint32(dec.frd)}
			}
			return none
		}

		// The picture region of the decoded frame, top row first, stamped with
		// the packet's time.
		internal def picture(packet Packet) VideoFrame {
			let w = dec.picW
			let h = dec.picH
			let top = dec.fmbh * 16 - h - dec.picY
			let sx = dec.csx
			let sy = dec.csy
			let cw = (w + sx) >> sx
			let ch = (h + sy) >> sy
			let pic = dec.cur
			return VideoFrame{
				width:    uint32(w),
				height:   uint32(h),
				y:        flip(pic.y, dec.pw[0], dec.ph[0], dec.picX, top, w, h),
				u:        flip(pic.u, dec.pw[1], dec.ph[1], dec.picX >> sx, top >> sy, cw, ch),
				v:        flip(pic.v, dec.pw[2], dec.ph[2], dec.picX >> sx, top >> sy, cw, ch),
				yStride:  w,
				uvStride: cw,
				time:     packet.pts,
				length:   packet.length,
				keyframe: dec.keyframe,
				matrix:   601,
				chroma:   sx == 0 ?? (ChromaLayout.Yuv444, sy == 0 ?? (ChromaLayout.Yuv422, ChromaLayout.Yuv420))
			}
		}

		// The `w` x `h` region at (`x`, `y`) from the top of a plane stored
		// bottom row first, packed top row first.
		internal def flip(plane byte[], stride int, rows int, x int, y int, w int, h int) byte[] {
			let out byte[]
			out.len(w * h)
			for let j = 0; j < h; j++ {
				let s = (rows - 1 - y - j) * stride + x
				plane[s:s + w].copy(out[j * w:j * w + w])
			}
			return out
		}
	}
}
