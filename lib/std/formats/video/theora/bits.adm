internal partial module std.formats.video.theora {
	// TheoraBits reads a Theora packet most significant bit first. Reads past
	// the end yield zero bits; callers check `exhausted` once per stage
	// rather than on every read.
	type TheoraBits {
		data   byte[]
		pos    int
		end    int
		// Bits not yet consumed, right-aligned in `acc`; `count` of them.
		acc    int
		count  int
		// Zero bytes put in the cache past the end of the packet.
		padded int

		def new(source byte[], start int, stop int) {
			data = source
			pos = start
			end = stop
			acc = 0
			count = 0
			padded = 0
		}

		// Tops the cache up to at least 32 bits.
		def refill() {
			for count <= 48 {
				if pos < end {
					acc = (acc << 8) | int(data[pos])
					pos++
				} else {
					acc = acc << 8
					padded++
				}
				count += 8
			}
		}

		// Reads an `n`-bit unsigned value, `n` at most 32.
		def bits(n int) int {
			return 0 when n == 0
			refill() when count < n
			count -= n
			let v = (acc >> count) & ((1 << n) - 1)
			acc = acc & ((1 << count) - 1)
			return v
		}

		def bit() bool {
			refill() when count < 1
			count--
			let v = (acc >> count) & 1
			acc = acc & ((1 << count) - 1)
			return v == 1
		}

		// The next 8 bits without consuming them.
		def peek8() int {
			refill() when count < 8
			return (acc >> (count - 8)) & 255
		}

		def skip(n int) {
			refill() when count < n
			count -= n
			acc = acc & ((1 << count) - 1)
		}

		// Whether a read went past the end of the packet.
		def exhausted() bool {
			return padded * 8 > count
		}
	}
}
