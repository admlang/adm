internal partial module std.formats.video.theora {
	// TheoraPicture is one decoded frame: three planes stored bottom row
	// first, as Theora codes them, each a whole number of blocks wide and
	// high.
	type TheoraPicture {
		// Tells the pictures of a decoder's pool apart.
		id int
		y  byte[]
		u  byte[]
		v  byte[]

		def new(n int, py byte[], pu byte[], pv byte[]) {
			id = n
			y = py
			u = pu
			v = pv
		}

		def plane(p int) byte[] {
			return p == 0 ?? (y, p == 1 ?? (u, v))
		}
	}

	// TheoraDecoder decodes the three Theora headers and then frames, keeping
	// the previous and golden frames that inter frames predict from.
	type TheoraDecoder {
		haveInfo    bool
		haveSetup   bool
		// Frame size in macroblocks, the picture region inside it (`picY`
		// counted from the bottom), the frame rate, pixel aspect, colour space
		// and pixel format (0 for 4:2:0, 2 for 4:2:2, 3 for 4:4:4).
		fmbw        int
		fmbh        int
		picW        int
		picH        int
		picX        int
		picY        int
		frn         int
		frd         int
		parn        int
		pard        int
		colorSpace  int
		pixelFormat int

		lflims  int[]
		acScale int[]
		dcScale int[]
		// Dequantisation factors by [intra or inter][plane][qi][position],
		// positions in raster order.
		qmat    int[]
		huff    TheoraHuffman

		// Per plane: size in blocks and pixels, first block and first
		// superblock.
		nbw      int[]
		nbh      int[]
		pw       int[]
		ph       int[]
		bBase    int[]
		sbw      int[]
		sbh      int[]
		sbBase   int[]
		nBlocks  int
		nSb      int
		// Blocks of each superblock in coding order, -1 past the plane.
		sbBlocks int[]
		// Every block in coding order, the list of an intra frame.
		allCoded int[]
		// Macroblocks in coding order.
		mbOrder  int[]
		// Chroma subsampling shifts.
		csx      int
		csy      int

		keyframe  bool
		nqis      int
		qis       int[]
		// Per block: coded, mode, vector, qi index, next coefficient index and
		// coefficients coded, coefficients in zig-zag order.
		coded     int[]
		mode      int[]
		mvx       int[]
		mvy       int[]
		qii       int[]
		tis       int[]
		ncoef     int[]
		coeffs    int[]
		codedList int[]
		nCoded    int
		mbMode    int[]
		sbFlag    int[]
		runs      int[]
		active    int[]
		alphabet  int[]
		blk       int[]
		bound     int[]

		// The frames inter frames predict from and the last decoded one;
		// `havePrev` says whether an intra frame came yet.
		prev     TheoraPicture
		golden   TheoraPicture
		cur      TheoraPicture
		havePrev bool
		// Pictures to decode into, made as needed: at most three.
		pool     TheoraPicture[]

		def new() {
			haveInfo = false
			haveSetup = false
			lflims = thZeros(64)
			acScale = thZeros(64)
			dcScale = thZeros(64)
			qmat = thZeros(2 * 3 * 64 * 64)
			huff = new TheoraHuffman()
			qis = thZeros(3)
			alphabet = thZeros(8)
			blk = thZeros(64)
			bound = thZeros(256)
			prev = new TheoraPicture(-1, [], [], [])
			pool = []
			golden = prev
			cur = prev
			havePrev = false
		}

		// Reads one of the three header packets. Fails when the packet is not a
		// Theora header, comes out of order, or is malformed.
		def header(data byte[]) !none {
			fail "theora: truncated header" when data.len() < 7
			let kind = int(data[0])
			fail "theora: not a Theora header" unless string(data[1:7]) == "theora"
			let br = new TheoraBits(data, 7, data.len())
			if kind == 0x80 {
				try parseInfo(br)
			} else if kind == 0x81 {
				fail "theora: comment header before identification header" unless haveInfo
			} else if kind == 0x82 {
				fail "theora: setup header before identification header" unless haveInfo
				try parseSetup(br)
			} else {
				fail "theora: unknown header packet"
			}
			return none
		}

		def parseInfo(br TheoraBits) !none {
			let vmaj = br.bits(8)
			let vmin = br.bits(8)
			br.bits(8)
			fail "theora: unsupported bitstream version {vmaj}.{vmin}" unless vmaj == 3 && vmin == 2
			fmbw = br.bits(16)
			fmbh = br.bits(16)
			picW = br.bits(24)
			picH = br.bits(24)
			picX = br.bits(8)
			picY = br.bits(8)
			frn = br.bits(32)
			frd = br.bits(32)
			parn = br.bits(24)
			pard = br.bits(24)
			colorSpace = br.bits(8)
			br.bits(24)
			br.bits(6)
			br.bits(5)
			pixelFormat = br.bits(2)
			br.bits(3)
			fail "theora: truncated identification header" when br.exhausted()
			fail "theora: bad frame size" when fmbw == 0 || fmbh == 0 || fmbw > 4096 || fmbh > 4096
			fail "theora: bad picture region" when picW == 0 || picH == 0 || picX + picW > fmbw * 16 || picY + picH > fmbh * 16
			fail "theora: reserved pixel format" when pixelFormat == 1
			layout()
			haveInfo = true
			return none
		}

		// Works out the block, superblock and macroblock layout of the frame.
		def layout() {
			csx = pixelFormat == 3 ?? (0, 1)
			csy = pixelFormat == 0 ?? (1, 0)
			nbw = int[2 * fmbw, (2 * fmbw) >> csx, (2 * fmbw) >> csx]
			nbh = int[2 * fmbh, (2 * fmbh) >> csy, (2 * fmbh) >> csy]
			pw = thZeros(3)
			ph = thZeros(3)
			bBase = thZeros(3)
			sbw = thZeros(3)
			sbh = thZeros(3)
			sbBase = thZeros(3)
			nBlocks = 0
			nSb = 0
			for let p = 0; p < 3; p++ {
				pw[p] = nbw[p] * 8
				ph[p] = nbh[p] * 8
				bBase[p] = nBlocks
				nBlocks += nbw[p] * nbh[p]
				sbw[p] = (nbw[p] + 3) >> 2
				sbh[p] = (nbh[p] + 3) >> 2
				sbBase[p] = nSb
				nSb += sbw[p] * sbh[p]
			}
			sbBlocks = thZeros(nSb * 16)
			allCoded = thZeros(nBlocks)
			let n = 0
			for let p = 0; p < 3; p++ {
				for let sy = 0; sy < sbh[p]; sy++ {
					for let sx = 0; sx < sbw[p]; sx++ {
						let sb = sbBase[p] + sy * sbw[p] + sx
						for let j = 0; j < 16; j++ {
							let bx = sx * 4 + thHilbert[2 * j]
							let by = sy * 4 + thHilbert[2 * j + 1]
							if bx < nbw[p] && by < nbh[p] {
								let b = bBase[p] + by * nbw[p] + bx
								sbBlocks[sb * 16 + j] = b
								allCoded[n] = b
								n++
							} else {
								sbBlocks[sb * 16 + j] = -1
							}
						}
					}
				}
			}
			mbOrder = []
			for let sy = 0; sy < sbh[0]; sy++ {
				for let sx = 0; sx < sbw[0]; sx++ {
					for let j = 0; j < 4; j++ {
						let mx = 2 * sx + (j >> 1)
						let my = 2 * sy + (((j >> 1) + j) & 1)
						mbOrder.push(my * fmbw + mx) when mx < fmbw && my < fmbh
					}
				}
			}
			coded = thZeros(nBlocks)
			mode = thZeros(nBlocks)
			mvx = thZeros(nBlocks)
			mvy = thZeros(nBlocks)
			qii = thZeros(nBlocks)
			tis = thZeros(nBlocks)
			ncoef = thZeros(nBlocks)
			coeffs = thZeros(nBlocks * 64)
			codedList = thZeros(nBlocks)
			active = thZeros(nBlocks)
			runs = thZeros(nBlocks > nSb ?? (nBlocks, nSb))
			mbMode = thZeros(fmbw * fmbh)
			sbFlag = thZeros(nSb)
			havePrev = false
			pool = []
		}

		def parseSetup(br TheoraBits) !none {
			let nbits = br.bits(3)
			for let i = 0; i < 64; i++ {
				lflims[i] = br.bits(nbits)
			}
			nbits = br.bits(4) + 1
			for let i = 0; i < 64; i++ {
				acScale[i] = br.bits(nbits)
			}
			nbits = br.bits(4) + 1
			for let i = 0; i < 64; i++ {
				dcScale[i] = br.bits(nbits)
			}
			let nbms = br.bits(9) + 1
			fail "theora: too many base matrices" when nbms > 384
			let bms = thZeros(nbms * 64)
			for let i = 0; i < nbms * 64; i++ {
				bms[i] = br.bits(8)
			}
			// Quant ranges by [intra or inter][plane]: count, sizes and base
			// matrix indices.
			let qrCount = thZeros(6)
			let qrSize = thZeros(6 * 64)
			let qrBase = thZeros(6 * 65)
			for let qti = 0; qti < 2; qti++ {
				for let pli = 0; pli < 3; pli++ {
					let k = qti * 3 + pli
					let fresh = (qti == 0 && pli == 0) || br.bit()
					if !fresh {
						let src = 0
						if qti > 0 && br.bit() {
							src = pli
						} else {
							src = (3 * qti + pli - 1) / 3 * 3 + (pli + 2) % 3
						}
						qrCount[k] = qrCount[src]
						for let i = 0; i < 64; i++ {
							qrSize[k * 64 + i] = qrSize[src * 64 + i]
						}
						for let i = 0; i < 65; i++ {
							qrBase[k * 65 + i] = qrBase[src * 65 + i]
						}
						continue
					}
					let qri = 0
					let qi = 0
					let mbits = thIlog(nbms - 1)
					for {
						let bmi = br.bits(mbits)
						fail "theora: bad base matrix index" when bmi >= nbms
						qrBase[k * 65 + qri] = bmi
						break when qi >= 63
						let size = br.bits(thIlog(62 - qi)) + 1
						qrSize[k * 64 + qri] = size
						qri++
						qi += size
						fail "theora: bad quant ranges" when br.exhausted()
					}
					fail "theora: bad quant ranges" when qi > 63
					qrCount[k] = qri
				}
			}
			try huff.read(br)
			fail "theora: truncated setup header" when br.exhausted()
			for let k = 0; k < 6; k++ {
				let qti = k / 3
				for let qi = 0; qi < 64; qi++ {
					let sum = 0
					let qri = 0
					for qri = 0; qri < qrCount[k]; qri++ {
						sum += qrSize[k * 64 + qri]
						break when qi <= sum
					}
					let size = qrSize[k * 64 + qri]
					let start = sum - size
					let bmi = qrBase[k * 65 + qri]
					let bmj = qrBase[k * 65 + qri + 1]
					for let ci = 0; ci < 64; ci++ {
						let bm = (2 * (sum - qi) * bms[bmi * 64 + ci] + 2 * (qi - start) * bms[bmj * 64 + ci] + size) / (2 * size)
						let qmin = 8 << (qti + (ci == 0 ?? (1, 0)))
						let scale = ci == 0 ?? (dcScale[qi], acScale[qi])
						let q = scale * bm / 100 * 4
						q = q < qmin ?? (qmin, q > 4096 ?? (4096, q))
						qmat[(k * 64 + qi) * 64 + ci] = q
					}
				}
			}
			haveSetup = true
			return none
		}

		// Decodes one frame packet into `cur`. Fails when the packet is
		// damaged, or when an inter frame comes before any intra frame.
		def decode(data byte[]) !none {
			fail "theora: frame before the setup header" unless haveSetup
			let br = new TheoraBits(data, 0, data.len())
			fail "theora: header packet among the frames" when br.bit()
			keyframe = !br.bit()
			qis[0] = br.bits(6)
			nqis = 1
			if br.bit() {
				qis[1] = br.bits(6)
				nqis = 2
				if br.bit() {
					qis[2] = br.bits(6)
					nqis = 3
				}
			}
			br.bits(3) when keyframe
			fail "theora: inter frame before the first intra frame" when !keyframe && !havePrev
			fail "theora: truncated frame" when br.exhausted()

			let pic = freePicture()
			if !keyframe {
				prev.y.copy(pic.y)
				prev.u.copy(pic.u)
				prev.v.copy(pic.v)
			}
			try codedBlocks(br)
			if keyframe {
				for let i = 0; i < nCoded; i++ {
					mode[codedList[i]] = thModeIntra
				}
			} else {
				try modes(br)
				try vectors(br)
			}
			try blockQis(br)
			try tokens(br)
			for let p = 0; p < 3; p++ {
				predictDC(p)
			}
			for let i = 0; i < nCoded; i++ {
				reconstruct(codedList[i], pic)
			}
			let lim = lflims[qis[0]]
			if lim > 0 {
				limitFilter(lim)
				for let p = 0; p < 3; p++ {
					loopFilter(p, pic.plane(p))
				}
			}
			cur = pic
			prev = pic
			golden = pic when keyframe
			havePrev = true
			return none
		}

		// A picture of the pool that is neither the previous nor the golden
		// frame, made when there is none.
		def freePicture() TheoraPicture {
			for let (_, p) in pool {
				return p unless havePrev && (p.id == prev.id || p.id == golden.id)
			}
			let p = new TheoraPicture(pool.len(), thBytes(pw[0] * ph[0]), thBytes(pw[1] * ph[1]), thBytes(pw[2] * ph[2]))
			pool.push(p)
			return p
		}

		// Marks the coded blocks and lists them in coding order.
		def codedBlocks(br TheoraBits) !none {
			nCoded = 0
			if keyframe {
				for let i = 0; i < nBlocks; i++ {
					let b = allCoded[i]
					coded[b] = 1
					codedList[i] = b
				}
				nCoded = nBlocks
			} else {
				try longRuns(br, nSb, sbFlag)
				let partials = 0
				for let i = 0; i < nSb; i++ {
					partials += sbFlag[i]
				}
				if partials < nSb {
					try longRuns(br, nSb - partials, runs)
					let k = 0
					for let i = 0; i < nSb; i++ {
						if sbFlag[i] == 0 {
							sbFlag[i] = 2 * runs[k]
							k++
						}
					}
				}
				let bit = false
				let run = 0
				bit = !br.bit() when partials > 0
				for let sb = 0; sb < nSb; sb++ {
					let f = sbFlag[sb]
					for let j = 0; j < 16; j++ {
						let b = sbBlocks[sb * 16 + j]
						continue when b < 0
						let c = f == 2
						if f == 1 {
							if run == 0 {
								bit = !bit
								run = thShortRun(br)
							}
							run--
							c = bit
						}
						if c {
							coded[b] = 1
							codedList[nCoded] = b
							nCoded++
						} else {
							coded[b] = 0
						}
					}
				}
			}
			for let i = 0; i < nCoded; i++ {
				let b = codedList[i]
				mode[b] = thModeInterNoMv
				mvx[b] = 0
				mvy[b] = 0
				qii[b] = 0
				tis[b] = 0
				ncoef[b] = 0
				coeffs.fill(0, b * 64, b * 64 + 64)
			}
			fail "theora: truncated frame" when br.exhausted()
			return none
		}

		// Reads `n` flags coded as runs of the long run code into `out`.
		def longRuns(br TheoraBits, n int, out int[]) !none {
			return none when n == 0
			let bit = br.bit()
			let i = 0
			let run = 0
			for i < n {
				bit = run == 4129 ?? (br.bit(), !bit) when i > 0
				run = thLongRun(br)
				fail "theora: bad run length" when i + run > n || br.exhausted()
				let v = bit ?? (1, 0)
				for let k = 0; k < run; k++ {
					out[i + k] = v
				}
				i += run
			}
			return none
		}

		// The luma block `k` (0 to 3, bottom row first) of macroblock `mb`.
		def lumaBlock(mb int, k int) int {
			let mx = mb % fmbw
			let my = mb / fmbw
			return (2 * my + (k >> 1)) * nbw[0] + 2 * mx + (k & 1)
		}

		// Reads the macroblock modes and gives them to the coded blocks.
		def modes(br TheoraBits) !none {
			let scheme = br.bits(3)
			if scheme == 0 {
				for let i = 0; i < 8; i++ {
					alphabet[br.bits(3)] = i
				}
			} else if scheme < 7 {
				for let i = 0; i < 8; i++ {
					alphabet[i] = thModeAlphabets[(scheme - 1) * 8 + i]
				}
			}
			for let (_, mb) in mbOrder {
				let any = false
				for let k = 0; k < 4; k++ {
					any = true when coded[lumaBlock(mb, k)] == 1
				}
				if !any {
					mbMode[mb] = thModeInterNoMv
					continue
				}
				let m = 0
				if scheme == 7 {
					m = br.bits(3)
				} else {
					let i = 0
					for i < 7 && br.bit() {
						i++
					}
					m = alphabet[i]
				}
				mbMode[mb] = m
				for let k = 0; k < 4; k++ {
					let b = lumaBlock(mb, k)
					mode[b] = m when coded[b] == 1
				}
				let mx = mb % fmbw
				let my = mb / fmbw
				for let p = 1; p < 3; p++ {
					for let k = 0; k < 4; k++ {
						let b = chromaBlock(p, mx, my, k)
						mode[b] = m when b >= 0 && coded[b] == 1
					}
				}
			}
			fail "theora: truncated frame" when br.exhausted()
			return none
		}

		// Chroma block `k` of the macroblock at (`mx`, `my`) in plane `p`, -1
		// past the blocks the pixel format gives a macroblock.
		def chromaBlock(p int, mx int, my int, k int) int {
			return k == 0 ?? (bBase[p] + my * nbw[p] + mx, -1) when csx == 1 && csy == 1
			return k < 2 ?? (bBase[p] + (2 * my + k) * nbw[p] + mx, -1) when csx == 1
			return bBase[p] + (2 * my + (k >> 1)) * nbw[p] + 2 * mx + (k & 1)
		}

		def readVector(br TheoraBits, fixed bool) int {
			if fixed {
				let v = br.bits(5)
				return br.bit() ?? (0 - v, v)
			}
			let c = br.bits(3)
			return c == 0 ?? (0, c == 1 ?? (1, -1)) when c < 3
			let v = 0
			if c == 3 {
				v = 2
			} else if c == 4 {
				v = 3
			} else if c == 5 {
				v = 4 + br.bits(2)
			} else if c == 6 {
				v = 8 + br.bits(3)
			} else {
				v = 16 + br.bits(4)
			}
			return br.bit() ?? (0 - v, v)
		}

		// Reads the motion vectors of the macroblocks that code them and
		// works out the vector of every block.
		def vectors(br TheoraBits) !none {
			let fixed = br.bit()
			let lastX = 0
			let lastY = 0
			let last2X = 0
			let last2Y = 0
			let vx = thZeros(4)
			let vy = thZeros(4)
			for let (_, mb) in mbOrder {
				let m = mbMode[mb]
				vx.fill(0)
				vy.fill(0)
				if m == thModeInterFourMv {
					last2X = lastX
					last2Y = lastY
					for let k = 0; k < 4; k++ {
						if coded[lumaBlock(mb, k)] == 1 {
							vx[k] = readVector(br, fixed)
							vy[k] = readVector(br, fixed)
							lastX = vx[k]
							lastY = vy[k]
						}
					}
				} else {
					let x = 0
					let y = 0
					if m == thModeInterMv || m == thModeGoldenMv {
						x = readVector(br, fixed)
						y = readVector(br, fixed)
						if m == thModeInterMv {
							last2X = lastX
							last2Y = lastY
							lastX = x
							lastY = y
						}
					} else if m == thModeInterLast {
						x = lastX
						y = lastY
					} else if m == thModeInterLast2 {
						x = last2X
						y = last2Y
						last2X = lastX
						last2Y = lastY
						lastX = x
						lastY = y
					}
					vx.fill(x)
					vy.fill(y)
				}
				for let k = 0; k < 4; k++ {
					let b = lumaBlock(mb, k)
					mvx[b] = vx[k]
					mvy[b] = vy[k]
				}
				chromaVectors(mb, m == thModeInterFourMv, vx, vy)
			}
			fail "theora: truncated frame" when br.exhausted()
			return none
		}

		// Gives the chroma blocks of a macroblock their vectors, averaged
		// from the luma ones in half-pixel units of the chroma plane.
		def chromaVectors(mb int, four bool, vx int[], vy int[]) {
			let mx = mb % fmbw
			let my = mb / fmbw
			if csx == 1 && csy == 1 {
				let x = four ?? (thRoundShift(vx[0] + vx[1] + vx[2] + vx[3], 2), vx[0])
				let y = four ?? (thRoundShift(vy[0] + vy[1] + vy[2] + vy[3], 2), vy[0])
				x = (x >> 1) | (x & 1)
				y = (y >> 1) | (y & 1)
				for let p = 1; p < 3; p++ {
					let b = chromaBlock(p, mx, my, 0)
					mvx[b] = x
					mvy[b] = y
				}
			} else if csx == 1 {
				for let k = 0; k < 2; k++ {
					let x = four ?? (thRoundShift(vx[2 * k] + vx[2 * k + 1], 1), vx[0])
					let y = four ?? (thRoundShift(vy[2 * k] + vy[2 * k + 1], 1), vy[0])
					x = (x >> 1) | (x & 1)
					for let p = 1; p < 3; p++ {
						let b = chromaBlock(p, mx, my, k)
						mvx[b] = x
						mvy[b] = y
					}
				}
			} else {
				for let k = 0; k < 4; k++ {
					for let p = 1; p < 3; p++ {
						let b = chromaBlock(p, mx, my, k)
						mvx[b] = vx[k]
						mvy[b] = vy[k]
					}
				}
			}
		}

		// Reads which of the frame's quantisers each coded block uses.
		def blockQis(br TheoraBits) !none {
			for let q = 0; q < nqis - 1; q++ {
				let n = 0
				for let i = 0; i < nCoded; i++ {
					n++ when qii[codedList[i]] == q
				}
				break when n == 0
				try longRuns(br, n, runs)
				let k = 0
				for let i = 0; i < nCoded; i++ {
					let b = codedList[i]
					if qii[b] == q {
						qii[b] += runs[k]
						k++
					}
				}
			}
			return none
		}

		// Reads the DCT tokens: coefficient by coefficient, each coded block
		// that has not ended takes its next token, with runs of zeros and of
		// ended blocks spanning blocks and coefficients.
		def tokens(br TheoraBits) !none {
			let nActive = nCoded
			for let i = 0; i < nCoded; i++ {
				active[i] = codedList[i]
			}
			let eobRun = 0
			let htY = 0
			let htC = 0
			let b1 = bBase[1]
			for let ti = 0; ti < 64; ti++ {
				if ti <= 1 {
					htY = br.bits(4)
					htC = br.bits(4)
				}
				let group = ti == 0 ?? (0, ti <= 5 ?? (1, ti <= 14 ?? (2, ti <= 27 ?? (3, 4))))
				let tY = group * 16 + htY
				let tC = group * 16 + htC
				let keep = 0
				for let a = 0; a < nActive; a++ {
					let b = active[a]
					if tis[b] != ti {
						active[keep] = b
						keep++
						continue
					}
					if eobRun > 0 {
						eobRun--
						ncoef[b] = ti
						tis[b] = 64
						continue
					}
					let token = huff.decode(br, b < b1 ?? (tY, tC))
					if token < 7 {
						if token < 3 {
							eobRun = token + 1
						} else if token < 6 {
							eobRun = (1 << (token - 1)) + br.bits(token - 1)
						} else {
							eobRun = br.bits(12)
							eobRun = nBlocks * 64 when eobRun == 0
						}
						eobRun--
						ncoef[b] = ti
						tis[b] = 64
						continue
					}
					let run = 0
					let value = 0
					if token == 7 {
						run = br.bits(3) + 1
					} else if token == 8 {
						run = br.bits(6) + 1
					} else if token < 13 {
						value = token < 11 ?? (token == 9 ?? (1, -1), token == 11 ?? (2, -2))
					} else if token < 17 {
						value = br.bit() ?? (10 - token, token - 10)
					} else if token < 23 {
						let n = token < 22 ?? (token - 15, 10)
						let x = br.bits(n)
						let mag = x & ((1 << (n - 1)) - 1)
						mag += token == 17 ?? (7, token == 18 ?? (9, token == 19 ?? (13, token == 20 ?? (21, token == 21 ?? (37, 69)))))
						value = (x >> (n - 1)) == 1 ?? (0 - mag, mag)
					} else if token < 28 {
						value = br.bit() ?? (-1, 1)
						run = token - 22
					} else if token == 28 {
						value = br.bit() ?? (-1, 1)
						run = 6 + br.bits(2)
					} else if token == 29 {
						value = br.bit() ?? (-1, 1)
						run = 10 + br.bits(3)
					} else {
						let x = br.bits(2)
						let mag = 2 + (x & 1)
						value = (x >> 1) == 1 ?? (0 - mag, mag)
						run = token == 30 ?? (1, 2 + br.bits(1))
					}
					let t = ti + run
					if token > 8 {
						fail "theora: coefficient run past the block" when t > 63
						coeffs[b * 64 + t] = value
						t++
					} else {
						fail "theora: coefficient run past the block" when t > 64
					}
					tis[b] = t
					if t < 64 {
						active[keep] = b
						keep++
					} else {
						ncoef[b] = 64
					}
				}
				nActive = keep
				fail "theora: truncated frame" when br.exhausted()
			}
			return none
		}

		// Undoes the prediction of the DC coefficients of plane `p` from the
		// neighbours below and to the left that use the same reference frame.
		def predictDC(p int) {
			let lastDC = int[0, 0, 0]
			let w = nbw[p]
			let h = nbh[p]
			let base = bBase[p]
			for let by = 0; by < h; by++ {
				for let bx = 0; bx < w; bx++ {
					let b = base + by * w + bx
					continue when coded[b] == 0
					let fr = thModeFrame[mode[b]]
					let mask = 0
					let vl = 0
					let vd = 0
					let vdl = 0
					let vdr = 0
					if bx > 0 {
						let n = b - 1
						vl = coeffs[n * 64]
						mask = mask | 1 when coded[n] == 1 && thModeFrame[mode[n]] == fr
					}
					if by > 0 {
						let n = b - w
						vd = coeffs[n * 64]
						mask = mask | 4 when coded[n] == 1 && thModeFrame[mode[n]] == fr
						if bx > 0 {
							vdl = coeffs[(n - 1) * 64]
							mask = mask | 8 when coded[n - 1] == 1 && thModeFrame[mode[n - 1]] == fr
						}
						if bx + 1 < w {
							vdr = coeffs[(n + 1) * 64]
							mask = mask | 2 when coded[n + 1] == 1 && thModeFrame[mode[n + 1]] == fr
						}
					}
					let pred = 0
					if mask == 0 {
						pred = lastDC[fr]
					} else {
						let o = mask * 4
						pred = thDcWeights[o] * vdl + thDcWeights[o + 1] * vd + thDcWeights[o + 2] * vdr + thDcWeights[o + 3] * vl
						pred = pred < 0 ?? (0 - ((0 - pred) / 128), pred / 128)
						if mask := 13 || 15 {
							if thAbs(pred - vd) > 128 {
								pred = vd
							} else if thAbs(pred - vl) > 128 {
								pred = vl
							} else if thAbs(pred - vdl) > 128 {
								pred = vdl
							}
						}
					}
					let dc = coeffs[b * 64] + pred
					coeffs[b * 64] = dc
					lastDC[fr] = dc
				}
			}
		}

		// Rebuilds coded block `b` in `pic`: its prediction, then the inverse
		// DCT of its dequantised coefficients.
		def reconstruct(b int, pic TheoraPicture) {
			let p = b >= bBase[2] ?? (2, b >= bBase[1] ?? (1, 0))
			let local = b - bBase[p]
			let w = nbw[p]
			let bx = local % w
			let by = local / w
			let stride = pw[p]
			let dst = pic.plane(p)
			let at = by * 8 * stride + bx * 8
			let m = mode[b]
			let intra = m == thModeIntra
			let k = intra ?? (p, 3 + p)
			let q = (k * 64 + qis[qii[b]]) * 64
			let q0 = (k * 64 + qis[0]) * 64
			let c = b * 64
			if !intra {
				let ref = (m == thModeGoldenNoMv || m == thModeGoldenMv) ?? (golden, prev)
				thPredict(ref.plane(p), stride, ph[p], bx * 8, by * 8, mvx[b], mvy[b], dst, at)
				if ncoef[b] == 0 {
					thAddDC(dst, at, stride, (coeffs[c] * qmat[q0] + 15) >> 5)
					return
				}
			}
			blk.fill(0)
			blk[0] = coeffs[c] * qmat[q0]
			let n = ncoef[b]
			for let i = 1; i < n; i++ {
				let v = coeffs[c + i]
				if v != 0 {
					let z = thZigzag[i]
					blk[z] = v * qmat[q + z]
				}
			}
			thIdct(blk, dst, at, stride, intra)
		}

		// The loop filter limits for a filter limit value.
		def limitFilter(lim int) {
			bound.fill(0)
			for let x = 0; x < lim; x++ {
				bound[127 + x] = x
				bound[127 - x] = 0 - x
			}
			let value = lim
			for let x = lim; x < 128 && value > 0; x++ {
				bound[127 + x] = value
				bound[127 - x] = 0 - value
				value--
			}
			bound[255] = value when value > 0
		}

		// Smooths the edges of the coded blocks of one plane, block by block
		// from the bottom row: left, bottom, and right and top where that
		// neighbour is not coded.
		def loopFilter(p int, pix byte[]) {
			let w = nbw[p]
			let h = nbh[p]
			let stride = pw[p]
			let base = bBase[p]
			for let by = 0; by < h; by++ {
				for let bx = 0; bx < w; bx++ {
					let b = base + by * w + bx
					continue when coded[b] == 0
					let at = by * 8 * stride + bx * 8
					thFilterH(pix, at, stride, bound) when bx > 0
					thFilterV(pix, at, stride, bound) when by > 0
					thFilterH(pix, at + 8, stride, bound) when bx < w - 1 && coded[b + 1] == 0
					thFilterV(pix, at + 8 * stride, stride, bound) when by < h - 1 && coded[b + w] == 0
				}
			}
		}
	}
}
