internal partial module std.formats.video.theora {
	// TheoraHuffman holds the 80 token codes a stream's setup header
	// defines: 16 for DC coefficients and 16 for each of four groups of AC
	// coefficients.
	type TheoraHuffman {
		// Per table and node, the child for a 0 bit and for a 1 bit: a node
		// when non-negative, else the leaf `-1 - token`.
		zero   int[]
		one    int[]
		// The token of a table whose only code is empty, else -1.
		single int[]
		// Per table and value of the next eight bits: `token * 16 + length`
		// when a code ends within them, else `-1 - node` for the node they
		// lead to.
		lut    int[]
		nodes  int
		leaves int

		def new() {
			zero = thZeros(80 * 32)
			one = thZeros(80 * 32)
			single = thZeros(80)
			lut = thZeros(80 * 256)
			nodes = 0
			leaves = 0
		}

		// Reads the 80 code trees. Fails when a tree is deeper than 32 bits
		// or has more than 32 leaves.
		def read(br TheoraBits) !none {
			for let t = 0; t < 80; t++ {
				nodes = 0
				leaves = 0
				let root = try readNode(br, t, 0)
				single[t] = root < 0 ?? (-1 - root, -1)
				buildLut(t) when root >= 0
			}
			return none
		}

		def readNode(br TheoraBits, t int, depth int) !int {
			fail "theora: bad Huffman table" when depth > 32 || br.exhausted()
			if br.bit() {
				leaves++
				fail "theora: bad Huffman table" when leaves > 32
				return -1 - br.bits(5)
			}
			let n = nodes
			nodes++
			fail "theora: bad Huffman table" when nodes > 32
			zero[t * 32 + n] = try readNode(br, t, depth + 1)
			one[t * 32 + n] = try readNode(br, t, depth + 1)
			return n
		}

		def buildLut(t int) {
			for let p = 0; p < 256; p++ {
				let node = 0
				let e = 0
				for let i = 0; i < 8; i++ {
					let c = ((p >> (7 - i)) & 1) == 1 ?? (one[t * 32 + node], zero[t * 32 + node])
					if c < 0 {
						e = (-1 - c) * 16 + i + 1
						break
					}
					node = c
					e = -1 - node
				}
				lut[t * 256 + p] = e
			}
		}

		// Reads one token with table `t`.
		def decode(br TheoraBits, t int) int {
			let s = single[t]
			return s when s >= 0
			let e = lut[t * 256 + br.peek8()]
			if e >= 0 {
				br.skip(e & 15)
				return e >> 4
			}
			br.skip(8)
			let base = t * 32
			let node = -1 - e
			for {
				let c = br.bit() ?? (one[base + node], zero[base + node])
				return -1 - c when c < 0
				node = c
			}
			return 0
		}
	}

	def thZeros(n int) int[] {
		let a int[]
		a.len(n)
		a.fill(0)
		return a
	}

	def thBytes(n int) byte[] {
		let a byte[]
		a.len(n)
		a.fill(byte(0))
		return a
	}
}
