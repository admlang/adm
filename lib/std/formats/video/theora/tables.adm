internal partial module std.formats.video.theora {
	// Position in the 8x8 block, row by row, of each coefficient in zig-zag
	// order.
	const thZigzag = int[
		0, 1, 8, 16, 9, 2, 3, 10, 17, 24, 32, 25, 18, 11, 4, 5,
		12, 19, 26, 33, 40, 48, 41, 34, 27, 20, 13, 6, 7, 14, 21, 28,
		35, 42, 49, 56, 57, 50, 43, 36, 29, 22, 15, 23, 30, 37, 44, 51,
		58, 59, 52, 45, 38, 31, 39, 46, 53, 60, 61, 54, 47, 55, 62, 63
	]

	// Macroblock coding modes.
	const (
		thModeInterNoMv   = 0
		thModeIntra       = 1
		thModeInterMv     = 2
		thModeInterLast   = 3
		thModeInterLast2  = 4
		thModeGoldenNoMv  = 5
		thModeGoldenMv    = 6
		thModeInterFourMv = 7
	)

	// The mode each index of the mode code stands for, for the six fixed
	// schemes.
	const thModeAlphabets = int[
		3, 4, 2, 0, 1, 5, 6, 7,
		3, 4, 0, 2, 1, 5, 6, 7,
		3, 2, 4, 0, 1, 5, 6, 7,
		3, 2, 0, 4, 1, 5, 6, 7,
		0, 3, 4, 2, 1, 5, 6, 7,
		0, 5, 3, 4, 2, 1, 6, 7
	]

	// The reference frame of each mode, as DC prediction groups them: the
	// frame itself, the previous frame, the golden frame.
	const thModeFrame = int[1, 0, 1, 1, 1, 2, 2, 1]

	// DC prediction weights by which neighbours are usable (below-left 8,
	// below 4, below-right 2, left 1): the below-left, below, below-right and
	// left weights, out of 128.
	const thDcWeights = int[
		0, 0, 0, 0,
		0, 0, 0, 128,
		0, 0, 128, 0,
		0, 0, 53, 75,
		0, 128, 0, 0,
		0, 64, 0, 64,
		0, 128, 0, 0,
		0, 0, 53, 75,
		128, 0, 0, 0,
		0, 0, 0, 128,
		64, 0, 64, 0,
		0, 0, 53, 75,
		0, 128, 0, 0,
		-104, 116, 0, 116,
		24, 80, 24, 0,
		-104, 116, 0, 116
	]

	// Block offsets, (x, y) with y counting up, in the Hilbert order a
	// superblock codes its sixteen blocks in.
	const thHilbert = int[
		0, 0, 1, 0, 1, 1, 0, 1,
		0, 2, 0, 3, 1, 3, 1, 2,
		2, 2, 2, 3, 3, 3, 3, 2,
		3, 1, 2, 1, 2, 0, 3, 0
	]

	// Cosines of the inverse DCT in 16-bit fixed point: cos(k pi / 16) for k
	// from 1 to 7.
	const (
		thC1 = 64277
		thC2 = 60547
		thC3 = 54491
		thC4 = 46341
		thC5 = 36410
		thC6 = 25080
		thC7 = 12785
	)
}
