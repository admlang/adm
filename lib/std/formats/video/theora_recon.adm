internal partial module std.formats.video.theora {
	// Bits needed to hold `v`: 0 for 0, 1 for 1, 2 for 2 and 3, ...
	def thIlog(v int) int {
		let n = 0
		let x = v
		for x > 0 {
			n++
			x = x >> 1
		}
		return n
	}

	def thAbs(x int) int {
		return x < 0 ?? (0 - x, x)
	}

	// `v / 2^n` rounded to nearest, halves away from zero.
	def thRoundShift(v int, n int) int {
		let half = 1 << (n - 1)
		return v > 0 ?? ((v + half) >> n, (v + half - 1) >> n)
	}

	// A run length of the long run code, 1 to 4129: superblock flags and
	// block quantisers.
	def thLongRun(br TheoraBits) int {
		return 1 unless br.bit()
		return 2 + br.bits(1) unless br.bit()
		return 4 + br.bits(1) unless br.bit()
		return 6 + br.bits(2) unless br.bit()
		return 10 + br.bits(3) unless br.bit()
		return 18 + br.bits(4) unless br.bit()
		return 34 + br.bits(12)
	}

	// A run length of the short run code, 1 to 30: block flags.
	def thShortRun(br TheoraBits) int {
		return 1 + br.bits(1) unless br.bit()
		return 3 + br.bits(1) unless br.bit()
		return 5 + br.bits(1) unless br.bit()
		return 7 + br.bits(2) unless br.bit()
		return 11 + br.bits(2) unless br.bit()
		return 15 + br.bits(4)
	}

	// Predicts the 8x8 block at (`x`, `y`) of a `stride` x `height` plane
	// from the reference plane moved by the half-pixel vector (`mx`, `my`):
	// a copy, or the truncating average of two pixels when the vector has a
	// half. Pixels outside the plane repeat its edge.
	def thPredict(ref byte[], stride int, height int, x int, y int, mx int, my int, dst byte[], at int) {
		let x0 = x + (mx >> 1)
		let y0 = y + (my >> 1)
		let hx = mx & 1
		let hy = my & 1
		// The second pixel of the average, as an offset from the first.
		let ax = 0
		let ay = 0
		let bx = hx
		let by = hy
		if hx == 1 && hy == 1 {
			let d = ((mx ^ my) < 0) ?? (1, 0)
			ax = d
			bx = 1 - d
			by = 1
		}
		let inside = x0 >= 0 && y0 >= 0 && x0 + 9 <= stride && y0 + 9 <= height
		if hx == 0 && hy == 0 {
			if inside {
				for let j = 0; j < 8; j++ {
					let s = (y0 + j) * stride + x0
					let d = at + j * stride
					for let i = 0; i < 8; i++ {
						dst[d + i] = ref[s + i]
					}
				}
				return
			}
			for let j = 0; j < 8; j++ {
				let s = thClamp(y0 + j, height - 1) * stride
				let d = at + j * stride
				for let i = 0; i < 8; i++ {
					dst[d + i] = ref[s + thClamp(x0 + i, stride - 1)]
				}
			}
			return
		}
		if inside {
			let o1 = (y0 + ay) * stride + x0 + ax
			let o2 = (y0 + by) * stride + x0 + bx
			for let j = 0; j < 8; j++ {
				let s1 = o1 + j * stride
				let s2 = o2 + j * stride
				let d = at + j * stride
				for let i = 0; i < 8; i++ {
					dst[d + i] = byte((int(ref[s1 + i]) + int(ref[s2 + i])) >> 1)
				}
			}
			return
		}
		for let j = 0; j < 8; j++ {
			let r1 = thClamp(y0 + ay + j, height - 1) * stride
			let r2 = thClamp(y0 + by + j, height - 1) * stride
			let d = at + j * stride
			for let i = 0; i < 8; i++ {
				let a = int(ref[r1 + thClamp(x0 + ax + i, stride - 1)])
				let b = int(ref[r2 + thClamp(x0 + bx + i, stride - 1)])
				dst[d + i] = byte((a + b) >> 1)
			}
		}
	}

	def thClamp(v int, hi int) int {
		return v < 0 ?? (0, v > hi ?? (hi, v))
	}

	// Adds `dc` to every pixel of the 8x8 block at `at`.
	def thAddDC(dst byte[], at int, stride int, dc int) {
		return when dc == 0
		for let j = 0; j < 8; j++ {
			let d = at + j * stride
			for let i = 0; i < 8; i++ {
				let v = int(dst[d + i]) + dc
				dst[d + i] = byte(v < 0 ?? (0, v > 255 ?? (255, v)))
			}
		}
	}

	// The inverse DCT of the dequantised block `c` (raster order), rows then
	// columns, written over the 8x8 block at `at` for intra blocks (around
	// 128) or added to the prediction there.
	def thIdct(c int[], dst byte[], at int, stride int, intra bool) {
		for let r = 0; r < 8; r++ {
			let o = r * 8
			let x0 = c[o]
			let x1 = c[o + 1]
			let x2 = c[o + 2]
			let x3 = c[o + 3]
			let x4 = c[o + 4]
			let x5 = c[o + 5]
			let x6 = c[o + 6]
			let x7 = c[o + 7]
			continue when (x0 | x1 | x2 | x3 | x4 | x5 | x6 | x7) == 0
			let a = ((thC1 * x1) >> 16) + ((thC7 * x7) >> 16)
			let b = ((thC7 * x1) >> 16) - ((thC1 * x7) >> 16)
			let cc = ((thC3 * x3) >> 16) + ((thC5 * x5) >> 16)
			let d = ((thC3 * x5) >> 16) - ((thC5 * x3) >> 16)
			let ad = (thC4 * (a - cc)) >> 16
			let bd = (thC4 * (b - d)) >> 16
			let cd = a + cc
			let dd = b + d
			let e = (thC4 * (x0 + x4)) >> 16
			let f = (thC4 * (x0 - x4)) >> 16
			let g = ((thC2 * x2) >> 16) + ((thC6 * x6) >> 16)
			let h = ((thC6 * x2) >> 16) - ((thC2 * x6) >> 16)
			let ed = e - g
			let gd = e + g
			let add = f + ad
			let bdd = bd - h
			let fd = f - ad
			let hd = bd + h
			c[o] = gd + cd
			c[o + 7] = gd - cd
			c[o + 1] = add + hd
			c[o + 2] = add - hd
			c[o + 3] = ed + dd
			c[o + 4] = ed - dd
			c[o + 5] = fd + bdd
			c[o + 6] = fd - bdd
		}
		let bias = intra ?? (8 + 16 * 128, 8)
		for let i = 0; i < 8; i++ {
			let x0 = c[i]
			let x1 = c[8 + i]
			let x2 = c[16 + i]
			let x3 = c[24 + i]
			let x4 = c[32 + i]
			let x5 = c[40 + i]
			let x6 = c[48 + i]
			let x7 = c[56 + i]
			let a = ((thC1 * x1) >> 16) + ((thC7 * x7) >> 16)
			let b = ((thC7 * x1) >> 16) - ((thC1 * x7) >> 16)
			let cc = ((thC3 * x3) >> 16) + ((thC5 * x5) >> 16)
			let d = ((thC3 * x5) >> 16) - ((thC5 * x3) >> 16)
			let ad = (thC4 * (a - cc)) >> 16
			let bd = (thC4 * (b - d)) >> 16
			let cd = a + cc
			let dd = b + d
			let e = ((thC4 * (x0 + x4)) >> 16) + bias
			let f = ((thC4 * (x0 - x4)) >> 16) + bias
			let g = ((thC2 * x2) >> 16) + ((thC6 * x6) >> 16)
			let h = ((thC6 * x2) >> 16) - ((thC2 * x6) >> 16)
			let ed = e - g
			let gd = e + g
			let add = f + ad
			let bdd = bd - h
			let fd = f - ad
			let hd = bd + h
			let p = at + i
			if intra {
				dst[p] = thPixel((gd + cd) >> 4)
				dst[p + stride] = thPixel((add + hd) >> 4)
				dst[p + 2 * stride] = thPixel((add - hd) >> 4)
				dst[p + 3 * stride] = thPixel((ed + dd) >> 4)
				dst[p + 4 * stride] = thPixel((ed - dd) >> 4)
				dst[p + 5 * stride] = thPixel((fd + bdd) >> 4)
				dst[p + 6 * stride] = thPixel((fd - bdd) >> 4)
				dst[p + 7 * stride] = thPixel((gd - cd) >> 4)
			} else {
				dst[p] = thPixel(int(dst[p]) + ((gd + cd) >> 4))
				dst[p + stride] = thPixel(int(dst[p + stride]) + ((add + hd) >> 4))
				dst[p + 2 * stride] = thPixel(int(dst[p + 2 * stride]) + ((add - hd) >> 4))
				dst[p + 3 * stride] = thPixel(int(dst[p + 3 * stride]) + ((ed + dd) >> 4))
				dst[p + 4 * stride] = thPixel(int(dst[p + 4 * stride]) + ((ed - dd) >> 4))
				dst[p + 5 * stride] = thPixel(int(dst[p + 5 * stride]) + ((fd + bdd) >> 4))
				dst[p + 6 * stride] = thPixel(int(dst[p + 6 * stride]) + ((fd - bdd) >> 4))
				dst[p + 7 * stride] = thPixel(int(dst[p + 7 * stride]) + ((gd - cd) >> 4))
			}
		}
	}

	def thPixel(v int) byte {
		return byte(v < 0 ?? (0, v > 255 ?? (255, v)))
	}

	// The loop filter across the vertical edge left of pixel `at`, eight
	// rows up.
	def thFilterH(pix byte[], at int, stride int, bound int[]) {
		let p = at
		for let j = 0; j < 8; j++ {
			let r = (int(pix[p - 2]) - int(pix[p + 1])) + 3 * (int(pix[p]) - int(pix[p - 1]))
			let f = bound[127 + ((r + 4) >> 3)]
			if f != 0 {
				pix[p - 1] = thPixel(int(pix[p - 1]) + f)
				pix[p] = thPixel(int(pix[p]) - f)
			}
			p += stride
		}
	}

	// The loop filter across the horizontal edge below pixel `at`, eight
	// columns along.
	def thFilterV(pix byte[], at int, stride int, bound int[]) {
		for let i = 0; i < 8; i++ {
			let p = at + i
			let r = (int(pix[p - 2 * stride]) - int(pix[p + stride])) + 3 * (int(pix[p]) - int(pix[p - stride]))
			let f = bound[127 + ((r + 4) >> 3)]
			if f != 0 {
				pix[p - stride] = thPixel(int(pix[p - stride]) + f)
				pix[p] = thPixel(int(pix[p]) - f)
			}
		}
	}
}
