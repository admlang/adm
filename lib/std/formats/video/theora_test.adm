		internal def decodeAll(file byte[]) !VideoFrame[] {
			let (track, packets) = split(file)
			let codec = new Theora()
			try codec.configure(track)
			let frames = VideoFrame[]
			for let (_, packet) in packets {
				for let (_, frame) in try codec.decode(packet) {
					frames.push(frame)
				}
			}
			return frames
		}

		internal def md5s(frames VideoFrame[]) string[] {
			let out = string[]
			for let (_, frame) in frames {
				out.push(md5(frame))
			}
			return out
		}

		@test()
		def decodes_444_bit_exact() !none {
			let frames = try decodeAll(try stream444())
			assert md5s(frames).equals(string[
				"10fd502cb00aa15a90308f6e93c5beb6", "223c58c33ce7ce4bc3b32bef9fd1b11c", "756c24b83af6e8bbbb70b2c96d6fc387"
			])
			assert frames[0].chroma == ChromaLayout.Yuv444 && frames[0].uvStride == 40 && frames[0].u.len() == 40 * 24
		}

		@test()
		def decodes_422_bit_exact() !none {
			let frames = try decodeAll(try stream422())
			assert md5s(frames).equals(string[
				"7a559b6d81972e49c77ad4bd461d8eb4", "803f2b48f8e20361b7fff37bc36d2790", "771a089f3898fa8414da4a08d91a6d1b"
			])
			assert frames[0].chroma == ChromaLayout.Yuv422 && frames[0].uvStride == 20 && frames[0].u.len() == 20 * 24
		}

		@test()
		def rejects_frames_without_headers_or_intra_frame() !none {
			let (track, packets) = split(try stream())
			let failed = false
			new Theora().decode(packets[0]) onerror (err error) {
				failed = true
				recover []
			}
			assert failed
			let codec = new Theora()
			try codec.configure(track)
			failed = false
			codec.decode(packets[1]) onerror (err error) {
				failed = true
				recover []
			}
			assert failed
		}

		@test()
		def rejects_truncated_frames() !none {
			let (track, packets) = split(try stream())
			let key = packets[0]
			for let n = 1; n < key.data.len() / 2; n += 13 {
				let codec = new Theora()
				try codec.configure(track)
				let cut = Packet{track: 0, data: key.data[0:n].clone(), pts: 0s, dts: 0s, length: 0s, keyframe: true}
				let failed = false
				codec.decode(cut) onerror (err error) {
					failed = true
					recover []
				}
				assert failed
			}
		}

		// Damaged packets either decode to something or fail; they never read
		// out of bounds.
		@test()
		def survives_damaged_packets() !none {
			let (track, packets) = split(try stream())
			for let i = 0; i < 200; i++ {
				let codec = new Theora()
				try codec.configure(track)
				for let (k, packet) in packets {
					let data = packet.data.clone()
					let at = (i * 31 + k * 7) % data.len()
					data[at] = byte(int(data[at]) ^ (1 << (i & 7)))
					codec.decode(Packet{track: 0, data: data, pts: 0s, dts: 0s, length: 0s, keyframe: false}) onerror recover []
				}
			}
		}

		@test()
		def rejects_damaged_headers() !none {
			let all = oggPackets(try stream())
			for let n = 8; n < all[2].len(); n += 97 {
				let codec = new Theora()
				try codec.decode(Packet{track: 0, data: all[0], pts: 0s, dts: 0s, length: 0s, keyframe: false})
				let failed = false
				codec.decode(Packet{track: 0, data: all[2][0:n].clone(), pts: 0s, dts: 0s, length: 0s, keyframe: false}) onerror (err error) {
					failed = true
					recover []
				}
				assert failed
			}
		}
	}
}
