		// The packets of an Ogg file's first logical stream.
		internal def oggPackets(d byte[]) byte[][] {
			let out = byte[][]
			let pending byte[]
			let p = 0
			for p + 27 <= d.len() {
				let count = int(d[p + 26])
				let q = p + 27 + count
				for let i = 0; i < count; i++ {
					let n = int(d[p + 27 + i])
					pending = pending + d[q:q + n]
					if n < 255 {
						out.push(pending)
						pending = []
					}
					q += n
				}
				p = q
			}
			return out
		}

		// The three header packets as a track's `config`, and the frame packets
		// stamped 100 ms apart.
		internal def split(file byte[]) (Track, Packet[]) {
			let all = oggPackets(file)
			let config = byte[]
			let frames = Packet[]
			for let (i, data) in all {
				if i < 3 {
					config.push(byte(data.len() >> 8), byte(data.len() & 255))
					config = config + data
					continue
				}
				let pts = duration(int64(i - 3) * 100000000)
				frames.push(Packet{track: 0, data: data, pts: pts, dts: pts, length: 100ms, keyframe: (int(data[0]) & 0x40) == 0})
			}
			return (Track{index: 0, kind: TrackKind.Video, codec: "theora", config: config}, frames)
		}

		internal def md5(frame VideoFrame) string {
			let h = new hash.MD5()
			h.write(frame.y)
			h.write(frame.u)
			h.write(frame.v)
			return h.hash().hex().lower()
		}

		internal def want() string[] {
			return string[
				"da90a42f8e6f8d9f85125bbfefdd69e0", "3bdd7392c9ef29adf656115854eb8ae4", "b5375d7fd2abae5901e8979e49400cb7",
				"24a8eab7419b90b75791b2eb9e952698", "abff6357e18188b6f344779457ae9452", "01b50a7415b67717495cf864e29f9b72",
				"679b58f840168786e6725b3fbf01ceaf", "1169eee9be64aa6970f4f911b6a8477a", "7d50a21147b90aa2f45255b4563bd180",
				"0e6d19082638298a31e5c05077561676", "5e2ef618319f9b0560e8332a6d561f9d", "038d49671f2249d61cccad3ac3f1c790"
			]
		}

		@test()
		def decodes_bit_exact() !none {
			let (track, packets) = split(try stream())
			let codec = new Theora()
			try codec.configure(track)
			let got = string[]
			for let (_, packet) in packets {
				for let (_, frame) in try codec.decode(packet) {
					got.push(md5(frame))
				}
			}
			assert got.equals(want())
		}

		@test()
		def reads_headers_from_packets() !none {
			let codec = new Theora()
			let got = string[]
			for let (_, data) in oggPackets(try stream()) {
				for let (_, frame) in try codec.decode(Packet{track: 0, data: data, pts: 0s, dts: 0s, length: 0s, keyframe: false}) {
					got.push(md5(frame))
				}
			}
			assert got.equals(want())
		}

		@test()
		def fills_frame_fields() !none {
			let (track, packets) = split(try stream())
			let codec = new Theora()
			try codec.configure(track)
			assert codec.frameRate.numerator == uint32(10) && codec.frameRate.denominator == uint32(1)
			let first = (try codec.decode(packets[0]))[0]
			let second = (try codec.decode(packets[1]))[0]
			assert first.width == uint32(70) && first.height == uint32(50)
			assert first.yStride == 70 && first.uvStride == 35
			assert first.y.len() == 70 * 50 && first.u.len() == 35 * 25 && first.v.len() == 35 * 25
			assert first.keyframe && !second.keyframe
			assert first.time == 0s && second.time == 100ms && second.length == 100ms
			assert first.matrix == 601
			assert (try codec.flush()).len() == 0
		}

		@test()
		def repeats_the_last_frame_for_an_empty_packet() !none {
			let (track, packets) = split(try stream())
			let codec = new Theora()
			try codec.configure(track)
			let blank = Packet{track: 0, data: [], pts: 50ms, dts: 50ms, length: 0s, keyframe: false}
			assert (try codec.decode(blank)).len() == 0
			let first = (try codec.decode(packets[0]))[0]
			let again = try codec.decode(blank)
			assert again.len() == 1 && md5(again[0]) == md5(first)
			assert again[0].time == 50ms && !again[0].keyframe
		}

