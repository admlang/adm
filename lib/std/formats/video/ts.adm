partial module std.formats.video {
	use (
		std.io
		std.formats.video.demux::*
		std.formats.media.source::*
		std.formats.video.pes::*
	)

	// TS is the MPEG transport stream (`.ts`, Blu-ray `.m2ts` with its
	// 4-byte packet prefix): the first program of the PAT, its PMT's
	// elementary streams, and their PES packets reassembled across
	// 188-byte packets with the continuity counter checked. Each packet is
	// one PES payload, which decoders reassemble by start code; AAC comes
	// in its ADTS frames with an empty `config`. Timestamps count from the
	// first one in the stream. Seeking reads the packets from the start.
	@codec("TS")
	type TS {
		mimeType string[] {
			def get() string[] {
				return string["video/mp2t", "video/MP2T"]
			}
		}
		extension string[] {
			def get() string[] {
				return string[".ts", ".m2ts", ".mts", ".tsv", ".tsa"]
			}
		}

		// matchSignature reports whether the reader holds the sync byte
		// 0x47 at three packet strides, for 188-, 192- or 204-byte packets.
		def matchSignature(r io.Reader) bool {
			let head byte[]
			head.len(3 * 204 + 4)
			let n = io.readFull(r, head) onerror recover 0
			return n == head.len() && tsPacketSize(head) > 0
		}

		// open reads packets until the program's streams are known and each
		// has shown its first PES packet.
		//
		// Fails when the stream has no program map, or the reader fails.
		def open(reader io.Reader) !Container {
			let c = new TsContainer(new Source(reader))
			try c.read()
			return c
		}
	}
}
