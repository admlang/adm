internal partial module std.formats.video.pes {
	use (
		std.formats.video::*
		std.formats.video.demux::*
		std.formats.media.source::*
	)

	// Transport packets read ahead while the program is learnt, at most.
	const tsProbePackets = 4096

	// The size of the transport packets the bytes start with (188, or 192
	// with a 4-byte prefix, or 204 with Reed-Solomon parity), 0 when the
	// sync byte does not repeat at any of them.
	def tsPacketSize(head byte[]) int {
		for let (_, size) in int[188, 192, 204] {
			let first = size == 192 ?? (4, 0)
			let ok = true
			for let k = 0; k < 3; k++ {
				let at = first + k * size
				ok = ok && at < head.len() && head[at] == 0x47
			}
			return size when ok
		}
		return 0
	}

	// The PES packet being assembled on one PID.
	type TsAssembly {
		data   byte[]
		// The next continuity counter expected, -1 before the first packet.
		cc     int
		// Whether a PES start has been seen since the last loss.
		open   bool
		// The random access indicator of the PES's first packet.
		random bool
		// File offset of the PES's first transport packet.
		at     int

		def new() {
			cc = -1
		}
	}

	// A PSI section being assembled on one PID.
	type TsSection {
		data byte[]

		def new() {}
	}

	// The demultiplexer of an MPEG transport stream.
	type TsContainer {
		src        Source
		size       int
		// Bytes before the sync byte in each packet: 4 for M2TS.
		prefix     int
		parts      PesTrack[]
		list       Track[]
		byPid      map<int, int>
		assembling map<int, TsAssembly>
		sections   map<int, TsSection>
		pmtPid     int
		mapped     bool
		// PES packets completed and not yet returned.
		done       RawPes[]
		doneAt     int
		ended      bool
		origin     int
		dropBefore duration
		dropping   bool

		def new(src Source) {
			self.src = src
			byPid = new map<int, int>()
			assembling = new map<int, TsAssembly>()
			sections = new map<int, TsSection>()
			pmtPid = -1
			origin = -1
		}

		// Reads packets until the program map is read and each stream has a
		// PES packet, or the probe limit is reached.
		//
		// Fails when the stream is not a transport stream, it has no program
		// map, or the reader fails.
		def read() !none {
			let head = try src.peek(3 * 204 + 4)
			size = tsPacketSize(head)
			fail "ts: not a transport stream" when size == 0
			prefix = size == 192 ?? (4, 0)
			for let i = 0; i < tsProbePackets; i++ {
				break unless try readPacket()
				if mapped {
					let seen bool[]
					seen.len(parts.len())
					for let (_, p) in done {
						seen[p.track] = true
					}
					let all = true
					for let (_, s) in seen {
						all = all && s
					}
					break when all && parts.len() > 0
				}
			}
			fail "ts: the stream has no program map" unless mapped
			for let (_, p) in done {
				let t = p.dts >= 0 ?? (p.dts, p.pts)
				origin = t when t >= 0 && (origin < 0 || t < origin)
			}
			origin = 0 when origin < 0
			if src.seekable() && src.size() > 0 {
				let from = (src.size() - tailBytes).max(0)
				let last = lastTsTime(try src.bytesAt(from, src.size() - from), size, prefix)
				let total = last > origin ?? (ticks(last - origin, 90000), 0s)
				for let (_, t) in list {
					t.length = total
				}
			}
			return none
		}

		// Reads one transport packet; false at the end of the stream.
		//
		// Fails when the reader does.
		def readPacket() !bool {
			let at = src.position()
			let packet = try src.peek(size)
			if packet.len() < size {
				flushAll() unless ended
				ended = true
				return false
			}
			if packet[prefix] != 0x47 {
				// Lost sync: find it again.
				try src.skip(1)
				return true
			}
			try src.skip(size)
			let p = packet[prefix:prefix + 188]
			let pid = (int(p[1]) & 0x1F) << 8 | int(p[2])
			let start = int(p[1]) & 0x40 != 0
			let control = (int(p[3]) >> 4) & 3
			let cc = int(p[3]) & 0xF
			let i = 4
			let random = false
			if control & 2 != 0 {
				let length = int(p[4])
				random = length > 0 && int(p[5]) & 0x40 != 0
				i += 1 + length
			}
			return true when control & 1 == 0 || i >= 188
			let payload = p[i:188]
			if pid == 0 || pid == pmtPid {
				readSection(pid, start, payload)
				return true
			}
			let slot = byPid.get(pid)
			return true when slot is none
			let index int = slot
			let a = assemblyOf(pid)
			let lost = a.cc >= 0 && cc != a.cc
			let repeated = a.cc >= 0 && cc == (a.cc + 15) % 16
			return true when repeated && !start
			a.cc = (cc + 1) % 16
			if start {
				complete(index, a)
				a.data = payload.clone()
				a.open = true
				a.random = random
				a.at = at
				return true
			}
			if lost {
				a.open = false
				a.data = byte[]
				return true
			}
			a.data = a.data.concat(payload) when a.open
			return true
		}

		// The PES assembly of the PID, made on first use.
		def assemblyOf(pid int) TsAssembly {
			let found = assembling.get(pid)
			if found is none {
				let made = new TsAssembly()
				assembling.set(pid, made)
				return made
			}
			let a TsAssembly = found
			return a
		}

		// The section assembly of the PID, made on first use.
		def sectionOf(pid int) TsSection {
			let found = sections.get(pid)
			if found is none {
				let made = new TsSection()
				sections.set(pid, made)
				return made
			}
			let s TsSection = found
			return s
		}

		// Turns the PES assembled for track `index` into a packet.
		def complete(index int, a TsAssembly) {
			return unless a.open && a.data.len() > 0
			a.open = false
			let data = a.data
			a.data = byte[]
			return unless data.len() >= 6 && be(data, 0, 3) == 1
			let found = pesHeader(data, 0)
			return when found is none
			let h PesHeader = found
			return when h.size > data.len()
			let end = data.len()
			end = (6 + h.length).min(end) when h.length > 0
			let payload = data[h.size:end].clone()
			let part = parts[index]
			let key = part.track.kind != TrackKind.Video || a.random || isKeyPayload(part.track.codec, payload)
			// Until the stream's first payloads say what the PMT does not:
			// the codec, the audio format, the H.264 picture size.
			let t = part.track
			probe(part, payload) when t.codec == "" || (t.kind == TrackKind.Audio && t.sampleRate == 0) || (t.codec == "h264" && t.width == 0)
			done.push(RawPes{track: index, data: payload, pts: h.pts, dts: h.dts, key: key, at: a.at})
		}

		// Completes every PES still being assembled, at the end of the
		// stream.
		def flushAll() {
			for let (pid, a) in assembling {
				let slot = byPid.get(pid)
				continue when slot is none
				let index int = slot
				complete(index, a)
			}
		}

		// Learns a stream's format from its first payload.
		def probe(part PesTrack, payload byte[]) {
			let t = part.track
			let p = new StreamProbe(t.codec)
			if t.codec := "mpeg1" || "mpeg2" {
				p.video(payload)
			} else if t.codec == "h264" {
				p.h264(payload)
			} else if t.codec := "mp2" || "mp3" {
				p.audio(payload)
			} else if t.codec == "aac" {
				p.adts(payload)
			} else {
				return
			}
			p.apply(t)
		}

		// Collects a PSI section across packets and reads it once whole.
		def readSection(pid int, start bool, payload byte[]) {
			let s = sectionOf(pid)
			if start {
				let pointer = int(payload[0])
				return when 1 + pointer >= payload.len()
				s.data = payload[1 + pointer:].clone()
			} else {
				return when s.data.len() == 0
				s.data = s.data.concat(payload)
			}
			return when s.data.len() < 3
			let length = (int(s.data[1]) & 0x0F) << 8 | int(s.data[2])
			return when s.data.len() < 3 + length
			let section = s.data[0:3 + length]
			s.data = byte[]
			if pid == 0 && int(section[0]) == 0 {
				readPat(section)
			} else if pid == pmtPid && int(section[0]) == 2 {
				readPmt(section)
			}
		}

		// Takes the first program's PMT PID from the PAT.
		def readPat(section byte[]) {
			return when pmtPid >= 0
			let end = section.len() - 4
			for let at = 8; at + 4 <= end; at += 4 {
				let program = be(section, at, 2)
				continue when program == 0
				pmtPid = be(section, at + 2, 2) & 0x1FFF
				return
			}
		}

		// Makes a track of each elementary stream of the PMT.
		def readPmt(section byte[]) {
			return when mapped
			mapped = true
			let end = section.len() - 4
			let infoLength = be(section, 10, 2) & 0x0FFF
			let at = 12 + infoLength
			for at + 5 <= end {
				let streamType = int(section[at])
				let pid = be(section, at + 1, 2) & 0x1FFF
				let esLength = be(section, at + 3, 2) & 0x0FFF
				let descriptors = section[at + 5:(at + 5 + esLength).min(end)]
				at += 5 + esLength
				let (kind, codec) = tsStreamKind(streamType, descriptors)
				continue when kind == TrackKind.Data && codec == ""
				let t = newTrack(parts.len(), kind, codec)
				t.language = tsLanguage(descriptors)
				parts.push(new PesTrack(t, pid))
				list.push(t)
				byPid.set(pid, t.index)
			}
		}

		// name implements Described.
		def name() string {
			return size == 192 ?? ("m2ts", "ts")
		}

		// seekable implements Seekable.
		def seekable() bool {
			return src.seekable()
		}

		// tracks implements Container.
		def tracks() Track[] {
			return list
		}

		// The next PES packet completed, reading transport packets as
		// needed; none at the end.
		//
		// Fails when the reader does.
		def pull() !?RawPes {
			for doneAt >= done.len() {
				done = RawPes[]
				doneAt = 0
				let more = try readPacket()
				return none unless more || done.len() > 0
			}
			let p = done[doneAt]
			doneAt++
			return p
		}

		// next implements Container.
		//
		// Fails when the reader does.
		def next() !?Packet {
			for {
				let raw = try pull()
				return none when raw is none
				let r RawPes = raw
				let part = parts[r.track]
				if r.pts >= 0 {
					part.pts = r.pts
					part.dts = r.dts >= 0 ?? (r.dts, r.pts)
				}
				let pts = part.pts < 0 ?? (0s, ticks(part.pts - origin, 90000))
				let dts = part.dts < 0 ?? (pts, ticks(part.dts - origin, 90000))
				continue when dropping && part.track.kind != TrackKind.Video && pts < dropBefore
				return newPacket(r.track, r.data, pts, dts, 0s, r.key)
			}
			return none
		}

		// seek implements Container: finds the last video keyframe at or
		// before `time` (bisecting on byte offsets in large files, then
		// reading forward), resumes at its first transport packet, and drops
		// the other streams' packets that present before it.
		//
		// Fails when the source cannot seek or the reader fails.
		def seek(time duration) !none {
			fail "ts: the stream cannot seek" unless src.seekable()
			let main = -1
			for let (i, t) in list {
				if t.kind == TrackKind.Video {
					main = i
					break
				}
			}
			let from = 0
			if src.size() > seekScanBytes {
				from = try bisectSeek(src.size(), time, (at int, limit int) => probeKey(at, limit, main))
			}
			try restart(from)
			let pick = from
			let pickTime = 0s
			for {
				let got = try pull()
				break when got is none
				let p RawPes = got
				continue unless p.track == main || main < 0
				continue unless p.key && p.pts >= 0
				let t = ticks(p.pts - origin, 90000)
				break when t > time
				pick = p.at
				pickTime = t
			}
			try restart(pick)
			dropBefore = pickTime
			dropping = pickTime > 0s
			return none
		}

		// The first keyframe of track `main` (any timed packet when it is
		// -1) from the transport packet at or after `from`, reading no
		// further than `limit`.
		//
		// Fails when the reader does.
		def probeKey(from int, limit int, main int) !KeyProbe {
			let aligned = from - from % size
			try restart(aligned < from ?? (aligned + size, aligned))
			for src.position() < limit {
				let got = try pull()
				break when got is none
				let p RawPes = got
				continue unless p.track == main || main < 0
				continue unless p.key && p.pts >= 0
				return KeyProbe{found: true, time: ticks(p.pts - origin, 90000), at: p.at}
			}
			return KeyProbe{found: false, time: 0s, at: 0}
		}

		// Moves to the transport packet at `offset` with no PES half read.
		//
		// Fails when the source cannot seek there.
		def restart(offset int) !none {
			try src.seek(offset)
			done = RawPes[]
			doneAt = 0
			ended = false
			assembling = new map<int, TsAssembly>()
			for let (_, part) in parts {
				part.pts = -1
				part.dts = -1
			}
			return none
		}

		// close implements io.Closer: closes the file.
		//
		// Fails when closing it does.
		def close() !none {
			return src.close()
		}
	}

	// The kind and codec of a PMT stream type, with its descriptors for
	// private streams; (Data, "") for a stream that carries no media.
	def tsStreamKind(streamType int, descriptors byte[]) (TrackKind, string) {
		return (TrackKind.Video, "mpeg1") when streamType == 0x01
		return (TrackKind.Video, "mpeg2") when streamType := 0x02 || 0x80
		return (TrackKind.Video, "mpeg4") when streamType == 0x10
		return (TrackKind.Video, "h264") when streamType == 0x1B
		return (TrackKind.Video, "hevc") when streamType == 0x24
		return (TrackKind.Video, "vc1") when streamType == 0xEA
		return (TrackKind.Audio, "mp2") when streamType := 0x03 || 0x04
		return (TrackKind.Audio, "aac") when streamType == 0x0F
		return (TrackKind.Audio, "aac_latm") when streamType == 0x11
		return (TrackKind.Audio, "ac3") when streamType := 0x81 || 0x83
		return (TrackKind.Audio, "eac3") when streamType := 0x84 || 0x87
		return (TrackKind.Audio, "dts") when streamType := 0x82 || 0x85 || 0x86
		return (TrackKind.Subtitle, "pgs") when streamType == 0x90
		return (TrackKind.Data, "") unless streamType == 0x06
		let at = 0
		for at + 2 <= descriptors.len() {
			let tag = int(descriptors[at])
			let length = int(descriptors[at + 1])
			let body = at + 2
			return (TrackKind.Audio, "ac3") when tag == 0x6A
			return (TrackKind.Audio, "eac3") when tag == 0x7A
			return (TrackKind.Audio, "dts") when tag == 0x7B
			return (TrackKind.Subtitle, "dvbsub") when tag == 0x59
			return (TrackKind.Subtitle, "teletext") when tag == 0x56
			if tag == 0x05 && length >= 4 {
				let name = fourcc(be(descriptors, body, 4))
				return (TrackKind.Audio, "opus") when name == "Opus"
				return (TrackKind.Audio, "ac3") when name == "AC-3"
				return (TrackKind.Audio, "eac3") when name == "EAC3"
				return (TrackKind.Video, "vc1") when name == "VC-1"
			}
			at = body + length
		}
		return (TrackKind.Data, "")
	}

	// The ISO 639 language a stream's descriptors name, empty when none
	// does.
	def tsLanguage(descriptors byte[]) string {
		let at = 0
		for at + 2 <= descriptors.len() {
			let tag = int(descriptors[at])
			let length = int(descriptors[at + 1])
			return string(descriptors[at + 2:at + 5]) when tag == 0x0A && length >= 3 && at + 5 <= descriptors.len()
			at += 2 + length
		}
		return ""
	}
}
