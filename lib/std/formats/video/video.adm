partial module std.formats.video {
	use (
		std.io
		std.reflection
		std.formats
		std.formats.image
		std.formats.audio
	)

	// What a track carries.
	enum TrackKind {
		Video,
		Audio,
		Subtitle,
		Data
	}

	// A frame rate as a fraction, since 29.97 is 30000/1001 and no float
	// spells it exactly.
	struct FrameRate {
		numerator   uint32
		denominator uint32
	}

	// What a file says about its main video track before any frame is decoded.
	struct VideoInfo {
		width       uint32
		height      uint32
		frameRate   FrameRate
		// Zero when the container does not record a length.
		length      duration
		// Lowercase codec name: "h264", "vp8", "mpeg2", "theora", "mpeg4".
		codec       string
		// Lowercase container name: "mp4", "mkv", "webm", "avi".
		container   string
		// Clockwise degrees the picture is shown rotated by: 0, 90, 180 or 270.
		rotation    int
		// Width of one pixel relative to its height; 1.0 for square pixels.
		pixelAspect float64
		// Whether `seek` works on this file.
		seekable    bool
	}

	// How a frame's chroma planes are sampled against its luma plane.
	enum ChromaLayout {
		// Luma only; `u` and `v` are empty.
		Mono,
		// Chroma planes of half the width and half the height.
		Yuv420,
		// Chroma planes of half the width and the full height.
		Yuv422,
		// Chroma planes the size of the luma plane.
		Yuv444
	}

	// One decoded picture in planar YUV: a full-size luma plane and two chroma
	// planes sized by `chroma`. Planes may hold rows or columns past `width`
	// and `height`.
	struct VideoFrame {
		width     uint32
		height    uint32
		y         byte[]
		u         byte[]
		v         byte[]
		// Bytes from one row to the next in each plane.
		yStride   int
		uvStride  int
		// Presentation time from the start of the stream.
		time      duration
		length    duration
		keyframe  bool
		// Colour matrix of the YUV values: 601 or 709.
		matrix    int
		chroma    ChromaLayout = ChromaLayout.Yuv420
		// Whether values span the whole sample range (JPEG range) rather
		// than studio range: luma 16 to 235, chroma 16 to 240 at 8 bits.
		fullRange bool
		// Bits per sample: 8, or 9 to 14 with each sample in two bytes,
		// little-endian; strides then count bytes.
		bitDepth  int          = 8
		// The picture is on the GPU (`Video.frames(onGpu = true)`): the planes
		// are empty, `gpu` holds it, and `download` brings it to main memory.
		onGpu     bool         = false
		gpu       ?GpuPicture  = none
	}

	// One track of a container: its kind, codec and codec setup bytes.
	struct Track {
		index       int
		kind        TrackKind
		// Lowercase codec name, as in `VideoInfo.codec` and `AudioInfo.codec`.
		codec       string
		// ISO 639-2 code, empty when the file does not say.
		language    string
		length      duration
		// Codec setup bytes the container stores apart from the packets: the
		// avcC record for H.264 (empty when the stream is Annex B with
		// in-band parameter sets), Matroska CodecPrivate as stored, and for
		// Xiph codecs (Vorbis, Theora) the three header packets, each
		// preceded by its length as a 2-byte big-endian number.
		config      byte[]
		// Video tracks only.
		width       uint32
		height      uint32
		// Frames per second the container declares, 0/1 when it declares
		// none. Video tracks only.
		frameRate   FrameRate
		// Clockwise degrees the picture is shown rotated by. Video tracks
		// only.
		rotation    int
		// Width of one pixel relative to its height. Video tracks only.
		pixelAspect float64
		// Audio tracks only.
		sampleRate  uint32
		channels    uint16
	}

	// One compressed unit of one track, as the container stores it: a whole
	// frame for MP4, Matroska, FLV, AVI and Ogg; for MPEG program and
	// transport streams, PES payloads that decoders reassemble by start code.
	// H.264 data is length-prefixed when the track has an avcC `config`,
	// Annex B otherwise.
	struct Packet {
		track    int
		data     byte[]
		// Presentation and decode times from the start of the stream.
		pts      duration
		dts      duration
		length   duration
		keyframe bool
	}

	// A demultiplexer bound to one file: its tracks and their packets in file
	// order.
	interface Container {
		io.Closer

		def tracks() Track[]
		// The next packet of any track, none at the end.
		def next() !?Packet
		// Moves to the last keyframe of the main video track at or before
		// `time`, or to `time` itself for audio-only files.
		def seek(time duration) !none
	}

	// What the container registry discovers: one stateless instance per
	// container format.
	interface ContainerFormat {
		def open(reader io.Reader) !Container
	}

	// Turns the packets of one video track into pictures.
	interface VideoDecoder {
		// Reads the track's `config` and prepares to decode.
		def configure(track Track) !none
		// Zero or more frames: codecs with B-frames hold pictures back until
		// their display turn.
		def decode(packet Packet) !VideoFrame[]
		// The frames still held back at the end of the stream.
		def flush() !VideoFrame[]
	}

	// What the GPU does for a video's pictures (`Video.hardware`).
	struct VideoHardware {
		// The GPU decodes the pictures, or will once they are read.
		decoding bool
		// The GPU can encode pictures of the video's codec.
		encoding bool
		// The interface the GPU decodes through: "NVDEC" or "VA-API"; empty
		// when the pictures decode in software.
		name     string
		// The GPU's name ("NVIDIA GeForce RTX 4090"), empty without one.
		device   string
		// Why the pictures decode in software, empty when the GPU decodes
		// them.
		reason   string
	}

	// A video decoder that can hand its pictures to the GPU says what it
	// does with them.
	interface HardwareDecoder {
		def hardware() VideoHardware
		// Whether frames the GPU decodes keep their pictures there
		// (`Video.frames(onGpu = true)`).
		def keepOnGpu(on bool)
	}

	// Decoded pictures of one video track in presentation order.
	interface VideoStream {
		def info() VideoInfo
		// The next picture, none at the end.
		def next() !?VideoFrame
		// Moves to the last keyframe at or before `time` and decodes forward
		// until `time`.
		def seek(time duration) !none
		def position() duration
	}

	// ContainerCodec is what a container format registers: its demultiplexer
	// and its file format description.
	type ContainerCodec = ContainerFormat & formats.FileFormat

	// codec registers a type as the container codec of the named format,
	// found through discovery.
	meta def codec<ContainerCodec>(ctx reflection.DiscoveryMetaContext<reflection.TypeMetaContext>, name string) {}

	// decoder registers a type as the video decoder of the named codec
	// ("h264", "vp8"), matched against `Track.codec`. Each track gets its own
	// instance.
	meta def decoder<VideoDecoder>(ctx reflection.DiscoveryMetaContext<reflection.TypeMetaContext>, name string) {}
}
