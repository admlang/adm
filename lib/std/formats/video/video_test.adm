partial module std.formats.video {
	use (
		std.testing
		std.bytes
		std.data.encoding
		std.formats
		std.formats.audio
		std.formats.image
		std.gfx.processing.transform::(FitMode)
		std.formats.video.loader::*
	)

	// Compares every packet of the container, in order, with ffprobe's
	// listing: track, size, pts in µs (within `tolerance`) and keyframe
	// per packet. Returns the first difference, empty when there is none.
	internal def comparePackets(c Container, want int[], tolerance int = 1) !string {
		let i = 0
		for {
			let got = try c.next()
			break when got is none
			let p Packet = got
			return "packet {i / 4}: more packets than ffprobe lists" when i + 4 > want.len()
			let us = int(int64(p.pts)) / 1000
			let ok = p.track == want[i] && p.data.len() == want[i + 1] && (us - want[i + 2]).abs() <= tolerance && (p.keyframe ?? (1, 0)) == want[i + 3]
			return "packet {i / 4}: track {p.track} size {p.data.len()} pts {us} key {p.keyframe}, want {want[i]} {want[i + 1]} {want[i + 2]} {want[i + 3]}" unless ok
			i += 4
		}
		return "{i / 4} packets, ffprobe lists {want.len() / 4}" when i != want.len()
		return ""
	}

	// Reads the stream to its end and returns the frames it gave and the
	// peak sample.
	internal def drainSound(stream audio.AudioStream) !(int, float32) {
		let channels = int(stream.info().channels)
		let buf float32[]
		buf.len(1000 * channels.max(1))
		let total = 0
		let peak float32 = 0.0
		for {
			let n = try stream.read(buf)
			break when n == 0
			for let i = 0; i < n * channels; i++ {
				peak = buf[i].abs() when buf[i].abs() > peak
			}
			total += n
		}
		return (total, peak)
	}

	// The frames and peak of the first audio track of the video in the
	// bytes.
	internal def soundOf(data byte[]) !(int, float32) {
		let v = try open(data)
		defer v.close()
		let found = try v.audio()
		fail "no audio track" when found is none
		let sound audio.AudioStream = found
		return drainSound(sound)
	}

	// Why no decoder can be made for the track, empty when one can.
	internal def failure(t Track) string {
		decoderFor(t) onerror (err error) {
			return err.message
		}
		return ""
	}

	// A decoder for the tests: one grey picture per packet, at the
	// packet's time, held back one packet as B-frame reordering would.
	@decoder("x-test")
	internal type TestDecoder {
		held ?VideoFrame = none

		def new() {}

		// configure implements VideoDecoder.
		def configure(track Track) !none {
			return none
		}

		// decode implements VideoDecoder.
		def decode(packet Packet) !VideoFrame[] {
			let frame = VideoFrame{
				width:    2,
				height:   2,
				y:        byte[128, 128, 128, 128],
				u:        byte[128],
				v:        byte[128],
				yStride:  2,
				uvStride: 1,
				time:     packet.pts,
				length:   packet.length,
				keyframe: packet.keyframe,
				matrix:   601
			}
			let out VideoFrame[]
			let before = held
			out.push(before) unless before is none
			held = frame
			return out
		}

		// flush implements VideoDecoder.
		def flush() !VideoFrame[] {
			let out VideoFrame[]
			let before = held
			out.push(before) unless before is none
			held = none
			return out
		}
	}

	// A video over the fixture whose video track claims the test codec.
	internal def testVideo(data byte[]) !Video {
		let v = try open(data)
		for let (_, t) in v.tracks() {
			t.codec = "x-test" when t.kind == TrackKind.Video
		}
		return v
	}

	check "Video" {
		@test()
		def TestOpenBytes() !none {
			let v = try open(tinyMp4())
			let info = v.info()
			try testing.expectEqual("mp4", info.container)
			try testing.expectEqual("h264", info.codec)
			assert info.width == 64 && info.height == 48
			assert info.frameRate.numerator == 5 && info.frameRate.denominator == 1
			assert int64(info.length) == 1000000000 && info.seekable
			assert v.tracks().len() == 2
			try v.close()
		}

		@test()
		def TestSignatures() !none {
			let codecs ContainerCodec[] = ContainerCodec[new MP4(), new MKV(), new AVI(), new FLV(), new OGV(), new MPEG(), new TS(), new ASF()]
			let files = byte[][tinyMp4(), tinyMkv(), tinyAvi(), tinyFlv(), tinyOgv(), tinyMpg(), tinyTs(), tinyWmv()]
			for let (i, codec) in codecs {
				for let (j, data) in files {
					let sig formats.SignatureMatcher = codec
					try testing.expectEqual(i == j, sig.matchSignature(new bytes.Reader(data)), "codec {i} on file {j}")
				}
			}
			let names = string["mp4", "mkv", "avi", "flv", "ogg", "mpeg", "ts", "asf"]
			for let (j, data) in files {
				try testing.expectEqual(names[j], (try open(data)).info().container)
			}
		}

		@test()
		def TestOpenReader() !none {
			let v = try open(new bytes.Buffer(tinyMkv()))
			try testing.expectEqual("mkv", v.info().container)
			assert v.tracks().len() == 2
		}

		@test()
		def TestAudioFromMp4() !none {
			let v = try open(tinyMp4())
			let found = try v.audio()
			fail "no audio track" when found is none
			let sound audio.AudioStream = found
			assert sound.info().sampleRate == 8000 && sound.info().channels == 1
			let (frames, peak) = try drainSound(sound)
			// ffmpeg decodes 8192 frames: nine access units less the priming.
			try testing.expectEqual(8192, frames)
			assert peak > 0.1 && peak < 0.2
		}

		// Motion JPEG in AVI (4:2:2, as cameras record it): every frame a
		// JPEG picture, samples within 1 of ffmpeg's (its IDCT rounds apart).
		@test()
		def TestMotionJpeg() !none {
			let v = try open(try encoding.base64decode(tinyMjpegAvi))
			let stream = try v.frames()
			let n = 0
			for {
				let got = try stream.next()
				break when got is none
				let f VideoFrame = got
				assert f.width == uint32(32) && f.height == uint32(16) && f.chroma == ChromaLayout.Yuv422 && f.fullRange
				if n == 0 {
					let want = int[70, 68, 62, 67, 64, 67, 69, 70]
					for let i = 0; i < want.len(); i++ {
						assert (int(f.y[i]) - want[i]).abs() <= 1
					}
					assert (int(f.u[0]) - 233).abs() <= 1
				}
				n++
			}
			try testing.expectEqual(3, n)
		}

		// MPEG-1 layer II sound in an MPEG program stream decodes through the
		// MPEG audio decoder.
		@test()
		def TestMp2Sound() !none {
			let v = try open("samples/video/mpeg/mpeg_5s_sample_file_532KB.mpeg")
			let found = try v.audio()
			fail "no audio track" when found is none
			let sound audio.AudioStream = found
			let (frames, peak) = try drainSound(sound)
			// ffprobe: 5.0155 s at 44.1 kHz.
			try testing.expectEqual(221184, frames)
			assert peak > 0.01
		}

		@test()
		def TestReopen() !none {
			let first = try open("samples/video/mp4/mp4_5s_sample_file_279KB.mp4")
			let second = try first.reopen()
			try first.close()
			let stream = try second.frames()
			assert !((try stream.next()) is none)
			try second.close()
			let held = try open(tinyMp4())
			let again = try held.reopen()
			assert again.info().width == held.info().width
			let read = try open(new bytes.Reader(tinyMp4()))
			assert read.reopen() is error
		}

		@test()
		def TestAc3Sound() !none {
			let v = try open("samples/video/mkv/tiny_ac3.mkv")
			let found = try v.audio()
			fail "no audio track" when found is none
			let sound audio.AudioStream = found
			let (frames, peak) = try drainSound(sound)
			// 32 frames of 1536 less the 256 the track's codec delay drops,
			// as ffmpeg decodes it; the tones peak at 0.125.
			try testing.expectEqual(48896, frames)
			assert peak > 0.12 && peak < 0.13
		}

		@test()
		def TestEac3Sound() !none {
			let v = try open("samples/video/mkv/tiny_eac3.mkv")
			let found = try v.audio()
			fail "no audio track" when found is none
			let sound audio.AudioStream = found
			let (frames, peak) = try drainSound(sound)
			// As ffmpeg decodes it.
			try testing.expectEqual(48896, frames)
			assert peak > 0.12 && peak < 0.13
		}

		@test()
		def TestAudioAfterSeek() !none {
			let v = try open(tinyMp4())
			let found = try v.audio()
			fail "no audio track" when found is none
			let sound audio.AudioStream = found
			try v.seek(500ms)
			let (frames, _) = try drainSound(sound)
			assert frames > 3000 && frames < 5000
			try testing.expectEqual(uint64(8192), sound.position())
		}

		@test()
		def TestAudioFromMkvAndWebm() !none {
			let (aac, aacPeak) = try soundOf(tinyMkv())
			try testing.expectEqual(8192, aac)
			assert aacPeak > 0.1 && aacPeak < 0.2
			let (opus, opusPeak) = try soundOf(tinyWebm())
			assert opus >= 48000 && opus <= 48000 + 960
			assert opusPeak > 0.1 && opusPeak < 0.2
		}

		@test()
		def TestFramesThroughDecoder() !none {
			let v = try testVideo(tinyMp4())
			let stream = try v.frames()
			let times int64[]
			for {
				let got = try stream.next()
				break when got is none
				let f VideoFrame = got
				times.push(int64(f.time) / 1000000)
			}
			// Decode order: the test decoder hands pictures out as they come.
			try testing.expectEqual("[0, 600, 200, 400, 800]", "{times}")
			try testing.expectEqual(1000000000, int(int64(stream.position())))
		}

		@test()
		def TestFramesAfterSeek() !none {
			let v = try testVideo(tinyMp4())
			let stream = try v.frames()
			try stream.seek(500ms)
			let got = try stream.next()
			fail "no picture after the seek" when got is none
			let f VideoFrame = got
			// The keyframe at 0 is decoded but ends before 500 ms.
			try testing.expectEqual(600, int(int64(f.time) / 1000000))
		}

		// Stopping the pictures ends their stream and stops keeping their
		// packets while the sound plays on; `frames` starts a new stream.
		@test()
		def TestStopFrames() !none {
			let v = try testVideo(tinyMp4())
			let found = try v.audio()
			fail "no audio track" when found is none
			let sound audio.AudioStream = found
			let stream = try v.frames()
			assert !(try stream.next() is none)
			v.stopFrames()
			assert try stream.next() is none
			let (frames, _) = try drainSound(sound)
			assert frames > 0
			try v.seek(0s)
			let again = try v.frames()
			assert !(try again.next() is none)
		}

		@test()
		def TestFramesMadeAfterSeek() !none {
			let v = try testVideo(tinyMp4())
			try v.seek(500ms)
			let stream = try v.frames()
			let got = try stream.next()
			fail "no picture after the seek" when got is none
			let f VideoFrame = got
			try testing.expectEqual(600, int(int64(f.time) / 1000000))
		}

		@test()
		def TestAudioMadeAfterSeek() !none {
			let v = try open(tinyMp4())
			try v.seek(500ms)
			let found = try v.audio()
			fail "no audio track" when found is none
			let sound audio.AudioStream = found
			let (frames, _) = try drainSound(sound)
			assert frames > 3000 && frames < 5000
		}

		@test()
		def TestDraw() !none {
			// A 2x1 picture: black on the left, white on the right.
			let frame = VideoFrame{width: 2, height: 1, y: byte[16, 235], u: byte[128], v: byte[128], yStride: 2, uvStride: 1, time: 0s, length: 0s, keyframe: true, matrix: 601}
			// Contain on 4x4: the picture scales to 4x2 between bars of one row.
			let boxed = new image.Image(4, 4)
			draw(frame, boxed)
			let b = boxed.raw()
			assert b[0] == 0 && b[3] == 255
			assert b[16] == 0 && b[16 + 12] == 255 && b[16 + 13] == 255
			assert b[48] == 0 && b[48 + 12] == 0
			// Stretch fills everything; Tile repeats the picture at its size.
			let stretched = new image.Image(4, 4)
			draw(frame, stretched, FitMode.Stretch)
			assert stretched.raw()[0] == 0 && stretched.raw()[12] == 255 && stretched.raw()[48 + 12] == 255
			let tiled = new image.Image(4, 2)
			draw(frame, tiled, FitMode.Tile)
			let t = tiled.raw()
			assert t[0] == 0 && t[4] == 255 && t[8] == 0 && t[12] == 255 && t[16 + 4] == 255
		}

		@test()
		def TestToImageDeep() !none {
			// 10-bit samples, two bytes each: luma 940 is white, 64 black.
			let frame = VideoFrame{width: 2, height: 1, y: byte[172, 3, 64, 0], u: byte[0, 2], v: byte[0, 2], yStride: 4, uvStride: 2, time: 0s, length: 0s, keyframe: true, matrix: 601, bitDepth: 10}
			let px = toImage(frame).raw()
			assert px[0] == 255 && px[1] == 255 && px[2] == 255
			assert px[4] == 0 && px[5] == 0 && px[6] == 0
		}

		@test()
		def TestDecoderDiscovery() !none {
			let t = Track{
				index:       0,
				kind:        TrackKind.Video,
				codec:       "x-test",
				language:    "",
				length:      0s,
				config:      byte[],
				width:       1,
				height:      1,
				frameRate:   FrameRate{numerator: 1, denominator: 1},
				rotation:    0,
				pixelAspect: 1.0,
				sampleRate:  0,
				channels:    0
			}
			let d = try decoderFor(t)
			let frames = try d.flush()
			assert frames.len() == 0
		}

		@test()
		def TestNoDecoder() !none {
			let t = Track{
				index:       0,
				kind:        TrackKind.Video,
				codec:       "x-none",
				language:    "",
				length:      0s,
				config:      byte[],
				width:       1,
				height:      1,
				frameRate:   FrameRate{numerator: 1, denominator: 1},
				rotation:    0,
				pixelAspect: 1.0,
				sampleRate:  0,
				channels:    0
			}
			try testing.expectError(decoderFor(t))
			try testing.expectEqual("video: no decoder is registered for the \"x-none\" codec", failure(t))
		}

		@test()
		def TestToImage() !none {
			let frame = VideoFrame{
				width:    2,
				height:   2,
				y:        byte[235, 16, 81, 41],
				u:        byte[128],
				v:        byte[128],
				yStride:  2,
				uvStride: 1,
				time:     0s,
				length:   0s,
				keyframe: true,
				matrix:   601
			}
			let px = toImage(frame).raw()
			assert px[0] == 255 && px[1] == 255 && px[2] == 255 && px[3] == 255
			assert px[4] == 0 && px[5] == 0 && px[6] == 0
			let red = VideoFrame{...frame, y: byte[81, 81, 81, 81], u: byte[90], v: byte[240]}
			let r = toImage(red).raw()
			assert r[0] >= 250 && r[1] <= 5 && r[2] <= 5
		}

		@test()
		def TestToImageLayouts() !none {
			let base = VideoFrame{width: 2, height: 2, y: byte[81, 81, 81, 81], yStride: 2, time: 0s, length: 0s, keyframe: true, matrix: 601}
			// Red on the left column, blue on the right.
			let full = toImage(VideoFrame{...base, u: byte[90, 240, 90, 240], v: byte[240, 110, 240, 110], uvStride: 2, chroma: ChromaLayout.Yuv444}).raw()
			assert full[0] >= 250 && full[2] <= 5 && full[4] <= 60 && full[6] >= 250
			// Red on the top row, blue on the bottom.
			let tall = toImage(VideoFrame{...base, u: byte[90, 240], v: byte[240, 110], uvStride: 1, chroma: ChromaLayout.Yuv422}).raw()
			assert tall[0] >= 250 && tall[4] >= 250 && tall[8] <= 60 && tall[10] >= 250
			let grey = toImage(VideoFrame{...base, uvStride: 0, chroma: ChromaLayout.Mono}).raw()
			assert grey[0] == grey[1] && grey[1] == grey[2] && grey[0] == 76
			// Full range: 0 is black and 255 white, with no studio offset.
			let pc = toImage(VideoFrame{...base, y: byte[0, 255, 128, 128], u: byte[128], v: byte[128], uvStride: 1, fullRange: true}).raw()
			assert pc[0] == 0 && pc[4] == 255 && pc[8] == 128
		}
	}

	// Three 32x16 Motion JPEG frames in AVI, made by ffmpeg.
	const tinyMjpegAvi = ""
}
