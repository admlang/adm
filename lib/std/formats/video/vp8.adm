partial module std.formats.video {
	use std.formats.video.vp8::*

	// VP8 decodes VP8 video (RFC 6386), the codec of WebM: key and inter
	// frames with golden and alternate reference frames, every version's
	// motion filters and both loop filters. Frames the stream marks as not
	// shown (alternate reference updates) produce no picture. The GPU
	// decodes the frames where NVDEC or VA-API takes the stream.
	@decoder("vp8")
	type VP8 {
		// The upscaling the last key frame asks the player for, each way: 0 for
		// none, 1 for 5/4, 2 for 5/3 and 3 for 2. Frames come out at the coded
		// size either way.
		horizontalScale int
		verticalScale   int
		internal core   Vp8Core

		def new() {
			core = new Vp8Core()
		}

		// Starts a new stream; VP8 needs no setup bytes, the key frames carry
		// the size. Never fails.
		def configure(track Track) !none {
			core.reset(int(track.width), int(track.height))
			return none
		}

		// Decodes one frame. Fails when the frame is damaged or truncated, or
		// when the stream does not start with a key frame. An empty packet (a
		// dropped frame) produces no picture.
		def decode(packet Packet) !VideoFrame[] {
			let frames = try core.decode(packet)
			horizontalScale = core.dec.hScale
			verticalScale = core.dec.vScale
			return frames
		}

		// hardware implements HardwareDecoder: whether the GPU decodes the
		// frames (NVDEC or VA-API) and why not. Before the first key frame it
		// says whether the GPU would take a stream of the track's size.
		def hardware() VideoHardware {
			return core.hardware()
		}

		// keepOnGpu implements HardwareDecoder: whether the frames of pictures
		// the GPU decodes keep them there (see `Video.frames`).
		def keepOnGpu(on bool) {
			core.hw.gpu.gpuOutput = on
		}

		// VP8 holds no frames back, so this is always empty and never fails.
		def flush() !VideoFrame[] {
			return []
		}
	}
}
