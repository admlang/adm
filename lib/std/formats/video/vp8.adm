partial module std.formats.video {
	use std.formats.vp8::*

	// VP8 decodes VP8 video (RFC 6386), the codec of WebM: key and inter
	// frames with golden and alternate reference frames, every version's
	// motion filters and both loop filters. Frames the stream marks as not
	// shown (alternate reference updates) produce no picture.
	@decoder("vp8")
	type VP8 {
		// The upscaling the last key frame asks the player for, each way: 0 for
		// none, 1 for 5/4, 2 for 5/3 and 3 for 2. Frames come out at the coded
		// size either way.
		horizontalScale int
		verticalScale   int
		internal dec    Vp8Decoder

		def new() {
			dec = new Vp8Decoder()
		}

		// Starts a new stream; VP8 needs no setup bytes, the key frames carry
		// the size. Never fails.
		def configure(track Track) !none {
			dec = new Vp8Decoder()
			return none
		}

		// Decodes one frame. Fails when the frame is damaged or truncated, or
		// when the stream does not start with a key frame. An empty packet (a
		// dropped frame) produces no picture.
		def decode(packet Packet) !VideoFrame[] {
			return [] when packet.data.len() == 0
			try dec.decode(packet.data, 0, packet.data.len())
			horizontalScale = dec.hScale
			verticalScale = dec.vScale
			return [] unless dec.shown
			return [picture(packet)]
		}

		// VP8 holds no frames back, so this is always empty and never fails.
		def flush() !VideoFrame[] {
			return []
		}

		// The decoded planes cropped to the frame size, stamped with the
		// packet's time.
		internal def picture(packet Packet) VideoFrame {
			let w = dec.width
			let h = dec.height
			let cw = (w + 1) >> 1
			let ch = (h + 1) >> 1
			return VideoFrame{
				width: uint32(w),
				height: uint32(h),
				y: crop(dec.y, dec.yStride, w, h),
				u: crop(dec.u, dec.cStride, cw, ch),
				v: crop(dec.v, dec.cStride, cw, ch),
				yStride: w,
				uvStride: cw,
				time: packet.pts,
				length: packet.length,
				keyframe: dec.keyframe,
				matrix: 601
			}
		}

		// The top-left `w` x `h` pixels of a plane `stride` bytes wide, packed.
		internal def crop(plane byte[], stride int, w int, h int) byte[] {
			let out byte[]
			out.len(w * h)
			for let j = 0; j < h; j++ {
				plane[j * stride:j * stride + w].copy(out[j * w:j * w + w])
			}
			return out
		}
	}
}
