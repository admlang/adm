// What encoding VP8 shares between the still pictures of WebP and video
// (RFC 6386): the boolean entropy encoder, the forward transforms, the
// quantiser, the token writer and the tuning of token probabilities.
internal std.formats partial module std.formats.video.vp8 {
	use (
		std.math
		std.simd
	)

	// Vp8BoolEncoder writes the boolean entropy code a VP8 partition is made
	// of.
	type Vp8BoolEncoder {
		out   byte[]
		range int
		low   int
		count int
		// When not empty, how often each token probability saw a 0 and a 1.
		stats int[]

		def new() {
			out = []
			range = 255
			low = 0
			count = -24
			stats = []
		}

		// Writes a token bit with the probability `probs[i]`, counting it.
		def token(probs int[], i int, bit bool) {
			stats[2 * i + (bit ?? (1, 0))]++ when stats.len() > 0
			put(probs[i], bit)
		}

		// Writes one bit that is zero with probability `prob` / 256.
		def put(prob int, bit bool) {
			let split = 1 + (((range - 1) * prob) >> 8)
			if bit {
				low += split
				range -= split
			} else {
				range = split
			}
			let shift = 0
			for (range << shift) < 128 {
				shift++
			}
			range = range << shift
			count += shift
			if count >= 0 {
				let offset = shift - count
				if ((low << (offset - 1)) & 0x80000000) != 0 {
					let x = out.len() - 1
					for x >= 0 && int(out[x]) == 255 {
						out[x] = byte(0)
						x--
					}
					out[x] = byte(int(out[x]) + 1)
				}
				out.push(byte((low >> (24 - offset)) & 255))
				low = (low << offset) & 0xffffff
				shift = count
				count -= 8
			}
			low = (low << shift) & 0xffffffff
		}

		// Writes an `n`-bit value, most significant bit first, at even odds.
		def literal(v int, n int) {
			for let i = n - 1; i >= 0; i-- {
				put(128, ((v >> i) & 1) == 1)
			}
		}

		// The coded bytes, the coder flushed.
		def bytes() byte[] {
			for let i = 0; i < 32; i++ {
				put(128, false)
			}
			return out
		}
	}

	// Forward 4x4 DCT of the residual block at `at` (row stride `stride`)
	// into `out` from `o`, in natural order.
	def vp8ForwardDCT(res int[], at int, stride int, out int[], o int) {
		let r0 = simd.convert<int, int32>(simd.load4<int>(res, at))
		let r1 = simd.convert<int, int32>(simd.load4<int>(res, at + stride))
		let r2 = simd.convert<int, int32>(simd.load4<int>(res, at + 2 * stride))
		let r3 = simd.convert<int, int32>(simd.load4<int>(res, at + 3 * stride))
		let k2217 = simd.splat4<int32>(2217)
		let k5352 = simd.splat4<int32>(5352)

		// Columns in lanes, so the horizontal pass is lane-wise.
		let t0 = simd.zipLo(r0, r2)
		let t1 = simd.zipLo(r1, r3)
		let t2 = simd.zipHi(r0, r2)
		let t3 = simd.zipHi(r1, r3)
		let x0 = simd.zipLo(t0, t1)
		let x1 = simd.zipHi(t0, t1)
		let x2 = simd.zipLo(t2, t3)
		let x3 = simd.zipHi(t2, t3)
		let a = simd.shl(x0 + x3, 3)
		let b = simd.shl(x1 + x2, 3)
		let c = simd.shl(x1 - x2, 3)
		let d = simd.shl(x0 - x3, 3)
		let y0 = a + b
		let y1 = simd.shr(c * k2217 + d * k5352 + simd.splat4<int32>(14500), 12)
		let y2 = a - b
		let y3 = simd.shr(d * k2217 - c * k5352 + simd.splat4<int32>(7500), 12)

		// Rows back in lanes for the vertical pass.
		let u0 = simd.zipLo(y0, y2)
		let u1 = simd.zipLo(y1, y3)
		let u2 = simd.zipHi(y0, y2)
		let u3 = simd.zipHi(y1, y3)
		let z0 = simd.zipLo(u0, u1)
		let z1 = simd.zipHi(u0, u1)
		let z2 = simd.zipLo(u2, u3)
		let z3 = simd.zipHi(u2, u3)
		let a1 = z0 + z3
		let b1 = z1 + z2
		let c1 = z1 - z2
		let d1 = z0 - z3
		let zero = simd.splat4<int32>(0)
		let seven = simd.splat4<int32>(7)
		let odd = simd.blend(simd.ne(d1, zero), simd.splat4<int32>(1), zero)
		simd.store4<int>(out, o, simd.convert<int32, int>(simd.shr(a1 + b1 + seven, 4)))
		simd.store4<int>(out, o + 4, simd.convert<int32, int>(simd.shr(c1 * k2217 + d1 * k5352 + simd.splat4<int32>(12000), 16) + odd))
		simd.store4<int>(out, o + 8, simd.convert<int32, int>(simd.shr(a1 - b1 + seven, 4)))
		simd.store4<int>(out, o + 12, simd.convert<int32, int>(simd.shr(d1 * k2217 - c1 * k5352 + simd.splat4<int32>(51000), 16)))
	}

	// Forward Walsh-Hadamard transform of the sixteen luma DC coefficients.
	def vp8ForwardWHT(dc int[], out int[], o int) {
		let r0 = simd.convert<int, int32>(simd.load4<int>(dc, 0))
		let r1 = simd.convert<int, int32>(simd.load4<int>(dc, 4))
		let r2 = simd.convert<int, int32>(simd.load4<int>(dc, 8))
		let r3 = simd.convert<int, int32>(simd.load4<int>(dc, 12))
		let zero = simd.splat4<int32>(0)
		let one = simd.splat4<int32>(1)
		let t0 = simd.zipLo(r0, r2)
		let t1 = simd.zipLo(r1, r3)
		let t2 = simd.zipHi(r0, r2)
		let t3 = simd.zipHi(r1, r3)
		let x0 = simd.zipLo(t0, t1)
		let x1 = simd.zipHi(t0, t1)
		let x2 = simd.zipLo(t2, t3)
		let x3 = simd.zipHi(t2, t3)
		let a1 = simd.shl(x0 + x2, 2)
		let d1 = simd.shl(x1 + x3, 2)
		let c1 = simd.shl(x1 - x3, 2)
		let b1 = simd.shl(x0 - x2, 2)
		let y0 = a1 + d1 + simd.blend(simd.ne(a1, zero), one, zero)
		let y1 = b1 + c1
		let y2 = b1 - c1
		let y3 = a1 - d1
		let u0 = simd.zipLo(y0, y2)
		let u1 = simd.zipLo(y1, y3)
		let u2 = simd.zipHi(y0, y2)
		let u3 = simd.zipHi(y1, y3)
		let z0 = simd.zipLo(u0, u1)
		let z1 = simd.zipHi(u0, u1)
		let z2 = simd.zipLo(u2, u3)
		let z3 = simd.zipHi(u2, u3)
		let a2 = z0 + z2
		let d2 = z1 + z3
		let c2 = z1 - z3
		let b2 = z0 - z2
		let e0 = a2 + d2
		let e1 = b2 + c2
		let e2 = b2 - c2
		let e3 = a2 - d2
		let three = simd.splat4<int32>(3)
		e0 = e0 + simd.blend(simd.lt(e0, zero), one, zero)
		e1 = e1 + simd.blend(simd.lt(e1, zero), one, zero)
		e2 = e2 + simd.blend(simd.lt(e2, zero), one, zero)
		e3 = e3 + simd.blend(simd.lt(e3, zero), one, zero)
		simd.store4<int>(out, o, simd.convert<int32, int>(simd.shr(e0 + three, 3)))
		simd.store4<int>(out, o + 4, simd.convert<int32, int>(simd.shr(e1 + three, 3)))
		simd.store4<int>(out, o + 8, simd.convert<int32, int>(simd.shr(e2 + three, 3)))
		simd.store4<int>(out, o + 12, simd.convert<int32, int>(simd.shr(e3 + three, 3)))
	}

	// vp8Residual16 and vp8Residual8 write a block of a plane less the
	// workspace's prediction of it into `res`, row after row.
	def vp8Residual16(src byte[], so int, stride int, ybr int[], at int, res int[]) {
		for let j = 0; j < 16; j++ {
			let p = simd.convert<int, int32>(simd.load16<int>(ybr, at + j * 32))
			let s = simd.convert<byte, int32>(simd.load16<byte>(src, so + j * stride))
			simd.store16<int>(res, j * 16, simd.convert<int32, int>(s - p))
		}
	}

	def vp8Residual8(src byte[], so int, stride int, ybr int[], at int, res int[]) {
		for let j = 0; j < 8; j++ {
			let p = simd.convert<int, int32>(simd.load8<int>(ybr, at + j * 32))
			let s = simd.convert<byte, int32>(simd.load8<byte>(src, so + j * stride))
			simd.store8<int>(res, j * 8, simd.convert<int32, int>(s - p))
		}
	}

	// vp8Sad4 is the sum of absolute differences between the 4x4 block of
	// the workspace at `at` and of a plane at `so`.
	def vp8Sad4(ybr int[], at int, src byte[], so int, stride int) int {
		let acc = simd.splat4<int32>(0)
		for let j = 0; j < 4; j++ {
			let p = simd.convert<int, int32>(simd.load4<int>(ybr, at + j * 32))
			let s = simd.convert<byte, int32>(simd.load4<byte>(src, so + j * stride))
			acc = acc + simd.abs(p - s)
		}
		return int(simd.sum(acc))
	}

	// vp8Residual4 writes a 4x4 block of a plane less the workspace's
	// prediction of it into the first sixteen entries of `res`.
	def vp8Residual4(src byte[], so int, stride int, ybr int[], at int, res int[]) {
		for let j = 0; j < 4; j++ {
			let p = simd.convert<int, int32>(simd.load4<int>(ybr, at + j * 32))
			let s = simd.convert<byte, int32>(simd.load4<byte>(src, so + j * stride))
			simd.store4<int>(res, j * 4, simd.convert<int32, int>(s - p))
		}
	}

	// vp8QuantizeBlock quantises the sixteen coefficients at `at` of
	// `coeffs` into `levels` and writes what the decoder multiplies back
	// into `back`, both at `to`: the first with step `qdc` and half a step
	// of rounding, the others with `qac` and 6/16, as
	// `vp8QuantizeMacroblock` does for a block that keeps its DC. Reports
	// whether any level is not zero.
	def vp8QuantizeBlock(coeffs int[], at int, levels int[], back int[], to int, qdc int, qac int, rounding int = 6) bool {
		let zero = simd.splat16<int32>(0)
		let q = simd.splat16<int32>(int32(qac)).withLane(0, int32(qdc))
		let bias = simd.splat16<int32>(int32(rounding)).withLane(0, int32(8))
		let c = simd.convert<int, int32>(simd.load16<int>(coeffs, at))
		let num = simd.convert<int32, float32>(simd.shl(simd.abs(c), 4) + q * bias)
		let l = simd.min(simd.convert<float32, int32>(num / simd.convert<int32, float32>(simd.shl(q, 4))), simd.splat16<int32>(2048))
		let level = simd.blend(simd.lt(c, zero), zero - l, l)
		simd.store16<int>(levels, to, simd.convert<int32, int>(level))
		simd.store16<int>(back, to, simd.convert<int32, int>(level * q))
		return simd.maxLane(l) != 0
	}

	// vp8TransformMacroblock transforms a macroblock's residuals into its
	// 400 coefficients: sixteen luma blocks, four of each chroma plane,
	// then the second-order block of the luma DCs (`dcs` is its sixteen
	// entry workspace).
	def vp8TransformMacroblock(res int[], resU int[], resV int[], coeffs int[], dcs int[]) {
		for let n = 0; n < 16; n++ {
			vp8ForwardDCT(res, (n >> 2) * 64 + (n & 3) * 4, 16, coeffs, 16 * n)
			dcs[n] = coeffs[16 * n]
		}
		for let n = 0; n < 4; n++ {
			vp8ForwardDCT(resU, (n >> 1) * 32 + (n & 1) * 4, 8, coeffs, 256 + 16 * n)
			vp8ForwardDCT(resV, (n >> 1) * 32 + (n & 1) * 4, 8, coeffs, 320 + 16 * n)
		}
		vp8ForwardWHT(dcs, coeffs, 384)
	}

	// vp8QuantizeMacroblock quantises a macroblock's 400 coefficients into
	// `levels` and writes what the decoder will multiply back into `back`.
	// A coefficient rounds towards zero past `rounding`/16 of a step (8/16 for the
	// DCs of chroma and for the second-order block) and is clamped to what
	// the tokens carry; the luma DCs are left out, the second-order block
	// carries them. Returns one bit per block that holds a level, the
	// second-order block at bit 24.
	def vp8QuantizeMacroblock(coeffs int[], levels int[], back int[], y1ac int, y2dc int, y2ac int, uvdc int, uvac int, rounding int = 6) int {
		let zero = simd.splat16<int32>(0)
		let most = simd.splat16<int32>(2048)
		let mask = 0
		for let n = 0; n < 25; n++ {
			let q = simd.splat16<int32>(int32(y1ac))
			let bias = simd.splat16<int32>(int32(rounding))
			if n == 24 {
				q = simd.splat16<int32>(int32(y2ac)).withLane(0, int32(y2dc))
				bias = simd.splat16<int32>(8)
			} else if n >= 16 {
				q = simd.splat16<int32>(int32(uvac)).withLane(0, int32(uvdc))
				bias = bias.withLane(0, int32(8))
			}
			let c = simd.convert<int, int32>(simd.load16<int>(coeffs, 16 * n))
			// Numerators stay below 2^24, so the float quotient truncates
			// to the integer one.
			let num = simd.convert<int32, float32>(simd.shl(simd.abs(c), 4) + q * bias)
			let l = simd.min(simd.convert<float32, int32>(num / simd.convert<int32, float32>(simd.shl(q, 4))), most)
			let level = simd.blend(simd.lt(c, zero), zero - l, l)
			level = level.withLane(0, int32(0)) when n < 16
			simd.store16<int>(levels, 16 * n, simd.convert<int32, int>(level))
			simd.store16<int>(back, 16 * n, simd.convert<int32, int>(level * q))
			mask = mask | (1 << n) when simd.maxLane(simd.abs(level)) != 0
		}
		return mask
	}

	// Writes the tokens of one 4x4 block whose quantised coefficients sit at
	// `base` in natural order, and returns 1 when any is non-zero.
	def vp8PutBlock(e Vp8BoolEncoder, probs int[], levels int[], base int, plane int, context int, first int) int {
		let last = -1
		for let n = first; n < 16; n++ {
			last = n when levels[base + vp8Zigzag[n]] != 0
		}
		let pb = plane * 264
		let p = pb + (vp8Bands[first] * 3 + context) * 11
		if last < 0 {
			e.token(probs, p, false)
			return 0
		}
		e.token(probs, p, true)
		let n = first
		for n < 16 {
			let c = levels[base + vp8Zigzag[n]]
			let v = c < 0 ?? (0 - c, c)
			n++
			if v == 0 {
				e.token(probs, p + 1, false)
				p = pb + vp8Bands[n] * 33
				continue
			}
			e.token(probs, p + 1, true)
			let ctx = 2
			if v == 1 {
				e.token(probs, p + 2, false)
				ctx = 1
			} else {
				e.token(probs, p + 2, true)
				if v <= 4 {
					e.token(probs, p + 3, false)
					if v == 2 {
						e.token(probs, p + 4, false)
					} else {
						e.token(probs, p + 4, true)
						e.token(probs, p + 5, v == 4)
					}
				} else if v <= 10 {
					e.token(probs, p + 3, true)
					e.token(probs, p + 6, false)
					if v <= 6 {
						e.token(probs, p + 7, false)
						e.put(159, v == 6)
					} else {
						e.token(probs, p + 7, true)
						e.put(165, ((v - 7) >> 1) == 1)
						e.put(145, ((v - 7) & 1) == 1)
					}
				} else {
					e.token(probs, p + 3, true)
					e.token(probs, p + 6, true)
					let cat = v < 19 ?? (0, v < 35 ?? (1, v < 67 ?? (2, 3)))
					e.token(probs, p + 8, cat >= 2)
					e.token(probs, p + 9 + (cat >> 1), (cat & 1) == 1)
					let extra = v - 3 - (8 << cat)
					let t = cat * 12
					let nbits = 0
					for vp8Cat3456[t + nbits] != 0 {
						nbits++
					}
					for let k = 0; k < nbits; k++ {
						e.put(vp8Cat3456[t + k], ((extra >> (nbits - 1 - k)) & 1) == 1)
					}
				}
			}
			e.put(128, c < 0)
			p = pb + (vp8Bands[n] * 3 + ctx) * 11
			return 1 when n == 16
			if n > last {
				e.token(probs, p, false)
				return 1
			}
			e.token(probs, p, true)
		}
		return 1
	}

	// Picks new token probabilities from the counts of a first pass, where
	// the bits saved outweigh the cost of sending the update; marks those in
	// `updated`.
	def vp8TuneProbs(stats int[], probs int[], updated int[]) {
		for let i = 0; i < 1056; i++ {
			let n0 = stats[2 * i]
			let n1 = stats[2 * i + 1]
			continue when n0 + n1 == 0
			let p = vp8Clip((n0 * 256 + (n0 + n1) / 2) / (n0 + n1), 1, 255)
			let up = vp8TokenUpdateProb[i]
			let old = vp8BitCost(n0, n1, probs[i]) + vp8BitCost(1, 0, up)
			let fresh = vp8BitCost(n0, n1, p) + vp8BitCost(0, 1, up) + 8.0
			if fresh < old {
				probs[i] = p
				updated[i] = 1
			}
		}
	}

	// Bits to code `n0` zeros and `n1` ones when a zero has probability
	// `p` / 256.
	def vp8BitCost(n0 int, n1 int, p int) float {
		let zero = math.ln(float(p) / 256.0)
		let one = math.ln(float(256 - p) / 256.0)
		return (0.0 - float(n0) * zero - float(n1) * one) / math.ln(2.0)
	}

	// Sum of squared differences between an `n` x `n` block of the workspace
	// at `at` and the source plane at `so`.
	def vp8BlockSSE(ybr int[], at int, src byte[], so int, stride int, n int) int {
		let sum = 0
		for let j = 0; j < n; j++ {
			for let i = 0; i < n; i++ {
				let d = ybr[at + j * 32 + i] - int(src[so + j * stride + i])
				sum += d * d
			}
		}
		return sum
	}

	// Copies an image plane into a buffer padded to whole macroblocks by
	// repeating the last column and row.
	def vp8PadPlane(src byte[], w int, h int, stride int, rows int) byte[] {
		let out = vp8Bytes(stride * rows)
		for let y = 0; y < rows; y++ {
			let sy = y < h ?? (y, h - 1)
			for let x = 0; x < stride; x++ {
				out[y * stride + x] = src[sy * w + (x < w ?? (x, w - 1))]
			}
		}
		return out
	}
}
