internal std.formats partial module std.formats.video.vp8 {
	use std.testing

	check "VP8 encoder kernels" {
		// The forward transforms and the quantiser against the per-sample
		// arithmetic of RFC 6386's reference encoder, on pseudo-random
		// residuals over the whole range a prediction can leave.

		internal def residuals(n int, seed int, range int) int[] {
			let out = vp8Zeros(n)
			let x = seed
			for let i = 0; i < n; i++ {
				x = (x * 1103515245 + 12345) & 0x7fffffff
				out[i] = ((x >> 12) % (2 * range + 1)) - range
			}
			return out
		}

		internal def plainDCT(res int[], at int, stride int, out int[], o int) {
			let tmp = vp8Zeros(16)
			for let i = 0; i < 4; i++ {
				let r = at + i * stride
				let a1 = (res[r] + res[r + 3]) * 8
				let b1 = (res[r + 1] + res[r + 2]) * 8
				let c1 = (res[r + 1] - res[r + 2]) * 8
				let d1 = (res[r] - res[r + 3]) * 8
				tmp[i * 4] = a1 + b1
				tmp[i * 4 + 2] = a1 - b1
				tmp[i * 4 + 1] = (c1 * 2217 + d1 * 5352 + 14500) >> 12
				tmp[i * 4 + 3] = (d1 * 2217 - c1 * 5352 + 7500) >> 12
			}
			for let i = 0; i < 4; i++ {
				let a1 = tmp[i] + tmp[12 + i]
				let b1 = tmp[4 + i] + tmp[8 + i]
				let c1 = tmp[4 + i] - tmp[8 + i]
				let d1 = tmp[i] - tmp[12 + i]
				out[o + i] = (a1 + b1 + 7) >> 4
				out[o + 8 + i] = (a1 - b1 + 7) >> 4
				out[o + 4 + i] = ((c1 * 2217 + d1 * 5352 + 12000) >> 16) + (d1 != 0 ?? (1, 0))
				out[o + 12 + i] = (d1 * 2217 - c1 * 5352 + 51000) >> 16
			}
		}

		internal def plainWHT(dc int[], out int[], o int) {
			let tmp = vp8Zeros(16)
			for let i = 0; i < 4; i++ {
				let r = i * 4
				let a1 = (dc[r] + dc[r + 2]) * 4
				let d1 = (dc[r + 1] + dc[r + 3]) * 4
				let c1 = (dc[r + 1] - dc[r + 3]) * 4
				let b1 = (dc[r] - dc[r + 2]) * 4
				tmp[r] = a1 + d1 + (a1 != 0 ?? (1, 0))
				tmp[r + 1] = b1 + c1
				tmp[r + 2] = b1 - c1
				tmp[r + 3] = a1 - d1
			}
			for let i = 0; i < 4; i++ {
				let a1 = tmp[i] + tmp[8 + i]
				let d1 = tmp[4 + i] + tmp[12 + i]
				let c1 = tmp[4 + i] - tmp[12 + i]
				let b1 = tmp[i] - tmp[8 + i]
				let a2 = a1 + d1
				let b2 = b1 + c1
				let c2 = b1 - c1
				let d2 = a1 - d1
				a2 += 1 when a2 < 0
				b2 += 1 when b2 < 0
				c2 += 1 when c2 < 0
				d2 += 1 when d2 < 0
				out[o + i] = (a2 + 3) >> 3
				out[o + 4 + i] = (b2 + 3) >> 3
				out[o + 8 + i] = (c2 + 3) >> 3
				out[o + 12 + i] = (d2 + 3) >> 3
			}
		}

		internal def plainQuantize(c int, q int, bias int) int {
			let a = c < 0 ?? (0 - c, c)
			let l = (a * 16 + q * bias) / (q * 16)
			l = 2048 when l > 2048
			return c < 0 ?? (0 - l, l)
		}

		@test()
		def forwardTransformsMatchThePlainOnes() !none {
			let got = vp8Zeros(16)
			let want = vp8Zeros(16)
			for let seed = 1; seed <= 400; seed++ {
				// Every tenth block is as large as residuals get.
				let res = residuals(64, seed, seed % 10 == 0 ?? (255, 1 + seed % 97))
				res.fill(seed % 20 == 0 ?? (255, -255)) when seed % 10 == 0
				vp8ForwardDCT(res, 8, 12, got, 0)
				plainDCT(res, 8, 12, want, 0)
				assert got.equals(want)

				let dcs = residuals(16, seed + 1000, seed % 10 == 0 ?? (2040, 1 + (seed * 7) % 2040))
				dcs.fill(seed % 20 == 0 ?? (2040, -2040)) when seed % 10 == 0
				vp8ForwardWHT(dcs, got, 0)
				plainWHT(dcs, want, 0)
				assert got.equals(want)
			}
			return none
		}

		@test()
		def quantiserMatchesThePlainOne() !none {
			let levels = vp8Zeros(400)
			let back = vp8Zeros(400)
			for let seed = 1; seed <= 300; seed++ {
				let y1ac = 4 + (seed * 13) % 154
				let y2dc = 8 + (seed * 7) % 306
				let y2ac = 8 + (seed * 11) % 236
				let uvdc = 4 + (seed * 5) % 129
				let uvac = 4 + (seed * 3) % 154
				let coeffs = residuals(400, seed, seed % 3 == 0 ?? (16320, 1 + (seed * 31) % 900))
				// Exact multiples of a step and the values one below them.
				for let k = 0; k < 400; k += 5 {
					coeffs[k] = (k % 10 == 0 ?? (1, -1)) * ((k % 40) * y1ac - (k % 3))
				}
				let held = vp8QuantizeMacroblock(coeffs, levels, back, y1ac, y2dc, y2ac, uvdc, uvac)
				for let k = 0; k < 400; k++ {
					let dc = (k & 15) == 0
					let q = y1ac
					let bias = 6
					if k >= 384 {
						q = dc ?? (y2dc, y2ac)
						bias = 8
					} else if k >= 256 {
						q = dc ?? (uvdc, uvac)
						bias = dc ?? (8, 6)
					}
					let want = k < 256 && dc ?? (0, plainQuantize(coeffs[k], q, bias))
					assert levels[k] == want
					assert back[k] == want * q
					assert (held >> (k >> 4)) & 1 == 1 when want != 0
				}
				for let n = 0; n < 25; n++ {
					let some = false
					for let k = 16 * n; k < 16 * n + 16; k++ {
						some = true when levels[k] != 0
					}
					assert ((held >> n) & 1 == 1) == some
				}
			}
			return none
		}
	}
}
