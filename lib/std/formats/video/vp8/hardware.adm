internal std.formats partial module std.formats.video.vp8 {
	use (
		std.formats.video::*
		std.formats.video.hardware::*
	)

	// The frame description the runtime's adm_hwvideo.c reads, index by
	// index.
	const vp8HwKind = 0
	const vp8HwWidthMbs = 1
	const vp8HwHeightMbs = 2
	const vp8HwSurface = 3
	const vp8HwReference = 7
	const vp8HwIntra = 8
	const vp8HwWidth = 9
	const vp8HwHeight = 10
	const vp8HwLast = 11
	const vp8HwGolden = 12
	const vp8HwAltRef = 13
	const vp8HwKey = 14
	const vp8HwVersion = 15
	const vp8HwShow = 16
	const vp8HwSegmentation = 17
	const vp8HwUpdateMap = 18
	const vp8HwUpdateData = 19
	const vp8HwSimpleFilter = 20
	const vp8HwSharpness = 21
	const vp8HwLFAdjust = 22
	const vp8HwLFDeltaUpdate = 23
	const vp8HwSignBiasGolden = 24
	const vp8HwSignBiasAltRef = 25
	const vp8HwSkipEnabled = 26
	const vp8HwFilterLevel = 27
	const vp8HwProbSkip = 28
	const vp8HwProbIntra = 29
	const vp8HwProbLast = 30
	const vp8HwProbGolden = 31
	const vp8HwHeaderSize = 32
	const vp8HwFirstPartition = 33
	const vp8HwBoolBits = 34
	const vp8HwBoolValue = 35
	const vp8HwBoolRange = 36
	const vp8HwPartitions = 37
	const vp8HwSegmentProbs = 40
	const vp8HwFilterLevels = 44
	const vp8HwRefDeltas = 48
	const vp8HwModeDeltas = 52
	const vp8HwYModeProbs = 56
	const vp8HwUVModeProbs = 60
	const vp8HwMvProbs = 64
	const vp8HwPartitionSizes = 104
	const vp8HwQuant = 112
	const vp8HwTokenProbs = 136
	const vp8HwSize = 1192

	// The mode probabilities of key frames, which the header does not carry.
	const vp8KeyYModeProb = int[145, 156, 163, 128]
	const vp8KeyUVModeProb = int[142, 114, 183]

	// Where the VP8 decoder's frames go to the GPU: the decoder parses each
	// frame's header and keeps the reference slots, the GPU decodes the
	// macroblocks.
	type Vp8Hardware {
		gpu  HwDecoder
		desc int[]

		def new() {
			gpu = new HwDecoder()
			desc = int[]
			desc.len(vp8HwSize)
		}

		// Opens a session for frames of `width` x `height` unless one fits;
		// called at key frames, which need no earlier frame.
		def configure(width int, height int) {
			let w = (width + 15) & ~15
			let h = (height + 15) & ~15
			return when gpu.disabled || gpu.fits(hwCodecVp8, w, h)
			// Three reference slots and the frame decoding.
			gpu.open(hwCodecVp8, 0, w, h, 4)
		}

		// Decodes on the GPU the frame in `data[0:size]` whose header `dec`
		// has parsed, into a picture buffer no reference holds. Fails when no
		// buffer is free or the driver refuses the frame.
		def decode(dec Vp8Decoder, data byte[], size int) !none {
			let busy int[]
			for let i = 1; i < dec.before.len(); i++ {
				busy.push(dec.before[i].surface)
			}
			let surface = gpu.freeSurface(busy)
			fail "vp8: every GPU picture buffer is in use" when surface < 0
			dec.cur.surface = surface
			describe(dec)
			return gpu.decode(desc, data, size)
		}

		// Fills the description of the frame `dec` has parsed.
		def describe(dec Vp8Decoder) {
			let o = desc
			o.fill(0)
			let key = dec.keyframe
			let refs = dec.before
			o[vp8HwKind] = hwCodecVp8
			o[vp8HwWidthMbs] = dec.mbw
			o[vp8HwHeightMbs] = dec.mbh
			o[vp8HwSurface] = dec.cur.surface
			o[vp8HwReference] = 1
			o[vp8HwIntra] = key ?? (1, 0)
			o[vp8HwWidth] = dec.width
			o[vp8HwHeight] = dec.height
			o[vp8HwLast] = !key && refs.len() == 4 ?? (refs[1].surface, -1)
			o[vp8HwGolden] = !key && refs.len() == 4 ?? (refs[2].surface, -1)
			o[vp8HwAltRef] = !key && refs.len() == 4 ?? (refs[3].surface, -1)
			o[vp8HwKey] = key ?? (1, 0)
			o[vp8HwVersion] = dec.version
			o[vp8HwShow] = dec.shown ?? (1, 0)
			o[vp8HwSegmentation] = dec.useSegment ?? (1, 0)
			o[vp8HwUpdateMap] = dec.updateMap ?? (1, 0)
			o[vp8HwUpdateData] = dec.updateData ?? (1, 0)
			o[vp8HwSimpleFilter] = dec.simple ?? (1, 0)
			o[vp8HwSharpness] = dec.sharpness
			o[vp8HwLFAdjust] = dec.useLFDelta ?? (1, 0)
			o[vp8HwLFDeltaUpdate] = dec.updateLFDelta ?? (1, 0)
			o[vp8HwSignBiasGolden] = dec.signBias[2]
			o[vp8HwSignBiasAltRef] = dec.signBias[3]
			o[vp8HwSkipEnabled] = dec.useSkipProb ?? (1, 0)
			o[vp8HwFilterLevel] = dec.level
			o[vp8HwProbSkip] = dec.skipProb
			o[vp8HwProbIntra] = dec.probIntra
			o[vp8HwProbLast] = dec.probLast
			o[vp8HwProbGolden] = dec.probGolden
			o[vp8HwHeaderSize] = dec.headerSize
			o[vp8HwFirstPartition] = dec.firstSize
			o[vp8HwBoolBits] = dec.headerBits
			o[vp8HwBoolValue] = dec.headerValue
			o[vp8HwBoolRange] = dec.headerRange
			o[vp8HwPartitions] = dec.partSizes.len()
			for let i = 0; i < 3; i++ {
				o[vp8HwSegmentProbs + i] = dec.segProb[i]
			}
			for let i = 0; i < 4; i++ {
				let level = dec.level
				level = dec.relative ?? (level + dec.segFilter[i], dec.segFilter[i]) when dec.useSegment
				o[vp8HwFilterLevels + i] = level.max(0).min(63)
				o[vp8HwRefDeltas + i] = dec.refLFDelta[i]
				o[vp8HwModeDeltas + i] = dec.modeLFDelta[i]
				o[vp8HwYModeProbs + i] = key ?? (vp8KeyYModeProb[i], dec.yModeProb[i])
			}
			for let i = 0; i < 3; i++ {
				o[vp8HwUVModeProbs + i] = key ?? (vp8KeyUVModeProb[i], dec.uvModeProb[i])
			}
			for let i = 0; i < 38; i++ {
				o[vp8HwMvProbs + i] = dec.mvProb[i]
			}
			for let i = 0; i < dec.partSizes.len() && i < 8; i++ {
				o[vp8HwPartitionSizes + i] = dec.partSizes[i]
			}
			for let i = 0; i < 24; i++ {
				o[vp8HwQuant + i] = dec.quantIndex[i]
			}
			for let i = 0; i < 1056; i++ {
				o[vp8HwTokenProbs + i] = dec.tokenProb[i]
			}
		}
	}

	// What the VP8 type decodes with: the decoder, which parses every frame
	// and decodes it unless the GPU does, and the GPU session.
	type Vp8Core {
		dec         Vp8Decoder
		hw          Vp8Hardware
		// Set after the GPU gave up mid-stream: frames wait for the next key
		// frame, as the references were on the GPU.
		waitKey     bool
		// The track's size, for saying before the first frame whether the
		// GPU would decode it.
		trackWidth  int
		trackHeight int

		def new() {
			dec = new Vp8Decoder()
			hw = new Vp8Hardware()
		}

		// Starts a new stream of a track of `width` x `height`.
		def reset(width int, height int) {
			dec = new Vp8Decoder()
			waitKey = false
			trackWidth = width
			trackHeight = height
		}

		// See `VP8.decode`.
		def decode(packet Packet) !VideoFrame[] {
			let size = packet.data.len()
			return [] when size == 0
			let key = (int(packet.data[0]) & 1) == 0
			if key && size >= 10 {
				waitKey = false
				let (w, h) = dec.header(packet.data, 0, size) onerror recover (0, 0)
				hw.configure(w, h) when w > 0
			} else if waitKey {
				return []
			}
			if !hw.gpu.active() {
				try dec.decode(packet.data, 0, size)
				return [] unless dec.shown
				return [picture(packet)]
			}
			try dec.parse(packet.data, 0, size)
			dec.cur = dec.freePicture(false)
			hw.decode(dec, packet.data, size) onerror (err error) {
				abandon("{err}")
				return []
			}
			dec.complete()
			return [] unless dec.shown
			let frame = gpuPicture(packet) onerror (err error) {
				abandon("{err}")
				return []
			}
			return [frame]
		}

		// See `VP8.hardware`.
		def hardware() VideoHardware {
			let open = hw.gpu.session
			return VideoHardware{decoding: true, encoding: false, name: hwName(open.backend), device: open.device, reason: ""} unless open is none
			return VideoHardware{decoding: false, encoding: false, name: "", device: "", reason: hw.gpu.why} when hw.gpu.disabled || dec.width > 0
			let choice = hwProbe(hwCodecVp8, 0, 1, 8, (trackWidth + 15) & ~15, (trackHeight + 15) & ~15)
			return VideoHardware{decoding: false, encoding: false, name: "", device: "", reason: hwLastError()} when choice is none
			return VideoHardware{decoding: true, encoding: false, name: choice.name, device: choice.device, reason: ""}
		}

		// Gives up the GPU after `reason`: the stream goes on in software
		// from its next key frame.
		def abandon(reason string) {
			hw.gpu.abandon(reason)
			dec = new Vp8Decoder()
			waitKey = true
		}

		// The frame the GPU decoded, cropped to even sizes, its picture kept
		// there or copied to main memory. Fails when the GPU cannot give it
		// back.
		def gpuPicture(packet Packet) !VideoFrame {
			let w = (dec.width + 1) & ~1
			let h = (dec.height + 1) & ~1
			let frame = VideoFrame{
				width:    uint32(dec.width),
				height:   uint32(dec.height),
				yStride:  w,
				uvStride: w >> 1,
				time:     packet.pts,
				length:   packet.length,
				keyframe: dec.keyframe,
				matrix:   601
			}
			if hw.gpu.gpuOutput {
				let kept = hw.gpu.keep(dec.cur.surface, 0, 0, w, h)
				fail "vp8: no GPU session" when kept is none
				frame.gpu = new GpuPicture(kept)
				frame.onGpu = true
				return frame
			}
			let (y, u, v) = try hw.gpu.download(dec.cur.surface, 0, 0, w, h)
			frame.y = y
			frame.u = u
			frame.v = v
			return frame
		}

		// The decoded planes cropped to the frame size, stamped with the
		// packet's time.
		def picture(packet Packet) VideoFrame {
			let w = dec.width
			let h = dec.height
			let cw = (w + 1) >> 1
			let ch = (h + 1) >> 1
			return VideoFrame{
				width:    uint32(w),
				height:   uint32(h),
				y:        crop(dec.y, dec.yStride, w, h),
				u:        crop(dec.u, dec.cStride, cw, ch),
				v:        crop(dec.v, dec.cStride, cw, ch),
				yStride:  w,
				uvStride: cw,
				time:     packet.pts,
				length:   packet.length,
				keyframe: dec.keyframe,
				matrix:   601
			}
		}

		// The top-left `w` x `h` pixels of a plane `stride` bytes wide, packed.
		def crop(plane byte[], stride int, w int, h int) byte[] {
			let out byte[]
			out.len(w * h)
			for let j = 0; j < h; j++ {
				plane[j * stride:j * stride + w].copy(out[j * w:j * w + w])
			}
			return out
		}
	}
}
