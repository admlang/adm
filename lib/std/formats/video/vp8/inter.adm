internal std.formats partial module std.formats.video.vp8 {
	// Six-tap filtering of a `w` x `h` block from `src` at `s0`, the taps of
	// eighth-pixel position `f` applied along `step` (1 across a row, the
	// row stride down a column), into `dst` at `d0` with row stride `ds`.
	// Rounds and clamps to eight bits.
	def vp8Tap6Block(src byte[], s0 int, ss int, step int, dst int[], d0 int, ds int, w int, h int, f int) {
		if w & 7 == 0 {
			vp8Tap6BlockSimd(src, s0, ss, step, dst, d0, ds, w, h, f)
		} else {
			vp8Tap6Generic(src, s0, ss, step, dst, d0, ds, w, h, f)
		}
	}

	// `vp8Tap6Block` one sample at a time, for blocks narrower than eight.
	def vp8Tap6Generic(src byte[], s0 int, ss int, step int, dst int[], d0 int, ds int, w int, h int, f int) {
		let t = f * 6
		let t0 = vp8SixTap[t]
		let t1 = vp8SixTap[t + 1]
		let t2 = vp8SixTap[t + 2]
		let t3 = vp8SixTap[t + 3]
		let t4 = vp8SixTap[t + 4]
		let t5 = vp8SixTap[t + 5]
		let m2 = 2 * step
		let p3 = 3 * step
		for let j = 0; j < h; j++ {
			let s = s0 + j * ss
			let d = d0 + j * ds
			for let i = 0; i < w; i++ {
				let p = s + i
				let a = int(src[p - m2]) * t0 - int(src[p - step]) * t1 + int(src[p]) * t2 + int(src[p + step]) * t3 - int(src[p + m2]) * t4 + int(src[p + p3]) * t5
				a = (a + 64) >> 7
				dst[d + i] = a < 0 ?? (0, a > 255 ?? (255, a))
			}
		}
	}

	// Six-tap sub-pixel interpolation of a `w` x `h` block from `src` at
	// `s0` (row stride `ss`) into the workspace at `at`, horizontally by `fx`
	// and vertically by `fy` eighths. Both passes round and clamp; a pass
	// whose position is whole is skipped, as its filter leaves pixels alone.
	def vp8SixTap2D(src byte[], s0 int, ss int, dst int[], at int, w int, h int, fx int, fy int, tmp int[]) {
		if fy == 0 {
			vp8Tap6Block(src, s0, ss, 1, dst, at, 32, w, h, fx)
			return
		}
		if fx == 0 {
			vp8Tap6Block(src, s0, ss, ss, dst, at, 32, w, h, fy)
			return
		}
		vp8Tap6Block(src, s0 - 2 * ss, ss, 1, tmp, 0, 16, w, h + 5, fx)
		if w & 7 == 0 {
			vp8Tap6ColumnsSimd(tmp, dst, at, w, h, fy)
		} else {
			vp8Tap6ColumnsGeneric(tmp, dst, at, w, h, fy)
		}
	}

	// The vertical pass of `vp8SixTap2D` one sample at a time, for blocks
	// narrower than eight.
	def vp8Tap6ColumnsGeneric(tmp int[], dst int[], at int, w int, h int, fy int) {
		let t = fy * 6
		let t0 = vp8SixTap[t]
		let t1 = vp8SixTap[t + 1]
		let t2 = vp8SixTap[t + 2]
		let t3 = vp8SixTap[t + 3]
		let t4 = vp8SixTap[t + 4]
		let t5 = vp8SixTap[t + 5]
		for let j = 0; j < h; j++ {
			let s = (j + 2) * 16
			let d = at + j * 32
			for let i = 0; i < w; i++ {
				let p = s + i
				let a = tmp[p - 32] * t0 - tmp[p - 16] * t1 + tmp[p] * t2 + tmp[p + 16] * t3 - tmp[p + 32] * t4 + tmp[p + 48] * t5
				a = (a + 64) >> 7
				dst[d + i] = a < 0 ?? (0, a > 255 ?? (255, a))
			}
		}
	}

	// Bilinear sub-pixel interpolation, the filter of VP8 versions 1 to 3:
	// a horizontal pass over one row more than the block, then a vertical
	// one, each rounding to eight bits.
	def vp8Bilinear(src byte[], s0 int, ss int, dst int[], at int, w int, h int, fx int, fy int, tmp int[]) {
		if w & 7 == 0 {
			vp8BilinearSimd(src, s0, ss, dst, at, w, h, fx, fy, tmp)
		} else {
			vp8BilinearGeneric(src, s0, ss, dst, at, w, h, fx, fy, tmp)
		}
	}

	// `vp8Bilinear` one sample at a time, for blocks narrower than eight.
	def vp8BilinearGeneric(src byte[], s0 int, ss int, dst int[], at int, w int, h int, fx int, fy int, tmp int[]) {
		let h1 = 16 * fx
		let h0 = 128 - h1
		let v1 = 16 * fy
		let v0 = 128 - v1
		for let j = 0; j < h + 1; j++ {
			let s = s0 + j * ss
			let d = j * 16
			for let i = 0; i < w; i++ {
				tmp[d + i] = (int(src[s + i]) * h0 + int(src[s + i + 1]) * h1 + 64) >> 7
			}
		}
		for let j = 0; j < h; j++ {
			let s = j * 16
			let d = at + j * 32
			for let i = 0; i < w; i++ {
				dst[d + i] = (tmp[s + i] * v0 + tmp[s + i + 16] * v1 + 64) >> 7
			}
		}
	}
}
