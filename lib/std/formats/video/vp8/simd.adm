internal std.formats partial module std.formats.video.vp8 {
	use std.simd

	// The decoder's kernels on SIMD vectors. They give exactly the results
	// of the per-pixel code they replace. The loop filters take eight lines
	// of an edge at a time in 16-bit lanes: a horizontal edge loads its rows
	// as vectors, a vertical edge transposes the 8 x 8 samples around it so
	// each column is one. The six-tap filter works in 32-bit lanes, whose
	// sums do not fit 16 bits.

	// Eight samples from `s[p:]` in 16-bit lanes.
	def vp8Wide8(s byte[], p int) vec8<int16> {
		return simd.convert<byte, int16>(simd.load8<byte>(s, p))
	}

	// Eight 16-bit lanes back to samples, already in 0..255.
	def vp8Narrow8(s byte[], p int, v vec8<int16>) {
		simd.store8<byte>(s, p, simd.convert<int16, byte>(v))
	}

	// `v` clamped to lo..hi per lane.
	def vp8Clip8(v vec8<int16>, lo int, hi int) vec8<int16> {
		return simd.clamp(v, simd.splat8<int16>(int16(lo)), simd.splat8<int16>(int16(hi)))
	}

	// The normal filter across eight lines: the samples p3..q3 on each
	// side, the filtered p2..q2 back. A macroblock edge (not `inner`)
	// adjusts up to three samples each side, an inner edge up to two; lines
	// with high edge variance adjust one.
	def vp8Normal8(p3 vec8<int16>, p2 vec8<int16>, p1 vec8<int16>, p0 vec8<int16>, q0 vec8<int16>, q1 vec8<int16>, q2 vec8<int16>, q3 vec8<int16>, level int, ilevel int, hlevel int, inner bool) (bool, vec8<int16>, vec8<int16>, vec8<int16>, vec8<int16>, vec8<int16>, vec8<int16>) {
		let il = simd.splat8<int16>(int16(ilevel))
		let a10 = (p1 - p0).abs()
		let b10 = (q1 - q0).abs()
		let e = ((p0 - q0).abs() << 1) + ((p1 - q1).abs() >> 1)
		let on = e.le(simd.splat8<int16>(int16(level))) & (p3 - p2).abs().le(il) & (p2 - p1).abs().le(il) & a10.le(il) & b10.le(il) & (q2 - q1).abs().le(il) & (q3 - q2).abs().le(il)
		return (false, p2, p1, p0, q0, q1, q2) unless on.any()
		let hl = simd.splat8<int16>(int16(hlevel))
		let hev = a10.gt(hl) | b10.gt(hl)
		let hevOn = on & hev
		let rest = on & hev.invert()
		let c = vp8Clip8(p1 - q1, -128, 127)
		let d = (q0 - p0) * simd.splat8<int16>(int16(3))
		// High variance: p0 and q0 only.
		let ah = d + c
		let h1 = vp8Clip8((ah + simd.splat8<int16>(int16(4))) >> 3, -16, 15)
		let h2 = vp8Clip8((ah + simd.splat8<int16>(int16(3))) >> 3, -16, 15)
		let np0 = hevOn.blend(vp8Clip8(p0 + h2, 0, 255), p0)
		let nq0 = hevOn.blend(vp8Clip8(q0 - h1, 0, 255), q0)
		if inner {
			let i1 = vp8Clip8((d + simd.splat8<int16>(int16(4))) >> 3, -16, 15)
			let i2 = vp8Clip8((d + simd.splat8<int16>(int16(3))) >> 3, -16, 15)
			let i3 = (i1 + simd.splat8<int16>(int16(1))) >> 1
			return (true, p2, rest.blend(vp8Clip8(p1 + i3, 0, 255), p1), rest.blend(vp8Clip8(p0 + i2, 0, 255), np0), rest.blend(vp8Clip8(q0 - i1, 0, 255), nq0), rest.blend(vp8Clip8(q1 - i3, 0, 255), q1), q2)
		}
		let a = vp8Clip8(d + c, -128, 127)
		let r = simd.splat8<int16>(int16(63))
		let m1 = (a * simd.splat8<int16>(int16(27)) + r) >> 7
		let m2 = (a * simd.splat8<int16>(int16(18)) + r) >> 7
		let m3 = (a * simd.splat8<int16>(int16(9)) + r) >> 7
		return (true, rest.blend(vp8Clip8(p2 + m3, 0, 255), p2), rest.blend(vp8Clip8(p1 + m2, 0, 255), p1), rest.blend(vp8Clip8(p0 + m1, 0, 255), np0), rest.blend(vp8Clip8(q0 - m1, 0, 255), nq0), rest.blend(vp8Clip8(q1 - m2, 0, 255), q1), rest.blend(vp8Clip8(q2 - m3, 0, 255), q2))
	}

	// `vp8Filter246` on vectors: the `n` lines (a multiple of eight) of the
	// edge in front of `index`, lines `iStep` apart, samples across the edge
	// `jStep` apart. One of the steps must be 1.
	def vp8Filter246Simd(pix byte[], n int, level int, ilevel int, hlevel int, index int, iStep int, jStep int, inner bool) {
		if iStep == 1 {
			// A horizontal edge: each row across it is a vector of lines.
			for let k = 0; k < n; k += 8 {
				let at = index + k
				let (hit, p2, p1, p0, q0, q1, q2) = vp8Normal8(vp8Wide8(pix, at - 4 * jStep), vp8Wide8(pix, at - 3 * jStep), vp8Wide8(pix, at - 2 * jStep), vp8Wide8(pix, at - jStep), vp8Wide8(pix, at), vp8Wide8(pix, at + jStep), vp8Wide8(pix, at + 2 * jStep), vp8Wide8(pix, at + 3 * jStep), level, ilevel, hlevel, inner)
				continue unless hit
				vp8Narrow8(pix, at - 3 * jStep, p2)
				vp8Narrow8(pix, at - 2 * jStep, p1)
				vp8Narrow8(pix, at - jStep, p0)
				vp8Narrow8(pix, at, q0)
				vp8Narrow8(pix, at + jStep, q1)
				vp8Narrow8(pix, at + 2 * jStep, q2)
			}
			return
		}
		// A vertical edge: eight lines at a time, turned into columns.
		for let k = 0; k < n; k += 8 {
			let o = index + k * iStep - 4
			let (c0, c1, c2, c3, c4, c5, c6, c7) = simd.transpose8(simd.load8<byte>(pix, o), simd.load8<byte>(pix, o + iStep), simd.load8<byte>(pix, o + 2 * iStep), simd.load8<byte>(pix, o + 3 * iStep), simd.load8<byte>(pix, o + 4 * iStep), simd.load8<byte>(pix, o + 5 * iStep), simd.load8<byte>(pix, o + 6 * iStep), simd.load8<byte>(pix, o + 7 * iStep))
			let (hit, p2, p1, p0, q0, q1, q2) = vp8Normal8(simd.convert<byte, int16>(c0), simd.convert<byte, int16>(c1), simd.convert<byte, int16>(c2), simd.convert<byte, int16>(c3), simd.convert<byte, int16>(c4), simd.convert<byte, int16>(c5), simd.convert<byte, int16>(c6), simd.convert<byte, int16>(c7), level, ilevel, hlevel, inner)
			continue unless hit
			let (r0, r1, r2, r3, r4, r5, r6, r7) = simd.transpose8(c0, simd.convert<int16, byte>(p2), simd.convert<int16, byte>(p1), simd.convert<int16, byte>(p0), simd.convert<int16, byte>(q0), simd.convert<int16, byte>(q1), simd.convert<int16, byte>(q2), c7)
			simd.store8<byte>(pix, o, r0)
			simd.store8<byte>(pix, o + iStep, r1)
			simd.store8<byte>(pix, o + 2 * iStep, r2)
			simd.store8<byte>(pix, o + 3 * iStep, r3)
			simd.store8<byte>(pix, o + 4 * iStep, r4)
			simd.store8<byte>(pix, o + 5 * iStep, r5)
			simd.store8<byte>(pix, o + 6 * iStep, r6)
			simd.store8<byte>(pix, o + 7 * iStep, r7)
		}
	}

	// A macroblock's row of `n` (8 or 16) reconstructed samples from the
	// workspace into a plane, keeping each value's low byte as `byte(x)`.
	def vp8StoreRow(ybr int[], s int, plane byte[], d int, n int) {
		if n == 16 {
			simd.store16<byte>(plane, d, simd.convert<int, byte>(simd.load16<int>(ybr, s)))
		} else {
			simd.store8<byte>(plane, d, simd.convert<int, byte>(simd.load8<int>(ybr, s)))
		}
	}

	// `vp8Tap6Block` for blocks at least eight wide (w a multiple of 8):
	// eight outputs at a time in 32-bit lanes.
	def vp8Tap6BlockSimd(src byte[], s0 int, ss int, step int, dst int[], d0 int, ds int, w int, h int, f int) {
		let t = f * 6
		let t0 = simd.splat8<int32>(int32(vp8SixTap[t]))
		let t1 = simd.splat8<int32>(int32(vp8SixTap[t + 1]))
		let t2 = simd.splat8<int32>(int32(vp8SixTap[t + 2]))
		let t3 = simd.splat8<int32>(int32(vp8SixTap[t + 3]))
		let t4 = simd.splat8<int32>(int32(vp8SixTap[t + 4]))
		let t5 = simd.splat8<int32>(int32(vp8SixTap[t + 5]))
		let round = simd.splat8<int32>(int32(64))
		let zero = simd.splat8<int32>(int32(0))
		let top = simd.splat8<int32>(int32(255))
		let m2 = 2 * step
		let p3 = 3 * step
		for let j = 0; j < h; j++ {
			let s = s0 + j * ss
			let d = d0 + j * ds
			for let i = 0; i < w; i += 8 {
				let p = s + i
				let a = simd.convert<byte, int32>(simd.load8<byte>(src, p - m2)) * t0 - simd.convert<byte, int32>(simd.load8<byte>(src, p - step)) * t1 + simd.convert<byte, int32>(simd.load8<byte>(src, p)) * t2 + simd.convert<byte, int32>(simd.load8<byte>(src, p + step)) * t3 - simd.convert<byte, int32>(simd.load8<byte>(src, p + m2)) * t4 + simd.convert<byte, int32>(simd.load8<byte>(src, p + p3)) * t5
				simd.store8<int>(dst, d + i, simd.convert<int32, int>(simd.clamp((a + round) >> 7, zero, top)))
			}
		}
	}

	// The vertical pass of `vp8SixTap2D` over the horizontally filtered rows
	// in `tmp` (stride 16), eight outputs at a time.
	def vp8Tap6ColumnsSimd(tmp int[], dst int[], at int, w int, h int, f int) {
		let t = f * 6
		let t0 = simd.splat8<int32>(int32(vp8SixTap[t]))
		let t1 = simd.splat8<int32>(int32(vp8SixTap[t + 1]))
		let t2 = simd.splat8<int32>(int32(vp8SixTap[t + 2]))
		let t3 = simd.splat8<int32>(int32(vp8SixTap[t + 3]))
		let t4 = simd.splat8<int32>(int32(vp8SixTap[t + 4]))
		let t5 = simd.splat8<int32>(int32(vp8SixTap[t + 5]))
		let round = simd.splat8<int32>(int32(64))
		let zero = simd.splat8<int32>(int32(0))
		let top = simd.splat8<int32>(int32(255))
		for let j = 0; j < h; j++ {
			let s = (j + 2) * 16
			let d = at + j * 32
			for let i = 0; i < w; i += 8 {
				let p = s + i
				let a = simd.convert<int, int32>(simd.load8<int>(tmp, p - 32)) * t0 - simd.convert<int, int32>(simd.load8<int>(tmp, p - 16)) * t1 + simd.convert<int, int32>(simd.load8<int>(tmp, p)) * t2 + simd.convert<int, int32>(simd.load8<int>(tmp, p + 16)) * t3 - simd.convert<int, int32>(simd.load8<int>(tmp, p + 32)) * t4 + simd.convert<int, int32>(simd.load8<int>(tmp, p + 48)) * t5
				simd.store8<int>(dst, d + i, simd.convert<int32, int>(simd.clamp((a + round) >> 7, zero, top)))
			}
		}
	}

	// Workspace rows of `n` (4, 8 or 16) values, 32 apart, from `at`, set
	// to `value`.
	def vp8FillRows(ybr int[], at int, n int, value int) {
		if n == 4 {
			let v4 = simd.splat4<int>(value)
			for let j = 0; j < 4; j++ {
				simd.store4<int>(ybr, at + j * 32, v4)
			}
			return
		}
		let v = simd.splat8<int>(value)
		for let j = 0; j < n; j++ {
			let r = at + j * 32
			for let i = 0; i < n; i += 8 {
				simd.store8<int>(ybr, r + i, v)
			}
		}
	}

	// Each of the `n` rows (4, 8 or 16) from `at` copied from the row
	// above the block.
	def vp8CopyAboveRows(ybr int[], at int, n int) {
		if n == 4 {
			let v4 = simd.load4<int>(ybr, at - 32)
			for let j = 0; j < 4; j++ {
				simd.store4<int>(ybr, at + j * 32, v4)
			}
			return
		}
		for let i = 0; i < n; i += 8 {
			let v = simd.load8<int>(ybr, at - 32 + i)
			for let j = 0; j < n; j++ {
				simd.store8<int>(ybr, at + j * 32 + i, v)
			}
		}
	}

	// Each of the `n` rows (4, 8 or 16) from `at` filled with the value
	// left of it.
	def vp8LeftRows(ybr int[], at int, n int) {
		if n == 4 {
			for let j = 0; j < 4; j++ {
				let r = at + j * 32
				simd.store4<int>(ybr, r, simd.splat4<int>(ybr[r - 1]))
			}
			return
		}
		for let j = 0; j < n; j++ {
			let r = at + j * 32
			let v = simd.splat8<int>(ybr[r - 1])
			for let i = 0; i < n; i += 8 {
				simd.store8<int>(ybr, r + i, v)
			}
		}
	}

	// TrueMotion over `n` rows (4, 8 or 16): left + above - corner, clamped
	// to 0..255.
	def vp8TrueMotionRows(ybr int[], at int, n int) {
		let top = at - 32
		let corner = ybr[top - 1]
		if n == 4 {
			let above = simd.load4<int>(ybr, top)
			for let j = 0; j < 4; j++ {
				let r = at + j * 32
				simd.store4<int>(ybr, r, simd.clamp(simd.splat4<int>(ybr[r - 1] - corner) + above, simd.splat4<int>(0), simd.splat4<int>(255)))
			}
			return
		}
		let zero = simd.splat8<int>(0)
		let max = simd.splat8<int>(255)
		for let j = 0; j < n; j++ {
			let r = at + j * 32
			let left = simd.splat8<int>(ybr[r - 1] - corner)
			for let i = 0; i < n; i += 8 {
				simd.store8<int>(ybr, r + i, simd.clamp(left + simd.load8<int>(ybr, top + i), zero, max))
			}
		}
	}

	// Adds `dc` to the 4 x 4 block at `at`, clamped to 0..255.
	def vp8AddDC4(ybr int[], at int, dc int) {
		let d = simd.splat4<int>(dc)
		let zero = simd.splat4<int>(0)
		let max = simd.splat4<int>(255)
		for let j = 0; j < 4; j++ {
			let r = at + j * 32
			simd.store4<int>(ybr, r, simd.clamp(simd.load4<int>(ybr, r) + d, zero, max))
		}
	}

	// The simple filter across eight lines: p0 and q0 move toward each other
	// where the edge difference is at most `level`.
	def vp8Simple8(p1 vec8<int16>, p0 vec8<int16>, q0 vec8<int16>, q1 vec8<int16>, level int) (bool, vec8<int16>, vec8<int16>) {
		let on = (((p0 - q0).abs() << 1) + ((p1 - q1).abs() >> 1)).le(simd.splat8<int16>(int16(level)))
		return (false, p0, q0) unless on.any()
		let a = (q0 - p0) * simd.splat8<int16>(int16(3)) + vp8Clip8(p1 - q1, -128, 127)
		let a1 = vp8Clip8((a + simd.splat8<int16>(int16(4))) >> 3, -16, 15)
		let a2 = vp8Clip8((a + simd.splat8<int16>(int16(3))) >> 3, -16, 15)
		return (true, on.blend(vp8Clip8(p0 + a2, 0, 255), p0), on.blend(vp8Clip8(q0 - a1, 0, 255), q0))
	}

	// `vp8Filter2` on vectors: the 16 lines of the edge in front of `index`.
	def vp8Filter2Simd(pix byte[], level int, index int, iStep int, jStep int) {
		if iStep == 1 {
			for let k = 0; k < 16; k += 8 {
				let at = index + k
				let (hit, p0, q0) = vp8Simple8(vp8Wide8(pix, at - 2 * jStep), vp8Wide8(pix, at - jStep), vp8Wide8(pix, at), vp8Wide8(pix, at + jStep), level)
				continue unless hit
				vp8Narrow8(pix, at - jStep, p0)
				vp8Narrow8(pix, at, q0)
			}
			return
		}
		for let k = 0; k < 16; k += 8 {
			let o = index + k * iStep - 4
			let (c0, c1, c2, c3, c4, c5, c6, c7) = simd.transpose8(simd.load8<byte>(pix, o), simd.load8<byte>(pix, o + iStep), simd.load8<byte>(pix, o + 2 * iStep), simd.load8<byte>(pix, o + 3 * iStep), simd.load8<byte>(pix, o + 4 * iStep), simd.load8<byte>(pix, o + 5 * iStep), simd.load8<byte>(pix, o + 6 * iStep), simd.load8<byte>(pix, o + 7 * iStep))
			let (hit, p0, q0) = vp8Simple8(simd.convert<byte, int16>(c2), simd.convert<byte, int16>(c3), simd.convert<byte, int16>(c4), simd.convert<byte, int16>(c5), level)
			continue unless hit
			let (r0, r1, r2, r3, r4, r5, r6, r7) = simd.transpose8(c0, c1, c2, simd.convert<int16, byte>(p0), simd.convert<int16, byte>(q0), c5, c6, c7)
			simd.store8<byte>(pix, o, r0)
			simd.store8<byte>(pix, o + iStep, r1)
			simd.store8<byte>(pix, o + 2 * iStep, r2)
			simd.store8<byte>(pix, o + 3 * iStep, r3)
			simd.store8<byte>(pix, o + 4 * iStep, r4)
			simd.store8<byte>(pix, o + 5 * iStep, r5)
			simd.store8<byte>(pix, o + 6 * iStep, r6)
			simd.store8<byte>(pix, o + 7 * iStep, r7)
		}
	}

	// `vp8Bilinear` for blocks at least eight wide (w a multiple of 8): the
	// same two rounding passes, eight outputs at a time in 32-bit lanes.
	def vp8BilinearSimd(src byte[], s0 int, ss int, dst int[], at int, w int, h int, fx int, fy int, tmp int[]) {
		let h1 = simd.splat8<int32>(int32(16 * fx))
		let h0 = simd.splat8<int32>(int32(128 - 16 * fx))
		let v1 = simd.splat8<int32>(int32(16 * fy))
		let v0 = simd.splat8<int32>(int32(128 - 16 * fy))
		let round = simd.splat8<int32>(int32(64))
		for let j = 0; j < h + 1; j++ {
			let s = s0 + j * ss
			let d = j * 16
			for let i = 0; i < w; i += 8 {
				let a = simd.convert<byte, int32>(simd.load8<byte>(src, s + i)) * h0 + simd.convert<byte, int32>(simd.load8<byte>(src, s + i + 1)) * h1
				simd.store8<int>(tmp, d + i, simd.convert<int32, int>((a + round) >> 7))
			}
		}
		for let j = 0; j < h; j++ {
			let s = j * 16
			let d = at + j * 32
			for let i = 0; i < w; i += 8 {
				let a = simd.convert<int, int32>(simd.load8<int>(tmp, s + i)) * v0 + simd.convert<int, int32>(simd.load8<int>(tmp, s + i + 16)) * v1
				simd.store8<int>(dst, d + i, simd.convert<int32, int>((a + round) >> 7))
			}
		}
	}
}
