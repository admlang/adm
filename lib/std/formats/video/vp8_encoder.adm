partial module std.formats.video {
	use std.formats.video.vp8::(Vp8Encoder, vp8DequantAC)

	// VideoEncoder turns the pictures of one video track into its packets,
	// one packet a picture, at a bitrate that may be changed while it runs
	// (a congestion controller does).
	interface VideoEncoder {
		// Encodes one picture. `forceKey` makes it a frame that needs none
		// before it. Fails for a picture the encoder was not made for.
		def encode(frame VideoFrame, forceKey bool = false) !Packet
		// Sets the bits per second aimed for from the next picture on.
		def setBitrate(bitsPerSecond int)
	}

	// VP8Encoder encodes 8-bit 4:2:0 pictures of one size as VP8 (RFC
	// 6386), each from the one before, with a key frame first, every
	// `keyInterval` pictures and on request.
	//
	// The bitrate is kept by a leaky bucket: every picture adds its bits
	// and takes out its share of the bitrate, and what the bucket holds
	// is paid back over the next half second. A picture's quantiser
	// follows from the budget that leaves it and from what the pictures
	// before cost at theirs; a key frame gets four shares and is coded
	// again, coarser, when it comes out more than half over that. When
	// the bucket holds more than half a second of the bitrate, the
	// picture is not coded: its packet repeats the last one in a few
	// bytes.
	//
	//     let encoder = new video.VP8Encoder(1280, 720, 1500000)
	//     let packet = try encoder.encode(frame)
	type VP8Encoder {
		width             uint32
		height            uint32
		// Pictures per second the bitrate is spread over.
		frameRate         int        = 30
		// A key frame at least this often, in pictures; 0 for the first
		// and on request only.
		keyInterval       int        = 300
		// With 2, every other picture is one no later picture is
		// predicted from (a second temporal layer): a receiver or a
		// relay may drop those and show half the pictures. `layer` says
		// which the last picture was.
		temporalLayers    int        = 1
		internal core     Vp8Encoder
		internal bucket   RateBucket
		internal sinceKey int        = 0
		internal upper    bool       = false
		internal skipped  bool       = false

		def new(width int, height int, bitsPerSecond int = 1000000, frameRate int = 30) {
			self.width = uint32(width)
			self.height = uint32(height)
			self.frameRate = frameRate.max(1)
			core = new Vp8Encoder(width, height)
			// A starting point that suits about 0.1 bit a pixel.
			let perPixel = bitsPerSecond.max(10000) * 1000 / (self.frameRate * width * height).max(1)
			bucket = new RateBucket(vp8DequantAC, minIndex, maxIndex, 8, 24, bitsPerSecond, self.frameRate, (72 - perPixel / 4).max(8).min(110))
			core.quantIndex = bucket.index
		}

		// encode implements VideoEncoder. Fails for a picture of another
		// size, with other chroma than 4:2:0 or more than 8 bits, or one
		// that is on the GPU.
		def encode(frame VideoFrame, forceKey bool = false) !Packet {
			fail "vp8: the encoder takes {width}x{height} pictures, not {frame.width}x{frame.height}" unless frame.width == width && frame.height == height
			fail "vp8: the encoder takes 8-bit 4:2:0 pictures in main memory" unless frame.bitDepth == 8 && frame.chroma == ChromaLayout.Yuv420 && !frame.onGpu
			core.load(frame.y, frame.yStride, frame.u, frame.v, frame.uvStride)
			bucket.frameRate = frameRate.max(1)
			let key = forceKey || !core.started || (keyInterval > 0 && sinceKey >= keyInterval)
			// The picture after a kept one is the droppable one.
			upper = temporalLayers > 1 && !key && sinceKey % 2 == 1
			skipped = !key && bucket.full()
			let data byte[]
			if skipped {
				data = core.encode(false, upper, true)
			} else {
				let budget = bucket.budget(key)
				bucket.aim(key, budget)
				core.quantIndex = bucket.index
				data = core.encode(key, upper)
				// A key frame is what the pictures behind it are built on:
				// it is coded again, finer or coarser, until it is within
				// its budget and uses most of it (twice at most; a key
				// frame resets all state, so coding it again is safe).
				for let again = 0; key && again < 2 && bucket.refit(data.len() * 8, budget); again++ {
					core.quantIndex = bucket.index
					data = core.encode(true)
				}
				bucket.measure(data.len() * 8, key)
			}
			sinceKey = key ?? (1, sinceKey + 1)
			bucket.spend(data.len() * 8)
			return Packet{track: 0, data: data, pts: frame.time, dts: frame.time, length: frame.length, keyframe: key}
		}

		// setBitrate implements VideoEncoder.
		def setBitrate(bitsPerSecond int) {
			bucket.rate = bitsPerSecond.max(10000)
		}

		// layer is the temporal layer of the picture encoded last: 0 for
		// one later pictures need, 1 for one that may be dropped.
		def layer() int {
			return upper ?? (1, 0)
		}

		// repeated reports whether the last packet repeats the picture
		// before it because the bitrate had no room for a new one.
		def repeated() bool {
			return skipped
		}

		// quantizer is the quantiser index the last picture was coded
		// with, 0 (finest) to 127.
		def quantizer() int {
			return core.quantIndex
		}
	}

	// The quantiser indexes rate control stays within.
	internal const minIndex = 2
	internal const maxIndex = 124
}
