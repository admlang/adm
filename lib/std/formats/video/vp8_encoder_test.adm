partial module std.formats.video {
	use (
		std.formats.video.vp8::(Vp8Encoder, vp8ModeB, vp8ModeSplit, vp8RefAltRef, vp8RefGolden, vp8RefLast)
		std.math
		std.testing
	)

	// moving is picture `n` of a test sequence: a gradient with a bright
	// square that moves three pixels right and two down a picture, over
	// chroma that drifts.
	internal def moving(width int, height int, n int) VideoFrame {
		let cw = (width + 1) >> 1
		let ch = (height + 1) >> 1
		let y byte[]
		y.len(width * height)
		let u byte[]
		u.len(cw * ch)
		let v byte[]
		v.len(cw * ch)
		let left = (8 + 3 * n) % (width - 24).max(1)
		let top = (6 + 2 * n) % (height - 24).max(1)
		for let j = 0; j < height; j++ {
			for let i = 0; i < width; i++ {
				let inside = i >= left && i < left + 20 && j >= top && j < top + 20
				y[j * width + i] = byte(inside ?? (200 + ((i + j) & 31), 40 + ((i * 3 + j * 2) & 63)))
			}
		}
		for let j = 0; j < ch; j++ {
			for let i = 0; i < cw; i++ {
				u[j * cw + i] = byte(110 + ((i + n) & 15))
				v[j * cw + i] = byte(130 + ((j + n) & 15))
			}
		}
		return VideoFrame{width: uint32(width), height: uint32(height), y: y, u: u, v: v, yStride: width, uvStride: cw, time: duration(n * 33333333), length: 33ms, matrix: 601}
	}

	// lumaPsnr is the peak signal-to-noise ratio of a decoded picture's
	// luma against the picture it was made from, in decibels.
	internal def lumaPsnr(source VideoFrame, decoded VideoFrame) float {
		let w = int(source.width)
		let h = int(source.height)
		let sum = 0
		for let j = 0; j < h; j++ {
			for let i = 0; i < w; i++ {
				let d = int(source.y[j * source.yStride + i]) - int(decoded.y[j * decoded.yStride + i])
				sum += d * d
			}
		}
		return 99.0 when sum == 0
		return 10.0 * math.log10(255.0 * 255.0 * float(w * h) / float(sum))
	}

	internal def encodeMany(width int, height int, count int) !none {
		let encoder = new VP8Encoder(width, height, 1500000)
		for let n = 0; n < count; n++ {
			try encoder.encode(moving(width, height, n))
		}
		return none
	}

	check "VP8 encoder" {
		// Thirty pictures of 96x64 encoded and decoded again with this
		// module's decoder: the first is a key frame, the others are not
		// and are smaller, every one comes back close to its picture, a
		// forced key frame is one, and what the encoder was not made for
		// is refused.
		@test()
		def encodesWhatTheDecoderReads() !none {
			let encoder = new VP8Encoder(96, 64, 400000)
			let decoder = new VP8()
			try decoder.configure(Track{index: 0, kind: TrackKind.Video, codec: "vp8"})
			let keySize = 0
			let interSize = 0
			let worst = 99.0
			for let n = 0; n < 30; n++ {
				let source = moving(96, 64, n)
				let packet = try encoder.encode(source, n == 20)
				assert packet.keyframe == (n == 0 || n == 20) && packet.pts == source.time
				assert ((int(packet.data[0]) & 1) == 0) == packet.keyframe
				if n == 0 {
					keySize = packet.data.len()
				} else if n != 20 {
					interSize += packet.data.len()
				}
				let pictures = try decoder.decode(packet)
				assert pictures.len() == 1 && pictures[0].width == 96 && pictures[0].height == 64
				worst = worst.min(lumaPsnr(source, pictures[0]))
			}
			assert worst > 30.0 && interSize / 28 < keySize

			let refused = 0
			encoder.encode(moving(64, 48, 0)) onerror (err error) {
				refused++
				recover Packet{track: 0, data: [], pts: 0s, dts: 0s, length: 0s, keyframe: false}
			}
			let deep = moving(96, 64, 0)
			deep.bitDepth = 10
			encoder.encode(deep) onerror (err error) {
				refused++
				recover Packet{track: 0, data: [], pts: 0s, dts: 0s, length: 0s, keyframe: false}
			}
			assert refused == 2
			return none
		}

		// Sizes that are not whole macroblocks, and one smaller than a
		// macroblock, decode to their own size.
		@test()
		def oddSizes() !none {
			for let size in [[50, 34], [17, 9], [8, 8]] {
				let encoder = new VP8Encoder(size[0], size[1], 300000)
				let decoder = new VP8()
				try decoder.configure(Track{index: 0, kind: TrackKind.Video, codec: "vp8"})
				for let n = 0; n < 4; n++ {
					let source = moving(size[0], size[1], n)
					let pictures = try decoder.decode(try encoder.encode(source))
					assert pictures.len() == 1 && int(pictures[0].width) == size[0] && int(pictures[0].height) == size[1] && lumaPsnr(source, pictures[0]) > 28.0
				}
			}
			return none
		}

		// The quantiser follows the bitrate: three seconds at 150 kbit/s
		// come out within a third of it, and coarser than at 600 kbit/s.
		@test()
		def followsTheBitrate() !none {
			let low = new VP8Encoder(160, 120, 150000)
			let high = new VP8Encoder(160, 120, 600000)
			let bits = 0
			for let n = 0; n < 90; n++ {
				let source = moving(160, 120, n)
				bits += (try low.encode(source)).data.len() * 8
				try high.encode(source)
			}
			assert bits > 300000 && bits < 600000 && low.quantizer() > high.quantizer()
			low.setBitrate(600000)
			for let n = 90; n < 150; n++ {
				try low.encode(moving(160, 120, n))
			}
			assert low.quantizer() < 60
			return none
		}

		// The bits of every second, the first with its key frame included,
		// stay within 8% of the bitrate at three bitrates, and a lower
		// bitrate set while running holds from the next second on. The
		// top rows of the pictures carry noise, which no frame predicts:
		// they can use any bitrate.
		@test()
		def holdsTheBitrateEverySecond() !none {
			for let rate in [100000, 180000, 250000] {
				let encoder = new VP8Encoder(160, 120, rate)
				let window = 0
				for let n = 0; n < 180; n++ {
					encoder.setBitrate(rate / 2) when n == 120
					let source = moving(160, 120, n)
					for let k = 0; k < 160 * 16; k++ {
						source.y[k] = byte(int(source.y[k]) + (k * 7919 + n * 104729 + (k >> 3) * n * 31) % 61)
					}
					window += (try encoder.encode(source)).data.len() * 8
					continue unless n % 30 == 29
					let aim = n < 120 ?? (rate, rate / 2)
					fail "rate {rate} second {n / 30}: {window * 100 / aim}% q{encoder.quantizer()}" unless window * 100 > aim * 92 && window * 100 < aim * 108
					window = 0
				}
			}
			return none
		}

		// A bitrate far below what the pictures need: some packets repeat
		// the picture before them, which a decoder then shows unchanged,
		// and the bits stay near the bitrate all the same.
		@test()
		def repeatsWhenTheBitrateHasNoRoom() !none {
			let encoder = new VP8Encoder(160, 120, 12000)
			let decoder = new VP8()
			try decoder.configure(Track{index: 0, kind: TrackKind.Video, codec: "vp8"})
			let repeats = 0
			let bits = 0
			let last byte[]
			for let n = 0; n < 90; n++ {
				let packet = try encoder.encode(moving(160, 120, n * 5))
				bits += packet.data.len() * 8
				let pictures = try decoder.decode(packet)
				assert pictures.len() == 1
				if encoder.repeated() {
					repeats++
					assert !packet.keyframe && packet.data.len() < 40 && pictures[0].y.equals(last)
				}
				last = pictures[0].y.clone()
			}
			assert repeats > 0 && repeats < 80 && bits < 3 * 12000 * 2
			return none
		}

		// Pictures of fine detail make macroblocks that are coded block
		// by block (4x4 intra prediction), in a key frame and, when the
		// picture changes altogether, in a frame behind it; the decoder
		// builds what the encoder kept from both.
		@test()
		def blockByBlockIntra() !none {
			let encoder = new Vp8Encoder(96, 64)
			encoder.quantIndex = 30
			let decoder = new VP8()
			try decoder.configure(Track{index: 0, kind: TrackKind.Video, codec: "vp8"})
			for let n = 0; n < 3; n++ {
				// Diagonal stripes, which 4x4 prediction follows and
				// whole-block prediction does not; their direction, width
				// and levels change from picture to picture, so no
				// picture before predicts anything.
				let source = moving(96, 64, 0)
				for let j = 0; j < 64; j++ {
					for let i = 0; i < 96; i++ {
						let level = n == 1 ?? (((i - j + 96) % 6) < 3 ?? (230, 110), ((i + j) % (8 - n)) < 4 - n / 2 ?? (190 + 20 * n, 60 - 15 * n))
						source.y[j * 96 + i] = byte(level)
					}
				}
				encoder.load(source.y, source.yStride, source.u, source.v, source.uvStride)
				let data = encoder.encode()
				let byBlocks = 0
				let intra = 0
				for let mode in encoder.yModes {
					byBlocks++ when mode == vp8ModeB
					intra++ when mode >= 0
				}
				fail "picture {n}: {byBlocks} by blocks, {intra} intra of {encoder.yModes.len()}" unless byBlocks >= 12 && intra >= 20
				let pictures = try decoder.decode(Packet{track: 0, data: data, pts: 0s, dts: 0s, length: 33ms, keyframe: n == 0})
				let kept = encoder.rec.refs[vp8RefLast]
				for let j = 0; j < 64; j++ {
					assert kept.y[j * encoder.rec.yStride:j * encoder.rec.yStride + 96].equals(pictures[0].y[j * pictures[0].yStride:j * pictures[0].yStride + 96])
				}
				assert lumaPsnr(source, pictures[0]) > 30.0
			}
			return none
		}

		// Four parts of a picture that move each their own way, meeting
		// inside macroblocks: those get several vectors, in halves one
		// above the other, halves side by side and quarters, and the
		// decoder builds what the encoder kept.
		@test()
		def severalVectorsInAMacroblock() !none {
			let encoder = new Vp8Encoder(96, 64)
			encoder.quantIndex = 30
			let decoder = new VP8()
			try decoder.configure(Track{index: 0, kind: TrackKind.Video, codec: "vp8"})
			let seen = [0, 0, 0, 0]
			for let n = 0; n < 3; n++ {
				let source = moving(96, 64, 0)
				for let j = 0; j < 64; j++ {
					for let i = 0; i < 96; i++ {
						// The parts meet at column 40 and row 24; each is a
						// texture of 2x2 squares that slides.
						let part = (i < 40 ?? (0, 1)) + (j < 24 ?? (0, 2))
						let a = (1000 + i - n * (part == 0 ?? (2, part == 1 ?? (-2, part == 3 ?? (1, 0))))) >> 1
						let b = (1000 + j - n * (part == 2 ?? (2, part == 3 ?? (1, 0)))) >> 1
						source.y[j * 96 + i] = byte(60 + (a * 7919 + b * 104729 + a * b * 31 + part * 57) % 127)
					}
				}
				encoder.load(source.y, source.yStride, source.u, source.v, source.uvStride)
				let data = encoder.encode()
				for let m = 0; n > 0 && m < encoder.naming.len(); m++ {
					seen[encoder.layouts[m]]++ when encoder.yModes[m] < 0 && encoder.naming[m] == vp8ModeSplit
				}
				let pictures = try decoder.decode(Packet{track: 0, data: data, pts: 0s, dts: 0s, length: 33ms, keyframe: n == 0})
				let kept = encoder.rec.refs[vp8RefLast]
				for let j = 0; j < 64; j++ {
					assert kept.y[j * encoder.rec.yStride:j * encoder.rec.yStride + 96].equals(pictures[0].y[j * pictures[0].yStride:j * pictures[0].yStride + 96])
				}
				for let j = 0; j < 32; j++ {
					assert kept.u[j * encoder.rec.cStride:j * encoder.rec.cStride + 48].equals(pictures[0].u[j * pictures[0].uvStride:j * pictures[0].uvStride + 48])
				}
				assert lumaPsnr(source, pictures[0]) > 30.0
			}
			fail "layouts seen: {seen[0]} 16x8, {seen[1]} 8x16, {seen[2]} 8x8" unless seen[0] > 0 && seen[1] > 0 && seen[2] > 0
			return none
		}

		// A square crosses a still texture and comes back: what it uncovers
		// is not in the last frame, and is predicted from the golden frame
		// or the alternate one. A frame becomes the golden one on the way,
		// and the decoder builds what the encoder kept throughout.
		@test()
		def predictsFromFramesFurtherBack() !none {
			let encoder = new Vp8Encoder(96, 64)
			encoder.quantIndex = 30
			let decoder = new VP8()
			try decoder.configure(Track{index: 0, kind: TrackKind.Video, codec: "vp8"})
			let golden = 0
			let alternate = 0
			let replaced = 0
			for let n = 0; n < 29; n++ {
				let source = moving(96, 64, 0)
				let left = 4 + 5 * (n <= 14 ?? (n, 28 - n))
				for let j = 0; j < 64; j++ {
					for let i = 0; i < 96; i++ {
						let inside = i >= left && i < left + 16 && j >= 24 && j < 40
						source.y[j * 96 + i] = byte(inside ?? (230, 60 + ((i >> 1) * 7919 + (j >> 1) * 104729 + (i >> 1) * (j >> 1) * 31) % 127))
					}
				}
				encoder.load(source.y, source.yStride, source.u, source.v, source.uvStride)
				let data = encoder.encode()
				replaced++ when encoder.gilding
				for let m = 0; n > 0 && m < encoder.yModes.len(); m++ {
					continue unless encoder.yModes[m] < 0
					golden++ when encoder.rec.mbRef[m] == vp8RefGolden
					alternate++ when encoder.rec.mbRef[m] == vp8RefAltRef
				}
				let pictures = try decoder.decode(Packet{track: 0, data: data, pts: 0s, dts: 0s, length: 33ms, keyframe: n == 0})
				let kept = encoder.rec.refs[vp8RefLast]
				for let j = 0; j < 64; j++ {
					assert kept.y[j * encoder.rec.yStride:j * encoder.rec.yStride + 96].equals(pictures[0].y[j * pictures[0].yStride:j * pictures[0].yStride + 96])
				}
				assert lumaPsnr(source, pictures[0]) > 30.0
			}
			fail "{golden} macroblocks from the golden frame, {alternate} from the alternate, {replaced} golden frames" unless golden > 0 && alternate > 0 && replaced == 1
			return none
		}

		// A stretch that cost far more than the bitrate (key frames at a
		// few kbit/s) is not paid back for longer than a second: once
		// the bitrate allows pictures again, they are coded.
		@test()
		def recoversAfterStarving() !none {
			let encoder = new VP8Encoder(160, 120, 10000)
			for let n = 0; n < 60; n++ {
				try encoder.encode(moving(160, 120, n), true)
			}
			encoder.setBitrate(300000)
			let coded = 0
			for let n = 60; n < 120; n++ {
				try encoder.encode(moving(160, 120, n))
				coded++ unless encoder.repeated()
			}
			assert coded >= 25
			return none
		}

		// No drift: 120 pictures behind one key frame, and after each the
		// picture this module's decoder builds is, byte for byte, the one
		// the encoder keeps to predict the next from.
		@test()
		def decodersBuildTheEncodersReference() !none {
			let encoder = new Vp8Encoder(96, 64)
			encoder.quantIndex = 48
			let decoder = new VP8()
			try decoder.configure(Track{index: 0, kind: TrackKind.Video, codec: "vp8"})
			for let n = 0; n < 120; n++ {
				let source = moving(96, 64, n)
				encoder.load(source.y, source.yStride, source.u, source.v, source.uvStride)
				// The quantiser moves as a rate control would move it.
				encoder.quantIndex = 30 + (n * 7) % 60
				let data = encoder.encode()
				assert ((int(data[0]) & 1) == 0) == (n == 0)
				let pictures = try decoder.decode(Packet{track: 0, data: data, pts: source.time, dts: source.time, length: source.length, keyframe: n == 0})
				assert pictures.len() == 1
				let kept = encoder.rec.refs[vp8RefLast]
				for let j = 0; j < 64; j++ {
					let ours = j * encoder.rec.yStride
					let theirs = j * pictures[0].yStride
					assert kept.y[ours:ours + 96].equals(pictures[0].y[theirs:theirs + 96])
				}
				for let j = 0; j < 32; j++ {
					let ours = j * encoder.rec.cStride
					let theirs = j * pictures[0].uvStride
					assert kept.u[ours:ours + 48].equals(pictures[0].u[theirs:theirs + 48]) && kept.v[ours:ours + 48].equals(pictures[0].v[theirs:theirs + 48])
				}
			}
			return none
		}

		// With two temporal layers every other picture may be dropped: a
		// decoder given only the others reads each of them as well as one
		// given them all, and a key frame is never droppable.
		@test()
		def droppablePicturesAreNotNeeded() !none {
			let encoder = new VP8Encoder(96, 64, 400000)
			encoder.temporalLayers = 2
			let whole = new VP8()
			let half = new VP8()
			try whole.configure(Track{index: 0, kind: TrackKind.Video, codec: "vp8"})
			try half.configure(Track{index: 0, kind: TrackKind.Video, codec: "vp8"})
			let dropped = 0
			for let n = 0; n < 24; n++ {
				let source = moving(96, 64, n)
				let packet = try encoder.encode(source, n == 13)
				assert encoder.layer() == 0 when packet.keyframe
				let all = try whole.decode(packet)
				assert all.len() == 1 && lumaPsnr(source, all[0]) > 30.0
				if encoder.layer() == 1 {
					dropped++
					continue
				}
				let kept = try half.decode(packet)
				assert kept.len() == 1 && kept[0].y.equals(all[0].y) && kept[0].u.equals(all[0].u) && kept[0].v.equals(all[0].v)
			}
			assert dropped >= 10 && dropped <= 12
			return none
		}

		// Thirty pictures encoded, at 320x240 and at 1280x720.
		@benchmark()
		def BenchEncode320x240() {
			encodeMany(320, 240, 30) onerror recover none
		}

		@benchmark()
		def BenchEncode1280x720() {
			encodeMany(1280, 720, 30) onerror recover none
		}
	}
}
