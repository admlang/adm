		// The frames of an IVF file as packets, stamped by its time base.
		internal def packets(ivf byte[]) Packet[] {
			let le32 = def (o int) int {
				return int(ivf[o]) | (int(ivf[o + 1]) << 8) | (int(ivf[o + 2]) << 16) | (int(ivf[o + 3]) << 24)
			}
			let rate = int64(le32(16))
			let scale = int64(le32(20))
			let out = Packet[]
			let p = int(ivf[6]) | (int(ivf[7]) << 8)
			for p + 12 <= ivf.len() {
				let size = le32(p)
				let pts = duration(int64(le32(p + 4)) * scale * 1000000000 / rate)
				out.push(Packet{track: 0, data: ivf[p + 12:p + 12 + size].clone(), pts: pts, dts: pts, length: 0s, keyframe: (int(ivf[p + 12]) & 1) == 0})
				p += 12 + size
			}
			return out
		}

		// MD5 of each decoded frame's Y, U and V planes, as ffmpeg's framemd5
		// prints them.
		internal def frameHashes(stream byte[]) !string[] {
			let codec = new VP8()
			let out = string[]
			for let (_, packet) in packets(stream) {
				for let (_, frame) in try codec.decode(packet) {
					let h = new hash.MD5()
					h.write(frame.y)
					h.write(frame.u)
					h.write(frame.v)
					out.push(h.hash().hex().lower())
				}
			}
			return out
		}

		// MD5 of each frame's visible planes, decoded in software, or on the
		// GPU where ADM_VIDEO_HW and the machine allow with the pictures kept
		// there when `onGpu` and then downloaded; with what the GPU did.
		internal def gpuHashes(stream byte[], software bool, onGpu bool = false) !(string[], VideoHardware) {
			let codec = new Vp8Core()
			codec.hw.gpu.disabled = software
			codec.hw.gpu.gpuOutput = onGpu
			let out = string[]
			for let (_, packet) in packets(stream) {
				for let (_, frame) in try codec.decode(packet) {
					assert frame.onGpu == (onGpu && codec.hardware().decoding)
					try download(frame)
					let w = int(frame.width)
					let h = int(frame.height)
					let m = new hash.MD5()
					for let r = 0; r < h; r++ {
						m.write(frame.y[r * frame.yStride:r * frame.yStride + w])
					}
					for let r = 0; r < (h + 1) / 2; r++ {
						m.write(frame.u[r * frame.uvStride:r * frame.uvStride + (w + 1) / 2])
					}
					for let r = 0; r < (h + 1) / 2; r++ {
						m.write(frame.v[r * frame.uvStride:r * frame.uvStride + (w + 1) / 2])
					}
					out.push(m.hash().hex().lower())
				}
			}
			return (out, codec.hardware())
		}

		@test()
		def decodes_on_the_gpu_bit_exact() !none {
			// VP8 is exact: with NVDEC or VA-API the frames equal software's,
			// kept on the GPU or not; without, every run is software.
			for let stream in [try altrefStream(), try bilinearStream(), try segmentedStream()] {
				let (soft, softHw) = try gpuHashes(stream, software = true)
				assert !softHw.decoding
				let (gpu, hw) = try gpuHashes(stream, software = false)
				assert gpu.equals(soft)
				if hw.decoding {
					assert hw.name := "NVDEC" || "VA-API"
				} else {
					assert hw.reason != ""
				}
				let (kept, _) = try gpuHashes(stream, software = false, onGpu = true)
				assert kept.equals(soft)
			}
		}

		@test()
		def decodes_reference_frames_bit_exact() !none {
			let want = string[
				"cd57f5518b13d608a87a10c13159d0e0", "3f5b3f4f23df6d76b70ad66a8407f4d2", "d4f10eb8ba1184205b81bd0e42116191",
				"8610acea4c396a8de8213bf050b85f3d", "7f9c083fbda9e1d5776ecc562c3500a1", "03058ca237aa6ffdcd78c5f423061362",
				"81058bf15ab974c10610ed7a4a39719f", "729df2c467677a46c6a31c951769a794", "e1035d5868ef6b8f513600a1121f1d54",
				"adb44054df0fb4ada9bb5f3851e9e2cb", "d77154ee1f5487b1af5acbd3b61ee0d5", "2ba574e3e1254eae03502431c4f18a32",
				"181ce356a22372be71c4461797cee1bc", "c9f2e6885810a7fc727dbf5fea8857df", "abc7e8035496b33b77b149959e280fb3",
				"606d489735edfc8ea0db0916358e6f5b"
			]
			assert (try frameHashes(try altrefStream())).equals(want)
		}

		@test()
		def decodes_bilinear_version_bit_exact() !none {
			let want = string[
				"a06690f2f7077b4410033c16d32e789c", "924c2fdca6dc9d0dbdb0e1c06f441c0c", "a739457b2891d38377732ef8130e8735",
				"ce08c0874d69ec950966bca370d44f02", "71f8b78f160344c707ff11cbc5175a23", "faa0ada2e757aae49673024d44e52e9f"
			]
			assert (try frameHashes(try bilinearStream())).equals(want)
		}

		@test()
		def decodes_segments_bit_exact() !none {
			let want = string[
				"3c98ad11dc213f864cc755d363a9d0dc", "9f141efda2eb719727fa34d9a82e8dd3", "31595a8b8b8edd064ec5d867ae94daa9",
				"3e28657c7a87234708d3c7a4c7e7f859", "e0da8fe0e02772100687c6e70a20c286", "97a5ec1fd9bcdf8eaacb6c8383c2a077",
				"056a557638b33646d59f0d011e78a52e", "cef1cdb32f2db3bf2f7d6d5ce737618b", "b391aa290dc8045558f06016c2f7e478",
				"23ca7f8e54d530650f87b334252c6da1"
			]
			assert (try frameHashes(try segmentedStream())).equals(want)
		}

		@test()
		def fills_frame_fields() !none {
			let codec = new VP8()
			try codec.configure(Track{index: 0, kind: TrackKind.Video, codec: "vp8"})
			let frames = VideoFrame[]
			for let (_, packet) in packets(try altrefStream()) {
				frames = frames + try codec.decode(packet)
			}
			assert frames.len() == 16
			let first = frames[0]
			assert first.width == uint32(40) && first.height == uint32(24)
			assert first.yStride == 40 && first.uvStride == 20
			assert first.y.len() == 40 * 24 && first.u.len() == 20 * 12 && first.v.len() == 20 * 12
			assert first.keyframe && !frames[1].keyframe
			assert first.matrix == 601
			assert first.time == 0s && frames[1].time == 200ms && frames[15].time == 1600ms
			assert codec.horizontalScale == 0 && codec.verticalScale == 0
			assert (try codec.flush()).len() == 0
		}

		@test()
		def reports_scaling_bits() !none {
			let key = packets(try bilinearStream())[0]
			key.data[7] = byte(int(key.data[7]) | 0x40)
			key.data[9] = byte(int(key.data[9]) | 0xc0)
			let codec = new VP8()
			let frames = try codec.decode(key)
			assert codec.horizontalScale == 1 && codec.verticalScale == 3
			assert frames[0].width == uint32(24) && frames[0].height == uint32(20)
		}

		@test()
		def skips_empty_packets() !none {
			let codec = new VP8()
			assert (try codec.decode(Packet{track: 0, data: [], pts: 0s, dts: 0s, length: 0s, keyframe: false})).len() == 0
		}

		@test()
		def rejects_a_stream_without_a_key_frame() !none {
			let list = packets(try bilinearStream())
			let failed = false
			new VP8().decode(list[1]) onerror (err error) {
				failed = true
				recover []
			}
			assert failed
		}

		@test()
		def rejects_truncated_frames() !none {
			let key = packets(try segmentedStream())[0]
			for let n = 1; n < key.data.len(); n += 7 {
				let cut = key
				cut.data = key.data[0:n].clone()
				let failed = false
				new VP8().decode(cut) onerror (err error) {
					failed = true
					recover []
				}
				assert failed
			}
		}

		// Damaged frames either decode to something or fail; they never read
		// out of bounds.
		@test()
		def survives_damaged_frames() !none {
			let list = packets(try altrefStream())
			for let i = 0; i < 400; i++ {
				let codec = new VP8()
				for let (k, packet) in list {
					let bad = packet
					bad.data = packet.data.clone()
					let at = (i * 37 + k * 11) % bad.data.len()
					bad.data[at] = byte(int(bad.data[at]) ^ (1 << (i & 7)))
					codec.decode(bad) onerror recover []
				}
			}
		}
	}
}
