partial module std.formats.video {
	use std.formats.video.vp9::*

	// VP9 decodes VP9 video in software: profiles 0 to 3, 8, 10 and 12
	// bits in 4:2:0, 4:2:2, 4:4:0 and 4:4:4, with scaled references, tiles,
	// segmentation and lossless frames. Frames the stream marks as not
	// shown (alternate references) produce no picture.
	//
	// A packet carries one frame or a superframe; the pictures it shows
	// come out timed by it. 4:4:0 pictures come out as 4:4:4 with each
	// chroma row repeated.
	@decoder("vp9")
	type VP9 {
		internal core Vp9Decoder

		def new() {
			core = new Vp9Decoder()
		}

		// configure implements VideoDecoder: starts a new stream; the key
		// frames carry everything VP9 needs. Fails never.
		def configure(track Track) !none {
			core = new Vp9Decoder()
			return none
		}

		// decode implements VideoDecoder: decodes the frames in `packet`
		// and returns the ones it shows. Fails on a damaged or unsupported
		// stream, and on an inter frame before the first key frame.
		def decode(packet Packet) !VideoFrame[] {
			try core.packet(packet.data, packet.pts, true, packet.length)
			return core.take()
		}

		// flush implements VideoDecoder: VP9 holds no frames back, so this
		// returns nothing. Fails never.
		def flush() !VideoFrame[] {
			return core.take()
		}
	}
}
