internal partial module std.formats.video.vp9 {
	// Reading past the end of a partition adds this many zero bits.
	const vp9LotsOfBits = 0x40000000

	// The boolean decoder of a VP9 partition (the compressed header or a
	// tile): each bit comes with the probability, in 1/256, that it is 0.
	// The window holds 56 bits, the next byte in bits 48-55; bytes past the
	// end read as zeros. The split is VP8's; `vp8.Vp8BoolDecoder` stops
	// at the end of its data and flags it instead of reading zeros.
	type Vp9Bool {
		data  byte[]
		pos   int
		end   int
		value int
		// Bits in the window beyond the eight a decision needs.
		count int
		range int

		def new() {
			data = byte[]
		}

		// Starts decoding data[start:stop]. False when the partition is
		// empty or its marker bit is set.
		def start(src byte[], startAt int, stop int) bool {
			data = src
			pos = startAt
			end = stop
			value = 0
			count = -8
			range = 255
			return false when stop <= startAt
			fill()
			return bit(128) == 0
		}

		def fill() {
			let shift = 48 - (count + 8)
			for shift >= 0 {
				if pos >= end {
					count += vp9LotsOfBits
					break
				}
				count += 8
				value = value | (int(data[pos]) << shift)
				pos++
				shift -= 8
			}
		}

		// One bit that is 0 with probability `prob` / 256.
		def bit(prob int) int {
			fill() when count < 0
			let split = (range * prob + (256 - prob)) >> 8
			let big = split << 48
			let r = split
			let b = 0
			if value >= big {
				r = range - split
				value -= big
				b = 1
			}
			let s = vp9Norm[r]
			range = r << s
			value = value << s
			count -= s
			return b
		}

		// An `n`-bit unsigned value, most significant bit first.
		def literal(n int) int {
			let v = 0
			for let i = 0; i < n; i++ {
				v = (v << 1) | bit(128)
			}
			return v
		}

		// Whether the decoder read past the end of its partition.
		def overrun() bool {
			return count > 56 && count < vp9LotsOfBits
		}
	}
}
