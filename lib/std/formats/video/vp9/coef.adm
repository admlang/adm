internal partial module std.formats.video.vp9 {
	// Probabilities of the extra bits of the token categories; the sixth
	// has 14 bits at 8 bits per sample, 16 at 10 and 18 at 12, the last
	// bits shared.
	const vp9Cat1Prob = int[159]
	const vp9Cat2Prob = int[165, 145]
	const vp9Cat3Prob = int[173, 148, 140]
	const vp9Cat4Prob = int[176, 155, 140, 135]
	const vp9Cat5Prob = int[180, 157, 141, 134, 130]
	const vp9Cat6Prob = int[255, 255, 255, 255, 254, 254, 254, 252, 249, 243, 230, 196, 177, 153, 140, 133, 130, 129]

	def vp9ReadExtra(r Vp9Bool, probs int[], from int, n int) int {
		let v = 0
		for let i = 0; i < n; i++ {
			v = (v << 1) | r.bit(probs[from + i])
		}
		return v
	}

	// Decodes the coefficients of one transform block into `coef`,
	// dequantized, in the order `scan` with its neighbour table `nb` and
	// the band of each position in `bands`; with `transpose` each lands at
	// its mirrored position. `inter` is 1 for an inter block, `bd` the bit
	// depth. Returns the number of positions coded (0 for an empty block).
	// The arrays come as arguments: the function runs once per transform
	// block, and locals holding the tile's arrays would each be counted
	// in and out.
	def vp9DecodeCoefs(r Vp9Bool, fc int[], cnt int[], coef int32[], cache byte[], scan int[], nb int[], bands int[], inter int, bd int, planeType int, tx int, ctx0 int, dq0 int, dq1 int, transpose bool) int {
		let maxEob = 16 << (tx << 1)
		let probs = vp9PCoef + tx * 432 + (planeType * 2 + inter) * 108
		let counts = vp9CCoef + tx * 576 + (planeType * 2 + inter) * 144
		let eobCounts = vp9CEob + tx * 144 + (planeType * 2 + inter) * 36
		let dqShift = tx == 3 ?? (1, 0)
		let cat6Bits = bd + 6
		let cat6From = 18 - cat6Bits
		let log2n = tx + 2
		let mask = (1 << log2n) - 1
		let ctx = ctx0
		let dqv = dq0
		let c = 0
		for c < maxEob {
			let band = bands[c]
			let p = probs + band * 18 + ctx * 3
			cnt[eobCounts + band * 6 + ctx]++
			if r.bit(fc[p]) == 0 {
				cnt[counts + (band * 6 + ctx) * 4 + 3]++
				break
			}
			for r.bit(fc[p + 1]) == 0 {
				cnt[counts + (band * 6 + ctx) * 4]++
				dqv = dq1
				cache[scan[c]] = byte(0)
				c++
				return c when c >= maxEob
				ctx = (1 + int(cache[nb[2 * c]]) + int(cache[nb[2 * c + 1]])) >> 1
				band = bands[c]
				p = probs + band * 18 + ctx * 3
			}
			let v = 0
			let pos = scan[c]
			if r.bit(fc[p + 2]) != 0 {
				cnt[counts + (band * 6 + ctx) * 4 + 2]++
				let pp = (fc[p + 2] - 1) * 8
				let val = 0
				if r.bit(vp9Pareto8[pp]) != 0 {
					if r.bit(vp9Pareto8[pp + 3]) != 0 {
						cache[pos] = byte(5)
						if r.bit(vp9Pareto8[pp + 5]) != 0 {
							if r.bit(vp9Pareto8[pp + 7]) != 0 {
								val = 67 + vp9ReadExtra(r, vp9Cat6Prob, cat6From, cat6Bits)
							} else {
								val = 35 + vp9ReadExtra(r, vp9Cat5Prob, 0, 5)
							}
						} else if r.bit(vp9Pareto8[pp + 6]) != 0 {
							val = 19 + vp9ReadExtra(r, vp9Cat4Prob, 0, 4)
						} else {
							val = 11 + vp9ReadExtra(r, vp9Cat3Prob, 0, 3)
						}
					} else {
						cache[pos] = byte(4)
						if r.bit(vp9Pareto8[pp + 4]) != 0 {
							val = 7 + vp9ReadExtra(r, vp9Cat2Prob, 0, 2)
						} else {
							val = 5 + r.bit(159)
						}
					}
				} else if r.bit(vp9Pareto8[pp + 1]) != 0 {
					cache[pos] = byte(3)
					val = 3 + r.bit(vp9Pareto8[pp + 2])
				} else {
					cache[pos] = byte(2)
					val = 2
				}
				v = (val * dqv) >> dqShift
			} else {
				cnt[counts + (band * 6 + ctx) * 4 + 1]++
				cache[pos] = byte(1)
				v = dqv >> dqShift
			}
			v = 0 - v when r.bit(128) != 0
			pos = ((pos & mask) << log2n) | (pos >> log2n) when transpose
			coef[pos] = int32(v)
			c++
			ctx = (1 + int(cache[nb[2 * c]]) + int(cache[nb[2 * c + 1]])) >> 1
			dqv = dq1
		}
		return c
	}

	// Decodes the residual of the transform block at 4x4 position (x, y)
	// of the block in progress in `plane`, with the context of the blocks
	// above and to the left. `maxW` and `maxH` are the 4x4 blocks of the
	// plane's block inside the frame, 0 when all of it is. Returns the
	// number of positions coded.
	def vp9BlockTokens(t Vp9Tile, plane int, x int, y int, tx int, txType int, maxW int, maxH int, transpose bool) int {
		let ssx = plane == 0 ?? (0, t.h.ssx)
		let ssy = plane == 0 ?? (0, t.h.ssy)
		let a = t.aboveNzAt[plane] + ((t.miCol * 2) >> ssx) + x
		let l = plane * 16 + (((t.miRow & 7) * 2) >> ssy) + y
		let n = 1 << tx
		let above = t.aboveNz
		let left = t.leftNz
		let ctx = 0
		for let i = 0; i < n; i++ {
			if above[a + i] != 0 {
				ctx = 1
				break
			}
		}
		for let i = 0; i < n; i++ {
			if left[l + i] != 0 {
				ctx++
				break
			}
		}
		let dq0 = plane == 0 ?? (t.yDq[t.seg * 2], t.uvDq[t.seg * 2])
		let dq1 = plane == 0 ?? (t.yDq[t.seg * 2 + 1], t.uvDq[t.seg * 2 + 1])
		let inter = t.ref0 > 0 ?? (1, 0)
		let bd = t.h.bitDepth
		let pt = plane == 0 ?? (0, 1)
		let eob = 0
		// The scan by transform size and type: rows first for an ADST on
		// columns (type 1), columns first for one on rows (type 2).
		if tx == 0 {
			if txType == 1 {
				eob = vp9DecodeCoefs(t.r, t.fc, t.cnt, t.coef, t.tokenCache, vp9ScanRow4, vp9ScanRow4Nb, vp9Band4, inter, bd, pt, tx, ctx, dq0, dq1, transpose)
			} else if txType == 2 {
				eob = vp9DecodeCoefs(t.r, t.fc, t.cnt, t.coef, t.tokenCache, vp9ScanCol4, vp9ScanCol4Nb, vp9Band4, inter, bd, pt, tx, ctx, dq0, dq1, transpose)
			} else {
				eob = vp9DecodeCoefs(t.r, t.fc, t.cnt, t.coef, t.tokenCache, vp9ScanDefault4, vp9ScanDefault4Nb, vp9Band4, inter, bd, pt, tx, ctx, dq0, dq1, transpose)
			}
		} else if tx == 1 {
			if txType == 1 {
				eob = vp9DecodeCoefs(t.r, t.fc, t.cnt, t.coef, t.tokenCache, vp9ScanRow8, vp9ScanRow8Nb, vp9Band8Plus, inter, bd, pt, tx, ctx, dq0, dq1, transpose)
			} else if txType == 2 {
				eob = vp9DecodeCoefs(t.r, t.fc, t.cnt, t.coef, t.tokenCache, vp9ScanCol8, vp9ScanCol8Nb, vp9Band8Plus, inter, bd, pt, tx, ctx, dq0, dq1, transpose)
			} else {
				eob = vp9DecodeCoefs(t.r, t.fc, t.cnt, t.coef, t.tokenCache, vp9ScanDefault8, vp9ScanDefault8Nb, vp9Band8Plus, inter, bd, pt, tx, ctx, dq0, dq1, transpose)
			}
		} else if tx == 2 {
			if txType == 1 {
				eob = vp9DecodeCoefs(t.r, t.fc, t.cnt, t.coef, t.tokenCache, vp9ScanRow16, vp9ScanRow16Nb, vp9Band8Plus, inter, bd, pt, tx, ctx, dq0, dq1, transpose)
			} else if txType == 2 {
				eob = vp9DecodeCoefs(t.r, t.fc, t.cnt, t.coef, t.tokenCache, vp9ScanCol16, vp9ScanCol16Nb, vp9Band8Plus, inter, bd, pt, tx, ctx, dq0, dq1, transpose)
			} else {
				eob = vp9DecodeCoefs(t.r, t.fc, t.cnt, t.coef, t.tokenCache, vp9ScanDefault16, vp9ScanDefault16Nb, vp9Band8Plus, inter, bd, pt, tx, ctx, dq0, dq1, transpose)
			}
		} else {
			eob = vp9DecodeCoefs(t.r, t.fc, t.cnt, t.coef, t.tokenCache, vp9ScanDefault32, vp9ScanDefault32Nb, vp9Band8Plus, inter, bd, pt, tx, ctx, dq0, dq1, transpose)
		}
		let flag = byte(eob > 0 ?? (1, 0))
		let inW = (maxW != 0 && x + n > maxW) ?? (maxW - x, n)
		let inH = (maxH != 0 && y + n > maxH) ?? (maxH - y, n)
		for let i = 0; i < n; i++ {
			above[a + i] = i < inW ?? (flag, byte(0))
			left[l + i] = i < inH ?? (flag, byte(0))
		}
		return eob
	}
}
