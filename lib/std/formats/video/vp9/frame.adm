internal partial module std.formats.video.vp9 {
	use (
		std.formats.video::*
		std.formats.video.av1::(av1Bytes, av1Put)
	)

	// The decoding state of a VP9 stream: the header state, the eight
	// reference slots, the four probability contexts and the per-frame
	// arrays the tiles share.
	type Vp9Decoder {
		h          Vp9Header
		slots      Vp9Frame[]
		slotW      int[]
		slotH      int[]
		slotDepth  int[]
		slotSs     int[]
		ctxs       int[][]
		fc         int[]
		counts     int[]
		boolDec    Vp9Bool
		tiles      Vp9Tile[]
		lf         Vp9Lf
		// The frame decoded last: its vectors predict the next frame's.
		prev       Vp9Frame
		lastShow   bool
		lastWidth  int
		lastHeight int
		miCols     int
		miRows     int
		miSize     byte[]
		miMode     byte[]
		miSkip     byte[]
		miTx       byte[]
		miSeg      byte[]
		miSegPred  byte[]
		miRef0     int8[]
		miRef1     int8[]
		miFilter   byte[]
		miLevel    byte[]
		miBMode    byte[]
		miMv       int32[]
		segCur     byte[]
		segLast    byte[]
		abovePart  byte[]
		aboveNz    byte[]
		yDq        int[]
		uvDq       int[]
		lfLevels   int[]
		frames     VideoFrame[]
		// The frame the packet in progress shows last.
		shown      Vp9Frame
		haveShown  bool
		// A frame failed: frames that predict from others are refused
		// until a key or intra-only frame starts over.
		needKey    bool
		// Frames nothing holds any more, for the next frames of their size.
		pool       Vp9Frame[]
		lastTime   duration
		haveTime   bool

		def new() {
			h = new Vp9Header()
			boolDec = new Vp9Bool()
			lf = new Vp9Lf()
			prev = new Vp9Frame()
			shown = new Vp9Frame()
			slots = Vp9Frame[]
			for let i = 0; i < 8; i++ {
				slots.push(new Vp9Frame())
			}
			slotW.len(8)
			slotH.len(8)
			slotDepth.len(8)
			slotSs.len(8)
			let all int[][]
			for let i = 0; i < 4; i++ {
				let c int[]
				c.len(vp9ProbSize)
				vp9DefaultProbs(c)
				all.push(c)
			}
			ctxs = all
			fc.len(vp9ProbSize)
			counts.len(vp9CountSize)
			tiles = Vp9Tile[]
			yDq.len(16)
			uvDq.len(16)
			lfLevels.len(64)
			frames = VideoFrame[]
			pool = Vp9Frame[]
		}

		def take() VideoFrame[] {
			let out = frames
			frames = VideoFrame[]
			return out
		}

		// Decodes the frames of one packet, timed `pts`: one frame, or a
		// superframe of several with an index at its end. A packet gives
		// at most one picture, the last frame it shows: of the spatial
		// layers of a superframe that is the highest.
		//
		// Fails on a damaged or unsupported frame, and after one on every
		// frame that predicts from others until a key or intra-only frame.
		def packet(data byte[], pts duration, hasPts bool, length duration) !none {
			haveShown = false
			let failure ?error = none
			unpack(data) onerror (err error) {
				failure = err
				recover none
			}
			emit(shown, pts, hasPts, length) when haveShown && failure is none
			if haveShown {
				drop(shown)
				haveShown = false
			}
			return none when failure is none
			needKey = true
			fail failure.message
		}

		internal def unpack(data byte[]) !none {
			let n = data.len()
			return none when n == 0
			let marker = int(data[n - 1])
			if (marker & 0xE0) == 0xC0 {
				let count = (marker & 7) + 1
				let mag = ((marker >> 3) & 3) + 1
				let indexSize = 2 + mag * count
				if n >= indexSize && int(data[n - indexSize]) == marker {
					let at = 0
					let sizes = n - indexSize + 1
					for let i = 0; i < count; i++ {
						let size = 0
						for let k = 0; k < mag; k++ {
							size = size | (int(data[sizes + i * mag + k]) << (8 * k))
						}
						fail "vp9: bad superframe index" when at + size > n - indexSize
						try frame(data, at, at + size) when size > 0
						at += size
					}
					return none
				}
			}
			// Frames may follow one another, zero bytes between them.
			let at = 0
			for at < n {
				let used = try frame(data, at, n)
				at += used
				for at < n && data[at] == 0 {
					at++
				}
			}
			return none
		}

		// Decodes the frame at data[start:end]; returns the bytes it took.
		def frame(data byte[], start int, end int) !int {
			try h.parse(data, start, end, slotW, slotH, slotDepth, slotSs)
			if h.showExisting {
				show(slots[h.showIdx])
				return h.profile == 3 ?? (2, 1)
			}
			if needKey {
				fail "vp9: waiting for a key frame after a damaged frame" unless h.intra()
				if !h.keyFrame {
					// An intra-only frame starts over with nothing to
					// predict from but itself.
					for let i = 0; i < 8; i++ {
						drop(slots[i])
						slots[i] = new Vp9Frame()
						slotW[i] = 0
					}
				}
				needKey = false
			}
			let first = start + h.headerBytes
			fail "vp9: truncated frame" when first + h.compressedLen > end
			let cur = frameFor(h.width, h.height, h.bitDepth, h.ssx, h.ssy)
			cur.renderWidth = h.renderWidth
			cur.renderHeight = h.renderHeight
			cur.colorSpace = h.colorSpace
			cur.fullRange = h.fullRange
			cur.keyFrame = h.keyFrame
			resize(cur.miCols, cur.miRows)
			if h.intra() || h.errorRes {
				segCur.fill(byte(0))
				segLast.fill(byte(0))
				vp9DefaultProbs(fc)
				if h.keyFrame || h.errorRes || h.resetCtx == 3 {
					for let i = 0; i < 4; i++ {
						vp9Copy(ctxs[i], 0, fc, vp9ProbSize)
					}
				} else if h.resetCtx == 2 {
					vp9Copy(ctxs[h.ctxIdx], 0, fc, vp9ProbSize)
				}
				h.ctxIdx = 0
			}
			let pre = ctxs[h.ctxIdx]
			vp9Copy(fc, 0, pre, vp9ProbSize)
			try vp9CompressedHeader(h, boolDec, fc, data, first, first + h.compressedLen)
			let usePrev = !h.errorRes && h.width == lastWidth && h.height == lastHeight && !h.lastIntraOnly && lastShow && !h.lastKeyFrame && prev.valid
			setupQuant()
			if h.lfLevel != 0 {
				lf.sharpness(h.lfSharpness)
				vp9LfLevels(h, lfLevels)
			} else {
				lfLevels.fill(0)
			}
			let used = try decodeTiles(data, first + h.compressedLen, end, cur, usePrev)
			if h.lfLevel != 0 {
				lf.cur = cur
				lf.ssx = h.ssx
				lf.ssy = h.ssy
				lf.bitDepth = h.bitDepth
				lf.miCols = miCols
				lf.miRows = miRows
				lf.miSize = miSize
				lf.miSkip = miSkip
				lf.miTx = miTx
				lf.miRef0 = miRef0
				lf.miLevel = miLevel
				vp9LoopFilter(lf)
			}
			if !h.errorRes && !h.parallelMode {
				counts.fill(0)
				let tileCols = 1 << h.tileColsLog2
				for let i = 0; i < tileCols; i++ {
					let c = tiles[i].cnt
					for let k = 0; k < vp9CountSize; k++ {
						counts[k] += c[k]
					}
				}
				vp9AdaptCoef(pre, fc, counts, (!h.intra() && h.lastKeyFrame) ?? (128, 112))
				vp9AdaptModes(h, pre, fc, counts) unless h.intra()
			}
			vp9Copy(ctxs[h.ctxIdx], 0, fc, vp9ProbSize) when h.refreshCtx
			// Nothing may fail from here on: a frame that failed has
			// refreshed no slot, so a slot shown later is never damaged.
			for let i = 0; i < 8; i++ {
				continue when ((h.refreshFlags >> i) & 1) == 0
				drop(slots[i])
				slots[i] = cur
				cur.uses++
				slotW[i] = cur.width
				slotH[i] = cur.height
				slotDepth[i] = cur.bitDepth
				slotSs[i] = cur.ssx * 2 + cur.ssy
			}
			lastShow = h.showFrame
			drop(prev)
			prev = cur
			cur.uses++
			lastWidth = h.width
			lastHeight = h.height
			if h.segEnabled {
				let m = segCur
				segCur = segLast
				segLast = m
			}
			show(cur) when h.showFrame
			return used - start
		}

		// Makes `f` the picture the packet in progress shows.
		internal def show(f Vp9Frame) {
			drop(shown) when haveShown
			shown = f
			f.uses++
			haveShown = true
		}

		// Lets go of one hold on `f`; a frame nothing holds goes to the
		// pool.
		internal def drop(f Vp9Frame) {
			return unless f.valid
			f.uses--
			return when f.uses > 0
			pool.shift() when pool.len() >= 12
			pool.push(f)
		}

		// A frame of the given size: one from the pool when it holds one
		// (its samples are all written again by decoding), else a new one.
		internal def frameFor(w int, ht int, depth int, ssx int, ssy int) Vp9Frame {
			for let i = 0; i < pool.len(); i++ {
				let f = pool[i]
				continue unless f.width == w && f.height == ht && f.bitDepth == depth && f.ssx == ssx && f.ssy == ssy
				pool.remove(i)
				return f
			}
			let f = new Vp9Frame()
			f.alloc(w, ht, depth, ssx, ssy)
			return f
		}

		// Sizes the per-frame arrays for a frame of cols x rows 8x8 blocks.
		internal def resize(cols int, rows int) {
			return when cols == miCols && rows == miRows
			miCols = cols
			miRows = rows
			let n = cols * rows
			miSize.len(n)
			miMode.len(n)
			miSkip.len(n)
			miTx.len(n)
			miSeg.len(n)
			miSegPred.len(n)
			miRef0.len(n)
			miRef1.len(n)
			miFilter.len(n)
			miLevel.len(n)
			miBMode.len(n * 4)
			miMv.len(n * 8)
			segCur.len(n)
			segLast.len(n)
			segCur.fill(byte(0))
			segLast.fill(byte(0))
			let aligned = (cols + 7) & ~7
			abovePart.len(aligned + 8)
			aboveNz.len(3 * (aligned * 2 + 16))
		}

		// The quantizer steps of every segment.
		internal def setupQuant() {
			let dc = h.bitDepth == 8 ?? (vp9DcQ8, h.bitDepth == 10 ?? (vp9DcQ10, vp9DcQ12))
			let ac = h.bitDepth == 8 ?? (vp9AcQ8, h.bitDepth == 10 ?? (vp9AcQ10, vp9AcQ12))
			for let s = 0; s < 8; s++ {
				let q = h.qIndex(s)
				yDq[s * 2] = dc[vp9Clamp(q + h.yDcDelta, 0, 255)]
				yDq[s * 2 + 1] = ac[q]
				uvDq[s * 2] = dc[vp9Clamp(q + h.uvDcDelta, 0, 255)]
				uvDq[s * 2 + 1] = ac[vp9Clamp(q + h.uvAcDelta, 0, 255)]
			}
		}

		// Decodes the tiles at data[start:end] into `cur`: the tile rows one
		// after another, the columns of a row on tasks. Returns where the
		// frame's data ends.
		internal def decodeTiles(data byte[], start int, end int, cur Vp9Frame, usePrev bool) !int {
			let tileCols = 1 << h.tileColsLog2
			let tileRows = 1 << h.tileRowsLog2
			for tiles.len() < tileCols {
				tiles.push(new Vp9Tile())
			}
			let aligned = (miCols + 7) & ~7
			abovePart.fill(byte(0))
			aboveNz.fill(byte(0))
			let refs = Vp9Frame[]
			if !h.intra() {
				for let i = 0; i < 3; i++ {
					refs.push(slots[h.refIdx[i]])
				}
			}
			for let i = 0; i < tileCols; i++ {
				let t = tiles[i]
				t.h = h
				t.fc = fc
				t.cnt.fill(0)
				t.cur = cur
				t.refs = refs
				for let k = 0; k < refs.len(); k++ {
					let r = refs[k]
					let usable = 2 * h.width >= r.width && 2 * h.height >= r.height && h.width <= 16 * r.width && h.height <= 16 * r.height
					t.scaleX[k] = usable ?? ((r.width << 14) / h.width, 0)
					t.scaleY[k] = usable ?? ((r.height << 14) / h.height, 0)
				}
				t.miCols = miCols
				t.miRows = miRows
				t.miSize = miSize
				t.miMode = miMode
				t.miSkip = miSkip
				t.miTx = miTx
				t.miSeg = miSeg
				t.miSegPred = miSegPred
				t.miRef0 = miRef0
				t.miRef1 = miRef1
				t.miFilter = miFilter
				t.miLevel = miLevel
				t.miBMode = miBMode
				t.miMv = miMv
				t.usePrev = usePrev
				t.prevRef = prev.mvRef
				t.prevMv = prev.mvs
				t.segCur = segCur
				t.segLast = segLast
				t.abovePart = abovePart
				t.aboveNz = aboveNz
				t.aboveNzAt[0] = 0
				t.aboveNzAt[1] = aligned * 2 + 16
				t.aboveNzAt[2] = 2 * (aligned * 2 + 16)
				t.yDq = yDq
				t.uvDq = uvDq
				t.lfLevels = lfLevels
				t.bad = false
				let sbCols = (miCols + 7) >> 3
				t.colStart = vp9Min(((i * sbCols) >> h.tileColsLog2) << 3, miCols)
				t.colEnd = vp9Min((((i + 1) * sbCols) >> h.tileColsLog2) << 3, miCols)
			}
			let at = start
			let sbRows = (miRows + 7) >> 3
			for let row = 0; row < tileRows; row++ {
				let rowStart = vp9Min(((row * sbRows) >> h.tileRowsLog2) << 3, miRows)
				let rowEnd = vp9Min((((row + 1) * sbRows) >> h.tileRowsLog2) << 3, miRows)
				for let i = 0; i < tileCols; i++ {
					let size = end - at
					if row != tileRows - 1 || i != tileCols - 1 {
						fail "vp9: truncated tile size" when at + 4 > end
						size = (int(data[at]) << 24) | (int(data[at + 1]) << 16) | (int(data[at + 2]) << 8) | int(data[at + 3])
						at += 4
						fail "vp9: truncated tile" when size > end - at
					}
					let t = tiles[i]
					t.rowStart = rowStart
					t.rowEnd = rowEnd
					fail "vp9: bad tile" unless t.r.start(data, at, at + size)
					at += size
				}
				if tileCols == 1 {
					vp9DecodeTile(tiles[0])
				} else {
					let done = new channel<bool>(size = tileCols)
					for let i = 0; i < tileCols; i++ {
						async vp9TileTask(tiles[i], done)
					}
					for let i = 0; i < tileCols; i++ {
						<-done
					}
				}
				for let i = 0; i < tileCols; i++ {
					fail "vp9: damaged tile data" when tiles[i].bad
				}
			}
			return at
		}

		// Queues `f` as an output frame.
		internal def emit(f Vp9Frame, pts duration, hasPts bool, length duration) {
			let w = f.width
			let ht = f.height
			let cw = (w + f.ssx) >> f.ssx
			let ch = (ht + f.ssy) >> f.ssy
			let size = f.bitDepth == 8 ?? (1, 2)
			let y = av1Bytes(w * ht * size)
			av1Put(f.y, 0, f.stride, w, ht, size, y)
			let u = av1Bytes(cw * ch * size)
			let v = av1Bytes(cw * ch * size)
			av1Put(f.u, 0, f.cstride, cw, ch, size, u)
			av1Put(f.v, 0, f.cstride, cw, ch, size, v)
			let layout = ChromaLayout.Yuv420
			if f.ssx == 0 && f.ssy == 0 {
				layout = ChromaLayout.Yuv444
			} else if f.ssy == 0 {
				layout = ChromaLayout.Yuv422
			} else if f.ssx == 0 {
				// Full width and half height has no layout of its own:
				// each chroma row is repeated to make 4:4:4.
				layout = ChromaLayout.Yuv444
				u = vp9DoubleRows(u, cw * size, ht)
				v = vp9DoubleRows(v, cw * size, ht)
			}
			let step = length > 0s ?? (length, 40ms)
			let time = pts
			time = haveTime ?? (lastTime + step, 0s) unless hasPts
			lastTime = time
			haveTime = true
			frames.push(VideoFrame{
				width:     uint32(w),
				height:    uint32(ht),
				y:         y,
				u:         u,
				v:         v,
				yStride:   w * size,
				uvStride:  cw * size,
				time:      time,
				length:    step,
				keyframe:  f.keyFrame,
				matrix:    (f.colorSpace := 1 || 3) ?? (601, 709),
				chroma:    layout,
				fullRange: f.fullRange,
				bitDepth:  f.bitDepth,
				onGpu:     false,
				gpu:       none
			})
		}
	}

	// A plane of rows of `rowBytes` bytes with each row repeated, `outRows`
	// rows of it.
	def vp9DoubleRows(src byte[], rowBytes int, outRows int) byte[] {
		let out = av1Bytes(rowBytes * outRows)
		for let r = 0; r < outRows; r++ {
			let from = (r >> 1) * rowBytes
			for let i = 0; i < rowBytes; i++ {
				out[r * rowBytes + i] = src[from + i]
			}
		}
		return out
	}
}
