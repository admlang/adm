internal partial module std.formats.video.vp9 {
	use std.formats.video.mpegvideo::(MpegBits)

	const (
		vp9TxModeSelect     = 4
		vp9FilterSwitchable = 4
		vp9RefSingle        = 0
		vp9RefCompound      = 1
		vp9RefSelect        = 2
		// Segment features.
		vp9SegAltQ          = 0
		vp9SegAltLf         = 1
		vp9SegRef           = 2
		vp9SegSkip          = 3
	)

	// The interpolation filter a two-bit header code stands for: smooth,
	// regular, sharp, bilinear, as indices of the kernel tables.
	const vp9LiteralToFilter = int[1, 0, 2, 3]

	// The frame header and the state it carries from frame to frame
	// (segmentation features, loop filter deltas), as libvpx's VP9_COMMON
	// keeps them.
	type Vp9Header {
		profile       int
		showExisting  bool
		showIdx       int
		keyFrame      bool
		lastKeyFrame  bool
		showFrame     bool
		errorRes      bool
		intraOnly     bool
		lastIntraOnly bool
		resetCtx      int
		bitDepth      int
		colorSpace    int
		fullRange     bool
		ssx           int
		ssy           int
		refreshFlags  int
		// The slots of LAST, GOLDEN and ALTREF.
		refIdx        int[]
		// Per reference frame 0-3 (0 intra).
		signBias      int[]
		width         int
		height        int
		renderWidth   int
		renderHeight  int
		allowHp       bool
		interpFilter  int
		refreshCtx    bool
		parallelMode  bool
		ctxIdx        int
		lfLevel       int
		lfSharpness   int
		lfDeltas      bool
		lfRefDeltas   int[]
		lfModeDeltas  int[]
		baseQ         int
		yDcDelta      int
		uvDcDelta     int
		uvAcDelta     int
		lossless      bool
		segEnabled    bool
		segUpdateMap  bool
		segTreeProbs  int[]
		segTemporal   bool
		segPredProbs  int[]
		segAbsDelta   bool
		// Per segment a bit per enabled feature, and the feature values.
		segMask       int[]
		segData       int[]
		tileColsLog2  int
		tileRowsLog2  int
		// Bytes of the uncompressed and the compressed header.
		headerBytes   int
		compressedLen int
		txMode        int
		refMode       int
		compFixed     int
		compVar       int[]

		def new() {
			refIdx.len(3)
			signBias.len(4)
			lfRefDeltas.len(4)
			lfModeDeltas.len(2)
			segTreeProbs.len(7)
			segPredProbs.len(3)
			segMask.len(8)
			segData.len(32)
			compVar.len(2)
			bitDepth = 8
			ssx = 1
			ssy = 1
		}

		// Whether the frame codes no inter blocks.
		def intra() bool {
			return keyFrame || intraOnly
		}

		def miCols() int {
			return (width + 7) >> 3
		}

		def miRows() int {
			return (height + 7) >> 3
		}

		def segActive(segment int, feature int) bool {
			return segEnabled && ((segMask[segment] >> feature) & 1) != 0
		}

		// The quantizer index of `segment`.
		def qIndex(segment int) int {
			return baseQ unless segActive(segment, vp9SegAltQ)
			let data = segData[segment * 4 + vp9SegAltQ]
			return vp9Clamp(segAbsDelta ?? (data, baseQ + data), 0, 255)
		}

		// Clears what a frame without references must not inherit:
		// segmentation features and loop filter deltas.
		def pastIndependence() {
			segMask.fill(0)
			segData.fill(0)
			segAbsDelta = false
			lfRefDeltas[0] = 1
			lfRefDeltas[1] = 0
			lfRefDeltas[2] = -1
			lfRefDeltas[3] = -1
			lfModeDeltas[0] = 0
			lfModeDeltas[1] = 0
			signBias.fill(0)
		}

		// The fixed and the two variable references of compound blocks.
		def setupCompound() {
			if signBias[1] == signBias[2] {
				compFixed = 3
				compVar[0] = 1
				compVar[1] = 2
			} else if signBias[1] == signBias[3] {
				compFixed = 2
				compVar[0] = 1
				compVar[1] = 3
			} else {
				compFixed = 1
				compVar[0] = 2
				compVar[1] = 3
			}
		}

		// Reads the uncompressed header from data[start:end]. `slotW`,
		// `slotH`, `slotDepth` and `slotSs` describe the eight reference
		// slots (width 0 for an empty one; `slotSs` is ssx * 2 + ssy).
		// Leaves `headerBytes` at 0 for a frame that shows an existing one.
		//
		// Fails on a damaged or unsupported header, on a picture of more than
		// 35651584 samples, and on references a frame cannot predict from.
		def parse(data byte[], start int, end int, slotW int[], slotH int[], slotDepth int[], slotSs int[]) !none {
			let b = new MpegBits()
			b.reset(data, start, end)
			lastKeyFrame = keyFrame
			lastIntraOnly = intraOnly
			headerBytes = 0
			fail "vp9: bad frame marker" when b.read(2) != 2
			profile = b.bit()
			profile = profile | (b.bit() << 1)
			profile += b.bit() when profile > 2
			fail "vp9: unsupported profile" when profile > 3
			showExisting = b.flag()
			if showExisting {
				showIdx = b.read(3)
				fail "vp9: shown frame was never decoded" when slotW[showIdx] == 0
				refreshFlags = 0
				lfLevel = 0
				showFrame = true
				return none
			}
			keyFrame = b.bit() == 0
			showFrame = b.flag()
			errorRes = b.flag()
			if keyFrame {
				try syncCode(b)
				try colorConfig(b)
				refreshFlags = 255
				frameSize(b)
				renderSize(b)
			} else {
				intraOnly = showFrame ?? (false, b.flag())
				resetCtx = errorRes ?? (0, b.read(2))
				if intraOnly {
					try syncCode(b)
					if profile > 0 {
						try colorConfig(b)
					} else {
						colorSpace = 1
						fullRange = false
						ssx = 1
						ssy = 1
						bitDepth = 8
					}
					refreshFlags = b.read(8)
					frameSize(b)
					renderSize(b)
				} else {
					refreshFlags = b.read(8)
					for let i = 0; i < 3; i++ {
						refIdx[i] = b.read(3)
						fail "vp9: reference to a frame that was never decoded" when slotW[refIdx[i]] == 0
						signBias[1 + i] = b.bit()
					}
					try sizeWithRefs(b, slotW, slotH, slotDepth, slotSs)
					allowHp = b.flag()
					interpFilter = b.flag() ?? (vp9FilterSwitchable, vp9LiteralToFilter[b.read(2)])
				}
			}
			// The samples of the largest picture a VP9 level allows (level
			// 6.2); libvpx's own streams have sides beyond that level's.
			fail "vp9: picture too large" when width * height > 35651584
			if errorRes {
				refreshCtx = false
				parallelMode = true
			} else {
				refreshCtx = b.flag()
				parallelMode = b.flag()
			}
			ctxIdx = b.read(2)
			pastIndependence() when intra() || errorRes
			lfLevel = b.read(6)
			lfSharpness = b.read(3)
			lfDeltas = b.flag()
			if lfDeltas && b.flag() {
				for let i = 0; i < 4; i++ {
					lfRefDeltas[i] = signedLiteral(b, 6) when b.flag()
				}
				for let i = 0; i < 2; i++ {
					lfModeDeltas[i] = signedLiteral(b, 6) when b.flag()
				}
			}
			baseQ = b.read(8)
			yDcDelta = deltaQ(b)
			uvDcDelta = deltaQ(b)
			uvAcDelta = deltaQ(b)
			lossless = baseQ == 0 && yDcDelta == 0 && uvDcDelta == 0 && uvAcDelta == 0
			segmentation(b)
			let sbCols = (miCols() + 7) >> 3
			let minLog2 = 0
			for (64 << minLog2) < sbCols {
				minLog2++
			}
			let maxLog2 = 1
			for (sbCols >> maxLog2) >= 4 {
				maxLog2++
			}
			maxLog2--
			tileColsLog2 = minLog2
			for tileColsLog2 < maxLog2 && b.flag() {
				tileColsLog2++
			}
			tileRowsLog2 = b.bit()
			tileRowsLog2 += b.bit() when tileRowsLog2 != 0
			compressedLen = b.read(16)
			fail "vp9: truncated frame header" when b.left() < 0
			fail "vp9: empty compressed header" when compressedLen == 0
			headerBytes = (b.pos + 7) / 8 - start
			return none
		}

		internal def syncCode(b MpegBits) !none {
			fail "vp9: bad sync code" when b.read(24) != 0x498342
			return none
		}

		internal def colorConfig(b MpegBits) !none {
			bitDepth = 8
			bitDepth = b.flag() ?? (12, 10) when profile >= 2
			colorSpace = b.read(3)
			if colorSpace != 7 {
				fullRange = b.flag()
				if profile := 1 || 3 {
					ssx = b.bit()
					ssy = b.bit()
					fail "vp9: 4:2:0 is not allowed in profiles 1 and 3" when ssx == 1 && ssy == 1
					fail "vp9: reserved bit set" when b.flag()
				} else {
					ssx = 1
					ssy = 1
				}
				return none
			}
			fullRange = true
			fail "vp9: RGB is not allowed in profiles 0 and 2" unless profile := 1 || 3
			ssx = 0
			ssy = 0
			fail "vp9: reserved bit set" when b.flag()
			return none
		}

		internal def frameSize(b MpegBits) {
			width = b.read(16) + 1
			height = b.read(16) + 1
		}

		internal def renderSize(b MpegBits) {
			renderWidth = width
			renderHeight = height
			if b.flag() {
				renderWidth = b.read(16) + 1
				renderHeight = b.read(16) + 1
			}
		}

		// The size of an inter frame: that of the first reference the
		// header points at, or one of its own.
		internal def sizeWithRefs(b MpegBits, slotW int[], slotH int[], slotDepth int[], slotSs int[]) !none {
			let found = false
			for let i = 0; i < 3; i++ {
				if b.flag() {
					width = slotW[refIdx[i]]
					height = slotH[refIdx[i]]
					found = true
					break
				}
			}
			frameSize(b) unless found
			// A reference may be at most twice as large and sixteen times
			// as small as the frame, each way.
			let usable = false
			for let i = 0; i < 3; i++ {
				let rw = slotW[refIdx[i]]
				let rh = slotH[refIdx[i]]
				usable = true when 2 * width >= rw && 2 * height >= rh && width <= 16 * rw && height <= 16 * rh
				fail "vp9: reference of another colour format" when slotDepth[refIdx[i]] != bitDepth || slotSs[refIdx[i]] != ssx * 2 + ssy
			}
			fail "vp9: no reference of a usable size" unless usable
			renderSize(b)
			return none
		}

		internal def signedLiteral(b MpegBits, n int) int {
			let v = b.read(n)
			return b.flag() ?? (0 - v, v)
		}

		internal def deltaQ(b MpegBits) int {
			return b.flag() ?? (signedLiteral(b, 4), 0)
		}

		internal def segmentation(b MpegBits) {
			segUpdateMap = false
			segEnabled = b.flag()
			return unless segEnabled
			segUpdateMap = b.flag()
			if segUpdateMap {
				for let i = 0; i < 7; i++ {
					segTreeProbs[i] = b.flag() ?? (b.read(8), 255)
				}
				segTemporal = b.flag()
				for let i = 0; i < 3; i++ {
					segPredProbs[i] = (segTemporal && b.flag()) ?? (b.read(8), 255)
				}
			}
			return unless b.flag()
			segAbsDelta = b.flag()
			segMask.fill(0)
			for let i = 0; i < 8; i++ {
				for let j = 0; j < 4; j++ {
					let data = 0
					if b.flag() {
						segMask[i] = segMask[i] | (1 << j)
						let bits = vp9SegFeatureBits[j]
						let max = (1 << bits) - 1
						max = 3 when j == vp9SegRef
						data = b.read(bits)
						data = max when data > max
						data = 0 - data when j < 2 && b.flag()
					}
					segData[i * 4 + j] = data
				}
			}
		}
	}

	// Bits of each segment feature's value.
	const vp9SegFeatureBits = int[8, 6, 2, 0]

	def vp9Clamp(x int, lo int, hi int) int {
		return lo when x < lo
		return hi when x > hi
		return x
	}
}
