internal partial module std.formats.video.vp9 {
	use std.simd

	// Samples per row of `Vp9Tile.mcEdge` and `Vp9Tile.mcMid`.
	const vp9EdgeStride = 144
	const vp9MidStride = 64
	// The scale of a reference of the frame's own size.
	const vp9NoScale = 16384

	// The interpolation kernels by filter: regular, smooth, sharp,
	// bilinear.
	def vp9Kernels(filter int) int[] {
		return vp9FilterRegular when filter == 0
		return vp9FilterSmooth when filter == 1
		return vp9FilterSharp when filter == 2
		return vp9FilterBilinear
	}

	def vp9RoundQ4(v int) int {
		return (v < 0 ?? (v - 2, v + 2)) / 4
	}

	def vp9RoundQ2(v int) int {
		return (v < 0 ?? (v - 1, v + 1)) / 2
	}

	// Predicts the inter block in progress from its one or two
	// references into the frame. The planes go down as arguments: a local
	// chosen among arrays would be counted in and out per block.
	def vp9PredictInter(t Vp9Tile) {
		let refs = t.ref1 > 0 ?? (2, 1)
		let k = vp9Kernels(t.filter)
		let ssx = t.h.ssx
		let ssy = t.h.ssy
		for let r = 0; r < refs; r++ {
			let frame = (r == 0 ?? (t.ref0, t.ref1)) - 1
			let rw = t.refs[frame].width
			let rh = t.refs[frame].height
			vp9PredictPlane(t, 0, 0, frame, r, k, t.refs[frame].y, t.refs[frame].stride, rw, rh, t.cur.y, t.cur.stride)
			vp9PredictPlane(t, ssx, ssy, frame, r, k, t.refs[frame].u, t.refs[frame].cstride, (rw + ssx) >> ssx, (rh + ssy) >> ssy, t.cur.u, t.cur.cstride)
			vp9PredictPlane(t, ssx, ssy, frame, r, k, t.refs[frame].v, t.refs[frame].cstride, (rw + ssx) >> ssx, (rh + ssy) >> ssy, t.cur.v, t.cur.cstride)
		}
	}

	// Predicts one plane (subsampled by ssx, ssy) of the block in progress
	// from the plane `src` of reference `frame` (0-2), frameW x frameH
	// samples, into `dst`; `second` is 1 for a block's second reference.
	def vp9PredictPlane(t Vp9Tile, ssx int, ssy int, frame int, second int, k int[], src uint16[], sstride int, frameW int, frameH int, dst uint16[], dstride int) {
		let bmv = t.bmv
		let r = second
		let n4w = (t.bw << 1) >> ssx
		let n4h = (t.bh << 1) >> ssy
		if t.bsize >= vp9Block8x8 {
			vp9BuildInter(t, ssx, ssy, frame, r, k, src, sstride, frameW, frameH, dst, dstride, n4w * 4, n4h * 4, 0, 0, n4w * 4, n4h * 4, vp9MvRow(bmv[r]), vp9MvCol(bmv[r]))
			return
		}
		let i = 0
		for let y = 0; y < n4h; y++ {
			for let x = 0; x < n4w; x++ {
				// A subsampled plane averages the vectors of the luma
				// blocks it covers.
				let row = vp9MvRow(bmv[i * 2 + r])
				let col = vp9MvCol(bmv[i * 2 + r])
				if ssx != 0 && ssy != 0 {
					row = vp9RoundQ4(vp9MvRow(bmv[r]) + vp9MvRow(bmv[2 + r]) + vp9MvRow(bmv[4 + r]) + vp9MvRow(bmv[6 + r]))
					col = vp9RoundQ4(vp9MvCol(bmv[r]) + vp9MvCol(bmv[2 + r]) + vp9MvCol(bmv[4 + r]) + vp9MvCol(bmv[6 + r]))
				} else if ssx != 0 || ssy != 0 {
					// With only the width halved the second block pairs
					// sub-blocks 1 and 2, as libvpx does.
					let other = (i + (ssx != 0 ?? (1, 2))) * 2 + r
					row = vp9RoundQ2(row + vp9MvRow(bmv[other]))
					col = vp9RoundQ2(col + vp9MvCol(bmv[other]))
				}
				vp9BuildInter(t, ssx, ssy, frame, r, k, src, sstride, frameW, frameH, dst, dstride, n4w * 4, n4h * 4, x * 4, y * 4, 4, 4, row, col)
				i++
			}
		}
	}

	// Predicts the w x h samples at (x, y) of the block in progress in a
	// plane (the plane's block being bw x bh) from the reference plane
	// `src` with the vector (mvRow, mvCol) in 1/8 luma samples; the second
	// reference of a block (`second` 1) is averaged in.
	def vp9BuildInter(t Vp9Tile, ssx int, ssy int, frame int, second int, k int[], src uint16[], sstride int, frameW int, frameH int, dst uint16[], dstride int, bw int, bh int, x int, y int, w int, h int, mvRow int, mvCol int) {
		let sx = t.scaleX[frame]
		let sy = t.scaleY[frame]
		// A reference too large or too small for the frame cannot predict.
		if sx == 0 {
			t.bad = true
			return
		}
		let xStart = (t.miCol * 8) >> ssx
		let yStart = (t.miRow * 8) >> ssy
		let row = mvRow * (1 << (1 - ssy))
		let col = mvCol * (1 << (1 - ssx))
		let x0 = xStart + x
		let y0 = yStart + y
		let xs = 16
		let ys = 16
		if sx != vp9NoScale || sy != vp9NoScale {
			// A vector that leaves the frame by more than the block and
			// the filter's reach predicts the same as one that stops there.
			let spelLeft = (4 + bw) << 4
			let spelTop = (4 + bh) << 4
			let toLeft = 0 - t.miCol * 64
			let toRight = (t.miCols - t.bw - t.miCol) * 64
			let toTop = 0 - t.miRow * 64
			let toBottom = (t.miRows - t.bh - t.miRow) * 64
			col = vp9Clamp(col, toLeft * (1 << (1 - ssx)) - spelLeft, toRight * (1 << (1 - ssx)) + spelLeft - 16)
			row = vp9Clamp(row, toTop * (1 << (1 - ssy)) - spelTop, toBottom * (1 << (1 - ssy)) + spelTop - 16)
			x0 = (x0 * sx) >> 14
			y0 = (y0 * sy) >> 14
			col = ((col * sx) >> 14) + (((((t.miCol * 8 + x) << 4) * sx) >> 14) & 15)
			row = ((row * sy) >> 14) + (((((t.miRow * 8 + y) << 4) * sy) >> 14) & 15)
			xs = (16 * sx) >> 14
			ys = (16 * sy) >> 14
		}
		let subX = col & 15
		let subY = row & 15
		x0 += col >> 4
		y0 += row >> 4
		let doH = subX != 0 || xs != 16
		let doV = subY != 0 || ys != 16
		// The reference samples the filters read; outside the frame they
		// repeat its edge.
		let left = x0 - (doH ?? (3, 0))
		let top = y0 - (doV ?? (3, 0))
		let right = x0 + ((subX + (w - 1) * xs) >> 4) + (doH ?? (4, 0))
		let bottom = y0 + ((subY + (h - 1) * ys) >> 4) + (doV ?? (4, 0))
		let maxv = (1 << t.h.bitDepth) - 1
		let dat = (yStart + y) * dstride + xStart + x
		if left < 0 || top < 0 || right > frameW - 1 || bottom > frameH - 1 {
			let e = t.mcEdge
			for let j = top; j <= bottom; j++ {
				let from = vp9Clamp(j, 0, frameH - 1) * sstride
				let o = (j - top) * vp9EdgeStride - left
				for let i = left; i <= right; i++ {
					e[o + i] = src[from + vp9Clamp(i, 0, frameW - 1)]
				}
			}
			vp9PredictFrom(t, t.mcEdge, (y0 - top) * vp9EdgeStride + x0 - left, vp9EdgeStride, dst, dat, dstride, w, h, k, subX, xs, subY, ys, doH, doV, maxv, second)
			return
		}
		vp9PredictFrom(t, src, y0 * sstride + x0, sstride, dst, dat, dstride, w, h, k, subX, xs, subY, ys, doH, doV, maxv, second)
	}

	// Filters a block from src[sat] into the frame, or for a second
	// reference into scratch and averages it in.
	def vp9PredictFrom(t Vp9Tile, src uint16[], sat int, sstride int, dst uint16[], dat int, dstride int, w int, h int, k int[], subX int, xs int, subY int, ys int, doH bool, doV bool, maxv int, second int) {
		if second == 0 {
			vp9Convolve(t, src, sat, sstride, dst, dat, dstride, w, h, k, subX, xs, subY, ys, doH, doV, maxv)
			return
		}
		vp9Convolve(t, src, sat, sstride, t.pred2, 0, 64, w, h, k, subX, xs, subY, ys, doH, doV, maxv)
		vp9Average(dst, dat, dstride, t.pred2, w, h)
	}

	// Averages the w x h block `b` (64 samples a row) into dst.
	def vp9Average(dst uint16[], dat int, dstride int, b uint16[], w int, h int) {
		if w >= 8 {
			let one = simd.splat8<int32>(int32(1))
			for let y = 0; y < h; y++ {
				for let x = 0; x < w; x += 8 {
					let a = simd.convert<uint16, int32>(simd.load8<uint16>(dst, dat + y * dstride + x))
					let c = simd.convert<uint16, int32>(simd.load8<uint16>(b, y * 64 + x))
					simd.store8<uint16>(dst, dat + y * dstride + x, simd.convert<int32, uint16>((a + c + one) >> 1))
				}
			}
			return
		}
		for let y = 0; y < h; y++ {
			for let x = 0; x < w; x++ {
				dst[dat + y * dstride + x] = uint16((int(dst[dat + y * dstride + x]) + int(b[y * 64 + x]) + 1) >> 1)
			}
		}
	}

	// Filters the w x h block whose first sample is src[sat] into
	// dst[dat]: horizontally from the 1/16 position subX stepping xs per
	// sample when `doH`, then vertically likewise when `doV`, with the
	// kernels `k`.
	def vp9Convolve(t Vp9Tile, src uint16[], sat int, sstride int, dst uint16[], dat int, dstride int, w int, h int, k int[], subX int, xs int, subY int, ys int, doH bool, doV bool, maxv int) {
		if !doH && !doV {
			for let y = 0; y < h; y++ {
				let s = sat + y * sstride
				let d = dat + y * dstride
				if w >= 32 {
					for let x = 0; x < w; x += 32 {
						simd.store32<uint16>(dst, d + x, simd.load32<uint16>(src, s + x))
					}
					continue
				}
				if w >= 8 {
					for let x = 0; x < w; x += 8 {
						simd.store8<uint16>(dst, d + x, simd.load8<uint16>(src, s + x))
					}
					continue
				}
				for let x = 0; x < w; x++ {
					dst[d + x] = src[s + x]
				}
			}
			return
		}
		if xs == 16 && ys == 16 && w == 4 {
			vp9Convolve4(t, src, sat, sstride, dst, dat, dstride, h, k, subX, subY, doH, doV, maxv)
			return
		}
		if xs != 16 || ys != 16 || w < 8 {
			vp9ConvolveScaled(t, src, sat, sstride, dst, dat, dstride, w, h, k, subX, xs, subY, ys, doH, doV, maxv)
			return
		}
		if maxv == 255 && w >= 16 {
			vp9Convolve16(t, src, sat, sstride, dst, dat, dstride, w, h, k, subX, subY, doH, doV)
			return
		}
		if maxv == 255 {
			vp9Convolve8(t, src, sat, sstride, dst, dat, dstride, w, h, k, subX, subY, doH, doV)
			return
		}
		let lo = simd.splat8<int32>(int32(0))
		let hi = simd.splat8<int32>(int32(maxv))
		let rnd = simd.splat8<int32>(int32(64))
		let hf = subX * 8
		let vf = subY * 8
		let h0 = simd.splat8<int32>(int32(k[hf]))
		let h1 = simd.splat8<int32>(int32(k[hf + 1]))
		let h2 = simd.splat8<int32>(int32(k[hf + 2]))
		let h3 = simd.splat8<int32>(int32(k[hf + 3]))
		let h4 = simd.splat8<int32>(int32(k[hf + 4]))
		let h5 = simd.splat8<int32>(int32(k[hf + 5]))
		let h6 = simd.splat8<int32>(int32(k[hf + 6]))
		let h7 = simd.splat8<int32>(int32(k[hf + 7]))
		let v0 = simd.splat8<int32>(int32(k[vf]))
		let v1 = simd.splat8<int32>(int32(k[vf + 1]))
		let v2 = simd.splat8<int32>(int32(k[vf + 2]))
		let v3 = simd.splat8<int32>(int32(k[vf + 3]))
		let v4 = simd.splat8<int32>(int32(k[vf + 4]))
		let v5 = simd.splat8<int32>(int32(k[vf + 5]))
		let v6 = simd.splat8<int32>(int32(k[vf + 6]))
		let v7 = simd.splat8<int32>(int32(k[vf + 7]))
		if !doV {
			for let y = 0; y < h; y++ {
				for let x = 0; x < w; x += 8 {
					let q = sat + y * sstride + x - 3
					let acc = h0 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q))
					acc += h1 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 1))
					acc += h2 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 2))
					acc += h3 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 3))
					acc += h4 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 4))
					acc += h5 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 5))
					acc += h6 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 6))
					acc += h7 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 7))
					simd.store8<uint16>(dst, dat + y * dstride + x, simd.convert<int32, uint16>(simd.clamp((acc + rnd) >> 7, lo, hi)))
				}
			}
			return
		}
		if !doH {
			for let y = 0; y < h; y++ {
				for let x = 0; x < w; x += 8 {
					let q = sat + (y - 3) * sstride + x
					let acc = v0 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q))
					acc += v1 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + sstride))
					acc += v2 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 2 * sstride))
					acc += v3 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 3 * sstride))
					acc += v4 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 4 * sstride))
					acc += v5 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 5 * sstride))
					acc += v6 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 6 * sstride))
					acc += v7 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 7 * sstride))
					simd.store8<uint16>(dst, dat + y * dstride + x, simd.convert<int32, uint16>(simd.clamp((acc + rnd) >> 7, lo, hi)))
				}
			}
			return
		}
		let mid = t.mcMid
		for let y = 0; y < h + 7; y++ {
			for let x = 0; x < w; x += 8 {
				let q = sat + (y - 3) * sstride + x - 3
				let acc = h0 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q))
				acc += h1 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 1))
				acc += h2 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 2))
				acc += h3 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 3))
				acc += h4 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 4))
				acc += h5 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 5))
				acc += h6 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 6))
				acc += h7 * simd.convert<uint16, int32>(simd.load8<uint16>(src, q + 7))
				simd.store8<int32>(mid, y * vp9MidStride + x, simd.clamp((acc + rnd) >> 7, lo, hi))
			}
		}
		for let y = 0; y < h; y++ {
			for let x = 0; x < w; x += 8 {
				let q = y * vp9MidStride + x
				let acc = v0 * simd.load8<int32>(mid, q)
				acc += v1 * simd.load8<int32>(mid, q + vp9MidStride)
				acc += v2 * simd.load8<int32>(mid, q + 2 * vp9MidStride)
				acc += v3 * simd.load8<int32>(mid, q + 3 * vp9MidStride)
				acc += v4 * simd.load8<int32>(mid, q + 4 * vp9MidStride)
				acc += v5 * simd.load8<int32>(mid, q + 5 * vp9MidStride)
				acc += v6 * simd.load8<int32>(mid, q + 6 * vp9MidStride)
				acc += v7 * simd.load8<int32>(mid, q + 7 * vp9MidStride)
				simd.store8<uint16>(dst, dat + y * dstride + x, simd.convert<int32, uint16>(simd.clamp((acc + rnd) >> 7, lo, hi)))
			}
		}
	}

	// The same for 8-bit video in blocks of sixteen samples and wider,
	// sixteen 16-bit lanes a step. The sum of eight taps times samples
	// spans less than 65536 values for every kernel (at most 182 above
	// zero and 54 below, times 255), so it is exact modulo 65536; adding
	// 16384 before the shift keeps it positive, which leaves 128 too much.
	def vp9Convolve16(t Vp9Tile, src uint16[], sat int, sstride int, dst uint16[], dat int, dstride int, w int, h int, k int[], subX int, subY int, doH bool, doV bool) {
		let bias = simd.splat16<uint16>(uint16(16384 + 64))
		let lo = simd.splat16<uint16>(uint16(128))
		let hi = simd.splat16<uint16>(uint16(383))
		let hf = subX * 8
		let vf = subY * 8
		let h0 = simd.splat16<uint16>(uint16(k[hf + 0] & 0xFFFF))
		let h1 = simd.splat16<uint16>(uint16(k[hf + 1] & 0xFFFF))
		let h2 = simd.splat16<uint16>(uint16(k[hf + 2] & 0xFFFF))
		let h3 = simd.splat16<uint16>(uint16(k[hf + 3] & 0xFFFF))
		let h4 = simd.splat16<uint16>(uint16(k[hf + 4] & 0xFFFF))
		let h5 = simd.splat16<uint16>(uint16(k[hf + 5] & 0xFFFF))
		let h6 = simd.splat16<uint16>(uint16(k[hf + 6] & 0xFFFF))
		let h7 = simd.splat16<uint16>(uint16(k[hf + 7] & 0xFFFF))
		let v0 = simd.splat16<uint16>(uint16(k[vf + 0] & 0xFFFF))
		let v1 = simd.splat16<uint16>(uint16(k[vf + 1] & 0xFFFF))
		let v2 = simd.splat16<uint16>(uint16(k[vf + 2] & 0xFFFF))
		let v3 = simd.splat16<uint16>(uint16(k[vf + 3] & 0xFFFF))
		let v4 = simd.splat16<uint16>(uint16(k[vf + 4] & 0xFFFF))
		let v5 = simd.splat16<uint16>(uint16(k[vf + 5] & 0xFFFF))
		let v6 = simd.splat16<uint16>(uint16(k[vf + 6] & 0xFFFF))
		let v7 = simd.splat16<uint16>(uint16(k[vf + 7] & 0xFFFF))
		if !doV {
			for let y = 0; y < h; y++ {
				for let x = 0; x < w; x += 16 {
					let q = sat + y * sstride + x - 3
					let acc = h0 * simd.load16<uint16>(src, q)
					acc += h1 * simd.load16<uint16>(src, q + 1)
					acc += h2 * simd.load16<uint16>(src, q + 2)
					acc += h3 * simd.load16<uint16>(src, q + 3)
					acc += h4 * simd.load16<uint16>(src, q + 4)
					acc += h5 * simd.load16<uint16>(src, q + 5)
					acc += h6 * simd.load16<uint16>(src, q + 6)
					acc += h7 * simd.load16<uint16>(src, q + 7)
					simd.store16<uint16>(dst, dat + y * dstride + x, simd.clamp((acc + bias) >> 7, lo, hi) - lo)
				}
			}
			return
		}
		if !doH {
			for let y = 0; y < h; y++ {
				for let x = 0; x < w; x += 16 {
					let q = sat + (y - 3) * sstride + x
					let acc = v0 * simd.load16<uint16>(src, q)
					acc += v1 * simd.load16<uint16>(src, q + sstride)
					acc += v2 * simd.load16<uint16>(src, q + 2 * sstride)
					acc += v3 * simd.load16<uint16>(src, q + 3 * sstride)
					acc += v4 * simd.load16<uint16>(src, q + 4 * sstride)
					acc += v5 * simd.load16<uint16>(src, q + 5 * sstride)
					acc += v6 * simd.load16<uint16>(src, q + 6 * sstride)
					acc += v7 * simd.load16<uint16>(src, q + 7 * sstride)
					simd.store16<uint16>(dst, dat + y * dstride + x, simd.clamp((acc + bias) >> 7, lo, hi) - lo)
				}
			}
			return
		}
		let mid = t.mid16
		for let y = 0; y < h + 7; y++ {
			for let x = 0; x < w; x += 16 {
				let q = sat + (y - 3) * sstride + x - 3
				let acc = h0 * simd.load16<uint16>(src, q)
				acc += h1 * simd.load16<uint16>(src, q + 1)
				acc += h2 * simd.load16<uint16>(src, q + 2)
				acc += h3 * simd.load16<uint16>(src, q + 3)
				acc += h4 * simd.load16<uint16>(src, q + 4)
				acc += h5 * simd.load16<uint16>(src, q + 5)
				acc += h6 * simd.load16<uint16>(src, q + 6)
				acc += h7 * simd.load16<uint16>(src, q + 7)
				simd.store16<uint16>(mid, y * vp9MidStride + x, simd.clamp((acc + bias) >> 7, lo, hi) - lo)
			}
		}
		for let y = 0; y < h; y++ {
			for let x = 0; x < w; x += 16 {
				let q = y * vp9MidStride + x
				let acc = v0 * simd.load16<uint16>(mid, q)
				acc += v1 * simd.load16<uint16>(mid, q + vp9MidStride)
				acc += v2 * simd.load16<uint16>(mid, q + 2 * vp9MidStride)
				acc += v3 * simd.load16<uint16>(mid, q + 3 * vp9MidStride)
				acc += v4 * simd.load16<uint16>(mid, q + 4 * vp9MidStride)
				acc += v5 * simd.load16<uint16>(mid, q + 5 * vp9MidStride)
				acc += v6 * simd.load16<uint16>(mid, q + 6 * vp9MidStride)
				acc += v7 * simd.load16<uint16>(mid, q + 7 * vp9MidStride)
				simd.store16<uint16>(dst, dat + y * dstride + x, simd.clamp((acc + bias) >> 7, lo, hi) - lo)
			}
		}
	}

	// The same for 8-bit blocks eight samples wide, eight 16-bit lanes a
	// step (see vp9Convolve16).
	def vp9Convolve8(t Vp9Tile, src uint16[], sat int, sstride int, dst uint16[], dat int, dstride int, w int, h int, k int[], subX int, subY int, doH bool, doV bool) {
		let bias = simd.splat8<uint16>(uint16(16384 + 64))
		let lo = simd.splat8<uint16>(uint16(128))
		let hi = simd.splat8<uint16>(uint16(383))
		let hf = subX * 8
		let vf = subY * 8
		let h0 = simd.splat8<uint16>(uint16(k[hf + 0] & 0xFFFF))
		let h1 = simd.splat8<uint16>(uint16(k[hf + 1] & 0xFFFF))
		let h2 = simd.splat8<uint16>(uint16(k[hf + 2] & 0xFFFF))
		let h3 = simd.splat8<uint16>(uint16(k[hf + 3] & 0xFFFF))
		let h4 = simd.splat8<uint16>(uint16(k[hf + 4] & 0xFFFF))
		let h5 = simd.splat8<uint16>(uint16(k[hf + 5] & 0xFFFF))
		let h6 = simd.splat8<uint16>(uint16(k[hf + 6] & 0xFFFF))
		let h7 = simd.splat8<uint16>(uint16(k[hf + 7] & 0xFFFF))
		let v0 = simd.splat8<uint16>(uint16(k[vf + 0] & 0xFFFF))
		let v1 = simd.splat8<uint16>(uint16(k[vf + 1] & 0xFFFF))
		let v2 = simd.splat8<uint16>(uint16(k[vf + 2] & 0xFFFF))
		let v3 = simd.splat8<uint16>(uint16(k[vf + 3] & 0xFFFF))
		let v4 = simd.splat8<uint16>(uint16(k[vf + 4] & 0xFFFF))
		let v5 = simd.splat8<uint16>(uint16(k[vf + 5] & 0xFFFF))
		let v6 = simd.splat8<uint16>(uint16(k[vf + 6] & 0xFFFF))
		let v7 = simd.splat8<uint16>(uint16(k[vf + 7] & 0xFFFF))
		if !doV {
			for let y = 0; y < h; y++ {
				for let x = 0; x < w; x += 8 {
					let q = sat + y * sstride + x - 3
					let acc = h0 * simd.load8<uint16>(src, q)
					acc += h1 * simd.load8<uint16>(src, q + 1)
					acc += h2 * simd.load8<uint16>(src, q + 2)
					acc += h3 * simd.load8<uint16>(src, q + 3)
					acc += h4 * simd.load8<uint16>(src, q + 4)
					acc += h5 * simd.load8<uint16>(src, q + 5)
					acc += h6 * simd.load8<uint16>(src, q + 6)
					acc += h7 * simd.load8<uint16>(src, q + 7)
					simd.store8<uint16>(dst, dat + y * dstride + x, simd.clamp((acc + bias) >> 7, lo, hi) - lo)
				}
			}
			return
		}
		if !doH {
			for let y = 0; y < h; y++ {
				for let x = 0; x < w; x += 8 {
					let q = sat + (y - 3) * sstride + x
					let acc = v0 * simd.load8<uint16>(src, q)
					acc += v1 * simd.load8<uint16>(src, q + sstride)
					acc += v2 * simd.load8<uint16>(src, q + 2 * sstride)
					acc += v3 * simd.load8<uint16>(src, q + 3 * sstride)
					acc += v4 * simd.load8<uint16>(src, q + 4 * sstride)
					acc += v5 * simd.load8<uint16>(src, q + 5 * sstride)
					acc += v6 * simd.load8<uint16>(src, q + 6 * sstride)
					acc += v7 * simd.load8<uint16>(src, q + 7 * sstride)
					simd.store8<uint16>(dst, dat + y * dstride + x, simd.clamp((acc + bias) >> 7, lo, hi) - lo)
				}
			}
			return
		}
		let mid = t.mid16
		for let y = 0; y < h + 7; y++ {
			for let x = 0; x < w; x += 8 {
				let q = sat + (y - 3) * sstride + x - 3
				let acc = h0 * simd.load8<uint16>(src, q)
				acc += h1 * simd.load8<uint16>(src, q + 1)
				acc += h2 * simd.load8<uint16>(src, q + 2)
				acc += h3 * simd.load8<uint16>(src, q + 3)
				acc += h4 * simd.load8<uint16>(src, q + 4)
				acc += h5 * simd.load8<uint16>(src, q + 5)
				acc += h6 * simd.load8<uint16>(src, q + 6)
				acc += h7 * simd.load8<uint16>(src, q + 7)
				simd.store8<uint16>(mid, y * vp9MidStride + x, simd.clamp((acc + bias) >> 7, lo, hi) - lo)
			}
		}
		for let y = 0; y < h; y++ {
			for let x = 0; x < w; x += 8 {
				let q = y * vp9MidStride + x
				let acc = v0 * simd.load8<uint16>(mid, q)
				acc += v1 * simd.load8<uint16>(mid, q + vp9MidStride)
				acc += v2 * simd.load8<uint16>(mid, q + 2 * vp9MidStride)
				acc += v3 * simd.load8<uint16>(mid, q + 3 * vp9MidStride)
				acc += v4 * simd.load8<uint16>(mid, q + 4 * vp9MidStride)
				acc += v5 * simd.load8<uint16>(mid, q + 5 * vp9MidStride)
				acc += v6 * simd.load8<uint16>(mid, q + 6 * vp9MidStride)
				acc += v7 * simd.load8<uint16>(mid, q + 7 * vp9MidStride)
				simd.store8<uint16>(dst, dat + y * dstride + x, simd.clamp((acc + bias) >> 7, lo, hi) - lo)
			}
		}
	}

	// The same for a block four samples wide from a reference of the
	// frame's size, a row of four per step.
	def vp9Convolve4(t Vp9Tile, src uint16[], sat int, sstride int, dst uint16[], dat int, dstride int, h int, k int[], subX int, subY int, doH bool, doV bool, maxv int) {
		let lo = simd.splat4<int32>(int32(0))
		let hi = simd.splat4<int32>(int32(maxv))
		let rnd = simd.splat4<int32>(int32(64))
		let mid = t.mcMid
		let rows = doV ?? (h + 7, h)
		let first = doV ?? (sat - 3 * sstride, sat)
		if doH {
			let hf = subX * 8
			let h0 = simd.splat4<int32>(int32(k[hf]))
			let h1 = simd.splat4<int32>(int32(k[hf + 1]))
			let h2 = simd.splat4<int32>(int32(k[hf + 2]))
			let h3 = simd.splat4<int32>(int32(k[hf + 3]))
			let h4 = simd.splat4<int32>(int32(k[hf + 4]))
			let h5 = simd.splat4<int32>(int32(k[hf + 5]))
			let h6 = simd.splat4<int32>(int32(k[hf + 6]))
			let h7 = simd.splat4<int32>(int32(k[hf + 7]))
			for let y = 0; y < rows; y++ {
				let q = first + y * sstride - 3
				let acc = h0 * simd.convert<uint16, int32>(simd.load4<uint16>(src, q))
				acc += h1 * simd.convert<uint16, int32>(simd.load4<uint16>(src, q + 1))
				acc += h2 * simd.convert<uint16, int32>(simd.load4<uint16>(src, q + 2))
				acc += h3 * simd.convert<uint16, int32>(simd.load4<uint16>(src, q + 3))
				acc += h4 * simd.convert<uint16, int32>(simd.load4<uint16>(src, q + 4))
				acc += h5 * simd.convert<uint16, int32>(simd.load4<uint16>(src, q + 5))
				acc += h6 * simd.convert<uint16, int32>(simd.load4<uint16>(src, q + 6))
				acc += h7 * simd.convert<uint16, int32>(simd.load4<uint16>(src, q + 7))
				simd.store4<int32>(mid, y * vp9MidStride, simd.clamp((acc + rnd) >> 7, lo, hi))
			}
		} else {
			for let y = 0; y < rows; y++ {
				simd.store4<int32>(mid, y * vp9MidStride, simd.convert<uint16, int32>(simd.load4<uint16>(src, first + y * sstride)))
			}
		}
		if !doV {
			for let y = 0; y < h; y++ {
				simd.store4<uint16>(dst, dat + y * dstride, simd.convert<int32, uint16>(simd.load4<int32>(mid, y * vp9MidStride)))
			}
			return
		}
		let vf = subY * 8
		let v0 = simd.splat4<int32>(int32(k[vf]))
		let v1 = simd.splat4<int32>(int32(k[vf + 1]))
		let v2 = simd.splat4<int32>(int32(k[vf + 2]))
		let v3 = simd.splat4<int32>(int32(k[vf + 3]))
		let v4 = simd.splat4<int32>(int32(k[vf + 4]))
		let v5 = simd.splat4<int32>(int32(k[vf + 5]))
		let v6 = simd.splat4<int32>(int32(k[vf + 6]))
		let v7 = simd.splat4<int32>(int32(k[vf + 7]))
		for let y = 0; y < h; y++ {
			let q = y * vp9MidStride
			let acc = v0 * simd.load4<int32>(mid, q)
			acc += v1 * simd.load4<int32>(mid, q + vp9MidStride)
			acc += v2 * simd.load4<int32>(mid, q + 2 * vp9MidStride)
			acc += v3 * simd.load4<int32>(mid, q + 3 * vp9MidStride)
			acc += v4 * simd.load4<int32>(mid, q + 4 * vp9MidStride)
			acc += v5 * simd.load4<int32>(mid, q + 5 * vp9MidStride)
			acc += v6 * simd.load4<int32>(mid, q + 6 * vp9MidStride)
			acc += v7 * simd.load4<int32>(mid, q + 7 * vp9MidStride)
			simd.store4<uint16>(dst, dat + y * dstride, simd.convert<int32, uint16>(simd.clamp((acc + rnd) >> 7, lo, hi)))
		}
	}

	// The same sample by sample: blocks narrower than eight samples and
	// references of another size, where each sample has its own position.
	def vp9ConvolveScaled(t Vp9Tile, src uint16[], sat int, sstride int, dst uint16[], dat int, dstride int, w int, h int, k int[], subX int, xs int, subY int, ys int, doH bool, doV bool, maxv int) {
		let mid = t.mcMid
		// Rows the vertical filter reads, from three above the block.
		let rows = doV ?? (((subY + (h - 1) * ys) >> 4) + 8, h)
		let first = doV ?? (sat - 3 * sstride, sat)
		for let y = 0; y < rows; y++ {
			let q = first + y * sstride
			let xq = subX
			for let x = 0; x < w; x++ {
				let v = 0
				if doH {
					let s = q + (xq >> 4) - 3
					let f = (xq & 15) * 8
					let sum = k[f] * int(src[s]) + k[f + 1] * int(src[s + 1]) + k[f + 2] * int(src[s + 2]) + k[f + 3] * int(src[s + 3])
					sum += k[f + 4] * int(src[s + 4]) + k[f + 5] * int(src[s + 5]) + k[f + 6] * int(src[s + 6]) + k[f + 7] * int(src[s + 7])
					v = vp9Clamp((sum + 64) >> 7, 0, maxv)
					xq += xs
				} else {
					v = int(src[q + x])
				}
				mid[y * vp9MidStride + x] = int32(v)
			}
		}
		for let x = 0; x < w; x++ {
			let yq = subY
			for let y = 0; y < h; y++ {
				let v = 0
				if doV {
					let s = (yq >> 4) * vp9MidStride + x
					let f = (yq & 15) * 8
					let sum = k[f] * int(mid[s]) + k[f + 1] * int(mid[s + vp9MidStride]) + k[f + 2] * int(mid[s + 2 * vp9MidStride]) + k[f + 3] * int(mid[s + 3 * vp9MidStride])
					sum += k[f + 4] * int(mid[s + 4 * vp9MidStride]) + k[f + 5] * int(mid[s + 5 * vp9MidStride]) + k[f + 6] * int(mid[s + 6 * vp9MidStride]) + k[f + 7] * int(mid[s + 7 * vp9MidStride])
					v = vp9Clamp((sum + 64) >> 7, 0, maxv)
					yq += ys
				} else {
					v = int(mid[y * vp9MidStride + x])
				}
				dst[dat + y * dstride + x] = uint16(v)
			}
		}
	}
}
