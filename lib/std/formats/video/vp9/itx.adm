internal partial module std.formats.video.vp9 {
	use std.simd

	// Whether the coefficients of a transform of size `tx` are stored
	// mirrored, as the eight-lane transforms read them.
	def vp9Transposed(t Vp9Tile, tx int) bool {
		return tx >= 1 && !t.h.lossless
	}

	// Whether the eight-lane transforms, on 32-bit values, are exact for
	// the n x n block in `b`: no value inside a transform exceeds the sum
	// of the block's magnitudes, and its products with the 14-bit
	// constants, two at a time, must stay below 2^31.
	def vp9FitsLanes(b int32[], n int) bool {
		let zero = simd.splat8<int32>(int32(0))
		let sum = zero
		for let i = 0; i < n * n; i += 8 {
			sum += simd.load8<int32>(b, i).abs()
		}
		let parts = int32[0, 0, 0, 0, 0, 0, 0, 0]
		simd.store8<int32>(parts, 0, sum)
		let total = 0
		for let i = 0; i < 8; i++ {
			total += int(parts[i])
		}
		return total < 32768
	}

	// One 1-D inverse transform of 4 << tx values: DCT, or ADST.
	def vp9Tx1d(b int32[], at int, s int, tx int, adst bool) {
		if tx == 0 {
			if adst {
				vp9Iadst4(b, at, s)
			} else {
				vp9Idct4(b, at, s)
			}
		} else if tx == 1 {
			if adst {
				vp9Iadst8(b, at, s)
			} else {
				vp9Idct8(b, at, s)
			}
		} else if tx == 2 {
			if adst {
				vp9Iadst16(b, at, s)
			} else {
				vp9Idct16(b, at, s)
			}
		} else {
			vp9Idct32(b, at, s)
		}
	}

	// The same on eight lanes (see vp9/itx1d_simd.adm), tx >= 1.
	def vp9Tx1dV(b int32[], at int, s int, tx int, adst bool) {
		if tx == 1 {
			if adst {
				vp9Iadst8V(b, at, s)
			} else {
				vp9Idct8V(b, at, s)
			}
		} else if tx == 2 {
			if adst {
				vp9Iadst16V(b, at, s)
			} else {
				vp9Idct16V(b, at, s)
			}
		} else {
			vp9Idct32V(b, at, s)
		}
	}

	// Rows of a DCT block that can hold coefficients, by how many
	// positions of the default scan were coded.
	def vp9CodedRows(tx int, eob int) int {
		let n = 4 << tx
		return 4 when tx == 1 && eob <= 12
		return 4 when tx == 2 && eob <= 10
		return 8 when tx == 2 && eob <= 38
		return 8 when tx == 3 && eob <= 34
		return 16 when tx == 3 && eob <= 135
		return n
	}

	// Adds the inverse transform of the block in `t.coef` (`eob`
	// positions coded, transform type `txType`) to the 4 << tx samples
	// square at p[at], and clears the coefficients.
	def vp9InverseAdd(t Vp9Tile, p uint16[], at int, stride int, tx int, txType int, eob int) {
		let b = t.coef
		let n = 4 << tx
		let maxv = (1 << t.h.bitDepth) - 1
		if t.h.lossless {
			vp9IwhtAdd(b, p, at, stride, eob, maxv)
			return
		}
		let shift = tx == 0 ?? (4, tx == 1 ?? (5, 6))
		if txType == 0 && eob == 1 {
			let dc = (int(b[0]) * 11585 + 8192) >> 14
			dc = (dc * 11585 + 8192) >> 14
			b[0] = int32(0)
			vp9AddDc(p, at, stride, n, (dc + (1 << (shift - 1))) >> shift, maxv)
			return
		}
		let rows = txType == 0 ?? (vp9CodedRows(tx, eob), n)
		let rowAdst = (txType & 2) != 0
		let colAdst = (txType & 1) != 0
		if tx >= 1 && (maxv == 255 || vp9FitsLanes(b, n)) {
			for let g = 0; g < rows; g += 8 {
				vp9Tx1dV(b, g, n, tx, rowAdst)
			}
			vp9Transpose(b, n)
			for let g = 0; g < n; g += 8 {
				vp9Tx1dV(b, g, n, tx, colAdst)
			}
			vp9AddBlockV(b, n, p, at, stride, shift, maxv)
			return
		}
		// Large coefficients of 10 and 12-bit video need 64-bit values.
		vp9Transpose(b, n) when tx >= 1
		for let i = 0; i < rows; i++ {
			vp9Tx1d(b, i * n, 1, tx, rowAdst)
		}
		for let i = 0; i < n; i++ {
			vp9Tx1d(b, i, n, tx, colAdst)
		}
		let half = 1 << (shift - 1)
		for let y = 0; y < n; y++ {
			let o = at + y * stride
			for let x = 0; x < n; x++ {
				let v = int(p[o + x]) + ((int(b[y * n + x]) + half) >> shift)
				p[o + x] = uint16(v < 0 ?? (0, v > maxv ?? (maxv, v)))
				b[y * n + x] = int32(0)
			}
		}
	}

	// Mirrors the n x n block in `b` (n 8, 16 or 32) across its diagonal,
	// an 8x8 block of it and the block opposite a step.
	def vp9Transpose(b int32[], n int) {
		for let i = 0; i < n; i += 8 {
			for let j = 0; j <= i; j += 8 {
				let p = i * n + j
				let q = j * n + i
				let (a0, a1, a2, a3, a4, a5, a6, a7) = simd.transpose8(simd.load8<int32>(b, p), simd.load8<int32>(b, p + n), simd.load8<int32>(b, p + 2 * n), simd.load8<int32>(b, p + 3 * n), simd.load8<int32>(b, p + 4 * n), simd.load8<int32>(b, p + 5 * n), simd.load8<int32>(b, p + 6 * n), simd.load8<int32>(b, p + 7 * n))
				let (c0, c1, c2, c3, c4, c5, c6, c7) = simd.transpose8(simd.load8<int32>(b, q), simd.load8<int32>(b, q + n), simd.load8<int32>(b, q + 2 * n), simd.load8<int32>(b, q + 3 * n), simd.load8<int32>(b, q + 4 * n), simd.load8<int32>(b, q + 5 * n), simd.load8<int32>(b, q + 6 * n), simd.load8<int32>(b, q + 7 * n))
				simd.store8<int32>(b, q, a0)
				simd.store8<int32>(b, q + n, a1)
				simd.store8<int32>(b, q + 2 * n, a2)
				simd.store8<int32>(b, q + 3 * n, a3)
				simd.store8<int32>(b, q + 4 * n, a4)
				simd.store8<int32>(b, q + 5 * n, a5)
				simd.store8<int32>(b, q + 6 * n, a6)
				simd.store8<int32>(b, q + 7 * n, a7)
				simd.store8<int32>(b, p, c0)
				simd.store8<int32>(b, p + n, c1)
				simd.store8<int32>(b, p + 2 * n, c2)
				simd.store8<int32>(b, p + 3 * n, c3)
				simd.store8<int32>(b, p + 4 * n, c4)
				simd.store8<int32>(b, p + 5 * n, c5)
				simd.store8<int32>(b, p + 6 * n, c6)
				simd.store8<int32>(b, p + 7 * n, c7)
			}
		}
	}

	// Adds the n x n residual in `b`, rounded by `shift` bits, to the
	// samples at p[at] and clears it; n is 8, 16 or 32.
	def vp9AddBlockV(b int32[], n int, p uint16[], at int, stride int, shift int, maxv int) {
		let half = simd.splat8<int32>(int32(1 << (shift - 1)))
		let lo = simd.splat8<int32>(int32(0))
		let hi = simd.splat8<int32>(int32(maxv))
		for let y = 0; y < n; y++ {
			for let x = 0; x < n; x += 8 {
				let v = (simd.load8<int32>(b, y * n + x) + half) >> shift
				let d = simd.convert<uint16, int32>(simd.load8<uint16>(p, at + y * stride + x))
				simd.store8<uint16>(p, at + y * stride + x, simd.convert<int32, uint16>(simd.clamp(d + v, lo, hi)))
				simd.store8<int32>(b, y * n + x, lo)
			}
		}
	}

	// Adds `dc` to the n x n samples at p[at].
	def vp9AddDc(p uint16[], at int, stride int, n int, dc int, maxv int) {
		if n >= 8 {
			let v = simd.splat8<int32>(int32(dc))
			let lo = simd.splat8<int32>(int32(0))
			let hi = simd.splat8<int32>(int32(maxv))
			for let y = 0; y < n; y++ {
				for let x = 0; x < n; x += 8 {
					let d = simd.convert<uint16, int32>(simd.load8<uint16>(p, at + y * stride + x))
					simd.store8<uint16>(p, at + y * stride + x, simd.convert<int32, uint16>(simd.clamp(d + v, lo, hi)))
				}
			}
			return
		}
		for let y = 0; y < n; y++ {
			for let x = 0; x < n; x++ {
				let v = int(p[at + y * stride + x]) + dc
				p[at + y * stride + x] = uint16(v < 0 ?? (0, v > maxv ?? (maxv, v)))
			}
		}
	}

	def vp9ClipAdd(p uint16[], at int, v int, maxv int) {
		let s = int(p[at]) + v
		p[at] = uint16(s < 0 ?? (0, s > maxv ?? (maxv, s)))
	}

	// The inverse Walsh-Hadamard transform of lossless frames, added to
	// the 4x4 samples at p[at].
	def vp9IwhtAdd(b int32[], p uint16[], at int, stride int, eob int, maxv int) {
		if eob <= 1 {
			let a1 = int(b[0]) >> 2
			let e1 = a1 >> 1
			a1 -= e1
			b[0] = int32(0)
			for let i = 0; i < 4; i++ {
				let v = i == 0 ?? (a1, e1)
				let e = v >> 1
				vp9ClipAdd(p, at + i, v - e, maxv)
				vp9ClipAdd(p, at + stride + i, e, maxv)
				vp9ClipAdd(p, at + 2 * stride + i, e, maxv)
				vp9ClipAdd(p, at + 3 * stride + i, e, maxv)
			}
			return
		}
		for let i = 0; i < 4; i++ {
			let a1 = int(b[i * 4]) >> 2
			let c1 = int(b[i * 4 + 1]) >> 2
			let d1 = int(b[i * 4 + 2]) >> 2
			let b1 = int(b[i * 4 + 3]) >> 2
			a1 += c1
			d1 -= b1
			let e1 = (a1 - d1) >> 1
			b1 = e1 - b1
			c1 = e1 - c1
			a1 -= b1
			d1 += c1
			b[i * 4] = int32(a1)
			b[i * 4 + 1] = int32(b1)
			b[i * 4 + 2] = int32(c1)
			b[i * 4 + 3] = int32(d1)
		}
		for let i = 0; i < 4; i++ {
			let a1 = int(b[i])
			let c1 = int(b[4 + i])
			let d1 = int(b[8 + i])
			let b1 = int(b[12 + i])
			a1 += c1
			d1 -= b1
			let e1 = (a1 - d1) >> 1
			b1 = e1 - b1
			c1 = e1 - c1
			a1 -= b1
			d1 += c1
			vp9ClipAdd(p, at + i, a1, maxv)
			vp9ClipAdd(p, at + stride + i, b1, maxv)
			vp9ClipAdd(p, at + 2 * stride + i, c1, maxv)
			vp9ClipAdd(p, at + 3 * stride + i, d1, maxv)
			b[i] = int32(0)
			b[4 + i] = int32(0)
			b[8 + i] = int32(0)
			b[12 + i] = int32(0)
		}
	}
}
