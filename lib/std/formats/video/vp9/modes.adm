internal partial module std.formats.video.vp9 {
	// The sub-block whose vector stands for a neighbour, by the block
	// being predicted and whether the neighbour is in the same column.
	const vp9IdxNColumnToSubblock = int[1, 2, 1, 3, 3, 2, 3, 3]

	// Packs a motion vector in 1/8 samples.
	def vp9Mv(row int, col int) int {
		return (row << 16) + (col & 0xFFFF)
	}

	def vp9MvRow(mv int) int {
		return mv >> 16
	}

	def vp9MvCol(mv int) int {
		return ((mv & 0xFFFF) ^ 0x8000) - 0x8000
	}

	// The segment of an intra frame's block.
	def vp9IntraSegment(t Vp9Tile) int {
		let h = t.h
		return 0 unless h.segEnabled
		if !h.segUpdateMap {
			vp9CopySegment(t)
			return 0
		}
		let seg = vp9ReadTree(t.r, vp9SegmentTree, h.segTreeProbs, 0)
		vp9SetSegment(t, seg)
		return seg
	}

	def vp9CopySegment(t Vp9Tile) {
		for let y = 0; y < t.yMis; y++ {
			for let x = 0; x < t.xMis; x++ {
				let c = t.cell + y * t.miCols + x
				t.segCur[c] = t.segLast[c]
			}
		}
	}

	def vp9SetSegment(t Vp9Tile, seg int) {
		for let y = 0; y < t.yMis; y++ {
			for let x = 0; x < t.xMis; x++ {
				t.segCur[t.cell + y * t.miCols + x] = byte(seg)
			}
		}
	}

	// The segment of an inter frame's block, predicted from the previous
	// frame's map where the frame says so.
	def vp9InterSegment(t Vp9Tile) int {
		let h = t.h
		return 0 unless h.segEnabled
		let predicted = 8
		for let y = 0; y < t.yMis; y++ {
			for let x = 0; x < t.xMis; x++ {
				predicted = vp9Min(predicted, int(t.segLast[t.cell + y * t.miCols + x]))
			}
		}
		if !h.segUpdateMap {
			vp9CopySegment(t)
			return predicted
		}
		let seg = 0
		if h.segTemporal {
			let ctx = 0
			ctx += int(t.miSegPred[t.cell - t.miCols]) when t.hasAbove
			ctx += int(t.miSegPred[t.cell - 1]) when t.hasLeft
			t.segPred = t.r.bit(h.segPredProbs[ctx])
			seg = t.segPred != 0 ?? (predicted, vp9ReadTree(t.r, vp9SegmentTree, h.segTreeProbs, 0))
		} else {
			seg = vp9ReadTree(t.r, vp9SegmentTree, h.segTreeProbs, 0)
		}
		vp9SetSegment(t, seg)
		return seg
	}

	def vp9ReadSkip(t Vp9Tile) bool {
		return true when t.h.segActive(t.seg, vp9SegSkip)
		let ctx = 0
		ctx += int(t.miSkip[t.cell - t.miCols]) when t.hasAbove
		ctx += int(t.miSkip[t.cell - 1]) when t.hasLeft
		let skip = t.r.bit(t.fc[vp9PSkip + ctx])
		t.cnt[vp9CSkip + ctx * 2 + skip]++
		return skip != 0
	}

	def vp9ReadTxSize(t Vp9Tile, allowSelect bool) int {
		let maxTx = vp9MaxTxSize[t.bsize]
		return vp9Min(maxTx, vp9Min(t.h.txMode, 3)) when !allowSelect || t.h.txMode != vp9TxModeSelect || t.bsize < vp9Block8x8
		let above = maxTx
		let left = maxTx
		above = int(t.miTx[t.cell - t.miCols]) when t.hasAbove && t.miSkip[t.cell - t.miCols] == 0
		left = int(t.miTx[t.cell - 1]) when t.hasLeft && t.miSkip[t.cell - 1] == 0
		left = above unless t.hasLeft
		above = left unless t.hasAbove
		let ctx = above + left > maxTx ?? (1, 0)
		let p = vp9PTx8 + ctx
		let c = vp9CTx8 + ctx * 2
		if maxTx == 2 {
			p = vp9PTx16 + ctx * 2
			c = vp9CTx16 + ctx * 3
		} else if maxTx == 3 {
			p = vp9PTx32 + ctx * 3
			c = vp9CTx32 + ctx * 4
		}
		let tx = t.r.bit(t.fc[p])
		if tx != 0 && maxTx >= 2 {
			tx += t.r.bit(t.fc[p + 1])
			tx += t.r.bit(t.fc[p + 2]) when tx != 1 && maxTx >= 3
		}
		t.cnt[c + tx]++
		return tx
	}

	// The luma mode above 4x4 block `b` of the block in progress, for the
	// mode probabilities of intra frames.
	def vp9AboveMode(t Vp9Tile, b int) int {
		return t.bmode[b - 2] when b >= 2
		return vp9DcPred unless t.hasAbove
		return int(t.miBMode[(t.cell - t.miCols) * 4 + b + 2])
	}

	def vp9LeftMode(t Vp9Tile, b int) int {
		return t.bmode[b - 1] when (b & 1) != 0
		return vp9DcPred unless t.hasLeft
		return int(t.miBMode[(t.cell - 1) * 4 + b + 1])
	}

	def vp9KfMode(t Vp9Tile, b int) int {
		return vp9ReadTree(t.r, vp9IntraModeTree, vp9KfYModeProb, (vp9AboveMode(t, b) * 10 + vp9LeftMode(t, b)) * 9)
	}

	// Reads the modes of a block of a key or intra-only frame.
	def vp9IntraFrameModes(t Vp9Tile) {
		t.segPred = 0
		t.seg = vp9IntraSegment(t)
		t.skip = vp9ReadSkip(t)
		t.tx = vp9ReadTxSize(t, true)
		t.ref0 = 0
		t.ref1 = -1
		t.filter = 3
		let bm = t.bmode
		if t.bsize == 0 {
			for let i = 0; i < 4; i++ {
				bm[i] = vp9KfMode(t, i)
			}
		} else if t.bsize == 1 {
			bm[0] = vp9KfMode(t, 0)
			bm[2] = bm[0]
			bm[1] = vp9KfMode(t, 1)
			bm[3] = bm[1]
		} else if t.bsize == 2 {
			bm[0] = vp9KfMode(t, 0)
			bm[1] = bm[0]
			bm[2] = vp9KfMode(t, 2)
			bm[3] = bm[2]
		} else {
			bm[0] = vp9KfMode(t, 0)
			bm[1] = bm[0]
			bm[2] = bm[0]
			bm[3] = bm[0]
		}
		t.mode = bm[3]
		t.uvMode = vp9ReadTree(t.r, vp9IntraModeTree, vp9KfUvModeProb, t.mode * 9)
		t.bmv.fill(0)
	}

	def vp9IfMode(t Vp9Tile, group int) int {
		let m = vp9ReadTree(t.r, vp9IntraModeTree, t.fc, vp9PY + group * 9)
		t.cnt[vp9CY + group * 10 + m]++
		return m
	}

	// Reads the modes of an intra block of an inter frame.
	def vp9IntraBlockModes(t Vp9Tile) {
		let bm = t.bmode
		if t.bsize == 0 {
			for let i = 0; i < 4; i++ {
				bm[i] = vp9IfMode(t, 0)
			}
		} else if t.bsize == 1 {
			bm[0] = vp9IfMode(t, 0)
			bm[2] = bm[0]
			bm[1] = vp9IfMode(t, 0)
			bm[3] = bm[1]
		} else if t.bsize == 2 {
			bm[0] = vp9IfMode(t, 0)
			bm[1] = bm[0]
			bm[2] = vp9IfMode(t, 0)
			bm[3] = bm[2]
		} else {
			bm[0] = vp9IfMode(t, vp9SizeGroup[t.bsize])
			bm[1] = bm[0]
			bm[2] = bm[0]
			bm[3] = bm[0]
		}
		t.mode = bm[3]
		t.uvMode = vp9ReadTree(t.r, vp9IntraModeTree, t.fc, vp9PUv + t.mode * 9)
		t.cnt[vp9CUv + t.mode * 10 + t.uvMode]++
		t.filter = 3
		t.ref0 = 0
		t.ref1 = -1
		t.bmv.fill(0)
	}

	// Reads the modes of a block of an inter frame.
	def vp9InterFrameModes(t Vp9Tile) {
		t.segPred = 0
		t.seg = vp9InterSegment(t)
		t.skip = vp9ReadSkip(t)
		let inter = false
		if t.h.segActive(t.seg, vp9SegRef) {
			inter = t.h.segData[t.seg * 4 + vp9SegRef] != 0
		} else {
			let ctx = 0
			let aIntra = t.hasAbove && t.miRef0[t.cell - t.miCols] <= 0
			let lIntra = t.hasLeft && t.miRef0[t.cell - 1] <= 0
			if t.hasAbove && t.hasLeft {
				ctx = (aIntra && lIntra) ?? (3, (aIntra || lIntra) ?? (1, 0))
			} else if t.hasAbove || t.hasLeft {
				ctx = (aIntra || lIntra) ?? (2, 0)
			}
			let bit = t.r.bit(t.fc[vp9PIntraInter + ctx])
			t.cnt[vp9CIntraInter + ctx * 2 + bit]++
			inter = bit != 0
		}
		t.tx = vp9ReadTxSize(t, !t.skip || !inter)
		if inter {
			vp9InterBlockModes(t)
		} else {
			vp9IntraBlockModes(t)
		}
	}

	// The references of the neighbours, for the reference contexts: per
	// neighbour (above, left) whether it exists, is intra, has two
	// references, and the two references.
	def vp9RefFrames(t Vp9Tile) {
		let h = t.h
		if h.segActive(t.seg, vp9SegRef) {
			t.ref0 = h.segData[t.seg * 4 + vp9SegRef]
			t.ref1 = -1
			return
		}
		let hasA = t.hasAbove
		let hasL = t.hasLeft
		let a0 = hasA ?? (int(t.miRef0[t.cell - t.miCols]), 0)
		let a1 = hasA ?? (int(t.miRef1[t.cell - t.miCols]), 0)
		let l0 = hasL ?? (int(t.miRef0[t.cell - 1]), 0)
		let l1 = hasL ?? (int(t.miRef1[t.cell - 1]), 0)
		let aIntra = a0 <= 0
		let lIntra = l0 <= 0
		let a2 = a1 > 0
		let l2 = l1 > 0
		let compound = h.refMode == vp9RefCompound
		if h.refMode == vp9RefSelect {
			let ctx = 1
			if hasA && hasL {
				if !a2 && !l2 {
					ctx = ((a0 == h.compFixed) != (l0 == h.compFixed)) ?? (1, 0)
				} else if !a2 {
					ctx = 2 + ((a0 == h.compFixed || aIntra) ?? (1, 0))
				} else if !l2 {
					ctx = 2 + ((l0 == h.compFixed || lIntra) ?? (1, 0))
				} else {
					ctx = 4
				}
			} else if hasA || hasL {
				let e0 = hasA ?? (a0, l0)
				let e2 = hasA ?? (a2, l2)
				ctx = e2 ?? (3, e0 == h.compFixed ?? (1, 0))
			}
			let bit = t.r.bit(t.fc[vp9PCompInter + ctx])
			t.cnt[vp9CCompInter + ctx * 2 + bit]++
			compound = bit != 0
		}
		if compound {
			let fixIdx = h.signBias[h.compFixed]
			let varIdx = 1 - fixIdx
			let var1 = h.compVar[1]
			let ctx = 2
			if hasA && hasL {
				if aIntra && lIntra {
					ctx = 2
				} else if aIntra || lIntra {
					let e0 = aIntra ?? (l0, a0)
					let e1 = aIntra ?? (l1, a1)
					let e2 = aIntra ?? (l2, a2)
					let v = e2 ?? (varIdx == 0 ?? (e0, e1), e0)
					ctx = 1 + 2 * (v != var1 ?? (1, 0))
				} else {
					let vrfa = a2 ?? (varIdx == 0 ?? (a0, a1), a0)
					let vrfl = l2 ?? (varIdx == 0 ?? (l0, l1), l0)
					if vrfa == vrfl && var1 == vrfa {
						ctx = 0
					} else if !l2 && !a2 {
						if (vrfa == h.compFixed && vrfl == h.compVar[0]) || (vrfl == h.compFixed && vrfa == h.compVar[0]) {
							ctx = 4
						} else if vrfa == vrfl {
							ctx = 3
						} else {
							ctx = 1
						}
					} else if !l2 || !a2 {
						let vrfc = !l2 ?? (vrfa, vrfl)
						let rfs = !a2 ?? (vrfa, vrfl)
						if vrfc == var1 && rfs != var1 {
							ctx = 1
						} else if rfs == var1 && vrfc != var1 {
							ctx = 2
						} else {
							ctx = 4
						}
					} else if vrfa == vrfl {
						ctx = 4
					} else {
						ctx = 2
					}
				}
			} else if hasA || hasL {
				let e0 = hasA ?? (a0, l0)
				let e1 = hasA ?? (a1, l1)
				if e0 <= 0 {
					ctx = 2
				} else if e1 > 0 {
					ctx = 4 * ((varIdx == 0 ?? (e0, e1)) != var1 ?? (1, 0))
				} else {
					ctx = 3 * (e0 != var1 ?? (1, 0))
				}
			}
			let bit = t.r.bit(t.fc[vp9PCompRef + ctx])
			t.cnt[vp9CCompRef + ctx * 2 + bit]++
			if fixIdx == 0 {
				t.ref0 = h.compFixed
				t.ref1 = h.compVar[bit]
			} else {
				t.ref1 = h.compFixed
				t.ref0 = h.compVar[bit]
			}
			return
		}
		let ctx0 = vp9SingleRefCtx1(hasA, hasL, a0, a1, l0, l1)
		let bit0 = t.r.bit(t.fc[vp9PSingleRef + ctx0 * 2])
		t.cnt[vp9CSingleRef + (ctx0 * 2) * 2 + bit0]++
		t.ref1 = -1
		if bit0 == 0 {
			t.ref0 = 1
			return
		}
		let ctx1 = vp9SingleRefCtx2(hasA, hasL, a0, a1, l0, l1)
		let bit1 = t.r.bit(t.fc[vp9PSingleRef + ctx1 * 2 + 1])
		t.cnt[vp9CSingleRef + (ctx1 * 2 + 1) * 2 + bit1]++
		t.ref0 = bit1 != 0 ?? (3, 2)
	}

	def vp9B(v bool) int {
		return v ?? (1, 0)
	}

	// Context of the bit that tells LAST from the other references.
	def vp9SingleRefCtx1(hasA bool, hasL bool, a0 int, a1 int, l0 int, l1 int) int {
		if hasA && hasL {
			let aIntra = a0 <= 0
			let lIntra = l0 <= 0
			return 2 when aIntra && lIntra
			if aIntra || lIntra {
				let e0 = aIntra ?? (l0, a0)
				let e1 = aIntra ?? (l1, a1)
				return 4 * vp9B(e0 == 1) when e1 <= 0
				return 1 + vp9B(e0 == 1 || e1 == 1)
			}
			let a2 = a1 > 0
			let l2 = l1 > 0
			return 1 + vp9B(a0 == 1 || a1 == 1 || l0 == 1 || l1 == 1) when a2 && l2
			if a2 || l2 {
				let rfs = !a2 ?? (a0, l0)
				let crf1 = a2 ?? (a0, l0)
				let crf2 = a2 ?? (a1, l1)
				return 3 + vp9B(crf1 == 1 || crf2 == 1) when rfs == 1
				return vp9B(crf1 == 1 || crf2 == 1)
			}
			return 2 * vp9B(a0 == 1) + 2 * vp9B(l0 == 1)
		}
		if hasA || hasL {
			let e0 = hasA ?? (a0, l0)
			let e1 = hasA ?? (a1, l1)
			return 2 when e0 <= 0
			return 4 * vp9B(e0 == 1) when e1 <= 0
			return 1 + vp9B(e0 == 1 || e1 == 1)
		}
		return 2
	}

	// Context of the bit that tells GOLDEN from ALTREF.
	def vp9SingleRefCtx2(hasA bool, hasL bool, a0 int, a1 int, l0 int, l1 int) int {
		if hasA && hasL {
			let aIntra = a0 <= 0
			let lIntra = l0 <= 0
			return 2 when aIntra && lIntra
			if aIntra || lIntra {
				let e0 = aIntra ?? (l0, a0)
				let e1 = aIntra ?? (l1, a1)
				if e1 <= 0 {
					return 3 when e0 == 1
					return 4 * vp9B(e0 == 2)
				}
				return 1 + 2 * vp9B(e0 == 2 || e1 == 2)
			}
			let a2 = a1 > 0
			let l2 = l1 > 0
			if a2 && l2 {
				return 3 * vp9B(a0 == 2 || a1 == 2 || l0 == 2 || l1 == 2) when a0 == l0 && a1 == l1
				return 2
			}
			if a2 || l2 {
				let rfs = !a2 ?? (a0, l0)
				let crf1 = a2 ?? (a0, l0)
				let crf2 = a2 ?? (a1, l1)
				return 3 + vp9B(crf1 == 2 || crf2 == 2) when rfs == 2
				return vp9B(crf1 == 2 || crf2 == 2) when rfs == 3
				return 1 + 2 * vp9B(crf1 == 2 || crf2 == 2)
			}
			return 3 when a0 == 1 && l0 == 1
			if a0 == 1 || l0 == 1 {
				let edge0 = a0 == 1 ?? (l0, a0)
				return 4 * vp9B(edge0 == 2)
			}
			return 2 * vp9B(a0 == 2) + 2 * vp9B(l0 == 2)
		}
		if hasA || hasL {
			let e0 = hasA ?? (a0, l0)
			let e1 = hasA ?? (a1, l1)
			return 2 when e0 <= 0 || (e0 == 1 && e1 <= 0)
			return 4 * vp9B(e0 == 2) when e1 <= 0
			return 3 * vp9B(e0 == 2 || e1 == 2)
		}
		return 2
	}

	def vp9InterMode(t Vp9Tile, ctx int) int {
		let m = vp9ReadTree(t.r, vp9InterModeTree, t.fc, vp9PInterMode + ctx * 3)
		t.cnt[vp9CInterMode + ctx * 4 + m]++
		return vp9NearestMv + m
	}

	// Reads the references, modes and vectors of an inter block.
	def vp9InterBlockModes(t Vp9Tile) {
		let h = t.h
		vp9RefFrames(t)
		let refs = t.ref1 > 0 ?? (2, 1)
		// The inter mode context from the two nearest neighbours.
		let counter = 0
		for let i = 0; i < 2; i++ {
			let row = t.miRow + vp9MvRefBlocks[t.bsize * 16 + i * 2]
			let col = t.miCol + vp9MvRefBlocks[t.bsize * 16 + i * 2 + 1]
			continue when row < 0 || row >= t.miRows || col < t.colStart || col >= t.colEnd
			counter += vp9Mode2Counter[t.miMode[row * t.miCols + col]]
		}
		let modeCtx = vp9CounterToCtx[counter]
		t.mode = vp9ZeroMv
		if h.segActive(t.seg, vp9SegSkip) {
			if t.bsize < vp9Block8x8 {
				t.bad = true
				return
			}
		} else if t.bsize >= vp9Block8x8 {
			t.mode = vp9InterMode(t, modeCtx)
		}
		t.filter = h.interpFilter
		if h.interpFilter == vp9FilterSwitchable {
			let left = t.hasLeft ?? (int(t.miFilter[t.cell - 1]), 3)
			let above = t.hasAbove ?? (int(t.miFilter[t.cell - t.miCols]), 3)
			let ctx = 3
			if left == above {
				ctx = left
			} else if left == 3 {
				ctx = above
			} else if above == 3 {
				ctx = left
			}
			t.filter = vp9ReadTree(t.r, vp9InterpTree, t.fc, vp9PInterp + ctx * 2)
			t.cnt[vp9CInterp + ctx * 3 + t.filter]++
		}
		let bm = t.bmode
		let bmv = t.bmv
		let best0 = 0
		let best1 = 0
		if t.bsize < vp9Block8x8 {
			let gotNew = false
			let bMode = vp9ZeroMv
			let sub0 = 0
			let sub1 = 0
			for let idy = 0; idy < 2; idy += t.subH {
				for let idx = 0; idx < 2; idx += t.subW {
					let j = idy * 2 + idx
					bMode = vp9InterMode(t, modeCtx)
					if bMode := vp9NearestMv || vp9NearMv {
						sub0 = vp9Sub8x8Mv(t, bMode, j, 0)
						sub1 = vp9Sub8x8Mv(t, bMode, j, 1) when refs == 2
					} else if bMode == vp9NewMv && !gotNew {
						vp9FindMvRefs(t, vp9NewMv, t.ref0, -1)
						best0 = vp9LowerPrecision(t.mvList[0], h.allowHp)
						if refs == 2 {
							vp9FindMvRefs(t, vp9NewMv, t.ref1, -1)
							best1 = vp9LowerPrecision(t.mvList[0], h.allowHp)
						}
						gotNew = true
					}
					if bMode == vp9NewMv {
						bmv[j * 2] = vp9ReadMv(t, best0)
						bmv[j * 2 + 1] = vp9ReadMv(t, best1) when refs == 2
					} else if bMode == vp9ZeroMv {
						bmv[j * 2] = 0
						bmv[j * 2 + 1] = 0
					} else {
						bmv[j * 2] = sub0
						bmv[j * 2 + 1] = sub1
					}
					return when t.bad
					if t.subH == 2 {
						bmv[(j + 2) * 2] = bmv[j * 2]
						bmv[(j + 2) * 2 + 1] = bmv[j * 2 + 1]
					}
					if t.subW == 2 {
						bmv[(j + 1) * 2] = bmv[j * 2]
						bmv[(j + 1) * 2 + 1] = bmv[j * 2 + 1]
					}
				}
			}
			t.mode = bMode
		} else {
			if t.mode != vp9ZeroMv {
				let n = vp9FindMvRefs(t, t.mode, t.ref0, -1)
				best0 = vp9LowerPrecision(t.mvList[n - 1], h.allowHp)
				if refs == 2 {
					n = vp9FindMvRefs(t, t.mode, t.ref1, -1)
					best1 = vp9LowerPrecision(t.mvList[n - 1], h.allowHp)
				}
			}
			let mv0 = 0
			let mv1 = 0
			if t.mode == vp9NewMv {
				mv0 = vp9ReadMv(t, best0)
				mv1 = vp9ReadMv(t, best1) when refs == 2
			} else if t.mode != vp9ZeroMv {
				mv0 = best0
				mv1 = best1
			}
			for let b = 0; b < 4; b++ {
				bmv[b * 2] = mv0
				bmv[b * 2 + 1] = mv1
			}
		}
		// Inter blocks count as DC for the mode contexts of intra blocks.
		bm.fill(vp9DcPred)
	}

	// Drops the 1/8 sample bit of a vector that may not carry it.
	def vp9LowerPrecision(mv int, allowHp bool) int {
		let row = vp9MvRow(mv)
		let col = vp9MvCol(mv)
		return mv when allowHp && vp9UseHp(row, col)
		row += row > 0 ?? (-1, 1) when (row & 1) != 0
		col += col > 0 ?? (-1, 1) when (col & 1) != 0
		return vp9Mv(row, col)
	}

	def vp9UseHp(row int, col int) bool {
		return (row.abs() >> 3) < 8 && (col.abs() >> 3) < 8
	}

	// Reads a vector coded as a difference from `ref`.
	def vp9ReadMv(t Vp9Tile, ref int) int {
		let joint = vp9ReadTree(t.r, vp9MvJointTree, t.fc, vp9PMv)
		let refRow = vp9MvRow(ref)
		let refCol = vp9MvCol(ref)
		let useHp = t.h.allowHp && vp9UseHp(refRow, refCol)
		t.cnt[vp9CMvJoint + joint]++
		let row = refRow
		let col = refCol
		row += vp9ReadMvComponent(t, 0, useHp) when joint >= 2
		col += vp9ReadMvComponent(t, 1, useHp) when (joint & 1) != 0
		t.bad = true unless row > -16384 && row < 16383 && col > -16384 && col < 16383
		return vp9Mv(row, col)
	}

	def vp9ReadMvComponent(t Vp9Tile, comp int, useHp bool) int {
		let r = t.r
		let fc = t.fc
		let p = vp9PMv + 3 + comp * 33
		let c = vp9CMvComp + comp * 51
		let sign = r.bit(fc[p])
		let cls = vp9ReadTree(r, vp9MvClassTree, fc, p + 1)
		let d = 0
		let mag = 0
		let fr = 0
		let hp = 1
		t.cnt[c + sign]++
		t.cnt[c + 2 + cls]++
		if cls == 0 {
			d = r.bit(fc[p + 11])
			fr = vp9ReadTree(r, vp9MvFpTree, fc, p + 22 + d * 3)
			hp = r.bit(fc[p + 31]) when useHp
			t.cnt[c + 13 + d]++
			t.cnt[c + 35 + d * 4 + fr]++
			t.cnt[c + 47 + hp]++
		} else {
			for let i = 0; i < cls; i++ {
				let bit = r.bit(fc[p + 12 + i])
				d = d | (bit << i)
				t.cnt[c + 15 + i * 2 + bit]++
			}
			mag = 2 << (cls + 2)
			fr = vp9ReadTree(r, vp9MvFpTree, fc, p + 28)
			hp = r.bit(fc[p + 32]) when useHp
			t.cnt[c + 43 + fr]++
			t.cnt[c + 49 + hp]++
		}
		mag += ((d << 3) | (fr << 1) | hp) + 1
		return sign != 0 ?? (0 - mag, mag)
	}

	// Adds a candidate to the list; true when the search is over.
	def vp9AddMv(t Vp9Tile, mv int, count int, earlyBreak bool) (int, bool) {
		if count != 0 {
			return (count, false) when mv == t.mvList[0]
			t.mvList[count] = mv
			return (count + 1, true)
		}
		t.mvList[0] = mv
		return (1, earlyBreak)
	}

	def vp9ClampMvRef(t Vp9Tile, mv int) int {
		let left = 0 - t.miCol * 64 - 128
		let right = (t.miCols - t.bw - t.miCol) * 64 + 128
		let top = 0 - t.miRow * 64 - 128
		let bottom = (t.miRows - t.bh - t.miRow) * 64 + 128
		return vp9Mv(vp9Clamp(vp9MvRow(mv), top, bottom), vp9Clamp(vp9MvCol(mv), left, right))
	}

	// Builds the candidate list of vectors predicting reference `ref` of
	// the block in progress (4x4 block `block` of it, or -1) in
	// `t.mvList`; returns how many the mode uses.
	def vp9FindMvRefs(t Vp9Tile, mode int, ref int, block int) int {
		let earlyBreak = mode != vp9NearMv
		let list = t.mvList
		list[0] = 0
		list[1] = 0
		let count = 0
		let done = false
		let differentFound = false
		let bias = t.h.signBias
		let at = t.bsize * 16
		for let i = 0; i < 8 && !done; i++ {
			let row = t.miRow + vp9MvRefBlocks[at + i * 2]
			let dcol = vp9MvRefBlocks[at + i * 2 + 1]
			let col = t.miCol + dcol
			continue when row < 0 || row >= t.miRows || col < t.colStart || col >= t.colEnd
			let c = row * t.miCols + col
			differentFound = true
			let sub = 3
			// Blocks of 8x8 and up keep their one pair of vectors in the
			// last sub-block's place only.
			sub = vp9IdxNColumnToSubblock[block * 2 + (dcol == 0 ?? (1, 0))] when block >= 0 && i < 2 && int(t.miSize[c]) < vp9Block8x8
			if int(t.miRef0[c]) == ref {
				(count, done) = vp9AddMv(t, int(t.miMv[c * 8 + sub * 2]), count, earlyBreak)
			} else if int(t.miRef1[c]) == ref {
				(count, done) = vp9AddMv(t, int(t.miMv[c * 8 + sub * 2 + 1]), count, earlyBreak)
			}
		}
		let prev = t.cell
		if !done && t.usePrev {
			if int(t.prevRef[prev * 2]) == ref {
				(count, done) = vp9AddMv(t, int(t.prevMv[prev * 2]), count, earlyBreak)
			} else if int(t.prevRef[prev * 2 + 1]) == ref {
				(count, done) = vp9AddMv(t, int(t.prevMv[prev * 2 + 1]), count, earlyBreak)
			}
		}
		if !done && differentFound {
			for let i = 0; i < 8 && !done; i++ {
				let row = t.miRow + vp9MvRefBlocks[at + i * 2]
				let col = t.miCol + vp9MvRefBlocks[at + i * 2 + 1]
				continue when row < 0 || row >= t.miRows || col < t.colStart || col >= t.colEnd
				let c = row * t.miCols + col
				let r0 = int(t.miRef0[c])
				let r1 = int(t.miRef1[c])
				continue when r0 <= 0
				let mv0 = int(t.miMv[c * 8 + 6])
				let mv1 = int(t.miMv[c * 8 + 7])
				(count, done) = vp9AddMv(t, vp9ScaleMv(mv0, bias[r0] != bias[ref]), count, earlyBreak) when r0 != ref
				(count, done) = vp9AddMv(t, vp9ScaleMv(mv1, bias[r1] != bias[ref]), count, earlyBreak) when !done && r1 > 0 && r1 != ref && mv1 != mv0
			}
		}
		if !done && t.usePrev {
			let r0 = int(t.prevRef[prev * 2])
			let r1 = int(t.prevRef[prev * 2 + 1])
			let mv0 = int(t.prevMv[prev * 2])
			let mv1 = int(t.prevMv[prev * 2 + 1])
			(count, done) = vp9AddMv(t, vp9ScaleMv(mv0, bias[r0] != bias[ref]), count, earlyBreak) when r0 != ref && r0 > 0
			(count, done) = vp9AddMv(t, vp9ScaleMv(mv1, bias[r1] != bias[ref]), count, earlyBreak) when !done && r1 > 0 && r1 != ref && mv1 != mv0
		}
		count = mode == vp9NearMv ?? (2, 1) unless done
		for let i = 0; i < count; i++ {
			list[i] = vp9ClampMvRef(t, list[i])
		}
		return count
	}

	// A neighbour's vector, mirrored when it points the other way in
	// time from the reference being predicted.
	def vp9ScaleMv(mv int, flip bool) int {
		return mv unless flip
		return vp9Mv(0 - vp9MvRow(mv), 0 - vp9MvCol(mv))
	}

	// The predicted vector of 4x4 block `block` for reference `ref` (0 or
	// 1) under mode NEARESTMV or NEARMV.
	def vp9Sub8x8Mv(t Vp9Tile, bMode int, block int, ref int) int {
		let frame = ref == 0 ?? (t.ref0, t.ref1)
		let bmv = t.bmv
		let list = t.mvList
		if block == 0 {
			let n = vp9FindMvRefs(t, bMode, frame, 0)
			return list[n - 1]
		}
		if block < 3 {
			return bmv[ref] when bMode == vp9NearestMv
			vp9FindMvRefs(t, bMode, frame, block)
			for let n = 0; n < 2; n++ {
				return list[n] when bmv[ref] != list[n]
			}
			return 0
		}
		return bmv[4 + ref] when bMode == vp9NearestMv
		return bmv[2 + ref] when bmv[4 + ref] != bmv[2 + ref]
		return bmv[ref] when bmv[4 + ref] != bmv[ref]
		vp9FindMvRefs(t, bMode, frame, block)
		for let n = 0; n < 2; n++ {
			return list[n] when bmv[4 + ref] != list[n]
		}
		return 0
	}
}
