internal partial module std.formats.video.vp9 {
	// Offsets into a probability context (`Vp9Tile.fc`, `Vp9Decoder.fc`):
	// one flat array, so a context is saved and loaded by copying it.
	const (
		vp9PY          = 0
		vp9PUv         = 36
		vp9PPartition  = 126
		// [transform][plane type][inter][band][context][node], 432 each.
		vp9PCoef       = 174
		vp9PInterp     = 1902
		vp9PInterMode  = 1910
		vp9PIntraInter = 1931
		vp9PCompInter  = 1935
		vp9PSingleRef  = 1940
		vp9PCompRef    = 1950
		vp9PTx32       = 1955
		vp9PTx16       = 1961
		vp9PTx8        = 1965
		vp9PSkip       = 1967
		// Joints[3], then 33 per component (see `vp9DefaultMvProb`).
		vp9PMv         = 1970
		vp9ProbSize    = 2039
	)

	// Offsets into the symbol counts of a frame, laid out like the
	// probabilities with one slot per symbol instead of per tree node.
	const (
		vp9CY          = 0
		vp9CUv         = 40
		vp9CPartition  = 140
		// [transform][plane type][inter][band][context][4], 576 each.
		vp9CCoef       = 204
		// Blocks that tested for the end at each position, 144 each.
		vp9CEob        = 2508
		vp9CInterp     = 3084
		vp9CInterMode  = 3096
		vp9CIntraInter = 3124
		vp9CCompInter  = 3132
		vp9CSingleRef  = 3142
		vp9CCompRef    = 3162
		vp9CTx32       = 3172
		vp9CTx16       = 3180
		vp9CTx8        = 3186
		vp9CSkip       = 3190
		vp9CMvJoint    = 3196
		// 51 per component: sign[2], classes[11], class0[2], bits[10][2],
		// class0_fp[2][4], fp[4], class0_hp[2], hp[2].
		vp9CMvComp     = 3200
		vp9CountSize   = 3302
	)

	// The coding trees: per node two entries, a positive one the next
	// node, zero or negative the symbol negated.
	const vp9IntraModeTree = int[0, 2, -9, 4, -1, 6, 8, 12, -2, 10, -4, -5, -3, 14, -8, 16, -6, -7]
	const vp9InterModeTree = int[-2, 2, 0, 4, -1, -3]
	const vp9PartitionTree = int[0, 2, -1, 4, -2, -3]
	const vp9InterpTree = int[0, 2, -1, -2]
	const vp9SegmentTree = int[2, 4, 6, 8, 10, 12, 0, -1, -2, -3, -4, -5, -6, -7]
	const vp9MvJointTree = int[0, 2, -1, 4, -2, -3]
	const vp9MvClassTree = int[0, 2, -1, 4, 6, 8, -2, -3, 10, 12, -4, -5, -6, 14, 16, 18, -7, -8, -9, -10]
	const vp9MvClass0Tree = int[0, -1]
	const vp9MvFpTree = int[0, 2, -1, 4, -2, -3]

	// The adaptation weight of a mode or vector probability by the number
	// of symbols counted, up to 20.
	const vp9ModeUpdateFactor = int[0, 6, 12, 19, 25, 32, 38, 44, 51, 57, 64, 70, 76, 83, 89, 96, 102, 108, 115, 121, 128]

	// Reads a symbol of `tree` with the node probabilities at p[at:].
	def vp9ReadTree(r Vp9Bool, tree int[], p int[], at int) int {
		let i = 0
		for {
			i = tree[i + r.bit(p[at + (i >> 1)])]
			break when i <= 0
		}
		return 0 - i
	}

	// Loads the default probabilities into `fc`.
	def vp9DefaultProbs(fc int[]) {
		vp9Copy(fc, vp9PY, vp9DefaultYModeProb, 36)
		vp9Copy(fc, vp9PUv, vp9DefaultUvModeProb, 90)
		vp9Copy(fc, vp9PPartition, vp9DefaultPartitionProb, 48)
		vp9Copy(fc, vp9PCoef, vp9DefaultCoefProb4, 432)
		vp9Copy(fc, vp9PCoef + 432, vp9DefaultCoefProb8, 432)
		vp9Copy(fc, vp9PCoef + 864, vp9DefaultCoefProb16, 432)
		vp9Copy(fc, vp9PCoef + 1296, vp9DefaultCoefProb32, 432)
		vp9Copy(fc, vp9PInterp, vp9DefaultInterpProb, 8)
		vp9Copy(fc, vp9PInterMode, vp9DefaultInterModeProb, 21)
		vp9Copy(fc, vp9PIntraInter, vp9DefaultIntraInterProb, 4)
		vp9Copy(fc, vp9PCompInter, vp9DefaultCompInterProb, 5)
		vp9Copy(fc, vp9PSingleRef, vp9DefaultSingleRefProb, 10)
		vp9Copy(fc, vp9PCompRef, vp9DefaultCompRefProb, 5)
		vp9Copy(fc, vp9PTx32, vp9DefaultTxProb, 12)
		vp9Copy(fc, vp9PSkip, vp9DefaultSkipProb, 3)
		vp9Copy(fc, vp9PMv, vp9DefaultMvProb, 69)
	}

	def vp9Copy(dst int[], at int, src int[], n int) {
		for let i = 0; i < n; i++ {
			dst[at + i] = src[i]
		}
	}

	// Reads an optional delta-coded update of the probability at p[at].
	def vp9DiffUpdate(r Vp9Bool, p int[], at int) {
		return when r.bit(252) == 0
		let delp = 0
		if r.bit(128) == 0 {
			delp = r.literal(4)
		} else if r.bit(128) == 0 {
			delp = r.literal(4) + 16
		} else if r.bit(128) == 0 {
			delp = r.literal(5) + 32
		} else {
			let v = r.literal(7)
			delp = v < 65 ?? (v, (v << 1) - 65 + r.bit(128))
			delp += 64
		}
		// A delta past the table is a damaged header; the last entry keeps
		// the probability in range.
		let v = vp9InvMap[delp > 254 ?? (254, delp)]
		let m = p[at] - 1
		if (m << 1) <= 255 {
			p[at] = 1 + vp9InvRecenter(v, m)
		} else {
			p[at] = 255 - vp9InvRecenter(v, 254 - m)
		}
	}

	def vp9InvRecenter(v int, m int) int {
		return v when v > 2 * m
		return (v & 1) != 0 ?? (m - ((v + 1) >> 1), m + (v >> 1))
	}

	def vp9MvUpdate(r Vp9Bool, p int[], at int, n int) {
		for let i = 0; i < n; i++ {
			p[at + i] = (r.literal(7) << 1) | 1 when r.bit(252) != 0
		}
	}

	// Reads the compressed header at data[start:stop] into the frame's
	// probabilities `fc` and the transform and reference modes of `h`.
	//
	// Fails when the partition is empty or its marker bit is set.
	def vp9CompressedHeader(h Vp9Header, r Vp9Bool, fc int[], data byte[], start int, stop int) !none {
		expects {
			assert r.start(data, start, stop) onerror fail "vp9: bad compressed header"
		}
		h.txMode = 0
		if !h.lossless {
			h.txMode = r.literal(2)
			h.txMode += r.bit(128) when h.txMode == 3
		}
		if h.txMode == vp9TxModeSelect {
			for let i = 0; i < 2; i++ {
				vp9DiffUpdate(r, fc, vp9PTx8 + i)
			}
			for let i = 0; i < 4; i++ {
				vp9DiffUpdate(r, fc, vp9PTx16 + i)
			}
			for let i = 0; i < 6; i++ {
				vp9DiffUpdate(r, fc, vp9PTx32 + i)
			}
		}
		let maxTx = h.txMode > 3 ?? (3, h.txMode)
		for let tx = 0; tx <= maxTx; tx++ {
			continue when r.bit(128) == 0
			for let i = 0; i < 24; i++ {
				let bands = (i % 6) == 0 ?? (3, 6)
				for let l = 0; l < bands; l++ {
					for let m = 0; m < 3; m++ {
						vp9DiffUpdate(r, fc, vp9PCoef + tx * 432 + i * 18 + l * 3 + m)
					}
				}
			}
		}
		for let k = 0; k < 3; k++ {
			vp9DiffUpdate(r, fc, vp9PSkip + k)
		}
		return none when h.intra()
		for let i = 0; i < 21; i++ {
			vp9DiffUpdate(r, fc, vp9PInterMode + i)
		}
		if h.interpFilter == vp9FilterSwitchable {
			for let i = 0; i < 8; i++ {
				vp9DiffUpdate(r, fc, vp9PInterp + i)
			}
		}
		for let i = 0; i < 4; i++ {
			vp9DiffUpdate(r, fc, vp9PIntraInter + i)
		}
		h.refMode = vp9RefSingle
		h.refMode = r.bit(128) != 0 ?? (r.bit(128) != 0 ?? (vp9RefSelect, vp9RefCompound), vp9RefSingle) when h.signBias[2] != h.signBias[1] || h.signBias[3] != h.signBias[1]
		h.setupCompound() when h.refMode != vp9RefSingle
		if h.refMode == vp9RefSelect {
			for let i = 0; i < 5; i++ {
				vp9DiffUpdate(r, fc, vp9PCompInter + i)
			}
		}
		if h.refMode != vp9RefCompound {
			for let i = 0; i < 10; i++ {
				vp9DiffUpdate(r, fc, vp9PSingleRef + i)
			}
		}
		if h.refMode != vp9RefSingle {
			for let i = 0; i < 5; i++ {
				vp9DiffUpdate(r, fc, vp9PCompRef + i)
			}
		}
		for let i = 0; i < 36; i++ {
			vp9DiffUpdate(r, fc, vp9PY + i)
		}
		for let i = 0; i < 48; i++ {
			vp9DiffUpdate(r, fc, vp9PPartition + i)
		}
		vp9MvUpdate(r, fc, vp9PMv, 3)
		for let i = 0; i < 2; i++ {
			// Sign, classes, class0 and bits lie in a row.
			vp9MvUpdate(r, fc, vp9PMv + 3 + i * 33, 22)
		}
		for let i = 0; i < 2; i++ {
			vp9MvUpdate(r, fc, vp9PMv + 3 + i * 33 + 22, 9)
		}
		if h.allowHp {
			for let i = 0; i < 2; i++ {
				vp9MvUpdate(r, fc, vp9PMv + 3 + i * 33 + 31, 2)
			}
		}
		return none
	}

	def vp9Weighted(pre int, prob int, factor int) int {
		return (pre * (256 - factor) + prob * factor + 128) >> 8
	}

	def vp9Prob(num int, den int) int {
		let p = (num * 256 + (den >> 1)) / den
		return 255 when p > 255
		return 1 when p < 1
		return p
	}

	// The probability `pre` moved towards the counts c0 : c1 of its two
	// branches, as coefficient probabilities adapt.
	def vp9MergeCoef(pre int, c0 int, c1 int, sat int, maxFactor int) int {
		let den = c0 + c1
		let prob = den == 0 ?? (128, vp9Prob(c0, den))
		let count = den < sat ?? (den, sat)
		return vp9Weighted(pre, prob, maxFactor * count / sat)
	}

	// The same for mode and motion vector probabilities.
	def vp9MergeMode(pre int, c0 int, c1 int) int {
		let den = c0 + c1
		return pre when den == 0
		return vp9Weighted(pre, vp9Prob(c0, den), vp9ModeUpdateFactor[den < 20 ?? (den, 20)])
	}

	// Adapts the node probabilities of `tree` from the symbol counts at
	// cnt[cat:]; returns the count below node `i`.
	def vp9MergeTree(tree int[], i int, pre int[], fc int[], pat int, cnt int[], cat int) int {
		let l = tree[i]
		let left = 0
		if l > 0 {
			left = vp9MergeTree(tree, l, pre, fc, pat, cnt, cat)
		} else {
			left = cnt[cat - l]
		}
		let r = tree[i + 1]
		let right = 0
		if r > 0 {
			right = vp9MergeTree(tree, r, pre, fc, pat, cnt, cat)
		} else {
			right = cnt[cat - r]
		}
		fc[pat + (i >> 1)] = vp9MergeMode(pre[pat + (i >> 1)], left, right)
		return left + right
	}

	// Backward adaptation of the coefficient probabilities: `fc` from the
	// context `pre` the frame loaded and the counts `cnt` of its tiles.
	def vp9AdaptCoef(pre int[], fc int[], cnt int[], maxFactor int) {
		for let i = 0; i < 4 * 24; i++ {
			let bands = (i % 6) == 0 ?? (3, 6)
			for let l = 0; l < bands; l++ {
				let c = vp9CCoef + (i * 6 + l) * 4
				let n0 = cnt[c]
				let n1 = cnt[c + 1]
				let n2 = cnt[c + 2]
				let neob = cnt[c + 3]
				let p = vp9PCoef + i * 18 + l * 3
				fc[p] = vp9MergeCoef(pre[p], neob, cnt[vp9CEob + i * 6 + l] - neob, 24, maxFactor)
				fc[p + 1] = vp9MergeCoef(pre[p + 1], n0, n1 + n2, 24, maxFactor)
				fc[p + 2] = vp9MergeCoef(pre[p + 2], n1, n2, 24, maxFactor)
			}
		}
	}

	// Backward adaptation of the mode and motion vector probabilities of
	// an inter frame.
	def vp9AdaptModes(h Vp9Header, pre int[], fc int[], cnt int[]) {
		for let i = 0; i < 4; i++ {
			fc[vp9PIntraInter + i] = vp9MergeMode(pre[vp9PIntraInter + i], cnt[vp9CIntraInter + i * 2], cnt[vp9CIntraInter + i * 2 + 1])
		}
		for let i = 0; i < 5; i++ {
			fc[vp9PCompInter + i] = vp9MergeMode(pre[vp9PCompInter + i], cnt[vp9CCompInter + i * 2], cnt[vp9CCompInter + i * 2 + 1])
			fc[vp9PCompRef + i] = vp9MergeMode(pre[vp9PCompRef + i], cnt[vp9CCompRef + i * 2], cnt[vp9CCompRef + i * 2 + 1])
		}
		for let i = 0; i < 10; i++ {
			fc[vp9PSingleRef + i] = vp9MergeMode(pre[vp9PSingleRef + i], cnt[vp9CSingleRef + i * 2], cnt[vp9CSingleRef + i * 2 + 1])
		}
		for let i = 0; i < 7; i++ {
			vp9MergeTree(vp9InterModeTree, 0, pre, fc, vp9PInterMode + i * 3, cnt, vp9CInterMode + i * 4)
		}
		for let i = 0; i < 4; i++ {
			vp9MergeTree(vp9IntraModeTree, 0, pre, fc, vp9PY + i * 9, cnt, vp9CY + i * 10)
		}
		for let i = 0; i < 10; i++ {
			vp9MergeTree(vp9IntraModeTree, 0, pre, fc, vp9PUv + i * 9, cnt, vp9CUv + i * 10)
		}
		for let i = 0; i < 16; i++ {
			vp9MergeTree(vp9PartitionTree, 0, pre, fc, vp9PPartition + i * 3, cnt, vp9CPartition + i * 4)
		}
		if h.interpFilter == vp9FilterSwitchable {
			for let i = 0; i < 4; i++ {
				vp9MergeTree(vp9InterpTree, 0, pre, fc, vp9PInterp + i * 2, cnt, vp9CInterp + i * 3)
			}
		}
		if h.txMode == vp9TxModeSelect {
			for let i = 0; i < 2; i++ {
				let c8 = vp9CTx8 + i * 2
				fc[vp9PTx8 + i] = vp9MergeMode(pre[vp9PTx8 + i], cnt[c8], cnt[c8 + 1])
				let c16 = vp9CTx16 + i * 3
				let p16 = vp9PTx16 + i * 2
				fc[p16] = vp9MergeMode(pre[p16], cnt[c16], cnt[c16 + 1] + cnt[c16 + 2])
				fc[p16 + 1] = vp9MergeMode(pre[p16 + 1], cnt[c16 + 1], cnt[c16 + 2])
				let c32 = vp9CTx32 + i * 4
				let p32 = vp9PTx32 + i * 3
				fc[p32] = vp9MergeMode(pre[p32], cnt[c32], cnt[c32 + 1] + cnt[c32 + 2] + cnt[c32 + 3])
				fc[p32 + 1] = vp9MergeMode(pre[p32 + 1], cnt[c32 + 1], cnt[c32 + 2] + cnt[c32 + 3])
				fc[p32 + 2] = vp9MergeMode(pre[p32 + 2], cnt[c32 + 2], cnt[c32 + 3])
			}
		}
		for let i = 0; i < 3; i++ {
			fc[vp9PSkip + i] = vp9MergeMode(pre[vp9PSkip + i], cnt[vp9CSkip + i * 2], cnt[vp9CSkip + i * 2 + 1])
		}
		vp9MergeTree(vp9MvJointTree, 0, pre, fc, vp9PMv, cnt, vp9CMvJoint)
		for let i = 0; i < 2; i++ {
			let p = vp9PMv + 3 + i * 33
			let c = vp9CMvComp + i * 51
			fc[p] = vp9MergeMode(pre[p], cnt[c], cnt[c + 1])
			vp9MergeTree(vp9MvClassTree, 0, pre, fc, p + 1, cnt, c + 2)
			vp9MergeTree(vp9MvClass0Tree, 0, pre, fc, p + 11, cnt, c + 13)
			for let j = 0; j < 10; j++ {
				fc[p + 12 + j] = vp9MergeMode(pre[p + 12 + j], cnt[c + 15 + j * 2], cnt[c + 16 + j * 2])
			}
			for let j = 0; j < 2; j++ {
				vp9MergeTree(vp9MvFpTree, 0, pre, fc, p + 22 + j * 3, cnt, c + 35 + j * 4)
			}
			vp9MergeTree(vp9MvFpTree, 0, pre, fc, p + 28, cnt, c + 43)
			if h.allowHp {
				fc[p + 31] = vp9MergeMode(pre[p + 31], cnt[c + 47], cnt[c + 48])
				fc[p + 32] = vp9MergeMode(pre[p + 32], cnt[c + 49], cnt[c + 50])
			}
		}
	}
}
