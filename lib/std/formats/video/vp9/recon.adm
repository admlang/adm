internal partial module std.formats.video.vp9 {
	// What each intra mode reads: 1 the row above, 2 the column to the
	// left, 4 the row above and its continuation to the right.
	const vp9ModeNeeds = int[3, 1, 2, 4, 3, 3, 3, 2, 4, 3]

	// Where the edges of a block lie in `Vp9Tile.edge`: the row above
	// from its top-left neighbour on, and the left column.
	const vp9EdgeAbove = 16
	const vp9EdgeLeft = 96

	// Reconstructs the intra block in progress: per transform block the
	// prediction, then its residual. The planes go down as arguments: a
	// local chosen among them (`plane == 0 ?? (y, u)`) is retained and
	// released per block by the compiler today (docs/features/memory/todo.md);
	// keep this shape until that is gone.
	def vp9ReconIntraBlock(t Vp9Tile) {
		vp9ReconIntraPlane(t, 0, 0, 0, t.cur.y, t.cur.stride)
		vp9ReconIntraPlane(t, 1, t.h.ssx, t.h.ssy, t.cur.u, t.cur.cstride)
		vp9ReconIntraPlane(t, 2, t.h.ssx, t.h.ssy, t.cur.v, t.cur.cstride)
	}

	def vp9ReconIntraPlane(t Vp9Tile, plane int, ssx int, ssy int, p uint16[], stride int) {
		let toRight = (t.miCols - t.bw - t.miCol) * 64
		let toBottom = (t.miRows - t.bh - t.miRow) * 64
		let tx = plane == 0 ?? (t.tx, vp9UvTxSize[((t.bsize * 4 + t.tx) * 2 + ssx) * 2 + ssy])
		let n4w = (t.bw << 1) >> ssx
		let n4h = (t.bh << 1) >> ssy
		let step = 1 << tx
		let maxW = n4w + (toRight >= 0 ?? (0, toRight >> (5 + ssx)))
		let maxH = n4h + (toBottom >= 0 ?? (0, toBottom >> (5 + ssy)))
		let edgeW = toRight >= 0 ?? (0, maxW)
		let edgeH = toBottom >= 0 ?? (0, maxH)
		let x0 = (t.miCol * 8) >> ssx
		let y0 = (t.miRow * 8) >> ssy
		let frameW = (t.miCols * 8) >> ssx
		let frameH = (t.miRows * 8) >> ssy
		let transposed = vp9Transposed(t, tx)
		let lossless = t.h.lossless
		for let row = 0; row < maxH; row += step {
			for let col = 0; col < maxW; col += step {
				let mode = plane == 0 ?? (t.bsize < vp9Block8x8 ?? (t.bmode[row * 2 + col], t.mode), t.uvMode)
				let x = x0 + col * 4
				let y = y0 + row * 4
				vp9PredictIntra(t, p, stride, x, y, tx, mode, row != 0 || t.hasAbove, col != 0 || t.hasLeft, col + step < n4w, toRight < 0, toBottom < 0, frameW, frameH)
				continue when t.skip
				let txType = (plane != 0 || lossless || tx == 3) ?? (0, vp9ModeTxType[mode])
				let eob = vp9BlockTokens(t, plane, col, row, tx, txType, edgeW, edgeH, transposed)
				vp9InverseAdd(t, p, y * stride + x, stride, tx, txType, eob) when eob > 0
			}
		}
	}

	// Decodes and adds the residual of the inter block in progress;
	// returns the number of coefficient positions it coded.
	def vp9ReconInterBlock(t Vp9Tile) int {
		let total = vp9ReconInterPlane(t, 0, 0, 0, t.cur.y, t.cur.stride)
		total += vp9ReconInterPlane(t, 1, t.h.ssx, t.h.ssy, t.cur.u, t.cur.cstride)
		total += vp9ReconInterPlane(t, 2, t.h.ssx, t.h.ssy, t.cur.v, t.cur.cstride)
		return total
	}

	def vp9ReconInterPlane(t Vp9Tile, plane int, ssx int, ssy int, p uint16[], stride int) int {
		let toRight = (t.miCols - t.bw - t.miCol) * 64
		let toBottom = (t.miRows - t.bh - t.miRow) * 64
		let tx = plane == 0 ?? (t.tx, vp9UvTxSize[((t.bsize * 4 + t.tx) * 2 + ssx) * 2 + ssy])
		let n4w = (t.bw << 1) >> ssx
		let n4h = (t.bh << 1) >> ssy
		let step = 1 << tx
		let maxW = n4w + (toRight >= 0 ?? (0, toRight >> (5 + ssx)))
		let maxH = n4h + (toBottom >= 0 ?? (0, toBottom >> (5 + ssy)))
		let edgeW = toRight >= 0 ?? (0, maxW)
		let edgeH = toBottom >= 0 ?? (0, maxH)
		let x0 = (t.miCol * 8) >> ssx
		let y0 = (t.miRow * 8) >> ssy
		let transposed = vp9Transposed(t, tx)
		let total = 0
		for let row = 0; row < maxH; row += step {
			for let col = 0; col < maxW; col += step {
				let eob = vp9BlockTokens(t, plane, col, row, tx, 0, edgeW, edgeH, transposed)
				vp9InverseAdd(t, p, (y0 + row * 4) * stride + x0 + col * 4, stride, tx, 0, eob) when eob > 0
				total += eob
			}
		}
		return total
	}

	def vp9Avg2(a int, b int) int {
		return (a + b + 1) >> 1
	}

	def vp9Avg3(a int, b int, c int) int {
		return (a + 2 * b + c + 2) >> 2
	}

	// Predicts the 4 << tx samples square at (x, y) of plane `p` from the
	// samples above and to its left. `haveRight` says the row above
	// continues inside the block; `pastRight` and `pastBottom` that the
	// block reaches past the frame, whose plane is frameW x frameH.
	def vp9PredictIntra(t Vp9Tile, p uint16[], stride int, x int, y int, tx int, mode int, haveTop bool, haveLeft bool, haveRight bool, pastRight bool, pastBottom bool, frameW int, frameH int) {
		let bs = 4 << tx
		let e = t.edge
		let base = 1 << (t.h.bitDepth - 1)
		let maxv = (1 << t.h.bitDepth) - 1
		let needs = vp9ModeNeeds[mode]
		let at = y * stride + x
		let A = vp9EdgeAbove
		let L = vp9EdgeLeft
		if (needs & 2) != 0 {
			if haveLeft {
				let rows = bs
				rows = frameH - y when pastBottom && y + bs > frameH
				for let i = 0; i < rows; i++ {
					e[L + i] = p[at + i * stride - 1]
				}
				for let i = rows; i < bs; i++ {
					e[L + i] = e[L + rows - 1]
				}
			} else {
				for let i = 0; i < bs; i++ {
					e[L + i] = uint16(base + 1)
				}
			}
		}
		if (needs & 5) != 0 {
			let want = (needs & 4) != 0 ?? (2 * bs, bs)
			if haveTop {
				let ref = at - stride
				// Samples of the row above that are real: up to the frame
				// edge, and past the block only for a 4x4 block that has
				// a neighbour there.
				let real = bs
				real = 2 * bs when want > bs && bs == 4 && haveRight
				if pastRight {
					if x + bs <= frameW || want == bs {
						real = vp9Min(real, frameW - x)
					} else {
						real = frameW - x
					}
				}
				for let i = 0; i < real; i++ {
					e[A + i] = p[ref + i]
				}
				for let i = real; i < want; i++ {
					e[A + i] = e[A + real - 1]
				}
				e[A - 1] = haveLeft ?? (p[ref - 1], uint16(base + 1))
			} else {
				for let i = -1; i < want; i++ {
					e[A + i] = uint16(base - 1)
				}
			}
		}
		if mode == vp9DcPred {
			let sum = 0
			let count = 0
			if haveTop {
				for let i = 0; i < bs; i++ {
					sum += int(e[A + i])
				}
				count += bs
			}
			if haveLeft {
				for let i = 0; i < bs; i++ {
					sum += int(e[L + i])
				}
				count += bs
			}
			let dc = uint16(count == 0 ?? (base, (sum + (count >> 1)) / count))
			for let r = 0; r < bs; r++ {
				for let c = 0; c < bs; c++ {
					p[at + r * stride + c] = dc
				}
			}
		} else if mode == vp9VPred {
			for let r = 0; r < bs; r++ {
				for let c = 0; c < bs; c++ {
					p[at + r * stride + c] = e[A + c]
				}
			}
		} else if mode == vp9HPred {
			for let r = 0; r < bs; r++ {
				let v = e[L + r]
				for let c = 0; c < bs; c++ {
					p[at + r * stride + c] = v
				}
			}
		} else if mode == vp9TmPred {
			let tl = int(e[A - 1])
			for let r = 0; r < bs; r++ {
				let l = int(e[L + r]) - tl
				for let c = 0; c < bs; c++ {
					let v = l + int(e[A + c])
					p[at + r * stride + c] = uint16(v < 0 ?? (0, v > maxv ?? (maxv, v)))
				}
			}
		} else if mode == vp9D45Pred {
			for let r = 0; r < bs; r++ {
				for let c = 0; c < bs; c++ {
					let k = A + r + c
					let v = r + c + 2 < 2 * bs ?? (vp9Avg3(int(e[k]), int(e[k + 1]), int(e[k + 2])), int(e[A + 2 * bs - 1]))
					p[at + r * stride + c] = uint16(v)
				}
			}
		} else if mode == vp9D63Pred {
			for let r = 0; r < bs; r++ {
				for let c = 0; c < bs; c++ {
					let k = A + c + (r >> 1)
					let v = (r & 1) != 0 ?? (vp9Avg3(int(e[k]), int(e[k + 1]), int(e[k + 2])), vp9Avg2(int(e[k]), int(e[k + 1])))
					p[at + r * stride + c] = uint16(v)
				}
			}
		} else if mode == vp9D207Pred {
			for let r = 0; r < bs - 1; r++ {
				p[at + r * stride] = uint16(vp9Avg2(int(e[L + r]), int(e[L + r + 1])))
			}
			p[at + (bs - 1) * stride] = e[L + bs - 1]
			for let r = 0; r < bs - 2; r++ {
				p[at + r * stride + 1] = uint16(vp9Avg3(int(e[L + r]), int(e[L + r + 1]), int(e[L + r + 2])))
			}
			p[at + (bs - 2) * stride + 1] = uint16(vp9Avg3(int(e[L + bs - 2]), int(e[L + bs - 1]), int(e[L + bs - 1])))
			p[at + (bs - 1) * stride + 1] = e[L + bs - 1]
			for let c = 2; c < bs; c++ {
				p[at + (bs - 1) * stride + c] = e[L + bs - 1]
			}
			for let r = bs - 2; r >= 0; r-- {
				for let c = 2; c < bs; c++ {
					p[at + r * stride + c] = p[at + (r + 1) * stride + c - 2]
				}
			}
		} else if mode == vp9D117Pred {
			for let c = 0; c < bs; c++ {
				p[at + c] = uint16(vp9Avg2(int(e[A + c - 1]), int(e[A + c])))
			}
			p[at + stride] = uint16(vp9Avg3(int(e[L]), int(e[A - 1]), int(e[A])))
			for let c = 1; c < bs; c++ {
				p[at + stride + c] = uint16(vp9Avg3(int(e[A + c - 2]), int(e[A + c - 1]), int(e[A + c])))
			}
			p[at + 2 * stride] = uint16(vp9Avg3(int(e[A - 1]), int(e[L]), int(e[L + 1])))
			for let r = 3; r < bs; r++ {
				p[at + r * stride] = uint16(vp9Avg3(int(e[L + r - 3]), int(e[L + r - 2]), int(e[L + r - 1])))
			}
			for let r = 2; r < bs; r++ {
				for let c = 1; c < bs; c++ {
					p[at + r * stride + c] = p[at + (r - 2) * stride + c - 1]
				}
			}
		} else if mode == vp9D135Pred {
			// The border from the bottom-left to the top-right, filtered;
			// each row is a window of it.
			let b = t.pred
			for let i = 0; i < bs - 2; i++ {
				b[i] = uint16(vp9Avg3(int(e[L + bs - 3 - i]), int(e[L + bs - 2 - i]), int(e[L + bs - 1 - i])))
			}
			b[bs - 2] = uint16(vp9Avg3(int(e[A - 1]), int(e[L]), int(e[L + 1])))
			b[bs - 1] = uint16(vp9Avg3(int(e[L]), int(e[A - 1]), int(e[A])))
			b[bs] = uint16(vp9Avg3(int(e[A - 1]), int(e[A]), int(e[A + 1])))
			for let i = 0; i < bs - 2; i++ {
				b[bs + 1 + i] = uint16(vp9Avg3(int(e[A + i]), int(e[A + i + 1]), int(e[A + i + 2])))
			}
			for let r = 0; r < bs; r++ {
				for let c = 0; c < bs; c++ {
					p[at + r * stride + c] = b[bs - 1 - r + c]
				}
			}
		} else {
			p[at] = uint16(vp9Avg2(int(e[A - 1]), int(e[L])))
			for let r = 1; r < bs; r++ {
				p[at + r * stride] = uint16(vp9Avg2(int(e[L + r - 1]), int(e[L + r])))
			}
			p[at + 1] = uint16(vp9Avg3(int(e[L]), int(e[A - 1]), int(e[A])))
			p[at + stride + 1] = uint16(vp9Avg3(int(e[A - 1]), int(e[L]), int(e[L + 1])))
			for let r = 2; r < bs; r++ {
				p[at + r * stride + 1] = uint16(vp9Avg3(int(e[L + r - 2]), int(e[L + r - 1]), int(e[L + r])))
			}
			for let c = 2; c < bs; c++ {
				p[at + c] = uint16(vp9Avg3(int(e[A + c - 3]), int(e[A + c - 2]), int(e[A + c - 1])))
			}
			for let r = 1; r < bs; r++ {
				for let c = 2; c < bs; c++ {
					p[at + r * stride + c] = p[at + (r - 1) * stride + c - 2]
				}
			}
		}
	}
}
