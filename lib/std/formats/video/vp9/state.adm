internal partial module std.formats.video.vp9 {
	// A decoded frame and what later frames need of it.
	type Vp9Frame {
		y            uint16[]
		u            uint16[]
		v            uint16[]
		stride       int
		cstride      int
		// The frame's size; the planes hold whole superblocks.
		width        int
		height       int
		renderWidth  int
		renderHeight int
		bitDepth     int
		ssx          int
		ssy          int
		colorSpace   int
		fullRange    bool
		keyFrame     bool
		// References (2) and vectors (2) per 8x8 block, for the motion
		// vector prediction of the next frame.
		miCols       int
		miRows       int
		mvRef        int8[]
		mvs          int32[]
		valid        bool
		// Places of the decoder that hold the frame: reference slots, the
		// previous frame, the picture a packet is about to show.
		uses         int

		def new() {}

		// Allocates the planes of a `w` x `h` frame.
		def alloc(w int, h int, depth int, subX int, subY int) {
			width = w
			height = h
			bitDepth = depth
			ssx = subX
			ssy = subY
			miCols = (w + 7) >> 3
			miRows = (h + 7) >> 3
			let aw = (w + 63) & ~63
			let ah = (h + 63) & ~63
			stride = aw + 64
			cstride = stride >> subX
			y.len(stride * (ah + 1))
			u.len(cstride * ((ah >> subY) + 1))
			v.len(cstride * ((ah >> subY) + 1))
			mvRef.len(miCols * miRows * 2)
			mvs.len(miCols * miRows * 2)
			valid = true
		}
	}
}
