		"hgBAkpwIRUAAAyAAAFRwo7+BAW8AhgBAkpwIROAAA2AAAH24++VjFXmRqHFHg4+mMGyx3zq5r093nLwBjGJ7VEZbw08EZXKYC7J0" +
		"fHk0iHAcU7trkbuPs4EAt4r3gQHxggGr8IED"

	// Decodes the IVF file in `stream` (base64) with a new VP9 decoder.
	def vp9TestDecode(stream string) !VideoFrame[] {
		let ivf = try encoding.base64decode(stream)
		let dec = new VP9()
		try dec.configure(Track{index: 0, kind: TrackKind.Video, codec: "vp9"})
		let frames VideoFrame[]
		let at = int(ivf[6]) | (int(ivf[7]) << 8)
		for at + 12 <= ivf.len() {
			let size = int(ivf[at]) | (int(ivf[at + 1]) << 8) | (int(ivf[at + 2]) << 16) | (int(ivf[at + 3]) << 24)
			let got = try dec.decode(Packet{track: 0, data: ivf[at + 12:at + 12 + size].clone()})
			for let f in got {
				frames.push(f)
			}
			at += 12 + size
		}
		// Nothing is held back for the end of the stream.
		let rest = try dec.flush()
		fail "vp9: flush gave {rest.len()} pictures" when rest.len() != 0
		return frames
	}

	def vp9TestMatches(frames VideoFrame[], want string[]) bool {
		return false when frames.len() != want.len()
		for let i = 0; i < frames.len(); i++ {
			let h = new hash.MD5()
			return false when encoding.hexencode(h.hash(frames[i].y + frames[i].u + frames[i].v)) != want[i]
		}
		return true
	}

	check "VP9" {
		@test()
		def TestVp9Main() {
			let frames = vp9TestDecode(vp9TestMain) onerror recover VideoFrame[]
			assert vp9TestMatches(frames, vp9TestMainMd5)
			assert frames[0].width == uint32(64) && frames[0].height == uint32(48)
			assert frames[0].bitDepth == 8 && frames[0].chroma == ChromaLayout.Yuv420
			assert frames[0].keyframe && !frames[1].keyframe
		}

		@test()
		def TestVp9Tiles() {
			let frames = vp9TestDecode(vp9TestTiles) onerror recover VideoFrame[]
			assert vp9TestMatches(frames, vp9TestTilesMd5)
			assert frames[0].width == uint32(512)
		}

		@test()
		def TestVp9Profile1() {
			let frames = vp9TestDecode(vp9Test444) onerror recover VideoFrame[]
			assert vp9TestMatches(frames, vp9Test444Md5)
			assert frames[0].bitDepth == 8 && frames[0].chroma == ChromaLayout.Yuv444
		}

		// 4:4:0 comes out as 4:4:4, each chroma row repeated.
		@test()
		def TestVp9Yuv440() {
			let frames = vp9TestDecode(vp9Test440) onerror recover VideoFrame[]
			assert vp9TestMatches(frames, vp9Test440Md5)
			assert frames[0].chroma == ChromaLayout.Yuv444
			assert frames[0].u.len() == 64 * 64
		}

		@test()
		def TestVp9Profile2() {
			let frames = vp9TestDecode(vp9TestHigh10) onerror recover VideoFrame[]
			assert vp9TestMatches(frames, vp9TestHigh10Md5)
			assert frames[0].bitDepth == 10 && frames[0].chroma == ChromaLayout.Yuv420
			assert frames[0].yStride == 128
		}

		@test()
		def TestVp9Profile3() {
			let frames = vp9TestDecode(vp9TestHigh12) onerror recover VideoFrame[]
			assert vp9TestMatches(frames, vp9TestHigh12Md5)
			assert frames[0].bitDepth == 12 && frames[0].chroma == ChromaLayout.Yuv422
		}

		@test()
		def TestVp9Lossless() {
			let frames = vp9TestDecode(vp9TestLossless) onerror recover VideoFrame[]
			assert vp9TestMatches(frames, vp9TestLosslessMd5)
		}

		// The decoder is found by the track's codec, as WebM names it.
		@test()
		def TestVp9Webm() !none {
			let data = try encoding.base64decode(vp9TestWebm)
			let v = try open(data)
			let stream = try v.frames()
			let frames VideoFrame[]
			for {
				let got = try stream.next()
				break when got is none
				let f VideoFrame = got
				frames.push(f)
			}
			assert vp9TestMatches(frames, vp9TestMainMd5)
			assert v.info().codec == "vp9"
			return none
		}

		// A header that asks for a picture beyond the largest level is
		// refused before anything is allocated.
		@test()
		def TestVp9TooLarge() {
			let ivf = encoding.base64decode(vp9TestMain) onerror recover byte[]
			let p = int(ivf[6]) | (int(ivf[7]) << 8)
			let size = int(ivf[p]) | (int(ivf[p + 1]) << 8)
			let frame = ivf[p + 12:p + 12 + size].clone()
			// Width and height of a profile 0 key frame are bits 36 to 67.
			frame[4] = frame[4] | byte(0x0F)
			frame[5] = byte(0xFF)
			frame[6] = byte(0xFF)
			frame[7] = byte(0xFF)
			frame[8] = frame[8] | byte(0xF0)
			let message = ""
			let dec = new VP9()
			dec.decode(Packet{track: 0, data: frame}) onerror (err error) {
				message = err.message
				recover VideoFrame[]
			}
			assert message == "vp9: picture too large"
		}

		// An inter frame before any key frame, and a frame cut short, fail
		// instead of producing a picture.
		@test()
		def TestVp9Damaged() {
			let ivf = encoding.base64decode(vp9TestMain) onerror recover byte[]
			let p = int(ivf[6]) | (int(ivf[7]) << 8)
			let size = int(ivf[p]) | (int(ivf[p + 1]) << 8)
			let second = p + 12 + size
			let size2 = int(ivf[second]) | (int(ivf[second + 1]) << 8)
			let dec = new VP9()
			let failed = false
			dec.decode(Packet{track: 0, data: ivf[second + 12:second + 12 + size2].clone()}) onerror (err error) {
				failed = true
				recover VideoFrame[]
			}
			assert failed
			failed = false
			dec.decode(Packet{track: 0, data: ivf[p + 12:p + 12 + 6].clone()}) onerror (err error) {
				failed = true
				recover VideoFrame[]
			}
			assert failed
			// After a damaged frame the frames that predict from it are
			// refused until a key frame starts over.
			let third = second + 12 + size2
			let size3 = int(ivf[third]) | (int(ivf[third + 1]) << 8)
			let fresh = new VP9()
			let key = fresh.decode(Packet{track: 0, data: ivf[p + 12:p + 12 + size].clone()}) onerror recover VideoFrame[]
			assert key.len() == 1
			failed = false
			fresh.decode(Packet{track: 0, data: ivf[second + 12:second + 12 + size2 / 2].clone()}) onerror (err error) {
				failed = true
				recover VideoFrame[]
			}
			assert failed
			failed = false
			fresh.decode(Packet{track: 0, data: ivf[third + 12:third + 12 + size3].clone()}) onerror (err error) {
				failed = true
				recover VideoFrame[]
			}
			assert failed
			let again = fresh.decode(Packet{track: 0, data: ivf[p + 12:p + 12 + size].clone()}) onerror recover VideoFrame[]
			assert again.len() == 1
		}
	}
}
