partial module std.formats.video {
	use (
		std.io
		std.formats.audio
		std.formats.video.demux::*
		std.formats.video.matroska::*
		std.formats.video.pictures::*
	)

	// WebMWriter writes a WebM file: tracks of VP8, VP9 or AV1 video and
	// Vorbis or Opus audio, from packets (`add`, `write`, `close`) or
	// from pictures and sound it encodes itself (`encode`).
	//
	// Written to an `os.File`, the file records its length and an index
	// of key frames, so it seeks. Any other writer takes a stream with
	// neither, which is read from its start: what a live source sends.
	//
	// ```
	// let file = try os.open("clip.webm", "w")
	// let out = new video.WebMWriter(file)
	// try out.encode(pictures, sound)
	// try file.close()
	// ```
	//
	// Copying the tracks of another file:
	//
	// ```
	// let out = new video.WebMWriter(file)
	// for let (_, t) in source.tracks() {
	// 	try out.add(t)
	// }
	// for {
	// 	let p = try source.next()
	// 	break when p is none
	// 	try out.write(p)
	// }
	// try out.close()
	// ```
	type WebMWriter {
		internal muxer MkvMuxer

		def new(writer io.Writer) {
			muxer = new MkvMuxer(writer)
		}

		// add takes one more track and returns its index, the `track` of
		// its packets. Of the track, `kind`, `codec`, `config` and
		// `language` are stored, with `width`, `height`, `frameRate` and
		// `pixelAspect` for video and `channels` and `sampleRate` for
		// audio.
		//
		// Fails for a codec WebM does not carry (it carries "vp8", "vp9",
		// "av1", "vorbis" and "opus"), a Vorbis or Opus track whose
		// `config` is not the codec's headers, a 127th track, or once a
		// packet was written.
		def add(track Track) !int {
			return muxer.add(track)
		}

		// write stores one packet at its `pts`, for the track its `track`
		// names. Packets are stored in the order given, which is to be by
		// time across the tracks; a key frame of the first video track
		// is where a reader can seek to. An Opus packet whose `length` is
		// shorter than its frames play for ends the sound there.
		//
		// Fails for a track that was not added, after `close`, or when
		// the writer fails.
		def write(packet Packet) !none {
			return muxer.write(packet)
		}

		// close writes what is still held back and, to a file, the index
		// and the length. The writer given to `new` stays open. Closing
		// twice does nothing.
		//
		// Fails when no track was added or the writer fails.
		def close() !none {
			return muxer.close()
		}

		// encode writes a whole file: the pictures as VP8 and, when given,
		// the sound as Opus (mono or stereo; more channels fold down to
		// stereo), each from where its stream stands to its end, then
		// closes. `bitsPerSecond` is what the video aims for; 0 picks a
		// tenth of a bit a pixel, 100 kbit/s at least. VP8 holds 8-bit
		// 4:2:0 pictures: deeper samples are rounded, 4:2:2 and 4:4:4
		// chroma is averaged down, and pictures on the GPU are brought
		// to main memory.
		//
		// Fails when the pictures have no size or change size; when the
		// GPU cannot give a picture back; when the sound has no channels or
		// no sample rate; when either stream fails; or when the writer
		// fails.
		def encode(pictures VideoStream, sound ?audio.AudioStream = none, bitsPerSecond int = 0) !none {
			let about = pictures.info()
			let width = int(about.width)
			let height = int(about.height)
			fail "webm: the pictures have no size" unless width > 0 && height > 0
			let rate = about.frameRate
			let perSecond = rate.numerator > 0 && rate.denominator > 0 ?? (int((rate.numerator + rate.denominator / 2) / rate.denominator).max(1), 30)
			let bits = bitsPerSecond > 0 ?? (bitsPerSecond, (width * height * perSecond / 10).max(100000))
			let encoder = new VP8Encoder(width, height, bits, perSecond)
			let video = try add(Track{...newTrack(0, TrackKind.Video, "vp8"), width: about.width, height: about.height, frameRate: rate, pixelAspect: about.pixelAspect})
			let feed ?WebmSound = none
			let waiting ?Packet = none
			if !(sound is none) {
				let stream audio.AudioStream = sound
				let from = stream.info()
				fail "webm: the sound has no channels" when from.channels == 0
				fail "webm: the sound has no sample rate" when from.sampleRate == 0
				let made = new WebmSound(stream)
				made.track = try add(made.described())
				waiting = try made.next()
				feed = made
			}
			for {
				let got = try pictures.next()
				break when got is none
				let frame VideoFrame = got
				let packet = try encoder.encode(try plain420(frame))
				waiting = try soundUntil(feed, waiting, packet.pts)
				try write(Packet{...packet, track: video})
			}
			try soundUntil(feed, waiting, duration(int64(1) << 62))
			return close()
		}

		// Writes the sound packets at or before `time`, starting with
		// `waiting`, and returns the first one after it, none at the
		// sound's end.
		//
		// Fails when the sound or the writer fails.
		internal def soundUntil(feed ?WebmSound, waiting ?Packet, time duration) !?Packet {
			return none when feed is none
			let from WebmSound = feed
			let next = waiting
			for {
				return none when next is none
				let packet Packet = next
				return next when packet.pts > time
				try write(packet)
				next = try from.next()
			}
			return none
		}
	}
}
