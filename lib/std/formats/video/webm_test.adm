partial module std.formats.video {
	use (
		std.testing
		std.bytes
		std.io
		std.os
		std.time
		std.math
		std.formats.video.demux::*
		std.formats.audio
		std.formats.video.media.source::*
		std.formats.video.matroska::*
	)

	// Pictures of a pattern that moves three pixels a picture, 25 a
	// second.
	internal type WebmTestPictures {
		width  int
		height int
		count  int
		at     int

		def new(width int, height int, count int) {
			self.width = width
			self.height = height
			self.count = count
		}

		// The luma sample at (x, y) of picture `n`.
		def luma(x int, y int, n int) int {
			let t = (x + y + 3 * n) % 128
			return 60 + 2 * (t < 64 ?? (t, 127 - t))
		}

		def info() VideoInfo {
			return VideoInfo{width: uint32(width), height: uint32(height), frameRate: FrameRate{numerator: uint32(25), denominator: uint32(1)}, pixelAspect: 1.0}
		}

		def next() !?VideoFrame {
			return none when at >= count
			let y byte[]
			y.len(width * height)
			for let row = 0; row < height; row++ {
				for let x = 0; x < width; x++ {
					y[row * width + x] = byte(luma(x, row, at))
				}
			}
			let u byte[]
			u.len(width / 2 * (height / 2))
			u.fill(128)
			let frame = VideoFrame{
				width:    uint32(width),
				height:   uint32(height),
				y:        y,
				u:        u,
				v:        u.clone(),
				yStride:  width,
				uvStride: width / 2,
				time:     duration(int64(at) * 40000000),
				length:   40ms,
				keyframe: at == 0,
				matrix:   601
			}
			at++
			return frame
		}

		def seek(time duration) !none {
			fail "the test pictures do not seek"
		}

		def position() duration {
			return duration(int64(at) * 40000000)
		}
	}

	// `frames` frames of a 440 Hz tone at half scale, in `channels`
	// channels at `rate` Hz.
	internal def webmTestTone(rate int, channels int, frames int) audio.AudioStream {
		let pcm = new audio.PCM()
		pcm.info = audio.AudioInfo{sampleRate: uint32(rate), channels: uint16(channels), bitDepth: 32, format: audio.SampleFormat.Float32, frames: uint64(frames)}
		pcm.samples.len(frames * channels)
		for let i = 0; i < frames; i++ {
			let v = float32(0.5 * math.sin(2.0 * math.π * 440.0 * float(i) / float(rate)))
			for let c = 0; c < channels; c++ {
				pcm.samples[i * channels + c] = v
			}
		}
		return pcm.stream()
	}

	// Copies every track and packet of the WebM file in `data` through a
	// WebMWriter on `writer`.
	internal def webmCopy(data byte[], writer io.Writer) !none {
		let source = try new MKV().open(new bytes.Reader(data))
		let out = new WebMWriter(writer)
		for let (_, t) in source.tracks() {
			try out.add(t)
		}
		for {
			let got = try source.next()
			break when got is none
			let p Packet = got
			try out.write(p)
		}
		return out.close()
	}

	check "WebM writer" {
		@test()
		def TestWebmCopyToStream() !none {
			let out = new bytes.Buffer()
			try webmCopy(tinyWebm(), out)
			let c = new MkvContainer(new Source(new bytes.Reader(out.bytes())))
			try c.read()
			try testing.expectEqual("webm", c.docType)
			let before = (try new MKV().open(new bytes.Reader(tinyWebm()))).tracks()
			let tracks = c.tracks()
			assert tracks.len() == 2
			for let (i, t) in tracks {
				assert t.kind == before[i].kind && t.codec == before[i].codec && t.config.equals(before[i].config)
				assert t.width == before[i].width && t.height == before[i].height && t.frameRate.numerator == before[i].frameRate.numerator && t.frameRate.denominator == before[i].frameRate.denominator
				assert t.sampleRate == before[i].sampleRate && t.channels == before[i].channels
			}
			// A stream records no length and has no index.
			assert c.infoLength == 0s && c.cuesAt < 0 && c.segmentEnd < 0
			try testing.expectEqual("", try comparePackets(c, tinyWebmPackets(), 1000))
		}

		@test()
		def TestWebmCopyToFile() !none {
			let path = "/tmp/adm-webm-copy-{time.now().unixNs()}.webm"
			let file = try os.open(path, "w")
			// The file's own start does not have to be the WebM's.
			try file.write(byte[1, 2, 3])
			webmCopy(tinyWebm(), file) onerror (err error) {
				file.close() onerror recover none
				os.remove(path) onerror recover none
				fail err
			}
			try file.close()
			let all = try os.readFile(path)
			os.remove(path) onerror recover none
			let data = all[3:]
			let source = new MkvContainer(new Source(new bytes.Reader(tinyWebm())))
			try source.read()
			let c = new MkvContainer(new Source(new bytes.Reader(data)))
			try c.read()
			// The segment's size reaches the end of the file exactly.
			try testing.expectEqual(data.len(), c.segmentEnd)
			assert (int64(c.infoLength) - int64(source.infoLength)).abs() <= 1000000
			try testing.expectEqual("", try comparePackets(c, tinyWebmPackets(), 1000))
			// The SeekHead leads to Cues that name every key frame's
			// cluster.
			assert c.cuesAt > 0
			try c.seek(0s)
			assert c.cues.len() > 0
			for let (_, cue) in c.cues {
				try c.seek(cue.time)
				let got = try c.next()
				fail "no packet at the cue of {cue.time}" when got is none
				let p Packet = got
				assert p.track == 0 && p.keyframe && p.pts == cue.time
			}
		}

		@test()
		def TestWebmEncode() !none {
			let out = new bytes.Buffer()
			let pictures = new WebmTestPictures(64, 48, 12)
			// Not a whole number of packets: the last one is cut short.
			try new WebMWriter(out).encode(pictures, webmTestTone(48000, 2, 24100))
			let v = try open(out.bytes())
			defer v.close()
			let info = v.info()
			try testing.expectEqual("webm vp8 64x48 25/1", "{info.container} {info.codec} {info.width}x{info.height} {info.frameRate.numerator}/{info.frameRate.denominator}")
			let stream = try v.frames()
			let found = try v.audio()
			fail "no audio track" when found is none
			let sound audio.AudioStream = found
			try testing.expectEqual("opus 48000 2", "{sound.info().codec} {sound.info().sampleRate} {sound.info().channels}")
			let (frames, peak) = try drainSound(sound)
			try testing.expectEqual(24100, frames)
			assert peak > 0.4 && peak < 0.6
			let n = 0
			for {
				let got = try stream.next()
				break when got is none
				let f VideoFrame = got
				try testing.expectEqual(n * 40, int(int64(f.time) / 1000000))
				let off = 0
				for let row = 0; row < 48; row++ {
					for let x = 0; x < 64; x++ {
						off += (int(f.y[row * f.yStride + x]) - pictures.luma(x, row, n)).abs()
					}
				}
				assert off / (64 * 48) < 6
				n++
			}
			try testing.expectEqual(12, n)
		}

		@test()
		def TestWebmSave() !none {
			let path = "/tmp/adm-webm-save-{time.now().unixNs()}.webm"
			try save(new WebmTestPictures(32, 32, 30), path, webmTestTone(44100, 1, 44100))
			let v = open(path) onerror (err error) {
				os.remove(path) onerror recover none
				fail err
			}
			let info = v.info()
			let seekable = info.seekable
			let length = info.length
			try v.seek(600ms)
			let stream = try v.frames()
			let got = try stream.next()
			try v.close()
			os.remove(path) onerror recover none
			// 30 pictures at 25 a second outlast the second of sound.
			try testing.expectEqual("true 1200", "{seekable} {int64(length) / 1000000}")
			fail "no picture after the seek" when got is none
			let f VideoFrame = got
			try testing.expectEqual(600, int(int64(f.time) / 1000000))

			let refused = ""
			save(new WebmTestPictures(32, 32, 1), "/tmp/adm-webm-save.mp4") onerror (err error) {
				refused = err.message
				recover none
			}
			try testing.expectEqual("no video container is written with the extension \"mp4\"", refused)
			assert !(try os.exists("/tmp/adm-webm-save.mp4"))
		}

		@test()
		def TestWebmRefuses() !none {
			let out = new WebMWriter(new bytes.Buffer())
			let why = out.add(newTrack(0, TrackKind.Video, "h264")) onerror (err error) {
				recover -1
			}
			try testing.expectEqual(-1, why)
			let wrongKind = out.add(newTrack(0, TrackKind.Audio, "vp8")) onerror recover -1
			try testing.expectEqual(-1, wrongKind)
			let noHead = out.add(newTrack(0, TrackKind.Audio, "opus")) onerror recover -1
			try testing.expectEqual(-1, noHead)
			try testing.expectEqual(0, try out.add(Track{...newTrack(0, TrackKind.Video, "vp8"), width: uint32(16), height: uint32(16)}))
			let stray = false
			out.write(newPacket(1, byte[1], 0s, 0s, 0s, true)) onerror (err error) {
				stray = true
				recover none
			}
			assert stray
			try out.write(newPacket(0, byte[1], 0s, 0s, 0s, true))
			let late = out.add(Track{...newTrack(0, TrackKind.Video, "vp9"), width: uint32(16), height: uint32(16)}) onerror recover -1
			try testing.expectEqual(-1, late)
			try out.close()
			try out.close()
			let closed = false
			out.write(newPacket(0, byte[1], 0s, 0s, 0s, true)) onerror (err error) {
				closed = true
				recover none
			}
			assert closed

			let unstarted = false
			new WebMWriter(new bytes.Buffer()).close() onerror (err error) {
				unstarted = true
				recover none
			}
			assert unstarted
		}

		@test()
		def TestWebmElements() !none {
			let sizes byte[]
			putSize(sizes, 5)
			putSize(sizes, 126)
			putSize(sizes, 127)
			putSize(sizes, 16382)
			putSize(sizes, 16383)
			putSize(sizes, 300, 8)
			try testing.expectEqual("[133, 254, 64, 127, 127, 254, 32, 63, 255, 1, 0, 0, 0, 0, 0, 1, 44]", "{sizes}")
			let numbers byte[]
			putUint(numbers, 0xD7, 1)
			putUint(numbers, 0x2AD7B1, 1000000)
			putInt(numbers, 0x75A2, -2)
			putInt(numbers, 0x75A2, 200)
			try testing.expectEqual("[215, 129, 1, 42, 215, 177, 131, 15, 66, 64, 117, 162, 129, 254, 117, 162, 130, 0, 200]", "{numbers}")
			let e = elements(numbers, 0, numbers.len())
			try testing.expectEqual("-2 200", "{intOf(numbers, e[2])} {intOf(numbers, e[3])}")

			// Lacing undoes what the reader does to the headers.
			let laced = byte[2, 3, 1, 0xA, 0xB, 0xC, 0xD, 0xE, 0xF]
			assert (try xiphLaced(xiphHeaders(laced))).equals(laced)
			let long byte[]
			long.push(1, 255, 45)
			long.len(3 + 300 + 7)
			assert (try xiphLaced(xiphHeaders(long))).equals(long)
			let cut = false
			xiphLaced(byte[0, 9, 1]) onerror (err error) {
				cut = true
				recover byte[]
			}
			assert cut

			// 20 ms of CELT; two frames of 10 ms SILK; three frames of 2.5 ms.
			try testing.expectEqual("20000000 20000000 7500000 0", "{int64(opusPacketLength(byte[0xF8, 0]))} {int64(opusPacketLength(byte[0x01, 0]))} {int64(opusPacketLength(byte[0x83, 3]))} {int64(opusPacketLength(byte[]))}")
		}
	}
}
