internal std.formats partial module std.formats.vp8 {
	// Vp8BoolDecoder reads one partition of a VP8 frame: a boolean entropy
	// coder where each bit comes with the probability that it is zero.
	type Vp8BoolDecoder {
		data    byte[]
		// Where the partition starts in `data`.
		origin  int
		pos     int
		end     int
		rangeM1 int
		bits    int
		nBits   int
		eof     bool

		def new(source byte[], start int, stop int) {
			data = source
			origin = start
			pos = start
			end = stop
			rangeM1 = 254
			bits = 0
			nBits = 0
			eof = false
		}

		// Reads one bit that is zero with probability `prob` / 256.
		def bit(prob int) bool {
			if nBits < 8 {
				if pos >= end {
					eof = true
					return false
				}
				bits = bits | (int(data[pos]) << (8 - nBits))
				pos++
				nBits += 8
			}
			let split = ((rangeM1 * prob) >> 8) + 1
			let b = bits >= (split << 8)
			if b {
				rangeM1 -= split
				bits -= split << 8
			} else {
				rangeM1 = split - 1
			}
			if rangeM1 < 127 {
				let shift = vp8NormShift[rangeM1]
				rangeM1 = ((rangeM1 + 1) << shift) - 1
				bits = bits << shift
				nBits -= shift
			}
			return b
		}

		// Where the decoder stands, as a decoder resuming it needs: the bits
		// consumed from the partition's start, the value (the next 8 bits
		// minus what the decoded bits took off) and the range.
		def state() (int, int, int) {
			if nBits < 8 && pos < end {
				bits = bits | (int(data[pos]) << (8 - nBits))
				pos++
				nBits += 8
			}
			return (8 * (pos - origin) - nBits, bits >> 8, rangeM1 + 1)
		}

		// Reads an `n`-bit unsigned value, most significant bit first.
		def uint(prob int, n int) int {
			let u = 0
			for let i = n - 1; i >= 0; i-- {
				u = u | (1 << i) when bit(prob)
			}
			return u
		}

		// Reads an `n`-bit magnitude followed by its sign.
		def signed(n int) int {
			let u = uint(128, n)
			return 0 - u when bit(128)
			return u
		}

		// Reads a flag and, when it is set, a signed `n`-bit value.
		def optional(n int) int {
			return 0 unless bit(128)
			return signed(n)
		}
	}

	def vp8Clip(x int, lo int, hi int) int {
		return lo when x < lo
		return hi when x > hi
		return x
	}

	def vp8Abs(x int) int {
		return x < 0 ?? (0 - x, x)
	}
}
