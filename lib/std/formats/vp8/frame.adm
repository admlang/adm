internal std.formats partial module std.formats.vp8 {
	// Macroblock kinds, as the loop filter and the motion vector context
	// tell them apart.
	const (
		vp8KindIntra = 0
		vp8KindBPred = 1
		vp8KindZero  = 2
		vp8KindMv    = 3
		vp8KindSplit = 4
	)

	// Reference frames a macroblock predicts from; intra macroblocks use
	// the frame being decoded.
	const (
		vp8RefIntra  = 0
		vp8RefLast   = 1
		vp8RefGolden = 2
		vp8RefAltRef = 3
	)

	// Vp8Picture is one decoded frame: the three planes at macroblock
	// resolution, before cropping. `id` tells the pictures of a decoder's
	// pool apart.
	type Vp8Picture {
		id int
		y  byte[]
		u  byte[]
		v  byte[]

		def new(n int, py byte[], pu byte[], pv byte[]) {
			id = n
			y = py
			u = pu
			v = pv
		}
	}

	// Vp8Decoder decodes VP8 frames into Y, U and V planes, the chroma planes
	// at half resolution each way. It keeps what later frames build on: the
	// reference frames, the probabilities and the segment map.
	type Vp8Decoder {
		width    int
		height   int
		mbw      int
		mbh      int
		yStride  int
		cStride  int
		// Planes of the last decoded frame, `yStride` and `cStride` wide and
		// a whole number of macroblocks high.
		y        byte[]
		u        byte[]
		v        byte[]
		// The upscaling the last key frame asks for, 0 to 3 each way.
		hScale   int
		vScale   int
		// Header facts of the last decoded frame.
		keyframe bool
		version  int
		shown    bool

		fp    Vp8BoolDecoder
		parts Vp8BoolDecoder[]

		useSegment bool
		updateMap  bool
		relative   bool
		segQuant   int[]
		segFilter  int[]
		segProb    int[]
		segMap     int[]

		simple      bool
		level       int
		sharpness   int
		useLFDelta  bool
		refLFDelta  int[]
		modeLFDelta int[]

		// Per segment: Y1 DC, Y1 AC, Y2 DC, Y2 AC, UV DC, UV AC.
		quant       int[]
		tokenProb   int[]
		yModeProb   int[]
		uvModeProb  int[]
		mvProb      int[]
		// The probabilities a frame that does not keep its updates goes back
		// to.
		savedToken  int[]
		savedYMode  int[]
		savedUVMode int[]
		savedMv     int[]
		useSkipProb bool
		skipProb    int
		probIntra   int
		probLast    int
		probGolden  int

		refreshGolden bool
		refreshAlt    bool
		refreshLast   bool
		refreshProbs  bool
		copyToGolden  int
		copyToAlt     int
		signBias      int[]
		refs          Vp8Picture[]
		// Pictures to decode into, made as needed: at most one more than the
		// reference slots hold.
		pool          Vp8Picture[]
		cur           Vp8Picture
		bilinear      bool
		fullPixel     bool

		// Level, interior limit, high edge variance threshold and whether
		// inner edges are filtered, for each macroblock.
		mbFilter int[]
		// What each macroblock of the frame predicts from, for the motion
		// vector contexts of the ones after it.
		mbRef    int[]
		mbKind   int[]
		mvR      int[]
		mvC      int[]
		// Vectors of each 4x4 luma block of split macroblocks.
		bmvR     int[]
		bmvC     int[]

		segment    int
		kind       int
		ref        int
		leftPred   int[]
		leftNz     int
		leftNzY16  int
		upPred     int[]
		upNz       int[]
		upNzY16    int[]
		nzDCMask   int
		nzACMask   int
		usePredY16 bool
		hasY2      bool
		predY16    int
		predC8     int
		predY4     int[]
		coeff      int[]
		ybr        int[]

		// Candidate vectors and their votes, and the partition vectors of a
		// split macroblock.
		nearIdx int
		nearR   int[]
		nearC   int[]
		cnt     int[]
		partR   int[]
		partC   int[]
		// Scratch for motion compensation: a reference window with its edges
		// extended, and the first pass of two-pass filters.
		edge    byte[]
		tmp     int[]

		def new() {
			segQuant = vp8Zeros(4)
			segFilter = vp8Zeros(4)
			segProb = int[255, 255, 255]
			refLFDelta = vp8Zeros(4)
			modeLFDelta = vp8Zeros(4)
			quant = vp8Zeros(24)
			tokenProb = vp8DefaultTokenProb.clone()
			yModeProb = vp8DefaultYModeProb.clone()
			uvModeProb = vp8DefaultUVModeProb.clone()
			mvProb = vp8DefaultMvProb.clone()
			savedToken = []
			savedYMode = []
			savedUVMode = []
			savedMv = []
			signBias = vp8Zeros(4)
			refs = []
			leftPred = vp8Zeros(4)
			predY4 = vp8Zeros(16)
			coeff = vp8Zeros(400)
			ybr = vp8Zeros(26 * 32)
			nearR = vp8Zeros(4)
			nearC = vp8Zeros(4)
			cnt = vp8Zeros(4)
			partR = vp8Zeros(16)
			partC = vp8Zeros(16)
			edge = vp8Bytes(21 * 21)
			tmp = vp8Zeros(21 * 16)
			parts = []
			segMap = []
			pool = []
			cur = new Vp8Picture(-1, [], [], [])
			y = []
			u = []
			v = []
		}

		// Reads the dimensions from a key frame header without decoding it.
		def header(data byte[], start int, stop int) !(int, int) {
			fail "vp8: truncated frame header" when stop - start < 10
			let d = data
			let s = start
			fail "vp8: frame is not a key frame" when (int(d[s]) & 1) != 0
			fail "vp8: bad key frame signature" unless int(d[s + 3]) == 0x9d && int(d[s + 4]) == 0x01 && int(d[s + 5]) == 0x2a
			let w = (int(d[s + 6]) | (int(d[s + 7]) << 8)) & 0x3fff
			let h = (int(d[s + 8]) | (int(d[s + 9]) << 8)) & 0x3fff
			fail "vp8: bad frame dimensions" when w == 0 || h == 0
			return (w, h)
		}

		// Sets the frame size and allocates what depends on it.
		def resize(w int, h int) {
			width = w
			height = h
			mbw = (w + 15) >> 4
			mbh = (h + 15) >> 4
			yStride = 16 * mbw
			cStride = 8 * mbw
			let n = mbw * mbh
			mbFilter = vp8Zeros(4 * n)
			segMap = vp8Zeros(n)
			mbRef = vp8Zeros(n)
			mbKind = vp8Zeros(n)
			mvR = vp8Zeros(n)
			mvC = vp8Zeros(n)
			bmvR = vp8Zeros(16 * n)
			bmvC = vp8Zeros(16 * n)
			upPred = vp8Zeros(4 * mbw)
			upNz = vp8Zeros(mbw)
			upNzY16 = vp8Zeros(mbw)
			pool = []
			refs = []
		}

		// Decodes one frame from `data[start:stop]`. Fails when the frame is
		// truncated or damaged, or when an inter frame comes before any key
		// frame.
		def decode(data byte[], start int, stop int) !none {
			fail "vp8: truncated frame header" when stop - start < 3
			let d = data
			let tag = int(d[start]) | (int(d[start + 1]) << 8) | (int(d[start + 2]) << 16)
			keyframe = (tag & 1) == 0
			version = (tag >> 1) & 7
			shown = ((tag >> 4) & 1) == 1
			let firstLen = tag >> 5
			let p = start + 3
			if keyframe {
				let (w, h) = try header(data, start, stop)
				hScale = int(d[start + 7]) >> 6
				vScale = int(d[start + 9]) >> 6
				p += 7
				resize(w, h) when w != width || h != height || mbRef.len() == 0
				resetState()
			} else {
				fail "vp8: inter frame before the first key frame" when refs.len() == 0
			}
			bilinear = version != 0
			fullPixel = version == 3
			fail "vp8: truncated frame" when p + firstLen > stop
			fp = new Vp8BoolDecoder(d, p, p + firstLen)
			p += firstLen
			if keyframe {
				fp.bit(128)
				fp.bit(128)
			}
			parseSegmentHeader()
			parseFilterHeader()
			try parsePartitions(data, p, stop)
			parseQuant()
			if keyframe {
				refreshGolden = true
				refreshAlt = true
				refreshLast = true
				copyToGolden = 0
				copyToAlt = 0
				signBias.fill(0)
				refreshProbs = fp.bit(128)
			} else {
				refreshGolden = fp.bit(128)
				refreshAlt = fp.bit(128)
				copyToGolden = refreshGolden ?? (0, fp.uint(128, 2))
				copyToAlt = refreshAlt ?? (0, fp.uint(128, 2))
				signBias[vp8RefGolden] = fp.bit(128) ?? (1, 0)
				signBias[vp8RefAltRef] = fp.bit(128) ?? (1, 0)
				refreshProbs = fp.bit(128)
				refreshLast = fp.bit(128)
			}
			if !refreshProbs {
				savedToken = tokenProb.clone()
				savedYMode = yModeProb.clone()
				savedUVMode = uvModeProb.clone()
				savedMv = mvProb.clone()
			}
			parseTokenProb()
			useSkipProb = fp.bit(128)
			skipProb = useSkipProb ?? (fp.uint(128, 8), 0)
			if !keyframe {
				probIntra = fp.uint(128, 8)
				probLast = fp.uint(128, 8)
				probGolden = fp.uint(128, 8)
				if fp.bit(128) {
					for let i = 0; i < 4; i++ {
						yModeProb[i] = fp.uint(128, 8)
					}
				}
				if fp.bit(128) {
					for let i = 0; i < 3; i++ {
						uvModeProb[i] = fp.uint(128, 8)
					}
				}
				parseMvProb()
			}
			fail "vp8: truncated frame" when fp.eof

			cur = freePicture()
			y = cur.y
			u = cur.u
			v = cur.v
			upPred.fill(0)
			upNz.fill(0)
			upNzY16.fill(0)
			for let mby = 0; mby < mbh; mby++ {
				leftPred.fill(0)
				leftNz = 0
				leftNzY16 = 0
				let r = parts[mby & (parts.len() - 1)]
				for let mbx = 0; mbx < mbw; mbx++ {
					decodeMacroblock(r, mbx, mby)
				}
				fail "vp8: truncated frame" when r.eof
			}
			fail "vp8: truncated frame" when fp.eof
			if level != 0 {
				if simple {
					simpleFilter()
				} else {
					normalFilter()
				}
			}
			if !refreshProbs {
				tokenProb = savedToken
				yModeProb = savedYMode
				uvModeProb = savedUVMode
				mvProb = savedMv
			}
			updateReferences()
		}

		// Puts back what a key frame resets: the probabilities, the
		// segmentation and the loop filter adjustments.
		def resetState() {
			tokenProb = vp8DefaultTokenProb.clone()
			yModeProb = vp8DefaultYModeProb.clone()
			uvModeProb = vp8DefaultUVModeProb.clone()
			mvProb = vp8DefaultMvProb.clone()
			useSegment = false
			relative = true
			segQuant.fill(0)
			segFilter.fill(0)
			refLFDelta.fill(0)
			modeLFDelta.fill(0)
		}

		// A picture of the pool no reference slot holds, made when there is
		// none. Every macroblock is written before it is read, so it needs no
		// clearing.
		def freePicture() Vp8Picture {
			for let (_, p) in pool {
				let held = false
				for let i = 1; i < refs.len(); i++ {
					held = true when refs[i].id == p.id
				}
				return p unless held
			}
			let p = new Vp8Picture(pool.len(), vp8Bytes(yStride * 16 * mbh), vp8Bytes(cStride * 8 * mbh), vp8Bytes(cStride * 8 * mbh))
			pool.push(p)
			return p
		}

		// Moves the decoded frame into the reference slots its header names.
		def updateReferences() {
			if keyframe || refs.len() == 0 {
				refs = [cur, cur, cur, cur]
				return
			}
			let last = refs[vp8RefLast]
			let golden = refs[vp8RefGolden]
			let alt = refs[vp8RefAltRef]
			if refreshGolden {
				refs[vp8RefGolden] = cur
			} else if copyToGolden == 1 {
				refs[vp8RefGolden] = last
			} else if copyToGolden == 2 {
				refs[vp8RefGolden] = alt
			}
			if refreshAlt {
				refs[vp8RefAltRef] = cur
			} else if copyToAlt == 1 {
				refs[vp8RefAltRef] = last
			} else if copyToAlt == 2 {
				refs[vp8RefAltRef] = golden
			}
			refs[vp8RefLast] = cur when refreshLast
		}

		def parseSegmentHeader() {
			useSegment = fp.bit(128)
			if !useSegment {
				updateMap = false
				return
			}
			updateMap = fp.bit(128)
			if fp.bit(128) {
				relative = !fp.bit(128)
				for let i = 0; i < 4; i++ {
					segQuant[i] = fp.optional(7)
				}
				for let i = 0; i < 4; i++ {
					segFilter[i] = fp.optional(6)
				}
			}
			return unless updateMap
			for let i = 0; i < 3; i++ {
				segProb[i] = fp.bit(128) ?? (fp.uint(128, 8), 255)
			}
		}

		def parseFilterHeader() {
			simple = fp.bit(128)
			level = fp.uint(128, 6)
			sharpness = fp.uint(128, 3)
			useLFDelta = fp.bit(128)
			if useLFDelta && fp.bit(128) {
				for let i = 0; i < 4; i++ {
					refLFDelta[i] = fp.signed(6) when fp.bit(128)
				}
				for let i = 0; i < 4; i++ {
					modeLFDelta[i] = fp.signed(6) when fp.bit(128)
				}
			}
		}

		def parsePartitions(data byte[], at int, stop int) !none {
			let n = 1 << fp.uint(128, 2)
			let sizes = 3 * (n - 1)
			fail "vp8: truncated frame" when at + sizes > stop
			parts = []
			let p = at + sizes
			for let i = 0; i < n; i++ {
				let size = stop - p
				if i < n - 1 {
					let o = at + 3 * i
					size = int(data[o]) | (int(data[o + 1]) << 8) | (int(data[o + 2]) << 16)
					fail "vp8: truncated frame" when p + size > stop
				}
				parts.push(new Vp8BoolDecoder(data, p, p + size))
				p += size
			}
		}

		def parseQuant() {
			let base = fp.uint(128, 7)
			let y1dc = fp.optional(4)
			let y2dc = fp.optional(4)
			let y2ac = fp.optional(4)
			let uvdc = fp.optional(4)
			let uvac = fp.optional(4)
			for let i = 0; i < 4; i++ {
				let q = base
				q = relative ?? (q + segQuant[i], segQuant[i]) when useSegment
				let o = i * 6
				quant[o] = vp8DequantDC[vp8Clip(q + y1dc, 0, 127)]
				quant[o + 1] = vp8DequantAC[vp8Clip(q, 0, 127)]
				quant[o + 2] = vp8DequantDC[vp8Clip(q + y2dc, 0, 127)] * 2
				let y2 = vp8DequantAC[vp8Clip(q + y2ac, 0, 127)] * 155 / 100
				quant[o + 3] = y2 < 8 ?? (8, y2)
				quant[o + 4] = vp8DequantDC[vp8Clip(q + uvdc, 0, 117)]
				quant[o + 5] = vp8DequantAC[vp8Clip(q + uvac, 0, 127)]
			}
		}

		def parseTokenProb() {
			for let i = 0; i < 1056; i++ {
				tokenProb[i] = fp.uint(128, 8) when fp.bit(vp8TokenUpdateProb[i])
			}
		}

		def parseMvProb() {
			for let i = 0; i < 38; i++ {
				if fp.bit(vp8MvUpdateProb[i]) {
					let x = fp.uint(128, 7)
					mvProb[i] = x != 0 ?? (x << 1, 1)
				}
			}
		}

		// Decodes one macroblock: its modes from the first partition, its
		// coefficients from `r`, and its pixels into the planes.
		def decodeMacroblock(r Vp8BoolDecoder, mbx int, mby int) {
			let m = mby * mbw + mbx
			if updateMap {
				if !fp.bit(segProb[0]) {
					segment = fp.uint(segProb[1], 1)
				} else {
					segment = fp.uint(segProb[2], 1) + 2
				}
				segMap[m] = segment
			} else if keyframe {
				segMap[m] = 0
				segment = 0
			} else {
				segment = segMap[m]
			}
			segment = 0 unless useSegment
			let skip = useSkipProb && fp.bit(skipProb)
			if keyframe {
				parseKeyModes(mbx)
			} else if fp.bit(probIntra) {
				parseInterModes(mbx, mby, m)
			} else {
				parseIntraModes()
			}
			mbRef[m] = ref
			mbKind[m] = kind
			if ref == vp8RefIntra {
				mvR[m] = 0
				mvC[m] = 0
			}
			hasY2 = kind != vp8KindBPred && kind != vp8KindSplit

			coeff.fill(0)
			let tokens = false
			if !skip {
				tokens = parseResiduals(r, mbx)
			} else {
				if hasY2 {
					leftNzY16 = 0
					upNzY16[mbx] = 0
				}
				leftNz = 0
				upNz[mbx] = 0
				nzDCMask = 0
				nzACMask = 0
			}
			prepareYBR(mbx, mby)
			if ref == vp8RefIntra {
				reconstructMacroblock(mbx, mby)
			} else {
				predictMacroblock(mbx, mby, m)
				addResiduals()
			}
			storeYBR(mbx, mby)
			setFilter(m, tokens)
		}

		// Copies the reconstructed macroblock from the workspace into the
		// planes.
		def storeYBR(mbx int, mby int) {
			let yo = mby * 16 * yStride + mbx * 16
			for let j = 0; j < 16; j++ {
				let s = (vp8YbrYY + j) * 32 + vp8YbrYX
				let d = yo + j * yStride
				for let i = 0; i < 16; i++ {
					y[d + i] = byte(ybr[s + i])
				}
			}
			let co = mby * 8 * cStride + mbx * 8
			for let j = 0; j < 8; j++ {
				let su = (vp8YbrBY + j) * 32 + vp8YbrBX
				let sv = (vp8YbrRY + j) * 32 + vp8YbrRX
				let d = co + j * cStride
				for let i = 0; i < 8; i++ {
					u[d + i] = byte(ybr[su + i])
					v[d + i] = byte(ybr[sv + i])
				}
			}
		}

		// Works out the loop filter strength of macroblock `m` from the
		// frame level, its segment, reference frame and kind.
		def setFilter(m int, tokens bool) {
			let o = m * 4
			let lv = level
			if useSegment {
				lv = relative ?? (lv + segFilter[segment], segFilter[segment])
				lv = vp8Clip(lv, 0, 63)
			}
			if useLFDelta {
				lv += refLFDelta[ref]
				if ref == vp8RefIntra {
					lv += modeLFDelta[0] when kind == vp8KindBPred
				} else if kind == vp8KindZero {
					lv += modeLFDelta[1]
				} else if kind == vp8KindSplit {
					lv += modeLFDelta[3]
				} else {
					lv += modeLFDelta[2]
				}
				lv = vp8Clip(lv, 0, 63)
			}
			if lv == 0 {
				mbFilter[o] = 0
				return
			}
			let il = lv
			if sharpness > 0 {
				il = sharpness > 4 ?? (il >> 2, il >> 1)
				il = 9 - sharpness when il > 9 - sharpness
			}
			il = 1 when il < 1
			let hev = 0
			if keyframe {
				hev = lv >= 40 ?? (2, lv >= 15 ?? (1, 0))
			} else {
				hev = lv >= 40 ?? (3, lv >= 20 ?? (2, lv >= 15 ?? (1, 0)))
			}
			mbFilter[o] = 2 * lv + il
			mbFilter[o + 1] = il
			mbFilter[o + 2] = hev
			mbFilter[o + 3] = (tokens || kind == vp8KindBPred || kind == vp8KindSplit) ?? (1, 0)
		}

		// Key frame modes: the whole-block and sub-block luma modes predicted
		// from the neighbours' modes, and the chroma mode.
		def parseKeyModes(mbx int) {
			ref = vp8RefIntra
			usePredY16 = fp.bit(145)
			if usePredY16 {
				kind = vp8KindIntra
				let p = 0
				if !fp.bit(156) {
					p = fp.bit(163) ?? (vp8PredVE, vp8PredDC)
				} else {
					p = fp.bit(128) ?? (vp8PredTM, vp8PredHE)
				}
				for let i = 0; i < 4; i++ {
					upPred[4 * mbx + i] = p
					leftPred[i] = p
				}
				predY16 = p
			} else {
				kind = vp8KindBPred
				for let j = 0; j < 4; j++ {
					let p = leftPred[j]
					for let i = 0; i < 4; i++ {
						p = readBMode(vp8BModeProb, (upPred[4 * mbx + i] * 10 + p) * 9)
						predY4[j * 4 + i] = p
						upPred[4 * mbx + i] = p
					}
					leftPred[j] = p
				}
			}
			predC8 = readUVMode(142, 114, 183)
		}

		// Intra modes of an inter frame, read with the frame's probabilities
		// and without neighbour contexts.
		def parseIntraModes() {
			ref = vp8RefIntra
			usePredY16 = true
			kind = vp8KindIntra
			if !fp.bit(yModeProb[0]) {
				predY16 = vp8PredDC
			} else if !fp.bit(yModeProb[1]) {
				predY16 = fp.bit(yModeProb[2]) ?? (vp8PredHE, vp8PredVE)
			} else if !fp.bit(yModeProb[3]) {
				predY16 = vp8PredTM
			} else {
				usePredY16 = false
				kind = vp8KindBPred
				for let n = 0; n < 16; n++ {
					predY4[n] = readBMode(vp8InterBModeProb, 0)
				}
			}
			predC8 = readUVMode(uvModeProb[0], uvModeProb[1], uvModeProb[2])
		}

		// Reads one sub-block intra mode with the nine tree probabilities at
		// `probs[at:]`.
		def readBMode(probs int[], at int) int {
			return vp8PredDC unless fp.bit(probs[at])
			return vp8PredTM unless fp.bit(probs[at + 1])
			return vp8PredVE unless fp.bit(probs[at + 2])
			if !fp.bit(probs[at + 3]) {
				return vp8PredHE unless fp.bit(probs[at + 4])
				return fp.bit(probs[at + 5]) ?? (vp8PredVR, vp8PredRD)
			}
			return vp8PredLD unless fp.bit(probs[at + 6])
			return vp8PredVL unless fp.bit(probs[at + 7])
			return fp.bit(probs[at + 8]) ?? (vp8PredHU, vp8PredHD)
		}

		def readUVMode(p0 int, p1 int, p2 int) int {
			return vp8PredDC unless fp.bit(p0)
			return vp8PredVE unless fp.bit(p1)
			return fp.bit(p2) ?? (vp8PredTM, vp8PredHE)
		}

		// Reads the coefficients of one 4x4 block into `coeff` from `base`,
		// and reports whether any was non-zero past the first position read.
		def residuals4(r Vp8BoolDecoder, plane int, context int, qdc int, qac int, skipFirst bool, base int) int {
			let n = skipFirst ?? (1, 0)
			let pb = plane * 264
			let p = pb + (vp8Bands[n] * 3 + context) * 11
			return 0 unless r.bit(tokenProb[p])
			for n != 16 {
				n++
				if !r.bit(tokenProb[p + 1]) {
					p = pb + vp8Bands[n] * 33
					continue
				}
				let val = 0
				if !r.bit(tokenProb[p + 2]) {
					val = 1
					p = pb + vp8Bands[n] * 33 + 11
				} else {
					if !r.bit(tokenProb[p + 3]) {
						if !r.bit(tokenProb[p + 4]) {
							val = 2
						} else {
							val = 3 + r.uint(tokenProb[p + 5], 1)
						}
					} else if !r.bit(tokenProb[p + 6]) {
						if !r.bit(tokenProb[p + 7]) {
							val = 5 + r.uint(159, 1)
						} else {
							val = 7 + 2 * r.uint(165, 1)
							val += r.uint(145, 1)
						}
					} else {
						let b1 = r.uint(tokenProb[p + 8], 1)
						let b0 = r.uint(tokenProb[p + 9 + b1], 1)
						let cat = 2 * b1 + b0
						let t = cat * 12
						for vp8Cat3456[t] != 0 {
							val = 2 * val + r.uint(vp8Cat3456[t], 1)
							t++
						}
						val += 3 + (8 << cat)
					}
					p = pb + vp8Bands[n] * 33 + 22
				}
				let z = vp8Zigzag[n - 1]
				let c = val * (z > 0 ?? (qac, qdc))
				c = 0 - c when r.bit(128)
				coeff[base + z] = c
				return 1 when n == 16 || !r.bit(tokenProb[p])
			}
			return 1
		}

		// Reads the coefficients of one macroblock and reports whether it
		// coded any.
		def parseResiduals(r Vp8BoolDecoder, mbx int) bool {
			let q = segment * 6
			let plane = vp8PlaneY1SansY2
			let any = 0
			if hasY2 {
				let nz = residuals4(r, vp8PlaneY2, leftNzY16 + upNzY16[mbx], quant[q + 2], quant[q + 3], false, 384)
				leftNzY16 = nz
				upNzY16[mbx] = nz
				any = nz
				inverseWHT16()
				plane = vp8PlaneY1WithY2
			}

			let dcMask = 0
			let acMask = 0
			let base = 0
			let lnz = leftNz & 15
			let unz = upNz[mbx] & 15
			for let j = 0; j < 4; j++ {
				let nz = (lnz >> j) & 1
				for let i = 0; i < 4; i++ {
					nz = residuals4(r, plane, nz + ((unz >> i) & 1), quant[q], quant[q + 1], hasY2, base)
					unz = (unz & (15 ^ (1 << i))) | (nz << i)
					acMask = acMask | (nz << (j * 4 + i))
					dcMask = dcMask | (1 << (j * 4 + i)) when coeff[base] != 0
					base += 16
				}
				lnz = (lnz & (15 ^ (1 << j))) | (nz << j)
			}
			let lnzC = leftNz >> 4
			let unzC = upNz[mbx] >> 4
			for let c = 0; c < 4; c += 2 {
				for let j = 0; j < 2; j++ {
					let nz = (lnzC >> (j + c)) & 1
					for let i = 0; i < 2; i++ {
						nz = residuals4(r, vp8PlaneUV, nz + ((unzC >> (i + c)) & 1), quant[q + 4], quant[q + 5], false, base)
						unzC = (unzC & (15 ^ (1 << (i + c)))) | (nz << (i + c))
						let bitPos = 16 + c * 2 + j * 2 + i
						acMask = acMask | (nz << bitPos)
						dcMask = dcMask | (1 << bitPos) when coeff[base] != 0
						base += 16
					}
					lnzC = (lnzC & (15 ^ (1 << (j + c)))) | (nz << (j + c))
				}
			}
			leftNz = lnz | (lnzC << 4)
			upNz[mbx] = unz | (unzC << 4)
			nzDCMask = dcMask
			nzACMask = acMask
			return (any | acMask) != 0
		}

		// Loads the neighbouring pixels of the macroblock into the workspace.
		def prepareYBR(mbx int, mby int) {
			if mbx == 0 {
				for let j = 0; j < 17; j++ {
					ybr[j * 32 + 7] = 0x81
				}
				for let j = 17; j < 26; j++ {
					ybr[j * 32 + 7] = 0x81
					ybr[j * 32 + 23] = 0x81
				}
			} else {
				for let j = 0; j < 17; j++ {
					ybr[j * 32 + 7] = ybr[j * 32 + 23]
				}
				for let j = 17; j < 26; j++ {
					ybr[j * 32 + 7] = ybr[j * 32 + 15]
					ybr[j * 32 + 23] = ybr[j * 32 + 31]
				}
			}
			if mby == 0 {
				for let i = 7; i < 28; i++ {
					ybr[i] = 0x7f
				}
				for let i = 7; i < 16; i++ {
					ybr[17 * 32 + i] = 0x7f
				}
				for let i = 23; i < 32; i++ {
					ybr[17 * 32 + i] = 0x7f
				}
			} else {
				let yo = (16 * mby - 1) * yStride + 16 * mbx
				for let i = 0; i < 16; i++ {
					ybr[8 + i] = int(y[yo + i])
				}
				let co = (8 * mby - 1) * cStride + 8 * mbx
				for let i = 0; i < 8; i++ {
					ybr[17 * 32 + 8 + i] = int(u[co + i])
					ybr[17 * 32 + 24 + i] = int(v[co + i])
				}
				for let i = 16; i < 20; i++ {
					ybr[8 + i] = int(y[yo + (mbx == mbw - 1 ?? (15, i))])
				}
			}
			for let j = 4; j < 16; j += 4 {
				for let i = 24; i < 28; i++ {
					ybr[j * 32 + i] = ybr[i]
				}
			}
		}

		def reconstructMacroblock(mbx int, mby int) {
			vp8Predict16(ybr, vp8EdgePred(mbx, mby, predY16)) when usePredY16
			for let j = 0; j < 4; j++ {
				for let i = 0; i < 4; i++ {
					let n = 4 * j + i
					let at = (4 * j + 1) * 32 + 4 * i + 8
					vp8Predict4(ybr, predY4[n], at) unless usePredY16
					if (nzACMask & (1 << n)) != 0 {
						vp8InverseDCT4(ybr, at, coeff, 16 * n)
					} else if (nzDCMask & (1 << n)) != 0 {
						vp8InverseDCT4DC(ybr, at, coeff, 16 * n)
					}
				}
			}
			let p = vp8EdgePred(mbx, mby, predC8)
			vp8Predict8(ybr, p, vp8YbrBY * 32 + vp8YbrBX)
			vp8InverseDCT8(ybr, vp8YbrBY * 32 + vp8YbrBX, coeff, 256, nzACMask >> 16, nzDCMask >> 16)
			vp8Predict8(ybr, p, vp8YbrRY * 32 + vp8YbrRX)
			vp8InverseDCT8(ybr, vp8YbrRY * 32 + vp8YbrRX, coeff, 320, nzACMask >> 20, nzDCMask >> 20)
		}

		// Adds the residuals of an inter macroblock to its prediction.
		def addResiduals() {
			for let n = 0; n < 16; n++ {
				let at = (4 * (n >> 2) + 1) * 32 + 4 * (n & 3) + 8
				if (nzACMask & (1 << n)) != 0 {
					vp8InverseDCT4(ybr, at, coeff, 16 * n)
				} else if (nzDCMask & (1 << n)) != 0 {
					vp8InverseDCT4DC(ybr, at, coeff, 16 * n)
				}
			}
			vp8InverseDCT8(ybr, vp8YbrBY * 32 + vp8YbrBX, coeff, 256, nzACMask >> 16, nzDCMask >> 16)
			vp8InverseDCT8(ybr, vp8YbrRY * 32 + vp8YbrRX, coeff, 320, nzACMask >> 20, nzDCMask >> 20)
		}

		def simpleFilter() {
			for let mby = 0; mby < mbh; mby++ {
				for let mbx = 0; mbx < mbw; mbx++ {
					let m = (mby * mbw + mbx) * 4
					let l = mbFilter[m]
					continue when l == 0
					let inner = mbFilter[m + 3] != 0
					let yi = (mby * yStride + mbx) * 16
					vp8Filter2(y, l + 4, yi, yStride, 1) when mbx > 0
					if inner {
						vp8Filter2(y, l, yi + 4, yStride, 1)
						vp8Filter2(y, l, yi + 8, yStride, 1)
						vp8Filter2(y, l, yi + 12, yStride, 1)
					}
					vp8Filter2(y, l + 4, yi, 1, yStride) when mby > 0
					if inner {
						vp8Filter2(y, l, yi + yStride * 4, 1, yStride)
						vp8Filter2(y, l, yi + yStride * 8, 1, yStride)
						vp8Filter2(y, l, yi + yStride * 12, 1, yStride)
					}
				}
			}
		}

		def normalFilter() {
			for let mby = 0; mby < mbh; mby++ {
				for let mbx = 0; mbx < mbw; mbx++ {
					let m = (mby * mbw + mbx) * 4
					let l = mbFilter[m]
					continue when l == 0
					let il = mbFilter[m + 1]
					let hl = mbFilter[m + 2]
					let inner = mbFilter[m + 3] != 0
					let yi = (mby * yStride + mbx) * 16
					let ci = (mby * cStride + mbx) * 8
					if mbx > 0 {
						vp8Filter246(y, 16, l + 4, il, hl, yi, yStride, 1, false)
						vp8Filter246(u, 8, l + 4, il, hl, ci, cStride, 1, false)
						vp8Filter246(v, 8, l + 4, il, hl, ci, cStride, 1, false)
					}
					if inner {
						vp8Filter246(y, 16, l, il, hl, yi + 4, yStride, 1, true)
						vp8Filter246(y, 16, l, il, hl, yi + 8, yStride, 1, true)
						vp8Filter246(y, 16, l, il, hl, yi + 12, yStride, 1, true)
						vp8Filter246(u, 8, l, il, hl, ci + 4, cStride, 1, true)
						vp8Filter246(v, 8, l, il, hl, ci + 4, cStride, 1, true)
					}
					if mby > 0 {
						vp8Filter246(y, 16, l + 4, il, hl, yi, 1, yStride, false)
						vp8Filter246(u, 8, l + 4, il, hl, ci, 1, cStride, false)
						vp8Filter246(v, 8, l + 4, il, hl, ci, 1, cStride, false)
					}
					if inner {
						vp8Filter246(y, 16, l, il, hl, yi + yStride * 4, 1, yStride, true)
						vp8Filter246(y, 16, l, il, hl, yi + yStride * 8, 1, yStride, true)
						vp8Filter246(y, 16, l, il, hl, yi + yStride * 12, 1, yStride, true)
						vp8Filter246(u, 8, l, il, hl, ci + cStride * 4, 1, cStride, true)
						vp8Filter246(v, 8, l, il, hl, ci + cStride * 4, 1, cStride, true)
					}
				}
			}
		}

		// Inter modes: the reference frame, then the vector mode against the
		// candidates the neighbours give.
		def parseInterModes(mbx int, mby int, m int) {
			ref = vp8RefLast
			ref = fp.bit(probGolden) ?? (vp8RefAltRef, vp8RefGolden) when fp.bit(probLast)
			nearIdx = 0
			nearR.fill(0)
			nearC.fill(0)
			cnt.fill(0)
			vote(m - mbw, 2) when mby > 0
			vote(m - 1, 2) when mbx > 0
			vote(m - mbw - 1, 1) when mbx > 0 && mby > 0

			if !fp.bit(vp8ModeContexts[cnt[0] * 4]) {
				kind = vp8KindZero
				mvR[m] = 0
				mvC[m] = 0
				return
			}
			kind = vp8KindMv
			cnt[1] += 1 when cnt[3] > 0 && nearR[1] == nearR[3] && nearC[1] == nearC[3]
			if cnt[2] > cnt[1] {
				let t = cnt[1]
				cnt[1] = cnt[2]
				cnt[2] = t
				t = nearR[1]
				nearR[1] = nearR[2]
				nearR[2] = t
				t = nearC[1]
				nearC[1] = nearC[2]
				nearC[2] = t
			}
			let pick = 1
			if fp.bit(vp8ModeContexts[cnt[1] * 4 + 1]) {
				pick = 2
				if fp.bit(vp8ModeContexts[cnt[2] * 4 + 2]) {
					let b = cnt[1] >= cnt[0] ?? (1, 0)
					let bestR = clampRow(nearR[b], mby)
					let bestC = clampCol(nearC[b], mbx)
					let splits = 0
					splits += 2 when mby > 0 && mbKind[m - mbw] == vp8KindSplit
					splits += 2 when mbx > 0 && mbKind[m - 1] == vp8KindSplit
					splits += 1 when mbx > 0 && mby > 0 && mbKind[m - mbw - 1] == vp8KindSplit
					if fp.bit(vp8ModeContexts[splits * 4 + 3]) {
						kind = vp8KindSplit
						parseSplit(mbx, mby, m, bestR, bestC)
					} else {
						mvR[m] = bestR + readMv(0)
						mvC[m] = bestC + readMv(19)
					}
					return
				}
			}
			mvR[m] = clampRow(nearR[pick], mby)
			mvC[m] = clampCol(nearC[pick], mbx)
		}

		// Counts the vector of neighbour `n` towards the candidates, flipped
		// when its reference frame has the other sign bias.
		def vote(n int, weight int) {
			let nr = mbRef[n]
			return when nr == vp8RefIntra
			let r = mvR[n]
			let c = mvC[n]
			if r == 0 && c == 0 {
				cnt[0] += weight
				return
			}
			if signBias[nr] != signBias[ref] {
				r = 0 - r
				c = 0 - c
			}
			if r != nearR[nearIdx] || c != nearC[nearIdx] {
				nearIdx++
				nearR[nearIdx] = r
				nearC[nearIdx] = c
			}
			cnt[nearIdx] += weight
		}

		// Keeps a vector row within 16 pixels past the frame, in quarter
		// pixels.
		def clampRow(r int, mby int) int {
			return vp8Clip(r, 0 - (mby << 6) - 64, ((mbh - 1 - mby) << 6) + 64)
		}

		def clampCol(c int, mbx int) int {
			return vp8Clip(c, 0 - (mbx << 6) - 64, ((mbw - 1 - mbx) << 6) + 64)
		}

		// Reads one vector component with the probabilities at
		// `mvProb[p:]`: rows at 0, columns at 19.
		def readMv(p int) int {
			let x = 0
			if fp.bit(mvProb[p]) {
				for let i = 0; i < 3; i++ {
					x += 1 << i when fp.bit(mvProb[p + 9 + i])
				}
				for let i = 9; i > 3; i-- {
					x += 1 << i when fp.bit(mvProb[p + 9 + i])
				}
				x += 8 when (x & 0xfff0) == 0 || fp.bit(mvProb[p + 12])
			} else if !fp.bit(mvProb[p + 2]) {
				x = fp.bit(mvProb[p + 3]) ?? (2 + fp.uint(mvProb[p + 5], 1), fp.uint(mvProb[p + 4], 1))
			} else {
				x = fp.bit(mvProb[p + 6]) ?? (6 + fp.uint(mvProb[p + 8], 1), 4 + fp.uint(mvProb[p + 7], 1))
			}
			return (x != 0 && fp.bit(mvProb[p + 1])) ?? (0 - x, x)
		}

		// The vector of 4x4 block `b` of macroblock `n` in the frame.
		def blockMvR(n int, b int) int {
			return (mbKind[n] == vp8KindSplit) ?? (bmvR[n * 16 + b], mvR[n])
		}

		def blockMvC(n int, b int) int {
			return (mbKind[n] == vp8KindSplit) ?? (bmvC[n * 16 + b], mvC[n])
		}

		// Reads a split macroblock's layout and the vector of each partition,
		// each coded against the vectors left of and above its first block.
		def parseSplit(mbx int, mby int, m int, bestR int, bestC int) {
			let part = 3
			part = fp.bit(vp8MbSplitProb[1]) ?? (fp.bit(vp8MbSplitProb[2]) ?? (1, 0), 2) when fp.bit(vp8MbSplitProb[0])
			let layout = part * 16
			let count = vp8MbSplitCount[part]
			for let n = 0; n < count; n++ {
				let k = vp8MbSplitFirst[layout + n]
				let lr = 0
				let lc = 0
				if (k & 3) != 0 {
					let pl = vp8MbSplits[layout + k - 1]
					lr = partR[pl]
					lc = partC[pl]
				} else if mbx > 0 {
					lr = blockMvR(m - 1, k + 3)
					lc = blockMvC(m - 1, k + 3)
				}
				let ar = 0
				let ac = 0
				if k >= 4 {
					let pa = vp8MbSplits[layout + k - 4]
					ar = partR[pa]
					ac = partC[pa]
				} else if mby > 0 {
					ar = blockMvR(m - mbw, k + 12)
					ac = blockMvC(m - mbw, k + 12)
				}
				let ctx = 0
				if lr == ar && lc == ac {
					ctx = (lr == 0 && lc == 0) ?? (4, 3)
				} else if ar == 0 && ac == 0 {
					ctx = 2
				} else if lr == 0 && lc == 0 {
					ctx = 1
				}
				let p = ctx * 3
				if !fp.bit(vp8SubMvProb[p]) {
					partR[n] = lr
					partC[n] = lc
				} else if !fp.bit(vp8SubMvProb[p + 1]) {
					partR[n] = ar
					partC[n] = ac
				} else if !fp.bit(vp8SubMvProb[p + 2]) {
					partR[n] = 0
					partC[n] = 0
				} else {
					partR[n] = bestR + readMv(0)
					partC[n] = bestC + readMv(19)
				}
			}
			let o = m * 16
			for let b = 0; b < 16; b++ {
				let pb = vp8MbSplits[layout + b]
				bmvR[o + b] = partR[pb]
				bmvC[o + b] = partC[pb]
			}
			mvR[m] = partR[count - 1]
			mvC[m] = partC[count - 1]
		}

		// Predicts an inter macroblock into the workspace from its reference
		// frame.
		def predictMacroblock(mbx int, mby int, m int) {
			let pic = refs[ref]
			let pw = yStride
			let ph = 16 * mbh
			let cw = cStride
			let chh = 8 * mbh
			let x = mbx * 16
			let yy = mby * 16
			let yAt = vp8YbrYY * 32 + vp8YbrYX
			let uAt = vp8YbrBY * 32 + vp8YbrBX
			let vAt = vp8YbrRY * 32 + vp8YbrRX
			if kind != vp8KindSplit {
				let r = mvR[m]
				let c = mvC[m]
				predictBlock(pic.y, pw, ph, x, yy, 16, 16, c * 2, r * 2, yAt)
				let ur = r
				let uc = c
				if fullPixel {
					ur = ur & (0 - 8)
					uc = uc & (0 - 8)
				}
				predictBlock(pic.u, cw, chh, x >> 1, yy >> 1, 8, 8, uc, ur, uAt)
				predictBlock(pic.v, cw, chh, x >> 1, yy >> 1, 8, 8, uc, ur, vAt)
				return
			}
			let o = m * 16
			for let b = 0; b < 16; b++ {
				let bx = (b & 3) * 4
				let by = (b >> 2) * 4
				predictBlock(pic.y, pw, ph, x + bx, yy + by, 4, 4, bmvC[o + b] * 2, bmvR[o + b] * 2, yAt + by * 32 + bx)
			}
			for let j = 0; j < 2; j++ {
				for let i = 0; i < 2; i++ {
					let b = o + j * 8 + i * 2
					let sr = bmvR[b] + bmvR[b + 1] + bmvR[b + 4] + bmvR[b + 5]
					let sc = bmvC[b] + bmvC[b + 1] + bmvC[b + 4] + bmvC[b + 5]
					let ur = (sr + 2 - (sr < 0 ?? (1, 0))) >> 2
					let uc = (sc + 2 - (sc < 0 ?? (1, 0))) >> 2
					if fullPixel {
						ur = ur & (0 - 8)
						uc = uc & (0 - 8)
					}
					let off = j * 4 * 32 + i * 4
					predictBlock(pic.u, cw, chh, (x >> 1) + i * 4, (yy >> 1) + j * 4, 4, 4, uc, ur, uAt + off)
					predictBlock(pic.v, cw, chh, (x >> 1) + i * 4, (yy >> 1) + j * 4, 4, 4, uc, ur, vAt + off)
				}
			}
		}

		// Predicts a `w` x `h` block of a `pw` x `ph` reference plane into the
		// workspace at `at`: the block at (`x`, `y`) moved by (`mx`, `my`)
		// eighth pixels, with the plane's edge pixels repeated outside it.
		def predictBlock(ref byte[], pw int, ph int, x int, y int, w int, h int, mx int, my int, at int) {
			let fx = mx & 7
			let fy = my & 7
			let sx = x + (mx >> 3)
			let sy = y + (my >> 3)
			let src = ref
			let ss = pw
			let s0 = sy * pw + sx
			if sx < 2 || sy < 2 || sx + w + 3 > pw || sy + h + 3 > ph {
				for let j = 0; j < h + 5; j++ {
					let ry = vp8Clip(sy - 2 + j, 0, ph - 1) * pw
					let e = j * 21
					for let i = 0; i < w + 5; i++ {
						edge[e + i] = ref[ry + vp8Clip(sx - 2 + i, 0, pw - 1)]
					}
				}
				src = edge
				ss = 21
				s0 = 2 * 21 + 2
			}
			if fx == 0 && fy == 0 {
				for let j = 0; j < h; j++ {
					let s = s0 + j * ss
					let d = at + j * 32
					for let i = 0; i < w; i++ {
						ybr[d + i] = int(src[s + i])
					}
				}
			} else if bilinear {
				vp8Bilinear(src, s0, ss, ybr, at, w, h, fx, fy, tmp)
			} else {
				vp8SixTap2D(src, s0, ss, ybr, at, w, h, fx, fy, tmp)
			}
		}

		def inverseWHT16() {
			let m = tmp
			for let i = 0; i < 4; i++ {
				let a0 = coeff[384 + i] + coeff[384 + 12 + i]
				let a1 = coeff[384 + 4 + i] + coeff[384 + 8 + i]
				let a2 = coeff[384 + 4 + i] - coeff[384 + 8 + i]
				let a3 = coeff[384 + i] - coeff[384 + 12 + i]
				m[i] = a0 + a1
				m[8 + i] = a0 - a1
				m[4 + i] = a3 + a2
				m[12 + i] = a3 - a2
			}
			let out = 0
			for let i = 0; i < 4; i++ {
				let dc = m[i * 4] + 3
				let a0 = dc + m[3 + i * 4]
				let a1 = m[1 + i * 4] + m[2 + i * 4]
				let a2 = m[1 + i * 4] - m[2 + i * 4]
				let a3 = dc - m[3 + i * 4]
				coeff[out] = (a0 + a1) >> 3
				coeff[out + 16] = (a3 + a2) >> 3
				coeff[out + 32] = (a0 - a1) >> 3
				coeff[out + 48] = (a3 - a2) >> 3
				out += 64
			}
		}
	}
}
