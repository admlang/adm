internal std.formats partial module std.formats.vp8 {
	def vp8Zeros(n int) int[] {
		let a int[]
		a.len(n)
		a.fill(0)
		return a
	}

	def vp8Bytes(n int) byte[] {
		let a byte[]
		a.len(n)
		a.fill(byte(0))
		return a
	}

	// The DC mode as the macroblock's position allows it: without the row
	// above or the column to the left, only the other one is averaged.
	def vp8EdgePred(mbx int, mby int, p int) int {
		return p when p != vp8PredDC
		return mby == 0 ?? (vp8PredDCTopLeft, vp8PredDCLeft) when mbx == 0
		return mby == 0 ?? (vp8PredDCTop, vp8PredDC)
	}

	// Fills an `n` x `n` block of the workspace with one value.
	def vp8Flat(ybr int[], at int, n int, value int) {
		for let j = 0; j < n; j++ {
			let r = at + j * 32
			for let i = 0; i < n; i++ {
				ybr[r + i] = value
			}
		}
	}

	// Predicts an `n` x `n` block (8 or 16) at `at` with a whole-block mode.
	def vp8PredictBlock(ybr int[], mode int, at int, n int, shift int) {
		let top = at - 32
		if mode == vp8PredDC || mode == vp8PredDCTop || mode == vp8PredDCLeft {
			let sum = 0
			let s = shift
			if mode != vp8PredDCTop {
				for let i = 0; i < n; i++ {
					sum += ybr[top + i]
				}
			}
			if mode != vp8PredDCLeft {
				for let j = 0; j < n; j++ {
					sum += ybr[at + j * 32 - 1]
				}
			}
			s -= 1 when mode != vp8PredDC
			vp8Flat(ybr, at, n, (sum + (1 << (s - 1))) >> s)
		} else if mode == vp8PredDCTopLeft {
			vp8Flat(ybr, at, n, 0x80)
		} else if mode == vp8PredTM {
			let corner = ybr[top - 1]
			for let j = 0; j < n; j++ {
				let r = at + j * 32
				let left = ybr[r - 1] - corner
				for let i = 0; i < n; i++ {
					ybr[r + i] = vp8Clip(left + ybr[top + i], 0, 255)
				}
			}
		} else if mode == vp8PredVE {
			for let j = 0; j < n; j++ {
				let r = at + j * 32
				for let i = 0; i < n; i++ {
					ybr[r + i] = ybr[top + i]
				}
			}
		} else {
			for let j = 0; j < n; j++ {
				let r = at + j * 32
				let left = ybr[r - 1]
				for let i = 0; i < n; i++ {
					ybr[r + i] = left
				}
			}
		}
	}

	def vp8Predict16(ybr int[], mode int) {
		vp8PredictBlock(ybr, mode, vp8YbrYY * 32 + vp8YbrYX, 16, 5)
	}

	def vp8Predict8(ybr int[], mode int, at int) {
		vp8PredictBlock(ybr, mode, at, 8, 4)
	}

	// Writes one row of four pixels of a 4x4 block.
	def vp8Row4(ybr int[], at int, a int, b int, c int, d int) {
		ybr[at] = a
		ybr[at + 1] = b
		ybr[at + 2] = c
		ybr[at + 3] = d
	}

	def vp8Avg3(a int, b int, c int) int {
		return (a + 2 * b + c + 2) >> 2
	}

	def vp8Avg2(a int, b int) int {
		return (a + b + 1) >> 1
	}

	// Predicts a 4x4 luma sub-block at `at` with one of the ten sub-block
	// modes.
	def vp8Predict4(ybr int[], mode int, at int) {
		let top = at - 32
		if mode == vp8PredDC {
			let sum = 4
			for let i = 0; i < 4; i++ {
				sum += ybr[top + i] + ybr[at + i * 32 - 1]
			}
			vp8Flat(ybr, at, 4, sum >> 3)
			return
		}
		if mode == vp8PredTM {
			vp8PredictBlock(ybr, vp8PredTM, at, 4, 0)
			return
		}
		// Edge pixels: A..H along the top from the corner-right, I..L down
		// the left, X the corner.
		let x = ybr[top - 1]
		let a = ybr[top]
		let b = ybr[top + 1]
		let c = ybr[top + 2]
		let d = ybr[top + 3]
		let e = ybr[top + 4]
		let f = ybr[top + 5]
		let g = ybr[top + 6]
		let h = ybr[top + 7]
		let i = ybr[at - 1]
		let j = ybr[at + 31]
		let k = ybr[at + 63]
		let l = ybr[at + 95]
		if mode == vp8PredVE {
			let v0 = vp8Avg3(x, a, b)
			let v1 = vp8Avg3(a, b, c)
			let v2 = vp8Avg3(b, c, d)
			let v3 = vp8Avg3(c, d, e)
			vp8Row4(ybr, at, v0, v1, v2, v3)
			vp8Row4(ybr, at + 32, v0, v1, v2, v3)
			vp8Row4(ybr, at + 64, v0, v1, v2, v3)
			vp8Row4(ybr, at + 96, v0, v1, v2, v3)
		} else if mode == vp8PredHE {
			let h0 = vp8Avg3(x, i, j)
			let h1 = vp8Avg3(i, j, k)
			let h2 = vp8Avg3(j, k, l)
			let h3 = vp8Avg3(k, l, l)
			vp8Row4(ybr, at, h0, h0, h0, h0)
			vp8Row4(ybr, at + 32, h1, h1, h1, h1)
			vp8Row4(ybr, at + 64, h2, h2, h2, h2)
			vp8Row4(ybr, at + 96, h3, h3, h3, h3)
		} else if mode == vp8PredRD {
			let lkj = vp8Avg3(l, k, j)
			let kji = vp8Avg3(k, j, i)
			let jix = vp8Avg3(j, i, x)
			let ixa = vp8Avg3(i, x, a)
			let xab = vp8Avg3(x, a, b)
			let abc = vp8Avg3(a, b, c)
			let bcd = vp8Avg3(b, c, d)
			vp8Row4(ybr, at, ixa, xab, abc, bcd)
			vp8Row4(ybr, at + 32, jix, ixa, xab, abc)
			vp8Row4(ybr, at + 64, kji, jix, ixa, xab)
			vp8Row4(ybr, at + 96, lkj, kji, jix, ixa)
		} else if mode == vp8PredVR {
			let xa = vp8Avg2(x, a)
			let ab = vp8Avg2(a, b)
			let bc = vp8Avg2(b, c)
			let cd = vp8Avg2(c, d)
			let kji = vp8Avg3(k, j, i)
			let jix = vp8Avg3(j, i, x)
			let ixa = vp8Avg3(i, x, a)
			let xab = vp8Avg3(x, a, b)
			let abc = vp8Avg3(a, b, c)
			let bcd = vp8Avg3(b, c, d)
			vp8Row4(ybr, at, xa, ab, bc, cd)
			vp8Row4(ybr, at + 32, ixa, xab, abc, bcd)
			vp8Row4(ybr, at + 64, jix, xa, ab, bc)
			vp8Row4(ybr, at + 96, kji, ixa, xab, abc)
		} else if mode == vp8PredLD {
			let abc = vp8Avg3(a, b, c)
			let bcd = vp8Avg3(b, c, d)
			let cde = vp8Avg3(c, d, e)
			let vdef = vp8Avg3(d, e, f)
			let efg = vp8Avg3(e, f, g)
			let fgh = vp8Avg3(f, g, h)
			let ghh = vp8Avg3(g, h, h)
			vp8Row4(ybr, at, abc, bcd, cde, vdef)
			vp8Row4(ybr, at + 32, bcd, cde, vdef, efg)
			vp8Row4(ybr, at + 64, cde, vdef, efg, fgh)
			vp8Row4(ybr, at + 96, vdef, efg, fgh, ghh)
		} else if mode == vp8PredVL {
			let ab = vp8Avg2(a, b)
			let bc = vp8Avg2(b, c)
			let cd = vp8Avg2(c, d)
			let de = vp8Avg2(d, e)
			let abc = vp8Avg3(a, b, c)
			let bcd = vp8Avg3(b, c, d)
			let cde = vp8Avg3(c, d, e)
			let vdef = vp8Avg3(d, e, f)
			let efg = vp8Avg3(e, f, g)
			let fgh = vp8Avg3(f, g, h)
			vp8Row4(ybr, at, ab, bc, cd, de)
			vp8Row4(ybr, at + 32, abc, bcd, cde, vdef)
			vp8Row4(ybr, at + 64, bc, cd, de, efg)
			vp8Row4(ybr, at + 96, bcd, cde, vdef, fgh)
		} else if mode == vp8PredHD {
			let lk = vp8Avg2(l, k)
			let kj = vp8Avg2(k, j)
			let ji = vp8Avg2(j, i)
			let ix = vp8Avg2(i, x)
			let lkj = vp8Avg3(l, k, j)
			let kji = vp8Avg3(k, j, i)
			let jix = vp8Avg3(j, i, x)
			let ixa = vp8Avg3(i, x, a)
			let xab = vp8Avg3(x, a, b)
			let abc = vp8Avg3(a, b, c)
			vp8Row4(ybr, at, ix, ixa, xab, abc)
			vp8Row4(ybr, at + 32, ji, jix, ix, ixa)
			vp8Row4(ybr, at + 64, kj, kji, ji, jix)
			vp8Row4(ybr, at + 96, lk, lkj, kj, kji)
		} else {
			let ij = vp8Avg2(i, j)
			let jk = vp8Avg2(j, k)
			let kl = vp8Avg2(k, l)
			let ijk = vp8Avg3(i, j, k)
			let jkl = vp8Avg3(j, k, l)
			let kll = vp8Avg3(k, l, l)
			vp8Row4(ybr, at, ij, ijk, jk, jkl)
			vp8Row4(ybr, at + 32, jk, jkl, kl, kll)
			vp8Row4(ybr, at + 64, kl, kll, l, l)
			vp8Row4(ybr, at + 96, l, l, l, l)
		}
	}

	// Adds the inverse transform of the coefficients at `base` to the 4x4
	// block at `at`.
	def vp8InverseDCT4(ybr int[], at int, coeff int[], base int) {
		let (a0, a1, a2, a3) = vp8Idct4Column(coeff, base)
		let (b0, b1, b2, b3) = vp8Idct4Column(coeff, base + 1)
		let (c0, c1, c2, c3) = vp8Idct4Column(coeff, base + 2)
		let (d0, d1, d2, d3) = vp8Idct4Column(coeff, base + 3)
		vp8Idct4Row(ybr, at, a0, b0, c0, d0)
		vp8Idct4Row(ybr, at + 32, a1, b1, c1, d1)
		vp8Idct4Row(ybr, at + 64, a2, b2, c2, d2)
		vp8Idct4Row(ybr, at + 96, a3, b3, c3, d3)
	}

	// The vertical pass of the inverse transform over one column of
	// coefficients.
	def vp8Idct4Column(coeff int[], at int) (int, int, int, int) {
		let c0 = coeff[at]
		let c4 = coeff[at + 4]
		let c8 = coeff[at + 8]
		let c12 = coeff[at + 12]
		let a = c0 + c8
		let b = c0 - c8
		let c = ((c4 * 35468) >> 16) - ((c12 * 85627) >> 16)
		let d = ((c4 * 85627) >> 16) + ((c12 * 35468) >> 16)
		return (a + d, b + c, b - c, a - d)
	}

	// The horizontal pass over one row of the column results, added to the
	// prediction row at `at`.
	def vp8Idct4Row(ybr int[], at int, m0 int, m1 int, m2 int, m3 int) {
		let dc = m0 + 4
		let a = dc + m2
		let b = dc - m2
		let c = ((m1 * 35468) >> 16) - ((m3 * 85627) >> 16)
		let d = ((m1 * 85627) >> 16) + ((m3 * 35468) >> 16)
		let v0 = ybr[at] + ((a + d) >> 3)
		let v1 = ybr[at + 1] + ((b + c) >> 3)
		let v2 = ybr[at + 2] + ((b - c) >> 3)
		let v3 = ybr[at + 3] + ((a - d) >> 3)
		ybr[at] = v0 < 0 ?? (0, v0 > 255 ?? (255, v0))
		ybr[at + 1] = v1 < 0 ?? (0, v1 > 255 ?? (255, v1))
		ybr[at + 2] = v2 < 0 ?? (0, v2 > 255 ?? (255, v2))
		ybr[at + 3] = v3 < 0 ?? (0, v3 > 255 ?? (255, v3))
	}

	// The inverse transform of a block whose only coefficient is the DC.
	def vp8InverseDCT4DC(ybr int[], at int, coeff int[], base int) {
		let dc = (coeff[base] + 4) >> 3
		for let j = 0; j < 4; j++ {
			let r = at + j * 32
			for let i = 0; i < 4; i++ {
				ybr[r + i] = vp8Clip(ybr[r + i] + dc, 0, 255)
			}
		}
	}

	// The inverse transforms of the four 4x4 blocks of an 8x8 chroma block;
	// `ac` and `dc` carry their non-zero flags in the low four bits.
	def vp8InverseDCT8(ybr int[], at int, coeff int[], base int, ac int, dc int) {
		if (ac & 15) != 0 {
			vp8InverseDCT4(ybr, at, coeff, base)
			vp8InverseDCT4(ybr, at + 4, coeff, base + 16)
			vp8InverseDCT4(ybr, at + 128, coeff, base + 32)
			vp8InverseDCT4(ybr, at + 132, coeff, base + 48)
		} else if (dc & 15) != 0 {
			vp8InverseDCT4DC(ybr, at, coeff, base)
			vp8InverseDCT4DC(ybr, at + 4, coeff, base + 16)
			vp8InverseDCT4DC(ybr, at + 128, coeff, base + 32)
			vp8InverseDCT4DC(ybr, at + 132, coeff, base + 48)
		}
	}

	def vp8Clamp15(x int) int {
		return vp8Clip(x, -16, 15)
	}

	def vp8Clamp127(x int) int {
		return vp8Clip(x, -128, 127)
	}

	// The simple loop filter across one 16-pixel edge: `index` is the first
	// pixel past the edge, `iStep` walks along it and `jStep` across it.
	def vp8Filter2(pix byte[], level int, index int, iStep int, jStep int) {
		let at = index
		for let n = 0; n < 16; n++ {
			let p1 = int(pix[at - 2 * jStep])
			let p0 = int(pix[at - jStep])
			let q0 = int(pix[at])
			let q1 = int(pix[at + jStep])
			if (vp8Abs(p0 - q0) << 1) + (vp8Abs(p1 - q1) >> 1) <= level {
				let a = 3 * (q0 - p0) + vp8Clamp127(p1 - q1)
				let a1 = vp8Clamp15((a + 4) >> 3)
				let a2 = vp8Clamp15((a + 3) >> 3)
				pix[at - jStep] = byte(vp8Clip(p0 + a2, 0, 255))
				pix[at] = byte(vp8Clip(q0 - a1, 0, 255))
			}
			at += iStep
		}
	}

	// The normal loop filter across an edge of `n` pixels: macroblock edges
	// adjust up to three pixels each side, inner edges (`inner`) up to two.
	def vp8Filter246(pix byte[], n int, level int, ilevel int, hlevel int, index int, iStep int, jStep int, inner bool) {
		let at = index
		let j2 = 2 * jStep
		let j3 = 3 * jStep
		for let k = 0; k < n; k++ {
			let p1 = int(pix[at - j2])
			let p0 = int(pix[at - jStep])
			let q0 = int(pix[at])
			let q1 = int(pix[at + jStep])
			let d0 = p0 - q0
			let d1 = p1 - q1
			let e = (d0 < 0 ?? (0 - d0, d0)) * 2 + ((d1 < 0 ?? (0 - d1, d1)) >> 1)
			if e > level {
				at += iStep
				continue
			}
			let p3 = int(pix[at - 4 * jStep])
			let p2 = int(pix[at - j3])
			let q2 = int(pix[at + j2])
			let q3 = int(pix[at + j3])
			let a32 = p3 - p2
			let a21 = p2 - p1
			let a10 = p1 - p0
			let b10 = q1 - q0
			let b21 = q2 - q1
			let b32 = q3 - q2
			a32 = 0 - a32 when a32 < 0
			a21 = 0 - a21 when a21 < 0
			a10 = 0 - a10 when a10 < 0
			b10 = 0 - b10 when b10 < 0
			b21 = 0 - b21 when b21 < 0
			b32 = 0 - b32 when b32 < 0
			if a32 > ilevel || a21 > ilevel || a10 > ilevel || b10 > ilevel || b21 > ilevel || b32 > ilevel {
				at += iStep
				continue
			}
			let c = d1 < -128 ?? (-128, d1 > 127 ?? (127, d1))
			if a10 > hlevel || b10 > hlevel {
				let a = 3 * (q0 - p0) + c
				let a1 = (a + 4) >> 3
				let a2 = (a + 3) >> 3
				a1 = a1 < -16 ?? (-16, a1 > 15 ?? (15, a1))
				a2 = a2 < -16 ?? (-16, a2 > 15 ?? (15, a2))
				pix[at - jStep] = vp8ClampByte(p0 + a2)
				pix[at] = vp8ClampByte(q0 - a1)
			} else if inner {
				let a = 3 * (q0 - p0)
				let a1 = (a + 4) >> 3
				let a2 = (a + 3) >> 3
				a1 = a1 < -16 ?? (-16, a1 > 15 ?? (15, a1))
				a2 = a2 < -16 ?? (-16, a2 > 15 ?? (15, a2))
				let a3 = (a1 + 1) >> 1
				pix[at - j2] = vp8ClampByte(p1 + a3)
				pix[at - jStep] = vp8ClampByte(p0 + a2)
				pix[at] = vp8ClampByte(q0 - a1)
				pix[at + jStep] = vp8ClampByte(q1 - a3)
			} else {
				let a = 3 * (q0 - p0) + c
				a = a < -128 ?? (-128, a > 127 ?? (127, a))
				let a1 = (27 * a + 63) >> 7
				let a2 = (18 * a + 63) >> 7
				let a3 = (9 * a + 63) >> 7
				pix[at - j3] = vp8ClampByte(p2 + a3)
				pix[at - j2] = vp8ClampByte(p1 + a2)
				pix[at - jStep] = vp8ClampByte(p0 + a1)
				pix[at] = vp8ClampByte(q0 - a1)
				pix[at + jStep] = vp8ClampByte(q1 - a2)
				pix[at + j2] = vp8ClampByte(q2 - a3)
			}
			at += iStep
		}
	}

	def vp8ClampByte(v int) byte {
		return byte(v < 0 ?? (0, v > 255 ?? (255, v)))
	}
}
