internal std.formats partial module std.formats.vp8 {
	use std.testing

	check "VP8 kernels" {
		// The kernels' outputs on fixed pseudo-random inputs, as FNV-1a
		// hashes. They were checked equal to the scalar code they replaced
		// (2026-09-30) and are the same on both backends and on either CPU
		// path (`ADM_CPU=baseline`).

		internal def kernelPlane(n int, seed int, smooth bool) byte[] {
			let s byte[]
			s.len(n)
			let x = seed
			for let i = 0; i < n; i++ {
				x = (x * 1103515245 + 12345) & 0x7fffffff
				s[i] = byte((x >> 16) & 255)
				s[i] = byte(((i % 48) * 3 + int(s[i]) % 9) & 255) when smooth
			}
			return s
		}

		internal def fnvBytes(h int, s byte[]) int {
			let x = h
			for let i = 0; i < s.len(); i++ {
				x = ((x ^ int(s[i])) * 16777619) & 0xffffffff
			}
			return x
		}

		internal def fnvInts(h int, s int[]) int {
			let x = h
			for let i = 0; i < s.len(); i++ {
				x = ((x ^ (s[i] & 0xffff)) * 16777619) & 0xffffffff
			}
			return x
		}

		internal def filterHash() (int, int) {
			let h = 2166136261
			let changed = 0
			for let seed = 1; seed < 40; seed++ {
				for let smooth in bool[false, true] {
					let base = kernelPlane(48 * 48, seed, smooth)
					for let level = 0; level < 64; level += 7 {
						for let (_, dir) in int[0, 1] {
							let iStep = dir == 0 ?? (1, 48)
							let jStep = dir == 0 ?? (48, 1)
							for let inner in bool[false, true] {
								for let n in int[8, 16] {
									let got = base.clone()
									vp8Filter246(got, n, level, level >> 2, level >> 4, 20 * 48 + 20, iStep, jStep, inner)
									changed++ unless got.equals(base)
									h = fnvBytes(h, got)
								}
							}
							let got = base.clone()
							vp8Filter2(got, level, 20 * 48 + 20, iStep, jStep)
							changed++ unless got.equals(base)
							h = fnvBytes(h, got)
						}
					}
				}
			}
			return (h, changed)
		}

		internal def predictionHash() int {
			let h = 2166136261
			for let seed = 1; seed < 30; seed++ {
				let px = kernelPlane(32 * 26, seed, false)
				let base int[]
				base.len(32 * 26)
				for let i = 0; i < base.len(); i++ {
					base[i] = int(px[i])
				}
				for let mode in int[vp8PredDC, vp8PredTM, vp8PredVE, vp8PredHE, vp8PredDCTop, vp8PredDCLeft, vp8PredDCTopLeft] {
					for let n in int[4, 8, 16] {
						let got = base.clone()
						vp8PredictBlock(got, mode, 32 + 8, n, n == 16 ?? (5, n == 8 ?? (4, 3)))
						h = fnvInts(h, got)
					}
				}
				let coeff int[]
				coeff.len(16)
				for let dc = -300; dc < 300; dc += 37 {
					coeff[0] = dc
					let got = base.clone()
					vp8InverseDCT4DC(got, 32 + 8, coeff, 0)
					h = fnvInts(h, got)
				}
			}
			return h
		}

		internal def interpolationHash(generic bool) int {
			let h = 2166136261
			let src = kernelPlane(48 * 48, 7, false)
			let tmp int[]
			tmp.len(16 * 21)
			for let (_, w) in int[8, 16] {
				for let fx = 0; fx < 8; fx++ {
					for let fy = 0; fy < 8; fy++ {
						let a int[]
						a.len(32 * 17)
						let b int[]
						b.len(32 * 17)
						if generic {
							vp8Tap6Generic(src, 12 * 48 + 12, 48, 1, a, 0, 32, w, w, fx)
							vp8BilinearGeneric(src, 12 * 48 + 12, 48, b, 0, w, w, fx, fy, tmp)
						} else {
							vp8Tap6Block(src, 12 * 48 + 12, 48, 1, a, 0, 32, w, w, fx)
							vp8Bilinear(src, 12 * 48 + 12, 48, b, 0, w, w, fx, fy, tmp)
						}
						h = fnvInts(fnvInts(h, a), b)
						// Both positions fractional: the two-pass path.
						let fx2 = fx == 0 ?? (1, fx)
						let fy2 = fy == 0 ?? (1, fy)
						let c int[]
						c.len(32 * 17)
						if generic {
							vp8Tap6Generic(src, 10 * 48 + 12, 48, 1, tmp, 0, 16, w, w + 5, fx2)
							vp8Tap6ColumnsGeneric(tmp, c, 0, w, w, fy2)
						} else {
							vp8SixTap2D(src, 12 * 48 + 12, 48, c, 0, w, w, fx2, fy2, tmp)
						}
						h = fnvInts(h, c)
					}
				}
			}
			return h
		}

		@test()
		def TestKernelHashes() !none {
			let (fh, changed) = filterHash()
			fail "the filters left every edge alone" when changed < 1000
			fail "loop filter hash {fh}" unless fh == 3566636838
			fail "prediction hash {predictionHash()}" unless predictionHash() == 2574767326
			fail "interpolation hash {interpolationHash(false)}" unless interpolationHash(false) == 2678804295
		}

		@test()
		def TestInterpolationMatchesGeneric() !none {
			fail "vector interpolation differs from the per-sample code" unless interpolationHash(false) == interpolationHash(true)
		}
	}
}
