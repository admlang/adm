partial module std.fs {
	use (
		std.bytes
		std.io
		std.fs.disk::*
		std.os
		std.time
		std.time::(Time)
	)

	// DiskStore is a `FileStore` over the disk. With a `root`, every path
	// is taken inside that directory, rooted at it, and `..` never climbs
	// above it; symlinks are followed, so a link out of the root is the
	// operator's choice. Without one, paths are the disk's own, relative
	// ones taken from the working directory.
	//
	// ```
	// let server = new ftp.Server(new fs.DiskStore("/srv/ftp"))
	// ```
	type DiskStore {
		root string = ""

		def new(root string = "") {
			self.root = root == "" ?? ("", os.clean(root))
		}

		// The store path of `path`: rooted and clean inside a root, else
		// clean.
		def storePath(path string) string {
			return os.clean(path) when root == ""
			return os.clean(os.join(os.SEPARATOR, path))
		}

		// The disk path `path` maps to.
		def diskPath(path string) string {
			return storePath(path) when root == ""
			return os.clean(os.join(root, storePath(path)))
		}

		// Implements FileStore.
		// Fails when the path is missing or not a directory.
		def list(path string) !FileEntry[] {
			let base = storePath(path)
			let info = try os.stat(diskPath(base))
			fail "not a directory: {base}" unless info.isDir
			let found = try os.readDir(diskPath(base))
			let out FileEntry[] = []
			for let child in found {
				out.push(entryOf(os.clean(os.join(base, os.base(child.path))), child.info))
			}
			out.sort((a, b) => a.name.compare(b.name))
			return out
		}

		// Implements FileStore. Fails when the path is missing.
		def stat(path string) !FileEntry {
			let clean = storePath(path)
			return entryOf(clean, try os.stat(diskPath(clean)))
		}

		// Implements FileStore.
		// Fails when the file is missing, is a directory or cannot be read.
		def open(path string, offset int64) !io.ReadCloser {
			let target = diskPath(path)
			let info = try os.stat(target)
			fail "is a directory: {storePath(path)}" when info.isDir
			let file = try os.open(target)
			if offset > 0 {
				file.seek(offset, bytes.Whence.Start) onerror (err error) {
					file.close() onerror recover none
					fail err
				}
			}
			return file
		}

		// Implements FileStore: a new or replaced file is written beside
		// the target under a hidden name and renamed over it on close, so
		// readers never see half of it and abort leaves the old file; an
		// appended file is written in place and cut back on abort. The
		// writer is an `io.Aborter`.
		// Fails when the parent directory is missing, the path is a
		// directory or the file cannot be written.
		def create(path string, append bool) !io.WriteCloser {
			let target = diskPath(path)
			let exists = os.exists(target) onerror recover false
			let size int64 = -1
			let mode int64 = 0
			if exists {
				let info = try os.stat(target)
				fail "is a directory: {storePath(path)}" when info.isDir
				size = info.size
				mode = int64(info.mode) & 0o777
			}
			if append {
				let file = try os.open(target, "a")
				return new DiskWriter(file, target, "", size)
			}
			let temp = os.join(os.dir(target), ".{os.base(target)}.adm-partial-{time.now().unixNs()}")
			let file = try os.open(temp, "w")
			if mode != 0 {
				os.chmod(temp, mode) onerror recover none
			}
			return new DiskWriter(file, target, temp, int64(-1))
		}

		// Implements FileStore: the file is cut to `offset` and written on in
		// place; abort cuts it back to `offset`. The writer is an
		// `io.Aborter`.
		// Fails when the file is missing, shorter than `offset`, a directory,
		// or cannot be written.
		def resume(path string, offset int64) !io.WriteCloser {
			return try create(path, false) when offset <= 0
			let target = diskPath(path)
			let info = try os.stat(target)
			fail "is a directory: {storePath(path)}" when info.isDir
			fail "{storePath(path)} is {info.size} bytes, shorter than {offset}" when info.size < offset
			let file = try os.open(target, "r+")
			let failure ?error = none
			file.truncate(int(offset)) onerror (err error) {
				failure = err
				recover none
			}
			file.seek(offset, bytes.Whence.Start) onerror (err error) {
				failure = err when failure is none
				recover int64(0)
			}
			if !(failure is none) {
				file.close() onerror recover none
				fail failure
			}
			return new DiskWriter(file, target, "", offset)
		}

		// Implements FileStore. Fails when the path is missing or the
		// operating system refuses the change.
		def chmod(path string, mode int) !none {
			return try os.chmod(diskPath(path), int64(mode))
		}

		// Implements FileStore. Fails when the path is missing or the
		// operating system refuses the change.
		def touch(path string, modified Time) !none {
			return try os.touch(diskPath(path), modified)
		}

		// Implements FileStore.
		// Fails when the file is missing, is a directory or cannot be removed.
		def remove(path string) !none {
			let target = diskPath(path)
			let info = try os.stat(target)
			fail "is a directory: {storePath(path)}" when info.isDir
			return try os.remove(target)
		}

		// Implements FileStore.
		// Fails when the source is missing, is the root, or the move is refused.
		def rename(from string, to string) !none {
			expects {
				assert root == "" || storePath(from) != os.SEPARATOR onerror fail "cannot rename the root"
			}
			return try os.rename(diskPath(from), diskPath(to))
		}

		// Implements FileStore.
		// Fails when the directory exists or its parent is missing.
		def makeDir(path string) !none {
			return try os.mkdir(diskPath(path))
		}

		// Implements FileStore.
		// Fails when the directory is missing, not empty, or is the root.
		def removeDir(path string) !none {
			expects {
				assert root == "" || storePath(path) != os.SEPARATOR onerror fail "cannot remove the root"
			}
			return try os.rmdir(diskPath(path))
		}

		internal def entryOf(path string, info os.FileInfo) FileEntry {
			let kind = FileKind.File
			if info.isDir {
				kind = FileKind.Dir
			} else if (int64(info.mode) & int64(os.FileMode.Symlink)) != 0 {
				kind = FileKind.Link
			}
			let size = info.isDir ?? (int64(0), info.size)
			let name = path == os.SEPARATOR ?? (path, os.base(path))
			let mode = int(int64(info.mode) & 0o777)
			return FileEntry{name: name, path: path, kind: kind, size: size, modified: info.modTime, mode: mode}
		}
	}
}

internal partial module std.fs.disk {
	use std.os

	// DiskWriter writes a file for DiskStore. With a temp name it writes
	// there and renames over the target on close; without one it writes
	// the target in place, and abort cuts it back to `restore` bytes, or
	// removes it when it did not exist (-1).
	type DiskWriter {
		file    os.File
		target  string
		temp    string
		restore int64
		done    bool    = false

		def new(file os.File, target string, temp string, restore int64) {
			self.file = file
			self.target = target
			self.temp = temp
			self.restore = restore
		}

		// Implements std.io.Writer. Fails when the file cannot be written.
		def write(buf byte[]) !int {
			fail "writer is closed" when done
			return try file.write(buf)
		}

		// Implements std.io.Closer: completes the file. Fails when it cannot
		// be closed or renamed into place.
		def close() !none {
			return none when done
			done = true
			try file.close()
			return try os.rename(temp, target) unless temp == ""
			return none
		}

		// Implements std.io.Aborter: leaves the target as it was before.
		// Fails when the file cannot be removed or cut back.
		def abort() !none {
			return none when done
			done = true
			file.close() onerror recover none
			return try os.remove(temp) unless temp == ""
			return try os.remove(target) when restore < 0
			let f = try os.open(target, "r+")
			f.truncate(int(restore)) onerror (err error) {
				f.close() onerror recover none
				fail err
			}
			return try f.close()
		}
	}
}
