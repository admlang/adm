partial module std.fs {
	use (
		std.io
		std.os
		std.time::(Time)
	)

	// FileKind says what a `FileEntry` names.
	enum FileKind {
		File = "file",
		Dir  = "dir",
		Link = "link",
	}

	// FileEntry describes one file or directory of a `FileStore`: its
	// name, its full path, what it is, its size in bytes (0 for a
	// directory), when it last changed (the zero time when the store does
	// not know) and its permission bits (`0o644`; 0 when the store does
	// not say).
	struct FileEntry {
		name     string
		path     string
		kind     FileKind = FileKind.File
		size     int64    = 0
		modified Time
		mode     int      = 0
	}

	// FileStore is a tree of files reached by paths: what a file server
	// serves and what a file transfer client reaches. `DiskStore` maps it
	// to a directory, `MemoryStore` keeps it in memory, `ftp.Client`
	// reaches one on a server.
	interface FileStore {
		// Lists a directory's entries, `.` and `..` left out.
		// Fails when the path is missing or not a directory.
		def list(path string) !FileEntry[]
		// Describes one file or directory. Fails when it is missing.
		def stat(path string) !FileEntry
		// Opens a file for reading from `offset` on.
		// Fails when the file is missing or is a directory.
		def open(path string, offset int64) !io.ReadCloser
		// Creates or replaces a file, or appends to it. The file is
		// complete once the writer closes; a writer that is an `io.Aborter`
		// can be abandoned instead, leaving the file as it was.
		// Fails when the parent directory is missing or the file is a directory.
		def create(path string, append bool) !io.WriteCloser
		// Writes a file from `offset` on, keeping the bytes before it and
		// dropping those after, to finish a transfer that broke off; offset 0
		// is `create(path, false)`. The file is complete once the writer
		// closes.
		// Fails when the file is missing or shorter than `offset`, or is a directory.
		def resume(path string, offset int64) !io.WriteCloser
		// Deletes a file. Fails when it is missing or is a directory.
		def remove(path string) !none
		// Moves a file or directory. Fails when the source is missing.
		def rename(from string, to string) !none
		// Creates a directory. Fails when it exists or its parent is missing.
		def makeDir(path string) !none
		// Removes an empty directory. Fails when it is missing or not empty.
		def removeDir(path string) !none
		// Sets a file's or directory's permission bits (`0o644`).
		// Fails when it is missing or the store refuses the change.
		def chmod(path string, mode int) !none
		// Sets a file's or directory's modification time.
		// Fails when it is missing or the store refuses the change.
		def touch(path string, modified Time) !none
	}

	// Copies a file of one store to a path of another, or a directory
	// with everything under it; a directory already at the target is
	// merged into, files in it replaced. Modification times are kept
	// where the target store can set them.
	//
	// ```
	// try fs.copy(ftpClient, "/photos", new fs.DiskStore(), "photos")
	// ```
	//
	// Fails when the source is missing, or as a read or write of either
	// store does.
	def copy(from FileStore, fromPath string, to FileStore, toPath string) !none {
		let entry = try from.stat(fromPath)
		if entry.kind == FileKind.Dir {
			let exists = true
			to.stat(toPath) onerror (err error) {
				exists = false
				recover FileEntry{}
			}
			try to.makeDir(toPath) unless exists
			let children = try from.list(fromPath)
			for let child in children {
				try copy(from, child.path, to, os.clean(os.join(toPath, child.name)))
			}
			keepModified(to, toPath, entry)
			return none
		}
		let source = try from.open(fromPath, 0)
		let sink = to.create(toPath, false) onerror (err error) {
			source.close() onerror recover none
			fail err
		}
		io.copy(source, sink) onerror (err error) {
			if sink is io.Aborter {
				sink.abort() onerror recover none
			} else {
				sink.close() onerror recover none
			}
			source.close() onerror recover none
			fail err
		}
		source.close() onerror recover none
		try sink.close()
		keepModified(to, toPath, entry)
		return none
	}

	// keepModified gives a copy its source's modification time; a store
	// that cannot set one keeps the time of the copy.
	internal def keepModified(to FileStore, path string, entry FileEntry) {
		return when entry.modified.unixNs() == 0
		to.touch(path, entry.modified) onerror recover none
	}
}
