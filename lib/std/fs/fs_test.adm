partial module std.fs {
	use (
		std.io
		std.os
		std.testing
		std.time
	)

	// scratchDir is a fresh directory under /tmp for one test.
	internal def scratchDir(name string) !string {
		let dir = "/tmp/adm-fs-{name}-{time.now().unixNs()}"
		try os.mkdir(dir)
		return dir
	}

	// writeText stores text as a file of a store.
	internal def writeText(store FileStore, path string, text string) !none {
		let w = try store.create(path, false)
		try w.write(text.bytes())
		return try w.close()
	}

	// readText reads a file of a store from `offset` on.
	internal def readText(store FileStore, path string, offset int64 = 0) !string {
		let r = try store.open(path, offset)
		let sink = new TextSink()
		try io.copy(r, sink)
		try r.close()
		return string(sink.data)
	}

	// TextSink keeps what is written to it.
	internal type TextSink {
		data byte[]

		def new() {}

		def write(buf byte[]) !int {
			data = data + buf
			return buf.len()
		}
	}

	// fails reports whether fn fails.
	internal def fails(fn def () !none) bool {
		let failed = false
		fn() onerror (err error) {
			failed = true
			recover none
		}
		return failed
	}

	// exercise runs the FileStore contract against a store rooted at `/`.
	internal def exercise(store FileStore) !none {
		try store.makeDir("/docs")
		try writeText(store, "/docs/a.txt", "hello")
		try writeText(store, "docs/b.txt", "second")
		let w = try store.create("/docs/a.txt", true)
		try w.write(" world".bytes())
		try w.close()
		assert (try readText(store, "/docs/a.txt")) == "hello world"
		assert (try readText(store, "/docs/a.txt", 6)) == "world"
		let r = try store.resume("/docs/a.txt", 5)
		try r.write("!".bytes())
		try r.close()
		assert (try readText(store, "/docs/a.txt")) == "hello!"
		assert fails(def () !none {
			try store.resume("/docs/a.txt", 99)
			return none
		})
		let restarted = try store.resume("/docs/a.txt", 0)
		try restarted.write("hello world".bytes())
		try restarted.close()
		assert (try readText(store, "/docs/a.txt")) == "hello world"

		let entries = try store.list("/docs")
		assert entries.len() == 2
		assert entries[0].name == "a.txt" && entries[0].path == "/docs/a.txt"
		assert entries[0].size == 11 && entries[0].kind == FileKind.File
		assert entries[1].name == "b.txt"
		assert (try store.stat("/docs")).kind == FileKind.Dir
		assert (try store.stat("/docs/../docs/./b.txt")).size == 6

		// `..` never climbs above the root.
		assert (try store.stat("/../../docs/a.txt")).path == "/docs/a.txt"

		try store.rename("/docs/b.txt", "/docs/c.txt")
		assert (try store.list("/docs")).len() == 2
		assert (try readText(store, "/docs/c.txt")) == "second"
		try store.rename("/docs", "/papers")
		assert (try readText(store, "/papers/c.txt")) == "second"

		assert fails(def () !none { return store.removeDir("/papers") })
		assert fails(def () !none {
			try store.open("/papers", 0)
			return none
		})
		assert fails(def () !none {
			try store.stat("/missing")
			return none
		})
		assert fails(def () !none { return store.makeDir("/nowhere/dir") })

		// Permissions and modification times.
		let stamp = time.fromUnixNs(int64(1700000000) * 1000000000)
		try store.touch("/papers/c.txt", stamp)
		assert (try store.stat("/papers/c.txt")).modified.unixNs() == stamp.unixNs()
		try store.chmod("/papers/c.txt", 0o600)
		assert (try store.stat("/papers/c.txt")).mode == 0o600
		assert fails(def () !none { return store.chmod("/missing", 0o600) })

		// An aborted writer leaves the file as it was: a replaced file keeps
		// its bytes, a new one never appears, an append is cut back.
		let replace = try store.create("/papers/c.txt", false)
		try replace.write("gone".bytes())
		if replace is io.Aborter {
			try replace.abort()
		} else {
			fail "the writer of create is not an io.Aborter"
		}
		assert (try readText(store, "/papers/c.txt")) == "second"
		let fresh = try store.create("/papers/new.txt", false)
		try fresh.write("x".bytes())
		if fresh is io.Aborter {
			try fresh.abort()
		}
		assert fails(def () !none {
			try store.stat("/papers/new.txt")
			return none
		})
		let more = try store.create("/papers/c.txt", true)
		try more.write(" more".bytes())
		if more is io.Aborter {
			try more.abort()
		}
		assert (try readText(store, "/papers/c.txt")) == "second"

		try store.remove("/papers/a.txt")
		try store.remove("/papers/c.txt")
		try store.removeDir("/papers")
		assert (try store.list("/")).len() == 0
		return none
	}

	check "FileStore" {
		@test()
		def memoryStoreFollowsTheContract() !none {
			return try exercise(new MemoryStore())
		}

		@test()
		def diskStoreFollowsTheContract() !none {
			let dir = try scratchDir("contract")
			let store = new DiskStore(dir)
			try exercise(store)
			assert store.storePath("../x") == "/x"
			assert store.diskPath("/../x") == dir + "/x"
			try os.rmdir(dir)
			return none
		}

		@test()
		def diskStoreWithoutRootUsesDiskPaths() !none {
			let dir = try scratchDir("plain")
			let store = new DiskStore()
			try writeText(store, dir + "/x.txt", "x")
			assert (try os.readFile(dir + "/x.txt")).len() == 1
			assert (try store.stat(dir + "/./x.txt")).path == dir + "/x.txt"
			try store.remove(dir + "/x.txt")
			try os.rmdir(dir)
			return none
		}

		@test()
		def copyMovesTreesBetweenStores() !none {
			let mem = new MemoryStore()
			try mem.makeDir("/site")
			try mem.makeDir("/site/img")
			try writeText(mem, "/site/index.html", "<h1>hi</h1>")
			try writeText(mem, "/site/img/logo.svg", "<svg/>")

			let dir = try scratchDir("copy")
			let disk = new DiskStore()
			try copy(mem, "/site", disk, dir + "/site")
			assert string(try os.readFile(dir + "/site/img/logo.svg")) == "<svg/>"

			let back = new MemoryStore()
			try copy(disk, dir + "/site", back, "/mirror")
			assert (try readText(back, "/mirror/index.html")) == "<h1>hi</h1>"
			assert (try back.list("/mirror/img")).len() == 1

			// Modification times come along.
			let stamp = time.fromUnixNs(int64(1600000000) * 1000000000)
			try mem.touch("/site/index.html", stamp)
			try copy(mem, "/site/index.html", back, "/dated.html")
			assert (try back.stat("/dated.html")).modified.unixNs() == stamp.unixNs()

			// A file copies on its own too.
			try copy(mem, "/site/index.html", back, "/index.html")
			assert (try readText(back, "/index.html")) == "<h1>hi</h1>"

			try os.remove(dir + "/site/img/logo.svg")
			try os.rmdir(dir + "/site/img")
			try os.remove(dir + "/site/index.html")
			try os.rmdir(dir + "/site")
			try os.rmdir(dir)
			return none
		}
	}
}
