partial module std.fs {
	use (
		std.io
		std.time
		std.time::(Time)
		std.fs.memory::*
		std.os
	)

	// MemoryStore is a `FileStore` kept in memory: a server with nothing
	// on disk, or a stand-in for one in tests. It starts with an empty
	// root directory. Safe from many tasks.
	//
	// ```
	// let files = new fs.MemoryStore()
	// try files.makeDir("/pub")
	// let server = new ftp.Server(files)
	// ```
	type MemoryStore {
		internal nodes map<string, MemoryNode>

		def new() {
			nodes["/"] = new MemoryNode(true)
		}

		// Implements FileStore. Fails when the path is missing or not a directory.
		atomic def list(path string) !FileEntry[] {
			let dir = os.clean("/" + path)
			let node = nodes.get(dir)
			fail "no such directory: {dir}" when node is none
			fail "not a directory: {dir}" unless node.isDir
			let out FileEntry[] = []
			for let (key, child) in nodes {
				continue when key == "/" || parentOf(key) != dir
				out.push(entryOf(key, child))
			}
			out.sort((a, b) => a.name.compare(b.name))
			return out
		}

		// Implements FileStore. Fails when the path is missing.
		atomic def stat(path string) !FileEntry {
			let clean = os.clean("/" + path)
			let node = nodes.get(clean)
			fail "no such file: {clean}" when node is none
			return entryOf(clean, node)
		}

		// Implements FileStore. Fails when the file is missing or is a directory.
		atomic def open(path string, offset int64) !io.ReadCloser {
			let clean = os.clean("/" + path)
			let node = nodes.get(clean)
			fail "no such file: {clean}" when node is none
			fail "is a directory: {clean}" when node.isDir
			let start = int(offset)
			start = node.data.len() when start > node.data.len()
			return new MemoryReader(node.data, start)
		}

		// Implements FileStore: the file takes what was written when the
		// writer closes; until then readers see the old one. The writer is
		// an `io.Aborter`. Fails when the parent directory is missing or the
		// path is a directory or the root.
		atomic def create(path string, append bool) !io.WriteCloser {
			let clean = os.clean("/" + path)
			try checkWritable(clean)
			let found = nodes.get(clean)
			let start byte[] = []
			start = found.data.clone() when append && !(found is none)
			return writerFor(clean, start)
		}

		// Implements FileStore: as `create`, the writer starting from the
		// first `offset` bytes. Fails when the file is missing, shorter than
		// `offset`, or a directory.
		atomic def resume(path string, offset int64) !io.WriteCloser {
			let clean = os.clean("/" + path)
			try checkWritable(clean)
			let found = nodes.get(clean)
			if found is none {
				fail "no such file: {clean}" when offset > 0
				return writerFor(clean, [])
			}
			fail "{clean} is {found.data.len()} bytes, shorter than {offset}" when int64(found.data.len()) < offset
			return writerFor(clean, found.data[:int(offset)].clone())
		}

		// Implements FileStore. Fails when the path is missing.
		atomic def chmod(path string, mode int) !none {
			let clean = os.clean("/" + path)
			let node = nodes.get(clean)
			fail "no such file: {clean}" when node is none
			node.mode = mode & 0o7777
			return none
		}

		// Implements FileStore. Fails when the path is missing.
		atomic def touch(path string, modified Time) !none {
			let clean = os.clean("/" + path)
			let node = nodes.get(clean)
			fail "no such file: {clean}" when node is none
			node.modified = modified
			return none
		}

		// checkWritable fails unless a file may be written at a clean path:
		// not the root, not a directory, under an existing directory.
		internal def checkWritable(clean string) !none {
			expects {
				assert clean != "/" onerror fail "cannot write the root"
			}
			let found = nodes.get(clean)
			fail "is a directory: {clean}" when !(found is none) && found.isDir
			let parent = nodes.get(parentOf(clean))
			fail "no such directory: {parentOf(clean)}" when parent is none
			fail "not a directory: {parentOf(clean)}" unless parent.isDir
			return none
		}

		// writerFor is a writer that stores the file at a clean path when it
		// closes.
		internal def writerFor(clean string, start byte[]) MemoryWriter {
			let store = self
			return new MemoryWriter(start, def (data byte[]) !none {
				return store.put(clean, data)
			})
		}

		// put stores a file's bytes, creating it when missing. Fails when
		// its directory went away while it was written.
		atomic def put(clean string, data byte[]) !none {
			try checkWritable(clean)
			let found = nodes.get(clean)
			if found is none {
				let node = new MemoryNode(false)
				node.data = data
				nodes[clean] = node
				return none
			}
			found.data = data
			found.modified = time.now()
			return none
		}

		// Implements FileStore. Fails when the file is missing or is a directory.
		atomic def remove(path string) !none {
			let clean = os.clean("/" + path)
			let node = nodes.get(clean)
			fail "no such file: {clean}" when node is none
			fail "is a directory: {clean}" when node.isDir
			nodes.delete(clean)
			return none
		}

		// Implements FileStore. Fails when the source is missing or the root, the target's parent is missing, or a directory would move into itself.
		atomic def rename(from string, to string) !none {
			let source = os.clean("/" + from)
			let target = os.clean("/" + to)
			fail "cannot rename the root" when source == "/"
			fail "no such file: {source}" unless nodes.hasKey(source)
			fail "cannot move a directory into itself" when target.startsWith(source + "/")
			let parent = nodes.get(parentOf(target))
			fail "no such directory: {parentOf(target)}" when parent is none
			fail "not a directory: {parentOf(target)}" unless parent.isDir
			return none when source == target
			let moved map<string, MemoryNode>
			for let (key, node) in nodes {
				if key == source {
					moved[target] = node
				} else if key.startsWith(source + "/") {
					moved[target + key[source.len():]] = node
				}
			}
			for let key in nodes.keys() {
				nodes.delete(key) when key == source || key.startsWith(source + "/")
			}
			for let (key, node) in moved {
				nodes[key] = node
			}
			return none
		}

		// Implements FileStore. Fails when the path exists or its parent is missing.
		atomic def makeDir(path string) !none {
			let clean = os.clean("/" + path)
			fail "already exists: {clean}" when nodes.hasKey(clean)
			let parent = nodes.get(parentOf(clean))
			fail "no such directory: {parentOf(clean)}" when parent is none
			fail "not a directory: {parentOf(clean)}" unless parent.isDir
			nodes[clean] = new MemoryNode(true)
			return none
		}

		// Implements FileStore. Fails when the directory is missing, not empty, or the root.
		atomic def removeDir(path string) !none {
			let clean = os.clean("/" + path)
			fail "cannot remove the root" when clean == "/"
			let node = nodes.get(clean)
			fail "no such directory: {clean}" when node is none
			fail "not a directory: {clean}" unless node.isDir
			for let key in nodes.keys() {
				fail "directory not empty: {clean}" when key.startsWith(clean + "/")
			}
			nodes.delete(clean)
			return none
		}

		internal def entryOf(path string, node MemoryNode) FileEntry {
			let kind = node.isDir ?? (FileKind.Dir, FileKind.File)
			let name = path == "/" ?? ("/", os.base(path))
			return FileEntry{name: name, path: path, kind: kind, size: int64(node.data.len()), modified: node.modified, mode: node.mode}
		}
	}
}

internal partial module std.fs.memory {
	use (
		std.time
		std.time::(Time)
	)

	// parentOf is the directory holding a clean, rooted path.
	def parentOf(path string) string {
		for let i = path.len() - 1; i > 0; i-- {
			return path[:i] when path[i] == '/'
		}
		return "/"
	}

	// MemoryNode is one file or directory of a MemoryStore.
	type MemoryNode {
		isDir    bool
		data     byte[]
		modified Time
		mode     int

		def new(isDir bool) {
			self.isDir = isDir
			modified = time.now()
			mode = isDir ?? (0o755, 0o644)
		}
	}

	// MemoryReader reads a snapshot of a MemoryStore file.
	type MemoryReader {
		data byte[]
		pos  int

		def new(data byte[], pos int) {
			self.data = data
			self.pos = pos
		}

		// Implements std.io.Reader.
		def read(buf byte[]) !int {
			return 0 when pos >= data.len()
			let n = data[pos:].copy(buf)
			pos += n
			return n
		}

		// Implements std.io.Closer.
		def close() !none {
			return none
		}
	}

	// MemoryWriter collects a MemoryStore file and hands it to `commit` on
	// close; abort drops it.
	type MemoryWriter {
		pending byte[]
		commit  def (byte[]) !none
		done    bool               = false

		def new(start byte[], commit def (byte[]) !none) {
			pending = start
			self.commit = commit
		}

		// Implements std.io.Writer. Fails once the writer closed.
		def write(buf byte[]) !int {
			fail "writer is closed" when done
			pending = pending + buf
			return buf.len()
		}

		// Implements std.io.Closer: stores the file. Fails when its
		// directory went away meanwhile.
		def close() !none {
			return none when done
			done = true
			return try commit(pending)
		}

		// Implements std.io.Aborter: the file stays as it was.
		def abort() !none {
			done = true
			pending = []
			return none
		}
	}
}
