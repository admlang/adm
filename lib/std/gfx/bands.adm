// Bands of rows for the whole-image passes under std.gfx: at most
// `maxBands` bands of at least `bandPixels` pixels each, run on tasks at
// once. Every band writes only its own rows, so the result never depends on
// which band finishes first.
internal std partial module std.gfx.bands {
	const bandPixels = 131072
	const maxBands = 16

	// How many bands `forBands` splits `rows` rows of `pixels` pixels into.
	def bandCount(rows int, pixels int) int {
		return (pixels / bandPixels).clamp(1, maxBands).min(rows.max(1))
	}

	// The band `forBands` gave the rows starting at `from`.
	def bandOf(from int, rows int, bands int) int {
		for let b = 0; b < bands; b++ {
			return b when rows * b / bands == from
		}
		return 0
	}

	// Runs `work(from, to)` over `bandCount` bands of the rows, on tasks
	// when there is more than one, and returns when all are done.
	def forBands(rows int, pixels int, work def(int, int)) {
		let bands = bandCount(rows, pixels)
		if bands == 1 {
			work(0, rows)
			return
		}
		let done = new channel<bool>(size = bands)
		for let b = 0; b < bands; b++ {
			async band(work, rows * b / bands, rows * (b + 1) / bands, done)
		}
		for let b = 0; b < bands; b++ {
			<-done
		}
	}

	// forBands over the `h` rows of a `w`-pixel-wide image.
	def forRows(w int, h int, work def(int, int)) {
		forBands(h, w * h, work)
	}

	async def band(work def(int, int), from int, to int, done channel<bool>) {
		work(from, to)
		done <- true
	}
}
