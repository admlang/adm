partial module std.gfx.canvas {
	use (
		std.testing
		std.gfx.color::(Color, RGBA)
		std.math.geom::(Corners, Edges, Rect)
		std.units::Pixels
	)

	check "Borders" {
		def px(cv Canvas, x int, y int) RGBA {
			let i = (y * cv.width + x) * 4
			return RGBA{r: cv.pixels[i], g: cv.pixels[i + 1], b: cv.pixels[i + 2], a: cv.pixels[i + 3]}
		}

		def rgba(r int, g int, b int) Color {
			return new Color(RGBA{r: byte(r), g: byte(g), b: byte(b), a: 255})
		}

		def frame() Rect {
			return Rect{left: 10.0, top: 10.0, right: 90.0, bottom: 60.0}
		}

		// Opaque pixels along the top border's middle row, from x0 to x1.
		def runs(cv Canvas, y int, x0 int, x1 int) int {
			let n = 0
			let inside = false
			for let x = x0; x < x1; x++ {
				let on = px(cv, x, y).a > 128
				n++ when on && !inside
				inside = on
			}
			return n
		}

		@test()
		def solidFramesFillBetweenTheEdges() {
			let cv = new Canvas(100, 70)
			cv.stroke(frame(), new Edges<Border>(Border{width: 6(px), paint: rgba(0, 0, 200)}))
			assert px(cv, 12, 30).b == 200 && px(cv, 12, 30).a == 255 && px(cv, 50, 58).a == 255
			assert px(cv, 50, 30).a == 0 && px(cv, 8, 30).a == 0 && px(cv, 16, 30).a == 0
			// A recording draws the same.
			let ctx = new DrawContext()
			ctx.stroke(frame(), new Edges<Border>(Border{width: 6(px), paint: rgba(0, 0, 200)}))
			let replayed = new Canvas(100, 70)
			ctx.replay(replayed)
			for let i = 0; i < cv.pixels.len(); i++ {
				assert replayed.pixels[i] == cv.pixels[i]
			}
		}

		@test()
		def sidesMeetOnTheCornerDiagonal() {
			let cv = new Canvas(100, 70)
			let red = rgba(200, 0, 0)
			let green = rgba(0, 160, 0)
			cv.stroke(frame(), new Edges<Border>(Border{width: 8(px), paint: red}, Border{width: 8(px), paint: green}))
			// Top right corner (90, 10): above the diagonal is top (red),
			// below it right (green), and the corner leaves no gap.
			// Top right corner (90, 10): above the diagonal x + y = 100 is the
			// top (red), below it the right side (green); on it a blend at
			// full alpha, no light seam.
			assert px(cv, 84, 11).r == 200 && px(cv, 84, 11).a == 255
			assert px(cv, 88, 14).g == 160 && px(cv, 88, 14).a == 255
			assert px(cv, 87, 12).a == 255 && px(cv, 87, 12).r > 50 && px(cv, 87, 12).g > 40
			assert px(cv, 11, 58).a == 255
		}

		@test()
		def widthsAndNoneSides() {
			let cv = new Canvas(100, 70)
			let c = rgba(0, 0, 0)
			cv.stroke(frame(), new Edges<Border>(Border{width: 2(px), paint: c}, Border{width: 10(px), paint: c, lineStyle: LineStyle.None}, Border{width: 12(px), paint: c}, Border{width: 4(px), paint: c}))
			assert px(cv, 50, 11).a == 255 && px(cv, 50, 13).a == 0
			assert px(cv, 50, 49).a == 255 && px(cv, 50, 47).a == 0
			assert px(cv, 13, 30).a == 255 && px(cv, 15, 30).a == 0
			// None has no width: nothing along the right side.
			assert px(cv, 89, 30).a == 0
		}

		@test()
		def roundedCornersFollowTheRadius() {
			let cv = new Canvas(100, 70)
			cv.stroke(frame(), new Edges<Border>(Border{width: 4(px), paint: rgba(0, 0, 0)}), new Corners<Pixels>(12(px)))
			assert px(cv, 10, 10).a == 0 && px(cv, 50, 11).a == 255 && px(cv, 11, 35).a == 255
			// Along the diagonal of the top left corner, the ring is about
			// 12 * (1 - 1 / sqrt 2) = 3.5 px in.
			assert px(cv, 14, 14).a > 128
			// Radii larger than the box shrink together: a pill.
			let pill = new Canvas(100, 70)
			pill.stroke(frame(), new Edges<Border>(Border{width: 2(px), paint: rgba(0, 0, 0)}), new Corners<Pixels>(500(px)))
			assert px(pill, 11, 35).a > 128 && px(pill, 50, 11).a > 128 && px(pill, 12, 12).a == 0
		}

		@test()
		def dashesAndDotsFitEachSide() {
			let cv = new Canvas(100, 70)
			cv.stroke(frame(), new Edges<Border>(Border{width: 4(px), paint: rgba(0, 0, 0), lineStyle: LineStyle.Dashed}))
			// A dash on every corner, drawn once: no seam on the diagonal.
			assert px(cv, 11, 12).a == 255 && px(cv, 88, 12).a == 255 && px(cv, 11, 58).a == 255 && px(cv, 88, 58).a == 255
			let dashes = runs(cv, 12, 10, 90)
			assert dashes >= 5 && dashes <= 8
			let dots = new Canvas(100, 70)
			dots.stroke(frame(), new Edges<Border>(Border{width: 4(px), paint: rgba(0, 0, 0), lineStyle: LineStyle.Dotted}))
			// Dot centres on the corners' centres, about 8 px apart.
			assert px(dots, 12, 12).a > 200 && px(dots, 87, 12).a > 200
			let n = runs(dots, 12, 10, 90)
			assert n >= 9 && n <= 11
		}

		@test()
		def doubleAndShadedStyles() {
			let cv = new Canvas(100, 70)
			cv.stroke(frame(), new Edges<Border>(Border{width: 9(px), paint: rgba(0, 0, 0), lineStyle: LineStyle.Double}))
			// Thirds: line, gap, line.
			assert px(cv, 50, 11).a == 255 && px(cv, 50, 14).a == 0 && px(cv, 50, 17).a == 255
			let inset = new Canvas(100, 70)
			inset.stroke(frame(), new Edges<Border>(Border{width: 6(px), paint: rgba(100, 150, 200), lineStyle: LineStyle.Inset}))
			// Top and left sunk (darker), bottom and right lit.
			let top = px(inset, 50, 12)
			let bottom = px(inset, 50, 57)
			assert top.b < 200 && bottom.b > 200 && px(inset, 12, 35).b == top.b && px(inset, 87, 35).b == bottom.b
			let groove = new Canvas(100, 70)
			groove.stroke(frame(), new Edges<Border>(Border{width: 8(px), paint: rgba(100, 150, 200), lineStyle: LineStyle.Groove}))
			// The outer half of the top dark, the inner half light.
			assert px(groove, 50, 11).b < px(groove, 50, 16).b
		}
	}
}
