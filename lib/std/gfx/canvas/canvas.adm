partial module std.gfx.canvas {
	use (
		std.gfx.color::(BlendMode, Color, RGBA)
		std.gfx.colorspace
		std.gfx.render as render
		std.gfx.processing.transform::(FitMode)
		std.formats.video as video
		std.formats.image as image
		std.mem
		std.math
		std.simd
		std.time
		std.gfx
		std.gfx::(Mask, Raster)
		std.math.geom::(Circle, Edges, FillRule, Line, Path, Point, Rect, Size, StrokeStyle, Transform2D)
		std.units::Percent
		std.units::Pixels
		std.gfx.bands::*
	)

	// SIMD shuffle indices for swizzling RGBA8 -> BGRA8 for 4 pixels (16 bytes).
	// Per pixel: [R,G,B,A] -> [B,G,R,A].
	internal const __rgba_to_bgra_swizzle = byte[
		2, 1, 0, 3,
		6, 5, 4, 7,
		10, 9, 8, 11,
		14, 13, 12, 15,
	]

	// Canvas is a CPU-side RGBA8 framebuffer.
	//
	// Renderers can upload `pixels` to a GPU texture, or use it as a software backbuffer.
	// The pixel format is always RGBA with 8 bits per channel and row-major layout:
	// `(x, y) -> i := (y*width + x) * 4` with bytes `[R, G, B, A]`.
	type Canvas {
		width                           int
		height                          int
		pixels                          byte[]
		// The drawing settings, and the ones `save` pushed.
		internal current                DrawState    = DrawState{}
		internal saved                  DrawState[]
		// The groups open, innermost last.
		internal groups                 GroupFrame[]
		// The box written since `clearChanges` (x0 >= x1: none).
		internal chX0, chY0, chX1, chY1 int

		def new(width int, height int) {
			self.width = width
			self.height = height

			let n = width * height * 4
			pixels.len(n)
			pixels[:] = 0
		}

		// getDrawContext returns a DrawContext sized to the canvas, for recording
		// draw commands to render onto it.
		def getDrawContext() DrawContext {
			return new DrawContext(new Size(float(width), float(height)))
		}

		// The pixel dimensions of this canvas.
		def size() Size<uint> {
			return new Size<uint>(uint(width), uint(height))
		}

		// Bytes per row; canvas rows are always tightly packed.
		def stride() int {
			return width * 4
		}

		// The backing RGBA8 buffer, shared with this canvas, not copied; see
		// the gfx.Raster contract. Canvas rows are tightly packed, so
		// `stride()` is exactly `width * 4` and `raw().len() == height * stride()`.
		def raw() byte[] {
			// The caller may write through it.
			changed(0, 0, width, height)
			return pixels
		}

		// Adopts a new backing store after a geometry-changing operation.
		// Canvas rows are tightly packed, so a loose stride is repacked.
		def reshape(data byte[], size Size<uint>, stride int) {
			width = int(size.width)
			height = int(size.height)
			changed(0, 0, width, height)
			// A clip in the old geometry means nothing in the new one.
			current.clip = none
			for let (_, st) in saved {
				st.clip = none
			}
			let tight = width * 4
			if stride == tight {
				pixels = data
				return
			}
			let packed = byte[]
			packed.len(height * tight)
			for let y = 0; y < height; y++ {
				mem.copyN(packed[y * tight:(y + 1) * tight], data[y * stride:y * stride + tight], tight)
			}
			pixels = packed
		}

		// bytes returns the RGBA pixel buffer, shared with the canvas.
		def bytes() byte[] {
			changed(0, 0, width, height)
			return pixels
		}

		// Coverage as a mask (gfx.Mask): luminance scaled by alpha, like Image.
		def coverage(x, y int) float {
			return 0.0 when x < 0 || y < 0 || x >= width || y >= height
			let o = (y * width + x) * 4
			let lum = 0.299 * float(pixels[o]) + 0.587 * float(pixels[o + 1]) + 0.114 * float(pixels[o + 2])
			return ((lum / 255.0) * (float(pixels[o + 3]) / 255.0)).clamp(0.0, 1.0)
		}

		// RowMask: luminance scaled by alpha along the row, like Image.
		def coverage(x, y int, out float32[]) {
			gfx.luminanceCoverage(self, x, y, out)
		}

		// RowMask: the canvas; nothing outside it is covered.
		def bounds() ?Rect {
			return Rect{left: 0.0, top: 0.0, right: float(width), bottom: float(height)}
		}

		// Draws what the context recorded onto this canvas, in order.
		def apply(ctx DrawContext) {
			ctx.replay(self)
		}

		// Draws one recorded render command.
		def apply(cmd render.DrawCommand) {
			switch cmd.kind {
				case render.CommandKind.Clear:
					clear(cmd.color)
				case render.CommandKind.FillRect:
					fill(cmd.rect, cmd.color)
				case render.CommandKind.StrokeRect:
					// A recorded rectangle outline lies inside the rectangle.
					let w = cmd.strokeWidth.max(1.0)
					let r = cmd.rect
					stroke(Rect{left: r.left + w / 2.0, top: r.top + w / 2.0, right: r.right - w / 2.0, bottom: r.bottom - w / 2.0}, cmd.color, StrokeStyle{width: w * 1(px)})
				case render.CommandKind.Line:
					stroke(new Line(cmd.p0, cmd.p1), cmd.color, StrokeStyle{width: cmd.strokeWidth.max(1.0) * 1(px)})
				case render.CommandKind.Polyline:
					stroke(polylinePath(cmd.points, false), cmd.color, StrokeStyle{width: cmd.strokeWidth.max(1.0) * 1(px)})
				case render.CommandKind.Polygon:
					fill(polylinePath(cmd.points, true), cmd.color)
				case render.CommandKind.FillCircle:
					fill(new Circle(cmd.center, cmd.radius), cmd.color)
				case render.CommandKind.StrokeCircle:
					stroke(new Path().circle(cmd.center, cmd.radius), cmd.color, StrokeStyle{width: cmd.strokeWidth.max(1.0) * 1(px)})
				case render.CommandKind.FillEllipse:
					fill(new Path().ellipse(cmd.center, cmd.rx, cmd.ry), cmd.color)
				case render.CommandKind.StrokeEllipse:
					stroke(new Path().ellipse(cmd.center, cmd.rx, cmd.ry), cmd.color, StrokeStyle{width: cmd.strokeWidth.max(1.0) * 1(px)})
				case render.CommandKind.FillTriangle:
					fill(polylinePath(Point[cmd.p0, cmd.p1, cmd.p2], true), cmd.color)
				case render.CommandKind.StrokeTriangle:
					stroke(polylinePath(Point[cmd.p0, cmd.p1, cmd.p2], true), cmd.color, StrokeStyle{width: cmd.strokeWidth.max(1.0) * 1(px)})
				case render.CommandKind.BlitCopy:
					blitCopy(cmd.src, cmd.srcW, cmd.srcH, cmd.x, cmd.y)
				case render.CommandKind.Blit:
					blit(cmd.src, cmd.srcW, cmd.srcH, cmd.x, cmd.y, cmd.mode)
				case render.CommandKind.BlitRGBAtoBGRA:
					blitRGBAtoBGRA(cmd.src, cmd.srcW, cmd.srcH, cmd.x, cmd.y)
				case render.CommandKind.Video:
					drawVideo(cmd)
			}
		}

		// Draws a Video command's frame into its rectangle, converted on the
		// CPU.
		internal def drawVideo(cmd render.DrawCommand) {
			let frame = cmd.video
			return when frame is none
			let w = int(cmd.rect.right - cmd.rect.left)
			let h = int(cmd.rect.bottom - cmd.rect.top)
			return when w <= 0 || h <= 0
			let area = new image.Image(w, h)
			video.draw(frame, area, cmd.fit)
			blitCopy(area.raw(), w, h, int(cmd.rect.left), int(cmd.rect.top))
		}

		// clear fills every pixel with the colour.
		def clear(c Color) {
			changed(0, 0, width, height)
			let rgba = c.rgba

			// Fast path: fill the buffer with a packed RGBA pixel.
			//
			// Note: `mem.set32` uses native-endian 32-bit stores; ADM targets are
			// currently little-endian, so packing as r|g<<8|b<<16|a<<24 produces
			// in-memory bytes [R, G, B, A].
			if pixels.len() == width * height * 4 {
				let packed = c.pack()
				// Rows on tasks: one core cannot fill memory as fast as several.
				forRows(width, height, def (from int, to int) {
					mem.set32(pixels[from * width * 4:to * width * 4], packed)
				})
				return
			}
			if mem.set32(pixels, c.pack()) == pixels.len() {
				return
			}

			// Fallback (should not happen for Canvas RGBA8 buffers).
			let n = pixels.len()
			for let i = 0; i < n; i = i + 4 {
				pixels[i + 0] = rgba.r
				pixels[i + 1] = rgba.g
				pixels[i + 2] = rgba.b
				pixels[i + 3] = rgba.a
			}
		}

		// The box of pixels written since the last `clearChanges` (or since
		// the canvas was made), or none. Every drawing call counts; `raw()`
		// and `bytes()` count as writing everything, since callers may write
		// through them. Renderers and `Layers` use it to redo only what
		// changed.
		def changes() ?Rect {
			return none when chX0 >= chX1 || chY0 >= chY1
			return Rect{left: float(chX0), top: float(chY0), right: float(chX1), bottom: float(chY1)}
		}

		// Forgets the changes so far.
		def clearChanges() {
			chX0 = 0
			chY0 = 0
			chX1 = 0
			chY1 = 0
		}

		// Adds the box x0..x1, y0..y1 (clipped to the canvas) to the changes.
		internal def changed(x0, y0, x1, y1 int) {
			let (a, b, c, d) = (x0.max(0), y0.max(0), x1.min(width), y1.min(height))
			return when a >= c || b >= d
			if chX0 >= chX1 || chY0 >= chY1 {
				chX0 = a
				chY0 = b
				chX1 = c
				chY1 = d
				return
			}
			chX0 = chX0.min(a)
			chY0 = chY0.min(b)
			chX1 = chX1.max(c)
			chY1 = chY1.max(d)
		}

		// Pushes the drawing settings (transform, clip, alpha, composite,
		// blend, antialias, sampling) so `restore` can bring them back.
		def save() {
			saved.push(copyState(current))
		}

		// Brings back the settings of the last `save`; with none saved it
		// does nothing.
		def restore() {
			return when saved.len() == 0
			current = saved.pop()
		}

		// A copy of the drawing settings.
		def state() DrawState {
			return copyState(current)
		}

		// Replaces the drawing settings with a copy of `s`.
		def setState(s DrawState) {
			current = copyState(s)
		}

		// Moves what is drawn next by dx, dy (in the current user space).
		def translate(dx, dy float) {
			current.transform = current.transform.then(new Transform2D(tx = dx, ty = dy))
		}

		// Rotates what is drawn next by `angle` radians, clockwise, around
		// `around`.
		def rotate(angle float, around Point = new Point(0.0, 0.0)) {
			let t = current.transform.then(new Transform2D(tx = around.x, ty = around.y))
			t = t.then(new Transform2D().rotation(angle))
			current.transform = t.then(new Transform2D(tx = -around.x, ty = -around.y))
		}

		// Scales what is drawn next by sx, sy.
		def scale(sx, sy float) {
			current.transform = current.transform.then(new Transform2D(a = sx, d = sy))
		}

		// Multiplies the current transform by `t`: `t` applies first.
		def transform(t Transform2D) {
			current.transform = current.transform.then(t)
		}

		// Replaces the current transform.
		def setTransform(t Transform2D) {
			current.transform = copyTransform(t)
		}

		// Back to drawing in device pixels.
		def resetTransform() {
			current.transform = new Transform2D()
		}

		// Narrows the clip to the area the path encloses (through the current
		// transform) until `restore`, anti-aliased unless `antialias` is off.
		def clip(path Path, rule FillRule = FillRule.NonZero, antialias bool = true) {
			current.clip = clipToPath(self, device(path), rule, antialias, current.clip)
		}

		// Narrows the clip to the rectangle (through the current transform).
		def clip(rect Rect) {
			let t = current.transform
			let old = current.clip
			if t.b == 0.0 && t.c == 0.0 && old is none {
				// Axis-aligned on whole pixels: a box, no mask.
				let x0 = rect.left * t.a + t.tx
				let x1 = rect.right * t.a + t.tx
				let y0 = rect.top * t.d + t.ty
				let y1 = rect.bottom * t.d + t.ty
				let l = x0.min(x1)
				let r = x0.max(x1)
				let top = y0.min(y1)
				let b = y0.max(y1)
				if l == l.floor() && r == r.floor() && top == top.floor() && b == b.floor() {
					current.clip = new ClipRegion(int(l).max(0), int(top).max(0), int(r).min(width), int(b).min(height))
					return
				}
			}
			clip(new Path().rect(rect))
		}

		// Narrows the clip by a mask, read in device pixels (a CircleMask, a
		// PathMask, an image's coverage…).
		def clip(mask Mask) {
			current.clip = clipToMask(self, mask, current.clip)
		}

		// Multiplies the opacity of what is drawn next: 0.5 or 50(%).
		def setAlpha(alpha float | Percent) {
			match alpha {
				case Percent:
					current.alpha = (float(alpha) / 100.0).clamp(0.0, 1.0)
				case float:
					current.alpha = alpha.clamp(0.0, 1.0)
			}
		}

		// The Porter-Duff operator for what is drawn next.
		def setComposite(op Composite) {
			current.composite = op
		}

		// The blend mode for what is drawn next.
		def setBlend(mode BlendMode) {
			current.blend = mode
		}

		// Whether edges are anti-aliased (default) or whole pixels.
		def setAntialias(on bool) {
			current.antialias = on
		}

		// How images drawn through a transform are sampled.
		def setSampling(s Sampling) {
			current.sampling = s
		}

		// Whether the device pixel point p is inside what `fill(path)` would
		// paint under the current transform (the clip is not considered).
		def isInPath(path Path, p Point, rule FillRule = FillRule.NonZero) bool {
			return device(path).contains(p, rule)
		}

		// Whether the device pixel point p is inside what `stroke(path)`
		// would paint under the current transform.
		def isInStroke(path Path, p Point, strokeStyle StrokeStyle) bool {
			return strokeOutline(path, strokeStyle).contains(p)
		}

		// Fills the area the path encloses under the rule, through the
		// current transform, clip, alpha, composite and blend.
		def fill(path Path, paint Paint, rule FillRule = FillRule.NonZero) {
			let (x0, y0, x1, y1) = fillPath(self, device(path), rule, paint, current)
			changed(x0, y0, x1, y1)
		}

		// Paints the path's outline in the style. Widths are in user space,
		// so they scale with the transform, unless the style is `fixedWidth`.
		def stroke(path Path, paint Paint, strokeStyle StrokeStyle = StrokeStyle{}) {
			let (x0, y0, x1, y1) = fillPath(self, strokeOutline(path, strokeStyle), FillRule.NonZero, paint, current)
			changed(x0, y0, x1, y1)
		}

		// The path in device pixels.
		internal def device(path Path) Path {
			return path when isIdentity(current.transform)
			return path.transformed(current.transform)
		}

		// The device-space outline stroking `path` paints: stroked in user
		// space and transformed, curves within a tenth of a device pixel, or
		// stroked after the transform for fixed widths.
		internal def strokeOutline(path Path, strokeStyle StrokeStyle) Path {
			let t = current.transform
			return path.stroked(strokeStyle) when isIdentity(t)
			return device(path).stroked(strokeStyle) when strokeStyle.fixedWidth
			return path.stroked(strokeStyle, 0.1 / maxScale(t)).transformed(t)
		}

		// Whether the settings are the defaults a plain span fill matches.
		internal def isPlain() bool {
			let st = current
			return isIdentity(st.transform) && st.clip is none && st.alpha == 1.0 && st.composite == Composite.SourceOver && st.blend == BlendMode.Normal
		}

		// Draws the raster with its top left at `at`, one source pixel per
		// user unit, through the current transform, clip and alpha; the
		// state's sampling applies when the transform scales or rotates it.
		def drawImage(src Raster, at Point) {
			let size = src.size()
			let w = int(size.width)
			let h = int(size.height)
			let t = current.transform
			let x = at.x + t.tx
			let y = at.y + t.ty
			let plainState = current.clip is none && current.alpha == 1.0 && current.composite == Composite.SourceOver && current.blend == BlendMode.Normal
			if plainState && t.a == 1.0 && t.b == 0.0 && t.c == 0.0 && t.d == 1.0 && x == x.floor() && y == y.floor() && src.stride() == w * 4 {
				// On whole pixels, unscaled: every sample is a source pixel.
				blit(src.raw(), w, h, int(x), int(y))
				return
			}
			drawImage(src, Rect{left: 0.0, top: 0.0, right: float(w), bottom: float(h)}, Rect{left: at.x, top: at.y, right: at.x + float(w), bottom: at.y + float(h)}, current.sampling)
		}

		// Draws the whole raster scaled into `dest`.
		def drawImage(src Raster, dest Rect, sampling = Sampling.Bilinear) {
			let size = src.size()
			drawImage(src, Rect{left: 0.0, top: 0.0, right: float(size.width), bottom: float(size.height)}, dest, sampling)
		}

		// Draws the `source` part of the raster (source pixels) scaled into
		// `dest`. Samples never read outside `source`.
		def drawImage(src Raster, source Rect, dest Rect, sampling = Sampling.Bilinear) {
			let sw = source.right - source.left
			let sh = source.bottom - source.top
			let dw = dest.right - dest.left
			let dh = dest.bottom - dest.top
			return when sw <= 0.0 || sh <= 0.0 || dw == 0.0 || dh == 0.0
			// Source pixels to user space, then to device pixels.
			let place = new Transform2D(a = dw / sw, d = dh / sh, tx = dest.left - source.left * dw / sw, ty = dest.top - source.top * dh / sh)
			let shader = new PatternShader(src, source, Spread.Pad, Spread.Pad, current.transform.then(place), sampling)
			let (x0, y0, x1, y1) = fillWith(self, device(new Path().rect(dest)), FillRule.NonZero, new Color(RGBA{r: 0, g: 0, b: 0, a: 255}), shader, true, current)
			changed(x0, y0, x1, y1)
		}

		// Nine-slice: the raster's corners (`insets` in source pixels) keep
		// their size, its edges stretch along one axis and its centre along
		// both (UI panels, buttons). Corners shrink together when `dest` is
		// too small for them.
		def drawImage(src Raster, dest Rect, insets Edges<Pixels>) {
			let size = src.size()
			let w = float(size.width)
			let h = float(size.height)
			let (l, r, t, b) = (float(insets.left), float(insets.right), float(insets.top), float(insets.bottom))
			let dw = dest.right - dest.left
			let dh = dest.bottom - dest.top
			let fx = (l + r > dw && l + r > 0.0) ?? (dw / (l + r), 1.0)
			let fy = (t + b > dh && t + b > 0.0) ?? (dh / (t + b), 1.0)
			let sx = float[0.0, l, w - r, w]
			let sy = float[0.0, t, h - b, h]
			let dx = float[dest.left, dest.left + l * fx, dest.right - r * fx, dest.right]
			let dy = float[dest.top, dest.top + t * fy, dest.bottom - b * fy, dest.bottom]
			for let j = 0; j < 3; j++ {
				for let i = 0; i < 3; i++ {
					continue when sx[i + 1] <= sx[i] || sy[j + 1] <= sy[j] || dx[i + 1] <= dx[i] || dy[j + 1] <= dy[j]
					drawImage(src, Rect{left: sx[i], top: sy[j], right: sx[i + 1], bottom: sy[j + 1]}, Rect{left: dx[i], top: dy[j], right: dx[i + 1], bottom: dy[j + 1]}, current.sampling)
				}
			}
		}

		// Starts a group: everything drawn until `endGroup` goes to an
		// offscreen surface, which is then composited as one, so its
		// opacity, blend, effects and mask apply to the group, not to each
		// shape (Skia saveLayer, SVG <g>). The drawing settings are saved and
		// come back at `endGroup`; `bounds` (user space) limits what the group
		// keeps.
		def beginGroup(opacity float | Percent = 100(%), blend = BlendMode.Normal, effects Effect[] = [], mask ?Mask = none, bounds ?Rect = none) {
			let o = 1.0
			match opacity {
				case Percent:
					o = float(opacity) / 100.0
				case float:
					o = opacity
			}
			save()
			groups.push(new GroupFrame(pixels, o, blend, effects, mask, copyTransform(current.transform)))
			let fresh byte[]
			fresh.len(pixels.len())
			pixels = fresh
			if bounds is Rect {
				clip(bounds)
			}
		}

		// Closes the last group: applies its effects and composites it onto
		// what was drawn before, through the clip in effect at `beginGroup`.
		// With no group open it does nothing.
		def endGroup() {
			return when groups.len() == 0
			let f = groups.pop()
			let g = pixels
			pixels = f.parent
			restore()
			let (x0, y0, x1, y1) = closeGroup(self, f, g, current.clip)
			changed(x0, y0, x1, y1)
		}

		// Fills the text with its first glyph's anchor at `at` (as `align`
		// and `baseline` say), through the transform, clip and effects like
		// any fill. Glyphs come from `fonts.shape`: ligatures, kerning, marks.
		def fillText(text string, at Point, textStyle TextStyle, paint Paint) {
			fill(textPath(text, at, textStyle), paint)
		}

		// Paints the text's outline.
		def strokeText(text string, at Point, textStyle TextStyle, paint Paint, strokeStyle StrokeStyle = StrokeStyle{}) {
			stroke(textPath(text, at, textStyle), paint, strokeStyle)
		}

		// Fills the text along the path from `offset` along it: each glyph
		// centred on its place and turned to the path's direction, `baseline`
		// shifting it across the path; glyphs past the end are left out.
		def fillText(text string, along Path, textStyle TextStyle, paint Paint, offset float = 0.0) {
			fill(textAlong(text, along, textStyle, offset), paint)
		}

		// The text's layout without drawing it: advance, ascent, descent, the
		// ink box and each glyph's place, relative to the anchor.
		def measureText(text string, textStyle TextStyle) TextMetrics {
			return textMetrics(text, textStyle)
		}

		// The glyphs as one path, for clipping, boolean operations or custom
		// effects; what `fillText` fills.
		def textPath(text string, at Point, textStyle TextStyle) Path {
			return textPathUnder(text, at, textStyle, current.transform)
		}

		// Fills the rectangle; one on whole pixels in an opaque colour takes
		// the solid-span path.
		def fill(rect Rect, paint Paint) {
			let whole = rect.left == rect.left.floor() && rect.top == rect.top.floor() && rect.right == rect.right.floor() && rect.bottom == rect.bottom.floor()
			if whole && isPlain() && paint is Color && paint.rgba.a == 255 && rect.left <= rect.right && rect.top <= rect.bottom {
				fillRectPixels(rect, paint)
				return
			}
			fill(new Path().rect(rect), paint)
		}

		// Fills the rectangle with every corner rounded by `radius` pixels.
		def fill(rect Rect, radius float, paint Paint) {
			fill(new Path().roundRect(rect, radius * 1(px)), paint)
		}

		// Paints the rectangle's outline, centred on its edges.
		def stroke(rect Rect, paint Paint, strokeStyle StrokeStyle = StrokeStyle{}) {
			stroke(new Path().rect(rect), paint, strokeStyle)
		}

		// Fills the circle.
		def fill(circle Circle, paint Paint) {
			fill(new Path().circle(circle.center, circle.radius), paint)
		}

		// Paints the segment in the style.
		def stroke(line Line, paint Paint, strokeStyle StrokeStyle = StrokeStyle{}) {
			stroke(new Path().moveTo(line.start.x, line.start.y).lineTo(line.end.x, line.end.y), paint, strokeStyle)
		}

		// Paints the whole-pixel rectangle opaque or blended, as spans: the
		// fast path of `fill(rect)`. Right and bottom edges are exclusive.
		internal def fillRectPixels(rect Rect, c Color) {
			let (
				rgba       = c.rgba
				r, g, b, a = rgba.r, rgba.g, rgba.b, rgba.a

				x0 = int(rect.left)
				y0 = int(rect.top)
				x1 = int(rect.right)
				y1 = int(rect.bottom)
			)

			x0 = 0 when x0 < 0
			y0 = 0 when y0 < 0
			x1 = width when x1 > width
			y1 = height when y1 > height

			return when x0 >= x1 || y0 >= y1
			changed(x0, y0, x1, y1)

			if a >= 255 {
				let packed = c.pack()
				let rowBytes = (x1 - x0) * 4
				forRows(x1 - x0, y1 - y0, def (from int, to int) {
					if x0 == 0 && x1 == width {
						// Whole rows: the band is one run.
						mem.set32(pixels[(y0 + from) * rowBytes:(y0 + to) * rowBytes], packed)
						return
					}
					for let y = y0 + from; y < y0 + to; y++ {
						let dstOff = ((y * width) + x0) * 4
						mem.set32(pixels[dstOff:dstOff + rowBytes], packed)
					}
				})
				return
			}

			forRows(x1 - x0, y1 - y0, def (from int, to int) {
				for let y = y0 + from; y < y0 + to; y++ {
					blendSpan(((y * width) + x0) * 4, x1 - x0, r, g, b, a)
				}
			})
		}

		// setPixel blends the colour into the pixel at x, y; a point outside the
		// canvas is ignored.
		def setPixel(x int, y int, c Color) {
			return when x < 0 || y < 0 || x >= width || y >= height
			changed(x, y, x + 1, y + 1)
			let i = (y * width + x) * 4
			blendPixelAt(i, c)
		}

		internal def div255(x int) int {
			return canvasDiv255(x)
		}

		// blendPixelAt blends the colour into the pixel at byte offset i of the
		// buffer, weighted by the colour's alpha.
		def blendPixelAt(i int, c Color) {
			let rgba = c.rgba
			blendPixel(pixels, i, rgba.r, rgba.g, rgba.b, rgba.a)
		}

		// blendBytesAt blends the colour r, g, b, a into the pixel at byte
		// offset i.
		internal def blendBytesAt(i int, r byte, g byte, b byte, a byte) {
			blendPixel(pixels, i, r, g, b, a)
		}

		// blendSpan blends the colour r, g, b, a into `count` pixels from byte
		// offset i.
		internal def blendSpan(i int, count int, r byte, g byte, b byte, a byte) {
			blendRun(pixels, i, count, r, g, b, a)
		}

		// drawSpan blends the colour into row y from x0 to x1, in either order,
		// clipped to the canvas.
		def drawSpan(y int, x0 int, x1 int, c Color) {
			let xa = x0
			let xb = x1
			if xa > xb {
				let tmp = xa
				xa = xb
				xb = tmp
			}
			return when y < 0 || y >= height

			xa = 0 when xa < 0
			xb = width - 1 when xb >= width
			return when xa > xb
			changed(xa, y, xb + 1, y + 1)

			let i = (y * width + xa) * 4
			let count = (xb - xa + 1)
			let rowBytes = count * 4
			let rgba = c.rgba
			if rgba.a >= 255 {
				mem.set32(pixels[i:i + rowBytes], c.pack())
				return
			}
			blendSpan(i, count, rgba.r, rgba.g, rgba.b, rgba.a)
		}

		// blitCopy copies pixels from `src` (RGBA8) into this canvas at `(x, y)`.
		// Pixels are copied as-is; no alpha blending is performed.
		def blitCopy(src byte[], srcW int, srcH int, x int, y int) {
			changed(x, y, x + srcW, y + srcH)
			return when srcW <= 0 || srcH <= 0

			// Basic safety: ensure the input buffer can cover the declared dimensions.
			return when srcW > (1024 * 1024 * 1024) / 4

			let rowStride = srcW * 4
			return when rowStride <= 0
			return when srcH > (1024 * 1024 * 1024) / rowStride

			let want = rowStride * srcH
			return when want <= 0 || src.len() < want

			let (
				dst   = self
				dstX0 = x
				dstY0 = y
				srcX0 = 0
				srcY0 = 0
			)

			if dstX0 < 0 {
				srcX0 = -dstX0
				dstX0 = 0
			}
			if dstY0 < 0 {
				srcY0 = -dstY0
				dstY0 = 0
			}

			let blitW = srcW - srcX0
			let blitH = srcH - srcY0
			return when blitW <= 0 || blitH <= 0

			let dstMaxW = dst.width - dstX0
			let dstMaxH = dst.height - dstY0
			return when dstMaxW <= 0 || dstMaxH <= 0

			blitW = dstMaxW when blitW > dstMaxW
			blitH = dstMaxH when blitH > dstMaxH
			return when blitW <= 0 || blitH <= 0

			let rowBytes = blitW * 4
			for let row = 0; row < blitH; row = row + 1 {
				let srcOff = ((srcY0 + row) * srcW + srcX0) * 4
				let dstOff = ((dstY0 + row) * dst.width + dstX0) * 4
				mem.copyN(dst.pixels[dstOff:dstOff + rowBytes], src[srcOff:srcOff + rowBytes], rowBytes)
			}
		}

		// blitCopy copies another canvas's pixels onto this one with its top-left
		// corner at x, y, replacing what is there.
		def blitCopy(src Canvas, x int, y int) {
			blitCopy(src.pixels, src.width, src.height, x, y)
		}

		// blitCopy copies an image's pixels onto the canvas with its top-left corner
		// at x, y, replacing what is there.
		def blitCopy(src image.Image, x int, y int) {
			blitCopy(src.raw(), int(src.size().width), int(src.size().height), x, y)
		}

		// blit draws pixels from `src` into this canvas using alpha compositing.
		def blit(src byte[], srcW int, srcH int, x int, y int, mode BlendMode = BlendMode.Normal) {
			changed(x, y, x + srcW, y + srcH)
			return when srcW <= 0 || srcH <= 0

			// Basic safety: ensure the input buffer can cover the declared dimensions.
			return when srcW > (1024 * 1024 * 1024) / 4
			let rowStride = srcW * 4

			return when rowStride <= 0
			return when srcH > (1024 * 1024 * 1024) / rowStride

			let want = rowStride * srcH
			return when want <= 0 || src.len() < want

			let (
				dst   = self
				dstX0 = x
				dstY0 = y
				srcX0 = 0
				srcY0 = 0
			)

			if dstX0 < 0 {
				srcX0 = -dstX0
				dstX0 = 0
			}
			if dstY0 < 0 {
				srcY0 = -dstY0
				dstY0 = 0
			}

			let (
				blitW = srcW - srcX0
				blitH = srcH - srcY0
			)
			return when blitW <= 0 || blitH <= 0

			let (
				dstMaxW = dst.width - dstX0
				dstMaxH = dst.height - dstY0
			)
			return when dstMaxW <= 0 || dstMaxH <= 0

			blitW = dstMaxW when blitW > dstMaxW
			blitH = dstMaxH when blitH > dstMaxH
			return when blitW <= 0 || blitH <= 0

			if mode == BlendMode.Normal {
				forRows(blitW, blitH, def (from int, to int) {
					blitNormal(src, srcW, srcX0, srcY0 + from, dstX0, dstY0 + from, blitW, to - from)
				})
				return
			}

			// The other modes on bytes, a pixel at a time.
			forRows(blitW, blitH, def (from int, to int) {
				for let row = from; row < to; row++ {
					let s = ((srcY0 + row) * srcW + srcX0) * 4
					let d = ((dstY0 + row) * width + dstX0) * 4
					for let i = 0; i < blitW * 4; i += 4 {
						continue when src[s + i + 3] == 0
						let (r, g, b, a) = colorspace.blendBytes(mode, src[s + i], src[s + i + 1], src[s + i + 2], src[s + i + 3], pixels[d + i], pixels[d + i + 1], pixels[d + i + 2], pixels[d + i + 3])
						pixels[d + i + 0] = r
						pixels[d + i + 1] = g
						pixels[d + i + 2] = b
						pixels[d + i + 3] = a
					}
				}
			})
		}

		// blitNormal composites the blitW x blitH pixels of `src` from srcX0,
		// srcY0 over this canvas at dstX0, dstY0 with blendRGBA's Normal
		// arithmetic, in the same order: one pixel a vector of four float64
		// lanes, so the bytes match it exactly.
		internal def blitNormal(src byte[], srcW int, srcX0 int, srcY0 int, dstX0 int, dstY0 int, blitW int, blitH int) {
			let zero = simd.splat4<float64>(float64(0))
			let one = simd.splat4<float64>(float64(1))
			let full = simd.splat4<float64>(float64(255))
			let half = simd.splat4<float64>(float64(0.5))
			for let row = 0; row < blitH; row++ {
				let s = ((srcY0 + row) * srcW + srcX0) * 4
				let d = ((dstY0 + row) * width + dstX0) * 4
				let end = s + blitW * 4
				for s < end {
					let sa8 = src[s + 3]
					if sa8 == 255 || (sa8 > 0 && pixels[d + 3] == 0) {
						pixels[d + 0] = src[s + 0]
						pixels[d + 1] = src[s + 1]
						pixels[d + 2] = src[s + 2]
						pixels[d + 3] = sa8
					} else if sa8 > 0 {
						let sa = float(sa8) / 255.0
						let da = float(pixels[d + 3]) / 255.0
						let ao = sa + da - sa * da
						let cs = simd.convert<byte, float64>(simd.load4<byte>(src, s)) / full
						let cd = simd.convert<byte, float64>(simd.load4<byte>(pixels, d)) / full
						let p = cs * simd.splat4<float64>(float64(sa)) * simd.splat4<float64>(float64(1.0 - da)) + cd * simd.splat4<float64>(float64(da)) * simd.splat4<float64>(float64(1.0 - sa)) + cs * simd.splat4<float64>(float64(sa * da))
						let out = ((p / simd.splat4<float64>(float64(ao))).clamp(zero, one) * full + half).floor()
						simd.store4<byte>(pixels, d, simd.convert<float64, byte>(out))
						pixels[d + 3] = colorspace.clampU8(ao * 255.0)
					}
					s += 4
					d += 4
				}
			}
		}

		// blit draws another canvas onto this one at x, y, blending with the mode.
		def blit(src Canvas, x int, y int, mode BlendMode = BlendMode.Normal) {
			blit(src.pixels, src.width, src.height, x, y, mode)
		}

		// blit draws an image onto the canvas at x, y, blending with the mode.
		def blit(src image.Image, x int, y int, mode BlendMode = BlendMode.Normal) {
			blit(src.raw(), int(src.size().width), int(src.size().height), x, y, mode)
		}

		// blitRGBAtoBGRA copies pixels from `src` (RGBA8) into this canvas,
		// swapping the R and B channels.
		def blitRGBAtoBGRA(src byte[], srcW int, srcH int, x int, y int) {
			changed(x, y, x + srcW, y + srcH)
			return when srcW <= 0 || srcH <= 0

			// Same safety checks as blit().
			return when srcW > (1024 * 1024 * 1024) / 4
			let rowStride = srcW * 4
			return when rowStride <= 0
			return when srcH > (1024 * 1024 * 1024) / rowStride
			let want = rowStride * srcH
			return when want <= 0 || src.len() < want

			let dst = self
			let dstX0 = x
			let dstY0 = y
			let srcX0 = 0
			let srcY0 = 0

			if dstX0 < 0 {
				srcX0 = -dstX0
				dstX0 = 0
			}
			if dstY0 < 0 {
				srcY0 = -dstY0
				dstY0 = 0
			}

			let blitW = srcW - srcX0
			let blitH = srcH - srcY0
			return when blitW <= 0 || blitH <= 0

			let dstMaxW = dst.width - dstX0
			let dstMaxH = dst.height - dstY0
			return when dstMaxW <= 0 || dstMaxH <= 0

			blitW = dstMaxW when blitW > dstMaxW
			blitH = dstMaxH when blitH > dstMaxH
			return when blitW <= 0 || blitH <= 0

			let idx = simd.load16<byte>(__rgba_to_bgra_swizzle, 0)
			let rowBytes = blitW * 4

			for let row = 0; row < blitH; row = row + 1 {
				let srcOff = ((srcY0 + row) * srcW + srcX0) * 4
				let dstOff = ((dstY0 + row) * dst.width + dstX0) * 4

				// SIMD: 16 bytes per chunk (4 pixels).
				let n = (rowBytes / 16) * 16
				for let i = 0; i < n; i = i + 16 {
					simd.store16<byte>(dst.pixels, dstOff + i, simd.load16<byte>(src, srcOff + i).shuffle(idx))
				}

				// Tail.
				for let i = n; i < rowBytes; i = i + 4 {
					let r = src[srcOff + i + 0]
					let g = src[srcOff + i + 1]
					let b = src[srcOff + i + 2]
					let a = src[srcOff + i + 3]
					dst.pixels[dstOff + i + 0] = b
					dst.pixels[dstOff + i + 1] = g
					dst.pixels[dstOff + i + 2] = r
					dst.pixels[dstOff + i + 3] = a
				}
			}
		}
	}

	// The points joined in order, closed when `closed`.
	internal def polylinePath(points Point[], closed bool) Path {
		let p = new Path()
		return p when points.len() == 0
		p.moveTo(points[0].x, points[0].y)
		for let i = 1; i < points.len(); i++ {
			p.lineTo(points[i].x, points[i].y)
		}
		p.close() when closed
		return p
	}
}
