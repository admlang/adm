partial module std.gfx.canvas {
	use (
		std.gfx.color::(Color, BlendMode, RGBA, blendRGBA)
		std.gfx.render as render
		std.formats.image as image
		std.mem
		std.math
		std.simd
		std.time
		std.math.geom::(Point, Rect, Size)
	)

	// SIMD shuffle indices for swizzling RGBA8 -> BGRA8 for 4 pixels (16 bytes).
	// Per pixel: [R,G,B,A] -> [B,G,R,A].
	internal const __rgba_to_bgra_swizzle = byte[
		2, 1, 0, 3,
		6, 5, 4, 7,
		10, 9, 8, 11,
		14, 13, 12, 15,
	]

	// Canvas is a CPU-side RGBA8 framebuffer.
	//
	// Renderers can upload `pixels` to a GPU texture, or use it as a software backbuffer.
	// The pixel format is always RGBA with 8 bits per channel and row-major layout:
	// `(x, y) -> i := (y*width + x) * 4` with bytes `[R, G, B, A]`.
	type Canvas {
		width  int
		height int
		pixels byte[]

		def new(width int, height int) {
			self.width = width
			self.height = height

			let n = width * height * 4
			pixels.len(n)
			pixels[:] = 0
		}

		def getDrawContext() DrawContext {
			return new DrawContext(new Size(float(width), float(height)))
		}

		// The pixel dimensions of this canvas.
		def size() Size<uint> {
			return new Size<uint>(uint(width), uint(height))
		}

		// Bytes per row; canvas rows are always tightly packed.
		def stride() int {
			return width * 4
		}

		// The backing RGBA8 buffer, shared with this canvas, not copied.
		def raw() byte[] {
			return pixels
		}

		// Adopts a new backing store after a geometry-changing operation.
		// Canvas rows are tightly packed, so a loose stride is repacked.
		def reshape(data byte[], size Size<uint>, stride int) {
			width = int(size.width)
			height = int(size.height)
			let tight = width * 4
			if stride == tight {
				pixels = data
				return
			}
			let packed = byte[]
			packed.len(height * tight)
			for let y = 0; y < height; y++ {
				mem.copyN(packed[y * tight:(y + 1) * tight], data[y * stride:y * stride + tight], tight)
			}
			pixels = packed
		}

		def bytes() byte[] {
			return pixels
		}

		// Coverage as a mask (gfx.Mask): luminance scaled by alpha, like Image.
		def coverage(x, y int) float {
			return 0.0 when x < 0 || y < 0 || x >= width || y >= height
			let o = (y * width + x) * 4
			let lum = 0.299 * float(pixels[o]) + 0.587 * float(pixels[o + 1]) + 0.114 * float(pixels[o + 2])
			return ((lum / 255.0) * (float(pixels[o + 3]) / 255.0)).clamp(0.0, 1.0)
		}

		// apply applies a DrawContext command list onto this Canvas.
		def apply(ctx DrawContext) {
			for let (_, cmd) in ctx.commands() {
				switch cmd.kind {
					case render.CommandKind.Clear:
						clear(cmd.color)
					case render.CommandKind.FillRect:
						fillRect(cmd.rect, cmd.color)
					case render.CommandKind.StrokeRect:
						strokeRect(cmd.rect, cmd.color, cmd.strokeWidth)
					case render.CommandKind.Line:
						strokeLine(cmd.p0, cmd.p1, cmd.color, cmd.strokeWidth)
					case render.CommandKind.Polyline:
						polyline(cmd.points, cmd.color, cmd.strokeWidth)
					case render.CommandKind.Polygon:
						fillPolygon(cmd.points, cmd.color)
					case render.CommandKind.FillCircle:
						fillCircle(cmd.center, cmd.radius, cmd.color)
					case render.CommandKind.StrokeCircle:
						strokeCircle(cmd.center, cmd.radius, cmd.color, cmd.strokeWidth)
					case render.CommandKind.FillEllipse:
						fillEllipse(cmd.center, cmd.rx, cmd.ry, cmd.color)
					case render.CommandKind.StrokeEllipse:
						strokeEllipse(cmd.center, cmd.rx, cmd.ry, cmd.color, cmd.strokeWidth)
					case render.CommandKind.FillTriangle:
						fillTriangle(cmd.p0, cmd.p1, cmd.p2, cmd.color)
					case render.CommandKind.StrokeTriangle:
						strokeTriangle(cmd.p0, cmd.p1, cmd.p2, cmd.color, cmd.strokeWidth)
					case render.CommandKind.BlitCopy:
						blitCopy(cmd.src, cmd.srcW, cmd.srcH, cmd.x, cmd.y)
					case render.CommandKind.Blit:
						blit(cmd.src, cmd.srcW, cmd.srcH, cmd.x, cmd.y, cmd.mode)
					case render.CommandKind.BlitRGBAtoBGRA:
						blitRGBAtoBGRA(cmd.src, cmd.srcW, cmd.srcH, cmd.x, cmd.y)
				}
			}
		}

		def clear(c Color) {
			let rgba = c.rgba

			// Fast path: fill the buffer with a packed RGBA pixel.
			//
			// Note: `mem.set32` uses native-endian 32-bit stores; ADM targets are
			// currently little-endian, so packing as r|g<<8|b<<16|a<<24 produces
			// in-memory bytes [R, G, B, A].
			if mem.set32(pixels, c.pack()) == pixels.len() {
				return
			}

			// Fallback (should not happen for Canvas RGBA8 buffers).
			let n = pixels.len()
			for let i = 0; i < n; i = i + 4 {
				pixels[i + 0] = rgba.r
				pixels[i + 1] = rgba.g
				pixels[i + 2] = rgba.b
				pixels[i + 3] = rgba.a
			}
		}

		// fillRect paints a rectangle in canvas pixel coordinates.
		// The rect is treated as inclusive-exclusive on the right/bottom edges.
		def fillRect(rect Rect, c Color) {
			let (
				rgba       = c.rgba
				r, g, b, a = rgba.r, rgba.g, rgba.b, rgba.a

				x0 = int(rect.left)
				y0 = int(rect.top)
				x1 = int(rect.right)
				y1 = int(rect.bottom)
			)

			x0 = 0 when x0 < 0
			y0 = 0 when y0 < 0
			x1 = width when x1 > width
			y1 = height when y1 > height

			return when x0 >= x1 || y0 >= y1

			if a >= 255 {
				let packed = c.pack()

				for let y = y0; y < y1; y = y + 1 {
					let dstOff = ((y * width) + x0) * 4
					let rowBytes = (x1 - x0) * 4

					if mem.set32(pixels[dstOff:dstOff + rowBytes], packed) == rowBytes {
						continue
					}

					// Fallback (should not happen for 4-byte aligned rows).
					for let i = dstOff; i < dstOff + rowBytes; i = i + 4 {
						pixels[i + 0] = rgba.r
						pixels[i + 1] = rgba.g
						pixels[i + 2] = rgba.b
						pixels[i + 3] = rgba.a
					}
				}
				return
			}

			for let y = y0; y < y1; y = y + 1 {
				let dstOff = ((y * width) + x0) * 4
				let rowBytes = (x1 - x0) * 4
				for let i = dstOff; i < dstOff + rowBytes; i = i + 4 {
					blendPixelAt(i, c)
				}
			}
		}

		def strokeRect(rect Rect, c Color, width float = 1.0) {
			let w = int(width)
			w = 1 when w <= 0

			let (
				x0 = int(rect.left)
				y0 = int(rect.top)
				x1 = int(rect.right)
				y1 = int(rect.bottom)
			)

			let rw = x1 - x0
			let rh = y1 - y0
			return when rw <= 0 || rh <= 0

			fillRect(Rect{left: float(x0), top: float(y0), right: float(x1), bottom: float(y0 + w)}, c)
			fillRect(Rect{left: float(x0), top: float(y1 - w), right: float(x1), bottom: float(y1)}, c)
			fillRect(Rect{left: float(x0), top: float(y0 + w), right: float(x0 + w), bottom: float(y1 - w)}, c)
			fillRect(Rect{left: float(x1 - w), top: float(y0 + w), right: float(x1), bottom: float(y1 - w)}, c)
		}

		def setPixel(x int, y int, c Color) {
			return when x < 0 || y < 0 || x >= width || y >= height
			let i = (y * width + x) * 4
			blendPixelAt(i, c)
		}

		internal def div255(x int) int {
			let y = x + 128
			return (y + (y >> 8)) >> 8
		}

		def blendPixelAt(i int, c Color) {
			// Fast 8-bit divide by 255 with rounding.
			// Equivalent to (x + 127) / 255 for x in [0..~16M], but avoids division.
			let rgba = c.rgba
			if rgba.a >= 255 {
				pixels[i + 0] = rgba.r
				pixels[i + 1] = rgba.g
				pixels[i + 2] = rgba.b
				pixels[i + 3] = rgba.a
				return
			}
			return when rgba.a == 0

			let sa = int(rgba.a)
			let inv = 255 - sa
			let dr = int(pixels[i + 0])
			let dg = int(pixels[i + 1])
			let db = int(pixels[i + 2])
			let da = int(pixels[i + 3])

			let outR = div255(int(rgba.r) * sa + dr * inv)
			let outG = div255(int(rgba.g) * sa + dg * inv)
			let outB = div255(int(rgba.b) * sa + db * inv)
			let outA = sa + div255(da * inv)

			pixels[i + 0] = byte(outR)
			pixels[i + 1] = byte(outG)
			pixels[i + 2] = byte(outB)
			pixels[i + 3] = byte(outA)
		}

		def drawLine(x0 int, y0 int, x1 int, y1 int, c Color) {
			let dx = (x1 - x0).abs()
			let sx = (x0 < x1) ?? (1, -1)
			let dy = -(y1 - y0).abs()
			let sy = (y0 < y1) ?? (1, -1)
			let err = dx + dy

			for {
				setPixel(x0, y0, c)
				return when x0 == x1 && y0 == y1
				let e2 = err * 2
				if e2 >= dy {
					err = err + dy
					x0 = x0 + sx
				}
				if e2 <= dx {
					err = err + dx
					y0 = y0 + sy
				}
			}
		}

		def strokeLine(a Point, b Point, c Color, width float = 1.0) {
			let w = int(width)
			w = 1 when w <= 0
			if w == 1 {
				drawLine(int(a.x), int(a.y), int(b.x), int(b.y), c)
				return
			}

			let dx = b.x - a.x
			let dy = b.y - a.y
			let len = math.sqrt(dx * dx + dy * dy)
			if len <= 0.0 {
				fillCircle(a, width * 0.5, c)
				return
			}

			// Fast path for thick lines: rasterize a quad instead of drawing N parallel
			// 1px lines (which is O(width*length) overhead on top of the pixel work).
			let half = float(w) * 0.5
			let nx = -dy / len * half
			let ny = dx / len * half
			fillPolygon(Point[
				new Point(a.x + nx, a.y + ny),
				new Point(a.x - nx, a.y - ny),
				new Point(b.x - nx, b.y - ny),
				new Point(b.x + nx, b.y + ny),
			], c)
		}

		def polyline(points Point[], c Color, width float = 1.0) {
			return when points.len() < 2
			for let i = 0; i < points.len() - 1; i = i + 1 {
				strokeLine(points[i], points[i + 1], c, width)
			}
		}

		def fillPolygon(points Point[], c Color) {
			return when points.len() < 3

			let minY = int(points[0].y)
			let maxY = int(points[0].y)
			for let i = 1; i < points.len(); i = i + 1 {
				let y = int(points[i].y)
				minY = y when y < minY
				maxY = y when y > maxY
			}

			minY = 0 when minY < 0
			maxY = height - 1 when maxY >= height
			return when minY > maxY

			for let y = minY; y <= maxY; y = y + 1 {
				let nodes int[]
				let j = points.len() - 1
				for let i = 0; i < points.len(); i = i + 1 {
					let yi = points[i].y
					let yj = points[j].y
					if (yi < float(y) && yj >= float(y)) || (yj < float(y) && yi >= float(y)) {
						let xi = points[i].x
						let xj = points[j].x
						let x = xi + (float(y) - yi) * (xj - xi) / (yj - yi)
						nodes.push(int(x))
					}
					j = i
				}

				sortInts(nodes)
				for let i = 0; i + 1 < nodes.len(); i = i + 2 {
					drawSpan(y, nodes[i], nodes[i + 1], c)
				}
			}
		}

		def drawSpan(y int, x0 int, x1 int, c Color) {
			let xa = x0
			let xb = x1
			if xa > xb {
				let tmp = xa
				xa = xb
				xb = tmp
			}
			return when y < 0 || y >= height

			xa = 0 when xa < 0
			xb = width - 1 when xb >= width
			return when xa > xb

			let i = (y * width + xa) * 4
			let count = (xb - xa + 1)
			let rowBytes = count * 4
			let rgba = c.rgba
			if rgba.a >= 255 {
				mem.set32(pixels[i:i + rowBytes], c.pack())
				return
			}

			let end = i + rowBytes - 4
			for let off = i; off <= end; off = off + 4 {
				blendPixelAt(off, c)
			}
		}

		def sortInts(data int[]) {
			for let i = 1; i < data.len(); i = i + 1 {
				let key = data[i]
				let j = i - 1
				for j >= 0 && data[j] > key {
					data[j + 1] = data[j]
					j = j - 1
				}
				data[j + 1] = key
			}
		}

		def fillCircle(center Point, radius float, c Color) {
			return when radius <= 0.0
			let r = int(radius)
			let rr = radius * radius
			for let y = -r; y <= r; y = y + 1 {
				let dy = float(y)
				let t = rr - dy * dy
				continue when t < 0.0
				let dx = math.sqrt(t)
				drawSpan(int(center.y) + y, int(center.x - dx), int(center.x + dx), c)
			}
		}

		def strokeCircle(center Point, radius float, c Color, width float = 1.0) {
			let w = int(width)
			w = 1 when w <= 0
			let half = w / 2
			for let i = -half; i <= half; i = i + 1 {
				drawCircleOutline(center, radius + float(i), c)
			}
		}

		def drawCircleOutline(center Point, radius float, c Color) {
			return when radius <= 0.0
			let r = int(radius)
			let rr = radius * radius
			for let y = -r; y <= r; y = y + 1 {
				let dy = float(y)
				let t = rr - dy * dy
				continue when t < 0.0
				let dx = math.sqrt(t)
				setPixel(int(center.x - dx), int(center.y) + y, c)
				setPixel(int(center.x + dx), int(center.y) + y, c)
			}
		}

		def fillEllipse(center Point, rx float, ry float, c Color) {
			return when rx <= 0.0 || ry <= 0.0
			let ryi = int(ry)
			let rx2 = rx * rx
			let ry2 = ry * ry
			for let y = -ryi; y <= ryi; y = y + 1 {
				let dy = float(y)
				let t = 1.0 - (dy * dy) / ry2
				continue when t < 0.0
				let dx = math.sqrt(rx2 * t)
				drawSpan(int(center.y) + y, int(center.x - dx), int(center.x + dx), c)
			}
		}

		def strokeEllipse(center Point, rx float, ry float, c Color, width float = 1.0) {
			let w = int(width)
			w = 1 when w <= 0
			let half = w / 2
			for let i = -half; i <= half; i = i + 1 {
				drawEllipseOutline(center, rx + float(i), ry + float(i), c)
			}
		}

		def drawEllipseOutline(center Point, rx float, ry float, c Color) {
			return when rx <= 0.0 || ry <= 0.0
			let ryi = int(ry)
			let rx2 = rx * rx
			let ry2 = ry * ry
			for let y = -ryi; y <= ryi; y = y + 1 {
				let dy = float(y)
				let t = 1.0 - (dy * dy) / ry2
				continue when t < 0.0
				let dx = math.sqrt(rx2 * t)
				setPixel(int(center.x - dx), int(center.y) + y, c)
				setPixel(int(center.x + dx), int(center.y) + y, c)
			}
		}

		def fillTriangle(a Point, b Point, c0 Point, c Color) {
			fillPolygon(Point[a, b, c0], c)
		}

		def strokeTriangle(a Point, b Point, c0 Point, c Color, width float = 1.0) {
			strokeLine(a, b, c, width)
			strokeLine(b, c0, c, width)
			strokeLine(c0, a, c, width)
		}

		// blitCopy copies pixels from `src` (RGBA8) into this canvas at `(x, y)`.
		// Pixels are copied as-is; no alpha blending is performed.
		def blitCopy(src byte[], srcW int, srcH int, x int, y int) {
			return when srcW <= 0 || srcH <= 0

			// Basic safety: ensure the input buffer can cover the declared dimensions.
			return when srcW > (1024 * 1024 * 1024) / 4

			let rowStride = srcW * 4
			return when rowStride <= 0
			return when srcH > (1024 * 1024 * 1024) / rowStride

			let want = rowStride * srcH
			return when want <= 0 || src.len() < want

			let (
				dst   = self
				dstX0 = x
				dstY0 = y
				srcX0 = 0
				srcY0 = 0
			)

			if dstX0 < 0 {
				srcX0 = -dstX0
				dstX0 = 0
			}
			if dstY0 < 0 {
				srcY0 = -dstY0
				dstY0 = 0
			}

			let blitW = srcW - srcX0
			let blitH = srcH - srcY0
			return when blitW <= 0 || blitH <= 0

			let dstMaxW = dst.width - dstX0
			let dstMaxH = dst.height - dstY0
			return when dstMaxW <= 0 || dstMaxH <= 0

			blitW = dstMaxW when blitW > dstMaxW
			blitH = dstMaxH when blitH > dstMaxH
			return when blitW <= 0 || blitH <= 0

			let rowBytes = blitW * 4
			for let row = 0; row < blitH; row = row + 1 {
				let srcOff = ((srcY0 + row) * srcW + srcX0) * 4
				let dstOff = ((dstY0 + row) * dst.width + dstX0) * 4
				mem.copyN(dst.pixels[dstOff:dstOff + rowBytes], src[srcOff:srcOff + rowBytes], rowBytes)
			}
		}

		def blitCopy(src Canvas, x int, y int) {
			blitCopy(src.pixels, src.width, src.height, x, y)
		}

		def blitCopy(src image.Image, x int, y int) {
			blitCopy(src.raw(), int(src.size().width), int(src.size().height), x, y)
		}

		// blit draws pixels from `src` into this canvas using alpha compositing.
		def blit(src byte[], srcW int, srcH int, x int, y int, mode BlendMode = BlendMode.Normal) {
			return when srcW <= 0 || srcH <= 0

			// Basic safety: ensure the input buffer can cover the declared dimensions.
			return when srcW > (1024 * 1024 * 1024) / 4
			let rowStride = srcW * 4

			return when rowStride <= 0
			return when srcH > (1024 * 1024 * 1024) / rowStride

			let want = rowStride * srcH
			return when want <= 0 || src.len() < want

			let (
				dst   = self
				dstX0 = x
				dstY0 = y
				srcX0 = 0
				srcY0 = 0
			)

			if dstX0 < 0 {
				srcX0 = -dstX0
				dstX0 = 0
			}
			if dstY0 < 0 {
				srcY0 = -dstY0
				dstY0 = 0
			}

			let (
				blitW = srcW - srcX0
				blitH = srcH - srcY0
			)
			return when blitW <= 0 || blitH <= 0

			let (
				dstMaxW = dst.width - dstX0
				dstMaxH = dst.height - dstY0
			)
			return when dstMaxW <= 0 || dstMaxH <= 0

			blitW = dstMaxW when blitW > dstMaxW
			blitH = dstMaxH when blitH > dstMaxH
			return when blitW <= 0 || blitH <= 0

			let rowBytes = blitW * 4
			for let row = 0; row < blitH; row = row + 1 {
				let (
					srcOff = ((srcY0 + row) * srcW + srcX0) * 4
					dstOff = ((dstY0 + row) * dst.width + dstX0) * 4
				)

				for let i = 0; i < rowBytes; i = i + 4 {
					let sa = int(src[srcOff + i + 3])
					continue when sa <= 0

					let (
						sr = int(src[srcOff + i + 0])
						sg = int(src[srcOff + i + 1])
						sb = int(src[srcOff + i + 2])
					)

					if mode == BlendMode.Normal && sa >= 255 {
						dst.pixels[dstOff + i + 0] = byte(sr)
						dst.pixels[dstOff + i + 1] = byte(sg)
						dst.pixels[dstOff + i + 2] = byte(sb)
						dst.pixels[dstOff + i + 3] = 255
						continue
					}

					let (
						dstPx = RGBA{
							r: dst.pixels[dstOff + i + 0],
							g: dst.pixels[dstOff + i + 1],
							b: dst.pixels[dstOff + i + 2],
							a: dst.pixels[dstOff + i + 3],
						}
						srcPx = RGBA{r: byte(sr), g: byte(sg), b: byte(sb), a: byte(sa)}
						out   = blendRGBA(dstPx, srcPx, mode)
					)

					dst.pixels[dstOff + i + 0] = out.r
					dst.pixels[dstOff + i + 1] = out.g
					dst.pixels[dstOff + i + 2] = out.b
					dst.pixels[dstOff + i + 3] = out.a
				}
			}
		}

		def blit(src Canvas, x int, y int, mode BlendMode = BlendMode.Normal) {
			blit(src.pixels, src.width, src.height, x, y, mode)
		}

		def blit(src image.Image, x int, y int, mode BlendMode = BlendMode.Normal) {
			blit(src.raw(), int(src.size().width), int(src.size().height), x, y, mode)
		}

		// blitRGBAtoBGRA copies pixels from `src` (RGBA8) into this canvas,
		// swapping the R and B channels.
		def blitRGBAtoBGRA(src byte[], srcW int, srcH int, x int, y int) {
			return when srcW <= 0 || srcH <= 0

			// Same safety checks as blit().
			return when srcW > (1024 * 1024 * 1024) / 4
			let rowStride = srcW * 4
			return when rowStride <= 0
			return when srcH > (1024 * 1024 * 1024) / rowStride
			let want = rowStride * srcH
			return when want <= 0 || src.len() < want

			let dst = self
			let dstX0 = x
			let dstY0 = y
			let srcX0 = 0
			let srcY0 = 0

			if dstX0 < 0 {
				srcX0 = -dstX0
				dstX0 = 0
			}
			if dstY0 < 0 {
				srcY0 = -dstY0
				dstY0 = 0
			}

			let blitW = srcW - srcX0
			let blitH = srcH - srcY0
			return when blitW <= 0 || blitH <= 0

			let dstMaxW = dst.width - dstX0
			let dstMaxH = dst.height - dstY0
			return when dstMaxW <= 0 || dstMaxH <= 0

			blitW = dstMaxW when blitW > dstMaxW
			blitH = dstMaxH when blitH > dstMaxH
			return when blitW <= 0 || blitH <= 0

			let idx = simd.loadBytes16(__rgba_to_bgra_swizzle, 0)
			let rowBytes = blitW * 4

			for let row = 0; row < blitH; row = row + 1 {
				let srcOff = ((srcY0 + row) * srcW + srcX0) * 4
				let dstOff = ((dstY0 + row) * dst.width + dstX0) * 4

				// SIMD: 16 bytes per chunk (4 pixels).
				let n = (rowBytes / 16) * 16
				for let i = 0; i < n; i = i + 16 {
					let v = simd.loadBytes16(src, srcOff + i)
					let out = simd.shuffle(v, idx)
					simd.storeBytes16(dst.pixels, dstOff + i, out)
				}

				// Tail.
				for let i = n; i < rowBytes; i = i + 4 {
					let r = src[srcOff + i + 0]
					let g = src[srcOff + i + 1]
					let b = src[srcOff + i + 2]
					let a = src[srcOff + i + 3]
					dst.pixels[dstOff + i + 0] = b
					dst.pixels[dstOff + i + 1] = g
					dst.pixels[dstOff + i + 2] = r
					dst.pixels[dstOff + i + 3] = a
				}
			}
		}
	}

	// DrawContext records renderer-agnostic draw commands.
	// Renderer backends interpret the command list to produce output.
	type DrawContext {
		internal cmds     render.DrawCommand[]
		internal viewport Size

		def new(size Size = new Size(0, 0)) {
			viewport = size
			cmds = render.DrawCommand[]
			frameDelta = 0s
			frameTime = new time.Time()
		}

		def reset() {
			cmds.len(0)
		}

		def resetWithSize(size Size) {
			viewport = size
			cmds.len(0)
		}

		def size() Size {
			return viewport
		}

		def commands() render.DrawCommand[] {
			return cmds
		}

		frameDelta duration {
			def get() duration {
				return value
			}

			internal def set(val duration) {
				value = val
			}
		}

		frameTime time.Time {
			def get() time.Time {
				return value
			}

			internal def set(val time.Time) {
				value = val
			}
		}

		def setFrameTiming(delta duration, now time.Time) {
			frameDelta = delta
			frameTime = now
		}

		def clear(c Color) {
			cmds += render.DrawCommand{kind: render.CommandKind.Clear, color: c}
		}

		def fillRect(rect Rect, c Color) {
			cmds += render.DrawCommand{kind: render.CommandKind.FillRect, rect: rect, color: c}
		}

		def strokeRect(rect Rect, c Color, width float = 1.0) {
			cmds += render.DrawCommand{kind: render.CommandKind.StrokeRect, rect: rect, color: c, strokeWidth: width}
		}

		def line(a Point, b Point, c Color, width float = 1.0) {
			cmds += render.DrawCommand{kind: render.CommandKind.Line, p0: a, p1: b, color: c, strokeWidth: width}
		}

		def polyline(points Point[], c Color, width float = 1.0) {
			cmds += render.DrawCommand{kind: render.CommandKind.Polyline, points: points, color: c, strokeWidth: width}
		}

		def polygon(points Point[], c Color) {
			cmds += render.DrawCommand{kind: render.CommandKind.Polygon, points: points, color: c}
		}

		def fillCircle(center Point, radius float, c Color) {
			cmds += render.DrawCommand{kind: render.CommandKind.FillCircle, center: center, radius: radius, color: c}
		}

		def strokeCircle(center Point, radius float, c Color, width float = 1.0) {
			cmds += render.DrawCommand{kind: render.CommandKind.StrokeCircle, center: center, radius: radius, color: c, strokeWidth: width}
		}

		def fillEllipse(center Point, rx float, ry float, c Color) {
			cmds += render.DrawCommand{kind: render.CommandKind.FillEllipse, center: center, rx: rx, ry: ry, color: c}
		}

		def strokeEllipse(center Point, rx float, ry float, c Color, width float = 1.0) {
			cmds += render.DrawCommand{kind: render.CommandKind.StrokeEllipse, center: center, rx: rx, ry: ry, color: c, strokeWidth: width}
		}

		def fillTriangle(a Point, b Point, c0 Point, c Color) {
			cmds += render.DrawCommand{kind: render.CommandKind.FillTriangle, p0: a, p1: b, p2: c0, color: c}
		}

		def strokeTriangle(a Point, b Point, c0 Point, c Color, width float = 1.0) {
			cmds += render.DrawCommand{kind: render.CommandKind.StrokeTriangle, p0: a, p1: b, p2: c0, color: c, strokeWidth: width}
		}

		def blitCopy(src byte[], srcW int, srcH int, x int, y int) {
			cmds += render.DrawCommand{
				kind: render.CommandKind.BlitCopy,
				src:  src,
				srcW: srcW,
				srcH: srcH,
				x:    x,
				y:    y,
			}
		}

		def blitCopy(src Canvas, x int, y int) {
			blitCopy(src.pixels, src.width, src.height, x, y)
		}

		def blitCopy(src image.Image, x int, y int) {
			blitCopy(src.raw(), int(src.size().width), int(src.size().height), x, y)
		}

		def blit(src byte[], srcW int, srcH int, x int, y int, mode BlendMode = BlendMode.Normal) {
			cmds += render.DrawCommand{
				kind: render.CommandKind.Blit,
				src:  src,
				srcW: srcW,
				srcH: srcH,
				x:    x,
				y:    y,
				mode: mode,
			}
		}

		def blit(src Canvas, x int, y int, mode BlendMode = BlendMode.Normal) {
			blit(src.pixels, src.width, src.height, x, y, mode)
		}

		def blit(src image.Image, x int, y int, mode BlendMode = BlendMode.Normal) {
			blit(src.raw(), int(src.size().width), int(src.size().height), x, y, mode)
		}

		def blitRGBAtoBGRA(src byte[], srcW int, srcH int, x int, y int) {
			cmds += render.DrawCommand{
				kind: render.CommandKind.BlitRGBAtoBGRA,
				src:  src,
				srcW: srcW,
				srcH: srcH,
				x:    x,
				y:    y,
			}
		}
	}
}
