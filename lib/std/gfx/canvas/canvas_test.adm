partial module std.gfx.canvas {
	use (
		std.testing
		std.gfx.color::(Color, BlendMode, RGBA)
		std.math.geom::(Rect)
	)

	// A fixed noise buffer (with fully transparent and opaque pixels mixed
	// in), and the FNV-1a hash of a canvas's bytes: the blending paths are
	// pinned to the output they gave when they were checked byte for byte
	// against the per-pixel code they replaced.
	internal def canvasNoise(n int, seed int) byte[] {
		let px byte[]
		px.len(n)
		let s = uint32(seed)
		for let i = 0; i < n; i++ {
			s = s * uint32(1664525) + uint32(1013904223)
			px[i] = byte(s >> 24)
		}
		for let i = 3; i < n; i += 20 {
			px[i] = byte(0)
		}
		for let i = 11; i < n; i += 28 {
			px[i] = byte(255)
		}
		return px
	}

	internal def canvasChecksum(cv Canvas) string {
		let h = uint64(14695981039346656037)
		for let (_, b) in cv.raw() {
			h = (h ^ uint64(b)) * uint64(1099511628211)
		}
		return h.hex()
	}

	internal def noiseCanvas(w int, h int, seed int) Canvas {
		let cv = new Canvas(w, h)
		cv.reshape(canvasNoise(w * h * 4, seed), cv.size(), w * 4)
		return cv
	}

	check "Canvas blending" {
		@test()
		def outputs_stay_pinned() {
			// Large enough for tasks, odd sizes for the vector tails.
			let w = 533
			let h = 301
			let src = canvasNoise((w + 1) * h * 4, 9)
			let want = ["D36A7C611006F81F", "A18E042D8E6A3136", "44A9B277E0BBCFFE", "1B5DDAA104D22D8", "D4A2B07C31CDDF87", "6F59D4E024F86C81"]
			for let k = 0; k < 6; k++ {
				let cv = noiseCanvas(w, h, 7)
				let c = new Color(RGBA{r: byte(200), g: byte(33), b: byte(91), a: byte(77 + k * 30)})
				match k {
					case 0: cv.fillRect(Rect{left: 1.0, top: -2.0, right: float(w + 3), bottom: float(h - 1)}, c)
					case 1:
						for let y = 0; y < h; y += 3 {
							cv.drawSpan(y, w - 1 - y, y / 2 - 5, c)
						}
					case 2: cv.blit(src, w + 1, h, -3, 2)
					case 3: cv.blit(src, w + 1, h, 5, -1, BlendMode.Multiply)
					case 4: cv.blit(src, w + 1, h, 0, 0, BlendMode.Luminosity)
					case 5: cv.blitRGBAtoBGRA(src, w + 1, h, -1, 3)
				}
				assert canvasChecksum(cv) == want[k]
			}
		}

		@test()
		def opaque_fills_cover_exactly_their_rows() {
			// Large enough for bands on tasks; full-width and part-width rects.
			let w = 600
			let h = 500
			let c = new Color(RGBA{r: byte(9), g: byte(8), b: byte(7), a: byte(255)})
			for let (_, x0) in [0, 3] {
				let cv = noiseCanvas(w, h, 2)
				let before = cv.raw().clone()
				let x1 = x0 == 0 ?? (w, w - 5)
				cv.fillRect(Rect{left: float(x0), top: 10.0, right: float(x1), bottom: float(h - 20)}, c)
				let px = cv.raw()
				for let y = 0; y < h; y++ {
					for let x = 0; x < w; x++ {
						let o = (y * w + x) * 4
						let inside = x >= x0 && x < x1 && y >= 10 && y < h - 20
						assert inside ?? (px[o] == 9 && px[o + 3] == 255, px[o] == before[o] && px[o + 3] == before[o + 3])
					}
				}
			}
			let cv = noiseCanvas(w, h, 3)
			cv.clear(new Color(RGBA{r: byte(1), g: byte(2), b: byte(3), a: byte(4)}))
			let px = cv.raw()
			for let i = 0; i < px.len(); i += 4 {
				assert px[i] == 1 && px[i + 1] == 2 && px[i + 2] == 3 && px[i + 3] == 4
			}
		}

		@test()
		def blend_one_pixel() {
			let cv = new Canvas(2, 1)
			cv.clear(new Color(RGBA{r: byte(0), g: byte(0), b: byte(255), a: byte(255)}))
			cv.setPixel(0, 0, new Color(RGBA{r: byte(255), g: byte(0), b: byte(0), a: byte(128)}))
			let px = cv.raw()
			assert px[0] == 128 && px[1] == 0 && px[2] == 127 && px[3] == 255
			assert px[4] == 0 && px[6] == 255
			// Outside the canvas: ignored.
			cv.setPixel(2, 0, new Color(RGBA{r: byte(1), g: byte(1), b: byte(1), a: byte(255)}))
		}
	}
}
