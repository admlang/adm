partial module std.gfx.canvas {
	use (
		std.testing
		std.formats.fonts
		std.gfx.color::(Color)
		std.math.geom::(Point)
		std.units::(Pixels)
	)

	check "Colour glyphs" {
		// Draws `text` in `font` at 64 pixels with its baseline at (10, 80) on
		// a white 100x100 canvas, in black.
		def drawn(font string, text string) !Canvas {
			let face = try (try fonts.load("samples/fonts/ttf/color/" + font)).face(0)
			let cv = new Canvas(100, 100)
			cv.clear(new Color("#fff"))
			cv.fillText(text, new Point(10.0, 80.0), TextStyle{face: face, size: 64(px)}, new Color("#000"))
			return cv
		}

		// The pixel at (x, y) as RGB.
		def at(cv Canvas, x int, y int) (int, int, int) {
			let i = (y * cv.width + x) * 4
			return (int(cv.pixels[i]), int(cv.pixels[i + 1]), int(cv.pixels[i + 2]))
		}

		@test()
		def drawsColourTextOnACanvas() !none {
			let gradient = try drawn("test_glyphs-glyf_colr_1.ttf", string(char(0xF0100)))
			let (lr, _, lb) = at(gradient, 20, 50)
			let (rr, _, rb) = at(gradient, 62, 50)
			assert lr > 200 && lb < 60 // the linear gradient starts red
			assert rb > rr // and turns blue
			let (wr, wg, wb) = at(gradient, 95, 50)
			assert wr == 255 && wg == 255 && wb == 255 // nothing past the glyph
			let bitmap = try drawn("chromacheck-cbdt.ttf", "\uE903")
			let (br, bg, bb) = at(bitmap, 42, 48)
			assert br > 64 && bg < 32 && bb < 32 // the CBDT image, not the black outline
		}
	}
}
