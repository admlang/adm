// Whether two recorded calls draw the same, for telling which part of a frame changed
// since the frame before (`DrawContext.sameCalls`).
partial module std.gfx.canvas {
	use (
		std.gfx.color::Color
		std.gfx.render as render
		std.math.geom::(Edges, Path, PathVerb, Point, Rect, StrokeStyle, Transform2D)
		std.units::(FontRelative, Pixels)
	)

	// Whether two numbers of two recordings are the same: within a billionth of their size,
	// the noise of positions taken as differences of other ones.
	internal def near(a float, b float) bool {
		return a == b || (a - b).abs() <= 1e-9 * (1.0 + a.abs() + b.abs())
	}

	// Whether two recorded calls draw the same. Values are compared as values: a colour,
	// a gradient, a path or a style made anew with the same values is the same, as a UI
	// frame makes most of them. One object recorded in both is the same (a raster, a
	// video frame, a mask, a path kept from frame to frame): what changes one in place
	// asks for its drawing to count as changed (`Component.redraw()` in std.ui), except a
	// live raster, whose drawing changed when it was marked since (`LiveRaster.mark`). A blit's
	// bytes are never the same. Numbers are the same within a billionth (`near`). A
	// text's transform, recorded whole, is the same moved by (`dx`, `dy`) device pixels:
	// text of what moved by that much.
	internal def sameOp(a DrawOp, b DrawOp, dx float = 0.0, dy float = 0.0) bool {
		match a {
			case SaveOp:
				return b is SaveOp
			case RestoreOp:
				return b is RestoreOp
			case EndGroupOp:
				return b is EndGroupOp
			case SetStateOp:
				return b is SetStateOp && sameState(a.state, b.state)
			case TransformOp:
				// A transform that replaces the settings is in device pixels: moved by
				// that much, it stands where what moved stands.
				return b is TransformOp && a.replace == b.replace && (a.replace ?? (sameMoved(a.t, b.t, dx, dy), sameTransform(a.t, b.t)))
			case ClipPathOp:
				return b is ClipPathOp && a.rule == b.rule && a.antialias == b.antialias && samePath(a.path, b.path)
			case ClipRectOp:
				return b is ClipRectOp && sameRect(a.rect, b.rect)
			case ClipMaskOp:
				return b is ClipMaskOp && a.mask == b.mask
			case AlphaOp:
				return b is AlphaOp && a.alpha == b.alpha
			case CompositeOp:
				return b is CompositeOp && a.op == b.op
			case BlendOp:
				return b is BlendOp && a.mode == b.mode
			case AntialiasOp:
				return b is AntialiasOp && a.on == b.on
			case SamplingOp:
				return b is SamplingOp && a.sampling == b.sampling
			case TagOp:
				return b is TagOp && a.id == b.id
			case FillOp:
				return b is FillOp && a.rule == b.rule && samePaint(a.paint, b.paint) && samePath(a.path, b.path)
			case TextOp:
				return b is TextOp && a.text == b.text && samePoint(a.at, b.at) && sameMoved(a.under, b.under, dx, dy) && samePaint(a.paint, b.paint) && sameTextStyle(a.textStyle, b.textStyle)
			case FillRectOp:
				return b is FillRectOp && sameRect(a.rect, b.rect) && samePaint(a.paint, b.paint)
			case StrokeOp:
				return b is StrokeOp && samePaint(a.paint, b.paint) && sameStroke(a.strokeStyle, b.strokeStyle) && samePath(a.path, b.path)
			case ImageAtOp:
				return b is ImageAtOp && a.src == b.src && a.marked == b.marked && samePoint(a.at, b.at)
			case ImageOp:
				return b is ImageOp && a.src == b.src && a.marked == b.marked && a.sampling == b.sampling && sameRect(a.source, b.source) && sameRect(a.dest, b.dest)
			case WarpOp:
				return b is WarpOp && a.src == b.src && a.marked == b.marked && a.sampling == b.sampling && sameMesh(a.mesh, b.mesh)
			case AtlasOp:
				return b is AtlasOp && a.src == b.src && a.marked == b.marked && sameAtlas(a, b)
			case NineSliceOp:
				return b is NineSliceOp && a.src == b.src && a.marked == b.marked && sameRect(a.dest, b.dest) && sameInsets(a.insets, b.insets)
			case VideoOp:
				return b is VideoOp && a.frame == b.frame && a.fit == b.fit && sameRect(a.rect, b.rect)
			case BeginGroupOp:
				return b is BeginGroupOp && sameGroup(a, b)
			case render.DrawCommand:
				return b is render.DrawCommand && sameCommand(a, b)
		}
		return false
	}

	internal def samePoint(a Point, b Point) bool {
		return near(a.x, b.x) && near(a.y, b.y)
	}

	internal def sameRect(a Rect, b Rect) bool {
		return near(a.left, b.left) && near(a.top, b.top) && near(a.right, b.right) && near(a.bottom, b.bottom)
	}

	internal def sameTransform(a Transform2D, b Transform2D) bool {
		return sameMoved(a, b, 0.0, 0.0)
	}

	// Whether `a` is `b` followed by a move of (`dx`, `dy`).
	internal def sameMoved(a Transform2D, b Transform2D, dx float, dy float) bool {
		return near(a.a, b.a) && near(a.b, b.b) && near(a.c, b.c) && near(a.d, b.d) && near(a.tx, b.tx + dx) && near(a.ty, b.ty + dy)
	}

	internal def sameInsets(a Edges<Pixels>, b Edges<Pixels>) bool {
		return float(a.top) == float(b.top) && float(a.right) == float(b.right) && float(a.bottom) == float(b.bottom) && float(a.left) == float(b.left)
	}

	internal def samePath(a Path, b Path) bool {
		return true when a == b
		return false unless a.verbs.equals(b.verbs)
		let (p, q) = (a.coords, b.coords)
		return false unless p.len() == q.len()
		for let (i, v) in p {
			return false unless near(v, q[i])
		}
		return true
	}

	internal def sameState(a DrawState, b DrawState) bool {
		if a.alpha != b.alpha || a.composite != b.composite || a.blend != b.blend || a.antialias != b.antialias || a.sampling != b.sampling {
			return false
		}
		return false unless sameTransform(a.transform, b.transform)
		let (x, y) = (a.clip, b.clip)
		return false unless (x is none) == (y is none)
		return false unless x is none || y is none || x == y
		let (s, t) = (a.tag, b.tag)
		return false unless (s is none) == (t is none)
		return s is none || t is none || s == t
	}

	internal def sameStroke(a StrokeStyle, b StrokeStyle) bool {
		if float(a.width) != float(b.width) || a.cap != b.cap || a.join != b.join || a.miterLimit != b.miterLimit || float(a.dashOffset) != float(b.dashOffset) || a.fixedWidth != b.fixedWidth {
			return false
		}
		return false unless a.dash.len() == b.dash.len()
		for let (i, d) in a.dash {
			return false unless float(d) == float(b.dash[i])
		}
		return true
	}

	internal def sameTextStyle(a TextStyle, b TextStyle) bool {
		if a.face != b.face || a.align != b.align || a.baseline != b.baseline || a.hinting != b.hinting || float(a.rootSize) != float(b.rootSize) || a.script != b.script || a.orientation != b.orientation {
			return false
		}
		return false unless sameSize(a.size, b.size) && sameSize(a.spacing, b.spacing)
		let (x, y) = (a.direction, b.direction)
		return false unless (x is none) == (y is none)
		return false unless x is none || y is none || x == y
		return false unless a.features.len() == b.features.len()
		for let (tag, value) in a.features {
			return false unless b.features.hasKey(tag) && b.features[tag] == value
		}
		return true
	}

	internal def sameSize(a Pixels | FontRelative, b Pixels | FontRelative) bool {
		return (a is Pixels && b is Pixels && float(a) == float(b)) || (a is FontRelative && b is FontRelative && float(a) == float(b))
	}

	internal def samePaint(a Paint, b Paint) bool {
		if a is Color && b is Color {
			return a == b
		}
		if a is LinearGradient && b is LinearGradient {
			return a == b || (samePoint(a.from, b.from) && samePoint(a.to, b.to) && a.spread == b.spread && a.space == b.space && a.premultiplied == b.premultiplied && sameStops(a.stops, b.stops))
		}
		if a is RadialGradient && b is RadialGradient {
			if a == b {
				return true
			}
			let (f, g) = (a.focus, b.focus)
			return false unless (f is none) == (g is none)
			return false unless f is none || g is none || samePoint(f, g)
			return samePoint(a.center, b.center) && a.radius == b.radius && a.focusRadius == b.focusRadius && a.spread == b.spread && a.space == b.space && a.premultiplied == b.premultiplied && sameStops(a.stops, b.stops)
		}
		if a is ConicGradient && b is ConicGradient {
			return a == b || (samePoint(a.center, b.center) && a.angle == b.angle && a.space == b.space && a.premultiplied == b.premultiplied && sameStops(a.stops, b.stops))
		}
		let (x, y) = (a, b)
		return x == y
	}

	internal def sameStops(a ColorStop[], b ColorStop[]) bool {
		return false unless a.len() == b.len()
		for let (i, stop) in a {
			return false unless float(stop.offset) == float(b[i].offset) && stop.color == b[i].color
		}
		return true
	}

	internal def sameMesh(a Point[][], b Point[][]) bool {
		return false unless a.len() == b.len()
		for let (i, row) in a {
			let other = b[i]
			return false unless row.len() == other.len()
			for let (k, p) in row {
				return false unless samePoint(p, other[k])
			}
		}
		return true
	}

	internal def sameAtlas(a AtlasOp, b AtlasOp) bool {
		return false unless a.sources.len() == b.sources.len() && a.transforms.len() == b.transforms.len() && a.colors.len() == b.colors.len()
		for let (i, r) in a.sources {
			return false unless sameRect(r, b.sources[i])
		}
		for let (i, t) in a.transforms {
			return false unless sameTransform(t, b.transforms[i])
		}
		for let (i, c) in a.colors {
			return false unless c == b.colors[i]
		}
		return true
	}

	// Groups with effects compare by the effect objects: a frame that draws one is
	// drawn whole by a renderer that knows effects spread.
	internal def sameGroup(a BeginGroupOp, b BeginGroupOp) bool {
		return false unless a.opacity == b.opacity && a.blend == b.blend && a.effects.len() == b.effects.len()
		for let (i, e) in a.effects {
			let other = b.effects[i]
			return false unless e == other
		}
		let (m, n) = (a.mask, b.mask)
		return false unless (m is none) == (n is none)
		return false unless m is none || n is none || m == n
		let (r, s) = (a.bounds, b.bounds)
		return false unless (r is none) == (s is none)
		return r is none || s is none || sameRect(r, s)
	}

	// A blit is never the same as another: its bytes may have been written in place.
	internal def sameCommand(a render.DrawCommand, b render.DrawCommand) bool {
		if a.kind != b.kind || a.radius != b.radius || a.rx != b.rx || a.ry != b.ry || a.strokeWidth != b.strokeWidth || a.srcW != b.srcW || a.srcH != b.srcH || a.x != b.x || a.y != b.y || a.mode != b.mode || a.fit != b.fit {
			return false
		}
		return false unless a.src.len() == 0 && b.src.len() == 0 && a.color == b.color
		return false unless sameRect(a.rect, b.rect) && samePoint(a.center, b.center) && samePoint(a.p0, b.p0) && samePoint(a.p1, b.p1) && samePoint(a.p2, b.p2)
		let (v, w) = (a.video, b.video)
		return false unless (v is none) == (w is none)
		return false unless v is none || w is none || v == w
		return false unless a.points.len() == b.points.len()
		for let (i, p) in a.points {
			return false unless samePoint(p, b.points[i])
		}
		return true
	}

	// The settings a walk of a recording has reached: the transform, the clip's box in
	// device pixels (none: no clip) and whether every clip is a rectangle along the axes,
	// the operator, the opacity and how many groups are open.
	internal struct WalkState {
		t         Transform2D
		clip      ?Rect
		exact     bool
		composite Composite
		alpha     float
		groups    int
	}

	internal def copyWalk(st WalkState) WalkState {
		return WalkState{t: copyTransform(st.t), clip: st.clip, exact: st.exact, composite: st.composite, alpha: st.alpha, groups: st.groups}
	}

	// Takes one call into the settings; true when it changes them (a call that draws
	// leaves them as they are).
	internal def walkOp(st WalkState, saved WalkState[], op DrawOp) bool {
		match op {
			case SaveOp:
				saved.push(copyWalk(st))
			case RestoreOp:
				if saved.len() > 0 {
					let back = saved.pop()
					st.t = back.t
					st.clip = back.clip
					st.exact = back.exact
					st.composite = back.composite
					st.alpha = back.alpha
					st.groups = back.groups
				}
			case SetStateOp:
				st.t = copyTransform(op.state.transform)
				st.clip = none
				st.exact = true
				st.composite = op.state.composite
				st.alpha = op.state.alpha
			case TransformOp:
				st.t = op.replace ?? (copyTransform(op.t), st.t.then(op.t))
			case ClipRectOp:
				let box = rectUnder(op.rect, st.t)
				st.exact = st.exact && st.t.b == 0.0 && st.t.c == 0.0
				st.clip = clipMeet(st.clip, box)
			case ClipPathOp:
				st.exact = false
				st.clip = clipMeet(st.clip, op.path.transformed(st.t).bounds())
			case ClipMaskOp:
				st.exact = false
			case CompositeOp:
				st.composite = op.op
			case AlphaOp:
				st.alpha = op.alpha
			case BeginGroupOp:
				saved.push(copyWalk(st))
				st.groups = st.groups + 1
			case EndGroupOp:
				if saved.len() > 0 {
					let back = saved.pop()
					st.t = back.t
					st.clip = back.clip
					st.exact = back.exact
					st.composite = back.composite
					st.alpha = back.alpha
					st.groups = back.groups
				}
			default:
				return false
		}
		return true
	}

	// The overlap of a clip box and another box; an empty box when they miss.
	internal def clipMeet(clip ?Rect, box Rect) Rect {
		let met = meet(clip, box)
		return met is none ?? (Rect{left: 0.0, top: 0.0, right: 0.0, bottom: 0.0}, met)
	}

	// The settings before the call at `place`.
	internal def walkTo(ops DrawOp[], place int) WalkState {
		let st = WalkState{t: new Transform2D(), clip: none, exact: true, composite: Composite.SourceOver, alpha: 1.0, groups: 0}
		let saved WalkState[]
		for let i = 0; i < place && i < ops.len(); i++ {
			let _ = walkOp(st, saved, ops[i])
		}
		return st
	}

	// See `DrawContext.paintsEvenly`. Each call's box is measured as `inkBoxes` measures
	// it.
	internal def evenUnder(ops DrawOp[], end int, area Rect) bool {
		let st = WalkState{t: new Transform2D(), clip: none, exact: true, composite: Composite.SourceOver, alpha: 1.0, groups: 0}
		let saved WalkState[]
		let painted = false
		for let i = 0; i < end && i < ops.len(); i++ {
			let op = ops[i]
			continue when walkOp(st, saved, op)
			let box ?Rect = none
			let covers = false
			match op {
				case render.DrawCommand:
					if op.kind == render.CommandKind.Clear {
						covers = st.groups == 0
						box = st.clip
						box = area when box is none
					} else {
						box = commandBox(op, InkState{t: st.t, clip: st.clip, unbounded: false}, none)
						covers = op.kind == render.CommandKind.FillRect && st.groups == 0 && op.color.alpha == 255 && contains(op.rect, area)
					}
				case FillRectOp:
					box = rectUnder(op.rect, st.t)
					covers = st.groups == 0 && op.paint is Color && st.t.b == 0.0 && st.t.c == 0.0 && contains(rectUnder(op.rect, st.t), area)
				case FillOp:
					box = rectUnder(pointsBox(op.path), st.t)
					let inside = evenInside(op.path.transformed(st.t))
					covers = st.groups == 0 && op.paint is Color && st.t.b == 0.0 && st.t.c == 0.0 && !(inside is none) && contains(inside, area)
				case StrokeOp:
					box = op.path.coords.len() >= 2 ?? (strokeReach(op.path, op.strokeStyle, st.t), Rect{left: 0.0, top: 0.0, right: 0.0, bottom: 0.0})
				case TextOp:
					let known = op.box
					box = known is Rect ?? (widened(rectUnder(known, st.t), 1.0), rectUnder(inkBox(op), st.t))
				case ImageOp:
					box = rectUnder(op.dest, st.t)
				case NineSliceOp:
					box = rectUnder(op.dest, st.t)
				case VideoOp:
					box = rectUnder(op.rect, st.t)
				default:
					// What has no box here may reach anywhere the clip lets it.
					box = st.clip
					box = area when box is none
			}
			let reach = box
			if reach is Rect {
				let cut = st.clip
				let seen = cut is none ?? (reach, clipMeet(cut, reach))
				continue unless overlaps(seen, area)
			}
			// What reaches the area paints it evenly only when it covers it with one colour
			// under a plain operator, and the clip leaves all of it.
			return false unless covers && (st.composite := Composite.SourceOver || Composite.Copy)
			let cut = st.clip
			return false unless cut is none || contains(cut, area)
			painted = true
		}
		return painted
	}

	internal def overlaps(a Rect, b Rect) bool {
		return a.left < b.right && b.left < a.right && a.top < b.bottom && b.top < a.bottom
	}

	internal def contains(outer Rect, inner Rect) bool {
		return outer.left <= inner.left && outer.top <= inner.top && outer.right >= inner.right && outer.bottom >= inner.bottom
	}

	// The part of a path's box it surely fills: all of it for a rectangle along the axes;
	// for a rounded rectangle (lines, and a curve at each corner that stays in its
	// corner) the box less the deepest corner on each side; none for any other path.
	internal def evenInside(path Path) ?Rect {
		let (verbs, at) = (path.verbs, path.coords)
		return none when verbs.len() == 0 || at.len() < 2
		let box = pointsBox(path)
		let (inLeft, inTop, inRight, inBottom) = (box.left, box.top, box.right, box.bottom)
		let (px, py) = (at[0], at[1])
		let k = 0
		let moves = 0
		for let verb in verbs {
			match verb {
				case PathVerb.Move:
					moves++
					return none when moves > 1
					(px, py) = (at[k], at[k + 1])
					k += 2
				case PathVerb.Line:
					let (x, y) = (at[k], at[k + 1])
					// Lines run along the box's edges.
					return none unless (near(x, px) && (near(x, box.left) || near(x, box.right))) || (near(y, py) && (near(y, box.top) || near(y, box.bottom)))
					(px, py) = (x, y)
					k += 2
				case PathVerb.Cubic:
					let (x, y) = (at[k + 4], at[k + 5])
					let (left, right) = (px.min(x).min(at[k]).min(at[k + 2]), px.max(x).max(at[k]).max(at[k + 2]))
					let (top, bottom) = (py.min(y).min(at[k + 1]).min(at[k + 3]), py.max(y).max(at[k + 1]).max(at[k + 3]))
					// A corner: from one edge of the box to the next, inside that corner.
					let atLeft = near(left, box.left)
					let atTop = near(top, box.top)
					let atRight = near(right, box.right)
					let atBottom = near(bottom, box.bottom)
					return none unless (atLeft || atRight) && (atTop || atBottom) && !(atLeft && atRight) && !(atTop && atBottom)
					inLeft = inLeft.max(right) when atLeft
					inRight = inRight.min(left) when atRight
					inTop = inTop.max(bottom) when atTop
					inBottom = inBottom.min(top) when atBottom
					(px, py) = (x, y)
					k += 6
				case PathVerb.Close:
				default:
					return none
			}
		}
		return none when inLeft >= inRight || inTop >= inBottom
		return Rect{left: inLeft, top: inTop, right: inRight, bottom: inBottom}
	}
}
