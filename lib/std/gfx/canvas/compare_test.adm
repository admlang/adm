partial module std.gfx.canvas {
	use (
		std.testing
		std.gfx.color::(Color, RGBA)
		std.math.geom::(Circle, Path, Point, Rect, Size, StrokeStyle)
		std.units::Pixels
	)

	check "Comparing recordings" {
		def rgba(r int, g int, b int, a int = 255) Color {
			return new Color(RGBA{r: byte(r), g: byte(g), b: byte(b), a: byte(a)})
		}

		// What a UI frame records again: a path and a colour made anew with the same
		// values, a gradient, a stroke, a transform.
		def scene(ctx DrawContext, shade int, path Path) {
			ctx.save()
			ctx.translate(4.0, 6.0)
			ctx.fill(new Path().moveTo(0.0, 0.0).lineTo(10.0, 0.0).cubicTo(12.0, 4.0, 12.0, 8.0, 10.0, 10.0).close(), rgba(shade, 20, 30))
			ctx.fill(Rect{left: 20.0, top: 0.0, right: 30.0, bottom: 10.0}, linear(new Point(20.0, 0.0), new Point(30.0, 0.0), [rgba(0, 0, 0), rgba(255, 255, 255)]))
			ctx.stroke(path, rgba(0, 0, 200), StrokeStyle{width: 2(px)})
			ctx.restore()
		}

		// Calls made anew with the same values compare the same, call by call; a changed
		// colour does not, nor a path of other points, while one path object recorded
		// in both does.
		@test()
		def sameValuesCompareTheSame() {
			let kept = new Path().moveTo(0.0, 20.0).lineTo(30.0, 20.0)
			let (a, b, c, d) = (new DrawContext(new Size(64.0, 64.0)), new DrawContext(new Size(64.0, 64.0)), new DrawContext(new Size(64.0, 64.0)), new DrawContext(new Size(64.0, 64.0)))
			scene(a, 100, kept)
			scene(b, 100, kept)
			scene(c, 101, kept)
			scene(d, 100, new Path().moveTo(0.0, 20.0).lineTo(31.0, 20.0))
			assert a.count() == b.count() && a.count() == c.count()
			assert a.sameCalls(0, a.count(), b, 0)
			assert !a.sameCalls(0, a.count(), c, 0)
			// Only the fill's colour differs: the calls around it still compare the same.
			assert a.sameCalls(0, 2, c, 0) && a.sameCalls(3, a.count(), c, 3)
			assert !a.sameCalls(0, a.count(), d, 0)
			// Past the end of the other recording nothing compares the same.
			assert !a.sameCalls(0, a.count(), b, 1)
		}

		// A replay that leaves spans out draws what the rest of the recording draws, under
		// the settings each call was recorded under.
		@test()
		def replayLeavesSpansOut() {
			let ctx = new DrawContext(new Size(40.0, 20.0))
			ctx.fill(Rect{left: 0.0, top: 0.0, right: 10.0, bottom: 20.0}, rgba(200, 0, 0))
			let from = ctx.count()
			ctx.save()
			ctx.translate(10.0, 0.0)
			ctx.fill(Rect{left: 0.0, top: 0.0, right: 10.0, bottom: 20.0}, rgba(0, 200, 0))
			ctx.restore()
			let to = ctx.count()
			ctx.fill(Rect{left: 20.0, top: 0.0, right: 30.0, bottom: 20.0}, rgba(0, 0, 200))
			let left = new Canvas(40, 20)
			ctx.replay(left, [from], [to])
			let direct = new Canvas(40, 20)
			direct.fill(Rect{left: 0.0, top: 0.0, right: 10.0, bottom: 20.0}, rgba(200, 0, 0))
			direct.fill(Rect{left: 20.0, top: 0.0, right: 30.0, bottom: 20.0}, rgba(0, 0, 200))
			assert canvasChecksum(left) == canvasChecksum(direct)
			// Into another recording the same calls are kept.
			let copy = new DrawContext(new Size(40.0, 20.0))
			ctx.replay(copy, [from], [to])
			assert copy.count() == ctx.count() - (to - from)
		}

		// What a place of a recording is drawn under: its transform, its clip when every
		// clip is a rectangle along the axes; how far a placing call moved against another
		// recording's; which calls only draw; whether what comes before a place paints an
		// area in one colour.
		@test()
		def placesAndEvenAreas() {
			let ctx = new DrawContext(new Size(100.0, 80.0))
			ctx.clear(rgba(250, 250, 250))
			ctx.scale(2.0, 2.0)
			ctx.fill(new Path().roundRect(Rect{left: 0.0, top: 0.0, right: 50.0, bottom: 40.0}, 4(px)), rgba(240, 240, 240))
			ctx.save()
			ctx.clip(Rect{left: 5.0, top: 5.0, right: 45.0, bottom: 35.0})
			let placed = ctx.count()
			ctx.translate(5.0, -10.0)
			ctx.fill(Rect{left: 0.0, top: 0.0, right: 20.0, bottom: 20.0}, rgba(10, 20, 30))
			ctx.restore()
			let t = ctx.transformAt(placed)
			assert t.a == 2.0 && t.d == 2.0 && t.tx == 0.0
			let clip = ctx.clipAt(placed)
			assert !(clip is none)
			if clip is Rect {
				assert clip.left == 10.0 && clip.top == 10.0 && clip.right == 90.0 && clip.bottom == 70.0
			}
			assert !(ctx.clipAt(0) is none)
			// Inside the rounded corners the fill paints evenly, over a corner it does not.
			assert ctx.paintsEvenly(placed, Rect{left: 10.0, top: 10.0, right: 90.0, bottom: 70.0})
			assert !ctx.paintsEvenly(placed, Rect{left: 0.0, top: 0.0, right: 6.0, bottom: 6.0})
			// The square drawn after it is not under the place.
			assert !ctx.paintsEvenly(ctx.count(), Rect{left: 10.0, top: 10.0, right: 90.0, bottom: 70.0})
			let other = new DrawContext(new Size(100.0, 80.0))
			other.translate(5.0, -4.0)
			let by = ctx.movedBy(placed, other, 0)
			assert !(by is none)
			if by is Point {
				assert by.x == 0.0 && by.y == -6.0
			}
			assert ctx.drawsOnly(placed + 1, placed + 2) && !ctx.drawsOnly(placed, placed + 1)
			// A path clip is no rectangle.
			let curved = new DrawContext(new Size(100.0, 80.0))
			curved.clip(new Path().circle(new Point(50.0, 40.0), 20.0))
			assert curved.clipAt(curved.count()) is none
		}
	}
}
