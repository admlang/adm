partial module std.gfx.canvas {
	use (
		std.gfx.color::(BlendMode, Color, RGBA)
		std.math.geom::Vec2
		std.units::Pixels
	)

	// Effect post-processes a group before it is composited. Shadows and
	// glows follow CSS and Photoshop layer styles: they are drawn from the
	// group's shape, below it (DropShadow, OuterGlow) or inside it
	// (InnerShadow, InnerGlow); the others change the group's pixels, in
	// the order given. Lengths are in user space and scale with the
	// transform in effect at `beginGroup`.
	type Effect = DropShadow | InnerShadow | OuterGlow | InnerGlow | Blur | Outline | ColorAdjust | ColorMatrix

	// DropShadow is the shape's shadow below it.
	struct DropShadow {
		offset   Vec2   = new Vec2(4.0, 4.0) // in px
		// Blur radius as CSS box-shadow: a Gaussian of half this deviation.
		blur     Pixels = 8(px)
		// Grows the shape before blurring.
		spread   Pixels = 0(px)
		color    Color  = new Color(RGBA{r: 0, g: 0, b: 0, a: 128})
		// Only the shadow, knocked out where the shape is (CSS box-shadow on
		// a transparent box).
		knockout bool   = false
	}

	// InnerShadow is a shadow cast inside the shape by its edges.
	struct InnerShadow {
		offset Vec2   = new Vec2(2.0, 2.0) // in px
		blur   Pixels = 4(px)
		// Grows the shadow into the shape before blurring.
		choke  Pixels = 0(px)
		color  Color  = new Color(RGBA{r: 0, g: 0, b: 0, a: 160})
	}

	// OuterGlow is light around the shape, below it.
	struct OuterGlow {
		blur   Pixels    = 10(px)
		spread Pixels    = 0(px)
		color  Color     = new Color(RGBA{r: 255, g: 255, b: 200, a: 200})
		blend  BlendMode = BlendMode.Screen
	}

	// InnerGlow is light inside the shape's edges.
	struct InnerGlow {
		blur  Pixels    = 6(px)
		color Color     = new Color(RGBA{r: 255, g: 255, b: 255, a: 180})
		blend BlendMode = BlendMode.Screen
	}

	// Blur blurs the group (a Gaussian of deviation `radius`, as CSS
	// `blur()`), in linear light.
	struct Blur {
		radius   Pixels = 4(px)
		// Blur what is behind the group instead of the group (frosted glass,
		// CSS backdrop-filter), wherever the group paints at all.
		backdrop bool   = false
	}

	// OutlinePosition is where an Outline sits against the shape's edge.
	enum OutlinePosition {
		Outside,
		Center,
		Inside,
	}

	// Outline strokes around the group's alpha (Photoshop Stroke style,
	// sticker outlines).
	struct Outline {
		width    Pixels          = 2(px)
		paint    Paint           = new Color(RGBA{r: 0, g: 0, b: 0, a: 255})
		position OutlinePosition = OutlinePosition.Outside
	}

	// ColorAdjust shifts the group's colours, each 0 for no change:
	// brightness and contrast -1 to 1, saturation -1 (grey) to 1, hue in
	// degrees. Applied in sRGB, as CSS filters are.
	struct ColorAdjust {
		brightness float = 0.0
		contrast   float = 0.0
		saturation float = 0.0
		hue        float = 0.0
	}

	// ColorMatrix maps each pixel's straight sRGB r, g, b, a (0 to 1) through
	// a 4x5 matrix, row by row, the fifth column an offset (SVG
	// feColorMatrix). Fewer than 20 values leave the group unchanged.
	struct ColorMatrix {
		values float[]
	}
}
