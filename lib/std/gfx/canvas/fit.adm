partial module std.gfx.canvas {
	// Fit is how content with its own size is fitted into a box.
	enum Fit {
		// Stretched to the box, ratio not kept.
		Stretch,
		// As large as fits inside the box, ratio kept.
		Contain,
		// As small as covers the box, ratio kept, the overflow cut off.
		Cover,
		// Its own size.
		None,
		// Like Contain, never larger than its own size.
		ScaleDown,
	}
}
