// Colour glyphs in text: the font's COLR paint graphs drawn as clips,
// transforms, groups and gradient fills, embedded bitmaps as images, SVG
// glyphs through the SVG decoder. Canvas text and SVG text draw them.

internal std partial module std.gfx.canvas.glyphs {
	use (
		std.gfx.canvas::(Painter, Paint, Spread, ColorStop, ColorSpace, LinearGradient, RadialGradient, ConicGradient, Composite)
		std.formats.image.svgrender
		std.math::(Tau)
		std.math.geom::(Point, Rect, Transform2D, Path)
		std.formats.fonts
		std.formats.fonts.color as fontcolor
		std.gfx.color::(Color, RGBA, BlendMode)
		std.units::(Percent)
	)

	// Whether glyph `glyph` of `face` has colour data `drawColorGlyph` draws.
	def hasColorGlyph(face fonts.Face, glyph int) bool {
		return !(colorGlyphOf(face, glyph, 0.0, new Color("#000"), 0, true) is none)
	}

	internal def colorGlyphOf(face fonts.Face, glyph int, ppem float, foreground Color, palette int, svg bool) ?fontcolor.ColorGlyph {
		return none unless face.info().color
		let source = face
		return none unless source is fontcolor.ColorSource
		return source.colorGlyphOf(glyph, ppem, palette, foreground, svg)
	}

	// Draws glyph `glyph` of `face` in colour on `p`. `place` maps the
	// glyph's font units (y up) to user space, `ppem` is its size in device
	// pixels (it picks the bitmap strike), `foreground` the text colour.
	// False, drawing nothing, when the glyph has no colour data to draw.
	def drawColorGlyph(p Painter, face fonts.Face, glyph int, place Transform2D, ppem float, foreground Color, palette int = 0) bool {
		let found = colorGlyphOf(face, glyph, ppem, foreground, palette, true)
		return false when found is none
		match found {
			case fontcolor.PaintedGlyph:
				p.save()
				p.transform(place)
				new ColrDrawer(p, face).paint(found.paint, colrEverywhere())
				p.restore()
				return true
			case fontcolor.BitmapGlyph:
				// Images run y down: undo the flip of `place`.
				let b = found.bounds
				p.save()
				p.transform(place)
				p.scale(1.0, -1.0)
				p.drawImage(found.image, Rect{left: b.left, top: -b.bottom, right: b.right, bottom: -b.top})
				p.restore()
				return true
			case fontcolor.SvgGlyph:
				// The document's element for the glyph, in font units with y
				// down from the glyph's origin.
				let doc = svgrender.parseDocument(found.document.bytes())
				return false when doc is error
				p.save()
				p.transform(place)
				p.scale(1.0, -1.0)
				let drawn = svgrender.drawElement(doc, found.id, p, foreground)
				p.restore()
				return drawn
			default:
				return false
		}
	}

	// A paint that reaches colrEverywhere fills this much: far past any glyph.
	internal def colrEverywhere() Rect {
		return Rect{left: -65536.0, top: -65536.0, right: 65536.0, bottom: 65536.0}
	}

	internal type ColrDrawer {
		internal p    Painter
		internal face fonts.Face

		def new(p Painter, face fonts.Face) {
			self.p = p
			self.face = face
		}

		// Draws `node`; `area` (current units) holds everything it can
		// show, what fills that reach colrEverywhere cover.
		def paint(node fontcolor.ColrPaint, area Rect) {
			match node {
				case fontcolor.ColrSolid:
					p.fill(area, node.color)
				case fontcolor.ColrLinear:
					fillGradient(colrLinear(node), area)
				case fontcolor.ColrRadial:
					fillGradient(colrRadial(node), area)
				case fontcolor.ColrSweep:
					fillGradient(colrSweep(node), area)
				case fontcolor.ColrGlyph:
					let path = glyphPath(int(node.glyph))
					let child = node.paint
					if child is fontcolor.ColrSolid {
						p.fill(path, child.color)
						return
					}
					p.save()
					p.clip(path)
					paint(child, path.bounds())
					p.restore()
				case fontcolor.ColrLayers:
					for let (_, layer) in node.layers {
						paint(layer, area)
					}
				case fontcolor.ColrTransform:
					let t = node.transform
					let det = t.a * t.d - t.b * t.c
					return when det.abs() < 1e-12 // flattens everything to a line
					p.save()
					p.transform(t)
					paint(node.paint, colrBox(t.inverse(), area))
					p.restore()
				case fontcolor.ColrClip:
					p.save()
					p.clip(node.clip)
					paint(node.paint, node.clip)
					p.restore()
				case fontcolor.ColrComposite:
					composite(node, area)
			}
		}

		// `source` over `backdrop` by the COLR mode, the pair drawn as one
		// layer.
		internal def composite(node fontcolor.ColrComposite, area Rect) {
			let mode = node.mode
			match mode {
				case 0:
					return // clear: the pair leaves nothing
				case 1:
					paint(node.source, area)
				case 2:
					paint(node.backdrop, area)
				case 3:
					paint(node.backdrop, area)
					paint(node.source, area)
				case 4:
					paint(node.source, area)
					paint(node.backdrop, area)
				default:
					return when mode > 27 // unknown modes clear, as the format says
					p.beginGroup()
					paint(node.backdrop, area)
					if mode <= 12 {
						// Porter-Duff: the source layer closes with the operator.
						p.setComposite(colrComposite(mode))
						p.beginGroup()
						p.setComposite(Composite.SourceOver)
						paint(node.source, area)
						p.endGroup()
						p.setComposite(Composite.SourceOver)
					} else {
						p.beginGroup(blend = colrBlend(mode))
						paint(node.source, area)
						p.endGroup()
					}
					p.endGroup()
			}
		}

		internal def fillGradient(g ?Paint, area Rect) {
			return when g is none
			let fill Paint = g
			p.fill(area, fill)
		}

		// The outline of glyph `g` in font units, y up.
		internal def glyphPath(g int) Path {
			let outline = face.outline(fonts.GlyphID(g)) onerror recover new fonts.Outline()
			return outline.path(1.0).transformed(new Transform2D(d = -1.0))
		}
	}

	// The box holding `r` moved by `t`.
	internal def colrBox(t Transform2D, r Rect) Rect {
		let xs = [r.left, r.right, r.right, r.left]
		let ys = [r.top, r.top, r.bottom, r.bottom]
		let x0 = 1e300
		let y0 = 1e300
		let x1 = -1e300
		let y1 = -1e300
		for let i = 0; i < 4; i++ {
			let x = t.a * xs[i] + t.c * ys[i] + t.tx
			let y = t.b * xs[i] + t.d * ys[i] + t.ty
			x0 = x0.min(x)
			y0 = y0.min(y)
			x1 = x1.max(x)
			y1 = y1.max(y)
		}
		return Rect{left: x0, top: y0, right: x1, bottom: y1}
	}

	internal def colrComposite(mode int) Composite {
		match mode {
			case 5:
				return Composite.SourceIn
			case 6:
				return Composite.DestinationIn
			case 7:
				return Composite.SourceOut
			case 8:
				return Composite.DestinationOut
			case 9:
				return Composite.SourceAtop
			case 10:
				return Composite.DestinationAtop
			case 11:
				return Composite.Xor
			case 12:
				return Composite.Plus
		}
		return Composite.SourceOver
	}

	internal def colrBlend(mode int) BlendMode {
		match mode {
			case 13:
				return BlendMode.Screen
			case 14:
				return BlendMode.Overlay
			case 15:
				return BlendMode.Darken
			case 16:
				return BlendMode.Lighten
			case 17:
				return BlendMode.ColorDodge
			case 18:
				return BlendMode.ColorBurn
			case 19:
				return BlendMode.HardLight
			case 20:
				return BlendMode.SoftLight
			case 21:
				return BlendMode.Difference
			case 22:
				return BlendMode.Exclusion
			case 23:
				return BlendMode.Multiply
			case 24:
				return BlendMode.Hue
			case 25:
				return BlendMode.Saturation
			case 26:
				return BlendMode.Color
		}
		return BlendMode.Luminosity
	}

	// A colour line with its stops sorted and stretched to 0..1, and where
	// on the original line 0 and 1 now fall.
	internal struct ColrLine {
		stops fontcolor.ColrStop[]
		lo    float
		hi    float
	}

	// None when the line has no stops; a single offset keeps lo == hi.
	internal def colrLine(stops fontcolor.ColrStop[]) ?ColrLine {
		return none when stops.len() == 0
		let sorted = stops.clone()
		sorted.sort((a fontcolor.ColrStop, b fontcolor.ColrStop) => a.offset < b.offset)
		let lo = sorted[0].offset
		let hi = sorted[sorted.len() - 1].offset
		let out fontcolor.ColrStop[]
		for let (_, s) in sorted {
			out.push(fontcolor.ColrStop{offset: hi > lo ?? ((s.offset - lo) / (hi - lo), 0.0), color: s.color})
		}
		return ColrLine{stops: out, lo: lo, hi: hi}
	}

	internal def colrStops(line ColrLine) ColorStop[] {
		let out ColorStop[]
		for let (_, s) in line.stops {
			out.push(ColorStop{offset: s.offset * 100.0 * 1(%), color: s.color})
		}
		return out
	}

	internal def colrLerp(a Point, b Point, t float) Point {
		return new Point(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t)
	}

	// A colrLinear gradient: p1 moved onto the line through p0 square to p0-p2,
	// as the format defines the colour lines; then its ends to where the
	// first and last stops fall.
	internal def colrLinear(g fontcolor.ColrLinear) ?Paint {
		let line = colrLine(g.stops)
		return none when line is none
		return line.stops[line.stops.len() - 1].color when line.hi == line.lo
		let qx = g.p2.x - g.p0.x
		let qy = g.p2.y - g.p0.y
		let len2 = qx * qx + qy * qy
		let p3 = g.p1
		if len2 > 0.0 {
			let k = ((g.p1.x - g.p0.x) * qx + (g.p1.y - g.p0.y) * qy) / len2
			p3 = new Point(g.p1.x - k * qx, g.p1.y - k * qy)
		}
		return new LinearGradient(colrLerp(g.p0, p3, line.lo), colrLerp(g.p0, p3, line.hi), colrStops(line), colrSpread(g.extend), ColorSpace.SRGB)
	}

	internal def colrRadial(g fontcolor.ColrRadial) ?Paint {
		let line = colrLine(g.stops)
		return none when line is none
		return line.stops[line.stops.len() - 1].color when line.hi == line.lo
		let c0 = colrLerp(g.c0, g.c1, line.lo)
		let c1 = colrLerp(g.c0, g.c1, line.hi)
		let r0 = (g.r0 + (g.r1 - g.r0) * line.lo).max(0.0)
		let r1 = (g.r0 + (g.r1 - g.r0) * line.hi).max(0.0)
		return new RadialGradient(c1, r1, colrStops(line), c0, r0, colrSpread(g.extend), ColorSpace.SRGB)
	}

	// A colrSweep from one angle to another, with pad, repeat or reflect past
	// them, as a conic gradient over the whole turn: stops at every angle
	// where the colour line has one, doubled where repeating jumps.
	internal def colrSweep(g fontcolor.ColrSweep) ?Paint {
		let line = colrLine(g.stops)
		return none when line is none
		let a0 = g.startAngle + (g.endAngle - g.startAngle) * line.lo
		let a1 = g.startAngle + (g.endAngle - g.startAngle) * line.hi
		let span = a1 - a0
		if span.abs() < 1e-9 {
			// No sweep: the first colour before the angle, the last after.
			let first = line.stops[0].color
			let last = line.stops[line.stops.len() - 1].color
			let at = (a0 / Tau).clamp(0.0, 1.0)
			return new ConicGradient(g.center, 0.0, [ColorStop{offset:0(%), color:first}, ColorStop{offset:at * 100.0 * 1(%), color:first}, ColorStop{offset:at * 100.0 * 1(%), color:last}, ColorStop{offset:100(%), color:last}], ColorSpace.SRGB)
		}
		// Where on the line the turn's ends fall, and every stop between.
		let s0 = (0.0 - a0) / span
		let s1 = (Tau - a0) / span
		let lo = s0.min(s1)
		let hi = s0.max(s1)
		let angles = [0.0, Tau]
		let spread = colrSpread(g.extend)
		let n0 = spread == Spread.Pad ?? (0, int(lo.floor()) - 1)
		let n1 = spread == Spread.Pad ?? (0, int(hi.ceil()) + 1)
		if (n1 - n0) * line.stops.len() <= 2048 {
			for let n = n0; n <= n1; n++ {
				for let (_, s) in line.stops {
					for let (_, u) in [float(n) + s.offset, float(n) - s.offset] {
						let a = a0 + u * span
						angles.push(a) when a > 0.0 && a < Tau
					}
				}
			}
		} else {
			// Too many repeats to place exactly: sample the turn.
			for let i = 1; i < 1024; i++ {
				angles.push(Tau * float(i) / 1024.0)
			}
		}
		angles.sort((x float, y float) => x < y)
		let out ColorStop[]
		let eps = 1e-7
		for let (i, a) in angles {
			continue when i > 0 && a - angles[i - 1] < 1e-12
			let at = (a / Tau * 100.0) * 1(%)
			let before = colrColorAt(line, spread, (a - eps - a0) / span)
			let after = colrColorAt(line, spread, (a + eps - a0) / span)
			out.push(ColorStop{offset: at, color: before}) when a > 0.0
			out.push(ColorStop{offset: at, color: after}) when a < Tau && (a == 0.0 || !colrSameColor(before, after))
		}
		return new ConicGradient(g.center, 0.0, out, ColorSpace.SRGB)
	}

	// COLR's extend: 0 pad, 1 repeat, 2 reflect; others pad.
	internal def colrSpread(extend int) Spread {
		return Spread.Repeat when extend == 1
		return Spread.Reflect when extend == 2
		return Spread.Pad
	}

	internal def colrSameColor(a Color, b Color) bool {
		return a.rgba.r == b.rgba.r && a.rgba.g == b.rgba.g && a.rgba.b == b.rgba.b && a.rgba.a == b.rgba.a
	}

	// The colour at `s` along a colrLine line, past its ends by `extend`.
	internal def colrColorAt(line ColrLine, extend Spread, s float) Color {
		let t = s
		match extend {
			case Spread.Pad:
				t = s.clamp(0.0, 1.0)
			case Spread.Repeat:
				t = s - s.floor()
			case Spread.Reflect:
				let m = s - (s / 2.0).floor() * 2.0
				t = m <= 1.0 ?? (m, 2.0 - m)
		}
		let stops = line.stops
		return stops[0].color when t <= stops[0].offset
		for let i = 1; i < stops.len(); i++ {
			if t <= stops[i].offset {
				let a = stops[i - 1]
				let b = stops[i]
				let k = b.offset > a.offset ?? ((t - a.offset) / (b.offset - a.offset), 1.0)
				return colrMix(a.color, b.color, k)
			}
		}
		return stops[stops.len() - 1].color
	}

	internal def colrMix(a Color, b Color, k float) Color {
		let x = a.rgba
		let y = b.rgba
		let at = (u uint8, v uint8) => uint8((float(u) + (float(v) - float(u)) * k + 0.5).floor().clamp(0.0, 255.0))
		return new Color(RGBA{r: at(x.r, y.r), g: at(x.g, y.g), b: at(x.b, y.b), a: at(x.a, y.a)})
	}
}
