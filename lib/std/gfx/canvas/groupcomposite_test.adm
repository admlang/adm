partial module std.gfx.canvas {
	use (
		std.testing
		std.gfx.color::(Color)
		std.math.geom::(Rect)
	)

	check "Group operators" {
		def px(c Canvas, x int, y int) (int, int, int, int) {
			let i = (y * c.width + x) * 4
			return (int(c.pixels[i]), int(c.pixels[i + 1]), int(c.pixels[i + 2]), int(c.pixels[i + 3]))
		}

		@test()
		def groupClosesWithTheOperator() {
			let c = new Canvas(40, 20)
			c.beginGroup()
			c.fill(Rect{left: 0.0, top: 0.0, right: 20.0, bottom: 20.0}, new Color("#f00"))
			c.setComposite(Composite.SourceIn)
			c.beginGroup()
			c.setComposite(Composite.SourceOver)
			c.fill(Rect{left: 10.0, top: 0.0, right: 30.0, bottom: 20.0}, new Color("#00f"))
			c.endGroup()
			c.setComposite(Composite.SourceOver)
			c.endGroup()
			let (r1, _, b1, a1) = px(c, 15, 10)
			assert r1 == 0 && b1 == 255 && a1 == 255 // source where both are
			let (_, _, _, a2) = px(c, 5, 10)
			assert a2 == 0 // backdrop without source is cleared
			let (_, _, _, a3) = px(c, 25, 10)
			assert a3 == 0 // source without backdrop is dropped
		}
	}
}
