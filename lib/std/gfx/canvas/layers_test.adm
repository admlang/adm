partial module std.gfx.canvas {
	use (
		std.testing
		std.gfx::CircleMask
		std.gfx.color::(BlendMode, Color, RGBA)
		std.math.geom::(Circle, Path, Point, Rect, Vec2)
		std.units::(Percent, Pixels)
	)

	check "Layers" {
		def px(cv Canvas, x int, y int) RGBA {
			let i = (y * cv.width + x) * 4
			return RGBA{r: cv.pixels[i], g: cv.pixels[i + 1], b: cv.pixels[i + 2], a: cv.pixels[i + 3]}
		}

		def rgba(r int, g int, b int, a int) Color {
			return new Color(RGBA{r: byte(r), g: byte(g), b: byte(b), a: byte(a)})
		}

		def near(a int, b int, tol int = 1) bool {
			return (a - b).abs() <= tol
		}

		def box(l float, t float, r float, b float) Rect {
			return Rect{left: l, top: t, right: r, bottom: b}
		}

		def all(ls Layers) Rect {
			return box(0.0, 0.0, float(ls.width), float(ls.height))
		}

		@test()
		def stacksMergeBottomToTop() {
			let ls = new Layers(128, 128)
			let bottom = ls.add("bottom")
			bottom.canvas().fill(all(ls), rgba(255, 0, 0, 255))
			let top = ls.add("top")
			top.canvas().fill(all(ls), rgba(0, 0, 255, 128))
			let out = ls.flatten()
			let p = px(out, 70, 70)
			assert near(int(p.r), 127) && near(int(p.b), 128) && p.a == 255
			// Background under everything; hidden layers vanish.
			let bg = new Layers(64, 64, rgba(0, 255, 0, 255))
			let l = bg.add()
			l.canvas().fill(box(0.0, 0.0, 32.0, 64.0), rgba(255, 0, 0, 255))
			assert px(bg.flatten(), 40, 10).g == 255 && px(bg.flatten(), 10, 10).r == 255
			l.visible = false
			assert px(bg.flatten(), 10, 10).g == 255
		}

		@test()
		def opacityFillBlendAndOffset() {
			let ls = new Layers(64, 64)
			let a = ls.add()
			a.canvas().fill(all(ls), rgba(255, 0, 0, 255))
			a.opacity = 50(%)
			assert near(int(px(ls.flatten(), 5, 5).a), 128)
			a.opacity = 1.0
			a.fill = 0.25
			assert near(int(px(ls.flatten(), 5, 5).a), 64)
			a.fill = 1.0
			let m = ls.add()
			m.canvas().fill(all(ls), rgba(128, 128, 128, 255))
			m.blend = BlendMode.Multiply
			let p = px(ls.flatten(), 5, 5)
			assert near(int(p.r), 128) && p.g == 0
			// A layer from a raster, placed at an offset.
			let img = new Canvas(4, 4)
			img.fill(box(0.0, 0.0, 4.0, 4.0), rgba(0, 0, 255, 255))
			let placed = new Layers(16, 16)
			let l = placed.add(img, "icon", new Point(5.0, 6.0))
			assert px(placed.flatten(), 5, 6).b == 255 && px(placed.flatten(), 4, 6).a == 0 && px(placed.flatten(), 8, 9).b == 255
			l.offset = new Point(0.0, 0.0)
			let moved = placed.flatten()
			assert px(moved, 0, 0).b == 255 && px(moved, 8, 9).a == 0
		}

		@test()
		def plainLayersMatchThePixelPath() {
			// The same stack twice; a mask that covers everything sends the
			// second through the per-pixel path.
			let stacks Layers[]
			for let pass = 0; pass < 2; pass++ {
				let ls = new Layers(37, 29, rgba(10, 20, 30, 90))
				for let i = 0; i < 3; i++ {
					let img = new Canvas(13 + 6 * i, 11 + 4 * i)
					img.fill(box(0.0, 0.0, float(img.width), float(img.height)), rgba(200 - 60 * i, 40 * i, 120, 100 + 60 * i))
					img.fill(new Circle(new Point(5.5, 5.0), 4.3), rgba(20, 230, 60 * i, 255))
					let l = ls.add(img, "l", new Point(float(9 * i - 3), float(7 * i - 2)))
					l.opacity = 0.8
					if pass == 1 {
						l.mask = new CircleMask(new Circle(new Point(0.0, 0.0), 1000.0))
					}
				}
				stacks.push(ls)
			}
			let a = stacks[0].flatten()
			let b = stacks[1].flatten()
			for let i = 0; i < a.pixels.len(); i++ {
				assert near(int(a.pixels[i]), int(b.pixels[i]))
			}
		}

		@test()
		def masksAndClippingLayers() {
			let ls = new Layers(64, 64)
			let base = ls.add("base")
			base.canvas().fill(new Circle(new Point(32.0, 32.0), 10.0), rgba(0, 0, 255, 255))
			let clipped = ls.add("clipped")
			clipped.canvas().fill(all(ls), rgba(255, 0, 0, 255))
			clipped.clipBelow = true
			let out = ls.flatten()
			assert px(out, 32, 32).r == 255 && px(out, 2, 2).a == 0
			// A mask in the layer's own pixels moves with it.
			let masked = new Layers(64, 64)
			let img = new Canvas(20, 20)
			img.fill(box(0.0, 0.0, 20.0, 20.0), rgba(255, 0, 0, 255))
			let l = masked.add(img, "m", new Point(30.0, 30.0))
			l.mask = new CircleMask(new Circle(new Point(10.0, 10.0), 5.0))
			let mo = masked.flatten()
			assert px(mo, 40, 40).r == 255 && px(mo, 31, 31).a == 0
		}

		@test()
		def foldersIsolateOrPassThrough() {
			let red = rgba(255, 0, 0, 255)
			let iso = new Layers(64, 64)
			let g = iso.addGroup("g")
			g.passThrough = false
			g.opacity = 0.5
			g.add().canvas().fill(box(0.0, 0.0, 40.0, 64.0), red)
			g.add().canvas().fill(box(20.0, 0.0, 64.0, 64.0), red)
			assert near(int(px(iso.flatten(), 30, 5).a), 128)
			let pass = new Layers(64, 64)
			let p = pass.addGroup("p")
			p.opacity = 0.5
			p.add().canvas().fill(box(0.0, 0.0, 40.0, 64.0), red)
			p.add().canvas().fill(box(20.0, 0.0, 64.0, 64.0), red)
			assert near(int(px(pass.flatten(), 30, 5).a), 191)
			assert pass.layers().len() == 2 && p.items.len() == 2 && pass.items.len() == 1
			// A folder with a style: the shadow of both layers together.
			let styled = new Layers(64, 64)
			let s = styled.addGroup("s")
			s.effects = [DropShadow{offset:new Vec2(4.0, 0.0), blur:0(px), color:rgba(0, 0, 0, 255)}]
			s.add().canvas().fill(box(10.0, 10.0, 20.0, 20.0), red)
			let so = styled.flatten()
			assert px(so, 15, 15).r == 255 && px(so, 22, 15).a == 255 && px(so, 22, 15).r == 0
		}

		@test()
		def onlyChangedTilesMergeAgain() {
			let ls = new Layers(128, 128)
			let l = ls.add()
			l.canvas().fill(all(ls), rgba(255, 0, 0, 255))
			let out = ls.flatten()
			// A sentinel in the far tile: a merge that skips that tile keeps it.
			let raw = out.raw()
			let far = (100 * 128 + 100) * 4
			raw[far + 1] = 77
			l.canvas().fill(box(0.0, 0.0, 10.0, 10.0), rgba(0, 0, 255, 255))
			ls.flatten()
			assert px(out, 5, 5).b == 255
			assert out.pixels[far + 1] == 77
			// A settings change merges the layer's whole area again.
			l.opacity = 0.99
			ls.flatten()
			assert out.pixels[far + 1] == 0
			// So does a new order.
			let top = ls.add("top")
			top.canvas().fill(all(ls), rgba(0, 255, 0, 255))
			assert px(ls.flatten(), 50, 50).g == 255
			ls.move(top, 0)
			assert int(px(ls.flatten(), 50, 50).r) > 200
			assert !(ls.find("top") is none) && ls.layers()[0].name == "top"
			// add(at:) inserts.
			let under = ls.add("under", 0)
			assert ls.layers()[0].name == "under" && ls.layers()[1].name == "top"
			ls.remove(under)
			// Folders move and go too.
			let folder = ls.addGroup("f")
			ls.move(folder, 0)
			assert ls.items.len() == 3
			ls.remove(folder)
			assert ls.items.len() == 2
			ls.remove(top)
			assert ls.layers().len() == 1 && ls.find("top") is none
		}

		@test()
		def mergeDownAndFlattenInto() {
			let ls = new Layers(64, 64)
			let a = ls.add("a")
			a.canvas().fill(all(ls), rgba(255, 0, 0, 255))
			let b = ls.add("b")
			b.canvas().fill(box(0.0, 0.0, 32.0, 64.0), rgba(0, 0, 255, 128))
			let before = ls.flatten().pixels.clone()
			ls.mergeDown(b)
			assert ls.layers().len() == 1
			let after = ls.flatten()
			let same = true
			for let i = 0; i < before.len(); i++ {
				same = false when (int(before[i]) - int(after.pixels[i])).abs() > 1
			}
			assert same
			let into = new Canvas(64, 64)
			ls.flatten(into)
			assert px(into, 10, 10).r == px(after, 10, 10).r && px(into, 50, 10).r == 255
			a.canvas().fill(box(40.0, 0.0, 64.0, 64.0), rgba(0, 255, 0, 255))
			ls.flatten(into)
			assert px(into, 50, 10).g == 255 && px(into, 10, 10).r == px(after, 10, 10).r
		}

		@test()
		def manyTranslucentLayersDoNotDrift() {
			// Twenty 10% white layers over black: 1 - 0.9^20 of white, merged
			// in float and rounded once.
			let ls = new Layers(64, 64, rgba(0, 0, 0, 255))
			for let i = 0; i < 20; i++ {
				ls.add().canvas().fill(all(ls), rgba(255, 255, 255, 26))
			}
			let want = 255.0 * (1.0 - (1.0 - 26.0 / 255.0) ** 20.0)
			let sum = 0
			let out = ls.flatten()
			for let x = 0; x < 64; x++ {
				sum += int(px(out, x, 7).r)
			}
			assert (float(sum) / 64.0 - want).abs() < 0.6
		}
	}
}
