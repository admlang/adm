partial module std.gfx.canvas {
	use (
		std.gfx
		std.math.geom::(Rect, Size)
	)

	// How many marks a live raster keeps for the renderers that hold its picture: one
	// that last took it more marks ago than this takes it whole.
	internal const liveMarksKept = 64

	// A raster whose pixels change in place, part by part: its holder writes into
	// `pixels()` and says which rectangles it changed with
	// `mark`. A renderer keeps its texture and updates only the rectangles marked since the
	// frame it last drew; a frame's comparison counts a drawing of it as changed only when
	// something was marked. Drawing it costs nothing per byte: no hash of its pixels, no
	// whole upload. An image or canvas changed in place is hashed whole instead.
	//
	//     let picture = new LiveRaster(1600, 1000)
	//     copyRows(picture.pixels(), ...)          // the changed part
	//     picture.mark(Rect<int>{left: 10, top: 20, right: 90, bottom: 36})
	//     ctx.drawImage(picture, at)
	type LiveRaster {
		internal width   int
		internal height  int
		// Bytes from one row to the next: `width * 4` unless `reshape` gave another.
		internal pitch   int
		internal store   byte[]
		// Names this raster to the renderers that keep its picture (`id`).
		internal serial  uint64
		internal version uint64      = 0
		// The latest marks, oldest first, and the version each made.
		internal marks   Rect<int>[]
		internal made    uint64[]

		// A raster of `width` x `height` pixels, transparent black: straight RGBA, a byte
		// each, rows top to bottom with no padding.
		def new(width int, height int) {
			self.width = width.max(0)
			self.height = height.max(0)
			pitch = self.width * 4
			store.len(pitch * self.height)
			serial = liveIds.take()
		}

		// Says that the pixels in `r` changed (clipped to the raster); an empty
		// rectangle says nothing.
		def mark(r Rect<int>) {
			let clipped = Rect<int>{left: r.left.max(0), top: r.top.max(0), right: r.right.min(width), bottom: r.bottom.min(height)}
			return when clipped.right <= clipped.left || clipped.bottom <= clipped.top
			version++
			if marks.len() == liveMarksKept {
				marks = marks[1:]
				made = made[1:]
			}
			marks.push(clipped)
			made.push(version)
		}

		// The pixels, written in place: pixel (x, y) starts at `y * stride() + x * 4`.
		def pixels() byte[] {
			return store
		}

		// Names this raster, for the renderers that keep its picture: no other live
		// raster has it.
		def id() uint64 {
			return serial
		}

		// How many times it was marked. For renderers: the picture they hold is of this
		// version.
		def changes() uint64 {
			return version
		}

		// The rectangles marked after version `since`, oldest first; none when that is
		// more marks ago than it keeps, or before its size changed: the whole picture is
		// to be taken again.
		def marksSince(since uint64) ?Rect<int>[] {
			let out Rect<int>[]
			return out when since >= version
			return none when made.len() == 0 || made[0] > since + 1
			for let (i, r) in marks {
				out.push(r) when made[i] > since
			}
			return out
		}

		// What identifies its picture as of now, for a renderer's cache and a frame's
		// comparison: it moves with each mark, and two live rasters never share one.
		def key() uint64 {
			let mixed = (serial * uint64(0x9E3779B97F4A7C15)) ^ (version * uint64(0xBF58476D1CE4E5B9))
			return mixed ^ (mixed >> 31)
		}

		// --- Raster ------------------------------------------------------------

		def size() Size<uint> {
			return new Size<uint>(uint(width), uint(height))
		}

		def stride() int {
			return pitch
		}

		def raw() byte[] {
			return store
		}

		// Adopts a new store and size: a renderer takes the whole picture again.
		def reshape(data byte[], size Size<uint>, stride int) {
			store = data
			width = int(size.width)
			height = int(size.height)
			pitch = stride
			version++
			marks = []
			made = []
		}
	}

	// The ids of live rasters, one each, from any task.
	internal type LiveIds {
		next uint64 = 0

		atomic def take() uint64 {
			next++
			return next
		}
	}

	internal let liveIds = new LiveIds()

	// The live raster `src` is, drawn whole through a window of (wx, wy, ww, wh); none for
	// any other raster or window: its picture is keyed by its bytes.
	internal def liveWhole(src ?gfx.Raster, wx int, wy int, ww int, wh int) ?LiveRaster {
		if src is LiveRaster {
			return src when wx == 0 && wy == 0 && ww == src.width && wh == src.height
		}
		return none
	}

	// The version of a live raster, 0 for any other: recorded with a drawing of it, so a
	// frame's comparison sees it changed when it was marked (`sameOp`).
	internal def liveVersion(src gfx.Raster) uint64 {
		return src is LiveRaster ?? (src.version, uint64(0))
	}
}
