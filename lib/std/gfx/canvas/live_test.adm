partial module std.gfx.canvas {
	use (
		std.testing
		std.math.geom::(Point, Rect, Size)
	)

	check "Live raster" {
		def box(left int, top int, right int, bottom int) Rect<int> {
			return Rect<int>{left: left, top: top, right: right, bottom: bottom}
		}

		def edges(r Rect<int>) string {
			return "{r.left},{r.top},{r.right},{r.bottom}"
		}

		// The key and the image of a lowering of a drawing of it.
		def lowered(picture LiveRaster, whole bool) GpuImage[] {
			let ctx = new DrawContext(new Size(64.0, 64.0))
			if whole {
				ctx.drawImage(picture, new Point(2.0, 2.0))
			} else {
				ctx.drawImage(picture, Rect{left: 1.0, top: 1.0, right: 5.0, bottom: 5.0}, Rect{left: 0.0, top: 0.0, right: 4.0, bottom: 4.0})
			}
			let out GpuImage[]
			for let (_, op) in ctx.lower().ops {
				match op {
					case GpuDraw:
						let paint = op.paint
						out.push(paint) when paint is GpuImage
					default:
				}
			}
			return out
		}

		// A frame that draws it whole.
		def recorded(picture LiveRaster) DrawContext {
			let ctx = new DrawContext(new Size(32.0, 32.0))
			ctx.drawImage(picture, new Point(0.0, 0.0))
			return ctx
		}

		@test()
		def marksAreKeptClippedAndInOrder() {
			let picture = new LiveRaster(16, 8)
			assert picture.pixels().len() == 16 * 8 * 4 && picture.stride() == 64
			assert picture.changes() == 0
			let none0 = picture.marksSince(0)
			assert !(none0 is none) && none0.len() == 0
			picture.mark(box(-4, 2, 6, 20))
			picture.mark(box(3, 3, 3, 9))
			picture.mark(box(10, 0, 12, 1))
			// The empty one says nothing.
			assert picture.changes() == 2
			let all = picture.marksSince(0)
			assert !(all is none) && all.len() == 2 && edges(all[0]) == "0,2,6,8" && edges(all[1]) == "10,0,12,1"
			let last = picture.marksSince(1)
			assert !(last is none) && last.len() == 1 && edges(last[0]) == "10,0,12,1"
		}

		@test()
		def oldMarksAndReshapesTakeItWhole() {
			let picture = new LiveRaster(8, 8)
			for let i = 0; i < liveMarksKept + 5; i++ {
				picture.mark(box(0, 0, 1, 1))
			}
			// The first five are gone: one that held version 2 takes it whole.
			assert picture.marksSince(2) is none
			let kept = picture.marksSince(5)
			assert !(kept is none) && kept.len() == liveMarksKept
			let held = picture.changes()
			let data byte[]
			data.len(4 * 4 * 4)
			picture.reshape(data, new Size<uint>(uint(4), uint(4)), 16)
			assert picture.changes() == held + 1 && picture.marksSince(held) is none
			assert picture.size().width == uint(4) && picture.stride() == 16
		}

		@test()
		def itsKeyMovesOnlyWhenMarked() {
			let a = new LiveRaster(8, 8)
			let b = new LiveRaster(8, 8)
			assert a.id() != b.id() && a.key() != b.key()
			let first = a.key()
			a.pixels()[0] = byte(200)
			assert a.key() == first
			a.mark(box(0, 0, 1, 1))
			assert a.key() != first
		}

		// Drawn whole, its image is named by the raster, not by its bytes; drawn through
		// a window of it, by the bytes as any raster.
		@test()
		def aWholeDrawingIsLive() {
			let picture = new LiveRaster(8, 8)
			picture.mark(box(0, 0, 8, 8))
			let whole = lowered(picture, true)
			assert whole.len() == 1 && whole[0].key == picture.key()
			let held = whole[0].live
			assert !(held is none) && held.id() == picture.id()
			let part = lowered(picture, false)
			assert part.len() == 1 && part[0].live is none && part[0].key != picture.key()
		}

		// Lowered as an image, it draws the bytes a blit onto a canvas does.
		@test()
		def itDrawsWhatItHolds() {
			let picture = new LiveRaster(6, 5)
			let px = picture.pixels()
			for let i = 0; i < px.len(); i += 4 {
				px[i] = byte(i % 251)
				px[i + 1] = byte(255 - i % 200)
				px[i + 2] = byte(40)
				px[i + 3] = byte(255)
			}
			picture.mark(box(0, 0, 6, 5))
			let direct = new Canvas(16, 12)
			let ctx = new DrawContext(new Size(16.0, 12.0))
			ctx.drawImage(picture, new Point(3.0, 4.0))
			ctx.replay(direct)
			let back = ctx.lower().render()
			let diffs = 0
			for let i = 0; i < direct.pixels.len(); i++ {
				diffs++ when back.pixels[i] != direct.pixels[i]
			}
			assert diffs == 0
		}

		// A frame's comparison: the same live raster drawn again is the same drawing
		// until it is marked.
		@test()
		def aDrawingChangesWhenMarked() {
			let picture = new LiveRaster(8, 8)
			let before = recorded(picture)
			let again = recorded(picture)
			assert before.sameCalls(0, before.count(), again, 0)
			picture.mark(box(1, 1, 2, 2))
			let after = recorded(picture)
			assert !before.sameCalls(0, before.count(), after, 0)
		}
	}
}
