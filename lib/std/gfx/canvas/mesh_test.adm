partial module std.gfx.canvas {
	use (
		std.testing
		std.gfx.color::(Color, RGBA)
		std.math.geom::(Path, Point, Rect)
	)

	check "Mesh gradient" {
		def px(cv Canvas, x int, y int) RGBA {
			let i = (y * cv.width + x) * 4
			return RGBA{r: cv.pixels[i], g: cv.pixels[i + 1], b: cv.pixels[i + 2], a: cv.pixels[i + 3]}
		}

		def rgba(r int, g int, b int, a int = 255) Color {
			return new Color(RGBA{r: byte(r), g: byte(g), b: byte(b), a: byte(a)})
		}

		def near(a int, b int, tol int = 3) bool {
			return (a - b).abs() <= tol
		}

		// A 1x1 mesh over (10, 10)-(50, 50): red, green, blue, white corners.
		def square() MeshGradient {
			return new MeshGradient(1, 1, [new Point(10.0, 10.0), new Point(50.0, 10.0), new Point(10.0, 50.0), new Point(50.0, 50.0)], [rgba(255, 0, 0), rgba(0, 255, 0), rgba(0, 0, 255), rgba(255, 255, 255)], space = ColorSpace.SRGB)
		}

		@test()
		def cornersKeepTheirColours() {
			let m = square()
			let c = m.colorAt(0.0, 0.0).rgba
			assert c.r == 255 && c.g == 0 && c.b == 0 && c.a == 255
			let w = m.colorAt(1.0, 1.0).rgba
			assert w.r == 255 && w.g == 255 && w.b == 255
			// The middle is the even blend of the four in sRGB.
			let mid = m.colorAt(0.5, 0.5).rgba
			assert near(int(mid.r), 128) && near(int(mid.g), 128) && near(int(mid.b), 128)
			let cv = new Canvas(60, 60)
			cv.fill(m.outline(), m)
			assert near(int(px(cv, 10, 10).r), 255, 12) && px(cv, 10, 10).b < 12
			assert near(int(px(cv, 49, 49).g), 255, 12) && near(int(px(cv, 49, 49).b), 255, 12)
			assert near(int(px(cv, 30, 30).r), 128, 6) && near(int(px(cv, 30, 30).b), 128, 6)
		}

		@test()
		def outsideTheGridIsTransparent() {
			let cv = new Canvas(60, 60)
			cv.fill(Rect{left: 0.0, top: 0.0, right: 60.0, bottom: 60.0}, square())
			assert px(cv, 5, 30).a == 0 && px(cv, 55, 30).a == 0 && px(cv, 30, 30).a == 255
			// Lists that do not match the grid paint nothing.
			let broken = new MeshGradient(2, 1, [new Point(0.0, 0.0)], [rgba(255, 0, 0)])
			let bare = new Canvas(10, 10)
			bare.fill(Rect{left: 0.0, top: 0.0, right: 10.0, bottom: 10.0}, broken)
			assert px(bare, 5, 5).a == 0 && broken.outline().verbs.len() == 0
		}

		@test()
		def edgesKeepTheMeshColour() {
			// Half a pixel of coverage at the left edge (x = 10.5): half
			// alpha, the mesh's own colour, not darkened.
			let m = new MeshGradient(1, 1, [new Point(10.5, 10.0), new Point(50.0, 10.0), new Point(10.5, 50.0), new Point(50.0, 50.0)], [rgba(0, 0, 255), rgba(0, 0, 255), rgba(0, 0, 255), rgba(0, 0, 255)])
			let cv = new Canvas(60, 60)
			cv.fill(m.outline(), m)
			let e = px(cv, 10, 30)
			assert near(int(e.a), 128, 4) && e.b == 255 && e.r == 0
		}

		@test()
		def warpedGridsFollowTheirPoints() {
			// Two patches; the middle column moved right: the green middle
			// colour follows it.
			let pts = [new Point(0.0, 0.0), new Point(40.0, 0.0), new Point(50.0, 0.0), new Point(0.0, 20.0), new Point(40.0, 20.0), new Point(50.0, 20.0)]
			let cs = [rgba(255, 0, 0), rgba(0, 255, 0), rgba(0, 0, 255), rgba(255, 0, 0), rgba(0, 255, 0), rgba(0, 0, 255)]
			let m = new MeshGradient(2, 1, pts, cs, space = ColorSpace.SRGB)
			let cv = new Canvas(50, 20)
			cv.fill(m.outline(), m)
			assert px(cv, 40, 10).g > 230 && px(cv, 20, 10).r > 100 && px(cv, 20, 10).g > 100
			// A recording draws the same.
			let replayed = new Canvas(50, 20)
			record((p Painter) => p.fill(m.outline(), m)).replay(replayed)
			for let i = 0; i < cv.pixels.len(); i++ {
				assert replayed.pixels[i] == cv.pixels[i]
			}
		}
	}
}
