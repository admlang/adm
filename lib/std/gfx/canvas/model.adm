partial module std.gfx.canvas {
	use (
		std.formats.image as image
		std.gfx.color::(Color, RGBA)
		std.gfx.scene::(PreparedModel, Viewpoint)
		std.math.geom::(Rect, Transform2D)
	)

	// ModelPicture is a 3D model seen from a viewpoint, as a picture of a
	// size in pixels with a transparent background: what `drawModel` puts
	// into its rectangle. `changes` is the model's own count when the
	// picture was asked for, so two of them are compared without drawing.
	struct ModelPicture {
		model   PreparedModel
		from    Viewpoint
		width   int
		height  int
		// Pixels drawn per pixel of the picture along each axis, 1 to 4.
		samples int
		changes uint64
	}

	// modelImage draws the picture on the CPU; a task cancelled meanwhile
	// gets a transparent one.
	internal def modelImage(picture ModelPicture) image.Image {
		let drawn = picture.model.render(picture.width, picture.height, picture.from, new Color(RGBA{r: 0, g: 0, b: 0, a: 0}), picture.samples)
		return new image.Image(picture.width, picture.height) when drawn is none
		return drawn
	}

	// A model's picture as a paint: device pixels mapped back into the
	// picture's pixels, as PatternShader samples an image. A GPU renderer
	// that draws models takes the picture itself (GpuImage.model); shading
	// on the CPU draws it to an image first.
	internal type ModelShader {
		internal picture ModelPicture
		// Picture pixels to device pixels, and back.
		internal t       Transform2D
		internal inv     Transform2D
		internal reaches bool
		// Whether a renderer draws the picture itself: the canvas is lowering
		// into a frame that takes models.
		internal direct  bool
		internal cpu     ?PatternShader = none

		def new(picture ModelPicture, t Transform2D) {
			self.picture = picture
			self.t = t
			inv = t.inverse()
			reaches = picture.width > 0 && picture.height > 0 && isFinite(inv)
		}

		// Draws the picture (once, before rows are shaded on several tasks).
		def prepare() {
			return unless cpu is none
			let made = new PatternShader(modelImage(picture), Rect{left: 0.0, top: 0.0, right: -1.0, bottom: -1.0}, Spread.Pad, Spread.Pad, t, Sampling.Bilinear)
			made.prepare()
			cpu = made
		}

		def shade(x0 int, y int, n int, out byte[]) {
			prepare()
			let from = cpu
			from.shade(x0, y, n, out) unless from is none
		}
	}
}
