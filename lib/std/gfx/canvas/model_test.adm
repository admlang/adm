partial module std.gfx.canvas {
	use (
		std.formats.models::(Camera, Material, Mesh, Model, Node, Primitive)
		std.gfx.color::(Color)
		std.gfx.scene::(PreparedModel, Viewpoint)
		std.math.geom::(Rect, Size, Vec3)
		std.testing
	)

	check "Model drawing" {
		// A green unit square facing +z, prepared, and a viewpoint three
		// units in front of it: the square covers about the middle two
		// thirds of a square picture.
		def square() PreparedModel {
			let model = new Model("test")
			let m = new Material("m")
			m.baseColor = new Color("#00ff00")
			m.unlit = true
			model.materials.push(m)
			let mesh = new Mesh("square")
			let p = mesh.add(new Primitive())
			p.material = m
			p.positions = float32[-0.5, -0.5, 0, 0.5, -0.5, 0, 0.5, 0.5, 0, -0.5, 0.5, 0]
			p.indices = uint32[0, 1, 2, 0, 2, 3]
			model.meshes.push(mesh)
			let node = new Node("square")
			node.mesh = mesh
			model.nodes.push(node)
			return new PreparedModel(model)
		}

		def front() Viewpoint {
			let lens = new Camera()
			lens.yfov = 0.5
			return new Viewpoint(new Vec3(0, 0, 3), new Vec3(0, 0, 0), new Vec3(0, 1, 0), lens)
		}

		def at(c Canvas, x int, y int) string {
			let i = (y * c.width + x) * 4
			return "{c.pixels[i]},{c.pixels[i + 1]},{c.pixels[i + 2]},{c.pixels[i + 3]}"
		}

		@test()
		def itIsDrawnOverWhatIsThere() {
			let prepared = square()
			let canvas = new Canvas(96, 64)
			canvas.clear(new Color("#101020"))
			canvas.drawModel(prepared, front(), 16, 0, 64, 64)
			// The square in the middle of its rectangle, the background kept
			// around it there and outside the rectangle.
			assert at(canvas, 48, 32) == "0,255,0,255"
			assert at(canvas, 18, 2) == "16,16,32,255" && at(canvas, 4, 32) == "16,16,32,255" && at(canvas, 90, 32) == "16,16,32,255"
			// The same pixels as the model's own picture gives.
			let own = prepared.render(64, 64, front())
			assert !(own is none)
			return when own is none
			let px = own.raw()
			let differing = 0
			for let y = 0; y < 64; y++ {
				for let x = 0; x < 64; x++ {
					let i = (y * 64 + x) * 4
					continue when px[i + 3] != 255
					let j = (y * 96 + x + 16) * 4
					differing++ when canvas.pixels[j] != px[i] || canvas.pixels[j + 1] != px[i + 1] || canvas.pixels[j + 2] != px[i + 2]
				}
			}
			assert differing == 0
		}

		@test()
		def aRecordingDrawsTheSame() {
			let prepared = square()
			let direct = new Canvas(64, 64)
			direct.drawModel(prepared, front(), 0, 0, 64, 64)
			let ctx = new DrawContext(new Size(64.0, 64.0))
			ctx.drawModel(prepared, front(), 0, 0, 64, 64)
			let replayed = new Canvas(64, 64)
			ctx.replay(replayed)
			let lowered = ctx.lower().render()
			let differing = 0
			for let i = 0; i < direct.pixels.len(); i++ {
				differing++ when replayed.pixels[i] != direct.pixels[i] || lowered.pixels[i] != direct.pixels[i]
			}
			assert differing == 0 && at(direct, 32, 32) == "0,255,0,255"
		}

		// Lowered for a renderer that draws models, the picture is left to
		// it; for any other it is drawn while lowering. Both frames draw the
		// same on the CPU.
		@test()
		def aRendererMayTakeTheModelItself() {
			let prepared = square()
			let ctx = new DrawContext(new Size(64.0, 64.0))
			ctx.drawModel(prepared, front(), 8, 8, 48, 48, 2)
			let handed = 0
			let frame = ctx.lower(models = true)
			for let (_, op) in frame.ops {
				match op {
					case GpuDraw:
						let paint = op.paint
						if paint is GpuImage {
							let picture = paint.model
							assert !(picture is none)
							continue when picture is none
							assert picture.model == prepared && picture.width == 48 && picture.height == 48 && picture.samples == 2
							assert picture.changes == prepared.changes() && picture.from.equals(front())
							handed++
						}
					default:
				}
			}
			assert handed == 1
			let plain = ctx.lower()
			for let (_, op) in plain.ops {
				match op {
					case GpuDraw:
						let paint = op.paint
						assert !(paint is GpuImage)
					default:
				}
			}
			let a = frame.render()
			let b = plain.render()
			let differing = 0
			for let i = 0; i < a.pixels.len(); i++ {
				differing++ when a.pixels[i] != b.pixels[i]
			}
			assert differing == 0 && at(a, 32, 32) == "0,255,0,255"
		}

		@test()
		def itGoesThroughTheSettings() {
			let prepared = square()
			let canvas = new Canvas(128, 128)
			// Twice the size, clipped to the left half of its rectangle.
			canvas.save()
			canvas.clip(Rect{left: 0.0, top: 0.0, right: 64.0, bottom: 128.0})
			canvas.scale(2.0, 2.0)
			canvas.drawModel(prepared, front(), 0, 0, 64, 64)
			canvas.restore()
			assert at(canvas, 60, 64) == "0,255,0,255" && at(canvas, 68, 64) == "0,0,0,0"
			// Drawn at the size it has on the canvas: the square's edge is as
			// sharp as in a picture of 128 pixels.
			let own = prepared.render(128, 128, front())
			assert !(own is none)
			return when own is none
			let differing = 0
			for let y = 0; y < 128; y++ {
				for let x = 0; x < 64; x++ {
					let i = (y * 128 + x) * 4
					differing++ when canvas.pixels[i + 3] != own.raw()[i + 3]
				}
			}
			assert differing == 0
		}

		@test()
		def aFrameChangesWithTheModelAndTheViewpoint() {
			let prepared = square()
			let from = front()
			let record = def () DrawContext {
				let ctx = new DrawContext(new Size(64.0, 64.0))
				ctx.drawModel(prepared, from, 0, 0, 64, 64)
				return ctx
			}
			let before = record()
			assert before.sameCalls(0, before.count(), record(), 0)
			// The viewpoint is copied when recorded: moving it afterwards
			// changes the next recording, not this one.
			from.eye = new Vec3(1, 0, 3)
			let moved = record()
			assert !before.sameCalls(0, before.count(), moved, 0)
			let canvas = new Canvas(64, 64)
			before.replay(canvas)
			assert at(canvas, 32, 32) == "0,255,0,255" && at(canvas, 8, 32) == "0,0,0,0"
			// A change of the model changes the frame too.
			prepared.pose()
			assert !moved.sameCalls(0, moved.count(), record(), 0)
		}
	}
}
