partial module std.gfx.canvas {
	use (
		std.gfx::Raster
		std.gfx.color::Color
		std.math.geom::(Point, Rect, Transform2D)
		std.units::Percent
	)

	// Paint is what a fill or stroke puts down. A Color is the plain case.
	type Paint = Color | LinearGradient | RadialGradient | ConicGradient | Pattern | Noise | MeshGradient | ShaderPaint

	// Spread is what a gradient or pattern does past its ends.
	enum Spread {
		Pad,  // the end colours continue
		Repeat,
		Reflect,
	}

	// ColorSpace is where a gradient interpolates: OKLab (the default: even
	// steps in lightness, no grey dead zone between complementary colours),
	// linear light, or sRGB values as CSS does by default (`SRGB`, the classic
	// look).
	enum ColorSpace {
		SRGB,
		LinearRGB,
		OKLab,
	}

	// ColorStop is a colour at a place along a gradient.
	struct ColorStop {
		offset Percent // 0% to 100% along the gradient line
		color  Color
	}

	// LinearGradient shades along the line from `from` to `to` (user space).
	// Stops out of order are moved up to the one before, as CSS does.
	type LinearGradient {
		from          Point
		to            Point
		stops         ColorStop[]
		spread        Spread
		space         ColorSpace
		// Whether colours mix premultiplied by their opacity (CSS, the
		// default) or straight, colour and opacity apart (SVG): from a
		// transparent white stop to black, straight passes through grey.
		premultiplied bool

		def new(from Point, to Point, stops ColorStop[], spread = Spread.Pad, space = ColorSpace.OKLab, premultiplied bool = true) {
			self.from = from
			self.to = to
			self.stops = stops
			self.spread = spread
			self.space = space
			self.premultiplied = premultiplied
		}

		// The colour at t along the gradient (0 at its start, 1 at its end,
		// spread not applied), as the canvas interpolates it before
		// dithering.
		def colorAt(t float) Color {
			return colorOfStops(stops, space, t, premultiplied)
		}
	}

	// RadialGradient shades outward from `focus` (radius `focusRadius`) to
	// the circle at `center` with `radius`, as Canvas 2D and SVG focal
	// gradients do; with no focus it starts at the centre.
	type RadialGradient {
		center        Point
		radius        float
		stops         ColorStop[]
		focus         ?Point
		focusRadius   float
		spread        Spread
		space         ColorSpace
		// Whether colours mix premultiplied by their opacity (CSS, the
		// default) or straight, colour and opacity apart (SVG): from a
		// transparent white stop to black, straight passes through grey.
		premultiplied bool

		def new(center Point, radius float, stops ColorStop[], focus ?Point = none, focusRadius float = 0.0, spread = Spread.Pad, space = ColorSpace.OKLab, premultiplied bool = true) {
			self.premultiplied = premultiplied
			self.center = center
			self.radius = radius
			self.stops = stops
			self.focus = focus
			self.focusRadius = focusRadius
			self.spread = spread
			self.space = space
		}

		// The colour at t along the gradient (0 at its start, 1 at its end,
		// spread not applied), as the canvas interpolates it before
		// dithering.
		def colorAt(t float) Color {
			return colorOfStops(stops, space, t, premultiplied)
		}
	}

	// ConicGradient sweeps once around `center`, starting at `angle` radians
	// clockwise from +x (colour wheels, pie charts).
	type ConicGradient {
		center        Point
		angle         float
		stops         ColorStop[]
		space         ColorSpace
		// Whether colours mix premultiplied by their opacity (CSS, the
		// default) or straight, colour and opacity apart (SVG): from a
		// transparent white stop to black, straight passes through grey.
		premultiplied bool

		def new(center Point, angle float, stops ColorStop[], space = ColorSpace.OKLab, premultiplied bool = true) {
			self.premultiplied = premultiplied
			self.center = center
			self.angle = angle
			self.stops = stops
			self.space = space
		}

		// The colour at t along the gradient (0 at its start, 1 at its end,
		// spread not applied), as the canvas interpolates it before
		// dithering.
		def colorAt(t float) Color {
			return colorOfStops(stops, space, t, premultiplied)
		}
	}

	// Pattern tiles a raster or a picture across the shape. A raster's
	// pixel (0, 0) sits at the user space origin; a picture keeps its own
	// coordinates and repeats its `tile` cell, drawn afresh at the scale it
	// is shown at. Both are moved by `transform` and repeated per axis as
	// `repeatX` and `repeatY` say. Samples are read in linear light.
	type Pattern {
		src                 Raster | Picture
		// The cell that repeats: the whole raster, or the part of the
		// picture's space given.
		tile                Rect
		repeatX             Spread
		repeatY             Spread
		transform           Transform2D
		sampling            Sampling
		// The picture's last rendering: its pixels and the scale they were
		// drawn at (0 before the first).
		internal cache      ?Canvas          = none
		internal cacheScale float            = 0.0

		def new(src Raster, repeatX = Spread.Repeat, repeatY = Spread.Repeat, transform = new Transform2D(), sampling = Sampling.Bilinear) {
			self.src = src
			let size = src.size()
			tile = Rect{left: 0.0, top: 0.0, right: float(size.width), bottom: float(size.height)}
			self.repeatX = repeatX
			self.repeatY = repeatY
			self.transform = transform
			self.sampling = sampling
		}

		// `tile` is the cell, in the picture's units, that repeats; what the
		// picture draws outside it is cut off.
		def new(src Picture, tile Rect, repeatX = Spread.Repeat, repeatY = Spread.Repeat, transform = new Transform2D()) {
			self.src = src
			self.tile = tile
			self.repeatX = repeatX
			self.repeatY = repeatY
			self.transform = transform
			sampling = Sampling.Bilinear
		}
	}

	// Noise is fractal gradient noise (Perlin's improved noise, `octaves`
	// layers each twice as fine and half as strong) in user space, mapped
	// through the stops as a gradient maps its parameter: for textures,
	// clouds, grain and backgrounds. `scale` is the size of the coarsest
	// features in user units; the same seed gives the same field.
	type Noise {
		scale         float
		stops         ColorStop[]
		octaves       int
		seed          int
		space         ColorSpace
		// Whether colours mix premultiplied by their opacity (CSS, the
		// default) or straight, colour and opacity apart (SVG): from a
		// transparent white stop to black, straight passes through grey.
		premultiplied bool

		def new(scale float, stops ColorStop[], octaves int = 4, seed int = 0, space = ColorSpace.OKLab, premultiplied bool = true) {
			self.premultiplied = premultiplied
			self.scale = scale
			self.stops = stops
			self.octaves = octaves
			self.seed = seed
			self.space = space
		}

		// The colour the noise value v (0 to 1) maps to, before dithering.
		def colorAt(v float) Color {
			return colorOfStops(stops, space, v, premultiplied)
		}
	}

	// Noise through the colours, evenly spaced.
	def noise(scale float, colors Color[], octaves int = 4, seed int = 0) Noise {
		return new Noise(scale, evenStops(colors), octaves, seed)
	}

	// A linear gradient through the colours, evenly spaced.
	def linear(from Point, to Point, colors Color[]) LinearGradient {
		return new LinearGradient(from, to, evenStops(colors))
	}

	// A radial gradient from the centre out through the colours, evenly
	// spaced.
	def radial(center Point, radius float, colors Color[]) RadialGradient {
		return new RadialGradient(center, radius, evenStops(colors))
	}

	// The colours as stops from 0% to 100%, evenly spaced.
	internal def evenStops(colors Color[]) ColorStop[] {
		let out ColorStop[]
		let n = colors.len()
		for let (i, c) in colors {
			let at = n == 1 ?? (0.0, float(i) * 100.0 / float(n - 1))
			out.push(ColorStop{offset: at * 1(%), color: c})
		}
		return out
	}
}
