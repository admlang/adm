partial module std.gfx.canvas {
	use (
		std.testing
		std.gfx.color::(Color, RGBA)
		std.math.geom::(Edges, Path, Point, Rect)
		std.units::Pixels
	)

	check "Paint" {
		def px(cv Canvas, x int, y int) RGBA {
			let i = (y * cv.width + x) * 4
			return RGBA{r: cv.pixels[i], g: cv.pixels[i + 1], b: cv.pixels[i + 2], a: cv.pixels[i + 3]}
		}

		def rgba(r int, g int, b int, a int) Color {
			return new Color(RGBA{r: byte(r), g: byte(g), b: byte(b), a: byte(a)})
		}

		def near(a int, b int, tol int = 1) bool {
			return (a - b).abs() <= tol
		}

		def whole(cv Canvas) Path {
			return new Path().rect(Rect{left: 0.0, top: 0.0, right: float(cv.width), bottom: float(cv.height)})
		}

		def stops(a Color, b Color) ColorStop[] {
			return [ColorStop{offset:0(%), color:a}, ColorStop{offset:100(%), color:b}]
		}

		// A w x h canvas whose pixels come from `at(x, y)`.
		def image(w int, h int, at def(int, int) Color) Canvas {
			let cv = new Canvas(w, h)
			for let y = 0; y < h; y++ {
				for let x = 0; x < w; x++ {
					let c = at(x, y).rgba
					let i = (y * w + x) * 4
					cv.pixels[i] = c.r
					cv.pixels[i + 1] = c.g
					cv.pixels[i + 2] = c.b
					cv.pixels[i + 3] = c.a
				}
			}
			return cv
		}

		@test()
		def linearGradientsInSrgb() {
			let cv = new Canvas(256, 4)
			cv.fill(whole(cv), new LinearGradient(new Point(0.0, 0.0), new Point(256.0, 0.0), stops(rgba(0, 0, 0, 255), rgba(255, 255, 255, 255)), space = ColorSpace.SRGB))
			assert near(int(px(cv, 0, 1).r), 0) && near(int(px(cv, 128, 1).r), 128) && near(int(px(cv, 255, 1).r), 255)
			for let x = 1; x < 256; x++ {
				assert int(px(cv, x, 2).r) + 1 >= int(px(cv, x - 1, 2).r)
			}
		}

		@test()
		def ditherHidesTheSteps() {
			// One step of value across 64 pixels: the dither mixes 100 and
			// 101 so each column's mean follows the gradient.
			let cv = new Canvas(64, 64)
			cv.fill(whole(cv), new LinearGradient(new Point(0.0, 0.0), new Point(64.0, 0.0), stops(rgba(100, 100, 100, 255), rgba(101, 101, 101, 255)), space = ColorSpace.SRGB))
			for let (_, x) in [4, 20, 40, 60] {
				let sum = 0
				for let y = 0; y < 64; y++ {
					let v = int(px(cv, x, y).g)
					assert v == 100 || v == 101
					sum += v - 100
				}
				let want = (float(x) + 0.5) / 64.0
				assert (float(sum) / 64.0 - want).abs() < 0.1
			}
		}

		@test()
		def oklabHasNoMuddyMiddle() {
			let red = rgba(255, 0, 0, 255)
			let blue = rgba(0, 0, 255, 255)
			let ok = new Canvas(101, 1)
			ok.fill(whole(ok), new LinearGradient(new Point(0.0, 0.0), new Point(101.0, 0.0), stops(red, blue)))
			let classic = new Canvas(101, 1)
			classic.fill(whole(classic), new LinearGradient(new Point(0.0, 0.0), new Point(101.0, 0.0), stops(red, blue), space = ColorSpace.SRGB))
			let m = px(ok, 50, 0)
			let c = px(classic, 50, 0)
			assert near(int(c.r), 128, 2) && near(int(c.b), 128, 2) && c.g == 0
			// OKLab's middle is lighter: a violet, not a dark purple.
			assert int(m.r) + int(m.g) + int(m.b) > int(c.r) + int(c.g) + int(c.b) + 40
			// Linear light is lighter still in the middle of the ramp.
			let lin = new Canvas(101, 1)
			lin.fill(whole(lin), new LinearGradient(new Point(0.0, 0.0), new Point(101.0, 0.0), stops(rgba(0, 0, 0, 255), rgba(255, 255, 255, 255)), space = ColorSpace.LinearRGB))
			assert int(px(lin, 50, 0).r) > 170
		}

		@test()
		def transparentStopsInterpolatePremultiplied() {
			let cv = new Canvas(101, 1)
			cv.fill(whole(cv), new LinearGradient(new Point(0.0, 0.0), new Point(101.0, 0.0), stops(rgba(255, 0, 0, 255), rgba(0, 0, 255, 0)), space = ColorSpace.SRGB))
			let mid = px(cv, 50, 0)
			// Towards transparent the colour stays red, not grey-blue.
			assert near(int(mid.a), 128, 2) && int(mid.r) > 250 && int(mid.b) < 5
		}

		@test()
		def spreadsRepeatAndReflect() {
			let g = stops(rgba(0, 0, 0, 255), rgba(255, 255, 255, 255))
			let pad = new Canvas(40, 1)
			pad.fill(whole(pad), new LinearGradient(new Point(0.0, 0.0), new Point(10.0, 0.0), g, space = ColorSpace.SRGB))
			assert px(pad, 30, 0).r == 255
			let rep = new Canvas(40, 1)
			rep.fill(whole(rep), new LinearGradient(new Point(0.0, 0.0), new Point(10.0, 0.0), g, Spread.Repeat, ColorSpace.SRGB))
			assert near(int(px(rep, 15, 0).r), int(px(rep, 5, 0).r), 2)
			let ref = new Canvas(40, 1)
			ref.fill(whole(ref), new LinearGradient(new Point(0.0, 0.0), new Point(10.0, 0.0), g, Spread.Reflect, ColorSpace.SRGB))
			assert near(int(px(ref, 12, 0).r), int(px(ref, 7, 0).r), 2)
		}

		@test()
		def radialAndConic() {
			let white = rgba(255, 255, 255, 255)
			let black = rgba(0, 0, 0, 255)
			let r = new Canvas(41, 41)
			r.fill(whole(r), new RadialGradient(new Point(20.5, 20.5), 20.0, stops(white, black), space = ColorSpace.SRGB))
			assert int(px(r, 20, 20).r) > 245 && int(px(r, 0, 20).r) < 10
			assert near(int(px(r, 30, 20).r), 128, 8)
			// A focus off centre: brightest at the focus.
			let f = new Canvas(41, 41)
			f.fill(whole(f), new RadialGradient(new Point(20.5, 20.5), 20.0, stops(white, black), new Point(10.5, 20.5), space = ColorSpace.SRGB))
			assert int(px(f, 10, 20).r) > 240 && px(f, 10, 20).r > px(f, 30, 20).r
			// Conic: first colour on +x, halfway round on -x.
			let c = new Canvas(41, 41)
			c.fill(whole(c), new ConicGradient(new Point(20.5, 20.5), 0.0, stops(black, white), ColorSpace.SRGB))
			assert int(px(c, 35, 21).r) < 20 && near(int(px(c, 5, 20).r), 128, 10)
			// The helpers space colours evenly.
			let h = new Canvas(3, 1)
			h.fill(whole(h), linear(new Point(0.0, 0.0), new Point(3.0, 0.0), [black, white]))
			assert px(h, 0, 0).r < px(h, 2, 0).r
			let rh = new Canvas(9, 9)
			rh.fill(whole(rh), radial(new Point(4.5, 4.5), 4.0, [white, black]))
			assert int(px(rh, 4, 4).r) > 200
		}

		@test()
		def gradientsFollowTheTransform() {
			let cv = new Canvas(40, 1)
			cv.scale(2.0, 1.0)
			cv.fill(new Path().rect(Rect{left: 0.0, top: 0.0, right: 20.0, bottom: 1.0}), new LinearGradient(new Point(0.0, 0.0), new Point(10.0, 0.0), stops(rgba(0, 0, 0, 255), rgba(255, 255, 255, 255)), space = ColorSpace.SRGB))
			// Pixel 10 is at user x 5.25 of the ten-unit ramp.
			assert near(int(px(cv, 10, 0).r), 134, 3) && px(cv, 25, 0).r == 255
		}

		@test()
		def patternsTile() {
			let tile = image(2, 2, (x int, y int) => (x + y) % 2 == 0 ?? (rgba(255, 0, 0, 255), rgba(0, 0, 255, 255)))
			let cv = new Canvas(8, 8)
			cv.fill(whole(cv), new Pattern(tile, sampling = Sampling.Nearest))
			for let y = 0; y < 8; y++ {
				for let x = 0; x < 8; x++ {
					assert px(cv, x, y).r == ((x + y) % 2 == 0 ?? (byte(255), byte(0)))
				}
			}
		}

		@test()
		def drawImagePlacesPixels() {
			let img = image(3, 2, (x int, y int) => rgba(x * 100, y * 100, 7, 255))
			// Whole pixels, unscaled: an exact copy.
			let cv = new Canvas(8, 8)
			cv.drawImage(img, new Point(2.0, 3.0))
			assert px(cv, 2, 3).r == 0 && px(cv, 4, 4).r == 200 && px(cv, 4, 4).g == 100 && px(cv, 5, 3).a == 0
			// Through the state: half alpha.
			let faded = new Canvas(8, 8)
			faded.setAlpha(0.5)
			faded.drawImage(img, new Point(0.0, 0.0))
			assert near(int(px(faded, 1, 1).a), 128)
			// Scaled up with nearest samples: 2x2 blocks.
			let big = new Canvas(6, 4)
			big.drawImage(img, Rect{left: 0.0, top: 0.0, right: 6.0, bottom: 4.0}, Sampling.Nearest)
			assert px(big, 2, 0).r == 100 && px(big, 3, 1).r == 100 && px(big, 5, 3).g == 100
		}

		@test()
		def resamplingIsInLinearLight() {
			let img = image(2, 1, (x int, y int) => x == 0 ?? (rgba(0, 0, 0, 255), rgba(255, 255, 255, 255)))
			let cv = new Canvas(4, 1)
			cv.drawImage(img, Rect{left: 0.0, top: 0.0, right: 4.0, bottom: 1.0})
			// Between black and white, half the light is sRGB ~188, not 128.
			let mid = int(px(cv, 1, 0).r)
			assert mid > 120 && mid < 200
			assert px(cv, 1, 0).r < px(cv, 2, 0).r
			// Shrinking a fine checkerboard averages it to grey instead of
			// aliasing to black or white.
			let checker = image(64, 64, (x int, y int) => (x + y) % 2 == 0 ?? (rgba(0, 0, 0, 255), rgba(255, 255, 255, 255)))
			let small = new Canvas(4, 4)
			small.drawImage(checker, Rect{left: 0.0, top: 0.0, right: 4.0, bottom: 4.0})
			for let y = 0; y < 4; y++ {
				for let x = 0; x < 4; x++ {
					assert near(int(px(small, x, y).g), 188, 6)
				}
			}
		}

		@test()
		def sourceRectsDoNotBleed() {
			let img = image(4, 2, (x int, y int) => x < 2 ?? (rgba(255, 0, 0, 255), rgba(0, 0, 255, 255)))
			let cv = new Canvas(10, 10)
			cv.drawImage(img, Rect{left: 0.0, top: 0.0, right: 2.0, bottom: 2.0}, Rect{left: 0.0, top: 0.0, right: 10.0, bottom: 10.0}, Sampling.Bicubic)
			for let (_, x) in [0, 5, 9] {
				let p = px(cv, x, 5)
				assert p.r == 255 && p.b == 0
			}
		}

		@test()
		def sourceRectsPastTheOriginReadTheirOwnPixels() {
			// Six distinct columns; the window is the last three.
			let img = image(6, 2, (x int, y int) => rgba(40 * x, 250 - 40 * x, 20 * x, 255))
			for let (_, s) in [Sampling.Nearest, Sampling.Bilinear, Sampling.Bicubic] {
				let cv = new Canvas(3, 2)
				cv.drawImage(img, Rect{left: 3.0, top: 0.0, right: 6.0, bottom: 2.0}, Rect{left: 0.0, top: 0.0, right: 3.0, bottom: 2.0}, s)
				for let x = 0; x < 3; x++ {
					let p = px(cv, x, 1)
					assert near(int(p.r), 40 * (x + 3), 2) && near(int(p.g), 250 - 40 * (x + 3), 2)
				}
			}
		}

		@test()
		def nineSliceStretchesEveryEdge() {
			// 6x6 with 2px insets: each of the nine parts its own red, each
			// source column its own blue.
			let part = (x int, y int) => (x < 2 ?? (0, x < 4 ?? (1, 2))) + 3 * (y < 2 ?? (0, y < 4 ?? (1, 2)))
			let img = image(6, 6, (x int, y int) => rgba(25 * part(x, y), 200 - 20 * part(x, y), 30 * x, 255))
			let cv = new Canvas(20, 16)
			cv.drawImage(img, Rect{left: 0.0, top: 0.0, right: 20.0, bottom: 16.0}, new Edges<Pixels>(2(px)))
			// A point well inside each destination part.
			let xs = [0, 10, 18]
			let ys = [0, 8, 15]
			for let j = 0; j < 3; j++ {
				for let i = 0; i < 3; i++ {
					assert near(int(px(cv, xs[i], ys[j]).r), 25 * (i + 3 * j), 2)
				}
				// The right column starts at the window's first source column.
				assert near(int(px(cv, 18, ys[j]).b), 120, 2)
			}
		}

		@test()
		def nineSliceKeepsCorners() {
			// 3x3: distinct corners, grey edges and centre.
			let img = image(3, 3, (x int, y int) => x == 1 || y == 1 ?? (rgba(128, 128, 128, 255), rgba(x * 100, y * 100, 50, 255)))
			let cv = new Canvas(9, 9)
			cv.drawImage(img, Rect{left: 0.0, top: 0.0, right: 9.0, bottom: 9.0}, new Edges<Pixels>(1(px)))
			let tl = px(cv, 0, 0)
			let br = px(cv, 8, 8)
			assert tl.r == 0 && tl.b == 50 && br.r == 200 && br.g == 200
			assert px(cv, 4, 4).r == 128 && px(cv, 4, 0).g == 128 && px(cv, 1, 1).r == 128
		}
	}
}
