partial module std.gfx.canvas {
	use (
		std.gfx::(Mask, Raster)
		std.gfx.color::(BlendMode, Color)
		std.gfx.render as render
		std.gfx.processing.transform::(FitMode)
		std.formats.docs as docs
		std.formats.image as image
		std.formats.video as video
		std.math::sqrt
		std.math.geom::(Circle, Corners, Edges, FillRule, Line, Path, Point, Rect, Size, StrokeStyle, Transform2D)
		std.time
		std.units::(Percent, Pixels)
	)

	// Painter is the drawing API both a Canvas (drawing on the CPU now) and a
	// DrawContext (recording for a renderer, or for a Picture) implement, so
	// drawing code does not care which it is given.
	interface Painter {
		def clear(c Color)
		def save()
		def restore()
		def state() DrawState
		def setState(s DrawState)
		def translate(dx, dy float)
		def rotate(angle float, around Point = new Point(0.0, 0.0))
		def scale(sx, sy float)
		def transform(t Transform2D)
		def setTransform(t Transform2D)
		def resetTransform()
		def clip(path Path, rule FillRule = FillRule.NonZero, antialias bool = true)
		def clip(rect Rect)
		def clip(mask Mask)
		def setAlpha(alpha float | Percent)
		def setComposite(op Composite)
		def setBlend(mode BlendMode)
		def setAntialias(on bool)
		def setSampling(s Sampling)
		// What is drawn next carries `id` until `restore` (the tag is part
		// of the state), so `Picture.hitTest` can name it.
		def tag(id int)
		def fill(path Path, paint Paint, rule FillRule = FillRule.NonZero)
		def stroke(path Path, paint Paint, strokeStyle StrokeStyle = StrokeStyle{})
		def fill(rect Rect, paint Paint)
		def fill(rect Rect, radius float, paint Paint)
		def stroke(rect Rect, paint Paint, strokeStyle StrokeStyle = StrokeStyle{})
		// CSS borders: a width, paint and style per side, the outer edge on
		// `rect`, corners rounded by `radius`.
		def stroke(rect Rect, borders Edges<Border>, radius Corners<Pixels> = new Corners<Pixels>(0(px)))
		def fill(circle Circle, paint Paint)
		def stroke(line Line, paint Paint, strokeStyle StrokeStyle = StrokeStyle{})
		def drawImage(src Raster, at Point)
		def drawImage(src Raster, dest Rect, sampling = Sampling.Bilinear)
		def drawImage(src Raster, source Rect, dest Rect, sampling = Sampling.Bilinear)
		def drawImage(src Raster, dest Rect, insets Edges<Pixels>)
		// Mesh warp: the image's even grid of cells mapped corner to corner
		// onto the patches between `mesh[row][column]` points (at least
		// 2 x 2, rows of one length), each patch bilinear: perspective-like
		// views, page curls, bends. Outside the grid nothing is drawn.
		def drawImage(src Raster, mesh Point[][], sampling = Sampling.Bilinear)
		// Sprites: sprite i is `sources[i]` of the raster, its top left
		// corner at the origin of `transforms[i]` (sprite pixels to user
		// space), multiplied by `colors[i]` when given (white leaves it as
		// it is). Sprites past the shorter of the two lists are left out.
		def drawAtlas(src Raster, sources Rect[], transforms Transform2D[], colors Color[] = [])
		def fillText(text string, at Point, textStyle TextStyle, paint Paint)
		def strokeText(text string, at Point, textStyle TextStyle, paint Paint, strokeStyle StrokeStyle = StrokeStyle{})
		def fillText(text string, along Path, textStyle TextStyle, paint Paint, offset float = 0.0)
		// A paragraph with its top left corner at `at`.
		def fillText(paragraph Paragraph, at Point)
		def measureText(text string, textStyle TextStyle) TextMetrics
		def textPath(text string, at Point, textStyle TextStyle) Path
		def beginGroup(opacity float | Percent = 100(%), blend = BlendMode.Normal, effects Effect[] = [], mask ?Mask = none, bounds ?Rect = none)
		def endGroup()
		def isInPath(path Path, p Point, rule FillRule = FillRule.NonZero) bool
		def isInStroke(path Path, p Point, strokeStyle StrokeStyle) bool
	}

	// The calls a DrawContext records, one struct each, in order.
	internal type DrawOp = render.DrawCommand | SaveOp | RestoreOp | SetStateOp | TransformOp | ClipPathOp | ClipRectOp | ClipMaskOp | AlphaOp | CompositeOp | BlendOp | AntialiasOp | SamplingOp | TagOp | FillOp | TextOp | FillRectOp | StrokeOp | ImageAtOp | ImageOp | WarpOp | AtlasOp | NineSliceOp | BeginGroupOp | EndGroupOp

	internal struct SaveOp {}

	internal struct RestoreOp {}

	internal struct SetStateOp {
		state DrawState
	}

	// Multiplies the transform, or replaces it when `replace`.
	internal struct TransformOp {
		t       Transform2D
		replace bool
	}

	internal struct ClipPathOp {
		path      Path
		rule      FillRule
		antialias bool
	}

	internal struct ClipRectOp {
		rect Rect
	}

	internal struct ClipMaskOp {
		mask Mask
	}

	internal struct AlphaOp {
		alpha float
	}

	internal struct CompositeOp {
		op Composite
	}

	internal struct BlendOp {
		mode BlendMode
	}

	internal struct AntialiasOp {
		on bool
	}

	internal struct SamplingOp {
		sampling Sampling
	}

	internal struct TagOp {
		id int
	}

	internal struct FillOp {
		path  Path
		paint Paint
		rule  FillRule
	}

	// Filled text: replayed as text, so a writer can keep it searchable;
	// `path` is its glyphs as recorded, for bounds and hit tests.
	internal struct TextOp {
		text      string
		at        Point
		textStyle TextStyle
		paint     Paint
		path      Path
	}

	internal struct FillRectOp {
		rect  Rect
		paint Paint
	}

	internal struct StrokeOp {
		path        Path
		paint       Paint
		strokeStyle StrokeStyle
	}

	internal struct ImageAtOp {
		src Raster
		at  Point
	}

	internal struct WarpOp {
		src      Raster
		mesh     Point[][]
		sampling Sampling
	}

	internal struct AtlasOp {
		src        Raster
		sources    Rect[]
		transforms Transform2D[]
		colors     Color[]
	}

	internal struct ImageOp {
		src      Raster
		source   Rect
		dest     Rect
		sampling Sampling
	}

	internal struct NineSliceOp {
		src    Raster
		dest   Rect
		insets Edges<Pixels>
	}

	internal struct BeginGroupOp {
		opacity float
		blend   BlendMode
		effects Effect[]
		mask    ?Mask
		bounds  ?Rect
	}

	internal struct EndGroupOp {}

	// DrawContext records drawing calls in order for a renderer, which draws
	// them (on the GPU where it can), or for replaying onto another Painter:
	// a Canvas (`Canvas.apply`), another recording, a Picture. It keeps the
	// drawing settings as a Canvas does, except that its state's clip stays
	// none: clips are applied when the recording is replayed.
	type DrawContext {
		internal ops       DrawOp[]
		internal viewport  Size
		internal current   DrawState   = DrawState{}
		internal saved     DrawState[]
		// Whether every call so far is a render.DrawCommand.
		internal plainOnly bool        = true

		def new(size Size = new Size(0, 0)) {
			viewport = size
			frameDelta = 0s
			frameTime = new time.Time()
		}

		// Drops the recorded calls and the settings; keeps the viewport.
		def reset() {
			ops.len(0)
			current = DrawState{}
			saved.len(0)
			plainOnly = true
		}

		// reset, and sets the viewport.
		def resetWithSize(size Size) {
			viewport = size
			reset()
		}

		// The viewport the calls are drawn into.
		def size() Size {
			return viewport
		}

		// The recorded calls that are render commands (clears, whole-pixel
		// rectangles in a plain colour, blits, video), in order. When
		// `commandsOnly()` they are the whole recording, which a renderer can
		// draw without the canvas.
		def commands() render.DrawCommand[] {
			let out render.DrawCommand[]
			for let (_, op) in ops {
				match op {
					case render.DrawCommand:
						out.push(op)
					default:
				}
			}
			return out
		}

		// Whether every recorded call is one of `commands()`.
		def commandsOnly() bool {
			return plainOnly
		}

		// The recording lowered for a GPU renderer (see GpuFrame): shapes
		// turned into coverage by the canvas's rasterizer, the rest left to
		// shaders.
		def lower() GpuFrame {
			return lowerContext(self)
		}

		// Replays the recorded calls, in order, onto `onto`.
		def replay(onto Painter) {
			let into = onto is DrawContext
			for let (_, op) in ops {
				if into {
					// Another recording takes the calls as they are.
					copyInto(onto, op)
					continue
				}
				replayOp(op, onto)
			}
		}

		// Appends the op to `other`'s recording (settings follow through the
		// Painter calls).
		internal def copyInto(other Painter, op DrawOp) {
			if other is DrawContext {
				match op {
					case render.DrawCommand:
						other.command(op)
						return
					default:
				}
			}
			replayOp(op, other)
		}

		frameDelta duration {
			def get() duration {
				return value
			}

			internal def set(val duration) {
				value = val
			}
		}

		frameTime time.Time {
			def get() time.Time {
				return value
			}

			internal def set(val time.Time) {
				value = val
			}
		}

		// setFrameTiming records the time since the previous frame and the current
		// time, for animations that read them.
		def setFrameTiming(delta duration, now time.Time) {
			frameDelta = delta
			frameTime = now
		}

		// Records a fill of the whole viewport with the colour.
		def clear(c Color) {
			command(render.DrawCommand{kind: render.CommandKind.Clear, color: c})
		}

		// Records RGBA pixels copied to x, y as they are.
		def blitCopy(src byte[], srcW int, srcH int, x int, y int) {
			command(render.DrawCommand{kind: render.CommandKind.BlitCopy, src: src, srcW: srcW, srcH: srcH, x: x, y: y})
		}

		// Records a copy of a canvas's pixels to x, y.
		def blitCopy(src Canvas, x int, y int) {
			blitCopy(src.pixels, src.width, src.height, x, y)
		}

		// Records a copy of an image's pixels to x, y.
		def blitCopy(src image.Image, x int, y int) {
			blitCopy(src.raw(), int(src.size().width), int(src.size().height), x, y)
		}

		// Records a video frame drawn into the rectangle at x, y of width by
		// height, placed as `fit` says (`video.draw` describes the modes); what
		// the picture leaves of the rectangle is black. The OpenGL renderer
		// converts the picture on the GPU, and draws frames kept there
		// (`Video.frames(onGpu = true)`) without copying them to main memory;
		// other renderers convert it on the CPU.
		def drawVideo(frame video.VideoFrame, x int, y int, width int, height int, fit = FitMode.Contain) {
			return when width <= 0 || height <= 0
			command(render.DrawCommand{kind: render.CommandKind.Video, rect: Rect{left: float(x), top: float(y), right: float(x + width), bottom: float(y + height)}, video: frame, fit: fit})
		}

		// Records RGBA pixels, srcW by srcH, drawn at x, y with the blend mode.
		def blit(src byte[], srcW int, srcH int, x int, y int, mode BlendMode = BlendMode.Normal) {
			command(render.DrawCommand{kind: render.CommandKind.Blit, src: src, srcW: srcW, srcH: srcH, x: x, y: y, mode: mode})
		}

		// Records a canvas drawn at x, y with the blend mode.
		def blit(src Canvas, x int, y int, mode BlendMode = BlendMode.Normal) {
			blit(src.pixels, src.width, src.height, x, y, mode)
		}

		// Records an image drawn at x, y with the blend mode.
		def blit(src image.Image, x int, y int, mode BlendMode = BlendMode.Normal) {
			blit(src.raw(), int(src.size().width), int(src.size().height), x, y, mode)
		}

		// Records RGBA pixels copied to x, y with red and blue swapped, for
		// BGRA targets.
		def blitRGBAtoBGRA(src byte[], srcW int, srcH int, x int, y int) {
			command(render.DrawCommand{kind: render.CommandKind.BlitRGBAtoBGRA, src: src, srcW: srcW, srcH: srcH, x: x, y: y})
		}

		// Pushes the drawing settings; `restore` brings them back.
		def save() {
			saved.push(copyState(current))
			record(SaveOp{})
		}

		// Brings back the settings of the last `save`.
		def restore() {
			if saved.len() > 0 {
				current = saved.pop()
			}
			record(RestoreOp{})
		}

		// A copy of the drawing settings (the clip is none, see DrawContext).
		def state() DrawState {
			return copyState(current)
		}

		// Replaces the drawing settings.
		def setState(s DrawState) {
			current = copyState(s)
			record(SetStateOp{state: copyState(s)})
		}

		// Moves what is drawn next by dx, dy.
		def translate(dx, dy float) {
			transform(new Transform2D(tx = dx, ty = dy))
		}

		// Rotates what is drawn next by `angle` radians, clockwise, around
		// `around`.
		def rotate(angle float, around Point = new Point(0.0, 0.0)) {
			let t = new Transform2D(tx = around.x, ty = around.y).then(new Transform2D().rotation(angle)).then(new Transform2D(tx = -around.x, ty = -around.y))
			transform(t)
		}

		// Scales what is drawn next by sx, sy.
		def scale(sx, sy float) {
			transform(new Transform2D(a = sx, d = sy))
		}

		// Multiplies the current transform by `t`: `t` applies first.
		def transform(t Transform2D) {
			current.transform = current.transform.then(t)
			record(TransformOp{t: copyTransform(t), replace: false})
		}

		// Replaces the current transform.
		def setTransform(t Transform2D) {
			current.transform = copyTransform(t)
			record(TransformOp{t: copyTransform(t), replace: true})
		}

		// Back to drawing in device pixels.
		def resetTransform() {
			setTransform(new Transform2D())
		}

		// Records a clip to the path, through the current transform.
		def clip(path Path, rule FillRule = FillRule.NonZero, antialias bool = true) {
			record(ClipPathOp{path: path, rule: rule, antialias: antialias})
		}

		// Records a clip to the rectangle.
		def clip(rect Rect) {
			record(ClipRectOp{rect: rect})
		}

		// Records a clip by a mask read in device pixels.
		def clip(mask Mask) {
			record(ClipMaskOp{mask: mask})
		}

		// Multiplies the opacity of what is drawn next: 0.5 or 50(%).
		def setAlpha(alpha float | Percent) {
			current.alpha = fraction(alpha)
			record(AlphaOp{alpha: current.alpha})
		}

		def setComposite(op Composite) {
			current.composite = op
			record(CompositeOp{op: op})
		}

		def setBlend(mode BlendMode) {
			current.blend = mode
			record(BlendOp{mode: mode})
		}

		def setAntialias(on bool) {
			current.antialias = on
			record(AntialiasOp{on: on})
		}

		def setSampling(s Sampling) {
			current.sampling = s
			record(SamplingOp{sampling: s})
		}

		def tag(id int) {
			current.tag = id
			record(TagOp{id: id})
		}

		def fill(path Path, paint Paint, rule FillRule = FillRule.NonZero) {
			record(FillOp{path: path, paint: paint, rule: rule})
		}

		def stroke(path Path, paint Paint, strokeStyle StrokeStyle = StrokeStyle{}) {
			record(StrokeOp{path: path, paint: paint, strokeStyle: strokeStyle})
		}

		// Records the rectangle; one on whole pixels in a plain colour with
		// plain settings is a render command, which renderers draw directly.
		def fill(rect Rect, paint Paint) {
			let whole = rect.left == rect.left.floor() && rect.top == rect.top.floor() && rect.right == rect.right.floor() && rect.bottom == rect.bottom.floor()
			if whole && paint is Color && plainState(current) && saved.len() == 0 {
				command(render.DrawCommand{kind: render.CommandKind.FillRect, rect: rect, color: paint})
				return
			}
			record(FillRectOp{rect: rect, paint: paint})
		}

		def fill(rect Rect, radius float, paint Paint) {
			fill(new Path().roundRect(rect, radius * 1(px)), paint)
		}

		def stroke(rect Rect, paint Paint, strokeStyle StrokeStyle = StrokeStyle{}) {
			stroke(new Path().rect(rect), paint, strokeStyle)
		}

		// Records the borders as the clips and fills that draw them.
		def stroke(rect Rect, borders Edges<Border>, radius Corners<Pixels> = new Corners<Pixels>(0(px))) {
			drawBorders(self, rect, borders, radius)
		}

		def fill(circle Circle, paint Paint) {
			fill(new Path().circle(circle.center, circle.radius), paint)
		}

		def stroke(line Line, paint Paint, strokeStyle StrokeStyle = StrokeStyle{}) {
			stroke(new Path().moveTo(line.start.x, line.start.y).lineTo(line.end.x, line.end.y), paint, strokeStyle)
		}

		def drawImage(src Raster, at Point) {
			record(ImageAtOp{src: src, at: at})
		}

		def drawImage(src Raster, dest Rect, sampling = Sampling.Bilinear) {
			let size = src.size()
			record(ImageOp{src: src, source: Rect{left: 0.0, top: 0.0, right: float(size.width), bottom: float(size.height)}, dest: dest, sampling: sampling})
		}

		def drawImage(src Raster, source Rect, dest Rect, sampling = Sampling.Bilinear) {
			record(ImageOp{src: src, source: source, dest: dest, sampling: sampling})
		}

		// Records the warp; the grid is copied.
		def drawImage(src Raster, mesh Point[][], sampling = Sampling.Bilinear) {
			let copy Point[][]
			for let (_, row) in mesh {
				let r Point[]
				for let (_, p) in row {
					r.push(new Point(p.x, p.y))
				}
				copy.push(r)
			}
			record(WarpOp{src: src, mesh: copy, sampling: sampling})
		}

		// Records the sprites; the lists are copied, so changing them later
		// does not change the recording.
		def drawAtlas(src Raster, sources Rect[], transforms Transform2D[], colors Color[] = []) {
			let n = sources.len().min(transforms.len())
			let op = AtlasOp{src: src, sources: Rect[], transforms: Transform2D[], colors: Color[]}
			for let i = 0; i < n; i++ {
				op.sources.push(sources[i])
				op.transforms.push(copyTransform(transforms[i]))
				op.colors.push(colors[i]) when i < colors.len()
			}
			record(op)
		}

		def drawImage(src Raster, dest Rect, insets Edges<Pixels>) {
			record(NineSliceOp{src: src, dest: dest, insets: insets})
		}

		// Records the text as text: a replay draws it through the painter's
		// own fillText, hinted for the transform it is replayed under.
		def fillText(text string, at Point, textStyle TextStyle, paint Paint) {
			// Colour glyphs are recorded as what draws them.
			return when fillColorText(self, text, at, textStyle, paint, current.transform)
			record(TextOp{text: text, at: at, textStyle: textStyle, paint: paint, path: textPath(text, at, textStyle)})
		}

		def strokeText(text string, at Point, textStyle TextStyle, paint Paint, strokeStyle StrokeStyle = StrokeStyle{}) {
			stroke(textPath(text, at, textStyle), paint, strokeStyle)
		}

		// Records the paragraph as the text fills of its runs.
		def fillText(paragraph Paragraph, at Point) {
			drawParagraph(self, paragraph, at)
		}

		def fillText(text string, along Path, textStyle TextStyle, paint Paint, offset float = 0.0) {
			fill(textAlong(text, along, textStyle, offset), paint)
		}

		def measureText(text string, textStyle TextStyle) TextMetrics {
			return textMetrics(text, textStyle)
		}

		def textPath(text string, at Point, textStyle TextStyle) Path {
			return textPathUnder(text, at, textStyle, current.transform)
		}

		def beginGroup(opacity float | Percent = 100(%), blend = BlendMode.Normal, effects Effect[] = [], mask ?Mask = none, bounds ?Rect = none) {
			saved.push(copyState(current))
			record(BeginGroupOp{opacity: fraction(opacity), blend: blend, effects: effects, mask: mask, bounds: bounds})
		}

		def endGroup() {
			if saved.len() > 0 {
				current = saved.pop()
			}
			record(EndGroupOp{})
		}

		// Whether the device point is inside the path under the current
		// transform.
		def isInPath(path Path, p Point, rule FillRule = FillRule.NonZero) bool {
			return path.transformed(current.transform).contains(p, rule)
		}

		// Whether the device point is inside the path's stroke under the
		// current transform.
		def isInStroke(path Path, p Point, strokeStyle StrokeStyle) bool {
			let t = current.transform
			return path.transformed(t).stroked(strokeStyle).contains(p) when strokeStyle.fixedWidth
			return path.stroked(strokeStyle, 0.1 / maxScale(t)).transformed(t).contains(p)
		}

		internal def command(cmd render.DrawCommand) {
			ops.push(cmd)
		}

		internal def record(op DrawOp) {
			ops.push(op)
			plainOnly = false
		}

		// The box replaying the recording onto an untransformed painter may
		// change; see Picture.bounds.
		def bounds() Rect {
			return recordingBounds(ops, viewport)
		}
	}

	// Whether the settings leave a whole-pixel fill as it is.
	internal def plainState(st DrawState) bool {
		return isIdentity(st.transform) && st.clip is none && st.alpha == 1.0 && st.composite == Composite.SourceOver && st.blend == BlendMode.Normal
	}

	// One recorded call onto a painter.
	internal def replayOp(op DrawOp, onto Painter) {
		match op {
			case render.DrawCommand:
				replayCommand(op, onto)
			case SaveOp:
				onto.save()
			case RestoreOp:
				onto.restore()
			case SetStateOp:
				onto.setState(op.state)
			case TransformOp:
				if op.replace {
					onto.setTransform(op.t)
				} else {
					onto.transform(op.t)
				}
			case ClipPathOp:
				onto.clip(op.path, op.rule, op.antialias)
			case ClipRectOp:
				onto.clip(op.rect)
			case ClipMaskOp:
				onto.clip(op.mask)
			case AlphaOp:
				onto.setAlpha(op.alpha)
			case CompositeOp:
				onto.setComposite(op.op)
			case BlendOp:
				onto.setBlend(op.mode)
			case AntialiasOp:
				onto.setAntialias(op.on)
			case SamplingOp:
				onto.setSampling(op.sampling)
			case TagOp:
				onto.tag(op.id)
			case FillOp:
				onto.fill(op.path, op.paint, op.rule)
			case TextOp:
				onto.fillText(op.text, op.at, op.textStyle, op.paint)
			case FillRectOp:
				onto.fill(op.rect, op.paint)
			case StrokeOp:
				onto.stroke(op.path, op.paint, op.strokeStyle)
			case ImageAtOp:
				onto.drawImage(op.src, op.at)
			case ImageOp:
				onto.drawImage(op.src, op.source, op.dest, op.sampling)
			case AtlasOp:
				onto.drawAtlas(op.src, op.sources, op.transforms, op.colors)
			case WarpOp:
				onto.drawImage(op.src, op.mesh, op.sampling)
			case NineSliceOp:
				onto.drawImage(op.src, op.dest, op.insets)
			case BeginGroupOp:
				onto.beginGroup(op.opacity, op.blend, op.effects, op.mask, op.bounds)
			case EndGroupOp:
				onto.endGroup()
		}
	}

	// A render command onto a painter: a Canvas or DrawContext takes it as
	// it is; other painters get the same drawing through the Painter calls.
	internal def replayCommand(cmd render.DrawCommand, onto Painter) {
		if onto is Canvas {
			onto.apply(cmd)
			return
		}
		match cmd.kind {
			case render.CommandKind.Clear:
				onto.clear(cmd.color)
			case render.CommandKind.FillRect:
				onto.fill(cmd.rect, cmd.color)
			default:
				// Pixels and video: drawn onto a canvas of their size first.
				let c = commandPixels(cmd)
				onto.drawImage(c, new Point(float(cmd.x), float(cmd.y))) when !(c is none)
		}
	}

	// The pixels a blit command draws, as a canvas, or none for commands
	// that are not blits.
	internal def commandPixels(cmd render.DrawCommand) ?Canvas {
		return none when cmd.srcW <= 0 || cmd.srcH <= 0 || cmd.src.len() < cmd.srcW * cmd.srcH * 4
		let c = new Canvas(cmd.srcW, cmd.srcH)
		c.blitCopy(cmd.src, cmd.srcW, cmd.srcH, 0, 0)
		return c
	}

	// Picture is a recorded drawing: it replays onto any Painter at any
	// size, and writes out as SVG, a resolution-independent export.
	type Picture {
		internal rec DrawContext

		// A picture of what the context recorded.
		def new(recording DrawContext) {
			rec = recording
		}

		// Draws the picture onto the painter, through its current settings.
		def replay(onto Painter) {
			rec.replay(onto)
		}

		// The box a replay onto an untransformed painter may change, in its
		// pixels: every shape through its recorded transform and clips,
		// strokes with their width, groups grown by how far their effects
		// reach. A clear, or an operator that also clears outside its shape,
		// counts the whole clip, or the recording's viewport without one.
		// Empty (all zero) when nothing is drawn.
		def bounds() Rect {
			return rec.bounds()
		}

		// The tag of the topmost tagged drawing under the device point `p`
		// (see Painter.tag), when the picture is replayed onto an
		// untransformed painter: fills and text by their outline and rule,
		// strokes by their outline, images and rectangles by their box, each
		// through its clips and its group's bounds. Untagged drawings neither
		// match nor hide what is beneath them. None when nothing tagged is
		// there.
		def hitTest(p Point) ?int {
			return recordingHit(rec.ops, p)
		}

		// The picture as an SVG document (std.formats.image.SVG.encode says
		// what becomes vectors and what pixels).
		def svg() string {
			return new image.SVG().encode(self)
		}

		// The picture as a one-page PDF document (std.formats.docs.Pdf.encode
		// says what becomes vectors and what pixels).
		def pdf() byte[] {
			return new docs.Pdf().encode(self)
		}
	}

	// What `Picture.bounds` walks: the settings that move or narrow ink.
	internal struct InkState {
		t         Transform2D
		clip      ?Rect
		unbounded bool
	}

	// A group being walked: the box outside it, and what grows its own.
	internal struct InkGroup {
		outer   ?Rect
		effects Effect[]
		t       Transform2D
		bounds  ?Rect
	}

	internal def recordingBounds(ops DrawOp[], viewport Size) Rect {
		let st = InkState{t: new Transform2D(), clip: none, unbounded: false}
		let saved InkState[]
		let groups InkGroup[]
		let box ?Rect = none
		let page = viewport.width > 0 && viewport.height > 0 ?? (Rect{left: 0.0, top: 0.0, right: float(viewport.width), bottom: float(viewport.height)}, none)
		for let (_, op) in ops {
			let ink ?Rect = none
			match op {
				case render.DrawCommand:
					ink = commandBox(op, st, page)
				case SaveOp:
					saved.push(copyInk(st))
				case RestoreOp:
					st = saved.pop() when saved.len() > 0
				case SetStateOp:
					st = InkState{t: copyTransform(op.state.transform), clip: none, unbounded: clearsOutside(op.state.composite)}
				case TransformOp:
					st.t = op.replace ?? (copyTransform(op.t), st.t.then(op.t))
				case ClipPathOp:
					st.clip = meet(st.clip, op.path.transformed(st.t).bounds())
				case ClipRectOp:
					st.clip = meet(st.clip, rectUnder(op.rect, st.t))
				case CompositeOp:
					st.unbounded = clearsOutside(op.op)
				case FillOp:
					ink = op.path.transformed(st.t).bounds()
				case TextOp:
					ink = op.path.transformed(st.t).bounds()
				case FillRectOp:
					ink = rectUnder(op.rect, st.t)
				case StrokeOp:
					ink = strokeBox(op.path, op.strokeStyle, st.t)
				case ImageAtOp:
					let size = op.src.size()
					ink = rectUnder(Rect{left: op.at.x, top: op.at.y, right: op.at.x + float(size.width), bottom: op.at.y + float(size.height)}, st.t)
				case ImageOp:
					ink = rectUnder(op.dest, st.t)
				case AtlasOp:
					for let (i, s) in op.sources {
						let r = rectUnder(spriteRect(s), st.t.then(op.transforms[i]))
						ink = ink is Rect ?? (join(ink, r), r)
					}
				case WarpOp:
					let outline = warpOutline(op.mesh)
					ink = outline.verbs.len() > 0 ?? (outline.transformed(st.t).bounds(), none)
				case NineSliceOp:
					ink = rectUnder(op.dest, st.t)
				case BeginGroupOp:
					saved.push(copyInk(st))
					let limit ?Rect = none
					let given = op.bounds
					if given is Rect {
						limit = rectUnder(given, st.t)
					}
					groups.push(InkGroup{outer: box, effects: op.effects, t: copyTransform(st.t), bounds: limit})
					box = none
				case EndGroupOp:
					st = saved.pop() when saved.len() > 0
					if groups.len() > 0 {
						let g = groups.pop()
						let inner = box
						box = g.outer
						if inner is Rect {
							let m = effectReach(g.effects, g.t)
							let grown ?Rect = Rect{left: inner.left - m, top: inner.top - m, right: inner.right + m, bottom: inner.bottom + m}
							let limit = g.bounds
							if limit is Rect {
								grown = meet(grown, limit)
							}
							ink = grown
						}
					}
				default:
			}
			if ink is Rect {
				let area Rect = ink
				let clip = st.clip
				if st.unbounded && !(op is BeginGroupOp) {
					if clip is Rect {
						area = clip
					} else if page is Rect {
						area = page
					}
				}
				let kept ?Rect = area
				if clip is Rect {
					kept = meet(area, clip)
				}
				if kept is Rect {
					box = join(box, kept)
				}
			}
		}
		return box is Rect ?? (box, Rect{left: 0.0, top: 0.0, right: 0.0, bottom: 0.0})
	}

	// What `Picture.hitTest` walks: where user space lies, whether the
	// point is inside every clip so far, and the tag in force.
	internal struct HitState {
		t      Transform2D
		inside bool
		tag    ?int
	}

	internal def recordingHit(ops DrawOp[], p Point) ?int {
		let st = HitState{t: new Transform2D(), inside: true, tag: none}
		let saved HitState[]
		let found ?int = none
		for let (_, op) in ops {
			let hit = false
			match op {
				case render.DrawCommand:
					let box = commandBox(op, InkState{t: st.t, clip: none, unbounded: false}, none)
					hit = box is Rect && inRect(box, p)
				case SaveOp:
					saved.push(copyHit(st))
				case RestoreOp:
					st = saved.pop() when saved.len() > 0
				case SetStateOp:
					st = HitState{t: copyTransform(op.state.transform), inside: true, tag: op.state.tag}
				case TransformOp:
					st.t = op.replace ?? (copyTransform(op.t), st.t.then(op.t))
				case ClipPathOp:
					st.inside = st.inside && op.path.transformed(st.t).contains(p, op.rule)
				case ClipRectOp:
					st.inside = st.inside && new Path().rect(op.rect).transformed(st.t).contains(p)
				case ClipMaskOp:
					st.inside = st.inside && op.mask.coverage(int(p.x.floor()), int(p.y.floor())) > 0.0
				case TagOp:
					st.tag = op.id
				case FillOp:
					hit = op.path.transformed(st.t).contains(p, op.rule)
				case TextOp:
					hit = op.path.transformed(st.t).contains(p)
				case FillRectOp:
					hit = new Path().rect(op.rect).transformed(st.t).contains(p)
				case StrokeOp:
					hit = strokeHit(op.path, op.strokeStyle, st.t, p)
				case ImageAtOp:
					let size = op.src.size()
					hit = new Path().rect(Rect{left: op.at.x, top: op.at.y, right: op.at.x + float(size.width), bottom: op.at.y + float(size.height)}).transformed(st.t).contains(p)
				case ImageOp:
					hit = new Path().rect(op.dest).transformed(st.t).contains(p)
				case AtlasOp:
					for let (i, s) in op.sources {
						hit = true when new Path().rect(spriteRect(s)).transformed(st.t.then(op.transforms[i])).contains(p)
					}
				case WarpOp:
					hit = warpOutline(op.mesh).transformed(st.t).contains(p)
				case NineSliceOp:
					hit = new Path().rect(op.dest).transformed(st.t).contains(p)
				case BeginGroupOp:
					saved.push(copyHit(st))
					let given = op.bounds
					if given is Rect {
						st.inside = st.inside && new Path().rect(given).transformed(st.t).contains(p)
					}
				case EndGroupOp:
					st = saved.pop() when saved.len() > 0
				default:
			}
			let tag = st.tag
			if hit && st.inside && tag is int {
				found = tag
			}
		}
		return found
	}

	// A sprite's box in its own space: its top left corner at the origin.
	internal def spriteRect(source Rect) Rect {
		return Rect{left: 0.0, top: 0.0, right: source.right - source.left, bottom: source.bottom - source.top}
	}

	internal def copyHit(st HitState) HitState {
		return HitState{t: copyTransform(st.t), inside: st.inside, tag: st.tag}
	}

	internal def inRect(r Rect, p Point) bool {
		return p.x >= r.left && p.x < r.right && p.y >= r.top && p.y < r.bottom
	}

	// Whether the device point is inside the stroke Canvas.stroke would
	// build; paths whose box, grown by the widest join, misses the point
	// are not stroked.
	internal def strokeHit(path Path, strokeStyle StrokeStyle, t Transform2D, p Point) bool {
		let dev = path.transformed(t)
		let b = dev.bounds()
		let half = float(strokeStyle.width) * 0.5 * strokeStyle.miterLimit.max(1.5)
		let reach = strokeStyle.fixedWidth ?? (half, half * maxScale(t))
		+1.0
		return false when p.x < b.left - reach || p.x > b.right + reach || p.y < b.top - reach || p.y > b.bottom + reach
		return dev.stroked(strokeStyle).contains(p) when strokeStyle.fixedWidth
		return path.stroked(strokeStyle, 0.1 / maxScale(t)).transformed(t).contains(p)
	}

	internal def copyInk(st InkState) InkState {
		return InkState{t: copyTransform(st.t), clip: st.clip, unbounded: st.unbounded}
	}

	// Whether the operator also clears the destination outside its shape.
	internal def clearsOutside(op Composite) bool {
		return op := Composite.SourceIn || Composite.SourceOut || Composite.DestinationIn || Composite.DestinationAtop || Composite.Copy
	}

	// A recorded command's box, in device pixels.
	internal def commandBox(cmd render.DrawCommand, st InkState, page ?Rect) ?Rect {
		match cmd.kind {
			case render.CommandKind.Clear:
				return st.clip is Rect ?? (st.clip, page)
			case render.CommandKind.FillRect, render.CommandKind.Video:
				return cmd.rect
			case render.CommandKind.Blit, render.CommandKind.BlitCopy, render.CommandKind.BlitRGBAtoBGRA:
				return Rect{left: float(cmd.x), top: float(cmd.y), right: float(cmd.x + cmd.srcW), bottom: float(cmd.y + cmd.srcH)}
			default:
				return none
		}
	}

	// The device box of the path's stroke, built as Canvas.stroke builds it.
	internal def strokeBox(path Path, strokeStyle StrokeStyle, t Transform2D) Rect {
		return path.transformed(t).stroked(strokeStyle).bounds() when strokeStyle.fixedWidth
		return path.stroked(strokeStyle, 0.1 / maxScale(t)).transformed(t).bounds()
	}

	// How far past a group's pixels its effects reach, as closeGroup
	// measures it.
	internal def effectReach(effects Effect[], t Transform2D) float {
		let s = maxScale(t)
		let margin = 0.0
		for let (_, e) in effects {
			match e {
				case DropShadow:
					let ox = t.a * e.offset.x + t.c * e.offset.y
					let oy = t.b * e.offset.x + t.d * e.offset.y
					margin += sqrt(ox * ox + oy * oy) + 1.5 * float(e.blur) * s + float(e.spread).max(0.0) * s
				case OuterGlow:
					margin += 1.5 * float(e.blur) * s + float(e.spread).max(0.0) * s
				case Blur:
					margin += 3.0 * float(e.radius) * s when !e.backdrop
				case Outline:
					margin += float(e.width) * s when e.position != OutlinePosition.Inside
				default:
			}
		}
		return margin
	}

	// The device box of the rectangle's corners under `t`.
	internal def rectUnder(r Rect, t Transform2D) Rect {
		let xs = [t.a * r.left + t.c * r.top, t.a * r.right + t.c * r.top, t.a * r.left + t.c * r.bottom, t.a * r.right + t.c * r.bottom]
		let ys = [t.b * r.left + t.d * r.top, t.b * r.right + t.d * r.top, t.b * r.left + t.d * r.bottom, t.b * r.right + t.d * r.bottom]
		let out = Rect{left: xs[0], top: ys[0], right: xs[0], bottom: ys[0]}
		for let i = 1; i < 4; i++ {
			out = Rect{left: out.left.min(xs[i]), top: out.top.min(ys[i]), right: out.right.max(xs[i]), bottom: out.bottom.max(ys[i])}
		}
		return Rect{left: out.left + t.tx, top: out.top + t.ty, right: out.right + t.tx, bottom: out.bottom + t.ty}
	}

	// The smallest box holding both.
	internal def join(a ?Rect, b Rect) Rect {
		return b when a is none
		return Rect{left: a.left.min(b.left), top: a.top.min(b.top), right: a.right.max(b.right), bottom: a.bottom.max(b.bottom)}
	}

	// Their overlap, none when they miss.
	internal def meet(a ?Rect, b Rect) ?Rect {
		return b when a is none
		let r = Rect{left: a.left.max(b.left), top: a.top.max(b.top), right: a.right.min(b.right), bottom: a.bottom.min(b.bottom)}
		return none when r.left >= r.right || r.top >= r.bottom
		return r
	}

	// Records what `draw` does to a painter as a Picture.
	def record(draw def(Painter)) Picture {
		let ctx = new DrawContext()
		draw(ctx)
		return new Picture(ctx)
	}
}
