partial module std.gfx.canvas {
	use (
		std.testing
		std.formats.fonts
		std.os
		std.gfx.color::(BlendMode, Color, RGBA)
		std.math::Pi
		std.math.geom::(Circle, FillRule, Line, Path, Point, Rect, Size, StrokeStyle, Vec2)
		std.units::(Percent, Pixels)
	)

	check "Painter" {
		def textScene(p Painter) !none {
			let data = try os.readFile("samples/fonts/ttf/SourceSansPro-Black.ttf")
			let face = try (try fonts.load(data)).face(0)
			let s = TextStyle{face: face, size: 18(px)}
			p.scale(1.5, 1.5)
			p.fillText("Ag", new Point(4.0, 20.0), s, rgba(10, 10, 120, 255))
			p.strokeText("Ag", new Point(30.0, 20.0), s, rgba(200, 0, 0, 255))
			p.fillText("wave", new Path().moveTo(2.0, 40.0).quadTo(30.0, 20.0, 60.0, 40.0), s, rgba(0, 120, 0, 255))
			assert p.measureText("Ag", s).advance > 0.0 && p.textPath("Ag", new Point(0.0, 0.0), s).bounds().right > 0.0
		}

		def rgba(r int, g int, b int, a int) Color {
			return new Color(RGBA{r: byte(r), g: byte(g), b: byte(b), a: byte(a)})
		}

		// The tag Picture.hitTest names at (x, y), 0 for none.
		def hit(pic Picture, x float, y float) int {
			let t = pic.hitTest(new Point(x, y))
			if t is int {
				return t
			}
			return 0
		}

		def tagOf(st DrawState) int {
			let t = st.tag
			if t is int {
				return t
			}
			return 0
		}

		// One scene through the whole API, for any painter.
		def scene(p Painter) {
			p.clear(rgba(250, 250, 240, 255))
			p.save()
			p.translate(8.0, 6.0)
			p.rotate(Pi / 16.0, new Point(40.0, 30.0))
			p.clip(new Path().circle(new Point(40.0, 30.0), 28.0))
			p.fill(Rect{left: 0.0, top: 0.0, right: 80.0, bottom: 60.0}, linear(new Point(0.0, 0.0), new Point(80.0, 0.0), [rgba(255, 0, 0, 255), rgba(0, 0, 255, 255)]))
			p.setAlpha(60(%))
			p.stroke(new Line(new Point(5.0, 55.0), new Point(75.0, 5.0)), rgba(0, 128, 0, 255), StrokeStyle{width: 3(px)})
			p.restore()
			let img = new Canvas(4, 4)
			img.fill(Rect{left: 0.0, top: 0.0, right: 4.0, bottom: 4.0}, rgba(20, 200, 20, 255))
			p.drawImage(img, Rect{left: 70.0, top: 50.0, right: 90.0, bottom: 70.0}, Sampling.Nearest)
			p.beginGroup(effects = [DropShadow{offset:new Vec2(2.0, 2.0), blur:2(px)}])
			p.fill(new Circle(new Point(20.0, 60.0), 8.0), rgba(255, 200, 0, 255))
			p.endGroup()
			p.setComposite(Composite.DestinationOut)
			p.fill(Rect{left: 0.0, top: 0.0, right: 6.0, bottom: 6.0}, rgba(0, 0, 0, 255))
		}

		@test()
		def picturesNameWhatIsUnderAPoint() {
			let pic = record((p Painter) => {
				p.fill(Rect{left: 0.0, top: 0.0, right: 100.0, bottom: 100.0}, rgba(240, 240, 240, 255))
				p.save()
				p.tag(1)
				p.fill(Rect{left: 10.0, top: 10.0, right: 50.0, bottom: 50.0}, rgba(255, 0, 0, 255))
				p.tag(2)
				p.translate(30.0, 30.0)
				p.fill(new Circle(new Point(0.0, 0.0), 10.0), rgba(0, 0, 255, 255))
				p.restore()
				// Untagged after restore: covers tag 1 without hiding it.
				p.fill(Rect{left: 10.0, top: 10.0, right: 20.0, bottom: 20.0}, rgba(0, 0, 0, 255))
				p.save()
				p.tag(3)
				p.stroke(new Line(new Point(60.0, 80.0), new Point(95.0, 80.0)), rgba(0, 0, 0, 255), StrokeStyle{width: 4(px)})
				p.clip(Rect{left: 60.0, top: 0.0, right: 80.0, bottom: 40.0})
				p.tag(4)
				p.fill(Rect{left: 60.0, top: 0.0, right: 100.0, bottom: 40.0}, rgba(0, 255, 0, 255))
				p.restore()
				p.beginGroup(bounds = Rect{left: 0.0, top: 60.0, right: 20.0, bottom: 100.0})
				p.tag(5)
				p.fill(Rect{left: 0.0, top: 60.0, right: 40.0, bottom: 100.0}, rgba(0, 0, 0, 255))
				p.endGroup()
			})
			assert hit(pic, 15.0, 40.0) == 1 && hit(pic, 12.0, 12.0) == 1
			assert hit(pic, 30.0, 30.0) == 2 && hit(pic, 38.0, 38.0) == 1
			assert hit(pic, 5.0, 5.0) == 0
			assert hit(pic, 70.0, 81.5) == 3 && hit(pic, 70.0, 83.0) == 0
			assert hit(pic, 70.0, 20.0) == 4 && hit(pic, 90.0, 20.0) == 0
			assert hit(pic, 10.0, 80.0) == 5 && hit(pic, 30.0, 80.0) == 0
			// A canvas keeps the tag in its state and draws the same.
			let cv = new Canvas(4, 4)
			cv.tag(7)
			assert tagOf(cv.state()) == 7
			cv.save()
			cv.tag(8)
			cv.restore()
			assert tagOf(cv.state()) == 7
		}

		@test()
		def recordingsReplayExactly() {
			let direct = new Canvas(100, 80)
			scene(direct)
			let ctx = new DrawContext(new Size(100.0, 80.0))
			scene(ctx)
			let replayed = new Canvas(100, 80)
			replayed.apply(ctx)
			assert canvasChecksum(replayed) == canvasChecksum(direct)
			// A recording of a recording replays the same.
			let copy = new DrawContext()
			ctx.replay(copy)
			let twice = new Canvas(100, 80)
			twice.apply(copy)
			assert canvasChecksum(twice) == canvasChecksum(direct)
			assert !ctx.commandsOnly()
		}

		@test()
		def textRecordsAndReplays() !none {
			let direct = new Canvas(100, 70)
			try textScene(direct)
			let ctx = new DrawContext()
			try textScene(ctx)
			let out = new Canvas(100, 70)
			out.apply(ctx)
			assert canvasChecksum(out) == canvasChecksum(direct) && !ctx.commandsOnly()
		}

		@test()
		def boundsCoverWhatAReplayPaints() {
			let same = (a Rect, l float, t float, r float, b float) => (a.left - l).abs() < 1e-6 && (a.top - t).abs() < 1e-6 && (a.right - r).abs() < 1e-6 && (a.bottom - b).abs() < 1e-6
			assert same(new DrawContext().bounds(), 0.0, 0.0, 0.0, 0.0)
			// Through the transform.
			let moved = new DrawContext()
			moved.translate(10.0, 20.0)
			moved.scale(2.0, 3.0)
			moved.fill(Rect{left: 1.0, top: 1.0, right: 4.0, bottom: 2.0}, rgba(0, 0, 0, 255))
			assert same(moved.bounds(), 12.0, 23.0, 18.0, 26.0)
			// A stroke reaches half its width past the line; butt caps add nothing.
			let line = new DrawContext()
			line.stroke(new Line(new Point(10.0, 50.0), new Point(90.0, 50.0)), rgba(0, 0, 0, 255), StrokeStyle{width: 10(px)})
			assert same(line.bounds(), 10.0, 45.0, 90.0, 55.0)
			// A clip narrows everything after it, until restore.
			let clipped = new DrawContext()
			clipped.save()
			clipped.clip(Rect{left: 0.0, top: 0.0, right: 30.0, bottom: 30.0})
			clipped.fill(new Circle(new Point(30.0, 30.0), 20.0), rgba(0, 0, 0, 255))
			clipped.restore()
			clipped.fill(Rect{left: 50.0, top: 50.0, right: 60.0, bottom: 61.0}, rgba(0, 0, 0, 255))
			assert same(clipped.bounds(), 10.0, 10.0, 60.0, 61.0)
			// A group grows by how far its effects reach.
			let shadowed = new DrawContext()
			shadowed.beginGroup(effects = [DropShadow{offset:new Vec2(6.0, 8.0), blur:0(px)}])
			shadowed.fill(Rect{left: 20.0, top: 20.0, right: 40.0, bottom: 40.0}, rgba(0, 0, 0, 255))
			shadowed.endGroup()
			assert same(shadowed.bounds(), 10.0, 10.0, 50.0, 50.0)
			// A clear is the whole viewport; a picture reports its recording's box.
			let cleared = new DrawContext(new Size(64, 48))
			cleared.clear(rgba(255, 255, 255, 255))
			assert same(cleared.bounds(), 0.0, 0.0, 64.0, 48.0)
			let pb = record(scene).bounds()
			assert pb.right > pb.left && pb.bottom > pb.top
		}

		@test()
		def picturesRecordAndReplay() {
			let direct = new Canvas(100, 80)
			scene(direct)
			let pic = record(scene)
			let out = new Canvas(100, 80)
			pic.replay(out)
			assert canvasChecksum(out) == canvasChecksum(direct)
		}

		@test()
		def plainRectanglesStayRenderCommands() {
			let ctx = new DrawContext()
			ctx.clear(rgba(0, 0, 0, 255))
			ctx.fill(Rect{left: 1.0, top: 2.0, right: 5.0, bottom: 6.0}, rgba(255, 0, 0, 255))
			assert ctx.commandsOnly() && ctx.commands().len() == 2
			ctx.fill(Rect{left: 1.5, top: 2.0, right: 5.0, bottom: 6.0}, rgba(255, 0, 0, 255))
			assert !ctx.commandsOnly() && ctx.commands().len() == 2
			ctx.reset()
			assert ctx.commandsOnly() && ctx.commands().len() == 0
		}

		@test()
		def recordingsKeepTheSettings() {
			let ctx = new DrawContext()
			ctx.translate(10.0, 0.0)
			ctx.save()
			ctx.scale(2.0, 2.0)
			ctx.setAlpha(0.5)
			assert ctx.state().transform.a == 2.0 && ctx.state().alpha == 0.5
			ctx.restore()
			assert ctx.state().transform.a == 1.0 && ctx.state().transform.tx == 10.0 && ctx.state().alpha == 1.0
			let square = new Path().rect(Rect{left: 0.0, top: 0.0, right: 5.0, bottom: 5.0})
			assert ctx.isInPath(square, new Point(12.0, 2.0)) && !ctx.isInPath(square, new Point(2.0, 2.0))
			assert ctx.isInStroke(square, new Point(10.0, 2.0), StrokeStyle{width: 2(px)})
		}
	}
}
