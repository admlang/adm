partial module std.gfx.canvas {
	use (
		std.math.geom::(LineCap, Path, Point, Rect, Size, StrokeStyle)
		std.text.unicode
		std.text.unicode::(Bidi, Direction, LineBreak, lineBreaks)
		std.units::Pixels
	)

	// TextSpan is a piece of a paragraph in one style and paint.
	struct TextSpan {
		text       string
		textStyle  TextStyle
		paint      Paint
		// Painted behind the span's text, as high as its line: a selection, a
		// search hit.
		background ?Paint          = none
		// Lines drawn with the span's text.
		decoration ?TextDecoration = none
		// How far the span is raised from the baseline; below 0 lowered.
		shift      float
	}

	// The shape of a decoration line.
	enum DecorationLine {
		Solid,
		Double,
		Dotted,
		Dashed,
		// The squiggle under a spelling mistake or a compile error.
		Wavy,
	}

	// Lines drawn with a span's text: under it, over it, through it.
	struct TextDecoration {
		underline      bool
		overline       bool
		strikethrough  bool
		line           DecorationLine = DecorationLine.Solid
		// none: the span's paint.
		paint          ?Paint         = none
		// 0: the face's underline thickness.
		thickness      float
		// An underline leaves gaps where glyphs reach down through it.
		skipDescenders bool           = true
	}

	// How the lines of a paragraph are set.
	struct ParagraphStyle {
		// Where each line sits in the width. Start and End follow the direction of the
		// paragraph the line is in (the text up to a hard break).
		align       TextAlign  = TextAlign.Start
		// Whether a line that wrapping ended fills the width, the room shared out at its
		// spaces between words, or between its characters when it has none. The last
		// line of each paragraph keeps `align`.
		justify     bool
		// The distance between baselines, a multiple of each line's largest size.
		lineHeight  float      = 1.2
		// The direction of every paragraph; none: each takes its first strong
		// character's, left to right when it has none (UAX #9 P2-P3).
		direction   ?Direction = none
		// How far the first line of each paragraph, and every line that continues a
		// wrapped one, starts in from the start side.
		indent      float
		wrapIndent  float
		// Added after each space between words.
		wordSpacing float
		// The distance between tab stops, in widths of a space of the tab's span.
		tabSize     float      = 8.0
		// The most lines kept; none: all of them.
		maxLines    ?int       = none
		// Put at the end of the last line kept when lines were left out ("…"); empty:
		// the lines are only cut.
		ellipsis    string
		// Lines of similar length: the narrowest width that gives as many lines.
		balanced    bool
	}

	// TextLine is one laid out line of a paragraph, in the paragraph's
	// space: (0, 0) is its top left corner, y grows down.
	struct TextLine {
		// The line's glyphs in visual order, each `cluster` a byte index
		// into the paragraph's text (its spans joined).
		glyphs      GlyphBox[]
		// The y of the line's alphabetic baseline.
		baseline    float
		// The line box: from `top` to `bottom`, the leading included.
		top         float
		bottom      float
		// Where the line starts after alignment, and how wide it is
		// without the spaces that end it.
		left        float
		width       float
		// The characters the line holds, as `string.slice` counts them in
		// the paragraph's text: start included, end excluded.
		start       int
		end         int
		// The direction of the paragraph the line is in.
		rightToLeft bool
	}

	// A run of one span's text on one line, shaped in one direction: drawn at
	// (x, y), y its baseline.
	internal struct ParagraphRun {
		line        int
		span        int
		text        string
		x           float
		y           float
		rightToLeft bool
		// How far it reaches across, the room after it included.
		width       float
		// Its first glyph in its line's glyphs, and one past its last.
		glyphFrom   int
		glyphTo     int
		// The script it was shaped in, which drawing shapes it in again.
		script      string
	}

	// Paragraph is text set in lines within a width: spans of different
	// styles share each line's baseline, lines wrap where Unicode allows a
	// break (UAX #14) and always after a newline, and a word wider than the
	// line is split between glyph clusters. Text of both directions is set
	// by the Unicode Bidirectional Algorithm (UAX #9): each line in visual
	// order, every run shaped in its own direction. Each line is as tall as
	// its tallest span's size times `lineHeight` (the leading split above
	// and below, as CSS does). Spaces that end a line hang past it; a line
	// that breaks at a soft hyphen shows a hyphen. The spans' `align`,
	// `baseline`, `orientation` and `direction` are not used: the style's
	// `align` places every line within `width`. A width of 0 or less never
	// wraps.
	type Paragraph {
		internal spans    TextSpan[]
		internal settings ParagraphStyle
		internal runs     ParagraphRun[]
		internal rows     TextLine[]
		internal box      Size
		internal cut      bool
		// The widest line with its indent.
		internal natural  float
		// The text shaped, shared by every width it is set in.
		internal shaped   ShapedText
		// The width the lines are set in, and whether they are yet: they are
		// set the first time anything asks for them.
		internal width    float
		internal laid     bool

		def new(spans TextSpan[], width float, align = TextAlign.Start, lineHeight float = 1.2) {
			self.spans = spans
			settings = ParagraphStyle{align: align, lineHeight: lineHeight}
			shaped = new ShapedText(spans, settings)
			self.width = width
		}

		def new(spans TextSpan[], width float, settings ParagraphStyle) {
			self.spans = spans
			self.settings = settings
			shaped = new ShapedText(spans, settings)
			self.width = width
		}

		internal def new(text Paragraph, width float) {
			spans = text.spans
			settings = text.settings
			shaped = text.shaped
			self.width = width
		}

		// Sets the lines the first time they are asked for; a paragraph whose
		// lines nothing reads (one only measured for its first baseline) never
		// places a glyph.
		internal atomic def setLines() {
			return when laid
			layoutParagraph(self, width)
			laid = true
		}

		// The same text and settings set in lines no wider than `width` (0 or
		// less never wraps), without shaping the text again: a text laid out at
		// several widths is shaped once, and each width only breaks and places
		// its lines.
		def withWidth(width float) Paragraph {
			return new Paragraph(self, width)
		}

		// The lines, top to bottom: those `maxLines` keeps.
		def lines() TextLine[] {
			setLines()
			return rows
		}

		// Whether `maxLines` left lines out.
		def truncated() bool {
			setLines()
			return cut
		}

		// The size the lines take: `width` wide (the widest line when the
		// paragraph does not wrap), as tall as all lines.
		def size() Size {
			setLines()
			return box
		}

		// The width of the widest line with its indent, wherever alignment puts it:
		// how wide the text is, as opposed to the width it was set in.
		def contentWidth() float {
			setLines()
			return natural
		}

		// The baseline of the first line from the paragraph's top, as `lines()`
		// has it; none for no text. Found from the faces' metrics and where the
		// first line ends, without placing a glyph.
		def firstBaseline() ?float {
			return firstBaselineOf(self)
		}

		// The least width at which no word of it is split between two lines: that
		// of its widest stretch between two places a line may break, without the
		// spaces that end it. 0 for no text.
		def narrowest() float {
			return widestUnit(self)
		}
	}

	// Draws the paragraph with its top left corner at `at`: the spans'
	// backgrounds, each run as text in its span's style and paint, shaped in
	// the run's direction, then the decoration lines over the text. With
	// `run`, a run's text goes to it with the box of its glyphs' outlines
	// instead of to `p.fillText` (a recording keeps the box).
	internal def drawParagraph(p Painter, para Paragraph, at Point, run ?def(text string, anchor Point, textStyle TextStyle, paint Paint, box ?Rect) = none) {
		para.lines()
		for let (_, r) in para.runs {
			let back = para.spans[r.span].background
			continue when back is none
			let line = para.rows[r.line]
			p.fill(Rect{left: at.x + r.x, top: at.y + line.top, right: at.x + r.x + r.width, bottom: at.y + line.bottom}, back)
		}
		for let (_, r) in para.runs {
			let sp = para.spans[r.span]
			let anchor = new Point(at.x + r.x, at.y + r.y)
			if run is none {
				p.fillText(r.text, anchor, flatStyle(sp.textStyle, r.rightToLeft, r.script), sp.paint)
			} else {
				run(r.text, anchor, flatStyle(sp.textStyle, r.rightToLeft, r.script), sp.paint, glyphsBox(para, r, at))
			}
		}
		for let (_, r) in para.runs {
			let sp = para.spans[r.span]
			let marks = sp.decoration
			continue when marks is none || r.text == ""
			decorate(p, para, r, sp, marks, at)
		}
	}

	// The box that holds the outlines of run `r`'s glyphs, the paragraph's top left corner
	// at `at`; none for a run without glyphs.
	internal def glyphsBox(para Paragraph, r ParagraphRun, at Point) ?Rect {
		let glyphs = para.rows[r.line].glyphs
		let box ?Rect = none
		for let g = r.glyphFrom; g < r.glyphTo && g < glyphs.len(); g++ {
			let b = glyphs[g].bounds
			continue when b.right <= b.left || b.bottom <= b.top
			let moved = Rect{left: at.x + b.left, top: at.y + b.top, right: at.x + b.right, bottom: at.y + b.bottom}
			box = box is none ?? (moved, Rect{left: box.left.min(moved.left), top: box.top.min(moved.top), right: box.right.max(moved.right), bottom: box.bottom.max(moved.bottom)})
		}
		return box
	}

	// The decoration lines of run `r`: positions and thickness from its face
	// (`post` underline, half the x-height for a strikethrough as CSS has it
	// when a face says nothing, the ascent for an overline).
	internal def decorate(p Painter, para Paragraph, r ParagraphRun, sp TextSpan, marks TextDecoration, at Point) {
		let face = sp.textStyle.face
		let size = textSize(sp.textStyle)
		let m = face.metrics()
		let unit = size / float(face.info().unitsPerEm).max(1.0)
		let thick = marks.thickness > 0.0 ?? (marks.thickness, (float(m.underlineThickness) * unit).max(1.0))
		let paint = sp.paint
		let own = marks.paint
		paint = own unless own is none
		let (left, right) = (at.x + r.x, at.x + r.x + r.width)
		let base = at.y + r.y
		if marks.underline {
			let under = m.underlinePosition != 0 ?? (-float(m.underlinePosition) * unit, size * 0.1)
			let y = base + under
			let gaps float[]
			if marks.skipDescenders {
				let glyphs = para.rows[r.line].glyphs
				for let g = r.glyphFrom; g < r.glyphTo && g < glyphs.len(); g++ {
					let b = glyphs[g].bounds
					if b.bottom + at.y > y - thick && b.right > b.left {
						gaps.push(at.x + b.left - thick)
						gaps.push(at.x + b.right + thick)
					}
				}
			}
			decorationLine(p, left, right, y, thick, marks.line, paint, gaps)
		}
		decorationLine(p, left, right, base - float(m.ascent) * unit + thick / 2.0, thick, marks.line, paint, []) when marks.overline
		if marks.strikethrough {
			let half = m.xHeight > 0 ?? (float(m.xHeight) * unit / 2.0, float(m.ascent) * unit * 0.3)
			decorationLine(p, left, right, base - half, thick, marks.line, paint, [])
		}
	}

	// One decoration line from `left` to `right`, centred on `y`, leaving out
	// the stretches between each pair of `gaps`.
	internal def decorationLine(p Painter, left float, right float, y float, thick float, line DecorationLine, paint Paint, gaps float[]) {
		let pieces float[] = [left]
		for let i = 0; i + 1 < gaps.len(); i += 2 {
			let (from, to) = (gaps[i].max(left), gaps[i + 1].min(right))
			continue when to <= from
			pieces.push(from)
			pieces.push(to)
		}
		pieces.push(right)
		for let i = 0; i + 1 < pieces.len(); i += 2 {
			let (a, b) = (pieces[i], pieces[i + 1])
			continue when b - a <= 0.0
			match line {
				case DecorationLine.Double:
					p.fill(Rect{left: a, top: y - thick * 1.5, right: b, bottom: y - thick * 0.5}, paint)
					p.fill(Rect{left: a, top: y + thick * 0.5, right: b, bottom: y + thick * 1.5}, paint)
				case DecorationLine.Dotted:
					let step = thick * 2.0
					for let x = a; x + thick <= b; x += step {
						p.fill(Rect{left: x, top: y - thick / 2.0, right: x + thick, bottom: y + thick / 2.0}, paint)
					}
				case DecorationLine.Dashed:
					let step = thick * 5.0
					for let x = a; x < b; x += step {
						p.fill(Rect{left: x, top: y - thick / 2.0, right: (x + thick * 3.0).min(b), bottom: y + thick / 2.0}, paint)
					}
				case DecorationLine.Wavy:
					// Half waves of four thicknesses, as high as three.
					let wave = new Path()
					let half = thick * 2.0
					let rise = thick * 1.5
					wave.moveTo(a, y)
					let up = true
					for let x = a; x < b; x += half {
						let end = (x + half).min(b)
						wave.quadTo((x + end) / 2.0, up ?? (y - rise * 2.0, y + rise * 2.0), end, y)
						up = !up
					}
					p.stroke(wave, paint, StrokeStyle{width: thick * 1(px), cap: LineCap.Butt})
				default:
					p.fill(Rect{left: a, top: y - thick / 2.0, right: b, bottom: y + thick / 2.0}, paint)
			}
		}
	}

	// The paragraph's text and, per character, its span and byte offset.
	internal struct ParagraphText {
		text   string
		chars  char[]
		span   int[]
		// Byte offset of each character, and one past the last.
		offset int[]
		// The bidi levels of the characters, resolved; empty when the text holds
		// nothing right to left and no direction asks for it: every level 0.
		levels int[]
		bidi   ?Bidi
	}

	internal def joinSpans(spans TextSpan[], direction ?Direction) ParagraphText {
		let t = ParagraphText{text: "", chars: char[], span: int[], offset: int[], levels: int[], bidi: none}
		let at = 0
		// Below U+0590 no character is right to left or an explicit embedding.
		let mixed = !(direction is none) && direction == Direction.RightToLeft
		for let (si, sp) in spans {
			t.text += sp.text
			for let (_, ch) in sp.text {
				t.chars.push(ch)
				t.span.push(si)
				t.offset.push(at)
				let cp = int(ch)
				mixed = true when cp >= 0x0590
				at += cp < 0x80 ?? (1, cp < 0x800 ?? (2, cp < 0x10000 ?? (3, 4)))
			}
		}
		t.offset.push(at)
		if mixed && t.chars.len() > 0 {
			let bidi = new Bidi(t.text, direction)
			t.levels = bidi.levels()
			t.bidi = bidi
		}
		return t
	}

	// A character that ends a line by itself (Line_Break BK, CR, LF, NL).
	internal def hardBreak(ch char) bool {
		let cp = int(ch)
		return cp := 0x0A || 0x0B || 0x0C || 0x0D || 0x85 || 0x2028 || 0x2029
	}

	// A character that hangs at the end of a line: spaces and hard breaks.
	internal def hangs(ch char) bool {
		let cp = int(ch)
		return (cp := 0x20 || 0x09 || 0x3000 || 0x1680) || hardBreak(ch) || (cp >= 0x2000 && cp <= 0x200A && cp != 0x2007)
	}

	// A word separator, after which `wordSpacing` and justification add room
	// (CSS Text 3 §7.1).
	internal def wordSpace(ch char) bool {
		return int(ch) := 0x20 || 0xA0 || 0x1361 || 0x10100 || 0x10101 || 0x1039F || 0x1091F
	}

	internal def isTab(ch char) bool {
		return int(ch) == 0x09
	}

	// The style a paragraph shapes a span with: from the pen, on the
	// alphabetic baseline, in the given direction and in `script` (its item's,
	// `scriptAt`) unless the span's style names one.
	internal def flatStyle(s TextStyle, rightToLeft bool, script string = "") TextStyle {
		let direction = rightToLeft ?? (Direction.RightToLeft, Direction.LeftToRight)
		let shapedIn = s.script == "" ?? (script, s.script)
		return TextStyle{face: s.face, size: s.size, spacing: s.spacing, hinting: s.hinting, rootSize: s.rootSize, script: shapedIn, direction: direction, features: s.features}
	}

	// The script of the first character from..to that belongs to one, as the
	// shaper guesses it; "" when none does (digits, punctuation, spaces).
	internal def firstScript(t ParagraphText, from int, to int) string {
		for let k = from; k < to; k++ {
			let found = unicode.script(t.chars[k])
			return found unless found := "Zyyy" || "Zinh" || "Zzzz"
		}
		return ""
	}

	// The script character k's item is shaped in; "" for a tab or a hard break.
	internal def scriptAt(p Paragraph, k int) string {
		let s = p.shaped
		return "" when k < 0 || k >= s.itemOf.len() || s.itemOf[k] < 0
		return s.items[s.itemOf[k]].script
	}

	// One stretch of a paragraph's text in one span and one direction, with no
	// tab or hard break in it, shaped whole once. A line takes a slice of its
	// glyphs where the shaper says the text may be cut there.
	internal struct ShapedItem {
		span   int
		start  int
		end    int
		level  int
		// The script every piece of it is shaped in.
		script string
		layout TextLayout
		// Where the pen is before each glyph (its offset not added): the x a
		// slice that starts with it is moved back by.
		pens   float[]
		// The character each glyph's cluster starts at: increasing for a run
		// shaped left to right, decreasing for one shaped right to left.
		chars  int[]
		// The letter spacing after each glyph but the last.
		gap    float
	}

	// The part of a paragraph its width does not change: the text joined, the
	// places a line may end, and every item shaped once. Each width the text is
	// set in (`Paragraph.withWidth`) shares it, so setting lines is arithmetic
	// over its advances; only a line that starts or ends where the shaper says
	// the text may not be cut has that end shaped again.
	internal type ShapedText {
		t      ParagraphText
		breaks LineBreak[]
		items  ShapedItem[]
		// Per character, its item; -1 for a tab or a hard break.
		itemOf int[]
		// What the characters before each one take on a line, word spacing
		// included and tabs and hard breaks counted 0, one entry past the last
		// character too: characters a..b with no tab among them take pen[b] -
		// pen[a], less the letter spacing after the glyph that ends them.
		pen    float[]
		// The same without letter spacing, as the characters that hang at the
		// end of a line are measured.
		bare   float[]
		// Per character, and one past the last: whether a glyph cluster starts
		// there (or an item does, or the text ends), and whether the text may
		// also be cut there with both pieces shaped as the slices of their item.
		starts bool[]
		safe   bool[]
		tabs   int
		// The widest stretch between two places a line may end; below 0: not
		// measured yet.
		least  float         = -1.0

		def new(spans TextSpan[], settings ParagraphStyle) {
			t = joinSpans(spans, settings.direction)
			let n = t.chars.len()
			breaks = lineBreaks(t.text)
			let advance float[]
			let plain float[]
			advance.len(n + 1)
			plain.len(n + 1)
			advance.fill(0.0)
			plain.fill(0.0)
			starts.len(n + 1)
			safe.len(n + 1)
			starts.fill(false)
			safe.fill(false)
			let unsafe bool[]
			unsafe.len(n + 1)
			unsafe.fill(false)
			let k = 0
			for k < n {
				let ch = t.chars[k]
				if isTab(ch) || hardBreak(ch) {
					tabs += 1 when isTab(ch)
					itemOf.push(-1)
					starts[k] = true
					safe[k] = true
					k++
					continue
				}
				let si = t.span[k]
				let level = levelOf(t.levels, k)
				let e = k
				for e < n && t.span[e] == si && !hardBreak(t.chars[e]) && !isTab(t.chars[e]) && levelOf(t.levels, e) == level {
					e++
				}
				let item = shapeItem(spans[si].textStyle, t, si, k, e, level)
				let index = items.len()
				items.push(item)
				let glyphs = item.layout.glyphs
				// Letter spacing follows every glyph but the last in visual order.
				let last = glyphs.len() - 1
				for let (gi, g) in glyphs {
					let c = item.chars[gi]
					advance[c] += g.advance
					advance[c] += item.gap when gi != last
					plain[c] += g.advance
					starts[c] = true
					unsafe[c] = true when shapedUnsafe(item, gi)
				}
				for let i = k; i < e; i++ {
					itemOf.push(index)
					safe[i] = starts[i] && !unsafe[i]
				}
				starts[k] = true
				safe[k] = true
				k = e
			}
			starts[n] = true
			safe[n] = true
			// Prefix sums, word spacing after each word separator.
			let spacing = settings.wordSpacing
			pen.len(n + 1)
			bare.len(n + 1)
			let (sum, flat) = (0.0, 0.0)
			for let i = 0; i < n; i++ {
				pen[i] = sum
				bare[i] = flat
				let extra = (spacing != 0.0 && wordSpace(t.chars[i])) ?? (spacing, 0.0)
				sum += advance[i] + extra
				flat += plain[i] + extra
			}
			pen[n] = sum
			bare[n] = flat
		}
	}

	// The unsafe-to-break flag of glyph `gi` of an item, kept beside its layout.
	internal def shapedUnsafe(item ShapedItem, gi int) bool {
		return item.layout.unsafe.len() > gi && item.layout.unsafe[gi]
	}

	// Shapes characters start..end, one span's in one direction, as an item, in
	// the script of its first letter: every piece of it is shaped in that one,
	// so a piece without letters shapes as it does inside the item.
	internal def shapeItem(spanStyle TextStyle, t ParagraphText, si int, start int, end int, level int) ShapedItem {
		let script = spanStyle.script == "" ?? (firstScript(t, start, end), spanStyle.script)
		let flat = flatStyle(spanStyle, level % 2 == 1, script)
		let layout = layoutWords(t.text.slice(start, end), flat)
		let item = ShapedItem{span: si, start: start, end: end, level: level, script: script, layout: layout, pens: float[], chars: int[], gap: textSpacing(flat, layout.size)}
		let pen = 0.0
		let base = t.offset[start]
		let last = layout.glyphs.len() - 1
		for let (gi, g) in layout.glyphs {
			item.pens.push(pen)
			item.chars.push(charAtByte(t, start, end, base + g.cluster))
			pen += g.advance
			pen += item.gap when gi < last
		}
		return item
	}

	// The character whose bytes hold byte `at`, among characters from..to.
	internal def charAtByte(t ParagraphText, from int, to int, at int) int {
		let (low, high) = (from, to - 1)
		for low < high {
			let mid = (low + high + 1) / 2
			if t.offset[mid] <= at {
				low = mid
			} else {
				high = mid - 1
			}
		}
		return low
	}

	// The level of character k: its entry in `levels`, 0 when there are none.
	internal def levelOf(levels int[], k int) int {
		return levels.len() == 0 ?? (0, levels[k])
	}

	// The width of a space of span `si`, which tab stops are counted in.
	internal def spaceWidth(p Paragraph, si int) float {
		return layoutText(" ", flatStyle(p.spans[si].textStyle, false)).advance
	}

	// Where a tab that starts at `x` (from the line's start) ends: the next stop.
	internal def tabEnd(p Paragraph, si int, x float) float {
		let step = (spaceWidth(p, si) * p.settings.tabSize).max(1.0)
		return ((x / step).floor() + 1.0) * step
	}

	// One span's piece of a stretch of text in one direction, shaped: a run of
	// text, or a tab, which has no glyphs and reaches the next stop.
	internal struct ShapedPiece {
		span    int
		start   int
		end     int
		text    string
		glyphs  GlyphSpan
		level   int
		tab     bool
		// The width it takes: the glyphs', with `wordSpacing` after each space;
		// a tab's from where it starts to the next stop.
		advance float
	}

	// Glyphs from..to of a layout as a piece of text has them when shaped alone:
	// moved left by `x0` and their clusters back by `bytes`. A slice of an
	// item's glyphs is one without copying them.
	internal struct GlyphSpan {
		layout  TextLayout
		from    int
		to      int
		x0      float
		bytes   int
		advance float
	}

	// All the glyphs of a layout.
	internal def wholeSpan(l TextLayout) GlyphSpan {
		return GlyphSpan{layout: l, from: 0, to: l.glyphs.len(), x0: 0.0, bytes: 0, advance: l.advance}
	}

	// Characters a..b of one span in one direction at `level`, laid out as they
	// are when shaped alone: the slice of their item's glyphs when the item was
	// shaped in that direction and may be cut at both ends, else shaped again.
	internal def pieceLayout(p Paragraph, a int, b int, level int) GlyphSpan {
		let s = p.shaped
		let index = s.itemOf[a]
		if index >= 0 && s.itemOf[b - 1] == index {
			let item = s.items[index]
			if item.level == level && (a == item.start || s.safe[a]) && (b == item.end || s.safe[b]) {
				return wholeSpan(item.layout) when a == item.start && b == item.end
				return sliceOf(s, item, a, b)
			}
		}
		return wholeSpan(layoutText(s.t.text.slice(a, b), flatStyle(p.spans[s.t.span[a]].textStyle, level % 2 == 1, scriptAt(p, a))))
	}

	// The glyphs of characters a..b of an item, from x 0 as they are when shaped
	// alone; `a` and `b` are safe places to cut it.
	internal def sliceOf(s ShapedText, item ShapedItem, a int, b int) GlyphSpan {
		let l = item.layout
		// The glyphs of a..b are adjacent; in visual order they are first..last.
		let (first, last) = (glyphFrom(item, a, l.rtl), glyphFrom(item, b, l.rtl))
		if l.rtl {
			(first, last) = (last + 1, first)
		} else {
			last -= 1
		}
		let bytes = s.t.offset[a] - s.t.offset[item.start]
		return GlyphSpan{layout: l, from: 0, to: 0, x0: 0.0, bytes: bytes, advance: 0.0} when first > last
		let x0 = item.pens[first]
		return GlyphSpan{layout: l, from: first, to: last + 1, x0: x0, bytes: bytes, advance: item.pens[last] + l.glyphs[last].advance - x0}
	}

	// Left to right: the first glyph whose character is `c` or after it (the
	// glyph count when none is). Right to left, glyphs run from the last
	// character down: the last glyph whose character is `c` or after it (-1
	// when none is).
	internal def glyphFrom(item ShapedItem, c int, rtl bool) int {
		let chars = item.chars
		let (low, high) = (0, chars.len())
		if !rtl {
			for low < high {
				let mid = (low + high) / 2
				if chars[mid] < c {
					low = mid + 1
				} else {
					high = mid
				}
			}
			return low
		}
		// Decreasing: the count of glyphs at `c` or after it, less one.
		for low < high {
			let mid = (low + high) / 2
			if chars[mid] >= c {
				low = mid + 1
			} else {
				high = mid
			}
		}
		return low - 1
	}

	// The characters start..end shaped in logical order, one piece per span,
	// direction (level in `levels`) and tab, with the width they take from `x`
	// (where on the line they start, for tab stops) and the width of the
	// hanging characters that end them. Hard breaks are left out.
	internal def shapePieces(p Paragraph, start int, end int, levels int[], x float) (ShapedPiece[], float, float) {
		let t = p.shaped.t
		let pieces ShapedPiece[]
		let k = start
		let pen = x
		let spacing = p.settings.wordSpacing
		for k < end {
			let si = t.span[k]
			if isTab(t.chars[k]) {
				let blank = layoutText(" ", flatStyle(p.spans[si].textStyle, false))
				let reach = tabEnd(p, si, pen) - pen
				pieces.push(ShapedPiece{span: si, start: k, end: k + 1, text: "", glyphs: wholeSpan(blank), level: levelOf(levels, k), tab: true, advance: reach})
				pen += reach
				k++
				continue
			}
			let level = levelOf(levels, k)
			let e = k
			for e < end && t.span[e] == si && !hardBreak(t.chars[e]) && !isTab(t.chars[e]) && levelOf(levels, e) == level {
				e++
			}
			if e > k {
				let glyphs = pieceLayout(p, k, e, level)
				let advance = glyphs.advance
				if spacing != 0.0 {
					for let i = k; i < e; i++ {
						advance += spacing when wordSpace(t.chars[i])
					}
				}
				pieces.push(ShapedPiece{span: si, start: k, end: e, text: t.text.slice(k, e), glyphs: glyphs, level: level, tab: false, advance: advance})
				pen += advance
			}
			// Hard breaks only end a line; skip them.
			for e < end && hardBreak(t.chars[e]) {
				e++
			}
			k = e
		}
		// Where the hanging characters at the end begin.
		let hang = end
		for hang > start && hangs(t.chars[hang - 1]) {
			hang--
		}
		let hanging = 0.0
		for let (_, pc) in pieces {
			continue when pc.end <= hang
			if pc.tab {
				hanging += pc.advance
				continue
			}
			let run = pc.glyphs
			for let i = run.from; i < run.to; i++ {
				let g = run.layout.glyphs[i]
				let c = charAtByte(t, pc.start, pc.end, t.offset[pc.start] + g.cluster - run.bytes)
				if c >= hang {
					hanging += g.advance
					hanging += spacing when wordSpace(t.chars[c])
				}
			}
		}
		return (pieces, pen - x, hanging)
	}

	// What characters a..b take on a line where they start at `x`, and what
	// the hanging characters that end them take: as `shapePieces` measures
	// them, from the shaped items' advances where the text may be cut at a and
	// b and holds no tab, without placing a glyph.
	internal def measureRange(p Paragraph, a int, b int, x float) (float, float) {
		let s = p.shaped
		return (0.0, 0.0) when b <= a
		if s.tabs > 0 || !s.safe[a] || !s.safe[b] {
			let (_, w, hang) = shapePieces(p, a, b, s.t.levels, x)
			return (w, hang)
		}
		let w = s.pen[b] - s.pen[a]
		// The letter spacing after the glyph that ends the stretch, which it has
		// as part of its item and not alone: after the last character left to
		// right, after the first right to left.
		let end = s.itemOf[b - 1]
		w -= s.items[end].gap when end >= 0 && b < s.items[end].end && !s.items[end].layout.rtl
		let opening = s.itemOf[a]
		w -= s.items[opening].gap when opening >= 0 && a > s.items[opening].start && s.items[opening].layout.rtl
		let h = b
		for h > a && hangs(s.t.chars[h - 1]) {
			h--
		}
		return (w, s.bare[b] - s.bare[h])
	}

	// The widest stretch of the text between two break opportunities, kept.
	internal def widestUnit(p Paragraph) float {
		let s = p.shaped
		if s.least < 0.0 {
			let widest = 0.0
			let unitStart = 0
			for let (_, br) in s.breaks {
				let (w, hang) = measureRange(p, unitStart, br.index, 0.0)
				widest = widest.max(w - hang)
				unitStart = br.index
			}
			s.least = widest
		}
		return s.least
	}

	// The lines of a paragraph as character ranges, before they are placed.
	internal struct LineBreaks {
		starts int[]
		ends   int[]
		// Whether each line starts a paragraph (the text, or after a hard break).
		first  bool[]
	}

	// The room line `first` (a paragraph's first line, or one continuing a
	// wrapped line) has in `width`.
	internal def roomOf(p Paragraph, width float, first bool) float {
		return (width - (first ?? (p.settings.indent, p.settings.wrapIndent))).max(1.0)
	}

	// Breaks the text into lines no wider than `width` (0 or less: no wrapping):
	// greedy over the break opportunities, each line measured from where it
	// starts to the opportunity it would end at.
	internal def breakLines(p Paragraph, width float) LineBreaks {
		let s = p.shaped
		let out = LineBreaks{starts: int[], ends: int[], first: bool[]}
		let n = s.t.chars.len()
		let wraps = width > 0.0
		let lineStart = 0
		let lineEnd = 0
		let first = true
		for let (_, br) in s.breaks {
			if wraps {
				let room = roomOf(p, width, first)
				let (w, hang) = measureRange(p, lineStart, br.index, 0.0)
				if lineEnd > lineStart && w - hang > room {
					addLine(out, lineStart, lineEnd, first)
					first = false
					lineStart = lineEnd
					room = roomOf(p, width, first)
					(w, hang) = measureRange(p, lineStart, br.index, 0.0)
				}
				// A unit wider than a line on its own: split between clusters.
				if lineEnd == lineStart && w - hang > room {
					let from = lineStart
					for {
						let cut = fitClusters(p, from, br.index, room)
						break when cut >= br.index
						addLine(out, from, cut, first)
						first = false
						from = cut
						room = roomOf(p, width, first)
					}
					lineStart = from
				}
			}
			lineEnd = br.index
			if br.mandatory {
				addLine(out, lineStart, lineEnd, first)
				first = true
				lineStart = lineEnd
			}
		}
		// A text that ends with a newline ends with an empty line.
		addLine(out, n, n, first) when n > 0 && hardBreak(s.t.chars[n - 1])
		return out
	}

	// The lines the text is set in at `width`: broken greedily, or for
	// `balanced` at the narrowest width that keeps their count; those past
	// `maxLines` left out. Also whether any were, and the line that ends in the
	// ellipsis (-1 for none).
	internal def linesKept(p Paragraph, width float) (LineBreaks, bool, int) {
		let breaks = breakLines(p, width)
		if p.settings.balanced && width > 0.0 && breaks.starts.len() > 1 {
			// The narrowest width that keeps the line count: lines even out.
			let count = breaks.starts.len()
			let (low, high) = (0.0, width)
			for let step = 0; step < 14; step++ {
				let mid = (low + high) / 2.0
				if breakLines(p, mid).starts.len() <= count {
					high = mid
				} else {
					low = mid
				}
			}
			breaks = breakLines(p, high)
		}
		// Lines past `maxLines` are left out; the last one kept ends in the ellipsis.
		let most = p.settings.maxLines
		if !(most is none) && breaks.starts.len() > most.max(1) {
			let keep = most.max(1)
			breaks.starts.len(keep)
			breaks.ends.len(keep)
			breaks.first.len(keep)
			return (breaks, true, p.settings.ellipsis != "" ?? (keep - 1, -1))
		}
		return (breaks, false, -1)
	}

	// The first line's baseline: its box from the metrics of the spans on it.
	internal def firstBaselineOf(p Paragraph) ?float {
		let n = p.shaped.t.chars.len()
		return none when n == 0
		let (breaks, _, ellipsisLine) = linesKept(p, p.width)
		let (s, e) = (breaks.starts[0], breaks.ends[0])
		let markSpan = -1
		if ellipsisLine == 0 {
			let (cut, _, span) = ellipsisCut(p, s, e, p.width, breaks.first[0])
			e = cut
			markSpan = span
		}
		let (above, _) = lineBox(p, s, e, markSpan)
		return above
	}

	// Where a line s..e that ends in the ellipsis is cut: as many clusters as
	// leave room for the ellipsis, without the spaces before it. Also the
	// ellipsis laid out, and the span it takes its style from.
	internal def ellipsisCut(p Paragraph, s int, e int, width float, first bool) (int, TextLayout, int) {
		let t = p.shaped.t
		let n = t.chars.len()
		let wraps = width > 0.0
		let rtl = false
		let bidi = t.bidi
		rtl = bidi.direction((s < n) ?? (s, n - 1)) == Direction.RightToLeft unless (bidi is none)
		let markSpan = t.span[(e > s) ?? (e - 1, (s < n) ?? (s, n - 1))]
		let made = layoutText(p.settings.ellipsis, flatStyle(p.spans[markSpan].textStyle, rtl, scriptAt(p, (e > s) ?? (e - 1, s))))
		let fit = wraps ?? (roomOf(p, width, first) - made.advance, 0.0)
		let (whole, hangW) = measureRange(p, s, e, 0.0)
		if wraps && whole - hangW > fit {
			e = fitClusters(p, s, e, fit.max(1.0))
			e = s when fitWidth(p, s, e) > fit
		}
		// No space before the ellipsis.
		for e > s && hangs(t.chars[e - 1]) {
			e--
		}
		return (e, made, markSpan)
	}

	// How far line s..e reaches above and below its baseline: the most any span
	// on it (and `markSpan`'s, the ellipsis's, when not -1) does, by its face's
	// ascent and descent plus half the leading its size times `lineHeight` adds
	// (CSS), raised by its `shift`; a line with nothing on it takes the extent
	// of the span it starts in.
	internal def lineBox(p Paragraph, s int, e int, markSpan int) (float, float) {
		let t = p.shaped.t
		let n = t.chars.len()
		let lineHeight = p.settings.lineHeight
		let (above, below) = (0.0, 0.0)
		let any = false
		let last = -1
		for let k = s; k < e; k++ {
			let si = t.span[k]
			continue when si == last || hardBreak(t.chars[k])
			last = si
			let (a, b) = spanExtent(p.spans[si].textStyle, lineHeight)
			let shift = p.spans[si].shift
			above = above.max(a + shift)
			below = below.max(b - shift)
			any = true
		}
		if markSpan >= 0 {
			let (a, b) = spanExtent(p.spans[markSpan].textStyle, lineHeight)
			let shift = p.spans[markSpan].shift
			above = above.max(a + shift)
			below = below.max(b - shift)
			any = true
		}
		return any ?? ((above, below), spanExtent(p.spans[t.span[(s < n) ?? (s, n - 1)]].textStyle, lineHeight))
	}

	// What a run in the style reaches above and below the baseline in a line:
	// its face's ascent and descent at its size, each grown by half the leading.
	internal def spanExtent(spanStyle TextStyle, lineHeight float) (float, float) {
		let size = textSize(spanStyle)
		let m = spanStyle.face.metrics()
		let scale = size / float(spanStyle.face.info().unitsPerEm).max(1.0)
		let (ascent, descent) = (float(m.ascent) * scale, (-float(m.descent)) * scale)
		let half = (size * lineHeight - (ascent + descent)) / 2.0
		return (ascent + half, descent + half)
	}

	internal def addLine(out LineBreaks, start int, end int, first bool) {
		out.starts.push(start)
		out.ends.push(end)
		out.first.push(first)
	}

	// One stretch placed on a line: part of a piece shaped alone, with room
	// added after it (word spacing, justification).
	internal struct LineSegment {
		span   int
		start  int
		end    int
		text   string
		glyphs GlyphSpan
		rtl    bool
		tab    bool
		width  float
		script string
	}

	// Breaks the text into lines and places every run.
	internal def layoutParagraph(p Paragraph, width float) {
		let t = p.shaped.t
		let n = t.chars.len()
		p.box = new Size(0.0, 0.0)
		p.cut = false
		p.natural = 0.0
		return when n == 0
		let wraps = width > 0.0
		let (breaks, cut, ellipsisLine) = linesKept(p, width)
		p.cut = cut
		let y = 0.0
		let widest = 0.0
		let placed TextLine[]
		for let (li, s) in breaks.starts {
			let e = breaks.ends[li]
			let first = breaks.first[li]
			// The last line of its paragraph: the text's, or one a hard break ends.
			let last = li + 1 == breaks.starts.len() || breaks.first[li + 1]
			let line = placeLine(p, li, s, e, width, first, last, li == ellipsisLine, y)
			widest = widest.max(line.width + (first ?? (p.settings.indent, p.settings.wrapIndent)))
			placed.push(line)
			y = line.bottom
		}
		// Alignment within the width (the widest line when not wrapping).
		let room = wraps ?? (width, widest)
		let shifts float[]
		for let (li, line) in placed {
			let inset = breaks.first[li] ?? (p.settings.indent, p.settings.wrapIndent)
			let free = room - inset - line.width
			let shift = 0.0
			match p.settings.align {
				case TextAlign.Center:
					shift = free / 2.0
				case TextAlign.End:
					shift = free
				default:
			}
			// Start and End are the paragraph's: the right side when right to left.
			shift = free - shift when line.rightToLeft
			shift += line.rightToLeft ?? (0.0, inset)
			line.left = shift
			shifts.push(shift)
			continue when shift == 0.0
			// The line's glyph boxes are its own: moved where they are.
			for let (_, g) in line.glyphs {
				g.x += shift
				g.bounds.left += shift
				g.bounds.right += shift
			}
		}
		for let (_, r) in p.runs {
			r.x += shifts[r.line]
		}
		p.rows = placed
		p.box = new Size(room, y)
		p.natural = widest
	}

	// Shapes and places line `li` (characters s..e) from x 0 in visual order,
	// below `y`, and records its runs. `ellipsis`: the line is the last one
	// kept and ends in the style's ellipsis, as many characters as fit before it.
	internal def placeLine(p Paragraph, li int, s int, e int, width float, first bool, last bool, ellipsis bool, y float) TextLine {
		let t = p.shaped.t
		let n = t.chars.len()
		let wraps = width > 0.0
		let room = roomOf(p, width, first)
		let bidi = t.bidi
		let rtl = false
		let lineLevels int[]
		rtl = bidi.direction((s < n) ?? (s, n - 1)) == Direction.RightToLeft unless (bidi is none)
		// The ellipsis takes room from the end of the line.
		let mark ?TextLayout = none
		let markSpan = -1
		let markScript = scriptAt(p, (e > s) ?? (e - 1, s))
		if ellipsis {
			let (cut, made, span) = ellipsisCut(p, s, e, width, first)
			e = cut
			mark = made
			markSpan = span
		}
		if !(bidi is none) {
			// The line's own levels (rule L1): what ends the line goes back to the
			// paragraph's level.
			for let k = s; k < e; k++ {
				lineLevels.push(0)
			}
			for let (_, run) in bidi.runs(s, e) {
				for let k = run.start; k < run.end; k++ {
					lineLevels[k - s] = run.level
				}
			}
		}
		let levels int[]
		if lineLevels.len() > 0 {
			for let k = 0; k < s; k++ {
				levels.push(0)
			}
			levels.push(...lineLevels)
		}
		let (pieces, total, hang) = shapePieces(p, s, e, levels, 0.0)
		// A break at a soft hyphen shows a hyphen.
		let hyphen = !ellipsis && e < n && e > s && int(t.chars[e - 1]) == 0xAD
		// The room justification shares out, and where: after word separators,
		// else between characters.
		let extra = 0.0
		let gaps = 0
		let perChar = false
		// Where the characters that hang at the end of the line begin.
		let hangAt = e
		for hangAt > s && hangs(t.chars[hangAt - 1]) {
			hangAt--
		}
		if p.settings.justify && wraps && !last && !ellipsis && !hyphen {
			extra = room - (total - hang)
			for let k = s; k < hangAt; k++ {
				gaps += 1 when wordSpace(t.chars[k])
			}
			if gaps == 0 {
				perChar = true
				gaps = hangAt - s - 1
			}
			extra = 0.0 when gaps <= 0 || extra <= 0.0
		}
		let gap = extra > 0.0 ?? (extra / float(gaps), 0.0)
		let spacing = p.settings.wordSpacing
		// The segments in logical order: each piece whole, or cut after each place
		// that takes added room.
		let segments LineSegment[]
		let order int[]
		for let (pi, pc) in pieces {
			let lastPiece = pi == pieces.len() - 1
			if pc.tab {
				segments.push(LineSegment{span: pc.span, start: pc.start, end: pc.end, text: "", glyphs: pc.glyphs, rtl: pc.level % 2 == 1, tab: true, width: pc.advance})
				continue
			}
			let script = scriptAt(p, pc.start)
			let shapedAs = flatStyle(p.spans[pc.span].textStyle, pc.level % 2 == 1, script)
			let splits = (spacing != 0.0 || gap > 0.0)
			if !splits {
				let text = pc.text
				let glyphs = pc.glyphs
				if hyphen && lastPiece {
					text += "-"
					glyphs = wholeSpan(layoutText(text, shapedAs))
				}
				segments.push(LineSegment{span: pc.span, start: pc.start, end: pc.end, text: text, glyphs: glyphs, rtl: pc.level % 2 == 1, tab: false, width: glyphs.advance, script: script})
				continue
			}
			let from = pc.start
			for let k = pc.start; k < pc.end; k++ {
				let cuts = wordSpace(t.chars[k]) || (perChar && gap > 0.0)
				continue unless cuts || k + 1 == pc.end
				let text = t.text.slice(from, k + 1)
				let hyphenated = hyphen && lastPiece && k + 1 == pc.end
				text += "-" when hyphenated
				let glyphs = hyphenated ?? (wholeSpan(layoutText(text, shapedAs)), pieceLayout(p, from, k + 1, pc.level))
				let taken = glyphs.advance
				taken += spacing when wordSpace(t.chars[k])
				// Justification's room goes after the line's inner word separators
				// (or characters), none after what hangs at its end.
				taken += gap when gap > 0.0 && (wordSpace(t.chars[k]) || perChar) && k + 1 < hangAt
				segments.push(LineSegment{span: pc.span, start: from, end: k + 1, text: text, glyphs: glyphs, rtl: pc.level % 2 == 1, tab: false, width: taken, script: script})
				from = k + 1
			}
		}
		segments.push(LineSegment{span: markSpan, start: e, end: e, text: p.settings.ellipsis, glyphs: wholeSpan(mark), rtl: rtl, tab: false, width: mark.advance, script: markScript}) unless (mark is none)
		// Visual order: the line's bidi runs left to right, a run that goes right to
		// left with its segments the other way round; the ellipsis at the end side.
		if bidi is none {
			for let i = 0; i < segments.len(); i++ {
				order.push(i)
			}
		} else {
			let ellipsisAt = mark is none ?? (-1, segments.len() - 1)
			order.push(ellipsisAt) when rtl && ellipsisAt >= 0
			for let (_, run) in bidi.runs(s, e) {
				let inRun int[]
				for let (i, seg) in segments {
					inRun.push(i) when i != ellipsisAt && seg.start >= run.start && seg.start < run.end
				}
				if run.rightToLeft {
					for let k = inRun.len() - 1; k >= 0; k-- {
						order.push(inRun[k])
					}
				} else {
					order.push(...inRun)
				}
			}
			order.push(ellipsisAt) when !rtl && ellipsisAt >= 0
		}
		let (above, below) = lineBox(p, s, e, markSpan)
		let baseline = y + above
		let line = TextLine{glyphs: GlyphBox[], baseline: baseline, top: y, bottom: baseline + below, left: 0.0, width: 0.0, start: s, end: e, rightToLeft: rtl}
		// What hangs is at the end side: the right of a left-to-right line, the
		// left of a right-to-left one, which starts that much before x 0.
		let x = rtl ?? (-hang, 0.0)
		for let (_, at) in order {
			let seg = segments[at]
			if !seg.tab {
				let raised = baseline - p.spans[seg.span].shift
				let from = line.glyphs.len()
				let run = seg.glyphs
				let dx = x - run.x0
				let base = t.offset[seg.start] - run.bytes
				for let i = run.from; i < run.to; i++ {
					let g = run.layout.glyphs[i]
					line.glyphs.push(GlyphBox{glyph: g.glyph, x: dx + g.x, y: raised + g.y, advance: g.advance, bounds: Rect{left: g.bounds.left + dx, top: g.bounds.top + raised, right: g.bounds.right + dx, bottom: g.bounds.bottom + raised}, cluster: base + g.cluster})
				}
				p.runs.push(ParagraphRun{line: li, span: seg.span, text: seg.text, x: x, y: raised, rightToLeft: seg.rtl, width: seg.width, glyphFrom: from, glyphTo: line.glyphs.len(), script: seg.script})
			}
			x += seg.width
		}
		line.width = rtl ?? (x, x - hang)
		return line
	}

	// The width of characters start..end on a line, without what hangs.
	internal def fitWidth(p Paragraph, start int, end int) float {
		let (w, hang) = measureRange(p, start, end, 0.0)
		return w - hang
	}

	// The end of the longest stretch from `from` that fits the width, cut
	// before the first cluster that does not fit; at least one cluster. The
	// clusters are measured by their glyphs' advances in their items, tabs
	// from where they start.
	internal def fitClusters(p Paragraph, from int, end int, width float) int {
		let s = p.shaped
		let used = 0.0
		let k = from
		for k < end {
			let reach = 0.0
			let next = k + 1
			if s.itemOf[k] < 0 {
				reach = isTab(s.t.chars[k]) ?? (tabEnd(p, s.t.span[k], used) - used, 0.0)
			} else {
				for next < end && !s.starts[next] {
					next++
				}
				reach = s.bare[next] - s.bare[k]
			}
			return k when k > from && used + reach > width
			used += reach
			k = next
		}
		return end
	}
}
