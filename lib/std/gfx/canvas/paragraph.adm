partial module std.gfx.canvas {
	use (
		std.math.geom::(Point, Rect, Size)
		std.text.unicode::(lineBreaks)
	)

	// TextSpan is a piece of a paragraph in one style and paint.
	struct TextSpan {
		text      string
		textStyle TextStyle
		paint     Paint
	}

	// TextLine is one laid out line of a paragraph, in the paragraph's
	// space: (0, 0) is its top left corner, y grows down.
	struct TextLine {
		// The line's glyphs in visual order, each `cluster` a byte index
		// into the paragraph's text (its spans joined).
		glyphs   GlyphBox[]
		// The y of the line's alphabetic baseline.
		baseline float
		// The line box: from `top` to `bottom`, the leading included.
		top      float
		bottom   float
		// Where the line starts after alignment, and how wide it is
		// without the spaces that end it.
		left     float
		width    float
		// The characters the line holds, as `string.slice` counts them in
		// the paragraph's text: start included, end excluded.
		start    int
		end      int
	}

	// A run of one span's text on one line: drawn at (x, y), y its baseline.
	internal struct ParagraphRun {
		line int
		span int
		text string
		x    float
		y    float
	}

	// Paragraph is text set in lines within a width, left to right: spans
	// of different styles share each line's baseline, lines wrap where
	// Unicode allows a break (UAX #14) and always after a newline, and a
	// word wider than the line is split between glyph clusters. Each line
	// is as tall as its tallest span's size times `lineHeight` (the leading
	// split above and below, as CSS does). Spaces that end a line hang past
	// it; a line that breaks at a soft hyphen shows a hyphen. The spans'
	// `align`, `baseline` and `orientation` are not used: `align` places
	// every line within `width`. A width of 0 or less never wraps.
	type Paragraph {
		internal spans TextSpan[]
		internal runs  ParagraphRun[]
		internal rows  TextLine[]
		internal box   Size

		def new(spans TextSpan[], width float, align = TextAlign.Start, lineHeight float = 1.2) {
			self.spans = spans
			layoutParagraph(self, width, align, lineHeight)
		}

		// The lines, top to bottom.
		def lines() TextLine[] {
			return rows
		}

		// The size the lines take: `width` wide (the widest line when the
		// paragraph does not wrap), as tall as all lines.
		def size() Size {
			return box
		}
	}

	// Draws the paragraph with its top left corner at `at`: each run as
	// text in its span's style and paint.
	internal def drawParagraph(p Painter, para Paragraph, at Point) {
		for let (_, r) in para.runs {
			let sp = para.spans[r.span]
			p.fillText(r.text, new Point(at.x + r.x, at.y + r.y), flatStyle(sp.textStyle), sp.paint)
		}
	}

	// The paragraph's text and, per character, its span and byte offset.
	internal struct ParagraphText {
		text   string
		chars  char[]
		span   int[]
		// Byte offset of each character, and one past the last.
		offset int[]
	}

	internal def joinSpans(spans TextSpan[]) ParagraphText {
		let t = ParagraphText{text: "", chars: char[], span: int[], offset: int[]}
		let at = 0
		for let (si, sp) in spans {
			t.text += sp.text
			for let (_, ch) in sp.text {
				t.chars.push(ch)
				t.span.push(si)
				t.offset.push(at)
				let cp = int(ch)
				at += cp < 0x80 ?? (1, cp < 0x800 ?? (2, cp < 0x10000 ?? (3, 4)))
			}
		}
		t.offset.push(at)
		return t
	}

	// A character that ends a line by itself (Line_Break BK, CR, LF, NL).
	internal def hardBreak(ch char) bool {
		let cp = int(ch)
		return cp := 0x0A || 0x0B || 0x0C || 0x0D || 0x85 || 0x2028 || 0x2029
	}

	// A character that hangs at the end of a line: spaces and hard breaks.
	internal def hangs(ch char) bool {
		let cp = int(ch)
		return (cp := 0x20 || 0x09 || 0x3000 || 0x1680) || hardBreak(ch) || (cp >= 0x2000 && cp <= 0x200A && cp != 0x2007)
	}

	// The style a paragraph shapes a span with: left to right from the
	// pen, on the alphabetic baseline.
	internal def flatStyle(s TextStyle) TextStyle {
		return TextStyle{face: s.face, size: s.size, spacing: s.spacing, hinting: s.hinting, rootSize: s.rootSize, script: s.script}
	}

	// One span's piece of a stretch of text, shaped.
	internal struct ShapedPiece {
		span   int
		start  int
		end    int
		text   string
		layout TextLayout
	}

	// The characters start..end shaped, one piece per span, with the
	// width they take and the width of the hanging characters that end
	// them. Hard breaks are left out of the pieces.
	internal def shapePieces(spans TextSpan[], t ParagraphText, start int, end int) (ShapedPiece[], float, float) {
		let pieces ShapedPiece[]
		let k = start
		for k < end {
			let si = t.span[k]
			let e = k
			for e < end && t.span[e] == si && !hardBreak(t.chars[e]) {
				e++
			}
			if e > k {
				let text = t.text.slice(k, e)
				pieces.push(ShapedPiece{span: si, start: k, end: e, text: text, layout: layoutText(text, flatStyle(spans[si].textStyle))})
			}
			// Hard breaks only end a line; skip them.
			for e < end && hardBreak(t.chars[e]) {
				e++
			}
			k = e
		}
		// Where the hanging characters at the end begin.
		let hang = end
		for hang > start && hangs(t.chars[hang - 1]) {
			hang--
		}
		let total = 0.0
		let hanging = 0.0
		for let (_, p) in pieces {
			total += p.layout.advance
			for let (_, g) in p.layout.glyphs {
				hanging += g.advance when charAt(t, p.start, g.cluster) >= hang
			}
		}
		return (pieces, total, hanging)
	}

	// The character index of a glyph's cluster, a byte offset into the
	// piece that starts at character `start`.
	internal def charAt(t ParagraphText, start int, cluster int) int {
		let target = t.offset[start] + cluster
		let k = start
		for k + 1 < t.offset.len() && t.offset[k + 1] <= target {
			k++
		}
		return k
	}

	// Breaks the text into lines and places every run.
	internal def layoutParagraph(p Paragraph, width float, align TextAlign, lineHeight float) {
		let t = joinSpans(p.spans)
		let n = t.chars.len()
		p.box = new Size(0.0, 0.0)
		return when n == 0
		let wraps = width > 0.0
		// Lines as character ranges: greedy over the break opportunities.
		let starts int[]
		let ends int[]
		let lineStart = 0
		let lineEnd = 0
		let used = 0.0
		let unitStart = 0
		for let (_, br) in lineBreaks(t.text) {
			let (_, w, hang) = shapePieces(p.spans, t, unitStart, br.index)
			if wraps && lineEnd > lineStart && used + w - hang > width {
				starts.push(lineStart)
				ends.push(lineEnd)
				lineStart = lineEnd
				used = 0.0
			}
			// A unit wider than a line on its own: split between clusters.
			if wraps && lineEnd == lineStart && w - hang > width {
				let from = unitStart
				for {
					let cut = fitClusters(p.spans, t, from, br.index, width)
					break when cut >= br.index
					starts.push(from)
					ends.push(cut)
					from = cut
				}
				lineStart = from
				let (_, rest, _) = shapePieces(p.spans, t, from, br.index)
				used = rest
			} else {
				used += w
			}
			lineEnd = br.index
			unitStart = br.index
			if br.mandatory {
				starts.push(lineStart)
				ends.push(lineEnd)
				lineStart = lineEnd
				used = 0.0
			}
		}
		// A text that ends with a newline ends with an empty line.
		if hardBreak(t.chars[n - 1]) {
			starts.push(n)
			ends.push(n)
		}
		// Shape and place each line.
		let y = 0.0
		let widest = 0.0
		let placed TextLine[]
		for let (li, s) in starts {
			let e = ends[li]
			let (pieces, total, hang) = shapePieces(p.spans, t, s, e)
			// Line box: each piece's ascent and descent with half the
			// leading its size adds; an empty line takes its span's.
			let above = 0.0
			let below = 0.0
			let styleAt = p.spans[t.span[(s < n) ?? (s, n - 1)]].textStyle
			for let (_, pc) in pieces {
				let (a, b) = lineExtent(pc.layout, lineHeight)
				above = above.max(a)
				below = below.max(b)
			} empty {
				(above, below) = lineExtent(layoutText(" ", flatStyle(styleAt)), lineHeight)
			}
			let baseline = y + above
			let line = TextLine{glyphs: GlyphBox[], baseline: baseline, top: y, bottom: baseline + below, left: 0.0, width: total - hang, start: s, end: e}
			// A break at a soft hyphen shows a hyphen.
			let hyphen = e < n && e > s && int(t.chars[e - 1]) == 0xAD
			let x = 0.0
			for let (pi, pc) in pieces {
				let text = pc.text
				let adv = pc.layout.advance
				if hyphen && pi == pieces.len() - 1 {
					text += "-"
					let withHyphen = layoutText(text, flatStyle(p.spans[pc.span].textStyle))
					line.width += withHyphen.advance - adv
					adv = withHyphen.advance
					pc.layout = withHyphen
				}
				p.runs.push(ParagraphRun{line: li, span: pc.span, text: text, x: x, y: baseline})
				for let (_, g) in pc.layout.glyphs {
					let cluster = t.offset[pc.start] + g.cluster
					line.glyphs.push(GlyphBox{glyph: g.glyph, x: x + g.x, y: baseline + g.y, advance: g.advance, bounds: Rect{left: g.bounds.left + x, top: g.bounds.top + baseline, right: g.bounds.right + x, bottom: g.bounds.bottom + baseline}, cluster: cluster})
				}
				x += adv
			}
			widest = widest.max(line.width)
			placed.push(line)
			y = line.bottom
		}
		// Alignment within the width (the widest line when not wrapping).
		let room = wraps ?? (width, widest)
		for let (li, line) in placed {
			let shift = 0.0
			match align {
				case TextAlign.Center:
					shift = (room - line.width) / 2.0
				case TextAlign.End:
					shift = room - line.width
				default:
			}
			line.left = shift
			for let gi = 0; gi < line.glyphs.len(); gi++ {
				let g = line.glyphs[gi]
				line.glyphs[gi] = GlyphBox{glyph: g.glyph, x: g.x + shift, y: g.y, advance: g.advance, bounds: Rect{left: g.bounds.left + shift, top: g.bounds.top, right: g.bounds.right + shift, bottom: g.bounds.bottom}, cluster: g.cluster}
			}
			for let (_, r) in p.runs {
				r.x += shift when r.line == li
			}
		}
		p.rows = placed
		p.box = new Size(room, y)
	}

	// How far a line box reaches above and below the baseline for a run:
	// its ascent and descent, each grown by half the leading.
	internal def lineExtent(l TextLayout, lineHeight float) (float, float) {
		let half = (l.size * lineHeight - (l.ascent + l.descent)) / 2.0
		return (l.ascent + half, l.descent + half)
	}

	// The end of the longest stretch from `from` that fits the width,
	// cut before the cluster of the first glyph that does not fit; at
	// least one cluster.
	internal def fitClusters(spans TextSpan[], t ParagraphText, from int, end int, width float) int {
		let (pieces, _, _) = shapePieces(spans, t, from, end)
		let used = 0.0
		for let (_, pc) in pieces {
			for let (_, g) in pc.layout.glyphs {
				let k = charAt(t, pc.start, g.cluster)
				return k when k > from && used + g.advance > width
				used += g.advance
			}
		}
		return end
	}
}
