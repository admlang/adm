partial module std.gfx.canvas {
	use (
		std.testing
		std.os
		std.formats.fonts
		std.gfx.color::(Color, RGBA)
		std.math.geom::(Point, Rect)
		std.text.unicode::Direction
		std.units::Pixels
	)

	check "Paragraph" {
		def face() !fonts.Face {
			let data = try os.readFile("samples/fonts/ttf/SourceSansPro-Black.ttf")
			return try (try fonts.load(data)).face(0)
		}

		def ink() Color {
			return new Color(RGBA{r: 0, g: 0, b: 0, a: 255})
		}

		def span(text string, f fonts.Face, size float = 16.0) TextSpan {
			return TextSpan{text: text, textStyle: TextStyle{face: f, size: size * 1(px)}, paint: ink()}
		}

		@test()
		def oneLineWhenItFits() !none {
			let f = try face()
			let p = new Paragraph([span("Hello world", f)], 500.0)
			let lines = p.lines()
			assert lines.len() == 1 && lines[0].start == 0 && lines[0].end == 11
			assert lines[0].width > 50.0 && lines[0].left == 0.0 && p.size().width == 500.0
		}

		@test()
		def wrapsAtSpacesAndHangsThem() !none {
			let f = try face()
			let one = new Paragraph([span("alpha", f)], 0.0).lines()[0].width
			let p = new Paragraph([span("alpha beta gamma", f)], one * 1.5)
			let lines = p.lines()
			assert lines.len() == 3
			// The space that ends a line hangs: not counted in its width.
			assert (lines[0].width - one).abs() < 0.01 && lines[0].end == 6
			assert lines[1].start == 6 && lines[1].top >= lines[0].bottom - 0.001
		}

		// The narrowest a paragraph gets without a word cut is its widest word, without
		// the space after it; at that width every line holds whole words.
		@test()
		def narrowestIsTheWidestWord() !none {
			let f = try face()
			let wide = new Paragraph([span("wonderful", f)], 0.0).lines()[0].width
			let p = new Paragraph([span("a wonderful day", f)], 0.0)
			assert (p.narrowest() - wide).abs() < 0.01
			let lines = new Paragraph([span("a wonderful day", f)], p.narrowest() + 0.01).lines()
			assert lines.len() == 3 && lines[0].end == 2 && lines[1].end == 12 && lines[2].end == 15
			assert new Paragraph([], 0.0).narrowest() == 0.0
		}

		@test()
		def newlinesAlwaysBreak() !none {
			let f = try face()
			let p = new Paragraph([span("a\nb\n", f)], 500.0)
			let lines = p.lines()
			// The trailing newline leaves an empty last line.
			assert lines.len() == 3 && lines[0].end == 2 && lines[2].start == 4 && lines[2].glyphs.len() == 0
		}

		@test()
		def longWordsSplitBetweenClusters() !none {
			let f = try face()
			let p = new Paragraph([span("abcdefghijklmnopqrstuvwxyz", f)], 60.0)
			let lines = p.lines()
			assert lines.len() > 2
			for let (_, l) in lines {
				assert l.width <= 60.0 + 0.01 && l.end > l.start
			}
		}

		@test()
		def alignmentMovesLines() !none {
			let f = try face()
			let start = new Paragraph([span("short", f)], 300.0).lines()[0]
			let centre = new Paragraph([span("short", f)], 300.0, align = TextAlign.Center).lines()[0]
			let end = new Paragraph([span("short", f)], 300.0, align = TextAlign.End).lines()[0]
			assert start.left == 0.0 && (centre.left - (300.0 - start.width) / 2.0).abs() < 0.01 && (end.left + end.width - 300.0).abs() < 0.01
			assert (end.glyphs[0].x - end.left - start.glyphs[0].x).abs() < 0.01
		}

		@test()
		def spansShareTheBaseline() !none {
			let f = try face()
			let p = new Paragraph([span("small ", f, 12.0), span("BIG", f, 36.0)], 500.0, lineHeight = 1.0)
			let l = p.lines()[0]
			// The line is as tall as the big span; every glyph on one baseline.
			assert l.bottom - l.top > 30.0
			for let (_, g) in l.glyphs {
				assert (g.y - l.baseline).abs() < 0.01
			}
			// Clusters index the joined text: "BIG" starts at byte 6.
			assert l.glyphs[6].cluster == 6
		}

		@test()
		def softHyphensShowWhenTheyBreak() !none {
			let f = try face()
			let word = "hyphen" + string(char(0xAD)) + "ation"
			let wide = new Paragraph([span(word, f)], 0.0).lines()[0].width
			let p = new Paragraph([span(word, f)], wide * 0.7)
			let lines = p.lines()
			assert lines.len() == 2 && lines[0].end == 7
			let plain = new Paragraph([span("hyphen-", f)], 0.0).lines()[0].width
			assert (lines[0].width - plain).abs() < 0.01
		}

		// A right-to-left word inside left-to-right text is laid out in visual
		// order: its characters' glyphs run from its last to its first.
		@test()
		def rightToLeftRunsInVisualOrder() !none {
			let f = try face()
			let text = "ab " + string(char(0x05D0)) + string(char(0x05D1)) + string(char(0x05D2)) + " cd"
			let line = new Paragraph([span(text, f)], 0.0).lines()[0]
			assert !line.rightToLeft
			let clusters int[]
			for let (_, g) in line.glyphs {
				clusters.push(g.cluster)
			}
			// a b space, then gimel bet alef (two bytes each), then space c d.
			assert clusters[0] == 0 && clusters[1] == 1 && clusters[2] == 2
			assert clusters[3] == 7 && clusters[4] == 5 && clusters[5] == 3
			assert clusters[6] == 9 && clusters[8] == 11
			for let i = 1; i < line.glyphs.len(); i++ {
				assert line.glyphs[i].x >= line.glyphs[i - 1].x
			}
		}

		// A right-to-left paragraph starts at the right: Start aligns its lines
		// there, End at the left.
		@test()
		def rightToLeftParagraphsStartAtTheRight() !none {
			let f = try face()
			let rtl = ParagraphStyle{direction: Direction.RightToLeft}
			let line = new Paragraph([span("short", f)], 300.0, rtl).lines()[0]
			assert line.rightToLeft && (line.left + line.width - 300.0).abs() < 0.01
			let atEnd = new Paragraph([span("short", f)], 300.0, ParagraphStyle{direction: Direction.RightToLeft, align: TextAlign.End}).lines()[0]
			assert atEnd.left.abs() < 0.01
		}

		// Justified lines but the last fill the width at their spaces.
		@test()
		def justifiedLinesFillTheWidth() !none {
			let f = try face()
			let text = "one two three four five six seven eight nine ten"
			let lines = new Paragraph([span(text, f)], 140.0, ParagraphStyle{justify: true}).lines()
			assert lines.len() > 2
			for let i = 0; i + 1 < lines.len(); i++ {
				assert (lines[i].left + lines[i].width - 140.0).abs() < 0.5
			}
			let plain = new Paragraph([span(text, f)], 140.0).lines()
			assert lines[lines.len() - 1].width == plain[plain.len() - 1].width
		}

		@test()
		def indentsMoveFirstAndContinuedLines() !none {
			let f = try face()
			let text = "one two three four five six seven eight nine ten"
			let lines = new Paragraph([span(text, f)], 140.0, ParagraphStyle{indent: 20.0, wrapIndent: 8.0}).lines()
			assert lines.len() > 2 && lines[0].left == 20.0 && lines[1].left == 8.0
			for let (_, l) in lines {
				assert l.left + l.width <= 140.0 + 0.01
			}
		}

		// A tab reaches the next stop, tabSize spaces apart.
		@test()
		def tabsReachTheNextStop() !none {
			let f = try face()
			let space = new Paragraph([span("a b", f)], 0.0).lines()[0].glyphs
			let step = (space[2].x - space[1].x) * 4.0
			let line = new Paragraph([span("a\tb", f)], 0.0, ParagraphStyle{tabSize: 4.0}).lines()[0]
			let b = line.glyphs[line.glyphs.len() - 1]
			assert b.cluster == 2 && (b.x - b.bounds.left).abs() >= 0.0 && (b.x - step).abs() < 0.5
		}

		// Lines past maxLines are left out, the last kept ends in the ellipsis
		// and still fits.
		@test()
		def maxLinesEndInTheEllipsis() !none {
			let f = try face()
			let text = "one two three four five six seven eight nine ten"
			let p = new Paragraph([span(text, f)], 140.0, ParagraphStyle{maxLines: 2, ellipsis: "…"})
			let lines = p.lines()
			assert p.truncated() && lines.len() == 2 && lines[1].left + lines[1].width <= 140.0 + 0.01
			let full = new Paragraph([span(text, f)], 140.0).lines()
			assert lines[1].end <= full[1].end && !new Paragraph([span(text, f)], 140.0).truncated()
			assert lines[1].glyphs[lines[1].glyphs.len() - 1].cluster == lines[1].end
		}

		// Balanced lines are of similar length: the last no shorter than greedy
		// wrapping leaves it, and as many lines.
		@test()
		def balancedLinesEvenOut() !none {
			let f = try face()
			let text = "one two three four five six seven"
			let greedy = new Paragraph([span(text, f)], 200.0).lines()
			let even = new Paragraph([span(text, f)], 200.0, ParagraphStyle{balanced: true}).lines()
			assert greedy.len() == 2 && even.len() == 2
			assert (even[0].width - even[1].width).abs() <= (greedy[0].width - greedy[1].width).abs()
		}

		@test()
		def wordSpacingWidensSpaces() !none {
			let f = try face()
			let plain = new Paragraph([span("a b c", f)], 0.0).lines()[0].width
			let wide = new Paragraph([span("a b c", f)], 0.0, ParagraphStyle{wordSpacing: 5.0}).lines()[0].width
			assert (wide - plain - 10.0).abs() < 0.01
		}

		// The ink of a canvas in rows top..bottom.
		def inkIn(cv Canvas, top int, bottom int) int {
			let sum = 0
			for let y = top.max(0); y < bottom.min(cv.height); y++ {
				for let x = 0; x < cv.width; x++ {
					sum += int(cv.pixels[(y * cv.width + x) * 4 + 3])
				}
			}
			return sum
		}

		// An underline draws below the baseline, a strikethrough through the letters,
		// a background behind the whole line.
		@test()
		def decorationsAndBackgroundsAreDrawn() !none {
			let f = try face()
			let plain = new Paragraph([span("mmmm", f, 20.0)], 0.0)
			let base = int(plain.lines()[0].baseline)
			let under = span("mmmm", f, 20.0)
			under.decoration = TextDecoration{underline: true, skipDescenders: false}
			let a = new Canvas(120, 40)
			a.fillText(plain, new Point(0.0, 0.0))
			let b = new Canvas(120, 40)
			b.fillText(new Paragraph([under], 0.0), new Point(0.0, 0.0))
			// Below the baseline "mmmm" has no ink; the underline does.
			assert inkIn(a, base + 1, base + 6) == 0 && inkIn(b, base + 1, base + 6) > 0
			let struck = span("mmmm", f, 20.0)
			struck.decoration = TextDecoration{strikethrough: true}
			let c = new Canvas(120, 40)
			c.fillText(new Paragraph([struck], 0.0), new Point(0.0, 0.0))
			assert inkIn(c, 0, base) > inkIn(a, 0, base)
			let shaded = span("mmmm", f, 20.0)
			shaded.background = new Color(RGBA{r: 200, g: 0, b: 0, a: 255})
			let d = new Canvas(120, 40)
			let line = new Paragraph([shaded], 0.0)
			d.fillText(line, new Point(0.0, 0.0))
			// Filled from the line's top to its bottom, under and beside the letters.
			assert int(d.pixels[((int(line.lines()[0].top) + 1) * 120 + 2) * 4]) == 200
		}

		// A shifted span is raised from the baseline, and its line grows to hold it.
		@test()
		def shiftedSpansRise() !none {
			let f = try face()
			let up = span("2", f)
			up.shift = 6.0
			let p = new Paragraph([span("x", f), up], 0.0)
			let line = p.lines()[0]
			assert (line.glyphs[1].y - (line.baseline - 6.0)).abs() < 0.01 && (line.glyphs[0].y - line.baseline).abs() < 0.01
			let flat = new Paragraph([span("x2", f)], 0.0).lines()[0]
			assert line.bottom - line.top > flat.bottom - flat.top
		}

		// Features turn on or off what the font does by default.
		@test()
		def featuresReachTheShaper() !none {
			let f = try face()
			let on = layoutText("ffi", TextStyle{face: f})
			let off = layoutText("ffi", TextStyle{face: f, features: {"liga": 0}})
			assert off.glyphs.len() == 3 && on.glyphs.len() <= off.glyphs.len()
		}

		// Text that starts right to left is shaped right to left by itself.
		@test()
		def rightToLeftTextShapesRightToLeft() !none {
			let f = try face()
			let hebrew = string(char(0x05D0)) + string(char(0x05D1))
			assert layoutText(hebrew, TextStyle{face: f}).rtl
			assert !layoutText(hebrew, TextStyle{face: f, direction: Direction.LeftToRight}).rtl
			assert !layoutText("ab", TextStyle{face: f}).rtl
		}

		@test()
		def drawsEveryRun() !none {
			let f = try face()
			let p = new Paragraph([span("ink ", f, 20.0), span("here", f, 20.0)], 300.0)
			let cv = new Canvas(200, 40)
			cv.fillText(p, new Point(0.0, 0.0))
			let direct = new Canvas(200, 40)
			let l = p.lines()[0]
			direct.fillText("ink here", new Point(0.0, l.baseline), TextStyle{face: f, size: 20(px)}, ink())
			let a = 0
			let b = 0
			for let i = 3; i < cv.pixels.len(); i += 4 {
				a += int(cv.pixels[i])
				b += int(direct.pixels[i])
			}
			assert a > 0 && (a - b).abs() < a / 50
		}
	}
}
