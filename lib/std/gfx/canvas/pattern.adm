partial module std.gfx.canvas {
	use (
		std.gfx::Raster
		std.math.geom::(Rect, Transform2D)
		std.simd
	)

	// Pattern's shader, and drawImage's: device pixels mapped back into the
	// source's pixels, sampled in linear light, premultiplied.
	internal type PatternShader {
		internal px       byte[]
		internal stride   int
		// The window of the source that tiles: origin and size in pixels.
		internal wx, wy   int
		internal ww, wh   int
		internal repeatX  Spread
		internal repeatY  Spread
		internal sampling Sampling
		// Device pixel centre to source pixel coordinates.
		internal inv      Transform2D
		internal reaches  bool

		// `window` is the part of `src` that tiles (right < 0 is all of it);
		// `t` maps source pixels to device pixels.
		def new(src Raster, window Rect, repeatX Spread, repeatY Spread, t Transform2D, sampling Sampling) {
			self.repeatX = repeatX
			self.repeatY = repeatY
			self.sampling = sampling
			let size = src.size()
			px = src.raw()
			stride = src.stride()
			wx = 0
			wy = 0
			ww = int(size.width)
			wh = int(size.height)
			if window.right >= 0.0 {
				wx = int(window.left).clamp(0, ww)
				wy = int(window.top).clamp(0, wh)
				ww = (int(window.right).min(ww) - wx).max(0)
				wh = (int(window.bottom).min(wh) - wy).max(0)
			}
			// Device pixels to texels of the window.
			inv = new Transform2D(tx = -float(wx), ty = -float(wy)).then(t.inverse())
			reaches = ww > 0 && wh > 0 && isFinite(inv)
			// Shrinking by more than half: halve the window in linear light
			// until each device pixel covers at most two source pixels, so
			// the samples do not skip detail.
			if reaches && sampling != Sampling.Nearest {
				for maxScale(inv) > 2.0 && ww > 1 && wh > 1 {
					halve()
				}
			}
		}

		// Replaces the window by its 2x2 box average, premultiplied in linear
		// light, and maps the transform to it.
		internal def halve() {
			let nw = (ww + 1) / 2
			let nh = (wh + 1) / 2
			let out byte[]
			out.len(nw * nh * 4)
			for let y = 0; y < nh; y++ {
				for let x = 0; x < nw; x++ {
					let sum = simd.splat4<float32>(float32(0.0))
					let alpha = float32(0.0)
					for let k = 0; k < 4; k++ {
						let sx = (x * 2 + (k & 1)).min(ww - 1)
						let sy = (y * 2 + (k >> 1)).min(wh - 1)
						let (c, a) = texel(wx + sx, wy + sy)
						sum = sum + c
						alpha += a
					}
					storeLinear(out, (y * nw + x) * 4, sum * simd.splat4<float32>(float32(0.25)), alpha * float32(0.25))
				}
			}
			px = out
			stride = nw * 4
			wx = 0
			wy = 0
			ww = nw
			wh = nh
			inv = new Transform2D(a = 0.5, d = 0.5).then(inv)
		}

		// The texel at (x, y) as premultiplied linear r, g, b (last lane
		// unused) and its alpha.
		internal def texel(x int, y int) (vec4<float32>, float32) {
			let o = y * stride + x * 4
			let a = float32(px[o + 3]) / float32(255.0)
			let c = simd.load4<float32>(float32[srgbToLinearTable[int(px[o])], srgbToLinearTable[int(px[o + 1])], srgbToLinearTable[int(px[o + 2])], float32(0.0)], 0)
			return (c * simd.splat4<float32>(a), a)
		}

		// Shade implements Shader.
		def shade(x0 int, y int, n int, out byte[]) {
			let py = float(y) + 0.5
			let ux = inv.a * (float(x0) + 0.5) + inv.c * py + inv.tx
			let uy = inv.b * (float(x0) + 0.5) + inv.d * py + inv.ty
			for let i = 0; i < n; i++ {
				let o = i * 4
				if !reaches {
					out[o] = 0
					out[o + 1] = 0
					out[o + 2] = 0
					out[o + 3] = 0
					continue
				}
				let u = ux + inv.a * float(i)
				let v = uy + inv.b * float(i)
				match sampling {
					case Sampling.Nearest:
						let sx = spreadIndex(int(u.floor()), ww, repeatX)
						let sy = spreadIndex(int(v.floor()), wh, repeatY)
						let s = (wy + sy) * stride + (wx + sx) * 4
						out[o] = px[s]
						out[o + 1] = px[s + 1]
						out[o + 2] = px[s + 2]
						out[o + 3] = px[s + 3]
					case Sampling.Bilinear:
						bilinear(u - 0.5, v - 0.5, out, o)
					case Sampling.Bicubic:
						bicubic(u - 0.5, v - 0.5, out, o)
				}
			}
		}

		// The four texels around (u, v) in texel-centre coordinates, weighted.
		internal def bilinear(u, v float, out byte[], o int) {
			let fx = u.floor()
			let fy = v.floor()
			let tx = float32(u - fx)
			let ty = float32(v - fy)
			let x0 = int(fx)
			let y0 = int(fy)
			let xa = wx + spreadIndex(x0, ww, repeatX)
			let xb = wx + spreadIndex(x0 + 1, ww, repeatX)
			let ya = wy + spreadIndex(y0, wh, repeatY)
			let yb = wy + spreadIndex(y0 + 1, wh, repeatY)
			let one = float32(1.0)
			let (c00, a00) = texel(xa, ya)
			let (c10, a10) = texel(xb, ya)
			let (c01, a01) = texel(xa, yb)
			let (c11, a11) = texel(xb, yb)
			let w00 = (one - tx) * (one - ty)
			let w10 = tx * (one - ty)
			let w01 = (one - tx) * ty
			let w11 = tx * ty
			let c = c00 * simd.splat4<float32>(w00) + c10 * simd.splat4<float32>(w10) + c01 * simd.splat4<float32>(w01) + c11 * simd.splat4<float32>(w11)
			storeLinear(out, o, c, a00 * w00 + a10 * w10 + a01 * w01 + a11 * w11)
		}

		// Catmull-Rom over the 4x4 texels around (u, v), clamped so colours
		// never exceed their alpha.
		internal def bicubic(u, v float, out byte[], o int) {
			let fx = u.floor()
			let fy = v.floor()
			let x0 = int(fx) - 1
			let y0 = int(fy) - 1
			let (wx0, wx1, wx2, wx3) = catmullRom(float32(u - fx))
			let (wy0, wy1, wy2, wy3) = catmullRom(float32(v - fy))
			let wxs = float32[wx0, wx1, wx2, wx3]
			let wys = float32[wy0, wy1, wy2, wy3]
			let c = simd.splat4<float32>(float32(0.0))
			let a = float32(0.0)
			for let j = 0; j < 4; j++ {
				let sy = wy + spreadIndex(y0 + j, wh, repeatY)
				for let i = 0; i < 4; i++ {
					let w = wxs[i] * wys[j]
					let (tc, ta) = texel(wx + spreadIndex(x0 + i, ww, repeatX), sy)
					c = c + tc * simd.splat4<float32>(w)
					a += ta * w
				}
			}
			a = a.clamp(float32(0.0), float32(1.0))
			c = c.clamp(simd.splat4<float32>(float32(0.0)), simd.splat4<float32>(a))
			storeLinear(out, o, c, a)
		}
	}

	// Catmull-Rom weights for the four taps around a fraction t.
	internal def catmullRom(t float32) (float32, float32, float32, float32) {
		let t2 = t * t
		let t3 = t2 * t
		let h = float32(0.5)
		return (h * (-t3 + float32(2.0) * t2 - t), h * (float32(3.0) * t3 - float32(5.0) * t2 + float32(2.0)), h * (float32(-3.0) * t3 + float32(4.0) * t2 + t), h * (t3 - t2))
	}

	// Writes premultiplied linear colour c with alpha a as a straight sRGB
	// pixel.
	internal def storeLinear(out byte[], o int, c vec4<float32>, a float32) {
		if a <= float32(0.0) {
			out[o] = 0
			out[o + 1] = 0
			out[o + 2] = 0
			out[o + 3] = 0
			return
		}
		let k = (c / simd.splat4<float32>(a)).clamp(simd.splat4<float32>(float32(0.0)), simd.splat4<float32>(float32(1.0))) * simd.splat4<float32>(float32(4095.0)) + simd.splat4<float32>(float32(0.5))
		let idx = simd.convert<float32, int32>(k)
		out[o] = linearToSrgbTable[int(idx.lane(0))]
		out[o + 1] = linearToSrgbTable[int(idx.lane(1))]
		out[o + 2] = linearToSrgbTable[int(idx.lane(2))]
		out[o + 3] = byte(int(a.min(float32(1.0)) * float32(255.0) + float32(0.5)))
	}

	// A texel index along an axis of n texels under the spread.
	internal def spreadIndex(i int, n int, spread Spread) int {
		match spread {
			case Spread.Repeat:
				let m = i % n
				return m < 0 ?? (m + n, m)
			case Spread.Reflect:
				let p = 2 * n
				let m = i % p
				m += p when m < 0
				return m < n ?? (m, p - 1 - m)
			default:
		}
		return i.clamp(0, n - 1)
	}
}
