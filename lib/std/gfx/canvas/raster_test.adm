partial module std.gfx.canvas {
	use (
		std.testing
		std.gfx.color::(Color, RGBA)
		std.math::Pi
		std.math.geom::(Circle, FillRule, Line, LineCap, Path, Point, Rect, StrokeStyle)
		std.units::Pixels
	)

	check "Rasterizer" {
		def alphaAt(cv Canvas, x int, y int) int {
			return int(cv.pixels[(y * cv.width + x) * 4 + 3])
		}

		def near(a int, b int, tol int = 1) bool {
			return (a - b).abs() <= tol
		}

		def rgba(r int, g int, b int, a int) Color {
			return new Color(RGBA{r: byte(r), g: byte(g), b: byte(b), a: byte(a)})
		}

		def red() Color {
			return rgba(255, 0, 0, 255)
		}

		@test()
		def coverageIsTheAreaInsideEachPixel() {
			let cv = new Canvas(10, 10)
			cv.fill(Rect{left: 2.5, top: 2.5, right: 7.5, bottom: 7.5}, red())
			assert alphaAt(cv, 5, 5) == 255
			assert near(alphaAt(cv, 2, 5), 128)
			assert near(alphaAt(cv, 7, 5), 128)
			assert near(alphaAt(cv, 2, 2), 64)
			assert alphaAt(cv, 1, 1) == 0 && alphaAt(cv, 8, 5) == 0
			// Straight alpha: an edge pixel keeps the full colour, no dark fringe.
			let i = (5 * 10 + 2) * 4
			assert cv.pixels[i] == 255 && cv.pixels[i + 1] == 0
		}

		@test()
		def circleCoversItsArea() {
			let cv = new Canvas(64, 64)
			cv.fill(new Circle(new Point(32.0, 32.0), 20.0), red())
			let total = 0.0
			for let y = 0; y < 64; y++ {
				for let x = 0; x < 64; x++ {
					total += float(alphaAt(cv, x, y)) / 255.0
				}
			}
			assert (total - Pi * 400.0).abs() < Pi * 400.0 * 0.005
			assert alphaAt(cv, 32, 32) == 255 && alphaAt(cv, 2, 2) == 0
		}

		@test()
		def fillRulesDecideTheHole() {
			let p = new Path().rect(Rect{left: 0.0, top: 0.0, right: 20.0, bottom: 20.0}).rect(Rect{left: 5.0, top: 5.0, right: 15.0, bottom: 15.0})
			let nonZero = new Canvas(20, 20)
			nonZero.fill(p, red())
			assert alphaAt(nonZero, 10, 10) == 255
			let evenOdd = new Canvas(20, 20)
			evenOdd.fill(p, red(), FillRule.EvenOdd)
			assert alphaAt(evenOdd, 10, 10) == 0
			assert alphaAt(evenOdd, 2, 10) == 255
		}

		@test()
		def shapesPastTheEdgesKeepTheirWinding() {
			// Half off the left edge: the part inside still fills.
			let cv = new Canvas(10, 10)
			cv.fill(new Path().rect(Rect{left: -5.0, top: 0.0, right: 5.0, bottom: 10.0}), red())
			assert alphaAt(cv, 0, 5) == 255 && alphaAt(cv, 4, 5) == 255 && alphaAt(cv, 5, 5) == 0
			// Larger than the canvas, over many bands.
			let big = new Canvas(100, 100)
			big.fill(new Circle(new Point(50.0, 50.0), 200.0), red())
			assert alphaAt(big, 0, 0) == 255 && alphaAt(big, 99, 99) == 255 && alphaAt(big, 50, 17) == 255
			// Entirely outside: nothing.
			let outside = new Canvas(10, 10)
			outside.fill(new Circle(new Point(-50.0, 5.0), 10.0), red())
			assert canvasChecksum(outside) == canvasChecksum(new Canvas(10, 10))
		}

		@test()
		def wholePixelRectsTakeEitherPath() {
			// The span fast path and the rasterizer land on the same pixels.
			let b = new Canvas(16, 16)
			b.fill(Rect{left: 3.0, top: 2.0, right: 11.0, bottom: 9.0}, red())
			let c = new Canvas(16, 16)
			c.fill(new Path().rect(Rect{left: 3.0, top: 2.0, right: 11.0, bottom: 9.0}), red())
			assert canvasChecksum(c) == canvasChecksum(b)
			assert alphaAt(b, 3, 2) == 255 && alphaAt(b, 10, 8) == 255 && alphaAt(b, 11, 8) == 0 && alphaAt(b, 3, 9) == 0
		}

		@test()
		def strokesPaintTheOutline() {
			let cv = new Canvas(12, 12)
			cv.stroke(new Line(new Point(1.0, 5.0), new Point(9.0, 5.0)), red(), StrokeStyle{width: 2(px)})
			assert alphaAt(cv, 5, 4) == 255 && alphaAt(cv, 5, 5) == 255
			assert alphaAt(cv, 5, 3) == 0 && alphaAt(cv, 5, 6) == 0
			assert alphaAt(cv, 0, 5) == 0 && alphaAt(cv, 9, 5) == 0
			let capped = new Canvas(12, 12)
			capped.stroke(new Line(new Point(1.0, 5.0), new Point(9.0, 5.0)), red(), StrokeStyle{width: 2(px), cap: LineCap.Square})
			assert alphaAt(capped, 0, 5) == 255 && alphaAt(capped, 9, 5) == 255
			// A rectangle's outline leaves its inside alone.
			let box = new Canvas(12, 12)
			box.stroke(Rect{left: 2.0, top: 2.0, right: 10.0, bottom: 10.0}, red(), StrokeStyle{width: 2(px)})
			assert alphaAt(box, 2, 6) == 255 && alphaAt(box, 6, 6) == 0
			let rounded = new Canvas(12, 12)
			rounded.fill(Rect{left: 0.0, top: 0.0, right: 12.0, bottom: 12.0}, 4.0, red())
			assert alphaAt(rounded, 0, 0) == 0 && alphaAt(rounded, 6, 6) == 255
		}

		@test()
		def translucentPaintBlends() {
			// Half red over opaque blue.
			let cv = new Canvas(4, 4)
			cv.clear(rgba(0, 0, 255, 255))
			cv.fill(new Path().rect(Rect{left: 0.0, top: 0.0, right: 4.0, bottom: 4.0}), rgba(255, 0, 0, 128))
			assert near(int(cv.pixels[0]), 128) && near(int(cv.pixels[2]), 127) && cv.pixels[3] == 255
			// Half red over half blue: straight alpha, 75% opaque, red two thirds.
			let tr = new Canvas(4, 4)
			tr.clear(rgba(0, 0, 255, 128))
			tr.fill(new Path().rect(Rect{left: 0.0, top: 0.0, right: 4.0, bottom: 4.0}), rgba(255, 0, 0, 128))
			assert near(int(tr.pixels[3]), 192)
			assert near(int(tr.pixels[0]), 170) && near(int(tr.pixels[2]), 85)
		}
	}
}
