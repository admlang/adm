partial module std.gfx.canvas {
	use (
		std.gfx.color::(Color, RGBA)
		std.math.geom::(Transform2D, Vec2, Vec3, Vec4)
		std.simd
	)

	// ShaderPaint colours every pixel with a `@fragment` function: the
	// function gets the pixel centre in the paint's space (user space moved by
	// `transform`) and returns straight sRGB red, green, blue and alpha from 0
	// to 1. The same function runs on the CPU canvas eight pixels at a time
	// and in the GPU canvas's shaders, with the same result; SVG and PDF show
	// it as pixels.
	//
	// ```adm
	// @fragment
	// def ripple(p Vec2, time float, center Vec2) Vec4 { … }
	//
	// cv.fill(shape, new ShaderPaint(ripple, time = t, center = c))
	// ```
	//
	// Named arguments after the function set its parameters; `set` changes
	// one later, as an animation does each frame.
	type ShaderPaint {
		shader    Fragment
		// The parameter values, packed as `shader.params` lays them out.
		uniforms  float32[]
		transform Transform2D

		def new(shader Fragment, uniforms float32[] = [], transform = new Transform2D()) {
			self.shader = shader
			self.uniforms = uniforms.clone()
			self.uniforms.len(shader.size) when self.uniforms.len() < shader.size
			self.transform = transform
		}

		// Sets the parameter called name; a parameter the function does not
		// have, or of another type, is ignored.
		def set(name string, value float) {
			let p = shader.param(name)
			if !(p is none) {
				if p.kind == FragmentKind.Float32 {
					uniforms[p.offset] = float32(value)
				}
			}
		}

		// Sets the int parameter called name.
		def set(name string, value int) {
			let p = shader.param(name)
			if !(p is none) {
				if p.kind == FragmentKind.Int32 {
					uniforms[p.offset] = float32(value)
				} else if p.kind == FragmentKind.Float32 {
					uniforms[p.offset] = float32(value)
				}
			}
		}

		// Sets the bool parameter called name.
		def set(name string, value bool) {
			let p = shader.param(name)
			if !(p is none) {
				if p.kind == FragmentKind.Bool {
					uniforms[p.offset] = value ?? (float32(1), float32(0))
				}
			}
		}

		// Sets the Vec2 parameter called name.
		def set(name string, value Vec2) {
			let p = shader.param(name)
			if !(p is none) {
				if p.kind == FragmentKind.Vec2 {
					uniforms[p.offset] = float32(value.x)
					uniforms[p.offset + 1] = float32(value.y)
				}
			}
		}

		// Sets the Vec3 parameter called name.
		def set(name string, value Vec3) {
			let p = shader.param(name)
			if !(p is none) {
				if p.kind == FragmentKind.Vec3 {
					uniforms[p.offset] = float32(value.x)
					uniforms[p.offset + 1] = float32(value.y)
					uniforms[p.offset + 2] = float32(value.z)
				}
			}
		}

		// Sets the Vec4 parameter called name.
		def set(name string, value Vec4) {
			let p = shader.param(name)
			if !(p is none) {
				if p.kind == FragmentKind.Vec4 {
					uniforms[p.offset] = float32(value.x)
					uniforms[p.offset + 1] = float32(value.y)
					uniforms[p.offset + 2] = float32(value.z)
					uniforms[p.offset + 3] = float32(value.w)
				}
			}
		}
	}

	// A shader paint's CPU shader: eight pixel centres a call through the
	// fragment's 8-lane code, rounded to 8 bits (no dither, as the GPU
	// writes it).
	internal type FragmentShader {
		internal fragment Fragment
		internal shade8   def(float32, float32, float32, float32, float32[], float32[], int) none
		internal uniforms float32[]
		// Device pixels to the paint's space.
		internal inv      Transform2D
		internal reaches  bool
		internal planes   float32[]
		internal bytes    int32[]

		def new(fragment Fragment, uniforms float32[], inv Transform2D) {
			self.fragment = fragment
			shade8 = fragment.shade8
			self.uniforms = uniforms
			self.inv = inv
			reaches = isFinite(inv)
			planes.len(32)
			bytes.len(32)
		}

		// Shade implements Shader.
		def shade(x0 int, y int, n int, out byte[]) {
			if !reaches {
				for let i = 0; i < n * 4; i++ {
					out[i] = byte(0)
				}
				return
			}
			let py = float(y) + 0.5
			let dx = float32(inv.a)
			let dy = float32(inv.b)
			let zero = simd.splat8<float32>(float32(0.0))
			let one = simd.splat8<float32>(float32(1.0))
			let scale = simd.splat8<float32>(float32(255.0))
			let half = simd.splat8<float32>(float32(0.5))
			for let i = 0; i < n; i += 8 {
				let px = float(x0 + i) + 0.5
				shade8(float32(inv.a * px + inv.c * py + inv.tx), float32(inv.b * px + inv.d * py + inv.ty), dx, dy, uniforms, planes, 0)
				for let c = 0; c < 4; c++ {
					let v = simd.load8<float32>(planes, c * 8)
					let q = v.max(zero).min(one) * scale + half
					simd.store8<int32>(bytes, c * 8, simd.convert<float32, int32>(q))
				}
				let count = (n - i).min(8)
				let o = i * 4
				for let k = 0; k < count; k++ {
					out[o] = byte(bytes[k])
					out[o + 1] = byte(bytes[8 + k])
					out[o + 2] = byte(bytes[16 + k])
					out[o + 3] = byte(bytes[24 + k])
					o += 4
				}
			}
		}
	}
}
