partial module std.gfx.canvas {
	use (
		std.testing
		std.gfx.color::RGBA
		std.math.geom::(Rect, Transform2D, Vec2, Vec4)
		std.simd
	)

	// A real @fragment paint function: red rises along x.
	@fragment
	def redRamp(p Vec2, width float, alpha float = 1.0) Vec4 {
		return new Vec4(p.x / width, 0, 0, alpha)
	}

	check "Shader paint" {
		def px(cv Canvas, x int, y int) RGBA {
			let i = (y * cv.width + x) * 4
			return RGBA{r: cv.pixels[i], g: cv.pixels[i + 1], b: cv.pixels[i + 2], a: cv.pixels[i + 3]}
		}

		// What the compiler makes of
		//   @fragment def ramp(p Vec2, width float, origin Vec2, on bool) Vec4 {
		//   	let q = (p - origin) / width
		//   	return new Vec4(q.x, q.y, 0, on ?? (1.0, 0.0))
		//   }
		def ramp8(x float32, y float32, dx float32, dy float32, u float32[], out float32[], at int) none {
			let lanes = simd.load8<float32>(laneOffsets, 0)
			let xs = simd.splat8<float32>(x) + lanes * simd.splat8<float32>(dx)
			let ys = simd.splat8<float32>(y) + lanes * simd.splat8<float32>(dy)
			let w = simd.splat8<float32>(u[0])
			((xs - simd.splat8<float32>(u[1])) / w).store(out, at)
			((ys - simd.splat8<float32>(u[2])) / w).store(out, at + 8)
			simd.splat8<float32>(float32(0)).store(out, at + 16)
			simd.splat8<float32>(u[3]).store(out, at + 24)
		}

		def ramp() Fragment {
			let params = [
				FragmentParam{name: "width", kind: FragmentKind.Float32, offset: 0},
				FragmentParam{name: "origin", kind: FragmentKind.Vec2, offset: 1},
				FragmentParam{name: "on", kind: FragmentKind.Bool, offset: 3},
			]
			return new Fragment("test.ramp", params, 4, "", "adm_f_ramp", [], ramp8)
		}

		@test()
		def pixelsComeFromTheFunction() {
			let paint = new ShaderPaint(ramp(), [float32(100), float32(0), float32(0), float32(1)])
			let cv = new Canvas(100, 20)
			cv.fill(Rect{left: 0.0, top: 0.0, right: 100.0, bottom: 20.0}, paint)
			// Pixel centres: x 0.5 is 0.005 of the way, x 50.5 is 0.505.
			let a = px(cv, 0, 0)
			assert a.r == 1 && a.g == 1 && a.b == 0 && a.a == 255
			let m = px(cv, 50, 10)
			assert m.r == 129 && m.g == 27 && m.a == 255
			// Every pixel of a row, including the last partial group of eight.
			assert px(cv, 99, 19).r == 254 && px(cv, 97, 19).r == 249
		}

		@test()
		def parametersChangeByName() {
			let paint = new ShaderPaint(ramp())
			assert paint.uniforms.len() == 4
			paint.set("width", 50.0)
			paint.set("origin", new Vec2(10, 0))
			paint.set("on", true)
			// Unknown names and the wrong type change nothing.
			paint.set("depth", 3.0)
			paint.set("on", 2.0)
			assert paint.uniforms[0] == float32(50) && paint.uniforms[1] == float32(10) && paint.uniforms[3] == float32(1)
			let cv = new Canvas(60, 4)
			cv.fill(Rect{left: 0.0, top: 0.0, right: 60.0, bottom: 4.0}, paint)
			assert px(cv, 5, 0).r == 0 && px(cv, 35, 0).r == 130
			paint.set("on", false)
			let off = new Canvas(60, 4)
			off.fill(Rect{left: 0.0, top: 0.0, right: 60.0, bottom: 4.0}, paint)
			assert px(off, 35, 0).a == 0
		}

		@test()
		def positionsAreInThePaintsSpace() {
			// Scaled by 2 and moved by 10: device x 30.5 is shader x 10.25.
			let paint = new ShaderPaint(ramp(), [float32(20), float32(0), float32(0), float32(1)], new Transform2D(a = 2.0, d = 2.0, tx = 10.0))
			let cv = new Canvas(60, 4)
			cv.fill(Rect{left: 0.0, top: 0.0, right: 60.0, bottom: 4.0}, paint)
			assert px(cv, 30, 0).r == 131
			// The canvas transform moves the paint with the shape.
			let moved = new Canvas(60, 4)
			moved.translate(20.0, 0.0)
			moved.fill(Rect{left: -20.0, top: 0.0, right: 40.0, bottom: 4.0}, paint)
			assert px(moved, 50, 0).r == 131
		}

		@test()
		def exportsShowShadersAsPixels() {
			let pic = record((p Painter) => {
				p.fill(Rect{left: 0.0, top: 0.0, right: 40.0, bottom: 40.0}, new ShaderPaint(ramp(), [float32(40), float32(0), float32(0), float32(1)]))
			})
			let svg = pic.svg()
			assert svg.contains("<image")
			assert pic.pdf().len() > 0
		}

		@test()
		def fragmentFunctionsPaint() {
			// Named arguments set the uniforms; the default fills the rest.
			let paint = new ShaderPaint(redRamp, width = 100.0)
			assert paint.uniforms.len() == 2 && paint.uniforms[0] == float32(100) && paint.uniforms[1] == float32(1)
			let cv = new Canvas(100, 2)
			cv.fill(Rect{left: 0.0, top: 0.0, right: 100.0, bottom: 2.0}, paint)
			assert px(cv, 50, 0).r == 129 && px(cv, 50, 0).a == 255
			paint.set("alpha", 0.5)
			let half = new Canvas(100, 2)
			half.fill(Rect{left: 0.0, top: 0.0, right: 100.0, bottom: 2.0}, paint)
			assert px(half, 50, 0).a == 128
			assert paint.shader.glsl.contains("adm_u_width") && paint.shader.entry != ""
		}
	}
}
