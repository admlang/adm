partial module std.gfx.canvas {
	use (
		std.gfx.color::BlendMode
		std.math::sqrt
		std.simd
		std.math.geom::(Rect, Transform2D)
	)

	// Composite is the Porter-Duff operator: which of source and destination
	// survive where they overlap. BlendMode is how the colours mix; CSS and
	// Canvas 2D keep the two separate, and so does this. As in Canvas 2D,
	// SourceIn, SourceOut, DestinationIn, DestinationAtop and Copy also clear
	// what lies outside the shape (inside the clip).
	enum Composite {
		SourceOver,  // the default
		SourceIn,
		SourceOut,
		SourceAtop,
		DestinationOver,
		DestinationIn,
		DestinationOut,  // erasing
		DestinationAtop,
		Xor,
		Copy,
		Clear,
		Plus,  // additive, for glows and particles
	}

	// Sampling is how an image is read when it is drawn scaled or rotated.
	enum Sampling {
		Nearest,
		Bilinear,
		Bicubic,
	}

	// DrawState is the canvas's drawing settings as one value: what `save`
	// pushes and `restore` brings back. `Canvas.state()` returns a copy, so a
	// kept state can be set again later.
	struct DrawState {
		// User space to device pixels.
		transform Transform2D = new Transform2D()
		// Where drawing may touch; none is the whole canvas.
		clip      ?ClipRegion = none
		// Multiplies the paint's opacity, 0.0 to 1.0.
		alpha     float       = 1.0
		composite Composite   = Composite.SourceOver
		blend     BlendMode   = BlendMode.Normal
		antialias bool        = true
		sampling  Sampling    = Sampling.Bilinear
		// The id what is drawn next carries for `Picture.hitTest`; none
		// draws untagged. Drawing ignores it.
		tag       ?int        = none
	}

	// ClipRegion is the area drawing may touch, in device pixels: a box, and
	// inside it an optional coverage per pixel (anti-aliased path clips,
	// masks). It is a gfx.Mask, so it can clip or mask anything else too.
	type ClipRegion {
		internal x0, y0, x1, y1 int
		internal bytes          ?byte[] = none

		// The box `left`..`right`, `top`..`bottom` (right and bottom
		// exclusive), with `mask` as its coverage bytes row by row, or none
		// for full coverage.
		def new(left, top, right, bottom int, mask ?byte[] = none) {
			x0 = left
			y0 = top
			x1 = right.max(left)
			y1 = bottom.max(top)
			bytes = mask
		}

		// The box's first column.
		left int {
			def get() int {
				return x0
			}
		}

		// The box's first row.
		top int {
			def get() int {
				return y0
			}
		}

		// The column after the box.
		right int {
			def get() int {
				return x1
			}
		}

		// The row after the box.
		bottom int {
			def get() int {
				return y1
			}
		}

		// Coverage bytes over the box, row by row (`right - left` a row), or
		// none when all of the box is fully covered. Shared, not copied.
		mask ?byte[] {
			def get() ?byte[] {
				return bytes
			}
		}

		// The box as a rectangle (RowMask: nothing outside it is covered).
		def bounds() ?Rect {
			return Rect{left: float(x0), top: float(y0), right: float(x1), bottom: float(y1)}
		}

		// Whether the box holds no pixels.
		def isEmpty() bool {
			return x0 >= x1 || y0 >= y1
		}

		// How much of the pixel drawing may touch, 0.0 to 1.0.
		def coverage(x, y int) float {
			return 0.0 when x < x0 || y < y0 || x >= x1 || y >= y1
			let m = bytes
			return 1.0 when m is none
			return float(m[(y - y0) * (x1 - x0) + (x - x0)]) / 255.0
		}

		// RowMask: the coverage bytes along the row, 0 outside the box.
		def coverage(x, y int, out float32[]) {
			let n = out.len()
			for let i = 0; i < n; i++ {
				out[i] = float32(0.0)
			}
			return when y < y0 || y >= y1
			let from = x.max(x0)
			let to = (x + n).min(x1)
			return when from >= to
			let m = bytes
			if m is none {
				for let p = from; p < to; p++ {
					out[p - x] = float32(1.0)
				}
				return
			}
			let row = (y - y0) * (x1 - x0) - x0
			let scale = simd.splat8<float32>(float32(1.0 / 255.0))
			let p = from
			for p + 8 <= to {
				simd.store8<float32>(out, p - x, simd.convert<byte, float32>(simd.load8<byte>(m, row + p)) * scale)
				p += 8
			}
			for p < to {
				out[p - x] = float32(m[row + p]) / float32(255.0)
				p++
			}
		}
	}

	// The clip's coverage byte at (x, y), which must be inside its box.
	internal def clipByte(clip ClipRegion, x, y int) int {
		let m = clip.mask
		return 255 when m is none
		return int(m[(y - clip.top) * (clip.right - clip.left) + (x - clip.left)])
	}

	// A copy of the transform, so a kept state does not share it.
	internal def copyTransform(t Transform2D) Transform2D {
		return new Transform2D(a = t.a, b = t.b, c = t.c, d = t.d, tx = t.tx, ty = t.ty)
	}

	// Whether the transform leaves points where they are.
	internal def isIdentity(t Transform2D) bool {
		return t.a == 1.0 && t.b == 0.0 && t.c == 0.0 && t.d == 1.0 && t.tx == 0.0 && t.ty == 0.0
	}

	// How much the transform stretches lengths at most, for flattening
	// tolerances: the larger column length.
	internal def maxScale(t Transform2D) float {
		return sqrt(t.a * t.a + t.b * t.b).max(sqrt(t.c * t.c + t.d * t.d)).max(1e-9)
	}

	// A copy of the state that shares nothing that could change: the
	// transform is copied, clips never change once made.
	internal def copyState(s DrawState) DrawState {
		return DrawState{transform: copyTransform(s.transform), clip: s.clip, alpha: s.alpha, composite: s.composite, blend: s.blend, antialias: s.antialias, sampling: s.sampling, tag: s.tag}
	}
}
