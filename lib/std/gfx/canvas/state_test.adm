partial module std.gfx.canvas {
	use (
		std.testing
		std.gfx::CircleMask
		std.gfx.color::(BlendMode, Color, RGBA)
		std.math::Pi
		std.math.geom::(Circle, FillRule, Line, Path, Point, Rect, StrokeStyle, Transform2D)
		std.units::(Percent, Pixels)
	)

	check "Draw state" {
		def px(cv Canvas, x int, y int) RGBA {
			let i = (y * cv.width + x) * 4
			return RGBA{r: cv.pixels[i], g: cv.pixels[i + 1], b: cv.pixels[i + 2], a: cv.pixels[i + 3]}
		}

		def rgba(r int, g int, b int, a int) Color {
			return new Color(RGBA{r: byte(r), g: byte(g), b: byte(b), a: byte(a)})
		}

		def near(a int, b int, tol int = 1) bool {
			return (a - b).abs() <= tol
		}

		def whole(cv Canvas) Rect {
			return Rect{left: 0.0, top: 0.0, right: float(cv.width), bottom: float(cv.height)}
		}

		@test()
		def saveRestoreAndCopies() {
			let cv = new Canvas(4, 4)
			cv.setAlpha(0.5)
			cv.save()
			cv.setAlpha(1.0)
			cv.translate(3.0, 0.0)
			cv.restore()
			assert cv.state().alpha == 0.5
			assert cv.state().transform.tx == 0.0
			// Restoring with nothing saved does nothing.
			cv.restore()
			assert cv.state().alpha == 0.5
			// state() is a copy.
			let s = cv.state()
			s.alpha = 0.2
			s.transform.tx = 9.0
			assert cv.state().alpha == 0.5 && cv.state().transform.tx == 0.0
			cv.setState(s)
			assert cv.state().alpha == 0.2 && cv.state().transform.tx == 9.0
			cv.setAlpha(50(%))
			assert cv.state().alpha == 0.5
		}

		@test()
		def transformsMoveWhatIsDrawn() {
			let red = rgba(255, 0, 0, 255)
			let moved = new Canvas(10, 10)
			moved.translate(3.0, 3.0)
			moved.fill(Rect{left: 0.0, top: 0.0, right: 2.0, bottom: 2.0}, red)
			assert px(moved, 4, 4).a == 255 && px(moved, 1, 1).a == 0
			let scaled = new Canvas(10, 10)
			scaled.scale(2.0, 2.0)
			scaled.fill(Rect{left: 0.0, top: 0.0, right: 2.0, bottom: 2.0}, red)
			assert px(scaled, 3, 3).a == 255 && px(scaled, 4, 4).a == 0
			// A quarter turn clockwise around (5, 5): right of the centre goes below it.
			let turned = new Canvas(10, 10)
			turned.rotate(Pi / 2.0, new Point(5.0, 5.0))
			turned.fill(Rect{left: 6.0, top: 4.0, right: 9.0, bottom: 6.0}, red)
			assert px(turned, 5, 7).a == 255 && px(turned, 7, 5).a == 0
			turned.resetTransform()
			assert turned.state().transform.a == 1.0
			let set = new Canvas(10, 10)
			set.setTransform(new Transform2D(tx = 5.0))
			set.transform(new Transform2D(ty = 5.0))
			set.fill(Rect{left: 0.0, top: 0.0, right: 1.0, bottom: 1.0}, red)
			assert px(set, 5, 5).a == 255 && px(set, 0, 0).a == 0
		}

		@test()
		def strokesScaleUnlessFixed() {
			let red = rgba(255, 0, 0, 255)
			let line = new Line(new Point(0.0, 2.0), new Point(5.0, 2.0))
			let scaled = new Canvas(20, 20)
			scaled.scale(4.0, 4.0)
			scaled.stroke(line, red, StrokeStyle{width: 1(px)})
			// y from 6 to 10 in device pixels.
			assert px(scaled, 10, 6).a == 255 && px(scaled, 10, 9).a == 255 && px(scaled, 10, 10).a == 0
			let fixed = new Canvas(20, 20)
			fixed.scale(4.0, 4.0)
			fixed.stroke(line, red, StrokeStyle{width: 2(px), fixedWidth: true})
			assert px(fixed, 10, 7).a == 255 && px(fixed, 10, 8).a == 255 && px(fixed, 10, 6).a == 0 && px(fixed, 10, 9).a == 0
		}

		@test()
		def clipsNarrowUntilRestore() {
			let red = rgba(255, 0, 0, 255)
			let cv = new Canvas(10, 10)
			cv.save()
			cv.clip(Rect{left: 0.0, top: 0.0, right: 5.0, bottom: 10.0})
			cv.fill(whole(cv), red)
			assert px(cv, 4, 5).a == 255 && px(cv, 5, 5).a == 0
			// A second clip intersects the first.
			cv.clip(Rect{left: 0.0, top: 0.0, right: 10.0, bottom: 3.0})
			cv.fill(whole(cv), rgba(0, 0, 255, 255))
			assert px(cv, 2, 2).b == 255 && px(cv, 2, 5).r == 255 && px(cv, 7, 2).a == 0
			cv.restore()
			cv.fill(whole(cv), rgba(0, 255, 0, 255))
			assert px(cv, 8, 8).g == 255
		}

		@test()
		def pathClipsAreAntialiased() {
			let cv = new Canvas(21, 21)
			cv.clip(new Path().circle(new Point(10.5, 10.5), 8.0))
			cv.fill(whole(cv), rgba(255, 0, 0, 255))
			assert px(cv, 10, 10).a == 255 && px(cv, 0, 0).a == 0
			// On the rim, part of the pixel.
			let rim = px(cv, 2, 10).a
			assert rim > 0 && rim < 255
			// Without antialias the rim is all or nothing.
			let hard = new Canvas(21, 21)
			hard.clip(new Path().circle(new Point(10.5, 10.5), 8.0), FillRule.NonZero, false)
			hard.fill(whole(hard), rgba(255, 0, 0, 255))
			let edge = px(hard, 2, 10).a
			assert edge == 0 || edge == 255
			// A rotated rectangle clip goes through the path.
			let turned = new Canvas(20, 20)
			turned.rotate(Pi / 4.0, new Point(10.0, 10.0))
			turned.clip(Rect{left: 5.0, top: 5.0, right: 15.0, bottom: 15.0})
			turned.resetTransform()
			turned.fill(whole(turned), rgba(255, 0, 0, 255))
			assert px(turned, 10, 4).a == 255 && px(turned, 5, 5).a == 0
		}

		@test()
		def masksClip() {
			let cv = new Canvas(20, 20)
			cv.clip(new CircleMask(new Circle(new Point(10.0, 10.0), 5.0)))
			cv.fill(whole(cv), rgba(255, 0, 0, 255))
			assert px(cv, 10, 10).a == 255 && px(cv, 1, 1).a == 0
			let region = cv.state().clip
			assert region is ClipRegion
			if region is ClipRegion {
				assert region.coverage(10, 10) == 1.0 && region.coverage(1, 1) == 0.0
			}
		}

		@test()
		def alphaScalesPaint() {
			let cv = new Canvas(4, 4)
			cv.setAlpha(50(%))
			cv.fill(new Path().rect(whole(cv)), rgba(255, 0, 0, 255))
			assert near(int(px(cv, 1, 1).a), 128)
			assert px(cv, 1, 1).r == 255
		}

		@test()
		def compositeOperators() {
			let red = rgba(255, 0, 0, 255)
			let blue = rgba(0, 0, 255, 255)
			let inner = Rect{left: 2.0, top: 2.0, right: 6.0, bottom: 6.0}
			// DestinationOut erases where the shape is.
			let erase = new Canvas(8, 8)
			erase.fill(new Path().rect(whole(erase)), red)
			erase.setComposite(Composite.DestinationOut)
			erase.fill(inner, blue)
			assert px(erase, 3, 3).a == 0 && px(erase, 0, 0).a == 255
			// SourceIn keeps the source only over the destination, and
			// clears outside the shape.
			let within = new Canvas(8, 8)
			within.fill(new Path().rect(whole(within)), red)
			within.setComposite(Composite.SourceIn)
			within.fill(inner, blue)
			assert px(within, 3, 3).b == 255 && px(within, 3, 3).a == 255 && px(within, 0, 0).a == 0
			// DestinationOver draws underneath.
			let under = new Canvas(8, 8)
			under.fill(inner, red)
			under.setComposite(Composite.DestinationOver)
			under.fill(new Path().rect(whole(under)), blue)
			assert px(under, 3, 3).r == 255 && px(under, 0, 0).b == 255
			// Copy replaces, and clears the rest.
			let copy = new Canvas(8, 8)
			copy.fill(new Path().rect(whole(copy)), red)
			copy.setComposite(Composite.Copy)
			copy.fill(inner, rgba(0, 0, 255, 128))
			assert near(int(px(copy, 3, 3).a), 128) && px(copy, 3, 3).b == 255 && px(copy, 0, 0).a == 0
			// Plus adds.
			let plus = new Canvas(8, 8)
			plus.setComposite(Composite.Plus)
			plus.fill(inner, rgba(255, 0, 0, 128))
			plus.fill(inner, rgba(255, 0, 0, 128))
			assert px(plus, 3, 3).a == 255
			// Clear empties the shape.
			let clear = new Canvas(8, 8)
			clear.fill(new Path().rect(whole(clear)), red)
			clear.setComposite(Composite.Clear)
			clear.fill(inner, red)
			assert px(clear, 3, 3).a == 0 && px(clear, 0, 0).a == 255
			// The unbounded operators stay inside the clip.
			let clipped = new Canvas(8, 8)
			clipped.fill(new Path().rect(whole(clipped)), red)
			clipped.clip(Rect{left: 0.0, top: 0.0, right: 4.0, bottom: 8.0})
			clipped.setComposite(Composite.Copy)
			clipped.fill(inner, blue)
			assert px(clipped, 0, 0).a == 0 && px(clipped, 7, 7).r == 255 && px(clipped, 3, 3).b == 255
		}

		@test()
		def blendModesMix() {
			let cv = new Canvas(4, 4)
			cv.fill(new Path().rect(whole(cv)), rgba(128, 128, 128, 255))
			cv.setBlend(BlendMode.Multiply)
			cv.fill(new Path().rect(whole(cv)), rgba(255, 0, 0, 255))
			let p = px(cv, 1, 1)
			assert near(int(p.r), 128) && p.g == 0 && p.a == 255
		}

		@test()
		def tabledBlendMatchesThePixelPath() {
			let modes = [BlendMode.Multiply, BlendMode.Screen, BlendMode.Overlay, BlendMode.SoftLight, BlendMode.Difference, BlendMode.ColorDodge, BlendMode.Xor]
			for let (_, mode) in modes {
				for let (_, a) in [255, 170] {
					// Opaque, translucent and clear pixels, seven a row: one
					// vector group and a tail.
					let cv = new Canvas(7, 3)
					for let x = 0; x < 7; x++ {
						cv.fill(Rect{left: float(x), top: 0.0, right: float(x + 1), bottom: 3.0}, rgba(30 * x, 250 - 30 * x, 90, x == 6 ?? (0, 255 - 40 * x)))
					}
					let before = cv.pixels.clone()
					cv.setBlend(mode)
					// Half-covered top row, whole rows below.
					let shape = Rect{left: 0.0, top: 0.5, right: 7.0, bottom: 3.0}
					let colour = rgba(200, 60, 140, a)
					cv.fill(new Path().rect(shape), colour)
					for let y = 0; y < 3; y++ {
						for let x = 0; x < 7; x++ {
							let want = before.clone()
							let i = (y * 7 + x) * 4
							composePixel(want, i, 200, 60, 140, canvasDiv255(a * (y == 0 ?? (128, 255))), Composite.SourceOver, mode, 255)
							for let ch = 0; ch < 4; ch++ {
								assert near(int(cv.pixels[i + ch]), int(want[i + ch]), 2)
							}
						}
					}
				}
			}
		}

		@test()
		def tabledShadedBlendMatchesThePixelPath() {
			let (w, h) = (133, 130)
			let paint = linear(new Point(0.0, 0.0), new Point(float(w), 40.0), [rgba(255, 0, 0, 255), rgba(0, 200, 90, 160), rgba(20, 40, 255, 255)])
			for let (_, mode) in [BlendMode.Multiply, BlendMode.Overlay, BlendMode.ColorBurn, BlendMode.Exclusion, BlendMode.Xor] {
				let cv = new Canvas(w, h)
				for let x = 0; x < w; x++ {
					let k = x % 7
					cv.fill(Rect{left: float(x), top: 0.0, right: float(x + 1), bottom: float(h)}, rgba(30 * k, 250 - 30 * k, 90, k == 6 ?? (0, 255 - 40 * k)))
				}
				let want = cv.pixels.clone()
				cv.setBlend(mode)
				cv.fill(new Path().rect(Rect{left: 0.0, top: 0.5, right: float(w), bottom: float(h)}), paint)
				let shader = shaderFor(paint, new Transform2D())
				let src byte[]
				src.len((w + 4) * 4)
				for let y = 0; y < h; y++ {
					shader.shade(0, y, w, src)
					for let x = 0; x < w; x++ {
						let cov = y == 0 ?? (128, 255)
						composePixel(want, (y * w + x) * 4, src[x * 4], src[x * 4 + 1], src[x * 4 + 2], canvasDiv255(int(src[x * 4 + 3]) * cov), Composite.SourceOver, mode, 255)
					}
				}
				for let i = 0; i < want.len(); i++ {
					assert near(int(cv.pixels[i]), int(want[i]), 2)
				}
			}
		}

		@test()
		def antialiasOff() {
			let cv = new Canvas(10, 10)
			cv.setAntialias(false)
			cv.fill(Rect{left: 2.5, top: 2.5, right: 7.5, bottom: 7.5}, rgba(255, 0, 0, 255))
			for let y = 0; y < 10; y++ {
				for let x = 0; x < 10; x++ {
					let a = px(cv, x, y).a
					assert a == 0 || a == 255
				}
			}
			assert px(cv, 5, 5).a == 255 && px(cv, 1, 1).a == 0
		}

		@test()
		def hitTestingFollowsTheTransform() {
			let cv = new Canvas(20, 20)
			cv.translate(10.0, 0.0)
			let square = new Path().rect(Rect{left: 0.0, top: 0.0, right: 5.0, bottom: 5.0})
			assert cv.isInPath(square, new Point(12.0, 2.0))
			assert !cv.isInPath(square, new Point(2.0, 2.0))
			assert cv.isInStroke(square, new Point(10.0, 2.0), StrokeStyle{width: 2(px)})
			assert !cv.isInStroke(square, new Point(12.5, 2.5), StrokeStyle{width: 2(px)})
		}
	}
}
