partial module std.gfx.canvas {
	use (
		std.formats.fonts
		std.gfx.canvas.glyphs as colorglyphs
		std.gfx.color::(Color)
		std.gfx.text as textcache
		std.mem
		std.math::sqrt
		std.math.geom::(Path, PathVerb, Point, Rect, Transform2D)
		std.text.unicode
		std.units::(FontRelative, Pixels)
	)

	// TextAlign is where text sits against its anchor point along the line:
	// Start and End follow the text's direction.
	enum TextAlign {
		Start,
		Center,
		End,
	}

	// TextBaseline is which line of the text the anchor point is on.
	enum TextBaseline {
		Alphabetic,   // the baseline Latin letters sit on
		Top,          // the top of the em box (the ascent)
		Middle,       // halfway between the ascent and the descent
		Bottom,       // the bottom of the em box (the descent)
		Hanging,      // the hanging baseline of Indic scripts
		Ideographic,  // the bottom of ideographic characters
	}

	// TextOrientation is how a line of text runs (CSS text-orientation).
	enum TextOrientation {
		Horizontal,  // left to right (or right to left), glyphs upright
		Upright,     // down the line, each glyph upright and centred on it
		Sideways,    // horizontal text turned 90 degrees clockwise
	}

	// TextStyle is how text is set: the face, its size, where it sits
	// against the anchor, and the space between glyphs. A font-relative
	// `size` is of `rootSize`; a font-relative `spacing` is of the text's own
	// size.
	struct TextStyle {
		face        fonts.Face
		size        Pixels | FontRelative = 16(px)
		align       TextAlign             = TextAlign.Start
		baseline    TextBaseline          = TextBaseline.Alphabetic
		// Extra space between glyphs.
		spacing     Pixels | FontRelative = 0(px)
		// Draws the face's hinted outlines at the device pixel size when the
		// transform neither rotates nor skews.
		hinting     bool                  = true
		// What 1(em) is for `size`: pass the system UI font's size
		// (`UI.appearance().font.size` in std.ui) to follow the user's setting.
		rootSize    Pixels                = 16(px)
		// ISO 15924 script whose baselines the anchor uses ("Latn", "Deva",
		// "Hani"); empty takes the text's dominant script, and the font's
		// default for text that names none (digits, punctuation).
		script      string                = ""
		// Horizontal, or a vertical line: Upright stacks the glyphs down from
		// the anchor with the face's vertical metrics (vmtx, VORG) and
		// vertical forms (`vert`), `align` along the line and the anchor on
		// its centre line for Alphabetic and Middle, its right (over) side
		// for Top and Hanging, its left (under) side for Bottom and
		// Ideographic; Sideways lays the run
		// out as Horizontal, `align` and `baseline` included, and turns it
		// clockwise about the anchor. Text along a path is always
		// horizontal.
		orientation TextOrientation       = TextOrientation.Horizontal
	}

	// TextMetrics is the layout of a run of text in user space, relative to
	// the anchor point the text is drawn at, with `align` and `baseline`
	// applied: the baseline is at y = 0 only for Alphabetic.
	struct TextMetrics {
		// How far the pen moves across the whole run.
		advance float
		// The face's ascent above and descent below the baseline, positive.
		ascent  float
		descent float
		// The box of the ink the glyphs paint.
		bounds  Rect
		// Each glyph, in visual order.
		glyphs  GlyphBox[]
	}

	// GlyphBox is one placed glyph: where its pen position is, how far it
	// advances, the box its ink covers, and the byte index of the text it
	// came from (cursor placement, hit testing, selection).
	struct GlyphBox {
		glyph   fonts.GlyphID
		x       float
		y       float
		advance float
		bounds  Rect
		cluster int
	}

	// A shaped run laid out at a size: pixels per font unit, pen positions
	// relative to the start, and the face metrics.
	internal struct TextLayout {
		scale   float
		size    float
		glyphs  GlyphBox[]
		advance float
		ascent  float
		descent float
		rtl     bool
		// Stacked down the line (TextOrientation.Upright): pen positions and
		// advances run along y.
		upright bool
		// Where each baseline sits above the glyph origin, in pixels.
		lines   BaselineSet
	}

	// The baselines of a run, in pixels above the glyph origin (y up): from
	// the font's BASE table, or synthesized as CSS Inline 3 appendix A.2 says
	// where the font records none.
	internal struct BaselineSet {
		alphabetic float
		hanging    float
		under      float
		over       float
	}

	// The text size in pixels.
	internal def textSize(s TextStyle) float {
		match s.size {
			case FontRelative:
				return float(s.size) * float(s.rootSize)
			case Pixels:
				return float(s.size)
		}
		return 16.0
	}

	// The glyph spacing in pixels.
	internal def textSpacing(s TextStyle, size float) float {
		match s.spacing {
			case FontRelative:
				return float(s.spacing) * size
			case Pixels:
				return float(s.spacing)
		}
		return 0.0
	}

	// The script whose baselines anchor the text: `script`, else the
	// text's dominant one, else "" for the font's default.
	internal def baseScript(text string, script string) string {
		return script when script != ""
		let guess = unicode.script(text)
		return guess == "Zyyy" ?? ("", guess)
	}

	// Shapes and lays out the text, pen positions from 0 along the baseline.
	internal def layoutText(text string, s TextStyle) TextLayout {
		let size = textSize(s)
		let face = s.face
		let upm = float(face.info().unitsPerEm).max(1.0)
		let scale = size / upm
		let spacing = textSpacing(s, size)
		let upright = s.orientation == TextOrientation.Upright
		let opts = fonts.ShapeOptions{}
		opts.direction = fonts.TextDirection.TopToBottom when upright
		// Shaped once, then from the program-wide cache.
		let run = textcache.cache().shaped(face, text, opts)
		let m = face.metrics()
		let out TextLayout = TextLayout{scale: scale, size: size, glyphs: GlyphBox[], advance: 0.0, ascent: float(m.ascent) * scale, descent: (-float(m.descent)) * scale, rtl: run.direction == fonts.TextDirection.RightToLeft, upright: upright, lines: resolveBaselines(face, baseScript(text, s.script), scale, upm)}
		let pen = 0.0
		if upright {
			// Offsets are from the vertical origin (the top centre of the
			// glyph's em box), which sits on the line; advances are negative
			// (font units are y up).
			for let (i, g) in run.glyphs {
				let adv = -float(g.yAdvance) * scale
				let x = float(g.xOffset) * scale
				let y = pen - float(g.yOffset) * scale
				let b = glyphBounds(face, g.glyph, scale)
				out.glyphs.push(GlyphBox{glyph: g.glyph, x: x, y: y, advance: adv, bounds: Rect{left: b.left + x, top: b.top + y, right: b.right + x, bottom: b.bottom + y}, cluster: g.cluster})
				pen += adv
				pen += spacing when i + 1 < run.glyphs.len()
			}
			out.advance = pen
			return out
		}
		for let (i, g) in run.glyphs {
			let adv = float(g.xAdvance) * scale
			let x = pen + float(g.xOffset) * scale
			let y = -float(g.yOffset) * scale
			let b = glyphBounds(face, g.glyph, scale)
			out.glyphs.push(GlyphBox{glyph: g.glyph, x: x, y: y, advance: adv, bounds: Rect{left: b.left + x, top: b.top + y, right: b.right + x, bottom: b.bottom + y}, cluster: g.cluster})
			pen += adv
			pen += spacing when i + 1 < run.glyphs.len()
		}
		out.advance = pen
		return out
	}

	// The ink box of a glyph at the scale, y down, from its origin (the
	// face's bounds are in font units, y up; blank glyphs give an empty box).
	internal def glyphBounds(face fonts.Face, glyph fonts.GlyphID, scale float) Rect {
		let gm = textcache.cache().glyphMetrics(face, glyph)
		let b = gm.bounds
		return Rect{left: b.left * scale, top: -b.bottom * scale, right: b.right * scale, bottom: -b.top * scale}
	}

	// Where the run starts relative to the anchor: the shift along the line
	// for `align` and down to the baseline for `baseline`.
	internal def anchorShift(l TextLayout, s TextStyle) (float, float) {
		if l.upright {
			// Along the column for `align`; across it the anchor is on the
			// centre line, or on the line `baseline` names turned with the
			// text: the over side (Top, Hanging) to the right, the under side
			// (Bottom, Ideographic) to the left, as CSS sets vertical text.
			let b = l.lines
			let central = (b.over + b.under) / 2.0
			let dx = 0.0
			match s.baseline {
				case TextBaseline.Top:
					dx = central - b.over
				case TextBaseline.Hanging:
					dx = central - b.hanging
				case TextBaseline.Bottom, TextBaseline.Ideographic:
					dx = central - b.under
				default:
			}
			match s.align {
				case TextAlign.Center:
					return (dx, -l.advance / 2.0)
				case TextAlign.End:
					return (dx, -l.advance)
				default:
					return (dx, 0.0)
			}
		}
		let dx = 0.0
		match s.align {
			case TextAlign.Center:
				dx = -l.advance / 2.0
			case TextAlign.End:
				dx = l.rtl ?? (0.0, -l.advance)
			default:
				dx = l.rtl ?? (-l.advance, 0.0)
		}
		// The anchor is on the chosen line: the glyph origin sits that far
		// below it.
		let b = l.lines
		let dy = b.alphabetic
		match s.baseline {
			case TextBaseline.Top:
				dy = b.over
			case TextBaseline.Middle:
				dy = (b.over + b.under) / 2.0
			case TextBaseline.Bottom, TextBaseline.Ideographic:
				dy = b.under
			case TextBaseline.Hanging:
				dy = b.hanging
			default:
		}
		return (dx, dy)
	}

	// measureText's metrics.
	internal def textMetrics(text string, textStyle TextStyle) TextMetrics {
		let l = layoutText(text, textStyle)
		let (dx, dy) = anchorShift(l, textStyle)
		let boxes GlyphBox[]
		let ink = Rect{left: 0.0, top: 0.0, right: 0.0, bottom: 0.0}
		let any = false
		let turned = textStyle.orientation == TextOrientation.Sideways
		for let (_, g) in l.glyphs {
			let b = Rect{left: g.bounds.left + dx, top: g.bounds.top + dy, right: g.bounds.right + dx, bottom: g.bounds.bottom + dy}
			let (x, y) = (g.x + dx, g.y + dy)
			if turned {
				// Clockwise about the anchor: (x, y) to (-y, x).
				b = Rect{left: -b.bottom, top: b.left, right: -b.top, bottom: b.right}
				let across = x
				x = -y
				y = across
			}
			boxes.push(GlyphBox{glyph: g.glyph, x: x, y: y, advance: g.advance, bounds: b, cluster: g.cluster})
			continue when b.right <= b.left || b.bottom <= b.top
			if !any {
				ink = b
				any = true
			} else {
				ink = Rect{left: ink.left.min(b.left), top: ink.top.min(b.top), right: ink.right.max(b.right), bottom: ink.bottom.max(b.bottom)}
			}
		}
		return TextMetrics{advance: l.advance, ascent: l.ascent, descent: l.descent, bounds: ink, glyphs: boxes}
	}

	// textPath under the transform `t`: hinted glyphs are grid-fitted at
	// the device size, so only under a uniform scale that keeps axes
	// straight.
	internal def textPathUnder(text string, at Point, textStyle TextStyle, t Transform2D) Path {
		let l = layoutText(text, textStyle)
		let (dx, dy) = anchorShift(l, textStyle)
		if textStyle.orientation == TextOrientation.Sideways {
			// Laid out at the origin, turned clockwise, moved to the anchor;
			// hinting fits the unturned axes, so the plain outlines.
			let turn = new Transform2D(a = 0.0, b = 1.0, c = -1.0, d = 0.0, tx = at.x, ty = at.y)
			return glyphsPath(textStyle.face, l, dx, dy).transformed(turn)
		}
		if textStyle.hinting && t.b == 0.0 && t.c == 0.0 && t.a > 0.0 && t.a == t.d {
			return hintedGlyphsPath(textStyle.face, l, at.x + dx, at.y + dy, t)
		}
		return glyphsPath(textStyle.face, l, at.x + dx, at.y + dy)
	}

	// The text along the path from `offset`, as fillText(text, along) fills it.
	internal def textAlong(text string, along Path, textStyle TextStyle, offset float) Path {
		let s = textStyle
		let flat = TextStyle{face: s.face, size: s.size, align: s.align, baseline: s.baseline, spacing: s.spacing, hinting: s.hinting, rootSize: s.rootSize, script: s.script}
		let l = layoutText(text, flat)
		let (dx, dy) = anchorShift(l, flat)
		// Align moves the run along the path, baseline across it.
		return glyphsAlong(textStyle.face, l, along, offset + dx, dy)
	}

	// Fills horizontal or upright text from the glyph mask cache, when the
	// transform only scales uniformly and moves and the glyphs are small
	// enough to keep as masks: each glyph is rasterized once per size and
	// subpixel position (hinted ones on whole pixels), the masks merge as
	// glyphs drawn one over another, and the result goes through the same
	// clip, alpha, blend and composite as any fill. Returns false, drawing
	// nothing, when the text needs the path route; else the box changed.
	internal def fillTextMasks(c Canvas, text string, at Point, s TextStyle, paint Paint) (bool, int, int, int, int) {
		let st = c.current
		let t = st.transform
		return (false, 0, 0, 0, 0) when s.orientation == TextOrientation.Sideways || t.b != 0.0 || t.c != 0.0 || t.a <= 0.0 || t.a != t.d
		let k = t.a
		let size = textSize(s)
		return (false, 0, 0, 0, 0) when size * k > textcache.maxMaskSize
		// The run is rasterized against the anchor's whole device pixel, so
		// it is reused wherever the anchor lands with the same fraction.
		let ax = at.x * k + t.tx
		let ay = at.y * k + t.ty
		let ix = ax.floor()
		let iy = ay.floor()
		let key = "{text}\u001F{size * k}\u001F{textSpacing(s, size) * k}\u001F{int(s.align)}\u001F{int(s.baseline)}\u001F{s.script}\u001F{int(s.orientation)}\u001F{s.hinting}\u001F{ax - ix}\u001F{ay - iy}\u001F{k}"
		let cache = textcache.cache()
		let found = cache.image(s.face, key)
		let image = found is textcache.GlyphMask ?? (found, runImage(text, s, ax - ix, ay - iy, k))
		cache.keepImage(s.face, key, image) when found is none
		let rx0 = int(ix) + image.left
		let ry0 = int(iy) + image.top
		let rx1 = rx0 + image.width
		let ry1 = ry0 + image.height
		let rw = image.width
		let run = image.coverage
		let (x0, y0, x1, y1) = fillCoverage(c, paint, shaderFor(paint, t), !(paint is Color), st, rw == 0, float(rx0), float(ry0), float(rx1), float(ry1), def (bx0 int, by0 int, bx1 int, by1 int, everyRow bool, row def(int, byte[], int, int)) {
			let w = bx1 - bx0
			let cov byte[]
			cov.len(w + 32)
			// The columns the run covers, from bx0.
			let lo = (rx0 - bx0).max(0)
			let end = (rx1 - bx0).min(w)
			// Rows only ever change [lo, end), so the rest stays clear.
			cov.fill(0)
			for let y = by0; y < by1; y++ {
				let inside = y >= ry0 && y < ry1 && lo < end
				continue when !inside && !everyRow
				if !inside {
					row(y, cov, 0, 0)
					continue
				}
				let src = (y - ry0) * rw + bx0 + lo - rx0
				mem.copyN(cov[lo:end], run[src:src + end - lo], end - lo)
				row(y, cov, lo, end)
			}
		})
		return (true, x0, y0, x1, y1)
	}

	// The run's coverage with its anchor at (fx, fy) inside the device pixel
	// (0, 0), at scale `k`: each glyph's mask from the cache, rasterized once
	// per size and subpixel position (hinted ones on whole pixels), merged
	// as glyphs drawn one over another. Offsets are from that pixel.
	internal def runImage(text string, s TextStyle, fx float, fy float, k float) textcache.GlyphMask {
		let l = layoutText(text, s)
		let device = l.size * k
		let (dx, dy) = anchorShift(l, s)
		let cache = textcache.cache()
		let raster = (p Path, w int, h int) => glyphCoverage(p, w, h)
		let steps = float(textcache.subpixelSteps)
		let placed textcache.GlyphMask[]
		let xs int[]
		let ys int[]
		let (
			rx0 = 0
			ry0 = 0
			rx1 = 0
			ry1 = 0
		)
		for let (_, g) in l.glyphs {
			let px = fx + (dx + g.x) * k
			let py = fy + (dy + g.y) * k
			// Hinted glyphs sit on whole pixels; others on the nearest of the
			// cache's subpixel steps.
			px = s.hinting ?? (px, (px * steps + 0.5).floor() / steps)
			let ox = s.hinting ?? ((px + 0.5).floor(), px.floor())
			let oy = (py + 0.5).floor()
			let found = cache.mask(s.face, g.glyph, device, s.hinting, px - ox, raster)
			continue when found is none
			let m = found
			continue when m.width == 0
			let x0 = int(ox) + m.left
			let y0 = int(oy) + m.top
			if placed.len() == 0 {
				rx0 = x0
				ry0 = y0
				rx1 = x0 + m.width
				ry1 = y0 + m.height
			} else {
				rx0 = rx0.min(x0)
				ry0 = ry0.min(y0)
				rx1 = rx1.max(x0 + m.width)
				ry1 = ry1.max(y0 + m.height)
			}
			placed.push(m)
			xs.push(x0)
			ys.push(y0)
		}
		let rw = rx1 - rx0
		let run byte[]
		run.len(rw * (ry1 - ry0))
		run.fill(0)
		for let (i, m) in placed {
			for let y = 0; y < m.height; y++ {
				let src = y * m.width
				let dst = (ys[i] - ry0 + y) * rw + xs[i] - rx0
				for let x = 0; x < m.width; x++ {
					let b = int(m.coverage[src + x])
					continue when b == 0
					let a = int(run[dst + x])
					run[dst + x] = byte(a + b - canvasDiv255(a * b))
				}
			}
		}
		return textcache.GlyphMask{width: rw, height: ry1 - ry0, left: rx0, top: ry0, coverage: run}
	}

	// Fills text whose glyphs include colour ones (emoji): those drawn from
	// the font's colour data, the others as outlines in `paint`, in order.
	// `t` is the painter's transform, for the size bitmaps are picked at.
	// Returns false, drawing nothing, when no glyph of the run is in colour.
	internal def fillColorText(p Painter, text string, at Point, s TextStyle, paint Paint, t Transform2D) bool {
		let face = s.face
		return false unless face.info().color
		let l = layoutText(text, s)
		let any = false
		for let (_, g) in l.glyphs {
			any = true when colorglyphs.hasColorGlyph(face, int(g.glyph))
		}
		return false unless any
		let (dx, dy) = anchorShift(l, s)
		let sideways = s.orientation == TextOrientation.Sideways
		let ox = sideways ?? (dx, at.x + dx)
		let oy = sideways ?? (dy, at.y + dy)
		p.save()
		// Laid out at the origin and turned clockwise, as textPath does.
		p.transform(new Transform2D(a = 0.0, b = 1.0, c = -1.0, d = 0.0, tx = at.x, ty = at.y)) when sideways
		let ppem = l.size * sqrt((t.a * t.d - t.b * t.c).abs())
		// The text colour, what the font's foreground parts take.
		let foreground = new Color("#000")
		foreground = paint when paint is Color
		let plain = new Path()
		for let (_, g) in l.glyphs {
			let place = new Transform2D(a = l.scale, d = -l.scale, tx = ox + g.x, ty = oy + g.y)
			if colorglyphs.hasColorGlyph(face, int(g.glyph)) {
				// Outlines before it stay under it.
				if !plain.isEmpty() {
					p.fill(plain, paint)
					plain = new Path()
				}
				colorglyphs.drawColorGlyph(p, face, int(g.glyph), place, ppem, foreground)
			} else {
				let outline = face.outline(g.glyph) onerror recover new fonts.Outline()
				plain.add(outline.path(l.scale), new Transform2D(tx = ox + g.x, ty = oy + g.y))
			}
		}
		p.fill(plain, paint) when !plain.isEmpty()
		p.restore()
		return true
	}

	// The glyphs as one path, the run starting at (x, y) on its baseline.
	internal def glyphsPath(face fonts.Face, l TextLayout, x, y float) Path {
		let p = new Path()
		for let (_, g) in l.glyphs {
			let outline = face.outline(g.glyph) onerror recover new fonts.Outline()
			p.add(outline.path(l.scale), new Transform2D(tx = x + g.x, ty = y + g.y))
		}
		return p
	}

	// The glyphs as one path in user space, each hinted at the device size
	// and its origin on whole device pixels, for a transform `t` that only
	// scales uniformly and moves. A glyph the face cannot hint keeps its
	// plain outline at its exact place.
	internal def hintedGlyphsPath(face fonts.Face, l TextLayout, x, y float, t Transform2D) Path {
		let p = new Path()
		let k = t.a
		for let (_, g) in l.glyphs {
			let ox = ((x + g.x) * k + t.tx + 0.5).floor()
			let oy = ((y + g.y) * k + t.ty + 0.5).floor()
			let hinted = hintedOutline(face, g.glyph, l.size * k)
			if hinted is none {
				let plain = face.outline(g.glyph) onerror recover new fonts.Outline()
				p.add(plain.path(l.scale), new Transform2D(tx = x + g.x, ty = y + g.y))
				continue
			}
			// Device pixels to user space: undo the scale and the move.
			p.add(hinted.path(1.0), new Transform2D(a = 1.0 / k, d = 1.0 / k, tx = (ox - t.tx) / k, ty = (oy - t.ty) / k))
		}
		return p
	}

	// The face's hinted outline of the glyph at `size` pixels per em, or
	// none when it cannot hint it.
	internal def hintedOutline(face fonts.Face, glyph fonts.GlyphID, size float) ?fonts.Outline {
		let o = face.outline(glyph, size, fonts.Hinting.Full)
		return none when o is error
		return o
	}

	// The glyphs placed along `along`, each centred on its point `offset +
	// x` along the path and turned to the path's direction there; glyphs past
	// the path's end are left out, as SVG textPath does.
	internal def glyphsAlong(face fonts.Face, l TextLayout, along Path, offset float, dy float) Path {
		let p = new Path()
		let total = along.length()
		for let (_, g) in l.glyphs {
			let mid = offset + g.x + g.advance / 2.0
			continue when mid < 0.0 || mid > total
			let (at, tangent) = along.pointAt(mid)
			let c = tangent.x
			let s = tangent.y
			// Glyph space: its middle at the origin, the baseline moved by dy;
			// then rotated to the tangent and moved onto the point.
			let place = new Transform2D(a = c, b = s, c = -s, d = c, tx = at.x, ty = at.y).then(new Transform2D(tx = -g.advance / 2.0, ty = dy + g.y))
			let outline = face.outline(g.glyph) onerror recover new fonts.Outline()
			p.add(outline.path(l.scale), place)
		}
		return p
	}

	// The run's baselines in pixels above the origin.
	internal def resolveBaselines(face fonts.Face, script string, scale float, upm float) BaselineSet {
		let b = face.baselines(script)
		let m = face.metrics()
		let (hasAlpha, alpha) = known(b.alphabetic)
		let (hasHang, hang) = known(b.hanging)
		let (hasUnder, under) = known(b.ideographicBottom)
		let (hasOver, over) = known(b.ideographicTop)
		// A.2: over and under are 1em apart; with neither, ascent and descent.
		if hasUnder && !hasOver {
			over = under + upm
		} else if hasOver && !hasUnder {
			under = over - upm
		} else if !hasUnder && !hasOver {
			over = float(m.ascent)
			under = float(m.descent)
		}
		if !hasHang {
			hang = measureHanging(face, script, upm)
		}
		alpha = 0.0 when !hasAlpha
		return BaselineSet{alphabetic: alpha * scale, hanging: hang * scale, under: under * scale, over: over * scale}
	}

	// Whether an optional font-unit value is recorded, and its value.
	internal def known(v ?int16) (bool, float) {
		return (false, 0.0) when v is none
		return (true, float(v))
	}

	// A.2: the hanging baseline measured as the top of the ink at the middle
	// of the script's letter Ka (Hebrew He for Hebrew), Devanagari's by
	// default; 0.6em when the face has no such glyph.
	internal def measureHanging(face fonts.Face, script string, upm float) float {
		let letter = hangingLetter(script)
		let g = face.glyph(letter)
		return 0.6 * upm when g is none
		let outline = face.outline(g) onerror recover new fonts.Outline()
		let flat = outline.path(1.0).flattened(0.5)
		let box = flat.bounds()
		return 0.6 * upm when box.right <= box.left
		let cx = (box.left + box.right) / 2.0
		// The highest crossing of the vertical line through the middle
		// (the path is y down, so the smallest y).
		let top = 1e30
		let pts = flat.coords
		let j = 0
		let (px, py, sx, sy) = (0.0, 0.0, 0.0, 0.0)
		for let (_, v) in flat.verbs {
			match v {
				case PathVerb.Move:
					px = pts[j]
					py = pts[j + 1]
					sx = px
					sy = py
					j += 2
				case PathVerb.Line:
					top = top.min(crossingY(px, py, pts[j], pts[j + 1], cx))
					px = pts[j]
					py = pts[j + 1]
					j += 2
				case PathVerb.Close:
					top = top.min(crossingY(px, py, sx, sy, cx))
					px = sx
					py = sy
				default:
			}
		}
		return 0.6 * upm when top >= 1e29
		return -top
	}

	// Where the segment crosses the vertical line x = cx, or far below when
	// it does not.
	internal def crossingY(x0, y0, x1, y1, cx float) float {
		return 1e30 when (x0 < cx) == (x1 < cx)
		return y0 + (cx - x0) * (y1 - y0) / (x1 - x0)
	}

	// The letter whose top is the hanging baseline for the script.
	internal def hangingLetter(script string) char {
		return 'ক' when script == "Beng"
		return 'ਕ' when script == "Guru"
		return 'ཀ' when script == "Tibt"
		return 'ה' when script == "Hebr"
		return 'क'
	}
}
