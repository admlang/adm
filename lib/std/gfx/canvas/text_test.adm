partial module std.gfx.canvas {
	use (
		std.testing
		std.os
		std.formats.fonts
		std.gfx.color::(Color, RGBA)
		std.math.geom::(Path, Point, Rect)
		std.units::(FontRelative, Pixels)
	)

	check "Text" {
		def face() !fonts.Face {
			let data = try os.readFile("samples/fonts/ttf/SourceSansPro-Black.ttf")
			let font = try fonts.load(data)
			return try font.face(0)
		}

		def black() Color {
			return new Color(RGBA{r: 0, g: 0, b: 0, a: 255})
		}

		// The canvas's total coverage, in pixels.
		def ink(cv Canvas) float {
			let sum = 0.0
			for let i = 3; i < cv.pixels.len(); i += 4 {
				sum += float(cv.pixels[i]) / 255.0
			}
			return sum
		}

		// The box of the pixels with any coverage.
		def inkBox(cv Canvas) Rect {
			let r = Rect{left: 1e9, top: 1e9, right: -1e9, bottom: -1e9}
			for let y = 0; y < cv.height; y++ {
				for let x = 0; x < cv.width; x++ {
					continue when cv.pixels[(y * cv.width + x) * 4 + 3] == 0
					r = Rect{left: r.left.min(float(x)), top: r.top.min(float(y)), right: r.right.max(float(x + 1)), bottom: r.bottom.max(float(y + 1))}
				}
			}
			return r
		}

		@test()
		def measuresShapedRuns() !none {
			let f = try face()
			let cv = new Canvas(10, 10)
			let m = cv.measureText("Hello", TextStyle{face: f, size: 32(px)})
			assert m.glyphs.len() == 5 && m.advance > 60.0 && m.ascent > 20.0 && m.descent > 3.0
			assert m.glyphs[0].cluster == 0 && m.glyphs[4].cluster == 4
			assert m.bounds.top < -20.0 && m.bounds.bottom <= 1.0 && m.bounds.left >= -1.0
			// A font-relative size is of the root size.
			let em = cv.measureText("Hello", TextStyle{face: f, size: 2(em)})
			assert (em.advance - m.advance).abs() < 1e-6
			let bigRoot = cv.measureText("Hello", TextStyle{face: f, size: 1(em), rootSize: 32(px)})
			assert (bigRoot.advance - m.advance).abs() < 1e-6
			// Spacing adds between glyphs.
			let spaced = cv.measureText("Hello", TextStyle{face: f, size: 32(px), spacing: 2(px)})
			assert (spaced.advance - m.advance - 8.0).abs() < 1e-6
			// Kerning pulls AV together.
			let av = cv.measureText("AV", TextStyle{face: f, size: 32(px)}).advance
			let a = cv.measureText("A", TextStyle{face: f, size: 32(px)}).advance
			let v = cv.measureText("V", TextStyle{face: f, size: 32(px)}).advance
			assert av < a + v
		}

		@test()
		def uprightTextStacksDown() !none {
			let f = try face()
			let cv = new Canvas(10, 10)
			let up = TextStyle{face: f, size: 20(px), orientation: TextOrientation.Upright}
			let m = cv.measureText("HIM", up)
			assert m.glyphs.len() == 3
			// Each glyph a line lower, all on the same centre line, which
			// runs through the middle of each glyph's ink.
			let step = m.glyphs[1].y - m.glyphs[0].y
			assert step > 15.0 && (m.glyphs[2].y - m.glyphs[1].y - step).abs() < 1e-6
			assert (m.advance - 3.0 * step).abs() < 1e-6
			for let (_, g) in m.glyphs {
				let mid = (g.bounds.left + g.bounds.right) / 2.0
				assert mid.abs() < 1.5 && (g.advance - step).abs() < 1e-6
			}
			// Start hangs the column from the anchor; End ends it there.
			assert m.bounds.top >= 0.0 && m.bounds.bottom <= m.advance + 0.5
			let end = cv.measureText("HIM", TextStyle{face: f, size: 20(px), orientation: TextOrientation.Upright, align: TextAlign.End})
			assert (end.glyphs[0].y + m.advance - m.glyphs[0].y).abs() < 1e-6
			// Top puts the column's right (over) side on the anchor, Bottom
			// its left (under) side.
			let top = cv.measureText("HIM", TextStyle{face: f, size: 20(px), orientation: TextOrientation.Upright, baseline: TextBaseline.Top})
			let bottom = cv.measureText("HIM", TextStyle{face: f, size: 20(px), orientation: TextOrientation.Upright, baseline: TextBaseline.Bottom})
			assert top.bounds.right <= 0.5 && top.bounds.right > -10.0 && bottom.bounds.left >= -0.5 && bottom.bounds.left < 10.0
			// Drawn: taller than wide.
			let col = new Canvas(40, 80)
			col.fillText("HIM", new Point(20.0, 5.0), up, black())
			let box = inkBox(col)
			assert box.bottom - box.top > 2.0 * (box.right - box.left) && (box.left + box.right) / 2.0 > 17.0 && (box.left + box.right) / 2.0 < 23.0
		}

		@test()
		def sidewaysTextTurnsClockwise() !none {
			let f = try face()
			let cv = new Canvas(10, 10)
			let flat = cv.measureText("Wide", TextStyle{face: f, size: 20(px)})
			let side = cv.measureText("Wide", TextStyle{face: f, size: 20(px), orientation: TextOrientation.Sideways})
			assert (side.advance - flat.advance).abs() < 1e-6
			// (x, y) turns to (-y, x): the run goes down, its tops face right.
			let a = flat.glyphs[1]
			let b = side.glyphs[1]
			assert (b.x + a.y).abs() < 1e-6 && (b.y - a.x).abs() < 1e-6
			assert (side.bounds.left + flat.bounds.bottom).abs() < 1e-6 && (side.bounds.bottom - flat.bounds.right).abs() < 1e-6
			// Drawn: the same ink as horizontal text, standing up, right of
			// the anchor (the ascenders point right).
			let wide = new Canvas(120, 40)
			wide.fillText("Wide", new Point(5.0, 30.0), TextStyle{face: f, size: 20(px), hinting: false}, black())
			let tall = new Canvas(40, 120)
			tall.fillText("Wide", new Point(10.0, 5.0), TextStyle{face: f, size: 20(px), hinting: false, orientation: TextOrientation.Sideways}, black())
			assert (ink(tall) - ink(wide)).abs() < 0.02 * ink(wide)
			let box = inkBox(tall)
			assert box.bottom - box.top > 2.0 * (box.right - box.left) && box.left >= 9.0
		}

		@test()
		def alignAndBaselineMoveTheRun() !none {
			let f = try face()
			let cv = new Canvas(10, 10)
			let start = cv.measureText("Wide", TextStyle{face: f, size: 20(px)})
			let center = cv.measureText("Wide", TextStyle{face: f, size: 20(px), align: TextAlign.Center})
			let end = cv.measureText("Wide", TextStyle{face: f, size: 20(px), align: TextAlign.End})
			assert start.glyphs[0].x == 0.0
			assert (center.glyphs[0].x + start.advance / 2.0).abs() < 1e-6
			assert (end.glyphs[0].x + start.advance).abs() < 1e-6
			let top = cv.measureText("Wide", TextStyle{face: f, size: 20(px), baseline: TextBaseline.Top})
			// Top is the em box's top: the font's ideographic top, or 1em above
			// its ideographic bottom, or the ascent.
			let upm = float(f.info().unitsPerEm)
			// Baselines follow the text's script unless the style names one.
			assert baseScript("Wide", "") == "Latn" && baseScript("12 – 3", "") == "" && baseScript("Wide", "Deva") == "Deva" && baseScript("Привет", "") == "Cyrl"
			let lines = resolveBaselines(f, "Latn", 20.0 / upm, upm)
			assert (top.glyphs[0].y - lines.over).abs() < 1e-6 && top.bounds.top > -1.0
			let hanging = cv.measureText("Wide", TextStyle{face: f, size: 20(px), baseline: TextBaseline.Hanging})
			assert (hanging.glyphs[0].y - lines.hanging).abs() < 1e-6 && lines.hanging > 0.0 && lines.hanging < lines.over
			let bottom = cv.measureText("Wide", TextStyle{face: f, size: 20(px), baseline: TextBaseline.Bottom})
			assert bottom.bounds.bottom < 1.0
		}

		@test()
		def fillsAndStrokesGlyphs() !none {
			let f = try face()
			let s = TextStyle{face: f, size: 48(px)}
			let filled = new Canvas(120, 60)
			filled.fillText("Il", new Point(10.0, 50.0), s, black())
			let stroked = new Canvas(120, 60)
			stroked.strokeText("Il", new Point(10.0, 50.0), s, black())
			let fi = ink(filled)
			let st = ink(stroked)
			assert fi > 300.0 && st > 50.0 && st < fi
			// The path is what fillText fills, where measureText says: exactly
			// unhinted, within the pixel the hinting snaps its edges to.
			let plain = TextStyle{face: f, size: 48(px), hinting: false}
			let pb = filled.textPath("Il", new Point(10.0, 50.0), plain).bounds()
			let pm = filled.measureText("Il", plain).bounds
			assert (pb.left - (pm.left + 10.0)).abs() < 1e-6 && (pb.top - (pm.top + 50.0)).abs() < 1e-6 && (pb.bottom - (pm.bottom + 50.0)).abs() < 1e-6
			let b = filled.textPath("Il", new Point(10.0, 50.0), s).bounds()
			let m = filled.measureText("Il", s).bounds
			assert (b.left - (m.left + 10.0)).abs() < 1.0 && (b.top - (m.top + 50.0)).abs() < 1.0 && (b.bottom - (m.bottom + 50.0)).abs() < 1.0
			// Hinted edges sit on whole pixels.
			assert b.top == b.top.floor() && b.bottom == b.bottom.floor()
		}

		@test()
		def textAlongAPath() !none {
			let f = try face()
			let s = TextStyle{face: f, size: 24(px), hinting: false}
			// Along a straight line, the same ink as plain text.
			let plain = new Canvas(300, 60)
			plain.fillText("Along", new Point(10.0, 40.0), s, black())
			let along = new Canvas(300, 60)
			along.fillText("Along", new Path().moveTo(10.0, 40.0).lineTo(290.0, 40.0), s, black())
			assert (ink(plain) - ink(along)).abs() < ink(plain) * 0.01
			// Glyphs past a short path's end are left out.
			let short = new Canvas(300, 60)
			short.fillText("Along", new Path().moveTo(10.0, 40.0).lineTo(40.0, 40.0), s, black())
			assert ink(short) > 0.0 && ink(short) < ink(plain) * 0.6
			// Around a circle the run still draws.
			let round = new Canvas(200, 200)
			round.fillText("Around", new Path().circle(new Point(100.0, 100.0), 60.0), s, black())
			assert ink(round) > ink(plain) * 0.8
		}
		// fillText draws small unrotated text from cached glyph masks; it
		// matches filling textPath: hinted glyphs exactly at these sizes,
		// unhinted ones within the quarter-pixel step their pen snaps to.
		@test()
		def fillTextMatchesTextPath() !none {
			let f = try face()
			for let (_, hint) in [true, false] {
				for let (_, size) in [16(px), 31(px)] {
					let s = TextStyle{face: f, size: size, hinting: hint}
					let a = new Canvas(300, 60)
					a.fillText("Hamburgefonstiv AVA, 0123", new Point(3.3, 40.0), s, black())
					let b = new Canvas(300, 60)
					b.fill(b.textPath("Hamburgefonstiv AVA, 0123", new Point(3.3, 40.0), s), black())
					let worst = 0
					for let i = 3; i < a.pixels.len(); i += 4 {
						worst = worst.max((int(a.pixels[i]) - int(b.pixels[i])).abs())
					}
					assert worst <= (hint ?? (1, 32)) // per-pixel coverage difference
					assert (ink(a) - ink(b)).abs() < ink(b) * 0.005 // same ink overall
				}
			}
		}

		// The shared text cache can be bounded and emptied from any canvas;
		// text draws the same afterwards.
		@test()
		def textCacheControls() !none {
			let f = try face()
			let s = TextStyle{face: f, size: 14(px)}
			let a = new Canvas(120, 30)
			a.fillText("Cached", new Point(2.0, 20.0), s, black())
			a.clearTextCache()
			a.setTextCacheBudget(1024)
			let b = new Canvas(120, 30)
			b.fillText("Cached", new Point(2.0, 20.0), s, black())
			let same = true
			for let (i, v) in a.pixels {
				same = false when v != b.pixels[i]
			}
			assert same // same pixels from a cold, tiny cache
			b.setTextCacheBudget(64 * 1024 * 1024)
		}
	}
}
