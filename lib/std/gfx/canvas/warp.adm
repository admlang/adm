partial module std.gfx.canvas {
	use (
		std.gfx::Raster
		std.math::sqrt
		std.math.geom::(Path, Point, Rect, Transform2D)
		std.simd
	)

	// Whether the grid is at least 2x2 points with rows of one length.
	internal def warpValid(mesh Point[][]) bool {
		return false when mesh.len() < 2 || mesh[0].len() < 2
		for let (_, row) in mesh {
			return false when row.len() != mesh[0].len()
		}
		return true
	}

	// The grid's border, clockwise from its top left point.
	internal def warpOutline(mesh Point[][]) Path {
		let p = new Path()
		return p unless warpValid(mesh)
		let rows = mesh.len() - 1
		let cols = mesh[0].len() - 1
		p.moveTo(mesh[0][0].x, mesh[0][0].y)
		for let c = 1; c <= cols; c++ {
			p.lineTo(mesh[0][c].x, mesh[0][c].y)
		}
		for let r = 1; r <= rows; r++ {
			p.lineTo(mesh[r][cols].x, mesh[r][cols].y)
		}
		for let c = cols - 1; c >= 0; c-- {
			p.lineTo(mesh[rows][c].x, mesh[rows][c].y)
		}
		for let r = rows - 1; r > 0; r-- {
			p.lineTo(mesh[r][0].x, mesh[r][0].y)
		}
		return p.close()
	}

	// An image mapped onto a grid of points: the image's even grid of
	// (columns x rows) cells, corner to corner, onto the patches between
	// the points, each patch bilinear. Like MeshShader, every patch is cut
	// into triangles a few device pixels across and listed per band of
	// rows; a pixel's source position is the barycentric blend of its
	// triangle's corners, sampled bilinear (eight pixels a vector) from the
	// image halved as often as the triangle shrinks it, or nearest.
	internal type WarpShader {
		internal xy      float32[]
		internal uv      float[]
		internal level   int[]
		internal bands   int[][]
		internal firstY  int
		internal blank   bool
		internal levels  PatternLevels
		internal nearest bool

		def new(src Raster, mesh Point[][], t Transform2D, sampling Sampling) {
			let size = src.size()
			levels = new PatternLevels(src, Rect{left: 0.0, top: 0.0, right: float(size.width), bottom: float(size.height)})
			nearest = sampling == Sampling.Nearest
			firstY = 0
			blank = !warpValid(mesh) || size.width == 0 || size.height == 0
			return when blank
			let rows = mesh.len() - 1
			let cols = mesh[0].len() - 1
			let (sw, sh) = (float(size.width), float(size.height))
			let dev Point[][]
			let minY = 1e30
			let maxY = -1e30
			for let (_, row) in mesh {
				let out Point[]
				for let (_, p) in row {
					let q = new Point(t.a * p.x + t.c * p.y + t.tx, t.b * p.x + t.d * p.y + t.ty)
					minY = minY.min(q.y)
					maxY = maxY.max(q.y)
					out.push(q)
				}
				dev.push(out)
			}
			blank = !(maxY >= minY) || maxY - minY > 1e6
			return when blank
			firstY = int(minY.floor()) - 1
			let bandCount = (int(maxY.ceil()) + 2 - firstY) / meshBandRows + 1
			for let b = 0; b < bandCount; b++ {
				bands.push(int[])
			}
			for let j = 0; j < rows; j++ {
				for let i = 0; i < cols; i++ {
					let (p00, p10, p01, p11) = (dev[j][i], dev[j][i + 1], dev[j + 1][i], dev[j + 1][i + 1])
					let span = edge(p00, p10).max(edge(p01, p11)).max(edge(p00, p01)).max(edge(p10, p11))
					let s = int((span / 6.0).ceil()).clamp(1, 64)
					let gp Point[]
					let gu float[]
					for let b = 0; b <= s; b++ {
						for let a = 0; a <= s; a++ {
							let u = float(a) / float(s)
							let v = float(b) / float(s)
							gp.push(new Point(p00.x + (p10.x - p00.x) * u + (p01.x - p00.x) * v + (p00.x - p10.x - p01.x + p11.x) * u * v, p00.y + (p10.y - p00.y) * u + (p01.y - p00.y) * v + (p00.y - p10.y - p01.y + p11.y) * u * v))
							gu.push((float(i) + u) * sw / float(cols))
							gu.push((float(j) + v) * sh / float(rows))
						}
					}
					for let b = 0; b < s; b++ {
						for let a = 0; a < s; a++ {
							let q00 = b * (s + 1) + a
							let q01 = q00 + s + 1
							addTriangle(gp, gu, q00, q00 + 1, q01 + 1)
							addTriangle(gp, gu, q00, q01 + 1, q01)
						}
					}
				}
			}
		}

		internal def edge(a Point, b Point) float {
			return sqrt((a.x - b.x) * (a.x - b.x) + (a.y - b.y) * (a.y - b.y))
		}

		internal def addTriangle(gp Point[], gu float[], a int, b int, c int) {
			let k = xy.len() / 6
			for let (_, q) in [a, b, c] {
				xy.push(float32(gp[q].x))
				xy.push(float32(gp[q].y))
				uv.push(gu[q * 2])
				uv.push(gu[q * 2 + 1])
			}
			// How many times to halve the image: until a device pixel spans at
			// most two source pixels.
			let dev = ((gp[b].x - gp[a].x) * (gp[c].y - gp[a].y) - (gp[b].y - gp[a].y) * (gp[c].x - gp[a].x)).abs()
			let src = ((gu[b * 2] - gu[a * 2]) * (gu[c * 2 + 1] - gu[a * 2 + 1]) - (gu[b * 2 + 1] - gu[a * 2 + 1]) * (gu[c * 2] - gu[a * 2])).abs()
			let ratio = dev > 0.0 ?? (sqrt(src / dev), 1.0)
			let n = 0
			let base = levels.level(0)
			let (w, h) = (base.ww, base.wh)
			for !nearest && ratio > 2.0 && w > 1 && h > 1 {
				ratio /= 2.0
				w = (w + 1) / 2
				h = (h + 1) / 2
				n++
			}
			level.push(n)
			let y0 = gp[a].y.min(gp[b].y).min(gp[c].y) - 1.0
			let y1 = gp[a].y.max(gp[b].y).max(gp[c].y) + 1.0
			let b0 = ((int(y0.floor()) - firstY) / meshBandRows).clamp(0, bands.len() - 1)
			let b1 = ((int(y1.floor()) - firstY) / meshBandRows).clamp(0, bands.len() - 1)
			for let bb = b0; bb <= b1; bb++ {
				bands[bb].push(k)
			}
		}

		// Shade implements Shader.
		def shade(x0 int, y int, n int, out byte[]) {
			out[0:n * 4] = 0
			return when blank
			let band = (y - firstY) / meshBandRows
			return when band < 0 || band >= bands.len()
			let py = float32(float(y) + 0.5)
			let reach = float32(0.7)
			// Source positions of up to eight pixels, and where they go.
			let us float[]
			let vs float[]
			let at int[]
			us.len(8)
			vs.len(8)
			at.len(8)
			let written byte[]
			written.len(n)
			written.fill(0)
			for let (_, k) in bands[band] {
				let o = k * 6
				let (ax, ay, bx, by, cx, cy) = (xy[o], xy[o + 1], xy[o + 2], xy[o + 3], xy[o + 4], xy[o + 5])
				continue when py < ay.min(by).min(cy) - reach || py > ay.max(by).max(cy) + reach
				let area = (bx - ax) * (cy - ay) - (by - ay) * (cx - ax)
				continue when area == float32(0.0)
				let sign = area > float32(0.0) ?? (float32(1.0), float32(-1.0))
				let (a0, b0) = ((by - cy) * sign, ((cx - bx) * py + bx * cy - cx * by) * sign)
				let (a1, b1) = ((cy - ay) * sign, ((ax - cx) * py + cx * ay - ax * cy) * sign)
				let (a2, b2) = ((ay - by) * sign, ((bx - ax) * py + ax * by - bx * ay) * sign)
				let l0 = float32(sqrt(float((by - cy) * (by - cy) + (cx - bx) * (cx - bx)))).max(float32(1e-6))
				let l1 = float32(sqrt(float((cy - ay) * (cy - ay) + (ax - cx) * (ax - cx)))).max(float32(1e-6))
				let l2 = float32(sqrt(float((ay - by) * (ay - by) + (bx - ax) * (bx - ax)))).max(float32(1e-6))
				let inv = float(1.0) / float(area * sign)
				let xmin = int((ax.min(bx).min(cx) - reach).floor()).max(x0)
				let xmax = int((ax.max(bx).max(cx) + reach).ceil()).min(x0 + n)
				continue when xmin >= xmax
				let lv = levels.level(level[k])
				let scale = float(1 << level[k])
				let (u0, v0, u1, v1, u2, v2) = (uv[o], uv[o + 1], uv[o + 2], uv[o + 3], uv[o + 4], uv[o + 5])
				let count = 0
				for let x = xmin; x < xmax; x++ {
					let px = float32(float(x) + 0.5)
					let (e0, e1, e2) = (a0 * px + b0, a1 * px + b1, a2 * px + b2)
					let d = (e0 / l0).min(e1 / l1).min(e2 / l2)
					continue when d < -reach
					let i = x - x0
					// Inside wins; a pixel only reached is written when empty.
					continue when d < float32(0.0) && written[i] != 0
					written[i] = d < float32(0.0) ?? (byte(1), byte(2))
					let w0 = float(e0.max(float32(0.0))) * inv
					let w1 = float(e1.max(float32(0.0))) * inv
					let w2 = float(e2.max(float32(0.0))) * inv
					let sum = (w0 + w1 + w2).max(1e-12)
					us[count] = (w0 * u0 + w1 * u1 + w2 * u2) / sum / scale
					vs[count] = (w0 * v0 + w1 * v1 + w2 * v2) / sum / scale
					at[count] = i * 4
					count++
					if count == 8 {
						sampleEight(lv, us, vs, at, count, out)
						count = 0
					}
				}
				sampleEight(lv, us, vs, at, count, out) when count > 0
			}
		}

		// The `count` source positions (in the level's pixels) sampled into
		// out at their offsets: bilinear, or the nearest texel.
		internal def sampleEight(l PatternLevel, us float[], vs float[], at int[], count int, out byte[]) {
			if count == 8 && !nearest {
				// Eight a vector: the sums of bilinearAt, lane by lane.
				let half = simd.splat8<float>(0.5)
				let one = simd.splat8<float32>(float32(1.0))
				let full = simd.splat8<float32>(float32(255.0))
				let zero = simd.splat8<float>(0.0)
				let u = simd.load8<float>(us, 0) - half
				let v = simd.load8<float>(vs, 0) - half
				let fu = u.floor()
				let fv = v.floor()
				let tx = simd.convert<float, float32>(u - fu)
				let ty = simd.convert<float, float32>(v - fv)
				let (lastX, lastY) = (simd.splat8<float>(float(l.ww - 1)), simd.splat8<float>(float(l.wh - 1)))
				let xa = fu.clamp(zero, lastX)
				let xb = (fu + simd.splat8<float>(1.0)).clamp(zero, lastX)
				let ya = fv.clamp(zero, lastY)
				let yb = (fv + simd.splat8<float>(1.0)).clamp(zero, lastY)
				let (sx, sy, rs, four) = (simd.splat8<float>(float(l.wx)), simd.splat8<float>(float(l.wy)), simd.splat8<float>(float(l.stride)), simd.splat8<float>(4.0))
				let o00 = simd.convert<float, int>((sy + ya) * rs + (sx + xa) * four)
				let o10 = simd.convert<float, int>((sy + ya) * rs + (sx + xb) * four)
				let o01 = simd.convert<float, int>((sy + yb) * rs + (sx + xa) * four)
				let o11 = simd.convert<float, int>((sy + yb) * rs + (sx + xb) * four)
				let px = l.px
				let a00 = simd.convert<byte, float32>(simd.gather8<byte>(px, 3, o00)) / full
				let a10 = simd.convert<byte, float32>(simd.gather8<byte>(px, 3, o10)) / full
				let a01 = simd.convert<byte, float32>(simd.gather8<byte>(px, 3, o01)) / full
				let a11 = simd.convert<byte, float32>(simd.gather8<byte>(px, 3, o11)) / full
				let w00 = (one - tx) * (one - ty)
				let w10 = tx * (one - ty)
				let w01 = (one - tx) * ty
				let w11 = tx * ty
				let ca = a00 * w00 + a10 * w10 + a01 * w01 + a11 * w11
				let cr = simd.gather8<float32>(srgbToLinearTable, 0, simd.convert<byte, int>(simd.gather8<byte>(px, 0, o00))) * a00 * w00 + simd.gather8<float32>(srgbToLinearTable, 0, simd.convert<byte, int>(simd.gather8<byte>(px, 0, o10))) * a10 * w10 + simd.gather8<float32>(srgbToLinearTable, 0, simd.convert<byte, int>(simd.gather8<byte>(px, 0, o01))) * a01 * w01 + simd.gather8<float32>(srgbToLinearTable, 0, simd.convert<byte, int>(simd.gather8<byte>(px, 0, o11))) * a11 * w11
				let cg = simd.gather8<float32>(srgbToLinearTable, 0, simd.convert<byte, int>(simd.gather8<byte>(px, 1, o00))) * a00 * w00 + simd.gather8<float32>(srgbToLinearTable, 0, simd.convert<byte, int>(simd.gather8<byte>(px, 1, o10))) * a10 * w10 + simd.gather8<float32>(srgbToLinearTable, 0, simd.convert<byte, int>(simd.gather8<byte>(px, 1, o01))) * a01 * w01 + simd.gather8<float32>(srgbToLinearTable, 0, simd.convert<byte, int>(simd.gather8<byte>(px, 1, o11))) * a11 * w11
				let cb = simd.gather8<float32>(srgbToLinearTable, 0, simd.convert<byte, int>(simd.gather8<byte>(px, 2, o00))) * a00 * w00 + simd.gather8<float32>(srgbToLinearTable, 0, simd.convert<byte, int>(simd.gather8<byte>(px, 2, o10))) * a10 * w10 + simd.gather8<float32>(srgbToLinearTable, 0, simd.convert<byte, int>(simd.gather8<byte>(px, 2, o01))) * a01 * w01 + simd.gather8<float32>(srgbToLinearTable, 0, simd.convert<byte, int>(simd.gather8<byte>(px, 2, o11))) * a11 * w11
				let lo = simd.splat8<float32>(float32(0.0))
				let steps = simd.splat8<float32>(float32(4095.0))
				let round = simd.splat8<float32>(float32(0.5))
				let kr = simd.convert<float32, int32>((cr / ca).clamp(lo, one) * steps + round)
				let kg = simd.convert<float32, int32>((cg / ca).clamp(lo, one) * steps + round)
				let kb = simd.convert<float32, int32>((cb / ca).clamp(lo, one) * steps + round)
				let ka = simd.convert<float32, int32>(ca.min(one) * full + round)
				for let k = 0; k < 8; k++ {
					let o = at[k]
					if ca.lane(k) <= float32(0.0) {
						out[o] = 0
						out[o + 1] = 0
						out[o + 2] = 0
						out[o + 3] = 0
						continue
					}
					out[o] = linearToSrgbTable[int(kr.lane(k))]
					out[o + 1] = linearToSrgbTable[int(kg.lane(k))]
					out[o + 2] = linearToSrgbTable[int(kb.lane(k))]
					out[o + 3] = byte(int(ka.lane(k)))
				}
				return
			}
			for let k = 0; k < count; k++ {
				if nearest {
					let sx = int(us[k].floor()).clamp(0, l.ww - 1) + l.wx
					let sy = int(vs[k].floor()).clamp(0, l.wh - 1) + l.wy
					let s = sy * l.stride + sx * 4
					out[at[k]] = l.px[s]
					out[at[k] + 1] = l.px[s + 1]
					out[at[k] + 2] = l.px[s + 2]
					out[at[k] + 3] = l.px[s + 3]
					continue
				}
				bilinearAt(l.px, l.stride, l.wx, l.wy, l.ww, l.wh, Spread.Pad, Spread.Pad, us[k] - 0.5, vs[k] - 0.5, out, at[k])
			}
		}
	}
}
