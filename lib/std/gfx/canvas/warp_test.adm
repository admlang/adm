partial module std.gfx.canvas {
	use (
		std.testing
		std.gfx.color::(Color, RGBA)
		std.math.geom::(Point, Rect, Transform2D)
	)

	check "Mesh warp" {
		def px(cv Canvas, x int, y int) RGBA {
			let i = (y * cv.width + x) * 4
			return RGBA{r: cv.pixels[i], g: cv.pixels[i + 1], b: cv.pixels[i + 2], a: cv.pixels[i + 3]}
		}

		// A w x h image whose pixels come from `at(x, y)`.
		def image(w int, h int, at def(int, int) RGBA) Canvas {
			let cv = new Canvas(w, h)
			for let y = 0; y < h; y++ {
				for let x = 0; x < w; x++ {
					let c = at(x, y)
					let i = (y * w + x) * 4
					cv.pixels[i] = c.r
					cv.pixels[i + 1] = c.g
					cv.pixels[i + 2] = c.b
					cv.pixels[i + 3] = c.a
				}
			}
			return cv
		}

		def grid(l float, t float, r float, b float) Point[][] {
			return [[new Point(l, t), new Point(r, t)], [new Point(l, b), new Point(r, b)]]
		}

		@test()
		def aFlatGridDrawsTheImage() {
			let src = image(8, 6, (x int, y int) => RGBA{r: byte(x * 30), g: byte(y * 40), b: byte(128), a: byte(255)})
			let warped = new Canvas(30, 30)
			warped.drawImage(src, grid(2.0, 3.0, 26.0, 21.0))
			let plain = new Canvas(30, 30)
			plain.drawImage(src, Rect{left: 2.0, top: 3.0, right: 26.0, bottom: 21.0})
			for let y = 4; y < 20; y++ {
				for let x = 3; x < 25; x++ {
					let (a, b) = (px(warped, x, y), px(plain, x, y))
					assert (int(a.r) - int(b.r)).abs() <= 1 && (int(a.g) - int(b.g)).abs() <= 1 && a.a == b.a
				}
			}
			// Outside the grid nothing is drawn; a grid of one row draws nothing.
			assert px(warped, 1, 10).a == 0 && px(warped, 27, 10).a == 0
			let bare = new Canvas(10, 10)
			bare.drawImage(src, [[new Point(0.0, 0.0), new Point(9.0, 0.0)]])
			assert px(bare, 5, 0).a == 0
		}

		@test()
		def rowsMatchPixelByPixel() {
			// A bent grid: a whole row (eight samples a vector) equals the
			// same pixels shaded one at a time (one by one).
			let src = image(13, 9, (x int, y int) => RGBA{r: byte((x * 37 + y * 11) % 256), g: byte((x * 5 + y * 71) % 256), b: byte((x * y * 13) % 256), a: byte(40 + (x * 29 + y * 17) % 216)})
			let mesh = [[new Point(1.0, 2.0), new Point(30.0, 5.0), new Point(61.0, 1.0)], [new Point(4.0, 30.0), new Point(33.0, 25.0), new Point(58.0, 33.0)]]
			let shader = new WarpShader(src, mesh, new Transform2D(a = 1.3, b = 0.2, c = -0.1, d = 0.9), Sampling.Bilinear)
			for let y = 0; y < 40; y += 3 {
				let row byte[]
				row.len(90 * 4)
				shader.shade(0, y, 90, row)
				for let x = 0; x < 90; x++ {
					let one byte[]
					one.len(4)
					shader.shade(x, y, 1, one)
					for let k = 0; k < 4; k++ {
						assert row[x * 4 + k] == one[k]
					}
				}
			}
		}

		@test()
		def flippedGridsMirror() {
			let src = image(4, 1, (x int, y int) => x < 2 ?? (RGBA{r: 255, g: 0, b: 0, a: 255}, RGBA{r: 0, g: 0, b: 255, a: 255}))
			let cv = new Canvas(40, 10)
			// Left points on the right: the image's left half lands right.
			cv.drawImage(src, grid(40.0, 0.0, 0.0, 10.0), Sampling.Nearest)
			assert px(cv, 35, 5).r == 255 && px(cv, 5, 5).b == 255
		}

		@test()
		def shrunkWarpsAverage() {
			// A 1-pixel checkerboard drawn 16 times smaller averages to grey,
			// not to whichever squares the samples hit.
			let src = image(64, 64, (x int, y int) => (x + y) % 2 == 0 ?? (RGBA{r: 0, g: 0, b: 0, a: 255}, RGBA{r: 255, g: 255, b: 255, a: 255}))
			let cv = new Canvas(8, 8)
			cv.drawImage(src, [[new Point(0.0, 0.0), new Point(4.0, 0.0)], [new Point(0.0, 4.0), new Point(4.0, 4.0)]])
			let g = int(px(cv, 2, 2).r)
			// Averaged in linear light: mid grey is about 188 in sRGB.
			assert g > 170 && g < 205
		}

		@test()
		def recordingsReplayWarps() {
			let src = image(8, 8, (x int, y int) => RGBA{r: byte(x * 30), g: byte(y * 30), b: byte(200), a: byte(255)})
			let mesh = [[new Point(2.0, 2.0), new Point(12.0, 4.0), new Point(22.0, 2.0)], [new Point(3.0, 14.0), new Point(12.0, 12.0), new Point(21.0, 15.0)]]
			let direct = new Canvas(25, 18)
			direct.drawImage(src, mesh)
			let pic = record((p Painter) => {
				p.tag(4)
				p.drawImage(src, mesh)
			})
			// The grid is copied: changing it later does not reach the recording.
			mesh[0][0] = new Point(100.0, 100.0)
			let replayed = new Canvas(25, 18)
			pic.replay(replayed)
			for let i = 0; i < direct.pixels.len(); i++ {
				assert replayed.pixels[i] == direct.pixels[i]
			}
			let b = pic.bounds()
			assert b.left == 2.0 && b.top == 2.0 && b.right == 22.0 && b.bottom == 15.0
			let hit = pic.hitTest(new Point(12.0, 8.0))
			assert hit is int && hit == 4
		}
	}
}
