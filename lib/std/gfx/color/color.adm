partial module std.gfx.color {
	use std.bytes::(Endian)

	// ColorModel is a union type that can hold any of the supported color model structs.
	type ColorModel = Hex | RGB | RGBA | Gray | Gray16 | YCbCr | CMYK | HSL | HSLA | Named

	// Color represents a color that can be manipulated and converted between different models.
	// It internally stores the color as RGBA.
	type Color {
		internal color RGBA

		// Creates a new Color instance from a given color model.
		def new(model ColorModel) {
			toRGBA(model)
		}

		def new(color string) {
			let c = parse(color)
			if !(c is error) {
				rgba = c.rgba
			}
		}

		// Gets or sets the color using the RGB model.
		rgb RGB {
			def get() RGB {
				return RGB{r: color.r, g: color.g, b: color.b}
			}

			def set(value RGB) {
				color = RGBA{r: value.r, g: value.g, b: value.b, a: 255}
			}
		}

		// Gets or sets the color using the RGBA model.
		rgba RGBA {
			def get() RGBA {
				return RGBA{r: color.r, g: color.g, b: color.b, a: color.a}
			}

			def set(value RGBA) {
				color = value
			}
		}

		// Gets or sets the color using the Hex model.
		hex Hex {
			def get() Hex {
				let r = color.r.hex(2)
				let g = color.g.hex(2)
				let b = color.b.hex(2)
				let a = color.a.hex(2)

				return Hex{code: "#" + r + g + b + a} when color.a < 255

				if r[0] == r[1] && g[0] == g[1] && b[0] == b[1] {
					// compact hex format #RGB
					return Hex{code: "#" + r[0] + g[0] + b[0]}
				}
				// full hex format #RRGGBB
				return Hex{code: "#" + r + g + b}
			}

			def set(value Hex) {
				toRGBA(value)
			}
		}

		// Gets or sets the color using the Gray model.
		gray Gray {
			def get() Gray {
				let y = lumaU8(color.r, color.g, color.b)
				return Gray{y: y}
			}

			def set(value Gray) {
				toRGBA(value)
			}
		}

		// Gets or sets the color using the Gray16 model.
		gray16 Gray16 {
			def get() Gray16 {
				let y8 = lumaU8(color.r, color.g, color.b)
				return Gray16{y: uint16(y8) * 257}
			}

			def set(value Gray16) {
				toRGBA(value)
			}
		}

		// Gets or sets the color using the YCbCr model.
		ycbcr YCbCr {
			def get() YCbCr {
				// Approximate ITU-R BT.601 conversion.
				let r = float(color.r)
				let g = float(color.g)
				let b = float(color.b)

				let y = 16.0 + 0.257 * r + 0.504 * g + 0.098 * b
				let cb = 128.0 - 0.148 * r - 0.291 * g + 0.439 * b
				let cr = 128.0 + 0.439 * r - 0.368 * g - 0.071 * b

				return YCbCr{
					y: clampU8(y),
					cb: clampU8(cb),
					cr: clampU8(cr),
				}
			}

			def set(value YCbCr) {
				toRGBA(value)
			}
		}

		// Gets or sets the color using the HSL model.
		hsl HSL {
			def get() HSL {
				let (h, s, l) = rgbToHslParts(color.r, color.g, color.b)
				return HSL{
					h: uint16(h + 0.5),
					s: clampU8(s * 255.0),
					l: clampU8(l * 255.0),
				}
			}

			def set(value HSL) {
				toRGBA(value)
			}
		}

		// Gets or sets the color using the HSLA model.
		hsla HSLA {
			def get() HSLA {
				let (h, s, l) = rgbToHslParts(color.r, color.g, color.b)
				return HSLA{
					h: uint16(h + 0.5),
					s: clampU8(s * 255.0),
					l: clampU8(l * 255.0),
					a: float32(color.a) / 255.0,
				}
			}

			def set(value HSLA) {
				toRGBA(value)
			}
		}

		// Internal helper function to convert HSL to RGB.
		internal def hueToRGB(p, q, t float) float {
			let tt = t

			tt += 1 when tt < 0
			tt -= 1 when tt > 1

			return p + (q - p) * 6 * tt when tt < 1 / 6

			return q when tt < 1 / 2
			return p + (q - p) * (2 / 3 - tt) * 6 when tt < 2 / 3

			return p
		}

		// Internal helper function to convert HSL to the internal RGBA representation.
		internal def hslToRGB(hue uint16, sat, lum uint8) {
			let (r, g, b) = hslToRGBParts(float(hue), float(sat) / 255.0, float(lum) / 255.0)
			color.r = r
			color.g = g
			color.b = b
		}

		// Converts any supported color model to the internal RGBA representation.
		internal def toRGBA(model ColorModel) {
			color.a = 255

			match model {
				case Hex:
					let code = model.code.trim().trimStart("#")
					return unless code.isHexadecimal()

					switch code.len() {
						case 3: // RGB
							color.r = parseInt<uint8>(code[0:1] * 2, 16)
							color.g = parseInt<uint8>(code[1:2] * 2, 16)
							color.b = parseInt<uint8>(code[2:3] * 2, 16)
						case 4: // RGBA
							color.r = parseInt<uint8>(code[0:1] * 2, 16)
							color.g = parseInt<uint8>(code[1:2] * 2, 16)
							color.b = parseInt<uint8>(code[2:3] * 2, 16)
							color.a = parseInt<uint8>(code[3:4] * 2, 16)
						case 6: // RRGGBB
							color.r = parseInt<uint8>(code[0:2], 16)
							color.g = parseInt<uint8>(code[2:4], 16)
							color.b = parseInt<uint8>(code[4:6], 16)
						case 8: // RRGGBBAA
							color.r = parseInt<uint8>(code[0:2], 16)
							color.g = parseInt<uint8>(code[2:4], 16)
							color.b = parseInt<uint8>(code[4:6], 16)
							color.a = parseInt<uint8>(code[6:8], 16)
					}

				case RGB:
					color.r = model.r
					color.g = model.g
					color.b = model.b

				case RGBA:
					color = model

				case Gray:
					color.r = model.y
					color.g = model.y
					color.b = model.y

				case Gray16:
					let y8 = uint8(model.y / 257)
					color.r = y8
					color.g = y8
					color.b = y8

				case YCbCr:
					let y = float(model.y)
					let cb = float(model.cb)
					let cr = float(model.cr)

					let r = 1.164 * (y - 16) + 1.596 * (cr - 128)
					let g = 1.164 * (y - 16) - 0.391 * (cb - 128) - 0.813 * (cr - 128)
					let b = 1.164 * (y - 16) + 2.017 * (cb - 128)

					color.r = uint8(r)
					color.g = uint8(g)
					color.b = uint8(b)

				case CMYK:
					let k = clamp01(model.k)
					color.r = clampU8(255.0 * (1.0 - clamp01(model.c)) * (1.0 - k))
					color.g = clampU8(255.0 * (1.0 - clamp01(model.m)) * (1.0 - k))
					color.b = clampU8(255.0 * (1.0 - clamp01(model.y)) * (1.0 - k))

				case HSL:
					hslToRGB(model.h, model.s, model.l)

				case HSLA:
					hslToRGB(model.h, model.s, model.l)
					color.a = uint8(model.a * 255)

				case Named:
					let tmp = namedColors[model.name]
					if tmp is RGBA {
						color.r = tmp.r
						color.g = tmp.g
						color.b = tmp.b
					}
			}
		}

		// Gets or sets the red component of the color.
		red uint8 {
			def get() uint8 {
				return color.r
			}

			def set(value uint8) {
				color.r = value
			}
		}

		// Gets or sets the green component of the color.
		green uint8 {
			def get() uint8 {
				return color.g
			}

			def set(value uint8) {
				color.g = value
			}
		}

		// Gets or sets the blue component of the color.
		blue uint8 {
			def get() uint8 {
				return color.b
			}

			def set(value uint8) {
				color.b = value
			}
		}

		// Gets or sets the alpha channel of the color.
		alpha uint8 {
			def get() uint8 {
				return color.a
			}

			def set(value uint8) {
				color.a = value
			}
		}

		// Gets or sets the HSL lightness of the color.
		//
		// This is the `L` of HSL, not a perceptual brightness: pure yellow and
		// pure blue both report 128. Use relativeLuminance() to compare how
		// bright two colors look.
		lightness uint8 {
			def get() uint8 {
				let (_, _, l) = rgbToHslParts(color.r, color.g, color.b)
				return clampU8(l * 255.0)
			}

			def set(value uint8) {
				let (h, s, _) = rgbToHslParts(color.r, color.g, color.b)
				let (r, g, b) = hslToRGBParts(h, s, float(value) / 255.0)
				color.r = r
				color.g = g
				color.b = b
			}
		}

		// Gets or sets the saturation of the color
		saturation uint8 {
			def get() uint8 {
				let (_, s, _) = rgbToHslParts(color.r, color.g, color.b)
				return clampU8(s * 255.0)
			}

			def set(value uint8) {
				let (h, _, l) = rgbToHslParts(color.r, color.g, color.b)
				let (r, g, b) = hslToRGBParts(h, float(value) / 255.0, l)
				color.r = r
				color.g = g
				color.b = b
			}
		}

		// Gets or sets the hue of the color
		hue uint16 {
			def get() uint16 {
				let (h, _, _) = rgbToHslParts(color.r, color.g, color.b)
				return uint16(h + 0.5)
			}

			def set(value uint16) {
				let (_, s, l) = rgbToHslParts(color.r, color.g, color.b)
				let (r, g, b) = hslToRGBParts(float(value), s, l)
				color.r = r
				color.g = g
				color.b = b
			}
		}

		// Gets or sets the color using the CMYK model.
		cmyk CMYK {
			def get() CMYK {
				let r = float(color.r) / 255.0
				let g = float(color.g) / 255.0
				let b = float(color.b) / 255.0

				let maxv = r
				maxv = g when g > maxv
				maxv = b when b > maxv

				return CMYK{c: 0.0, m: 0.0, y: 0.0, k: 1.0} when maxv <= 0.0

				return CMYK{
					c: (maxv - r) / maxv,
					m: (maxv - g) / maxv,
					y: (maxv - b) / maxv,
					k: 1.0 - maxv,
				}
			}

			def set(value CMYK) {
				toRGBA(value)
			}
		}

		// Returns this color composited over another using a blend mode.
		def blend(other Color, mode BlendMode) Color {
			return new Color(blendRGBA(color, other.color, mode))
		}

		// Returns a mix of this color and another.
		//
		// The weight is how much of the *other* color to take: 0 keeps this
		// color, 1 returns the other, and the default 0.5 is an even mix. Channels
		// are mixed in sRGB space; mixLinear() mixes in linear light instead.
		def mix(other Color, weight float = 0.5) Color {
			return lerp(other, weight)
		}

		// Returns a mix of this color and another, computed in linear light.
		//
		// Linear mixing is what light actually does, so a red-to-green midpoint
		// stays bright instead of dipping through a muddy tone. Prefer it for
		// gradients and image work; sRGB mixing matches what design tools show.
		def mixLinear(other Color, weight float = 0.5) Color {
			let u = clamp01(weight)

			let r = linearToSrgb(srgbToLinear(color.r) + (srgbToLinear(other.color.r) - srgbToLinear(color.r)) * u)
			let g = linearToSrgb(srgbToLinear(color.g) + (srgbToLinear(other.color.g) - srgbToLinear(color.g)) * u)
			let b = linearToSrgb(srgbToLinear(color.b) + (srgbToLinear(other.color.b) - srgbToLinear(color.b)) * u)
			let a = float(color.a) + (float(other.color.a) - float(color.a)) * u

			return new Color(RGBA{r: r, g: g, b: b, a: clampU8(a)})
		}

		// Returns the color darkened by a percentage of full lightness.
		//
		// `darken(10)` moves the HSL lightness down by 10 percentage points, so
		// repeated calls walk steadily toward black.
		def darken(percent float = 10.0) Color {
			let (h, s, l) = rgbToHslParts(color.r, color.g, color.b)
			return fromHsl(h, s, clamp01(l - percent / 100.0))
		}

		// Returns the color lightened by a percentage of full lightness.
		def lighten(percent float = 10.0) Color {
			let (h, s, l) = rgbToHslParts(color.r, color.g, color.b)
			return fromHsl(h, s, clamp01(l + percent / 100.0))
		}

		// Returns the color with its saturation raised by a percentage.
		def saturate(percent float = 10.0) Color {
			let (h, s, l) = rgbToHslParts(color.r, color.g, color.b)
			return fromHsl(h, clamp01(s + percent / 100.0), l)
		}

		// Returns the color with its saturation lowered by a percentage.
		def desaturate(percent float = 10.0) Color {
			let (h, s, l) = rgbToHslParts(color.r, color.g, color.b)
			return fromHsl(h, clamp01(s - percent / 100.0), l)
		}

		// Returns the color with all saturation removed, preserving brightness.
		def grayscale() Color {
			let y = lumaU8(color.r, color.g, color.b)
			return new Color(RGBA{r: y, g: y, b: y, a: color.a})
		}

		// Returns the color with its hue rotated by the given angle in degrees.
		def rotate(degrees float) Color {
			let (h, s, l) = rgbToHslParts(color.r, color.g, color.b)
			let rotated = (h + degrees) % 360.0
			rotated += 360.0 when rotated < 0.0
			return fromHsl(rotated, s, l)
		}

		// Returns the color with each channel inverted.
		def invert() Color {
			return new Color(RGBA{r: 255 - color.r, g: 255 - color.g, b: 255 - color.b, a: color.a})
		}

		// Returns the color with a different alpha channel.
		def withAlpha(alpha uint8) Color {
			return new Color(RGBA{r: color.r, g: color.g, b: color.b, a: alpha})
		}

		// Returns the color with a different opacity, where 0.0 is fully
		// transparent and 1.0 fully opaque.
		def withOpacity(opacity float) Color {
			return withAlpha(clampU8(clamp01(opacity) * 255.0))
		}

		// Returns the color made more transparent by a percentage of full alpha.
		def fade(percent float = 10.0) Color {
			return withOpacity(clamp01(float(color.a) / 255.0 - percent / 100.0))
		}

		// Interpolates between two colors.
		// When the amount is 0, the current color is returned.
		// When the amount is 1, the target color is returned.
		def lerp(other Color, amount float) Color {
			let u = clamp01(amount)

			let r = float(color.r) + (float(other.color.r) - float(color.r)) * u
			let g = float(color.g) + (float(other.color.g) - float(color.g)) * u
			let b = float(color.b) + (float(other.color.b) - float(color.b)) * u
			let a = float(color.a) + (float(other.color.a) - float(color.a)) * u

			return new Color(RGBA{r: clampU8(r), g: clampU8(g), b: clampU8(b), a: clampU8(a)})
		}

		// Returns an evenly spaced gradient from this color to another.
		//
		// The result includes both endpoints, so `count` must be at least 2.
		def steps(other Color, count int) Color[] {
			return Color[] when count <= 0
			return Color[new Color(color)] when count == 1

			let out Color[]
			for let i = 0; i < count; i++ {
				out += [lerp(other, float(i) / float(count - 1))]
			}
			return out
		}

		// Returns how much light the color emits, on the 0.0-1.0 scale WCAG
		// defines: sRGB channels are linearized and weighted by human sensitivity.
		//
		// Unlike `lightness`, this tracks perceived brightness — yellow scores far
		// higher than blue.
		def relativeLuminance() float {
			let r = srgbToLinear(color.r)
			let g = srgbToLinear(color.g)
			let b = srgbToLinear(color.b)
			return 0.2126 * r + 0.7152 * g + 0.0722 * b
		}

		// Returns the WCAG contrast ratio between two colors, from 1.0 (identical)
		// to 21.0 (black against white).
		//
		// Alpha is ignored; composite the colors first if either is translucent.
		def contrastRatio(other Color) float {
			let a = relativeLuminance()
			let b = other.relativeLuminance()
			let lighter = a > b ?? (a, b)
			let darker = a > b ?? (b, a)
			return (lighter + 0.05) / (darker + 0.05)
		}

		// Reports whether text in this color is legible against a background,
		// using the WCAG AA threshold of 4.5:1 by default. AA large text is 3.0
		// and AAA is 7.0.
		def isReadableOn(background Color, minimumRatio float = 4.5) bool {
			return contrastRatio(background) >= minimumRatio
		}

		// Reports whether the color reads as dark to the eye.
		def isDark() bool {
			return relativeLuminance() < 0.179
		}

		// Reports whether the color reads as light to the eye.
		def isLight() bool {
			return !isDark()
		}

		// Returns whichever of black or white is more legible on this color.
		def bestTextColor() Color {
			let black = new Color(RGBA{r: 0, g: 0, b: 0, a: 255})
			let white = new Color(RGBA{r: 255, g: 255, b: 255, a: 255})
			return contrastRatio(black) >= contrastRatio(white) ?? (black, white)
		}

		// Compares two colors by their channels rather than by identity.
		infix def == (other Color) bool {
			return equals(other)
		}

		// Reports whether two colors have identical channels.
		def equals(other Color) bool {
			return color.r == other.color.r
				&& color.g == other.color.g
				&& color.b == other.color.b
				&& color.a == other.color.a
		}

		// Returns the color written the way CSS writes it.
		//
		// The default spelling is `rgb()`, or `rgba()` when the color is
		// translucent. Hex and HSL spellings are available by asking for them;
		// any other format falls back to `rgb()`.
		def css(format ColorFormat = ColorFormat.RGBA) string {
			switch format {
				case ColorFormat.Hex:
					return hex.code.lower()
				case ColorFormat.HSL, ColorFormat.HSLA:
					let (h, s, l) = rgbToHslParts(color.r, color.g, color.b)
					let hh = int(h + 0.5)
					let ss = int(s * 100.0 + 0.5)
					let ll = int(l * 100.0 + 0.5)
					return "hsl({hh}, {ss}%, {ll}%)" when color.a >= 255
					return "hsla({hh}, {ss}%, {ll}%, {opacityText()})"
				default:
					return "rgb({color.r}, {color.g}, {color.b})" when color.a >= 255
					return "rgba({color.r}, {color.g}, {color.b}, {opacityText()})"
			}
		}

		// Renders the alpha channel as the 0-1 fraction CSS expects.
		internal def opacityText() string {
			let hundredths = int(float(color.a) / 255.0 * 100.0 + 0.5)
			return "1" when hundredths >= 100
			return "0" when hundredths <= 0
			return "0.{hundredths}" when hundredths >= 10
			return "0.0{hundredths}"
		}

		// Builds a color from HSL parts, keeping this color's alpha.
		internal def fromHsl(hue float, s float, l float) Color {
			let (r, g, b) = hslToRGBParts(hue, s, l)
			return new Color(RGBA{r: r, g: g, b: b, a: color.a})
		}

		// Returns the complementary color.
		def complement() Color {
			let (h, s, l) = rgbToHslParts(color.r, color.g, color.b)
			let nh = h + 180.0
			nh -= 360.0 when nh >= 360.0
			let (r, g, b) = hslToRGBParts(nh, s, l)
			return new Color(RGBA{r: r, g: g, b: b, a: color.a})
		}

		// Returns a tuple of triadic colors (base not included)
		def triad() (Color, Color) {
			let (h, s, l) = rgbToHslParts(color.r, color.g, color.b)
			let h1 = h + 120.0
			let h2 = h + 240.0
			h1 -= 360.0 when h1 >= 360.0
			h2 -= 360.0 when h2 >= 360.0
			let (r1, g1, b1) = hslToRGBParts(h1, s, l)
			let (r2, g2, b2) = hslToRGBParts(h2, s, l)
			return (
				new Color(RGBA{r: r1, g: g1, b: b1, a: color.a}),
				new Color(RGBA{r: r2, g: g2, b: b2, a: color.a})
			)
		}

		// Returns a monochromatic color scheme based on the current color.
		def monochromatic() Color {
			let (h, s, l) = rgbToHslParts(color.r, color.g, color.b)
			let ll = clamp01(l + 0.15)
			let (r, g, b) = hslToRGBParts(h, s, ll)
			return new Color(RGBA{r: r, g: g, b: b, a: color.a})
		}

		// Returns a tuple of analogous colors (base not included)
		def analogous() (Color, Color) {
			let (h, s, l) = rgbToHslParts(color.r, color.g, color.b)
			let h1 = h + 30.0
			let h2 = h - 30.0
			h1 -= 360.0 when h1 >= 360.0
			h2 += 360.0 when h2 < 0.0
			let (r1, g1, b1) = hslToRGBParts(h1, s, l)
			let (r2, g2, b2) = hslToRGBParts(h2, s, l)
			return (
				new Color(RGBA{r: r1, g: g1, b: b1, a: color.a}),
				new Color(RGBA{r: r2, g: g2, b: b2, a: color.a})
			)
		}

		// Returns a tuple of tetradic colors (base not included)
		def tetradic() (Color, Color, Color) {
			let (h, s, l) = rgbToHslParts(color.r, color.g, color.b)
			let h1 = h + 90.0
			let h2 = h + 180.0
			let h3 = h + 270.0
			h1 -= 360.0 when h1 >= 360.0
			h2 -= 360.0 when h2 >= 360.0
			h3 -= 360.0 when h3 >= 360.0
			let (r1, g1, b1) = hslToRGBParts(h1, s, l)
			let (r2, g2, b2) = hslToRGBParts(h2, s, l)
			let (r3, g3, b3) = hslToRGBParts(h3, s, l)
			return (
				new Color(RGBA{r: r1, g: g1, b: b1, a: color.a}),
				new Color(RGBA{r: r2, g: g2, b: b2, a: color.a}),
				new Color(RGBA{r: r3, g: g3, b: b3, a: color.a})
			)
		}

		def pack(endianess Endian = Endian.Little) uint32 {
			if endianess == Endian.Little {
				return uint32(color.r) | (uint32(color.g) << 8) | (uint32(color.b) << 16) | (uint32(color.a) << 24)
			}
			return uint32(color.a) | (uint32(color.b) << 8) | (uint32(color.g) << 16) | (uint32(color.r) << 24)
		}

		def str() string {
			return "rgba({color.r}, {color.g}, {color.b}, {color.a})"
		}

		def bytes() byte[] {
			return byte[color.r, color.g, color.b, color.a]
		}
	}

	// Splits the arguments of a functional color notation.
	//
	// Components may be separated by commas, whitespace, or the slash CSS uses
	// before an alpha value, so all three are treated the same.
	internal def splitColorArgs(text string) string[] {
		let normalized = text.replace(",", " ").replace("/", " ")
		let parts string[]
		for let (_, piece) in normalized.split(" ") {
			let trimmed = piece.trim()
			parts += [trimmed] unless trimmed.isEmpty()
		}
		return parts
	}

	// Reads one numeric color component, resolving a percentage against full.
	//
	// A bare number is returned as written; `50%` of a full value of 255 is
	// 127.5. Anything that is not a number fails.
	internal def parseColorComponent(text string, full float) !float {
		let value = text.trim()
		fail "missing color component" when value.isEmpty()

		if value.endsWith("%") {
			let number = value.trimEnd("%").trim()
			fail "invalid percentage: {text}" unless number.isNumeric()
			return parseFloat<float>(number) / 100.0 * full
		}

		fail "invalid number: {text}" unless value.isNumeric()
		return parseFloat<float>(value)
	}

	// Reads an alpha component, which CSS writes as either 0-1 or a percentage.
	internal def parseAlpha(text string) !float {
		let value = try parseColorComponent(text, 1.0)
		return clamp01(value)
	}

	// Parses a color written the way CSS writes it.
	//
	// Accepts hex (`#RGB`, `#RGBA`, `#RRGGBB`, `#RRGGBBAA`), the functional
	// notations `rgb()`, `rgba()`, `hsl()`, and `hsla()`, and the CSS named
	// colors. Components may be separated by commas or spaces, `rgb()` accepts
	// numbers or percentages, and both `rgb()` and `hsl()` accept a fourth alpha
	// component so the `a`-suffixed spellings are interchangeable with them.
	//
	// Fails when the string does not name a color.
	def parse(color string) !Color {
		let text = color.trim()
		fail "empty color string" when text.isEmpty()

		if text.startsWith("#") {
			let code = text.trimStart("#")
			fail "invalid hex color: {color}" unless code.isHexadecimal()
			let width = code.len()
			fail "invalid hex color: {color}" unless width == 3 || width == 4 || width == 6 || width == 8
			return new Color(Hex{code: code})
		}

		let lowered = text.lower()
		if lowered.endsWith(")") {
			let open = lowered.indexOf("(")
			fail "invalid color format: {color}" when open <= 0

			let name = lowered[0:open].trim()
			let args = splitColorArgs(lowered[open + 1:lowered.len() - 1])

			switch name {
				case "rgb", "rgba":
					fail "{name}() takes 3 or 4 components, got {args.len()}" unless args.len() == 3 || args.len() == 4

					let r = clampU8(try parseColorComponent(args[0], 255.0))
					let g = clampU8(try parseColorComponent(args[1], 255.0))
					let b = clampU8(try parseColorComponent(args[2], 255.0))
					let a = args.len() == 4 ?? (try parseAlpha(args[3]), 1.0)

					return new Color(RGBA{r: r, g: g, b: b, a: clampU8(a * 255.0)})

				case "hsl", "hsla":
					fail "{name}() takes 3 or 4 components, got {args.len()}" unless args.len() == 3 || args.len() == 4

					let hue = try parseColorComponent(args[0], 360.0)
					let s = clamp01((try parseColorComponent(args[1], 100.0)) / 100.0)
					let l = clamp01((try parseColorComponent(args[2], 100.0)) / 100.0)
					let a = args.len() == 4 ?? (try parseAlpha(args[3]), 1.0)

					// Hue is an angle: any multiple of a full turn names the same hue.
					let wrapped = hue % 360.0
					wrapped += 360.0 when wrapped < 0.0

					// Convert at full precision rather than through HSLA, whose
					// 0-255 saturation and lightness cannot hold a percentage
					// exactly: 50% would land on 127/255 and tint the result.
					let (r, g, b) = hslToRGBParts(wrapped, s, l)
					return new Color(RGBA{r: r, g: g, b: b, a: clampU8(a * 255.0)})

				default:
					fail "unknown color function: {name}()"
			}
		}

		return new Color(namedColors[lowered]) when namedColors.hasKey(lowered)

		fail "invalid color format: {color}"
	}
}
