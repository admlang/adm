partial module std.gfx.color {
	use (
		std.crypto
		std.math
		std.gfx.colorspace::*
	)

	// blendRGBA composites `src` over `dst` using the given blend mode.
	//
	// This implements standard source-over alpha compositing with PDF/W3C blend modes.
	// The blend mode affects the color channels; alpha is always composited.
	def blendRGBA(dst RGBA, src RGBA, mode BlendMode) RGBA {
		let (r, g, b, a) = blendBytes(mode, src.r, src.g, src.b, src.a, dst.r, dst.g, dst.b, dst.a)
		return RGBA{r: r, g: g, b: b, a: a}
	}

	// Returns the average of a set of colors.
	//
	// Channels are averaged in linear light, so the result matches what the eye
	// expects rather than drifting dark the way an sRGB average does.
	//
	// Fails when the set is empty.
	def average(colors Color[]) !Color {
		fail "average() needs at least one color" when colors.len() == 0

		let r = 0.0
		let g = 0.0
		let b = 0.0
		let a = 0.0
		for let (_, c) in colors {
			let rgba = c.rgba
			r += srgbToLinear(rgba.r)
			g += srgbToLinear(rgba.g)
			b += srgbToLinear(rgba.b)
			a += float(rgba.a)
		}

		let n = float(colors.len())
		return new Color(RGBA{
			r: linearToSrgb(r / n),
			g: linearToSrgb(g / n),
			b: linearToSrgb(b / n),
			a: clampU8(a / n),
		})
	}

	// Returns a random opaque color.
	//
	// Every channel is drawn independently over the full 0-255 range, so the
	// result is uniform across the RGB cube rather than biased toward a hue.
	def random() Color {
		return new Color(RGBA{
			r: crypto.randOf<uint8>(),
			g: crypto.randOf<uint8>(),
			b: crypto.randOf<uint8>(),
			a: 255,
		})
	}

	// Returns the color of a black body radiating at the given temperature.
	//
	// Kelvin values run from candlelight (about 1900K) through daylight (6500K)
	// to overcast sky (about 12000K); anything outside 1000-40000K is clamped.
	// Uses Tanner Helland's approximation of the Planckian locus.
	def fromKelvin(kelvin float) Color {
		let t = kelvin
		t = 1000.0 when t < 1000.0
		t = 40000.0 when t > 40000.0
		t /= 100.0

		let r = 255.0
		let g = 255.0
		let b = 255.0

		if t <= 66.0 {
			g = 99.4708025861 * math.ln(t) - 161.1195681661
			if t <= 19.0 {
				b = 0.0
			} else {
				b = 138.5177312231 * math.ln(t - 10.0) - 305.0447927307
			}
		} else {
			r = 329.698727446 * ((t - 60.0) ** -0.1332047592)
			g = 288.1221695283 * ((t - 60.0) ** -0.0755148492)
		}

		return new Color(RGBA{r: clampU8(r), g: clampU8(g), b: clampU8(b), a: 255})
	}
}
