partial module std.gfx.color {
	use (
		std.crypto
		std.math
	)

	internal def clamp01(x float) float {
		return 0.0 when x < 0.0
		return 1.0 when x > 1.0
		return x
	}

	internal def clampU8(x float) uint8 {
		let v = x
		v = 0.0 when v < 0.0
		v = 255.0 when v > 255.0
		return uint8(v + 0.5)
	}

	internal def clampU8i(x int) uint8 {
		return 0 when x <= 0
		return 255 when x >= 255
		return uint8(x)
	}

	internal def rgbToHslParts(r uint8, g uint8, b uint8) (float, float, float) {
		let rf = float(r) / 255.0
		let gf = float(g) / 255.0
		let bf = float(b) / 255.0

		let maxv = rf
		maxv = gf when gf > maxv
		maxv = bf when bf > maxv

		let minv = rf
		minv = gf when gf < minv
		minv = bf when bf < minv

		let l = (maxv + minv) / 2.0
		let d = maxv - minv

		if d == 0.0 {
			return (0.0, 0.0, l)
		}

		let s = d / (1.0 - (2.0 * l - 1.0).abs())

		let h = 0.0
		if maxv == rf {
			h = (gf - bf) / d
			h += 6.0 when h < 0.0
		} else if maxv == gf {
			h = (bf - rf) / d + 2.0
		} else {
			h = (rf - gf) / d + 4.0
		}
		h *= 60.0
		return (h, s, l)
	}

	internal def hueToRGB(p float, q float, t float) float {
		let tt = t
		tt += 1.0 when tt < 0.0
		tt -= 1.0 when tt > 1.0

		return p + (q - p) * 6.0 * tt when tt < (1.0 / 6.0)
		return q when tt < 0.5
		return p + (q - p) * (2.0 / 3.0 - tt) * 6.0 when tt < (2.0 / 3.0)
		return p
	}

	internal def hslToRGBParts(hDeg float, s float, l float) (uint8, uint8, uint8) {
		let h = hDeg / 360.0
		let ss = clamp01(s)
		let ll = clamp01(l)

		if ss == 0.0 {
			let v = clampU8(ll * 255.0)
			return (v, v, v)
		}

		let q = ll < 0.5 ?? (ll * (1.0 + ss), ll + ss - ll * ss)
		let p = 2.0 * ll - q

		let r = hueToRGB(p, q, h + 1.0 / 3.0)
		let g = hueToRGB(p, q, h)
		let b = hueToRGB(p, q, h - 1.0 / 3.0)
		return (clampU8(r * 255.0), clampU8(g * 255.0), clampU8(b * 255.0))
	}

	// Converts one sRGB channel to linear light, undoing the display gamma.
	//
	// Light adds up linearly; sRGB values do not. Anything that reasons about
	// brightness — luminance, contrast, physically correct mixing — has to work
	// on these values rather than the stored bytes.
	internal def srgbToLinear(chan uint8) float {
		let c = float(chan) / 255.0
		return c / 12.92 when c <= 0.04045
		return ((c + 0.055) / 1.055) ** 2.4
	}

	// Converts a linear-light value back to an sRGB channel.
	internal def linearToSrgb(value float) uint8 {
		let v = clamp01(value)
		return clampU8(v * 12.92 * 255.0) when v <= 0.0031308
		return clampU8((1.055 * (v ** (1.0 / 2.4)) - 0.055) * 255.0)
	}

	internal def lumaU8(r uint8, g uint8, b uint8) uint8 {
		// ITU-R BT.601 luma approximation.
		let rr = int(r)
		let gg = int(g)
		let bb = int(b)
		return clampU8i((rr * 299 + gg * 587 + bb * 114 + 500) / 1000)
	}

	internal def blendSeparable(mode BlendMode, cs float, cd float) float {
		// Inputs/outputs are in [0..1].
		switch mode {
			case BlendMode.Normal:
				return cs
			case BlendMode.Darken:
				return cs when cs < cd
				return cd
			case BlendMode.Lighten:
				return cs when cs > cd
				return cd
			case BlendMode.Multiply:
				return cs * cd
			case BlendMode.Screen:
				return 1.0 - (1.0 - cs) * (1.0 - cd)
			case BlendMode.Overlay:
				return 2.0 * cs * cd when cd <= 0.5
				return 1.0 - 2.0 * (1.0 - cs) * (1.0 - cd)
			case BlendMode.HardLight:
				return 2.0 * cs * cd when cs <= 0.5
				return 1.0 - 2.0 * (1.0 - cs) * (1.0 - cd)
			case BlendMode.SoftLight:
				if cs <= 0.5 {
					return cd - (1.0 - 2.0 * cs) * cd * (1.0 - cd)
				}
				let g = 0.0
				if cd <= 0.25 {
					g = ((16.0 * cd - 12.0) * cd + 4.0) * cd
				} else {
					g = math.sqrt(cd)
				}
				return cd + (2.0 * cs - 1.0) * (g - cd)
			case BlendMode.ColorDodge:
				return 1.0 when cs >= 1.0
				return 1.0 when cd >= 1.0
				let v = cd / (1.0 - cs)
				return 1.0 when v > 1.0
				return v
			case BlendMode.ColorBurn:
				return 0.0 when cs <= 0.0
				return 0.0 when cd <= 0.0
				let v = 1.0 - (1.0 - cd) / cs
				return 0.0 when v < 0.0
				return v
			case BlendMode.LinearDodge:
				let v = cs + cd
				return 1.0 when v > 1.0
				return v
			case BlendMode.LinearBurn:
				let v = cs + cd - 1.0
				return 0.0 when v < 0.0
				return v
			case BlendMode.VividLight:
				return blendSeparable(BlendMode.ColorBurn, 2.0 * cs, cd) when cs < 0.5
				return blendSeparable(BlendMode.ColorDodge, 2.0 * cs - 1.0, cd)
			case BlendMode.LinearLight:
				let v = cd + 2.0 * cs - 1.0
				return 0.0 when v < 0.0
				return 1.0 when v > 1.0
				return v
			case BlendMode.PinLight:
				return blendSeparable(BlendMode.Darken, 2.0 * cs, cd) when cs < 0.5
				return blendSeparable(BlendMode.Lighten, 2.0 * cs - 1.0, cd)
			case BlendMode.HardMix:
				let v = blendSeparable(BlendMode.VividLight, cs, cd)
				return 0.0 when v < 0.5
				return 1.0
			case BlendMode.Difference:
				let v = cd - cs
				v = -v when v < 0.0
				return v
			case BlendMode.Exclusion:
				return cd + cs - 2.0 * cd * cs
			case BlendMode.Subtract:
				let v = cd - cs
				return 0.0 when v < 0.0
				return v
			case BlendMode.Divide:
				return 1.0 when cs <= 0.0
				let v = cd / cs
				return 1.0 when v > 1.0
				return v
			case BlendMode.Average:
				return (cs + cd) / 2.0
			case BlendMode.Negation:
				return 1.0 - (1.0 - cd - cs).abs()
			default:
				return cs
		}
	}

	internal def blendRGB(mode BlendMode, sr uint8, sg uint8, sb uint8, dr uint8, dg uint8, db uint8) (uint8, uint8, uint8) {
		let ss = int(sr) + int(sg) + int(sb)
		let ds = int(dr) + int(dg) + int(db)

		switch mode {
			case BlendMode.DarkerColor:
				return (sr, sg, sb) when ss < ds
				return (dr, dg, db)
			case BlendMode.LighterColor:
				return (sr, sg, sb) when ss > ds
				return (dr, dg, db)
			case BlendMode.Xor:
				return (sr ^ dr, sg ^ dg, sb ^ db)
			default:
				// Separable modes are done per channel in [0..1].
				let sr1 = float(sr) / 255.0
				let sg1 = float(sg) / 255.0
				let sb1 = float(sb) / 255.0
				let dr1 = float(dr) / 255.0
				let dg1 = float(dg) / 255.0
				let db1 = float(db) / 255.0

				let r = blendSeparable(mode, sr1, dr1)
				let g = blendSeparable(mode, sg1, dg1)
				let b = blendSeparable(mode, sb1, db1)
				return (clampU8(r * 255.0), clampU8(g * 255.0), clampU8(b * 255.0))
		}
	}

	internal def blendNonSeparable(mode BlendMode, sr uint8, sg uint8, sb uint8, dr uint8, dg uint8, db uint8) (uint8, uint8, uint8) {
		let (hs, ss, ls) = rgbToHslParts(sr, sg, sb)
		let (hd, sd, ld) = rgbToHslParts(dr, dg, db)

		switch mode {
			case BlendMode.Hue:
				return hslToRGBParts(hs, sd, ld)
			case BlendMode.Saturation:
				return hslToRGBParts(hd, ss, ld)
			case BlendMode.Color:
				return hslToRGBParts(hs, ss, ld)
			case BlendMode.Luminosity:
				return hslToRGBParts(hd, sd, ls)
			default:
				return (sr, sg, sb)
		}
	}

	// blendRGBA composites `src` over `dst` using the given blend mode.
	//
	// This implements standard source-over alpha compositing with PDF/W3C blend modes.
	// The blend mode affects the color channels; alpha is always composited.
	def blendRGBA(dst RGBA, src RGBA, mode BlendMode) RGBA {
		let sa = float(src.a) / 255.0
		let da = float(dst.a) / 255.0

		// Fast paths.
		return dst when sa <= 0.0
		return src when da <= 0.0 && mode != BlendMode.Dissolve

		if mode == BlendMode.Dissolve {
			// Dissolve is stochastic; without a random source, use a deterministic
			// threshold based on alpha.
			return dst when sa < 0.5
			return src
		}

		let sr = src.r
		let sg = src.g
		let sb = src.b
		let dr = dst.r
		let dg = dst.g
		let db = dst.b

		let (br, bg, bb) = blendRGB(mode, sr, sg, sb, dr, dg, db)
		if mode == BlendMode.Hue || mode == BlendMode.Saturation || mode == BlendMode.Color || mode == BlendMode.Luminosity {
			(br, bg, bb) = blendNonSeparable(mode, sr, sg, sb, dr, dg, db)
		}

		let ao = sa + da - sa * da
		return RGBA{r: 0, g: 0, b: 0, a: 0} when ao <= 0.0

		// Premultiply.
		let srp = float(sr) / 255.0 * sa
		let sgp = float(sg) / 255.0 * sa
		let sbp = float(sb) / 255.0 * sa
		let drp = float(dr) / 255.0 * da
		let dgp = float(dg) / 255.0 * da
		let dbp = float(db) / 255.0 * da

		let brp = float(br) / 255.0
		let bgp = float(bg) / 255.0
		let bbp = float(bb) / 255.0

		// Co_p = Cs_p*(1-Da) + Cd_p*(1-Sa) + B(Cs,Cd)*Sa*Da
		let outRp = srp * (1.0 - da) + drp * (1.0 - sa) + brp * (sa * da)
		let outGp = sgp * (1.0 - da) + dgp * (1.0 - sa) + bgp * (sa * da)
		let outBp = sbp * (1.0 - da) + dbp * (1.0 - sa) + bbp * (sa * da)

		let outR = clampU8(clamp01(outRp / ao) * 255.0)
		let outG = clampU8(clamp01(outGp / ao) * 255.0)
		let outB = clampU8(clamp01(outBp / ao) * 255.0)
		let outA = clampU8(ao * 255.0)

		return RGBA{r: outR, g: outG, b: outB, a: outA}
	}

	// Returns the average of a set of colors.
	//
	// Channels are averaged in linear light, so the result matches what the eye
	// expects rather than drifting dark the way an sRGB average does.
	//
	// Fails when the set is empty.
	def average(colors Color[]) !Color {
		fail "average() needs at least one color" when colors.len() == 0

		let r = 0.0
		let g = 0.0
		let b = 0.0
		let a = 0.0
		for let (_, c) in colors {
			let rgba = c.rgba
			r += srgbToLinear(rgba.r)
			g += srgbToLinear(rgba.g)
			b += srgbToLinear(rgba.b)
			a += float(rgba.a)
		}

		let n = float(colors.len())
		return new Color(RGBA{
			r: linearToSrgb(r / n),
			g: linearToSrgb(g / n),
			b: linearToSrgb(b / n),
			a: clampU8(a / n),
		})
	}

	// Returns a random opaque color.
	//
	// Every channel is drawn independently over the full 0-255 range, so the
	// result is uniform across the RGB cube rather than biased toward a hue.
	def random() Color {
		return new Color(RGBA{
			r: crypto.randOf<uint8>(),
			g: crypto.randOf<uint8>(),
			b: crypto.randOf<uint8>(),
			a: 255,
		})
	}

	// Returns the color of a black body radiating at the given temperature.
	//
	// Kelvin values run from candlelight (about 1900K) through daylight (6500K)
	// to overcast sky (about 12000K); anything outside 1000-40000K is clamped.
	// Uses Tanner Helland's approximation of the Planckian locus.
	def fromKelvin(kelvin float) Color {
		let t = kelvin
		t = 1000.0 when t < 1000.0
		t = 40000.0 when t > 40000.0
		t /= 100.0

		let r = 255.0
		let g = 255.0
		let b = 255.0

		if t <= 66.0 {
			g = 99.4708025861 * math.ln(t) - 161.1195681661
			if t <= 19.0 {
				b = 0.0
			} else {
				b = 138.5177312231 * math.ln(t - 10.0) - 305.0447927307
			}
		} else {
			r = 329.698727446 * ((t - 60.0) ** -0.1332047592)
			g = 288.1221695283 * ((t - 60.0) ** -0.0755148492)
		}

		return new Color(RGBA{r: clampU8(r), g: clampU8(g), b: clampU8(b), a: 255})
	}
}
