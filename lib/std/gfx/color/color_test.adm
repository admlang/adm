partial module std.gfx.color {
	use (
		std.testing
		std.math
	)

	check "Color parsing" {
		internal def rgbaOf(input string) !RGBA {
			let parsed = try parse(input)
			return parsed.rgba
		}

		internal def assertRGBA(input string, r uint8, g uint8, b uint8, a uint8) !none {
			let got = try rgbaOf(input)
			assert got.r == r
			assert got.g == g
			assert got.b == b
			assert got.a == a
			return none
		}

		@test()
		def parsesShortHex() !none {
			try assertRGBA("#f00", 255, 0, 0, 255)
			try assertRGBA("#0f0", 0, 255, 0, 255)
			try assertRGBA("#abc", 0xaa, 0xbb, 0xcc, 255)
			return none
		}

		@test()
		def parsesShortHexWithAlpha() !none {
			try assertRGBA("#f008", 255, 0, 0, 0x88)
			try assertRGBA("#0f0f", 0, 255, 0, 255)
			return none
		}

		@test()
		def parsesFullHex() !none {
			try assertRGBA("#ff0000", 255, 0, 0, 255)
			try assertRGBA("#123456", 0x12, 0x34, 0x56, 255)
			// Case is irrelevant.
			try assertRGBA("#AABBCC", 0xaa, 0xbb, 0xcc, 255)
			return none
		}

		@test()
		def parsesFullHexWithAlpha() !none {
			try assertRGBA("#ff000080", 255, 0, 0, 0x80)
			try assertRGBA("#00000000", 0, 0, 0, 0)
			return none
		}

		@test()
		def rejectsMalformedHex() !none {
			assert parse("#xyz") is error
			assert parse("#") is error
			assert parse("#ff00") is error == false
			assert parse("#ff000") is error
			assert parse("#ff00000") is error
			return none
		}

		@test()
		def parsesRGBWithNumbers() !none {
			try assertRGBA("rgb(255, 0, 0)", 255, 0, 0, 255)
			try assertRGBA("rgb(0,128,255)", 0, 128, 255, 255)
			// Whitespace separators are accepted too.
			try assertRGBA("rgb(1 2 3)", 1, 2, 3, 255)
			return none
		}

		@test()
		def parsesRGBWithPercentages() !none {
			try assertRGBA("rgb(100%, 0%, 0%)", 255, 0, 0, 255)
			try assertRGBA("rgb(0%, 100%, 50%)", 0, 255, 128, 255)
			return none
		}

		@test()
		def parsesAlphaInBothSpellings() !none {
			try assertRGBA("rgba(255, 0, 0, 0.5)", 255, 0, 0, 128)
			// rgb() accepts a fourth component, and `/` separates it CSS-style.
			try assertRGBA("rgb(255 0 0 / 50%)", 255, 0, 0, 128)
			try assertRGBA("rgba(0, 0, 0, 0)", 0, 0, 0, 0)
			try assertRGBA("rgba(0, 0, 0, 1)", 0, 0, 0, 255)
			return none
		}

		@test()
		def clampsOutOfRangeComponents() !none {
			try assertRGBA("rgb(300, -20, 0)", 255, 0, 0, 255)
			try assertRGBA("rgba(0, 0, 0, 5)", 0, 0, 0, 255)
			try assertRGBA("rgba(0, 0, 0, -1)", 0, 0, 0, 0)
			return none
		}

		@test()
		def parsesHSL() !none {
			try assertRGBA("hsl(0, 100%, 50%)", 255, 0, 0, 255)
			try assertRGBA("hsl(120, 100%, 50%)", 0, 255, 0, 255)
			try assertRGBA("hsl(240, 100%, 50%)", 0, 0, 255, 255)
			// Zero saturation is a gray of the given lightness.
			try assertRGBA("hsl(0, 0%, 100%)", 255, 255, 255, 255)
			try assertRGBA("hsl(0, 0%, 0%)", 0, 0, 0, 255)
			return none
		}

		@test()
		def parsesHSLA() !none {
			try assertRGBA("hsla(120, 100%, 50%, 1)", 0, 255, 0, 255)
			try assertRGBA("hsla(120, 100%, 50%, 0)", 0, 255, 0, 0)
			return none
		}

		@test()
		def wrapsHue() !none {
			let base = try rgbaOf("hsl(120, 100%, 50%)")
			for let (_, spelling) in string["hsl(480, 100%, 50%)", "hsl(-240, 100%, 50%)"] {
				let got = try rgbaOf(spelling)
				assert got.r == base.r
				assert got.g == base.g
				assert got.b == base.b
			}
			return none
		}

		@test()
		def parsesNamedColors() !none {
			try assertRGBA("red", 255, 0, 0, 255)
			try assertRGBA("coral", 255, 127, 80, 255)
			try assertRGBA("rebeccapurple", 102, 51, 153, 255)
			// Names are case-insensitive and surrounding space is ignored.
			try assertRGBA("  CoRaL  ", 255, 127, 80, 255)
			return none
		}

		@test()
		def rejectsUnknownInput() !none {
			assert parse("") is error
			assert parse("   ") is error
			assert parse("notacolor") is error
			assert parse("rgb(1, 2)") is error
			assert parse("rgb(1, 2, 3, 4, 5)") is error
			assert parse("rgb(a, b, c)") is error
			assert parse("cmyk(0, 0, 0, 0)") is error
			return none
		}
	}

	check "Color" {
		@test()
		def convertsFromEveryModel() !none {
			let fromRGB = new Color(RGB{r: 1, g: 2, b: 3})
			assert fromRGB.rgba.a == 255

			let fromRGBA = new Color(RGBA{r: 1, g: 2, b: 3, a: 4})
			assert fromRGBA.alpha == 4

			let fromGray = new Color(Gray{y: 128})
			assert fromGray.rgba.r == 128
			assert fromGray.rgba.b == 128

			let fromNamed = new Color(Named{name: "red"})
			assert fromNamed.rgba.r == 255
			return none
		}

		@test()
		def constructsFromAString() !none {
			let c = new Color("#00ff00")
			assert c.rgba.r == 0
			assert c.rgba.g == 255
			assert c.rgba.b == 0
			return none
		}

		@test()
		def formatsCompactHex() !none {
			// Hex digits are emitted uppercase; the spelling is compared
			// case-insensitively so only the shape is pinned down here.
			let red = new Color(RGBA{r: 255, g: 0, b: 0, a: 255})
			assert red.hex.code.lower() == "#f00"

			let pastel = new Color(RGBA{r: 0xaa, g: 0xbb, b: 0xcc, a: 255})
			assert pastel.hex.code.lower() == "#abc"
			return none
		}

		@test()
		def formatsFullHex() !none {
			let mixed = new Color(RGBA{r: 0x12, g: 0x34, b: 0x56, a: 255})
			assert mixed.hex.code.lower() == "#123456"

			// A partial alpha forces the long form.
			let translucent = new Color(RGBA{r: 255, g: 0, b: 0, a: 0x80})
			assert translucent.hex.code.lower() == "#ff000080"
			return none
		}

		@test()
		def roundTripsThroughHex() !none {
			for let (_, spelling) in string["#f00", "#123456", "#ff000080"] {
				let parsed = try parse(spelling)
				let again = try parse(parsed.hex.code)
				assert again.rgba.r == parsed.rgba.r
				assert again.rgba.g == parsed.rgba.g
				assert again.rgba.b == parsed.rgba.b
				assert again.rgba.a == parsed.rgba.a
			}
			return none
		}

		@test()
		def readsComponents() !none {
			let c = try parse("rgba(10, 20, 30, 0.5)")
			assert c.red == 10
			assert c.green == 20
			assert c.blue == 30
			assert c.alpha == 128
			return none
		}

		@test()
		def printsAsRGBA() !none {
			let c = new Color(RGBA{r: 1, g: 2, b: 3, a: 4})
			assert c.str() == "rgba(1, 2, 3, 4)"
			return none
		}

		@test()
		def packsAndUnpacksBytes() !none {
			let c = new Color(RGBA{r: 1, g: 2, b: 3, a: 4})
			let raw = c.bytes()
			assert raw.len() == 4
			assert raw[0] == 1
			assert raw[3] == 4
			return none
		}
	}

	check "Color operations" {
		internal def hexOf(c Color) string {
			return c.css(ColorFormat.Hex)
		}

		@test()
		def transformsReturnNewColorsAndChain() !none {
			let red = try parse("#ff0000")
			let chained = red.darken(20.0).desaturate(30.0)

			// The receiver is untouched: these return new colors.
			assert hexOf(red) == "#f00"
			assert hexOf(chained) != "#f00"
			return none
		}

		@test()
		def darkenAndLightenUsePercentagePoints() !none {
			let gray = try parse("hsl(0, 0%, 50%)")
			// 50% lightness minus 10 points is 40%, which is 102/255. The stored
			// channels are bytes, so allow a unit of rounding either way.
			assert math.approx(float(gray.darken(10.0).lightness), 102.0, 1.5)
			assert math.approx(float(gray.lighten(10.0).lightness), 153.0, 1.5)
			// Repeated steps walk to the ends without wrapping.
			assert gray.darken(90.0).lightness == 0
			assert gray.lighten(90.0).lightness == 255
			return none
		}

		@test()
		def invertsAndRotates() !none {
			let red = try parse("#ff0000")
			assert hexOf(red.invert()) == "#0ff"
			assert hexOf(red.rotate(120.0)) == "#0f0"
			assert hexOf(red.rotate(-120.0)) == "#00f"
			// A full turn is a no-op.
			assert hexOf(red.rotate(360.0)) == "#f00"
			return none
		}

		@test()
		def adjustsAlpha() !none {
			let red = try parse("#ff0000")
			assert red.withAlpha(128).alpha == 128
			assert red.withOpacity(0.5).alpha == 128
			assert red.withOpacity(0.0).alpha == 0
			assert red.fade(50.0).alpha == 128
			// The original keeps its alpha.
			assert red.alpha == 255
			return none
		}

		@test()
		def reportsPerceptualLuminance() !none {
			let yellow = try parse("yellow")
			let blue = try parse("blue")

			// HSL lightness cannot tell these apart; luminance can.
			assert yellow.lightness == blue.lightness
			assert yellow.relativeLuminance() > blue.relativeLuminance()

			// WCAG reference values.
			assert math.approx(yellow.relativeLuminance(), 0.9278, 0.001)
			assert math.approx(blue.relativeLuminance(), 0.0722, 0.001)
			return none
		}

		@test()
		def computesContrastRatios() !none {
			let white = try parse("white")
			let black = try parse("black")

			// The extremes of the scale.
			assert math.approx(black.contrastRatio(white), 21.0, 0.01)
			assert math.approx(white.contrastRatio(white), 1.0, 0.01)
			// The ratio does not depend on the order.
			let yellow = try parse("yellow")
			assert math.approx(yellow.contrastRatio(black), black.contrastRatio(yellow), 0.0001)
			return none
		}

		@test()
		def judgesReadability() !none {
			let yellow = try parse("yellow")
			let black = try parse("black")
			let white = try parse("white")

			assert black.isReadableOn(yellow)
			assert white.isReadableOn(yellow) == false
			// A lower bar passes what AA does not.
			assert white.isReadableOn(try parse("#767676"), 3.0)
			return none
		}

		@test()
		def picksReadableTextColor() !none {
			let yellow = try parse("yellow")
			let navy = try parse("navy")

			assert yellow.bestTextColor().equals(try parse("black"))
			assert navy.bestTextColor().equals(try parse("white"))
			return none
		}

		@test()
		def classifiesDarkAndLight() !none {
			assert (try parse("black")).isDark()
			assert (try parse("navy")).isDark()
			assert (try parse("white")).isLight()
			assert (try parse("yellow")).isLight()
			return none
		}

		@test()
		def comparesByValue() !none {
			let a = try parse("#ff0000")
			let b = try parse("rgb(255, 0, 0)")
			assert a.equals(b)
			assert a.equals(try parse("#ff000080")) == false

			// The operator compares channels, not identity: these are two objects.
			assert a == b
			assert (a != b) == false
			assert a != (try parse("#00ff00"))
			return none
		}

		@test()
		def buildsGradients() !none {
			let red = try parse("#ff0000")
			let blue = try parse("#0000ff")
			let ramp = red.steps(blue, 5)

			assert ramp.len() == 5
			// Both endpoints are included.
			assert ramp[0].equals(red)
			assert ramp[4].equals(blue)
			// The midpoint is halfway.
			assert ramp[2].equals(red.lerp(blue, 0.5))

			assert red.steps(blue, 1).len() == 1
			assert red.steps(blue, 0).len() == 0
			return none
		}

		@test()
		def mixesInBothSpaces() !none {
			let red = try parse("#ff0000")
			let lime = try parse("#00ff00")

			// An even sRGB mix is the arithmetic midpoint.
			assert red.mix(lime).equals(try parse("rgb(128, 128, 0)"))
			// Linear light keeps the result brighter.
			assert red.mixLinear(lime).red > red.mix(lime).red
			// Weight selects an endpoint.
			assert red.mix(lime, 0.0).equals(red)
			assert red.mix(lime, 1.0).equals(lime)
			return none
		}

		@test()
		def averagesColors() !none {
			let black = try parse("black")
			let white = try parse("white")
			let avg = try average(Color[black, white])

			// Averaging in linear light lands above the sRGB midpoint.
			assert avg.red > 128
			assert (try average(Color[black])).equals(black)
			assert average(Color[]) is error
			return none
		}

		@test()
		def producesRandomColors() !none {
			// Opaque, and spread across the cube rather than repeating one value.
			let seen = map<string, bool>{}
			for let i = 0; i < 24; i++ {
				let c = random()
				assert c.alpha == 255
				seen[c.css(ColorFormat.Hex)] = true
			}
			assert seen.len() > 1
			return none
		}

		@test()
		def convertsColorTemperature() !none {
			let candle = fromKelvin(1900.0)
			let daylight = fromKelvin(6500.0)

			// Warm light is red-heavy, cool light is balanced.
			assert candle.red > candle.blue
			assert daylight.blue > candle.blue
			// Out-of-range input is clamped rather than rejected.
			assert fromKelvin(0.0).equals(fromKelvin(1000.0))
			assert fromKelvin(99000.0).equals(fromKelvin(40000.0))

			return none
		}

		@test()
		def roundTripsCMYK() !none {
			let red = try parse("#ff0000")
			let ink = red.cmyk
			assert ink.c == 0.0
			assert ink.m == 1.0
			assert ink.y == 1.0
			assert ink.k == 0.0

			let back = new Color(ink)
			assert back.equals(red)

			// Pure black is all key.
			assert (try parse("black")).cmyk.k == 1.0
			return none
		}

		@test()
		def writesCSS() !none {
			let red = try parse("#ff0000")
			assert red.css() == "rgb(255, 0, 0)"
			assert red.withOpacity(0.5).css() == "rgba(255, 0, 0, 0.50)"
			assert red.css(ColorFormat.Hex) == "#f00"
			assert red.css(ColorFormat.HSL) == "hsl(0, 100%, 50%)"
			assert red.withOpacity(0.5).css(ColorFormat.HSL) == "hsla(0, 100%, 50%, 0.50)"
			return none
		}

		@test()
		def convertsToGrayscale() !none {
			let gray = (try parse("#ff0000")).grayscale()
			assert gray.red == gray.green
			assert gray.green == gray.blue
			// Perceptual weighting: red contributes about 30%.
			assert gray.red == 76
			return none
		}
	}

	check "Palette" {
		@test()
		def growsAndReports() !none {
			let pal = new Palette(0)
			assert pal.isEmpty()

			pal.add(try parse("red"))
			pal.add(try parse("blue"))
			assert pal.len() == 2
			assert pal.isEmpty() == false
			assert pal.contains(try parse("#ff0000"))
			assert pal.contains(try parse("green")) == false
			return none
		}

		@test()
		def findsTheNearestEntry() !none {
			let pal = new Palette(0)
			pal.add(try parse("red"))
			pal.add(try parse("blue"))
			pal.add(try parse("white"))

			let near = try pal.nearest(try parse("#ee0000"))
			assert near.equals(try parse("red"))

			let pale = try pal.nearest(try parse("#fafafa"))
			assert pale.equals(try parse("white"))
			return none
		}

		@test()
		def reportsAnEmptyPalette() !none {
			let pal = new Palette(0)
			assert pal.nearestIndex(try parse("red")) == -1
			assert pal.nearest(try parse("red")) is error
			return none
		}

		@test()
		def preservesSizedConstruction() !none {
			// The image decoders build a palette of a known size and fill it.
			let pal = new Palette(3)
			assert pal.len() == 3
			pal.colors[0] = try parse("red")
			assert pal.colors[0].equals(try parse("#f00"))
			return none
		}
	}
}
