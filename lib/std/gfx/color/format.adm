partial module std.gfx.color {
	// ColorFormat represents the different color model formats.
	enum ColorFormat {
		Hex,
		RGB,
		RGBA,
		Gray,
		Gray16,
		YCbCr,
		CMYK,
		HSL,
		HSLA,
		Named,
		Palette,
	}

	type Palette {
		colors Color[]

		def new(size int) {
			colors.len(size)
		}

		// Returns how many colors the palette holds.
		def len() int {
			return colors.len()
		}

		// Reports whether the palette holds no colors.
		def isEmpty() bool {
			return colors.len() == 0
		}

		// Appends a color to the palette.
		def add(color Color) {
			colors += [color]
		}

		// Returns the index of the palette entry closest to the target, or -1
		// when the palette is empty.
		//
		// Distance is measured in linear light, so the match is the one that
		// looks closest rather than the one that is closest in stored bytes.
		def nearestIndex(target Color) int {
			return -1 when colors.len() == 0

			let want = target.rgba
			let wr = srgbToLinear(want.r)
			let wg = srgbToLinear(want.g)
			let wb = srgbToLinear(want.b)

			let best = 0
			let bestDistance = 0.0
			for let (i, entry) in colors {
				let have = entry.rgba
				let dr = srgbToLinear(have.r) - wr
				let dg = srgbToLinear(have.g) - wg
				let db = srgbToLinear(have.b) - wb
				let distance = dr * dr + dg * dg + db * db

				if i == 0 || distance < bestDistance {
					best = i
					bestDistance = distance
				}
			}
			return best
		}

		// Returns the palette entry closest to the target color.
		//
		// Fails when the palette is empty.
		def nearest(target Color) !Color {
			let index = nearestIndex(target)
			fail "palette is empty" when index < 0
			return colors[index]
		}

		// Reports whether the palette already holds a color with these channels.
		def contains(target Color) bool {
			for let (_, entry) in colors {
				return true when entry.equals(target)
			}
			return false
		}
	}

	// Named represents a named color.
	struct Named {
		// The color name, e.g., "coral".
		name string
	}

	// Hex represents a color in hexadecimal format.
	struct Hex {
		// The hexadecimal color code, e.g., "#RRGGBB".
		code string
	}

	// RGB represents a color using red, green, and blue components.
	struct RGB {
		// Red, Green, and Blue components (0-255).
		r, g, b uint8
	}

	// RGBA represents a color with an alpha (transparency) component.
	struct RGBA {
		// Red, Green, Blue, and Alpha components (0-255).
		r, g, b, a uint8
	}

	// Gray represents a grayscale color.
	struct Gray {
		// The intensity (luma) component (0-255).
		y uint8
	}

	// Gray16 represents a 16-bit grayscale color.
	struct Gray16 {
		// The 16-bit intensity (luma) component (0-65535).
		y uint16
	}

	// CMYK represents a color using the subtractive print primaries.
	struct CMYK {
		// Cyan, Magenta, Yellow, and Key (black) components (0.0-1.0).
		c, m, y, k float
	}

	// YCbCr represents a color in the Y'CbCr color space.
	struct YCbCr {
		// Y' (luma), Cb (blue-difference), and Cr (red-difference) components.
		y, cb, cr uint8
	}

	// HSL represents a color using hue, saturation, and lightness.
	struct HSL {
		// Hue (0-360), Saturation (0-255), and Lightness (0-255).
		h    uint16
		s, l uint8
	}

	// HSLA represents a color with an alpha component in HSL format.
	struct HSLA {
		// Hue (0-360), Saturation (0-255), Lightness (0-255), and Alpha (0.0-1.0).
		h    uint16
		s, l uint8
		a    float32
	}
}
