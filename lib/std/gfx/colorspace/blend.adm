partial module std.gfx.colorspace {
	use (
		std.math
		std.gfx.color::(BlendMode)
	)

	// The separable mode's result for one channel, source cs over cd (0..1).
	def blendSeparable(mode BlendMode, cs float, cd float) float {
		// Inputs/outputs are in [0..1].
		switch mode {
			case BlendMode.Normal:
				return cs
			case BlendMode.Darken:
				return cs when cs < cd
				return cd
			case BlendMode.Lighten:
				return cs when cs > cd
				return cd
			case BlendMode.Multiply:
				return cs * cd
			case BlendMode.Screen:
				return 1.0 - (1.0 - cs) * (1.0 - cd)
			case BlendMode.Overlay:
				return 2.0 * cs * cd when cd <= 0.5
				return 1.0 - 2.0 * (1.0 - cs) * (1.0 - cd)
			case BlendMode.HardLight:
				return 2.0 * cs * cd when cs <= 0.5
				return 1.0 - 2.0 * (1.0 - cs) * (1.0 - cd)
			case BlendMode.SoftLight:
				if cs <= 0.5 {
					return cd - (1.0 - 2.0 * cs) * cd * (1.0 - cd)
				}
				let g = 0.0
				if cd <= 0.25 {
					g = ((16.0 * cd - 12.0) * cd + 4.0) * cd
				} else {
					g = math.sqrt(cd)
				}
				return cd + (2.0 * cs - 1.0) * (g - cd)
			case BlendMode.ColorDodge:
				return 1.0 when cs >= 1.0
				return 1.0 when cd >= 1.0
				let v = cd / (1.0 - cs)
				return 1.0 when v > 1.0
				return v
			case BlendMode.ColorBurn:
				return 0.0 when cs <= 0.0
				return 0.0 when cd <= 0.0
				let v = 1.0 - (1.0 - cd) / cs
				return 0.0 when v < 0.0
				return v
			case BlendMode.LinearDodge:
				let v = cs + cd
				return 1.0 when v > 1.0
				return v
			case BlendMode.LinearBurn:
				let v = cs + cd - 1.0
				return 0.0 when v < 0.0
				return v
			case BlendMode.VividLight:
				return blendSeparable(BlendMode.ColorBurn, 2.0 * cs, cd) when cs < 0.5
				return blendSeparable(BlendMode.ColorDodge, 2.0 * cs - 1.0, cd)
			case BlendMode.LinearLight:
				let v = cd + 2.0 * cs - 1.0
				return 0.0 when v < 0.0
				return 1.0 when v > 1.0
				return v
			case BlendMode.PinLight:
				return blendSeparable(BlendMode.Darken, 2.0 * cs, cd) when cs < 0.5
				return blendSeparable(BlendMode.Lighten, 2.0 * cs - 1.0, cd)
			case BlendMode.HardMix:
				let v = blendSeparable(BlendMode.VividLight, cs, cd)
				return 0.0 when v < 0.5
				return 1.0
			case BlendMode.Difference:
				let v = cd - cs
				v = -v when v < 0.0
				return v
			case BlendMode.Exclusion:
				return cd + cs - 2.0 * cd * cs
			case BlendMode.Subtract:
				let v = cd - cs
				return 0.0 when v < 0.0
				return v
			case BlendMode.Divide:
				return 1.0 when cs <= 0.0
				let v = cd / cs
				return 1.0 when v > 1.0
				return v
			case BlendMode.Average:
				return (cs + cd) / 2.0
			case BlendMode.Negation:
				return 1.0 - (1.0 - cd - cs).abs()
			default:
				return cs
		}
	}

	// The mode's colour B(Cs, Cd) for the modes that work on the whole colour
	// or per channel.
	def blendRGB(mode BlendMode, sr uint8, sg uint8, sb uint8, dr uint8, dg uint8, db uint8) (uint8, uint8, uint8) {
		let ss = int(sr) + int(sg) + int(sb)
		let ds = int(dr) + int(dg) + int(db)

		switch mode {
			case BlendMode.DarkerColor:
				return (sr, sg, sb) when ss < ds
				return (dr, dg, db)
			case BlendMode.LighterColor:
				return (sr, sg, sb) when ss > ds
				return (dr, dg, db)
			case BlendMode.Xor:
				return (sr ^ dr, sg ^ dg, sb ^ db)
			default:
				// Separable modes are done per channel in [0..1].
				let sr1 = float(sr) / 255.0
				let sg1 = float(sg) / 255.0
				let sb1 = float(sb) / 255.0
				let dr1 = float(dr) / 255.0
				let dg1 = float(dg) / 255.0
				let db1 = float(db) / 255.0

				let r = blendSeparable(mode, sr1, dr1)
				let g = blendSeparable(mode, sg1, dg1)
				let b = blendSeparable(mode, sb1, db1)
				return (clampU8(r * 255.0), clampU8(g * 255.0), clampU8(b * 255.0))
		}
	}

	// The colour of the hue, saturation, colour and luminosity modes, mixed in
	// HSL.
	def blendNonSeparable(mode BlendMode, sr uint8, sg uint8, sb uint8, dr uint8, dg uint8, db uint8) (uint8, uint8, uint8) {
		let (hs, ss, ls) = rgbToHslParts(sr, sg, sb)
		let (hd, sd, ld) = rgbToHslParts(dr, dg, db)

		switch mode {
			case BlendMode.Hue:
				return hslToRGBParts(hs, sd, ld)
			case BlendMode.Saturation:
				return hslToRGBParts(hd, ss, ld)
			case BlendMode.Color:
				return hslToRGBParts(hs, ss, ld)
			case BlendMode.Luminosity:
				return hslToRGBParts(hd, sd, ls)
			default:
				return (sr, sg, sb)
		}
	}

	// blendBytes composites the colour sr, sg, sb, sa8 over dr, dg, db, da8
	// with the mode: source-over alpha compositing with the PDF/W3C blend
	// modes, which change the colour channels only.
	def blendBytes(mode BlendMode, sr uint8, sg uint8, sb uint8, sa8 uint8, dr uint8, dg uint8, db uint8, da8 uint8) (uint8, uint8, uint8, uint8) {
		let sa = float(sa8) / 255.0
		let da = float(da8) / 255.0

		// Fast paths.
		return (dr, dg, db, da8) when sa <= 0.0
		return (sr, sg, sb, sa8) when da <= 0.0 && mode != BlendMode.Dissolve

		if mode == BlendMode.Dissolve {
			// Dissolve is stochastic; without a random source, use a deterministic
			// threshold based on alpha.
			return (dr, dg, db, da8) when sa < 0.5
			return (sr, sg, sb, sa8)
		}

		let (br, bg, bb) = blendRGB(mode, sr, sg, sb, dr, dg, db)
		if mode := BlendMode.Hue || BlendMode.Saturation || BlendMode.Color || BlendMode.Luminosity {
			(br, bg, bb) = blendNonSeparable(mode, sr, sg, sb, dr, dg, db)
		}

		let ao = sa + da - sa * da
		return (0, 0, 0, 0) when ao <= 0.0

		// Premultiply.
		let srp = float(sr) / 255.0 * sa
		let sgp = float(sg) / 255.0 * sa
		let sbp = float(sb) / 255.0 * sa
		let drp = float(dr) / 255.0 * da
		let dgp = float(dg) / 255.0 * da
		let dbp = float(db) / 255.0 * da

		let brp = float(br) / 255.0
		let bgp = float(bg) / 255.0
		let bbp = float(bb) / 255.0

		// Co_p = Cs_p*(1-Da) + Cd_p*(1-Sa) + B(Cs,Cd)*Sa*Da
		let outRp = srp * (1.0 - da) + drp * (1.0 - sa) + brp * (sa * da)
		let outGp = sgp * (1.0 - da) + dgp * (1.0 - sa) + bgp * (sa * da)
		let outBp = sbp * (1.0 - da) + dbp * (1.0 - sa) + bbp * (sa * da)

		let outR = clampU8(clamp01(outRp / ao) * 255.0)
		let outG = clampU8(clamp01(outGp / ao) * 255.0)
		let outB = clampU8(clamp01(outBp / ao) * 255.0)
		let outA = clampU8(ao * 255.0)

		return (outR, outG, outB, outA)
	}
}
