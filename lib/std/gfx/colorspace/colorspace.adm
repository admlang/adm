// Colour-space arithmetic on plain numbers, shared by std.gfx.color (which
// wraps it in Color) and the pixel code under std.gfx that works on raw
// bytes, where a Color per pixel would cost two allocations.
internal partial module std.gfx.colorspace {
	// x limited to 0..1.
	def clamp01(x float) float {
		return 0.0 when x < 0.0
		return 1.0 when x > 1.0
		return x
	}

	// x limited to 0..255 and rounded, halves up.
	def clampU8(x float) uint8 {
		let v = x
		v = 0.0 when v < 0.0
		v = 255.0 when v > 255.0
		return uint8(v + 0.5)
	}

	// x limited to 0..255.
	def clampU8i(x int) uint8 {
		return 0 when x <= 0
		return 255 when x >= 255
		return uint8(x)
	}

	// The hue (degrees, 0..360), saturation and lightness (0..1) of an sRGB
	// colour.
	def rgbToHslParts(r uint8, g uint8, b uint8) (float, float, float) {
		let rf = float(r) / 255.0
		let gf = float(g) / 255.0
		let bf = float(b) / 255.0

		let maxv = rf
		maxv = gf when gf > maxv
		maxv = bf when bf > maxv

		let minv = rf
		minv = gf when gf < minv
		minv = bf when bf < minv

		let l = (maxv + minv) / 2.0
		let d = maxv - minv

		if d == 0.0 {
			return (0.0, 0.0, l)
		}

		let s = d / (1.0 - (2.0 * l - 1.0).abs())

		let h = 0.0
		if maxv == rf {
			h = (gf - bf) / d
			h += 6.0 when h < 0.0
		} else if maxv == gf {
			h = (bf - rf) / d + 2.0
		} else {
			h = (rf - gf) / d + 4.0
		}
		h *= 60.0
		return (h, s, l)
	}

	// One RGB channel of the HSL conversion, from the p/q pair and the
	// channel's hue offset `t` (in turns).
	def hueToRGB(p float, q float, t float) float {
		let tt = t
		tt += 1.0 when tt < 0.0
		tt -= 1.0 when tt > 1.0

		return p + (q - p) * 6.0 * tt when tt < (1.0 / 6.0)
		return q when tt < 0.5
		return p + (q - p) * (2.0 / 3.0 - tt) * 6.0 when tt < (2.0 / 3.0)
		return p
	}

	// The sRGB bytes of hue `hDeg` (degrees), saturation `s` and lightness
	// `l` (0..1).
	def hslToRGBParts(hDeg float, s float, l float) (uint8, uint8, uint8) {
		let h = hDeg / 360.0
		let ss = clamp01(s)
		let ll = clamp01(l)

		if ss == 0.0 {
			let v = clampU8(ll * 255.0)
			return (v, v, v)
		}

		let q = ll < 0.5 ?? (ll * (1.0 + ss), ll + ss - ll * ss)
		let p = 2.0 * ll - q

		let r = hueToRGB(p, q, h + 1.0 / 3.0)
		let g = hueToRGB(p, q, h)
		let b = hueToRGB(p, q, h - 1.0 / 3.0)
		return (clampU8(r * 255.0), clampU8(g * 255.0), clampU8(b * 255.0))
	}

	// Converts one sRGB channel to linear light, undoing the display gamma.
	//
	// Light adds up linearly; sRGB values do not. Anything that reasons about
	// brightness — luminance, contrast, physically correct mixing — has to work
	// on these values rather than the stored bytes.
	def srgbToLinear(chan uint8) float {
		let c = float(chan) / 255.0
		return c / 12.92 when c <= 0.04045
		return ((c + 0.055) / 1.055) ** 2.4
	}

	// Converts a linear-light value back to an sRGB channel.
	def linearToSrgb(value float) uint8 {
		let v = clamp01(value)
		return clampU8(v * 12.92 * 255.0) when v <= 0.0031308
		return clampU8((1.055 * (v ** (1.0 / 2.4)) - 0.055) * 255.0)
	}

	// ITU-R BT.601 luma of an sRGB colour, rounded.
	def lumaU8(r uint8, g uint8, b uint8) uint8 {
		let rr = int(r)
		let gg = int(g)
		let bb = int(b)
		return clampU8i((rr * 299 + gg * 587 + bb * 114 + 500) / 1000)
	}

	// The sRGB bytes of r, g, b with the hue turned by `degrees`, exactly as
	// std.gfx.color turns a Color's hue: through its HSL form, whose hue is
	// rounded to a whole degree and saturation and lightness to bytes.
	def rotateHue(r uint8, g uint8, b uint8, degrees int) (uint8, uint8, uint8) {
		let (h, s, l) = rgbToHslParts(r, g, b)
		let hue = (int(uint16(h + 0.5)) + degrees) % 360
		hue += 360 when hue < 0
		return hslToRGBParts(float(hue), float(clampU8(s * 255.0)) / 255.0, float(clampU8(l * 255.0)) / 255.0)
	}
}
