partial module std.gfx {
	use (
		std.math.geom
	)

	// Defines a per-pixel mask controlling how strongly an effect is applied.
	interface Mask {
		// Coverage at a pixel location, 0.0 (untouched) to 1.0 (full effect).
		def coverage(x, y int) float
	}

	// A pixel surface that exposes its storage. The contract of `raw()` is
	// fixed, because pixel loops in user code depend on it:
	//
	//   - Format is RGBA8: four bytes per pixel in the order R, G, B, A, each
	//     0..255, with straight (non-premultiplied) alpha. Nothing else.
	//   - Row `y` starts at byte `y * stride()`; pixel `(x, y)` starts at
	//     `y * stride() + x * 4`. `stride() >= size().width * 4`; bytes past
	//     `width * 4` in a row are padding whose contents mean nothing.
	//   - `raw().len() >= (height - 1) * stride() + width * 4`. Rows are
	//     top to bottom, pixels left to right. No other data is in there.
	//   - `raw()` returns the live backing array, not a copy: writes through
	//     it change the surface at once, and the same array comes back on
	//     every call until `reshape` (or an operation that documents it
	//     calls `reshape`) swaps the store. Hold the result across such a
	//     call and you hold the old buffer.
	//   - Implementations never reallocate or move the store on reads or
	//     per-pixel writes; only geometry changes do, through `reshape`.
	interface Raster {
		def size() geom.Size<uint>
		def stride() int
		def raw() byte[]

		// Replace the backing store after a geometry-changing operation
		// (rotate, resize, crop). Implementers adopt the new buffer and
		// update any derived state.
		def reshape(data byte[], size geom.Size<uint>, stride int)
	}
}
