partial module std.gfx {
	use (
		std.math.geom
		std.simd
	)

	// The mask's coverage along the row from (x, y) into `out`: a RowMask
	// answers at once, any other mask pixel by pixel.
	def coverageRow(m Mask, x, y int, out float32[]) {
		if m is RowMask {
			m.coverage(x, y, out)
			return
		}
		for let i = 0; i < out.len(); i++ {
			out[i] = float32(m.coverage(x + i, y).clamp(0.0, 1.0))
		}
	}

	// Where the mask may cover anything; none when unknown or everywhere.
	def coverageBounds(m Mask) ?geom.Rect {
		return m.bounds() when m is RowMask
		return none
	}

	// A raster's coverage as a mask along the row from (x, y) into `out`:
	// each pixel's luminance scaled by its alpha (opaque white is full
	// effect, black or transparent none), 0 outside the raster. Eight
	// pixels a vector. Image and Canvas answer RowMask with it.
	def luminanceCoverage(r Raster, x, y int, out float32[]) {
		let n = out.len()
		let size = r.size()
		let w = int(size.width)
		let h = int(size.height)
		for let i = 0; i < n; i++ {
			out[i] = float32(0.0)
		}
		return when y < 0 || y >= h
		let from = x.max(0)
		let to = (x + n).min(w)
		return when from >= to
		let px = r.raw()
		let row = y * r.stride()
		let starts = simd.load8<int>(pixelStarts, 0)
		let one = simd.splat8<int>(1)
		let wr = simd.splat8<float32>(float32(0.299 / 255.0))
		let wg = simd.splat8<float32>(float32(0.587 / 255.0))
		let wb = simd.splat8<float32>(float32(0.114 / 255.0))
		let wa = simd.splat8<float32>(float32(1.0 / 255.0))
		let zero = simd.splat8<float32>(float32(0.0))
		let full = simd.splat8<float32>(float32(1.0))
		let p = from
		for p + 8 <= to {
			let base = row + p * 4
			let red = simd.convert<byte, float32>(simd.gather8<byte>(px, base, starts))
			let green = simd.convert<byte, float32>(simd.gather8<byte>(px, base, starts + one))
			let blue = simd.convert<byte, float32>(simd.gather8<byte>(px, base, starts + one + one))
			let alpha = simd.convert<byte, float32>(simd.gather8<byte>(px, base, starts + one + one + one))
			let lum = red * wr + green * wg + blue * wb
			simd.store8<float32>(out, p - x, (lum * alpha * wa).clamp(zero, full))
			p += 8
		}
		for p < to {
			let o = row + p * 4
			let lum = 0.299 * float(px[o]) + 0.587 * float(px[o + 1]) + 0.114 * float(px[o + 2])
			out[p - x] = float32(((lum / 255.0) * (float(px[o + 3]) / 255.0)).clamp(0.0, 1.0))
			p++
		}
	}

	// Byte offsets of eight RGBA pixels.
	internal const pixelStarts = int[0, 4, 8, 12, 16, 20, 24, 28]

	// Pixel centres 0.5 to 7.5 across a vector.
	internal const laneCentres = float32[0.5, 1.5, 2.5, 3.5, 4.5, 5.5, 6.5, 7.5]

	// How far past the shape a hard, anti-aliased edge still covers.
	internal def edgePad(feather float, antialias bool) float {
		return feather <= 0.0 && antialias ?? (0.5, 0.0)
	}

	// Coverage across an edge from a signed inward distance `d` (pixels;
	// positive inside). `feather` fades coverage in from the edge over that
	// many pixels; with `antialias` a hard edge still gets a one-pixel ramp
	// centred on it, so shapes do not look jagged.
	internal def edgeCoverage(d float, feather float, antialias bool) float {
		if feather > 0.0 {
			return (d / feather).clamp(0.0, 1.0)
		}
		if antialias {
			return (d + 0.5).clamp(0.0, 1.0)
		}
		return 1.0 when d > 0.0
		return 0.0
	}

	internal def finishCoverage(c float, inverted bool) float {
		return 1.0 - c when inverted
		return c
	}

	// A rectangular mask: full effect inside `rect`, none outside.
	type RectangleMask {
		rect      geom.Rectangle
		// Pixels inside the edge over which the effect fades in.
		feather   float          = 0.0
		// One-pixel soft edge on a hard mask.
		antialias bool           = true
		// Cover everything except the shape.
		inverted  bool           = false

		def new(rect geom.Rectangle, feather float = 0.0) {
			self.rect = rect
			self.feather = feather
		}

		// coverage returns how much of the pixel at x, y the rectangle covers, 0 to
		// 1, feathered at the edge and flipped when the mask is inverted.
		def coverage(x, y int) float {
			let px = float(x) + 0.5
			let py = float(y) + 0.5
			let d = (px - rect.left()).min(rect.right() - px).min(py - rect.top()).min(rect.bottom() - py)
			return finishCoverage(edgeCoverage(d, feather, antialias), inverted)
		}

		// RowMask: eight pixels a vector.
		def coverage(x, y int, out float32[]) {
			let n = out.len()
			let py = float(y) + 0.5
			let zero = simd.splat8<float32>(float32(0.0))
			let one = simd.splat8<float32>(float32(1.0))
			let across = simd.splat8<float32>(float32((py - rect.top()).min(rect.bottom() - py)))
			let l = simd.splat8<float32>(float32(rect.left()))
			let r = simd.splat8<float32>(float32(rect.right()))
			let soft = simd.splat8<float32>(float32(feather.max(1e-9)))
			let half = simd.splat8<float32>(float32(0.5))
			let centres = simd.load8<float32>(laneCentres, 0)
			let i = 0
			for i + 8 <= n {
				let px = centres + simd.splat8<float32>(float32(x + i))
				let d = (px - l).min(r - px).min(across)
				let c = simd.blend(simd.gt(d, zero), one, zero)
				if feather > 0.0 {
					c = (d / soft).clamp(zero, one)
				} else if antialias {
					c = (d + half).clamp(zero, one)
				}
				if inverted {
					c = one - c
				}
				simd.store8<float32>(out, i, c)
				i += 8
			}
			for i < n {
				out[i] = float32(coverage(x + i, y))
				i++
			}
		}

		// RowMask: the rectangle, plus the anti-aliased edge.
		def bounds() ?geom.Rect {
			return none when inverted
			let pad = edgePad(feather, antialias)
			return geom.Rect{left: rect.left() - pad, top: rect.top() - pad, right: rect.right() + pad, bottom: rect.bottom() + pad}
		}
	}

	// A circular mask: full effect inside the circle, none outside.
	type CircleMask {
		circle    geom.Circle
		feather   float       = 0.0
		antialias bool        = true
		inverted  bool        = false

		def new(circle geom.Circle, feather float = 0.0) {
			self.circle = circle
			self.feather = feather
		}

		// coverage returns how much of the pixel at x, y the circle covers, 0 to 1,
		// feathered at the edge and flipped when the mask is inverted.
		def coverage(x, y int) float {
			let p = new geom.Point(float(x) + 0.5, float(y) + 0.5)
			let d = circle.radius - circle.center.distanceTo(p)
			return finishCoverage(edgeCoverage(d, feather, antialias), inverted)
		}

		// RowMask: eight pixels a vector.
		def coverage(x, y int, out float32[]) {
			let n = out.len()
			let dy = float(y) + 0.5 - circle.center.y
			let zero = simd.splat8<float32>(float32(0.0))
			let one = simd.splat8<float32>(float32(1.0))
			let dy2 = simd.splat8<float32>(float32(dy * dy))
			let cx = simd.splat8<float32>(float32(circle.center.x))
			let radius = simd.splat8<float32>(float32(circle.radius))
			let soft = simd.splat8<float32>(float32(feather.max(1e-9)))
			let half = simd.splat8<float32>(float32(0.5))
			let centres = simd.load8<float32>(laneCentres, 0)
			let i = 0
			for i + 8 <= n {
				let dx = centres + simd.splat8<float32>(float32(x + i)) - cx
				let d = radius - (dx * dx + dy2).sqrt()
				let c = simd.blend(simd.gt(d, zero), one, zero)
				if feather > 0.0 {
					c = (d / soft).clamp(zero, one)
				} else if antialias {
					c = (d + half).clamp(zero, one)
				}
				if inverted {
					c = one - c
				}
				simd.store8<float32>(out, i, c)
				i += 8
			}
			for i < n {
				out[i] = float32(coverage(x + i, y))
				i++
			}
		}

		// RowMask: the circle's box, plus the anti-aliased edge.
		def bounds() ?geom.Rect {
			return none when inverted
			let r = circle.radius + edgePad(feather, antialias)
			return geom.Rect{left: circle.center.x - r, top: circle.center.y - r, right: circle.center.x + r, bottom: circle.center.y + r}
		}
	}

	// A polygon mask: full effect inside the path, none outside.
	type PathMask {
		path           geom.Polygon
		feather        float        = 0.0
		antialias      bool         = true
		inverted       bool         = false
		internal edges geom.Line[]

		def new(path geom.Polygon, feather float = 0.0) {
			self.path = path
			self.feather = feather
			edges = path.edges()
		}

		// coverage returns how much of the pixel at x, y the polygon covers, 0 to 1,
		// feathered at the edges and flipped when the mask is inverted.
		def coverage(x, y int) float {
			let p = new geom.Point(float(x) + 0.5, float(y) + 0.5)
			let dist = -1.0
			for let (_, edge) in edges {
				let d = edge.distanceTo(p)
				dist = d when dist < 0.0 || d < dist
			}
			dist = 0.0 when dist < 0.0
			dist = -dist when !path.contains(p)
			return finishCoverage(edgeCoverage(dist, feather, antialias), inverted)
		}

		// RowMask: inside or out from the edges crossing the row (non-zero,
		// as `contains`), distances to every edge eight pixels a vector.
		def coverage(x, y int, out float32[]) {
			let n = out.len()
			let py = float(y) + 0.5
			// Where the edges cross the row, and which way they wind.
			let xs float[]
			let dirs int[]
			for let (_, e) in edges {
				let (a, b) = (e.start, e.end)
				continue when (a.y <= py) == (b.y <= py)
				let at = a.x + (py - a.y) * (b.x - a.x) / (b.y - a.y)
				let k = xs.len()
				xs.push(at)
				dirs.push(b.y > a.y ?? (1, -1))
				for k > 0 && xs[k - 1] > at {
					xs[k] = xs[k - 1]
					dirs[k] = dirs[k - 1]
					k--
				}
				xs[k] = at
				dirs[k] = b.y > a.y ?? (1, -1)
			}
			// +1 inside, -1 outside, per pixel: the winding of the crossings
			// right of its centre.
			let sign float32[]
			sign.len(n)
			let total = 0
			for let (_, d) in dirs {
				total += d
			}
			let next = 0
			let right = total
			for let i = 0; i < n; i++ {
				let px = float(x + i) + 0.5
				for next < xs.len() && xs[next] < px {
					right -= dirs[next]
					next++
				}
				sign[i] = right != 0 ?? (float32(1.0), float32(-1.0))
			}
			let zero = simd.splat8<float32>(float32(0.0))
			let one = simd.splat8<float32>(float32(1.0))
			let soft = simd.splat8<float32>(float32(feather.max(1e-9)))
			let half = simd.splat8<float32>(float32(0.5))
			let far = simd.splat8<float32>(float32(3.0e38))
			let centres = simd.load8<float32>(laneCentres, 0)
			let vy0 = float32(py)
			let i = 0
			for i + 8 <= n {
				let px = centres + simd.splat8<float32>(float32(x + i))
				let best = far
				for let (_, e) in edges {
					let ex = float32(e.end.x - e.start.x)
					let ey = float32(e.end.y - e.start.y)
					let len2 = ex * ex + ey * ey
					let vx = px - simd.splat8<float32>(float32(e.start.x))
					let vy = simd.splat8<float32>(vy0 - float32(e.start.y))
					let t = zero
					if len2 > float32(0.0) {
						t = ((vx * simd.splat8<float32>(ex) + vy * simd.splat8<float32>(ey)) / simd.splat8<float32>(len2)).clamp(zero, one)
					}
					let qx = vx - t * simd.splat8<float32>(ex)
					let qy = vy - t * simd.splat8<float32>(ey)
					best = best.min(qx * qx + qy * qy)
				}
				let d = best.sqrt() * simd.load8<float32>(sign, i)
				let c = simd.blend(simd.gt(d, zero), one, zero)
				if feather > 0.0 {
					c = (d / soft).clamp(zero, one)
				} else if antialias {
					c = (d + half).clamp(zero, one)
				}
				if inverted {
					c = one - c
				}
				simd.store8<float32>(out, i, c)
				i += 8
			}
			for i < n {
				out[i] = float32(coverage(x + i, y))
				i++
			}
		}

		// RowMask: the polygon's box, plus the anti-aliased edge.
		def bounds() ?geom.Rect {
			return none when inverted || edges.len() == 0
			let pad = edgePad(feather, antialias)
			let (l, t, r, b) = (edges[0].start.x, edges[0].start.y, edges[0].start.x, edges[0].start.y)
			for let (_, e) in edges {
				l = l.min(e.start.x).min(e.end.x)
				t = t.min(e.start.y).min(e.end.y)
				r = r.max(e.start.x).max(e.end.x)
				b = b.max(e.start.y).max(e.end.y)
			}
			return geom.Rect{left: l - pad, top: t - pad, right: r + pad, bottom: b + pad}
		}
	}
}
