partial module std.gfx {
	use (
		std.testing
		std.math::(*)
		std.math.geom
		std.formats.image
	)

	check "Masks" {
		@test()
		def rectangle_is_hard_inside_and_out() {
			let m = new RectangleMask(new geom.Rectangle(position = new geom.Point(2.0, 2.0), size = new geom.Size(4.0, 4.0)))
			m.antialias = false
			assert m.coverage(3, 3) == 1.0
			assert m.coverage(0, 0) == 0.0
			assert m.coverage(6, 3) == 0.0
			m.inverted = true
			assert m.coverage(0, 0) == 1.0
			assert m.coverage(3, 3) == 0.0
		}

		@test()
		def rectangle_feathers_inward() {
			let m = new RectangleMask(new geom.Rectangle(position = new geom.Point(0.0, 0.0), size = new geom.Size(10.0, 10.0)), 4.0)
			// Pixel 0 sits half a pixel from the edge: coverage 0.5 / 4.
			assert approx(m.coverage(0, 5), 0.125, 1e-9)
			assert approx(m.coverage(1, 5), 0.375, 1e-9)
			assert m.coverage(5, 5) == 1.0
		}

		@test()
		def circle_antialiases_its_edge() {
			let m = new CircleMask(new geom.Circle(new geom.Point(5.0, 5.0), 3.0))
			assert m.coverage(5, 5) == 1.0
			assert m.coverage(0, 0) == 0.0
			// Pixel (7, 6) is centred 2.9 from the centre: on the ramp.
			let edge = m.coverage(7, 6)
			assert edge > 0.0 && edge < 1.0
		}

		@test()
		def path_covers_its_polygon() {
			let tri = new geom.Polygon(geom.Point[new geom.Point(0.0, 0.0), new geom.Point(10.0, 0.0), new geom.Point(0.0, 10.0)])
			let m = new PathMask(tri)
			m.antialias = false
			assert m.coverage(1, 1) == 1.0
			assert m.coverage(9, 9) == 0.0
		}

		// Rows of 21 pixels from x = -3 (two vectors and a tail, starting
		// off the mask) on every line of a 26x26 grid match the per-pixel
		// coverage, and every covered pixel lies inside bounds().
		def rowsMatchPixels(m Mask, rows RowMask) bool {
			let reach = rows.bounds()
			let out float32[]
			out.len(21)
			for let y = -2; y < 24; y++ {
				rows.coverage(-3, y, out)
				for let i = 0; i < 21; i++ {
					let want = m.coverage(i - 3, y)
					return false when (float(out[i]) - want).abs() > 1e-4
					if want > 0.0 && !(reach is none) {
						let x = float(i - 3) + 0.5
						let py = float(y) + 0.5
						return false when x < reach.left || x > reach.right || py < reach.top || py > reach.bottom
					}
				}
			}
			return true
		}

		@test()
		def rowsMatchThePixelCoverage() {
			let box = new geom.Rectangle(position = new geom.Point(2.5, 3.0), size = new geom.Size(9.0, 11.5))
			let disc = new geom.Circle(new geom.Point(9.0, 8.0), 6.3)
			let shape = new geom.Polygon(geom.Point[new geom.Point(1.0, 1.0), new geom.Point(16.0, 3.0), new geom.Point(9.0, 7.0), new geom.Point(14.0, 18.0), new geom.Point(2.0, 12.0)])
			for let variant = 0; variant < 4; variant++ {
				let r = new RectangleMask(box, variant == 1 ?? (3.0, 0.0))
				let c = new CircleMask(disc, variant == 1 ?? (2.5, 0.0))
				let p = new PathMask(shape, variant == 1 ?? (2.0, 0.0))
				r.antialias = variant != 2
				c.antialias = variant != 2
				p.antialias = variant != 2
				r.inverted = variant == 3
				c.inverted = variant == 3
				p.inverted = variant == 3
				assert rowsMatchPixels(r, r) && rowsMatchPixels(c, c) && rowsMatchPixels(p, p)
				assert (r.bounds() is none) == (variant == 3)
			}
			// Images and canvases through their luminance.
			let img = new image.Image(13, 9)
			let px = img.raw()
			for let i = 0; i < px.len(); i++ {
				px[i] = byte((i * 37 + 11) % 256)
			}
			assert rowsMatchPixels(img, img)
			let b = img.bounds()
			assert !(b is none) && b.right == 13.0 && b.bottom == 9.0
		}

		@test()
		def coverageRowServesAnyMask() {
			// A Mask that is not a RowMask is read pixel by pixel.
			let tri = new geom.Polygon(geom.Point[new geom.Point(0.0, 0.0), new geom.Point(10.0, 0.0), new geom.Point(0.0, 10.0)])
			let m = new PathMask(tri)
			let out float32[]
			out.len(12)
			coverageRow(m, 0, 2, out)
			assert approx(float(out[1]), m.coverage(1, 2), 1e-4) && out[11] == float32(0.0)
			assert coverageBounds(m) is geom.Rect
		}

		@test()
		def image_mask_reads_luminance_and_alpha() {
			let img = new image.Image(2, 1)
			let px = img.raw()
			px[0] = byte(255)
			px[1] = byte(255)
			px[2] = byte(255)
			px[3] = byte(255)
			px[4] = byte(255)
			px[5] = byte(255)
			px[6] = byte(255)
			px[7] = byte(128)
			// An Image is a Mask itself: luminance scaled by alpha.
			let m Mask = img
			assert approx(m.coverage(0, 0), 1.0, 1e-9)
			assert approx(m.coverage(1, 0), 128.0 / 255.0, 1e-9)
			assert m.coverage(5, 5) == 0.0
		}
	}
}
