partial module std.gfx.processing.analysis {
	use (
		std.math.geom
		std.gfx::(Raster)
		std.gfx.color
		std.math::(*)
		std.math.processing
		std.gfx.bands::*
	)

	// Histogram counts how many pixels take each value of each colour channel.
	struct Histogram {
		red       uint[]
		green     uint[]
		blue      uint[]
		alpha     uint[]
		luminance uint64[]
	}

	// The side of the working grid saliency is computed on: small enough
	// for the FFT to be instant, large enough to place a subject.
	const saliencyGrid = 64

	// Replaces the raster with its saliency map -- white where the subject
	// is, black elsewhere -- and returns it. Spectral residual (Hou & Zhang):
	// the part of the log-amplitude spectrum that deviates from its local
	// average is what stands out.
	def saliency(target Raster) Raster {
		let w = int(target.size().width)
		let h = int(target.size().height)
		let stride = target.stride()
		let data = target.raw()
		return target when w == 0 || h == 0

		let sal = saliencyMap(target)
		forBands(h, w * h, def (from int, to int) {
			for let y = from; y < to; y++ {
				let gy = (y * saliencyGrid) / h
				for let x = 0; x < w; x++ {
					let gx = (x * saliencyGrid) / w
					let v = byte((sal[gy * saliencyGrid + gx] * 255.0).round().clamp(0.0, 255.0))
					let o = y * stride + x * 4
					data[o] = v
					data[o + 1] = v
					data[o + 2] = v
					data[o + 3] = byte(255)
				}
			}
		})
		return target
	}

	// A square around the subject: centred on the salient area, as large as
	// its longer side, kept inside the image.
	def salientRegion(target Raster) geom.Rectangle<int> {
		let w = int(target.size().width)
		let h = int(target.size().height)
		return new geom.Rectangle<int>(position = new geom.Point<int>(0, 0), size = new geom.Size<int>(w, h)) when w == 0 || h == 0

		let sal = saliencyMap(target)
		let mean = 0.0
		for let (_, v) in sal {
			mean += v
		}
		mean /= float(sal.len())
		let cut = (mean * 2.0).max(0.3)

		let (
			minX = saliencyGrid
			minY = saliencyGrid
			maxX = -1
			maxY = -1
		)
		for let gy = 0; gy < saliencyGrid; gy++ {
			for let gx = 0; gx < saliencyGrid; gx++ {
				continue when sal[gy * saliencyGrid + gx] < cut
				minX = minX.min(gx)
				minY = minY.min(gy)
				maxX = maxX.max(gx)
				maxY = maxY.max(gy)
			}
		}
		if maxX < 0 {
			// Nothing stands out: the whole image is the subject.
			return squareInside(w / 2, h / 2, w.max(h), w, h)
		}

		// Grid cells back to pixels, then a square on the longer side.
		let px0 = (minX * w) / saliencyGrid
		let py0 = (minY * h) / saliencyGrid
		let px1 = ((maxX + 1) * w) / saliencyGrid
		let py1 = ((maxY + 1) * h) / saliencyGrid
		let side = (px1 - px0).max(py1 - py0)
		return squareInside((px0 + px1) / 2, (py0 + py1) / 2, side, w, h)
	}

	// A `side` square centred on (cx, cy), shrunk and shifted to fit in w x h.
	internal def squareInside(cx, cy, side, w, h int) geom.Rectangle<int> {
		let s = side.min(w).min(h)
		let x = (cx - s / 2).clamp(0, w - s)
		let y = (cy - s / 2).clamp(0, h - s)
		return new geom.Rectangle<int>(position = new geom.Point<int>(x, y), size = new geom.Size<int>(s, s))
	}

	// The saliency map as a `saliencyGrid` x `saliencyGrid` grid of 0..1
	// values, row-major; `saliency` and `salientRegion` are views of it,
	// and seam carving weights its energy by it.
	def saliencyMap(target Raster) float[] {
		let n = saliencyGrid
		let w = int(target.size().width)
		let h = int(target.size().height)
		let stride = target.stride()
		let data = target.raw()

		// Luminance, box-averaged onto the grid; grid rows on tasks.
		let spectrum complex128[]
		spectrum.len(n * n)
		forBands(n, w * h, def (from int, to int) {
			for let gy = from; gy < to; gy++ {
				let y0 = (gy * h) / n
				let y1 = (((gy + 1) * h) / n).max(y0 + 1)
				for let gx = 0; gx < n; gx++ {
					let x0 = (gx * w) / n
					let x1 = (((gx + 1) * w) / n).max(x0 + 1)
					let sum = 0.0
					let count = 0
					for let y = y0; y < y1 && y < h; y++ {
						for let x = x0; x < x1 && x < w; x++ {
							let o = y * stride + x * 4
							sum += 0.299 * float(data[o]) + 0.587 * float(data[o + 1]) + 0.114 * float(data[o + 2])
							count += 1
						}
					}
					count = 1 when count == 0
					spectrum[gy * n + gx] = complex(sum / float(count) / 255.0, 0.0)
				}
			}
		})

		fft2(spectrum, n, false)

		// Log amplitude, its 3x3 local average, and the residual.
		let logAmp float[]
		logAmp.len(n * n)
		for let i = 0; i < n * n; i++ {
			logAmp[i] = ln(spectrum[i].abs() + 1e-9)
		}
		for let y = 0; y < n; y++ {
			for let x = 0; x < n; x++ {
				let acc = 0.0
				for let dy = -1; dy <= 1; dy++ {
					for let dx = -1; dx <= 1; dx++ {
						acc += logAmp[((y + dy + n) % n) * n + ((x + dx + n) % n)]
					}
				}
				let residual = logAmp[y * n + x] - acc / 9.0
				let z = spectrum[y * n + x]
				let mag = z.abs()
				let scale = E ** residual
				if mag > 0.0 {
					spectrum[y * n + x] = z * complex(scale / mag, 0.0)
				}
			}
		}

		fft2(spectrum, n, true)

		// Power, smoothed with a wide Gaussian (the residual lands on edges;
		// the blur pools it over the object), normalized.
		let sal float[]
		sal.len(n * n)
		let raw float[]
		raw.len(n * n)
		for let i = 0; i < n * n; i++ {
			let m = spectrum[i].abs()
			raw[i] = m * m
		}
		let peak = 0.0
		for let y = 0; y < n; y++ {
			for let x = 0; x < n; x++ {
				let acc = 0.0
				let weight = 0.0
				for let dy = -8; dy <= 8; dy++ {
					for let dx = -8; dx <= 8; dx++ {
						let sy = y + dy
						let sx = x + dx
						continue when sy < 0 || sy >= n || sx < 0 || sx >= n
						let g = E ** (-float(dx * dx + dy * dy) / 32.0)
						acc += raw[sy * n + sx] * g
						weight += g
					}
				}
				let v = acc / weight
				sal[y * n + x] = v
				peak = peak.max(v)
			}
		}
		if peak > 0.0 {
			for let i = 0; i < n * n; i++ {
				sal[i] /= peak
			}
		}
		return sal
	}

	// In-place 2D FFT of an n x n grid: rows, then columns.
	internal def fft2(grid complex128[], n int, inverse bool) {
		let line complex128[]
		line.len(n)
		for let y = 0; y < n; y++ {
			for let x = 0; x < n; x++ {
				line[x] = grid[y * n + x]
			}
			let out = lineTransform(line, inverse)
			for let x = 0; x < n; x++ {
				grid[y * n + x] = out[x]
			}
		}
		for let x = 0; x < n; x++ {
			for let y = 0; y < n; y++ {
				line[y] = grid[y * n + x]
			}
			let out = lineTransform(line, inverse)
			for let y = 0; y < n; y++ {
				grid[y * n + x] = out[y]
			}
		}
	}

	internal def lineTransform(line complex128[], inverse bool) complex128[] {
		return processing.ifft(line) when inverse
		return processing.fft(line) onerror recover complex128[]
	}

	// The mean of every pixel's channels.
	def averageColor(target Raster) color.Color {
		let w = int(target.size().width)
		let h = int(target.size().height)
		let stride = target.stride()
		let data = target.raw()
		// Per band, then added in band order (integers: exact either way).
		let bands = bandCount(h, w * h)
		let parts uint64[]
		parts.len(bands * 4)
		forBands(h, w * h, def (from int, to int) {
			let band = bandOf(from, h, bands)
			let s0 = uint64(0)
			let s1 = uint64(0)
			let s2 = uint64(0)
			let s3 = uint64(0)
			for let y = from; y < to; y++ {
				let o = y * stride
				let end = o + w * 4
				for o < end {
					s0 += uint64(data[o])
					s1 += uint64(data[o + 1])
					s2 += uint64(data[o + 2])
					s3 += uint64(data[o + 3])
					o += 4
				}
			}
			parts[band * 4] = s0
			parts[band * 4 + 1] = s1
			parts[band * 4 + 2] = s2
			parts[band * 4 + 3] = s3
		})
		let sums = uint64[0, 0, 0, 0]
		for let i = 0; i < bands * 4; i++ {
			sums[i % 4] += parts[i]
		}
		let count = uint64(w * h)
		count = 1 when count == 0
		return new color.Color(color.RGBA{
			r: uint8(sums[0] / count),
			g: uint8(sums[1] / count),
			b: uint8(sums[2] / count),
			a: uint8(sums[3] / count)
		})
	}

	// Per-channel counts over 256 bins, plus luminance.
	def histogram(target Raster) Histogram {
		let hist = Histogram{}
		hist.red.len(256)
		hist.green.len(256)
		hist.blue.len(256)
		hist.alpha.len(256)
		hist.luminance.len(256)
		let w = int(target.size().width)
		let h = int(target.size().height)
		let stride = target.stride()
		let data = target.raw()
		// Counts per band (five 256-bin tables each), added up after.
		let bands = bandCount(h, w * h)
		let parts uint64[]
		parts.len(bands * 5 * 256)
		forBands(h, w * h, def (from int, to int) {
			let at = bandOf(from, h, bands) * 5 * 256
			for let y = from; y < to; y++ {
				let o = y * stride
				let end = o + w * 4
				for o < end {
					parts[at + int(data[o])] += uint64(1)
					parts[at + 256 + int(data[o + 1])] += uint64(1)
					parts[at + 512 + int(data[o + 2])] += uint64(1)
					parts[at + 768 + int(data[o + 3])] += uint64(1)
					let lum = int((0.299 * float(data[o]) + 0.587 * float(data[o + 1]) + 0.114 * float(data[o + 2])).round())
					parts[at + 1024 + lum.clamp(0, 255)] += uint64(1)
					o += 4
				}
			}
		})
		for let b = 0; b < bands; b++ {
			let at = b * 5 * 256
			for let v = 0; v < 256; v++ {
				hist.red[v] += uint(parts[at + v])
				hist.green[v] += uint(parts[at + 256 + v])
				hist.blue[v] += uint(parts[at + 512 + v])
				hist.alpha[v] += uint(parts[at + 768 + v])
				hist.luminance[v] += parts[at + 1024 + v]
			}
		}
		return hist
	}

	// The most common color, judged on 32-level channels so near-identical
	// pixels count together; the returned color is the mean of that bucket.
	def dominantColor(target Raster) color.Color {
		let w = int(target.size().width)
		let h = int(target.size().height)
		let stride = target.stride()
		let data = target.raw()
		let counts uint[]
		counts.len(32 * 32 * 32)
		let sumR uint64[]
		let sumG uint64[]
		let sumB uint64[]
		sumR.len(32 * 32 * 32)
		sumG.len(32 * 32 * 32)
		sumB.len(32 * 32 * 32)
		// Per band (count and three sums per bucket), added up after.
		let buckets = 32 * 32 * 32
		let bands = bandCount(h, w * h)
		let parts uint64[]
		parts.len(bands * buckets * 4)
		forBands(h, w * h, def (from int, to int) {
			let at = bandOf(from, h, bands) * buckets * 4
			for let y = from; y < to; y++ {
				let o = y * stride
				let end = o + w * 4
				for o < end {
					if data[o + 3] != byte(0) {
						let key = at + ((int(data[o]) >> 3) * 1024 + (int(data[o + 1]) >> 3) * 32 + (int(data[o + 2]) >> 3)) * 4
						parts[key] += uint64(1)
						parts[key + 1] += uint64(data[o])
						parts[key + 2] += uint64(data[o + 1])
						parts[key + 3] += uint64(data[o + 2])
					}
					o += 4
				}
			}
		})
		for let b = 0; b < bands; b++ {
			let at = b * buckets * 4
			for let k = 0; k < buckets; k++ {
				continue when parts[at + k * 4] == uint64(0)
				counts[k] += uint(parts[at + k * 4])
				sumR[k] += parts[at + k * 4 + 1]
				sumG[k] += parts[at + k * 4 + 2]
				sumB[k] += parts[at + k * 4 + 3]
			}
		}
		let best = 0
		for let i = 1; i < counts.len(); i++ {
			best = i when counts[i] > counts[best]
		}
		return new color.Color(color.RGBA{r: 0, g: 0, b: 0, a: 0}) when counts[best] == 0
		let n = uint64(counts[best])
		return new color.Color(color.RGBA{r: uint8(sumR[best] / n), g: uint8(sumG[best] / n), b: uint8(sumB[best] / n), a: 255})
	}

	// embedding computes an embedding vector of the given size for the image with
	// the named model. Not implemented yet: returns no values.
	def embedding(target Raster, model string, size int) float32[] {
		// @TODO: implement
		return []
	}

	// Reports whether every pixel is fully opaque.
	def isOpaque(target Raster) bool {
		let w = int(target.size().width)
		let h = int(target.size().height)
		let stride = target.stride()
		let data = target.raw()

		for let y = 0; y < h; y++ {
			let row = y * stride
			for let x = 0; x < w; x++ {
				return false when data[row + x * 4 + 3] != byte(255)
			}
		}
		return true
	}
}
