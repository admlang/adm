partial module std.gfx.processing.analysis {
	use (
		std.testing
		std.formats.image
	)

	internal def blockImage() image.Image {
		// Dark, lightly textured 64x64 with a bright 16x16 block at
		// (40..56, 8..24).
		let img = new image.Image(64, 64)
		let px = img.raw()
		// Deterministic noise on the background: spectral residual keys on
		// what deviates from the image's own statistics, and a perfectly
		// flat background has none (its artifacts land on borders instead).
		let seed = uint32(12345)
		for let y = 0; y < 64; y++ {
			for let x = 0; x < 64; x++ {
				let o = img.pixelOffset(x, y)
				seed = seed * uint32(1664525) + uint32(1013904223)
				let v = byte(20 + int(seed >> 27))
				v = byte(240) when x >= 40 && x < 56 && y >= 8 && y < 24
				px[o] = v
				px[o + 1] = v
				px[o + 2] = v
				px[o + 3] = byte(255)
			}
		}
		return img
	}

	check "Analysis" {
		@test()
		def salient_region_frames_the_block() {
			let r = salientRegion(blockImage())
			// A square, inside the image, overlapping the block.
			assert r.size.width == r.size.height
			assert r.left() >= 0 && r.top() >= 0 && r.right() <= 64 && r.bottom() <= 64
			let c = r.center()
			assert c.x >= 36 && c.x < 60
			assert c.y >= 4 && c.y < 28
		}

		@test()
		def saliency_map_is_brightest_at_the_block() {
			let img = blockImage()
			saliency(img)
			let px = img.raw()
			let inside = int(px[img.pixelOffset(48, 16)])
			let far = int(px[img.pixelOffset(12, 52)])
			assert inside > far
			assert int(px[img.pixelOffset(8, 56) + 3]) == 255
		}

		@test()
		def average_and_dominant_color() {
			let img = new image.Image(4, 1)
			let px = img.raw()
			for let x = 0; x < 4; x++ {
				let o = x * 4
				px[o] = byte(200)
				px[o + 3] = byte(255)
			}
			px[0] = byte(0) // one black pixel among three (200, 0, 0)
			let avg = averageColor(img).rgba
			assert int(avg.r) == 150 && int(avg.a) == 255
			let dom = dominantColor(img).rgba
			assert int(dom.r) == 200 && int(dom.g) == 0
		}

		@test()
		def histogram_counts_every_pixel() {
			let img = new image.Image(3, 2)
			let px = img.raw()
			for let i = 0; i < 6; i++ {
				px[i * 4 + 3] = byte(255)
			}
			px[0] = byte(255)
			let h = histogram(img)
			assert int(h.red[255]) == 1 && int(h.red[0]) == 5
			assert int(h.alpha[255]) == 6
			assert int(h.luminance[0]) == 5
		}

		@test()
		def opaque_check() {
			let img = new image.Image(2, 2)
			assert !isOpaque(img)
			let px = img.raw()
			for let i = 0; i < 4; i++ {
				px[i * 4 + 3] = byte(255)
			}
			assert isOpaque(img)
		}
	}
}
