partial module std.gfx.processing.analysis {
	use (
		std.data.encoding::(Base83)
		std.gfx::(Raster)
		std.gfx.colorspace
		std.math::(*)
		std.simd
		std.gfx.processing.analysis.hashing::*
	)

	// blurHash computes the BlurHash placeholder of the image: the ASCII
	// bytes of its base-83 string, from `cols` horizontal and `rows` vertical
	// cosine components (each clamped to 1..9). Alpha is ignored. An empty
	// image gives no bytes.
	def blurHash(target Raster, rows int = 4, cols int = 4) byte[] {
		let w = int(target.size().width)
		let h = int(target.size().height)
		return [] when w == 0 || h == 0
		let ny = rows.clamp(1, 9)
		let nx = cols.clamp(1, 9)
		let n = nx * ny * 3
		// Rows padded to whole vectors; the padding's cosines are zero.
		let wp = (w + 7) / 8 * 8

		let linear float64[]
		linear.len(256)
		for let v = 0; v < 256; v++ {
			linear[v] = float64(colorspace.srgbToLinear(uint8(v)))
		}
		let cosX float64[]
		cosX.len(nx * wp)
		for let i = 0; i < nx; i++ {
			for let x = 0; x < w; x++ {
				cosX[i * wp + x] = float64(cos(π * float(i * x) / float(w)))
			}
		}
		let cosY float64[]
		cosY.len(ny * h)
		for let j = 0; j < ny; j++ {
			for let y = 0; y < h; y++ {
				cosY[j * h + y] = float64(cos(π * float(j * y) / float(h)))
			}
		}

		// Bands of rows summed by tasks of their own into `parts`, then
		// added up in band order, so the hash does not depend on timing.
		let bands = (w * h / blurHashBandPixels).clamp(1, blurHashMaxBands).min(h)
		let parts float64[]
		parts.len(bands * n)
		let data = target.raw()
		let stride = target.stride()
		if bands == 1 {
			blurHashBand(data, stride, w, h, wp, 0, h, nx, ny, linear, cosX, cosY, parts, 0)
		} else {
			let done = new channel<bool>(size = bands)
			for let b = 0; b < bands; b++ {
				async blurHashTask(data, stride, w, h, wp, h * b / bands, h * (b + 1) / bands, nx, ny, linear, cosX, cosY, parts, b * n, done)
			}
			for let b = 0; b < bands; b++ {
				<-done
			}
		}

		// factors holds r, g, b per component, row-major by (j, i).
		let factors float[]
		factors.len(n)
		for let b = 0; b < bands; b++ {
			for let k = 0; k < n; k++ {
				factors[k] += float(parts[b * n + k])
			}
		}
		let area = float(w * h)
		for let k = 0; k < nx * ny; k++ {
			let scale = (k == 0 ?? (1.0, 2.0)) / area
			for let c = 0; c < 3; c++ {
				factors[k * 3 + c] *= scale
			}
		}

		let codec = new Base83()
		let hash = codec.encode((nx - 1) + (ny - 1) * 9, 1)
		let maximum = 1.0
		if nx * ny > 1 {
			let actual = 0.0
			for let k = 3; k < nx * ny * 3; k++ {
				actual = actual.max(factors[k].abs())
			}
			let quantised = int((actual * 166.0 - 0.5).floor()).clamp(0, 82)
			maximum = float(quantised + 1) / 166.0
			hash += codec.encode(quantised, 1)
		} else {
			hash += codec.encode(0, 1)
		}
		let dc = (int(colorspace.linearToSrgb(factors[0])) << 16) + (int(colorspace.linearToSrgb(factors[1])) << 8) + int(colorspace.linearToSrgb(factors[2]))
		hash += codec.encode(dc, 4)
		for let k = 1; k < nx * ny; k++ {
			let qr = quantiseAc(factors[k * 3] / maximum)
			let qg = quantiseAc(factors[k * 3 + 1] / maximum)
			let qb = quantiseAc(factors[k * 3 + 2] / maximum)
			hash += codec.encode(qr * 19 * 19 + qg * 19 + qb, 2)
		}
		return hash.bytes()
	}
}

internal partial module std.gfx.processing.analysis.hashing {
	use (
		std.gfx.processing.analysis::*
		std.data.encoding::(Base83)
		std.gfx::(Raster)
		std.gfx.colorspace
		std.math::(*)
		std.simd
	)

	// Pixels per band of rows `blurHash` hands to a task, and the most bands.
	const blurHashBandPixels = 65536

	const blurHashMaxBands = 16

	async def blurHashTask(data byte[], stride int, w int, h int, wp int, y0 int, y1 int, nx int, ny int, linear float64[], cosX float64[], cosY float64[], out float64[], at int, done channel<bool>) {
		blurHashBand(data, stride, w, h, wp, y0, y1, nx, ny, linear, cosX, cosY, out, at)
		done <- true
	}

	// Adds the unscaled factors of rows `y0` up to `y1` to `out[at:]`. The
	// basis is separable: each row is first summed against the horizontal
	// cosines, eight pixels a lane, and those sums are then weighted by the
	// row's vertical cosines.
	def blurHashBand(data byte[], stride int, w int, h int, wp int, y0 int, y1 int, nx int, ny int, linear float64[], cosX float64[], cosY float64[], out float64[], at int) {
		let lr float64[]
		lr.len(wp)
		let lg float64[]
		lg.len(wp)
		let lb float64[]
		lb.len(wp)
		let sums float64[]
		sums.len(nx * 3)
		for let y = y0; y < y1; y++ {
			let row = y * stride
			for let x = 0; x < w; x++ {
				let o = row + x * 4
				lr[x] = linear[int(data[o])]
				lg[x] = linear[int(data[o + 1])]
				lb[x] = linear[int(data[o + 2])]
			}
			for let i = 0; i < nx; i++ {
				let base = i * wp
				let ar = simd.splat8<float64>(float64(0))
				let ag = ar
				let ab = ar
				for let x = 0; x < wp; x += 8 {
					let c = simd.load8<float64>(cosX, base + x)
					ar = c.fma(simd.load8<float64>(lr, x), ar)
					ag = c.fma(simd.load8<float64>(lg, x), ag)
					ab = c.fma(simd.load8<float64>(lb, x), ab)
				}
				sums[i * 3] = ar.sum()
				sums[i * 3 + 1] = ag.sum()
				sums[i * 3 + 2] = ab.sum()
			}
			for let j = 0; j < ny; j++ {
				let cy = cosY[j * h + y]
				let f = at + j * nx * 3
				for let k = 0; k < nx * 3; k++ {
					out[f + k] += cy * sums[k]
				}
			}
		}
	}

	// An AC component, already divided by the maximum, as 0..18: the signed
	// square root spread over 19 steps.
	def quantiseAc(v float) int {
		let root = v < 0.0 ?? (-((-v) ** 0.5), v ** 0.5)
		return int((root * 9.0 + 9.5).floor()).clamp(0, 18)
	}
}
