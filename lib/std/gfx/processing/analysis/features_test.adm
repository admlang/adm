partial module std.gfx.processing.analysis {
	use (
		std.testing
		std.formats.image
		std.math::(*)
		std.data.encoding::(hexencode)
	)

	// A 400x300 master scene of overlapping rectangles and discs (from a
	// seed) on a ramp, drawn into a `w` x `h` image as the master scaled by
	// `s`, rotated by `degrees`, shifted by (dx, dy) and, when `mirror`,
	// mirrored left to right first; `mark` covers the bottom right with a
	// banner. Two by two samples per pixel.
	internal def drawScene(w int, h int, seed int = 1, s float = 1.0, degrees float = 0.0, dx float = 0.0, dy float = 0.0, mirror bool = false, mark bool = false) image.Image {
		let shapes float[]
		let state = uint32(seed * 7919 + 17)
		for let i = 0; i < 60; i++ {
			for let k = 0; k < 5; k++ {
				state = state * uint32(1664525) + uint32(1013904223)
				shapes.push(float(state >> 8) / 16777216.0)
			}
		}
		let ca = cos(degrees * π / 180.0)
		let sa = sin(degrees * π / 180.0)
		let img = new image.Image(w, h)
		let px = img.raw()
		for let y = 0; y < h; y++ {
			for let x = 0; x < w; x++ {
				let sum = 0.0
				for let sy = 0; sy < 2; sy++ {
					for let sx = 0; sx < 2; sx++ {
						// Undo the shift, rotation and scale.
						let qx = float(x) + 0.25 + 0.5 * float(sx) - dx
						let qy = float(y) + 0.25 + 0.5 * float(sy) - dy
						let mx = (ca * qx + sa * qy) / s
						let my = (-sa * qx + ca * qy) / s
						mx = 400.0 - mx when mirror
						sum += sceneAt(shapes, mx, my)
					}
				}
				let v = sum / 4.0
				v = ((x / 6 + y / 6) % 2 == 0) ?? (250.0, 200.0) when mark && x > w * 3 / 4 && y > h * 7 / 8
				let o = img.pixelOffset(x, y)
				let b = byte(v.clamp(0.0, 255.0))
				px[o] = b
				px[o + 1] = byte((v * 0.8).clamp(0.0, 255.0))
				px[o + 2] = b
				px[o + 3] = byte(255)
			}
		}
		return img
	}

	internal def sceneAt(shapes float[], x float, y float) float {
		return 0.0 when x < 0.0 || y < 0.0 || x >= 400.0 || y >= 300.0
		let v = 40.0 + 0.2 * x
		for let i = 0; i < 60; i++ {
			let cx = shapes[i * 5] * 400.0
			let cy = shapes[i * 5 + 1] * 300.0
			let size = 8.0 + shapes[i * 5 + 2] * 30.0
			let grey = shapes[i * 5 + 3] * 255.0
			let inside = false
			if shapes[i * 5 + 4] < 0.5 {
				inside = (x - cx).abs() < size && (y - cy).abs() < size * 0.6
			} else {
				inside = (x - cx) * (x - cx) + (y - cy) * (y - cy) < size * size
			}
			v = grey when inside
		}
		return v
	}

	internal def near(a float, b float, eps float) bool {
		return (a - b).abs() <= eps
	}

	check "Features" {
		@test()
		def finds_spread_keypoints_with_descriptors() {
			let f = features(drawScene(400, 300))
			assert f.len() > 200 && f.len() <= 500
			assert f.descriptors.len() == f.len() * 32
			assert f.width == 400 && f.height == 300
			let left = 0
			for let (_, k) in f.keypoints {
				assert k.x >= 0.0 && k.x < 400.0 && k.y >= 0.0 && k.y < 300.0
				left++ when k.x < 200.0
			}
			assert left > f.len() / 4 && left < f.len() * 3 / 4
			assert features(new image.Image(0, 0)).len() == 0
			assert features(drawScene(400, 300), limit = 50).len() <= 50
		}

		@test()
		def same_image_matches_with_the_identity() {
			let f = features(drawScene(400, 300))
			let m = f.compare(f)
			assert m.score > 0.9
			let t = m.transform
			assert near(t.a, 1.0, 0.01) && near(t.b, 0.0, 0.01) && near(t.tx, 0.0, 1.0) && near(t.ty, 0.0, 1.0)
		}

		@test()
		def scaled_rotated_copy_recovers_the_transform() {
			let a = features(drawScene(400, 300))
			let b = features(drawScene(520, 520, s = 0.8, degrees = 30.0, dx = 200.0, dy = 40.0))
			let m = a.compare(b)
			assert m.score > 0.2 && m.inliers >= 30
			let t = m.transform
			assert near(t.a, 0.8 * cos(π / 6.0), 0.03) && near(t.b, 0.8 * sin(π / 6.0), 0.03)
			assert near(t.c, -0.8 * sin(π / 6.0), 0.03) && near(t.d, 0.8 * cos(π / 6.0), 0.03)
			assert near(t.tx, 200.0, 4.0) && near(t.ty, 40.0, 4.0)
		}

		@test()
		def crop_mirror_and_watermark_still_match() {
			let a = features(drawScene(400, 300))
			// The middle 240x180 of the master.
			let crop = a.compare(features(drawScene(240, 180, dx = -80.0, dy = -60.0)))
			assert crop.score > 0.3
			assert near(crop.transform.a, 1.0, 0.03) && near(crop.transform.tx, -80.0, 3.0) && near(crop.transform.ty, -60.0, 3.0)
			let mirrored = a.compare(features(drawScene(400, 300, mirror = true)))
			assert mirrored.score > 0.3
			let t = mirrored.transform
			assert t.a * t.d - t.b * t.c < 0.0
			assert near(t.a, -1.0, 0.03) && near(t.tx, 399.0, 4.0)
			let marked = a.compare(features(drawScene(400, 300, mark = true)))
			assert marked.score > 0.6
		}

		@test()
		def different_images_do_not_match() {
			let a = features(drawScene(400, 300))
			for let seed = 2; seed < 10; seed++ {
				let m = a.compare(features(drawScene(400, 300, seed = seed)))
				assert m.score < 0.05
			}
		}

		@test()
		def bytes_round_trip() {
			let f = features(drawScene(200, 150), limit = 40)
			let back = parseFeatures(f.bytes()) onerror recover new Features()
			assert back.len() == f.len() && back.width == 200 && back.height == 150
			for let i = 0; i < f.len(); i++ {
				assert back.keypoints[i].x == f.keypoints[i].x && back.keypoints[i].angle == f.keypoints[i].angle
			}
			assert hexencode(back.descriptors) == hexencode(f.descriptors)
			assert hexencode(f.descriptor(1)) == hexencode(f.descriptors[32:64])
			let bad = parseFeatures("ADMF".bytes()) onerror recover new Features()
			assert bad.len() == 0
		}
	}
}
