partial module std.gfx.processing.analysis {
	use (
		std.gfx::(Raster)
		std.math::(*)
		std.simd
		std.gfx.processing.analysis.hashing::*
	)

	// HashAlgorithm is the perceptual hash to compute. Every algorithm hashes
	// the image's luma only, so all of them match a copy that was resized,
	// recompressed, converted to grey or shifted in hue. None matches a
	// cropped, rotated or flipped copy, or one under a large overlay.
	enum HashAlgorithm {
		// The cells above the mean. The fastest and simplest; matches resized
		// and recompressed copies, uniform brightness and contrast changes and
		// light blur. Gamma and curve edits and local changes (a logo, a
		// watermark) move the mean and flip many bits, and images with a
		// similar overall layout collide more often than with the others.
		Average
		// Whether each cell is brighter than its right neighbour: the
		// direction of the gradients. As fast as Average, with fewer false
		// matches; also matches gamma, curve and contrast edits, since they
		// keep which of two neighbours is brighter. Horizontal shifts and
		// mirrored copies break it.
		Difference
		// The lowest DCT frequencies above their median: the image's coarse
		// structure. The most robust, and the default: matches heavy
		// compression, blur, noise, gamma and colour edits, and small local
		// changes such as a corner watermark or a caption, which mostly
		// touch high frequencies. Slightly slower, still under a millisecond
		// on a 4K image.
		Perceptual
		// The Haar wavelet low band above its median. Close to Average, but
		// the median splits the bits evenly, which tells apart images with
		// large flat areas (documents, graphics, skies) that Average hashes
		// alike.
		Wavelet
	}

	// hash computes a 64-bit perceptual hash of the image with the chosen
	// algorithm: 8 bytes holding the bits row by row, most significant bit
	// first, as the Python imagehash package prints them in hex. Similar
	// images get hashes that differ in few bits. The image is first reduced
	// to a small grey grid by exact area averaging (luma per ITU-R BT.601,
	// alpha ignored):
	//
	// - Average: 8x8 grid, a bit per cell brighter than the mean.
	// - Difference: 9x8 grid, a bit per cell darker than its right neighbour.
	// - Perceptual: 32x32 grid, a DCT-II, a bit per coefficient of the 8x8
	//   lowest frequencies above their median.
	// - Wavelet: the Haar wavelet low band with the image mean removed, which
	//   comes to an 8x8 grid and a bit per cell above the median.
	//
	// An empty image hashes to eight zero bytes.
	def hash(target Raster, algorithm HashAlgorithm = HashAlgorithm.Perceptual) byte[] {
		let out byte[]
		out.len(8)
		match algorithm {
			case HashAlgorithm.Average:
				let g = lumaGrid(target, 8, 8)
				let mean = 0.0
				for let k = 0; k < 64; k++ {
					mean += float(g[k])
				}
				mean /= 64.0
				for let k = 0; k < 64; k++ {
					setHashBit(out, k) when float(g[k]) > mean
				}
			case HashAlgorithm.Difference:
				let g = lumaGrid(target, 9, 8)
				for let y = 0; y < 8; y++ {
					for let x = 0; x < 8; x++ {
						setHashBit(out, y * 8 + x) when g[y * 9 + x + 1] > g[y * 9 + x]
					}
				}
			case HashAlgorithm.Perceptual:
				let c = lowFrequencies(lumaGrid(target, 32, 32))
				let med = median(c)
				for let k = 0; k < 64; k++ {
					setHashBit(out, k) when c[k] > med
				}
			case HashAlgorithm.Wavelet:
				// With Haar the low band after `n` levels is 2^n times the
				// block means (less the image mean once the top band is
				// removed), so the median test sees the block means' order.
				let g = lumaGrid(target, 8, 8)
				let med = median(g)
				for let k = 0; k < 64; k++ {
					setHashBit(out, k) when g[k] > med
				}
		}
		return out
	}

	// similarity is how alike two images look, from 0.0 (every bit of their
	// hashes differs) to 1.0 (the same hash): the share of equal bits of
	// their hashes under `algorithm`.
	def similarity(a Raster, b Raster, algorithm HashAlgorithm = HashAlgorithm.Perceptual) float64 {
		return similarity(hash(a, algorithm), hash(b, algorithm))
	}

	// similarity compares the image with a hash taken earlier. A hash does
	// not record its algorithm, so `algorithm` must be the one `known` was
	// made with.
	def similarity(target Raster, known byte[], algorithm HashAlgorithm = HashAlgorithm.Perceptual) float64 {
		return similarity(hash(target, algorithm), known)
	}

	// similarity is the share of equal bits of two hashes of one algorithm;
	// 0.0 when their lengths differ or they are empty.
	def similarity(a byte[], b byte[]) float64 {
		return float64(0) when a.len() != b.len() || a.len() == 0
		let differing = 0
		for let i = 0; i < a.len(); i++ {
			let x = int(a[i] ^ b[i])
			for x != 0 {
				x &= x - 1
				differing++
			}
		}
		return float64(1) - float64(differing) / float64(a.len() * 8)
	}
}

internal partial module std.gfx.processing.analysis.hashing {
	use (
		std.gfx.processing.analysis::*
		std.gfx::(Raster)
		std.math::(*)
		std.simd
	)

	// Pixels per task `lumaGrid` hands out, at least.
	const hashBandPixels = 65536

	def setHashBit(out byte[], k int) {
		out[k >> 3] = out[k >> 3] | byte(0x80 >> (k & 7))
	}

	// The median of the values; the mean of the two middle ones for an even
	// count.
	def median(values float64[]) float64 {
		let sorted float64[]
		sorted.len(values.len())
		for let i = 0; i < values.len(); i++ {
			sorted[i] = values[i]
		}
		sorted.sort((a float64, b float64) => a < b)
		let n = sorted.len()
		return sorted[n / 2] when n % 2 == 1
		return (sorted[n / 2 - 1] + sorted[n / 2]) / float64(2)
	}

	// The 8x8 lowest DCT-II coefficients of a 32x32 grid, rows (vertical
	// frequency) first: the columns are transformed first, then the rows.
	def lowFrequencies(g float64[]) float64[] {
		let basis float64[]
		basis.len(8 * 32)
		for let u = 0; u < 8; u++ {
			for let n = 0; n < 32; n++ {
				basis[u * 32 + n] = float64(cos(π * float(u * (2 * n + 1)) / 64.0))
			}
		}
		// t[y][v]: each row against the horizontal frequencies.
		let t float64[]
		t.len(32 * 8)
		for let y = 0; y < 32; y++ {
			for let v = 0; v < 8; v++ {
				let acc = simd.splat8<float64>(float64(0))
				for let x = 0; x < 32; x += 8 {
					acc = simd.load8<float64>(g, y * 32 + x).fma(simd.load8<float64>(basis, v * 32 + x), acc)
				}
				t[y * 8 + v] = acc.sum()
			}
		}
		let c float64[]
		c.len(64)
		for let u = 0; u < 8; u++ {
			for let v = 0; v < 8; v++ {
				let acc = float64(0)
				for let y = 0; y < 32; y++ {
					acc += basis[u * 32 + y] * t[y * 8 + v]
				}
				c[u * 8 + v] = acc
			}
		}
		return c
	}

	// The image reduced to `cols` x `rows` mean luma values, row-major, by
	// exact area averaging (a source pixel split between cells counts in
	// each by the share it covers, so it enlarges as well as shrinks).
	// Output rows are independent, so a large image hands them to tasks.
	def lumaGrid(target Raster, cols int, rows int) float64[] {
		let grid float64[]
		grid.len(cols * rows)
		let w = int(target.size().width)
		let h = int(target.size().height)
		return grid when w == 0 || h == 0
		let data = target.raw()
		let stride = target.stride()
		let tasks = (w * h / hashBandPixels).clamp(1, rows)
		if tasks == 1 {
			lumaRows(data, stride, w, h, cols, rows, 0, rows, grid)
			return grid
		}
		let done = new channel<bool>(size = tasks)
		for let t = 0; t < tasks; t++ {
			async lumaRowsTask(data, stride, w, h, cols, rows, rows * t / tasks, rows * (t + 1) / tasks, grid, done)
		}
		for let t = 0; t < tasks; t++ {
			<-done
		}
		return grid
	}

	async def lumaRowsTask(data byte[], stride int, w int, h int, cols int, rows int, from int, to int, grid float64[], done channel<bool>) {
		lumaRows(data, stride, w, h, cols, rows, from, to, grid)
		done <- true
	}

	// Fills grid rows `from` up to `to`. Each output row first sums its
	// source rows into `acc` over the raw RGBA bytes, eight lanes at a time
	// (no channel unpacking), then bins the columns and weighs the channels
	// into luma once.
	def lumaRows(data byte[], stride int, w int, h int, cols int, rows int, from int, to int, grid float64[]) {
		let n = w * 4
		let acc float32[]
		acc.len(n)
		let area = float64(w) * float64(h) / (float64(cols) * float64(rows))
		let bins = areaBins(w, cols)
		for let j = from; j < to; j++ {
			let y0 = float64(j * h) / float64(rows)
			let y1 = float64((j + 1) * h) / float64(rows)
			let yEnd = int(y1.ceil()).min(h)
			// The first source row stores, the rest add: no clearing pass.
			let first = true
			for let y = int(y0.floor()); y < yEnd; y++ {
				let weight = float32(float64(y + 1).min(y1) - float64(y).max(y0))
				continue when weight <= float32(0)
				let row = y * stride
				let wv = simd.splat8<float32>(weight)
				let x = 0
				if first {
					for x + 8 <= n {
						simd.store8<float32>(acc, x, simd.convert<byte, float32>(simd.load8<byte>(data, row + x)) * wv)
						x += 8
					}
					for x < n {
						acc[x] = float32(data[row + x]) * weight
						x++
					}
					first = false
					continue
				}
				for x + 8 <= n {
					let v = simd.convert<byte, float32>(simd.load8<byte>(data, row + x))
					simd.store8<float32>(acc, x, v.fma(wv, simd.load8<float32>(acc, x)))
					x += 8
				}
				for x < n {
					acc[x] += float32(data[row + x]) * weight
					x++
				}
			}
			for let i = 0; i < cols; i++ {
				let r = float64(0)
				let g = float64(0)
				let b = float64(0)
				let at = bins.offset[i]
				let x0 = bins.first[i]
				for let k = 0; k < bins.count[i]; k++ {
					let weight = bins.weights[at + k]
					let o = (x0 + k) * 4
					r += float64(acc[o]) * weight
					g += float64(acc[o + 1]) * weight
					b += float64(acc[o + 2]) * weight
				}
				grid[j * cols + i] = (float64(0.299) * r + float64(0.587) * g + float64(0.114) * b) / area
			}
		}
	}

	// Which source samples each of `m` output cells covers when `n` samples
	// are shrunk or enlarged by area averaging, and by how much: cell i takes
	// `count[i]` samples from `first[i]`, weighted by `weights[offset[i]:]`.
	// The same for every row, so it is worked out once.
	struct AreaBins {
		first   int[]
		count   int[]
		offset  int[]
		weights float64[]
	}

	def areaBins(n int, m int) AreaBins {
		let bins = AreaBins{first: int[], count: int[], offset: int[], weights: float64[]}
		for let i = 0; i < m; i++ {
			let x0 = float64(i * n) / float64(m)
			let x1 = float64((i + 1) * n) / float64(m)
			let start = int(x0.floor())
			let end = int(x1.ceil()).min(n)
			bins.first.push(start)
			bins.count.push(end - start)
			bins.offset.push(bins.weights.len())
			for let x = start; x < end; x++ {
				bins.weights.push(float64(x + 1).min(x1) - float64(x).max(x0))
			}
		}
		return bins
	}
}
