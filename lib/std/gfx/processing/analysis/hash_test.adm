partial module std.gfx.processing.analysis {
	use (
		std.testing
		std.formats.image
		std.data.encoding::(hexencode)
	)

	// A grey image of the pattern the imagehash reference hashes were taken
	// from.
	internal def greyPattern(w int, h int) image.Image {
		let img = new image.Image(w, h)
		let px = img.raw()
		for let y = 0; y < h; y++ {
			for let x = 0; x < w; x++ {
				let v = byte((x * x * 7 + y * 13 + x * y * 5 + (x ^ y) * 3) % 256)
				let o = img.pixelOffset(x, y)
				px[o] = v
				px[o + 1] = v
				px[o + 2] = v
				px[o + 3] = byte(255)
			}
		}
		return img
	}

	internal def colourPattern(w int, h int) image.Image {
		let img = new image.Image(w, h)
		let px = img.raw()
		for let y = 0; y < h; y++ {
			for let x = 0; x < w; x++ {
				let o = img.pixelOffset(x, y)
				px[o] = byte((x * 3 + y) % 256)
				px[o + 1] = byte((y * 5 + (x * y) / 7) % 256)
				px[o + 2] = byte(((x ^ y) * 11) % 256)
				px[o + 3] = byte(255)
			}
		}
		return img
	}

	// A smooth scene drawn at any size: a bright disc off centre on a
	// diagonal ramp.
	internal def scene(w int, h int, shift int = 0) image.Image {
		let img = new image.Image(w, h)
		let px = img.raw()
		for let y = 0; y < h; y++ {
			for let x = 0; x < w; x++ {
				let fx = float(x) / float(w)
				let fy = float(y) / float(h)
				let dx = fx - 0.3
				let dy = fy - 0.6
				let v = 60.0 * (fx + fy) + (dx * dx + dy * dy < 0.04 ?? (100.0, 0.0)) + float(shift)
				let o = img.pixelOffset(x, y)
				let b = byte(v.clamp(0.0, 255.0))
				px[o] = b
				px[o + 1] = b
				px[o + 2] = b
				px[o + 3] = byte(255)
			}
		}
		return img
	}

	internal def hashDistance(a byte[], b byte[]) int {
		let d = 0
		for let i = 0; i < a.len(); i++ {
			let x = int(a[i] ^ b[i])
			for x != 0 {
				d += x & 1
				x >>= 1
			}
		}
		return d
	}

	check "Perceptual hashes" {
		@test()
		def match_imagehash_at_the_working_size() {
			// imagehash 4.3.2 on the same pixels; at its working size the
			// image is not resampled, so the hashes agree exactly.
			assert hexencode(hash(greyPattern(8, 8), HashAlgorithm.Average)) == "0c0d191b3a327765"
			assert hexencode(hash(greyPattern(9, 8), HashAlgorithm.Difference)) == "fbfaf6f6f5edecda"
			assert hexencode(hash(greyPattern(32, 32))) == "888a2da22ce7bf2b"
			assert hexencode(hash(greyPattern(16, 16), HashAlgorithm.Wavelet)) == "25165d7b84995ccb"
		}

		@test()
		def match_the_area_average_reference_on_a_large_image() {
			// Large enough for tasks. Expected: numpy area averaging, scipy
			// DCT and pywt Haar (with the top band removed, as imagehash
			// does) on the same colour pixels.
			let img = colourPattern(523, 301)
			assert hexencode(hash(img, HashAlgorithm.Average)) == "1199cccc66673339"
			assert hexencode(hash(img, HashAlgorithm.Difference)) == "c96d6c36b69bdbc9"
			assert hexencode(hash(img, HashAlgorithm.Perceptual)) == "825f002a5f2a7f1f"
			assert hexencode(hash(img, HashAlgorithm.Wavelet)) == "1199cccce6673339"
		}

		@test()
		def similar_images_hash_close_and_different_ones_far() {
			for let (_, algorithm) in [HashAlgorithm.Average, HashAlgorithm.Difference, HashAlgorithm.Perceptual, HashAlgorithm.Wavelet] {
				let small = hash(scene(64, 48), algorithm)
				let large = hash(scene(640, 480), algorithm)
				let brighter = hash(scene(200, 150, shift = 12), algorithm)
				let other = hash(colourPattern(64, 48), algorithm)
				assert hashDistance(small, large) <= 4
				assert hashDistance(small, brighter) <= 6
				assert hashDistance(small, other) >= 16
			}
		}

		@test()
		def similarity_of_images_and_hashes() {
			let small = scene(64, 48)
			let large = scene(640, 480)
			let other = colourPattern(64, 48)
			assert similarity(small, small) == float64(1)
			let close = similarity(small, large)
			assert close >= float64(0.9)
			assert similarity(small, other) < float64(0.8)
			for let (_, algorithm) in [HashAlgorithm.Average, HashAlgorithm.Difference, HashAlgorithm.Perceptual, HashAlgorithm.Wavelet] {
				let known = hash(large, algorithm)
				assert similarity(small, known, algorithm) == similarity(small, large, algorithm)
				assert similarity(hash(small, algorithm), known) == similarity(small, large, algorithm)
			}
			assert similarity(byte[0xff, 0], byte[0x0f, 0]) == float64(0.75)
			assert similarity(byte[1], byte[1, 2]) == float64(0)
			assert similarity(byte[], byte[]) == float64(0)
		}

		@test()
		def empty_image_hashes_to_zero() {
			let h = hash(new image.Image(0, 0))
			assert h.len() == 8 && hexencode(h) == "0000000000000000"
		}
	}
}
