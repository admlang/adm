partial module std.gfx.processing.filters {
	use (
		std.gfx::(Raster, Mask)
		std.gfx.color
		std.simd
		std.mem
	)

	// Eight RGBA pixels: all ones on the color lanes, zero on alpha.
	internal const rgbLanes = byte[
		255, 255, 255, 0, 255, 255, 255, 0, 255, 255, 255, 0, 255, 255, 255, 0,
		255, 255, 255, 0, 255, 255, 255, 0, 255, 255, 255, 0, 255, 255, 255, 0
	]

	// Eight RGBA pixels with `v` on the color lanes and zero on alpha.
	internal def rgbSplat(v byte) byte[] {
		let out = byte[]
		out.len(32)
		for let i = 0; i < 32; i++ {
			out[i] = v
			out[i] = byte(0) when i % 4 == 3
		}
		return out
	}

	// Every filter edits `target` in place and returns it, so calls nest;
	// `processing.Pipeline` chains them. With a `mask`, a pixel's effect is
	// scaled by the mask's coverage there; none means the whole raster.
	//
	// Strength conventions: one-way effects (grayscale, blur, sepia, ...)
	// take 0.0 (untouched) to 1.0 (full); adjustments with a natural opposite
	// (exposure, temperature, contrast, ...) take -1.0 to 1.0 with 0.0 as
	// identity. Out-of-range strengths are clamped.

	// Runs `fn` over every pixel and blends the result in by
	// `strength * coverage`.
	internal def apply(target Raster, strength float, mask ?Mask, fn def(color.RGBA) color.RGBA) Raster {
		let w = int(target.size().width)
		let h = int(target.size().height)
		let stride = target.stride()
		let data = target.raw()

		for let y = 0; y < h; y++ {
			let row = y * stride
			for let x = 0; x < w; x++ {
				let t = strength * coverageAt(mask, x, y)
				continue when t <= 0.0
				let o = row + x * 4
				let src = color.RGBA{r: data[o], g: data[o + 1], b: data[o + 2], a: data[o + 3]}
				let dst = fn(src)
				if t >= 1.0 {
					data[o] = dst.r
					data[o + 1] = dst.g
					data[o + 2] = dst.b
					data[o + 3] = dst.a
					continue
				}
				data[o] = mixByte(src.r, dst.r, t)
				data[o + 1] = mixByte(src.g, dst.g, t)
				data[o + 2] = mixByte(src.b, dst.b, t)
				data[o + 3] = mixByte(src.a, dst.a, t)
			}
		}
		return target
	}

	// The mask's coverage at a pixel; no mask covers everything.
	internal def coverageAt(mask ?Mask, x, y int) float {
		return 1.0 when mask is none
		return mask.coverage(x, y)
	}

	internal def mixByte(a byte, b byte, t float) byte {
		return byte((float(a) + (float(b) - float(a)) * t).round())
	}

	internal def clampByte(v float) byte {
		return byte(v.round().clamp(0.0, 255.0))
	}

	internal def luma(px color.RGBA) float {
		return 0.299 * float(px.r) + 0.587 * float(px.g) + 0.114 * float(px.b)
	}

	// Converts to shades of gray.
	def grayscale(target Raster, @range(0.0, 1.0) strength float = 1.0, mask ?Mask = none) Raster {
		return apply(target, strength.clamp(0.0, 1.0), mask, def (px color.RGBA) color.RGBA {
			let g = clampByte(luma(px))
			return color.RGBA{r: g, g: g, b: g, a: px.a}
		})
	}

	// Scales every pixel's alpha by `strength`.
	def opacity(target Raster, @range(0.0, 1.0) strength float, mask ?Mask = none) Raster {
		let factor = strength.clamp(0.0, 1.0)
		return apply(target, 1.0, mask, px => color.RGBA{r: px.r, g: px.g, b: px.b, a: clampByte(float(px.a) * factor)})
	}

	// Gaussian blur; `strength` 1.0 is a sigma of eight pixels.
	def blur(target Raster, @range(0.0, 1.0) strength float, mask ?Mask = none) Raster {
		let sigma = strength.clamp(0.0, 1.0) * 8.0
		return target when sigma <= 0.0
		let blurred = gaussian(target, sigma)
		return blendBuffer(target, blurred, 1.0, mask)
	}

	// Inverts every color channel.
	def invert(target Raster, mask ?Mask = none) Raster {
		if mask is none {
			// Unmasked: xor eight pixels at a time, alpha lanes excluded.
			let w = int(target.size().width)
			let h = int(target.size().height)
			let stride = target.stride()
			let data = target.raw()
			let flip = simd.loadBytes32(rgbLanes, 0)
			for let y = 0; y < h; y++ {
				let row = y * stride
				let x = 0
				for x + 8 <= w {
					let o = row + x * 4
					simd.storeBytes32(data, o, simd.xor(simd.loadBytes32(data, o), flip))
					x += 8
				}
				for x < w {
					let o = row + x * 4
					data[o] = byte(255) - data[o]
					data[o + 1] = byte(255) - data[o + 1]
					data[o + 2] = byte(255) - data[o + 2]
					x++
				}
			}
			return target
		}
		return apply(target, 1.0, mask, px => color.RGBA{r: byte(255) - px.r, g: byte(255) - px.g, b: byte(255) - px.b, a: px.a})
	}

	// Reduces the image to at most `colors` colors by quantizing each channel
	// to the same number of levels (the cube root of `colors`, rounded up).
	def quantize(target Raster, @range(2, 16777216) colors int, mask ?Mask = none) Raster {
		let levels = 2
		for levels * levels * levels < colors {
			levels += 1
		}
		return posterize(target, levels, mask)
	}

	// Snaps each channel to `levels` evenly spaced values.
	def posterize(target Raster, @range(2, 256) levels int = 4, mask ?Mask = none) Raster {
		let n = levels
		n = 2 when n < 2
		let step = 255.0 / float(n - 1)
		return apply(target, 1.0, mask, px => color.RGBA{
				r: clampByte((float(px.r) / step).round() * step),
				g: clampByte((float(px.g) / step).round() * step),
				b: clampByte((float(px.b) / step).round() * step),
				a: px.a
			})
	}

	// Pulls every pixel towards `tone`.
	def tint(target Raster, tone color.Color, @range(0.0, 1.0) strength float, mask ?Mask = none) Raster {
		let t = tone.rgba
		return apply(target, strength.clamp(0.0, 1.0), mask, px => color.RGBA{r: t.r, g: t.g, b: t.b, a: px.a})
	}

	// Warms (positive) or cools (negative) the image.
	def temperature(target Raster, @range(-1.0, 1.0) strength float, mask ?Mask = none) Raster {
		let shift = strength.clamp(-1.0, 1.0) * 48.0
		return apply(target, 1.0, mask, px => color.RGBA{r: clampByte(float(px.r) + shift), g: px.g, b: clampByte(float(px.b) - shift), a: px.a})
	}

	// Brightens (positive) or darkens (negative) by up to two stops.
	def exposure(target Raster, @range(-1.0, 1.0) strength float, mask ?Mask = none) Raster {
		let factor = 2.0 ** (strength.clamp(-1.0, 1.0) * 2.0)
		return apply(target, 1.0, mask, px => color.RGBA{r: clampByte(float(px.r) * factor), g: clampByte(float(px.g) * factor), b: clampByte(float(px.b) * factor), a: px.a})
	}

	// The classic sepia tone.
	def sepia(target Raster, @range(0.0, 1.0) strength float = 1.0, mask ?Mask = none) Raster {
		return apply(target, strength.clamp(0.0, 1.0), mask, def (px color.RGBA) color.RGBA {
			let r = float(px.r)
			let g = float(px.g)
			let b = float(px.b)
			return color.RGBA{
				r: clampByte(0.393 * r + 0.769 * g + 0.189 * b),
				g: clampByte(0.349 * r + 0.686 * g + 0.168 * b),
				b: clampByte(0.272 * r + 0.534 * g + 0.131 * b),
				a: px.a
			}
		})
	}

	// Unsharp mask: adds `strength` times the difference from a 3x3 blur.
	def sharpen(target Raster, @range(0.0, 1.0) strength float, mask ?Mask = none) Raster {
		let amount = strength.clamp(0.0, 1.0) * 2.0
		return target when amount <= 0.0
		let soft = boxBlur3(target)
		let data = target.raw()
		let sharp = byte[]
		sharp.len(data.len())
		for let i = 0; i < data.len(); i++ {
			if i % 4 == 3 {
				sharp[i] = data[i]
				continue
			}
			sharp[i] = clampByte(float(data[i]) + amount * (float(data[i]) - float(soft[i])))
		}
		return blendBuffer(target, sharp, 1.0, mask)
	}

	// Applies gamma correction with exponent `strength` (1.0 is identity,
	// below brightens, above darkens).
	def gamma(target Raster, @range(0.1, 5.0) strength float, mask ?Mask = none) Raster {
		let g = strength
		g = 0.01 when g < 0.01
		return apply(target, 1.0, mask, px => color.RGBA{
				r: clampByte(255.0 * ((float(px.r) / 255.0) ** g)),
				g: clampByte(255.0 * ((float(px.g) / 255.0) ** g)),
				b: clampByte(255.0 * ((float(px.b) / 255.0) ** g)),
				a: px.a
			})
	}

	// Raises (positive) or lowers (negative) contrast around mid-gray.
	def contrast(target Raster, @range(-1.0, 1.0) strength float, mask ?Mask = none) Raster {
		let factor = 1.0 + strength.clamp(-1.0, 1.0)
		return apply(target, 1.0, mask, px => color.RGBA{
				r: clampByte((float(px.r) - 128.0) * factor + 128.0),
				g: clampByte((float(px.g) - 128.0) * factor + 128.0),
				b: clampByte((float(px.b) - 128.0) * factor + 128.0),
				a: px.a
			})
	}

	// Adds (positive) or removes (negative) up to a full channel range.
	def brightness(target Raster, @range(-1.0, 1.0) strength float, mask ?Mask = none) Raster {
		let shift = strength.clamp(-1.0, 1.0) * 255.0
		if mask is none {
			// Unmasked: saturating add/subtract, eight pixels at a time.
			let w = int(target.size().width)
			let h = int(target.size().height)
			let stride = target.stride()
			let data = target.raw()
			let delta = clampByte(shift.abs())
			let lanes = simd.loadBytes32(rgbSplat(delta), 0)
			let darken = shift < 0.0
			for let y = 0; y < h; y++ {
				let row = y * stride
				let x = 0
				for x + 8 <= w {
					let o = row + x * 4
					let v = simd.loadBytes32(data, o)
					if darken {
						simd.storeBytes32(data, o, simd.subSat(v, lanes))
					} else {
						simd.storeBytes32(data, o, simd.addSat(v, lanes))
					}
					x += 8
				}
				for x < w {
					let o = row + x * 4
					for let c = 0; c < 3; c++ {
						data[o + c] = clampByte(float(data[o + c]) + shift)
					}
					x++
				}
			}
			return target
		}
		return apply(target, 1.0, mask, px => color.RGBA{r: clampByte(float(px.r) + shift), g: clampByte(float(px.g) + shift), b: clampByte(float(px.b) + shift), a: px.a})
	}

	// Boosts (positive) or drains (negative) color away from gray.
	def saturation(target Raster, @range(-1.0, 1.0) strength float, mask ?Mask = none) Raster {
		let factor = 1.0 + strength.clamp(-1.0, 1.0)
		return apply(target, 1.0, mask, def (px color.RGBA) color.RGBA {
			let g = luma(px)
			return color.RGBA{
				r: clampByte(g + (float(px.r) - g) * factor),
				g: clampByte(g + (float(px.g) - g) * factor),
				b: clampByte(g + (float(px.b) - g) * factor),
				a: px.a
			}
		})
	}

	// Rotates hue by `strength` turns (0.5 is 180 degrees).
	def hue(target Raster, @range(-1.0, 1.0) strength float, mask ?Mask = none) Raster {
		let shift = int((strength * 360.0).round()) % 360
		shift += 360 when shift < 0
		return target when shift == 0
		return apply(target, 1.0, mask, def (px color.RGBA) color.RGBA {
			let c = new color.Color(px)
			let hsl = c.hsl
			hsl.h = uint16((int(hsl.h) + shift) % 360)
			c.hsl = hsl
			let out = c.rgba
			out.a = px.a
			return out
		})
	}

	// Black below `strength` (0.0 to 1.0 of full luminance), white at or above.
	def threshold(target Raster, @range(0.0, 1.0) strength float, mask ?Mask = none) Raster {
		let cut = strength.clamp(0.0, 1.0) * 255.0
		return apply(target, 1.0, mask, def (px color.RGBA) color.RGBA {
			let v = byte(0)
			v = byte(255) when luma(px) >= cut
			return color.RGBA{r: v, g: v, b: v, a: px.a}
		})
	}

	// Replaces every pixel with `fn(pixel)`.
	def mapPixel(target Raster, fn def(color.Color) color.Color, mask ?Mask = none) Raster {
		let w = int(target.size().width)
		let h = int(target.size().height)
		let stride = target.stride()
		let data = target.raw()
		for let y = 0; y < h; y++ {
			let row = y * stride
			for let x = 0; x < w; x++ {
				let t = coverageAt(mask, x, y)
				continue when t <= 0.0
				let o = row + x * 4
				let src = color.RGBA{r: data[o], g: data[o + 1], b: data[o + 2], a: data[o + 3]}
				let dst = fn(new color.Color(src)).rgba
				data[o] = mixByte(src.r, dst.r, t)
				data[o + 1] = mixByte(src.g, dst.g, t)
				data[o + 2] = mixByte(src.b, dst.b, t)
				data[o + 3] = mixByte(src.a, dst.a, t)
			}
		}
		return target
	}

	// Replaces every pixel matching `from` with `to`. A pixel matches when
	// each of its red, green and blue channels is within `tolerance` of
	// `from`; alpha is not compared, and the replacement carries `to`'s alpha.
	def replaceColor(target Raster, from, to color.Color, tolerance int = 0, mask ?Mask = none) Raster {
		let f = from.rgba
		let t = to.rgba
		let tol = tolerance
		tol = 0 when tol < 0
		return apply(target, 1.0, mask, def (px color.RGBA) color.RGBA {
			let dr = int(px.r) - int(f.r)
			let dg = int(px.g) - int(f.g)
			let db = int(px.b) - int(f.b)
			return px when dr.abs() > tol || dg.abs() > tol || db.abs() > tol
			return t
		})
	}

	// Blends `buffer` (same layout as the raster) into the raster by
	// `strength * coverage`.
	internal def blendBuffer(target Raster, buffer byte[], strength float, mask ?Mask) Raster {
		let w = int(target.size().width)
		let h = int(target.size().height)
		let stride = target.stride()
		let data = target.raw()
		if mask is none && strength >= 1.0 {
			mem.copyN(data, buffer, data.len())
			return target
		}
		for let y = 0; y < h; y++ {
			let row = y * stride
			for let x = 0; x < w; x++ {
				let t = strength * coverageAt(mask, x, y)
				continue when t <= 0.0
				let o = row + x * 4
				for let c = 0; c < 4; c++ {
					data[o + c] = mixByte(data[o + c], buffer[o + c], t)
				}
			}
		}
		return target
	}

	// A separable Gaussian blur of the raster into a new buffer.
	// Normalised Gaussian weights over -3 sigma..3 sigma, one per pixel.
	internal def gaussianWeights(sigma float) float[] {
		let radius = int((sigma * 3.0).ceil())
		let kernel float[]
		kernel.len(2 * radius + 1)
		let total = 0.0
		for let i = -radius; i <= radius; i++ {
			let v = 2.718281828459045 ** (-(float(i) * float(i)) / (2.0 * sigma * sigma))
			kernel[i + radius] = v
			total += v
		}
		for let i = 0; i < kernel.len(); i++ {
			kernel[i] /= total
		}
		return kernel
	}

	// The blurred pixels of `target`: on the GPU when one is in use (see
	// filters_gpu.adm), otherwise two separable passes here.
	internal def gaussian(target Raster, sigma float) byte[] {
		let fast = gaussianOnDevice(target, sigma)
		if !(fast is none) {
			return fast
		}
		return gaussianCPU(target, sigma)
	}

	// The two separable passes on the CPU.
	internal def gaussianCPU(target Raster, sigma float) byte[] {
		let w = int(target.size().width)
		let h = int(target.size().height)
		let stride = target.stride()
		let data = target.raw()
		let kernel = gaussianWeights(sigma)
		let radius = kernel.len() / 2

		let tmp = byte[]
		tmp.len(data.len())
		for let y = 0; y < h; y++ {
			let row = y * stride
			for let x = 0; x < w; x++ {
				for let c = 0; c < 4; c++ {
					let acc = 0.0
					for let k = -radius; k <= radius; k++ {
						let sx = (x + k).clamp(0, w - 1)
						acc += float(data[row + sx * 4 + c]) * kernel[k + radius]
					}
					tmp[row + x * 4 + c] = clampByte(acc)
				}
			}
		}
		let out = byte[]
		out.len(data.len())
		for let y = 0; y < h; y++ {
			for let x = 0; x < w; x++ {
				for let c = 0; c < 4; c++ {
					let acc = 0.0
					for let k = -radius; k <= radius; k++ {
						let sy = (y + k).clamp(0, h - 1)
						acc += float(tmp[sy * stride + x * 4 + c]) * kernel[k + radius]
					}
					out[y * stride + x * 4 + c] = clampByte(acc)
				}
			}
		}
		return out
	}

	// A 3x3 box blur of the raster into a new buffer (edges clamp).
	internal def boxBlur3(target Raster) byte[] {
		let w = int(target.size().width)
		let h = int(target.size().height)
		let stride = target.stride()
		let data = target.raw()
		let out = byte[]
		out.len(data.len())
		for let y = 0; y < h; y++ {
			for let x = 0; x < w; x++ {
				for let c = 0; c < 4; c++ {
					let acc = 0
					for let dy = -1; dy <= 1; dy++ {
						let sy = (y + dy).clamp(0, h - 1)
						for let dx = -1; dx <= 1; dx++ {
							let sx = (x + dx).clamp(0, w - 1)
							acc += int(data[sy * stride + sx * 4 + c])
						}
					}
					out[y * stride + x * 4 + c] = byte(acc / 9)
				}
			}
		}
		return out
	}
}
