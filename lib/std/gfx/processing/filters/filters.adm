partial module std.gfx.processing.filters {
	use (
		std.gfx
		std.gfx::(Raster, Mask)
		std.gfx.color
		std.gfx.colorspace
		std.simd
		std.mem
		std.gfx.bands::*
		std.gfx.processing.filters.kernels::*
		std.gfx.processing.filters.kernels::*
	)

	// Every filter edits `target` in place and returns it, so calls nest;
	// `processing.Pipeline` chains them. With a `mask`, a pixel's effect is
	// scaled by the mask's coverage there; none means the whole raster.
	//
	// Strength conventions: one-way effects (grayscale, blur, sepia, ...)
	// take 0.0 (untouched) to 1.0 (full); adjustments with a natural opposite
	// (exposure, temperature, contrast, ...) take -1.0 to 1.0 with 0.0 as
	// identity. Out-of-range strengths are clamped.

	// Converts to shades of gray.
	def grayscale(target Raster, @range(0.0, 1.0) strength float = 1.0, mask ?Mask = none) Raster {
		return colorKernel(target, ColorOp.Matrix, lumaColumns(), float64(0), float64(0), strength.clamp(0.0, 1.0)) when mask is none
		return apply(target, strength.clamp(0.0, 1.0), mask, def (px color.RGBA) color.RGBA {
			let g = clampByte(luma(px))
			return color.RGBA{r: g, g: g, b: g, a: px.a}
		})
	}

	// Scales every pixel's alpha by `strength`.
	def opacity(target Raster, @range(0.0, 1.0) strength float, mask ?Mask = none) Raster {
		let factor = strength.clamp(0.0, 1.0)
		let tables byte[]
		tables.len(1024)
		for let i = 0; i < 1024; i++ {
			tables[i] = i < 768 ?? (byte(i % 256), clampByte(float(i - 768) * factor))
		}
		return applyTables(target, tables, 1.0, mask)
	}

	// Gaussian blur; `strength` 1.0 is a sigma of eight pixels.
	def blur(target Raster, @range(0.0, 1.0) strength float, mask ?Mask = none) Raster {
		let sigma = strength.clamp(0.0, 1.0) * 8.0
		return target when sigma <= 0.0
		let blurred = gaussian(target, sigma)
		return blendBuffer(target, blurred, 1.0, mask)
	}

	// Inverts every color channel.
	def invert(target Raster, mask ?Mask = none) Raster {
		if mask is none {
			// Unmasked: xor eight pixels at a time, alpha lanes excluded.
			let w = int(target.size().width)
			let h = int(target.size().height)
			let stride = target.stride()
			let data = target.raw()
			let flip = simd.loadBytes32(rgbLanes, 0)
			for let y = 0; y < h; y++ {
				let row = y * stride
				let x = 0
				for x + 8 <= w {
					let o = row + x * 4
					simd.storeBytes32(data, o, simd.xor(simd.loadBytes32(data, o), flip))
					x += 8
				}
				for x < w {
					let o = row + x * 4
					data[o] = byte(255) - data[o]
					data[o + 1] = byte(255) - data[o + 1]
					data[o + 2] = byte(255) - data[o + 2]
					x++
				}
			}
			return target
		}
		return apply(target, 1.0, mask, px => color.RGBA{r: byte(255) - px.r, g: byte(255) - px.g, b: byte(255) - px.b, a: px.a})
	}

	// Reduces the image to at most `colors` colors by quantizing each channel
	// to the same number of levels (the cube root of `colors`, rounded up).
	def quantize(target Raster, @range(2, 16777216) colors int, mask ?Mask = none) Raster {
		let levels = 2
		for levels * levels * levels < colors {
			levels += 1
		}
		return posterize(target, levels, mask)
	}

	// Snaps each channel to `levels` evenly spaced values.
	def posterize(target Raster, @range(2, 256) levels int = 4, mask ?Mask = none) Raster {
		let n = levels
		n = 2 when n < 2
		let step = 255.0 / float(n - 1)
		return applyTables(target, colorTables((c int, v int) => clampByte((float(v) / step).round() * step)), 1.0, mask)
	}

	// Pulls every pixel towards `tone`.
	def tint(target Raster, tone color.Color, @range(0.0, 1.0) strength float, mask ?Mask = none) Raster {
		let t = tone.rgba
		let channels = byte[t.r, t.g, t.b]
		return applyTables(target, colorTables((c int, v int) => channels[c]), strength.clamp(0.0, 1.0), mask)
	}

	// Warms (positive) or cools (negative) the image.
	def temperature(target Raster, @range(-1.0, 1.0) strength float, mask ?Mask = none) Raster {
		let shift = strength.clamp(-1.0, 1.0) * 48.0
		return applyTables(target, colorTables(def (c int, v int) byte {
			return clampByte(float(v) + shift) when c == 0
			return clampByte(float(v) - shift) when c == 2
			return byte(v)
		}), 1.0, mask)
	}

	// Brightens (positive) or darkens (negative) by up to two stops.
	def exposure(target Raster, @range(-1.0, 1.0) strength float, mask ?Mask = none) Raster {
		let factor = 2.0 ** (strength.clamp(-1.0, 1.0) * 2.0)
		return applyTables(target, colorTables((c int, v int) => clampByte(float(v) * factor)), 1.0, mask)
	}

	// The classic sepia tone.
	def sepia(target Raster, @range(0.0, 1.0) strength float = 1.0, mask ?Mask = none) Raster {
		let columns = float64[
			0.393, 0.349, 0.272, 0.0,
			0.769, 0.686, 0.534, 0.0,
			0.189, 0.168, 0.131, 0.0
		]
		return colorKernel(target, ColorOp.Matrix, columns, float64(0), float64(0), strength.clamp(0.0, 1.0)) when mask is none
		return apply(target, strength.clamp(0.0, 1.0), mask, def (px color.RGBA) color.RGBA {
			let r = float(px.r)
			let g = float(px.g)
			let b = float(px.b)
			return color.RGBA{
				r: clampByte(0.393 * r + 0.769 * g + 0.189 * b),
				g: clampByte(0.349 * r + 0.686 * g + 0.168 * b),
				b: clampByte(0.272 * r + 0.534 * g + 0.131 * b),
				a: px.a
			}
		})
	}

	// Unsharp mask: adds `strength` times the difference from a 3x3 blur.
	def sharpen(target Raster, @range(0.0, 1.0) strength float, mask ?Mask = none) Raster {
		let amount = strength.clamp(0.0, 1.0) * 2.0
		return target when amount <= 0.0
		return blendBuffer(target, sharpenBuffer(target, amount), 1.0, mask)
	}

	// Applies gamma correction with exponent `strength` (1.0 is identity,
	// below brightens, above darkens).
	def gamma(target Raster, @range(0.1, 5.0) strength float, mask ?Mask = none) Raster {
		let g = strength
		g = 0.01 when g < 0.01
		return applyTables(target, colorTables((c int, v int) => clampByte(255.0 * ((float(v) / 255.0) ** g))), 1.0, mask)
	}

	// Raises (positive) or lowers (negative) contrast around mid-gray.
	def contrast(target Raster, @range(-1.0, 1.0) strength float, mask ?Mask = none) Raster {
		let factor = 1.0 + strength.clamp(-1.0, 1.0)
		return applyTables(target, colorTables((c int, v int) => clampByte((float(v) - 128.0) * factor + 128.0)), 1.0, mask)
	}

	// Adds (positive) or removes (negative) up to a full channel range.
	def brightness(target Raster, @range(-1.0, 1.0) strength float, mask ?Mask = none) Raster {
		let shift = strength.clamp(-1.0, 1.0) * 255.0
		if mask is none {
			// Unmasked: saturating add/subtract, eight pixels at a time.
			let w = int(target.size().width)
			let h = int(target.size().height)
			let stride = target.stride()
			let data = target.raw()
			let delta = clampByte(shift.abs())
			let lanes = simd.loadBytes32(rgbSplat(delta), 0)
			let darken = shift < 0.0
			for let y = 0; y < h; y++ {
				let row = y * stride
				let x = 0
				for x + 8 <= w {
					let o = row + x * 4
					let v = simd.loadBytes32(data, o)
					if darken {
						simd.storeBytes32(data, o, simd.subSat(v, lanes))
					} else {
						simd.storeBytes32(data, o, simd.addSat(v, lanes))
					}
					x += 8
				}
				for x < w {
					let o = row + x * 4
					for let c = 0; c < 3; c++ {
						data[o + c] = clampByte(float(data[o + c]) + shift)
					}
					x++
				}
			}
			return target
		}
		return applyTables(target, colorTables((c int, v int) => clampByte(float(v) + shift)), 1.0, mask)
	}

	// Boosts (positive) or drains (negative) color away from gray.
	def saturation(target Raster, @range(-1.0, 1.0) strength float, mask ?Mask = none) Raster {
		let factor = 1.0 + strength.clamp(-1.0, 1.0)
		return colorKernel(target, ColorOp.Saturate, lumaColumns(), float64(factor), float64(0), 1.0) when mask is none
		return apply(target, 1.0, mask, def (px color.RGBA) color.RGBA {
			let g = luma(px)
			return color.RGBA{
				r: clampByte(g + (float(px.r) - g) * factor),
				g: clampByte(g + (float(px.g) - g) * factor),
				b: clampByte(g + (float(px.b) - g) * factor),
				a: px.a
			}
		})
	}

	// Rotates hue by `strength` turns (0.5 is 180 degrees).
	def hue(target Raster, @range(-1.0, 1.0) strength float, mask ?Mask = none) Raster {
		let shift = int((strength * 360.0).round()) % 360
		shift += 360 when shift < 0
		return target when shift == 0
		if mask is none {
			let w = int(target.size().width)
			let data = target.raw()
			let stride = target.stride()
			forRows(w, int(target.size().height), def (from int, to int) {
				for let y = from; y < to; y++ {
					let o = y * stride
					let end = o + w * 4
					for o < end {
						let (r, g, b) = colorspace.rotateHue(data[o], data[o + 1], data[o + 2], shift)
						data[o] = r
						data[o + 1] = g
						data[o + 2] = b
						o += 4
					}
				}
			})
			return target
		}
		return apply(target, 1.0, mask, def (px color.RGBA) color.RGBA {
			let (r, g, b) = colorspace.rotateHue(px.r, px.g, px.b, shift)
			return color.RGBA{r: r, g: g, b: b, a: px.a}
		})
	}

	// Black below `strength` (0.0 to 1.0 of full luminance), white at or above.
	def threshold(target Raster, @range(0.0, 1.0) strength float, mask ?Mask = none) Raster {
		let cut = strength.clamp(0.0, 1.0) * 255.0
		return colorKernel(target, ColorOp.Threshold, lumaColumns(), float64(0), float64(cut), 1.0) when mask is none
		return apply(target, 1.0, mask, def (px color.RGBA) color.RGBA {
			let v = byte(0)
			v = byte(255) when luma(px) >= cut
			return color.RGBA{r: v, g: v, b: v, a: px.a}
		})
	}

	// Replaces every pixel with `fn(pixel)`.
	def mapPixel(target Raster, fn def(color.Color) color.Color, mask ?Mask = none) Raster {
		let w = int(target.size().width)
		let h = int(target.size().height)
		let stride = target.stride()
		let data = target.raw()
		let cover float32[]
		cover.len(w)
		for let y = 0; y < h; y++ {
			let row = y * stride
			coverageRowAt(mask, y, cover)
			for let x = 0; x < w; x++ {
				let t = float(cover[x])
				continue when t <= 0.0
				let o = row + x * 4
				let src = color.RGBA{r: data[o], g: data[o + 1], b: data[o + 2], a: data[o + 3]}
				let dst = fn(new color.Color(src)).rgba
				data[o] = mixByte(src.r, dst.r, t)
				data[o + 1] = mixByte(src.g, dst.g, t)
				data[o + 2] = mixByte(src.b, dst.b, t)
				data[o + 3] = mixByte(src.a, dst.a, t)
			}
		}
		return target
	}

	// Replaces every pixel matching `from` with `to`. A pixel matches when
	// each of its red, green and blue channels is within `tolerance` of
	// `from`; alpha is not compared, and the replacement carries `to`'s alpha.
	def replaceColor(target Raster, from, to color.Color, tolerance int = 0, mask ?Mask = none) Raster {
		let f = from.rgba
		let t = to.rgba
		let tol = tolerance
		tol = 0 when tol < 0
		if mask is none {
			let w = int(target.size().width)
			let data = target.raw()
			let stride = target.stride()
			forRows(w, int(target.size().height), def (from int, to int) {
				for let y = from; y < to; y++ {
					let o = y * stride
					let end = o + w * 4
					for o < end {
						let near = (int(data[o]) - int(f.r)).abs() <= tol && (int(data[o + 1]) - int(f.g)).abs() <= tol && (int(data[o + 2]) - int(f.b)).abs() <= tol
						if near {
							data[o] = t.r
							data[o + 1] = t.g
							data[o + 2] = t.b
							data[o + 3] = t.a
						}
						o += 4
					}
				}
			})
			return target
		}
		return apply(target, 1.0, mask, def (px color.RGBA) color.RGBA {
			let dr = int(px.r) - int(f.r)
			let dg = int(px.g) - int(f.g)
			let db = int(px.b) - int(f.b)
			return px when dr.abs() > tol || dg.abs() > tol || db.abs() > tol
			return t
		})
	}
}

internal partial module std.gfx.processing.filters.kernels {
	use (
		std.gfx
		std.gfx.processing.filters::*
		std.gfx::(Raster, Mask)
		std.gfx.color
		std.gfx.colorspace
		std.simd
		std.mem
		std.gfx.bands::*
		std.gfx.processing.filters.kernels::*
	)

	// Eight RGBA pixels: all ones on the color lanes, zero on alpha.
	const rgbLanes = byte[
		255, 255, 255, 0, 255, 255, 255, 0, 255, 255, 255, 0, 255, 255, 255, 0,
		255, 255, 255, 0, 255, 255, 255, 0, 255, 255, 255, 0, 255, 255, 255, 0
	]

	// Eight RGBA pixels with `v` on the color lanes and zero on alpha.
	def rgbSplat(v byte) byte[] {
		let out = byte[]
		out.len(32)
		for let i = 0; i < 32; i++ {
			out[i] = v
			out[i] = byte(0) when i % 4 == 3
		}
		return out
	}

	// Runs `fn` over every pixel and blends the result in by
	// `strength * coverage`.
	def apply(target Raster, strength float, mask ?Mask, fn def(color.RGBA) color.RGBA) Raster {
		let w = int(target.size().width)
		let h = int(target.size().height)
		let stride = target.stride()
		let data = target.raw()

		let cover float32[]
		cover.len(w)
		for let y = 0; y < h; y++ {
			let row = y * stride
			coverageRowAt(mask, y, cover)
			for let x = 0; x < w; x++ {
				let t = strength * float(cover[x])
				continue when t <= 0.0
				let o = row + x * 4
				let src = color.RGBA{r: data[o], g: data[o + 1], b: data[o + 2], a: data[o + 3]}
				let dst = fn(src)
				if t >= 1.0 {
					data[o] = dst.r
					data[o + 1] = dst.g
					data[o + 2] = dst.b
					data[o + 3] = dst.a
					continue
				}
				data[o] = mixByte(src.r, dst.r, t)
				data[o + 1] = mixByte(src.g, dst.g, t)
				data[o + 2] = mixByte(src.b, dst.b, t)
				data[o + 3] = mixByte(src.a, dst.a, t)
			}
		}
		return target
	}

	// The mask's coverage along row y from x = 0 into `out`; no mask
	// covers everything.
	def coverageRowAt(mask ?Mask, y int, out float32[]) {
		if mask is none {
			for let i = 0; i < out.len(); i++ {
				out[i] = float32(1.0)
			}
			return
		}
		gfx.coverageRow(mask, 0, y, out)
	}

	// The mask's coverage at a pixel; no mask covers everything.
	def coverageAt(mask ?Mask, x, y int) float {
		return 1.0 when mask is none
		return mask.coverage(x, y)
	}

	def mixByte(a byte, b byte, t float) byte {
		return byte((float(a) + (float(b) - float(a)) * t).round())
	}

	def clampByte(v float) byte {
		return byte(v.round().clamp(0.0, 255.0))
	}

	def luma(px color.RGBA) float {
		return 0.299 * float(px.r) + 0.587 * float(px.g) + 0.114 * float(px.b)
	}

	// Blends `buffer` (same layout as the raster) into the raster by
	// `strength * coverage`.
	def blendBuffer(target Raster, buffer byte[], strength float, mask ?Mask) Raster {
		let w = int(target.size().width)
		let h = int(target.size().height)
		let stride = target.stride()
		let data = target.raw()
		if mask is none && strength >= 1.0 {
			mem.copyN(data, buffer, data.len())
			return target
		}
		let cover float32[]
		cover.len(w)
		for let y = 0; y < h; y++ {
			let row = y * stride
			coverageRowAt(mask, y, cover)
			for let x = 0; x < w; x++ {
				let t = strength * float(cover[x])
				continue when t <= 0.0
				let o = row + x * 4
				for let c = 0; c < 4; c++ {
					data[o + c] = mixByte(data[o + c], buffer[o + c], t)
				}
			}
		}
		return target
	}

	// A separable Gaussian blur of the raster into a new buffer.
	// Normalised Gaussian weights over -3 sigma..3 sigma, one per pixel.
	def gaussianWeights(sigma float) float[] {
		let radius = int((sigma * 3.0).ceil())
		let kernel float[]
		kernel.len(2 * radius + 1)
		let total = 0.0
		for let i = -radius; i <= radius; i++ {
			let v = 2.718281828459045 ** (-(float(i) * float(i)) / (2.0 * sigma * sigma))
			kernel[i + radius] = v
			total += v
		}
		for let i = 0; i < kernel.len(); i++ {
			kernel[i] /= total
		}
		return kernel
	}

	// The blurred pixels of `target`: on the GPU when one is in use (see
	// filters_gpu.adm), otherwise two separable passes here.
	def gaussian(target Raster, sigma float) byte[] {
		let fast = gaussianOnDevice(target, sigma)
		if !(fast is none) {
			return fast
		}
		return gaussianCPU(target, sigma)
	}

	// The two separable passes on the CPU, rounded to bytes between them as
	// on the GPU. Both run eight channel values a lane with the kernel's
	// mirrored taps paired: across a row a tap is a load one pixel further
	// along an edge-padded copy of it, down the image a load from another
	// row. Bands of rows go to tasks.
	def gaussianCPU(target Raster, sigma float) byte[] {
		let w = int(target.size().width)
		let h = int(target.size().height)
		let stride = target.stride()
		let data = target.raw()
		let kernel = gaussianWeights(sigma)
		let radius = kernel.len() / 2
		// The centre tap, then the pairs at distance 1..radius.
		let taps float32[]
		for let k = 0; k <= radius; k++ {
			taps.push(float32(kernel[radius + k]))
		}
		let tmp = byte[]
		tmp.len(data.len())
		let out = byte[]
		out.len(data.len())
		return out when w == 0 || h == 0
		let tasks = (w * h * (radius + 1) / blurBandWork).clamp(1, blurMaxTasks).min(h)
		for let pass = 0; pass < 2; pass++ {
			let src = pass == 0 ?? (data, tmp)
			let dst = pass == 0 ?? (tmp, out)
			if tasks == 1 {
				blurPass(src, dst, w, h, stride, taps, pass == 1, 0, h)
				continue
			}
			let done = new channel<bool>(size = tasks)
			for let t = 0; t < tasks; t++ {
				async blurPassTask(src, dst, w, h, stride, taps, pass == 1, h * t / tasks, h * (t + 1) / tasks, done)
			}
			for let t = 0; t < tasks; t++ {
				<-done
			}
		}
		return out
	}

	// Pixels times taps (at least) per task a blur pass hands out, and the
	// most tasks.
	const blurBandWork = 262144

	const blurMaxTasks = 16

	async def blurPassTask(src byte[], dst byte[], w int, h int, stride int, taps float32[], vertical bool, from int, to int, done channel<bool>) {
		blurPass(src, dst, w, h, stride, taps, vertical, from, to)
		done <- true
	}

	// Rows `from` up to `to` of one pass: across the rows, or down the
	// columns when `vertical`. Edges clamp; results round to bytes.
	def blurPass(src byte[], dst byte[], w int, h int, stride int, taps float32[], vertical bool, from int, to int) {
		let radius = taps.len() - 1
		let n = w * 4
		let half = simd.splat8<float32>(float32(0.5))
		let lo = simd.splat8<float32>(float32(0))
		let hi = simd.splat8<float32>(float32(255))
		// Across: the row as floats with `radius` copies of its edge pixels
		// on each side. Down: the offsets of the rows each tap reads.
		let padded float32[]
		padded.len((w + 2 * radius) * 4)
		let above int[]
		above.len(radius + 1)
		let below int[]
		below.len(radius + 1)
		for let y = from; y < to; y++ {
			let row = y * stride
			if vertical {
				for let k = 1; k <= radius; k++ {
					above[k] = (y - k).max(0) * stride
					below[k] = (y + k).min(h - 1) * stride
				}
			} else {
				let x = 0
				for x + 8 <= n {
					simd.store8<float32>(padded, radius * 4 + x, simd.convert<byte, float32>(simd.load8<byte>(src, row + x)))
					x += 8
				}
				for x < n {
					padded[radius * 4 + x] = float32(src[row + x])
					x++
				}
				for let k = 0; k < radius; k++ {
					for let c = 0; c < 4; c++ {
						padded[k * 4 + c] = float32(src[row + c])
						padded[(radius + w + k) * 4 + c] = float32(src[row + (w - 1) * 4 + c])
					}
				}
			}
			let x = 0
			for x + 8 <= n {
				let acc = simd.splat8<float32>(float32(0))
				if vertical {
					acc = simd.convert<byte, float32>(simd.load8<byte>(src, row + x)) * simd.splat8<float32>(taps[0])
					for let k = 1; k <= radius; k++ {
						let pair = simd.convert<byte, float32>(simd.load8<byte>(src, above[k] + x)) + simd.convert<byte, float32>(simd.load8<byte>(src, below[k] + x))
						acc = pair.fma(simd.splat8<float32>(taps[k]), acc)
					}
				} else {
					let c = radius * 4 + x
					acc = simd.load8<float32>(padded, c) * simd.splat8<float32>(taps[0])
					for let k = 1; k <= radius; k++ {
						let pair = simd.load8<float32>(padded, c - k * 4) + simd.load8<float32>(padded, c + k * 4)
						acc = pair.fma(simd.splat8<float32>(taps[k]), acc)
					}
				}
				simd.store8<byte>(dst, row + x, simd.convert<float32, byte>((acc.clamp(lo, hi) + half).floor()))
				x += 8
			}
			for x < n {
				let acc = float32(0)
				if vertical {
					acc = float32(src[row + x]) * taps[0]
					for let k = 1; k <= radius; k++ {
						acc += (float32(src[above[k] + x]) + float32(src[below[k] + x])) * taps[k]
					}
				} else {
					let c = radius * 4 + x
					acc = padded[c] * taps[0]
					for let k = 1; k <= radius; k++ {
						acc += (padded[c - k * 4] + padded[c + k * 4]) * taps[k]
					}
				}
				dst[row + x] = byte((float(acc).clamp(0.0, 255.0) + 0.5).floor())
				x++
			}
		}
	}
}
