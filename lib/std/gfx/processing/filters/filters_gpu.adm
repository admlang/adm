partial module std.gfx.processing.filters {
	use (
		std.gfx::(Raster)
		std.gpu
	)

	// The Gaussian blur on the GPU: the same separable pass as `gaussian`,
	// one thread per pixel, the image resident on the device between the
	// two passes. Edges clamp like the CPU pass; weights are float32 so a
	// channel may differ by one from the CPU result.

	// Horizontal pass: dst(x, y) = sum of src(x + k, y) * weights[k + radius].
	@launch(x = "w", y = "h")
	cuda def blurRows(src gpu.DeviceBuffer<byte>, dst gpu.DeviceBuffer<byte>, w, h, stride int, weights float32[], radius int) !none {
		int64_t x = blockIdx.x * blockDim.x + threadIdx.x;
		int64_t y = blockIdx.y * blockDim.y + threadIdx.y;
		if (x >= w || y >= h) return;
		int64_t row = y * stride;
		for (int c = 0; c < 4; c++) {
			float acc = 0.0f;
			for (int64_t k = -radius; k <= radius; k++) {
				int64_t sx = x + k;
				if (sx < 0) sx = 0;
				if (sx >= w) sx = w - 1;
				acc += (float)src[row + sx * 4 + c] * weights[k + radius];
			}
			int v = (int)(acc + 0.5f);
			if (v < 0) v = 0;
			if (v > 255) v = 255;
			dst[row + x * 4 + c] = (uint8_t)v;
		}
	}

	// Vertical pass: dst(x, y) = sum of src(x, y + k) * weights[k + radius].
	@launch(x = "w", y = "h")
	cuda def blurColumns(src gpu.DeviceBuffer<byte>, dst gpu.DeviceBuffer<byte>, w, h, stride int, weights float32[], radius int) !none {
		int64_t x = blockIdx.x * blockDim.x + threadIdx.x;
		int64_t y = blockIdx.y * blockDim.y + threadIdx.y;
		if (x >= w || y >= h) return;
		for (int c = 0; c < 4; c++) {
			float acc = 0.0f;
			for (int64_t k = -radius; k <= radius; k++) {
				int64_t sy = y + k;
				if (sy < 0) sy = 0;
				if (sy >= h) sy = h - 1;
				acc += (float)src[sy * stride + x * 4 + c] * weights[k + radius];
			}
			int v = (int)(acc + 0.5f);
			if (v < 0) v = 0;
			if (v > 255) v = 255;
			dst[y * stride + x * 4 + c] = (uint8_t)v;
		}
	}

	// The blurred pixels of `target` computed on the GPU, or none when no
	// GPU is in use or a launch fails (the caller then blurs on the CPU).
	internal def gaussianOnDevice(target Raster, sigma float) ?byte[] {
		return none unless gpu.available()
		let w = int(target.size().width)
		let h = int(target.size().height)
		let stride = target.stride()
		let data = target.raw()
		let kernel = gaussianWeights(sigma)
		let radius = kernel.len() / 2
		let weights float32[]
		weights.len(kernel.len())
		for let i = 0; i < kernel.len(); i++ {
			weights[i] = float32(kernel[i])
		}
		let out = byte[]
		out.len(data.len())
		let ok = blurOnDevice(data, out, w, h, stride, weights, radius) onerror (err error) {
			recover false
		}
		return none unless ok
		return out
	}

	// Uploads the pixels once, runs both passes on resident buffers and
	// downloads the result into `out`.
	internal def blurOnDevice(data, out byte[], w, h, stride int, weights float32[], radius int) !bool {
		let pixels = try gpu.upload(data)
		let scratch = try gpu.upload(out)
		try blurRows(pixels, scratch, w, h, stride, weights, radius)
		try blurColumns(scratch, pixels, w, h, stride, weights, radius)
		try pixels.download(out)
		scratch.dispose()
		pixels.dispose()
		return true
	}
}
