partial module std.gfx.processing.filters {
	use (
		std.testing
		std.gfx
		std.gfx.color
		std.gfx.processing
		std.formats.image
		std.gpu
		std.math.geom
	)

	// A 4x2 image: left half solid red, right half solid blue, all opaque.
	internal def halves() image.Image {
		let img = new image.Image(4, 2)
		let px = img.raw()
		for let y = 0; y < 2; y++ {
			for let x = 0; x < 4; x++ {
				let o = img.pixelOffset(x, y)
				px[o] = byte(255) when x < 2
				px[o + 2] = byte(255) when x >= 2
				px[o + 3] = byte(255)
			}
		}
		return img
	}

	check "Filters" {
		@test()
		def grayscale_uses_luma() {
			let img = halves()
			grayscale(img)
			let px = img.raw()
			// Red: 0.299 * 255 = 76; blue: 0.114 * 255 = 29.
			assert int(px[0]) == 76 && int(px[1]) == 76 && int(px[2]) == 76
			let o = img.pixelOffset(3, 1)
			assert int(px[o]) == 29 && int(px[o + 1]) == 29
			assert int(px[o + 3]) == 255
		}

		@test()
		def half_strength_blends() {
			let img = halves()
			grayscale(img, 0.5)
			let px = img.raw()
			// Red channel of a red pixel: halfway from 255 to 76.
			assert int(px[0]) == 166
		}

		@test()
		def mask_limits_the_effect() {
			let img = halves()
			// Only the right half is covered.
			let mask = new gfx.RectangleMask(new geom.Rectangle(position = new geom.Point(2.0, 0.0), size = new geom.Size(2.0, 2.0)))
			mask.antialias = false
			invert(img, mask)
			let px = img.raw()
			// Left half untouched (red), right half inverted (blue -> yellow).
			assert int(px[0]) == 255 && int(px[2]) == 0
			let o = img.pixelOffset(3, 0)
			assert int(px[o]) == 255 && int(px[o + 1]) == 255 && int(px[o + 2]) == 0
		}

		@test()
		def image_as_mask() {
			let img = halves()
			// A mask image: white on the left column only.
			let m = new image.Image(4, 2)
			let mp = m.raw()
			for let y = 0; y < 2; y++ {
				let o = m.pixelOffset(0, y)
				mp[o] = byte(255)
				mp[o + 1] = byte(255)
				mp[o + 2] = byte(255)
				mp[o + 3] = byte(255)
			}
			invert(img, m)
			let px = img.raw()
			assert int(px[0]) == 0 && int(px[1]) == 255 // inverted red -> cyan
			assert int(px[4]) == 255 && int(px[5]) == 0 // x = 1 untouched
		}

		@test()
		def threshold_and_opacity() {
			let img = halves()
			threshold(img, 0.2)
			let px = img.raw()
			assert int(px[0]) == 255 // red luma 76 >= 51
			let o = img.pixelOffset(3, 0)
			assert int(px[o]) == 0 // blue luma 29 < 51
			opacity(img, 0.5)
			assert int(img.raw()[3]) == 128
		}

		@test()
		def adjustments_move_the_expected_way() {
			let img = halves()
			brightness(img, 0.5)
			assert int(img.raw()[1]) == 128
			let img2 = halves()
			exposure(img2, -1.0)
			assert int(img2.raw()[0]) == 64
			let img3 = halves()
			temperature(img3, 1.0)
			let o = img3.pixelOffset(3, 0)
			assert int(img3.raw()[o + 2]) == 207
			let img4 = halves()
			saturation(img4, -1.0)
			assert int(img4.raw()[0]) == int(img4.raw()[1])
		}

		@test()
		def pipeline_chains() {
			let img = halves()
			let pipe = new processing.Pipeline(img)
			let out = pipe.invert().grayscale().raster()
			// Inverted red is cyan (0,255,255): luma 179.
			assert int(img.raw()[0]) == 179
			assert int(out.size().width) == 4
		}

		@test()
		def blur_spreads_and_keeps_alpha() {
			let img = halves()
			blur(img, 0.25)
			let px = img.raw()
			// The seam pixels now carry some of both colors.
			let o = img.pixelOffset(1, 0)
			assert int(px[o]) < 255 && int(px[o + 2]) > 0
			assert int(px[o + 3]) == 255
		}

		@test()
		def blur_agrees_between_gpu_and_cpu() {
			// With a GPU in use the device pass must match the CPU pass to
			// within float32 rounding; without one it stays out of the way.
			let img = new image.Image(64, 48)
			let px = img.raw()
			let seed = uint32(99)
			for let i = 0; i < px.len(); i++ {
				seed = seed * uint32(1664525) + uint32(1013904223)
				px[i] = byte(seed >> 24)
				px[i] = byte(255) when i % 4 == 3
			}
			let device = gaussianOnDevice(img, 2.5)
			if device is none {
				assert !gpu.available()
				return
			}
			let cpu = gaussianCPU(img, 2.5)
			let worst = 0
			for let i = 0; i < cpu.len(); i++ {
				let d = int(cpu[i]) - int(device[i])
				d = -d when d < 0
				worst = d when d > worst
			}
			assert worst <= 1
		}

		@test()
		def replace_and_map() {
			let img = halves()
			replaceColor(img, new color.Color("#ff0000"), new color.Color("#00ff00"))
			assert int(img.raw()[1]) == 255 && int(img.raw()[0]) == 0
			mapPixel(img, c => new color.Color("#123456"))
			assert int(img.raw()[0]) == 0x12 && int(img.raw()[2]) == 0x56
		}
	}
}
