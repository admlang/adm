internal partial module std.gfx.processing.filters.kernels {
	use (
		std.gfx::(Raster, Mask)
		std.simd
		std.gfx.bands::*
		std.gfx.processing.filters::*
	)

	// The unmasked fast paths of the per-pixel filters. They give the bytes
	// `apply` gives (the same arithmetic in the same order), without a
	// closure call and two colour objects per pixel, and hand bands of rows
	// to tasks. With a mask the filters keep `apply`: a mask is read pixel by
	// pixel and need not be safe to share between tasks.

	// Maps each channel through its own 256-entry table: `tables[c * 256 + v]`
	// is what the filter makes of value v in channel c (r, g, b, a). Blended
	// by `strength` (and the mask's coverage) as `apply` blends.
	def applyTables(target Raster, tables byte[], strength float, mask ?Mask) Raster {
		let w = int(target.size().width)
		let h = int(target.size().height)
		let stride = target.stride()
		let data = target.raw()
		if !(mask is none) {
			for let y = 0; y < h; y++ {
				let row = y * stride
				for let x = 0; x < w; x++ {
					let t = strength * mask.coverage(x, y)
					continue when t <= 0.0
					let o = row + x * 4
					for let c = 0; c < 4; c++ {
						let src = data[o + c]
						let dst = tables[c * 256 + int(src)]
						data[o + c] = t >= 1.0 ?? (dst, mixByte(src, dst, t))
					}
				}
			}
			return target
		}
		return target when strength <= 0.0
		// The blend depends only on the byte too: fold it into the tables.
		let lut = tables
		if strength < 1.0 {
			lut = byte[]
			lut.len(1024)
			for let i = 0; i < 1024; i++ {
				lut[i] = mixByte(byte(i % 256), tables[i], strength)
			}
		}
		forRows(w, h, def (from int, to int) {
			for let y = from; y < to; y++ {
				let o = y * stride
				let end = o + w * 4
				for o < end {
					data[o] = lut[int(data[o])]
					data[o + 1] = lut[256 + int(data[o + 1])]
					data[o + 2] = lut[512 + int(data[o + 2])]
					data[o + 3] = lut[768 + int(data[o + 3])]
					o += 4
				}
			}
		})
		return target
	}

	// Tables for a filter that leaves alpha alone and maps each colour
	// channel by `fn(channel, value)`.
	def colorTables(fn def(int, int) byte) byte[] {
		let tables byte[]
		tables.len(1024)
		for let c = 0; c < 4; c++ {
			for let v = 0; v < 256; v++ {
				tables[c * 256 + v] = c == 3 ?? (byte(v), fn(c, v))
			}
		}
		return tables
	}

	// How `colorKernel` combines a pixel's channels.
	enum ColorOp {
		// Each colour channel a weighted sum of r, g and b (grayscale, sepia).
		Matrix
		// Luma plus the channel's distance from it times `factor`.
		Saturate
		// 255 where luma reaches `cut`, else 0.
		Threshold
	}

	// The cross-channel filters on one pixel per vector (four float64 lanes,
	// alpha kept): `m` holds the r, g and b weights of each output channel as
	// three column vectors (r's weights first), rounded and clamped like
	// `clampByte`, then blended by `strength` like `mixByte`.
	def colorKernel(target Raster, op ColorOp, m float64[], factor float64, cut float64, strength float) Raster {
		let w = int(target.size().width)
		let h = int(target.size().height)
		let stride = target.stride()
		let data = target.raw()
		return target when strength <= 0.0
		forRows(w, h, def (from int, to int) {
			let zero = simd.splat4<float64>(float64(0))
			let alpha = zero.withLane(3, float64(1)).gt(zero)
			let c0 = simd.load4<float64>(m, 0)
			let c1 = simd.load4<float64>(m, 4)
			let c2 = simd.load4<float64>(m, 8)
			let lo = zero
			let hi = simd.splat4<float64>(float64(255))
			let half = simd.splat4<float64>(float64(0.5))
			let f = simd.splat4<float64>(factor)
			let t = simd.splat4<float64>(float64(strength))
			let rIdx = simd.splat4<byte>(byte(0))
			let gIdx = simd.splat4<byte>(byte(1))
			let bIdx = simd.splat4<byte>(byte(2))
			for let y = from; y < to; y++ {
				let row = y * stride
				for let x = 0; x < w; x++ {
					let o = row + x * 4
					let v = simd.convert<byte, float64>(simd.load4<byte>(data, o))
					let r = v.shuffle(rIdx)
					let g = v.shuffle(gIdx)
					let b = v.shuffle(bIdx)
					let d = r * c0 + g * c1 + b * c2
					if op == ColorOp.Saturate {
						d = d + (v - d) * f
					} else if op == ColorOp.Threshold {
						d = d.ge(simd.splat4<float64>(cut)).blend(hi, zero)
					}
					d = (d.clamp(lo, hi) + half).floor()
					d = (v + (d - v) * t + half).floor() when strength < 1.0
					simd.store4<byte>(data, o, simd.convert<float64, byte>(alpha.blend(v, d)))
				}
			}
		})
		return target
	}

	// The weights of luma (BT.601) in every colour channel.
	def lumaColumns() float64[] {
		return float64[
			0.299, 0.299, 0.299, 0.0,
			0.587, 0.587, 0.587, 0.0,
			0.114, 0.114, 0.114, 0.0
		]
	}

	// The unsharp mask of `target` into a new buffer: each colour channel
	// plus `amount` times its distance from the 3x3 box mean (edges clamp,
	// the mean truncated like an integer division by 9); alpha kept. Two
	// pixels a lane: the three rows' sums at a pixel and its neighbours four
	// channel values either side.
	def sharpenBuffer(target Raster, amount float) byte[] {
		let w = int(target.size().width)
		let h = int(target.size().height)
		let stride = target.stride()
		let data = target.raw()
		let out byte[]
		out.len(data.len())
		return out when w == 0 || h == 0
		forRows(w, h, def (from int, to int) {
			let n = w * 4
			let zero = simd.splat8<float32>(float32(0))
			let isAlpha = zero.withLane(3, float32(1)).withLane(7, float32(1)).gt(zero)
			let nine = simd.splat8<float32>(float32(9))
			let k = simd.splat8<float32>(float32(amount))
			let lo = zero
			let hi = simd.splat8<float32>(float32(255))
			let half = simd.splat8<float32>(float32(0.5))
			for let y = from; y < to; y++ {
				let row = y * stride
				let up = (y - 1).max(0) * stride
				let down = (y + 1).min(h - 1) * stride
				// Interior pixels have both neighbours: x from 1 to w - 2.
				let x = 4
				for x + 8 + 4 <= n {
					let sum = zero
					for let d = -4; d <= 4; d += 4 {
						sum = sum + simd.convert<byte, float32>(simd.load8<byte>(data, up + x + d))
						sum = sum + simd.convert<byte, float32>(simd.load8<byte>(data, row + x + d))
						sum = sum + simd.convert<byte, float32>(simd.load8<byte>(data, down + x + d))
					}
					let c = simd.convert<byte, float32>(simd.load8<byte>(data, row + x))
					let soft = (sum / nine).floor()
					let sharp = ((c + k * (c - soft)).clamp(lo, hi) + half).floor()
					simd.store8<byte>(out, row + x, simd.convert<float32, byte>(isAlpha.blend(c, sharp)))
					x += 8
				}
				// The edge pixels and what the vectors left over.
				for let px = 0; px < w; px++ {
					let o = px * 4
					continue when o >= 4 && o < x
					for let ch = 0; ch < 4; ch++ {
						let center = data[row + o + ch]
						if ch == 3 {
							out[row + o + ch] = center
							continue
						}
						let acc = 0
						for let dx = -1; dx <= 1; dx++ {
							let sx = ((px + dx).clamp(0, w - 1)) * 4 + ch
							acc += int(data[up + sx]) + int(data[row + sx]) + int(data[down + sx])
						}
						let soft = acc / 9
						out[row + o + ch] = clampByte(float(center) + amount * (float(center) - float(soft)))
					}
				}
			}
		})
		return out
	}
}
