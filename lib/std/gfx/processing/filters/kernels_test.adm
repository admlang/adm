partial module std.gfx.processing.filters {
	use (
		std.testing
		std.formats.image
		std.gfx
		std.gfx::(Raster, Mask)
		std.gfx.color
		std.math.geom
	)

	// A fixed noise image, and the FNV-1a hash of a raster's bytes: the fast
	// paths are pinned to the output they gave when they were checked byte for
	// byte against the per-pixel code they replaced (sharpen and blur within 1
	// of it).
	internal def kernelNoise(w int, h int, seed int) image.Image {
		let img = new image.Image(w, h)
		let px = img.raw()
		let s = uint32(seed)
		for let i = 0; i < px.len(); i++ {
			s = s * uint32(1664525) + uint32(1013904223)
			px[i] = byte(s >> 24)
		}
		return img
	}

	internal def checksum(img Raster) string {
		let h = uint64(14695981039346656037)
		for let (_, b) in img.raw() {
			h = (h ^ uint64(b)) * uint64(1099511628211)
		}
		return h.hex()
	}

	check "Filter fast paths" {
		@test()
		def outputs_stay_pinned() {
			let tone = new color.Color(color.RGBA{r: byte(200), g: byte(40), b: byte(90), a: byte(255)})
			let from = new color.Color(color.RGBA{r: byte(120), g: byte(120), b: byte(120), a: byte(255)})
			let to = new color.Color(color.RGBA{r: byte(1), g: byte(2), b: byte(3), a: byte(4)})
			// Large enough for tasks; the mask covers part of the image and
			// half of a pixel column.
			let area = new gfx.RectangleMask(new geom.Rectangle(position = new geom.Point(1.0, 0.0), size = new geom.Size(16.5, 40.0)))
			let unmasked = ["E642535BCF441382", "B96EFC23E48D2E8C", "F8BED39DB973D3E0", "D6A58227EF42FED9", "F31E648DE2410550", "7A339C0C3CB47834", "4B91661CCD0EF7BF", "36DAE57F7EE05714", "ED4FB4BBD75C418B", "A3C1130188D4A40E", "A27FC61F397C9A6F", "F71B1C0F729055AA", "B5AF38D0D389C5C2", "BBAA0D099B416190", "2A721CB928A44D38", "3024A00BE4B089B7"]
			let masked = ["8FCED270F22AB9F1", "C9A87926AA9ED583", "BA4F6367EE9470AB", "45F1B2B90CA96618", "195DBDEF3A070CA6", "507B28ECB55AC3CA", "FB02369154DAACD5", "33D4136BA7D425DA", "9933570827E85507", "10FEA441EDAE1E93", "CFDAB1A26A36B737", "6CE9CE9A68FB3FFD", "C48BC9954527B709", "C90F8D47C595604F", "20A28550AE0DA043", "564D00ACC8F908D5"]
			for let pass = 0; pass < 2; pass++ {
				let m ?Mask = none
				m = area when pass == 1
				for let k = 0; k < 16; k++ {
					let img = kernelNoise(533, 301, 7)
					match k {
						case 0: grayscale(img, 0.3, m)
						case 1: opacity(img, 0.3, m)
						case 2: posterize(img, 5, m)
						case 3: tint(img, tone, 0.3, m)
						case 4: temperature(img, -0.4, m)
						case 5: exposure(img, 0.4, m)
						case 6: sepia(img, 0.7, m)
						case 7: gamma(img, 1.8, m)
						case 8: contrast(img, 0.4, m)
						case 9: brightness(img, -0.2, m)
						case 10: saturation(img, 0.5, m)
						case 11: hue(img, 0.3, m)
						case 12: threshold(img, 0.45, m)
						case 13: replaceColor(img, from, to, 90, m)
						case 14: sharpen(img, 0.6, m)
						case 15: blur(img, 0.3, m)
					}
					assert checksum(img) == (pass == 0 ?? (unmasked[k], masked[k]))
				}
			}
		}
	}
}
