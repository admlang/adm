partial module std.gfx.processing {
	use (
		std.gfx::(Raster, Mask)
		std.gfx.color
		std.gfx.processing.filters
		std.gfx.processing.transform
		std.gfx.processing.analysis
		std.math.geom
	)

	// Fluent filtering: every step edits the wrapped raster in place and
	// returns the pipeline, so `new Pipeline(img).grayscale().blur(0.5).raster()`
	// reads left to right. The free functions in `filters` do the work.
	type Pipeline {
		target Raster

		def new(target Raster) {
			self.target = target
		}

		// The raster being edited.
		def raster() Raster {
			return target
		}

		// grayscale desaturates the image by strength (0 none, 1 full), within the
		// mask when one is given. Returns the pipeline for chaining.
		def grayscale(@range(0.0, 1.0) strength float = 1.0, mask ?Mask = none) Pipeline {
			filters.grayscale(target, strength, mask)
			return self
		}

		// opacity scales the image's alpha by strength (0 transparent, 1 unchanged),
		// within the mask when one is given. Returns the pipeline for chaining.
		def opacity(@range(0.0, 1.0) strength float, mask ?Mask = none) Pipeline {
			filters.opacity(target, strength, mask)
			return self
		}

		// blur softens the image by strength (0 none, 1 strongest), within the mask
		// when one is given. Returns the pipeline for chaining.
		def blur(@range(0.0, 1.0) strength float, mask ?Mask = none) Pipeline {
			filters.blur(target, strength, mask)
			return self
		}

		// invert negates every colour channel, within the mask when one is given. Returns the pipeline for chaining.
		def invert(mask ?Mask = none) Pipeline {
			filters.invert(target, mask)
			return self
		}

		// quantize reduces the image to at most the given number of colours, within
		// the mask when one is given. Returns the pipeline for chaining.
		def quantize(@range(2, 16777216) colors int, mask ?Mask = none) Pipeline {
			filters.quantize(target, colors, mask)
			return self
		}

		// posterize reduces each channel to the given number of levels, within the
		// mask when one is given. Returns the pipeline for chaining.
		def posterize(@range(2, 256) levels int = 4, mask ?Mask = none) Pipeline {
			filters.posterize(target, levels, mask)
			return self
		}

		// tint blends the tone into the image by strength (0 none, 1 full), within
		// the mask when one is given. Returns the pipeline for chaining.
		def tint(tone color.Color, @range(0.0, 1.0) strength float, mask ?Mask = none) Pipeline {
			filters.tint(target, tone, strength, mask)
			return self
		}

		// temperature shifts the colours cooler (negative) or warmer (positive) by
		// strength, within the mask when one is given. Returns the pipeline for chaining.
		def temperature(@range(-1.0, 1.0) strength float, mask ?Mask = none) Pipeline {
			filters.temperature(target, strength, mask)
			return self
		}

		// exposure darkens (negative) or brightens (positive) the image by strength,
		// as a camera stop would, within the mask when one is given. Returns the pipeline for chaining.
		def exposure(@range(-1.0, 1.0) strength float, mask ?Mask = none) Pipeline {
			filters.exposure(target, strength, mask)
			return self
		}

		// sepia tones the image brown by strength (0 none, 1 full), within the mask
		// when one is given. Returns the pipeline for chaining.
		def sepia(@range(0.0, 1.0) strength float = 1.0, mask ?Mask = none) Pipeline {
			filters.sepia(target, strength, mask)
			return self
		}

		// sharpen accentuates edges by strength (0 none, 1 strongest), within the
		// mask when one is given. Returns the pipeline for chaining.
		def sharpen(@range(0.0, 1.0) strength float, mask ?Mask = none) Pipeline {
			filters.sharpen(target, strength, mask)
			return self
		}

		// gamma applies the gamma curve with the given exponent (1 leaves the image
		// unchanged), within the mask when one is given. Returns the pipeline for chaining.
		def gamma(@range(0.1, 5.0) strength float, mask ?Mask = none) Pipeline {
			filters.gamma(target, strength, mask)
			return self
		}

		// contrast lowers (negative) or raises (positive) the contrast by strength,
		// within the mask when one is given. Returns the pipeline for chaining.
		def contrast(@range(-1.0, 1.0) strength float, mask ?Mask = none) Pipeline {
			filters.contrast(target, strength, mask)
			return self
		}

		// brightness darkens (negative) or lightens (positive) the image by strength,
		// within the mask when one is given. Returns the pipeline for chaining.
		def brightness(@range(-1.0, 1.0) strength float, mask ?Mask = none) Pipeline {
			filters.brightness(target, strength, mask)
			return self
		}

		// saturation drains (negative) or boosts (positive) the colours by strength,
		// within the mask when one is given. Returns the pipeline for chaining.
		def saturation(@range(-1.0, 1.0) strength float, mask ?Mask = none) Pipeline {
			filters.saturation(target, strength, mask)
			return self
		}

		// hue rotates the colours around the hue circle by strength (-1 to 1 is a
		// full turn), within the mask when one is given. Returns the pipeline for chaining.
		def hue(@range(-1.0, 1.0) strength float, mask ?Mask = none) Pipeline {
			filters.hue(target, strength, mask)
			return self
		}

		// threshold turns the image black and white, pixels lighter than strength
		// becoming white, within the mask when one is given. Returns the pipeline for chaining.
		def threshold(@range(0.0, 1.0) strength float, mask ?Mask = none) Pipeline {
			filters.threshold(target, strength, mask)
			return self
		}

		// mapPixel replaces every pixel with what fn returns for it, within the mask
		// when one is given. Returns the pipeline for chaining.
		def mapPixel(fn def(color.Color) color.Color, mask ?Mask = none) Pipeline {
			filters.mapPixel(target, fn, mask)
			return self
		}

		// replaceColor swaps every pixel within tolerance of from for to, within the
		// mask when one is given. Returns the pipeline for chaining.
		def replaceColor(from, to color.Color, tolerance int = 0, mask ?Mask = none) Pipeline {
			filters.replaceColor(target, from, to, tolerance, mask)
			return self
		}

		// resize scales the image to the size with the given resampling mode. Returns the pipeline for chaining.
		def resize(size geom.Size<uint>, mode transform.ResizeMode = transform.ResizeMode.Bilinear) Pipeline {
			transform.resize(target, size, mode)
			return self
		}

		// trim crops away the uniform border around the image. Returns the pipeline for chaining.
		def trim() Pipeline {
			transform.trim(target)
			return self
		}

		// pad adds a border of padding pixels in the background colour, transparent
		// when none is given. Returns the pipeline for chaining.
		def pad(padding int, background ?color.Color = none) Pipeline {
			transform.pad(target, padding, background)
			return self
		}

		// fit scales the image into a width by height box the way the mode says. Returns the pipeline for chaining.
		def fit(width, height int, mode transform.FitMode = transform.FitMode.Cover) Pipeline {
			transform.fit(target, width, height, mode)
			return self
		}

		// flip mirrors the image across the axis. Returns the pipeline for chaining.
		def flip(axis transform.Axis) Pipeline {
			transform.flip(target, axis)
			return self
		}

		// crop keeps the rectangle and discards the rest. Returns the pipeline for chaining.
		def crop(r geom.Rectangle<int>) Pipeline {
			transform.crop(target, r)
			return self
		}

		// smartCrop crops to width by height around the most salient region. Returns the pipeline for chaining.
		def smartCrop(width, height int) Pipeline {
			transform.smartCrop(target, width, height)
			return self
		}

		// saliency replaces the image with its saliency map. Returns the pipeline for chaining.
		def saliency() Pipeline {
			analysis.saliency(target)
			return self
		}
	}
}
