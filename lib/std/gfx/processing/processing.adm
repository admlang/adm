partial module std.gfx.processing {
	use (
		std.gfx::(Raster, Mask)
		std.gfx.color
		std.gfx.processing.filters
		std.gfx.processing.transform
		std.gfx.processing.analysis
		std.math.geom
	)

	// Fluent filtering: every step edits the wrapped raster in place and
	// returns the pipeline, so `new Pipeline(img).grayscale().blur(0.5).raster()`
	// reads left to right. The free functions in `filters` do the work.
	type Pipeline {
		target Raster

		def new(target Raster) {
			self.target = target
		}

		// The raster being edited.
		def raster() Raster {
			return target
		}

		def grayscale(@range(0.0, 1.0) strength float = 1.0, mask ?Mask = none) Pipeline {
			filters.grayscale(target, strength, mask)
			return self
		}

		def opacity(@range(0.0, 1.0) strength float, mask ?Mask = none) Pipeline {
			filters.opacity(target, strength, mask)
			return self
		}

		def blur(@range(0.0, 1.0) strength float, mask ?Mask = none) Pipeline {
			filters.blur(target, strength, mask)
			return self
		}

		def invert(mask ?Mask = none) Pipeline {
			filters.invert(target, mask)
			return self
		}

		def quantize(@range(2, 16777216) colors int, mask ?Mask = none) Pipeline {
			filters.quantize(target, colors, mask)
			return self
		}

		def posterize(@range(2, 256) levels int = 4, mask ?Mask = none) Pipeline {
			filters.posterize(target, levels, mask)
			return self
		}

		def tint(tone color.Color, @range(0.0, 1.0) strength float, mask ?Mask = none) Pipeline {
			filters.tint(target, tone, strength, mask)
			return self
		}

		def temperature(@range(-1.0, 1.0) strength float, mask ?Mask = none) Pipeline {
			filters.temperature(target, strength, mask)
			return self
		}

		def exposure(@range(-1.0, 1.0) strength float, mask ?Mask = none) Pipeline {
			filters.exposure(target, strength, mask)
			return self
		}

		def sepia(@range(0.0, 1.0) strength float = 1.0, mask ?Mask = none) Pipeline {
			filters.sepia(target, strength, mask)
			return self
		}

		def sharpen(@range(0.0, 1.0) strength float, mask ?Mask = none) Pipeline {
			filters.sharpen(target, strength, mask)
			return self
		}

		def gamma(@range(0.1, 5.0) strength float, mask ?Mask = none) Pipeline {
			filters.gamma(target, strength, mask)
			return self
		}

		def contrast(@range(-1.0, 1.0) strength float, mask ?Mask = none) Pipeline {
			filters.contrast(target, strength, mask)
			return self
		}

		def brightness(@range(-1.0, 1.0) strength float, mask ?Mask = none) Pipeline {
			filters.brightness(target, strength, mask)
			return self
		}

		def saturation(@range(-1.0, 1.0) strength float, mask ?Mask = none) Pipeline {
			filters.saturation(target, strength, mask)
			return self
		}

		def hue(@range(-1.0, 1.0) strength float, mask ?Mask = none) Pipeline {
			filters.hue(target, strength, mask)
			return self
		}

		def threshold(@range(0.0, 1.0) strength float, mask ?Mask = none) Pipeline {
			filters.threshold(target, strength, mask)
			return self
		}

		def mapPixel(fn def(color.Color) color.Color, mask ?Mask = none) Pipeline {
			filters.mapPixel(target, fn, mask)
			return self
		}

		def replaceColor(from, to color.Color, tolerance int = 0, mask ?Mask = none) Pipeline {
			filters.replaceColor(target, from, to, tolerance, mask)
			return self
		}

		def resize(size geom.Size<uint>, mode transform.ResizeMode = transform.ResizeMode.Bilinear) Pipeline {
			transform.resize(target, size, mode)
			return self
		}

		def trim() Pipeline {
			transform.trim(target)
			return self
		}

		def pad(padding int, background ?color.Color = none) Pipeline {
			transform.pad(target, padding, background)
			return self
		}

		def fit(width, height int, mode transform.FitMode = transform.FitMode.Cover) Pipeline {
			transform.fit(target, width, height, mode)
			return self
		}

		def flip(axis transform.Axis) Pipeline {
			transform.flip(target, axis)
			return self
		}

		def crop(r geom.Rectangle<int>) Pipeline {
			transform.crop(target, r)
			return self
		}

		def smartCrop(width, height int) Pipeline {
			transform.smartCrop(target, width, height)
			return self
		}

		def saliency() Pipeline {
			analysis.saliency(target)
			return self
		}
	}
}
