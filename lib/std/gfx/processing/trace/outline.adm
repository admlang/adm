// Outlining the regions of a bitmap as potrace does: the pixel boundary of
// each region, the polygon with the fewest sides that stays within half a
// pixel of it, its vertices moved to the best fit, curves through them with
// corners where the turn is sharp, and neighbouring curves joined while they
// stay within tolerance.

partial module std.gfx.processing.trace {
	use (
		std.gfx.bands::forBands
		std.math::sqrt
		std.math.geom::Path
		std.simd
	)

	// One boundary of a region: its vertices on the pixel grid, in order,
	// the last joined to the first.
	internal type Boundary {
		px   int[]
		py   int[]
		// Twice the signed area the vertices enclose.
		area int
		hole bool

		def new() {}

		def len() int {
			return px.len()
		}

		// Turns the boundary round: it then winds the other way.
		def reverse() {
			px.reverse()
			py.reverse()
			area = -area
		}
	}

	// Outlines every region of the mask (one byte per pixel, nonzero for
	// ink) as one path: each region's boundary and its holes as subpaths,
	// the holes wound the other way; either fill rule fills the regions
	// alone. Regions under `specks` pixels are left out.
	internal def outlineShapes(mask byte[], w int, h int, detail float, corners float, specks int, snap float) Path {
		let boundaries = decompose(mask, w, h, specks)
		let alphamax = (2.0 * (1.0 - corners)).min(1.34)
		let tolerance = (1.0 - detail) * 0.4
		let pieces Path[]
		pieces.len(boundaries.len())
		let vertices = 0
		for let (_, b) in boundaries {
			vertices += b.len()
		}
		forBands(boundaries.len(), vertices, def (from int, to int) {
			for let i = from; i < to; i++ {
				pieces[i] = outlineBoundary(boundaries[i], alphamax, tolerance, snap)
			}
		})
		let out = new Path()
		for let (_, piece) in pieces {
			out.add(piece)
		}
		return out
	}

	// The curve of one boundary, as a closed subpath.
	internal def outlineBoundary(b Boundary, alphamax float, tolerance float, snap float) Path {
		let sums = new PathSums(b)
		let lon = calcLon(b)
		let po = bestPolygon(b, lon, sums)
		let (vx, vy) = adjustVertices(b, po, sums)
		let curve = smooth(vx, vy, alphamax)
		curve = opticurve(curve, vx, vy, tolerance) when tolerance > 0.0
		return curve.path(snap)
	}

	// The pixel at (x, y) of the mask, 0 outside it.
	internal def inkAt(mask byte[], w int, h int, x int, y int) int {
		return 0 when x < 0 || y < 0 || x >= w || y >= h
		return int(mask[y * w + x])
	}

	// Every boundary of the mask's regions, outer ones and holes, each
	// traced from its top left pixel with the ink on its right and then
	// cleared from a working copy by flipping its inside; a hole then shows
	// as a region of its own and is traced next with the ink on the other
	// side. A hole's vertices are reversed: it winds the other way.
	internal def decompose(mask byte[], w int, h int, specks int) Boundary[] {
		let work = mask.clone()
		let out Boundary[]
		for let y = 0; y < h; y++ {
			for let x = 0; x < w; x++ {
				continue when work[y * w + x] == 0
				let b = traceBoundary(work, w, h, x, y)
				b.hole = mask[y * w + x] == 0
				flipInside(work, w, b)
				continue when b.area.abs() / 2 < specks
				b.reverse() when b.hole
				out.push(b)
			}
		}
		return out
	}

	// Walks the boundary of the region holding pixel (x0, y0), whose top
	// left corner it starts from heading right, keeping the ink on the right
	// of travel. Where the ink continues only diagonally (a checkerboard
	// corner), it is joined when it is the minority around the corner, else
	// cut, as potrace's minority turn policy does.
	internal def traceBoundary(work byte[], w int, h int, x0 int, y0 int) Boundary {
		let b = new Boundary()
		let (x, y) = (x0, y0)
		let (dx, dy) = (1, 0)
		for {
			b.px.push(x)
			b.py.push(y)
			x += dx
			y += dy
			break when x == x0 && y == y0
			let (rx, ry) = (-dy, dx)
			let aheadRight = inkAt(work, w, h, x + (dx + rx - 1) / 2, y + (dy + ry - 1) / 2)
			let aheadLeft = inkAt(work, w, h, x + (dx - rx - 1) / 2, y + (dy - ry - 1) / 2)
			if aheadRight != 0 && aheadLeft == 0 {
				continue
			}
			let right = false
			if aheadRight == 0 && aheadLeft == 0 {
				right = true
			} else if aheadRight != 0 {
				right = false
			} else {
				right = majorityInk(work, w, h, x, y)
			}
			if right {
				dx = rx
				dy = ry
			} else {
				dx = -rx
				dy = -ry
			}
		}
		let n = b.len()
		let area = 0
		for let i = 0; i < n; i++ {
			let j = (i + 1) % n
			area += b.px[i] * b.py[j] - b.px[j] * b.py[i]
		}
		b.area = area
		return b
	}

	// Whether the ink is the majority around the vertex (x, y), looked at in
	// rings of growing size until one decides.
	internal def majorityInk(work byte[], w int, h int, x int, y int) bool {
		for let i = 2; i < 5; i++ {
			let ct = 0
			for let a = -i + 1; a <= i - 1; a++ {
				ct += inkAt(work, w, h, x + a, y + i - 1) != 0 ?? (1, -1)
				ct += inkAt(work, w, h, x + i - 1, y + a - 1) != 0 ?? (1, -1)
				ct += inkAt(work, w, h, x + a - 1, y - i) != 0 ?? (1, -1)
				ct += inkAt(work, w, h, x - i, y + a) != 0 ?? (1, -1)
			}
			return true when ct > 0
			return false when ct < 0
		}
		return false
	}

	// Flips every pixel inside the boundary: for each vertical edge, the
	// pixels of its row to the left of it. A pixel inside is flipped an odd
	// number of times, one outside an even number.
	internal def flipInside(work byte[], w int, b Boundary) {
		let n = b.len()
		let ones = simd.splat16<byte>(byte(1))
		for let i = 0; i < n; i++ {
			let j = (i + 1) % n
			continue unless b.px[i] == b.px[j]
			let row = b.py[i].min(b.py[j]) * w
			let end = b.px[i]
			let x = 0
			for x + 16 <= end {
				simd.storeBytes16(work, row + x, simd.xor(simd.loadBytes16(work, row + x), ones))
				x += 16
			}
			for x < end {
				work[row + x] = work[row + x] ^ byte(1)
				x++
			}
		}
	}

	// Prefix sums over the boundary's vertices, relative to the first, for
	// the least-squares fits.
	internal type PathSums {
		x  float[]
		y  float[]
		x2 float[]
		xy float[]
		y2 float[]
		x0 int
		y0 int

		def new(b Boundary) {
			let n = b.len()
			x0 = b.px[0]
			y0 = b.py[0]
			x.len(n + 1)
			y.len(n + 1)
			x2.len(n + 1)
			xy.len(n + 1)
			y2.len(n + 1)
			for let i = 0; i < n; i++ {
				let px = float(b.px[i] - x0)
				let py = float(b.py[i] - y0)
				x[i + 1] = x[i] + px
				y[i + 1] = y[i] + py
				x2[i + 1] = x2[i] + px * px
				xy[i + 1] = xy[i] + px * py
				y2[i + 1] = y2[i] + py * py
			}
		}
	}

	internal def xprod(ax int, ay int, bx int, by int) int {
		return ax * by - ay * bx
	}

	internal def sign(v int) int {
		return v > 0 ?? (1, v < 0 ?? (-1, 0))
	}

	internal def floordiv(a int, n int) int {
		return a >= 0 ?? (a / n, -1 - (-1 - a) / n)
	}

	// Whether b lies in the cyclic range [a, c).
	internal def cyclic(a int, b int, c int) bool {
		return a <= c ?? (a <= b && b < c, a <= b || b < c)
	}

	// For each vertex, the furthest vertex a straight path from it reaches:
	// a run of the boundary is straight while some line stays within half
	// a pixel of every vertex, kept as two constraint vectors, and while it
	// does not turn in all four directions.
	internal def calcLon(b Boundary) int[] {
		let n = b.len()
		let px = b.px
		let py = b.py
		let nc int[]
		nc.len(n)
		let k = 0
		for let i = n - 1; i >= 0; i-- {
			k = i + 1 when px[i] != px[k] && py[i] != py[k]
			nc[i] = k
		}
		let pivk int[]
		pivk.len(n)
		let infinity = 10000000
		for let i = 0; i < n; i++ {
			let ct = int[0, 0, 0, 0]
			let dir = (3 + 3 * (px[(i + 1) % n] - px[i]) + (py[(i + 1) % n] - py[i])) / 2
			ct[dir]++
			let (c0x, c0y, c1x, c1y) = (0, 0, 0, 0)
			let k1 = i
			k = nc[i]
			let found = false
			for {
				dir = (3 + 3 * sign(px[k] - px[k1]) + sign(py[k] - py[k1])) / 2
				ct[dir]++
				if ct[0] > 0 && ct[1] > 0 && ct[2] > 0 && ct[3] > 0 {
					pivk[i] = k1
					found = true
					break
				}
				let curX = px[k] - px[i]
				let curY = py[k] - py[i]
				break when xprod(c0x, c0y, curX, curY) < 0 || xprod(c1x, c1y, curX, curY) > 0
				if curX.abs() > 1 || curY.abs() > 1 {
					let offX = curX + ((curY >= 0 && (curY > 0 || curX < 0)) ?? (1, -1))
					let offY = curY + ((curX <= 0 && (curX < 0 || curY < 0)) ?? (1, -1))
					if xprod(c0x, c0y, offX, offY) >= 0 {
						c0x = offX
						c0y = offY
					}
					offX = curX + ((curY <= 0 && (curY < 0 || curX < 0)) ?? (1, -1))
					offY = curY + ((curX >= 0 && (curX > 0 || curY < 0)) ?? (1, -1))
					if xprod(c1x, c1y, offX, offY) <= 0 {
						c1x = offX
						c1y = offY
					}
				}
				k1 = k
				k = nc[k1]
				break unless cyclic(k, i, k1)
			}
			continue when found
			let dkX = sign(px[k] - px[k1])
			let dkY = sign(py[k] - py[k1])
			let curX = px[k1] - px[i]
			let curY = py[k1] - py[i]
			let a = xprod(c0x, c0y, curX, curY)
			let bb = xprod(c0x, c0y, dkX, dkY)
			let c = xprod(c1x, c1y, curX, curY)
			let d = xprod(c1x, c1y, dkX, dkY)
			let j = infinity
			j = floordiv(a, -bb) when bb < 0
			j = j.min(floordiv(-c, d)) when d > 0
			pivk[i] = (k1 + j) % n
		}
		let lon int[]
		lon.len(n)
		let j = pivk[n - 1]
		lon[n - 1] = j
		for let i = n - 2; i >= 0; i-- {
			j = pivk[i] when cyclic(i + 1, pivk[i], j)
			lon[i] = j
		}
		for let i = n - 1; cyclic((i + 1) % n, j, lon[i]); i-- {
			lon[i] = j
		}
		return lon
	}

	// The penalty of a polygon side from vertex i to vertex j: the root of
	// the summed squared distances of the boundary vertices between them
	// from the side, out of the prefix sums.
	internal def penalty3(b Boundary, sums PathSums, i int, j int) float {
		let n = b.len()
		let r = 0
		if j >= n {
			j -= n
			r = 1
		}
		let rf = float(r)
		let x = sums.x[j + 1] - sums.x[i] + rf * sums.x[n]
		let y = sums.y[j + 1] - sums.y[i] + rf * sums.y[n]
		let x2 = sums.x2[j + 1] - sums.x2[i] + rf * sums.x2[n]
		let xy = sums.xy[j + 1] - sums.xy[i] + rf * sums.xy[n]
		let y2 = sums.y2[j + 1] - sums.y2[i] + rf * sums.y2[n]
		let k = float(j + 1 - i + r * n)
		let px = float(b.px[i] + b.px[j]) / 2.0 - float(b.px[0])
		let py = float(b.py[i] + b.py[j]) / 2.0 - float(b.py[0])
		let ey = float(b.px[j] - b.px[i])
		let ex = -float(b.py[j] - b.py[i])
		let a = (x2 - 2.0 * x * px) / k + px * px
		let bb = (xy - x * py - y * px) / k + px * py
		let c = (y2 - 2.0 * y * py) / k + py * py
		let s = ex * ex * a + 2.0 * ex * ey * bb + ey * ey * c
		return sqrt(s.max(0.0))
	}

	// The vertices of the polygon with the fewest sides that stays within
	// half a pixel of the boundary, the least penalty among those.
	internal def bestPolygon(b Boundary, lon int[], sums PathSums) int[] {
		let n = b.len()
		let clip0 int[]
		clip0.len(n)
		for let i = 0; i < n; i++ {
			let c = (lon[(i - 1 + n) % n] - 1 + n) % n
			c = (i + 1) % n when c == i
			clip0[i] = c < i ?? (n, c)
		}
		let clip1 int[]
		clip1.len(n + 1)
		let j = 1
		for let i = 0; i < n; i++ {
			for j <= clip0[i] {
				clip1[j] = i
				j++
			}
		}
		let seg0 int[]
		seg0.len(n + 1)
		let i = 0
		j = 0
		for i < n {
			seg0[j] = i
			i = clip0[i]
			j++
		}
		seg0[j] = n
		let m = j
		let seg1 int[]
		seg1.len(n + 1)
		i = n
		for j = m; j > 0; j-- {
			seg1[j] = i
			i = clip1[i]
		}
		seg1[0] = 0
		let pen float[]
		pen.len(n + 1)
		let prev int[]
		prev.len(n + 1)
		for j = 1; j <= m; j++ {
			for i = seg1[j]; i <= seg0[j]; i++ {
				let best = -1.0
				for let k = seg0[j - 1]; k >= clip1[i]; k-- {
					let thispen = penalty3(b, sums, k, i) + pen[k]
					if best < 0.0 || thispen < best {
						prev[i] = k
						best = thispen
					}
				}
				pen[i] = best
			}
		}
		let po int[]
		po.len(m)
		i = n
		for j = m - 1; j >= 0; j-- {
			i = prev[i]
			po[j] = i
		}
		return po
	}

	// The least-squares line through the boundary vertices i to j
	// (cyclically): its centre and unit direction, relative to the first
	// vertex.
	internal def pointSlope(b Boundary, sums PathSums, i int, j int) (float, float, float, float) {
		let n = b.len()
		let r = 0
		for j >= n {
			j -= n
			r++
		}
		for i >= n {
			i -= n
			r--
		}
		for j < 0 {
			j += n
			r--
		}
		for i < 0 {
			i += n
			r++
		}
		let rf = float(r)
		let x = sums.x[j + 1] - sums.x[i] + rf * sums.x[n]
		let y = sums.y[j + 1] - sums.y[i] + rf * sums.y[n]
		let x2 = sums.x2[j + 1] - sums.x2[i] + rf * sums.x2[n]
		let xy = sums.xy[j + 1] - sums.xy[i] + rf * sums.xy[n]
		let y2 = sums.y2[j + 1] - sums.y2[i] + rf * sums.y2[n]
		let k = float(j + 1 - i + r * n)
		let cx = x / k
		let cy = y / k
		let a = (x2 - x * x / k) / k
		let bb = (xy - x * y / k) / k
		let c = (y2 - y * y / k) / k
		let lambda2 = (a + c + sqrt(((a - c) * (a - c) + 4.0 * bb * bb).max(0.0))) / 2.0
		a -= lambda2
		c -= lambda2
		let (dx, dy) = (0.0, 0.0)
		if a.abs() >= c.abs() {
			let l = sqrt(a * a + bb * bb)
			if l != 0.0 {
				dx = -bb / l
				dy = a / l
			}
		} else {
			let l = sqrt(c * c + bb * bb)
			if l != 0.0 {
				dx = -c / l
				dy = bb / l
			}
		}
		return (cx, cy, dx, dy)
	}

	// Moves each polygon vertex to the point nearest the two lines fitted
	// through its sides, within the unit square around the boundary vertex
	// it came from.
	internal def adjustVertices(b Boundary, po int[], sums PathSums) (float[], float[]) {
		let n = b.len()
		let m = po.len()
		let x0 = float(sums.x0)
		let y0 = float(sums.y0)
		// The quadratic form of each side's line, nine numbers per side.
		let q float[]
		q.len(m * 9)
		for let i = 0; i < m; i++ {
			let j = po[(i + 1) % m]
			j = (j - po[i] + n) % n + po[i]
			let (cx, cy, dx, dy) = pointSlope(b, sums, po[i], j)
			let d = dx * dx + dy * dy
			continue when d == 0.0
			let v = [dy, -dx, dx * cy - dy * cx]
			for let l = 0; l < 3; l++ {
				for let k = 0; k < 3; k++ {
					q[i * 9 + l * 3 + k] = v[l] * v[k] / d
				}
			}
		}
		let vx float[]
		let vy float[]
		vx.len(m)
		vy.len(m)
		for let i = 0; i < m; i++ {
			let qq float[]
			qq.len(9)
			let before = (i - 1 + m) % m
			for let k = 0; k < 9; k++ {
				qq[k] = q[before * 9 + k] + q[i * 9 + k]
			}
			let sx = float(b.px[po[i]]) - x0
			let sy = float(b.py[po[i]]) - y0
			let (wx, wy) = (0.0, 0.0)
			for {
				let det = qq[0] * qq[4] - qq[1] * qq[3]
				if det != 0.0 {
					wx = (-qq[2] * qq[4] + qq[5] * qq[1]) / det
					wy = (qq[2] * qq[3] - qq[5] * qq[0]) / det
					break
				}
				// Parallel lines: another axis through the square's centre.
				let (ax, ay) = (1.0, 0.0)
				if qq[0] > qq[4] {
					ax = -qq[1]
					ay = qq[0]
				} else if qq[4] != 0.0 {
					ax = -qq[4]
					ay = qq[3]
				}
				let d = ax * ax + ay * ay
				let v = [ax, ay, -ay * sy - ax * sx]
				for let l = 0; l < 3; l++ {
					for let k = 0; k < 3; k++ {
						qq[l * 3 + k] += v[l] * v[k] / d
					}
				}
			}
			if (wx - sx).abs() <= 0.5 && (wy - sy).abs() <= 0.5 {
				vx[i] = wx + x0
				vy[i] = wy + y0
				continue
			}
			let min = quadform(qq, sx, sy)
			let (bx, by) = (sx, sy)
			if qq[0] != 0.0 {
				for let z = 0; z < 2; z++ {
					let cy = sy - 0.5 + float(z)
					let cx = -(qq[1] * cy + qq[2]) / qq[0]
					let cand = quadform(qq, cx, cy)
					if (cx - sx).abs() <= 0.5 && cand < min {
						min = cand
						bx = cx
						by = cy
					}
				}
			}
			if qq[4] != 0.0 {
				for let z = 0; z < 2; z++ {
					let cx = sx - 0.5 + float(z)
					let cy = -(qq[3] * cx + qq[5]) / qq[4]
					let cand = quadform(qq, cx, cy)
					if (cy - sy).abs() <= 0.5 && cand < min {
						min = cand
						bx = cx
						by = cy
					}
				}
			}
			for let l = 0; l < 2; l++ {
				for let k = 0; k < 2; k++ {
					let cx = sx - 0.5 + float(l)
					let cy = sy - 0.5 + float(k)
					let cand = quadform(qq, cx, cy)
					if cand < min {
						min = cand
						bx = cx
						by = cy
					}
				}
			}
			vx[i] = bx + x0
			vy[i] = by + y0
		}
		return (vx, vy)
	}

	// The quadratic form at (x, y, 1).
	internal def quadform(q float[], x float, y float) float {
		let v = [x, y, 1.0]
		let sum = 0.0
		for let i = 0; i < 3; i++ {
			for let j = 0; j < 3; j++ {
				sum += q[i * 3 + j] * v[i] * v[j]
			}
		}
		return sum
	}

	// A closed curve of segments, one per polygon vertex: each ends at the
	// midpoint of a side (`c2`) and is a cubic with controls `c0`, `c1`, or
	// a corner at `c1` reached and left by lines.
	internal type Curve {
		corner bool[]
		c0x    float[]
		c0y    float[]
		c1x    float[]
		c1y    float[]
		c2x    float[]
		c2y    float[]
		alpha  float[]

		def new(m int) {
			corner.len(m)
			c0x.len(m)
			c0y.len(m)
			c1x.len(m)
			c1y.len(m)
			c2x.len(m)
			c2y.len(m)
			alpha.len(m)
		}

		def len() int {
			return corner.len()
		}

		// The curve as a closed subpath, every point rounded to `snap`.
		def path(snap float) Path {
			let out = new Path()
			let m = len()
			return out when m == 0
			out.moveTo(snapTo(c2x[m - 1], snap), snapTo(c2y[m - 1], snap))
			for let i = 0; i < m; i++ {
				if corner[i] {
					out.lineTo(snapTo(c1x[i], snap), snapTo(c1y[i], snap))
					out.lineTo(snapTo(c2x[i], snap), snapTo(c2y[i], snap))
				} else {
					out.cubicTo(snapTo(c0x[i], snap), snapTo(c0y[i], snap), snapTo(c1x[i], snap), snapTo(c1y[i], snap), snapTo(c2x[i], snap), snapTo(c2y[i], snap))
				}
			}
			out.close()
			return out
		}
	}

	// Twice the signed area of the triangle (p0, p1, p2).
	internal def dpara(x0 float, y0 float, x1 float, y1 float, x2 float, y2 float) float {
		return (x1 - x0) * (y2 - y0) - (x2 - x0) * (y1 - y0)
	}

	// The point `t` of the way from a to b.
	internal def interval(t float, ax float, ay float, bx float, by float) (float, float) {
		return (ax + t * (bx - ax), ay + t * (by - ay))
	}

	// Curves through the polygon vertices: at each vertex the segment from
	// the midpoint of the side before to the midpoint of the side after,
	// bowed by how far the vertex is from their chord (`alpha`); a vertex
	// whose alpha reaches `alphamax` stays a corner.
	internal def smooth(vx float[], vy float[], alphamax float) Curve {
		let m = vx.len()
		let curve = new Curve(m)
		for let i = 0; i < m; i++ {
			let j = (i + 1) % m
			let k = (i + 2) % m
			let (p4x, p4y) = interval(0.5, vx[k], vy[k], vx[j], vy[j])
			let denom = ddenom(vx[i], vy[i], vx[k], vy[k])
			let alpha = 4.0 / 3.0
			if denom != 0.0 {
				let dd = (dpara(vx[i], vy[i], vx[j], vy[j], vx[k], vy[k]) / denom).abs()
				alpha = dd > 1.0 ?? (1.0 - 1.0 / dd, 0.0)
				alpha = alpha / 0.75
			}
			if alpha >= alphamax {
				curve.corner[j] = true
				curve.c1x[j] = vx[j]
				curve.c1y[j] = vy[j]
				curve.c2x[j] = p4x
				curve.c2y[j] = p4y
			} else {
				alpha = alpha.clamp(0.55, 1.0)
				let (p2x, p2y) = interval(0.5 + 0.5 * alpha, vx[i], vy[i], vx[j], vy[j])
				let (p3x, p3y) = interval(0.5 + 0.5 * alpha, vx[k], vy[k], vx[j], vy[j])
				curve.c0x[j] = p2x
				curve.c0y[j] = p2y
				curve.c1x[j] = p3x
				curve.c1y[j] = p3y
				curve.c2x[j] = p4x
				curve.c2y[j] = p4y
			}
			curve.alpha[j] = alpha
		}
		return curve
	}

	// The denominator of the vertex distance: the length of p0p2 measured
	// along the axis it leans to.
	internal def ddenom(x0 float, y0 float, x2 float, y2 float) float {
		let rx = -fsign(y2 - y0)
		let ry = fsign(x2 - x0)
		return ry * (x2 - x0) - rx * (y2 - y0)
	}

	internal def fsign(v float) float {
		return v > 0.0 ?? (1.0, v < 0.0 ?? (-1.0, 0.0))
	}

	internal def ddist(x0 float, y0 float, x1 float, y1 float) float {
		return sqrt((x0 - x1) * (x0 - x1) + (y0 - y1) * (y0 - y1))
	}

	// (p1 - p0) x (p3 - p2).
	internal def cprod(x0 float, y0 float, x1 float, y1 float, x2 float, y2 float, x3 float, y3 float) float {
		return (x1 - x0) * (y3 - y2) - (y1 - y0) * (x3 - x2)
	}

	// (p1 - p0) . (p2 - p0).
	internal def iprod(x0 float, y0 float, x1 float, y1 float, x2 float, y2 float) float {
		return (x1 - x0) * (x2 - x0) + (y1 - y0) * (y2 - y0)
	}

	// (p1 - p0) . (p3 - p2).
	internal def iprod1(x0 float, y0 float, x1 float, y1 float, x2 float, y2 float, x3 float, y3 float) float {
		return (x1 - x0) * (x3 - x2) + (y1 - y0) * (y3 - y2)
	}

	// The point of the cubic at t.
	internal def bezierAt(t float, x0 float, y0 float, x1 float, y1 float, x2 float, y2 float, x3 float, y3 float) (float, float) {
		let s = 1.0 - t
		let x = s * s * s * x0 + 3.0 * s * s * t * x1 + 3.0 * s * t * t * x2 + t * t * t * x3
		let y = s * s * s * y0 + 3.0 * s * s * t * y1 + 3.0 * s * t * t * y2 + t * t * t * y3
		return (x, y)
	}

	// The t in [0, 1] where the cubic's tangent is parallel to q1 - q0; -1
	// when there is none.
	internal def tangentAt(x0 float, y0 float, x1 float, y1 float, x2 float, y2 float, x3 float, y3 float, qx0 float, qy0 float, qx1 float, qy1 float) float {
		let a = cprod(x0, y0, x1, y1, qx0, qy0, qx1, qy1)
		let bb = cprod(x1, y1, x2, y2, qx0, qy0, qx1, qy1)
		let c = cprod(x2, y2, x3, y3, qx0, qy0, qx1, qy1)
		let qa = a - 2.0 * bb + c
		let qb = -2.0 * a + 2.0 * bb
		let qc = a
		let d = qb * qb - 4.0 * qa * qc
		return -1.0 when qa == 0.0 || d < 0.0
		let s = sqrt(d)
		let r1 = (-qb + s) / (2.0 * qa)
		let r2 = (-qb - s) / (2.0 * qa)
		return r1 when r1 >= 0.0 && r1 <= 1.0
		return r2 when r2 >= 0.0 && r2 <= 1.0
		return -1.0
	}

	// One cubic standing in for segments i+1 to j, as `optiPenalty` fits it.
	internal struct Opti {
		pen   float
		c0x   float
		c0y   float
		c1x   float
		c1y   float
		alpha float
	}

	internal const cos179 = -0.99984769515639

	// Whether one cubic from the end of segment i to the end of segment j
	// can stand in for the segments between, within `tolerance` of each of
	// their vertices and chords, and what it is: none when it cannot.
	internal def optiPenalty(curve Curve, vx float[], vy float[], i int, j int, tolerance float, convc int[], areac float[]) ?Opti {
		let m = curve.len()
		return none when i == j
		let i1 = (i + 1) % m
		let conv = convc[i1]
		return none when conv == 0
		let d = ddist(vx[i], vy[i], vx[i1], vy[i1])
		let k = i1
		for k != j {
			let k1 = (k + 1) % m
			let k2 = (k + 2) % m
			return none when convc[k1] != conv
			return none when fsign(cprod(vx[i], vy[i], vx[i1], vy[i1], vx[k1], vy[k1], vx[k2], vy[k2])) != float(conv)
			return none when iprod1(vx[i], vy[i], vx[i1], vy[i1], vx[k1], vy[k1], vx[k2], vy[k2]) < d * ddist(vx[k1], vy[k1], vx[k2], vy[k2]) * cos179
			k = k1
		}
		let (p0x, p0y) = (curve.c2x[i % m], curve.c2y[i % m])
		let (p1x, p1y) = (vx[i1], vy[i1])
		let (p2x, p2y) = (vx[j % m], vy[j % m])
		let (p3x, p3y) = (curve.c2x[j % m], curve.c2y[j % m])
		let area = areac[j] - areac[i]
		area -= dpara(vx[0], vy[0], curve.c2x[i], curve.c2y[i], curve.c2x[j], curve.c2y[j]) / 2.0
		area += areac[m] when i >= j
		let a1 = dpara(p0x, p0y, p1x, p1y, p2x, p2y)
		let a2 = dpara(p0x, p0y, p1x, p1y, p3x, p3y)
		let a3 = dpara(p0x, p0y, p2x, p2y, p3x, p3y)
		let a4 = a1 + a3 - a2
		return none when a2 == a1 || a3 == a4
		let t = a3 / (a3 - a4)
		let s = a2 / (a2 - a1)
		let a = a2 * t / 2.0
		return none when a == 0.0
		let r = area / a
		let under = 4.0 - r / 0.3
		return none when under < 0.0
		let alpha = 2.0 - sqrt(under)
		let (c0x, c0y) = interval(t * alpha, p0x, p0y, p1x, p1y)
		let (c1x, c1y) = interval(s * alpha, p3x, p3y, p2x, p2y)
		let pen = 0.0
		// The vertices between stay within tolerance of the cubic, on its
		// convex side.
		k = i1
		for k != j {
			let k1 = (k + 1) % m
			let tt = tangentAt(p0x, p0y, c0x, c0y, c1x, c1y, p3x, p3y, vx[k], vy[k], vx[k1], vy[k1])
			return none when tt < -0.5
			let (qx, qy) = bezierAt(tt, p0x, p0y, c0x, c0y, c1x, c1y, p3x, p3y)
			let dd = ddist(vx[k], vy[k], vx[k1], vy[k1])
			return none when dd == 0.0
			let d1 = dpara(vx[k], vy[k], vx[k1], vy[k1], qx, qy) / dd
			return none when d1.abs() > tolerance
			return none when iprod(vx[k], vy[k], vx[k1], vy[k1], qx, qy) < 0.0 || iprod(vx[k1], vy[k1], vx[k], vy[k], qx, qy) < 0.0
			pen += d1 * d1
			k = k1
		}
		// The old segments' corners stay within tolerance of it too.
		k = i
		for k != j {
			let k1 = (k + 1) % m
			let tt = tangentAt(p0x, p0y, c0x, c0y, c1x, c1y, p3x, p3y, curve.c2x[k], curve.c2y[k], curve.c2x[k1], curve.c2y[k1])
			return none when tt < -0.5
			let (qx, qy) = bezierAt(tt, p0x, p0y, c0x, c0y, c1x, c1y, p3x, p3y)
			let dd = ddist(curve.c2x[k], curve.c2y[k], curve.c2x[k1], curve.c2y[k1])
			return none when dd == 0.0
			let d1 = dpara(curve.c2x[k], curve.c2y[k], curve.c2x[k1], curve.c2y[k1], qx, qy) / dd
			let d2 = dpara(curve.c2x[k], curve.c2y[k], curve.c2x[k1], curve.c2y[k1], vx[k1], vy[k1]) / dd
			d2 *= 0.75 * curve.alpha[k1]
			if d2 < 0.0 {
				d1 = -d1
				d2 = -d2
			}
			return none when d1 < d2 - tolerance
			pen += (d1 - d2) * (d1 - d2) when d1 < d2
			k = k1
		}
		return Opti{pen: pen, c0x: c0x, c0y: c0y, c1x: c1x, c1y: c1y, alpha: alpha}
	}

	// Joins runs of curve segments into single cubics where one stays
	// within `tolerance`, choosing the fewest segments and, among those,
	// the least penalty.
	internal def opticurve(curve Curve, vx float[], vy float[], tolerance float) Curve {
		let m = curve.len()
		return curve when m < 3
		let convc int[]
		convc.len(m)
		for let i = 0; i < m; i++ {
			convc[i] = int(fsign(dpara(vx[(i - 1 + m) % m], vy[(i - 1 + m) % m], vx[i], vy[i], vx[(i + 1) % m], vy[(i + 1) % m]))) unless curve.corner[i]
		}
		let areac float[]
		areac.len(m + 1)
		for let i = 0; i < m; i++ {
			let i1 = (i + 1) % m
			let area = 0.0
			if !curve.corner[i1] {
				let alpha = curve.alpha[i1]
				area = 0.3 * alpha * (4.0 - alpha) * dpara(curve.c2x[i], curve.c2y[i], vx[i1], vy[i1], curve.c2x[i1], curve.c2y[i1]) / 2.0
			}
			area += dpara(vx[0], vy[0], curve.c2x[i], curve.c2y[i], curve.c2x[i1], curve.c2y[i1]) / 2.0
			areac[i + 1] = areac[i] + area
		}
		let pt int[]
		let pen float[]
		let lengths int[]
		let opt Opti[]
		pt.len(m + 1)
		pen.len(m + 1)
		lengths.len(m + 1)
		opt.len(m + 1)
		for let j = 1; j <= m; j++ {
			pt[j] = j - 1
			pen[j] = pen[j - 1]
			lengths[j] = lengths[j - 1] + 1
			for let i = j - 2; i >= 0; i-- {
				let o = optiPenalty(curve, vx, vy, i, j % m, tolerance, convc, areac)
				break when o is none
				if lengths[j] > lengths[i] + 1 || (lengths[j] == lengths[i] + 1 && pen[j] > pen[i] + o.pen) {
					pt[j] = i
					pen[j] = pen[i] + o.pen
					lengths[j] = lengths[i] + 1
					opt[j] = o
				}
			}
		}
		// Position j of the search is the end of segment j mod m: the segments
		// are walked 1 to m-1, then 0.
		let om = lengths[m]
		let out = new Curve(om)
		let j = m
		for let i = om - 1; i >= 0; i-- {
			if pt[j] == j - 1 {
				let src = j % m
				out.corner[i] = curve.corner[src]
				out.c0x[i] = curve.c0x[src]
				out.c0y[i] = curve.c0y[src]
				out.c1x[i] = curve.c1x[src]
				out.c1y[i] = curve.c1y[src]
				out.c2x[i] = curve.c2x[src]
				out.c2y[i] = curve.c2y[src]
				out.alpha[i] = curve.alpha[src]
			} else {
				let o = opt[j]
				out.c0x[i] = o.c0x
				out.c0y[i] = o.c0y
				out.c1x[i] = o.c1x
				out.c1y[i] = o.c1y
				out.c2x[i] = curve.c2x[j % m]
				out.c2y[i] = curve.c2y[j % m]
				out.alpha[i] = o.alpha
			}
			j = pt[j]
		}
		return out
	}
}
