// Tracing a picture into paths: the filled outlines of its colours, or the
// centre lines of its strokes with their widths.

partial module std.gfx.processing.trace {
	use (
		std.gfx::Raster
		std.gfx.bands::forRows
		std.gfx.color::(Color, RGBA)
		std.math.geom::Path
	)

	// What tracing makes of the picture.
	enum TraceMode {
		// The filled outline of each colour's regions, holes included: one
		// path per colour, an icon drawn as areas.
		Shapes,
		// The middle of each stroke with its width measured: a line icon.
		Lines,
	}

	// One traced path, in the picture's pixel units.
	struct TracedPath {
		path  Path
		// The colour of the area (Shapes) or of the stroke (Lines).
		color Color
		// The stroke's measured width (Lines); 0 for an area.
		width float
	}

	// What `trace` made of a picture.
	type Tracing {
		paths TracedPath[]
		// Lines: the width most strokes have, which the others may round to; 0
		// for Shapes or no strokes.
		width float

		def new() {}

		// How many anchor and control points the paths hold.
		def points() int {
			let n = 0
			for let (_, p) in paths {
				n += p.path.coords.len() / 2
			}
			return n
		}
	}

	// trace vectorises the picture. Shapes: the opaque pixels are sorted into
	// `colors` colours (the most common ones, every pixel joining the nearest)
	// and each colour's regions are outlined as potrace does: pixel
	// boundaries, the fewest-sided polygon within half a pixel of them, its
	// vertices fitted, then curves with corners where the turn is sharp
	// (`corners`, 0 none to 1 every vertex) and neighbouring curves joined
	// while they stay within tolerance (`detail`, 1 keeps every curve, 0
	// joins freely); regions under `specks` pixels are dropped. The
	// background is what transparent pixels show; a picture without
	// transparency takes `background`, else the colour most of its edge has,
	// as the one not traced. Lines: the ink (opaque pixels, or those unlike
	// the background) is thinned to its centre lines, which become strokes
	// through junctions where arms run on, simplified and fitted with cubic
	// curves split at corners; each stroke's width is the coverage summed
	// across it (alpha, or how far a pixel's colour lies from the background
	// towards the ink's). `snap` rounds every point to a multiple of it (0:
	// as measured). Paths are in pixel units, the origin the top left.
	def trace(picture Raster, mode TraceMode = TraceMode.Shapes, @range(2, 64) colors int = 2, @range(0.0, 1.0) detail float = 0.5, @range(0.0, 1.0) corners float = 0.5, @range(0, 1000000) specks int = 2, @range(0.0, 1000.0) snap float = 0.0, background ?Color = none) Tracing {
		let out = new Tracing()
		let w = int(picture.size().width)
		let h = int(picture.size().height)
		return out when w <= 0 || h <= 0
		if mode == TraceMode.Shapes {
			let classes = classify(picture, colors, background)
			for let (c, tone) in classes.colors {
				continue when c == classes.background
				let mask = classes.maskOf(c)
				let path = outlineShapes(mask, w, h, detail, corners, specks, snap)
				out.paths.push(TracedPath{path: path, color: tone, width: 0.0}) unless path.isEmpty()
			}
		} else {
			let (ink, coverage) = inkMask(picture, background)
			let lines = centreLines(ink, coverage, w, h, detail, corners, specks, snap)
			let tone = inkColor(picture, ink)
			for let (_, l) in lines {
				out.paths.push(TracedPath{path: l.path, color: tone, width: l.width})
			}
			out.width = usualWidth(out.paths)
		}
		return out
	}

	// The mean colour of the ink pixels; black when there are none.
	internal def inkColor(picture Raster, ink byte[]) Color {
		let w = int(picture.size().width)
		let h = int(picture.size().height)
		let stride = picture.stride()
		let data = picture.raw()
		let (r, g, b, n) = (0, 0, 0, 0)
		for let y = 0; y < h; y++ {
			for let x = 0; x < w; x++ {
				continue when ink[y * w + x] == 0
				let o = y * stride + x * 4
				r += int(data[o])
				g += int(data[o + 1])
				b += int(data[o + 2])
				n++
			}
		}
		return new Color(RGBA{r: byte(0), g: byte(0), b: byte(0), a: byte(255)}) when n == 0
		return new Color(RGBA{r: byte(r / n), g: byte(g / n), b: byte(b / n), a: byte(255)})
	}

	// The pixels of a picture sorted into colour classes: `kind[y * w + x]`
	// is each pixel's class, -1 for a transparent one.
	internal type Classes {
		width      int
		height     int
		kind       int[]
		colors     Color[]
		// The class that is the background, -1 when the background is only
		// the transparent pixels.
		background int

		def new(width int, height int) {
			self.width = width
			self.height = height
			kind = int[]
			kind.len(width * height)
			background = -1
		}

		// Whether each pixel is of class `c`, one byte per pixel.
		def maskOf(c int) byte[] {
			let out byte[]
			out.len(width * height)
			for let i = 0; i < kind.len(); i++ {
				out[i] = byte(1) when kind[i] == c
			}
			return out
		}
	}

	// Sorts the opaque pixels into at most `colors` classes: the most
	// populous 5-bit-per-channel bins give the colours (each the mean of its
	// bin), and every pixel joins the nearest through a table over the bins.
	internal def classify(picture Raster, colors int, background ?Color) Classes {
		let w = int(picture.size().width)
		let h = int(picture.size().height)
		let stride = picture.stride()
		let data = picture.raw()
		let out = new Classes(w, h)
		// Population and channel sums per 15-bit bin.
		let count int[]
		count.len(32768)
		let sumR int[]
		let sumG int[]
		let sumB int[]
		sumR.len(32768)
		sumG.len(32768)
		sumB.len(32768)
		let opaque = 0
		for let y = 0; y < h; y++ {
			let row = y * stride
			for let x = 0; x < w; x++ {
				let o = row + x * 4
				continue when int(data[o + 3]) < 128
				let r = int(data[o])
				let g = int(data[o + 1])
				let b = int(data[o + 2])
				let bin = ((r >> 3) << 10) | ((g >> 3) << 5) | (b >> 3)
				count[bin]++
				sumR[bin] += r
				sumG[bin] += g
				sumB[bin] += b
				opaque++
			}
		}
		return out when opaque == 0
		// The most populous bins, each at least a thousandth of the pixels or
		// the last picked.
		let picked int[]
		for picked.len() < colors {
			let best = -1
			for let bin = 0; bin < 32768; bin++ {
				continue when count[bin] == 0
				best = bin when best < 0 || count[bin] > count[best]
			}
			break when best < 0
			break when picked.len() > 0 && count[best] * 1000 < opaque
			picked.push(best)
			// Bins next to a picked one merge into it: an antialiased edge is
			// not a colour of its own.
			let (pr, pg, pb) = (best >> 10, (best >> 5) & 31, best & 31)
			for let dr = -1; dr <= 1; dr++ {
				for let dg = -1; dg <= 1; dg++ {
					for let db = -1; db <= 1; db++ {
						let (r, g, b) = (pr + dr, pg + dg, pb + db)
						continue when r < 0 || r > 31 || g < 0 || g > 31 || b < 0 || b > 31
						let near = (r << 10) | (g << 5) | b
						continue when near == best || count[near] == 0
						sumR[best] += sumR[near]
						sumG[best] += sumG[near]
						sumB[best] += sumB[near]
						count[best] += count[near]
						count[near] = 0
						sumR[near] = 0
						sumG[near] = 0
						sumB[near] = 0
					}
				}
			}
			count[best] = -count[best]
		}
		for let (_, bin) in picked {
			let n = -count[bin]
			out.colors.push(new Color(RGBA{r: byte(sumR[bin] / n), g: byte(sumG[bin] / n), b: byte(sumB[bin] / n), a: byte(255)}))
		}
		// The nearest colour of every bin, then of every pixel through it.
		let table int[]
		table.len(32768)
		for let bin = 0; bin < 32768; bin++ {
			let (r, g, b) = ((bin >> 10) * 8 + 4, ((bin >> 5) & 31) * 8 + 4, (bin & 31) * 8 + 4)
			table[bin] = nearestColor(out.colors, r, g, b)
		}
		forRows(w, h, def (from int, to int) {
			for let y = from; y < to; y++ {
				let row = y * stride
				for let x = 0; x < w; x++ {
					let o = row + x * 4
					let i = y * w + x
					if int(data[o + 3]) < 128 {
						out.kind[i] = -1
						continue
					}
					out.kind[i] = table[((int(data[o]) >> 3) << 10) | ((int(data[o + 1]) >> 3) << 5) | (int(data[o + 2]) >> 3)]
				}
			}
		})
		if background is Color {
			let rgba = background.rgba
			out.background = nearestColor(out.colors, int(rgba.r), int(rgba.g), int(rgba.b))
		} else if opaque == w * h {
			out.background = edgeClass(out)
		}
		return out
	}

	// The index of the colour nearest to (r, g, b).
	internal def nearestColor(colors Color[], r int, g int, b int) int {
		let best = 0
		let bestD = -1
		for let (i, c) in colors {
			let p = c.rgba
			let (dr, dg, db) = (int(p.r) - r, int(p.g) - g, int(p.b) - b)
			let d = dr * dr + dg * dg + db * db
			if bestD < 0 || d < bestD {
				bestD = d
				best = i
			}
		}
		return best
	}

	// The class most of the picture's edge pixels have.
	internal def edgeClass(c Classes) int {
		let tally int[]
		tally.len(c.colors.len())
		let add = def (i int) {
			tally[c.kind[i]]++ when c.kind[i] >= 0
		}
		for let x = 0; x < c.width; x++ {
			add(x)
			add((c.height - 1) * c.width + x)
		}
		for let y = 1; y + 1 < c.height; y++ {
			add(y * c.width)
			add(y * c.width + c.width - 1)
		}
		let best = -1
		for let (i, n) in tally {
			best = i when best < 0 || n > tally[best]
		}
		return best
	}

	// The ink mask (1 where a pixel is ink) and each pixel's coverage, 0 to
	// 255: in a picture with transparency the ink is the pixels at least half
	// opaque and the coverage their alpha; in an opaque one the ink is the
	// pixels nearer the other of two colours than the background, and the
	// coverage how far a pixel's colour lies from the background towards
	// the ink's.
	internal def inkMask(picture Raster, background ?Color) (byte[], byte[]) {
		let w = int(picture.size().width)
		let h = int(picture.size().height)
		let stride = picture.stride()
		let data = picture.raw()
		let out byte[]
		out.len(w * h)
		let coverage byte[]
		coverage.len(w * h)
		let transparent = false
		for let y = 0; y < h && !transparent; y++ {
			for let x = 0; x < w; x++ {
				if int(data[y * stride + x * 4 + 3]) < 128 {
					transparent = true
					break
				}
			}
		}
		if transparent {
			forRows(w, h, def (from int, to int) {
				for let y = from; y < to; y++ {
					let row = y * stride
					for let x = 0; x < w; x++ {
						let alpha = data[row + x * 4 + 3]
						coverage[y * w + x] = alpha
						out[y * w + x] = byte(1) when int(alpha) >= 128
					}
				}
			})
			return (out, coverage)
		}
		let classes = classify(picture, 2, background)
		return (out, coverage) when classes.colors.len() < 2
		let bg = classes.background
		let inkClass = bg == 0 ?? (1, 0)
		let (bgR, bgG, bgB) = (int(classes.colors[bg].rgba.r), int(classes.colors[bg].rgba.g), int(classes.colors[bg].rgba.b))
		let (dR, dG, dB) = (int(classes.colors[inkClass].rgba.r) - bgR, int(classes.colors[inkClass].rgba.g) - bgG, int(classes.colors[inkClass].rgba.b) - bgB)
		let span = (dR * dR + dG * dG + dB * dB).max(1)
		forRows(w, h, def (from int, to int) {
			for let y = from; y < to; y++ {
				let row = y * stride
				for let x = 0; x < w; x++ {
					let i = y * w + x
					out[i] = byte(1) when classes.kind[i] != bg
					let o = row + x * 4
					let along = (int(data[o]) - bgR) * dR + (int(data[o + 1]) - bgG) * dG + (int(data[o + 2]) - bgB) * dB
					coverage[i] = byte((along * 255 / span).clamp(0, 255))
				}
			}
		})
		return (out, coverage)
	}

	// The width most strokes have, to a tenth of a pixel; 0 for none.
	internal def usualWidth(lines TracedPath[]) float {
		return 0.0 when lines.len() == 0
		let tally = map<int, int>{}
		for let (_, l) in lines {
			let key = int((l.width * 10.0).round())
			tally[key] = (tally.get(key) is none ?? (0, tally[key])) + 1
		}
		let best = -1
		for let (key, n) in tally {
			best = key when best < 0 || n > tally[best] || (n == tally[best] && key > best)
		}
		return float(best) / 10.0
	}

	// Rounds a coordinate to a multiple of `snap`; as it is for 0.
	internal def snapTo(v float, snap float) float {
		return v when snap <= 0.0
		return (v / snap).round() * snap
	}
}
