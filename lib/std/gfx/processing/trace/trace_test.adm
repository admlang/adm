partial module std.gfx.processing.trace {
	use (
		std.formats.image
		std.gfx.color::(Color, RGBA)
		std.math.geom::(Path, PathVerb, Point)
		std.testing
	)

	check "Tracing" {
		// A 64 by 64 picture, transparent unless `opaque`, with pixels painted where
		// `ink(x, y)` says, in the colour.
		internal def picture(ink def(int, int) bool, tone Color, opaque bool = false) image.Image {
			let img = new image.Image(64, 64)
			let px = img.raw()
			let c = tone.rgba
			for let y = 0; y < 64; y++ {
				for let x = 0; x < 64; x++ {
					let o = img.pixelOffset(x, y)
					if ink(x, y) {
						px[o] = c.r
						px[o + 1] = c.g
						px[o + 2] = c.b
						px[o + 3] = byte(255)
					} else if opaque {
						px[o] = byte(255)
						px[o + 1] = byte(255)
						px[o + 2] = byte(255)
						px[o + 3] = byte(255)
					}
				}
			}
			return img
		}

		internal def black() Color {
			return new Color(RGBA{r: byte(0), g: byte(0), b: byte(0), a: byte(255)})
		}

		internal def inCircle(x int, y int, cx float, cy float, r float) bool {
			let dx = float(x) + 0.5 - cx
			let dy = float(y) + 0.5 - cy
			return dx * dx + dy * dy <= r * r
		}

		def near(a float, b float, eps float) bool {
			return (a - b).abs() <= eps
		}

		def count(path Path, verb PathVerb) int {
			let n = 0
			for let (_, v) in path.verbs {
				n++ when v == verb
			}
			return n
		}

		// A filled disc becomes one closed path of curves around it; a ring keeps
		// its hole, which neither fill rule fills.
		@test()
		def shapesOutlineDiscsAndHoles() !none {
			let disc = picture((x, y) => inCircle(x, y, 32.0, 32.0, 20.0), black())
			let traced = trace(disc)
			assert traced.paths.len() == 1
			let path = traced.paths[0].path
			let b = path.bounds()
			// potrace itself gives 12.4, 12.2, 52.0, 52.0 for this disc.
			fail "disc bounds {b.left} {b.top} {b.right} {b.bottom}" unless near(b.left, 12.0, 1.0) && near(b.right, 52.0, 1.0) && near(b.top, 12.0, 1.0) && near(b.bottom, 52.0, 1.0)
			// Without joining, the curve follows every polygon side.
			let plain = trace(disc, detail = 1.0).paths[0]
			assert count(plain.path, PathVerb.Cubic) > count(path, PathVerb.Cubic)
			assert count(path, PathVerb.Cubic) >= 4 && count(path, PathVerb.Close) == 1
			assert path.contains(new Point(32.0, 32.0)) && !path.contains(new Point(5.0, 5.0))
			assert traced.points() > 0 && traced.width == 0.0
			let ring = picture((x, y) => inCircle(x, y, 32.0, 32.0, 20.0) && !inCircle(x, y, 32.0, 32.0, 10.0), black())
			let ringTrace = trace(ring)
			assert ringTrace.paths.len() == 1
			let rp = ringTrace.paths[0].path
			assert count(rp, PathVerb.Close) == 2
			assert rp.contains(new Point(32.0, 17.0)) && !rp.contains(new Point(32.0, 32.0))
		}

		// Two colours give two paths in their colours; a square keeps its corners
		// as lines; a speck is dropped unless specks allows it.
		@test()
		def shapesSortColoursAndCorners() {
			let red = new Color(RGBA{r: byte(220), g: byte(20), b: byte(20), a: byte(255)})
			let img = picture((x, y) => x >= 4 && x < 28 && y >= 4 && y < 28, red)
			let px = img.raw()
			for let y = 36; y < 60; y++ {
				for let x = 36; x < 60; x++ {
					let o = img.pixelOffset(x, y)
					px[o] = byte(20)
					px[o + 1] = byte(20)
					px[o + 2] = byte(220)
					px[o + 3] = byte(255)
				}
			}
			// One stray pixel.
			let dot = img.pixelOffset(2, 60)
			px[dot] = byte(20)
			px[dot + 1] = byte(20)
			px[dot + 2] = byte(220)
			px[dot + 3] = byte(255)
			let traced = trace(img)
			assert traced.paths.len() == 2
			let reds = 0
			for let (_, p) in traced.paths {
				let c = p.color.rgba
				reds++ when int(c.r) > 128
				let b = p.path.bounds()
				if int(c.r) > 128 {
					assert near(b.left, 4.0, 0.6) && near(b.right, 28.0, 0.6) && near(b.top, 4.0, 0.6) && near(b.bottom, 28.0, 0.6)
				} else {
					assert near(b.left, 36.0, 0.6) && near(b.right, 60.0, 0.6)
				}
				assert count(p.path, PathVerb.Cubic) == 0
				assert count(p.path, PathVerb.Line) >= 4
			}
			assert reds == 1
			assert trace(img, specks = 1).paths.len() == 3 || trace(img, specks = 1).paths.len() == 2
			let kept = trace(img, specks = 1)
			let blue = 0
			for let (_, p) in kept.paths {
				blue += count(p.path, PathVerb.Close) when int(p.color.rgba.b) > 128
			}
			assert blue == 2
		}

		// A bar on an opaque page is one line of its width; two crossing bars are
		// two lines through the junction; a ring is one closed line.
		@test()
		def linesFollowStrokes() !none {
			let bar = picture((x, y) => x >= 10 && x < 54 && y >= 31 && y < 34, black(), true)
			let traced = trace(bar, mode = TraceMode.Lines)
			assert traced.paths.len() == 1
			let p = traced.paths[0]
			assert near(p.width, 3.0, 0.4) && near(traced.width, 3.0, 0.4)
			let b = p.path.bounds()
			assert b.left < 14.0 && b.right > 50.0 && near(b.top, 32.5, 1.0) && near(b.bottom, 32.5, 1.0)
			assert count(p.path, PathVerb.Close) == 0
			let cross = picture((x, y) => (x >= 10 && x < 54 && y >= 31 && y < 34) || (y >= 10 && y < 54 && x >= 31 && x < 34), black(), true)
			let crossed = trace(cross, mode = TraceMode.Lines)
			assert crossed.paths.len() == 2
			for let (_, line) in crossed.paths {
				let lb = line.path.bounds()
				assert (lb.right - lb.left > 36.0) != (lb.bottom - lb.top > 36.0)
				assert near(line.width, 3.0, 0.4)
			}
			let ring = picture((x, y) => inCircle(x, y, 32.0, 32.0, 20.0) && !inCircle(x, y, 32.0, 32.0, 17.0), black(), true)
			let loop = trace(ring, mode = TraceMode.Lines)
			if loop.paths.len() != 1 {
				let what = ""
				for let (_, lp0) in loop.paths {
					let lb0 = lp0.path.bounds()
					what += " [{lb0.left} {lb0.top} {lb0.right} {lb0.bottom} w{lp0.width} close{count(lp0.path, PathVerb.Close)}]"
				}
				fail "ring gave {loop.paths.len()} lines:{what}"
			}
			let lp = loop.paths[0]
			assert count(lp.path, PathVerb.Close) == 1
			let rb = lp.path.bounds()
			assert near(rb.left, 13.5, 1.5) && near(rb.right, 50.5, 1.5)
			assert near(lp.width, 3.0, 0.6)
		}

		// A ring with a bar through it: the ring stays one closed line through
		// both junctions, the bar one line.
		@test()
		def linesRunThroughJunctions() {
			let img = picture((x, y) => (inCircle(x, y, 32.0, 32.0, 24.0) && !inCircle(x, y, 32.0, 32.0, 20.0)) || (x >= 30 && x < 34 && y >= 8 && y < 56), black(), true)
			let traced = trace(img, mode = TraceMode.Lines)
			assert traced.paths.len() == 2
			let closed = 0
			for let (_, l) in traced.paths {
				closed += count(l.path, PathVerb.Close)
				let b = l.path.bounds()
				assert (b.right - b.left > 36.0) || (b.right - b.left < 3.0 && b.bottom - b.top > 30.0)
			}
			assert closed == 1
		}

		// Two strokes that touch: a roof over a U, four pixels wide. The roof's
		// eaves survive thinning, the roof runs through the junctions as one
		// open line with a corner at the apex, the U is one open line of three
		// straight runs.
		@test()
		def linesKeepShortEnds() {
			let onStroke = def (x int, y int, ax float, ay float, bx float, by float) bool {
				let (px, py) = (float(x) + 0.5, float(y) + 0.5)
				let (dx, dy) = (bx - ax, by - ay)
				let t = (((px - ax) * dx + (py - ay) * dy) / (dx * dx + dy * dy)).clamp(0.0, 1.0)
				let (qx, qy) = (ax + t * dx, ay + t * dy)
				return (px - qx) * (px - qx) + (py - qy) * (py - qy) <= 4.0
			}
			let img = picture((x, y) => onStroke(x, y, 10.0, 30.0, 32.0, 8.0) || onStroke(x, y, 32.0, 8.0, 54.0, 30.0) || onStroke(x, y, 16.0, 24.0, 16.0, 52.0) || onStroke(x, y, 16.0, 52.0, 48.0, 52.0) || onStroke(x, y, 48.0, 52.0, 48.0, 24.0), black(), true)
			let traced = trace(img, mode = TraceMode.Lines, detail = 0.4, corners = 0.7)
			assert traced.paths.len() == 2
			let roofs = 0
			for let (_, l) in traced.paths {
				assert count(l.path, PathVerb.Close) == 0
				assert near(l.width, 4.0, 0.8)
				let b = l.path.bounds()
				if b.top < 12.0 {
					roofs++
					assert near(b.left, 10.0, 3.0) && near(b.right, 54.0, 3.0) && near(b.bottom, 30.0, 3.0)
					assert count(l.path, PathVerb.Line) == 2 && count(l.path, PathVerb.Cubic) == 0
				} else {
					assert near(b.bottom, 52.0, 3.0) && near(b.left, 16.0, 3.0) && near(b.right, 48.0, 3.0)
					assert count(l.path, PathVerb.Line) == 3 && count(l.path, PathVerb.Cubic) == 0
				}
			}
			assert roofs == 1
		}

		// A ring with a bar hanging from it: the ring is one closed curve, the
		// bar one open line, and the two are not run together at the junction.
		@test()
		def linesCloseRingsAtJunctions() !none {
			let img = picture((x, y) => (inCircle(x, y, 32.0, 24.0, 14.0) && !inCircle(x, y, 32.0, 24.0, 10.0)) || (x >= 30 && x < 34 && y >= 36 && y < 60), black(), true)
			let traced = trace(img, mode = TraceMode.Lines)
			if traced.paths.len() != 2 {
				let what = ""
				for let (_, p) in traced.paths {
					let b = p.path.bounds()
					what += " [{b.left} {b.top} {b.right} {b.bottom} close{count(p.path, PathVerb.Close)}]"
				}
				fail "ring and bar gave {traced.paths.len()} lines:{what}"
			}
			let rings = 0
			for let (_, p) in traced.paths {
				let b = p.path.bounds()
				if count(p.path, PathVerb.Close) == 1 {
					rings++
					assert near(b.left, 20.0, 1.5) && near(b.right, 44.0, 1.5) && near(b.top, 12.0, 1.5) && near(b.bottom, 36.0, 1.5)
					assert count(p.path, PathVerb.Cubic) >= 1 && count(p.path, PathVerb.Line) == 0
				} else {
					assert near(b.left, 32.0, 1.0) && near(b.right, 32.0, 1.0) && b.top > 34.0 && b.top < 40.0 && near(b.bottom, 58.0, 2.5)
				}
				assert near(p.width, 4.0, 0.5)
			}
			assert rings == 1
		}

		// A bar three and a half pixels wide with antialiased edges measures
		// its width from the edge pixels' coverage: by alpha on a transparent
		// page, by the distance from the page's colour on an opaque one.
		@test()
		def linesMeasureAntialiasedWidth() {
			let cover = def (x int, y int) float {
				return 0.0 when y < 10 || y >= 54
				let (left, right) = (float(x).max(10.25), float(x + 1).min(13.75))
				return (right - left).max(0.0)
			}
			let clear = new image.Image(64, 64)
			let page = new image.Image(64, 64)
			let (cp, pp) = (clear.raw(), page.raw())
			for let y = 0; y < 64; y++ {
				for let x = 0; x < 64; x++ {
					let c = cover(x, y)
					let o = clear.pixelOffset(x, y)
					cp[o + 3] = byte((c * 255.0).round())
					let grey = byte(((1.0 - c) * 255.0).round())
					pp[o] = grey
					pp[o + 1] = grey
					pp[o + 2] = grey
					pp[o + 3] = byte(255)
				}
			}
			for let (_, img) in [clear, page] {
				let traced = trace(img, mode = TraceMode.Lines)
				assert traced.paths.len() == 1
				assert near(traced.paths[0].width, 3.5, 0.15) && near(traced.width, 3.5, 0.15)
				let b = traced.paths[0].path.bounds()
				assert near(b.left, 12.0, 0.6) && near(b.right, 12.0, 0.6)
			}
		}

		// Snapping rounds every coordinate to the step.
		@test()
		def snapRoundsPoints() {
			let disc = picture((x, y) => inCircle(x, y, 32.0, 32.0, 20.0), black())
			let traced = trace(disc, snap = 0.5)
			for let (_, c) in traced.paths[0].path.coords {
				assert near((c * 2.0).round(), c * 2.0, 1e-9)
			}
			assert trace(new image.Image(8, 8)).paths.len() == 0
		}
	}
}
