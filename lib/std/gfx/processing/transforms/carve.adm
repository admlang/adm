partial module std.gfx.processing.transform {
	use (
		std.gfx::(Raster)
		std.gfx.processing.analysis
		std.simd
		std.mem
		std.math.geom
	)

	// Content-aware resizing (seam carving) behind `resize` with
	// `ResizeMode.ContentAware`. The image loses or gains the lowest-energy
	// top-to-bottom paths -- energy is the luminance gradient a removal
	// creates plus the saliency map -- width first, then height on the
	// transposed image.

	// Seam carving to exactly `w` x `h`: width first, then height (by
	// carving the transposed image). The energy is the luminance gradient
	// plus the saliency map, so a smooth subject (a car body) is not the
	// cheapest thing to remove just because it is smooth.
	internal def carve(target Raster, w, h int) Raster {
		let sw = int(target.size().width)
		let sh = int(target.size().height)
		return target when sw == 0 || sh == 0
		let importance = analysis.saliencyMap(target)
		let buf = tightCopy(target)
		buf = carveWidth(buf, sw, sh, w, importance, false)
		let t = transposeRGBA(buf, w, sh)
		t = carveWidth(t, sh, w, h, importance, true)
		buf = transposeRGBA(t, h, w)
		target.reshape(buf, new geom.Size<uint>(uint(w), uint(h)), w * 4)
		return target
	}

	// Removes or inserts vertical seams until the buffer is `tw` wide.
	//
	// The working state -- pixels and luminance, plus original columns when
	// enlarging -- keeps the original row stride while the logical width
	// shrinks, so removing a seam shifts only the tail of each row
	// (removeSeams); gradients are read off the luminance where they are
	// needed rather than stored. Seams come from findSeams: on anything but
	// a small image the dynamic-programming pass runs on a downscaled copy
	// and each seam is then refined at full resolution inside a narrow
	// band around it.
	internal def carveWidth(buf byte[], w, h, tw int, importance float[], transposed bool) byte[] {
		return buf when tw == w
		let lum = luminanceOf(buf, w, h)
		if tw < w {
			let columns int32[]
			let insertions int[]
			removeUntil(buf, lum, columns, insertions, w, h, tw, importance, transposed)
			return tightRows(buf, w, tw, h)
		}
		// Enlarging: find the `tw - w` lowest seams on a shrinking copy while
		// tracking original columns, then duplicate those columns in place.
		let ps = w + 2
		let columns int32[]
		columns.len(ps * h)
		for let y = 0; y < h; y++ {
			for let x = 0; x < w; x++ {
				columns[y * ps + 1 + x] = int32(x)
			}
		}
		// insertions[y * w + x] counts how many copies to add after (x, y).
		let insertions int[]
		insertions.len(w * h)
		let work = byte[]
		work.len(w * h * 4)
		mem.copyN(work, buf, w * h * 4)
		removeUntil(work, lum, columns, insertions, w, h, w - (tw - w), importance, transposed)
		let out = byte[]
		out.len(tw * h * 4)
		for let y = 0; y < h; y++ {
			let ox = 0
			for let x = 0; x < w; x++ {
				let s = (y * w + x) * 4
				let d = (y * tw + ox) * 4
				out[d] = buf[s]
				out[d + 1] = buf[s + 1]
				out[d + 2] = buf[s + 2]
				out[d + 3] = buf[s + 3]
				ox += 1
				let copies = insertions[y * w + x]
				for let c = 0; c < copies; c++ {
					// The inserted pixel averages its neighbours so the
					// duplicate does not read as a hard stripe.
					let nx = (x + 1).min(w - 1)
					let n = (y * w + nx) * 4
					let e2 = (y * tw + ox) * 4
					for let ch = 0; ch < 4; ch++ {
						out[e2 + ch] = byte((int(buf[s + ch]) + int(buf[n + ch])) / 2)
					}
					ox += 1
				}
			}
		}
		return out
	}

	// Carves seams out of the working state until it is `tw` wide. `w` is
	// the row stride of `buf` (in pixels) and `w + 2` that of the int32
	// grids, which carry one pad column on each side. `columns` is empty
	// unless original columns are tracked, in which case every removed
	// pixel is counted in `insertions`.
	//
	// A pass takes a batch of non-overlapping seams when the image offers
	// them (flat regions do); on a photo the cheap seams all funnel into
	// one corridor and a batch yields a single seam, so after such a pass
	// the batch size drops to one until the next re-stretch tries again.
	internal def removeUntil(buf byte[], lum, columns int32[], insertions int[], w, h, tw int, importance float[], transposed bool) {
		let ps = w + 2
		let cw = w
		let sinceStretch = 0
		let stretchEvery = 0
		let want = 1
		let scratch = new seamScratch(w, h, importance, transposed)
		for cw > tw {
			if sinceStretch >= stretchEvery {
				stretchEvery = (cw / 32).max(1)
				sinceStretch = 0
				want = batchFor(cw, cw - tw)
			}
			want = want.min(cw - tw)
			let seams = findSeams(lum, ps, cw, h, want, scratch)
			let count = seams.len() / h
			want = 1 when count < 2
			if columns.len() > 0 {
				for let y = 0; y < h; y++ {
					for let k = 0; k < count; k++ {
						insertions[y * w + int(columns[y * ps + 1 + seams[k * h + y]])] += 1
					}
				}
			}
			removeSeams(buf, lum, columns, w, cw, h, seams, count)
			for let y = 0; y < h; y++ {
				let leftmost = seams[y]
				for let k = 1; k < count; k++ {
					leftmost = seams[k * h + y] when seams[k * h + y] < leftmost
				}
				scratch.dirtyFrom[y] = leftmost when leftmost < scratch.dirtyFrom[y]
			}
			cw -= count
			sinceStretch += count
		}
	}

	// Seams to take from one pass: a slice of the width, never more than
	// still needed, at least one.
	internal def batchFor(width, needed int) int {
		return (width / 32).clamp(1, needed.max(1))
	}

	// Rows of `rows` in 64-row blocks for `forall`, so a task amortises its
	// dispatch over a run of rows.
	internal def rowBlocks(rows int) int {
		return (rows + 63) / 64
	}

	// Luminance per pixel in a padded grid (stride w + 2, data from column
	// 1); the pad columns replicate the edge pixel so a gradient at the
	// border reads its own value, and the eight-lane loops never look past
	// the row.
	internal def luminanceOf(buf byte[], w, h int) int32[] {
		let ps = w + 2
		let lum int32[]
		lum.len(ps * h)
		forall let b in 0..rowBlocks(h) {
			let yEnd = ((b + 1) * 64).min(h)
			for let y = b * 64; y < yEnd; y++ {
				let row = y * ps + 1
				let src = y * w * 4
				for let x = 0; x < w; x++ {
					let o = src + x * 4
					lum[row + x] = int32((77 * int(buf[o]) + 150 * int(buf[o + 1]) + 29 * int(buf[o + 2])) >> 8)
				}
				lum[row - 1] = lum[row]
				lum[row + w] = lum[row + w - 1]
			}
		}
		return lum
	}

	// The saliency term, scaled to the gradient's range (0..510), stretched
	// over a `cw` x `h` image. `terms` is the saliency map in the orientation
	// being carved and `cell` maps a column to its map column; `at` reads
	// one pixel that way. The map has only `saliencyGrid` distinct rows, so
	// for the vector pass `rows` holds one stretched row per map row and a
	// pixel row reads the one it falls in (offset).
	internal type saliencyRows {
		terms int32[]
		cell  int[]
		rows  int32[]
		cw    int
		h     int

		def new(capacity int, importance float[], transposed bool) {
			let grid = analysis.saliencyGrid
			terms.len(grid * grid)
			for let gy = 0; gy < grid; gy++ {
				for let gx = 0; gx < grid; gx++ {
					let sal = importance[gy * grid + gx]
					sal = importance[gx * grid + gy] when transposed
					terms[gy * grid + gx] = int32(sal * 510.0)
				}
			}
			cell.len(capacity)
			rows.len(grid * capacity)
		}

		// Re-maps the columns of a `width` x `height` image.
		def fit(width, height int) {
			cw = width
			h = height
			let grid = analysis.saliencyGrid
			for let x = 0; x < cw; x++ {
				cell[x] = (x * grid) / cw
			}
		}

		// Re-maps like fit and rebuilds `rows` for the vector pass.
		def stretch(width, height int) {
			fit(width, height)
			let grid = analysis.saliencyGrid
			for let gy = 0; gy < grid; gy++ {
				let src = gy * grid
				let row = gy * cw
				for let x = 0; x < cw; x++ {
					rows[row + x] = terms[src + cell[x]]
				}
			}
		}

		// The map row pixel row `y` falls in, as an offset into `terms`.
		def mapRow(y int) int {
			return ((y * analysis.saliencyGrid) / h) * analysis.saliencyGrid
		}

		// The saliency term of (x, y).
		def at(y, x int) int32 {
			return terms[mapRow(y) + cell[x]]
		}

		// Where pixel row `y` starts in `rows`; column x is at offset + x.
		def offset(y int) int {
			return ((y * analysis.saliencyGrid) / h) * cw
		}
	}

	// The impassable value in the pad columns of the cost table. A step
	// adds at most a few thousand to it, which is still far above any real
	// path and far below int32 overflow.
	internal def wallCost() int32 {
		return int32(1000000000)
	}

	// Working memory for findSeams, sized once for the original image so a
	// pass allocates nothing large. The coarse grids and the cost table use
	// the same padded layout as `lum`.
	internal type seamScratch {
		sal       saliencyRows
		cost      int32[]
		clum      int32[]
		csal      saliencyRows
		cps       int
		// Per coarse row, the first coarse column whose luminance is stale;
		// cells left of the leftmost removed pixel keep their value.
		dirtyFrom int[]
		step      int32[]
		band      int32[]
		bandFrom  byte[]

		def new(w, h int, importance float[], transposed bool) {
			let ps = w + 2
			sal = new saliencyRows(w, importance, transposed)
			cost.len(ps * h)
			cps = (w + 1) / 2 + 2
			let ch = (h + 1) / 2
			clum.len(cps * ch)
			csal = new saliencyRows(cps, importance, transposed)
			dirtyFrom.len(h)
			step.len(3)
			band.len(bandWidth(coarseFactor(w)) * h)
			bandFrom.len(bandWidth(coarseFactor(w)) * h)
		}
	}

	// How much a `cw`-wide image is shrunk for the seam search: a small
	// image is searched as is; a larger one at half size (both axes), with
	// the seams refined at full size afterwards.
	internal def coarseFactor(cw int) int {
		return 1 when cw < 256
		return 2
	}

	// Columns in the refinement band: `2 * factor` on each side of the
	// coarse seam's centre, which covers the whole coarse cell and its
	// neighbours.
	internal def bandWidth(factor int) int {
		return 4 * factor + 1
	}

	// Up to `want` non-overlapping seams through the current `cw` x `h`
	// image, flat like lowestSeams. A small image runs the full-resolution
	// pass directly. Otherwise the luminance is box-filtered by
	// `coarseFactor`, the pass runs on that, and refineSeam turns each
	// coarse seam into a full-resolution one inside a band around it; a
	// refined seam that touches one already taken is dropped.
	internal def findSeams(lum int32[], ps, cw, h, want int, s seamScratch) int[] {
		let factor = coarseFactor(cw)
		if factor == 1 {
			s.sal.stretch(cw, h)
			fullCosts(s.cost, lum, s.sal, ps, cw, h, s.step)
			return lowestSeams(s.cost, lum, s.sal, ps, cw, h, want, s.step)
		}
		s.sal.fit(cw, h)
		let ccw = (cw + factor - 1) / factor
		let ch = (h + factor - 1) / factor
		downsample(lum, ps, cw, h, s.clum, s.cps, ccw, ch, factor, s.dirtyFrom)
		s.csal.stretch(ccw, ch)
		fullCosts(s.cost, s.clum, s.csal, s.cps, ccw, ch, s.step)
		let coarse = lowestSeams(s.cost, s.clum, s.csal, s.cps, ccw, ch, want, s.step)
		let found = coarse.len() / ch
		let seams int[]
		seams.len(found * h)
		if found == 1 {
			refineSeam(lum, ps, cw, h, s.sal, coarse, 0, ch, factor, seams, 0, s)
			return seams
		}
		let taken byte[]
		taken.len(cw * h)
		let count = 0
		for let k = 0; k < found; k++ {
			refineSeam(lum, ps, cw, h, s.sal, coarse, k, ch, factor, seams, count, s)
			let free = true
			for let y = 0; y < h && free; y++ {
				free = taken[y * cw + seams[count * h + y]] == byte(0)
			}
			continue when !free
			// A margin of one keeps the next seam from crossing this one
			// diagonally, which removeSeams relies on.
			for let y = 0; y < h; y++ {
				let c = seams[count * h + y]
				taken[y * cw + c] = byte(1)
				taken[y * cw + c - 1] = byte(1) when c > 0
				taken[y * cw + c + 1] = byte(1) when c + 1 < cw
			}
			count += 1
		}
		seams.len(count * h)
		return seams
	}

	// Box-filters the `cw` x `h` luminance by `factor` into `out` (stride
	// `cps`, padded like `lum`): the block's rows are summed eight columns
	// at a time, then each block's columns are added up. A partial block at
	// the right or bottom edge averages the pixels it has. Only cells from
	// the block's `dirtyFrom` column on are touched, and the entries are
	// reset to clean.
	internal def downsample(lum int32[], ps, cw, h int, out int32[], cps, ccw, ch, factor int, dirtyFrom int[]) {
		forall let b in 0..rowBlocks(ch) {
			let column int32[]
			column.len(cw + 8)
			let yEnd = ((b + 1) * 64).min(ch)
			for let cy = b * 64; cy < yEnd; cy++ {
				let y0 = cy * factor
				let y1 = (y0 + factor).min(h)
				let rows = y1 - y0
				let start = cw
				for let y = y0; y < y1; y++ {
					start = dirtyFrom[y] when dirtyFrom[y] < start
					dirtyFrom[y] = cw
				}
				continue when start >= cw
				let x = (start / factor) * factor
				let first = x / factor
				for x + 8 <= cw {
					let sum = simd.load8(lum, y0 * ps + 1 + x)
					for let y = y0 + 1; y < y1; y++ {
						sum = simd.add(sum, simd.load8(lum, y * ps + 1 + x))
					}
					simd.store8(column, x, sum)
					x += 8
				}
				for x < cw {
					let sum = int32(0)
					for let y = y0; y < y1; y++ {
						sum += lum[y * ps + 1 + x]
					}
					column[x] = sum
					x += 1
				}
				let dst = cy * cps + 1
				let whole = ccw
				whole = ccw - 1 when ccw * factor > cw
				if factor == 2 && rows == 2 {
					for let cx = first; cx < whole; cx++ {
						out[dst + cx] = (column[2 * cx] + column[2 * cx + 1]) >> 2
					}
				} else {
					for let cx = first; cx < whole; cx++ {
						let sum = int32(0)
						for let i = 0; i < factor; i++ {
							sum += column[cx * factor + i]
						}
						out[dst + cx] = sum / int32(rows * factor)
					}
				}
				if whole < ccw {
					let x0 = whole * factor
					let sum = int32(0)
					for let i = x0; i < cw; i++ {
						sum += column[i]
					}
					out[dst + whole] = sum / int32(rows * (cw - x0))
				}
				out[dst - 1] = out[dst]
				out[dst + ccw] = out[dst + ccw - 1]
			}
		}
	}

	// Rebuilds the whole cost table for a `cw` x `h` grid.
	//
	// Forward energy: a step is charged for the gradient it *creates* --
	// removing (y, x) makes (y, x-1) and (y, x+1) neighbours, and arriving
	// diagonally also joins (y-1, x) to the side it came from. Charging
	// removed gradient instead concentrates seams in the smoothest band and
	// leaves a visible discontinuity at its edge. The pixel's saliency
	// weight is added on top so subjects are avoided.
	internal def fullCosts(cost, lum int32[], sal saliencyRows, ps, cw, h int, step int32[]) {
		let wall = wallCost()
		cost[0] = wall
		cost[cw + 1] = wall
		let top = sal.offset(0)
		for let x = 0; x < cw; x++ {
			cost[1 + x] = sal.rows[top + x]
		}
		for let y = 1; y < h; y++ {
			let row = y * ps
			cost[row] = wall
			cost[row + cw + 1] = wall
			costRow(cost, lum, sal.rows, sal.offset(y), ps, y, cw, step)
		}
	}

	// The gradient a step into the pixel at padded index `here` creates:
	// straight, from the upper-left and from the upper-right, without the
	// saliency term.
	internal def stepCosts(lum int32[], ps, here int, out int32[]) {
		let l = lum[here - 1]
		let r = lum[here + 1]
		let up = lum[here - ps]
		let horizontal = r - l
		horizontal = -horizontal when horizontal < int32(0)
		let toLeft = up - l
		toLeft = -toLeft when toLeft < int32(0)
		let toRight = up - r
		toRight = -toRight when toRight < int32(0)
		out[0] = horizontal
		out[1] = horizontal + toLeft
		out[2] = horizontal + toRight
	}

	// Computes row `y` of the cost table from row `y - 1`, eight columns at
	// a time; the lanes read the pad columns, never past the row. The
	// row's saliency terms start at `weight[salRow]`.
	internal def costRow(cost, lum, weight int32[], salRow, ps, y, cw int, step int32[]) {
		let base = y * ps + 1
		let x = 0
		for x + 8 <= cw {
			let i = base + x
			let l = simd.load8(lum, i - 1)
			let r = simd.load8(lum, i + 1)
			let up = simd.load8(lum, i - ps)
			let horizontal = simd.add(simd.abs(simd.sub(r, l)), simd.load8(weight, salRow + x))
			let mid = simd.add(simd.load8(cost, i - ps), horizontal)
			let left = simd.add(simd.add(simd.load8(cost, i - ps - 1), simd.abs(simd.sub(up, l))), horizontal)
			let right = simd.add(simd.add(simd.load8(cost, i - ps + 1), simd.abs(simd.sub(up, r))), horizontal)
			simd.store8(cost, i, simd.min(simd.min(left, mid), right))
			x += 8
		}
		for x < cw {
			let here = base + x
			stepCosts(lum, ps, here, step)
			let sal = weight[salRow + x]
			let best = cost[here - ps] + step[0] + sal
			let viaLeft = cost[here - ps - 1] + step[1] + sal
			let viaRight = cost[here - ps + 1] + step[2] + sal
			best = viaLeft when viaLeft < best
			best = viaRight when viaRight < best
			cost[here] = best
			x += 1
		}
	}

	// Up to `want` lowest-cost top-to-bottom seams that share no pixel,
	// read off the cost table. Returned flat: seam k occupies
	// [k*h, (k+1)*h), one column per row. The seam is recovered by
	// re-testing which predecessor produced each cost, so no predecessor
	// table is kept.
	internal def lowestSeams(cost, lum int32[], sal saliencyRows, ps, cw, h, want int, step int32[]) int[] {
		let last = (h - 1) * ps + 1
		let seams int[]
		seams.len(want * h)
		if want == 1 {
			let bx = 0
			for let x = 1; x < cw; x++ {
				bx = x when cost[last + x] < cost[last + bx]
			}
			backtrack(cost, lum, sal, ps, h, bx, seams, 0, step)
			seams.len(h)
			return seams
		}
		// Candidates in ascending end cost, only as many as could plausibly
		// be taken. A seam that comes within `spread` columns of one already
		// taken is skipped: in a flat region every cheap seam has the same
		// shape one column over, and taking them together would carve a
		// band out of the image and shear it.
		let limit = (want * 4).min(cw)
		let order = cheapestColumns(cost, last, cw, limit)
		let spread = (cw / (want * 3)).max(2)
		let taken byte[]
		taken.len(cw * h)
		let count = 0
		for let i = 0; i < limit && count < want; i++ {
			continue when !backtrackFree(cost, lum, sal, ps, cw, h, order[i], seams, count, taken, step)
			for let y = 0; y < h; y++ {
				let c = seams[count * h + y]
				let lo = (c - spread).max(0)
				let hi = (c + spread).min(cw - 1)
				for let t = lo; t <= hi; t++ {
					taken[y * cw + t] = byte(1)
				}
			}
			count += 1
		}
		seams.len(count * h)
		return seams
	}

	// The `limit` columns with the lowest cost in the row at padded offset
	// `base`, cheapest first: a partial selection, since only a handful of
	// the width is ever tried.
	internal def cheapestColumns(cost int32[], base, cw, limit int) int[] {
		let order int[]
		order.len(limit)
		let n = 0
		for let x = 0; x < cw; x++ {
			let c = cost[base + x]
			continue when n == limit && c >= cost[base + order[n - 1]]
			let j = n
			j = n - 1 when n == limit
			for j > 0 && cost[base + order[j - 1]] > c {
				order[j] = order[j - 1]
				j -= 1
			}
			order[j] = x
			n += 1 when n < limit
		}
		return order
	}

	// The column the seam ending at (y, sx) came from: whichever neighbour
	// carried this cost, the straight one first on ties.
	internal def predecessor(cost, lum int32[], sal saliencyRows, ps, y, sx int, step int32[]) int {
		let here = y * ps + 1 + sx
		stepCosts(lum, ps, here, step)
		let need = cost[here] - sal.rows[sal.offset(y) + sx]
		let prev = here - ps
		return sx when cost[prev] + step[0] == need
		return sx - 1 when cost[prev - 1] + step[1] == need
		return sx + 1
	}

	// Writes the seam ending at column `sx` of the last row into slot `k`.
	internal def backtrack(cost, lum int32[], sal saliencyRows, ps, h, sx int, seams int[], k int, step int32[]) {
		for let y = h - 1; y >= 0; y-- {
			seams[k * h + y] = sx
			sx = predecessor(cost, lum, sal, ps, y, sx, step) when y > 0
		}
	}

	// Like backtrack, but stops and reports false at the first pixel already
	// claimed in `taken`.
	internal def backtrackFree(cost, lum int32[], sal saliencyRows, ps, cw, h, sx int, seams int[], k int, taken byte[], step int32[]) bool {
		for let y = h - 1; y >= 0; y-- {
			return false when taken[y * cw + sx] != byte(0)
			seams[k * h + y] = sx
			sx = predecessor(cost, lum, sal, ps, y, sx, step) when y > 0
		}
		return true
	}

	// Turns coarse seam `k` (of `ch` rows, found at 1/`factor` scale) into
	// a full-resolution seam in slot `slot` of `seams`: a dynamic-programming
	// pass restricted to the band of bandWidth columns centred on the
	// coarse seam's column in each row, with the same forward energy and
	// saliency as the full pass and walls outside the band.
	internal def refineSeam(lum int32[], ps, cw, h int, sal saliencyRows, coarse int[], k, ch, factor int, seams int[], slot int, s seamScratch) {
		let bw = bandWidth(factor)
		let r = bw / 2
		let wall = wallCost()
		let band = s.band
		let from = s.bandFrom
		let step = s.step
		let centre = coarse[k * ch] * factor
		for let y = 0; y < h; y++ {
			let c = coarse[k * ch + y / factor] * factor
			let mapRow = sal.mapRow(y)
			let row = y * bw
			for let j = 0; j < bw; j++ {
				let x = c - r + j
				if x < 0 || x >= cw {
					band[row + j] = wall
					continue
				}
				let weight = sal.terms[mapRow + sal.cell[x]]
				if y == 0 {
					band[row + j] = weight
					continue
				}
				let here = y * ps + 1 + x
				stepCosts(lum, ps, here, step)
				// The predecessor's band index: its own centre may differ.
				let pj = x - centre + r
				let best = wall
				let via = byte(1)
				if pj >= 0 && pj < bw {
					best = band[row - bw + pj] + step[0]
				}
				if pj - 1 >= 0 && pj - 1 < bw {
					let viaLeft = band[row - bw + pj - 1] + step[1]
					if viaLeft < best {
						best = viaLeft
						via = byte(0)
					}
				}
				if pj + 1 >= 0 && pj + 1 < bw {
					let viaRight = band[row - bw + pj + 1] + step[2]
					if viaRight < best {
						best = viaRight
						via = byte(2)
					}
				}
				band[row + j] = best + weight
				from[row + j] = via
			}
			centre = c
		}
		let last = (h - 1) * bw
		let bj = 0
		for let j = 1; j < bw; j++ {
			bj = j when band[last + j] < band[last + bj]
		}
		for let y = h - 1; y >= 0; y-- {
			let c = coarse[k * ch + y / factor] * factor
			seams[slot * h + y] = c - r + bj
			if y > 0 {
				let pc = coarse[k * ch + (y - 1) / factor] * factor
				let x = c - r + bj
				x += int(from[y * bw + bj]) - 1
				bj = x - pc + r
			}
		}
	}

	// Removes `count` seams (flat, as lowestSeams returns) from every grid
	// in place: each row's segments between seam pixels shift left so the
	// logical width drops by `count` while the stride stays, and the
	// luminance pad column moves in.
	internal def removeSeams(buf byte[], lum, columns int32[], w, cw, h int, seams int[], count int) {
		let ps = w + 2
		let nw = cw - count
		// Seams never cross, so their left-to-right order in the first row
		// holds in every row.
		let order int[]
		order.len(count)
		for let k = 0; k < count; k++ {
			let j = k
			for j > 0 && seams[order[j - 1] * h] > seams[k * h] {
				order[j] = order[j - 1]
				j -= 1
			}
			order[j] = k
		}
		let tracked = columns.len() > 0
		forall let b in 0..rowBlocks(h) {
			let yEnd = ((b + 1) * 64).min(h)
			for let y = b * 64; y < yEnd; y++ {
				let row = y * ps + 1
				for let j = 0; j < count; j++ {
					let c = seams[order[j] * h + y]
					let from = c + 1
					let to = cw
					to = seams[order[j + 1] * h + y] when j + 1 < count
					let n = to - from
					continue when n <= 0
					let dst = row + from - (j + 1)
					shiftLeft(lum, dst, row + from, n)
					shiftLeft(columns, dst, row + from, n) when tracked
					let pd = (y * w + from - (j + 1)) * 4
					let pf = (y * w + from) * 4
					mem.moveN(buf[pd:pd + n * 4], buf[pf:pf + n * 4], n * 4)
				}
				lum[row + nw] = lum[row + nw - 1]
			}
		}
	}

	// Moves `n` lanes from `src` down to `dst` (dst < src) within one grid.
	internal def shiftLeft(grid int32[], dst, src, n int) {
		let i = 0
		for i + 8 <= n {
			simd.store8(grid, dst + i, simd.load8(grid, src + i))
			i += 8
		}
		for i < n {
			grid[dst + i] = grid[src + i]
			i += 1
		}
	}

	// The first `tw` pixels of every row of a `w`-stride buffer, tight.
	internal def tightRows(buf byte[], w, tw, h int) byte[] {
		let out = byte[]
		out.len(tw * h * 4)
		for let y = 0; y < h; y++ {
			mem.copyN(out[y * tw * 4:(y + 1) * tw * 4], buf[y * w * 4:y * w * 4 + tw * 4], tw * 4)
		}
		return out
	}

	// The raster's pixels in a tight w*4-stride buffer.
	internal def tightCopy(target Raster) byte[] {
		let w = int(target.size().width)
		let h = int(target.size().height)
		let stride = target.stride()
		let data = target.raw()
		let out = byte[]
		out.len(w * h * 4)
		for let y = 0; y < h; y++ {
			mem.copyN(out[y * w * 4:(y + 1) * w * 4], data[y * stride:y * stride + w * 4], w * 4)
		}
		return out
	}

	// A w x h tight buffer transposed to h x w.
	internal def transposeRGBA(buf byte[], w, h int) byte[] {
		let out = byte[]
		out.len(w * h * 4)
		for let y = 0; y < h; y++ {
			for let x = 0; x < w; x++ {
				let s = (y * w + x) * 4
				let d = (x * h + y) * 4
				out[d] = buf[s]
				out[d + 1] = buf[s + 1]
				out[d + 2] = buf[s + 2]
				out[d + 3] = buf[s + 3]
			}
		}
		return out
	}
}
