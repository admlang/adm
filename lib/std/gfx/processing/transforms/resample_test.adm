partial module std.gfx.processing.transform {
	use (
		std.testing
		std.formats.image
	)

	// Noise over a gradient, with every eleventh pixel transparent.
	internal def resampleNoise(w int, h int, seed int) image.Image {
		let img = new image.Image(w, h)
		let px = img.raw()
		let s = uint32(seed)
		for let y = 0; y < h; y++ {
			for let x = 0; x < w; x++ {
				let o = img.pixelOffset(x, y)
				for let c = 0; c < 4; c++ {
					s = s * uint32(1664525) + uint32(1013904223)
					let v = (x * 7 + y * 3 + c * 40) % 256 / 2 + int(s >> 25)
					px[o + c] = byte(v.clamp(0, 255))
				}
				px[o + 3] = byte(0) when (x + y) % 11 == 0
			}
		}
		return img
	}

	internal def bytesChecksum(data byte[]) string {
		let h = uint64(14695981039346656037)
		for let (_, b) in data {
			h = (h ^ uint64(b)) * uint64(1099511628211)
		}
		return h.hex()
	}

	check "Resample" {
		@test()
		def outputs_stay_pinned() {
			// Pinned when the separable SIMD passes were checked against the
			// scalar resampler they replaced (within 1, mostly identical).
			let img = resampleNoise(640, 380, 5)
			let modes = [ResizeMode.NearestNeighbor, ResizeMode.Bilinear, ResizeMode.Bicubic, ResizeMode.Area]
			let shrunk = ["39C060EA1A16FCBE", "E4BC1181237BA33C", "74EBEF0CBBA279F0", "AC9B2469FE62195B"]
			let grown = ["F13FF871AEC45A24", "EA881D98F8D28256", "6BB8F9F5CDD7D03A", "A4492B8730030C6"]
			for let i = 0; i < modes.len(); i++ {
				assert bytesChecksum(resample(img, 211, 97, modes[i])) == shrunk[i]
				assert bytesChecksum(resample(img, 1000, 777, modes[i])) == grown[i]
			}
		}
	}
}
