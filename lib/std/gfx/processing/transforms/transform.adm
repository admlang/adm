partial module std.gfx.processing.transform {
	use (
		std.gfx::(Raster)
		std.gfx.color
		std.math::(Pi, cos, sin)
		std.gfx.processing.analysis
		std.simd
		std.mem
		std.math.geom
		std.gfx.processing.transform.seams::*
		std.gfx.bands::*
		std.gfx.processing.transform.resampling::*
	)

	// Every transform edits `target` in place (through Raster.reshape when
	// the geometry changes) and returns it, so calls nest; `processing.Pipeline`
	// chains them.

	// ResizeMode represents the algorithm used to resize an image.
	enum ResizeMode {
		// Fastest, preserves hard pixel edges.
		// Best for pixel art, masks, indexed images, or when you explicitly don't want smoothing.
		// Usually looks bad for photographs.
		NearestNeighbor,
		// Fast and reasonably smooth.
		// Best general-purpose choice when speed matters more than maximum quality.
		Bilinear,
		// Slower, but usually sharper and better-looking than bilinear.
		// Good default for photographs/UI images when quality matters.
		Bicubic
		// It uses seam carving to change dimensions while trying to preserve important content instead of
		// uniformly scaling everything.
		// Best when changing aspect ratio or dimensions without squashing the subject.
		ContentAware,
		// Averages every source pixel a target pixel covers, weighted by alpha
		// so transparent pixels do not darken the edges.
		// Best for shrinking by large factors (icons, thumbnails): nothing aliases.
		Area,
	}

	// FitMode is how fit places an image in a box: Cover fills the box and crops
	// the overflow, Contain fits the whole image inside, ScaleToFit stretches it
	// to the box, and the remaining modes as their names say.
	enum FitMode {
		Cover,
		Contain,
		ScaleToFit,
		ScaleToFill,
		FitWidth,
		FitHeight,
		CenterCrop,
		// Crop using Saliency detection
		SmartCrop,
		Stretch,
		Tile,
	}

	// Axis represents the direction of a 2D axis.
	enum Axis {
		Horizontal,
		Vertical
	}

	// Reverses eight RGBA pixels within a 32-byte group.
	// The lanes that reverse four pixels in a 16-byte vector.
	internal const imgReversePixels = byte[12, 13, 14, 15, 8, 9, 10, 11, 4, 5, 6, 7, 0, 1, 2, 3]

	// Mirrors this image in place across the given axis and returns it.
	// `Axis.Horizontal` mirrors left to right, `Axis.Vertical` top to
	// bottom.
	def flip(target Raster, axis Axis) Raster {
		let w = int(target.size().width)
		let h = int(target.size().height)
		let stride = target.stride()
		let data = target.raw()

		let rowBytes = w * 4
		let out = byte[]
		out.len(h * rowBytes)

		if axis == Axis.Vertical {
			// Whole rows move, so this is a row-order reversal.
			forRows(w, h, def (from int, to int) {
				for let y = from; y < to; y++ {
					copyRow(out, (h - 1 - y) * rowBytes, data, y * stride, rowBytes)
				}
			})
			target.reshape(out, target.size(), rowBytes)
			return target
		}

		// Mirroring a row reverses four-byte groups, one shuffle per four
		// pixels (a 16-byte vector's shuffle is one instruction; a 32-byte
		// one crosses lanes and is not).
		forRows(w, h, def (from int, to int) {
			mirrorRows(data, stride, out, rowBytes, w, from, to)
		})
		target.reshape(out, target.size(), rowBytes)
		return target
	}

	// Mirrors rows [from, to) of the source into the output. The arrays come
	// as parameters: a pixel loop over a local a closure captured runs many
	// times slower.
	internal def mirrorRows(data byte[], stride int, out byte[], rowBytes int, w int, from int, to int) {
		let rev = simd.loadBytes16(imgReversePixels, 0)
		for let y = from; y < to; y++ {
			let srcRow = y * stride
			let dstRow = y * rowBytes
			let x = 0
			for x + 4 <= w {
				simd.storeBytes16(out, dstRow + x * 4, simd.loadBytes16(data, srcRow + (w - x - 4) * 4).shuffle(rev))
				x += 4
			}
			for x < w {
				simd.storeBytes4(out, dstRow + x * 4, simd.loadBytes4(data, srcRow + (w - 1 - x) * 4))
				x++
			}
		}
	}

	// Resizes to `size`. NearestNeighbor, Bilinear and Bicubic (Catmull-Rom)
	// resample; ContentAware carves seams -- removes or inserts the lowest
	// energy paths through the image, so the subject keeps its proportions
	// while the background gives.
	def resize(target Raster, size geom.Size<uint>, mode ResizeMode = ResizeMode.Bilinear) Raster {
		let w = int(size.width)
		let h = int(size.height)
		return target when w <= 0 || h <= 0
		if mode == ResizeMode.ContentAware {
			return carve(target, w, h)
		}
		let out = resample(target, w, h, mode)
		target.reshape(out, size, w * 4)
		return target
	}

	// Crops away the uniform border: the rows and columns at the edges whose
	// pixels all have the border's colour, the colour of the corners (the
	// one most corners share, the top left's when all four differ), each
	// channel within `tolerance` of it. With a transparent corner, every
	// pixel whose alpha is within tolerance of 0 is border, whatever its
	// colour. A picture that is all border becomes empty.
	def trim(target Raster, tolerance int = 0) Raster {
		let box = trimBox(target, tolerance)
		return target when box.size.width == int(target.size().width) && box.size.height == int(target.size().height)
		if box.size.width <= 0 || box.size.height <= 0 {
			target.reshape(byte[], new geom.Size<uint>(uint(0), uint(0)), 0)
			return target
		}
		return crop(target, box)
	}

	// The box `trim` would crop to: the content inside the uniform border
	// (see `trim` for how the border is found). The whole picture when there
	// is no border, an empty box when it is all border.
	def trimBox(target Raster, tolerance int = 0) geom.Rectangle<int> {
		let w = int(target.size().width)
		let h = int(target.size().height)
		return new geom.Rectangle<int>(position = new geom.Point<int>(0, 0), size = new geom.Size<int>(0, 0)) when w <= 0 || h <= 0
		let stride = target.stride()
		let data = target.raw()
		let tol = tolerance.max(0)
		let corners = [0, (w - 1) * 4, (h - 1) * stride, (h - 1) * stride + (w - 1) * 4]
		let border = corners[0]
		let most = 0
		for let (_, c) in corners {
			let alike = 0
			for let (_, d) in corners {
				alike++ when data[c] == data[d] && data[c + 1] == data[d + 1] && data[c + 2] == data[d + 2] && data[c + 3] == data[d + 3]
			}
			if alike > most {
				most = alike
				border = c
			}
		}
		let (br, bg, bb, ba) = (int(data[border]), int(data[border + 1]), int(data[border + 2]), int(data[border + 3]))
		let clear = ba <= tol
		let isBorder = def (o int) bool {
			return int(data[o + 3]) <= tol when clear
			return (int(data[o]) - br).abs() <= tol && (int(data[o + 1]) - bg).abs() <= tol && (int(data[o + 2]) - bb).abs() <= tol && (int(data[o + 3]) - ba).abs() <= tol
		}
		// Each row's first and last content column, rows on tasks; a row
		// without one keeps -1.
		let firstX int[]
		firstX.len(h)
		let lastX int[]
		lastX.len(h)
		forRows(w, h, def (from int, to int) {
			for let y = from; y < to; y++ {
				let row = y * stride
				let x0 = 0
				for x0 < w && isBorder(row + x0 * 4) {
					x0++
				}
				if x0 == w {
					firstX[y] = -1
					lastX[y] = -1
					continue
				}
				let x1 = w - 1
				for isBorder(row + x1 * 4) {
					x1--
				}
				firstX[y] = x0
				lastX[y] = x1
			}
		})
		let minX = w
		let minY = h
		let maxX = -1
		let maxY = -1
		for let y = 0; y < h; y++ {
			continue when firstX[y] < 0
			minX = minX.min(firstX[y])
			maxX = maxX.max(lastX[y])
			minY = minY.min(y)
			maxY = y
		}
		return new geom.Rectangle<int>(position = new geom.Point<int>(0, 0), size = new geom.Size<int>(0, 0)) when maxX < 0
		return new geom.Rectangle<int>(position = new geom.Point<int>(minX, minY), size = new geom.Size<int>(maxX - minX + 1, maxY - minY + 1))
	}

	// Adds `padding` pixels on every side, filled with `background`
	// (transparent when none).
	def pad(target Raster, padding int, background ?color.Color = none) Raster {
		return target when padding <= 0
		return pad(target, new geom.Edges<int>(padding), background)
	}

	// Adds `edges.top`, `right`, `bottom` and `left` pixels on those sides
	// (a negative one adds none), filled with `background` (transparent when
	// none): the canvas grows the way an anchor asks.
	def pad(target Raster, edges geom.Edges<int>, background ?color.Color = none) Raster {
		let top = edges.top.max(0)
		let right = edges.right.max(0)
		let bottom = edges.bottom.max(0)
		let left = edges.left.max(0)
		return target when top == 0 && right == 0 && bottom == 0 && left == 0
		let w = int(target.size().width)
		let h = int(target.size().height)
		let stride = target.stride()
		let data = target.raw()
		let nw = w + left + right
		let nh = h + top + bottom
		let out = byte[]
		out.len(nw * nh * 4)
		if background is color.Color {
			let fill = background.rgba
			let line byte[]
			line.len(nw * 4)
			for let i = 0; i < nw; i++ {
				line[i * 4] = fill.r
				line[i * 4 + 1] = fill.g
				line[i * 4 + 2] = fill.b
				line[i * 4 + 3] = fill.a
			}
			forRows(nw, nh, def (from int, to int) {
				for let y = from; y < to; y++ {
					copyRow(out, y * nw * 4, line, 0, nw * 4)
				}
			})
		}
		forRows(w, h, def (from int, to int) {
			for let y = from; y < to; y++ {
				copyRow(out, ((y + top) * nw + left) * 4, data, y * stride, w * 4)
			}
		})
		target.reshape(out, new geom.Size<uint>(uint(nw), uint(nh)), nw * 4)
		return target
	}

	// Rotates the picture clockwise by `degrees` about its centre. Quarter
	// turns move pixels exactly; any other angle samples the source at each
	// output pixel (`mode`: nearest pixel, bilinear, or bicubic, Catmull-Rom;
	// the other modes sample bilinearly), on premultiplied colours, rows on
	// tasks. The picture grows to the rotated bounding box, or keeps its
	// size with the corners cut (`keepSize`); what the source does not cover
	// is `background`, transparent when none.
	def rotate(target Raster, degrees float, mode ResizeMode = ResizeMode.Bilinear, keepSize bool = false, background ?color.Color = none) Raster {
		let w = int(target.size().width)
		let h = int(target.size().height)
		return target when w <= 0 || h <= 0
		let turn = degrees - (degrees / 360.0).floor() * 360.0
		return target when turn == 0.0
		if !keepSize && (turn == 90.0 || turn == 180.0 || turn == 270.0) {
			return quarterTurn(target, int(turn))
		}
		let stride = target.stride()
		let data = target.raw()
		let rad = turn * Pi / 180.0
		let cs = cos(rad)
		let sn = sin(rad)
		let cw = float(w)
		let ch = float(h)
		let ow = keepSize ?? (w, int((cw * cs.abs() + ch * sn.abs() - 1.0e-9).ceil()).max(1))
		let oh = keepSize ?? (h, int((cw * sn.abs() + ch * cs.abs() - 1.0e-9).ceil()).max(1))
		let out = byte[]
		out.len(ow * oh * 4)
		let (fr, fg, fb, fa) = (float32(0), float32(0), float32(0), float32(0))
		if background is color.Color {
			let fill = background.rgba
			fr = float32(fill.r)
			fg = float32(fill.g)
			fb = float32(fill.b)
			fa = float32(fill.a)
		}
		let (scx, scy) = (cw / 2.0, ch / 2.0)
		let (ocx, ocy) = (float(ow) / 2.0, float(oh) / 2.0)
		let nearest = mode == ResizeMode.NearestNeighbor
		let cubic = mode == ResizeMode.Bicubic
		forRows(ow, oh, def (from int, to int) {
			let zero = simd.splat4<float32>(float32(0))
			let alphaLanes = simd.splat4<byte>(byte(3))
			let isAlpha = zero.withLane(3, float32(1)).gt(zero)
			let half = simd.splat4<float32>(float32(0.5))
			let hi = simd.splat4<float32>(float32(255))
			// The background, premultiplied, as a sample outside the source.
			let outside = simd.splat4<float32>(float32(0)).withLane(0, fr * fa).withLane(1, fg * fa).withLane(2, fb * fa).withLane(3, fa)
			let sample = def (ix int, iy int) vec4<float32> {
				return outside when ix < 0 || iy < 0 || ix >= w || iy >= h
				let v = simd.convert<byte, float32>(simd.load4<byte>(data, iy * stride + ix * 4))
				return isAlpha.blend(v, v * v.shuffle(alphaLanes))
			}
			for let y = from; y < to; y++ {
				let dy = float(y) + 0.5 - ocy
				let d = y * ow * 4
				for let x = 0; x < ow; x++ {
					let dx = float(x) + 0.5 - ocx
					// Back through the rotation to the source point.
					let sx = dx * cs + dy * sn + scx
					let sy = dy * cs - dx * sn + scy
					let sum = zero
					if nearest {
						sum = sample(int(sx.floor()), int(sy.floor()))
					} else {
						let fx = sx - 0.5
						let fy = sy - 0.5
						let x0 = int(fx.floor())
						let y0 = int(fy.floor())
						let tx = fx - float(x0)
						let ty = fy - float(y0)
						if cubic {
							for let j = -1; j <= 2; j++ {
								let wy = float32(cubicWeight(float(j) - ty))
								for let i = -1; i <= 2; i++ {
									let wgt = float32(cubicWeight(float(i) - tx)) * wy
									sum = sample(x0 + i, y0 + j).fma(simd.splat4<float32>(wgt), sum)
								}
							}
						} else {
							sum = sample(x0, y0) * simd.splat4<float32>(float32((1.0 - tx) * (1.0 - ty)))
							sum = sample(x0 + 1, y0).fma(simd.splat4<float32>(float32(tx * (1.0 - ty))), sum)
							sum = sample(x0, y0 + 1).fma(simd.splat4<float32>(float32((1.0 - tx) * ty)), sum)
							sum = sample(x0 + 1, y0 + 1).fma(simd.splat4<float32>(float32(tx * ty)), sum)
						}
					}
					let alpha = sum.lane(3)
					if alpha > float32(0) {
						sum = sum / simd.splat4<float32>(alpha).withLane(3, float32(1))
						let px = (sum.clamp(zero, hi) + half).floor()
						simd.store4<byte>(out, d, simd.convert<float32, byte>(px))
					}
					d += 4
				}
			}
		})
		target.reshape(out, new geom.Size<uint>(uint(ow), uint(oh)), ow * 4)
		return target
	}

	// A clockwise turn of 90, 180 or 270 degrees, pixel for pixel.
	internal def quarterTurn(target Raster, degrees int) Raster {
		let w = int(target.size().width)
		let h = int(target.size().height)
		let stride = target.stride()
		let data = target.raw()
		let (ow, oh) = degrees == 180 ?? ((w, h), (h, w))
		let out = byte[]
		out.len(ow * oh * 4)
		forRows(ow, oh, def (from int, to int) {
			turnRows(data, stride, out, ow, w, h, degrees, from, to)
		})
		target.reshape(out, new geom.Size<uint>(uint(ow), uint(oh)), ow * 4)
		return target
	}

	// Writes rows [from, to) of the turned picture, one four-byte move per
	// pixel. The arrays come as parameters: a pixel loop over a local a
	// closure captured runs many times slower.
	internal def turnRows(data byte[], stride int, out byte[], ow int, w int, h int, degrees int, from int, to int) {
		for let y = from; y < to; y++ {
			let drow = y * ow * 4
			if degrees == 90 {
				let sx = y * 4
				for let x = 0; x < ow; x++ {
					simd.storeBytes4(out, drow + x * 4, simd.loadBytes4(data, (h - 1 - x) * stride + sx))
				}
			} else if degrees == 180 {
				let srow = (h - 1 - y) * stride
				for let x = 0; x < ow; x++ {
					simd.storeBytes4(out, drow + x * 4, simd.loadBytes4(data, srow + (w - 1 - x) * 4))
				}
			} else {
				let sx = (w - 1 - y) * 4
				for let x = 0; x < ow; x++ {
					simd.storeBytes4(out, drow + x * 4, simd.loadBytes4(data, x * stride + sx))
				}
			}
		}
	}

	// Scales and/or crops to exactly `width` x `height` by `mode`.
	def fit(target Raster, width, height int, mode = FitMode.Cover) Raster {
		return target when width <= 0 || height <= 0
		let w = int(target.size().width)
		let h = int(target.size().height)
		return target when w == 0 || h == 0
		let sx = float(width) / float(w)
		let sy = float(height) / float(h)

		switch mode {
			case FitMode.Stretch:
				return resize(target, new geom.Size<uint>(uint(width), uint(height)))
			case FitMode.Cover, FitMode.ScaleToFill:
				scaleBy(target, sx.max(sy))
				return centerCrop(target, width, height)
			case FitMode.Contain, FitMode.ScaleToFit:
				scaleBy(target, sx.min(sy))
				return letterbox(target, width, height)
			case FitMode.FitWidth:
				return scaleBy(target, sx)
			case FitMode.FitHeight:
				return scaleBy(target, sy)
			case FitMode.CenterCrop:
				return centerCrop(target, width, height)
			case FitMode.SmartCrop:
				scaleBy(target, sx.max(sy))
				return smartCrop(target, width, height)
			case FitMode.Tile:
				return tile(target, width, height)
		}
		return target
	}

	// Crops to `r` (clipped to the image).
	def crop(target Raster, r geom.Rectangle<int>) Raster {
		let w = int(target.size().width)
		let h = int(target.size().height)
		let stride = target.stride()
		let data = target.raw()
		let x0 = r.left().clamp(0, w)
		let y0 = r.top().clamp(0, h)
		let x1 = r.right().clamp(0, w)
		let y1 = r.bottom().clamp(0, h)
		let cw = (x1 - x0).max(0)
		let ch = (y1 - y0).max(0)
		let out = byte[]
		out.len(cw * ch * 4)
		for let y = 0; y < ch; y++ {
			mem.copyN(out[y * cw * 4:(y + 1) * cw * 4], data[(y0 + y) * stride + x0 * 4:(y0 + y) * stride + x1 * 4], cw * 4)
		}
		target.reshape(out, new geom.Size<uint>(uint(cw), uint(ch)), cw * 4)
		return target
	}

	// Crops to `width` x `height` around the subject (see
	// analysis.salientRegion); the window is kept inside the image.
	def smartCrop(target Raster, width, height int) Raster {
		let w = int(target.size().width)
		let h = int(target.size().height)
		let cw = width.clamp(1, w)
		let ch = height.clamp(1, h)
		let region = analysis.salientRegion(target)
		let c = region.center()
		let x = (c.x - cw / 2).clamp(0, w - cw)
		let y = (c.y - ch / 2).clamp(0, h - ch)
		return crop(target, new geom.Rectangle<int>(position = new geom.Point<int>(x, y), size = new geom.Size<int>(cw, ch)))
	}

	internal def scaleBy(target Raster, factor float) Raster {
		let w = int(target.size().width)
		let h = int(target.size().height)
		let nw = int((float(w) * factor).round()).max(1)
		let nh = int((float(h) * factor).round()).max(1)
		return target when nw == w && nh == h
		return resize(target, new geom.Size<uint>(uint(nw), uint(nh)))
	}

	internal def centerCrop(target Raster, width, height int) Raster {
		let w = int(target.size().width)
		let h = int(target.size().height)
		let cw = width.min(w)
		let ch = height.min(h)
		return crop(target, new geom.Rectangle<int>(position = new geom.Point<int>((w - cw) / 2, (h - ch) / 2), size = new geom.Size<int>(cw, ch)))
	}

	// Centres the raster on a transparent `width` x `height` canvas.
	internal def letterbox(target Raster, width, height int) Raster {
		let w = int(target.size().width)
		let h = int(target.size().height)
		let stride = target.stride()
		let data = target.raw()
		let out = byte[]
		out.len(width * height * 4)
		let ox = (width - w) / 2
		let oy = (height - h) / 2
		for let y = 0; y < h; y++ {
			let ty = y + oy
			continue when ty < 0 || ty >= height
			for let x = 0; x < w; x++ {
				let tx = x + ox
				continue when tx < 0 || tx >= width
				let s = y * stride + x * 4
				let d = (ty * width + tx) * 4
				out[d] = data[s]
				out[d + 1] = data[s + 1]
				out[d + 2] = data[s + 2]
				out[d + 3] = data[s + 3]
			}
		}
		target.reshape(out, new geom.Size<uint>(uint(width), uint(height)), width * 4)
		return target
	}

	// Repeats the raster to fill `width` x `height`.
	internal def tile(target Raster, width, height int) Raster {
		let w = int(target.size().width)
		let h = int(target.size().height)
		let stride = target.stride()
		let data = target.raw()
		let out = byte[]
		out.len(width * height * 4)
		for let y = 0; y < height; y++ {
			let sy = y % h
			for let x = 0; x < width; x++ {
				let sx = x % w
				let s = sy * stride + sx * 4
				let d = (y * width + x) * 4
				out[d] = data[s]
				out[d + 1] = data[s + 1]
				out[d + 2] = data[s + 2]
				out[d + 3] = data[s + 3]
			}
		}
		target.reshape(out, new geom.Size<uint>(uint(width), uint(height)), width * 4)
		return target
	}

	// Copies `n` bytes from `src[from:]` to `dst[to:]`.
	internal def copyRow(dst byte[], to int, src byte[], from int, n int) {
		mem.copyN(dst[to:to + n], src[from:from + n], n)
	}
}
