partial module std.gfx.processing.transform {
	use (
		std.gfx::(Raster)
		std.gfx.color
		std.gfx.processing.analysis
		std.simd
		std.mem
		std.math.geom
	)

	// Every transform edits `target` in place (through Raster.reshape when
	// the geometry changes) and returns it, so calls nest; `processing.Pipeline`
	// chains them.

	// ResizeMode represents the algorithm used to resize an image.
	enum ResizeMode {
		// Fastest, preserves hard pixel edges.
		// Best for pixel art, masks, indexed images, or when you explicitly don't want smoothing.
		// Usually looks bad for photographs.
		NearestNeighbor,
		// Fast and reasonably smooth.
		// Best general-purpose choice when speed matters more than maximum quality.
		Bilinear,
		// Slower, but usually sharper and better-looking than bilinear.
		// Good default for photographs/UI images when quality matters.
		Bicubic
		// It uses seam carving to change dimensions while trying to preserve important content instead of
		// uniformly scaling everything.
		// Best when changing aspect ratio or dimensions without squashing the subject.
		ContentAware,
	}

	// FitMode is how fit places an image in a box: Cover fills the box and crops
	// the overflow, Contain fits the whole image inside, ScaleToFit stretches it
	// to the box, and the remaining modes as their names say.
	enum FitMode {
		Cover,
		Contain,
		ScaleToFit,
		ScaleToFill,
		FitWidth,
		FitHeight,
		CenterCrop,
		// Crop using Saliency detection
		SmartCrop,
		Stretch,
		Tile,
	}

	// Axis represents the direction of a 2D axis.
	enum Axis {
		Horizontal,
		Vertical
	}

	// Reverses eight RGBA pixels within a 32-byte group.
	internal const imgReversePixels = byte[
		28, 29, 30, 31, 24, 25, 26, 27, 20, 21, 22, 23, 16, 17, 18, 19,
		12, 13, 14, 15, 8, 9, 10, 11, 4, 5, 6, 7, 0, 1, 2, 3
	]

	// Mirrors this image in place across the given axis and returns it.
	// `Axis.Horizontal` mirrors left to right, `Axis.Vertical` top to
	// bottom.
	def flip(target Raster, axis Axis) Raster {
		let w = int(target.size().width)
		let h = int(target.size().height)
		let stride = target.stride()
		let data = target.raw()

		let rowBytes = w * 4
		let out = byte[]
		out.len(h * rowBytes)

		if axis == Axis.Vertical {
			// Whole rows move, so this is a row-order reversal.
			for let y = 0; y < h; y++ {
				let srcOff = y * stride
				let dstOff = (h - 1 - y) * rowBytes
				mem.copyN(out[dstOff:dstOff + rowBytes], data[srcOff:srcOff + rowBytes], rowBytes)
			}
			target.reshape(out, target.size(), rowBytes)
			return target
		}

		// Mirroring a row reverses four-byte groups, which is one shuffle
		// per eight pixels.
		let rev = simd.loadBytes32(imgReversePixels, 0)
		for let y = 0; y < h; y++ {
			let srcRow = y * stride
			let dstRow = y * rowBytes
			let x = 0
			for x + 8 <= w {
				let src = simd.loadBytes32(data, srcRow + (w - x - 8) * 4)
				simd.storeBytes32(out, dstRow + x * 4, simd.shuffle<byte>(src, rev))
				x += 8
			}
			for x < w {
				let s = srcRow + (w - 1 - x) * 4
				let d = dstRow + x * 4
				out[d] = data[s]
				out[d + 1] = data[s + 1]
				out[d + 2] = data[s + 2]
				out[d + 3] = data[s + 3]
				x++
			}
		}
		target.reshape(out, target.size(), rowBytes)
		return target
	}

	// Resizes to `size`. NearestNeighbor, Bilinear and Bicubic (Catmull-Rom)
	// resample; ContentAware carves seams -- removes or inserts the lowest
	// energy paths through the image, so the subject keeps its proportions
	// while the background gives.
	def resize(target Raster, size geom.Size<uint>, mode ResizeMode = ResizeMode.Bilinear) Raster {
		let w = int(size.width)
		let h = int(size.height)
		return target when w <= 0 || h <= 0
		if mode == ResizeMode.ContentAware {
			return carve(target, w, h)
		}
		let out = resample(target, w, h, mode)
		target.reshape(out, size, w * 4)
		return target
	}

	// Catmull-Rom weight for a distance `t` from the sample.
	internal def cubicWeight(t float) float {
		let x = t.abs()
		return ((1.5 * x - 2.5) * x) * x + 1.0 when x < 1.0
		return (((-0.5 * x + 2.5) * x) - 4.0) * x + 2.0 when x < 2.0
		return 0.0
	}

	// Removes fully transparent rows and columns around the content.
	def trim(target Raster) Raster {
		let w = int(target.size().width)
		let h = int(target.size().height)
		let stride = target.stride()
		let data = target.raw()
		let minX = w
		let minY = h
		let maxX = -1
		let maxY = -1
		for let y = 0; y < h; y++ {
			for let x = 0; x < w; x++ {
				continue when data[y * stride + x * 4 + 3] == byte(0)
				minX = minX.min(x)
				minY = minY.min(y)
				maxX = maxX.max(x)
				maxY = maxY.max(y)
			}
		}
		if maxX < 0 {
			target.reshape(byte[], new geom.Size<uint>(uint(0), uint(0)), 0)
			return target
		}
		return crop(target, new geom.Rectangle<int>(position = new geom.Point<int>(minX, minY), size = new geom.Size<int>(maxX - minX + 1, maxY - minY + 1)))
	}

	// Adds `padding` pixels on every side, filled with `background`
	// (transparent when none).
	def pad(target Raster, padding int, background ?color.Color = none) Raster {
		return target when padding <= 0
		let w = int(target.size().width)
		let h = int(target.size().height)
		let stride = target.stride()
		let data = target.raw()
		let nw = w + 2 * padding
		let nh = h + 2 * padding
		let out = byte[]
		out.len(nw * nh * 4)
		if background is color.Color {
			let fill = background.rgba
			for let i = 0; i < nw * nh; i++ {
				out[i * 4] = fill.r
				out[i * 4 + 1] = fill.g
				out[i * 4 + 2] = fill.b
				out[i * 4 + 3] = fill.a
			}
		}
		for let y = 0; y < h; y++ {
			mem.copyN(out[((y + padding) * nw + padding) * 4:((y + padding) * nw + padding + w) * 4], data[y * stride:y * stride + w * 4], w * 4)
		}
		target.reshape(out, new geom.Size<uint>(uint(nw), uint(nh)), nw * 4)
		return target
	}

	// Scales and/or crops to exactly `width` x `height` by `mode`.
	def fit(target Raster, width, height int, mode = FitMode.Cover) Raster {
		return target when width <= 0 || height <= 0
		let w = int(target.size().width)
		let h = int(target.size().height)
		return target when w == 0 || h == 0
		let sx = float(width) / float(w)
		let sy = float(height) / float(h)

		switch mode {
			case FitMode.Stretch:
				return resize(target, new geom.Size<uint>(uint(width), uint(height)))
			case FitMode.Cover, FitMode.ScaleToFill:
				scaleBy(target, sx.max(sy))
				return centerCrop(target, width, height)
			case FitMode.Contain, FitMode.ScaleToFit:
				scaleBy(target, sx.min(sy))
				return letterbox(target, width, height)
			case FitMode.FitWidth:
				return scaleBy(target, sx)
			case FitMode.FitHeight:
				return scaleBy(target, sy)
			case FitMode.CenterCrop:
				return centerCrop(target, width, height)
			case FitMode.SmartCrop:
				scaleBy(target, sx.max(sy))
				return smartCrop(target, width, height)
			case FitMode.Tile:
				return tile(target, width, height)
		}
		return target
	}

	// Crops to `r` (clipped to the image).
	def crop(target Raster, r geom.Rectangle<int>) Raster {
		let w = int(target.size().width)
		let h = int(target.size().height)
		let stride = target.stride()
		let data = target.raw()
		let x0 = r.left().clamp(0, w)
		let y0 = r.top().clamp(0, h)
		let x1 = r.right().clamp(0, w)
		let y1 = r.bottom().clamp(0, h)
		let cw = (x1 - x0).max(0)
		let ch = (y1 - y0).max(0)
		let out = byte[]
		out.len(cw * ch * 4)
		for let y = 0; y < ch; y++ {
			mem.copyN(out[y * cw * 4:(y + 1) * cw * 4], data[(y0 + y) * stride + x0 * 4:(y0 + y) * stride + x1 * 4], cw * 4)
		}
		target.reshape(out, new geom.Size<uint>(uint(cw), uint(ch)), cw * 4)
		return target
	}

	// Crops to `width` x `height` around the subject (see
	// analysis.salientRegion); the window is kept inside the image.
	def smartCrop(target Raster, width, height int) Raster {
		let w = int(target.size().width)
		let h = int(target.size().height)
		let cw = width.clamp(1, w)
		let ch = height.clamp(1, h)
		let region = analysis.salientRegion(target)
		let c = region.center()
		let x = (c.x - cw / 2).clamp(0, w - cw)
		let y = (c.y - ch / 2).clamp(0, h - ch)
		return crop(target, new geom.Rectangle<int>(position = new geom.Point<int>(x, y), size = new geom.Size<int>(cw, ch)))
	}

	internal def scaleBy(target Raster, factor float) Raster {
		let w = int(target.size().width)
		let h = int(target.size().height)
		let nw = int((float(w) * factor).round()).max(1)
		let nh = int((float(h) * factor).round()).max(1)
		return target when nw == w && nh == h
		return resize(target, new geom.Size<uint>(uint(nw), uint(nh)))
	}

	internal def centerCrop(target Raster, width, height int) Raster {
		let w = int(target.size().width)
		let h = int(target.size().height)
		let cw = width.min(w)
		let ch = height.min(h)
		return crop(target, new geom.Rectangle<int>(position = new geom.Point<int>((w - cw) / 2, (h - ch) / 2), size = new geom.Size<int>(cw, ch)))
	}

	// Centres the raster on a transparent `width` x `height` canvas.
	internal def letterbox(target Raster, width, height int) Raster {
		let w = int(target.size().width)
		let h = int(target.size().height)
		let stride = target.stride()
		let data = target.raw()
		let out = byte[]
		out.len(width * height * 4)
		let ox = (width - w) / 2
		let oy = (height - h) / 2
		for let y = 0; y < h; y++ {
			let ty = y + oy
			continue when ty < 0 || ty >= height
			for let x = 0; x < w; x++ {
				let tx = x + ox
				continue when tx < 0 || tx >= width
				let s = y * stride + x * 4
				let d = (ty * width + tx) * 4
				out[d] = data[s]
				out[d + 1] = data[s + 1]
				out[d + 2] = data[s + 2]
				out[d + 3] = data[s + 3]
			}
		}
		target.reshape(out, new geom.Size<uint>(uint(width), uint(height)), width * 4)
		return target
	}

	// Repeats the raster to fill `width` x `height`.
	internal def tile(target Raster, width, height int) Raster {
		let w = int(target.size().width)
		let h = int(target.size().height)
		let stride = target.stride()
		let data = target.raw()
		let out = byte[]
		out.len(width * height * 4)
		for let y = 0; y < height; y++ {
			let sy = y % h
			for let x = 0; x < width; x++ {
				let sx = x % w
				let s = sy * stride + sx * 4
				let d = (y * width + x) * 4
				out[d] = data[s]
				out[d + 1] = data[s + 1]
				out[d + 2] = data[s + 2]
				out[d + 3] = data[s + 3]
			}
		}
		target.reshape(out, new geom.Size<uint>(uint(width), uint(height)), width * 4)
		return target
	}

	// Samples the raster into a tight `w` x `h` buffer.
	internal def resample(target Raster, w, h int, mode ResizeMode) byte[] {
		let sw = int(target.size().width)
		let sh = int(target.size().height)
		let stride = target.stride()
		let data = target.raw()
		let out = byte[]
		out.len(w * h * 4)
		return out when sw == 0 || sh == 0
		let fx = float(sw) / float(w)
		let fy = float(sh) / float(h)
		for let y = 0; y < h; y++ {
			// Pixel-centre mapping keeps the image aligned at both scales.
			let syf = (float(y) + 0.5) * fy - 0.5
			for let x = 0; x < w; x++ {
				let sxf = (float(x) + 0.5) * fx - 0.5
				let d = (y * w + x) * 4
				if mode == ResizeMode.NearestNeighbor {
					let sx = int((sxf + 0.5).floor()).clamp(0, sw - 1)
					let sy = int((syf + 0.5).floor()).clamp(0, sh - 1)
					let s = sy * stride + sx * 4
					out[d] = data[s]
					out[d + 1] = data[s + 1]
					out[d + 2] = data[s + 2]
					out[d + 3] = data[s + 3]
					continue
				}
				if mode == ResizeMode.Bicubic {
					let bx = int(sxf.floor())
					let by = int(syf.floor())
					for let c = 0; c < 4; c++ {
						let acc = 0.0
						let wsum = 0.0
						for let j = -1; j <= 2; j++ {
							let sy = (by + j).clamp(0, sh - 1)
							let wy = cubicWeight(syf - float(by + j))
							for let i = -1; i <= 2; i++ {
								let sx = (bx + i).clamp(0, sw - 1)
								let wgt = wy * cubicWeight(sxf - float(bx + i))
								acc += float(data[sy * stride + sx * 4 + c]) * wgt
								wsum += wgt
							}
						}
						wsum = 1.0 when wsum == 0.0
						out[d + c] = byte((acc / wsum).round().clamp(0.0, 255.0))
					}
					continue
				}
				let x0 = int(sxf.floor()).clamp(0, sw - 1)
				let y0 = int(syf.floor()).clamp(0, sh - 1)
				let x1 = (x0 + 1).min(sw - 1)
				let y1 = (y0 + 1).min(sh - 1)
				let tx = (sxf - float(x0)).clamp(0.0, 1.0)
				let ty = (syf - float(y0)).clamp(0.0, 1.0)
				for let c = 0; c < 4; c++ {
					let top = float(data[y0 * stride + x0 * 4 + c]) * (1.0 - tx) + float(data[y0 * stride + x1 * 4 + c]) * tx
					let bottom = float(data[y1 * stride + x0 * 4 + c]) * (1.0 - tx) + float(data[y1 * stride + x1 * 4 + c]) * tx
					out[d + c] = byte((top * (1.0 - ty) + bottom * ty).round().clamp(0.0, 255.0))
				}
			}
		}
		return out
	}
}
