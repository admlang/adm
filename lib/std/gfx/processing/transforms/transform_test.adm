partial module std.gfx.processing.transform {
	use (
		std.testing
		std.gfx.color
		std.formats.image
		std.math.geom
	)

	// A w x h image whose pixel (x, y) is (x, y, 0, 255).
	internal def gradient(w, h int) image.Image {
		let img = new image.Image(w, h)
		let px = img.raw()
		for let y = 0; y < h; y++ {
			for let x = 0; x < w; x++ {
				let o = img.pixelOffset(x, y)
				px[o] = byte(x)
				px[o + 1] = byte(y)
				px[o + 3] = byte(255)
			}
		}
		return img
	}

	check "Transforms" {
		@test()
		def crop_keeps_the_window() {
			let img = gradient(8, 6)
			crop(img, new geom.Rectangle<int>(position = new geom.Point<int>(2, 1), size = new geom.Size<int>(3, 4)))
			assert int(img.size().width) == 3 && int(img.size().height) == 4
			assert img.stride() == 12
			let px = img.raw()
			assert int(px[0]) == 2 && int(px[1]) == 1
			let o = img.pixelOffset(2, 3)
			assert int(px[o]) == 4 && int(px[o + 1]) == 4
		}

		@test()
		def crop_clips_to_the_image() {
			let img = gradient(4, 4)
			crop(img, new geom.Rectangle<int>(position = new geom.Point<int>(2, 2), size = new geom.Size<int>(10, 10)))
			assert int(img.size().width) == 2 && int(img.size().height) == 2
		}

		@test()
		def resize_nearest_doubles() {
			let img = gradient(2, 2)
			resize(img, new geom.Size<uint>(uint(4), uint(4)), ResizeMode.NearestNeighbor)
			assert int(img.size().width) == 4
			let px = img.raw()
			assert int(px[img.pixelOffset(0, 0)]) == 0
			assert int(px[img.pixelOffset(3, 3)]) == 1
			assert int(px[img.pixelOffset(3, 3) + 1]) == 1
		}

		@test()
		def resize_bilinear_interpolates() {
			let img = new image.Image(2, 1)
			let px = img.raw()
			px[0] = byte(0)
			px[3] = byte(255)
			px[4] = byte(100)
			px[7] = byte(255)
			resize(img, new geom.Size<uint>(uint(4), uint(1)))
			let out = img.raw()
			assert int(out[0]) == 0
			assert int(out[12]) == 100
			assert int(out[4]) > 0 && int(out[4]) < 100
			assert int(out[4]) < int(out[8])
		}

		@test()
		def bicubic_interpolates_smoothly() {
			let img = new image.Image(3, 1)
			let px = img.raw()
			px[0] = byte(0)
			px[4] = byte(100)
			px[8] = byte(200)
			for let i = 0; i < 3; i++ {
				px[i * 4 + 3] = byte(255)
			}
			resize(img, new geom.Size<uint>(uint(6), uint(1)), ResizeMode.Bicubic)
			let out = img.raw()
			assert int(img.size().width) == 6
			// Monotone ramp, endpoints kept.
			assert int(out[0]) <= 5
			assert int(out[20]) >= 195
			assert int(out[4]) < int(out[8]) && int(out[8]) < int(out[12]) && int(out[12]) < int(out[16])
		}

		@test()
		def content_aware_keeps_the_subject() {
			// Flat background with a bright 2px vertical stripe at x = 8..10:
			// the stripe is the only energy, so carving removes background.
			let img = new image.Image(16, 4)
			let px = img.raw()
			for let y = 0; y < 4; y++ {
				for let x = 0; x < 16; x++ {
					let o = img.pixelOffset(x, y)
					let v = byte(30)
					v = byte(240) when x == 8 || x == 9
					px[o] = v
					px[o + 1] = v
					px[o + 2] = v
					px[o + 3] = byte(255)
				}
			}
			resize(img, new geom.Size<uint>(uint(8), uint(4)), ResizeMode.ContentAware)
			assert int(img.size().width) == 8 && int(img.size().height) == 4
			let out = img.raw()
			let bright = 0
			for let x = 0; x < 8; x++ {
				bright += 1 when int(out[img.pixelOffset(x, 0)]) == 240
			}
			assert bright == 2

			// Enlarging inserts background, never splits the stripe apart.
			resize(img, new geom.Size<uint>(uint(12), uint(6)), ResizeMode.ContentAware)
			assert int(img.size().width) == 12 && int(img.size().height) == 6
			let grown = img.raw()
			let first = -1
			let last = -1
			for let x = 0; x < 12; x++ {
				if int(grown[img.pixelOffset(x, 2)]) == 240 {
					first = x when first < 0
					last = x
				}
			}
			assert first >= 0 && last - first == 1
		}

		@test()
		def content_aware_searches_a_large_image_at_half_size() {
			// Wide enough for the coarse search: the seams are found on a
			// half-size copy and refined at full size, and the 2px stripe
			// still survives losing a quarter of the columns.
			let img = new image.Image(320, 40)
			let px = img.raw()
			for let y = 0; y < 40; y++ {
				for let x = 0; x < 320; x++ {
					let o = img.pixelOffset(x, y)
					let v = byte(30 + (x * 7 + y * 3) % 5)
					v = byte(240) when x == 160 || x == 161
					px[o] = v
					px[o + 1] = v
					px[o + 2] = v
					px[o + 3] = byte(255)
				}
			}
			resize(img, new geom.Size<uint>(uint(240), uint(40)), ResizeMode.ContentAware)
			assert int(img.size().width) == 240 && int(img.size().height) == 40
			let out = img.raw()
			for let y = 0; y < 40; y += 13 {
				let bright = 0
				for let x = 0; x < 240; x++ {
					bright += 1 when int(out[img.pixelOffset(x, y)]) == 240
				}
				assert bright == 2
			}
		}

		@test()
		def content_aware_protects_a_smooth_subject() {
			// Noisy background (high gradient) and a smooth bright block:
			// plain gradient energy would carve the block first. Saliency
			// in the energy keeps it whole.
			let img = new image.Image(64, 32)
			let px = img.raw()
			let seed = uint32(4242)
			for let y = 0; y < 32; y++ {
				for let x = 0; x < 64; x++ {
					let o = img.pixelOffset(x, y)
					seed = seed * uint32(1664525) + uint32(1013904223)
					let v = byte(40 + int(seed >> 26))
					v = byte(230) when x >= 24 && x < 40 && y >= 8 && y < 24
					px[o] = v
					px[o + 1] = v
					px[o + 2] = v
					px[o + 3] = byte(255)
				}
			}
			resize(img, new geom.Size<uint>(uint(48), uint(32)), ResizeMode.ContentAware)
			let out = img.raw()
			let bright = 0
			for let x = 0; x < 48; x++ {
				bright += 1 when int(out[img.pixelOffset(x, 16)]) == 230
			}
			assert bright == 16
		}

		@test()
		def pad_and_trim_round_trip() {
			let img = gradient(3, 2)
			pad(img, 2)
			assert int(img.size().width) == 7 && int(img.size().height) == 6
			let px = img.raw()
			assert int(px[3]) == 0 // transparent corner
			let o = img.pixelOffset(2, 2)
			assert int(px[o]) == 0 && int(px[o + 3]) == 255
			trim(img)
			assert int(img.size().width) == 3 && int(img.size().height) == 2
			assert int(img.raw()[img.pixelOffset(2, 1)]) == 2
		}

		@test()
		def pad_with_color() {
			let img = gradient(1, 1)
			pad(img, 1, new color.Color("#ff0000"))
			let px = img.raw()
			assert int(px[0]) == 255 && int(px[3]) == 255
		}

		@test()
		def fit_modes_produce_the_asked_size() {
			let cover = gradient(8, 4)
			fit(cover, 4, 4, FitMode.Cover)
			assert int(cover.size().width) == 4 && int(cover.size().height) == 4

			let contain = gradient(8, 4)
			fit(contain, 4, 4, FitMode.Contain)
			assert int(contain.size().width) == 4 && int(contain.size().height) == 4
			// Letterboxed rows are transparent.
			assert int(contain.raw()[3]) == 0

			let stretch = gradient(8, 4)
			fit(stretch, 3, 5, FitMode.Stretch)
			assert int(stretch.size().width) == 3 && int(stretch.size().height) == 5

			let tiled = gradient(2, 2)
			fit(tiled, 5, 3, FitMode.Tile)
			assert int(tiled.size().width) == 5
			assert int(tiled.raw()[tiled.pixelOffset(4, 2)]) == 0

			let fw = gradient(8, 4)
			fit(fw, 4, 100, FitMode.FitWidth)
			assert int(fw.size().width) == 4 && int(fw.size().height) == 2

			let cc = gradient(8, 4)
			fit(cc, 2, 2, FitMode.CenterCrop)
			assert int(cc.size().width) == 2
			assert int(cc.raw()[0]) == 3 && int(cc.raw()[1]) == 1
		}

		@test()
		def flip_returns_the_raster() {
			let img = gradient(3, 1)
			let out = flip(img, Axis.Horizontal)
			assert int(out.size().width) == 3
			assert int(img.raw()[0]) == 2
		}

		@test()
		def smart_crop_follows_the_subject() {
			// Textured dark image with a bright block in the bottom-right
			// quarter (see analysis_test on why the background is textured).
			let img = new image.Image(64, 64)
			let px = img.raw()
			let seed = uint32(777)
			for let y = 0; y < 64; y++ {
				for let x = 0; x < 64; x++ {
					let o = img.pixelOffset(x, y)
					seed = seed * uint32(1664525) + uint32(1013904223)
					let v = byte(20 + int(seed >> 27))
					v = byte(240) when x >= 40 && x < 56 && y >= 40 && y < 56
					px[o] = v
					px[o + 1] = v
					px[o + 2] = v
					px[o + 3] = byte(255)
				}
			}
			smartCrop(img, 24, 24)
			assert int(img.size().width) == 24 && int(img.size().height) == 24
			// The window holds the bright block: its centre pixel is bright.
			assert int(img.raw()[img.pixelOffset(12, 12)]) == 240
		}
	}
}
