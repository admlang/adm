partial module std.gfx.render {
	use (
		std.gfx.color::(Color, BlendMode)
		std.math.geom::(Point, Rect)
	)

	// CommandKind names what a DrawCommand draws: a clear, rectangles, lines,
	// polygons, circles, ellipses, triangles or blits.
	enum CommandKind {
		Clear
		FillRect
		StrokeRect
		Line
		Polyline
		Polygon
		FillCircle
		StrokeCircle
		FillEllipse
		StrokeEllipse
		FillTriangle
		StrokeTriangle
		BlitCopy
		Blit
		BlitRGBAtoBGRA
	}

	// DrawCommand is one recorded drawing operation: its kind and the geometry,
	// colour, stroke width and source pixels it uses.
	type DrawCommand {
		kind        CommandKind
		rect        Rect
		color       Color
		center      Point
		radius      float
		rx          float
		ry          float
		p0          Point
		p1          Point
		p2          Point
		points      Point[]
		strokeWidth float
		src         byte[]
		srcW        int
		srcH        int
		x           int
		y           int
		mode        BlendMode
	}
}
