partial module std.gfx.render {
	use std.gfx.color::(Color, BlendMode)
	use std.math.geom::(Point, Rect)

	enum CommandKind {
		Clear
		FillRect
		StrokeRect
		Line
		Polyline
		Polygon
		FillCircle
		StrokeCircle
		FillEllipse
		StrokeEllipse
		FillTriangle
		StrokeTriangle
		BlitCopy
		Blit
		BlitRGBAtoBGRA
	}

	type DrawCommand {
		kind  CommandKind
		rect  Rect
		color Color
		center Point
		radius float
		rx float
		ry float
		p0 Point
		p1 Point
		p2 Point
		points Point[]
		strokeWidth float
		src   byte[]
		srcW  int
		srcH  int
		x     int
		y     int
		mode  BlendMode
	}
}
