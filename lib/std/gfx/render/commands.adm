partial module std.gfx.render {
	use (
		std.gfx.color::(Color, BlendMode)
		std.math.geom::(Point, Rect)
		std.gfx.processing.transform::(FitMode)
		std.formats.video as video
	)

	// CommandKind names what a DrawCommand draws: a clear, rectangles, lines,
	// polygons, circles, ellipses, triangles, blits or video pictures.
	enum CommandKind {
		Clear
		FillRect
		StrokeRect
		Line
		Polyline
		Polygon
		FillCircle
		StrokeCircle
		FillEllipse
		StrokeEllipse
		FillTriangle
		StrokeTriangle
		BlitCopy
		Blit
		BlitRGBAtoBGRA
		// A video frame placed in `rect` by `fit` (`DrawContext.drawVideo`).
		Video
	}

	// DrawCommand is one recorded drawing operation: its kind and the geometry,
	// colour, stroke width and source pixels it uses.
	type DrawCommand {
		kind        CommandKind
		rect        Rect
		color       Color
		center      Point
		radius      float
		rx          float
		ry          float
		p0          Point
		p1          Point
		p2          Point
		points      Point[]
		strokeWidth float
		src         byte[]
		srcW        int
		srcH        int
		x           int
		y           int
		mode        BlendMode
		// The frame a Video command draws, and how it fits `rect`.
		video       ?video.VideoFrame = none
		fit         FitMode           = FitMode.Contain
	}
}
