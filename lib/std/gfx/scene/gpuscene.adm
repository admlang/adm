partial module std.gfx.scene {
	use (
		std.formats.models::(LightKind, Material, Texture)
		std.gfx.color::(Color)
		std.gfx.scene.raster::*
		std.math.geom::(Vec3)
	)

	// GpuScene is one picture of a prepared model as a renderer with a GPU
	// draws it, in place of `PreparedModel.render`: what to draw, in world
	// coordinates, and the view to draw it through. The picture it stands
	// for is the one `render` draws: the same visible meshes, lights,
	// lines and shading, so a renderer is checked against `render`.
	//
	// Drawing: every mesh's triangles are depth-tested (nearer wins, depth
	// from `viewProjection` as OpenGL clip coordinates, z in -w..w), solid
	// meshes first writing depth, then the `blend` ones from the greatest
	// `depth` to the least without writing it, composited over what is
	// there. A triangle seen from behind is drawn only when `doubleSided`
	// (its normal turned). Shading is glTF's metallic-roughness model as
	// `render` computes it, in linear light, written as sRGB.
	struct GpuScene {
		// Names the prepared model, and changes whenever it is prepared
		// again: what a renderer keeps for a model (vertex buffers,
		// textures) it keeps under both.
		model          uint64
		generation     uint64
		// World coordinates to clip coordinates, row-major.
		viewProjection float32[]
		eye            Vec3
		// The direction the view looks along, which is every pixel's line
		// of sight when `orthographic`.
		forward        Vec3
		orthographic   bool
		lights         GpuLight[]
		// The meshes in view, and every texture of the model that decoded.
		meshes         GpuMesh[]
		textures       GpuTexture[]
		// Whether the meshes' `triangles` are drawn, and whether their
		// `edges` are drawn over them in `edgeColor`, a little nearer than
		// the surface. Neither changes what a mesh lists, so a renderer that
		// keeps a mesh's buffers draws it under any shading from them.
		fill           bool
		wire           bool
		edgeColor      Color
		// The model's own lines: per line its two ends (6 values) and their
		// colours as linear red, green, blue and alpha (8 values).
		linePositions  float32[]
		lineColors     float32[]
		// The part of the diffuse colour every surface shows unlit.
		ambient        float
	}

	// GpuLight is a light placed in the world: `r`, `g`, `b` its linear
	// colour times its intensity, `direction` the unit vector it shines
	// along, `range` 0 for none, the cosines those of a spot's cone.
	struct GpuLight {
		kind      LightKind
		position  Vec3
		direction Vec3
		r         float
		g         float
		b         float
		range     float
		cosInner  float
		cosOuter  float
	}

	// GpuMesh is one primitive placed in the world. `id` names it within
	// the model and `stamp` changes when its vertices move, so a renderer
	// uploads the attribute arrays once per stamp; the arrays are the
	// prepared model's own and are only read.
	struct GpuMesh {
		id          uint64
		stamp       uint64
		// Per vertex: position (3), normal (3) and tangent (4) in world
		// coordinates, each texture coordinate set (2) and a colour (4);
		// empty for what the mesh lacks. A mesh without normals is shaded
		// by each triangle's own.
		positions   float32[]
		normals     float32[]
		tangents    float32[]
		uvs         float32[][]
		colors      float32[]
		// Vertex indices: triples, pairs, singles, and the triangles' edges
		// as pairs (listed once the model was asked for a wireframe).
		triangles   uint32[]
		segments    uint32[]
		points      uint32[]
		edges       uint32[]
		material    ?Material
		blend       bool
		doubleSided bool
		// The mean distance of the vertices along the view.
		depth       float
	}

	// GpuTexture is a texture's decoded base level: `width` by `height`
	// RGBA8 texels, row after row from the top. `colour` says the texels
	// are sRGB colours, to be averaged in linear light when shrunk; data
	// textures (normals, roughness) are averaged as stored. The texture's
	// own wrap and filter modes say how it is sampled.
	struct GpuTexture {
		texture Texture
		pixels  byte[]
		width   int
		height  int
		colour  bool
	}

	// The ids of prepared models, one each, from any task, and which of them
	// are still held.
	internal type PreparedIds {
		next uint64            = 0
		live map<uint64, bool>

		def new() {
			live = map<uint64, bool>{}
		}

		atomic def take() uint64 {
			next++
			live = live.set(next, true)
			return next
		}

		atomic def forget(id uint64) {
			live = live.delete(id)
		}

		atomic def holds(id uint64) bool {
			return live.hasKey(id)
		}
	}

	internal let preparedIds = new PreparedIds()

	// modelAlive says whether the prepared model with this `id()` is still
	// held by anyone. A renderer that keeps a model's vertices and textures
	// on a GPU asks before each frame and frees those of a model that is
	// gone.
	def modelAlive(id uint64) bool {
		return preparedIds.holds(id)
	}

	// gpuSceneOf gathers the picture of the prepared scene through the view.
	internal def gpuSceneOf(scene ScenePrepared, look SceneView, fill bool, wire bool, edge Color) GpuScene {
		let out = GpuScene{fill: fill, wire: wire, edgeColor: edge, eye: look.eye, forward: look.forward, orthographic: look.ortho, ambient: 0.12}
		let vp = look.viewProj
		out.viewProjection.len(16)
		for let r = 0; r < 4; r++ {
			for let c = 0; c < 4; c++ {
				out.viewProjection[r * 4 + c] = float32(vp[r][c])
			}
		}
		for let (_, l) in scene.lights(look) {
			out.lights.push(GpuLight{kind: l.kind, position: l.position, direction: l.direction, r: l.r, g: l.g, b: l.b, range: l.range, cosInner: l.cosInner, cosOuter: l.cosOuter})
		}
		for let (k, e) in scene.entries {
			continue when scene.unseen[e.node]
			continue when sceneBoxBehind(e.box, vp) < 0
			let geom = e.geom
			let mesh = GpuMesh{id: uint64(k), stamp: e.stamp, positions: e.pos, normals: e.nrm, tangents: e.tan, material: e.material, blend: e.blend, doubleSided: e.doubleSided}
			for let (_, set) in geom.prim.uvs {
				mesh.uvs.push(set.len() == geom.count * 2 ?? (set, float32[]))
			}
			let colors = geom.prim.colors
			mesh.colors = colors[0] when colors.len() > 0 && colors[0].len() == geom.count * 4
			mesh.triangles = geom.tris32
			mesh.segments = geom.lines32
			mesh.points = geom.points32
			mesh.edges = geom.edges32 when wire
			if e.blend {
				// The view depth of the box's middle.
				let x = (e.box[0] + e.box[3]) * 0.5
				let y = (e.box[1] + e.box[4]) * 0.5
				let z = (e.box[2] + e.box[5]) * 0.5
				mesh.depth = vp[3][0] * x + vp[3][1] * y + vp[3][2] * z + vp[3][3]
			}
			out.meshes.push(mesh)
		}
		for let (_, t) in scene.model.textures {
			let decoded = scene.textures.texture(t)
			continue when decoded is none
			out.textures.push(GpuTexture{texture: t, pixels: decoded.levels[0], width: decoded.widths[0], height: decoded.heights[0], colour: decoded.colour})
		}
		return out
	}
}
