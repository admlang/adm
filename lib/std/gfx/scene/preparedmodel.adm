partial module std.gfx.scene {
	use (
		std.formats.image::(Image)
		std.formats.models::(Animation, Axis, Camera, CameraKind, Model, Node, Primitive, Texture)
		std.gfx.color::(Color, RGBA)
		std.gfx.scene.raster::*
		std.math::(sin)
		std.math.geom::(Vec3)
	)

	// Shading is how a prepared model's surfaces are drawn.
	enum Shading {
		// Lit surfaces.
		Shaded,
		// The triangles' edges only, in PreparedModel.wireColor.
		Wireframe,
		// Lit surfaces with the triangles' edges over them.
		ShadedWireframe,
	}

	// SceneLine is a straight line drawn with a prepared model, hidden by
	// the surfaces in front of it: a ground grid, a bounding box, an axis.
	struct SceneLine {
		from  Vec3
		to    Vec3
		color Color
	}

	// SceneHit is what `PreparedModel.pick` found under a point of the
	// picture.
	struct SceneHit {
		// The node that places the surface, and the primitive of its mesh.
		node      Node
		primitive Primitive
		// The triangle's number in `primitive.triangleIndices()`.
		triangle  int
		// Where the surface was met, in scene coordinates, and how far that
		// is from the eye (from the picture's plane through the eye for an
		// orthographic lens).
		position  Vec3
		distance  float
	}

	// RenderProblem is something of a model that PreparedModel draws
	// without: a texture whose image is missing or does not decode.
	struct RenderProblem {
		texture Texture
		message string
	}

	// PreparedModel is a model made ready to be drawn many times: its
	// textures decoded, its meshes placed. Making one costs what the first
	// picture of `render(model, ...)` costs; each picture after that only
	// projects and draws. It never writes to the model: the pose an
	// animation gives is held here.
	//
	// A prepared model is used from any task. Pictures and picks only read
	// it, so they run beside one another (a thumbnail beside a view; one
	// `pick` at a time). A change (`pose`, `hide`, `show`, `reload`,
	// assigning `shading`, `wireColor` or `lines`) makes the pictures being
	// drawn give up, waits for them and for picks to end, and only then
	// changes the model; make changes from one task at a time.
	//
	// A picture is drawn by the task that asks for it and the tasks it
	// starts. Cancelling that task (`future.cancel()`) stops the drawing. A
	// picture that was cancelled, or given up for a change of the model,
	// returns none or false and leaves no part of itself behind.
	//
	// Example: Turn a model under the pointer
	// ```example
	// use (
	// 	std.formats.models
	// 	std.gfx.scene
	// )
	//
	// let prepared = new scene.PreparedModel(try models.load("robot.glb"))
	// let vantage = prepared.framing(800.0 / 600.0)
	// let picture = prepared.render(800, 600, vantage)
	// // Later, with the wheel turned: move the eye half way to the target.
	// vantage.eye = (vantage.eye + vantage.target) * 0.5
	// picture = prepared.render(800, 600, vantage)
	// ```
	type PreparedModel {
		model           Model
		// What the model has that is drawn without, found while preparing.
		problems        RenderProblem[]
		internal scene  ScenePrepared
		internal mode   Shading
		internal drawn  SceneLine[]
		internal edge   Color           = new Color(RGBA{r: 0, g: 0, b: 0, a: 255})
		internal count  uint64
		internal gate   SceneGate
		internal serial uint64
		internal made   uint64

		// new prepares the model as its nodes stand, animations not applied.
		def new(model Model) {
			self.model = model
			serial = preparedIds.take()
			gate = new SceneGate()
			drawn = SceneLine[]
			reload()
		}

		// reload prepares the model again, after it was changed: nodes,
		// meshes, materials or textures added, removed or edited. The pose
		// goes back to the nodes' own, and hidden nodes show again.
		def reload() {
			gate.close()
			defer gate.open()
			scene = new ScenePrepared(model)
			count++
			made++
			scene.wire() unless mode == Shading.Shaded
			problems = RenderProblem[]
			for let (_, f) in scene.textures.failures {
				problems.push(RenderProblem{texture: f.texture, message: f.message})
			}
		}

		// How surfaces are drawn; Shading.Shaded until set.
		shading Shading {
			def get() Shading {
				return mode
			}

			def set(value Shading) {
				gate.close()
				defer gate.open()
				mode = value
				count++
				scene.wire() unless value == Shading.Shaded
			}
		}

		// Lines drawn with the model in every picture. Assign a new array to
		// change them: one changed in place is not seen by `changes`.
		lines SceneLine[] {
			def get() SceneLine[] {
				return drawn
			}

			def set(value SceneLine[]) {
				gate.close()
				defer gate.open()
				drawn = value
				count++
			}
		}

		// The colour of the edges Shading.Wireframe and ShadedWireframe draw;
		// black until set.
		wireColor Color {
			def get() Color {
				return edge
			}

			def set(value Color) {
				gate.close()
				defer gate.open()
				edge = value
				count++
			}
		}

		// changes counts what changed the pictures since the model was
		// prepared: every `pose`, `hide`, `show` and `reload`, and every
		// assignment of `shading`, `lines` or `wireColor`. Two pictures from
		// equal viewpoints with the same count are the same picture.
		def changes() uint64 {
			return count
		}

		// pose places the nodes as the animation has them at the time, in
		// seconds; nodes and properties the animation does not key stay as
		// the model has them. None is the model's own pose. Only the meshes
		// of nodes that moved are placed again.
		def pose(animation ?Animation = none, time float = 0.0) {
			gate.close()
			defer gate.open()
			scene.pose(animation, time)
			count++
		}

		// hide leaves the node, and everything below it, out of pictures,
		// picks and `bounds`. A node outside the model's tree is ignored.
		def hide(node Node) {
			let at = scene.indexOf(node)
			return when at < 0
			gate.close()
			defer gate.open()
			scene.hide(at, true)
			count++
		}

		// show brings a hidden node back. Nodes below it that were hidden
		// themselves stay hidden.
		def show(node Node) {
			let at = scene.indexOf(node)
			return when at < 0
			gate.close()
			defer gate.open()
			scene.hide(at, false)
			count++
		}

		// hidden reports whether `hide` was called for the node itself.
		def hidden(node Node) bool {
			let at = scene.indexOf(node)
			return at >= 0 && scene.hidden[at]
		}

		// bounds is the axis-aligned box around every vertex drawn at the
		// current pose, in scene coordinates: its least and greatest corner.
		// None when nothing shown has a vertex.
		def bounds() ?(Vec3, Vec3) {
			return none unless scene.bounded
			let b = scene.box
			return (new Vec3(b[0], b[1], b[2]), new Vec3(b[3], b[4], b[5]))
		}

		// framing is a viewpoint that shows the whole model at the current
		// pose in a picture of the width to height ratio: from the front, a
		// little above, with the model's `upAxis` towards the top.
		def framing(aspect float = 1.0) Viewpoint {
			let up = scene.up
			// The side that faces the viewer with x to the right.
			let front = new Vec3(0, 0, 1)
			front = new Vec3(0, -1, 0) when model.upAxis == Axis.Z
			front = new Vec3(0, 0, -1) when model.upAxis == Axis.X
			let center = new Vec3(0, 0, 0)
			let radius = 1.0
			if scene.bounded {
				let b = scene.box
				let lo = new Vec3(b[0], b[1], b[2])
				let hi = new Vec3(b[3], b[4], b[5])
				center = (lo + hi) * 0.5
				radius = (hi - lo).length() * 0.5
				radius = 1.0 when radius == 0
			}
			let lens = new Camera()
			lens.yfov = 0.7
			let distance = radius / sin(lens.yfov / 2) * 1.05
			distance = distance / aspect when aspect < 1 && aspect > 0
			let eye = center + (up * 0.3 + front).normalized() * distance
			return new Viewpoint(eye, center, up, lens)
		}

		// viewpoint is the view through a camera node of the model at the
		// current pose, with the camera's own near and far planes. None when
		// the node holds no camera. A node outside the model's tree is taken
		// where its own transforms place it. A scale on the node scales the
		// lens's distances with it, by the mean of the three axes.
		def viewpoint(camera Node) ?Viewpoint {
			let own = camera.camera
			return none when own is none
			let at = scene.indexOf(camera)
			let m = at >= 0 ?? (scene.world[at], camera.worldTransform())
			let eye = new Vec3(m[0][3], m[1][3], m[2][3])
			// A camera looks along its node's negative z with y up.
			let side = new Vec3(m[0][0], m[1][0], m[2][0])
			let top = new Vec3(m[0][1], m[1][1], m[2][1])
			let back = new Vec3(m[0][2], m[1][2], m[2][2])
			let size = (side.length() + top.length() + back.length()) / 3
			let lens = new Camera(own.name, own.kind)
			lens.yfov = own.yfov
			lens.aspect = own.aspect
			lens.xmag = own.xmag * size
			lens.ymag = own.ymag * size
			lens.znear = own.znear * size
			lens.zfar = own.zfar * size
			let vantage = new Viewpoint(eye, eye - back.normalized(), top.normalized(), lens)
			vantage.fitDepth = false
			return vantage
		}

		// render draws the model as seen from the viewpoint into a new image
		// of the size. `samples` is the pixels drawn per output pixel along
		// each axis, 1 to 4. None when the task was cancelled or the model was
		// changed meanwhile.
		def render(width int, height int, vantage Viewpoint, background Color = new Color(RGBA{r: 0, g: 0, b: 0, a: 0}), samples int = 1) ?Image {
			let n = samples.clamp(1, 4)
			gate.enter()
			defer gate.leave()
			let target = draw(lookFrom(vantage, width.max(1) * n, height.max(1) * n), background)
			return none when target is none
			return target.image(n)
		}

		// render draws the model into `into`, at its size, replacing what it
		// holds, and reports whether it did: a cancelled task, or a change of
		// the model meanwhile, leaves `into` exactly as it was.
		def render(into Image, vantage Viewpoint, background Color = new Color(RGBA{r: 0, g: 0, b: 0, a: 0}), samples int = 1) bool {
			let n = samples.clamp(1, 4)
			let width = int(into.size().width)
			let height = int(into.size().height)
			return false when width < 1 || height < 1
			gate.enter()
			defer gate.leave()
			let target = draw(lookFrom(vantage, width * n, height * n), background)
			return false when target is none
			return target.write(into, n)
		}

		// pick is the surface under the point (x, y) of a picture `width` by
		// `height` seen from the viewpoint, x to the right and y down from
		// the top left corner: the nearest triangle on the line of sight,
		// found without drawing. None when the point shows no surface. Lines
		// and points are not picked, and a cut-out material counts as solid.
		// The first pick after the model or its pose changed sorts the
		// triangles it reaches into a tree, which the following picks reuse.
		def pick(vantage Viewpoint, width float, height float, x float, y float) ?SceneHit {
			return none when width <= 0 || height <= 0
			gate.enter()
			defer gate.leave()
			let look = lookFrom(vantage, 1, 1)
			let nx = 2 * x / width - 1
			let ny = 1 - 2 * y / height
			let l = look.look
			let right = new Vec3(l[0][0], l[0][1], l[0][2])
			let top = new Vec3(l[1][0], l[1][1], l[1][2])
			let p = lens(vantage, width / height)
			let origin = vantage.eye
			let dir = look.forward
			if look.ortho {
				origin = origin + right * ((nx - p[0][3]) / p[0][0]) + top * ((ny - p[1][3]) / p[1][1])
			} else {
				dir = (right * (nx / p[0][0]) + top * (ny / p[1][1]) + look.forward).normalized()
			}
			let (entry, triangle, distance) = scenePick(scene, origin.x, origin.y, origin.z, dir.x, dir.y, dir.z)
			return none when entry < 0
			let e = scene.entries[entry]
			return SceneHit{node: scene.nodes[e.node], primitive: e.geom.prim, triangle: triangle, position: origin + dir * distance, distance: distance}
		}

		// Names this prepared model, for the renderers that keep its vertices
		// and textures: no other prepared model has it.
		def id() uint64 {
			return serial
		}

		// dispose runs when the last reference to the prepared model goes
		// (or call it when done with it): the renderers that keep its
		// vertices and textures on a GPU free them at their next frame, and
		// a picture of it they are asked for after that is drawn from
		// nothing kept.
		def dispose() {
			preparedIds.forget(serial)
		}

		// gpuScene is the picture `render(width, height, from)` draws, for a
		// renderer that draws it on a GPU: the meshes in view, the lights,
		// the textures and the view (see GpuScene). It only reads the
		// prepared model, as `render` does.
		def gpuScene(from Viewpoint, width int, height int) GpuScene {
			gate.enter()
			defer gate.leave()
			let look = lookFrom(from, width.max(1), height.max(1))
			let out = gpuSceneOf(scene, look, mode != Shading.Wireframe, mode != Shading.Shaded, edge)
			out.model = serial
			out.generation = made
			for let (_, line) in drawn {
				out.linePositions.push(float32(line.from.x), float32(line.from.y), float32(line.from.z), float32(line.to.x), float32(line.to.y), float32(line.to.z))
				let c = line.color
				let r = float32(sceneLinear(c.red))
				let g = float32(sceneLinear(c.green))
				let b = float32(sceneLinear(c.blue))
				let a = float32(float(c.alpha) / 255.0)
				out.lineColors.push(r, g, b, a, r, g, b, a)
			}
			return out
		}

		// draw draws one picture through the view.
		internal def draw(look SceneView, background Color) ?SceneTarget {
			let picture = new ScenePicture(background, edge)
			picture.fill = mode != Shading.Wireframe
			picture.wire = mode != Shading.Shaded
			for let (_, line) in drawn {
				picture.linePos.push(float32(line.from.x), float32(line.from.y), float32(line.from.z), float32(line.to.x), float32(line.to.y), float32(line.to.z))
				let c = line.color
				let r = float32(sceneLinear(c.red))
				let g = float32(sceneLinear(c.green))
				let b = float32(sceneLinear(c.blue))
				let a = float32(float(c.alpha) / 255.0)
				picture.lineCol.push(r, g, b, a, r, g, b, a)
			}
			return sceneDraw(scene, look, picture, gate)
		}

		// lens is the viewpoint's projection for a picture of the width to
		// height ratio, its near and far planes around what is drawn when
		// the viewpoint fits them.
		internal def lens(vantage Viewpoint, aspect float) matrix<float, 4, 4> {
			return vantage.lens.projection(aspect) unless vantage.fitDepth
			let forward = (vantage.target - vantage.eye).normalized()
			// How far along the look the nearest and the farthest drawn point
			// are: over the corners of the model's box and the lines' ends.
			let near = 3.0e38
			let far = -3.0e38
			if scene.bounded {
				let b = scene.box
				for let c = 0; c < 8; c++ {
					let corner = new Vec3(b[c % 2 == 0 ?? (0, 3)], b[(c / 2) % 2 == 0 ?? (1, 4)], b[c / 4 == 0 ?? (2, 5)])
					let d = (corner - vantage.eye).dot(forward)
					near = near.min(d)
					far = far.max(d)
				}
			}
			for let (_, line) in drawn {
				let d0 = (line.from - vantage.eye).dot(forward)
				let d1 = (line.to - vantage.eye).dot(forward)
				near = near.min(d0.min(d1))
				far = far.max(d0.max(d1))
			}
			return vantage.lens.projection(aspect) when far < near
			let margin = (far - near) * 0.01 + 1.0e-6
			let fitted = new Camera(vantage.lens.name, vantage.lens.kind)
			fitted.yfov = vantage.lens.yfov
			fitted.xmag = vantage.lens.xmag
			fitted.ymag = vantage.lens.ymag
			fitted.zfar = far + margin
			fitted.znear = near - margin
			if vantage.lens.kind == CameraKind.Perspective {
				// Everything behind the eye: any planes do. Else a near plane
				// in front of the eye, no closer than a ten-thousandth of the
				// far one, which keeps the depths apart.
				fitted.zfar = 1.0 when fitted.zfar <= 0
				fitted.znear = fitted.znear.max(fitted.zfar * 1.0e-4)
			}
			return fitted.projection(aspect)
		}

		// lookFrom is the viewpoint as the renderer's view of a picture of
		// the size in drawn pixels.
		internal def lookFrom(vantage Viewpoint, width int, height int) SceneView {
			let forward = (vantage.target - vantage.eye).normalized()
			let ortho = vantage.lens.kind == CameraKind.Orthographic
			return new SceneView(lookAt(vantage.eye, vantage.target, vantage.up), lens(vantage, float(width) / float(height)), vantage.eye, forward, ortho, width, height)
		}
	}
}
