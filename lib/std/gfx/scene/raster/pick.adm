internal partial module std.gfx.scene.raster {
	// The most triangles a leaf of a SceneTree holds.
	const sceneLeafSize = 4

	// SceneTree is the triangles of one entry in a tree of boxes, so a ray
	// meets the few it passes near instead of all of them.
	type SceneTree {
		// Per tree node its box: least corner, then greatest.
		boxes float32[]
		// Per tree node: for an inner node its first child's number (the
		// second follows it), for a leaf its first slot in `order`.
		link  int[]
		// Per tree node the triangles of a leaf, 0 for an inner node.
		size  int[]
		// Triangle numbers, each leaf's together.
		order int[]

		// new builds the tree over the triangles `tris` (index triples) of
		// the vertices `pos` (x, y, z each): each node splits its triangles
		// at the middle of the longest side of the box around their centres.
		def new(pos float32[], tris int[]) {
			boxes = float32[]
			link = int[]
			size = int[]
			order = int[]
			let n = tris.len() / 3
			order.len(n)
			let centre float32[]
			centre.len(n * 3)
			for let t = 0; t < n; t++ {
				order[t] = t
				let a = tris[t * 3] * 3
				let b = tris[t * 3 + 1] * 3
				let c = tris[t * 3 + 2] * 3
				for let k = 0; k < 3; k++ {
					centre[t * 3 + k] = (pos[a + k] + pos[b + k] + pos[c + k]) / float32(3)
				}
			}
			add()
			// Tree nodes still to split: node, first slot, slot past the last.
			let todo = int[0, 0, n]
			let lo = float32[0, 0, 0]
			let hi = float32[0, 0, 0]
			let clo = float32[0, 0, 0]
			let chi = float32[0, 0, 0]
			for todo.len() > 0 {
				let to = todo.pop()
				let from = todo.pop()
				let node = todo.pop()
				for let k = 0; k < 3; k++ {
					lo[k] = float32(3.0e38)
					hi[k] = float32(-3.0e38)
					clo[k] = float32(3.0e38)
					chi[k] = float32(-3.0e38)
				}
				for let s = from; s < to; s++ {
					let t = order[s]
					for let corner = 0; corner < 3; corner++ {
						let v = tris[t * 3 + corner] * 3
						for let k = 0; k < 3; k++ {
							lo[k] = lo[k].min(pos[v + k])
							hi[k] = hi[k].max(pos[v + k])
						}
					}
					for let k = 0; k < 3; k++ {
						clo[k] = clo[k].min(centre[t * 3 + k])
						chi[k] = chi[k].max(centre[t * 3 + k])
					}
				}
				for let k = 0; k < 3; k++ {
					boxes[node * 6 + k] = lo[k]
					boxes[node * 6 + 3 + k] = hi[k]
				}
				if to - from <= sceneLeafSize {
					link[node] = from
					size[node] = to - from
					continue
				}
				let axis = 0
				axis = 1 when chi[1] - clo[1] > chi[axis] - clo[axis]
				axis = 2 when chi[2] - clo[2] > chi[axis] - clo[axis]
				let middle = (clo[axis] + chi[axis]) * float32(0.5)
				let i = from
				let j = to - 1
				for i <= j {
					if centre[order[i] * 3 + axis] < middle {
						i++
						continue
					}
					let held = order[i]
					order[i] = order[j]
					order[j] = held
					j--
				}
				// Centres that share the middle would leave one side empty.
				i = (from + to) / 2 when i == from || i == to
				let child = add()
				add()
				link[node] = child
				todo.push(child, from, i)
				todo.push(child + 1, i, to)
			}
		}

		// add appends an empty tree node and returns its number.
		def add() int {
			let node = link.len()
			link.push(0)
			size.push(0)
			boxes.push(float32(0), float32(0), float32(0), float32(0), float32(0), float32(0))
			return node
		}

		// nearest is the triangle the ray from (ox, oy, oz) along the unit
		// direction (dx, dy, dz) meets first, nearer than `limit`, and the
		// distance to it; (-1, limit) when it meets none. Triangles seen from
		// behind count only with `bothSides`.
		def nearest(pos float32[], tris int[], ox float, oy float, oz float, dx float, dy float, dz float, limit float, bothSides bool) (int, float) {
			let best = limit
			let found = -1
			return (found, best) when order.len() == 0
			let ix = sceneInverse(dx)
			let iy = sceneInverse(dy)
			let iz = sceneInverse(dz)
			let stack = int[0]
			for stack.len() > 0 {
				let node = stack.pop()
				continue when entry(node, ox, oy, oz, ix, iy, iz, best) >= best
				let count = size[node]
				if count == 0 {
					// The nearer child is looked at first, so the farther one is
					// often skipped by the distance already found.
					let first = link[node]
					let near = entry(first, ox, oy, oz, ix, iy, iz, best)
					let far = entry(first + 1, ox, oy, oz, ix, iy, iz, best)
					if near <= far {
						stack.push(first + 1, first)
					} else {
						stack.push(first, first + 1)
					}
					continue
				}
				let from = link[node]
				for let s = from; s < from + count; s++ {
					let t = order[s]
					let a = tris[t * 3] * 3
					let b = tris[t * 3 + 1] * 3
					let c = tris[t * 3 + 2] * 3
					// Möller-Trumbore.
					let ax = float(pos[a])
					let ay = float(pos[a + 1])
					let az = float(pos[a + 2])
					let e1x = float(pos[b]) - ax
					let e1y = float(pos[b + 1]) - ay
					let e1z = float(pos[b + 2]) - az
					let e2x = float(pos[c]) - ax
					let e2y = float(pos[c + 1]) - ay
					let e2z = float(pos[c + 2]) - az
					let px = dy * e2z - dz * e2y
					let py = dz * e2x - dx * e2z
					let pz = dx * e2y - dy * e2x
					let det = e1x * px + e1y * py + e1z * pz
					continue when det == 0
					continue when det < 0 && !bothSides
					let inv = 1.0 / det
					let tx = ox - ax
					let ty = oy - ay
					let tz = oz - az
					let u = (tx * px + ty * py + tz * pz) * inv
					continue when u < 0 || u > 1
					let qx = ty * e1z - tz * e1y
					let qy = tz * e1x - tx * e1z
					let qz = tx * e1y - ty * e1x
					let v = (dx * qx + dy * qy + dz * qz) * inv
					continue when v < 0 || u + v > 1
					let d = (e2x * qx + e2y * qy + e2z * qz) * inv
					continue when d <= 0 || d >= best
					best = d
					found = t
				}
			}
			return (found, best)
		}

		// entry is how far along the ray it enters the tree node's box, or
		// `miss` when it passes the box or enters it beyond `miss`.
		def entry(node int, ox float, oy float, oz float, ix float, iy float, iz float, miss float) float {
			return sceneBoxEntry(float(boxes[node * 6]), float(boxes[node * 6 + 1]), float(boxes[node * 6 + 2]), float(boxes[node * 6 + 3]), float(boxes[node * 6 + 4]), float(boxes[node * 6 + 5]), ox, oy, oz, ix, iy, iz, miss)
		}
	}

	// sceneInverse is 1/d for a ray direction's component, a very large
	// number of d's sign for one that is zero.
	def sceneInverse(d float) float {
		return 1.0 / d when d.abs() > 1.0e-300
		return 1.0e300
	}

	// sceneBoxEntry is how far along the ray from (ox, oy, oz), whose
	// direction's inverses are (ix, iy, iz), it enters the box (0 from
	// inside), or `miss` when it passes it or enters beyond `miss`.
	def sceneBoxEntry(lx float, ly float, lz float, hx float, hy float, hz float, ox float, oy float, oz float, ix float, iy float, iz float, miss float) float {
		let t0 = (lx - ox) * ix
		let t1 = (hx - ox) * ix
		let near = t0.min(t1)
		let far = t0.max(t1)
		t0 = (ly - oy) * iy
		t1 = (hy - oy) * iy
		near = near.max(t0.min(t1))
		far = far.min(t0.max(t1))
		t0 = (lz - oz) * iz
		t1 = (hz - oz) * iz
		near = near.max(t0.min(t1))
		far = far.min(t0.max(t1))
		return miss when far < near.max(0.0) || near >= miss
		return near.max(0.0)
	}

	// scenePick is the entry and triangle the ray from (ox, oy, oz) along
	// the unit direction (dx, dy, dz) meets first, and the distance to it;
	// the entry is -1 when it meets nothing. Hidden entries are passed
	// through, and a triangle of a material that is not double-sided counts
	// only from its front. An entry's tree is built the first time a ray
	// reaches its box, so one pick runs at a time.
	def scenePick(scene ScenePrepared, ox float, oy float, oz float, dx float, dy float, dz float) (int, int, float) {
		let best = 3.0e38
		let entry = -1
		let triangle = -1
		let ix = sceneInverse(dx)
		let iy = sceneInverse(dy)
		let iz = sceneInverse(dz)
		for let (k, e) in scene.entries {
			continue when scene.unseen[e.node] || e.geom.tris.len() == 0
			let b = e.box
			continue when sceneBoxEntry(b[0], b[1], b[2], b[3], b[4], b[5], ox, oy, oz, ix, iy, iz, best) >= best
			let (t, d) = e.triangles().nearest(e.pos, e.geom.tris, ox, oy, oz, dx, dy, dz, best, e.doubleSided)
			continue when t < 0
			best = d
			entry = k
			triangle = t
		}
		return (entry, triangle, best)
	}
}
