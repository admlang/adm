// The scene renderer: the model's nodes turned into screen-space primitives
// (prepare.adm), rasterised in row bands (raster.adm) and shaded per pixel
// (shade.adm).
internal partial module std.gfx.scene.raster {
	use (
		std.formats.image::(Image)
		std.formats.models::*
		std.gfx.scene::(RenderOptions)
		std.math::(cos, sin, sqrt)
		std.math.geom::(Vec3)
	)

	// Depth of a pixel nothing has been drawn at.
	const sceneFarDepth = 3.0e38

	// SceneView is where the scene is seen from: the matrices, the eye and
	// the picture size in drawn pixels.
	type SceneView {
		look       matrix<float, 4, 4>
		projection matrix<float, 4, 4>
		viewProj   matrix<float, 4, 4>
		eye        Vec3
		// The direction the camera looks along, for an orthographic camera's
		// constant look vector.
		forward    Vec3
		ortho      bool
		width      int
		height     int

		def new(look matrix<float, 4, 4>, projection matrix<float, 4, 4>, eye Vec3, forward Vec3, ortho bool, width int, height int) {
			self.look = look
			self.projection = projection
			viewProj = projection * look
			self.eye = eye
			self.forward = forward
			self.ortho = ortho
			self.width = width
			self.height = height
		}
	}

	// SceneLight is a light placed in the world.
	type SceneLight {
		kind      LightKind
		position  Vec3
		// The direction the light shines along, unit length.
		direction Vec3
		// Linear colour times intensity.
		r         float
		g         float
		b         float
		range     float
		cosInner  float
		cosOuter  float

		def new(kind LightKind, position Vec3, direction Vec3, r float, g float, b float) {
			self.kind = kind
			self.position = position
			self.direction = direction
			self.r = r
			self.g = g
			self.b = b
		}
	}

	// ScenePrimitive is one drawn primitive with its vertices in screen space
	// and its attributes in world space, flat per vertex; the triangles,
	// segments and points are index lists into them.
	type ScenePrimitive {
		material    ?Material
		doubleSided bool
		blend       bool
		// Screen x and y in pixels, depth in 0..1 and 1/w per vertex.
		sx          float32[]
		sy          float32[]
		sz          float32[]
		sw          float32[]
		// World position (3), normal (3), tangent (4), texture coordinate sets
		// (2 each) and colour (4) per vertex; empty when the mesh has none.
		pos         float32[]
		nrm         float32[]
		tan         float32[]
		uv          float32[][]
		col         float32[]
		tris        int[]
		segments    int[]
		points      int[]
		// The mean look depth, for drawing blended primitives from the back.
		depthKey    float

		def new() {
			sx = float32[]
			sy = float32[]
			sz = float32[]
			sw = float32[]
			pos = float32[]
			nrm = float32[]
			tan = float32[]
			uv = float32[][]
			col = float32[]
			tris = int[]
			segments = int[]
			points = int[]
		}
	}

	// renderScene draws the model as `render` says.
	def renderScene(model Model, width int, height int, options RenderOptions) Image {
		let samples = options.samples.clamp(1, 4)
		let w = (width.max(1)) * samples
		let h = (height.max(1)) * samples
		for let (_, anim) in model.animations {
			anim.apply(options.time)
		}
		let look = sceneView(model, options.camera, w, h)
		let lights = sceneLights(model, look)
		let textures = new SceneTextures(model)
		let prims ScenePrimitive[]
		model.walk(def (n Node) bool {
			let mesh = n.mesh
			return true when mesh is none
			let world = n.worldTransform()
			let skin = n.skin
			let joints matrix<float, 4, 4>[]
			joints = skin.jointMatrices(n) unless skin is none
			for let (_, p) in mesh.primitives {
				continue when p.vertexCount() == 0
				prims.push(preparePrimitive(p, n, world, joints, look))
			}
			return true
		})
		let target = new SceneTarget(w, h, options.background)
		let shader = new SceneShader(look, lights, textures)
		drawPrimitives(target, prims, shader, false)
		let blended ScenePrimitive[]
		for let (_, p) in prims {
			blended.push(p) when p.blend
		}
		blended.sort((a ScenePrimitive, b ScenePrimitive) => a.depthKey > b.depthKey)
		drawPrimitives(target, blended, shader, true)
		return target.image(samples)
	}

	// sceneView places the camera: the chosen node's, the first camera in
	// the tree, or one looking at the whole scene from the front.
	def sceneView(model Model, chosen ?Node, width int, height int) SceneView {
		let aspect = float(width) / float(height)
		let node = chosen
		if node is none {
			model.walk(def (n Node) bool {
				return true when n.camera is none
				node = n
				return false
			})
		}
		if !(node is none) {
			let cam = node.camera
			if !(cam is none) {
				let world = node.worldTransform()
				// The look is the inverse of the camera's placement: scale,
				// rotation and translation undone in turn.
				let placed = new Node()
				placed.transform = world
				let rinv = placed.rotation.conjugate().matrix()
				let tinv = matrix<float, 4, 4>[]
				let sinv = matrix<float, 4, 4>[]
				for let k = 0; k < 4; k++ {
					tinv[k][k] = 1
					sinv[k][k] = 1
				}
				tinv[0][3] = -placed.translation.x
				tinv[1][3] = -placed.translation.y
				tinv[2][3] = -placed.translation.z
				sinv[0][0] = placed.scale.x != 0 ?? (1.0 / placed.scale.x, 1.0)
				sinv[1][1] = placed.scale.y != 0 ?? (1.0 / placed.scale.y, 1.0)
				sinv[2][2] = placed.scale.z != 0 ?? (1.0 / placed.scale.z, 1.0)
				let look = sinv * rinv * tinv
				let forward = placed.rotation.rotate(new Vec3(0, 0, -1)).normalized()
				return new SceneView(look, cam.projection(aspect), placed.translation, forward, cam.kind == CameraKind.Orthographic, width, height)
			}
		}
		// Frame the scene: a camera in front of it, a little above, far
		// enough for the whole bounding sphere to fit the vertical field.
		let center = new Vec3(0, 0, 0)
		let radius = 1.0
		let box = model.bounds()
		if !(box is none) {
			let (lo, hi) = box
			center = (lo + hi) * 0.5
			radius = (hi - lo).length() * 0.5
			radius = 1.0 when radius == 0
		}
		let cam = new Camera("")
		cam.yfov = 0.7
		let distance = radius / sin(cam.yfov / 2) * 1.05
		distance = distance.max(radius / sin(cam.yfov / 2) / aspect * 1.05) when aspect < 1
		let eye = center + new Vec3(0.0, 0.3, 1.0).normalized() * distance
		cam.znear = (distance - radius * 1.5).max(distance * 0.01)
		cam.zfar = distance + radius * 1.5
		let forward = (center - eye).normalized()
		return new SceneView(lookAt(eye, center), cam.projection(aspect), eye, forward, false, width, height)
	}

	// lookAt is the look matrix of an eye looking at a point with y up.
	def lookAt(eye Vec3, center Vec3) matrix<float, 4, 4> {
		let f = (center - eye).normalized()
		let up = new Vec3(0, 1, 0)
		up = new Vec3(0, 0, -1) when f.cross(up).length() < 1e-6
		let r = f.cross(up).normalized()
		let u = r.cross(f)
		let m = matrix<float, 4, 4>[]
		m[0][0] = r.x
		m[0][1] = r.y
		m[0][2] = r.z
		m[0][3] = -r.dot(eye)
		m[1][0] = u.x
		m[1][1] = u.y
		m[1][2] = u.z
		m[1][3] = -u.dot(eye)
		m[2][0] = -f.x
		m[2][1] = -f.y
		m[2][2] = -f.z
		m[2][3] = f.dot(eye)
		m[3][3] = 1
		return m
	}

	// sceneLights places the model's lights by the nodes that hold them; a
	// model with none gets one white light shining along the look.
	def sceneLights(model Model, look SceneView) SceneLight[] {
		let out SceneLight[]
		model.walk(def (n Node) bool {
			let light = n.light
			return true when light is none
			let world = n.worldTransform()
			let position = new Vec3(world[0][3], world[1][3], world[2][3])
			// The light shines along the node's negative z.
			let direction = new Vec3(-world[0][2], -world[1][2], -world[2][2]).normalized()
			let c = light.color
			let i = light.intensity
			let l = new SceneLight(light.kind, position, direction, sceneLinear(c.red) * i, sceneLinear(c.green) * i, sceneLinear(c.blue) * i)
			l.range = light.range
			l.cosInner = cos(light.innerCone)
			l.cosOuter = cos(light.outerCone)
			out.push(l)
			return true
		})
		if out.len() == 0 {
			// A key light from above the camera's shoulder.
			let dir = look.forward
			let side = dir.cross(new Vec3(0, 1, 0))
			side = new Vec3(1, 0, 0) when side.length() < 1e-6
			let shine = (dir * 0.8 - new Vec3(0, 1, 0) * 0.5 + side.normalized() * 0.3).normalized()
			out.push(new SceneLight(LightKind.Directional, look.eye, shine, 3.0, 3.0, 3.0))
		}
		return out
	}

	// sceneLinear is an 8-bit sRGB channel as linear light.
	def sceneLinear(c uint8) float {
		let v = float(c) / 255.0
		return v / 12.92 when v <= 0.04045
		return ((v + 0.055) / 1.055) ** 2.4
	}

	// preparePrimitive takes a primitive through its node (morph targets,
	// skin, world transform) into clip space, clips its triangles to the
	// near plane and projects the vertices to the screen.
	def preparePrimitive(p Primitive, node Node, world matrix<float, 4, 4>, joints matrix<float, 4, 4>[], look SceneView) ScenePrimitive {
		let out = new ScenePrimitive()
		out.material = p.material
		let m = p.material
		if !(m is none) {
			out.doubleSided = m.doubleSided
			out.blend = m.alphaMode == AlphaMode.Blend
		}
		let count = p.vertexCount()
		let positions = p.positions
		let normals = p.normals
		let tangents = p.tangents
		// Morph targets: the node's weights over the targets' displacements.
		if p.targets.len() > 0 && node.weights.len() > 0 {
			positions = positions.clone()
			normals = normals.clone() when normals.len() > 0
			tangents = tangents.clone() when tangents.len() > 0
			for let (t, target) in p.targets {
				continue when t >= node.weights.len()
				let w = float32(node.weights[t])
				continue when w == 0
				addScaled(positions, target.positions, w, 3, 3)
				addScaled(normals, target.normals, w, 3, 3) when normals.len() > 0
				addScaled(tangents, target.tangents, w, 3, 4) when tangents.len() > 0
			}
		}
		// Skinning: each vertex moved by its four joints' matrices, blended by
		// its weights, in the node's coordinates.
		if joints.len() > 0 && p.joints.len() == count * 4 && p.weights.len() == count * 4 {
			let skinned float32[]
			skinned.len(count * 3)
			let skinnedNormals float32[]
			skinnedNormals.len(normals.len())
			for let v = 0; v < count; v++ {
				let px = float(positions[v * 3])
				let py = float(positions[v * 3 + 1])
				let pz = float(positions[v * 3 + 2])
				let nx = 0.0
				let ny = 0.0
				let nz = 0.0
				if normals.len() > 0 {
					nx = float(normals[v * 3])
					ny = float(normals[v * 3 + 1])
					nz = float(normals[v * 3 + 2])
				}
				let ox = 0.0
				let oy = 0.0
				let oz = 0.0
				let qx = 0.0
				let qy = 0.0
				let qz = 0.0
				for let k = 0; k < 4; k++ {
					let w = float(p.weights[v * 4 + k])
					continue when w == 0
					let j = int(p.joints[v * 4 + k])
					continue when j >= joints.len()
					let jm = joints[j]
					ox += w * (jm[0][0] * px + jm[0][1] * py + jm[0][2] * pz + jm[0][3])
					oy += w * (jm[1][0] * px + jm[1][1] * py + jm[1][2] * pz + jm[1][3])
					oz += w * (jm[2][0] * px + jm[2][1] * py + jm[2][2] * pz + jm[2][3])
					qx += w * (jm[0][0] * nx + jm[0][1] * ny + jm[0][2] * nz)
					qy += w * (jm[1][0] * nx + jm[1][1] * ny + jm[1][2] * nz)
					qz += w * (jm[2][0] * nx + jm[2][1] * ny + jm[2][2] * nz)
				}
				skinned[v * 3] = float32(ox)
				skinned[v * 3 + 1] = float32(oy)
				skinned[v * 3 + 2] = float32(oz)
				if normals.len() > 0 {
					skinnedNormals[v * 3] = float32(qx)
					skinnedNormals[v * 3 + 1] = float32(qy)
					skinnedNormals[v * 3 + 2] = float32(qz)
				}
			}
			positions = skinned
			normals = skinnedNormals
		}
		// World space attributes.
		out.pos.len(count * 3)
		let vp = look.viewProj
		let clip float[]
		clip.len(count * 4)
		for let v = 0; v < count; v++ {
			let x = float(positions[v * 3])
			let y = float(positions[v * 3 + 1])
			let z = float(positions[v * 3 + 2])
			let wx = world[0][0] * x + world[0][1] * y + world[0][2] * z + world[0][3]
			let wy = world[1][0] * x + world[1][1] * y + world[1][2] * z + world[1][3]
			let wz = world[2][0] * x + world[2][1] * y + world[2][2] * z + world[2][3]
			out.pos[v * 3] = float32(wx)
			out.pos[v * 3 + 1] = float32(wy)
			out.pos[v * 3 + 2] = float32(wz)
			clip[v * 4] = vp[0][0] * wx + vp[0][1] * wy + vp[0][2] * wz + vp[0][3]
			clip[v * 4 + 1] = vp[1][0] * wx + vp[1][1] * wy + vp[1][2] * wz + vp[1][3]
			clip[v * 4 + 2] = vp[2][0] * wx + vp[2][1] * wy + vp[2][2] * wz + vp[2][3]
			clip[v * 4 + 3] = vp[3][0] * wx + vp[3][1] * wy + vp[3][2] * wz + vp[3][3]
		}
		out.nrm = rotateNormals(normals, world, 3) when normals.len() == count * 3
		out.tan = rotateNormals(tangents, world, 4) when tangents.len() == count * 4
		for let (_, set) in p.uvs {
			out.uv.push(set.len() == count * 2 ?? (set, float32[]))
		}
		out.col = p.colors[0] when p.colors.len() > 0 && p.colors[0].len() == count * 4
		// The look depth of the primitive's middle, for blend ordering.
		let depth = 0.0
		for let v = 0; v < count; v++ {
			depth += clip[v * 4 + 3]
		}
		out.depthKey = count > 0 ?? (depth / float(count), 0.0)
		// Triangles clipped against the near plane; segments and points
		// dropped when any end is behind it.
		let indices = p.triangleIndices()
		let clipper = new SceneClipper(out, clip)
		for let t = 0; t + 2 < indices.len(); t += 3 {
			clipper.triangle(int(indices[t]), int(indices[t + 1]), int(indices[t + 2]))
		}
		switch p.topology {
			case Topology.Lines:
				for let k = 0; k + 1 < p.indexCount(); k += 2 {
					clipper.segment(int(sceneIndex(p, k)), int(sceneIndex(p, k + 1)))
				}
			case Topology.LineStrip, Topology.LineLoop:
				let n = p.indexCount()
				for let k = 0; k + 1 < n; k++ {
					clipper.segment(int(sceneIndex(p, k)), int(sceneIndex(p, k + 1)))
				}
				clipper.segment(int(sceneIndex(p, n - 1)), int(sceneIndex(p, 0))) when p.topology == Topology.LineLoop && n > 2
			case Topology.Points:
				for let k = 0; k < p.indexCount(); k++ {
					let v = int(sceneIndex(p, k))
					out.points.push(v) when clipper.clip[v * 4 + 2] + clipper.clip[v * 4 + 3] >= 0
				}
			default:
		}
		clipper.project(look)
		return out
	}

	// sceneIndex is the vertex the k-th drawn index names.
	def sceneIndex(p Primitive, k int) int {
		return int(p.indices[k]) when p.indices.len() > 0
		return k
	}

	// addScaled adds `scale` times a displacement array (`inWidth` values
	// per vertex) into an attribute of `outWidth` values per vertex.
	def addScaled(into float32[], delta float32[], scale float32, inWidth int, outWidth int) {
		let count = delta.len() / inWidth
		for let v = 0; v < count; v++ {
			for let k = 0; k < inWidth; k++ {
				let at = v * outWidth + k
				into[at] += delta[v * inWidth + k] * scale when at < into.len()
			}
		}
	}

	// rotateNormals takes `width`-strided direction vectors through the
	// inverse transpose of the matrix's 3×3 part and normalises them, so a
	// non-uniform scale keeps them perpendicular to the surface.
	def rotateNormals(attr float32[], m matrix<float, 4, 4>, width int) float32[] {
		let out = attr.clone()
		// The inverse transpose of the 3×3 part, by adjugate.
		let a = m[0][0]
		let b = m[0][1]
		let c = m[0][2]
		let d = m[1][0]
		let e = m[1][1]
		let f = m[1][2]
		let g = m[2][0]
		let h = m[2][1]
		let i = m[2][2]
		let det = a * (e * i - f * h) - b * (d * i - f * g) + c * (d * h - e * g)
		let n00 = e * i - f * h
		let n01 = f * g - d * i
		let n02 = d * h - e * g
		let n10 = c * h - b * i
		let n11 = a * i - c * g
		let n12 = b * g - a * h
		let n20 = b * f - c * e
		let n21 = c * d - a * f
		let n22 = a * e - b * d
		if det == 0 {
			n00 = a
			n01 = b
			n02 = c
			n10 = d
			n11 = e
			n12 = f
			n20 = g
			n21 = h
			n22 = i
		}
		for let k = 0; k + 2 < out.len(); k += width {
			let x = float(out[k])
			let y = float(out[k + 1])
			let z = float(out[k + 2])
			let rx = n00 * x + n01 * y + n02 * z
			let ry = n10 * x + n11 * y + n12 * z
			let rz = n20 * x + n21 * y + n22 * z
			let len = sqrt(rx * rx + ry * ry + rz * rz)
			continue when len == 0
			out[k] = float32(rx / len)
			out[k + 1] = float32(ry / len)
			out[k + 2] = float32(rz / len)
		}
		return out
	}

	// SceneClipper cuts triangles against the near plane (z + w >= 0 in clip
	// space), appending the vertices the cuts make with their attributes
	// interpolated, and projects every vertex to the screen.
	type SceneClipper {
		prim ScenePrimitive
		clip float[]

		def new(prim ScenePrimitive, clip float[]) {
			self.prim = prim
			self.clip = clip
		}

		def distance(v int) float {
			return clip[v * 4 + 2] + clip[v * 4 + 3]
		}

		def triangle(a int, b int, c int) {
			let da = distance(a)
			let db = distance(b)
			let dc = distance(c)
			if da >= 0 && db >= 0 && dc >= 0 {
				prim.tris.push(a, b, c)
				return
			}
			return when da < 0 && db < 0 && dc < 0
			// Sutherland-Hodgman over the three edges: the kept polygon has
			// three or four corners, fanned into triangles.
			let poly int[]
			let corners = int[a, b, c]
			let dist = float[da, db, dc]
			for let k = 0; k < 3; k++ {
				let i = corners[k]
				let j = corners[(k + 1) % 3]
				let di = dist[k]
				let dj = dist[(k + 1) % 3]
				poly.push(i) when di >= 0
				poly.push(cut(i, j, di / (di - dj))) when (di >= 0) != (dj >= 0)
			}
			for let k = 1; k + 1 < poly.len(); k++ {
				prim.tris.push(poly[0], poly[k], poly[k + 1])
			}
		}

		def segment(a int, b int) {
			let da = distance(a)
			let db = distance(b)
			return when da < 0 && db < 0
			if da >= 0 && db >= 0 {
				prim.segments.push(a, b)
				return
			}
			let m = cut(a, b, da / (da - db))
			prim.segments.push(da >= 0 ?? (a, m), da >= 0 ?? (m, b))
		}

		// cut appends the vertex at fraction t from i towards j and returns
		// its index.
		def cut(i int, j int, t float) int {
			let v = prim.pos.len() / 3
			for let k = 0; k < 4; k++ {
				clip.push(clip[i * 4 + k] + (clip[j * 4 + k] - clip[i * 4 + k]) * t)
			}
			lerpInto(prim.pos, i, j, t, 3)
			lerpInto(prim.nrm, i, j, t, 3) when prim.nrm.len() > 0
			lerpInto(prim.tan, i, j, t, 4) when prim.tan.len() > 0
			for let (_, set) in prim.uv {
				lerpInto(set, i, j, t, 2) when set.len() > 0
			}
			lerpInto(prim.col, i, j, t, 4) when prim.col.len() > 0
			return v
		}

		def lerpInto(attr float32[], i int, j int, t float, width int) {
			for let k = 0; k < width; k++ {
				let a = float(attr[i * width + k])
				let b = float(attr[j * width + k])
				attr.push(float32(a + (b - a) * t))
			}
		}

		// project turns the clip coordinates into screen pixels (y down),
		// depth in 0..1 and 1/w.
		def project(look SceneView) {
			let count = clip.len() / 4
			prim.sx.len(count)
			prim.sy.len(count)
			prim.sz.len(count)
			prim.sw.len(count)
			let hw = float(look.width) * 0.5
			let hh = float(look.height) * 0.5
			for let v = 0; v < count; v++ {
				let w = clip[v * 4 + 3]
				w = 1.0e-9 when w.abs() < 1.0e-9
				let inv = 1.0 / w
				prim.sx[v] = float32((clip[v * 4] * inv + 1.0) * hw)
				prim.sy[v] = float32((1.0 - clip[v * 4 + 1] * inv) * hh)
				prim.sz[v] = float32(clip[v * 4 + 2] * inv * 0.5 + 0.5)
				prim.sw[v] = float32(inv)
			}
		}
	}
}
