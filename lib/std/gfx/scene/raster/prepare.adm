// The scene renderer: a model prepared once into world-space geometry
// (prepared.adm), turned into screen-space primitives for each picture
// (prepare.adm, project.adm), rasterised in row bands (raster.adm) and shaded
// per pixel (shade.adm); pick.adm finds the triangle a ray meets.
internal partial module std.gfx.scene.raster {
	use (
		std.formats.models::*
		std.math::(sqrt)
		std.math.geom::(Vec3)
	)

	// Depth of a pixel nothing has been drawn at.
	const sceneFarDepth = 3.0e38

	// SceneView is where the scene is seen from: the matrices, the eye and
	// the picture size in drawn pixels.
	type SceneView {
		look       matrix<float, 4, 4>
		projection matrix<float, 4, 4>
		viewProj   matrix<float, 4, 4>
		eye        Vec3
		// The direction the camera looks along, for an orthographic camera's
		// constant look vector.
		forward    Vec3
		ortho      bool
		width      int
		height     int

		def new(look matrix<float, 4, 4>, projection matrix<float, 4, 4>, eye Vec3, forward Vec3, ortho bool, width int, height int) {
			self.look = look
			self.projection = projection
			viewProj = projection * look
			self.eye = eye
			self.forward = forward
			self.ortho = ortho
			self.width = width
			self.height = height
		}
	}

	// SceneLight is a light placed in the world.
	type SceneLight {
		kind      LightKind
		position  Vec3
		// The direction the light shines along, unit length.
		direction Vec3
		// Linear colour times intensity.
		r         float
		g         float
		b         float
		range     float
		cosInner  float
		cosOuter  float

		def new(kind LightKind, position Vec3, direction Vec3, r float, g float, b float) {
			self.kind = kind
			self.position = position
			self.direction = direction
			self.r = r
			self.g = g
			self.b = b
		}
	}

	// ScenePrimitive is one drawn primitive with its vertices in screen space
	// and its attributes in world space, flat per vertex; the triangles,
	// segments, points and wireframe edges are index lists into them. The
	// attribute arrays and the lists are the prepared entry's own unless the
	// near plane cut the primitive, so drawing only reads them.
	type ScenePrimitive {
		material    ?Material
		doubleSided bool
		blend       bool
		// Screen x and y in pixels, depth in 0..1 and 1/w per vertex.
		sx          float32[]
		sy          float32[]
		sz          float32[]
		sw          float32[]
		// World position (3), normal (3), tangent (4), texture coordinate sets
		// (2 each) and colour (4) per vertex; empty when the mesh has none.
		pos         float32[]
		nrm         float32[]
		tan         float32[]
		uv          float32[][]
		col         float32[]
		tris        int[]
		segments    int[]
		points      int[]
		// The triangles' edges, each once, drawn over them as a wireframe.
		edges       int[]
		// The mean look depth, for drawing blended primitives from the back.
		depthKey    float

		def new() {
			sx = float32[]
			sy = float32[]
			sz = float32[]
			sw = float32[]
			pos = float32[]
			nrm = float32[]
			tan = float32[]
			uv = float32[][]
			col = float32[]
			tris = int[]
			segments = int[]
			points = int[]
			edges = int[]
		}
	}

	// lookAt is the look matrix of an eye looking at a point with `up`
	// towards the top of the picture; an up along the look takes another axis.
	def lookAt(eye Vec3, center Vec3, up Vec3) matrix<float, 4, 4> {
		let f = (center - eye).normalized()
		let top = up
		top = new Vec3(0, 0, -1) when f.cross(top).length() < 1e-6
		top = new Vec3(0, 1, 0) when f.cross(top).length() < 1e-6
		let r = f.cross(top).normalized()
		let u = r.cross(f)
		let m = matrix<float, 4, 4>[]
		m[0][0] = r.x
		m[0][1] = r.y
		m[0][2] = r.z
		m[0][3] = -r.dot(eye)
		m[1][0] = u.x
		m[1][1] = u.y
		m[1][2] = u.z
		m[1][3] = -u.dot(eye)
		m[2][0] = -f.x
		m[2][1] = -f.y
		m[2][2] = -f.z
		m[2][3] = f.dot(eye)
		m[3][3] = 1
		return m
	}

	// sceneLinear is an 8-bit sRGB channel as linear light.
	def sceneLinear(c uint8) float {
		let v = float(c) / 255.0
		return v / 12.92 when v <= 0.04045
		return ((v + 0.055) / 1.055) ** 2.4
	}

	// sceneIndex is the vertex the k-th drawn index names.
	def sceneIndex(p Primitive, k int) int {
		return int(p.indices[k]) when p.indices.len() > 0
		return k
	}

	// addScaled adds `scale` times a displacement array (`inWidth` values
	// per vertex) into an attribute of `outWidth` values per vertex.
	def addScaled(into float32[], delta float32[], scale float32, inWidth int, outWidth int) {
		let count = delta.len() / inWidth
		for let v = 0; v < count; v++ {
			for let k = 0; k < inWidth; k++ {
				let at = v * outWidth + k
				into[at] += delta[v * inWidth + k] * scale when at < into.len()
			}
		}
	}

	// rotateNormals takes `width`-strided direction vectors through the
	// inverse transpose of the matrix's 3×3 part and normalises them, so a
	// non-uniform scale keeps them perpendicular to the surface.
	def rotateNormals(attr float32[], m matrix<float, 4, 4>, width int) float32[] {
		let out = attr.clone()
		// The inverse transpose of the 3×3 part, by adjugate.
		let a = m[0][0]
		let b = m[0][1]
		let c = m[0][2]
		let d = m[1][0]
		let e = m[1][1]
		let f = m[1][2]
		let g = m[2][0]
		let h = m[2][1]
		let i = m[2][2]
		let det = a * (e * i - f * h) - b * (d * i - f * g) + c * (d * h - e * g)
		let n00 = e * i - f * h
		let n01 = f * g - d * i
		let n02 = d * h - e * g
		let n10 = c * h - b * i
		let n11 = a * i - c * g
		let n12 = b * g - a * h
		let n20 = b * f - c * e
		let n21 = c * d - a * f
		let n22 = a * e - b * d
		if det == 0 {
			n00 = a
			n01 = b
			n02 = c
			n10 = d
			n11 = e
			n12 = f
			n20 = g
			n21 = h
			n22 = i
		}
		for let k = 0; k + 2 < out.len(); k += width {
			let x = float(out[k])
			let y = float(out[k + 1])
			let z = float(out[k + 2])
			let rx = n00 * x + n01 * y + n02 * z
			let ry = n10 * x + n11 * y + n12 * z
			let rz = n20 * x + n21 * y + n22 * z
			let len = sqrt(rx * rx + ry * ry + rz * rz)
			continue when len == 0
			out[k] = float32(rx / len)
			out[k + 1] = float32(ry / len)
			out[k + 2] = float32(rz / len)
		}
		return out
	}

	// SceneClipper cuts triangles and segments against the near plane
	// (z + w >= 0 in clip space), appending the vertices the cuts make with
	// their attributes interpolated, and projects every vertex to the screen.
	type SceneClipper {
		prim  ScenePrimitive
		// Clip coordinates per vertex.
		cx    float32[]
		cy    float32[]
		cz    float32[]
		cw    float32[]
		// Whether the attributes are the primitive's own arrays; until a cut
		// appends to them they are the prepared entry's or the mesh's.
		owned bool

		def new(prim ScenePrimitive, cx float32[], cy float32[], cz float32[], cw float32[]) {
			self.prim = prim
			self.cx = cx
			self.cy = cy
			self.cz = cz
			self.cw = cw
		}

		def distance(v int) float {
			return float(cz[v]) + float(cw[v])
		}

		// triangles cuts the index triples into the primitive's triangles.
		def triangles(indices int[]) {
			for let t = 0; t + 2 < indices.len(); t += 3 {
				triangle(indices[t], indices[t + 1], indices[t + 2])
			}
		}

		def triangle(a int, b int, c int) {
			let da = distance(a)
			let db = distance(b)
			let dc = distance(c)
			if da >= 0 && db >= 0 && dc >= 0 {
				prim.tris.push(a, b, c)
				return
			}
			return when da < 0 && db < 0 && dc < 0
			// Sutherland-Hodgman over the three edges: the kept polygon has
			// three or four corners, fanned into triangles.
			let poly int[]
			let corners = int[a, b, c]
			let dist = float[da, db, dc]
			for let k = 0; k < 3; k++ {
				let i = corners[k]
				let j = corners[(k + 1) % 3]
				let di = dist[k]
				let dj = dist[(k + 1) % 3]
				poly.push(i) when di >= 0
				poly.push(cut(i, j, di / (di - dj))) when (di >= 0) != (dj >= 0)
			}
			for let k = 1; k + 1 < poly.len(); k++ {
				prim.tris.push(poly[0], poly[k], poly[k + 1])
			}
		}

		// segments cuts the index pairs into `into`.
		def segments(pairs int[], into int[]) {
			for let k = 0; k + 1 < pairs.len(); k += 2 {
				segment(pairs[k], pairs[k + 1], into)
			}
		}

		def segment(a int, b int, into int[]) {
			let da = distance(a)
			let db = distance(b)
			return when da < 0 && db < 0
			if da >= 0 && db >= 0 {
				into.push(a, b)
				return
			}
			let m = cut(a, b, da / (da - db))
			into.push(da >= 0 ?? (a, m), da >= 0 ?? (m, b))
		}

		// own gives the primitive its own copies of the attributes, once,
		// before the first vertex is appended to them.
		def own() {
			return when owned
			owned = true
			prim.pos = prim.pos.clone()
			prim.nrm = prim.nrm.clone()
			prim.tan = prim.tan.clone()
			prim.uv = prim.uv.clone()
			for let k = 0; k < prim.uv.len(); k++ {
				prim.uv[k] = prim.uv[k].clone()
			}
			prim.col = prim.col.clone()
		}

		// cut appends the vertex at fraction t from i towards j and returns
		// its index.
		def cut(i int, j int, t float) int {
			own()
			let v = cx.len()
			let f = float32(t)
			cx.push(cx[i] + (cx[j] - cx[i]) * f)
			cy.push(cy[i] + (cy[j] - cy[i]) * f)
			cz.push(cz[i] + (cz[j] - cz[i]) * f)
			cw.push(cw[i] + (cw[j] - cw[i]) * f)
			lerpInto(prim.pos, i, j, t, 3)
			lerpInto(prim.nrm, i, j, t, 3) when prim.nrm.len() > 0
			lerpInto(prim.tan, i, j, t, 4) when prim.tan.len() > 0
			for let (_, set) in prim.uv {
				lerpInto(set, i, j, t, 2) when set.len() > 0
			}
			lerpInto(prim.col, i, j, t, 4) when prim.col.len() > 0
			return v
		}

		def lerpInto(attr float32[], i int, j int, t float, width int) {
			for let k = 0; k < width; k++ {
				let a = float(attr[i * width + k])
				let b = float(attr[j * width + k])
				attr.push(float32(a + (b - a) * t))
			}
		}

		// project turns the clip coordinates into screen pixels (y down),
		// depth in 0..1 and 1/w.
		def project(look SceneView) {
			let count = cx.len()
			prim.sx.len(count)
			prim.sy.len(count)
			prim.sz.len(count)
			prim.sw.len(count)
			let hw = float(look.width) * 0.5
			let hh = float(look.height) * 0.5
			for let v = 0; v < count; v++ {
				let w = float(cw[v])
				w = 1.0e-9 when w.abs() < 1.0e-9
				let inv = 1.0 / w
				prim.sx[v] = float32((float(cx[v]) * inv + 1.0) * hw)
				prim.sy[v] = float32((1.0 - float(cy[v]) * inv) * hh)
				prim.sz[v] = float32(float(cz[v]) * inv * 0.5 + 0.5)
				prim.sw[v] = float32(inv)
			}
		}
	}
}
