internal partial module std.gfx.scene.raster {
	use (
		std.formats.models::*
		std.math::(cos)
		std.time
		std.math.geom::(Quaternion, Vec3)
	)

	// SceneGate lets the pictures and picks of a prepared model run beside
	// one another and keeps them apart from a change of the model: a reader
	// enters and leaves, a change closes the gate, which tells the readers
	// inside to give up and waits until they have left.
	type SceneGate {
		atomic readers int
		atomic closing bool

		// enter waits for a change under way to end, then counts the caller
		// in.
		def enter() {
			for {
				for closing {
					time.sleep(200us)
				}
				readers++
				return unless closing
				readers--
			}
		}

		def leave() {
			readers--
		}

		// close turns readers away and waits for those inside to leave.
		def close() {
			closing = true
			for readers > 0 {
				time.sleep(200us)
			}
		}

		def open() {
			closing = false
		}
	}

	// SceneStop tells the drawing tasks of one picture that it is no longer
	// wanted: the task that started them sets it once it is cancelled, and
	// a change of the model closes its gate.
	type SceneStop {
		atomic stopped bool
		gate           SceneGate

		def new(gate SceneGate) {
			self.gate = gate
		}

		// halted reports whether the picture should be given up.
		def halted() bool {
			return stopped || gate.closing
		}
	}

	// SceneGeometry is what one mesh primitive draws, as index lists over its
	// vertices: read from the primitive once and shared by every node that
	// shows it.
	type SceneGeometry {
		prim     Primitive
		count    int
		tris     int[]
		segments int[]
		points   int[]
		// The triangles' edges, each once; listed by `wire`.
		edges    int[]
		wired    bool
		// The same lists as 32-bit indices, as a GPU draws them.
		tris32   uint32[]
		lines32  uint32[]
		points32 uint32[]
		edges32  uint32[]

		def new(prim Primitive) {
			self.prim = prim
			count = prim.vertexCount()
			tris = int[]
			segments = int[]
			points = int[]
			edges = int[]
			// A triangle, segment or point naming a vertex the primitive does
			// not have is left out.
			let indices = prim.triangleIndices()
			for let t = 0; t + 2 < indices.len(); t += 3 {
				let a = int(indices[t])
				let b = int(indices[t + 1])
				let c = int(indices[t + 2])
				tris.push(a, b, c) when a < count && b < count && c < count
			}
			let n = prim.indexCount()
			switch prim.topology {
				case Topology.Lines:
					for let k = 0; k + 1 < n; k += 2 {
						segment(sceneIndex(prim, k), sceneIndex(prim, k + 1))
					}
				case Topology.LineStrip, Topology.LineLoop:
					for let k = 0; k + 1 < n; k++ {
						segment(sceneIndex(prim, k), sceneIndex(prim, k + 1))
					}
					segment(sceneIndex(prim, n - 1), sceneIndex(prim, 0)) when prim.topology == Topology.LineLoop && n > 2
				case Topology.Points:
					for let k = 0; k < n; k++ {
						let v = sceneIndex(prim, k)
						points.push(v) when v < count
					}
				default:
			}
			tris32 = narrowed(tris)
			lines32 = narrowed(segments)
			points32 = narrowed(points)
		}

		def segment(a int, b int) {
			segments.push(a, b) when a < count && b < count
		}

		// narrowed is an index list as 32-bit indices.
		def narrowed(list int[]) uint32[] {
			let out uint32[]
			out.len(list.len())
			for let (i, v) in list {
				out[i] = uint32(v)
			}
			return out
		}

		// wire lists the triangles' edges, an edge two triangles share once.
		def wire() {
			return when wired
			wired = true
			let keys int[]
			keys.len(tris.len())
			for let t = 0; t + 2 < tris.len(); t += 3 {
				keys[t] = edgeKey(tris[t], tris[t + 1])
				keys[t + 1] = edgeKey(tris[t + 1], tris[t + 2])
				keys[t + 2] = edgeKey(tris[t + 2], tris[t])
			}
			keys.sort((a int, b int) => a < b)
			let last = -1
			for let (_, key) in keys {
				continue when key == last
				last = key
				edges.push(key / count, key % count)
			}
			edges32 = narrowed(edges)
		}

		def edgeKey(a int, b int) int {
			return a.min(b) * count + a.max(b)
		}
	}

	// SceneEntry is one primitive placed by one node: its vertices in world
	// coordinates at the prepared pose, morphed and skinned as the node says.
	type SceneEntry {
		geom        SceneGeometry
		// The node's place in the prepared node list.
		node        int
		skin        ?Skin
		// The prepared places of the skin's joints, -1 for a joint outside
		// the model's tree.
		joints      int[]
		material    ?Material
		doubleSided bool
		blend       bool
		// World position per vertex, interleaved for shading and one array
		// per axis for the projection.
		pos         float32[]
		wx          float32[]
		wy          float32[]
		wz          float32[]
		// World normal (3) and tangent (4) per vertex; empty when the mesh
		// has none.
		nrm         float32[]
		tan         float32[]
		// The box around the vertices: least corner, then greatest.
		box         float[]
		// The triangles in a tree for `pick`, built when first asked for and
		// dropped when the vertices move.
		tree        ?SceneTree
		// A number no earlier placing of this entry had: a renderer that
		// keeps the vertices knows by it that they moved.
		stamp       uint64

		def new(geom SceneGeometry, node int, skin ?Skin) {
			self.geom = geom
			self.node = node
			self.skin = skin
			joints = int[]
			let m = geom.prim.material
			material = m
			if !(m is none) {
				doubleSided = m.doubleSided
				blend = m.alphaMode == AlphaMode.Blend
			}
			pos = float32[]
			wx = float32[]
			wy = float32[]
			wz = float32[]
			nrm = float32[]
			tan = float32[]
			box = float[0, 0, 0, 0, 0, 0]
		}

		// triangles is the entry's triangles as a tree, built on first use.
		def triangles() SceneTree {
			let built = tree
			return built unless built is none
			let made = new SceneTree(pos, geom.tris)
			tree = made
			return made
		}

		// skinned reports whether the entry's vertices follow joints.
		def skinned() bool {
			let p = geom.prim
			return joints.len() > 0 && p.joints.len() == geom.count * 4 && p.weights.len() == geom.count * 4
		}

		// place puts the vertices where the node's world matrix, its morph
		// weights and the joints' matrices (each joint's world matrix times
		// its inverse bind matrix) take them.
		def place(world matrix<float, 4, 4>, weights float[], jointMatrices matrix<float, 4, 4>[], stamp uint64) {
			self.stamp = stamp
			let p = geom.prim
			let count = geom.count
			let positions = p.positions
			let normals = p.normals
			let tangents = p.tangents
			// Morph targets: the node's weights over the targets' displacements.
			if p.targets.len() > 0 && weights.len() > 0 {
				positions = positions.clone()
				normals = normals.clone() when normals.len() > 0
				tangents = tangents.clone() when tangents.len() > 0
				for let (t, target) in p.targets {
					continue when t >= weights.len()
					let w = float32(weights[t])
					continue when w == 0
					addScaled(positions, target.positions, w, 3, 3)
					addScaled(normals, target.normals, w, 3, 3) when normals.len() > 0
					addScaled(tangents, target.tangents, w, 3, 4) when tangents.len() > 0
				}
			}
			let m = world
			// Skinning: each vertex moved by its four joints' matrices, blended
			// by its weights. The joints' matrices are in world coordinates, so
			// a skinned vertex takes no node transform after them.
			if skinned() && jointMatrices.len() > 0 {
				let moved float32[]
				moved.len(count * 3)
				let movedNormals float32[]
				movedNormals.len(normals.len())
				let hasNormals = normals.len() == count * 3
				for let v = 0; v < count; v++ {
					let px = float(positions[v * 3])
					let py = float(positions[v * 3 + 1])
					let pz = float(positions[v * 3 + 2])
					let nx = 0.0
					let ny = 0.0
					let nz = 0.0
					if hasNormals {
						nx = float(normals[v * 3])
						ny = float(normals[v * 3 + 1])
						nz = float(normals[v * 3 + 2])
					}
					let ox = 0.0
					let oy = 0.0
					let oz = 0.0
					let qx = 0.0
					let qy = 0.0
					let qz = 0.0
					for let k = 0; k < 4; k++ {
						let w = float(p.weights[v * 4 + k])
						continue when w == 0
						let j = int(p.joints[v * 4 + k])
						continue when j >= jointMatrices.len()
						let jm = jointMatrices[j]
						ox += w * (jm[0][0] * px + jm[0][1] * py + jm[0][2] * pz + jm[0][3])
						oy += w * (jm[1][0] * px + jm[1][1] * py + jm[1][2] * pz + jm[1][3])
						oz += w * (jm[2][0] * px + jm[2][1] * py + jm[2][2] * pz + jm[2][3])
						qx += w * (jm[0][0] * nx + jm[0][1] * ny + jm[0][2] * nz)
						qy += w * (jm[1][0] * nx + jm[1][1] * ny + jm[1][2] * nz)
						qz += w * (jm[2][0] * nx + jm[2][1] * ny + jm[2][2] * nz)
					}
					moved[v * 3] = float32(ox)
					moved[v * 3 + 1] = float32(oy)
					moved[v * 3 + 2] = float32(oz)
					if hasNormals {
						movedNormals[v * 3] = float32(qx)
						movedNormals[v * 3 + 1] = float32(qy)
						movedNormals[v * 3 + 2] = float32(qz)
					}
				}
				positions = moved
				normals = movedNormals when hasNormals
				m = sceneIdentity()
			}
			pos.len(count * 3) when pos.len() != count * 3
			wx.len(count) when wx.len() != count
			wy.len(count) when wy.len() != count
			wz.len(count) when wz.len() != count
			let m00 = m[0][0]
			let m01 = m[0][1]
			let m02 = m[0][2]
			let m03 = m[0][3]
			let m10 = m[1][0]
			let m11 = m[1][1]
			let m12 = m[1][2]
			let m13 = m[1][3]
			let m20 = m[2][0]
			let m21 = m[2][1]
			let m22 = m[2][2]
			let m23 = m[2][3]
			let lx = 3.0e38
			let ly = 3.0e38
			let lz = 3.0e38
			let hx = -3.0e38
			let hy = -3.0e38
			let hz = -3.0e38
			for let v = 0; v < count; v++ {
				let x = float(positions[v * 3])
				let y = float(positions[v * 3 + 1])
				let z = float(positions[v * 3 + 2])
				let ax = m00 * x + m01 * y + m02 * z + m03
				let ay = m10 * x + m11 * y + m12 * z + m13
				let az = m20 * x + m21 * y + m22 * z + m23
				pos[v * 3] = float32(ax)
				pos[v * 3 + 1] = float32(ay)
				pos[v * 3 + 2] = float32(az)
				wx[v] = float32(ax)
				wy[v] = float32(ay)
				wz[v] = float32(az)
				lx = lx.min(ax)
				ly = ly.min(ay)
				lz = lz.min(az)
				hx = hx.max(ax)
				hy = hy.max(ay)
				hz = hz.max(az)
			}
			box[0] = lx
			box[1] = ly
			box[2] = lz
			box[3] = hx
			box[4] = hy
			box[5] = hz
			nrm = normals.len() == count * 3 ?? (rotateNormals(normals, m, 3), float32[])
			tan = tangents.len() == count * 4 ?? (rotateNormals(tangents, m, 4), float32[])
			tree = none
		}
	}

	// ScenePoseTrack is, for one animation, the prepared place of each of
	// its channels' target nodes (-1 for a node outside the model's tree).
	type ScenePoseTrack {
		animation Animation
		targets   int[]

		def new(animation Animation, targets int[]) {
			self.animation = animation
			self.targets = targets
		}
	}

	// ScenePrepared is a model made ready to draw: its nodes in tree order
	// with the pose they are drawn at, every placed primitive in world
	// coordinates, and its textures decoded. Nothing here writes to the
	// model. Drawing and picking only read it; `pose`, `hide` and `wire`
	// change it and need it to themselves.
	type ScenePrepared {
		model    Model
		// The nodes in tree order, parents first, and each one's parent's
		// place (-1 for a root).
		nodes    Node[]
		parents  int[]
		// The pose: each node's world matrix and morph weights.
		world    matrix<float, 4, 4>[]
		weights  float[][]
		// Nodes left out of pictures and picks, with everything below them.
		hidden   bool[]
		// Whether the node or one above it is hidden.
		unseen   bool[]
		entries  SceneEntry[]
		textures SceneTextures
		tracks   ScenePoseTrack[]
		// The box around every entry at the pose: least corner, greatest;
		// `bounded` is false when nothing has a vertex.
		box      float[]
		bounded  bool
		// Whether the entries have been placed once.
		placed   bool
		// Counts the poses, for the entries' stamps.
		poses    uint64
		// The direction the model calls up.
		up       Vec3
		// A node off the tree, for turning a translation, rotation and scale
		// into a matrix the way Node does.
		scratch  Node

		def new(model Model) {
			self.model = model
			nodes = Node[]
			parents = int[]
			weights = float[][]
			hidden = bool[]
			unseen = bool[]
			entries = SceneEntry[]
			tracks = ScenePoseTrack[]
			box = float[0, 0, 0, 0, 0, 0]
			scratch = new Node()
			up = new Vec3(0, 1, 0)
			up = new Vec3(1, 0, 0) when model.upAxis == Axis.X
			up = new Vec3(0, 0, 1) when model.upAxis == Axis.Z
			textures = new SceneTextures(model)
			for let (_, root) in model.nodes {
				list(root, -1)
			}
			let shown = Primitive[]
			let geoms = SceneGeometry[]
			for let (i, n) in nodes {
				let mesh = n.mesh
				continue when mesh is none
				for let (_, p) in mesh.primitives {
					continue when p.vertexCount() == 0
					// Two nodes showing one primitive share its geometry.
					let at = -1
					for let (k, known) in shown {
						continue when known != p
						at = k
						break
					}
					if at < 0 {
						at = shown.len()
						shown.push(p)
						geoms.push(new SceneGeometry(p))
					}
					let entry = new SceneEntry(geoms[at], i, n.skin)
					let skin = n.skin
					if !(skin is none) {
						for let (_, joint) in skin.joints {
							entry.joints.push(indexOf(joint))
						}
					}
					entries.push(entry)
				}
			}
			pose(none, 0.0)
		}

		// list appends the node and those below it, parents first.
		def list(node Node, parent int) {
			let at = nodes.len()
			nodes.push(node)
			parents.push(parent)
			world.push(sceneIdentity())
			weights.push(float[])
			hidden.push(false)
			unseen.push(false)
			for let (_, child) in node.children {
				list(child, at)
			}
		}

		// indexOf is the node's place in `nodes`, -1 when it is not in the
		// model's tree.
		def indexOf(node Node) int {
			for let (i, n) in nodes {
				return i when n == node
			}
			return -1
		}

		// track is the animation's channel targets as prepared places, found
		// once per animation.
		def track(animation Animation) int[] {
			for let (_, t) in tracks {
				return t.targets when t.animation == animation
			}
			let targets int[]
			for let (_, c) in animation.channels {
				targets.push(indexOf(c.target))
			}
			tracks.push(new ScenePoseTrack(animation, targets))
			return targets
		}

		// pose places every node as the model has it, with the animation's
		// channels at the time in place of the properties they key, and moves
		// the entries whose node, weights or joints that changed.
		def pose(animation ?Animation, time float) {
			let count = nodes.len()
			let translation Vec3[]
			let rotation Quaternion[]
			let scale Vec3[]
			let morph float[][]
			for let (_, n) in nodes {
				translation.push(n.translation)
				rotation.push(n.rotation)
				scale.push(n.scale)
				morph.push(n.weights)
			}
			if !(animation is none) {
				let targets = track(animation)
				let v float32[]
				for let (k, c) in animation.channels {
					let at = targets[k]
					continue when at < 0
					let n = c.valueCount()
					continue when n == 0
					c.sample(time, v)
					switch c.path {
						case AnimationPath.Translation:
							translation[at] = new Vec3(float(v[0]), float(v[1]), float(v[2])) when n >= 3
						case AnimationPath.Scale:
							scale[at] = new Vec3(float(v[0]), float(v[1]), float(v[2])) when n >= 3
						case AnimationPath.Rotation:
							rotation[at] = new Quaternion(float(v[0]), float(v[1]), float(v[2]), float(v[3])) when n >= 4
						default:
							let w float[]
							w.len(n)
							for let i = 0; i < n; i++ {
								w[i] = float(v[i])
							}
							morph[at] = w
					}
				}
			}
			poses++
			let moved bool[]
			moved.len(count)
			for let i = 0; i < count; i++ {
				scratch.translation = translation[i]
				scratch.rotation = rotation[i]
				scratch.scale = scale[i]
				let m = scratch.transform
				m = world[parents[i]] * m when parents[i] >= 0
				moved[i] = !placed || !m.equals(world[i]) || !sameWeights(morph[i], weights[i])
				world[i] = m
				weights[i] = morph[i]
			}
			for let (_, e) in entries {
				let changed = moved[e.node]
				for let (_, j) in e.joints {
					changed = true when j >= 0 && moved[j]
				}
				continue unless changed
				let jointMatrices matrix<float, 4, 4>[]
				let skin = e.skin
				if !(skin is none) {
					for let (k, j) in e.joints {
						let m = j >= 0 ?? (world[j], sceneIdentity())
						m = m * skin.inverseBindMatrices[k] when k < skin.inverseBindMatrices.len()
						jointMatrices.push(m)
					}
				}
				e.place(world[e.node], weights[e.node], jointMatrices, poses)
			}
			placed = true
			measure()
		}

		def sameWeights(a float[], b float[]) bool {
			return false when a.len() != b.len()
			for let (i, w) in a {
				return false when w != b[i]
			}
			return true
		}

		// measure takes the box around the entries that are not hidden.
		def measure() {
			bounded = false
			for let (_, e) in entries {
				continue when unseen[e.node] || e.geom.count == 0
				if !bounded {
					bounded = true
					e.box.copy(box)
					continue
				}
				for let k = 0; k < 3; k++ {
					box[k] = box[k].min(e.box[k])
					box[k + 3] = box[k + 3].max(e.box[k + 3])
				}
			}
		}

		// hide leaves the node at the place, and everything below it, out of
		// pictures and picks, or brings it back.
		def hide(at int, off bool) {
			hidden[at] = off
			for let i = 0; i < nodes.len(); i++ {
				unseen[i] = hidden[i] || (parents[i] >= 0 && unseen[parents[i]])
			}
			measure()
		}

		// wire lists every geometry's edges, for a wireframe.
		def wire() {
			for let (_, e) in entries {
				e.geom.wire()
			}
		}

		// lights places the model's lights by the nodes that hold them at the
		// pose; a model with none gets one white light from above the
		// camera's shoulder, above being the model's up.
		def lights(look SceneView) SceneLight[] {
			let out SceneLight[]
			for let (i, n) in nodes {
				let light = n.light
				continue when light is none
				continue when unseen[i]
				let m = world[i]
				let position = new Vec3(m[0][3], m[1][3], m[2][3])
				// The light shines along the node's negative z.
				let direction = new Vec3(-m[0][2], -m[1][2], -m[2][2]).normalized()
				let c = light.color
				let k = light.intensity
				let l = new SceneLight(light.kind, position, direction, sceneLinear(c.red) * k, sceneLinear(c.green) * k, sceneLinear(c.blue) * k)
				l.range = light.range
				l.cosInner = cos(light.innerCone)
				l.cosOuter = cos(light.outerCone)
				out.push(l)
			}
			if out.len() == 0 {
				let dir = look.forward
				let side = dir.cross(up)
				side = new Vec3(1, 0, 0) when side.length() < 1e-6
				let shine = (dir * 0.8 - up * 0.5 + side.normalized() * 0.3).normalized()
				out.push(new SceneLight(LightKind.Directional, look.eye, shine, 3.0, 3.0, 3.0))
			}
			return out
		}
	}

	// sceneIdentity is a new 4×4 identity matrix.
	def sceneIdentity() matrix<float, 4, 4> {
		let m = matrix<float, 4, 4>[]
		for let k = 0; k < 4; k++ {
			m[k][k] = 1
		}
		return m
	}
}
