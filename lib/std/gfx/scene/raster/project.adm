internal partial module std.gfx.scene.raster {
	use (
		std.formats.models::*
		std.gfx.bands
		std.gfx.color::(Color)
		std.simd
	)

	// ScenePicture is what one picture asks for beyond the prepared scene.
	type ScenePicture {
		background Color
		// Whether the triangles are drawn, and whether their edges are drawn
		// over them in `wireColor`.
		fill       bool      = true
		wire       bool
		wireColor  Color
		// Lines drawn with the scene and hidden by what is in front of them:
		// per line its two ends in world coordinates (6 values) and their
		// colours as linear red, green, blue and alpha (8 values).
		linePos    float32[]
		lineCol    float32[]

		def new(background Color, wireColor Color) {
			self.background = background
			self.wireColor = wireColor
			linePos = float32[]
			lineCol = float32[]
		}
	}

	// sceneDraw draws the prepared scene as seen through the view into a new
	// target. None when the task was cancelled, or the gate closed for a change of the
	// model, before the picture was whole.
	def sceneDraw(scene ScenePrepared, look SceneView, picture ScenePicture, gate SceneGate) ?SceneTarget {
		let stop = new SceneStop(gate)
		let lights = scene.lights(look)
		let prims ScenePrimitive[]
		for let (_, e) in scene.entries {
			continue when scene.unseen[e.node]
			return none when canceled() || stop.halted()
			let p = projectEntry(e, look, picture.fill, picture.wire)
			continue when p is none
			prims.push(p)
		}
		prims.push(projectLines(picture.linePos, picture.lineCol, look)) when picture.linePos.len() >= 6
		let target = new SceneTarget(look.width, look.height, picture.background)
		let shader = new SceneShader(look, lights, scene.textures)
		shader.edgeColor(picture.wireColor)
		drawPrimitives(target, prims, shader, false, stop)
		let blended ScenePrimitive[]
		for let (_, p) in prims {
			blended.push(p) when p.blend
		}
		blended.sort((a ScenePrimitive, b ScenePrimitive) => a.depthKey > b.depthKey)
		drawPrimitives(target, blended, shader, true, stop)
		return none when stop.halted()
		return target
	}

	// projectEntry takes a prepared entry to the screen: its vertices through
	// the view and projection, its triangles, segments and edges cut at the
	// near plane when the entry reaches behind it. None when the entry's box
	// lies wholly outside the view.
	def projectEntry(e SceneEntry, look SceneView, fill bool, wire bool) ?ScenePrimitive {
		let vp = look.viewProj
		let behind = sceneBoxBehind(e.box, vp)
		return none when behind < 0
		let geom = e.geom
		let count = geom.count
		let out = new ScenePrimitive()
		out.material = e.material
		out.doubleSided = e.doubleSided
		out.blend = e.blend
		out.pos = e.pos
		out.nrm = e.nrm
		out.tan = e.tan
		for let (_, set) in geom.prim.uvs {
			out.uv.push(set.len() == count * 2 ?? (set, float32[]))
		}
		let colors = geom.prim.colors
		out.col = colors[0] when colors.len() > 0 && colors[0].len() == count * 4
		let m float32[]
		m.len(16)
		for let r = 0; r < 4; r++ {
			for let c = 0; c < 4; c++ {
				m[r * 4 + c] = float32(vp[r][c])
			}
		}
		let cx float32[]
		let cy float32[]
		let cz float32[]
		let cw float32[]
		cx.len(count)
		cy.len(count)
		cz.len(count)
		cw.len(count)
		bands.forBands(count, count, (from int, to int) => {
			sceneClip(e.wx, e.wy, e.wz, m, cx, cy, cz, cw, from, to)
		})
		if out.blend {
			// The mean look depth, for drawing blended primitives from the back.
			let depth = 0.0
			for let v = 0; v < count; v++ {
				depth += float(cw[v])
			}
			out.depthKey = depth / float(count)
		}
		if behind == 0 {
			out.tris = geom.tris when fill
			out.segments = geom.segments
			out.points = geom.points
			out.edges = geom.edges when wire
			out.sx.len(count)
			out.sy.len(count)
			out.sz.len(count)
			out.sw.len(count)
			let hw = float32(float(look.width) * 0.5)
			let hh = float32(float(look.height) * 0.5)
			bands.forBands(count, count, (from int, to int) => {
				sceneScreen(cx, cy, cz, cw, out.sx, out.sy, out.sz, out.sw, hw, hh, from, to)
			})
			return out
		}
		let clipper = new SceneClipper(out, cx, cy, cz, cw)
		clipper.triangles(geom.tris) when fill
		clipper.segments(geom.segments, out.segments)
		for let (_, v) in geom.points {
			out.points.push(v) when clipper.distance(v) >= 0
		}
		clipper.segments(geom.edges, out.edges) when wire
		clipper.project(look)
		return out
	}

	// sceneBoxBehind is how many of the box's corners lie behind the near
	// plane of the view, or -1 when the whole box is outside the view: a
	// plane of the view that has all eight corners outside it has the box
	// outside. No corner behind the near plane means no point of the box
	// is, and nothing in it needs cutting.
	def sceneBoxBehind(box float[], vp matrix<float, 4, 4>) int {
		let left = 0
		let right = 0
		let below = 0
		let above = 0
		let beyond = 0
		let behind = 0
		for let c = 0; c < 8; c++ {
			let x = box[c % 2 == 0 ?? (0, 3)]
			let y = box[(c / 2) % 2 == 0 ?? (1, 4)]
			let z = box[c / 4 == 0 ?? (2, 5)]
			let cx = vp[0][0] * x + vp[0][1] * y + vp[0][2] * z + vp[0][3]
			let cy = vp[1][0] * x + vp[1][1] * y + vp[1][2] * z + vp[1][3]
			let cz = vp[2][0] * x + vp[2][1] * y + vp[2][2] * z + vp[2][3]
			let cw = vp[3][0] * x + vp[3][1] * y + vp[3][2] * z + vp[3][3]
			left++ when cx < -cw
			right++ when cx > cw
			below++ when cy < -cw
			above++ when cy > cw
			beyond++ when cz > cw
			behind++ when cz < -cw
		}
		return -1 when left == 8 || right == 8 || below == 8 || above == 8 || beyond == 8 || behind == 8
		return behind
	}

	// projectLines takes the picture's own lines to the screen as one
	// primitive of segments, coloured per end.
	def projectLines(linePos float32[], lineCol float32[], look SceneView) ScenePrimitive {
		let vp = look.viewProj
		let count = linePos.len() / 3
		let out = new ScenePrimitive()
		out.pos = linePos
		out.col = lineCol when lineCol.len() == count * 4
		let cx float32[]
		let cy float32[]
		let cz float32[]
		let cw float32[]
		cx.len(count)
		cy.len(count)
		cz.len(count)
		cw.len(count)
		for let v = 0; v < count; v++ {
			let x = float(linePos[v * 3])
			let y = float(linePos[v * 3 + 1])
			let z = float(linePos[v * 3 + 2])
			cx[v] = float32(vp[0][0] * x + vp[0][1] * y + vp[0][2] * z + vp[0][3])
			cy[v] = float32(vp[1][0] * x + vp[1][1] * y + vp[1][2] * z + vp[1][3])
			cz[v] = float32(vp[2][0] * x + vp[2][1] * y + vp[2][2] * z + vp[2][3])
			cw[v] = float32(vp[3][0] * x + vp[3][1] * y + vp[3][2] * z + vp[3][3])
		}
		let clipper = new SceneClipper(out, cx, cy, cz, cw)
		for let v = 0; v + 1 < count; v += 2 {
			clipper.segment(v, v + 1, out.segments)
		}
		clipper.project(look)
		return out
	}

	// sceneClip takes world positions `from` to `to` through the 4×4 matrix
	// `m` (row-major) into clip coordinates, eight vertices a vector.
	def sceneClip(wx float32[], wy float32[], wz float32[], m float32[], cx float32[], cy float32[], cz float32[], cw float32[], from int, to int) {
		let m00 = simd.splat8<float32>(m[0])
		let m01 = simd.splat8<float32>(m[1])
		let m02 = simd.splat8<float32>(m[2])
		let m03 = simd.splat8<float32>(m[3])
		let m10 = simd.splat8<float32>(m[4])
		let m11 = simd.splat8<float32>(m[5])
		let m12 = simd.splat8<float32>(m[6])
		let m13 = simd.splat8<float32>(m[7])
		let m20 = simd.splat8<float32>(m[8])
		let m21 = simd.splat8<float32>(m[9])
		let m22 = simd.splat8<float32>(m[10])
		let m23 = simd.splat8<float32>(m[11])
		let m30 = simd.splat8<float32>(m[12])
		let m31 = simd.splat8<float32>(m[13])
		let m32 = simd.splat8<float32>(m[14])
		let m33 = simd.splat8<float32>(m[15])
		let i = from
		for i + 8 <= to {
			let x = simd.load8<float32>(wx, i)
			let y = simd.load8<float32>(wy, i)
			let z = simd.load8<float32>(wz, i)
			simd.store8(cx, i, m00 * x + m01 * y + m02 * z + m03)
			simd.store8(cy, i, m10 * x + m11 * y + m12 * z + m13)
			simd.store8(cz, i, m20 * x + m21 * y + m22 * z + m23)
			simd.store8(cw, i, m30 * x + m31 * y + m32 * z + m33)
			i += 8
		}
		for i < to {
			let x = wx[i]
			let y = wy[i]
			let z = wz[i]
			cx[i] = m[0] * x + m[1] * y + m[2] * z + m[3]
			cy[i] = m[4] * x + m[5] * y + m[6] * z + m[7]
			cz[i] = m[8] * x + m[9] * y + m[10] * z + m[11]
			cw[i] = m[12] * x + m[13] * y + m[14] * z + m[15]
			i++
		}
	}

	// sceneScreen turns clip coordinates `from` to `to`, all in front of the
	// near plane (w above zero), into screen pixels (y down), depth in 0..1
	// and 1/w, eight vertices a vector.
	def sceneScreen(cx float32[], cy float32[], cz float32[], cw float32[], sx float32[], sy float32[], sz float32[], sw float32[], hw float32, hh float32, from int, to int) {
		let one = simd.splat8<float32>(float32(1))
		let half = simd.splat8<float32>(float32(0.5))
		let vhw = simd.splat8<float32>(hw)
		let vhh = simd.splat8<float32>(hh)
		let i = from
		for i + 8 <= to {
			let inv = one / simd.load8<float32>(cw, i)
			simd.store8(sx, i, (simd.load8<float32>(cx, i) * inv + one) * vhw)
			simd.store8(sy, i, (one - simd.load8<float32>(cy, i) * inv) * vhh)
			simd.store8(sz, i, simd.load8<float32>(cz, i) * inv * half + half)
			simd.store8(sw, i, inv)
			i += 8
		}
		for i < to {
			let inv = float32(1) / cw[i]
			sx[i] = (cx[i] * inv + float32(1)) * hw
			sy[i] = (float32(1) - cy[i] * inv) * hh
			sz[i] = cz[i] * inv * float32(0.5) + float32(0.5)
			sw[i] = inv
			i++
		}
	}
}
