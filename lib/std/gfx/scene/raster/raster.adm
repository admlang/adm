internal partial module std.gfx.scene.raster {
	use (
		std.formats.image::(Image)
		std.formats.models::*
		std.gfx.bands
		std.gfx.color::(Color)
		std.simd
	)

	// SceneTarget is the picture being drawn: straight-alpha RGBA8 pixels
	// and a depth per pixel.
	type SceneTarget {
		width  int
		height int
		pixels byte[]
		depth  float32[]
		// Linear-light background, premultiplied by its alpha, and the alpha.
		bgR    float
		bgG    float
		bgB    float
		bgA    float

		def new(width int, height int, background Color) {
			self.width = width
			self.height = height
			pixels.len(width * height * 4)
			depth.len(width * height + 8)
			depth.fill(float32(sceneFarDepth))
			bgA = float(background.alpha) / 255.0
			bgR = sceneLinear(background.red) * bgA
			bgG = sceneLinear(background.green) * bgA
			bgB = sceneLinear(background.blue) * bgA
			let r = background.red
			let g = background.green
			let b = background.blue
			let a = background.alpha
			for let i = 0; i < pixels.len(); i += 4 {
				pixels[i] = r
				pixels[i + 1] = g
				pixels[i + 2] = b
				pixels[i + 3] = a
			}
		}

		// image is the drawn picture, `samples` × `samples` drawn pixels
		// averaged into each output pixel.
		def image(samples int) Image {
			let w = width / samples
			let h = height / samples
			let img = new Image(w, h)
			let out = img.raw()
			let stride = img.stride()
			if samples == 1 {
				pixels.copy(out)
				return img
			}
			let n = float(samples * samples)
			bands.forRows(w, h, (from int, to int) => {
				for let y = from; y < to; y++ {
					for let x = 0; x < w; x++ {
						// Average in premultiplied form so a transparent background
						// does not darken edges.
						let r = 0.0
						let g = 0.0
						let b = 0.0
						let a = 0.0
						for let sy = 0; sy < samples; sy++ {
							let row = (y * samples + sy) * width * 4
							for let sx = 0; sx < samples; sx++ {
								let at = row + (x * samples + sx) * 4
								let pa = float(pixels[at + 3])
								r += float(pixels[at]) * pa
								g += float(pixels[at + 1]) * pa
								b += float(pixels[at + 2]) * pa
								a += pa
							}
						}
						let o = y * stride + x * 4
						if a > 0 {
							out[o] = uint8((r / a).round())
							out[o + 1] = uint8((g / a).round())
							out[o + 2] = uint8((b / a).round())
						}
						out[o + 3] = uint8((a / n).round())
					}
				}
			})
			return img
		}
	}

	// drawPrimitives rasterises the primitives into the target in row bands
	// on tasks, each band owning its rows: the solid pass writes depth, the
	// blend pass tests it and composites over what is there.
	def drawPrimitives(target SceneTarget, prims ScenePrimitive[], shader SceneShader, blendPass bool) {
		return when prims.len() == 0
		bands.forRows(target.width, target.height, (from int, to int) => {
			let pixel = new ScenePixel()
			for let (_, p) in prims {
				continue when p.blend != blendPass
				drawTriangles(target, p, shader, pixel, from, to, blendPass)
				drawSegments(target, p, shader, pixel, from, to, blendPass)
				drawPoints(target, p, shader, pixel, from, to, blendPass)
			}
		})
	}

	// Lane offsets 0..7, for the eight pixel centres a vector covers.
	def laneOffsets() vec8<float32> {
		let lanes = float32[0, 1, 2, 3, 4, 5, 6, 7]
		return simd.load8<float32>(lanes, 0)
	}

	// drawTriangles rasterises the primitive's triangles within rows
	// `from` to `to`: edge functions eight pixels a vector, the depth test
	// on the vector, the covered pixels shaded one by one.
	def drawTriangles(target SceneTarget, p ScenePrimitive, shader SceneShader, pixel ScenePixel, from int, to int, blendPass bool) {
		let w = target.width
		let lanes = laneOffsets()
		for let t = 0; t + 2 < p.tris.len(); t += 3 {
			let a = p.tris[t]
			let b = p.tris[t + 1]
			let c = p.tris[t + 2]
			let x0 = float(p.sx[a])
			let y0 = float(p.sy[a])
			let x1 = float(p.sx[b])
			let y1 = float(p.sy[b])
			let x2 = float(p.sx[c])
			let y2 = float(p.sy[c])
			// Twice the signed area; counter-clockwise in NDC is clockwise with
			// y down, so a front face is negative here.
			let area = (x1 - x0) * (y2 - y0) - (x2 - x0) * (y1 - y0)
			continue when area.abs() < 1.0e-12
			let front = area < 0
			continue when !front && !p.doubleSided
			// Texture area per screen area, per coordinate set, for the mipmap level.
			pixel.density.len(p.uv.len()) when pixel.density.len() != p.uv.len()
			for let (k, set) in p.uv {
				pixel.density[k] = 0
				continue when set.len() == 0
				let du1 = float(set[b * 2] - set[a * 2])
				let dv1 = float(set[b * 2 + 1] - set[a * 2 + 1])
				let du2 = float(set[c * 2] - set[a * 2])
				let dv2 = float(set[c * 2 + 1] - set[a * 2 + 1])
				pixel.density[k] = (du1 * dv2 - du2 * dv1).abs() / area.abs()
			}
			let minY = int(y0.min(y1).min(y2).floor()).max(from)
			let maxY = int(y0.max(y1).max(y2).ceil()).min(to - 1)
			continue when minY > maxY
			let minX = int(x0.min(x1).min(x2).floor()).max(0)
			let maxX = int(x0.max(x1).max(x2).ceil()).min(w - 1)
			continue when minX > maxX
			// Barycentric l0 at p: edge b->c, l1: edge c->a, l2: edge a->b,
			// each as A·x + B·y + C over the area.
			let inv = 1.0 / area
			let a0 = -(y2 - y1) * inv
			let b0 = (x2 - x1) * inv
			let c0 = ((y2 - y1) * x1 - (x2 - x1) * y1) * inv
			let a1 = -(y0 - y2) * inv
			let b1 = (x0 - x2) * inv
			let c1 = ((y0 - y2) * x2 - (x0 - x2) * y2) * inv
			let a2 = -(y1 - y0) * inv
			let b2 = (x1 - x0) * inv
			let c2 = ((y1 - y0) * x0 - (x1 - x0) * y0) * inv
			let z0 = float(p.sz[a])
			let z1 = float(p.sz[b])
			let z2 = float(p.sz[c])
			let w0 = float(p.sw[a])
			let w1 = float(p.sw[b])
			let w2 = float(p.sw[c])
			let va0 = simd.splat8<float32>(float32(a0))
			let va1 = simd.splat8<float32>(float32(a1))
			let va2 = simd.splat8<float32>(float32(a2))
			let vz0 = simd.splat8<float32>(float32(z0))
			let vz1 = simd.splat8<float32>(float32(z1))
			let vz2 = simd.splat8<float32>(float32(z2))
			let zero = simd.splat8<float32>(float32(0))
			let one = simd.splat8<float32>(float32(1))
			// A small tolerance so shared edges are not left with gaps.
			let edge = simd.splat8<float32>(float32(-1.0e-6))
			for let y = minY; y <= maxY; y++ {
				let py = float(y) + 0.5
				let r0 = float32(b0 * py + c0)
				let r1 = float32(b1 * py + c1)
				let r2 = float32(b2 * py + c2)
				let row = y * w
				let x = minX
				for x + 8 <= maxX + 1 {
					let px = simd.splat8<float32>(float32(float(x) + 0.5)) + lanes
					let l0 = va0 * px + simd.splat8<float32>(r0)
					let l1 = va1 * px + simd.splat8<float32>(r1)
					let l2 = va2 * px + simd.splat8<float32>(r2)
					let inside = l0.ge(edge) & l1.ge(edge) & l2.ge(edge)
					if inside.any() {
						let z = l0 * vz0 + l1 * vz1 + l2 * vz2
						let stored = simd.load8<float32>(target.depth, row + x)
						let visible = inside & z.lt(stored) & z.ge(zero) & z.le(one)
						if visible.any() {
							simd.store8(target.depth, row + x, visible.blend(z, stored)) unless blendPass
							for let k = 0; k < 8; k++ {
								continue unless visible.lane(k)
								shadeAt(target, p, shader, pixel, a, b, c, x + k, y, float(l0.lane(k)), float(l1.lane(k)), float(l2.lane(k)), w0, w1, w2, front, blendPass)
							}
						}
					}
					x += 8
				}
				for x <= maxX {
					let px = float(x) + 0.5
					let l0 = a0 * px + b0 * py + c0
					let l1 = a1 * px + b1 * py + c1
					let l2 = a2 * px + b2 * py + c2
					if l0 >= -1.0e-6 && l1 >= -1.0e-6 && l2 >= -1.0e-6 {
						let z = float32(l0 * z0 + l1 * z1 + l2 * z2)
						if z < target.depth[row + x] && z >= 0 && z <= 1 {
							target.depth[row + x] = z unless blendPass
							shadeAt(target, p, shader, pixel, a, b, c, x, y, l0, l1, l2, w0, w1, w2, front, blendPass)
						}
					}
					x++
				}
			}
		}
	}

	// shadeAt shades one covered pixel: the screen barycentrics made
	// perspective-correct, the shader run, the colour written.
	def shadeAt(target SceneTarget, p ScenePrimitive, shader SceneShader, pixel ScenePixel, a int, b int, c int, x int, y int, l0 float, l1 float, l2 float, w0 float, w1 float, w2 float, front bool, blendPass bool) {
		let s0 = l0 * w0
		let s1 = l1 * w1
		let s2 = l2 * w2
		let sum = s0 + s1 + s2
		return when sum == 0
		pixel.b0 = s0 / sum
		pixel.b1 = s1 / sum
		pixel.b2 = s2 / sum
		pixel.front = front
		return unless shader.shade(p, a, b, c, pixel)
		writePixel(target, x, y, pixel, blendPass)
	}

	// writePixel stores the shaded colour: solid pixels replace, blended
	// ones composite over what is there (straight alpha).
	def writePixel(target SceneTarget, x int, y int, pixel ScenePixel, blendPass bool) {
		let at = (y * target.width + x) * 4
		let px = target.pixels
		if !blendPass || pixel.a >= 1 {
			px[at] = pixel.r
			px[at + 1] = pixel.g
			px[at + 2] = pixel.b
			px[at + 3] = uint8((pixel.a.clamp(0.0, 1.0) * 255.0).round())
			return
		}
		let sa = pixel.a.clamp(0.0, 1.0)
		let da = float(px[at + 3]) / 255.0
		let oa = sa + da * (1 - sa)
		return when oa <= 0
		for let k = 0; k < 3; k++ {
			let s = float(pixelChannel(pixel, k))
			let d = float(px[at + k])
			px[at + k] = uint8(((s * sa + d * da * (1 - sa)) / oa).round().clamp(0.0, 255.0))
		}
		px[at + 3] = uint8((oa * 255.0).round())
	}

	def pixelChannel(pixel ScenePixel, k int) uint8 {
		return pixel.r when k == 0
		return pixel.g when k == 1
		return pixel.b
	}

	// drawSegments draws the primitive's segments one pixel wide, depth
	// tested, in the material's base colour.
	def drawSegments(target SceneTarget, p ScenePrimitive, shader SceneShader, pixel ScenePixel, from int, to int, blendPass bool) {
		for let s = 0; s + 1 < p.segments.len(); s += 2 {
			let a = p.segments[s]
			let b = p.segments[s + 1]
			let x0 = float(p.sx[a])
			let y0 = float(p.sy[a])
			let x1 = float(p.sx[b])
			let y1 = float(p.sy[b])
			let steps = int((x1 - x0).abs().max((y1 - y0).abs()).ceil()).max(1)
			for let k = 0; k <= steps; k++ {
				let t = float(k) / float(steps)
				let y = int((y0 + (y1 - y0) * t).floor())
				continue when y < from || y >= to
				let x = int((x0 + (x1 - x0) * t).floor())
				continue when x < 0 || x >= target.width
				let z = float32(float(p.sz[a]) + (float(p.sz[b]) - float(p.sz[a])) * t)
				let at = y * target.width + x
				continue when z >= target.depth[at] || z < 0 || z > 1
				pixel.b0 = 1 - t
				pixel.b1 = t
				pixel.b2 = 0
				pixel.front = true
				continue unless shader.flat(p, a, b, pixel)
				target.depth[at] = z unless blendPass
				writePixel(target, x, y, pixel, blendPass)
			}
		}
	}

	// drawPoints draws the primitive's points as single pixels.
	def drawPoints(target SceneTarget, p ScenePrimitive, shader SceneShader, pixel ScenePixel, from int, to int, blendPass bool) {
		for let (_, v) in p.points {
			let y = int(float(p.sy[v]).floor())
			continue when y < from || y >= to
			let x = int(float(p.sx[v]).floor())
			continue when x < 0 || x >= target.width
			let z = p.sz[v]
			let at = y * target.width + x
			continue when z >= target.depth[at] || z < 0 || z > 1
			pixel.b0 = 1
			pixel.b1 = 0
			pixel.b2 = 0
			pixel.front = true
			continue unless shader.flat(p, v, v, pixel)
			target.depth[at] = z unless blendPass
			writePixel(target, x, y, pixel, blendPass)
		}
	}
}
