internal partial module std.gfx.scene.raster {
	use (
		std.formats.image::(Image)
		std.formats.models::*
		std.math::(Pi, cos, log2, sin, sqrt)
	)

	// ScenePixel carries one pixel through shading: the barycentric weights
	// of the triangle's corners (perspective-correct), which face is seen,
	// and the colour out.
	type ScenePixel {
		b0      float
		b1      float
		b2      float
		front   bool    = true
		r       uint8
		g       uint8
		b       uint8
		a       float
		// Scratch for texture samples, one per drawing task.
		sample  float[]
		// Per texture coordinate set of the triangle being drawn: its
		// texture-space area over its screen area, for the mipmap level.
		density float[]

		def new() {
			sample = float[0, 0, 0, 0]
			density = float[]
		}
	}

	// SceneTexture is a decoded texture ready to sample: its pixels as a
	// mipmap pyramid (each level the box average of the one above, down to
	// one texel), and how it wraps and filters.
	type SceneTexture {
		// Per level: RGBA8 rows, width and height.
		levels     byte[][]
		widths     int[]
		heights    int[]
		wrapS      Wrap
		wrapT      Wrap
		// Nearest texel when magnified; when minified, the base of the min
		// filter; and whether the min filter uses the pyramid, blending two
		// levels or taking the nearest one.
		magNearest bool
		minNearest bool
		mipmap     bool
		mipLinear  bool

		def new(img Image, t Texture, colour bool, toLinear float32[], toSrgb uint8[]) {
			levels = byte[][]
			widths = int[]
			heights = int[]
			let w = int(img.size().width)
			let h = int(img.size().height)
			let base = packRows(img.raw(), w, h, img.stride())
			levels.push(base)
			widths.push(w)
			heights.push(h)
			wrapS = t.wrapS
			wrapT = t.wrapT
			magNearest = t.magFilter == Filter.Nearest
			minNearest = t.minFilter == Filter.Nearest || t.minFilter == Filter.NearestMipmapNearest || t.minFilter == Filter.NearestMipmapLinear
			mipmap = t.minFilter != Filter.Nearest && t.minFilter != Filter.Linear
			mipLinear = t.minFilter == Filter.LinearMipmapLinear || t.minFilter == Filter.NearestMipmapLinear
			return unless mipmap
			for w > 1 || h > 1 {
				let nw = (w / 2).max(1)
				let nh = (h / 2).max(1)
				levels.push(halve(levels[levels.len() - 1], w, h, nw, nh, colour, toLinear, toSrgb))
				widths.push(nw)
				heights.push(nh)
				w = nw
				h = nh
			}
		}

		// packRows copies the image's rows without their padding.
		def packRows(raw byte[], w int, h int, stride int) byte[] {
			return raw when stride == w * 4 && raw.len() == w * h * 4
			let out byte[]
			out.len(w * h * 4)
			for let y = 0; y < h; y++ {
				raw[y * stride:y * stride + w * 4].copy(out[y * w * 4:(y + 1) * w * 4])
			}
			return out
		}

		// halve is the next level: each texel the average of the 2×2 block
		// above it (the last column or row doubled when odd); a colour
		// texture's channels are averaged in linear light, a data texture's
		// (normals, roughness) as stored.
		def halve(src byte[], w int, h int, nw int, nh int, colour bool, toLinear float32[], toSrgb uint8[]) byte[] {
			let out byte[]
			out.len(nw * nh * 4)
			for let y = 0; y < nh; y++ {
				let y0 = (y * 2).min(h - 1)
				let y1 = (y * 2 + 1).min(h - 1)
				for let x = 0; x < nw; x++ {
					let x0 = (x * 2).min(w - 1)
					let x1 = (x * 2 + 1).min(w - 1)
					let a = (y0 * w + x0) * 4
					let b = (y0 * w + x1) * 4
					let c = (y1 * w + x0) * 4
					let d = (y1 * w + x1) * 4
					let o = (y * nw + x) * 4
					for let k = 0; k < 3; k++ {
						if colour {
							let sum = float(toLinear[int(src[a + k])]) + float(toLinear[int(src[b + k])]) + float(toLinear[int(src[c + k])]) + float(toLinear[int(src[d + k])])
							out[o + k] = toSrgb[int((sum * 0.25 * 4095.0).round())]
						} else {
							out[o + k] = byte((int(src[a + k]) + int(src[b + k]) + int(src[c + k]) + int(src[d + k]) + 2) / 4)
						}
					}
					out[o + 3] = byte((int(src[a + 3]) + int(src[b + 3]) + int(src[c + 3]) + int(src[d + 3]) + 2) / 4)
				}
			}
			return out
		}

		// wrap brings a texel coordinate into the image by the wrap mode.
		def wrap(i int, n int, mode Wrap) int {
			return i when i >= 0 && i < n
			switch mode {
				case Wrap.Clamp:
					return i.clamp(0, n - 1)
				case Wrap.Mirror:
					let period = 2 * n
					let m = ((i % period) + period) % period
					return m < n ?? (m, period - 1 - m)
				default:
					return ((i % n) + n) % n
			}
		}

		// sample reads the texture at u, v into out (r, g, b, a in 0..1).
		// `density` is the texture area in texture-space units per screen
		// pixel area, which picks the pyramid level (the level whose texels
		// are about a pixel wide); `linear` decodes the colour channels from
		// sRGB.
		def sample(u float, v float, density float, linear bool, lut float32[], out float[]) {
			let lod = 0.0
			lod = 0.5 * log2(density * float(widths[0] * heights[0])) when mipmap && density > 0
			if lod <= 0 {
				level(0, u, v, magNearest, linear, lut, out, 1.0, true)
				return
			}
			let top = float(levels.len() - 1)
			lod = lod.min(top)
			if !mipLinear {
				level(int((lod + 0.5).floor()), u, v, minNearest, linear, lut, out, 1.0, true)
				return
			}
			let lo = int(lod.floor())
			let t = lod - float(lo)
			level(lo, u, v, minNearest, linear, lut, out, 1 - t, true)
			level((lo + 1).min(levels.len() - 1), u, v, minNearest, linear, lut, out, t, false) when t > 0
		}

		// level adds `weight` times the texture read at one pyramid level,
		// nearest or bilinear, to out (or sets it when `first`).
		def level(l int, u float, v float, nearest bool, linear bool, lut float32[], out float[], weight float, first bool) {
			let data = levels[l]
			let width = widths[l]
			let height = heights[l]
			let fx = u * float(width) - 0.5
			let fy = v * float(height) - 0.5
			if nearest {
				let x = wrap(int((fx + 0.5).floor()), width, wrapS)
				let y = wrap(int((fy + 0.5).floor()), height, wrapT)
				texel(data, width, x, y, linear, lut, out, weight, first)
				return
			}
			let x0f = fx.floor()
			let y0f = fy.floor()
			let tx = fx - x0f
			let ty = fy - y0f
			let x0 = wrap(int(x0f), width, wrapS)
			let x1 = wrap(int(x0f) + 1, width, wrapS)
			let y0 = wrap(int(y0f), height, wrapT)
			let y1 = wrap(int(y0f) + 1, height, wrapT)
			texel(data, width, x0, y0, linear, lut, out, weight * (1 - tx) * (1 - ty), first)
			texel(data, width, x1, y0, linear, lut, out, weight * tx * (1 - ty), false)
			texel(data, width, x0, y1, linear, lut, out, weight * (1 - tx) * ty, false)
			texel(data, width, x1, y1, linear, lut, out, weight * tx * ty, false)
		}

		// texel adds `weight` times the texel to out, or sets it when `first`.
		def texel(data byte[], width int, x int, y int, linear bool, lut float32[], out float[], weight float, first bool) {
			let at = (y * width + x) * 4
			let r = linear ?? (float(lut[int(data[at])]), float(data[at]) / 255.0)
			let g = linear ?? (float(lut[int(data[at + 1])]), float(data[at + 1]) / 255.0)
			let b = linear ?? (float(lut[int(data[at + 2])]), float(data[at + 2]) / 255.0)
			let a = float(data[at + 3]) / 255.0
			if first {
				out[0] = r * weight
				out[1] = g * weight
				out[2] = b * weight
				out[3] = a * weight
				return
			}
			out[0] += r * weight
			out[1] += g * weight
			out[2] += b * weight
			out[3] += a * weight
		}
	}

	// SceneTextures decodes the textures the model's materials use, once,
	// before the drawing tasks start (they only read it).
	type SceneTextures {
		model    Model
		decoded  map<string, SceneTexture>
		// sRGB byte to linear, and linear (×4095) to sRGB byte.
		toLinear float32[]
		toSrgb   uint8[]

		def new(model Model) {
			self.model = model
			decoded = new map<string, SceneTexture>()
			toLinear.len(256)
			for let i = 0; i < 256; i++ {
				toLinear[i] = float32(sceneLinear(uint8(i)))
			}
			toSrgb.len(4096)
			for let i = 0; i < 4096; i++ {
				let v = float(i) / 4095.0
				let s = v <= 0.0031308 ?? (v * 12.92, 1.055 * (v ** (1.0 / 2.4)) - 0.055)
				toSrgb[i] = uint8((s * 255.0).round().clamp(0.0, 255.0))
			}
			// Colour textures first, so a texture used both ways gets a
			// linear-light pyramid.
			for let (_, m) in model.materials {
				decode(m.baseColorTexture, true)
				decode(m.emissiveTexture, true)
			}
			for let (_, m) in model.materials {
				decode(m.metallicRoughnessTexture, false)
				decode(m.normalTexture, false)
				decode(m.occlusionTexture, false)
			}
		}

		// decode decodes a reference's texture into the cache; one whose
		// image is not in the model or does not decode is left out.
		def decode(ref ?TextureRef, colour bool) {
			return when ref is none
			let t = ref.texture
			let key = t.source
			return when key.len() == 0 || decoded.hasKey(key)
			let img = t.image(model) onerror (err error) {
				return
			}
			decoded.set(key, new SceneTexture(img, t, colour, toLinear, toSrgb))
		}

		// texture is the decoded texture, none when it has none.
		def texture(t Texture) ?SceneTexture {
			return decoded.get(t.source)
		}
	}

	// SceneShader shades pixels: the metallic-roughness model of glTF with
	// the scene's lights, textures read through SceneTextures.
	type SceneShader {
		look     SceneView
		lights   SceneLight[]
		textures SceneTextures
		// sRGB byte to linear, and linear (×4095) to sRGB byte.
		toLinear float32[]
		toSrgb   uint8[]
		// Ambient light, a fraction of the diffuse colour.
		ambient  float         = 0.12

		def new(look SceneView, lights SceneLight[], textures SceneTextures) {
			self.look = look
			self.lights = lights
			self.textures = textures
			toLinear = textures.toLinear
			toSrgb = textures.toSrgb
		}

		// encode turns a linear channel into an sRGB byte.
		def encode(v float) uint8 {
			return toSrgb[int((v.clamp(0.0, 1.0) * 4095.0).round())]
		}

		// at interpolates `width` values of an attribute at the pixel.
		def at(attr float32[], a int, b int, c int, k int, width int, pixel ScenePixel) float {
			return float(attr[a * width + k]) * pixel.b0 + float(attr[b * width + k]) * pixel.b1 + float(attr[c * width + k]) * pixel.b2
		}

		// read samples a texture reference at the pixel into `pixel.sample`;
		// false when the material has no usable texture there.
		def read(ref ?TextureRef, p ScenePrimitive, a int, b int, c int, pixel ScenePixel, linear bool) bool {
			return false when ref is none
			let tex = textures.texture(ref.texture)
			return false when tex is none
			return false when ref.uv < 0 || ref.uv >= p.uv.len() || p.uv[ref.uv].len() == 0
			let set = p.uv[ref.uv]
			let u = at(set, a, b, c, 0, 2, pixel)
			let v = at(set, a, b, c, 1, 2, pixel)
			let density = ref.uv < pixel.density.len() ?? (pixel.density[ref.uv], 0.0)
			let t = ref.transform
			if !(t is none) {
				let su = u * t.scaleU
				let sv = v * t.scaleV
				let cs = cos(t.rotation)
				let sn = sin(t.rotation)
				u = cs * su - sn * sv + t.offsetU
				v = sn * su + cs * sv + t.offsetV
				density *= (t.scaleU * t.scaleV).abs()
			}
			tex.sample(u, v, density, linear, toLinear, pixel.sample)
			return true
		}

		// shade colours the pixel of a triangle; false when the pixel is cut
		// away (an alpha-masked texel).
		def shade(p ScenePrimitive, a int, b int, c int, pixel ScenePixel) bool {
			let m = p.material
			// Base colour, linear.
			let br = 1.0
			let bg = 1.0
			let bb = 1.0
			let alpha = 1.0
			let metallic = 1.0
			let roughness = 1.0
			let unlit = false
			if !(m is none) {
				br = float(toLinear[int(m.baseColor.red)])
				bg = float(toLinear[int(m.baseColor.green)])
				bb = float(toLinear[int(m.baseColor.blue)])
				alpha = float(m.baseColor.alpha) / 255.0
				metallic = m.metallic
				roughness = m.roughness
				unlit = m.unlit
				if read(m.baseColorTexture, p, a, b, c, pixel, true) {
					br *= pixel.sample[0]
					bg *= pixel.sample[1]
					bb *= pixel.sample[2]
					alpha *= pixel.sample[3]
				}
			}
			if p.col.len() > 0 {
				br *= at(p.col, a, b, c, 0, 4, pixel)
				bg *= at(p.col, a, b, c, 1, 4, pixel)
				bb *= at(p.col, a, b, c, 2, 4, pixel)
				alpha *= at(p.col, a, b, c, 3, 4, pixel)
			}
			if !(m is none) {
				switch m.alphaMode {
					case AlphaMode.Mask:
						return false when alpha < m.alphaCutoff
						alpha = 1.0
					case AlphaMode.Opaque:
						alpha = 1.0
					default:
				}
			}
			if unlit || m is none && false {
				pixel.r = encode(br)
				pixel.g = encode(bg)
				pixel.b = encode(bb)
				pixel.a = alpha
				return true
			}
			// Position and normal in world space.
			let px = at(p.pos, a, b, c, 0, 3, pixel)
			let py = at(p.pos, a, b, c, 1, 3, pixel)
			let pz = at(p.pos, a, b, c, 2, 3, pixel)
			let nx = 0.0
			let ny = 0.0
			let nz = 0.0
			if p.nrm.len() > 0 {
				nx = at(p.nrm, a, b, c, 0, 3, pixel)
				ny = at(p.nrm, a, b, c, 1, 3, pixel)
				nz = at(p.nrm, a, b, c, 2, 3, pixel)
			} else {
				// The face normal from the corners.
				let ux = float(p.pos[b * 3] - p.pos[a * 3])
				let uy = float(p.pos[b * 3 + 1] - p.pos[a * 3 + 1])
				let uz = float(p.pos[b * 3 + 2] - p.pos[a * 3 + 2])
				let vx = float(p.pos[c * 3] - p.pos[a * 3])
				let vy = float(p.pos[c * 3 + 1] - p.pos[a * 3 + 1])
				let vz = float(p.pos[c * 3 + 2] - p.pos[a * 3 + 2])
				nx = uy * vz - uz * vy
				ny = uz * vx - ux * vz
				nz = ux * vy - uy * vx
			}
			let nl = sqrt(nx * nx + ny * ny + nz * nz)
			if nl > 0 {
				nx /= nl
				ny /= nl
				nz /= nl
			} else {
				nz = 1
			}
			if !pixel.front {
				nx = -nx
				ny = -ny
				nz = -nz
			}
			// Normal map through the tangent frame.
			if !(m is none) && p.tan.len() > 0 && read(m.normalTexture, p, a, b, c, pixel, false) {
				let ref = m.normalTexture
				let strength = ref is none ?? (1.0, ref.strength)
				let mx = (pixel.sample[0] * 2 - 1) * strength
				let my = (pixel.sample[1] * 2 - 1) * strength
				let mz = pixel.sample[2] * 2 - 1
				let tx = at(p.tan, a, b, c, 0, 4, pixel)
				let ty = at(p.tan, a, b, c, 1, 4, pixel)
				let tz = at(p.tan, a, b, c, 2, 4, pixel)
				let hand = at(p.tan, a, b, c, 3, 4, pixel) < 0 ?? (-1.0, 1.0)
				// Gram-Schmidt the tangent against the normal.
				let d = tx * nx + ty * ny + tz * nz
				tx -= nx * d
				ty -= ny * d
				tz -= nz * d
				let tl = sqrt(tx * tx + ty * ty + tz * tz)
				if tl > 0 {
					tx /= tl
					ty /= tl
					tz /= tl
					let bx = (ny * tz - nz * ty) * hand
					let by = (nz * tx - nx * tz) * hand
					let bz = (nx * ty - ny * tx) * hand
					let rx = tx * mx + bx * my + nx * mz
					let ry = ty * mx + by * my + ny * mz
					let rz = tz * mx + bz * my + nz * mz
					let rl = sqrt(rx * rx + ry * ry + rz * rz)
					if rl > 0 {
						nx = rx / rl
						ny = ry / rl
						nz = rz / rl
					}
				}
			}
			let occlusion = 1.0
			let er = 0.0
			let eg = 0.0
			let eb = 0.0
			if !(m is none) {
				if read(m.metallicRoughnessTexture, p, a, b, c, pixel, false) {
					roughness *= pixel.sample[1]
					metallic *= pixel.sample[2]
				}
				if read(m.occlusionTexture, p, a, b, c, pixel, false) {
					let ref = m.occlusionTexture
					let strength = ref is none ?? (1.0, ref.strength)
					occlusion = 1.0 + strength * (pixel.sample[0] - 1.0)
				}
				er = float(toLinear[int(m.emissive.red)]) * m.emissiveStrength
				eg = float(toLinear[int(m.emissive.green)]) * m.emissiveStrength
				eb = float(toLinear[int(m.emissive.blue)]) * m.emissiveStrength
				if read(m.emissiveTexture, p, a, b, c, pixel, true) {
					er *= pixel.sample[0]
					eg *= pixel.sample[1]
					eb *= pixel.sample[2]
				}
			}
			metallic = metallic.clamp(0.0, 1.0)
			roughness = roughness.clamp(0.04, 1.0)
			// View vector.
			let vx = -look.forward.x
			let vy = -look.forward.y
			let vz = -look.forward.z
			if !look.ortho {
				vx = look.eye.x - px
				vy = look.eye.y - py
				vz = look.eye.z - pz
				let vl = sqrt(vx * vx + vy * vy + vz * vz)
				if vl > 0 {
					vx /= vl
					vy /= vl
					vz /= vl
				}
			}
			let ndotv = (nx * vx + ny * vy + nz * vz).max(1.0e-4)
			// Diffuse colour and reflectance at normal incidence.
			let cr = br * (1 - metallic)
			let cg = bg * (1 - metallic)
			let cb = bb * (1 - metallic)
			let f0r = 0.04 * (1 - metallic) + br * metallic
			let f0g = 0.04 * (1 - metallic) + bg * metallic
			let f0b = 0.04 * (1 - metallic) + bb * metallic
			let alpha2 = roughness * roughness * roughness * roughness
			let outR = (cr + f0r * 0.3) * ambient * occlusion
			let outG = (cg + f0g * 0.3) * ambient * occlusion
			let outB = (cb + f0b * 0.3) * ambient * occlusion
			for let (_, light) in lights {
				// Direction to the light and its radiance here.
				let lx = -light.direction.x
				let ly = -light.direction.y
				let lz = -light.direction.z
				let radiance = 1.0
				if light.kind != LightKind.Directional {
					lx = light.position.x - px
					ly = light.position.y - py
					lz = light.position.z - pz
					let d2 = lx * lx + ly * ly + lz * lz
					let d = sqrt(d2)
					continue when d == 0
					lx /= d
					ly /= d
					lz /= d
					radiance = 1.0 / d2.max(1.0e-4)
					if light.range > 0 {
						let f = d / light.range
						let window = (1 - f * f * f * f).clamp(0.0, 1.0)
						radiance *= window * window
					}
					if light.kind == LightKind.Spot {
						let cd = -(lx * light.direction.x + ly * light.direction.y + lz * light.direction.z)
						let span = light.cosInner - light.cosOuter
						let t = span > 0 ?? (((cd - light.cosOuter) / span).clamp(0.0, 1.0), cd >= light.cosOuter ?? (1.0, 0.0))
						radiance *= t * t
					}
				}
				continue when radiance <= 0
				let ndotl = nx * lx + ny * ly + nz * lz
				continue when ndotl <= 0
				let hx = lx + vx
				let hy = ly + vy
				let hz = lz + vz
				let hl = sqrt(hx * hx + hy * hy + hz * hz)
				continue when hl == 0
				hx /= hl
				hy /= hl
				hz /= hl
				let ndoth = (nx * hx + ny * hy + nz * hz).max(0.0)
				let vdoth = (vx * hx + vy * hy + vz * hz).max(0.0)
				// Schlick's Fresnel, GGX distribution and the height-correlated
				// Smith visibility (glTF's appendix B).
				let fw = (1 - vdoth) ** 5
				let fr = f0r + (1 - f0r) * fw
				let fg = f0g + (1 - f0g) * fw
				let fb = f0b + (1 - f0b) * fw
				let dd = ndoth * ndoth * (alpha2 - 1) + 1
				let dist = alpha2 / (Pi * dd * dd)
				let vis = 0.5 / (ndotl * sqrt(ndotv * ndotv * (1 - alpha2) + alpha2) + ndotv * sqrt(ndotl * ndotl * (1 - alpha2) + alpha2))
				let spec = dist * vis
				let scale = radiance * ndotl
				outR += ((1 - fr) * cr / Pi + fr * spec) * light.r * scale
				outG += ((1 - fg) * cg / Pi + fg * spec) * light.g * scale
				outB += ((1 - fb) * cb / Pi + fb * spec) * light.b * scale
			}
			pixel.r = encode(outR + er)
			pixel.g = encode(outG + eg)
			pixel.b = encode(outB + eb)
			pixel.a = alpha
			return true
		}

		// flat colours a segment or point pixel in the base colour, between
		// the two vertices by the pixel's first two weights.
		def flat(p ScenePrimitive, a int, b int, pixel ScenePixel) bool {
			let m = p.material
			let br = 1.0
			let bg = 1.0
			let bb = 1.0
			let alpha = 1.0
			if !(m is none) {
				br = float(toLinear[int(m.baseColor.red)])
				bg = float(toLinear[int(m.baseColor.green)])
				bb = float(toLinear[int(m.baseColor.blue)])
				alpha = float(m.baseColor.alpha) / 255.0
				alpha = 1.0 unless m.alphaMode == AlphaMode.Blend
			}
			if p.col.len() > 0 {
				br *= float(p.col[a * 4]) * pixel.b0 + float(p.col[b * 4]) * pixel.b1
				bg *= float(p.col[a * 4 + 1]) * pixel.b0 + float(p.col[b * 4 + 1]) * pixel.b1
				bb *= float(p.col[a * 4 + 2]) * pixel.b0 + float(p.col[b * 4 + 2]) * pixel.b1
				alpha *= float(p.col[a * 4 + 3]) * pixel.b0 + float(p.col[b * 4 + 3]) * pixel.b1
			}
			pixel.r = encode(br)
			pixel.g = encode(bg)
			pixel.b = encode(bb)
			pixel.a = alpha
			return true
		}
	}
}
