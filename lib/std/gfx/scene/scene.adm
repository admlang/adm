partial module std.gfx.scene {
	use (
		std.formats.image::(Image)
		std.formats.models::(Model, Node)
		std.gfx.color::(Color, RGBA)
		std.gfx.scene.raster::*
	)

	// RenderOptions says how `render` draws a scene.
	//
	// Example: Render a model to a picture
	// ```example
	// use (
	// 	std.formats.models
	// 	std.gfx.scene
	// )
	//
	// let model = try models.load("robot.glb")
	// let picture = scene.render(model, 800, 600, RenderOptions{samples: 2})
	// try picture.save("robot.png")
	// ```
	struct RenderOptions {
		// The node whose camera the scene is seen through; none takes the
		// first node with a camera in tree order, else a camera placed in
		// front of the whole scene, looking at its middle.
		camera     ?Node
		// The time in seconds the model's animations are at; they are applied
		// to the nodes before drawing, and the nodes keep that pose.
		time       float = 0.0
		// What shows where nothing is drawn; transparent black by default.
		background Color = new Color(RGBA{r: 0, g: 0, b: 0, a: 0})
		// Pixels drawn per output pixel along each axis, 1 to 4: 2 draws four
		// samples a pixel and averages them, which smooths edges.
		samples    int   = 1
	}

	// render draws the model into a new image of the size: every placed mesh,
	// skinned and morphed as its node says, lit by the model's lights in the
	// metallic-roughness model (one light at the camera when it has none),
	// textures sampled bilinearly, blended surfaces drawn after the solid
	// ones from the back. A texture whose image cannot be decoded is drawn
	// without it.
	def render(model Model, width int, height int, options RenderOptions = RenderOptions{}) Image {
		return renderScene(model, width, height, options)
	}
}
