partial module std.gfx.scene {
	use (
		std.formats.models::(Camera)
		std.math.geom::(Vec3)
	)

	// Viewpoint is where a prepared model is seen from: a camera placed
	// freely, outside the model's nodes. Moving `eye` and `target` between
	// pictures orbits, pans and zooms.
	//
	// Example: Look at a model from the side
	// ```example
	// use (
	// 	std.formats.models
	// 	std.gfx.scene
	// 	std.math.geom::(Vec3)
	// )
	//
	// let prepared = new scene.PreparedModel(try models.load("robot.glb"))
	// let side = new scene.Viewpoint(new Vec3(4, 1, 0), new Vec3(0, 1, 0))
	// let picture = prepared.render(800, 600, side)
	// ```
	type Viewpoint {
		// Where the camera stands and the point it looks at.
		eye      Vec3
		target   Vec3
		// The direction towards the top of the picture.
		up       Vec3
		// The projection: perspective by its vertical field of view, or
		// orthographic by `xmag` and `ymag`, half the view's width and height.
		lens     Camera
		// true places the near and far planes around the model for each
		// picture, so nothing is cut away however near or far the eye is;
		// false uses the lens's own `znear` and `zfar`.
		fitDepth bool   = true

		def new(eye Vec3, target Vec3, up Vec3 = new Vec3(0, 1, 0), lens Camera = new Camera()) {
			self.eye = eye
			self.target = target
			self.up = up
			self.lens = lens
		}

		// copy is a viewpoint of its own with the same values: changing one
		// leaves the other as it was.
		def copy() Viewpoint {
			let glass = new Camera(lens.name, lens.kind)
			glass.yfov = lens.yfov
			glass.aspect = lens.aspect
			glass.xmag = lens.xmag
			glass.ymag = lens.ymag
			glass.znear = lens.znear
			glass.zfar = lens.zfar
			let made = new Viewpoint(new Vec3(eye.x, eye.y, eye.z), new Vec3(target.x, target.y, target.z), new Vec3(up.x, up.y, up.z), glass)
			made.fitDepth = fitDepth
			return made
		}

		// equals reports whether the other viewpoint shows the same picture:
		// every value equal.
		def equals(other Viewpoint) bool {
			return false unless eye.x == other.eye.x && eye.y == other.eye.y && eye.z == other.eye.z
			return false unless target.x == other.target.x && target.y == other.target.y && target.z == other.target.z
			return false unless up.x == other.up.x && up.y == other.up.y && up.z == other.up.z
			let a = lens
			let b = other.lens
			return fitDepth == other.fitDepth && a.kind == b.kind && a.yfov == b.yfov && a.xmag == b.xmag && a.ymag == b.ymag && a.znear == b.znear && a.zfar == b.zfar
		}
	}
}
