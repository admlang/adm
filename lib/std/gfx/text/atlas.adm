// Glyph atlas pages for GPU renderers: glyph masks packed into 1024 x 1024
// coverage pages (one byte per pixel, an R8 texture), each tracking the
// region changed since its last upload. Filled only when a renderer asks
// for a glyph's place, so CPU drawing pays nothing for it.

internal std partial module std.gfx.text {
	// Width and height of an atlas page, in pixels.
	const atlasPageSize = 1024

	// Clear pixels kept around every glyph, so filtering never reads a
	// neighbour.
	const atlasPadding = 1

	// Where a glyph sits in the atlas: page, top-left pixel of its mask, its
	// size, and the mask's offset from the pen position (as GlyphMask).
	struct AtlasGlyph {
		page   int
		x      int
		y      int
		width  int
		height int
		left   int
		top    int
	}

	// What a renderer copies to its texture for a page: the rectangle
	// (x, y, width, height) and its bytes, `width` per row. `whole` means
	// the page was reused and everything it held before is gone.
	struct AtlasUpload {
		x      int
		y      int
		width  int
		height int
		bytes  byte[]
		whole  bool
	}

	// One page: its pixels and the shelves (rows of glyphs) packed so far.
	internal type AtlasPage {
		pixels      byte[]
		// Each shelf's top, height and the x where its next glyph goes.
		shelfY      int[]
		shelfHeight int[]
		shelfX      int[]
		nextY       int
		used        int
		// The region changed since the last upload; x0 >= x1 when none.
		x0          int
		y0          int
		x1          int
		y1          int
		whole       bool

		def new() {
			pixels.len(atlasPageSize * atlasPageSize)
			pixels.fill(0)
			whole = true
			x0 = atlasPageSize
			y0 = atlasPageSize
		}

		// A free rectangle of `w` x `h` pixels (padding included), or
		// (-1, -1) when the page has no room: on the first shelf at least as
		// tall as the glyph and at most about twice its height, else on a new
		// shelf below the others.
		def allocate(w int, h int) (int, int) {
			for let (i, sh) in shelfHeight {
				continue when sh < h || sh > h * 2 + 4
				if shelfX[i] + w <= atlasPageSize {
					let x = shelfX[i]
					shelfX[i] += w
					return (x, shelfY[i])
				}
			}
			// A new shelf, its height rounded up to 4 pixels.
			let height = (h + 3) / 4 * 4
			return (-1, -1) when nextY + height > atlasPageSize || w > atlasPageSize
			shelfY.push(nextY)
			shelfHeight.push(height)
			shelfX.push(w)
			nextY += height
			return (0, shelfY[shelfY.len() - 1])
		}

		// Empties the page for reuse.
		def reset() {
			pixels.fill(0)
			shelfY = int[]
			shelfHeight = int[]
			shelfX = int[]
			nextY = 0
			whole = true
		}

		def touch(x int, y int, w int, h int) {
			x0 = x0.min(x)
			y0 = y0.min(y)
			x1 = x1.max(x + w)
			y1 = y1.max(y + h)
		}
	}

	// The pages and where each glyph sits in them.
	internal type Atlas {
		pages    AtlasPage[]
		// Mask keys (as TextCache.maskKey) to places.
		places   map<int, AtlasGlyph>
		maxPages int

		def new() {
			places = map<int, AtlasGlyph>{}
			maxPages = 1
		}

		// The place of mask `m` under `key`, packing it when new; none when
		// it cannot fit a page.
		def place(key int, m GlyphMask, clock int) ?AtlasGlyph {
			let known = places.get(key)
			if known is AtlasGlyph {
				pages[known.page].used = clock
				return known
			}
			let w = m.width + atlasPadding * 2
			let h = m.height + atlasPadding * 2
			return none when w > atlasPageSize || h > atlasPageSize
			// The first page with room, else a new page, else the least
			// recently used one emptied.
			let page = -1
			let x = -1
			let y = -1
			for let (i, p) in pages {
				(x, y) = p.allocate(w, h)
				if x >= 0 {
					page = i
					break
				}
			}
			if page < 0 && pages.len() < maxPages {
				pages.push(new AtlasPage())
				page = pages.len() - 1
				(x, y) = pages[page].allocate(w, h)
			}
			if page < 0 {
				page = 0
				for let (i, p) in pages {
					page = i when p.used < pages[page].used
				}
				recycle(page)
				(x, y) = pages[page].allocate(w, h)
			}
			let p = pages[page]
			p.used = clock
			let gx = x + atlasPadding
			let gy = y + atlasPadding
			for let row = 0; row < m.height; row++ {
				let dst = (gy + row) * atlasPageSize + gx
				for let col = 0; col < m.width; col++ {
					p.pixels[dst + col] = m.coverage[row * m.width + col]
				}
			}
			p.touch(x, y, w, h)
			let g = AtlasGlyph{page: page, x: gx, y: gy, width: m.width, height: m.height, left: m.left, top: m.top}
			places[key] = g
			return g
		}

		// Empties a page and forgets the glyphs it held.
		def recycle(page int) {
			pages[page].reset()
			places = places.omitValues((k int, g AtlasGlyph) => g.page == page)
		}

		// The page's changes since the last call, none when it has none.
		def upload(page int) ?AtlasUpload {
			return none when page < 0 || page >= pages.len()
			let p = pages[page]
			if p.whole {
				p.whole = false
				p.x0 = atlasPageSize
				p.y0 = atlasPageSize
				p.x1 = 0
				p.y1 = 0
				return AtlasUpload{x: 0, y: 0, width: atlasPageSize, height: atlasPageSize, bytes: p.pixels.clone(), whole: true}
			}
			return none when p.x0 >= p.x1 || p.y0 >= p.y1
			let w = p.x1 - p.x0
			let h = p.y1 - p.y0
			let bytes byte[]
			bytes.len(w * h)
			for let row = 0; row < h; row++ {
				let src = (p.y0 + row) * atlasPageSize + p.x0
				for let col = 0; col < w; col++ {
					bytes[row * w + col] = p.pixels[src + col]
				}
			}
			let out = AtlasUpload{x: p.x0, y: p.y0, width: w, height: h, bytes: bytes, whole: false}
			p.x0 = atlasPageSize
			p.y0 = atlasPageSize
			p.x1 = 0
			p.y1 = 0
			return out
		}

		// Keeps at most `n` pages, forgetting the glyphs of those dropped.
		def limit(n int) {
			maxPages = n
			return when pages.len() <= n
			pages = pages[:n]
			places = places.omitValues((k int, g AtlasGlyph) => g.page >= n)
		}

		def clear() {
			pages = AtlasPage[]
			places = map<int, AtlasGlyph>{}
		}
	}
}
