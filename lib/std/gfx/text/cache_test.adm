internal std partial module std.gfx.text {
	use (
		std.os
		std.testing
		std.formats.fonts
		std.math.geom::(Path)
	)

	check "Text cache" {
		def face() !fonts.Face {
			return try (try fonts.load(try os.readFile("samples/fonts/ttf/SourceSansPro-Black.ttf"))).face(0)
		}

		def glyph(f fonts.Face, ch char) !fonts.GlyphID {
			let g = f.glyph(ch)
			fail "no glyph for {ch}" when g is none
			return g
		}

		def need(m ?GlyphMask) !GlyphMask {
			return m when m is GlyphMask
			fail "no mask"
		}

		// A rasterizer that fills the whole box and counts its calls.
		type CountingRaster {
			calls int

			def new() {}

			def raster(_ Path, width int, height int) byte[] {
				calls++
				let out byte[]
				out.len(width * height)
				out.fill(255)
				return out
			}
		}

		@test()
		def masksAreRasterizedOnce() !none {
			let f = try face()
			let a = try glyph(f, 'a')
			let cache = new TextCache()
			let counter = new CountingRaster()
			let raster = (p Path, w int, h int) => counter.raster(p, w, h)
			let first = try need(cache.mask(f, a, 16.0, false, 0.0, raster))
			let again = try need(cache.mask(f, a, 16.0, false, 0.0, raster))
			assert counter.calls == 1 // the second draw reuses the mask
			assert again.width == first.width && again.coverage.len() == first.coverage.len() // the same mask comes back
			cache.mask(f, a, 16.0, false, 0.25, raster)
			assert counter.calls == 2 // another quarter pixel is another mask
			cache.mask(f, a, 16.0, true, 0.3, raster)
			cache.mask(f, a, 16.0, true, 0.6, raster)
			assert counter.calls == 3 // hinted glyphs keep whole pixels: one mask for any fraction
			cache.mask(f, a, 17.0, true, 0.0, raster)
			assert counter.calls == 4 // each size has its own
			assert cache.mask(f, a, 300.0, true, 0.0, raster) is none // too large to keep as a mask
		}

		@test()
		def masksAreTight() !none {
			let f = try face()
			let cache = new TextCache()
			let counter = new CountingRaster()
			let raster = (p Path, w int, h int) => counter.raster(p, w, h)
			let m = try need(cache.mask(f, try glyph(f, 'H'), 20.0, true, 0.0, raster))
			assert m.width > 5 && m.height > 10 && m.top < 0 // a capital H stands above the baseline
			assert m.coverage.len() == m.width * m.height // one byte per pixel
			let blank = try need(cache.mask(f, try glyph(f, ' '), 20.0, true, 0.0, raster))
			assert blank.width == 0 && blank.coverage.len() == 0 // a space has no ink
		}

		@test()
		def runsAreShapedOnce() !none {
			let f = try face()
			let cache = new TextCache()
			let run = cache.shaped(f, "office", fonts.ShapeOptions{})
			let held = cache.size()
			let again = cache.shaped(f, "office", fonts.ShapeOptions{})
			assert cache.size() == held // the second call holds nothing new
			assert again.glyphs.len() == run.glyphs.len() // and returns the same run
			cache.shaped(f, "office", fonts.ShapeOptions{features: {"liga": false}})
			assert cache.size() > held // other features are another run
		}

		@test()
		def imagesAreKeptByKey() !none {
			let f = try face()
			let cache = new TextCache()
			assert cache.image(f, "Hello|16") is none // nothing drawn yet
			cache.keepImage(f, "Hello|16", GlyphMask{width: 2, height: 1, left: 0, top: -1, coverage: byte[1, 2]})
			let got = try need(cache.image(f, "Hello|16"))
			assert got.width == 2 && got.coverage[1] == 2 // the kept image comes back
			assert cache.image(f, "Hello|17") is none // another key misses
		}

		@test()
		def budgetDropsOldestFirst() !none {
			let f = try face()
			let cache = new TextCache()
			let image = GlyphMask{width: 100, height: 10, left: 0, top: 0, coverage: byte[]}
			image.coverage.len(1000)
			for let i = 0; i < 10; i++ {
				cache.keepImage(f, "run {i}", image)
			}
			// Touch the oldest, so the next oldest goes first.
			cache.image(f, "run 0")
			cache.budget = 5000
			assert cache.size() <= 5000 // trimmed under the budget
			assert !(cache.image(f, "run 0") is none) // recently used stays
			assert cache.image(f, "run 1") is none // least recently used went
			assert !(cache.image(f, "run 9") is none) // newest stays
			cache.clear()
			assert cache.size() == 0 // clear empties it
			assert cache.image(f, "run 9") is none // and forgets everything
		}

		// A rasterizer that writes a pattern unique to each pixel, never 0.
		def pattern(_ Path, width int, height int) byte[] {
			let out byte[]
			out.len(width * height)
			for let i = 0; i < out.len(); i++ {
				out[i] = byte(i % 251 + 1)
			}
			return out
		}

		@test()
		def atlasHoldsTheMasks() !none {
			let f = try face()
			let cache = new TextCache()
			let raster = (p Path, w int, h int) => pattern(p, w, h)
			let a = try glyph(f, 'a')
			let g = cache.atlasGlyph(f, a, 24.0, true, 0.0, raster)
			assert !(g is none) // a 24 px glyph gets a place
			let m = try need(cache.mask(f, a, 24.0, true, 0.0, raster))
			let first = cache.atlasUpload(0)
			assert !(first is none) // a new page uploads whole
			if g is AtlasGlyph && first is AtlasUpload {
				assert first.whole && first.width == atlasPageSize // the whole page
				assert g.width == m.width && g.height == m.height && g.left == m.left && g.top == m.top // the mask's own box
				for let y = 0; y < g.height; y++ {
					for let x = 0; x < g.width; x++ {
						assert first.bytes[(g.y + y) * atlasPageSize + g.x + x] == m.coverage[y * m.width + x] // same coverage
					}
				}
				assert first.bytes[(g.y - 1) * atlasPageSize + g.x] == 0 && first.bytes[g.y * atlasPageSize + g.x + g.width] == 0 // a clear border
				let again = cache.atlasGlyph(f, a, 24.0, true, 0.0, raster)
				assert !(again is none) && again.x == g.x && again.y == g.y // packed once
			}
			assert cache.atlasUpload(0) is none // nothing changed since
			let b = cache.atlasGlyph(f, try glyph(f, 'b'), 24.0, true, 0.0, raster)
			let next = cache.atlasUpload(0)
			if b is AtlasGlyph && next is AtlasUpload {
				assert !next.whole && next.x <= b.x && next.y <= b.y && next.x + next.width >= b.x + b.width && next.y + next.height >= b.y + b.height // only the new glyph's region
				assert next.bytes.len() == next.width * next.height // one byte per pixel
			} else {
				assert false // the second glyph is placed and uploads
			}
		}

		@test()
		def atlasGlyphsDoNotOverlap() !none {
			let f = try face()
			let cache = new TextCache()
			let raster = (p Path, w int, h int) => pattern(p, w, h)
			let boxes AtlasGlyph[]
			for let (_, ch) in "AaBbGgQqWw@#%" {
				for let (_, size) in [12.0, 30.0, 70.0, 140.0] {
					let g = cache.atlasGlyph(f, try glyph(f, ch), size, false, 0.0, raster)
					if g is AtlasGlyph {
						boxes.push(g) when g.width > 0
					}
				}
			}
			assert boxes.len() > 40 // every glyph found a place
			for let (i, p) in boxes {
				assert p.x >= 1 && p.y >= 1 && p.x + p.width < atlasPageSize && p.y + p.height < atlasPageSize // inside the page, padding kept
				for let j = i + 1; j < boxes.len(); j++ {
					let q = boxes[j]
					continue when p.page != q.page
					assert p.x + p.width < q.x || q.x + q.width < p.x || p.y + p.height < q.y || q.y + q.height < p.y // apart, with a pixel between
				}
			}
		}

		@test()
		def fullAtlasReusesTheOldestPage() !none {
			let f = try face()
			let cache = new TextCache()
			cache.budget = 4 * 1024 * 1024 // one page
			let raster = (p Path, w int, h int) => pattern(p, w, h)
			let first = cache.atlasGlyph(f, try glyph(f, 'W'), 250.0, false, 0.0, raster)
			assert !(first is none) // placed
			cache.atlasUpload(0)
			// Big glyphs until the page is full and must be reused.
			let reused = false
			for let (_, ch) in "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz" {
				cache.atlasGlyph(f, try glyph(f, ch), 249.0, false, 0.0, raster)
				let up = cache.atlasUpload(0)
				reused = true when up is AtlasUpload && up.whole
			}
			assert cache.atlasPages() == 1 // never more pages than the budget allows
			assert reused // the full page was emptied and uploaded whole again
		}

		@test()
		def oneCacheForTheProgram() {
			assert cache() == cache() // every canvas shares the same instance
		}
	}
}
