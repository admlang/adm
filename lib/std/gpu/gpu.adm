partial module std.gpu {
	// Memory that stays on the GPU between `cuda def` launches, so a kernel
	// called many times on the same data pays for the copies once. On a
	// machine without a GPU (or under ADM_CUDA=cpu) the buffer lives in
	// host memory and the kernels' CPU path reads it, so the same program
	// runs either way. Pass it to a `cuda def` where the kernel expects a
	// `T[]`: the kernel sees the same `T* name, int64_t name_len` pair.
	type DeviceBuffer<T> {
		internal handle uint
		internal length int

		internal def new(h uint, n int) {
			handle = h
			length = n
		}

		// Elements in the buffer.
		def len() int {
			return length
		}

		// Copies the buffer into `into`, which must have the buffer's length.
		def download(into T[]) !none {
			fail __cuda_last_error() when __cuda_buffer_download(handle, into) != 0
			return none
		}

		// Overwrites the buffer with `from`, which must have the buffer's length.
		def write(from T[]) !none {
			fail __cuda_last_error() when __cuda_buffer_write(handle, from) != 0
			return none
		}

		// Frees the device memory; the buffer must not be used afterwards.
		def dispose() {
			return when handle == uint(0)
			__cuda_buffer_free(handle)
			handle = uint(0)
		}
	}

	// Copies `data` to the device and returns the buffer holding it.
	def upload<T>(data T[]) !DeviceBuffer<T> {
		let handle = __cuda_buffer_upload(data)
		fail __cuda_last_error() when handle == uint(0)
		return new DeviceBuffer<T>(handle, data.len())
	}

	// Whether kernels run on the GPU right now: the driver loaded and
	// ADM_CUDA does not force the CPU path.
	def available() bool {
		return __cuda_available()
	}

	// Name of the selected GPU (ADM_CUDA_DEVICE), or "" without one.
	def deviceName() string {
		return __cuda_device_name()
	}
}
