partial module std.gpu {
	// Memory that stays on the GPU between `cuda def` launches, so a kernel
	// called many times on the same data pays for the copies once. On a
	// machine without a GPU (or under ADM_CUDA=cpu) the buffer lives in
	// host memory and the kernels' CPU path reads it, so the same program
	// runs either way. Pass it to a `cuda def` where the kernel expects a
	// `T[]`: the kernel sees the same `T* name, int64_t name_len` pair.
	type DeviceBuffer<T> {
		internal handle uint
		internal length int

		internal def new(h uint, n int) {
			handle = h
			length = n
		}

		// Elements in the buffer.
		def len() int {
			return length
		}

		// Copies the buffer into `into`, which must have the buffer's length.
		// Fails with the driver's error when the copy does not complete.
		def download(into T[]) !none {
			fail __cuda_last_error() when __cuda_buffer_download(handle, into) != 0
			return none
		}

		// Overwrites the buffer with `from`, which must have the buffer's length.
		// Fails with the driver's error when the copy does not complete.
		def write(from T[]) !none {
			fail __cuda_last_error() when __cuda_buffer_write(handle, from) != 0
			return none
		}

		// Overwrites `from.len()` elements starting at element `at` with
		// `from`, which must fit: `at >= 0` and `at + from.len() <= len()`.
		// Fails when it does not fit, and with the driver's error when the
		// copy does not complete.
		def write(from T[], at int) !none {
			fail __cuda_last_error() when __cuda_buffer_write_at(handle, from, at) != 0
			return none
		}

		// Queues a copy of `from`, which must have the buffer's length, onto
		// the buffer behind `stream`'s earlier work, and returns at once:
		// `from` must stay unchanged until `stream.wait()`. Synchronous on
		// the CPU path. Fails with the driver's error when the copy cannot be
		// queued.
		def writeAsync(from T[], stream Stream) !none {
			fail __cuda_last_error() when __cuda_buffer_write_async(handle, from, stream.handle) != 0
			return none
		}

		// Queues a copy of the buffer into `into`, which must have the
		// buffer's length, behind `stream`'s earlier work: `into` holds the
		// values after `stream.wait()`. Synchronous on the CPU path. Fails
		// with the driver's error when the copy cannot be queued.
		def downloadAsync(into T[], stream Stream) !none {
			fail __cuda_last_error() when __cuda_buffer_download_async(handle, into, stream.handle) != 0
			return none
		}

		// Queues a copy of `count` elements of `from`, starting at its element
		// `start`, onto the buffer from element `at` on, behind the launches
		// queued so far on the default stream, and returns at once: a launch
		// queued next reads the new values. The elements copied must stay
		// unchanged until the copy is done; `from.write` waits for that by
		// itself. With `overlap` the copy waits for the launches queued so far
		// and then runs beside the ones queued after it, which keeps the GPU
		// computing during the copy: none of those may touch the range until
		// `join()`, or what they read is undefined. The copy happens at once on
		// the CPU path. Fails when the range is outside `from` or does not fit in
		// the buffer, and with the driver's error when the copy cannot be queued.
		def write(from HostBuffer<T>, start int, count int, at int, overlap bool = false) !none {
			fail __cuda_last_error() when __cuda_buffer_write_host(handle, from.handle, start, count, at, overlap) != 0
			return none
		}

		// Makes the launches queued from now on wait for the overlapping copies
		// (`write(..., overlap = true)`) queued into the buffer so far: after it
		// a launch reads what they wrote. Returns at once. Fails for a disposed
		// buffer and with the driver's error.
		def join() !none {
			fail __cuda_last_error() when __cuda_buffer_join(handle) != 0
			return none
		}

		// A readback of the whole buffer: a copy to host memory that waits only
		// for the launches queued before it, see `Readback`. Make one and reuse
		// it. With `overlap` the copy runs beside the launches queued after its
		// `start` instead of ahead of them, which keeps the GPU busy across the
		// copy; none of those launches may write the buffer before `wait`
		// returns, or the values read are undefined. Fails with the driver's
		// error when its host memory cannot be allocated, and for a disposed
		// buffer.
		def readback(overlap bool = false) !Readback<T> {
			let made = __cuda_readback_create(handle, overlap)
			fail __cuda_last_error() when made == uint(0)
			return new Readback<T>(made, self)
		}

		// Frees the device memory; the buffer must not be used afterwards.
		def dispose() {
			return when handle == uint(0)
			__cuda_buffer_free(handle)
			handle = uint(0)
		}
	}

	// Reads a `DeviceBuffer` back while the GPU goes on working. `download`
	// waits for every launch queued on the default stream; a readback waits
	// only for those queued before its `start`:
	//
	//	pick(scores, picks)          // queued kernel, fills `picks`
	//	try back.start()             // queues the copy behind it
	//	run(picks, out)              // queued behind the copy; not waited for
	//	try back.wait(host)        // `host` holds what `pick` wrote
	//
	// One `start`, then one `wait`, as often as needed. On the CPU path
	// `start` copies the buffer as it is then, so `wait` reads the same
	// values either way.
	type Readback<T> {
		internal handle uint
		internal source DeviceBuffer<T>

		internal def new(h uint, of DeviceBuffer<T>) {
			handle = h
			source = of
		}

		// Queues the copy behind the launches queued so far on the default
		// stream and returns at once. Fails when the copy of the last `start`
		// was not waited for, when the buffer or the readback was disposed, and
		// with the driver's error when the copy cannot be queued.
		def start() !none {
			fail __cuda_last_error() when __cuda_readback_start(handle, source.handle) != 0
			return none
		}

		// Blocks until the copy of the last `start` is done, while launches
		// queued after it keep running, and copies it into `into`, which must
		// have the buffer's length. Fails without a `start` before it, when
		// `into` does not match, and with the first error of the work waited
		// for.
		def wait(into T[]) !none {
			fail __cuda_last_error() when __cuda_readback_finish(handle, source.handle, into) != 0
			return none
		}

		// Waits for a copy still queued and frees the readback's memory; it
		// must not be used afterwards.
		def dispose() {
			return when handle == uint(0)
			__cuda_readback_free(handle)
			handle = uint(0)
		}
	}

	// Host memory the GPU copies from without the driver staging the bytes
	// first (page-locked memory; plain memory on the CPU path):
	// `DeviceBuffer.write(from HostBuffer, start, count, at)` queues such a copy
	// and returns in microseconds. Fill it ahead of time, off the path that
	// must not wait:
	//
	//	let cache = try gpu.hostBuffer<byte>(entries * entrySize)
	//	try cache.write(bytes, entry * entrySize)                    // any task
	//	try slots.write(cache, entry * entrySize, entrySize, slot)   // queued
	//
	// Page-locked memory is never swapped out and takes time to make (0.1 to
	// 0.7 s a GiB): make one buffer and reuse it.
	type HostBuffer<T> {
		internal handle uint
		internal length int

		internal def new(h uint, n int) {
			handle = h
			length = n
		}

		// Elements in the buffer.
		def len() int {
			return length
		}

		// Copies `from` into the buffer from element `at` on, after waiting for
		// the copies queued from the buffer so far. It may run on another task
		// than the one queueing copies, as long as no copy of the elements it
		// overwrites is queued while it runs. Fails when `from` does not fit at
		// `at`, and with the first error of the work waited for.
		def write(from T[], at int) !none {
			fail __cuda_last_error() when __cuda_host_write(handle, from, at) != 0
			return none
		}

		// Waits for the copies still queued from the buffer and frees its
		// memory; it must not be used afterwards.
		def dispose() {
			return when handle == uint(0)
			__cuda_host_free(handle)
			handle = uint(0)
		}
	}

	// An ordered queue of GPU work. A `cuda def` that declares a `Stream`
	// parameter queues its launch on it; `DeviceBuffer.writeAsync` and
	// `downloadAsync` queue copies. Work on different streams may overlap,
	// so a kernel reading what another stream writes waits for that stream
	// first. Without a stream, a launch whose arguments are all
	// DeviceBuffers and scalars is queued on a default stream, and
	// `download`, `write` and launches taking host arrays wait for it. On
	// the CPU path everything runs synchronously and `wait` returns at once.
	type Stream {
		internal handle uint

		internal def new(h uint) {
			handle = h
		}

		// Blocks until every launch and copy queued on the stream finished.
		// Fails with the first error of that work.
		def wait() !none {
			fail __cuda_last_error() when __cuda_stream_wait(handle) != 0
			return none
		}

		// Waits for the stream's work and releases it; the stream must not
		// be used afterwards.
		def dispose() {
			return when handle == uint(0)
			__cuda_stream_free(handle)
			handle = uint(0)
		}
	}

	// A new stream. Fails with the driver's error when the GPU cannot create
	// one (and under ADM_CUDA=gpu without a GPU).
	def stream() !Stream {
		let handle = __cuda_stream_create()
		fail __cuda_last_error() when handle == uint(0)
		return new Stream(handle)
	}

	// Copies `data` to the device and returns the buffer holding it.
	// Fails with the driver's error when the device memory cannot be allocated or filled.
	def upload<T>(data T[]) !DeviceBuffer<T> {
		let handle = __cuda_buffer_upload(data)
		fail __cuda_last_error() when handle == uint(0)
		return new DeviceBuffer<T>(handle, data.len())
	}

	// A device buffer of `count` elements, all zero, without copying anything from
	// the host: the buffer a kernel writes its output to. The zeros are written on
	// the launch queue, so kernels launched after this see them.
	// Fails for a negative count, with the driver's error when the device memory
	// cannot be allocated, and under ADM_CUDA=gpu without a GPU.
	def deviceBuffer<T>(count int) !DeviceBuffer<T> {
		// One element tells the runtime how large an element is.
		let sample T[]
		sample.len(1)
		let handle = __cuda_buffer_create(sample, count)
		fail __cuda_last_error() when handle == uint(0)
		return new DeviceBuffer<T>(handle, count)
	}

	// Page-locked host memory of `count` elements, all zero: see `HostBuffer`.
	// Fails for a negative count, with the driver's error when the memory
	// cannot be allocated, and under ADM_CUDA=gpu without a GPU.
	def hostBuffer<T>(count int) !HostBuffer<T> {
		// One element tells the runtime how large an element is.
		let sample T[]
		sample.len(1)
		let handle = __cuda_host_create(sample, count)
		fail __cuda_last_error() when handle == uint(0)
		return new HostBuffer<T>(handle, count)
	}

	// Whether kernels run on the GPU right now: the driver loaded and
	// ADM_CUDA does not force the CPU path.
	def available() bool {
		return __cuda_available()
	}

	// Name of the selected GPU (ADM_CUDA_DEVICE), or "" without one.
	def deviceName() string {
		return __cuda_device_name()
	}

	// Bytes of device memory free right now on the selected GPU, with what other
	// processes hold counted as used; 0 when kernels run on the CPU path.
	def freeMemory() int {
		return __cuda_free_memory()
	}
}
