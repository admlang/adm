partial module std.gpu {
	use std.testing

	check "Stream" {
		@test()
		def queuesCopiesInOrder() !none {
			let data float32[]
			data.len(256)
			let buf = try upload(data)
			let s = try stream()
			let fresh float32[]
			fresh.len(256)
			fresh.fill(float32(2.5))
			try buf.writeAsync(fresh, s)
			let back float32[]
			back.len(256)
			try buf.downloadAsync(back, s)
			try s.wait()
			assert back[0] == float32(2.5) && back[255] == float32(2.5)
			s.dispose()
			buf.dispose()
			return none
		}

		@test()
		def syncCopyWaitsForQueuedWork() !none {
			let data int[]
			data.len(64)
			let buf = try upload(data)
			let s = try stream()
			let ones int[]
			ones.len(64)
			ones.fill(1)
			try buf.writeAsync(ones, s)
			try s.wait()
			let back int[]
			back.len(64)
			try buf.download(back)
			assert back[63] == 1
			s.dispose()
			buf.dispose()
			return none
		}
	}

	check "DeviceBuffer" {
		// A buffer made on the device starts at zero, takes a kernel's output and
		// copies back like an uploaded one.
		@test()
		def isMadeOnTheDeviceWithZeros() !none {
			let buf = try deviceBuffer<float32>(1000)
			assert buf.len() == 1000
			let back float32[]
			back.len(1000)
			back.fill(float32(9))
			try buf.download(back)
			for let i = 0; i < 1000; i += 37 {
				assert back[i] == float32(0)
			}
			try fillWith(buf, float32(2.5))
			try buf.download(back)
			assert back[0] == float32(2.5) && back[999] == float32(2.5)
			let none0 = try deviceBuffer<int>(0)
			assert none0.len() == 0
			let refused = [false]
			makeNegativeOnDevice() onerror (err error) {
				refused[0] = true
				recover none
			}
			assert refused[0]
			return none
		}

		@test()
		def roundTripsThroughTheDevice() !none {
			let data float32[]
			data.len(1000)
			for let i = 0; i < 1000; i++ {
				data[i] = float32(i) * float32(0.5)
			}
			let buf = try upload(data)
			assert buf.len() == 1000
			let back float32[]
			back.len(1000)
			try buf.download(back)
			for let i = 0; i < 1000; i += 97 {
				assert back[i] == data[i]
			}
			// A write replaces the contents; the next download sees it.
			for let i = 0; i < 1000; i++ {
				data[i] = float32(-1)
			}
			try buf.write(data)
			try buf.download(back)
			assert back[0] == float32(-1) && back[999] == float32(-1)
			buf.dispose()
			return none
		}

		@test()
		def rejectsMismatchedLengths() !none {
			let data int[]
			data.len(8)
			let buf = try upload(data)
			let wrong int[]
			wrong.len(9)
			let failed = false
			buf.download(wrong) onerror (err error) {
				failed = true
				recover none
			}
			assert failed
			buf.dispose()
			return none
		}

		@test()
		def writesARangeAtAnOffset() !none {
			let data int[]
			data.len(100)
			let buf = try upload(data)
			let source int[]
			source.len(40)
			for let i = 0; i < 40; i++ {
				source[i] = i + 1
			}
			// A slice shares the source's memory: elements 10..19 land at 60..69.
			try buf.write(source[10:20], 60)
			try buf.write(source[0:1], 99)
			let nothing int[]
			try buf.write(nothing, 100)
			let back int[]
			back.len(100)
			try buf.download(back)
			assert back[59] == 0 && back[60] == 11 && back[69] == 20 && back[70] == 0
			assert back[0] == 0 && back[99] == 1
			buf.dispose()
			return none
		}

		@test()
		def rejectsARangeOutsideTheBuffer() !none {
			let data int[]
			data.len(8)
			let buf = try upload(data)
			let three int[]
			three.len(3)
			three.fill(7)
			let failures = 0
			for let at in [6, -1, 9] {
				buf.write(three, at) onerror (err error) {
					failures++
					recover none
				}
			}
			assert failures == 3
			let back int[]
			back.len(8)
			try buf.download(back)
			assert back[5] == 0 && back[7] == 0
			buf.dispose()
			return none
		}

		@test()
		def reportsThePathInUse() {
			// Whichever path this machine has, the name agrees with it.
			if available() {
				assert deviceName().len() > 0
				assert freeMemory() > 0
			} else {
				assert deviceName().len() == 0
				assert freeMemory() == 0
			}
		}
	}

	// Sets every element of `out` to `v`.
	cuda def fillWith(out DeviceBuffer<float32>, v float32) !none {
		int64_t i = blockIdx.x * blockDim.x + threadIdx.x;
		if (i < out_len) out[i] = v;
	}

	check "Readback" {
		@test()
		def leavesOutLaunchesQueuedAfterItsStart() !none {
			let zeros float32[]
			zeros.len(16)
			let buf = try upload(zeros)
			let back = try buf.readback()
			let host float32[]
			host.len(16)
			for let round = 1; round <= 20; round++ {
				try fillWith(buf, float32(round))
				try back.start()
				try fillWith(buf, float32(-round))
				try back.wait(host)
				assert host[0] == float32(round) && host[15] == float32(round)
				try buf.download(host)
				assert host[0] == float32(-round) && host[15] == float32(-round)
			}
			back.dispose()
			buf.dispose()
			return none
		}

		@test()
		def overlapsLaunchesThatLeaveTheBufferAlone() !none {
			let zeros float32[]
			zeros.len(16)
			let picks = try upload(zeros)
			let other = try upload(zeros)
			let back = try picks.readback(overlap = true)
			let host float32[]
			host.len(16)
			for let round = 1; round <= 20; round++ {
				try fillWith(picks, float32(round))
				try back.start()
				try fillWith(other, float32(-round))
				try back.wait(host)
				assert host[0] == float32(round) && host[15] == float32(round)
				try other.download(host)
				assert host[0] == float32(-round) && host[15] == float32(-round)
			}
			back.dispose()
			other.dispose()
			picks.dispose()
			return none
		}

		@test()
		def readsWhatWasQueuedBeforeItsStart() !none {
			let data float32[]
			data.len(16)
			data.fill(float32(1.5))
			let buf = try upload(data)
			let back = try buf.readback()
			let host float32[]
			host.len(16)
			try back.start()
			try back.wait(host)
			assert host[0] == float32(1.5) && host[15] == float32(1.5)
			// The same readback again, after the buffer changed.
			data.fill(float32(-3))
			try buf.write(data)
			try back.start()
			try back.wait(host)
			assert host[0] == float32(-3) && host[15] == float32(-3)
			back.dispose()
			buf.dispose()
			return none
		}

		@test()
		def refusesStartsAndWaitsOutOfOrder() !none {
			let data int[]
			data.len(8)
			let buf = try upload(data)
			let back = try buf.readback()
			let host int[]
			host.len(8)
			let failures = 0
			back.wait(host) onerror (err error) {
				failures++
				recover none
			}
			try back.start()
			back.start() onerror (err error) {
				failures++
				recover none
			}
			let wrong int[]
			wrong.len(9)
			back.wait(wrong) onerror (err error) {
				failures++
				recover none
			}
			assert failures == 3
			// The refused calls left the queued copy as it was.
			try back.wait(host)
			back.dispose()
			buf.dispose()
			return none
		}

		@test()
		def refusesADisposedBuffer() !none {
			let data int[]
			data.len(8)
			let buf = try upload(data)
			let back = try buf.readback()
			buf.dispose()
			let failures = 0
			back.start() onerror (err error) {
				failures++
				recover none
			}
			let again = buf.readback() onerror (err error) {
				failures++
				recover back
			}
			assert failures == 2 && again == back
			back.dispose()
			return none
		}

		@test()
		def readsAnEmptyBuffer() !none {
			let data int[]
			let buf = try upload(data)
			let back = try buf.readback()
			try back.start()
			try back.wait(data)
			back.dispose()
			buf.dispose()
			return none
		}
	}

	// Writes `rounds` values, one after the other, into the 8 elements of `cache`
	// from `at` on.
	def refillEntry(cache HostBuffer<int>, at int, rounds int) !none {
		let entry int[]
		entry.len(8)
		for let round = 1; round <= rounds; round++ {
			entry.fill(round)
			try cache.write(entry, at)
		}
		return none
	}

	def refusesRange(buf DeviceBuffer<int>, cache HostBuffer<int>, start int, count int, at int) bool {
		let failed = false
		buf.write(cache, start, count, at) onerror (err error) {
			failed = true
			recover none
		}
		return failed
	}

	def makeNegativeOnDevice() !none {
		let made = try deviceBuffer<int>(-1)
		made.dispose()
		return none
	}

	def makeNegative() !none {
		let made = try hostBuffer<int>(-1)
		made.dispose()
		return none
	}

	check "HostBuffer" {
		@test()
		def queuesCopiesOfARange() !none {
			let cache = try hostBuffer<float32>(32)
			assert cache.len() == 32
			let zeros float32[]
			zeros.len(16)
			let buf = try upload(zeros)
			let four float32[]
			four.len(4)
			let back float32[]
			back.len(16)
			for let round = 1; round <= 20; round++ {
				// The write waits for the copy queued from the buffer the round before.
				four.fill(float32(round))
				try cache.write(four, 8)
				try fillWith(buf, float32(-round))
				try buf.write(cache, 8, 4, 2)
				try buf.download(back)
				assert back[1] == float32(-round) && back[2] == float32(round) && back[5] == float32(round) && back[6] == float32(-round)
			}
			// What was never written is zero.
			try buf.write(cache, 0, 8, 8)
			try buf.download(back)
			assert back[8] == float32(0.0) && back[15] == float32(0.0) && back[2] == float32(20.0)
			cache.dispose()
			buf.dispose()
			return none
		}

		@test()
		def aTaskRefillsWhileAnotherQueuesCopies() !none {
			let cache = try hostBuffer<int>(64)
			let zeros int[]
			zeros.len(64)
			let buf = try upload(zeros)
			let refill = async refillEntry(cache, 56, 50)
			let first int[]
			first.len(8)
			first.fill(7)
			try cache.write(first, 0)
			for let round = 0; round < 50; round++ {
				try buf.write(cache, 0, 8, (round % 7) * 8)
			}
			try await refill
			try buf.write(cache, 56, 8, 56)
			let back int[]
			back.len(64)
			try buf.download(back)
			assert back[0] == 7 && back[55] == 7 && back[56] == 50 && back[63] == 50
			cache.dispose()
			buf.dispose()
			return none
		}

		// A copy beside the launches queued after it: a launch behind `join` reads
		// what it wrote, and the next write into the host buffer waits for it.
		@test()
		def overlapsLaunchesQueuedAfterIt() !none {
			let cache = try hostBuffer<float32>(16)
			let zeros float32[]
			zeros.len(16)
			let arena = try upload(zeros)
			let other = try upload(zeros)
			let values float32[]
			values.len(16)
			let back float32[]
			back.len(16)
			for let round = 1; round <= 20; round++ {
				values.fill(float32(round))
				try cache.write(values, 0)
				try fillWith(arena, float32(-1.0))
				try arena.write(cache, 0, 16, 0, overlap = true)
				try fillWith(other, float32(-round))
				try arena.join()
				try arena.download(back)
				assert back[0] == float32(round) && back[15] == float32(round)
				try other.download(back)
				assert back[0] == float32(-round)
			}
			try arena.join()
			cache.dispose()
			other.dispose()
			arena.dispose()
			return none
		}

		@test()
		def refusesWhatDoesNotFit() !none {
			let cache = try hostBuffer<int>(8)
			let zeros int[]
			zeros.len(4)
			let buf = try upload(zeros)
			let three int[]
			three.len(3)
			let failures = 0
			for let at in [6, -1, 9] {
				cache.write(three, at) onerror (err error) {
					failures++
					recover none
				}
			}
			// Outside the host buffer, then outside the device buffer.
			failures++ when refusesRange(buf, cache, 6, 3, 0)
			failures++ when refusesRange(buf, cache, -1, 2, 0)
			failures++ when refusesRange(buf, cache, 0, -1, 0)
			failures++ when refusesRange(buf, cache, 0, 5, 0)
			failures++ when refusesRange(buf, cache, 0, 2, 3)
			failures++ when refusesRange(buf, cache, 0, 1, -1)
			makeNegative() onerror (err error) {
				failures++
				recover none
			}
			assert failures == 10
			try buf.write(cache, 4, 4, 0)
			cache.dispose()
			buf.dispose()
			return none
		}
	}
}
