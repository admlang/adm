partial module std.gpu {
	use std.testing

	check "Stream" {
		@test()
		def queuesCopiesInOrder() !none {
			let data float32[]
			data.len(256)
			let buf = try upload(data)
			let s = try stream()
			let fresh float32[]
			fresh.len(256)
			fresh.fill(float32(2.5))
			try buf.writeAsync(fresh, s)
			let back float32[]
			back.len(256)
			try buf.downloadAsync(back, s)
			try s.wait()
			assert back[0] == float32(2.5) && back[255] == float32(2.5)
			s.dispose()
			buf.dispose()
			return none
		}

		@test()
		def syncCopyWaitsForQueuedWork() !none {
			let data int[]
			data.len(64)
			let buf = try upload(data)
			let s = try stream()
			let ones int[]
			ones.len(64)
			ones.fill(1)
			try buf.writeAsync(ones, s)
			try s.wait()
			let back int[]
			back.len(64)
			try buf.download(back)
			assert back[63] == 1
			s.dispose()
			buf.dispose()
			return none
		}
	}

	check "DeviceBuffer" {
		@test()
		def roundTripsThroughTheDevice() !none {
			let data float32[]
			data.len(1000)
			for let i = 0; i < 1000; i++ {
				data[i] = float32(i) * float32(0.5)
			}
			let buf = try upload(data)
			assert buf.len() == 1000
			let back float32[]
			back.len(1000)
			try buf.download(back)
			for let i = 0; i < 1000; i += 97 {
				assert back[i] == data[i]
			}
			// A write replaces the contents; the next download sees it.
			for let i = 0; i < 1000; i++ {
				data[i] = float32(-1)
			}
			try buf.write(data)
			try buf.download(back)
			assert back[0] == float32(-1) && back[999] == float32(-1)
			buf.dispose()
			return none
		}

		@test()
		def rejectsMismatchedLengths() !none {
			let data int[]
			data.len(8)
			let buf = try upload(data)
			let wrong int[]
			wrong.len(9)
			let failed = false
			buf.download(wrong) onerror (err error) {
				failed = true
				recover none
			}
			assert failed
			buf.dispose()
			return none
		}

		@test()
		def reportsThePathInUse() {
			// Whichever path this machine has, the name agrees with it.
			if available() {
				assert deviceName().len() > 0
			} else {
				assert deviceName().len() == 0
			}
		}
	}
}
