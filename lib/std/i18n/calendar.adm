partial module std.i18n {
	use (
		std.i18n.calendars
		std.time::(Date, fromEpochDay)
	)

	// Calendar is the calendar system dates are counted in when they are formatted
	// or parsed for a locale.
	enum Calendar {
		Gregorian
		Buddhist
		Islamic // observed (astronomical), as ICU computes it
		Hebrew
		Japanese
		Chinese
		Coptic
		Dangi             // Korean
		Ethiopic          // Amete Mihret
		EthiopicAmeteAlem // Amete Alem
		Indian            // Saka
		IslamicCivil      // tabular, Friday epoch
		IslamicUmalqura   // Saudi Arabia's published months, tabular outside AH 1300-1600
		IslamicTbla       // tabular, Thursday epoch
		IslamicRgsa       // Saudi Arabia sighting; ICU computes it like Islamic
		Iso8601
		Persian           // Solar Hijri
		Roc               // Republic of China (Minguo)
	}

	// CalendarDate is a day in a calendar system: its year, month and day as
	// that calendar counts them, and its era.
	//
	//     let d = new CalendarDate(new Date(2026, 10, 1), Calendar.Hebrew)
	//     d.year          // 5787
	//     d.monthCode     // "M01" (Tishrei)
	//     d.toDate()      // back to 2026-10-01
	type CalendarDate {
		calendar  Calendar
		year      int // the calendar's own year numbering (the related ISO year for Chinese and Dangi)
		month     int // ordinal: 1 to 12, or 13 in a year with a leap month or a 13th month
		monthCode string // "M01" to "M13"; a leap month "M05L" (Hebrew Adar I, Chinese leap months)
		day       int
		era       string // "ce", "bce", "reiwa", "ah", ...; "" for Chinese, Dangi and ISO 8601
		eraYear   int // the year within the era

		internal epochDay int64
		internal eraIndex int

		// New converts the ISO date to the calendar.
		def new(date Date, calendar Calendar) {
			self.calendar = calendar
			epochDay = date.epochDay()
			let f = calendars.fieldsOf(calendar, epochDay)
			year = f.year
			month = f.month
			monthCode = f.monthCode
			day = f.day
			era = calendar == Calendar.Iso8601 ?? ("", f.era)
			eraYear = f.eraYear
			eraIndex = f.eraIndex
		}

		// ToDate returns the same day in the ISO calendar.
		def toDate() Date {
			return fromEpochDay(epochDay)
		}

		// MonthsInYear returns how many months the date's year has (12, or 13
		// in Coptic, Ethiopic, and Hebrew and Chinese leap years).
		def monthsInYear() int {
			return calendars.monthsIn(calendar, year)
		}

		// DaysInMonth returns the length of the date's month.
		def daysInMonth() int {
			return calendars.daysIn(calendar, year, month)
		}

		// InLeapYear reports whether the date's year is longer than the
		// calendar's common year (a leap day, or a leap month).
		def inLeapYear() bool {
			return calendars.leapYear(calendar, year)
		}

		// PlusDays returns the date n days later in the same calendar.
		def plusDays(n int) CalendarDate {
			return new CalendarDate(fromEpochDay(epochDay + int64(n)), calendar)
		}

		// Str writes the date with its calendar: "5787-M01-20[u-ca=hebrew]".
		def str() string {
			return year.str() + "-" + monthCode + "-" + (day < 10 ?? ("0", "")) + day.str() + "[u-ca=" + calendarId(calendar) + "]"
		}
	}

	// calendarDate returns the day a calendar's year, month code and day
	// name. Fails when the year has no such month (a leap month the year
	// lacks) or the month no such day.
	def calendarDate(calendar Calendar, year int, monthCode string, day int) !CalendarDate {
		let month = calendars.ordinalOf(calendar, year, monthCode)
		fail "calendar date: " + calendarId(calendar) + " year " + year.str() + " has no month " + monthCode when month == 0
		let length = calendars.daysIn(calendar, year, month)
		fail "calendar date: " + calendarId(calendar) + " " + year.str() + "-" + monthCode + " has " + length.str() + " days, not " + day.str() when day < 1 || day > length
		return new CalendarDate(fromEpochDay(calendars.dayOf(calendar, year, month, day)), calendar)
	}

	// calendarId returns the BCP 47 name of a calendar ("gregory", "islamic-civil").
	def calendarId(c Calendar) string {
		match c {
			case Calendar.Gregorian:
				return "gregory"
			case Calendar.Buddhist:
				return "buddhist"
			case Calendar.Islamic:
				return "islamic"
			case Calendar.Hebrew:
				return "hebrew"
			case Calendar.Japanese:
				return "japanese"
			case Calendar.Chinese:
				return "chinese"
			case Calendar.Coptic:
				return "coptic"
			case Calendar.Dangi:
				return "dangi"
			case Calendar.Ethiopic:
				return "ethiopic"
			case Calendar.EthiopicAmeteAlem:
				return "ethioaa"
			case Calendar.Indian:
				return "indian"
			case Calendar.IslamicCivil:
				return "islamic-civil"
			case Calendar.IslamicUmalqura:
				return "islamic-umalqura"
			case Calendar.IslamicTbla:
				return "islamic-tbla"
			case Calendar.IslamicRgsa:
				return "islamic-rgsa"
			case Calendar.Iso8601:
				return "iso8601"
			case Calendar.Persian:
				return "persian"
			default:
				return "roc"
		}
	}

	// calendarNamed returns the calendar a BCP 47 name (or an alias:
	// "gregorian", "ethiopic-amete-alem", "islamicc") names, or none.
	def calendarNamed(id string) ?Calendar {
		let name = id.lower()
		name = "gregory" when name == "gregorian"
		name = "ethioaa" when name == "ethiopic-amete-alem"
		name = "islamic-civil" when name == "islamicc"
		for let c in allCalendars {
			return c when calendarId(c) == name
		}
		return none
	}

	internal let allCalendars = Calendar[Calendar.Gregorian, Calendar.Buddhist, Calendar.Islamic, Calendar.Hebrew, Calendar.Japanese, Calendar.Chinese, Calendar.Coptic, Calendar.Dangi, Calendar.Ethiopic, Calendar.EthiopicAmeteAlem, Calendar.Indian, Calendar.IslamicCivil, Calendar.IslamicUmalqura, Calendar.IslamicTbla, Calendar.IslamicRgsa, Calendar.Iso8601, Calendar.Persian, Calendar.Roc]
}
