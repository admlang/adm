// Generated by ~/.cache/adm-scratch/i18n/kit/gen_calendar_cases.js: Temporal and ICU 78.3 (node 26.10.0).
// Japanese eras before 1873 are not compared: Temporal starts Meiji then and has no earlier eras,
// std follows CLDR's 237 eras as ICU4C does. Chinese and Dangi stay in 1900-2100, where Temporal
// uses the published data; outside it Temporal approximates and std computes astronomically.
partial module std.i18n {
	use std.testing
	use std.time::(fromEpochDay)

	check "Calendars against Temporal" {
		def same(c Calendar, days int64[], want string[]) int {
			let bad = 0
			for let i in 0..days.len() {
				let d = new CalendarDate(fromEpochDay(days[i]), c)
				let expect = want[i]
				let era = expect.split("|")[4] == "*" ?? ("*|0", d.era + "|" + d.eraYear.str())
				let got = d.year.str() + "|" + d.monthCode + "|" + d.month.str() + "|" + d.day.str() + "|" + era + "|" + d.monthsInYear().str() + "|" + d.daysInMonth().str() + "|{d.inLeapYear()}"
				let back = calendarDate(c, d.year, d.monthCode, d.day) onerror recover d
				if got != expect || back.toDate().epochDay() != days[i] {
					println(calendarId(c) + " {days[i]}: got " + got + " want " + expect + " back {back.toDate().epochDay()}")
					bad++
				}
			}
			return bad
		}

		def sameYmd(c Calendar, days int64[], want string[]) int {
			let bad = 0
			for let i in 0..days.len() {
				let d = new CalendarDate(fromEpochDay(days[i]), c)
				let got = d.year.str() + "|" + d.month.str() + "|" + d.day.str()
				let back = calendarDate(c, d.year, d.monthCode, d.day) onerror recover d
				if got != want[i] || back.toDate().epochDay() != days[i] {
					println(calendarId(c) + " {days[i]}: got " + got + " want " + want[i] + " back {back.toDate().epochDay()}")
					bad++
				}
			}
			return bad
		}

