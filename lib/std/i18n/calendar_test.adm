partial module std.i18n {
	use (
		std.testing
		std.time::(Date)
	)

	// Expected values from Temporal (node 26.10) and, for pre-Meiji eras, ICU4C.
	check "Calendar dates" {
		@test()
		def namesCalendars() {
			assert calendarId(Calendar.Gregorian) == "gregory" && calendarId(Calendar.EthiopicAmeteAlem) == "ethioaa"
			let g = calendarNamed("gregorian")
			assert !(g is none) && g == Calendar.Gregorian
			let c = calendarNamed("islamicc")
			assert !(c is none) && c == Calendar.IslamicCivil
			assert calendarNamed("mayan") is none
		}

		@test()
		def buildsDatesFromFields() !none {
			let leap = try calendarDate(Calendar.Chinese, 2025, "M06L", 1)
			assert leap.toDate().str() == "2025-07-25"
			assert leap.month == 7 && leap.monthsInYear() == 13 && leap.inLeapYear()
			let adarI = try calendarDate(Calendar.Hebrew, 5784, "M05L", 30)
			assert adarI.toDate().str() == "2024-03-10"
			assert calendarDate(Calendar.Hebrew, 5785, "M05L", 1) is error
			assert calendarDate(Calendar.Gregorian, 2026, "M02", 29) is error
			assert calendarDate(Calendar.Coptic, 1742, "M13", 6) is error
			return none
		}

		@test()
		def movesAndWrites() {
			let d = new CalendarDate(new Date(2026, 10, 1), Calendar.Hebrew)
			assert d.str() == "5787-M01-20[u-ca=hebrew]"
			assert d.plusDays(30).str() == "5787-M02-20[u-ca=hebrew]"
			assert d.daysInMonth() == 30
		}

		@test()
		def followsCldrJapaneseEras() {
			let keio = new CalendarDate(new Date(1868, 10, 22), Calendar.Japanese)
			assert keio.era == "231" && keio.eraYear == 4
			let meiji = new CalendarDate(new Date(1870, 6, 1), Calendar.Japanese)
			assert meiji.era == "meiji" && meiji.eraYear == 3
			let reiwa = new CalendarDate(new Date(2026, 10, 1), Calendar.Japanese)
			assert reiwa.era == "reiwa" && reiwa.eraYear == 8 && reiwa.year == 2026
		}
	}
}
