internal partial module std.i18n.calendars {
	use std.testing

	// Reference values of Calendrical Calculations' Lisp code, as ICU4X's
	// calendrical_calculations tests carry them: 33 moments from 587 BCE to
	// 2094, most of them outside the published Chinese years.
	check "Astronomy against Calendrical Calculations" {
		let rds = int[-214193, -61387, 25469, 49217, 171307, 210155, 253427, 369740, 400085, 434355, 452605, 470160, 473837, 507850, 524156, 544676, 567118, 569477, 601716, 613424, 626596, 645554, 664224, 671401, 694799, 704424, 708842, 709409, 709580, 727274, 728714, 744313, 764652]

		def near(got float, want float) bool {
			return (got - want).abs() <= want.abs() * 1e-7
		}

		@test()
		def ephemerisCorrections() {
			let want = float[0.2141698518518519, 0.14363257367091617, 0.11444429141515931, 0.10718320232694657, 0.06949806372337948, 0.05750681225096574, 0.04475812294339828, 0.017397257248984357, 0.012796798891589713, 0.008869421568656596, 0.007262628304956149, 0.005979700330107665, 0.005740181544555194, 0.0038756713829057486, 0.0031575183970409424, 0.0023931271439193596, 0.0017316532690131062, 0.0016698814624679225, 6.150149905066665E-4, 1.7716816592592584E-4, 1.016458530046296E-4, 1.7152348357870364E-4, 1.3696411598154996E-4, 6.153868613872005E-5, 1.4168812498149138E-5, 2.767107192307865E-4, 2.9636802723679223E-4, 3.028239003387824E-4, 3.028239003387824E-4, 6.75088347496296E-4, 7.128242445629627E-4, 9.633446296296293E-4, 0.0029138888888888877]
			for let i in 0..rds.len() {
				assert near(ephemerisCorrection(float(rds[i])), want[i])
			}
		}

		@test()
		def solarLongitudes() {
			let want = float[119.47343190503307, 254.2489611345809, 181.43599673954304, 188.66392267483752, 289.0915666249348, 59.11974154849304, 228.31455470912624, 34.46076992887538, 63.18799596698955, 2.4575913259759545, 350.475934906397, 13.498220866371412, 37.403920329437824, 81.02813003520714, 313.86049865107634, 19.95443016415811, 176.05943166351062, 344.92295174632454, 79.96492181924987, 99.30231774304411, 121.53530416596914, 88.56742889029556, 129.289884101192, 6.146910693067184, 28.25199345351575, 151.7806330331332, 185.94586701843946, 28.55560762159439, 193.3478921554779, 357.15125499424175, 336.1706924761211, 228.18487947607719, 116.43935225951282]
			for let i in 0..rds.len() {
				let got = solarLongitude(julianCenturies(float(rds[i]) + 0.5))
				println("RD {rds[i]}: got {got} want {want[i]}") unless near(got, want[i])
				assert near(got, want[i])
			}
		}

		@test()
		def newMoons() {
			let want = float[-214174.60582868298, -61382.99532831192, 25495.80977675628, 49238.50244808781, 171318.43531326813, 210180.69184966758, 253442.85936730343, 369763.74641362444, 400091.5783431683, 434376.5781067696, 452627.1919724953, 470167.57836052414, 473858.8532764285, 507878.6668429224, 524179.2470620894, 544702.7538732041, 567146.5131819838, 569479.2032589674, 601727.0335578924, 613449.7621296605, 626620.3698017383, 645579.0767485882, 664242.8867184789, 671418.970538101, 694807.5633711396, 704433.4911827276, 708863.5970001582, 709424.4049294397, 709602.0826867367, 727291.2094001573, 728737.4476913146, 744329.5739998783, 764676.1912733881]
			for let i in 0..rds.len() {
				let got = newMoonAtOrAfter(float(rds[i]))
				println("RD {rds[i]}: got {got} want {want[i]}") unless near(got, want[i])
				assert near(got, want[i])
			}
		}
	}
}
