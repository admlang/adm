// Day-count conversions for the CLDR calendar systems: each calendar's year,
// ordinal month and day for an epoch day (days since 1970-01-01, proleptic
// Gregorian), and back. Algorithms of Calendrical Calculations; the Chinese,
// Korean and Umm al-Qura years come from chinese.adm and tables.adm.

internal partial module std.i18n.calendars {
	use (
		std.i18n.cldr::(tables)
		std.i18n::(Calendar)
		std.time::(Date, fromEpochDay, isLeapYear)
	)

	// Fields are a date in a calendar. month is the ordinal month (1 to 13);
	// monthCode names it ("M05L" for a leap month); eraIndex is the CLDR era
	// number its names are looked up by (-1 for calendars without eras).
	struct Fields {
		year      int
		month     int
		monthCode string
		day       int
		era       string
		eraYear   int
		eraIndex  int
	}

	// RD of the calendars' epochs (day 1 of year 1).
	const copticEpoch = 103605 // 284-08-29 Julian
	const ethiopicEpoch = 2796 // 8-08-29 Julian
	const persianEpoch = 226896 // 622-03-19 Julian
	const hebrewEpoch = -1373427 // -3761-10-07 Julian
	const islamicCivilEpoch = 227015 // 622-07-16 Julian (Friday)
	const islamicAstronomicalEpoch = 227014 // 622-07-15 Julian (Thursday)

	// The Persian years whose leap day the 33-year rule misplaces (it falls in
	// the next year): years 1502 to 2987 AP.
	let persianNonLeapCorrection = int[1502, 1601, 1634, 1667, 1700, 1733, 1766, 1799, 1832, 1865, 1898, 1931, 1964, 1997, 2030, 2059, 2063, 2096, 2129, 2158, 2162, 2191, 2195, 2224, 2228, 2257, 2261, 2290, 2294, 2323, 2327, 2356, 2360, 2389, 2393, 2422, 2426, 2455, 2459, 2488, 2492, 2521, 2525, 2554, 2558, 2587, 2591, 2620, 2624, 2653, 2657, 2686, 2690, 2719, 2723, 2748, 2752, 2756, 2781, 2785, 2789, 2818, 2822, 2847, 2851, 2855, 2880, 2884, 2888, 2913, 2917, 2921, 2946, 2950, 2954, 2979, 2983, 2987]

	// Fields returns the date of the epoch day in the calendar.
	def fieldsOf(c Calendar, day int64) Fields {
		let rd = int(day) + rdOffset
		match c {
			case Calendar.Coptic:
				return withEra(c, arithmetic13(rd, copticEpoch))
			case Calendar.Ethiopic, Calendar.EthiopicAmeteAlem:
				return withEra(c, arithmetic13(rd, ethiopicEpoch))
			case Calendar.Indian:
				return withEra(c, indianFromDay(day))
			case Calendar.Persian:
				return withEra(c, persianFromRd(rd))
			case Calendar.Hebrew:
				return withEra(c, hebrewFromRd(rd))
			case Calendar.IslamicCivil, Calendar.IslamicTbla:
				return withEra(c, tabularIslamicFromRd(rd, epochOf(c)))
			case Calendar.IslamicUmalqura:
				return withEra(c, ummAlQuraFromDay(day))
			case Calendar.Islamic, Calendar.IslamicRgsa:
				return withEra(c, observedIslamicFromDay(day))
			case Calendar.Chinese, Calendar.Dangi:
				return lunisolarFromDay(c == Calendar.Dangi, day)
			default:
				let d = fromEpochDay(day)
				return withEra(c, Fields{year: d.year, month: d.month, monthCode: code(d.month), day: d.day})
		}
	}

	// DayOf returns the epoch day of a year, ordinal month and day of the
	// calendar (the year as Fields.year counts it), all in range.
	def dayOf(c Calendar, year int, month int, day int) int64 {
		match c {
			case Calendar.Coptic:
				return int64(fixedFromArithmetic13(year, month, day, copticEpoch) - rdOffset)
			case Calendar.Ethiopic:
				return int64(fixedFromArithmetic13(year, month, day, ethiopicEpoch) - rdOffset)
			case Calendar.EthiopicAmeteAlem:
				return int64(fixedFromArithmetic13(year - 5500, month, day, ethiopicEpoch) - rdOffset)
			case Calendar.Indian:
				return indianStart(year) + int64(daysBeforeIndianMonth(year, month) + day - 1)
			case Calendar.Persian:
				return int64(fixedFromPersian(year, month, day) - rdOffset)
			case Calendar.Hebrew:
				return int64(fixedFromHebrew(year, month, day) - rdOffset)
			case Calendar.IslamicCivil, Calendar.IslamicTbla:
				return int64(fixedFromTabularIslamic(year, month, day, epochOf(c)) - rdOffset)
			case Calendar.IslamicUmalqura:
				return ummAlQuraDay(year, month, day)
			case Calendar.Islamic, Calendar.IslamicRgsa:
				return observedIslamicDay(year, month, day)
			case Calendar.Chinese, Calendar.Dangi:
				let y = eastAsianYear(c == Calendar.Dangi, year)
				let total = 0
				for let m in 1..month {
					total += monthLength(y, m)
				}
				return int64(y.start + total + day - 1)
			default:
				return new Date(isoYear(c, year), month, day).epochDay()
		}
	}

	// MonthsIn returns the months the calendar's year has.
	def monthsIn(c Calendar, year int) int {
		match c {
			case Calendar.Coptic, Calendar.Ethiopic, Calendar.EthiopicAmeteAlem:
				return 13
			case Calendar.Hebrew:
				return hebrewLeap(year) ?? (13, 12)
			case Calendar.Chinese, Calendar.Dangi:
				return eastAsianYear(c == Calendar.Dangi, year).months
			default:
				return 12
		}
	}

	// DaysIn returns the length of an ordinal month.
	def daysIn(c Calendar, year int, month int) int {
		return int(dayOfNextMonth(c, year, month) - dayOf(c, year, month, 1))
	}

	def dayOfNextMonth(c Calendar, year int, month int) int64 {
		return dayOf(c, year + 1, 1, 1) when month >= monthsIn(c, year)
		return dayOf(c, year, month + 1, 1)
	}

	// LeapYear reports whether the year is longer than the calendar's common
	// year (a leap day or a leap month).
	def leapYear(c Calendar, year int) bool {
		match c {
			case Calendar.Chinese, Calendar.Dangi:
				return eastAsianYear(c == Calendar.Dangi, year).months == 13
			case Calendar.Hebrew:
				return hebrewLeap(year)
			default:
				let first = dayOf(c, year, 1, 1)
				let next = dayOf(c, year + 1, 1, 1)
				let common = (c := Calendar.IslamicCivil || Calendar.IslamicTbla || Calendar.IslamicUmalqura || Calendar.Islamic || Calendar.IslamicRgsa) ?? (354, 365)
				return next - first > int64(common)
		}
	}

	// MonthCode returns the code of an ordinal month: "M01" to "M13", a leap
	// month "M05L" (Hebrew Adar I, a Chinese leap month).
	def monthCodeOf(c Calendar, year int, month int) string {
		if c == Calendar.Hebrew && hebrewLeap(year) {
			return "M05L" when month == 6
			return code(month - 1) when month > 6
		}
		if c := Calendar.Chinese || Calendar.Dangi {
			let leap = eastAsianYear(c == Calendar.Dangi, year).leap
			return code(month - 1) + "L" when leap != 0 && month == leap
			return code(month - 1) when leap != 0 && month > leap
		}
		return code(month)
	}

	// OrdinalOf returns the ordinal month a month code names in the year, or
	// 0 when the year has no such month.
	def ordinalOf(c Calendar, year int, monthCode string) int {
		for let m in 1..monthsIn(c, year) + 1 {
			return m when monthCodeOf(c, year, m) == monthCode
		}
		return 0
	}

	def code(month int) string {
		return month < 10 ?? ("M0" + month.str(), "M" + month.str())
	}

	// The ISO year of a Gregorian-based calendar's year.
	def isoYear(c Calendar, year int) int {
		match c {
			case Calendar.Buddhist:
				return year - 543
			case Calendar.Roc:
				return year + 1911
			default:
				return year
		}
	}

	def epochOf(c Calendar) int {
		return c == Calendar.IslamicTbla ?? (islamicAstronomicalEpoch, islamicCivilEpoch)
	}

	// WithEra fills in the calendar's year numbering and era: f holds the
	// arithmetic (ISO for Gregorian-based) year.
	def withEra(c Calendar, f Fields) Fields {
		let out = Fields{year: f.year, month: f.month, monthCode: f.monthCode, day: f.day, eraIndex: -1}
		match c {
			case Calendar.Gregorian:
				out.era = f.year > 0 ?? ("ce", "bce")
				out.eraYear = f.year > 0 ?? (f.year, 1 - f.year)
				out.eraIndex = f.year > 0 ?? (1, 0)
			case Calendar.Buddhist:
				out.year = f.year + 543
				out.era = "be"
				out.eraYear = out.year
				out.eraIndex = 0
			case Calendar.Roc:
				out.year = f.year - 1911
				out.era = out.year > 0 ?? ("roc", "broc")
				out.eraYear = out.year > 0 ?? (out.year, 1 - out.year)
				out.eraIndex = out.year > 0 ?? (1, 0)
			case Calendar.Japanese:
				japaneseEra(out, f.year, f.month, f.day)
			case Calendar.Coptic:
				out.era = "am"
				out.eraYear = f.year
				out.eraIndex = f.year > 0 ?? (1, 0)
			case Calendar.Ethiopic:
				out.era = f.year > 0 ?? ("am", "aa")
				out.eraYear = f.year > 0 ?? (f.year, f.year + 5500)
				out.eraIndex = f.year > 0 ?? (1, 0)
			case Calendar.EthiopicAmeteAlem:
				out.year = f.year + 5500
				out.era = "aa"
				out.eraYear = out.year
				out.eraIndex = 0
			case Calendar.Indian:
				out.era = "shaka"
				out.eraYear = f.year
				out.eraIndex = 0
			case Calendar.Persian:
				out.era = "ap"
				out.eraYear = f.year
				out.eraIndex = 0
			case Calendar.Hebrew:
				out.era = "am"
				out.eraYear = f.year
				out.eraIndex = 0
			case Calendar.IslamicCivil, Calendar.IslamicTbla, Calendar.IslamicUmalqura, Calendar.Islamic, Calendar.IslamicRgsa:
				out.era = f.year > 0 ?? ("ah", "bh")
				out.eraYear = f.year > 0 ?? (f.year, 1 - f.year)
				out.eraIndex = 0
			default:
				out.era = ""
				out.eraYear = f.year
		}
		return out
	}

	// Japanese eras from CLDR: the latest era that has started, its year
	// counted from 1; before the first (Taika, 645) years count back from it.
	def japaneseEra(out Fields, year int, month int, day int) {
		let eras = japaneseEras.list()
		let index = 0
		for let i in 0..eras.len() {
			let e = eras[i]
			index = i when year > e.year || year == e.year && (month > e.month || month == e.month && day >= e.day)
		}
		let e = eras[index]
		out.eraIndex = index
		out.era = e.code
		out.eraYear = year - e.year + 1
	}

	struct Era {
		year  int
		month int
		day   int
		code  string
	}

	// JapaneseEras reads the CLDR era list once.
	type JapaneseEras {
		eras  Era[]
		ready bool

		atomic def list() Era[] {
			return eras when ready
			ready = true
			eras = Era[]
			let raw = tables.values("supplemental/calendarData", "root", "calendarData/japanese/eras")
			let i = 0
			for raw.hasKey(i.str() + "/_start") {
				let start = raw[i.str() + "/_start"].split("-")
				let codeKey = i.str() + "/_code"
				let name = raw.hasKey(codeKey) ?? (raw[codeKey], i.str())
				eras.push(Era{year: start[0].toInt<int>(), month: start[1].toInt<int>(), day: start[2].toInt<int>(), code: name})
				i++
			}
			return eras
		}
	}

	let japaneseEras = new JapaneseEras()

	// Coptic and Ethiopic: twelve 30-day months and a 5- or 6-day thirteenth;
	// every fourth year (year mod 4 = 3) is a leap year.
	def arithmetic13(rd int, epoch int) Fields {
		let year = floorDiv(4 * (rd - epoch) + 1463, 1461)
		let month = (rd - fixedFromArithmetic13(year, 1, 1, epoch)) / 30 + 1
		let day = rd + 1 - fixedFromArithmetic13(year, month, 1, epoch)
		return Fields{year: year, month: month, monthCode: code(month), day: day}
	}

	def fixedFromArithmetic13(year int, month int, day int, epoch int) int {
		return epoch - 1 + 365 * (year - 1) + floorDiv(year, 4) + 30 * (month - 1) + day
	}

	// Indian national (Saka) calendar: the year starts on March 22 (21 in a
	// Gregorian leap year), 78 years after the Gregorian one's start.
	def indianStart(year int) int64 {
		let g = year + 78
		return new Date(g, 3, isLeapYear(g) ?? (21, 22)).epochDay()
	}

	def daysBeforeIndianMonth(year int, month int) int {
		let first = isLeapYear(year + 78) ?? (31, 30)
		return 0 when month == 1
		return first + 31 * (month - 2) when month <= 7
		return first + 31 * 5 + 30 * (month - 7)
	}

	def indianFromDay(day int64) Fields {
		let year = fromEpochDay(day).year - 78
		year -= 1 when day < indianStart(year)
		let offset = int(day - indianStart(year))
		let month = 12
		for let m in 2..13 {
			if offset < daysBeforeIndianMonth(year, m) {
				month = m - 1
				break
			}
		}
		return Fields{year: year, month: month, monthCode: code(month), day: offset - daysBeforeIndianMonth(year, month) + 1}
	}

	// Persian (Solar Hijri): the 33-year rule, corrected for the years the
	// astronomical rule moves the leap day.
	def persianCorrected(year int) bool {
		let lo = 0
		let hi = persianNonLeapCorrection.len()
		for lo < hi {
			let mid = (lo + hi) / 2
			return true when persianNonLeapCorrection[mid] == year
			if persianNonLeapCorrection[mid] < year {
				lo = mid + 1
			} else {
				hi = mid
			}
		}
		return false
	}

	def fixedFromPersian(year int, month int, day int) int {
		let newYear = persianEpoch - 1 + 365 * (year - 1) + floorDiv(8 * year + 21, 33)
		newYear -= 1 when year > persianNonLeapCorrection[0] && persianCorrected(year - 1)
		let before = month <= 7 ?? (31 * (month - 1), 30 * (month - 1) + 6)
		return newYear - 1 + before + day
	}

	def persianFromRd(rd int) Fields {
		let year = 1 + floorDiv(33 * (rd - persianEpoch + 1) + 3, 12053)
		let dayOfYear = 1 + rd - fixedFromPersian(year, 1, 1)
		if dayOfYear == 366 && year >= persianNonLeapCorrection[0] && persianCorrected(year) {
			year++
			dayOfYear = 1
		}
		let month = dayOfYear <= 186 ?? ((dayOfYear + 30) / 31, (dayOfYear - 6 + 29) / 30)
		let day = rd - fixedFromPersian(year, month, 1) + 1
		return Fields{year: year, month: month, monthCode: code(month), day: day}
	}

	// Hebrew: months by the molad, the four postponements of the new year.
	// Months are counted from Tishrei: Tishrei 1 ... Elul 12, with Adar I as
	// month 6 of a leap year.
	def hebrewLeap(year int) bool {
		let r = (7 * year + 1) % 19
		return (r < 0 ?? (r + 19, r)) < 7
	}

	def hebrewElapsed(year int) int {
		let monthsElapsed = floorDiv(235 * year - 234, 19)
		let partsElapsed = 12084 + 13753 * int64(monthsElapsed)
		let days = int64(29 * monthsElapsed) + floorDiv64(partsElapsed, 25920)
		let r = (3 * (days + 1)) % 7
		return int((r < 0 ?? (r + 7, r)) < 3 ?? (days + 1, days))
	}

	def hebrewNewYear(year int) int {
		let ny0 = hebrewElapsed(year - 1)
		let ny1 = hebrewElapsed(year)
		let ny2 = hebrewElapsed(year + 1)
		let correction = ny2 - ny1 == 356 ?? (2, ny1 - ny0 == 382 ?? (1, 0))
		return hebrewEpoch + ny1 + correction
	}

	def hebrewYearLength(year int) int {
		return hebrewNewYear(year + 1) - hebrewNewYear(year)
	}

	// The length of an ordinal month (Tishrei = 1) of the year.
	def hebrewMonthLength(year int, month int) int {
		let leap = hebrewLeap(year)
		let length = hebrewYearLength(year)
		return length % 10 == 5 ?? (30, 29) when month == 2
		return length % 10 == 3 ?? (29, 30) when month == 3
		// Tishrei 30, Tevet 29, Shevat 30, (Adar I 30), Adar 29, Nisan 30,
		// Iyar 29, Sivan 30, Tammuz 29, Av 30, Elul 29.
		let common = int[30, 0, 0, 29, 30, 29, 30, 29, 30, 29, 30, 29]
		if leap {
			return 30 when month == 6
			return common[month - 2] when month > 6
		}
		return common[month - 1]
	}

	def fixedFromHebrew(year int, month int, day int) int {
		let total = hebrewNewYear(year) + day - 1
		for let m in 1..month {
			total += hebrewMonthLength(year, m)
		}
		return total
	}

	def hebrewFromRd(rd int) Fields {
		let year = floorDiv(rd - hebrewEpoch, 366) + 1
		for hebrewNewYear(year + 1) <= rd {
			year++
		}
		let start = hebrewNewYear(year)
		let month = 1
		let first = start
		for first + hebrewMonthLength(year, month) <= rd {
			first += hebrewMonthLength(year, month)
			month++
		}
		let monthCode = code(month)
		monthCode = month == 6 ?? ("M05L", month > 6 ?? (code(month - 1), code(month))) when hebrewLeap(year)
		return Fields{year: year, month: month, monthCode: monthCode, day: rd - first + 1}
	}

	// Tabular Islamic (type II leap years: 2, 5, 7, 10, 13, 16, 18, 21, 24,
	// 26, 29 of 30), from the civil (Friday) or astronomical (Thursday) epoch.
	def fixedFromTabularIslamic(year int, month int, day int, epoch int) int {
		return epoch - 1 + (year - 1) * 354 + floorDiv(3 + 11 * year, 30) + 29 * (month - 1) + month / 2 + day
	}

	def tabularIslamicFromRd(rd int, epoch int) Fields {
		let year = floorDiv(30 * (rd - epoch) + 10646, 10631)
		let before = rd - fixedFromTabularIslamic(year, 1, 1, epoch)
		let month = (11 * before + 330) / 325
		month = 12 when month > 12
		let day = rd - fixedFromTabularIslamic(year, month, 1, epoch) + 1
		return Fields{year: year, month: month, monthCode: code(month), day: day}
	}

	// Umm al-Qura: KACST's published months for AH 1300-1600, the civil
	// tabular calendar outside them.
	def ummAlQura(year int) ?LunarYear {
		return none when year < ummAlQuraStart || year >= ummAlQuraStart + ummAlQuraYears.len()
		return unpack(ummAlQuraYears[year - ummAlQuraStart])
	}

	def ummAlQuraDay(year int, month int, day int) int64 {
		let y = ummAlQura(year)
		return int64(fixedFromTabularIslamic(year, month, day, islamicCivilEpoch) - rdOffset) when y is none
		let total = 0
		for let m in 1..month {
			total += monthLength(y, m)
		}
		return int64(y.start + total + day - 1)
	}

	def ummAlQuraFromDay(day int64) Fields {
		let civil = tabularIslamicFromRd(int(day) + rdOffset, islamicCivilEpoch)
		// The published year is the civil one or a neighbour.
		for let year in civil.year - 1..civil.year + 2 {
			let y = ummAlQura(year)
			continue when y is none
			let offset = int(day) - y.start
			if offset >= 0 && offset < yearLength(y) {
				let month = 1
				for offset >= monthLength(y, month) {
					offset -= monthLength(y, month)
					month++
				}
				return Fields{year: year, month: month, monthCode: code(month), day: offset + 1}
			}
		}
		return civil
	}

	// Chinese and Korean: the year that starts in an ISO year, its months by
	// length, the leap month coded after the month it follows.
	def lunisolarFromDay(dangi bool, day int64) Fields {
		let iso = fromEpochDay(day).year
		let y = eastAsianYear(dangi, iso)
		if day < int64(y.start) {
			iso--
			y = eastAsianYear(dangi, iso)
		}
		let offset = int(day) - y.start
		let month = 1
		for offset >= monthLength(y, month) {
			offset -= monthLength(y, month)
			month++
		}
		let c = dangi ?? (Calendar.Dangi, Calendar.Chinese)
		return Fields{year: iso, month: month, monthCode: monthCodeOf(c, iso, month), day: offset + 1, era: "", eraYear: iso, eraIndex: -1}
	}

	def floorDiv(a int, b int) int {
		let q = a / b
		return (a % b != 0 && (a < 0) != (b < 0)) ?? (q - 1, q)
	}

	def floorDiv64(a int64, b int64) int64 {
		let q = a / b
		return (a % b != 0 && (a < 0) != (b < 0)) ?? (q - 1, q)
	}
}
