// The Chinese and Korean (Dangi) lunisolar calendars: published year data for
// 1900-2100 (tables.adm), and the astronomical rules (GB/T 33661-2017, as
// Calendrical Calculations states them) for every other year.

internal partial module std.i18n.calendars {
	use std.time::(fromEpochDay)

	// LunarYear is one lunisolar (or lunar) year: its first day, its months'
	// lengths and its leap month.
	struct LunarYear {
		start  int // epoch day of the first day
		months int // 12 or 13
		long   int // bit i set when month i + 1 has 30 days
		leap   int // ordinal of the leap month, 0 for none
	}

	def unpack(packed int) LunarYear {
		let leap = (packed >> 13) & 15
		return LunarYear{start: packed >> 17, leap: leap, long: packed & 0x1fff, months: leap == 0 ?? (12, 13)}
	}

	// MonthLength returns the length of ordinal month m of the year.
	def monthLength(y LunarYear, m int) int {
		return (y.long >> (m - 1)) & 1 == 1 ?? (30, 29)
	}

	def yearLength(y LunarYear) int {
		let n = 0
		for let m in 1..y.months + 1 {
			n += monthLength(y, m)
		}
		return n
	}

	// Years caches the years computed astronomically; atomic, as tasks share it.
	type Years {
		chinese map<int, LunarYear>
		dangi   map<int, LunarYear>

		def new() {
			chinese = map<int, LunarYear>{}
			dangi = map<int, LunarYear>{}
		}

		atomic def get(dangi bool, relatedIso int) LunarYear {
			let cache = dangi ?? (self.dangi, chinese)
			let have = cache.get(relatedIso)
			return have unless have is none
			let y = astronomicalYear(dangi, relatedIso)
			cache[relatedIso] = y
			return y
		}
	}

	let lunisolarYears = new Years()

	// EastAsianYear returns the year that starts in the ISO year relatedIso.
	def eastAsianYear(dangi bool, relatedIso int) LunarYear {
		return unpack(qingYears[relatedIso - qingStart]) when relatedIso >= qingStart && relatedIso < eastAsianStart
		let table = dangi ?? (dangiYears, chineseYears)
		return unpack(table[relatedIso - eastAsianStart]) when relatedIso >= eastAsianStart && relatedIso < eastAsianStart + table.len()
		return lunisolarYears.get(dangi, relatedIso)
	}

	// The standard time of Beijing or Seoul, as a fraction of a day east of UTC,
	// on an RD.
	def utcOffset(dangi bool, rd int) float {
		return rd < fixedFromGregorian(1929, 1, 1) ?? (1397.0 / 180.0 / 24.0, 8.0 / 24.0) unless dangi
		return 3809.0 / 450.0 / 24.0 when rd < fixedFromGregorian(1908, 4, 1)
		return 8.5 / 24.0 when rd < fixedFromGregorian(1912, 1, 1)
		return 9.0 / 24.0 when rd < fixedFromGregorian(1954, 3, 21)
		return 8.5 / 24.0 when rd < fixedFromGregorian(1961, 8, 10)
		return 9.0 / 24.0
	}

	def floorRd(moment float) int {
		return int(moment.floor())
	}

	def midnight(dangi bool, moment float) float {
		return moment - utcOffset(dangi, floorRd(moment))
	}

	def lunarNewMoonOnOrAfter(dangi bool, moment float) int {
		let m = newMoonAtOrAfter(midnight(dangi, moment))
		return floorRd(m + utcOffset(dangi, floorRd(m)))
	}

	def lunarNewMoonBefore(dangi bool, moment float) int {
		let m = newMoonBefore(midnight(dangi, moment))
		return floorRd(m + utcOffset(dangi, floorRd(m)))
	}

	// The major solar term (1 to 12) in force on an RD.
	def majorSolarTerm(dangi bool, rd int) int {
		let universal = float(rd) - utcOffset(dangi, rd)
		let s = int(solarLongitude(julianCenturies(universal)))
		let r = (2 + s / 30 - 1) % 12
		return (r < 0 ?? (r + 12, r)) + 1
	}

	def winterSolsticeOnOrBefore(dangi bool, rd int) int {
		let approx = estimatePriorSolarLongitude(winterLongitude, midnight(dangi, float(rd + 1)))
		let day = (approx - 1.0).floor()
		let iterations = 0
		for iterations < 14 && winterLongitude >= solarLongitude(julianCenturies(midnight(dangi, day + 1.0))) {
			iterations++
			day += 1.0
		}
		return int(day)
	}

	// A solstice computed outside December 20-23 is held to that range, as
	// the astronomy is only trusted near the present.
	def bindWinterSolstice(rd int) int {
		let d = fromEpochDay(int64(rd - rdOffset))
		return fixedFromGregorian(d.year, 12, 20) when d.month < 12 || d.day < 20
		return fixedFromGregorian(d.year, 12, 23) when d.day > 23
		return rd
	}

	// The new year in the sui (solstice to solstice) after the prior
	// solstice, and the following solstice.
	def newYearInSui(dangi bool, priorSolstice int) (int, int) {
		let prior = bindWinterSolstice(priorSolstice)
		let following = bindWinterSolstice(winterSolsticeOnOrBefore(dangi, prior + 370))
		let m12 = lunarNewMoonOnOrAfter(dangi, float(prior + 1))
		let m13 = lunarNewMoonOnOrAfter(dangi, float(m12 + 1))
		let m14 = lunarNewMoonOnOrAfter(dangi, float(m13 + 1))
		let nextM11 = lunarNewMoonBefore(dangi, float(following + 1))
		let months = int((float(nextM11 - m12) / meanSynodicMonth).round())
		let a = majorSolarTerm(dangi, m12)
		let b = majorSolarTerm(dangi, m13)
		let c = majorSolarTerm(dangi, m14)
		return (m14, following) when months == 12 && (a == b || b == c)
		return (m13, following)
	}

	def newYearOnOrBefore(dangi bool, rd int, priorSolstice int) (int, int) {
		let (newYear, following) = newYearInSui(dangi, priorSolstice)
		return (newYear, following) when rd >= newYear
		return newYearInSui(dangi, winterSolsticeOnOrBefore(dangi, rd - 180))
	}

	// AstronomicalYear computes the year that starts in the ISO year
	// relatedIso from the rules.
	def astronomicalYear(dangi bool, relatedIso int) LunarYear {
		let date = fixedFromGregorian(relatedIso, 3, 1)
		let (newYear, nextSolstice) = newYearOnOrBefore(dangi, date, winterSolsticeOnOrBefore(dangi, date))
		let (nextNewYear, _) = newYearOnOrBefore(dangi, newYear + 400, nextSolstice)
		let long = 0
		let leap = 0
		let start = newYear
		let term = majorSolarTerm(dangi, newYear)
		for let i in 0..12 {
			let next = lunarNewMoonOnOrAfter(dangi, float(start + 28))
			let nextTerm = majorSolarTerm(dangi, next)
			leap = i + 1 when nextTerm == term
			long |= 1 << i when next - start == 30
			start = next
			term = nextTerm
		}
		let months = 12
		if start == nextNewYear {
			leap = 0
		} else {
			months = 13
			long |= 1 << 12 when nextNewYear - start == 30
			leap = 13 when leap == 0
		}
		return LunarYear{start: newYear - rdOffset, months: months, long: long, leap: leap}
	}
}
