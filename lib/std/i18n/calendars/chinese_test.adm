internal partial module std.i18n.calendars {
	use std.testing

	check "Lunisolar years" {
		// The astronomical rules reproduce every published year, 1912-2100, for
		// both calendars: the tables are what they compute.
		@test()
		def astronomyMatchesPublishedYears() {
			let bad = 0
			for let dangi in bool[false, true] {
				let table = dangi ?? (dangiYears, chineseYears)
				for let i in 0..table.len() {
					let want = unpack(table[i])
					let got = astronomicalYear(dangi, eastAsianStart + i)
					if got.start != want.start || got.long != want.long || got.leap != want.leap {
						println("{dangi} {eastAsianStart + i}: got {got.start} {got.long} {got.leap} want {want.start} {want.long} {want.leap}")
						bad++
					}
				}
			}
			assert bad == 0
		}
	}
}
