// The observed Islamic calendar as ICU computes it ("islamic", and
// "islamic-rgsa" which ICU treats alike): a month starts when the moon's age
// (its ecliptic longitude past the sun's, from Duffett-Smith's Practical
// Astronomy with your Calculator) turns non-negative.

internal partial module std.i18n.calendars {
	use std.simd

	const icuPi = 3.14159265358979323846
	const icuSynodicMonth = 29.530588853
	const icuTropicalYear = 365.242191
	const icuJdEpoch = 2447891.5
	const icuJulianEpochMs = -210866760000000.0
	const icuDayMs = 86400000.0
	const hijraMs = -42521587200000.0 // 622-07-16 (Julian), 00:00 UTC
	const hijraDay = 492148 // days from the Hijra to 1970-01-01
	const sunEtaG = 279.403303
	const sunOmegaG = 282.768422
	const sunE = 0.016713
	const moonL0 = 318.351648
	const moonP0 = 36.340410
	const moonN0 = 318.510107
	const moonI = 5.145366

	def lane(v vec4<float>) float {
		return v.lane(0)
	}

	def icuSin(x float) float {
		return lane(simd.sin(simd.splat4<float>(x)))
	}

	def icuCos(x float) float {
		return lane(simd.cos(simd.splat4<float>(x)))
	}

	def norm2Pi(angle float) float {
		let range = icuPi * 2.0
		return angle - range * (angle / range).floor()
	}

	// The true anomaly of an elliptical orbit for a mean anomaly, Kepler's
	// equation solved by Newton's method.
	def trueAnomaly(meanAnomaly float, eccentricity float) float {
		let e = meanAnomaly
		let delta = 1.0
		for {
			delta = e - eccentricity * icuSin(e) - meanAnomaly
			e = e - delta / (1.0 - eccentricity * icuCos(e))
			break when delta.abs() <= 1e-5
		}
		let t = lane(simd.tan(simd.splat4<float>(e / 2.0))) * lane(simd.sqrt(simd.splat4<float>((1.0 + eccentricity) / (1.0 - eccentricity))))
		return 2.0 * lane(simd.atan2(simd.splat4<float>(t), simd.splat4<float>(1.0)))
	}

	// The moon's age in degrees (-180 to 180) at an instant, in milliseconds
	// since 1970.
	def moonAge(ms float) float {
		let day = (ms - icuJulianEpochMs) / icuDayMs - icuJdEpoch
		let epochAngle = norm2Pi(icuPi * 2.0 / icuTropicalYear * day)
		let meanAnomalySun = norm2Pi(epochAngle + sunEtaG * icuPi / 180.0 - sunOmegaG * icuPi / 180.0)
		let sunLongitude = norm2Pi(trueAnomaly(meanAnomalySun, sunE) + sunOmegaG * icuPi / 180.0)
		let meanLongitude = norm2Pi(13.1763966 * icuPi / 180.0 * day + moonL0 * icuPi / 180.0)
		let meanAnomalyMoon = norm2Pi(meanLongitude - 0.1114041 * icuPi / 180.0 * day - moonP0 * icuPi / 180.0)
		let evection = 1.2739 * icuPi / 180.0 * icuSin(2.0 * (meanLongitude - sunLongitude) - meanAnomalyMoon)
		let annual = 0.1858 * icuPi / 180.0 * icuSin(meanAnomalySun)
		let a3 = 0.3700 * icuPi / 180.0 * icuSin(meanAnomalySun)
		meanAnomalyMoon += evection - annual - a3
		let center = 6.2886 * icuPi / 180.0 * icuSin(meanAnomalyMoon)
		let a4 = 0.2140 * icuPi / 180.0 * icuSin(2.0 * meanAnomalyMoon)
		let moonLongitude = meanLongitude + evection + center - annual + a4
		moonLongitude += 0.6583 * icuPi / 180.0 * icuSin(2.0 * (moonLongitude - sunLongitude))
		let nodeLongitude = norm2Pi(moonN0 * icuPi / 180.0 - 0.0529539 * icuPi / 180.0 * day)
		nodeLongitude -= 0.16 * icuPi / 180.0 * icuSin(meanAnomalySun)
		let y = icuSin(moonLongitude - nodeLongitude)
		let x = icuCos(moonLongitude - nodeLongitude)
		let eclipticLongitude = lane(simd.atan2(simd.splat4<float>(y * icuCos(moonI * icuPi / 180.0)), simd.splat4<float>(x))) + nodeLongitude
		let age = norm2Pi(eclipticLongitude - sunLongitude) * 180.0 / icuPi
		return age > 180.0 ?? (age - 360.0, age)
	}

	// MonthStarts caches the start of each month since the Hijra (in days
	// from it, as ICU counts them); atomic, as tasks share it.
	type MonthStarts {
		starts map<int, int>

		def new() {
			starts = map<int, int>{}
		}

		atomic def get(month int) int {
			let have = starts.get(month)
			return have unless have is none
			let origin = hijraMs + (float(month) * icuSynodicMonth).floor() * icuDayMs
			let age = moonAge(origin)
			if age >= 0.0 {
				for age >= 0.0 {
					origin -= icuDayMs
					age = moonAge(origin)
				}
			} else {
				for age < 0.0 {
					origin += icuDayMs
					age = moonAge(origin)
				}
			}
			let start = int(((origin - hijraMs) / icuDayMs).floor()) + 1
			starts[month] = start
			return start
		}
	}

	let observedMonths = new MonthStarts()

	def observedIslamicFromDay(epochDay int64) Fields {
		let days = int(epochDay) + hijraDay
		let month = int((float(days) / icuSynodicMonth).floor())
		let startDate = int((float(month) * icuSynodicMonth).floor())
		let age = moonAge(float(epochDay) * icuDayMs)
		month++ when days - startDate >= 25 && age > 0.0
		for observedMonths.get(month) > days {
			month--
		}
		let year = month >= 0 ?? (month / 12 + 1, (month + 1) / 12)
		let m = ((month % 12) + 12) % 12
		let day = days - observedMonths.get(12 * (year - 1) + m) + 1
		return Fields{year: year, month: m + 1, monthCode: code(m + 1), day: day}
	}

	def observedIslamicDay(year int, month int, day int) int64 {
		return int64(observedMonths.get(12 * (year - 1) + month - 1) + day - 1 - hijraDay)
	}
}
