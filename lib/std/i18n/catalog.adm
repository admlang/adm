partial module std.i18n {
	use std.i18n.msgfmt

	// CatalogEntry is one message of a catalog: its key, its translation and
	// what translators and tools keep beside it.
	struct CatalogEntry {
		// What the program asks for: an identifier ("basket.title") or the
		// source text itself, as gettext keys messages.
		key        string
		// Tells apart messages with the same key ("menu" and "button" for
		// "Open"); "" for none.
		context    string   = ""
		// The translation, in the ICU MessageFormat syntax; "" when the
		// message is not translated yet. Unused when `forms` is set.
		text       string   = ""
		// The source text's plural form, for a message with gettext plural
		// forms; "" otherwise.
		plural     string   = ""
		// The translation's plural forms, in the order the catalog's plural
		// expression numbers them; empty for a message without them.
		forms      string[] = []
		// The translator's own comments.
		comments   string[] = []
		// Comments the programmer left for the translator.
		notes      string[] = []
		// Where the message is used: "src/basket.adm:42".
		references string[] = []
		// Flags: "fuzzy" for a translation that needs review, format flags
		// ("c-format") and whatever tools add.
		flags      string[] = []
		// The key, plural and context the translation was made for, when the
		// source changed since.
		previous   string[] = []
		// A message the source no longer has, kept for later reuse.
		obsolete   bool     = false
	}

	// CatalogHeader is one line of a catalog's own description:
	// "Language-Team", "PO-Revision-Date", ...
	struct CatalogHeader {
		name  string
		value string
	}

	// Catalog is the messages of one language: what a translation file
	// (`.po` and the other formats of `std.formats.translations`) holds.
	//
	//     let catalog = new Catalog(new Locale("de"))
	//     catalog.add(CatalogEntry{key: "basket.title", text: "Ihr Warenkorb"})
	//     catalog.add(CatalogEntry{key: "basket.count", text: "{count, plural, one{# Artikel} other{# Artikel}}"})
	//     let m = catalog.message("basket.count")
	//     m.format({"count": 3}) unless m is none   // "3 Artikel"
	//
	// A translation is text in the ICU MessageFormat syntax (see Message). A
	// message can instead carry gettext plural forms, picked by the
	// catalog's plural expression from the parameter "count" (else "n", else
	// the only number given).
	//
	// A message that is not translated, is marked "fuzzy" or is obsolete
	// answers as if absent, as gettext treats it: the program then shows its
	// source text.
	type Catalog {
		// The language of the translations.
		locale   Locale
		// The catalog's description, in file order.
		headers  CatalogHeader[]
		// The comments above the description.
		comments string[]
		// The description's flags: "fuzzy" in a template not yet filled in.
		flags    string[]

		internal list     CatalogEntry[]
		internal index    map<string, int>
		internal compiled map<string, Message>
		internal rule     ?msgfmt.PluralExpression
		internal ruleRead bool

		def new(locale Locale) {
			self.locale = locale
		}

		// Header returns the value of a line of the description
		// ("Plural-Forms"), by its name in any case; none when it has no
		// such line.
		atomic def header(name string) ?string {
			for let h in headers {
				return h.value when h.name.lower() == name.lower()
			}
			return none
		}

		// SetHeader sets a line of the description, adding it when new.
		atomic def setHeader(name string, value string) {
			if name.lower() == "plural-forms" {
				ruleRead = false
				compiled = map<string, Message>{}
			}
			for let h in headers {
				if h.name.lower() == name.lower() {
					h.value = value
					return
				}
			}
			headers.push(CatalogHeader{name: name, value: value})
		}

		// Add puts a message into the catalog, in place of the one with the
		// same key and context when there is one.
		atomic def add(entry CatalogEntry) {
			let id = entryId(entry.key, entry.context)
			compiled.delete(id)
			if index.hasKey(id) {
				list[index[id]] = entry
				return
			}
			index[id] = list.len()
			list.push(entry)
		}

		// Remove takes a message out. Returns whether the catalog had it.
		atomic def remove(key string, context string = "") bool {
			let id = entryId(key, context)
			return false unless index.hasKey(id)
			let at = index[id]
			list.remove(at)
			index = map<string, int>{}
			for let (i, entry) in list {
				index[entryId(entry.key, entry.context)] = i
			}
			compiled.delete(id)
			return true
		}

		// Get returns the message as the catalog holds it, translated or
		// not; none when the catalog has no such key.
		atomic def get(key string, context string = "") ?CatalogEntry {
			let id = entryId(key, context)
			return none unless index.hasKey(id)
			return list[index[id]]
		}

		// Entries returns every message, in file order.
		atomic def entries() CatalogEntry[] {
			return list.clone()
		}

		// Len returns how many messages the catalog holds.
		atomic def len() int {
			return list.len()
		}

		// Has reports whether the catalog has a usable translation of the
		// message: translated, neither fuzzy nor obsolete.
		atomic def has(key string, context string = "") bool {
			let id = entryId(key, context)
			return false unless index.hasKey(id)
			return usable(list[index[id]])
		}

		// Message returns the translation ready to format; none when the
		// catalog has no usable translation of it (see has). A translation
		// that is not well-formed MessageFormat is literal text.
		atomic def message(key string, context string = "") ?Message {
			let id = entryId(key, context)
			let ready = compiled.get(id)
			return ready unless ready is none
			return none unless index.hasKey(id)
			let entry = list[index[id]]
			return none unless usable(entry)
			let made = entry.forms.len() > 0 ?? (formsMessage(entry.forms, pluralRule(), locale), new Message(entry.text, locale))
			compiled[id] = made
			return made
		}

		// PluralForms returns the catalog's plural expression as its
		// description writes it ("nplurals=2; plural=(n != 1);"), or the
		// one gettext assumes without it.
		atomic def pluralForms() string {
			return pluralRule().source
		}

		// Whether the entry has a translation the program may show.
		internal def usable(entry CatalogEntry) bool {
			return false when entry.obsolete || entry.flags.includes("fuzzy")
			return entry.text != "" when entry.forms.len() == 0
			for let form in entry.forms {
				return false when form == ""
			}
			return true
		}

		// The plural expression of the description; gettext's default, two
		// forms with the singular for one, when it has none or one that
		// cannot be read.
		internal def pluralRule() msgfmt.PluralExpression {
			let ready = rule
			return ready when ruleRead && !(ready is none)
			let written = ""
			for let h in headers {
				written = h.value when h.name.lower() == "plural-forms"
			}
			let made = msgfmt.parsePluralForms(written == "" ?? (defaultPluralForms, written)) onerror recover germanicForms()
			rule = made
			ruleRead = true
			return made
		}
	}

	// The plural expression gettext assumes for a catalog without one.
	internal const defaultPluralForms = "nplurals=2; plural=(n != 1);"

	internal def germanicForms() msgfmt.PluralExpression {
		let one = msgfmt.Expr{op: "num", value: 1}
		return new msgfmt.PluralExpression(defaultPluralForms, 2, msgfmt.Expr{op: "!=", a: msgfmt.Expr{op: "n"}, b: one})
	}

	// The index key of a message: gettext joins context and key with U+0004.
	internal def entryId(key string, context string) string {
		return key when context == ""
		return context + "\u0004" + key
	}
}
