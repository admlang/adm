partial module std.i18n {
	use std.testing

	check "Catalog" {
		def german() Catalog {
			let catalog = new Catalog(new Locale("de"))
			catalog.add(CatalogEntry{key: "basket.title", text: "Ihr Warenkorb"})
			catalog.add(CatalogEntry{key: "basket.count", text: "\{count, plural, one\{# Artikel\} other\{# Artikel\}\} von \{user\}"})
			catalog.add(CatalogEntry{key: "Open", context: "menu", text: "Öffnen"})
			catalog.add(CatalogEntry{key: "Open", context: "state", text: "Offen"})
			return catalog
		}

		def text(catalog Catalog, key string, params map<string, any> = {}, context string = "") string {
			let m = catalog.message(key, context)
			return "(none)" when m is none
			return m.format(params)
		}

		@test()
		def answersWithTheTranslation() {
			let catalog = german()
			assert catalog.len() == 4
			assert text(catalog, "basket.title") == "Ihr Warenkorb"
			assert text(catalog, "basket.count", {"count": 1234, "user": "Ana"}) == "1.234 Artikel von Ana"
			assert text(catalog, "Open", {}, "menu") == "Öffnen"
			assert text(catalog, "Open", {}, "state") == "Offen"
			assert text(catalog, "Open") == "(none)"
			assert catalog.has("basket.title")
			assert !catalog.has("basket.missing")
			assert !catalog.has("Open")
			assert catalog.has("Open", "menu")
		}

		@test()
		def addReplacesAndRemoveForgets() {
			let catalog = german()
			catalog.add(CatalogEntry{key: "basket.title", text: "Warenkorb"})
			assert catalog.len() == 4
			assert text(catalog, "basket.title") == "Warenkorb"
			assert catalog.entries()[0].text == "Warenkorb"
			assert catalog.remove("basket.title")
			assert !catalog.remove("basket.title")
			assert catalog.len() == 3
			assert text(catalog, "basket.title") == "(none)"
			assert text(catalog, "Open", {}, "state") == "Offen"
			assert catalog.get("basket.title") is none
		}

		@test()
		def untranslatedFuzzyAndObsoleteAnswerAsAbsent() {
			let catalog = new Catalog(new Locale("de"))
			catalog.add(CatalogEntry{key: "empty"})
			catalog.add(CatalogEntry{key: "review", text: "Entwurf", flags: ["fuzzy"]})
			catalog.add(CatalogEntry{key: "gone", text: "weg", obsolete: true})
			catalog.add(CatalogEntry{key: "half", plural: "halves", forms: ["eins", ""]})
			for let key in ["empty", "review", "gone", "half"] {
				assert !catalog.has(key)
				assert catalog.message(key) is none
				assert !(catalog.get(key) is none)
			}
		}

		@test()
		def pluralFormsByTheHeadersExpression() {
			let catalog = new Catalog(new Locale("ru"))
			catalog.setHeader("Plural-Forms", "nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);")
			catalog.add(CatalogEntry{key: "files", plural: "files", forms: ["\{count\} файл", "\{count\} файла", "\{count\} файлов"]})
			assert text(catalog, "files", {"count": 1}) == "1 файл"
			assert text(catalog, "files", {"count": 3}) == "3 файла"
			assert text(catalog, "files", {"count": 5}) == "5 файлов"
			assert text(catalog, "files", {"count": 11}) == "11 файлов"
			assert text(catalog, "files", {"count": 21}) == "21 файл"
			assert text(catalog, "files", {"count": 1002}) == "1\u00a0002 файла"
			// The count is "count", else "n", else the only number given.
			assert text(catalog, "files", {"n": 3, "count": "x"}) == "x файла"
			catalog.add(CatalogEntry{key: "by", plural: "by", forms: ["\{who\}: один", "\{who\}: \{total\}", "\{who\}: много"]})
			assert text(catalog, "by", {"who": "Ana", "total": 22}) == "Ana: 22"
			// Without a count the first form is the answer.
			assert text(catalog, "by", {"who": "Ana"}) == "Ana: один"
			assert catalog.pluralForms().startsWith("nplurals=3;")
		}

		@test()
		def withoutAHeaderTwoFormsAsGettext() {
			let catalog = new Catalog(new Locale("de"))
			catalog.add(CatalogEntry{key: "files", plural: "files", forms: ["eine Datei", "\{n\} Dateien"]})
			assert catalog.pluralForms() == "nplurals=2; plural=(n != 1);"
			assert text(catalog, "files", {"n": 1}) == "eine Datei"
			assert text(catalog, "files", {"n": 0}) == "0 Dateien"
			assert text(catalog, "files", {"n": 7}) == "7 Dateien"
			// A new expression applies to messages already asked for.
			catalog.setHeader("Plural-Forms", "nplurals=2; plural=(n > 1);")
			assert text(catalog, "files", {"n": 0}) == "eine Datei"
			let written = catalog.header("plural-forms")
			assert !(written is none)
			assert written == "nplurals=2; plural=(n > 1);" unless written is none
			assert catalog.header("Language") is none
			// One that cannot be read leaves gettext's default.
			catalog.setHeader("Plural-Forms", "nplurals=2; plural=(n +);")
			assert text(catalog, "files", {"n": 0}) == "0 Dateien"
		}

		@test()
		def pluralExpressions() {
			let cases = map<string, int[]>{
				"nplurals=1; plural=0;":                                                                                [0, 0, 0, 0, 0],
				"nplurals=2; plural=n != 1;":                                                                           [1, 0, 1, 1, 1],
				"nplurals=2; plural=(n > 1)":                                                                           [0, 0, 1, 1, 1],
				"nplurals=3; plural=(n==1) ? 0 : (n>=2 && n<=4) ? 1 : 2;":                                              [2, 0, 1, 1, 2],
				"nplurals=4; plural=(n%100==1 ? 0 : n%100==2 ? 1 : n%100==3 || n%100==4 ? 2 : 3);":                     [3, 0, 1, 2, 3],
				"nplurals=6; plural=(n==0 ? 0 : n==1 ? 1 : n==2 ? 2 : n%100>=3 && n%100<=10 ? 3 : n%100>=11 ? 4 : 5);": [0, 1, 2, 3, 4],
				"nplurals=2; plural=!(n == 1 || n*2 == 4/2+2 - 0);":                                                    [1, 0, 0, 1, 1],
				"nplurals=2; plural=n/0;":                                                                              [0, 0, 0, 0, 0],
			}
			let counts = [0, 1, 2, 3, 11]
			for let (expression, want) in cases {
				let catalog = new Catalog(new Locale("und"))
				catalog.setHeader("Plural-Forms", expression)
				catalog.add(CatalogEntry{key: "k", plural: "k", forms: ["0", "1", "2", "3", "4", "5"]})
				for let (i, count) in counts {
					let got = text(catalog, "k", {"count": count})
					println(expression + " for {count}: got " + got + ", want {want[i]}") when got != want[i].str()
					assert got == want[i].str()
				}
			}
		}
	}
}
