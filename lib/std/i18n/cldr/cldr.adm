// The Unicode CLDR data std.i18n formats with: generated tables
// (tools/i18n/gen_cldr.py) embedded in std and decoded on first use, one
// section of one locale at a time.

internal partial module std.i18n.cldr {
	use (
		std.io
		std.bytes
		std.data.compress.flate
	)

	@embed("cldr.bin")
	const blob byte[]

	// The value a locale stores for a path it has no value at, so its
	// section's base does not supply one (a Buddhist calendar has none of
	// the Gregorian formats its locale lacks in ICU).
	const absent = "\u0000"

	// Section is one CLDR file (numbers, ca-gregorian, supplemental/plurals)
	// as the tables index it.
	struct Section {
		name        string
		base        string
		pathsOffset int
		pathsLength int
		chunks      map<int, Span>
		decoded     map<int, Chunk> // chunks decoded so far, by locale index
		paths       string[]
		pathIds     map<string, int>
		loaded      bool
	}

	struct Span {
		offset int
		length int
	}

	// Chunk is one locale's entries in a section: path ids ascending and
	// their values.
	struct Chunk {
		ids    int[]
		values string[]
	}

	// Tables is the decoded index of the embedded data and the sections and
	// chunks decoded so far. Every method is atomic, so tasks share it.
	type Tables {
		internal ready    bool
		internal release  string
		internal names    string[]
		internal parents  int[]
		internal indexes  map<string, int>
		internal sections map<string, Section>

		// Version returns the CLDR release the tables were generated from.
		atomic def version() string {
			load()
			return release
		}

		// Locales returns the name of every locale the tables hold, root included.
		atomic def locales() string[] {
			load()
			return names
		}

		// Has reports whether the tables hold the locale, named as CLDR names it
		// (`de-CH`, `zh-Hant-HK`, `root`).
		atomic def has(locale string) bool {
			load()
			return indexes.hasKey(locale)
		}

		// Parent returns the locale the given one inherits from, or none for
		// root and for a locale the tables do not hold.
		atomic def parent(locale string) ?string {
			load()
			let i = indexOf(locale)
			return none when i < 0 || parents[i] >= names.len()
			return names[parents[i]]
		}

		// Value returns the value at path in the section for the locale,
		// inherited from its parents and the section's base, or none (also
		// when the locale marks the path absent, so the base's value does not
		// show through).
		atomic def value(section string, locale string, path string) ?string {
			load()
			let sec = section
			for sec != "" {
				let s = loadSection(sec)
				break when s is none
				let id = -1
				id = s.pathIds[path] when s.pathIds.hasKey(path)
				if id >= 0 {
					let loc = indexOf(locale)
					for loc >= 0 && loc < names.len() {
						let c = chunk(s, loc)
						if !(c is none) {
							let at = find(c.ids, id)
							if at >= 0 {
								return none when c.values[at] == absent
								return c.values[at]
							}
						}
						loc = parents[loc]
					}
				}
				sec = s.base
			}
			return none
		}

		// Values returns every value under the path prefix in the section for
		// the locale, inherited as value inherits them, keyed by the rest of the
		// path after the prefix and its "/".
		atomic def values(section string, locale string, prefix string) map<string, string> {
			load()
			let out = map<string, string>{}
			let want = prefix == "" ?? ("", prefix + "/")
			let sec = section
			for sec != "" {
				let s = loadSection(sec)
				break when s is none
				let (lo, hi) = prefixRange(s.paths, want)
				if lo < hi {
					let loc = indexOf(locale)
					for loc >= 0 && loc < names.len() {
						let c = chunk(s, loc)
						if !(c is none) {
							let at = lower(c.ids, lo)
							for at < c.ids.len() && c.ids[at] < hi {
								let key = s.paths[c.ids[at]][want.len():]
								out[key] = c.values[at] unless out.hasKey(key)
								at++
							}
						}
						loc = parents[loc]
					}
				}
				sec = s.base
			}
			for let key in out.keys() {
				out.delete(key) when out[key] == absent
			}
			return out
		}

		// Nearest returns the values under the prefix from the nearest locale
		// in the chain that has any, keyed like values, without merging in its
		// parents': for data that must come whole from one locale (RBNF rule
		// sets). Empty when no locale has any.
		atomic def nearest(section string, locale string, prefix string) map<string, string> {
			load()
			let out = map<string, string>{}
			let want = prefix + "/"
			let s = loadSection(section)
			return out when s is none
			let (lo, hi) = prefixRange(s.paths, want)
			return out when lo >= hi
			let loc = indexOf(locale)
			for loc >= 0 && loc < names.len() {
				let c = chunk(s, loc)
				if !(c is none) {
					let at = lower(c.ids, lo)
					for at < c.ids.len() && c.ids[at] < hi {
						out[s.paths[c.ids[at]][want.len():]] = c.values[at]
						at++
					}
					return out when out.len() > 0
				}
				loc = parents[loc]
			}
			return out
		}

		internal def indexOf(locale string) int {
			return -1 unless indexes.hasKey(locale)
			return indexes[locale]
		}

		internal def load() {
			return when ready
			ready = true
			let r = new Cursor(blob)
			r.pos = 8
			release = r.text()
			let count = r.varint()
			names = string[]
			parents = int[]
			indexes = map<string, int>{}
			sections = map<string, Section>{}
			for let i in 0..count {
				let name = r.text()
				names.push(name)
				parents.push(r.varint())
				indexes[name] = i
			}
			let sectionCount = r.varint()
			for let _ in 0..sectionCount {
				let s = Section{name: r.text(), base: r.text()}
				s.pathsOffset = r.varint()
				s.pathsLength = r.varint()
				s.chunks = map<int, Span>{}
				s.decoded = map<int, Chunk>{}
				let n = r.varint()
				for let _ in 0..n {
					let loc = r.varint()
					s.chunks[loc] = Span{offset: r.varint(), length: r.varint()}
				}
				sections[s.name] = s
			}
		}

		internal def loadSection(name string) ?Section {
			return none unless sections.hasKey(name)
			let s = sections[name]
			if !s.loaded {
				let r = new Cursor(inflate(s.pathsOffset, s.pathsLength))
				let n = r.varint()
				s.paths = string[]
				s.pathIds = map<string, int>{}
				for let i in 0..n {
					let p = r.text()
					s.paths.push(p)
					s.pathIds[p] = i
				}
				s.loaded = true
			}
			return s
		}

		internal def chunk(s Section, loc int) ?Chunk {
			return none unless s.chunks.hasKey(loc)
			return s.decoded[loc] when s.decoded.hasKey(loc)
			let span = s.chunks[loc]
			let r = new Cursor(inflate(span.offset, span.length))
			let n = r.varint()
			let c = Chunk{ids: int[], values: string[]}
			let id = 0
			for let _ in 0..n {
				id += r.varint()
				c.ids.push(id)
				c.values.push(r.text())
			}
			s.decoded[loc] = c
			return c
		}
	}

	// tables is the program's one copy of the decoded data.
	let tables = new Tables()

	// The index in ids of id, or -1.
	def find(ids int[], id int) int {
		let at = lower(ids, id)
		return at when at < ids.len() && ids[at] == id
		return -1
	}

	// The first index in ids holding a value >= id.
	def lower(ids int[], id int) int {
		let lo = 0
		let hi = ids.len()
		for lo < hi {
			let mid = (lo + hi) / 2
			if ids[mid] < id {
				lo = mid + 1
			} else {
				hi = mid
			}
		}
		return lo
	}

	// The ids [lo, hi) of the sorted paths starting with prefix.
	def prefixRange(paths string[], prefix string) (int, int) {
		return (0, paths.len()) when prefix == ""
		let lo = 0
		let hi = paths.len()
		for lo < hi {
			let mid = (lo + hi) / 2
			if paths[mid] < prefix {
				lo = mid + 1
			} else {
				hi = mid
			}
		}
		let end = lo
		for end < paths.len() && paths[end].startsWith(prefix) {
			end++
		}
		return (lo, end)
	}

	def inflate(offset int, length int) byte[] {
		let r = new flate.Reader(new bytes.Reader(blob[offset:offset + length]))
		return io.readAll(r) onerror recover byte[]
	}

	// Cursor reads the varints and strings of the table format.
	type Cursor {
		data byte[]
		pos  int

		def new(data byte[]) {
			self.data = data
		}

		def varint() int {
			let n = 0
			let shift = 0
			for pos < data.len() {
				let b = int(data[pos])
				pos++
				n |= (b & 0x7f) << shift
				return n when b < 0x80
				shift += 7
			}
			return n
		}

		def text() string {
			let n = varint()
			let s = string(data[pos:pos + n])
			pos += n
			return s
		}
	}
}
