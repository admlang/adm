internal partial module std.i18n.cldr {
	use std.testing

	check "CLDR tables" {
		// The value, or "" for none.
		def text(v ?string) string {
			return "" when v is none
			return v
		}

		@test()
		def indexesLocales() {
			assert tables.version() == "48.2.3"
			assert tables.has("root")
			assert tables.has("de-CH")
			assert !tables.has("xx-YY")
			assert text(tables.parent("de-CH")) == "de"
			assert text(tables.parent("de")) == "root"
			assert text(tables.parent("en-AU")) == "en-001"
			assert tables.parent("root") is none
		}

		@test()
		def inheritsFromParents() {
			assert text(tables.value("numbers", "de-CH", "numbers/symbols-numberSystem-latn/group")) == "'"
			assert text(tables.value("numbers", "de-AT", "numbers/symbols-numberSystem-latn/decimal")) == ","
			assert tables.value("numbers", "de", "numbers/no/such/path") is none
		}

		@test()
		def fallsBackToTheBaseSection() {
			assert text(tables.value("ca-gregorian", "de", "calendar/months/format/wide/1")) == "Januar"
			// Buddhist months are the Gregorian ones, found through ca-generic.
			assert text(tables.value("ca-buddhist", "de", "calendar/months/format/wide/1")) == "Januar"
			assert text(tables.value("ca-buddhist", "de", "calendar/eras/eraAbbr/0")) == "BE"
		}

		@test()
		def readsSupplementalData() {
			assert text(tables.value("supplemental/likelySubtags", "root", "likelySubtags/de")) == "de-Latn-DE"
		}

		@test()
		def listsValuesUnderAPrefix() {
			let names = tables.values("currencies", "fr", "numbers/currencies")
			assert names["EUR/displayName"] == "euro"
			assert names["USD/symbol"] == "$US"
			let months = tables.values("ca-gregorian", "de-CH", "calendar/months/format/wide")
			assert months.len() == 12
			assert months["3"] == "März"
		}
	}
}
