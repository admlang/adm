partial module std.i18n {
	use (
		std.i18n.cldr::(tables)
		std.i18n.subtags
		std.math::(Decimal, RoundingMode)
	)

	// Currency is a currency by its ISO 4217 code, with the symbol each locale
	// writes it with and how many digits its minor unit has.
	//
	//     let eur = new Currency("EUR")
	//     eur.symbol(new Locale("en"))   // "€"
	//     eur.amount(1999).str()         // "19.99"
	type Currency {
		code string // ISO 4217 (USD, EUR)

		def new(code string) {
			self.code = code.upper()
		}

		// Digits returns how many digits the minor unit has: 2 for EUR, 0 for
		// JPY, 3 for KWD.
		def digits() int {
			return fraction("_digits", 2)
		}

		// CashDigits returns the digits cash amounts are given to, when they
		// differ from digits (none today; kept for currencies that drop coins).
		def cashDigits() int {
			return fraction("_cashDigits", digits())
		}

		// CashRounding returns the increment, in minor units, cash amounts round
		// to: 5 for CHF (0.05), 0 when cash rounds like any amount.
		def cashRounding() int {
			return fraction("_cashRounding", 0)
		}

		// Symbol returns the symbol the locale writes the currency with ("€",
		// "US$" in en-CA, "CHF"), or the code when it has none.
		def symbol(locale Locale) string {
			return currencyField(locale, code, "symbol", code)
		}

		// NarrowSymbol returns the shortest symbol, ambiguous between
		// currencies ("$" for USD, CAD and AUD alike).
		def narrowSymbol(locale Locale) string {
			return currencyField(locale, code, "symbol-alt-narrow", symbol(locale))
		}

		// Name returns the currency's name in the locale ("US Dollar", "euro").
		def name(locale Locale) string {
			return currencyField(locale, code, "displayName", code)
		}

		// Amount returns the value of a count of minor units: 1999 is 19.99 EUR,
		// 1999 JPY.
		def amount(minorUnits int) Decimal {
			return new Decimal(bigint(minorUnits), -digits())
		}

		// MinorUnits returns the amount as a count of minor units, rounded to
		// the currency's digits: 19.995 EUR is 2000.
		def minorUnits(amount Decimal, mode RoundingMode = RoundingMode.HalfEven) bigint {
			let r = amount.round(digits(), mode).shift(digits())
			return r.toInt()
		}

		// Str returns the code.
		def str() string {
			return code
		}

		internal def fraction(field string, fallback int) int {
			let v = supplemental("currencyData", "currencyData/fractions/" + code + "/" + field)
			v = supplemental("currencyData", "currencyData/fractions/DEFAULT/" + field) when v == ""
			return fallback when v == ""
			return v.toInt<int>()
		}
	}

	internal def supplemental(file string, path string) string {
		return subtags.supplemental(file, path)
	}

	// A field of the currency in the locale's currencies section, or fallback.
	internal def currencyField(locale Locale, code string, field string, fallback string) string {
		let v = tables.value("currencies", dataLocaleOf(locale), "numbers/currencies/" + code + "/" + field)
		return fallback when v is none
		return v
	}

	// The region's currency in use today: the legal tender with no end date
	// and the latest start.
	internal def regionCurrency(region string) ?Currency {
		let entries = tables.values("supplemental/currencyData", "root", "currencyData/region/" + region)
		let best = ""
		let bestFrom = ""
		let i = 0
		for {
			let prefix = i.str() + "/"
			let found = ""
			for let (k, _) in entries {
				if k.startsWith(prefix) {
					found = k[prefix.len():].split("/")[0]
					break
				}
			}
			break when found == ""
			let at = prefix + found + "/"
			let ended = entries.hasKey(at + "_to")
			let tender = !entries.hasKey(at + "_tender") || entries[at + "_tender"] == "true"
			let from = entries.hasKey(at + "_from") ?? (entries[at + "_from"], "")
			if !ended && tender && (best == "" || from > bestFrom) {
				best = found
				bestFrom = from
			}
			i++
		}
		return none when best == ""
		return new Currency(best)
	}
}
