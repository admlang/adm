partial module std.i18n {
	use (
		std.i18n.calendars
		std.i18n.cldr::(tables)
		std.i18n.dtfmt
		std.i18n.subtags
		std.time::(Date, DateTime, Time, TimeOfDay)
	)

	// DateTimeStyle is a locale's preset length for a date or a time.
	enum DateTimeStyle {
		Off
		Full   // Thursday, October 1, 2026; 9:05:00 AM Central European Summer Time
		Long   // October 1, 2026; 9:05:00 AM GMT+2
		Medium // Oct 1, 2026; 9:05:00 AM
		Short  // 10/1/26; 9:05 AM
	}

	// TextField is how a weekday, era or day period is written.
	enum TextField {
		Off
		Narrow // T, A, in the morning
		Short  // Thu, AD
		Long   // Thursday, Anno Domini
	}

	// NumericField is how a year, day, hour, minute or second is written.
	enum NumericField {
		Off
		Numeric  // 2026, 1, 9
		TwoDigit // 26, 01, 09
	}

	// MonthField is how the month is written.
	enum MonthField {
		Off
		Numeric  // 10
		TwoDigit // 10, 03
		Narrow   // O
		Short    // Oct
		Long     // October
	}

	// ZoneNameField is how the time zone is named.
	enum ZoneNameField {
		Off
		Short        // CEST, GMT+2
		Long         // Central European Summer Time
		ShortOffset  // GMT+2
		LongOffset   // GMT+02:00
		ShortGeneric // CET, Germany Time
		LongGeneric  // Central European Time
	}

	// HourCycle is how the hours of a day are numbered.
	enum HourCycle {
		Auto // the locale's (or its -u-hc keyword)
		H11  // 0 to 11, with a day period
		H12  // 1 to 12, with a day period
		H23  // 0 to 23
		H24  // 1 to 24
	}

	// DateTimeOptions configures a DateTimeFormat. Either a date or time
	// style, or the fields to show: the locale then picks their order,
	// punctuation and the nearest widths it writes (ECMA-402). With neither,
	// the date is shown as numbers. The styles take precedence over the
	// fields.
	struct DateTimeOptions {
		dateStyle              DateTimeStyle = DateTimeStyle.Off
		timeStyle              DateTimeStyle = DateTimeStyle.Off
		weekday                TextField     = TextField.Off
		era                    TextField     = TextField.Off
		year                   NumericField  = NumericField.Off
		month                  MonthField    = MonthField.Off
		day                    NumericField  = NumericField.Off
		dayPeriod              TextField     = TextField.Off // "in the morning" in a 12-hour clock
		hour                   NumericField  = NumericField.Off
		minute                 NumericField  = NumericField.Off
		second                 NumericField  = NumericField.Off
		fractionalSecondDigits int           = 0 // 0 to 3
		timeZoneName           ZoneNameField = ZoneNameField.Off
		hourCycle              HourCycle     = HourCycle.Auto
		hour12                 ?bool         = none // true or false picks the locale's 12- or 24-hour cycle, over hourCycle
		timeZone               string        = "" // an IANA id or an offset; "" for the system's zone
		calendar               ?Calendar     = none // none for the locale's (or its -u-ca keyword)
		numberingSystem        string        = "" // "arab", "deva", ...; "" for the locale's (or its -u-nu)
	}

	// DateTimeFormat writes dates and times for a locale: the fields asked
	// for, in the locale's order and words, in its calendar and time zone, as
	// CLDR describes it (ECMA-402's Intl.DateTimeFormat). Build one and reuse
	// it.
	//
	//     let f = new DateTimeFormat(new Locale("de-DE"), DateTimeOptions{dateStyle: DateTimeStyle.Long, timeZone: "Europe/Berlin"})
	//     f.format(now())                 // "1. Oktober 2026"
	//     new DateTimeFormat(new Locale("en-US"), DateTimeOptions{month: MonthField.Short, day: NumericField.Numeric}).format(now())   // "Oct 1"
	type DateTimeFormat {
		locale          Locale
		options         DateTimeOptions
		calendar        Calendar // the calendar dates are counted in
		timeZone        TimeZone // the zone instants are shown in
		hourCycle       HourCycle // the resolved cycle, never Auto
		numberingSystem string
		pattern         string // the CLDR pattern the fields are written through

		internal resolved     Locale // the locale ICU formats with: "fr-US" is "fr" (see subtags.available)
		internal data         string
		internal calendarName string
		internal symbols      dtfmt.Symbols
		internal firstWeekday int
		internal instants     Form // for Time and ZonedDateTime
		internal dates        Form // for Date: the date options only
		internal times        Form // for TimeOfDay: the time options only
		internal dateTimes    Form // for DateTime: all but the zone name

		def new(locale Locale, options DateTimeOptions = DateTimeOptions{}) {
			self.locale = locale
			self.options = options
			resolved = new Locale(subtags.available(tagOf(locale)))
			data = dataLocaleOf(locale)
			calendar = resolveCalendar()
			calendarName = cldrCalendarName(calendar)
			numberingSystem = numberingSystemOf(locale, data, options.numberingSystem)
			timeZone = options.timeZone == "" ?? (systemTimeZone(), new TimeZone(options.timeZone))
			let region = resolved.maximize().region.code
			firstWeekday = weekdayNumber(weekData("firstDay", region, "mon"))
			let hourKeyword = locale.keyword("hc")
			let keyword = hourKeyword is none ?? ("", hourKeyword)
			let g = dtfmt.generators.get(data, calendarName, numberingSystem, resolved.language.code, region, keyword, true)
			hourCycle = resolveHourCycle(g, keyword)
			instants = form(g, keyword, region, options, requireAny, defaultDate)
			dates = form(g, keyword, region, relevantOptions(dateOptions), requireDate, defaultDate)
			times = form(g, keyword, region, relevantOptions(timeOptions), requireTime, defaultTime)
			dateTimes = form(g, keyword, region, relevantOptions(dateTimeOptions), requireAny, defaultAll)
			pattern = instants.pattern
			let minus = tables.value("numbers", data, "numbers/symbols-numberSystem-" + numberingSystem + "/minusSign")
			minus = tables.value("numbers", data, "numbers/symbols-numberSystem-latn/minusSign") when minus is none
			symbols = dtfmt.symbolCache.get(data, ruleTag(), calendarName, systemDigitsOf(numberingSystem), minus is none ?? ("-", minus))
		}

		// Format writes the instant in the format's time zone.
		def format(at Time) string {
			let offset = int(int64(timeZone.offset(at)) / 1000000000)
			return write(instants, at.dateTime(timeZone.offset(at)), offset, timeZone.daylight(at), timeZone.id)
		}

		// Format writes the zoned date-time in its own time zone.
		def format(z ZonedDateTime) string {
			let at = z.instant
			let offset = int(int64(z.zone.offset(at)) / 1000000000)
			return write(instants, z.dateTime(), offset, z.zone.daylight(at), z.zone.id)
		}

		// Format writes the date through the date options (the others are
		// left out; none given shows it as numbers). Fails when the options
		// ask only for fields a date has not, as a time style or hours.
		def format(d Date) !string {
			fail "the format shows no field of a date" when dates.pattern == ""
			return write(dates, new DateTime(d.year, d.month, d.day), 0, false, "UTC")
		}

		// Format writes the time of day through the time options (none given
		// shows hours, minutes and seconds). Fails when the options ask only
		// for fields a time of day has not.
		def format(t TimeOfDay) !string {
			fail "the format shows no field of a time of day" when times.pattern == ""
			return write(times, new DateTime(new Date(1970, 1, 1), t), 0, false, "UTC")
		}

		// Format writes the date and time through all but the zone name
		// options (none given shows the date and the time as numbers). Fails
		// when the options ask only for the zone name.
		def format(dt DateTime) !string {
			fail "the format shows no field of a date-time" when dateTimes.pattern == ""
			return write(dateTimes, dt, 0, false, "UTC")
		}

		internal def write(f Form, local DateTime, offset int, daylight bool, zone string) string {
			let m = moment(local.date.epochDay(), local.time)
			m.offset = offset
			m.daylight = daylight
			m.zone = zone
			return dtfmt.write(f.items, m, symbols, f.overrides)
		}

		// The pattern the options give for a kind of value, compiled with its
		// numbering overrides; an empty form when they ask only for fields the
		// kind has not.
		internal def form(g dtfmt.Generator, keyword string, region string, o ?DateTimeOptions, required int, defaults int) Form {
			return Form{items: dtfmt.Item[], overrides: noOverrides()} when o is none
			let (text, dateNumbers, timeNumbers) = resolvePattern(g, keyword, region, o, required, defaults)
			return Form{items: dtfmt.Item[], overrides: noOverrides()} when text == ""
			return Form{pattern: text, items: dtfmt.compile(text), overrides: resolveOverrides(text, dateNumbers, timeNumbers)}
		}

		// The options a plain value takes (ECMA-402 with Temporal): the
		// fields relevant to it, or none when fields were asked for and none
		// is relevant.
		internal def relevantOptions(kind int) ?DateTimeOptions {
			let o = options
			let out = DateTimeOptions{hourCycle: o.hourCycle, hour12: o.hour12, timeZone: o.timeZone, calendar: o.calendar, numberingSystem: o.numberingSystem}
			let wantsDates = kind != timeOptions
			let wantsTimes = kind != dateOptions
			if o.dateStyle != DateTimeStyle.Off || o.timeStyle != DateTimeStyle.Off {
				out.dateStyle = wantsDates ?? (o.dateStyle, DateTimeStyle.Off)
				out.timeStyle = wantsTimes ?? (o.timeStyle, DateTimeStyle.Off)
				return none when out.dateStyle == DateTimeStyle.Off && out.timeStyle == DateTimeStyle.Off
				return out
			}
			if wantsDates {
				out.weekday = o.weekday
				out.era = o.era
				out.year = o.year
				out.month = o.month
				out.day = o.day
			}
			if wantsTimes {
				out.dayPeriod = o.dayPeriod
				out.hour = o.hour
				out.minute = o.minute
				out.second = o.second
				out.fractionalSecondDigits = o.fractionalSecondDigits
			}
			let asked = hasField(o) || o.timeZoneName != ZoneNameField.Off
			return none when asked && !hasField(out)
			return out
		}

		// The fields of a day in the format's calendar and a time of day.
		internal def moment(epochDay int64, time TimeOfDay) dtfmt.Moment {
			let f = calendars.fieldsOf(calendar, epochDay)
			let m = dtfmt.Moment{
				era:          f.eraIndex,
				year:         f.eraYear,
				extendedYear: f.year,
				relatedYear:  relatedYear(f),
				monthKey:     f.month.str(),
				monthNumber:  f.month,
				day:          f.day,
				dayOfYear:    int(epochDay - calendars.dayOf(calendar, f.year, 1, 1)) + 1,
				weekday:      int(((epochDay + 4) % 7 + 7) % 7) + 1,
				firstWeekday: firstWeekday,
				hour:         time.hour,
				minute:       time.minute,
				second:       time.second,
				nanosecond:   time.nanosecond,
				epochDay:     epochDay,
			}
			match calendar {
				case Calendar.Chinese, Calendar.Dangi:
					// ICU counts 60-year cycles from 2637 BCE for both.
					let extended = f.year + 2637
					m.era = floorDivide(extended - 1, 60) + 1
					m.year = extended - 1 - (m.era - 1) * 60 + 1
					m.cyclicYear = m.year
					m.extendedYear = extended
					m.leap = f.monthCode.endsWith("L")
					m.monthNumber = f.monthCode[1:3].toInt<int>()
					m.monthKey = m.monthNumber.str()
				case Calendar.Islamic, Calendar.IslamicCivil, Calendar.IslamicUmalqura, Calendar.IslamicTbla, Calendar.IslamicRgsa:
					// ICU writes years before AH 1 as negative years of the one era.
					m.year = f.year
				case Calendar.Hebrew:
					let n = f.monthCode[1:3].toInt<int>()
					if f.monthCode.endsWith("L") {
						m.monthKey = "6"
					} else if n >= 6 {
						let leapYear = calendars.monthsIn(calendar, f.year) == 13
						m.monthKey = n == 6 && leapYear ?? ("7-yeartype-leap", (n + 1).str())
					}
				default:
			}
			return m
		}

		// The ISO year a calendar year starts in, as ICU's getRelatedYear
		// gives it for r.
		internal def relatedYear(f calendars.Fields) int {
			match calendar {
				case Calendar.Chinese, Calendar.Dangi:
					return f.year
				case Calendar.Gregorian, Calendar.Iso8601, Calendar.Buddhist, Calendar.Japanese, Calendar.Roc:
					return fromEpochDayYear(calendars.dayOf(calendar, f.year, f.month, f.day))
				default:
					return fromEpochDayYear(calendars.dayOf(calendar, f.year, 1, 1))
			}
		}

		// The calendar asked for, else the -u-ca keyword's, else the first
		// the locale's region prefers.
		internal def resolveCalendar() Calendar {
			let asked = options.calendar
			return asked unless asked is none
			let ca = locale.keyword("ca")
			if !(ca is none) {
				let named = calendarNamed(ca)
				return named unless named is none
			}
			let region = resolved.maximize().region.code
			let preferred = tables.value("supplemental/calendarPreferenceData", "root", "calendarPreferenceData/" + region)
			preferred = tables.value("supplemental/calendarPreferenceData", "root", "calendarPreferenceData/001") when preferred is none
			if !(preferred is none) {
				let named = calendarNamed(preferred.split("\u001f")[0])
				return named unless named is none
			}
			return Calendar.Gregorian
		}

		// ECMA-402's hour cycle: hour12 picks the locale's 12- or 24-hour
		// cycle, else hourCycle, else the -u-hc keyword, else the locale's.
		internal def resolveHourCycle(g dtfmt.Generator, keyword string) HourCycle {
			let fallback = hourCycleOfLetter(g.defaultHour)
			let twelve = options.hour12
			if !(twelve is none) {
				if twelve {
					return fallback when fallback := HourCycle.H11 || HourCycle.H12
					return resolved.maximize().region.code == "JP" ?? (HourCycle.H11, HourCycle.H12)
				}
				return fallback when fallback := HourCycle.H23 || HourCycle.H24
				return HourCycle.H23
			}
			return options.hourCycle unless options.hourCycle == HourCycle.Auto
			let named = hourCycleNamed(keyword)
			return named unless named == HourCycle.Auto
			return fallback
		}

		// The pattern: the locale's style patterns, or the best pattern for
		// the skeleton the fields make (V8's CreateDateTimeFormat).
		internal def resolvePattern(g dtfmt.Generator, keyword string, region string, o DateTimeOptions, required int, defaults int) (string, string, string) {
			if o.dateStyle != DateTimeStyle.Off || o.timeStyle != DateTimeStyle.Off {
				return ("", "", "") when required == requireDate && o.timeStyle != DateTimeStyle.Off
				return ("", "", "") when required == requireTime && o.dateStyle != DateTimeStyle.Off
				return stylePattern(g, keyword, region, o)
			}
			let hourLetters = hourLetterOf(hourCycle)
			let skeleton = ""
			skeleton += textSkeleton(o.weekday, "E")
			skeleton += textSkeleton(o.era, "G")
			skeleton += numericSkeleton(o.year, "y")
			skeleton += monthSkeleton(o.month)
			skeleton += numericSkeleton(o.day, "d")
			skeleton += textSkeleton(o.dayPeriod, "B")
			skeleton += numericSkeleton(o.hour, hourLetters)
			skeleton += numericSkeleton(o.minute, "m")
			skeleton += numericSkeleton(o.second, "s")
			let digits = o.fractionalSecondDigits
			digits = 3 when digits > 3
			skeleton += "S".repeat(digits) when digits > 0
			skeleton += zoneSkeleton(o.timeZoneName)
			let dateFields = o.weekday != TextField.Off || o.year != NumericField.Off || o.month != MonthField.Off || o.day != NumericField.Off
			let timeFields = o.dayPeriod != TextField.Off || o.hour != NumericField.Off || o.minute != NumericField.Off || o.second != NumericField.Off || digits > 0
			let needDefaults = !(required != requireTime && dateFields) && !(required != requireDate && timeFields)
			skeleton += "yMd" when needDefaults && (defaults := defaultDate || defaultAll)
			skeleton += hourLetterOf(hourCycle) + "ms" when needDefaults && (defaults := defaultTime || defaultAll)
			let cycle = o.hour != NumericField.Off ?? (hourCycle, HourCycle.Auto)
			return (replaceHourCycle(g.bestPattern(skeleton, true), cycle), "", "")
		}

		// ICU's date and time style patterns, joined by the locale's glue;
		// a time pattern rebuilt from its skeleton when the hour cycle is not
		// the pattern's (V8's DateTimeStylePattern).
		internal def stylePattern(g dtfmt.Generator, keyword string, region string, o DateTimeOptions) (string, string, string) {
			let dateWidth = styleName(o.dateStyle)
			let timeWidth = styleName(o.timeStyle)
			let date = o.dateStyle == DateTimeStyle.Off ?? ("", calendarValue("dateFormats/" + dateWidth))
			let dateOverride = o.dateStyle == DateTimeStyle.Off ?? ("", calendarValue("dateFormats-numbers/" + dateWidth))
			return (date, dateOverride, "") when o.timeStyle == DateTimeStyle.Off
			let time = timeStylePattern(o.timeStyle, keyword, region)
			// A time pattern built for -u-hc carries no override.
			let timeOverride = keyword == "" ?? (calendarValue("timeFormats-numbers/" + timeWidth), "")
			let text = time
			// ICU files a time style's override as the date's when no date shows.
			let dateNumbers = timeOverride
			let timeNumbers = ""
			if date != "" {
				let glue = calendarValue("dateTimeFormats-atTime/standard/" + dateWidth)
				glue = calendarValue("dateTimeFormats/" + dateWidth) when glue == ""
				text = dtfmt.glue(glue, time, date)
				dateNumbers = dateOverride
				timeNumbers = timeOverride
			}
			return (text, dateNumbers, timeNumbers) when hourCycleOfPattern(text) == hourCycle
			let skeleton = replaceSkeleton(dtfmt.skeletonText(text), hourCycle)
			return (replaceHourCycle(g.bestPattern(skeleton, true), hourCycle), "", "")
		}

		// ICU's time style pattern: the calendar's, or with -u-hc the best
		// pattern for the style's skeleton from the locale's own hour data.
		// (ICU also does this for a locale whose region is not its data's;
		// the resolved locale always is its data's.)
		internal def timeStylePattern(s DateTimeStyle, keyword string, region string) string {
			let width = styleName(s)
			if keyword != "" {
				let g = dtfmt.generators.get(data, calendarName, numberingSystem, resolved.language.code, region, keyword, false)
				return g.bestPattern(timeSkeletons[styleIndex(s)], false)
			}
			return calendarValue("timeFormats/" + width)
		}

		internal def calendarValue(path string) string {
			return dtfmt.calendarValue(data, calendarName, path)
		}

		// The locale ICU looks day period rules up by: its language, script
		// and region.
		internal def ruleTag() string {
			let tag = resolved.language.code
			tag += "-" + resolved.script.code when resolved.script.code != ""
			tag += "-" + resolved.region.code when resolved.region.code != ""
			return tag
		}

		// The numbering systems the pattern's fields take (ICU's
		// processOverrideString): a system for all date (or time) fields, or
		// "letter=system" for one. Japanese dates written with 年 count the
		// first year of an era as 元 (ICU's Gannen rule).
		internal def resolveOverrides(text string, givenDateNumbers string, timeNumbers string) dtfmt.Overrides {
			let dateNumbers = givenDateNumbers
			dateNumbers = "y=jpanyear" when dateNumbers == "" && calendar == Calendar.Japanese && resolved.language.code == "ja" && text.contains("年")
			let o = dtfmt.Overrides{systems: map<string, dtfmt.NumberSystem>{}, hebrewYears: dateNumbers == "hebr"}
			applyOverride(o, dateNumbers, dateFieldLetters)
			applyOverride(o, timeNumbers, timeFieldLetters)
			return o
		}

		internal def applyOverride(o dtfmt.Overrides, spec string, letters string[]) {
			return when spec == ""
			for let part in spec.split(";") {
				let eq = part.indexOf("=")
				let name = eq < 0 ?? (part, part[eq + 1:])
				let system = dtfmt.NumberSystem{digits: systemDigitsOf(name)}
				if isAlgorithmicSystem(name) {
					let (ruleLocale, rules) = algorithmicRulesOf(name)
					system = dtfmt.NumberSystem{digits: string[], ruleLocale: ruleLocale, rules: rules, symbols: latinRbnfSymbols(data)}
				}
				for let letter in (eq < 0 ?? (letters, string[part[0:1]])) {
					o.systems[letter] = system
				}
			}
		}
	}

	// Form is a pattern compiled for one kind of value.
	internal struct Form {
		pattern   string // "" when the options show no field of the kind
		items     dtfmt.Item[]
		overrides dtfmt.Overrides
	}

	internal def noOverrides() dtfmt.Overrides {
		return dtfmt.Overrides{systems: map<string, dtfmt.NumberSystem>{}}
	}

	// The fields a pattern must show and the defaults it takes without any
	// (ECMA-402's required and defaults), and the options plain values take.
	internal const requireAny = 0
	internal const requireDate = 1
	internal const requireTime = 2
	internal const defaultDate = 1
	internal const defaultTime = 2
	internal const defaultAll = 3
	internal const dateOptions = 1
	internal const timeOptions = 2
	internal const dateTimeOptions = 3

	// Whether the options ask for a date or time field.
	internal def hasField(o DateTimeOptions) bool {
		return o.weekday != TextField.Off || o.era != TextField.Off || o.year != NumericField.Off || o.month != MonthField.Off || o.day != NumericField.Off || o.dayPeriod != TextField.Off || o.hour != NumericField.Off || o.minute != NumericField.Off || o.second != NumericField.Off || o.fractionalSecondDigits > 0
	}

	// The pattern letters of the fields ICU's date and time overrides cover.
	internal let dateFieldLetters = string["y", "M", "d", "D", "F", "w", "W", "Y", "u", "g", "c", "L", "Q", "q", "U", "r"]
	internal let timeFieldLetters = string["k", "H", "m", "s", "S", "h", "K", "A", "Z", "O"]

	// The CLDR calendar data a calendar's dates are written with.
	internal def cldrCalendarName(c Calendar) string {
		match c {
			case Calendar.Gregorian:
				return "gregorian"
			case Calendar.EthiopicAmeteAlem:
				return "ethiopic-amete-alem"
			default:
				return calendarId(c)
		}
	}

	internal def fromEpochDayYear(day int64) int {
		return calendars.fieldsOf(Calendar.Gregorian, day).year
	}

	internal def floorDivide(a int, b int) int {
		let q = a / b
		return (a % b != 0 && (a < 0) != (b < 0)) ?? (q - 1, q)
	}

	// A region's week data value ("firstDay", "minDays", ...), else the
	// world's, else fallback.
	internal def weekData(kind string, region string, fallback string) string {
		let v = tables.value("supplemental/weekData", "root", "weekData/" + kind + "/" + region)
		v = tables.value("supplemental/weekData", "root", "weekData/" + kind + "/001") when v is none
		return v is none ?? (fallback, v)
	}

	// 1 for Sunday to 7 for Saturday.
	internal def weekdayNumber(key string) int {
		let i = dtfmt.weekdayKeys.indexOf(key)
		return i < 0 ?? (2, i + 1)
	}

	// ICU's own time skeletons per style (full to short), j being the
	// locale's hour.
	internal let timeSkeletons = string["jmmsszzzz", "jmmssz", "jmmss", "jmm"]

	internal def styleIndex(s DateTimeStyle) int {
		match s {
			case DateTimeStyle.Full:
				return 0
			case DateTimeStyle.Long:
				return 1
			case DateTimeStyle.Medium:
				return 2
			default:
				return 3
		}
	}

	internal def styleName(s DateTimeStyle) string {
		match s {
			case DateTimeStyle.Full:
				return "full"
			case DateTimeStyle.Long:
				return "long"
			case DateTimeStyle.Medium:
				return "medium"
			default:
				return "short"
		}
	}

	internal def hourCycleOfLetter(letter string) HourCycle {
		match letter {
			case "K":
				return HourCycle.H11
			case "h":
				return HourCycle.H12
			case "k":
				return HourCycle.H24
			default:
				return HourCycle.H23
		}
	}

	internal def hourCycleNamed(keyword string) HourCycle {
		match keyword {
			case "h11":
				return HourCycle.H11
			case "h12":
				return HourCycle.H12
			case "h23":
				return HourCycle.H23
			case "h24":
				return HourCycle.H24
			default:
				return HourCycle.Auto
		}
	}

	internal def hourLetterOf(c HourCycle) string {
		match c {
			case HourCycle.H11:
				return "K"
			case HourCycle.H12:
				return "h"
			case HourCycle.H24:
				return "k"
			case HourCycle.H23:
				return "H"
			default:
				return "j"
		}
	}

	// The cycle of the first hour field outside quotes, or Auto.
	internal def hourCycleOfPattern(pattern string) HourCycle {
		let quoted = false
		for let ch in pattern {
			let c = string(ch)
			if c == "'" {
				quoted = !quoted
			} else if !quoted && (c := "K" || "h" || "H" || "k") {
				return hourCycleOfLetter(c)
			}
		}
		return HourCycle.Auto
	}

	// V8's ReplaceHourCycleInPattern: every hour field takes the cycle's
	// letter, with a space after a day field it follows directly.
	internal def replaceHourCycle(pattern string, c HourCycle) string {
		return pattern when c == HourCycle.Auto
		let letter = hourLetterOf(c)
		let out = ""
		let replace = true
		let last = ""
		for let ch in pattern {
			let s = string(ch)
			if s == "'" {
				replace = !replace
				out += s
			} else if s := "H" || "h" || "K" || "k" {
				out += " " when replace && last == "d"
				out += replace ?? (letter, s)
			} else {
				out += s
			}
			last = s
		}
		return out
	}

	// V8's ReplaceSkeleton: day periods dropped, hours in the cycle's letter.
	internal def replaceSkeleton(skeleton string, c HourCycle) string {
		let letter = hourLetterOf(c)
		let out = ""
		for let ch in skeleton {
			let s = string(ch)
			if s := "a" || "b" || "B" {
				continue
			}
			out += (s := "h" || "H" || "K" || "k") ?? (letter, s)
		}
		return out
	}

	internal def textSkeleton(f TextField, letter string) string {
		match f {
			case TextField.Narrow:
				return letter.repeat(5)
			case TextField.Long:
				return letter.repeat(4)
			case TextField.Short:
				return letter == "E" || letter == "G" ?? (letter.repeat(3), letter)
			default:
				return ""
		}
	}

	internal def numericSkeleton(f NumericField, letter string) string {
		match f {
			case NumericField.Numeric:
				return letter
			case NumericField.TwoDigit:
				return letter + letter
			default:
				return ""
		}
	}

	internal def monthSkeleton(f MonthField) string {
		match f {
			case MonthField.Numeric:
				return "M"
			case MonthField.TwoDigit:
				return "MM"
			case MonthField.Narrow:
				return "MMMMM"
			case MonthField.Short:
				return "MMM"
			case MonthField.Long:
				return "MMMM"
			default:
				return ""
		}
	}

	internal def zoneSkeleton(f ZoneNameField) string {
		match f {
			case ZoneNameField.Short:
				return "z"
			case ZoneNameField.Long:
				return "zzzz"
			case ZoneNameField.ShortOffset:
				return "O"
			case ZoneNameField.LongOffset:
				return "OOOO"
			case ZoneNameField.ShortGeneric:
				return "v"
			case ZoneNameField.LongGeneric:
				return "vvvv"
			default:
				return ""
		}
	}
}
