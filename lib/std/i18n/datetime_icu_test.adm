		@test()
		def set11() {
			let n = 0
			let f = new DateTimeFormat(new Locale("en"))
			f = new DateTimeFormat(new Locale("en-US"), DateTimeOptions{timeZone: "UTC", dateStyle: DateTimeStyle.Short, timeStyle: DateTimeStyle.Short, hourCycle: HourCycle.H23})
			n += same(f, 1790838309123, "10/1/26, 07:05")
			n += same(f, 1709251199999, "2/29/24, 23:59")
			n += same(f, 946641600000, "12/31/99, 12:00")
			n += same(f, 1767225600000, "1/1/26, 00:00")
			n += same(f, -14182940000, "7/20/69, 20:17")
			n += same(f, 961083000050, "6/15/00, 15:30")
			n += same(f, -2203876800000, "3/1/00, 04:00")
			f = new DateTimeFormat(new Locale("en-GB"), DateTimeOptions{timeZone: "UTC", dateStyle: DateTimeStyle.Short, timeStyle: DateTimeStyle.Short, hourCycle: HourCycle.H23})
			n += same(f, 1790838309123, "01/10/2026, 07:05")
			n += same(f, 1709251199999, "29/02/2024, 23:59")
			n += same(f, 946641600000, "31/12/1999, 12:00")
			n += same(f, 1767225600000, "01/01/2026, 00:00")
			n += same(f, -14182940000, "20/07/1969, 20:17")
			n += same(f, 961083000050, "15/06/2000, 15:30")
