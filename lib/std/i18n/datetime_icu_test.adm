			n += plainDateTime(f, "-000500-03-01T12:00:00", "501年3月")
			n += plainDateTime(f, "1000-06-15T00:00:00", "1000年6月")
			f = new DateTimeFormat(new Locale("ar-EG"), DateTimeOptions{timeZone: "UTC", year: NumericField.Numeric, month: MonthField.Narrow})
			n += plainDate(f, "2026-10-01", "ك ٢٠٢٦")
			n += plainDate(f, "-000500-03-01", "م ٥٠١")
