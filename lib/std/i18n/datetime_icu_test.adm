			n += plainDateTime(f, "-000500-03-01T12:00:00", "M 501")
			n += plainDateTime(f, "1000-06-15T00:00:00", "J 1000")
			f = new DateTimeFormat(new Locale("de-DE"), DateTimeOptions{timeZone: "UTC", year: NumericField.Numeric, month: MonthField.Narrow})
			n += plainDate(f, "2026-10-01", "O 2026")
			n += plainDate(f, "-000500-03-01", "M 501")
			n += plainDate(f, "0001-01-01", "J 1")
			n += plainDate(f, "9999-12-31", "D 9999")
