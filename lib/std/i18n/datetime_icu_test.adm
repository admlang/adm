		@test()
		def calendar3() {
			let n = 0
			let f = new DateTimeFormat(new Locale("en"))
			f = new DateTimeFormat(new Locale("en-u-ca-buddhist"), DateTimeOptions{timeZone: "UTC", dateStyle: DateTimeStyle.Short})
			n += same(f, 1708430400000, "2/20/2567 BE")
			n += same(f, 1710504000000, "3/15/2567 BE")
			n += same(f, 1681128000000, "4/10/2566 BE")
			n += same(f, 1685016000000, "5/25/2566 BE")
			n += same(f, 1556712000000, "5/1/2562 BE")
			n += same(f, 600264000000, "1/8/2532 BE")
			n += same(f, -1812110400000, "7/30/2455 BE")
			n += same(f, -1357560000000, "12/25/2469 BE")
			n += same(f, 1790838309000, "10/1/2569 BE")
			n += same(f, -2177452800000, "1/1/2444 BE")
			n += same(f, -2208945600000, "1/1/2443 BE")
			n += same(f, 4133980799000, "12/31/2643 BE")
			f = new DateTimeFormat(new Locale("en-u-ca-chinese"), DateTimeOptions{timeZone: "UTC", dateStyle: DateTimeStyle.Short})
			n += same(f, 1708430400000, "1/11/2024")
			n += same(f, 1710504000000, "2/6/2024")
			n += same(f, 1681128000000, "2bis/20/2023")
			n += same(f, 1685016000000, "4/7/2023")
			n += same(f, 1556712000000, "3/27/2019")
			n += same(f, 600264000000, "12/1/1988")
			n += same(f, -1812110400000, "6/17/1912")
			n += same(f, -1357560000000, "11/21/1926")
			n += same(f, 1790838309000, "8/21/2026")
			n += same(f, -2177452800000, "11/11/1900")
			n += same(f, -2208945600000, "12/1/1899")
			n += same(f, 4133980799000, "12/1/2100")
			f = new DateTimeFormat(new Locale("en-u-ca-coptic"), DateTimeOptions{timeZone: "UTC", dateStyle: DateTimeStyle.Short})
			n += same(f, 1708430400000, "6/12/1740 AM")
			n += same(f, 1710504000000, "7/6/1740 AM")
			n += same(f, 1681128000000, "8/2/1739 AM")
