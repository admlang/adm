			n += plainTimeOfDay(f, "07:05:09", "07:05")
			n += plainDateTime(f, "2026-10-01T07:05:09.123", "07:05")
			f = new DateTimeFormat(new Locale("ja-JP-u-ca-japanese"), DateTimeOptions{timeZone: "UTC", timeStyle: DateTimeStyle.Short})
			n += plainDate(f, "2026-10-01", "<error>")
			n += plainDate(f, "9999-12-31", "<error>")
			n += plainDate(f, "2024-02-29", "<error>")
			n += plainTimeOfDay(f, "00:00:00", "0:00")
			n += plainTimeOfDay(f, "12:00:00", "12:00")
			n += plainTimeOfDay(f, "23:59:59.123", "23:59")
			n += plainTimeOfDay(f, "07:05:09", "7:05")
			n += plainDateTime(f, "2026-10-01T07:05:09.123", "7:05")
			f = new DateTimeFormat(new Locale("en-u-ca-islamic-umalqura"), DateTimeOptions{timeZone: "UTC", timeStyle: DateTimeStyle.Short})
			n += plainDate(f, "2026-10-01", "<error>")
			n += plainDate(f, "-000500-03-01", "<error>")
			n += plainDate(f, "0001-01-01", "<error>")
			n += plainDate(f, "9999-12-31", "<error>")
			n += plainDate(f, "1582-10-10", "<error>")
			n += plainDate(f, "2024-02-29", "<error>")
			n += plainTimeOfDay(f, "00:00:00", "12:00 AM")
			n += plainTimeOfDay(f, "12:00:00", "12:00 PM")
			n += plainTimeOfDay(f, "23:59:59.123", "11:59 PM")
			n += plainTimeOfDay(f, "07:05:09", "7:05 AM")
			n += plainDateTime(f, "2026-10-01T07:05:09.123", "7:05 AM")
			n += plainDateTime(f, "-000500-03-01T12:00:00", "12:00 PM")
			n += plainDateTime(f, "1000-06-15T00:00:00", "12:00 AM")
			assert n == 0
		}

