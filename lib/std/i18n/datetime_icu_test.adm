		@test()
		def plain18() {
			let n = 0
			let f = new DateTimeFormat(new Locale("en"))
			f = new DateTimeFormat(new Locale("en-US"), DateTimeOptions{timeZone: "UTC", year: NumericField.Numeric, month: MonthField.Narrow})
