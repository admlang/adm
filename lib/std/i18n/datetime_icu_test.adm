		@test()
		def plain14() {
			let n = 0
			let f = new DateTimeFormat(new Locale("en"))
			f = new DateTimeFormat(new Locale("en-US"), DateTimeOptions{timeZone: "UTC", weekday: TextField.Long, year: NumericField.Numeric, month: MonthField.Short, day: NumericField.Numeric})
			n += plainDate(f, "2026-10-01", "Thursday, Oct 1, 2026")
			n += plainDate(f, "-000500-03-01", "Thursday, Mar 1, 501")
			n += plainDate(f, "0001-01-01", "Monday, Jan 1, 1")
			n += plainDate(f, "9999-12-31", "Friday, Dec 31, 9999")
			n += plainDate(f, "1582-10-10", "Sunday, Oct 10, 1582")
			n += plainDate(f, "2024-02-29", "Thursday, Feb 29, 2024")
			n += plainTimeOfDay(f, "00:00:00", "<error>")
			n += plainTimeOfDay(f, "12:00:00", "<error>")
			n += plainTimeOfDay(f, "23:59:59.123", "<error>")
			n += plainTimeOfDay(f, "07:05:09", "<error>")
			n += plainDateTime(f, "2026-10-01T07:05:09.123", "Thursday, Oct 1, 2026")
			n += plainDateTime(f, "-000500-03-01T12:00:00", "Thursday, Mar 1, 501")
			n += plainDateTime(f, "1000-06-15T00:00:00", "Sunday, Jun 15, 1000")
			f = new DateTimeFormat(new Locale("de-DE"), DateTimeOptions{timeZone: "UTC", weekday: TextField.Long, year: NumericField.Numeric, month: MonthField.Short, day: NumericField.Numeric})
			n += plainDate(f, "2026-10-01", "Donnerstag, 1. Okt. 2026")
			n += plainDate(f, "-000500-03-01", "Donnerstag, 1. März 501")
			n += plainDate(f, "0001-01-01", "Montag, 1. Jan. 1")
			n += plainDate(f, "9999-12-31", "Freitag, 31. Dez. 9999")
			n += plainDate(f, "1582-10-10", "Sonntag, 10. Okt. 1582")
			n += plainDate(f, "2024-02-29", "Donnerstag, 29. Feb. 2024")
			n += plainTimeOfDay(f, "00:00:00", "<error>")
			n += plainTimeOfDay(f, "12:00:00", "<error>")
			n += plainTimeOfDay(f, "23:59:59.123", "<error>")
			n += plainTimeOfDay(f, "07:05:09", "<error>")
			n += plainDateTime(f, "2026-10-01T07:05:09.123", "Donnerstag, 1. Okt. 2026")
			n += plainDateTime(f, "-000500-03-01T12:00:00", "Donnerstag, 1. März 501")
			n += plainDateTime(f, "1000-06-15T00:00:00", "Sonntag, 15. Juni 1000")
			f = new DateTimeFormat(new Locale("ja-JP"), DateTimeOptions{timeZone: "UTC", weekday: TextField.Long, year: NumericField.Numeric, month: MonthField.Short, day: NumericField.Numeric})
			n += plainDate(f, "2026-10-01", "2026年10月1日木曜日")
