			f = new DateTimeFormat(new Locale("de-DE"), DateTimeOptions{timeZone: "UTC", year: NumericField.TwoDigit, month: MonthField.TwoDigit, day: NumericField.TwoDigit})
			n += plainDate(f, "2026-10-01", "01.10.26")
