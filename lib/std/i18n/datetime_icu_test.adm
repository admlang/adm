			n += plainTimeOfDay(f, "12:00:00", "<error>")
			n += plainTimeOfDay(f, "23:59:59.123", "<error>")
			n += plainTimeOfDay(f, "07:05:09", "<error>")
			n += plainDateTime(f, "2026-10-01T07:05:09.123", "O 2026")
			n += plainDateTime(f, "-000500-03-01T12:00:00", "M 501")
			n += plainDateTime(f, "1000-06-15T00:00:00", "J 1000")
			f = new DateTimeFormat(new Locale("ja-JP"), DateTimeOptions{timeZone: "UTC", year: NumericField.Numeric, month: MonthField.Narrow})
			n += plainDate(f, "2026-10-01", "2026年10月")
			n += plainDate(f, "-000500-03-01", "501年3月")
			n += plainDate(f, "0001-01-01", "1年1月")
			n += plainDate(f, "9999-12-31", "9999年12月")
			n += plainDate(f, "1582-10-10", "1582年10月")
			n += plainDate(f, "2024-02-29", "2024年2月")
			n += plainTimeOfDay(f, "00:00:00", "<error>")
			n += plainTimeOfDay(f, "12:00:00", "<error>")
