			n += plainDateTime(f, "2026-10-01T07:05:09.123", "7 in the morning")
			n += plainDateTime(f, "-000500-03-01T12:00:00", "12 noon")
			n += plainDateTime(f, "1000-06-15T00:00:00", "12 in the morning")
			assert n == 0
		}

