		@test()
		def plain31() {
			let n = 0
			let f = new DateTimeFormat(new Locale("en"))
			f = new DateTimeFormat(new Locale("en-US"), DateTimeOptions{timeZone: "UTC", hour: NumericField.Numeric, minute: NumericField.Numeric, second: NumericField.Numeric, fractionalSecondDigits: 2})
			n += plainDate(f, "2026-10-01", "<error>")
			n += plainDate(f, "-000500-03-01", "<error>")
			n += plainDate(f, "0001-01-01", "<error>")
			n += plainDate(f, "9999-12-31", "<error>")
			n += plainDate(f, "1582-10-10", "<error>")
			n += plainDate(f, "2024-02-29", "<error>")
			n += plainTimeOfDay(f, "00:00:00", "12:00:00.00 AM")
