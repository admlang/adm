			n += same(f, -14182940000, "20.7.1969, 8:17 PM")
			n += same(f, 961083000050, "15.6.2000, 3:30 PM")
			n += same(f, -2203876800000, "1.3.1900, 4:00 AM")
			f = new DateTimeFormat(new Locale("en-u-nu-arab"), DateTimeOptions{timeZone: "UTC", year: NumericField.Numeric, month: MonthField.Numeric, day: NumericField.Numeric, hour: NumericField.Numeric, minute: NumericField.Numeric})
			n += same(f, 1790838309123, "١٠/١/٢٠٢٦, ٧:٠٥ AM")
