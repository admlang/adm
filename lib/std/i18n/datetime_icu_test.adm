			n += plainDate(f, "2024-02-29", "8/19/1445 AH")
			n += plainTimeOfDay(f, "00:00:00", "12:00 AM")
			n += plainTimeOfDay(f, "12:00:00", "12:00 PM")
			n += plainTimeOfDay(f, "23:59:59.123", "11:59 PM")
			n += plainTimeOfDay(f, "07:05:09", "7:05 AM")
			n += plainDateTime(f, "2026-10-01T07:05:09.123", "4/20/1448 AH, 7:05 AM")
			n += plainDateTime(f, "-000500-03-01T12:00:00", "3/2/-1156 AH, 12:00 PM")
			n += plainDateTime(f, "1000-06-15T00:00:00", "7/3/390 AH, 12:00 AM")
			assert n == 0
		}

