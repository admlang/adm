			n += same(f, -2203876800000, "4 AM")
			f = new DateTimeFormat(new Locale("en-u-nu-arab"), DateTimeOptions{timeZone: "UTC", hour: NumericField.Numeric, hour12: true})
			n += same(f, 1790838309123, "٧ AM")
			n += same(f, 1709251199999, "١١ PM")
			n += same(f, 946641600000, "١٢ PM")
			n += same(f, 1767225600000, "١٢ AM")
			n += same(f, -14182940000, "٨ PM")
			n += same(f, 961083000050, "٣ PM")
			n += same(f, -2203876800000, "٤ AM")
			assert n == 0
		}

