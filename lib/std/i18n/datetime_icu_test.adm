		@test()
		def calendar1() {
			let n = 0
			let f = new DateTimeFormat(new Locale("en"))
			f = new DateTimeFormat(new Locale("en-u-ca-buddhist"), DateTimeOptions{timeZone: "UTC", dateStyle: DateTimeStyle.Long})
			n += same(f, 1708430400000, "February 20, 2567 BE")
			n += same(f, 1710504000000, "March 15, 2567 BE")
			n += same(f, 1681128000000, "April 10, 2566 BE")
			n += same(f, 1685016000000, "May 25, 2566 BE")
			n += same(f, 1556712000000, "May 1, 2562 BE")
			n += same(f, 600264000000, "January 8, 2532 BE")
			n += same(f, -1812110400000, "July 30, 2455 BE")
			n += same(f, -1357560000000, "December 25, 2469 BE")
			n += same(f, 1790838309000, "October 1, 2569 BE")
			n += same(f, -2177452800000, "January 1, 2444 BE")
			n += same(f, -2208945600000, "January 1, 2443 BE")
			n += same(f, 4133980799000, "December 31, 2643 BE")
			f = new DateTimeFormat(new Locale("en-u-ca-chinese"), DateTimeOptions{timeZone: "UTC", dateStyle: DateTimeStyle.Long})
			n += same(f, 1708430400000, "First Month 11, 2024(jia-chen)")
			n += same(f, 1710504000000, "Second Month 6, 2024(jia-chen)")
			n += same(f, 1681128000000, "Second Monthbis 20, 2023(gui-mao)")
			n += same(f, 1685016000000, "Fourth Month 7, 2023(gui-mao)")
			n += same(f, 1556712000000, "Third Month 27, 2019(ji-hai)")
			n += same(f, 600264000000, "Twelfth Month 1, 1988(wu-chen)")
			n += same(f, -1812110400000, "Sixth Month 17, 1912(ren-zi)")
			n += same(f, -1357560000000, "Eleventh Month 21, 1926(bing-yin)")
			n += same(f, 1790838309000, "Eighth Month 21, 2026(bing-wu)")
			n += same(f, -2177452800000, "Eleventh Month 11, 1900(geng-zi)")
			n += same(f, -2208945600000, "Twelfth Month 1, 1899(ji-hai)")
			n += same(f, 4133980799000, "Twelfth Month 1, 2100(geng-shen)")
			f = new DateTimeFormat(new Locale("en-u-ca-coptic"), DateTimeOptions{timeZone: "UTC", dateStyle: DateTimeStyle.Long})
			n += same(f, 1708430400000, "Amshir 12, 1740 AM")
			n += same(f, 1710504000000, "Baramhat 6, 1740 AM")
			n += same(f, 1681128000000, "Baramouda 2, 1739 AM")
			n += same(f, 1685016000000, "Bashans 17, 1739 AM")
