// Generated by ~/.cache/adm-scratch/i18n/kit/gen_dtf_cases.js from ICU 78.3 (CLDR 48.0).
partial module std.i18n {
	use (
		std.testing
		std.time::(Date, DateTime, TimeOfDay, fromUnixNs, parseDate, parseDateTime, parseTimeOfDay)
	)

	check "DateTimeFormat matches ICU" {
		def compare(f DateTimeFormat, what string, got string, want string) int {
			return 0 when got.replace("\u202f", " ") == want
			println(f.locale.str() + " " + what + ": got [" + got + "] want [" + want + "]")
			return 1
		}

		def plainDate(f DateTimeFormat, text string, want string) int {
			let d = parseDate(text) onerror recover new Date(1, 1, 1)
			return compare(f, text, f.format(d) onerror recover "<error>", want)
		}

		def plainTimeOfDay(f DateTimeFormat, text string, want string) int {
			let t = parseTimeOfDay(text) onerror recover new TimeOfDay(0, 0)
			return compare(f, text, f.format(t) onerror recover "<error>", want)
		}

		def plainDateTime(f DateTimeFormat, text string, want string) int {
			let dt = parseDateTime(text) onerror recover new DateTime(1, 1, 1)
			return compare(f, text, f.format(dt) onerror recover "<error>", want)
		}

		def same(f DateTimeFormat, ms int64, want string) int {
			let got = f.format(fromUnixNs(ms * 1000000))
			return 0 when got.replace(" ", " ") == want
			println(f.locale.str() + " " + ms.str() + " [" + f.pattern + "]: got [" + got + "] want [" + want + "]")
			return 1
		}

