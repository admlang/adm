			n += plainDateTime(f, "-000500-03-01T12:00:00", "3/2/-1156 AH, 12:00:00 PM")
			n += plainDateTime(f, "1000-06-15T00:00:00", "7/3/390 AH, 12:00:00 AM")
			assert n == 0
		}

