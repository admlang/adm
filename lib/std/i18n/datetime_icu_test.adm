			n += plainTimeOfDay(f, "23:59:59.123", "11 PM")
			n += plainTimeOfDay(f, "07:05:09", "7 AM")
			n += plainDateTime(f, "2026-10-01T07:05:09.123", "Thursday 7 AM")
			n += plainDateTime(f, "-000500-03-01T12:00:00", "Thursday 12 PM")
			n += plainDateTime(f, "1000-06-15T00:00:00", "Sunday 12 AM")
			assert n == 0
		}
	}
}
