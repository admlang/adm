			n += same(f, 1767225600000, "١/١/٢٠٢٦, ١٢:٠٠ AM")
			n += same(f, -14182940000, "٧/٢٠/١٩٦٩, ٨:١٧ PM")
			n += same(f, 961083000050, "٦/١٥/٢٠٠٠, ٣:٣٠ PM")
			n += same(f, -2203876800000, "٣/١/١٩٠٠, ٤:٠٠ AM")
			assert n == 0
		}

