partial module std.i18n {
	use (
		std.testing
		std.time::(Date, DateTime, TimeOfDay, fromUnixNs, Time)
	)

	check "DateTimeFormat" {
		// 2026-10-01T07:05:09.123Z
		def instant() Time {
			return fromUnixNs(int64(1790838309123) * 1000000)
		}

		@test()
		def writesCldrSpaces() {
			// CLDR puts U+202F before AM/PM and U+2009 in Chinese date-time glue;
			// browsers replace both with spaces, ICU and this format keep them.
			let f = new DateTimeFormat(new Locale("en-US"), DateTimeOptions{timeStyle: DateTimeStyle.Short, timeZone: "UTC"})
			assert f.format(instant()) == "7:05 AM"
			let zh = new DateTimeFormat(new Locale("zh-TW"), DateTimeOptions{dateStyle: DateTimeStyle.Short, timeStyle: DateTimeStyle.Short, timeZone: "UTC"})
			assert zh.format(instant()) == "2026/10/1 清晨7:05"
		}

		@test()
		def resolvesOptions() {
			let f = new DateTimeFormat(new Locale("en-US-u-hc-h23-ca-buddhist"), DateTimeOptions{hour: NumericField.Numeric, minute: NumericField.TwoDigit, timeZone: "UTC"})
			assert f.hourCycle == HourCycle.H23
			assert f.calendar == Calendar.Buddhist
			assert f.format(instant()) == "07:05"
			let twelve = new DateTimeFormat(new Locale("ja-JP"), DateTimeOptions{hour: NumericField.Numeric, hour12: true, timeZone: "UTC"})
			assert twelve.hourCycle == HourCycle.H11
			let thai = new DateTimeFormat(new Locale("th-TH"), DateTimeOptions{timeZone: "UTC"})
			assert thai.calendar == Calendar.Buddhist
			assert thai.format(instant()) == "1/10/2569"
			// fr-US is formatted as fr: ICU holds no fr-US data.
			let us = new DateTimeFormat(new Locale("fr-US"), DateTimeOptions{timeStyle: DateTimeStyle.Short, timeZone: "UTC"})
			assert us.hourCycle == HourCycle.H23
			// The styles take precedence over the fields.
			let styled = new DateTimeFormat(new Locale("en-US"), DateTimeOptions{dateStyle: DateTimeStyle.Medium, hour: NumericField.Numeric, timeZone: "UTC"})
			assert styled.format(instant()) == "Oct 1, 2026"
		}

		@test()
		def writesZones() {
			let z = new ZonedDateTime(new DateTime(2026, 7, 1, 9, 30), new TimeZone("Asia/Kolkata"))
			let f = new DateTimeFormat(new Locale("en-GB"), DateTimeOptions{hour: NumericField.Numeric, minute: NumericField.TwoDigit, timeZoneName: ZoneNameField.ShortOffset})
			assert f.format(z) == "09:30 GMT+5:30"
			let berlin = new DateTimeFormat(new Locale("de-DE"), DateTimeOptions{timeStyle: DateTimeStyle.Short, timeZone: "Europe/Berlin"})
			assert berlin.format(instant()) == "09:05"
		}

		@test()
		def writesPlainValues() !none {
			let f = new DateTimeFormat(new Locale("en-US"), DateTimeOptions{dateStyle: DateTimeStyle.Long})
			assert (try f.format(new Date(-500, 3, 1))) == "March 1, 501"
			assert (try f.format(new Date(9999, 12, 31))) == "December 31, 9999"
			assert f.format(new TimeOfDay(9, 5)) is error
			let time = new DateTimeFormat(new Locale("en-US"), DateTimeOptions{hour: NumericField.Numeric, minute: NumericField.TwoDigit})
			assert (try time.format(new TimeOfDay(21, 5))) == "9:05 PM"
			assert time.format(new Date(2026, 10, 1)) is error
			assert (try time.format(new DateTime(2026, 10, 1, 21, 5))) == "9:05 PM"
			let plain = new DateTimeFormat(new Locale("de-DE"))
			assert (try plain.format(new Date(2026, 10, 1))) == "1.10.2026"
			assert (try plain.format(new TimeOfDay(7, 5, 9))) == "07:05:09"
			assert (try plain.format(new DateTime(2026, 10, 1, 7, 5, 9))) == "1.10.2026, 07:05:09"
			return none
		}

		@test()
		def writesCalendarNumerals() !none {
			let hebrew = new DateTimeFormat(new Locale("he-IL-u-ca-hebrew"), DateTimeOptions{dateStyle: DateTimeStyle.Long})
			assert (try hebrew.format(new Date(2024, 3, 15))) == "ה׳ באדר ב׳ תשפ״ד"
			let japanese = new DateTimeFormat(new Locale("ja-JP-u-ca-japanese"), DateTimeOptions{dateStyle: DateTimeStyle.Long})
			assert (try japanese.format(new Date(2019, 5, 1))) == "令和元年5月1日"
			let chinese = new DateTimeFormat(new Locale("zh-u-ca-chinese"), DateTimeOptions{dateStyle: DateTimeStyle.Long})
			assert (try chinese.format(new Date(2023, 4, 10))) == "2023癸卯年闰二月二十"
			return none
		}
	}
}
