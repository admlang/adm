// Writing a date pattern's fields, as ICU's SimpleDateFormat subFormat does.

internal partial module std.i18n.dtfmt {
	use (
		std.i18n.rbnf
		std.math::(Decimal)
	)

	// NumberSystem writes a field's numbers other than in the locale's
	// digits, as an ICU numbering override asks ("hebr", "d=hanidays",
	// "y=jpanyear"): in ten digits, or through RBNF rules.
	struct NumberSystem {
		digits     string[]
		ruleLocale string
		rules      string // the RBNF rule set, "" for digits
		symbols    rbnf.Symbols
	}

	// Overrides are the numbering systems a pattern's fields take, by
	// pattern letter.
	struct Overrides {
		systems     map<string, NumberSystem>
		hebrewYears bool // the whole date is in Hebrew numerals: years drop the millennium (5784 -> 784)
	}

	// Moment is what a pattern's fields read: a day of a calendar, a time of
	// day and the zone's offset.
	struct Moment {
		era          int // the CLDR era index
		year         int // y: the year of the era, the cycle year for Chinese and Dangi
		extendedYear int // u: the calendar's own continuous year
		relatedYear  int // r: the ISO year the calendar year starts in
		cyclicYear   int // U: 1 to 60, for Chinese and Dangi
		monthKey     string // the CLDR key of the month's name: "1" to "13", "7-yeartype-leap"
		monthNumber  int // the month's number as M and L write it
		leap         bool // a Chinese or Dangi leap month, written through the leap pattern
		day          int
		dayOfYear    int
		weekday      int // 1 (Sunday) to 7
		firstWeekday int // the locale's first day of the week, 1 (Sunday) to 7
		hour         int
		minute       int
		second       int
		nanosecond   int
		epochDay     int64 // for the modified Julian day (g)
		offset       int // the zone's offset, seconds east of UTC
		daylight     bool
		zone         string // the IANA zone id, "" for a bare offset
	}

	// Item is one piece of a pattern: a field (a letter repeated count times)
	// or literal text.
	struct Item {
		letter string
		count  int
		text   string
	}

	// Compile splits a pattern into fields and literal text, quotes removed.
	def compile(pattern string) Item[] {
		let out = Item[]
		let chars = string[]
		for let ch in pattern {
			chars.push(string(ch))
		}
		let text = ""
		let i = 0
		for i < chars.len() {
			let c = chars[i]
			if c == "'" {
				if i + 1 < chars.len() && chars[i + 1] == "'" {
					text += "'"
					i += 2
					continue
				}
				i++
				for i < chars.len() {
					if chars[i] == "'" {
						break unless i + 1 < chars.len() && chars[i + 1] == "'"
						text += "'"
						i += 2
						continue
					}
					text += chars[i]
					i++
				}
				i++
				continue
			}
			if isLetter(c) {
				let j = i + 1
				for j < chars.len() && chars[j] == c {
					j++
				}
				if text != "" {
					out.push(Item{text: text})
					text = ""
				}
				out.push(Item{letter: c, count: j - i})
				i = j
				continue
			}
			text += c
			i++
		}
		out.push(Item{text: text}) when text != ""
		return out
	}

	// HasLetter reports whether a compiled pattern has a field of the letter.
	def hasLetter(items Item[], letter string) bool {
		for let item in items {
			return true when item.letter == letter
		}
		return false
	}

	// Write formats the moment through the compiled pattern, fields in the
	// numbering systems the overrides give them.
	def write(items Item[], m Moment, s Symbols, o Overrides) string {
		let hasMinute = hasLetter(items, "m")
		let hasSecond = hasLetter(items, "s")
		let out = ""
		for let item in items {
			if item.letter == "" {
				out += item.text
			} else {
				out += field(item.letter, item.count, m, s, o, hasMinute, hasSecond)
			}
		}
		return out
	}

	// Number writes n with at least min and at most max digits, in the
	// symbols' digits (ICU's zeroPaddingNumber: extra high digits are cut).
	def number(n int, min int, max int, s Symbols) string {
		return digitsOf(n, min, max, s.digits, s.minus)
	}

	// The number in the field's override when it has one (RBNF rules write
	// it unpadded, as ICU does), else in the symbols' digits.
	def overridden(n int, min int, max int, s Symbols, system ?NumberSystem) string {
		return digitsOf(n, min, max, s.digits, s.minus) when system is none
		return rbnf.format(system.ruleLocale, system.rules, new Decimal(n), system.symbols) when system.rules != ""
		return digitsOf(n, min, max, system.digits, s.minus)
	}

	def digitsOf(n int, min int, max int, digits string[], minus string) string {
		let negative = n < 0
		let text = (negative ?? (-n, n)).str()
		text = text[text.len() - max:] when text.len() > max
		text = "0".repeat(min - text.len()) + text when text.len() < min
		let out = negative ?? (minus, "")
		for let ch in text {
			out += digits[int(ch) - 48]
		}
		return out
	}

	def widthName(count int) string {
		return count == 4 ?? ("wide", count == 5 ?? ("narrow", "abbreviated"))
	}

	let weekdayKeys = string["sun", "mon", "tue", "wed", "thu", "fri", "sat"]

	def field(letter string, count int, m Moment, s Symbols, o Overrides, hasMinute bool, hasSecond bool) string {
		let system = o.systems.get(letter)
		let number = (n int, min int, max int, s Symbols) => overridden(n, min, max, s, system)
		match letter {
			case "G":
				return number(m.era, 1, 9, s) when s.calendar := "chinese" || "dangi"
				let set = count == 5 ?? ("eraNarrow", count == 4 ?? ("eraNames", "eraAbbr"))
				return s.name("eras/" + set + "/" + m.era.str())
			case "y":
				let year = m.year
				year -= 5000 when o.hebrewYears && year > 5000 && year < 6000
				return number(year, 2, 2, s) when count == 2
				return number(year, count, 10, s)
			case "Y":
				return number(m.year, 2, 2, s) when count == 2
				return number(m.year, count, 10, s)
			case "u":
				return number(m.extendedYear, count, 10, s)
			case "r":
				return number(m.relatedYear, count, 10, s)
			case "U":
				let name = s.name("cyclicNameSets/years/format/abbreviated/" + m.cyclicYear.str())
				return name when name != ""
				return number(m.year, 2, 2, s) when count == 2
				return number(m.year, count, 10, s)
			case "M", "L":
				let context = letter == "M" ?? ("format", "stand-alone")
				if count >= 3 {
					let width = count == 3 ?? ("abbreviated", count == 4 ?? ("wide", "narrow"))
					let name = s.name("months/" + context + "/" + width + "/" + m.monthKey)
					return leapName(name, context + "/" + width, m, s)
				}
				return leapName(number(m.monthNumber, count, 10, s), "numeric/all", m, s)
			case "d":
				return number(m.day, count, 10, s)
			case "D":
				return number(m.dayOfYear, count, 10, s)
			case "F":
				return number((m.day - 1) / 7 + 1, count, 10, s)
			case "g":
				return number(int(m.epochDay) + 40587, count, 10, s)
			case "E":
				return weekdayName("format", count, m, s)
			case "e":
				return number(localWeekday(m), count, 10, s) when count < 3
				return weekdayName("format", count, m, s)
			case "c":
				return number(localWeekday(m), 1, 10, s) when count < 3
				return weekdayName("stand-alone", count, m, s)
			case "Q", "q":
				let quarter = (m.monthNumber - 1) / 3 + 1
				return number(quarter, count, 10, s) when count < 3
				let context = letter == "Q" ?? ("format", "stand-alone")
				let width = count >= 5 ?? ("narrow", count == 4 ?? ("wide", "abbreviated"))
				return s.name("quarters/" + context + "/" + width + "/" + quarter.str())
			case "a":
				return amPm(count, m, s)
			case "b":
				if m.hour == 12 && (!hasMinute || m.minute == 0) && (!hasSecond || m.second == 0) {
					let name = s.name("dayPeriods/format/" + periodWidth(count) + "/noon")
					return name when name != ""
				}
				return amPm(count, m, s)
			case "B":
				return flexiblePeriod(count, m, s, hasMinute, hasSecond)
			case "h":
				let h = m.hour % 12
				return number(h == 0 ?? (12, h), count, 10, s)
			case "H":
				return number(m.hour, count, 10, s)
			case "K":
				return number(m.hour % 12, count, 10, s)
			case "k":
				return number(m.hour == 0 ?? (24, m.hour), count, 10, s)
			case "m":
				return number(m.minute, count, 10, s)
			case "s":
				return number(m.second, count, 10, s)
			case "S":
				let ms = m.nanosecond / 1000000
				ms /= 100 when count == 1
				ms /= 10 when count == 2
				let out = number(ms, count > 3 ?? (3, count), 10, s)
				out += number(0, count - 3, 10, s) when count > 3
				return out
			case "A":
				let ms = ((m.hour * 60 + m.minute) * 60 + m.second) * 1000 + m.nanosecond / 1000000
				return number(ms, count, 10, s)
			case "z":
				return zoneSpecific(count < 4, m, s)
			case "Z":
				return isoOffset(m.offset, true, false, false, false) when count < 4
				return isoOffset(m.offset, false, true, false, false) when count == 5
				return localizedGmt(m.offset, false, s)
			case "O":
				return localizedGmt(m.offset, count == 1, s)
			case "v":
				return zoneGeneric(count == 1, m, s)
			case "V":
				return zoneId(count, m, s)
			case "X", "x":
				let utc = letter == "X"
				match count {
					case 1:
						return isoOffset(m.offset, true, utc, true, true)
					case 2:
						return isoOffset(m.offset, true, utc, false, true)
					case 3:
						return isoOffset(m.offset, false, utc, false, true)
					case 4:
						return isoOffset(m.offset, true, utc, false, false)
					default:
						return isoOffset(m.offset, false, utc, false, false)
				}
			default:
				return ""
		}
	}

	// The weekday counted from the locale's first day of the week, 1 to 7.
	def localWeekday(m Moment) int {
		return (m.weekday - m.firstWeekday + 7) % 7 + 1
	}

	def weekdayName(context string, count int, m Moment, s Symbols) string {
		let width = count == 4 ?? ("wide", count == 5 ?? ("narrow", count == 6 ?? ("short", "abbreviated")))
		return s.name("days/" + context + "/" + width + "/" + weekdayKeys[m.weekday - 1])
	}

	// A Chinese or Dangi leap month's name through the calendar's leap
	// pattern ("{0}bis").
	def leapName(name string, patternPath string, m Moment, s Symbols) string {
		return name unless m.leap
		let pattern = s.name("monthPatterns/" + patternPath + "/leap")
		return pattern == "" ?? (name, pattern.replace("\{0\}", name))
	}

	def periodWidth(count int) string {
		return count <= 3 ?? ("abbreviated", count == 5 ?? ("narrow", "wide"))
	}

	def amPm(count int, m Moment, s Symbols) string {
		let key = m.hour < 12 ?? ("am", "pm")
		return s.name("dayPeriods/format/" + periodWidth(count) + "/" + key)
	}

	// ICU's flexible day period (B): noon when the time shown is exactly
	// noon, else the period the locale's rules give the hour (never
	// midnight); am and pm when the rules give only those.
	def flexiblePeriod(count int, m Moment, s Symbols, hasMinute bool, hasSecond bool) string {
		return amPm(count, m, s) when s.periods.len() == 0
		let minute = hasMinute ?? (m.minute, 0)
		let second = hasSecond ?? (m.second, 0)
		let width = periodWidth(count)
		if m.hour == 12 && minute == 0 && second == 0 && s.hasNoon {
			let name = s.name("dayPeriods/format/" + width + "/noon")
			return name when name != ""
		}
		let period = s.periods[m.hour]
		return amPm(count, m, s) when period := "am" || "pm"
		let name = s.name("dayPeriods/format/" + width + "/" + period)
		return name == "" ?? (amPm(count, m, s), name)
	}

	// The localized GMT format of an offset ("GMT+1", "GMT+01:00"), as ICU's
	// formatOffsetLocalizedGMT.
	def localizedGmt(offset int, short bool, s Symbols) string {
		let positive = offset >= 0
		let rest = positive ?? (offset, -offset)
		let hours = rest / 3600
		let minutes = rest % 3600 / 60
		let seconds = rest % 60
		let index = seconds != 0 ?? (2, minutes != 0 || !short ?? (1, 0))
		let pattern = s.offsets[(positive ?? (0, 3)) + index]
		let out = s.gmtPrefix
		let quoted = false
		let previous = ""
		for let ch in pattern {
			let c = string(ch)
			if c == "'" {
				quoted = !quoted
				previous = ""
				continue
			}
			if !quoted && (c := "H" || "m" || "s") {
				if c != previous {
					match c {
						case "H":
							out += offsetDigits(hours, short ?? (1, 2), s)
						case "m":
							out += offsetDigits(minutes, 2, s)
						default:
							out += offsetDigits(seconds, 2, s)
					}
				}
				previous = c
				continue
			}
			previous = ""
			out += c
		}
		return out + s.gmtSuffix
	}

	def offsetDigits(n int, min int, s Symbols) string {
		return number(n, min, 2, s)
	}

	// An ISO 8601 offset ("+0530", "+05:30", "Z"), as ICU's
	// formatOffsetISO8601: short drops zero minutes, the seconds show only
	// when they are not zero and not ignored.
	def isoOffset(offset int, basic bool, utc bool, short bool, ignoreSeconds bool) string {
		let rest = offset < 0 ?? (-offset, offset)
		if utc && (rest < 1 || ignoreSeconds && rest < 60) {
			return "Z"
		}
		let fields = int[rest / 3600, rest % 3600 / 60, rest % 60]
		let last = ignoreSeconds ?? (1, 2)
		let first = short ?? (0, 1)
		for last > first && fields[last] == 0 {
			last--
		}
		let sign = "+"
		if offset < 0 {
			for let i in 0..last + 1 {
				if fields[i] != 0 {
					sign = "-"
					break
				}
			}
		}
		let out = sign
		for let i in 0..last + 1 {
			out += ":" when !basic && i != 0
			out += (fields[i] < 10 ?? ("0", "")) + fields[i].str()
		}
		return out
	}

	// Zone names are read in the zone names step; until a name is found,
	// these fall back to the localized GMT format as ICU does.
	def zoneSpecific(short bool, m Moment, s Symbols) string {
		return localizedGmt(m.offset, short, s)
	}

	def zoneGeneric(short bool, m Moment, s Symbols) string {
		return localizedGmt(m.offset, short, s)
	}

	def zoneId(count int, m Moment, s Symbols) string {
		return count == 2 ?? (m.zone, "")
	}
}
