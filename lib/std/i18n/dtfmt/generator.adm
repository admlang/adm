// The date-time pattern generator of ICU (DateTimePatternGenerator): a
// locale's available formats keyed by skeleton, the best one for a
// requested skeleton by field distance, its field widths adjusted to the
// request, and missing fields appended. Ported so that skeletons resolve to
// the patterns ICU (and so Intl.DateTimeFormat) gives.

internal partial module std.i18n.dtfmt {
	use std.i18n.cldr::(tables)

	// Fields, as ICU numbers them.
	const fieldEra = 0
	const fieldYear = 1
	const fieldQuarter = 2
	const fieldMonth = 3
	const fieldWeekOfYear = 4
	const fieldWeekOfMonth = 5
	const fieldWeekday = 6
	const fieldDayOfYear = 7
	const fieldDayOfWeekInMonth = 8
	const fieldDay = 9
	const fieldDayPeriod = 10
	const fieldHour = 11
	const fieldMinute = 12
	const fieldSecond = 13
	const fieldFraction = 14
	const fieldZone = 15
	const fieldCount = 16

	const dtNumeric = 256
	const dtDelta = 16
	const dtNarrow = -257
	const dtShorter = -258
	const dtShort = -259
	const dtLong = -260
	const extraField = 65536
	const missingField = 4096

	// TypeRow is one row of ICU's dtTypes table: a pattern letter, its field,
	// its type (numeric or a name width) from a minimum length, and its weight.
	struct TypeRow {
		ch     string
		field  int
		kind   int
		minLen int
	}

	def row(ch string, field int, kind int, minLen int) TypeRow {
		return TypeRow{ch: ch, field: field, kind: kind, minLen: minLen}
	}

	let dtTypes = TypeRow[
		row("G", 0, dtShort, 1), row("G", 0, dtLong, 4), row("G", 0, dtNarrow, 5),
		row("y", 1, dtNumeric, 1), row("Y", 1, dtNumeric + dtDelta, 1), row("u", 1, dtNumeric + 2 * dtDelta, 1), row("r", 1, dtNumeric + 3 * dtDelta, 1),
		row("U", 1, dtShort, 1), row("U", 1, dtLong, 4), row("U", 1, dtNarrow, 5),
		row("Q", 2, dtNumeric, 1), row("Q", 2, dtShort, 3), row("Q", 2, dtLong, 4), row("Q", 2, dtNarrow, 5),
		row("q", 2, dtNumeric + dtDelta, 1), row("q", 2, dtShort - dtDelta, 3), row("q", 2, dtLong - dtDelta, 4), row("q", 2, dtNarrow - dtDelta, 5),
		row("M", 3, dtNumeric, 1), row("M", 3, dtShort, 3), row("M", 3, dtLong, 4), row("M", 3, dtNarrow, 5),
		row("L", 3, dtNumeric + dtDelta, 1), row("L", 3, dtShort - dtDelta, 3), row("L", 3, dtLong - dtDelta, 4), row("L", 3, dtNarrow - dtDelta, 5),
		row("l", 3, dtNumeric + dtDelta, 1),
		row("w", 4, dtNumeric, 1),
		row("W", 5, dtNumeric, 1),
		row("E", 6, dtShort, 1), row("E", 6, dtLong, 4), row("E", 6, dtNarrow, 5), row("E", 6, dtShorter, 6),
		row("c", 6, dtNumeric + 2 * dtDelta, 1), row("c", 6, dtShort - 2 * dtDelta, 3), row("c", 6, dtLong - 2 * dtDelta, 4), row("c", 6, dtNarrow - 2 * dtDelta, 5), row("c", 6, dtShorter - 2 * dtDelta, 6),
		row("e", 6, dtNumeric + dtDelta, 1), row("e", 6, dtShort - dtDelta, 3), row("e", 6, dtLong - dtDelta, 4), row("e", 6, dtNarrow - dtDelta, 5), row("e", 6, dtShorter - dtDelta, 6),
		row("d", 9, dtNumeric, 1), row("g", 9, dtNumeric + dtDelta, 1),
		row("D", 7, dtNumeric, 1),
		row("F", 8, dtNumeric, 1),
		row("a", 10, dtShort, 1), row("a", 10, dtLong, 4), row("a", 10, dtNarrow, 5),
		row("b", 10, dtShort - dtDelta, 1), row("b", 10, dtLong - dtDelta, 4), row("b", 10, dtNarrow - dtDelta, 5),
		row("B", 10, dtShort - 3 * dtDelta, 1), row("B", 10, dtLong - 3 * dtDelta, 4), row("B", 10, dtNarrow - 3 * dtDelta, 5),
		row("H", 11, dtNumeric + 10 * dtDelta, 1), row("k", 11, dtNumeric + 11 * dtDelta, 1), row("h", 11, dtNumeric, 1), row("K", 11, dtNumeric + dtDelta, 1),
		row("J", 11, dtNumeric + 5 * dtDelta, 1), row("j", 11, dtNumeric + 6 * dtDelta, 1), row("C", 11, dtNumeric + 7 * dtDelta, 1),
		row("m", 12, dtNumeric, 1),
		row("s", 13, dtNumeric, 1), row("A", 13, dtNumeric + dtDelta, 1),
		row("S", 14, dtNumeric, 1),
		row("v", 15, dtShort - 2 * dtDelta, 1), row("v", 15, dtLong - 2 * dtDelta, 4),
		row("z", 15, dtShort, 1), row("z", 15, dtLong, 4),
		row("Z", 15, dtNarrow - dtDelta, 1), row("Z", 15, dtLong - dtDelta, 4), row("Z", 15, dtShort - dtDelta, 5),
		row("O", 15, dtShort - dtDelta, 1), row("O", 15, dtLong - dtDelta, 4),
		row("V", 15, dtShort - dtDelta, 1), row("V", 15, dtLong - dtDelta, 2), row("V", 15, dtLong - 1 - dtDelta, 3), row("V", 15, dtLong - 2 - dtDelta, 4),
		row("X", 15, dtNarrow - dtDelta, 1), row("X", 15, dtShort - dtDelta, 2), row("X", 15, dtLong - dtDelta, 4),
		row("x", 15, dtNarrow - dtDelta, 1), row("x", 15, dtShort - dtDelta, 2), row("x", 15, dtLong - dtDelta, 4),
	]

	let canonicalItems = string["G", "y", "Q", "M", "w", "W", "E", "D", "F", "d", "a", "H", "m", "s", "S", "v"]
	let appendKeys = string["Era", "Year", "Quarter", "Month", "Week", "*", "Day-Of-Week", "*", "*", "Day", "*", "Hour", "Minute", "Second", "*", "Timezone"]
	let fieldNames = string["era", "year", "quarter", "month", "week", "weekOfMonth", "weekday", "dayOfYear", "weekdayOfMonth", "day", "dayperiod", "hour", "minute", "second", "*", "zone"]

	// The dtTypes row a field string ("MMM") takes, or -1.
	def canonicalIndex(s string) int {
		let n = s.len()
		return -1 when n == 0
		let ch = s[0:1]
		for let i in 1..n {
			return -1 when s[i:i + 1] != ch
		}
		let bestRow = -1
		let i = 0
		for i < dtTypes.len() {
			if dtTypes[i].ch != ch {
				i++
				continue
			}
			bestRow = i
			return i when i + 1 >= dtTypes.len() || dtTypes[i + 1].ch != ch
			if dtTypes[i + 1].minLen <= n {
				i++
				continue
			}
			return i
		}
		return bestRow
	}

	// Tokens splits a pattern as ICU's FormatParser does: runs of one letter,
	// and every other character alone.
	def tokens(pattern string) string[] {
		let chars = string[]
		for let ch in pattern {
			chars.push(string(ch))
		}
		let out = string[]
		let i = 0
		for i < chars.len() {
			let c = chars[i]
			if !isLetter(c) {
				out.push(c)
				i++
				continue
			}
			let j = i + 1
			for j < chars.len() && chars[j] == c {
				j++
			}
			out.push(chars[i:j].join(""))
			i = j
		}
		return out
	}

	def isLetter(c string) bool {
		return c >= "A" && c <= "Z" || c >= "a" && c <= "z"
	}

	def isQuoteLiteral(s string) bool {
		return s.startsWith("'")
	}

	// The quoted literal starting at item i (quotes kept), and the index of
	// its last item.
	def quoteLiteral(items string[], start int) (string, int) {
		let i = start
		let quote = ""
		if items[i].startsWith("'") {
			quote += items[i]
			i++
		}
		for i < items.len() {
			if items[i].startsWith("'") {
				if i + 1 < items.len() && items[i + 1].startsWith("'") {
					quote += items[i] + items[i + 1]
					i += 2
					continue
				}
				quote += items[i]
				break
			}
			quote += items[i]
			i++
		}
		return (quote, i)
	}

	// IsPatternSeparator follows ICU, which (as ICU does) tests the item list
	// at the character's index for the dot.
	def isPatternSeparator(items string[], field string) bool {
		let i = 0
		for let ch in field {
			let c = string(ch)
			let dot = i < items.len() && items[i].startsWith(".")
			if !(c := "'" || "\\" || " " || ":" || "\"" || "," || "-") && !dot {
				return false
			}
			i++
		}
		return true
	}

	// Skeleton is ICU's PtnSkeleton: per field the letter and length as
	// requested (original) and at its canonical minimum (base), and the type.
	struct Skeleton {
		chars          string[]
		lengths        int[]
		baseChars      string[]
		baseLengths    int[]
		types          int[]
		addedDayPeriod bool
	}

	def emptySkeleton() Skeleton {
		let s = Skeleton{chars: string[], lengths: int[], baseChars: string[], baseLengths: int[], types: int[]}
		for let _ in 0..fieldCount {
			s.chars.push("")
			s.lengths.push(0)
			s.baseChars.push("")
			s.baseLengths.push(0)
			s.types.push(0)
		}
		return s
	}

	def original(s Skeleton) string {
		let out = ""
		for let i in 0..fieldCount {
			out += s.chars[i].repeat(s.lengths[i])
		}
		return out
	}

	def base(s Skeleton) string {
		let out = ""
		for let i in 0..fieldCount {
			out += s.baseChars[i].repeat(s.baseLengths[i])
		}
		return out
	}

	def firstChar(s Skeleton) string {
		for let i in 0..fieldCount {
			return s.baseChars[i] when s.baseLengths[i] != 0
		}
		return ""
	}

	// SkeletonOf parses a pattern or skeleton into its skeleton (ICU's
	// DateTimeMatcher.set).
	def skeletonOf(pattern string) Skeleton {
		let s = emptySkeleton()
		let items = tokens(pattern)
		let i = 0
		for i < items.len() {
			let value = items[i]
			if isQuoteLiteral(value) {
				let (_, end) = quoteLiteral(items, i)
				i = end + 1
				continue
			}
			let index = canonicalIndex(value)
			if index < 0 {
				i++
				continue
			}
			let r = dtTypes[index]
			s.chars[r.field] = value[0:1]
			s.lengths[r.field] = value.len()
			s.baseChars[r.field] = r.ch
			s.baseLengths[r.field] = r.minLen
			s.types[r.field] = r.kind > 0 ?? (r.kind + value.len(), r.kind)
			i++
		}
		// Fractional seconds with minutes imply seconds.
		if s.lengths[fieldMinute] != 0 && s.lengths[fieldFraction] != 0 && s.lengths[fieldSecond] == 0 {
			for let r in dtTypes {
				if r.field == fieldSecond {
					s.chars[fieldSecond] = r.ch
					s.lengths[fieldSecond] = r.minLen
					s.baseChars[fieldSecond] = r.ch
					s.baseLengths[fieldSecond] = r.minLen
					s.types[fieldSecond] = r.kind > 0 ?? (r.kind + 1, r.kind)
					break
				}
			}
		}
		// A 12-hour clock implies a day period; a 24-hour one drops it.
		if s.lengths[fieldHour] != 0 {
			if (s.chars[fieldHour] := "h" || "K") {
				if s.lengths[fieldDayPeriod] == 0 {
					for let r in dtTypes {
						if r.field == fieldDayPeriod {
							s.chars[fieldDayPeriod] = r.ch
							s.lengths[fieldDayPeriod] = r.minLen
							s.baseChars[fieldDayPeriod] = r.ch
							s.baseLengths[fieldDayPeriod] = r.minLen
							s.types[fieldDayPeriod] = r.kind
							s.addedDayPeriod = true
							break
						}
					}
				}
			} else {
				s.chars[fieldDayPeriod] = ""
				s.lengths[fieldDayPeriod] = 0
				s.baseChars[fieldDayPeriod] = ""
				s.baseLengths[fieldDayPeriod] = 0
				s.types[fieldDayPeriod] = 0
			}
		}
		return s
	}

	// Distance is ICU's DateTimeMatcher.getDistance, with the missing and
	// extra field masks.
	struct Distance {
		value   int
		missing int
		extra   int
	}

	def distance(want Skeleton, other Skeleton, includeMask int) Distance {
		let d = Distance{}
		for let i in 0..fieldCount {
			let mine = (includeMask & (1 << i)) == 0 ?? (0, want.types[i])
			let theirs = other.types[i]
			continue when mine == theirs
			if mine == 0 {
				d.value += extraField
				d.extra |= 1 << i
			} else if theirs == 0 {
				d.value += missingField
				d.missing |= 1 << i
			} else {
				let diff = mine - theirs
				d.value += diff < 0 ?? (-diff, diff)
			}
		}
		return d
	}

	def fieldMask(s Skeleton) int {
		let mask = 0
		for let i in 0..fieldCount {
			mask |= 1 << i when s.types[i] != 0
		}
		return mask
	}

	// Entry is one pattern the generator holds.
	struct Entry {
		basePattern string
		skeleton    Skeleton
		pattern     string
		specified   bool
	}

	// The 52 buckets of ICU's PatternMap, by the base pattern's first letter.
	def bucket(c string) int {
		return -1 when c == ""
		let code = int(c[0])
		return code - 65 when code >= 65 && code <= 90
		return 26 + code - 97 when code >= 97 && code <= 122
		return -1
	}

	// Generator is the pattern generator of one locale and calendar.
	type Generator {
		buckets         Entry[][]
		appendFormats   string[]
		appendNames     string[]
		dateTimeFormats string[] // full, long, medium, short glue
		defaultHour     string // h, H, K or k
		decimal         string // the locale's decimal separator, for fractional seconds
		allowedHours    string[] // the region's allowed hour formats ("h", "hB", ...)

		def new() {
			buckets = Entry[][]
			for let _ in 0..52 {
				buckets.push(Entry[])
			}
			appendFormats = string[]
			appendNames = string[]
			dateTimeFormats = string[]
			allowedHours = string[]
		}

		def entryFor(basePattern string) ?Entry {
			let b = bucket(basePattern[0:1])
			return none when b < 0
			for let e in buckets[b] {
				return e when e.basePattern == basePattern
			}
			return none
		}

		// The entry whose skeleton (as requested) equals s.
		def entryWithSkeleton(s Skeleton) ?Entry {
			let b = bucket(firstChar(s))
			return none when b < 0
			let want = original(s)
			for let e in buckets[b] {
				return e when original(e.skeleton) == want
			}
			return none
		}

		// Add is ICU's addPatternWithOptionalSkeleton.
		def add(pattern string, skeletonText string, override bool) {
			let hasSkeleton = skeletonText != ""
			let s = hasSkeleton ?? (skeletonOf(skeletonText), skeletonOf(pattern))
			let basePattern = base(s)
			let duplicate = entryFor(basePattern)
			if !(duplicate is none) && (!duplicate.specified || hasSkeleton && !override) && !override {
				return
			}
			let same = entryWithSkeleton(s)
			if !(same is none) {
				return when !override || hasSkeleton && same.specified
			}
			let b = bucket(basePattern[0:1])
			return when b < 0
			for let e in buckets[b] {
				if e.basePattern == basePattern && sameTypes(e.skeleton, s) {
					e.pattern = pattern
					e.specified = hasSkeleton
					return
				}
			}
			buckets[b].push(Entry{basePattern: basePattern, skeleton: s, pattern: pattern, specified: hasSkeleton})
		}

		// BestRaw is ICU's getBestRaw: the entry nearest the request.
		def bestRaw(want Skeleton, includeMask int) (?Entry, Distance) {
			let bestDistance = 2147483647
			let bestMissing = -1
			let best ?Entry = none
			let bestInfo = Distance{}
			for let b in 0..52 {
				for let e in buckets[b] {
					let d = distance(want, e.skeleton, includeMask)
					if d.value < bestDistance || d.value == bestDistance && bestMissing < d.missing {
						bestDistance = d.value
						bestMissing = d.missing
						best = e
						bestInfo = d
						return (best, bestInfo) when d.value == 0
					}
				}
			}
			return (best, bestInfo)
		}

		// BestPattern is ICU's getBestPattern for a skeleton, with the hour
		// field length matched when matchHourLength (Intl's
		// UDATPG_MATCH_HOUR_FIELD_LENGTH).
		def bestPattern(skeletonText string, matchHourLength bool) string {
			let (mapped, usesCapJ) = mapMetacharacters(skeletonText)
			let want = skeletonOf(mapped)
			let (best, info) = bestRaw(want, -1)
			if !(best is none) && info.missing == 0 && info.extra == 0 {
				return adjust(best.pattern, best, want, usesCapJ, false, matchHourLength)
			}
			let needed = fieldMask(want)
			let dateMask = (1 << fieldDayPeriod) - 1
			let timeMask = (1 << fieldCount) - 1 - dateMask
			let datePattern = bestAppending(want, needed & dateMask, usesCapJ, matchHourLength)
			let timePattern = bestAppending(want, needed & timeMask, usesCapJ, matchHourLength)
			return timePattern when datePattern == ""
			return datePattern when timePattern == ""
			let width = 3
			let monthLength = want.lengths[fieldMonth]
			if monthLength == 4 {
				width = want.lengths[fieldWeekday] > 0 ?? (0, 1)
			} else if monthLength == 3 {
				width = 2
			}
			return glue(dateTimeFormats[width], timePattern, datePattern)
		}

		// MapMetacharacters turns j and C into the region's hour letter (and
		// day period), J into H.
		def mapMetacharacters(form string) (string, bool) {
			let out = ""
			let usesCapJ = false
			let quoted = false
			let chars = string[]
			for let ch in form {
				chars.push(string(ch))
			}
			let i = 0
			for i < chars.len() {
				let c = chars[i]
				if c == "'" {
					quoted = !quoted
				} else if !quoted {
					if c := "j" || "C" {
						let extra = 0
						for i + 1 < chars.len() && chars[i + 1] == c {
							extra++
							i++
						}
						let hourLength = 1 + (extra & 1)
						let dayPeriodLength = extra < 2 ?? (1, 3 + (extra >> 1))
						let hourChar = "h"
						let dayPeriodChar = "a"
						if c == "j" {
							hourChar = defaultHour
						} else {
							let allowed = allowedHours.len() > 0 ?? (allowedHours[0], "H")
							hourChar = "H" when allowed := "H" || "HB" || "Hb"
							hourChar = "K" when allowed := "K" || "KB" || "Kb"
							hourChar = "k" when allowed == "k"
							dayPeriodChar = "B" when allowed := "HB" || "hB" || "KB"
							dayPeriodChar = "b" when allowed := "Hb" || "hb" || "Kb"
						}
						dayPeriodLength = 0 when hourChar := "H" || "k"
						out += dayPeriodChar.repeat(dayPeriodLength) + hourChar.repeat(hourLength)
					} else if c == "J" {
						out += "H"
						usesCapJ = true
					} else {
						out += c
					}
				}
				i++
			}
			return (out, usesCapJ)
		}

		// Adjust is ICU's adjustFieldTypes: the pattern's fields take the
		// requested widths (and letters, for most fields).
		def adjust(pattern string, entry ?Entry, want Skeleton, usesCapJ bool, fixFraction bool, matchHourLength bool) string {
			let specified = entry is none ?? (false, entry.specified)
			let specifiedSkeleton = entry is none ?? (emptySkeleton(), entry.skeleton)
			let items = tokens(pattern)
			let out = ""
			let i = 0
			for i < items.len() {
				let field = items[i]
				if isQuoteLiteral(field) {
					let (quote, end) = quoteLiteral(items, i)
					out += quote
					i = end + 1
					continue
				}
				if isPatternSeparator(items, field) {
					out += field
					i++
					continue
				}
				let index = canonicalIndex(field)
				if index < 0 {
					out += field
					i++
					continue
				}
				let r = dtTypes[index]
				let typeValue = r.field
				if fixFraction && typeValue == fieldSecond {
					field += decimal
					field += want.chars[fieldFraction].repeat(want.lengths[fieldFraction])
				} else if want.types[typeValue] != 0 {
					let reqChar = want.chars[typeValue]
					let reqLength = want.lengths[typeValue]
					reqLength = 3 when reqChar == "E" && reqLength < 3
					let adjLength = reqLength
					if typeValue == fieldHour && !matchHourLength || (typeValue := fieldMinute || fieldSecond) {
						adjLength = field.len()
					} else if specified && !(reqChar := "c" || "e") {
						let skelLength = specifiedSkeleton.lengths[typeValue]
						let patNumeric = r.kind > 0
						let reqNumeric = want.types[typeValue] > 0
						if skelLength == reqLength || patNumeric && !reqNumeric || reqNumeric && !patNumeric {
							adjLength = field.len()
						}
					}
					let keepPatternChar = (typeValue := fieldHour || fieldMonth || fieldWeekday) || typeValue == fieldYear && reqChar != "Y"
					let c = keepPatternChar ?? (field[0:1], reqChar)
					c = "e" when c == "E" && adjLength < 3
					if typeValue == fieldHour && defaultHour != "" {
						if usesCapJ || reqChar == defaultHour {
							c = defaultHour
						} else if reqChar == "h" && defaultHour == "K" {
							c = "K"
						} else if reqChar == "H" && defaultHour == "k" {
							c = "k"
						} else if reqChar == "k" && defaultHour == "H" {
							c = "H"
						} else if reqChar == "K" && defaultHour == "h" {
							c = "h"
						}
					}
					field = c.repeat(adjLength)
				}
				out += field
				i++
			}
			return out
		}

		// BestAppending is ICU's getBestAppending: the nearest pattern for the
		// fields, then the missing ones appended one at a time.
		def bestAppending(want Skeleton, missingFields int, usesCapJ bool, matchHourLength bool) string {
			return "" when missingFields == 0
			let (first, info) = bestRaw(want, missingFields)
			return "" when first is none
			let result = adjust(first.pattern, first, want, usesCapJ, false, matchHourLength)
			let latest = first
			let lastMissing = 0
			let missing = info.missing
			let secondAndFraction = (1 << fieldSecond) | (1 << fieldFraction)
			for missing != 0 {
				break when lastMissing == missing
				if (missing & secondAndFraction) == (1 << fieldFraction) && (missingFields & secondAndFraction) == secondAndFraction {
					result = adjust(result, latest, want, usesCapJ, true, matchHourLength)
					missing &= ~(1 << fieldFraction)
					continue
				}
				let starting = missing
				let (next, nextInfo) = bestRaw(want, missing)
				break when next is none
				latest = next
				let piece = adjust(next.pattern, next, want, usesCapJ, false, matchHourLength)
				missing = nextInfo.missing
				let found = starting & ~missing
				let top = topBit(found)
				if appendFormats[top] != "" {
					result = appendFormats[top].replace("\{0\}", result).replace("\{1\}", piece).replace("\{2\}", "'" + appendNames[top] + "'")
				}
				lastMissing = missing
			}
			return result
		}
	}

	def sameTypes(a Skeleton, b Skeleton) bool {
		for let i in 0..fieldCount {
			return false when a.types[i] != b.types[i]
		}
		return true
	}

	def topBit(mask int) int {
		return 0 when mask == 0
		let i = 0
		let m = mask
		for m != 0 {
			m >>= 1
			i++
		}
		return i - 1 > fieldZone ?? (fieldZone, i - 1)
	}

	// SkeletonText is ICU's staticGetSkeleton: the pattern's fields in
	// canonical order, literals dropped.
	def skeletonText(pattern string) string {
		return original(skeletonOf(pattern))
	}

	// Glue substitutes a time ({0}) and a date ({1}) into a date-time pattern.
	def glue(format string, time string, date string) string {
		return format.replace("\{0\}", time).replace("\{1\}", date)
	}
}
