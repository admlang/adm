// Building a Generator from CLDR data as ICU's DateTimePatternGenerator
// initData does: canonical items, the calendar's standard time and date
// patterns, append items and field names, the available formats, the
// date-time glue, the decimal separator and the region's hour formats.

internal partial module std.i18n.dtfmt {
	use std.i18n.cldr::(tables)

	const defaultAppendFormat = "\{0\} ├\{2\}: \{1\}┤"

	// Generators caches one generator per locale, calendar, numbering system
	// (for the decimal sign of fractional seconds), hour setting and
	// whether the calendar's standard date and time formats are in it (ICU
	// leaves them out for a locale whose region differs from its data's);
	// atomic, as tasks share it.
	type Generators {
		built map<string, Generator>

		def new() {
			built = map<string, Generator>{}
		}

		atomic def get(data string, calendar string, system string, language string, region string, hourKeyword string, standard bool) Generator {
			let key = data + "|" + calendar + "|" + system + "|" + language + "|" + region + "|" + hourKeyword + "|{standard}"
			let have = built.get(key)
			return have unless have is none
			let g = build(data, calendar, system, language, region, hourKeyword, standard)
			built[key] = g
			return g
		}
	}

	let generators = new Generators()

	// CalendarValue reads a value of the calendar's CLDR section (with the
	// generic and Gregorian sections behind it), or "".
	def calendarValue(data string, calendar string, path string) string {
		let v = tables.value("ca-" + calendar, data, "calendar/" + path)
		return "" when v is none
		return v
	}

	def build(data string, calendar string, system string, language string, region string, hourKeyword string, standard bool) Generator {
		let g = new Generator()
		for let item in canonicalItems {
			g.add(item, "", false)
		}
		for let kind in (standard ?? (string["timeFormats", "dateFormats"], string[])) {
			for let width in string["full", "long", "medium", "short"] {
				let p = calendarValue(data, calendar, kind + "/" + width)
				g.add(p, "", false) when p != ""
			}
		}
		let appendItems = tables.values("ca-" + calendar, data, "calendar/dateTimeFormats/appendItems")
		for let i in 0..fieldCount {
			let v = appendItems.get(appendKeys[i])
			g.appendFormats.push(v is none ?? (defaultAppendFormat, v))
		}
		for let i in 0..fieldCount {
			let name = tables.value("dateFields", data, "dates/fields/" + fieldNames[i] + "/displayName")
			g.appendNames.push(name is none ?? ("F" + i.str(), name))
		}
		let formats = tables.values("ca-" + calendar, data, "calendar/dateTimeFormats/availableFormats")
		let keys = formats.keys()
		keys.sort((a, b) => a < b)
		for let key in keys {
			continue when key.contains("-alt-") || key.contains("-count-")
			g.add(formats[key], key, true)
		}
		for let width in string["full", "long", "medium", "short"] {
			let atTime = calendarValue(data, calendar, "dateTimeFormats-atTime/standard/" + width)
			let plain = calendarValue(data, calendar, "dateTimeFormats/" + width)
			g.dateTimeFormats.push(atTime != "" ?? (atTime, plain == "" ?? ("\{1\} \{0\}", plain)))
		}
		let decimal = tables.value("numbers", data, "numbers/symbols-numberSystem-" + system + "/decimal")
		decimal = tables.value("numbers", data, "numbers/symbols-numberSystem-latn/decimal") when decimal is none
		g.decimal = decimal is none ?? (".", decimal)
		allowedHours(g, language, region, hourKeyword)
		return g
	}

	// The region's allowed and preferred hour formats (CLDR timeData), as
	// ICU's getAllowedHourFormats reads them, and the -u-hc override.
	def allowedHours(g Generator, language string, region string, hourKeyword string) {
		let found = timeData(language + "-" + region)
		found = timeData(region) when found.len() == 0
		found = timeData("001") when found.len() == 0
		g.allowedHours = found.len() > 1 ?? (found[1:], string["H"])
		let preferred = found.len() > 0 ?? (found[0], "H")
		g.defaultHour = preferred.len() == 1 ?? (preferred, "H")
		match hourKeyword {
			case "h24":
				g.defaultHour = "k"
			case "h23":
				g.defaultHour = "H"
			case "h12":
				g.defaultHour = "h"
			case "h11":
				g.defaultHour = "K"
			default:
		}
	}

	// The preferred hour format then the allowed ones of a timeData key, or
	// nothing.
	def timeData(key string) string[] {
		let allowed = tables.value("supplemental/timeData", "root", "timeData/" + key + "/_allowed")
		let preferred = tables.value("supplemental/timeData", "root", "timeData/" + key + "/_preferred")
		let out = string[]
		return out when allowed is none && preferred is none
		let list = allowed is none ?? (string[], allowed.split(" "))
		out.push(preferred is none ?? (list.len() > 0 ?? (list[0], "H"), preferred))
		for let a in list {
			out.push(a)
		}
		return out
	}
}
