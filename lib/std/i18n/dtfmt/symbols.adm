// The names and rules a pattern's fields write with, read once per locale
// and calendar: month, weekday, quarter, era and day period names, the
// localized GMT format and the locale's day period rules.

internal partial module std.i18n.dtfmt {
	use std.i18n.cldr::(tables)

	// Symbols are one locale's date names in one calendar.
	type Symbols {
		calendar    string // CLDR calendar id: "gregorian", "islamic-civil", ...
		names       map<string, string> // the calendar section, by path below "calendar/"
		digits      string[] // the numbering system's ten digits
		minus       string // and its minus sign
		gmtPrefix   string // the localized GMT format around its offset
		gmtSuffix   string
		gmtZero     string // read when parsing; formatting writes "GMT+0"
		offsets     string[] // +H, +H:mm, +H:mm:ss, then the negative three
		periods     string[] // the day period of each hour ("morning1"), or empty
		hasMidnight bool
		hasNoon     bool

		def new() {
			names = map<string, string>{}
			digits = string[]
			offsets = string[]
			periods = string[]
		}

		// Name returns the value at the path, or "".
		def name(path string) string {
			let v = names.get(path)
			return "" when v is none
			return v
		}
	}

	// SymbolCache holds the symbols per data locale, rule locale, calendar
	// and digits; atomic, as tasks share it.
	type SymbolCache {
		built map<string, Symbols>

		def new() {
			built = map<string, Symbols>{}
		}

		atomic def get(data string, tag string, calendar string, digits string[], minus string) Symbols {
			let key = data + "|" + tag + "|" + calendar + "|" + digits.join("") + "|" + minus
			let have = built.get(key)
			return have unless have is none
			let s = loadSymbols(data, tag, calendar, digits)
			s.minus = minus
			built[key] = s
			return s
		}
	}

	let symbolCache = new SymbolCache()

	def loadSymbols(data string, tag string, calendar string, digits string[]) Symbols {
		let s = new Symbols()
		s.calendar = calendar
		s.names = tables.values("ca-" + calendar, data, "calendar")
		s.digits = digits
		let zones = tables.values("timeZoneNames", data, "dates/timeZoneNames")
		let gmt = zones.get("gmtFormat")
		let format = gmt is none ?? ("GMT\{0\}", gmt)
		let at = format.indexOf("\{0\}")
		s.gmtPrefix = at < 0 ?? (format, format[:at])
		s.gmtSuffix = at < 0 ?? ("", format[at + 3:])
		let zero = zones.get("gmtZeroFormat")
		s.gmtZero = zero is none ?? ("GMT", zero)
		let hours = zones.get("hourFormat")
		let pair = (hours is none ?? ("+HH:mm;-HH:mm", hours)).split(";")
		let positive = pair[0]
		let negative = pair.len() > 1 ?? (pair[1], "-" + positive[1:])
		for let hm in string[positive, negative] {
			s.offsets.push(truncateOffset(hm))
			s.offsets.push(hm)
			s.offsets.push(expandOffset(hm))
		}
		loadDayPeriods(s, tag)
		return s
	}

	// The offset pattern without its minutes: "+HH:mm" -> "+HH" (ICU's
	// truncateOffsetPattern).
	def truncateOffset(hm string) string {
		let mm = hm.indexOf("mm")
		return hm when mm < 0
		let h = lastHour(hm, mm)
		return h < 0 ?? (hm, hm[:h + 1])
	}

	// The offset pattern with seconds: "+HH:mm" -> "+HH:mm:ss" (ICU's
	// expandOffsetPattern).
	def expandOffset(hm string) string {
		let mm = hm.indexOf("mm")
		return hm when mm < 0
		let h = lastHour(hm, mm)
		let separator = h >= 0 ?? (hm[h + 1:mm], "")
		return hm[:mm + 2] + separator + "ss" + hm[mm + 2:]
	}

	// The index of the last H before end, or -1.
	def lastHour(pattern string, end int) int {
		let i = end - 1
		for i >= 0 && pattern[i:i + 1] != "H" {
			i--
		}
		return i
	}

	// The day period rules of the locale or its nearest truncation (ICU
	// walks "es_CO" -> "es" -> "root"), as each hour's period.
	def loadDayPeriods(s Symbols, tag string) {
		let name = tag
		for {
			let rules = tables.values("supplemental/dayPeriods", "root", "dayPeriodRuleSet/" + name)
			if rules.len() > 0 {
				readDayPeriods(s, rules)
				return
			}
			return when name == "root"
			let parts = name.split("-")
			name = parts.len() == 1 ?? ("root", parts[:parts.len() - 1].join("-"))
		}
	}

	def readDayPeriods(s Symbols, rules map<string, string>) {
		let periods = string[]
		for let _ in 0..24 {
			periods.push("")
		}
		for let key in rules.keys() {
			let slash = key.indexOf("/")
			continue when slash < 0
			let period = key[:slash]
			let attribute = key[slash + 1:]
			if attribute == "_at" {
				s.hasMidnight = true when period == "midnight"
				s.hasNoon = true when period == "noon"
				continue
			}
			continue unless attribute == "_from"
			let from = hourOf(rules[key])
			let beforeKey = period + "/_before"
			continue unless rules.hasKey(beforeKey)
			let before = hourOf(rules[beforeKey])
			let h = from
			for {
				periods[h % 24] = period
				h++
				break when h % 24 == before % 24
			}
		}
		return when periods[0] == ""
		s.periods = periods
	}

	def hourOf(text string) int {
		let colon = text.indexOf(":")
		return (colon < 0 ?? (text, text[:colon])).toInt<int>()
	}
}
