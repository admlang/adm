partial module std.i18n {
	use std.i18n.cldr::(tables)

	// Language is a language by its ISO 639 code, as BCP 47 writes it ("de",
	// "yue"; "und" when it is not known).
	type Language {
		code string // ISO 639-1/2/3

		def new(code string) {
			self.code = code.lower()
		}

		// Name returns the language's name in the given locale ("German" in
		// English, "Deutsch" in German), or its code when the locale has none.
		def name(locale Locale) string {
			return displayName(locale, "languages", "localeDisplayNames/languages/" + code, code)
		}

		// Str returns the code.
		def str() string {
			return code
		}
	}

	// The name at path in a localeDisplayNames section for the locale, or
	// fallback.
	internal def displayName(locale Locale, section string, path string, fallback string) string {
		let v = tables.value(section, dataLocaleOf(locale), path)
		return fallback when v is none
		return v
	}
}
