partial module std.i18n {
	use (
		std.errors
		std.i18n.cldr::(tables)
		std.i18n.subtags
	)

	// LocaleError reports a locale tag that is not well-formed BCP 47.
	struct LocaleError {
		message string
		code    string
		cause   ?error
		stack   errors.StackTrace
		tag     string
	}

	// Locale is a language as used in a region and written in a script, with
	// any variants and extensions; it selects the formats and rules the module
	// applies. It reads BCP 47 tags ("de-CH", "sr-Latn-RS",
	// "th-TH-u-nu-thai") and POSIX locale names ("de_CH.UTF-8", "sr_RS@latin").
	//
	//     let swiss = new Locale("de-CH")
	//     swiss.language.code      // "de"
	//     swiss.maximize().str()   // "de-Latn-CH"
	type Locale {
		language   Language
		script     Script
		region     Region
		variants   string[]
		keywords   map<string, string> // Unicode extension keywords (-u-): "ca" -> "buddhist"
		extensions string[] // other extensions, each "singleton-subtags" ("t-ja")
		privateUse string // the subtags after "x-"
		attributes string[] // Unicode extension attributes (-u- subtags before the first key)

		// New reads a tag leniently: a tag that is not well-formed gives the
		// undetermined locale "und". Use parseLocale to be told.
		def new(tag string) {
			let parsed = parseLocale(tag) onerror recover new Locale()
			assign(self, parsed)
		}

		// New makes the undetermined locale "und".
		def new() {
			language = new Language("und")
			script = new Script("")
			region = new Region("")
			variants = string[]
			keywords = map<string, string>{}
			extensions = string[]
			attributes = string[]
		}

		// Str writes the canonical BCP 47 tag ("de-CH", "en-US-u-ca-buddhist").
		def str() string {
			let parts = string[language.code]
			parts.push(script.code) when script.code != ""
			parts.push(region.code) when region.code != ""
			for let v in variants {
				parts.push(v)
			}
			let exts = extensions.clone()
			if keywords.len() > 0 || attributes.len() > 0 {
				let u = string["u"]
				for let a in attributes {
					u.push(a)
				}
				let keys = keywords.keys()
				keys.sort((a, b) => a < b)
				for let k in keys {
					let v = keywords.get(k)
					continue when v is none
					u.push(k)
					u.push(v) when v != "true"
				}
				exts.push(u.join("-"))
			}
			exts.sort((a, b) => a < b)
			for let e in exts {
				parts.push(e)
			}
			parts.push("x-" + privateUse) when privateUse != ""
			return parts.join("-")
		}

		// Posix writes the POSIX locale name: language, region and the script
		// as a modifier ("de_CH", "sr_RS@latin").
		def posix() string {
			let out = language.code
			out += "_" + region.code when region.code != ""
			let modifier = posixModifier(script.code)
			out += "@" + modifier when modifier != ""
			return out
		}

		// Equals reports whether both locales have the same canonical tag.
		def equals(other Locale) bool {
			return str() == other.str()
		}

		// Keyword returns the value of a Unicode extension keyword ("ca",
		// "nu", "hc", ...), or none when the tag does not set it.
		def keyword(key string) ?string {
			return none unless keywords.hasKey(key.lower())
			return keywords[key.lower()]
		}

		// WithKeyword returns a copy of the locale with the Unicode extension
		// keyword set; an empty value removes it.
		def withKeyword(key string, value string) Locale {
			let out = new Locale()
			assign(out, self)
			if value == "" {
				out.keywords.delete(key.lower())
			} else {
				out.keywords[key.lower()] = value.lower()
			}
			return out
		}

		// Maximize returns the locale with the script and region its language
		// is most likely written in and used in ("zh-TW" -> "zh-Hant-TW").
		def maximize() Locale {
			return withTag(self, subtags.maximize(tagOf(self)))
		}

		// Minimize returns the locale without the script and region maximize
		// would add back ("zh-Hant-TW" -> "zh-TW", "en-Latn-US" -> "en").
		def minimize() Locale {
			return withTag(self, subtags.minimize(tagOf(self)))
		}

		// RightToLeft reports whether the locale's language is written right
		// to left (Arabic, Hebrew, Persian, ...).
		def rightToLeft() bool {
			let order = tables.value("layout", dataLocaleOf(self), "layout/orientation/characterOrder")
			return false when order is none
			return order == "right-to-left"
		}

		// Name returns the locale's display name in the given locale:
		// "Deutsch (Schweiz)" for de-CH in German, "British English" for en-GB
		// in English.
		def name(locale Locale) string {
			return localeName(self, locale)
		}
	}

	// Copies every part of from into to.
	internal def assign(to Locale, from Locale) {
		to.language = from.language
		to.script = from.script
		to.region = from.region
		to.variants = from.variants.clone()
		to.keywords = map<string, string>{}
		for let (k, v) in from.keywords {
			to.keywords[k] = v
		}
		to.extensions = from.extensions.clone()
		to.privateUse = from.privateUse
		to.attributes = from.attributes.clone()
	}

	internal def tagOf(l Locale) subtags.Tag {
		return subtags.Tag{language: l.language.code, script: l.script.code, region: l.region.code, variants: l.variants.clone()}
	}

	// A copy of l with the language, script, region and variants of t.
	internal def withTag(l Locale, t subtags.Tag) Locale {
		let out = new Locale()
		assign(out, l)
		out.language = new Language(t.language)
		out.script = new Script(t.script)
		out.region = new Region(t.region)
		out.variants = t.variants
		return out
	}

	// ParseLocale reads a BCP 47 tag ("de-CH", "zh-Hant-TW-u-nu-hanidec") or
	// a POSIX locale name ("de_CH.UTF-8", "sr_RS@latin", "C"), canonicalized:
	// subtags cased as BCP 47 writes them, deprecated codes replaced ("iw" ->
	// "he"), variants and extensions sorted. Fails with a LocaleError when the
	// tag is not well-formed.
	def parseLocale(tag string) !Locale {
		let text = tag.trim()
		let modifier = ""
		let at = text.indexOf("@")
		if at >= 0 {
			modifier = text[at + 1:].lower()
			text = text[:at]
		}
		let dot = text.indexOf(".")
		text = text[:dot] when dot >= 0
		if text := "C" || "POSIX" {
			text = "en-US-posix"
		}
		let parts = text.replace("_", "-").split("-")
		let out = new Locale()
		let bad = (why string) => LocaleError{message: "locale \"" + tag + "\": " + why, code: "locale", tag: tag}
		fail bad("empty tag") when text == ""
		for let p in parts {
			fail bad("empty subtag") when p == ""
			fail bad("subtag \"" + p + "\" is not letters and digits") when !p.isAlphanumeric()
		}
		let i = 0
		let first = parts[0].lower()
		if first == "x" {
			// Private use only.
		} else if first == "root" {
			i = 1
		} else if first.isAlpha() && (first.len() >= 2 && first.len() <= 3 || first.len() >= 5 && first.len() <= 8) {
			out.language = new Language(first)
			i = 1
			// Extended language subtags name the language itself ("zh-yue" is "yue").
			let ext = 0
			for i < parts.len() && ext < 3 && parts[i].len() == 3 && parts[i].isAlpha() && first.len() <= 3 {
				out.language = new Language(parts[i])
				i++
				ext++
			}
		} else {
			fail bad("\"" + parts[0] + "\" is not a language")
		}
		if i < parts.len() && parts[i].len() == 4 && parts[i].isAlpha() {
			out.script = new Script(parts[i])
			i++
		}
		if i < parts.len() && (parts[i].len() == 2 && parts[i].isAlpha() || parts[i].len() == 3 && parts[i].isNumeric()) {
			out.region = new Region(parts[i])
			i++
		}
		for i < parts.len() && isVariant(parts[i]) {
			let v = parts[i].lower()
			fail bad("variant \"" + v + "\" repeats") when out.variants.includes(v)
			out.variants.push(v)
			i++
		}
		let singletons = string[]
		for i < parts.len() {
			let s = parts[i].lower()
			fail bad("\"" + parts[i] + "\" is out of place") when s.len() != 1
			if s == "x" {
				fail bad("empty private use") when i + 1 >= parts.len()
				out.privateUse = parts[i + 1:].join("-").lower()
				break
			}
			fail bad("extension \"" + s + "\" repeats") when singletons.includes(s)
			singletons.push(s)
			i++
			let start = i
			for i < parts.len() && parts[i].len() >= 2 {
				i++
			}
			fail bad("extension \"" + s + "\" is empty") when i == start
			let body = parts[start:i]
			if s == "u" {
				readUnicodeExtension(out, body)
			} else {
				out.extensions.push(s + "-" + body.join("-").lower())
			}
		}
		let t = tagOf(out)
		if modifier != "" {
			let s = scriptOfModifier(modifier)
			t.script = s when s != "" && t.script == ""
		}
		subtags.canonicalize(t)
		return withTag(out, t)
	}

	internal def isVariant(p string) bool {
		return p.len() >= 5 && p.len() <= 8 || p.len() == 4 && p[0:1].isNumeric()
	}

	// Reads the subtags after "-u-": attributes, then keys with their types.
	internal def readUnicodeExtension(out Locale, body string[]) {
		let i = 0
		for i < body.len() && body[i].len() >= 3 {
			out.attributes.push(body[i].lower())
			i++
		}
		for i < body.len() {
			let key = body[i].lower()
			i++
			let values = string[]
			for i < body.len() && body[i].len() >= 3 {
				values.push(body[i].lower())
				i++
			}
			out.keywords[key] = values.len() == 0 ?? ("true", values.join("-")) unless out.keywords.hasKey(key)
		}
	}

	// POSIX locale modifiers that name a script, by script.
	internal let posixScripts = map<string, string>{"Latn": "latin", "Cyrl": "cyrillic", "Deva": "devanagari", "Arab": "arabic"}

	internal def posixModifier(script string) string {
		return "" unless posixScripts.hasKey(script)
		return posixScripts[script]
	}

	internal def scriptOfModifier(modifier string) string {
		for let (script, m) in posixScripts {
			return script when m == modifier
		}
		return ""
	}

	// The CLDR locale holding a locale's data, cached by tag.
	internal type DataLocales {
		names map<string, string>

		def new() {
			names = map<string, string>{}
		}

		atomic def of(l Locale) string {
			let key = l.str()
			return names[key] when names.hasKey(key)
			let name = subtags.dataLocale(tagOf(l))
			names[key] = name
			return name
		}
	}

	internal let dataLocales = new DataLocales()

	internal def dataLocaleOf(l Locale) string {
		return dataLocales.of(l)
	}
}
