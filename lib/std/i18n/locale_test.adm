partial module std.i18n {
	use std.testing

	check "Locales" {
		def tagOfText(text string) string {
			let l = parseLocale(text) onerror recover new Locale("und-x-failed")
			return l.str()
		}

		def picked(found ?Locale) string {
			return "none" when found is none
			return found.str()
		}

		def locales(tags string[]) Locale[] {
			let out = Locale[]
			for let t in tags {
				out.push(new Locale(t))
			}
			return out
		}

		@test()
		def readsBcp47Tags() {
			assert tagOfText("de-CH") == "de-CH"
			assert tagOfText("ZH-hant-tw") == "zh-Hant-TW"
			assert tagOfText("es-419") == "es-419"
			assert tagOfText("en-US-u-CA-buddhist-nu-thai") == "en-US-u-ca-buddhist-nu-thai"
			assert tagOfText("en-u-nu-thai-ca-buddhist") == "en-u-ca-buddhist-nu-thai"
			assert tagOfText("de-u-co-phonebk-kn") == "de-u-co-phonebk-kn"
			assert tagOfText("ja-t-it-x-private") == "ja-t-it-x-private"
			assert tagOfText("sl-rozaj-biske") == "sl-biske-rozaj"
			assert tagOfText("x-whatever") == "und-x-whatever"
			let l = new Locale("th-TH-u-nu-thai")
			assert l.language.code == "th"
			assert l.region.code == "TH"
			let nu = l.keyword("nu")
			assert !(nu is none) && nu == "thai"
			assert l.keyword("ca") is none
			assert l.withKeyword("ca", "buddhist").str() == "th-TH-u-ca-buddhist-nu-thai"
			assert l.withKeyword("nu", "").str() == "th-TH"
			assert new Locale("DE_ch").equals(new Locale("de-CH"))
			assert !new Locale("de").equals(new Locale("de-CH"))
		}

		@test()
		def readsPosixNames() {
			assert tagOfText("de_CH.UTF-8") == "de-CH"
			assert tagOfText("sr_RS@latin") == "sr-Latn-RS"
			assert tagOfText("C") == "en-US-posix"
			assert new Locale("sr-Latn-RS").posix() == "sr_RS@latin"
			assert new Locale("pt-BR").posix() == "pt_BR"
		}

		@test()
		def refusesIllFormedTags() {
			assert parseLocale("") is error
			assert parseLocale("a") is error
			assert parseLocale("en--US") is error
			assert parseLocale("en-US-u") is error
			assert parseLocale("de-1996-1996") is error
			assert parseLocale("en-a-bc-a-de") is error
			assert parseLocale("en_US!") is error
			assert new Locale("not a tag").str() == "und"
		}

		@test()
		def replacesDeprecatedCodes() {
			assert tagOfText("iw") == "he"
			assert tagOfText("in-ID") == "id-ID"
			assert tagOfText("sh") == "sr-Latn"
			assert tagOfText("zh-yue") == "yue"
			assert tagOfText("de-DD") == "de-DE"
			assert tagOfText("ru-SU") == "ru-RU"
			assert tagOfText("hy-SU") == "hy-AM"
		}

		@test()
		def addsAndRemovesLikelySubtags() {
			assert new Locale("zh-TW").maximize().str() == "zh-Hant-TW"
			assert new Locale("zh").maximize().str() == "zh-Hans-CN"
			assert new Locale("und").maximize().str() == "en-Latn-US"
			assert new Locale("sr-ME").maximize().str() == "sr-Latn-ME"
			assert new Locale("und-Arab").maximize().str() == "ar-Arab-EG"
			assert new Locale("zh-Hant-TW").minimize().str() == "zh-TW"
			assert new Locale("en-Latn-US").minimize().str() == "en"
			assert new Locale("de-Latn-CH").minimize().str() == "de-CH"
			assert new Locale("zh-Hant").minimize().str() == "zh-TW"
		}

		@test()
		def namesLocales() {
			let de = new Locale("de")
			let en = new Locale("en")
			assert new Locale("de-CH").name(de) == "Schweizer Hochdeutsch"
			assert new Locale("de-LU").name(de) == "Deutsch (Luxemburg)"
			assert new Locale("en-GB").name(en) == "British English"
			assert new Locale("sr-Latn-RS").name(new Locale("fr")) == "serbe (latin, Serbie)"
			assert new Locale("ja-u-ca-japanese").name(en) == "Japanese (Japanese Calendar)"
			assert new Language("ja").name(en) == "Japanese"
			assert new Region("DE").name(new Locale("fr")) == "Allemagne"
			assert new Script("Cyrl").name(de) == "Kyrillisch"
			assert new Language("qqq").name(en) == "qqq"
		}

		@test()
		def knowsWritingDirection() {
			assert new Locale("ar-EG").rightToLeft()
			assert new Locale("he").rightToLeft()
			assert !new Locale("de").rightToLeft()
		}

		@test()
		def knowsRegionGroups() {
			assert new Region("150").contains(new Region("DE"))
			assert new Region("419").contains(new Region("MX"))
			assert !new Region("150").contains(new Region("US"))
		}

		@test()
		def negotiatesLocales() {
			assert picked(negotiate(locales(string["de-AT"]), locales(string["en", "de"]))) == "de"
			assert picked(negotiate(locales(string["en-AU"]), locales(string["en-US", "en-GB"]))) == "en-GB"
			assert picked(negotiate(locales(string["en-CA"]), locales(string["en-GB", "en-US"]))) == "en-US"
			assert picked(negotiate(locales(string["sr-ME"]), locales(string["sr-Cyrl", "sr-Latn"]))) == "sr-Latn"
			assert picked(negotiate(locales(string["nb"]), locales(string["no", "da"]))) == "no"
			assert picked(negotiate(locales(string["fr"]), locales(string["de", "en"]))) == "none"
			assert picked(negotiate(locales(string["zh-TW"]), locales(string["zh-CN"]))) == "none"
			assert picked(negotiate(locales(string["fr", "de"]), locales(string["en", "de"]))) == "de"
			assert picked(negotiate("fr-CH, de;q=0.9, en;q=0.5", locales(string["en", "de"]))) == "de"
			assert picked(negotiate("en;q=0.1, de", locales(string["en", "de"]))) == "de"
			let ranked = parseAcceptLanguage("en;q=0.5, *, fr-CH, de;q=0.9, xx-!!, it;q=0")
			assert ranked.len() == 3
			assert ranked[0].str() == "fr-CH" && ranked[1].str() == "de" && ranked[2].str() == "en"
		}
	}
}
