partial module std.i18n {
	use (
		std.errors
		std.i18n.msgfmt
		std.math::(Decimal, RoundingMode, parseDecimal)
		std.reflection
		std.services.i18n::(I18n)
		std.text.unicode
		std.time::(Date, DateTime, Time, TimeOfDay, fromUnixNs)
	)

	// MessageError reports a message pattern that is not well-formed.
	struct MessageError {
		message  string
		code     string
		cause    ?error
		stack    errors.StackTrace
		// The pattern as given.
		pattern  string
		// Where it goes wrong, in characters from 0.
		position int
	}

	// MessagePartKind says whether a part of a formatted message is the
	// message's own text or the value of an argument.
	enum MessagePartKind {
		Text
		Argument
	}

	// MessagePart is a run of a formatted message.
	struct MessagePart {
		kind MessagePartKind
		text string
		// The argument the text is the value of; "" for the message's own text.
		name string          = ""
	}

	// Message is translated text with places for values, in the ICU
	// MessageFormat syntax:
	//
	//     let m = new Message("{count, plural, =0{No files} one{# file} other{# files}} in {folder}", new Locale("en"))
	//     m.format({"count": 1200, "folder": "Inbox"})   // "1,200 files in Inbox"
	//
	// An argument is `{name}`, or `{name, type}` or `{name, type, style}` with
	// the types:
	//
	//   - `number`: style `integer`, `currency`, `percent`, a number pattern
	//     (`#,##0.00`) or `::` and a number skeleton (`::compact-short`)
	//   - `date`, `time`: style `short`, `medium`, `long`, `full`, a date
	//     pattern (`d MMM y`) or `::` and a skeleton (`::yMMMd`)
	//   - `spellout`, `ordinal`, `duration`: the number in words, as a rank,
	//     as a length of time in seconds; the style names another rule set
	//   - `plural`, `selectordinal`: cases by the language's plural form of
	//     the number (`one`, `few`, `other`, ...) or by the number itself
	//     (`=0`), after an optional `offset:1`; `#` in a case is the number
	//   - `select`: cases by the value's text; `other` when none matches
	//   - `choice`: cases by number ranges (`0#none|1#one|1<many`)
	//
	// Cases hold messages, so they nest. An apostrophe before `{` or `}`
	// quotes text up to the next apostrophe; two apostrophes are one.
	//
	// Plural forms are chosen by the message's locale, the language of its
	// text; numbers and dates are written the way `format`'s region writes
	// them, the message's locale when none is given.
	//
	// Values are numbers (any integer or float type, `bigint`, `Decimal`),
	// text, `Time`, `ZonedDateTime`, `Date`, `DateTime`, `TimeOfDay`, and for
	// a date an integer of milliseconds since 1970 UTC. An argument without a
	// type is written by what it holds: a number as the region writes
	// numbers, a time in the short style, an enum member as its name. An argument `params` lacks is
	// written as `{name}`. A value its type cannot format is written as its
	// plain text, and takes the `other` case of a plural.
	//
	// Positional arguments are named by their number: `{0}` reads `params["0"]`.
	//
	// A value whose text runs the other way than the message (Latin in an
	// Arabic message) is wrapped in the isolate marks U+2068 and U+2069, so
	// it cannot reorder the text around it.
	type Message {
		// The language of the text.
		locale  Locale
		// The pattern as given.
		pattern string

		internal nodes       msgfmt.Node[]
		internal rightToLeft bool

		// New reads the pattern leniently: one that is not well-formed is
		// kept as literal text. Use parseMessage to be told.
		def new(pattern string, locale Locale) {
			self.pattern = pattern
			self.locale = locale
			rightToLeft = locale.rightToLeft()
			let reader = new msgfmt.Parser(pattern)
			let parsed = reader.parse() onerror recover msgfmt.Node[]
			let checked = stylesHold(parsed)
			parsed = [msgfmt.Node{kind: msgfmt.NodeKind.Text, text: pattern}] when reader.failedAt >= 0 || !checked
			nodes = parsed
		}

		// New reads the pattern, leniently, as text in the language in use:
		// the one the `I18n` service holds for the calling task, else for
		// the program, else the system's.
		def new(pattern string) {
			let made = new Message(pattern, I18n.language())
			self.pattern = pattern
			locale = made.locale
			nodes = made.nodes
			rightToLeft = made.rightToLeft
		}

		internal def new(pattern string, locale Locale, nodes msgfmt.Node[]) {
			self.pattern = pattern
			self.locale = locale
			self.nodes = nodes
			rightToLeft = locale.rightToLeft()
		}

		// Format writes the message with the values of `params`, numbers and
		// dates as `region` writes them (the message's locale when none), an
		// instant in `zone` (the system's time zone when none).
		def format(params map<string, any> = {}, region ?Locale = none, zone ?TimeZone = none) string {
			let run = new MessageRun(params, region is none ?? (locale, region), self, false)
			run.zone = zone
			run.write(nodes, "", "")
			return run.text
		}

		// Parts writes the message as `format` does, as the runs it is made
		// of: the message's own text and each argument's value, for showing
		// values in another style.
		def parts(params map<string, any> = {}, region ?Locale = none, zone ?TimeZone = none) MessagePart[] {
			let run = new MessageRun(params, region is none ?? (locale, region), self, true)
			run.zone = zone
			run.write(nodes, "", "")
			run.flush()
			return run.parts
		}

		// Arguments returns the names of the arguments the pattern uses, each
		// once, in the order they first appear.
		def arguments() string[] {
			let names = string[]
			collectArguments(nodes, names)
			return names
		}

		// Str returns the pattern.
		def str() string {
			return pattern
		}
	}

	// ParseMessage reads a pattern in the ICU MessageFormat syntax for text
	// in the locale's language.
	// Fails with a MessageError when the pattern is not well-formed: an
	// unclosed argument, an unknown type, plural or select cases without
	// `other`, a number skeleton that cannot be read.
	def parseMessage(pattern string, locale Locale) !Message {
		let reader = new msgfmt.Parser(pattern)
		let nodes = reader.parse() onerror (err error) {
			fail MessageError{
				message:  "message \"" + pattern + "\": " + err.message + " (character {reader.failedAt + 1})",
				code:     "message",
				pattern:  pattern,
				position: reader.failedAt,
			}
		}
		checkStyles(nodes) onerror (err error) {
			fail MessageError{message: "message \"" + pattern + "\": " + err.message, code: "message", pattern: pattern, position: 0}
		}
		return new Message(pattern, locale, nodes)
	}

	// A message that picks one of a catalog's plural forms by the catalog's
	// plural expression: the count is the parameter "count", else "n", else
	// the only number given. Forms that are not well-formed are literal text.
	internal def formsMessage(forms string[], rule msgfmt.PluralExpression, locale Locale) Message {
		let node = msgfmt.Node{kind: msgfmt.NodeKind.Forms, rule: rule}
		for let form in forms {
			node.cases.push(msgfmt.Case{nodes: new Message(form, locale).nodes})
		}
		return new Message(forms.len() > 0 ?? (forms[0], ""), locale, [node])
	}

	internal def collectArguments(nodes msgfmt.Node[], names string[]) {
		for let node in nodes {
			names.push(node.name) when node.name != "" && !names.includes(node.name)
			for let item in node.cases {
				collectArguments(item.nodes, names)
			}
		}
	}

	// Fails when a number style of the nodes is a skeleton that cannot be read.
	internal def checkStyles(nodes msgfmt.Node[]) !none {
		for let node in nodes {
			if node.kind == msgfmt.NodeKind.Number {
				let spec = node.text.trim()
				try numberSkeleton(spec[2:]) when spec.startsWith("::")
			}
			for let item in node.cases {
				try checkStyles(item.nodes)
			}
		}
		return none
	}

	internal def stylesHold(nodes msgfmt.Node[]) bool {
		let held = true
		checkStyles(nodes) onerror (err error) {
			held = false
			recover none
		}
		return held
	}

	// MessageRun is one formatting of a message: the values, the locale
	// numbers and dates are written for, and what has been written.
	internal type MessageRun {
		params  map<string, any>
		region  Locale
		// The time zone instants are written in; none for the system's.
		zone    ?TimeZone        = none
		tag     string
		message Message
		// Whether the parts are kept, besides the text.
		keep    bool
		text    string
		parts   MessagePart[]
		// The message's own text since the last value, while parts are kept.
		pending string

		def new(params map<string, any>, region Locale, message Message, keep bool) {
			self.params = params
			self.region = region
			self.message = message
			self.keep = keep
			tag = region.str()
		}

		def literal(s string) {
			if keep {
				pending += s
			} else {
				text += s
			}
		}

		def flush() {
			return when pending == ""
			parts.push(MessagePart{kind: MessagePartKind.Text, text: pending})
			pending = ""
		}

		// Writes an argument's value, isolated when it runs the other way
		// than the message.
		def value(name string, s string) {
			let shown = s
			if message.rightToLeft || !s.isASCII() {
				let way = unicode.direction(s)
				if !(way is none) && (way == unicode.Direction.RightToLeft) != message.rightToLeft {
					shown = "⁨" + s + "⁩"
				}
			}
			if keep {
				flush()
				parts.push(MessagePart{kind: MessagePartKind.Argument, text: shown, name: name})
			} else {
				text += shown
			}
		}

		// Writes the nodes. `poundName` and `pound` are the argument and the
		// text `#` stands for, "" outside a plural.
		def write(nodes msgfmt.Node[], poundName string, pound string) {
			for let node in nodes {
				match node.kind {
					case msgfmt.NodeKind.Text:
						literal(node.text)
					case msgfmt.NodeKind.Pound:
						if poundName == "" {
							literal("#")
						} else {
							value(poundName, pound)
						}
					case msgfmt.NodeKind.Forms:
						forms(node, poundName, pound)
					default:
						argument(node)
				}
			}
		}

		def argument(node msgfmt.Node) {
			let held = params.get(node.name)
			if held is none {
				literal("\{" + node.name + "\}")
				return
			}
			let given any = held
			match node.kind {
				case msgfmt.NodeKind.Argument:
					value(node.name, plain(given))
				case msgfmt.NodeKind.Number:
					value(node.name, number(given, node.text))
				case msgfmt.NodeKind.Date:
					value(node.name, moment(given, messageFormats.date(region, tag, true, node.text), zone))
				case msgfmt.NodeKind.Time:
					value(node.name, moment(given, messageFormats.date(region, tag, false, node.text), zone))
				case msgfmt.NodeKind.SpellOut:
					value(node.name, spelled(given, node.text, "%spellout-numbering"))
				case msgfmt.NodeKind.Ordinal:
					value(node.name, spelled(given, node.text, "%digits-ordinal"))
				case msgfmt.NodeKind.Duration:
					value(node.name, spelled(given, node.text, "%duration"))
				case msgfmt.NodeKind.Plural:
					plural(node, given, PluralType.Cardinal)
				case msgfmt.NodeKind.SelectOrdinal:
					plural(node, given, PluralType.Ordinal)
				case msgfmt.NodeKind.Select:
					let key = textOf(given)
					let other = -1
					let chosen = -1
					for let (i, item) in node.cases {
						if item.keyword == key {
							chosen = i
							break
						}
						other = i when other < 0 && item.keyword == "other"
					}
					chosen = other when chosen < 0
					write(node.cases[chosen].nodes, "", "") when chosen >= 0
				case msgfmt.NodeKind.Choice:
					choice(node, given)
				default:
			}
		}

		// An argument without a type, by what it holds.
		def plain(given any) string {
			return given when given is string
			return number(given, "") unless decimalOf(given) is none && odd(given) is none
			return moment(given, messageFormats.shortDateTime(region, tag), zone) when given is Time || given is ZonedDateTime || given is DateTime
			return moment(given, messageFormats.date(region, tag, true, "short"), zone) when given is Date
			return moment(given, messageFormats.date(region, tag, false, "short"), zone) when given is TimeOfDay
			return textOf(given)
		}

		def number(given any, spec string) string {
			let format = messageFormats.number(region, tag, spec)
			let special = odd(given)
			return format.format(special) unless special is none
			let exact = numberOf(given)
			return textOf(given) when exact is none
			return format.format(exact)
		}

		def spelled(given any, spec string, ruleSet string) string {
			let exact = numberOf(given)
			return textOf(given) when exact is none
			let asked = spec.trim()
			return messageFormats.speller(region, tag, asked == "" ?? (ruleSet, asked)).format(exact)
		}

		def plural(node msgfmt.Node, given any, kind PluralType) {
			let exact = numberOf(given)
			let other = -1
			let chosen = -1
			let shown = textOf(given)
			if !(exact is none) {
				let asFloat = exact.toFloat()
				let less = node.offset == 0.0 ?? (exact, exact - new Decimal(node.offset))
				shown = messageFormats.number(region, tag, "").format(less)
				// As ICU does, the form is that of the number as a plain number
				// format writes it: at most three fraction digits, none trailing.
				let keyword = categoryName(pluralCategory(message.locale, less.round(3, RoundingMode.HalfEven).trim().str(), kind))
				let byKeyword = -1
				for let (i, item) in node.cases {
					if item.exact {
						if item.value == asFloat {
							chosen = i
							break
						}
						continue
					}
					byKeyword = i when byKeyword < 0 && item.keyword == keyword
					other = i when other < 0 && item.keyword == "other"
				}
				chosen = byKeyword when chosen < 0
			} else {
				for let (i, item) in node.cases {
					other = i when other < 0 && !item.exact && item.keyword == "other"
				}
			}
			chosen = other when chosen < 0
			write(node.cases[chosen].nodes, node.name, shown) when chosen >= 0
		}

		// The first case, then each next one while the number passes its limit.
		def choice(node msgfmt.Node, given any) {
			let chosen = 0
			let exact = numberOf(given)
			let special = odd(given)
			if !(exact is none && special is none) {
				let n = 0.0
				if !(special is none) {
					n = special
				} else if !(exact is none) {
					n = exact.toFloat()
				}
				for let i = 1; i < node.cases.len(); i++ {
					let item = node.cases[i]
					let passes = item.above ?? (n > item.value, n >= item.value)
					break unless passes
					chosen = i
				}
			}
			write(node.cases[chosen].nodes, "", "") when node.cases.len() > 0
		}

		// A catalog's plural forms: the one its expression gives for the count.
		def forms(node msgfmt.Node, poundName string, pound string) {
			return when node.cases.len() == 0
			let rule = node.rule
			let index = 0
			let count = countGiven()
			index = rule.index(int(count.round(0, RoundingMode.Trunc).toInt())) unless rule is none || count is none
			index = 0 when index >= node.cases.len()
			write(node.cases[index].nodes, poundName, pound)
		}

		def countGiven() ?Decimal {
			for let name in ["count", "n"] {
				let held = params.get(name)
				continue when held is none
				let exact = numberOf(held)
				return exact unless exact is none
			}
			let only ?Decimal = none
			for let (_, held) in params {
				let exact = numberOf(held)
				continue when exact is none
				return none unless only is none
				only = exact
			}
			return only
		}
	}

	// The value as an exact number: numbers as they are, text that reads as one.
	internal def numberOf(given any) ?Decimal {
		let exact = decimalOf(given)
		return exact unless exact is none
		if given is string {
			let text = given.trim()
			let read = true
			let parsed = parseDecimal(text) onerror (err error) {
				read = false
				recover new Decimal()
			}
			return read ?? (parsed, none)
		}
		return none
	}

	// A number held in a value, exactly; none for anything else, and for the
	// floats a decimal cannot hold (see odd).
	internal def decimalOf(given any) ?Decimal {
		return given when given is Decimal
		return new Decimal(given) when given is int
		return new Decimal(given, 0) when given is bigint
		if given is float {
			return none when given != given || given - given != 0.0
			return new Decimal(given)
		}
		if given is float32 {
			let wide = float(given)
			return none when wide != wide || wide - wide != 0.0
			return new Decimal(wide)
		}
		// The other integer widths, through their text.
		if reflection.kindOf(given) := reflection.FieldKind.Int || reflection.FieldKind.Uint {
			let read = true
			let parsed = parseDecimal(reflection.scalarText(given)) onerror (err error) {
				read = false
				recover new Decimal()
			}
			return parsed when read
		}
		return none
	}

	// A float that is not a number or is infinite, which only a number
	// format can write; none for anything else.
	internal def odd(given any) ?float {
		if given is float {
			return given when given != given || given - given != 0.0
		}
		if given is float32 {
			let wide = float(given)
			return wide when wide != wide || wide - wide != 0.0
		}
		return none
	}

	// A value as plain text.
	internal def textOf(given any) string {
		return given when given is string
		return given ?? ("true", "false") when given is bool
		return given.str() when given is Stringer
		// An enum member by its name.
		if reflection.kindOf(given) == reflection.FieldKind.Enum {
			let described = reflection.descriptorOf(given)
			if !(described is none) {
				for let member in reflection.members(described) {
					return member.node.name when member.value == given
				}
			}
		}
		return "{given}"
	}

	// A date or a time written by a format: an instant (in `zone`, the
	// format's own when none), a zoned or plain value, or milliseconds since
	// 1970 UTC; anything else as plain text.
	internal def moment(given any, format DateTimeFormat, zone ?TimeZone = none) string {
		if given is Time {
			return format.format(given) when zone is none
			return format.format(new ZonedDateTime(given, zone))
		}
		return format.format(given) when given is ZonedDateTime
		if given is Date {
			return format.format(given) onerror recover given.str()
		}
		if given is DateTime {
			return format.format(given) onerror recover given.str()
		}
		if given is TimeOfDay {
			return format.format(given) onerror recover given.str()
		}
		let exact = decimalOf(given)
		return textOf(given) when exact is none
		let milliseconds = int64(int(exact.round(0, RoundingMode.Trunc).toInt()))
		let instant = fromUnixNs(milliseconds * 1000000)
		return format.format(instant) when zone is none
		return format.format(new ZonedDateTime(instant, zone))
	}

	// The number options of a message number style, by ICU's rules: no
	// style, `integer`, `currency`, `percent`, `::` and a skeleton, else a
	// pattern. A skeleton that cannot be read writes as no style does.
	internal def numberStyle(spec string, locale Locale) NumberOptions {
		let text = spec.trimStart()
		if text.startsWith("::") {
			return numberSkeleton(text[2:]) onerror recover NumberOptions{roundingMode: RoundingMode.HalfEven}
		}
		// ICU writes these through its older number format, which groups from
		// four digits on in every locale (Spanish "1.234").
		let plain = NumberOptions{roundingMode: RoundingMode.HalfEven, grouping: Grouping.Always}
		let keyword = spec.trim().lower()
		match keyword {
			case "":
				return plain
			case "integer":
				plain.maximumFractionDigits = 0
				return plain
			case "percent":
				plain.kind = NumberKind.Percent
				return plain
			case "currency":
				// As ICU: the currency of the locale's own region, the unknown
				// currency for a locale without one.
				let own = locale.region.currency()
				plain.kind = NumberKind.Currency
				plain.currency = own is none ?? ("XXX", own.code)
				return plain
		}
		plain.pattern = spec
		return plain
	}

	// The date options of a message date or time style: a width, `::` and a
	// skeleton, else a pattern; no style is the medium width.
	internal def dateStyle(spec string, date bool) DateTimeOptions {
		let width = DateTimeStyle.Off
		match spec.trim().lower() {
			case "":
				width = DateTimeStyle.Medium
			case "short":
				width = DateTimeStyle.Short
			case "medium":
				width = DateTimeStyle.Medium
			case "long":
				width = DateTimeStyle.Long
			case "full":
				width = DateTimeStyle.Full
		}
		return date ?? (DateTimeOptions{dateStyle: width}, DateTimeOptions{timeStyle: width}) when width != DateTimeStyle.Off
		let text = spec.trimStart()
		return DateTimeOptions{skeleton: text[2:].trim()} when text.startsWith("::")
		return DateTimeOptions{pattern: spec}
	}

	// MessageFormats holds the formats messages and the I18n service write
	// through, by locale and style, so each is built once. Formats are read
	// from many tasks; the lookups are atomic.
	internal type MessageFormats {
		numbers  map<string, NumberFormat>
		dates    map<string, DateTimeFormat>
		spellers map<string, SpellOut>

		def new() {}

		atomic def number(locale Locale, tag string, spec string) NumberFormat {
			let key = tag + "\x1f" + spec
			let held = numbers.get(key)
			return held unless held is none
			numbers = map<string, NumberFormat>{} when numbers.len() >= formatLimit
			let made = new NumberFormat(locale, numberStyle(spec, locale))
			numbers[key] = made
			return made
		}

		atomic def date(locale Locale, tag string, date bool, spec string) DateTimeFormat {
			let key = tag + (date ?? ("\x1fd", "\x1ft")) + spec
			let held = dates.get(key)
			return held unless held is none
			dates = map<string, DateTimeFormat>{} when dates.len() >= formatLimit
			let made = new DateTimeFormat(locale, dateStyle(spec, date))
			dates[key] = made
			return made
		}

		// A format with the date and the time in the short width.
		def shortDateTime(locale Locale, tag string) DateTimeFormat {
			return dateTime(locale, tag, DateTimeStyle.Short, DateTimeStyle.Short)
		}

		atomic def dateTime(locale Locale, tag string, dateWidth DateTimeStyle, timeWidth DateTimeStyle) DateTimeFormat {
			let key = tag + "\x1fb" + styleName(dateWidth) + "/" + styleName(timeWidth)
			let held = dates.get(key)
			return held unless held is none
			dates = map<string, DateTimeFormat>{} when dates.len() >= formatLimit
			let made = new DateTimeFormat(locale, DateTimeOptions{dateStyle: dateWidth, timeStyle: timeWidth})
			dates[key] = made
			return made
		}

		atomic def speller(locale Locale, tag string, ruleSet string) SpellOut {
			let key = tag + "\x1f" + ruleSet
			let held = spellers.get(key)
			return held unless held is none
			spellers = map<string, SpellOut>{} when spellers.len() >= formatLimit
			let made = new SpellOut(locale, ruleSet)
			spellers[key] = made
			return made
		}
	}

	// Formats are built once per locale and style and kept; a program that
	// formats for locales without end starts over at this many.
	internal const formatLimit = 512

	internal let messageFormats = new MessageFormats()
}
