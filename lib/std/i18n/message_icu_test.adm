			failed++ unless same("pt-BR", "\{x, number, 000\}", {"x": 12345}, " 12345")
			failed++ unless same("en", "\{x, number, #\}", {"x": 1234.5678}, " 1235")
			failed++ unless same("en", "\{x, number, #\}", {"x": -0.256}, "- 0")
			failed++ unless same("en", "\{x, number, #\}", {"x": 0}, " 0")
			failed++ unless same("en", "\{x, number, #\}", {"x": 1234567}, " 1234567")
			failed++ unless same("en", "\{x, number, #\}", {"x": 2.5}, " 2")
			failed++ unless same("en", "\{x, number, #\}", {"x": 1.005}, " 1")
			failed++ unless same("en", "\{x, number, #\}", {"x": 0.5}, " 0")
			failed++ unless same("en", "\{x, number, #\}", {"x": 12345}, " 12345")
			failed++ unless same("de", "\{x, number, #\}", {"x": 1234.5678}, " 1235")
			failed++ unless same("de", "\{x, number, #\}", {"x": -0.256}, "- 0")
			failed++ unless same("de", "\{x, number, #\}", {"x": 0}, " 0")
			failed++ unless same("de", "\{x, number, #\}", {"x": 1234567}, " 1234567")
			failed++ unless same("de", "\{x, number, #\}", {"x": 2.5}, " 2")
			failed++ unless same("de", "\{x, number, #\}", {"x": 1.005}, " 1")
			failed++ unless same("de", "\{x, number, #\}", {"x": 0.5}, " 0")
			failed++ unless same("de", "\{x, number, #\}", {"x": 12345}, " 12345")
			failed++ unless same("pt-BR", "\{x, number, #\}", {"x": 1234.5678}, " 1235")
			failed++ unless same("pt-BR", "\{x, number, #\}", {"x": -0.256}, "- 0")
			failed++ unless same("pt-BR", "\{x, number, #\}", {"x": 0}, " 0")
			failed++ unless same("pt-BR", "\{x, number, #\}", {"x": 1234567}, " 1234567")
			failed++ unless same("pt-BR", "\{x, number, #\}", {"x": 2.5}, " 2")
			failed++ unless same("pt-BR", "\{x, number, #\}", {"x": 1.005}, " 1")
			failed++ unless same("pt-BR", "\{x, number, #\}", {"x": 0.5}, " 0")
			failed++ unless same("pt-BR", "\{x, number, #\}", {"x": 12345}, " 12345")
			failed++ unless same("en", "\{x, number, #.##%\}", {"x": 1234.5678}, " 123456.78%")
			failed++ unless same("en", "\{x, number, #.##%\}", {"x": -0.256}, "- 25.6%")
			assert failed == 0
		}

		@test()
		def formatsAsIcu11() {
