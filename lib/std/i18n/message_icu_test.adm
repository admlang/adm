			failed++ unless same("en", "\{x, number, currency\}", {"x": 12345}, "¤12,345.00")
			failed++ unless same("de", "\{x, number, currency\}", {"x": 1234.5678}, "1.234,57\u00a0XXX")
			failed++ unless same("de", "\{x, number, currency\}", {"x": -0.256}, "-0,26\u00a0XXX")
			assert failed == 0
		}

