			failed++ unless same("en", "\{n, selectordinal, one\{#st\} two\{#nd\} few\{#rd\} other\{#th\}\}", {"n": 1003}, "1,003rd")
			failed++ unless same("fr", "\{n, selectordinal, one\{#er\} other\{#e\}\}", {"n": 1}, "1er")
			failed++ unless same("fr", "\{n, selectordinal, one\{#er\} other\{#e\}\}", {"n": 2}, "2e")
			failed++ unless same("cy", "\{n, selectordinal, zero\{#fed\} one\{#af\} two\{#il\} few\{#ydd\} many\{#ed\} other\{#fed\}\}", {"n": 5}, "5ed")
			failed++ unless same("en", "\{g, select, female\{She\} male\{He\} other\{They\}\} replied", {"g": "female"}, "She replied")
			failed++ unless same("en", "\{g, select, female\{She\} male\{He\} other\{They\}\} replied", {"g": "male"}, "He replied")
			failed++ unless same("en", "\{g, select, female\{She\} male\{He\} other\{They\}\} replied", {"g": "nonbinary"}, "They replied")
			failed++ unless same("en", "\{g, select, female\{She\} male\{He\} other\{They\}\} replied", {"g": ""}, "They replied")
			failed++ unless same("en", "\{g, select, other\{only\}\}", {"g": "x"}, "only")
			failed++ unless same("en", "\{g, select, a\{A\} a\{second\} other\{o\}\}", {"g": "a"}, "A")
			failed++ unless same("en", "\{g, select, female\{\{n, plural, one\{her # cat\} other\{her # cats\}\}\} other\{\{n, plural, one\{their # cat\} other\{their # cats\}\}\}\}", {"g": "female", "n": 1}, "her 1 cat")
			failed++ unless same("en", "\{g, select, female\{\{n, plural, one\{her # cat\} other\{her # cats\}\}\} other\{\{n, plural, one\{their # cat\} other\{their # cats\}\}\}\}", {"g": "female", "n": 3}, "her 3 cats")
			failed++ unless same("en", "\{g, select, female\{\{n, plural, one\{her # cat\} other\{her # cats\}\}\} other\{\{n, plural, one\{their # cat\} other\{their # cats\}\}\}\}", {"g": "x", "n": 1}, "their 1 cat")
			failed++ unless same("en", "\{g, select, female\{\{n, plural, one\{her # cat\} other\{her # cats\}\}\} other\{\{n, plural, one\{their # cat\} other\{their # cats\}\}\}\}", {"g": "x", "n": 1500}, "their 1,500 cats")
