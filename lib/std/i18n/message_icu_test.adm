			failed++ unless same("pt-BR", "\{x, number, @@@\}", {"x": 1234.5678}, " 1230")
			failed++ unless same("pt-BR", "\{x, number, @@@\}", {"x": -0.256}, "- 0,256")
			failed++ unless same("pt-BR", "\{x, number, @@@\}", {"x": 0}, " 0,00")
			failed++ unless same("pt-BR", "\{x, number, @@@\}", {"x": 1234567}, " 1230000")
			failed++ unless same("pt-BR", "\{x, number, @@@\}", {"x": 2.5}, " 2,50")
			failed++ unless same("pt-BR", "\{x, number, @@@\}", {"x": 1.005}, " 1,00")
