			failed++ unless same("en", "\{x, spellout\} | \{x, ordinal\}", {"x": 21}, "twenty-one | 21st")
			failed++ unless same("en", "\{x, spellout\} | \{x, ordinal\}", {"x": 123}, "one hundred twenty-three | 123rd")
			failed++ unless same("en", "\{x, spellout\} | \{x, ordinal\}", {"x": -7}, "minus seven | \u22127th")
			failed++ unless same("en", "\{x, spellout\} | \{x, ordinal\}", {"x": 1000000}, "one million | 1,000,000th")
			failed++ unless same("en", "\{x, spellout\} | \{x, ordinal\}", {"x": 1.5}, "one point five | 2st")
			failed++ unless same("de", "\{x, spellout\} | \{x, ordinal\}", {"x": 0}, "null | 0.")
			failed++ unless same("de", "\{x, spellout\} | \{x, ordinal\}", {"x": 1}, "eins | 1.")
			failed++ unless same("de", "\{x, spellout\} | \{x, ordinal\}", {"x": 21}, "ein­und­zwanzig | 21.")
			failed++ unless same("de", "\{x, spellout\} | \{x, ordinal\}", {"x": 123}, "ein­hundert­drei­und­zwanzig | 123.")
			failed++ unless same("de", "\{x, spellout\} | \{x, ordinal\}", {"x": -7}, "minus sieben | \u22127.")
			failed++ unless same("de", "\{x, spellout\} | \{x, ordinal\}", {"x": 1000000}, "eine Million | 1.000.000.")
			failed++ unless same("de", "\{x, spellout\} | \{x, ordinal\}", {"x": 1.5}, "eins Komma fünf | 2.")
			assert failed == 0
		}

		@test()
		def formatsAsIcu45() {
			let failed = 0
			failed++ unless same("fr", "\{x, spellout\} | \{x, ordinal\}", {"x": 0}, "zéro | 0e")
			failed++ unless same("fr", "\{x, spellout\} | \{x, ordinal\}", {"x": 1}, "un | 1er")
			failed++ unless same("fr", "\{x, spellout\} | \{x, ordinal\}", {"x": 21}, "vingt-et-un | 21e")
			failed++ unless same("fr", "\{x, spellout\} | \{x, ordinal\}", {"x": 123}, "cent vingt-trois | 123e")
			failed++ unless same("fr", "\{x, spellout\} | \{x, ordinal\}", {"x": -7}, "moins sept | \u22127e")
			failed++ unless same("fr", "\{x, spellout\} | \{x, ordinal\}", {"x": 1000000}, "un million | 1\u202f000\u202f000e")
			failed++ unless same("fr", "\{x, spellout\} | \{x, ordinal\}", {"x": 1.5}, "un virgule cinq | 2er")
			failed++ unless same("es", "\{x, spellout\} | \{x, ordinal\}", {"x": 0}, "cero | 0.º")
			failed++ unless same("es", "\{x, spellout\} | \{x, ordinal\}", {"x": 1}, "uno | 1.º")
			failed++ unless same("es", "\{x, spellout\} | \{x, ordinal\}", {"x": 21}, "veintiuno | 21.º")
			failed++ unless same("es", "\{x, spellout\} | \{x, ordinal\}", {"x": 123}, "ciento veintitrés | 123.º")
			failed++ unless same("es", "\{x, spellout\} | \{x, ordinal\}", {"x": -7}, "menos siete | \u22127.º")
			failed++ unless same("es", "\{x, spellout\} | \{x, ordinal\}", {"x": 1000000}, "un millón | 1.000.000.º")
			failed++ unless same("es", "\{x, spellout\} | \{x, ordinal\}", {"x": 1.5}, "uno coma cinco | 2.º")
			failed++ unless same("ru", "\{x, spellout\} | \{x, ordinal\}", {"x": 0}, "ноль | 0")
			failed++ unless same("ru", "\{x, spellout\} | \{x, ordinal\}", {"x": 1}, "один | 1")
			failed++ unless same("ru", "\{x, spellout\} | \{x, ordinal\}", {"x": 21}, "двадцать один | 21")
			failed++ unless same("ru", "\{x, spellout\} | \{x, ordinal\}", {"x": 123}, "сто двадцать три | 123")
			failed++ unless same("ru", "\{x, spellout\} | \{x, ordinal\}", {"x": -7}, "минус семь | \u22127")
			failed++ unless same("ru", "\{x, spellout\} | \{x, ordinal\}", {"x": 1000000}, "один миллион | 1\u00a0000\u00a0000")
			failed++ unless same("ru", "\{x, spellout\} | \{x, ordinal\}", {"x": 1.5}, "одна целая пять десятых | 2")
			failed++ unless same("en", "\{x, spellout,%spellout-ordinal\} \{x, spellout,%spellout-numbering-year\} \{x, ordinal,%digits-ordinal\}", {"x": 1999}, "one thousand nine hundred ninety-ninth nineteen ninety-nine 1,999th")
			failed++ unless same("fr", "\{x, spellout,%spellout-cardinal-feminine\} \{x, spellout,%spellout-ordinal-feminine\}", {"x": 1}, "une première")
			failed++ unless same("en", "\{x, duration\} | \{x, duration,%with-words\} | \{x, duration,%in-numerals\}", {"x": 0}, "0 sec. | 0 seconds | 0 sec.")
			failed++ unless same("en", "\{x, duration\} | \{x, duration,%with-words\} | \{x, duration,%in-numerals\}", {"x": 1}, "1 sec. | 1 second | 1 sec.")
			failed++ unless same("en", "\{x, duration\} | \{x, duration,%with-words\} | \{x, duration,%in-numerals\}", {"x": 59}, "59 sec. | 59 seconds | 59 sec.")
			failed++ unless same("en", "\{x, duration\} | \{x, duration,%with-words\} | \{x, duration,%in-numerals\}", {"x": 60}, "1:00 | 1 minute | 1:00")
			failed++ unless same("en", "\{x, duration\} | \{x, duration,%with-words\} | \{x, duration,%in-numerals\}", {"x": 61}, "1:01 | 1 minute, 1 second | 1:01")
			failed++ unless same("en", "\{x, duration\} | \{x, duration,%with-words\} | \{x, duration,%in-numerals\}", {"x": 3599}, "59:59 | 59 minutes, 59 seconds | 59:59")
			failed++ unless same("en", "\{x, duration\} | \{x, duration,%with-words\} | \{x, duration,%in-numerals\}", {"x": 3600}, "1:00:00 | 1 hour | 1:00:00")
			failed++ unless same("en", "\{x, duration\} | \{x, duration,%with-words\} | \{x, duration,%in-numerals\}", {"x": 3661}, "1:01:01 | 1 hour, 1 minute, 1 second | 1:01:01")
			failed++ unless same("en", "\{x, duration\} | \{x, duration,%with-words\} | \{x, duration,%in-numerals\}", {"x": 86400}, "24:00:00 | 24 hours | 24:00:00")
			failed++ unless same("en", "\{x, duration\} | \{x, duration,%with-words\} | \{x, duration,%in-numerals\}", {"x": 100000}, "27:46:40 | 27 hours, 46 minutes, 40 seconds | 27:46:40")
			failed++ unless same("de", "\{x, duration\}", {"x": 3661}, "3.661")
			failed++ unless same("en", "\{0x\}", {"n": 1, "x": new DateTime(2026, 1, 1, 0, 0, 0)}, "\{0x\}")
			failed++ unless same("en", "\{n, plural, other \{a\}\}", {"n": 1, "x": new DateTime(2026, 1, 1, 0, 0, 0)}, "a")
			failed++ unless same("en", "\{n,plural,other\{a\}\}", {"n": 1, "x": new DateTime(2026, 1, 1, 0, 0, 0)}, "a")
			failed++ unless same("en", "\{n, PLURAL, other\{a\}\}", {"n": 1, "x": new DateTime(2026, 1, 1, 0, 0, 0)}, "a")
			failed++ unless same("en", "\{n, Number\}", {"n": 1, "x": new DateTime(2026, 1, 1, 0, 0, 0)}, "1")
			failed++ unless same("en", "\{n , plural , offset: 1 other\{a\}\}", {"n": 1, "x": new DateTime(2026, 1, 1, 0, 0, 0)}, "a")
			assert failed == 0
		}

		@test()
		def refusesWhatIcuRefuses() {
			let en = new Locale("en")
			let accepted = string[]
			for let pattern in ["\{", "\{x", "\{x,", "\{x, number", "\{x, number, #.##", "\{n, plural, one\{x\}\}", "\{n, plural\}", "\{n, plural, \}", "\{n, select\}", "\{n, select, a\{b\}\}", "\{n, foo\}", "\{n, plural, other\{a\} offset:1\}", "\{n, plural, offset:1\}", "\{n, plural, =x\{a\} other\{b\}\}", "\{n, plural, one other\{b\}\}", "\{n, plural, other\{b\}", "\{n, plural, other\{\{b\}\}", "\{a b\}", "\{01\}", "\{-1\}", "\{\}", "\{ \}", "\{n, choice, \}", "\{n, choice, a#b\}", "\{n, choice, 1\}", "\{n, choice, 1#a|\}", "\{n, selectordinal, one\{a\}\}", "\{n,\}", "\{n, 1\}", "\{n, number, ::bogus-token\}", "\{n, number, ::currency/EURO\}", "\{x, date, 'unclosed\}", "\{n, plural, one\{'\}' other\{a\}\}",] {
				let failed = false
				parseMessage(pattern, en) onerror (err error) {
					failed = true
					recover new Message("", en)
				}
				accepted.push(pattern) unless failed
			}
			println("accepted: " + accepted.join(" | ")) when accepted.len() > 0
			assert accepted.len() == 0
		}
	}
}
