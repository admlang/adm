			failed++ unless same("pt-BR", "\{x, number, #.##%\}", {"x": -0.256}, "- 25,6%")
			failed++ unless same("pt-BR", "\{x, number, #.##%\}", {"x": 0}, " 0%")
			failed++ unless same("pt-BR", "\{x, number, #.##%\}", {"x": 1234567}, " 123456700%")
			failed++ unless same("pt-BR", "\{x, number, #.##%\}", {"x": 2.5}, " 250%")
			failed++ unless same("pt-BR", "\{x, number, #.##%\}", {"x": 1.005}, " 100,5%")
			failed++ unless same("pt-BR", "\{x, number, #.##%\}", {"x": 0.5}, " 50%")
			failed++ unless same("pt-BR", "\{x, number, #.##%\}", {"x": 12345}, " 1234500%")
			failed++ unless same("en", "\{x, number, #,##0.00 ¤\}", {"x": 1234.5678}, " 1,234.57 ¤")
			failed++ unless same("en", "\{x, number, #,##0.00 ¤\}", {"x": -0.256}, "- 0.26 ¤")
			failed++ unless same("en", "\{x, number, #,##0.00 ¤\}", {"x": 0}, " 0.00 ¤")
			failed++ unless same("en", "\{x, number, #,##0.00 ¤\}", {"x": 1234567}, " 1,234,567.00 ¤")
			failed++ unless same("en", "\{x, number, #,##0.00 ¤\}", {"x": 2.5}, " 2.50 ¤")
			failed++ unless same("en", "\{x, number, #,##0.00 ¤\}", {"x": 1.005}, " 1.00 ¤")
			failed++ unless same("en", "\{x, number, #,##0.00 ¤\}", {"x": 0.5}, " 0.50 ¤")
			failed++ unless same("en", "\{x, number, #,##0.00 ¤\}", {"x": 12345}, " 12,345.00 ¤")
			failed++ unless same("de", "\{x, number, #,##0.00 ¤\}", {"x": 1234.5678}, " 1.234,57 XXX")
			failed++ unless same("de", "\{x, number, #,##0.00 ¤\}", {"x": -0.256}, "- 0,26 XXX")
			failed++ unless same("de", "\{x, number, #,##0.00 ¤\}", {"x": 0}, " 0,00 XXX")
			failed++ unless same("de", "\{x, number, #,##0.00 ¤\}", {"x": 1234567}, " 1.234.567,00 XXX")
			failed++ unless same("de", "\{x, number, #,##0.00 ¤\}", {"x": 2.5}, " 2,50 XXX")
			failed++ unless same("de", "\{x, number, #,##0.00 ¤\}", {"x": 1.005}, " 1,00 XXX")
			failed++ unless same("de", "\{x, number, #,##0.00 ¤\}", {"x": 0.5}, " 0,50 XXX")
			failed++ unless same("de", "\{x, number, #,##0.00 ¤\}", {"x": 12345}, " 12.345,00 XXX")
			failed++ unless same("pt-BR", "\{x, number, #,##0.00 ¤\}", {"x": 1234.5678}, " 1.234,57 R$")
			failed++ unless same("pt-BR", "\{x, number, #,##0.00 ¤\}", {"x": -0.256}, "- 0,26 R$")
			assert failed == 0
		}

		@test()
		def formatsAsIcu12() {
			let failed = 0
			failed++ unless same("pt-BR", "\{x, number, #,##0.00 ¤\}", {"x": 0}, " 0,00 R$")
			failed++ unless same("pt-BR", "\{x, number, #,##0.00 ¤\}", {"x": 1234567}, " 1.234.567,00 R$")
			failed++ unless same("pt-BR", "\{x, number, #,##0.00 ¤\}", {"x": 2.5}, " 2,50 R$")
			failed++ unless same("pt-BR", "\{x, number, #,##0.00 ¤\}", {"x": 1.005}, " 1,00 R$")
			failed++ unless same("pt-BR", "\{x, number, #,##0.00 ¤\}", {"x": 0.5}, " 0,50 R$")
			failed++ unless same("pt-BR", "\{x, number, #,##0.00 ¤\}", {"x": 12345}, " 12.345,00 R$")
			failed++ unless same("en", "\{x, number, ¤#,##0.00;(¤#,##0.00)\}", {"x": 1234.5678}, " ¤1,234.57")
			failed++ unless same("en", "\{x, number, ¤#,##0.00;(¤#,##0.00)\}", {"x": -0.256}, "(¤0.26)")
			failed++ unless same("en", "\{x, number, ¤#,##0.00;(¤#,##0.00)\}", {"x": 0}, " ¤0.00")
			failed++ unless same("en", "\{x, number, ¤#,##0.00;(¤#,##0.00)\}", {"x": 1234567}, " ¤1,234,567.00")
			failed++ unless same("en", "\{x, number, ¤#,##0.00;(¤#,##0.00)\}", {"x": 2.5}, " ¤2.50")
			failed++ unless same("en", "\{x, number, ¤#,##0.00;(¤#,##0.00)\}", {"x": 1.005}, " ¤1.00")
			failed++ unless same("en", "\{x, number, ¤#,##0.00;(¤#,##0.00)\}", {"x": 0.5}, " ¤0.50")
			failed++ unless same("en", "\{x, number, ¤#,##0.00;(¤#,##0.00)\}", {"x": 12345}, " ¤12,345.00")
			failed++ unless same("de", "\{x, number, ¤#,##0.00;(¤#,##0.00)\}", {"x": 1234.5678}, " XXX\u00a01.234,57")
			failed++ unless same("de", "\{x, number, ¤#,##0.00;(¤#,##0.00)\}", {"x": -0.256}, "(XXX\u00a00,26)")
			failed++ unless same("de", "\{x, number, ¤#,##0.00;(¤#,##0.00)\}", {"x": 0}, " XXX\u00a00,00")
			failed++ unless same("de", "\{x, number, ¤#,##0.00;(¤#,##0.00)\}", {"x": 1234567}, " XXX\u00a01.234.567,00")
			failed++ unless same("de", "\{x, number, ¤#,##0.00;(¤#,##0.00)\}", {"x": 2.5}, " XXX\u00a02,50")
			failed++ unless same("de", "\{x, number, ¤#,##0.00;(¤#,##0.00)\}", {"x": 1.005}, " XXX\u00a01,00")
			failed++ unless same("de", "\{x, number, ¤#,##0.00;(¤#,##0.00)\}", {"x": 0.5}, " XXX\u00a00,50")
			failed++ unless same("de", "\{x, number, ¤#,##0.00;(¤#,##0.00)\}", {"x": 12345}, " XXX\u00a012.345,00")
			failed++ unless same("pt-BR", "\{x, number, ¤#,##0.00;(¤#,##0.00)\}", {"x": 1234.5678}, " R$1.234,57")
			failed++ unless same("pt-BR", "\{x, number, ¤#,##0.00;(¤#,##0.00)\}", {"x": -0.256}, "(R$0,26)")
			failed++ unless same("pt-BR", "\{x, number, ¤#,##0.00;(¤#,##0.00)\}", {"x": 0}, " R$0,00")
			failed++ unless same("pt-BR", "\{x, number, ¤#,##0.00;(¤#,##0.00)\}", {"x": 1234567}, " R$1.234.567,00")
			failed++ unless same("pt-BR", "\{x, number, ¤#,##0.00;(¤#,##0.00)\}", {"x": 2.5}, " R$2,50")
			failed++ unless same("pt-BR", "\{x, number, ¤#,##0.00;(¤#,##0.00)\}", {"x": 1.005}, " R$1,00")
			failed++ unless same("pt-BR", "\{x, number, ¤#,##0.00;(¤#,##0.00)\}", {"x": 0.5}, " R$0,50")
			failed++ unless same("pt-BR", "\{x, number, ¤#,##0.00;(¤#,##0.00)\}", {"x": 12345}, " R$12.345,00")
			failed++ unless same("en", "\{x, number, '#'#\}", {"x": 1234.5678}, " #1235")
			failed++ unless same("en", "\{x, number, '#'#\}", {"x": -0.256}, "- #0")
			failed++ unless same("en", "\{x, number, '#'#\}", {"x": 0}, " #0")
			failed++ unless same("en", "\{x, number, '#'#\}", {"x": 1234567}, " #1234567")
			failed++ unless same("en", "\{x, number, '#'#\}", {"x": 2.5}, " #2")
			failed++ unless same("en", "\{x, number, '#'#\}", {"x": 1.005}, " #1")
			failed++ unless same("en", "\{x, number, '#'#\}", {"x": 0.5}, " #0")
			failed++ unless same("en", "\{x, number, '#'#\}", {"x": 12345}, " #12345")
			failed++ unless same("de", "\{x, number, '#'#\}", {"x": 1234.5678}, " #1235")
			failed++ unless same("de", "\{x, number, '#'#\}", {"x": -0.256}, "- #0")
			assert failed == 0
		}

