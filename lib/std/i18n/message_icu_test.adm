		@test()
		def formatsAsIcu40() {
			let failed = 0
			failed++ unless same("ja", "\{x, number, currency\} \{x, number, ::compact-short\}", {"x": 12345678}, "XXX\u00a012,345,678.00 1235万")
			failed++ unless same("en", "\{x, date\}", {"x": new DateTime(2026, 10, 12, 14, 5, 9)}, "Oct 12, 2026")
			failed++ unless same("en", "\{x, date, short\}", {"x": new DateTime(2026, 10, 12, 14, 5, 9)}, "10/12/26")
			failed++ unless same("en", "\{x, date, medium\}", {"x": new DateTime(2026, 10, 12, 14, 5, 9)}, "Oct 12, 2026")
			failed++ unless same("en", "\{x, date, long\}", {"x": new DateTime(2026, 10, 12, 14, 5, 9)}, "October 12, 2026")
			failed++ unless same("en", "\{x, date, full\}", {"x": new DateTime(2026, 10, 12, 14, 5, 9)}, "Monday, October 12, 2026")
			failed++ unless same("en", "\{x, date,  long \}", {"x": new DateTime(2026, 10, 12, 14, 5, 9)}, "October 12, 2026")
			failed++ unless same("en", "\{x, date, yyyy-MM-dd\}", {"x": new DateTime(2026, 10, 12, 14, 5, 9)}, " 2026-10-12")
			failed++ unless same("en", "\{x, date, EEEE, d MMMM y\}", {"x": new DateTime(2026, 10, 12, 14, 5, 9)}, " Monday, 12 October 2026")
			failed++ unless same("en", "\{x, date, d MMM yy 'at' HH:mm\}", {"x": new DateTime(2026, 10, 12, 14, 5, 9)}, " 12 Oct 26 at 14:05")
			failed++ unless same("en", "\{x, date, ::yMMMd\}", {"x": new DateTime(2026, 10, 12, 14, 5, 9)}, "Oct 12, 2026")
			failed++ unless same("en", "\{x, date, ::yMMMMEEEEd\}", {"x": new DateTime(2026, 10, 12, 14, 5, 9)}, "Monday, October 12, 2026")
			failed++ unless same("en", "\{x, date, ::MMMd\}", {"x": new DateTime(2026, 10, 12, 14, 5, 9)}, "Oct 12")
			failed++ unless same("en", "\{x, date, ::yM\}", {"x": new DateTime(2026, 10, 12, 14, 5, 9)}, "10/2026")
			failed++ unless same("en", "\{x, date, :: yMd\}", {"x": new DateTime(2026, 10, 12, 14, 5, 9)}, "10/12/2026")
			failed++ unless same("en", "\{x, time\}", {"x": new DateTime(2026, 10, 12, 14, 5, 9)}, "2:05:09\u202fPM")
			failed++ unless same("en", "\{x, time, short\}", {"x": new DateTime(2026, 10, 12, 14, 5, 9)}, "2:05\u202fPM")
			failed++ unless same("en", "\{x, time, medium\}", {"x": new DateTime(2026, 10, 12, 14, 5, 9)}, "2:05:09\u202fPM")
			failed++ unless same("en", "\{x, time, HH:mm:ss\}", {"x": new DateTime(2026, 10, 12, 14, 5, 9)}, " 14:05:09")
			failed++ unless same("en", "\{x, time, h:mm a\}", {"x": new DateTime(2026, 10, 12, 14, 5, 9)}, " 2:05 PM")
			failed++ unless same("en", "\{x, time, ::Hm\}", {"x": new DateTime(2026, 10, 12, 14, 5, 9)}, "14:05")
			failed++ unless same("en", "\{x, time, ::jm\}", {"x": new DateTime(2026, 10, 12, 14, 5, 9)}, "2:05\u202fPM")
			failed++ unless same("en", "\{x, time, ::hms\}", {"x": new DateTime(2026, 10, 12, 14, 5, 9)}, "2:05:09\u202fPM")
			failed++ unless same("en", "\{x, time, ::Hms\}", {"x": new DateTime(2026, 10, 12, 14, 5, 9)}, "14:05:09")
			failed++ unless same("en-GB", "\{x, date\}", {"x": new DateTime(2026, 10, 12, 14, 5, 9)}, "12 Oct 2026")
			failed++ unless same("en-GB", "\{x, date, short\}", {"x": new DateTime(2026, 10, 12, 14, 5, 9)}, "12/10/2026")
			failed++ unless same("en-GB", "\{x, date, medium\}", {"x": new DateTime(2026, 10, 12, 14, 5, 9)}, "12 Oct 2026")
			failed++ unless same("en-GB", "\{x, date, long\}", {"x": new DateTime(2026, 10, 12, 14, 5, 9)}, "12 October 2026")
			failed++ unless same("en-GB", "\{x, date, full\}", {"x": new DateTime(2026, 10, 12, 14, 5, 9)}, "Monday, 12 October 2026")
			failed++ unless same("en-GB", "\{x, date,  long \}", {"x": new DateTime(2026, 10, 12, 14, 5, 9)}, "12 October 2026")
			failed++ unless same("en-GB", "\{x, date, yyyy-MM-dd\}", {"x": new DateTime(2026, 10, 12, 14, 5, 9)}, " 2026-10-12")
			failed++ unless same("en-GB", "\{x, date, EEEE, d MMMM y\}", {"x": new DateTime(2026, 10, 12, 14, 5, 9)}, " Monday, 12 October 2026")
