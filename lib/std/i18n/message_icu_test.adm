			failed++ unless same("en", "\{n, choice, 0#no files|1#one file|1<\{n\} files\}", {"n": 1}, "one file")
			failed++ unless same("en", "\{n, choice, 0#no files|1#one file|1<\{n\} files\}", {"n": 2}, "2 files")
			failed++ unless same("en", "\{n, choice, 0#no files|1#one file|1<\{n\} files\}", {"n": 1000}, "1,000 files")
			failed++ unless same("en", "\{n, choice, 0#no files|1#one file|1<\{n\} files\}", {"n": 0.5}, "no files")
			failed++ unless same("en", "\{n, choice, 0#no files|1#one file|1<\{n\} files\}", {"n": 1.5}, "1.5 files")
			failed++ unless same("en", "\{n, choice, 0#a|5≤b|10<c\}", {"n": 5}, "b")
			failed++ unless same("en", "\{n, choice, 0#a|5≤b|10<c\}", {"n": 10}, "b")
			assert failed == 0
		}

		@test()
		def formatsAsIcu4() {
			let failed = 0
			failed++ unless same("en", "\{n, choice, 0#a|5≤b|10<c\}", {"n": 11}, "c")
			failed++ unless same("en", "\{n, choice, -∞#neg|0#zero or more|∞#never\}", {"n": -5}, "neg")
			failed++ unless same("en", "\{n, choice, -∞#neg|0#zero or more\}", {"n": 7}, "zero or more")
			failed++ unless same("en", "\{n, choice, 0#a'|'b|1#c\}", {"n": 0}, "a|b")
			failed++ unless same("en", "\{n, choice, 0#\{n, plural, one\{x\} other\{y\}\}|2#z\}", {"n": 1}, "x")
			failed++ unless same("en", "It's \{x\}", {"x": "X"}, "It's X")
			failed++ unless same("en", "It''s \{x\}", {"x": "X"}, "It's X")
			failed++ unless same("en", "'\{x\}' is \{x\}", {"x": "X"}, "\{x\} is X")
			failed++ unless same("en", "'\{'x'\}' is \{x\}", {"x": "X"}, "\{x\} is X")
			failed++ unless same("en", "a '' b", {"x": "X"}, "a ' b")
			failed++ unless same("en", "'\{x\} to the end", {"x": "X"}, "\{x\} to the end")
			failed++ unless same("en", "x '\{''\}' y", {"x": "X"}, "x \{'\} y")
			failed++ unless same("en", "don't '\{quote\}' ''\{x\}''", {"x": "X"}, "don't \{quote\} 'X'")
			failed++ unless same("en", "'' '", {"x": "X"}, "' '")
			failed++ unless same("en", "''''", {"x": "X"}, "''")
			failed++ unless same("en", "'#' # \{x\}", {"x": "X"}, "'#' # X")
			failed++ unless same("en", "\{x\} '\}' '\{' ", {"x": "X"}, "X \} \{ ")
			failed++ unless same("en", "a'b'c", {"x": "X"}, "a'b'c")
			failed++ unless same("en", "'\{x\}''\{x\}'", {"x": "X"}, "\{x\}'\{x\}")
			failed++ unless same("en", "\{0\} and \{1\} and \{0\}", {"0": "a", "1": 7}, "a and 7 and a")
			failed++ unless same("en", "\{ x \} \{x \}\{ x\}", {"x": "v"}, "v vv")
			failed++ unless same("en", "\{x\} \{y\}", {"x": "v"}, "v \{y\}")
			failed++ unless same("en", "\{x, number\} \{x, plural, other\{o\}\} \{x, select, other\{o\}\} \{x, date\}", {}, "\{x\} \{x\} \{x\} \{x\}")
			failed++ unless same("en", "\}", {"x": "v"}, "\}")
			failed++ unless same("en", "a \} b \{x\}", {"x": "v"}, "a \} b v")
			failed++ unless same("en", "\{x_y\} \{é\}", {"x_y": "1", "é": "2"}, "1 2")
			failed++ unless same("en", "\{x\} | \{y\} | \{z\}", {"x": 1234567, "y": 1234.5678, "z": -0.5}, "1,234,567 | 1,234.568 | -0.5")
			failed++ unless same("de", "\{x\} | \{y\} | \{z\}", {"x": 1234567, "y": 1234.5678, "z": -0.5}, "1.234.567 | 1.234,568 | -0,5")
			failed++ unless same("fr", "\{x\} | \{y\} | \{z\}", {"x": 1234567, "y": 1234.5678, "z": -0.5}, "1\u202f234\u202f567 | 1\u202f234,568 | -0,5")
			failed++ unless same("ro", "\{x\} | \{y\} | \{z\}", {"x": 1234567, "y": 1234.5678, "z": -0.5}, "1.234.567 | 1.234,568 | -0,5")
			failed++ unless same("en-IN", "\{x\} | \{y\} | \{z\}", {"x": 1234567, "y": 1234.5678, "z": -0.5}, "12,34,567 | 1,234.568 | -0.5")
			failed++ unless same("en-US", "\{x\} | \{y\} | \{z\}", {"x": 1234567, "y": 1234.5678, "z": -0.5}, "1,234,567 | 1,234.568 | -0.5")
			failed++ unless same("ar-EG", "\{x\} | \{y\} | \{z\}", {"x": 1234567, "y": 1234.5678, "z": -0.5}, "١٬٢٣٤٬٥٦٧ | ١٬٢٣٤٫٥٦٨ | \u061c-٠٫٥")
			failed++ unless same("hi", "\{x\} | \{y\} | \{z\}", {"x": 1234567, "y": 1234.5678, "z": -0.5}, "12,34,567 | 1,234.568 | -0.5")
			failed++ unless same("es", "\{x\} | \{y\} | \{z\}", {"x": 1234567, "y": 1234.5678, "z": -0.5}, "1.234.567 | 1.234,568 | -0,5")
			failed++ unless same("en", "\{x\}", {"x": new DateTime(2026, 10, 12, 14, 5, 9)}, "10/12/26, 2:05\u202fPM")
			failed++ unless same("de", "\{x\}", {"x": new DateTime(2026, 10, 12, 14, 5, 9)}, "12.10.26, 14:05")
			failed++ unless same("ro", "\{x\}", {"x": new DateTime(2026, 10, 12, 14, 5, 9)}, "12.10.2026, 14:05")
			failed++ unless same("en", "\{x, number\}", {"x": 1234.5678}, "1,234.568")
			failed++ unless same("en", "\{x, number\}", {"x": -0.256}, "-0.256")
			assert failed == 0
		}

