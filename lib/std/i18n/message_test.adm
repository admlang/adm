partial module std.i18n {
	use (
		std.math::(Decimal, parseDecimal)
		std.testing
		std.time::(Date, DateTime, TimeOfDay)
	)

	check "Message" {
		enum Pet {
			Cat
			Dog
		}

		def en() Locale {
			return new Locale("en")
		}

		@test()
		def languagePicksTheFormAndRegionWritesTheNumber() {
			let m = new Message("\{n, plural, one\{# fișier\} few\{# fișiere\} other\{# de fișiere\}\}", new Locale("ro"))
			assert m.format({"n": 1234}) == "1.234 de fișiere"
			assert m.format({"n": 1234}, new Locale("en-US")) == "1,234 de fișiere"
			assert m.format({"n": 1234}, new Locale("de-CH")) == "1'234 de fișiere"
			// English text with Romanian formats: the English forms, Romanian digits grouping.
			let files = new Message("\{n, plural, one\{# file\} other\{# files\}\} at \{price, number, ::currency/EUR\}", en())
			assert files.format({"n": 1, "price": 1234.5}, new Locale("ro-RO")) == "1 file at 1.234,50\u00a0EUR"
			assert files.format({"n": 2500, "price": 0.5}, new Locale("ro-RO")) == "2.500 files at 0,50\u00a0EUR"
		}

		@test()
		def numbersOfEveryType() {
			let m = new Message("\{x, number\}", en())
			assert m.format({"x": 1234}) == "1,234"
			assert m.format({"x": int32(-1234)}) == "-1,234"
			assert m.format({"x": uint8(200)}) == "200"
			assert m.format({"x": uint64(18446744073709551615)}) == "18,446,744,073,709,551,615"
			assert m.format({"x": float32(0.5)}) == "0.5"
			assert m.format({"x": 1234.5}) == "1,234.5"
			assert m.format({"x": bigint(1) << 70}) == "1,180,591,620,717,411,303,424"
			let exact = parseDecimal("1234.50") onerror recover new Decimal()
			assert m.format({"x": exact}) == "1,234.5"
			assert m.format({"x": "1234.5"}) == "1,234.5"
			assert m.format({"x": "many"}) == "many"
			let zero = 0.0
			assert m.format({"x": 1.0 / zero}) == "∞"
			assert m.format({"x": zero / zero}) == "NaN"
		}

		@test()
		def plainDatesAndTimes() {
			let day = new Date(2026, 10, 12)
			let clock = new TimeOfDay(14, 5, 9)
			assert new Message("\{d, date, long\}", en()).format({"d": day}) == "October 12, 2026"
			assert new Message("\{d, date, ::yMMMd\}", new Locale("de")).format({"d": day}) == "12. Okt. 2026"
			assert new Message("\{t, time, short\}", en()).format({"t": clock}) == "2:05\u202fPM"
			assert new Message("\{t, time,HH:mm\}", en()).format({"t": clock}) == "14:05"
			assert new Message("\{d\} | \{t\}", en()).format({"d": day, "t": clock}) == "10/12/26 | 2:05\u202fPM"
			assert new Message("\{d, date,yyyy-MM-dd\}", en()).format({"d": new DateTime(2026, 1, 2, 3, 4, 5)}) == "2026-01-02"
			// Text where a date belongs is written as it is.
			assert new Message("\{d, date\}", en()).format({"d": "soon"}) == "soon"
		}

		@test()
		def selectByEnumAndBool() {
			let m = new Message("\{pet, select, Cat\{meow\} Dog\{woof\} other\{?\}\}", en())
			assert m.format({"pet": Pet.Dog}) == "woof"
			assert m.format({"pet": Pet.Cat}) == "meow"
			assert m.format({"pet": "Fish"}) == "?"
			let flag = new Message("\{on, select, true\{on\} false\{off\} other\{?\}\}", en())
			assert flag.format({"on": true}) == "on"
			assert flag.format({"on": false}) == "off"
			assert new Message("\{pet\}", en()).format({"pet": Pet.Dog}) == "Dog"
		}

		@test()
		def pluralOfWhatIsNotANumberIsOther() {
			let m = new Message("\{n, plural, one\{one #\} other\{other #\}\}", en())
			assert m.format({"n": "several"}) == "other several"
			assert m.format({"n": "1"}) == "one 1"
			assert m.format({}) == "\{n\}"
		}

		@test()
		def partsNameTheArguments() {
			let m = new Message("Hello \{name\}, \{n, plural, one\{# file\} other\{# files\}\}!", en())
			let parts = m.parts({"name": "Ana", "n": 3})
			assert parts.len() == 5
			assert parts[0].kind == MessagePartKind.Text && parts[0].text == "Hello "
			assert parts[1].kind == MessagePartKind.Argument && parts[1].text == "Ana" && parts[1].name == "name"
			assert parts[2].text == ", "
			assert parts[3].kind == MessagePartKind.Argument && parts[3].text == "3" && parts[3].name == "n"
			assert parts[4].kind == MessagePartKind.Text && parts[4].text == " files!"
			let joined = ""
			for let part in parts {
				joined += part.text
			}
			assert joined == m.format({"name": "Ana", "n": 3})
		}

		@test()
		def argumentsInOrderOfAppearance() {
			let m = new Message("\{b\} \{a, number\} \{n, plural, one\{\{c\}\} other\{\{a\} \{d, date\}\}\}", en())
			assert m.arguments().join(",") == "b,a,n,c,d"
			assert new Message("plain", en()).arguments().len() == 0
		}

		@test()
		def isolatesValuesThatRunTheOtherWay() {
			let hebrew = new Message("שלום \{name\}", new Locale("he"))
			assert hebrew.format({"name": "Ana"}) == "שלום \u2068Ana\u2069"
			assert hebrew.format({"name": "דנה"}) == "שלום דנה"
			assert hebrew.format({"name": 42}) == "שלום 42"
			let english = new Message("Hello \{name\}", en())
			assert english.format({"name": "דנה"}) == "Hello \u2068דנה\u2069"
			assert english.format({"name": "Ana"}) == "Hello Ana"
		}

		@test()
		def aPatternThatIsNotWellFormed() {
			// Leniently, it is literal text.
			assert new Message("\{n, plural, one\{x\}\}", en()).format({"n": 1}) == "\{n, plural, one\{x\}\}"
			let position = -1
			let code = ""
			parseMessage("Hello \{name", en()) onerror (err error) {
				if err is MessageError {
					position = err.position
					code = err.code
				}
				recover new Message("", en())
			}
			assert position == 6
			assert code == "message"
			let refused = false
			parseMessage("\{n, number, ::decimal-always\}", en()) onerror (err error) {
				refused = err.message.contains("decimal-always")
				recover new Message("", en())
			}
			assert refused
			let fine = parseMessage("\{n, number, ::compact-short\}", en()) onerror recover new Message("", en())
			assert fine.format({"n": 12345}) == "12K"
			assert fine.str() == "\{n, number, ::compact-short\}"
		}

		@test()
		def numberPatternsOnTheFormatter() {
			assert new NumberFormat(en(), NumberOptions{pattern: "#,##0.00"}).format(1234.5) == "1,234.50"
			assert new NumberFormat(new Locale("de"), NumberOptions{pattern: "#,##0.00"}).format(1234.5) == "1.234,50"
			assert new NumberFormat(en(), NumberOptions{pattern: "000"}).format(7) == "007"
			assert new NumberFormat(en(), NumberOptions{pattern: "#.##%"}).format(0.256) == "25.6%"
			assert new NumberFormat(en(), NumberOptions{pattern: "@@@"}).format(1234.5) == "1230"
			assert new NumberFormat(new Locale("en-US"), NumberOptions{pattern: "¤#,##0.00"}).format(5) == "$5.00"
			let options = NumberOptions{pattern: "0.0#"}
			assert new NumberFormat(en(), options).format(2) == "2.0"
			assert options.minimumFractionDigits == -1
		}

		@test()
		def datePatternsAndSkeletonsOnTheFormatter() {
			let day = new Date(2026, 10, 12)
			let pattern = new DateTimeFormat(en(), DateTimeOptions{pattern: "EEEE, d MMM y"})
			let written = pattern.format(day) onerror recover ""
			assert written == "Monday, 12 Oct 2026"
			let skeleton = new DateTimeFormat(new Locale("fr"), DateTimeOptions{skeleton: "yMMMMd"})
			written = skeleton.format(day) onerror recover ""
			assert written == "12 octobre 2026"
		}

		@test()
		def durationsInWordsAndNumerals() {
			assert new SpellOut(en(), "%with-words").format(3661) == "1 hour, 1 minute, 1 second"
			assert new SpellOut(en(), "%duration").format(3661) == "1:01:01"
			assert new SpellOut(en()).ruleSets().includes("%with-words")
		}
	}
}
