// gettext plural forms: the `Plural-Forms` header of a catalog
// ("nplurals=2; plural=(n != 1);"), whose C expression gives the index of
// the form a count takes.

internal partial module std.i18n.msgfmt {
	// Expr is one node of a plural expression: a number, `n`, or an operator
	// over its operands.
	struct Expr {
		// "num", "n", "?", "||", "&&", "==", "!=", "<", ">", "<=", ">=", "+",
		// "-", "*", "/", "%", "!"
		op    string
		value int
		a     ?Expr
		b     ?Expr
		c     ?Expr
	}

	// PluralExpression is a catalog's plural rule: how many forms its
	// language has and the expression that picks one.
	type PluralExpression {
		// The header's value, as written.
		source string
		// The number of forms.
		count  int
		root   Expr

		def new(source string, count int, root Expr) {
			self.source = source
			self.count = count
			self.root = root
		}

		// The index of the form the count takes: from 0 to below `count`. A
		// negative count takes the form of its absolute value.
		def index(n int) int {
			let i = evaluate(root, n < 0 ?? (-n, n))
			return 0 when i < 0 || i >= count
			return i
		}
	}

	// As gettext evaluates: integer arithmetic, a comparison is 1 or 0, and a
	// division by zero gives 0.
	def evaluate(e Expr, n int) int {
		match e.op {
			case "num":
				return e.value
			case "n":
				return n
		}
		let first = e.a
		return 0 when first is none
		let a = evaluate(first, n)
		return a == 0 ?? (1, 0) when e.op == "!"
		let second = e.b
		return 0 when second is none
		if e.op == "?" {
			let third = e.c
			return 0 when third is none
			return a != 0 ?? (evaluate(second, n), evaluate(third, n))
		}
		// The logical operators evaluate their right side only when it decides.
		return a != 0 ?? (1, evaluate(second, n) != 0 ?? (1, 0)) when e.op == "||"
		return a == 0 ?? (0, evaluate(second, n) != 0 ?? (1, 0)) when e.op == "&&"
		let b = evaluate(second, n)
		match e.op {
			case "==":
				return a == b ?? (1, 0)
			case "!=":
				return a != b ?? (1, 0)
			case "<":
				return a < b ?? (1, 0)
			case ">":
				return a > b ?? (1, 0)
			case "<=":
				return a <= b ?? (1, 0)
			case ">=":
				return a >= b ?? (1, 0)
			case "+":
				return a + b
			case "-":
				return a - b
			case "*":
				return a * b
			case "/":
				return b == 0 ?? (0, a / b)
			case "%":
				return b == 0 ?? (0, a % b)
		}
		return 0
	}

	// Reads a `Plural-Forms` value: "nplurals=3; plural=(n==1 ? 0 : n>=2 && n<=4 ? 1 : 2);".
	// Fails when `nplurals` or `plural` is missing, `nplurals` is not a
	// number from 1 up, or the expression is not well-formed.
	def parsePluralForms(header string) !PluralExpression {
		let count = -1
		let expression = ""
		for let part in header.split(";") {
			let item = part.trim()
			let equals = item.indexOf("=")
			continue when equals < 0
			let name = item[:equals].trim()
			let value = item[equals + 1:].trim()
			if name == "nplurals" {
				fail "plural forms: nplurals \"" + value + "\" is not a number" unless value != "" && value.isNumeric()
				count = value.toInt<int>()
			} else if name == "plural" {
				expression = value
			}
		}
		fail "plural forms: no nplurals" when count < 0
		fail "plural forms: nplurals must be at least 1" when count < 1
		fail "plural forms: no plural expression" when expression == ""
		let reader = new ExprReader(expression)
		let root = try reader.conditional()
		reader.skip()
		fail "plural forms: unexpected \"" + reader.rest() + "\" in the expression" when reader.at < reader.text.len()
		return new PluralExpression(header.trim(), count, root)
	}

	// ExprReader reads a C expression over `n` by precedence.
	type ExprReader {
		text string
		at   int

		def new(text string) {
			self.text = text
		}

		def skip() {
			for at < text.len() && (text[at:at + 1] := " " || "\t" || "\n" || "\r") {
				at++
			}
		}

		def rest() string {
			return text[at:]
		}

		// Takes the operator when the text continues with it.
		def take(op string) bool {
			skip()
			return false unless text[at:].startsWith(op)
			at += op.len()
			return true
		}

		// Whether the text continues with the operator, and not with a longer
		// one that starts the same way.
		def takeOnly(op string, longer string) bool {
			skip()
			return false when text[at:].startsWith(longer)
			return take(op)
		}

		def conditional() !Expr {
			let test = try or()
			return test unless take("?")
			let yes = try conditional()
			fail "plural forms: '?' without ':'" unless take(":")
			let no = try conditional()
			return Expr{op: "?", a: test, b: yes, c: no}
		}

		def or() !Expr {
			let left = try and()
			for take("||") {
				left = Expr{op: "||", a: left, b: try and()}
			}
			return left
		}

		def and() !Expr {
			let left = try equality()
			for take("&&") {
				left = Expr{op: "&&", a: left, b: try equality()}
			}
			return left
		}

		def equality() !Expr {
			let left = try relation()
			for {
				if take("==") {
					left = Expr{op: "==", a: left, b: try relation()}
				} else if take("!=") {
					left = Expr{op: "!=", a: left, b: try relation()}
				} else {
					return left
				}
			}
		}

		def relation() !Expr {
			let left = try sum()
			for {
				if take("<=") {
					left = Expr{op: "<=", a: left, b: try sum()}
				} else if take(">=") {
					left = Expr{op: ">=", a: left, b: try sum()}
				} else if take("<") {
					left = Expr{op: "<", a: left, b: try sum()}
				} else if take(">") {
					left = Expr{op: ">", a: left, b: try sum()}
				} else {
					return left
				}
			}
		}

		def sum() !Expr {
			let left = try product()
			for {
				if take("+") {
					left = Expr{op: "+", a: left, b: try product()}
				} else if take("-") {
					left = Expr{op: "-", a: left, b: try product()}
				} else {
					return left
				}
			}
		}

		def product() !Expr {
			let left = try unary()
			for {
				if take("*") {
					left = Expr{op: "*", a: left, b: try unary()}
				} else if take("/") {
					left = Expr{op: "/", a: left, b: try unary()}
				} else if take("%") {
					left = Expr{op: "%", a: left, b: try unary()}
				} else {
					return left
				}
			}
		}

		def unary() !Expr {
			return Expr{op: "!", a: try unary()} when takeOnly("!", "!=")
			if take("(") {
				let inner = try conditional()
				fail "plural forms: '(' without ')'" unless take(")")
				return inner
			}
			return Expr{op: "n"} when take("n")
			skip()
			let start = at
			for at < text.len() && text[at:at + 1].isNumeric() {
				at++
			}
			fail "plural forms: a number, n or '(' is expected at \"" + text[start:] + "\"" when at == start
			return Expr{op: "num", value: text[start:at].toInt<int>()}
		}
	}
}
