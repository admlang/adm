// ICU MessageFormat 1 patterns: the node model every message syntax compiles
// to, and the parser of the MessageFormat 1 syntax (ICU's MessagePattern, in
// its default apostrophe mode).

internal partial module std.i18n.msgfmt {
	// NodeKind is what a part of a message is.
	enum NodeKind {
		Text          // literal text
		Argument      // {name}
		Number        // {name, number, style}
		Date          // {name, date, style}
		Time          // {name, time, style}
		SpellOut      // {name, spellout, rule set}
		Ordinal       // {name, ordinal, rule set}
		Duration      // {name, duration, rule set}
		Plural        // {name, plural, offset:1 =0{...} one{...} other{...}}
		SelectOrdinal // {name, selectordinal, one{...} other{...}}
		Select        // {name, select, key{...} other{...}}
		Choice        // {name, choice, 0#...|1#...|1<...}
		Pound         // # inside a plural: the number less the offset
		Forms         // gettext plural forms: the case at the index an expression gives
	}

	// Node is one part of a message.
	struct Node {
		kind   NodeKind
		// The literal of a Text; the style of a simple format, as written.
		text   string
		// The argument: a name, or a number as text ("0").
		name   string
		// What a Plural or SelectOrdinal subtracts before choosing a keyword.
		offset float
		cases  Case[]
		// The compiled expression of Forms.
		rule   ?PluralExpression
	}

	// Case is one alternative of a Plural, SelectOrdinal, Select, Choice or
	// Forms node.
	struct Case {
		// "one", "other", a select value; "" for an exact match and a choice.
		keyword string
		// Whether a plural case matches the number itself (=0, =1).
		exact   bool
		// The number of an exact match; the limit of a choice.
		value   float
		// A choice that takes numbers above its limit only (written `<`).
		above   bool
		nodes   Node[]
	}

	// Parser reads one MessageFormat 1 pattern. `failedAt` is the character
	// the failure was found at.
	type Parser {
		chars    char[]
		at       int
		failedAt int

		def new(pattern string) {
			failedAt = -1
			for let ch in pattern {
				chars.push(ch)
			}
		}

		// Reads the whole pattern.
		// Fails with what is wrong when it is not well-formed.
		def parse() !Node[] {
			let nodes = try message(0, NodeKind.Text)
			return nodes
		}

		def wrong(why string, position int) string {
			failedAt = position
			return why
		}

		// A message: text and arguments up to the end, or up to the `}` (or
		// the `|` of a choice) that closes a nested one.
		def message(depth int, parent NodeKind) !Node[] {
			let nodes = Node[]
			let text = ""
			let start = at
			for at < chars.len() {
				let c = chars[at]
				if c == '\'' {
					at++
					if at >= chars.len() {
						text += "'"
						break
					}
					let next = chars[at]
					if next == '\'' {
						text += "'"
						at++
					} else if (next := '{' || '}') || (parent == NodeKind.Choice && next == '|') || (counts(parent) && next == '#') {
						// Quoted literal text, up to the next single apostrophe or the end.
						for at < chars.len() {
							if chars[at] == '\'' {
								at++
								break unless at < chars.len() && chars[at] == '\''
								text += "'"
								at++
								continue
							}
							text += string(chars[at])
							at++
						}
					} else {
						text += "'"
					}
					continue
				}
				if c == '#' && counts(parent) {
					nodes.push(Node{kind: NodeKind.Text, text: text}) when text != ""
					text = ""
					nodes.push(Node{kind: NodeKind.Pound})
					at++
					continue
				}
				if c == '{' {
					nodes.push(Node{kind: NodeKind.Text, text: text}) when text != ""
					text = ""
					at++
					nodes.push(try argument(depth))
					continue
				}
				if (depth > 0 && c == '}') || (parent == NodeKind.Choice && c == '|') {
					nodes.push(Node{kind: NodeKind.Text, text: text}) when text != ""
					return nodes
				}
				text += string(c)
				at++
			}
			fail wrong("unmatched '\{'", start) when depth > 0
			nodes.push(Node{kind: NodeKind.Text, text: text}) when text != ""
			return nodes
		}

		def counts(kind NodeKind) bool {
			return kind := NodeKind.Plural || NodeKind.SelectOrdinal
		}

		// An argument, from after its `{` to after its `}`.
		def argument(depth int) !Node {
			let open = at - 1
			skipSpace()
			fail wrong("unmatched '\{'", open) when at >= chars.len()
			let name = try argumentName()
			skipSpace()
			fail wrong("unmatched '\{'", open) when at >= chars.len()
			if chars[at] == '}' {
				at++
				return Node{kind: NodeKind.Argument, name: name}
			}
			fail wrong("argument \"" + name + "\" is followed by neither ',' nor '\}'", at) when chars[at] != ','
			at++
			skipSpace()
			let typeStart = at
			for at < chars.len() && asciiLetter(chars[at]) {
				at++
			}
			let kindName = slice(typeStart, at).lower()
			fail wrong("argument \"" + name + "\" has no type after ','", typeStart) when kindName == ""
			skipSpace()
			fail wrong("unmatched '\{'", open) when at >= chars.len()
			let c = chars[at]
			fail wrong("argument type \"" + kindName + "\" is followed by neither ',' nor '\}'", at) unless c := ',' || '}'
			let kind = NodeKind.Text
			match kindName {
				case "plural":
					kind = NodeKind.Plural
				case "selectordinal":
					kind = NodeKind.SelectOrdinal
				case "select":
					kind = NodeKind.Select
				case "choice":
					kind = NodeKind.Choice
				case "number":
					kind = NodeKind.Number
				case "date":
					kind = NodeKind.Date
				case "time":
					kind = NodeKind.Time
				case "spellout":
					kind = NodeKind.SpellOut
				case "ordinal":
					kind = NodeKind.Ordinal
				case "duration":
					kind = NodeKind.Duration
				default:
					fail wrong("unknown argument type \"" + kindName + "\"", typeStart)
			}
			let node = Node{kind: kind, name: name}
			if kind := NodeKind.Plural || NodeKind.SelectOrdinal || NodeKind.Select || NodeKind.Choice {
				fail wrong("\"" + kindName + "\" needs its cases after a ','", at) when c == '}'
				at++
				if kind == NodeKind.Choice {
					try choiceCases(node, depth)
				} else {
					try keywordCases(node, depth)
				}
			} else if c == ',' {
				at++
				node.text = try simpleStyle(open)
			}
			// Both leave `at` on the closing brace.
			at++
			return node
		}

		// A name, or a number without sign or leading zeros.
		def argumentName() !string {
			let start = at
			for at < chars.len() && !patternSpace(chars[at]) && !patternSyntax(chars[at]) {
				at++
			}
			let name = slice(start, at)
			fail wrong("an argument needs a name or a number", start) when name == ""
			// Digits alone are an argument number, which has no leading zero;
			// anything else is a name ("0x").
			if chars[start] == '0' && at - start > 1 {
				let digits = true
				for let i = start; i < at; i++ {
					digits = false unless digit(chars[i])
				}
				fail wrong("argument number \"" + name + "\" has a leading zero", start) when digits
			}
			return name
		}

		// The style of a simple format, as written, up to its closing brace:
		// apostrophes quote, braces nest.
		def simpleStyle(open int) !string {
			let start = at
			let nested = 0
			for at < chars.len() {
				let c = chars[at]
				if c == '\'' {
					// Quoted text runs to the next apostrophe.
					at++
					for at < chars.len() && chars[at] != '\'' {
						at++
					}
					fail wrong("quoted text in a style has no closing apostrophe", start) when at >= chars.len()
					at++
					continue
				}
				if c == '{' {
					nested++
				} else if c == '}' {
					return slice(start, at) when nested == 0
					nested--
				}
				at++
			}
			fail wrong("unmatched '\{'", open)
		}

		// The cases of a plural, selectordinal or select.
		def keywordCases(node Node, depth int) !none {
			let start = at
			let plural = node.kind != NodeKind.Select
			let hasOther = false
			let first = true
			for {
				skipSpace()
				let atEnd = at >= chars.len()
				if atEnd || chars[at] == '}' {
					fail wrong("unmatched '\{'", start) when atEnd
					fail wrong("the cases have no \"other\"", start) unless hasOther
					return none
				}
				let item = Case{}
				let selectorStart = at
				if plural && chars[at] == '=' {
					at++
					item.exact = true
					item.value = try number(false)
				} else {
					for at < chars.len() && !patternSpace(chars[at]) && !patternSyntax(chars[at]) {
						at++
					}
					let keyword = slice(selectorStart, at)
					fail wrong("a case needs a keyword before its '\{'", selectorStart) when keyword == ""
					if plural && keyword == "offset" && at < chars.len() && chars[at] == ':' {
						fail wrong("\"offset:\" must come before the cases", selectorStart) unless first
						at++
						skipSpace()
						node.offset = try number(false)
						first = false
						continue
					}
					item.keyword = keyword
					hasOther = true when keyword == "other"
				}
				skipSpace()
				fail wrong("a case has no '\{' after its keyword", selectorStart) when at >= chars.len() || chars[at] != '{'
				at++
				item.nodes = try message(depth + 1, node.kind)
				fail wrong("unmatched '\{'", selectorStart) when at >= chars.len()
				at++
				node.cases.push(item)
				first = false
			}
		}

		// The cases of a choice: `limit#message|limit<message`.
		def choiceCases(node Node, depth int) !none {
			let start = at
			skipSpace()
			fail wrong("a choice has no cases", start) when at >= chars.len() || chars[at] == '}'
			for {
				let limitStart = at
				let item = Case{}
				item.value = try number(true)
				skipSpace()
				fail wrong("a choice limit has no '#', '<' or '≤' after it", limitStart) when at >= chars.len()
				let separator = chars[at]
				fail wrong("a choice limit has no '#', '<' or '≤' after it", at) unless separator := '#' || '<' || lessOrEqual
				item.above = separator == '<'
				at++
				item.nodes = try message(depth + 1, NodeKind.Choice)
				node.cases.push(item)
				fail wrong("unmatched '\{'", start) when at >= chars.len()
				return none when chars[at] == '}'
				// A '|' : another case follows.
				at++
				skipSpace()
			}
		}

		// A number: digits with an optional sign and fraction, or an infinity.
		def number(allowInfinity bool) !float {
			let start = at
			let negative = false
			if at < chars.len() && (chars[at] := '-' || '+') {
				negative = chars[at] == '-'
				at++
			}
			if allowInfinity && at < chars.len() && chars[at] == infinitySign {
				at++
				return negative ?? (-infinity(), infinity())
			}
			let digitsStart = at
			for at < chars.len() && numeric(digitsStart) {
				at++
			}
			let text = slice(digitsStart, at)
			fail wrong("a number is expected", start) when text == "" || !digit(chars[digitsStart])
			let value = parseFloat<float>(text)
			return negative ?? (-value, value)
		}

		// Whether the character at `at` continues the number that began at `from`.
		def numeric(from int) bool {
			let c = chars[at]
			return true when digit(c) || (c := '.' || 'e' || 'E')
			return false unless c := '-' || '+'
			return at > from && (chars[at - 1] := 'e' || 'E')
		}

		def skipSpace() {
			for at < chars.len() && patternSpace(chars[at]) {
				at++
			}
		}

		def slice(from int, to int) string {
			let out = ""
			for let i = from; i < to; i++ {
				out += string(chars[i])
			}
			return out
		}
	}

	def infinity() float {
		let zero = 0.0
		return 1.0 / zero
	}

	const lessOrEqual = char(0x2264)
	const infinitySign = char(0x221E)

	def digit(ch char) bool {
		return ch >= '0' && ch <= '9'
	}

	def asciiLetter(ch char) bool {
		return ch >= 'a' && ch <= 'z' || ch >= 'A' && ch <= 'Z'
	}

	// Unicode Pattern_White_Space.
	def patternSpace(ch char) bool {
		let c = int(ch)
		return c >= 0x09 && c <= 0x0D || (c := 0x20 || 0x85 || 0x200E || 0x200F || 0x2028 || 0x2029)
	}

	// The ranges of Unicode Pattern_Syntax, as first and last code point.
	let syntaxRanges = int[0x21, 0x2F, 0x3A, 0x40, 0x5B, 0x5E, 0x60, 0x60, 0x7B, 0x7E, 0xA1, 0xA7, 0xA9, 0xA9, 0xAB, 0xAC, 0xAE, 0xAE, 0xB0, 0xB1, 0xB6, 0xB6, 0xBB, 0xBB, 0xBF, 0xBF, 0xD7, 0xD7, 0xF7, 0xF7, 0x2010, 0x2027, 0x2030, 0x203E, 0x2041, 0x2053, 0x2055, 0x205E, 0x2190, 0x245F, 0x2500, 0x2775, 0x2794, 0x2BFF, 0x2E00, 0x2E7F, 0x3001, 0x3003, 0x3008, 0x3020, 0x3030, 0x3030, 0xFD3E, 0xFD3F, 0xFE45, 0xFE46]

	// Unicode Pattern_Syntax.
	def patternSyntax(ch char) bool {
		let c = int(ch)
		for let i = 0; i < syntaxRanges.len(); i += 2 {
			return false when c < syntaxRanges[i]
			return true when c <= syntaxRanges[i + 1]
		}
		return false
	}
}
