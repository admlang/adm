partial module std.i18n {
	use (
		std.i18n.cldr::(tables)
		std.i18n.subtags
	)

	// The display name of l in locale, built as UTS #35 describes: the
	// longest language entry that covers the language with its script and
	// region ("British English"), then the rest as qualifiers
	// ("Deutsch (Schweiz)", "serbe (latin, Serbie)").
	internal def localeName(l Locale, locale Locale) string {
		let data = dataLocaleOf(locale)
		let lang = l.language.code
		let script = l.script.code
		let region = l.region.code
		let tries = string[
			subtags.join(lang, script, region),
			subtags.join(lang, script, ""),
			subtags.join(lang, "", region),
		]
		let base = ""
		for let t in tries {
			continue when t == lang
			let v = tables.value("languages", data, "localeDisplayNames/languages/" + t)
			if !(v is none) {
				base = v
				script = "" when t.contains("-" + script) && script != ""
				region = "" when region != "" && t.endsWith("-" + region)
				break
			}
		}
		base = l.language.name(locale) when base == ""
		let qualifiers = string[]
		qualifiers.push(l.script.name(locale)) when script != ""
		qualifiers.push(l.region.name(locale)) when region != ""
		for let v in l.variants {
			qualifiers.push(displayName(locale, "variants", "localeDisplayNames/variants/" + v.upper(), v))
		}
		let keys = l.keywords.keys()
		keys.sort((a, b) => a < b)
		for let k in keys {
			let v = l.keywords.get(k)
			continue when v is none
			qualifiers.push(keywordName(data, k, v))
		}
		return base when qualifiers.len() == 0
		let separator = pattern(data, "localeSeparator", "{0}, {1}")
		let joined = qualifiers[0]
		for let i in 1..qualifiers.len() {
			joined = substitute(separator, joined, qualifiers[i])
		}
		return substitute(pattern(data, "localePattern", "{0} ({1})"), base, joined)
	}

	// The name of a Unicode extension keyword with its value ("Buddhist
	// Calendar"), or "key: value" through the locale's key-type pattern.
	internal def keywordName(data string, key string, value string) string {
		let long = longKeys.hasKey(key) ?? (longKeys[key], key)
		let typed = tables.value("localeDisplayNames", data, "localeDisplayNames/types/" + long + "/" + value)
		return typed when !(typed is none)
		let keyName = tables.value("localeDisplayNames", data, "localeDisplayNames/keys/" + long)
		let k = keyName is none ?? (key, keyName)
		return substitute(pattern(data, "localeKeyTypePattern", "{0}: {1}"), k, value)
	}

	// CLDR names some keywords by their long form in localeDisplayNames.
	internal let longKeys = map<string, string>{"ca": "calendar", "co": "collation", "cu": "currency", "nu": "numbers", "tz": "timezone"}

	internal def pattern(data string, name string, fallback string) string {
		let v = tables.value("localeDisplayNames", data, "localeDisplayNames/localeDisplayPattern/" + name)
		return fallback when v is none
		return v
	}

	// Replaces {0} and {1} in a CLDR pattern.
	internal def substitute(pattern string, a string, b string) string {
		return pattern.replace("\{0\}", a).replace("\{1\}", b)
	}

	internal struct WeightedTag {
		tag string
		q   float
	}

	// Negotiate picks the available locale that best serves the requested
	// ones, in order of preference, with the CLDR language matching data:
	// "de-AT" is served by "de", "en-AU" by "en-GB" before "en-US", "sr-ME" by
	// "sr-Latn". Returns none when nothing available is close enough (another
	// language, or another script of it).
	def negotiate(requested Locale[], available Locale[]) ?Locale {
		let best = -1
		let bestDistance = 50
		let supported = subtags.Tag[]
		for let a in available {
			supported.push(subtags.maximize(tagOf(a)))
		}
		for let i in 0..requested.len() {
			let desired = subtags.maximize(tagOf(requested[i]))
			for let j in 0..supported.len() {
				// Each later preference counts as a little further away.
				let d = subtags.distance(desired, supported[j]) + i * 5
				if d < bestDistance {
					best = j
					bestDistance = d
				}
			}
		}
		return none when best < 0
		return available[best]
	}

	// Negotiate picks the available locale that best serves an HTTP
	// Accept-Language header ("de-CH, de;q=0.9, en;q=0.5").
	def negotiate(acceptLanguage string, available Locale[]) ?Locale {
		return negotiate(parseAcceptLanguage(acceptLanguage), available)
	}

	// ParseAcceptLanguage reads an HTTP Accept-Language header into locales,
	// most preferred first; "*", ill-formed tags and q=0 entries are dropped.
	def parseAcceptLanguage(header string) Locale[] {
		let ranges = WeightedTag[]
		for let item in header.split(",") {
			let fields = item.split(";")
			let tag = fields[0].trim()
			continue when tag := "" || "*"
			let q = 1.0
			for let f in fields[1:] {
				let kv = f.trim()
				q = parseFloat<float>(kv[2:]) when kv.startsWith("q=")
			}
			continue when q <= 0.0
			ranges.push(WeightedTag{tag: tag, q: q})
		}
		// Stable, so equal weights keep the header's order.
		ranges.sort((a, b) => a.q > b.q)
		let tags = string[]
		for let r in ranges {
			tags.push(r.tag)
		}
		let out = Locale[]
		for let t in tags {
			let l = parseLocale(t) onerror recover new Locale()
			out.push(l) when l.language.code != "und"
		}
		return out
	}
}
