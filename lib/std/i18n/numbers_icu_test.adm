		@test()
		def set7() {
			let options = NumberOptions{kind: NumberKind.Currency, currency: "USD", currencyDisplay: CurrencyDisplay.Name}
			let n = 0
			n += same("en-US", options, "0", "0.00 US dollars")
			n += same("en-US", options, "1", "1.00 US dollars")
			n += same("en-US", options, "-1", "-1.00 US dollars")
