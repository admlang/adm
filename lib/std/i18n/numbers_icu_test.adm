		@test()
		def set5() {
			let options = NumberOptions{kind: NumberKind.Currency, currency: "CHF"}
			let n = 0
			n += same("en-US", options, "0", "CHF 0.00")
			n += same("en-US", options, "1", "CHF 1.00")
			n += same("en-US", options, "-1", "-CHF 1.00")
			n += same("en-US", options, "1234.5", "CHF 1,234.50")
			n += same("en-US", options, "-1234.567", "-CHF 1,234.57")
			n += same("en-US", options, "1234567.891", "CHF 1,234,567.89")
			n += same("en-US", options, "0.001234", "CHF 0.00")
			n += same("en-US", options, "999999", "CHF 999,999.00")
			n += same("en-US", options, "98765432109876543210", "CHF 98,765,432,109,876,543,210.00")
			n += same("en-US", options, "0.5", "CHF 0.50")
			n += same("en-US", options, "2.5", "CHF 2.50")
			n += same("en-US", options, "1.005", "CHF 1.01")
			n += same("en-US", options, "100", "CHF 100.00")
			n += same("de-DE", options, "0", "0,00 CHF")
			n += same("de-DE", options, "1", "1,00 CHF")
			n += same("de-DE", options, "-1", "-1,00 CHF")
			n += same("de-DE", options, "1234.5", "1.234,50 CHF")
			n += same("de-DE", options, "-1234.567", "-1.234,57 CHF")
			n += same("de-DE", options, "1234567.891", "1.234.567,89 CHF")
			n += same("de-DE", options, "0.001234", "0,00 CHF")
			n += same("de-DE", options, "999999", "999.999,00 CHF")
			n += same("de-DE", options, "98765432109876543210", "98.765.432.109.876.543.210,00 CHF")
			n += same("de-DE", options, "0.5", "0,50 CHF")
			n += same("de-DE", options, "2.5", "2,50 CHF")
			n += same("de-DE", options, "1.005", "1,01 CHF")
			n += same("de-DE", options, "100", "100,00 CHF")
			n += same("de-CH", options, "0", "CHF 0.00")
			n += same("de-CH", options, "1", "CHF 1.00")
			n += same("de-CH", options, "-1", "CHF-1.00")
			n += same("de-CH", options, "1234.5", "CHF 1'234.50")
			n += same("de-CH", options, "-1234.567", "CHF-1'234.57")
			n += same("de-CH", options, "1234567.891", "CHF 1'234'567.89")
			n += same("de-CH", options, "0.001234", "CHF 0.00")
			n += same("de-CH", options, "999999", "CHF 999'999.00")
			n += same("de-CH", options, "98765432109876543210", "CHF 98'765'432'109'876'543'210.00")
			n += same("de-CH", options, "0.5", "CHF 0.50")
			n += same("de-CH", options, "2.5", "CHF 2.50")
			n += same("de-CH", options, "1.005", "CHF 1.01")
			n += same("de-CH", options, "100", "CHF 100.00")
			n += same("fr-FR", options, "0", "0,00 CHF")
			n += same("fr-FR", options, "1", "1,00 CHF")
			n += same("fr-FR", options, "-1", "-1,00 CHF")
			n += same("fr-FR", options, "1234.5", "1 234,50 CHF")
			n += same("fr-FR", options, "-1234.567", "-1 234,57 CHF")
			n += same("fr-FR", options, "1234567.891", "1 234 567,89 CHF")
			n += same("fr-FR", options, "0.001234", "0,00 CHF")
