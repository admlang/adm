// Generated by ~/.cache/adm-scratch/i18n/kit/gen_number_cases.js from ICU 78.3 (CLDR 48.0).
// Turkish runs as "tr": ICU 78.3 formats tr-TR unlike tr (accounting "-$1,00", currency names "$1,00 ABD doları") though tr_TR has no data of its own.
partial module std.i18n {
	use (
		std.testing
		std.math::(RoundingMode, parseDecimal, Decimal)
	)

	check "NumberFormat against ICU" {
		// 1 when the format differs from ICU's output, after printing both.
		def same(loc string, options NumberOptions, value string, want string) int {
			let v = parseDecimal(value) onerror recover new Decimal()
			let got = new NumberFormat(new Locale(loc), options).format(v)
			return 0 when got == want
			println(loc + " " + value + ": got [" + got + "] want [" + want + "]")
			return 1
		}

		@test()
