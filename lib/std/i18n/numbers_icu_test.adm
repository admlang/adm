		@test()
		def set19() {
			let options = NumberOptions{grouping: Grouping.Off}
			let n = 0
			n += same("en-US", options, "0", "0")
			n += same("en-US", options, "1", "1")
			n += same("en-US", options, "-1", "-1")
			n += same("en-US", options, "1234.5", "1234.5")
