		@test()
		def set16() {
			let options = NumberOptions{minimumFractionDigits: 2, maximumFractionDigits: 2}
			let n = 0
			n += same("en-US", options, "0", "0.00")
			n += same("en-US", options, "1", "1.00")
			n += same("en-US", options, "-1", "-1.00")
			n += same("en-US", options, "1234.5", "1,234.50")
			n += same("en-US", options, "-1234.567", "-1,234.57")
			n += same("en-US", options, "1234567.891", "1,234,567.89")
			n += same("en-US", options, "0.001234", "0.00")
			n += same("en-US", options, "999999", "999,999.00")
			n += same("en-US", options, "98765432109876543210", "98,765,432,109,876,543,210.00")
			n += same("en-US", options, "0.5", "0.50")
			n += same("en-US", options, "2.5", "2.50")
