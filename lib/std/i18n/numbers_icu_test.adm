			n += same("id-ID", options, "0.001234", "0,001°C")
			n += same("id-ID", options, "999999", "999.999°C")
			n += same("id-ID", options, "98765432109876543210", "98.765.432.109.876.543.210°C")
			n += same("id-ID", options, "0.5", "0,5°C")
			n += same("id-ID", options, "2.5", "2,5°C")
			n += same("id-ID", options, "1.005", "1,005°C")
			n += same("id-ID", options, "100", "100°C")
			assert n == 0
		}

