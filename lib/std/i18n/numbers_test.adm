partial module std.i18n {
	use (
		std.testing
		std.math::(Decimal, parseDecimal)
	)

	check "Numbers" {
		def dec(text string) Decimal {
			return parseDecimal(text) onerror recover new Decimal()
		}

		def eur() NumberOptions {
			return NumberOptions{kind: NumberKind.Currency, currency: "EUR"}
		}

		// Expected values from ICU 78.3 (node 26.10, Intl.NumberFormat.formatRange).
		@test()
		def formatsRanges() {
			let en = new NumberFormat(new Locale("en-US"), eur())
			assert en.formatRange(dec("3"), dec("5")) == "€3.00 – €5.00"
			assert en.formatRange(dec("3"), dec("3")) == "~€3.00"
			let de = new NumberFormat(new Locale("de-DE"), eur())
			assert de.formatRange(dec("3"), dec("5")) == "3,00–5,00\u00a0€"
			assert de.formatRange(dec("3"), dec("3")) == "≈3,00\u00a0€"
			assert de.approximately(dec("3")) == "≈3,00\u00a0€"
			let plain = new NumberFormat(new Locale("en-US"))
			assert plain.formatRange(dec("3"), dec("5")) == "3–5"
			assert plain.formatRange(dec("1234"), dec("5678")) == "1,234–5,678"
			assert plain.formatRange(dec("-5"), dec("-3")) == "-5 – -3"
			let percent = new NumberFormat(new Locale("en-US"), NumberOptions{kind: NumberKind.Percent})
			assert percent.formatRange(dec("0.03"), dec("0.05")) == "3% – 5%"
			assert percent.formatRange(dec("0.05"), dec("0.05")) == "~5%"
			let km = new NumberFormat(new Locale("fr-FR"), NumberOptions{kind: NumberKind.Unit, unit: "kilometer"})
			assert km.formatRange(dec("3"), dec("5")) == "3–5\u202fkm"
			let yen = new NumberFormat(new Locale("ja-JP"), NumberOptions{kind: NumberKind.Currency, currency: "JPY"})
			assert yen.formatRange(dec("300"), dec("500")) == "￥300 ～ ￥500"
			let whole = new NumberFormat(new Locale("en-US"), NumberOptions{maximumFractionDigits: 0})
			assert whole.formatRange(dec("2.9"), dec("3.1")) == "~3"
		}

		@test()
		def parsesWhatItWrites() !none {
			let cases = string["en-US", "de-DE", "de-CH", "fr-FR", "ar-EG", "fa-IR", "hi-IN-u-nu-deva", "en-IN"]
			let values = string["0", "-1234.5", "1234567.891", "0.25"]
			for let loc in cases {
				let f = new NumberFormat(new Locale(loc))
				for let v in values {
					let text = f.format(dec(v))
					let back = try f.parse(text)
					println(loc + " " + v + " -> " + text + " -> " + back.str()) unless back.equals(dec(v))
					assert back.equals(dec(v))
				}
			}
			let money = new NumberFormat(new Locale("en-US"), NumberOptions{kind: NumberKind.Currency, currency: "USD", currencySign: CurrencySign.Accounting})
			assert (try money.parse("($1,234.50)")).equals(dec("-1234.5"))
			let pct = new NumberFormat(new Locale("de-DE"), NumberOptions{kind: NumberKind.Percent})
			assert (try pct.parse("12,5\u00a0%")).equals(dec("0.125"))
			assert new NumberFormat(new Locale("en")).parse("no digits") is error
			return none
		}

		@test()
		def formatsFloatsAndIntegers() {
			let en = new NumberFormat(new Locale("en-US"))
			assert en.format(1234567) == "1,234,567"
			assert en.format(0.1 + 0.2) == "0.3"
			assert en.format(bigint(12345678901234567890)) == "12,345,678,901,234,567,890"
			let nan = 0.0 / 0.0
			assert en.format(nan) == "NaN"
			assert en.format(1.0 / 0.0) == "∞"
			assert en.format(-1.0 / 0.0) == "-∞"
		}

		@test()
		def exposesSymbols() {
			let s = new NumberFormat(new Locale("de-CH")).symbols()
			assert s.decimal == "." && s.group == "'"
			let ar = new NumberFormat(new Locale("ar-EG")).symbols()
			assert ar.decimal == "٫" && ar.percent == "٪؜"
			let fr = new NumberFormat(new Locale("fr-CH"), NumberOptions{kind: NumberKind.Currency, currency: "CHF"}).symbols()
			assert fr.decimal == "."
		}

		@test()
		def describesCurrencies() {
			let jpy = new Currency("jpy")
			assert jpy.code == "JPY" && jpy.digits() == 0
			assert new Currency("KWD").digits() == 3
			let chf = new Currency("CHF")
			assert chf.digits() == 2 && chf.cashRounding() == 5 && chf.cashDigits() == 2
			assert new Currency("USD").symbol(new Locale("en-CA")) == "US$"
			assert new Currency("USD").narrowSymbol(new Locale("en-CA")) == "$"
			assert new Currency("EUR").name(new Locale("fr")) == "euro"
			assert new Currency("EUR").amount(1999).str() == "19.99"
			assert new Currency("JPY").amount(1999).str() == "1999"
			assert new Currency("EUR").minorUnits(dec("19.995")) == bigint(2000)
			let de = new Region("DE").currency()
			assert !(de is none) && de.code == "EUR"
			let ch = new Region("CH").currency()
			assert !(ch is none) && ch.code == "CHF"
			assert new Region("AQ").currency() is none
		}
	}
}
