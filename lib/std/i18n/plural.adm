partial module std.i18n {
	use (
		std.i18n.plurals
		std.math::(Decimal)
	)

	// PluralCategory is the grammatical plural form a count takes in a language,
	// the six categories of the Unicode CLDR plural rules.
	enum PluralCategory {
		Zero
		One
		Two
		Few
		Many
		Other
	}

	// PluralType says which plural rules apply: Cardinal for counts ("1 file",
	// "2 files"), Ordinal for ranks ("1st", "2nd", "3rd").
	enum PluralType {
		Cardinal
		Ordinal
	}

	// pluralCategory returns the plural form n takes in the locale's language.
	def pluralCategory(locale Locale, n int, kind PluralType = PluralType.Cardinal) PluralCategory {
		return pluralCategory(locale, n.str(), kind)
	}

	// pluralCategory returns the plural form n takes in the locale's language,
	// for n written in its shortest form ("1.5"). Use the text overload when the
	// number is shown with fixed fraction digits: "1.0" is not "1".
	def pluralCategory(locale Locale, n float, kind PluralType = PluralType.Cardinal) PluralCategory {
		return pluralCategory(locale, new Decimal(n).str(), kind)
	}

	// pluralCategory returns the plural form a decimal takes in the locale's
	// language, its scale counting as visible fraction digits: 1.50 has two.
	def pluralCategory(locale Locale, n Decimal, kind PluralType = PluralType.Cardinal) PluralCategory {
		return pluralCategory(locale, n.str(), kind)
	}

	// pluralCategory returns the plural form a number takes in the locale's
	// language as it is written, so that visible fraction digits count:
	// "1" is One in English, "1.0" Other. Compact numbers carry their
	// exponent: "1.2c6" (1.2 million).
	def pluralCategory(locale Locale, n string, kind PluralType = PluralType.Cardinal) PluralCategory {
		let name = plurals.category(pluralKind(kind), dataLocaleOf(locale), plurals.operandsOf(n))
		return categoryNamed(name)
	}

	// pluralCategories returns the categories the locale's language
	// distinguishes, in the order Zero, One, Two, Few, Many, Other.
	def pluralCategories(locale Locale, kind PluralType = PluralType.Cardinal) PluralCategory[] {
		let out = PluralCategory[]
		for let name in plurals.categories(pluralKind(kind), dataLocaleOf(locale)) {
			out.push(categoryNamed(name))
		}
		return out
	}

	// pluralRange returns the plural form of a range from its ends' forms
	// ("1–2 days" takes Other in English, One in some languages).
	def pluralRange(locale Locale, start PluralCategory, end PluralCategory) PluralCategory {
		return categoryNamed(plurals.rangeCategory(dataLocaleOf(locale), categoryName(start), categoryName(end)))
	}

	internal def pluralKind(kind PluralType) string {
		return kind == PluralType.Ordinal ?? ("ordinal", "cardinal")
	}

	// categoryName returns the CLDR keyword of a category: "zero", "one",
	// "two", "few", "many", "other".
	def categoryName(c PluralCategory) string {
		match c {
			case PluralCategory.Zero:
				return "zero"
			case PluralCategory.One:
				return "one"
			case PluralCategory.Two:
				return "two"
			case PluralCategory.Few:
				return "few"
			case PluralCategory.Many:
				return "many"
			default:
				return "other"
		}
	}

	internal def categoryNamed(name string) PluralCategory {
		let all = PluralCategory[PluralCategory.Zero, PluralCategory.One, PluralCategory.Two, PluralCategory.Few, PluralCategory.Many, PluralCategory.Other]
		for let c in all {
			return c when categoryName(c) == name
		}
		return PluralCategory.Other
	}
}
