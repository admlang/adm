partial module std.i18n {
	use (
		std.testing
		std.math::(Decimal)
	)

	check "Plurals" {
		@test()
		def picksCardinalCategories() {
			let en = new Locale("en-US")
			assert pluralCategory(en, 1) == PluralCategory.One
			assert pluralCategory(en, 2) == PluralCategory.Other
			assert pluralCategory(en, "1.0") == PluralCategory.Other
			let ru = new Locale("ru")
			assert pluralCategory(ru, 21) == PluralCategory.One
			assert pluralCategory(ru, 22) == PluralCategory.Few
			assert pluralCategory(ru, 25) == PluralCategory.Many
			assert pluralCategory(ru, 1.5) == PluralCategory.Other
			assert pluralCategory(ru, 1234561.0) == PluralCategory.One
			assert pluralCategory(en, new Decimal(bigint(100), -2)) == PluralCategory.Other
			assert pluralCategory(new Locale("fr-CA"), 1.5) == PluralCategory.One
			assert pluralCategory(new Locale("fr"), "1c6") == PluralCategory.Many
			assert pluralCategory(new Locale("ar-EG"), 0) == PluralCategory.Zero
			assert pluralCategory(new Locale("ar"), 2) == PluralCategory.Two
			assert pluralCategory(new Locale("ja"), 1) == PluralCategory.Other
		}

		@test()
		def picksOrdinalCategories() {
			let en = new Locale("en")
			assert pluralCategory(en, 1, PluralType.Ordinal) == PluralCategory.One
			assert pluralCategory(en, 22, PluralType.Ordinal) == PluralCategory.Two
			assert pluralCategory(en, 13, PluralType.Ordinal) == PluralCategory.Other
			assert pluralCategory(en, 103, PluralType.Ordinal) == PluralCategory.Few
		}

		@test()
		def listsCategoriesAndRanges() {
			let pl = pluralCategories(new Locale("pl"))
			assert pl.len() == 4
			assert pl[0] == PluralCategory.One && pl[3] == PluralCategory.Other
			assert pluralCategories(new Locale("ja")).len() == 1
			assert pluralRange(new Locale("en"), PluralCategory.One, PluralCategory.Other) == PluralCategory.Other
			assert categoryName(PluralCategory.Few) == "few"
			assert pluralRange(new Locale("lv"), PluralCategory.Zero, PluralCategory.One) == PluralCategory.One
		}
	}
}
