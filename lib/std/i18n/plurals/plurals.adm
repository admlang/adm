// CLDR plural rules (UTS #35, Language Plural Rules): the operands of a
// decimal number, the rule syntax, and the compiled rules of each language.

internal partial module std.i18n.plurals {
	use std.i18n.cldr::(tables)

	// Operands are the values plural rules test, taken from a number as it is
	// written: n absolute value, i integer digits, v visible fraction digits,
	// w the same without trailing zeros, f and t the fraction digits as an
	// integer with and without trailing zeros, c the compact exponent.
	struct Operands {
		n float
		i int64
		v int
		w int
		f int64
		t int64
		c int
	}

	// OperandsOf reads decimal text: "12", "-1.50", "1.2c6" (compact
	// exponent, also written with "e"). Malformed text reads as far as it
	// goes.
	def operandsOf(text string) Operands {
		let s = text.trim()
		s = s[1:] when s.startsWith("-") || s.startsWith("+")
		let exp = 0
		let at = s.indexOf("c")
		at = s.indexOf("e") when at < 0
		if at >= 0 {
			exp = s[at + 1:].toInt<int>()
			s = s[:at]
		}
		let whole = s
		let frac = ""
		let dot = s.indexOf(".")
		if dot >= 0 {
			whole = s[:dot]
			frac = s[dot + 1:]
		}
		// The compact exponent moves the decimal point right.
		for let _ in 0..exp {
			if frac.len() > 0 {
				whole += frac[:1]
				frac = frac[1:]
			} else {
				whole += "0"
			}
		}
		let o = Operands{c: exp}
		o.i = digitsValue(whole)
		o.v = frac.len()
		let trimmed = frac
		for trimmed.endsWith("0") {
			trimmed = trimmed[:trimmed.len() - 1]
		}
		o.w = trimmed.len()
		o.f = digitsValue(frac)
		o.t = digitsValue(trimmed)
		o.n = float(o.i)
		o.n = parseFloat<float>(whole + "." + frac) when frac.len() > 0
		return o
	}

	// The value of a run of decimal digits, 0 for none; digits past what an
	// int64 holds are dropped from the front, which keeps every modulus the
	// rules take.
	def digitsValue(digits string) int64 {
		let out = int64(0)
		let start = digits.len() > 18 ?? (digits.len() - 18, 0)
		for let k in start..digits.len() {
			let d = int64(digits[k:k + 1].toInt<int>())
			out = out * 10 + d
		}
		return out
	}

	// Relation is one test of a rule: an operand, an optional modulus, and
	// the values or ranges it must (or, negated, must not) fall in.
	struct Relation {
		operand string
		modulus int64
		negated bool
		lows    float[]
		highs   float[]
	}

	// Rule is a category's condition: relations joined by "and", the groups
	// joined by "or". An empty condition always holds.
	struct Rule {
		category string
		groups   Relation[][]
	}

	// Parse reads the condition of a CLDR rule, ignoring its samples.
	def parse(category string, text string) Rule {
		let rule = Rule{category: category, groups: Relation[][]}
		let body = text
		let at = body.indexOf("@")
		body = body[:at] when at >= 0
		body = body.trim()
		return rule when body == ""
		for let orPart in body.split(" or ") {
			let group = Relation[]
			for let andPart in orPart.split(" and ") {
				group.push(relation(andPart.trim()))
			}
			rule.groups.push(group)
		}
		return rule
	}

	def relation(text string) Relation {
		let r = Relation{lows: float[], highs: float[]}
		let op = " = "
		let at = text.indexOf(" != ")
		if at >= 0 {
			r.negated = true
			op = " != "
		} else {
			at = text.indexOf(" = ")
		}
		let left = text[:at].trim()
		let right = text[at + op.len():].trim()
		let mod = left.indexOf("%")
		if mod >= 0 {
			r.operand = left[:mod].trim()
			r.modulus = int64(left[mod + 1:].trim().toInt<int>())
		} else {
			r.operand = left
		}
		for let item in right.split(",") {
			let bounds = item.trim().split("..")
			r.lows.push(parseFloat<float>(bounds[0]))
			r.highs.push(parseFloat<float>(bounds[bounds.len() - 1]))
		}
		return r
	}

	// Holds reports whether the operands satisfy the rule.
	def holds(rule Rule, o Operands) bool {
		return true when rule.groups.len() == 0
		for let group in rule.groups {
			let all = true
			for let r in group {
				if !test(r, o) {
					all = false
					break
				}
			}
			return true when all
		}
		return false
	}

	def test(r Relation, o Operands) bool {
		let value = operand(r.operand, o)
		let integral = r.operand != "n" || float(int64(o.n)) == o.n
		if r.modulus > 0 {
			if r.operand == "n" {
				// n keeps its fraction: 1.5 % 10 is 1.5.
				value = float(int64(o.n) % r.modulus) + (o.n - float(int64(o.n)))
			} else {
				value = float(int64(value) % r.modulus)
			}
		}
		let inside = false
		for let k in 0..r.lows.len() {
			if integral && value >= r.lows[k] && value <= r.highs[k] {
				inside = true
				break
			}
		}
		return inside != r.negated
	}

	def operand(name string, o Operands) float {
		match name {
			case "n":
				return o.n
			case "i":
				return float(o.i)
			case "v":
				return float(o.v)
			case "w":
				return float(o.w)
			case "f":
				return float(o.f)
			case "t":
				return float(o.t)
			default:
				return float(o.c)
		}
	}

	// Category order of the CLDR data, so "other" is tried last.
	let order = string["zero", "one", "two", "few", "many", "other"]

	// RuleSets compiles each language's rules on first use. Every method is
	// atomic, so tasks share it.
	type RuleSets {
		compiled map<string, Rule[]>

		def new() {
			compiled = map<string, Rule[]>{}
		}

		// Rules returns the cardinal ("cardinal") or ordinal ("ordinal") rules
		// of the CLDR locale, or of the nearest parent that has some.
		atomic def rules(kind string, locale string) Rule[] {
			let key = kind + "/" + locale
			return compiled[key] when compiled.hasKey(key)
			let file = kind == "ordinal" ?? ("ordinals", "plurals")
			let name = locale
			let found = map<string, string>{}
			for {
				found = tables.values("supplemental/" + file, "root", "plurals-type-" + kind + "/" + name)
				break when found.len() > 0
				let parent = tables.parent(name)
				break when parent is none || parent == "root"
				name = parent
			}
			let out = Rule[]
			for let c in order {
				let k = "pluralRule-count-" + c
				out.push(parse(c, found[k])) when found.hasKey(k)
			}
			out.push(parse("other", "")) when out.len() == 0
			compiled[key] = out
			return out
		}
	}

	let ruleSets = new RuleSets()

	// Category returns the name of the plural category the operands take in
	// the CLDR locale.
	def category(kind string, locale string, o Operands) string {
		for let r in ruleSets.rules(kind, locale) {
			return r.category when holds(r, o)
		}
		return "other"
	}

	// Categories returns the categories the CLDR locale distinguishes.
	def categories(kind string, locale string) string[] {
		let out = string[]
		for let r in ruleSets.rules(kind, locale) {
			out.push(r.category)
		}
		return out
	}

	// Samples returns the sample numbers CLDR lists for a category, ranges
	// "a~b" given as both ends.
	def samples(kind string, locale string, category string) string[] {
		let file = kind == "ordinal" ?? ("ordinals", "plurals")
		let text = tables.value("supplemental/" + file, "root", "plurals-type-" + kind + "/" + locale + "/pluralRule-count-" + category)
		let out = string[]
		return out when text is none
		let at = text.indexOf("@")
		return out when at < 0
		for let part in text[at:].split("@") {
			let body = part.trim()
			continue when body == ""
			let space = body.indexOf(" ")
			continue when space < 0
			for let item in body[space + 1:].split(",") {
				let s = item.trim()
				continue when s := "" || "…"
				for let end in s.split("~") {
					out.push(end)
				}
			}
		}
		return out
	}

	// Range returns the category of a range "start–end" from the categories
	// of its ends, by the CLDR plural range data of the locale's language.
	def rangeCategory(locale string, start string, end string) string {
		let name = locale
		for {
			let v = tables.value("supplemental/pluralRanges", "root", "plurals/" + name + "/pluralRange-start-" + start + "-end-" + end)
			return v when !(v is none)
			let parent = tables.parent(name)
			break when parent is none || parent == "root"
			name = parent
		}
		return end
	}
}
