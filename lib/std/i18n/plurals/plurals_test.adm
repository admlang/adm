internal partial module std.i18n.plurals {
	use (
		std.testing
		std.i18n.cldr::(tables)
	)

	check "Plural rules" {
		@test()
		def readsOperands() {
			let o = operandsOf("1.50")
			assert o.i == 1 && o.v == 2 && o.w == 1 && o.f == 50 && o.t == 5 && o.n == 1.5
			let c = operandsOf("1.0000001c6")
			assert c.i == 1000000 && c.v == 1 && c.f == 1 && c.c == 6
			let e = operandsOf("-12")
			assert e.i == 12 && e.v == 0 && e.n == 12.0
		}

		// Every sample number CLDR lists for a category falls in that category,
		// in every language, for cardinal and ordinal rules.
		@test()
		def matchesEveryCldrSample() {
			let checked = 0
			for let kind in string["cardinal", "ordinal"] {
				let file = kind == "ordinal" ?? ("ordinals", "plurals")
				let all = tables.values("supplemental/" + file, "root", "plurals-type-" + kind)
				for let (path, _) in all {
					let parts = path.split("/")
					let language = parts[0]
					let want = parts[1].trimPrefix("pluralRule-count-")
					for let s in samples(kind, language, want) {
						let got = category(kind, language, operandsOf(s))
						println(kind + " " + language + " " + s + ": got " + got + ", want " + want) when got != want
						assert got == want
						checked++
					}
				}
			}
			assert checked > 5000
		}
	}
}
