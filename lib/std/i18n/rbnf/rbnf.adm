// CLDR rule-based number formatting (RBNF, as ICU's RuleBasedNumberFormat
// reads it): spelled-out numbers, ordinals, years and the algorithmic
// numbering systems (Roman, Hebrew, Armenian, ...).

internal partial module std.i18n.rbnf {
	use (
		std.i18n.cldr::(tables)
		std.i18n.numfmt
		std.i18n.plurals
		std.math::(Decimal, RoundingMode)
	)

	// The rule groups a rule set may live in.
	let groups = string["SpelloutRules", "OrdinalRules", "NumberingSystemRules"]

	// PartKind is what a piece of rule text stands for.
	enum PartKind {
		Text      // literal text
		Quotient  // ←← : the value divided by the rule's divisor
		Remainder // →→ : the remainder
		Same      // =…= : the value itself
		Plural    // $(ordinal,one{st}…)$
		None      // not a substitution character
	}

	// RuleKind is what a rule's descriptor selects it for.
	enum RuleKind {
		Normal   // a base value: "20", "1010/100"
		Negative // -x
		Improper // x.x: a number with a fraction
		Proper   // 0.x: a fraction below one
		Master   // x.0
		Infinity // Inf
		NaN      // NaN
	}

	// Part is one piece of a rule's text.
	struct Part {
		kind     PartKind
		text     string // literal text, or the plural type (cardinal, ordinal)
		ruleSet  string // substitution through this rule set ("" for the rule's own)
		pattern  string // substitution through this decimal pattern ("#,##0")
		previous bool // →→→: the remainder through the rule before this one, or digits without spaces; ←set←←: leading zeros
		optional int // 0 always; inside [a|b]: 1 only when the remainder is not zero (a), 2 only when it is (b)
		forms    map<string, string> // plural text per category
	}

	struct Rule {
		kind     RuleKind
		base     int64
		radix    int64
		exponent int
		parts    Part[]
	}

	// RuleSet is a parsed rule set: its normal rules by ascending base value
	// and its special rules.
	struct RuleSet {
		name          string
		locale        string // the CLDR locale it came from
		normal        Rule[]
		negative      ?Rule
		improper      ?Rule
		proper        ?Rule
		master        ?Rule
		improperComma ?Rule // x,x: used where the decimal separator is a comma
		properComma   ?Rule // 0,x
		found         bool
	}

	// Sets parses each rule set once per CLDR locale.
	type Sets {
		parsed map<string, RuleSet>

		def new() {
			parsed = map<string, RuleSet>{}
		}

		atomic def get(locale string, name string) RuleSet {
			let key = locale + "\x1f" + name
			return parsed[key] when parsed.hasKey(key)
			let set = load(locale, name)
			parsed[key] = set
			return set
		}

		// The public spell-out and ordinal rule set names of the locale's
		// nearest rule data; numbering systems are reached through -u-nu.
		atomic def names(locale string) string[] {
			let out = string[]
			for let g in string["SpelloutRules", "OrdinalRules"] {
				for let (k, _) in tables.nearest("rbnf", locale, "rbnf/" + g) {
					let name = k.split("/")[0]
					out.push(name) when name.startsWith("%") && !name.startsWith("%%") && !out.includes(name)
				}
			}
			out.sort((a, b) => a < b)
			return out
		}
	}

	let sets = new Sets()

	def load(locale string, name string) RuleSet {
		let set = RuleSet{name: name, locale: locale, normal: Rule[]}
		let entries = map<string, string>{}
		for let g in groups {
			entries = tables.nearest("rbnf", locale, "rbnf/" + g + "/" + name)
			break when entries.len() > 0
		}
		// The rule set may live only in root (numbering systems).
		if entries.len() == 0 {
			for let g in groups {
				entries = tables.nearest("rbnf", "root", "rbnf/" + g + "/" + name)
				break when entries.len() > 0
			}
		}
		return set when entries.len() == 0
		set.found = true
		let count = entries.len()
		for let i in 0..count {
			let key = i.str()
			continue unless entries.hasKey(key)
			let pair = entries[key].split("\x1f")
			continue when pair.len() < 2
			let rule = parseRule(pair[0], pair[1])
			match rule.kind {
				case RuleKind.Negative:
					set.negative = rule
				case RuleKind.Improper:
					if pair[0].contains(",") {
						set.improperComma = rule
					} else {
						set.improper = rule
					}
				case RuleKind.Proper:
					if pair[0].contains(",") {
						set.properComma = rule
					} else {
						set.proper = rule
					}
				case RuleKind.Master:
					set.master = rule
				case RuleKind.Infinity, RuleKind.NaN:
				default:
					set.normal.push(rule)
			}
		}
		return set
	}

	def parseRule(descriptor string, body string) Rule {
		let r = Rule{radix: 10, parts: Part[]}
		let d = descriptor.trim()
		let shifts = 0
		for d.endsWith(">") {
			shifts++
			d = d[:d.len() - 1]
		}
		match d {
			case "-x":
				r.kind = RuleKind.Negative
			case "x.x", "x,x":
				r.kind = RuleKind.Improper
			case "0.x", "0,x":
				r.kind = RuleKind.Proper
			case "x.0":
				r.kind = RuleKind.Master
			case "Inf":
				r.kind = RuleKind.Infinity
			case "NaN":
				r.kind = RuleKind.NaN
			default:
				r.kind = RuleKind.Normal
				let slash = d.indexOf("/")
				if slash >= 0 {
					r.radix = int64(d[slash + 1:].toInt<int>())
					d = d[:slash]
				}
				r.base = int64(d.replace(",", "").toInt<int>())
		}
		r.exponent = exponentOf(r.base, r.radix) - shifts
		r.parts = parseBody(body)
		return r
	}

	// The highest power of the radix not above the base.
	def exponentOf(base int64, radix int64) int {
		return 0 when base < 1 || radix < 2
		let e = 0
		let p = radix
		for p <= base {
			p = p * radix
			e++
		}
		return e
	}

	def parseBody(raw string) Part[] {
		let text = raw
		text = text[:text.len() - 1] when text.endsWith(";")
		// A leading apostrophe keeps the spaces after it.
		text = text[1:] when text.startsWith("'")
		let chars = string[]
		for let ch in text {
			chars.push(string(ch))
		}
		let parts = Part[]
		let literal = ""
		let optional = 0
		let i = 0
		for i < chars.len() {
			let c = chars[i]
			let alternation = c == "|" && optional != 0
			if (c := "[" || "]") || alternation {
				if literal != "" {
					parts.push(Part{kind: PartKind.Text, text: literal, optional: optional})
					literal = ""
				}
				optional = c == "[" ?? (1, c == "|" ?? (2, 0))
				i++
				continue
			}
			if c == "$" && i + 1 < chars.len() && chars[i + 1] == "(" {
				let end = i + 2
				for end + 1 < chars.len() && !(chars[end] == ")" && chars[end + 1] == "$") {
					end++
				}
				if literal != "" {
					parts.push(Part{kind: PartKind.Text, text: literal, optional: optional})
					literal = ""
				}
				parts.push(pluralOf(chars[i + 2:end].join(""), optional))
				i = end + 2
				continue
			}
			let open = substitutionKind(c)
			if open != PartKind.None {
				if literal != "" {
					parts.push(Part{kind: PartKind.Text, text: literal, optional: optional})
					literal = ""
				}
				let j = i + 1
				for j < chars.len() && substitutionKind(chars[j]) != open {
					j++
				}
				let inner = chars[i + 1:j].join("")
				let p = Part{kind: open, optional: optional}
				if inner.startsWith("%") {
					p.ruleSet = inner
				} else if inner != "" {
					p.pattern = inner
				}
				i = j + 1
				// →→→ formats the remainder through the previous rule (in a fraction
				// rule: its digits without spaces); ←set←← in a fraction rule set
				// spells the numerator's leading zeros.
				if open != PartKind.Same && i < chars.len() && substitutionKind(chars[i]) == open {
					p.previous = true
					i++
				}
				parts.push(p)
				continue
			}
			literal += c
			i++
		}
		parts.push(Part{kind: PartKind.Text, text: literal, optional: optional}) when literal != ""
		return parts
	}

	def substitutionKind(c string) PartKind {
		return PartKind.Quotient when c := "←" || "<"
		return PartKind.Remainder when c := "→" || ">"
		return PartKind.Same when c == "="
		return PartKind.None
	}

	// Reads "ordinal,one{st}two{nd}few{rd}other{th}".
	def pluralOf(spec string, optional int) Part {
		let p = Part{kind: PartKind.Plural, optional: optional, forms: map<string, string>{}}
		let comma = spec.indexOf(",")
		p.text = comma >= 0 ?? (spec[:comma], "cardinal")
		let rest = comma >= 0 ?? (spec[comma + 1:], spec)
		for rest != "" {
			let open = rest.indexOf("\{")
			let close = rest.indexOf("\}")
			break when open < 0 || close < open
			p.forms[rest[:open].trim()] = rest[open + 1:close]
			rest = rest[close + 1:]
		}
		return p
	}

	// Format writes the value through the named rule set of the CLDR locale,
	// with the given decimal and grouping symbols for decimal patterns.
	def format(locale string, name string, value Decimal, symbols Symbols) string {
		let set = sets.get(locale, name)
		return value.str() when !set.found
		return spell(set, value, symbols)
	}

	// Symbols are the decimal and group separators decimal patterns use.
	struct Symbols {
		decimal string
		group   string
	}

	// Spell formats the value through a parsed rule set.
	def spell(set RuleSet, value Decimal, symbols Symbols) string {
		let abs = value.abs()
		if value.sign() < 0 {
			let neg = set.negative
			return render(set, neg, value, abs, symbols) unless neg is none
		}
		if abs.trim().scale() != 0 {
			let whole = abs.round(0, RoundingMode.Trunc)
			// Where the locale's decimal separator is a comma, the comma forms win.
			let comma = symbols.decimal == ","
			let proper = comma && !(set.properComma is none) ?? (set.properComma, set.proper)
			return render(set, proper, value, abs, symbols) when whole.isZero() && !(proper is none)
			let improper = comma && !(set.improperComma is none) ?? (set.improperComma, set.improper)
			return render(set, improper, value, abs, symbols) unless (improper is none)
			let master = set.master
			return render(set, master, value, abs, symbols) unless (master is none)
		}
		// The rule for the value rounded half up (ICU's choice for a fraction
		// without fraction rules); a negative value without a negative rule is
		// looked up as positive. Substitutions still receive the exact value,
		// and =…= receives it signed.
		let n = abs.round(0, RoundingMode.HalfExpand).toInt()
		return decimal(value, "#,##0.#", symbols) when n.bitLen() > 62
		let index = findRule(set, int64(n))
		return decimal(value, "#,##0.#", symbols) when index < 0
		return renderAt(set, index, abs, value, symbols)
	}

	// The index of the normal rule for n: the one with the highest base value
	// not above n, rolled back one when n is a multiple of its divisor that its
	// base value is not (so "two hundred" does not read "two hundred zero").
	def findRule(set RuleSet, n int64) int {
		let lo = 0
		let hi = set.normal.len()
		for lo < hi {
			let mid = (lo + hi) / 2
			if set.normal[mid].base <= n {
				lo = mid + 1
			} else {
				hi = mid
			}
		}
		let index = lo - 1
		return index when index <= 0
		let r = set.normal[index]
		let divisor = power(r.radix, r.exponent)
		return index - 1 when hasRemainder(r) && n % divisor == 0 && r.base % divisor != 0
		return index
	}

	def hasRemainder(r Rule) bool {
		for let p in r.parts {
			return true when p.kind == PartKind.Remainder
		}
		return false
	}

	def power(radix int64, exponent int) int64 {
		let out = int64(1)
		for let _ in 0..exponent {
			out = out * radix
		}
		return out
	}

	// Renders normal rule index for value (not negative, possibly with a
	// fraction when the rule set has no fraction rules); signed is the value
	// the caller asked for, which =…= substitutions receive.
	def renderAt(set RuleSet, index int, value Decimal, signed Decimal, symbols Symbols) string {
		let r = set.normal[index]
		let divisor = new Decimal(int(power(r.radix, r.exponent)))
		let quotient = value.divide(divisor, 0, RoundingMode.Floor) onerror recover value
		let remainder = value - quotient * divisor
		let out = ""
		for let p in r.parts {
			continue when p.optional == 1 && remainder.isZero() || p.optional == 2 && !remainder.isZero()
			match p.kind {
				case PartKind.Text:
					out += p.text
				case PartKind.Quotient:
					out += sub(set, p, quotient, symbols)
				case PartKind.Remainder:
					if p.previous && index > 0 {
						out += renderAt(set, index - 1, remainder, remainder, symbols)
					} else {
						out += sub(set, p, remainder, symbols)
					}
				case PartKind.Same:
					out += sub(set, p, signed, symbols)
				default:
					// Below one the plural follows the value scaled by the divisor and
					// rounded half up (0.5 is "1st"), as ICU does; otherwise the quotient.
					let below = value.compare(new Decimal(1)) < 0
					let pv = below ?? ((value * divisor).round(0, RoundingMode.HalfExpand), quotient)
					out += pluralText(p, set.locale, pv)
			}
		}
		return out
	}

	def pluralText(p Part, locale string, value Decimal) string {
		let cat = plurals.category(p.text, locale, plurals.operandsOf(value.str()))
		return p.forms[cat] when p.forms.hasKey(cat)
		return p.forms.hasKey("other") ?? (p.forms["other"], "")
	}

	// Renders a negative or fraction rule: value is what it stands for, abs its
	// absolute value.
	def render(set RuleSet, r Rule, value Decimal, abs Decimal, symbols Symbols) string {
		let whole = abs.round(0, RoundingMode.Trunc)
		let fraction = abs - whole
		let out = ""
		for let p in r.parts {
			// A fraction rule's brackets hold what only a non-zero integer part
			// shows ("три целых …" but "пять десятых").
			let zero = r.kind != RuleKind.Negative && whole.isZero()
			continue when p.optional == 1 && zero || p.optional == 2 && !zero
			match p.kind {
				case PartKind.Text:
					out += p.text
				case PartKind.Quotient:
					out += sub(set, p, whole, symbols)
				case PartKind.Remainder:
					if r.kind == RuleKind.Negative {
						out += sub(set, p, abs, symbols)
					} else {
						out += fractionDigits(set, p, fraction, symbols)
					}
				case PartKind.Same:
					out += sub(set, p, value, symbols)
				default:
					out += pluralText(p, set.locale, whole)
			}
		}
		return out
	}

	// The fraction's digits after the point, one by one through the rule set
	// ("point one two"), or as a number through a decimal pattern.
	def fractionDigits(set RuleSet, p Part, fraction Decimal, symbols Symbols) string {
		let text = fraction.trim().str()
		let dot = text.indexOf(".")
		let digits = dot >= 0 ?? (text[dot + 1:], "")
		return decimal(new Decimal(digits.toInt<int>()), p.pattern, symbols) when p.pattern != ""
		// Another rule set names the fraction as a whole ("четырнадцать сотых").
		return fractionSet(sets.get(set.locale, p.ruleSet), fraction, symbols) when p.ruleSet != "" && p.ruleSet != set.name
		let words = string[]
		for let ch in digits {
			words.push(spell(set, new Decimal(int(ch) - int('0')), symbols))
		}
		return words.join(p.previous ?? ("", " "))
	}

	// Formats a fraction through a fraction rule set: the rule whose base
	// value (a denominator) fits the fraction best, its ← the numerator.
	def fractionSet(set RuleSet, fraction Decimal, symbols Symbols) string {
		return "" when set.normal.len() == 0
		let lcm = int64(1)
		for let r in set.normal {
			lcm = lcmOf(lcm, r.base) when r.base > 0
		}
		let numerator = int64((fraction * new Decimal(int(lcm))).round(0, RoundingMode.HalfExpand).toInt())
		let winner = 0
		let difference = lcm
		for let i in 0..set.normal.len() {
			let base = set.normal[i].base
			continue when base <= 0
			let d = numerator * base % lcm
			let near = lcm - d < d ?? (lcm - d, d)
			if near < difference {
				difference = near
				winner = i
				break when near == 0
			}
		}
		// Two rules with one base: the first for a numerator of one ("one
		// third"), the second for others ("two thirds").
		if winner + 1 < set.normal.len() && set.normal[winner + 1].base == set.normal[winner].base {
			let n = fraction * new Decimal(int(set.normal[winner].base))
			if n.compare(new Decimal(5, -1)) < 0 || n.compare(new Decimal(2)) >= 0 {
				winner++
			}
		}
		let r = set.normal[winner]
		let base = new Decimal(int(r.base))
		let num = (fraction * base).round(0, RoundingMode.HalfExpand)
		let out = ""
		for let p in r.parts {
			match p.kind {
				case PartKind.Text:
					out += p.text
				case PartKind.Quotient:
					if p.previous {
						// Leading zeros of the numerator over the denominator.
						let nf = num
						for (nf * new Decimal(10)).compare(base) < 0 && !nf.isZero() {
							out += sub(set, p, new Decimal(), symbols) + " "
							nf = nf * new Decimal(10)
						}
					}
					out += sub(set, p, num, symbols)
				case PartKind.Plural:
					out += pluralText(p, set.locale, num)
				default:
					out += sub(set, p, num, symbols)
			}
		}
		return out
	}

	def lcmOf(a int64, b int64) int64 {
		let x = a
		let y = b
		for y != 0 {
			let t = x % y
			x = y
			y = t
		}
		return a / x * b
	}

	def sub(set RuleSet, p Part, value Decimal, symbols Symbols) string {
		return decimal(value, p.pattern, symbols) when p.pattern != ""
		let target = p.ruleSet == "" ?? (set, sets.get(set.locale, p.ruleSet))
		return spell(target, value, symbols)
	}

	// Writes the value through a decimal pattern such as "#,##0" or
	// "#,##0.00".
	def decimal(value Decimal, pattern string, symbols Symbols) string {
		let pat = numfmt.parse(pattern)
		let v = value.abs().round(pat.maxFrac, RoundingMode.HalfEven)
		let (integer, fraction) = numfmt.digits(v, pat.minInt > 0 ?? (pat.minInt, 1), pat.minFrac)
		let out = numfmt.group(integer, pat.primary, pat.secondary, 1, symbols.group)
		out += symbols.decimal + fraction when fraction != ""
		return value.sign() < 0 ?? ("-" + out, out)
	}
}
