internal partial module std.i18n.rbnf {
	use (
		std.testing
		std.math::(parseDecimal, Decimal)
		std.i18n::(NumberFormat, Locale)
	)

	check "RBNF against ICU" {
		// 1 when the spelled form differs from ICU's, after printing both.
		def same(locale string, ruleSet string, value string, want string) int {
			let v = parseDecimal(value) onerror recover new Decimal()
			let s = new NumberFormat(new Locale(locale == "root" ?? ("en", locale + "-u-nu-latn"))).symbols()
			let got = format(locale, ruleSet, v, Symbols{decimal: s.decimal, group: s.group})
			return 0 when got == want
			println(locale + " " + ruleSet + " " + value + ": got [" + got + "] want [" + want + "]")
			return 1
		}

