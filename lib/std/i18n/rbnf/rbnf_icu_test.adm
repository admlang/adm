		@test()
		def batch35() {
			let n = 0
			n += same("tr", "%spellout-numbering-year", "1999", "bin dokuz yüz doksan dokuz")
			n += same("tr", "%spellout-numbering-year", "2000", "iki bin")
			n += same("tr", "%spellout-numbering-year", "2025", "iki bin yirmi beş")
			n += same("tr", "%spellout-numbering-year", "10000", "on bin")
			n += same("tr", "%spellout-numbering-year", "21000", "yirmi bir bin")
			n += same("tr", "%spellout-numbering-year", "100000", "yüz bin")
