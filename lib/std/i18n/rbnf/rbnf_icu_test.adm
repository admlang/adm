		@test()
		def batch16() {
			let n = 0
			n += same("pl", "%spellout-cardinal-masculine-instrumental", "999", "dziewięciuset dziewięćdziesięcioma dziewięcioma")
			n += same("pl", "%spellout-cardinal-masculine-instrumental", "1000", "tysiącem")
