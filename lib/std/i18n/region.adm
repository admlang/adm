partial module std.i18n {
	use std.i18n.subtags

	// Region is a country or territory by its ISO 3166-1 code, or a UN M.49
	// area by its three digits ("DE", "419"); "" when not given.
	type Region {
		code string // ISO 3166-1 alpha-2, or UN M.49

		def new(code string) {
			self.code = code.upper()
		}

		// Name returns the region's name in the given locale ("Germany" in
		// English), or its code when the locale has none.
		def name(locale Locale) string {
			return displayName(locale, "territories", "localeDisplayNames/territories/" + code, code)
		}

		// Contains reports whether this area includes the other region,
		// directly or through its subareas ("150", Europe, contains "DE").
		def contains(other Region) bool {
			return subtags.contains(code, other.code)
		}

		// Currency returns the currency in use in the region today, or none for
		// a region without one (Antarctica, the world).
		def currency() ?Currency {
			return regionCurrency(code)
		}

		// Str returns the code.
		def str() string {
			return code
		}
	}
}
