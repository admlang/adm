partial module std.i18n {
	// Script is a writing system by its ISO 15924 code, as BCP 47 writes it
	// ("Latn", "Hant"); "" when not given.
	type Script {
		code string // ISO 15924

		def new(code string) {
			self.code = code.capitalize()
		}

		// Name returns the script's name in the given locale ("Traditional" in
		// English for Hant), or its code when the locale has none.
		def name(locale Locale) string {
			return displayName(locale, "scripts", "localeDisplayNames/scripts/" + code, code)
		}

		// Str returns the code.
		def str() string {
			return code
		}
	}
}
