partial module std.i18n {
	use std.math::(RoundingMode)

	// Reads an ICU number skeleton ("currency/EUR", "compact-short", ".00",
	// "percent scale/100", "@@@ group-off") into number options, in both its
	// long and concise spellings. ICU's defaults apply: halves round to even.
	//
	// Fails on a token that is not a skeleton token, and on those the number
	// formatter cannot write: a scale other than 100 on a percentage,
	// "decimal-always", "integer-width-trunc", an integer width that cuts
	// digits, "precision-currency-cash", "rounding-mode-half-odd",
	// "rounding-mode-unnecessary", the unit widths "formal", "variant" and
	// "hidden", an exponent with a width or a sign, and a fraction precision
	// joined with a significant-digit one.
	internal def numberSkeleton(text string) !NumberOptions {
		let o = NumberOptions{roundingMode: RoundingMode.HalfEven}
		let scale = 1
		// Whether a token set how many digits are written.
		let precise = false
		for let token in text.trim().split(" ") {
			continue when token == ""
			let slash = token.indexOf("/")
			let stem = slash < 0 ?? (token, token[:slash])
			let option = slash < 0 ?? ("", token[slash + 1:])
			let unknown = "number skeleton: unknown token \"" + token + "\""
			let unsupported = "number skeleton: \"" + token + "\" is not supported"
			match stem {
				case "percent", "%":
					o.kind = NumberKind.Unit
					o.unit = "percent"
				case "%x100":
					o.kind = NumberKind.Percent
				case "permille":
					o.kind = NumberKind.Unit
					o.unit = "permille"
				case "base-unit", "notation-simple", "decimal-auto", "precision-currency-standard", "sign-auto", "group-auto":
				case "currency":
					fail "number skeleton: \"" + token + "\" needs a three-letter currency" unless option.len() == 3 && option.isAlpha()
					o.kind = NumberKind.Currency
					o.currency = option.upper()
				case "measure-unit", "unit":
					fail "number skeleton: \"" + token + "\" names no unit" when option == ""
					o.kind = NumberKind.Unit
					o.unit = option
				case "per-measure-unit":
					fail "number skeleton: \"" + token + "\" names no unit" when option == "" || o.unit == ""
					let dash = option.indexOf("-")
					o.unit += "-per-" + (dash < 0 ?? (option, option[dash + 1:]))
				case "compact-short", "K":
					o.notation = Notation.Compact
					o.compactDisplay = CompactDisplay.Short
				case "compact-long", "KK":
					o.notation = Notation.Compact
					o.compactDisplay = CompactDisplay.Long
				case "scientific", "E0":
					fail unsupported when option != ""
					o.notation = Notation.Scientific
				case "engineering", "EE0":
					fail unsupported when option != ""
					o.notation = Notation.Engineering
				case "precision-integer":
					o.minimumFractionDigits = 0
					o.maximumFractionDigits = 0
					precise = true
				case "precision-unlimited":
					o.minimumFractionDigits = 0
					o.maximumFractionDigits = 100
					precise = true
				case "precision-increment":
					let dot = option.indexOf(".")
					let digits = dot < 0 ?? ("", option[dot + 1:])
					let whole = dot < 0 ?? (option, option[:dot])
					fail unknown unless option != "" && (whole + digits).isNumeric()
					fail unsupported unless whole.trim("0") == "" && digits.trimStart("0") != ""
					o.minimumFractionDigits = digits.len()
					o.maximumFractionDigits = digits.len()
					o.roundingIncrement = digits.trimStart("0").toInt<int>()
					precise = true
				case "rounding-mode-ceiling":
					o.roundingMode = RoundingMode.Ceil
				case "rounding-mode-floor":
					o.roundingMode = RoundingMode.Floor
				case "rounding-mode-down":
					o.roundingMode = RoundingMode.Trunc
				case "rounding-mode-up":
					o.roundingMode = RoundingMode.Expand
				case "rounding-mode-half-even":
					o.roundingMode = RoundingMode.HalfEven
				case "rounding-mode-half-down":
					o.roundingMode = RoundingMode.HalfTrunc
				case "rounding-mode-half-up":
					o.roundingMode = RoundingMode.HalfExpand
				case "rounding-mode-half-ceiling":
					o.roundingMode = RoundingMode.HalfCeil
				case "rounding-mode-half-floor":
					o.roundingMode = RoundingMode.HalfFloor
				case "rounding-mode-half-odd", "rounding-mode-unnecessary", "decimal-always", "integer-width-trunc", "precision-currency-cash", "unit-width-formal", "unit-width-variant", "unit-width-hidden":
					fail unsupported
				case "integer-width":
					let width = option.trimStart("+")
					fail unknown when width == "" || width.trim("0") != ""
					fail unsupported unless option.startsWith("+")
					o.minimumIntegerDigits = width.len()
				case "scale":
					fail unknown unless option != "" && option.isNumeric()
					scale = option.toInt<int>()
				case "group-off", ",_":
					o.grouping = Grouping.Off
				case "group-min2", ",?":
					o.grouping = Grouping.Min2
				case "group-on-aligned", ",!", "group-thousands", ",=":
					o.grouping = Grouping.Always
				case "latin":
					o.numberingSystem = "latn"
				case "numbering-system":
					fail "number skeleton: \"" + token + "\" names no numbering system" when option == ""
					o.numberingSystem = option
				case "unit-width-narrow":
					o.unitDisplay = UnitDisplay.Narrow
					o.currencyDisplay = CurrencyDisplay.NarrowSymbol
				case "unit-width-short":
					o.unitDisplay = UnitDisplay.Short
					o.currencyDisplay = CurrencyDisplay.Symbol
				case "unit-width-full-name":
					o.unitDisplay = UnitDisplay.Long
					o.currencyDisplay = CurrencyDisplay.Name
				case "unit-width-iso-code":
					o.currencyDisplay = CurrencyDisplay.Code
				case "sign-always", "+!":
					o.signDisplay = SignDisplay.Always
				case "sign-never", "+_":
					o.signDisplay = SignDisplay.Never
				case "sign-except-zero", "+?":
					o.signDisplay = SignDisplay.ExceptZero
				case "sign-negative", "+-":
					o.signDisplay = SignDisplay.Negative
				case "sign-accounting", "()":
					o.currencySign = CurrencySign.Accounting
				case "sign-accounting-always", "()!":
					o.currencySign = CurrencySign.Accounting
					o.signDisplay = SignDisplay.Always
				case "sign-accounting-except-zero", "()?":
					o.currencySign = CurrencySign.Accounting
					o.signDisplay = SignDisplay.ExceptZero
				case "sign-accounting-negative", "()-":
					o.currencySign = CurrencySign.Accounting
					o.signDisplay = SignDisplay.Negative
				default:
					if stem.startsWith(".") {
						let digits = stem[1:]
						let open = digits.endsWith("+") || digits.endsWith("*")
						digits = digits[:digits.len() - 1] when open
						fail unknown unless digits.trimStart("0").trim("#") == ""
						o.minimumFractionDigits = digits.count("0")
						o.maximumFractionDigits = open ?? (100, digits.len())
						precise = true
						if option == "w" {
							o.trailingZeros = TrailingZeros.StripIfInteger
						} else if option != "" {
							fail unsupported
						}
					} else if stem.startsWith("@") {
						let open = stem.endsWith("+") || stem.endsWith("*")
						let digits = open ?? (stem[:stem.len() - 1], stem)
						fail unknown unless digits.trimStart("@").trim("#") == "" && option == ""
						o.minimumSignificantDigits = digits.count("@")
						o.maximumSignificantDigits = open ?? (21, digits.len())
						precise = true
					} else if stem.trim("0") == "" && option == "" {
						o.minimumIntegerDigits = stem.len()
					} else if stem.startsWith("E") {
						fail unsupported
					} else {
						fail unknown
					}
			}
		}
		if scale == 100 && o.kind == NumberKind.Unit && o.unit == "percent" {
			o.kind = NumberKind.Percent
			o.unit = ""
		} else if scale != 1 {
			fail "number skeleton: \"scale/{scale}\" is not supported"
		}
		// Without a precision ICU writes up to six fraction digits, money with
		// its currency's digits, and compact numbers as the notation rounds them.
		if !precise && o.kind != NumberKind.Currency && o.notation != Notation.Compact {
			o.minimumFractionDigits = 0
			o.maximumFractionDigits = 6
		}
		return o
	}
}
