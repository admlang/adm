partial module std.i18n {
	use (
		std.i18n.rbnf
		std.math::(Decimal)
	)

	// SpellOut writes numbers in words, or as ordinals and in other
	// rule-based forms, by the locale's CLDR rules:
	//
	//     new SpellOut(new Locale("en")).format(123)                       // "one hundred twenty-three"
	//     new SpellOut(new Locale("en"), "%spellout-ordinal").format(21)   // "twenty-first"
	//     new SpellOut(new Locale("en"), "%digits-ordinal").format(21)     // "21st"
	//     new SpellOut(new Locale("fr"), "%spellout-cardinal-feminine").format(1)   // "une"
	//
	// ruleSets() lists the rule sets a locale has (gendered, case and year
	// forms differ by language). A rule set the locale lacks writes digits.
	type SpellOut {
		locale  Locale
		ruleSet string

		internal data    string
		internal symbols rbnf.Symbols

		// New formats with the named rule set; the default, %spellout-numbering,
		// is the one every language has (gendered languages name their cardinals
		// %spellout-cardinal-masculine and so on).
		def new(locale Locale, ruleSet string = "%spellout-numbering") {
			self.locale = locale
			self.ruleSet = ruleSet.startsWith("%") ?? (ruleSet, "%" + ruleSet)
			data = dataLocaleOf(locale)
			// Rule text writes digits with the locale's Latin-digit symbols, as ICU does.
			let s = new NumberFormat(locale.withKeyword("nu", "latn")).symbols()
			symbols = rbnf.Symbols{decimal: s.decimal, group: s.group}
		}

		// Format writes the integer.
		def format(value int) string {
			return rbnf.format(data, ruleSet, new Decimal(value), symbols)
		}

		// Format writes the integer.
		def format(value bigint) string {
			return rbnf.format(data, ruleSet, new Decimal(value, 0), symbols)
		}

		// Format writes the float through its shortest decimal form.
		def format(value float) string {
			return rbnf.format(data, ruleSet, new Decimal(value), symbols)
		}

		// Format writes the decimal; its fraction is spelled digit by digit
		// where the rules spell fractions ("one point two five").
		def format(value Decimal) string {
			return rbnf.format(data, ruleSet, value, symbols)
		}

		// RuleSets returns the public rule sets of the locale:
		// "%spellout-cardinal", "%spellout-ordinal", "%spellout-numbering-year",
		// "%digits-ordinal", and the gendered and case forms its language has.
		def ruleSets() string[] {
			return rbnf.sets.names(data)
		}
	}
}
