partial module std.i18n {
	use (
		std.testing
		std.math::(Decimal)
	)

	// Expected values from ICU 77's RBNF engine over the CLDR 48.2.3 rules.
	check "Spell-out" {
		@test()
		def spellsNumbers() {
			let en = new Locale("en")
			assert new SpellOut(en).format(123) == "one hundred twenty-three"
			assert new SpellOut(en, "%spellout-ordinal").format(21) == "twenty-first"
			assert new SpellOut(en, "%spellout-ordinal").format(100) == "one hundredth"
			assert new SpellOut(en, "%digits-ordinal").format(22) == "22nd"
			assert new SpellOut(en, "spellout-numbering-year").format(1999) == "nineteen ninety-nine"
			assert new SpellOut(en, "%spellout-numbering-year").format(2005) == "two thousand five"
			assert new SpellOut(en).format(new Decimal(314, -2)) == "three point one four"
			assert new SpellOut(en).format(-5) == "minus five"
			let fr = new SpellOut(new Locale("fr"), "%spellout-cardinal-feminine")
			assert fr.format(1) == "une" && fr.format(21) == "vingt-et-une" && fr.format(80) == "quatre-vingts"
			assert new SpellOut(new Locale("zh")).format(1999) == "一千九百九十九"
			assert new SpellOut(en, "%no-such-rules").format(42) == "42"
		}

		@test()
		def listsRuleSets() {
			let sets = new SpellOut(new Locale("de")).ruleSets()
			assert sets.includes("%spellout-numbering") && sets.includes("%spellout-cardinal-masculine") && sets.includes("%spellout-ordinal-r") && sets.includes("%digits-ordinal")
			assert !sets.includes("%%ste") && !sets.includes("%roman-upper")
			assert new SpellOut(new Locale("de")).format(21) == "ein\u00adund\u00adzwanzig"
		}

		@test()
		def writesAlgorithmicNumberingSystems() {
			assert new NumberFormat(new Locale("en-u-nu-roman")).format(1999) == "MCMXCIX"
			assert new NumberFormat(new Locale("he-u-nu-hebr")).format(15) == "ט״ו"
			assert new NumberFormat(new Locale("he-u-nu-hebr")).format(1999) == "א׳תתקצ״ט"
			assert new NumberFormat(new Locale("zh-u-nu-hans")).format(1999) == "一千九百九十九"
		}
	}
}
