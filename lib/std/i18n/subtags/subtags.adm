// Locale tag rules over plain subtags: canonicalization with the CLDR alias
// tables, likely subtags (UTS #35 Add/Remove Likely Subtags), the data
// locale a tag reads its formats from, and the CLDR language matching
// distance.

internal partial module std.i18n.subtags {
	use std.i18n.cldr::(tables)

	// Tag is a locale's language, script, region and variants, cased as
	// BCP 47 writes them: "sr", "Latn", "RS", ["ekavsk"]. An absent subtag is
	// "" ("und" for the language).
	struct Tag {
		language string
		script   string
		region   string
		variants string[]
	}

	// Supplemental returns a value from a CLDR supplemental file, or "".
	def supplemental(file string, path string) string {
		let v = tables.value("supplemental/" + file, "root", path)
		return "" when v is none
		return v
	}

	// Join writes the subtags present, separated by "-".
	def join(language string, script string, region string) string {
		let out = language
		out += "-" + script when script != ""
		out += "-" + region when region != ""
		return out
	}

	// Canonicalize replaces deprecated and overlong subtags with their
	// preferred forms, in place.
	def canonicalize(t Tag) {
		// Language aliases keyed with a variant ("art-lojban", "hy-arevmda").
		for let i in 0..t.variants.len() {
			let rep = alias("languageAlias", t.language + "-" + t.variants[i])
			if rep != "" {
				t.variants.remove(i)
				applyLanguage(t, rep)
				break
			}
		}
		if t.region != "" {
			let rep = alias("languageAlias", t.language + "-" + t.region)
			if rep != "" {
				t.region = ""
				applyLanguage(t, rep)
			}
		}
		let rep = alias("languageAlias", t.language)
		applyLanguage(t, rep) when rep != ""
		if t.script != "" {
			let s = alias("scriptAlias", t.script)
			t.script = s when s != ""
		}
		if t.region != "" {
			let r = alias("territoryAlias", t.region)
			t.region = pickRegion(t, r) when r != ""
		}
		for let i in 0..t.variants.len() {
			let v = alias("variantAlias", t.variants[i])
			t.variants[i] = v when v != ""
		}
		t.variants.sort((a, b) => a < b)
	}

	def alias(kind string, key string) string {
		return supplemental("aliases", "metadata/alias/" + kind + "/" + key + "/_replacement")
	}

	// Applies a language alias replacement ("sr-Latn", "nb"): its language
	// always, its script and region only where the tag has none.
	def applyLanguage(t Tag, replacement string) {
		let parts = replacement.split("-")
		t.language = parts[0]
		for let i in 1..parts.len() {
			let p = parts[i]
			if p.len() == 4 && t.script == "" {
				t.script = p
			} else if p.len() != 4 && t.region == "" {
				t.region = p
			}
		}
	}

	// A territory alias may name several regions (the Soviet Union, "SU"):
	// the one the language is most likely spoken in, else the first.
	def pickRegion(t Tag, replacement string) string {
		let regions = replacement.split(" ")
		return regions[0] when regions.len() == 1
		let likely = maximize(Tag{language: t.language, script: t.script, variants: string[]})
		for let r in regions {
			return r when r == likely.region
		}
		return regions[0]
	}

	// Maximize fills in the script and region the language is most likely
	// written in and used in ("zh" -> "zh-Hans-CN", "und-TW" -> "zh-Hant-TW").
	def maximize(t Tag) Tag {
		let out = Tag{language: t.language, script: t.script, region: t.region, variants: t.variants}
		let lang = t.language == "" ?? ("und", t.language)
		let keys = string[
			join(lang, t.script, t.region),
			join(lang, "", t.region),
			join(lang, t.script, ""),
			lang,
			join("und", t.script, ""),
		]
		for let k in keys {
			let found = supplemental("likelySubtags", "likelySubtags/" + k)
			if found != "" {
				let parts = found.split("-")
				if out.language := "" || "und" {
					out.language = parts[0]
				}
				out.script = parts[1] when out.script == "" && parts.len() > 1
				out.region = parts[2] when out.region == "" && parts.len() > 2
				return out
			}
		}
		return out
	}

	// Minimize drops the script and region that maximize would add back,
	// keeping the region over the script when one of them must stay.
	def minimize(t Tag) Tag {
		let max = maximize(t)
		let trials = Tag[
			Tag{language: max.language, variants: t.variants},
			Tag{language: max.language, region: max.region, variants: t.variants},
			Tag{language: max.language, script: max.script, variants: t.variants},
		]
		for let trial in trials {
			let m = maximize(trial)
			return trial when m.language == max.language && m.script == max.script && m.region == max.region
		}
		return Tag{language: max.language, script: max.script, region: max.region, variants: t.variants}
	}

	// DataLocale returns the CLDR locale holding the tag's formats: the most
	// specific one the tables have, else "root".
	def dataLocale(t Tag) string {
		let name = available(t)
		for {
			for let v in t.variants {
				return name + "-" + v.upper() when tables.has(name + "-" + v.upper())
				return name + "-" + v when tables.has(name + "-" + v)
			}
			return name when tables.has(name)
			let parts = name.split("-")
			return "root" when parts.len() == 1
			name = parts[:parts.len() - 1].join("-")
		}
	}

	// Available returns the locale ICU formats a tag with: the tag's language,
	// script and region, cut from the end until CLDR holds data for them or
	// lists them as default content ("fr-US" -> "fr", "vi-VN" stays); a tag
	// without a script that is held with its likely one names that locale
	// ("zh-TW" -> "zh-Hant-TW"), as ICU's alias locales do.
	def available(t Tag) string {
		let script = t.script
		let region = t.region
		for {
			let name = join(t.language, script, region)
			return name when holds(name)
			if script == "" && region != "" {
				let likely = maximize(Tag{language: t.language, region: region, variants: string[]}).script
				let full = join(t.language, likely, region)
				return full when holds(full)
			}
			if region != "" {
				region = ""
			} else if script != "" {
				script = ""
			} else {
				return name
			}
		}
	}

	// Whether CLDR holds data for the locale or lists it as default content.
	def holds(name string) bool {
		return true when tables.has(name)
		return defaultContent.has(name)
	}

	// DefaultContent is CLDR's default-content locale list, read once; atomic,
	// as tasks share it.
	type DefaultContent {
		names map<string, bool>
		ready bool

		atomic def has(name string) bool {
			if !ready {
				ready = true
				names = map<string, bool>{}
				for let n in supplementalList("defaultContent", "defaultContent") {
					names[n] = true
				}
			}
			return names.hasKey(name)
		}
	}

	let defaultContent = new DefaultContent()

	def supplementalList(section string, path string) string[] {
		let v = tables.value(section, "root", path)
		return string[] when v is none
		return v.split("\u001f")
	}

	// Rule is one CLDR language matching rule: subtag patterns for the
	// desired and supported locales and the distance when both match.
	struct Rule {
		desired   string[]
		supported string[]
		distance  int
		oneway    bool
	}

	// Matching holds the rules, the match variables and the paradigm locales,
	// read once.
	type Matching {
		rules     Rule[]
		variables map<string, string[]>
		paradigms string[]
		loaded    bool

		atomic def ready() Matching {
			if !loaded {
				loaded = true
				let base = "languageMatching/written-new/"
				let raw = tables.values("supplemental/languageMatching", "root", base + "languageMatch")
				rules = Rule[]
				let i = 0
				for raw.hasKey(i.str() + "/_desired") {
					let at = i.str() + "/"
					break unless raw.hasKey(at + "_desired") && raw.hasKey(at + "_supported") && raw.hasKey(at + "_distance")
					let r = Rule{desired: raw[at + "_desired"].split("-"), supported: raw[at + "_supported"].split("-"), oneway: raw.hasKey(at + "_oneway") && raw[at + "_oneway"] == "true"}
					r.distance = raw[at + "_distance"].toInt<int>()
					rules.push(r)
					i++
				}
				variables = map<string, string[]>{}
				let vars = tables.values("supplemental/languageMatching", "root", base + "matchVariables")
				for let (k, v) in vars {
					variables[k.split("/")[0].trimPrefix("$")] = v.split("+")
				}
				paradigms = string[]
				let ps = supplemental("languageMatching", base + "paradigmLocales/_locales")
				for let p in ps.split("\x1f") {
					let parts = p.split("-")
					let t = Tag{language: parts[0], variants: string[]}
					t.region = parts[1] when parts.len() > 1
					paradigms.push(key(maximize(t)))
				}
			}
			return self
		}
	}

	let matching = new Matching()

	def key(t Tag) string {
		return join(t.language, t.script, t.region)
	}

	// Distance is how far a supported locale is from a desired one, both
	// maximized: 0 for the same, 50 or more for no useful match.
	def distance(desired Tag, supported Tag) int {
		let m = matching.ready()
		let total = 0
		total += ruleDistance(m, string[desired.language], string[supported.language]) when desired.language != supported.language
		total += ruleDistance(m, string[desired.language, desired.script], string[supported.language, supported.script]) when desired.script != supported.script
		if desired.region != supported.region {
			let d = ruleDistance(m, string[desired.language, desired.script, desired.region], string[supported.language, supported.script, supported.region])
			// A paradigm locale is preferred over its siblings by one.
			if d > 0 && m.paradigms.includes(key(supported)) && !m.paradigms.includes(key(desired)) {
				d--
			}
			total += d
		}
		return total
	}

	def ruleDistance(m Matching, desired string[], supported string[]) int {
		for let r in m.rules {
			continue when r.desired.len() != desired.len()
			return r.distance when fits(m, r.desired, desired) && fits(m, r.supported, supported)
			return r.distance when !r.oneway && fits(m, r.desired, supported) && fits(m, r.supported, desired)
		}
		return 80
	}

	def fits(m Matching, patterns string[], subtags string[]) bool {
		for let i in 0..patterns.len() {
			let p = patterns[i]
			continue when p == "*"
			if p.startsWith("$!") {
				return false when inVariable(m, p[2:], subtags[i])
			} else if p.startsWith("$") {
				return false when !inVariable(m, p[1:], subtags[i])
			} else {
				return false when p != subtags[i]
			}
		}
		return true
	}

	def inVariable(m Matching, name string, region string) bool {
		return false unless m.variables.hasKey(name)
		for let r in m.variables[name] {
			return true when r == region || contains(r, region)
		}
		return false
	}

	// Contains reports whether the region group (a UN M.49 code such as
	// "019") includes the region, directly or through its subgroups.
	def contains(group string, region string) bool {
		let members = supplemental("territoryContainment", "territoryContainment/" + group + "/_contains")
		return false when members == ""
		for let m in members.split("\x1f") {
			return true when m == region || contains(m, region)
		}
		return false
	}
}
