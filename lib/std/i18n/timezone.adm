partial module std.i18n {
	use (
		std.i18n.tz
		std.os
		std.time::(Time, DateTime, fromUnixNs)
	)

	// Disambiguation says which instant a wall-clock time names when the
	// zone's clocks skip it (a gap) or show it twice (an overlap), as
	// Temporal's options do.
	enum Disambiguation {
		Compatible // a gap moves later by its length, an overlap takes the earlier instant
		Earlier    // the earlier of the two candidates (a gap moves earlier)
		Later      // the later of the two candidates (a gap moves later)
		Reject     // fail on a gap or an overlap
	}

	// TimeZone is a time zone by its IANA name, such as Europe/Berlin, or a
	// fixed offset from UTC ("+05:30"), with the zone's full history from the
	// embedded IANA database.
	//
	//     let berlin = new TimeZone("Europe/Berlin")
	//     berlin.offset(t)                     // 2h in summer, 1h in winter
	//     berlin.resolve(new DateTime(2026, 3, 29, 2, 30))   // 03:30 CEST: 02:30 does not exist
	type TimeZone {
		id string // IANA: "Europe/Berlin"; "UTC"; or an offset "+05:30"

		internal zone  ?tz.Zone
		internal fixed int // seconds east of UTC, for an offset id
		internal found bool

		// New takes an IANA zone or link name (matched without regard to case),
		// "UTC", or a fixed offset ("+05:30", "-08", "+0530"). An unknown id
		// gives UTC with known() false; use parseTimeZone to be told.
		def new(id string) {
			let ok = true
			let t = parseTimeZone(id) onerror (err error) {
				ok = false
				recover new TimeZone()
			}
			assign(t)
			if !ok {
				self.id = id
				found = false
			}
		}

		// New makes UTC.
		def new() {
			id = "UTC"
			found = true
		}

		internal def assign(t TimeZone) {
			id = t.id
			zone = t.zone
			fixed = t.fixed
			found = t.found
		}

		// Known reports whether the id named a zone or an offset.
		def known() bool {
			return found
		}

		// Offset returns how far the zone's clocks are ahead of UTC at the
		// instant (negative west of Greenwich).
		def offset(at Time) duration {
			return duration(int64(kindAt(at).offset) * 1000000000)
		}

		// Daylight reports whether the zone keeps daylight saving time at the
		// instant.
		def daylight(at Time) bool {
			return kindAt(at).dst
		}

		// Abbreviation returns the zone's abbreviation at the instant as the
		// IANA database spells it ("CEST", "EST", "+0530"); an offset zone
		// returns its id.
		def abbreviation(at Time) string {
			return id when zone is none
			return kindAt(at).abbrev
		}

		// DateTime returns the wall-clock reading of the instant in this zone.
		def dateTime(at Time) DateTime {
			return at.dateTime(offset(at))
		}

		// Resolve returns the instant a wall-clock time names in this zone.
		// Around a gap or an overlap the choice picks which (see
		// Disambiguation); fails only with Reject there.
		def resolve(local DateTime, choice Disambiguation = Disambiguation.Compatible) !Time {
			let wall = seconds(local.toTime())
			let nanos = int64(local.time.nanosecond)
			// Every offset that can apply near the wall time: those in force a
			// day either side, and the one at the naive guess.
			let before = kindOffset(wall - 86400)
			let after = kindOffset(wall + 86400)
			let candidates = int64[]
			for let o in int64[before, after, kindOffset(wall - before), kindOffset(wall - after)] {
				let instant = wall - o
				candidates.push(instant) when kindOffset(instant) == o && !candidates.includes(instant)
			}
			candidates.sort((a, b) => a < b)
			return toTime(candidates[0], nanos) when candidates.len() == 1
			if candidates.len() >= 2 {
				fail "time zone " + id + ": " + local.str() + " happens twice (clocks turn back)" when choice == Disambiguation.Reject
				let pick = choice == Disambiguation.Later ?? (candidates[candidates.len() - 1], candidates[0])
				return toTime(pick, nanos)
			}
			// A gap: the clocks skip this wall time.
			fail "time zone " + id + ": " + local.str() + " does not exist (clocks skip it)" when choice == Disambiguation.Reject
			let moved = choice == Disambiguation.Earlier ?? (wall - after, wall - before)
			return toTime(moved, nanos)
		}

		// NextTransition returns the next instant after at when the zone's
		// offset changes (as in Temporal: a new abbreviation alone is not one), or none (fixed offsets, and zones with
		// no more changes).
		def nextTransition(after Time) ?Time {
			let z = zone
			return none when z is none
			let t = tz.nextTransition(z, ceilSeconds(after))
			return none when t is none
			return toTime(t, 0)
		}

		// PreviousTransition returns the last instant before at when the zone's
		// offset changed, or none.
		def previousTransition(before Time) ?Time {
			let z = zone
			return none when z is none
			let t = tz.previousTransition(z, ceilSeconds(before))
			return none when t is none
			return toTime(t, 0)
		}

		// Canonical returns the zone's primary IANA name: a link resolves to
		// its zone ("Asia/Calcutta" is "Asia/Kolkata").
		def canonical() string {
			return id when zone is none
			return tz.canonical(id)
		}

		// Equals reports whether both name the same zone (links resolved) or
		// the same offset.
		def equals(other TimeZone) bool {
			return canonical() == other.canonical()
		}

		// Str returns the id.
		def str() string {
			return id
		}

		internal def kindAt(at Time) tz.Kind {
			let z = zone
			return tz.Kind{offset: fixed, abbrev: id} when z is none
			return tz.kindAt(z, seconds(at))
		}

		internal def kindOffset(t int64) int64 {
			let z = zone
			return int64(fixed) when z is none
			return int64(tz.kindAt(z, t).offset)
		}
	}

	// parseTimeZone reads an IANA zone or link name (any case), "UTC", "Z",
	// or a fixed offset "+05:30", "-08", "+0530", "+05:30:15". Fails on
	// anything else.
	def parseTimeZone(id string) !TimeZone {
		let s = id.trim()
		if s := "UTC" || "utc" || "Z" || "z" {
			return utcZone()
		}
		if s.startsWith("+") || s.startsWith("-") {
			let seconds = try offsetSeconds(s)
			let t = utcZone()
			t.id = formatOffset(seconds)
			t.fixed = seconds
			return t
		}
		let found = tz.find(s)
		fail "time zone \"" + id + "\": not in the IANA database " + tz.release() when found is none
		let (zone, name) = found
		let t = utcZone()
		t.id = name
		t.zone = zone
		return t
	}

	// systemTimeZone returns the zone the system runs in: the TZ variable
	// (an IANA name, ":Europe/Berlin", or a POSIX rule string with its offsets),
	// then the zone the /etc/localtime link points at, then /etc/timezone; UTC
	// when none names a zone.
	def systemTimeZone() TimeZone {
		let fromEnv = envTZ.trimPrefix(":")
		if fromEnv != "" {
			let t = parseTimeZone(fromEnv) onerror recover utcZone()
			return t when t.found && (t.id != "UTC" || (fromEnv := "UTC" || "Etc/UTC"))
		}
		let linked = zoneOfLink(os.readLink("/etc/localtime") onerror recover "")
		if linked != "" {
			let t = parseTimeZone(linked) onerror recover utcZone()
			return t when t.found
		}
		let text = os.readFile("/etc/timezone") onerror recover byte[]
		let name = string(text).trim()
		if name != "" {
			let t = parseTimeZone(name) onerror recover utcZone()
			return t when t.found
		}
		return utcZone()
	}

	// timeZoneNames returns every zone of the IANA database by its primary
	// name (links left out), sorted.
	def timeZoneNames() string[] {
		return tz.names()
	}

	// timeZoneRelease returns the IANA database release embedded ("2026e").
	def timeZoneRelease() string {
		return tz.release()
	}

	@env("TZ")
	internal const envTZ string

	// zoneOfLink is the IANA name in a zoneinfo path such as
	// "../usr/share/zoneinfo/Europe/Berlin" or
	// "/var/db/timezone/zoneinfo/posix/Europe/Berlin"; empty when the path
	// holds no zoneinfo folder.
	internal def zoneOfLink(target string) string {
		let at = target.indexOf("zoneinfo/")
		return "" when at < 0
		let name = target.slice(at + 9)
		return name.trimPrefix("posix/").trimPrefix("right/")
	}

	internal def utcZone() TimeZone {
		return new TimeZone()
	}

	internal def seconds(at Time) int64 {
		let ns = at.unixNs()
		let s = ns / 1000000000
		return s - (ns % 1000000000 < 0 ?? (1, 0))
	}

	internal def ceilSeconds(at Time) int64 {
		let ns = at.unixNs()
		let s = ns / 1000000000
		return s + (ns % 1000000000 > 0 ?? (1, 0))
	}

	internal def toTime(seconds int64, nanos int64) Time {
		return fromUnixNs(seconds * 1000000000 + nanos)
	}

	// "+05:30" in seconds; fails unless it is ±hh, ±hhmm, ±hh:mm or ±hh:mm:ss
	// within a day.
	internal def offsetSeconds(s string) !int {
		let sign = s.startsWith("-") ?? (-1, 1)
		let body = s[1:].replace(":", "")
		fail "offset \"" + s + "\": expected ±hh, ±hh:mm or ±hh:mm:ss" when !(body.len() := 2 || 4 || 6) || !body.isNumeric()
		let h = body[0:2].toInt<int>()
		let m = body.len() >= 4 ?? (body[2:4].toInt<int>(), 0)
		let sec = body.len() == 6 ?? (body[4:6].toInt<int>(), 0)
		fail "offset \"" + s + "\": out of range" when h > 23 || m > 59 || sec > 59
		return sign * (h * 3600 + m * 60 + sec)
	}

	internal def formatOffset(seconds int) string {
		let sign = seconds < 0 ?? ("-", "+")
		let s = seconds < 0 ?? (-seconds, seconds)
		let out = sign + twoDigits(s / 3600) + ":" + twoDigits(s / 60 % 60)
		return s % 60 == 0 ?? (out, out + ":" + twoDigits(s % 60))
	}

	internal def twoDigits(n int) string {
		return n < 10 ?? ("0" + n.str(), n.str())
	}
}
