partial module std.i18n {
	use (
		std.testing
		std.time::(DateTime, parse as parseTime)
	)

	// Expected values from Temporal (node 26.10) and the IANA database.
	check "Time zones" {
		@test()
		def readsIds() !none {
			let berlin = new TimeZone("europe/berlin")
			assert berlin.known() && berlin.id == "Europe/Berlin"
			let calcutta = new TimeZone("Asia/Calcutta")
			assert calcutta.id == "Asia/Calcutta" && calcutta.canonical() == "Asia/Kolkata"
			assert calcutta.equals(new TimeZone("Asia/Kolkata"))
			assert (try parseTimeZone("+0530")).id == "+05:30"
			assert (try parseTimeZone("-08")).id == "-08:00"
			assert (try parseTimeZone("Z")).id == "UTC"
			assert parseTimeZone("Mars/Olympus") is error
			assert parseTimeZone("+25:00") is error
			let unknown = new TimeZone("Mars/Olympus")
			assert !unknown.known() && unknown.id == "Mars/Olympus"
			assert unknown.offset(try parseTime("2026-07-01T00:00:00Z")) == 0s
			return none
		}

		@test()
		def knowsOffsetsAndAbbreviations() !none {
			let summer = try parseTime("2026-07-01T12:00:00Z")
			let winter = try parseTime("2026-01-01T12:00:00Z")
			let berlin = new TimeZone("Europe/Berlin")
			assert berlin.offset(summer) == 2h && berlin.offset(winter) == 1h
			assert berlin.daylight(summer) && !berlin.daylight(winter)
			assert berlin.abbreviation(summer) == "CEST" && berlin.abbreviation(winter) == "CET"
			assert new TimeZone("Asia/Kolkata").offset(summer) == 5h + 30m
			let lordHowe = new TimeZone("Australia/Lord_Howe")
			assert lordHowe.offset(summer) == 10h + 30m && lordHowe.offset(winter) == 11h
			assert new TimeZone("+05:30").offset(summer) == 5h + 30m
			assert new TimeZone("+05:30").abbreviation(summer) == "+05:30"
			assert berlin.dateTime(summer).str() == "2026-07-01T14:00:00"
			return none
		}

		@test()
		def findsTransitions() !none {
			let berlin = new TimeZone("Europe/Berlin")
			let now = try parseTime("2026-10-02T10:00:00Z")
			let previous = berlin.previousTransition(now)
			assert !(previous is none) && previous.str() == "2026-03-29T01:00:00Z"
			let next = berlin.nextTransition(now)
			assert !(next is none) && next.str() == "2026-10-25T01:00:00Z"
			assert new TimeZone("+05:30").nextTransition(now) is none
			assert new TimeZone("Asia/Kolkata").nextTransition(now) is none
			return none
		}

		@test()
		def resolvesWallTimes() !none {
			let berlin = new TimeZone("Europe/Berlin")
			let gap = new DateTime(2026, 3, 29, 2, 30)
			assert (try berlin.resolve(gap)).str() == "2026-03-29T01:30:00Z"
			assert (try berlin.resolve(gap, Disambiguation.Earlier)).str() == "2026-03-29T00:30:00Z"
			assert berlin.resolve(gap, Disambiguation.Reject) is error
			let overlap = new DateTime(2026, 10, 25, 2, 30)
			assert (try berlin.resolve(overlap)).str() == "2026-10-25T00:30:00Z"
			assert (try berlin.resolve(overlap, Disambiguation.Later)).str() == "2026-10-25T01:30:00Z"
			assert berlin.resolve(overlap, Disambiguation.Reject) is error
			assert (try berlin.resolve(new DateTime(2026, 7, 1, 12))).str() == "2026-07-01T10:00:00Z"
			return none
		}

		@test()
		def listsZones() {
			let names = timeZoneNames()
			assert names.includes("Europe/Berlin") && names.includes("America/New_York")
			assert !names.includes("Asia/Calcutta")
			assert timeZoneRelease() == "2026e"
			assert systemTimeZone().known()
		}

		// The zone named by an /etc/localtime link target.
		@test()
		def readsZoneLinks() {
			assert zoneOfLink("../usr/share/zoneinfo/Europe/Bucharest") == "Europe/Bucharest"
			assert zoneOfLink("/usr/share/zoneinfo/UTC") == "UTC"
			assert zoneOfLink("/var/db/timezone/zoneinfo/posix/America/New_York") == "America/New_York"
			assert zoneOfLink("/usr/share/zoneinfo/right/Asia/Tokyo") == "Asia/Tokyo"
			assert zoneOfLink("/etc/elsewhere") == ""
		}
	}
}
