partial module std.i18n {
	use std.reflection::(FieldReadMetaContext)

	// Makes the annotated field translated text: every read returns the
	// message `key` in the current language, or in `lang` (BCP 47 `en-US` or
	// POSIX `en_US`) when given, with `params` filled in. The field's own value
	// is the source text and what a read returns when no catalog has the key.
	// `params` are evaluated on each read, in the field's scope.
	meta def translate(ctx FieldReadMetaContext, key string, params map<string, any> = {}, lang string = "") {
		// The catalog lookup comes with the I18n service (docs/requirements/i18n.md,
		// phase 2); until then no catalog has the key and the read keeps the field's
		// own value.
	}
}
