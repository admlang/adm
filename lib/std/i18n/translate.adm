partial module std.i18n {
	use (
		std.reflection::(FieldReadMetaContext)
		std.services.i18n::(I18n)
	)

	// Makes the annotated field translated text: every read returns the
	// message `key` from the catalogs of the `I18n` service, in the language
	// in use, or in `lang` (BCP 47 `en-US` or POSIX `en_US`) when given, with
	// `params` written in. The field's own value is the source text: what a
	// read returns, with `params` written in, when no catalog has the key.
	// `params` are evaluated on each read, in the field's scope.
	//
	//     @translate("basket.count", params = {"count": items.len()})
	//     summary string = "{count, plural, one{# item} other{# items}}"
	//
	// Nothing is stored: a read after `I18n.setLanguage` returns the text in
	// the new language. Numbers and dates in the text are written as the
	// region in use writes them. A field a library declares is looked up in
	// the library's own catalogs first, then in the application's.
	meta def translate(ctx FieldReadMetaContext, key string, params map<string, any> = {}, lang string = "") {
		let held = ctx.value()
		if held is string {
			ctx.resolve(I18n.textIn(ctx.descriptor.moduleNode.qualifiedName, key, held, params, lang))
		}
	}
}
