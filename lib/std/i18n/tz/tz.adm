// The IANA time zone database (tools/i18n/gen_tz.py), embedded and decoded on
// first use: each zone's transitions and offset types, and the POSIX TZ rule
// (with the RFC 8536 extensions) for instants past its last transition.

internal partial module std.i18n.tz {
	use (
		std.io
		std.bytes
		std.data.compress.flate
		std.time::(daysInMonth, fromEpochDay, Date)
	)

	@embed("tz.bin")
	const blob byte[]

	// Kind is one offset a zone uses: seconds east of UTC, whether it is
	// daylight saving time, and its abbreviation.
	struct Kind {
		offset int
		dst    bool
		abbrev string
	}

	// Zone is one zone's history.
	struct Zone {
		name  string
		kinds Kind[]
		times int64[] // transition instants, seconds since 1970, ascending
		types int[] // the kind in force from each transition
		rule  ?Rule // after the last transition, or none
	}

	// Rule is a POSIX TZ rule: a standard offset and, when the zone keeps
	// daylight time, the daylight offset and the two yearly changes.
	struct Rule {
		standard Kind
		daylight ?Kind
		start    Change // into daylight time
		end      Change // back to standard time
	}

	// Change is a POSIX TZ date and time of day: Mm.w.d (month, week 1 to 5
	// where 5 is the last, weekday 0 Sunday), Jn (1 to 365, February 29 never
	// counted) or n (0 to 365). seconds is the local time of the change, which
	// may be below 0 or past a day.
	struct Change {
		form    int // 0 Mm.w.d, 1 Jn, 2 n
		month   int
		week    int
		weekday int
		day     int
		seconds int
	}

	// Database holds the decoded zones; every method is atomic.
	type Database {
		ready   bool
		release string
		zones   map<string, Zone>
		links   map<string, string>
		folded  map<string, string> // lower-case id -> zone or link name

		atomic def load() Database {
			return self when ready
			ready = true
			zones = map<string, Zone>{}
			links = map<string, string>{}
			folded = map<string, string>{}
			let raw = io.readAll(new flate.Reader(new bytes.Reader(blob))) onerror recover byte[]
			let r = new Cursor(raw)
			r.pos = 8
			release = r.text()
			let count = r.varint()
			for let _ in 0..count {
				let z = Zone{name: r.text(), kinds: Kind[], times: int64[], types: int[]}
				let ruleText = r.text()
				let kinds = r.varint()
				for let _ in 0..kinds {
					let offset = r.signed()
					let dst = r.byte() != 0
					z.kinds.push(Kind{offset: int(offset), dst: dst, abbrev: r.text()})
				}
				let transitions = r.varint()
				let at = int64(0)
				for let _ in 0..transitions {
					at += r.signed()
					z.times.push(at)
					z.types.push(r.varint())
				}
				r.varint()
				z.rule = parseRule(ruleText) when ruleText != ""
				zones[z.name] = z
				folded[z.name.lower()] = z.name
			}
			let linkCount = r.varint()
			for let _ in 0..linkCount {
				let alias = r.text()
				let target = r.text()
				links[alias] = target
				folded[alias.lower()] = alias
			}
			return self
		}
	}

	let database = new Database()

	// Find returns the zone an id names, matched without regard to case and
	// through links, with the id spelled as the database spells it; or none.
	def find(id string) ?(Zone, string) {
		let db = database.load()
		let name = db.folded.get(id.lower())
		return none when name is none
		let target = db.links.get(name)
		let zoneName = target is none ?? (name, target)
		let z = db.zones.get(zoneName)
		return none when z is none
		return (z, name)
	}

	// Canonical returns the zone a link names, or the name itself.
	def canonical(name string) string {
		let db = database.load()
		let target = db.links.get(name)
		return name when target is none
		return target
	}

	// Names returns every zone name (not links), sorted.
	def names() string[] {
		let db = database.load()
		let out = db.zones.keys()
		out.sort((a, b) => a < b)
		return out
	}

	def release() string {
		return database.load().release
	}

	// KindAt returns the offset in force at an instant (seconds since 1970).
	def kindAt(z Zone, t int64) Kind {
		let n = z.times.len()
		if n == 0 || t >= z.times[n - 1] {
			let rule = z.rule
			return ruleKind(rule, t) unless rule is none
			return n == 0 ?? (z.kinds[0], z.kinds[z.types[n - 1]])
		}
		// RFC 8536: before the first transition the first kind applies.
		return z.kinds[0] when t < z.times[0]
		let lo = 0
		let hi = n
		for lo < hi {
			let mid = (lo + hi) / 2
			if z.times[mid] <= t {
				lo = mid + 1
			} else {
				hi = mid
			}
		}
		return z.kinds[z.types[lo - 1]]
	}

	// NextTransition returns the first instant after t at which the offset
	// changes, or none.
	def nextTransition(z Zone, t int64) ?int64 {
		let n = z.times.len()
		for let i in 0..n {
			if z.times[i] > t {
				// A transition that changes nothing (zic writes some) is skipped.
				let before = i == 0 ?? (z.kinds[0], z.kinds[z.types[i - 1]])
				let after = z.kinds[z.types[i]]
				return z.times[i] unless sameKind(before, after)
			}
		}
		let rule = z.rule
		return none when rule is none || rule.daylight is none
		let from = n == 0 ?? (t, t > z.times[n - 1] ?? (t, z.times[n - 1]))
		let year = yearOf(from + int64(rule.standard.offset))
		for let y in year..year + 2 {
			let (start, end) = ruleChanges(rule, y)
			let first = start < end ?? (start, end)
			let second = start < end ?? (end, start)
			return first when first > from && first > t
			return second when second > from && second > t
		}
		return none
	}

	// PreviousTransition returns the last instant before t at which the offset
	// changed, or none.
	def previousTransition(z Zone, t int64) ?int64 {
		let n = z.times.len()
		let rule = z.rule
		if !(rule is none) && !(rule.daylight is none) && (n == 0 || t > z.times[n - 1]) {
			// The latest rule change before t, if it is after the last explicit
			// transition.
			let year = yearOf(t + int64(rule.standard.offset))
			let floor = n == 0 ?? (int64(-9223372036854775807), z.times[n - 1])
			let found = floor
			for let y in year - 1..year + 1 {
				let (start, end) = ruleChanges(rule, y)
				found = start when start < t && start > found
				found = end when end < t && end > found
			}
			return found when found > floor
		}
		let i = n - 1
		for i >= 0 {
			if z.times[i] < t {
				let before = i == 0 ?? (z.kinds[0], z.kinds[z.types[i - 1]])
				let after = z.kinds[z.types[i]]
				return z.times[i] unless sameKind(before, after)
			}
			i--
		}
		return none
	}

	// Whether two kinds keep the clocks where they are; as in Temporal, a change
	// of abbreviation or daylight flag alone is not a transition.
	def sameKind(a Kind, b Kind) bool {
		return a.offset == b.offset
	}

	// The kind a POSIX rule gives at an instant.
	def ruleKind(rule Rule, t int64) Kind {
		let daylight = rule.daylight
		return rule.standard when daylight is none
		let year = yearOf(t + int64(rule.standard.offset))
		// The changes of the instant's year and its neighbours decide; the
		// latest change at or before t wins.
		let best = int64(0)
		let inDst = false
		let any = false
		for let y in year - 1..year + 2 {
			let (start, end) = ruleChanges(rule, y)
			if start <= t && (!any || start > best) {
				best = start
				inDst = true
				any = true
			}
			if end <= t && (!any || end > best) {
				best = end
				inDst = false
				any = true
			}
		}
		return inDst ?? (daylight, rule.standard)
	}

	// The instants of a year's change into daylight time and back.
	def ruleChanges(rule Rule, year int) (int64, int64) {
		let daylight = rule.daylight
		let dstOffset = daylight is none ?? (rule.standard.offset, daylight.offset)
		let start = changeDay(rule.start, year) * 86400 + int64(rule.start.seconds) - int64(rule.standard.offset)
		let end = changeDay(rule.end, year) * 86400 + int64(rule.end.seconds) - int64(dstOffset)
		return (start, end)
	}

	// The day (since 1970) a change falls on in a year.
	def changeDay(c Change, year int) int64 {
		let jan1 = new Date(year, 1, 1).epochDay()
		if c.form == 1 {
			// Jn: February 29 is never counted.
			let leapShift = (daysInMonth(year, 2) == 29 && c.day > 59) ?? (1, 0)
			return jan1 + int64(c.day - 1 + leapShift)
		}
		return jan1 + int64(c.day) when c.form == 2
		let first = new Date(year, c.month, 1)
		let firstWeekday = int(first.weekday())
		let day = 1 + (c.weekday - firstWeekday + 7) % 7 + (c.week - 1) * 7
		let last = daysInMonth(year, c.month)
		for day > last {
			day -= 7
		}
		return first.epochDay() + int64(day - 1)
	}

	def yearOf(t int64) int {
		let days = t / 86400 - (t % 86400 < 0 ?? (1, 0))
		return fromEpochDay(days).year
	}

	// ParseRule reads a POSIX TZ string such as "CET-1CEST,M3.5.0,M10.5.0/3",
	// "<+0330>-3:30" or "<-03>3<-02>,M3.5.0/-2,M10.5.0/-1".
	def parseRule(text string) Rule {
		let p = new RuleCursor(text)
		let stdName = p.name()
		let stdOffset = -p.clock()
		let rule = Rule{standard: Kind{offset: stdOffset, abbrev: stdName}}
		return rule when p.done()
		let dstName = p.name()
		let dstOffset = stdOffset + 3600
		dstOffset = -p.clock() when !p.done() && p.peek() != ","
		rule.daylight = Kind{offset: dstOffset, dst: true, abbrev: dstName}
		// POSIX defaults when the rule leaves out the dates (US rules).
		rule.start = Change{month: 3, week: 2, weekday: 0, seconds: 7200}
		rule.end = Change{month: 11, week: 1, weekday: 0, seconds: 7200}
		if p.peek() == "," {
			p.skip()
			rule.start = p.change()
			if p.peek() == "," {
				p.skip()
				rule.end = p.change()
			}
		}
		return rule
	}

	type RuleCursor {
		text string
		pos  int

		def new(text string) {
			self.text = text
		}

		def done() bool {
			return pos >= text.len()
		}

		def peek() string {
			return "" when done()
			return text[pos:pos + 1]
		}

		def skip() {
			pos++
		}

		def name() string {
			if peek() == "<" {
				let end = text.indexOf(">", pos)
				let n = text[pos + 1:end]
				pos = end + 1
				return n
			}
			let start = pos
			for !done() && text[pos:pos + 1].isAlpha() {
				pos++
			}
			return text[start:pos]
		}

		// [+-]hh[:mm[:ss]] in seconds.
		def clock() int {
			let sign = 1
			if peek() == "-" {
				sign = -1
				pos++
			} else if peek() == "+" {
				pos++
			}
			let total = number() * 3600
			if peek() == ":" {
				pos++
				total += number() * 60
				if peek() == ":" {
					pos++
					total += number()
				}
			}
			return sign * total
		}

		def number() int {
			let start = pos
			for !done() && text[pos:pos + 1].isNumeric() {
				pos++
			}
			return start == pos ?? (0, text[start:pos].toInt<int>())
		}

		def change() Change {
			let c = Change{seconds: 7200}
			if peek() == "M" {
				pos++
				c.month = number()
				pos++
				c.week = number()
				pos++
				c.weekday = number()
			} else if peek() == "J" {
				pos++
				c.form = 1
				c.day = number()
			} else {
				c.form = 2
				c.day = number()
			}
			if peek() == "/" {
				pos++
				c.seconds = clock()
			}
			return c
		}
	}

	// Cursor reads the varints and strings of the table.
	type Cursor {
		data byte[]
		pos  int

		def new(data byte[]) {
			self.data = data
		}

		def byte() int {
			let b = int(data[pos])
			pos++
			return b
		}

		def varint() int {
			let n = 0
			let shift = 0
			for pos < data.len() {
				let b = int(data[pos])
				pos++
				n |= (b & 0x7f) << shift
				return n when b < 0x80
				shift += 7
			}
			return n
		}

		def signed() int64 {
			let u = int64(0)
			let shift = 0
			for pos < data.len() {
				let b = int64(data[pos])
				pos++
				u |= (b & 0x7f) << shift
				break when b < 0x80
				shift += 7
			}
			return (u >> 1) ^ -(u & 1)
		}

		def text() string {
			let n = varint()
			let s = string(data[pos:pos + n])
			pos += n
			return s
		}
	}
}
