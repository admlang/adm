// Left out, changed in the tz releases since 2026c: America/Bogota, America/Edmonton, America/Inuvik, America/Rainy_River, America/Vancouver, America/Winnipeg, America/Yellowknife, Asia/Tehran, CST6CDT, Canada/Central, Canada/Mountain, Canada/Pacific, EST5EDT, Eire, Europe/Dublin, Iran, MST7MDT, PST8PDT.
partial module std.i18n {
	use (
		std.testing
		std.time::(fromUnixNs, parseDateTime, DateTime)
	)

	check "Time zones against Temporal" {
		def offsets(id string, times int64[], want int[]) int {
			let z = new TimeZone(id)
			let bad = 0
			for let i in 0..times.len() {
				let got = int(int64(z.offset(fromUnixNs(times[i] * 1000000000))) / 1000000000)
				if got != want[i] {
					println(id + " at {times[i]}: got {got} want {want[i]}")
					bad++
				}
			}
			return bad
		}

		def chain(id string, from int64, want int64[]) int {
			let z = new TimeZone(id)
			let at = fromUnixNs(from * 1000000000)
			for let i in 0..want.len() {
				let next = z.nextTransition(at)
				if next is none {
					println(id + " transition {i}: got none want {want[i]}")
					return 1
				}
				let s = next.unixNs() / 1000000000
				if s != want[i] {
					println(id + " transition {i}: got {s} want {want[i]}")
					return 1
				}
				at = next
			}
			return 0
		}

		def resolves(id string, wall string, want int64[], rejects bool) int {
			let z = new TimeZone(id)
			let local = parseDateTime(wall) onerror recover new DateTime(1970, 1, 1)
			let bad = 0
			let modes = Disambiguation[Disambiguation.Compatible, Disambiguation.Earlier, Disambiguation.Later]
			for let i in 0..3 {
				let t = z.resolve(local, modes[i]) onerror recover fromUnixNs(0)
				let s = t.unixNs() / 1000000000
				if s != want[i] {
					println(id + " " + wall + " mode {i}: got {s} want {want[i]}")
					bad++
				}
			}
			let failed = z.resolve(local, Disambiguation.Reject) is error
			if failed != rejects {
				println(id + " " + wall + " reject: got {failed}")
				bad++
			}
			return bad
		}

