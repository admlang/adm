partial module std.i18n {
	use std.time::(Time, Date, TimeOfDay, DateTime, parseDateTime, parse as parseInstant)

	// ZonedDateTime is an instant seen from a time zone: what a clock on the
	// wall there shows, kept exact through daylight saving changes.
	//
	//     let meeting = new ZonedDateTime(new DateTime(2026, 3, 28, 9), new TimeZone("Europe/Berlin"))
	//     meeting.plusDays(1).str()   // "2026-03-29T09:00:00+02:00[Europe/Berlin]" (same wall time)
	//     meeting.plus(24h).str()     // "2026-03-29T10:00:00+02:00[Europe/Berlin]" (24 hours later)
	type ZonedDateTime {
		instant Time
		zone    TimeZone

		def new(instant Time, zone TimeZone) {
			self.instant = instant
			self.zone = zone
		}

		// New makes the instant a wall-clock time names in the zone; a time the
		// clocks skip moves later by the gap, one they show twice is the earlier
		// (Disambiguation.Compatible). Use zone.resolve for another choice.
		def new(local DateTime, zone TimeZone) {
			instant = zone.resolve(local) onerror recover local.toTime()
			self.zone = zone
		}

		// DateTime returns the wall-clock date and time.
		def dateTime() DateTime {
			return zone.dateTime(instant)
		}

		// Date returns the wall-clock date.
		def date() Date {
			return dateTime().date
		}

		// TimeOfDay returns the wall-clock time.
		def timeOfDay() TimeOfDay {
			return dateTime().time
		}

		// Offset returns the zone's offset from UTC at this instant.
		def offset() duration {
			return zone.offset(instant)
		}

		// Plus returns the instant the duration later, in the same zone: exact
		// time, so across a change of offset the wall clock moves by more or
		// less than the duration.
		def plus(d duration) ZonedDateTime {
			return new ZonedDateTime(instant + d, zone)
		}

		// PlusDays returns the same wall-clock time n days later, resolved in
		// the zone (Compatible).
		def plusDays(n int) ZonedDateTime {
			let dt = dateTime()
			return new ZonedDateTime(new DateTime(dt.date.plusDays(n), dt.time), zone)
		}

		// PlusMonths returns the same wall-clock time n months later, the day
		// constrained to the month's length.
		def plusMonths(n int) ZonedDateTime {
			let dt = dateTime()
			return new ZonedDateTime(new DateTime(dt.date.plusMonths(n), dt.time), zone)
		}

		// PlusYears returns the same wall-clock time n years later.
		def plusYears(n int) ZonedDateTime {
			let dt = dateTime()
			return new ZonedDateTime(new DateTime(dt.date.plusYears(n), dt.time), zone)
		}

		// WithZone returns the same instant seen from another zone.
		def withZone(other TimeZone) ZonedDateTime {
			return new ZonedDateTime(instant, other)
		}

		// StartOfDay returns the first instant of this wall-clock day: midnight,
		// or the moment clocks start the day when they skip midnight.
		def startOfDay() ZonedDateTime {
			return new ZonedDateTime(new DateTime(date(), new TimeOfDay(0)), zone)
		}

		// LengthOfDay returns how long this wall-clock day is: 24h, or 23h and
		// 25h on the days clocks change.
		def lengthOfDay() duration {
			let start = startOfDay()
			let next = new ZonedDateTime(new DateTime(date().plusDays(1), new TimeOfDay(0)), zone)
			return next.instant - start.instant
		}

		// Compare returns -1, 0 or 1 as this instant is before, equal to or
		// after other's (the zones do not matter).
		def compare(other ZonedDateTime) int {
			return instant.compare(other.instant)
		}

		// Equals reports whether both are the same instant in the same zone.
		def equals(other ZonedDateTime) bool {
			return instant.equals(other.instant) && zone.equals(other.zone)
		}

		// Str writes RFC 9557: "2026-10-01T22:00:00+02:00[Europe/Berlin]".
		def str() string {
			return dateTime().str() + formatOffset(int(int64(offset()) / 1000000000)) + "[" + zone.id + "]"
		}
	}

	// parseZonedDateTime reads RFC 9557: a date-time, an optional offset and
	// a bracketed zone ("2026-10-01T22:00:00+02:00[Europe/Berlin]",
	// "2026-10-01T22:00[Europe/Berlin]"). Without an offset the wall time is
	// resolved in the zone (Compatible); with one, the offset must be one the
	// zone uses at that wall time. Fails on anything else.
	def parseZonedDateTime(text string) !ZonedDateTime {
		let s = text.trim()
		let open = s.indexOf("[")
		fail "zoned date-time \"" + text + "\": no [zone]" when open < 0 || !s.endsWith("]")
		let zone = try parseTimeZone(s[open + 1:s.len() - 1].trimPrefix("!"))
		let body = s[:open]
		let t = body.indexOf("T")
		t = body.indexOf(" ") when t < 0
		let offsetAt = -1
		if t >= 0 {
			for let i in t..body.len() {
				let c = body[i:i + 1]
				if c := "+" || "-" || "Z" || "z" {
					offsetAt = i
					break
				}
			}
		}
		if offsetAt < 0 {
			let local = try parseDateTime(body)
			return new ZonedDateTime(try zone.resolve(local), zone)
		}
		let local = try parseDateTime(body[:offsetAt])
		let mark = body[offsetAt:]
		let suffix = mark == "z" ?? ("Z", mark)
		let instant = try parseInstant(local.str() + suffix)
		// The offset must be one the zone has at that wall time.
		let ok = false
		for let choice in Disambiguation[Disambiguation.Earlier, Disambiguation.Later] {
			let candidate = zone.resolve(local, choice) onerror recover local.toTime()
			ok = true when candidate.equals(instant)
		}
		fail "zoned date-time \"" + text + "\": offset " + mark + " is not one " + zone.id + " uses then" when !ok && !(mark := "Z" || "z")
		return new ZonedDateTime(instant, zone)
	}
}
