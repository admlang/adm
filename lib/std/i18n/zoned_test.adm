partial module std.i18n {
	use (
		std.testing
		std.time::(DateTime, fromUnixNs)
	)

	// Expected values from Temporal (node 26.10).
	check "Zoned date-times" {
		@test()
		def keepsWallTimeOrExactTime() {
			let berlin = new TimeZone("Europe/Berlin")
			let meeting = new ZonedDateTime(new DateTime(2026, 3, 28, 9), berlin)
			assert meeting.plusDays(1).str() == "2026-03-29T09:00:00+02:00[Europe/Berlin]"
			assert meeting.plus(24h).str() == "2026-03-29T10:00:00+02:00[Europe/Berlin]"
			let ny = new ZonedDateTime(new DateTime(2026, 1, 31, 10), new TimeZone("America/New_York"))
			assert ny.plusMonths(1).str() == "2026-02-28T10:00:00-05:00[America/New_York]"
			assert ny.plusYears(1).date().str() == "2027-01-31"
			let tokyo = new ZonedDateTime(new DateTime(2026, 7, 1, 12), berlin).withZone(new TimeZone("Asia/Tokyo"))
			assert tokyo.str() == "2026-07-01T19:00:00+09:00[Asia/Tokyo]"
			assert tokyo.timeOfDay().hour == 19 && tokyo.offset() == 9h
			assert new ZonedDateTime(fromUnixNs(0), new TimeZone("Europe/Amsterdam")).str() == "1970-01-01T01:00:00+01:00[Europe/Amsterdam]"
		}

		@test()
		def knowsDays() {
			let sp = new ZonedDateTime(new DateTime(2018, 11, 4, 12), new TimeZone("America/Sao_Paulo"))
			assert sp.startOfDay().str() == "2018-11-04T01:00:00-02:00[America/Sao_Paulo]"
			assert sp.lengthOfDay() == 23h
			let berlin = new TimeZone("Europe/Berlin")
			assert new ZonedDateTime(new DateTime(2026, 10, 25, 12), berlin).lengthOfDay() == 25h
			assert new ZonedDateTime(new DateTime(2026, 3, 29, 12), berlin).lengthOfDay() == 23h
		}

		@test()
		def readsRfc9557() !none {
			let z = try parseZonedDateTime("2026-10-25T02:30+01:00[Europe/Berlin]")
			assert z.str() == "2026-10-25T02:30:00+01:00[Europe/Berlin]"
			let first = try parseZonedDateTime("2026-10-25T02:30[Europe/Berlin]")
			assert first.offset() == 2h
			assert parseZonedDateTime("2026-07-01T12:00+05:00[Europe/Berlin]") is error
			assert parseZonedDateTime("2026-07-01T12:00") is error
			assert (try parseZonedDateTime("2026-07-01T10:00Z[UTC]")).str() == "2026-07-01T10:00:00+00:00[UTC]"
			assert z.compare(first) == 1 && !z.equals(first)
			return none
		}
	}
}
