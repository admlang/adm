// The IDE channel's `call`: runs an action of a service's panel.

partial module std.ide {
	use (
		std.data.encoding::(JSON)
		std.reflection
		std.time
	)

	// Runs `<service> <action> <args>`, args a JSON object keyed by parameter
	// name ({} when the action takes none, or leaves every parameter at its
	// default), and answers what the action returned or why it failed.
	internal def callReply(rest string) string {
		let (svcName, more) = splitWord(rest)
		let (action, args) = splitWord(more)
		return errorReply("call needs a service and an action") when svcName == "" || action == ""
		let found = reflection.AttrHit[]
		for let (_, hit) in actionsOf(svcName) {
			found.push(hit) when hit.node.name == action
		}
		return errorReply("{svcName} has no action {action}") when found.len() == 0
		let fn = reflection.asFunction(found[0].node)
		return errorReply("{svcName}.{action} cannot be called") when fn is none
		let recv = reflection.serviceInstance(svcName)
		return errorReply("{svcName} is not linked into this program") when recv is none
		let given ?any = none
		if args.trim() != "" {
			let failure = ""
			given = JSON.parse(args) onerror (err error) {
				failure = err.message
				recover none
			}
			return errorReply("the arguments of {action} are not a JSON object: {failure}") unless failure == ""
		}
		let values = any[]
		for let (i, param) in fn.signature.parameters {
			let name = param.node.name
			let written ?any = none
			written = reflection.entryOf(given, name) unless given is none
			if written is none {
				let fallback = reflection.defaultOf(fn, i, values)
				return errorReply("{action} needs {name}") when fallback is none
				values.push(fallback)
				continue
			}
			let failure = ""
			let value = argumentValue(written, param.paramType) onerror (err error) {
				failure = err.message
				recover none
			}
			return errorReply("{name}: {failure}") unless failure == ""
			values.push(value)
		}
		let result = reflection.invoke(fn, recv, values)
		if result is error {
			let failed error = result
			return `{"kind":"result","service":` + quote(svcName) + `,"action":` + quote(action) + `,"ok":false,"error":{"message":` + quote(failed.message) + `,"code":` + quote(failed.code) + `}}`
		}
		return `{"kind":"result","service":` + quote(svcName) + `,"action":` + quote(action) + `,"ok":true,"value":` + encodeMemberValue(result) + `}`
	}

	// A JSON argument as a value of the parameter's type: text for a string,
	// a number for a number, true or false for a bool, a duration as written
	// ("150ms") or as milliseconds, an enum member by name.
	//
	// Fails when the value does not read as that type, or the type is not one
	// an action takes.
	internal def argumentValue(written any, typ reflection.TypeDescriptor) !any {
		let kind = paramKind(typ)
		let text = reflection.scalarText(written).trim()
		switch kind {
			case "string":
				return text
			case "bool":
				fail "{text} is not true or false" unless text == "true" || text == "false"
				return text == "true"
			case "int":
				fail "{text} is not a whole number" unless isWhole(text)
				return text.toInt<int64>()
			case "float":
				fail "{text} is not a number" unless isNumber(text)
				return parseFloat<float>(text)
			case "duration":
				if isWhole(text) {
					return duration(text.toInt<int64>() * 1000000)
				}
				return try time.parseDuration(text)
			case "enum":
				let tail = text.split(".").last()
				let name = tail is none ?? (text, tail)
				for let (_, member) in reflection.members(typ) {
					return member.value when member.node.name == name
				}
				fail "{text} is not one of the choices"
			default:
		}
		fail "an action cannot take a {typ.typeName}"
	}

	// Whether text is a whole number, with an optional sign.
	internal def isWhole(text string) bool {
		let digits = text.trimPrefix("-")
		return false when digits == ""
		for let (_, c) in digits {
			return false unless c.isDigit()
		}
		return true
	}

	// Whether text is a decimal number: a sign, digits, a point, an exponent.
	internal def isNumber(text string) bool {
		let seen = false
		for let (i, c) in text {
			if c.isDigit() {
				seen = true
				continue
			}
			continue when (c == '-' || c == '+') && (i == 0 || text[i - 1] == 'e' || text[i - 1] == 'E')
			continue when c == '.' || c == 'e' || c == 'E'
			return false
		}
		return seen
	}
}
