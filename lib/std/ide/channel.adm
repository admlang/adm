// The IDE channel's transport. It talks through the runtime's sockets
// directly, not the Network service: the channel is the IDE's, not the
// program's traffic, so the program's network policy, its byte counters and
// its lab do not apply to it. The secret the IDE handed over is what admits a
// connection.

partial module std.ide {
	// Socket address family and type, as the runtime takes them on Linux,
	// macOS and Windows alike.
	internal const inet = 2
	internal const stream = 1

	// How long a new connection has to say `hello`, and how long a connection
	// may stay silent between requests.
	internal const helloWait = 5s
	internal const idleWait = 3600s
	// Connections refused before the channel closes for the run.
	internal const refusalLimit = 5
	// The longest request line taken.
	internal const lineLimit = 1048576
	internal const helloWord = "hello "
	// How often series members are looked at, and how many of their samples
	// are kept: five minutes at one a second.
	internal const sampleTick = 250ms
	internal const historyLength = 300

	// A socket listening on 127.0.0.1 at port.
	//
	// Fails when the port is taken or the system refuses.
	internal def listenOn(port string) !int {
		let fd = try __net_socket(inet, stream)
		let failure ?error = none
		__net_set_reuseaddr(fd, true) onerror recover none
		__net_bind(fd, "127.0.0.1:{port}") onerror (err error) {
			failure = err
			recover none
		}
		if failure is none {
			__net_listen(fd, 16) onerror (err error) {
				failure = err
				recover none
			}
		}
		if !(failure is none) {
			__net_close(fd) onerror recover none
			fail failure
		}
		return fd
	}

	// Writes text and a line end to conn; false when the connection is gone.
	internal def send(conn int, text string) bool {
		let data = "{text}\n".bytes()
		let sent = 0
		for sent < data.len() {
			let n = __net_write(conn, data[sent:], 30s) onerror recover -1
			return false when n <= 0
			sent += n
		}
		return true
	}

	// Whether given is the secret, in time that does not depend on where the
	// two differ.
	internal def sameSecret(given string, secret string) bool {
		let a = given.bytes()
		let b = secret.bytes()
		let differ = a.len() != b.len() || b.len() == 0
		let length = a.len() > b.len() ?? (a.len(), b.len())
		let mix = 0
		for let i = 0; i < length; i++ {
			let x = i < a.len() ?? (int(a[i]), 0)
			let y = i < b.len() ?? (int(b[i]), 0)
			mix = mix | (x ^ y)
		}
		return !differ && mix == 0
	}

	// The first word of line and what follows it, trimmed.
	internal def splitWord(line string) (string, string) {
		let at = line.indexOf(" ")
		return (line, "") when at < 0
		return (line[:at], line[at + 1:].trim())
	}

	// Reads lines from a connection.
	internal type LineReader {
		internal fd      int
		internal pending byte[]

		def new(fd int) {
			self.fd = fd
			self.pending = []
		}

		// The next line without its end, none once the peer closed.
		//
		// Fails when nothing arrives within wait or the line passes lineLimit.
		def next(wait duration) !?string {
			for {
				let at = pending.indexOf(byte(10))
				if at >= 0 {
					let line = string(pending[:at])
					pending = pending[at + 1:].clone()
					return line.trimSuffix("\r")
				}
				fail "IDE request longer than {lineLimit} bytes" when pending.len() > lineLimit
				let buf byte[] = []
				buf.len(4096)
				let n = try __net_read(fd, buf, wait)
				return none when n <= 0
				pending.push(...buf[:n])
			}
		}
	}
}
