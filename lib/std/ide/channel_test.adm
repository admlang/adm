partial module std.ide {
	use (
		std.services::(Dependencies, Lifecycle, RestartMode, StartMode)
		std.services.runtime::(Runtime)
		std.testing
		std.time
	)

	internal const testToken = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

	enum PanelSpeed {
		Slow,
		Fast,
	}

	struct PanelConditions {
		// Every call waits forever.
		stalled bool      = false
		// The most entries kept.
		limit   int       = 10
		pause   duration  = 0s
		name    string    = ""
		area    PanelArea
	}

	// A condition that is an object of its own.
	struct PanelArea {
		width int = 0
	}

	// A service nothing starts: `list` still gives its description.
	service Idle {
		description               = "a service the tests never start"
		dependencies Dependencies
		lifecycle                 = Lifecycle{start: StartMode.Manual, restart: RestartMode.Never}
		permissions  Permission[]

		async def start() !none {
			return none
		}

		async def stop() !none {
			return none
		}

		async def restart() !none {
			return none
		}
	}

	// A service with a panel and a lab, for the channel's tests.
	service Panel {
		description               = "a panel for the IDE channel's tests"
		dependencies Dependencies
		lifecycle                 = Lifecycle{start: StartMode.Manual, restart: RestartMode.Never}
		permissions  Permission[]
		lab                       = new ServiceLab<PanelConditions>()
		count                     = 0
		mode                      = "quiet"
		asked                     = 0

		async def start() !none {
			return none
		}

		async def stop() !none {
			return none
		}

		async def restart() !none {
			return none
		}

		@ide(kind = IdeKind.Value, label = "Asked", refresh = 10s)
		atomic def ideAsked() int {
			asked++
			return asked
		}

		@ide(kind = IdeKind.Series, label = "Load", refresh = 100ms, cumulative = true)
		atomic def ideLoad() int {
			return count
		}

		@ide(kind = IdeKind.Action, label = "Bump", confirm = "Bump it?")
		atomic def ideBump(by int, note string = "", fast bool = false, after duration = 0s, speed PanelSpeed = PanelSpeed.Slow) string {
			count += by
			return "{count} {note} {fast} {after} {speed.name}"
		}

		@ide(kind = IdeKind.Table, label = "Items", refresh = 1s, rows = 0, group = ".")
		atomic def ideItems() IdeTable {
			return IdeTable{columns: ["Id", "Count"], rows: [["one", "{count}"]]}
		}

		@ide(kind = IdeKind.Action, label = "Drop", row = "ideItems.Id")
		atomic def ideDrop(id string) string {
			return "dropped {id}"
		}

		@ide(kind = IdeKind.Action, label = "Fail")
		atomic def ideFail() !none {
			fail "refused on purpose"
		}

		@ide(kind = IdeKind.Value, label = "Waited")
		atomic def ideWaited() duration {
			return 90500ms
		}

		@ide(kind = IdeKind.Value, label = "Mode")
		atomic def ideMode() string {
			return mode
		}

		@ide(kind = IdeKind.Choices)
		atomic def ideModes() string[] {
			return ["quiet", "loud"]
		}

		@ide(kind = IdeKind.Action, label = "Set mode", sets = "ideMode", choices = "ideModes")
		atomic def ideSetMode(to string) {
			mode = to
		}
	}

	// One connection to the channel.
	internal type ChannelClient {
		internal fd    int
		internal lines LineReader

		def new(port string) {
			fd = __net_dial_stream("127.0.0.1:{port}", 2s) onerror recover -1
			lines = new LineReader(fd)
		}

		// Sends line and gives the answer, "" when the channel closed the
		// connection instead.
		def ask(line string) string {
			return "" when fd < 0 || !send(fd, line)
			let answer = lines.next(5s) onerror recover none
			return answer is none ?? ("", answer)
		}

		def close() {
			if fd >= 0 {
				__net_close(fd) onerror recover none
			}
		}
	}

	// Opens the channel on a free port with testToken, as an IDE starting
	// the program would, and gives the port.
	internal def openChannel() !string {
		let probe = try listenOn("0")
		let address = try __net_local_addr(probe)
		__net_close(probe) onerror recover none
		let tail = address.split(":").last()
		let port = tail is none ?? ("", tail)
		try Runtime.setEnv("ADM_IDE_PORT", port)
		try Runtime.setEnv("ADM_IDE_TOKEN", testToken)
		try await IDE.restart()
		return port
	}

	check "IDE channel" {
		@test()
		def TestSecretComparison() {
			assert sameSecret(testToken, testToken)
			assert !sameSecret("", "")
			assert !sameSecret(testToken + "0", testToken)
			assert !sameSecret("x" + testToken[1:], testToken)
		}

		// The channel over real connections, in order: the token, two
		// clients, list, snapshot, call, lab, and last the refusal limit,
		// which closes the channel for the rest of the run.
		@test()
		def TestChannelProtocol() !none {
			try await Panel.start()
			let port = try openChannel()
			// The program took both variables out of its environment.
			assert Runtime.getEnv("ADM_IDE_TOKEN") is none
			assert Runtime.getEnv("ADM_IDE_PORT") is none

			// A wrong hello, and an HTTP request, are closed unanswered.
			let stranger = new ChannelClient(port)
			assert stranger.ask("hello wrong") == ""
			stranger.close()
			let browser = new ChannelClient(port)
			assert browser.ask("GET / HTTP/1.1") == ""
			browser.close()

			// Two clients at once.
			let one = new ChannelClient(port)
			let two = new ChannelClient(port)
			let first = one.ask("hello {testToken}")
			let second = two.ask("hello {testToken}")
			assert first.contains(`"kind":"hello"`) && first.contains(`"protocol":2`)
			assert second.contains(`"kind":"hello"`)
			let metrics = two.ask("metrics")
			assert metrics.contains(`"kind":"metrics"`)
			two.close()

			// list: the panel's member, its actions with their inputs, the lab.
			let listed = one.ask("list")
			assert listed.contains(`"name":"std.ide.Panel","short":"Panel","description":"a panel for the IDE channel's tests","status":"Started","since":`)
			assert listed.contains(`"lab":true`)
			assert listed.contains(`"name":"std.ide.Idle","short":"Idle","description":"a service the tests never start","status":"Stopped"`)
			assert listed.contains(`"member":"ideAsked"`)
			assert listed.contains(`"member":"ideLoad","kind":"series","label":"Load","refreshMs":100,"unit":"","cumulative":true`)
			assert listed.contains(`"action":"ideDrop","label":"Drop","confirm":"","row":{"member":"ideItems","column":"Id"}`)
			assert listed.contains(`"action":"ideBump","label":"Bump","confirm":"Bump it?"`)
			assert listed.contains(`"name":"by","type":"int"`)
			assert listed.contains(`"name":"fast","type":"bool","default":"false"`)
			assert listed.contains(`"name":"after","type":"duration"`)
			assert listed.contains(`"name":"speed","type":"enum","choices":["Slow","Fast"]`)
			assert listed.contains(`"member":"ideItems","kind":"table","label":"Items","refreshMs":1000,"unit":"","cumulative":false,"rows":0,"group":"."`)
			assert listed.contains(`"member":"ideWaited","kind":"value","label":"Waited","refreshMs":1000,"unit":"s"`)
			assert listed.contains(`"member":"ideModes","kind":"choices"`)
			assert listed.contains(`"action":"ideSetMode","label":"Set mode","confirm":"","sets":"ideMode","params":[{"name":"to","type":"string","choicesFrom":"ideModes"}]`)

			// snapshot: a member asked again before its refresh answers what
			// it gave last.
			let snap = one.ask("snapshot std.ide.Panel")
			assert snap.contains(`"ideAsked":1`)
			assert snap.contains(`"ideWaited":90.5`) && snap.contains(`"ideModes":["quiet","loud"]`)
			let again = one.ask("snapshot std.ide.Panel")
			assert again.contains(`"ideAsked":1`)

			// call: arguments by name, defaults left out, each type.
			let bumped = one.ask(`call std.ide.Panel ideBump {"by":3,"note":"hi","fast":true,"after":"150ms","speed":"Fast"}`)
			assert bumped.contains(`"ok":true`) && bumped.contains(`"value":"3 hi true 150ms Fast"`)
			let defaulted = one.ask(`call std.ide.Panel ideBump {"by":2}`)
			assert defaulted.contains(`"value":"5  false 0s Slow"`)
			let missing = one.ask(`call std.ide.Panel ideBump {}`)
			assert missing.contains(`"kind":"error"`) && missing.contains("needs by")
			let wrong = one.ask(`call std.ide.Panel ideBump {"by":"many"}`)
			assert wrong.contains(`"kind":"error"`)
			// The series member's samples, kept since the first hello.
			time.sleep(600ms)
			let history = one.ask("snapshot std.ide.Panel")
			assert history.contains(`"history":{"ideLoad":[`)
			assert history.contains(",5]") || history.contains("[5,") || history.contains(",5,")
			let failed = one.ask(`call std.ide.Panel ideFail {}`)
			assert failed.contains(`"ok":false`) && failed.contains("refused on purpose")

			// lab: conditions, set, delay, offline, reset.
			let lab = one.ask("lab std.ide.Panel")
			assert lab.contains(`"name":"limit","type":"int","value":10,"default":10,"doc":"The most entries kept."`)
			assert lab.contains(`"calls":{`)
			let set = one.ask("lab std.ide.Panel set limit 4")
			assert set.contains(`"name":"limit","type":"int","value":4`)
			assert Panel.lab.conditions.limit == 4
			let paused = one.ask(`lab std.ide.Panel set pause "150ms"`)
			assert paused.contains(`"value":"150ms","default":"0s"`)
			let named = one.ask(`lab std.ide.Panel set name "shelf"`)
			assert named.contains(`"name":"name","type":"string","value":"shelf"`)
			assert Panel.lab.conditions.name == "shelf"
			// An object condition is decoded into an object of its own.
			let before = Panel.lab.conditions.area
			one.ask(`lab std.ide.Panel set area {"width":5}`)
			assert Panel.lab.conditions.area.width == 5 && before.width == 0
			let unpaused = one.ask("lab std.ide.Panel reset pause")
			assert unpaused.contains(`"name":"pause","type":"duration","value":"0s"`)
			assert unpaused.contains(`"name":"limit","type":"int","value":4`)
			let delayed = one.ask(`lab std.ide.Panel delay {"by":"10ms"}`)
			assert delayed.contains(`"rules":[{`)
			let down = one.ask("lab std.ide.Panel offline")
			assert down.contains(`"offline":true`)
			let fresh = one.ask("lab std.ide.Panel reset")
			assert fresh.contains(`"offline":false`) && fresh.contains(`"rules":[]`)
			assert Panel.lab.conditions.limit == 10
			let unknown = one.ask("lab std.ide.Panel set nothing 1")
			assert unknown.contains("no condition nothing")
			one.close()

			// Five refused connections close the channel for the run.
			for let i = 0; i < refusalLimit; i++ {
				let bad = new ChannelClient(port)
				bad.ask("hello {i}")
				bad.close()
			}
			time.sleep(50ms)
			let late = new ChannelClient(port)
			assert late.ask("hello {testToken}") == ""
			late.close()
			return none
		}
	}
}
