// std.ide publishes running-service information to a connected IDE.
//
// A service opts members into the IDE's service panel with the `@ide`
// discovery annotation; the IDE service serves them over a local socket the
// IDE polls. The endpoint is dormant unless the process was launched by an
// IDE that asked for it by exporting ADM_IDE_PORT (the IntelliJ plugin sets
// it when starting a run configuration and connects to 127.0.0.1:$ADM_IDE_PORT
// to fill its ADM tool window). A program started outside an IDE never binds
// a socket.
//
// The wire protocol is line-based: one request per line, one JSON object per
// line back.
//
//     list             -> every registered service, its status, and its
//                         published members with widget metadata
//     snapshot <name>  -> the current value of each published member of the
//                         service with that qualified name
//
// Unknown requests answer {"kind":"error","message":...}.

partial module std.ide {
	use (
		std.net
		std.net.tcp
		std.reflection
		std.services::(Dependencies, Lifecycle, StartMode, RestartMode, Runtime)
	)

	// How the IDE renders a published member.
	enum IdeKind {
		// Single scalar shown as a labelled value.
		Value = "value",
		// IdeTable result shown as a data table.
		Table = "table",
		// Scalar sampled on each refresh and drawn as a line graph.
		Series = "series",
		// Nested structure shown as an expandable tree.
		Tree = "tree",
		// Free-form text block.
		Text = "text",
	}

	// Marks a zero-argument service method as published to the IDE service
	// panel. The method is invoked on each poll of the owning service's tab,
	// at most every `refresh`; `unit` labels Series/Value axes ("B", "ms").
	meta def ide(ctx reflection.DiscoveryMetaContext<reflection.MethodMetaContext>, kind IdeKind = IdeKind.Value, label string = "", refresh duration = 1s, unit string = "") {
		// intrinsic
	}

	// A tabular member value: `@ide(kind = IdeKind.Table)` methods return one.
	struct IdeTable {
		columns string[]
		rows    string[][]
	}

	// Literal braces; inside an interpolated string a bare brace would start
	// an interpolation segment.
	internal const lb = "\u007B"
	internal const rb = "\u007D"
	// join separator as a named const: a string literal inside an
	// interpolation segment is both reformatted by `adm fmt` (`","` becomes
	// `", "`) and miscompiled as a call argument, so never write one there.
	internal const comma = ","

	internal def errorReply(message string) string {
		return "{lb}\"kind\":\"error\",\"message\":\"{jsonEscape(message)}\"{rb}"
	}

	// Every @ide occurrence, keyed by the qualified name of the service
	// that declares the member.
	internal def publishedMembers(svcName string) reflection.AttrHit[] {
		let out = reflection.AttrHit[]
		for let (_, hit) in reflection.attrs(ide) {
			// The member's owner is derived from the qualified name; the
			// node's parentNode is not materialized for methods yet. The
			// suffix must live in a local: an interpolated literal passed
			// straight to endsWith evaluates wrongly today.
			let suffix = "{svcName}.{hit.node.name}"
			out.push(hit) when hit.node.qualifiedName.endsWith(suffix)
		}
		return out
	}

	internal def memberJSON(hit reflection.AttrHit) string {
		// Annotation arguments arrive as their literal source text:
		// kind = "IdeKind.Table", refresh = "1s".
		let kind = "value"
		let k = hit.attr.arguments.valueOf("kind")
		if !(k is none) {
			let seg = string(k).split(".").last()
			if !(seg is none) {
				let name string = seg
				kind = name.lower()
			}
		}
		let label = hit.node.name
		let l = hit.attr.arguments.valueOf("label")
		label = string(l) unless l is none
		let refreshMs = int64(1000)
		let r = hit.attr.arguments.valueOf("refresh")
		refreshMs = parseDurationMs(string(r)) unless r is none
		let unit = ""
		let u = hit.attr.arguments.valueOf("unit")
		unit = string(u) unless u is none
		return "{lb}\"member\":\"{jsonEscape(hit.node.name)}\",\"kind\":\"{jsonEscape(kind)}\",\"label\":\"{jsonEscape(label)}\",\"refreshMs\":{refreshMs},\"unit\":\"{jsonEscape(unit)}\"{rb}"
	}

	// parseDurationMs converts a duration literal's source text ("500ms",
	// "1s", "2m") to milliseconds; unparseable text falls back to 1000.
	internal def parseDurationMs(text string) int64 {
		let t = text.trim()
		let unitNs = int64(1000000000)
		let num = t
		if t.endsWith("ms") {
			num = t.trimSuffix("ms")
			unitNs = 1000000
		} else if t.endsWith("us") {
			num = t.trimSuffix("us")
			unitNs = 1000
		} else if t.endsWith("ns") {
			num = t.trimSuffix("ns")
			unitNs = 1
		} else if t.endsWith("h") {
			num = t.trimSuffix("h")
			unitNs = 3600000000000
		} else if t.endsWith("m") {
			num = t.trimSuffix("m")
			unitNs = 60000000000
		} else if t.endsWith("s") {
			num = t.trimSuffix("s")
			unitNs = 1000000000
		}
		let v = num.toInt<int64>()
		return 1000 when v <= 0
		return v * unitNs / 1000000
	}

	internal def encodeMemberValue(value any) string {
		return "null" when value is none
		match value {
			case IdeTable:
				return encodeTable(value)
			case string:
				let sv string = value
				let esc = jsonEscape(sv)
				return "\"{esc}\""
			case bool:
				return "{value}"
			case int:
				return "{value}"
			case int64:
				return "{value}"
			case uint:
				return "{value}"
			case float:
				return "{value}"
			default:
		}
		let text = "{value}"
		return "\"{jsonEscape(text)}\""
	}

	internal def encodeTable(table IdeTable) string {
		let cols = string[]
		for let (_, c) in table.columns {
			cols.push("\"{jsonEscape(c)}\"")
		}
		let rows = string[]
		for let (_, row) in table.rows {
			let cells = string[]
			for let (_, cell) in row {
				cells.push("\"{jsonEscape(cell)}\"")
			}
			rows.push("[{cells.join(comma)}]")
		}
		return "{lb}\"columns\":[{cols.join(comma)}],\"rows\":[{rows.join(comma)}]{rb}"
	}

	internal def jsonEscape(val string) string {
		let out = val.replace("\\", "\\\\")
		out = out.replace("\"", "\\\"")
		out = out.replace("\n", "\\n")
		out = out.replace("\r", "\\r")
		out = out.replace("\t", "\\t")
		return out
	}

	service IDE {
		description           = "Serves running-service information to a connected IDE"
		dependencies          = Dependencies{
			hard: [Runtime],
			soft: []
		}
		lifecycle             = Lifecycle{
			start: StartMode.Automatic,
			restart: RestartMode.Never,
		}
		permissions  string[]

		internal server ?tcp.Server = none

		def config<T>(val T) !none {
			return none
		}

		async def start() !none {
			let port = Runtime.getEnv("ADM_IDE_PORT")
			return none when port is none
			let p string = port
			let srv = new tcp.Server("127.0.0.1:{p.trim()}")
			try srv.start()
			server = srv
			async acceptLoop(srv)
			return none
		}

		async def stop() !none {
			return none when server is none
			let srv tcp.Server = server
			server = none
			try srv.stop()
			return none
		}

		async def restart() !none {
			try await stop()
			try await start()
			return none
		}

		internal async def acceptLoop(srv tcp.Server) {
			for {
				let conn = srv.accept() onerror break
				serveConn(conn)
			}
		}

		internal def serveConn(conn net.Connection) {
			let pending = ""
			for {
				let buf = byte[]
				buf.len(4096)
				let n = conn.read(buf, 3600s) onerror recover -1
				break when n <= 0
				pending += string(buf.slice(0, n))
				for {
					let idx = pending.indexOf("\n")
					break when idx < 0
					let line = pending.slice(0, idx).trim()
					pending = pending.slice(idx + 1)
					continue when line.isEmpty()
					let reply = respond(line)
					conn.writeAll("{reply}\n".bytes()) onerror break
				}
			}
			conn.close() onerror recover none
		}

		internal def respond(line string) string {
			return listReply() when line == "list"
			if line.startsWith("snapshot ") {
				return snapshotReply(line.slice(9).trim())
			}
			return errorReply("unknown request: {line}")
		}

		internal def listReply() string {
			let parts = string[]
			for let (_, info) in Runtime.services() {
				let members = string[]
				for let (_, hit) in publishedMembers(info.name) {
					members.push(memberJSON(hit))
				}
				parts.push("{lb}\"name\":\"{jsonEscape(info.name)}\",\"status\":\"{info.status}\",\"members\":[{members.join(comma)}]{rb}")
			}
			return "{lb}\"kind\":\"list\",\"services\":[{parts.join(comma)}]{rb}"
		}

		internal def snapshotReply(svcName string) string {
			let hits = publishedMembers(svcName)
			return errorReply("no published members on {svcName}") when hits.len() == 0
			let recv = reflection.serviceInstance(svcName)
			return errorReply("{svcName} is not linked into this program") when recv is none

			let values = string[]
			for let (_, hit) in hits {
				let value = reflection.call(hit.node, recv, [])
				values.push("\"{jsonEscape(hit.node.name)}\":{encodeMemberValue(value)}")
			}
			return "{lb}\"kind\":\"snapshot\",\"service\":\"{jsonEscape(svcName)}\",\"values\":{lb}{values.join(comma)}{rb}{rb}"
		}
	}
}
