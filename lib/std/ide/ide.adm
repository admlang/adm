// std.ide serves a running program's services to the IDE that started it.
//
// Each service declares its panel with `@ide` on methods of its own: members
// the IDE shows (a value, a series, a table, a tree, a text, a log) and
// actions it runs (`IdeKind.Action`). The `IDE` service serves them over a
// local socket, with the program's metrics, and lets the IDE set the
// services' labs as a test does.
//
// The channel exists only when the IDE started the program with ADM_IDE_PORT
// (the port to listen on, on 127.0.0.1) and ADM_IDE_TOKEN (a secret it chose
// for this run). The program takes both out of its environment as it starts,
// so the programs it starts never see them, and a connection that does not
// open with `hello <token>` is closed unanswered; after five such the channel
// closes. A program built without ADM_IDE_PORT holds no channel at all.
//
// The protocol is line-based: one request per line, one JSON object per line
// back, each connection served on its own task.
//
//     hello <token>                      -> {"kind":"hello","protocol":2,
//                                           "program":...,"pid":...}; first
//     list                               -> every service: its status, its
//                                           members and actions, whether it
//                                           has a lab
//     snapshot <service>                 -> the current value of each member
//     metrics                            -> processor use, memory, every
//                                           metric the Diagnostics service holds
//     call <service> <action> <args>     -> runs an action; args is a JSON
//                                           object keyed by parameter name
//     lab <service>                      -> the lab's conditions and rules
//     lab <service> set <field> <value>  -> sets one condition, value as JSON
//     lab <service> delay <args>         -> {"by":"150ms","method":"","jitter":"0s"}
//     lab <service> refuse <args>        -> {"message":"...","method":"","rate":1.0,"times":0}
//     lab <service> offline | online | reset
//
// A request that cannot be answered gets {"kind":"error","message":...}.

partial module std.ide {
	use (
		std.reflection
		std.os
		std.time
		std.services::(Application, Dependencies, Lifecycle, ServiceStatus, StartMode, RestartMode)
		std.services.diagnostics::(Diagnostics)
		std.services.runtime::(Runtime)
	)

	// How the IDE draws a member of a service's panel, or that it is an action.
	enum IdeKind {
		// Single scalar shown as a labelled value.
		Value = "value",
		// IdeTable result shown as a data table.
		Table = "table",
		// Scalar sampled on each refresh and drawn as a line graph.
		Series = "series",
		// Nested structure shown as an expandable tree.
		Tree = "tree",
		// Free-form text block.
		Text = "text",
		// IdeLog result shown as a list of log entries, colored by level.
		Log = "log",
		// A button that runs the method, with an input per parameter; what it
		// returns is shown, and so is the message when it fails.
		Action = "action",
		// A string[] the IDE offers as the choices of an action's input
		// (`choices` of the action); not drawn on its own.
		Choices = "choices",
	}

	// Marks a method of a service as part of its IDE panel. A member is a
	// zero-argument method the IDE calls at most every `refresh`; `unit`
	// labels Series and Value axes ("B", "ms"), and a member returning a
	// duration is sent in seconds with the unit "s"; a `cumulative` Series
	// counts up (bytes sent so far), and the IDE draws its change per
	// refresh. `rows` is how many rows a Table or Log shows before it scrolls,
	// 0 for as many as the panel has room for, -1 to leave it to the IDE. A
	// Table with a `group` separator is drawn as a tree: its first column is
	// split on the separator ("service.storage.read" under "service" and
	// "storage"), the other columns on the leaves.
	//
	// An action (`kind = IdeKind.Action`) may take parameters of type string,
	// int, float, bool, duration or an enum; the IDE asks `confirm` first when
	// it is set, and an action with a `row` ("ideSockets.Descriptor": a Table
	// member and one of its columns) is offered on each row of that table,
	// its first parameter taking the row's value in that column. An action
	// that `sets` a member (the member's name) changes the value that member
	// shows, so the IDE draws the action in that member's place, the current
	// value picked; `choices` names a `Choices` member whose texts its first
	// parameter offers.
	//
	// The methods are plain `atomic def`s of the service, so they are not its
	// API and run one at a time with its own calls:
	//
	//     @ide(kind = IdeKind.Action, label = "Clear", confirm = "Remove every entry?")
	//     atomic def ideClear() {
	//         clear()
	//     }
	meta def ide(ctx reflection.DiscoveryMetaContext<reflection.MethodMetaContext>, kind IdeKind = IdeKind.Value, label string = "", refresh duration = 1s, unit string = "", confirm string = "", cumulative bool = false, row string = "", rows int = -1, group string = "", sets string = "", choices string = "") {
		// intrinsic
	}

	// A tabular member value: `@ide(kind = IdeKind.Table)` methods return one.
	struct IdeTable {
		columns string[]
		rows    string[][]
	}

	// One entry of an `IdeLog`.
	struct IdeLogEntry {
		// When it was written, in milliseconds since the Unix epoch; the IDE shows it in its
		// own time zone.
		time    int64
		// `debug`, `info`, `warning`, `error`, `fatal`, or `log` for an entry with no level:
		// the IDE colors the entry by it.
		level   string
		// Who wrote it: a module, a component, a subsystem.
		source  string
		// Where in the code, as `file:line`; empty when unknown.
		at      string
		message string
		// The entry's named values as `[name, value]` pairs, in the order to show them.
		fields  string[][]
	}

	// A list of log entries, oldest first: `@ide(kind = IdeKind.Log)` methods return one.
	// The IDE replaces what it shows with each answer, so return the recent entries, a few
	// hundred at most.
	struct IdeLog {
		entries IdeLogEntry[]
	}

	// IDE serves the program's services to the IDE that started it, as the
	// module's comment describes. Without ADM_IDE_PORT and ADM_IDE_TOKEN it
	// starts and does nothing.
	service IDE {
		description               = "Serves the program's services to the IDE that started it"
		dependencies              = Dependencies{
			hard: [Runtime, Diagnostics],
			soft: []
		}
		lifecycle                 = Lifecycle{
			start: StartMode.Automatic,
			restart: RestartMode.Never,
		}
		permissions  Permission[]

		// The port and the secret the IDE handed over, "" while there are none.
		internal port     string                 = ""
		internal secret   string                 = ""
		// The listening socket, -1 while there is none.
		internal listener int                    = -1
		// Connections that did not open with the secret; at refusalLimit the
		// channel closes.
		internal refused  int                    = 0
		// What each member answered last and when, by `service.member`.
		internal answers  map<string, Answer>
		// The latest samples of each series member, by `service.member`,
		// oldest first, and when each was last sampled; sampling starts with
		// the first connection the channel admits.
		internal samples  map<string, float64[]>
		internal sampled  map<string, int64>
		internal sampling bool                   = false

		// config accepts a configuration value. The service has no settings, so any
		// value is taken as is.
		// It cannot fail.
		def config<T>(val T) !none {
			return none
		}

		// start takes ADM_IDE_PORT and ADM_IDE_TOKEN out of the environment and
		// listens on 127.0.0.1 at that port; it does nothing when either is
		// missing. Fails when the port cannot be bound.
		async def start() !none {
			let given = __env_take("ADM_IDE_PORT", false)
			let token = __env_take("ADM_IDE_TOKEN", true)
			if !(given is none) && !(token is none) {
				port = given.trim()
				secret = token
			}
			return none when port == "" || secret == "" || listener >= 0 || refused >= refusalLimit
			let fd = try listenOn(port)
			listener = fd
			async acceptLoop(fd)
			return none
		}

		// stop closes the listening socket; the connections being served end
		// with their next request. It cannot fail.
		async def stop() !none {
			closeListener()
			return none
		}

		// restart listens again on the port the IDE handed over. Fails when the
		// port cannot be bound.
		async def restart() !none {
			try await stop()
			try await start()
			return none
		}

		// Takes connections until the listener closes, serving each on its own
		// task.
		def acceptLoop(fd int) {
			for {
				let conn = __net_accept(fd) onerror break
				async serve(conn)
			}
		}

		// Answers one connection's requests, after its `hello` carried the
		// secret within helloWait.
		def serve(conn int) {
			let lines = new LineReader(conn)
			let first = lines.next(helloWait) onerror recover none
			let admitted = false
			if !(first is none) {
				admitted = admits(first)
			}
			if !admitted {
				__net_close(conn) onerror recover none
				noteRefusal()
				return
			}
			startSampling()
			let open = send(conn, helloReply())
			for open {
				let next = lines.next(idleWait) onerror recover none
				break when next is none
				let request = next.trim()
				continue when request.isEmpty()
				open = send(conn, respond(request))
			}
			__net_close(conn) onerror recover none
		}

		// Whether a connection's first line is `hello` with the secret,
		// compared in time that does not depend on where they differ.
		def admits(line string) bool {
			return false unless line.startsWith(helloWord)
			return sameSecret(line[helloWord.len():].trim(), secret)
		}

		// Counts a refused connection; at refusalLimit the channel closes for
		// the rest of the run and says so once.
		atomic def noteRefusal() {
			refused++
			return unless refused == refusalLimit
			closeListener()
			fprintln(os.stderr, "adm: the IDE channel closed after {refusalLimit} connections that did not come from the IDE") onerror recover 0
		}

		atomic def startSampling() {
			return when sampling
			sampling = true
			async sampleSeries()
		}

		// Samples every series member of the running services as often as
		// its refresh allows, keeping the last historyLength samples, until
		// the listener closes.
		def sampleSeries() {
			for keepSampling() {
				time.sleep(sampleTick)
				for let (_, info) in Runtime.services() {
					continue unless info.status == ServiceStatus.Started
					let series = membersOf(info.name).filter(hit => kindOf(hit) == "series")
					continue when series.len() == 0
					let recv = reflection.serviceInstance(info.name)
					continue when recv is none
					for let (_, hit) in series {
						let key = "{info.name}.{hit.node.name}"
						continue unless sampleDue(key, refreshOf(hit))
						let text = encodeMemberValue(reflection.call(hit.node, recv, []))
						addSample(key, parseFloat<float64>(text)) when isNumber(text)
					}
				}
			}
		}

		// Whether sampling goes on: while the listener is open, so that a
		// connection made later still finds the history. Once it closes, the
		// next admitted connection after a restart starts sampling again.
		atomic def keepSampling() bool {
			return true when listener >= 0
			sampling = false
			return false
		}

		// Whether key's member is due a sample, marking it sampled when it is.
		atomic def sampleDue(key string, refresh duration) bool {
			let now = time.monoNs()
			let last = sampled.get(key)
			return false when !(last is none) && now - last < int64(refresh)
			sampled[key] = now
			return true
		}

		atomic def addSample(key string, value float64) {
			let held = samples.get(key)
			let list = held is none ?? (float64[], held)
			list.push(value)
			list = list[list.len() - historyLength:].clone() when list.len() > historyLength
			samples[key] = list
		}

		// The samples kept for key, oldest first.
		atomic def samplesOf(key string) float64[] {
			let held = samples.get(key)
			return held is none ?? (float64[], held.clone())
		}

		atomic def closeListener() {
			return when listener < 0
			let fd = listener
			listener = -1
			__net_wake(fd) onerror recover none
			__net_close(fd) onerror recover none
		}

		def respond(line string) string {
			let (verb, rest) = splitWord(line)
			return listReply() when verb == "list"
			return snapshotReply(rest) when verb == "snapshot"
			return metricsReply() when verb == "metrics"
			return callReply(rest) when verb == "call"
			return labReply(rest) when verb == "lab"
			return errorReply("unknown request: {verb}")
		}

		// The current value of each member of the service, a member asked
		// again before its refresh passed answering what it gave last.
		def snapshotReply(svcName string) string {
			let hits = membersOf(svcName)
			return errorReply("no published members on {svcName}") when hits.len() == 0
			let recv = reflection.serviceInstance(svcName)
			return errorReply("{svcName} is not linked into this program") when recv is none
			let values = string[]
			let histories = string[]
			for let (_, hit) in hits {
				let key = "{svcName}.{hit.node.name}"
				let held = heldAnswer(key, refreshOf(hit))
				let text = ""
				if held is none {
					text = encodeMemberValue(reflection.call(hit.node, recv, []))
					keepAnswer(key, text)
				} else {
					text = held
				}
				values.push(quote(hit.node.name) + ":" + text)
				if kindOf(hit) == "series" {
					let points = string[]
					for let (_, v) in samplesOf(key) {
						points.push(jsonNumber(v))
					}
					histories.push(quote(hit.node.name) + ":[" + points.join(",") + "]")
				}
			}
			return `{"kind":"snapshot","service":` + quote(svcName) + `,"values":{` + values.join(",") + `},"history":{` + histories.join(",") + `}}`
		}

		// The answer kept for key, none when there is none or it is older than
		// refresh.
		atomic def heldAnswer(key string, refresh duration) ?string {
			let held = answers.get(key)
			return none when held is none
			return none when time.monoNs() - held.at >= int64(refresh)
			return held.text
		}

		atomic def keepAnswer(key string, text string) {
			answers[key] = Answer{at: time.monoNs(), text: text}
		}
	}

	// What a member answered, and when (monotonic nanoseconds).
	internal struct Answer {
		at   int64
		text string
	}
}
