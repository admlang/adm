partial module std.ide {
	use (
		std.metrics::(Counter, Histogram)
		std.services.cache::(Cache)
		std.testing
	)

	check "IDE service helpers" {
		// Every string goes out through quote: quotes, backslashes and control
		// characters (a coloured log line's ESC among them) escaped.
		@test()
		def quotesJSONText() !none {
			assert quote("plain") == `"plain"`
			assert quote(`a"b`) == `"a\"b"`
			assert quote(`a\b`) == `"a\\b"`
			assert quote("a\nb") == `"a\nb"`
			assert quote("a\u001Bb") == `"a\u001bb"`
			return none
		}

		@test()
		def encodesMetrics() !none {
			assert jsonNumber(1.5) == "1.5"
			let zero = 0.0
			assert jsonNumber(zero / zero) == "null"
			assert jsonNumber(1.0 / zero) == "null"
			let count = new Counter()
			count.update(3)
			assert encodeMetric(count) == `{"kind":"counter","value":3}`
			let held = new Histogram(4)
			assert encodeHistogram(held).contains(`"last":null`)
			held.update(2)
			let json = encodeHistogram(held)
			assert json.contains(`"kind":"histogram"`) && json.contains(`"last":2`) && json.contains(`"count":1`)
			return none
		}

		@test()
		def parsesDurationLiterals() !none {
			assert parseDurationMs("500ms") == 500
			assert parseDurationMs("1s") == 1000
			assert parseDurationMs("2m") == 120000
			assert parseDurationMs("1h") == 3600000
			assert parseDurationMs("250000us") == 250
			assert parseDurationMs("2000000ns") == 2
			assert parseDurationMs("nonsense") == 1000
			return none
		}

		@test()
		def encodesTables() !none {
			let table = IdeTable{
				columns: ["Key", "Value"],
				rows:    [["a", "1"], [`b "quoted"`, "2"]],
			}
			let json = encodeTable(table)
			assert json.startsWith(`{`)
			assert json.endsWith(`}`)
			assert json.contains(`"columns":["Key","Value"]`)
			assert json.contains(`"rows":[["a","1"],["b \"quoted\"","2"]]`)
			return none
		}

		@test()
		def encodesLogEntries() !none {
			let log = IdeLog{
				entries: [
					IdeLogEntry{time: 1791813909250, level: "error", source: "billing", at: "invoice.adm:17", message: `card "declined"`, fields: [["amount", "12"], ["user", `"u 1"`]]},
					IdeLogEntry{time: 1791813909251, level: "log", source: "billing", message: "plain"},
				],
			}
			let json = encodeLog(log)
			assert json == `{"entries":[{"time":1791813909250,"level":"error","source":"billing","at":"invoice.adm:17","message":"card \"declined\"","fields":[["amount","12"],["user","\"u 1\""]]},{"time":1791813909251,"level":"log","source":"billing","at":"","message":"plain","fields":[]}]}`
			assert encodeMemberValue(log) == json
			assert encodeLog(IdeLog{}) == `{"entries":[]}`
			return none
		}

		@test()
		def encodesMemberValues() !none {
			assert encodeMemberValue(42) == "42"
			assert encodeMemberValue(true) == "true"
			assert encodeMemberValue("text") == `"text"`
			assert encodeMemberValue(0.0) == "0"
			assert encodeMemberValue(2.5) == "2.5"
			assert encodeMemberValue(1500ms) == "1.5"
			assert encodeMemberValue(["en", `a"b`]) == `["en","a\"b"]`
			// Every width of number is a JSON number: a chart takes only numbers.
			assert encodeMemberValue(uint64(18446744073709551615)) == "18446744073709551615"
			assert encodeMemberValue(int8(-5)) == "-5" && encodeMemberValue(uint8(200)) == "200"
			assert encodeMemberValue(int16(-300)) == "-300" && encodeMemberValue(uint16(60000)) == "60000"
			assert encodeMemberValue(int32(-70000)) == "-70000" && encodeMemberValue(uint32(4000000000)) == "4000000000"
			assert encodeMemberValue(float32(2.5)) == "2.5" && encodeMemberValue(float16(0.5)) == "0.5"
			return none
		}

		@test()
		def findsCachePublishedMembers() !none {
			// Naming the service keeps it in the program: one that no code reaches is not built.
			assert Cache.get("absent") is none
			let hits = membersOf("std.services.cache.Cache")
			assert hits.len() == 3
			let names = string[]
			for let (_, hit) in hits {
				names.push(hit.node.name)
			}
			assert names.includes("ideEntries")
			assert names.includes("ideCount")
			assert names.includes("ideMemory")
			let actions = string[]
			for let (_, hit) in actionsOf("std.services.cache.Cache") {
				actions.push(hit.node.name)
			}
			assert actions.includes("ideClear") && actions.includes("ideDelete")
			assert publishedMembers("std.services.cache.Cache").len() == hits.len() + actions.len()
			return none
		}

		@test()
		def describesMembersWithWidgetMetadata() !none {
			let entries = ""
			for let (_, hit) in publishedMembers("std.services.cache.Cache") {
				continue unless hit.node.name == "ideMemory"
				entries = memberJSON(hit)
			}
			assert entries.contains(`"kind":"series"`)
			assert entries.contains(`"label":"Memory"`)
			assert entries.contains(`"refreshMs":500`)
			assert entries.contains(`"unit":"B"`)
			return none
		}
	}
}
