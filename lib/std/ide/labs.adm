// The IDE channel's `lab` requests: the labs of the running program's
// services (`ServiceLab`, what `Storage.lab` is), set from the IDE as a test
// sets them.

partial module std.ide {
	use (
		std.data.encoding::(JSON)
		std.reflection
		std.time
	)

	// The field of a `ServiceLab<T>` that holds its conditions, which code
	// reads through the lab's `conditions`.
	internal const labConditionsField = "current"

	// What the IDE drives of a service's lab; every `ServiceLab<T>` has it.
	internal interface LabControl {
		def delay(by duration, method string, jitter duration)
		def refuse(message string, method string, rate float, times int)
		def offline()
		def online()
		def reset()
		def defaults() any
	}

	// The lab of the service with this qualified name: the one it declares,
	// else the one every service has; none when it is not linked into the
	// program.
	internal def labOf(svcName string) ?any {
		let recv = reflection.serviceInstance(svcName)
		return none when recv is none
		let field = reflection.field(recv, "lab")
		return field.value() unless field is none
		match recv {
			case service:
				return __labs.of(recv)
			default:
		}
		return none
	}

	// Answers `<service>` with the lab as it stands, or sets it first:
	// `set <field> <value>`, `delay <args>`, `refuse <args>`, `offline`,
	// `online`, `reset` (every condition and rule) or `reset <field>` (one
	// condition back to its default).
	internal def labReply(rest string) string {
		let (svcName, more) = splitWord(rest)
		return errorReply("lab needs a service") when svcName == ""
		let held = labOf(svcName)
		return errorReply("{svcName} has no lab") when held is none
		let (op, args) = splitWord(more)
		if op != "" {
			let failure = ""
			changeLab(held, op, args) onerror (err error) {
				failure = err.message
				recover none
			}
			return errorReply(failure) unless failure == ""
		}
		return labDescription(svcName, held)
	}

	// Applies one `lab` operation.
	//
	// Fails when the operation is unknown or its arguments do not read.
	internal def changeLab(held any, op string, args string) !none {
		if op == "set" {
			let (name, value) = splitWord(args)
			return setCondition(held, name, value)
		}
		let lab = controlOf(held)
		fail "this lab cannot be driven" when lab is none
		switch op {
			case "offline":
				lab.offline()
			case "online":
				lab.online()
			case "reset":
				if args.trim() == "" {
					lab.reset()
				} else {
					try resetCondition(held, lab.defaults(), args.trim())
				}
			case "delay":
				let given = try labArgs(args)
				let by = try labDuration(given, "by", "")
				fail "delay needs by" when by == 0s
				lab.delay(by, labText(given, "method", ""), try labDuration(given, "jitter", "0s"))
			case "refuse":
				let given = try labArgs(args)
				let message = labText(given, "message", "")
				fail "refuse needs a message" when message == ""
				let rate = labText(given, "rate", "1")
				let times = labText(given, "times", "0")
				fail "rate is not a number" unless isNumber(rate)
				fail "times is not a whole number" unless isWhole(times)
				lab.refuse(message, labText(given, "method", ""), parseFloat<float>(rate), times.toInt<int>())
			default:
				fail "unknown lab operation {op}: set, reset, delay, refuse, offline or online"
		}
		return none
	}

	// The lab as its operations take it, none for a value that is no lab.
	internal def controlOf(held any) ?LabControl {
		match held {
			case LabControl:
				return held
			default:
		}
		return none
	}

	// Puts the condition `name` back to its value in defaults.
	//
	// Fails when the lab has no such condition.
	internal def resetCondition(held any, defaults any, name string) !none {
		let block = reflection.field(held, labConditionsField)
		fail "this lab has no conditions" when block is none
		let current = block.value()
		fail "this lab has no conditions" when current is none
		let target = reflection.field(current, name)
		let source = reflection.field(defaults, name)
		fail "no condition {name}" when target is none || source is none
		keepReplaced(target)
		copyField(source, target)
		return none
	}

	// Keeps what a condition holds before the IDE writes another value
	// there: a call takes its lab's conditions under the lab's lock but
	// reads their fields without it, so a call in flight may still be
	// reading the string, map or object the write replaces. A number, a bool
	// or a duration is written in place and needs nothing kept.
	internal def keepReplaced(field reflection.Field) {
		return when field.kind := reflection.FieldKind.Bool || reflection.FieldKind.Int || reflection.FieldKind.Uint || reflection.FieldKind.Float
		if field.kind == reflection.FieldKind.String {
			replacedConditions.keep(field.asString())
			return
		}
		let held = field.value()
		replacedConditions.keep(held) unless held is none
	}

	// What the IDE's writes replaced in labs' conditions (keepReplaced),
	// kept until the program ends.
	internal type ReplacedConditions {
		internal held any[] = []

		def new() {}

		atomic def keep(value any) {
			held.push(value)
		}
	}

	internal let replacedConditions = new ReplacedConditions()

	// Writes from's value into to, both fields of one type.
	internal def copyField(from reflection.Field, to reflection.Field) {
		if from.typeName == "duration" {
			to.set(duration(from.asInt()))
			return
		}
		match from.kind {
			case reflection.FieldKind.Bool:
				to.setBool(from.asBool())
			case reflection.FieldKind.Int:
				to.setInt(from.asInt())
			case reflection.FieldKind.Uint:
				to.setUint(from.asUint())
			case reflection.FieldKind.Float:
				to.setFloat(from.asFloat())
			case reflection.FieldKind.String:
				to.setString(from.asString())
			default:
				let value = from.value()
				if value is none {
					to.setNone()
				} else {
					to.set(value)
				}
		}
	}

	// The JSON object of a `delay` or `refuse`.
	//
	// Fails when the text is not JSON.
	internal def labArgs(args string) !any {
		fail "the arguments are missing" when args.trim() == ""
		return try JSON.parse(args)
	}

	// An argument as text, fallback when it is not given.
	internal def labText(given any, name string, fallback string) string {
		let found = reflection.entryOf(given, name)
		return found is none ?? (fallback, reflection.scalarText(found))
	}

	// A duration argument, as written ("150ms") or in milliseconds.
	//
	// Fails when it does not read as a duration.
	internal def labDuration(given any, name string, fallback string) !duration {
		let text = labText(given, name, fallback)
		return 0s when text == ""
		return duration(text.toInt<int64>() * 1000000) when isWhole(text)
		return try time.parseDuration(text)
	}

	// Sets the lab's condition `name` to value, written as JSON: a number, a
	// bool, a string, null for an optional, a duration as text, or an object
	// or array for a map or array condition.
	//
	// Fails when the lab has no such condition or the value does not fit it.
	internal def setCondition(held any, name string, value string) !none {
		let conditions = reflection.field(held, labConditionsField)
		fail "this lab has no conditions" when conditions is none
		let current = conditions.value()
		fail "this lab has no conditions" when current is none
		let field = reflection.field(current, name)
		fail "no condition {name}" when field is none
		let parsed = try JSON.parse(value)
		let text = reflection.scalarText(parsed)
		keepReplaced(field)
		if field.typeName == "duration" || field.typeName == "?duration" {
			if parsed is none {
				fail "{name} cannot be null" unless field.setNone()
				return none
			}
			let given = isWhole(text) ?? (duration(text.toInt<int64>() * 1000000), try time.parseDuration(text))
			fail "{name} does not take {value}" unless field.set(given)
			return none
		}
		match field.kind {
			case reflection.FieldKind.Bool:
				fail "{name} takes true or false" unless text == "true" || text == "false"
				field.setBool(text == "true")
			case reflection.FieldKind.Int:
				fail "{name} takes a whole number" unless isWhole(text)
				field.setInt(text.toInt<int>())
			case reflection.FieldKind.Uint:
				fail "{name} takes a whole number" unless isWhole(text) && !text.startsWith("-")
				field.setUint(text.toInt<uint>())
			case reflection.FieldKind.Float:
				fail "{name} takes a number" unless isNumber(text)
				field.setFloat(parseFloat<float>(text))
			case reflection.FieldKind.String:
				field.setString(text)
			default:
				if parsed is none {
					fail "{name} cannot be null" unless field.setNone()
					return none
				}
				let optional = field.kind == reflection.FieldKind.Optional
				if field.kind == reflection.FieldKind.Struct || optional && field.elemKind == reflection.FieldKind.Struct {
					// Decoded into an object of its own, which then takes
					// the field: the object the field holds may be in use.
					let typ = optional ?? (field.elemDescriptor, field.descriptor)
					fail "{name} cannot be set from the IDE" when typ is none
					let fresh = reflection.instantiate(typ)
					try JSON.decode(value, fresh)
					fail "{name} does not take {value}" unless field.set(fresh)
					return none
				}
				let target = field.ensureValue()
				fail "{name} cannot be set from the IDE" when target is none
				field.clear()
				try JSON.decode(value, target)
		}
		return none
	}

	// The lab as `lab <service>` answers it: whether it is offline, its
	// conditions with their values, defaults and doc comments, and the rules
	// `delay` and `refuse` made.
	internal def labDescription(svcName string, held any) string {
		let conditions = string[]
		let block = reflection.field(held, labConditionsField)
		let current = block is none ?? (none, block.value())
		let control = controlOf(held)
		let defaults = control is none ?? (none, control.defaults())
		if !(current is none) {
			for let (_, field) in reflection.fields(current) {
				let start = defaults is none ?? (none, reflection.field(defaults, field.name))
				let byDefault = start is none ?? ("null", fieldJSON(start))
				conditions.push(`{"name":` + quote(field.name) + `,"type":` + quote(field.typeName) + `,"value":` + fieldJSON(field) + `,"default":` + byDefault + `,"doc":` + quote(field.doc) + `}`)
			}
		}
		let rules = string[]
		let ruleField = reflection.field(held, "rules")
		if !(ruleField is none) {
			for let i = 0; i < ruleField.len(); i++ {
				let rule = ruleField.at(i).value()
				continue when rule is none
				let parts = string[]
				for let (_, field) in reflection.fields(rule) {
					parts.push(quote(field.name) + ":" + fieldJSON(field))
				}
				rules.push(`{` + parts.join(",") + `}`)
			}
		}
		let down = reflection.field(held, "down")
		let offline = !(down is none) && down.asBool()
		// The calls the lab counted since its first condition or last reset, by
		// method ("" for every method together).
		let calls = string[]
		let seen = reflection.field(held, "seen")
		if !(seen is none) {
			for let (_, method) in seen.keys().sort((a, b) => a < b) {
				calls.push(quote(method) + ":" + seen.entry(method).asInt().str())
			}
		}
		return `{"kind":"lab","service":` + quote(svcName) + `,"offline":` + "{offline}" + `,"conditions":[` + conditions.join(",") + `],"rules":[` + rules.join(",") + `],"calls":{` + calls.join(",") + `}}`
	}

	// A field's value as JSON, read the way its kind is held: a duration as
	// its text ("150ms"), a scalar as itself, a reference as valueJSON
	// writes it.
	internal def fieldJSON(field reflection.Field) string {
		if field.typeName == "duration" {
			return quote("{duration(field.asInt())}")
		}
		match field.kind {
			case reflection.FieldKind.Bool:
				return "{field.asBool()}"
			case reflection.FieldKind.Int:
				return "{field.asInt()}"
			case reflection.FieldKind.Uint:
				return "{field.asUint()}"
			case reflection.FieldKind.Float:
				return jsonNumber(field.asFloat())
			case reflection.FieldKind.String:
				return quote(field.asString())
			default:
		}
		return valueJSON(field.value())
	}

	// A condition's or rule's value as JSON: a duration as its text ("150ms"),
	// a number, bool or string as itself, anything else as JSON encodes it.
	internal def valueJSON(value ?any) string {
		return "null" when value is none
		match value {
			case duration:
				return quote("{value}")
			case string:
				let text string = value
				return quote(text)
			case bool:
				return "{value}"
			case int:
				return "{value}"
			case int64:
				return "{value}"
			case uint:
				return "{value}"
			case float:
				let number float = value
				return jsonNumber(number)
			default:
		}
		return string(JSON.encode(value))
	}
}
