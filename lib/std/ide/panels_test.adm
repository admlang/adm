partial module std.ide {
	use (
		std.reflection
		std.services::(Application)
		std.services.browser::(Browser)
		std.services.cache::(Cache)
		std.services.clipboard::(Clipboard)
		std.services.config::(Config)
		std.services.database::(Database)
		std.services.debugger::(Debugger)
		std.services.devices::(Devices)
		std.services.diagnostics::(Diagnostics)
		std.services.features::(Features)
		std.services.i18n::(I18n)
		std.services.ipc::(IPC)
		std.services.logging::(Logging)
		std.services.messaging::(Messaging)
		std.services.network::(Network)
		std.services.notifications::(Notifications)
		std.services.policy::(Policy)
		std.services.runtime::(Runtime)
		std.services.scheduler::(Scheduler)
		std.services.storage::(Storage)
		std.services.telemetry::(Telemetry)
		std.services.vault::(Vault)
		std.testing
	)

	// The services whose members a test may run: they start without a desktop,
	// a server or a page.
	internal const quietServices = ["std.services.Application", "std.services.runtime.Runtime", "std.services.diagnostics.Diagnostics", "std.services.network.Network", "std.services.storage.Storage", "std.services.policy.Policy", "std.services.scheduler.Scheduler", "std.services.logging.Logging", "std.services.messaging.Messaging", "std.services.cache.Cache", "std.services.config.Config", "std.services.i18n.I18n", "std.services.features.Features", "std.services.telemetry.Telemetry", "std.services.ipc.IPC", "std.services.database.Database", "std.services.devices.Devices"]

	check "Service panels" {
		// Every action of every std service's panel takes only inputs the
		// channel can give, and every service's panel has something in it.
		@test()
		def TestEveryActionTakesChannelInputs() !none {
			let services = 0
			let problems = string[]
			for let (_, info) in Runtime.services() {
				let hits = publishedMembers(info.name)
				continue when hits.len() == 0
				services++
				for let (_, hit) in hits {
					continue unless kindOf(hit) == "action"
					let fn = reflection.asFunction(hit.node)
					if fn is none {
						problems.push("{info.name}.{hit.node.name}: no function")
						continue
					}
					for let (_, param) in fn.signature.parameters {
						problems.push("{info.name}.{hit.node.name}: {param.node.name} is a {param.paramType.typeName}") when paramKind(param.paramType) == ""
					}
				}
			}
			try testing.expectEqual("", problems.join("; "), "actions with inputs the channel cannot give")
			assert services >= 20
			return none
		}

		// An action offered on the rows of a table names a Table member of its
		// own service and one of that table's columns.
		@test()
		def TestEveryRowNamesATableColumn() !none {
			let problems = string[]
			for let (_, name) in quietServices {
				let recv = reflection.serviceInstance(name)
				continue when recv is none
				for let (_, hit) in actionsOf(name) {
					let row = argumentOf(hit, "row", "")
					continue when row == ""
					let (member, column) = splitWord(row.replace(".", " "))
					let tables = membersOf(name).filter(m => m.node.name == member && kindOf(m) == "table")
					if tables.len() == 0 {
						problems.push("{name}.{hit.node.name}: no table member {member}")
						continue
					}
					let value = reflection.call(tables[0].node, recv, [])
					match value {
						case IdeTable:
							problems.push("{name}.{hit.node.name}: {member} has no column {column}") unless value.columns.includes(column)
						default:
							problems.push("{name}.{hit.node.name}: {member} is no table")
					}
				}
			}
			try testing.expectEqual("", problems.join("; "), "row actions naming no table column")
			return none
		}

		// What `sets`, `choices`, `rows` and `group` name is there: an action
		// sets a member of its own service, offers the texts of a Choices
		// member, only a Table or a Log has rows, and only a Table a group.
		@test()
		def TestEveryHintNamesAMember() !none {
			let problems = string[]
			for let (_, info) in Runtime.services() {
				let hits = publishedMembers(info.name)
				for let (_, hit) in hits {
					let at = "{info.name}.{hit.node.name}"
					let kind = kindOf(hit)
					let sets = argumentOf(hit, "sets", "")
					if sets != "" && hits.filter(m => m.node.name == sets && kindOf(m) != "action").len() == 0 {
						problems.push("{at}: sets {sets}, no such member")
					}
					let choices = argumentOf(hit, "choices", "")
					if choices != "" && hits.filter(m => m.node.name == choices && kindOf(m) == "choices").len() == 0 {
						problems.push("{at}: choices {choices}, no such Choices member")
					}
					let rows = argumentOf(hit, "rows", "")
					problems.push("{at}: rows on a {kind}") when rows != "" && kind != "table" && kind != "log"
					problems.push("{at}: group on a {kind}") when argumentOf(hit, "group", "") != "" && kind != "table"
				}
			}
			try testing.expectEqual("", problems.join("; "), "panel hints naming nothing")
			return none
		}

		// Every service a test can start has a lab the IDE can drive: its own
		// `lab`, or the one every service has.
		@test()
		def TestEveryServiceHasALab() !none {
			let missing = string[]
			for let (_, name) in quietServices {
				continue when reflection.serviceInstance(name) is none
				missing.push(name) when labOf(name) is none
			}
			try testing.expectEqual("", missing.join(", "), "services without a lab")
			return none
		}

		// Every member of the panels of the services a test can start answers,
		// as the channel calls it. A log member is left out: asking one makes its
		// service keep entries from then on, which another suite's test of that
		// service would see.
		@test()
		def TestEveryMemberAnswers() !none {
			let problems = string[]
			for let (_, name) in quietServices {
				let members = membersOf(name)
				if members.len() == 0 {
					problems.push("{name}: no members")
					continue
				}
				let recv = reflection.serviceInstance(name)
				if recv is none {
					problems.push("{name}: not linked")
					continue
				}
				for let (_, hit) in members {
					continue when kindOf(hit) == "log"
					problems.push("{name}.{hit.node.name}: no answer") when encodeMemberValue(reflection.call(hit.node, recv, [])) == ""
				}
			}
			try testing.expectEqual("", problems.join("; "), "members that do not answer")
			return none
		}
	}
}
