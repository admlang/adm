// How the IDE channel's answers are written: one JSON object per line.

partial module std.ide {
	use (
		std.reflection
		std.metrics::(Counter, Gauge, Histogram, Toggle)
		std.services::(Application, ServiceStatus)
		std.services.diagnostics::(Diagnostics, Metric)
		std.services.runtime::(Runtime)
		std.data.encoding::(JSON)
	)

	// The JSON is written as text: the constant parts as raw strings, every
	// string value through quote.

	internal let jsonCodec = new JSON()

	// text as a JSON string, quoted and escaped as RFC 8259 asks, control
	// characters included.
	internal def quote(text string) string {
		return string(jsonCodec.encode(text))
	}

	internal def errorReply(message string) string {
		return `{"kind":"error","message":` + quote(message) + `}`
	}

	// The answer to a connection's `hello`.
	internal def helloReply() string {
		return `{"kind":"hello","protocol":2,"program":` + quote(Application.name()) + `,"pid":` + Application.pid().str() + `}`
	}

	// Every `@ide` method of the service with this qualified name, members
	// and actions alike, in declaration order.
	internal def publishedMembers(svcName string) reflection.AttrHit[] {
		let out = reflection.AttrHit[]
		for let (_, hit) in reflection.attrs(ide) {
			// The member's owner is derived from the qualified name. The
			// suffix lives in a local.
			let suffix = "{svcName}.{hit.node.name}"
			out.push(hit) when hit.node.qualifiedName.endsWith(suffix)
		}
		return out
	}

	// The service's members: what the IDE shows.
	internal def membersOf(svcName string) reflection.AttrHit[] {
		return publishedMembers(svcName).filter(hit => kindOf(hit) != "action")
	}

	// The service's actions: what the IDE runs.
	internal def actionsOf(svcName string) reflection.AttrHit[] {
		return publishedMembers(svcName).filter(hit => kindOf(hit) == "action")
	}

	// An annotation argument's text as written, fallback when it is not given.
	internal def argumentOf(hit reflection.AttrHit, name string, fallback string) string {
		let given = hit.attr.arguments.valueOf(name)
		return given is none ?? (fallback, string(given))
	}

	// The kind of a member as the protocol names it: `IdeKind.Table` is
	// "table".
	internal def kindOf(hit reflection.AttrHit) string {
		let written = argumentOf(hit, "kind", "IdeKind.Value")
		let last = written.split(".").last()
		return last is none ?? ("value", last.lower())
	}

	// How often a member may run.
	internal def refreshOf(hit reflection.AttrHit) duration {
		let ms = parseDurationMs(argumentOf(hit, "refresh", "1s"))
		return duration(ms * 1000000)
	}

	internal def memberJSON(hit reflection.AttrHit) string {
		// Annotation arguments arrive as their literal source text:
		// kind = "IdeKind.Table", refresh = "1s".
		let label = argumentOf(hit, "label", hit.node.name)
		let refreshMs = parseDurationMs(argumentOf(hit, "refresh", "1s"))
		let unit = argumentOf(hit, "unit", returnsDuration(hit) ?? ("s", ""))
		let cumulative = argumentOf(hit, "cumulative", "false") == "true"
		let rows = argumentOf(hit, "rows", "")
		let rowsJSON = rows == "" ?? ("", `,"rows":` + rows)
		let group = argumentOf(hit, "group", "")
		rowsJSON += `,"group":` + quote(group) unless group == ""
		return `{"member":` + quote(hit.node.name) + `,"kind":` + quote(kindOf(hit)) + `,"label":` + quote(label) + `,"refreshMs":` + refreshMs.str() + `,"unit":` + quote(unit) + `,"cumulative":` + "{cumulative}" + rowsJSON + `}`
	}

	// Whether a member returns a duration, which goes out in seconds.
	internal def returnsDuration(hit reflection.AttrHit) bool {
		let fn = reflection.asFunction(hit.node)
		return !(fn is none) && fn.signature.result.typeName.trimPrefix("builtin.") == "duration"
	}

	// An action as `list` gives it: its label, the confirmation to ask and
	// an input per parameter.
	internal def actionJSON(hit reflection.AttrHit) string {
		let label = argumentOf(hit, "label", hit.node.name)
		let confirm = argumentOf(hit, "confirm", "")
		let params = string[]
		let choices = argumentOf(hit, "choices", "")
		let fn = reflection.asFunction(hit.node)
		if !(fn is none) {
			for let (i, param) in fn.signature.parameters {
				params.push(paramJSON(param, i == 0 ?? (choices, "")))
			}
		}
		let sets = argumentOf(hit, "sets", "")
		let setsJSON = sets == "" ?? ("", `,"sets":` + quote(sets))
		let row = argumentOf(hit, "row", "")
		let rowJSON = ""
		let dot = row.indexOf(".")
		if dot > 0 {
			rowJSON = `,"row":{"member":` + quote(row[:dot]) + `,"column":` + quote(row[dot + 1:]) + `}`
		}
		return `{"action":` + quote(hit.node.name) + `,"label":` + quote(label) + `,"confirm":` + quote(confirm) + rowJSON + setsJSON + `,"params":[` + params.join(",") + `]}`
	}

	// A parameter as the IDE draws its input: name, type, the enum's choices,
	// the Choices member that offers its values (choicesFrom) and the default
	// as written.
	internal def paramJSON(param reflection.ParameterDescriptor, choicesFrom string = "") string {
		let kind = paramKind(param.paramType)
		let parts = [`"name":` + quote(param.node.name), `"type":` + quote(kind)]
		if kind == "enum" {
			let choices = string[]
			for let (_, member) in reflection.members(param.paramType) {
				choices.push(quote(member.node.name))
			}
			parts.push(`"choices":[` + choices.join(",") + `]`)
		}
		parts.push(`"choicesFrom":` + quote(choicesFrom)) unless choicesFrom == ""
		parts.push(`"default":` + quote(param.defaultLiteral)) unless param.defaultLiteral == ""
		return `{` + parts.join(",") + `}`
	}

	// The protocol's name for a parameter's type: string, int, float, bool,
	// duration or enum; "" for one an action cannot take.
	internal def paramKind(typ reflection.TypeDescriptor) string {
		return "" when typ.optional || typ.errorable || typ.future
		return "enum" when typ.kind == reflection.TypeKind.Enum
		// The prelude declares string, bool and duration as types of its own:
		// reflection names them `builtin.string` and so on.
		let name = typ.typeName.trimPrefix("builtin.")
		return "string" when name == "string"
		return "bool" when name == "bool"
		return "duration" when name == "duration"
		return "float" when name == "float" || name == "float64" || name == "float32"
		return "int" when ["int", "int8", "int16", "int32", "int64", "uint", "uint8", "uint16", "uint32", "uint64", "byte"].includes(name)
		return ""
	}

	// Every service the program holds: its status, members and actions, and
	// whether a running one has a lab.
	internal def listReply() string {
		let parts = string[]
		for let (_, info) in Runtime.services() {
			let members = string[]
			let actions = string[]
			for let (_, hit) in publishedMembers(info.name) {
				if kindOf(hit) == "action" {
					actions.push(actionJSON(hit))
				} else {
					members.push(memberJSON(hit))
				}
			}
			let running = info.status == ServiceStatus.Started
			let lab = running && !(labOf(info.name) is none)
			let description = descriptionOf(info.name, running)
			let since = "null"
			let started = info.startTime
			since = (started.unixNs() / 1000000).str() unless started is none
			let tail = info.name.split(".").last()
			let short = tail is none ?? (info.name, tail)
			parts.push(`{"name":` + quote(info.name) + `,"short":` + quote(short) + `,"description":` + quote(description) + `,"status":` + quote("{info.status}") + `,"since":` + since + `,"restarts":` + info.restartCount.str() + `,"lab":` + "{lab}" + `,"members":[` + members.join(",") + `],"actions":[` + actions.join(",") + `]}`)
		}
		return `{"kind":"list","services":[` + parts.join(",") + `]}`
	}

	// The metrics the Diagnostics service holds whose names start with prefix
	// (every one for ""), as a panel table: name, labels, kind, value and
	// unit. A panel lists the counters that belong to its service with it.
	def metricsTable(prefix string = "") IdeTable {
		let rows = string[][]
		for let (_, held) in Diagnostics.series() {
			continue unless held.name.startsWith(prefix)
			let labels = string[]
			for let (_, key) in held.labels.keys().sort((a, b) => a < b) {
				labels.push("{key}={held.labels[key]}")
			}
			let (kind, value) = metricText(held.metric)
			rows.push([held.name, labels.join(" "), kind, value, held.unit])
		}
		return IdeTable{columns: ["Metric", "Labels", "Kind", "Value", "Unit"], rows: rows}
	}

	// A metric's kind and value as a panel shows them: the number, or for a
	// histogram its count, mean and p99.
	internal def metricText(metric Metric) (string, string) {
		match metric {
			case Counter:
				return ("counter", "{metric.value()}")
			case Gauge:
				return ("gauge", reflection.scalarText(metric.value()))
			case Toggle:
				return ("toggle", "{metric.value()}")
			case Histogram:
				let stats = metric.value()
				return ("histogram", stats.count.str() + " samples, mean " + reflection.scalarText(stats.mean) + ", p99 " + reflection.scalarText(stats.p99))
		}
	}

	// Whether a name (an environment variable, a configuration key) looks like
	// it holds a secret: a panel shows such a value only through an action
	// that reveals it, so it does not end up in a screenshot or a recording.
	def secretShaped(name string) bool {
		let lower = name.lower()
		for let (_, word) in secretWords {
			return true when lower.contains(word)
		}
		return false
	}

	internal const secretWords = ["token", "secret", "password", "passwd", "pwd", "key", "auth", "credential", "cookie", "session", "private"]

	// What a panel shows in place of a hidden value.
	def hiddenValue(value string) string {
		return value == "" ?? ("", "(hidden, {value.len()} characters)")
	}

	// The `description` a service declares: the literal the program carries,
	// for a stopped service too, else the field of a running one.
	internal def descriptionOf(svcName string, running bool) string {
		let declared = __service_description(svcName)
		return declared unless declared == "" && running
		let recv = reflection.serviceInstance(svcName)
		return "" when recv is none
		let field = reflection.field(recv, "description")
		return field is none ?? ("", field.asString())
	}

	internal def metricsReply() string {
		let memory = Runtime.memoryUsage()
		let series = string[]
		for let (_, held) in Diagnostics.series() {
			let labels = string[]
			for let (_, key) in held.labels.keys().sort((a, b) => a < b) {
				labels.push(quote(key) + ":" + quote(held.labels[key]))
			}
			series.push(`{"name":` + quote(held.name) + `,"labels":{` + labels.join(",") + `},"unit":` + quote(held.unit) + `,"description":` + quote(held.description) + `,"metric":` + encodeMetric(held.metric) + `}`)
		}
		let mem = `{"liveBytes":` + memory.liveBytes.str() + `,"totalAllocBytes":` + memory.totalAllocBytes.str() + `,"totalFreeBytes":` + memory.totalFreeBytes.str() + `,"allocCount":` + memory.allocCount.str() + `,"freeCount":` + memory.freeCount.str() + `}`
		return `{"kind":"metrics","cpu":` + encodeHistogram(Runtime.cpuUsage()) + `,"memory":` + mem + `,"series":[` + series.join(",") + `]}`
	}

	// parseDurationMs converts a duration literal's source text ("500ms",
	// "1s", "2m") to milliseconds; unparseable text falls back to 1000.
	internal def parseDurationMs(text string) int64 {
		let t = text.trim()
		let unitNs = int64(1000000000)
		let num = t
		if t.endsWith("ms") {
			num = t.trimSuffix("ms")
			unitNs = 1000000
		} else if t.endsWith("us") {
			num = t.trimSuffix("us")
			unitNs = 1000
		} else if t.endsWith("ns") {
			num = t.trimSuffix("ns")
			unitNs = 1
		} else if t.endsWith("h") {
			num = t.trimSuffix("h")
			unitNs = 3600000000000
		} else if t.endsWith("m") {
			num = t.trimSuffix("m")
			unitNs = 60000000000
		} else if t.endsWith("s") {
			num = t.trimSuffix("s")
			unitNs = 1000000000
		}
		let v = num.toInt<int64>()
		return 1000 when v <= 0
		return v * unitNs / 1000000
	}

	internal def encodeMemberValue(value any) string {
		return "null" when value is none
		match value {
			case IdeTable:
				return encodeTable(value)
			case IdeLog:
				return encodeLog(value)
			case string:
				let sv string = value
				return quote(sv)
			case bool:
				return "{value}"
			case byte, uint8, int8, int16, int32, int64, int, uint16, uint32, uint64, uint, int128, uint128:
				return "{value}"
			case float:
				let number float = value
				return jsonNumber(float64(number))
			case float64:
				let number float64 = value
				return jsonNumber(number)
			case float32:
				let number float32 = value
				return jsonNumber(float64(number))
			case float16:
				let number float16 = value
				return jsonNumber(float64(number))
			case float128:
				let number float128 = value
				return jsonNumber(float64(number))
			case duration:
				let span duration = value
				return jsonNumber(float64(int64(span)) / 1000000000.0)
			case string[]:
				let texts string[] = value
				let items = string[]
				for let (_, text) in texts {
					items.push(quote(text))
				}
				return "[" + items.join(",") + "]"
			default:
		}
		return quote("{value}")
	}

	internal def encodeTable(table IdeTable) string {
		let cols = string[]
		for let (_, c) in table.columns {
			cols.push(quote(c))
		}
		let rows = string[]
		for let (_, row) in table.rows {
			let cells = string[]
			for let (_, cell) in row {
				cells.push(quote(cell))
			}
			rows.push("[" + cells.join(",") + "]")
		}
		return `{"columns":[` + cols.join(",") + `],"rows":[` + rows.join(",") + `]}`
	}

	internal def encodeLog(log IdeLog) string {
		let entries = string[]
		for let (_, entry) in log.entries {
			let fields = string[]
			for let (_, pair) in entry.fields {
				continue unless pair.len() == 2
				fields.push("[" + quote(pair[0]) + "," + quote(pair[1]) + "]")
			}
			entries.push(`{"time":` + entry.time.str() + `,"level":` + quote(entry.level) + `,"source":` + quote(entry.source) + `,"at":` + quote(entry.at) + `,"message":` + quote(entry.message) + `,"fields":[` + fields.join(",") + `]}`)
		}
		return `{"entries":[` + entries.join(",") + `]}`
	}

	// A number as JSON, in its shortest exact form: null for one JSON cannot
	// hold (NaN, an infinity).
	internal def jsonNumber(value float64) string {
		return "null" when value != value || value - value != 0.0
		return reflection.scalarText(value)
	}

	// A metric's value: a number for a counter or gauge, a bool for a toggle,
	// and for a histogram its statistics with the newest sample.
	internal def encodeMetric(metric Metric) string {
		match metric {
			case Counter:
				return `{"kind":"counter","value":` + metric.value().str() + `}`
			case Gauge:
				return `{"kind":"gauge","value":` + jsonNumber(metric.value()) + `}`
			case Toggle:
				return `{"kind":"toggle","value":` + "{metric.value()}" + `}`
			case Histogram:
				return encodeHistogram(metric)
		}
	}

	internal def encodeHistogram(histogram Histogram) string {
		let stats = histogram.value()
		let newest = histogram.last()
		let last = "null"
		last = jsonNumber(newest) unless newest is none
		return `{"kind":"histogram","last":` + last + `,"count":` + stats.count.str() + `,"min":` + jsonNumber(stats.min) + `,"max":` + jsonNumber(stats.max) + `,"mean":` + jsonNumber(stats.mean) + `,"p50":` + jsonNumber(stats.p50) + `,"p90":` + jsonNumber(stats.p90) + `,"p99":` + jsonNumber(stats.p99) + `}`
	}
}
