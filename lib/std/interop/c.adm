partial module std.interop {
	use std.reflection::*

	// c marks declarations as backed by the C toolchain.
	//
	// Module form:
	// - Treated as a header/include dependency for the C backend when compiling
	//   the module's signature-only declarations.
	//
	// Function form:
	// - Declares a signature-only function binding to a C symbol. `header` is
	//   optional when the module already provides it.
	meta def c(target ModuleMetaContext, header string) {
		// intrinsic
	}

	meta def c(target FunctionMetaContext, header string = "", symbol string = "", name string = "", ret string = "", params string[] = []) {
		// intrinsic
	}
}
