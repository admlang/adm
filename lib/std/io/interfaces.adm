partial module std.io {
	// Reader is the interface that wraps the basic read method.
	//
	// `read` copies up to `buf.len()` bytes into `buf` and returns how many it
	// copied, `0 <= n <= buf.len()`. It may return fewer bytes than asked for
	// even when more are coming, so callers loop (or use `readFull`).
	//
	// End of stream: once no more bytes will ever arrive, `read` returns `0`
	// for a non-empty `buf`, without an error, on that call and every later
	// one. A zero return with a non-empty buffer therefore means "end of
	// stream", never "try again". An empty `buf` returns `0` at once and says
	// nothing about the stream. Errors are for failures (a closed handle, a
	// broken connection, corrupt input), not for reaching the end.
	interface Reader {
		def read(buf byte[]) !int
	}

	// Writer is the interface that wraps the basic Write method.
	//
	// Write writes len(p) bytes from p to the underlying data stream.
	// It returns the number of bytes written from p (0 <= n <= len(p))
	// and any error encountered that caused the write to stop early.
	interface Writer {
		def write(buf byte[]) !int
	}

	// Closer is the interface that wraps the basic Close method.
	interface Closer {
		def close() !none
	}

	// ReadWriter is the interface that groups the basic Read and Write methods.
	interface ReadWriter {
		Reader
		Writer
	}

	// ReadCloser is the interface that groups the basic Read and Close methods.
	interface ReadCloser {
		Reader
		Closer
	}

	// WriteCloser is the interface that groups the basic Write and Close methods.
	interface WriteCloser {
		Writer
		Closer
	}

	// ReadWriteCloser is the interface that groups the basic Read, Write and Close methods.
	interface ReadWriteCloser {
		Reader
		Writer
		Closer
	}
}
