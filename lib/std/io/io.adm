partial module std.io {
	// Fills `buf` completely, looping over `r.read` until every byte is in
	// place, and returns `buf.len()`. Fails when the stream ends first, with
	// a message naming how many bytes did arrive; a failure from `r.read`
	// propagates as is. An empty `buf` returns 0 without reading.
	def readFull(r Reader, buf byte[]) !int {
		let want = buf.len()
		let n = 0
		for n < want {
			let got = try r.read(buf[n:])
			fail "io: unexpected end of stream ({n} of {want} bytes)" when got == 0
			n += got
		}
		return n
	}
}
