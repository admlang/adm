partial module std.io {
	// Fills `buf` completely, looping over `r.read` until every byte is in
	// place, and returns `buf.len()`. Fails when the stream ends first, with
	// a message naming how many bytes did arrive; a failure from `r.read`
	// propagates as is. An empty `buf` returns 0 without reading.
	def readFull(r Reader, buf byte[]) !int {
		let want = buf.len()
		let n = 0
		for n < want {
			let got = try r.read(buf[n:])
			fail "io: unexpected end of stream ({n} of {want} bytes)" when got == 0
			n += got
		}
		return n
	}

	// Copies everything `from` reads into `to`, until `from` returns 0,
	// and returns the byte count. Fails when a read or a write does, or
	// a write moves nothing.
	def copy(from Reader, to Writer) !int64 {
		let buf byte[] = []
		buf.len(32 * 1024)
		let total int64 = 0
		for {
			let n = try from.read(buf)
			break when n <= 0
			let off = 0
			for off < n {
				let w = try to.write(buf[off:n])
				fail "io: write moved no bytes" when w <= 0
				off += w
			}
			total += int64(n)
		}
		return total
	}
}
