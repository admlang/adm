partial module std.io {
	use std.testing

	// A reader over a byte array that hands out at most `chunk` bytes per
	// call, to exercise short reads and the end-of-stream convention.
	internal type ChunkReader {
		internal data  byte[]
		internal pos   int
		internal chunk int

		def new(data byte[], chunk int) {
			self.data = data
			self.chunk = chunk
			pos = 0
		}

		def read(buf byte[]) !int {
			return 0 when buf.len() == 0 || pos >= data.len()
			let n = data.len() - pos
			n = chunk when n > chunk
			n = buf.len() when n > buf.len()
			for let i = 0; i < n; i++ {
				buf[i] = data[pos + i]
			}
			pos += n
			return n
		}
	}

	// A writer that keeps what it is given, at most `chunk` bytes a call.
	internal type ChunkWriter {
		data  byte[]
		chunk int

		def new(chunk int) {
			self.chunk = chunk
		}

		def write(buf byte[]) !int {
			let n = buf.len()
			n = chunk when n > chunk
			data = data + buf[:n]
			return n
		}
	}

	check "IO" {
		@test()
		def readFullLoopsOverShortReads() !none {
			let r = new ChunkReader("hello world".bytes(), 3)
			let buf = byte[]
			buf.len(11)
			let n = try readFull(r, buf)
			assert n == 11
			assert string(buf) == "hello world"
			// The stream is now at its end: reads return 0, not an error.
			assert (try r.read(buf)) == 0
		}

		@test()
		def readFullFailsOnShortStream() !none {
			let r = new ChunkReader("abc".bytes(), 2)
			let buf = byte[]
			buf.len(5)
			let err = readFull(r, buf) onerror (e error) {
				recover -1
			}
			assert err == -1
		}

		@test()
		def readAllGathersShortReads() !none {
			let r = new ChunkReader("hello world".bytes(), 3)
			assert string(try readAll(r)) == "hello world"
			assert (try readAll(r)).len() == 0
			return none
		}

		@test()
		def copyMovesEverythingThroughShortReadsAndWrites() !none {
			let r = new ChunkReader("hello world".bytes(), 3)
			let w = new ChunkWriter(2)
			assert (try copy(r, w)) == 11
			assert string(w.data) == "hello world"
			assert (try copy(r, w)) == 0
		}

		@test()
		def readFullEmptyBuffer() !none {
			let r = new ChunkReader("abc".bytes(), 2)
			let buf = byte[]
			assert (try readFull(r, buf)) == 0
		}
	}
}
