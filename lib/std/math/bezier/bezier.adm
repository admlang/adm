partial module std.math.bezier {
	// Bézier curves over one numeric axis: a point on the curve, or its
	// derivative, at parameter t in [0, 1]. `T` is the coordinate type; the
	// arithmetic runs in float and the result converts back, so an integer
	// axis truncates. Curves over points live in std.math.geom.

	// The point on the line from p0 to p1 at t: p0 at 0, p1 at 1.
	def linear<T: Numeric>(p0, p1 T, t float) T {
		return T(float(p0) + (float(p1) - float(p0)) * t)
	}

	// The point on the quadratic curve from p0 to p2 with control p1 at t.
	def quadratic<T: Numeric>(p0, p1, p2 T, t float) T {
		let u = 1.0 - t
		return T(u * u * float(p0) + 2.0 * u * t * float(p1) + t * t * float(p2))
	}

	// The point on the cubic curve from p0 to p3 with controls p1 and p2 at t.
	def cubic<T: Numeric>(p0, p1, p2, p3 T, t float) T {
		let u = 1.0 - t
		return T(u * u * u * float(p0) + 3.0 * u * u * t * float(p1) + 3.0 * u * t * t * float(p2) + t * t * t * float(p3))
	}

	// The derivative of the quadratic curve at t: its velocity along the axis.
	def quadraticDerivative<T: Numeric>(p0, p1, p2 T, t float) T {
		return T(2.0 * (1.0 - t) * (float(p1) - float(p0)) + 2.0 * t * (float(p2) - float(p1)))
	}

	// The derivative of the cubic curve at t: its velocity along the axis.
	def cubicDerivative<T: Numeric>(p0, p1, p2, p3 T, t float) T {
		let u = 1.0 - t
		return T(3.0 * u * u * (float(p1) - float(p0)) + 6.0 * u * t * (float(p2) - float(p1)) + 3.0 * t * t * (float(p3) - float(p2)))
	}

	// The parameter s at which the unit cubic axis with controls x1 and x2
	// (from 0 to 1, as the x axis of a CSS `cubic-bezier`) reaches x: Newton's
	// method from the linear guess, bisection when the slope is too flat to
	// trust. x1 and x2 are expected in [0, 1], which keeps the axis monotonic
	// and the answer unique; x outside [0, 1] gives the nearest end.
	def cubicParameter(x1, x2, x float) float {
		return 0.0 when x <= 0.0
		return 1.0 when x >= 1.0
		let s = x
		for let i = 0; i < 8; i++ {
			let slope = cubicDerivative(0.0, x1, x2, 1.0, s)
			break when slope.abs() < 1e-6
			let diff = cubic(0.0, x1, x2, 1.0, s) - x
			return s when diff.abs() < 1e-7
			s -= diff / slope
		}
		if s < 0.0 || s > 1.0 || (cubic(0.0, x1, x2, 1.0, s) - x).abs() > 1e-7 {
			let lo = 0.0
			let hi = 1.0
			for let i = 0; i < 60; i++ {
				s = (lo + hi) / 2.0
				let diff = cubic(0.0, x1, x2, 1.0, s) - x
				break when diff.abs() < 1e-9
				if diff > 0.0 {
					hi = s
				} else {
					lo = s
				}
			}
		}
		return s
	}
}
