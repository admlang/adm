partial module std.math.bezier {
	use (
		std.testing
		std.math
	)

	check "Bezier" {
		@test()
		def endpoints() {
			assert linear(2.0, 6.0, 0.0) == 2.0
			assert linear(2.0, 6.0, 1.0) == 6.0
			assert quadratic(1.0, 5.0, 3.0, 0.0) == 1.0
			assert quadratic(1.0, 5.0, 3.0, 1.0) == 3.0
			assert cubic(1.0, 5.0, -2.0, 3.0, 0.0) == 1.0
			assert cubic(1.0, 5.0, -2.0, 3.0, 1.0) == 3.0
		}

		@test()
		def midpoints() {
			assert math.approx(linear(2.0, 6.0, 0.25), 3.0, 1e-12)
			// (1 + 2*5 + 3) / 4
			assert math.approx(quadratic(1.0, 5.0, 3.0, 0.5), 3.5, 1e-12)
			// (1 + 3*5 + 3*(-2) + 3) / 8
			assert math.approx(cubic(1.0, 5.0, -2.0, 3.0, 0.5), 1.625, 1e-12)
		}

		@test()
		def integerAxis() {
			assert linear(10, 20, 0.5) == 15
			assert quadratic(0, 10, 0, 0.5) == 5
			assert cubic(0, 0, 0, 8, 0.5) == 1
		}

		@test()
		def derivatives() {
			// Straight line at constant speed: derivative is the span.
			assert math.approx(quadraticDerivative(0.0, 2.0, 4.0, 0.3), 4.0, 1e-12)
			assert math.approx(cubicDerivative(0.0, 1.0, 2.0, 3.0, 0.7), 3.0, 1e-12)
			// A symmetric bump turns at its middle.
			assert math.approx(quadraticDerivative(0.0, 1.0, 0.0, 0.5), 0.0, 1e-12)
			assert math.approx(cubicDerivative(0.0, 1.0, 1.0, 0.0, 0.5), 0.0, 1e-12)
			// Finite difference agrees with the closed form.
			let h = 1e-6
			let fd = (cubic(1.0, 5.0, -2.0, 3.0, 0.4 + h) - cubic(1.0, 5.0, -2.0, 3.0, 0.4 - h)) / (2.0 * h)
			assert math.approx(cubicDerivative(1.0, 5.0, -2.0, 3.0, 0.4), fd, 1e-6)
		}

		@test()
		def parameter() {
			// The identity axis maps x to itself.
			assert math.approx(cubicParameter(1.0 / 3.0, 2.0 / 3.0, 0.3), 0.3, 1e-9)
			// Any axis inverts: cubic(0, x1, x2, 1, s) recovers x.
			let s = cubicParameter(0.42, 0.58, 0.7)
			assert math.approx(cubic(0.0, 0.42, 0.58, 1.0, s), 0.7, 1e-7)
			let flat = cubicParameter(0.0, 1.0, 0.25)
			assert math.approx(cubic(0.0, 0.0, 1.0, 1.0, flat), 0.25, 1e-7)
			assert cubicParameter(0.25, 0.75, 0.0) == 0.0
			assert cubicParameter(0.25, 0.75, 1.0) == 1.0
		}
	}
}
