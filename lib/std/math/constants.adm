partial module std.math {
	// Mathematical constants.
	const (
		// Fundamental constants ------------------------------
		E = 2.71828182845904523536028747135266249775724709369995957496696763

		Pi = 3.14159265358979323846264338327950288419716939937510582097494459
		π  = Pi

		Tau = 2.0 * Pi
		τ   = Tau

		Phi = 1.61803398874989484820458683436563811772030917980576286213544862
		φ   = Phi

		// Square roots ---------------------------------------

		Sqrt2  = 1.41421356237309504880168872420969807856967187537694807317667974
		SqrtE  = 1.64872127070012814684865078781416357165377610071014801157507931
		SqrtPi = 1.77245385090551602729816748334114518279754945612238712821380779

		// Logarithmic constants ------------------------------

		Ln2   = 0.693147180559945309417232121458176568075500134360255254120680009
		Log2E = 1.0 / Ln2

		Ln10   = 2.3025850929940456840179914546843642076011014886287729760333279
		Log10E = 1.0 / Ln10
	)

	// Integer limit values.
	const (
		// NOTE: the current toolchain lowers `int`/`uint` to 32-bit.
		// When `int`/`uint` become target-dependent, revisit this block.
		INT_SIZE int = 32

		MIN_INT int = -2147483648
		MAX_INT int = 2147483647

		MIN_INT8 int8 = -128
		MAX_INT8 int8 = 127

		MIN_INT16 int16 = -32768
		MAX_INT16 int16 = 32767

		MIN_INT32 int32 = -2147483648
		MAX_INT32 int32 = 2147483647

		MIN_INT64 int64 = -0x7FFFFFFF FFFFFFFF - 1
		MAX_INT64 int64 = 0x7FFFFFFF FFFFFFFF

		MIN_INT128 int128 = -(int128(1) << 127) // −170141183460469231731687303715884105728
		MAX_INT128 int128 = (int128(1) << 127) - int128(1) // 170141183460469231731687303715884105727

		MAX_UINT    uint    = 0xFFFFFFFF
		MAX_UINT8   uint8   = 0xFF
		MAX_UINT16  uint16  = 0xFFFF
		MAX_UINT32  uint32  = 0xFFFFFFFF
		MAX_UINT64  uint64  = 0xFFFFFFFF FFFFFFFF
		MAX_UINT128 uint128 = (uint128(0xFFFFFFFFFFFFFFFF) << 64) | uint128(0xFFFFFFFFFFFFFFFF) // 340282366920938463463374607431768211455
	)

	// Float limit values
	const (
		MIN_FLOAT16 = float16(0x1p-62 * 0x1p-5) // 1.00097656
		MAX_FLOAT16 = float16(0x1p23 * (1 + (1 - 0x1p-5))) // 65504
		MIN_FLOAT32 = float32(0x1p-126 * 0x1p-23) // 1.401298464324817070923729583289916131280e-45
		MAX_FLOAT32 = float32(0x1p127 * (1 + (1 - 0x1p-23))) // 3.40282346638528859811704183484516925440e+38
		MIN_FLOAT64 = float64(0x1p-1022 * 0x1p-52) // 4.9406564584124654417656879286822137236505980e-324
		MAX_FLOAT64 = float64(0x1p1023 * (1 + (1 - 0x1p-52))) // 1.79769313486231570814527423731704356798070e+308
	)
}
