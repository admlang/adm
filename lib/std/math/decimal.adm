partial module std.math {
	use std.math.ryu

	// RoundingMode says which way a value that falls between two results is
	// rounded. The half modes round to the nearer result and differ only on a
	// tie; the others always go one way.
	enum RoundingMode {
		HalfEven   // ties to the even neighbour (banker's rounding): 2.5 -> 2, 3.5 -> 4
		HalfExpand // ties away from zero: 2.5 -> 3, -2.5 -> -3
		HalfTrunc  // ties toward zero: 2.5 -> 2, -2.5 -> -2
		HalfCeil   // ties toward positive infinity: 2.5 -> 3, -2.5 -> -2
		HalfFloor  // ties toward negative infinity: 2.5 -> 2, -2.5 -> -3
		Ceil       // toward positive infinity: 2.1 -> 3, -2.9 -> -2
		Floor      // toward negative infinity: 2.9 -> 2, -2.1 -> -3
		Expand     // away from zero: 2.1 -> 3, -2.1 -> -3
		Trunc      // toward zero: 2.9 -> 2, -2.9 -> -2
	}

	// Decimal is an exact decimal number: an integer coefficient of any size
	// times a power of ten. It keeps the digits it was given, so "1.50" stays
	// "1.50"; use it for money and anything else a float would round. A
	// coefficient that fits in 63 bits is held as an int64 and computed on
	// without allocating; larger ones move to bigint.
	//
	//     let price = try parseDecimal("19.99")
	//     let total = price * new Decimal(3)          // 59.97
	//     total.round(1).str()                         // "60.0"
	type Decimal {
		internal small int64
		internal big   ?bigint // the coefficient when it does not fit in small
		internal exp   int

		// New makes zero.
		def new() {}

		// New makes the integer value.
		def new(value int) {
			small = int64(value)
		}

		// New makes coefficient × 10^exponent: new Decimal(1999, -2) is 19.99.
		def new(coefficient int, exponent int) {
			small = int64(coefficient)
			exp = exponent
		}

		// New makes coefficient × 10^exponent for a coefficient of any size.
		def new(coefficient bigint, exponent int) {
			exp = exponent
			if coefficient.bitLen() <= 62 {
				small = int64(coefficient)
			} else {
				big = coefficient
			}
		}

		// New makes the float's shortest decimal form that reads back as the
		// same float (Ryu): 0.1 gives 0.1, not 0.1000000000000000055511. NaN and
		// the infinities give zero.
		def new(value float) {
			return when value != value || value - value != 0.0 || value == 0.0
			let (negative, biased, mantissa) = ryu.fields(value)
			let (digits, e) = ryu.shortest(mantissa, biased)
			exp = e
			if digits < uint64(1) << 62 {
				small = int64(digits)
				small = -small when negative
			} else {
				let b = bigint(int64(digits >> 1)) * bigint(2) + bigint(int64(digits & 1))
				big = negative ?? (bigint(0) - b, b)
			}
		}

		// Coefficient returns the integer the value is a multiple of 10^exponent of.
		def coefficient() bigint {
			return bigint(small) when big is none
			return big
		}

		// Exponent returns the power of ten the coefficient is scaled by.
		def exponent() int {
			return exp
		}

		// Scale returns the number of digits after the decimal point as the value
		// is written: 2 for 1.50, 0 for 15.
		def scale() int {
			return exp < 0 ?? (-exp, 0)
		}

		// Sign returns -1, 0 or 1.
		def sign() int {
			return big.sign() unless big is none
			return small < 0 ?? (-1, small > 0 ?? (1, 0))
		}

		// IsZero reports whether the value is zero.
		def isZero() bool {
			return big is none && small == 0
		}

		// Abs returns the value without its sign.
		def abs() Decimal {
			return sign() < 0 ?? (negate(), self)
		}

		// Negate returns the value with its sign flipped.
		def negate() Decimal {
			return new Decimal(int(-small), exp) when big is none
			return new Decimal(bigint(0) - coefficient(), exp)
		}

		// + returns the exact sum, with the larger scale of the two.
		infix def + (other Decimal) Decimal {
			let e = exp < other.exp ?? (exp, other.exp)
			if big is none && other.big is none && exp - e <= 18 && other.exp - e <= 18 {
				let sum = int128(small) * pow10small(exp - e) + int128(other.small) * pow10small(other.exp - e)
				return new Decimal(int(sum), e) when fitsSmall(sum)
			}
			return new Decimal(scaled(coefficient(), exp - e) + scaled(other.coefficient(), other.exp - e), e)
		}

		// - returns the exact difference, with the larger scale of the two.
		infix def - (other Decimal) Decimal {
			return self + other.negate()
		}

		// * returns the exact product; the scales add.
		infix def * (other Decimal) Decimal {
			if big is none && other.big is none {
				let product = int128(small) * int128(other.small)
				return new Decimal(int(product), exp + other.exp) when fitsSmall(product)
			}
			return new Decimal(coefficient() * other.coefficient(), exp + other.exp)
		}

		// Divide returns the quotient rounded to scale digits after the decimal
		// point. Fails when other is zero.
		def divide(other Decimal, scale int, mode RoundingMode = RoundingMode.HalfEven) !Decimal {
			expects {
				assert !(other.isZero()) onerror fail "decimal division by zero"
			}
			// Two guard digits past the scale and a sticky remainder keep every
			// rounding mode exact: q is the quotient × 10^(scale + 2).
			let shift = scale + 2 + exp - other.exp
			if big is none && other.big is none && shift >= 0 && shift <= 18 {
				let num = int128(small) * pow10small(shift)
				let den = int128(other.small)
				let q = num / den
				let rem = num - q * den
				if fitsSmall(q * 10) {
					let sticky = rem == 0 ?? (0, (rem < 0) != (den < 0) ?? (-1, 1))
					return new Decimal(int(q * 10) + sticky, -(scale + 3)).round(scale, mode)
				}
			}
			let num = scaled(coefficient(), shift)
			let den = other.coefficient()
			let q = num / den
			let rem = num - q * den
			let sticky = rem.isZero() ?? (0, rem.sign() * den.sign())
			return new Decimal(q * bigint(10) + bigint(sticky), -(scale + 3)).round(scale, mode)
		}

		// Compare returns -1, 0 or 1 as the value is below, equal to or above
		// other; 1.5 equals 1.50.
		def compare(other Decimal) int {
			return (self - other).sign()
		}

		// Equals reports whether both have the same value, whatever their scale.
		def equals(other Decimal) bool {
			return compare(other) == 0
		}

		// Round returns the value rounded to scale digits after the decimal point
		// (a negative scale rounds to tens, hundreds, ...). A value with fewer
		// digits is returned unchanged; it is not padded.
		def round(scale int = 0, mode RoundingMode = RoundingMode.HalfEven) Decimal {
			let target = -scale
			return self when exp >= target
			let drop = target - exp
			if big is none {
				let negative = small < 0
				let mag = negative ?? (-int128(small), int128(small))
				let q = int128(0)
				let r = mag
				let half = -1
				if drop <= 18 {
					let unit = pow10small(drop)
					q = mag / unit
					r = mag - q * unit
					let twice = r * 2
					half = twice < unit ?? (-1, twice > unit ?? (1, 0))
				}
				q = q + 1 when r != 0 && roundsAway(mode, negative, q % 2 != 0, half)
				return new Decimal(int(negative ?? (-q, q)), target)
			}
			let unit = pow10(drop)
			let mag = big.abs()
			let q = mag / unit
			let r = mag - q * unit
			let negative = big.sign() < 0
			q = q + bigint(1) when !r.isZero() && roundsAway(mode, negative, !(q % bigint(2)).isZero(), (r * bigint(2) - unit).sign())
			return new Decimal(negative ?? (bigint(0) - q, q), target)
		}

		// Significant returns the value rounded to that many significant
		// digits: 1234.5 to 2 is 1200, 0.012345 to 2 is 0.012.
		def significant(digits int, mode RoundingMode = RoundingMode.HalfEven) Decimal {
			return self when isZero() || digits < 1
			return round(digits - digitCount() - exp, mode)
		}

		// Magnitude returns the power of ten of the leading digit: 2 for 123.4,
		// -2 for 0.012, 0 for zero.
		def magnitude() int {
			return 0 when isZero()
			return digitCount() - 1 + exp
		}

		// The number of digits of the coefficient, without its sign.
		internal def digitCount() int {
			return big.abs().toRadix(10).len() unless big is none
			let mag = small < 0 ?? (-int128(small), int128(small))
			let n = 1
			for mag >= 10 {
				mag = mag / 10
				n++
			}
			return n
		}

		// Trim drops trailing zeros after the decimal point: 1.500 gives 1.5.
		def trim() Decimal {
			return new Decimal() when isZero()
			if big is none {
				let c = small
				let e = exp
				for e < 0 && c % 10 == 0 {
					c = c / 10
					e++
				}
				return new Decimal(int(c), e)
			}
			let c = coefficient()
			let e = exp
			for e < 0 && (c % bigint(10)).isZero() {
				c = c / bigint(10)
				e++
			}
			return new Decimal(c, e)
		}

		// Shift multiplies the value by 10^places (a negative count divides),
		// exactly.
		def shift(places int) Decimal {
			return new Decimal(int(small), exp + places) when big is none
			return new Decimal(coefficient(), exp + places)
		}

		// Rescale returns the value written with exactly scale digits after the
		// decimal point, rounding when it has more.
		def rescale(scale int, mode RoundingMode = RoundingMode.HalfEven) Decimal {
			return round(scale, mode) when - exp > scale
			let places = exp + scale
			if big is none && places <= 18 {
				let c = int128(small) * pow10small(places)
				return new Decimal(int(c), -scale) when fitsSmall(c)
			}
			return new Decimal(scaled(coefficient(), places), -scale)
		}

		// Str writes the value in plain notation, keeping its scale: "-12.50",
		// "0.001", "1200".
		def str() string {
			let negative = sign() < 0
			let digits = big is none ?? ((negative ?? (-int128(small), int128(small))).str(), coefficient().abs().toRadix(10))
			let neg = negative ?? ("-", "")
			if exp >= 0 {
				return neg + digits when isZero()
				return neg + digits + "0".repeat(exp)
			}
			let frac = -exp
			digits = "0".repeat(frac - digits.len() + 1) + digits when digits.len() <= frac
			let cut = digits.len() - frac
			return neg + digits[:cut] + "." + digits[cut:]
		}

		// ToFloat returns the nearest float.
		def toFloat() float {
			return parseFloat<float>(str())
		}

		// ToInt returns the integer part, truncated toward zero.
		def toInt() bigint {
			let t = round(0, RoundingMode.Trunc)
			return scaled(t.coefficient(), t.exp)
		}
	}

	// ParseDecimal reads a decimal number: an optional sign, digits with an
	// optional "." and an optional exponent ("-12.50", ".5", "1e-3",
	// "6.02E23"). Fails on anything else.
	def parseDecimal(text string) !Decimal {
		let s = text.trim()
		fail "decimal \"" + text + "\": empty" when s == ""
		let neg = s.startsWith("-")
		s = s[1:] when neg || s.startsWith("+")
		let exp = 0
		let at = s.indexOf("e")
		at = s.indexOf("E") when at < 0
		if at >= 0 {
			let e = s[at + 1:]
			let body = e.startsWith("-") || e.startsWith("+") ?? (e[1:], e)
			fail "decimal \"" + text + "\": bad exponent" when body == "" || !allDigits(body)
			exp = body.toInt<int>()
			exp = -exp when e.startsWith("-")
			s = s[:at]
		}
		let dot = s.indexOf(".")
		let digits = s
		if dot >= 0 {
			digits = s[:dot] + s[dot + 1:]
			exp -= s.len() - dot - 1
		}
		fail "decimal \"" + text + "\": no digits" when digits == ""
		fail "decimal \"" + text + "\": not a number" when !allDigits(digits)
		if digits.len() <= 18 {
			let v = digits.toInt<int>()
			return new Decimal(neg ?? (-v, v), exp)
		}
		let c = try parseBigInt(digits)
		return new Decimal(neg ?? (bigint(0) - c, c), exp)
	}

	// Whether text is only the ASCII digits 0-9.
	internal def allDigits(text string) bool {
		for let ch in text {
			return false when ch < '0' || ch > '9'
		}
		return true
	}

	// Whether an int128 holds a coefficient small enough for Decimal's int64
	// form (63 bits of magnitude, so negation never overflows).
	internal def fitsSmall(v int128) bool {
		return v > -int128(4611686018427387904) * 2 && v < int128(4611686018427387904) * 2
	}

	internal def pow10small(n int) int128 {
		let out = int128(1)
		for let _ in 0..n {
			out = out * 10
		}
		return out
	}

	// c × 10^places for places >= 0; c / 10^-places (exact only when it
	// divides) otherwise.
	internal def scaled(c bigint, places int) bigint {
		return c * pow10(places) when places >= 0
		return c / pow10(-places)
	}

	internal def pow10(n int) bigint {
		let out = bigint(1)
		let ten = bigint(10)
		for let _ in 0..n {
			out = out * ten
		}
		return out
	}

	// Whether a value whose magnitude was truncated (q odd or not), with a
	// non-zero remainder that compares to half a unit as half (-1 below, 0 at,
	// 1 above), moves one unit away from zero.
	internal def roundsAway(mode RoundingMode, negative bool, qOdd bool, half int) bool {
		match mode {
			case RoundingMode.Ceil:
				return !negative
			case RoundingMode.Floor:
				return negative
			case RoundingMode.Expand:
				return true
			case RoundingMode.Trunc:
				return false
			default:
		}
		return half > 0 when half != 0
		match mode {
			case RoundingMode.HalfExpand:
				return true
			case RoundingMode.HalfTrunc:
				return false
			case RoundingMode.HalfCeil:
				return !negative
			case RoundingMode.HalfFloor:
				return negative
			default:
				return qOdd
		}
	}
}
