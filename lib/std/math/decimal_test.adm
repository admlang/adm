partial module std.math {
	use std.testing

	check "Decimal" {
		def d(text string) Decimal {
			return parseDecimal(text) onerror recover new Decimal(bigint(-999999), -99)
		}

		@test()
		def readsAndWrites() {
			assert d("-12.50").str() == "-12.50"
			assert d(".5").str() == "0.5"
			assert d("+7").str() == "7"
			assert d("1e-3").str() == "0.001"
			assert d("6.02E3").str() == "6020"
			assert d("0.000").str() == "0.000"
			assert d("1.50").scale() == 2
			assert d("123.4").magnitude() == 2 && d("0.012").magnitude() == -2 && new Decimal().magnitude() == 0
			assert d("-0.5").sign() == -1 && new Decimal().sign() == 0
			assert d("-0.5").negate().str() == "0.5" && d("-0.5").abs().str() == "0.5"
			assert parseDecimal("") is error
			assert parseDecimal("1.2.3") is error
			assert parseDecimal("12a") is error
			assert parseDecimal("1e") is error
			assert new Decimal(bigint(1999), -2).str() == "19.99"
			assert new Decimal(42).str() == "42"
		}

		@test()
		def convertsFloatsByTheirShortestForm() {
			assert new Decimal(0.1).str() == "0.1"
			assert new Decimal(1234567.5).str() == "1234567.5"
			assert new Decimal(-2.5e-7).str() == "-0.00000025"
			assert new Decimal(1e21).str() == "1000000000000000000000"
			assert new Decimal(0.1 + 0.2).str() == "0.30000000000000004"
			assert new Decimal(0.0).isZero()
			assert new Decimal(123.456).str() == "123.456"
			let tiny = new Decimal(5e-324)
			assert tiny.coefficient() == bigint(5) && tiny.exponent() == -324
			let huge = new Decimal(1.7976931348623157e308)
			assert huge.coefficient() == bigint(17976931348623157) && huge.exponent() == 292
			assert new Decimal(9007199254740992.0).str() == "9007199254740992"
			assert new Decimal(0.3).str() == "0.3"
		}

		@test()
		def calculatesExactly() !none {
			assert (d("0.1") + d("0.2")).str() == "0.3"
			assert (d("19.99") * new Decimal(3)).str() == "59.97"
			assert (d("10") - d("0.01")).str() == "9.99"
			assert (try d("1").divide(d("3"), 4)).str() == "0.3333"
			assert (try d("2").divide(d("3"), 2)).str() == "0.67"
			assert (try d("-2").divide(d("3"), 2, RoundingMode.Trunc)).str() == "-0.66"
			assert d("1").divide(new Decimal(), 2) is error
			assert (try d("1234.5").divide(d("0.05"), 0)).str() == "24690"
			assert (try d("0.1").divide(d("400"), 6)).str() == "0.000250"
			assert d("0.00").trim().str() == "0"
			assert d("1.5").equals(d("1.50"))
			assert d("1.5").compare(d("1.49")) == 1
			assert d("1.500").trim().str() == "1.5"
			assert d("12.345").shift(2).str() == "1234.5"
			assert d("1.5").rescale(3).str() == "1.500"
			assert d("-3.99").toInt() == bigint(-3)
			assert d("2.5").toFloat() == 2.5
			return none
		}

		@test()
		def roundsInEveryMode() {
			let cases = string["2.5", "-2.5", "3.5", "2.51", "-2.49", "2.1", "-2.1"]
			let want = map<string, string[]>{
				"HalfEven":   string["2", "-2", "4", "3", "-2", "2", "-2"],
				"HalfExpand": string["3", "-3", "4", "3", "-2", "2", "-2"],
				"HalfTrunc":  string["2", "-2", "3", "3", "-2", "2", "-2"],
				"HalfCeil":   string["3", "-2", "4", "3", "-2", "2", "-2"],
				"HalfFloor":  string["2", "-3", "3", "3", "-2", "2", "-2"],
				"Ceil":       string["3", "-2", "4", "3", "-2", "3", "-2"],
				"Floor":      string["2", "-3", "3", "2", "-3", "2", "-3"],
				"Expand":     string["3", "-3", "4", "3", "-3", "3", "-3"],
				"Trunc":      string["2", "-2", "3", "2", "-2", "2", "-2"],
			}
			let modes = RoundingMode[RoundingMode.HalfEven, RoundingMode.HalfExpand, RoundingMode.HalfTrunc, RoundingMode.HalfCeil, RoundingMode.HalfFloor, RoundingMode.Ceil, RoundingMode.Floor, RoundingMode.Expand, RoundingMode.Trunc]
			let names = string["HalfEven", "HalfExpand", "HalfTrunc", "HalfCeil", "HalfFloor", "Ceil", "Floor", "Expand", "Trunc"]
			for let m in 0..modes.len() {
				let expect = want[names[m]]
				for let i in 0..cases.len() {
					let got = d(cases[i]).round(0, modes[m]).str()
					println(names[m] + " " + cases[i] + ": " + got) when got != expect[i]
					assert got == expect[i]
				}
			}
			assert d("1234.5").round(-2).str() == "1200"
			assert d("1250").round(-2).str() == "1200"
			assert d("1234.5").significant(2).str() == "1200"
			assert d("0.012345").significant(2).str() == "0.012"
			assert d("9.99").round(1).str() == "10.0"
			assert d("1.2").round(3).str() == "1.2"
		}
	}
}
