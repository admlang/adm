partial module std.math.easing {
	use (
		std.math::(*)
		std.math.bezier
	)

	// Easing maps progress `t` in [0, 1] to an eased progress. The standard
	// curves return 0 at 0 and 1 at 1; the back and elastic curves overshoot
	// in between.
	type Easing = def(float) float

	// Constant speed.
	def linear(t float) float {
		return t
	}

	// Starts slowly and accelerates: t².
	def easeInQuad(t float) float {
		return t * t
	}

	// Starts quickly and decelerates: the mirror of easeInQuad.
	def easeOutQuad(t float) float {
		return reverse(easeInQuad, t)
	}

	// easeInQuad up to the middle, easeOutQuad after.
	def easeInOutQuad(t float) float {
		return 2.0 * t * t when t < 0.5
		let u = -2.0 * t + 2.0
		return 1.0 - u * u / 2.0
	}

	// Starts slowly and accelerates: t³.
	def easeInCubic(t float) float {
		return t * t * t
	}

	// Starts quickly and decelerates: the mirror of easeInCubic.
	def easeOutCubic(t float) float {
		return reverse(easeInCubic, t)
	}

	// easeInCubic up to the middle, easeOutCubic after.
	def easeInOutCubic(t float) float {
		return 4.0 * t * t * t when t < 0.5
		let u = -2.0 * t + 2.0
		return 1.0 - u * u * u / 2.0
	}

	// A quarter sine wave, starting slowly.
	def easeInSine(t float) float {
		return 1.0 - cos(t * Pi / 2.0)
	}

	// A quarter sine wave, ending slowly.
	def easeOutSine(t float) float {
		return sin(t * Pi / 2.0)
	}

	// Half a sine wave, slow at both ends.
	def easeInOutSine(t float) float {
		return -(cos(Pi * t) - 1.0) / 2.0
	}

	// Exponential growth from a standstill: 2^(10t - 10), exactly 0 at 0.
	def easeInExpo(t float) float {
		return 0.0 when t <= 0.0
		return 2.0 ** (10.0 * t - 10.0)
	}

	// Exponential decay to a standstill: 1 - 2^(-10t), exactly 1 at 1.
	def easeOutExpo(t float) float {
		return 1.0 when t >= 1.0
		return 1.0 - 2.0 ** (-10.0 * t)
	}

	// easeInExpo up to the middle, easeOutExpo after.
	def easeInOutExpo(t float) float {
		return 0.0 when t <= 0.0
		return 1.0 when t >= 1.0
		return 2.0 ** (20.0 * t - 10.0) / 2.0 when t < 0.5
		return (2.0 - 2.0 ** (-20.0 * t + 10.0)) / 2.0
	}

	// Pulls back below 0 before accelerating in.
	def easeInBack(t float) float {
		let c1 = 1.70158
		let c3 = c1 + 1.0
		return c3 * t * t * t - c1 * t * t
	}

	// Overshoots above 1 before settling.
	def easeOutBack(t float) float {
		let c1 = 1.70158
		let c3 = c1 + 1.0
		let u = t - 1.0
		return 1.0 + c3 * u * u * u + c1 * u * u
	}

	// Pulls back, then overshoots.
	def easeInOutBack(t float) float {
		let c1 = 1.70158
		let c2 = c1 * 1.525
		if t < 0.5 {
			let u = 2.0 * t
			return (u * u * ((c2 + 1.0) * u - c2)) / 2.0
		}
		let u = 2.0 * t - 2.0
		return (u * u * ((c2 + 1.0) * u + c2) + 2.0) / 2.0
	}

	// Oscillates with growing amplitude before arriving.
	def easeInElastic(t float) float {
		return 0.0 when t <= 0.0
		return 1.0 when t >= 1.0
		let c4 = 2.0 * Pi / 3.0
		return -(2.0 ** (10.0 * t - 10.0)) * sin((t * 10.0 - 10.75) * c4)
	}

	// Overshoots and oscillates with shrinking amplitude after arriving.
	def easeOutElastic(t float) float {
		return 0.0 when t <= 0.0
		return 1.0 when t >= 1.0
		let c4 = 2.0 * Pi / 3.0
		return 2.0 ** (-10.0 * t) * sin((t * 10.0 - 0.75) * c4) + 1.0
	}

	// Oscillates at both ends.
	def easeInOutElastic(t float) float {
		return 0.0 when t <= 0.0
		return 1.0 when t >= 1.0
		let c5 = 2.0 * Pi / 4.5
		let s = sin((20.0 * t - 11.125) * c5)
		return -(2.0 ** (20.0 * t - 10.0) * s) / 2.0 when t < 0.5
		return 2.0 ** (-20.0 * t + 10.0) * s / 2.0 + 1.0
	}

	// Bounces at the start: the mirror of easeOutBounce.
	def easeInBounce(t float) float {
		return 1.0 - easeOutBounce(1.0 - t)
	}

	// Lands and bounces three times, each bounce smaller.
	def easeOutBounce(t float) float {
		let n1 = 7.5625
		let d1 = 2.75
		return n1 * t * t when t < 1.0 / d1
		if t < 2.0 / d1 {
			let u = t - 1.5 / d1
			return n1 * u * u + 0.75
		}
		if t < 2.5 / d1 {
			let u = t - 2.25 / d1
			return n1 * u * u + 0.9375
		}
		let u = t - 2.625 / d1
		return n1 * u * u + 0.984375
	}

	// Bounces at both ends.
	def easeInOutBounce(t float) float {
		return (1.0 - easeOutBounce(1.0 - 2.0 * t)) / 2.0 when t < 0.5
		return (1.0 + easeOutBounce(2.0 * t - 1.0)) / 2.0
	}

	// The CSS `cubic-bezier(x1, y1, x2, y2)` curve from (0, 0) to (1, 1):
	// the returned easing finds the curve point whose x is t and gives its y.
	// x1 and x2 are clamped to [0, 1] so x stays monotonic; t outside [0, 1]
	// is clamped.
	def cubicBezier(x1, y1, x2, y2 float) Easing {
		let ax1 = x1.clamp(0.0, 1.0)
		let ax2 = x2.clamp(0.0, 1.0)
		return def(t float) float {
			let x = t.clamp(0.0, 1.0)
			return 0.0 when x == 0.0
			return 1.0 when x == 1.0
			return bezier.cubic(0.0, y1, y2, 1.0, bezier.cubicParameter(ax1, ax2, x))
		}
	}

	// Jumps through `count` equal levels, taking each step at its end (CSS
	// `steps(count, end)`): 0 until the first step, 1 only at t = 1. A count
	// of 0 or less leaves t as it is.
	def steps(count int) Easing {
		return def(t float) float {
			return t when count <= 0
			return 1.0 when t >= 1.0
			return 0.0 when t <= 0.0
			return (t * float(count)).floor() / float(count)
		}
	}

	// A damped spring released at 0 towards 1, evaluated at time t in
	// seconds (not clamped): mass in kg, stiffness in N/m, damping in N·s/m,
	// velocity the starting velocity in units per second. An underdamped
	// spring overshoots and rings, a critically or overdamped one settles
	// without crossing 1. A mass or stiffness of 0 or less gives linear.
	def spring(mass, stiffness, damping, velocity float) Easing {
		return linear when mass <= 0.0 || stiffness <= 0.0
		let w0 = sqrt(stiffness / mass)
		let zeta = damping / (2.0 * sqrt(stiffness * mass))
		return def(t float) float {
			return 0.0 when t <= 0.0
			if zeta < 1.0 {
				let a = zeta * w0
				let wd = w0 * sqrt(1.0 - zeta * zeta)
				let b = (a - velocity) / wd
				return 1.0 - E ** (-a * t) * (cos(wd * t) + b * sin(wd * t))
			}
			return 1.0 - E ** (-w0 * t) * (1.0 + (w0 - velocity) * t) when zeta == 1.0
			let root = w0 * sqrt(zeta * zeta - 1.0)
			let r1 = -zeta * w0 + root
			let r2 = -zeta * w0 - root
			let c1 = (-velocity - r2) / (r1 - r2)
			let c2 = 1.0 - c1
			return 1.0 - (c1 * E ** (r1 * t) + c2 * E ** (r2 * t))
		}
	}

	// Evaluates an easing function with time reversed.
	def reverseTime(e Easing, t float) float {
		return e(1.0 - t)
	}

	// Returns an easing function mirrored across both axes.
	// Turns an ease-in curve into the corresponding ease-out curve.
	def reverse(e Easing) Easing {
		return def(t float) float {
			return 1.0 - e(1.0 - t)
		}
	}

	// Evaluates a mirrored easing function at t.
	def reverse(e Easing, t float) float {
		return 1.0 - e(1.0 - t)
	}
}
