partial module std.math.easing {
	use (
		std.testing
		std.math
	)

	check "Easing" {
		internal def near(got, want float, eps float = 1e-9) bool {
			return (got - want).abs() <= eps
		}

		// Every standard curve starts at 0 and ends at 1.
		internal def endpoints(e Easing) bool {
			return near(e(0.0), 0.0) && near(e(1.0), 1.0)
		}

		// Whether the curve never goes down over 200 samples.
		internal def monotonic(e Easing) bool {
			let prev = e(0.0)
			for let i = 1; i <= 200; i++ {
				let v = e(float(i) / 200.0)
				return false when v < prev - 1e-12
				prev = v
			}
			return true
		}

		@test()
		def linearAndQuad() {
			assert near(linear(0.3), 0.3)
			assert endpoints(linear)
			assert endpoints(easeInQuad) && endpoints(easeOutQuad) && endpoints(easeInOutQuad)
			assert near(easeInQuad(0.5), 0.25)
			assert near(easeOutQuad(0.5), 0.75)
			assert near(easeInOutQuad(0.25), 0.125)
			assert near(easeInOutQuad(0.5), 0.5)
			assert near(easeInOutQuad(0.75), 0.875)
			assert monotonic(easeInQuad) && monotonic(easeOutQuad) && monotonic(easeInOutQuad)
		}

		@test()
		def cubic() {
			assert endpoints(easeInCubic) && endpoints(easeOutCubic) && endpoints(easeInOutCubic)
			assert near(easeInCubic(0.5), 0.125)
			assert near(easeOutCubic(0.5), 0.875)
			assert near(easeInOutCubic(0.25), 0.0625)
			assert near(easeInOutCubic(0.5), 0.5)
			assert monotonic(easeInCubic) && monotonic(easeOutCubic) && monotonic(easeInOutCubic)
		}

		@test()
		def sine() {
			assert endpoints(easeInSine) && endpoints(easeOutSine) && endpoints(easeInOutSine)
			assert near(easeInSine(0.5), 1.0 - 0.7071067811865476, 1e-9)
			assert near(easeOutSine(0.5), 0.7071067811865476, 1e-9)
			assert near(easeInOutSine(0.5), 0.5, 1e-9)
			assert monotonic(easeInSine) && monotonic(easeOutSine) && monotonic(easeInOutSine)
		}

		@test()
		def expo() {
			assert endpoints(easeInExpo) && endpoints(easeOutExpo) && endpoints(easeInOutExpo)
			assert near(easeInExpo(0.5), 0.03125)
			assert near(easeOutExpo(0.5), 0.96875)
			assert near(easeInOutExpo(0.5), 0.5)
			assert near(easeInOutExpo(0.25), 0.015625)
			assert monotonic(easeInExpo) && monotonic(easeOutExpo) && monotonic(easeInOutExpo)
		}

		@test()
		def back() {
			assert endpoints(easeInBack) && endpoints(easeOutBack) && endpoints(easeInOutBack)
			// Pulls back below 0 and overshoots above 1.
			assert easeInBack(0.2) < 0.0
			assert easeOutBack(0.8) > 1.0
			assert easeInOutBack(0.2) < 0.0
			assert easeInOutBack(0.8) > 1.0
			assert near(easeInBack(0.5), -0.0876975, 1e-6)
			assert near(easeOutBack(0.5), 1.0876975, 1e-6)
			assert near(easeInOutBack(0.5), 0.5, 1e-9)
		}

		@test()
		def elastic() {
			assert endpoints(easeInElastic) && endpoints(easeOutElastic) && endpoints(easeInOutElastic)
			// Oscillates around the target with shrinking amplitude.
			assert easeOutElastic(0.15) > 1.0
			assert easeOutElastic(0.3) < 1.0
			assert easeInElastic(0.85) < 0.0
			assert near(easeInOutElastic(0.5), 0.5, 1e-9)
			assert near(easeOutElastic(0.5), 1.015625, 1e-6)
			assert near(easeInElastic(0.5), -0.015625, 1e-6)
		}

		@test()
		def bounce() {
			assert endpoints(easeInBounce) && endpoints(easeOutBounce) && endpoints(easeInOutBounce)
			assert near(easeOutBounce(0.5), 0.765625)
			assert near(easeInBounce(0.5), 0.234375)
			assert near(easeInOutBounce(0.5), 0.5)
			assert near(easeOutBounce(0.25), 0.47265625)
			// Never leaves [0, 1].
			for let i = 0; i <= 100; i++ {
				let v = easeOutBounce(float(i) / 100.0)
				assert v >= 0.0 && v <= 1.0
			}
		}

		@test()
		def bezier() {
			let straight = cubicBezier(0.0, 0.0, 1.0, 1.0)
			assert endpoints(straight)
			assert near(straight(0.3), 0.3, 1e-6)
			assert near(straight(0.77), 0.77, 1e-6)

			// CSS `ease-in-out` is symmetric around the middle.
			let inOut = cubicBezier(0.42, 0.0, 0.58, 1.0)
			assert endpoints(inOut)
			assert near(inOut(0.5), 0.5, 1e-6)
			assert near(inOut(0.25) + inOut(0.75), 1.0, 1e-6)
			assert inOut(0.25) < 0.25
			assert monotonic(inOut)

			// CSS `ease` at a quarter: 0.4085 (reference value from browsers).
			let ease = cubicBezier(0.25, 0.1, 0.25, 1.0)
			assert near(ease(0.25), 0.4085, 1e-3)
			assert monotonic(ease)

			// Out of range t is clamped.
			assert near(ease(-1.0), 0.0)
			assert near(ease(2.0), 1.0)
		}

		@test()
		def stepped() {
			let four = steps(4)
			assert near(four(0.0), 0.0)
			assert near(four(0.1), 0.0)
			assert near(four(0.25), 0.25)
			assert near(four(0.3), 0.25)
			assert near(four(0.99), 0.75)
			assert near(four(1.0), 1.0)
			let zeroSteps = steps(0)
			assert near(zeroSteps(0.3), 0.3)
		}

		@test()
		def springs() {
			// Underdamped: overshoots, then settles at 1.
			let bouncy = spring(1.0, 100.0, 4.0, 0.0)
			assert near(bouncy(0.0), 0.0)
			let peak = 0.0
			for let i = 1; i <= 100; i++ {
				let v = bouncy(float(i) / 100.0)
				peak = v when v > peak
			}
			assert peak > 1.0
			assert near(bouncy(10.0), 1.0, 1e-6)

			// Critically damped: approaches 1 without crossing it.
			let critical = spring(1.0, 100.0, 20.0, 0.0)
			assert near(critical(0.0), 0.0)
			for let i = 1; i <= 100; i++ {
				let v = critical(float(i) / 50.0)
				assert v > 0.0 && v <= 1.0
			}
			assert near(critical(3.0), 1.0, 1e-6)
			assert monotonic(critical)

			// Overdamped: slower still, never crosses 1.
			let heavy = spring(1.0, 100.0, 40.0, 0.0)
			assert heavy(0.5) < critical(0.5)
			assert near(heavy(20.0), 1.0, 1e-6)
			assert monotonic(heavy)

			// Starting velocity moves it sooner.
			let pushed = spring(1.0, 100.0, 20.0, 5.0)
			assert pushed(0.05) > critical(0.05)

			// Degenerate parameters fall back to linear.
			let flat = spring(0.0, 100.0, 1.0, 0.0)
			assert near(flat(0.4), 0.4)
		}

		@test()
		def reversed() {
			let out = reverse(easeInQuad)
			assert near(out(0.5), 0.75)
			assert near(reverse(easeInQuad, 0.25), easeOutQuad(0.25))
			assert near(reverseTime(easeInQuad, 0.25), easeInQuad(0.75))
		}
	}
}
