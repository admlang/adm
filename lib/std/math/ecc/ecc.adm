partial module std.math.ecc {
	// Error-correcting codes: finite field arithmetic (GF(2^8) with a chosen
	// primitive polynomial, GF(929) for PDF417, other prime fields) and
	// Reed-Solomon encoding and decoding with errors and erasures (syndromes,
	// Berlekamp-Massey, Chien search, Forney). Used by the 2D barcodes; not
	// tied to them.
}
