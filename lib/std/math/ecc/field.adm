partial module std.math.ecc {
	// Field is a finite field whose elements are the integers 0 to size() - 1,
	// with a generator whose powers reach every non-zero element. Reed-Solomon
	// codes work over any Field.
	interface Field {
		// The number of elements.
		def size() int
		def add(a, b int) int
		def subtract(a, b int) int
		def multiply(a, b int) int
		// a / b; b must not be zero.
		def divide(a, b int) int
		// The multiplicative inverse of a non-zero a.
		def inverse(a int) int
		// The generator raised to n; n may be negative or past size() - 1.
		def exp(n int) int
		// The power of the generator that gives a non-zero a.
		def log(a int) int
	}

	// BinaryField is GF(2^bits): polynomials over GF(2) reduced by a primitive
	// polynomial, with addition as XOR. The generator is x (element 2).
	//
	// ```
	// let qr = new BinaryField(8, 0x11d)          // QR Code
	// let dm = new BinaryField(8, 0x12d)          // Data Matrix, Aztec 8-bit words
	// let az = new BinaryField(6, 0x43)           // Aztec 6-bit words
	// ```
	type BinaryField {
		// Bits per element, 2 to 16.
		bits          int
		// The primitive polynomial, including its x^bits term.
		polynomial    int
		internal exps int[]
		internal logs int[]

		def new(bits int = 8, polynomial int = 0x11d) {
			self.bits = bits
			self.polynomial = polynomial
			let n = 1 << bits
			exps.len(2 * n)
			logs.len(n)
			let x = 1
			for let i = 0; i < n - 1; i++ {
				exps[i] = x
				logs[x] = i
				x = x << 1
				x = x ^ polynomial when x >= n
			}
			for let i = n - 1; i < 2 * n; i++ {
				exps[i] = exps[i - (n - 1)]
			}
		}

		// Size implements Field.
		def size() int {
			return 1 << bits
		}

		// Add implements Field: XOR.
		def add(a, b int) int {
			return a ^ b
		}

		// Subtract implements Field: XOR, the same as add.
		def subtract(a, b int) int {
			return a ^ b
		}

		// Multiply implements Field.
		def multiply(a, b int) int {
			return 0 when a == 0 || b == 0
			return exps[logs[a] + logs[b]]
		}

		// Divide implements Field.
		def divide(a, b int) int {
			return 0 when a == 0
			return exps[logs[a] + (size() - 1) - logs[b]]
		}

		// Inverse implements Field.
		def inverse(a int) int {
			return exps[(size() - 1) - logs[a]]
		}

		// Exp implements Field.
		def exp(n int) int {
			let order = size() - 1
			let k = n % order
			k += order when k < 0
			return exps[k]
		}

		// Log implements Field.
		def log(a int) int {
			return logs[a]
		}
	}

	// PrimeField is GF(prime): the integers modulo a prime, with a primitive
	// root as the generator (3 for GF(929), the PDF417 field).
	type PrimeField {
		prime         int
		generator     int
		internal exps int[]
		internal logs int[]

		def new(prime int = 929, generator int = 3) {
			self.prime = prime
			self.generator = generator
			exps.len(prime - 1)
			logs.len(prime)
			let x = 1
			for let i = 0; i < prime - 1; i++ {
				exps[i] = x
				logs[x] = i
				x = (x * generator) % prime
			}
		}

		// Size implements Field.
		def size() int {
			return prime
		}

		// Add implements Field.
		def add(a, b int) int {
			return (a + b) % prime
		}

		// Subtract implements Field.
		def subtract(a, b int) int {
			return (a - b + prime) % prime
		}

		// Multiply implements Field.
		def multiply(a, b int) int {
			return (a * b) % prime
		}

		// Divide implements Field.
		def divide(a, b int) int {
			return multiply(a, inverse(b))
		}

		// Inverse implements Field.
		def inverse(a int) int {
			return exps[(prime - 1 - logs[a]) % (prime - 1)]
		}

		// Exp implements Field.
		def exp(n int) int {
			let order = prime - 1
			let k = n % order
			k += order when k < 0
			return exps[k]
		}

		// Log implements Field.
		def log(a int) int {
			return logs[a]
		}
	}
}
