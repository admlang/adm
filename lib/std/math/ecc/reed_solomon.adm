partial module std.math.ecc {
	// ReedSolomon is a Reed-Solomon code over a Field with `parity` check
	// symbols, whose generator polynomial has the roots
	// generator^firstRoot ... generator^(firstRoot + parity - 1). QR Code uses
	// firstRoot 0; Data Matrix, Aztec and PDF417 use 1.
	//
	// A codeword is data followed by parity, highest-degree coefficient first,
	// at most size() - 1 symbols long. It corrects any mix of e erasures (known
	// bad positions) and v errors with 2v + e <= parity.
	//
	// ```
	// let rs = new ReedSolomon(new BinaryField(8, 0x11d), 10)
	// let codeword = data + rs.encode(data)
	// let fixed = rs.correct(codeword)!       // symbols repaired in place
	// ```
	type ReedSolomon {
		field        Field
		parity       int
		firstRoot    int
		// Generator polynomial, highest degree first, monic.
		internal gen int[]

		def new(field Field, parity int, firstRoot int = 0) {
			self.field = field
			self.parity = parity
			self.firstRoot = firstRoot
			gen = int[1]
			for let j = 0; j < parity; j++ {
				let root = field.exp(firstRoot + j)
				let next int[]
				next.len(gen.len() + 1)
				for let i = 0; i < next.len(); i++ {
					let hi = i < gen.len() ?? (gen[i], 0)
					let lo = i > 0 ?? (field.multiply(root, gen[i - 1]), 0)
					next[i] = field.subtract(hi, lo)
				}
				gen = next
			}
		}

		// The parity symbols for data: appended to data they make a codeword.
		def encode(data int[]) int[] {
			let rem int[]
			rem.len(parity)
			rem.fill(0)
			for let d in data {
				let f = field.add(d, rem[0])
				for let i = 0; i < parity - 1; i++ {
					rem[i] = field.subtract(rem[i + 1], field.multiply(gen[i + 1], f))
				}
				rem[parity - 1] = field.subtract(0, field.multiply(gen[parity], f)) when parity > 0
			}
			for let i = 0; i < parity; i++ {
				rem[i] = field.subtract(0, rem[i])
			}
			return rem
		}

		// Repairs codeword in place and returns the number of symbols changed.
		// erasures lists the indexes of symbols known to be unreliable.
		// Fails when the damage is beyond the code's reach: more than
		// parity erasures, or errors and erasures with 2v + e > parity.
		def correct(codeword int[], erasures int[] = int[]) !int {
			expects {
				assert codeword.len() <= field.size() - 1 onerror fail "codeword longer than the field allows"
				assert erasures.len() <= parity onerror fail "more erasures than parity symbols"
			}
			let n = codeword.len()
			let synd int[]
			synd.len(parity)
			let clean = true
			for let j = 0; j < parity; j++ {
				let a = field.exp(firstRoot + j)
				let s = 0
				for let sym in codeword {
					s = field.add(field.multiply(s, a), sym)
				}
				synd[j] = s
				clean = false when s != 0
			}
			return 0 when clean

			// Erasure locator: product of (1 - X x), lowest degree first.
			let gamma = int[1]
			for let pos in erasures {
				let x = field.exp(n - 1 - pos)
				let next int[]
				next.len(gamma.len() + 1)
				next.fill(0)
				for let i = 0; i < gamma.len(); i++ {
					next[i] = field.add(next[i], gamma[i])
					next[i + 1] = field.subtract(next[i + 1], field.multiply(x, gamma[i]))
				}
				gamma = next
			}

			// Berlekamp-Massey started from the erasure locator.
			let e = erasures.len()
			let lam = gamma.clone()
			let b = gamma.clone()
			let l = e
			for let r = e; r < parity; r++ {
				let delta = 0
				for let i = 0; i < lam.len() && i <= r; i++ {
					delta = field.add(delta, field.multiply(lam[i], synd[r - i]))
				}
				let xb = int[0] + b
				if delta == 0 {
					b = xb
					continue
				}
				let t = lam.clone()
				t.len(xb.len()) when xb.len() > t.len()
				for let i = 0; i < xb.len(); i++ {
					t[i] = field.subtract(t[i], field.multiply(delta, xb[i]))
				}
				if 2 * l <= r + e {
					let inv = field.inverse(delta)
					b = lam.clone()
					for let i = 0; i < b.len(); i++ {
						b[i] = field.multiply(b[i], inv)
					}
					l = r + 1 + e - l
				} else {
					b = xb
				}
				lam = t
			}
			let deg = lam.len() - 1
			for deg > 0 && lam[deg] == 0 {
				deg--
			}
			fail "too many errors to correct" when deg != l || 2 * (l - e) + e > parity

			// Error evaluator: S(x) * lambda(x) mod x^parity.
			let omega int[]
			omega.len(parity)
			omega.fill(0)
			for let i = 0; i <= deg; i++ {
				for let j = 0; j < parity - i; j++ {
					omega[i + j] = field.add(omega[i + j], field.multiply(lam[i], synd[j]))
				}
			}

			// Chien search and Forney.
			let found = 0
			for let pos = 0; pos < n; pos++ {
				let power = n - 1 - pos
				let xinv = field.exp(-power)
				continue when evaluate(lam, deg, xinv) != 0
				found++
				// Formal derivative: i * lambda_i, the i-fold sum in the field.
				let derivative = 0
				let xpow = 1
				for let i = 1; i <= deg; i++ {
					let coefficient = 0
					for let k = 0; k < i; k++ {
						coefficient = field.add(coefficient, lam[i])
					}
					derivative = field.add(derivative, field.multiply(coefficient, xpow))
					xpow = field.multiply(xpow, xinv)
				}
				fail "too many errors to correct" when derivative == 0
				let num = field.multiply(field.exp(power * (1 - firstRoot)), evaluate(omega, parity - 1, xinv))
				let value = field.subtract(0, field.divide(num, derivative))
				codeword[pos] = field.subtract(codeword[pos], value)
			}
			fail "too many errors to correct" when found != deg

			for let j = 0; j < parity; j++ {
				let a = field.exp(firstRoot + j)
				let s = 0
				for let sym in codeword {
					s = field.add(field.multiply(s, a), sym)
				}
				fail "too many errors to correct" when s != 0
			}
			return found
		}

		// p(x) for p stored lowest degree first, up to degree deg.
		internal def evaluate(p int[], deg int, x int) int {
			let v = 0
			for let i = deg; i >= 0; i-- {
				v = field.add(field.multiply(v, x), p[i])
			}
			return v
		}
	}
}
