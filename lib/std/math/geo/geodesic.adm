// Geodesics on an ellipsoid of revolution after C. F. F. Karney, "Algorithms
// for geodesics", J. Geodesy 87 (2013), as GeographicLib implements them
// (series to sixth order in the third flattening): the inverse problem
// (distance and azimuths between two points, with the area between the
// geodesic and the equator), the direct problem (where a geodesic of a given
// azimuth and length ends) and the area and perimeter of a polygon of
// geodesic edges. Accurate to about 15 nanometres on the Earth, and it
// converges everywhere, nearly antipodal points included, where Vincenty's
// iteration does not.
internal partial module std.math.geo.geodesic {
	use std.math::(sqrt, sin, cos, atan, atan2, ln, Pi)

	const geoNaN = 0.0 / 0.0
	const geoTiny = 1.4916681462400413e-154
	const geoTol0 = 2.220446049250313e-16
	const geoTol1 = 200.0 * 2.220446049250313e-16
	const geoTol2 = 1.4901161193847656e-08
	const geoXThresh = 1000.0 * 1.4901161193847656e-08
	const geoMaxit1 = 20
	const geoMaxit2 = 83
	const geoOrder = 6

	def degToRad(x float) float {
		return x * (Pi / 180.0)
	}

	def radToDeg(x float) float {
		return x * (180.0 / Pi)
	}

	def sq(x float) float {
		return x * x
	}

	def isFinite(x float) bool {
		return x == x && x - x == 0.0
	}

	// |x| with the sign of s, the sign of -0 included.
	def copySign(x float, s float) float {
		let magnitude = __bitcast_f64_from_u64(__bitcast_u64_from_f64(float64(x)) & 0x7FFFFFFFFFFFFFFF)
		let negative = __bitcast_u64_from_f64(float64(s)) >> 63 == 1
		return float(negative ?? (-magnitude, magnitude))
	}

	def hypot(x float, y float) float {
		return sqrt(x * x + y * y)
	}

	def cbrt(x float) float {
		return copySign(x.abs() ** (1.0 / 3.0), x)
	}

	def exp(x float) float {
		return 2.718281828459045 ** x
	}

	// ln(1 + x), exact to rounding for small x (Goldberg's trick).
	def log1p(x float) float {
		let u = 1.0 + x
		return x when u == 1.0
		return ln(u) * x / (u - 1.0)
	}

	def atanh(x float) float {
		let y = x.abs()
		let r = 0.5 * log1p(2.0 * y / (1.0 - y))
		return copySign(r, x)
	}

	def asinh(x float) float {
		let y = x.abs()
		let r = log1p(y + y * y / (1.0 + sqrt(1.0 + y * y)))
		return copySign(r, x)
	}

	def sinh(x float) float {
		let e = exp(x)
		return (e - 1.0 / e) / 2.0
	}

	def cosh(x float) float {
		let e = exp(x)
		return (e + 1.0 / e) / 2.0
	}

	// x rounded to the nearest integer, ties to even.
	def roundEven(x float) float {
		let r = x.round()
		if (r - x).abs() == 0.5 {
			let half = r / 2.0
			r = x * 2.0 - r when half != half.floor()
		}
		return r
	}

	// The IEEE remainder of x by y: x - n y for the n nearest x / y, ties to
	// even; exact.
	def ieeeRemainder(x float, y float) float {
		return geoNaN unless isFinite(x)
		return x - roundEven(x / y) * y
	}

	def normalize(x float, y float) (float, float) {
		let r = hypot(x, y)
		return (x / r, y / r)
	}

	// The sum of u and v and its rounding error.
	def errorFreeSum(u float, v float) (float, float) {
		let s = u + v
		let up = s - v
		let vpp = s - up
		up -= u
		vpp -= v
		let t = s == 0.0 ?? (s, 0.0 - (up + vpp))
		return (s, t)
	}

	def polyval(n int, p float[], s int, x float) float {
		let y = n < 0 ?? (0.0, p[s])
		let at = s
		for let i = 0; i < n; i++ {
			at++
			y = y * x + p[at]
		}
		return y
	}

	// Rounds tiny angles so that a few small values come out exactly.
	def angRound(x float) float {
		let z = 1.0 / 16.0
		let y = x.abs()
		y = z - (z - y) when y < z
		return copySign(y, x)
	}

	def angNormalize(x float) float {
		let y = ieeeRemainder(x, 360.0)
		return y.abs() == 180.0 ?? (copySign(180.0, x), y)
	}

	def latFix(x float) float {
		return x.abs() > 90.0 ?? (geoNaN, x)
	}

	// y - x reduced to [-180, 180] exactly, and its rounding error.
	def angDiff(x float, y float) (float, float) {
		let (d0, t0) = errorFreeSum(ieeeRemainder(-x, 360.0), ieeeRemainder(y, 360.0))
		let (d, t) = errorFreeSum(ieeeRemainder(d0, 360.0), t0)
		d = copySign(d, t == 0.0 ?? (y - x, -t)) when d == 0.0 || d.abs() == 180.0
		return (d, t)
	}

	// sin and cos of x degrees, exact for multiples of 90.
	def sinCosd(x float) (float, float) {
		let r = ieeeRemainder(x, 360.0)
		let q = r != r ?? (0, int(roundEven(r / 90.0)))
		return quadrant(degToRad(r - 90.0 * float(q)), q, x)
	}

	// sin and cos of x + t degrees, t a small correction.
	def sinCosde(x float, t float) (float, float) {
		let q = isFinite(x) ?? (int(roundEven(x / 90.0)), 0)
		return quadrant(degToRad(angRound(x - 90.0 * float(q) + t)), q, x)
	}

	def quadrant(r float, q int, x float) (float, float) {
		let s = sin(r)
		let c = cos(r)
		let k = ((q % 4) + 4) % 4
		if k == 1 {
			let t = s
			s = c
			c = -t
		} else if k == 2 {
			s = -s
			c = -c
		} else if k == 3 {
			let t = s
			s = -c
			c = t
		}
		c = c + 0.0
		s = copySign(s, x) when s == 0.0
		return (s, c)
	}

	// atan2 in degrees, exact for the axes.
	def atan2d(y0 float, x0 float) float {
		let x = x0
		let y = y0
		let q = 0
		if y.abs() > x.abs() {
			q = 2
			let t = x
			x = y
			y = t
		}
		if x < 0.0 {
			q++
			x = -x
		}
		let ang = radToDeg(atan2(y, x))
		if q == 1 {
			ang = copySign(180.0, y) - ang
		} else if q == 2 {
			ang = 90.0 - ang
		} else if q == 3 {
			ang = -90.0 + ang
		}
		return ang
	}

	// Σ c[l] sin(2lx) (sinp) or Σ c[l] cos((2l+1)x), by Clenshaw summation.
	def sinCosSeries(sinp bool, sinx float, cosx float, c float[]) float {
		let k = c.len()
		let n = k - (sinp ?? (1, 0))
		let ar = 2.0 * (cosx - sinx) * (cosx + sinx)
		let y1 = 0.0
		let y0 = 0.0
		if (n & 1) == 1 {
			k--
			y0 = c[k]
		}
		n = n / 2
		for n > 0 {
			n--
			k--
			y1 = ar * y0 - y1 + c[k]
			k--
			y0 = ar * y1 - y0 + c[k]
		}
		return sinp ?? (2.0 * sinx * cosx * y0, cosx * (y0 - y1))
	}

	// The positive root of k^4 + 2k^3 - (x^2 + y^2 - 1)k^2 - 2y^2k - y^2 = 0.
	def astroid(x float, y float) float {
		let p = sq(x)
		let q = sq(y)
		let r = (p + q - 1.0) / 6.0
		return 0.0 when q == 0.0 && r <= 0.0
		let s = p * q / 4.0
		let r2 = sq(r)
		let r3 = r * r2
		let disc = s * (s + 2.0 * r3)
		let u = r
		if disc >= 0.0 {
			let t3 = s + r3
			t3 += t3 < 0.0 ?? (-sqrt(disc), sqrt(disc))
			let t = cbrt(t3)
			u += t + (t != 0.0 ?? (r2 / t, 0.0))
		} else {
			let ang = atan2(sqrt(-disc), -(s + r3))
			u += 2.0 * r * cos(ang / 3.0)
		}
		let v = sqrt(sq(u) + q)
		let uv = u < 0.0 ?? (q / (v - u), u + v)
		let w = (uv - q) / (2.0 * v)
		return uv / (sqrt(uv + sq(w)) + w)
	}

	const a1Coeff = [1.0, 4.0, 64.0, 0.0, 256.0]
	const c1Coeff = [-1.0, 6.0, -16.0, 32.0, -9.0, 64.0, -128.0, 2048.0, 9.0, -16.0, 768.0, 3.0, -5.0, 512.0, -7.0, 1280.0, -7.0, 2048.0]
	const c1pCoeff = [205.0, -432.0, 768.0, 1536.0, 4005.0, -4736.0, 3840.0, 12288.0, -225.0, 116.0, 384.0, -7173.0, 2695.0, 7680.0, 3467.0, 7680.0, 38081.0, 61440.0]
	const a2Coeff = [-11.0, -28.0, -192.0, 0.0, 256.0]
	const c2Coeff = [1.0, 2.0, 16.0, 32.0, 35.0, 64.0, 384.0, 2048.0, 15.0, 80.0, 768.0, 7.0, 35.0, 512.0, 63.0, 1280.0, 77.0, 2048.0]
	const a3Coeff = [-3.0, 128.0, -2.0, -3.0, 64.0, -1.0, -3.0, -1.0, 16.0, 3.0, -1.0, -2.0, 8.0, 1.0, -1.0, 2.0, 1.0, 1.0]
	const c3Coeff = [3.0, 128.0, 2.0, 5.0, 128.0, -1.0, 3.0, 3.0, 64.0, -1.0, 0.0, 1.0, 8.0, -1.0, 1.0, 4.0, 5.0, 256.0, 1.0, 3.0, 128.0, -3.0, -2.0, 3.0, 64.0, 1.0, -3.0, 2.0, 32.0, 7.0, 512.0, -10.0, 9.0, 384.0, 5.0, -9.0, 5.0, 192.0, 7.0, 512.0, -14.0, 7.0, 512.0, 21.0, 2560.0]
	const c4Coeff = [97.0, 15015.0, 1088.0, 156.0, 45045.0, -224.0, -4784.0, 1573.0, 45045.0, -10656.0, 14144.0, -4576.0, -858.0, 45045.0, 64.0, 624.0, -4576.0, 6864.0, -3003.0, 15015.0, 100.0, 208.0, 572.0, 3432.0, -12012.0, 30030.0, 45045.0, 1.0, 9009.0, -2944.0, 468.0, 135135.0, 5792.0, 1040.0, -1287.0, 135135.0, 5952.0, -11648.0, 9152.0, -2574.0, 135135.0, -64.0, -624.0, 4576.0, -6864.0, 3003.0, 135135.0, 8.0, 10725.0, 1856.0, -936.0, 225225.0, -8448.0, 4992.0, -1144.0, 225225.0, -1440.0, 4160.0, -4576.0, 1716.0, 225225.0, -136.0, 63063.0, 1024.0, -208.0, 105105.0, 3584.0, -3328.0, 1144.0, 315315.0, -128.0, 135135.0, -2560.0, 832.0, 405405.0, 128.0, 99099.0]

	def a1m1f(eps float) float {
		let m = geoOrder / 2
		let t = polyval(m, a1Coeff, 0, sq(eps)) / a1Coeff[m + 1]
		return (t + eps) / (1.0 - eps)
	}

	def a2m1f(eps float) float {
		let m = geoOrder / 2
		let t = polyval(m, a2Coeff, 0, sq(eps)) / a2Coeff[m + 1]
		return (t - eps) / (1.0 + eps)
	}

	// Fills c[1..6] from the coefficient table of C1, C1' or C2.
	def seriesOf(table float[], eps float, c float[]) {
		let eps2 = sq(eps)
		let d = eps
		let o = 0
		for let l = 1; l <= geoOrder; l++ {
			let m = (geoOrder - l) / 2
			c[l] = d * polyval(m, table, o, eps2) / table[o + m + 1]
			o += m + 2
			d *= eps
		}
	}

	def zeros(n int) float[] {
		let out float[] = []
		out.len(n)
		return out
	}

	// What the inverse problem gives: the arc length (degrees), the distance,
	// sine and cosine of both azimuths, and the area between the geodesic
	// and the equator.
	struct InverseResult {
		a12   float
		s12   float
		salp1 float
		calp1 float
		salp2 float
		calp2 float
		s12a  float
	}

	struct LambdaResult {
		lam12  float
		salp2  float
		calp2  float
		sig12  float
		ssig1  float
		csig1  float
		ssig2  float
		csig2  float
		eps    float
		domg12 float
		dlam12 float
	}

	// An ellipsoid of revolution with its series coefficients.
	type Geodesic {
		a     float
		f     float
		f1    float
		e2    float
		ep2   float
		n     float
		b     float
		c2    float
		etol2 float
		a3x   float[]
		c3x   float[]
		c4x   float[]

		def new(a float, f float) {
			self.a = a
			self.f = f
			f1 = 1.0 - f
			e2 = f * (2.0 - f)
			ep2 = e2 / sq(f1)
			n = f / (2.0 - f)
			b = a * f1
			let ratio = e2 == 0.0 ?? (1.0, (e2 > 0.0 ?? (atanh(sqrt(e2)), atan(sqrt(-e2)))) / sqrt(e2.abs()))
			c2 = (sq(a) + sq(b) * ratio) / 2.0
			etol2 = 0.1 * geoTol2 / sqrt(f.abs().max(0.001) * (1.0 - f / 2.0).min(1.0) / 2.0)
			a3x = zeros(geoOrder)
			let o = 0
			let k = 0
			for let j = geoOrder - 1; j >= 0; j-- {
				let m = (geoOrder - j - 1).min(j)
				a3x[k] = polyval(m, a3Coeff, o, n) / a3Coeff[o + m + 1]
				k++
				o += m + 2
			}
			c3x = zeros(geoOrder * (geoOrder - 1) / 2)
			o = 0
			k = 0
			for let l = 1; l < geoOrder; l++ {
				for let j = geoOrder - 1; j >= l; j-- {
					let m = (geoOrder - j - 1).min(j)
					c3x[k] = polyval(m, c3Coeff, o, n) / c3Coeff[o + m + 1]
					k++
					o += m + 2
				}
			}
			c4x = zeros(geoOrder * (geoOrder + 1) / 2)
			o = 0
			k = 0
			for let l = 0; l < geoOrder; l++ {
				for let j = geoOrder - 1; j >= l; j-- {
					let m = geoOrder - j - 1
					c4x[k] = polyval(m, c4Coeff, o, n) / c4Coeff[o + m + 1]
					k++
					o += m + 2
				}
			}
		}

		def a3f(eps float) float {
			return polyval(geoOrder - 1, a3x, 0, eps)
		}

		def c3f(eps float, c float[]) {
			let mult = 1.0
			let o = 0
			for let l = 1; l < geoOrder; l++ {
				let m = geoOrder - l - 1
				mult *= eps
				c[l] = mult * polyval(m, c3x, o, eps)
				o += m + 1
			}
		}

		def c4f(eps float, c float[]) {
			let mult = 1.0
			let o = 0
			for let l = 0; l < geoOrder; l++ {
				let m = geoOrder - l - 1
				c[l] = mult * polyval(m, c4x, o, eps)
				o += m + 1
				mult *= eps
			}
		}

		// The distance and reduced length factors of a geodesic segment, and
		// m0 (Karney's equations 38 and 39).
		def lengths(eps float, sig12 float, ssig1 float, csig1 float, dn1 float, ssig2 float, csig2 float, dn2 float, distance bool, reduced bool, c1a float[], c2a float[]) (float, float, float) {
			let s12b = geoNaN
			let m12b = geoNaN
			let m0 = geoNaN
			let m0x = geoNaN
			let j12 = geoNaN
			let a1 = 0.0
			let a2 = 0.0
			if distance || reduced {
				a1 = a1m1f(eps)
				seriesOf(c1Coeff, eps, c1a)
				if reduced {
					a2 = a2m1f(eps)
					seriesOf(c2Coeff, eps, c2a)
					m0x = a1 - a2
					a2 = 1.0 + a2
				}
				a1 = 1.0 + a1
			}
			if distance {
				let b1 = sinCosSeries(true, ssig2, csig2, c1a) - sinCosSeries(true, ssig1, csig1, c1a)
				s12b = a1 * (sig12 + b1)
				if reduced {
					let b2 = sinCosSeries(true, ssig2, csig2, c2a) - sinCosSeries(true, ssig1, csig1, c2a)
					j12 = m0x * sig12 + (a1 * b1 - a2 * b2)
				}
			} else if reduced {
				for let l = 1; l < geoOrder; l++ {
					c2a[l] = a1 * c1a[l] - a2 * c2a[l]
				}
				j12 = m0x * sig12 + (sinCosSeries(true, ssig2, csig2, c2a) - sinCosSeries(true, ssig1, csig1, c2a))
			}
			if reduced {
				m0 = m0x
				m12b = dn2 * (csig1 * ssig2) - dn1 * (ssig1 * csig2) - csig1 * csig2 * j12
			}
			return (s12b, m12b, m0)
		}

		// A starting azimuth for the inverse problem's Newton iteration; a
		// non-negative sig12 when the short-line approximation already solves
		// it.
		def inverseStart(sbet1 float, cbet1 float, dn1 float, sbet2 float, cbet2 float, dn2 float, lam12 float, slam12 float, clam12 float, c1a float[], c2a float[]) (float, float, float, float, float, float) {
			let sig12 = -1.0
			let salp2 = geoNaN
			let calp2 = geoNaN
			let dnm = geoNaN
			let sbet12 = sbet2 * cbet1 - cbet2 * sbet1
			let cbet12 = cbet2 * cbet1 + sbet2 * sbet1
			let sbet12a = sbet2 * cbet1
			sbet12a += cbet2 * sbet1
			let shortline = cbet12 >= 0.0 && sbet12 < 0.5 && cbet2 * lam12 < 0.5
			let somg12 = slam12
			let comg12 = clam12
			if shortline {
				let sbetm2 = sq(sbet1 + sbet2)
				sbetm2 /= sbetm2 + sq(cbet1 + cbet2)
				dnm = sqrt(1.0 + ep2 * sbetm2)
				let omg12 = lam12 / (f1 * dnm)
				somg12 = sin(omg12)
				comg12 = cos(omg12)
			}
			let salp1 = cbet2 * somg12
			let calp1 = comg12 >= 0.0 ?? (sbet12 + cbet2 * sbet1 * sq(somg12) / (1.0 + comg12), sbet12a - cbet2 * sbet1 * sq(somg12) / (1.0 - comg12))
			let ssig12 = hypot(salp1, calp1)
			let csig12 = sbet1 * sbet2 + cbet1 * cbet2 * comg12
			if shortline && ssig12 < etol2 {
				salp2 = cbet1 * somg12
				calp2 = sbet12 - cbet1 * sbet2 * (comg12 >= 0.0 ?? (sq(somg12) / (1.0 + comg12), 1.0 - comg12))
				let (s, c) = normalize(salp2, calp2)
				salp2 = s
				calp2 = c
				sig12 = atan2(ssig12, csig12)
			} else if n.abs() >= 0.1 || csig12 >= 0.0 || ssig12 >= 6.0 * n.abs() * Pi * sq(cbet1) {
				// Nothing: the starting azimuth above is good enough.
			} else {
				let lam12x = atan2(-slam12, -clam12)
				let x = 0.0
				let y = 0.0
				let lamscale = 0.0
				let betscale = 0.0
				if f >= 0.0 {
					let k2 = sq(sbet1) * ep2
					let eps = k2 / (2.0 * (1.0 + sqrt(1.0 + k2)) + k2)
					lamscale = f * cbet1 * a3f(eps) * Pi
					betscale = lamscale * cbet1
					x = lam12x / lamscale
					y = sbet12a / betscale
				} else {
					let cbet12a = cbet2 * cbet1 - sbet2 * sbet1
					let bet12a = atan2(sbet12a, cbet12a)
					let (_, m12b, m0) = lengths(n, Pi + bet12a, sbet1, -cbet1, dn1, sbet2, cbet2, dn2, distance = false, reduced = true, c1a = c1a, c2a = c2a)
					x = -1.0 + m12b / (cbet1 * cbet2 * m0 * Pi)
					betscale = x < -0.01 ?? (sbet12a / x, -f * sq(cbet1) * Pi)
					lamscale = betscale / cbet1
					y = lam12x / lamscale
				}
				if y > -geoTol1 && x > -1.0 - geoXThresh {
					if f >= 0.0 {
						salp1 = (-x).min(1.0)
						calp1 = -sqrt(1.0 - sq(salp1))
					} else {
						calp1 = x.max(x > -geoTol1 ?? (0.0, -1.0))
						salp1 = sqrt(1.0 - sq(calp1))
					}
				} else {
					let k = astroid(x, y)
					let omg12a = lamscale * (f >= 0.0 ?? (-x * k / (1.0 + k), -y * (1.0 + k) / k))
					somg12 = sin(omg12a)
					comg12 = -cos(omg12a)
					salp1 = cbet2 * somg12
					calp1 = sbet12a - cbet2 * sbet1 * sq(somg12) / (1.0 - comg12)
				}
			}
			if salp1 > 0.0 {
				let (s, c) = normalize(salp1, calp1)
				salp1 = s
				calp1 = c
			} else {
				salp1 = 1.0
				calp1 = 0.0
			}
			return (sig12, salp1, calp1, salp2, calp2, dnm)
		}

		// The longitude difference of the geodesic leaving at azimuth alp1, and
		// its derivative when diffp.
		def lambda12(sbet1 float, cbet1 float, dn1 float, sbet2 float, cbet2 float, dn2 float, salp1 float, calp1In float, slam120 float, clam120 float, diffp bool, c1a float[], c2a float[], c3a float[]) LambdaResult {
			let calp1 = calp1In
			calp1 = -geoTiny when sbet1 == 0.0 && calp1 == 0.0
			let salp0 = salp1 * cbet1
			let calp0 = hypot(calp1, salp1 * sbet1)
			let somg1 = salp0 * sbet1
			let comg1 = calp1 * cbet1
			let (ssig1, csig1) = normalize(sbet1, calp1 * cbet1)
			let salp2 = cbet2 != cbet1 ?? (salp0 / cbet2, salp1)
			let calp2 = 0.0
			if cbet2 != cbet1 || sbet2.abs() != -sbet1 {
				let inner = cbet1 < -sbet1 ?? ((cbet2 - cbet1) * (cbet1 + cbet2), (sbet1 - sbet2) * (sbet1 + sbet2))
				calp2 = sqrt(sq(calp1 * cbet1) + inner) / cbet2
			} else {
				calp2 = calp1.abs()
			}
			let somg2 = salp0 * sbet2
			let comg2 = calp2 * cbet2
			let (ssig2, csig2) = normalize(sbet2, calp2 * cbet2)
			let sig12 = atan2((csig1 * ssig2 - ssig1 * csig2).max(0.0) + 0.0, csig1 * csig2 + ssig1 * ssig2)
			let somg12 = (comg1 * somg2 - somg1 * comg2).max(0.0) + 0.0
			let comg12 = comg1 * comg2 + somg1 * somg2
			let eta = atan2(somg12 * clam120 - comg12 * slam120, comg12 * clam120 + somg12 * slam120)
			let k2 = sq(calp0) * ep2
			let eps = k2 / (2.0 * (1.0 + sqrt(1.0 + k2)) + k2)
			c3f(eps, c3a)
			let b312 = sinCosSeries(true, ssig2, csig2, c3a) - sinCosSeries(true, ssig1, csig1, c3a)
			let domg12 = -f * a3f(eps) * salp0 * (sig12 + b312)
			let dlam12 = geoNaN
			if diffp {
				if calp2 == 0.0 {
					dlam12 = -2.0 * f1 * dn1 / sbet1
				} else {
					let (_, m12b, _) = lengths(eps, sig12, ssig1, csig1, dn1, ssig2, csig2, dn2, distance = false, reduced = true, c1a = c1a, c2a = c2a)
					dlam12 = m12b * f1 / (calp2 * cbet2)
				}
			}
			return {lam12: eta + domg12, salp2: salp2, calp2: calp2, sig12: sig12, ssig1: ssig1, csig1: csig1, ssig2: ssig2, csig2: csig2, eps: eps, domg12: domg12, dlam12: dlam12}
		}

		// Solves the inverse problem; the area term only when area.
		def inverse(lat1In float, lon1 float, lat2In float, lon2 float, area bool) InverseResult {
			let (lon12a, lon12sa) = angDiff(lon1, lon2)
			let lonsign = copySign(1.0, lon12a)
			let lon12 = lonsign * lon12a
			let lon12s = lonsign * lon12sa
			let lam12 = degToRad(lon12)
			let (slam12, clam12) = sinCosde(lon12, lon12s)
			lon12s = (180.0 - lon12) - lon12s
			let lat1 = angRound(latFix(lat1In))
			let lat2 = angRound(latFix(lat2In))
			let swapp = lat1.abs() < lat2.abs() || lat2 != lat2 ?? (-1.0, 1.0)
			if swapp < 0.0 {
				lonsign *= -1.0
				let t = lat1
				lat1 = lat2
				lat2 = t
			}
			let latsign = copySign(1.0, -lat1)
			lat1 *= latsign
			lat2 *= latsign
			let (sb1, cb1) = sinCosd(lat1)
			let (sbet1, cbet1Raw) = normalize(f1 * sb1, cb1)
			let cbet1 = cbet1Raw.max(geoTiny)
			let (sb2, cb2) = sinCosd(lat2)
			let (sbet2Raw, cbet2Raw) = normalize(f1 * sb2, cb2)
			let sbet2 = sbet2Raw
			let cbet2 = cbet2Raw.max(geoTiny)
			if cbet1 < -sbet1 {
				sbet2 = copySign(sbet1, sbet2) when cbet2 == cbet1
			} else {
				cbet2 = cbet1 when sbet2.abs() == -sbet1
			}
			let dn1 = sqrt(1.0 + ep2 * sq(sbet1))
			let dn2 = sqrt(1.0 + ep2 * sq(sbet2))
			let c1a = zeros(geoOrder + 1)
			let c2a = zeros(geoOrder + 1)
			let c3a = zeros(geoOrder)
			let a12 = geoNaN
			let s12x = geoNaN
			let m12x = geoNaN
			let salp1 = 0.0
			let calp1 = 0.0
			let salp2 = 0.0
			let calp2 = 0.0
			let sig12 = 0.0
			let omg12 = 0.0
			let somg12 = 2.0
			let comg12 = 0.0
			let meridian = lat1 == -90.0 || slam12 == 0.0
			if meridian {
				calp1 = clam12
				salp1 = slam12
				calp2 = 1.0
				salp2 = 0.0
				let ssig1 = sbet1
				let csig1 = calp1 * cbet1
				let ssig2 = sbet2
				let csig2 = calp2 * cbet2
				sig12 = atan2((csig1 * ssig2 - ssig1 * csig2).max(0.0) + 0.0, csig1 * csig2 + ssig1 * ssig2)
				let (sx, mx, _) = lengths(n, sig12, ssig1, csig1, dn1, ssig2, csig2, dn2, distance = true, reduced = true, c1a = c1a, c2a = c2a)
				s12x = sx
				m12x = mx
				if sig12 < geoTol2 || m12x >= 0.0 {
					if sig12 < 3.0 * geoTiny || (sig12 < geoTol0 && (s12x < 0.0 || m12x < 0.0)) {
						sig12 = 0.0
						m12x = 0.0
						s12x = 0.0
					}
					m12x *= b
					s12x *= b
					a12 = radToDeg(sig12)
				} else {
					meridian = false
				}
			}
			let domg12 = 0.0
			if !meridian && sbet1 == 0.0 && (f <= 0.0 || lon12s >= f * 180.0) {
				calp1 = 0.0
				calp2 = 0.0
				salp1 = 1.0
				salp2 = 1.0
				s12x = a * lam12
				sig12 = lam12 / f1
				omg12 = sig12
				m12x = b * sin(sig12)
				a12 = lon12 / f1
			} else if !meridian {
				let (sigStart, s1, c1, s2, cs2, dnm) = inverseStart(sbet1, cbet1, dn1, sbet2, cbet2, dn2, lam12, slam12, clam12, c1a, c2a)
				sig12 = sigStart
				salp1 = s1
				calp1 = c1
				salp2 = s2
				calp2 = cs2
				if sig12 >= 0.0 {
					s12x = sig12 * b * dnm
					m12x = sq(dnm) * b * sin(sig12 / dnm)
					a12 = radToDeg(sig12)
					omg12 = lam12 / (f1 * dnm)
				} else {
					let numit = 0
					let tripn = false
					let tripb = false
					let salp1a = geoTiny
					let calp1a = 1.0
					let salp1b = geoTiny
					let calp1b = -1.0
					let r = lambda12(sbet1, cbet1, dn1, sbet2, cbet2, dn2, salp1, calp1, slam12, clam12, numit < geoMaxit1, c1a, c2a, c3a)
					for {
						let v = r.lam12
						break when tripb || !(v.abs() >= (tripn ?? (8.0, 1.0)) * geoTol0) || numit == geoMaxit2
						if v > 0.0 && (numit > geoMaxit1 || calp1 / salp1 > calp1b / salp1b) {
							salp1b = salp1
							calp1b = calp1
						} else if v < 0.0 && (numit > geoMaxit1 || calp1 / salp1 < calp1a / salp1a) {
							salp1a = salp1
							calp1a = calp1
						}
						numit++
						let newton = false
						if numit < geoMaxit1 && r.dlam12 > 0.0 {
							let dalp1 = -v / r.dlam12
							if dalp1.abs() < Pi {
								let sdalp1 = sin(dalp1)
								let cdalp1 = cos(dalp1)
								let nsalp1 = salp1 * cdalp1 + calp1 * sdalp1
								if nsalp1 > 0.0 {
									let (s, c) = normalize(nsalp1, calp1 * cdalp1 - salp1 * sdalp1)
									salp1 = s
									calp1 = c
									tripn = v.abs() <= 16.0 * geoTol0
									newton = true
								}
							}
						}
						if !newton {
							let (s, c) = normalize((salp1a + salp1b) / 2.0, (calp1a + calp1b) / 2.0)
							salp1 = s
							calp1 = c
							tripn = false
							tripb = (salp1a - salp1).abs() + (calp1a - calp1) < geoTol0 || (salp1 - salp1b).abs() + (calp1 - calp1b) < geoTol0
						}
						r = lambda12(sbet1, cbet1, dn1, sbet2, cbet2, dn2, salp1, calp1, slam12, clam12, numit < geoMaxit1, c1a, c2a, c3a)
					}
					salp2 = r.salp2
					calp2 = r.calp2
					sig12 = r.sig12
					domg12 = r.domg12
					let (sx, _, _) = lengths(r.eps, sig12, r.ssig1, r.csig1, dn1, r.ssig2, r.csig2, dn2, distance = true, reduced = false, c1a = c1a, c2a = c2a)
					s12x = sx * b
					a12 = radToDeg(sig12)
					if area {
						let sd = sin(domg12)
						let cd = cos(domg12)
						somg12 = slam12 * cd - clam12 * sd
						comg12 = clam12 * cd + slam12 * sd
					}
				}
			}
			let s12a = 0.0
			if area {
				let salp0 = salp1 * cbet1
				let calp0 = hypot(calp1, salp1 * sbet1)
				if calp0 != 0.0 && salp0 != 0.0 {
					let k2 = sq(calp0) * ep2
					let eps = k2 / (2.0 * (1.0 + sqrt(1.0 + k2)) + k2)
					let a4 = sq(a) * calp0 * salp0 * e2
					let (ssig1, csig1) = normalize(sbet1, calp1 * cbet1)
					let (ssig2, csig2) = normalize(sbet2, calp2 * cbet2)
					let c4a = zeros(geoOrder)
					c4f(eps, c4a)
					s12a = a4 * (sinCosSeries(false, ssig2, csig2, c4a) - sinCosSeries(false, ssig1, csig1, c4a))
				}
				if !meridian && somg12 == 2.0 {
					somg12 = sin(omg12)
					comg12 = cos(omg12)
				}
				let alp12 = 0.0
				if !meridian && comg12 > -0.7071 && sbet2 - sbet1 < 1.75 {
					let domg = 1.0 + comg12
					let dbet1 = 1.0 + cbet1
					let dbet2 = 1.0 + cbet2
					alp12 = 2.0 * atan2(somg12 * (sbet1 * dbet2 + sbet2 * dbet1), domg * (sbet1 * sbet2 + dbet1 * dbet2))
				} else {
					let salp12 = salp2 * calp1 - calp2 * salp1
					let calp12 = calp2 * calp1 + salp2 * salp1
					if salp12 == 0.0 && calp12 < 0.0 {
						salp12 = geoTiny * calp1
						calp12 = -1.0
					}
					alp12 = atan2(salp12, calp12)
				}
				s12a += c2 * alp12
				s12a *= swapp * lonsign * latsign
				s12a += 0.0
			}
			if swapp < 0.0 {
				let t1 = salp1
				salp1 = salp2
				salp2 = t1
				let t2 = calp1
				calp1 = calp2
				calp2 = t2
			}
			salp1 *= swapp * lonsign
			calp1 *= swapp * latsign
			salp2 *= swapp * lonsign
			calp2 *= swapp * latsign
			return {a12: a12, s12: 0.0 + s12x, salp1: salp1, calp1: calp1, salp2: salp2, calp2: calp2, s12a: s12a}
		}

		// Solves the direct problem: where the geodesic leaving (lat1, lon1)
		// at azimuth azi1 ends after s12 metres, the azimuth there, and the area
		// term. The longitude is reduced to [-180, 180].
		def direct(lat1In float, lon1 float, azi1 float, s12 float) (float, float, float, float) {
			let lat1 = latFix(lat1In)
			let (salp1, calp1) = sinCosd(angRound(azi1))
			let (sb1, cb1) = sinCosd(angRound(lat1))
			let (sbet1, cbet1Raw) = normalize(f1 * sb1, cb1)
			let cbet1 = cbet1Raw.max(geoTiny)
			let salp0 = salp1 * cbet1
			let calp0 = hypot(calp1, salp1 * sbet1)
			let somg1 = salp0 * sbet1
			let comg1 = sbet1 != 0.0 || calp1 != 0.0 ?? (cbet1 * calp1, 1.0)
			let (ssig1, csig1) = normalize(sbet1, comg1)
			let k2 = sq(calp0) * ep2
			let eps = k2 / (2.0 * (1.0 + sqrt(1.0 + k2)) + k2)
			let a1m1 = a1m1f(eps)
			let c1a = zeros(geoOrder + 1)
			seriesOf(c1Coeff, eps, c1a)
			let b11 = sinCosSeries(true, ssig1, csig1, c1a)
			let s = sin(b11)
			let c = cos(b11)
			let stau1 = ssig1 * c + csig1 * s
			let ctau1 = csig1 * c - ssig1 * s
			let c1pa = zeros(geoOrder + 1)
			seriesOf(c1pCoeff, eps, c1pa)
			let c3a = zeros(geoOrder)
			c3f(eps, c3a)
			let a3c = -f * salp0 * a3f(eps)
			let b31 = sinCosSeries(true, ssig1, csig1, c3a)
			let c4a = zeros(geoOrder)
			c4f(eps, c4a)
			let a4 = sq(a) * calp0 * salp0 * e2
			let b41 = sinCosSeries(false, ssig1, csig1, c4a)
			let tau12 = s12 / (b * (1.0 + a1m1))
			let st = sin(tau12)
			let ct = cos(tau12)
			let b12 = -sinCosSeries(true, stau1 * ct + ctau1 * st, ctau1 * ct - stau1 * st, c1pa)
			let sig12 = tau12 - (b12 - b11)
			let ssig12 = sin(sig12)
			let csig12 = cos(sig12)
			if f.abs() > 0.01 {
				let ssig2 = ssig1 * csig12 + csig1 * ssig12
				let csig2 = csig1 * csig12 - ssig1 * ssig12
				let b12x = sinCosSeries(true, ssig2, csig2, c1a)
				let serr = (1.0 + a1m1) * (sig12 + (b12x - b11)) - s12 / b
				sig12 = sig12 - serr / sqrt(1.0 + k2 * sq(ssig2))
				ssig12 = sin(sig12)
				csig12 = cos(sig12)
			}
			let ssig2 = ssig1 * csig12 + csig1 * ssig12
			let csig2 = csig1 * csig12 - ssig1 * ssig12
			let sbet2 = calp0 * ssig2
			let cbet2 = hypot(salp0, calp0 * csig2)
			if cbet2 == 0.0 {
				cbet2 = geoTiny
				csig2 = geoTiny
			}
			let salp2 = salp0
			let calp2 = calp0 * csig2
			let somg2 = salp0 * ssig2
			let comg2 = csig2
			let omg12 = atan2(somg2 * comg1 - comg2 * somg1, comg2 * comg1 + somg2 * somg1)
			let lam12 = omg12 + a3c * (sig12 + (sinCosSeries(true, ssig2, csig2, c3a) - b31))
			let lon2 = angNormalize(angNormalize(lon1) + angNormalize(radToDeg(lam12)))
			let lat2 = atan2d(sbet2, f1 * cbet2)
			let azi2 = atan2d(salp2, calp2)
			let b42 = sinCosSeries(false, ssig2, csig2, c4a)
			let salp12 = 0.0
			let calp12 = 0.0
			if calp0 == 0.0 || salp0 == 0.0 {
				salp12 = salp2 * calp1 - calp2 * salp1
				calp12 = calp2 * calp1 + salp2 * salp1
			} else {
				salp12 = calp0 * salp0 * (csig12 <= 0.0 ?? (csig1 * (1.0 - csig12) + ssig12 * ssig1, ssig12 * (csig1 * ssig12 / (1.0 + csig12) + ssig1)))
				calp12 = sq(salp0) + sq(calp0) * csig1 * csig2
			}
			let s12a = c2 * atan2(salp12, calp12) + a4 * (b42 - b41)
			return (lat2, lon2, azi2, s12a)
		}

		// The perimeter (metres) and signed area (square metres,
		// counterclockwise positive) of the polygon whose vertices are given
		// in order, edges being geodesics; the ring closes itself.
		def polygon(lats float[], lons float[]) (float, float) {
			let count = lats.len()
			return (0.0, 0.0) when count < 2
			let (lengths, areas) = edges(lats, lons, closing = true, area = true)
			let area0 = 4.0 * Pi * c2
			let areaSum = new Accumulator()
			let perimeter = new Accumulator()
			let crossings = 0
			for let i = 0; i < count; i++ {
				perimeter.add(lengths[i])
				areaSum.add(areas[i])
				crossings += transit(lons[i], lons[(i + 1) % count])
			}
			areaSum.remainder(area0)
			areaSum.add((areaSum.sum() < 0.0 ?? (1.0, -1.0)) * area0 / 2.0) when (crossings & 1) == 1
			areaSum.negate()
			if areaSum.sum() > area0 / 2.0 {
				areaSum.add(-area0)
			} else if areaSum.sum() <= -area0 / 2.0 {
				areaSum.add(area0)
			}
			return (perimeter.sum(), 0.0 + areaSum.sum())
		}

		// The length of each edge of a path (and its area term when area),
		// the closing edge from the last vertex to the first included when
		// closing. Long paths are solved in bands on parallel tasks; each edge
		// lands in its own slot, so the sums the callers make in edge order do
		// not depend on timing.
		def edges(lats float[], lons float[], closing bool, area bool) (float[], float[]) {
			let vertices = lats.len()
			let count = closing ?? (vertices, vertices - 1)
			let lengths = zeros(count.max(0))
			let areas = zeros(area ?? (count.max(0), 0))
			return (lengths, areas) when count <= 0
			let tasks = (count / 2048).clamp(1, 32)
			if tasks == 1 {
				edgeBand(lats, lons, lengths, areas, area, 0, count)
			} else {
				forall let t in 0..tasks {
					edgeBand(lats, lons, lengths, areas, area, count * t / tasks, count * (t + 1) / tasks)
				}
			}
			return (lengths, areas)
		}

		def edgeBand(lats float[], lons float[], lengths float[], areas float[], area bool, from int, to int) {
			let vertices = lats.len()
			for let i = from; i < to; i++ {
				let j = (i + 1) % vertices
				let r = inverse(lats[i], lons[i], lats[j], lons[j], area)
				lengths[i] = r.s12
				areas[i] = r.s12a when area
			}
		}
	}

	// 1 when an edge from lon1 to lon2 crosses the prime meridian eastward,
	// -1 westward, 0 otherwise.
	def transit(lon1In float, lon2In float) int {
		let (lon12, _) = angDiff(lon1In, lon2In)
		let lon1 = angNormalize(lon1In)
		let lon2 = angNormalize(lon2In)
		return 1 when lon12 > 0.0 && ((lon1 < 0.0 && 0.0 <= lon2) || (lon1 > 0.0 && lon2 == 0.0))
		return -1 when lon12 < 0.0 && lon2 < 0.0 && 0.0 <= lon1
		return 0
	}

	// A sum kept as two floats, so long sums of terms of mixed size lose
	// nothing to rounding.
	type Accumulator {
		s float
		t float

		def add(y0 float) {
			let (y, u0) = errorFreeSum(y0, t)
			let (s1, t1) = errorFreeSum(y, s)
			s = s1
			t = t1
			if s == 0.0 {
				s = u0
			} else {
				t += u0
			}
		}

		def sum() float {
			return s
		}

		def negate() {
			s = -s
			t = -t
		}

		def remainder(y float) {
			s = ieeeRemainder(s, y)
			add(0.0)
		}
	}

	// The WGS84 ellipsoid: equatorial radius 6378137 m, flattening
	// 1/298.257223563.
	const wgs84 = new Geodesic(6378137.0, 1.0 / 298.257223563)
}
