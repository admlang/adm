partial module std.math.geo {
	use std.data.encoding::(JSON)

	// A GeoJSON Feature: a geometry (or none) with properties and an optional
	// id (a string or a number).
	type Feature {
		id         ?any
		geometry   ?Geometry
		properties map<string, any> = map<string, any>{}

		def new() {}

		def new(geometry Geometry) {
			self.geometry = geometry
		}

		// The feature as a GeoJSON Feature object; properties written as
		// `std.data.encoding.JSON` writes them, none as `{}`.
		def geojson() string {
			let out byte[]
			writeGeoJSONFeature(out, self)
			return string(out)
		}
	}

	// A GeoJSON FeatureCollection.
	type FeatureCollection {
		features Feature[] = []

		def new() {}

		def new(features Feature[]) {
			self.features = features
		}

		// The collection as a GeoJSON FeatureCollection object.
		def geojson() string {
			let out byte[]
			out.push(...("\{\"type\":\"FeatureCollection\",\"features\":[").bytes())
			for let (i, f) in features {
				out.push(44) when i > 0
				writeGeoJSONFeature(out, f)
			}
			out.push(...("]\}").bytes())
			return string(out)
		}
	}

	// parseGeoJSON reads any GeoJSON object (RFC 7946) as a collection: a
	// FeatureCollection as it is, a Feature as a collection of one, a
	// geometry as one feature without properties. Positions take two or more
	// numbers (longitude, latitude, altitude; further ones are ignored),
	// members the RFC does not define are ignored, `bbox` is not checked.
	// Fails on JSON that is not GeoJSON: an unknown or missing type, a line
	// of fewer than two positions, a polygon ring of fewer than four or one
	// that does not end where it starts.
	def parseGeoJSON(text string) !FeatureCollection {
		let doc = try JSON.parse(text)
		fail "geo: GeoJSON is not an object" unless doc is map<string, any>
		let kind = try geoJSONType(doc)
		if kind == "FeatureCollection" {
			let list = doc.get("features")
			fail "geo: a FeatureCollection has no features array" unless list is any[]
			let out = new FeatureCollection()
			for let item in list {
				fail "geo: a feature is not an object" unless item is map<string, any>
				out.features.push(try featureOf(item))
			}
			return out
		}
		return new FeatureCollection([try featureOf(doc)]) when kind == "Feature"
		return new FeatureCollection([new Feature(try geometryOfJSON(doc, 0))])
	}

	// parseGeoJSONGeometry reads one GeoJSON geometry object. Fails as
	// parseGeoJSON does, and on a Feature or FeatureCollection.
	def parseGeoJSONGeometry(text string) !Geometry {
		let doc = try JSON.parse(text)
		fail "geo: GeoJSON is not an object" unless doc is map<string, any>
		return try geometryOfJSON(doc, 0)
	}

	internal def geoJSONType(doc map<string, any>) !string {
		let kind = doc.get("type")
		fail "geo: a GeoJSON object has no type" unless kind is string
		return kind
	}

	internal def featureOf(doc map<string, any>) !Feature {
		expects {
			assert try geoJSONType(doc) == "Feature" onerror fail "geo: expected a Feature"
		}
		let f = new Feature()
		let id = member(doc, "id")
		if !(id is none) {
			fail "geo: a feature id is neither a string nor a number" unless id is string || id is int || id is float
			f.id = id
		}
		let geometry = member(doc, "geometry")
		if geometry is map<string, any> {
			f.geometry = try geometryOfJSON(geometry, 0)
		} else {
			fail "geo: a feature's geometry is neither an object nor null" unless geometry is none
		}
		let properties = member(doc, "properties")
		if properties is map<string, any> {
			f.properties = properties
		} else {
			fail "geo: a feature's properties are neither an object nor null" unless properties is none
		}
		return f
	}

	// A member's value; none when absent or null.
	internal def member(doc map<string, any>, name string) any {
		return none unless doc.hasKey(name)
		return doc[name]
	}

	internal def geometryOfJSON(doc map<string, any>, depth int) !Geometry {
		expects {
			assert depth <= 100 onerror fail "geo: GeoJSON nests deeper than 100 collections"
		}
		let kind = try geoJSONType(doc)
		if kind == "GeometryCollection" {
			let list = doc.get("geometries")
			fail "geo: a GeometryCollection has no geometries array" unless list is any[]
			let g = new Geometry(GeometryKind.GeometryCollection)
			for let item in list {
				fail "geo: a geometry is not an object" unless item is map<string, any>
				g.parts.push(try geometryOfJSON(item, depth + 1))
			}
			return g
		}
		let coords = doc.get("coordinates")
		fail "geo: a {kind} has no coordinates array" unless coords is any[]
		match kind {
			case "Point":
				return new Geometry(GeometryKind.Point) when coords.len() == 0
				let g = new Geometry(GeometryKind.Point)
				g.paths = [try positionsOf([coords], 1)]
				return g
			case "LineString", "MultiPoint":
				let g = new Geometry(kind == "LineString" ?? (GeometryKind.LineString, GeometryKind.MultiPoint))
				g.paths = [try positionsOf(coords, kind == "LineString" && coords.len() > 0 ?? (2, 0))]
				return g
			case "Polygon":
				let g = new Geometry(GeometryKind.Polygon)
				g.paths = try ringsOf(coords)
				return g
			case "MultiLineString":
				let g = new Geometry(GeometryKind.MultiLineString)
				for let line in coords {
					fail "geo: a MultiLineString member is not an array" unless line is any[]
					let part = new Geometry(GeometryKind.LineString)
					part.paths = [try positionsOf(line, 2)]
					g.parts.push(part)
				}
				return g
			case "MultiPolygon":
				let g = new Geometry(GeometryKind.MultiPolygon)
				for let polygon in coords {
					fail "geo: a MultiPolygon member is not an array" unless polygon is any[]
					let part = new Geometry(GeometryKind.Polygon)
					part.paths = try ringsOf(polygon)
					g.parts.push(part)
				}
				return g
			default:
				fail "geo: \"{kind}\" is not a GeoJSON geometry type"
		}
	}

	internal def ringsOf(list any[]) !GeoPath[] {
		let out GeoPath[] = []
		for let ring in list {
			fail "geo: a polygon ring is not an array" unless ring is any[]
			let p = try positionsOf(ring, 4)
			fail "geo: a polygon ring does not end where it starts" unless p.closedRing()
			out.push(p)
		}
		return out
	}

	internal def positionsOf(list any[], minimum int) !GeoPath {
		expects {
			assert list.len() >= minimum onerror fail "geo: {list.len()} positions where at least {minimum} are needed"
		}
		let p = new GeoPath()
		let withZ = list.len() > 0
		for let item in list {
			fail "geo: a position is not an array of numbers" unless item is any[]
			fail "geo: a position has fewer than two numbers" when item.len() < 2
			let lon = try numberOf(item[0])
			let lat = try numberOf(item[1])
			p.push(lon, lat)
			if item.len() >= 3 {
				p.z.push(try numberOf(item[2]))
			} else {
				withZ = false
			}
		}
		p.z = [] unless withZ
		return p
	}

	internal def numberOf(v any) !float {
		return v when v is float
		return float(v) when v is int
		fail "geo: a coordinate is not a number"
	}

	internal def writeGeoJSONFeature(out byte[], f Feature) {
		out.push(...("\{\"type\":\"Feature\"").bytes())
		let id = f.id
		if !(id is none) {
			out.push(...(",\"id\":").bytes())
			out.push(...JSON.encode(id))
		}
		out.push(...(",\"geometry\":").bytes())
		let g = f.geometry
		if g is none {
			out.push(...("null").bytes())
		} else {
			writeGeoJSONGeometry(out, g)
		}
		out.push(...(",\"properties\":").bytes())
		out.push(...JSON.encode(f.properties))
		out.push(125)
	}

	internal def writeGeoJSONGeometry(out byte[], g Geometry) {
		let names = ["Point", "LineString", "Polygon", "MultiPoint", "MultiLineString", "MultiPolygon", "GeometryCollection"]
		out.push(...("\{\"type\":\"" + names[g.k.value] + "\",").bytes())
		match g.k {
			case GeometryKind.Point:
				out.push(...("\"coordinates\":").bytes())
				if g.paths[0].len() == 0 {
					out.push(...("[]").bytes())
				} else {
					geoJSONPosition(out, g.paths[0], 0)
				}
			case GeometryKind.LineString, GeometryKind.MultiPoint:
				out.push(...("\"coordinates\":").bytes())
				geoJSONPath(out, g.paths[0])
			case GeometryKind.Polygon:
				out.push(...("\"coordinates\":").bytes())
				geoJSONRings(out, g.paths)
			case GeometryKind.MultiLineString:
				out.push(...("\"coordinates\":[").bytes())
				for let (i, part) in g.parts {
					out.push(44) when i > 0
					geoJSONPath(out, part.paths[0])
				}
				out.push(93)
			case GeometryKind.MultiPolygon:
				out.push(...("\"coordinates\":[").bytes())
				for let (i, part) in g.parts {
					out.push(44) when i > 0
					geoJSONRings(out, part.paths)
				}
				out.push(93)
			default:
				out.push(...("\"geometries\":[").bytes())
				for let (i, part) in g.parts {
					out.push(44) when i > 0
					writeGeoJSONGeometry(out, part)
				}
				out.push(93)
		}
		out.push(125)
	}

	internal def geoJSONPosition(out byte[], p GeoPath, i int) {
		out.push(...("[" + shortest(p.lon[i]) + "," + shortest(p.lat[i])).bytes())
		out.push(...("," + shortest(p.z[i])).bytes()) when p.hasZ()
		out.push(93)
	}

	internal def geoJSONPath(out byte[], p GeoPath) {
		out.push(91)
		for let i = 0; i < p.len(); i++ {
			out.push(44) when i > 0
			geoJSONPosition(out, p, i)
		}
		out.push(93)
	}

	// Rings in the RFC's right-hand rule: the exterior counterclockwise, the
	// holes clockwise, reversed where they run the other way.
	internal def geoJSONRings(out byte[], rings GeoPath[]) {
		out.push(91)
		for let (i, ring) in rings {
			out.push(44) when i > 0
			let (_, _, a) = ring.planarAreaCentroid()
			let wrongWay = (i == 0 && a < 0.0) || (i > 0 && a > 0.0)
			geoJSONPath(out, wrongWay ?? (ring.reversed(), ring))
		}
		out.push(93)
	}
}
