partial module std.math.geo {
	use (
		std.simd
		std.bytes::(Endian)
		std.math::(sqrt)
		std.math.geo.geodesic::*
	)

	// The seven geometry types of the OGC Simple Features model, which
	// GeoJSON, WKT and WKB share.
	enum GeometryKind {
		Point,
		LineString,
		Polygon,
		MultiPoint,
		MultiLineString,
		MultiPolygon,
		GeometryCollection,
	}

	// A geometry: a point, a line, a polygon, a collection of one of those, or
	// a collection of any. Coordinates are longitude and latitude in degrees
	// on WGS84; lines between them are straight in that plane for
	// `contains`, `centroid` and `simplify` (as GeoJSON and WKT define them)
	// and geodesics for `length` and `area`, which measure the Earth.
	//
	//     let field = new geo.Geometry([[a, b, c, a]])          // a polygon
	//     let inside = field.contains(new geo.Coordinate(41.85, 12.5))
	//     let hectares = field.area() / 10000.0
	//     println(field.wkt())
	type Geometry {
		internal k     GeometryKind = GeometryKind.GeometryCollection
		// Point (none or one vertex), LineString, MultiPoint: one path.
		// Polygon: its rings, the exterior first.
		internal paths GeoPath[]
		// MultiLineString, MultiPolygon, GeometryCollection: the members.
		internal parts Geometry[]

		// What the geometry is.
		kind GeometryKind {
			def get() GeometryKind {
				return k
			}
		}

		// An empty geometry of the kind.
		def new(kind GeometryKind) {
			k = kind
			paths.push(new GeoPath()) when kind == GeometryKind.LineString || kind == GeometryKind.MultiPoint || kind == GeometryKind.Point
		}

		// A Point.
		def new(point Coordinate) {
			k = GeometryKind.Point
			paths.push(new GeoPath([point]))
		}

		// A LineString or a MultiPoint of the coordinates. Another kind fails
		// an assertion.
		def new(kind GeometryKind, coordinates Coordinate[]) {
			let valid = kind == GeometryKind.LineString || kind == GeometryKind.MultiPoint
			assert valid
			k = kind
			paths.push(new GeoPath(coordinates))
		}

		// A Polygon of the rings: the exterior first, then the holes. Each ring
		// ends where it starts.
		def new(rings Coordinate[][]) {
			k = GeometryKind.Polygon
			for let ring in rings {
				paths.push(new GeoPath(ring))
			}
		}

		// A MultiPoint, MultiLineString, MultiPolygon or GeometryCollection of
		// the members; a multi kind takes only members of its single kind.
		// Anything else fails an assertion.
		def new(kind GeometryKind, members Geometry[]) {
			let valid = true
			match kind {
				case GeometryKind.MultiPoint:
					for let m in members {
						valid = false when m.k != GeometryKind.Point
					}
				case GeometryKind.MultiLineString:
					for let m in members {
						valid = false when m.k != GeometryKind.LineString
					}
				case GeometryKind.MultiPolygon:
					for let m in members {
						valid = false when m.k != GeometryKind.Polygon
					}
				case GeometryKind.GeometryCollection:
				default:
					valid = false
			}
			assert valid
			k = kind
			if kind == GeometryKind.MultiPoint {
				let all = new GeoPath()
				for let m in members {
					all.append(m.paths[0])
				}
				paths.push(all)
			} else {
				parts = members
			}
		}

		// Whether the geometry has no coordinates.
		def isEmpty() bool {
			match k {
				case GeometryKind.Point, GeometryKind.LineString, GeometryKind.MultiPoint:
					return paths[0].len() == 0
				case GeometryKind.Polygon:
					return paths.len() == 0 || paths[0].len() == 0
				default:
					for let p in parts {
						return false unless p.isEmpty()
					}
					return true
			}
		}

		// The coordinate of a Point; none for an empty point or another kind.
		def point() ?Coordinate {
			return none when k != GeometryKind.Point || paths[0].len() == 0
			return paths[0].at(0)
		}

		// The vertices of a Point, LineString or MultiPoint; empty for other
		// kinds.
		def coordinates() Coordinate[] {
			return paths[0].coordinates() when k == GeometryKind.Point || k == GeometryKind.LineString || k == GeometryKind.MultiPoint
			return []
		}

		// The rings of a Polygon, the exterior first; empty for other kinds.
		def rings() Coordinate[][] {
			let out Coordinate[][] = []
			return out when k != GeometryKind.Polygon
			for let p in paths {
				out.push(p.coordinates())
			}
			return out
		}

		// The members of a collection: the Points of a MultiPoint, the lines
		// of a MultiLineString, the polygons of a MultiPolygon, the geometries
		// of a GeometryCollection; empty for the single kinds.
		def members() Geometry[] {
			if k == GeometryKind.MultiPoint {
				let out Geometry[] = []
				for let c in paths[0].coordinates() {
					out.push(new Geometry(c))
				}
				return out
			}
			return parts when k == GeometryKind.MultiLineString || k == GeometryKind.MultiPolygon || k == GeometryKind.GeometryCollection
			return []
		}

		// The smallest box holding every coordinate; none when empty. The box
		// is taken in longitude as given, so a geometry across the antimeridian
		// spans the longitudes between.
		def bounds() ?Bounds {
			let out = new Bounds(90.0, 180.0, -90.0, -180.0)
			let seen = false
			for let p in pathsOf(self) {
				if p.len() > 0 {
					seen = true
					p.extendBox(out)
				}
			}
			return none unless seen
			return out
		}

		// The length in metres along geodesics: of a line, the sum of its
		// segments; of a polygon, the perimeters of its rings; of a
		// collection, the sum over its members. 0 for points.
		def length() float {
			match k {
				case GeometryKind.LineString:
					return paths[0].geodesicLength(false)
				case GeometryKind.Polygon:
					let total = 0.0
					for let ring in paths {
						total += ring.geodesicLength(true)
					}
					return total
				case GeometryKind.MultiLineString, GeometryKind.MultiPolygon, GeometryKind.GeometryCollection:
					let total = 0.0
					for let p in parts {
						total += p.length()
					}
					return total
				default:
					return 0.0
			}
		}

		// The area in square metres on the WGS84 ellipsoid with geodesic
		// edges: a polygon's exterior less its holes, summed over a
		// collection. 0 for points and lines. Ring orientation does not
		// matter.
		def area() float {
			match k {
				case GeometryKind.Polygon:
					let total = 0.0
					for let (i, ring) in paths {
						let (_, a) = wgs84.polygon(ring.ringLatitudes(), ring.ringLongitudes())
						total += i == 0 ?? (a.abs(), -a.abs())
					}
					return total.max(0.0)
				case GeometryKind.MultiPolygon, GeometryKind.GeometryCollection:
					let total = 0.0
					for let p in parts {
						total += p.area()
					}
					return total
				default:
					return 0.0
			}
		}

		// The centre of mass in the longitude and latitude plane, weighted by
		// the highest dimension present: area for polygons, length for lines,
		// count for points (as JTS and PostGIS compute it). None when empty.
		def centroid() ?Coordinate {
			let acc = new CentroidSum()
			acc.add(self)
			return acc.result()
		}

		// Whether the point lies in the geometry or on its boundary: inside a
		// polygon's exterior and not strictly inside a hole, on a line, or at a
		// point. In the longitude and latitude plane, as GeoJSON draws edges.
		def contains(c Coordinate) bool {
			match k {
				case GeometryKind.Point, GeometryKind.MultiPoint:
					let p = paths[0]
					for let i = 0; i < p.len(); i++ {
						return true when p.lat[i] == c.latitude && p.lon[i] == c.longitude
					}
					return false
				case GeometryKind.LineString:
					return paths[0].touches(c.longitude, c.latitude, false)
				case GeometryKind.Polygon:
					return false when paths.len() == 0
					let crossings = 0
					for let ring in paths {
						let (count, on) = ring.classify(c.longitude, c.latitude)
						return true when on
						crossings += count
					}
					return (crossings & 1) == 1
				default:
					for let p in parts {
						return true when p.contains(c)
					}
					return false
			}
		}

		// The geometry with vertices dropped by Douglas-Peucker: every vertex
		// left out lies within tolerance degrees of the simplified line. A ring
		// keeps at least four vertices; a hole that would collapse is dropped,
		// an exterior that would collapse is kept whole.
		def simplify(tolerance float) Geometry {
			let out = new Geometry(k)
			out.paths = []
			match k {
				case GeometryKind.LineString:
					out.paths.push(paths[0].simplified(tolerance, 2))
				case GeometryKind.Polygon:
					for let (i, ring) in paths {
						let s = ring.simplified(tolerance, 4)
						if s.len() >= 4 {
							out.paths.push(s)
						} else if i == 0 {
							out.paths.push(ring)
						}
					}
				case GeometryKind.MultiLineString, GeometryKind.MultiPolygon, GeometryKind.GeometryCollection:
					for let p in parts {
						out.parts.push(p.simplify(tolerance))
					}
				default:
					out.paths = paths
			}
			return out
		}

		// Whether the two are the same kind with the same coordinates in the
		// same order.
		def equals(other Geometry) bool {
			return false when k != other.k || paths.len() != other.paths.len() || parts.len() != other.parts.len()
			for let (i, p) in paths {
				return false unless p.equals(other.paths[i])
			}
			for let (i, p) in parts {
				return false unless p.equals(other.parts[i])
			}
			return true
		}

		// The geometry as WKT (ISO 13249-3, as OGC Simple Features 1.2
		// writes it): `POLYGON ((23.6 46.7, ...))`, longitude first, with `Z`,
		// `M` or `ZM` when every vertex has those values.
		def wkt() string {
			let out byte[]
			writeWKT(out, self, true)
			return string(out)
		}

		// The geometry as PostGIS extended WKT: `SRID=4326;` and the WKT.
		def ewkt(srid int) string {
			return "SRID={srid};" + wkt()
		}

		// The geometry as ISO WKB in the byte order.
		def wkb(order Endian = Endian.Little) byte[] {
			let out byte[]
			writeWKB(out, self, order == Endian.Little, -1)
			return out
		}

		// The geometry as PostGIS extended WKB, with the SRID on the outer
		// geometry, in the byte order.
		def ewkb(srid int, order Endian = Endian.Little) byte[] {
			let out byte[]
			writeWKB(out, self, order == Endian.Little, srid)
			return out
		}

		// The geometry as a GeoJSON geometry object (RFC 7946): polygon
		// exteriors counterclockwise and holes clockwise, as the RFC asks;
		// measures are left out, altitudes kept.
		def geojson() string {
			let out byte[]
			writeGeoJSONGeometry(out, self)
			return string(out)
		}

		// The geometry as WKT.
		def str() string {
			return wkt()
		}
	}

	// Every path of the geometry and of its members.
	internal def pathsOf(g Geometry) GeoPath[] {
		let out = g.paths.clone()
		for let p in g.parts {
			out += pathsOf(p)
		}
		return out
	}

	// Weighted sums of the centroid, kept per dimension: only the highest
	// dimension that has weight counts.
	internal type CentroidSum {
		x float[] = [0.0, 0.0, 0.0]
		y float[] = [0.0, 0.0, 0.0]
		w float[] = [0.0, 0.0, 0.0]

		def add(g Geometry) {
			match g.k {
				case GeometryKind.Point, GeometryKind.MultiPoint:
					let p = g.paths[0]
					for let i = 0; i < p.len(); i++ {
						x[0] += p.lon[i]
						y[0] += p.lat[i]
						w[0] += 1.0
					}
				case GeometryKind.LineString:
					addLine(g.paths[0], false)
				case GeometryKind.Polygon:
					for let (i, ring) in g.paths {
						let (cx, cy, a) = ring.planarAreaCentroid()
						let signed = i == 0 ?? (a.abs(), -a.abs())
						x[2] += cx * signed
						y[2] += cy * signed
						w[2] += signed
						addLine(ring, true)
					}
				default:
					for let p in g.parts {
						add(p)
					}
			}
		}

		// Adds a line's segments by length; a degenerate line of one repeated
		// point counts as a point.
		def addLine(p GeoPath, closed bool) {
			let n = p.len()
			let total = 0.0
			let count = closed ?? (n, n - 1)
			for let i = 0; i < count; i++ {
				let j = (i + 1) % n
				let dx = p.lon[j] - p.lon[i]
				let dy = p.lat[j] - p.lat[i]
				let len = sqrt(dx * dx + dy * dy)
				x[1] += (p.lon[i] + p.lon[j]) / 2.0 * len
				y[1] += (p.lat[i] + p.lat[j]) / 2.0 * len
				w[1] += len
				total += len
			}
			if total == 0.0 && n > 0 {
				x[0] += p.lon[0]
				y[0] += p.lat[0]
				w[0] += 1.0
			}
		}

		def result() ?Coordinate {
			for let d = 2; d >= 0; d-- {
				return new Coordinate(y[d] / w[d], x[d] / w[d]) when w[d] != 0.0
			}
			return none
		}
	}

	// A sequence of vertices kept as parallel arrays: what lines, rings and
	// point sets are made of. Altitudes and measures are kept when every
	// vertex has one.
	internal type GeoPath {
		lat  float[]
		lon  float[]
		// Altitudes, empty when the path has none.
		z    float[]
		// Measures, empty when the path has none.
		m    float[]
		// The box, once box() has worked it out.
		bbox ?Bounds

		def new() {}

		def new(coordinates Coordinate[]) {
			let withZ = coordinates.len() > 0
			let withM = coordinates.len() > 0
			for let c in coordinates {
				withZ = false when c.altitude is none
				withM = false when c.measure is none
			}
			lat.cap(coordinates.len())
			lon.cap(coordinates.len())
			for let c in coordinates {
				lat.push(c.latitude)
				lon.push(c.longitude)
				let alt = c.altitude
				z.push(alt) when withZ && !(alt is none)
				let mv = c.measure
				m.push(mv) when withM && !(mv is none)
			}
		}

		def len() int {
			return lat.len()
		}

		def hasZ() bool {
			return z.len() > 0 && z.len() == lat.len()
		}

		def hasM() bool {
			return m.len() > 0 && m.len() == lat.len()
		}

		def at(i int) Coordinate {
			let c = new Coordinate(lat[i], lon[i])
			c.altitude = z[i] when hasZ()
			c.measure = m[i] when hasM()
			return c
		}

		def coordinates() Coordinate[] {
			let out Coordinate[] = []
			out.cap(lat.len())
			for let i = 0; i < lat.len(); i++ {
				out.push(at(i))
			}
			return out
		}

		// Appends another path's vertices; dimensions only one side has are
		// dropped.
		def append(other GeoPath) {
			let keepZ = (hasZ() || len() == 0) && other.hasZ()
			let keepM = (hasM() || len() == 0) && other.hasM()
			z = [] unless keepZ
			m = [] unless keepM
			lat += other.lat
			lon += other.lon
			z += other.z when keepZ
			m += other.m when keepM
		}

		def push(lonValue float, latValue float) {
			lat.push(latValue)
			lon.push(lonValue)
		}

		// The vertices in the opposite order.
		def reversed() GeoPath {
			let out = new GeoPath()
			out.lat = lat.clone().reverse()
			out.lon = lon.clone().reverse()
			out.z = z.clone().reverse()
			out.m = m.clone().reverse()
			return out
		}

		def equals(other GeoPath) bool {
			return lat.equals(other.lat) && lon.equals(other.lon) && z.equals(other.z) && m.equals(other.m)
		}

		def extendBox(b Bounds) {
			for let i = 0; i < lat.len(); i++ {
				b.south = b.south.min(lat[i])
				b.north = b.north.max(lat[i])
				b.west = b.west.min(lon[i])
				b.east = b.east.max(lon[i])
			}
		}

		// The ring's vertices without the closing repeat of the first.
		def ringLatitudes() float[] {
			return closedRing() ?? (lat[:lat.len() - 1], lat)
		}

		def ringLongitudes() float[] {
			return closedRing() ?? (lon[:lon.len() - 1], lon)
		}

		def closedRing() bool {
			let n = lat.len()
			return n > 1 && lat[0] == lat[n - 1] && lon[0] == lon[n - 1]
		}

		// The geodesic length of the segments; a ring adds the closing edge
		// when its last vertex is not its first.
		def geodesicLength(ring bool) float {
			let (lengths, _) = wgs84.edges(lat, lon, closing = ring && lat.len() > 1 && !closedRing(), area = false)
			let total = new Accumulator()
			for let d in lengths {
				total.add(d)
			}
			return total.sum()
		}

		// The planar area centroid of the ring (shoelace) and its signed area,
		// counterclockwise positive.
		def planarAreaCentroid() (float, float, float) {
			let n = lat.len()
			let a = 0.0
			let cx = 0.0
			let cy = 0.0
			// Relative to the first vertex, so large longitudes lose nothing.
			let x0 = n > 0 ?? (lon[0], 0.0)
			let y0 = n > 0 ?? (lat[0], 0.0)
			for let i = 0; i < n; i++ {
				let j = (i + 1) % n
				let xi = lon[i] - x0
				let yi = lat[i] - y0
				let xj = lon[j] - x0
				let yj = lat[j] - y0
				let cross = xi * yj - xj * yi
				a += cross
				cx += (xi + xj) * cross
				cy += (yi + yj) * cross
			}
			return (0.0, 0.0, 0.0) when a == 0.0
			return (cx / (3.0 * a) + x0, cy / (3.0 * a) + y0, a / 2.0)
		}

		// Where (x, y) lies against the ring: the number of edges a ray from it
		// towards +x crosses (crossing-number test) and whether it lies on an
		// edge, in one pass four edges at a time. A point outside the ring's
		// box crosses nothing. Edges are tested without division: the ray
		// meets edge i→j right of the point when the cross product
		// dx·(y − yi) − dy·(x − xi) has the sign of dy.
		def classify(x float, y float) (int, bool) {
			let n = lat.len()
			return (0, false) when n == 0
			let b = box()
			return (0, false) when x < b.west || x > b.east || y < b.south || y > b.north
			let count = 0
			let px = simd.splat4<float>(x)
			let py = simd.splat4<float>(y)
			let zero = simd.splat4<float>(0.0)
			let i = 0
			for i + 4 < n {
				let yi = simd.load4<float>(lat, i)
				let yj = simd.load4<float>(lat, i + 1)
				// Edges whose latitude span holds the point: every edge the ray
				// can cross or the point can lie on, and few of all.
				let inY = py.ge(yi.min(yj)).and(py.le(yi.max(yj)))
				if inY.any() {
					let xi = simd.load4<float>(lon, i)
					let xj = simd.load4<float>(lon, i + 1)
					let dx = xj - xi
					let dy = yj - yi
					let cross = dx * (py - yi) - dy * (px - xi)
					let straddles = yi.gt(py).xor(yj.gt(py))
					count += popcount4(straddles.and((cross * dy).gt(zero)).bits())
					let inX = px.ge(xi.min(xj)).and(px.le(xi.max(xj)))
					return (0, true) when cross.eq(zero).and(inX).and(inY).any()
				}
				i += 4
			}
			for i < n - 1 {
				let (c, on) = edgeClass(lon[i], lat[i], lon[i + 1], lat[i + 1], x, y)
				return (0, true) when on
				count += c
				i++
			}
			if !closedRing() {
				let (c, on) = edgeClass(lon[n - 1], lat[n - 1], lon[0], lat[0], x, y)
				return (0, true) when on
				count += c
			}
			return (count, false)
		}

		// The path's box, worked out once: a path does not change after it is
		// built.
		def box() Bounds {
			let cached = bbox
			return cached unless cached is none
			let b = new Bounds(90.0, 180.0, -90.0, -180.0)
			extendBox(b)
			bbox = b
			return b
		}

		// Whether (x, y) lies on one of the segments (on the closing edge too
		// for a ring).
		def touches(x float, y float, ring bool) bool {
			let n = lat.len()
			return n == 1 && lon[0] == x && lat[0] == y when n < 2
			for let i = 0; i < n - 1; i++ {
				let (_, on) = edgeClass(lon[i], lat[i], lon[i + 1], lat[i + 1], x, y)
				return true when on
			}
			let (_, closing) = edgeClass(lon[n - 1], lat[n - 1], lon[0], lat[0], x, y)
			return ring && !closedRing() && closing
		}

		// Douglas-Peucker with an explicit stack, keeping at least minimum
		// vertices when the path has that many.
		def simplified(tolerance float, minimum int) GeoPath {
			let n = lat.len()
			return self when n <= minimum
			let keep bool[] = []
			keep.len(n)
			keep[0] = true
			keep[n - 1] = true
			let stack int[] = [0, n - 1]
			for stack.len() > 0 {
				let last = stack.pop()
				let first = stack.pop()
				let worst = -1.0
				let at = -1
				for let i = first + 1; i < last; i++ {
					let d = segmentDistance(lon[first], lat[first], lon[last], lat[last], lon[i], lat[i])
					if d > worst {
						worst = d
						at = i
					}
				}
				if at >= 0 && worst > tolerance {
					keep[at] = true
					stack.push(first, at, at, last)
				}
			}
			let out = new GeoPath()
			for let i = 0; i < n; i++ {
				if keep[i] {
					out.lat.push(lat[i])
					out.lon.push(lon[i])
					out.z.push(z[i]) when hasZ()
					out.m.push(m[i]) when hasM()
				}
			}
			return out
		}
	}

	internal def popcount4(bits uint64) int {
		let b = bits & 0xF
		return int((b & 1) + ((b >> 1) & 1) + ((b >> 2) & 1) + ((b >> 3) & 1))
	}

	// One edge against (x, y): 1 when a ray from the point towards +x crosses
	// it, and whether the point lies on it; the same test classify makes four
	// edges at a time.
	internal def edgeClass(x1 float, y1 float, x2 float, y2 float, x float, y float) (int, bool) {
		let dx = x2 - x1
		let dy = y2 - y1
		let cross = dx * (y - y1) - dy * (x - x1)
		return (0, true) when cross == 0.0 && x >= x1.min(x2) && x <= x1.max(x2) && y >= y1.min(y2) && y <= y1.max(y2)
		return ((y1 > y) != (y2 > y) && cross * dy > 0.0 ?? (1, 0), false)
	}

	// The distance from (x, y) to the segment from (x1, y1) to (x2, y2), in
	// the plane.
	internal def segmentDistance(x1 float, y1 float, x2 float, y2 float, x float, y float) float {
		let dx = x2 - x1
		let dy = y2 - y1
		let len2 = dx * dx + dy * dy
		let t = len2 == 0.0 ?? (0.0, (((x - x1) * dx + (y - y1) * dy) / len2).max(0.0).min(1.0))
		let ex = x1 + t * dx - x
		let ey = y1 + t * dy - y
		return sqrt(ex * ex + ey * ey)
	}
}
