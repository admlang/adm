partial module std.math.geo {
	use (
		std.math::(sqrt, sin, cos, tan, atan, atan2)
		std.math.geo.geodesic::*
	)

	// The latitude band letters of UTM, 8 degrees each from 80°S; X spans 12.
	internal const utmBands = "CDEFGHJKLMNPQRSTUVWX"

	// A position in the Universal Transverse Mercator grid on WGS84: a zone
	// (1 to 60, 6 degrees of longitude each), the hemisphere, and easting and
	// northing in metres (500 000 m east at the zone's central meridian,
	// northing from the equator, plus 10 000 000 m in the south).
	@portable
	type UTM {
		zone     int
		north    bool
		easting  float
		northing float

		// The position; a zone outside 1 to 60 fails an assertion.
		def new(zone int, north bool, easting float, northing float) {
			let valid = zone >= 1 && zone <= 60
			assert valid
			self.zone = zone
			self.north = north
			self.easting = easting
			self.northing = northing
		}

		// The latitude and longitude of the position.
		def coordinate() Coordinate {
			let (lat, lon) = utmInverse(zone, north, easting, northing)
			return new Coordinate(lat, lon)
		}

		// The latitude band letter of the position, C to X.
		def band() char {
			return bandOf(coordinate().latitude)
		}

		// "34T 618423.123 5168891.456": zone, band, easting and northing to
		// the millimetre.
		def str() string {
			return "{zone}{band()} " + "%.3f".format(easting) + " " + "%.3f".format(northing)
		}
	}

	// parseUTM reads "zone band easting northing", as `str` writes it
	// ("34T 618423 5168891", the band letter in either case; spaces may
	// separate zone and band). The band gives the hemisphere: N to X north,
	// C to M south. Fails on anything else.
	def parseUTM(text string) !UTM {
		let fields = text.trim().split(" ").filter(f => f != "")
		fields = [fields[0] + fields[1], fields[2], fields[3]] when fields.len() == 4
		fail "geo: \"{text}\" is not a UTM position" when fields.len() != 3
		let head = fields[0].upper()
		fail "geo: \"{text}\" has no band letter" when head.len() < 2
		let letter = head[head.len() - 1:]
		let digits = head[:head.len() - 1]
		fail "geo: \"{text}\" has no zone number" unless digits.isNumeric()
		let zone = digits.toInt<int>()
		let band = utmBands.indexOf(letter)
		fail "geo: \"{letter}\" is not a UTM band letter" when band < 0 || letter.len() != 1
		fail "geo: zone {zone} is not between 1 and 60" when zone < 1 || zone > 60
		let easting = try parseGridNumber(fields[1], text)
		let northing = try parseGridNumber(fields[2], text)
		return new UTM(zone, band >= 10, easting, northing)
	}

	internal def parseGridNumber(field string, text string) !float {
		for let c in field {
			fail "geo: \"{text}\" is not a UTM position" unless c.isDigit() || c == '.' || c == '-'
		}
		return parseFloat<float>(field)
	}

	internal def bandOf(latitude float) char {
		let index = int(((latitude + 80.0) / 8.0).floor()).max(0).min(19)
		return utmBands[index]
	}

	// The standard zone of a position, with the exceptions of the grid: zone
	// 32 widened over south-western Norway and zones 31, 33, 35 and 37 over
	// Svalbard.
	internal def utmZoneOf(latitude float, longitude float) int {
		let lon = angNormalize(longitude)
		lon = -180.0 when lon == 180.0
		let zone = int(((lon + 180.0) / 6.0).floor()) + 1
		return 32 when latitude >= 56.0 && latitude < 64.0 && lon >= 3.0 && lon < 12.0
		if latitude >= 72.0 {
			return 31 when lon >= 0.0 && lon < 9.0
			return 33 when lon >= 9.0 && lon < 21.0
			return 35 when lon >= 21.0 && lon < 33.0
			return 37 when lon >= 33.0 && lon < 42.0
		}
		return zone.min(60)
	}

	// The UTM position of a coordinate, in its standard zone or in zone when
	// that is given (1 to 60). Fails outside 80°S to 84°N, where the grid
	// ends, and on a zone outside 1 to 60.
	internal def utmOf(c Coordinate, zone int) !UTM {
		expects {
			assert c.latitude >= -80.0 && c.latitude <= 84.0 onerror fail "geo: latitude {c.latitude} lies outside UTM's 80°S to 84°N"
			assert zone == 0 || zone >= 1 && zone <= 60 onerror fail "geo: zone {zone} is not between 1 and 60"
		}
		let z = zone == 0 ?? (utmZoneOf(c.latitude, c.longitude), zone)
		let (x, y) = transverseMercator(c.latitude, c.longitude - float(6 * z - 183))
		let north = c.latitude >= 0.0
		return new UTM(z, north, 500000.0 + x, north ?? (y, y + 10000000.0))
	}

	// The scale factor on a UTM zone's central meridian.
	internal const utmScale = 0.9996

	// WGS84's third flattening n and the series of Karney (2011),
	// "Transverse Mercator with an accuracy of a few nanometers": α for the
	// forward projection, β for the inverse, both to sixth order in n, and the
	// rectifying radius A.
	internal const tmN = (1.0 / 298.257223563) / (2.0 - 1.0 / 298.257223563)
	internal const tmE = sqrt((1.0 / 298.257223563) * (2.0 - 1.0 / 298.257223563))
	internal const tmA = 6378137.0 / (1.0 + tmN) * (1.0 + tmN * tmN / 4.0 + tmN * tmN * tmN * tmN / 64.0 + tmN * tmN * tmN * tmN * tmN * tmN / 256.0)
	internal const tmAlpha = krugerSeries([[0.5, -2.0 / 3.0, 5.0 / 16.0, 41.0 / 180.0, -127.0 / 288.0, 7891.0 / 37800.0], [13.0 / 48.0, -3.0 / 5.0, 557.0 / 1440.0, 281.0 / 630.0, -1983433.0 / 1935360.0], [61.0 / 240.0, -103.0 / 140.0, 15061.0 / 26880.0, 167603.0 / 181440.0], [49561.0 / 161280.0, -179.0 / 168.0, 6601661.0 / 7257600.0], [34729.0 / 80640.0, -3418889.0 / 1995840.0], [212378941.0 / 319334400.0]])
	internal const tmBeta = krugerSeries([[0.5, -2.0 / 3.0, 37.0 / 96.0, -1.0 / 360.0, -81.0 / 512.0, 96199.0 / 604800.0], [1.0 / 48.0, 1.0 / 15.0, -437.0 / 1440.0, 46.0 / 105.0, -1118711.0 / 3870720.0], [17.0 / 480.0, -37.0 / 840.0, -209.0 / 4480.0, 5569.0 / 90720.0], [4397.0 / 161280.0, -11.0 / 504.0, -830251.0 / 7257600.0], [4583.0 / 161280.0, -108847.0 / 3991680.0], [20648693.0 / 638668800.0]])

	// Coefficient j (1 to 6) is n^j times its polynomial in n.
	internal def krugerSeries(rows float[][]) float[] {
		let out float[] = [0.0]
		for let (j, row) in rows {
			let v = 0.0
			let power = 1.0
			for let i = 0; i <= j; i++ {
				power *= tmN
			}
			for let coefficient in row {
				v += coefficient * power
				power *= tmN
			}
			out.push(v)
		}
		return out
	}

	// tan of the conformal latitude, from tan of the geographic one (Karney
	// 2011, equation 7).
	internal def conformalTan(tau float) float {
		let tau1 = hypot(1.0, tau)
		let sig = sinh(tmE * atanh(tmE * tau / tau1))
		return hypot(1.0, sig) * tau - sig * tau1
	}

	// The x and y (metres, scale applied) of a latitude and a longitude
	// relative to the central meridian.
	internal def transverseMercator(latitude float, lonFromCentral float) (float, float) {
		let lambda = degToRad(angNormalize(lonFromCentral))
		let tauP = conformalTan(tan(degToRad(latitude)))
		let xiP = atan2(tauP, cos(lambda))
		let etaP = asinh(sin(lambda) / hypot(tauP, cos(lambda)))
		let xi = xiP
		let eta = etaP
		for let j = 1; j <= 6; j++ {
			xi += tmAlpha[j] * sin(2.0 * float(j) * xiP) * cosh(2.0 * float(j) * etaP)
			eta += tmAlpha[j] * cos(2.0 * float(j) * xiP) * sinh(2.0 * float(j) * etaP)
		}
		return (utmScale * tmA * eta, utmScale * tmA * xi)
	}

	// The latitude and longitude of a UTM position.
	internal def utmInverse(zone int, north bool, easting float, northing float) (float, float) {
		let xi = (north ?? (northing, northing - 10000000.0)) / (utmScale * tmA)
		let eta = (easting - 500000.0) / (utmScale * tmA)
		let xiP = xi
		let etaP = eta
		for let j = 1; j <= 6; j++ {
			xiP -= tmBeta[j] * sin(2.0 * float(j) * xi) * cosh(2.0 * float(j) * eta)
			etaP -= tmBeta[j] * cos(2.0 * float(j) * xi) * sinh(2.0 * float(j) * eta)
		}
		let tauP = sin(xiP) / hypot(sinh(etaP), cos(xiP))
		let lambda = atan2(sinh(etaP), cos(xiP))
		// Newton's method for tau from tau' (Karney 2011, equations 19-21).
		let e2m = 1.0 - tmE * tmE
		let tau = tauP / e2m
		for let i = 0; i < 6; i++ {
			let t1 = conformalTan(tau)
			let delta = (tauP - t1) / hypot(1.0, t1) * (1.0 + e2m * tau * tau) / (e2m * hypot(1.0, tau))
			tau += delta
			break when delta.abs() < 1e-15 * tau.abs().max(1.0)
		}
		return (radToDeg(atan(tau)), angNormalize(radToDeg(lambda) + float(6 * zone - 183)))
	}
}
