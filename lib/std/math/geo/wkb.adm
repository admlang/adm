partial module std.math.geo {
	// The extended WKB flags PostGIS sets in the type word.
	internal const ewkbZ = 0x80000000
	internal const ewkbM = 0x40000000
	internal const ewkbSRID = 0x20000000

	// parseWKB reads a geometry from WKB: ISO WKB (type codes 1 to 7, plus
	// 1000 for Z, 2000 for M, 3000 for ZM) and PostGIS extended WKB (Z, M and
	// SRID flags), in either byte order, members of collections in their own
	// byte order, an empty point as NaN coordinates. The SRID is read and
	// left out (use parseEWKB to keep it). Fails on truncated data, an
	// unknown type, a member of the wrong kind in a multi geometry, nesting
	// deeper than 100 collections, or bytes left over.
	def parseWKB(data byte[]) !Geometry {
		let (g, _) = try parseEWKB(data)
		return g
	}

	// parseEWKB reads WKB as parseWKB does and returns the geometry and its
	// SRID (0 when the data carries none). Fails as parseWKB does.
	def parseEWKB(data byte[]) !(Geometry, int) {
		let r = new WKBReader(data)
		let g = try r.geometry(0)
		fail "geo: {data.len() - r.at} bytes after the WKB geometry" when r.at != data.len()
		return (g, r.srid)
	}

	// Writes a geometry as WKB: ISO type codes when srid < 0, else extended
	// WKB with the SRID on this (outer) geometry.
	internal def writeWKB(out byte[], g Geometry, little bool, srid int) {
		let (hasZ, hasM) = dimensionsOf(g)
		out.push(little ?? (1, 0))
		let base = g.k.value + 1
		if srid < 0 {
			wkbUint32(out, base + (hasZ ?? (1000, 0)) + (hasM ?? (2000, 0)), little)
		} else {
			let flags = (hasZ ?? (ewkbZ, 0)) | (hasM ?? (ewkbM, 0)) | (srid > 0 ?? (ewkbSRID, 0))
			wkbUint32(out, base | flags, little)
			wkbUint32(out, srid, little) when srid > 0
		}
		let members = srid < 0 ?? (-1, 0)
		match g.k {
			case GeometryKind.Point:
				let p = g.paths[0]
				if p.len() == 0 {
					let count = 2 + (hasZ ?? (1, 0)) + (hasM ?? (1, 0))
					for let i = 0; i < count; i++ {
						wkbFloat(out, 0.0 / 0.0, little)
					}
				} else {
					wkbPosition(out, p, 0, hasZ, hasM, little)
				}
			case GeometryKind.LineString:
				wkbPath(out, g.paths[0], hasZ, hasM, little)
			case GeometryKind.Polygon:
				wkbUint32(out, g.paths.len(), little)
				for let ring in g.paths {
					wkbPath(out, ring, hasZ, hasM, little)
				}
			case GeometryKind.MultiPoint:
				let p = g.paths[0]
				wkbUint32(out, p.len(), little)
				for let i = 0; i < p.len(); i++ {
					out.push(little ?? (1, 0))
					if members < 0 {
						wkbUint32(out, 1 + (hasZ ?? (1000, 0)) + (hasM ?? (2000, 0)), little)
					} else {
						wkbUint32(out, 1 | (hasZ ?? (ewkbZ, 0)) | (hasM ?? (ewkbM, 0)), little)
					}
					wkbPosition(out, p, i, hasZ, hasM, little)
				}
			default:
				wkbUint32(out, g.parts.len(), little)
				for let part in g.parts {
					writeWKB(out, part, little, members)
				}
		}
	}

	internal def wkbPosition(out byte[], p GeoPath, i int, hasZ bool, hasM bool, little bool) {
		wkbFloat(out, p.lon[i], little)
		wkbFloat(out, p.lat[i], little)
		wkbFloat(out, p.z[i], little) when hasZ
		wkbFloat(out, p.m[i], little) when hasM
	}

	internal def wkbPath(out byte[], p GeoPath, hasZ bool, hasM bool, little bool) {
		wkbUint32(out, p.len(), little)
		for let i = 0; i < p.len(); i++ {
			wkbPosition(out, p, i, hasZ, hasM, little)
		}
	}

	internal def wkbUint32(out byte[], v int, little bool) {
		let u = uint32(v)
		if little {
			out.push(byte(u & 0xFF), byte((u >> 8) & 0xFF), byte((u >> 16) & 0xFF), byte(u >> 24))
		} else {
			out.push(byte(u >> 24), byte((u >> 16) & 0xFF), byte((u >> 8) & 0xFF), byte(u & 0xFF))
		}
	}

	internal def wkbFloat(out byte[], v float, little bool) {
		let u = __bitcast_u64_from_f64(float64(v))
		for let i = 0; i < 8; i++ {
			let shift = little ?? (i * 8, (7 - i) * 8)
			out.push(byte((u >> shift) & 0xFF))
		}
	}

	// A cursor over WKB bytes.
	internal type WKBReader {
		b    byte[]
		at   int    = 0
		srid int    = 0

		def new(data byte[]) {
			b = data
		}

		def uint32At(little bool) !int {
			fail "geo: WKB ends at offset {at}" when b.len() - at < 4
			let v = little ?? (uint32(b[at]) | (uint32(b[at + 1]) << 8) | (uint32(b[at + 2]) << 16) | (uint32(b[at + 3]) << 24), (uint32(b[at]) << 24) | (uint32(b[at + 1]) << 16) | (uint32(b[at + 2]) << 8) | uint32(b[at + 3]))
			at += 4
			return int(v)
		}

		def float64At(little bool) !float {
			fail "geo: WKB ends at offset {at}" when b.len() - at < 8
			let u uint64 = 0
			for let i = 0; i < 8; i++ {
				let byteAt = little ?? (at + 7 - i, at + i)
				u = (u << 8) | uint64(b[byteAt])
			}
			at += 8
			return float(__bitcast_f64_from_u64(u))
		}

		// A count of items of at least itemBytes each, checked against the
		// bytes left so a damaged count cannot ask for a huge array.
		def count(little bool, itemBytes int) !int {
			let n = try uint32At(little)
			fail "geo: WKB count {n} at offset {at - 4} runs past the data" when n * itemBytes > b.len() - at
			return n
		}

		def geometry(depth int) !Geometry {
			expects {
				assert depth <= 100 onerror fail "geo: WKB nests deeper than 100 collections"
			}
			fail "geo: WKB ends at offset {at}" when at >= b.len()
			let order = b[at]
			fail "geo: byte order {order} at offset {at} is neither 0 nor 1" when order > 1
			at++
			let little = order == 1
			let word = try uint32At(little)
			let hasZ = (word & ewkbZ) != 0
			let hasM = (word & ewkbM) != 0
			if (word & ewkbSRID) != 0 {
				let id = try uint32At(little)
				srid = id when depth == 0
			}
			let code = word & 0x0FFFFFFF
			let base = code % 1000
			let iso = code / 1000
			fail "geo: WKB type {code} is not a geometry" when base < 1 || base > 7 || iso > 3
			hasZ = hasZ || iso == 1 || iso == 3
			hasM = hasM || iso == 2 || iso == 3
			let kind = geometryKinds[base - 1]
			let dims = 2 + (hasZ ?? (1, 0)) + (hasM ?? (1, 0))
			let g = new Geometry(kind)
			g.paths = []
			match kind {
				case GeometryKind.Point:
					let p = try path(little, 1, hasZ, hasM)
					if p.lat[0] != p.lat[0] && p.lon[0] != p.lon[0] {
						g.paths.push(new GeoPath())
					} else {
						g.paths.push(p)
					}
				case GeometryKind.LineString:
					g.paths.push(try path(little, try count(little, dims * 8), hasZ, hasM))
				case GeometryKind.Polygon:
					let n = try count(little, 4)
					for let i = 0; i < n; i++ {
						g.paths.push(try path(little, try count(little, dims * 8), hasZ, hasM))
					}
				case GeometryKind.MultiPoint:
					let n = try count(little, 5 + dims * 8)
					let all = new GeoPath()
					for let i = 0; i < n; i++ {
						let member = try geometry(depth + 1)
						fail "geo: a MultiPoint holds a {member.k.name}" when member.k != GeometryKind.Point
						all.append(member.paths[0])
					}
					g.paths.push(all)
				default:
					let n = try count(little, 9)
					let want = kind == GeometryKind.MultiLineString ?? (GeometryKind.LineString, kind == GeometryKind.MultiPolygon ?? (GeometryKind.Polygon, GeometryKind.GeometryCollection))
					for let i = 0; i < n; i++ {
						let member = try geometry(depth + 1)
						fail "geo: a {kind.name} holds a {member.k.name}" when want != GeometryKind.GeometryCollection && member.k != want
						g.parts.push(member)
					}
			}
			return g
		}

		def path(little bool, n int, hasZ bool, hasM bool) !GeoPath {
			let p = new GeoPath()
			p.lat.cap(n)
			p.lon.cap(n)
			for let i = 0; i < n; i++ {
				let x = try float64At(little)
				let y = try float64At(little)
				p.push(x, y)
				p.z.push(try float64At(little)) when hasZ
				p.m.push(try float64At(little)) when hasM
			}
			return p
		}
	}
}
