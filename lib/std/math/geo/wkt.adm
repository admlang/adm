partial module std.math.geo {
	// The WKT names of the kinds, in GeometryKind order.
	internal const wktNames = ["POINT", "LINESTRING", "POLYGON", "MULTIPOINT", "MULTILINESTRING", "MULTIPOLYGON", "GEOMETRYCOLLECTION"]

	// parseWKT reads a geometry from WKT (OGC Simple Features 1.2 / ISO
	// 13249-3): every kind, `Z`, `M` and `ZM` (written apart or joined, as
	// in `POINTZ`), `EMPTY` at any level, both spellings of a MultiPoint
	// (`MULTIPOINT (1 2, 3 4)` and `MULTIPOINT ((1 2), (3 4))`), keywords in
	// any case. A PostGIS `SRID=n;` prefix is read and left out (use
	// parseEWKT to keep it). Without a dimension keyword, three numbers per
	// position are x y z and four x y z m. Fails on anything else, on a
	// polygon ring with fewer than four positions or that does not end where
	// it starts, and on a line of a single position.
	def parseWKT(text string) !Geometry {
		let (g, _) = try parseEWKT(text)
		return g
	}

	// parseEWKT reads PostGIS extended WKT and returns the geometry and its
	// SRID (0 when the text has no `SRID=n;` prefix). Fails as parseWKT does.
	def parseEWKT(text string) !(Geometry, int) {
		let r = new WKTReader(text)
		let srid = 0
		r.space()
		if r.wordAhead("SRID") {
			r.word()
			r.space()
			fail "geo: expected '=' after SRID at offset {r.at}" unless r.take(61)
			srid = int(try r.number())
			r.space()
			fail "geo: expected ';' after the SRID at offset {r.at}" unless r.take(59)
		}
		let g = try r.geometry(0)
		r.space()
		fail "geo: text after the geometry at offset {r.at}" when r.at < r.b.len()
		return (g, srid)
	}

	// Writes a geometry as WKT; tagged writes its dimension keyword (members
	// of a collection repeat it, as ISO WKT does).
	internal def writeWKT(out byte[], g Geometry, tagged bool) {
		out.push(...wktNames[g.k.value].bytes())
		let (hasZ, hasM) = dimensionsOf(g)
		out.push(...(hasZ && hasM ?? (" ZM", hasZ ?? (" Z", " M"))).bytes()) when tagged && (hasZ || hasM)
		if g.isEmpty() {
			out.push(...(" EMPTY").bytes())
			return
		}
		out.push(32)
		match g.k {
			case GeometryKind.Point:
				out.push(40)
				writeWKTPosition(out, g.paths[0], 0, hasZ, hasM)
				out.push(41)
			case GeometryKind.LineString:
				writeWKTPath(out, g.paths[0], hasZ, hasM)
			case GeometryKind.Polygon:
				writeWKTRings(out, g.paths, hasZ, hasM)
			case GeometryKind.MultiPoint:
				out.push(40)
				let p = g.paths[0]
				for let i = 0; i < p.len(); i++ {
					out.push(44, 32) when i > 0
					out.push(40)
					writeWKTPosition(out, p, i, hasZ, hasM)
					out.push(41)
				}
				out.push(41)
			case GeometryKind.MultiLineString:
				out.push(40)
				for let (i, part) in g.parts {
					out.push(44, 32) when i > 0
					if part.isEmpty() {
						out.push(...("EMPTY").bytes())
					} else {
						writeWKTPath(out, part.paths[0], hasZ, hasM)
					}
				}
				out.push(41)
			case GeometryKind.MultiPolygon:
				out.push(40)
				for let (i, part) in g.parts {
					out.push(44, 32) when i > 0
					if part.isEmpty() {
						out.push(...("EMPTY").bytes())
					} else {
						writeWKTRings(out, part.paths, hasZ, hasM)
					}
				}
				out.push(41)
			default:
				out.push(40)
				for let (i, part) in g.parts {
					out.push(44, 32) when i > 0
					writeWKT(out, part, true)
				}
				out.push(41)
		}
	}

	internal def writeWKTPosition(out byte[], p GeoPath, i int, hasZ bool, hasM bool) {
		out.push(...(shortest(p.lon[i]) + " " + shortest(p.lat[i])).bytes())
		out.push(...(" " + shortest(p.z[i])).bytes()) when hasZ
		out.push(...(" " + shortest(p.m[i])).bytes()) when hasM
	}

	internal def writeWKTPath(out byte[], p GeoPath, hasZ bool, hasM bool) {
		out.push(40)
		for let i = 0; i < p.len(); i++ {
			out.push(44, 32) when i > 0
			writeWKTPosition(out, p, i, hasZ, hasM)
		}
		out.push(41)
	}

	internal def writeWKTRings(out byte[], rings GeoPath[], hasZ bool, hasM bool) {
		out.push(40)
		for let (i, ring) in rings {
			out.push(44, 32) when i > 0
			writeWKTPath(out, ring, hasZ, hasM)
		}
		out.push(41)
	}

	// Whether every non-empty path of the geometry has altitudes, and
	// measures; an empty geometry has neither.
	internal def dimensionsOf(g Geometry) (bool, bool) {
		let anyPath = false
		let hasZ = true
		let hasM = true
		for let p in pathsOf(g) {
			continue when p.len() == 0
			anyPath = true
			hasZ = false unless p.hasZ()
			hasM = false unless p.hasM()
		}
		return (anyPath && hasZ, anyPath && hasM)
	}

	// A cursor over WKT text.
	internal type WKTReader {
		b  byte[]
		at int    = 0

		def new(text string) {
			b = text.bytes()
		}

		def space() {
			for at < b.len() && (b[at] == 32 || b[at] == 9 || b[at] == 10 || b[at] == 13) {
				at++
			}
		}

		// Moves past the byte when it comes next.
		def take(c byte) bool {
			space()
			return false unless at < b.len() && b[at] == c
			at++
			return true
		}

		def peek() int {
			space()
			return at < b.len() ?? (int(b[at]), -1)
		}

		// The next run of letters, upper-cased.
		def word() string {
			space()
			let start = at
			for at < b.len() && ((b[at] >= 65 && b[at] <= 90) || (b[at] >= 97 && b[at] <= 122)) {
				at++
			}
			return string(b[start:at]).upper()
		}

		def wordAhead(w string) bool {
			let save = at
			let found = word() == w
			at = save
			return found
		}

		def number() !float {
			space()
			let start = at
			for at < b.len() && ((b[at] >= 48 && b[at] <= 57) || b[at] == 43 || b[at] == 45 || b[at] == 46 || b[at] == 101 || b[at] == 69) {
				at++
			}
			let text = string(b[start:at])
			fail "geo: expected a number at offset {start}" when text == ""
			let lower = text.lower()
			for let c in lower {
				fail "geo: \"{text}\" is not a number" unless c.isDigit() || c == '.' || c == '-' || c == '+' || c == 'e'
			}
			return parseFloat<float>(text)
		}

		// One geometry: its keyword, dimensions and body.
		def geometry(depth int) !Geometry {
			expects {
				assert depth <= 100 onerror fail "geo: WKT nests deeper than 100 collections"
			}
			let start = at
			let name = word()
			let tag = ""
			for let suffix in ["ZM", "Z", "M"] {
				if name.endsWith(suffix) && wktNames.indexOf(name[:name.len() - suffix.len()]) >= 0 {
					tag = suffix
					name = name[:name.len() - suffix.len()]
					break
				}
			}
			let index = wktNames.indexOf(name)
			fail "geo: \"{name}\" at offset {start} is not a WKT geometry" when index < 0
			if tag == "" {
				let save = at
				let next = word()
				if next := "Z" || "M" || "ZM" {
					tag = next
				} else {
					at = save
				}
			}
			let kind = geometryKinds[index]
			let dims = new WKTDims(tag)
			if wordAhead("EMPTY") {
				word()
				return new Geometry(kind)
			}
			fail "geo: expected '(' at offset {at}" unless take(40)
			let g = new Geometry(kind)
			g.paths = []
			match kind {
				case GeometryKind.Point:
					g.paths.push(try path(dims, 1, 1))
					return g
				case GeometryKind.LineString:
					g.paths.push(try path(dims, 2, -1))
					return g
				case GeometryKind.Polygon:
					g.paths = try rings(dims)
				case GeometryKind.MultiPoint:
					let all = new GeoPath()
					for {
						if wordAhead("EMPTY") {
							word()
						} else if peek() == 40 {
							take(40)
							all.append(try path(dims, 1, 1))
						} else {
							all.append(try position(dims))
						}
						continue when take(44)
						break
					}
					g.paths.push(all)
				case GeometryKind.MultiLineString, GeometryKind.MultiPolygon:
					let single = kind == GeometryKind.MultiLineString ?? (GeometryKind.LineString, GeometryKind.Polygon)
					for {
						let part = new Geometry(single)
						if wordAhead("EMPTY") {
							word()
						} else {
							fail "geo: expected '(' at offset {at}" unless take(40)
							if single == GeometryKind.LineString {
								part.paths = [try path(dims, 2, -1)]
							} else {
								part.paths = try rings(dims)
								fail "geo: expected ')' at offset {at}" unless take(41)
							}
						}
						g.parts.push(part)
						continue when take(44)
						break
					}
				default:
					for {
						g.parts.push(try geometry(depth + 1))
						continue when take(44)
						break
					}
			}
			fail "geo: expected ')' at offset {at}" unless take(41)
			return g
		}

		// Positions up to the closing parenthesis, which it consumes; between
		// minimum and maximum of them (maximum -1 for no limit).
		def path(dims WKTDims, minimum int, maximum int) !GeoPath {
			let p = new GeoPath()
			for {
				p.append(try position(dims))
				continue when take(44)
				break
			}
			fail "geo: expected ')' at offset {at}" unless take(41)
			fail "geo: a geometry at offset {at} has {p.len()} positions, fewer than {minimum}" when p.len() < minimum
			fail "geo: a point at offset {at} has more than one position" when maximum > 0 && p.len() > maximum
			return p
		}

		// Polygon rings up to the closing parenthesis, which it leaves.
		def rings(dims WKTDims) !GeoPath[] {
			let out GeoPath[] = []
			for {
				fail "geo: expected '(' at offset {at}" unless take(40)
				let ring = try path(dims, 4, -1)
				fail "geo: a polygon ring before offset {at} does not end where it starts" unless ring.closedRing()
				out.push(ring)
				continue when take(44)
				break
			}
			return out
		}

		// One position of two to four numbers.
		def position(dims WKTDims) !GeoPath {
			let values float[] = []
			for values.len() < 4 {
				let c = peek()
				break unless (c >= 48 && c <= 57) || c == 45 || c == 43 || c == 46
				values.push(try number())
			}
			fail "geo: a position at offset {at} has {values.len()} numbers" when values.len() < 2
			dims.settle(values.len())
			fail "geo: a position at offset {at} has {values.len()} numbers, not {dims.count()}" when values.len() != dims.count()
			let p = new GeoPath()
			p.push(values[0], values[1])
			let i = 2
			if dims.z {
				p.z.push(values[i])
				i++
			}
			p.m.push(values[i]) when dims.m
			return p
		}
	}

	internal const geometryKinds = [GeometryKind.Point, GeometryKind.LineString, GeometryKind.Polygon, GeometryKind.MultiPoint, GeometryKind.MultiLineString, GeometryKind.MultiPolygon, GeometryKind.GeometryCollection]

	// The dimensions of a WKT geometry's positions: from its keyword, or from
	// the first position when it has none.
	internal type WKTDims {
		z       bool
		m       bool
		settled bool

		def new(tag string) {
			z = tag := "Z" || "ZM"
			m = tag := "M" || "ZM"
			settled = tag != ""
		}

		def settle(count int) {
			return when settled
			settled = true
			z = count >= 3
			m = count >= 4
		}

		def count() int {
			return 2 + (z ?? (1, 0)) + (m ?? (1, 0))
		}
	}
}
