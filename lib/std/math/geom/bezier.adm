partial module std.math.geom {
	use (
		std.math::(*)
		std.math.bezier
	)

	// The point kinds a Bézier curve can run through.
	type Interpolatable = Point | Point3d

	// A quadratic Bézier curve from start to end bent by one control point.
	// `at` and the other evaluators take the parameter t in [0, 1]; `bounds`
	// is the x/y extent, so a 3D curve's depth is not part of it.
	type QuadraticBezier<T: Interpolatable> {
		start   T
		control T
		end     T

		where T is Point {
			// The point on the curve at t.
			def at(t float) T {
				return new Point(bezier.quadratic(start.x, control.x, end.x, t), bezier.quadratic(start.y, control.y, end.y, t))
			}

			// The velocity of the curve at t, as a point holding the vector.
			def derivative(t float) T {
				return new Point(bezier.quadraticDerivative(start.x, control.x, end.x, t), bezier.quadraticDerivative(start.y, control.y, end.y, t))
			}

			// The unit direction of the curve at t; the zero point where the
			// curve stands still.
			def tangent(t float) T {
				return unit(derivative(t))
			}

			// The curve cut at t: the part up to t and the part from t on.
			def split(t float) (QuadraticBezier<T>, QuadraticBezier<T>) {
				let a = start.lerp(control, t)
				let b = control.lerp(end, t)
				let m = a.lerp(b, t)
				return (new QuadraticBezier<T>(start: start, control: a, end: m), new QuadraticBezier<T>(start: m, control: b, end: end))
			}

			// The arc length of the curve: Simpson's rule over the speed.
			def length() float {
				let n = 64
				let h = 1.0 / float(n)
				let total = speed(0.0) + speed(1.0)
				for let i = 1; i < n; i++ {
					let w = 2.0
					w = 4.0 when i % 2 == 1
					total += w * speed(float(i) * h)
				}
				return total * h / 3.0
			}

			// The magnitude of the velocity at t.
			internal def speed(t float) float {
				let d = derivative(t)
				return sqrt(d.x * d.x + d.y * d.y)
			}

			// The smallest rectangle holding the curve.
			def bounds() Rect {
				let r = new Rect(left: start.x.min(end.x), top: start.y.min(end.y), right: start.x.max(end.x), bottom: start.y.max(end.y))
				let tx = quadraticExtremum(start.x, control.x, end.x)
				let ty = quadraticExtremum(start.y, control.y, end.y)
				widen(r, at(tx)) when tx > 0.0 && tx < 1.0
				widen(r, at(ty)) when ty > 0.0 && ty < 1.0
				return r
			}
		}

		where T is Point3d {
			// The point on the curve at t.
			def at(t float) T {
				return new Point3d(bezier.quadratic(start.x, control.x, end.x, t), bezier.quadratic(start.y, control.y, end.y, t), bezier.quadratic(start.z, control.z, end.z, t))
			}

			// The velocity of the curve at t, as a point holding the vector.
			def derivative(t float) T {
				return new Point3d(bezier.quadraticDerivative(start.x, control.x, end.x, t), bezier.quadraticDerivative(start.y, control.y, end.y, t), bezier.quadraticDerivative(start.z, control.z, end.z, t))
			}

			// The unit direction of the curve at t; the zero point where the
			// curve stands still.
			def tangent(t float) T {
				return unit(derivative(t))
			}

			// The curve cut at t: the part up to t and the part from t on.
			def split(t float) (QuadraticBezier<T>, QuadraticBezier<T>) {
				let a = start.lerp(control, t)
				let b = control.lerp(end, t)
				let m = a.lerp(b, t)
				return (new QuadraticBezier<T>(start: start, control: a, end: m), new QuadraticBezier<T>(start: m, control: b, end: end))
			}

			// The arc length of the curve: Simpson's rule over the speed.
			def length() float {
				let n = 64
				let h = 1.0 / float(n)
				let total = speed(0.0) + speed(1.0)
				for let i = 1; i < n; i++ {
					let w = 2.0
					w = 4.0 when i % 2 == 1
					total += w * speed(float(i) * h)
				}
				return total * h / 3.0
			}

			// The magnitude of the velocity at t.
			internal def speed(t float) float {
				let d = derivative(t)
				return sqrt(d.x * d.x + d.y * d.y + d.z * d.z)
			}

			// The smallest rectangle holding the curve's x and y extent.
			def bounds() Rect {
				let r = new Rect(left: start.x.min(end.x), top: start.y.min(end.y), right: start.x.max(end.x), bottom: start.y.max(end.y))
				let tx = quadraticExtremum(start.x, control.x, end.x)
				let ty = quadraticExtremum(start.y, control.y, end.y)
				widen(r, at(tx)) when tx > 0.0 && tx < 1.0
				widen(r, at(ty)) when ty > 0.0 && ty < 1.0
				return r
			}
		}
	}

	// A cubic Bézier curve from start to end bent by two control points.
	// `at` and the other evaluators take the parameter t in [0, 1]; `bounds`
	// is the x/y extent, so a 3D curve's depth is not part of it.
	type CubicBezier<T: Interpolatable> {
		start    T
		control1 T
		control2 T
		end      T

		where T is Point {
			// The point on the curve at t.
			def at(t float) T {
				return new Point(bezier.cubic(start.x, control1.x, control2.x, end.x, t), bezier.cubic(start.y, control1.y, control2.y, end.y, t))
			}

			// The velocity of the curve at t, as a point holding the vector.
			def derivative(t float) T {
				return new Point(bezier.cubicDerivative(start.x, control1.x, control2.x, end.x, t), bezier.cubicDerivative(start.y, control1.y, control2.y, end.y, t))
			}

			// The unit direction of the curve at t; the zero point where the
			// curve stands still.
			def tangent(t float) T {
				return unit(derivative(t))
			}

			// The curve cut at t: the part up to t and the part from t on.
			def split(t float) (CubicBezier<T>, CubicBezier<T>) {
				let a = start.lerp(control1, t)
				let b = control1.lerp(control2, t)
				let c = control2.lerp(end, t)
				let ab = a.lerp(b, t)
				let bc = b.lerp(c, t)
				let m = ab.lerp(bc, t)
				return (new CubicBezier<T>(start: start, control1: a, control2: ab, end: m), new CubicBezier<T>(start: m, control1: bc, control2: c, end: end))
			}

			// The arc length of the curve: Simpson's rule over the speed.
			def length() float {
				let n = 64
				let h = 1.0 / float(n)
				let total = speed(0.0) + speed(1.0)
				for let i = 1; i < n; i++ {
					let w = 2.0
					w = 4.0 when i % 2 == 1
					total += w * speed(float(i) * h)
				}
				return total * h / 3.0
			}

			// The magnitude of the velocity at t.
			internal def speed(t float) float {
				let d = derivative(t)
				return sqrt(d.x * d.x + d.y * d.y)
			}

			// The smallest rectangle holding the curve.
			def bounds() Rect {
				let r = new Rect(left: start.x.min(end.x), top: start.y.min(end.y), right: start.x.max(end.x), bottom: start.y.max(end.y))
				for let t in cubicExtrema(start.x, control1.x, control2.x, end.x) {
					widen(r, at(t))
				}
				for let t in cubicExtrema(start.y, control1.y, control2.y, end.y) {
					widen(r, at(t))
				}
				return r
			}
		}

		where T is Point3d {
			// The point on the curve at t.
			def at(t float) T {
				return new Point3d(bezier.cubic(start.x, control1.x, control2.x, end.x, t), bezier.cubic(start.y, control1.y, control2.y, end.y, t), bezier.cubic(start.z, control1.z, control2.z, end.z, t))
			}

			// The velocity of the curve at t, as a point holding the vector.
			def derivative(t float) T {
				return new Point3d(bezier.cubicDerivative(start.x, control1.x, control2.x, end.x, t), bezier.cubicDerivative(start.y, control1.y, control2.y, end.y, t), bezier.cubicDerivative(start.z, control1.z, control2.z, end.z, t))
			}

			// The unit direction of the curve at t; the zero point where the
			// curve stands still.
			def tangent(t float) T {
				return unit(derivative(t))
			}

			// The curve cut at t: the part up to t and the part from t on.
			def split(t float) (CubicBezier<T>, CubicBezier<T>) {
				let a = start.lerp(control1, t)
				let b = control1.lerp(control2, t)
				let c = control2.lerp(end, t)
				let ab = a.lerp(b, t)
				let bc = b.lerp(c, t)
				let m = ab.lerp(bc, t)
				return (new CubicBezier<T>(start: start, control1: a, control2: ab, end: m), new CubicBezier<T>(start: m, control1: bc, control2: c, end: end))
			}

			// The arc length of the curve: Simpson's rule over the speed.
			def length() float {
				let n = 64
				let h = 1.0 / float(n)
				let total = speed(0.0) + speed(1.0)
				for let i = 1; i < n; i++ {
					let w = 2.0
					w = 4.0 when i % 2 == 1
					total += w * speed(float(i) * h)
				}
				return total * h / 3.0
			}

			// The magnitude of the velocity at t.
			internal def speed(t float) float {
				let d = derivative(t)
				return sqrt(d.x * d.x + d.y * d.y + d.z * d.z)
			}

			// The smallest rectangle holding the curve's x and y extent.
			def bounds() Rect {
				let r = new Rect(left: start.x.min(end.x), top: start.y.min(end.y), right: start.x.max(end.x), bottom: start.y.max(end.y))
				for let t in cubicExtrema(start.x, control1.x, control2.x, end.x) {
					widen(r, at(t))
				}
				for let t in cubicExtrema(start.y, control1.y, control2.y, end.y) {
					widen(r, at(t))
				}
				return r
			}
		}
	}

	// A point on a Bézier path with the handles that shape the curve into
	// and out of it.
	struct BezierAnchor<T> {
		point     T
		handleIn  Vector
		handleOut Vector
	}

	// A chain of anchors describing a piecewise cubic Bézier path.
	struct BezierPath<T> {
		anchors BezierAnchor<T>[]
	}

	// The vector of unit length in v's direction, or v itself when it is zero.
	internal def unit(v Point) Point {
		let len = sqrt(v.x * v.x + v.y * v.y)
		return v when len == 0.0
		return new Point(v.x / len, v.y / len)
	}

	internal def unit(v Point3d) Point3d {
		let len = sqrt(v.x * v.x + v.y * v.y + v.z * v.z)
		return v when len == 0.0
		return new Point3d(v.x / len, v.y / len, v.z / len)
	}

	// Grows r to include p.
	internal def widen(r Rect, p Point) {
		r.left = r.left.min(p.x)
		r.top = r.top.min(p.y)
		r.right = r.right.max(p.x)
		r.bottom = r.bottom.max(p.y)
	}

	internal def widen(r Rect, p Point3d) {
		r.left = r.left.min(p.x)
		r.top = r.top.min(p.y)
		r.right = r.right.max(p.x)
		r.bottom = r.bottom.max(p.y)
	}

	// The parameter where a quadratic axis turns, or -1 when it never does.
	internal def quadraticExtremum(p0, p1, p2 float) float {
		let denom = p0 - 2.0 * p1 + p2
		return -1.0 when denom == 0.0
		return (p0 - p1) / denom
	}

	// The parameters strictly inside (0, 1) where a cubic axis turns.
	internal def cubicExtrema(p0, p1, p2, p3 float) float[] {
		let out = float[]
		// Derivative coefficients: a t² + b t + c.
		let a = -p0 + 3.0 * p1 - 3.0 * p2 + p3
		let b = 2.0 * (p0 - 2.0 * p1 + p2)
		let c = p1 - p0
		if a.abs() < 1e-12 {
			if b.abs() >= 1e-12 {
				let t = -c / b
				out.push(t) when t > 0.0 && t < 1.0
			}
			return out
		}
		let disc = b * b - 4.0 * a * c
		return out when disc < 0.0
		let root = sqrt(disc)
		let t1 = (-b + root) / (2.0 * a)
		let t2 = (-b - root) / (2.0 * a)
		out.push(t1) when t1 > 0.0 && t1 < 1.0
		out.push(t2) when t2 > 0.0 && t2 < 1.0
		return out
	}
}
