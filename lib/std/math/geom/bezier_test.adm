partial module std.math.geom {
	use (
		std.testing
		std.math
	)

	check "Bezier curves" {
		internal def near(p Point, x, y float) bool {
			return math.approx(p.x, x, 1e-9) && math.approx(p.y, y, 1e-9)
		}

		internal def near3(p Point3d, x, y, z float) bool {
			return math.approx(p.x, x, 1e-9) && math.approx(p.y, y, 1e-9) && math.approx(p.z, z, 1e-9)
		}

		internal def arch() QuadraticBezier<Point> {
			return new QuadraticBezier<Point>(start: new Point(0.0, 0.0), control: new Point(1.0, 2.0), end: new Point(2.0, 0.0))
		}

		internal def wave() CubicBezier<Point> {
			return new CubicBezier<Point>(start: new Point(0.0, 0.0), control1: new Point(1.0, 3.0), control2: new Point(2.0, -3.0), end: new Point(3.0, 0.0))
		}

		@test()
		def quadraticPoints() {
			let q = arch()
			assert near(q.at(0.0), 0.0, 0.0)
			assert near(q.at(1.0), 2.0, 0.0)
			assert near(q.at(0.5), 1.0, 1.0)
			assert near(q.derivative(0.5), 2.0, 0.0)
			assert near(q.tangent(0.5), 1.0, 0.0)
			assert near(q.tangent(0.0), 1.0 / math.sqrt(5.0), 2.0 / math.sqrt(5.0))
		}

		@test()
		def quadraticSplit() {
			let (a, b) = arch().split(0.5)
			assert near(a.start, 0.0, 0.0)
			assert near(a.control, 0.5, 1.0)
			assert near(a.end, 1.0, 1.0)
			assert near(b.start, 1.0, 1.0)
			assert near(b.control, 1.5, 1.0)
			assert near(b.end, 2.0, 0.0)
			// Both halves trace the original.
			assert near(a.at(0.5), arch().at(0.25).x, arch().at(0.25).y)
			assert near(b.at(0.5), arch().at(0.75).x, arch().at(0.75).y)
		}

		@test()
		def quadraticLengthAndBounds() {
			let straight = new QuadraticBezier<Point>(start: new Point(0.0, 0.0), control: new Point(1.5, 2.0), end: new Point(3.0, 4.0))
			assert math.approx(straight.length(), 5.0, 1e-9)
			let arc = arch().length()
			assert arc > 2.0 && arc < 4.0
			let r = arch().bounds()
			assert math.approx(r.left, 0.0, 1e-9) && math.approx(r.right, 2.0, 1e-9)
			assert math.approx(r.top, 0.0, 1e-9) && math.approx(r.bottom, 1.0, 1e-9)
		}

		@test()
		def cubicPoints() {
			let c = wave()
			assert near(c.at(0.0), 0.0, 0.0)
			assert near(c.at(1.0), 3.0, 0.0)
			assert near(c.at(0.5), 1.5, 0.0)
			// Symmetric wave: horizontal at the middle, heading down.
			let d = c.derivative(0.5)
			assert math.approx(d.x, 3.0, 1e-9) && math.approx(d.y, -4.5, 1e-9)
			let speed = math.sqrt(3.0 * 3.0 + 4.5 * 4.5)
			assert near(c.tangent(0.5), 3.0 / speed, -4.5 / speed)
		}

		@test()
		def cubicSplitLengthBounds() {
			let c = wave()
			let (a, b) = c.split(0.25)
			assert near(a.start, 0.0, 0.0)
			assert near(b.end, 3.0, 0.0)
			assert near(a.end, c.at(0.25).x, c.at(0.25).y)
			assert near(b.start, c.at(0.25).x, c.at(0.25).y)
			assert near(a.at(0.4), c.at(0.1).x, c.at(0.1).y)
			assert near(b.at(0.4), c.at(0.55).x, c.at(0.55).y)
			assert math.approx(a.length() + b.length(), c.length(), 1e-5)
			let line = new CubicBezier<Point>(start: new Point(0.0, 0.0), control1: new Point(1.0, 1.0), control2: new Point(2.0, 2.0), end: new Point(3.0, 3.0))
			assert math.approx(line.length(), 3.0 * math.sqrt(2.0), 1e-9)
			let r = c.bounds()
			assert math.approx(r.left, 0.0, 1e-9) && math.approx(r.right, 3.0, 1e-9)
			// y(t) = 9t(1-t)(1-2t) peaks at ±√3/2.
			assert math.approx(r.bottom, -r.top, 1e-9)
			assert math.approx(r.top, -math.sqrt(3.0) / 2.0, 1e-9)
		}

		@test()
		def threeDimensions() {
			let q = new QuadraticBezier<Point3d>(start: new Point3d(0.0, 0.0, 0.0), control: new Point3d(1.0, 2.0, 4.0), end: new Point3d(2.0, 0.0, 0.0))
			assert near3(q.at(0.5), 1.0, 1.0, 2.0)
			let (a, b) = q.split(0.5)
			assert near3(a.end, 1.0, 1.0, 2.0) && near3(b.control, 1.5, 1.0, 2.0)
			assert near3(q.tangent(0.5), 1.0, 0.0, 0.0)
			let r = q.bounds()
			assert math.approx(r.bottom, 1.0, 1e-9) && math.approx(r.right, 2.0, 1e-9)
			let c = new CubicBezier<Point3d>(start: new Point3d(0.0, 0.0, 0.0), control1: new Point3d(0.0, 0.0, 1.0), control2: new Point3d(0.0, 0.0, 2.0), end: new Point3d(0.0, 0.0, 3.0))
			assert math.approx(c.length(), 3.0, 1e-9)
			assert near3(c.derivative(0.5), 0.0, 0.0, 3.0)
		}
	}
}
