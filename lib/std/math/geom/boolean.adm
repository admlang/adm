internal partial module std.math.geom.boolean {
	use (
		std.math::(atan2, sqrt)
		std.math.geom::(Path, PathVerb)
	)

	// Which region a boolean operation keeps.
	enum BooleanOp {
		Union,
		Intersect,
		Subtract,
		Xor,
	}

	// One straight piece of either path: from (x0, y0) to (x1, y1); `owner`
	// 0 for the first path, 1 for the second.
	struct Segment {
		x0, y0, x1, y1 float
		owner          int
	}

	// An edge of the arrangement, between two snapped vertices `a` < `b`,
	// with each path's signed count of its own pieces along it from a to b.
	struct Edge {
		a, b   int
		countA int
		countB int
	}

	// The region `op` keeps from two paths, both filled non-zero, as closed
	// polylines (curves flattened within `flatness`) that fill the same
	// under either rule: contours never cross, holes run the other way.
	def combine(first Path, second Path, op BooleanOp) Path {
		// Each path flattened by its own size, so a shape comes out the
		// same whatever it is combined with.
		let ta = flatness(first)
		let tb = flatness(second)
		let segs Segment[]
		addSegments(segs, first.flattened(ta), 0)
		addSegments(segs, second.flattened(tb), 1)
		let out = new Path()
		return out when segs.len() == 0
		// Points closer than `snap` are one vertex.
		let snap = ta.min(tb) * 1e-3
		let splits = splitPoints(segs, snap)
		// Vertices by snapped position, and the arrangement's edges.
		let vx float[]
		let vy float[]
		let vertexOf map<string, int>
		let edges Edge[]
		let edgeOf map<string, int>
		for let (si, s) in segs {
			let ts = splits[si]
			ts.push(0.0)
			ts.push(1.0)
			ts.sort((p float, q float) => p < q)
			let prev = -1
			for let (_, t) in ts {
				let x = s.x0 + (s.x1 - s.x0) * t
				let y = s.y0 + (s.y1 - s.y0) * t
				let key = "{(x / snap).round()},{(y / snap).round()}"
				if !vertexOf.hasKey(key) {
					vertexOf[key] = vx.len()
					vx.push((x / snap).round() * snap)
					vy.push((y / snap).round() * snap)
				}
				let v = vertexOf[key]
				if prev >= 0 && v != prev {
					let (a, b) = (prev.min(v), prev.max(v))
					let dir = prev < v ?? (1, -1)
					let ekey = "{a},{b}"
					if !edgeOf.hasKey(ekey) {
						edgeOf[ekey] = edges.len()
						edges.push(Edge{a: a, b: b, countA: 0, countB: 0})
					}
					let e = edges[edgeOf[ekey]]
					if s.owner == 0 {
						e.countA += dir
					} else {
						e.countB += dir
					}
				}
				prev = v
			}
		}
		// Each edge kept where the result differs on its two sides, turned
		// so the result lies on its left (the side of (-dy, dx)).
		let index = new BandIndex(segs)
		let from int[]
		let to int[]
		for let (_, e) in edges {
			continue when e.countA == 0 && e.countB == 0
			let (ax, ay, bx, by) = (vx[e.a], vy[e.a], vx[e.b], vy[e.b])
			let len = sqrt((bx - ax) * (bx - ax) + (by - ay) * (by - ay))
			continue when len == 0.0
			let off = (snap * 50.0).min(len * 0.25)
			let mx = (ax + bx) / 2.0 - (by - ay) / len * off
			let my = (ay + by) / 2.0 + (bx - ax) / len * off
			let (wa, wb) = index.windings(mx, my)
			// Across the edge to the other side, each path's winding moves
			// by its count along the edge.
			let left = keeps(op, wa != 0, wb != 0)
			let right = keeps(op, wa - e.countA != 0, wb - e.countB != 0)
			continue when left == right
			if left {
				from.push(e.a)
				to.push(e.b)
			} else {
				from.push(e.b)
				to.push(e.a)
			}
		}
		// Contours: from each unused edge, at every vertex take the outgoing
		// edge that turns furthest left, until the start comes back.
		let outgoing int[][]
		for let i = 0; i < vx.len(); i++ {
			outgoing.push(int[])
		}
		for let (k, f) in from {
			outgoing[f].push(k)
		}
		let used bool[]
		used.len(from.len())
		used.fill(false)
		for let start = 0; start < from.len(); start++ {
			continue when used[start]
			let loop int[]
			let k = start
			for !used[k] {
				used[k] = true
				loop.push(from[k])
				let at = to[k]
				let (dx, dy) = (vx[at] - vx[from[k]], vy[at] - vy[from[k]])
				let next = -1
				let best = -10.0
				for let (_, c) in outgoing[at] {
					continue when used[c]
					let (ex, ey) = (vx[to[c]] - vx[at], vy[to[c]] - vy[at])
					let turn = atan2(dx * ey - dy * ex, dx * ex + dy * ey)
					if turn > best {
						best = turn
						next = c
					}
				}
				break when next < 0
				k = next
			}
			continue when loop.len() < 3
			out.moveTo(vx[loop[0]], vy[loop[0]])
			for let i = 1; i < loop.len(); i++ {
				out.lineTo(vx[loop[i]], vy[loop[i]])
			}
			out.close()
		}
		return out
	}

	// How far a path's flattened curves may stray: 1/10000 of its size,
	// at most 0.05.
	internal def flatness(p Path) float {
		let b = p.bounds()
		return ((b.right - b.left).max(b.bottom - b.top) * 1e-4).clamp(1e-6, 0.05)
	}

	internal def keeps(op BooleanOp, a bool, b bool) bool {
		match op {
			case BooleanOp.Union:
				return a || b
			case BooleanOp.Intersect:
				return a && b
			case BooleanOp.Subtract:
				return a && !b
			case BooleanOp.Xor:
				return a != b
		}
		return false
	}

	// The flattened path's lines, every subpath closed as a fill closes it.
	internal def addSegments(segs Segment[], flat Path, owner int) {
		let pts = flat.coords
		let j = 0
		let (sx, sy, px, py) = (0.0, 0.0, 0.0, 0.0)
		let open = false
		for let (_, v) in flat.verbs {
			match v {
				case PathVerb.Move:
					addSegment(segs, px, py, sx, sy, owner) when open
					sx = pts[j]
					sy = pts[j + 1]
					px = sx
					py = sy
					j += 2
					open = true
				case PathVerb.Line:
					addSegment(segs, px, py, pts[j], pts[j + 1], owner)
					px = pts[j]
					py = pts[j + 1]
					j += 2
				case PathVerb.Close:
					addSegment(segs, px, py, sx, sy, owner)
					px = sx
					py = sy
					open = false
				default:
					j += 2
			}
		}
		addSegment(segs, px, py, sx, sy, owner) when open
	}

	internal def addSegment(segs Segment[], x0, y0, x1, y1 float, owner int) {
		return when x0 == x1 && y0 == y1
		segs.push(Segment{x0: x0, y0: y0, x1: x1, y1: y1, owner: owner})
	}

	// Where each segment must split (parameters 0..1): its crossings with
	// every other segment, and the ends of collinear segments lying on it.
	// Segments are swept in order of their left end.
	internal def splitPoints(segs Segment[], snap float) float[][] {
		let n = segs.len()
		let out float[][]
		let order int[]
		for let i = 0; i < n; i++ {
			out.push(float[])
			order.push(i)
		}
		order.sort((a int, b int) => segs[a].x0.min(segs[a].x1) < segs[b].x0.min(segs[b].x1))
		for let oi = 0; oi < n; oi++ {
			let i = order[oi]
			let s = segs[i]
			let sMaxX = s.x0.max(s.x1) + snap
			let (sMinY, sMaxY) = (s.y0.min(s.y1) - snap, s.y0.max(s.y1) + snap)
			for let oj = oi + 1; oj < n; oj++ {
				let j = order[oj]
				let t = segs[j]
				break when t.x0.min(t.x1) > sMaxX
				continue when t.y0.max(t.y1) < sMinY || t.y0.min(t.y1) > sMaxY
				crossings(s, t, out[i], out[j], snap)
			}
		}
		return out
	}

	// Adds the parameters where segments s and t meet to `ps` and `pt`.
	internal def crossings(s Segment, t Segment, ps float[], pt float[], snap float) {
		let (dx, dy) = (s.x1 - s.x0, s.y1 - s.y0)
		let (ex, ey) = (t.x1 - t.x0, t.y1 - t.y0)
		let denom = dx * ey - dy * ex
		let ls = sqrt(dx * dx + dy * dy)
		let lt = sqrt(ex * ex + ey * ey)
		let (qx, qy) = (t.x0 - s.x0, t.y0 - s.y0)
		if denom.abs() <= 1e-12 * ls * lt {
			// Parallel: collinear when t's start lies on s's line.
			return when (qx * dy - qy * dx).abs() > snap * ls
			// Each one's ends inside the other.
			addOn(ps, s.x0, s.y0, dx, dy, ls, t.x0, t.y0, snap)
			addOn(ps, s.x0, s.y0, dx, dy, ls, t.x1, t.y1, snap)
			addOn(pt, t.x0, t.y0, ex, ey, lt, s.x0, s.y0, snap)
			addOn(pt, t.x0, t.y0, ex, ey, lt, s.x1, s.y1, snap)
			return
		}
		let u = (qx * ey - qy * ex) / denom
		let v = (qx * dy - qy * dx) / denom
		let es = snap / ls
		let et = snap / lt
		return when u < -es || u > 1.0 + es || v < -et || v > 1.0 + et
		ps.push(u.clamp(0.0, 1.0)) when u > es && u < 1.0 - es
		pt.push(v.clamp(0.0, 1.0)) when v > et && v < 1.0 - et
		// A crossing at one's end inside the other splits only the other;
		// the end itself is already a vertex.
	}

	// Adds the parameter of point (px, py) along the segment from (x, y)
	// by (dx, dy) when it lies strictly inside it.
	internal def addOn(ps float[], x, y, dx, dy, len, px, py, snap float) {
		let t = ((px - x) * dx + (py - y) * dy) / (len * len)
		let e = snap / len
		ps.push(t) when t > e && t < 1.0 - e
	}

	// The segments filed by horizontal bands, to count windings along a ray
	// without walking every segment.
	type BandIndex {
		segs   Segment[]
		bands  int[][]
		top    float
		height float

		def new(segs Segment[]) {
			self.segs = segs
			let lo = 1e300
			let hi = -1e300
			for let (_, s) in segs {
				lo = lo.min(s.y0.min(s.y1))
				hi = hi.max(s.y0.max(s.y1))
			}
			let count = (segs.len() / 8).clamp(1, 4096)
			top = lo
			height = ((hi - lo) / float(count)).max(1e-12)
			for let b = 0; b < count; b++ {
				bands.push(int[])
			}
			for let (i, s) in segs {
				let b0 = band(s.y0.min(s.y1))
				let b1 = band(s.y0.max(s.y1))
				for let b = b0; b <= b1; b++ {
					bands[b].push(i)
				}
			}
		}

		def band(y float) int {
			return int(((y - top) / height).floor()).clamp(0, bands.len() - 1)
		}

		// Each path's non-zero winding number at (x, y): the signed count of
		// its segments crossing the ray towards +x.
		def windings(x float, y float) (int, int) {
			let wa = 0
			let wb = 0
			for let (_, i) in bands[band(y)] {
				let s = segs[i]
				let up = s.y0 <= y && y < s.y1
				let down = s.y1 <= y && y < s.y0
				continue unless up || down
				let cx = s.x0 + (y - s.y0) * (s.x1 - s.x0) / (s.y1 - s.y0)
				continue when cx <= x
				let d = up ?? (1, -1)
				if s.owner == 0 {
					wa += d
				} else {
					wb += d
				}
			}
			return (wa, wb)
		}
	}
}
