partial module std.math.geom {
	use (
		std.testing
		std.math::(Pi, cos, sin)
		std.units::Pixels
	)

	check "Path booleans" {
		def square(x float, y float, size float) Path {
			return new Path().rect(Rect{left: x, top: y, right: x + size, bottom: y + size})
		}

		// The area a polyline path fills: the signed areas of its contours
		// added (holes run the other way), as a positive number.
		def area(p Path) float {
			let sum = 0.0
			let pts = p.coords
			let j = 0
			let (sx, sy, px, py) = (0.0, 0.0, 0.0, 0.0)
			for let (_, v) in p.verbs {
				match v {
					case PathVerb.Move:
						sx = pts[j]
						sy = pts[j + 1]
						px = sx
						py = sy
						j += 2
					case PathVerb.Line:
						sum += px * pts[j + 1] - pts[j] * py
						px = pts[j]
						py = pts[j + 1]
						j += 2
					case PathVerb.Close:
						sum += px * sy - sx * py
						px = sx
						py = sy
					default:
						j += 2
				}
			}
			return (sum / 2.0).abs()
		}

		def contours(p Path) int {
			let n = 0
			for let (_, v) in p.verbs {
				n++ when v == PathVerb.Move
			}
			return n
		}

		// Both fill rules agree everywhere on a grid over the box: the
		// contours never cross and holes run the other way.
		def rulesAgree(p Path, l float, t float, r float, b float) bool {
			for let y = t; y <= b; y += (b - t) / 37.0 {
				for let x = l; x <= r; x += (r - l) / 41.0 {
					let q = new Point(x + 0.013, y + 0.007)
					return false when p.contains(q) != p.contains(q, FillRule.EvenOdd)
				}
			}
			return true
		}

		// The next pseudo-random number in 0..1 from the state.
		def next(seed int[]) float {
			seed[0] = (seed[0] * 1103515245 + 12345) % 2147483648
			return float(seed[0] % 10000) / 10000.0
		}

		// A random circle, square or rounded rectangle.
		def shape(seed int[], k int) Path {
			let x = next(seed) * 40.0
			let y = next(seed) * 40.0
			let r = 5.0 + next(seed) * 20.0
			return new Path().circle(new Point(x, y), r) when k % 3 == 0
			return square(x, y, r) when k % 3 == 1
			return new Path().roundRect(Rect{left: x, top: y, right: x + r * 1.5, bottom: y + r}, 4(px))
		}

		def near(a float, b float, tol float = 1e-6) bool {
			return (a - b).abs() <= tol
		}

		@test()
		def overlappingSquares() {
			let a = square(0.0, 0.0, 10.0)
			let b = square(5.0, 0.0, 10.0)
			let u = a.unite(b)
			assert near(area(u), 150.0) && contours(u) == 1
			assert near(area(a.intersect(b)), 50.0) && near(area(a.subtract(b)), 50.0) && near(area(b.subtract(a)), 50.0)
			let x = a.xor(b)
			assert near(area(x), 100.0) && contours(x) == 2
			assert u.contains(new Point(12.0, 5.0)) && !a.intersect(b).contains(new Point(2.0, 5.0))
			assert rulesAgree(x, -1.0, -1.0, 16.0, 11.0)
		}

		@test()
		def operatorsAreTheMethods() {
			let a = square(0.0, 0.0, 10.0)
			let b = square(5.0, 0.0, 10.0)
			assert near(area(a | b), 150.0) && near(area(a & b), 50.0) && near(area(a - b), 50.0) && near(area(a ^ b), 100.0)
			// They chain: the middle strip cut out of the union.
			assert near(area((a | b) - (a & b)), 100.0)
		}

		@test()
		def touchingAndDisjointShapes() {
			// Side by side: the shared edge goes, one contour remains.
			let side = square(0.0, 0.0, 10.0).unite(square(10.0, 0.0, 10.0))
			assert near(area(side), 200.0) && contours(side) == 1
			// Apart: two contours; nothing in common.
			let a = square(0.0, 0.0, 4.0)
			let b = square(10.0, 10.0, 4.0)
			let both = a.unite(b)
			assert near(area(both), 32.0) && contours(both) == 2
			assert a.intersect(b).verbs.len() == 0
			// The same shape twice.
			assert near(area(a.unite(a)), 16.0) && a.xor(a).verbs.len() == 0 && a.subtract(a).verbs.len() == 0
		}

		@test()
		def ringFromTwoCircles() {
			let outer = new Path().circle(new Point(0.0, 0.0), 10.0)
			let inner = new Path().circle(new Point(0.0, 0.0), 6.0)
			let ring = outer.subtract(inner)
			// Within the flattening of the circles.
			assert (area(ring) - Pi * (100.0 - 36.0)).abs() < 0.05
			assert contours(ring) == 2 && !ring.contains(new Point(0.0, 0.0)) && ring.contains(new Point(8.0, 0.0))
			assert rulesAgree(ring, -11.0, -11.0, 11.0, 11.0)
			// A hole that cuts the edge: a crescent.
			let bite = outer.subtract(new Path().circle(new Point(8.0, 0.0), 6.0))
			assert contours(bite) == 1 && !bite.contains(new Point(9.0, 0.0)) && bite.contains(new Point(-9.0, 0.0))
			assert rulesAgree(bite, -11.0, -11.0, 15.0, 11.0)
		}

		@test()
		def areasAddUpOnRandomShapes() {
			// Overlapping circles, rectangles and rounded rectangles: the
			// areas of the four operations agree with each other.
			let seed = [7]
			for let round = 0; round < 12; round++ {
				let a = shape(seed, round).unite(shape(seed, round + 1))
				let b = shape(seed, round + 2)
				let (u, i, d, x) = (area(a.unite(b)), area(a.intersect(b)), area(a.subtract(b)), area(a.xor(b)))
				// Areas of polylines: b's curves flattened as the operations
				// flatten them.
				let (aa, bb) = (area(a), area(b.unite(new Path())))
				assert (u - (aa + bb - i)).abs() < 1e-6 * u.max(1.0) + 1e-6
				assert (x - (u - i)).abs() < 1e-6 * u.max(1.0) + 1e-6
				assert (d - (aa - i)).abs() < 1e-6 * u.max(1.0) + 1e-6
				assert rulesAgree(a.xor(b), -30.0, -30.0, 100.0, 100.0)
			}
		}

		@test()
		def selfCrossingPathsAreReadNonZero() {
			// A five-pointed star in one stroke winds its middle twice:
			// non-zero fills it, and the result keeps it filled with a plain
			// outline (ten corners, no crossing).
			let star = new Path()
			for let i = 0; i < 5; i++ {
				let a = -Pi / 2.0 + float(i) * 4.0 * Pi / 5.0
				if i == 0 {
					star.moveTo(10.0 * cos(a), 10.0 * sin(a))
				} else {
					star.lineTo(10.0 * cos(a), 10.0 * sin(a))
				}
			}
			star.close()
			let solid = star.unite(new Path())
			assert contours(solid) == 1 && solid.contains(new Point(0.0, 0.0)) && solid.verbs.len() == 11 && (area(solid) - 112.257).abs() < 0.01
			assert rulesAgree(solid, -11.0, -11.0, 11.0, 11.0)
		}
	}
}
