partial module std.math.geom {
	use (
		std.testing
		std.math
	)

	check "Circle" {
		@test()
		def area() {
			let c = new Circle(new Point(0, 0), 5)
			assert math.approx(c.area(), 78.539816, 1e-6)
			c.radius = 0
			assert c.area() == 0.0
			c.radius = 1
			assert c.area() == math.π
			// fractional radius
			let r = 2.5
			c.radius = r
			assert c.area() == math.π * r * r
		}

		@test()
		def circumference() {
			let c = new Circle(new Point(0, 0), 5)
			assert math.approx(c.circumference(), 31.415927, 1e-6)
			c.radius = 0
			assert c.circumference() == 0.0
			let r = 2.5
			c.radius = r
			assert c.circumference() == 2 * math.π * r
		}

		@test()
		def diameter() {
			let c = new Circle(new Point(0, 0), 5)
			assert c.diameter() == 10.0
		}

		@test()
		def contains_points() {
			let c = new Circle(new Point(0, 0), 5)
			// Inside
			assert c.contains(new Point(0, 0)) == true
			// On boundary (3-4-5 triangle)
			assert c.contains(new Point(3, 4)) == true
			// Outside
			assert c.contains(new Point(6, 0)) == false

			c.center = new Point(2, 3)
			c.radius = 0
			// Only the center is contained
			assert c.contains(new Point(2, 3)) == true
			assert c.contains(new Point(2, 4)) == false
			assert c.contains(new Point(3, 3)) == false
		}

		@test()
		def contains_circle() {
			let outer = new Circle(new Point(0, 0), 5)
			// Strictly inside
			let inner = new Circle(new Point(0, 0), 3)
			assert outer.contains(inner) == true

			// On boundary: d + r_inner == r_outer (inclusive)
			let boundary = new Circle(new Point(3, 4), 0) // distance 5 to center
			assert outer.contains(boundary) == true

			// Partially overlapping, not fully contained
			let overlap = new Circle(new Point(3, 0), 3)
			assert outer.contains(overlap) == false

			// Entirely outside
			let outside = new Circle(new Point(20, 0), 1)
			assert outer.contains(outside) == false
		}

		@test()
		def intersects_circle() {
			let a = new Circle(new Point(0, 0), 5)

			// Overlapping circles -> true
			let b = new Circle(new Point(6, 0), 3) // centers dist=6, r_sum=8
			assert a.intersects(b) == true

			// Tangent circles -> false (uses strict < in implementation)
			let c = new Circle(new Point(10, 0), 5) // dist=10, r_sum=10
			assert a.intersects(c) == false

			// Disjoint circles -> false
			let d = new Circle(new Point(20, 0), 2) // dist=20, r_sum=7
			assert a.intersects(d) == false
		}

		@test()
		def distance_to_point() {
			let c = new Circle(new Point(0, 0), 5)
			// Outside
			assert c.distanceTo(new Point(12, 0)) == 7.0
			// On boundary
			assert c.distanceTo(new Point(3, 4)) == 0.0
			// Inside (clamped to 0)
			assert c.distanceTo(new Point(1, 1)) == 0.0
		}

		@test()
		def distance_to_circle() {
			let a = new Circle(new Point(0, 0), 5)

			// Disjoint: positive distance
			let b = new Circle(new Point(20, 0), 2) // dist=20, r_sum=7
			assert math.approx(a.distanceTo(b), 13.0, 1e-3)

			// Tangent: 0
			let c = new Circle(new Point(10, 0), 5) // dist=10, r_sum=10
			assert a.distanceTo(c) == 0.0

			// Overlapping: 0
			let d = new Circle(new Point(6, 0), 3) // dist=6, r_sum=8
			assert a.distanceTo(d) == 0.0
		}

		@test()
		def intersects_rectangle() {
			let circle = new Circle(new Point(0, 0), 5)

			// Rectangle fully containing the center -> true
			let big = new Rectangle(position = new Point(-10, -10), size = new Size(20, 20))
			assert circle.intersects(big) == true

			// Tangent rectangle: left edge at x=5 touching the circle at (5,0)
			let tangent = new Rectangle(position = new Point(5, -1), size = new Size(2, 2))
			assert circle.intersects(tangent) == true

			// Disjoint rectangle far away -> false
			let far = new Rectangle(position = new Point(20, 20), size = new Size(3, 4))
			assert circle.intersects(far) == false
		}

		@test()
		def bounding_box() {
			let c = new Circle(new Point(2, 3), 4)
			let r = c.boundingBox()
			assert r.position.x == -2.0
			assert r.position.y == -1.0
			assert r.size.width == 8.0
			assert r.size.height == 8.0
		}

		@test()
		def line_intersections() {
			let c = new Circle(new Point(0, 0), 5)
			// Secant: horizontal through center -> two points (-5,0) and (5,0)
			let sec = new Line(new Point(-10, 0), new Point(10, 0))
			let ps = c.intersection(sec)

			let d_vec = sec.start.vectorTo(sec.end)
			let f_vec = c.center.vectorTo(sec.start)

			assert ps.len() == 2
			// Order should be left then right for this setup
			assert ps[0].x == -5.0
			assert ps[0].y == 0.0
			assert ps[1].x == 5.0
			assert ps[1].y == 0.0
			assert c.intersects(sec) == true

			// Tangent: vertical at x=5 -> one point (5,0)
			let tan = new Line(new Point(5, -10), new Point(5, 10))
			let tp = c.intersection(tan)
			assert tp.len() == 1
			assert tp[0].x == 5.0
			assert tp[0].y == 0.0
			assert c.intersects(tan) == true

			// Miss: vertical at x=6 -> no intersection
			let miss = new Line(new Point(6, -1), new Point(6, 1))
			assert c.intersection(miss).len() == 0
			assert c.intersects(miss) == false
		}

		@test()
		def translate_and_scale() {
			// translate
			let c1 = new Circle(new Point(1, 2), 3)
			let c2 = c1.translate(5, -2)
			// Mutating + returns self
			assert c1.center.x == 6.0
			assert c1.center.y == 0.0
			assert c2.center.x == 6.0
			assert c2.center.y == 0.0

			// scale
			c1.scale(2)
			assert c1.radius == 6.0
			// scaling to zero
			c1.scale(0)
			assert c1.radius == 0.0
			assert c1.area() == 0.0
			assert c1.isValid() == true

			// negative scaling yields negative radius (invalid)
			let c3 = new Circle(new Point(0, 0), 2)
			c3.scale(-1)
			assert c3.radius == -2.0
			assert c3.isValid() == false
		}
	}
}
