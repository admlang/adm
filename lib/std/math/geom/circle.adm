partial module std.math.geom {
	use std.math::(*)

	type Circle<T: Numeric = float> {
		center Point<T>
		radius T

		def new(center Point<T>, radius T) {
			self.center = center
			self.radius = radius
		}

        def new(x, y T, radius T) {
			self.center = new Point<T>(x, y)
			self.radius = radius
		}

		def isValid() bool {
			return radius >= 0
		}

		// The same circle with `float` coordinates.
		def toFloat() Circle<float> {
			return new Circle<float>(center.toFloat(), float(radius))
		}

		def area() float {
			return π * float(radius) * float(radius)
		}

		def circumference() float {
			return 2 * π * float(radius)
		}

		def diameter() T {
			return radius * 2
		}

		def contains(point Point<T>) bool {
			return center.distanceSquared(point) <= radius * radius
		}

		def contains(circle Circle<T>) bool {
			let d = center.distanceTo(circle.center)
			return d + float(circle.radius) <= float(radius)
		}

		def intersects(circle Circle<T>) bool {
			let r = radius + circle.radius
			return center.distanceSquared(circle.center) < r * r
		}

		def distanceTo(point Point<T>) float {
			let d = center.distanceTo(point) - float(radius)
			return 0 when d < 0
			return d
		}

		def distanceTo(circle Circle<T>) float {
			let d = center.distanceTo(circle.center) - float(radius + circle.radius)
			return 0 when d < 0
			return d
		}

		def intersects(rect Rectangle<T>) bool {
			let closest = center.clampTo(rect)
			return center.distanceSquared(closest) <= radius * radius
		}

		def boundingBox() Rectangle<T> {
			return new Rectangle<T>(
				position = new Point<T>(center.x - radius, center.y - radius),
				size     = new Size<T>(radius * 2, radius * 2)
			)
		}

		def intersects(line Line<T>) bool {
			return intersection(line).len() > 0
		}

		// Where the segment crosses the circle; fractional for any `T`.
		def intersection(line Line<T>) Point<float>[] {
			let s = line.start.toFloat()
			let e = line.end.toFloat()
			let c = center.toFloat()
			let r = float(radius)

			// Parametric line: P = start + t * d
			let d = s.vectorTo(e)
			// Vector from center to line start
			let f = s.vectorTo(c).neg()

			let a = d.dot(d)
			let b = 2 * f.dot(d)
			let cc = f.dot(f) - (r * r)

			let disc = (b * b) - (4 * a * cc)
			return Point<float>[] when disc < 0

			let sqrtDisc = sqrt(disc)

			let t1 = (-b - sqrtDisc) / (2 * a)
			let t2 = (-b + sqrtDisc) / (2 * a)

			let points Point<float>[]
			points.cap(2)

			if t1 >= 0 && t1 <= 1 {
				let p1 = s.translate(d.x * t1, d.y * t1)
				points.push(p1)
			}

			if t2 >= 0 && t2 <= 1 && t2 != t1 {
				let p2 = s.translate(d.x * t2, d.y * t2)
				points.push(p2)
			}

			return points
		}

		def translate(dx, dy T) Circle<T> {
			center = center.translate(dx, dy)
			return self
		}

		def scale(factor T) Circle<T> {
			radius *= factor
			return self
		}

		def str() string {
			return "Circle(center: {center.str()}, radius: {radius})"
		}
	}
}
