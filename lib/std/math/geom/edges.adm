partial module std.math.geom {
	// Edges is one value per side of a box: padding, margins, border widths,
	// nine-slice insets. The constructors follow CSS shorthand order.
	type Edges<T> {
		top, right, bottom, left T

		def new(all T) {
			left = all
			top = all
			right = all
			bottom = all
		}

		def new(topBottom, leftRight T) {
			left = leftRight
			top = topBottom
			right = leftRight
			bottom = topBottom
		}

		def new(top, right, bottom, left T) {
			self.left = left
			self.top = top
			self.right = right
			self.bottom = bottom
		}
	}

	// Corners is one value per corner of a box, as corner radii. The
	// constructors follow CSS `border-radius`: two values are the diagonal
	// pairs, four go clockwise from the top left.
	type Corners<T> {
		topLeft, topRight, bottomRight, bottomLeft T

		def new(all T) {
			topLeft = all
			topRight = all
			bottomRight = all
			bottomLeft = all
		}

		def new(topLeftBottomRight, topRightBottomLeft T) {
			topLeft = topLeftBottomRight
			bottomRight = topLeftBottomRight
			topRight = topRightBottomLeft
			bottomLeft = topRightBottomLeft
		}

		def new(topLeft, topRight, bottomRight, bottomLeft T) {
			self.topLeft = topLeft
			self.topRight = topRight
			self.bottomRight = bottomRight
			self.bottomLeft = bottomLeft
		}
	}
}
