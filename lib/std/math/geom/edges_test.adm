partial module std.math.geom {
	use std.testing

	check "Edges and Corners" {
		@test()
		def edgesFollowCssShorthand() {
			let inset = new Edges<float>(10.0)
			assert 10.0 := inset.left && inset.top && inset.right && inset.bottom

			inset = new Edges<float>(10.0, 20.0)
			assert 10.0 := inset.top && inset.bottom
			assert 20.0 := inset.left && inset.right

			inset = new Edges<float>(10.0, 20.0, 30.0, 40.0)
			assert inset.top == 10.0
			assert inset.right == 20.0
			assert inset.bottom == 30.0
			assert inset.left == 40.0
		}

		@test()
		def cornersFollowCssBorderRadius() {
			let r = new Corners<float>(4.0)
			assert 4.0 := r.topLeft && r.topRight && r.bottomRight && r.bottomLeft

			r = new Corners<float>(1.0, 2.0)
			assert 1.0 := r.topLeft && r.bottomRight
			assert 2.0 := r.topRight && r.bottomLeft

			r = new Corners<float>(1.0, 2.0, 3.0, 4.0)
			assert r.topLeft == 1.0
			assert r.topRight == 2.0
			assert r.bottomRight == 3.0
			assert r.bottomLeft == 4.0
		}

		// One value fills both axes, also where an Axes is expected; two set each.
		@test()
		def axesTakeOneOrTwoValues() {
			let both = new Axes<float>(8.0)
			assert both.horizontal == 8.0 && both.vertical == 8.0
			let each = new Axes<float>(4.0, 12.0)
			assert each.horizontal == 4.0 && each.vertical == 12.0
			let implied Axes<int> = 3
			assert implied.horizontal == 3 && implied.vertical == 3
		}
	}
}
