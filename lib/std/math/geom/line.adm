partial module std.math.geom {
	use std.math

	// A finite line segment from `start` to `end`
	type Line<T: Numeric = float> {
		start Point<T>
		end   Point<T>

		def new(start Point<T>, end Point<T>) {
			self.start = start
			self.end = end
		}

		// The distance from start to end.
		def length() float {
			return start.distanceTo(end)
		}

		// The squared distance from start to end, without the square root.
		def lengthSquared() T {
			let dx = end.x - start.x
			let dy = end.y - start.y
			return dx * dx + dy * dy
		}

		// Whether start and end are the same point.
		def isDegenerate() bool {
			return start == end
		}

		// The same segment with `float` coordinates.
		def toFloat() Line<float> {
			return new Line<float>(start.toFloat(), end.toFloat())
		}

		// Unit direction from `start` to `end`, none for a degenerate segment.
		def direction() ?Point<float> {
			let len = length()
			return none when len == 0
			return new Point<float>(
				float(end.x - start.x) / len,
				float(end.y - start.y) / len
			)
		}

		// The point halfway between start and end.
		def midpoint() Point<T> {
			return new Point<T>(
				(start.x + end.x) / 2,
				(start.y + end.y) / 2
			)
		}

		// Whether the point lies on the segment.
		def contains(point Point<T>) bool {
			let d1 = start.distanceTo(point)
			let d2 = point.distanceTo(end)
			let d = length()
			return ((d1 + d2) - d).abs() < 0.000001
		}

		// The angle between the two segments' directions, in radians.
		def angleTo(other Line<T>) float {
			let v1 = start.vectorTo(end)
			let v2 = other.start.vectorTo(other.end)

			let len = v1.length() * v2.length()
			return 0 when len == 0

			let c = (v1.dot(v2) / len).clamp(-1.0, 1.0)
			return math.acos(c)
		}

		// The shortest distance from the point to the segment.
		def distanceTo(point Point<T>) float {
			let l2 = float(lengthSquared())
			if l2 == 0 {
				return start.distanceTo(point)
			}

			let s = start.toFloat()
			let e = end.toFloat()
			let p = point.toFloat()
			let t = (
				(p.x - s.x) * (e.x - s.x) +
				(p.y - s.y) * (e.y - s.y)
			) / l2

			let clamped = t.clamp(0.0, 1.0)

			let proj = new Point<float>(
				s.x + clamped * (e.x - s.x),
				s.y + clamped * (e.y - s.y)
			)

			return proj.distanceTo(p)
		}

		// Whether the two segments cross or touch.
		def intersects(other Line<T>) bool {
			return !(intersection(other) is none)
		}

		// The crossing point of two segments; fractional for any `T`, so it
		// is always a `Point<float>`.
		def intersection(other Line<T>) ?Point<float> {
			let a = toFloat()
			let b = other.toFloat()

			let x1 = a.start.x
			let y1 = a.start.y
			let x2 = a.end.x
			let y2 = a.end.y

			let x3 = b.start.x
			let y3 = b.start.y
			let x4 = b.end.x
			let y4 = b.end.y

			let denom = (x1 - x2) * (y3 - y4) - (y1 - y2) * (x3 - x4)
			if denom == 0 {
				return none // parallel or collinear
			}

			let px = ((x1 * y2 - y1 * x2) * (x3 - x4) - (x1 - x2) * (x3 * y4 - y3 * x4)) / denom

			let py = (
				(x1*y2 - y1*x2)*(y3 - y4) -
				(y1 - y2)*(x3*y4 - y3*x4)
			) / denom

			let p = new Point<float>(px, py)

			if a.contains(p) && b.contains(p) {
				return p
			}

			return none
		}

		// The segment moved by dx and dy.
		def translate(dx, dy T) Line<T> {
			start.x += dx
			start.y += dy
			end.x += dx
			end.y += dy
			return self
		}

		// The segment with start and end swapped.
		def reversed() Line<T> {
			return new Line<T>(start = end, end = start)
		}

		// The displacement from start to end as a point.
		def toVector() Point<T> {
			return new Point<T>(end.x - start.x, end.y - start.y)
		}

		// The smallest axis-aligned rectangle holding the segment.
		def boundingBox() Rectangle<T> {
			let minX = start.x.min(end.x)
			let minY = start.y.min(end.y)
			let maxX = start.x.max(end.x)
			let maxY = start.y.max(end.y)

			return new Rectangle<T>(
				position = new Point<T>(minX, minY),
				size     = new Size<T>(maxX - minX, maxY - minY)
			)
		}

		// The segment as text.
		def str() string {
			return sprintf("Line(start=%s, end=%s)", start.str(), end.str())
		}
	}
}
