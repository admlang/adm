internal partial module std.math.geom.morph {
	use (
		std.math::sqrt
		std.math.geom::(Path, PathVerb)
		std.simd
	)

	// Two paths matched for morphing: per subpath pair, the same number of
	// points along each outline (x, y pairs), lined up; plus the points of
	// both paths when matched, to tell when either changed.
	type MorphMatch {
		from     float[][]
		to       float[][]
		closed   bool[]
		closedTo bool[]
		fromPts  float[]
		toPts    float[]
		fromOps  int
		toOps    int

		def new() {}

		// Whether the match still describes these two paths.
		def fits(a Path, b Path) bool {
			return false when a.verbs.len() != fromOps || b.verbs.len() != toOps
			return samePoints(a.coords, fromPts) && samePoints(b.coords, toPts)
		}

		// The paths at t: each point from + (to - from) * t, eight values a
		// vector.
		def at(t float) Path {
			let out = new Path()
			let k = simd.splat8<float>(t)
			for let (i, a) in from {
				let b = to[i]
				let n = a.len()
				continue when n < 2
				let pts float[]
				pts.len(n)
				let j = 0
				for j + 8 <= n {
					let va = simd.load8<float>(a, j)
					simd.store8<float>(pts, j, va + (simd.load8<float>(b, j) - va) * k)
					j += 8
				}
				for j < n {
					pts[j] = a[j] + (b[j] - a[j]) * t
					j++
				}
				out.moveTo(pts[0], pts[1])
				for let p = 2; p < n; p += 2 {
					out.lineTo(pts[p], pts[p + 1])
				}
				let shut = t < 0.5 ?? (closed[i], closedTo[i])
				if shut {
					out.close()
				}
			}
			return out
		}
	}

	def samePoints(a float[], b float[]) bool {
		return false when a.len() != b.len()
		for let i = 0; i < a.len(); i++ {
			return false when a[i] != b[i]
		}
		return true
	}

	// One subpath as a polyline: its points (x, y pairs) and whether it
	// closes.
	struct Outline {
		pts    float[]
		closed bool
	}

	// Matches `a` to `b`: subpaths paired largest first (a subpath without
	// a partner shrinks to, or grows from, its own centre), each pair
	// resampled to the same number of points by length, turned the same
	// way and started at the points closest to each other.
	def matchPaths(a Path, b Path) MorphMatch {
		let m = new MorphMatch()
		m.fromPts = copyOf(a.coords)
		m.toPts = copyOf(b.coords)
		m.fromOps = a.verbs.len()
		m.toOps = b.verbs.len()
		let fromLines = bySize(outlines(a))
		let toLines = bySize(outlines(b))
		let pairs = fromLines.len().max(toLines.len())
		for let i = 0; i < pairs; i++ {
			let oa = i < fromLines.len() ?? (fromLines[i], pointAt(centreOf(toLines[i])))
			let ob = i < toLines.len() ?? (toLines[i], pointAt(centreOf(fromLines[i])))
			let n = sampleCount(oa, ob)
			let ra = resample(oa, n)
			let rb = resample(ob, n)
			if oa.closed || ob.closed {
				if signedArea(ra) * signedArea(rb) < 0.0 {
					rb = reversed(rb)
				}
				rb = rotated(rb, bestOffset(ra, rb))
			} else if distance2(ra, reversed(rb)) < distance2(ra, rb) {
				rb = reversed(rb)
			}
			m.from.push(ra)
			m.to.push(rb)
			m.closed.push(oa.closed)
			m.closedTo.push(ob.closed)
		}
		return m
	}

	// The subpaths of the path, flattened to within a hundredth of a unit.
	def outlines(p Path) Outline[] {
		let flat = p.flattened(0.01)
		let out Outline[]
		let cur float[]
		let j = 0
		let c = flat.coords
		for let (_, op) in flat.verbs {
			match op {
				case PathVerb.Move:
					addOutline(out, cur, false)
					cur = float[]
					cur.push(c[j])
					cur.push(c[j + 1])
					j += 2
				case PathVerb.Line:
					cur.push(c[j])
					cur.push(c[j + 1])
					j += 2
				case PathVerb.Close:
					addOutline(out, cur, true)
					cur = float[]
				default:
				// flattened() leaves only moves, lines and closes.
			}
		}
		addOutline(out, cur, false)
		return out
	}

	// Adds the points as an outline when there are any; a closing point on
	// the start is the same point twice.
	def addOutline(out Outline[], cur float[], shut bool) {
		let n = cur.len()
		return when n < 2
		if shut && n >= 4 && cur[n - 2] == cur[0] && cur[n - 1] == cur[1] {
			cur.len(n - 2)
		}
		out.push(Outline{pts: cur, closed: shut})
	}

	// Largest first: closed outlines by area, open ones by length after.
	def bySize(list Outline[]) Outline[] {
		let out Outline[]
		for let (_, o) in list {
			let k = out.len()
			out.push(o)
			for k > 0 && sizeOf(out[k - 1]) < sizeOf(o) {
				out[k] = out[k - 1]
				k--
			}
			out[k] = o
		}
		return out
	}

	def sizeOf(o Outline) float {
		return o.closed ?? (signedArea(o.pts).abs() + 1.0e12, lengthOf(o.pts, false))
	}

	def centreOf(o Outline) (float, float) {
		let (sx, sy) = (0.0, 0.0)
		let n = o.pts.len() / 2
		return (0.0, 0.0) when n == 0
		for let i = 0; i < o.pts.len(); i += 2 {
			sx += o.pts[i]
			sy += o.pts[i + 1]
		}
		return (sx / float(n), sy / float(n))
	}

	// A closed outline of one point: what a partnerless subpath shrinks to.
	def pointAt(c (float, float)) Outline {
		let (x, y) = c
		return Outline{pts: float[x, y], closed: true}
	}

	// Enough points for the longer outline to keep its shape (one every
	// half unit, at least as many as either has), within limits.
	def sampleCount(a Outline, b Outline) int {
		let len = lengthOf(a.pts, a.closed).max(lengthOf(b.pts, b.closed))
		let n = int((len * 2.0).ceil()).max(a.pts.len() / 2).max(b.pts.len() / 2)
		return n.clamp(16, 4096)
	}

	def lengthOf(pts float[], closed bool) float {
		let total = 0.0
		let n = pts.len() / 2
		for let i = 1; i < n; i++ {
			total += segment(pts, i - 1, i)
		}
		if closed && n > 1 {
			total += segment(pts, n - 1, 0)
		}
		return total
	}

	def segment(pts float[], i int, j int) float {
		let dx = pts[j * 2] - pts[i * 2]
		let dy = pts[j * 2 + 1] - pts[i * 2 + 1]
		return sqrt(dx * dx + dy * dy)
	}

	// n points evenly spaced by length along the outline: from its start
	// round to it (closed), or from start to end (open).
	def resample(o Outline, n int) float[] {
		let pts = o.pts
		let count = pts.len() / 2
		let out float[]
		out.len(n * 2)
		if count == 1 || lengthOf(pts, o.closed) == 0.0 {
			for let i = 0; i < n; i++ {
				out[i * 2] = pts[0]
				out[i * 2 + 1] = pts[1]
			}
			return out
		}
		let total = lengthOf(pts, o.closed)
		let steps = o.closed ?? (n, n - 1)
		let edges = o.closed ?? (count, count - 1)
		let edge = 0
		let walked = 0.0
		for let i = 0; i < n; i++ {
			let want = total * float(i) / float(steps.max(1))
			for edge < edges - 1 && walked + segment(pts, edge, (edge + 1) % count) < want {
				walked += segment(pts, edge, (edge + 1) % count)
				edge++
			}
			let len = segment(pts, edge, (edge + 1) % count)
			let f = len > 0.0 ?? (((want - walked) / len).clamp(0.0, 1.0), 0.0)
			let next = (edge + 1) % count
			out[i * 2] = pts[edge * 2] + (pts[next * 2] - pts[edge * 2]) * f
			out[i * 2 + 1] = pts[edge * 2 + 1] + (pts[next * 2 + 1] - pts[edge * 2 + 1]) * f
		}
		return out
	}

	def signedArea(pts float[]) float {
		let n = pts.len() / 2
		let a = 0.0
		for let i = 0; i < n; i++ {
			let j = (i + 1) % n
			a += pts[i * 2] * pts[j * 2 + 1] - pts[j * 2] * pts[i * 2 + 1]
		}
		return a / 2.0
	}

	def reversed(pts float[]) float[] {
		let n = pts.len() / 2
		let out float[]
		out.len(pts.len())
		for let i = 0; i < n; i++ {
			out[i * 2] = pts[(n - 1 - i) * 2]
			out[i * 2 + 1] = pts[(n - 1 - i) * 2 + 1]
		}
		return out
	}

	// The points starting at index k, going round.
	def rotated(pts float[], k int) float[] {
		let n = pts.len() / 2
		return pts when k == 0 || n == 0
		let out float[]
		out.len(pts.len())
		for let i = 0; i < n; i++ {
			let s = (i + k) % n
			out[i * 2] = pts[s * 2]
			out[i * 2 + 1] = pts[s * 2 + 1]
		}
		return out
	}

	def distance2(a float[], b float[]) float {
		let total = 0.0
		for let i = 0; i < a.len(); i++ {
			let d = a[i] - b[i]
			total += d * d
		}
		return total
	}

	// The start in `b` whose points lie closest to `a`'s, overall: a coarse
	// pass over every step-th start, then every start around the best.
	def bestOffset(a float[], b float[]) int {
		let n = a.len() / 2
		return 0 when n < 2
		let step = (n / 64).max(1)
		let best = 0
		let bestCost = offsetCost(a, b, 0)
		for let k = step; k < n; k += step {
			let c = offsetCost(a, b, k)
			if c < bestCost {
				bestCost = c
				best = k
			}
		}
		for let d = -step; d <= step; d++ {
			let k = ((best + d) % n + n) % n
			let c = offsetCost(a, b, k)
			if c < bestCost {
				bestCost = c
				best = k
			}
		}
		return best
	}

	def offsetCost(a float[], b float[], k int) float {
		let n = a.len() / 2
		let total = 0.0
		for let i = 0; i < n; i++ {
			let s = (i + k) % n
			let dx = a[i * 2] - b[s * 2]
			let dy = a[i * 2 + 1] - b[s * 2 + 1]
			total += dx * dx + dy * dy
		}
		return total
	}

	def copyOf(a float[]) float[] {
		let out float[]
		out.len(a.len())
		for let i = 0; i < a.len(); i++ {
			out[i] = a[i]
		}
		return out
	}
}
