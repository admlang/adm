partial module std.math.geom {
	use (
		std.testing
		std.math::(Pi, cos, sin)
	)

	check "Path morph" {
		def square(x float, y float, s float) Path {
			return new Path().rect(Rect{left: x, top: y, right: x + s, bottom: y + s})
		}

		def star(cx float, cy float, r float) Path {
			let p = new Path()
			for let i = 0; i < 10; i++ {
				let a = -Pi / 2.0 + float(i) * Pi / 5.0
				let k = i % 2 == 0 ?? (r, r * 0.4)
				if i == 0 {
					p.moveTo(cx + k * cos(a), cy + k * sin(a))
				} else {
					p.lineTo(cx + k * cos(a), cy + k * sin(a))
				}
			}
			return p.close()
		}

		// Total unsigned area of the closed subpaths.
		def area(p Path) float {
			let total = 0.0
			let c = p.flattened(0.01).coords
			let v = p.flattened(0.01).verbs
			let start = 0
			let j = 0
			for let (i, op) in v {
				if op == PathVerb.Move {
					start = j
				}
				if op == PathVerb.Close || i == v.len() - 1 {
					let end = op == PathVerb.Close ?? (j, j + 2)
					let a = 0.0
					let n = (end - start) / 2
					for let k = 0; k < n; k++ {
						let p0 = start + k * 2
						let p1 = start + ((k + 1) % n) * 2
						a += c[p0] * c[p1 + 1] - c[p1] * c[p0 + 1]
					}
					total += a.abs() / 2.0
				}
				j += op == PathVerb.Close ?? (0, 2)
			}
			return total
		}

		def subpaths(p Path) int {
			let n = 0
			for let (_, op) in p.verbs {
				n += op == PathVerb.Move ?? (1, 0)
			}
			return n
		}

		@test()
		def endsAreTheShapesThemselves() {
			let a = square(0.0, 0.0, 10.0)
			let b = star(5.0, 5.0, 8.0)
			let s = a.morph(b, 0.0)
			let e = a.morph(b, 1.0)
			assert s.coords.len() == a.coords.len() && e.coords.len() == b.coords.len()
			for let i = 0; i < a.coords.len(); i++ {
				assert s.coords[i] == a.coords[i]
			}
		}

		@test()
		def squareBecomesAStar() {
			let a = square(0.0, 0.0, 100.0)
			let b = star(50.0, 50.0, 60.0)
			let half = a.morph(b, 0.5)
			assert subpaths(half) == 1
			let (aa, ab, ah) = (area(a), area(b), area(half))
			// Halfway lies between the two, not collapsed or turned inside out.
			assert ah > ab.min(aa) * 0.7 && ah < ab.max(aa) * 1.1
			let bb = half.bounds()
			assert bb.left > -10.0 && bb.right < 110.0
		}

		@test()
		def aShapeMorphsToItselfUnchanged() {
			let a = square(0.0, 0.0, 40.0)
			// The same square drawn the other way round, from another corner.
			let b = new Path().moveTo(40.0, 40.0).lineTo(40.0, 0.0).lineTo(0.0, 0.0).lineTo(0.0, 40.0).close()
			for let (_, t) in [0.25, 0.5, 0.75] {
				let m = a.morph(b, t)
				assert (area(m) - 1600.0).abs() < 1.0
				let r = m.bounds()
				assert (r.left - 0.0).abs() < 1e-6 && (r.right - 40.0).abs() < 1e-6
			}
		}

		@test()
		def extraSubpathsGrowFromTheirCentre() {
			let one = square(0.0, 0.0, 20.0)
			let two = square(0.0, 0.0, 20.0).add(square(50.0, 50.0, 10.0))
			let early = one.morph(two, 0.01)
			assert subpaths(early) == 2
			// The new square starts as a speck around (55, 55).
			assert area(early) < 400.0 + 1.0
			let late = one.morph(two, 0.99)
			assert (area(late) - 500.0).abs() < 5.0
		}

		@test()
		def matchesAreKeptUntilAPathChanges() {
			let a = square(0.0, 0.0, 10.0)
			let b = star(5.0, 5.0, 8.0)
			let first = a.morph(b, 0.3)
			let again = a.morph(b, 0.3)
			assert first.coords.len() == again.coords.len()
			for let i = 0; i < first.coords.len(); i++ {
				assert first.coords[i] == again.coords[i]
			}
			// A change to the target is seen.
			b.moveTo(30.0, 30.0).lineTo(40.0, 30.0).lineTo(40.0, 40.0).close()
			assert subpaths(a.morph(b, 0.3)) == 2
		}

		@test()
		def pastTheEndsCarriesOn() {
			let a = square(0.0, 0.0, 10.0)
			let b = square(0.0, 0.0, 20.0)
			let over = a.morph(b, 1.5)
			assert (over.bounds().right - 25.0).abs() < 1e-6
		}
	}
}
