partial module std.math.geom {
	use (
		std.math::(Pi, Tau, acos, atan2, cos, sin, sqrt)
		std.units::(Percent, Pixels)
		std.math.geom.boolean
		std.math.geom.morph::(MorphMatch, matchPaths)
	)

	// FillRule decides which regions of a self-overlapping path are inside.
	enum FillRule {
		NonZero,  // the default of Canvas 2D, SVG, PostScript
		EvenOdd,
	}

	// PathVerb is one step of a path: Move and Line take one point from
	// `Path.coords`, Quad two (control, end), Cubic three (two controls, end),
	// Close none.
	enum PathVerb {
		Move,
		Line,
		Quad,
		Cubic,
		Close,
	}

	// Path is a sequence of subpaths made of lines, Bézier curves and arcs,
	// in user coordinates. Builders return the path, so calls chain. Arcs,
	// circles and ellipses are stored as cubic Béziers, so a transformed
	// path stays exact.
	type Path {
		internal ops            PathVerb[]
		internal pts            float[]
		// The current point and the start of the current subpath.
		internal curX, curY     float
		internal startX, startY float
		// Whether a subpath is open (a moveTo came and no close since).
		internal open           bool
		// Whether the path has a current point at all.
		internal started        bool
		// The last match `morph` made, kept for the frames that follow.
		internal morphCache     ?MorphMatch = none

		def new() {}

		// The steps of the path, in order. Shared with the path, not copied.
		verbs PathVerb[] {
			def get() PathVerb[] {
				return ops
			}
		}

		// The points the verbs consume, as x, y pairs. Shared with the path.
		coords float[] {
			def get() float[] {
				return pts
			}
		}

		// Whether the path has no segments.
		def isEmpty() bool {
			return ops.len() == 0
		}

		// Starts a new subpath at (x, y).
		def moveTo(x, y float) Path {
			// A move after a move replaces it: an empty subpath paints nothing.
			if ops.len() > 0 && ops[ops.len() - 1] == PathVerb.Move {
				pts[pts.len() - 2] = x
				pts[pts.len() - 1] = y
			} else {
				ops.push(PathVerb.Move)
				pts.push(x)
				pts.push(y)
			}
			curX = x
			curY = y
			startX = x
			startY = y
			open = true
			started = true
			return self
		}

		// A line from the current point to (x, y). With no current point it
		// starts the subpath there, as Canvas 2D does.
		def lineTo(x, y float) Path {
			return moveTo(x, y) when !started
			ensureOpen()
			ops.push(PathVerb.Line)
			pts.push(x)
			pts.push(y)
			curX = x
			curY = y
			return self
		}

		// A quadratic Bézier with control (cx, cy) ending at (x, y).
		def quadTo(cx, cy, x, y float) Path {
			moveTo(cx, cy) when !started
			ensureOpen()
			ops.push(PathVerb.Quad)
			pts.push(cx)
			pts.push(cy)
			pts.push(x)
			pts.push(y)
			curX = x
			curY = y
			return self
		}

		// A cubic Bézier with controls (c1x, c1y) and (c2x, c2y) ending at (x, y).
		def cubicTo(c1x, c1y, c2x, c2y, x, y float) Path {
			moveTo(c1x, c1y) when !started
			ensureOpen()
			ops.push(PathVerb.Cubic)
			pts.push(c1x)
			pts.push(c1y)
			pts.push(c2x)
			pts.push(c2y)
			pts.push(x)
			pts.push(y)
			curX = x
			curY = y
			return self
		}

		// An arc of the circle through the current point, tangent to the two
		// lines (Canvas 2D arcTo): from the current point towards (x1, y1),
		// then towards (x2, y2). Collinear points or a zero radius give a line
		// to (x1, y1).
		def arcTo(x1, y1, x2, y2, radius float) Path {
			return moveTo(x1, y1) when !started
			let (
				ux = curX - x1
				uy = curY - y1
				vx = x2 - x1
				vy = y2 - y1
				ul = sqrt(ux * ux + uy * uy)
				vl = sqrt(vx * vx + vy * vy)
			)
			return lineTo(x1, y1) when radius <= 0.0 || ul < 1e-12 || vl < 1e-12
			ux = ux / ul
			uy = uy / ul
			vx = vx / vl
			vy = vy / vl
			let cross = ux * vy - uy * vx
			return lineTo(x1, y1) when cross.abs() < 1e-12
			// Half the angle between the two lines at the corner.
			let half = acos((ux * vx + uy * vy).clamp(-1.0, 1.0)) / 2.0
			let d = radius / (sin(half) / cos(half))
			let (
				t1x = x1 + ux * d
				t1y = y1 + uy * d
				t2x = x1 + vx * d
				t2y = y1 + vy * d
				bx  = ux + vx
				by  = uy + vy
				bl  = sqrt(bx * bx + by * by)
				h   = radius / sin(half)
				cx  = x1 + bx / bl * h
				cy  = y1 + by / bl * h
			)
			lineTo(t1x, t1y)
			let a1 = atan2(t1y - cy, t1x - cx)
			let a2 = atan2(t2y - cy, t2x - cx)
			let sweep = a2 - a1
			sweep -= Tau when sweep > Pi
			sweep += Tau when sweep < -Pi
			appendArc(cx, cy, radius, radius, 0.0, a1, sweep)
			return self
		}

		// SVG's elliptical arc from the current point to (x, y): radii rx and
		// ry, the ellipse's x axis `rotation` radians from +x, the larger or
		// smaller of the two arcs, clockwise (`sweep`) or not. Radii too small
		// to reach grow as SVG says; a zero radius gives a line.
		def arcTo(rx, ry, rotation float, large bool, sweep bool, x, y float) Path {
			return moveTo(x, y) when !started
			ensureOpen()
			svgArc(rx, ry, rotation, large, sweep, x, y)
			return self
		}

		// Closes the current subpath with a line back to its start.
		def close() Path {
			if open {
				ops.push(PathVerb.Close)
				open = false
				curX = startX
				curY = startY
			}
			return self
		}

		// A closed rectangle, clockwise from the top left.
		def rect(r Rect) Path {
			moveTo(r.left, r.top)
			lineTo(r.right, r.top)
			lineTo(r.right, r.bottom)
			lineTo(r.left, r.bottom)
			return close()
		}

		// A rectangle with rounded corners, one radius for every corner.
		// Percent is of the rectangle's width (x) and height (y), as CSS
		// border-radius; radii too large for the sides shrink together.
		def roundRect(r Rect, radius Pixels | Percent) Path {
			return roundRect(r, new Corners<Pixels | Percent>(radius))
		}

		// A rectangle with one radius per corner.
		def roundRect(r Rect, radius Corners<Pixels | Percent>) Path {
			let (
				w = (r.right - r.left).abs()
				h = (r.bottom - r.top).abs()
			)
			let (tlx, tly) = cornerRadii(radius.topLeft, w, h)
			let (trx, trY) = cornerRadii(radius.topRight, w, h)
			let (brx, bry) = cornerRadii(radius.bottomRight, w, h)
			let (blx, bly) = cornerRadii(radius.bottomLeft, w, h)
			// CSS: when two radii on one side add up to more than the side,
			// every radius scales down by the same factor.
			let f = 1.0
			f = f.min(w / (tlx + trx)) when tlx + trx > w
			f = f.min(w / (blx + brx)) when blx + brx > w
			f = f.min(h / (tly + bly)) when tly + bly > h
			f = f.min(h / (trY + bry)) when trY + bry > h
			tlx *= f
			tly *= f
			trx *= f
			trY *= f
			brx *= f
			bry *= f
			blx *= f
			bly *= f
			let l = r.left.min(r.right)
			let t = r.top.min(r.bottom)
			let rr = l + w
			let b = t + h
			moveTo(l + tlx, t)
			lineTo(rr - trx, t)
			cornerArc(rr - trx, t + trY, trx, trY, -Pi / 2.0)
			lineTo(rr, b - bry)
			cornerArc(rr - brx, b - bry, brx, bry, 0.0)
			lineTo(l + blx, b)
			cornerArc(l + blx, b - bly, blx, bly, Pi / 2.0)
			lineTo(l, t + tly)
			cornerArc(l + tlx, t + tly, tlx, tly, Pi)
			return close()
		}

		// A closed circle, clockwise from its rightmost point.
		def circle(center Point, radius float) Path {
			return ellipse(center, radius, radius)
		}

		// A closed ellipse with radii rx and ry, its x axis `rotation`
		// radians from +x.
		def ellipse(center Point, rx, ry float, rotation float = 0.0) Path {
			let c = cos(rotation)
			let s = sin(rotation)
			moveTo(center.x + rx * c, center.y + rx * s)
			appendArc(center.x, center.y, rx, ry, rotation, 0.0, Tau)
			return close()
		}

		// An arc of the circle, angles in radians clockwise from +x. It joins
		// the current point with a line, as Canvas 2D does, so
		// `moveTo(center).arc(…).close()` draws a pie slice; with no current
		// point it starts a subpath. A sweep of a whole turn or more draws the
		// whole circle.
		def arc(center Point, radius float, start, end float, counterClockwise bool = false) Path {
			let sweep = end - start
			if !counterClockwise {
				if sweep >= Tau {
					sweep = Tau
				} else {
					sweep = sweep - (sweep / Tau).floor() * Tau
				}
			} else {
				if - sweep >= Tau {
					sweep = -Tau
				} else {
					let back = -sweep
					sweep = -(back - (back / Tau).floor() * Tau)
				}
			}
			let sx = center.x + radius * cos(start)
			let sy = center.y + radius * sin(start)
			if started && open {
				lineTo(sx, sy) when sx != curX || sy != curY
			} else {
				moveTo(sx, sy)
			}
			appendArc(center.x, center.y, radius, radius, 0.0, start, sweep)
			return self
		}

		// A closed polygon through the points; fewer than two add nothing.
		def polygon(points Point[]) Path {
			return self when points.len() < 2
			moveTo(points[0].x, points[0].y)
			for let i = 1; i < points.len(); i++ {
				lineTo(points[i].x, points[i].y)
			}
			return close()
		}

		// Appends every subpath of `other`, moved by `transform`.
		def add(other Path, transform Transform2D = new Transform2D()) Path {
			let j = 0
			for let (_, op) in other.ops {
				match op {
					case PathVerb.Move:
						let (x, y) = xform(transform, other.pts[j], other.pts[j + 1])
						// A move ends any open subpath of this path.
						ops.push(PathVerb.Move)
						pts.push(x)
						pts.push(y)
						curX = x
						curY = y
						startX = x
						startY = y
						open = true
						started = true
						j += 2
					case PathVerb.Line:
						let (x, y) = xform(transform, other.pts[j], other.pts[j + 1])
						lineTo(x, y)
						j += 2
					case PathVerb.Quad:
						let (cx, cy) = xform(transform, other.pts[j], other.pts[j + 1])
						let (x, y) = xform(transform, other.pts[j + 2], other.pts[j + 3])
						quadTo(cx, cy, x, y)
						j += 4
					case PathVerb.Cubic:
						let (ax, ay) = xform(transform, other.pts[j], other.pts[j + 1])
						let (bx, by) = xform(transform, other.pts[j + 2], other.pts[j + 3])
						let (x, y) = xform(transform, other.pts[j + 4], other.pts[j + 5])
						cubicTo(ax, ay, bx, by, x, y)
						j += 6
					case PathVerb.Close:
						close()
				}
			}
			return self
		}

		// The smallest rectangle holding every point the path passes through
		// (curve extrema included, control points outside the curve not). An
		// empty path gives an empty rectangle at the origin.
		def bounds() Rect {
			return Rect{left: 0.0, top: 0.0, right: 0.0, bottom: 0.0} when pts.len() == 0
			let r = Rect{left: pts[0], top: pts[1], right: pts[0], bottom: pts[1]}
			let j = 0
			let px = 0.0
			let py = 0.0
			for let (_, op) in ops {
				match op {
					case PathVerb.Move, PathVerb.Line:
						px = pts[j]
						py = pts[j + 1]
						grow(r, px, py)
						j += 2
					case PathVerb.Quad:
						let (cx, cy, x, y) = (pts[j], pts[j + 1], pts[j + 2], pts[j + 3])
						grow(r, x, y)
						let tx = quadraticExtremum(px, cx, x)
						let ty = quadraticExtremum(py, cy, y)
						if tx > 0.0 && tx < 1.0 {
							grow(r, quadAt(px, cx, x, tx), quadAt(py, cy, y, tx))
						}
						if ty > 0.0 && ty < 1.0 {
							grow(r, quadAt(px, cx, x, ty), quadAt(py, cy, y, ty))
						}
						px = x
						py = y
						j += 4
					case PathVerb.Cubic:
						let (ax, ay, bx, by, x, y) = (pts[j], pts[j + 1], pts[j + 2], pts[j + 3], pts[j + 4], pts[j + 5])
						grow(r, x, y)
						let ts = cubicExtrema(px, ax, bx, x) + cubicExtrema(py, ay, by, y)
						for let (_, t) in ts {
							grow(r, cubicAt(px, ax, bx, x, t), cubicAt(py, ay, by, y, t))
						}
						px = x
						py = y
						j += 6
					default:
				}
			}
			return r
		}

		// Whether the point is inside the area the path encloses under the
		// rule. Open subpaths count as closed by a straight line, as when
		// filled.
		def contains(p Point, rule FillRule = FillRule.NonZero) bool {
			let w = winding(flattened(0.01).edges(), p.x, p.y)
			return rule == FillRule.NonZero ?? (w != 0, w % 2 != 0)
		}

		// The total length of every subpath, the lines `close` added included.
		def length() float {
			let e = flattened(0.001).edges(false)
			let total = 0.0
			for let i = 0; i < e.len(); i += 4 {
				let dx = e[i + 2] - e[i]
				let dy = e[i + 3] - e[i + 1]
				total += sqrt(dx * dx + dy * dy)
			}
			return total
		}

		// The point `distance` along the path and the unit tangent there
		// (text on a path, markers). Distances outside the path clamp to its
		// ends; an empty path gives its first point, or the origin, and +x.
		def pointAt(distance float) (Point, Vec2) {
			let e = flattened(0.001).edges(false)
			let left = distance.max(0.0)
			let (
				px = 0.0
				py = 0.0
				tx = 1.0
				ty = 0.0
			)
			if pts.len() >= 2 {
				px = pts[0]
				py = pts[1]
			}
			for let i = 0; i < e.len(); i += 4 {
				let dx = e[i + 2] - e[i]
				let dy = e[i + 3] - e[i + 1]
				let len = sqrt(dx * dx + dy * dy)
				continue when len == 0.0
				tx = dx / len
				ty = dy / len
				if left <= len {
					return (new Point(e[i] + tx * left, e[i + 1] + ty * left), new Vec2(tx, ty))
				}
				left -= len
				px = e[i + 2]
				py = e[i + 3]
			}
			return (new Point(px, py), new Vec2(tx, ty))
		}

		// The part of the path between `from` and `to` of its whole length
		// (0% to 100%, subpaths in order, the lines `close` adds counted), as
		// lines: animating `to` from 0% draws the path in. A subpath kept
		// whole stays closed; empty when `to` is not past `from`.
		def trimmed(from Percent, to Percent) Path {
			let out = new Path()
			let flat = flattened(0.01)
			let c = flat.coords
			let total = flat.length()
			let a = (float(from) / 100.0).clamp(0.0, 1.0) * total
			let b = (float(to) / 100.0).clamp(0.0, 1.0) * total
			return out when b <= a || total == 0.0
			let walked = 0.0
			let (sx, sy, px, py) = (0.0, 0.0, 0.0, 0.0)
			let j = 0
			// Whether the output has a subpath open, and whether all of the
			// current input subpath went into it.
			let drawing = false
			let whole = true
			for let (_, op) in flat.verbs {
				let (x, y) = (px, py)
				match op {
					case PathVerb.Move:
						sx = c[j]
						sy = c[j + 1]
						px = sx
						py = sy
						j += 2
						drawing = false
						whole = walked >= a
						continue
					case PathVerb.Line:
						x = c[j]
						y = c[j + 1]
						j += 2
					case PathVerb.Close:
						x = sx
						y = sy
					default:
				}
				let len = sqrt((x - px) * (x - px) + (y - py) * (y - py))
				let s0 = walked
				let s1 = walked + len
				walked = s1
				if s1 > a && s0 < b && len > 0.0 {
					let f0 = ((a - s0) / len).clamp(0.0, 1.0)
					let f1 = ((b - s0) / len).clamp(0.0, 1.0)
					if !drawing {
						out.moveTo(px + (x - px) * f0, py + (y - py) * f0)
						drawing = true
					}
					out.lineTo(px + (x - px) * f1, py + (y - py) * f1)
					whole = whole && f1 >= 1.0 && s0 >= a
				} else if len > 0.0 {
					whole = false
				}
				if op == PathVerb.Close {
					if drawing && whole {
						out.close()
					}
					drawing = false
				}
				px = x
				py = y
			}
			return out
		}

		// The shape between this path (t = 0) and `target` (t = 1), for any
		// two paths: a square to a star, one subpath to three. Outlines are
		// paired largest first and resampled to the same points along their
		// length, turned the same way and started where they lie closest;
		// a subpath without a partner shrinks to or grows from its centre.
		// t outside 0..1 carries on past the ends. The match is kept until
		// either path changes, so animating costs one blend a frame.
		def morph(target Path, t float) Path {
			return new Path().add(self) when t == 0.0
			return new Path().add(target) when t == 1.0
			let m = morphCache
			if m is MorphMatch && m.fits(self, target) {
				return m.at(t)
			}
			let fresh = matchPaths(self, target)
			morphCache = fresh
			return fresh.at(t)
		}

		// The region either path fills. Boolean operations read both paths
		// filled non-zero and return closed polylines (curves flattened
		// finely, within 1/10000 of each path's size) whose contours never
		// cross and whose holes run the other way, so the result fills the
		// same under either rule.
		def unite(other Path) Path {
			return boolean.combine(self, other, boolean.BooleanOp.Union)
		}

		// The region both paths fill (see unite).
		def intersect(other Path) Path {
			return boolean.combine(self, other, boolean.BooleanOp.Intersect)
		}

		// The region this path fills and `other` does not (see unite).
		def subtract(other Path) Path {
			return boolean.combine(self, other, boolean.BooleanOp.Subtract)
		}

		// The region exactly one of the paths fills (see unite).
		def xor(other Path) Path {
			return boolean.combine(self, other, boolean.BooleanOp.Xor)
		}

		// `a | b` is a.unite(b), `a & b` a.intersect(b), `a - b`
		// a.subtract(b) and `a ^ b` a.xor(b), as for arrays.
		infix def | (other Path) Path {
			return unite(other)
		}

		infix def & (other Path) Path {
			return intersect(other)
		}

		infix def - (other Path) Path {
			return subtract(other)
		}

		infix def ^ (other Path) Path {
			return xor(other)
		}

		// A copy of the path with every point moved by the transform.
		def transformed(t Transform2D) Path {
			return new Path().add(self, t)
		}

		// A copy with curves replaced by line segments that stay within
		// `tolerance` of them.
		def flattened(tolerance float = 0.25) Path {
			let out = new Path()
			let tol = tolerance.max(1e-6)
			let j = 0
			let px = 0.0
			let py = 0.0
			for let (_, op) in ops {
				match op {
					case PathVerb.Move:
						px = pts[j]
						py = pts[j + 1]
						out.moveTo(px, py)
						j += 2
					case PathVerb.Line:
						px = pts[j]
						py = pts[j + 1]
						out.lineTo(px, py)
						j += 2
					case PathVerb.Quad:
						flattenQuad(out, px, py, pts[j], pts[j + 1], pts[j + 2], pts[j + 3], tol)
						px = pts[j + 2]
						py = pts[j + 3]
						j += 4
					case PathVerb.Cubic:
						flattenCubic(out, px, py, pts[j], pts[j + 1], pts[j + 2], pts[j + 3], pts[j + 4], pts[j + 5], tol)
						px = pts[j + 4]
						py = pts[j + 5]
						j += 6
					case PathVerb.Close:
						out.close()
				}
			}
			return out
		}

		// The outline a stroke with this style would paint, as a path to fill
		// with the non-zero rule (Skia getFillPath, Cairo stroke-to-path).
		// Curves come back as line segments within `tolerance` of the
		// outline; a dash pattern in the style is applied first.
		def stroked(strokeStyle StrokeStyle, tolerance float = 0.1) Path {
			return strokeOutline(self, strokeStyle, tolerance.max(1e-6))
		}

		// The path cut into dashes: `pattern` lengths alternate on and off,
		// in path units, starting `offset` into the pattern. Each subpath
		// starts the pattern again. An odd count repeats the pattern, as SVG
		// does; an empty pattern, or one that is all zeros or has a negative
		// length, gives the path back unchanged. Curves come back as line
		// segments within `tolerance` of them.
		def dashed(pattern float[], offset float = 0.0, tolerance float = 0.05) Path {
			return dashPath(self, pattern, offset, tolerance.max(1e-6))
		}

		// Starts a subpath at the current point when the last one was closed,
		// as SVG does for a segment after Z.
		internal def ensureOpen() {
			return when open
			ops.push(PathVerb.Move)
			pts.push(curX)
			pts.push(curY)
			startX = curX
			startY = curY
			open = true
		}

		// Appends cubics for the arc of the ellipse centred at (cx, cy), radii
		// rx and ry rotated by phi, from angle theta by sweep (radians,
		// positive clockwise), starting at the current point.
		internal def appendArc(cx, cy, rx, ry, phi, theta, sweep float) {
			return when sweep == 0.0
			let n = int((sweep.abs() / (Pi / 2.0) - 1e-9).ceil()).max(1)
			let delta = sweep / float(n)
			let k = 4.0 / 3.0 * sin(delta / 4.0) / cos(delta / 4.0)
			let cp = cos(phi)
			let sp = sin(phi)
			let a = theta
			for let i = 0; i < n; i++ {
				let b = a + delta
				let (
					ca  = cos(a)
					sa  = sin(a)
					cb  = cos(b)
					sb  = sin(b)
					// Points and derivatives on the rotated ellipse.
					p0x = cx + rx * ca * cp - ry * sa * sp
					p0y = cy + rx * ca * sp + ry * sa * cp
					d0x = -rx * sa * cp - ry * ca * sp
					d0y = -rx * sa * sp + ry * ca * cp
					p3x = cx + rx * cb * cp - ry * sb * sp
					p3y = cy + rx * cb * sp + ry * sb * cp
					d3x = -rx * sb * cp - ry * cb * sp
					d3y = -rx * sb * sp + ry * cb * cp
				)
				cubicTo(p0x + k * d0x, p0y + k * d0y, p3x - k * d3x, p3y - k * d3y, p3x, p3y)
				a = b
			}
		}

		// A quarter arc of a rounded corner, centred at (cx, cy), from angle
		// `from` a quarter turn clockwise.
		internal def cornerArc(cx, cy, rx, ry, from float) {
			return when rx <= 0.0 || ry <= 0.0
			appendArc(cx, cy, rx, ry, 0.0, from, Pi / 2.0)
		}

		// The SVG endpoint arc (SVG 1.1 appendix F.6) from the current point.
		internal def svgArc(rx, ry, rotation float, large bool, sweep bool, x, y float) {
			let x0 = curX
			let y0 = curY
			return when x0 == x && y0 == y
			rx = rx.abs()
			ry = ry.abs()
			if rx == 0.0 || ry == 0.0 {
				lineTo(x, y)
				return
			}
			let cp = cos(rotation)
			let sp = sin(rotation)
			let hx = (x0 - x) / 2.0
			let hy = (y0 - y) / 2.0
			let x1p = cp * hx + sp * hy
			let y1p = -sp * hx + cp * hy
			// Radii too small to reach the end grow uniformly (F.6.6).
			let lambda = (x1p * x1p) / (rx * rx) + (y1p * y1p) / (ry * ry)
			if lambda > 1.0 {
				let s = sqrt(lambda)
				rx *= s
				ry *= s
			}
			let num = rx * rx * ry * ry - rx * rx * y1p * y1p - ry * ry * x1p * x1p
			let den = rx * rx * y1p * y1p + ry * ry * x1p * x1p
			let coef = sqrt((num / den).max(0.0))
			coef = -coef when large == sweep
			let cxp = coef * rx * y1p / ry
			let cyp = -coef * ry * x1p / rx
			let cx = cp * cxp - sp * cyp + (x0 + x) / 2.0
			let cy = sp * cxp + cp * cyp + (y0 + y) / 2.0
			let theta = atan2((y1p - cyp) / ry, (x1p - cxp) / rx)
			let end = atan2((-y1p - cyp) / ry, (-x1p - cxp) / rx)
			let dtheta = end - theta
			if sweep && dtheta < 0.0 {
				dtheta += Tau
			} else if !sweep && dtheta > 0.0 {
				dtheta -= Tau
			}
			appendArc(cx, cy, rx, ry, rotation, theta, dtheta)
			// Land exactly on the requested end point.
			pts[pts.len() - 2] = x
			pts[pts.len() - 1] = y
			curX = x
			curY = y
		}

		// Every line segment of this flattened path as x0, y0, x1, y1, closing
		// segments included; `closeOpen` closes open subpaths too, as filling
		// does.
		internal def edges(closeOpen bool = true) float[] {
			let out float[]
			let j = 0
			let (
				sx    = 0.0
				sy    = 0.0
				px    = 0.0
				py    = 0.0
				inSub = false
			)
			for let (_, op) in ops {
				match op {
					case PathVerb.Move:
						pushEdge(out, px, py, sx, sy) when inSub && closeOpen
						sx = pts[j]
						sy = pts[j + 1]
						px = sx
						py = sy
						inSub = true
						j += 2
					case PathVerb.Line:
						pushEdge(out, px, py, pts[j], pts[j + 1])
						px = pts[j]
						py = pts[j + 1]
						j += 2
					case PathVerb.Close:
						pushEdge(out, px, py, sx, sy)
						px = sx
						py = sy
						inSub = false
					default:
				}
			}
			pushEdge(out, px, py, sx, sy) when inSub && closeOpen
			return out
		}
	}

	// Appends the segment unless it has no length.
	internal def pushEdge(out float[], x0, y0, x1, y1 float) {
		return when x0 == x1 && y0 == y1
		out.push(x0)
		out.push(y0)
		out.push(x1)
		out.push(y1)
	}

	// The winding number of the edges (x0, y0, x1, y1 each) around (x, y).
	internal def winding(e float[], x, y float) int {
		let w = 0
		for let i = 0; i < e.len(); i += 4 {
			let (x0, y0, x1, y1) = (e[i], e[i + 1], e[i + 2], e[i + 3])
			let side = (x1 - x0) * (y - y0) - (x - x0) * (y1 - y0)
			if y0 <= y {
				w++ when y1 > y && side > 0.0
			} else if y1 <= y && side < 0.0 {
				w--
			}
		}
		return w
	}

	// The x and y radius a corner length gives on a w by h rectangle.
	internal def cornerRadii(r Pixels | Percent, w, h float) (float, float) {
		match r {
			case Percent:
				let p = float(r) / 100.0
				return ((w * p).max(0.0), (h * p).max(0.0))
			case Pixels:
				let v = float(r).max(0.0)
				return (v, v)
		}
		return (0.0, 0.0)
	}

	// (x, y) moved by t.
	internal def xform(t Transform2D, x, y float) (float, float) {
		return (x * t.a + y * t.c + t.tx, x * t.b + y * t.d + t.ty)
	}

	// One axis of a quadratic Bézier at t.
	internal def quadAt(p0, p1, p2, t float) float {
		let mt = 1.0 - t
		return mt * mt * p0 + 2.0 * mt * t * p1 + t * t * p2
	}

	// One axis of a cubic Bézier at t.
	internal def cubicAt(p0, p1, p2, p3, t float) float {
		let mt = 1.0 - t
		return mt * mt * mt * p0 + 3.0 * mt * mt * t * p1 + 3.0 * mt * t * t * p2 + t * t * t * p3
	}

	// Grows r to include (x, y).
	internal def grow(r Rect, x, y float) {
		r.left = r.left.min(x)
		r.top = r.top.min(y)
		r.right = r.right.max(x)
		r.bottom = r.bottom.max(y)
	}

	// Line segments for the quadratic from (x0, y0) into `out`, enough that
	// none strays more than `tol` from the curve.
	internal def flattenQuad(out Path, x0, y0, cx, cy, x1, y1, tol float) {
		let ddx = x0 - 2.0 * cx + x1
		let ddy = y0 - 2.0 * cy + y1
		let dd = sqrt(ddx * ddx + ddy * ddy)
		let n = int(sqrt(dd / (4.0 * tol)).ceil()).clamp(1, 1000)
		for let i = 1; i < n; i++ {
			let t = float(i) / float(n)
			let mt = 1.0 - t
			out.lineTo(mt * mt * x0 + 2.0 * mt * t * cx + t * t * x1, mt * mt * y0 + 2.0 * mt * t * cy + t * t * y1)
		}
		out.lineTo(x1, y1)
	}

	// Line segments for the cubic from (x0, y0) into `out`, within `tol`
	// (Wang's bound on the second derivative).
	internal def flattenCubic(out Path, x0, y0, ax, ay, bx, by, x1, y1, tol float) {
		let d1x = x0 - 2.0 * ax + bx
		let d1y = y0 - 2.0 * ay + by
		let d2x = ax - 2.0 * bx + x1
		let d2y = ay - 2.0 * by + y1
		let dd = sqrt(d1x * d1x + d1y * d1y).max(sqrt(d2x * d2x + d2y * d2y))
		let n = int(sqrt(0.75 * dd / tol).ceil()).clamp(1, 1000)
		for let i = 1; i < n; i++ {
			let t = float(i) / float(n)
			let mt = 1.0 - t
			let a = mt * mt * mt
			let b = 3.0 * mt * mt * t
			let c = 3.0 * mt * t * t
			let d = t * t * t
			out.lineTo(a * x0 + b * ax + c * bx + d * x1, a * y0 + b * ay + c * by + d * y1)
		}
		out.lineTo(x1, y1)
	}
}
