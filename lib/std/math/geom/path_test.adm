partial module std.math.geom {
	use (
		std.math::Pi
		std.testing
		std.units::(Percent, Pixels)
	)

	// The path's verbs and points as SVG-like text, for comparing in tests.
	internal def pathText(p Path) string {
		let parts string[]
		let j = 0
		for let (_, op) in p.verbs {
			let n = 0
			let letter = "Z"
			match op {
				case PathVerb.Move:
					letter = "M"
					n = 2
				case PathVerb.Line:
					letter = "L"
					n = 2
				case PathVerb.Quad:
					letter = "Q"
					n = 4
				case PathVerb.Cubic:
					letter = "C"
					n = 6
				default:
			}
			let nums string[]
			for let k = 0; k < n; k++ {
				let v = (p.coords[j + k] * 1000.0).round() / 1000.0
				nums.push(v == v.floor() ?? ("{int(v)}", "{v}"))
			}
			parts.push(letter + nums.join(" "))
			j += n
		}
		return parts.join(" ")
	}

	check "Path" {
		// Per-corner radii of mixed units: a union type argument to a
		// generic type.
		@test()
		def trimmedKeepsThePartBetween() {
			let line = new Path().moveTo(0.0, 0.0).lineTo(100.0, 0.0)
			let mid = line.trimmed(25(%), 75(%))
			let b = mid.bounds()
			assert (b.left - 25.0).abs() < 1e-9 && (b.right - 75.0).abs() < 1e-9 && (mid.length() - 50.0).abs() < 1e-9
			let square = new Path().rect(Rect{left: 0.0, top: 0.0, right: 100.0, bottom: 100.0})
			let half = square.trimmed(0(%), 50(%))
			let (end, _) = half.pointAt(half.length())
			assert (end.x - 100.0).abs() < 1e-9 && (end.y - 100.0).abs() < 1e-9
			assert half.verbs[half.verbs.len() - 1] != PathVerb.Close
			let all = square.trimmed(0(%), 100(%))
			assert all.verbs[all.verbs.len() - 1] == PathVerb.Close && (all.length() - 400.0).abs() < 1e-9
			// Two equal squares: the first half is the first square, whole.
			let two = new Path().rect(Rect{left: 0.0, top: 0.0, right: 10.0, bottom: 10.0}).rect(Rect{left: 20.0, top: 0.0, right: 30.0, bottom: 10.0})
			let first = two.trimmed(0(%), 50(%))
			assert first.bounds().right <= 10.0 + 1e-9 && first.verbs[first.verbs.len() - 1] == PathVerb.Close
			// Curves come out as lines of the same length, within the flattening.
			let circle = new Path().circle(new Point(0.0, 0.0), 10.0)
			assert (circle.trimmed(10(%), 60(%)).length() - circle.length() * 0.5).abs() < 0.01
			assert line.trimmed(60(%), 40(%)).isEmpty() && line.trimmed(30(%), 30(%)).isEmpty()
		}

		@test()
		def roundRectPerCorner() {
			let rect = Rect{left: 0.0, top: 0.0, right: 20.0, bottom: 10.0}
			let big = new Path().roundRect(rect, new Corners<Pixels | Percent>(100(px), 0(px)))
			assert big.contains(new Point(19.5, 0.5))
			assert !big.contains(new Point(0.5, 0.5))
		}

		def near(a, b float, eps float = 1e-6) bool {
			return (a - b).abs() <= eps
		}

		@test()
		def buildersChainAndWriteSvg() {
			let p = new Path().moveTo(0.0, 0.0).lineTo(10.0, 0.0).quadTo(15.0, 5.0, 10.0, 10.0).cubicTo(5.0, 12.0, 2.0, 12.0, 0.0, 10.0).close()
			assert pathText(p) == "M0 0 L10 0 Q15 5 10 10 C5 12 2 12 0 10 Z"
			assert p.verbs.len() == 5
			assert p.coords.len() == 14
			// A segment after a close starts again at the subpath's start.
			p.lineTo(5.0, 5.0)
			assert pathText(p).endsWith("Z M0 0 L5 5")
			// A line with no current point starts the path.
			assert pathText(new Path().lineTo(3.0, 4.0)) == "M3 4"
		}

		@test()
		def boundsFollowCurvesNotControls() {
			let c = new Path().circle(new Point(5.0, 5.0), 10.0).bounds()
			assert near(c.left, -5.0, 1e-3) && near(c.right, 15.0, 1e-3)
			assert near(c.top, -5.0, 1e-3) && near(c.bottom, 15.0, 1e-3)
			let q = new Path().moveTo(0.0, 0.0).quadTo(5.0, 10.0, 10.0, 0.0).bounds()
			assert near(q.bottom, 5.0)
			assert new Path().bounds().right == 0.0
		}

		@test()
		def containsUnderEachRule() {
			let p = new Path().rect(Rect{left: 0.0, top: 0.0, right: 10.0, bottom: 10.0}).rect(Rect{left: 2.0, top: 2.0, right: 8.0, bottom: 8.0})
			assert p.contains(new Point(5.0, 5.0))
			assert !p.contains(new Point(5.0, 5.0), FillRule.EvenOdd)
			assert p.contains(new Point(1.0, 1.0), FillRule.EvenOdd)
			assert !p.contains(new Point(11.0, 5.0))
			let circle = new Path().circle(new Point(0.0, 0.0), 10.0)
			assert circle.contains(new Point(7.0, 7.0))
			assert !circle.contains(new Point(7.2, 7.2))
			// An open subpath counts as closed.
			let open = new Path().moveTo(0.0, 0.0).lineTo(10.0, 0.0).lineTo(10.0, 10.0)
			assert open.contains(new Point(8.0, 2.0))
		}

		@test()
		def polygonContainsTakesTheRule() {
			// A pentagram: its centre winds twice.
			let star = new Polygon(Point[new Point(0.0, -10.0), new Point(6.0, 8.0), new Point(-9.5, -3.0), new Point(9.5, -3.0), new Point(-6.0, 8.0)])
			assert star.contains(new Point(0.0, 0.0))
			assert !star.contains(new Point(0.0, 0.0), FillRule.EvenOdd)
		}

		@test()
		def lengthAndPointAt() {
			let r = new Path().rect(Rect{left: 0.0, top: 0.0, right: 10.0, bottom: 5.0})
			assert near(r.length(), 30.0)
			let circle = new Path().circle(new Point(0.0, 0.0), 10.0)
			assert near(circle.length(), 2.0 * Pi * 10.0, 1e-2)
			let (p, t) = r.pointAt(12.0)
			assert near(p.x, 10.0) && near(p.y, 2.0)
			assert near(t.x, 0.0) && near(t.y, 1.0)
			let (end, _) = r.pointAt(100.0)
			assert near(end.x, 0.0) && near(end.y, 0.0)
		}

		@test()
		def arcsAndRoundRects() {
			// Canvas arcTo: a corner of radius 5 between the two lines.
			let a = new Path().moveTo(0.0, 0.0).arcTo(10.0, 0.0, 10.0, 10.0, 5.0)
			let (end, tangent) = a.pointAt(a.length())
			assert near(end.x, 10.0, 1e-3) && near(end.y, 5.0, 1e-3)
			assert near(tangent.y, 1.0, 1e-2)
			// A pie slice: centre, arc, back.
			let pie = new Path().moveTo(0.0, 0.0).arc(new Point(0.0, 0.0), 10.0, 0.0, Pi / 2.0).close()
			assert pie.contains(new Point(3.0, 3.0))
			assert !pie.contains(new Point(-3.0, 3.0))
			let rect = Rect{left: 0.0, top: 0.0, right: 20.0, bottom: 10.0}
			let rounded = new Path().roundRect(rect, 4(px))
			let b = rounded.bounds()
			assert near(b.left, 0.0) && near(b.right, 20.0) && near(b.bottom, 10.0)
			assert !rounded.contains(new Point(0.3, 0.3))
			assert rounded.contains(new Point(2.0, 2.0))
			// 50% on each axis makes an ellipse.
			let pill = new Path().roundRect(rect, 50(%))
			assert !pill.contains(new Point(1.5, 1.5))
			assert pill.contains(new Point(10.0, 0.5))
		}

		@test()
		def transformsAndAppends() {
			let p = new Path().rect(Rect{left: 0.0, top: 0.0, right: 1.0, bottom: 1.0})
			let t = new Transform2D(tx = 5.0, ty = 2.0)
			assert pathText(p.transformed(t)) == "M5 2 L6 2 L6 3 L5 3 Z"
			let both = new Path().add(p).add(p, t)
			assert both.verbs.len() == 10
			// Flattening leaves only moves, lines and closes.
			let flat = new Path().circle(new Point(0.0, 0.0), 100.0).flattened(0.25)
			for let (_, v) in flat.verbs {
				assert v != PathVerb.Quad && v != PathVerb.Cubic
			}
			assert flat.verbs.len() > 20
		}
	}

	check "Stroke" {
		def near(a, b float, eps float = 1e-6) bool {
			return (a - b).abs() <= eps
		}

		def line() Path {
			return new Path().moveTo(0.0, 0.0).lineTo(10.0, 0.0)
		}

		@test()
		def capsExtendTheEnds() {
			let butt = line().stroked(StrokeStyle{width: 2(px)})
			let b = butt.bounds()
			assert near(b.left, 0.0) && near(b.right, 10.0) && near(b.top, -1.0) && near(b.bottom, 1.0)
			assert butt.contains(new Point(5.0, 0.5))
			assert !butt.contains(new Point(5.0, 1.5))
			let square = line().stroked(StrokeStyle{width: 2(px), cap: LineCap.Square}).bounds()
			assert near(square.left, -1.0) && near(square.right, 11.0)
			let round = line().stroked(StrokeStyle{width: 2(px), cap: LineCap.Round})
			assert round.contains(new Point(-0.9, 0.0))
			assert !round.contains(new Point(-0.9, 0.9))
			assert near(round.bounds().left, -1.0, 1e-2)
		}

		@test()
		def joinsTurnCorners() {
			let corner = new Path().moveTo(0.0, 0.0).lineTo(10.0, 0.0).lineTo(10.0, 10.0)
			let miter = corner.stroked(StrokeStyle{width: 2(px)})
			assert miter.contains(new Point(10.9, -0.9))
			let bevel = corner.stroked(StrokeStyle{width: 2(px), join: LineJoin.Bevel})
			assert !bevel.contains(new Point(10.9, -0.9))
			assert bevel.contains(new Point(10.4, -0.4))
			let round = corner.stroked(StrokeStyle{width: 2(px), join: LineJoin.Round})
			assert round.contains(new Point(10.6, -0.6))
			assert !round.contains(new Point(10.9, -0.9))
			// A sharp turn past the miter limit bevels.
			let spike = new Path().moveTo(0.0, 0.0).lineTo(10.0, 0.0).lineTo(0.0, 1.0)
			let limited = spike.stroked(StrokeStyle{width: 2(px), miterLimit: 2.0})
			assert limited.bounds().right < 12.0
		}

		@test()
		def closedContoursLeaveTheHole() {
			let r = new Path().rect(Rect{left: 0.0, top: 0.0, right: 10.0, bottom: 10.0}).stroked(StrokeStyle{width: 2(px)})
			assert r.contains(new Point(0.0, 5.0))
			assert r.contains(new Point(-0.9, -0.9))
			assert !r.contains(new Point(5.0, 5.0))
			assert !r.contains(new Point(-1.5, 5.0))
		}

		@test()
		def zeroLengthSubpathsDrawDots() {
			let dot = new Path().moveTo(5.0, 5.0).lineTo(5.0, 5.0)
			assert dot.stroked(StrokeStyle{width: 4(px), cap: LineCap.Round}).contains(new Point(6.0, 6.0))
			assert dot.stroked(StrokeStyle{width: 4(px)}).isEmpty()
		}

		@test()
		def dashesCutThePath() {
			let d = line().dashed(float[2.0, 2.0])
			assert pathText(d) == "M0 0 L2 0 M4 0 L6 0 M8 0 L10 0"
			// An offset shifts the pattern; an odd count repeats it.
			assert pathText(line().dashed(float[2.0, 2.0], 1.0)) == "M0 0 L1 0 M3 0 L5 0 M7 0 L9 0"
			assert pathText(line().dashed(float[3.0])) == "M0 0 L3 0 M6 0 L9 0"
			// Nothing to cut with: the path comes back.
			assert pathText(line().dashed(float[])) == "M0 0 L10 0"
			// A dashed stroke through the style.
			let s = line().stroked(StrokeStyle{width: 2(px), dash: Pixels[2(px), 2(px)]})
			assert s.contains(new Point(1.0, 0.0))
			assert !s.contains(new Point(3.0, 0.0))
		}
	}
}
