partial module std.math.geom {
	use std.math::(*)

	// A location in 2D space. `T` is the coordinate type: `float` by default,
	// `int`/`uint` for pixel and grid geometry. Measures that are inherently
	// fractional (distances, angles) come back as `float` whatever `T` is.
	type Point<T: Numeric = float> {
		x T
		y T

		// Optional positional constructor
		def new(x T, y T) {
			self.x = x
			self.y = y
		}

		// Distance between points
		def distanceTo(other Point<T>) float {
			let dx = other.x - x
			let dy = other.y - y

			return sqrt(float(dx * dx + dy * dy))
		}

		// The squared distance to other, without the square root.
		def distanceSquared(other Point<T>) T {
			let dx = other.x - x
			let dy = other.y - y

			return dx * dx + dy * dy
		}

		// The same location with `float` coordinates.
		def toFloat() Point<float> {
			return new Point<float>(float(x), float(y))
		}

		// Convert to Vec2 (common pattern in geometry engines)
		def toVec2() Vec2 {
			return new Vec2(float(x), float(y))
		}

		// The displacement from this point to other, as a Vec2.
		def vectorTo(other Point<T>) Vec2 {
			return new Vec2(float(other.x - x), float(other.y - y))
		}

		// The point moved to the nearest location inside rect.
		def clampTo(rect Rectangle<T>) Point<T> {
			return new Point<T>(
				x.clamp(rect.left(), rect.right()),
				y.clamp(rect.top(), rect.bottom())
			)
		}

		// The distance to other along the axes, |dx| + |dy|.
		def manhattanDistance(other Point<T>) T {
			return (x - other.x).abs() + (y - other.y).abs()
		}

		// The dot product of the two points taken as vectors.
		def dot(other Point<T>) T {
			return x * other.x + y * other.y
		}

		// The cross product of the two points taken as vectors: x·other.y minus y·other.x.
		def cross(other Point<T>) T {
			return x * other.y - y * other.x
		}

		// The point moved by vx and vy.
		def translate(vx, vy T) Point<T> {
			return new Point<T>(x + vx, y + vy)
		}

		// Midpoint between two points
		def midpoint(other Point<T>) Point<T> {
			return new Point<T>((x + other.x) / 2, (y + other.y) / 2)
		}

		// Equality with epsilon tolerance
		def equalsEps(other Point<T>, eps float = 1e-9) bool {
			return float(x - other.x).abs() <= eps && float(y - other.y).abs() <= eps
		}

		// The point as text.
		def str() string {
			return "Point({x}, {y})"
		}

		where T is float {
			// Translate a point by a vector
			def translate(v Vec2) Point<T> {
				return new Point<T>(x + v.x, y + v.y)
			}

			// Linear interpolation between two points
			def lerp(other Point<T>, t float) Point<T> {
				return new Point<T>(x + (other.x - x) * t, y + (other.y - y) * t)
			}
		}
	}

	// Point3d is a location in three dimensions.
	type Point3d<T: Numeric = float> {
		x T
		y T
		z T

		def new(x T, y T, z T) {
			self.x = x
			self.y = y
			self.z = z
		}

		// The distance to other.
		def distanceTo(other Point3d<T>) float {
			let dx = other.x - x
			let dy = other.y - y
			let dz = other.z - z
			return sqrt(float(dx * dx + dy * dy + dz * dz))
		}

		// The squared distance to other, without the square root.
		def distanceSquared(other Point3d<T>) T {
			let dx = other.x - x
			let dy = other.y - y
			let dz = other.z - z
			return dx * dx + dy * dy + dz * dz
		}

		// The same location with `float` coordinates.
		def toFloat() Point3d<float> {
			return new Point3d<float>(float(x), float(y), float(z))
		}

		// The location as a Vec3.
		def toVec3() Vec3 {
			return new Vec3(float(x), float(y), float(z))
		}

		// The point halfway to other.
		def midpoint(other Point3d<T>) Point3d<T> {
			return new Point3d<T>(
				(x + other.x) / 2,
				(y + other.y) / 2,
				(z + other.z) / 2
			)
		}

		// Whether every coordinate is within eps of other's.
		def equalsEps(other Point3d<T>, eps float = 1e-9) bool {
			return float(x - other.x).abs() <= eps && float(y - other.y).abs() <= eps && float(z - other.z).abs() <= eps
		}

		// The point as text.
		def str() string {
			return "Point3d({x}, {y}, {z})"
		}

		where T is float {
			def translated(v Vec3) Point3d<T> {
				return new Point3d<T>(x + v.x, y + v.y, z + v.z)
			}

			def lerp(other Point3d<T>, t float) Point3d<T> {
				return new Point3d<T>(
					x + (other.x - x) * t,
					y + (other.y - y) * t,
					z + (other.z - z) * t
				)
			}
		}
	}
}
