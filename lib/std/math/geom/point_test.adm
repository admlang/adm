partial module std.math.geom {
	use (
		std.testing
		std.math
	)

	check "Point" {
		@test()
		def lerp() {
			let p1 = new Point(10.0, 20.0)
			let p2 = new Point(30.0, 50.0)

			let midpoint = p1.midpoint(p2)
			let lerp_midpoint = p1.lerp(p2, 0.5)

			assert midpoint.equalsEps(lerp_midpoint, 1e-9)
			assert midpoint.x == 20.0
			assert midpoint.y == 35.0

			let p3 = new Point(15.0, 25.0)
			let p4 = new Point(100.0, 200.0)

			let result = p3.lerp(p4, 0.0)
			assert result.equalsEps(p3, 1e-9)

			let result_end = p3.lerp(p4, 1.0)
			assert result_end.equalsEps(p4, 1e-9)
		}

		@test()
		def clampTo() {
			// inside rectangle

			// And left() -> x, right() -> x + width, top() -> y, bottom() -> y + height
			let rect = new Rectangle(position: new Point(0.0, 0.0), size: new Size(100.0, 100.0)) // A rectangle from (0,0) to (100,100)
			let point_inside = new Point(50.0, 50.0)
			let clamped_point = point_inside.clampTo(rect)
			// The point is already inside, so it should not change.
			assert clamped_point.equalsEps(point_inside, 1e-9)

			// outside rectangle
			rect = new Rectangle(position: new Point(0.0, 0.0), size: new Size(100.0, 100.0)) // A rectangle from (0,0) to (100,100)
			let point_outside = new Point(150.0, -50.0) // Outside on both axes (right and top)

			clamped_point = point_outside.clampTo(rect)

			// The point should be clamped to the nearest corner (100, 0).
			let expected_point = new Point(100.0, 0.0)
			assert clamped_point.equalsEps(expected_point, 1e-9)
		}

		@test()
		def cross() {
			// Two points are collinear with the origin if one is a scalar multiple of the other.
			// Their cross product should be zero.
			let p1 = new Point(2.0, 3.0)
			let p2 = new Point(4.0, 6.0) // p2 = 2 * p1
			assert math.approx(0.0, p1.cross(p2), 1e-9)

			// Another collinear case
			let p3 = new Point(-5.0, 1.0)
			let p4 = new Point(-15.0, 3.0) // p4 = 3 * p3
			assert math.approx(0.0, p3.cross(p4), 1e-9)

			// Test with non-collinear points to ensure it's not always zero
			let p5 = new Point(1.0, 0.0)
			let p6 = new Point(0.0, 1.0)
			assert math.approx(1.0, p5.cross(p6), 1e-9)
		}

		@test()
		def dot() {
			// Test with orthogonal points (dot product should be 0)
			let p1 = new Point(1.0, 0.0)
			let p2 = new Point(0.0, 1.0)
			assert math.approx(0.0, p1.dot(p2), 1e-9)

			// Another pair of orthogonal points
			let p3 = new Point(2.0, 3.0)
			let p4 = new Point(-3.0, 2.0)
			assert math.approx(0.0, p3.dot(p4), 1e-9)

			// Test with non-orthogonal points to ensure it's not always zero
			let p5 = new Point(1.0, 1.0)
			let p6 = new Point(2.0, 3.0)
			// Expected dot product: (1 * 2) + (1 * 3) = 5
			assert math.approx(5.0, p5.dot(p6), 1e-9)
		}

		@test()
		def equalsEps() {
			let p1 = new Point3d(10.0, 20.0, 30.0)
			let custom_eps = 1e-5

			// Create a point that differs by an amount larger than the custom epsilon
			let p2 = new Point3d(10.0, 20.0, 30.0 + 1e-4)
			assert !p1.equalsEps(p2, custom_eps)

			// Create a point that differs by an amount smaller than the custom epsilon
			let p3 = new Point3d(10.0, 20.0 + 1e-6, 30.0)
			assert p1.equalsEps(p3, custom_eps)

			// Test default epsilon for comparison
			let p4 = new Point3d(10.0 + 1e-10, 20.0, 30.0)
			assert p1.equalsEps(p4)

			let p5 = new Point3d(10.0, 20.0 - 1e-10, 30.0)
			assert p1.equalsEps(p5)
		}
	}

	check "Point3d" {
		@test()
		def distance() {
			// Test with identical points
			let p1 = new Point3d(10.0, 20.0, 30.0)
			let p2 = new Point3d(10.0, 20.0, 30.0)
			assert 0.0 == p1.distanceTo(p2)

			// Test distance along one axis
			let p3 = new Point3d(0.0, 0.0, 0.0)
			let p4 = new Point3d(5.0, 0.0, 0.0)
			assert 5.0 == p3.distanceTo(p4)

			// Test distance in a 2D plane (XY)
			let p5 = new Point3d(1.0, 2.0, 0.0)
			let p6 = new Point3d(4.0, 6.0, 0.0) // dx=3, dy=4, dz=0 -> distance = 5
			assert math.approx(5.0, p5.distanceTo(p6), 1e-9)

			// Test distance in 3D space
			let p7 = new Point3d(1.0, 2.0, 3.0)
			let p8 = new Point3d(4.0, 6.0, 15.0) // dx=3, dy=4, dz=12 -> d^2 = 9+16+144=169 -> d=13
			assert math.approx(13.0, p7.distanceTo(p8), 1e-9)

			// Test with negative coordinates
			let p9 = new Point3d(-1.0, -2.0, -3.0)
			let p10 = new Point3d(-4.0, -6.0, -15.0) // dx=-3, dy=-4, dz=-12 -> d^2 = 9+16+144=169 -> d=13
			assert math.approx(13.0, p9.distanceTo(p10), 1e-9)
		}
	}
}
