partial module std.math.geom {
	// Polygon is a closed shape given by its vertices in order.
	type Polygon<T: Numeric = float> {
		vertices Point<T>[]

		def new(vertices Point<T>[]) {
			self.vertices = vertices
		}

		// The number of vertices.
		def vertexCount() int {
			return vertices.len()
		}

		// The same polygon with `float` coordinates.
		def toFloat() Polygon<float> {
			let pts Point<float>[]
			for let (_, p) in vertices {
				pts += [p.toFloat()]
			}
			return new Polygon<float>(pts)
		}

		// The area, from the shoelace formula; sign follows the vertex order.
		def area() float {
			// Shoelace formula (signed area)
			let sum = 0.0
			let n = vertices.len()

			for let i = 0; i < n; i++ {
				let a = vertices[i]
				let b = vertices[(i + 1) % n]
				sum += float((a.x * b.y) - (b.x * a.y))
			}

			return sum / 2
		}

		// Whether the vertices run clockwise.
		def isClockwise() bool {
			return area() < 0
		}

		// Whether the vertices run counterclockwise.
		def isCounterClockwise() bool {
			return area() > 0
		}

		// triangulate cuts the polygon into triangles by ear clipping and
		// returns their corners as index triples into `vertices`, each
		// triangle in the polygon's own winding; a simple polygon of n
		// vertices gives at most n - 2 triangles, concave or not. A corner on
		// a straight edge is dropped when clipping reaches it rather than made
		// into an empty triangle; a polygon whose edges cross is cut as far as
		// its ears allow, then by fan. Fewer than 3 vertices give no
		// triangles.
		def triangulate() int[] {
			let n = vertices.len()
			let out int[]
			return out when n < 3
			let xs float[]
			let ys float[]
			xs.len(n)
			ys.len(n)
			for let i = 0; i < n; i++ {
				xs[i] = float(vertices[i].x)
				ys[i] = float(vertices[i].y)
			}
			// A degenerate polygon has no inside: fan it.
			let orientation = area()
			if orientation == 0 {
				for let i = 1; i + 1 < n; i++ {
					out.push(0)
					out.push(i)
					out.push(i + 1)
				}
				return out
			}
			let sign = orientation > 0 ?? (1.0, -1.0)
			// The remaining corners as a doubly linked ring.
			let prev int[]
			let next int[]
			prev.len(n)
			next.len(n)
			for let i = 0; i < n; i++ {
				prev[i] = (i + n - 1) % n
				next[i] = (i + 1) % n
			}
			let remaining = n
			let at = 0
			let tried = 0
			for remaining > 3 {
				let a = prev[at]
				let c = next[at]
				let turn = sign * ((xs[at] - xs[a]) * (ys[c] - ys[at]) - (ys[at] - ys[a]) * (xs[c] - xs[at]))
				let ear = false
				if turn == 0 {
					// A straight corner: drop it, it spans no triangle.
					ear = true
				} else if turn > 0 {
					ear = true
					let p = next[c]
					for p != a && ear {
						ear = !triangleHolds(xs, ys, a, at, c, p, sign)
						p = next[p]
					}
				}
				if ear {
					if turn != 0 {
						out.push(a)
						out.push(at)
						out.push(c)
					}
					next[a] = c
					prev[c] = a
					remaining--
					at = c
					tried = 0
					continue
				}
				at = c
				tried++
				if tried > remaining {
					// No ear is left (the edges cross): clip the corner anyway.
					out.push(a)
					out.push(at)
					out.push(c)
					next[a] = c
					prev[c] = a
					remaining--
					at = c
					tried = 0
				}
			}
			out.push(prev[at])
			out.push(at)
			out.push(next[at])
			return out
		}

		// triangleHolds reports whether corner p lies inside or on the edge of
		// the triangle a b c, which winds with `sign`; a corner at one of the
		// triangle's own vertices does not count.
		internal def triangleHolds(xs float[], ys float[], a int, b int, c int, p int, sign float) bool {
			let px = xs[p]
			let py = ys[p]
			return false when (px == xs[a] && py == ys[a]) || (px == xs[b] && py == ys[b]) || (px == xs[c] && py == ys[c])
			let ab = sign * ((xs[b] - xs[a]) * (py - ys[a]) - (ys[b] - ys[a]) * (px - xs[a]))
			let bc = sign * ((xs[c] - xs[b]) * (py - ys[b]) - (ys[c] - ys[b]) * (px - xs[b]))
			let ca = sign * ((xs[a] - xs[c]) * (py - ys[c]) - (ys[a] - ys[c]) * (px - xs[c]))
			return ab >= 0 && bc >= 0 && ca >= 0
		}

		// Area-weighted centroid; fractional for any `T`.
		def centroid() Point<float> {
			let cx = 0.0
			let cy = 0.0
			let a = area()
			let n = vertices.len()

			let factor = 0.0
			for let i = 0; i < n; i++ {
				let p0 = vertices[i].toFloat()
				let p1 = vertices[(i + 1) % n].toFloat()
				factor = (p0.x * p1.y - p1.x * p0.y)
				cx += (p0.x + p1.x) * factor
				cy += (p0.y + p1.y) * factor
			}

			let k = 1.0 / (6.0 * a)
			return new Point<float>(cx * k, cy * k)
		}

		// The segments between consecutive vertices, the last one closing the shape.
		def edges() Line<T>[] {
			let n = vertices.len()
			let result Line<T>[]

			for let i = 0; i < n; i++ {
				result += [
					new Line<T>(
						start = vertices[i],
						end   = vertices[(i + 1) % n]
					)
				]
			}

			return result
		}

		// Whether the point lies inside the polygon under the rule, which
		// only matters when the polygon crosses itself.
		def contains(point Point<T>, rule FillRule = FillRule.NonZero) bool {
			// Winding number, in float so integer polygons do not truncate
			// the edge crossing.
			let w = 0
			let n = vertices.len()
			let px = float(point.x)
			let py = float(point.y)
			let j = n - 1
			for let i = 0; i < n; i++ {
				let a = vertices[j].toFloat()
				let b = vertices[i].toFloat()
				let side = (b.x - a.x) * (py - a.y) - (px - a.x) * (b.y - a.y)
				if a.y <= py {
					w++ when b.y > py && side > 0.0
				} else if b.y <= py && side < 0.0 {
					w--
				}
				j = i
			}
			return rule == FillRule.NonZero ?? (w != 0, w % 2 != 0)
		}

		// Whether the segment crosses any edge.
		def intersects(line Line<T>) bool {
			// Any edge intersects
			for let (_, edge) in edges() {
				if edge.intersects(line) {
					return true
				}
			}

			// Or line completely inside
			return contains(line.start)
		}

		// Every point where the segment crosses an edge.
		def intersection(line Line<T>) Point<float>[] {
			let points Point<float>[]

			for let (_, edge) in edges() {
				let p = edge.intersection(line)
				if p is Point {
					let any = points.find(q => q.equalsEps(p))
					if any is none {
						points += [p]
					}
				}
			}

			return points
		}

		// Whether the circle overlaps the polygon.
		def intersects(circle Circle<T>) bool {
			// Edge intersection
			for let (_, edge) in edges() {
				if circle.intersects(edge) {
					return true
				}
			}

			// Or circle center inside polygon
			return contains(circle.center)
		}

		// Whether the rectangle overlaps the polygon.
		def intersects(rect Rectangle<T>) bool {
			// Rectangle edges
			for let (_, edge) in rect.edges() {
				if intersects(edge) {
					return true
				}
			}

			// Containment cases
			return contains(rect.center()) || rect.contains(vertices[0])
		}

		// The smallest axis-aligned rectangle holding every vertex.
		def boundingBox() Rectangle<T> {
			let minX = vertices[0].x
			let minY = vertices[0].y
			let maxX = minX
			let maxY = minY

			for let (_, p) in vertices {
				minX = minX.min(p.x)
				minY = minY.min(p.y)
				maxX = maxX.max(p.x)
				maxY = maxY.max(p.y)
			}

			return new Rectangle<T>(
				position = new Point<T>(minX, minY),
				size     = new Size<T>(maxX - minX, maxY - minY)
			)
		}

		// A transform produces fractional coordinates for any `T`.
		def transformed(t Transform2D) Polygon<float> {
			let pts Point<float>[]
			for let (_, p) in vertices {
				pts += [t.apply(p.toFloat())]
			}
			return new Polygon<float>(pts)
		}
	}
}
