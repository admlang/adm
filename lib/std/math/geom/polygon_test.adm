partial module std.math.geom {
	use std.testing

	check "Polygon" {
		def polygon(coords float[]) Polygon<float> {
			let points Point<float>[]
			for let i = 0; i + 1 < coords.len(); i += 2 {
				points.push(new Point(coords[i], coords[i + 1]))
			}
			return new Polygon<float>(points)
		}

		// The signed area of the triangle at a triple of the result.
		def triangleArea(p Polygon<float>, tris int[], t int) float {
			let a = p.vertices[tris[t]]
			let b = p.vertices[tris[t + 1]]
			let c = p.vertices[tris[t + 2]]
			return ((b.x - a.x) * (c.y - a.y) - (b.y - a.y) * (c.x - a.x)) / 2
		}

		// Whether the triangles cover the polygon's area, each in its winding.
		def covers(p Polygon<float>, tris int[]) bool {
			let sum = 0.0
			let sign = p.area() > 0 ?? (1.0, -1.0)
			for let t = 0; t + 2 < tris.len(); t += 3 {
				let area = triangleArea(p, tris, t)
				return false when area * sign < 0
				sum += area
			}
			return (sum - p.area()).abs() < 1e-9
		}

		@test()
		def TestTriangulate() {
			// A convex square, both windings.
			let square = polygon(float[0, 0, 1, 0, 1, 1, 0, 1])
			let tris = square.triangulate()
			assert tris.len() == 6 && covers(square, tris)
			let clockwise = polygon(float[0, 0, 0, 1, 1, 1, 1, 0])
			let ctris = clockwise.triangulate()
			assert ctris.len() == 6 && covers(clockwise, ctris)

			// A concave L: 6 corners, 4 triangles, none across the notch.
			let l = polygon(float[0, 0, 2, 0, 2, 1, 1, 1, 1, 2, 0, 2])
			let ltris = l.triangulate()
			assert ltris.len() == 12 && covers(l, ltris)

			// A star-shaped concave polygon of 8 corners.
			let star = polygon(float[0, 3, 1, 1, 3, 0, 1, -1, 0, -3, -1, -1, -3, 0, -1, 1])
			let stris = star.triangulate()
			assert stris.len() == 18 && covers(star, stris)

			// A corner on a straight edge never makes an empty triangle.
			let mid = polygon(float[0, 0, 1, 0, 2, 0, 2, 2, 0, 2])
			let mtris = mid.triangulate()
			assert covers(mid, mtris)
			for let t = 0; t + 2 < mtris.len(); t += 3 {
				assert triangleArea(mid, mtris, t) != 0
			}
			// The straight corner itself is dropped when it is met first.
			let first = polygon(float[1, 0, 2, 0, 2, 2, 0, 2, 0, 0])
			let ftris = first.triangulate()
			assert ftris.len() == 6 && covers(first, ftris)

			// Too few corners, and a flat polygon fanned.
			assert polygon(float[0, 0, 1, 1]).triangulate().len() == 0
			assert polygon(float[0, 0, 1, 0, 2, 0, 3, 0]).triangulate().len() == 6
		}
	}
}
