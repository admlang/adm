partial module std.math.geom {
	use std.math::(*)

	// Quaternion is a rotation in 3D space: the vector part x, y, z and the
	// scalar w of a unit quaternion. The default is the identity, no rotation.
	type Quaternion {
		x float = 0.0
		y float = 0.0
		z float = 0.0
		w float = 1.0

		// The identity rotation.
		def new() {}

		def new(x float, y float, z float, w float) {
			self.x = x
			self.y = y
			self.z = z
			self.w = w
		}

		// The rotation of angle radians about the axis, which need not be unit
		// length.
		def new(axis Vec3, angle float) {
			let n = axis.normalized()
			let s = sin(angle / 2)
			x = n.x * s
			y = n.y * s
			z = n.z * s
			w = cos(angle / 2)
		}

		// The rotation of the matrix's upper-left 3×3, its scale divided out
		// (a mirrored basis has its z axis flipped first).
		def new(m matrix<float, 4, 4>) {
			let sx = sqrt(m[0][0] * m[0][0] + m[1][0] * m[1][0] + m[2][0] * m[2][0])
			let sy = sqrt(m[0][1] * m[0][1] + m[1][1] * m[1][1] + m[2][1] * m[2][1])
			let sz = sqrt(m[0][2] * m[0][2] + m[1][2] * m[1][2] + m[2][2] * m[2][2])
			if sx == 0 || sy == 0 || sz == 0 {
				w = 1.0
				return
			}
			let det = m[0][0] * (m[1][1] * m[2][2] - m[1][2] * m[2][1]) - m[0][1] * (m[1][0] * m[2][2] - m[1][2] * m[2][0]) + m[0][2] * (m[1][0] * m[2][1] - m[1][1] * m[2][0])
			sz = -sz when det < 0
			let r00 = m[0][0] / sx
			let r10 = m[1][0] / sx
			let r20 = m[2][0] / sx
			let r01 = m[0][1] / sy
			let r11 = m[1][1] / sy
			let r21 = m[2][1] / sy
			let r02 = m[0][2] / sz
			let r12 = m[1][2] / sz
			let r22 = m[2][2] / sz
			let trace = r00 + r11 + r22
			if trace > 0 {
				let s = sqrt(trace + 1.0) * 2
				w = 0.25 * s
				x = (r21 - r12) / s
				y = (r02 - r20) / s
				z = (r10 - r01) / s
			} else if r00 > r11 && r00 > r22 {
				let s = sqrt(1.0 + r00 - r11 - r22) * 2
				w = (r21 - r12) / s
				x = 0.25 * s
				y = (r01 + r10) / s
				z = (r02 + r20) / s
			} else if r11 > r22 {
				let s = sqrt(1.0 + r11 - r00 - r22) * 2
				w = (r02 - r20) / s
				x = (r01 + r10) / s
				y = 0.25 * s
				z = (r12 + r21) / s
			} else {
				let s = sqrt(1.0 + r22 - r00 - r11) * 2
				w = (r10 - r01) / s
				x = (r02 + r20) / s
				y = (r12 + r21) / s
				z = 0.25 * s
			}
		}

		// The length; 1 for a rotation.
		def length() float {
			return sqrt(x * x + y * y + z * z + w * w)
		}

		// The quaternion scaled to length 1; a zero quaternion becomes the
		// identity.
		def normalized() Quaternion {
			let len = length()
			return new Quaternion() when len == 0
			return new Quaternion(x / len, y / len, z / len, w / len)
		}

		// The inverse rotation of a unit quaternion.
		def conjugate() Quaternion {
			return new Quaternion(-x, -y, -z, w)
		}

		// The inverse rotation; the identity for a zero quaternion.
		def inverse() Quaternion {
			let n = x * x + y * y + z * z + w * w
			return new Quaternion() when n == 0
			return new Quaternion(-x / n, -y / n, -z / n, w / n)
		}

		// The rotation that applies other first, then this one.
		infix def * (other Quaternion) Quaternion {
			return new Quaternion(
				w * other.x + x * other.w + y * other.z - z * other.y,
				w * other.y - x * other.z + y * other.w + z * other.x,
				w * other.z + x * other.y - y * other.x + z * other.w,
				w * other.w - x * other.x - y * other.y - z * other.z
			)
		}

		// The vector rotated.
		def rotate(v Vec3) Vec3 {
			// v + 2w(q × v) + 2 q × (q × v), with q the vector part.
			let cx = y * v.z - z * v.y
			let cy = z * v.x - x * v.z
			let cz = x * v.y - y * v.x
			let ccx = y * cz - z * cy
			let ccy = z * cx - x * cz
			let ccz = x * cy - y * cx
			return new Vec3(v.x + 2 * (w * cx + ccx), v.y + 2 * (w * cy + ccy), v.z + 2 * (w * cz + ccz))
		}

		// The dot product with other.
		def dot(other Quaternion) float {
			return x * other.x + y * other.y + z * other.z + w * other.w
		}

		// Spherical linear interpolation towards other, t in 0..1, along the
		// shorter arc.
		def slerp(other Quaternion, t float) Quaternion {
			let d = dot(other)
			let ox = other.x
			let oy = other.y
			let oz = other.z
			let ow = other.w
			if d < 0 {
				d = -d
				ox = -ox
				oy = -oy
				oz = -oz
				ow = -ow
			}
			let a = 1.0 - t
			let b = t
			if d < 0.9995 {
				let theta = acos(d.min(1.0))
				let s = sin(theta)
				a = sin(a * theta) / s
				b = sin(b * theta) / s
			}
			return new Quaternion(a * x + b * ox, a * y + b * oy, a * z + b * oz, a * w + b * ow).normalized()
		}

		// The rotation as a column-major 4×4 matrix.
		def matrix() matrix<float, 4, 4> {
			let m = matrix<float, 4, 4>[]
			m[0][0] = 1 - 2 * (y * y + z * z)
			m[0][1] = 2 * (x * y - w * z)
			m[0][2] = 2 * (x * z + w * y)
			m[1][0] = 2 * (x * y + w * z)
			m[1][1] = 1 - 2 * (x * x + z * z)
			m[1][2] = 2 * (y * z - w * x)
			m[2][0] = 2 * (x * z - w * y)
			m[2][1] = 2 * (y * z + w * x)
			m[2][2] = 1 - 2 * (x * x + y * y)
			m[3][3] = 1
			return m
		}

		// The rotation as Euler angles in radians about x, y and z, applied in
		// that order (the matrix Rz · Ry · Rx).
		def euler() Vec3 {
			let m = matrix()
			let sy = (-m[2][0]).clamp(-1.0, 1.0)
			let b = atan2(sy, sqrt(1.0 - sy * sy))
			// Near ±90° about y the x and z rotations are one: all of it goes to z.
			return new Vec3(0.0, b, atan2(-m[0][1], m[1][1])) when sy.abs() > 0.999999
			return new Vec3(atan2(m[2][1], m[2][2]), b, atan2(m[1][0], m[0][0]))
		}

		// Whether every component is within eps of other's.
		def equalsEps(other Quaternion, eps float = 1e-9) bool {
			return (x - other.x).abs() <= eps && (y - other.y).abs() <= eps && (z - other.z).abs() <= eps && (w - other.w).abs() <= eps
		}

		// The quaternion as text.
		def str() string {
			return "Quaternion({x}, {y}, {z}, {w})"
		}
	}
}
