partial module std.math.geom {
	use std.math

	struct RaycastHit<T: Shape> {
		point    Point
		normal   Vec2
		distance float
		shape    T
	}

	type Ray {
		origin    Point
		direction Vec2

		def new(origin Point, direction Vec2) {
			self.origin = origin
			self.direction = direction.normalized()
		}

		// Point at distance t along the ray
		def at(t float) Point {
			return origin.translate(direction.mul(t))
		}

		def intersects(circle Circle) bool {
			return !(intersection(circle) is none)
		}

		def intersection(circle Circle) ?Point {
			// Ray: P = O + tD, t >= 0
			let f = origin.vectorTo(circle.center)
			let a = direction.dot(direction)
			let b = -2 * f.dot(direction)
			let c = f.dot(f) - circle.radius * circle.radius

			let disc = b * b - 4 * a * c
			if disc < 0 {
				return none
			}

			let sqrtDisc = math.sqrt(disc)
			let t1 = (-b - sqrtDisc) / (2 * a)
			let t2 = (-b + sqrtDisc) / (2 * a)

			// pick nearest valid hit
			let t = minPositive(t1, t2)
			return none when t is none

			return at(t)
		}

		def intersects(rect Rectangle) bool {
			return !(intersection(rect) is none)
		}

		def intersection(rect Rectangle) ?Point {
			// Slab method (standard, fast, robust)
			let tx1 = (rect.left() - origin.x) / direction.x
			let tx2 = (rect.right() - origin.x) / direction.x

			let tmin = tx1.min(tx2)
			let tmax = tx1.max(tx2)

			let ty1 = (rect.top() - origin.y) / direction.y
			let ty2 = (rect.bottom() - origin.y) / direction.y

			tmin = tmin.max(ty1.min(ty2))
			tmax = tmax.min(ty1.max(ty2))

			if tmax < tmin.max(0.0) {
				return none
			}

			let t = tmin >= 0 ?? (tmin, tmax)
			return at(t)
		}

		def intersects(line Line) bool {
			return !(intersection(line) is none)
		}

		def intersection(line Line) ?Point {
			// Ray–segment intersection
			let perp Vec2 = direction.perp()
			let v1 Vec2 = origin.vectorTo(line.start)
			let v2 Vec2 = line.start.vectorTo(line.end)

			let dot = v2.dot(perp)
			if dot.abs() < 1e-9 {
				return none
			}

			let t1 = v2.cross(v1) / dot
			let t2 = v1.dot(perp) / dot

			if t1 >= 0 && t2 >= 0 && t2 <= 1 {
				return at(t1)
			}

			return none
		}

		internal def minPositive(a float, b float) ?float {
			if a >= 0 && b >= 0 {
				return a.min(b)
			}
			if a >= 0 {
				return a
			}
			if b >= 0 {
				return b
			}
			return none
		}

		def cast(line Line) ?RaycastHit<Line> {
			let perp Vec2 = direction.perp()
			let v1 Vec2 = line.start.vectorTo(origin)
			let v2 Vec2 = line.start.vectorTo(line.end)

			let denom = v2.dot(perp)
			if denom.abs() < 1e-9 {
				return none
			}

			let tRay = v2.cross(v1) / denom
			let tLine = v1.dot(perp) / denom

			if tRay < 0 || tLine < 0 || tLine > 1 {
				return none
			}

			let p = at(tRay)

			let edgeDir = v2.normalized()
			let normal = new Vec2(-edgeDir.y, edgeDir.x)

			return RaycastHit<Line>{
				point: p,
				normal: normal,
				distance: tRay,
				shape: line
			}
		}

		def cast(rect Rectangle) ?RaycastHit<Rectangle> {
			let tx1 = (rect.left() - origin.x) / direction.x
			let tx2 = (rect.right() - origin.x) / direction.x

			let tmin = tx1.min(tx2)
			let tmax = tx1.max(tx2)

			let ty1 = (rect.top() - origin.y) / direction.y
			let ty2 = (rect.bottom() - origin.y) / direction.y

			tmin = tmin.max(ty1.min(ty2))
			tmax = tmax.min(ty1.max(ty2))

			if tmax < tmin || tmax < 0 {
				return none
			}

			let t = tmin >= 0 ?? (tmin, tmax)
			let p = at(t)

			// determine normal
			let eps = 1e-6
			let normal Vec2 = new Vec2(0, 1)
			normal = new Vec2(-1, 0) when (p.x - rect.left()).abs() <= eps
			normal = new Vec2(1, 0) when (p.x - rect.right()).abs() <= eps
			normal = new Vec2(0, -1) when (p.y - rect.top()).abs() <= eps

			return RaycastHit<Rectangle>{
				point: p,
				normal: normal,
				distance: t,
				shape: rect
			}
		}

		def cast(circle Circle) ?RaycastHit<Circle> {
			let f = origin.vectorTo(circle.center)

			let a = direction.dot(direction)
			let b = -2 * f.dot(direction)
			let c = f.dot(f) - circle.radius * circle.radius

			let disc = b * b - 4 * a * c
			if disc < 0 {
				return none
			}

			let sqrtDisc = math.sqrt(disc)
			let t1 = (-b - sqrtDisc) / (2 * a)
			let t2 = (-b + sqrtDisc) / (2 * a)

			let t = minPositive(t1, t2)
			if t is none {
				return none
			}

			let p = at(t)
			let normal = circle.center.vectorTo(p).normalized()

			return RaycastHit<Circle>{
				point: p,
				normal: normal,
				distance: t,
				shape: circle
			}
		}

		def cast(poly Polygon) ?RaycastHit<Polygon> {
			let best ?RaycastHit<Polygon> = none
			let bestT = 0.0

			for let (_, edge) in poly.edges() {
				let hit = cast(edge)
				if hit is RaycastHit {
					if hit.distance >= 0 && (best is none || hit.distance < bestT) {
						bestT = hit.distance
						best = RaycastHit<Polygon>{
							point: hit.point,
							normal: hit.normal,
							distance: hit.distance,
							shape: poly
						}
					}
				}
			}

			return best
		}
	}
}
