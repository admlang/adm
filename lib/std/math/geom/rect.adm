partial module std.math.geom {
	// Rect is a rectangle stored as its edges: left, top, right, bottom.
	type Rect<T: Numeric = float> {
		left, top, right, bottom T

		width T {
			def get() T {
				return right - left
			}
		}

		height T {
			def get() T {
				return bottom - top
			}
		}

		center Point {
			def get() Point {
				return new Point((float(left) + float(right)) / 2, (float(top) + float(bottom)) / 2)
			}
		}

		// The same rectangle with `float` edges: a `Rect<Pixels>` as the plain numbers a
		// canvas draws with.
		def toFloat() Rect<float> {
			return Rect<float>{left: float(left), top: float(top), right: float(right), bottom: float(bottom)}
		}
	}
}
