partial module std.math.geom {
	use (
		std.testing
		std.units::Pixels
	)

	check "Rect" {
		// A rectangle in a unit becomes the same edges as plain numbers; its width and
		// height follow.
		@test()
		def toFloatKeepsTheEdges() {
			let area = Rect<Pixels>{left: 2(px), top: 3.5(px), right: 12(px), bottom: 9(px)}
			let plain = area.toFloat()
			assert plain.left == 2.0 && plain.top == 3.5 && plain.right == 12.0 && plain.bottom == 9.0
			assert plain.width == 10.0 && plain.height == 5.5
			let whole = Rect<int>{left: 1, top: 2, right: 4, bottom: 8}.toFloat()
			assert whole.width == 3.0 && whole.height == 6.0
		}
	}
}
