partial module std.math.geom {
	use std.math::(*)

	// Rectangle is an axis-aligned rectangle given by its top-left position and size.
	//
	// ```
	// let r = new Rectangle(position = new Point(0.0, 0.0), size = new Size(4.0, 2.0))
	// r.contains(new Point(1.0, 1.0))   // true
	// r.area()                           // 8
	// ```
	type Rectangle<T: Numeric = float> {
		position Point<T>
		size     Size<T>

		// The same rectangle with `float` coordinates.
		def toFloat() Rectangle<float> {
			return new Rectangle<float>(
				position = position.toFloat(),
				size     = new Size<float>(float(size.width), float(size.height))
			)
		}

		// Whether the point lies inside or on the rectangle.
		def contains(point Point<T>) bool {
			return position.x <= point.x && position.x + size.width >= point.x && position.y <= point.y && position.y + size.height >= point.y
		}

		// Whether the other rectangle lies entirely inside this one.
		def contains(rect Rectangle<T>) bool {
			return (rect.left() >= left()) && (rect.right() <= right()) && (rect.top() >= top()) && (rect.bottom() <= bottom())
		}

		// Whether the two rectangles overlap.
		def intersects(other Rectangle<T>) bool {
			return left() < other.right() && right() > other.left() && top() < other.bottom() && bottom() > other.top()
		}

		// Whether the segment crosses or lies inside the rectangle.
		def intersects(line Line<T>) bool {
			// If either endpoint is inside, it's an intersection
			return true when contains(line.start) || contains(line.end)

			// Otherwise test against edges
			for let (_, edge) in edges() {
				return true when edge.intersects(line)
			}

			return false
		}

		// The overlap of the two rectangles, or none when they do not overlap.
		def intersection(other Rectangle<T>) ?Rectangle<T> {
			let x1 = left().max(other.left())
			let y1 = top().max(other.top())
			let x2 = right().min(other.right())
			let y2 = bottom().min(other.bottom())

			return none when x2 <= x1 || y2 <= y1

			return new Rectangle<T>(
				position = new Point<T>(x1, y1),
				size = new Size<T>(x2 - x1, y2 - y1)
			)
		}

		// Where the segment crosses the edges; fractional for any `T`.
		def intersection(line Line<T>) Point<float>[] {
			let points Point<float>[]

			// Check edge intersections
			for let (_, edge) in edges() {
				let p = edge.intersection(line)
				if p is Point {
					// avoid duplicates (corner hits)
					points += [p] unless points.includes(p)
				}
			}

			// If no edge hits but line is inside rectangle
			return Point<float>[line.start.toFloat(), line.end.toFloat()] when points.isEmpty() && contains(line.start) && contains(line.end)

			return points
		}

		// The four sides as segments: top, right, bottom, left.
		def edges() Line<T>[] {
			let tl = topLeft()
			let tr = topRight()
			let bl = bottomLeft()
			let br = bottomRight()

			return Line<T>[
				new Line<T>(start=tl, end=tr),
				new Line<T>(start=tr, end=br),
				new Line<T>(start=br, end=bl),
				new Line<T>(start=bl, end=tl)
			]
		}

		// Grow equally on all sides by the given amount
		def inflate(inset T) Rectangle<T> {
			position.x -= inset
			position.y -= inset
			size.width += 2 * inset
			size.height += 2 * inset
			return self
		}

		// The four corners as points, clockwise from the top-left.
		def toPolygon() Point<T>[] {
			return Point<T>[
				new Point<T>(position.x, position.y),
				new Point<T>(position.x + size.width, position.y),
				new Point<T>(position.x + size.width, position.y + size.height),
				new Point<T>(position.x, position.y + size.height)
			]
		}

		// The rectangle with a negative width or height folded into the position, so
		// both are positive. Changes the rectangle in place and returns it.
		def normalized() Rectangle<T> {
			if size.width < 0 {
				position.x += size.width
				size.width = -size.width
			}
			if size.height < 0 {
				position.y += size.height
				size.height = -size.height
			}
			return self
		}

		// Splits into a top and a bottom part at `ratio` of the height: the top part
		// takes `ratio` of the height, the bottom part the rest. Both are new
		// rectangles; the receiver is unchanged.
		def splitHorizontal(ratio float) (Rectangle<T>, Rectangle<T>) {
			let topHeight = T(float(size.height) * ratio)
			return (
				new Rectangle<T>(position = new Point<T>(position.x, position.y), size = new Size<T>(size.width, topHeight)),
				new Rectangle<T>(position = new Point<T>(position.x, position.y + topHeight), size = new Size<T>(size.width, size.height - topHeight))
			)
		}

		// Splits into a left and a right part at `ratio` of the width: the left part
		// takes `ratio` of the width, the right part the rest. Both are new
		// rectangles; the receiver is unchanged.
		def splitVertical(ratio float) (Rectangle<T>, Rectangle<T>) {
			let leftWidth = T(float(size.width) * ratio)
			return (
				new Rectangle<T>(position = new Point<T>(position.x, position.y), size = new Size<T>(leftWidth, size.height)),
				new Rectangle<T>(position = new Point<T>(position.x + leftWidth, position.y), size = new Size<T>(size.width - leftWidth, size.height))
			)
		}

		// The shortest distance from the point to the rectangle; 0 when the point
		// lies inside or on it.
		def distanceTo(point Point<T>) float {
			return point.clampTo(self).distanceTo(point)
		}

		// The shortest distance between the two rectangles; 0 when they touch or
		// overlap.
		def distanceTo(rect Rectangle<T>) float {
			let dx = float(rect.left() - right()).max(float(left() - rect.right())).max(0.0)
			let dy = float(rect.top() - bottom()).max(float(top() - rect.bottom())).max(0.0)
			return sqrt(dx * dx + dy * dy)
		}

		// Divides the rectangle into n equal rows, top to bottom. With an integer
		// `T` the rows tile the height exactly, so the last one takes the
		// remainder. Empty when n is 0 or less.
		def rows(n int) Rectangle<T>[] {
			let out Rectangle<T>[]
			return out when n <= 0
			for let i in 0..n {
				let top = position.y + size.height * T(i) / T(n)
				let bottom = position.y + size.height * T(i + 1) / T(n)
				out.push(new Rectangle<T>(position = new Point<T>(position.x, top), size = new Size<T>(size.width, bottom - top)))
			}
			return out
		}

		// Divides the rectangle into n equal columns, left to right. With an
		// integer `T` the columns tile the width exactly, so the last one takes
		// the remainder. Empty when n is 0 or less.
		def columns(n int) Rectangle<T>[] {
			let out Rectangle<T>[]
			return out when n <= 0
			for let i in 0..n {
				let left = position.x + size.width * T(i) / T(n)
				let right = position.x + size.width * T(i + 1) / T(n)
				out.push(new Rectangle<T>(position = new Point<T>(left, position.y), size = new Size<T>(right - left, size.height)))
			}
			return out
		}

		// Divides the rectangle into rows times cols equal cells, row by row from
		// the top-left. Empty when either count is 0 or less.
		def grid(rows, cols int) Rectangle<T>[] {
			let out Rectangle<T>[]
			for let (_, row) in self.rows(rows) {
				for let (_, cell) in row.columns(cols) {
					out.push(cell)
				}
			}
			return out
		}

		// The area, width times height.
		def area() T {
			return size.width * size.height
		}

		// The perimeter, twice the width plus twice the height.
		def perimeter() T {
			return 2 * (size.width + size.height)
		}

		// The top-left corner.
		def topLeft() Point<T> {
			return position
		}

		// The top-right corner.
		def topRight() Point<T> {
			return new Point<T>(position.x + size.width, position.y)
		}

		// The bottom-left corner.
		def bottomLeft() Point<T> {
			return new Point<T>(position.x, position.y + size.height)
		}

		// The bottom-right corner.
		def bottomRight() Point<T> {
			return new Point<T>(position.x + size.width, position.y + size.height)
		}

		// The x coordinate of the left edge.
		def left() T {
			return position.x
		}

		// The x coordinate of the right edge.
		def right() T {
			return position.x + size.width
		}

		// The y coordinate of the top edge.
		def top() T {
			return position.y
		}

		// The y coordinate of the bottom edge.
		def bottom() T {
			return position.y + size.height
		}

		// Returns the center point of the rectangle.
		def center() Point<T> {
			return new Point<T>(position.x + size.width / 2, position.y + size.height / 2)
		}

		// The rectangle moved by dx and dy.
		def translate(dx, dy T) Rectangle<T> {
			position.x += dx
			position.y += dy
			return self
		}

		// Scales the rectangle to the largest size that fits inside container while
		// keeping its aspect ratio, and centers it there. A rectangle with no area
		// is only centered. Changes the rectangle in place and returns it.
		def fitInside(container Rectangle<T>) Rectangle<T> {
			return alignCenter(container) when size.isEmpty()
			let scale = (float(container.size.width) / float(size.width)).min(float(container.size.height) / float(size.height))
			return scaleBy(scale).alignCenter(container)
		}

		// Scales the rectangle to the smallest size that covers container while
		// keeping its aspect ratio, and centers it there, so the parts outside
		// container are what cropping would remove. A rectangle with no area is
		// only centered. Changes the rectangle in place and returns it.
		def fill(container Rectangle<T>) Rectangle<T> {
			return alignCenter(container) when size.isEmpty()
			let scale = (float(container.size.width) / float(size.width)).max(float(container.size.height) / float(size.height))
			return scaleBy(scale).alignCenter(container)
		}

		// Makes the rectangle coincide with container, ignoring its aspect ratio.
		// Changes the rectangle in place and returns it.
		def stretchTo(container Rectangle<T>) Rectangle<T> {
			position.x = container.position.x
			position.y = container.position.y
			size.width = container.size.width
			size.height = container.size.height
			return self
		}

		// Multiplies width and height by factor.
		internal def scaleBy(factor float) Rectangle<T> {
			size.width = T(float(size.width) * factor)
			size.height = T(float(size.height) * factor)
			return self
		}

		// The rectangle moved to container's left edge. Changes the rectangle in
		// place and returns it.
		def alignLeft(container Rectangle<T>) Rectangle<T> {
			position.x = container.left()
			return self
		}

		// The rectangle moved to container's right edge. Changes the rectangle in
		// place and returns it.
		def alignRight(container Rectangle<T>) Rectangle<T> {
			position.x = container.right() - size.width
			return self
		}

		// The rectangle moved to container's top edge. Changes the rectangle in
		// place and returns it.
		def alignTop(container Rectangle<T>) Rectangle<T> {
			position.y = container.top()
			return self
		}

		// The rectangle moved to container's bottom edge. Changes the rectangle in
		// place and returns it.
		def alignBottom(container Rectangle<T>) Rectangle<T> {
			position.y = container.bottom() - size.height
			return self
		}

		// The rectangle centered in container. Changes the rectangle in place and
		// returns it.
		def alignCenter(container Rectangle<T>) Rectangle<T> {
			return alignCenterX(container).alignCenterY(container)
		}

		// The rectangle centered horizontally in container. Changes the rectangle
		// in place and returns it.
		def alignCenterX(container Rectangle<T>) Rectangle<T> {
			position.x = container.left() + (container.size.width - size.width) / 2
			return self
		}

		// The rectangle centered vertically in container. Changes the rectangle in
		// place and returns it.
		def alignCenterY(container Rectangle<T>) Rectangle<T> {
			position.y = container.top() + (container.size.height - size.height) / 2
			return self
		}

		// The rectangle moved to sit `gap` below other, keeping its x. Changes the
		// rectangle in place and returns it.
		def placeBelow(other Rectangle<T>, gap T) Rectangle<T> {
			position.y = other.bottom() + gap
			return self
		}

		// The rectangle moved to sit `gap` above other, keeping its x. Changes the
		// rectangle in place and returns it.
		def placeAbove(other Rectangle<T>, gap T) Rectangle<T> {
			position.y = other.top() - gap - size.height
			return self
		}

		// The rectangle moved to sit `gap` to the right of other, keeping its y.
		// Changes the rectangle in place and returns it.
		def placeRightOf(other Rectangle<T>, gap T) Rectangle<T> {
			position.x = other.right() + gap
			return self
		}

		// The rectangle moved to sit `gap` to the left of other, keeping its y.
		// Changes the rectangle in place and returns it.
		def placeLeftOf(other Rectangle<T>, gap T) Rectangle<T> {
			position.x = other.left() - gap - size.width
			return self
		}
	}
}
