partial module std.math.geom {
	use (
		std.testing
		std.math
	)

	check "Rectangle" {
		internal def rect(x, y, w, h float) Rectangle<float> {
			return new Rectangle(position = new Point(x, y), size = new Size(w, h))
		}

		internal def sameRect(r Rectangle<float>, x, y, w, h float) bool {
			return math.approx(x, r.position.x, 1e-9) && math.approx(y, r.position.y, 1e-9) && math.approx(w, r.size.width, 1e-9) && math.approx(h, r.size.height, 1e-9)
		}

		@test()
		def split() {
			let r = rect(0.0, 0.0, 10.0, 20.0)
			let (top, bottom) = r.splitHorizontal(0.25)
			assert sameRect(top, 0.0, 0.0, 10.0, 5.0)
			assert sameRect(bottom, 0.0, 5.0, 10.0, 15.0)

			let (left, right) = r.splitVertical(0.5)
			assert sameRect(left, 0.0, 0.0, 5.0, 20.0)
			assert sameRect(right, 5.0, 0.0, 5.0, 20.0)

			// the receiver is untouched
			assert sameRect(r, 0.0, 0.0, 10.0, 20.0)

			// integer rectangles keep the remainder in the second part
			let ri = new Rectangle<int>(position = new Point<int>(0, 0), size = new Size<int>(10, 7))
			let (a, b) = ri.splitHorizontal(0.5)
			assert a.size.height == 3
			assert b.position.y == 3
			assert b.size.height == 4
		}

		@test()
		def distanceToPoint() {
			let r = rect(0.0, 0.0, 10.0, 10.0)
			assert r.distanceTo(new Point(5.0, 5.0)) == 0.0
			assert r.distanceTo(new Point(10.0, 3.0)) == 0.0
			assert r.distanceTo(new Point(13.0, 4.0)) == 3.0
			assert r.distanceTo(new Point(13.0, 14.0)) == 5.0
			assert r.distanceTo(new Point(-4.0, -3.0)) == 5.0
		}

		@test()
		def distanceToRectangle() {
			let r = rect(0.0, 0.0, 10.0, 10.0)
			assert r.distanceTo(rect(5.0, 5.0, 10.0, 10.0)) == 0.0
			assert r.distanceTo(rect(10.0, 0.0, 10.0, 10.0)) == 0.0
			assert r.distanceTo(rect(13.0, 2.0, 4.0, 4.0)) == 3.0
			assert r.distanceTo(rect(-7.0, 2.0, 4.0, 4.0)) == 3.0
			assert r.distanceTo(rect(13.0, 14.0, 4.0, 4.0)) == 5.0
			assert rect(13.0, 14.0, 4.0, 4.0).distanceTo(r) == 5.0
		}

		@test()
		def rowsAndColumns() {
			let r = rect(1.0, 2.0, 10.0, 20.0)
			let rows = r.rows(4)
			assert rows.len() == 4
			assert sameRect(rows[0], 1.0, 2.0, 10.0, 5.0)
			assert sameRect(rows[3], 1.0, 17.0, 10.0, 5.0)

			let cols = r.columns(2)
			assert cols.len() == 2
			assert sameRect(cols[0], 1.0, 2.0, 5.0, 20.0)
			assert sameRect(cols[1], 6.0, 2.0, 5.0, 20.0)

			assert r.rows(0).len() == 0
			assert r.columns(-1).len() == 0

			// integer rows tile the height exactly
			let ri = new Rectangle<int>(position = new Point<int>(0, 0), size = new Size<int>(10, 10))
			let irows = ri.rows(3)
			assert irows[0].size.height == 3
			assert irows[1].position.y == 3
			assert irows[1].size.height == 3
			assert irows[2].position.y == 6
			assert irows[2].size.height == 4
		}

		@test()
		def grid() {
			let cells = rect(0.0, 0.0, 30.0, 20.0).grid(2, 3)
			assert cells.len() == 6
			assert sameRect(cells[0], 0.0, 0.0, 10.0, 10.0)
			assert sameRect(cells[2], 20.0, 0.0, 10.0, 10.0)
			assert sameRect(cells[3], 0.0, 10.0, 10.0, 10.0)
			assert sameRect(cells[5], 20.0, 10.0, 10.0, 10.0)
			assert rect(0.0, 0.0, 30.0, 20.0).grid(0, 3).len() == 0
		}

		@test()
		def fitInside() {
			let container = rect(0.0, 0.0, 10.0, 10.0)
			let wide = rect(0.0, 0.0, 40.0, 20.0)
			assert sameRect(wide.fitInside(container), 0.0, 2.5, 10.0, 5.0)

			let tall = rect(3.0, 3.0, 5.0, 20.0)
			assert sameRect(tall.fitInside(container), 3.75, 0.0, 2.5, 10.0)

			let flat = rect(0.0, 0.0, 0.0, 0.0)
			assert sameRect(flat.fitInside(container), 5.0, 5.0, 0.0, 0.0)
		}

		@test()
		def fill() {
			let container = rect(0.0, 0.0, 10.0, 10.0)
			let wide = rect(0.0, 0.0, 40.0, 20.0)
			assert sameRect(wide.fill(container), -5.0, 0.0, 20.0, 10.0)

			let tall = rect(0.0, 0.0, 5.0, 20.0)
			assert sameRect(tall.fill(container), 0.0, -15.0, 10.0, 40.0)
		}

		@test()
		def stretchTo() {
			let container = rect(2.0, 3.0, 10.0, 10.0)
			let r = rect(0.0, 0.0, 40.0, 20.0)
			assert sameRect(r.stretchTo(container), 2.0, 3.0, 10.0, 10.0)
		}

		@test()
		def align() {
			let container = rect(10.0, 10.0, 20.0, 20.0)
			assert sameRect(rect(0.0, 0.0, 2.0, 2.0).alignLeft(container), 10.0, 0.0, 2.0, 2.0)
			assert sameRect(rect(0.0, 0.0, 2.0, 2.0).alignRight(container), 28.0, 0.0, 2.0, 2.0)
			assert sameRect(rect(0.0, 0.0, 2.0, 2.0).alignTop(container), 0.0, 10.0, 2.0, 2.0)
			assert sameRect(rect(0.0, 0.0, 2.0, 2.0).alignBottom(container), 0.0, 28.0, 2.0, 2.0)
			assert sameRect(rect(0.0, 0.0, 2.0, 2.0).alignCenterX(container), 19.0, 0.0, 2.0, 2.0)
			assert sameRect(rect(0.0, 0.0, 2.0, 2.0).alignCenterY(container), 0.0, 19.0, 2.0, 2.0)
			assert sameRect(rect(0.0, 0.0, 2.0, 2.0).alignCenter(container), 19.0, 19.0, 2.0, 2.0)

			// chaining moves the same rectangle
			let r = rect(0.0, 0.0, 2.0, 2.0)
			r.alignRight(container).alignBottom(container)
			assert sameRect(r, 28.0, 28.0, 2.0, 2.0)
		}

		@test()
		def place() {
			let other = rect(0.0, 0.0, 10.0, 10.0)
			assert sameRect(rect(1.0, 1.0, 4.0, 4.0).placeBelow(other, 2.0), 1.0, 12.0, 4.0, 4.0)
			assert sameRect(rect(1.0, 1.0, 4.0, 4.0).placeAbove(other, 2.0), 1.0, -6.0, 4.0, 4.0)
			assert sameRect(rect(1.0, 1.0, 4.0, 4.0).placeRightOf(other, 2.0), 12.0, 1.0, 4.0, 4.0)
			assert sameRect(rect(1.0, 1.0, 4.0, 4.0).placeLeftOf(other, 2.0), -6.0, 1.0, 4.0, 4.0)
			assert sameRect(rect(1.0, 1.0, 4.0, 4.0).placeBelow(other, 0.0), 1.0, 10.0, 4.0, 4.0)
		}

		@test()
		def toFloat() {
			let ri = new Rectangle<int>(position = new Point<int>(1, 2), size = new Size<int>(3, 4))
			assert sameRect(ri.toFloat(), 1.0, 2.0, 3.0, 4.0)
		}

		@test()
		def containsPoint() {
			let r = rect(0.0, 0.0, 10.0, 10.0)
			assert r.contains(new Point(5.0, 5.0))
			assert r.contains(new Point(0.0, 10.0))
			assert !r.contains(new Point(11.0, 5.0))
			assert !r.contains(new Point(5.0, -1.0))
		}

		@test()
		def containsRectangle() {
			let r = rect(0.0, 0.0, 10.0, 10.0)
			assert r.contains(rect(2.0, 2.0, 5.0, 5.0))
			assert r.contains(rect(0.0, 0.0, 10.0, 10.0))
			assert !r.contains(rect(5.0, 5.0, 10.0, 10.0))
		}

		@test()
		def intersectsRectangle() {
			let r = rect(0.0, 0.0, 10.0, 10.0)
			assert r.intersects(rect(5.0, 5.0, 10.0, 10.0))
			assert !r.intersects(rect(10.0, 0.0, 5.0, 5.0))
			assert !r.intersects(rect(20.0, 20.0, 5.0, 5.0))
		}

		@test()
		def intersectsLine() {
			let r = rect(0.0, 0.0, 10.0, 10.0)
			assert r.intersects(new Line(new Point(-5.0, 5.0), new Point(15.0, 5.0)))
			assert r.intersects(new Line(new Point(2.0, 2.0), new Point(3.0, 3.0)))
			assert !r.intersects(new Line(new Point(-5.0, 20.0), new Point(15.0, 20.0)))
		}

		@test()
		def intersectionRectangle() {
			let r = rect(0.0, 0.0, 10.0, 10.0)
			let overlap = r.intersection(rect(5.0, 5.0, 10.0, 10.0))
			assert overlap is Rectangle
			if overlap is Rectangle {
				assert sameRect(overlap, 5.0, 5.0, 5.0, 5.0)
			}
			assert r.intersection(rect(20.0, 20.0, 5.0, 5.0)) is none
		}

		@test()
		def intersectionLine() {
			let r = rect(0.0, 0.0, 10.0, 10.0)
			let hits = r.intersection(new Line(new Point(-5.0, 5.0), new Point(15.0, 5.0)))
			assert hits.len() == 2
			assert hits[0].equalsEps(new Point(10.0, 5.0), 1e-9) || hits[1].equalsEps(new Point(10.0, 5.0), 1e-9)
			assert hits[0].equalsEps(new Point(0.0, 5.0), 1e-9) || hits[1].equalsEps(new Point(0.0, 5.0), 1e-9)

			let inside = r.intersection(new Line(new Point(2.0, 2.0), new Point(3.0, 3.0)))
			assert inside.len() == 2
			assert inside[0].equalsEps(new Point(2.0, 2.0), 1e-9)
			assert inside[1].equalsEps(new Point(3.0, 3.0), 1e-9)

			assert r.intersection(new Line(new Point(-5.0, 20.0), new Point(15.0, 20.0))).len() == 0
		}

		@test()
		def edges() {
			let sides = rect(0.0, 0.0, 10.0, 20.0).edges()
			assert sides.len() == 4
			assert sides[0].start.equalsEps(new Point(0.0, 0.0), 1e-9)
			assert sides[0].end.equalsEps(new Point(10.0, 0.0), 1e-9)
			assert sides[1].end.equalsEps(new Point(10.0, 20.0), 1e-9)
			assert sides[3].start.equalsEps(new Point(0.0, 20.0), 1e-9)
			assert sides[3].end.equalsEps(new Point(0.0, 0.0), 1e-9)
		}

		@test()
		def inflate() {
			let r = rect(2.0, 2.0, 4.0, 4.0)
			assert sameRect(r.inflate(1.0), 1.0, 1.0, 6.0, 6.0)
			assert sameRect(r.inflate(-2.0), 3.0, 3.0, 2.0, 2.0)
		}

		@test()
		def toPolygon() {
			let corners = rect(1.0, 2.0, 10.0, 20.0).toPolygon()
			assert corners.len() == 4
			assert corners[0].equalsEps(new Point(1.0, 2.0), 1e-9)
			assert corners[1].equalsEps(new Point(11.0, 2.0), 1e-9)
			assert corners[2].equalsEps(new Point(11.0, 22.0), 1e-9)
			assert corners[3].equalsEps(new Point(1.0, 22.0), 1e-9)
		}

		@test()
		def normalized() {
			let r = rect(10.0, 20.0, -4.0, -6.0)
			assert sameRect(r.normalized(), 6.0, 14.0, 4.0, 6.0)
			assert sameRect(rect(1.0, 1.0, 2.0, 3.0).normalized(), 1.0, 1.0, 2.0, 3.0)
		}

		@test()
		def measures() {
			let r = rect(1.0, 2.0, 10.0, 20.0)
			assert r.area() == 200.0
			assert r.perimeter() == 60.0
			assert r.topLeft().equalsEps(new Point(1.0, 2.0), 1e-9)
			assert r.topRight().equalsEps(new Point(11.0, 2.0), 1e-9)
			assert r.bottomLeft().equalsEps(new Point(1.0, 22.0), 1e-9)
			assert r.bottomRight().equalsEps(new Point(11.0, 22.0), 1e-9)
			assert r.center().equalsEps(new Point(6.0, 12.0), 1e-9)
			assert r.left() == 1.0
			assert r.right() == 11.0
			assert r.top() == 2.0
			assert r.bottom() == 22.0
		}

		@test()
		def translate() {
			let r = rect(1.0, 2.0, 10.0, 20.0)
			assert sameRect(r.translate(3.0, -2.0), 4.0, 0.0, 10.0, 20.0)
		}
	}
}
