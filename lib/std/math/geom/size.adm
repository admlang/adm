partial module std.math.geom {
	// Size represents a width/height with the option to limit the size defining a range of min/max values
	type Size<T: Numeric = float> {
		width     T
		height    T
		minWidth  T
		minHeight T
		maxWidth  T
		maxHeight T

		def new(w, h T) {
			width = w
			height = h
		}

		def clamp() {
			if width < minWidth {
				width = minWidth
			}

			if maxWidth > 0 && width > maxWidth {
				width = maxWidth
			}

			if height < minHeight {
				height = minHeight
			}

			if maxHeight > 0 && height > maxHeight {
				height = maxHeight
			}
		}

		def scale(factor T) Size<T> {
			width = width * factor
			height = height * factor
			clamp()
			return self
		}

		def scale(x, y T) Size<T> {
			width = width * x
			height = height * y
			clamp()
			return self
		}

		def aspectRatio() float {
			return 0 when height == 0
			return float(width) / float(height)
		}

		def isEmpty() bool {
			return width <= 0 || height <= 0
		}

		def isSquare() bool {
			return width == height
		}

		def isPortrait() bool {
			return aspectRatio() < 1
		}

		def isLandscape() bool {
			return aspectRatio() > 1
		}

		def str() string {
			return "Size({width}, {height})"
		}

		def add(other T) Size<T> {
			width += other
			height += other
			clamp()
			return self
		}

		def sub(other T) Size<T> {
			width -= other
			height -= other
			clamp()
			return self
		}

		def mul(factor T) Size<T> {
			return scale(factor)
		}
	}

	check "Size test" {
		use std.testing

		@test()
		def MinMaxWidth() {
			let size = new Size(10.0, 20.0)
			size.minWidth = 15.0
			size.clamp()
			assert size.width == 15.0
		}
	}
}
