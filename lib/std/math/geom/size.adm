partial module std.math.geom {
	// Size represents a width/height with the option to limit the size defining a range of min/max values
	type Size<T: Numeric = float> {
		width     T
		height    T
		minWidth  T
		minHeight T
		maxWidth  T
		maxHeight T

		def new(w, h T) {
			width = w
			height = h
		}

		// Brings width and height back inside the min and max limits; a max of 0 means no limit.
		def clamp() {
			if width < minWidth {
				width = minWidth
			}

			if maxWidth > 0 && width > maxWidth {
				width = maxWidth
			}

			if height < minHeight {
				height = minHeight
			}

			if maxHeight > 0 && height > maxHeight {
				height = maxHeight
			}
		}

		// Multiplies width and height by factor, clamps, and returns the size.
		def scale(factor T) Size<T> {
			width = width * factor
			height = height * factor
			clamp()
			return self
		}

		// Multiplies the width by x and the height by y, clamps, and returns the size.
		def scale(x, y T) Size<T> {
			width = width * x
			height = height * y
			clamp()
			return self
		}

		// Width divided by height; 0 when the height is 0.
		def aspectRatio() float {
			return 0 when height == 0
			return float(width) / float(height)
		}

		// Whether the width or the height is zero or less.
		def isEmpty() bool {
			return width <= 0 || height <= 0
		}

		// Whether width and height are equal.
		def isSquare() bool {
			return width == height
		}

		// Whether the height exceeds the width.
		def isPortrait() bool {
			return aspectRatio() < 1
		}

		// Whether the width exceeds the height.
		def isLandscape() bool {
			return aspectRatio() > 1
		}

		// The size as text.
		def str() string {
			return "Size({width}, {height})"
		}

		// Adds other to both width and height, clamps, and returns the size.
		def add(other T) Size<T> {
			width += other
			height += other
			clamp()
			return self
		}

		// Subtracts other from both width and height, clamps, and returns the size.
		def sub(other T) Size<T> {
			width -= other
			height -= other
			clamp()
			return self
		}

		// Same as `scale(factor)`.
		def mul(factor T) Size<T> {
			return scale(factor)
		}
	}

	check "Size test" {
		use std.testing

		@test()
		def MinMaxWidth() {
			let size = new Size(10.0, 20.0)
			size.minWidth = 15.0
			size.clamp()
			assert size.width == 15.0
		}
	}
}
