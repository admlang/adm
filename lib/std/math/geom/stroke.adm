partial module std.math.geom {
	use (
		std.math::(Pi, atan2, sqrt)
		std.units::Pixels
	)

	// LineCap is how an open subpath's ends are drawn.
	enum LineCap {
		Butt,    // flat, at the end point
		Round,   // a half circle past the end
		Square,  // a half square past the end
	}

	// LineJoin is how a stroke turns a corner.
	enum LineJoin {
		Miter,  // sharp, beveled past `miterLimit`
		Round,
		Bevel,
	}

	// StrokeStyle is how a path's outline is painted.
	struct StrokeStyle {
		width      Pixels   = 1(px)
		cap        LineCap  = LineCap.Butt
		join       LineJoin = LineJoin.Miter
		miterLimit float    = 10.0 // a ratio of the width, no unit
		// Dash lengths, on and off alternating; empty draws a solid line.
		dash       Pixels[] = []
		dashOffset Pixels   = 0(px)
		// Stroke in device pixels whatever the transform (hairlines, UI borders).
		fixedWidth bool     = false
	}

	// The outline of `path` stroked with `s`, curves flattened within `tol`.
	internal def strokeOutline(path Path, s StrokeStyle, tol float) Path {
		let src = path
		if s.dash.len() > 0 {
			let pattern float[]
			for let (_, d) in s.dash {
				pattern.push(float(d))
			}
			src = dashPath(path, pattern, float(s.dashOffset), tol)
		}
		let out = new Path()
		let hw = float(s.width) / 2.0
		return out when hw <= 0.0
		let flat = src.flattened(tol)
		let (polys, closed) = contours(flat)
		for let (i, poly) in polys {
			strokeContour(out, poly, closed[i], hw, s)
		}
		return out
	}

	// The subpaths of a flattened path as point lists (x, y pairs, repeated
	// points dropped) and whether each is closed.
	internal def contours(flat Path) (float[][], bool[]) {
		let polys float[][]
		let closed bool[]
		let cur float[]
		let j = 0
		for let (_, op) in flat.verbs {
			match op {
				case PathVerb.Move:
					if cur.len() > 0 {
						polys.push(cur)
						closed.push(false)
					}
					cur = float[]
					cur.push(flat.coords[j])
					cur.push(flat.coords[j + 1])
					j += 2
				case PathVerb.Line:
					let x = flat.coords[j]
					let y = flat.coords[j + 1]
					let n = cur.len()
					if n < 2 || cur[n - 2] != x || cur[n - 1] != y {
						cur.push(x)
						cur.push(y)
					}
					j += 2
				case PathVerb.Close:
					if cur.len() > 0 {
						polys.push(cur)
						closed.push(true)
						// The next segment starts again at the subpath's start.
						let sx = cur[0]
						let sy = cur[1]
						cur = float[]
						cur.push(sx)
						cur.push(sy)
						// A lone start point after a close is not a new subpath.
						polys.push(cur)
						closed.push(false)
						cur = float[]
					}
				default:
			}
		}
		if cur.len() > 0 {
			polys.push(cur)
			closed.push(false)
		}
		// Drop the placeholder start points a close left behind, unless a
		// later segment grew them into a subpath.
		let keptPolys float[][]
		let keptClosed bool[]
		for let (i, p) in polys {
			let isPlaceholder = !closed[i] && p.len() == 2 && i > 0 && closed[i - 1]
			continue when isPlaceholder
			keptPolys.push(p)
			keptClosed.push(closed[i])
		}
		return (keptPolys, keptClosed)
	}

	// Appends the outline of one contour: for a closed one, the loop on each
	// side; for an open one, one loop around both sides and the caps.
	internal def strokeContour(out Path, poly float[], closed bool, hw float, s StrokeStyle) {
		let n = poly.len() / 2
		if closed && n > 1 && poly[0] == poly[(n - 1) * 2] && poly[1] == poly[(n - 1) * 2 + 1] {
			n--
		}
		return when n == 0
		if n == 1 {
			dotCap(out, poly[0], poly[1], hw, s.cap) when !closed
			return
		}
		if closed {
			if n == 2 {
				// Two points closed: a line there and back, stroked as open
				// with its joins acting as caps.
				sideLoop(out, poly, 2, hw, s, true)
				return
			}
			sideLoop(out, poly, n, hw, s, false)
			sideLoop(out, reversed(poly, n), n, hw, s, false)
			return
		}
		openLoop(out, poly, n, hw, s)
	}

	// The first n points of poly in reverse order.
	internal def reversed(poly float[], n int) float[] {
		let out float[]
		for let i = n - 1; i >= 0; i-- {
			out.push(poly[i * 2])
			out.push(poly[i * 2 + 1])
		}
		return out
	}

	// Offset of the segment from point i to point k: its left normal scaled
	// by hw, and its unit direction.
	internal def segmentFrame(poly float[], i int, k int, hw float) (float, float, float, float) {
		let dx = poly[k * 2] - poly[i * 2]
		let dy = poly[k * 2 + 1] - poly[i * 2 + 1]
		let len = sqrt(dx * dx + dy * dy)
		let ux = dx / len
		let uy = dy / len
		return (-uy * hw, ux * hw, ux, uy)
	}

	// The closed offset loop on the left of a closed contour of n points.
	// `asLine` strokes a two-point contour (there and back) with caps
	// instead of joins at its ends.
	internal def sideLoop(out Path, poly float[], n int, hw float, s StrokeStyle, asLine bool) {
		if asLine {
			openLoop(out, poly, 2, hw, s)
			return
		}
		let (nx, ny, ux, uy) = segmentFrame(poly, 0, 1, hw)
		out.moveTo(poly[0] + nx, poly[1] + ny)
		for let i = 1; i <= n; i++ {
			let v = i % n
			let (mx, my, vx, vy) = segmentFrame(poly, v, (v + 1) % n, hw)
			let px = poly[v * 2]
			let py = poly[v * 2 + 1]
			out.lineTo(px + nx, py + ny)
			join(out, px, py, nx, ny, ux, uy, mx, my, vx, vy, hw, s)
			nx = mx
			ny = my
			ux = vx
			uy = vy
		}
		out.close()
	}

	// One closed loop around an open contour of n points: the left side
	// forward, the end cap, the other side back, the start cap.
	internal def openLoop(out Path, poly float[], n int, hw float, s StrokeStyle) {
		let back = reversed(poly, n)
		let (nx, ny, ux, uy) = segmentFrame(poly, 0, 1, hw)
		out.moveTo(poly[0] + nx, poly[1] + ny)
		sideForward(out, poly, n, hw, s)
		let (ex, ey, eux, euy) = segmentFrame(poly, n - 2, n - 1, hw)
		cap(out, poly[(n - 1) * 2], poly[(n - 1) * 2 + 1], ex, ey, eux, euy, hw, s.cap)
		sideForward(out, back, n, hw, s)
		let (bx, by, bux, buy) = segmentFrame(back, n - 2, n - 1, hw)
		cap(out, poly[0], poly[1], bx, by, bux, buy, hw, s.cap)
		out.close()
	}

	// The left offset of an open run of n points from its first segment's
	// start (already the current point) to its last segment's end, with
	// joins at the inner points.
	internal def sideForward(out Path, poly float[], n int, hw float, s StrokeStyle) {
		let (nx, ny, ux, uy) = segmentFrame(poly, 0, 1, hw)
		for let v = 1; v < n - 1; v++ {
			let (mx, my, vx, vy) = segmentFrame(poly, v, v + 1, hw)
			let px = poly[v * 2]
			let py = poly[v * 2 + 1]
			out.lineTo(px + nx, py + ny)
			join(out, px, py, nx, ny, ux, uy, mx, my, vx, vy, hw, s)
			nx = mx
			ny = my
			ux = vx
			uy = vy
		}
		out.lineTo(poly[(n - 1) * 2] + nx, poly[(n - 1) * 2 + 1] + ny)
	}

	// The corner at (px, py) from the incoming offset (nx, ny), direction
	// (ux, uy), to the outgoing (mx, my), (vx, vy), on the left side. The
	// current point is (px + nx, py + ny); it ends at (px + mx, py + my).
	internal def join(out Path, px, py, nx, ny, ux, uy, mx, my, vx, vy, hw float, s StrokeStyle) {
		let cross = ux * vy - uy * vx
		let dot = ux * vx + uy * vy
		// Straight on: nothing to join.
		if cross.abs() < 1e-9 && dot > 0.0 {
			out.lineTo(px + mx, py + my)
			return
		}
		// Turning towards this side: the inner corner, through the pivot so
		// short segments still cover every pixel under the non-zero rule.
		if cross > 0.0 {
			out.lineTo(px, py)
			out.lineTo(px + mx, py + my)
			return
		}
		match s.join {
			case LineJoin.Round:
				let sweep = atan2(cross, dot)
				sweep = -Pi when cross.abs() < 1e-9
				out.arc(new Point(px, py), hw, atan2(ny, nx), atan2(ny, nx) + sweep, true)
			case LineJoin.Miter:
				// The miter's length over the width is 1 / cos(turn / 2).
				let cosHalf = sqrt(((1.0 + dot) / 2.0).max(0.0))
				if cosHalf > 1e-9 && 1.0 / cosHalf <= s.miterLimit {
					let bx = nx + mx
					let by = ny + my
					let bl = sqrt(bx * bx + by * by)
					let reach = hw / cosHalf
					out.lineTo(px + bx / bl * reach, py + by / bl * reach)
				}
			default:
		}
		out.lineTo(px + mx, py + my)
	}

	// The cap at the end (px, py) of a run going (ux, uy), from the current
	// point (px + nx, py + ny) to (px - nx, py - ny).
	internal def cap(out Path, px, py, nx, ny, ux, uy, hw float, c LineCap) {
		match c {
			case LineCap.Round:
				out.arc(new Point(px, py), hw, atan2(ny, nx), atan2(ny, nx) + -Pi, true)
			case LineCap.Square:
				out.lineTo(px + nx + ux * hw, py + ny + uy * hw)
				out.lineTo(px - nx + ux * hw, py - ny + uy * hw)
			default:
		}
		out.lineTo(px - nx, py - ny)
	}

	// A zero-length subpath: a dot for round caps, an axis-aligned square
	// for square caps, nothing for butt caps (Canvas 2D, SVG).
	internal def dotCap(out Path, x, y, hw float, c LineCap) {
		match c {
			case LineCap.Round:
				out.circle(new Point(x, y), hw)
			case LineCap.Square:
				out.rect(Rect{left: x - hw, top: y - hw, right: x + hw, bottom: y + hw})
			default:
		}
	}

	// `path` cut into dashes of `pattern`, starting `offset` into it, curves
	// flattened within `tol`.
	internal def dashPath(path Path, pattern float[], offset float, tol float) Path {
		let lens float[]
		let total = 0.0
		for let (_, d) in pattern {
			return path.transformed(new Transform2D()) when d < 0.0
			lens.push(d)
			total += d
		}
		return path.transformed(new Transform2D()) when lens.len() == 0 || total <= 0.0
		if lens.len() % 2 == 1 {
			lens = lens + lens
			total *= 2.0
		}
		let phase = offset - (offset / total).floor() * total
		let out = new Path()
		let (polys, closed) = contours(path.flattened(tol))
		for let (ci, poly) in polys {
			for let (_, dash) in dashContour(poly, closed[ci], lens, phase) {
				out.moveTo(dash[0], dash[1])
				for let i = 2; i < dash.len(); i += 2 {
					out.lineTo(dash[i], dash[i + 1])
				}
			}
		}
		return out
	}

	// The dashes of one contour as point lists. Each contour starts the
	// pattern at `phase`.
	internal def dashContour(poly float[], closed bool, lens float[], phase float) float[][] {
		let dashes float[][]
		let n = poly.len() / 2
		// The dash the pattern is in at `phase`, and how much of it is left.
		let k = 0
		let left = phase
		for left >= lens[k] {
			left -= lens[k]
			k = (k + 1) % lens.len()
		}
		left = lens[k] - left
		let on = k % 2 == 0
		let startsOn = on
		let cur float[]
		if on {
			cur.push(poly[0])
			cur.push(poly[1])
		}
		if n == 1 {
			// A lone point: a zero-length dash when the pattern is on.
			if on {
				cur.push(poly[0])
				cur.push(poly[1])
				dashes.push(cur)
			}
			return dashes
		}
		let segs = closed ?? (n, n - 1)
		for let i = 0; i < segs; i++ {
			let k2 = (i + 1) % n
			let x0 = poly[i * 2]
			let y0 = poly[i * 2 + 1]
			let x1 = poly[k2 * 2]
			let y1 = poly[k2 * 2 + 1]
			let segLen = sqrt((x1 - x0) * (x1 - x0) + (y1 - y0) * (y1 - y0))
			let at = 0.0
			for segLen - at > left {
				at += left
				let t = at / segLen
				let x = x0 + (x1 - x0) * t
				let y = y0 + (y1 - y0) * t
				cur.push(x)
				cur.push(y)
				if on {
					dashes.push(cur)
				}
				cur = float[]
				if !on {
					cur.push(x)
					cur.push(y)
				}
				on = !on
				k = (k + 1) % lens.len()
				left = lens[k]
			}
			left -= segLen - at
			if on {
				cur.push(x1)
				cur.push(y1)
			}
		}
		if on && cur.len() >= 4 {
			// A closed contour that starts and ends inside a dash joins the
			// two pieces, so the seam gets a join, not two caps.
			if closed && startsOn && dashes.len() > 0 {
				let first = dashes[0]
				for let i = 2; i < first.len(); i++ {
					cur.push(first[i])
				}
				dashes[0] = cur
			} else {
				dashes.push(cur)
			}
		}
		return dashes
	}
}
