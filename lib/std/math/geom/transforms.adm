partial module std.math.geom {
	use std.math::(*)

	type Transform2D {
		// Matrix representation:
		// [ a c tx ]
		// [ b d ty ]
		// [ 0 0  1  ]

		a  float = 1.0
		b  float = 0.0
		c  float = 0.0
		d  float = 1.0
		tx float = 0.0
		ty float = 0.0

		def translation(dx, dy float) Transform2D {
			return new Transform2D(
				a=1, b=0, c=0, d=1,
				tx=dx, ty=dy
			)
		}

		def scale(sx, sy float) Transform2D {
			return new Transform2D(
				a=sx, b=0, c=0, d=sy,
				tx=0, ty=0
			)
		}

		def rotation(angle float) Transform2D {
			let cosA = cos(angle)
			let sinA = sin(angle)

			return new Transform2D(
				a=cosA,  c=-sinA,
				b=sinA,  d=cosA,
				tx=0,    ty=0
			)
		}

		def then(other Transform2D) Transform2D {
			// self ∘ other
			return new Transform2D(
				a = a*other.a + c*other.b,
				b = b*other.a + d*other.b,
				c = a*other.c + c*other.d,
				d = b*other.c + d*other.d,
				tx = a*other.tx + c*other.ty + tx,
				ty = b*other.tx + d*other.ty + ty
			)
		}

		def apply(p Point) Point {
			return new Point(
				p.x*a + p.y*c + tx,
				p.x*b + p.y*d + ty
			)
		}

		def apply(v Vec2) Vec2 {
			return new Vec2(
				v.x*a + v.y*c,
				v.x*b + v.y*d
			)
		}

		def apply(line Line) Line {
			return new Line(apply(line.start), apply(line.end))
		}

		def apply(rect Rectangle) Rectangle {
			// Conservative bounding box
			let pts = rect.toPolygon()
			let minX = pts[0].x
			let minY = pts[0].y
			let maxX = minX
			let maxY = minY

			for let (_, p) in pts {
				let tp = apply(p)
				minX = minX.min(tp.x)
				minY = minY.min(tp.y)
				maxX = maxX.max(tp.x)
				maxY = maxY.max(tp.y)
			}

			return new Rectangle(
				position = new Point(minX, minY),
				size = new Size(maxX - minX, maxY - minY)
			)
		}

		def inverse() Transform2D {
			let det = a * d - b * c
			return new Transform2D(
				a =  d / det,
				b = -b / det,
				c = -c / det,
				d =  a / det,
				tx = (c*ty - d*tx) / det,
				ty = (b*tx - a*ty) / det
			)
		}
	}
}
