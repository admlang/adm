partial module std.math.geom {
	use std.math::(*)

	/**
	* A 2-dimensional mathematical vector with floating-point components.
	*
	* Vec2 represents a direction and magnitude in 2D space. Unlike Point2d,
	* which represents a location, Vec2 supports vector arithmetic, projection,
	* normalization, and geometric calculations.
	*
	* Vec2 is commonly used for:
	*  - geometry and analytic math
	*  - physics and movement
	*  - graphics, animation, and transforms
	*  - normals, tangents, UV space operations
	*
	* Operations that combine or scale vectors are defined as infix operators.
	*
	* Examples:
	*   let v = new Vec2(3, 4)
	*   let n = v.normalized()
	*   let d = v.dot(new Vec2(1, 0))
	*   let sum = v + new Vec2(1, 2)
	*/
	type Vec2 {
		x float
		y float

		def new(x, y float) {
			self.x = x
			self.y = y
		}

		/**
		* Computes the magnitude (length) of the vector.
		*/
		def length() float {
			return sqrt(x * x + y * y)
		}

		/**
		* Computes the squared magnitude of the vector.
		* Faster than length() because no sqrt is performed.
		*/
		def lengthSquared() float {
			return x * x + y * y
		}

		/**
		* Returns a normalized version of this vector.
		* If the vector has length zero, the behavior is undefined.
		*/
		def normalized() Vec2 {
			let len = length()
			return new Vec2(0, 0) when len == 0
			return new Vec2(x / len, y / len)
		}

		/**
		* Computes the dot product between this vector and another.
		*/
		def dot(v Vec2) float {
			return x * v.x + y * v.y
		}

		/**
		* Computes the 2D "cross" product (scalar).
		* Equivalent to the signed area of the parallelogram formed by the two vectors.
		*/
		def cross(v Vec2) float {
			return (x * v.y) - (y * v.x)
		}

		/**
		* Adds this vector and v component-wise.
		*/
		def add(v Vec2) Vec2 {
			return new Vec2(x + v.x, y + v.y)
		}

		/**
		* Subtracts v from this vector component-wise.
		*/
		def sub(v Vec2) Vec2 {
			return new Vec2(x - v.x, y - v.y)
		}

		/**
		* Multiplies this vector by a scalar.
		*/
		def mul(s float) Vec2 {
			return new Vec2(x * s, y * s)
		}

		/**
		* Divides this vector by a scalar.
		*/
		def div(s float) Vec2 {
			return new Vec2(x / s, y / s)
		}

		/**
		* Computes the angle between this vector and another.
		* The result is in radians and lies between 0 and π.
		*/
		def angleTo(v Vec2) float {
			let len = length() * v.length()
			return 0 when len == 0

			let c = (dot(v) / len).clamp(-1.0, 1.0)
			return acos(c)
		}

		// The distance to v.
		def distanceTo(v Vec2) float {
			let dx = v.x - x
			let dy = v.y - y
			return sqrt(dx * dx + dy * dy)
		}

		// The vector pointing the opposite way.
		def neg() Vec2 {
			return new Vec2(-x, -y)
		}

		// The vector shortened to maxLen when it is longer; a zero vector stays zero.
		def clampLength(maxLen float) Vec2 {
			let len = length()
			return self when len <= maxLen || len == 0
			return normalized().mul(maxLen)
		}

		// The vector as a point.
		def toPoint() Point {
			return new Point(x, y)
		}

		/**
		* Returns a perpendicular vector rotated 90° counter-clockwise.
		*/
		def perp() Vec2 {
			return new Vec2(-y, x)
		}

		/**
		* Projects this vector onto vector v.
		*/
		def projectOn(v Vec2) Vec2 {
			let t = self.dot(v) / v.lengthSquared()
			return new Vec2(v.x * t, v.y * t)
		}

		/**
		* Linear interpolation between this vector and another.
		* t should be in the range [0, 1].
		*/
		def lerp(to Vec2, t float) Vec2 {
			return new Vec2(x + (to.x - x) * t, y + (to.y - y) * t)
		}

		// The vector as text.
		def str() string {
			return sprintf("Vec2(%.2f, %.2f)", x, y)
		}
	}

	/**
	* A 3-dimensional mathematical vector with floating-point components.
	*
	* Vec3 represents a direction and magnitude in 3D space. It is used extensively
	* in 3D geometry, transforms, physics, graphics, normals, lighting, and spatial math.
	*
	* Supports vector arithmetic, dot product, cross product, projection,
	* interpolation, and normalization.
	*
	* Examples:
	*   let v = new Vec3(1, 2, 3)
	*   let w = new Vec3(4, 5, 6)
	*   let dp = v.dot(w)
	*   let cp = v.cross(w)
	*   let sum = v + w
	*/
	type Vec3 {
		x float
		y float
		z float

		def new(x float, y float, z float) {
			self.x = x
			self.y = y
			self.z = z
		}

		/** Returns the length (magnitude) of the vector. */
		def length() float {
			return sqrt(x * x + y * y + z * z)
		}

		// The squared length, without the square root.
		def lengthSquared() float {
			return x * x + y * y + z * z
		}

		// The vector scaled to length 1.
		def normalized() Vec3 {
			let len = length()
			return new Vec3(x / len, y / len, z / len)
		}

		// The dot product with v.
		def dot(v Vec3) float {
			return x * v.x + y * v.y + z * v.z
		}

		// True 3D cross product
		def cross(v Vec3) Vec3 {
			return new Vec3(
				y*v.z - z*v.y,
				z*v.x - x*v.z,
				x*v.y - y*v.x
			)
		}

		// The sum with v.
		def add(v Vec3) Vec3 {
			return new Vec3(x + v.x, y + v.y, z + v.z)
		}

		// The difference, this minus v.
		def sub(v Vec3) Vec3 {
			return new Vec3(x - v.x, y - v.y, z - v.z)
		}

		// The vector scaled by s.
		def mul(s float) Vec3 {
			return new Vec3(x * s, y * s, z * s)
		}

		// The vector divided by s.
		def div(s float) Vec3 {
			return new Vec3(x / s, y / s, z / s)
		}

		// The angle to v in radians.
		def angleTo(v Vec3) float {
			let dp = dot(v)
			let len = length() * v.length()
			return acos(dp / len)
		}

		// The projection of this vector onto v.
		def projectOn(v Vec3) Vec3 {
			let t = self.dot(v) / v.lengthSquared()
			return new Vec3(v.x * t, v.y * t, v.z * t)
		}

		// The vector t of the way from this one to `to`.
		def lerp(to Vec3, t float) Vec3 {
			return new Vec3(
				x + (to.x - x) * t,
				y + (to.y - y) * t,
				z + (to.z - z) * t
			)
		}

		// The vector as text.
		def str() string {
			return sprintf("Vec3(%.2f, %.2f, %.2f)", x, y, z)
		}
	}
}
