partial module std.math.geom {
	use std.testing

	check "Vectors" {
		@test()
		def operatorsWorkComponentWise() {
			let a = new Vec2(1, 2)
			let b = new Vec2(3, 5)
			let s = a + b
			assert s.x == 4.0 && s.y == 7.0
			let d = b - a
			assert d.x == 2.0 && d.y == 3.0
			let m = a * b
			assert m.x == 3.0 && m.y == 10.0
			let k = a * 2.0
			assert k.x == 2.0 && k.y == 4.0
			let q = b / 2.0
			assert q.x == 1.5 && q.y == 2.5

			let c = new Vec3(1, 2, 3) + new Vec3(1, 1, 1) * 2.0
			assert c.x == 3.0 && c.y == 4.0 && c.z == 5.0
		}

		@test()
		def vec4CarriesColours() {
			let c = new Vec4(1, 0.5, 0, 1)
			let mid = c.lerp(new Vec4(0, 0.5, 1, 1), 0.5)
			assert mid.x == 0.5 && mid.y == 0.5 && mid.z == 0.5 && mid.w == 1.0
			assert new Vec4(1, 2, 2, 4).length() == 5.0
			let n = new Vec4(0, 0, 0, 0).normalized()
			assert n.length() == 0.0
		}

		@test()
		def shaderHelpersMatchGlsl() {
			let v = new Vec2(-1.5, 2.25)
			assert v.abs().x == 1.5
			assert v.floor().x == -2.0 && v.ceil().y == 3.0
			let c = v.clamp(-1.0, 1.0)
			assert c.x == -1.0 && c.y == 1.0
			let lo = v.min(new Vec2(0, 0))
			assert lo.x == -1.5 && lo.y == 0.0
			assert (0.5).smoothstep(0.0, 1.0) == 0.5
			assert (-1.0).smoothstep(0.0, 1.0) == 0.0
			assert (2.0).smoothstep(0.0, 1.0) == 1.0
			let s = new Vec3(0.25, 0.5, 2).smoothstep(0.0, 1.0)
			assert s.x == 0.15625 && s.y == 0.5 && s.z == 1.0
		}
	}
}
