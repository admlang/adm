partial module std.math.linalg {
	use (
		std.math
		std.math.linalg.kernels::*
	)

	// QR is a matrix factored as A = Q·R: the columns of `q` are
	// orthonormal and `r` is upper triangular. For a rows × cols matrix
	// with k the smaller size, `q` is rows × k and `r` is k × cols.
	type QR {
		q matrix<float>
		r matrix<float>

		internal def new(q matrix<float>, r matrix<float>) {
			self.q = q
			self.r = r
		}

		// The X that makes A·X closest to B (least squares), one
		// right-hand side per column of B; the exact solution when A is
		// square.
		// Fails when B has other than A's rows, A has more columns than
		// rows, or its columns are linearly dependent.
		def solve(b matrix<float>) !matrix<float> {
			let m = q.rows
			let n = r.cols
			fail LinalgError{message: "linalg: solve needs {m} rows on the right, got {b.rows}"} unless b.rows == m
			fail LinalgError{message: "linalg: least squares needs at least as many rows as columns, got {m}x{n}"} unless m >= n
			let rd = r.data()
			// A diagonal entry of R below 8·m·ε times R's largest entry is
			// rounding, not data: the columns are then dependent.
			let limit = norm(r, Norm.Max) * epsilon * float(m) * 8.0
			for let i = 0; i < n; i++ {
				fail LinalgError{message: "linalg: the matrix is rank deficient", kind: LinalgErrorKind.Singular} unless rd[i * n + i].abs() > limit
			}
			let x = q.transpose() * b
			let w = x.cols
			let xd = x.data()
			for let i = n - 1; i >= 0; i-- {
				for let j = i + 1; j < n; j++ {
					let f = rd[i * n + j]
					axpy(-f, xd, j * w, xd, i * w, w) unless f == 0.0
				}
				scale(1.0 / rd[i * n + i], xd, i * w, w)
			}
			return x
		}
	}

	// qr factors a matrix of any shape as A = Q·R with Householder
	// reflections.
	def qr(a matrix<float>) QR {
		let (m, n) = a.size()
		let k = m.min(n)
		// Columns of A as rows, so each reflection runs along memory.
		let t = a.transpose()
		let td = t.data()
		let taus float[] = []
		taus.len(k)
		taus.fill(0.0)
		let block = 32
		for let k0 = 0; k0 < k; k0 += block {
			let k1 = (k0 + block).min(k)
			for let j = k0; j < k1; j++ {
				// The block's earlier reflections reach this row only now.
				reflectRows(td, m, j, j + 1, td, k0, j - k0, k0, taus, false) when j > k0
				let o = j * m + j
				let len = m - j
				let alpha = td[o]
				let largest = 0.0
				for let i = 0; i < len; i++ {
					largest = td[o + i].abs() when td[o + i].abs() > largest
				}
				continue when largest == 0.0
				let total = 0.0
				for let i = 0; i < len; i++ {
					total += (td[o + i] / largest) * (td[o + i] / largest)
				}
				let length = largest * math.sqrt(total)
				let beta = alpha > 0.0 ?? (-length, length)
				// v = x - beta·e1, scaled so that its first cell is 1; that
				// cell then holds beta, the diagonal of R.
				let head = alpha - beta
				continue when head == 0.0
				scale(1.0 / head, td, o + 1, len - 1)
				taus[j] = (beta - alpha) / beta
				td[o] = beta
			}
			reflect(td, m, k1, n, td, k0, k1 - k0, k0, taus, false) when k1 < n
		}
		let r = zeros(k, n)
		let rd = r.data()
		for let i = 0; i < k; i++ {
			for let j = i; j < n; j++ {
				rd[i * n + j] = td[j * m + i]
			}
		}
		// Q's columns as rows: the reflections applied to the first k unit
		// vectors, last reflection first.
		let qt = zeros(k, m)
		let qd = qt.data()
		for let i = 0; i < k; i++ {
			qd[i * m + i] = 1.0
		}
		let last = ((k - 1) / block) * block
		for let k0 = last; k0 >= 0; k0 -= block {
			let k1 = (k0 + block).min(k)
			reflect(qd, m, k0, k, td, k0, k1 - k0, k0, taus, true)
		}
		return new QR(qt.transpose(), r)
	}

	// leastSquares returns the X that makes A·X closest to B.
	// Fails as `QR.solve` does.
	def leastSquares(a matrix<float>, b matrix<float>) !matrix<float> {
		return qr(a).solve(b)
	}

	// SVD is a matrix factored as A = U·diag(values)·Vᵀ: `values` are the
	// singular values, largest first; the columns of `u` (rows × k) and of
	// `v` (cols × k) are orthonormal, k the smaller size of A.
	type SVD {
		u      matrix<float>
		values float[]
		v      matrix<float>

		internal def new(u matrix<float>, values float[], v matrix<float>) {
			self.u = u
			self.values = values
			self.v = v
		}

		// How many singular values exceed the tolerance; a negative
		// tolerance means the largest value times the larger size of the
		// matrix times the float spacing.
		def rank(tolerance float = -1.0) int {
			return 0 when values.len() == 0
			let limit = tolerance < 0.0 ?? (values[0] * float(u.rows.max(v.rows)) * epsilon, tolerance)
			let count = 0
			for let (_, s) in values {
				count++ when s > limit
			}
			return count
		}
	}

	// svd computes the singular value decomposition of a matrix of any
	// shape: up to 64 columns by one-sided Jacobi rotations, which finds
	// small singular values to full relative accuracy; larger ones by
	// Householder reduction to bidiagonal form and the implicit QR method.
	def svd(a matrix<float>) SVD {
		let (m, n) = a.size()
		if m < n {
			// The decomposition of the transpose, with U and V exchanged.
			let flipped = svd(a.transpose())
			return new SVD(flipped.v, flipped.values, flipped.u)
		}
		if m > n + n / 2 {
			// A tall matrix: A = Q·R first, then the square R.
			let parts = qr(a)
			let inner = svd(parts.r)
			return new SVD(parts.q * inner.u, inner.values, inner.v)
		}
		return bidiagonalSVD(a) when n > 64
		let flat = jacobiRows(a.transpose())
		return new SVD(flat.u, flat.values, flat.v)
	}

	// Orthogonalises the rows of w (k rows of length m, k <= m) by plane
	// rotations. Returns, largest first, the lengths of the final rows as
	// `values`, the final rows scaled to length 1 as the columns of `u`
	// (m × k), and the rotations as the columns of `v` (k × k), so that
	// wᵀ = u·diag(values)·vᵀ.
	internal def jacobiRows(w matrix<float>) SVD {
		let (n, m) = w.size()
		let wd = w.data()
		let vt = identity(n)
		let vd = vt.data()
		let lengths float[] = []
		lengths.len(n)
		// A round pairs every row with one other; n - 1 rounds (n for odd
		// n) meet every pair once: the first place stays, the rest move
		// round a ring. -1 marks the bye of an odd count.
		let places = n % 2 == 0 ?? (n, n + 1)
		let ring int[] = []
		for let j = 0; j < places; j++ {
			ring.push(j < n ?? (j, -1))
		}
		let half = places / 2
		let left int[] = []
		let right int[] = []
		let flags int[] = []
		left.len(half)
		right.len(half)
		flags.len(half)
		for let sweep = 0; sweep < 60 && n > 1; sweep++ {
			let rotated = false
			// Squared lengths are carried through a sweep and taken afresh
			// at its start, so rounding does not build up.
			for let j = 0; j < n; j++ {
				lengths[j] = dot(wd, j * m, wd, j * m, m)
			}
			for let round = 0; round < places - 1; round++ {
				for let i = 0; i < half; i++ {
					let a = ring[i]
					let b = ring[places - 1 - i]
					left[i] = a < b ?? (a, b)
					right[i] = a < b ?? (b, a)
					// A bye sorts first: mark the whole pair.
					right[i] = -1 when left[i] < 0
					flags[i] = 0
				}
				jacobiRound(wd, m, vd, n, lengths, left, right, flags, epsilon)
				for let (_, flag) in flags {
					rotated = true when flag != 0
				}
				let moved = ring[places - 1]
				for let j = places - 1; j > 1; j-- {
					ring[j] = ring[j - 1]
				}
				ring[1] = moved
			}
			break unless rotated
		}
		let values float[] = []
		let order int[] = []
		for let j = 0; j < n; j++ {
			values.push(math.sqrt(dot(wd, j * m, wd, j * m, m)))
			order.push(j)
		}
		order = order.sort((x, y) => values[x] > values[y])
		let u = zeros(m, n)
		let ud = u.data()
		let v = zeros(n, n)
		let vo = v.data()
		let sorted float[] = []
		for let (k, j) in order {
			let s = values[j]
			sorted.push(s)
			for let i = 0; i < m; i++ {
				ud[i * n + k] = s > 0.0 ?? (wd[j * m + i] / s, 0.0)
			}
			for let i = 0; i < n; i++ {
				vo[i * n + k] = vd[j * n + i]
			}
		}
		return new SVD(u, sorted, v)
	}

	// The decomposition of a matrix with at least as many rows as columns:
	// reflections from the left and right leave a bidiagonal matrix, which
	// shifted QR steps turn diagonal. U and V are kept transposed, so every
	// reflection and rotation runs along rows.
	internal def bidiagonalSVD(a matrix<float>) SVD {
		let (m, n) = a.size()
		let w = a.clone()
		let wd = w.data()
		let leftVectors = zeros(n, m)
		let ul = leftVectors.data()
		let rightVectors = zeros(n, n)
		let vr = rightVectors.data()
		let tauLeft float[] = []
		let tauRight float[] = []
		let s float[] = []
		let e float[] = []
		tauLeft.len(n)
		tauRight.len(n)
		s.len(n)
		e.len(n + 1)
		tauLeft.fill(0.0)
		tauRight.fill(0.0)
		s.fill(0.0)
		e.fill(0.0)
		let factors float[] = []
		factors.len(m)
		let z float[] = []
		z.len(n)

		for let j = 0; j < n; j++ {
			// The reflection from the left that clears column j below the
			// diagonal; its vector goes to row j of the left vectors.
			let largest = 0.0
			for let i = j; i < m; i++ {
				largest = wd[i * n + j].abs() when wd[i * n + j].abs() > largest
			}
			s[j] = wd[j * n + j]
			if largest > 0.0 {
				let total = 0.0
				for let i = j; i < m; i++ {
					total += (wd[i * n + j] / largest) * (wd[i * n + j] / largest)
				}
				let length = largest * math.sqrt(total)
				let alpha = wd[j * n + j]
				let beta = alpha > 0.0 ?? (-length, length)
				let head = alpha - beta
				if head != 0.0 {
					let tau = (beta - alpha) / beta
					tauLeft[j] = tau
					s[j] = beta
					factors[j] = tau
					for let i = j + 1; i < m; i++ {
						let x = wd[i * n + j] / head
						ul[j * m + i] = x
						factors[i] = tau * x
					}
					if j + 1 < n {
						// z = vᵀ·A on the columns right of j, then each row
						// takes away its share of z.
						let len = n - j - 1
						for let c = 0; c < len; c++ {
							z[c] = wd[j * n + j + 1 + c]
						}
						for let i = j + 1; i < m; i++ {
							axpy(ul[j * m + i], wd, i * n + j + 1, z, 0, len)
						}
						rankOne(wd, n, j, m, j + 1, factors, z)
					}
				}
			}
			continue when j + 1 >= n
			// The reflection from the right that clears row j beyond the
			// superdiagonal; its vector goes to row j of the right vectors.
			let o = j * n + j + 1
			let len = n - j - 1
			e[j] = wd[o]
			largest = 0.0
			for let c = 0; c < len; c++ {
				largest = wd[o + c].abs() when wd[o + c].abs() > largest
			}
			continue when largest == 0.0
			let total = 0.0
			for let c = 0; c < len; c++ {
				total += (wd[o + c] / largest) * (wd[o + c] / largest)
			}
			let length = largest * math.sqrt(total)
			let alpha = wd[o]
			let beta = alpha > 0.0 ?? (-length, length)
			let head = alpha - beta
			continue when head == 0.0
			tauRight[j] = (beta - alpha) / beta
			e[j] = beta
			for let c = 1; c < len; c++ {
				vr[o + c] = wd[o + c] / head
			}
			reflect(wd, n, j + 1, m, vr, j, 1, j + 1, tauRight, false)
		}

		// Uᵀ and Vᵀ: the reflections on unit rows, last first, in blocks.
		let ut = zeros(n, m)
		let utd = ut.data()
		let vt = identity(n)
		let vtd = vt.data()
		for let i = 0; i < n; i++ {
			utd[i * m + i] = 1.0
		}
		let block = 32
		let last = ((n - 1) / block) * block
		for let k0 = last; k0 >= 0; k0 -= block {
			let k1 = (k0 + block).min(n)
			reflect(utd, m, k0, n, ul, k0, k1 - k0, k0, tauLeft, true)
			reflect(vtd, n, k0, n, vr, k0, k1 - k0, k0 + 1, tauRight, true)
		}

		// Shifted QR steps on the bidiagonal (s on the diagonal, e above
		// it), each rotation applied to two rows of Uᵀ or Vᵀ.
		let p = n
		let tiny = 1e-290
		let iterations = 0
		for p > 0 {
			iterations++
			break when iterations > 80 * n + 200
			let k = p - 2
			for k >= 0 {
				if e[k].abs() <= tiny + epsilon * (s[k].abs() + s[k + 1].abs()) {
					e[k] = 0.0
					break
				}
				k--
			}
			let kase = 4
			if k != p - 2 {
				let ks = p - 1
				for ks > k {
					let t = (ks != p ?? (e[ks].abs(), 0.0)) + (ks != k + 1 ?? (e[ks - 1].abs(), 0.0))
					if s[ks].abs() <= tiny + epsilon * t {
						s[ks] = 0.0
						break
					}
					ks--
				}
				if ks == k {
					kase = 3
				} else if ks == p - 1 {
					kase = 1
				} else {
					kase = 2
					k = ks
				}
			}
			k++
			if kase == 1 {
				// The last diagonal entry is negligible: chase its row away.
				let f = e[p - 2]
				e[p - 2] = 0.0
				for let j = p - 2; j >= k; j-- {
					let t = hypot(s[j], f)
					let cs = s[j] / t
					let sn = f / t
					s[j] = t
					if j != k {
						f = -sn * e[j - 1]
						e[j - 1] = cs * e[j - 1]
					}
					rotate(cs, sn, vtd, j * n, vtd, (p - 1) * n, n)
				}
			} else if kase == 2 {
				// A diagonal entry inside is negligible: split there.
				let f = e[k - 1]
				e[k - 1] = 0.0
				for let j = k; j < p; j++ {
					let t = hypot(s[j], f)
					let cs = s[j] / t
					let sn = f / t
					s[j] = t
					f = -sn * e[j]
					e[j] = cs * e[j]
					rotate(cs, sn, utd, j * m, utd, (k - 1) * m, m)
				}
			} else if kase == 3 {
				let top = s[p - 1].abs().max(s[p - 2].abs()).max(e[p - 2].abs()).max(s[k].abs()).max(e[k].abs())
				let sp = s[p - 1] / top
				let spm1 = s[p - 2] / top
				let epm1 = e[p - 2] / top
				let sk = s[k] / top
				let ek = e[k] / top
				let b = ((spm1 + sp) * (spm1 - sp) + epm1 * epm1) / 2.0
				let c = (sp * epm1) * (sp * epm1)
				let shift = 0.0
				if b != 0.0 || c != 0.0 {
					shift = math.sqrt(b * b + c)
					shift = -shift when b < 0.0
					shift = c / (b + shift)
				}
				let f = (sk + sp) * (sk - sp) + shift
				let g = sk * ek
				for let j = k; j < p - 1; j++ {
					let t = hypot(f, g)
					let cs = f / t
					let sn = g / t
					e[j - 1] = t when j != k
					f = cs * s[j] + sn * e[j]
					e[j] = cs * e[j] - sn * s[j]
					g = sn * s[j + 1]
					s[j + 1] = cs * s[j + 1]
					rotate(cs, sn, vtd, j * n, vtd, (j + 1) * n, n)
					t = hypot(f, g)
					cs = f / t
					sn = g / t
					s[j] = t
					f = cs * e[j] + sn * s[j + 1]
					s[j + 1] = -sn * e[j] + cs * s[j + 1]
					g = sn * e[j + 1]
					e[j + 1] = cs * e[j + 1]
					rotate(cs, sn, utd, j * m, utd, (j + 1) * m, m)
				}
				e[p - 2] = f
			} else {
				// One value has settled: make it positive and put it in order.
				if s[k] <= 0.0 {
					s[k] = s[k] < 0.0 ?? (-s[k], 0.0)
					scale(-1.0, vtd, k * n, n)
				}
				for k < n - 1 {
					break when s[k] >= s[k + 1]
					let t = s[k]
					s[k] = s[k + 1]
					s[k + 1] = t
					swap(vtd, k * n, vtd, (k + 1) * n, n)
					swap(utd, k * m, utd, (k + 1) * m, m)
					k++
				}
				p--
			}
		}
		return new SVD(ut.transpose(), s, vt.transpose())
	}

	// rank counts the linearly independent rows (or columns), by the
	// singular values above the tolerance; see `SVD.rank`.
	def rank(a matrix<float>, tolerance float = -1.0) int {
		return svd(a).rank(tolerance)
	}

	// condition is the 2-norm condition number: the largest singular
	// value over the smallest, infinite for a singular matrix.
	def condition(a matrix<float>) float {
		let values = svd(a).values
		return 0.0 when values.len() == 0
		let last = values[values.len() - 1]
		return last == 0.0 ?? (1.0 / 0.0, values[0] / last)
	}

	// pseudoInverse is the Moore–Penrose inverse: the matrix that gives
	// the least squares solution of smallest length, for any shape and
	// rank. Singular values at or below the tolerance count as zero (a
	// negative tolerance as in `SVD.rank`).
	def pseudoInverse(a matrix<float>, tolerance float = -1.0) matrix<float> {
		let parts = svd(a)
		let k = parts.values.len()
		return zeros(a.cols, a.rows) when k == 0
		let limit = tolerance < 0.0 ?? (parts.values[0] * float(a.rows.max(a.cols)) * epsilon, tolerance)
		// V · diag(1/s) · Uᵀ: the columns of V scaled, then one product.
		let scaled = parts.v.clone()
		let sd = scaled.data()
		for let j = 0; j < k; j++ {
			let f = parts.values[j] > limit ?? (1.0 / parts.values[j], 0.0)
			for let i = 0; i < scaled.rows; i++ {
				sd[i * k + j] *= f
			}
		}
		return scaled * parts.u.transpose()
	}
}
