partial module std.math.linalg {
	use std.math

	// SymmetricEigen is a symmetric matrix factored as A = V·diag(values)·Vᵀ:
	// `values` are the eigenvalues in ascending order and the columns of
	// `vectors` the matching orthonormal eigenvectors.
	type SymmetricEigen {
		values  float[]
		vectors matrix<float>

		internal def new(values float[], vectors matrix<float>) {
			self.values = values
			self.vectors = vectors
		}
	}

	// Eigen holds the eigenvalues and eigenvectors of a square matrix.
	// Column j of `vectors` belongs to `values[j]` when that value is
	// real. A complex pair takes two columns j and j+1: the eigenvector
	// of `values[j]` (the one with the positive imaginary part) is column
	// j plus i times column j+1, that of `values[j+1]` its conjugate.
	// Real eigenvectors have length 1.
	type Eigen {
		values  complex128[]
		vectors matrix<float>

		internal def new(values complex128[], vectors matrix<float>) {
			self.values = values
			self.vectors = vectors
		}
	}

	internal def hypot(a float, b float) float {
		let x = a.abs()
		let y = b.abs()
		if x > y {
			let r = y / x
			return x * math.sqrt(1.0 + r * r)
		}
		return 0.0 when y == 0.0
		let r = x / y
		return y * math.sqrt(1.0 + r * r)
	}

	// eigenSymmetric computes the eigenvalues and eigenvectors of a
	// symmetric matrix: Householder reduction to tridiagonal form, then
	// the implicit QL method. The matrix is taken as symmetric; when it
	// is not, the result belongs to no matrix in particular.
	// Fails when the matrix is not square, or the iteration does not
	// settle (which exact arithmetic rules out).
	def eigenSymmetric(a matrix<float>) !SymmetricEigen {
		let n = a.rows
		fail LinalgError{message: "linalg: eigenvalues need a square matrix, got {a.rows}x{a.cols}"} unless a.rows == a.cols
		let vectors = a.clone()
		let v = vectors.data()
		let d float[] = []
		let e float[] = []
		d.len(n)
		e.len(n)
		return new SymmetricEigen(d, vectors) when n == 0
		for let j = 0; j < n; j++ {
			d[j] = v[(n - 1) * n + j]
		}

		// Householder reduction to tridiagonal form.
		for let i = n - 1; i > 0; i-- {
			let scaleBy = 0.0
			let h = 0.0
			for let k = 0; k < i; k++ {
				scaleBy += d[k].abs()
			}
			if scaleBy == 0.0 {
				e[i] = d[i - 1]
				for let j = 0; j < i; j++ {
					d[j] = v[(i - 1) * n + j]
					v[i * n + j] = 0.0
					v[j * n + i] = 0.0
				}
			} else {
				for let k = 0; k < i; k++ {
					d[k] /= scaleBy
					h += d[k] * d[k]
				}
				let f = d[i - 1]
				let g = math.sqrt(h)
				g = -g when f > 0.0
				e[i] = scaleBy * g
				h -= f * g
				d[i - 1] = f - g
				for let j = 0; j < i; j++ {
					e[j] = 0.0
				}
				for let j = 0; j < i; j++ {
					f = d[j]
					v[j * n + i] = f
					g = e[j] + v[j * n + j] * f
					for let k = j + 1; k <= i - 1; k++ {
						g += v[k * n + j] * d[k]
						e[k] += v[k * n + j] * f
					}
					e[j] = g
				}
				f = 0.0
				for let j = 0; j < i; j++ {
					e[j] /= h
					f += e[j] * d[j]
				}
				let hh = f / (h + h)
				for let j = 0; j < i; j++ {
					e[j] -= hh * d[j]
				}
				for let j = 0; j < i; j++ {
					f = d[j]
					g = e[j]
					for let k = j; k <= i - 1; k++ {
						v[k * n + j] -= f * e[k] + g * d[k]
					}
					d[j] = v[(i - 1) * n + j]
					v[i * n + j] = 0.0
				}
			}
			d[i] = h
		}

		// Accumulate the transformations.
		for let i = 0; i < n - 1; i++ {
			v[(n - 1) * n + i] = v[i * n + i]
			v[i * n + i] = 1.0
			let h = d[i + 1]
			if h != 0.0 {
				for let k = 0; k <= i; k++ {
					d[k] = v[k * n + i + 1] / h
				}
				for let j = 0; j <= i; j++ {
					let g = 0.0
					for let k = 0; k <= i; k++ {
						g += v[k * n + i + 1] * v[k * n + j]
					}
					for let k = 0; k <= i; k++ {
						v[k * n + j] -= g * d[k]
					}
				}
			}
			for let k = 0; k <= i; k++ {
				v[k * n + i + 1] = 0.0
			}
		}
		for let j = 0; j < n; j++ {
			d[j] = v[(n - 1) * n + j]
			v[(n - 1) * n + j] = 0.0
		}
		v[(n - 1) * n + n - 1] = 1.0
		e[0] = 0.0

		// The implicit QL method on the tridiagonal matrix.
		for let i = 1; i < n; i++ {
			e[i - 1] = e[i]
		}
		e[n - 1] = 0.0
		let f = 0.0
		let tst1 = 0.0
		for let l = 0; l < n; l++ {
			tst1 = tst1.max(d[l].abs() + e[l].abs())
			let m = l
			for m < n {
				break when e[m].abs() <= epsilon * tst1
				m++
			}
			if m > l {
				let iterations = 0
				for {
					iterations++
					fail LinalgError{message: "linalg: the eigenvalue iteration did not settle", kind: LinalgErrorKind.NoConvergence} when iterations > 200
					let g = d[l]
					let p = (d[l + 1] - g) / (2.0 * e[l])
					let r = hypot(p, 1.0)
					r = -r when p < 0.0
					d[l] = e[l] / (p + r)
					d[l + 1] = e[l] * (p + r)
					let dl1 = d[l + 1]
					let h = g - d[l]
					for let i = l + 2; i < n; i++ {
						d[i] -= h
					}
					f += h
					p = d[m]
					let c = 1.0
					let c2 = c
					let c3 = c
					let el1 = e[l + 1]
					let s = 0.0
					let s2 = 0.0
					for let i = m - 1; i >= l; i-- {
						c3 = c2
						c2 = c
						s2 = s
						g = c * e[i]
						h = c * p
						r = hypot(p, e[i])
						e[i + 1] = s * r
						s = e[i] / r
						c = p / r
						p = c * d[i] - s * g
						d[i + 1] = h + s * (c * g + s * d[i])
						for let k = 0; k < n; k++ {
							h = v[k * n + i + 1]
							v[k * n + i + 1] = s * v[k * n + i] + c * h
							v[k * n + i] = c * v[k * n + i] - s * h
						}
					}
					p = -s * s2 * c3 * el1 * e[l] / dl1
					e[l] = s * p
					d[l] = c * p
					break when e[l].abs() <= epsilon * tst1
				}
			}
			d[l] = d[l] + f
			e[l] = 0.0
		}

		// Ascending order.
		for let i = 0; i < n - 1; i++ {
			let k = i
			let p = d[i]
			for let j = i + 1; j < n; j++ {
				if d[j] < p {
					k = j
					p = d[j]
				}
			}
			if k != i {
				d[k] = d[i]
				d[i] = p
				for let j = 0; j < n; j++ {
					let t = v[j * n + i]
					v[j * n + i] = v[j * n + k]
					v[j * n + k] = t
				}
			}
		}
		return new SymmetricEigen(d, vectors)
	}

	// Complex division (xr + i·xi) / (yr + i·yi).
	internal def cdiv(xr float, xi float, yr float, yi float) (float, float) {
		if yr.abs() > yi.abs() {
			let r = yi / yr
			let d = yr + r * yi
			return ((xr + r * xi) / d, (xi - r * xr) / d)
		}
		let r = yr / yi
		let d = yi + r * yr
		return ((r * xr + xi) / d, (r * xi - xr) / d)
	}

	// eigen computes the eigenvalues and eigenvectors of a square matrix:
	// a symmetric matrix by `eigenSymmetric`, any other by reduction to
	// Hessenberg form and the shifted QR method on its real Schur form.
	// Fails when the matrix is not square or the iteration does not
	// settle.
	def eigen(a matrix<float>) !Eigen {
		let n = a.rows
		fail LinalgError{message: "linalg: eigenvalues need a square matrix, got {a.rows}x{a.cols}"} unless a.rows == a.cols
		let ad = a.data()
		let symmetric = true
		for let i = 0; i < n && symmetric; i++ {
			for let j = 0; j < i; j++ {
				if ad[i * n + j] != ad[j * n + i] {
					symmetric = false
					break
				}
			}
		}
		if symmetric {
			let parts = try eigenSymmetric(a)
			let values complex128[] = []
			for let (_, x) in parts.values {
				values.push(complex(x, 0.0))
			}
			return new Eigen(values, parts.vectors)
		}

		let hm = a.clone()
		let h = hm.data()
		let vectors = identity(n)
		let v = vectors.data()
		let ort float[] = []
		ort.len(n)
		let d float[] = []
		let e float[] = []
		d.len(n)
		e.len(n)
		let low = 0
		let high = n - 1

		// Reduction to Hessenberg form by Householder reflections.
		for let m = low + 1; m <= high - 1; m++ {
			let scaleBy = 0.0
			for let i = m; i <= high; i++ {
				scaleBy += h[i * n + m - 1].abs()
			}
			continue when scaleBy == 0.0
			let hh = 0.0
			for let i = high; i >= m; i-- {
				ort[i] = h[i * n + m - 1] / scaleBy
				hh += ort[i] * ort[i]
			}
			let g = math.sqrt(hh)
			g = -g when ort[m] > 0.0
			hh -= ort[m] * g
			ort[m] -= g
			for let j = m; j < n; j++ {
				let f = 0.0
				for let i = high; i >= m; i-- {
					f += ort[i] * h[i * n + j]
				}
				f /= hh
				for let i = m; i <= high; i++ {
					h[i * n + j] -= f * ort[i]
				}
			}
			for let i = 0; i <= high; i++ {
				let f = 0.0
				for let j = high; j >= m; j-- {
					f += ort[j] * h[i * n + j]
				}
				f /= hh
				for let j = m; j <= high; j++ {
					h[i * n + j] -= f * ort[j]
				}
			}
			ort[m] = scaleBy * ort[m]
			h[m * n + m - 1] = scaleBy * g
		}
		for let m = high - 1; m >= low + 1; m-- {
			continue when h[m * n + m - 1] == 0.0
			for let i = m + 1; i <= high; i++ {
				ort[i] = h[i * n + m - 1]
			}
			for let j = m; j <= high; j++ {
				let g = 0.0
				for let i = m; i <= high; i++ {
					g += ort[i] * v[i * n + j]
				}
				// Double division avoids underflow.
				g = (g / ort[m]) / h[m * n + m - 1]
				for let i = m; i <= high; i++ {
					v[i * n + j] += g * ort[i]
				}
			}
		}

		// Hessenberg to real Schur form.
		let nn = n
		let top = n - 1
		let exshift = 0.0
		let p = 0.0
		let q = 0.0
		let r = 0.0
		let s = 0.0
		let z = 0.0
		let t = 0.0
		let w = 0.0
		let x = 0.0
		let y = 0.0
		let hnorm = 0.0
		for let i = 0; i < nn; i++ {
			for let j = (i - 1).max(0); j < nn; j++ {
				hnorm += h[i * n + j].abs()
			}
		}
		let iter = 0
		let total = 0
		for top >= low {
			// Look for a single small sub-diagonal element.
			let l = top
			for l > low {
				s = h[(l - 1) * n + l - 1].abs() + h[l * n + l].abs()
				s = hnorm when s == 0.0
				break when h[l * n + l - 1].abs() < epsilon * s
				l--
			}
			if l == top {
				// One root found.
				h[top * n + top] = h[top * n + top] + exshift
				d[top] = h[top * n + top]
				e[top] = 0.0
				top--
				iter = 0
			} else if l == top - 1 {
				// Two roots found.
				w = h[top * n + top - 1] * h[(top - 1) * n + top]
				p = (h[(top - 1) * n + top - 1] - h[top * n + top]) / 2.0
				q = p * p + w
				z = math.sqrt(q.abs())
				h[top * n + top] = h[top * n + top] + exshift
				h[(top - 1) * n + top - 1] = h[(top - 1) * n + top - 1] + exshift
				x = h[top * n + top]
				if q >= 0.0 {
					// A real pair.
					z = p >= 0.0 ?? (p + z, p - z)
					d[top - 1] = x + z
					d[top] = d[top - 1]
					d[top] = x - w / z when z != 0.0
					e[top - 1] = 0.0
					e[top] = 0.0
					x = h[top * n + top - 1]
					s = x.abs() + z.abs()
					p = x / s
					q = z / s
					r = math.sqrt(p * p + q * q)
					p = p / r
					q = q / r
					for let j = top - 1; j < nn; j++ {
						z = h[(top - 1) * n + j]
						h[(top - 1) * n + j] = q * z + p * h[top * n + j]
						h[top * n + j] = q * h[top * n + j] - p * z
					}
					for let i = 0; i <= top; i++ {
						z = h[i * n + top - 1]
						h[i * n + top - 1] = q * z + p * h[i * n + top]
						h[i * n + top] = q * h[i * n + top] - p * z
					}
					for let i = low; i <= high; i++ {
						z = v[i * n + top - 1]
						v[i * n + top - 1] = q * z + p * v[i * n + top]
						v[i * n + top] = q * v[i * n + top] - p * z
					}
				} else {
					// A complex pair.
					d[top - 1] = x + p
					d[top] = x + p
					e[top - 1] = z
					e[top] = -z
				}
				top -= 2
				iter = 0
			} else {
				// No convergence yet: form a shift.
				x = h[top * n + top]
				y = 0.0
				w = 0.0
				if l < top {
					y = h[(top - 1) * n + top - 1]
					w = h[top * n + top - 1] * h[(top - 1) * n + top]
				}
				if iter == 10 {
					// Wilkinson's original ad hoc shift.
					exshift += x
					for let i = low; i <= top; i++ {
						h[i * n + i] -= x
					}
					s = h[top * n + top - 1].abs() + h[(top - 1) * n + top - 2].abs()
					x = 0.75 * s
					y = x
					w = -0.4375 * s * s
				}
				if iter == 30 {
					// MATLAB's ad hoc shift.
					s = (y - x) / 2.0
					s = s * s + w
					if s > 0.0 {
						s = math.sqrt(s)
						s = -s when y < x
						s = x - w / ((y - x) / 2.0 + s)
						for let i = low; i <= top; i++ {
							h[i * n + i] -= s
						}
						exshift += s
						x = 0.964
						y = x
						w = x
					}
				}
				iter++
				total++
				fail LinalgError{message: "linalg: the eigenvalue iteration did not settle", kind: LinalgErrorKind.NoConvergence} when total > 100 * (n + 10)

				// Look for two consecutive small sub-diagonal elements.
				let m = top - 2
				for m >= l {
					z = h[m * n + m]
					r = x - z
					s = y - z
					p = (r * s - w) / h[(m + 1) * n + m] + h[m * n + m + 1]
					q = h[(m + 1) * n + m + 1] - z - r - s
					r = h[(m + 2) * n + m + 1]
					s = p.abs() + q.abs() + r.abs()
					p = p / s
					q = q / s
					r = r / s
					break when m == l
					break when h[m * n + m - 1].abs() * (q.abs() + r.abs()) < epsilon * (p.abs() * (h[(m - 1) * n + m - 1].abs() + z.abs() + h[(m + 1) * n + m + 1].abs()))
					m--
				}
				for let i = m + 2; i <= top; i++ {
					h[i * n + i - 2] = 0.0
					h[i * n + i - 3] = 0.0 when i > m + 2
				}

				// Double QR step on rows l..top and columns m..top.
				for let k = m; k <= top - 1; k++ {
					let notLast = k != top - 1
					if k != m {
						p = h[k * n + k - 1]
						q = h[(k + 1) * n + k - 1]
						r = notLast ?? (h[(k + 2) * n + k - 1], 0.0)
						x = p.abs() + q.abs() + r.abs()
						if x != 0.0 {
							p = p / x
							q = q / x
							r = r / x
						}
					}
					break when x == 0.0
					s = math.sqrt(p * p + q * q + r * r)
					s = -s when p < 0.0
					if s != 0.0 {
						if k != m {
							h[k * n + k - 1] = -s * x
						} else if l != m {
							h[k * n + k - 1] = -h[k * n + k - 1]
						}
						p = p + s
						x = p / s
						y = q / s
						z = r / s
						q = q / p
						r = r / p
						for let j = k; j < nn; j++ {
							p = h[k * n + j] + q * h[(k + 1) * n + j]
							if notLast {
								p = p + r * h[(k + 2) * n + j]
								h[(k + 2) * n + j] = h[(k + 2) * n + j] - p * z
							}
							h[k * n + j] = h[k * n + j] - p * x
							h[(k + 1) * n + j] = h[(k + 1) * n + j] - p * y
						}
						for let i = 0; i <= top.min(k + 3); i++ {
							p = x * h[i * n + k] + y * h[i * n + k + 1]
							if notLast {
								p = p + z * h[i * n + k + 2]
								h[i * n + k + 2] = h[i * n + k + 2] - p * r
							}
							h[i * n + k] = h[i * n + k] - p
							h[i * n + k + 1] = h[i * n + k + 1] - p * q
						}
						for let i = low; i <= high; i++ {
							p = x * v[i * n + k] + y * v[i * n + k + 1]
							if notLast {
								p = p + z * v[i * n + k + 2]
								v[i * n + k + 2] = v[i * n + k + 2] - p * r
							}
							v[i * n + k] = v[i * n + k] - p
							v[i * n + k + 1] = v[i * n + k + 1] - p * q
						}
					}
				}
			}
		}

		// Back substitution for the vectors of the upper triangular form.
		if hnorm != 0.0 {
			for let en = nn - 1; en >= 0; en-- {
				p = d[en]
				q = e[en]
				if q == 0.0 {
					// A real vector.
					let l = en
					h[en * n + en] = 1.0
					for let i = en - 1; i >= 0; i-- {
						w = h[i * n + i] - p
						r = 0.0
						for let j = l; j <= en; j++ {
							r = r + h[i * n + j] * h[j * n + en]
						}
						if e[i] < 0.0 {
							z = w
							s = r
						} else {
							l = i
							if e[i] == 0.0 {
								h[i * n + en] = w != 0.0 ?? (-r / w, -r / (epsilon * hnorm))
							} else {
								// Solve a real two by two system.
								x = h[i * n + i + 1]
								y = h[(i + 1) * n + i]
								q = (d[i] - p) * (d[i] - p) + e[i] * e[i]
								t = (x * s - z * r) / q
								h[i * n + en] = t
								h[(i + 1) * n + en] = x.abs() > z.abs() ?? ((-r - w * t) / x, (-s - y * t) / z)
							}
							// Overflow control.
							t = h[i * n + en].abs()
							if (epsilon * t) * t > 1.0 {
								for let j = i; j <= en; j++ {
									h[j * n + en] = h[j * n + en] / t
								}
							}
						}
					}
				} else if q < 0.0 {
					// A complex vector; the last component is imaginary.
					let l = en - 1
					if h[en * n + en - 1].abs() > h[(en - 1) * n + en].abs() {
						h[(en - 1) * n + en - 1] = q / h[en * n + en - 1]
						h[(en - 1) * n + en] = -(h[en * n + en] - p) / h[en * n + en - 1]
					} else {
						let (cr, ci) = cdiv(0.0, -h[(en - 1) * n + en], h[(en - 1) * n + en - 1] - p, q)
						h[(en - 1) * n + en - 1] = cr
						h[(en - 1) * n + en] = ci
					}
					h[en * n + en - 1] = 0.0
					h[en * n + en] = 1.0
					for let i = en - 2; i >= 0; i-- {
						let ra = 0.0
						let sa = 0.0
						for let j = l; j <= en; j++ {
							ra = ra + h[i * n + j] * h[j * n + en - 1]
							sa = sa + h[i * n + j] * h[j * n + en]
						}
						w = h[i * n + i] - p
						if e[i] < 0.0 {
							z = w
							r = ra
							s = sa
						} else {
							l = i
							if e[i] == 0.0 {
								let (cr, ci) = cdiv(-ra, -sa, w, q)
								h[i * n + en - 1] = cr
								h[i * n + en] = ci
							} else {
								// Solve complex equations.
								x = h[i * n + i + 1]
								y = h[(i + 1) * n + i]
								let vr = (d[i] - p) * (d[i] - p) + e[i] * e[i] - q * q
								let vi = (d[i] - p) * 2.0 * q
								if vr == 0.0 && vi == 0.0 {
									vr = epsilon * hnorm * (w.abs() + q.abs() + x.abs() + y.abs() + z.abs())
								}
								let (cr, ci) = cdiv(x * r - z * ra + q * sa, x * s - z * sa - q * ra, vr, vi)
								h[i * n + en - 1] = cr
								h[i * n + en] = ci
								if x.abs() > z.abs() + q.abs() {
									h[(i + 1) * n + en - 1] = (-ra - w * h[i * n + en - 1] + q * h[i * n + en]) / x
									h[(i + 1) * n + en] = (-sa - w * h[i * n + en] - q * h[i * n + en - 1]) / x
								} else {
									let (er, ei) = cdiv(-r - y * h[i * n + en - 1], -s - y * h[i * n + en], z, q)
									h[(i + 1) * n + en - 1] = er
									h[(i + 1) * n + en] = ei
								}
							}
							// Overflow control.
							t = h[i * n + en - 1].abs().max(h[i * n + en].abs())
							if (epsilon * t) * t > 1.0 {
								for let j = i; j <= en; j++ {
									h[j * n + en - 1] = h[j * n + en - 1] / t
									h[j * n + en] = h[j * n + en] / t
								}
							}
						}
					}
				}
			}
			// Back to the vectors of the original matrix.
			for let j = nn - 1; j >= low; j-- {
				for let i = low; i <= high; i++ {
					z = 0.0
					for let k = low; k <= j.min(high); k++ {
						z = z + v[i * n + k] * h[k * n + j]
					}
					v[i * n + j] = z
				}
			}
		}

		// Real eigenvectors to length 1; a complex pair so that the
		// complex vector has length 1.
		let values complex128[] = []
		for let j = 0; j < n; j++ {
			values.push(complex(d[j], e[j]))
		}
		let j = 0
		for j < n {
			let width = e[j] != 0.0 && j + 1 < n ?? (2, 1)
			let length = 0.0
			for let i = 0; i < n; i++ {
				for let k = 0; k < width; k++ {
					length = hypot(length, v[i * n + j + k])
				}
			}
			if length > 0.0 {
				for let i = 0; i < n; i++ {
					for let k = 0; k < width; k++ {
						v[i * n + j + k] /= length
					}
				}
			}
			j += width
		}
		return new Eigen(values, vectors)
	}
}
