// Row kernels the decompositions are built from. Each keeps its vectors
// inside one function; results do not depend on how work is split.
internal partial module std.math.linalg.kernels {
	use std.math

	// The dot product of n cells of a from ao and of b from bo.
	def dot(a float[], ao int, b float[], bo int, n int) float {
		let v vec8<float>
		let acc = v.splat(0.0)
		let i = 0
		for; i + 8 <= n; i += 8 {
			acc = acc + v.load(a, ao + i) * v.load(b, bo + i)
		}
		let total = acc.sum()
		for; i < n; i++ {
			total += a[ao + i] * b[bo + i]
		}
		return total
	}

	// y += alpha * x over n cells.
	def axpy(alpha float, x float[], xo int, y float[], yo int, n int) {
		let v vec8<float>
		let av = v.splat(alpha)
		let i = 0
		for; i + 8 <= n; i += 8 {
			(v.load(y, yo + i) + av * v.load(x, xo + i)).store(y, yo + i)
		}
		for; i < n; i++ {
			y[yo + i] += alpha * x[xo + i]
		}
	}

	// x *= alpha over n cells.
	def scale(alpha float, x float[], xo int, n int) {
		let v vec8<float>
		let av = v.splat(alpha)
		let i = 0
		for; i + 8 <= n; i += 8 {
			(av * v.load(x, xo + i)).store(x, xo + i)
		}
		for; i < n; i++ {
			x[xo + i] *= alpha
		}
	}

	// Swaps n cells of x from xo with those of y from yo.
	def swap(x float[], xo int, y float[], yo int, n int) {
		let v vec8<float>
		let i = 0
		for; i + 8 <= n; i += 8 {
			let a = v.load(x, xo + i)
			v.load(y, yo + i).store(x, xo + i)
			a.store(y, yo + i)
		}
		for; i < n; i++ {
			let t = x[xo + i]
			x[xo + i] = y[yo + i]
			y[yo + i] = t
		}
	}

	// Applies the plane rotation (c, s) to two runs of n cells:
	// x = c*x + s*y, y = c*y - s*x.
	def rotate(c float, s float, x float[], xo int, y float[], yo int, n int) {
		let v vec8<float>
		let cv = v.splat(c)
		let sv = v.splat(s)
		let i = 0
		for; i + 8 <= n; i += 8 {
			let a = v.load(x, xo + i)
			let b = v.load(y, yo + i)
			(cv * a + sv * b).store(x, xo + i)
			(cv * b - sv * a).store(y, yo + i)
		}
		for; i < n; i++ {
			let a = x[xo + i]
			let b = y[yo + i]
			x[xo + i] = c * a + s * b
			y[yo + i] = c * b - s * a
		}
	}

	// Rows r0..r1 of a matrix `width` wide each take away multiples of the
	// `count` pivot rows from row p0: row[i] -= sum over p of
	// row[i][c0 + p] * row[p0 + p], on the cells from column c1.
	def eliminateRows(cells float[], width int, r0 int, r1 int, p0 int, count int, c0 int, c1 int) {
		let v vec8<float>
		let n = width - c1
		for let i = r0; i < r1; i++ {
			let o = i * width + c1
			for let p = 0; p < count; p++ {
				let factor = cells[i * width + c0 + p]
				continue when factor == 0.0
				let fv = v.splat(factor)
				let po = (p0 + p) * width + c1
				let j = 0
				for; j + 8 <= n; j += 8 {
					(v.load(cells, o + j) - fv * v.load(cells, po + j)).store(cells, o + j)
				}
				for; j < n; j++ {
					cells[o + j] -= factor * cells[po + j]
				}
			}
		}
	}

	async def eliminateBand(cells float[], width int, r0 int, r1 int, p0 int, count int, c0 int, c1 int) async none {
		eliminateRows(cells, width, r0, r1, p0, count, c0, c1)
		return none
	}

	// eliminateRows over rows r0..r1, in bands of rows on tasks when the
	// work is large. Each row is written by one task.
	def eliminate(cells float[], width int, r0 int, r1 int, p0 int, count int, c0 int, c1 int) {
		let rows = r1 - r0
		if rows * count * (width - c1) < 1 << 18 || rows <= 64 {
			eliminateRows(cells, width, r0, r1, p0, count, c0, c1)
			return
		}
		let bands array<async none> = []
		for let r = r0; r < r1; r += 64 {
			bands.push(eliminateBand(cells, width, r, (r + 64).min(r1), p0, count, c0, c1))
		}
		for let t in bands {
			await t
		}
	}

	// Rows r0..r1 of `cells` (`width` wide) are reflected by `count`
	// Householder vectors held in `vec` (rows of the same width): vector p
	// is row v0 + p from column c0 + p, its first cell standing for 1
	// whatever is stored there. Each row takes them in order, or last
	// first with `reverse`: row -= tau * (row . v) * v.
	def reflectRows(cells float[], width int, r0 int, r1 int, vec float[], v0 int, count int, c0 int, taus float[], reverse bool) {
		let v vec8<float>
		for let i = r0; i < r1; i++ {
			for let step = 0; step < count; step++ {
				let p = reverse ?? (count - 1 - step, step)
				let tau = taus[v0 + p]
				continue when tau == 0.0
				let head = c0 + p
				let n = width - head - 1
				let o = i * width + head + 1
				let vo = (v0 + p) * width + head + 1
				let acc = v.splat(0.0)
				let j = 0
				for; j + 8 <= n; j += 8 {
					acc = acc + v.load(cells, o + j) * v.load(vec, vo + j)
				}
				let s = acc.sum() + cells[o - 1]
				for; j < n; j++ {
					s += cells[o + j] * vec[vo + j]
				}
				let f = tau * s
				continue when f == 0.0
				cells[o - 1] -= f
				let fv = v.splat(f)
				j = 0
				for; j + 8 <= n; j += 8 {
					(v.load(cells, o + j) - fv * v.load(vec, vo + j)).store(cells, o + j)
				}
				for; j < n; j++ {
					cells[o + j] -= f * vec[vo + j]
				}
			}
		}
	}

	async def reflectBand(cells float[], width int, r0 int, r1 int, vec float[], v0 int, count int, c0 int, taus float[], reverse bool) async none {
		reflectRows(cells, width, r0, r1, vec, v0, count, c0, taus, reverse)
		return none
	}

	// reflectRows over rows r0..r1, in bands on tasks when the work is
	// large.
	def reflect(cells float[], width int, r0 int, r1 int, vec float[], v0 int, count int, c0 int, taus float[], reverse bool) {
		let rows = r1 - r0
		if rows * count * (width - c0) < 1 << 18 || rows <= 64 {
			reflectRows(cells, width, r0, r1, vec, v0, count, c0, taus, reverse)
			return
		}
		let bands array<async none> = []
		for let r = r0; r < r1; r += 64 {
			bands.push(reflectBand(cells, width, r, (r + 64).min(r1), vec, v0, count, c0, taus, reverse))
		}
		for let t in bands {
			await t
		}
	}

	// Forward and back substitution with a packed n × n LU on the columns
	// c0..c1 of the right-hand sides x (n rows, w wide).
	def substituteColumns(p float[], n int, x float[], w int, c0 int, c1 int) {
		let v vec8<float>
		let len = c1 - c0
		for let i = 1; i < n; i++ {
			let o = i * w + c0
			for let k = 0; k < i; k++ {
				let f = p[i * n + k]
				continue when f == 0.0
				let fv = v.splat(f)
				let ko = k * w + c0
				let j = 0
				for; j + 8 <= len; j += 8 {
					(v.load(x, o + j) - fv * v.load(x, ko + j)).store(x, o + j)
				}
				for; j < len; j++ {
					x[o + j] -= f * x[ko + j]
				}
			}
		}
		for let i = n - 1; i >= 0; i-- {
			let o = i * w + c0
			for let k = i + 1; k < n; k++ {
				let f = p[i * n + k]
				continue when f == 0.0
				let fv = v.splat(f)
				let ko = k * w + c0
				let j = 0
				for; j + 8 <= len; j += 8 {
					(v.load(x, o + j) - fv * v.load(x, ko + j)).store(x, o + j)
				}
				for; j < len; j++ {
					x[o + j] -= f * x[ko + j]
				}
			}
			let inv = 1.0 / p[i * n + i]
			for let j = 0; j < len; j++ {
				x[o + j] *= inv
			}
		}
	}

	async def substituteBand(p float[], n int, x float[], w int, c0 int, c1 int) async none {
		substituteColumns(p, n, x, w, c0, c1)
		return none
	}

	// substituteColumns over every column, in bands of columns on tasks
	// when there are many right-hand sides.
	def substitute(p float[], n int, x float[], w int) {
		if w < 128 || n * n * w < 1 << 22 {
			substituteColumns(p, n, x, w, 0, w)
			return
		}
		let bands array<async none> = []
		for let c = 0; c < w; c += 64 {
			bands.push(substituteBand(p, n, x, w, c, (c + 64).min(w)))
		}
		for let t in bands {
			await t
		}
	}

	// Cholesky, one block of columns k0..k1: rows r0..r1 of the lower
	// triangle take away what the columns before k0 contribute to their
	// cells in the block.
	def choleskyUpdateRows(l float[], n int, r0 int, r1 int, k0 int, k1 int) {
		let v vec8<float>
		for let i = r0; i < r1; i++ {
			let io = i * n
			let last = (i + 1).min(k1)
			for let j = k0; j < last; j++ {
				let jo = j * n
				let acc = v.splat(0.0)
				let k = 0
				for; k + 8 <= k0; k += 8 {
					acc = acc + v.load(l, io + k) * v.load(l, jo + k)
				}
				let s = acc.sum()
				for; k < k0; k++ {
					s += l[io + k] * l[jo + k]
				}
				l[io + j] -= s
			}
		}
	}

	// Rows r0..r1, all below the block k0..k1 whose diagonal part is
	// factored, get their cells in the block.
	def choleskyPanelRows(l float[], n int, r0 int, r1 int, k0 int, k1 int) {
		for let i = r0; i < r1; i++ {
			let io = i * n
			for let j = k0; j < k1; j++ {
				let jo = j * n
				let s = l[io + j]
				for let k = k0; k < j; k++ {
					s -= l[io + k] * l[jo + k]
				}
				l[io + j] = s / l[jo + j]
			}
		}
	}

	async def choleskyBand(l float[], n int, r0 int, r1 int, k0 int, k1 int, panel bool) async none {
		if panel {
			choleskyPanelRows(l, n, r0, r1, k0, k1)
		} else {
			choleskyUpdateRows(l, n, r0, r1, k0, k1)
		}
		return none
	}

	// One of the two row passes of a Cholesky block over rows r0..r1, in
	// bands on tasks when the work is large.
	def choleskyRows(l float[], n int, r0 int, r1 int, k0 int, k1 int, panel bool) {
		let rows = r1 - r0
		let work = rows * (k1 - k0) * (panel ?? (k1 - k0, k0))
		if work < 1 << 18 || rows <= 64 {
			if panel {
				choleskyPanelRows(l, n, r0, r1, k0, k1)
			} else {
				choleskyUpdateRows(l, n, r0, r1, k0, k1)
			}
			return
		}
		let bands array<async none> = []
		for let r = r0; r < r1; r += 64 {
			bands.push(choleskyBand(l, n, r, (r + 64).min(r1), k0, k1, panel))
		}
		for let t in bands {
			await t
		}
	}

	// One round of Jacobi rotations on the rows of w (m wide): for each
	// pair (left[i], right[i]) with i in from..to, the two rows are
	// rotated to be orthogonal, the same rotation goes to the rows of v
	// (n wide), and `lengths` (squared row lengths) follows. flags[i] is
	// set when the pair needed a rotation. No row is in two pairs.
	def jacobiPairs(w float[], m int, v float[], n int, lengths float[], left int[], right int[], from int, to int, flags int[], threshold float) {
		for let i = from; i < to; i++ {
			let p = left[i]
			let q = right[i]
			continue when p < 0 || q < 0
			let alpha = lengths[p]
			let beta = lengths[q]
			let gamma = dot(w, p * m, w, q * m, m)
			continue when gamma == 0.0 || gamma.abs() <= threshold * math.sqrt(alpha * beta)
			flags[i] = 1
			let zeta = (beta - alpha) / (2.0 * gamma)
			let t = (zeta >= 0.0 ?? (1.0, -1.0)) / (zeta.abs() + math.sqrt(1.0 + zeta * zeta))
			let c = 1.0 / math.sqrt(1.0 + t * t)
			let s = c * t
			// p takes c·p - s·q, q takes s·p + c·q.
			rotate(c, -s, w, p * m, w, q * m, m)
			rotate(c, -s, v, p * n, v, q * n, n)
			lengths[p] = (alpha - t * gamma).max(0.0)
			lengths[q] = beta + t * gamma
		}
	}

	async def jacobiBand(w float[], m int, v float[], n int, lengths float[], left int[], right int[], from int, to int, flags int[], threshold float) async none {
		jacobiPairs(w, m, v, n, lengths, left, right, from, to, flags, threshold)
		return none
	}

	// jacobiPairs over every pair of a round, in eight bands on tasks once
	// a round is some millions of cells; below that a task costs more than
	// its pairs.
	def jacobiRound(w float[], m int, v float[], n int, lengths float[], left int[], right int[], flags int[], threshold float) {
		let pairs = left.len()
		if pairs * m < 1 << 21 {
			jacobiPairs(w, m, v, n, lengths, left, right, 0, pairs, flags, threshold)
			return
		}
		let size = (pairs + 7) / 8
		let bands array<async none> = []
		for let from = 0; from < pairs; from += size {
			bands.push(jacobiBand(w, m, v, n, lengths, left, right, from, (from + size).min(pairs), flags, threshold))
		}
		for let t in bands {
			await t
		}
	}

	// Rows r0..r1 of `cells` (`width` wide) take away multiples of the run
	// z on their cells from column c0: row[i] -= factors[i] * z.
	def rankOneRows(cells float[], width int, r0 int, r1 int, c0 int, factors float[], z float[]) {
		let v vec8<float>
		let n = width - c0
		for let i = r0; i < r1; i++ {
			let f = factors[i]
			continue when f == 0.0
			let fv = v.splat(f)
			let o = i * width + c0
			let j = 0
			for; j + 8 <= n; j += 8 {
				(v.load(cells, o + j) - fv * v.load(z, j)).store(cells, o + j)
			}
			for; j < n; j++ {
				cells[o + j] -= f * z[j]
			}
		}
	}

	async def rankOneBand(cells float[], width int, r0 int, r1 int, c0 int, factors float[], z float[]) async none {
		rankOneRows(cells, width, r0, r1, c0, factors, z)
		return none
	}

	// rankOneRows over rows r0..r1, in bands on tasks when the work is
	// large.
	def rankOne(cells float[], width int, r0 int, r1 int, c0 int, factors float[], z float[]) {
		let rows = r1 - r0
		if rows * (width - c0) < 1 << 18 || rows <= 128 {
			rankOneRows(cells, width, r0, r1, c0, factors, z)
			return
		}
		let size = (rows + 7) / 8
		let bands array<async none> = []
		for let r = r0; r < r1; r += size {
			bands.push(rankOneBand(cells, width, r, (r + size).min(r1), c0, factors, z))
		}
		for let t in bands {
			await t
		}
	}
}
