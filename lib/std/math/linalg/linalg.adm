partial module std.math.linalg {
	// Linear algebra on `matrix<T>` (the prelude type): determinant, trace,
	// rank, norms, inverse and `solve(a, b)` (both fail on a singular
	// matrix), LU, QR, Cholesky and SVD decompositions, eigenvalues and
	// eigenvectors. Blocked SIMD kernels, row bands on tasks for large inputs.
}
