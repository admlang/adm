partial module std.math.linalg {
	use (
		std.errors
		std.math
		std.math.linalg.kernels::*
	)

	// Linear algebra on `matrix<float>` (the prelude type): `identity`,
	// `diagonal`, `trace`, `determinant`, `rank`, `norm`, `condition`,
	// `inverse`, `pseudoInverse`, `solve`, `leastSquares`, and the
	// decompositions `lu`, `cholesky`, `qr`, `svd`, `eigen`.
	//
	// ```
	// use std.math.linalg
	//
	// let a = matrix<float>[4, 3; 6, 3]
	// let x = try linalg.solve(a, [10.0, 12.0]) // [1, 2]
	// let d = try linalg.determinant(a)         // -6
	// ```
	//
	// Row operations run eight cells at a time, and on tasks in bands of
	// rows once a matrix is large; a result never depends on how the work
	// was split.

	// The distance between 1 and the next float.
	const epsilon = 2.220446049250313e-16

	// LinalgErrorKind tells why an operation failed.
	enum LinalgErrorKind {
		// The matrix or the right-hand side has the wrong shape.
		Shape,
		// The matrix has no inverse, is rank deficient, or is not positive
		// definite where that is required.
		Singular,
		// An iteration did not settle.
		NoConvergence
	}

	// LinalgError is the payload of a failed operation.
	struct LinalgError {
		message string
		code    string            = "linalg"
		cause   ?error
		stack   errors.StackTrace
		kind    LinalgErrorKind   = LinalgErrorKind.Shape
	}

	// A rows × cols matrix of zeros.
	def zeros(rows int, cols int) matrix<float> {
		return matrix<float>[].size(rows, cols)
	}

	// The n × n identity matrix.
	def identity(n int) matrix<float> {
		let out = zeros(n, n)
		let d = out.data()
		for let i = 0; i < n; i++ {
			d[i * n + i] = 1.0
		}
		return out
	}

	// A square matrix with the values on its diagonal.
	def diagonal(values float[]) matrix<float> {
		let n = values.len()
		let out = zeros(n, n)
		let d = out.data()
		for let (i, v) in values {
			d[i * n + i] = v
		}
		return out
	}

	// The sum of the diagonal.
	// Fails when the matrix is not square.
	def trace(a matrix<float>) !float {
		fail LinalgError{message: "linalg: trace needs a square matrix, got {a.rows}x{a.cols}"} unless a.rows == a.cols
		let d = a.data()
		let total = 0.0
		for let i = 0; i < a.rows; i++ {
			total += d[i * a.cols + i]
		}
		return total
	}

	// Norm names a matrix norm.
	enum Norm {
		// The square root of the sum of the squares of the cells.
		Frobenius,
		// The largest column sum of absolute values.
		One,
		// The largest row sum of absolute values.
		Infinity,
		// The largest singular value.
		Two,
		// The largest absolute cell.
		Max
	}

	// The size of a matrix by the chosen norm; 0 for an empty matrix.
	def norm(a matrix<float>, kind Norm = Norm.Frobenius) float {
		let d = a.data()
		let (rows, cols) = a.size()
		match kind {
			case Norm.Frobenius:
				// Scaled by the largest cell, so squares neither overflow nor vanish.
				let top = norm(a, Norm.Max)
				return top when top == 0.0 || top != top || top - top != 0.0
				let total = 0.0
				for let (_, x) in d {
					total += (x / top) * (x / top)
				}
				return top * math.sqrt(total)
			case Norm.One:
				let sums float[] = []
				sums.len(cols)
				sums.fill(0.0)
				for let r = 0; r < rows; r++ {
					for let c = 0; c < cols; c++ {
						sums[c] += d[r * cols + c].abs()
					}
				}
				let best = 0.0
				for let (_, s) in sums {
					best = s when s > best
				}
				return best
			case Norm.Infinity:
				let best = 0.0
				for let r = 0; r < rows; r++ {
					let s = 0.0
					for let c = 0; c < cols; c++ {
						s += d[r * cols + c].abs()
					}
					best = s when s > best
				}
				return best
			case Norm.Two:
				let values = svd(a).values
				return values.len() == 0 ?? (0.0, values[0])
			default:
				let best = 0.0
				for let (_, x) in d {
					best = x.abs() when x.abs() > best
				}
				return best
		}
	}

	// LU is a matrix factored as P·A = L·U by Gaussian elimination with
	// row pivoting: `l` is unit lower triangular (rows × k), `u` upper
	// triangular (k × cols), k the smaller of the two sizes.
	type LU {
		// L below the diagonal and U on and above it, in one matrix.
		internal packed matrix<float>
		// Row i of P·A is row pivots[i] of A.
		pivots          int[]
		// +1 or -1: the sign of the row permutation.
		sign            float

		internal def new(packed matrix<float>, pivots int[], sign float) {
			self.packed = packed
			self.pivots = pivots
			self.sign = sign
		}

		// The unit lower triangular factor.
		def l() matrix<float> {
			let (rows, cols) = packed.size()
			let k = rows.min(cols)
			let out = zeros(rows, k)
			let o = out.data()
			let p = packed.data()
			for let i = 0; i < rows; i++ {
				for let j = 0; j < k && j < i; j++ {
					o[i * k + j] = p[i * cols + j]
				}
				o[i * k + i] = 1.0 when i < k
			}
			return out
		}

		// The upper triangular factor.
		def u() matrix<float> {
			let (rows, cols) = packed.size()
			let k = rows.min(cols)
			let out = zeros(k, cols)
			let o = out.data()
			let p = packed.data()
			for let i = 0; i < k; i++ {
				for let j = i; j < cols; j++ {
					o[i * cols + j] = p[i * cols + j]
				}
			}
			return out
		}

		// The permutation as a matrix P, so that P·A = L·U.
		def permutation() matrix<float> {
			let n = pivots.len()
			let out = zeros(n, n)
			let o = out.data()
			for let (i, from) in pivots {
				o[i * n + from] = 1.0
			}
			return out
		}

		// Reports whether a zero pivot shows the matrix has no inverse.
		def singular() bool {
			let (rows, cols) = packed.size()
			let p = packed.data()
			return true when rows != cols
			for let i = 0; i < rows; i++ {
				return true when p[i * cols + i] == 0.0
			}
			return false
		}

		// The determinant of the factored matrix.
		// Fails when it is not square.
		def determinant() !float {
			let (rows, cols) = packed.size()
			fail LinalgError{message: "linalg: the determinant needs a square matrix, got {rows}x{cols}"} unless rows == cols
			let p = packed.data()
			let out = sign
			for let i = 0; i < rows; i++ {
				out *= p[i * cols + i]
			}
			return out
		}

		// Solves A·X = B for X, B holding one right-hand side per column.
		// Fails when A is not square, B has other than A's rows, or A is
		// singular.
		def solve(b matrix<float>) !matrix<float> {
			let (rows, cols) = packed.size()
			fail LinalgError{message: "linalg: solve needs a square matrix, got {rows}x{cols}"} unless rows == cols
			fail LinalgError{message: "linalg: solve needs {rows} rows on the right, got {b.rows}"} unless b.rows == rows
			fail LinalgError{message: "linalg: the matrix is singular", kind: LinalgErrorKind.Singular} when singular()
			let n = rows
			let w = b.cols
			let p = packed.data()
			let x = zeros(n, w)
			let xd = x.data()
			let bd = b.data()
			// Rows of B in pivot order, then forward and back substitution,
			// a whole row of right-hand sides at a time.
			for let i = 0; i < n; i++ {
				for let j = 0; j < w; j++ {
					xd[i * w + j] = bd[pivots[i] * w + j]
				}
			}
			substitute(p, n, xd, w)
			return x
		}

		// The inverse of the factored matrix.
		// Fails when it is not square or is singular.
		def inverse() !matrix<float> {
			return solve(identity(packed.rows))
		}
	}

	// lu factors a matrix of any shape as P·A = L·U with row pivoting. A
	// singular matrix factors too; `LU.singular` tells.
	def lu(a matrix<float>) LU {
		let packed = a.clone()
		let (rows, cols) = packed.size()
		let d = packed.data()
		let pivots int[] = []
		for let i = 0; i < rows; i++ {
			pivots.push(i)
		}
		let sign = 1.0
		let k = rows.min(cols)
		let block = 48
		for let k0 = 0; k0 < k; k0 += block {
			let k1 = (k0 + block).min(k)
			// The panel: columns k0..k1, elimination kept inside it.
			for let j = k0; j < k1; j++ {
				let best = j
				let top = d[j * cols + j].abs()
				for let i = j + 1; i < rows; i++ {
					let x = d[i * cols + j].abs()
					if x > top {
						top = x
						best = i
					}
				}
				if best != j {
					swap(d, j * cols, d, best * cols, cols)
					let t = pivots[j]
					pivots[j] = pivots[best]
					pivots[best] = t
					sign = -sign
				}
				let pivot = d[j * cols + j]
				continue when pivot == 0.0
				for let i = j + 1; i < rows; i++ {
					let f = d[i * cols + j] / pivot
					d[i * cols + j] = f
					continue when f == 0.0
					axpy(-f, d, j * cols + j + 1, d, i * cols + j + 1, k1 - j - 1)
				}
			}
			continue when k1 >= cols
			// The rows of U right of the panel, then everything below them.
			for let i = k0 + 1; i < k1; i++ {
				eliminateRows(d, cols, i, i + 1, k0, i - k0, k0, k1)
			}
			eliminate(d, cols, k1, rows, k0, k1 - k0, k0, k1)
		}
		return new LU(packed, pivots, sign)
	}

	// The determinant.
	// Fails when the matrix is not square.
	def determinant(a matrix<float>) !float {
		fail LinalgError{message: "linalg: the determinant needs a square matrix, got {a.rows}x{a.cols}"} unless a.rows == a.cols
		return lu(a).determinant()
	}

	// The inverse.
	// Fails when the matrix is not square or is singular.
	def inverse(a matrix<float>) !matrix<float> {
		return lu(a).inverse()
	}

	// solve returns the X with A·X = B, one right-hand side per column of
	// B.
	// Fails when A is not square, B has other than A's rows, or A is
	// singular.
	def solve(a matrix<float>, b matrix<float>) !matrix<float> {
		return lu(a).solve(b)
	}

	// solve returns the x with A·x = b.
	// Fails as the matrix form does.
	def solve(a matrix<float>, b float[]) !float[] {
		let rhs = zeros(b.len(), 1)
		let d = rhs.data()
		for let (i, v) in b {
			d[i] = v
		}
		return (try lu(a).solve(rhs)).col(0)
	}

	// Cholesky is a symmetric positive definite matrix factored as
	// A = L·Lᵀ, `l` lower triangular.
	type Cholesky {
		l matrix<float>

		internal def new(l matrix<float>) {
			self.l = l
		}

		// Solves A·X = B, one right-hand side per column of B.
		// Fails when B has other than A's rows.
		def solve(b matrix<float>) !matrix<float> {
			let n = l.rows
			fail LinalgError{message: "linalg: solve needs {n} rows on the right, got {b.rows}"} unless b.rows == n
			let w = b.cols
			let x = b.clone()
			let xd = x.data()
			let ld = l.data()
			for let i = 0; i < n; i++ {
				for let k = 0; k < i; k++ {
					let f = ld[i * n + k]
					axpy(-f, xd, k * w, xd, i * w, w) unless f == 0.0
				}
				scale(1.0 / ld[i * n + i], xd, i * w, w)
			}
			for let i = n - 1; i >= 0; i-- {
				for let k = i + 1; k < n; k++ {
					let f = ld[k * n + i]
					axpy(-f, xd, k * w, xd, i * w, w) unless f == 0.0
				}
				scale(1.0 / ld[i * n + i], xd, i * w, w)
			}
			return x
		}

		// The determinant of the factored matrix.
		def determinant() float {
			let n = l.rows
			let ld = l.data()
			let out = 1.0
			for let i = 0; i < n; i++ {
				out *= ld[i * n + i] * ld[i * n + i]
			}
			return out
		}
	}

	// cholesky factors a symmetric positive definite matrix as A = L·Lᵀ.
	// Only the lower triangle of A is read.
	// Fails when the matrix is not square or not positive definite.
	def cholesky(a matrix<float>) !Cholesky {
		let n = a.rows
		fail LinalgError{message: "linalg: cholesky needs a square matrix, got {a.rows}x{a.cols}"} unless a.rows == a.cols
		let out = zeros(n, n)
		let ld = out.data()
		let ad = a.data()
		for let i = 0; i < n; i++ {
			for let j = 0; j <= i; j++ {
				ld[i * n + j] = ad[i * n + j]
			}
		}
		let block = 48
		for let k0 = 0; k0 < n; k0 += block {
			let k1 = (k0 + block).min(n)
			// What the finished columns contribute to this block, then the
			// block's own triangle row by row, then the rows below it.
			choleskyRows(ld, n, k0, n, k0, k1, false) when k0 > 0
			for let i = k0; i < k1; i++ {
				for let j = k0; j < i; j++ {
					ld[i * n + j] = (ld[i * n + j] - dot(ld, i * n + k0, ld, j * n + k0, j - k0)) / ld[j * n + j]
				}
				let rest = ld[i * n + i] - dot(ld, i * n + k0, ld, i * n + k0, i - k0)
				fail LinalgError{message: "linalg: the matrix is not positive definite", kind: LinalgErrorKind.Singular} unless rest > 0.0
				ld[i * n + i] = math.sqrt(rest)
			}
			choleskyRows(ld, n, k1, n, k0, k1, true) when k1 < n
		}
		return new Cholesky(out)
	}
}
