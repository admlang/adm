partial module std.math.linalg {
	use (
		std.math
		std.testing
	)

	// A rows × cols matrix of repeatable values in (-1, 1).
	internal def sample(rows int, cols int, seed int) matrix<float> {
		let out = zeros(rows, cols)
		let d = out.data()
		let state = seed * 2654435761 + 12345
		for let i = 0; i < rows * cols; i++ {
			state = (state * 6364136223846793005 + 1442695040888963407) & 0x7FFFFFFFFFFFFFFF
			d[i] = float((state >> 20) % 2000001) / 1000000.0 - 1.0
		}
		return out
	}

	// The largest absolute cell of a - b.
	internal def gap(a matrix<float>, b matrix<float>) float {
		return 1.0 / 0.0 unless a.rows == b.rows && a.cols == b.cols
		return norm(a - b, Norm.Max)
	}

	check "linalg" {
		@test()
		def TestBasics() !none {
			let a = matrix<float>[4, 3; 6, 3]
			assert try trace(a) == 7.0
			assert ((try determinant(a)) + 6.0).abs() < 1e-12
			assert gap(identity(3), diagonal([1.0, 1.0, 1.0])) == 0.0
			assert gap(try inverse(a), matrix<float>[-0.5, 0.5; 1, -2.0 / 3.0]) < 1e-12
			let x = try solve(a, [10.0, 12.0])
			assert (x[0] - 1.0).abs() < 1e-12 && (x[1] - 2.0).abs() < 1e-12
			let b = matrix<float>[1, -2, 3; -4, 5, -6]
			assert norm(b, Norm.One) == 9.0 && norm(b, Norm.Infinity) == 15.0 && norm(b, Norm.Max) == 6.0
			assert (norm(b) - math.sqrt(91.0)).abs() < 1e-12 && (norm(b, Norm.Two) - 9.508032000695724).abs() < 1e-12
			assert norm(zeros(2, 2)) == 0.0 && norm(zeros(0, 0), Norm.Two) == 0.0
			assert (try determinant(zeros(0, 0))) == 1.0

			let singular = matrix<float>[1, 2; 2, 4]
			let seen = 0
			inverse(singular) onerror (err error) {
				if err is LinalgError {
					seen++ when err.kind == LinalgErrorKind.Singular
				}
				recover zeros(0, 0)
			}
			solve(b, b) onerror (err error) {
				if err is LinalgError {
					seen++ when err.kind == LinalgErrorKind.Shape
				}
				recover zeros(0, 0)
			}
			trace(b) onerror (err error) {
				seen++
				recover 0.0
			}
			determinant(b) onerror (err error) {
				seen++
				recover 0.0
			}
			assert seen == 4
			assert (try determinant(singular)) == 0.0
		}

		@test()
		def TestLU() !none {
			// 130 rows cross a block edge and the banded elimination.
			for let (_, shape) in [(1, 1), (5, 5), (60, 60), (130, 130), (7, 4), (4, 7), (70, 110)] {
				let (m, n) = shape
				let a = sample(m, n, m * 31 + n)
				let f = lu(a)
				assert gap(f.permutation() * a, f.l() * f.u()) < 1e-11
				assert norm(f.l(), Norm.Max) <= 1.0
				continue unless m == n
				let b = sample(n, 3, 5)
				assert gap(a * (try f.solve(b)), b) < 1e-9
				assert gap(a * (try f.inverse()), identity(n)) < 1e-9
			}
			let rows = matrix<float>[0, 2; 3, 1]
			let f = lu(rows)
			assert f.pivots[0] == 1 && f.sign == -1.0 && (try f.determinant()) == -6.0 && !f.singular()
			assert lu(matrix<float>[1, 2; 2, 4]).singular()
		}

		@test()
		def TestCholesky() !none {
			for let (_, n) in [1, 6, 60, 130] {
				let m = sample(n, n, n)
				let a = m * m.transpose() + identity(n).scale(float(n))
				let f = try cholesky(a)
				assert gap(f.l * f.l.transpose(), a) < 1e-10
				let b = sample(n, 2, 9)
				assert gap(a * (try f.solve(b)), b) < 1e-9
				let d = try determinant(a)
				assert (f.determinant() - d).abs() <= d.abs() * 1e-9
			}
			let failed = false
			cholesky(matrix<float>[1, 2; 2, 1]) onerror (err error) {
				failed = true
				recover new Cholesky(zeros(0, 0))
			}
			assert failed
		}

		@test()
		def TestQR() !none {
			for let (_, shape) in [(1, 1), (5, 5), (70, 70), (9, 4), (4, 9), (120, 40), (40, 90)] {
				let (m, n) = shape
				let a = sample(m, n, m * 17 + n)
				let f = qr(a)
				let k = m.min(n)
				assert f.q.rows == m && f.q.cols == k && f.r.rows == k && f.r.cols == n
				assert gap(f.q * f.r, a) < 1e-11
				assert gap(f.q.transpose() * f.q, identity(k)) < 1e-11
				for let i = 1; i < k; i++ {
					for let j = 0; j < i; j++ {
						assert f.r[i][j] == 0.0
					}
				}
			}
			// The line through (0,1), (1,3), (2,5), (3,7.2) by least squares.
			let a = matrix<float>[1, 0; 1, 1; 1, 2; 1, 3]
			let b = matrix<float>[1; 3; 5; 7.2]
			let fit = try leastSquares(a, b)
			assert (fit[0][0] - 0.96).abs() < 1e-12 && (fit[1][0] - 2.06).abs() < 1e-12
			let failed = 0
			leastSquares(matrix<float>[1, 2; 2, 4; 3, 6], matrix<float>[1; 2; 3]) onerror (err error) {
				failed++
				recover zeros(0, 0)
			}
			leastSquares(matrix<float>[1, 2, 3], matrix<float>[1]) onerror (err error) {
				failed++
				recover zeros(0, 0)
			}
			assert failed == 2
		}

		@test()
		def TestSVD() !none {
			// Up to 64 columns by rotations, beyond by the bidiagonal form;
			// tall matrices through QR, wide ones through the transpose.
			for let (_, shape) in [(1, 1), (3, 3), (40, 40), (90, 90), (9, 4), (4, 9), (150, 70), (70, 150), (120, 20)] {
				let (m, n) = shape
				let a = sample(m, n, m * 13 + n)
				let f = svd(a)
				let k = m.min(n)
				assert f.u.rows == m && f.u.cols == k && f.v.rows == n && f.v.cols == k && f.values.len() == k
				assert gap(f.u * diagonal(f.values) * f.v.transpose(), a) < 1e-10
				assert gap(f.u.transpose() * f.u, identity(k)) < 1e-10 && gap(f.v.transpose() * f.v, identity(k)) < 1e-10
				for let i = 1; i < k; i++ {
					assert f.values[i - 1] >= f.values[i] && f.values[i] >= 0.0
				}
				assert f.rank() == k
			}
			let known = svd(matrix<float>[3, 0; 0, -2; 0, 0])
			assert (known.values[0] - 3.0).abs() < 1e-14 && (known.values[1] - 2.0).abs() < 1e-14
			let low = matrix<float>[1, 2, 3; 2, 4, 6; 1, 0, 1]
			assert rank(low) == 2 && rank(zeros(3, 3)) == 0 && rank(identity(4)) == 4
			assert (condition(diagonal([8.0, 2.0])) - 4.0).abs() < 1e-12 && condition(low) > 1e15
			let pinv = pseudoInverse(low)
			assert gap(low * pinv * low, low) < 1e-12 && gap(pinv * low * pinv, pinv) < 1e-12
			let tall = sample(30, 6, 3)
			assert gap(pseudoInverse(tall) * tall, identity(6)) < 1e-11
			// A larger matrix of rank 3 keeps its rank through the bidiagonal path.
			let thin = sample(80, 3, 1) * sample(3, 80, 2)
			assert rank(thin) == 3
		}

		@test()
		def TestEigen() !none {
			let s = try eigenSymmetric(matrix<float>[2, 1; 1, 2])
			assert (s.values[0] - 1.0).abs() < 1e-14 && (s.values[1] - 3.0).abs() < 1e-14
			for let (_, n) in [1, 2, 7, 50] {
				let m = sample(n, n, n + 3)
				let a = m + m.transpose()
				let f = try eigenSymmetric(a)
				assert gap(a * f.vectors, f.vectors * diagonal(f.values)) < 1e-10
				assert gap(f.vectors.transpose() * f.vectors, identity(n)) < 1e-10
				for let i = 1; i < n; i++ {
					assert f.values[i - 1] <= f.values[i]
				}
			}
			// A rotation by a quarter turn: i and -i.
			let turn = try eigen(matrix<float>[0, -1; 1, 0])
			assert turn.values[0].real().abs() < 1e-14 && (turn.values[0].imag() - 1.0).abs() < 1e-14 && (turn.values[1].imag() + 1.0).abs() < 1e-14
			let tri = try eigen(matrix<float>[2, 5, 1; 0, -3, 4; 0, 0, 7])
			let seen float[] = []
			for let (_, z) in tri.values {
				assert z.imag() == 0.0
				seen.push(z.real())
			}
			assert seen.sort((x, y) => x < y).mapElem<string>(x => "%.6f".format(x)).join(" ") == "-3.000000 2.000000 7.000000"
			for let (_, n) in [3, 8, 40] {
				let a = sample(n, n, n + 11)
				let f = try eigen(a)
				let sum = 0.0
				let j = 0
				for j < n {
					let z = f.values[j]
					sum += z.real()
					if z.imag() == 0.0 {
						// A·v = λ·v for a real pair.
						let v = f.vectors.block(0, j, n, 1)
						assert gap(a * v, v.scale(z.real())) < 1e-9
						j++
						continue
					}
					// A·(x + iy) = (p + iq)·(x + iy): A·x = p·x - q·y, A·y = q·x + p·y.
					assert f.values[j + 1].imag() == -z.imag() && z.imag() > 0.0
					sum += z.real()
					let x = f.vectors.block(0, j, n, 1)
					let y = f.vectors.block(0, j + 1, n, 1)
					assert gap(a * x, x.scale(z.real()) - y.scale(z.imag())) < 1e-9
					assert gap(a * y, x.scale(z.imag()) + y.scale(z.real())) < 1e-9
					j += 2
				}
				assert (sum - (try trace(a))).abs() < 1e-9
			}
			let symmetric = try eigen(matrix<float>[2, 1; 1, 2])
			assert symmetric.values[1].real() == s.values[1] && symmetric.values[1].imag() == 0.0
			let failed = false
			eigen(zeros(2, 3)) onerror (err error) {
				failed = true
				recover new Eigen([], zeros(0, 0))
			}
			assert failed
		}
	}
}
