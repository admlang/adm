partial module std.math {
	// The square root of x; 0 for x of zero or less.
	def sqrt(x float) float {
		return 0.0 when x <= 0.0
		return __math_sqrt(x)
	}

	// The arc tangent of z, in radians, in the range -π/2 to π/2.
	def atan(z float) float {
		return __math_atan(z)
	}

	// The angle of the point (x, y) from the positive x axis, in radians, in the range
	// -π to π.
	def atan2(y float, x float) float {
		return __math_atan2(y, x)
	}

	// The arc cosine of x, with x clipped to -1..1 first.
	def acos(x float) float {
		return __math_acos(x.clamp(-1.0, 1.0))
	}

	// A short polynomial approximation of the sine, for small x.
	def sinPoly(x float) float {
		let x2 = x * x
		// Horner form for speed
		return x * (1.0 - x2 / 6.0 + x2 * x2 / 120.0 - x2 * x2 * x2 / 5040.0)
	}

	// The sine of x radians.
	def sin(x float) float {
		return __math_sin(x)
	}

	// The cosine of x radians.
	def cos(x float) float {
		return __math_cos(x)
	}

	// The tangent of x radians; very large near odd multiples of π/2.
	def tan(x float) float {
		return __math_tan(x)
	}

	// The hyperbolic tangent of x, between -1 and 1.
	def tanh(x float) float {
		return __math_tanh(x)
	}

	// Whether a and b differ by at most eps.
	def approx(a, b float, eps float = 1e-3) bool {
		return (a - b).abs() <= eps
	}

	// Returns the natural logarithm of a positive number.
	//
	// Returns 0 for inputs that have no logarithm (zero or negative).
	def ln(x float) float {
		return 0.0 when x <= 0.0
		return __math_log(x)
	}

	// Returns the base-10 logarithm of a positive number: 2 for 100, -3 for
	// 0.001. Decibels are 20 of these of an amplitude ratio.
	//
	// Returns 0 for inputs that have no logarithm (zero or negative).
	def log10(x float) float {
		return 0.0 when x <= 0.0
		return __math_log10(x)
	}

	// Returns the base-2 logarithm of a positive number: 10 for 1024.
	//
	// Returns 0 for inputs that have no logarithm (zero or negative).
	def log2(x float) float {
		return 0.0 when x <= 0.0
		return __math_log2(x)
	}
}
