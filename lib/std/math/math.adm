partial module std.math {
	// The square root of x by Newton's method; 0 for x of zero or less.
	def sqrt(x float) float {
		return 0.0 when x <= 0.0

		// Perform Newton-Raphson method to find square root.
		let guess = x / 2.0
		let lastGuess = 0.0
		// Iterate until the guess stabilizes
		for guess != lastGuess {
			lastGuess = guess
			guess = 0.5 * (guess + x / guess)
		}
		return guess
	}

	// The arc tangent of z, in radians, in the range -π/2 to π/2, to double
	// precision: z is reduced to |z| <= tan(π/8), where the series converges
	// fast.
	def atan(z float) float {
		return -atan(-z) when z < 0.0
		return π / 2.0 - atan(1.0 / z) when z > 1.0
		// 0 <= z <= 1 here; above tan(π/8), atan(z) = π/4 + atan((z-1)/(z+1)).
		let base = 0.0
		let v = z
		if z > 0.41421356237309503 {
			base = π / 4.0
			v = (z - 1.0) / (z + 1.0)
		}
		let v2 = v * v
		let term = v
		let sum = v
		for let n = 1; n < 40; n++ {
			term *= -v2
			let next = sum + term / float(2 * n + 1)
			break when next == sum
			sum = next
		}
		return base + sum
	}

	// The angle of the point (x, y) from the positive x axis, in radians, in the range
	// -π to π.
	def atan2(y float, x float) float {
		return atan(y / x) when x > 0.

		if x < 0.0 {
			return atan(y / x) + π when y >= 0.0
			return atan(y / x) - π
		}

		return π/2.0 when y > 0.0
		return -π/2.0 when y < 0.0

		return 0.0
	}

	// The arc cosine of x, with x clipped to -1..1 first.
	def acos(x float) float {
		let v = x
		v = 1.0 when x > 1.0
		v = -1.0 when x < -1.0

		return atan2(sqrt(1.0 - v * v), v)
	}

	// A short polynomial approximation of the sine, for small x.
	def sinPoly(x float) float {
		let x2 = x * x
		// Horner form for speed
		return x * (1.0 - x2 / 6.0 + x2 * x2 / 120.0 - x2 * x2 * x2 / 5040.0)
	}

	// The sine of x radians, by series after reducing x to -π/2..π/2.
	def sin(x float) float {
		// 1. Reduce x into [-π, π]
		let v = x % τ
		v -= τ when v > π
		v += τ when v < -π

		// 2. Reduce to [-π/2, π/2] using symmetry
		v = π -v when v > π / 2.0
		v = -π -v when v < -π / 2.0

		// 3. Taylor series to convergence: with |v| <= π/2 twelve terms
		// leave an error below 1e-16, so callers can rely on the result
		// (the FFT twiddles compound it across a whole transform).
		let x2 = v * v
		let term = v
		let sum = v
		for let i = 1; i <= 12; i++ {
			term *= -x2 / float((2 * i) * (2 * i + 1))
			sum += term
		}
		return sum
	}

	// The cosine of x radians.
	def cos(x float) float {
		return sin(π/2.0 - x)
	}

	// Whether a and b differ by at most eps.
	def approx(a, b float, eps float = 1e-3) bool {
		return (a - b).abs() <= eps
	}

	// Returns the natural logarithm of a positive number.
	//
	// Returns 0 for inputs that have no logarithm (zero or negative).
	def ln(x float) float {
		return 0.0 when x <= 0.0
		return 0.0 when x == 1.0

		// Range reduction: halve or double into [2/3, 4/3] so the series below
		// converges fast, then add back the powers of two that were removed.
		let m = x
		let k = 0
		for m > 1.3333333333333333 {
			m /= 2.0
			k += 1
		}
		for m < 0.6666666666666666 {
			m *= 2.0
			k -= 1
		}

		// atanh series: ln(m) = 2 * (z + z^3/3 + z^5/5 + ...) with z = (m-1)/(m+1).
		let z = (m - 1.0) / (m + 1.0)
		let z2 = z * z
		let term = z
		let sum = z
		for let i = 1; i <= 20; i++ {
			term *= z2
			sum += term / float(2 * i + 1)
		}
		return 2.0 * sum + float(k) * Ln2
	}

	// Returns the base-10 logarithm of a positive number: 2 for 100, -3 for
	// 0.001. Decibels are 20 of these of an amplitude ratio.
	//
	// Returns 0 for inputs that have no logarithm (zero or negative).
	def log10(x float) float {
		return ln(x) / Ln10
	}

	// Returns the base-2 logarithm of a positive number: 10 for 1024.
	//
	// Returns 0 for inputs that have no logarithm (zero or negative).
	def log2(x float) float {
		return ln(x) / Ln2
	}
}
