partial module std.math {
	use std.testing

	check "Logarithms" {
		@test()
		def TestLog10() {
			assert approx(log10(100.0), 2.0, 1e-12)
			assert approx(log10(0.001), -3.0, 1e-12)
			assert approx(log10(2.0), 0.3010299956639812, 1e-12)
			assert log10(1.0) == 0.0 && log10(0.0) == 0.0 && log10(-5.0) == 0.0
		}

		@test()
		def TestLog2() {
			assert approx(log2(1024.0), 10.0, 1e-12)
			assert approx(log2(0.125), -3.0, 1e-12)
			assert approx(log2(3.0), 1.584962500721156, 1e-12)
		}
	}

	check "Arc tangent" {
		@test()
		def atan2_to_double_precision_in_every_quadrant() {
			assert approx(atan2(10.0, 1.0), 1.4711276743037347, 1e-14)
			assert approx(atan2(1.0, 10.0), 0.09966865249116202, 1e-14)
			assert approx(atan2(-3.0, -4.0), -2.498091544796509, 1e-14)
			assert approx(atan2(3.0, -4.0), 2.498091544796509, 1e-14)
			assert approx(atan2(0.4, 1.0), 0.3805063771123649, 1e-14)
			assert approx(atan2(1.0, 1.0), 0.7853981633974483, 1e-14)
			assert approx(atan2(1e-9, 1.0), 1e-9, 1e-20)
			assert approx(atan2(-1.0, 0.0001), -1.5706963267952299, 1e-14)
			assert approx(acos(0.3), 1.2661036727794992, 1e-14)
			assert approx(acos(-0.9), 2.6905658417935308, 1e-14)
		}
	}
}
