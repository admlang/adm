partial module std.math.processing {
	use std.math::(*)

	// Computes the discrete cosine transform (DCT-II) of a real-valued
	// sequence: X[k] = sum over n of x[n] * cos(π/N * (n + 1/2) * k).
	// Direct evaluation, so it is O(n²); fine for the block sizes codecs use.
	def dct(data float64[]) float64[] {
		let n = data.len()
		let out float64[]
		out.len(n)
		return out when n == 0

		let scale = π / float(n)
		for let k = 0; k < n; k++ {
			let sum = 0.0
			for let i = 0; i < n; i++ {
				sum += float(data[i]) * cos(scale * (float(i) + 0.5) * float(k))
			}
			out[k] = float64(sum)
		}
		return out
	}

	// Computes the inverse discrete cosine transform (DCT-III), normalized so
	// that idct(dct(x)) reproduces x.
	def idct(data float64[]) float64[] {
		let n = data.len()
		let out float64[]
		out.len(n)
		return out when n == 0

		let scale = π / float(n)
		let norm = 2.0 / float(n)
		for let i = 0; i < n; i++ {
			let sum = float(data[0]) / 2.0
			for let k = 1; k < n; k++ {
				sum += float(data[k]) * cos(scale * (float(i) + 0.5) * float(k))
			}
			out[i] = float64(sum * norm)
		}
		return out
	}
}
