partial module std.math.processing {
	use (
		std.testing
		std.math::(*)
	)

	check "DCT" {
		@test()
		def constant_is_dc_only() {
			let x = float64[3.0, 3.0, 3.0, 3.0]
			let c = dct(x)
			assert c.len() == 4
			assert approx(float(c[0]), 12.0, 1e-9)
			for let k = 1; k < 4; k++ {
				assert approx(float(c[k]), 0.0, 1e-9)
			}
		}

		@test()
		def idct_inverts_dct() {
			let x = float64[1.0, -2.5, 0.25, 4.0, 3.5, -1.0, 0.0, 2.0]
			let back = idct(dct(x))
			assert back.len() == 8
			for let i = 0; i < 8; i++ {
				assert approx(float(back[i]), float(x[i]), 1e-9)
			}
		}

		@test()
		def works_on_any_length() {
			let x = float64[1.0, 2.0, 3.0]
			let back = idct(dct(x))
			assert back.len() == 3
			assert approx(float(back[1]), 2.0, 1e-9)
		}

		@test()
		def empty_input_is_empty_output() {
			let x float64[]
			assert dct(x).len() == 0
			assert idct(x).len() == 0
		}
	}
}
