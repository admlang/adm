partial module std.math.processing {
	use (
		std.math::(*)
		std.math.processing.fourier::*
	)

	// Computes the discrete Fourier transform of the input using the Fast Fourier
	// Transform algorithm.
	//
	// Converts samples from their original domain, typically time or space,
	// into the frequency domain. Each returned complex value describes the
	// amplitude and phase of a frequency component present in the input.
	// Any length works; lengths whose prime factors are small are fastest.
	def fft<T: Complex>(data T[]) T[] {
		return transformed(data, false)
	}

	// Computes the inverse discrete Fourier transform using the Fast Fourier
	// Transform algorithm.
	//
	// Converts frequency-domain values back into their original domain,
	// reconstructing the original time- or spatial-domain samples (scaled by
	// 1/n, so `ifft(fft(x))` is `x`).
	def ifft<T: Complex>(data T[]) T[] {
		return transformed(data, true)
	}

	// Computes the Fourier transform of real-valued input.
	// The returned values contain the complex frequency coefficients: the
	// `n/2 + 1` non-redundant bins, the rest being their conjugate mirror.
	def rfft(data float16[]) complex32[] {
		let wide float[]
		wide.len(data.len())
		for let i = 0; i < data.len(); i++ {
			wide[i] = float(data[i])
		}
		return narrow<complex32>(realSpectrum(wide))
	}

	// The transform of real samples as complex values.
	def rfft(data float32[]) complex64[] {
		let wide float[]
		wide.len(data.len())
		for let i = 0; i < data.len(); i++ {
			wide[i] = float(data[i])
		}
		return narrow<complex64>(realSpectrum(wide))
	}

	// The transform of real samples as complex values.
	def rfft(data float64[]) complex128[] {
		let wide float[]
		wide.len(data.len())
		for let i = 0; i < data.len(); i++ {
			wide[i] = float(data[i])
		}
		return realSpectrum(wide)
	}

	// Reconstructs a real-valued sequence from frequency-domain coefficients
	// produced by rfft. `half` bins describe 2 · (half - 1) samples.
	def irfft(data complex32[]) float16[] {
		let out = realSignal(widen(data))
		let narrowed float16[]
		narrowed.len(out.len())
		for let i = 0; i < out.len(); i++ {
			narrowed[i] = float16(out[i])
		}
		return narrowed
	}

	// The real samples behind a transform produced by `rfft`.
	def irfft(data complex64[]) float32[] {
		let out = realSignal(widen(data))
		let narrowed float32[]
		narrowed.len(out.len())
		for let i = 0; i < out.len(); i++ {
			narrowed[i] = float32(out[i])
		}
		return narrowed
	}

	// The real samples behind a transform produced by `rfft`.
	def irfft(data complex128[]) float64[] {
		let out = realSignal(data)
		let narrowed float64[]
		narrowed.len(out.len())
		for let i = 0; i < out.len(); i++ {
			narrowed[i] = float64(out[i])
		}
		return narrowed
	}

	// A discrete Fourier transform of one length and direction, planned
	// once (factors and twiddles) and then run on many inputs of that
	// length, the way a spectrogram transforms frame after frame.
	//
	// Lengths whose prime factors are at most 31 run as mixed-radix
	// stages (radix 4, 2, 3 and 5 butterflies, the other primes as direct
	// sums), any other length through Bluestein's algorithm over a power
	// of two. The inverse is scaled by 1/size, so it undoes the forward
	// transform. A plan keeps work arrays, so it runs on one task at a
	// time; `copy` gives another task its own.
	type Fourier {
		size              int
		inverse           bool
		internal radices  int[]
		// e^(∓2πik/size), k < size: a stage of length n = size/s takes its
		// twiddles w^(p·j) = e^(∓2πi·p·j/n) at p·j·s.
		internal circleRe float[]
		internal circleIm float[]
		// Bluestein: the transform of the padded length, the chirp
		// e^(∓iπk²/size) and the spectrum of its conjugate, scaled by
		// 1/padded.
		internal padded   ?Fourier
		internal chirpRe  float[]
		internal chirpIm  float[]
		internal kernelRe float[]
		internal kernelIm float[]
		internal workRe   float[]
		internal workIm   float[]
		internal otherRe  float[]
		internal otherIm  float[]

		// A plan for transforms of `size` values, forward or inverse.
		def new(size int, inverse bool = false) {
			self.size = size.max(0)
			self.inverse = inverse
			return when self.size < 2
			let sign = inverse ?? (1.0, -1.0)
			let factors = factorize(self.size)
			if factors.len() == 0 {
				planBluestein(sign)
				return
			}
			radices = factors
			(circleRe, circleIm) = unitCircle(self.size, sign)
			workRe.len(self.size)
			workIm.len(self.size)
		}

		// Another plan of the same transform for another task: it shares
		// this plan's tables and has its own work arrays.
		def copy() Fourier {
			let other = new Fourier(0, inverse)
			other.size = size
			other.radices = radices
			other.circleRe = circleRe
			other.circleIm = circleIm
			other.chirpRe = chirpRe
			other.chirpIm = chirpIm
			other.kernelRe = kernelRe
			other.kernelIm = kernelIm
			let inner = padded
			if inner is Fourier {
				other.padded = inner.copy()
				other.otherRe.len(inner.size)
				other.otherIm.len(inner.size)
			}
			other.workRe.len(workRe.len())
			other.workIm.len(workIm.len())
			return other
		}

		// Transforms re + i·im (`size` values each) in place.
		def run(re float[], im float[]) {
			return when size < 2
			let inner = padded
			if inner is Fourier {
				bluestein(inner, re, im)
			} else {
				stages(re, im)
			}
			scale(re, im, 1.0 / float(size), size) when inverse
		}

		// The mixed-radix stages (Stockham's self-sorting order: each
		// stage reads one buffer and writes the other, so the output
		// comes out in natural order with no bit reversal).
		internal def stages(re float[], im float[]) {
			let (xr, xi, yr, yi) = (re, im, workRe, workIm)
			let s = 1
			let n = size
			let (tr, ti) = (circleRe, circleIm)
			for let (_, r) in radices {
				let m = n / r
				let sign = inverse ?? (1.0, -1.0)
				let tasks = (size / fourierBand).clamp(1, 32)
				if tasks == 1 {
					butterflies(xr, xi, yr, yi, tr, ti, r, m, s, 0, m, 0, s, sign)
				} else if m >= tasks {
					forall let b in 0..tasks {
						butterflies(xr, xi, yr, yi, tr, ti, r, m, s, m * b / tasks, m * (b + 1) / tasks, 0, s, sign)
					}
				} else {
					// Few butterflies a stage, each long: split along q in
					// whole vectors.
					let quads = (s + 3) / 4
					forall let b in 0..tasks {
						let q0 = (4 * (quads * b / tasks)).min(s)
						let q1 = (4 * (quads * (b + 1) / tasks)).min(s)
						butterflies(xr, xi, yr, yi, tr, ti, r, m, s, 0, m, q0, q1, sign)
					}
				}
				let (fromRe, fromIm) = (xr, xi)
				(xr, xi) = (yr, yi)
				(yr, yi) = (fromRe, fromIm)
				s *= r
				n = m
			}
			if radices.len() % 2 == 1 {
				workRe[0:size].copy(re)
				workIm[0:size].copy(im)
			}
		}

		// Bluestein: X_k = chirp_k · (a ⊛ conj(chirp))_k with a_j = x_j ·
		// chirp_j, the convolution through two transforms of the padded
		// length (the inverse one run forward on the conjugate).
		internal def bluestein(inner Fourier, re float[], im float[]) {
			let n = inner.size
			chirped(re, im, chirpRe, chirpIm, otherRe, otherIm, size, n)
			inner.run(otherRe, otherIm)
			convolved(otherRe, otherIm, kernelRe, kernelIm, n)
			inner.run(otherRe, otherIm)
			for let j = 0; j < size; j++ {
				let (cr, ci) = (otherRe[j], -otherIm[j])
				let (zr, zi) = (chirpRe[j], chirpIm[j])
				re[j] = cr * zr - ci * zi
				im[j] = cr * zi + ci * zr
			}
		}

		internal def planBluestein(sign float) {
			let n = 1
			for n < 2 * size - 1 {
				n *= 2
			}
			let inner = new Fourier(n)
			chirpRe.len(size)
			chirpIm.len(size)
			for let k = 0; k < size; k++ {
				// k² mod 2·size keeps the angle exact for large k.
				let angle = π * float((k * k) % (2 * size)) / float(size)
				chirpRe[k] = cos(angle)
				chirpIm[k] = sign * sin(angle)
			}
			kernelRe.len(n)
			kernelIm.len(n)
			kernelRe[0] = chirpRe[0]
			kernelIm[0] = -chirpIm[0]
			for let k = 1; k < size; k++ {
				kernelRe[k] = chirpRe[k]
				kernelIm[k] = -chirpIm[k]
				kernelRe[n - k] = chirpRe[k]
				kernelIm[n - k] = -chirpIm[k]
			}
			inner.run(kernelRe, kernelIm)
			scale(kernelRe, kernelIm, 1.0 / float(n), n)
			padded = inner
			otherRe.len(n)
			otherIm.len(n)
		}
	}
}

internal partial module std.math.processing.fourier {
	use (
		std.math::(*)
		std.simd
		std.sync
		std.math.processing::*
	)

	// Plans `fft` and its relatives made, by 2 · length + inverse, so
	// calls of one length plan once. Their lengths add up to at most
	// cachedValues (a plan's tables hold 16 bytes a value); the oldest
	// plans leave to make room, and a longer length is planned per call.
	internal let plans = new map<int, Fourier>()
	internal let plansLock = new sync.Mutex()
	internal let plannedValues = 0
	const cachedValues = 1 << 21

	// A plan of length n for one call: the cached plan's tables with
	// work arrays of its own.
	def planFor(n int, inverse bool) Fourier {
		return new Fourier(n, inverse) when n > cachedValues
		let key = 2 * n + (inverse ?? (1, 0))
		plansLock.lock()
		let found = plans.get(key)
		plansLock.unlock()
		return found.copy() when found is Fourier
		let plan = new Fourier(n, inverse)
		plansLock.lock()
		for plannedValues + n > cachedValues {
			let oldest = plans.keys()[0]
			let gone = plans.get(oldest)
			plannedValues -= gone is Fourier ?? (gone.size, 0)
			plans.delete(oldest)
		}
		plannedValues += n
		plans.set(key, plan)
		plansLock.unlock()
		return plan.copy()
	}

	// Values per task from which a stage splits into bands on tasks.
	const fourierBand = 1 << 16

	// The largest prime a stage handles as a direct sum; a length with a
	// larger prime factor goes through Bluestein.
	const largestRadix = 31

	// The radices of `n`, fours first, then a two, then the odd primes
	// in increasing order; empty when a prime factor exceeds largestRadix.
	def factorize(n int) int[] {
		let out int[]
		let rest = n
		for rest % 4 == 0 {
			out.push(4)
			rest /= 4
		}
		if rest % 2 == 0 {
			out.push(2)
			rest /= 2
		}
		for let p = 3; p <= largestRadix && rest > 1; p += 2 {
			for rest % p == 0 {
				out.push(p)
				rest /= p
			}
		}
		return int[] when rest > 1
		return out
	}

	// cos and sign·sin of 2πk/n for k < n. With n a multiple of 8 only
	// the first eighth of the circle is computed and the rest follows by
	// symmetry, exactly.
	def unitCircle(n int, sign float) (float[], float[]) {
		let c float[]
		let s float[]
		c.len(n)
		s.len(n)
		if n % 8 != 0 {
			for let k = 0; k < n; k++ {
				let angle = 2.0 * π * float(k) / float(n)
				c[k] = cos(angle)
				s[k] = sin(angle)
			}
		} else {
			let eighth = n / 8
			for let k = 0; k <= eighth; k++ {
				let angle = 2.0 * π * float(k) / float(n)
				c[k] = cos(angle)
				s[k] = sin(angle)
			}
			for let k = eighth + 1; k <= 2 * eighth; k++ {
				c[k] = s[2 * eighth - k]
				s[k] = c[2 * eighth - k]
			}
			for let k = 2 * eighth + 1; k <= 4 * eighth; k++ {
				c[k] = -c[4 * eighth - k]
				s[k] = s[4 * eighth - k]
			}
			for let k = 4 * eighth + 1; k < n; k++ {
				c[k] = c[n - k]
				s[k] = -s[n - k]
			}
		}
		if sign < 0.0 {
			let i = 0
			let flip = simd.splat4<float>(-1.0)
			for; i + 4 <= n; i += 4 {
				simd.store4<float>(s, i, simd.load4<float>(s, i) * flip)
			}
			for; i < n; i++ {
				s[i] = -s[i]
			}
		}
		return (c, s)
	}

	// One stage of radix r over butterflies p0..p1 and offsets q0..q1:
	// a_k = x[q + s·(p + k·m)], y[q + s·(r·p + j)] = w^(p·j) · Σ_k a_k ·
	// e^(∓2πijk/r), with w^(p·j) at p·j·s of the unit circle tr/ti of
	// the plan's length r·m·s.
	def butterflies(xr float[], xi float[], yr float[], yi float[], tr float[], ti float[], r int, m int, s int, p0 int, p1 int, q0 int, q1 int, sign float) {
		match r {
			case 4:
				radix4(xr, xi, yr, yi, tr, ti, m, s, p0, p1, q0, q1, sign)
			case 2:
				radix2(xr, xi, yr, yi, tr, ti, m, s, p0, p1, q0, q1)
			case 3:
				radix3(xr, xi, yr, yi, tr, ti, m, s, p0, p1, q0, q1, sign)
			case 5:
				radix5(xr, xi, yr, yi, tr, ti, m, s, p0, p1, q0, q1, sign)
			default:
				radixPrime(xr, xi, yr, yi, tr, ti, r, m, s, p0, p1, q0, q1)
		}
	}

	def radix2(xr float[], xi float[], yr float[], yi float[], tr float[], ti float[], m int, s int, p0 int, p1 int, q0 int, q1 int) {
		for let p = p0; p < p1; p++ {
			let (wr, wi) = (tr[p * s], ti[p * s])
			let (a0, a1, b0) = (s * p, s * (p + m), 2 * s * p)
			let b1 = b0 + s
			let q = q0
			if q1 - q0 >= 4 {
				let (vr, vi) = (simd.splat4<float>(wr), simd.splat4<float>(wi))
				for; q + 4 <= q1; q += 4 {
					let (ur, ui) = (simd.load4<float>(xr, a0 + q), simd.load4<float>(xi, a0 + q))
					let (zr, zi) = (simd.load4<float>(xr, a1 + q), simd.load4<float>(xi, a1 + q))
					simd.store4<float>(yr, b0 + q, ur + zr)
					simd.store4<float>(yi, b0 + q, ui + zi)
					let (dr, di) = (ur - zr, ui - zi)
					simd.store4<float>(yr, b1 + q, dr * vr - di * vi)
					simd.store4<float>(yi, b1 + q, dr * vi + di * vr)
				}
			}
			for; q < q1; q++ {
				let (ur, ui, zr, zi) = (xr[a0 + q], xi[a0 + q], xr[a1 + q], xi[a1 + q])
				yr[b0 + q] = ur + zr
				yi[b0 + q] = ui + zi
				let (dr, di) = (ur - zr, ui - zi)
				yr[b1 + q] = dr * wr - di * wi
				yi[b1 + q] = dr * wi + di * wr
			}
		}
	}

	// Radix 4: with t0 = a0 + a2, t1 = a0 - a2, t2 = a1 + a3 and t3 =
	// ∓i·(a1 - a3), y0 = t0 + t2, y1 = t1 + t3, y2 = t0 - t2, y3 = t1 - t3.
	def radix4(xr float[], xi float[], yr float[], yi float[], tr float[], ti float[], m int, s int, p0 int, p1 int, q0 int, q1 int, sign float) {
		for let p = p0; p < p1; p++ {
			let at = p * s
			let (w1r, w1i, w2r, w2i, w3r, w3i) = (tr[at], ti[at], tr[2 * at], ti[2 * at], tr[3 * at], ti[3 * at])
			let (a0, a1, a2, a3) = (s * p, s * (p + m), s * (p + 2 * m), s * (p + 3 * m))
			let b0 = 4 * s * p
			let (b1, b2, b3) = (b0 + s, b0 + 2 * s, b0 + 3 * s)
			let q = q0
			if q1 - q0 >= 4 {
				let (v1r, v1i) = (simd.splat4<float>(w1r), simd.splat4<float>(w1i))
				let (v2r, v2i) = (simd.splat4<float>(w2r), simd.splat4<float>(w2i))
				let (v3r, v3i) = (simd.splat4<float>(w3r), simd.splat4<float>(w3i))
				let turn = simd.splat4<float>(sign)
				for; q + 4 <= q1; q += 4 {
					let (x0r, x0i) = (simd.load4<float>(xr, a0 + q), simd.load4<float>(xi, a0 + q))
					let (x1r, x1i) = (simd.load4<float>(xr, a1 + q), simd.load4<float>(xi, a1 + q))
					let (x2r, x2i) = (simd.load4<float>(xr, a2 + q), simd.load4<float>(xi, a2 + q))
					let (x3r, x3i) = (simd.load4<float>(xr, a3 + q), simd.load4<float>(xi, a3 + q))
					let (t0r, t0i, t1r, t1i) = (x0r + x2r, x0i + x2i, x0r - x2r, x0i - x2i)
					let (t2r, t2i) = (x1r + x3r, x1i + x3i)
					// ∓i·d: (d.im, -d.re) forward, (-d.im, d.re) inverse.
					let (t3r, t3i) = ((x3i - x1i) * turn, (x1r - x3r) * turn)
					simd.store4<float>(yr, b0 + q, t0r + t2r)
					simd.store4<float>(yi, b0 + q, t0i + t2i)
					let (y1r, y1i, y2r, y2i, y3r, y3i) = (t1r + t3r, t1i + t3i, t0r - t2r, t0i - t2i, t1r - t3r, t1i - t3i)
					simd.store4<float>(yr, b1 + q, y1r * v1r - y1i * v1i)
					simd.store4<float>(yi, b1 + q, y1r * v1i + y1i * v1r)
					simd.store4<float>(yr, b2 + q, y2r * v2r - y2i * v2i)
					simd.store4<float>(yi, b2 + q, y2r * v2i + y2i * v2r)
					simd.store4<float>(yr, b3 + q, y3r * v3r - y3i * v3i)
					simd.store4<float>(yi, b3 + q, y3r * v3i + y3i * v3r)
				}
			}
			for; q < q1; q++ {
				let (x0r, x0i, x1r, x1i) = (xr[a0 + q], xi[a0 + q], xr[a1 + q], xi[a1 + q])
				let (x2r, x2i, x3r, x3i) = (xr[a2 + q], xi[a2 + q], xr[a3 + q], xi[a3 + q])
				let (t0r, t0i, t1r, t1i) = (x0r + x2r, x0i + x2i, x0r - x2r, x0i - x2i)
				let (t2r, t2i) = (x1r + x3r, x1i + x3i)
				let (t3r, t3i) = ((x3i - x1i) * sign, (x1r - x3r) * sign)
				yr[b0 + q] = t0r + t2r
				yi[b0 + q] = t0i + t2i
				let (y1r, y1i, y2r, y2i, y3r, y3i) = (t1r + t3r, t1i + t3i, t0r - t2r, t0i - t2i, t1r - t3r, t1i - t3i)
				yr[b1 + q] = y1r * w1r - y1i * w1i
				yi[b1 + q] = y1r * w1i + y1i * w1r
				yr[b2 + q] = y2r * w2r - y2i * w2i
				yi[b2 + q] = y2r * w2i + y2i * w2r
				yr[b3 + q] = y3r * w3r - y3i * w3i
				yi[b3 + q] = y3r * w3i + y3i * w3r
			}
		}
	}

	// Radix 3: with b = a1 + a2, d = a1 - a2 and c = a0 - b/2,
	// y0 = a0 + b, y1 = c ± i·(√3/2)·d, y2 = c ∓ i·(√3/2)·d.
	def radix3(xr float[], xi float[], yr float[], yi float[], tr float[], ti float[], m int, s int, p0 int, p1 int, q0 int, q1 int, sign float) {
		let h = sign * sqrt(3.0) / 2.0
		for let p = p0; p < p1; p++ {
			let at = p * s
			let (w1r, w1i, w2r, w2i) = (tr[at], ti[at], tr[2 * at], ti[2 * at])
			let (a0, a1, a2) = (s * p, s * (p + m), s * (p + 2 * m))
			let b0 = 3 * s * p
			let (b1, b2) = (b0 + s, b0 + 2 * s)
			let q = q0
			if q1 - q0 >= 4 {
				let (v1r, v1i) = (simd.splat4<float>(w1r), simd.splat4<float>(w1i))
				let (v2r, v2i) = (simd.splat4<float>(w2r), simd.splat4<float>(w2i))
				let (vh, half) = (simd.splat4<float>(h), simd.splat4<float>(0.5))
				for; q + 4 <= q1; q += 4 {
					let (x0r, x0i) = (simd.load4<float>(xr, a0 + q), simd.load4<float>(xi, a0 + q))
					let (x1r, x1i) = (simd.load4<float>(xr, a1 + q), simd.load4<float>(xi, a1 + q))
					let (x2r, x2i) = (simd.load4<float>(xr, a2 + q), simd.load4<float>(xi, a2 + q))
					let (sr, si, dr, di) = (x1r + x2r, x1i + x2i, x1r - x2r, x1i - x2i)
					simd.store4<float>(yr, b0 + q, x0r + sr)
					simd.store4<float>(yi, b0 + q, x0i + si)
					let (cr, ci) = (x0r - sr * half, x0i - si * half)
					let (er, ei) = (di * vh, dr * vh)
					let (y1r, y1i, y2r, y2i) = (cr - er, ci + ei, cr + er, ci - ei)
					simd.store4<float>(yr, b1 + q, y1r * v1r - y1i * v1i)
					simd.store4<float>(yi, b1 + q, y1r * v1i + y1i * v1r)
					simd.store4<float>(yr, b2 + q, y2r * v2r - y2i * v2i)
					simd.store4<float>(yi, b2 + q, y2r * v2i + y2i * v2r)
				}
			}
			for; q < q1; q++ {
				let (x0r, x0i, x1r, x1i, x2r, x2i) = (xr[a0 + q], xi[a0 + q], xr[a1 + q], xi[a1 + q], xr[a2 + q], xi[a2 + q])
				let (sr, si, dr, di) = (x1r + x2r, x1i + x2i, x1r - x2r, x1i - x2i)
				yr[b0 + q] = x0r + sr
				yi[b0 + q] = x0i + si
				let (cr, ci) = (x0r - 0.5 * sr, x0i - 0.5 * si)
				let (er, ei) = (h * di, h * dr)
				let (y1r, y1i, y2r, y2i) = (cr - er, ci + ei, cr + er, ci - ei)
				yr[b1 + q] = y1r * w1r - y1i * w1i
				yi[b1 + q] = y1r * w1i + y1i * w1r
				yr[b2 + q] = y2r * w2r - y2i * w2i
				yi[b2 + q] = y2r * w2i + y2i * w2r
			}
		}
	}

	// Radix 5: with b1 = a1 + a4, b2 = a2 + a3, d1 = a1 - a4, d2 = a2 - a3,
	// c = cos(2π/5), c' = cos(4π/5) and σ, σ' = ±sin(2π/5), ±sin(4π/5):
	// y1, y4 = a0 + c·b1 + c'·b2 ± i·(σ·d1 + σ'·d2) and
	// y2, y3 = a0 + c'·b1 + c·b2 ± i·(σ'·d1 - σ·d2).
	def radix5(xr float[], xi float[], yr float[], yi float[], tr float[], ti float[], m int, s int, p0 int, p1 int, q0 int, q1 int, sign float) {
		let (c1, c2) = (cos(2.0 * π / 5.0), cos(4.0 * π / 5.0))
		let (s1, s2) = (sign * sin(2.0 * π / 5.0), sign * sin(4.0 * π / 5.0))
		for let p = p0; p < p1; p++ {
			let at = p * s
			let (w1r, w1i, w2r, w2i) = (tr[at], ti[at], tr[2 * at], ti[2 * at])
			let (w3r, w3i, w4r, w4i) = (tr[3 * at], ti[3 * at], tr[4 * at], ti[4 * at])
			let (a0, a1, a2, a3, a4) = (s * p, s * (p + m), s * (p + 2 * m), s * (p + 3 * m), s * (p + 4 * m))
			let b0 = 5 * s * p
			let q = q0
			if q1 - q0 >= 4 {
				let (k1, k2, n1, n2) = (simd.splat4<float>(c1), simd.splat4<float>(c2), simd.splat4<float>(s1), simd.splat4<float>(s2))
				let (v1r, v1i, v2r, v2i) = (simd.splat4<float>(w1r), simd.splat4<float>(w1i), simd.splat4<float>(w2r), simd.splat4<float>(w2i))
				let (v3r, v3i, v4r, v4i) = (simd.splat4<float>(w3r), simd.splat4<float>(w3i), simd.splat4<float>(w4r), simd.splat4<float>(w4i))
				for; q + 4 <= q1; q += 4 {
					let (x0r, x0i) = (simd.load4<float>(xr, a0 + q), simd.load4<float>(xi, a0 + q))
					let (x1r, x1i) = (simd.load4<float>(xr, a1 + q), simd.load4<float>(xi, a1 + q))
					let (x2r, x2i) = (simd.load4<float>(xr, a2 + q), simd.load4<float>(xi, a2 + q))
					let (x3r, x3i) = (simd.load4<float>(xr, a3 + q), simd.load4<float>(xi, a3 + q))
					let (x4r, x4i) = (simd.load4<float>(xr, a4 + q), simd.load4<float>(xi, a4 + q))
					let (e1r, e1i, e2r, e2i) = (x1r + x4r, x1i + x4i, x2r + x3r, x2i + x3i)
					let (d1r, d1i, d2r, d2i) = (x1r - x4r, x1i - x4i, x2r - x3r, x2i - x3i)
					simd.store4<float>(yr, b0 + q, x0r + e1r + e2r)
					simd.store4<float>(yi, b0 + q, x0i + e1i + e2i)
					let (r1r, r1i) = (x0r + k1 * e1r + k2 * e2r, x0i + k1 * e1i + k2 * e2i)
					let (r2r, r2i) = (x0r + k2 * e1r + k1 * e2r, x0i + k2 * e1i + k1 * e2i)
					// i·(u): (-u.im, u.re).
					let (i1r, i1i) = (n1 * d1r + n2 * d2r, n1 * d1i + n2 * d2i)
					let (i2r, i2i) = (n2 * d1r - n1 * d2r, n2 * d1i - n1 * d2i)
					let (y1r, y1i, y4r, y4i) = (r1r - i1i, r1i + i1r, r1r + i1i, r1i - i1r)
					let (y2r, y2i, y3r, y3i) = (r2r - i2i, r2i + i2r, r2r + i2i, r2i - i2r)
					simd.store4<float>(yr, b0 + s + q, y1r * v1r - y1i * v1i)
					simd.store4<float>(yi, b0 + s + q, y1r * v1i + y1i * v1r)
					simd.store4<float>(yr, b0 + 2 * s + q, y2r * v2r - y2i * v2i)
					simd.store4<float>(yi, b0 + 2 * s + q, y2r * v2i + y2i * v2r)
					simd.store4<float>(yr, b0 + 3 * s + q, y3r * v3r - y3i * v3i)
					simd.store4<float>(yi, b0 + 3 * s + q, y3r * v3i + y3i * v3r)
					simd.store4<float>(yr, b0 + 4 * s + q, y4r * v4r - y4i * v4i)
					simd.store4<float>(yi, b0 + 4 * s + q, y4r * v4i + y4i * v4r)
				}
			}
			for; q < q1; q++ {
				let (x0r, x0i, x1r, x1i) = (xr[a0 + q], xi[a0 + q], xr[a1 + q], xi[a1 + q])
				let (x2r, x2i, x3r, x3i) = (xr[a2 + q], xi[a2 + q], xr[a3 + q], xi[a3 + q])
				let (x4r, x4i) = (xr[a4 + q], xi[a4 + q])
				let (e1r, e1i, e2r, e2i) = (x1r + x4r, x1i + x4i, x2r + x3r, x2i + x3i)
				let (d1r, d1i, d2r, d2i) = (x1r - x4r, x1i - x4i, x2r - x3r, x2i - x3i)
				yr[b0 + q] = x0r + e1r + e2r
				yi[b0 + q] = x0i + e1i + e2i
				let (r1r, r1i) = (x0r + c1 * e1r + c2 * e2r, x0i + c1 * e1i + c2 * e2i)
				let (r2r, r2i) = (x0r + c2 * e1r + c1 * e2r, x0i + c2 * e1i + c1 * e2i)
				let (i1r, i1i) = (s1 * d1r + s2 * d2r, s1 * d1i + s2 * d2i)
				let (i2r, i2i) = (s2 * d1r - s1 * d2r, s2 * d1i - s1 * d2i)
				let (y1r, y1i, y4r, y4i) = (r1r - i1i, r1i + i1r, r1r + i1i, r1i - i1r)
				let (y2r, y2i, y3r, y3i) = (r2r - i2i, r2i + i2r, r2r + i2i, r2i - i2r)
				yr[b0 + s + q] = y1r * w1r - y1i * w1i
				yi[b0 + s + q] = y1r * w1i + y1i * w1r
				yr[b0 + 2 * s + q] = y2r * w2r - y2i * w2i
				yi[b0 + 2 * s + q] = y2r * w2i + y2i * w2r
				yr[b0 + 3 * s + q] = y3r * w3r - y3i * w3i
				yi[b0 + 3 * s + q] = y3r * w3i + y3i * w3r
				yr[b0 + 4 * s + q] = y4r * w4r - y4i * w4i
				yi[b0 + 4 * s + q] = y4r * w4i + y4i * w4r
			}
		}
	}

	// An odd prime radix r above 5 as a direct sum over the roots
	// e^(∓2πie/r), at e·m·s of the unit circle.
	def radixPrime(xr float[], xi float[], yr float[], yi float[], tr float[], ti float[], r int, m int, s int, p0 int, p1 int, q0 int, q1 int) {
		let root = m * s
		for let p = p0; p < p1; p++ {
			let b0 = r * s * p
			for let j = 0; j < r; j++ {
				let (wr, wi) = (tr[p * j * s], ti[p * j * s])
				let q = q0
				if q1 - q0 >= 4 {
					let (vr, vi) = (simd.splat4<float>(wr), simd.splat4<float>(wi))
					for; q + 4 <= q1; q += 4 {
						let sr = simd.splat4<float>(0.0)
						let si = simd.splat4<float>(0.0)
						let e = 0
						for let k = 0; k < r; k++ {
							let (ar, ai) = (simd.load4<float>(xr, s * (p + k * m) + q), simd.load4<float>(xi, s * (p + k * m) + q))
							let (cr, ci) = (simd.splat4<float>(tr[e * root]), simd.splat4<float>(ti[e * root]))
							sr = sr + ar * cr - ai * ci
							si = si + ar * ci + ai * cr
							e += j
							e -= r when e >= r
						}
						simd.store4<float>(yr, b0 + j * s + q, sr * vr - si * vi)
						simd.store4<float>(yi, b0 + j * s + q, sr * vi + si * vr)
					}
				}
				for; q < q1; q++ {
					let (sr, si) = (0.0, 0.0)
					let e = 0
					for let k = 0; k < r; k++ {
						let (ar, ai) = (xr[s * (p + k * m) + q], xi[s * (p + k * m) + q])
						let (cr, ci) = (tr[e * root], ti[e * root])
						sr += ar * cr - ai * ci
						si += ar * ci + ai * cr
						e += j
						e -= r when e >= r
					}
					yr[b0 + j * s + q] = sr * wr - si * wi
					yi[b0 + j * s + q] = sr * wi + si * wr
				}
			}
		}
	}

	// x · chirp into the first `size` values of out, zeros up to n.
	def chirped(re float[], im float[], cr float[], ci float[], outRe float[], outIm float[], size int, n int) {
		for let k = 0; k < size; k++ {
			let (xr, xi, zr, zi) = (re[k], im[k], cr[k], ci[k])
			outRe[k] = xr * zr - xi * zi
			outIm[k] = xr * zi + xi * zr
		}
		for let k = size; k < n; k++ {
			outRe[k] = 0.0
			outIm[k] = 0.0
		}
	}

	// The conjugate of x · kernel, in place.
	def convolved(re float[], im float[], kr float[], ki float[], n int) {
		let zero = simd.splat4<float>(0.0)
		let k = 0
		for; k + 4 <= n; k += 4 {
			let (xr, xi) = (simd.load4<float>(re, k), simd.load4<float>(im, k))
			let (cr, ci) = (simd.load4<float>(kr, k), simd.load4<float>(ki, k))
			simd.store4<float>(re, k, xr * cr - xi * ci)
			simd.store4<float>(im, k, zero - (xr * ci + xi * cr))
		}
		for; k < n; k++ {
			let (xr, xi, cr, ci) = (re[k], im[k], kr[k], ki[k])
			re[k] = xr * cr - xi * ci
			im[k] = -(xr * ci + xi * cr)
		}
	}

	// Both arrays' first n values times `by`.
	def scale(re float[], im float[], by float, n int) {
		let v = simd.splat4<float>(by)
		let i = 0
		for; i + 4 <= n; i += 4 {
			simd.store4<float>(re, i, simd.load4<float>(re, i) * v)
			simd.store4<float>(im, i, simd.load4<float>(im, i) * v)
		}
		for; i < n; i++ {
			re[i] *= by
			im[i] *= by
		}
	}

	// The transform of any complex kind, through a plan of its length.
	def transformed<T: Complex>(data T[], inverse bool) T[] {
		let n = data.len()
		let re float[]
		let im float[]
		re.len(n)
		im.len(n)
		for let i = 0; i < n; i++ {
			let z = complex128(data[i])
			re[i] = z.real()
			im[i] = z.imag()
		}
		planFor(n, inverse).run(re, im)
		let out T[]
		out.len(n)
		for let i = 0; i < n; i++ {
			out[i] = T(complex(re[i], im[i]))
		}
		return out
	}

	// The n/2 + 1 bins of the transform of real samples.
	def realSpectrum(data float[]) complex128[] {
		let n = data.len()
		return complex128[] when n == 0
		let re = data.clone()
		let im float[]
		im.len(n)
		planFor(n, false).run(re, im)
		let out complex128[]
		out.len(n / 2 + 1)
		for let i = 0; i < out.len(); i++ {
			out[i] = complex(re[i], im[i])
		}
		return out
	}

	// The 2 · (half - 1) real samples whose spectrum's first half bins
	// are `data`, the rest being their conjugate mirror.
	def realSignal(data complex128[]) float[] {
		let half = data.len()
		return float[] when half < 2
		let n = 2 * (half - 1)
		let re float[]
		let im float[]
		re.len(n)
		im.len(n)
		for let i = 0; i < half; i++ {
			re[i] = data[i].real()
			im[i] = data[i].imag()
		}
		for let i = 1; i < half - 1; i++ {
			re[n - i] = re[i]
			im[n - i] = -im[i]
		}
		planFor(n, true).run(re, im)
		return re
	}

	// A complex128 buffer converted to the requested complex kind.
	def narrow<T: Complex>(buf complex128[]) T[] {
		let out T[]
		out.len(buf.len())
		for let i = 0; i < buf.len(); i++ {
			out[i] = T(buf[i])
		}
		return out
	}

	// Any complex kind widened to complex128.
	def widen<T: Complex>(data T[]) complex128[] {
		let out complex128[]
		out.len(data.len())
		for let i = 0; i < data.len(); i++ {
			out[i] = complex128(data[i])
		}
		return out
	}
}
