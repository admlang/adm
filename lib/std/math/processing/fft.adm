partial module std.math.processing {
	use (
		std.math::(*)
		std.simd
		std.math.processing.fourier::*
	)

	// Computes the discrete Fourier transform of the input using the Fast Fourier
	// Transform algorithm.
	//
	// Converts samples from their original domain, typically time or space,
	// into the frequency domain. Each returned complex value describes the
	// amplitude and phase of a frequency component present in the input.
	//
	// Fails when the length is not a power of two.
	def fft<T: Complex>(data T[]) !T[] {
		let n = data.len()
		return T[] when n == 0

		fail "FFT input length must be a power of two" when (n & (n - 1)) != 0

		let re float64[]
		re.len(n)
		let im float64[]
		im.len(n)
		splitInto(data, re, im)
		transformSplit(re, im, false, true)
		return joined<T>(re, im)
	}

	// Computes the inverse discrete Fourier transform using the Fast Fourier
	// Transform algorithm.
	//
	// Converts frequency-domain values back into their original domain,
	// reconstructing the original time- or spatial-domain samples. The input
	// length must be a power of two; anything else yields an empty result.
	def ifft<T: Complex>(data T[]) T[] {
		let n = data.len()
		return T[] when n == 0 || (n & (n - 1)) != 0

		let re float64[]
		re.len(n)
		let im float64[]
		im.len(n)
		splitInto(data, re, im)
		transformSplit(re, im, true, true)
		return joined<T>(re, im)
	}

	// Computes the Fourier transform of real-valued input.
	// The returned values contain the complex frequency coefficients: the
	// `n/2 + 1` non-redundant bins, the rest being their conjugate mirror.
	def rfft(data float16[]) complex32[] {
		let wide float64[]
		wide.len(data.len())
		for let i = 0; i < data.len(); i++ {
			wide[i] = float64(data[i])
		}
		return narrow<complex32>(rfft(wide))
	}

	// The transform of real samples as complex values.
	def rfft(data float32[]) complex64[] {
		let wide float64[]
		wide.len(data.len())
		for let i = 0; i < data.len(); i++ {
			wide[i] = float64(data[i])
		}
		return narrow<complex64>(rfft(wide))
	}

	// The transform of real samples as complex values.
	def rfft(data float64[]) complex128[] {
		let n = data.len()
		return complex128[] when n == 0 || (n & (n - 1)) != 0

		let re float64[]
		re.len(n)
		let j = 0
		for let i = 0; i < n; i++ {
			re[j] = data[i]
			j = nextReversed(j, n)
		}
		let im float64[]
		im.len(n)
		im.fill(0.0)
		transformSplit(re, im, false, true)

		let half = n / 2 + 1
		let out complex128[]
		out.len(half)
		for let i = 0; i < half; i++ {
			out[i] = complex(float(re[i]), float(im[i]))
		}
		return out
	}

	// Reconstructs a real-valued sequence from frequency-domain coefficients
	// produced by rfft.
	def irfft(data complex32[]) float16[] {
		let out = irfft(widen(data))
		let narrowed float16[]
		narrowed.len(out.len())
		for let i = 0; i < out.len(); i++ {
			narrowed[i] = float16(out[i])
		}
		return narrowed
	}

	// The real samples behind a transform produced by `rfft`.
	def irfft(data complex64[]) float32[] {
		let out = irfft(widen(data))
		let narrowed float32[]
		narrowed.len(out.len())
		for let i = 0; i < out.len(); i++ {
			narrowed[i] = float32(out[i])
		}
		return narrowed
	}

	// The real samples behind a transform produced by `rfft`.
	def irfft(data complex128[]) float64[] {
		let half = data.len()
		return float64[] when half < 2

		// `half` bins describe n = 2 * (half - 1) samples.
		let n = 2 * (half - 1)
		return float64[] when (n & (n - 1)) != 0

		let re float64[]
		re.len(n)
		let im float64[]
		im.len(n)
		for let i = 0; i < half; i++ {
			re[i] = float64(data[i].real())
			im[i] = float64(data[i].imag())
		}
		// The upper half mirrors the lower as conjugates.
		for let i = 1; i < half - 1; i++ {
			re[n - i] = re[i]
			im[n - i] = 0.0 - im[i]
		}
		transformSplit(re, im, true)
		return re
	}
}

internal partial module std.math.processing.fourier {
	use (
		std.math::(*)
		std.simd
		std.math.processing::*
	)

	// Butterflies at or above which a stage splits into bands on tasks.
	const fftBandButterflies = 1 << 15

	// The transform on split real and imaginary parts, in place.
	// `permuted` says the input is already in bit-reversed order.
	//
	// Twiddles come from one table of cos/sin computed directly for the
	// largest stage (smaller stages take every n/span-th entry), not from a
	// running product, so they carry no accumulated rounding. The first two
	// stages run as one pass of additions, the rest two at a time (radix 4)
	// on vectors, and large stages split their butterflies into bands on tasks; every
	// butterfly is computed the same way in either case, so the result never
	// depends on timing.
	def transformSplit(re float64[], im float64[], inverse bool, permuted bool = false) {
		let n = re.len()
		return when n < 2

		if !permuted {
			let j = 0
			for let i = 1; i < n; i++ {
				j = nextReversed(j, n)
				if i < j {
					let tr = re[i]
					re[i] = re[j]
					re[j] = tr
					let ti = im[i]
					im[i] = im[j]
					im[j] = ti
				}
			}
		}

		let half = n / 2
		let cosTable float64[]
		cosTable.len(half)
		let sinTable float64[]
		sinTable.len(half)
		// cos/sin computed on the first eighth of the circle; the rest of
		// the half circle follows by symmetry.
		let eighth = n / 8
		if eighth == 0 {
			for let k = 0; k < half; k++ {
				let angle = 2.0 * π * float(k) / float(n)
				cosTable[k] = float64(cos(angle))
				sinTable[k] = float64(sin(angle))
			}
		} else {
			for let k = 0; k <= eighth; k++ {
				let angle = 2.0 * π * float(k) / float(n)
				cosTable[k] = float64(cos(angle))
				sinTable[k] = float64(sin(angle))
			}
			for let k = eighth + 1; k <= 2 * eighth; k++ {
				cosTable[k] = sinTable[2 * eighth - k]
				sinTable[k] = cosTable[2 * eighth - k]
			}
			for let k = 2 * eighth + 1; k < half; k++ {
				cosTable[k] = 0.0 - cosTable[4 * eighth - k]
				sinTable[k] = sinTable[4 * eighth - k]
			}
		}
		if !inverse {
			for let k = 0; k < half; k++ {
				sinTable[k] = 0.0 - sinTable[k]
			}
		}

		// The first two stages together: their twiddles are 1 and ∓i, so
		// each block of four needs only additions.
		let span = 2
		if n >= 4 {
			for let i = 0; i < n; i += 4 {
				let ar = re[i] + re[i + 1]
				let ai = im[i] + im[i + 1]
				let br = re[i] - re[i + 1]
				let bi = im[i] - im[i + 1]
				let cr = re[i + 2] + re[i + 3]
				let ci = im[i + 2] + im[i + 3]
				let dr = re[i + 2] - re[i + 3]
				let di = im[i + 2] - im[i + 3]
				// d times -i (forward) or +i (inverse).
				let tr = di
				let ti = 0.0 - dr
				if inverse {
					tr = 0.0 - di
					ti = dr
				}
				re[i] = ar + cr
				im[i] = ai + ci
				re[i + 2] = ar - cr
				im[i + 2] = ai - ci
				re[i + 1] = br + tr
				im[i + 1] = bi + ti
				re[i + 3] = br - tr
				im[i + 3] = bi - ti
			}
			span = 8
		}

		// The remaining stages two at a time (radix 4), each pair in one
		// pass over the data; a last odd stage runs alone.
		// Per-stage twiddles, copied out of the table so the kernels read
		// them contiguously; a stage at stride 1 reads the table itself.
		let wr float64[]
		wr.len(n / 4)
		let wi float64[]
		wi.len(n / 4)
		let wr2 float64[]
		wr2.len(n / 4)
		let wi2 float64[]
		wi2.len(n / 4)
		let quarter = n / 4
		for; span <= n; span <<= 2 {
			let h = span / 2
			let stride = n / span
			if span * 2 > n {
				// A last odd stage: stride 1.
				runStage(re, im, cosTable, sinTable, cosTable, sinTable, h, half, false)
				break
			}
			for let k = 0; k < h; k++ {
				wr[k] = cosTable[k * stride]
				wi[k] = sinTable[k * stride]
			}
			if stride == 2 {
				runStage(re, im, wr, wi, cosTable, sinTable, h, quarter, true)
			} else {
				for let k = 0; k < 2 * h; k++ {
					wr2[k] = cosTable[k * stride / 2]
					wi2[k] = sinTable[k * stride / 2]
				}
				runStage(re, im, wr, wi, wr2, wi2, h, quarter, true)
			}
		}

		if inverse {
			let scale = 1.0 / float64(n)
			let sv = simd.splat4<float64>(scale)
			let i = 0
			for; i + 4 <= n; i += 4 {
				simd.store4<float64>(re, i, simd.load4<float64>(re, i) * sv)
				simd.store4<float64>(im, i, simd.load4<float64>(im, i) * sv)
			}
			for; i < n; i++ {
				re[i] *= scale
				im[i] *= scale
			}
		}
	}

	// One radix-2 stage (`count` butterflies) or one fused pair of stages
	// (`count` groups of four points), split into bands on tasks when large.
	def runStage(re float64[], im float64[], wr float64[], wi float64[], wr2 float64[], wi2 float64[], h int, count int, fused bool) {
		let per = fftBandButterflies
		if count < 2 * per {
			fftPass(re, im, wr, wi, wr2, wi2, h, 0, count, fused)
			return
		}
		let bands array<async none> = []
		for let b = 0; b < count; b += per {
			bands.push(fftBandAsync(re, im, wr, wi, wr2, wi2, h, b, (b + per).min(count), fused))
		}
		for let t in bands {
			await t
		}
	}

	async def fftBandAsync(re float64[], im float64[], wr float64[], wi float64[], wr2 float64[], wi2 float64[], h int, b0 int, b1 int, fused bool) async none {
		fftPass(re, im, wr, wi, wr2, wi2, h, b0, b1, fused)
		return none
	}

	def fftPass(re float64[], im float64[], wr float64[], wi float64[], wr2 float64[], wi2 float64[], h int, b0 int, b1 int, fused bool) {
		if fused {
			fftRadix4(re, im, wr, wi, wr2, wi2, h, b0, b1)
		} else {
			fftButterflies(re, im, wr, wi, h, b0, b1)
		}
	}

	// Groups g0..g1 of two fused stages with half spans `h` and `2h`
	// (group g is index g % h of the 4h-point block g / h), the first
	// stage's twiddles in wr/wi and the second's in wr2/wi2. Each group is
	// the four butterflies of the two radix-2 stages computed in registers,
	// so the result is exactly that of the stages run one after the other.
	def fftRadix4(re float64[], im float64[], wr float64[], wi float64[], wr2 float64[], wi2 float64[], h int, g0 int, g1 int) {
		let block = g0 / h
		let k = g0 - block * h
		let p = block * 4 * h + k
		let count = g1 - g0
		if h < 4 {
			for let g = 0; g < count; g++ {
				let p1 = p + h
				let p2 = p + 2 * h
				let p3 = p + 3 * h
				let cr = wr[k]
				let ci = wi[k]
				// First stage: (p, p1) and (p2, p3).
				let t1r = re[p1] * cr - im[p1] * ci
				let t1i = re[p1] * ci + im[p1] * cr
				let t3r = re[p3] * cr - im[p3] * ci
				let t3i = re[p3] * ci + im[p3] * cr
				let a0r = re[p] + t1r
				let a0i = im[p] + t1i
				let a1r = re[p] - t1r
				let a1i = im[p] - t1i
				let a2r = re[p2] + t3r
				let a2i = im[p2] + t3i
				let a3r = re[p2] - t3r
				let a3i = im[p2] - t3i
				// Second stage: (p, p2) with twiddle k, (p1, p3) with k + h.
				let dr = wr2[k]
				let di = wi2[k]
				let er = wr2[k + h]
				let ei = wi2[k + h]
				let u2r = a2r * dr - a2i * di
				let u2i = a2r * di + a2i * dr
				let u3r = a3r * er - a3i * ei
				let u3i = a3r * ei + a3i * er
				re[p] = a0r + u2r
				im[p] = a0i + u2i
				re[p2] = a0r - u2r
				im[p2] = a0i - u2i
				re[p1] = a1r + u3r
				im[p1] = a1i + u3i
				re[p3] = a1r - u3r
				im[p3] = a1i - u3i
				k++
				p++
				if k == h {
					k = 0
					p += 3 * h
				}
			}
			return
		}
		for let g = 0; g < count; g += 4 {
			let p1 = p + h
			let p2 = p + 2 * h
			let p3 = p + 3 * h
			let cr = simd.load4<float64>(wr, k)
			let ci = simd.load4<float64>(wi, k)
			let xr = simd.load4<float64>(re, p1)
			let xi = simd.load4<float64>(im, p1)
			let t1r = xr * cr - xi * ci
			let t1i = xr * ci + xi * cr
			xr = simd.load4<float64>(re, p3)
			xi = simd.load4<float64>(im, p3)
			let t3r = xr * cr - xi * ci
			let t3i = xr * ci + xi * cr
			let x0r = simd.load4<float64>(re, p)
			let x0i = simd.load4<float64>(im, p)
			let x2r = simd.load4<float64>(re, p2)
			let x2i = simd.load4<float64>(im, p2)
			let a0r = x0r + t1r
			let a0i = x0i + t1i
			let a1r = x0r - t1r
			let a1i = x0i - t1i
			let a2r = x2r + t3r
			let a2i = x2i + t3i
			let a3r = x2r - t3r
			let a3i = x2i - t3i
			let dr = simd.load4<float64>(wr2, k)
			let di = simd.load4<float64>(wi2, k)
			let er = simd.load4<float64>(wr2, k + h)
			let ei = simd.load4<float64>(wi2, k + h)
			let u2r = a2r * dr - a2i * di
			let u2i = a2r * di + a2i * dr
			let u3r = a3r * er - a3i * ei
			let u3i = a3r * ei + a3i * er
			simd.store4<float64>(re, p, a0r + u2r)
			simd.store4<float64>(im, p, a0i + u2i)
			simd.store4<float64>(re, p2, a0r - u2r)
			simd.store4<float64>(im, p2, a0i - u2i)
			simd.store4<float64>(re, p1, a1r + u3r)
			simd.store4<float64>(im, p1, a1i + u3i)
			simd.store4<float64>(re, p3, a1r - u3r)
			simd.store4<float64>(im, p3, a1i - u3i)
			k += 4
			p += 4
			if k == h {
				k = 0
				p += 3 * h
			}
		}
	}

	// Butterflies b0..b1 of the stage with half span `h` (butterfly b is
	// index b % h of block b / h), with that stage's twiddles in wr/wi.
	def fftButterflies(re float64[], im float64[], wr float64[], wi float64[], h int, b0 int, b1 int) {
		let block = b0 / h
		let k = b0 - block * h
		let p = block * 2 * h + k
		let count = b1 - b0
		if h < 4 {
			for let b = 0; b < count; b++ {
				let q = p + h
				let tr = re[q] * wr[k] - im[q] * wi[k]
				let ti = re[q] * wi[k] + im[q] * wr[k]
				re[q] = re[p] - tr
				im[q] = im[p] - ti
				re[p] = re[p] + tr
				im[p] = im[p] + ti
				k++
				p++
				if k == h {
					k = 0
					p += h
				}
			}
			return
		}
		// h is a multiple of 4 and so are b0 and b1: four butterflies of one
		// block at a time.
		for let b = 0; b < count; b += 4 {
			let q = p + h
			let cr = simd.load4<float64>(wr, k)
			let ci = simd.load4<float64>(wi, k)
			let xr = simd.load4<float64>(re, q)
			let xi = simd.load4<float64>(im, q)
			let tr = xr * cr - xi * ci
			let ti = xr * ci + xi * cr
			let ur = simd.load4<float64>(re, p)
			let ui = simd.load4<float64>(im, p)
			simd.store4<float64>(re, q, ur - tr)
			simd.store4<float64>(im, q, ui - ti)
			simd.store4<float64>(re, p, ur + tr)
			simd.store4<float64>(im, p, ui + ti)
			k += 4
			p += 4
			if k == h {
				k = 0
				p += h
			}
		}
	}

	// Any complex kind split into real and imaginary parts, stored in
	// bit-reversed order (the permutation the transform starts with).
	def splitInto<T: Complex>(data T[], re float64[], im float64[]) {
		let n = data.len()
		let j = 0
		for let i = 0; i < n; i++ {
			let z = complex128(data[i])
			re[j] = float64(z.real())
			im[j] = float64(z.imag())
			j = nextReversed(j, n)
		}
	}

	// The index after `j` in bit-reversed counting over `n` (a power of two).
	def nextReversed(j int, n int) int {
		let bit = n >> 1
		for (j & bit) != 0 {
			j ^= bit
			bit >>= 1
		}
		return j | bit
	}

	// Real and imaginary parts joined into the requested complex kind.
	def joined<T: Complex>(re float64[], im float64[]) T[] {
		let out T[]
		out.len(re.len())
		for let i = 0; i < re.len(); i++ {
			out[i] = T(complex(float(re[i]), float(im[i])))
		}
		return out
	}

	// A complex128 buffer converted to the requested complex kind.
	def narrow<T: Complex>(buf complex128[]) T[] {
		let out T[]
		out.len(buf.len())
		for let i = 0; i < buf.len(); i++ {
			out[i] = T(buf[i])
		}
		return out
	}

	// Any complex kind widened to complex128.
	def widen<T: Complex>(data T[]) complex128[] {
		let out complex128[]
		out.len(data.len())
		for let i = 0; i < data.len(); i++ {
			out[i] = complex128(data[i])
		}
		return out
	}
}
