partial module std.math.processing {
	use (
		std.testing
		std.math::(*)
	)

	check "FFT" {
		internal def near(z complex128, re, im float) bool {
			return approx(z.real(), re, 1e-9) && approx(z.imag(), im, 1e-9)
		}

		@test()
		def impulse_is_flat_spectrum() {
			let x = complex128[complex(1.0), complex(0.0), complex(0.0), complex(0.0)]
			let spectrum = fft(x) onerror recover complex128[]
			assert spectrum.len() == 4
			for let (_, bin) in spectrum {
				assert near(bin, 1.0, 0.0)
			}
		}

		@test()
		def constant_is_dc_only() {
			let x complex128[]
			x.len(8)
			for let i = 0; i < 8; i++ {
				x[i] = complex(2.0)
			}
			let spectrum = fft(x) onerror recover complex128[]
			assert near(spectrum[0], 16.0, 0.0)
			for let i = 1; i < 8; i++ {
				assert near(spectrum[i], 0.0, 0.0)
			}
		}

		@test()
		def single_tone_lands_in_its_bin() {
			// One cycle of a cosine over 8 samples: energy in bins 1 and 7.
			let x complex128[]
			x.len(8)
			for let i = 0; i < 8; i++ {
				x[i] = complex(cos(2.0 * π * float(i) / 8.0))
			}
			let spectrum = fft(x) onerror recover complex128[]
			assert near(spectrum[1], 4.0, 0.0)
			assert near(spectrum[7], 4.0, 0.0)
			assert near(spectrum[0], 0.0, 0.0)
			assert near(spectrum[2], 0.0, 0.0)
		}

		@test()
		def ifft_inverts_fft() {
			let x = complex128[complex(1.0, 2.0), complex(-3.0, 0.5), complex(0.25, -1.0), complex(4.0, 4.0)]
			let spectrum = fft(x) onerror recover complex128[]
			let back = ifft(spectrum)
			assert back.len() == 4
			for let i = 0; i < 4; i++ {
				assert near(back[i], x[i].real(), x[i].imag())
			}
		}

		@test()
		def rejects_lengths_that_are_not_powers_of_two() {
			let x = complex128[complex(1.0), complex(2.0), complex(3.0)]
			let spectrum = fft(x) onerror recover complex128[]
			assert spectrum.len() == 0
			assert ifft(x).len() == 0
		}

		@test()
		def empty_input_is_empty_output() {
			let x complex128[]
			let spectrum = fft(x) onerror recover complex128[complex(9.0)]
			assert spectrum.len() == 0
		}

		@test()
		def narrower_kinds_round_trip() {
			let x = complex64[complex64(complex(1.0, 1.0)), complex64(complex(2.0, -1.0)), complex64(complex(0.0, 0.0)), complex64(complex(-1.0, 3.0))]
			let spectrum = fft(x) onerror recover complex64[]
			assert spectrum.len() == 4
			let back = ifft(spectrum)
			for let i = 0; i < 4; i++ {
				assert approx(back[i].real(), x[i].real(), 1e-5)
				assert approx(back[i].imag(), x[i].imag(), 1e-5)
			}
		}

		@test()
		def rfft_keeps_the_non_redundant_half() {
			let x = float64[1.0, 0.0, -1.0, 0.0, 1.0, 0.0, -1.0, 0.0]
			let spectrum = rfft(x)
			// 8 samples -> 5 bins; the tone has two cycles, so bin 2.
			assert spectrum.len() == 5
			assert near(spectrum[2], 4.0, 0.0)
			assert near(spectrum[0], 0.0, 0.0)
			assert near(spectrum[1], 0.0, 0.0)
		}

		@test()
		def irfft_inverts_rfft() {
			let x = float64[0.5, -1.25, 3.0, 2.0, -0.75, 1.0, 0.0, 4.5]
			let back = irfft(rfft(x))
			assert back.len() == 8
			for let i = 0; i < 8; i++ {
				assert approx(float(back[i]), float(x[i]), 1e-9)
			}
		}

		@test()
		def rfft_on_float32_narrows() {
			let x = float32[1.0, 2.0, 3.0, 4.0]
			let spectrum = rfft(x)
			assert spectrum.len() == 3
			assert approx(spectrum[0].real(), 10.0, 1e-5)
			let back = irfft(spectrum)
			assert back.len() == 4
			assert approx(float(back[3]), 4.0, 1e-5)
		}
	}

	check "Complex" {
		@test()
		def parts_and_magnitude() {
			let z = complex(3.0, 4.0)
			assert z.real() == 3.0
			assert z.imag() == 4.0
			assert approx(z.abs(), 5.0, 1e-12)
			let c = z.conj()
			assert c.real() == 3.0
			assert c.imag() == -4.0
		}

		@test()
		def arithmetic() {
			let a = complex(1.0, 2.0)
			let b = complex(3.0, -1.0)
			let sum = a + b
			assert sum.real() == 4.0 && sum.imag() == 1.0
			let prod = a * b
			// (1 + 2i)(3 - i) = 3 - i + 6i - 2i^2 = 5 + 5i
			assert prod.real() == 5.0 && prod.imag() == 5.0
			let quot = prod / b
			assert approx(quot.real(), 1.0, 1e-12) && approx(quot.imag(), 2.0, 1e-12)
			let neg = -a
			assert neg.real() == -1.0 && neg.imag() == -2.0
			assert a == complex(1.0, 2.0)
			assert a != b
		}

		@test()
		def casts_between_kinds() {
			let z = complex(1.5, -2.5)
			let w = complex64(z)
			assert approx(w.real(), 1.5, 1e-6)
			assert approx(w.imag(), -2.5, 1e-6)
			let back = complex128(w)
			assert approx(back.imag(), -2.5, 1e-6)
			let r = complex128(2.0)
			assert r.real() == 2.0 && r.imag() == 0.0
		}
	}
}
