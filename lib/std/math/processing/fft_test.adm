partial module std.math.processing {
	use (
		std.testing
		std.math::(*)
	)

	check "FFT" {
		internal def near(z complex128, re, im float) bool {
			return approx(z.real(), re, 1e-9) && approx(z.imag(), im, 1e-9)
		}

		@test()
		def impulse_is_flat_spectrum() {
			let x = complex128[complex(1.0), complex(0.0), complex(0.0), complex(0.0)]
			let spectrum = fft(x)
			assert spectrum.len() == 4
			for let (_, bin) in spectrum {
				assert near(bin, 1.0, 0.0)
			}
		}

		@test()
		def constant_is_dc_only() {
			let x complex128[]
			x.len(8)
			for let i = 0; i < 8; i++ {
				x[i] = complex(2.0)
			}
			let spectrum = fft(x)
			assert near(spectrum[0], 16.0, 0.0)
			for let i = 1; i < 8; i++ {
				assert near(spectrum[i], 0.0, 0.0)
			}
		}

		@test()
		def single_tone_lands_in_its_bin() {
			// One cycle of a cosine over 8 samples: energy in bins 1 and 7.
			let x complex128[]
			x.len(8)
			for let i = 0; i < 8; i++ {
				x[i] = complex(cos(2.0 * π * float(i) / 8.0))
			}
			let spectrum = fft(x)
			assert near(spectrum[1], 4.0, 0.0)
			assert near(spectrum[7], 4.0, 0.0)
			assert near(spectrum[0], 0.0, 0.0)
			assert near(spectrum[2], 0.0, 0.0)
		}

		@test()
		def ifft_inverts_fft() {
			let x = complex128[complex(1.0, 2.0), complex(-3.0, 0.5), complex(0.25, -1.0), complex(4.0, 4.0)]
			let spectrum = fft(x)
			let back = ifft(spectrum)
			assert back.len() == 4
			for let i = 0; i < 4; i++ {
				assert near(back[i], x[i].real(), x[i].imag())
			}
		}

		@test()
		def empty_input_is_empty_output() {
			let x complex128[]
			let spectrum = fft(x)
			assert spectrum.len() == 0
		}

		@test()
		def narrower_kinds_round_trip() {
			let x = complex64[complex64(complex(1.0, 1.0)), complex64(complex(2.0, -1.0)), complex64(complex(0.0, 0.0)), complex64(complex(-1.0, 3.0))]
			let spectrum = fft(x)
			assert spectrum.len() == 4
			let back = ifft(spectrum)
			for let i = 0; i < 4; i++ {
				assert approx(back[i].real(), x[i].real(), 1e-5)
				assert approx(back[i].imag(), x[i].imag(), 1e-5)
			}
		}

		@test()
		def rfft_keeps_the_non_redundant_half() {
			let x = float64[1.0, 0.0, -1.0, 0.0, 1.0, 0.0, -1.0, 0.0]
			let spectrum = rfft(x)
			// 8 samples -> 5 bins; the tone has two cycles, so bin 2.
			assert spectrum.len() == 5
			assert near(spectrum[2], 4.0, 0.0)
			assert near(spectrum[0], 0.0, 0.0)
			assert near(spectrum[1], 0.0, 0.0)
		}

		@test()
		def irfft_inverts_rfft() {
			let x = float64[0.5, -1.25, 3.0, 2.0, -0.75, 1.0, 0.0, 4.5]
			let back = irfft(rfft(x))
			assert back.len() == 8
			for let i = 0; i < 8; i++ {
				assert approx(float(back[i]), float(x[i]), 1e-9)
			}
		}

		@test()
		def rfft_on_float32_narrows() {
			let x = float32[1.0, 2.0, 3.0, 4.0]
			let spectrum = rfft(x)
			assert spectrum.len() == 3
			assert approx(spectrum[0].real(), 10.0, 1e-5)
			let back = irfft(spectrum)
			assert back.len() == 4
			assert approx(float(back[3]), 4.0, 1e-5)
		}

		// Pseudo-random samples in -1..1.
		internal def noise(n int, seed int) complex128[] {
			let x complex128[]
			x.len(n)
			let v = seed
			for let i = 0; i < n; i++ {
				v = (v * 1103515245 + 12345) & 0x7fffffff
				let a = float(v % 20001) / 10000.0 - 1.0
				v = (v * 1103515245 + 12345) & 0x7fffffff
				x[i] = complex(a, float(v % 20001) / 10000.0 - 1.0)
			}
			return x
		}

		// The DFT computed from its definition.
		internal def dft(x complex128[]) complex128[] {
			let n = x.len()
			let out complex128[]
			out.len(n)
			for let k = 0; k < n; k++ {
				let sr = 0.0
				let si = 0.0
				for let t = 0; t < n; t++ {
					let angle = -2.0 * π * float((k * t) % n) / float(n)
					let c = cos(angle)
					let s = sin(angle)
					sr += x[t].real() * c - x[t].imag() * s
					si += x[t].real() * s + x[t].imag() * c
				}
				out[k] = complex(sr, si)
			}
			return out
		}

		@test()
		def matches_the_definition() !none {
			for let (_, n) in int[2, 4, 8, 16, 32, 64, 256] {
				let x = noise(n, n)
				let got = fft(x)
				let want = dft(x)
				for let k = 0; k < n; k++ {
					fail "n={n} bin {k}: {got[k]} vs {want[k]}" unless (got[k] - want[k]).abs() < 1e-9 * float(n)
				}
			}
		}

		@test()
		def any_length_matches_the_definition() !none {
			// Mixed radices, the direct-sum primes and Bluestein lengths.
			for let (_, n) in int[3, 5, 6, 7, 9, 10, 12, 15, 17, 30, 37, 49, 60, 97, 100, 210, 400, 1000, 1009, 4097] {
				let x = noise(n, n)
				let got = fft(x)
				let want = dft(x)
				for let k = 0; k < n; k++ {
					fail "n={n} bin {k}: {got[k]} vs {want[k]}" unless (got[k] - want[k]).abs() < 1e-9 * float(n)
				}
				let back = ifft(got)
				for let k = 0; k < n; k++ {
					fail "n={n} value {k}: {back[k]} vs {x[k]}" unless (back[k] - x[k]).abs() < 1e-12 * float(n)
				}
			}
		}

		@test()
		def plan_runs_many_inputs_and_copies() !none {
			for let (_, n) in int[400, 1031] {
				let plan = new Fourier(n)
				let other = plan.copy()
				for let seed = 1; seed <= 3; seed++ {
					let x = noise(n, seed)
					let want = dft(x)
					let re float[]
					let im float[]
					for let (_, z) in x {
						re.push(z.real())
						im.push(z.imag())
					}
					let (re2, im2) = (re.clone(), im.clone())
					plan.run(re, im)
					other.run(re2, im2)
					for let k = 0; k < n; k++ {
						fail "n={n} bin {k}" unless (complex(re[k], im[k]) - want[k]).abs() < 1e-9 * float(n)
						fail "n={n} copy bin {k}" unless re[k] == re2[k] && im[k] == im2[k]
					}
				}
			}
		}

		@test()
		def rfft_of_odd_and_mixed_lengths() !none {
			for let (_, n) in int[5, 400, 1001] {
				let x float64[]
				let z complex128[]
				for let (_, c) in noise(n, 3) {
					x.push(float64(c.real()))
					z.push(complex(c.real()))
				}
				let got = rfft(x)
				let want = dft(z)
				fail "n={n}: {got.len()} bins" unless got.len() == n / 2 + 1
				for let k = 0; k < got.len(); k++ {
					fail "n={n} bin {k}" unless (got[k] - want[k]).abs() < 1e-9 * float(n)
				}
			}
			let x = float64[0.5, -1.25, 3.0, 2.0, -0.75, 1.0]
			let back = irfft(rfft(x))
			fail "irfft of 6: {back.len()}" unless back.len() == 6
			for let i = 0; i < 6; i++ {
				fail "value {i}" unless approx(float(back[i]), float(x[i]), 1e-12)
			}
		}

		@test()
		def large_round_trip_and_energy() !none {
			// 2^18 and 3^11 · 2 split their stages into bands on tasks.
			for let (_, n) in int[1 << 12, 1 << 16, 1 << 18, 354294] {
				let x = noise(n, 7)
				let spectrum = fft(x)
				let back = ifft(spectrum)
				let worst = 0.0
				let energyTime = 0.0
				let energyFreq = 0.0
				for let i = 0; i < n; i++ {
					let e = (back[i] - x[i]).abs()
					worst = e when e > worst
					energyTime += x[i].abs() * x[i].abs()
					energyFreq += spectrum[i].abs() * spectrum[i].abs()
				}
				fail "n={n} round trip error {worst}" unless worst < 1e-12
				fail "n={n} energy {energyFreq / float(n)} vs {energyTime}" unless approx(energyFreq / float(n), energyTime, 1e-9 * energyTime)
			}
		}
	}

	check "Complex" {
		@test()
		def parts_and_magnitude() {
			let z = complex(3.0, 4.0)
			assert z.real() == 3.0
			assert z.imag() == 4.0
			assert approx(z.abs(), 5.0, 1e-12)
			let c = z.conj()
			assert c.real() == 3.0
			assert c.imag() == -4.0
		}

		@test()
		def arithmetic() {
			let a = complex(1.0, 2.0)
			let b = complex(3.0, -1.0)
			let sum = a + b
			assert sum.real() == 4.0 && sum.imag() == 1.0
			let prod = a * b
			// (1 + 2i)(3 - i) = 3 - i + 6i - 2i^2 = 5 + 5i
			assert prod.real() == 5.0 && prod.imag() == 5.0
			let quot = prod / b
			assert approx(quot.real(), 1.0, 1e-12) && approx(quot.imag(), 2.0, 1e-12)
			let neg = -a
			assert neg.real() == -1.0 && neg.imag() == -2.0
			assert a == complex(1.0, 2.0)
			assert a != b
		}

		@test()
		def casts_between_kinds() {
			let z = complex(1.5, -2.5)
			let w = complex64(z)
			assert approx(w.real(), 1.5, 1e-6)
			assert approx(w.imag(), -2.5, 1e-6)
			let back = complex128(w)
			assert approx(back.imag(), -2.5, 1e-6)
			let r = complex128(2.0)
			assert r.real() == 2.0 && r.imag() == 0.0
		}
	}
}
