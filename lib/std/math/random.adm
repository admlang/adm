partial module std.math {
	// A repeatable sequence of random numbers: the same seed gives the same
	// numbers on every machine, so a simulation, a test or a generated
	// picture can be made again. The generator is xoshiro256** (Blackman
	// and Vigna), its state filled from the seed by splitmix64. For keys,
	// tokens and anything an attacker must not guess, use `std.crypto.rand`.
	//
	// ```
	// let random = new Random(42)
	// let roll = random.range(1, 7)
	// let byte = random.of<uint8>()
	// let noise = random.normal()
	// ```
	type Random {
		internal s0       uint64
		internal s1       uint64
		internal s2       uint64
		internal s3       uint64
		// The second value of the last pair `normal` drew.
		internal spare    float
		internal hasSpare bool

		// A generator whose numbers follow from `seed`.
		def new(seed int) {
			let state = uint64(seed)
			s0 = splitMix(state)
			state += uint64(0x9E3779B97F4A7C15)
			s1 = splitMix(state)
			state += uint64(0x9E3779B97F4A7C15)
			s2 = splitMix(state)
			state += uint64(0x9E3779B97F4A7C15)
			s3 = splitMix(state)
		}

		// A random value of the numeric type T: any value of an integer
		// type, every one equally likely, or a float from 0 up to but not
		// including 1 with as many random bits as T's significand holds.
		def of<T: Numeric>() T {
			return T(float(bits() >> 53) * 0x1.0p-11) when T is float16
			return T(float(bits() >> 40) * 0x1.0p-24) when T is float32
			return T(float(bits() >> 11) * 0x1.0p-53) when T is float || T is float64
			return T(float128(bits()) * float128(0x1.0p-64)) when T is float128
			return T((uint128(bits()) << 64) | uint128(bits())) when T is int128 || T is uint128
			return T(bits())
		}

		// A random value of type T from `min` up to but not including `max`,
		// every whole number equally likely for an integer type; `min` when
		// `max` is not above it.
		def range<T: Numeric>(min T, max T) T {
			return min unless max > min
			if T is float || T is float16 || T is float32 || T is float64 || T is float128 {
				// Weighted ends rather than min + (max - min) · u, which
				// overflows for ends far apart; rounding can reach `max`,
				// which is drawn again.
				for {
					let u = of<T>()
					let x = min * (T(1) - u) + max * u
					return x when x >= min && x < max
				}
			}
			// Two's complement: the span and the sum wrap in 128 bits and
			// the result is cut back to T's width.
			let span = uint128(max) - uint128(min)
			return T(uint128(min) + below(span))
		}

		// A number from the normal distribution of `mean` and `deviation`
		// (Marsaglia's polar method: values come in pairs, the second kept
		// for the next call).
		def normal(mean float = 0.0, deviation float = 1.0) float {
			if hasSpare {
				hasSpare = false
				return mean + deviation * spare
			}
			let (u, v, s) = (0.0, 0.0, 0.0)
			for s >= 1.0 || s == 0.0 {
				u = 2.0 * of<float>() - 1.0
				v = 2.0 * of<float>() - 1.0
				s = u * u + v * v
			}
			let scale = sqrt(-2.0 * ln(s) / s)
			spare = v * scale
			hasSpare = true
			return mean + deviation * u * scale
		}

		// The next 64 random bits.
		internal def bits() uint64 {
			let result = rotateLeft(s1 * uint64(5), 7) * uint64(9)
			let t = s1 << 17
			s2 ^= s0
			s3 ^= s1
			s1 ^= s2
			s0 ^= s3
			s2 ^= t
			s3 = rotateLeft(s3, 45)
			return result
		}

		// A whole number from 0 up to but not including `span` (above 0),
		// every one equally likely: Lemire's multiply-and-reject for a span
		// of 64 bits, else masked 128-bit draws until one is below it.
		internal def below(span uint128) uint128 {
			if span <= uint128(0xFFFFFFFFFFFFFFFF) {
				let s = uint64(span)
				let product = uint128(bits()) * span
				let low = uint64(product)
				if low < s {
					let threshold = (uint64(0xFFFFFFFFFFFFFFFF) % s + uint64(1)) % s
					for low < threshold {
						product = uint128(bits()) * span
						low = uint64(product)
					}
				}
				return product >> 64
			}
			let mask = span - uint128(1)
			for let shift = 1; shift < 128; shift *= 2 {
				mask |= mask >> shift
			}
			for {
				let x = ((uint128(bits()) << 64) | uint128(bits())) & mask
				return x when x < span
			}
		}
	}

	// splitmix64's output for the state `x`.
	internal def splitMix(x uint64) uint64 {
		let z = x + uint64(0x9E3779B97F4A7C15)
		z = (z ^ (z >> 30)) * uint64(0xBF58476D1CE4E5B9)
		z = (z ^ (z >> 27)) * uint64(0x94D049BB133111EB)
		return z ^ (z >> 31)
	}

	internal def rotateLeft(x uint64, k int) uint64 {
		return (x << k) | (x >> (64 - k))
	}
}
