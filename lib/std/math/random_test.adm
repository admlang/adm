partial module std.math {
	use std.testing

	check "Random" {
		@test()
		def matches_the_reference_generator() {
			// xoshiro256** seeded by splitmix64 from 42, as the authors'
			// C code gives it.
			let random = new Random(42)
			assert random.of<uint64>() == uint64(0x15780b2e0c2ec716)
			assert random.of<uint64>() == uint64(0x6104d9866d113a7e)
			assert random.of<uint64>() == uint64(0xae17533239e499a1)
			assert random.of<uint64>() == uint64(0xecb8ad4703b360a1)
			assert random.of<uint64>() == uint64(0xfde6dc7fe2ec5e64)
			assert new Random(42).of<float>() == 0.08386297105988216
		}

		@test()
		def same_seed_same_numbers() {
			let (a, b, c) = (new Random(7), new Random(7), new Random(8))
			let differs = false
			for let i = 0; i < 100; i++ {
				let x = a.normal()
				assert x == b.normal()
				differs = differs || x != c.normal()
			}
			assert differs
		}

		@test()
		def ranges_stay_inside_and_cover_evenly() {
			let random = new Random(1)
			let counts int[]
			counts.len(6)
			for let i = 0; i < 60000; i++ {
				let roll = random.range(1, 7)
				assert roll >= 1 && roll < 7
				counts[roll - 1]++
			}
			for let (_, n) in counts {
				assert n > 9500 && n < 10500
			}
			assert random.range(5, 5) == 5
			for let i = 0; i < 1000; i++ {
				let wide = random.range(MIN_INT, MAX_INT)
				assert wide >= MIN_INT && wide < MAX_INT
				let x = random.range(-2.5, 4.0)
				assert x >= -2.5 && x < 4.0
				let u = random.of<float>()
				assert u >= 0.0 && u < 1.0
			}
		}

		@test()
		def every_numeric_type() {
			let random = new Random(5)
			let (low, high) = (false, false)
			let seen int[]
			seen.len(201)
			for let i = 0; i < 20000; i++ {
				let h = random.of<float16>()
				assert h >= float16(0) && h < float16(1)
				let f = random.of<float32>()
				assert f >= float32(0) && f < float32(1)
				let q = random.of<float128>()
				assert q >= float128(0) && q < float128(1)
				let b = random.of<int8>()
				low = low || b < int8(0)
				high = high || b > int8(0)
				let small = random.range(int8(-100), int8(100))
				assert small >= int8(-100) && small < int8(100)
				seen[int(small) + 100]++
				let u = random.range(uint8(250), uint8(255))
				assert u >= uint8(250) && u < uint8(255)
				let wide = random.range(uint64(0), uint64(0xF000000000000000))
				assert wide < uint64(0xF000000000000000)
				let huge = random.range(int128(-5), int128(1) << 100)
				assert huge >= int128(-5) && huge < int128(1) << 100
				let hf = random.range(float16(1), float16(2))
				assert hf >= float16(1) && hf < float16(2)
			}
			assert low && high
			// 200 values drawn 20000 times: each about 100 times.
			for let k = 0; k < 200; k++ {
				assert seen[k] > 50 && seen[k] < 160
			}
			assert seen[200] == 0
			let all = random.of<uint128>()
			assert all != random.of<uint128>()
		}

		@test()
		def normal_has_its_mean_and_deviation() {
			let random = new Random(3)
			let n = 200000
			let (sum, squares) = (0.0, 0.0)
			for let i = 0; i < n; i++ {
				let x = random.normal(10.0, 2.0)
				sum += x
				squares += x * x
			}
			let mean = sum / float(n)
			let variance = squares / float(n) - mean * mean
			assert approx(mean, 10.0, 0.02)
			assert approx(variance, 4.0, 0.05)
		}
	}
}
