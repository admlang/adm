// Ryu (Ulf Adams, PLDI 2018): the shortest decimal digits that read back as
// a given float64, from its bits, with 128-bit multiplications against
// tables of powers of five.

internal partial module std.math.ryu {
	const mantissaBits = 52
	const exponentBias = 1023
	const pow5InvBits = 125
	const pow5Bits = 125
	const invTableSize = 342
	const tableSize = 326

	// Tables holds 5^i scaled to 125 bits (split) and 2^k / 5^q rounded up
	// to 125 bits (inverse split), as 64-bit halves, built once.
	type Tables {
		ready   bool
		splitLo uint64[]
		splitHi uint64[]
		invLo   uint64[]
		invHi   uint64[]

		atomic def build() Tables {
			return self when ready
			splitLo = uint64[]
			splitHi = uint64[]
			invLo = uint64[]
			invHi = uint64[]
			let mask = (bigint(1) << 64) - bigint(1)
			let pow = bigint(1)
			for let i in 0..invTableSize {
				let length = pow.bitLen()
				if i < tableSize {
					let split = length >= pow5Bits ?? (pow >> (length - pow5Bits), pow << (pow5Bits - length))
					splitLo.push(uint64(int64((split & mask) >> 1)) << 1 | uint64(int64(split & bigint(1))))
					splitHi.push(uint64(int64(split >> 64)))
				}
				let inv = (bigint(1) << (length - 1 + pow5InvBits)) / pow + bigint(1)
				invLo.push(uint64(int64((inv & mask) >> 1)) << 1 | uint64(int64(inv & bigint(1))))
				invHi.push(uint64(int64(inv >> 64)))
				pow = pow * bigint(5)
			}
			ready = true
			return self
		}
	}

	let tables = new Tables()

	def pow5bits(e int) int {
		return ((e * 1217359) >> 19) + 1
	}

	def log10Pow2(e int) int {
		return (e * 78913) >> 18
	}

	def log10Pow5(e int) int {
		return (e * 732923) >> 20
	}

	def pow5Factor(value uint64) int {
		let v = value
		let count = 0
		for v % 5 == 0 {
			v = v / 5
			count++
		}
		return count
	}

	def multipleOfPowerOf5(value uint64, p int) bool {
		return pow5Factor(value) >= p
	}

	def multipleOfPowerOf2(value uint64, p int) bool {
		return (value & ((uint64(1) << p) - 1)) == 0
	}

	// (m × (hi·2^64 + lo)) >> j, for j >= 64 and m below 2^55.
	def mulShift(m uint64, lo uint64, hi uint64, j int) uint64 {
		let b0 = uint128(m) * uint128(lo)
		let b2 = uint128(m) * uint128(hi)
		return uint64(((b0 >> 64) + b2) >> (j - 64))
	}

	// Shortest returns the shortest decimal digits and power of ten of the
	// float whose IEEE 754 fields are given (finite, not zero): the value is
	// digits × 10^exponent.
	def shortest(ieeeMantissa uint64, ieeeExponent int) (uint64, int) {
		let t = tables.build()
		let e2 = 0
		let m2 = uint64(0)
		if ieeeExponent == 0 {
			e2 = 1 - exponentBias - mantissaBits - 2
			m2 = ieeeMantissa
		} else {
			e2 = ieeeExponent - exponentBias - mantissaBits - 2
			m2 = (uint64(1) << mantissaBits) | ieeeMantissa
		}
		let acceptBounds = (m2 & 1) == 0
		let mv = 4 * m2
		let mmShift = ieeeMantissa != 0 || ieeeExponent <= 1 ?? (uint64(1), uint64(0))
		let vr = uint64(0)
		let vp = uint64(0)
		let vm = uint64(0)
		let e10 = 0
		let vmIsTrailingZeros = false
		let vrIsTrailingZeros = false
		if e2 >= 0 {
			let q = log10Pow2(e2) - (e2 > 3 ?? (1, 0))
			e10 = q
			let k = pow5InvBits + pow5bits(q) - 1
			let i = -e2 + q + k
			vr = mulShift(mv, t.invLo[q], t.invHi[q], i)
			vp = mulShift(mv + 2, t.invLo[q], t.invHi[q], i)
			vm = mulShift(mv - 1 - mmShift, t.invLo[q], t.invHi[q], i)
			if q <= 21 {
				if mv % 5 == 0 {
					vrIsTrailingZeros = multipleOfPowerOf5(mv, q)
				} else if acceptBounds {
					vmIsTrailingZeros = multipleOfPowerOf5(mv - 1 - mmShift, q)
				} else if multipleOfPowerOf5(mv + 2, q) {
					vp--
				}
			}
		} else {
			let q = log10Pow5(-e2) - (-e2 > 1 ?? (1, 0))
			e10 = q + e2
			let i = -e2 - q
			let k = pow5bits(i) - pow5Bits
			let j = q - k
			vr = mulShift(mv, t.splitLo[i], t.splitHi[i], j)
			vp = mulShift(mv + 2, t.splitLo[i], t.splitHi[i], j)
			vm = mulShift(mv - 1 - mmShift, t.splitLo[i], t.splitHi[i], j)
			if q <= 1 {
				vrIsTrailingZeros = true
				if acceptBounds {
					vmIsTrailingZeros = mmShift == 1
				} else {
					vp--
				}
			} else if q < 63 {
				vrIsTrailingZeros = multipleOfPowerOf2(mv, q)
			}
		}
		let removed = 0
		let lastRemovedDigit = uint64(0)
		let output = uint64(0)
		if vmIsTrailingZeros || vrIsTrailingZeros {
			for vp / 10 > vm / 10 {
				vmIsTrailingZeros = vmIsTrailingZeros && vm % 10 == 0
				vrIsTrailingZeros = vrIsTrailingZeros && lastRemovedDigit == 0
				lastRemovedDigit = vr % 10
				vr = vr / 10
				vp = vp / 10
				vm = vm / 10
				removed++
			}
			if vmIsTrailingZeros {
				for vm % 10 == 0 {
					vrIsTrailingZeros = vrIsTrailingZeros && lastRemovedDigit == 0
					lastRemovedDigit = vr % 10
					vr = vr / 10
					vp = vp / 10
					vm = vm / 10
					removed++
				}
			}
			lastRemovedDigit = 4 when vrIsTrailingZeros && lastRemovedDigit == 5 && vr % 2 == 0
			let up = vr == vm && (!acceptBounds || !vmIsTrailingZeros) || lastRemovedDigit >= 5
			output = vr + (up ?? (uint64(1), uint64(0)))
		} else {
			let roundUp = false
			if vp / 100 > vm / 100 {
				roundUp = vr % 100 >= 50
				vr = vr / 100
				vp = vp / 100
				vm = vm / 100
				removed += 2
			}
			for vp / 10 > vm / 10 {
				roundUp = vr % 10 >= 5
				vr = vr / 10
				vp = vp / 10
				vm = vm / 10
				removed++
			}
			output = vr + (vr == vm || roundUp ?? (uint64(1), uint64(0)))
		}
		return (output, e10 + removed)
	}

	// Fields returns a finite float's sign, biased exponent and mantissa
	// field, exactly: scaling by powers of two is exact, so they are found by
	// halving and doubling in large steps.
	def fields(v float) (bool, int, uint64) {
		let negative = v < 0.0
		let m = negative ?? (-v, v)
		let e = 0
		// Bring m into [1, 2) (or below 1 at the subnormal floor), 64 bits a step
		// first.
		for m >= 18446744073709551616.0 {
			m = m / 18446744073709551616.0
			e += 64
		}
		for m >= 2.0 {
			m = m / 2.0
			e++
		}
		for m < 5.421010862427522e-20 && e - 64 >= -1022 {
			m = m * 18446744073709551616.0
			e -= 64
		}
		for m < 1.0 && e > -1022 {
			m = m * 2.0
			e--
		}
		return (negative, 0, uint64(m * 4503599627370496.0)) when m < 1.0
		return (negative, e + exponentBias, uint64((m - 1.0) * 4503599627370496.0))
	}
}
