// Generated by ~/.cache/adm-scratch/i18n/kit/gen_ryu_cases.js (node 26.10.0).
internal partial module std.math.ryu {
	use (
		std.testing
		std.math::(Decimal)
	)

	check "Ryu against JavaScript" {
		// The float with the given IEEE 754 bits, built exactly (scaling by two
		// is exact).
		def fromBits(hi int, lo int) float {
			let biased = (hi >> 20) & 0x7FF
			let mantissa = float((hi & 0xFFFFF) * 4294967296 + lo)
			let m = biased == 0 ?? (mantissa, mantissa + 4503599627370496.0)
			let e = (biased == 0 ?? (1, biased)) - 1075
			for e > 0 {
				m = m * 2.0
				e--
			}
			for e < 0 {
				m = m / 2.0
				e++
			}
			return (hi >> 31) & 1 == 1 ?? (-m, m)
		}

		// 1 when the shortest digits differ from JavaScript's, after printing both.
		def same(hi int, lo int, digits string, exponent int) int {
			let d = new Decimal(fromBits(hi, lo)).trim()
			let c = d.coefficient().toRadix(10)
			let e = d.exponent()
			for c.endsWith("0") {
				c = c[:c.len() - 1]
				e++
			}
			return 0 when c == digits && e == exponent
			println(hi.str() + " " + lo.str() + ": got " + c + "e" + e.str() + " want " + digits + "e" + exponent.str())
			return 1
		}

