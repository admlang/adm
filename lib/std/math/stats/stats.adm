partial module std.math.stats {
	use std.math

	// Statistics over `float[]` samples: `sum`, `mean`, `median`,
	// `quantile`, `mode`, `min`, `max`, `variance`, `deviation`,
	// `skewness`, `kurtosis`, `zscores`, `ranks`, `histogram`,
	// `covariance`, `correlation`, `rankCorrelation`, `linearRegression`,
	// `covarianceMatrix`, `correlationMatrix`, the `Normal` distribution
	// and the running `Summary`.
	//
	// ```
	// use std.math.stats
	//
	// let times = [12.1, 11.8, 12.4, 30.2, 12.0]
	// println(stats.median(times))        // 12.1
	// println(stats.quantile(times, 0.9)) // 23.08
	// ```
	//
	// A statistic of no values is 0, as is one that needs more values than
	// it got (the sample variance of one value).

	// The sum of the values, added eight at a time in a fixed order.
	def sum(values float[]) float {
		let v vec8<float>
		let acc = v.splat(0.0)
		let n = values.len()
		let i = 0
		for; i + 8 <= n; i += 8 {
			acc = acc + v.load(values, i)
		}
		let total = acc.sum()
		for; i < n; i++ {
			total += values[i]
		}
		return total
	}

	// The arithmetic mean.
	def mean(values float[]) float {
		return 0.0 when values.len() == 0
		return sum(values) / float(values.len())
	}

	// The smallest value.
	def min(values float[]) float {
		return 0.0 when values.len() == 0
		let best = values[0]
		for let (_, x) in values {
			best = x when x < best
		}
		return best
	}

	// The largest value.
	def max(values float[]) float {
		return 0.0 when values.len() == 0
		let best = values[0]
		for let (_, x) in values {
			best = x when x > best
		}
		return best
	}

	// The sum of (x - center)·(y - center2) over two runs of equal length.
	internal def crossSum(x float[], cx float, y float[], cy float) float {
		let v vec8<float>
		let acc = v.splat(0.0)
		let xv = v.splat(cx)
		let yv = v.splat(cy)
		let n = x.len()
		let i = 0
		for; i + 8 <= n; i += 8 {
			acc = acc + (v.load(x, i) - xv) * (v.load(y, i) - yv)
		}
		let total = acc.sum()
		for; i < n; i++ {
			total += (x[i] - cx) * (y[i] - cy)
		}
		return total
	}

	// The variance: the mean squared distance from the mean, dividing by
	// n - 1 for a sample (the default) or by n for a whole population.
	def variance(values float[], sample bool = true) float {
		let n = values.len()
		return 0.0 when n < (sample ?? (2, 1))
		let m = mean(values)
		return crossSum(values, m, values, m) / float(sample ?? (n - 1, n))
	}

	// The standard deviation: the square root of the variance.
	def deviation(values float[], sample bool = true) float {
		return math.sqrt(variance(values, sample))
	}

	// The values in ascending order, as a copy.
	internal def sorted(values float[]) float[] {
		return values.clone().sort((a, b) => a < b)
	}

	// The middle value, or the mean of the two middle values.
	def median(values float[]) float {
		return quantile(values, 0.5)
	}

	// The value below which the fraction q (0 to 1) of the values lie,
	// interpolated between the two nearest values in order (the usual
	// "type 7" definition). q outside 0..1 counts as the nearer end.
	def quantile(values float[], q float) float {
		let n = values.len()
		return 0.0 when n == 0
		let s = sorted(values)
		let at = (q < 0.0 ?? (0.0, q > 1.0 ?? (1.0, q))) * float(n - 1)
		let low = int(at.floor())
		return s[n - 1] when low >= n - 1
		return s[low] + (s[low + 1] - s[low]) * (at - float(low))
	}

	// The values that occur most often, in ascending order; every value
	// when none repeats.
	def mode(values float[]) float[] {
		let s = sorted(values)
		let out float[] = []
		let best = 0
		let i = 0
		for i < s.len() {
			let j = i
			for j < s.len() && s[j] == s[i] {
				j++
			}
			if j - i > best {
				best = j - i
				out = [s[i]]
			} else if j - i == best {
				out.push(s[i])
			}
			i = j
		}
		return out
	}

	// The skewness: the third standardized moment, 0 for a symmetric
	// sample, positive when the long tail is on the right. With `sample`
	// it is corrected for sample size (the adjusted Fisher–Pearson form).
	def skewness(values float[], sample bool = false) float {
		let n = values.len()
		return 0.0 when n < (sample ?? (3, 1))
		let m = mean(values)
		let m2 = 0.0
		let m3 = 0.0
		for let (_, x) in values {
			let d = x - m
			m2 += d * d
			m3 += d * d * d
		}
		m2 /= float(n)
		m3 /= float(n)
		return 0.0 when m2 == 0.0
		let g = m3 / (m2 * math.sqrt(m2))
		return g unless sample
		return g * math.sqrt(float(n) * float(n - 1)) / float(n - 2)
	}

	// The excess kurtosis: the fourth standardized moment minus 3, so a
	// normal distribution gives 0 and heavier tails a positive value.
	// With `sample` it is corrected for sample size.
	def kurtosis(values float[], sample bool = false) float {
		let n = values.len()
		return 0.0 when n < (sample ?? (4, 1))
		let m = mean(values)
		let m2 = 0.0
		let m4 = 0.0
		for let (_, x) in values {
			let d = (x - m) * (x - m)
			m2 += d
			m4 += d * d
		}
		m2 /= float(n)
		m4 /= float(n)
		return 0.0 when m2 == 0.0
		let g = m4 / (m2 * m2) - 3.0
		return g unless sample
		let k = float(n)
		return ((k + 1.0) * g + 6.0) * (k - 1.0) / ((k - 2.0) * (k - 3.0))
	}

	// Each value as its distance from the mean in standard deviations.
	// All zeros when the values do not vary.
	def zscores(values float[], sample bool = true) float[] {
		let m = mean(values)
		let d = deviation(values, sample)
		let out float[] = []
		for let (_, x) in values {
			out.push(d == 0.0 ?? (0.0, (x - m) / d))
		}
		return out
	}

	// The rank of each value in ascending order, from 1; equal values
	// share the mean of the ranks they cover.
	def ranks(values float[]) float[] {
		let n = values.len()
		let order int[] = []
		for let i = 0; i < n; i++ {
			order.push(i)
		}
		order = order.sort((a, b) => values[a] < values[b])
		let out float[] = []
		out.len(n)
		let i = 0
		for i < n {
			let j = i
			for j < n && values[order[j]] == values[order[i]] {
				j++
			}
			let shared = float(i + j + 1) / 2.0
			for let k = i; k < j; k++ {
				out[order[k]] = shared
			}
			i = j
		}
		return out
	}

	// Histogram counts values in equal bins: bin i covers edges[i] up to
	// edges[i + 1], the last bin including its upper edge.
	struct Histogram {
		edges  float[]
		counts int[]
	}

	// histogram counts the values in `bins` equal bins between the
	// smallest and the largest value. No values, or no bins, give an empty
	// histogram.
	def histogram(values float[], bins int) Histogram {
		return histogram(values, bins, min(values), max(values))
	}

	// histogram counts the values in `bins` equal bins between `low` and
	// `high`; values outside are left out.
	def histogram(values float[], bins int, low float, high float) Histogram {
		let out = Histogram{edges: [], counts: []}
		return out when bins <= 0 || values.len() == 0 || high < low
		let width = (high - low) / float(bins)
		for let i = 0; i <= bins; i++ {
			out.edges.push(i == bins ?? (high, low + width * float(i)))
		}
		out.counts.len(bins)
		out.counts.fill(0)
		for let (_, x) in values {
			continue when x < low || x > high
			let at = width == 0.0 ?? (0, int(((x - low) / width).floor()))
			at = bins - 1 when at >= bins
			out.counts[at]++
		}
		return out
	}

	// The covariance of two samples: the mean product of their distances
	// from their means, dividing by n - 1 for a sample or n for a
	// population.
	// Fails when the samples differ in length.
	def covariance(x float[], y float[], sample bool = true) !float {
		fail "stats: covariance needs samples of one length, got {x.len()} and {y.len()}" unless x.len() == y.len()
		let n = x.len()
		return 0.0 when n < (sample ?? (2, 1))
		return crossSum(x, mean(x), y, mean(y)) / float(sample ?? (n - 1, n))
	}

	// The Pearson correlation of two samples, from -1 to 1; 0 when either
	// does not vary.
	// Fails when the samples differ in length.
	def correlation(x float[], y float[]) !float {
		fail "stats: correlation needs samples of one length, got {x.len()} and {y.len()}" unless x.len() == y.len()
		let mx = mean(x)
		let my = mean(y)
		let sxx = crossSum(x, mx, x, mx)
		let syy = crossSum(y, my, y, my)
		return 0.0 when sxx == 0.0 || syy == 0.0
		return crossSum(x, mx, y, my) / math.sqrt(sxx * syy)
	}

	// The Spearman rank correlation: the Pearson correlation of the
	// ranks, 1 when one sample rises whenever the other does.
	// Fails when the samples differ in length.
	def rankCorrelation(x float[], y float[]) !float {
		fail "stats: correlation needs samples of one length, got {x.len()} and {y.len()}" unless x.len() == y.len()
		return correlation(ranks(x), ranks(y))
	}

	// Regression is the least squares line y = intercept + slope·x through
	// a set of points; `rSquared` is the share of y's variance the line
	// explains.
	type Regression {
		slope     float
		intercept float
		rSquared  float

		internal def new(slope float, intercept float, rSquared float) {
			self.slope = slope
			self.intercept = intercept
			self.rSquared = rSquared
		}

		// The y of the line at x.
		def predict(x float) float {
			return intercept + slope * x
		}
	}

	// linearRegression fits the least squares line through the points
	// (x[i], y[i]).
	// Fails when the samples differ in length, hold fewer than two points,
	// or x does not vary.
	def linearRegression(x float[], y float[]) !Regression {
		fail "stats: regression needs samples of one length, got {x.len()} and {y.len()}" unless x.len() == y.len()
		fail "stats: regression needs at least two points" when x.len() < 2
		let mx = mean(x)
		let my = mean(y)
		let sxx = crossSum(x, mx, x, mx)
		fail "stats: regression needs x values that differ" when sxx == 0.0
		let sxy = crossSum(x, mx, y, my)
		let syy = crossSum(y, my, y, my)
		let slope = sxy / sxx
		return new Regression(slope, my - slope * mx, syy == 0.0 ?? (1.0, sxy * sxy / (sxx * syy)))
	}

	// covarianceMatrix takes a matrix with one observation per row and
	// one variable per column and returns the covariance of every pair of
	// variables, a symmetric cols × cols matrix.
	def covarianceMatrix(data matrix<float>, sample bool = true) matrix<float> {
		let (rows, cols) = data.size()
		let out = matrix<float>[].size(cols, cols)
		return out when rows < (sample ?? (2, 1))
		// Centre the columns, then Xᵀ·X by the matrix product.
		let centered = data.clone()
		let d = centered.data()
		for let c = 0; c < cols; c++ {
			let total = 0.0
			for let r = 0; r < rows; r++ {
				total += d[r * cols + c]
			}
			let m = total / float(rows)
			for let r = 0; r < rows; r++ {
				d[r * cols + c] -= m
			}
		}
		return (centered.transpose() * centered).divide(float(sample ?? (rows - 1, rows)))
	}

	// correlationMatrix is covarianceMatrix scaled so that every variable
	// has variance 1: Pearson correlations, 1 on the diagonal (0 for a
	// variable that does not vary).
	def correlationMatrix(data matrix<float>) matrix<float> {
		let out = covarianceMatrix(data, false)
		let n = out.rows
		let d = out.data()
		let scales float[] = []
		for let i = 0; i < n; i++ {
			scales.push(math.sqrt(d[i * n + i]))
		}
		for let i = 0; i < n; i++ {
			for let j = 0; j < n; j++ {
				let s = scales[i] * scales[j]
				d[i * n + j] = s == 0.0 ?? (0.0, d[i * n + j] / s)
			}
		}
		return out
	}

	// Normal is the normal (Gaussian) distribution with a mean and a
	// standard deviation.
	//
	// ```
	// let iq = new Normal(100.0, 15.0)
	// println(iq.cdf(130.0))      // 0.9772...
	// println(iq.quantile(0.99))  // 134.89...
	// ```
	type Normal {
		mean      float = 0.0
		deviation float = 1.0

		def new() {}

		def new(mean float, deviation float) {
			self.mean = mean
			self.deviation = deviation
		}

		// The density at x.
		def pdf(x float) float {
			let z = (x - mean) / deviation
			return (math.E ** (-0.5 * z * z)) / (deviation * 2.5066282746310002)
		}

		// The probability of a value at or below x.
		def cdf(x float) float {
			return 0.5 * math.erfc(-(x - mean) / (deviation * 1.4142135623730951))
		}

		// The x with cdf(x) = p; the mean for p outside 0..1 exclusive of
		// the ends, where no finite value answers.
		def quantile(p float) float {
			return mean unless p > 0.0 && p < 1.0
			return mean + deviation * standardQuantile(p)
		}
	}

	// The standard normal quantile: Acklam's rational approximation, then
	// one Halley step against the exact cdf, which brings it to float
	// accuracy.
	internal def standardQuantile(p float) float {
		let a = [-39.69683028665376, 220.9460984245205, -275.9285104469687, 138.3577518672690, -30.66479806614716, 2.506628277459239]
		let b = [-54.47609879822406, 161.5858368580409, -155.6989798598866, 66.80131188771972, -13.28068155288572]
		let c = [-0.007784894002430293, -0.3223964580411365, -2.400758277161838, -2.549732539343734, 4.374664141464968, 2.938163982698783]
		let d = [0.007784695709041462, 0.3224671290700398, 2.445134137142996, 3.754408661907416]
		let x = 0.0
		if p < 0.02425 {
			let q = math.sqrt(-2.0 * math.ln(p))
			x = (((((c[0] * q + c[1]) * q + c[2]) * q + c[3]) * q + c[4]) * q + c[5]) / ((((d[0] * q + d[1]) * q + d[2]) * q + d[3]) * q + 1.0)
		} else if p > 1.0 - 0.02425 {
			let q = math.sqrt(-2.0 * math.ln(1.0 - p))
			x = -(((((c[0] * q + c[1]) * q + c[2]) * q + c[3]) * q + c[4]) * q + c[5]) / ((((d[0] * q + d[1]) * q + d[2]) * q + d[3]) * q + 1.0)
		} else {
			let q = p - 0.5
			let r = q * q
			x = (((((a[0] * r + a[1]) * r + a[2]) * r + a[3]) * r + a[4]) * r + a[5]) * q / (((((b[0] * r + b[1]) * r + b[2]) * r + b[3]) * r + b[4]) * r + 1.0)
		}
		let e = 0.5 * math.erfc(-x / 1.4142135623730951) - p
		let u = e * 2.5066282746310002 * (math.E ** (x * x / 2.0))
		return x - u / (1.0 + x * u / 2.0)
	}

	// Summary follows the count, mean, variance, smallest and largest of
	// values as they arrive, without keeping them.
	//
	// ```
	// let latency = new Summary()
	// latency.add(12.5)
	// latency.add(9.75)
	// println(latency.mean) // 11.125
	// ```
	type Summary {
		count           int   = 0
		mean            float = 0.0
		min             float = 0.0
		max             float = 0.0
		// The sum of squared distances from the mean so far.
		internal spread float = 0.0

		def new() {}

		// Takes one more value.
		def add(x float) {
			count++
			if count == 1 {
				min = x
				max = x
			}
			min = x when x < min
			max = x when x > max
			let delta = x - mean
			mean += delta / float(count)
			spread += delta * (x - mean)
		}

		// Takes every value of the array.
		def add(values float[]) {
			for let (_, x) in values {
				add(x)
			}
		}

		// The variance of the values so far, as `stats.variance` gives it.
		def variance(sample bool = true) float {
			return 0.0 when count < (sample ?? (2, 1))
			return spread / float(sample ?? (count - 1, count))
		}

		// The standard deviation of the values so far.
		def deviation(sample bool = true) float {
			return math.sqrt(variance(sample))
		}
	}
}
