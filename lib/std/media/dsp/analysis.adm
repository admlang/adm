partial module std.media.dsp {
	use (
		std.math
		std.math.processing
		std.formats.audio
		std.media.dsp.core::*
	)

	// The window a `Spectrum` shapes each block with before its FFT.
	enum Window {
		// No shaping: sharpest peaks, most leakage.
		Rectangular
		// The usual choice.
		Hann
		Hamming
		// Least leakage, widest peaks.
		Blackman
	}

	// Spectrum measures how loud each frequency is, for a visualizer. It
	// only listens: `process` leaves the samples as they are, so it goes in
	// an effects list anywhere.
	type Spectrum {
		// Off, a player skips it; it keeps its settings.
		enabled bool = true

		// Samples per FFT, a power of two: more is finer in frequency, slower
		// to follow.
		size      int    = 2048
		window    Window = Window.Hann
		// 0 follows every block, towards 1 moves ever more slowly.
		smoothing float  = 0.5

		// The last `size` samples, channels mixed down, as a ring from
		// `cursor`; the rate they came at; the smoothed levels last given.
		internal recent float[]
		internal cursor int
		internal rate   int
		internal levels float[]

		// process adds `samples` (all channels mixed down) to what is
		// measured.
		def process(samples float32[], info audio.AudioInfo) {
			let channels = int(info.channels)
			return unless enabled && channels > 0
			rate = int(info.sampleRate)
			let n = fftSize()
			if recent.len() != n {
				recent = float[]
				recent.len(n)
				cursor = 0
				levels = float[]
			}
			for let at = 0; at + channels <= samples.len(); at += channels {
				let sum = 0.0
				for let c = 0; c < channels; c++ {
					sum += float(samples[at + c])
				}
				recent[cursor] = sum / float(channels)
				cursor = (cursor + 1) % n
			}
		}

		// The level in dB of each FFT bin, `size / 2 + 1` of them, from 0 Hz to
		// half the sample rate.
		def magnitudes() float[] {
			let n = fftSize()
			let block float64[]
			block.len(n)
			let gain = 0.0
			for let i = 0; i < n; i++ {
				let w = windowAt(window, i, n)
				gain += w
				let sample = recent.len() == n ?? (recent[(cursor + i) % n], 0.0)
				block[i] = float64(sample * w)
			}
			let bins = processing.rfft(block)
			// Scaled so a full-scale sine reads 0 dB in its bin.
			let scale = gain > 0.0 ?? (2.0 / gain, 0.0)
			let keep = smoothing.clamp(0.0, 0.999)
			let fresh = levels.len() != bins.len()
			if fresh {
				levels = float[]
				levels.len(bins.len())
			}
			for let (i, bin) in bins {
				let db = dbOf(float(bin.abs()) * scale)
				levels[i] = fresh ?? (db, keep * levels[i] + (1.0 - keep) * db)
			}
			return levels.clone()
		}

		// The level in dB of `count` bands spaced evenly in pitch from `low` to
		// `high` Hz.
		def bands(count int, low float = 20.0, high float = 20000.0) float[] {
			let out float[]
			return out when count <= 0
			let bins = magnitudes()
			let sampleRate = rate > 0 ?? (rate, 48000)
			let hzPerBin = float(sampleRate) / float(fftSize())
			let top = high.min(float(sampleRate) / 2.0)
			let bottom = low.max(hzPerBin / 2.0)
			let ratio = top / bottom
			for let b = 0; b < count; b++ {
				let from = bottom * ratio ** (float(b) / float(count))
				let to = bottom * ratio ** (float(b + 1) / float(count))
				let first = int(from / hzPerBin + 0.5).clamp(0, bins.len() - 1)
				let last = int(to / hzPerBin + 0.5).clamp(first, bins.len() - 1)
				// A band narrower than a bin takes the bin it falls in.
				let loudest = bins[first]
				for let i = first + 1; i < last; i++ {
					loudest = bins[i] when bins[i] > loudest
				}
				out.push(loudest)
			}
			return out
		}

		// The same bands as heights to draw, 0 to 1: `floor` dB and below is 0,
		// 0 dB is 1, evenly in dB between.
		def bars(count int, low float = 20.0, high float = 20000.0, floor float = -90.0) float[] {
			let out = bands(count, low, high)
			let range = floor < 0.0 ?? (-floor, 90.0)
			for let i = 0; i < out.len(); i++ {
				out[i] = ((out[i] + range) / range).clamp(0.0, 1.0)
			}
			return out
		}

		// `size` rounded up to a power of two, at least 16.
		internal def fftSize() int {
			let n = 16
			for n < size {
				n *= 2
			}
			return n
		}
	}

	// LevelMeter measures how loud each channel is: its peak and its average
	// (RMS), in dB, 0 being full scale. It only listens.
	type LevelMeter {
		// Off, a player skips it; it keeps its settings.
		enabled bool = true

		// How long a peak is held before it falls.
		hold duration = 1s

		// Per channel: the held peak, how many frames it has been held, and
		// the RMS of the last block, all linear.
		internal peaks  float[]
		internal ages   int[]
		internal levels float[]

		// process measures `samples`.
		def process(samples float32[], info audio.AudioInfo) {
			let channels = int(info.channels)
			return unless enabled && channels > 0
			if peaks.len() != channels {
				peaks = float[]
				ages = int[]
				levels = float[]
				peaks.len(channels)
				ages.len(channels)
				levels.len(channels)
			}
			let frames = samples.len() / channels
			return when frames == 0
			let holdFrames = framesOf(hold, int(info.sampleRate))
			for let c = 0; c < channels; c++ {
				let loudest = 0.0
				let power = 0.0
				for let f = 0; f < frames; f++ {
					let v = float(samples[f * channels + c])
					power += v * v
					loudest = v.abs() when v.abs() > loudest
				}
				levels[c] = math.sqrt(power / float(frames))
				ages[c] += frames
				if loudest >= peaks[c] || ages[c] > holdFrames {
					peaks[c] = loudest
					ages[c] = 0
				}
			}
		}

		// The held peak of channel `channel` in dB.
		def peak(channel int) float {
			return SILENCE_DB when channel < 0 || channel >= peaks.len()
			return dbOf(peaks[channel])
		}

		// The RMS level of channel `channel` over the last block, in dB.
		def rms(channel int) float {
			return SILENCE_DB when channel < 0 || channel >= levels.len()
			return dbOf(levels[channel])
		}
	}
}
