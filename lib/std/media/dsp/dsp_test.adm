partial module std.media.dsp {
	use (
		std.testing
		std.math
		std.formats.audio
		std.media.dsp.core::*
		std.units::*
	)

	check "DSP" {
		const RATE = 48000

		internal def info(channels int) audio.AudioInfo {
			return audio.AudioInfo{sampleRate: uint32(RATE), channels: uint16(channels), format: audio.SampleFormat.Float32}
		}

		// `frames` frames of a sine at `hz` and `amplitude`, in `channels`
		// equal channels.
		internal def sine(hz float, amplitude float, frames int, channels int = 1) float32[] {
			let out float32[]
			for let i = 0; i < frames; i++ {
				let v = float32(amplitude * math.sin(2.0 * math.Pi * hz * float(i) / float(RATE)))
				for let c = 0; c < channels; c++ {
					out.push(v)
				}
			}
			return out
		}

		// The largest absolute sample from frame `from` on.
		internal def peakOf(samples float32[], from int = 0) float {
			let top = 0.0
			for let i = from; i < samples.len(); i++ {
				top = float(samples[i]).abs() when float(samples[i]).abs() > top
			}
			return top
		}

		@test()
		def TestBiquadLowPass() {
			let low = new Biquad(FilterKind.LowPass, 1000.0)
			assert math.approx(low.response(1000.0, RATE), -3.01, 0.05)
			assert math.approx(low.response(100.0, RATE), 0.0, 0.01)
			let high = sine(10000.0, 1.0, RATE / 10)
			low.process(high, info(1))
			// A decade above the corner, a second-order filter is down 40 dB.
			assert peakOf(high, 1000) < 0.02
			let passes = new Biquad(FilterKind.LowPass, 1000.0)
			let bass = sine(100.0, 1.0, RATE / 10)
			passes.process(bass, info(1))
			assert math.approx(peakOf(bass, 2000), 1.0, 0.01)
		}

		@test()
		def TestBiquadShapes() {
			let peak = new Biquad(FilterKind.Peak, 1000.0, 1.0, 6.0)
			assert math.approx(peak.response(1000.0, RATE), 6.0, 0.01)
			assert peak.response(50.0, RATE).abs() < 0.3
			let shelf = new Biquad(FilterKind.LowShelf, 200.0, 0.7071, -6.0)
			assert math.approx(shelf.response(20.0, RATE), -6.0, 0.2)
			assert shelf.response(5000.0, RATE).abs() < 0.2
			let notch = new Biquad(FilterKind.Notch, 1000.0, 4.0)
			assert notch.response(1000.0, RATE) < -60.0
			// Off, it passes the sound unchanged.
			let off = new Biquad(FilterKind.LowPass, 100.0)
			off.enabled = false
			let tone = sine(5000.0, 0.5, 256)
			let copy = tone.clone()
			off.process(tone, info(1))
			assert tone.equals(copy)
		}

		@test()
		def TestEqualizer() {
			let eq = new Equalizer(EqLayout.Graphic10)
			assert eq.bands.len() == 10 && eq.bands[5].frequency == 1000.0
			assert eq.response(1000.0, RATE).abs() < 0.001
			eq.set(5, 6.0)
			assert eq.response(1000.0, RATE) > 5.5
			eq.apply(EqPreset.Rock)
			assert eq.bands.len() == 10 && eq.bands[0].gain == 5.0 && eq.preamp == -5.0
			// The preamp leaves room for the loudest boost.
			assert eq.response(31.0, RATE) < 1.5
			eq.flat()
			assert eq.response(4000.0, RATE).abs() < 0.001
			assert new Equalizer(EqLayout.Graphic31).bands.len() == 31
			assert new Equalizer().bands.len() == 0
			// A boosted band makes its tone louder.
			let boost = new Equalizer(EqLayout.Graphic10)
			boost.set(5, 6.0)
			let tone = sine(1000.0, 0.25, RATE / 10)
			boost.process(tone, info(1))
			assert math.approx(peakOf(tone, 2000), 0.25 * 6(dB), 0.01)
		}

		@test()
		def TestCompressor() {
			let comp = new Compressor()
			comp.knee = 0.0
			let loud float32[]
			loud.len(RATE)
			loud.fill(float32(0.9))
			comp.process(loud, info(1))
			// 0.9 is -0.915 dB, 17.085 over; a 4:1 ratio takes 3/4 of that off.
			let expected = (dbOf(0.9) + 18.0) * 0.75
			assert math.approx(comp.reduction(), expected, 0.05)
			assert math.approx(float(loud[loud.len() - 1]), 0.9 * quantity(-expected, dB), 0.001)
			let quiet float32[]
			quiet.len(1000)
			quiet.fill(float32(0.01))
			let soft = new Compressor()
			soft.process(quiet, info(1))
			assert soft.reduction() < 0.001 && quiet[999] == float32(0.01)
		}

		@test()
		def TestLimiter() {
			let limit = new Limiter()
			let hot = sine(440.0, 1.5, RATE / 2, 2)
			limit.process(hot, info(2))
			assert peakOf(hot) <= -1(dB) + 1e-6
			assert limit.reduction() > 3.0
			// Below the ceiling it only delays.
			let calm = new Limiter()
			calm.lookahead = 0s
			let low = sine(440.0, 0.5, 4800)
			let copy = low.clone()
			calm.process(low, info(1))
			assert low.equals(copy) && calm.reduction() < 1e-9
		}

		@test()
		def TestMixers() {
			let samples = float32[0.5, 0.25, -0.5, 1.0]
			new Gain(-6.0).process(samples, info(2))
			assert math.approx(float(samples[0]), 0.5 * -6(dB), 1e-6)

			let panned = float32[1.0, 1.0]
			let left = new Balance()
			left.balance = -0.5
			left.process(panned, info(2))
			assert panned[0] == 1.0 && panned[1] == 0.5

			let wide = float32[1.0, 0.0]
			let mono = new StereoWidth()
			mono.width = 0.0
			mono.process(wide, info(2))
			assert wide[0] == 0.5 && wide[1] == 0.5
		}

		@test()
		def TestDelay() {
			let echo = new Delay()
			echo.time = 10ms
			echo.mix = 0.5
			echo.feedback = 0.5
			let pulse float32[]
			pulse.len(RATE / 10)
			pulse[0] = 1.0
			echo.process(pulse, info(1))
			let gap = RATE / 100
			assert pulse[0] == 0.5 && pulse[gap] == 0.5 && pulse[2 * gap] == 0.25
			assert pulse[gap - 1] == 0.0 && pulse[gap + 1] == 0.0
		}

		@test()
		def TestReverbAndChorus() {
			let room = new Reverb()
			let pulse float32[]
			pulse.len(RATE)
			pulse[0] = 1.0
			room.process(pulse, info(1))
			// The room answers after the impulse and dies away.
			assert peakOf(pulse, 100) > 0.001
			assert peakOf(pulse, RATE / 2) < peakOf(pulse, 100)
			room.reset()
			let silence float32[]
			silence.len(4800)
			room.process(silence, info(1))
			assert peakOf(silence) == 0.0

			let chorus = new Chorus()
			let tone = sine(440.0, 0.5, RATE / 10, 2)
			chorus.process(tone, info(2))
			assert peakOf(tone) <= 0.5 + 1e-6 && peakOf(tone, 2000) > 0.1
		}

		@test()
		def TestSpectrum() {
			let spectrum = new Spectrum()
			spectrum.smoothing = 0.0
			spectrum.process(sine(1500.0, 1.0, 4096, 2), info(2))
			let bins = spectrum.magnitudes()
			assert bins.len() == 1025
			// 1500 Hz is bin 64 at 48 kHz / 2048.
			let loudest = 0
			for let i = 0; i < bins.len(); i++ {
				loudest = i when bins[i] > bins[loudest]
			}
			assert loudest == 64 && bins[64].abs() < 0.5
			assert bins[300] < -60.0
			let bars = spectrum.bars(16)
			assert bars.len() == 16
			for let (_, h) in bars {
				assert h >= 0.0 && h <= 1.0
			}
		}

		@test()
		def TestLevelMeter() {
			let meter = new LevelMeter()
			meter.process(sine(1000.0, 0.5, RATE / 10, 2), info(2))
			assert math.approx(meter.peak(0), -6.02, 0.05)
			// A sine's RMS is its peak over the square root of two.
			assert math.approx(meter.rms(1), -9.03, 0.05)
			assert meter.peak(5) < -100.0
		}
	}
}
