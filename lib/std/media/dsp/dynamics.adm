partial module std.media.dsp {
	use (
		std.formats.audio
		std.media.dsp.core::*
		std.units::quantity
	)

	// Compressor turns down what is louder than `threshold`, evening out
	// loudness. The channels are compressed together, so the stereo image
	// stays put.
	type Compressor {
		// Off, a player skips it; it keeps its settings.
		enabled bool = true

		// dB above which the level is reduced.
		threshold float    = -18.0
		// How much: 4 lets 4 dB over the threshold out as 1 dB over.
		ratio     float    = 4.0
		// How fast it reacts to a louder sound, and lets go after it.
		attack    duration = 10ms
		release   duration = 100ms
		// dB around the threshold over which the reduction eases in.
		knee      float    = 6.0
		// dB added after, to make up for the reduction.
		makeup    float

		// How many dB it turns down now, smoothed, and the gain applied at the
		// end of the last block (0 before the first).
		internal envelope float
		internal applied  float

		// process compresses `samples` (interleaved, `info.channels` wide) in
		// place.
		def process(samples float32[], info audio.AudioInfo) {
			return unless enabled
			let width = int(info.channels)
			return when width <= 0
			let rate = int(info.sampleRate)
			// The envelope moves once per control block of `CONTROL_FRAMES`.
			let rise = smoothing(attack, rate) ** float(CONTROL_FRAMES)
			let fall = smoothing(release, rate) ** float(CONTROL_FRAMES)
			let lift = quantity(makeup, dB)
			let slope = 1.0 - 1.0 / (ratio < 1.0 ?? (1.0, ratio))
			let frames = samples.len() / width
			for let start = 0; start < frames; start += CONTROL_FRAMES {
				let end = (start + CONTROL_FRAMES).min(frames)
				let peak = 0.0
				for let i = start * width; i < end * width; i++ {
					let v = float(samples[i]).abs()
					peak = v when v > peak
				}
				let over = dbOf(peak) - threshold
				let target = 0.0
				if knee > 0.0 && 2.0 * over.abs() <= knee {
					// Inside the knee the slope eases in quadratically.
					let into = over + knee / 2.0
					target = slope * into * into / (2.0 * knee)
				} else if over > 0.0 {
					target = slope * over
				}
				let coefficient = target > envelope ?? (rise, fall)
				envelope = coefficient * envelope + (1.0 - coefficient) * target
				let to = quantity(-envelope, dB) * lift
				let from = applied == 0.0 ?? (to, applied)
				let step = (to - from) / float(end - start)
				for let f = start; f < end; f++ {
					let g = float32(from + step * float(f - start + 1))
					for let c = 0; c < width; c++ {
						samples[f * width + c] = samples[f * width + c] * g
					}
				}
				applied = to
			}
		}

		// How many dB it is turning down right now, for a meter.
		def reduction() float {
			return envelope
		}

		// reset forgets the level so far, as after a seek.
		def reset() {
			envelope = 0.0
			applied = 0.0
		}
	}

	// Limiter keeps peaks under `ceiling`: nothing passes above it, so a
	// volume above 1 or a boosting equalizer never clips. It looks ahead by
	// `lookahead`, which delays the sound by that much, so the gain is already
	// down when a peak arrives.
	type Limiter {
		// Off, a player skips it; it keeps its settings.
		enabled bool = true

		// dB the output never exceeds.
		ceiling   float    = -1.0
		release   duration = 50ms
		lookahead duration = 5ms

		// The gain now, 1 when nothing is being limited.
		internal gain     float       = 1.0
		// The delayed input, one ring of `lag` frames per channel, and the gain
		// each of the last `lag + 1` frames needs: every frame still in the
		// delay, and the one just in.
		internal delayed  float32[][]
		internal needed   float[]
		internal lag      int
		internal cursor   int
		internal slot     int
		internal channels int
		internal rate     int

		// process limits `samples` (interleaved, `info.channels` wide) in place.
		def process(samples float32[], info audio.AudioInfo) {
			return unless enabled
			let width = int(info.channels)
			return when width <= 0
			prepare(int(info.sampleRate), width)
			let top = quantity(ceiling, dB)
			let fall = smoothing(release, rate)
			let frames = samples.len() / width
			for let f = 0; f < frames; f++ {
				let at = f * width
				let peak = 0.0
				for let c = 0; c < width; c++ {
					let v = float(samples[at + c]).abs()
					peak = v when v > peak
				}
				needed[slot] = peak > top ?? (top / peak, 1.0)
				slot = (slot + 1) % needed.len()
				// The lowest gain any frame still in the window needs.
				let least = 1.0
				for let (_, n) in needed {
					least = n when n < least
				}
				gain = least < gain ?? (least, fall * gain + (1.0 - fall) * least)
				let g = float32(gain)
				let limit = float32(top)
				for let c = 0; c < width; c++ {
					let input = samples[at + c]
					let out = input
					if lag > 0 {
						let line = delayed[c]
						out = line[cursor]
						line[cursor] = input
					}
					out = out * g
					// The gain already covers the frame going out; the clamp
					// keeps the promise however the gain was smoothed.
					samples[at + c] = out > limit ?? (limit, out < -limit ?? (-limit, out))
				}
				cursor = (cursor + 1) % lag when lag > 0
			}
		}

		// How many dB it is turning down right now, for a meter.
		def reduction() float {
			return -dbOf(gain)
		}

		// reset forgets the level and the delayed samples, as after a seek.
		def reset() {
			for let (_, line) in delayed {
				line.fill(float32(0.0))
			}
			needed.fill(1.0)
			gain = 1.0
			cursor = 0
			slot = 0
		}

		// Sizes the delay for `rate` and `channels`, starting over when either
		// or the lookahead changed.
		internal def prepare(rate int, channels int) {
			let frames = framesOf(lookahead, rate)
			return when rate == self.rate && channels == self.channels && frames == lag && needed.len() > 0
			self.rate = rate
			self.channels = channels
			lag = frames
			delayed = float32[][]
			for let c = 0; c < channels; c++ {
				let line float32[]
				line.len(lag)
				delayed.push(line)
			}
			needed = float[]
			needed.len(lag + 1)
			reset()
		}
	}
}
