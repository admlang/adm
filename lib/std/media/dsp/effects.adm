partial module std.media.dsp {
	use (
		std.math
		std.formats.audio
		std.media.dsp.core::*
	)

	// Reverb places the sound in a room: eight damped combs into four
	// all-passes per side (the Schroeder-Moorer design, as Freeverb tunes it).
	// Mono and stereo are reverberated; channels beyond the first two pass
	// unchanged.
	type Reverb {
		// Off, a player skips it; it keeps its settings.
		enabled bool = true

		// 0 a small room, 1 a hall.
		roomSize float = 0.5
		// How quickly high frequencies die away, 0 to 1.
		damping  float = 0.5
		// Levels of the room sound and of the sound as it came in, 0 to 1.
		wet      float = 0.3
		dry      float = 1.0
		// Stereo spread of the room, 0 to 1.
		width    float = 1.0

		// The comb and all-pass delay lines, left side first, their cursors,
		// and each comb's low-pass memory.
		internal combs  float32[][]
		internal combAt int[]
		internal stores float[]
		internal passes float32[][]
		internal passAt int[]
		internal rate   int
		// Per-block scratch: the mono input and each side's room sound.
		internal input  float[]
		internal outL   float[]
		internal outR   float[]
		// Frames of silent input since the last sound, compared with how long
		// the room rings, so a silent room costs nothing.
		internal idle   int

		// process adds the room to `samples` (interleaved, `info.channels`
		// wide) in place.
		def process(samples float32[], info audio.AudioInfo) {
			let channels = int(info.channels)
			return unless enabled && channels > 0
			prepare(int(info.sampleRate))
			let feedback = REVERB_ROOM_OFFSET + REVERB_ROOM_SCALE * roomSize.clamp(0.0, 1.0)
			if silent(samples) {
				let longest = combs[combs.len() - 1].len()
				// The longest comb falls 60 dB after this many round trips.
				let ring = int(float(longest) * -6.907755 / math.ln(feedback)) + longest
				if idle >= ring {
					if dry != 1.0 {
						let g = float32(dry)
						for let i = 0; i < samples.len(); i++ {
							samples[i] = samples[i] * g
						}
					}
					return
				}
				idle += samples.len() / channels
			} else {
				idle = 0
			}
			let damp = REVERB_DAMP_SCALE * damping.clamp(0.0, 1.0)
			let spread = width.clamp(0.0, 1.0)
			let wet1 = wet * REVERB_WET_SCALE * (spread / 2.0 + 0.5)
			let wet2 = wet * REVERB_WET_SCALE * ((1.0 - spread) / 2.0)
			let stereo = channels >= 2
			let frames = samples.len() / channels
			input.len(frames)
			outL.len(frames)
			outR.len(frames)
			for let f = 0; f < frames; f++ {
				let inL = float(samples[f * channels])
				let inR = stereo ?? (float(samples[f * channels + 1]), inL)
				input[f] = (inL + inR) * REVERB_INPUT_GAIN
				outL[f] = 0.0
				outR[f] = 0.0
			}
			// Line by line over the whole block: each line's state stays in
			// registers, and every frame still sums the combs in order.
			for let i = 0; i < REVERB_COMBS; i++ {
				comb(i, outL, frames, feedback, damp)
				comb(i + REVERB_COMBS, outR, frames, feedback, damp)
			}
			for let i = 0; i < REVERB_PASSES; i++ {
				allPass(i, outL, frames)
				allPass(i + REVERB_PASSES, outR, frames)
			}
			for let f = 0; f < frames; f++ {
				let at = f * channels
				let inL = float(samples[at])
				if stereo {
					let inR = float(samples[at + 1])
					samples[at] = float32(outL[f] * wet1 + outR[f] * wet2 + inL * dry)
					samples[at + 1] = float32(outR[f] * wet1 + outL[f] * wet2 + inR * dry)
				} else {
					samples[at] = float32((outL[f] + outR[f]) / 2.0 * wet * REVERB_WET_SCALE + inL * dry)
				}
			}
		}

		// reset silences the room, as after a seek.
		def reset() {
			for let (_, line) in combs {
				line.fill(float32(0.0))
			}
			for let (_, line) in passes {
				line.fill(float32(0.0))
			}
			stores.fill(0.0)
			idle = 0
		}

		// Whether every sample is below the level a room would still answer.
		internal def silent(samples float32[]) bool {
			for let (_, v) in samples {
				return false when v > float32(1e-7) || v < float32(-1e-7)
			}
			return true
		}

		// One damped comb over `frames` of `input`: adds what comes out of
		// line `i` to `out`, feeding the input back.
		internal def comb(i int, out float[], frames int, feedback float, damp float) {
			let line = combs[i]
			let size = line.len()
			let at = combAt[i]
			let store = stores[i]
			for let f = 0; f < frames; f++ {
				let held = float(line[at])
				store = held * (1.0 - damp) + store * damp
				line[at] = float32(input[f] + store * feedback)
				at += 1
				at = 0 when at == size
				out[f] += held
			}
			combAt[i] = at
			stores[i] = store
		}

		// One all-pass: diffuses `frames` of `signal` through line `i` in place.
		internal def allPass(i int, signal float[], frames int) {
			let line = passes[i]
			let size = line.len()
			let at = passAt[i]
			for let f = 0; f < frames; f++ {
				let x = signal[f]
				let held = float(line[at])
				line[at] = float32(x + held * REVERB_PASS_FEEDBACK)
				at += 1
				at = 0 when at == size
				signal[f] = held - x
			}
			passAt[i] = at
		}

		// Sizes the delay lines for `rate`, scaled from their 44.1 kHz lengths.
		internal def prepare(rate int) {
			return when rate == self.rate && combs.len() > 0
			self.rate = rate
			let scale = float(rate) / 44100.0
			combs = float32[][]
			passes = float32[][]
			for let side = 0; side < 2; side++ {
				for let (_, length) in REVERB_COMB_LENGTHS {
					let line float32[]
					line.len(int(float(length + side * REVERB_SPREAD) * scale).max(1))
					combs.push(line)
				}
			}
			for let side = 0; side < 2; side++ {
				for let (_, length) in REVERB_PASS_LENGTHS {
					let line float32[]
					line.len(int(float(length + side * REVERB_SPREAD) * scale).max(1))
					passes.push(line)
				}
			}
			combAt = int[]
			combAt.len(combs.len())
			passAt = int[]
			passAt.len(passes.len())
			stores = float[]
			stores.len(combs.len())
		}
	}

	// Delay repeats the sound after `time`, each repeat quieter by
	// `feedback`.
	type Delay {
		// Off, a player skips it; it keeps its settings.
		enabled bool = true

		time     duration = 350ms
		// Share of each repeat fed into the next, 0 to below 1.
		feedback float    = 0.35
		// Share of the repeats in the output, 0 to 1.
		mix      float    = 0.3
		// Repeats alternate between the left and right channel.
		pingPong bool

		// One delay line per channel and the cursor into them.
		internal lines    float32[][]
		internal cursor   int
		internal channels int
		internal rate     int

		// process adds the repeats to `samples` in place.
		def process(samples float32[], info audio.AudioInfo) {
			let width = int(info.channels)
			return unless enabled && width > 0
			prepare(int(info.sampleRate), width)
			let length = lines[0].len()
			let fb = float32(feedback.clamp(0.0, 0.99))
			let wetShare = float32(mix.clamp(0.0, 1.0))
			let dryShare = float32(1.0) - wetShare
			let crossed = pingPong && width >= 2
			for let at = 0; at + width <= samples.len(); at += width {
				if crossed {
					let left = lines[0]
					let right = lines[1]
					let heardL = left[cursor]
					let heardR = right[cursor]
					// The input enters on the left, each repeat crosses over.
					left[cursor] = (samples[at] + samples[at + 1]) * float32(0.5) + heardR * fb
					right[cursor] = heardL * fb
					samples[at] = samples[at] * dryShare + heardL * wetShare
					samples[at + 1] = samples[at + 1] * dryShare + heardR * wetShare
					for let c = 2; c < width; c++ {
						delayChannel(samples, at + c, c, fb, dryShare, wetShare)
					}
				} else {
					for let c = 0; c < width; c++ {
						delayChannel(samples, at + c, c, fb, dryShare, wetShare)
					}
				}
				cursor = (cursor + 1) % length
			}
		}

		// reset forgets the repeats, as after a seek.
		def reset() {
			for let (_, line) in lines {
				line.fill(float32(0.0))
			}
			cursor = 0
		}

		// Plain feedback delay of the sample at `at` through line `c`.
		internal def delayChannel(samples float32[], at int, c int, fb float32, dryShare float32, wetShare float32) {
			let line = lines[c]
			let heard = line[cursor]
			line[cursor] = samples[at] + heard * fb
			samples[at] = samples[at] * dryShare + heard * wetShare
		}

		// Sizes the lines for `time` at `rate`, starting over when anything
		// changed.
		internal def prepare(rate int, channels int) {
			let frames = framesOf(time, rate, 1)
			return when rate == self.rate && channels == self.channels && lines.len() > 0 && lines[0].len() == frames
			self.rate = rate
			self.channels = channels
			lines = float32[][]
			for let c = 0; c < channels; c++ {
				let line float32[]
				line.len(frames)
				lines.push(line)
			}
			cursor = 0
		}
	}

	// Chorus thickens the sound with copies delayed by a slowly swaying few
	// milliseconds.
	type Chorus {
		// Off, a player skips it; it keeps its settings.
		enabled bool = true

		// Sways per second.
		rate   float    = 0.8
		// How far the delay sways.
		depth  duration = 3ms
		// Share of the copies in the output, 0 to 1.
		mix    float    = 0.5
		// Copies per channel.
		voices int      = 2

		// One history line per channel, the cursor into them, and where the
		// sway is, in radians.
		internal lines      float32[][]
		internal cursor     int
		internal phase      float
		internal channels   int
		internal sampleRate int

		// process adds the copies to `samples` in place.
		def process(samples float32[], info audio.AudioInfo) {
			let width = int(info.channels)
			return unless enabled && width > 0 && voices > 0
			prepare(int(info.sampleRate), width)
			let length = lines[0].len()
			let base = float(framesOf(CHORUS_BASE_DELAY, sampleRate))
			let swing = float(int64(depth)) / 1000000000.0 * float(sampleRate)
			let step = 2.0 * math.Pi * rate / float(sampleRate)
			let wetShare = mix.clamp(0.0, 1.0)
			for let at = 0; at + width <= samples.len(); at += width {
				for let c = 0; c < width; c++ {
					let line = lines[c]
					line[cursor] = samples[at + c]
					let sum = 0.0
					for let v = 0; v < voices; v++ {
						// Voices spread round the cycle; the right side runs a
						// quarter turn behind the left.
						let angle = phase + 2.0 * math.Pi * float(v) / float(voices) + float(c % 2) * math.Pi / 2.0
						let lag = base + swing * (1.0 + math.sin(angle)) / 2.0
						sum += readBack(line, lag, length)
					}
					let copies = sum / float(voices)
					samples[at + c] = float32(float(samples[at + c]) * (1.0 - wetShare) + copies * wetShare)
				}
				cursor = (cursor + 1) % length
				phase += step
				phase -= 2.0 * math.Pi when phase > 2.0 * math.Pi
			}
		}

		// reset forgets the delayed sound, as after a seek.
		def reset() {
			for let (_, line) in lines {
				line.fill(float32(0.0))
			}
			cursor = 0
			phase = 0.0
		}

		// The sample `lag` frames before the cursor in `line`, between frames
		// by straight-line interpolation.
		internal def readBack(line float32[], lag float, length int) float {
			let whole = int(lag)
			let part = lag - float(whole)
			let a = float(line[(cursor - whole + length * 2) % length])
			let b = float(line[(cursor - whole - 1 + length * 2) % length])
			return a + (b - a) * part
		}

		// Sizes the lines for the deepest sway at `rate`.
		internal def prepare(rate int, channels int) {
			let frames = framesOf(CHORUS_BASE_DELAY, rate) + framesOf(depth, rate) + 4
			return when rate == sampleRate && channels == self.channels && lines.len() > 0 && lines[0].len() >= frames
			sampleRate = rate
			self.channels = channels
			lines = float32[][]
			for let c = 0; c < channels; c++ {
				let line float32[]
				line.len(frames)
				lines.push(line)
			}
			cursor = 0
		}
	}
}
