partial module std.media.dsp {
	use (
		std.formats.audio
		std.media.dsp.core::*
		std.units::quantity
	)

	// The bands an `Equalizer` starts with.
	enum EqLayout {
		// No bands: add them to `bands` for a parametric equalizer.
		Parametric
		// 10 octave bands, 31 Hz to 16 kHz (the ISO centres).
		Graphic10
		// 31 third-octave bands, 20 Hz to 20 kHz.
		Graphic31
	}

	// Ready-made settings of the 10-band graphic equalizer.
	enum EqPreset {
		Flat
		Acoustic
		BassBoost
		BassReduce
		Classical
		Dance
		Electronic
		HipHop
		Jazz
		Loudness
		Pop
		Rock
		TrebleBoost
		TrebleReduce
		Vocal
	}

	// One band of an equalizer.
	struct EqBand {
		// Hz: the centre, or the corner of a shelf.
		frequency float
		// dB.
		gain      float
		// Width: an octave band is about 1.41, a third-octave band 4.32.
		q         float      = 1.41
		kind      FilterKind = FilterKind.Peak
	}

	// Equalizer raises or lowers bands of frequencies: a graphic equalizer at
	// fixed centres, or a parametric one where each band sets its own centre,
	// width and shape. Changes take effect on the next `process`.
	type Equalizer {
		bands   EqBand[]
		// dB applied before the bands, to leave room for boosts.
		preamp  float
		// Off passes the sound unchanged, keeping the settings.
		enabled bool     = true

		// One filter per band, kept in step with `bands`.
		internal filters Biquad[]

		def new(layout EqLayout = EqLayout.Parametric) {
			match layout {
				case EqLayout.Parametric:
					return
				case EqLayout.Graphic10:
					for let (_, f) in GRAPHIC10 {
						bands.push(EqBand{frequency: f, gain: 0.0, q: GRAPHIC10_Q})
					}
				case EqLayout.Graphic31:
					for let (_, f) in GRAPHIC31 {
						bands.push(EqBand{frequency: f, gain: 0.0, q: GRAPHIC31_Q})
					}
			}
		}

		// set changes the gain of band `index` to `gain` dB.
		def set(index int, gain float) {
			return when index < 0 || index >= bands.len()
			let band = bands[index]
			band.gain = gain
			bands[index] = band
		}

		// apply sets the equalizer to `preset`: the 10 graphic bands with the
		// preset's gains, and a preamp that keeps its loudest boost from
		// clipping.
		def apply(preset EqPreset) {
			let gains = presetGains(preset)
			bands = EqBand[]
			let loudest = 0.0
			for let (i, f) in GRAPHIC10 {
				bands.push(EqBand{frequency: f, gain: gains[i], q: GRAPHIC10_Q})
				loudest = gains[i] when gains[i] > loudest
			}
			preamp = -loudest
		}

		// flat sets every band's gain and the preamp to 0 dB.
		def flat() {
			for let i = 0; i < bands.len(); i++ {
				set(i, 0.0)
			}
			preamp = 0.0
		}

		// process equalizes `samples` (interleaved, `info.channels` wide) in
		// place.
		def process(samples float32[], info audio.AudioInfo) {
			return unless enabled
			sync()
			if preamp != 0.0 {
				let g = float32(quantity(preamp, dB))
				for let i = 0; i < samples.len(); i++ {
					samples[i] = samples[i] * g
				}
			}
			for let (i, filter) in filters {
				// A peak or shelf at 0 dB changes nothing.
				let kind = bands[i].kind
				let neutral = kind := FilterKind.Peak || FilterKind.LowShelf || FilterKind.HighShelf
				continue when neutral && bands[i].gain == 0.0
				filter.process(samples, info)
			}
		}

		// reset forgets the samples filtered so far, as after a seek.
		def reset() {
			for let (_, filter) in filters {
				filter.reset()
			}
		}

		// Brings the filters in line with `bands`, keeping each filter's
		// memory while only its settings change.
		internal def sync() {
			if filters.len() != bands.len() {
				filters = Biquad[]
				for let (_, band) in bands {
					filters.push(new Biquad(band.kind, band.frequency, band.q, band.gain))
				}
				return
			}
			for let (i, band) in bands {
				let filter = filters[i]
				filter.kind = band.kind
				filter.frequency = band.frequency
				filter.q = band.q
				filter.gain = band.gain
			}
		}

		// The equalizer's gain in dB at `hz`, preamp included, for drawing
		// its curve.
		def response(hz float, sampleRate int) float {
			let total = preamp
			for let (_, band) in bands {
				total += responseOf(design(band.kind, band.frequency, band.q, band.gain, sampleRate), hz, sampleRate)
			}
			return total
		}
	}
}
