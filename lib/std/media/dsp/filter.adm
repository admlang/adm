// Audio filters, equalizers, dynamics, effects and analysis. Every type that
// changes sound has `process(samples, info)`, which changes interleaved
// float32 samples in place: every one is an `AudioEffect`, so it goes in a
// `MediaPlayer.effects` list or runs on its own over any `AudioStream`. Each has `enabled`: a player skips an effect that is off,
// which stays in the list with its settings. Each keeps state per channel and follows the rate and channel
// count `info` gives, resetting itself when they change.
//
// Gains are in decibels: 0 is unchanged, -6 about half, +6 about double.
//
// ```adm
// let eq = new dsp.Equalizer(dsp.EqLayout.Graphic10)
// eq.set(0, 4.0)   // +4 dB at 31 Hz
// player.effects.push(eq)
// player.effects.push(new dsp.Limiter())
// ```

partial module std.media.dsp {
	use (
		std.formats.audio
		std.media.dsp.core::*
	)

	// AudioEffect changes samples on their way somewhere: an equalizer, a
	// limiter, a reverb. `std.media.player.MediaPlayer.effects` runs a list of
	// them and skips one whose `enabled` is false, so it can be switched off
	// and on again without taking it out of the list.
	type AudioEffect = EffectSwitch & AudioProcessor

	// EffectSwitch is the `enabled` field every effect has.
	datatype EffectSwitch {
		// Whether the effect runs; off, it keeps its settings.
		enabled bool
	}

	// AudioProcessor is the work an effect does.
	interface AudioProcessor {
		// process changes `samples` (interleaved, `info.channels` wide) in place.
		def process(samples float32[], info audio.AudioInfo)
	}

	// The response shape of a `Biquad`.
	enum FilterKind {
		// Passes below `frequency`, cuts above.
		LowPass
		// Passes above `frequency`, cuts below.
		HighPass
		// Passes a band around `frequency`, `q` wide.
		BandPass
		// Cuts a narrow band around `frequency`.
		Notch
		// Raises or lowers a band around `frequency` by `gain`.
		Peak
		// Raises or lowers everything below `frequency` by `gain`.
		LowShelf
		// Raises or lowers everything above `frequency` by `gain`.
		HighShelf
		// Passes everything, shifting the phase around `frequency`.
		AllPass
	}

	// Biquad is a second-order filter (the Audio EQ Cookbook designs), the
	// building block of the equalizer. Changing a field takes effect on the
	// next `process`, without a click.
	type Biquad {
		// Off, a player skips it; it keeps its settings.
		enabled bool = true

		kind      FilterKind
		// Hz: the cutoff, or the centre of a band.
		frequency float
		// How narrow the band or how sharp the corner: 0.7071 is the flattest
		// corner, higher is narrower.
		q         float      = 0.7071
		// dB, for `Peak` and the shelves.
		gain      float

		// The coefficients in use and what they were designed for.
		internal coefficients BiquadCoefficients
		internal designed     bool
		internal designKind   FilterKind
		internal designFreq   float
		internal designQ      float
		internal designGain   float
		internal rate         int
		// The filter's memory, two values per channel.
		internal z1           float[]
		internal z2           float[]

		def new(kind FilterKind, frequency float, q float = 0.7071, gain float = 0.0) {
			self.kind = kind
			self.frequency = frequency
			self.q = q
			self.gain = gain
		}

		// process filters `samples` (interleaved, `info.channels` wide) in place.
		def process(samples float32[], info audio.AudioInfo) {
			return unless enabled
			let channels = int(info.channels)
			return when channels <= 0
			prepare(int(info.sampleRate), channels)
			let c = coefficients
			let frames = samples.len() / channels
			for let ch = 0; ch < channels; ch++ {
				let s1 = z1[ch]
				let s2 = z2[ch]
				for let f = 0; f < frames; f++ {
					let at = f * channels + ch
					let x = float(samples[at])
					let y = c.b0 * x + s1
					s1 = c.b1 * x - c.a1 * y + s2
					s2 = c.b2 * x - c.a2 * y
					samples[at] = float32(y)
				}
				z1[ch] = s1
				z2[ch] = s2
			}
		}

		// reset forgets the samples filtered so far, as after a seek.
		def reset() {
			z1.fill(0.0)
			z2.fill(0.0)
		}

		// Sizes the memory for `channels` and designs the coefficients again
		// when a field or the rate changed.
		internal def prepare(rate int, channels int) {
			if z1.len() != channels {
				z1 = float[]
				z2 = float[]
				z1.len(channels)
				z2.len(channels)
			}
			let changed = !designed || rate != self.rate || kind != designKind || frequency != designFreq || q != designQ || gain != designGain
			return unless changed
			coefficients = design(kind, frequency, q, gain, rate)
			designed = true
			self.rate = rate
			designKind = kind
			designFreq = frequency
			designQ = q
			designGain = gain
		}

		// The filter's gain in dB at `hz`, for drawing its curve.
		def response(hz float, sampleRate int) float {
			return responseOf(design(kind, frequency, q, gain, sampleRate), hz, sampleRate)
		}
	}
}
