partial module std.media.dsp {
	use (
		std.math
		std.math.processing::(Fourier)
	)

	// How mel bands are placed and weighted.
	enum MelScale {
		// Linear below 1 kHz and logarithmic above, each band scaled to the
		// same area (librosa's default; Whisper).
		Slaney
		// 2595 · log10(1 + f / 700), each band peaking at 1 (HTK; Gemma 4).
		Htk
	}

	// How the frames of a `MelSpectrogram` sit on the sound.
	enum MelFraming {
		// Frame f is centred on sample f · hop, the sound mirrored at its
		// ends (librosa and torch.stft with center=True): length / hop + 1
		// frames.
		Centered
		// Frame f starts at sample f · hop: (length - window) / hop + 1
		// frames, none when the sound is shorter than a window.
		Start
	}

	// The energy of a sound in mel bands, frame by frame: each frame is
	// shaped by a periodic Hann window of `window` samples, zero padded to
	// `fftSize`, transformed, and its spectrum summed through triangular
	// filters. What speech models take as their input before the log they
	// each apply their own way.
	//
	// ```
	// let mel = new MelSpectrogram(16000, window = 400, hop = 160, mels = 80)
	// let energies = mel.compute(samples)   // frames × 80
	// ```
	type MelSpectrogram {
		sampleRate       int
		window           int
		fftSize          int
		hop              int
		mels             int
		scale            MelScale
		framing          MelFraming
		// 2 sums power (|X|²), 1 magnitude (|X|).
		power            float
		// Per band, its weights over the fftSize / 2 + 1 bins, and the first
		// and last bin it covers.
		internal filters float32[]
		internal first   int[]
		internal last    int[]
		internal shape   float[]
		internal plan    Fourier

		// A spectrogram of sound at `sampleRate`: frames of `window`
		// samples `hop` apart, transformed at `fftSize` points (`window`
		// when 0), `mels` bands from `low` to `high` Hz (half the sample
		// rate when 0).
		def new(sampleRate int, window int, hop int, mels int, fftSize int = 0, scale MelScale = MelScale.Slaney, framing MelFraming = MelFraming.Centered, power float = 2.0, low float = 0.0, high float = 0.0) {
			self.sampleRate = sampleRate
			self.window = window
			self.hop = hop
			self.mels = mels
			self.fftSize = fftSize.max(window)
			self.scale = scale
			self.framing = framing
			self.power = power
			shape.len(window)
			for let t = 0; t < window; t++ {
				shape[t] = 0.5 - 0.5 * math.cos(2.0 * math.Pi * float(t) / float(window))
			}
			plan = new Fourier(self.fftSize)
			buildFilters(low, high <= 0.0 ?? (float(sampleRate) / 2.0, high))
		}

		// The frequency bins of a frame: fftSize / 2 + 1.
		def bins() int {
			return fftSize / 2 + 1
		}

		// The band energies of `samples` (mono, at `sampleRate`): a row of
		// `mels` values per frame.
		def compute(samples float32[]) matrix<float32> {
			let n = samples.len()
			let frames = framing == MelFraming.Centered ?? (n / hop + 1, n < window ?? (0, (n - window) / hop + 1))
			frames = 0 when n == 0
			let out = matrix<float32>[].size(frames, mels)
			return out when frames == 0 || n == 0
			let tasks = (frames / 32).clamp(1, 32)
			forall let t in 0..tasks {
				melBand(samples, out, plan.copy(), frames * t / tasks, frames * (t + 1) / tasks)
			}
			return out
		}

		// Frames from..to into `out`, two at a time through one complex
		// transform: frame a as the real part, frame b as the imaginary.
		internal def melBand(samples float32[], out matrix<float32>, plan Fourier, from int, to int) {
			let n = fftSize
			let half = bins()
			let re float[]
			let im float[]
			re.len(n)
			im.len(n)
			let energyA float[]
			let energyB float[]
			energyA.len(half)
			energyB.len(half)
			let f = from
			for f < to {
				let pair = f + 1 < to
				frame(samples, f, re)
				if pair {
					frame(samples, f + 1, im)
				} else {
					im.fill(0.0)
				}
				plan.run(re, im)
				// X_a[k] = (Z[k] + conj Z[n-k]) / 2, X_b[k] = (Z[k] - conj Z[n-k]) / 2i.
				for let k = 0; k < half; k++ {
					let m = k == 0 ?? (0, n - k)
					let (zr, zi, wr, wi) = (re[k], im[k], re[m], im[m])
					let (ar, ai) = (0.5 * (zr + wr), 0.5 * (zi - wi))
					let (br, bi) = (0.5 * (zi + wi), 0.5 * (wr - zr))
					energyA[k] = energy(ar * ar + ai * ai)
					energyB[k] = energy(br * br + bi * bi)
				}
				bands(energyA, out.row(f))
				bands(energyB, out.row(f + 1)) when pair
				f += pair ?? (2, 1)
			}
		}

		// |X|² raised to power / 2.
		internal def energy(squared float) float {
			return squared when power == 2.0
			return math.sqrt(squared) when power == 1.0
			return squared ** (power / 2.0)
		}

		// Frame f windowed into `into` (fftSize values, zeros past the window).
		internal def frame(samples float32[], f int, into float[]) {
			let n = samples.len()
			let start = framing == MelFraming.Centered ?? (f * hop - window / 2, f * hop)
			for let t = 0; t < window; t++ {
				let i = start + t
				if framing == MelFraming.Centered && n > 1 && (i < 0 || i >= n) {
					// Mirrored at both ends, as often as a short sound needs:
					// the mirrored sound repeats every 2 · (n - 1) samples.
					let period = 2 * (n - 1)
					i = ((i % period) + period) % period
					i = i >= n ?? (period - i, i)
				}
				into[t] = i >= 0 && i < n ?? (float(samples[i]) * shape[t], 0.0)
			}
			for let t = window; t < fftSize; t++ {
				into[t] = 0.0
			}
		}

		// The bands of one frame's bin energies.
		internal def bands(energies float[], row float32[]) {
			let width = bins()
			for let m = 0; m < mels; m++ {
				let sum = 0.0
				for let k = first[m]; k <= last[m]; k++ {
					sum += float(filters[m * width + k]) * energies[k]
				}
				row[m] = float32(sum)
			}
		}

		internal def buildFilters(low float, high float) {
			let width = bins()
			let (from, to) = (toMel(low), toMel(high))
			let edges float[]
			for let i = 0; i < mels + 2; i++ {
				edges.push(fromMel(from + (to - from) * float(i) / float(mels + 1)))
			}
			filters.len(mels * width)
			first.len(mels)
			last.len(mels)
			for let m = 0; m < mels; m++ {
				let (left, centre, right) = (edges[m], edges[m + 1], edges[m + 2])
				let area = scale == MelScale.Slaney ?? (2.0 / (right - left), 1.0)
				first[m] = width
				last[m] = -1
				for let k = 0; k < width; k++ {
					let hz = float(k) * float(sampleRate) / float(fftSize)
					let rising = (hz - left) / (centre - left)
					let falling = (right - hz) / (right - centre)
					let w = rising.min(falling).max(0.0) * area
					filters[m * width + k] = float32(w)
					if w > 0.0 {
						first[m] = first[m].min(k)
						last[m] = k
					}
				}
			}
		}

		internal def toMel(hz float) float {
			return 2595.0 * math.log10(1.0 + hz / 700.0) when scale == MelScale.Htk
			return hz < 1000.0 ?? (3.0 * hz / 200.0, 15.0 + math.ln(hz / 1000.0) * 27.0 / math.ln(6.4))
		}

		internal def fromMel(mel float) float {
			return 700.0 * (10.0 ** (mel / 2595.0) - 1.0) when scale == MelScale.Htk
			return mel < 15.0 ?? (200.0 * mel / 3.0, 1000.0 * math.E ** ((mel - 15.0) * math.ln(6.4) / 27.0))
		}
	}
}
