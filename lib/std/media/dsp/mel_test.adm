partial module std.media.dsp {
	use (
		std.testing
		std.math
	)

	check "Mel spectrogram" {
		// 440 Hz at 0.5 and 3 kHz at 0.25, 4000 samples at 16 kHz.
		internal def tones() float32[] {
			let out float32[]
			for let i = 0; i < 4000; i++ {
				out.push(float32(0.5 * math.sin(2.0 * math.Pi * 440.0 * float(i) / 16000.0) + 0.25 * math.sin(2.0 * math.Pi * 3000.0 * float(i) / 16000.0)))
			}
			return out
		}

		// Within a millionth of `want`: float32 sums against numpy's float64.
		internal def near(have float, want float) bool {
			return (have - want).abs() <= 1e-5 * want.abs()
		}

		internal def total(m matrix<float32>) float {
			let sum = 0.0
			for let f = 0; f < m.rows; f++ {
				for let (_, v) in m.row(f) {
					sum += float(v)
				}
			}
			return sum
		}

		internal def rowSum(m matrix<float32>, f int) float {
			let sum = 0.0
			for let (_, v) in m.row(f) {
				sum += float(v)
			}
			return sum
		}

		// Reference values from numpy: librosa's filters and framing.
		@test()
		def slaney_power_centred_as_whisper() {
			let mel = new MelSpectrogram(16000, window = 400, hop = 160, mels = 80)
			let m = mel.compute(tones())
			assert m.rows == 26 && m.cols == 80
			assert near(total(m), 2830.372088190581)
			assert near(float(m.row(5)[11]), 56.599822749868146)
			assert near(rowSum(m, 0), 108.50955843435477)
			assert near(rowSum(m, 25), 109.73391633293738)
		}

		@test()
		def htk_magnitude_from_the_start_as_gemma() {
			let mel = new MelSpectrogram(16000, window = 320, hop = 160, mels = 128, fftSize = 512, scale = MelScale.Htk, framing = MelFraming.Start, power = 1.0)
			let m = mel.compute(tones())
			assert m.rows == 24 && m.cols == 128
			assert near(total(m), 4782.386663997124)
			assert near(float(m.row(10)[84]), 35.2177738070399)
			assert near(rowSum(m, 0), 199.27175701420725)
		}

		@test()
		def short_and_empty_sounds() {
			let mel = new MelSpectrogram(16000, window = 400, hop = 160, mels = 80)
			assert mel.compute(float32[]).rows == 0
			// Shorter than half a window: mirrored as often as needed.
			let m = mel.compute(float32[0.5, -0.25, 0.125])
			assert m.rows == 1
			let start = new MelSpectrogram(16000, window = 400, hop = 160, mels = 80, framing = MelFraming.Start)
			assert start.compute(float32[0.5, -0.25]).rows == 0
		}
	}
}
