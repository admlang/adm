partial module std.media.dsp {
	use (
		std.formats.audio
		std.media.dsp.core::*
		std.units::quantity
	)

	// Gain changes the level by `gain` dB.
	type Gain {
		// Off, a player skips it; it keeps its settings.
		enabled bool = true

		gain float

		def new(gain float = 0.0) {
			self.gain = gain
		}

		// process changes `samples` in place.
		def process(samples float32[], info audio.AudioInfo) {
			return unless enabled && gain != 0.0
			let g = float32(quantity(gain, dB))
			for let i = 0; i < samples.len(); i++ {
				samples[i] = samples[i] * g
			}
		}
	}

	// Balance moves stereo sound left or right: -1 left only, 0 centred, 1
	// right only. The side it moves towards stays as it is; the other is
	// turned down. Channels other than the first two pass unchanged.
	type Balance {
		// Off, a player skips it; it keeps its settings.
		enabled bool = true

		balance float

		// process changes `samples` in place.
		def process(samples float32[], info audio.AudioInfo) {
			let channels = int(info.channels)
			return unless enabled && balance != 0.0 && channels >= 2
			let b = balance.clamp(-1.0, 1.0)
			let left = float32(b > 0.0 ?? (1.0 - b, 1.0))
			let right = float32(b < 0.0 ?? (1.0 + b, 1.0))
			for let at = 0; at + 1 < samples.len(); at += channels {
				samples[at] = samples[at] * left
				samples[at + 1] = samples[at + 1] * right
			}
		}
	}

	// StereoWidth narrows or widens stereo sound: 0 is mono, 1 unchanged,
	// above 1 wider. Channels other than the first two pass unchanged.
	type StereoWidth {
		// Off, a player skips it; it keeps its settings.
		enabled bool = true

		width float = 1.0

		// process changes `samples` in place.
		def process(samples float32[], info audio.AudioInfo) {
			let channels = int(info.channels)
			return unless enabled && width != 1.0 && channels >= 2
			let w = float32(width < 0.0 ?? (0.0, width))
			for let at = 0; at + 1 < samples.len(); at += channels {
				// Mid and side: the side is what differs between the two.
				let mid = (samples[at] + samples[at + 1]) * float32(0.5)
				let side = (samples[at] - samples[at + 1]) * float32(0.5) * w
				samples[at] = mid + side
				samples[at + 1] = mid - side
			}
		}
	}
}
