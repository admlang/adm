internal partial module std.media.player.engine {
	use (
		std.io
		std.os
		std.bytes
		std.math
		std.time
		std.formats
		std.formats.audio
		std.formats.playlist
		std.devices
		std.gfx
		std.math.geom
		std.gfx.processing.transform
		std.formats.image
		std.formats.video
		std.media.synth
		std.media.player::*
	)

	// Frames the player mixes per pass, at the sink's rate: about 21 ms at
	// 48 kHz, the step at which controls take effect.
	const BLOCK_FRAMES = 1024
	// Frames read from a source per pull.
	const READ_FRAMES = 2048
	// How far into a track `previous` restarts it instead of going back.
	const RESTART_AFTER = 3s
	// Played tracks `previous` can go back through.
	const HISTORY_LIMIT = 1000

	// The title a track shows before its tags are read: the file name
	// without its extension, or the last part of a URL.
	def titleOf(location string) string {
		let name = os.base(location)
		// The extension comes without its dot.
		let ext = os.extension(name)
		return name when ext == "" || ext.len() + 1 >= name.len()
		return name[:name.len() - ext.len() - 1]
	}

	// `index` kept between 0 and `count`, for inserting.
	def clampIndex(index int, count int) int {
		return 0 when index < 0
		return count when index > count
		return index
	}

	// `list` with `track` at `index`.
	def insertTrack(list Track[], index int, track Track) Track[] {
		let at = clampIndex(index, list.len())
		return list[:at] + Track[track] + list[at:]
	}

	// Whether `data` starts like a Standard MIDI File.
	def isMidi(data byte[]) bool {
		return data.len() >= 4 && string(data[:4]) == "MThd"
	}

	// A stream of the MIDI file in `data`, rendered by a synthesizer with the
	// built-in waveforms.
	// Fails when the file does not parse.
	def openMidi(data byte[]) !audio.AudioStream {
		let midi = new audio.Midi()
		try midi.fromReader(new bytes.Reader(data))
		return new synth.Synth().stream(midi)
	}

	// A stream of the encoded file in `data`, audio or MIDI.
	// Fails when no codec recognises it, or opening does.
	def openBytes(data byte[]) !audio.AudioStream {
		return openMidi(data) when isMidi(data)
		let moving = openVideoBytes(data)
		return moving unless moving is none
		return audio.open(data)
	}

	// A stream of the file at `location`, audio or MIDI.
	// Fails when the file cannot be read, or no codec recognises it.
	def openLocation(location string) !audio.AudioStream {
		let file = try os.open(location)
		let head byte[]
		head.len(4)
		let n = io.readFull(file, head) onerror recover 0
		file.close() onerror recover none
		return openMidi(try os.readFile(location)) when n == 4 && isMidi(head)
		if isVideoFile(location) {
			let moving = try openVideoLocation(location)
			return moving unless moving is none
		}
		return audio.open(location)
	}

	// The media types of the playlist formats, which are `audio/` types too
	// but are not tracks.
	def playlistTypes() string[] {
		let types string[]
		for let (_, t) in new playlist.M3U().mimeType {
			types.push(t)
		}
		for let (_, t) in new playlist.PLS().mimeType {
			types.push(t)
		}
		return types
	}

	// Whether the file at `path` is a video container, going by its
	// extension.
	def isVideoFile(path string) bool {
		let found = formats.typeByExtension(os.extension(path))
		return false when found is none
		let full string = found
		return full.trim().lower().startsWith("video/")
	}

	// Whether `v` has a picture track.
	def hasPictures(v video.Video) bool {
		for let (_, t) in v.tracks() {
			return true when t.kind == video.TrackKind.Video
		}
		return false
	}

	// A stream of the video file at `location`: its sound, or silence of
	// its length when it has none; none when the file has no picture track
	// (an audio file in a video container), which then plays as audio.
	// Fails when the file cannot be opened or its sound cannot be decoded.
	def openVideoLocation(location string) !?audio.AudioStream {
		let v = try video.open(location)
		return try videoSound(v, def () !video.Video {
			return video.open(location)
		})
	}

	// As `openVideoLocation`, for the video file in `data`; none when it is
	// not a video.
	def openVideoBytes(data byte[]) ?audio.AudioStream {
		let v = video.open(data) onerror (err error) {
			return none
		}
		return videoSound(v, def () !video.Video {
			return video.open(data)
		}) onerror recover none
	}

	// The playing sound of `v`, none when it has no picture track (it is
	// closed then).
	// Fails when its sound cannot be decoded.
	def videoSound(v video.Video, reopen def() !video.Video) !?audio.AudioStream {
		if !hasPictures(v) {
			v.close() onerror recover none
			return none
		}
		let sound = v.audio() onerror (err error) {
			v.close() onerror recover none
			fail err
		}
		return new VideoTrack(v, sound, reopen)
	}

	// The sound of a video, and its pictures once they are wanted. Without
	// an audio track it plays silence for the video's length, so the video
	// keeps time by the sink like any track; with no known length the
	// silence lasts until the pictures end. The pictures come from a second
	// reading of the file (`PictureFeed`), so decoding them never waits on
	// the sound or holds it up. Closing it closes both.
	type VideoTrack {
		video   video.Video
		sound   ?audio.AudioStream
		details audio.AudioInfo
		// Opens the file again for the pictures.
		reopen  def() !video.Video
		// Silence played so far, when there is no sound.
		silent  uint64
		feed    ?PictureFeed = none
		// The pictures failed or ran out.
		ended   bool

		def new(v video.Video, sound ?audio.AudioStream, reopen def() !video.Video) {
			video = v
			self.sound = sound
			self.reopen = reopen
			let length = v.info().length
			if sound is none {
				details = audio.AudioInfo{sampleRate: uint32(SPEAKER_RATE), channels: uint16(SPEAKER_CHANNELS), bitDepth: uint16(32), format: audio.SampleFormat.Float32, codec: "pcm", length: length, frames: uint64(framesIn(length, SPEAKER_RATE)), seekable: v.info().seekable}
			} else {
				let s audio.AudioStream = sound
				details = s.info()
				details.length = length when details.length <= 0s
			}
		}

		def info() audio.AudioInfo {
			return details
		}

		// Fails when decoding the sound does.
		atomic def read(buf float32[]) !int {
			if !(sound is none) {
				let s audio.AudioStream = sound
				return s.read(buf)
			}
			let width = int(details.channels)
			let limit = details.length > 0s ?? (uint64(framesIn(details.length, SPEAKER_RATE)), uint64(0))
			let count = buf.len() / width
			if details.length > 0s {
				count = int((limit - silent.min(limit)).min(uint64(count)))
			} else if ended || (!(feed is none) && feed.over()) {
				count = 0
			}
			for let i = 0; i < count * width; i++ {
				buf[i] = float32(0.0)
			}
			silent += uint64(count)
			return count
		}

		// Fails when the video cannot seek.
		atomic def seek(frame uint64) !none {
			return moveTo(timeOf(int64(frame), int(details.sampleRate)))
		}

		// Moves the sound and the pictures together.
		// Fails when the video cannot seek.
		atomic def seek(time duration) !none {
			return moveTo(time)
		}

		// Fails when the video cannot seek.
		atomic def skip(offset duration) !none {
			return moveTo(timeOf(int64(framesRead()), int(details.sampleRate)) + offset)
		}

		atomic def position() uint64 {
			return framesRead()
		}

		// Closes the video and the pictures' reading of it.
		atomic def close() !none {
			feed.stop() unless feed is none
			feed = none
			return video.close()
		}

		// Starts decoding pictures from where the sound stands.
		// Fails when the file cannot be opened again or has no decoder for
		// its pictures.
		atomic def startPictures() !none {
			return none unless feed is none
			return openFeed()
		}

		// Stops decoding pictures until they are asked for again.
		atomic def stopPictures() {
			feed.stop() unless feed is none
			feed = none
		}

		// Stops showing pictures after a decoding failure.
		atomic def giveUp() {
			ended = true
			feed.stop() unless feed is none
			feed = none
		}

		// The last picture due at `at`, none when no new one is: late
		// pictures are dropped, a picture not due yet waits. Starts the
		// pictures on first use.
		// Fails when opening or decoding them does.
		def pictureAt(at duration) !?video.VideoFrame {
			let running = try runningFeed()
			return none when running is none
			let pictures PictureFeed = running
			let problem = pictures.failure()
			if !(problem is none) {
				let err error = problem
				fail err
			}
			return pictures.due(at)
		}

		// The picture feed, started when none runs; none once pictures ended.
		// Fails as `startPictures` does.
		atomic def runningFeed() !?PictureFeed {
			return none when ended
			try openFeed() when feed is none
			return feed
		}

		// Opens the file again and starts decoding its pictures from where
		// the sound stands.
		// Fails when the file cannot be opened or has no picture decoder.
		def openFeed() !none {
			let second = try reopen()
			// Pictures the GPU decodes stay there: `picture` users draw them
			// without copies, and `display` gets them through `video.draw`.
			let frames = second.frames(onGpu = true) onerror (err error) {
				second.close() onerror recover none
				fail err
			}
			let made = new PictureFeed(second, frames)
			let at = framesRead()
			made.seek(timeOf(int64(at), int(details.sampleRate))) when at > 0 && details.seekable
			made.start()
			feed = made
			return none
		}

		// The sound frames read so far.
		def framesRead() uint64 {
			return silent when sound is none
			let s audio.AudioStream = sound
			return s.position()
		}

		// Moves the sound and the pictures together.
		// Fails when the video cannot seek.
		def moveTo(time duration) !none {
			try video.seek(time)
			silent = uint64(framesIn(time, SPEAKER_RATE))
			ended = false
			feed.seek(time) unless feed is none
			return none
		}
	}

	// The pictures of a video, decoded ahead by a task of their own from
	// their own reading of the file: up to `PICTURES_AHEAD` wait for their
	// time. A picture that comes due while later ones are ready is dropped
	// unseen.
	type PictureFeed {
		source   video.Video
		frames   video.VideoStream
		queue    video.VideoFrame[]
		// Where the task moves before its next picture; negative for none.
		seekTo   duration = -1s
		stopped  bool
		ended    bool
		broken   ?error = none
		wake     channel<bool> = new channel<bool>(size = 1)

		def new(source video.Video, frames video.VideoStream) {
			self.source = source
			self.frames = frames
		}

		def start() {
			async decode()
		}

		// The decoding task: fills the queue, moves when told to, and closes
		// the file once stopped.
		internal async def decode() {
			for {
				let (job, target) = nextJob()
				if job == JOB_EXIT {
					break
				}
				if job == JOB_WAIT {
					<-wake
					continue
				}
				if job == JOB_SEEK {
					source.seek(target) onerror (err error) {
						failed(err)
						recover none
					}
					continue
				}
				let got = frames.next() onerror (err error) {
					failed(err)
					recover none
				}
				put(got)
			}
			source.close() onerror recover none
		}

		// What the task does next, and where to move for JOB_SEEK.
		internal atomic def nextJob() (int, duration) {
			return (JOB_EXIT, 0s) when stopped
			if seekTo >= 0s {
				let target = seekTo
				seekTo = -1s
				return (JOB_SEEK, target)
			}
			return (JOB_WAIT, 0s) when ended || queue.len() >= PICTURES_AHEAD
			return (JOB_DECODE, 0s)
		}

		internal atomic def put(got ?video.VideoFrame) {
			if got is none {
				ended = true
				return
			}
			// A move while it decoded: the picture is from before it.
			return when seekTo >= 0s
			let f video.VideoFrame = got
			queue.push(f)
		}

		internal atomic def failed(err error) {
			broken = err
			ended = true
		}

		// The last picture due at `at`, none when none is.
		atomic def due(at duration) ?video.VideoFrame {
			let shown ?video.VideoFrame = none
			let taken = 0
			for taken < queue.len() && queue[taken].time <= at {
				shown = queue[taken]
				taken++
			}
			if taken > 0 {
				queue = queue[taken:]
				wake <- true when wake.len() == 0
			}
			return shown
		}

		// Moves to `time`: queued pictures are dropped.
		atomic def seek(time duration) {
			queue = video.VideoFrame[]
			seekTo = time
			ended = false
			broken = none
			wake <- true when wake.len() == 0
		}

		// Ends the task; it closes the file.
		atomic def stop() {
			stopped = true
			wake <- true when wake.len() == 0
		}

		// Whether every picture was decoded and shown.
		atomic def over() bool {
			return ended && queue.len() == 0
		}

		atomic def failure() ?error {
			return broken
		}
	}

	// What a picture feed's task does next.
	const JOB_DECODE = 0
	const JOB_WAIT = 1
	const JOB_SEEK = 2
	const JOB_EXIT = 3

	// Pictures a feed decodes ahead of their time.
	const PICTURES_AHEAD = 3

	// A player's fit as the gfx fit `video.draw` takes.
	def fitMode(fit ScaleMode) transform.FitMode {
		return transform.FitMode.Cover when fit == ScaleMode.Cover
		return transform.FitMode.Stretch when fit == ScaleMode.Stretch
		return transform.FitMode.Contain
	}

	// The `audio/` or `video/` media type of the file at `path` without
	// parameters, going by its extension; none for any other file.
	def mediaTypeOf(path string) ?string {
		let found = formats.typeByExtension(os.extension(path))
		return none when found is none
		let full string = found
		let semi = full.indexOf(";")
		let essence = (semi < 0 ?? (full, full[:semi])).trim().lower()
		return essence when essence.startsWith("audio/") || essence.startsWith("video/")
		return none
	}

	// A caller's stream handed out by `Track.open`: closing it leaves the
	// caller's stream open, since the caller owns it.
	type BorrowedStream {
		source audio.AudioStream

		def new(source audio.AudioStream) {
			self.source = source
		}

		def info() audio.AudioInfo {
			return source.info()
		}

		// Fails as the caller's stream does.
		def read(buf float32[]) !int {
			return source.read(buf)
		}

		// Fails as the caller's stream does.
		def seek(frame uint64) !none {
			return source.seek(frame)
		}

		// Fails as the caller's stream does.
		def seek(time duration) !none {
			return source.seek(time)
		}

		// Fails as the caller's stream does.
		def skip(offset duration) !none {
			return source.skip(offset)
		}

		def position() uint64 {
			return source.position()
		}

		// Leaves the caller's stream open.
		def close() !none {
			return none
		}
	}

	// The default speaker as a sink, opened by `open` rather than when the
	// player is made. It asks for 48 kHz stereo, which the speaker keeps
	// whatever the device runs at.
	type SpeakerSink {
		speaker ?devices.Speaker = none

		// Opens the default speaker unless it is open.
		// Fails when there is no speaker, or it cannot be opened.
		def open() !none {
			return none unless speaker is none
			speaker = try devices.openSpeaker(sampleRate = SPEAKER_RATE, channels = SPEAKER_CHANNELS)
		}

		def sampleRate() int {
			return SPEAKER_RATE
		}

		def channels() int {
			return SPEAKER_CHANNELS
		}

		// Plays the samples.
		// Fails when the speaker is not open, or the device errors.
		def write(samples float32[]) !int {
			fail "player: the speaker is not open" when speaker is none
			return speaker.write(samples)
		}

		// Closes the speaker when it is open.
		def close() {
			speaker.close() unless speaker is none
			speaker = none
		}
	}

	// The layout the default speaker is opened with.
	const SPEAKER_RATE = 48000
	const SPEAKER_CHANNELS = 2

	// A small, repeatable random number generator (xorshift64*) for the
	// shuffle order.
	type ShuffleRandom {
		state uint64

		// Seeded with `seed`, or from the clock when it is 0.
		def new(seed uint64) {
			state = seed
			state = uint64(time.now().unixNs()) when state == uint64(0)
			state = uint64(0x9E3779B97F4A7C15) when state == uint64(0)
		}

		// A number from 0 up to `count`, not including it.
		def below(count int) int {
			state = state ^ (state >> uint64(12))
			state = state ^ (state << uint64(25))
			state = state ^ (state >> uint64(27))
			let value = state * uint64(0x2545F4914F6CDD1D)
			return int((value >> uint64(33)) % uint64(count))
		}
	}

	// The equal-power fade gain `at` of the way through a fade, 0 to 1.
	def fadeIn(at float) float {
		return 0.0 when at <= 0.0
		return 1.0 when at >= 1.0
		return math.sin(at * math.Pi / 2.0)
	}

	// Frames at `rate` in `length`.
	def framesIn(length duration, rate int) int {
		return 0 when length <= 0s
		return int(int64(length) / 1000 * int64(rate) / 1000000)
	}

	// The time `frames` at `rate` last.
	def timeOf(frames int64, rate int) duration {
		return 0s when rate <= 0
		return duration(frames * 1000000000 / int64(rate))
	}

	// One track being played: its stream converted to the sink's rate and
	// channels, how far it has played, and its fade.
	type Deck {
		track      Track
		stream     audio.AudioStream
		info       audio.AudioInfo
		converter  audio.Converter
		// The sink's layout.
		rate       int
		channels   int
		// Converted samples not yet mixed, from `pendingAt`.
		pending    float32[]
		pendingAt  int
		// The stream is read to its end and the converter flushed.
		drained    bool
		// Where the stream started (a seek) and the frames mixed since, at the
		// sink's rate.
		start      duration
		mixed      int64
		// The fade: gain from `fadeFrom` to `fadeTo` over `fadeFrames`, of
		// which `fadeAt` are done. No fade when `fadeFrames` is 0.
		fadeFrom   float             = 1.0
		fadeTo     float             = 1.0
		fadeFrames int
		fadeAt     int
		// Reused read buffer.
		scratch    float32[]
		// The ReplayGain level, set by the player before each block.
		level      float32           = 1.0

		def new(track Track, stream audio.AudioStream, rate int, channels int) {
			self.track = track
			self.stream = stream
			self.rate = rate
			self.channels = channels
			info = stream.info()
			converter = new audio.Converter(int(info.sampleRate), int(info.channels), rate, channels)
			scratch.len(READ_FRAMES * int(info.channels).max(1))
		}

		// How far into the track the next mixed frame is.
		def position() duration {
			return start + timeOf(mixed, rate)
		}

		// The track's length, 0s when unknown.
		def length() duration {
			return info.length when info.length > 0s
			return track.length
		}

		// Whether every frame has been mixed.
		def finished() bool {
			return drained && pendingAt >= pending.len()
		}

		// Whether the fade has faded it out.
		def silent() bool {
			return fadeFrames > 0 && fadeAt >= fadeFrames && fadeTo <= 0.0
		}

		// Starts a fade from the current gain to `to` over `frames`.
		def fade(to float, frames int) {
			fadeFrom = gain()
			fadeTo = to
			fadeFrames = frames.max(1)
			fadeAt = 0
		}

		// Starts silent and fades up to full over `frames`.
		def fadeUp(frames int) {
			fadeFrom = 0.0
			fadeTo = 1.0
			fadeFrames = frames.max(1)
			fadeAt = 0
		}

		// The gain of the next frame.
		def gain() float {
			return fadeTo when fadeFrames == 0 || fadeAt >= fadeFrames
			let at = float(fadeAt) / float(fadeFrames)
			// Equal power: a rise follows the sine, a fall the cosine.
			return fadeFrom + (fadeTo - fadeFrom) * fadeIn(at) when fadeTo >= fadeFrom
			return fadeTo + (fadeFrom - fadeTo) * fadeIn(1.0 - at)
		}

		// Moves to `time` in the track and forgets what was converted.
		// Fails when the stream cannot seek.
		def seek(time duration) !none {
			try stream.seek(time)
			converter.reset()
			pending = float32[]
			pendingAt = 0
			drained = false
			start = time
			mixed = 0
		}

		// Reads and converts until at least `frames` frames are pending, or the
		// stream ends.
		// Fails when reading does.
		def fill(frames int) !none {
			let width = int(info.channels)
			for !drained && pending.len() - pendingAt < frames * channels {
				if width <= 0 {
					drained = true
					break
				}
				let got = try stream.read(scratch)
				let converted = got == 0 ?? (converter.flush(), converter.convert(scratch[:got * width]))
				drained = true when got == 0
				if pendingAt > 0 {
					pending = pending[pendingAt:]
					pendingAt = 0
				}
				pending = pending + converted
			}
		}

		// Adds up to `frames` frames, faded, into `out` from frame `at`, and
		// returns how many it added: fewer once the track has ended.
		// Fails when reading does.
		def mixInto(out float32[], at int, frames int) !int {
			try fill(frames)
			let count = ((pending.len() - pendingAt) / channels).min(frames)
			for let f = 0; f < count; f++ {
				let g = float32(gain()) * level
				let from = pendingAt + f * channels
				let to = (at + f) * channels
				for let c = 0; c < channels; c++ {
					out[to + c] += pending[from + c] * g
				}
				fadeAt++ when fadeFrames > 0 && fadeAt < fadeFrames
			}
			pendingAt += count * channels
			mixed += int64(count)
			return count
		}

		// Closes the stream.
		def close() {
			stream.close() onerror recover none
		}
	}

	// Whether `a` and `b` are the same track, or both none.
	def sameTrack(a ?Track, b ?Track) bool {
		return b is none when a is none
		return false when b is none
		let x Track = a
		let y Track = b
		return x == y
	}

	// The amplitude factor ReplayGain gives a track with `tags`: its album
	// gain when `album` and it has one, else its track gain, else its album
	// gain, plus `preamp` dB; lowered so the matching peak stays at full
	// scale. 1 when the tags carry no gain or are not read yet, or `mode`
	// is off.
	def replayLevel(tags ?audio.AudioTags, mode ReplayGainMode, album bool, preamp float) float {
		return 1.0 when tags is none || mode == ReplayGainMode.Off
		let found audio.AudioTags = tags
		let useAlbum = album && !(found.albumGain is none)
		let gain = useAlbum ?? (found.albumGain, found.trackGain)
		let peak = useAlbum ?? (found.albumPeak, found.trackPeak)
		if gain is none {
			gain = found.albumGain
			peak = found.albumPeak
		}
		return 1.0 when gain is none
		let db float = gain
		let level = 10.0 ** ((db + preamp) / 20.0)
		if !(peak is none) {
			let top float = peak
			level = level.min(1.0 / top) when top > 0.0
		}
		return level
	}

	// A track's title and artist as one line, "" without a track.
	def titleLine(track ?Track) string {
		return "" when track is none
		return "{track.artist} - {track.title}"
	}

	// Calls `callback` when it is set.
	def notify(callback ?def()) {
		return when callback is none
		let call def() = callback
		call()
	}

	// Calls `callback` with `value` when it is set.
	def notify(callback ?def(int), value int) {
		return when callback is none
		let call def(int) = callback
		call(value)
	}

	// Calls `callback` with `state` when it is set.
	def notify(callback ?def(PlayerState), state PlayerState) {
		return when callback is none
		let call def(PlayerState) = callback
		call(state)
	}

	// Calls `callback` with the track index and error when it is set.
	def notify(callback ?def(int, error), index int, err error) {
		return when callback is none
		let call def(int, error) = callback
		call(index, err)
	}

	// The tags of `track`, none when there is no track or its tags are not
	// read yet.
	def tagsOf(track ?Track) ?audio.AudioTags {
		return none when track is none
		return track.tags
	}

	// Where a picture of `iw` x `ih` goes in a display of `w` x `h` under
	// `fit`: its left, top, width and height; left and top are negative when
	// `Cover` crops it.
	def fitRect(iw int, ih int, w int, h int, fit ScaleMode) (int, int, int, int) {
		return (0, 0, w, h) when fit == ScaleMode.Stretch || iw <= 0 || ih <= 0
		let sx = float(w) / float(iw)
		let sy = float(h) / float(ih)
		let s = fit == ScaleMode.Contain ?? (sx.min(sy), sx.max(sy))
		let dw = int(float(iw) * s + 0.5).max(1)
		let dh = int(float(ih) * s + 0.5).max(1)
		return ((w - dw) / 2, (h - dh) / 2, dw, dh)
	}

	// Paints `r` opaque black.
	def clearRaster(r gfx.Raster) {
		let data = r.raw()
		let w = int(r.size().width)
		let h = int(r.size().height)
		let stride = r.stride()
		for let y = 0; y < h; y++ {
			let row = y * stride
			for let x = 0; x < w; x++ {
				let at = row + x * 4
				data[at] = 0
				data[at + 1] = 0
				data[at + 2] = 0
				data[at + 3] = 255
			}
		}
	}

	// Copies `src` into `dst` with its top left corner at `left`, `top`,
	// leaving out what falls outside `dst`.
	def blit(src gfx.Raster, dst gfx.Raster, left int, top int) {
		let from = src.raw()
		let to = dst.raw()
		let sw = int(src.size().width)
		let sh = int(src.size().height)
		let dw = int(dst.size().width)
		let dh = int(dst.size().height)
		let x0 = left.max(0)
		let x1 = (left + sw).min(dw)
		return when x1 <= x0
		for let y = top.max(0); y < (top + sh).min(dh); y++ {
			let srcRow = (y - top) * src.stride() + (x0 - left) * 4
			let dstRow = y * dst.stride() + x0 * 4
			for let i = 0; i < (x1 - x0) * 4; i++ {
				to[dstRow + i] = from[srcRow + i]
			}
		}
	}

	// The cover picture of `tags` decoded and scaled into `canvas` by `fit`;
	// false when there is none or it does not decode.
	def drawCover(tags ?audio.AudioTags, canvas gfx.Raster, fit ScaleMode) bool {
		return false when tags is none || tags.cover.len() == 0
		let picture = image.load(tags.cover) onerror (err error) {
			return false
		}
		let w = int(canvas.size().width)
		let h = int(canvas.size().height)
		let (left, top, dw, dh) = fitRect(int(picture.size().width), int(picture.size().height), w, h, fit)
		transform.resize(picture, new geom.Size<uint>(uint(dw), uint(dh)))
		blit(picture, canvas, left, top)
		return true
	}
}
