partial module std.media.player {
	use (
		std.gfx
		std.formats.audio
	)

	// What a player is doing.
	enum PlayerState {
		Stopped
		Playing
		Paused
	}

	// What happens when a track ends.
	enum RepeatMode {
		// Play the next track; stop after the last.
		NoRepeat
		// Play the same track again.
		RepeatSong
		// Play the next track; after the last, start over.
		RepeatPlaylist
	}

	// How ReplayGain tags level the loudness of tracks: files measured by a
	// ReplayGain scanner (or Opus R128 gains) carry the gain that brings
	// them to the same perceived loudness. Tracks without the tags play as
	// recorded.
	enum ReplayGainMode {
		// Every track as recorded.
		Off
		// Every track at the same loudness.
		Track
		// Every album at the same loudness, each track as loud as it is on its
		// album, so quiet songs stay quiet. A track without an album gain
		// takes its track gain.
		Album
		// Album gain while playing in playlist order, where the album is heard
		// as a whole; track gain while shuffled, where neighbours come from
		// different albums.
		Auto
	}

	// How a frame fits a display of another size.
	enum ScaleMode {
		// The whole frame, centred, with bars on the sides that do not fit.
		Contain
		// The display filled, the frame cropped to it.
		Cover
		// The display filled, the frame stretched to it.
		Stretch
	}

	// AudioSink is where a player sends what it plays. `devices.Speaker` is
	// one; a test passes a sink that keeps the samples.
	interface AudioSink {
		// The frame rate and channel count `write` expects.
		def sampleRate() int
		def channels() int

		// write plays interleaved samples and returns how many it took.
		def write(samples float32[]) !int
	}

	// Visualizer draws what an audio track sounds like into the player's
	// display: a spectrum, a level meter.
	interface Visualizer {
		// draw paints the frame for `samples` (interleaved, `info.channels`
		// wide, the ones about to play) into `display`.
		def draw(samples float32[], info audio.AudioInfo, display gfx.Raster)
	}
}
