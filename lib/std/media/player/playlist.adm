partial module std.media.player {
	use (
		std.os
		std.bytes
		std.formats
		std.formats.audio
		std.formats.playlist
		std.media.player.engine::*
		std.media.player.radio::*
	)

	// One playable item, audio or video, and what is known about it. The source opens when the
	// track plays, not when it is added.
	type Track {
		// The path or URL it plays from; "" for bytes and streams.
		location string
		title    string
		artist   string
		album    string
		// 0s until known: a radio stream never has one.
		length   duration
		// What the file's tags say, none until they are read: a playlist reads
		// them in the background as tracks are added.
		tags     ?audio.AudioTags = none

		// The encoded file, for a track added as bytes.
		internal data   byte[]
		// The caller's stream, for a track added as one.
		internal stream ?audio.AudioStream = none
		// Whether a stream that cannot seek has played already.
		internal spent  bool

		internal def new(location string) {
			self.location = location
			title = titleOf(location)
		}

		internal def new(data byte[], title string) {
			self.data = data
			self.title = title
		}

		internal def new(stream audio.AudioStream, title string) {
			self.stream = stream
			self.title = title
			length = stream.info().length
		}

		// open returns the track's sound, decoding as it is read: the file or
		// the bytes through the codec that recognises them (a MIDI file through
		// `std.media.synth`), an `http://`/`https://` URL as a stream, or the
		// stream the track was added with, from its start. Closing the stream
		// of a track added as a stream leaves the caller's stream open. Fills
		// `length` when it was not known.
		//
		// A URL connects and decodes on a task of its own and plays silence
		// until a second of sound is buffered, so opening it never waits on
		// the network; it cannot seek. A station that drops the connection is
		// dialled again. A URL serving a playlist file (`.pls`, `.m3u`) plays
		// its first entry that answers. The station's name becomes `title`
		// and `album`; each song title it announces becomes `title` (and
		// `artist`, from `Artist - Title`) as that song starts playing.
		// Fails when the source cannot be opened or decoded, or it is a stream
		// that cannot seek and has played already. A URL that cannot be
		// reached, or keeps dropping, fails the first read instead.
		def open() !audio.AudioStream {
			let opened = try openSource()
			let known = opened.info().length
			length = known when length == 0s && known > 0s
			return opened
		}

		// readTags reads the file's tags into `tags`, takes the title, artist
		// and album from them where they have one, and fills `length` when it
		// is not known. A stream or an internet source has none to read.
		// Fails when the file cannot be read or no codec recognises it (a
		// MIDI file has no tags).
		def readTags() !none {
			return none unless stream is none
			return none when location.contains("://")
			let found audio.AudioTags
			let info audio.AudioInfo
			if location == "" {
				found = try audio.tags(data)
				info = audio.info(new bytes.Reader(data)) onerror recover audio.AudioInfo{}
			} else {
				found = try audio.tags(location)
				info = audio.info(location) onerror recover audio.AudioInfo{}
			}
			tags = found
			title = found.title when found.title != ""
			artist = found.artist when found.artist != ""
			album = found.album when found.album != ""
			length = info.length when length == 0s && info.length > 0s
		}

		// The source's stream, before `length` is filled.
		// Fails as `open` does.
		internal def openSource() !audio.AudioStream {
			if stream is none {
				return openBytes(data) when location == ""
				return openLocation(location) unless isStreamURL(location)
				let radio = new RadioStream(self)
				radio.start()
				return radio
			}
			let source audio.AudioStream = stream
			if source.info().seekable {
				try source.seek(uint64(0)) when source.position() > 0
				return new BorrowedStream(source)
			}
			fail "player: the stream of \"{title}\" cannot seek and has played already" when spent
			spent = true
			return new BorrowedStream(source)
		}
	}

	// An ordered list of tracks, in the order they were added or arranged.
	// Shuffle, repeat and the play-next queue belong to the player, so
	// the list keeps its order while a player jumps around it.
	type Playlist {
		tracks Track[]

		// Tracks whose tags are still to be read, and whether the task reading
		// them runs.
		internal unread  Track[]
		internal reading bool

		// push adds a file path or an `http://`/`https://` URL (a file or an
		// internet radio stream) at the end. A MIDI file plays through
		// `std.media.synth`.
		def push(location string) {
			tracks.push(added(new Track(location)))
		}

		// push adds an encoded file held in memory, audio or MIDI.
		def push(data byte[], title string = "") {
			tracks.push(added(new Track(data, title)))
		}

		// push adds a stream. A stream that cannot seek plays once.
		def push(stream audio.AudioStream, title string = "") {
			tracks.push(new Track(stream, title))
		}

		// insert adds a path or URL at `index`, as `push` does at the end.
		def insert(index int, location string) {
			tracks = insertTrack(tracks, index, added(new Track(location)))
		}

		// insert adds an encoded file held in memory at `index`.
		def insert(index int, data byte[], title string = "") {
			tracks = insertTrack(tracks, index, added(new Track(data, title)))
		}

		// insert adds a stream at `index`.
		def insert(index int, stream audio.AudioStream, title string = "") {
			tracks = insertTrack(tracks, index, new Track(stream, title))
		}

		// remove takes out the track at `index`. A player playing it plays it
		// to its end.
		def remove(index int) {
			return when index < 0 || index >= tracks.len()
			tracks.remove(index)
		}

		// move puts the track at `from` at `to`, shifting the ones between.
		def move(from, to int) {
			return when from < 0 || from >= tracks.len() || from == to
			let track = tracks[from]
			tracks.remove(from)
			tracks = insertTrack(tracks, to, track)
		}

		// Queues `track` for the background tag reader, starting it when it
		// is idle, and returns the track.
		internal atomic def added(track Track) Track {
			unread.push(track)
			if !reading {
				reading = true
				let task = async readUnread()
				task.keepAlive()
			}
			return track
		}

		// The next track whose tags are to be read; none, and the reader
		// marked idle, when there is none.
		internal atomic def nextUnread() ?Track {
			if unread.len() == 0 {
				reading = false
				return none
			}
			return unread.shift()
		}

		// The background tag reader: reads each queued track's tags until the
		// queue is empty. A track whose tags cannot be read keeps its file name.
		internal def readUnread() {
			for {
				let track = nextUnread()
				break when track is none
				track.readTags() onerror recover none
			}
		}

		// clear takes out every track. A player playing one plays it to its end.
		def clear() {
			tracks = Track[]
		}

		// The number of tracks.
		def len() int {
			return tracks.len()
		}

		// addFolder adds every audio and video file under `path`, in name
		// order, and returns how many it added. Other files are skipped. In
		// each folder its files come first, then its subfolders, each in name
		// order; symbolic links are not followed.
		// Fails when `path` cannot be read.
		def addFolder(path string, recursive bool = true) !int {
			let skip = playlistTypes()
			return addFiles(path, recursive, skip)
		}

		// The media files of one folder, then of its subfolders.
		// Fails when the folder cannot be read.
		internal def addFiles(folder string, recursive bool, skip string[]) !int {
			let entries = try os.readDir(folder)
			entries.sort((a, b os.DirEntry) => a.info.name < b.info.name)
			let added = 0
			let folders string[]
			for let (_, entry) in entries {
				continue when int(entry.info.mode) & int(os.FileMode.Symlink) != 0
				if entry.info.isDir {
					folders.push(entry.path)
					continue
				}
				continue unless isMedia(entry.path, skip)
				tracks.push(added(new Track(entry.path)))
				added++
			}
			if recursive {
				for let (_, sub) in folders {
					added += try addFiles(sub, true, skip)
				}
			}
			return added
		}

		// load appends the tracks of a playlist file (any `std.formats.playlist`
		// format).
		// Fails when the file is not a playlist format, or cannot be read.
		def load(path string) !none {
			for let (_, entry) in try playlist.load(path) {
				let track = new Track(entry.location)
				track.title = entry.title when entry.title != ""
				track.artist = entry.artist
				track.album = entry.album
				track.length = entry.length
				tracks.push(added(track))
			}
		}

		// save writes the tracks with a location to a playlist file, in the
		// format its extension names.
		// Fails when the file cannot be written.
		def save(path string) !none {
			let entries playlist.PlaylistEntry[]
			for let (_, track) in tracks {
				continue when track.location == ""
				entries.push(playlist.PlaylistEntry{location: track.location, title: track.title, artist: track.artist, album: track.album, length: track.length})
			}
			return playlist.save(entries, path)
		}
	}
}
