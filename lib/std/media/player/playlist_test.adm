partial module std.media.player {
	use (
		std.testing
		std.os
		std.bytes
		std.time
		std.formats.audio
	)

	check "Playlist" {
		// The locations of the tracks, in order.
		internal def locations(list Playlist) string[] {
			let out string[]
			for let (_, t) in list.tracks {
				out.push(t.location)
			}
			return out
		}

		// A folder under the test's app home.
		internal def scratch(name string) !string {
			let dir = os.join(try os.appHome(), name)
			try os.mkdir(dir) unless try os.exists(dir)
			return dir
		}

		@test()
		def TestEditing() {
			let list = new Playlist()
			list.push("/music/b.mp3")
			list.push("/music/d.flac")
			list.insert(0, "/music/a.ogg")
			list.insert(2, "/music/c.wav")
			list.insert(99, "/music/e.opus")
			assert locations(list).equals(string["/music/a.ogg", "/music/b.mp3", "/music/c.wav", "/music/d.flac", "/music/e.opus"])
			assert list.tracks[0].title == "a" && list.tracks[4].title == "e"
			list.move(0, 4)
			assert locations(list).equals(string["/music/b.mp3", "/music/c.wav", "/music/d.flac", "/music/e.opus", "/music/a.ogg"])
			list.move(3, 0)
			list.remove(1)
			list.remove(42)
			assert locations(list).equals(string["/music/e.opus", "/music/c.wav", "/music/d.flac", "/music/a.ogg"])
			list.push(byte[1, 2, 3], "bytes")
			assert list.len() == 5 && list.tracks[4].location == "" && list.tracks[4].title == "bytes"
			list.clear()
			assert list.len() == 0
		}

		// Files first, then subfolders, each in name order; other files are
		// left out, playlists too.
		@test()
		def TestAddFolder() !none {
			let dir = try scratch("player-folder")
			let sub = os.join(dir, "sub")
			try os.mkdir(sub) unless try os.exists(sub)
			for let (_, name) in string["b.mp3", "a.wav", "notes.txt", "list.m3u"] {
				try os.writeFile(os.join(dir, name), byte[0])
			}
			try os.writeFile(os.join(sub, "c.ogg"), byte[0])
			let list = new Playlist()
			assert (try list.addFolder(dir)) == 3
			assert locations(list).equals(string[os.join(dir, "a.wav"), os.join(dir, "b.mp3"), os.join(sub, "c.ogg")])
			let flat = new Playlist()
			assert (try flat.addFolder(dir, recursive = false)) == 2
		}

		// Only the kinds or extensions asked for; extensions in any case,
		// with or without the dot, and only files the player can play.
		@test()
		def TestAddFolderFiltered() !none {
			let dir = try scratch("player-filter")
			for let (_, name) in string["a.mp3", "b.MP4", "c.wav", "d.avi", "e.txt", "f.m3u"] {
				try os.writeFile(os.join(dir, name), byte[0])
			}
			let sound = new Playlist()
			assert (try sound.addFolder(dir, MediaKind.Audio)) == 2
			assert locations(sound).equals(string[os.join(dir, "a.mp3"), os.join(dir, "c.wav")])
			let moving = new Playlist()
			assert (try moving.addFolder(dir, MediaKind.Video)) == 2
			assert locations(moving).equals(string[os.join(dir, "b.MP4"), os.join(dir, "d.avi")])
			let picked = new Playlist()
			assert (try picked.addFolder(dir, string["mp4", ".AVI", "txt"])) == 2
			assert locations(picked).equals(string[os.join(dir, "b.MP4"), os.join(dir, "d.avi")])
		}

		// Tracks with a location go to a playlist file and come back with their
		// details.
		@test()
		def TestSaveLoad() !none {
			let dir = try scratch("player-lists")
			let list = new Playlist()
			list.push(os.join(dir, "one.mp3"))
			list.push(byte[1], "in memory")
			list.push("/elsewhere/two.flac")
			list.tracks[0].artist = "Band"
			list.tracks[0].title = "First"
			let path = os.join(dir, "mix.m3u")
			try list.save(path)
			let back = new Playlist()
			try back.load(path)
			assert locations(back).equals(string[os.join(dir, "one.mp3"), "/elsewhere/two.flac"])
			assert back.tracks[0].artist == "Band" && back.tracks[0].title == "First"
			assert back.tracks[1].title == "two"
		}

		// A MIDI file added as bytes plays through the synthesizer.
		@test()
		def TestMidiTrack() !none {
			let midi = new bytes.Buffer()
			try midi.writeString("MThd")
			try midi.write(byte[0, 0, 0, 6, 0, 0, 0, 1, 0, 96])
			try midi.writeString("MTrk")
			let events = byte[0x00, 0x90, 0x3C, 0x64, 0x60, 0x80, 0x3C, 0x40, 0x00, 0xFF, 0x2F, 0x00]
			try midi.write(byte[0, 0, 0, byte(events.len())])
			try midi.write(events)
			let list = new Playlist()
			list.push(midi.bytes(), "tune")
			let stream = try list.tracks[0].open()
			assert int(stream.info().channels) == 2
			let buf float32[]
			buf.len(4096)
			let loud = false
			for {
				let frames = try stream.read(buf)
				break when frames == 0
				for let i = 0; i < frames * 2; i++ {
					loud = true when buf[i] != 0.0
				}
			}
			assert loud
			try stream.close()
		}

		// Tags are read in the background after adding: titles, artists and
		// lengths fill in; a file without readable tags keeps its name.
		@test()
		def TestBackgroundTags() !none {
			let list = new Playlist()
			assert (try list.addFolder("samples/audio/tags")) == 5
			list.push(byte[1, 2, 3, 4, 5, 6, 7, 8], "junk")
			let done = false
			for let i = 0; i < 500 && !done; i++ {
				done = true
				for let (_, t) in list.tracks[:5] {
					done = false when t.tags is none
				}
				time.sleep(10ms) unless done
			}
			assert done
			for let (_, t) in list.tracks[:5] {
				assert t.title == "Tag Title" && t.artist == "Tag Artist" && t.album == "Tag Album"
				assert t.length > 150ms && t.length < 300ms
			}
			let flac = list.tracks[0]
			assert flac.location.endsWith("tagged.flac")
			let maybe = flac.tags
			fail "the FLAC track has no tags" when maybe is none
			let read audio.AudioTags = maybe
			assert read.cover.len() > 0 && read.genre == "Ambient"
			time.sleep(20ms)
			assert list.tracks[5].title == "junk" && list.tracks[5].tags is none
		}

		// A URL opens at once, as a stream that cannot seek, and is titled
		// by the last part of its path until the station names itself.
		@test()
		def TestUrlOpensAsStream() !none {
			let list = new Playlist()
			list.push("http://127.0.0.1:9/live")
			assert list.tracks[0].title == "live"
			let stream = try list.tracks[0].open()
			assert !stream.info().seekable
			try stream.close()
		}
	}
}
