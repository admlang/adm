partial module std.media.player {
	use (
		std.io
		std.math
		std.time
		std.bytes
		std.testing
		std.net.http
		std.net.http.httptest
		std.formats.audio
		std.media.player.engine::*
		std.media.player.radio::*
	)

	check "Radio" {
		// A mono sink at 8 kHz that keeps what it is sent and takes a
		// millisecond per write, so silence while a stream buffers does not
		// pile up.
		internal type PacedSink {
			samples float32[]

			def sampleRate() int {
				return 8000
			}

			def channels() int {
				return 1
			}

			// Keeps the samples. It cannot fail.
			def write(samples float32[]) !int {
				time.sleep(1ms)
				for let (_, s) in samples {
					self.samples.push(s)
				}
				return samples.len()
			}

			// Whether any sample is audible.
			def heard() bool {
				for let (_, s) in samples {
					return true when s > 0.05 || s < -0.05
				}
				return false
			}
		}

		// `seconds` of a 440 Hz stereo tone as an MP3 file.
		// Fails when encoding does.
		def mp3Tone(seconds int) !byte[] {
			let frames = 48000 * seconds
			let pcm = new audio.PCM()
			pcm.info = audio.AudioInfo{sampleRate: 48000, channels: 2, bitDepth: 32, format: audio.SampleFormat.Float32, frames: uint64(frames)}
			pcm.samples.len(frames * 2)
			for let i = 0; i < frames; i++ {
				let v = float32(0.5 * math.sin(2.0 * math.Pi * 440.0 * float(i) / 48000.0))
				pcm.samples[i * 2] = v
				pcm.samples[i * 2 + 1] = v
			}
			let out = new bytes.Buffer()
			try new audio.MP3().encode(pcm.stream(), out)
			return out.bytes()
		}

		// `data` as an ICY server sends it: after every `interval` bytes a
		// metadata block, carrying the next of `titles` while there are any.
		def icyFramed(data byte[], interval int, titles string[]) byte[] {
			let out byte[]
			let block = 0
			for let at = 0; at < data.len(); at += interval {
				out = out + data[at:(at + interval).min(data.len())]
				break when at + interval > data.len()
				if block < titles.len() {
					let text = "StreamTitle='{titles[block]}';".bytes()
					let units = (text.len() + 15) / 16
					out.push(byte(units))
					out = out + text
					for let i = text.len(); i < units * 16; i++ {
						out.push(byte(0))
					}
				} else {
					out.push(byte(0))
				}
				block++
			}
			return out
		}

		// A server with a station at `/radio`, the same sound as a file at
		// `/song.mp3`, a playlist linking to the station at `/station.pls`,
		// and nothing at `/gone`.
		// Fails when the server cannot start.
		def station(tone byte[]) !httptest.Server {
			let mux = new http.ServeMux()
			let ts = new httptest.Server(mux)
			try mux.get("/radio", def (ctx http.Context) !none {
				ctx.setHeader("icy-name", "Test FM")
				ctx.setHeader("icy-metaint", "1000")
				let framed = icyFramed(tone, 1000, string["Artist - Song", "Artist - Song"])
				return ctx.stream(200, "audio/mpeg", new bytes.Reader(framed))
			})
			try mux.get("/song.mp3", def (ctx http.Context) !none {
				return ctx.blob(200, "audio/mpeg", tone)
			})
			try mux.get("/station.pls", def (ctx http.Context) !none {
				return ctx.blob(200, "audio/x-scpls", "[playlist]\nFile1={ts.url}/radio\nNumberOfEntries=1\nVersion=2\n".bytes())
			})
			try ts.start()
			return ts
		}

		// The stream title of a metadata block, "(none)" without one.
		def titled(block byte[]) string {
			let title = streamTitle(block)
			return "(none)" when title is none
			return title
		}

		// Waits up to ten seconds for `done`.
		def within(done def() bool) bool {
			for let i = 0; i < 1000; i++ {
				return true when done()
				time.sleep(10ms)
			}
			return false
		}

		@test()
		def TestIcyReaderTakesOutMetadata() !none {
			let data byte[]
			for let i = 0; i < 100; i++ {
				data.push(byte(i))
			}
			let reader = new IcyReader(new bytes.Reader(icyFramed(data, 16, string["One", "Two - Three"])), 16)
			let got = new bytes.Buffer()
			try got.readFrom(reader)
			let out = got.bytes()
			assert out.len() == data.len()
			for let i = 0; i < data.len(); i++ {
				assert out[i] == data[i]
			}
			let titles = reader.takeTitles()
			assert titles.len() == 2 && titles[0] == "One" && titles[1] == "Two - Three"
			assert reader.takeTitles().len() == 0
		}

		@test()
		def TestStreamTitleReadsLatin1AndCutTitles() !none {
			assert titled("StreamTitle='It''s';StreamUrl='';".bytes()) == "It''s"
			let latin byte[] = "StreamTitle='Caf".bytes() + byte[0xE9] + "';".bytes()
			assert titled(latin) == "Café"
			assert titled("StreamTitle='Cut".bytes()) == "Cut"
			assert titled("StreamUrl='x';".bytes()) == "(none)"
		}

		@test()
		def TestPlaysAStationAndItsTitles() !none {
			let ts = try station(try mp3Tone(4))
			defer ts.close()
			let sink = new PacedSink()
			let player = new MediaPlayer(sink)
			let retitled = int[]
			player.onTitleChange = def (index int) {
				retitled.push(index)
			}
			player.playlist.push(ts.url + "/radio")
			try player.play()
			let track = player.playlist.tracks[0]
			assert within(() => track.title == "Song")
			assert track.artist == "Artist"
			assert track.album == "Test FM"
			assert within(() => retitled.len() > 0)
			assert retitled[0] == 0
			assert within(() => sink.heard())
			assert player.seek(1s) is error
			player.stop()
		}

		@test()
		def TestPlaysAFileOverHttpToItsEnd() !none {
			let ts = try station(try mp3Tone(1))
			defer ts.close()
			let sink = new PacedSink()
			let player = new MediaPlayer(sink)
			player.playlist.push(ts.url + "/song.mp3")
			try player.play()
			assert within(() => player.state() == PlayerState.Stopped)
			assert sink.heard()
		}

		@test()
		def TestFollowsAPlaylistToTheStation() !none {
			let ts = try station(try mp3Tone(2))
			defer ts.close()
			let player = new MediaPlayer(new PacedSink())
			player.playlist.push(ts.url + "/station.pls")
			try player.play()
			let track = player.playlist.tracks[0]
			assert within(() => track.album == "Test FM")
			player.stop()
		}

		@test()
		def TestReportsAStationThatIsNotThere() !none {
			let ts = try station(try mp3Tone(1))
			defer ts.close()
			let player = new MediaPlayer(new PacedSink())
			let failed = int[]
			player.onError = def (index int, err error) {
				failed.push(index)
			}
			player.playlist.push(ts.url + "/gone")
			try player.play()
			assert within(() => failed.len() > 0)
			assert within(() => player.state() == PlayerState.Stopped)
		}
	}
}
