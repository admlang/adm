partial module std.media.player {
	use (
		std.gfx
		std.formats.audio
		std.math
		std.math.processing::(rfft)
	)

	// LevelBarsVisualizer is a spectrum analyzer in the style of Winamp's:
	// one bar per frequency band (logarithmic, 40 Hz up), coloured green
	// at the bottom through yellow to red at the top, each with a peak
	// cap that holds a moment and then drops.
	type LevelBarsVisualizer {
		bands   int   = 32
		// dB shown below full scale; quieter bands draw nothing.
		range   float = 70.0
		// How fast a bar sinks (full heights per second).
		fall    float = 1.6
		// How long a peak stays up, then how fast its drop speeds up.
		hold    float = 0.35
		gravity float = 2.5

		levels float[]
		peaks  float[]
		holds  float[]
		speeds float[]

		def new() {}

		def draw(samples float32[], info audio.AudioInfo, display gfx.Raster) {
			let channels = int(info.channels).max(1)
			let frames = samples.len() / channels
			return when frames == 0 || info.sampleRate == 0
			let dt = float(frames) / float(info.sampleRate)
			let spectrum = bandLevels(samples, channels, frames, float(info.sampleRate))
			settle(spectrum, dt)
			paint(display)
		}

		// bandLevels is each band's loudness, 0 (silent) to 1 (full scale):
		// the channels mixed down, a Hann window, an FFT, the loudest bin of
		// each band in dB.
		internal def bandLevels(samples float32[], channels int, frames int, rate float) float[] {
			let n = 256
			for n * 2 <= frames && n < 2048 {
				n *= 2
			}
			let mono float64[] = []
			mono.len(n)
			let windowSum = 0.0
			for let i = 0; i < n; i++ {
				let w = 0.5 - 0.5 * math.cos(2.0 * math.Pi * float(i) / float(n - 1))
				windowSum += w
				if i >= frames {
					mono[i] = 0.0
					continue
				}
				let sum = 0.0
				for let c = 0; c < channels; c++ {
					sum += float(samples[i * channels + c])
				}
				mono[i] = float64(sum / float(channels) * w)
			}
			let bins = rfft(mono)
			let low = 40.0
			let high = (rate / 2.0).min(16000.0)
			let out float[] = []
			out.len(bands)
			for let b = 0; b < bands; b++ {
				let from = low * (high / low) ** (float(b) / float(bands))
				let to = low * (high / low) ** (float(b + 1) / float(bands))
				let first = int(from * float(n) / rate).clamp(1, bins.len() - 1)
				let last = int(to * float(n) / rate).clamp(first, bins.len() - 1)
				let loudest = 0.0
				for let k = first; k <= last; k++ {
					loudest = loudest.max(bins[k].abs())
				}
				// A full-scale sine reads 1.0.
				let amplitude = loudest * 2.0 / windowSum
				let db = amplitude > 0.0 ?? (20.0 * math.log10(amplitude), -range)
				out[b] = ((db + range) / range).clamp(0.0, 1.0)
			}
			return out
		}

		// settle moves the bars and peaks on by `dt` seconds: a bar jumps up
		// and sinks at `fall`; a peak holds for `hold`, then drops faster
		// and faster.
		internal def settle(spectrum float[], dt float) {
			if levels.len() != bands {
				levels.len(bands)
				peaks.len(bands)
				holds.len(bands)
				speeds.len(bands)
				levels.fill(0.0)
				peaks.fill(0.0)
				holds.fill(0.0)
				speeds.fill(0.0)
			}
			for let b = 0; b < bands; b++ {
				levels[b] = spectrum[b].max(levels[b] - fall * dt)
				if levels[b] >= peaks[b] {
					peaks[b] = levels[b]
					holds[b] = hold
					speeds[b] = 0.0
				} else if holds[b] > 0.0 {
					holds[b] -= dt
				} else {
					speeds[b] += gravity * dt
					peaks[b] = (peaks[b] - speeds[b] * dt).max(levels[b])
				}
			}
		}

		// paint draws the bars and their peak caps over the whole display.
		internal def paint(display gfx.Raster) {
			let w = int(display.size().width)
			let h = int(display.size().height)
			return when w < bands * 2 || h < 8
			let data = display.raw()
			let stride = display.stride()
			let margin = (h / 20).max(2)
			let top = margin
			let bottom = h - margin
			let height = bottom - top
			let slot = (w - 2 * margin) / bands
			let gap = (slot / 5).max(1)
			let peakRows = (height / 60).max(1)
			for let b = 0; b < bands; b++ {
				let x0 = margin + b * slot
				let x1 = x0 + slot - gap
				let barTop = bottom - int(levels[b] * float(height))
				for let y = barTop; y < bottom; y++ {
					let (r, g, bl) = shade(float(bottom - y) / float(height))
					fillRow(data, stride, y, x0, x1, r, g, bl)
				}
				let peakY = bottom - int(peaks[b] * float(height)) - peakRows
				if peaks[b] > 0.0 {
					for let y = peakY.max(top); y < peakY + peakRows; y++ {
						fillRow(data, stride, y, x0, x1, 200, 200, 210)
					}
				}
			}
		}

		// shade is the bar colour at a height from 0 (bottom) to 1 (top):
		// green, then yellow at the middle, then red.
		internal def shade(t float) (int, int, int) {
			if t < 0.5 {
				let k = t * 2.0
				return (int(40.0 + 190.0 * k), int(200.0 + 20.0 * k), 40)
			}
			let k = (t - 0.5) * 2.0
			return (230, int(220.0 - 180.0 * k), int(40.0 - 10.0 * k))
		}

		internal def fillRow(data byte[], stride int, y int, x0 int, x1 int, r int, g int, b int) {
			let at = y * stride + x0 * 4
			for let x = x0; x < x1; x++ {
				data[at] = byte(r)
				data[at + 1] = byte(g)
				data[at + 2] = byte(b)
				data[at + 3] = byte(255)
				at += 4
			}
		}
	}
}
