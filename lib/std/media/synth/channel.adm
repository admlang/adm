internal partial module std.media.synth.engine {
	// The controller state of one MIDI channel.
	type SynthChannel {
		// Whether the channel plays percussion (channel 9 by General MIDI).
		drums         bool
		program       int
		bankHigh      int
		bankLow       int
		volume        int
		expression    int
		// Controller 10: 0 left, 64 centre, 127 right.
		panning       int
		modulation    int
		reverb        int
		sustain       bool
		// Pitch bend, -8192 to 8191.
		bend          int
		// Pitch bend range in cents each way.
		bendRange     float
		// The registered parameter selected for data entry (controllers 101
		// and 100), 127 each for none.
		parameterHigh int
		parameterLow  int

		// A channel in its power-on state; `drums` for percussion.
		def new(drums bool) {
			self.drums = drums
			reset()
		}

		// Returns every controller to its power-on value.
		def reset() {
			program = 0
			bankHigh = 0
			bankLow = 0
			volume = 100
			expression = 127
			panning = 64
			reverb = 40
			bendRange = 200.0
			resetControllers()
		}

		// Resets the controllers "reset all controllers" (121) covers:
		// modulation, expression, sustain, pitch bend and the parameter
		// selection; volume and pan stay.
		def resetControllers() {
			modulation = 0
			expression = 127
			sustain = false
			bend = 0
			parameterHigh = 127
			parameterLow = 127
		}

		// The channel's gain from volume and expression, each on the General
		// MIDI curve (40 log10 of the value, so the square of it).
		def level() float {
			let v = float(volume) / 127.0
			let e = float(expression) / 127.0
			return v * v * e * e
		}

		// The channel's stereo position, -1 left to 1 right.
		def panPosition() float {
			return (float(panning) - 64.0) / 64.0
		}

		// The pitch bend in cents.
		def bendCents() float {
			return float(bend) / 8192.0 * bendRange
		}

		// The vibrato depth the modulation wheel adds, up to 50 cents.
		def modulationCents() float {
			return float(modulation) / 127.0 * 50.0
		}

		// The reverb send, 0 to 1.
		def reverbSend() float {
			return float(reverb) / 127.0
		}

		// Whether data entry sets the pitch bend range (registered parameter 0).
		def bendRangeSelected() bool {
			return parameterHigh == 0 && parameterLow == 0
		}

		// The bank a SoundFont preset is looked up in: 128 for percussion.
		def bank() int {
			return drums ?? (128, bankHigh)
		}
	}
}
