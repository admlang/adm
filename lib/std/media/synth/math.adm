internal partial module std.media.synth.engine {
	// Frames between control updates: envelopes of pitch, pan, level and
	// filter are recomputed on this grid, which runs on the synthesizer's own
	// clock so the output does not depend on how `render` calls are sized.
	const SYNTH_BLOCK = 32

	// Entries in one cycle of the shared sine table.
	const SYNTH_SINE = 4096

	// 2 raised to `x`, within about 2e-7 of it relative, for any x from -1000
	// to 1000.
	def synthExp2(x float) float {
		let v = x.clamp(-1000.0, 1000.0)
		let whole = v.floor()
		let f = v - whole
		let p = 1.0 + f * (0.6931471805599453 + f * (0.2402265069591007 + f * (0.0555041086648216 + f * (0.009618129107628477 + f * (0.0013333558146428443 + f * (0.00015403530393381606 + f * 0.000015252733804059841))))))
		let bits = uint64(int(whole) + 1023) << uint64(52)
		return p * float(__bitcast_f64_from_u64(bits))
	}

	// The amplitude factor of `db` decibels: 1 at 0, 0.5 near -6.
	def synthGain(db float) float {
		return synthExp2(db * 0.16609640474436813)
	}

	// The frequency factor of `cents`: 2 at 1200.
	def synthRatio(cents float) float {
		return synthExp2(cents / 1200.0)
	}

	// The frequency of a MIDI key, fractional keys included: 440 at 69.
	def synthKeyHz(key float) float {
		return 440.0 * synthExp2((key - 69.0) / 12.0)
	}

	// The per-sample factor that takes a level down `db` decibels over
	// `seconds` at `rate` frames a second; 1 when the time is not positive.
	def synthFade(db float, seconds float, rate float) float {
		return 1.0 when seconds <= 0.0
		return synthGain(-db / (seconds * rate))
	}

	// The sine of `x` radians, to about 1e-12.
	def synthSin(x float) float {
		let tau = 6.283185307179586
		let v = x - tau * (x / tau).round()
		let x2 = v * v
		let term = v
		let sum = v
		for let i = 1; i <= 11; i++ {
			term *= -x2 / float((2 * i) * (2 * i + 1))
			sum += term
		}
		return sum
	}

	// The cosine of `x` radians.
	def synthCos(x float) float {
		return synthSin(x + 1.5707963267948966)
	}

	// One cycle of a sine, `SYNTH_SINE` entries plus the first repeated at the
	// end so a lookup can read the entry after any index.
	def synthSineTable() float[] {
		let table float[]
		table.len(SYNTH_SINE + 1)
		for let i = 0; i <= SYNTH_SINE; i++ {
			table[i] = synthSin(6.283185307179586 * float(i) / float(SYNTH_SINE))
		}
		return table
	}
}
