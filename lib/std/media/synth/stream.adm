internal partial module std.media.synth.engine {
	use std.formats.audio::(AudioInfo, Midi, MidiStatus, SampleFormat)

	// Seconds of fade at the very end of a stream, so a note still sounding
	// when the length runs out stops without a click.
	const SYNTH_END_FADE = 0.02

	// Seconds of tail a stream allows at most after its last event.
	const SYNTH_MAX_TAIL = 10.0

	// A channel message of a MIDI file at the frame it plays.
	struct SynthEvent {
		frame   int
		// The status without the channel (0x80 to 0xE0), or 0 for the end of
		// the song, where every note is released.
		status  int
		channel int
		// The data bytes; a pitch bend has its value, -8192 to 8191, in `a`.
		a       int
		b       int
	}

	// The stream `Synth.stream` returns: the file's channel messages placed
	// on frames by its tempo map, played through the engine at sample
	// accuracy. Its length is the last event's frame plus the longest
	// release (or drum) that can still sound and the reverb's tail.
	//
	// Seeking renders silently from the start (back) or from where the stream
	// stands (forward), so a seek lands on exactly the frames a continuous
	// read produces.
	type SynthStream {
		engine        SynthEngine
		events        SynthEvent[]
		// Index of the next event to play.
		next          int
		// The frame of the file's end, where every note is released.
		songFrames    int
		totalFrames   int
		framePosition int
		closed        bool
		scratch       float32[]

		// A stream of `midi` through `engine`, which it resets.
		def new(engine SynthEngine, midi Midi) {
			self.engine = engine
			schedule(midi)
			engine.reset()
		}

		// Merges the tracks by tick (format 1), or takes the single track
		// (format 0) or the first (format 2), and places every channel message
		// on its frame.
		def schedule(midi Midi) {
			let rate = engine.rate
			let tracks = midi.tracks
			let count = int(midi.format) == 2 ?? (tracks.len().min(1), tracks.len())
			let quarter = quarterTicks(midi)
			let (perSecond, per) = smpteTicks(midi)
			let cursors int[]
			let ticks int[]
			for let t = 0; t < count; t++ {
				cursors.push(0)
				ticks.push(tracks[t].events.len() > 0 ?? (int(tracks[t].events[0].delta), 0))
			}
			// Tempo-weighted ticks: microseconds times ticks per quarter.
			let elapsed = 0
			let lastTick = 0
			let tempo = 500000
			for {
				let pick = -1
				for let t = 0; t < count; t++ {
					continue when cursors[t] >= tracks[t].events.len()
					pick = t when pick < 0 || ticks[t] < ticks[pick]
				}
				break when pick < 0
				let event = tracks[pick].events[cursors[pick]]
				let tick = ticks[pick]
				elapsed += (tick - lastTick) * tempo
				lastTick = tick
				let frame = quarter > 0 ?? (elapsed * rate / (quarter * 1000000), tick * rate * per / perSecond)
				if event.status == MidiStatus.Meta {
					if event.data.len() == 4 && event.data[0] == 0x51 {
						let value = int(event.data[1]) << 16 | int(event.data[2]) << 8 | int(event.data[3])
						tempo = value when value > 0
					}
				} else {
					let status = int(event.status.value)
					let a = event.data.len() > 0 ?? (int(event.data[0]), 0)
					let b = event.data.len() > 1 ?? (int(event.data[1]), 0)
					if event.status == MidiStatus.PitchBend {
						events.push(SynthEvent{frame: frame, status: status, channel: int(event.channel), a: (b << 7 | a) - 8192, b: 0})
					} else if event.status == MidiStatus.NoteOn || event.status == MidiStatus.NoteOff || event.status == MidiStatus.ControlChange || event.status == MidiStatus.ProgramChange {
						events.push(SynthEvent{frame: frame, status: status, channel: int(event.channel), a: a, b: b})
					}
				}
				cursors[pick] += 1
				ticks[pick] += int(tracks[pick].events[cursors[pick]].delta) when cursors[pick] < tracks[pick].events.len()
			}
			let endTick = 0
			for let t = 0; t < count; t++ {
				endTick = endTick.max(tracks[t].ticks())
			}
			elapsed += (endTick - lastTick).max(0) * tempo
			songFrames = quarter > 0 ?? (elapsed * rate / (quarter * 1000000), endTick * rate * per / perSecond)
			for let (_, event) in events {
				songFrames = songFrames.max(event.frame)
			}
			events.push(SynthEvent{frame: songFrames, status: 0, channel: 0, a: 0, b: 0})
			let tail = (tailSeconds() + SYNTH_REVERB_TAIL + SYNTH_END_FADE).min(SYNTH_MAX_TAIL)
			totalFrames = songFrames + int(tail * float(rate))
		}

		// Ticks in a quarter note, 0 when the file counts SMPTE frames.
		def quarterTicks(midi Midi) int {
			let ticks = midi.ticksPerQuarter()
			return 0 when ticks is none
			let value int = ticks
			return value.max(1)
		}

		// SMPTE ticks per second as a fraction: 29 frames a second is 29.97.
		def smpteTicks(midi Midi) (int, int) {
			let timing = midi.smpte()
			return (1, 1) when timing is none
			let (fps, perFrame) = timing
			return ((30000 * perFrame.max(1)), 1001) when fps == 29
			return ((fps.max(1) * perFrame.max(1)), 1)
		}

		// Seconds past the song's end that its notes can still sound: the
		// longest release, or for a note that plays out, what is left of it.
		def tailSeconds() float {
			let rate = float(engine.rate)
			let end = float(songFrames) / rate
			let channels SynthChannel[]
			for let i = 0; i < 16; i++ {
				channels.push(new SynthChannel(i == 9))
			}
			let seen map<int, float>
			let longest = 0.0
			for let (_, event) in events {
				let channel = channels[event.channel & 15]
				if event.status == 0xC0 {
					channel.program = event.a & 127
				} else if event.status == 0xB0 && event.a == 0 {
					channel.bankHigh = event.b
				} else if event.status == 0x90 && event.b > 0 {
					let id = ((channel.bank() * 128 + channel.program) * 128 + event.a) * 2 + (channel.drums ?? (1, 0))
					let known = seen.get(id)
					let ring = 0.0
					if known is none {
						let (seconds, playsOut) = engine.ringTime(channel, event.a, event.b)
						ring = playsOut ?? (-seconds, seconds)
						seen[id] = ring
					} else {
						let value float = known
						ring = value
					}
					if ring < 0.0 {
						longest = longest.max(float(event.frame) / rate - ring - end)
					} else {
						longest = longest.max(ring)
					}
				}
			}
			return longest.max(0.0)
		}

		// Info implements AudioStream: stereo float32 at the engine's rate,
		// seekable, with the length the tempo map gives.
		def info() AudioInfo {
			let rate = engine.rate
			return AudioInfo{
				sampleRate: uint32(rate),
				channels: uint16(2),
				bitDepth: uint16(32),
				format: SampleFormat.Float32,
				frames: uint64(totalFrames),
				length: duration(int64(totalFrames) * 1000000000 / int64(rate)),
				codec: "midi",
				bitrate: uint32(rate * 64),
				seekable: true,
			}
		}

		// Read implements AudioStream: fills `buf` with the next stereo frames
		// and returns how many, 0 at the end.
		//
		// Fails when the stream is closed.
		def read(buf float32[]) !int {
			fail "synth: the stream is closed" when closed
			let want = (buf.len() / 2).min(totalFrames - framePosition)
			return 0 when want <= 0
			let done = 0
			for done < want {
				let now = framePosition + done
				for next < events.len() && events[next].frame <= now {
					dispatch(events[next])
					next += 1
				}
				let span = want - done
				span = span.min(events[next].frame - now) when next < events.len()
				engine.render(buf[done * 2:(done + span) * 2])
				done += span
			}
			let fade = int(SYNTH_END_FADE * float(engine.rate)).max(1)
			let fadeStart = totalFrames - fade
			for let i = 0; i < want; i++ {
				let frame = framePosition + i
				continue when frame < fadeStart
				let scale = float32(float(totalFrames - frame - 1) / float(fade))
				buf[i * 2] *= scale
				buf[i * 2 + 1] *= scale
			}
			framePosition += want
			return want
		}

		// Plays one scheduled event.
		def dispatch(event SynthEvent) {
			let s = event.status
			if s == 0x90 {
				engine.noteOn(event.channel, event.a, event.b)
			} else if s == 0x80 {
				engine.noteOff(event.channel, event.a)
			} else if s == 0xB0 {
				engine.controlChange(event.channel, event.a, event.b)
			} else if s == 0xC0 {
				engine.programChange(event.channel, event.a)
			} else if s == 0xE0 {
				engine.pitchBend(event.channel, event.a)
			} else {
				engine.allNotesOff()
			}
		}

		// Seek implements AudioStream: positions the stream at `frame`, the
		// end when past it, by rendering silently up to it.
		//
		// Fails when the stream is closed.
		def seek(frame uint64) !none {
			fail "synth: the stream is closed" when closed
			let target = int(frame.min(uint64(totalFrames)))
			if target < framePosition {
				engine.reset()
				next = 0
				framePosition = 0
			}
			scratch.len(8192) when scratch.len() < 8192
			for framePosition < target {
				let span = (target - framePosition).min(4096)
				try read(scratch[:span * 2])
			}
			return none
		}

		// Seek implements AudioStream: positions the stream `time` from its
		// start.
		//
		// Fails when the stream is closed.
		def seek(time duration) !none {
			return seek(uint64(frameOf(time)))
		}

		// Skip implements AudioStream: moves the stream by `offset`, back when
		// negative, staying between the start and the end.
		//
		// Fails when the stream is closed.
		def skip(offset duration) !none {
			let moved = offset < 0s ?? (framePosition - frameOf(-offset), framePosition + frameOf(offset))
			return seek(uint64(moved.clamp(0, totalFrames)))
		}

		// The frame `time` from the start, 0 for a negative time.
		def frameOf(time duration) int {
			return 0 when time <= 0s
			return int(int64(time) / 1000 * int64(engine.rate) / 1000000)
		}

		// Position implements AudioStream: the frame the next read starts at.
		def position() uint64 {
			return uint64(framePosition)
		}

		// Close implements io.Closer; reads and seeks fail after it. Closing
		// twice does nothing.
		def close() !none {
			closed = true
			return none
		}
	}
}
