partial module std.media.synth {
	use (
		std.formats.audio::(AudioStream, Midi, SoundFont)
		std.media.synth.engine::*
	)

	// A software synthesizer: it plays notes, from a program or a MIDI file,
	// with the samples of a SoundFont or, without one, with built-in waveforms.
	// It renders stereo float32 frames at `sampleRate`.
	type Synth {
		// Frames per second it renders.
		sampleRate      int
		internal engine SynthEngine

		// A synthesizer playing built-in waveforms, one tone family per General
		// MIDI instrument group and noise for drums.
		def new(sampleRate int = 48000) {
			engine = new SynthEngine(sampleRate, none)
			self.sampleRate = engine.rate
		}

		// A synthesizer playing the bank's samples.
		def new(font SoundFont, sampleRate int = 48000) {
			engine = new SynthEngine(sampleRate, font)
			self.sampleRate = engine.rate
		}

		// Starts a note; velocity 0 stops it, as MIDI has it. Channel 9 (the
		// tenth) plays drums.
		def noteOn(channel int, key int, velocity int) {
			engine.noteOn(channel, key, velocity)
		}

		// Releases a note.
		def noteOff(channel int, key int) {
			engine.noteOff(channel, key)
		}

		// Chooses the instrument a channel plays.
		def programChange(channel int, program int) {
			engine.programChange(channel, program)
		}

		// Sets a controller: bank select (0, 32), modulation (1), volume (7),
		// pan (10), expression (11), sustain (64), all sound off (120), all
		// notes off (123), reset (121).
		def controlChange(channel int, controller int, value int) {
			engine.controlChange(channel, controller, value)
		}

		// Bends a channel's pitch, -8192 to 8191, two semitones each way.
		def pitchBend(channel int, value int) {
			engine.pitchBend(channel, value)
		}

		// Releases every note on every channel.
		def allNotesOff() {
			engine.allNotesOff()
		}

		// Fills `buf` with stereo interleaved frames of what is sounding and
		// returns the frame count, `buf.len() / 2`.
		def render(buf float32[]) int {
			return engine.render(buf)
		}

		// A stream playing the MIDI file through this synthesizer: stereo at
		// `sampleRate`, following its tempo changes, ending once the last
		// released note has faded.
		def stream(midi Midi) AudioStream {
			return new SynthStream(engine, midi)
		}
	}
}
