partial module std.media.synth {
	use (
		std.bytes
		std.formats.audio::(Midi, MidiTrack, SoundFont, SoundFontLoop, SoundFontVoice)
		std.os
		std.testing
		std.media.synth.engine::*
	)

	check "Synth" {
		// Rendered frames of a synthesizer, interleaved stereo.
		internal def frames(synth Synth, count int) float32[] {
			let buf float32[]
			buf.len(count * 2)
			synth.render(buf)
			return buf
		}

		// Rendered frames of an engine, interleaved stereo.
		internal def engineFrames(engine SynthEngine, count int) float32[] {
			let buf float32[]
			buf.len(count * 2)
			engine.render(buf)
			return buf
		}

		// The root mean square of frames `from` to `to` over both sides.
		internal def rms(buf float32[], from int, to int) float {
			let sum = 0.0
			for let i = from * 2; i < to * 2; i++ {
				let v = float(buf[i])
				sum += v * v
			}
			let n = float((to - from) * 2).max(1.0)
			let mean = sum / n
			// Newton's method is enough for a test.
			let root = mean.max(0.0000000001)
			for let k = 0; k < 40; k++ {
				root = 0.5 * (root + mean / root)
			}
			return mean <= 0.0 ?? (0.0, root)
		}

		// The largest sample magnitude.
		internal def peak(buf float32[]) float {
			let top = 0.0
			for let i = 0; i < buf.len(); i++ {
				top = top.max(float(buf[i]).abs())
			}
			return top
		}

		// The frequency of the left channel over frames `from` to `to`, from
		// the times of its rising zero crossings.
		internal def frequency(buf float32[], from int, to int, rate int) float {
			let first = -1.0
			let last = -1.0
			let count = 0
			for let i = from + 1; i < to; i++ {
				let a = float(buf[(i - 1) * 2])
				let b = float(buf[i * 2])
				continue unless a < 0.0 && b >= 0.0
				let t = float(i - 1) + a / (a - b)
				if first < 0.0 {
					first = t
				} else {
					count += 1
				}
				last = t
			}
			return 0.0 when count == 0
			return float(count) / (last - first) * float(rate)
		}

		// A synthesizer without reverb, so silence is silence.
		internal def dry() Synth {
			let synth = new Synth()
			for let c = 0; c < 16; c++ {
				synth.controlChange(c, 91, 0)
			}
			return synth
		}

		// A pipe (flute) note: nearly a sine, so zero crossings give its pitch.
		@test()
		def TestPitchMatchesKey() {
			for let (_, key) in [57, 69, 76] {
				let synth = dry()
				synth.programChange(0, 73)
				synth.noteOn(0, key, 100)
				let buf = frames(synth, 24000)
				let want = synthKeyHz(float(key))
				let got = frequency(buf, 4800, 24000, 48000)
				assert (got - want).abs() < want * 0.003
			}
		}

		@test()
		def TestVelocityChangesLevel() {
			let levels float[]
			for let (_, velocity) in [30, 70, 120] {
				let synth = dry()
				synth.noteOn(0, 60, velocity)
				levels.push(rms(frames(synth, 9600), 0, 9600))
			}
			assert levels[0] > 0.0
			assert levels[0] < levels[1]
			assert levels[1] < levels[2]
		}

		@test()
		def TestNoteOffFadesToSilence() {
			let synth = dry()
			synth.programChange(0, 16)
			synth.noteOn(0, 60, 100)
			let held = frames(synth, 9600)
			assert rms(held, 4800, 9600) > 0.01
			synth.noteOff(0, 60)
			let after = frames(synth, 24000)
			assert rms(after, 19200, 24000) < 0.00001
			synth.noteOn(0, 64, 100)
			synth.noteOn(0, 64, 0)
			let zero = frames(synth, 24000)
			assert rms(zero, 19200, 24000) < 0.00001
		}

		@test()
		def TestSustainPedalHolds() {
			let synth = dry()
			synth.programChange(0, 16)
			synth.controlChange(0, 64, 127)
			synth.noteOn(0, 60, 100)
			frames(synth, 4800)
			synth.noteOff(0, 60)
			let pedal = frames(synth, 24000)
			assert rms(pedal, 19200, 24000) > 0.01
			synth.controlChange(0, 64, 0)
			let lifted = frames(synth, 24000)
			assert rms(lifted, 19200, 24000) < 0.00001
		}

		@test()
		def TestAllNotesOff() {
			let synth = dry()
			synth.programChange(1, 16)
			synth.controlChange(1, 64, 127)
			synth.noteOn(1, 60, 100)
			synth.noteOn(1, 67, 100)
			frames(synth, 4800)
			synth.allNotesOff()
			assert rms(frames(synth, 24000), 19200, 24000) < 0.00001
			synth.noteOn(2, 60, 100)
			frames(synth, 4800)
			synth.controlChange(2, 120, 0)
			assert rms(frames(synth, 4800), 2400, 4800) < 0.00001
		}

		@test()
		def TestPitchBend() {
			let synth = dry()
			synth.programChange(0, 73)
			synth.pitchBend(0, 8191)
			synth.noteOn(0, 69, 100)
			let up = frequency(frames(synth, 24000), 4800, 24000, 48000)
			assert (up - 440.0 * synthRatio(200.0 * 8191.0 / 8192.0)).abs() < 2.0
			synth.pitchBend(0, -8192)
			let buf = frames(synth, 24000)
			assert (frequency(buf, 4800, 24000, 48000) - 440.0 * synthRatio(-200.0)).abs() < 2.0
			// Registered parameter 0 sets the range: an octave.
			synth.controlChange(0, 101, 0)
			synth.controlChange(0, 100, 0)
			synth.controlChange(0, 6, 12)
			synth.pitchBend(0, 4096)
			let half = frequency(frames(synth, 24000), 4800, 24000, 48000)
			assert (half - 440.0 * synthRatio(600.0)).abs() < 3.0
		}

		@test()
		def TestDrumsSound() {
			for let (_, key) in [35, 36, 38, 39, 42, 46, 49, 51, 56, 60, 75, 81] {
				let synth = dry()
				synth.noteOn(9, key, 110)
				let buf = frames(synth, 9600)
				assert rms(buf, 0, 9600) > 0.002
			}
		}

		// An open hi-hat is choked by a closed one.
		@test()
		def TestExclusiveHats() {
			let synth = dry()
			synth.noteOn(9, 46, 110)
			let open = frames(synth, 9600)
			let ringing = rms(open, 7200, 9600)
			synth.noteOn(9, 42, 1)
			let choked = frames(synth, 24000)
			assert ringing > 0.001
			assert rms(choked, 19200, 24000) < ringing * 0.01
		}

		@test()
		def TestDenseNeverClips() {
			let synth = new Synth()
			for let c = 0; c < 16; c++ {
				synth.programChange(c, c * 8 + 1)
				synth.controlChange(c, 7, 127)
			}
			for let k = 0; k < 64; k++ {
				synth.noteOn(k % 16, 36 + k, 127)
			}
			let buf = frames(synth, 24000)
			assert peak(buf) <= 0.9
			assert rms(buf, 0, 24000) > 0.05
		}

		@test()
		def TestEveryProgramSounds() {
			let synth = dry()
			for let program = 0; program < 128; program++ {
				synth.programChange(0, program)
				synth.noteOn(0, 60, 100)
				let buf = frames(synth, 2400)
				assert rms(buf, 0, 2400) > 0.0005
				synth.controlChange(0, 120, 0)
				frames(synth, 960)
			}
		}

		// Rendering in odd-sized pieces gives the frames one call gives.
		@test()
		def TestRenderSizeIndependent() {
			let whole = dry()
			let pieces = dry()
			for let (_, synth) in [whole, pieces] {
				synth.programChange(0, 48)
				synth.noteOn(0, 60, 100)
				synth.noteOn(9, 38, 100)
			}
			let one = frames(whole, 4000)
			let joined float32[]
			let done = 0
			let size = 1
			for done < 4000 {
				let n = size.min(4000 - done)
				joined = joined.concat(frames(pieces, n))
				done += n
				size = size * 3 % 97 + 1
			}
			for let i = 0; i < one.len(); i++ {
				assert one[i] == joined[i]
			}
		}

		// Polyphony: past 64 sounding voices the oldest are cut off.
		@test()
		def TestVoiceStealing() {
			let engine = new SynthEngine(48000, none)
			engine.programChange(0, 16)
			for let k = 0; k < 100; k++ {
				engine.noteOn(0, 20 + k, 100)
				engineFrames(engine, 64)
			}
			let sounding = 0
			for let (_, voice) in engine.voices {
				sounding += 1 when voice.active && !voice.killed
			}
			assert sounding <= SYNTH_POLYPHONY
			engineFrames(engine, 4800)
			let active = 0
			for let (_, voice) in engine.voices {
				active += 1 when voice.active
			}
			assert active == SYNTH_POLYPHONY
		}

		// Samples of a sine at `hz` recorded at `rate`, `seconds` long.
		internal def sineSample(hz float, rate int, seconds float) int16[] {
			let data int16[]
			let count = int(float(rate) * seconds)
			for let i = 0; i < count; i++ {
				data.push(int16(synthSin(6.283185307179586 * hz * float(i) / float(rate)) * 16000.0))
			}
			return data
		}

		// A SoundFont voice playing a 441 Hz sine recorded at 44.1 kHz with key
		// 69 as its root, looping over whole cycles.
		internal def sineVoice() SoundFontVoice {
			let data = sineSample(441.0, 44100, 0.5)
			return SoundFontVoice{
				data: data,
				start: 0,
				end: data.len(),
				loopStart: 4410,
				loopEnd: 4410 + 100 * 100,
				loop: SoundFontLoop.Continuous,
				sampleRate: 44100,
				rootKey: 69,
				tune: 0,
				scaleTuning: 100,
				attenuation: 0.0,
				pan: 0.0,
				delay: 0.0,
				attack: 0.001,
				hold: 0.0,
				decay: 1.0,
				sustain: 0.0,
				release: 0.05,
				filterCutoff: 20000.0,
				filterQ: 0.0,
				vibratoRate: 0.0,
				vibratoDepth: 0.0,
				reverb: 0.0,
				chorus: 0.0,
				exclusiveClass: 0,
			}
		}

		// A dry engine playing SoundFont voices by hand.
		internal def sampler() SynthEngine {
			let engine = new SynthEngine(48000, none)
			for let c = 0; c < 16; c++ {
				engine.controlChange(c, 91, 0)
			}
			return engine
		}

		// The pitch of `voice` played at `key`.
		internal def samplePitch(voice SoundFontVoice, key int) float {
			let engine = sampler()
			engine.serial += 1
			engine.play(0, key, 100, [voice])
			return frequency(engineFrames(engine, 48000), 2400, 48000, 48000)
		}

		@test()
		def TestSamplePitch() {
			let voice = sineVoice()
			assert (samplePitch(voice, 69) - 441.0).abs() < 0.5
			assert (samplePitch(voice, 81) - 882.0).abs() < 1.0
			assert (samplePitch(voice, 64) - 441.0 * synthRatio(-500.0)).abs() < 0.5
			voice.tune = 100
			assert (samplePitch(voice, 69) - 441.0 * synthRatio(100.0)).abs() < 0.5
			voice.tune = 0
			voice.scaleTuning = 0
			assert (samplePitch(voice, 81) - 441.0).abs() < 0.5
			voice.scaleTuning = 100
			voice.sampleRate = 22050
			assert (samplePitch(voice, 69) - 220.5).abs() < 0.3
		}

		@test()
		def TestSampleLoops() {
			// Looping continuously, the note outlasts its half-second sample.
			let looped = sampler()
			looped.serial += 1
			looped.play(0, 69, 100, [sineVoice()])
			let long = engineFrames(looped, 96000)
			assert rms(long, 72000, 96000) > 0.05
			assert (frequency(long, 72000, 96000, 48000) - 441.0).abs() < 0.5

			// Without a loop it stops at the sample's end.
			let once = sineVoice()
			once.loop = SoundFontLoop.None
			let plain = sampler()
			plain.serial += 1
			plain.play(0, 69, 100, [once])
			let short = engineFrames(plain, 48000)
			assert rms(short, 12000, 20000) > 0.05
			assert rms(short, 26000, 48000) == 0.0
			let busy = 0
			for let (_, voice) in plain.voices {
				busy += 1 when voice.active
			}
			assert busy == 0

			// Looping until release, a long release still ends with the sample.
			let untilRelease = sineVoice()
			untilRelease.loop = SoundFontLoop.UntilRelease
			untilRelease.release = 10.0
			let held = sampler()
			held.serial += 1
			held.play(0, 69, 100, [untilRelease])
			let before = engineFrames(held, 48000)
			assert rms(before, 36000, 48000) > 0.05
			held.noteOff(0, 69)
			let after = engineFrames(held, 48000)
			assert rms(after, 36000, 48000) == 0.0

			// Looping continuously, the same long release keeps it sounding.
			let continuous = sineVoice()
			continuous.release = 10.0
			let ringing = sampler()
			ringing.serial += 1
			ringing.play(0, 69, 100, [continuous])
			engineFrames(ringing, 48000)
			ringing.noteOff(0, 69)
			assert rms(engineFrames(ringing, 48000), 36000, 48000) > 0.02
		}

		// The volume envelope: delay, linear attack, hold, decay in dB to the
		// sustain level, then release.
		@test()
		def TestSampleEnvelope() {
			let voice = sineVoice()
			voice.delay = 0.1
			voice.attack = 0.2
			voice.hold = 0.1
			voice.decay = 0.96
			voice.sustain = 12.0
			voice.release = 0.48
			let engine = sampler()
			engine.serial += 1
			engine.play(0, 69, 100, [voice])
			let playing = engine.voices[0]
			engineFrames(engine, 4800)
			assert playing.env == 0.0
			engineFrames(engine, 4800)
			assert (playing.env - 0.5).abs() < 0.02
			engineFrames(engine, 9600)
			assert playing.env == 1.0
			// The decay falls 100 dB a second: 6 dB in 0.06 s, and it stops at
			// the 12 dB sustain.
			engineFrames(engine, 2880)
			assert (playing.env - synthGain(-6.0)).abs() < 0.002
			engineFrames(engine, 9600)
			assert (playing.env - synthGain(-12.0)).abs() < 0.001
			engine.noteOff(0, 69)
			// Released: 96 dB per 0.48 s, so 24 dB in 0.12 s.
			engineFrames(engine, 5760)
			assert (playing.env - synthGain(-36.0)).abs() < 0.002
			engineFrames(engine, 48000)
			assert !playing.active
		}

		@test()
		def TestSampleAttenuationPanAndClass() {
			let loud = sampler()
			loud.serial += 1
			loud.play(0, 69, 100, [sineVoice()])
			let quiet = sampler()
			let voice = sineVoice()
			voice.attenuation = 20.0
			voice.pan = -1.0
			quiet.serial += 1
			quiet.play(0, 69, 100, [voice])
			let a = engineFrames(loud, 9600)
			let b = engineFrames(quiet, 9600)
			let ratio = rms(b, 4800, 9600) / rms(a, 4800, 9600)
			// 20 dB down; panned hard left, with constant power the level over
			// both sides stays the same.
			assert (ratio - 0.1).abs() < 0.01
			let right = 0.0
			for let i = 4800; i < 9600; i++ {
				right = right.max(float(b[i * 2 + 1]).abs())
			}
			assert right < 0.00001

			// Voices of one exclusive class cut each other off.
			let hats = sampler()
			let first = sineVoice()
			first.exclusiveClass = 3
			hats.serial += 1
			hats.play(0, 60, 100, [first])
			engineFrames(hats, 480)
			hats.serial += 1
			hats.play(0, 62, 100, [first])
			assert hats.voices[0].killed
			assert !hats.voices[1].killed
		}

		// The low-pass passes low notes and damps high ones.
		@test()
		def TestSampleFilter() {
			let open = sineVoice()
			let closed = sineVoice()
			closed.filterCutoff = 500.0
			let low = sampler()
			low.serial += 1
			low.play(0, 57, 100, [closed])
			let high = sampler()
			high.serial += 1
			high.play(0, 93, 100, [closed])
			let reference = sampler()
			reference.serial += 1
			reference.play(0, 93, 100, [open])
			let lowLevel = rms(engineFrames(low, 9600), 4800, 9600)
			let highLevel = rms(engineFrames(high, 9600), 4800, 9600)
			let openLevel = rms(engineFrames(reference, 9600), 4800, 9600)
			assert lowLevel > 0.05
			assert highLevel < openLevel * 0.15
		}

		// With a SoundFont that has no presets every note is silent.
		@test()
		def TestEmptySoundFont() {
			let synth = new Synth(new SoundFont(), 44100)
			assert synth.sampleRate == 44100
			synth.noteOn(0, 60, 100)
			synth.noteOn(9, 36, 100)
			assert peak(frames(synth, 4410)) == 0.0
		}

		// Sample files live in the repo, and `adm test` runs from its root.
		// A missing sample skips rather than fails.
		internal def sample(name string) !?Midi {
			let data = os.readFile("samples/audio/midi/" + name)
			return none when data is error
			let midi = new Midi()
			try midi.fromReader(new bytes.Buffer(data))
			return midi
		}

		// A short file's whole stream: its length matches `info`, it sounds,
		// and it ends in silence.
		@test()
		def TestStreamSamples() !none {
			let names = [
				"fixtures_bossa.mid",
				"fixtures_c-maj-scale.mid",
				"fixtures_closedHat.mid",
				"fixtures_example-format0.mid",
				"fixtures_example-format1.mid",
				"fixtures_satb-basic.mid",
				"fixtures_unquantized.mid",
				"fixtures_unquantized2bars-quantized1_16.mid",
				"fixtures_unquantized2bars-quantized1_32.mid",
				"fixtures_unquantized2bars-quantized1_8.mid",
				"fixtures_unquantized2bars.mid",
				"fixtures_unquantized_quantized-1_32.mid",
				"fixtures_unquantized_quantized-1_32_start_end.mid"
			]
			for let (_, name) in names {
				let midi = try sample(name)
				continue when midi is none
				let stream = new SynthStream(new SynthEngine(24000, none), midi)
				let info = stream.info()
				assert int(info.frames) == stream.totalFrames
				assert stream.totalFrames > stream.songFrames
				assert stream.totalFrames - stream.songFrames <= 24000 * 10
				let buf float32[]
				buf.len(4096)
				let total = 0
				let loudest = 0.0
				let last = 0.0
				for {
					let n = try stream.read(buf)
					break when n == 0
					total += n
					loudest = loudest.max(peak(buf[:n * 2]))
					last = rms(buf, n - n.min(200), n)
				}
				assert total == int(info.frames)
				assert int(stream.position()) == total
				assert loudest > 0.01
				assert loudest <= 0.9
				assert last < 0.0001
			}
		}

		// The song ends where its tempo map puts the last tick: 3840 ticks of
		// 480 a quarter at 120 beats a minute are 4 seconds.
		@test()
		def TestStreamLengthFollowsTempo() !none {
			let midi = try sample("fixtures_c-maj-scale.mid")
			return none when midi is none
			let stream = new SynthStream(new SynthEngine(48000, none), midi)
			assert stream.songFrames == 4 * 48000
			assert stream.info().length > 4s
			assert stream.info().seekable

			// Für Elise: tempo map read, not rendered.
			let elise = try sample("fixtures_elise.mid")
			return none when elise is none
			let long = new SynthStream(new SynthEngine(48000, none), elise)
			assert long.songFrames > 160 * 48000
			assert long.songFrames < 175 * 48000
			let single = try sample("fixtures_elise1track.mid")
			return none when single is none
			let flat = new SynthStream(new SynthEngine(48000, none), single)
			assert (flat.songFrames - long.songFrames).abs() < 48000
			let buf float32[]
			buf.len(48000 * 2)
			try flat.read(buf)
			assert rms(buf, 0, 48000) > 0.01
		}

		// A tempo change halfway and SMPTE timing, on files built here.
		@test()
		def TestStreamTempoChangesAndSmpte() {
			let midi = new Midi()
			midi.format = 1
			midi.division = 480
			let tempo = new MidiTrack()
			tempo.tempo(500000)
			tempo.tempo(250000, 480)
			tempo.endOfTrack(480)
			let notes = new MidiTrack()
			notes.noteOn(0, 60, 100)
			notes.noteOff(0, 60, 0, 480)
			notes.noteOn(0, 62, 100)
			notes.noteOff(0, 62, 0, 480)
			midi.tracks = [tempo, notes]
			let stream = new SynthStream(new SynthEngine(48000, none), midi)
			assert stream.songFrames == 36000
			assert stream.events[2].frame == 24000

			let smpte = new Midi()
			smpte.format = 0
			// 25 frames a second, 40 ticks a frame: 1000 ticks a second.
			smpte.division = 0xE728
			let track = new MidiTrack()
			track.noteOn(0, 60, 100, 500)
			track.noteOff(0, 60, 0, 1000)
			smpte.tracks = [track]
			let timed = new SynthStream(new SynthEngine(48000, none), smpte)
			assert timed.events[0].frame == 24000
			assert timed.songFrames == 72000

			// Format 2 plays only its first pattern.
			let patterns = new Midi()
			patterns.format = 2
			patterns.division = 96
			let second = new MidiTrack()
			second.noteOn(0, 64, 100, 9600)
			patterns.tracks = [track, second]
			let first = new SynthStream(new SynthEngine(48000, none), patterns)
			assert first.events.len() == 3
		}

		// Seeking lands on the frames a continuous read gives, back or forward,
		// by frame, by time and by offset.
		@test()
		def TestStreamSeek() !none {
			let midi = try sample("fixtures_bossa.mid")
			return none when midi is none
			let synth = new Synth(24000)
			let stream = synth.stream(midi)
			let whole float32[]
			whole.len(24000 * 3 * 2)
			try stream.read(whole)
			let part float32[]
			part.len(12000 * 2)

			try stream.seek(uint64(30000))
			assert stream.position() == uint64(30000)
			try stream.read(part)
			for let i = 0; i < part.len(); i++ {
				assert part[i] == whole[30000 * 2 + i]
			}
			try stream.seek(1s)
			try stream.read(part)
			for let i = 0; i < part.len(); i++ {
				assert part[i] == whole[24000 * 2 + i]
			}
			try stream.skip(-500ms)
			assert stream.position() == uint64(24000)
			try stream.skip(1500ms)
			assert stream.position() == uint64(60000)
			try stream.read(part)
			for let i = 0; i < part.len(); i++ {
				assert part[i] == whole[60000 * 2 + i]
			}
			try stream.seek(uint64(1) << uint64(40))
			assert int(stream.position()) == int(stream.info().frames)
			assert try stream.read(part) == 0
			try stream.close()
			assert stream.read(part) is error
		}
	}
}
