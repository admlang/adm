internal partial module std.media.synth.engine {
	use (
		std.formats.audio::(SoundFontLoop, SoundFontVoice)
		std.media.dsp::(FilterKind)
		std.media.dsp.core::(design)
	)

	// Where a voice's volume envelope stands.
	enum SynthStage {
		Delay,
		Attack,
		Hold,
		// Falling linearly in dB toward the sustain level.
		Decay,
		Sustain,
		// Falling linearly in dB toward silence after the note ends.
		Release,
		// Silent: the voice is free.
		Done,
	}

	// The level below which an envelope counts as silent, -80 dB.
	const SYNTH_SILENT = 0.0001

	// Frequency ratios of the six square waves of a metallic drum sound, in
	// Hz at a `metalHz` of 1.
	const SYNTH_METAL = [205.3, 304.4, 369.6, 522.7, 540.0, 800.0]

	// One sounding note: a generator (a SoundFont sample or a built-in wave),
	// a low-pass filter, a volume envelope and a stereo position. The pool of
	// a `SynthEngine` reuses voices, so starting one resets every setting.
	type SynthVoice {
		// Whether the voice is sounding; a free voice is not.
		active    bool
		channel   int
		key       int
		velocity  int
		// Start order: voices of one note-on share it, later notes have higher.
		serial    int
		// Whether the note has ended and the envelope is releasing.
		released  bool
		// Whether a note-off came while the sustain pedal was down.
		held      bool
		// Whether the voice was cut off to make room or by its exclusive class.
		killed    bool
		exclusive int
		ignoreOff bool
		wave      SynthWave
		rate      float
		// The engine's sine table, `SYNTH_SINE` + 1 entries.
		sine      float[]

		// Increment per frame at the note's pitch: samples of the recording
		// for a sample, cycles for the other waves.
		baseStep     float
		// The increment with pitch bend and vibrato applied.
		step         float
		vibratoRate  float
		vibratoDepth float
		// Frames over which the vibrato grows to full depth.
		vibratoDelay int
		vibratoPhase float
		// Frames since the note started.
		age          int

		stage       SynthStage
		env         float
		stageLeft   int
		attackLen   int
		holdLen     int
		// Decay and release as log2 of the level's change per frame.
		decayRate   float
		sustainGain float
		releaseRate float

		// Velocity, attenuation and tone level as one gain.
		gain         float
		pan          float
		// Reverb send: `sendBase` plus `sendScale` times the channel's send.
		sendBase     float
		sendScale    float
		// Gains applied last and their change per frame across a block.
		currentLeft  float
		currentRight float
		currentSend  float
		stepLeft     float
		stepRight    float
		stepSend     float

		filterOn   bool
		cutoff     float
		filterQ    float
		filterEnv  float
		filterGain float
		b0         float
		b1         float
		b2         float
		a1         float
		a2         float
		x1         float
		x2         float
		y1         float
		y2         float

		// Sample playback, in indexes of `data`.
		data      int16[]
		start     int
		end       int
		loopStart int
		loopEnd   int
		loopMode  SoundFontLoop
		position  float

		// Oscillators: phases in cycles, the second oscillator's pitch ratio.
		phase       float
		phase2      float
		detuneRatio float
		dual        bool
		// One cycle of what the partials read: the sine, or a tone's
		// precomputed mix of steady harmonics.
		waveTable   float[]
		ratios      float[]
		levels      float[]
		multipliers float[]
		phases      float[]
		partials    int

		// Plucked string delay line.
		line float[]
		head int
		loss float
		last float

		// Drum parts: levels and their per-frame factors.
		tone        float
		toneMul     float
		excess      float
		excessMul   float
		noise       float
		noiseMul    float
		noiseStart  float
		burstsLeft  int
		burstGap    int
		burstCount  int
		metal       float
		metalMul    float
		metalPhases float[]
		metalSteps  float[]
		bandOn      bool
		bandMode    int
		bandK       float
		bandA1      float
		bandA2      float
		bandA3      float
		band1       float
		band2       float
		seed        int

		// The generator's output for the current block.
		mono float[]

		// A free voice rendering at `rate` with the engine's sine table.
		def new(rate float, sine float[]) {
			self.rate = rate
			self.sine = sine
			mono.len(SYNTH_BLOCK)
			metalPhases.len(6)
			metalSteps.len(6)
			stage = SynthStage.Done
		}

		// Clears what every note sets, for a note on `channel`.
		def prepare(channel int, key int, velocity int, serial int) {
			active = true
			self.channel = channel
			self.key = key
			self.velocity = velocity
			self.serial = serial
			released = false
			held = false
			killed = false
			exclusive = 0
			ignoreOff = false
			age = 0
			vibratoRate = 5.5
			vibratoDepth = 0.0
			vibratoDelay = 0
			vibratoPhase = 0.0
			env = 0.0
			currentLeft = 0.0
			currentRight = 0.0
			currentSend = 0.0
			stepLeft = 0.0
			stepRight = 0.0
			stepSend = 0.0
			filterOn = false
			filterEnv = 0.0
			filterGain = 1.0
			x1 = 0.0
			x2 = 0.0
			y1 = 0.0
			y2 = 0.0
			phase = 0.0
			phase2 = 0.0
			dual = false
			partials = 0
			tone = 0.0
			noise = 0.0
			metal = 0.0
			excess = 0.0
			burstsLeft = 0
			bandOn = false
			band1 = 0.0
			band2 = 0.0
			seed = (serial * 7919 + key * 131 + channel * 17 + 1) & 0x7FFFFFFF
			pan = 0.0
			sendBase = 0.0
			sendScale = 1.0
		}

		// Sets the volume envelope: times in seconds, `sustain` as attenuation
		// in dB (96 and above is silence, so the note fades out in its decay).
		def envelope(delay float, attack float, hold float, decay float, sustain float, release float) {
			stage = SynthStage.Delay
			stageLeft = int(delay.max(0.0) * rate)
			attackLen = int(attack.max(0.0) * rate).max(1)
			holdLen = int(hold.max(0.0) * rate)
			decayRate = -96.0 * 0.16609640474436813 / (decay.max(0.001) * rate)
			sustainGain = sustain >= 96.0 ?? (0.0, synthGain(-sustain.max(0.0)))
			releaseRate = -96.0 * 0.16609640474436813 / (release.max(0.005) * rate)
		}

		// Starts a built-in tone for `key` at `velocity` (1 to 127).
		def startTone(tone SynthTone, channel int, key int, velocity int, serial int) {
			prepare(channel, key, velocity, serial)
			wave = tone.wave
			let v = float(velocity) / 127.0
			let hz = tone.toneHz > 0.0 ?? (tone.toneHz, synthKeyHz(float(key)))
			baseStep = hz / rate
			step = baseStep
			gain = v * v * tone.level
			pan = tone.pan
			exclusive = tone.exclusive
			ignoreOff = tone.ignoreOff
			sendScale = tone.reverb
			vibratoRate = tone.vibratoRate
			vibratoDepth = tone.vibratoDepth
			vibratoDelay = int(tone.vibratoDelay * rate)
			let fadeScale = synthExp2(-(float(key) - 60.0) / 12.0 * tone.fadeKeys)
			envelope(0.0, tone.attack, tone.hold, tone.decay * fadeScale, tone.sustain, tone.release)
			filter(hz * tone.cutoff.max(0.5), tone.minCutoff, tone.resonance, tone.filterEnv * (0.35 + 0.65 * v)) when tone.cutoff > 0.0
			waveTable = sine
			if wave == SynthWave.Partials && tone.tables.len() > 0 {
				let fundamental = hz * tone.tableRatio * 1.2
				let octave = 0
				for octave < tone.tables.len() - 1 && 20.0 * synthExp2(float(octave)) < fundamental {
					octave += 1
				}
				waveTable = tone.tables[octave]
				partials = 1
				ratios.len(1) when ratios.len() < 1
				levels.len(1) when levels.len() < 1
				multipliers.len(1) when multipliers.len() < 1
				phases.len(1) when phases.len() < 1
				ratios[0] = tone.tableRatio
				levels[0] = 1.0
				multipliers[0] = 1.0
				phases[0] = 0.0
			} else if wave == SynthWave.Partials {
				let bright = 0.55 + 0.45 * v
				let total = 0.0
				for let (_, level) in tone.levels {
					total += level
				}
				let colour = 1.0
				partials = tone.ratios.len()
				ratios.len(partials) when ratios.len() < partials
				levels.len(partials) when levels.len() < partials
				multipliers.len(partials) when multipliers.len() < partials
				phases.len(partials) when phases.len() < partials
				for let k = 0; k < partials; k++ {
					ratios[k] = tone.ratios[k]
					levels[k] = tone.levels[k] * colour / total.max(1.0)
					let fade = k < tone.fades.len() ?? (tone.fades[k], 0.0)
					multipliers[k] = synthFade(60.0, fade * fadeScale, rate)
					phases[k] = 0.0
					colour *= bright
				}
			} else if wave == SynthWave.Saw || wave == SynthWave.Square {
				dual = tone.detune != 0.0
				detuneRatio = synthRatio(tone.detune)
				phase2 = 0.37
			} else if wave == SynthWave.Pluck {
				pluck(hz, tone.pluckFade, tone.brightness * (0.5 + 0.5 * v))
			} else if wave == SynthWave.Drum {
				self.tone = tone.tone
				toneMul = synthFade(60.0, tone.toneFade, rate)
				excess = tone.sweep
				excessMul = tone.sweepTime > 0.0 ?? (synthExp2(-1.4426950408889634 / (tone.sweepTime * rate)), 0.0)
				noise = tone.noise
				noiseStart = tone.noise
				noiseMul = synthFade(60.0, tone.noiseFade, rate)
				burstsLeft = tone.bursts - 1
				burstGap = int(tone.burstGap * rate).max(1)
				burstCount = burstGap
				metal = tone.metal
				metalMul = synthFade(60.0, tone.metalFade, rate)
				for let (k, hertz) in SYNTH_METAL {
					metalSteps[k] = hertz * tone.metalHz / rate
					metalPhases[k] = 0.0
				}
				band(tone.band, tone.bandMode, tone.bandQ) when tone.band > 0.0
			}
		}

		// Starts a SoundFont sample for `key` at `velocity` (1 to 127).
		def startSample(part SoundFontVoice, channel int, key int, velocity int, serial int) {
			prepare(channel, key, velocity, serial)
			wave = SynthWave.Sample
			data = part.data
			let size = data.len()
			start = part.start.clamp(0, size)
			end = part.end.clamp(start, size)
			loopStart = part.loopStart.clamp(start, end)
			loopEnd = part.loopEnd.clamp(loopStart, end)
			loopMode = part.loop
			loopMode = SoundFontLoop.None when loopEnd - loopStart < 2
			position = float(start)
			let cents = float(part.scaleTuning) * float(key - part.rootKey) + float(part.tune)
			baseStep = float(part.sampleRate.max(1)) / rate * synthRatio(cents)
			step = baseStep
			let v = float(velocity) / 127.0
			gain = v * v * synthGain(-part.attenuation.max(0.0))
			pan = part.pan.clamp(-1.0, 1.0)
			sendBase = part.reverb.clamp(0.0, 1.0)
			sendScale = 0.2
			exclusive = part.exclusiveClass
			vibratoRate = part.vibratoRate > 0.0 ?? (part.vibratoRate, 5.5)
			vibratoDepth = part.vibratoDepth
			envelope(part.delay, part.attack, part.hold, part.decay, part.sustain, part.release)
			filter(part.filterCutoff, 20.0, part.filterQ, 0.0) when part.filterCutoff > 0.0 && part.filterCutoff < 20000.0
			stage = SynthStage.Done when end - start < 2
		}

		// Turns the low-pass on at `cutoff` Hz (at least `lowest`), with
		// `resonance` dB of peak and `sweep` octaves of envelope opening.
		def filter(cutoff float, lowest float, resonance float, sweep float) {
			self.cutoff = cutoff.max(lowest)
			filterQ = synthGain(resonance.max(0.0)).max(0.7071)
			filterGain = 1.0 / filterQ.max(1.0)
			filterEnv = sweep
			return when sweep == 0.0 && self.cutoff >= 0.45 * rate
			filterOn = true
			coefficients(self.cutoff)
		}

		// The low-pass coefficients for a cutoff of `hz`: the cookbook design
		// `std.media.dsp` filters with, the feed-forward side scaled by
		// `filterGain` so resonance does not raise the level.
		def coefficients(hz float) {
			let c = design(FilterKind.LowPass, hz.clamp(20.0, 0.45 * rate), filterQ, 0.0, int(rate))
			b0 = c.b0 * filterGain
			b1 = c.b1 * filterGain
			b2 = c.b2 * filterGain
			a1 = c.a1
			a2 = c.a2
		}

		// Sets the drum filter: a state-variable filter at `hz`, mode 0
		// high-pass, 1 band-pass, 2 low-pass.
		def band(hz float, mode int, q float) {
			let fc = hz.clamp(20.0, 0.45 * rate)
			let w = 3.141592653589793 * fc / rate
			let g = synthSin(w) / synthCos(w)
			bandK = 1.0 / q.max(0.1)
			bandA1 = 1.0 / (1.0 + g * (g + bandK))
			bandA2 = g * bandA1
			bandA3 = g * bandA2
			bandMode = mode
			bandOn = true
		}

		// Loads the string for a pluck at `hz`: a burst of noise, darker at
		// low `brightness`, losing 60 dB over `fade` seconds.
		def pluck(hz float, fade float, brightness float) {
			let capacity = int(rate / 20.0) + 4
			line.len(capacity) when line.len() < capacity
			let size = line.len()
			let smooth = 0.08 + 0.9 * brightness.clamp(0.0, 1.0)
			let value = 0.0
			let mean = 0.0
			for let j = 0; j < size; j++ {
				value += smooth * (random() - value)
				line[j] = value
				mean += value
			}
			mean /= float(size)
			let peak = 0.0
			for let j = 0; j < size; j++ {
				line[j] -= mean
				peak = peak.max(line[j].abs())
			}
			let scale = peak > 0.0 ?? (1.0 / peak, 1.0)
			for let j = 0; j < size; j++ {
				line[j] *= scale
			}
			head = 0
			last = 0.0
			loss = synthGain(-60.0 / (fade.max(0.05) * hz))
		}

		// A uniform value in -1..1 from the voice's own generator.
		def random() float {
			seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF
			return float(seed) / 1073741823.5 - 1.0
		}

		// Ends the note: the envelope releases, and a sample that loops until
		// release plays on to its end.
		def release() {
			return when stage == SynthStage.Done
			released = true
			held = false
			stage = SynthStage.Release
		}

		// Cuts the note off within a few milliseconds.
		def kill() {
			return when stage == SynthStage.Done
			release()
			killed = true
			releaseRate = releaseRate.min(-96.0 * 0.16609640474436813 / (0.006 * rate))
		}

		// Prepares the next `frames` frames (at most `SYNTH_BLOCK`): advances
		// the envelope over them, recomputes pitch with bend and vibrato and
		// the filter's opening, and sets the gains to ramp toward the
		// channel's level, pan and send times the envelope. A voice whose
		// envelope ended in the frames before is freed instead.
		def control(channel SynthChannel, frames int) {
			if stage == SynthStage.Done {
				active = false
				return
			}
			advance(frames)
			let depth = vibratoDepth
			depth *= float(age) / float(vibratoDelay) when vibratoDelay > 0 && age < vibratoDelay
			depth += channel.modulationCents()
			let cents = channel.bendCents()
			if depth > 0.0 {
				cents += depth * sineAt(vibratoPhase)
				vibratoPhase += vibratoRate * float(frames) / rate
				vibratoPhase -= vibratoPhase.floor()
			}
			step = cents == 0.0 ?? (baseStep, baseStep * synthRatio(cents))
			coefficients(cutoff * synthExp2(filterEnv * env)) when filterOn && filterEnv != 0.0
			let place = (pan + channel.panPosition()).clamp(-1.0, 1.0)
			let level = gain * channel.level() * env
			let targetLeft = level * sineAt((place + 1.0) / 8.0 + 0.25)
			let targetRight = level * sineAt((place + 1.0) / 8.0)
			let targetSend = level * (sendBase + sendScale * channel.reverbSend()).clamp(0.0, 1.0)
			let span = float(frames.max(1))
			stepLeft = (targetLeft - currentLeft) / span
			stepRight = (targetRight - currentRight) / span
			stepSend = (targetSend - currentSend) / span
		}

		// Moves the envelope `frames` frames on through its stages: linear in
		// level while attacking, linear in dB while decaying and releasing.
		def advance(frames int) {
			let left = frames
			for left > 0 && stage != SynthStage.Done {
				if stage == SynthStage.Delay || stage == SynthStage.Attack || stage == SynthStage.Hold {
					let m = stageLeft.min(left)
					env = (env + float(m) / float(attackLen)).min(1.0) when stage == SynthStage.Attack
					stageLeft -= m
					left -= m
					if stageLeft <= 0 {
						if stage == SynthStage.Delay {
							stage = SynthStage.Attack
							stageLeft = attackLen
						} else if stage == SynthStage.Attack {
							env = 1.0
							stage = SynthStage.Hold
							stageLeft = holdLen
						} else {
							stage = SynthStage.Decay
						}
					}
				} else if stage == SynthStage.Decay {
					env *= synthExp2(decayRate * float(left))
					left = 0
					if env <= sustainGain || env < SYNTH_SILENT {
						env = sustainGain
						stage = sustainGain < SYNTH_SILENT ?? (SynthStage.Done, SynthStage.Sustain)
					}
				} else if stage == SynthStage.Release {
					env *= synthExp2(releaseRate * float(left))
					left = 0
					stage = SynthStage.Done when env < SYNTH_SILENT
				} else {
					left = 0
				}
			}
			env = 0.0 when stage == SynthStage.Done
		}

		// The shared sine at `cycle` (in cycles, 0 to 1).
		def sineAt(cycle float) float {
			let x = (cycle - cycle.floor()) * float(SYNTH_SINE)
			let i = int(x)
			let f = x - float(i)
			return sine[i] + (sine[i + 1] - sine[i]) * f
		}

		// Adds the next `count` frames (at most `SYNTH_BLOCK`) of the voice,
		// through its filter and at the ramping gains, to the left, right and
		// reverb-send buses.
		def render(count int, left float[], right float[], send float[]) {
			if wave == SynthWave.Sample {
				renderSample(count)
			} else if wave == SynthWave.Partials {
				renderPartials(count)
			} else if wave == SynthWave.Pluck {
				renderPluck(count)
			} else if wave == SynthWave.Drum {
				renderDrum(count)
			} else if wave == SynthWave.Square {
				renderSquare(count)
			} else {
				renderSaw(count)
			}
			let out = mono
			let l = currentLeft
			let r = currentRight
			let s = currentSend
			let dl = stepLeft
			let dr = stepRight
			let ds = stepSend
			if filterOn {
				let (c0, c1, c2, d1, d2) = (b0, b1, b2, a1, a2)
				let (in1, in2, out1, out2) = (x1, x2, y1, y2)
				for let i = 0; i < count; i++ {
					let x = out[i]
					let v = c0 * x + c1 * in1 + c2 * in2 - d1 * out1 - d2 * out2
					in2 = in1
					in1 = x
					out2 = out1
					out1 = v
					left[i] += v * l
					right[i] += v * r
					send[i] += v * s
					l += dl
					r += dr
					s += ds
				}
				(x1, x2, y1, y2) = (in1, in2, out1, out2)
			} else {
				for let i = 0; i < count; i++ {
					let v = out[i]
					left[i] += v * l
					right[i] += v * r
					send[i] += v * s
					l += dl
					r += dr
					s += ds
				}
			}
			currentLeft = l
			currentRight = r
			currentSend = s
			age += count
		}

		// Resamples the SoundFont sample with 4-point cubic interpolation,
		// following its loop.
		def renderSample(count int) {
			let out = mono
			let d = data
			let pos = position
			let inc = step
			let looping = loopMode == SoundFontLoop.Continuous || (loopMode == SoundFontLoop.UntilRelease && !released)
			let first = start
			let limit = looping ?? (loopEnd, end)
			let span = float(loopEnd - loopStart)
			let top = looping ?? (float(loopEnd), float(end - 1))
			let scale = 1.0 / 32768.0
			let i = 0
			for i < count {
				let at = int(pos)
				let f = pos - float(at)
				let (p0, p1, p2, p3) = (0.0, 0.0, 0.0, 0.0)
				if at - 1 >= first && at + 2 < limit {
					p0 = float(d[at - 1])
					p1 = float(d[at])
					p2 = float(d[at + 1])
					p3 = float(d[at + 2])
				} else {
					p0 = point(at - 1, looping)
					p1 = point(at, looping)
					p2 = point(at + 1, looping)
					p3 = point(at + 2, looping)
				}
				let c1 = 0.5 * (p2 - p0)
				let c2 = p0 - 2.5 * p1 + 2.0 * p2 - 0.5 * p3
				let c3 = 0.5 * (p3 - p0) + 1.5 * (p1 - p2)
				out[i] = (((c3 * f + c2) * f + c1) * f + p1) * scale
				i += 1
				pos += inc
				if pos >= top {
					if looping {
						pos -= span
					} else {
						stage = SynthStage.Done
						break
					}
				}
			}
			for i < count {
				out[i] = 0.0
				i += 1
			}
			position = pos
		}

		// The sample value at `index`, wrapped into the loop when looping and
		// 0 outside the sample.
		def point(index int, looping bool) float {
			let at = index
			at -= loopEnd - loopStart when looping && at >= loopEnd
			return 0.0 when at < start || at >= end
			return float(data[at])
		}

		// Sums the partials, each fading at its own rate.
		def renderPartials(count int) {
			let out = mono
			let table = waveTable
			for let i = 0; i < count; i++ {
				out[i] = 0.0
			}
			let size = float(SYNTH_SINE)
			for let k = 0; k < partials; k++ {
				let level = levels[k]
				let inc = step * ratios[k]
				let ph = phases[k]
				if level < 0.000001 || inc >= 0.45 {
					ph += inc * float(count)
					phases[k] = ph - ph.floor()
					continue
				}
				let factor = multipliers[k]
				for let i = 0; i < count; i++ {
					let x = ph * size
					let j = int(x)
					let f = x - float(j)
					out[i] += (table[j] + (table[j + 1] - table[j]) * f) * level
					level *= factor
					ph += inc
					ph -= 1.0 when ph >= 1.0
				}
				levels[k] = level
				phases[k] = ph
			}
		}

		// Band-limited sawtooth (PolyBLEP), one or two detuned.
		def renderSaw(count int) {
			let out = mono
			let inc = step.min(0.45)
			let inc2 = (inc * detuneRatio).min(0.45)
			let two = dual
			let ph = phase
			let ph2 = phase2
			let mix = two ?? (0.5, 1.0)
			for let i = 0; i < count; i++ {
				let v = 2.0 * ph - 1.0
				if ph < inc {
					let x = ph / inc
					v -= x + x - x * x - 1.0
				} else if ph > 1.0 - inc {
					let x = (ph - 1.0) / inc
					v -= x * x + x + x + 1.0
				}
				ph += inc
				ph -= 1.0 when ph >= 1.0
				if two {
					v += 2.0 * ph2 - 1.0
					if ph2 < inc2 {
						let x = ph2 / inc2
						v -= x + x - x * x - 1.0
					} else if ph2 > 1.0 - inc2 {
						let x = (ph2 - 1.0) / inc2
						v -= x * x + x + x + 1.0
					}
					ph2 += inc2
					ph2 -= 1.0 when ph2 >= 1.0
				}
				out[i] = v * mix
			}
			phase = ph
			phase2 = ph2
		}

		// Band-limited square: a sawtooth minus itself half a cycle later,
		// one or two detuned.
		def renderSquare(count int) {
			let out = mono
			let inc = step.min(0.45)
			let inc2 = (inc * detuneRatio).min(0.45)
			let two = dual
			let ph = phase
			let ph2 = phase2
			let mix = two ?? (0.5, 1.0)
			for let i = 0; i < count; i++ {
				let v = 0.0
				let voices = two ?? (2, 1)
				for let o = 0; o < voices; o++ {
					let t = o == 0 ?? (ph, ph2)
					let dt = o == 0 ?? (inc, inc2)
					let u = t + 0.5
					u -= 1.0 when u >= 1.0
					let saw = t - u
					if t < dt {
						let x = t / dt
						saw -= 0.5 * (x + x - x * x - 1.0)
					} else if t > 1.0 - dt {
						let x = (t - 1.0) / dt
						saw -= 0.5 * (x * x + x + x + 1.0)
					}
					if u < dt {
						let x = u / dt
						saw += 0.5 * (x + x - x * x - 1.0)
					} else if u > 1.0 - dt {
						let x = (u - 1.0) / dt
						saw += 0.5 * (x * x + x + x + 1.0)
					}
					v += 2.0 * saw
				}
				ph += inc
				ph -= 1.0 when ph >= 1.0
				ph2 += inc2
				ph2 -= 1.0 when ph2 >= 1.0
				out[i] = v * mix
			}
			phase = ph
			phase2 = ph2
		}

		// Runs the string: each pass averages neighbours and loses a little,
		// so the tone darkens as it fades.
		def renderPluck(count int) {
			let out = mono
			let buffer = line
			let size = line.len()
			let delay = (1.0 / step.max(0.0001) - 0.5).clamp(1.0, float(size - 2))
			let at = head
			let prev = last
			let keep = loss * 0.5
			for let i = 0; i < count; i++ {
				let read = float(at) - delay
				read += float(size) when read < 0.0
				let i0 = int(read)
				let f = read - float(i0)
				let i1 = i0 + 1
				i1 = 0 when i1 >= size
				let y = buffer[i0] + (buffer[i1] - buffer[i0]) * f
				buffer[at] = keep * (y + prev)
				prev = y
				at += 1
				at = 0 when at >= size
				out[i] = y
			}
			head = at
			last = prev
		}

		// Sums the drum's sine, noise bursts and metallic cluster, the latter
		// two through the drum filter.
		def renderDrum(count int) {
			let out = mono
			let table = sine
			let size = float(SYNTH_SINE)
			for let i = 0; i < count; i++ {
				let v = 0.0
				if tone > 0.00001 {
					let x = phase * size
					let j = int(x)
					let f = x - float(j)
					v += (table[j] + (table[j + 1] - table[j]) * f) * tone
					phase += step * (1.0 + excess)
					phase -= phase.floor() when phase >= 1.0
					excess *= excessMul
					tone *= toneMul
				}
				let n = 0.0
				if noise > 0.00001 {
					seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF
					n = (float(seed) / 1073741823.5 - 1.0) * noise
					noise *= noiseMul
				}
				if burstsLeft > 0 {
					burstCount -= 1
					if burstCount <= 0 {
						noise = noiseStart
						burstsLeft -= 1
						burstCount = burstGap
					}
				}
				if metal > 0.00001 {
					let m = 0.0
					for let k = 0; k < 6; k++ {
						let p = metalPhases[k] + metalSteps[k]
						p -= 1.0 when p >= 1.0
						metalPhases[k] = p
						m += p < 0.5 ?? (1.0, -1.0)
					}
					n += m * metal / 6.0
					metal *= metalMul
				}
				if bandOn {
					let v3 = n - band2
					let v1 = bandA1 * band1 + bandA2 * v3
					let v2 = band2 + bandA2 * band1 + bandA3 * v3
					band1 = 2.0 * v1 - band1
					band2 = 2.0 * v2 - band2
					n = bandMode == 0 ?? (n - bandK * v1 - v2, bandMode == 1 ?? (v1 * bandK, v2))
				}
				out[i] = v + n
			}
		}
	}
}
