partial module std.mem {
	use std.simd

	// Runtime-backed memory helpers.
	//
	// Today this focuses on byte-wise operations needed by the graphics stack.
	// Higher-level, type-aware copies (ARC retain/release, etc.) will live above this.
	@c(symbol = "adm_mem_move", ret = "void", params = ["void*", "const void*", "size_t"])
	internal def __move(dst byte[], src byte[], n uint);

	@c(symbol = "adm_mem_move_at", ret = "void", params = ["void*", "size_t", "const void*", "size_t", "size_t"])
	internal def __moveAt(dst byte[], dstAt uint, src byte[], srcAt uint, n uint);

	@c(symbol = "adm_mem_copy", ret = "void", params = ["void*", "const void*", "size_t"])
	internal def __copy(dst byte[], src byte[], n uint);

	@c(symbol = "adm_mem_set", ret = "void", params = ["void*", "uint8_t", "size_t"])
	internal def __set(dst byte[], value byte, n uint);

	@c(symbol = "adm_mem_set32", ret = "void", params = ["void*", "uint32_t", "size_t"])
	internal def __set32(dst byte[], value uint32, count uint);

	// move copies `min(dst.len(), src.len())` bytes from `src` into `dst`.
	//
	// Unlike copy(), this is guaranteed to be safe even if `dst` and `src`
	// overlap (it maps to the runtime's `memmove`-equivalent).
	//
	// Returns the number of bytes copied.
	def move(dst byte[], src byte[]) int {
		let n = dst.len()
		n = src.len() when n > src.len()
		return 0 when n <= 0

		__move(dst, src, uint(n))
		return n
	}

	// copy copies `min(dst.len(), src.len())` bytes from `src` into `dst`.
	// Returns the number of bytes copied.
	def copy(dst byte[], src byte[]) int {
		return move(dst, src)
	}

	// copyN copies up to `n` bytes from `src` into `dst`.
	//
	// This uses the runtime's `memcpy`-equivalent and assumes the memory regions
	// do not overlap. Use moveN() if overlap is possible.
	//
	// Returns the number of bytes copied.
	def copyN(dst byte[], src byte[], n int) int {
		return 0 when n <= 0
		n = dst.len() when n > dst.len()
		n = src.len() when n > src.len()
		return 0 when n <= 0

		__copy(dst, src, uint(n))
		return n
	}

	// The length from which the runtime's copy takes less time than
	// vectors written here: below it the call costs more than the copy.
	internal const copyByRuntime = 256

	// copyN copies up to `n` bytes from `src` at `srcAt` into `dst` at
	// `dstAt`: as many as both arrays hold from there, none when an
	// offset is negative. No slice of either array is made. The regions
	// must not overlap: moveN() takes those that may.
	//
	// Returns the number of bytes copied.
	def copyN(dst byte[], dstAt int, src byte[], srcAt int, n int) int {
		return 0 when dstAt < 0 || srcAt < 0
		n = dst.len() - dstAt when n > dst.len() - dstAt
		n = src.len() - srcAt when n > src.len() - srcAt
		return 0 when n <= 0
		if n >= copyByRuntime {
			__moveAt(dst, uint(dstAt), src, uint(srcAt), uint(n))
			return n
		}
		// Whole vectors, then one that ends with the region and covers
		// what is left again.
		if n >= 32 {
			for let i = 0; i + 32 <= n; i += 32 {
				simd.store32<byte>(dst, dstAt + i, simd.load32<byte>(src, srcAt + i))
			}
			simd.store32<byte>(dst, dstAt + n - 32, simd.load32<byte>(src, srcAt + n - 32)) when (n & 31) != 0
		} else if n >= 16 {
			let head = simd.load16<byte>(src, srcAt)
			let tail = simd.load16<byte>(src, srcAt + n - 16)
			simd.store16<byte>(dst, dstAt, head)
			simd.store16<byte>(dst, dstAt + n - 16, tail)
		} else if n >= 8 {
			let head = simd.load8<byte>(src, srcAt)
			let tail = simd.load8<byte>(src, srcAt + n - 8)
			simd.store8<byte>(dst, dstAt, head)
			simd.store8<byte>(dst, dstAt + n - 8, tail)
		} else {
			for let i = 0; i < n; i++ {
				dst[dstAt + i] = src[srcAt + i]
			}
		}
		return n
	}

	// moveN copies up to `n` bytes from `src` into `dst` and is safe for overlap.
	//
	// Returns the number of bytes copied.
	def moveN(dst byte[], src byte[], n int) int {
		return 0 when n <= 0
		n = dst.len() when n > dst.len()
		n = src.len() when n > src.len()
		return 0 when n <= 0

		__move(dst, src, uint(n))
		return n
	}

	// moveN copies up to `n` bytes from `src` at `srcAt` into `dst` at
	// `dstAt`: as many as both arrays hold from there, none when an
	// offset is negative. No slice of either array is made. The regions
	// may overlap, in one array or in two that share their memory: the
	// bytes arrive as they were before the call.
	//
	// Returns the number of bytes copied.
	def moveN(dst byte[], dstAt int, src byte[], srcAt int, n int) int {
		return 0 when dstAt < 0 || srcAt < 0
		n = dst.len() - dstAt when n > dst.len() - dstAt
		n = src.len() - srcAt when n > src.len() - srcAt
		return 0 when n <= 0
		__moveAt(dst, uint(dstAt), src, uint(srcAt), uint(n))
		return n
	}

	// set fills `dst` with `value`.
	//
	// Returns the number of bytes written.
	def set(dst byte[], value byte) int {
		return setN(dst, value, dst.len())
	}

	// setN fills the first `n` bytes of `dst` with `value`.
	//
	// Returns the number of bytes written.
	def setN(dst byte[], value byte, n int) int {
		return 0 when n <= 0
		n = dst.len() when n > dst.len()
		return 0 when n <= 0

		__set(dst, value, uint(n))
		return n
	}

	// zero sets `dst` to all zeros.
	def zero(dst byte[]) int {
		return setN(dst, byte(0), dst.len())
	}

	// set32 fills `dst` with the repeating 32-bit pattern `value` (native-endian).
	//
	// This is intended for RGBA8-style pixel buffers where you want to fill
	// with a packed `uint32` color quickly.
	//
	// Returns the number of bytes written. If `dst.len()` is not a multiple of 4,
	// nothing is written and 0 is returned.
	def set32(dst byte[], value uint32) int {
		let n = dst.len()
		return 0 when n <= 0
		return 0 when (n % 4) != 0

		let count = uint(n / 4)
		__set32(dst, value, count)
		return n
	}
}
