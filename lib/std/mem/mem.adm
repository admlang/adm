partial module std.mem {
	// Runtime-backed memory helpers.
	//
	// Today this focuses on byte-wise operations needed by the graphics stack.
	// Higher-level, type-aware copies (ARC retain/release, etc.) will live above this.
	use std.interop

	@interop.c(symbol = "adm_mem_move", ret = "void", params = ["void*", "const void*", "size_t"])
	internal def __move(dst byte[], src byte[], n uint);

	@interop.c(symbol = "adm_mem_copy", ret = "void", params = ["void*", "const void*", "size_t"])
	internal def __copy(dst byte[], src byte[], n uint);

	@interop.c(symbol = "adm_mem_set", ret = "void", params = ["void*", "uint8_t", "size_t"])
	internal def __set(dst byte[], value byte, n uint);

	@interop.c(symbol = "adm_mem_set32", ret = "void", params = ["void*", "uint32_t", "size_t"])
	internal def __set32(dst byte[], value uint32, count uint);

	// move copies `min(dst.len(), src.len())` bytes from `src` into `dst`.
	//
	// Unlike copy(), this is guaranteed to be safe even if `dst` and `src`
	// overlap (it maps to the runtime's `memmove`-equivalent).
	//
	// Returns the number of bytes copied.
	def move(dst byte[], src byte[]) int {
		let n = dst.len()
		n = src.len() when n > src.len()
		return 0 when n <= 0

		__move(dst, src, uint(n))
		return n
	}

	// copy copies `min(dst.len(), src.len())` bytes from `src` into `dst`.
	// Returns the number of bytes copied.
	def copy(dst byte[], src byte[]) int {
		return move(dst, src)
	}

	// copyN copies up to `n` bytes from `src` into `dst`.
	//
	// This uses the runtime's `memcpy`-equivalent and assumes the memory regions
	// do not overlap. Use moveN() if overlap is possible.
	//
	// Returns the number of bytes copied.
	def copyN(dst byte[], src byte[], n int) int {
		return 0 when n <= 0
		n = dst.len() when n > dst.len()
		n = src.len() when n > src.len()
		return 0 when n <= 0

		__copy(dst, src, uint(n))
		return n
	}

	// moveN copies up to `n` bytes from `src` into `dst` and is safe for overlap.
	//
	// Returns the number of bytes copied.
	def moveN(dst byte[], src byte[], n int) int {
		return 0 when n <= 0
		n = dst.len() when n > dst.len()
		n = src.len() when n > src.len()
		return 0 when n <= 0

		__move(dst, src, uint(n))
		return n
	}

	// set fills `dst` with `value`.
	//
	// Returns the number of bytes written.
	def set(dst byte[], value byte) int {
		return setN(dst, value, dst.len())
	}

	// setN fills the first `n` bytes of `dst` with `value`.
	//
	// Returns the number of bytes written.
	def setN(dst byte[], value byte, n int) int {
		return 0 when n <= 0
		n = dst.len() when n > dst.len()
		return 0 when n <= 0

		__set(dst, value, uint(n))
		return n
	}

	// zero sets `dst` to all zeros.
	def zero(dst byte[]) int {
		return setN(dst, byte(0), dst.len())
	}

	// set32 fills `dst` with the repeating 32-bit pattern `value` (native-endian).
	//
	// This is intended for RGBA8-style pixel buffers where you want to fill
	// with a packed `uint32` color quickly.
	//
	// Returns the number of bytes written. If `dst.len()` is not a multiple of 4,
	// nothing is written and 0 is returned.
	def set32(dst byte[], value uint32) int {
		let n = dst.len()
		return 0 when n <= 0
		return 0 when (n % 4) != 0

		let count = uint(n / 4)
		__set32(dst, value, count)
		return n
	}
}
