partial module std.mem {
	use std.testing

	check "Copies between offsets" {
		// Every length around the vector sizes, at offsets that are no
		// multiple of them: the bytes arrive, their neighbours stay.
		@test()
		def copyN_between_offsets_copies_exactly_the_region() {
			let src byte[]
			src.len(1200)
			for let i = 0; i < src.len(); i++ {
				src[i] = byte(i * 7 + 3)
			}
			for let k = 0; k <= 134; k++ {
				// The lengths past 130 are those around the one from
				// which the runtime copies.
				let n = k <= 130 ?? (k, [255, 256, 257, 1000][k - 131])
				for let place in [[0, 0], [3, 5], [17, 1], [40, 99]] {
					let dst byte[]
					dst.len(1200)
					dst.fill(byte(0xAA))
					assert copyN(dst, place[0], src, place[1], n) == n
					for let i = 0; i < dst.len(); i++ {
						let inside = i >= place[0] && i < place[0] + n
						assert dst[i] == (inside ?? (src[place[1] + i - place[0]], byte(0xAA)))
					}
				}
			}
		}

		// What does not fit is not copied: the count is what both arrays
		// hold from their offsets, none for an offset below zero or past
		// the end.
		@test()
		def copyN_between_offsets_clamps_to_both_arrays() {
			let src byte[]
			src.len(50)
			src.fill(byte(9))
			let dst byte[]
			dst.len(40)
			assert copyN(dst, 30, src, 0, 100) == 10
			assert dst[29] == byte(0) && dst[30] == byte(9) && dst[39] == byte(9)
			assert copyN(dst, 0, src, 45, 100) == 5
			assert dst[4] == byte(9) && dst[5] == byte(0)
			assert copyN(dst, 40, src, 0, 8) == 0
			assert copyN(dst, 0, src, 50, 8) == 0
			assert copyN(dst, -1, src, 0, 8) == 0
			assert copyN(dst, 0, src, -1, 8) == 0
			assert copyN(dst, 0, src, 0, 0) == 0
			assert copyN(dst, 0, src, 0, -3) == 0
		}

		// A region moved inside its array, towards the end and towards
		// the start, by less and by more than its length, at the lengths
		// around the vector sizes: the bytes arrive as they were, the
		// others stay.
		@test()
		def moveN_between_offsets_takes_overlapping_regions() {
			for let n in [0, 1, 7, 8, 15, 16, 31, 32, 33, 64, 100] {
				for let shift in [-70, -33, -16, -3, -1, 0, 1, 3, 16, 33, 70] {
					let from = 80
					let data byte[]
					data.len(300)
					for let i = 0; i < data.len(); i++ {
						data[i] = byte(i * 5 + 1)
					}
					assert moveN(data, from + shift, data, from, n) == n
					for let i = 0; i < data.len(); i++ {
						let inside = i >= from + shift && i < from + shift + n
						let source = inside ?? (i - shift, i)
						assert data[i] == byte(source * 5 + 1)
					}
				}
			}
		}

		// Two slices of one array share its memory: a move between them
		// is a move inside it.
		@test()
		def moveN_between_slices_of_one_array_takes_their_overlap() {
			for let forward in [true, false] {
				let data byte[]
				data.len(200)
				for let i = 0; i < data.len(); i++ {
					data[i] = byte(i + 1)
				}
				let low = data[10:150]
				let high = data[30:170]
				if forward {
					assert moveN(high, 5, low, 5, 120) == 120
				} else {
					assert moveN(low, 5, high, 5, 120) == 120
				}
				let to = forward ?? (35, 15)
				let shift = forward ?? (20, -20)
				for let i = 0; i < data.len(); i++ {
					let inside = i >= to && i < to + 120
					assert data[i] == byte((inside ?? (i - shift, i)) + 1)
				}
			}
		}

		// The count is clamped as copyN clamps it.
		@test()
		def moveN_between_offsets_clamps_to_both_arrays() {
			let src byte[]
			src.len(50)
			src.fill(byte(9))
			let dst byte[]
			dst.len(40)
			assert moveN(dst, 30, src, 0, 100) == 10
			assert dst[29] == byte(0) && dst[30] == byte(9) && dst[39] == byte(9)
			assert moveN(dst, 0, src, 45, 100) == 5
			assert dst[4] == byte(9) && dst[5] == byte(0)
			assert moveN(dst, 40, src, 0, 8) == 0
			assert moveN(dst, 0, src, 50, 8) == 0
			assert moveN(dst, -1, src, 0, 8) == 0
			assert moveN(dst, 0, src, -1, 8) == 0
			assert moveN(dst, 0, src, 0, 0) == 0
			assert moveN(dst, 0, src, 0, -3) == 0
		}
	}
}
