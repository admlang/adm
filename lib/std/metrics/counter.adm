partial module std.metrics {
	// A counter is a cumulative metric that represents a single numerical value that only ever goes up.
	// It is reset to zero only when the process restarts.
	// Example: http.requests.total, log.lines.written
	type Counter {
		internal atomic val uint64

		def kind() string {
			return "counter"
		}

		// Update increments the counter by the given value (must be non-negative).
		def update(value float64) {
			return when value < 0
			val += uint64(value)
		}

		// Inc increments the counter by 1.
		def inc() {
			val += 1
		}

		def value() uint64 {
			return val
		}

		def str() string {
			return sprintf("Metric[%s](%lu)", kind(), val)
		}
	}
}
