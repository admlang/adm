partial module std.metrics {
	// A gauge is the simplest metric type. It represents a single numerical value that can arbitrarily go up and down.
	// Used for measuring values that are a snapshot in time for example
	// memory.usage.total, cpu.load.average, queue.size
	type Gauge {
		internal atomic val float64

		def kind() string {
			return "gauge"
		}

		// Update sets the value of the gauge to the given value.
		def update(value float64) {
			val = value
		}

		// Set adds the given value to the current value of the gauge.
		// A negative value will subtract from the current value.
		def set(value float64) {
			val = val + value
		}

		// Inc increments the value of the gauge by 1
		def inc() {
			val++
		}

		// Dec decrements the value of the gauge by 1
		def dec() {
			val--
		}

		// Value returns the current value of the gauge
		def value() float64 {
			return val
		}

		def str() string {
			return sprintf("Metric[%s](%f)", kind(), val)
		}
	}
}
