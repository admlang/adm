partial module std.metrics {
	use std.math

	// HistogramStats summarises the samples a histogram holds: how many, the
	// smallest and largest, the mean and the percentiles it reports.
	struct HistogramStats {
		count int
		min   float64
		max   float64
		mean  float64
		p50   float64
		p90   float64
		p99   float64
	}

	// How the values of a histogram fall into ranges. Counts of one metric add up across
	// readings and across machines, which percentiles do not.
	struct Distribution {
		// The upper bound of each range but the last, ascending: with `[10, 50]` the ranges
		// are up to 10, above 10 up to 50, and above 50.
		bounds float64[]
		// How many values fell in each range: one more entry than `bounds`.
		counts uint64[]
		// The sum of every value.
		sum    float64
		// How many values there were.
		count  uint64
	}

	// Ranges per doubling of the value: each range ends about 19% above where it starts.
	internal const rangesPerDoubling = 4

	// The exponent of the smallest value with a range of its own, 2^-32; smaller values,
	// zero and negatives share the first range.
	internal const lowestExponent = -32

	// How many ranges a histogram counts in: up to 2^64, one more for everything above.
	internal const rangeCount = 386

	// A histogram samples observations (usually things like request durations or response sizes)
	// and aggregates them in a statistical distribution.
	// Example: http.request.duration_seconds, file.size.bytes, database.query.latency_ms
	// It's stored as a sliding window of the last N samples
	type Histogram {
		internal atomic samples float64[]
		internal capacity       int
		internal atomic cursor  int
		// How many values fell in each range since the histogram was made, with their sum
		// and number: what `distribution` reports.
		internal ranges         uint64[]
		internal total          float64
		internal seen           uint64

		def new(capacity int = 100) {
			let cap = capacity
			cap = 100 when cap <= 0
			self.capacity = cap
			self.samples = float64[]
			self.samples.cap(cap)
		}

		// kind names the metric type: histogram.
		def kind() string {
			return "histogram"
		}

		// Update increments the counter by the given value (must be non-negative).
		atomic def update(value float64) {
			if samples.len() < capacity {
				samples.push(value)
			} else {
				samples[cursor] = value
				cursor = (cursor + 1) % capacity
			}
			ranges.len(rangeCount) when ranges.len() == 0
			ranges[rangeOf(value)]++
			total += value
			seen++
		}

		// The range a value is counted in.
		internal def rangeOf(value float64) int {
			return 0 unless value > 0.0
			let at = int((math.log2(float(value)) * float(rangesPerDoubling)).ceil()) - lowestExponent * rangesPerDoubling
			return 0 when at < 0
			return rangeCount - 1 when at >= rangeCount
			return at
		}

		// distribution returns how every value since the histogram was made falls into
		// ranges, each ending about 19% above where it starts; only the ranges between
		// the smallest and the largest value are listed. An empty histogram yields an
		// empty distribution.
		atomic def distribution() Distribution {
			let first = -1
			let last = -1
			for let (at, held) in ranges {
				continue when held == 0
				first = at when first < 0
				last = at
			}
			return Distribution{} when first < 0
			let result = Distribution{sum: total, count: seen}
			for let at = first; at <= last; at++ {
				result.counts.push(ranges[at])
				result.bounds.push(float64(2.0 ** (float(at + lowestExponent * rangesPerDoubling) / float(rangesPerDoubling)))) when at < last
			}
			return result
		}

		// The newest sample, none while there is none.
		atomic def last() ?float64 {
			return none when samples.len() == 0
			return samples[-1] when samples.len() < capacity
			return samples[(cursor + capacity - 1) % capacity]
		}

		// value computes the statistics of the samples held so far; an empty
		// histogram yields zeroed statistics.
		atomic def value() HistogramStats {
			let count = samples.len()
			return HistogramStats{} when count == 0

			let sortedSamples = samples.clone().sort((a, b) => a < b)

			let stats = HistogramStats{
				count: count,
				min:   sortedSamples[0],
				max:   sortedSamples[-1]
			}

			let sum float64
			for let (_, v) in sortedSamples {
				sum += v
			}

			stats.mean = sum / float64(count)
			stats.p50 = percentile(sortedSamples, 50)
			stats.p90 = percentile(sortedSamples, 90)
			stats.p99 = percentile(sortedSamples, 99)

			return stats
		}

		// percentile returns the value at percentile p (0 to 100) of samples already
		// sorted ascending, 0 when there are none.
		def percentile(sortedSamples float64[], p float64) float64 {
			let count = sortedSamples.len()
			return 0.0 when count == 0
			let index = int(float64(count) * (p / 100.0))
			index = count - 1 when index >= count
			return sortedSamples[index]
		}

		// str renders the metric as Metric[histogram].
		def str() string {
			return sprintf("Metric[%s]", kind())
		}
	}
}
