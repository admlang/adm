partial module std.metrics {
	use std.testing

	check "Histogram" {
		// The newest sample, before and after the window wraps around.
		@test()
		def TestLastIsTheNewestSample() {
			let held = new Histogram(3)
			assert held.last() is none
			held.update(1)
			held.update(2)
			let second = held.last()
			assert !(second is none) && second == 2.0
			held.update(3)
			held.update(4)
			let wrapped = held.last()
			assert !(wrapped is none) && wrapped == 4.0
			held.update(5)
			let again = held.last()
			assert !(again is none) && again == 5.0
			assert held.value().count == 3
		}
	}
}
