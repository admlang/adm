partial module std.metrics {
	// A toggle keeps a boolean value
	type Toggle {
		internal atomic val bool

		// kind names the metric type: toggle.
		def kind() string {
			return "toggle"
		}

		// update switches the toggle on or off.
		def update(value bool) {
			val = value
		}

		// value returns whether the toggle is on.
		def value() bool {
			return val
		}

		// str renders the metric as Metric[toggle](TRUE) or Metric[toggle](FALSE).
		def str() string {
			return sprintf("Metric[%s](%s)", kind(), val ?? ("TRUE", "FALSE"))
		}
	}
}
