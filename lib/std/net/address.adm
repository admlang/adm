partial module std.net {
	// URI is a parsed uniform resource identifier: scheme, user and password,
	// host and port, path, query and fragment. Encoding and decoding are not
	// implemented yet.
	type URI {
		scheme   string
		user     string
		password string
		host     string
		port     int
		path     string
		query    map<string, string>
		fragment string

		// encode renders the URI as text. Not implemented yet: returns an empty
		// string.
		def encode() string {
			return ""
		}

		// decode sets the URI from its text form. Not implemented yet: accepts
		// anything and changes nothing.
		// It cannot fail yet.
		def decode(val string) !none {
			return none
		}

		// json renders the URI for JSON. Not implemented yet: returns no bytes.
		def json() byte[] {
			return []
		}

		// json sets the URI from JSON. Not implemented yet: accepts anything and
		// changes nothing.
		// It cannot fail yet.
		def json(data byte[]) !none {
			return none
		}

		// str renders the URI as text, the same as encode.
		def str() string {
			return encode()
		}
	}

	// Address is a network endpoint: a host and port for IPv4 or IPv6, or a path
	// for a Unix socket, kept with the text it was parsed from.
	type Address {
		raw    string
		host   string
		port   int
		path   string
		isIPv6 bool
		isUnix bool

		// parse fills the address from text: host:port, [host]:port for IPv6, or a
		// Unix socket path. Fails when the text is none of these.
		def parse(val string) !none {
			raw = val
			host = ""
			port = 0
			path = ""
			isIPv6 = false
			isUnix = false

			fail "empty address" when val.len() == 0

			if val.startsWith("/") {
				isUnix = true
				path = val
				return none
			}

			// IPv6 must be bracketed: [::1]:8080
			if val.startsWith("[") {
				let close = val.indexOf("]")
				assert close > 0 onerror fail "invalid IPv6 address"
				assert close + 1 < val.len() onerror fail "invalid IPv6 address"
				assert val[close + 1] == ':' onerror fail "invalid IPv6 address"
				host = val[1:close]
				let portStr = val[close + 2:]
				port = parseInt<int>(portStr, 10)
				isIPv6 = true
				return none
			}

			// IPv4 / hostname: host:port (host may be empty for bind)
			let colon = -1
			for let i = val.len() - 1; i >= 0; i-- {
				if val[i] == ':' {
					colon = i
					break
				}
			}
			assert colon >= 0 onerror fail "expected host:port"
			host = val[:colon]
			let portStr = val[colon + 1:]
			port = parseInt<int>(portStr, 10)
			return none
		}

		// str renders the address the way parse reads it: the path for a Unix socket,
		// [host]:port for IPv6, host:port otherwise.
		def str() string {
			return path when isUnix
			return "[{host}]:{port}" when isIPv6
			return "{host}:{port}"
		}
	}

	// parseAddress returns a new Address parsed from text. Fails when the text is
	// not an address.
	def parseAddress(val string) !Address {
		let addr = new Address()
		try addr.parse(val)
		return addr
	}
}
