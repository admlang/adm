partial module std.net {
	use std.services::(Network)

	// Stream is what a Connection and a TLS connection over it have in
	// common: reads and writes with a timeout, close, and whether it is
	// still open. HTTP and other protocols run over a Stream so the same
	// code serves plain and TLS connections.
	interface Stream {
		def read(data byte[], timeout duration) !int
		def write(data byte[], timeout duration) !int
		def close() !none
		def isOpen() bool
	}

	// Connection is an open stream socket, TCP or Unix: reads and writes with
	// timeouts, half or full shutdown, the peer and local addresses, and close.
	type Connection {
		internal fd int

		def new(fd int) {
			self.fd = fd
		}

		// read reads up to data.len() bytes into data and returns the count; 0
		// means the peer closed its side. Fails with NetError when the
		// connection is closed here (Closed), the read times out (TimedOut) or
		// the peer resets it (ConnReset).
		def read(data byte[], timeout duration) !int {
			fail errorOf(ErrorCode.Closed, "read", "", "connection is closed") when fd < 0
			return Network.read(fd, data, timeout) onerror (err error) {fail netError("read", "", err)}
		}

		// read with the default 30s timeout. Implements std.io.Reader.
		def read(data byte[]) !int {
			return read(data, 30s)
		}

		// write writes up to data.len() bytes from data and returns the count.
		// Fails with NetError when the connection is closed here (Closed), the
		// write times out (TimedOut) or the peer has gone (Pipe, ConnReset).
		def write(data byte[], timeout duration) !int {
			fail errorOf(ErrorCode.Closed, "write", "", "connection is closed") when fd < 0
			return Network.write(fd, data, timeout) onerror (err error) {fail netError("write", "", err)}
		}

		// write with the default 30s timeout. Implements std.io.Writer.
		def write(data byte[]) !int {
			return write(data, 30s)
		}

		// writeAll writes all bytes from data, retrying partial writes until the
		// full buffer is written. Fails as write does, and with Pipe when a
		// write moves nothing.
		def writeAll(data byte[], timeout duration = 30s) !none {
			let off = 0
			for off < data.len() {
				let n = try write(data[off:], timeout)
				fail errorOf(ErrorCode.Pipe, "write", "", "wrote nothing") when n == 0
				off += n
			}
			return none
		}

		// Closes the descriptor. Closing an already closed connection does nothing.
		// Fails when the descriptor refuses to close.
		def close() !none {
			return none when fd < 0
			let handle = fd
			fd = -1
			return Network.close(handle) onerror (err error) {fail netError("close", "", err)}
		}

		// Reports whether the connection still holds an open descriptor.
		def isOpen() bool {
			return fd >= 0
		}

		// Closes the descriptor when the last reference is released.
		def dispose() {
			close() onerror recover none
		}

		// shutdownRead closes the receiving side; further reads return end of stream.
		// Fails when the connection is closed or the call is refused.
		def shutdownRead() !none {
			fail errorOf(ErrorCode.Closed, "shutdown", "", "connection is closed") when fd < 0
			return Network.shutdown(fd, 0) onerror (err error) {fail netError("shutdown", "", err)}
		}

		// shutdownWrite closes the sending side, telling the peer no more data
		// follows. Fails when the connection is closed or the call is refused.
		def shutdownWrite() !none {
			fail errorOf(ErrorCode.Closed, "shutdown", "", "connection is closed") when fd < 0
			return Network.shutdown(fd, 1) onerror (err error) {fail netError("shutdown", "", err)}
		}

		// shutdown closes both sides. Fails when the connection is closed or the call
		// is refused.
		def shutdown() !none {
			fail errorOf(ErrorCode.Closed, "shutdown", "", "connection is closed") when fd < 0
			return Network.shutdown(fd, 2) onerror (err error) {fail netError("shutdown", "", err)}
		}

		// remoteAddr returns the peer's address, an empty one when it cannot be read.
		def remoteAddr() Address {
			let s = Network.remoteAddr(fd) onerror recover ""
			let a = new Address()
			a.parse(s) onerror recover none
			return a
		}

		// localAddr returns the address this end is bound to, an empty one when it
		// cannot be read.
		def localAddr() Address {
			let s = Network.localAddr(fd) onerror recover ""
			let a = new Address()
			a.parse(s) onerror recover none
			return a
		}
	}
}
