partial module std.net {
	use (
		std.time
		std.services.network::(Network)
	)

	// How long `close` waits for calls in flight to leave once they were
	// woken. A call the runtime cannot wake (a thread blocked outside the
	// scheduler) would otherwise hold the close for good.
	internal const descriptorDrainLimit = 2s

	// The descriptor of a Connection, Socket or listener, as several tasks
	// use it: each call borrows the number and gives it back, and `close`
	// takes it from new calls, wakes the ones waiting, lets the ones in
	// flight leave and only then gives the number back to the system, which
	// may hand it to the next socket at once. Without that, a call that read
	// the number just before the close went on to read or write whatever
	// socket got the number next (#17).
	internal type DescriptorGuard {
		internal fd       int
		internal inflight int           = 0
		internal drained  channel<none>

		def new(fd int) {
			self.fd = fd
			self.drained = new channel<none>(1)
		}

		// The descriptor for one call, -1 once closed. Every borrow that got
		// one ends with `giveBack`.
		atomic def borrow() int {
			return -1 when fd < 0
			inflight++
			return fd
		}

		atomic def giveBack() {
			inflight--
			drained.offer(none) when fd < 0 && inflight == 0
		}

		// Whether the descriptor is still open, as a call would find it.
		def isOpen() bool {
			return fd >= 0
		}

		// The number, for callers that hand it on (`descriptor()`); -1 once
		// closed.
		def number() int {
			return fd
		}

		// Gives the number up without closing it, to the Listener or Connection
		// that took the descriptor over: calls made here after fail as on a
		// closed descriptor, and a close here does nothing, since the number
		// may belong to another socket by then.
		atomic def handOff() {
			fd = -1
		}

		// Closes the descriptor. Closing again does nothing. Fails when the
		// system refuses to close it.
		def close() !none {
			let handle = take()
			return none when handle < 0
			Network.wake(handle) onerror recover none
			let limit = time.now() + descriptorDrainLimit
			for !idle() && time.now().before(limit) {
				let left = limit - time.now()
				let sleep = time.sleepChan(left)
				select {
					case drained:
					case sleep:
				}
			}
			return Network.close(handle)
		}

		// Takes the descriptor from new calls; -1 when it was closed already.
		internal atomic def take() int {
			let handle = fd
			fd = -1
			return handle
		}

		internal atomic def idle() bool {
			return inflight == 0
		}
	}
}
