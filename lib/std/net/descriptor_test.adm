partial module std.net {
	use (
		std.testing
		std.time
		std.services.network::(Network)
	)

	// Closes the guard and reports that it returned.
	internal async def closeGuard(guard DescriptorGuard) bool {
		guard.close() onerror recover none
		return true
	}

	check "Descriptors" {
		// A close takes the descriptor from new calls at once and waits for
		// the one in flight before it gives the number back.
		@test()
		def closeWaitsForTheCallInFlight() !none {
			let fd = try Network.socketFd(SocketDomain.IPv4, SocketType.Datagram)
			try Network.bind(fd, "127.0.0.1:0")
			let guard = new DescriptorGuard(fd)
			assert guard.borrow() == fd
			let closing = closeGuard(guard)
			time.sleep(50ms)
			assert !guard.isOpen() && guard.borrow() == -1
			// Not closed yet: the borrowed number still names this socket.
			assert (try Network.localAddr(fd)).startsWith("127.0.0.1:")
			guard.giveBack()
			assert await closing
			return none
		}

		// A socket that handed its descriptor to a listener refuses calls and
		// leaves the descriptor to the listener when closed.
		@test()
		def aHandedOffSocketLeavesTheDescriptorAlone() !none {
			let sock = try socket(SocketDomain.IPv4, SocketType.Stream)
			try sock.bind("127.0.0.1:0")
			let ln = try sock.listen(4)
			assert !sock.isOpen()
			assert sock.setNoDelay(true) is error
			try sock.close()
			let client = try dialStream(ln.address().str(), 2s)
			let server = try ln.accept()
			try client.close()
			try server.close()
			try ln.close()
			return none
		}
	}
}
