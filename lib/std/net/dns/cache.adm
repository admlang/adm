partial module std.net.dns {
	use std.time

	// CacheEntry is one cached response.
	struct CacheEntry {
		response Message
		stored   time.Time
		// Seconds the response may be served.
		lifetime int
	}

	// Cache keeps responses for as long as their records allow. A `Client`
	// with one answers a repeated question without asking a server.
	//
	// A response with records lives as long as the shortest TTL among them;
	// "no such name" and "no such record" live as long as the SOA record in
	// the authority section allows (RFC 2308) and are not kept without one.
	// Truncated responses and other failures are never kept.
	type Cache {
		// Responses kept at most. A full cache drops what expired, and
		// everything when nothing did.
		maxEntries int = 1000
		// The longest a response is kept, in seconds.
		maxTTL     int = 86400

		internal entries map<string, CacheEntry> = map<string, CacheEntry>{}

		// get is the cached response to the question with the time it spent
		// in the cache taken off every TTL, none when there is none or it
		// expired. A query that asks for DNSSEC records (`signed`) is
		// answered only from responses to such queries.
		atomic def get(question Question, signed bool = false) ?Message {
			let key = cacheKey(question, signed)
			let entry = entries.get(key)
			return none when entry is none
			let age = int(time.since(entry.stored)) / 1000000000
			if age >= entry.lifetime {
				entries = entries.delete(key)
				return none
			}
			return aged(entry.response, age)
		}

		// put keeps the response to the question when it may be cached;
		// `signed` says the query asked for DNSSEC records.
		atomic def put(question Question, response Message, signed bool = false) {
			let lifetime = lifetimeOf(response)
			lifetime = maxTTL when lifetime > maxTTL
			return when lifetime <= 0
			makeRoom() when entries.len() >= maxEntries
			entries[cacheKey(question, signed)] = CacheEntry{response: response, stored: time.now(), lifetime: lifetime}
		}

		// len is the number of responses kept, expired ones included until
		// they are asked for.
		atomic def len() int {
			return entries.len()
		}

		// clear forgets every response.
		atomic def clear() {
			entries = map<string, CacheEntry>{}
		}

		internal def makeRoom() {
			for let (_, key) in entries.keys() {
				let entry = entries.get(key)
				continue when entry is none
				entries = entries.delete(key) when int(time.since(entry.stored)) / 1000000000 >= entry.lifetime
			}
			entries = map<string, CacheEntry>{} when entries.len() >= maxEntries
		}
	}

	internal def cacheKey(question Question, signed bool) string {
		let code = question.kind == RecordType.Unknown ?? (question.code, question.kind.value)
		return "{canonicalName(question.name)}/{code}/{question.class.value}{signed ?? ("/do", "")}"
	}

	// lifetimeOf is how many seconds the response may be cached, 0 when it
	// may not.
	internal def lifetimeOf(response Message) int {
		return 0 when response.truncated
		return 0 unless response.rcode := RCode.Success || RCode.NameError
		if response.rcode == RCode.Success && response.answers.len() > 0 {
			let shortest = -1
			for let (_, r) in response.answers {
				shortest = r.ttl when shortest < 0 || r.ttl < shortest
			}
			return shortest
		}
		for let (_, r) in response.authorities {
			let soa = r.soa
			continue when soa is none
			return soa.minimum < r.ttl ?? (soa.minimum, r.ttl)
		}
		return 0
	}

	// aged is a copy of the response with `age` seconds taken off every TTL.
	internal def aged(response Message, age int) Message {
		let out = new Message()
		out.id = response.id
		out.response = response.response
		out.opcode = response.opcode
		out.authoritative = response.authoritative
		out.recursionDesired = response.recursionDesired
		out.recursionAvailable = response.recursionAvailable
		out.authenticData = response.authenticData
		out.checkingDisabled = response.checkingDisabled
		out.rcode = response.rcode
		out.edns = response.edns
		for let (_, q) in response.questions {
			out.questions.push(q)
		}
		for let (_, r) in response.answers {
			out.answers.push(r.withTTL(r.ttl - age))
		}
		for let (_, r) in response.authorities {
			out.authorities.push(r.withTTL(r.ttl - age))
		}
		for let (_, r) in response.additionals {
			out.additionals.push(r.withTTL(r.ttl - age))
		}
		return out
	}
}
