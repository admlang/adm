partial module std.net.dns {
	use (
		std.crypto.x509::(parseIPText)
		std.os
		std.services::(Network)
		std.time
	)

	// Config is what a resolver configuration file says: the servers to ask
	// and how names are completed.
	struct Config {
		// Server addresses in the file's order, as `host:port`.
		servers  string[] = []
		// Domains tried behind a name that is not fully qualified.
		search   string[] = []
		// A name with at least this many dots is tried as it is first.
		ndots    int      = 1
		// How long one server gets to answer.
		timeout  duration = 5s
		// How often the list of servers is gone through.
		attempts int      = 2
		// Spread the queries over the servers instead of always starting
		// at the first.
		rotate   bool     = false
	}

	// parseConfig reads the `resolv.conf` format: `nameserver`, `search`,
	// `domain` and the `ndots`, `timeout`, `attempts` and `rotate` options.
	// Lines it does not know are skipped.
	def parseConfig(text string) Config {
		let config = Config{}
		for let (_, raw) in text.split("\n") {
			let line = raw
			let comment = line.indexOf("#")
			line = line[:comment] when comment >= 0
			comment = line.indexOf(";")
			line = line[:comment] when comment >= 0
			let fields = line.replace("\t", " ").split(" ").filter(p => p != "")
			continue when fields.len() < 2
			match fields[0] {
				case "nameserver":
					config.servers.push(serverAddress(fields[1]))
				case "domain":
					config.search = [canonicalName(fields[1])]
				case "search":
					config.search = []
					for let i = 1; i < fields.len(); i++ {
						config.search.push(canonicalName(fields[i]))
					}
				case "options":
					for let i = 1; i < fields.len(); i++ {
						applyOption(config, fields[i])
					}
			}
		}
		return config
	}

	internal let loadedConfig ?Config = none
	internal let loadedHosts ?Hosts = none
	internal let loadedText = ""
	internal let checkedAt = time.now()
	// Counts the configurations seen, so a client notices a new one.
	internal let configGeneration = 0
	// Set by tests that stand in for the system's configuration.
	internal let configPinned = false

	// systemConfig is the system's resolver configuration, read through the
	// `Network` service and looked at again at most every five seconds, so a
	// change of network is picked up; `127.0.0.1:53` is the server when it
	// names none.
	def systemConfig() Config {
		let existing = loadedConfig
		if !(existing is none) {
			return existing when configPinned || time.since(checkedAt) < 5s
		}
		checkedAt = time.now()
		let text = Network.resolverConfig()
		if !(existing is none) {
			return existing when text == loadedText
		}
		let config = parseConfig(text)
		config.servers = ["127.0.0.1:53"] when config.servers.len() == 0
		loadedText = text
		loadedConfig = config
		configGeneration++
		return config
	}

	// systemHosts is the system's hosts file, read once through the `Network`
	// service.
	def systemHosts() Hosts {
		let existing = loadedHosts
		return existing unless existing is none
		let hosts = parseHosts(Network.hostsFile())
		loadedHosts = hosts
		return hosts
	}

	// The group and port multicast DNS is asked at over IPv4 (RFC 6762 §3).
	const multicastServer = "224.0.0.251:5353"

	// isSystemServer reports whether the address, as `serverAddress` writes
	// it, is one of the system's name servers. The multicast DNS group
	// counts as one: it is where the names under `.local` are asked.
	def isSystemServer(server string) bool {
		return server == multicastServer || systemConfig().servers.indexOf(server) >= 0
	}

	// isLocalName reports whether the name is `local` or lies below it, the
	// domain multicast DNS answers for (RFC 6762 §3).
	def isLocalName(name string) bool {
		return isSubdomain(name, "local")
	}

	// readConfig reads a resolver configuration file.
	// Fails when the file cannot be read.
	def readConfig(path string = "/etc/resolv.conf") !Config {
		return parseConfig(string(try os.readFile(path)))
	}

	internal def applyOption(config Config, option string) {
		if option == "rotate" {
			config.rotate = true
			return
		}
		let colon = option.indexOf(":")
		return when colon < 0
		let value = option[colon + 1:]
		return unless value.isNumeric()
		let n = value.toInt<int>()
		match option[:colon] {
			case "ndots":
				config.ndots = n > 15 ?? (15, n)
			case "timeout":
				config.timeout = duration((n < 1 ?? (1, n > 30 ?? (30, n))) * 1000000000)
			case "attempts":
				config.attempts = n < 1 ?? (1, n > 5 ?? (5, n))
		}
	}

	// serverAddress is a server as `host:port`: port 53 is added to a bare
	// host, and an IPv6 host gets its brackets.
	def serverAddress(server string) string {
		return server when server.startsWith("[") && server.contains("]:")
		return server + ":53" when server.startsWith("[")
		let ip = parseIPText(server)
		if !(ip is none) {
			return "[" + server + "]:53" when ip.len() == 16
			return server + ":53"
		}
		return server when server.contains(":")
		return server + ":53"
	}

	// Hosts is a parsed hosts file: names for addresses without a query.
	type Hosts {
		// Addresses by canonical name, in the file's order.
		byName    map<string, string[]> = map<string, string[]>{}
		// Names by address text.
		byAddress map<string, string[]> = map<string, string[]>{}

		// addresses are the addresses the file gives the name, empty when it
		// does not list it.
		def addresses(name string) string[] {
			let found = byName.get(canonicalName(name))
			return [] when found is none
			return found
		}

		// names are the names the file gives the address, empty when it does
		// not list it.
		def names(ip string) string[] {
			let found = byAddress.get(ip.lower())
			return [] when found is none
			return found
		}
	}

	// parseHosts reads the hosts file format: an address and its names a
	// line. Lines that do not start with an IP address are skipped.
	def parseHosts(text string) Hosts {
		let hosts = new Hosts()
		for let (_, raw) in text.split("\n") {
			let line = raw
			let comment = line.indexOf("#")
			line = line[:comment] when comment >= 0
			let fields = line.replace("\t", " ").split(" ").filter(p => p != "")
			continue when fields.len() < 2
			let ip = fields[0].lower()
			// A scoped address (`fe80::1%lo0`) is kept without its zone.
			let zone = ip.indexOf("%")
			ip = ip[:zone] when zone >= 0
			continue when parseIPText(ip) is none
			for let i = 1; i < fields.len(); i++ {
				let name = canonicalName(fields[i])
				let addresses = hosts.addresses(name)
				addresses.push(ip)
				hosts.byName[name] = addresses
				let names = hosts.names(ip)
				names.push(name)
				hosts.byAddress[ip] = names
			}
		}
		return hosts
	}

	// readHosts reads a hosts file.
	// Fails when the file cannot be read.
	def readHosts(path string = "/etc/hosts") !Hosts {
		return parseHosts(string(try os.readFile(path)))
	}
}
