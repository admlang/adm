partial module std.net.dns {
	use std.testing

	check "Config" {
		@test()
		def TestResolvConf() {
			let config = parseConfig("# generated\nnameserver 192.0.2.53\nnameserver 2001:db8::53 ; second\nnameserver\t[2001:db8::54]:5353\ndomain old.test\nsearch Example.Test. corp.test\noptions ndots:2 timeout:3 attempts:9 rotate debug\nsortlist 10.0.0.0\n")
			assert config.servers.len() == 3 && config.servers[0] == "192.0.2.53:53"
			assert config.servers[1] == "[2001:db8::53]:53" && config.servers[2] == "[2001:db8::54]:5353"
			assert config.search.len() == 2 && config.search[0] == "example.test" && config.search[1] == "corp.test"
			assert config.ndots == 2 && config.timeout == 3s && config.attempts == 5 && config.rotate

			let bare = parseConfig("")
			assert bare.servers.len() == 0 && bare.ndots == 1 && bare.timeout == 5s && bare.attempts == 2 && !bare.rotate
			let missing = false
			readConfig("/nonexistent/resolv.conf") onerror (err error) {
				missing = true
				recover Config{}
			}
			assert missing
		}

		@test()
		def TestServerAddress() {
			assert serverAddress("192.0.2.1") == "192.0.2.1:53" && serverAddress("192.0.2.1:5353") == "192.0.2.1:5353"
			assert serverAddress("2001:db8::1") == "[2001:db8::1]:53" && serverAddress("[2001:db8::1]") == "[2001:db8::1]:53"
			assert serverAddress("[2001:db8::1]:5353") == "[2001:db8::1]:5353"
			assert serverAddress("dns.example.test") == "dns.example.test:53" && serverAddress("dns.example.test:54") == "dns.example.test:54"
		}

		@test()
		def TestHostsFile() {
			let hosts = parseHosts("127.0.0.1   localhost Loopback\n::1\tlocalhost ip6-localhost\n# 10.0.0.1 commented\n192.0.2.7 build.example.test # the builder\nfe80::1%lo0 scoped\nnot-an-address name\n")
			let local = hosts.addresses("LOCALHOST.")
			assert local.len() == 2 && local[0] == "127.0.0.1" && local[1] == "::1"
			assert hosts.addresses("loopback").len() == 1 && hosts.addresses("commented").len() == 0 && hosts.addresses("name").len() == 0
			assert hosts.addresses("scoped")[0] == "fe80::1"
			let names = hosts.names("127.0.0.1")
			assert names.len() == 2 && names[0] == "localhost" && names[1] == "loopback"
			assert hosts.names("192.0.2.7")[0] == "build.example.test" && hosts.names("192.0.2.8").len() == 0
			let missing = false
			readHosts("/nonexistent/hosts") onerror (err error) {
				missing = true
				recover new Hosts()
			}
			assert missing
		}

		@test()
		def TestCache() !none {
			let cache = new Cache()
			let query = try newQuery("www.example.test")
			let question = Question{name: "WWW.example.test."}
			assert cache.get(question) is none

			let response = query.reply()
			response.answers.push(addressRecord("www.example.test", "192.0.2.1", 120))
			response.answers.push(addressRecord("www.example.test", "192.0.2.2", 60))
			assert lifetimeOf(response) == 60
			cache.put(question, response)
			let hit = cache.get(Question{name: "www.example.test"})
			fail "the response was not kept" when hit is none
			assert hit.answers.len() == 2 && hit.answers[0].ttl == 120 && hit.answers[1].address == "192.0.2.2"
			assert cache.get(Question{name: "www.example.test", kind: RecordType.AAAA}) is none
			// Time in the cache comes off every TTL, never under 0.
			let old = aged(response, 90)
			assert old.answers[0].ttl == 30 && old.answers[1].ttl == 0 && response.answers[0].ttl == 120

			// Negative answers live as long as the SOA allows, and not without one.
			let negative = query.reply(RCode.NameError)
			assert lifetimeOf(negative) == 0
			negative.authorities.push(soaRecord("example.test", SOA{mname: "ns.example.test", rname: "admin.example.test", minimum: 30}, 3600))
			assert lifetimeOf(negative) == 30
			let truncated = query.reply()
			truncated.answers.push(addressRecord("www.example.test", "192.0.2.1"))
			truncated.truncated = true
			assert lifetimeOf(truncated) == 0 && lifetimeOf(query.reply(RCode.ServerFailure)) == 0
			cache.put(Question{name: "cut.example.test"}, truncated)
			assert cache.len() == 1

			cache.maxTTL = 10
			cache.put(Question{name: "capped.example.test"}, response)
			assert cache.len() == 2
			// A full cache makes room.
			cache.maxEntries = 2
			cache.put(Question{name: "third.example.test"}, response)
			assert cache.len() == 1 && !(cache.get(Question{name: "third.example.test"}) is none)
			cache.clear()
			assert cache.len() == 0
			return none
		}
	}
}
