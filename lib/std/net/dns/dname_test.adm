partial module std.net.dns {
	use (
		std.net
		std.testing
	)

	check "DNAME records" {
		@test()
		def TestCodecRoundTrip() !none {
			let m = new Message()
			m.id = 9
			m.response = true
			m.authoritative = true
			m.questions.push(Question{name: "foo.sub.example.test", kind: RecordType.A})
			m.answers.push(dnameRecord("sub.example.test", "other.test"))

			let back = try decode(try m.encode())
			assert back.answers.len() == 1
			let r = back.answers[0]
			assert r.kind == RecordType.DNAME && r.target == "other.test"
			assert r.str() == "sub.example.test. 300 IN DNAME other.test."
			assert r.rdata() == "other.test."
			assert r.wireType() == 39
			return none
		}

		@test()
		def TestCanonicalFormIsUncompressedAndLowerCase() !none {
			let r = dnameRecord("Sub.Example.Test", "Other.TEST")
			let data = try r.wireData()
			for let (_, b) in data {
				assert !(int(b) >= 0x41 && int(b) <= 0x5a)
			}
			// No compression pointer: every length byte fits a label.
			assert data.len() == "other.test".len() + 2
		}

		@test()
		def TestZoneFileRoundTrip() !none {
			let zone = try parseZone([
				"$ORIGIN example.test.",
				"$TTL 300",
				"@ SOA ns admin 1 1h 10m 1w 60",
				"@ NS ns",
				"ns A 192.0.2.1",
				"sub DNAME other.test.",
			].join("\n") + "\n")

			let held = zone.find("sub.example.test", RecordType.DNAME)
			assert held.len() == 1 && held[0].target == "other.test"
			assert zone.str().contains("sub.example.test. 300 IN DNAME other.test.")

			let reparsed = try parseZone(zone.str())
			let again = reparsed.find("sub.example.test", RecordType.DNAME)
			assert again.len() == 1 && again[0].target == "other.test"
		}

		// world builds a zone with `sub.example.test` DNAMEd to
		// `other.example.test`, itself DNAMEd to `another.example.test`,
		// with an A record below the final target.
		def world() !Zone {
			let zone = try parseZone([
				"$ORIGIN example.test.",
				"$TTL 300",
				"@ SOA ns admin 1 1h 10m 1w 60",
				"@ NS ns",
				"ns A 192.0.2.1",
				"sub DNAME other",
				"other DNAME another",
				"www.another A 192.0.2.9",
			].join("\n") + "\n")
			return zone
		}

		@test()
		def TestServeAnswersBelowADNAMEWithTheSynthesizedCNAME() !none {
			let zone = try world()
			let query = try newQuery("www.other.example.test", RecordType.A)
			let response = try zone.serve(Request{message: query, remote: new net.Address()})
			assert response.rcode == RCode.Success && response.answers.len() == 3
			assert response.answers[0].kind == RecordType.DNAME && response.answers[0].name == "other.example.test"
			assert response.answers[1].kind == RecordType.CNAME && response.answers[1].name == "www.other.example.test"
			assert response.answers[1].target == "www.another.example.test"
			assert response.answers[2].kind == RecordType.A && response.answers[2].name == "www.another.example.test"
			assert response.answers[2].address == "192.0.2.9"
		}

		@test()
		def TestServeFollowsAChainOfDNAMEsInsideTheZone() !none {
			let zone = try world()
			let query = try newQuery("www.sub.example.test", RecordType.A)
			let response = try zone.serve(Request{message: query, remote: new net.Address()})
			assert response.rcode == RCode.Success && response.answers.len() == 5
			assert response.answers[0].kind == RecordType.DNAME && response.answers[0].name == "sub.example.test"
			assert response.answers[2].kind == RecordType.DNAME && response.answers[2].name == "other.example.test"
			let last = response.answers[4]
			assert last.kind == RecordType.A && last.name == "www.another.example.test" && last.address == "192.0.2.9"
		}

		@test()
		def TestDNAMEDoesNotAffectItsOwnOwnerName() !none {
			let zone = try world()
			let query = try newQuery("sub.example.test", RecordType.DNAME)
			let response = try zone.serve(Request{message: query, remote: new net.Address()})
			assert response.rcode == RCode.Success && response.answers.len() == 1
			assert response.answers[0].kind == RecordType.DNAME
		}
	}
}
