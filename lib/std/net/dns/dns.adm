// DNS (RFC 1035, EDNS(0) of RFC 6891): the message codec, a stub resolver
// `Client` over UDP and TCP, and a `Server` with an in-memory `Zone` and a
// `Forwarder`.
//
// ```
// let addresses = try dns.lookupHost("example.com")
//
// let zone = new dns.Zone("example.test")
// zone.add(dns.addressRecord("www.example.test", "192.0.2.1"))
// let server = new dns.Server("127.0.0.1:5353", zone)
// try server.listenAndServe()
// ```

partial module std.net.dns {
	use std.errors

	// RecordType is the TYPE of a resource record or the QTYPE of a question.
	// A type the enum does not name decodes as `Unknown`, with the wire
	// value in `Record.code` or `Question.code`.
	enum RecordType {
		Unknown = 0,
		// An IPv4 address.
		A = 1,
		// An authoritative name server.
		NS = 2,
		// The canonical name of an alias.
		CNAME = 5,
		// The start of a zone of authority.
		SOA = 6,
		// A domain name pointer, as reverse lookups use.
		PTR = 12,
		// A mail exchange.
		MX = 15,
		// Text strings.
		TXT = 16,
		// An IPv6 address.
		AAAA = 28,
		// The location of a service (RFC 2782).
		SRV = 33,
		// A naming authority pointer (RFC 3403).
		NAPTR = 35,
		// Redirects a whole subtree of names to another (RFC 6672).
		DNAME = 39,
		// The EDNS(0) pseudo record; `Message.edns` carries it.
		OPT = 41,
		// The digest of a child zone's key, in the parent (DNSSEC, RFC 4034).
		DS = 43,
		// The signature over a record set (DNSSEC).
		RRSIG = 46,
		// The next name of a signed zone and the types at this one (DNSSEC).
		NSEC = 47,
		// A public key of a signed zone (DNSSEC).
		DNSKEY = 48,
		// NSEC over hashed names (RFC 5155).
		NSEC3 = 50,
		// How the zone hashes names for NSEC3.
		NSEC3PARAM = 51,
		// What a TLS server presents (DANE, RFC 6698).
		TLSA = 52,
		// The DS a child zone asks its parent to publish (RFC 7344).
		CDS = 59,
		// The DNSKEY a child zone asks its parent to take a DS from.
		CDNSKEY = 60,
		// Where a service is reached (RFC 9460).
		SVCB = 64,
		// Where an https origin is reached (RFC 9460).
		HTTPS = 65,
		// A request for the changes of a zone since a serial (RFC 1995).
		// Question only.
		IXFR = 251,
		// A zone transfer request. Question only.
		AXFR = 252,
		// A transaction signature (RFC 8945), the last record of a signed
		// message; `Message.tsig` holds it.
		TSIG = 250,
		// Every record of the name. Question only.
		ANY = 255,
		// Certification authority authorization (RFC 8659).
		CAA = 257,
	}

	// RecordClass is the CLASS of a record or a question.
	enum RecordClass {
		// The Internet.
		IN = 1,
		// Chaos, which servers use for `version.bind`.
		CH = 3,
		// Hesiod.
		HS = 4,
		// No class, in dynamic updates.
		NoClass = 254,
		// Any class. Question only.
		ANY = 255,
	}

	// Opcode is the kind of query in a message header.
	enum Opcode {
		Query = 0,
		InverseQuery = 1,
		Status = 2,
		Notify = 4,
		Update = 5,
		// An opcode the enum does not name.
		Other = 15,
	}

	// RCode is the response code of a message, extended by EDNS(0).
	enum RCode {
		// No error.
		Success = 0,
		// The server could not read the query.
		FormatError = 1,
		// The server failed to answer.
		ServerFailure = 2,
		// The name does not exist (NXDOMAIN).
		NameError = 3,
		// The server does not support the kind of query.
		NotImplemented = 4,
		// The server refuses to answer.
		Refused = 5,
		// A name exists that should not (dynamic update).
		YXDomain = 6,
		// A record set exists that should not (dynamic update).
		YXRRSet = 7,
		// A record set that should exist does not (dynamic update).
		NXRRSet = 8,
		// The server is not authoritative for the zone.
		NotAuth = 9,
		// The name is not inside the zone.
		NotZone = 10,
		// The server does not speak the EDNS version asked for.
		BadVersion = 16,
		// A code the enum does not name.
		Other = 4095,
	}

	// ErrorKind names why a DNS operation failed.
	enum ErrorKind {
		// The bytes are not a DNS message, or the message cannot be encoded.
		Malformed = "malformed",
		// The name is not a domain name: a label over 63 bytes, a name over
		// 255, an empty label.
		BadName = "bad-name",
		// The name does not exist (NXDOMAIN).
		NotFound = "not-found",
		// The name exists without a record of the type asked for.
		NoData = "no-data",
		// The server answered with a failure code; `rcode` says which.
		ServerFailed = "server-failed",
		// No server answered within the timeout.
		Timeout = "timeout",
		// No server is configured, or none could be reached.
		NoServers = "no-servers",
		// The server was used before `start` or after `close`.
		Closed = "closed",
		// The answer failed DNSSEC validation (`std.net.dns.dnssec`): a
		// signature does not verify, is out of its time, or the chain of
		// keys to a trust anchor is broken.
		Bogus = "bogus",
		// A message that had to be signed with a TSIG key is not, its
		// signature does not verify, or the server refused ours.
		BadSignature = "bad-signature",
		// The name is taken: another host of the link answers for it
		// (multicast DNS, `std.net.dns.mdns`).
		Conflict = "conflict",
	}

	// DNSError is the payload every std.net.dns failure carries. `code`
	// repeats `kind.value`.
	struct DNSError {
		message string
		code    string
		cause   ?error
		stack   errors.StackTrace
		kind    ErrorKind
		// The name that was looked up, "" when the failure has none.
		name    string            = ""
		// The response code of the server, `Success` when none answered.
		rcode   RCode             = RCode.Success
		// The server that was asked, "" when the failure has none.
		server  string            = ""
	}

	// errorOf builds a DNSError of the kind, its message prefixed `dns:`.
	def errorOf(kind ErrorKind, message string, name string = "") DNSError {
		return DNSError{message: "dns: {message}", code: kind.value, kind: kind, name: name}
	}

	// recordTypeOf is the RecordType with the wire value, `Unknown` when the
	// enum does not name it.
	def recordTypeOf(wire int) RecordType {
		match wire {
			case 1:
				return RecordType.A
			case 2:
				return RecordType.NS
			case 5:
				return RecordType.CNAME
			case 6:
				return RecordType.SOA
			case 12:
				return RecordType.PTR
			case 15:
				return RecordType.MX
			case 16:
				return RecordType.TXT
			case 28:
				return RecordType.AAAA
			case 33:
				return RecordType.SRV
			case 35:
				return RecordType.NAPTR
			case 39:
				return RecordType.DNAME
			case 41:
				return RecordType.OPT
			case 43:
				return RecordType.DS
			case 46:
				return RecordType.RRSIG
			case 47:
				return RecordType.NSEC
			case 48:
				return RecordType.DNSKEY
			case 50:
				return RecordType.NSEC3
			case 51:
				return RecordType.NSEC3PARAM
			case 59:
				return RecordType.CDS
			case 60:
				return RecordType.CDNSKEY
			case 52:
				return RecordType.TLSA
			case 64:
				return RecordType.SVCB
			case 65:
				return RecordType.HTTPS
			case 250:
				return RecordType.TSIG
			case 251:
				return RecordType.IXFR
			case 252:
				return RecordType.AXFR
			case 255:
				return RecordType.ANY
			case 257:
				return RecordType.CAA
			default:
				return RecordType.Unknown
		}
	}

	// recordClassOf is the RecordClass with the wire value, `NoClass` when the
	// enum does not name it.
	def recordClassOf(wire int) RecordClass {
		match wire {
			case 1:
				return RecordClass.IN
			case 3:
				return RecordClass.CH
			case 4:
				return RecordClass.HS
			case 255:
				return RecordClass.ANY
			default:
				return RecordClass.NoClass
		}
	}

	// opcodeOf is the Opcode with the wire value, `Other` when the enum does
	// not name it.
	def opcodeOf(wire int) Opcode {
		match wire {
			case 1:
				return Opcode.InverseQuery
			case 2:
				return Opcode.Status
			case 4:
				return Opcode.Notify
			case 0:
				return Opcode.Query
			case 5:
				return Opcode.Update
			default:
				return Opcode.Other
		}
	}

	// rcodeOf is the RCode with the wire value, `Other` when the enum does
	// not name it.
	def rcodeOf(wire int) RCode {
		match wire {
			case 0:
				return RCode.Success
			case 1:
				return RCode.FormatError
			case 2:
				return RCode.ServerFailure
			case 3:
				return RCode.NameError
			case 4:
				return RCode.NotImplemented
			case 5:
				return RCode.Refused
			case 6:
				return RCode.YXDomain
			case 7:
				return RCode.YXRRSet
			case 8:
				return RCode.NXRRSet
			case 9:
				return RCode.NotAuth
			case 10:
				return RCode.NotZone
			case 16:
				return RCode.BadVersion
			default:
				return RCode.Other
		}
	}
}
