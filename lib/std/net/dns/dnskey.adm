// The record types of DNSSEC (RFC 4034, RFC 5155) as data. Checking and
// making signatures is `std.net.dns.dnssec`, which keeps the cryptography
// out of every program that only resolves names.

partial module std.net.dns {
	use (
		std.crypto.hash::(Hash, digest)
		std.data.encoding
		std.time
	)

	// Algorithm names the DNSSEC signature algorithms in use (RFC 8624). The
	// records carry the number, so one the enum does not name survives.
	enum Algorithm {
		Unknown = 0,
		RSASHA1 = 5,
		// RSASHA1 for a zone that uses NSEC3.
		RSASHA1NSEC3SHA1 = 7,
		RSASHA256 = 8,
		RSASHA512 = 10,
		ECDSAP256SHA256 = 13,
		ECDSAP384SHA384 = 14,
		ED25519 = 15,
		ED448 = 16,
	}

	// algorithmOf is the Algorithm with the wire value, `Unknown` when the
	// enum does not name it.
	def algorithmOf(wire int) Algorithm {
		match wire {
			case 5:
				return Algorithm.RSASHA1
			case 7:
				return Algorithm.RSASHA1NSEC3SHA1
			case 8:
				return Algorithm.RSASHA256
			case 10:
				return Algorithm.RSASHA512
			case 13:
				return Algorithm.ECDSAP256SHA256
			case 14:
				return Algorithm.ECDSAP384SHA384
			case 15:
				return Algorithm.ED25519
			case 16:
				return Algorithm.ED448
			default:
				return Algorithm.Unknown
		}
	}

	// DNSKEY is the data of a DNSKEY or CDNSKEY record: a public key of a
	// signed zone.
	type DNSKEY {
		// 256 for a zone signing key, 257 for a key signing key (the secure
		// entry point a DS in the parent names).
		flags     int    = 256
		// Always 3.
		protocol  int    = 3
		// An `Algorithm` value.
		algorithm int    = Algorithm.ECDSAP256SHA256.value
		// The public key in the form of its algorithm: exponent and modulus
		// for RSA (RFC 3110), `x | y` for ECDSA, the 32 bytes of Ed25519.
		key       byte[] = []

		// isZoneKey reports whether the key may sign the records of its zone.
		def isZoneKey() bool {
			return flags & 0x0100 != 0
		}

		// isEntryPoint reports the secure entry point flag of a key signing key.
		def isEntryPoint() bool {
			return flags & 0x0001 != 0
		}

		// isRevoked reports the revoke flag of RFC 5011.
		def isRevoked() bool {
			return flags & 0x0080 != 0
		}

		// keyTag is the number RRSIG and DS records name the key by (RFC 4034
		// appendix B). Two keys of a zone may share one.
		def keyTag() int {
			let sum = flags + (protocol << 8) + algorithm
			for let i = 0; i < key.len(); i++ {
				sum += i % 2 == 0 ?? (int(key[i]) << 8, int(key[i]))
			}
			sum += sum >> 16 & 0xffff
			return sum & 0xffff
		}

		// str renders the data the way a zone file writes it.
		def str() string {
			return "{flags} {protocol} {algorithm} {encoding.Base64{}.encode(key)}"
		}
	}

	// DS is the data of a DS or CDS record: the digest of a key signing key
	// of the child zone, signed by the parent.
	struct DS {
		// The `keyTag` of the DNSKEY.
		keyTag     int
		// The algorithm of the DNSKEY.
		algorithm  int
		// 1 SHA-1, 2 SHA-256, 4 SHA-384.
		digestType int    = 2
		digest     byte[] = []
	}

	// RRSIG is the data of an RRSIG record: the signature of one record set.
	struct RRSIG {
		// The type of the record set signed.
		covered     RecordType
		// The wire value of that type when `covered` is `Unknown`.
		coveredCode int        = 0
		algorithm   int
		// The labels of the owner name, fewer than it has when the records
		// were made from a wildcard.
		labels      int
		// The TTL the records were signed with.
		originalTTL int
		// Seconds since the Unix epoch after which the signature is void,
		// and before which it is. Both wrap at 2^32 (RFC 4034 §3.1.5).
		expiration  int
		inception   int
		// The `keyTag` of the DNSKEY that signed, in the zone `signer`.
		keyTag      int
		signer      string
		signature   byte[]     = []
	}

	// NSEC is the data of an NSEC record: no name of the zone lies between
	// the owner and `next`, and the owner has the types listed only.
	type NSEC {
		next  string
		// The wire values of the types at the owner, ascending.
		types int[]  = []

		// has reports whether the owner has records of the type.
		def has(kind RecordType) bool {
			return types.includes(kind.value)
		}
	}

	// NSEC3 is the data of an NSEC3 record, which is NSEC over the hashes
	// of the names, and of an NSEC3PARAM record, which has the first four
	// fields only.
	type NSEC3 {
		// 1 SHA-1, the only one defined.
		hashAlgorithm int    = 1
		// 1 marks opt-out: unsigned delegations may lie inside the span.
		flags         int    = 0
		// Extra rounds of the hash.
		iterations    int    = 0
		salt          byte[] = []
		// The hash of the next name, as bytes; the owner label holds this
		// one's in base32hex.
		next          byte[] = []
		types         int[]  = []

		// has reports whether the owner has records of the type.
		def has(kind RecordType) bool {
			return types.includes(kind.value)
		}

		// optOut reports the opt-out flag.
		def optOut() bool {
			return flags & 1 != 0
		}

		// hash is the hash of a name under the record's salt and iterations
		// (RFC 5155 §5): what the owner label of the name's NSEC3 record
		// holds, and what `next` is compared with.
		// Fails with BadName when the text is not a domain name.
		def hash(name string) !byte[] {
			let input = try wireName(name)
			for let i = 0; i < salt.len(); i++ {
				input.push(salt[i])
			}
			let sum = digest(Hash.SHA1, input)
			for let round = 0; round < iterations; round++ {
				let again = sum.clone()
				for let i = 0; i < salt.len(); i++ {
					again.push(salt[i])
				}
				sum = digest(Hash.SHA1, again)
			}
			return sum
		}
	}

	// dnskeyRecord publishes a key of the zone `name`.
	def dnskeyRecord(name string, data DNSKEY, ttl int = 3600) Record {
		let r = newRecord(name, RecordType.DNSKEY, ttl)
		r.dnskey = data
		return r
	}

	// dsRecord names, in the parent, a key signing key of the child zone
	// `name`.
	def dsRecord(name string, data DS, ttl int = 3600) Record {
		let r = newRecord(name, RecordType.DS, ttl)
		r.ds = data
		return r
	}

	// hashLabel is an NSEC3 hash as the owner label carries it: base32hex
	// in lower case, without padding.
	def hashLabel(hash byte[]) string {
		let codec = new encoding.Base32()
		codec.hex = true
		codec.padded = false
		return codec.encode(hash).lower()
	}

	// writeTypes appends the type bitmaps of NSEC and NSEC3 (RFC 4034 §4.1.2).
	internal def writeTypes(b Builder, types int[]) {
		let sorted = types.sort((x int, y int) => x < y)
		let at = 0
		for at < sorted.len() {
			let window = sorted[at] >> 8
			let bitmap byte[]
			for at < sorted.len() && sorted[at] >> 8 == window {
				let low = sorted[at] & 0xff
				for bitmap.len() <= low / 8 {
					bitmap.push(byte(0))
				}
				bitmap[low / 8] = byte(int(bitmap[low / 8]) | (0x80 >> (low % 8)))
				at++
			}
			b.u8(window)
			b.u8(bitmap.len())
			b.bytes(bitmap)
		}
	}

	// readTypes reads type bitmaps up to `end`. Fails with Malformed on a
	// window that is empty, over 32 bytes, out of order or cut short.
	internal def readTypes(p Parser, end int, owner string) !int[] {
		let out int[]
		let last = -1
		for p.pos < end {
			let window = try p.u8()
			let size = try p.u8()
			fail errorOf(ErrorKind.Malformed, "type bitmap windows are out of order", owner) when window <= last
			fail errorOf(ErrorKind.Malformed, "type bitmap has a bad length", owner) when size == 0 || size > 32 || p.pos + size > end
			last = window
			let bitmap = try p.bytes(size)
			for let i = 0; i < size * 8; i++ {
				out.push(window << 8 | i) when int(bitmap[i / 8]) & (0x80 >> (i % 8)) != 0
			}
		}
		return out
	}

	// typesText lists types the way a zone file writes them.
	internal def typesText(types int[]) string {
		let out = ""
		for let (_, code) in types {
			out += " " when out != ""
			let kind = recordTypeOf(code)
			out += kind == RecordType.Unknown ?? ("TYPE{code}", kind.name)
		}
		return out
	}

	// signatureTime is a signature time as a zone file writes it,
	// `YYYYMMDDHHmmSS` in UTC.
	internal def signatureTime(seconds int) string {
		let t = time.fromUnixNs(int64(seconds) * 1000000000)
		return t.year().str().padStart(4, "0") + t.month().str().padStart(2, "0") + t.day().str().padStart(2, "0") + t.hour().str().padStart(2, "0") + t.minute().str().padStart(2, "0") + t.second().str().padStart(2, "0")
	}

	// signatureTimeOf reads a signature time, `YYYYMMDDHHmmSS` or seconds
	// since the Unix epoch; none when the text is neither.
	internal def signatureTimeOf(text string) ?int {
		return none when text == "" || !text.isNumeric()
		if text.len() != 14 {
			return none when text.len() > 10
			let seconds = text.toInt<int>()
			return none when seconds > 0xffffffff
			return seconds
		}
		let stamp = "{text[0:4]}-{text[4:6]}-{text[6:8]}T{text[8:10]}:{text[10:12]}:{text[12:14]}Z"
		let failed = false
		let t = time.parse(stamp) onerror (err error) {
			failed = true
			recover time.fromUnixNs(0)
		}
		return none when failed
		return int(t.unixNs() / 1000000000)
	}
}
