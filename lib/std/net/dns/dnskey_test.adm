partial module std.net.dns {
	use std.testing

	check "DNSSEC records" {
		// signedZone holds one record of each DNSSEC type, written as a zone
		// file. The DNSKEY is the example of RFC 4034 §5.4, key tag 60485.
		def signedZone() !Zone {
			let lines string[] = [
				"$ORIGIN example.com.",
				"$TTL 86400",
				"@ SOA ns1 admin 1 1h 10m 1w 60",
				"dskey DNSKEY 256 3 5 AQOeiiR0GOMYkDshWoSKz9Xz fwJr1AYtsmx3TGkJaNXVbfi/ 2pHm822aJ5iI9BMzNXxeYCmZ DRD99WYwYqUSdjMmmAphXdvx egXd/M5+X7OrzKBaMbCVdFLU Uh6DhweJBjEVv5f2wwjM9Xzc nOf+EPbtG9DMBmADjFDc2w/r ljwvFw==",
				"dskey DS 60485 5 1 2BB183AF5F22588179A53B0A 98631FAD1A292118",
				"dskey CDS 0 0 0 00",
				"host RRSIG A 5 3 86400 20030322173103 20030220173103 2642 example.com. oJB1W6WNGv+ldvQ3WDG0MQkg5IEhjRip8WTr",
				"alfa NSEC Host.example.com. A MX RRSIG NSEC TYPE1234",
				"0p9mhaveqvm6t7vbl5lop2u3t2rp3tom NSEC3 1 1 12 aabbccdd 2t7b4g4vsa5smi47k61mv5bv1a22bojr MX DNSKEY NS SOA NSEC3PARAM RRSIG",
				"@ NSEC3PARAM 1 0 12 -",
			]
			return try parseZone(lines.join("\n") + "\n")
		}

		@test()
		def TestDNSSECRecordsFromAZoneFile() !none {
			let zone = try signedZone()
			let key = zone.find("dskey.example.com", RecordType.DNSKEY)[0].dnskey
			fail "the DNSKEY record has no data" when key is none
			assert key.flags == 256 && key.protocol == 3 && algorithmOf(key.algorithm) == Algorithm.RSASHA1
			assert key.isZoneKey() && !key.isEntryPoint() && !key.isRevoked()
			assert key.keyTag() == 60485

			let ds = zone.find("dskey.example.com", RecordType.DS)[0].ds
			fail "the DS record has no data" when ds is none
			assert ds.keyTag == 60485 && ds.algorithm == 5 && ds.digestType == 1
			assert ds.digest.hex() == "2BB183AF5F22588179A53B0A98631FAD1A292118"
			let cds = zone.find("dskey.example.com", RecordType.CDS)[0].ds
			fail "the CDS record has no data" when cds is none
			assert cds.algorithm == 0 && cds.digest.len() == 1

			let sig = zone.find("host.example.com", RecordType.RRSIG)[0].rrsig
			fail "the RRSIG record has no data" when sig is none
			assert sig.covered == RecordType.A && sig.algorithm == 5 && sig.labels == 3 && sig.originalTTL == 86400
			assert sig.expiration == 1048354263 && sig.inception == 1045762263
			assert sig.keyTag == 2642 && sig.signer == "example.com" && sig.signature.len() == 27

			let nsec = zone.find("alfa.example.com", RecordType.NSEC)[0].nsec
			fail "the NSEC record has no data" when nsec is none
			assert nsec.next == "Host.example.com" && nsec.types.len() == 5
			assert nsec.has(RecordType.MX) && !nsec.has(RecordType.AAAA) && nsec.types[4] == 1234

			let hashed = zone.find("0p9mhaveqvm6t7vbl5lop2u3t2rp3tom.example.com", RecordType.NSEC3)[0].nsec3
			fail "the NSEC3 record has no data" when hashed is none
			assert hashed.optOut() && hashed.iterations == 12 && hashed.salt.hex() == "AABBCCDD"
			assert hashed.next.len() == 20 && hashed.has(RecordType.SOA) && !hashed.has(RecordType.A)
			// The types come out in wire order, whatever order they came in.
			assert hashed.types[0] == 2 && hashed.types[5] == 51

			let param = zone.find("example.com", RecordType.NSEC3PARAM)[0].nsec3
			fail "the NSEC3PARAM record has no data" when param is none
			assert param.salt.len() == 0 && param.iterations == 12 && param.next.len() == 0
		}

		@test()
		def TestDNSSECRecordsSurviveTheWireAndTheZoneFile() !none {
			let zone = try signedZone()
			let m = new Message()
			m.response = true
			m.answers = zone.all()
			let back = try decode(try m.encode())
			assert back.answers.len() == m.answers.len()
			for let (i, r) in m.answers {
				// An owner may come back in the case of the name it was
				// compressed against.
				assert back.answers[i].name.lower() == r.name.lower() && back.answers[i].rdata() == r.rdata()
			}
			// What `str` writes reads back as the same zone.
			let again = try parseZone(zone.str())
			assert again.str() == zone.str()
			let text = zone.str()
			assert text.contains("RRSIG A 5 3 86400 20030322173103 20030220173103 2642 example.com. oJB1")
			assert text.contains("NSEC Host.example.com. A MX RRSIG NSEC TYPE1234")
			assert text.contains("NSEC3 1 1 12 AABBCCDD 2T7B4G4VSA5SMI47K61MV5BV1A22BOJR NS SOA MX RRSIG DNSKEY NSEC3PARAM")
			assert text.contains("NSEC3PARAM 1 0 12 -")
		}

		@test()
		def TestWireDataIsTheCanonicalForm() !none {
			let ns = nsRecord("example.com", "NS1.Example.COM")
			ns.target = "NS1.Example.COM"
			assert (try ns.wireData()).hex() == "036E7331076578616D706C6503636F6D00"
			// The type bitmap of RFC 4034 §4.3, and a next name that keeps its case.
			let zone = try signedZone()
			let nsec = zone.find("alfa.example.com", RecordType.NSEC)[0]
			let wire = (try nsec.wireData()).hex()
			assert wire.startsWith("04486F7374076578616D706C6503636F6D00")
			assert wire.endsWith("0006400100000003041B" + "00".repeat(26) + "20")
			assert (try wireName("WWW.Example.com.")).hex() == "03777777076578616D706C6503636F6D00"
		}

		@test()
		def TestNamesSortTheCanonicalWay() {
			// The order of RFC 4034 §6.1.
			let sorted string[] = ["example", "a.example", "yljkjljk.a.example", "Z.a.example", "zABC.a.EXAMPLE", "z.example", "\\001.z.example", "*.z.example", "\\200.z.example"]
			for let i = 0; i + 1 < sorted.len(); i++ {
				assert compareNames(sorted[i], sorted[i + 1]) < 0
				assert compareNames(sorted[i + 1], sorted[i]) > 0
			}
			assert compareNames("Example.COM.", "example.com") == 0
			assert compareNames(".", "com") < 0
			let labels = nameLabels("a\\.b.Example.com.")
			assert labels.len() == 3 && labels[0] == "a\\.b" && labels[1] == "Example"
			assert nameLabels(".").len() == 0
		}

		@test()
		def TestMalformedDNSSECDataIsRefused() {
			let refused = 0
			let lines string[] = [
				"x DNSKEY 256 3 5 not*base64",
				"x DS 1 5 1 xyz",
				"x RRSIG A 5 3 60 2003x 20030220173103 1 example.com. AAAA",
				"x NSEC3 1 0 0 - !!!! A",
				"x NSEC next NOTATYPE",
			]
			for let (_, line) in lines {
				parseZone("$ORIGIN example.com.\n" + line + "\n") onerror (err error) {
					refused++
					recover new Zone("failed.test")
				}
			}
			assert refused == 5
		}
	}
}
