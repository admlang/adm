partial module std.net.dns.dnssec {
	use (
		std.net.dns
		std.testing
		std.time
	)

	check "RFC 5011 trust anchor maintenance" {
		def linesToZone(lines string[]) !dns.Zone {
			return try dns.parseZone(lines.join("\n") + "\n")
		}

		// singleWorld serves a root zone signed with one key.
		def singleWorld(key Key, now time.Time) !(Authorities, dns.Zone) {
			let zone = try linesToZone([
				"$ORIGIN .",
				"$TTL 300",
				"@ SOA ns. admin. 1 1h 10m 1w 60",
				"@ NS ns.",
				"ns. A 192.0.2.1",
			])
			try signZone(zone, [key], 720h, now)
			let mux = new dns.Mux()
			mux.handle(".", zone)
			return (new Authorities(mux), zone)
		}

		// multiWorld serves a root zone signed with several keys.
		def multiWorld(keys Key[], now time.Time) !(Authorities, dns.Zone) {
			let zone = try linesToZone([
				"$ORIGIN .",
				"$TTL 300",
				"@ SOA ns. admin. 1 1h 10m 1w 60",
				"@ NS ns.",
				"ns. A 192.0.2.1",
			])
			try signZone(zone, keys, 720h, now)
			let mux = new dns.Mux()
			mux.handle(".", zone)
			return (new Authorities(mux), zone)
		}

		def validatorOver(wire Authorities, anchors dns.Record[]) Validator {
			let client = new dns.Client(["authorities"])
			client.transport = wire
			client.attempts = 1
			return new Validator(client, anchors)
		}

		// updateKind is the error kind `TrustAnchors.update` fails with,
		// "" when it passes.
		def updateKind(anchors TrustAnchors, validator Validator, now ?time.Time = none) string {
			let out = ""
			anchors.update(validator, now) onerror (err error) {
				out = "other"
				out = err.kind.value when err is dns.DNSError
				recover false
			}
			return out
		}

		// stateOf is the tracked state of `key` in `anchors`, none when it
		// is not tracked.
		def stateOf(anchors TrustAnchors, key Key) ?AnchorState {
			let want = key.record.dnskey
			return none when want is none
			for let (_, k) in anchors.keys {
				let have = k.record.dnskey
				continue when have is none || have.algorithm != want.algorithm
				return k.state when compareBytes(have.key, want.key) == 0
			}
			return none
		}

		// assertState fails unless `key` is tracked in `want`'s state.
		def assertState(anchors TrustAnchors, key Key, want AnchorState) !none {
			let state = stateOf(anchors, key)
			fail "the key is not tracked" when state is none
			fail "the key is {state.name}, not {want.name}" when state != want
		}

		@test()
		def TestKeyRolloverAndRevocation() !none {
			let t0 = time.now()
			let a = try generateKey(".")
			let testKey = try generateKey("test")
			let exampleKey = try generateKey("example.test")

			let root = try linesToZone([
				"$ORIGIN .",
				"$TTL 300",
				"@ SOA ns. admin. 1 1h 10m 1w 60",
				"@ NS ns.",
				"ns. A 192.0.2.1",
				"test. NS ns.test.",
				"ns.test. A 192.0.2.2",
			])
			try root.add(try dsFor(testKey.record))
			try signZone(root, [a], 720h, t0)

			let test = try linesToZone([
				"$ORIGIN test.",
				"$TTL 300",
				"@ SOA ns admin 1 1h 10m 1w 60",
				"@ NS ns",
				"ns A 192.0.2.2",
				"example NS ns.example",
				"ns.example A 192.0.2.3",
			])
			try test.add(try dsFor(exampleKey.record))
			try signZone(test, [testKey], 720h, t0)

			let example = try linesToZone([
				"$ORIGIN example.test.",
				"$TTL 300",
				"@ SOA ns admin 1 1h 10m 1w 60",
				"@ NS ns",
				"ns A 192.0.2.3",
				"www A 192.0.2.10",
			])
			try signZone(example, [exampleKey], 720h, t0)

			let mux = new dns.Mux()
			mux.handle(".", root)
			mux.handle("test", test)
			mux.handle("example.test", example)
			let wire = new Authorities(mux)

			let anchors = new TrustAnchors(".", [a.record])
			let validator = validatorOver(wire, anchors.records())
			validator.now = t0

			// A key signing key B is published beside A.
			let b = try generateKey(".")
			let t1 = t0
			try signZone(root, [a, b], 720h, t1)
			validator.now = t1
			assert try anchors.update(validator, t1)
			try assertState(anchors, b, AnchorState.Pending)
			assert anchors.records().len() == 1

			// 29 days later, still short of the add hold-down.
			let t2 = t1 + 696h
			try signZone(root, [a, b], 720h, t2)
			validator.now = t2
			assert !(try anchors.update(validator, t2))
			try assertState(anchors, b, AnchorState.Pending)

			// 31 days after B was first seen: it matures.
			let t3 = t1 + 744h
			try signZone(root, [a, b], 720h, t3)
			validator.now = t3
			assert try anchors.update(validator, t3)
			try assertState(anchors, b, AnchorState.Valid)
			assert anchors.records().len() == 2

			// The zone revokes A.
			let original = a.record.dnskey
			fail "key A has no DNSKEY data" when original is none
			let revokedData = new dns.DNSKEY()
			revokedData.flags = original.flags | 0x0080
			revokedData.protocol = original.protocol
			revokedData.algorithm = original.algorithm
			revokedData.key = original.key
			let revokedA = new Key()
			revokedA.record = dns.dnskeyRecord(".", revokedData, a.record.ttl)
			revokedA.secret = a.secret

			let t4 = t3
			try signZone(root, [revokedA, b], 720h, t4)
			try signZone(test, [testKey], 720h, t4)
			try signZone(example, [exampleKey], 720h, t4)
			validator.now = t4
			assert try anchors.update(validator, t4)
			try assertState(anchors, a, AnchorState.Revoked)
			assert anchors.records().len() == 1

			// A validator that trusts only B still validates the chain.
			let bOnly = validatorOver(wire, anchors.records())
			bOnly.now = t4
			let response = try bOnly.query("www.example.test")
			assert response.authenticData && response.answers.len() == 2

			// 31 days after the revocation: A is dropped.
			let t5 = t4 + 744h
			try signZone(root, [revokedA, b], 720h, t5)
			validator.now = t5
			assert try anchors.update(validator, t5)
			assert anchors.keys.len() == 1
			assert stateOf(anchors, a) is none
			try assertState(anchors, b, AnchorState.Valid)
		}

		@test()
		def TestPendingKeyDropsWhenAbsent() !none {
			let t0 = time.now()
			let a = try generateKey(".")
			let (wire, root) = try singleWorld(a, t0)
			let anchors = new TrustAnchors(".", [a.record])
			let validator = validatorOver(wire, anchors.records())
			validator.now = t0

			let b = try generateKey(".")
			try signZone(root, [a, b], 720h, t0)
			assert try anchors.update(validator, t0)
			assert anchors.keys.len() == 2

			try signZone(root, [a], 720h, t0)
			assert try anchors.update(validator, t0)
			assert anchors.keys.len() == 1
			assert stateOf(anchors, b) is none
		}

		@test()
		def TestValidKeyMissingThenReturns() !none {
			let t0 = time.now()
			let a = try generateKey(".")
			let b = try generateKey(".")
			let (wire, root) = try multiWorld([a, b], t0)
			let anchors = new TrustAnchors(".", [a.record, b.record])
			let validator = validatorOver(wire, anchors.records())
			validator.now = t0

			try signZone(root, [b], 720h, t0)
			assert try anchors.update(validator, t0)
			try assertState(anchors, a, AnchorState.Missing)
			assert anchors.records().len() == 2

			try signZone(root, [a, b], 720h, t0)
			assert try anchors.update(validator, t0)
			try assertState(anchors, a, AnchorState.Valid)
		}

		@test()
		def TestBogusResponseChangesNothing() !none {
			let t0 = time.now()
			let a = try generateKey(".")
			let stranger = try generateKey(".")
			let (wire, _) = try singleWorld(a, t0)
			let anchors = new TrustAnchors(".", [stranger.record])
			let validator = validatorOver(wire, anchors.records())
			validator.now = t0

			let before = anchors.str()
			assert updateKind(anchors, validator, t0) == dns.ErrorKind.Bogus.value
			assert anchors.str() == before
		}

		@test()
		def TestSeedDSBecomesValidImmediately() !none {
			let t0 = time.now()
			let a = try generateKey(".")
			let (wire, _) = try singleWorld(a, t0)
			let anchors = new TrustAnchors(".", [try dsFor(a.record)])
			assert anchors.seeds.len() == 1 && anchors.keys.len() == 0

			let validator = validatorOver(wire, anchors.records())
			validator.now = t0
			assert try anchors.update(validator, t0)
			assert anchors.keys.len() == 1
			try assertState(anchors, a, AnchorState.Valid)
			assert anchors.records().len() == 1
		}

		@test()
		def TestTrustAnchorsRoundTrip() !none {
			let a = try generateKey(".")
			let b = try generateKey(".")
			let c = try generateKey(".")

			let out = new TrustAnchors()
			let pending = new TrackedKey()
			pending.record = a.record
			pending.state = AnchorState.Pending
			pending.since = time.fromUnixNs(1700000000000000000)
			out.keys.push(pending)

			let valid = new TrackedKey()
			valid.record = b.record
			valid.state = AnchorState.Valid
			valid.since = time.fromUnixNs(1700003600000000000)
			out.keys.push(valid)

			let missing = new TrackedKey()
			missing.record = c.record
			missing.state = AnchorState.Missing
			missing.since = time.fromUnixNs(1700007200000000000)
			out.keys.push(missing)

			out.seeds.push(try dsFor(a.record))

			let parsed = try parseTrustAnchors(out.str())
			assert parsed.zone == out.zone
			assert parsed.keys.len() == 3
			assert parsed.seeds.len() == 1
			for let (i, k) in parsed.keys {
				assert k.state == out.keys[i].state
				assert k.since.unixNs() == out.keys[i].since.unixNs()
				assert compareBytes(try k.record.wireData(), try out.keys[i].record.wireData()) == 0
			}
			assert matches(parsed.seeds[0], a.record)
		}
	}
}
