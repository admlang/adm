partial module std.net.dns.dnssec {
	use (
		std.net
		std.net.dns
		std.testing
	)

	// CNAMESpoiler answers from a `Mux` like `Authorities`, but with the
	// target of every CNAME in the response rewritten when `spoilTarget`,
	// which breaks the link between a DNAME and the CNAME synthesized below
	// it without touching the DNAME's own signature.
	internal type CNAMESpoiler {
		mux         dns.Mux
		spoilTarget bool    = false

		def new(mux dns.Mux) {
			self.mux = mux
		}

		// Implements dns.Transport.
		def exchange(query dns.Message, server string, timeout duration) !dns.Message {
			let served = try mux.serve(dns.Request{message: query, remote: new net.Address()})
			let response = try dns.decode(try served.encode())
			if spoilTarget {
				for let (_, r) in response.answers {
					r.target = "spoiled.invalid" when r.kind == dns.RecordType.CNAME
				}
			}
			return response
		}
	}

	check "DNSSEC DNAME" {
		def zoneOf(lines string[]) !dns.Zone {
			return try dns.parseZone(lines.join("\n") + "\n")
		}

		// world builds a root and the signed `example.test`, which DNAMEs
		// `sub.example.test` to `other.example.test`, and returns the
		// transport with the root key.
		def world() !(CNAMESpoiler, Key) {
			let rootKey = try generateKey(".")
			let exampleKey = try generateKey("example.test")

			let root = try zoneOf([
				"$ORIGIN .",
				"$TTL 300",
				"@ SOA ns. admin. 1 1h 10m 1w 60",
				"@ NS ns.",
				"ns. A 192.0.2.1",
				"example.test. NS ns.example.test.",
				"ns.example.test. A 192.0.2.3",
			])
			try root.add(try dsFor(exampleKey.record))
			try signZone(root, [rootKey])

			let example = try zoneOf([
				"$ORIGIN example.test.",
				"$TTL 300",
				"@ SOA ns admin 1 1h 10m 1w 60",
				"@ NS ns",
				"ns A 192.0.2.3",
				"sub DNAME other",
				"www.other A 192.0.2.10",
			])
			try signZone(example, [exampleKey])

			let mux = new dns.Mux()
			mux.handle(".", root)
			mux.handle("example.test", example)
			return (new CNAMESpoiler(mux), rootKey)
		}

		def validatorOver(wire CNAMESpoiler, anchors dns.Record[]) Validator {
			let client = new dns.Client(["authorities"])
			client.transport = wire
			client.attempts = 1
			return new Validator(client, anchors)
		}

		def kindOf(validator Validator, name string) string {
			let out = ""
			validator.query(name) onerror (err error) {
				out = "other"
				out = err.kind.value when err is dns.DNSError
				recover new dns.Message()
			}
			return out
		}

		@test()
		def TestSignZoneListsDNAMEInTheTypeBitmap() !none {
			let exampleKey = try generateKey("example.test")
			let example = try zoneOf([
				"$ORIGIN example.test.",
				"$TTL 300",
				"@ SOA ns admin 1 1h 10m 1w 60",
				"@ NS ns",
				"ns A 192.0.2.3",
				"sub DNAME other",
			])
			try signZone(example, [exampleKey])
			let nsec = example.find("sub.example.test", dns.RecordType.NSEC)
			assert nsec.len() == 1
			let types = nsec[0].nsec
			assert !(types is none) && types.types.includes(dns.RecordType.DNAME.value)

			let hashedKey = try generateKey("example.test")
			let hashed = try zoneOf([
				"$ORIGIN example.test.",
				"$TTL 300",
				"@ SOA ns admin 1 1h 10m 1w 60",
				"@ NS ns",
				"ns A 192.0.2.3",
				"sub DNAME other",
			])
			try signZone(hashed, [hashedKey], 720h, none, new dns.NSEC3())
			let listedDNAME = false
			for let (_, r) in hashed.all() {
				let data = r.nsec3
				continue when data is none
				listedDNAME = true when data.types.includes(dns.RecordType.DNAME.value)
			}
			assert listedDNAME
		}

		@test()
		def TestValidatorAcceptsTheSynthesizedCNAME() !none {
			let (wire, rootKey) = try world()
			let validator = validatorOver(wire, [try dsFor(rootKey.record)])

			let response = try validator.query("www.sub.example.test")
			assert response.authenticData && response.rcode == dns.RCode.Success
			let hasAnswer = false
			for let (_, r) in response.answers {
				hasAnswer = true when r.kind == dns.RecordType.A && r.address == "192.0.2.10"
			}
			assert hasAnswer
		}

		@test()
		def TestValidatorRejectsAnAlteredSynthesizedCNAME() !none {
			let (wire, rootKey) = try world()
			wire.spoilTarget = true
			let validator = validatorOver(wire, [try dsFor(rootKey.record)])
			assert kindOf(validator, "www.sub.example.test") == dns.ErrorKind.Bogus.value
		}
	}
}
