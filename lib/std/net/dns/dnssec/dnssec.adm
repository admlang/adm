// DNSSEC (RFC 4033 to 4035, RFC 6840): checking and making the signatures
// over the record sets of a zone. The record types themselves are data of
// `std.net.dns`; the cryptography lives here, above it, because the
// `Network` service resolves through `std.net.dns`.
//
// ```
// try dnssec.verify(answers, signature, zoneKey)
//
// let key = try dnssec.generateKey("example.test")
// let signature = try key.sign(zone.find("www.example.test", dns.RecordType.A))
// let ds = try dnssec.dsFor(key.record)
// ```
//
// RSA with SHA-1, SHA-256 and SHA-512, ECDSA over P-256 and P-384 and
// Ed25519 are implemented; Ed448 is not, and `supports` says so.

partial module std.net.dns.dnssec {
	use (
		std.crypto::(ECDSAPublicKey, Ed25519PublicKey, Point, PublicKey, RSAPublicKey, constantTimeEqual, curve, isOnCurve, newEd25519PublicKey, p256, p384)
		std.crypto.hash::(Hash, digest)
		std.net.dns
		std.time
	)

	// DigestType names the digest of a DS record.
	enum DigestType {
		SHA1 = 1,
		SHA256 = 2,
		SHA384 = 4,
	}

	// supports reports whether signatures of the algorithm can be checked
	// and made. A validator treats a zone signed only with algorithms it
	// does not support as unsigned (RFC 4035 §5.2).
	def supports(algorithm dns.Algorithm) bool {
		return signs(algorithm.value)
	}

	// signs is `supports` for the number a record carries.
	internal def signs(algorithm int) bool {
		return algorithm == dns.Algorithm.ED25519.value || !(hashOf(algorithm) is none)
	}

	// digestHash is the digest of a DS digest type, none for one that is not
	// implemented.
	internal def digestHash(digestType int) ?Hash {
		return Hash.SHA1 when digestType == DigestType.SHA1.value
		return Hash.SHA256 when digestType == DigestType.SHA256.value
		return Hash.SHA384 when digestType == DigestType.SHA384.value
		return none
	}

	// hashOf is the digest the algorithm signs, none for one that is not
	// implemented and for Ed25519, which signs the data itself.
	internal def hashOf(algorithm int) ?Hash {
		match dns.algorithmOf(algorithm) {
			case dns.Algorithm.RSASHA1, dns.Algorithm.RSASHA1NSEC3SHA1:
				return Hash.SHA1
			case dns.Algorithm.RSASHA256, dns.Algorithm.ECDSAP256SHA256:
				return Hash.SHA256
			case dns.Algorithm.ECDSAP384SHA384:
				return Hash.SHA384
			case dns.Algorithm.RSASHA512:
				return Hash.SHA512
			default:
				return none
		}
	}

	// curveOf is the curve of an ECDSA algorithm, none for another.
	internal def curveOf(algorithm int) ?curve {
		return p256 when algorithm == dns.Algorithm.ECDSAP256SHA256.value
		return p384 when algorithm == dns.Algorithm.ECDSAP384SHA384.value
		return none
	}

	internal def bogus(message string, name string) dns.DNSError {
		return dns.errorOf(dns.ErrorKind.Bogus, message, name)
	}

	// publicKeyOf reads the key of a DNSKEY: exponent and modulus for RSA
	// (RFC 3110), the two coordinates for ECDSA (RFC 6605), the 32 bytes of
	// an Ed25519 key (RFC 8080).
	// Fails with Bogus when the algorithm is not supported or the bytes are
	// not a key of it.
	def publicKeyOf(key dns.DNSKEY) !PublicKey {
		let raw = key.key
		if key.algorithm == dns.Algorithm.ED25519.value {
			return newEd25519PublicKey(raw) onerror fail bogus("the Ed25519 key is not a point of its curve", "")
		}
		let ec = curveOf(key.algorithm)
		if !(ec is none) {
			let size = (ec.bitsize + 7) / 8
			fail bogus("an ECDSA key of algorithm {key.algorithm} has {size * 2} bytes, not {raw.len()}", "") when raw.len() != size * 2
			let point = Point{x: parseBigInt(raw[:size]), y: parseBigInt(raw[size:])}
			fail bogus("the ECDSA key is not a point of its curve", "") unless isOnCurve(ec, point)
			return new ECDSAPublicKey(ec, point)
		}
		fail bogus("DNSSEC algorithm {key.algorithm} is not supported", "") when hashOf(key.algorithm) is none
		fail bogus("the RSA key is too short", "") when raw.len() < 3
		let size = int(raw[0])
		let at = 1
		if size == 0 {
			size = int(raw[1]) << 8 | int(raw[2])
			at = 3
		}
		fail bogus("the RSA key is too short", "") when size == 0 || size > 4 || at + size >= raw.len()
		let exponent = 0
		for let i = 0; i < size; i++ {
			exponent = exponent << 8 | int(raw[at + i])
		}
		return new RSAPublicKey(parseBigInt(raw[at + size:]), exponent)
	}

	// verify checks that `signature`, an RRSIG record, signs the record set
	// with `key`, a DNSKEY record, and that `now`, the present when none,
	// lies within its time
	// (RFC 4035 §5.3). The records are the whole set: every record of one
	// name, class and type, in any order.
	// Fails with Bogus; the message says which check failed.
	def verify(records dns.Record[], signature dns.Record, key dns.Record, now ?time.Time = none) !none {
		let sig = signature.rrsig
		let zoneKey = key.dnskey
		fail bogus("the signature record has no RRSIG data", signature.name) when sig is none
		fail bogus("the key record has no DNSKEY data", key.name) when zoneKey is none
		fail bogus("the record set is empty", signature.name) when records.len() == 0
		let owner = dns.canonicalName(records[0].name)
		for let (_, r) in records {
			fail bogus("the records are not one set", owner) when dns.canonicalName(r.name) != owner || r.wireType() != records[0].wireType() || r.class != records[0].class
		}
		let covered = sig.covered == dns.RecordType.Unknown ?? (sig.coveredCode, sig.covered.value)
		fail bogus("the signature covers another record set", owner) when dns.canonicalName(signature.name) != owner || signature.class != records[0].class || covered != records[0].wireType()
		fail bogus("the signature names another key", owner) when dns.canonicalName(sig.signer) != dns.canonicalName(key.name) || sig.algorithm != zoneKey.algorithm || sig.keyTag != zoneKey.keyTag()
		fail bogus("the key is not a zone key", owner) when !zoneKey.isZoneKey() || zoneKey.protocol != 3
		fail bogus("{owner} is outside the signer's zone {sig.signer}", owner) unless dns.isSubdomain(owner, sig.signer)
		let labels = dns.nameLabels(owner)
		let count = labels.len() > 0 && labels[0] == "*" ?? (labels.len() - 1, labels.len())
		fail bogus("the signature counts more labels than the name has", owner) when sig.labels > count

		// Signature times are serial numbers, so they wrap (RFC 4034 §3.1.5).
		let at = now is none ?? (time.now(), now)
		let seconds = int(at.unixNs() / 1000000000) & 0xffffffff
		fail bogus("the signature is not valid yet", owner) when ((seconds - sig.inception) & 0xffffffff) >= 0x80000000
		fail bogus("the signature has expired", owner) when ((sig.expiration - seconds) & 0xffffffff) >= 0x80000000

		fail bogus("DNSSEC algorithm {sig.algorithm} is not supported", owner) unless signs(sig.algorithm)
		let publicKey = try publicKeyOf(zoneKey)
		let data = try signedData(records, signature)
		let ok = false
		if publicKey is Ed25519PublicKey {
			let ed Ed25519PublicKey = publicKey
			ok = ed.verify(data, sig.signature)
		}
		let hash = hashOf(sig.algorithm)
		let sum byte[] = []
		sum = digest(hash, data) unless hash is none
		if publicKey is RSAPublicKey && !(hash is none) {
			let rsa RSAPublicKey = publicKey
			ok = rsa.verifyPKCS1v15(hash, sum, sig.signature)
		}
		if publicKey is ECDSAPublicKey {
			let ec ECDSAPublicKey = publicKey
			let size = sig.signature.len() / 2
			fail bogus("the ECDSA signature has the wrong length", owner) when size * 2 != sig.signature.len() || size != (ec.curve.bitsize + 7) / 8
			ok = ec.verify(sum, parseBigInt(sig.signature[:size]), parseBigInt(sig.signature[size:]))
		}
		fail bogus("the signature over {owner} {records[0].kind.name} does not verify", owner) unless ok
		return none
	}

	// signedData is what the signature is computed over (RFC 4034 §3.1.8.1):
	// the RRSIG data without the signature, then the records in canonical
	// form and order, duplicates dropped, with the TTL of the signature.
	internal def signedData(records dns.Record[], signature dns.Record) !byte[] {
		let sig = signature.rrsig
		fail bogus("the signature record has no RRSIG data", signature.name) when sig is none
		let whole = try signature.wireData()
		let out = whole[:whole.len() - sig.signature.len()].clone()

		// Records made from a wildcard are signed under the wildcard's name.
		let owner = dns.canonicalName(records[0].name)
		let labels = dns.nameLabels(owner)
		if sig.labels < labels.len() && !(labels.len() > 0 && labels[0] == "*") {
			owner = "*." + labels[labels.len() - sig.labels:].join(".")
			owner = "*" when sig.labels == 0
		}
		let name = try dns.wireName(owner)

		let datas byte[][]
		for let (_, r) in records {
			datas.push(try r.wireData())
		}
		datas = datas.sort((a byte[], b byte[]) => compareBytes(a, b) < 0)
		for let (i, data) in datas {
			continue when i > 0 && compareBytes(datas[i - 1], data) == 0
			pushBytes(out, name)
			pushInt(out, records[0].wireType(), 2)
			pushInt(out, records[0].class.value, 2)
			pushInt(out, sig.originalTTL, 4)
			pushInt(out, data.len(), 2)
			pushBytes(out, data)
		}
		return out
	}

	// compareBytes orders byte strings as unsigned, left to right, a prefix
	// before what it starts.
	internal def compareBytes(a byte[], b byte[]) int {
		for let i = 0; i < a.len() && i < b.len(); i++ {
			return int(a[i]) - int(b[i]) when a[i] != b[i]
		}
		return a.len() - b.len()
	}

	internal def pushBytes(out byte[], data byte[]) {
		for let i = 0; i < data.len(); i++ {
			out.push(data[i])
		}
	}

	internal def pushInt(out byte[], value int, size int) {
		for let shift = (size - 1) * 8; shift >= 0; shift -= 8 {
			out.push(byte(value >> shift & 0xff))
		}
	}

	// dsFor is the DS record a parent publishes for the key, a DNSKEY
	// record of the child zone (RFC 4034 §5.1.4): the digest of the owner
	// name and the key data.
	// Fails when the record has no DNSKEY data.
	def dsFor(key dns.Record, digestType DigestType = DigestType.SHA256, ttl int = 3600) !dns.Record {
		let zoneKey = key.dnskey
		fail bogus("the key record has no DNSKEY data", key.name) when zoneKey is none
		let sum = try keyDigest(key, digestType.value)
		return dns.dsRecord(key.name, dns.DS{keyTag: zoneKey.keyTag(), algorithm: zoneKey.algorithm, digestType: digestType.value, digest: sum}, ttl)
	}

	// matches reports whether the DS record names the DNSKEY record: same
	// owner, key tag and algorithm, and the digest of the key. False for a
	// digest type that is not supported.
	def matches(ds dns.Record, key dns.Record) bool {
		let d = ds.ds
		let zoneKey = key.dnskey
		return false when d is none || zoneKey is none
		return false when dns.canonicalName(ds.name) != dns.canonicalName(key.name)
		return false when d.keyTag != zoneKey.keyTag() || d.algorithm != zoneKey.algorithm
		let sum = keyDigest(key, d.digestType) onerror recover byte[0]
		return sum.len() > 0 && constantTimeEqual(sum, d.digest)
	}

	internal def keyDigest(key dns.Record, digestType int) !byte[] {
		let hash = digestHash(digestType)
		fail bogus("DS digest type {digestType} is not supported", key.name) when hash is none
		let content = try dns.wireName(key.name)
		pushBytes(content, try key.wireData())
		return digest(hash, content)
	}
}
