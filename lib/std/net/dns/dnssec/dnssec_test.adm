partial module std.net.dns.dnssec {
	use (
		std.crypto::(newEd25519PrivateKey)
		std.net
		std.net.dns
		std.testing
		std.time
	)

	check "DNSSEC signatures" {
		// Answers of 2026-09-19, as the servers of `.` and `example.com`
		// signed them: RSA with SHA-256 and ECDSA over P-256.
		def root() !dns.Zone {
			let lines string[] = [
				"$ORIGIN .",
				"$TTL 86400",
				". SOA a.root-servers.net. nstld.verisign-grs.com. 2026091901 1800 900 604800 86400",
				". RRSIG SOA 8 0 86400 20261002170000 20260919160000 57780 . yRYchryt68kCc9F7+AunpygdbdOLhjr2Yf/C95k9T+G7ZwN3O9iZJ3rz kR1SPnw7itEgdsp3I8cL+5McQEFP69x4rwDG06ztPYhlbRJcfmUICDoR dzYatUpMOt/4PcU9FJ+yj1/e2iWKGCXb9u8POciDf3hm6q0WPKrtTzU9 dVU19rd7zWUqOnMO+LjxW2qqHLubXcRfHDrjaXlYQvUFneQwi41v+njK JUC/+oB20ghBmBirgWBCORq85CNU0ZEuBgp0471WTVpAdB36bFrzI89y kVuhYhy3q65IhdpCxICFmc3Yl8dSNXSTQ2+AqgrWpZE3g+XGu1BRyoe8 I9Pc0w==",
				". DNSKEY 256 3 8 AwEAAeCYD6Z7WWKVLeuWgowKP+3g+Gs1cnLKq7a3CaQx Qpv8bfuFVI0WnG33qaSH/Mw9IBgifrdzf4XY/DQLnyBJ 9MfaOyAWuEaEmYJ+GQPiwVVfstGwSA1McfFJUttTgq2H uu74KARhtA8wPo/N3XcyYQtNhz+qCM5NBb3ecx/naw6s Yab9LxS6f2cU0q03++BP5Ks0Uef8WJCa/1izCYE+vMkw oltV+tENa3hpXiZ7jle/xdgaZrPi5ZGmyLVI34g1XVYr NlsCCTmNvFQIfzW5STFQFsQpizczyFn9r3LzSxxPCNwd lCG84bER0BmdwqbF6Tanv+FxMOavrahkj4wIy5k=",
				". DNSKEY 257 3 8 AwEAAaz/tAm8yTn4Mfeh5eyI96WSVexTBAvkMgJzkKTO iW1vkIbzxeF3+/4RgWOq7HrxRixHlFlExOLAJr5emLvN 7SWXgnLh4+B5xQlNVz8Og8kvArMtNROxVQuCaSnIDdD5 LKyWbRd2n9WGe2R8PzgCmr3EgVLrjyBxWezF0jLHwVN8 efS3rCj/EWgvIWgb9tarpVUDK/b58Da+sqqls3eNbuv7 pr+eoZG+SrDK6nWeL3c6H5Apxz7LjVc1uTIdsIXxuOLY A4/ilBmSVIzuDWfdRUfhHdY6+cn8HFRm+2hM8AnXGXws 9555KrUB5qihylGa8subX2Nn6UwNR1AkUTV74bU=",
			]
			return try dns.parseZone(lines.join("\n") + "\n")
		}

		def example() !dns.Zone {
			let lines string[] = [
				"$ORIGIN example.com.",
				"$TTL 300",
				"@ SOA ns1 admin 1 1h 10m 1w 60",
				"@ A 172.66.147.243",
				"@ A 104.20.23.154",
				"@ RRSIG A 13 2 300 20260920213231 20260918193231 34505 example.com. Hz7DmmKFqOF+06L6wLRwfbyqGbAYbX9eTU2dxSU/q074LZCoQIqVXmWd 4B9I6tSSrXfKvWewMx+gPiS0CYf1xg==",
				"@ DNSKEY 256 3 13 oJMRESz5E4gYzS/q6XDrvU1qMPYIjCWzJaOau8XNEZeq CYKD5ar0IRd8KqXXFJkqmVfRvMGPmM1x8fGAa2XhSA==",
			]
			return try dns.parseZone(lines.join("\n") + "\n")
		}

		// keyTagged is the DNSKEY record of the zone with the key tag.
		def keyTagged(zone dns.Zone, tag int) !dns.Record {
			for let (_, r) in zone.find(zone.origin, dns.RecordType.DNSKEY) {
				let key = r.dnskey
				return r when !(key is none) && key.keyTag() == tag
			}
			fail "the zone has no key {tag}"
		}

		// refusal is the message `verify` fails with, "" when it passes.
		def refusal(records dns.Record[], signature dns.Record, key dns.Record, now time.Time) string {
			let message = ""
			verify(records, signature, key, now) onerror (err error) {
				message = err.message
				recover none
			}
			return message
		}

		@test()
		def TestVerifiesRealSignatures() !none {
			let now = try time.parse("2026-09-19T20:00:00Z")
			let zone = try root()
			let soa = zone.find(".", dns.RecordType.SOA)
			let sig = zone.find(".", dns.RecordType.RRSIG)[0]
			try verify(soa, sig, try keyTagged(zone, 57780), now)

			let com = try example()
			let addresses = com.find("example.com", dns.RecordType.A)
			let signed = com.find("example.com", dns.RecordType.RRSIG)[0]
			try verify(addresses, signed, try keyTagged(com, 34505), now)
			// The order of the records does not matter.
			try verify([addresses[1], addresses[0]], signed, try keyTagged(com, 34505), now)
		}

		@test()
		def TestRefusesWhatIsNotSigned() !none {
			let now = try time.parse("2026-09-19T20:00:00Z")
			let com = try example()
			let key = try keyTagged(com, 34505)
			let addresses = com.find("example.com", dns.RecordType.A)
			let signed = com.find("example.com", dns.RecordType.RRSIG)[0]

			assert refusal(addresses, signed, key, try time.parse("2026-09-21T00:00:00Z")).contains("expired")
			assert refusal(addresses, signed, key, try time.parse("2026-09-18T00:00:00Z")).contains("not valid yet")
			assert refusal([addresses[0]], signed, key, now).contains("does not verify")
			let forged = addresses[0].withTTL(300)
			forged.address = "192.0.2.1"
			assert refusal([forged, addresses[1]], signed, key, now).contains("does not verify")
			assert refusal(com.find("example.com", dns.RecordType.SOA), signed, key, now).contains("another record set")
			let zone = try root()
			assert refusal(addresses, signed, try keyTagged(zone, 57780), now).contains("another key")
			// The TTL a cache counted down is not the signed one.
			try verify([addresses[0].withTTL(12), addresses[1].withTTL(12)], signed, key, now)
		}

		@test()
		def TestDSOfTheRootKey() !none {
			let zone = try root()
			let ksk = try keyTagged(zone, 20326)
			let ds = try dsFor(ksk)
			let data = ds.ds
			fail "the DS record has no data" when data is none
			assert data.keyTag == 20326 && data.algorithm == 8 && data.digestType == 2
			assert data.digest.hex() == "E06D44B80B8F1D39A95C0B0D7C65D08458E880409BBC683457104237C7F8EC8D"
			assert matches(ds, ksk) && !matches(ds, try keyTagged(zone, 57780))
			assert matches(try dsFor(ksk, DigestType.SHA384), ksk)
			data.digest[0] = byte(0)
			assert !matches(ds, ksk)
		}

		@test()
		def TestSignsAndVerifies() !none {
			let key = try generateKey("example.test")
			let zoneKey = key.record.dnskey
			fail "the key record has no data" when zoneKey is none
			assert zoneKey.flags == 257 && zoneKey.algorithm == 13 && zoneKey.key.len() == 64
			let records dns.Record[] = [dns.addressRecord("www.example.test", "192.0.2.1"), dns.addressRecord("WWW.example.test", "192.0.2.2")]
			let sig = try key.sign(records)
			let data = sig.rrsig
			fail "the signature record has no data" when data is none
			assert data.labels == 3 && data.signer == "example.test" && data.signature.len() == 64 && data.keyTag == zoneKey.keyTag()
			try verify(records, sig, key.record)

			// A signature survives the wire.
			let m = new dns.Message()
			m.answers = [records[0], records[1], sig, key.record]
			let back = try dns.decode(try m.encode())
			try verify(back.answers[0:2], back.answers[2], back.answers[3])

			// An answer made from a wildcard verifies under the name asked for.
			let wild = try key.sign([dns.txtRecord("*.example.test", ["any"])])
			let made = dns.txtRecord("host.example.test", ["any"])
			let moved = wild.withTTL(wild.ttl)
			moved.name = "host.example.test"
			try verify([made], moved, key.record)

			let larger = try generateKey("example.test", KeyRole.ZoneSigning, dns.Algorithm.ECDSAP384SHA384)
			try verify(records, try larger.sign(records), larger.record)
			assert refusal(records, sig, larger.record, time.now()).contains("another key")
			let failed = false
			generateKey("example.test", KeyRole.ZoneSigning, dns.Algorithm.ED448) onerror (err error) {
				failed = true
				recover key
			}
			assert failed && !supports(dns.Algorithm.ED448) && supports(dns.Algorithm.RSASHA256)
		}

		@test()
		def TestEd25519Signatures() !none {
			// RFC 8080 §6.1: the key, its DS record and the signature it makes.
			let secret = try newEd25519PrivateKey("82260384628080122645190204142262".bytes())
			let key = try keyFrom("example.com", secret)
			let data = key.record.dnskey
			fail "the key record has no DNSKEY data" when data is none
			assert data.algorithm == 15 && data.keyTag() == 3613
			assert data.str() == "257 3 15 l02Woi0iS8Aa25FQkUd9RMzZHJpBoRQwAQEX1SxZJA4="
			let ds = (try dsFor(key.record)).ds
			fail "the DS record has no data" when ds is none
			assert ds.digest.hex().lower() == "3aa5ab37efce57f737fc1627013fee07bdf241bd10f3b1964ab55c78e79a304b"

			let zone = try dns.parseZone("$TTL 3600\n@ SOA ns1 admin 1 1h 10m 1w 60\n@ MX 10 mail.example.com.\n@ RRSIG MX 15 2 3600 1440021600 1438207200 3613 example.com. oL9krJun7xfBOIWcGHi7mag5/hdZrKWw15jPGrHpjQeRAvTdszaPD+QLs3fx8A4M3e23mRZ9VrbpMngwcrqNAg==\n", "example.com")
			let mx = zone.find("example.com", dns.RecordType.MX)
			let published = zone.find("example.com", dns.RecordType.RRSIG)[0]
			let now = try time.parse("2015-08-05T00:00:00Z")
			try verify(mx, published, key.record, now)

			// Ed25519 is deterministic: signing at the same times gives the
			// published signature.
			let made = try key.sign(mx, duration(1810800 * 1000000000), try time.parse("2015-07-29T23:00:00Z"))
			let ours = made.rrsig
			let theirs = published.rrsig
			fail "a signature record has no RRSIG data" when ours is none || theirs is none
			assert ours.inception == 1438207200 && ours.expiration == 1440021600
			assert ours.signature.hex() == theirs.signature.hex()

			assert supports(dns.Algorithm.ED25519) && !supports(dns.Algorithm.ED448)
			let fresh = try generateKey("example.test", KeyRole.KeySigning, dns.Algorithm.ED25519)
			let signed = try dns.parseZone("$TTL 300\n@ SOA ns1 admin 1 1h 10m 1w 60\n@ NS ns1\nwww A 192.0.2.1\n", "example.test")
			try signZone(signed, [fresh])
			for let (_, sig) in signed.find("www.example.test", dns.RecordType.RRSIG) {
				let covered = sig.rrsig
				continue when covered is none
				try verify(signed.find("www.example.test", covered.covered), sig, fresh.record)
			}
		}

		@test()
		def TestSignsAZone() !none {
			let lines string[] = [
				"$ORIGIN example.test.",
				"$TTL 300",
				"@ SOA ns1 admin 1 1h 10m 1w 60",
				"@ NS ns1",
				"ns1 A 192.0.2.53",
				"www A 192.0.2.1",
				"www A 192.0.2.2",
				"www AAAA 2001:db8::1",
				"*.apps TXT \"any\"",
				"child NS ns.child",
				"child DS 12345 13 2 00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff",
				"ns.child A 192.0.2.54",
			]
			let zone = try dns.parseZone(lines.join("\n") + "\n")
			let ksk = try generateKey("example.test")
			let zsk = try generateKey("example.test", KeyRole.ZoneSigning)
			try signZone(zone, [ksk, zsk])

			// The DNSKEY set is signed by the key signing key, the rest by
			// the zone signing key.
			let keys = zone.find("example.test", dns.RecordType.DNSKEY)
			assert keys.len() == 2
			let verified = 0
			for let (_, sig) in zone.find("example.test", dns.RecordType.RRSIG) {
				let data = sig.rrsig
				continue when data is none
				if data.covered == dns.RecordType.DNSKEY {
					try verify(keys, sig, ksk.record)
					verified++
					continue
				}
				try verify(zone.find("example.test", data.covered), sig, zsk.record)
				verified++
			}
			// SOA, NS, DNSKEY and NSEC.
			assert verified == 4
			let www = zone.find("www.example.test", dns.RecordType.RRSIG)
			assert www.len() == 3

			// The chain runs through the names in canonical order and back.
			let order string[] = ["example.test", "*.apps.example.test", "child.example.test", "ns1.example.test", "www.example.test"]
			for let (i, owner) in order {
				let link = zone.find(owner, dns.RecordType.NSEC)
				assert link.len() == 1
				let chain = link[0].nsec
				fail "the NSEC record has no data" when chain is none
				assert chain.next == order[(i + 1) % order.len()] && link[0].ttl == 60
			}
			let apex = zone.find("example.test", dns.RecordType.NSEC)[0].nsec
			fail "the NSEC record has no data" when apex is none
			assert apex.has(dns.RecordType.SOA) && apex.has(dns.RecordType.DNSKEY) && apex.has(dns.RecordType.RRSIG) && !apex.has(dns.RecordType.A)

			// A delegation: DS and NSEC signed, NS and glue not.
			let cut = zone.find("child.example.test", dns.RecordType.RRSIG)
			assert cut.len() == 2
			assert zone.find("ns.child.example.test", dns.RecordType.RRSIG).len() == 0
			assert zone.find("ns.child.example.test", dns.RecordType.NSEC).len() == 0

			// Signing again replaces what the first signing added.
			let before = zone.len()
			try zone.add(dns.addressRecord("new.example.test", "192.0.2.9"))
			try signZone(zone, [ksk, zsk])
			// The address, its NSEC and the signature of each.
			assert zone.len() == before + 4
			let moved = zone.find("child.example.test", dns.RecordType.NSEC)[0].nsec
			fail "the NSEC record has no data" when moved is none
			assert moved.next == "new.example.test"

			// An RSA key signs the same zone.
			let rsa = try generateKey("example.test", KeyRole.KeySigning, dns.Algorithm.RSASHA256)
			try signZone(zone, [rsa])
			let rsaKeys = zone.find("example.test", dns.RecordType.DNSKEY)
			assert rsaKeys.len() == 1
			for let (_, sig) in zone.find("www.example.test", dns.RecordType.RRSIG) {
				let data = sig.rrsig
				continue when data is none
				assert data.algorithm == dns.Algorithm.RSASHA256.value && data.signature.len() == 256
				try verify(zone.find("www.example.test", data.covered), sig, rsa.record)
			}

			let other = try generateKey("other.test")
			let failed = false
			signZone(zone, [other]) onerror (err error) {
				failed = true
				recover none
			}
			assert failed
		}

		// ask is the zone's answer to a query with the DO bit.
		def ask(zone dns.Zone, name string, kind dns.RecordType) !dns.Message {
			let query = try dns.newQuery(name, kind)
			query.edns = dns.EDNS{dnssecOK: true}
			return try zone.serve(dns.Request{message: query, remote: new net.Address()})
		}

		// proven verifies every record set of a section against the key and
		// returns how many it found.
		def proven(section dns.Record[], key dns.Record) !int {
			let sets = 0
			for let (_, sig) in section {
				let data = sig.rrsig
				continue when data is none
				let set dns.Record[]
				for let (_, r) in section {
					set.push(r) when r.kind == data.covered && dns.canonicalName(r.name) == dns.canonicalName(sig.name)
				}
				try verify(set, sig, key)
				sets++
			}
			return sets
		}

		@test()
		def TestASignedZoneAnswersWithProof() !none {
			let lines string[] = [
				"$ORIGIN example.test.",
				"$TTL 300",
				"@ SOA ns1 admin 1 1h 10m 1w 60",
				"@ NS ns1",
				"ns1 A 192.0.2.53",
				"www A 192.0.2.1",
				"alias CNAME www",
				"*.apps TXT \"any\"",
				"deep.down.below A 192.0.2.7",
			]
			let zone = try dns.parseZone(lines.join("\n") + "\n")
			let key = try generateKey("example.test")
			try signZone(zone, [key])

			let plain = try zone.serve(dns.Request{message: try dns.newQuery("www.example.test"), remote: new net.Address()})
			assert plain.answers.len() == 1 && plain.authorities.len() == 0

			let positive = try ask(zone, "www.example.test", dns.RecordType.A)
			let options = positive.edns
			assert positive.answers.len() == 2 && !(options is none) && options.dnssecOK
			assert (try proven(positive.answers, key.record)) == 1

			let aliased = try ask(zone, "alias.example.test", dns.RecordType.A)
			assert aliased.answers.len() == 4 && (try proven(aliased.answers, key.record)) == 2

			// A wildcard answer proves that the name itself does not exist.
			let wild = try ask(zone, "one.apps.example.test", dns.RecordType.TXT)
			assert wild.answers.len() == 2 && wild.answers[0].name == "one.apps.example.test"
			assert (try proven(wild.answers, key.record)) == 1 && (try proven(wild.authorities, key.record)) == 1
			assert wild.authorities[0].kind == dns.RecordType.NSEC && wild.authorities[0].name == "*.apps.example.test"

			// No data: the NSEC record of the name lists what it has.
			let nodata = try ask(zone, "www.example.test", dns.RecordType.MX)
			assert nodata.rcode == dns.RCode.Success && nodata.answers.len() == 0
			assert (try proven(nodata.authorities, key.record)) == 2
			let listed = nodata.authorities[2].nsec
			fail "the NSEC record has no data" when listed is none
			assert nodata.authorities[2].name == "www.example.test" && listed.has(dns.RecordType.A) && !listed.has(dns.RecordType.MX)

			// No name: one NSEC covers the name, one the wildcard above it.
			let missing = try ask(zone, "nothing.example.test", dns.RecordType.A)
			assert missing.rcode == dns.RCode.NameError && (try proven(missing.authorities, key.record)) == 3
			let owners string[]
			for let (_, r) in missing.authorities {
				owners.push(r.name) when r.kind == dns.RecordType.NSEC
			}
			assert owners.len() == 2 && owners.includes("deep.down.below.example.test") && owners.includes("example.test")

			// An empty name between two that exist has no NSEC of its own.
			let between = try ask(zone, "down.below.example.test", dns.RecordType.A)
			assert between.rcode == dns.RCode.Success && between.answers.len() == 0
			assert (try proven(between.authorities, key.record)) == 2
		}

		// tagsOf is the RRSIG key tags covering the record type at the owner.
		def tagsOf(zone dns.Zone, owner string, kind dns.RecordType) int[] {
			let out int[]
			for let (_, sig) in zone.find(owner, dns.RecordType.RRSIG) {
				let data = sig.rrsig
				out.push(data.keyTag) when !(data is none) && data.covered == kind
			}
			return out
		}

		// sameTags reports whether the two key tag sets hold the same tags.
		def sameTags(got int[], want int[]) bool {
			return false when got.len() != want.len()
			for let (_, w) in want {
				return false unless got.includes(w)
			}
			return true
		}

		// tagOf is a key's own key tag, -1 when the record has no DNSKEY data.
		def tagOf(key Key) int {
			let data = key.record.dnskey
			return -1 when data is none
			return data.keyTag()
		}

		// dnskeySig is the RRSIG record over the zone's DNSKEY set.
		def dnskeySig(zone dns.Zone) dns.Record {
			for let (_, sig) in zone.find(zone.origin, dns.RecordType.RRSIG) {
				let data = sig.rrsig
				return sig when !(data is none) && data.covered == dns.RecordType.DNSKEY
			}
			return new dns.Record()
		}

		@test()
		def TestZSKRollover() !none {
			let lines string[] = [
				"$ORIGIN example.test.",
				"$TTL 300",
				"@ SOA ns1 admin 1 1h 10m 1w 60",
				"@ NS ns1",
				"ns1 A 192.0.2.53",
				"www A 192.0.2.1",
			]
			let zone = try dns.parseZone(lines.join("\n") + "\n")
			let ksk = try generateKey("example.test")
			let oldZSK = try generateKey("example.test", KeyRole.ZoneSigning)
			let newZSK = try generateKey("example.test", KeyRole.ZoneSigning)

			// The new key is pre-published only; the old one signs alone
			// (RFC 6781 §4.1.1).
			newZSK.signs = false
			try signZone(zone, [ksk, oldZSK, newZSK])
			assert sameTags(tagsOf(zone, "www.example.test", dns.RecordType.A), [tagOf(oldZSK)])
			let published = zone.find("example.test", dns.RecordType.DNSKEY)
			assert published.len() == 3
			try verify(published, dnskeySig(zone), ksk.record)

			// Both keys sign during the rollover.
			newZSK.signs = true
			try signZone(zone, [ksk, oldZSK, newZSK])
			assert sameTags(tagsOf(zone, "www.example.test", dns.RecordType.A), [tagOf(oldZSK), tagOf(newZSK)])
			published = zone.find("example.test", dns.RecordType.DNSKEY)
			assert published.len() == 3
			try verify(published, dnskeySig(zone), ksk.record)

			// The new key takes over; the old one lingers published only.
			oldZSK.signs = false
			try signZone(zone, [ksk, oldZSK, newZSK])
			assert sameTags(tagsOf(zone, "www.example.test", dns.RecordType.A), [tagOf(newZSK)])
			published = zone.find("example.test", dns.RecordType.DNSKEY)
			assert published.len() == 3
			try verify(published, dnskeySig(zone), ksk.record)
		}

		@test()
		def TestChildRecords() !none {
			let ksk = try generateKey("example.test")
			let made = try ksk.childRecords()
			assert made.len() == 2
			let cds = made[0]
			let cdnskey = made[1]
			assert cds.kind == dns.RecordType.CDS && cdnskey.kind == dns.RecordType.CDNSKEY
			assert cds.name == "example.test" && cdnskey.name == "example.test"
			assert cds.ttl == ksk.record.ttl && cdnskey.ttl == ksk.record.ttl

			let wantDS = (try dsFor(ksk.record)).ds
			let gotDS = cds.ds
			fail "the CDS record has no data" when gotDS is none || wantDS is none
			assert gotDS.keyTag == wantDS.keyTag && gotDS.algorithm == wantDS.algorithm
			assert gotDS.digestType == wantDS.digestType && gotDS.digest.hex() == wantDS.digest.hex()

			let wantKey = ksk.record.dnskey
			let gotKey = cdnskey.dnskey
			fail "the CDNSKEY record has no data" when gotKey is none || wantKey is none
			assert gotKey.flags == wantKey.flags && gotKey.algorithm == wantKey.algorithm && gotKey.key.hex() == wantKey.key.hex()

			// The pair comes out of a zone file unchanged.
			let lines string[] = [
				"$ORIGIN example.test.",
				"$TTL 300",
				"@ SOA ns1 admin 1 1h 10m 1w 60",
				"@ NS ns1",
				"ns1 A 192.0.2.53",
			]
			let zone = try dns.parseZone(lines.join("\n") + "\n")
			try zone.add(cds)
			try zone.add(cdnskey)
			let back = try dns.parseZone(zone.str())
			let backDS = back.find("example.test", dns.RecordType.CDS)
			let backKey = back.find("example.test", dns.RecordType.CDNSKEY)
			assert backDS.len() == 1 && backKey.len() == 1
			let backDSData = backDS[0].ds
			let backKeyData = backKey[0].dnskey
			fail "the parsed CDS or CDNSKEY has no data" when backDSData is none || backKeyData is none
			assert backDSData.digest.hex() == wantDS.digest.hex() && backKeyData.key.hex() == wantKey.key.hex()

			// signZone signs the CDS and CDNSKEY sets with the key signing key.
			try signZone(zone, [ksk])
			let tag = tagOf(ksk)
			assert sameTags(tagsOf(zone, "example.test", dns.RecordType.CDS), [tag])
			assert sameTags(tagsOf(zone, "example.test", dns.RecordType.CDNSKEY), [tag])
		}

		@test()
		def TestDeleteChildRecords() !none {
			let made = deleteChildRecords("example.test")
			assert made.len() == 2
			let cds = made[0]
			let cdnskey = made[1]
			assert cds.kind == dns.RecordType.CDS && cds.name == "example.test" && cds.ttl == 3600
			assert cdnskey.kind == dns.RecordType.CDNSKEY && cdnskey.name == "example.test" && cdnskey.ttl == 3600
			let cdsData = cds.ds
			let cdnskeyData = cdnskey.dnskey
			fail "the delete CDS has no data" when cdsData is none
			fail "the delete CDNSKEY has no data" when cdnskeyData is none
			assert cdsData.keyTag == 0 && cdsData.algorithm == 0 && cdsData.digestType == 0 && cdsData.digest.hex() == "00"
			assert cdnskeyData.flags == 0 && cdnskeyData.protocol == 3 && cdnskeyData.algorithm == 0 && cdnskeyData.key.hex() == "00"

			// The pair encodes and parses.
			let m = new dns.Message()
			m.answers = [cds, cdnskey]
			let back = try dns.decode(try m.encode())
			let backDS = back.answers[0].ds
			let backKey = back.answers[1].dnskey
			fail "the decoded CDS or CDNSKEY has no data" when backDS is none || backKey is none
			assert backDS.digest.hex() == "00" && backKey.key.hex() == "00"
		}
	}
}
