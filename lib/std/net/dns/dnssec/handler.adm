// A `dns.Handler` that answers over a `Validator`, the way a validating
// local resolver does (RFC 4035 §3.2).
//
// ```
// let handler = new dnssec.ValidatingHandler(new dnssec.Validator(new dns.Client(["1.1.1.1"])))
// let server = new dns.Server("127.0.0.1:53", handler)
// try server.listenAndServe()
// ```

partial module std.net.dns.dnssec {
	use std.net.dns

	// ValidatingHandler answers a client's queries by asking a `Validator`
	// and copying its answer into the client's own query (`dns.Message.reply`).
	// The AD bit is set only when the answer is Secure and the client asked
	// to see it, with its own AD bit or the DO bit (RFC 6840 §§5.7-5.8);
	// without the DO bit, RRSIG, NSEC and NSEC3 records that are not the
	// question's own type are left out of every section.
	//
	// A Bogus answer never reaches the client: it, and any other failure to
	// answer (a timeout, no servers), comes back as ServerFailure. A client
	// that sets `checkingDisabled` validates by itself (RFC 4035 §3.2.2):
	// its answer comes from the validator's client as it is, without the
	// AD bit.
	type ValidatingHandler {
		validator Validator

		def new(validator Validator) {
			self.validator = validator
		}

		// Implements dns.Handler. Does not fail: every outcome becomes a
		// response, ServerFailure for a query the validator could not answer.
		def serve(request dns.Request) !dns.Message {
			let clientQuery = request.message
			return clientQuery.reply(dns.RCode.NotImplemented) when clientQuery.opcode != dns.Opcode.Query
			let question = clientQuery.question()
			return clientQuery.reply(dns.RCode.FormatError) when question is none

			let options = clientQuery.edns
			let doBit = !(options is none) && options.dnssecOK
			let wantsAD = clientQuery.authenticData || doBit

			let answer ?dns.Message = none
			if clientQuery.checkingDisabled {
				answer = tryFetch(question.name, question.kind) onerror recover none
			} else {
				answer = tryQuery(question.name, question.kind) onerror recover none
			}
			if answer is none {
				let failed = clientQuery.reply(dns.RCode.ServerFailure)
				failed.recursionAvailable = true
				return failed
			}

			let response = clientQuery.reply(answer.rcode)
			response.recursionAvailable = true
			response.authenticData = answer.authenticData && wantsAD
			response.answers = doBit ?? (answer.answers, stripUnsigned(answer.answers, question.kind))
			response.authorities = doBit ?? (answer.authorities, stripUnsigned(answer.authorities, question.kind))
			response.additionals = doBit ?? (answer.additionals, stripUnsigned(answer.additionals, question.kind))
			return response
		}

		// The answer without validation, with the signatures a client that
		// validates by itself needs.
		internal def tryFetch(name string, kind dns.RecordType) !?dns.Message {
			let client = validator.client
			let message = try dns.newQuery(name, kind)
			message.recursionDesired = client.recursionDesired
			message.checkingDisabled = true
			message.edns = dns.EDNS{dnssecOK: true}
			let response = try client.exchange(message)
			response.authenticData = false
			return response
		}

		// `validator.query` as an optional, so a failure can recover to none.
		internal def tryQuery(name string, kind dns.RecordType) !?dns.Message {
			return try validator.query(name, kind)
		}
	}

	// stripUnsigned drops the RRSIG, NSEC and NSEC3 records that are not the
	// type asked for, for a client that did not set the DO bit.
	internal def stripUnsigned(records dns.Record[], asked dns.RecordType) dns.Record[] {
		let out dns.Record[]
		for let (_, r) in records {
			let dnssecOnly = r.kind := dns.RecordType.RRSIG || dns.RecordType.NSEC || dns.RecordType.NSEC3
			out.push(r) unless dnssecOnly && r.kind != asked
		}
		return out
	}
}
