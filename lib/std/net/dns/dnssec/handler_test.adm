partial module std.net.dns.dnssec {
	use (
		std.net
		std.net.dns
		std.testing
	)

	check "ValidatingHandler" {
		def zoneOf(lines string[]) !dns.Zone {
			return try dns.parseZone(lines.join("\n") + "\n")
		}

		// world builds a root and, delegated straight from it, the signed
		// `example.test` and the unsigned `plain.test`, and returns the
		// transport with the root key.
		def world() !(Authorities, Key) {
			let rootKey = try generateKey(".")
			let exampleKey = try generateKey("example.test")

			let root = try zoneOf([
				"$ORIGIN .",
				"$TTL 300",
				"@ SOA ns. admin. 1 1h 10m 1w 60",
				"@ NS ns.",
				"ns. A 192.0.2.1",
				"example.test. NS ns.example.test.",
				"ns.example.test. A 192.0.2.3",
				"plain.test. NS ns.plain.test.",
				"ns.plain.test. A 192.0.2.4",
			])
			try root.add(try dsFor(exampleKey.record))
			try signZone(root, [rootKey])

			let example = try zoneOf([
				"$ORIGIN example.test.",
				"$TTL 300",
				"@ SOA ns admin 1 1h 10m 1w 60",
				"@ NS ns",
				"ns A 192.0.2.3",
				"www A 192.0.2.10",
			])
			try signZone(example, [exampleKey])

			let plain = try zoneOf([
				"$ORIGIN plain.test.",
				"$TTL 300",
				"@ SOA ns admin 1 1h 10m 1w 60",
				"@ NS ns",
				"ns A 192.0.2.4",
				"www A 192.0.2.20",
			])

			let mux = new dns.Mux()
			mux.handle(".", root)
			mux.handle("example.test", example)
			mux.handle("plain.test", plain)
			return (new Authorities(mux), rootKey)
		}

		def handlerOver(wire Authorities, anchors dns.Record[]) ValidatingHandler {
			let client = new dns.Client(["authorities"])
			client.transport = wire
			client.attempts = 1
			return new ValidatingHandler(new Validator(client, anchors))
		}

		// asked builds the client's query, with the DO bit when `secure`, the
		// AD bit when `ad`, and runs it through the handler.
		def asked(handler ValidatingHandler, name string, secure bool, ad bool = false) !dns.Message {
			let query = try dns.newQuery(name, dns.RecordType.A)
			query.authenticData = ad
			query.edns = dns.EDNS{dnssecOK: secure} when secure
			return try handler.serve(dns.Request{message: query, remote: new net.Address()})
		}

		@test()
		def TestSecureAnswerSetsADForTheClientThatAsksForIt() !none {
			let (wire, rootKey) = try world()
			let handler = handlerOver(wire, [try dsFor(rootKey.record)])

			let withDO = try asked(handler, "www.example.test", true)
			assert withDO.authenticData && withDO.rcode == dns.RCode.Success

			let withAD = try asked(handler, "www.example.test", false, true)
			assert withAD.authenticData

			let plain = try asked(handler, "www.example.test", false)
			assert !plain.authenticData
			for let (_, r) in plain.answers {
				assert r.kind != dns.RecordType.RRSIG
			}

			let hasRRSIG = false
			for let (_, r) in withDO.answers {
				hasRRSIG = true when r.kind == dns.RecordType.RRSIG
			}
			assert hasRRSIG
		}

		@test()
		def TestAnInsecureZoneAnswersWithoutAD() !none {
			let (wire, rootKey) = try world()
			let handler = handlerOver(wire, [try dsFor(rootKey.record)])

			let response = try asked(handler, "www.plain.test", true)
			assert !response.authenticData && response.answers.len() == 1
			assert response.answers[0].address == "192.0.2.20"
		}

		@test()
		def TestNXDOMAINPassesThroughWithItsRCode() !none {
			let (wire, rootKey) = try world()
			let handler = handlerOver(wire, [try dsFor(rootKey.record)])

			let response = try asked(handler, "nothing.example.test", true)
			assert response.authenticData && response.rcode == dns.RCode.NameError
		}

		@test()
		def TestASpoiledUpstreamGivesServerFailure() !none {
			let (wire, rootKey) = try world()
			wire.spoil = "address"
			let handler = handlerOver(wire, [try dsFor(rootKey.record)])

			let response = try asked(handler, "www.example.test", true)
			assert response.rcode == dns.RCode.ServerFailure

			// A client that validates by itself gets the answer as it came.
			let query = try dns.newQuery("www.example.test", dns.RecordType.A)
			query.checkingDisabled = true
			query.edns = dns.EDNS{dnssecOK: true}
			let raw = try handler.serve(dns.Request{message: query, remote: new net.Address()})
			assert raw.rcode == dns.RCode.Success && !raw.authenticData && raw.checkingDisabled
			assert raw.answers.len() == 2 && raw.answers[0].address == "203.0.113.66"
		}

		@test()
		def TestRefusesUnsupportedQueries() !none {
			let (wire, rootKey) = try world()
			let handler = handlerOver(wire, [try dsFor(rootKey.record)])

			let status = try dns.newQuery("www.example.test", dns.RecordType.A)
			status.opcode = dns.Opcode.Status
			let notImplemented = try handler.serve(dns.Request{message: status, remote: new net.Address()})
			assert notImplemented.rcode == dns.RCode.NotImplemented

			let bare = new dns.Message()
			bare.opcode = dns.Opcode.Query
			let formatError = try handler.serve(dns.Request{message: bare, remote: new net.Address()})
			assert formatError.rcode == dns.RCode.FormatError
		}
	}
}
