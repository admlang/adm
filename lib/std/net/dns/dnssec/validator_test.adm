partial module std.net.dns.dnssec {
	use (
		std.net
		std.net.dns
		std.testing
		std.time
	)

	// Authorities answers from a `Mux` of zones in place of the network,
	// through the wire form. `spoil` names what it does to a response on
	// the way: "address" rewrites the A records, "strip" drops the
	// signatures of the answer, "deny" turns the answer into a bare
	// name error.
	internal type Authorities {
		mux   dns.Mux
		spoil string  = ""
		asked int     = 0

		def new(mux dns.Mux) {
			self.mux = mux
		}

		// Implements dns.Transport.
		def exchange(query dns.Message, server string, timeout duration) !dns.Message {
			asked++
			let served = try mux.serve(dns.Request{message: query, remote: new net.Address()})
			let response = try dns.decode(try served.encode())
			let question = response.question()
			return response when question is none || question.kind != dns.RecordType.A
			if spoil == "address" {
				for let (_, r) in response.answers {
					r.address = "203.0.113.66" when r.kind == dns.RecordType.A
				}
			}
			if spoil == "strip" {
				let kept dns.Record[]
				for let (_, r) in response.answers {
					kept.push(r) unless r.kind == dns.RecordType.RRSIG
				}
				response.answers = kept
			}
			if spoil == "deny" {
				response.answers = []
				response.authorities = []
				response.rcode = dns.RCode.NameError
			}
			return response
		}
	}

	check "DNSSEC validator" {
		def zoneOf(lines string[]) !dns.Zone {
			return try dns.parseZone(lines.join("\n") + "\n")
		}

		// world builds the root, `test`, the signed `example.test` and the
		// unsigned `plain.test`, and returns the transport with the root key.
		// With `hashed` the zones are linked by NSEC3 records, `test` with
		// opt-out, which leaves `plain.test` out of its chain.
		def world(hashed bool = false) !(Authorities, Key) {
			let chain ?dns.NSEC3 = none
			let sparse ?dns.NSEC3 = none
			if hashed {
				let salted = new dns.NSEC3()
				salted.salt = [byte(0xab), byte(0xcd)]
				salted.iterations = 2
				chain = salted
				let optOut = new dns.NSEC3()
				optOut.flags = 1
				sparse = optOut
			}
			let rootKey = try generateKey(".")
			let testKey = try generateKey("test")
			let exampleKey = try generateKey("example.test")

			let root = try zoneOf([
				"$ORIGIN .",
				"$TTL 300",
				"@ SOA ns. admin. 1 1h 10m 1w 60",
				"@ NS ns.",
				"ns. A 192.0.2.1",
				"test. NS ns.test.",
				"ns.test. A 192.0.2.2",
			])
			try root.add(try dsFor(testKey.record))
			try signZone(root, [rootKey], 720h, none, chain)

			let test = try zoneOf([
				"$ORIGIN test.",
				"$TTL 300",
				"@ SOA ns admin 1 1h 10m 1w 60",
				"@ NS ns",
				"ns A 192.0.2.2",
				"example NS ns.example",
				"ns.example A 192.0.2.3",
				"plain NS ns.plain",
				"ns.plain A 192.0.2.4",
			])
			try test.add(try dsFor(exampleKey.record))
			try signZone(test, [testKey], 720h, none, sparse)

			let example = try zoneOf([
				"$ORIGIN example.test.",
				"$TTL 300",
				"@ SOA ns admin 1 1h 10m 1w 60",
				"@ NS ns",
				"ns A 192.0.2.3",
				"www A 192.0.2.10",
				"alias CNAME www",
				"*.apps TXT \"any\"",
				"deep.down.below A 192.0.2.7",
			])
			try signZone(example, [exampleKey], 720h, none, chain)

			let plain = try zoneOf([
				"$ORIGIN plain.test.",
				"$TTL 300",
				"@ SOA ns admin 1 1h 10m 1w 60",
				"@ NS ns",
				"ns A 192.0.2.4",
				"www A 192.0.2.20",
			])

			let mux = new dns.Mux()
			mux.handle(".", root)
			mux.handle("test", test)
			mux.handle("example.test", example)
			mux.handle("plain.test", plain)
			return (new Authorities(mux), rootKey)
		}

		def validatorOver(wire Authorities, anchors dns.Record[]) Validator {
			let client = new dns.Client(["authorities"])
			client.transport = wire
			client.attempts = 1
			return new Validator(client, anchors)
		}

		// kindOf is the error kind `query` fails with, "" when it passes.
		def kindOf(validator Validator, name string, kind dns.RecordType) string {
			let out = ""
			validator.query(name, kind) onerror (err error) {
				out = "other"
				out = err.kind.value when err is dns.DNSError
				recover new dns.Message()
			}
			return out
		}

		@test()
		def TestValidatesAChainFromTheAnchor() !none {
			let (wire, rootKey) = try world()
			let validator = validatorOver(wire, [try dsFor(rootKey.record)])

			let positive = try validator.query("www.example.test")
			assert positive.authenticData && positive.answers.len() == 2

			// The keys of the three zones are kept: only the question goes out.
			let before = wire.asked
			let aliased = try validator.query("alias.example.test")
			assert aliased.authenticData && wire.asked == before + 1

			let wild = try validator.query("one.apps.example.test", dns.RecordType.TXT)
			assert wild.authenticData && wild.answers[0].name == "one.apps.example.test"

			let found = try validator.lookup("alias.example.test")
			assert found.len() == 1 && found[0].address == "192.0.2.10"

			// A DNSKEY record works as the anchor too.
			let byKey = validatorOver(wire, [rootKey.record])
			assert (try byKey.query("www.example.test")).authenticData
		}

		@test()
		def TestValidatesDenials() !none {
			let (wire, rootKey) = try world()
			let validator = validatorOver(wire, [rootKey.record])

			let nodata = try validator.query("www.example.test", dns.RecordType.MX)
			assert nodata.authenticData && nodata.rcode == dns.RCode.Success && nodata.answers.len() == 0

			let missing = try validator.query("nothing.example.test")
			assert missing.authenticData && missing.rcode == dns.RCode.NameError

			// A name without records between two that exist.
			let between = try validator.query("down.below.example.test")
			assert between.authenticData && between.rcode == dns.RCode.Success

			// The wildcard answers for the name, without the type.
			let wild = try validator.query("one.apps.example.test", dns.RecordType.A)
			assert wild.authenticData && wild.answers.len() == 0

			let kind = ""
			validator.lookup("nothing.example.test") onerror (err error) {
				kind = err.kind.value when err is dns.DNSError
				let nothing dns.Record[]
				recover nothing
			}
			assert kind == dns.ErrorKind.NotFound.value
		}

		@test()
		def TestValidatesHashedDenials() !none {
			let (wire, rootKey) = try world(true)
			let validator = validatorOver(wire, [rootKey.record])

			let positive = try validator.query("www.example.test")
			assert positive.authenticData

			let nodata = try validator.query("www.example.test", dns.RecordType.MX)
			assert nodata.authenticData && nodata.answers.len() == 0
			let links = 0
			for let (_, r) in nodata.authorities {
				links++ when r.kind == dns.RecordType.NSEC3
			}
			assert links == 1

			let missing = try validator.query("nothing.example.test")
			assert missing.authenticData && missing.rcode == dns.RCode.NameError

			let between = try validator.query("down.below.example.test")
			assert between.authenticData && between.rcode == dns.RCode.Success

			let wild = try validator.query("one.apps.example.test", dns.RecordType.TXT)
			assert wild.authenticData && wild.answers.len() == 2
			let bare = try validator.query("one.apps.example.test", dns.RecordType.A)
			assert bare.authenticData && bare.answers.len() == 0

			// Opt-out: the span over `plain.test` allows an unsigned
			// delegation there, and proves nothing about other names.
			let plain = try validator.query("www.plain.test")
			assert !plain.authenticData && plain.answers.len() == 1
			let absent = try validator.query("nothing.test")
			assert !absent.authenticData && absent.rcode == dns.RCode.NameError

			wire.spoil = "deny"
			let strict = validatorOver(wire, [rootKey.record])
			assert kindOf(strict, "www.example.test", dns.RecordType.A) == dns.ErrorKind.Bogus.value
		}

		@test()
		def TestAnUnsignedDelegationIsInsecure() !none {
			let (wire, rootKey) = try world()
			let validator = validatorOver(wire, [rootKey.record])

			let response = try validator.query("www.plain.test")
			assert !response.authenticData && response.answers.len() == 1
			assert (try validator.validate(response)) == Security.Insecure
			assert (try validator.lookup("www.plain.test"))[0].address == "192.0.2.20"

			let missing = try validator.query("nothing.plain.test")
			assert !missing.authenticData && missing.rcode == dns.RCode.NameError

			// Without an anchor above the name nothing can be said.
			let exampleOnly = validatorOver(wire, [try dsFor((try generateKey("example.test")).record)])
			assert (try exampleOnly.validate(response)) == Security.Indeterminate
		}

		@test()
		def TestRefusesWhatDoesNotValidate() !none {
			let (wire, rootKey) = try world()
			let bogusKind = dns.ErrorKind.Bogus.value

			for let (_, spoil) in ["address", "strip", "deny"] {
				wire.spoil = spoil
				let validator = validatorOver(wire, [rootKey.record])
				assert kindOf(validator, "www.example.test", dns.RecordType.A) == bogusKind
			}
			wire.spoil = ""

			// Another key than the one the anchor names.
			let stranger = validatorOver(wire, [(try generateKey(".")).record])
			assert kindOf(stranger, "www.example.test", dns.RecordType.A) == bogusKind

			// The signatures last thirty days.
			let late = validatorOver(wire, [rootKey.record])
			late.now = time.now() + 1440h
			assert kindOf(late, "www.example.test", dns.RecordType.A) == bogusKind

			let fine = validatorOver(wire, [rootKey.record])
			assert kindOf(fine, "www.example.test", dns.RecordType.A) == ""
		}

		@test()
		def TestADSOfAnotherKeyBreaksTheChain() !none {
			let (wire, rootKey) = try world()
			let other = try generateKey("example.test")
			let zone = try zoneOf([
				"$ORIGIN example.test.",
				"$TTL 300",
				"@ SOA ns admin 1 1h 10m 1w 60",
				"@ NS ns",
				"www A 192.0.2.66",
			])
			try signZone(zone, [other])
			wire.mux.handle("example.test", zone)
			let validator = validatorOver(wire, [rootKey.record])
			assert kindOf(validator, "www.example.test", dns.RecordType.A) == dns.ErrorKind.Bogus.value
		}

		@test()
		def TestHashesNamesForNSEC3() !none {
			// RFC 5155 appendix A: salt aabbccdd, 12 iterations.
			let chain = new dns.NSEC3()
			chain.salt = [byte(0xaa), byte(0xbb), byte(0xcc), byte(0xdd)]
			chain.iterations = 12
			assert dns.hashLabel(try chain.hash("example")) == "0p9mhaveqvm6t7vbl5lop2u3t2rp3tom"
			assert dns.hashLabel(try chain.hash("a.example")) == "35mthgpgcu1qg68fab165klnsnk3dpvl"
		}
	}
}
