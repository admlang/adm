partial module std.net.dns {
	use (
		std.net
		std.testing
	)

	check "Incremental transfer" {
		def exampleZone() !Zone {
			let zone = try parseZone("$TTL 300\n@ SOA ns1 admin 1 1h 10m 1w 60\n@ NS ns1\nns1 A 192.0.2.53\nwww A 192.0.2.1\nold A 192.0.2.8\nmail A 192.0.2.25\n", "example.test")
			zone.allowTransfer = ["127.0.0.1"]
			return zone
		}

		// serialsOf is the serials the steps run through, as `1>2 2>3`.
		def serialsOf(steps ?ZoneChange[]) string {
			return "none" when steps is none
			let out string[]
			for let (_, step) in steps {
				out.push("{serialIn(step.before)}>{serialIn(step.after)}")
			}
			return out.join(" ")
		}

		@test()
		def TestAZoneRemembersItsChanges() !none {
			let zone = try exampleZone()
			// Loading the zone is as big a step as the zone: not kept.
			try zone.publish()
			assert serialsOf(zone.changesSince(1)) == "none" && serialsOf(zone.changesSince(2)) == ""

			try zone.add(addressRecord("new.example.test", "192.0.2.9"))
			zone.remove("old.example.test")
			// What came and went between two serials is in no step.
			try zone.add(addressRecord("brief.example.test", "192.0.2.77"))
			zone.remove("brief.example.test")
			try zone.publish()
			try zone.add(addressRecord("newer.example.test", "192.0.2.10"))
			try zone.publish()
			assert serialsOf(zone.changesSince(2)) == "2>3 3>4" && serialsOf(zone.changesSince(3)) == "3>4"
			let steps = zone.changesSince(2)
			fail "the zone forgot its steps" when steps is none
			let first = steps[0]
			assert first.removed.len() == 1 && first.removed[0].address == "192.0.2.8"
			assert first.added.len() == 1 && first.added[0].address == "192.0.2.9"

			// A dynamic update is a step too.
			let update = new Update("example.test")
			update.add(addressRecord("www.example.test", "192.0.2.1", 60))
			let (code, _) = zone.apply(try update.message())
			assert code == RCode.Success && serialsOf(zone.changesSince(4)) == "4>5"
			let retimed = zone.changesSince(4)
			fail "the zone forgot the update" when retimed is none
			assert retimed[0].removed[0].ttl == 300 && retimed[0].added[0].ttl == 60

			// No further back than `history`, and not at all without one.
			zone.history = 2
			try zone.add(addressRecord("last.example.test", "192.0.2.11"))
			try zone.publish()
			assert serialsOf(zone.changesSince(3)) == "none" && serialsOf(zone.changesSince(4)) == "4>5 5>6"
			zone.history = 0
			try zone.add(addressRecord("untold.example.test", "192.0.2.12"))
			try zone.publish()
			assert serialsOf(zone.changesSince(6)) == "none"
			return none
		}

		@test()
		def TestPatchAndReplace() !none {
			let primary = try exampleZone()
			let copy = try exampleZone()
			try primary.publish()
			try copy.publish()
			try primary.add(addressRecord("new.example.test", "192.0.2.9"))
			primary.remove("old.example.test")
			try primary.publish()
			let steps = primary.changesSince(2)
			fail "the primary forgot its steps" when steps is none
			try copy.patch(steps)
			assert copy.str() == primary.str() && serialsOf(copy.changesSince(2)) == "2>3"
			// The same steps do not fit a second time.
			let kind = ""
			copy.patch(steps) onerror (err error) {
				kind = err.kind.value when err is DNSError
				recover none
			}
			assert kind == ErrorKind.Malformed.value

			try copy.replace((try exampleZone()).all())
			assert serialOf(copy) == 1 && copy.len() == 6 && serialsOf(copy.changesSince(2)) == "none"
			kind = ""
			copy.replace([addressRecord("www.other.test", "192.0.2.1")]) onerror (err error) {
				kind = err.kind.value when err is DNSError
				recover none
			}
			assert kind == ErrorKind.BadName.value && copy.len() == 6
			return none
		}

		@test()
		def TestIncrementalTransfer() !none {
			let zone = try exampleZone()
			try zone.publish()
			let server = new Server("127.0.0.1:0", zone)
			try server.start()
			let at = server.address().str()
			let client = new Client([at])
			client.useHosts = false
			client.timeout = 5s

			// A copy without a SOA record takes the whole zone.
			let copy = new Zone("example.test")
			assert (try client.transfer(copy, at)) && copy.str() == zone.str()
			// Nothing to bring.
			assert !(try client.transfer(copy, at))

			// Two steps behind, brought as steps.
			try zone.add(addressRecord("new.example.test", "192.0.2.9"))
			zone.remove("old.example.test")
			try zone.publish()
			try zone.add(txtRecord("example.test", ["v=spf1 -all"]))
			try zone.publish()
			assert (try client.transfer(copy, at)) && copy.str() == zone.str()
			assert serialsOf(copy.changesSince(2)) == "2>3 3>4"

			// Further behind than the zone remembers: the whole zone.
			let stale = try exampleZone()
			assert (try client.transfer(stale, at)) && stale.str() == zone.str()
			assert serialsOf(stale.changesSince(1)) == "none"

			// Steps too many for one message.
			for let i = 0; i < 1500; i++ {
				try zone.add(txtRecord("n{i}.example.test", ["record number {i} of a change too long for one message of a transfer"]))
			}
			try zone.publish()
			for let i = 0; i < 700; i++ {
				zone.remove("n{i}.example.test")
			}
			try zone.publish()
			assert serialsOf(zone.changesSince(4)) == "4>5 5>6"
			assert (try client.transfer(copy, at)) && copy.len() == zone.len() && copy.str() == zone.str()
			assert serialsOf(copy.changesSince(4)) == "4>5 5>6"

			// The question over UDP is answered with the SOA record alone.
			let query = try newQuery("example.test", RecordType.IXFR)
			query.authorities = stale.find("example.test", RecordType.SOA)
			let from = new net.Address()
			from.host = "127.0.0.1"
			let short = server.respond(Request{message: query, remote: from})
			assert short.answers.len() == 1 && serialIn(short.answers[0]) == 6

			// The same on a stream the caller opened.
			try zone.add(addressRecord("streamed.example.test", "192.0.2.10"))
			try zone.publish()
			assert try client.transfer(copy, try net.dialStream(at, 5s))
			assert copy.str() == zone.str() && copy.find("streamed.example.test").len() == 1

			// Without the client's SOA record, and from a client not listed.
			let bare = try newQuery("example.test", RecordType.IXFR)
			assert server.respond(Request{message: bare, remote: from, tcp: true}).rcode == RCode.FormatError
			zone.allowTransfer = []
			assert server.respond(Request{message: query, remote: from, tcp: true}).rcode == RCode.Refused

			try server.close()
			return none
		}
	}
}
