partial module std.net.dns.mdns {
	use (
		std.crypto::(rand)
		std.net.dns
		std.testing
	)

	check "Multicast DNS" {
		// uniqueHost is a host name nobody on the link holds.
		def uniqueHost() !string {
			return "adm-test-" + (try rand(4)).hex().lower()
		}

		@test()
		def TestServiceNames() {
			let entry = Service{name: "Office. Printer \\ 2", kind: "_ipp._tcp", port: 631}
			assert instanceName(entry) == "Office\\. Printer \\\\ 2._ipp._tcp.local"
			assert typeName("_IPP._tcp") == "_ipp._tcp.local" && typeName("_ipp._tcp.local.") == "_ipp._tcp.local"
			assert instanceLabel(instanceName(entry), "_ipp._tcp.local") == "Office. Printer \\ 2"
		}

		@test()
		def TestQuestionAndRecordBits() !none {
			let question = try dns.newQuery("printer.local", dns.RecordType.A)
			question.questions[0].unicastResponse = true
			let address = dns.addressRecord("printer.local", "192.0.2.7", 120)
			address.cacheFlush = true
			question.answers.push(address)
			let back = try dns.decode(try question.encode())
			assert back.questions[0].unicastResponse && back.questions[0].class == dns.RecordClass.IN
			assert back.answers[0].cacheFlush && back.answers[0].class == dns.RecordClass.IN && back.answers[0].address == "192.0.2.7"
			let plainOnes = try dns.decode(try (try dns.newQuery("printer.local")).encode())
			assert !plainOnes.questions[0].unicastResponse
		}

		// The tests below talk to the real link. On a host without a
		// multicast route `start` fails, and there is nothing to test.
		@test()
		def TestARespondingHostIsFound() !none {
			let host = try uniqueHost()
			let responder = new Responder(host)
			responder.add(Service{name: "ADM test. one", kind: "_adm-test._tcp", port: 8123, text: ["path=/x", "v=1"]})
			let offline = false
			responder.start() onerror (err error) {
				offline = true
				recover none
			}
			return none when offline
			assert responder.isRunning() && responder.hostName() == host + ".local"

			// The resolver of std.net.dns asks the link for a `.local` name.
			let client = new dns.Client()
			client.useHosts = false
			let addresses = try client.lookupHost(host + ".local")
			assert addresses.len() >= 1 && addresses[0] == responder.addresses[0]

			let found = try browse("_adm-test._tcp", 1s)
			let mine ?Service = none
			for let (_, entry) in found {
				mine = entry when entry.name == "ADM test. one"
			}
			fail "browse did not find the service" when mine is none
			assert mine.port == 8123 && mine.host == host + ".local" && mine.text.len() == 2 && mine.text[0] == "path=/x"
			assert mine.addresses.includes(responder.addresses[0])
			assert (try kinds(1s)).includes("_adm-test._tcp")

			// The name is taken now.
			let second = new Responder(host)
			second.addresses = ["192.0.2.99"]
			let kind = ""
			second.start() onerror (err error) {
				kind = err.kind.value when err is dns.DNSError
				recover none
			}
			assert kind == dns.ErrorKind.Conflict.value && !second.isRunning()

			responder.close()
			assert !responder.isRunning()
			let gone = try query(host + ".local", dns.RecordType.A, 500ms)
			assert gone.len() == 0
			return none
		}
	}
}
