partial module std.net.dns {
	use std.crypto.x509::(parseIPText)

	// canonicalName is the name as lookups compare it: lower case and
	// without the trailing dot. The root is ".".
	def canonicalName(name string) string {
		let out = name.lower()
		out = out[:out.len() - 1] when out.endsWith(".") && !out.endsWith("\\.")
		return "." when out == ""
		return out
	}

	// isSubdomain reports whether `name` is `parent` or lies below it;
	// every name lies below the root. Case and a trailing dot do not count.
	def isSubdomain(name string, parent string) bool {
		let child = canonicalName(name)
		let above = canonicalName(parent)
		return true when above == "." || child == above
		return child.endsWith("." + above)
	}

	// wireName is the name as DNSSEC signs and hashes it: on the wire,
	// uncompressed and in lower case.
	// Fails with BadName when the text is not a domain name.
	def wireName(name string) !byte[] {
		let b = new Builder()
		b.canonical = true
		try b.name(name, false)
		return b.buf
	}

	// nameLabels is the name split into its labels, each in text form with
	// its escapes. The root has none, and so has a text that is not a
	// domain name.
	def nameLabels(name string) string[] {
		let out string[]
		let rootLabels byte[][]
		let labels = splitLabels(name) onerror recover rootLabels
		for let (_, label) in labels {
			out.push(labelText(label))
		}
		return out
	}

	// compareNames orders two names the canonical way of RFC 4034 §6.1,
	// which is the order of an NSEC chain: by their labels from the right,
	// each as lower case bytes, a name before the names below it. Under 0
	// when `a` sorts first, 0 when they are the same name. A text that is
	// not a domain name sorts as the root.
	def compareNames(a string, b string) int {
		let rootLabels byte[][]
		let left = splitLabels(a) onerror recover rootLabels
		let right = splitLabels(b) onerror recover rootLabels
		let i = left.len() - 1
		let j = right.len() - 1
		for i >= 0 && j >= 0 {
			let x = left[i]
			let y = right[j]
			for let at = 0; at < x.len() && at < y.len(); at++ {
				let diff = foldedByte(x[at]) - foldedByte(y[at])
				return diff when diff != 0
			}
			return x.len() - y.len() when x.len() != y.len()
			i--
			j--
		}
		return left.len() - right.len()
	}

	internal def foldedByte(b byte) int {
		let c = int(b)
		return c >= 0x41 && c <= 0x5a ?? (c + 0x20, c)
	}

	// reverseName is the name a PTR lookup of the address asks for:
	// `4.3.2.1.in-addr.arpa` for `1.2.3.4`, the nibble form under
	// `ip6.arpa` for an IPv6 address.
	// Fails with BadName when the text is not an IP address.
	def reverseName(ip string) !string {
		let address = parseIPText(ip)
		fail errorOf(ErrorKind.BadName, "{ip} is not an IP address", ip) when address is none
		let out = ""
		if address.len() == 4 {
			for let i = 3; i >= 0; i-- {
				out += int(address[i]).str() + "."
			}
			return out + "in-addr.arpa"
		}
		for let i = 15; i >= 0; i-- {
			let b = int(address[i])
			out += (b & 0x0f).toRadix(16).lower() + "." + (b >> 4).toRadix(16).lower() + "."
		}
		return out + "ip6.arpa"
	}

	// splitLabels reads a name in text form into its labels, resolving the
	// `\.`, `\\` and `\DDD` escapes. The root gives no label.
	// Fails with BadName on an empty label, a label over 63 bytes, a name
	// over 255 bytes on the wire or a broken escape.
	internal def splitLabels(name string) !byte[][] {
		let labels byte[][]
		let raw = name.bytes()
		return labels when raw.len() == 0 || name == "."
		let label byte[]
		let size = 1
		for let i = 0; i < raw.len(); i++ {
			let c = int(raw[i])
			if c == 0x5c {
				fail errorOf(ErrorKind.BadName, "name ends inside an escape", name) when i + 1 >= raw.len()
				let next = int(raw[i + 1])
				if next >= 0x30 && next <= 0x39 {
					fail errorOf(ErrorKind.BadName, "escape needs three digits", name) when i + 3 >= raw.len()
					let value = 0
					for let j = 1; j <= 3; j++ {
						let d = int(raw[i + j])
						fail errorOf(ErrorKind.BadName, "escape needs three digits", name) when d < 0x30 || d > 0x39
						value = value * 10 + d - 0x30
					}
					fail errorOf(ErrorKind.BadName, "escape is over 255", name) when value > 255
					label.push(byte(value))
					i += 3
					continue
				}
				label.push(byte(next))
				i++
				continue
			}
			if c == 0x2e {
				fail errorOf(ErrorKind.BadName, "name has an empty label", name) when label.len() == 0
				size += label.len() + 1
				labels.push(label)
				label = []
				continue
			}
			label.push(byte(c))
			fail errorOf(ErrorKind.BadName, "label is over 63 bytes", name) when label.len() > 63
		}
		if label.len() > 0 {
			size += label.len() + 1
			labels.push(label)
		}
		fail errorOf(ErrorKind.BadName, "name is over 255 bytes", name) when size > 255
		return labels
	}

	// labelText is a label in text form: a dot and a backslash escaped,
	// a byte outside printable ASCII as `\DDD`.
	internal def labelText(label byte[]) string {
		let out byte[]
		for let i = 0; i < label.len(); i++ {
			let c = int(label[i])
			if c := 0x2e || 0x5c {
				out.push(byte(0x5c))
				out.push(byte(c))
				continue
			}
			if c < 0x21 || c > 0x7e {
				out.push(byte(0x5c))
				out.push(byte(0x30 + c / 100))
				out.push(byte(0x30 + c / 10 % 10))
				out.push(byte(0x30 + c % 10))
				continue
			}
			out.push(byte(c))
		}
		return string(out)
	}
}
