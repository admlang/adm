partial module std.net.dns {
	use (
		std.crypto.x509::(ipText, parseIPText)
		std.data.encoding
	)

	// SOA is the data of a start-of-authority record.
	struct SOA {
		// The primary name server of the zone.
		mname   string
		// The mailbox of the zone's administrator, as a domain name.
		rname   string
		serial  int    = 1
		// Seconds between a secondary's refresh checks.
		refresh int    = 3600
		// Seconds before a failed refresh is tried again.
		retry   int    = 600
		// Seconds after which a secondary stops answering.
		expire  int    = 604800
		// Seconds a negative answer may be cached (RFC 2308).
		minimum int    = 300
	}

	// Record is one resource record. The owner name, type, class and TTL
	// are common; of the data fields only the ones the type uses are read
	// and written:
	//
	//     A, AAAA          address
	//     NS, CNAME, PTR   target
	//     DNAME            target
	//     MX               priority, target
	//     TXT              text
	//     SRV              priority, weight, port, target
	//     SOA              soa
	//     CAA              flags, tag, value
	//     TLSA             tlsa
	//     NAPTR            naptr
	//     SVCB, HTTPS      svcb
	//     DNSKEY, CDNSKEY  dnskey
	//     DS, CDS          ds
	//     RRSIG            rrsig
	//     NSEC             nsec
	//     NSEC3            nsec3
	//     NSEC3PARAM       nsec3, without `next` and `types`
	//     any other type   data, the RDATA as it is on the wire
	type Record {
		name       string
		kind       RecordType  = RecordType.A
		// The wire value of the type when `kind` is `Unknown`.
		code       int         = 0
		class      RecordClass = RecordClass.IN
		// Seconds the record may be cached.
		ttl        int         = 0
		// An IPv4 or IPv6 address in text form.
		address    string      = ""
		// The domain name the record points at.
		target     string      = ""
		priority   int         = 0
		weight     int         = 0
		port       int         = 0
		// The strings of a TXT record. One over 255 bytes is split on the wire.
		text       string[]    = []
		soa        ?SOA        = none
		tlsa       ?TLSA       = none
		naptr      ?NAPTR      = none
		svcb       ?SVCB       = none
		dnskey     ?DNSKEY     = none
		ds         ?DS         = none
		rrsig      ?RRSIG      = none
		nsec       ?NSEC       = none
		nsec3      ?NSEC3      = none
		// The CAA flags byte; 128 marks the property critical.
		flags      int         = 0
		// The CAA property: `issue`, `issuewild`, `iodef`.
		tag        string      = ""
		value      string      = ""
		data       byte[]      = []
		// The record stands for a name or a record set and carries no data,
		// as the prerequisites and deletions of a dynamic update do (RFC
		// 2136); it has no data on the wire either.
		dataless   bool        = false
		// The record replaces the ones a multicast DNS cache holds for its
		// name and type (the cache-flush bit, RFC 6762 §10.2).
		cacheFlush bool        = false

		// wireType is the TYPE value the record has on the wire.
		def wireType() int {
			return code when kind == RecordType.Unknown
			return kind.value
		}

		// withTTL is a copy of the record with another TTL, never under 0.
		def withTTL(ttl int) Record {
			let out = new Record()
			out.name = name
			out.kind = kind
			out.code = code
			out.class = class
			out.ttl = ttl < 0 ?? (0, ttl)
			out.address = address
			out.target = target
			out.priority = priority
			out.weight = weight
			out.port = port
			out.text = text
			out.soa = soa
			out.tlsa = tlsa
			out.naptr = naptr
			out.svcb = svcb
			out.dnskey = dnskey
			out.ds = ds
			out.rrsig = rrsig
			out.nsec = nsec
			out.nsec3 = nsec3
			out.flags = flags
			out.tag = tag
			out.value = value
			out.data = data
			out.dataless = dataless
			return out
		}

		// rdata renders the data the way a zone file writes it.
		def rdata() string {
			match kind {
				case RecordType.A, RecordType.AAAA:
					return address
				case RecordType.NS, RecordType.CNAME, RecordType.PTR, RecordType.DNAME:
					return dotted(target)
				case RecordType.MX:
					return "{priority} {dotted(target)}"
				case RecordType.SRV:
					return "{priority} {weight} {port} {dotted(target)}"
				case RecordType.TXT:
					let out = ""
					for let (_, part) in text {
						out += " " when out != ""
						out += quotedText(part)
					}
					return out
				case RecordType.SOA:
					let s = soa
					return "" when s is none
					return "{dotted(s.mname)} {dotted(s.rname)} {s.serial} {s.refresh} {s.retry} {s.expire} {s.minimum}"
				case RecordType.CAA:
					return "{flags} {tag} {quotedText(value)}"
				case RecordType.TLSA:
					let t = tlsa
					return "" when t is none
					return "{t.usage} {t.selector} {t.matching} {t.data.hex()}"
				case RecordType.NAPTR:
					let n = naptr
					return "" when n is none
					return "{n.order} {n.preference} {quotedText(n.flags)} {quotedText(n.services)} {quotedText(n.regexp)} {dotted(n.replacement)}"
				case RecordType.SVCB, RecordType.HTTPS:
					let s = svcb
					return "" when s is none
					return s.str()
				case RecordType.DNSKEY, RecordType.CDNSKEY:
					let k = dnskey
					return "" when k is none
					return k.str()
				case RecordType.DS, RecordType.CDS:
					let d = ds
					return "" when d is none
					return "{d.keyTag} {d.algorithm} {d.digestType} {d.digest.hex()}"
				case RecordType.RRSIG:
					let g = rrsig
					return "" when g is none
					let covered = g.covered == RecordType.Unknown ?? ("TYPE{g.coveredCode}", g.covered.name)
					return "{covered} {g.algorithm} {g.labels} {g.originalTTL} {signatureTime(g.expiration)} {signatureTime(g.inception)} {g.keyTag} {dotted(g.signer)} {encoding.Base64{}.encode(g.signature)}"
				case RecordType.NSEC:
					let n = nsec
					return "" when n is none
					return "{dotted(n.next)} {typesText(n.types)}".trim()
				case RecordType.NSEC3, RecordType.NSEC3PARAM:
					let n = nsec3
					return "" when n is none
					let salt = n.salt.len() == 0 ?? ("-", n.salt.hex())
					let head = "{n.hashAlgorithm} {n.flags} {n.iterations} {salt}"
					return head when kind == RecordType.NSEC3PARAM
					return "{head} {encoding.Base32{padded: false, hex: true}.encode(n.next)} {typesText(n.types)}".trim()
				default:
					return "\\# {data.len()} {data.hex()}"
			}
		}

		// wireData is the data in the canonical form DNSSEC signs and
		// digests (RFC 4034 §6.2): as on the wire, names uncompressed and,
		// for the types that RFC lists, in lower case.
		// Fails as encoding the record in a message does.
		def wireData() !byte[] {
			let b = new Builder()
			b.canonical = true
			try writeData(b, self) unless dataless
			return b.buf
		}

		// str renders the record as one zone file line.
		def str() string {
			let typeName = kind == RecordType.Unknown ?? ("TYPE{code}", kind.name)
			return "{dotted(name)} {ttl} {class.name} {typeName} {rdata()}"
		}
	}

	// dotted is the name as a zone file writes an absolute one, with the
	// trailing dot.
	internal def dotted(name string) string {
		return name when name.endsWith(".") && !name.endsWith("\\.")
		return name + "."
	}

	// quotedText is the string in quotes as a zone file writes it: a quote
	// and a backslash escaped, a byte outside printable ASCII as `\DDD`.
	internal def quotedText(text string) string {
		let out byte[] = [byte(0x22)]
		for let (_, b) in text.bytes() {
			let c = int(b)
			if c := 0x22 || 0x5c {
				out.push(byte(0x5c))
				out.push(b)
				continue
			}
			if c < 0x20 || c > 0x7e {
				out.push(byte(0x5c))
				out.push(byte(0x30 + c / 100))
				out.push(byte(0x30 + c / 10 % 10))
				out.push(byte(0x30 + c % 10))
				continue
			}
			out.push(b)
		}
		out.push(byte(0x22))
		return string(out)
	}

	// addressRecord is an A record for an IPv4 address, an AAAA record for
	// an IPv6 one.
	def addressRecord(name string, ip string, ttl int = 300) Record {
		let r = newRecord(name, ip.contains(":") ?? (RecordType.AAAA, RecordType.A), ttl)
		r.address = ip
		return r
	}

	// cnameRecord makes `name` an alias of `target`.
	def cnameRecord(name string, target string, ttl int = 300) Record {
		let r = newRecord(name, RecordType.CNAME, ttl)
		r.target = target
		return r
	}

	// dnameRecord redirects every name below `name` to the same name below
	// `target` (RFC 6672); `name` itself keeps whatever else it holds.
	def dnameRecord(name string, target string, ttl int = 300) Record {
		let r = newRecord(name, RecordType.DNAME, ttl)
		r.target = target
		return r
	}

	// nsRecord names `target` a name server of the zone `name`.
	def nsRecord(name string, target string, ttl int = 300) Record {
		let r = newRecord(name, RecordType.NS, ttl)
		r.target = target
		return r
	}

	// ptrRecord points `name`, as `reverseName` builds it, at `target`.
	def ptrRecord(name string, target string, ttl int = 300) Record {
		let r = newRecord(name, RecordType.PTR, ttl)
		r.target = target
		return r
	}

	// mxRecord names `target` a mail exchange of `name`; the lowest
	// priority is tried first.
	def mxRecord(name string, priority int, target string, ttl int = 300) Record {
		let r = newRecord(name, RecordType.MX, ttl)
		r.priority = priority
		r.target = target
		return r
	}

	// txtRecord holds the strings as one TXT record.
	def txtRecord(name string, text string[], ttl int = 300) Record {
		let r = newRecord(name, RecordType.TXT, ttl)
		r.text = text
		return r
	}

	// srvRecord locates a service: `name` is `_service._proto.domain`.
	def srvRecord(name string, priority int, weight int, port int, target string, ttl int = 300) Record {
		let r = newRecord(name, RecordType.SRV, ttl)
		r.priority = priority
		r.weight = weight
		r.port = port
		r.target = target
		return r
	}

	// soaRecord is the start of authority of the zone `name`.
	def soaRecord(name string, soa SOA, ttl int = 300) Record {
		let r = newRecord(name, RecordType.SOA, ttl)
		r.soa = soa
		return r
	}

	// caaRecord lets the authority `value` issue certificates for `name`
	// under the property `tag` (`issue`, `issuewild`, `iodef`).
	def caaRecord(name string, tag string, value string, ttl int = 300) Record {
		let r = newRecord(name, RecordType.CAA, ttl)
		r.tag = tag
		r.value = value
		return r
	}

	internal def newRecord(name string, kind RecordType, ttl int) Record {
		let r = new Record()
		r.name = canonicalName(name)
		r.kind = kind
		r.code = kind.value
		r.ttl = ttl
		return r
	}

	// writeRecord appends the record. Fails with BadName on a name that is
	// not one and with Malformed on data the type cannot carry.
	internal def writeRecord(b Builder, r Record) !none {
		try b.name(r.name, true)
		b.u16(r.wireType())
		b.u16(r.cacheFlush ?? (r.class.value | 0x8000, r.class.value))
		b.u32(r.ttl)
		let lengthAt = b.buf.len()
		b.u16(0)
		try writeData(b, r) unless r.dataless
		let size = b.buf.len() - lengthAt - 2
		fail errorOf(ErrorKind.Malformed, "record data is over 65535 bytes", r.name) when size > 0xffff
		b.buf[lengthAt] = byte(size >> 8)
		b.buf[lengthAt + 1] = byte(size & 0xff)
		return none
	}

	internal def writeData(b Builder, r Record) !none {
		match r.kind {
			case RecordType.A, RecordType.AAAA:
				let address = parseIPText(r.address)
				let want = r.kind == RecordType.A ?? (4, 16)
				let family = r.kind == RecordType.A ?? ("IPv4", "IPv6")
				fail errorOf(ErrorKind.Malformed, "\"{r.address}\" is not an {family} address", r.name) when address is none
				fail errorOf(ErrorKind.Malformed, "\"{r.address}\" is not an {family} address", r.name) when address.len() != want
				b.bytes(address)
			case RecordType.NS, RecordType.CNAME, RecordType.PTR:
				try b.name(r.target, true)
			case RecordType.DNAME:
				// RFC 6672 §3.1: the target is never compressed.
				try b.name(r.target, false)
			case RecordType.MX:
				b.u16(r.priority)
				try b.name(r.target, true)
			case RecordType.SRV:
				b.u16(r.priority)
				b.u16(r.weight)
				b.u16(r.port)
				try b.name(r.target, false)
			case RecordType.TXT:
				b.u8(0) when r.text.len() == 0
				for let (_, part) in r.text {
					let raw = part.bytes()
					b.u8(0) when raw.len() == 0
					for let at = 0; at < raw.len(); at += 255 {
						let end = at + 255 < raw.len() ?? (at + 255, raw.len())
						b.u8(end - at)
						b.bytes(raw[at:end])
					}
				}
			case RecordType.SOA:
				let s = r.soa
				fail errorOf(ErrorKind.Malformed, "SOA record has no data", r.name) when s is none
				try b.name(s.mname, true)
				try b.name(s.rname, true)
				b.u32(s.serial)
				b.u32(s.refresh)
				b.u32(s.retry)
				b.u32(s.expire)
				b.u32(s.minimum)
			case RecordType.CAA:
				let tag = r.tag.bytes()
				fail errorOf(ErrorKind.Malformed, "CAA tag must have 1 to 255 bytes", r.name) when tag.len() == 0 || tag.len() > 255
				b.u8(r.flags)
				b.u8(tag.len())
				b.bytes(tag)
				b.bytes(r.value.bytes())
			case RecordType.TLSA:
				let t = r.tlsa
				fail errorOf(ErrorKind.Malformed, "TLSA record has no data", r.name) when t is none
				b.u8(t.usage)
				b.u8(t.selector)
				b.u8(t.matching)
				b.bytes(t.data)
			case RecordType.NAPTR:
				let n = r.naptr
				fail errorOf(ErrorKind.Malformed, "NAPTR record has no data", r.name) when n is none
				b.u16(n.order)
				b.u16(n.preference)
				for let (_, part) in [n.flags, n.services, n.regexp] {
					let raw = part.bytes()
					fail errorOf(ErrorKind.Malformed, "a NAPTR string is over 255 bytes", r.name) when raw.len() > 255
					b.u8(raw.len())
					b.bytes(raw)
				}
				try b.name(n.replacement, false)
			case RecordType.SVCB, RecordType.HTTPS:
				let s = r.svcb
				fail errorOf(ErrorKind.Malformed, "{r.kind.name} record has no data", r.name) when s is none
				b.u16(s.priority)
				try b.name(s.target, false, true)
				let last = -1
				for let (_, p) in s.params.sort((x SVCParam, y SVCParam) => x.key < y.key) {
					fail errorOf(ErrorKind.Malformed, "service parameter {p.key} is given twice", r.name) when p.key == last
					last = p.key
					b.u16(p.key)
					b.u16(p.value.len())
					b.bytes(p.value)
				}
			case RecordType.DNSKEY, RecordType.CDNSKEY:
				let k = r.dnskey
				fail errorOf(ErrorKind.Malformed, "{r.kind.name} record has no data", r.name) when k is none
				b.u16(k.flags)
				b.u8(k.protocol)
				b.u8(k.algorithm)
				b.bytes(k.key)
			case RecordType.DS, RecordType.CDS:
				let d = r.ds
				fail errorOf(ErrorKind.Malformed, "{r.kind.name} record has no data", r.name) when d is none
				b.u16(d.keyTag)
				b.u8(d.algorithm)
				b.u8(d.digestType)
				b.bytes(d.digest)
			case RecordType.RRSIG:
				let g = r.rrsig
				fail errorOf(ErrorKind.Malformed, "RRSIG record has no data", r.name) when g is none
				writeSigned(b, g)
				try b.name(g.signer, false)
				b.bytes(g.signature)
			case RecordType.NSEC:
				let n = r.nsec
				fail errorOf(ErrorKind.Malformed, "NSEC record has no data", r.name) when n is none
				// RFC 6840 §5.1: the next name keeps its case when signed.
				try b.name(n.next, false, true)
				writeTypes(b, n.types)
			case RecordType.NSEC3, RecordType.NSEC3PARAM:
				let n = r.nsec3
				fail errorOf(ErrorKind.Malformed, "{r.kind.name} record has no data", r.name) when n is none
				fail errorOf(ErrorKind.Malformed, "an NSEC3 salt or hash is over 255 bytes", r.name) when n.salt.len() > 255 || n.next.len() > 255
				b.u8(n.hashAlgorithm)
				b.u8(n.flags)
				b.u16(n.iterations)
				b.u8(n.salt.len())
				b.bytes(n.salt)
				if r.kind == RecordType.NSEC3 {
					b.u8(n.next.len())
					b.bytes(n.next)
					writeTypes(b, n.types)
				}
			default:
				b.bytes(r.data)
		}
		return none
	}

	// writeSigned appends the RRSIG fields before the signer name, which
	// open the data a signature covers.
	internal def writeSigned(b Builder, g RRSIG) {
		b.u16(g.covered == RecordType.Unknown ?? (g.coveredCode, g.covered.value))
		b.u8(g.algorithm)
		b.u8(g.labels)
		b.u32(g.originalTTL)
		b.u32(g.expiration)
		b.u32(g.inception)
		b.u16(g.keyTag)
	}

	// readRecord reads the record at the parser's position. Fails with
	// Malformed when the message ends early or the data does not fill its
	// declared length.
	internal def readRecord(p Parser) !Record {
		let r = new Record()
		r.name = try p.name()
		r.code = try p.u16()
		r.kind = recordTypeOf(r.code)
		let class = try p.u16()
		r.class = recordClassOf(class)
		// The top bit is no class: multicast DNS marks with it a record that
		// replaces what a cache holds (RFC 6762 §10.2).
		if r.kind != RecordType.OPT && class & 0x8000 != 0 {
			r.cacheFlush = true
			r.class = recordClassOf(class & 0x7fff)
		}
		let ttl = try p.u32()
		r.ttl = ttl > 0x7fffffff ?? (0, ttl)
		let size = try p.u16()
		let end = p.pos + size
		fail errorOf(ErrorKind.Malformed, "record data runs past the message", r.name) when end > p.data.len()
		if r.kind == RecordType.OPT {
			// The class and TTL of OPT are EDNS fields, read by the message.
			r.priority = class
			r.weight = ttl
			r.data = (try p.bytes(size)).clone()
			return r
		}
		// No type the module parses has empty data, so none is a record
		// of a dynamic update that names a record set.
		r.dataless = size == 0
		try readData(p, r, size) unless r.dataless
		fail errorOf(ErrorKind.Malformed, "{r.kind.name} record data has the wrong length", r.name) when p.pos != end
		return r
	}

	internal def readData(p Parser, r Record, size int) !none {
		let end = p.pos + size
		match r.kind {
			case RecordType.A:
				fail errorOf(ErrorKind.Malformed, "A record data is not 4 bytes", r.name) when size != 4
				r.address = ipText(try p.bytes(4))
			case RecordType.AAAA:
				fail errorOf(ErrorKind.Malformed, "AAAA record data is not 16 bytes", r.name) when size != 16
				r.address = ipText(try p.bytes(16))
			case RecordType.NS, RecordType.CNAME, RecordType.PTR, RecordType.DNAME:
				r.target = try p.name()
			case RecordType.MX:
				r.priority = try p.u16()
				r.target = try p.name()
			case RecordType.SRV:
				r.priority = try p.u16()
				r.weight = try p.u16()
				r.port = try p.u16()
				r.target = try p.name()
			case RecordType.TXT:
				for p.pos < end {
					let n = try p.u8()
					fail errorOf(ErrorKind.Malformed, "TXT string runs past the record", r.name) when p.pos + n > end
					r.text.push(string((try p.bytes(n)).clone()))
				}
			case RecordType.SOA:
				let mname = try p.name()
				let rname = try p.name()
				let serial = try p.u32()
				let refresh = try p.u32()
				let retry = try p.u32()
				let expire = try p.u32()
				let minimum = try p.u32()
				r.soa = SOA{mname: mname, rname: rname, serial: serial, refresh: refresh, retry: retry, expire: expire, minimum: minimum}
			case RecordType.CAA:
				fail errorOf(ErrorKind.Malformed, "CAA record data is too short", r.name) when size < 2
				r.flags = try p.u8()
				let n = try p.u8()
				fail errorOf(ErrorKind.Malformed, "CAA tag runs past the record", r.name) when n == 0 || p.pos + n > end
				r.tag = string((try p.bytes(n)).clone())
				r.value = string((try p.bytes(end - p.pos)).clone())
			case RecordType.TLSA:
				fail errorOf(ErrorKind.Malformed, "TLSA record data is too short", r.name) when size < 3
				let usage = try p.u8()
				let selector = try p.u8()
				let matching = try p.u8()
				r.tlsa = TLSA{usage: usage, selector: selector, matching: matching, data: (try p.bytes(end - p.pos)).clone()}
			case RecordType.NAPTR:
				let order = try p.u16()
				let preference = try p.u16()
				let parts string[]
				for let i = 0; i < 3; i++ {
					let n = try p.u8()
					fail errorOf(ErrorKind.Malformed, "NAPTR string runs past the record", r.name) when p.pos + n > end
					parts.push(string((try p.bytes(n)).clone()))
				}
				let replacement = try p.name()
				r.naptr = NAPTR{order: order, preference: preference, flags: parts[0], services: parts[1], regexp: parts[2], replacement: replacement}
			case RecordType.SVCB, RecordType.HTTPS:
				let s = new SVCB()
				s.priority = try p.u16()
				s.target = try p.name()
				let last = -1
				for p.pos < end {
					let key = try p.u16()
					let n = try p.u16()
					fail errorOf(ErrorKind.Malformed, "service parameters are out of order", r.name) when key <= last
					fail errorOf(ErrorKind.Malformed, "service parameter runs past the record", r.name) when p.pos + n > end
					last = key
					s.params.push(SVCParam{key: key, value: (try p.bytes(n)).clone()})
				}
				r.svcb = s
			case RecordType.DNSKEY, RecordType.CDNSKEY:
				fail errorOf(ErrorKind.Malformed, "{r.kind.name} record data is too short", r.name) when size < 4
				let k = new DNSKEY()
				k.flags = try p.u16()
				k.protocol = try p.u8()
				k.algorithm = try p.u8()
				k.key = (try p.bytes(end - p.pos)).clone()
				r.dnskey = k
			case RecordType.DS, RecordType.CDS:
				fail errorOf(ErrorKind.Malformed, "{r.kind.name} record data is too short", r.name) when size < 4
				let keyTag = try p.u16()
				let algorithm = try p.u8()
				let digestType = try p.u8()
				r.ds = DS{keyTag: keyTag, algorithm: algorithm, digestType: digestType, digest: (try p.bytes(end - p.pos)).clone()}
			case RecordType.RRSIG:
				fail errorOf(ErrorKind.Malformed, "RRSIG record data is too short", r.name) when size < 19
				let coveredCode = try p.u16()
				let algorithm = try p.u8()
				let labels = try p.u8()
				let originalTTL = try p.u32()
				let expiration = try p.u32()
				let inception = try p.u32()
				let keyTag = try p.u16()
				let signer = try p.name()
				fail errorOf(ErrorKind.Malformed, "RRSIG signer name runs past the record", r.name) when p.pos > end
				r.rrsig = RRSIG{covered: recordTypeOf(coveredCode), coveredCode: coveredCode, algorithm: algorithm, labels: labels, originalTTL: originalTTL, expiration: expiration, inception: inception, keyTag: keyTag, signer: signer, signature: (try p.bytes(end - p.pos)).clone()}
			case RecordType.NSEC:
				let n = new NSEC()
				n.next = try p.name()
				fail errorOf(ErrorKind.Malformed, "NSEC next name runs past the record", r.name) when p.pos > end
				n.types = try readTypes(p, end, r.name)
				r.nsec = n
			case RecordType.NSEC3, RecordType.NSEC3PARAM:
				fail errorOf(ErrorKind.Malformed, "{r.kind.name} record data is too short", r.name) when size < 5
				let n = new NSEC3()
				n.hashAlgorithm = try p.u8()
				n.flags = try p.u8()
				n.iterations = try p.u16()
				let saltSize = try p.u8()
				fail errorOf(ErrorKind.Malformed, "NSEC3 salt runs past the record", r.name) when p.pos + saltSize > end
				n.salt = (try p.bytes(saltSize)).clone()
				if r.kind == RecordType.NSEC3 {
					let hashSize = try p.u8()
					fail errorOf(ErrorKind.Malformed, "NSEC3 hash runs past the record", r.name) when p.pos + hashSize > end
					n.next = (try p.bytes(hashSize)).clone()
					n.types = try readTypes(p, end, r.name)
				}
				r.nsec3 = n
			default:
				r.data = (try p.bytes(size)).clone()
		}
		return none
	}
}
