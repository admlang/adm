partial module std.net.dns {
	use (
		std.testing
		std.time
	)

	check "Secondary" {
		// zoneAt is the example zone with the serial and one more host per
		// serial above 1.
		def zoneAt(serial int) !Zone {
			let zone = new Zone("example.test")
			try zone.add(soaRecord("example.test", SOA{mname: "ns1.example.test", rname: "admin.example.test", serial: serial, refresh: 3600, retry: 600, expire: 86400, minimum: 60}, 300))
			try zone.add(nsRecord("example.test", "ns1.example.test"))
			try zone.add(addressRecord("ns1.example.test", "192.0.2.53"))
			try zone.add(addressRecord("www.example.test", "192.0.2.1"))
			try zone.add(addressRecord("new.example.test", "192.0.2.{serial}")) when serial > 1
			zone.allowTransfer = ["127.0.0.1"]
			return zone
		}

		// clientOf is a client of the one server, without the hosts file.
		def clientOf(server Server) Client {
			let client = new Client([server.address().str()])
			client.useHosts = false
			client.timeout = 2s
			return client
		}

		@test()
		def TestSerialArithmetic() {
			assert serialAhead(2, 1) && !serialAhead(1, 2) && !serialAhead(7, 7)
			assert serialAhead(5, 0xfffffff0) && !serialAhead(0xfffffff0, 5)
			assert serialAhead(0x7fffffff, 0) && !serialAhead(0x80000000, 0)
		}

		@test()
		def TestSerialOfAZone() !none {
			assert serialOf(try zoneAt(9)) == 9 && serialOf(new Zone("bare.test")) == -1
			return none
		}

		@test()
		def TestSecondaryPassesUpdatesOn() !none {
			let zone = try zoneAt(1)
			let key = try generateTSIGKey("secondary.example.test")
			zone.allowUpdate = ["key:secondary.example.test"]
			zone.allowTransfer = ["key:secondary.example.test"]
			let primary = new Server("127.0.0.1:0", zone)
			primary.keys = [key]
			try primary.start()

			let copy = new Secondary("example.test", primary.address().str())
			copy.client.timeout = 2s
			copy.client.key = key
			copy.refresh = 1h
			try copy.start()
			let server = new Server("127.0.0.1:0", copy)
			try server.start()
			let at = server.address().str()

			let change = new Update("example.test")
			change.add(addressRecord("passed.example.test", "192.0.2.44"))
			let client = clientOf(server)
			let code = RCode.Success
			client.update(change, at) onerror (err error) {
				code = err.rcode when err is DNSError
				recover none
			}
			assert code == RCode.Refused && zone.find("passed.example.test").len() == 0

			copy.allowUpdate = ["127.0.0.1"]
			try client.update(change, at)
			assert zone.find("passed.example.test").len() == 1
			// The accepted update brings the copy's next check forward.
			for let wait = 0; wait < 150 && copy.serial() < 2; wait++ {
				time.sleep(20ms)
			}
			assert copy.serial() == 2

			// What the primary refuses comes back as its refusal.
			let outside = new Update("example.test")
			outside.add(addressRecord("www.other.test", "192.0.2.45"))
			code = RCode.Success
			client.update(outside, at) onerror (err error) {
				code = err.rcode when err is DNSError
				recover none
			}
			assert code == RCode.NotZone

			copy.close()
			try server.close()
			try primary.close()
			return none
		}

		@test()
		def TestSecondaryFollowsThePrimary() !none {
			let mux = new Mux()
			mux.handle("example.test", try zoneAt(1))
			let primary = new Server("127.0.0.1:0", mux)
			try primary.start()

			let copy = new Secondary("Example.Test.", primary.address().str())
			copy.client.timeout = 2s
			copy.refresh = 1h
			copy.allowTransfer = ["127.0.0.1"]
			assert copy.serial() == -1 && copy.zone() is none
			// Without a copy there is nothing to answer from.
			let early = new Server("127.0.0.1:0", copy)
			let unready = early.respond(Request{message: try newQuery("www.example.test"), remote: primary.address(), tcp: true})
			assert unready.rcode == RCode.ServerFailure

			try copy.start()
			try copy.start()
			assert copy.origin == "example.test" && copy.serial() == 1
			let server = new Server("127.0.0.1:0", copy)
			try server.start()
			let client = clientOf(server)
			assert (try client.lookupHost("www.example.test"))[0] == "192.0.2.1"
			assert (try client.query("new.example.test")).rcode == RCode.NameError
			// Nothing changed: no transfer.
			assert !(try copy.refreshNow())

			// The primary moves on and says so.
			mux.handle("example.test", try zoneAt(7))
			try client.notify("example.test", server.address().str())
			let waited = time.now()
			for copy.serial() != 7 && time.since(waited) < 5s {
				time.sleep(20ms)
			}
			assert copy.serial() == 7
			assert (try client.lookupHost("new.example.test"))[0] == "192.0.2.7"
			// The copy can be transferred on, to the clients it lists.
			assert (try client.transfer("example.test", server.address().str())).len() == 5

			// A NOTIFY for another zone, and one to a server that takes none.
			let code = RCode.Success
			client.notify("other.test", server.address().str()) onerror (err error) {
				code = err.rcode when err is DNSError
				recover none
			}
			assert code == RCode.NotAuth
			code = RCode.Success
			client.notify("example.test", primary.address().str()) onerror (err error) {
				code = err.rcode when err is DNSError
				recover none
			}
			assert code == RCode.NotImplemented

			// A copy that outlived its expire time is not served.
			copy.expire = 1ms
			time.sleep(5ms)
			assert (try client.query("www.example.test")).rcode == RCode.ServerFailure
			copy.expire = 0s
			assert (try client.query("www.example.test")).rcode == RCode.Success

			// A primary that is gone fails the check and keeps the copy.
			try primary.close()
			let failed = false
			copy.refreshNow() onerror (err error) {
				failed = true
				recover false
			}
			assert failed && copy.serial() == 7

			copy.close()
			try server.close()
			return none
		}

		@test()
		def TestPublishMovesTheSerialAndNotifies() !none {
			let zone = try zoneAt(1)
			let handedOut = zone.find("example.test", RecordType.SOA)[0]
			let primary = new Server("127.0.0.1:0", zone)
			try primary.start()

			let copy = new Secondary("example.test", primary.address().str())
			copy.client.timeout = 2s
			copy.refresh = 1h
			try copy.start()
			let server = new Server("127.0.0.1:0", copy)
			try server.start()

			// A server that holds another zone refuses the NOTIFY.
			let stranger = new Server("127.0.0.1:0", new Secondary("other.test", primary.address().str()))
			try stranger.start()
			let refusals = 0
			zone.onError = def (err error) {
				refusals++
			}
			zone.secondaries = [server.address().str(), stranger.address().str()]

			try zone.add(addressRecord("fresh.example.test", "192.0.2.9"))
			assert (try zone.publish()) == 2 && serialOf(zone) == 2
			// A record handed out before keeps its serial.
			let before = handedOut.soa
			fail "the SOA record lost its data" when before is none
			assert before.serial == 1
			let waited = time.now()
			for (copy.serial() != 2 || refusals == 0) && time.since(waited) < 5s {
				time.sleep(20ms)
			}
			assert copy.serial() == 2 && refusals == 1
			assert (try clientOf(server).lookupHost("fresh.example.test"))[0] == "192.0.2.9"

			// The serial wraps, and a zone without a SOA record has none to move.
			let last = new Zone("wrap.test")
			try last.add(soaRecord("wrap.test", SOA{mname: "ns1.wrap.test", rname: "admin.wrap.test", serial: 0xffffffff}))
			assert (try last.publish()) == 0
			let kind = ""
			let bare = new Zone("bare.test")
			bare.publish() onerror (err error) {
				kind = err.kind.value when err is DNSError
				recover 0
			}
			assert kind == ErrorKind.NoData.value

			copy.close()
			try server.close()
			try stranger.close()
			try primary.close()
			return none
		}
	}
}
