partial module std.net.dns.secure {
	use (
		std.data.encoding
		std.net
		std.net.dns
		std.net.http
		std.time
	)

	// The media type of a DNS message in an HTTP body (RFC 8484 §6).
	const dnsMessageType = "application/dns-message"

	// HTTPSTransport carries the queries of a `dns.Client` over HTTPS (RFC
	// 8484) as POST requests. A server is the URL of the resolver
	// (`https://dns.example/dns-query`), or a host, which stands for
	// `https://host/dns-query`.
	type HTTPSTransport {
		// The HTTP client the queries go through: its transport holds the
		// TLS settings and keeps the connections, HTTP/2 included.
		client  http.Client
		// Pad each query to a multiple of this many bytes (RFC 8467); 0
		// sends it as it is.
		padding int         = 128

		def new() {
			self.client = new http.Client()
		}

		def new(client http.Client) {
			self.client = client
		}

		// Implements dns.Transport. The query travels with id 0, as the RFC
		// asks for the sake of HTTP caches, and the response gets the
		// query's id back. The policy is the HTTP client's: `https://host`
		// under `adm.network.connect`.
		//
		// Fails with ServerFailed when the resolver answers with an HTTP
		// status other than 200, with Malformed when the body is not a DNS
		// message, as `http.Client.do` does when the request fails or
		// passes the timeout, and as `Message.encode` does.
		def exchange(query dns.Message, server string, timeout duration) !dns.Message {
			let target = httpsURL(server)
			try query.pad(padding) when padding > 1
			let id = query.id
			query.id = 0
			let failure ?error = none
			let wire = query.encode() onerror (err error) {
				failure = err
				recover []
			}
			query.id = id
			fail failure unless failure is none
			let request = try http.newRequest(http.Method.POST, target, wire)
			request.headers.set("Content-Type", dnsMessageType)
			request.headers.set("Accept", dnsMessageType)
			request.deadline = time.now() + timeout when timeout > 0s
			let response ?http.Response = none
			response = send(request) onerror (err error) {
				failure = err
				recover none
			}
			fail failure unless failure is none
			fail dns.errorOf(dns.ErrorKind.ServerFailed, "{target} gave no response") when response is none
			let body = try response.bytes()
			if response.status != 200 {
				let refusal = dns.errorOf(dns.ErrorKind.ServerFailed, "{target} answered HTTP {response.status}")
				refusal.server = target
				fail refusal
			}
			let answer = try dns.decode(body)
			answer.id = id
			return answer
		}

		// `client.do` as an optional, so a failure can recover to none.
		internal def send(request http.Request) !?http.Response {
			return try client.do(request)
		}
	}

	// httpsURL is a server of an HTTPSTransport as a URL.
	def httpsURL(server string) string {
		return server when server.startsWith("https://") || server.startsWith("http://")
		return "https://{server}/dns-query"
	}

	// HTTPHandler serves DNS over HTTPS (RFC 8484) from a `dns.Handler`:
	// mount it on the path of the resolver, by convention `/dns-query`, of
	// an `http.Server` that speaks TLS. It answers a POST with the query as
	// the body and a GET with it in the `dns` parameter, base64url without
	// padding. The response to a query with the EDNS(0) Padding option is
	// padded to a multiple of 468 bytes (`inner.padding`).
	//
	// ```
	// let mux = new http.ServeMux()
	// try mux.handle("/dns-query", new secure.HTTPHandler(zone))
	// ```
	type HTTPHandler {
		// Answers the queries; it is never started.
		inner dns.Server

		def new(handler dns.Handler) {
			self.inner = new dns.Server("127.0.0.1:0", handler)
			self.inner.padding = 468
		}

		// Implements http.Handler: 405 for another method, 415 for a POST
		// of another media type, 400 for bytes that are not a DNS query. A
		// response may be cached as long as its shortest TTL lasts.
		// Fails as writing the response does.
		def serve(ctx http.Context) !none {
			let wire byte[] = []
			match ctx.method() {
				case http.Method.GET:
					let codec = encoding.Base64{urlSafe: true, padded: false}
					let failed = false
					wire = codec.decode(ctx.query("dns", "")) onerror (err error) {
						failed = true
						recover []
					}
					return try ctx.error(400, "the dns parameter is not base64url") when failed
				case http.Method.POST:
					return try ctx.error(415, "the body must be {dnsMessageType}") unless ctx.header("Content-Type").lower().startsWith(dnsMessageType)
					wire = try ctx.bytes()
				default:
					ctx.setHeader("Allow", "GET, POST")
					return try ctx.error(405)
			}
			let query ?dns.Message = none
			query = tryDecode(wire) onerror recover none
			return try ctx.error(400, "not a DNS message") when query is none
			return try ctx.error(400, "not a DNS query") when query.response
			let remote = net.parseAddress(ctx.clientAddr()) onerror recover new net.Address()
			let response = inner.respond(dns.Request{message: query, remote: remote, tcp: true})
			let body = try response.encode()
			ctx.setHeader("Cache-Control", "max-age={shortestTTL(response)}")
			return try ctx.blob(200, dnsMessageType, body)
		}

		// `dns.decode` as an optional, so a failure can recover to none.
		internal def tryDecode(wire byte[]) !?dns.Message {
			return try dns.decode(wire)
		}
	}

	// shortestTTL is the smallest TTL among the records of the response, 0
	// when it has none or did not succeed.
	internal def shortestTTL(response dns.Message) int {
		return 0 when response.rcode != dns.RCode.Success
		let shortest = -1
		let sections dns.Record[][] = [response.answers, response.authorities, response.additionals]
		for let (_, section) in sections {
			for let (_, r) in section {
				shortest = r.ttl when shortest < 0 || r.ttl < shortest
			}
		}
		return shortest < 0 ?? (0, shortest)
	}
}
