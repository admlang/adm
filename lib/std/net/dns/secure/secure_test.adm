partial module std.net.dns.secure {
	use (
		std.crypto.x509::(CertPool, parseCertificatesPEM)
		std.data.encoding
		std.net.dns
		std.net.http
		std.net.http.httptest
		std.net.tls
		std.testing
	)

	check "Secure transports" {
		// exampleZone is the zone the tests ask about.
		def exampleZone() !dns.Zone {
			let zone = try dns.parseZone("$TTL 120\n@ SOA ns1 admin 3 1h 10m 1w 60\n@ NS ns1\nns1 A 192.0.2.53\nwww 45 A 192.0.2.1\nwww AAAA 2001:db8::1\n", "example.test")
			for let i = 0; i < 40; i++ {
				try zone.add(dns.txtRecord("big.example.test", ["record number {i} of an answer too long for one datagram"]))
			}
			return zone
		}

		// trusting is a client configuration that trusts the test
		// certificate under the name it was issued for.
		def trusting(name string) !tls.Config {
			let pool = new CertPool()
			for let (_, cert) in try parseCertificatesPEM(httptest.testCertPEM) {
				pool.addCert(cert)
			}
			return tls.Config{serverName: name, rootCAs: pool}
		}

		@test()
		def TestAddresses() {
			assert tlsAddress("192.0.2.1") == "192.0.2.1:853" && tlsAddress("192.0.2.1:8853") == "192.0.2.1:8853"
			assert tlsAddress("2001:db8::1") == "[2001:db8::1]:853" && tlsAddress("[2001:db8::1]") == "[2001:db8::1]:853"
			assert tlsAddress("tls://dns.example.test") == "dns.example.test:853" && tlsAddress("tls://dns.example.test:9953") == "dns.example.test:9953"
			assert httpsURL("dns.example.test") == "https://dns.example.test/dns-query"
			assert httpsURL("https://dns.example.test/resolve") == "https://dns.example.test/resolve"
		}

		@test()
		def TestDNSOverTLS() !none {
			let pair = try tls.parseKeyPair(httptest.testCertPEM, httptest.testKeyPEM)
			let zone = try exampleZone()
			let server = new TLSServer("127.0.0.1:0", zone, tls.Config{certificates: [pair]})
			try server.start()
			try server.start()
			assert server.isRunning() && server.address().port > 0

			let transport = new TLSTransport()
			transport.config = try trusting("localhost")
			let client = new dns.Client([server.address().str()])
			client.useHosts = false
			client.timeout = 5s
			client.transport = transport

			let addresses = try client.lookupHost("www.example.test")
			assert addresses.len() == 2 && addresses[0] == "192.0.2.1" && addresses[1] == "2001:db8::1"
			// The next queries ride the kept connection; nothing is cut to a
			// datagram's size.
			let big = try client.query("big.example.test", dns.RecordType.TXT)
			assert big.rcode == dns.RCode.Success && big.answers.len() == 40 && !big.truncated
			// A padded query gets a padded response; an unpadded one does not.
			assert big.isPadded()
			transport.padding = 0
			assert !(try client.query("www.example.test", dns.RecordType.AAAA)).isPadded()
			transport.padding = 128

			// A zone transfer over TLS, for the clients the zone lists.
			zone.allowTransfer = ["127.0.0.1"]
			let copy = try client.transfer("example.test", try transport.dial(server.address().str(), 5s))
			assert copy.len() == zone.len() && copy.str() == zone.str()
			let kind = ""
			client.lookup("missing.example.test") onerror (err error) {
				kind = err.kind.value when err is dns.DNSError
				recover []
			}
			assert kind == "not-found"

			// A certificate for another name is refused.
			let strict = new TLSTransport()
			strict.config = try trusting("other.example.test")
			let wary = new dns.Client([server.address().str()])
			wary.useHosts = false
			wary.timeout = 5s
			wary.transport = strict
			let refused = false
			wary.query("www.example.test") onerror (err error) {
				refused = true
				recover new dns.Message()
			}
			assert refused

			try transport.close()
			try server.close()
			try server.close()
			assert !server.isRunning()
			return none
		}

		@test()
		def TestDNSOverHTTPS() !none {
			let mux = new http.ServeMux()
			try mux.handle("/dns-query", new HTTPHandler(try exampleZone()))
			let web = new httptest.Server(mux)
			try web.startTLS()

			let client = new dns.Client([web.url + "/dns-query"])
			client.useHosts = false
			client.timeout = 5s
			client.transport = new HTTPSTransport(web.client())
			let addresses = try client.lookupHost("www.example.test")
			assert addresses.len() == 2 && addresses[0] == "192.0.2.1"
			let big = try client.query("big.example.test", dns.RecordType.TXT)
			assert big.answers.len() == 40 && !big.truncated && big.id != 0 && big.isPadded()

			// GET carries the query in the `dns` parameter.
			let query = try dns.newQuery("www.example.test")
			query.id = 0
			let codec = encoding.Base64{urlSafe: true, padded: false}
			let browser = web.client()
			let got = try browser.get("/dns-query?dns=" + codec.encode(try query.encode()))
			assert got.status == 200 && got.header("Content-Type") == dnsMessageType && got.header("Cache-Control") == "max-age=45"
			let answer = try dns.decode(try got.bytes())
			assert answer.response && answer.answers.len() == 1 && answer.answers[0].address == "192.0.2.1"

			assert (try browser.get("/dns-query?dns=@@@")).status == 400
			assert (try browser.get("/dns-query?dns=AAAA")).status == 400
			assert (try browser.post("/dns-query", "text/plain", try query.encode())).status == 415
			let put = try http.newRequest(http.Method.PUT, web.url + "/dns-query", try query.encode())
			let denied = try browser.do(put)
			assert denied.status == 405 && denied.header("Allow") == "GET, POST"

			// A resolver that answers with an HTTP error is a failed server.
			let lost = new dns.Client([web.url + "/elsewhere"])
			lost.useHosts = false
			lost.transport = new HTTPSTransport(web.client())
			let kind = ""
			lost.query("www.example.test") onerror (err error) {
				kind = err.kind.value when err is dns.DNSError
				recover new dns.Message()
			}
			assert kind == "server-failed"

			try web.close()
			return none
		}
	}
}
