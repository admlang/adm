partial module std.net.dns.secure {
	use (
		std.net
		std.net.dns
		std.net.tcp
		std.net.tls
		std.services::(Policy)
		std.time
	)

	// TLSServer answers DNS queries over TLS (RFC 7858), a task per
	// connection. Run it beside a `dns.Server` on port 53 with the same
	// handler to serve both. The response to a padded query is padded to a
	// multiple of 468 bytes (`inner.padding`), and a zone that allows it is
	// transferred over TLS (RFC 9103).
	//
	// ```
	// let pair = try tls.loadKeyPair("server.pem", "server.key")
	// let server = new secure.TLSServer("0.0.0.0:853", zone, tls.Config{certificates: [pair]})
	// try server.listenAndServe()
	// ```
	type TLSServer {
		// The address to bind, `host:port`; port 0 picks a free port.
		addr             string
		// The certificate the server presents, and the rest of its TLS
		// settings.
		config           tls.Config
		// How long a connection may take to finish its handshake.
		handshakeTimeout duration   = 10s

		// Answers the queries and holds `idleTimeout`, `writeTimeout` and
		// `onError`; it is never started itself.
		inner dns.Server

		internal listener ?tcp.Server = none
		internal conns    tls.Conn[]  = []
		internal running  bool        = false

		def new(addr string, handler dns.Handler, config tls.Config) {
			self.addr = addr
			self.config = config
			self.inner = new dns.Server(addr, handler)
			self.inner.padding = 468
		}

		// start binds the address and serves in the background.
		// Fails with PolicyDenied when the policy denies listening on
		// `dns://addr`, and when the address cannot be bound.
		def start() !none {
			return none when running
			let bound = try bind()
			let task = async accept(bound)
			task.keepAlive()
			return none
		}

		// listenAndServe binds the address and serves until `close`.
		// Fails with Closed when the server is serving already, else as
		// `start` does.
		def listenAndServe() !none {
			fail dns.errorOf(dns.ErrorKind.Closed, "server is already serving") when running
			accept(try bind())
			return none
		}

		// close stops serving and closes every connection; a second call
		// does nothing. Does not fail today.
		atomic def close() !none {
			return none unless running
			running = false
			let bound = listener
			if !(bound is none) {
				bound.close() onerror recover none
			}
			for let (_, conn) in conns {
				conn.close() onerror recover none
			}
			conns = []
			listener = none
			return none
		}

		// address is the address the server is bound to, the chosen port
		// included; the configured one before `start`.
		def address() net.Address {
			let bound = listener
			return bound.address() unless bound is none
			return net.parseAddress(addr) onerror recover new net.Address()
		}

		// isRunning reports whether the server is bound and serving.
		def isRunning() bool {
			return running
		}

		internal def bind() !tcp.Server {
			try Policy.validate("adm.network.listen", "std.services.EndpointSpec", "dns://" + addr)
			let bound = new tcp.Server(addr)
			try bound.start()
			listener = bound
			running = true
			return bound
		}

		internal def accept(bound tcp.Server) {
			for running {
				let failure ?error = none
				let accepted ?net.Connection = none
				accepted = tryAccept(bound) onerror (err error) {
					failure = err
					recover none
				}
				if !(failure is none) {
					break unless running
					break when failure is net.NetError && failure.kind == net.ErrorCode.Closed
					report(failure)
					time.sleep(5ms)
					continue
				}
				continue when accepted is none
				if !running {
					accepted.close() onerror recover none
					break
				}
				let task = async serve(accepted)
				task.keepAlive()
			}
		}

		// `accept` as an optional, so a failure can recover to none.
		internal def tryAccept(bound tcp.Server) !?net.Connection {
			return try bound.accept()
		}

		internal def serve(raw net.Connection) {
			let remote = raw.remoteAddr()
			let conn = tls.server(raw, config)
			let failure ?error = none
			conn.handshake(handshakeTimeout) onerror (err error) {
				failure = err
				recover none
			}
			if !(failure is none) {
				report(failure)
				conn.close() onerror recover none
				return
			}
			track(conn)
			inner.serveStream(conn, remote)
			untrack(conn)
		}

		internal def report(failure ?error) {
			let hook = inner.onError
			return when hook is none
			return when failure is none
			hook(failure)
		}

		internal atomic def track(conn tls.Conn) {
			conns.push(conn)
		}

		internal atomic def untrack(conn tls.Conn) {
			let at = conns.indexOf(conn)
			conns = conns.remove(at) when at >= 0
		}

		// Closes the server when the last reference is released.
		def dispose() {
			close() onerror recover none
		}
	}
}
