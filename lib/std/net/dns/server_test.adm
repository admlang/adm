partial module std.net.dns {
	use (
		std.net
		std.net.udp
		std.services::(Network, Policy)
		std.testing
		std.time
	)

	// CountingHandler counts the queries that reach the handler behind it.
	internal type CountingHandler {
		inner       Handler
		atomic seen int     = 0

		def new(inner Handler) {
			self.inner = inner
		}

		def serve(request Request) !Message {
			seen++
			return try inner.serve(request)
		}
	}

	check "Server" {
		// exampleZone is the zone the tests ask about.
		def exampleZone() !Zone {
			let zone = new Zone("Example.Test.")
			try zone.add(soaRecord("example.test", SOA{mname: "ns1.example.test", rname: "admin.example.test", serial: 7, minimum: 60}, 3600))
			try zone.add(nsRecord("example.test", "ns1.example.test"))
			try zone.add(addressRecord("ns1.example.test", "192.0.2.53"))
			try zone.add(addressRecord("host.example.test", "192.0.2.1"))
			try zone.add(addressRecord("host.example.test", "2001:db8::1"))
			try zone.add(cnameRecord("www.example.test", "host.example.test"))
			try zone.add(cnameRecord("away.example.test", "elsewhere.test"))
			try zone.add(mxRecord("example.test", 20, "backup.example.test"))
			try zone.add(mxRecord("example.test", 10, "mail.example.test"))
			try zone.add(addressRecord("mail.example.test", "192.0.2.25"))
			try zone.add(txtRecord("example.test", ["v=spf1 ", "-all"]))
			try zone.add(srvRecord("_sip._tcp.example.test", 10, 5, 5060, "b.example.test"))
			try zone.add(srvRecord("_sip._tcp.example.test", 10, 50, 5060, "a.example.test"))
			try zone.add(srvRecord("_sip._tcp.example.test", 1, 0, 5061, "first.example.test"))
			try zone.add(addressRecord("*.wild.example.test", "192.0.2.99"))
			try zone.add(addressRecord("deep.under.example.test", "192.0.2.3"))
			for let i = 0; i < 60; i++ {
				try zone.add(txtRecord("big.example.test", ["record number {i} of an answer too long for one datagram"]))
			}
			return zone
		}

		// clientFor is a client of the one server, with short timeouts and
		// no hosts file.
		def clientFor(server Server) Client {
			let client = new Client([server.address().str()])
			client.useHosts = false
			client.timeout = 2s
			return client
		}

		// serveUntilClosed runs the server in the calling task.
		def serveUntilClosed(server Server) {
			server.listenAndServe() onerror recover none
		}

		// kindOf is the ErrorKind value the error carries, "" for another error.
		def kindOf(err error) string {
			return err.kind.value when err is DNSError
			return ""
		}

		@test()
		def TestLookupsAgainstAZone() !none {
			let zone = try exampleZone()
			let reverse = new Zone("2.0.192.in-addr.arpa")
			try reverse.add(ptrRecord(try reverseName("192.0.2.1"), "host.example.test"))
			let mux = new Mux()
			mux.handle("example.test", zone)
			mux.handle("in-addr.arpa", reverse)
			let server = new Server("127.0.0.1:0", mux)
			try server.start()
			try server.start()
			assert server.isRunning() && server.address().port > 0
			let client = clientFor(server)

			let addresses = try client.lookupHost("www.example.test")
			assert addresses.len() == 2 && addresses[0] == "192.0.2.1" && addresses[1] == "2001:db8::1"
			assert (try client.lookupHost("192.0.2.200"))[0] == "192.0.2.200"
			assert (try client.lookupHost("Anything.Wild.Example.Test"))[0] == "192.0.2.99"
			assert (try client.lookupCNAME("www.example.test")) == "host.example.test"
			let names = try client.lookupAddr("192.0.2.1")
			assert names.len() == 1 && names[0] == "host.example.test"

			let mail = try client.lookupMX("example.test")
			assert mail.len() == 2 && mail[0].target == "mail.example.test" && mail[1].priority == 20
			let text = try client.lookupTXT("example.test")
			assert text.len() == 1 && text[0] == "v=spf1 -all"
			let sip = try client.lookupSRV("sip", "tcp", "example.test")
			assert sip.len() == 3 && sip[0].target == "first.example.test" && sip[1].target == "a.example.test" && sip[2].port == 5060
			assert (try client.lookupNS("example.test"))[0] == "ns1.example.test"

			// The whole response: authoritative, with glue for the exchange.
			let response = try client.query("example.test", RecordType.MX)
			assert response.authoritative && response.rcode == RCode.Success && response.answers.len() == 2
			assert response.additionals.len() == 1 && response.additionals[0].address == "192.0.2.25"
			let e = response.edns
			fail "the response has no EDNS" when e is none
			assert e.udpSize == 1232
			// An alias that leaves the zone is answered as far as the zone knows.
			let away = try client.query("away.example.test")
			assert away.rcode == RCode.Success && away.answers.len() == 1 && away.answers[0].target == "elsewhere.test"

			try server.close()
			try server.close()
			assert !server.isRunning()
			return none
		}

		@test()
		def TestNegativeAnswers() !none {
			let server = new Server("127.0.0.1:0", try exampleZone())
			try server.start()
			let client = clientFor(server)

			let kind = ""
			let code = RCode.Success
			client.lookup("missing.example.test") onerror (err error) {
				kind = kindOf(err)
				code = err.rcode when err is DNSError
				recover []
			}
			assert kind == ErrorKind.NotFound.value && code == RCode.NameError
			client.lookup("host.example.test", RecordType.MX) onerror (err error) {
				kind = kindOf(err)
				recover []
			}
			assert kind == ErrorKind.NoData.value
			// A name with only names below it exists without data.
			client.lookupHost("under.example.test") onerror (err error) {
				kind = kindOf(err)
				recover []
			}
			assert kind == ErrorKind.NoData.value
			client.lookup("example.org") onerror (err error) {
				kind = kindOf(err)
				code = err.rcode when err is DNSError
				recover []
			}
			assert kind == ErrorKind.ServerFailed.value && code == RCode.Refused

			let missing = try client.query("missing.example.test")
			assert missing.rcode == RCode.NameError && missing.authoritative && missing.answers.len() == 0
			assert missing.authorities.len() == 1 && missing.authorities[0].kind == RecordType.SOA && missing.authorities[0].ttl == 60
			try server.close()
			return none
		}

		@test()
		def TestTruncatedAnswerComesOverTCP() !none {
			let server = new Server("127.0.0.1:0", try exampleZone())
			try server.start()
			let client = clientFor(server)

			// One datagram cannot hold the answer.
			let direct = try client.query("big.example.test", RecordType.TXT)
			assert direct.answers.len() == 60 && !direct.truncated
			client.udpSize = 0
			assert (try client.lookupTXT("big.example.test")).len() == 60
			client.tcp = true
			assert (try client.lookupHost("host.example.test")).len() == 2

			// What UDP alone gives: a cut answer that says so.
			let socket = new udp.Client()
			try socket.start()
			let query = try newQuery("big.example.test", RecordType.TXT)
			try socket.sendTo(try query.encode(), server.address().str(), 2s)
			let buf byte[] = []
			buf.len(4096)
			let (n, _) = try socket.recvFrom(buf, 2s)
			assert n <= 512
			let cut = try decode(buf[:n])
			assert cut.truncated && cut.id == query.id && cut.answers.len() < 60
			try socket.close()
			try server.close()
			return none
		}

		@test()
		def TestSearchListAndFailover() !none {
			let server = new Server("127.0.0.1:0", try exampleZone())
			try server.start()
			// A socket nobody reads from stands in for a dead server.
			let dead = new udp.Server("127.0.0.1:0")
			try dead.start()

			let client = new Client([dead.address().str(), server.address().str()])
			client.useHosts = false
			client.timeout = 300ms
			client.attempts = 1
			client.search = ["example.test"]
			let found = try client.lookup("host")
			assert found.len() == 1 && found[0].address == "192.0.2.1" && found[0].name == "host.example.test"
			client.rotate = true
			assert (try client.lookupHost("www")).len() == 2

			let alone = new Client([dead.address().str()])
			alone.useHosts = false
			alone.timeout = 200ms
			alone.attempts = 2
			let kind = ""
			let asked = ""
			alone.lookup("host.example.test") onerror (err error) {
				kind = kindOf(err)
				asked = err.server when err is DNSError
				recover []
			}
			assert kind == ErrorKind.Timeout.value && asked == dead.address().str()
			try dead.close()
			try server.close()
			return none
		}

		@test()
		def TestForwarderWithCache() !none {
			let counting = new CountingHandler(try exampleZone())
			let upstream = new Server("127.0.0.1:0", counting)
			try upstream.start()
			let resolver = clientFor(upstream)
			let cache = new Cache()
			resolver.cache = cache
			let forwarder = new Server("127.0.0.1:0", new Forwarder(resolver))
			try forwarder.start()
			let client = clientFor(forwarder)

			let first = try client.query("host.example.test")
			assert first.rcode == RCode.Success && first.recursionAvailable && !first.authoritative
			assert first.answers.len() == 1 && first.answers[0].address == "192.0.2.1"
			let again = try client.query("HOST.example.test")
			assert again.answers.len() == 1 && again.answers[0].ttl <= first.answers[0].ttl
			assert counting.seen == 1 && cache.len() == 1
			// A missing name is forwarded as it is, and kept by its SOA.
			let missing = try client.query("missing.example.test")
			assert missing.rcode == RCode.NameError && missing.authorities.len() == 1
			try client.query("missing.example.test")
			assert counting.seen == 2 && cache.len() == 2

			// With the upstream gone the cache still answers, and a new name fails.
			try upstream.close()
			resolver.timeout = 200ms
			resolver.attempts = 1
			assert (try client.query("host.example.test")).answers.len() == 1
			assert (try client.query("mail.example.test")).rcode == RCode.ServerFailure
			try forwarder.close()
			return none
		}

		@test()
		def TestProtocolRefusals() !none {
			let reported = 0
			let failing = new HandlerFunc(def (request Request) !Message {
				fail "the handler broke" when request.message.questions[0].name == "broken.test"
				return request.message.reply()
			})
			let server = new Server("127.0.0.1:0", failing)
			server.onError = def (err error) {
				reported++
			}
			let from = new net.Address()

			let status = try newQuery("example.test")
			status.opcode = Opcode.Status
			assert server.respond(Request{message: status, remote: from}).rcode == RCode.NotImplemented
			let two = try newQuery("example.test")
			two.questions.push(Question{name: "other.test"})
			assert server.respond(Request{message: two, remote: from}).rcode == RCode.FormatError
			let future = try newQuery("example.test")
			future.edns = EDNS{version: 1}
			assert server.respond(Request{message: future, remote: from}).rcode == RCode.BadVersion
			let broken = try newQuery("broken.test")
			let failed = server.respond(Request{message: broken, remote: from})
			assert failed.rcode == RCode.ServerFailure && failed.id == broken.id && failed.response && reported == 1
			// EDNS is answered in kind.
			let plain = try newQuery("example.test")
			assert server.respond(Request{message: plain, remote: from}).edns is none
			plain.edns = EDNS{udpSize: 4096}
			let own = server.respond(Request{message: plain, remote: from}).edns
			fail "the response has no EDNS" when own is none
			assert own.udpSize == 1232

			// Bytes that are not a query: FormatError for a readable header,
			// silence for a response.
			try server.start()
			let socket = new udp.Client()
			try socket.start()
			let junk byte[] = [0xab, 0xcd, 0x01, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0xff]
			try socket.sendTo(junk, server.address().str(), 2s)
			let buf byte[] = []
			buf.len(512)
			let (n, _) = try socket.recvFrom(buf, 2s)
			let refusal = try decode(buf[:n])
			assert refusal.id == 0xabcd && refusal.response && refusal.rcode == RCode.FormatError
			junk[2] = 0x81
			try socket.sendTo(junk, server.address().str(), 2s)
			let silent = false
			socket.recvFrom(buf, 300ms) onerror (err error) {
				silent = err is net.NetError && err.kind == net.ErrorCode.TimedOut
				recover (0, new net.Address())
			}
			assert silent
			try socket.close()
			try server.close()
			return none
		}

		@test()
		def TestListenAndServe() !none {
			let server = new Server("127.0.0.1:0", try exampleZone())
			server.listenUDP = false
			let task = async serveUntilClosed(server)
			for let i = 0; i < 200; i++ {
				break when server.isRunning()
				time.sleep(10ms)
			}
			assert server.isRunning()
			let client = clientFor(server)
			client.tcp = true
			// One server, asked directly and through the list.
			let query = try newQuery("host.example.test")
			let direct = try client.exchange(query, server.address().str())
			assert direct.id == query.id && direct.answers.len() == 1
			assert (try client.exchange(query)).answers[0].address == "192.0.2.1"
			let unasked = ""
			client.exchange(new Message()) onerror (err error) {
				unasked = kindOf(err)
				recover new Message()
			}
			assert unasked == ErrorKind.NoServers.value
			try server.close()
			await task
			assert !server.isRunning()
			return none
		}

		@test()
		def TestSystemResolverPath() !none {
			let zone = try exampleZone()
			try zone.add(addressRecord("local.example.test", "127.0.0.1"))
			let server = new Server("127.0.0.1:0", zone)
			try server.start()
			let addr = server.address().str()
			// Stand in for the system's configuration and hosts file.
			let saved = systemConfig()
			let savedHosts = systemHosts()
			configPinned = true
			configGeneration++
			loadedConfig = Config{servers: [addr], search: ["example.test"], timeout: 2s}
			loadedHosts = parseHosts("192.0.2.77 pinned.example.test\n")
			assert isSystemServer(addr) && !isSystemServer("192.0.2.1:53")

			let client = new Client()
			let found = try client.lookupHost("www")
			assert found.len() == 2 && found[0] == "192.0.2.1" && client.servers[0] == addr && client.search[0] == "example.test"
			assert (try client.lookupHost("pinned.example.test"))[0] == "192.0.2.77"
			// A truncated answer comes over the exempt TCP path.
			client.udpSize = 0
			assert (try client.lookupTXT("big.example.test.")).len() == 60

			// The service refuses other servers and bytes that are not a query.
			let query = try (try newQuery("host.example.test")).encode()
			let refused = ""
			Network.exchangeWithNameServer(query, "192.0.2.1:53", 1s) onerror (err error) {
				refused = err.code
				recover []
			}
			assert refused == "EACCES"
			Network.exchangeWithNameServer("not a query".bytes(), addr, 1s) onerror (err error) {
				refused = kindOf(err)
				recover []
			}
			assert refused == ErrorKind.Malformed.value
			let fd = try Network.socketFd(net.SocketDomain.IPv4, net.SocketType.Datagram)
			Network.sendToNameServer(fd, query, "192.0.2.1:53", 1s) onerror (err error) {
				refused = err.code + "/udp"
				recover 0
			}
			assert refused == "EACCES/udp"
			assert (try Network.sendToNameServer(fd, query, addr, 1s)) == query.len()
			try Network.close(fd)
			// The files behind the system's configuration read as text, "" when absent.
			assert parseConfig(Network.resolverConfig()).ndots >= 1 && parseHosts(Network.hostsFile()).names("192.0.2.77").len() == 0
			let direct = try decode(try Network.exchangeWithNameServer(query, addr, 2s))
			assert direct.answers.len() == 1 && direct.answers[0].address == "192.0.2.1"

			// A client of the system follows a change of its configuration.
			let moved = new Server("127.0.0.1:0", zone)
			try moved.start()
			loadedConfig = Config{servers: [moved.address().str()], timeout: 2s}
			configGeneration++
			client.udpSize = 1232
			assert (try client.lookupHost("host.example.test.")).len() == 2
			assert client.servers.len() == 1 && client.servers[0] == moved.address().str() && client.search.len() == 0
			try moved.close()
			loadedConfig = Config{servers: [addr], search: ["example.test"], timeout: 2s}
			configGeneration++

			// `net.resolve` and a dial by name go through the same resolver.
			defaultClient = none
			let resolved = try net.resolve("host.example.test")
			assert resolved.len() == 2 && resolved[1] == "2001:db8::1"
			assert (try net.resolve("127.0.0.1"))[0] == "127.0.0.1"
			let missing = false
			net.resolve("missing.example.test") onerror (err error) {
				missing = err is net.NetError && err.kind == net.ErrorCode.Resolve
				recover []
			}
			assert missing
			// The name server's own TCP port is something to connect to.
			let conn = try net.dialStream("local.example.test:{server.address().port}", 2s)
			assert conn.remoteAddr().host == "127.0.0.1"
			try conn.close()

			loadedConfig = saved
			configPinned = false
			configGeneration++
			loadedHosts = savedHosts
			defaultClient = none
			try server.close()
			return none
		}

		@test()
		def TestPolicyOnLookups() !none {
			let system = new Server("127.0.0.1:0", try exampleZone())
			try system.start()
			let other = new Server("127.0.0.1:0", try exampleZone())
			try other.start()
			let saved = systemConfig()
			configPinned = true
			configGeneration++
			loadedConfig = Config{servers: [system.address().str()], timeout: 2s}
			let viaSystem = new Client()
			viaSystem.useHosts = false
			let explicit = clientFor(other)

			// DNS as a protocol is denied, and so is the name `mail.example.test`.
			try Policy.configure("[adm.network.connect]\nprotocol.deny = [\"dns\"]\nhost.deny = [\"mail.example.test\"]\n")
			let allowed = 0
			let deniedName = ""
			let deniedOverTCP = ""
			let deniedServer = ""
			let reached = viaSystem.lookupHost("host.example.test") onerror recover []
			allowed = reached.len()
			viaSystem.lookupHost("mail.example.test") onerror (err error) {
				deniedName = err.code
				recover []
			}
			viaSystem.tcp = true
			viaSystem.lookupHost("mail.example.test") onerror (err error) {
				deniedOverTCP = err.code
				recover []
			}
			explicit.lookupHost("host.example.test") onerror (err error) {
				deniedServer = err.code
				recover []
			}
			try Policy.configure("")
			loadedConfig = saved
			configPinned = false
			configGeneration++
			try system.close()
			try other.close()

			// Resolving through the system's server is part of connecting, so
			// the rule on `dns://server` does not apply; the rule on the name does.
			assert allowed == 2
			assert deniedName == "policy.denied" && deniedOverTCP == "policy.denied"
			// A server the program picks is a connection like any other.
			assert deniedServer == "policy.denied"
			return none
		}

		@test()
		def TestZoneEditing() !none {
			let zone = new Zone("example.test")
			try zone.add(addressRecord("a.example.test", "192.0.2.1"))
			try zone.add(addressRecord("a.example.test", "2001:db8::1"))
			try zone.add(txtRecord("A.Example.Test.", ["note"]))
			assert zone.len() == 3 && zone.find("a.example.test").len() == 3 && zone.find("a.example.test", RecordType.A).len() == 1
			let outside = ""
			zone.add(addressRecord("a.example.org", "192.0.2.1")) onerror (err error) {
				outside = kindOf(err)
				recover none
			}
			assert outside == ErrorKind.BadName.value
			assert zone.remove("a.example.test", RecordType.AAAA) == 1 && zone.len() == 2
			assert zone.remove("a.example.test") == 2 && zone.len() == 0 && zone.remove("a.example.test") == 0

			let mux = new Mux()
			assert mux.handlerFor("a.example.test") is none
			mux.handle("example.test", zone)
			assert !(mux.handlerFor("deep.a.Example.test.") is none) && mux.handlerFor("example.org") is none
			let query = try newQuery("example.org")
			assert (try mux.serve(Request{message: query, remote: new net.Address()})).rcode == RCode.Refused
			mux.handle(".", zone)
			assert !(mux.handlerFor("example.org") is none)
			return none
		}
	}
}
