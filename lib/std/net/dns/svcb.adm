partial module std.net.dns {
	use (
		std.crypto.x509::(ipText, parseIPText)
		std.data.encoding
	)

	// TLSA is the data of a TLSA record (DANE, RFC 6698): what a TLS server
	// at `_port._proto.name` must present.
	struct TLSA {
		// 0 CA constraint, 1 service certificate constraint, 2 trust anchor,
		// 3 domain-issued certificate.
		usage    int    = 3
		// 0 the whole certificate, 1 its public key.
		selector int    = 1
		// 0 the bytes as they are, 1 their SHA-256, 2 their SHA-512.
		matching int    = 1
		data     byte[] = []
	}

	// NAPTR is the data of a naming authority pointer (RFC 3403), as ENUM
	// and SIP use it: rewrite rules tried by `order`, then `preference`.
	struct NAPTR {
		order       int    = 0
		preference  int    = 0
		// `S`, `A`, `U` or `P`, or empty.
		flags       string = ""
		services    string = ""
		regexp      string = ""
		// The next name to look up when `regexp` is empty; "." for none.
		replacement string = "."
	}

	// SVCParam is one parameter of an SVCB or HTTPS record, its value in
	// wire form.
	struct SVCParam {
		key   int
		value byte[] = []
	}

	// SVCB is the data of an SVCB or HTTPS record (RFC 9460): where a
	// service is reached and how. Priority 0 makes `target` an alias of the
	// owner and carries no parameters.
	type SVCB {
		priority int        = 1
		// The host that serves, "." for the owner itself.
		target   string     = "."
		params   SVCParam[] = []

		// param is the wire value of the parameter, none when it is not set.
		def param(key SVCKey) ?byte[] {
			return param(key.value)
		}

		// param finds a parameter by the number of its key.
		def param(key int) ?byte[] {
			for let (_, p) in params {
				return p.value when p.key == key
			}
			return none
		}

		// set gives the parameter the wire value, replacing an earlier one.
		def set(key SVCKey, value byte[]) {
			set(key.value, value)
		}

		// set writes a parameter by the number of its key.
		def set(key int, value byte[]) {
			let kept SVCParam[]
			for let (_, p) in params {
				kept.push(p) unless p.key == key
			}
			kept.push(SVCParam{key: key, value: value})
			params = kept.sort((a SVCParam, b SVCParam) => a.key < b.key)
		}

		// alpn lists the protocols the service speaks (`h2`, `h3`), empty
		// when it names none.
		def alpn() string[] {
			let out string[]
			let raw = param(SVCKey.ALPN)
			return out when raw is none
			let at = 0
			for at < raw.len() {
				let n = int(raw[at])
				break when at + 1 + n > raw.len()
				out.push(string(raw[at + 1:at + 1 + n].clone()))
				at += 1 + n
			}
			return out
		}

		// port is the port of the service, 0 when the record names none.
		def port() int {
			let raw = param(SVCKey.Port)
			return 0 when raw is none || raw.len() != 2
			return int(raw[0]) << 8 | int(raw[1])
		}

		// hints lists the addresses the record gives for the target, IPv4
		// before IPv6, so a client can connect before it resolved it.
		def hints() string[] {
			let out string[]
			let v4 = param(SVCKey.IPv4Hint)
			if !(v4 is none) {
				for let at = 0; at + 4 <= v4.len(); at += 4 {
					out.push(ipText(v4[at:at + 4]))
				}
			}
			let v6 = param(SVCKey.IPv6Hint)
			if !(v6 is none) {
				for let at = 0; at + 16 <= v6.len(); at += 16 {
					out.push(ipText(v6[at:at + 16]))
				}
			}
			return out
		}

		// str renders the data the way a zone file writes it.
		def str() string {
			let out = "{priority} {dotted(target)}"
			for let (_, p) in params {
				out += " " + svcParamText(p)
			}
			return out
		}
	}

	// SVCKey names the SVCB parameters of RFC 9460 §14.3.2; another key is
	// its number.
	enum SVCKey {
		// The keys a client must understand to use the record.
		Mandatory = 0,
		// The protocols the service speaks.
		ALPN = 1,
		// The service does not speak the default protocol of its scheme.
		NoDefaultALPN = 2,
		Port = 3,
		IPv4Hint = 4,
		// The Encrypted ClientHello configuration.
		ECH = 5,
		IPv6Hint = 6,
	}

	internal const svcKeyNames string[] = ["mandatory", "alpn", "no-default-alpn", "port", "ipv4hint", "ech", "ipv6hint"]

	// svcKeyOf is the number of a parameter key as a zone file names it
	// (`alpn`, `key65400`), -1 when the text is not one.
	internal def svcKeyOf(name string) int {
		let at = svcKeyNames.indexOf(name.lower())
		return at when at >= 0
		return numbered(name.upper(), "KEY")
	}

	// svcParamText is the parameter as a zone file writes it.
	internal def svcParamText(p SVCParam) string {
		let name = p.key < svcKeyNames.len() ?? (svcKeyNames[p.key < 0 ?? (0, p.key)], "key{p.key}")
		let raw = p.value
		switch {
			case p.key == SVCKey.NoDefaultALPN.value:
				return name
			case p.key == SVCKey.Mandatory.value:
				let keys string[]
				for let at = 0; at + 2 <= raw.len(); at += 2 {
					let key = int(raw[at]) << 8 | int(raw[at + 1])
					keys.push(key < svcKeyNames.len() ?? (svcKeyNames[key], "key{key}"))
				}
				return name + "=" + keys.join(",")
			case p.key == SVCKey.ALPN.value:
				let ids string[]
				let at = 0
				for at < raw.len() {
					let n = int(raw[at])
					break when at + 1 + n > raw.len()
					ids.push(string(raw[at + 1:at + 1 + n].clone()))
					at += 1 + n
				}
				return name + "=" + ids.join(",")
			case p.key == SVCKey.Port.value:
				return name + "=0" when raw.len() != 2
				return "{name}={int(raw[0]) << 8 | int(raw[1])}"
			case p.key == SVCKey.IPv4Hint.value || p.key == SVCKey.IPv6Hint.value:
				let size = p.key == SVCKey.IPv4Hint.value ?? (4, 16)
				let ips string[]
				for let at = 0; at + size <= raw.len(); at += size {
					ips.push(ipText(raw[at:at + size]))
				}
				return name + "=" + ips.join(",")
			case p.key == SVCKey.ECH.value:
				return name + "=" + encoding.Base64{}.encode(raw)
			default:
				return name + "=" + quotedText(string(raw.clone()))
		}
	}

	// svcParamOf reads one `key=value` of a zone file into wire form; the
	// message says what is wrong with it.
	internal def svcParamOf(text string) !SVCParam {
		let eq = text.indexOf("=")
		let name = eq < 0 ?? (text, text[:eq])
		let value = eq < 0 ?? ("", text[eq + 1:])
		let key = svcKeyOf(name)
		fail errorOf(ErrorKind.Malformed, "\"{name}\" is not a service parameter") when key < 0
		let b = new Builder()
		switch {
			case key == SVCKey.NoDefaultALPN.value:
				fail errorOf(ErrorKind.Malformed, "no-default-alpn takes no value") when value != ""
			case key == SVCKey.Mandatory.value:
				for let (_, part) in value.split(",") {
					let listed = svcKeyOf(part)
					fail errorOf(ErrorKind.Malformed, "\"{part}\" is not a service parameter") when listed < 0
					b.u16(listed)
				}
			case key == SVCKey.ALPN.value:
				for let (_, part) in value.split(",") {
					let id = part.bytes()
					fail errorOf(ErrorKind.Malformed, "an alpn id has 1 to 255 bytes") when id.len() == 0 || id.len() > 255
					b.u8(id.len())
					b.bytes(id)
				}
			case key == SVCKey.Port.value:
				fail errorOf(ErrorKind.Malformed, "\"{value}\" is not a port") when value == "" || value.len() > 5 || !value.isNumeric() || value.toInt<int>() > 0xffff
				b.u16(value.toInt<int>())
			case key == SVCKey.IPv4Hint.value || key == SVCKey.IPv6Hint.value:
				let size = key == SVCKey.IPv4Hint.value ?? (4, 16)
				for let (_, part) in value.split(",") {
					let ip = parseIPText(part)
					fail errorOf(ErrorKind.Malformed, "\"{part}\" is not an address for {name}") when ip is none
					fail errorOf(ErrorKind.Malformed, "\"{part}\" is not an address for {name}") when ip.len() != size
					b.bytes(ip)
				}
			case key == SVCKey.ECH.value:
				let failed = false
				let raw = encoding.Base64{}.decode(value) onerror (err error) {
					failed = true
					recover []
				}
				fail errorOf(ErrorKind.Malformed, "ech is not base64") when failed
				b.bytes(raw)
			default:
				b.bytes(value.bytes())
		}
		return SVCParam{key: key, value: b.buf}
	}

	// tlsaRecord says what the TLS server at `_port._proto.name` presents
	// (`name` is that full name): by default the SHA-256 of its public key.
	def tlsaRecord(name string, data TLSA, ttl int = 300) Record {
		let r = newRecord(name, RecordType.TLSA, ttl)
		r.tlsa = data
		return r
	}

	// naptrRecord is a rewrite rule for `name`.
	def naptrRecord(name string, data NAPTR, ttl int = 300) Record {
		let r = newRecord(name, RecordType.NAPTR, ttl)
		r.naptr = data
		return r
	}

	// svcbRecord says where the service `name` (`_port._scheme.host`) is
	// reached.
	def svcbRecord(name string, data SVCB, ttl int = 300) Record {
		let r = newRecord(name, RecordType.SVCB, ttl)
		r.svcb = data
		return r
	}

	// httpsRecord says where and how the https origin `name` is reached
	// (RFC 9460 §9): its ALPN protocols, port and address hints.
	def httpsRecord(name string, data SVCB, ttl int = 300) Record {
		let r = newRecord(name, RecordType.HTTPS, ttl)
		r.svcb = data
		return r
	}
}
