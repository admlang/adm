partial module std.net.dns {
	use (
		std.data.encoding::(hexdecode)
		std.testing
	)

	check "Service records" {
		// serviceZone holds one record of each type, written as a zone file.
		def serviceZone() !Zone {
			let lines string[] = [
				"$ORIGIN example.test.",
				"$TTL 300",
				"@ SOA ns1 admin 1 1h 10m 1w 60",
				"@ HTTPS 1 . alpn=\"h2,h3\" port=8443 ipv4hint=192.0.2.1,192.0.2.2 ipv6hint=2001:db8::1 mandatory=alpn,port key65400=\"x y\"",
				"www HTTPS 0 svc.example.net.",
				"_8443._https.api SVCB 2 backend no-default-alpn alpn=h2 ech=AAEC",
				"_443._tcp TLSA 3 1 1 aabbccdd 00112233",
				"e164 NAPTR 100 10 \"U\" \"E2U+sip\" \"!^.*$!sip:info@example.test!\" .",
				"e164 NAPTR 102 20 S SIP+D2T \"\" _sip._tcp",
			]
			return try parseZone(lines.join("\n") + "\n")
		}

		// refuses reports whether the zone file line fails as Malformed with
		// the fragment in its message.
		def refuses(line string, fragment string) bool {
			let message = ""
			parseZone(line + "\n", "example.test") onerror (err error) {
				message = err.message
				recover new Zone("failed.test")
			}
			return message.contains(fragment)
		}

		@test()
		def TestServiceRecordsFromAZoneFile() !none {
			let zone = try serviceZone()
			let top = zone.find("example.test", RecordType.HTTPS)
			assert top.len() == 1
			let svc = top[0].svcb
			fail "the HTTPS record has no data" when svc is none
			assert svc.priority == 1 && svc.target == "." && svc.port() == 8443
			assert svc.alpn().len() == 2 && svc.alpn()[0] == "h2" && svc.alpn()[1] == "h3"
			let hints = svc.hints()
			assert hints.len() == 3 && hints[0] == "192.0.2.1" && hints[2] == "2001:db8::1"
			// Parameters are kept in key order, whatever order they came in.
			assert svc.params.len() == 6 && svc.params[0].key == 0 && svc.params[5].key == 65400
			assert svc.param(SVCKey.ECH) is none && !(svc.param(65400) is none)
			assert svc.str() == "1 . mandatory=alpn,port alpn=h2,h3 port=8443 ipv4hint=192.0.2.1,192.0.2.2 ipv6hint=2001:db8::1 key65400=\"x y\""

			let alias = zone.find("www.example.test")[0].svcb
			fail "the alias record has no data" when alias is none
			assert alias.priority == 0 && alias.target == "svc.example.net" && alias.params.len() == 0
			let backend = zone.find("_8443._https.api.example.test", RecordType.SVCB)[0].svcb
			fail "the SVCB record has no data" when backend is none
			assert backend.target == "backend.example.test" && backend.str() == "2 backend.example.test. alpn=h2 no-default-alpn ech=AAEC"

			let dane = zone.find("_443._tcp.example.test")[0].tlsa
			fail "the TLSA record has no data" when dane is none
			assert dane.usage == 3 && dane.selector == 1 && dane.matching == 1 && dane.data.hex() == "AABBCCDD00112233"

			let rules = zone.find("e164.example.test", RecordType.NAPTR)
			assert rules.len() == 2
			let first = rules[0].naptr
			let second = rules[1].naptr
			fail "a NAPTR record has no data" when first is none
			fail "a NAPTR record has no data" when second is none
			assert first.order == 100 && first.flags == "U" && first.services == "E2U+sip" && first.regexp == "!^.*$!sip:info@example.test!" && first.replacement == "."
			assert second.preference == 20 && second.regexp == "" && second.replacement == "_sip._tcp.example.test"

			// What the zone writes reads back the same.
			let again = try parseZone(zone.str())
			assert again.len() == zone.len() && again.str() == zone.str()
			return none
		}

		@test()
		def TestServiceRecordsOnTheWire() !none {
			let zone = try serviceZone()
			let response = (try newQuery("example.test", RecordType.HTTPS)).reply()
			response.answers = zone.all()
			let back = try decode(try response.encode())
			assert back.answers.len() == zone.len()
			for let (i, r) in back.answers {
				assert r.str() == response.answers[i].str()
			}

			// Built in code.
			let svc = new SVCB()
			svc.set(SVCKey.Port, [byte(0x01), byte(0xbb)])
			svc.set(SVCKey.ALPN, [byte(2), byte(0x68), byte(0x33)])
			svc.set(SVCKey.Port, [byte(0x20), byte(0xfb)])
			assert svc.params.len() == 2 && svc.port() == 8443 && svc.alpn()[0] == "h3"
			let built = (try newQuery("example.test", RecordType.HTTPS)).reply()
			built.answers = [httpsRecord("example.test", svc), tlsaRecord("_443._tcp.example.test", TLSA{data:[byte(1), byte(2)]}), naptrRecord("e164.example.test", NAPTR{order:1, services:"x"}), svcbRecord("_1._x.example.test", new SVCB())]
			let round = try decode(try built.encode())
			assert round.answers[0].str() == "example.test. 300 IN HTTPS 1 . alpn=h3 port=8443"
			assert round.answers[1].str() == "_443._tcp.example.test. 300 IN TLSA 3 1 1 0102"
			assert round.answers[2].str() == "e164.example.test. 300 IN NAPTR 1 0 \"\" \"x\" \"\" ."

			// Keys out of order are not a record.
			let kind = ""
			decode(try hexdecode("000084000000000100000000" + "00" + "0041" + "0001" + "0000012c" + "000d" + "0001" + "00" + "0003" + "0002" + "01bb" + "0001" + "0000")) onerror (err error) {
				kind = err.kind.value when err is DNSError
				recover new Message()
			}
			assert kind == "malformed"
			return none
		}

		@test()
		def TestServiceRecordErrors() {
			assert refuses("a HTTPS 1 . port=99999", "not a port")
			assert refuses("a HTTPS 1 . port=1 port=2", "given twice")
			assert refuses("a HTTPS 1 . speed=fast", "not a service parameter")
			assert refuses("a HTTPS 1 . ipv4hint=2001:db8::1", "not an address")
			assert refuses("a HTTPS 1 . no-default-alpn=yes", "takes no value")
			assert refuses("a HTTPS 1 . ech=@@", "not base64")
			assert refuses("a HTTPS 1", "priority and a target")
			assert refuses("a TLSA 3 1 1", "4 fields")
			assert refuses("a TLSA 3 1 1 xyz", "not hexadecimal")
			assert refuses("a NAPTR 1 2 U", "takes 6 fields")
		}
	}
}
