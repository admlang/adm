partial module std.net.dns {
	use (
		std.crypto.x509::(parseIPText)
		std.net
		std.testing
	)

	check "Transfer" {
		// bigZone is a zone whose transfer takes several messages.
		def bigZone() !Zone {
			let zone = try parseZone("$TTL 300\n@ SOA ns1 admin 42 1h 10m 1w 60\n@ NS ns1\nns1 A 192.0.2.53\nwww A 192.0.2.1\n", "example.test")
			for let i = 0; i < 1500; i++ {
				try zone.add(txtRecord("n{i}.example.test", ["record number {i} of a zone too long for one message of a transfer"]))
			}
			return zone
		}

		// ipOf is the address as bytes, empty when the text is not one.
		def ipOf(text string) byte[] {
			let ip = parseIPText(text)
			return [] when ip is none
			return ip
		}

		@test()
		def TestTransferAZone() !none {
			let zone = try bigZone()
			let server = new Server("127.0.0.1:0", zone)
			try server.start()
			let client = new Client([server.address().str()])
			client.useHosts = false
			client.timeout = 5s

			// Nobody may transfer until the zone says who.
			let kind = ""
			let code = RCode.Success
			client.transfer("example.test", server.address().str()) onerror (err error) {
				kind = err.kind.value when err is DNSError
				code = err.rcode when err is DNSError
				recover new Zone("failed.test")
			}
			assert kind == "server-failed" && code == RCode.Refused

			zone.allowTransfer = ["192.0.2.0/24", "127.0.0.0/8"]
			let copy = try client.transfer("Example.Test.", server.address().str())
			assert copy.origin == "example.test" && copy.len() == zone.len() && copy.len() == 1504
			let top = copy.find("example.test", RecordType.SOA)
			assert top.len() == 1
			let soa = top[0].soa
			fail "the transferred SOA record has no data" when soa is none
			assert soa.serial == 42 && soa.mname == "ns1.example.test"
			assert copy.find("www.example.test")[0].address == "192.0.2.1"
			assert copy.find("n1499.example.test")[0].text[0].startsWith("record number 1499 ")
			assert copy.str() == zone.str()

			// A name inside the zone is not a zone of the server.
			code = RCode.Success
			client.transfer("www.example.test", server.address().str()) onerror (err error) {
				code = err.rcode when err is DNSError
				recover new Zone("failed.test")
			}
			assert code == RCode.NotAuth

			// A transfer needs TCP.
			zone.allowTransfer = ["*"]
			let overUDP = try client.query("example.test", RecordType.AXFR)
			assert overUDP.rcode == RCode.Refused && overUDP.answers.len() == 0

			try server.close()
			return none
		}

		@test()
		def TestTransferMessages() !none {
			let zone = try bigZone()
			zone.allowTransfer = ["127.0.0.1"]
			let server = new Server("127.0.0.1:0", zone)
			let query = try newQuery("example.test", RecordType.AXFR)
			let response = server.respond(Request{message: query, remote: try net.parseAddress("127.0.0.1:4000"), tcp: true})
			assert response.rcode == RCode.Success && response.authoritative && response.answers.len() == 1505
			assert response.answers[0].kind == RecordType.SOA && response.answers[1504].kind == RecordType.SOA

			let held = zone.all()
			assert held.len() == 1504 && held[0].kind == RecordType.SOA && held[1].name == "example.test" && held[1503].name == "www.example.test"

			let frames = try transferFrames(response)
			assert frames.len() > 1
			let total = 0
			for let (_, wire) in frames {
				assert wire.len() <= 65535
				let part = try decode(wire)
				assert part.id == query.id && part.response && part.authoritative && !part.truncated
				assert part.questions.len() == 1 && part.answers.len() > 0
				total += part.answers.len()
			}
			assert total == 1505

			// Any other response is one message.
			let plain = server.respond(Request{message: try newQuery("www.example.test"), remote: try net.parseAddress("127.0.0.1:4000"), tcp: true})
			assert (try transferFrames(plain)).len() == 1

			let other = server.respond(Request{message: query, remote: try net.parseAddress("192.0.2.9:4000"), tcp: true})
			assert other.rcode == RCode.Refused
			return none
		}

		@test()
		def TestAllowTransferPrefixes() !none {
			assert inPrefix(ipOf("10.1.2.3"), "10.0.0.0/8") && inPrefix(ipOf("10.1.2.3"), "10.1.2.0/30") && inPrefix(ipOf("10.1.2.3"), "10.1.2.3")
			assert !inPrefix(ipOf("10.1.2.3"), "10.1.2.0/31") && !inPrefix(ipOf("11.1.2.3"), "10.0.0.0/8") && !inPrefix(ipOf("10.1.2.3"), "10.1.2.4")
			assert inPrefix(ipOf("10.1.2.3"), "0.0.0.0/0") && inPrefix(ipOf("2001:db8::7"), "2001:db8::/32") && inPrefix(ipOf("::1"), "::1")
			assert !inPrefix(ipOf("2001:db9::7"), "2001:db8::/32") && !inPrefix(ipOf("::1"), "0.0.0.0/0") && !inPrefix(ipOf("10.1.2.3"), "::/0")
			assert !inPrefix(ipOf("10.1.2.3"), "10.0.0.0/33") && !inPrefix(ipOf("10.1.2.3"), "10.0.0.0/") && !inPrefix(ipOf("10.1.2.3"), "ten/8")

			let zone = new Zone("example.test")
			assert !zone.allowsTransfer(try net.parseAddress("127.0.0.1:53"))
			zone.allowTransfer = ["10.0.0.0/8", "::1"]
			assert zone.allowsTransfer(try net.parseAddress("10.9.9.9:4000")) && zone.allowsTransfer(try net.parseAddress("[::1]:4000"))
			assert zone.allowsTransfer(try net.parseAddress("[::ffff:10.1.2.3]:4000"))
			assert !zone.allowsTransfer(try net.parseAddress("192.0.2.1:4000")) && !zone.allowsTransfer(try net.parseAddress("host.example.test:4000"))
			zone.allowTransfer = ["*"]
			assert zone.allowsTransfer(try net.parseAddress("192.0.2.1:4000"))
			return none
		}
	}
}
