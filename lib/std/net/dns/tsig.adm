// Transaction signatures (TSIG, RFC 8945): two parties that share a secret
// sign their messages with an HMAC, so that each knows the other holds
// the key and that nothing changed on the way. It is how a primary
// knows which secondary asks for a transfer and which client sends a
// dynamic update, where an address proves little.
//
// ```
// let key = new dns.TSIGKey("transfer.example.test", secret)
//
// zone.allowTransfer = ["key:transfer.example.test"]
// server.keys = [key]
//
// let client = new dns.Client()
// client.key = key
// let copy = try client.transfer("example.test", "192.0.2.53")
// ```

partial module std.net.dns {
	use (
		std.crypto::(constantTimeEqual, rand)
		std.crypto.hash::(Hash, hmac)
		std.time
	)

	// TSIGAlgorithm names the HMAC of a key; the value is the algorithm
	// name on the wire.
	enum TSIGAlgorithm {
		HMACSHA1 = "hmac-sha1",
		HMACSHA256 = "hmac-sha256",
		HMACSHA384 = "hmac-sha384",
		HMACSHA512 = "hmac-sha512",
	}

	// The TSIG error codes a response carries in its TSIG record.
	internal const tsigBadSignature = 16
	internal const tsigBadKey = 17
	internal const tsigBadTime = 18
	internal const tsigBadTruncation = 22

	// tsigFormatError is not a wire TSIG error code: tsigFault returns it
	// for a MAC whose length could never be a valid truncation (RFC 8945
	// §5.2.2.1), which the caller answers with FORMERR, not a TSIG
	// refusal.
	internal const tsigFormatError = -1

	// TSIG is the data of a TSIG record, which signs the message it ends.
	struct TSIG {
		// The owner of the record: the name of the key.
		keyName    string
		// The algorithm name, a `TSIGAlgorithm` value for the ones known.
		algorithm  string
		// When the message was signed, in seconds since the Unix epoch, and
		// how many seconds the receiver's clock may differ.
		timeSigned int
		fudge      int    = 300
		mac        byte[] = []
		// The id the message was signed with, which a forwarder may change.
		originalID int    = 0
		// 0, or why the server refused the signature of the query: 16 for a
		// signature that does not verify, 17 for a key it does not know, 18
		// for a time outside the fudge, 22 for a MAC too short for the
		// server's policy.
		error      int    = 0
		other      byte[] = []
	}

	// TSIGKey is a secret two parties share, under the name both know it by.
	type TSIGKey {
		name      string
		secret    byte[]
		algorithm TSIGAlgorithm = TSIGAlgorithm.HMACSHA256
		// How many bytes of the MAC are sent; 0 sends it whole. At least 10
		// and at least half the digest (RFC 8945 §5.2.2.1).
		macSize   int           = 0

		def new(name string, secret byte[], algorithm TSIGAlgorithm = TSIGAlgorithm.HMACSHA256) {
			self.name = canonicalName(name)
			self.secret = secret
			self.algorithm = algorithm
		}

		// sign appends the TSIG record to an encoded message and returns the
		// signed message with the record's data. `prior` is the MAC of the
		// request when the message is its response, and of the message
		// before when it continues a stream, where `timersOnly` leaves the
		// key's name and algorithm out of what is signed (RFC 8945 §5.3.1).
		// The MAC appended is truncated to `macSize` bytes when that is set.
		// `Message.encode` signs by itself when the message has a `key`.
		// Fails with Malformed on a message without a header, and with
		// BadName when the key's name is not a domain name.
		def sign(wire byte[], prior byte[] = [], timersOnly bool = false, now ?time.Time = none) !(byte[], TSIG) {
			return try sealed(self, wire, prior, timersOnly, now, 0)
		}

		// verify checks the TSIG record of a decoded message: that this key
		// made it over the message and `prior`, as `sign` takes it, and that
		// `now`, the present when none, is within the fudge of its time.
		// Fails with BadSignature; the message says which check failed.
		def verify(message Message, prior byte[] = [], timersOnly bool = false, now ?time.Time = none) !none {
			let fault = tsigFault(self, message, prior, [], timersOnly, now)
			return none when fault == 0
			fail errorOf(ErrorKind.BadSignature, "the message is not signed") when message.tsig is none
			fail errorOf(ErrorKind.BadSignature, "the signature was made with another key than {name}") when fault == tsigBadKey
			fail errorOf(ErrorKind.BadSignature, "the signature was made at another time than the clock allows") when fault == tsigBadTime
			fail errorOf(ErrorKind.BadSignature, "the MAC is shorter than {name}'s macSize allows") when fault == tsigBadTruncation
			fail errorOf(ErrorKind.BadSignature, "the MAC's length is not a valid truncation of the digest") when fault == tsigFormatError
			fail errorOf(ErrorKind.BadSignature, "the signature of {name} does not verify")
		}
	}

	// generateTSIGKey draws a new secret as long as the algorithm's digest.
	// Fails when the system's random source is unavailable.
	def generateTSIGKey(name string, algorithm TSIGAlgorithm = TSIGAlgorithm.HMACSHA256) !TSIGKey {
		let sizes = map<string, int>{"hmac-sha1": 20, "hmac-sha256": 32, "hmac-sha384": 48, "hmac-sha512": 64}
		let size = sizes.get(algorithm.value)
		return new TSIGKey(name, try rand(size is none ?? (32, size)), algorithm)
	}

	// tsigErrorName is the name of a TSIG error code.
	internal def tsigErrorName(code int) string {
		return "BADSIG" when code == tsigBadSignature
		return "BADKEY" when code == tsigBadKey
		return "BADTIME" when code == tsigBadTime
		return "BADTRUNC" when code == tsigBadTruncation
		return "FORMERR" when code == tsigFormatError
		return "error {code}"
	}

	internal def tsigHash(algorithm TSIGAlgorithm) Hash {
		match algorithm {
			case TSIGAlgorithm.HMACSHA1:
				return Hash.SHA1
			case TSIGAlgorithm.HMACSHA384:
				return Hash.SHA384
			case TSIGAlgorithm.HMACSHA512:
				return Hash.SHA512
			default:
				return Hash.SHA256
		}
	}

	// tsigMAC is the HMAC over what a TSIG record signs (RFC 8945 §4.3):
	// the prior MAC with its length, the messages of a stream that went
	// unsigned since, the message without the record, and the record's
	// variables, or its timers only.
	internal def tsigMAC(key TSIGKey, prior byte[], unsigned byte[], body byte[], sig TSIG, timersOnly bool) !byte[] {
		let b = new Builder()
		b.canonical = true
		if prior.len() > 0 {
			b.u16(prior.len())
			b.bytes(prior)
		}
		b.bytes(unsigned)
		b.bytes(body)
		if !timersOnly {
			try b.name(key.name, false)
			b.u16(RecordClass.ANY.value)
			b.u32(0)
			try b.name(key.algorithm.value, false)
		}
		b.u16(sig.timeSigned >> 32 & 0xffff)
		b.u32(sig.timeSigned & 0xffffffff)
		b.u16(sig.fudge)
		if !timersOnly {
			b.u16(sig.error)
			b.u16(sig.other.len())
			b.bytes(sig.other)
		}
		return hmac(tsigHash(key.algorithm), key.secret, b.buf)
	}

	// sealed signs an encoded message, with the error a refusal reports. A
	// BADTIME refusal carries the server's time (RFC 8945 §5.2.3).
	internal def sealed(key TSIGKey, wire byte[], prior byte[], timersOnly bool, now ?time.Time, fault int) !(byte[], TSIG) {
		fail errorOf(ErrorKind.Malformed, "a message of {wire.len()} bytes has no header to sign") when wire.len() < 12
		let at = now is none ?? (time.now(), now)
		let seconds = int(at.unixNs() / 1000000000)
		let sig = TSIG{keyName: key.name, algorithm: key.algorithm.value, timeSigned: seconds, originalID: int(wire[0]) << 8 | int(wire[1]), error: fault}
		sig.other = [byte(seconds >> 40 & 0xff), byte(seconds >> 32 & 0xff), byte(seconds >> 24 & 0xff), byte(seconds >> 16 & 0xff), byte(seconds >> 8 & 0xff), byte(seconds & 0xff)] when fault == tsigBadTime
		let mac = try tsigMAC(key, prior, [], wire, sig, timersOnly)
		sig.mac = key.macSize > 0 && key.macSize < mac.len() ?? (mac[:key.macSize].clone(), mac)
		return (try withTSIG(wire, sig), sig)
	}

	// withTSIG is the encoded message with the record appended and counted.
	internal def withTSIG(wire byte[], sig TSIG) !byte[] {
		let data = new Builder()
		data.canonical = true
		try data.name(sig.algorithm, false)
		data.u16(sig.timeSigned >> 32 & 0xffff)
		data.u32(sig.timeSigned & 0xffffffff)
		data.u16(sig.fudge)
		data.u16(sig.mac.len())
		data.bytes(sig.mac)
		data.u16(sig.originalID)
		data.u16(sig.error)
		data.u16(sig.other.len())
		data.bytes(sig.other)

		let b = new Builder()
		b.canonical = true
		b.bytes(wire)
		try b.name(sig.keyName, false)
		b.u16(RecordType.TSIG.value)
		b.u16(RecordClass.ANY.value)
		b.u32(0)
		b.u16(data.buf.len())
		b.bytes(data.buf)
		let additional = (int(wire[10]) << 8 | int(wire[11])) + 1
		fail errorOf(ErrorKind.Malformed, "a section has over 65535 entries") when additional > 0xffff
		b.buf[10] = byte(additional >> 8)
		b.buf[11] = byte(additional & 0xff)
		return b.buf
	}

	// tsigOf reads the data of a decoded TSIG record.
	// Fails with Malformed when the data ends early.
	internal def tsigOf(r Record) !TSIG {
		let p = new Parser(r.data)
		let algorithm = try p.name()
		let high = try p.u16()
		let low = try p.u32()
		let out = TSIG{keyName: canonicalName(r.name), algorithm: canonicalName(algorithm), timeSigned: high << 32 | low}
		out.fudge = try p.u16()
		out.mac = (try p.bytes(try p.u16())).clone()
		out.originalID = try p.u16()
		out.error = try p.u16()
		out.other = (try p.bytes(try p.u16())).clone()
		return out
	}

	// signedPart is what the TSIG record of a received message covers: the
	// bytes before the record, with the id the signer saw and without the
	// record in the count of the additional section.
	internal def signedPart(data byte[], end int, originalID int) byte[] {
		let out = data[:end].clone()
		out[0] = byte(originalID >> 8 & 0xff)
		out[1] = byte(originalID & 0xff)
		let additional = (int(out[10]) << 8 | int(out[11])) - 1
		out[10] = byte(additional >> 8 & 0xff)
		out[11] = byte(additional & 0xff)
		return out
	}

	// tsigFault is the TSIG error a receiver finds in a decoded message, 0
	// when the key signed it: 17 for another key or algorithm, 16 for no
	// signature or one that does not verify, 18 for a time outside the
	// fudge, 22 for a MAC shorter than the key's `macSize`. A MAC longer
	// than the digest, or shorter than RFC 8945's floor of 10 bytes and
	// half the digest, is a format problem rather than a signature one:
	// `tsigFormatError`, for the caller to answer with FORMERR instead of
	// a TSIG refusal (RFC 8945 §5.2.2.1). `unsigned` holds the messages of
	// a stream that came without a record since the last signed one.
	internal def tsigFault(key TSIGKey, message Message, prior byte[], unsigned byte[], timersOnly bool, now ?time.Time) int {
		let sig = message.tsig
		return tsigBadSignature when sig is none
		return tsigBadKey when sig.keyName != key.name || sig.algorithm != key.algorithm.value
		let nothing byte[]
		let expected = tsigMAC(key, prior, unsigned, message.signedData, sig, timersOnly) onerror recover nothing
		return tsigBadSignature when expected.len() == 0
		let half = (expected.len() + 1) / 2
		let floor = half.max(10)
		return tsigFormatError when sig.mac.len() > expected.len() || sig.mac.len() < floor
		return tsigBadTruncation when key.macSize > 0 && sig.mac.len() < key.macSize
		return tsigBadSignature unless constantTimeEqual(expected[:sig.mac.len()], sig.mac)
		let at = now is none ?? (time.now(), now)
		let drift = int(at.unixNs() / 1000000000) - sig.timeSigned
		return tsigBadTime when drift > sig.fudge || -drift > sig.fudge
		return 0
	}

	// TSIGStream checks the messages of one signed exchange in order: the
	// first against the MAC of the request, each later one against the MAC
	// before it. A stream may leave up to 99 messages in a row unsigned,
	// which the next signature then covers (RFC 8945 §5.3.1).
	internal type TSIGStream {
		key      ?TSIGKey = none
		prior    byte[]   = []
		unsigned byte[]   = []
		skipped  int      = 0
		first    bool     = true

		def new(key ?TSIGKey, query Message) {
			self.key = key
			let sent = query.tsig
			self.prior = sent.mac unless sent is none
		}

		// accept checks one message, `frame` being its bytes.
		// Fails with BadSignature.
		def accept(part Message, frame byte[]) !none {
			let signer = key
			return none when signer is none
			let sig = part.tsig
			if sig is none {
				fail errorOf(ErrorKind.BadSignature, "the server answered {part.rcode.name} without a signature") when first
				skipped++
				fail errorOf(ErrorKind.BadSignature, "over 99 messages in a row are not signed") when skipped > 99
				for let i = 0; i < frame.len(); i++ {
					unsigned.push(frame[i])
				}
				return none
			}
			fail errorOf(ErrorKind.BadSignature, "the server refused the signature: {tsigErrorName(sig.error)}") when sig.error != 0
			let fault = tsigFault(signer, part, prior, unsigned,!first, none)
			fail errorOf(ErrorKind.BadSignature, "the answer fails its signature check: {tsigErrorName(fault)}") when fault != 0
			prior = sig.mac
			unsigned = []
			skipped = 0
			first = false
			return none
		}

		// end checks that the stream did not close on unsigned messages.
		// Fails with BadSignature.
		def end() !none {
			fail errorOf(ErrorKind.BadSignature, "the last message of the answer is not signed") when skipped > 0
			return none
		}
	}
}
