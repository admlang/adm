partial module std.net.dns {
	use (
		std.net
		std.testing
		std.time
	)

	check "TSIG" {
		def secretOf(text string) byte[] {
			return text.bytes()
		}

		// kindOf is the error kind and message the call failed with.
		def failureOf(err error) string {
			return "{err.kind.value}: {err.message}" when err is DNSError
			return err.message
		}

		def signedZone() !Zone {
			let zone = try parseZone("$TTL 300\n@ SOA ns1 admin 42 1h 10m 1w 60\n@ NS ns1\nns1 A 192.0.2.53\nwww A 192.0.2.1\n", "example.test")
			for let i = 0; i < 1500; i++ {
				try zone.add(txtRecord("n{i}.example.test", ["record number {i} of a zone too long for one message of a transfer"]))
			}
			return zone
		}

		@test()
		def TestSignsAndVerifiesAMessage() !none {
			let key = new TSIGKey("Key.Example.Test.", secretOf("a secret of thirty-two bytes long"))
			assert key.name == "key.example.test"
			let query = try newQuery("www.example.test")
			query.key = key
			let wire = try query.encode()
			let sent = query.tsig
			fail "encode left no TSIG" when sent is none
			assert sent.mac.len() == 32 && sent.originalID == query.id && sent.fudge == 300

			let got = try decode(wire)
			let sig = got.tsig
			fail "decode found no TSIG" when sig is none
			assert sig.keyName == "key.example.test" && sig.algorithm == "hmac-sha256" && sig.mac.hex() == sent.mac.hex()
			assert got.additionals.len() == 0 && got.signedData.len() > 0
			try key.verify(got)

			// A forwarder may change the id; the signature covers the first one.
			let forwarded = wire.clone()
			forwarded[0] = byte(int(forwarded[0]) ^ 0xff)
			try key.verify(try decode(forwarded))

			let changed = wire.clone()
			changed[14] = byte(int(changed[14]) ^ 0x01)
			let refusal = ""
			key.verify(try decode(changed)) onerror (err error) {
				refusal = failureOf(err)
				recover none
			}
			assert refusal.startsWith("bad-signature:") && refusal.contains("does not verify")

			let other = new TSIGKey("key.example.test", secretOf("another secret of the same length"))
			refusal = ""
			other.verify(got) onerror (err error) {
				refusal = failureOf(err)
				recover none
			}
			assert refusal.contains("does not verify")

			let renamed = new TSIGKey("other.example.test", key.secret)
			refusal = ""
			renamed.verify(got) onerror (err error) {
				refusal = failureOf(err)
				recover none
			}
			assert refusal.contains("another key")

			refusal = ""
			key.verify(got, [], false, time.now() + 10m) onerror (err error) {
				refusal = failureOf(err)
				recover none
			}
			assert refusal.contains("another time")
			try key.verify(got, [], false, time.now() + 4m)

			refusal = ""
			key.verify(try decode(try (try newQuery("www.example.test")).encode())) onerror (err error) {
				refusal = failureOf(err)
				recover none
			}
			assert refusal.contains("not signed")

			// Every algorithm signs with a MAC as long as its digest.
			let algorithms TSIGAlgorithm[] = [TSIGAlgorithm.HMACSHA1, TSIGAlgorithm.HMACSHA256, TSIGAlgorithm.HMACSHA384, TSIGAlgorithm.HMACSHA512]
			for let (_, algorithm) in algorithms {
				let made = try generateTSIGKey("generated.test", algorithm)
				let message = try newQuery("example.test", RecordType.SOA)
				message.key = made
				let back = try decode(try message.encode())
				try made.verify(back)
				let data = back.tsig
				fail "decode found no TSIG" when data is none
				assert data.mac.len() == made.secret.len()
			}
		}

		@test()
		def TestAServerAnswersSignedQueries() !none {
			let zone = try parseZone("$TTL 300\n@ SOA ns1 admin 1 1h 10m 1w 60\n@ NS ns1\nwww A 192.0.2.1\n", "example.test")
			let key = try generateTSIGKey("client.example.test")
			let server = new Server("127.0.0.1:0", zone)
			server.keys = [key]
			try server.start()
			let addr = server.address().str()

			let client = new Client([addr])
			client.useHosts = false
			client.key = key
			let found = try client.lookup("www.example.test.")
			assert found.len() == 1 && found[0].address == "192.0.2.1"
			let response = try client.query("www.example.test")
			let sig = response.tsig
			fail "the response is not signed" when sig is none
			assert sig.keyName == "client.example.test" && sig.error == 0
			client.tcp = true
			assert (try client.lookup("www.example.test.")).len() == 1

			// The handler learns which key signed.
			let direct = try newQuery("www.example.test")
			direct.key = key
			let seen = try decode(try direct.encode())
			let answered = server.respond(Request{message: seen, remote: new net.Address()})
			assert answered.rcode == RCode.Success
			let signer = answered.key
			assert !(signer is none) && answered.requestMAC.len() == 32

			// An unsigned client is served as before.
			let plain = new Client([addr])
			plain.useHosts = false
			assert (try plain.lookup("www.example.test.")).len() == 1

			let wrong = new Client([addr])
			wrong.useHosts = false
			wrong.attempts = 1
			wrong.key = new TSIGKey("client.example.test", secretOf("not the secret the server holds."))
			let refusal = ""
			wrong.query("www.example.test") onerror (err error) {
				refusal = failureOf(err)
				recover new Message()
			}
			assert refusal.startsWith("bad-signature:") && refusal.contains("BADSIG")

			let stranger = new Client([addr])
			stranger.useHosts = false
			stranger.attempts = 1
			stranger.key = try generateTSIGKey("stranger.example.test")
			refusal = ""
			stranger.query("www.example.test") onerror (err error) {
				refusal = failureOf(err)
				recover new Message()
			}
			assert refusal.contains("BADKEY")

			// A server that lost the key refuses it like any other.
			server.keys = []
			refusal = ""
			client.query("www.example.test") onerror (err error) {
				refusal = failureOf(err)
				recover new Message()
			}
			assert refusal.startsWith("bad-signature:") && refusal.contains("BADKEY")

			try server.close()
			return none
		}

		@test()
		def TestAKeyAllowsATransferAndAnUpdate() !none {
			let zone = try signedZone()
			let key = try generateTSIGKey("secondary.example.test", TSIGAlgorithm.HMACSHA512)
			zone.allowTransfer = ["key:secondary.example.test"]
			zone.allowUpdate = ["key:Secondary.Example.Test."]
			let server = new Server("127.0.0.1:0", zone)
			server.keys = [key]
			try server.start()
			let addr = server.address().str()

			let plain = new Client([addr])
			plain.useHosts = false
			plain.timeout = 5s
			let code = RCode.Success
			plain.transfer("example.test", addr) onerror (err error) {
				code = err.rcode when err is DNSError
				recover new Zone("failed.test")
			}
			assert code == RCode.Refused

			let client = new Client([addr])
			client.useHosts = false
			client.timeout = 5s
			client.key = key
			let copy = try client.transfer("example.test", addr)
			assert copy.len() == zone.len() && copy.len() == 1504

			let change = new Update("example.test")
			change.add(addressRecord("new.example.test", "192.0.2.77"))
			code = RCode.Success
			plain.update(change, addr) onerror (err error) {
				code = err.rcode when err is DNSError
				recover none
			}
			assert code == RCode.Refused && zone.find("new.example.test").len() == 0
			try client.update(change, addr)
			assert zone.find("new.example.test").len() == 1

			// The incremental transfer is signed the same way.
			assert try client.transfer(copy, addr)
			assert copy.find("new.example.test").len() == 1

			try server.close()
			return none
		}

		@test()
		def TestASignedNotify() !none {
			let zone = try parseZone("$TTL 300\n@ SOA ns1 admin 1 1h 10m 1w 60\n@ NS ns1\n", "example.test")
			let key = try generateTSIGKey("notify.example.test")
			let signers string[]
			let handler = new HandlerFunc(def (request Request) !Message {
				signers.push(request.key)
				return request.message.reply()
			})
			let secondary = new Server("127.0.0.1:0", handler)
			secondary.keys = [key]
			try secondary.start()

			zone.secondaries = [secondary.address().str()]
			zone.notifyKey = key
			try zone.publish()
			for let wait = 0; wait < 100 && signers.len() == 0; wait++ {
				time.sleep(20ms)
			}
			assert signers.len() == 1 && signers[0] == "notify.example.test"
			try secondary.close()
			return none
		}

		// RFC 8945 §5.2.2.1: a MAC may be sent truncated as long as it stays
		// at or above the larger of 10 bytes and half the digest, and at or
		// above the receiver's own policy floor; shorter than that floor is
		// BADTRUNC, shorter than the RFC minimum is a format error.
		@test()
		def TestTruncatedMACs() !none {
			let secret = secretOf("a secret of thirty-two bytes long")
			let key = new TSIGKey("trunc.example.test", secret)
			key.macSize = 16
			let query = try newQuery("www.example.test")
			query.key = key
			let wire = try query.encode()
			let sent = query.tsig
			fail "encode left no TSIG" when sent is none
			assert sent.mac.len() == 16
			try key.verify(try decode(wire))

			// A server with no macSize of its own accepts the 16-byte MAC,
			// since it already meets the RFC floor for HMAC-SHA256 (half of
			// 32), and its own response verifies back at the client.
			let zone = try parseZone("$TTL 300\n@ SOA ns1 admin 1 1h 10m 1w 60\n@ NS ns1\nwww A 192.0.2.1\n", "example.test")
			let serverKey = new TSIGKey("trunc.example.test", secret)
			let server = new Server("127.0.0.1:0", zone)
			server.keys = [serverKey]
			try server.start()

			let client = new Client([server.address().str()])
			client.useHosts = false
			client.key = key
			let found = try client.lookup("www.example.test.")
			assert found.len() == 1 && found[0].address == "192.0.2.1"

			// A server whose key demands more than 16 bytes refuses the same
			// query with BADTRUNC, signing the refusal (RFC 8945 §5.3.2).
			let strictKey = new TSIGKey("trunc.example.test", secret)
			strictKey.macSize = 24
			server.keys = [strictKey]
			let direct = try newQuery("www.example.test")
			direct.key = key
			let seen = try decode(try direct.encode())
			let answered = server.respond(Request{message: seen, remote: new net.Address()})
			assert answered.rcode == RCode.NotAuth
			let refusalSig = answered.tsig
			fail "the refusal carries no TSIG" when refusalSig is none
			assert refusalSig.error == tsigBadTruncation
			assert !(answered.key is none) && answered.requestMAC.len() == 16
			try server.close()

			// A MAC shorter than the RFC floor (half the digest, 16 bytes
			// for HMAC-SHA256) is not a truncation the RFC allows at all.
			let tiny = new TSIGKey("trunc.example.test", secret)
			tiny.macSize = 8
			let tinyQuery = try newQuery("www.example.test")
			tinyQuery.key = tiny
			let tinyWire = try tinyQuery.encode()
			let tinySent = tinyQuery.tsig
			fail "encode left no TSIG" when tinySent is none
			assert tinySent.mac.len() == 8
			let refusal = ""
			tiny.verify(try decode(tinyWire)) onerror (err error) {
				refusal = failureOf(err)
				recover none
			}
			assert refusal.contains("truncation")

			// A signed multi-message zone transfer still verifies end to
			// end when the key truncates every MAC in the stream.
			let bigZone = try signedZone()
			let transferKey = try generateTSIGKey("secondary.example.test", TSIGAlgorithm.HMACSHA512)
			transferKey.macSize = 32
			bigZone.allowTransfer = ["key:secondary.example.test"]
			let transferServer = new Server("127.0.0.1:0", bigZone)
			transferServer.keys = [transferKey]
			try transferServer.start()

			let transferClient = new Client([transferServer.address().str()])
			transferClient.useHosts = false
			transferClient.timeout = 5s
			transferClient.key = transferKey
			let copy = try transferClient.transfer("example.test", transferServer.address().str())
			assert copy.len() == bigZone.len() && copy.len() == 1504
			try transferServer.close()
			return none
		}
	}
}
