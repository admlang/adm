partial module std.net.dns {
	// Update is a dynamic update of a zone (RFC 2136): what the zone must
	// look like for the update to go ahead, and the changes to make when
	// it does. The server makes all of them or none. `Client.update` sends
	// one; a `Zone` takes it from the clients its `allowUpdate` lists.
	//
	// ```
	// let update = new dns.Update("example.test")
	// update.requireAbsent("host.example.test")
	// update.add(dns.addressRecord("host.example.test", "192.0.2.7"))
	// try client.update(update, "192.0.2.53")
	// ```
	type Update {
		// The origin of the zone to change.
		zone          string
		prerequisites Record[] = []
		changes       Record[] = []

		def new(zone string) {
			self.zone = canonicalName(zone)
		}

		// add puts the record in the zone. A record the zone holds already
		// only takes the new TTL, a CNAME or SOA record replaces the one
		// there is.
		def add(record Record) {
			changes.push(record)
		}

		// remove takes every record of the type off the name, all of its
		// records for `ANY`.
		def remove(name string, kind RecordType = RecordType.ANY) {
			changes.push(standIn(name, kind, RecordClass.ANY))
		}

		// remove takes the one record with this type and data off its name,
		// whatever its TTL.
		def remove(record Record) {
			let out = record.withTTL(0)
			out.class = RecordClass.NoClass
			changes.push(out)
		}

		// require lets the update go ahead only when the name has a record
		// of the type, any record at all for `ANY`.
		def require(name string, kind RecordType = RecordType.ANY) {
			prerequisites.push(standIn(name, kind, RecordClass.ANY))
		}

		// require lets the update go ahead only when the records of this
		// name and type are exactly the ones required so, TTLs aside.
		def require(record Record) {
			prerequisites.push(record.withTTL(0))
		}

		// requireAbsent lets the update go ahead only when the name has no
		// record of the type, no record at all for `ANY`.
		def requireAbsent(name string, kind RecordType = RecordType.ANY) {
			prerequisites.push(standIn(name, kind, RecordClass.NoClass))
		}

		// message is the update as the message that goes to the server: the
		// zone in the question section, the prerequisites in the answer
		// section, the changes in the authority section.
		// Fails with BadName when the zone is not a domain name.
		def message() !Message {
			let out = try newQuery(zone, RecordType.SOA)
			out.opcode = Opcode.Update
			out.recursionDesired = false
			out.answers = prerequisites
			out.authorities = changes
			return out
		}
	}

	// standIn is the dataless record that names a record set in an update.
	internal def standIn(name string, kind RecordType, class RecordClass) Record {
		let r = newRecord(name, kind, 0)
		r.class = class
		r.dataless = true
		return r
	}
}
