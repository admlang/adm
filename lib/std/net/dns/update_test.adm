partial module std.net.dns {
	use (
		std.net
		std.testing
		std.time
	)

	check "Dynamic update" {
		def exampleZone() !Zone {
			let zone = new Zone("example.test")
			try zone.add(soaRecord("example.test", SOA{mname: "ns1.example.test", rname: "admin.example.test", serial: 5}, 300))
			try zone.add(nsRecord("example.test", "ns1.example.test"))
			try zone.add(addressRecord("ns1.example.test", "192.0.2.53"))
			try zone.add(addressRecord("www.example.test", "192.0.2.1"))
			try zone.add(addressRecord("www.example.test", "192.0.2.2"))
			try zone.add(cnameRecord("alias.example.test", "www.example.test"))
			zone.allowTransfer = ["127.0.0.1"]
			zone.allowUpdate = ["127.0.0.1"]
			return zone
		}

		// codeOf is the code the zone answers the update with, applied
		// without a server in between.
		def codeOf(zone Zone, update Update) !RCode {
			let (code, _) = zone.apply(try update.message())
			return code
		}

		// refusalOf is the code the server refuses the update with.
		def refusalOf(client Client, update Update, server string) RCode {
			let code = RCode.Success
			client.update(update, server) onerror (err error) {
				code = err.rcode when err is DNSError
				recover none
			}
			return code
		}

		@test()
		def TestUpdateOnTheWire() !none {
			let update = new Update("Example.Test.")
			update.require("www.example.test", RecordType.A)
			update.requireAbsent("host.example.test")
			update.require(addressRecord("ns1.example.test", "192.0.2.53"))
			update.add(addressRecord("host.example.test", "192.0.2.7", 60))
			update.remove("old.example.test")
			update.remove(addressRecord("www.example.test", "192.0.2.2"))
			let back = try decode(try (try update.message()).encode())
			let zone = back.question()
			fail "the update lost its zone section" when zone is none
			assert back.opcode == Opcode.Update && zone.name == "example.test" && zone.kind == RecordType.SOA
			assert back.answers.len() == 3 && back.authorities.len() == 3
			let present = back.answers[0]
			assert present.class == RecordClass.ANY && present.kind == RecordType.A && present.dataless && present.ttl == 0
			let absent = back.answers[1]
			assert absent.class == RecordClass.NoClass && absent.kind == RecordType.ANY && absent.dataless
			let exact = back.answers[2]
			assert exact.class == RecordClass.IN && !exact.dataless && exact.address == "192.0.2.53" && exact.ttl == 0
			let added = back.authorities[0]
			assert added.class == RecordClass.IN && added.address == "192.0.2.7" && added.ttl == 60
			let cleared = back.authorities[1]
			assert cleared.class == RecordClass.ANY && cleared.kind == RecordType.ANY && cleared.dataless
			let one = back.authorities[2]
			assert one.class == RecordClass.NoClass && one.address == "192.0.2.2" && !one.dataless && one.ttl == 0
			return none
		}

		@test()
		def TestPrerequisites() !none {
			let zone = try exampleZone()
			let met = new Update("example.test")
			met.require("www.example.test")
			met.require("www.example.test", RecordType.A)
			met.requireAbsent("www.example.test", RecordType.AAAA)
			met.requireAbsent("nobody.example.test")
			met.require(addressRecord("WWW.example.test", "192.0.2.2"))
			met.require(addressRecord("www.example.test", "192.0.2.1"))
			assert (try codeOf(zone, met)) == RCode.Success

			let noName = new Update("example.test")
			noName.require("nobody.example.test")
			assert (try codeOf(zone, noName)) == RCode.NameError
			let noSet = new Update("example.test")
			noSet.require("www.example.test", RecordType.MX)
			assert (try codeOf(zone, noSet)) == RCode.NXRRSet
			let taken = new Update("example.test")
			taken.requireAbsent("www.example.test")
			assert (try codeOf(zone, taken)) == RCode.YXDomain
			let held = new Update("example.test")
			held.requireAbsent("www.example.test", RecordType.A)
			assert (try codeOf(zone, held)) == RCode.YXRRSet
			// Half of a record set is not the record set.
			let half = new Update("example.test")
			half.require(addressRecord("www.example.test", "192.0.2.1"))
			assert (try codeOf(zone, half)) == RCode.NXRRSet
			let outside = new Update("example.test")
			outside.require("www.other.test")
			assert (try codeOf(zone, outside)) == RCode.NotZone

			// A prerequisite that fails keeps every change out.
			noSet.add(addressRecord("host.example.test", "192.0.2.7"))
			assert (try codeOf(zone, noSet)) == RCode.NXRRSet
			assert zone.find("host.example.test").len() == 0 && serialOf(zone) == 5
			return none
		}

		@test()
		def TestChanges() !none {
			let zone = try exampleZone()
			let update = new Update("example.test")
			update.add(addressRecord("host.example.test", "192.0.2.7", 60))
			update.add(addressRecord("host.example.test", "2001:db8::7", 60))
			update.remove(addressRecord("www.example.test", "192.0.2.2"))
			let (code, changed) = zone.apply(try update.message())
			assert code == RCode.Success && changed && serialOf(zone) == 6
			assert zone.find("host.example.test").len() == 2 && zone.find("www.example.test").len() == 1
			assert zone.find("www.example.test")[0].address == "192.0.2.1"

			// The same record again only brings a TTL; the same TTL brings nothing.
			let again = new Update("example.test")
			again.add(addressRecord("host.example.test", "192.0.2.7", 60))
			let (_, moved) = zone.apply(try again.message())
			assert !moved && serialOf(zone) == 6
			let longer = new Update("example.test")
			longer.add(addressRecord("host.example.test", "192.0.2.7", 900))
			assert (try codeOf(zone, longer)) == RCode.Success
			assert zone.find("host.example.test", RecordType.A)[0].ttl == 900 && zone.find("host.example.test").len() == 2

			// A record set, then a whole name.
			let fewer = new Update("example.test")
			fewer.remove("host.example.test", RecordType.AAAA)
			assert (try codeOf(zone, fewer)) == RCode.Success && zone.find("host.example.test").len() == 1
			let gone = new Update("example.test")
			gone.remove("host.example.test")
			assert (try codeOf(zone, gone)) == RCode.Success && zone.find("host.example.test").len() == 0

			// A CNAME record stands alone, and there is one of it.
			let mixed = new Update("example.test")
			mixed.add(addressRecord("alias.example.test", "192.0.2.9"))
			mixed.add(cnameRecord("www.example.test", "ns1.example.test"))
			let (_, mixedIn) = zone.apply(try mixed.message())
			assert !mixedIn && zone.find("alias.example.test").len() == 1 && zone.find("www.example.test", RecordType.CNAME).len() == 0
			let moved2 = new Update("example.test")
			moved2.add(cnameRecord("alias.example.test", "ns1.example.test"))
			assert (try codeOf(zone, moved2)) == RCode.Success
			assert zone.find("alias.example.test").len() == 1 && zone.find("alias.example.test")[0].target == "ns1.example.test"
			return none
		}

		@test()
		def TestTheOriginKeepsItsSOAAndNS() !none {
			let zone = try exampleZone()
			try zone.add(txtRecord("example.test", ["v=spf1 -all"]))
			let sweep = new Update("example.test")
			sweep.remove("example.test")
			sweep.remove(nsRecord("example.test", "ns1.example.test"))
			sweep.remove("example.test", RecordType.SOA)
			assert (try codeOf(zone, sweep)) == RCode.Success
			assert zone.find("example.test", RecordType.SOA).len() == 1 && zone.find("example.test", RecordType.NS).len() == 1
			assert zone.find("example.test", RecordType.TXT).len() == 0 && serialOf(zone) == 6

			// One of two NS records may go.
			let second = new Update("example.test")
			second.add(nsRecord("example.test", "ns2.example.test"))
			assert (try codeOf(zone, second)) == RCode.Success
			let first = new Update("example.test")
			first.remove(nsRecord("example.test", "NS1.example.test"))
			assert (try codeOf(zone, first)) == RCode.Success
			assert zone.find("example.test", RecordType.NS).len() == 1 && zone.find("example.test", RecordType.NS)[0].target == "ns2.example.test"

			// A SOA record replaces an older one and sets the serial itself.
			let serial = serialOf(zone)
			let older = new Update("example.test")
			older.add(soaRecord("example.test", SOA{mname: "ns2.example.test", rname: "admin.example.test", serial: 2}))
			let (_, wentBack) = zone.apply(try older.message())
			assert !wentBack && serialOf(zone) == serial
			let newer = new Update("example.test")
			newer.add(soaRecord("example.test", SOA{mname: "ns2.example.test", rname: "admin.example.test", serial: 100}))
			assert (try codeOf(zone, newer)) == RCode.Success
			assert serialOf(zone) == 100 && zone.find("example.test", RecordType.SOA).len() == 1

			// What cannot be a change.
			let question = new Update("example.test")
			question.add(newRecord("example.test", RecordType.ANY, 60))
			assert (try codeOf(zone, question)) == RCode.FormatError
			let outside = new Update("example.test")
			outside.add(addressRecord("www.other.test", "192.0.2.1"))
			assert (try codeOf(zone, outside)) == RCode.NotZone
			return none
		}

		@test()
		def TestUpdateThroughAServer() !none {
			let zone = try exampleZone()
			let primary = new Server("127.0.0.1:0", zone)
			try primary.start()
			let at = primary.address().str()
			let copy = new Secondary("example.test", at)
			copy.client.timeout = 2s
			copy.refresh = 1h
			try copy.start()
			let secondary = new Server("127.0.0.1:0", copy)
			try secondary.start()
			zone.secondaries = [secondary.address().str()]

			let client = new Client([at])
			client.useHosts = false
			client.timeout = 2s
			let update = new Update("example.test")
			update.requireAbsent("host.example.test")
			update.add(addressRecord("host.example.test", "192.0.2.7"))
			try client.update(update, at)
			assert (try client.lookupHost("host.example.test"))[0] == "192.0.2.7" && serialOf(zone) == 6
			// The secondary hears of it.
			let waited = time.now()
			for copy.serial() != 6 && time.since(waited) < 5s {
				time.sleep(20ms)
			}
			assert copy.serial() == 6
			// The prerequisite does not hold a second time.
			assert refusalOf(client, update, at) == RCode.YXDomain

			// Another zone, a copy, a client that is not listed, and UDP.
			assert refusalOf(client, new Update("other.test"), at) == RCode.NotAuth
			assert refusalOf(client, update, secondary.address().str()) == RCode.Refused
			zone.allowUpdate = ["192.0.2.0/24"]
			assert !zone.allowsUpdate(primary.address())
			assert refusalOf(client, update, at) == RCode.Refused
			zone.allowUpdate = ["*"]
			let overUDP = primary.respond(Request{message: try update.message(), remote: primary.address()})
			assert overUDP.rcode == RCode.Refused
			let mux = new Mux()
			mux.handle("example.test", zone)
			let fronted = new Server("127.0.0.1:0", mux)
			let elsewhere = new Update("other.test")
			assert fronted.respond(Request{message: try elsewhere.message(), remote: primary.address(), tcp: true}).rcode == RCode.Refused

			copy.close()
			try secondary.close()
			try primary.close()
			return none
		}
	}
}
