partial module std.net.dns {
	use (
		std.crypto.x509::(parseIPText)
		std.data.encoding::(Base32, Base64, hexdecode)
		std.os
	)

	// parseZone reads a zone in the master file format of RFC 1035 §5:
	// one record a line as `[owner] [ttl] [class] type data`, `@` for the
	// origin, names without a trailing dot completed with the origin, a
	// line that starts blank taking the owner of the one before,
	// parentheses joining lines, `;` comments, quoted strings, the `\.`
	// and `\DDD` escapes, the `$ORIGIN` and `$TTL` directives, TTLs with
	// units (`1h30m`), and `TYPE123` with `\# length hex` data for a type
	// the module does not name (RFC 3597).
	//
	// The zone's origin is `origin`, else the owner of the SOA record, else
	// the first `$ORIGIN`. A
	// record without a TTL takes the `$TTL`, else the TTL of the record
	// before it, else the SOA minimum.
	//
	// Fails with Malformed, naming the line, on a line it cannot read, on
	// `$INCLUDE` (only `readZone` knows where files are) and when nothing
	// names the origin; with BadName on a name that is
	// not one or a record outside the origin.
	def parseZone(text string, origin string = "") !Zone {
		let file = new ZoneFile()
		file.origin = canonicalName(origin) unless origin == ""
		try file.load(text)
		return try file.zone(origin)
	}

	// readZone reads a zone file as `parseZone` does, with `$INCLUDE`
	// paths taken relative to the file's folder.
	// Fails as `parseZone` does, and when a file cannot be read.
	def readZone(path string, origin string = "") !Zone {
		let text = string(try os.readFile(path))
		let file = new ZoneFile()
		file.origin = canonicalName(origin) unless origin == ""
		file.file = path
		file.includes = true
		try file.load(text)
		return try file.zone(origin)
	}

	// ZoneToken is one field of a zone file line.
	internal struct ZoneToken {
		// The field with its escapes as written; a quoted one with them
		// resolved.
		text   string
		quoted bool   = false
	}

	// ZoneEntry is one record or directive: a line, or the lines a pair of
	// parentheses joins.
	internal struct ZoneEntry {
		tokens ZoneToken[] = []
		line   int         = 0
		// The line starts with blank space: the owner is the last one.
		blank  bool        = false
	}

	// ZoneFile is the state of reading a zone file front to back.
	internal type ZoneFile {
		// The name that completes relative names, "" before any is known.
		origin      string   = ""
		// What the first `$ORIGIN` said.
		firstOrigin string   = ""
		owner       string   = ""
		// The `$TTL`, the last TTL a record gave, and the SOA minimum; -1
		// when there is none yet.
		defaultTTL  int      = -1
		lastTTL     int      = -1
		fallbackTTL int      = -1
		records     Record[] = []
		// The file being read, "" for text.
		file        string   = ""
		includes    bool     = false
		depth       int      = 0

		def load(text string) !none {
			for let (_, entry) in try zoneEntries(text, self) {
				let first = entry.tokens[0]
				if !first.quoted && first.text.startsWith("$") {
					try directive(entry)
					continue
				}
				try record(entry)
			}
			return none
		}

		// zone is what was read as a Zone under the origin asked for, the
		// SOA owner or the first `$ORIGIN` when none was.
		def zone(origin string) !Zone {
			let top = origin
			if top == "" {
				for let (_, r) in records {
					continue unless r.kind == RecordType.SOA
					top = r.name
					break
				}
			}
			top = firstOrigin when top == ""
			fail errorOf(ErrorKind.Malformed, "zone file has no SOA record and no $ORIGIN, and no origin was given") when top == ""
			let out = new Zone(top)
			for let (_, r) in records {
				r.ttl = fallbackTTL < 0 ?? (3600, fallbackTTL) when r.ttl < 0
				try out.add(r)
			}
			return out
		}

		// bad is a Malformed failure that names the place.
		def bad(line int, what string) DNSError {
			return errorOf(ErrorKind.Malformed, "zone file line {line}: {what}") when file == ""
			return errorOf(ErrorKind.Malformed, "{file}:{line}: {what}")
		}

		def directive(entry ZoneEntry) !none {
			let tokens = entry.tokens
			let name = tokens[0].text.upper()
			match name {
				case "$ORIGIN":
					fail bad(entry.line, "$ORIGIN takes one name") when tokens.len() != 2
					origin = canonicalName(try absolute(tokens[1].text, entry.line))
					firstOrigin = origin when firstOrigin == "" && depth == 0
				case "$TTL":
					fail bad(entry.line, "$TTL takes one value") when tokens.len() != 2
					let seconds = ttlOf(tokens[1].text)
					fail bad(entry.line, "\"{tokens[1].text}\" is not a TTL") when seconds is none
					defaultTTL = seconds
				case "$INCLUDE":
					fail bad(entry.line, "$INCLUDE needs a zone read from a file") unless includes
					fail bad(entry.line, "$INCLUDE takes a file and an optional origin") when tokens.len() < 2 || tokens.len() > 3
					fail bad(entry.line, "$INCLUDE is nested too deep") when depth >= 8
					let path = tokens[1].text
					path = os.join(os.dir(file), path) unless os.isAbs(path)
					let text = string(try os.readFile(path))
					let (outerOrigin, outerOwner, outerFile) = (origin, owner, file)
					origin = canonicalName(try absolute(tokens[2].text, entry.line)) when tokens.len() == 3
					file = path
					depth++
					try load(text)
					depth--
					origin = outerOrigin
					owner = outerOwner
					file = outerFile
				default:
					fail bad(entry.line, "unknown directive {tokens[0].text}")
			}
			return none
		}

		def record(entry ZoneEntry) !none {
			let tokens = entry.tokens
			let line = entry.line
			let at = 0
			if !entry.blank {
				owner = try absolute(tokens[0].text, line)
				at = 1
			}
			fail bad(line, "the record has no owner name") when owner == ""
			let ttl = -1
			let class = RecordClass.IN
			let classSeen = false
			for let pass = 0; pass < 2 && at < tokens.len(); pass++ {
				break when tokens[at].quoted
				let word = tokens[at].text
				let seconds = ttlOf(word)
				if !(seconds is none) {
					break when ttl >= 0
					ttl = seconds
					at++
					continue
				}
				let code = classCodeOf(word)
				break when code < 0 || classSeen
				class = recordClassOf(code)
				classSeen = true
				at++
			}
			fail bad(line, "the record has no type") when at >= tokens.len()
			let code = typeCodeOf(tokens[at].text)
			fail bad(line, "unknown record type {tokens[at].text}") when code < 0 || tokens[at].quoted
			let r = newRecord(owner, recordTypeOf(code), ttl)
			fail bad(line, "{r.kind.name} is not zone data") when r.kind := RecordType.OPT || RecordType.IXFR || RecordType.AXFR || RecordType.ANY
			// The owner keeps the case it was written in.
			r.name = owner
			r.code = code
			r.class = class
			try data(r, tokens[at + 1:], line)
			if ttl >= 0 {
				lastTTL = ttl
			} else {
				r.ttl = defaultTTL >= 0 ?? (defaultTTL, lastTTL)
			}
			let soa = r.soa
			if !(soa is none) {
				fallbackTTL = soa.minimum when fallbackTTL < 0
				r.ttl = soa.minimum when r.ttl < 0
			}
			records.push(r)
			return none
		}

		// data reads the fields behind the type into the record.
		def data(r Record, rest ZoneToken[], line int) !none {
			if rest.len() >= 2 && !rest[0].quoted && rest[0].text == "\\#" {
				try generic(r, rest, line)
				return none
			}
			match r.kind {
				case RecordType.A, RecordType.AAAA:
					try count(rest, 1, r, line)
					let ip = parseIPText(rest[0].text)
					let want = r.kind == RecordType.A ?? (4, 16)
					fail bad(line, "\"{rest[0].text}\" is not an address for {r.kind.name}") when ip is none
					fail bad(line, "\"{rest[0].text}\" is not an address for {r.kind.name}") when ip.len() != want
					r.address = rest[0].text.lower()
				case RecordType.NS, RecordType.CNAME, RecordType.PTR, RecordType.DNAME:
					try count(rest, 1, r, line)
					r.target = try absolute(rest[0].text, line)
				case RecordType.MX:
					try count(rest, 2, r, line)
					r.priority = try number(rest[0], 0xffff, line)
					r.target = try absolute(rest[1].text, line)
				case RecordType.SRV:
					try count(rest, 4, r, line)
					r.priority = try number(rest[0], 0xffff, line)
					r.weight = try number(rest[1], 0xffff, line)
					r.port = try number(rest[2], 0xffff, line)
					r.target = try absolute(rest[3].text, line)
				case RecordType.TXT:
					fail bad(line, "TXT needs at least one string") when rest.len() == 0
					for let (_, token) in rest {
						r.text.push(try plain(token, line))
					}
				case RecordType.SOA:
					try count(rest, 7, r, line)
					let mname = try absolute(rest[0].text, line)
					let rname = try absolute(rest[1].text, line)
					let serial = try number(rest[2], 0xffffffff, line)
					let refresh = try seconds(rest[3], line)
					let retry = try seconds(rest[4], line)
					let expire = try seconds(rest[5], line)
					let minimum = try seconds(rest[6], line)
					r.soa = SOA{mname: mname, rname: rname, serial: serial, refresh: refresh, retry: retry, expire: expire, minimum: minimum}
				case RecordType.CAA:
					try count(rest, 3, r, line)
					r.flags = try number(rest[0], 255, line)
					r.tag = rest[1].text
					r.value = try plain(rest[2], line)
				case RecordType.TLSA:
					fail bad(line, "TLSA takes 4 fields or more, not {rest.len()}") when rest.len() < 4
					let usage = try number(rest[0], 255, line)
					let selector = try number(rest[1], 255, line)
					let matching = try number(rest[2], 255, line)
					let digits = ""
					for let i = 3; i < rest.len(); i++ {
						digits += rest[i].text
					}
					let failed = false
					let raw = hexdecode(digits) onerror (err error) {
						failed = true
						recover []
					}
					fail bad(line, "TLSA data is not hexadecimal") when failed
					r.tlsa = TLSA{usage: usage, selector: selector, matching: matching, data: raw}
				case RecordType.NAPTR:
					try count(rest, 6, r, line)
					let order = try number(rest[0], 0xffff, line)
					let preference = try number(rest[1], 0xffff, line)
					let flags = try plain(rest[2], line)
					let services = try plain(rest[3], line)
					let regexp = try plain(rest[4], line)
					r.naptr = NAPTR{order: order, preference: preference, flags: flags, services: services, regexp: regexp, replacement: try absolute(rest[5].text, line)}
				case RecordType.SVCB, RecordType.HTTPS:
					fail bad(line, "{r.kind.name} takes a priority and a target") when rest.len() < 2
					let s = new SVCB()
					s.priority = try number(rest[0], 0xffff, line)
					s.target = try absolute(rest[1].text, line)
					for let i = 2; i < rest.len(); i++ {
						let text = rest[i].text
						// `alpn="h2,h3"` arrives as `alpn=` and a quoted field.
						if text.endsWith("=") && i + 1 < rest.len() && rest[i + 1].quoted {
							text += rest[i + 1].text
							i++
						}
						let failure ?error = none
						let param ?SVCParam = none
						param = trySVCParam(text) onerror (err error) {
							failure = err
							recover none
						}
						fail bad(line, failure.message) unless failure is none
						fail bad(line, "bad service parameter {text}") when param is none
						fail bad(line, "service parameter {text} is given twice") unless s.param(param.key) is none
						s.set(param.key, param.value)
					}
					r.svcb = s
				case RecordType.DNSKEY, RecordType.CDNSKEY:
					fail bad(line, "{r.kind.name} takes 4 fields or more, not {rest.len()}") when rest.len() < 4
					let k = new DNSKEY()
					k.flags = try number(rest[0], 0xffff, line)
					k.protocol = try number(rest[1], 255, line)
					k.algorithm = try number(rest[2], 255, line)
					k.key = try base64(rest[3:], line)
					r.dnskey = k
				case RecordType.DS, RecordType.CDS:
					fail bad(line, "{r.kind.name} takes 4 fields or more, not {rest.len()}") when rest.len() < 4
					let keyTag = try number(rest[0], 0xffff, line)
					let algorithm = try number(rest[1], 255, line)
					let digestType = try number(rest[2], 255, line)
					r.ds = DS{keyTag: keyTag, algorithm: algorithm, digestType: digestType, digest: try hex(rest[3:], line)}
				case RecordType.RRSIG:
					fail bad(line, "RRSIG takes 9 fields or more, not {rest.len()}") when rest.len() < 9
					let coveredCode = typeCodeOf(rest[0].text)
					fail bad(line, "unknown record type {rest[0].text}") when coveredCode < 0
					let algorithm = try number(rest[1], 255, line)
					let labels = try number(rest[2], 255, line)
					let originalTTL = try seconds(rest[3], line)
					let expiration = signatureTimeOf(rest[4].text)
					let inception = signatureTimeOf(rest[5].text)
					fail bad(line, "\"{rest[4].text}\" is not a signature time") when expiration is none
					fail bad(line, "\"{rest[5].text}\" is not a signature time") when inception is none
					let keyTag = try number(rest[6], 0xffff, line)
					let signer = try absolute(rest[7].text, line)
					r.rrsig = RRSIG{covered: recordTypeOf(coveredCode), coveredCode: coveredCode, algorithm: algorithm, labels: labels, originalTTL: originalTTL, expiration: expiration, inception: inception, keyTag: keyTag, signer: signer, signature: try base64(rest[8:], line)}
				case RecordType.NSEC:
					fail bad(line, "NSEC takes the next name") when rest.len() < 1
					let n = new NSEC()
					n.next = try absolute(rest[0].text, line)
					n.types = try types(rest[1:], line)
					r.nsec = n
				case RecordType.NSEC3, RecordType.NSEC3PARAM:
					let fields = r.kind == RecordType.NSEC3 ?? (5, 4)
					fail bad(line, "{r.kind.name} takes {fields} fields or more, not {rest.len()}") when rest.len() < fields
					let n = new NSEC3()
					n.hashAlgorithm = try number(rest[0], 255, line)
					n.flags = try number(rest[1], 255, line)
					n.iterations = try number(rest[2], 0xffff, line)
					n.salt = try hex(rest[3:4], line) unless rest[3].text == "-"
					if r.kind == RecordType.NSEC3 {
						let failed = false
						n.next = Base32{padded: false, hex: true}.decode(rest[4].text) onerror (err error) {
							failed = true
							recover []
						}
						fail bad(line, "NSEC3 next hash is not base32hex") when failed || n.next.len() == 0
						n.types = try types(rest[5:], line)
					} else {
						try count(rest, 4, r, line)
					}
					r.nsec3 = n
				default:
					fail bad(line, "{typeName(r)} data must be written as \\# length hex")
			}
			return none
		}

		// generic reads the `\# length hex` form, through the wire reader
		// for a type the module knows.
		def generic(r Record, rest ZoneToken[], line int) !none {
			let size = try number(rest[1], 0xffff, line)
			let digits = ""
			for let i = 2; i < rest.len(); i++ {
				digits += rest[i].text
			}
			let failed = false
			let raw = hexdecode(digits) onerror (err error) {
				failed = true
				recover []
			}
			fail bad(line, "\\# data is not hexadecimal") when failed
			fail bad(line, "\\# says {size} bytes and gives {raw.len()}") when raw.len() != size
			let p = new Parser(raw)
			try readData(p, r, size)
			fail bad(line, "\\# data is too long for {r.kind.name}") when p.pos != size
			return none
		}

		// absolute is the name with the origin behind it unless it ends in
		// a dot, without that dot.
		def absolute(text string, line int) !string {
			if text == "@" {
				fail bad(line, "@ needs an origin") when origin == ""
				return origin
			}
			let name = text
			if name.endsWith(".") && !name.endsWith("\\.") {
				name = name[:name.len() - 1] unless name == "."
			} else {
				fail bad(line, "{text} is relative, and there is no origin") when origin == ""
				name = name + "." + origin unless origin == "."
			}
			try splitLabels(name)
			return name
		}

		// hex reads the fields as one run of hexadecimal digits.
		def hex(fields ZoneToken[], line int) !byte[] {
			let digits = ""
			for let (_, token) in fields {
				digits += token.text
			}
			let failed = false
			let raw = hexdecode(digits) onerror (err error) {
				failed = true
				recover []
			}
			fail bad(line, "\"{digits}\" is not hexadecimal") when failed
			return raw
		}

		// base64 reads the fields as one run of Base64.
		def base64(fields ZoneToken[], line int) !byte[] {
			let text = ""
			for let (_, token) in fields {
				text += token.text
			}
			let failed = false
			let raw = Base64{}.decode(text) onerror (err error) {
				failed = true
				recover []
			}
			fail bad(line, "the key or signature is not Base64") when failed
			return raw
		}

		// types reads the type list of NSEC and NSEC3.
		def types(fields ZoneToken[], line int) !int[] {
			let out int[]
			for let (_, token) in fields {
				let code = typeCodeOf(token.text)
				fail bad(line, "unknown record type {token.text}") when code < 0
				out.push(code)
			}
			return out.sort((x int, y int) => x < y)
		}

		def count(rest ZoneToken[], want int, r Record, line int) !none {
			fail bad(line, "{typeName(r)} takes {want} fields, not {rest.len()}") when rest.len() != want
			return none
		}

		def number(token ZoneToken, most int, line int) !int {
			let text = token.text
			fail bad(line, "\"{text}\" is not a number") when token.quoted || text == "" || text.len() > 10 || !text.isNumeric()
			let n = text.toInt<int>()
			fail bad(line, "{text} is over {most}") when n > most
			return n
		}

		def seconds(token ZoneToken, line int) !int {
			let n = ttlOf(token.text)
			fail bad(line, "\"{token.text}\" is not a time") when n is none || token.quoted
			return n
		}

		// plain is a string field: a quoted one as it is, a bare one with
		// its escapes resolved.
		def plain(token ZoneToken, line int) !string {
			return token.text when token.quoted
			let raw = token.text.bytes()
			let out byte[]
			for let i = 0; i < raw.len(); i++ {
				let c = int(raw[i])
				if c != 0x5c {
					out.push(byte(c))
					continue
				}
				let (value, used) = escapeAt(raw, i)
				fail bad(line, "broken escape in {token.text}") when used == 0
				out.push(byte(value))
				i += used
			}
			return string(out)
		}

		// `svcParamOf` as an optional, so a failure can recover to none.
		def trySVCParam(text string) !?SVCParam {
			return try svcParamOf(text)
		}

		// typeName is the record's type as a zone file writes it.
		def typeName(r Record) string {
			return r.kind == RecordType.Unknown ?? ("TYPE{r.code}", r.kind.name)
		}
	}

	// escapeAt reads the escape whose backslash is at `at`: the byte it
	// stands for and how many bytes follow the backslash, 0 when it is
	// broken.
	internal def escapeAt(raw byte[], at int) (int, int) {
		return (0, 0) when at + 1 >= raw.len()
		let next = int(raw[at + 1])
		return (next, 1) when next < 0x30 || next > 0x39
		return (0, 0) when at + 3 >= raw.len()
		let value = 0
		for let j = 1; j <= 3; j++ {
			let d = int(raw[at + j])
			return (0, 0) when d < 0x30 || d > 0x39
			value = value * 10 + d - 0x30
		}
		return (0, 0) when value > 255
		return (value, 3)
	}

	// zoneEntries splits zone file text into its entries.
	internal def zoneEntries(text string, file ZoneFile) !ZoneEntry[] {
		let raw = text.bytes()
		let entries ZoneEntry[]
		let entry = ZoneEntry{}
		let depth = 0
		let line = 1
		let atStart = true
		let i = 0
		for i < raw.len() {
			let c = int(raw[i])
			if c == 0x0a {
				line++
				i++
				continue when depth > 0
				entries.push(entry) when entry.tokens.len() > 0
				entry = ZoneEntry{}
				atStart = true
				continue
			}
			if c := 0x20 || 0x09 || 0x0d {
				entry.blank = true when atStart
				atStart = false
				i++
				continue
			}
			atStart = false
			if c == 0x3b {
				for i < raw.len() && int(raw[i]) != 0x0a {
					i++
				}
				continue
			}
			if c == 0x28 {
				depth++
				i++
				continue
			}
			if c == 0x29 {
				fail file.bad(line, "\")\" without \"(\"") when depth == 0
				depth--
				i++
				continue
			}
			entry.line = line when entry.tokens.len() == 0
			let field byte[]
			if c == 0x22 {
				i++
				let closed = false
				for i < raw.len() {
					let q = int(raw[i])
					if q == 0x22 {
						closed = true
						i++
						break
					}
					if q == 0x5c {
						let (value, used) = escapeAt(raw, i)
						fail file.bad(line, "broken escape in a string") when used == 0
						field.push(byte(value))
						i += used + 1
						continue
					}
					line++ when q == 0x0a
					field.push(byte(q))
					i++
				}
				fail file.bad(line, "a string is not closed") unless closed
				entry.tokens.push(ZoneToken{text: string(field), quoted: true})
				continue
			}
			for i < raw.len() {
				let q = int(raw[i])
				break when q := 0x20 || 0x09 || 0x0d || 0x0a || 0x3b || 0x28 || 0x29 || 0x22
				field.push(byte(q))
				i++
				if q == 0x5c && i < raw.len() {
					field.push(raw[i])
					i++
				}
			}
			entry.tokens.push(ZoneToken{text: string(field)})
		}
		fail file.bad(line, "\"(\" is not closed") when depth > 0
		entries.push(entry) when entry.tokens.len() > 0
		return entries
	}

	// ttlOf reads a TTL: seconds, or numbers with the units `s`, `m`, `h`,
	// `d` and `w` (`1h30m`). none when the text is not one.
	internal def ttlOf(text string) ?int {
		let raw = text.lower().bytes()
		return none when raw.len() == 0 || raw.len() > 24
		let total = 0
		let n = 0
		let digits = false
		for let i = 0; i < raw.len(); i++ {
			let c = int(raw[i])
			if c >= 0x30 && c <= 0x39 {
				n = n * 10 + c - 0x30
				digits = true
				return none when n > 0x7fffffff
				continue
			}
			return none unless digits
			let unit = 0
			match c {
				case 0x73:
					unit = 1
				case 0x6d:
					unit = 60
				case 0x68:
					unit = 3600
				case 0x64:
					unit = 86400
				case 0x77:
					unit = 604800
				default:
					return none
			}
			total += n * unit
			n = 0
			digits = false
		}
		total += n
		return none when total > 0x7fffffff
		return total
	}

	// classCodeOf is the wire value of a class as a zone file names it
	// (`IN`, `CLASS1`), -1 when the text is not one.
	internal def classCodeOf(text string) int {
		let name = text.upper()
		match name {
			case "IN":
				return 1
			case "CH":
				return 3
			case "HS":
				return 4
		}
		return numbered(name, "CLASS")
	}

	// typeCodeOf is the wire value of a type as a zone file names it (`MX`,
	// `TYPE15`), -1 when the text is not one.
	internal def typeCodeOf(text string) int {
		let name = text.upper()
		match name {
			case "A":
				return 1
			case "NS":
				return 2
			case "CNAME":
				return 5
			case "SOA":
				return 6
			case "PTR":
				return 12
			case "MX":
				return 15
			case "TXT":
				return 16
			case "AAAA":
				return 28
			case "SRV":
				return 33
			case "NAPTR":
				return 35
			case "DNAME":
				return 39
			case "TLSA":
				return 52
			case "SVCB":
				return 64
			case "HTTPS":
				return 65
			case "OPT":
				return 41
			case "DS":
				return 43
			case "RRSIG":
				return 46
			case "NSEC":
				return 47
			case "DNSKEY":
				return 48
			case "NSEC3":
				return 50
			case "NSEC3PARAM":
				return 51
			case "CDS":
				return 59
			case "CDNSKEY":
				return 60
			case "IXFR":
				return 251
			case "AXFR":
				return 252
			case "ANY":
				return 255
			case "CAA":
				return 257
		}
		return numbered(name, "TYPE")
	}

	// numbered is the number behind the prefix (`TYPE65`), -1 when the text
	// has another shape or the number is over 65535.
	internal def numbered(name string, prefix string) int {
		return -1 unless name.startsWith(prefix)
		let digits = name[prefix.len():]
		return -1 when digits == "" || digits.len() > 5 || !digits.isNumeric()
		let n = digits.toInt<int>()
		return n > 0xffff ?? (-1, n)
	}
}
