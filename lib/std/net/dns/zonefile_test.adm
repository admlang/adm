partial module std.net.dns {
	use (
		std.os
		std.testing
		std.time
	)

	check "ZoneFile" {
		// exampleText is a zone file that uses every form the reader knows.
		def exampleText() string {
			let lines string[] = [
				"; the example zone",
				"$ORIGIN example.test.",
				"$TTL 1h",
				"@  IN SOA ns1 admin.example.test. ( 2026091901 ; serial",
				"        2h 15m 2w 300 )",
				"   IN NS ns1",
				"   MX 10 mail",
				"ns1 A 192.0.2.53",
				"    AAAA 2001:DB8::53",
				"mail 300 IN A 192.0.2.25",
				"www IN 5m CNAME host.example.test.",
				"host A 192.0.2.1",
				"txt TXT \"v=spf1 -all\" second \"semi;colon \\\"q\\\"\"",
				"_sip._tcp SRV 1 2 5060 sip.other.test.",
				"@ CAA 0 issue \"ca.example.net\"",
				"odd TYPE99 \\# 4 0a0b 0c0d",
				"raw A \\# 4 c0000207",
				"*.wild 30 A 192.0.2.99",
				"a\\.b A 192.0.2.4",
				"$ORIGIN sub.example.test.",
				"deep A 192.0.2.3",
			]
			return lines.join("\n") + "\n"
		}

		// failureOf is the kind and message parsing the text fails with,
		// two empty strings when it does not fail.
		def failureOf(text string, origin string) (string, string) {
			let kind = ""
			let message = ""
			parseZone(text, origin) onerror (err error) {
				kind = err.kind.value when err is DNSError
				message = err.message
				recover new Zone("failed.test")
			}
			return (kind, message)
		}

		// refuses reports whether parsing the text fails with the kind and a
		// message that holds the fragment.
		def refuses(text string, origin string, kind string, fragment string) bool {
			let (got, message) = failureOf(text, origin)
			return got == kind && message.contains(fragment)
		}

		@test()
		def TestParseZone() !none {
			let zone = try parseZone(exampleText())
			assert zone.origin == "example.test" && zone.len() == 16

			let top = zone.find("example.test", RecordType.SOA)
			assert top.len() == 1 && top[0].ttl == 3600
			let soa = top[0].soa
			fail "the SOA record has no data" when soa is none
			assert soa.mname == "ns1.example.test" && soa.rname == "admin.example.test" && soa.serial == 2026091901
			assert soa.refresh == 7200 && soa.retry == 900 && soa.expire == 1209600 && soa.minimum == 300

			// A line that starts blank keeps the owner.
			assert zone.find("example.test", RecordType.NS)[0].target == "ns1.example.test"
			let mail = zone.find("example.test", RecordType.MX)
			assert mail.len() == 1 && mail[0].priority == 10 && mail[0].target == "mail.example.test" && mail[0].ttl == 3600
			assert zone.find("ns1.example.test", RecordType.AAAA)[0].address == "2001:db8::53"

			// The TTL and the class come in either order.
			assert zone.find("mail.example.test")[0].ttl == 300
			let alias = zone.find("www.example.test")
			assert alias.len() == 1 && alias[0].ttl == 300 && alias[0].target == "host.example.test"
			assert zone.find("host.example.test")[0].ttl == 3600 && zone.find("*.wild.example.test")[0].ttl == 30

			let text = zone.find("txt.example.test")[0].text
			assert text.len() == 3 && text[0] == "v=spf1 -all" && text[1] == "second" && text[2] == "semi;colon \"q\""
			let sip = zone.find("_sip._tcp.example.test")[0]
			assert sip.priority == 1 && sip.weight == 2 && sip.port == 5060 && sip.target == "sip.other.test"
			let caa = zone.find("example.test", RecordType.CAA)[0]
			assert caa.flags == 0 && caa.tag == "issue" && caa.value == "ca.example.net"

			// RFC 3597 forms: a type without a name, and a known one as bytes.
			let odd = zone.find("odd.example.test")[0]
			assert odd.kind == RecordType.Unknown && odd.code == 99 && odd.data.hex() == "0A0B0C0D"
			assert zone.find("raw.example.test")[0].address == "192.0.2.7"

			assert zone.find("a\\.b.example.test").len() == 1
			assert zone.find("deep.sub.example.test")[0].address == "192.0.2.3"
			return none
		}

		@test()
		def TestZoneRoundTrip() !none {
			let zone = try parseZone(exampleText())
			let written = zone.str()
			assert written.startsWith("$ORIGIN example.test.\nexample.test. 3600 IN SOA ns1.example.test. admin.example.test. 2026091901 7200 900 1209600 300\n")
			assert written.contains("odd.example.test. 3600 IN TYPE99 \\# 4 0A0B0C0D\n")
			assert written.contains("\"semi;colon \\\"q\\\"\"")
			let again = try parseZone(written)
			assert again.origin == zone.origin && again.len() == zone.len() && again.str() == written

			// Bytes outside printable ASCII travel as \DDD.
			let odd = new Zone("example.test")
			try odd.add(txtRecord("example.test", ["tab\there"]))
			assert odd.str().contains("\"tab\\009here\"")
			assert (try parseZone(odd.str())).find("example.test")[0].text[0] == "tab\there"
			return none
		}

		@test()
		def TestTTLs() !none {
			let week = ttlOf("1w")
			let mixed = ttlOf("1h30m")
			let plain = ttlOf("90")
			let upper = ttlOf("2D")
			fail "a TTL was not read" when week is none
			fail "a TTL was not read" when mixed is none
			fail "a TTL was not read" when plain is none
			fail "a TTL was not read" when upper is none
			assert week == 604800 && mixed == 5400 && plain == 90 && upper == 172800
			assert ttlOf("h") is none && ttlOf("1x") is none && ttlOf("") is none && ttlOf("99999999999") is none

			// Without `$TTL` a record takes the TTL before it, the SOA minimum
			// when there is none.
			let zone = try parseZone("@ SOA ns1 admin 1 1h 1h 1h 120\nwww A 192.0.2.1\nftp 60 A 192.0.2.2\nold A 192.0.2.3\n", "example.test")
			assert zone.find("example.test")[0].ttl == 120 && zone.find("www.example.test")[0].ttl == 120
			assert zone.find("ftp.example.test")[0].ttl == 60 && zone.find("old.example.test")[0].ttl == 60
			return none
		}

		@test()
		def TestZoneFileErrors() {
			assert refuses("a A 192.0.2.1\nb A nonsense\n", "example.test", "malformed", "line 2")
			assert refuses("a A 192.0.2.1 192.0.2.2\n", "example.test", "malformed", "takes 1 fields")
			assert refuses("a MX ten mail\n", "example.test", "malformed", "not a number")
			assert refuses("a SOA ns1 admin ( 1 2 3 4 5\n", "example.test", "malformed", "not closed")
			assert refuses("a TXT \"open\n", "example.test", "malformed", "not closed")
			assert refuses("a A 192.0.2.1 )\n", "example.test", "malformed", "")
			assert refuses("www A 192.0.2.1\n", "", "malformed", "relative")
			assert refuses("www.example.test. A 192.0.2.1\n", "", "malformed", "no SOA")
			assert refuses("$INCLUDE other.zone\n", "example.test", "malformed", "$INCLUDE")
			assert refuses("$GENERATE 1-4 host$ A 192.0.2.$\n", "example.test", "malformed", "unknown directive")
			assert refuses("a BOGUS 1\n", "example.test", "malformed", "unknown record type")
			assert refuses("a TYPE99 1 2 3\n", "example.test", "malformed", "length hex")
			assert refuses("a TYPE99 \\# 3 0a0b\n", "example.test", "malformed", "3 bytes")
			assert refuses("a ANY 1\n", "example.test", "malformed", "not zone data")
			assert refuses("   A 192.0.2.1\n", "example.test", "malformed", "no owner")
			assert refuses("other.test. A 192.0.2.1\n", "example.test", "bad-name", "")
			assert refuses("a..b A 192.0.2.1\n", "example.test", "bad-name", "")
		}

		@test()
		def TestReadZoneWithIncludes() !none {
			let dir = "/tmp/adm-dns-zone-" + time.now().unixNs().str()
			try os.mkdir(dir)
			try os.writeFile(dir + "/example.zone", "$TTL 600\n@ SOA ns1 admin 3 1h 1h 1h 60\nns1 A 192.0.2.53\n$INCLUDE hosts.inc\n$INCLUDE lab.inc lab\n    AAAA 2001:db8::53\nlast A 192.0.2.9\n".bytes())
			try os.writeFile(dir + "/hosts.inc", "www A 192.0.2.1\n$ORIGIN inner.example.test.\nx A 192.0.2.2\n".bytes())
			try os.writeFile(dir + "/lab.inc", "@ A 192.0.2.7\nbench A 192.0.2.8\n".bytes())

			let zone = try readZone(dir + "/example.zone", "example.test")
			assert zone.len() == 8
			assert zone.find("www.example.test").len() == 1 && zone.find("x.inner.example.test").len() == 1
			assert zone.find("lab.example.test")[0].address == "192.0.2.7" && zone.find("bench.lab.example.test").len() == 1
			// The origin and the owner of the including file come back.
			assert zone.find("ns1.example.test", RecordType.AAAA).len() == 1 && zone.find("last.example.test").len() == 1

			try os.writeFile(dir + "/broken.zone", "@ SOA ns1 admin 3 1h 1h 1h 60\n$INCLUDE bad.inc\n".bytes())
			try os.writeFile(dir + "/bad.inc", "ok A 192.0.2.1\nnope A 300.0.2.1\n".bytes())
			let message = ""
			readZone(dir + "/broken.zone", "example.test") onerror (err error) {
				message = err.message
				recover new Zone("failed.test")
			}
			assert message.contains("bad.inc:2")
			let missing = false
			readZone(dir + "/absent.zone") onerror (err error) {
				missing = true
				recover new Zone("failed.test")
			}
			assert missing

			for let (_, name) in ["example.zone", "hosts.inc", "lab.inc", "broken.zone", "bad.inc"] {
				try os.remove(dir + "/" + name)
			}
			try os.rmdir(dir)
			return none
		}
	}
}
