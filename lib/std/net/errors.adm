partial module std.net {
	use std.errors

	// ErrorCode names why a network operation failed. The value is the errno
	// name the runtime reports, so it also matches `error.code` on any error
	// that came out of the `Network` service.
	enum ErrorCode {
		// The local address is already bound.
		AddrInUse = "EADDRINUSE",
		// The address cannot be assigned on this host.
		AddrNotAvail = "EADDRNOTAVAIL",
		// The peer refused the connection.
		ConnRefused = "ECONNREFUSED",
		// The peer reset the connection.
		ConnReset = "ECONNRESET",
		// No route reaches the host.
		HostUnreach = "EHOSTUNREACH",
		// No route reaches the network.
		NetUnreach = "ENETUNREACH",
		// The operation did not finish within its timeout.
		TimedOut = "ETIMEDOUT",
		// The peer closed the connection before the write.
		Pipe = "EPIPE",
		// The socket or connection was already closed on this side.
		Closed = "ECLOSED",
		// The address text does not parse.
		BadAddress = "EBADADDR",
		// The name did not resolve.
		Resolve = "ERESOLVE",
		// Any other operating system failure; the message says which.
		Other = "ENET",
	}

	// NetError is the payload every std.net failure carries. `code` repeats
	// `kind.value`, so a handler that only reads `error` still sees the errno
	// name; a handler that narrows with `err is NetError` reads `kind`, the
	// operation and the address.
	struct NetError {
		message string
		code    string
		cause   ?error
		stack   errors.StackTrace
		kind    ErrorCode
		// The operation that failed: "dial", "read", "accept", ...
		op      string
		// The address involved, "" when the operation has none.
		addr    string
	}

	// errorCodeOf maps an errno name to its ErrorCode; unknown names are Other.
	internal def errorCodeOf(code string) ErrorCode {
		let values = ErrorCode.values()
		for let i = 0; i < values.len(); i++ {
			return codeAt(i) when values[i] == code
		}
		return ErrorCode.Other
	}

	// codeAt is the ErrorCode with the given declaration index.
	internal def codeAt(idx int) ErrorCode {
		return ErrorCode.AddrInUse when idx == 0
		return ErrorCode.AddrNotAvail when idx == 1
		return ErrorCode.ConnRefused when idx == 2
		return ErrorCode.ConnReset when idx == 3
		return ErrorCode.HostUnreach when idx == 4
		return ErrorCode.NetUnreach when idx == 5
		return ErrorCode.TimedOut when idx == 6
		return ErrorCode.Pipe when idx == 7
		return ErrorCode.Closed when idx == 8
		return ErrorCode.BadAddress when idx == 9
		return ErrorCode.Resolve when idx == 10
		return ErrorCode.Other
	}

	// netError wraps a failure from the Network service: the kind comes from
	// the errno name in `err.code`, the message names the operation and the
	// address (`dial 10.0.0.1:443: connect: Connection refused`).
	internal def netError(op string, addr string, err error) NetError {
		let kind = errorCodeOf(err.code)
		let message = "{op}: {err.message}"
		message = "{op} {addr}: {err.message}" when addr != ""
		return NetError{message: message, code: kind.value, cause: err, kind: kind, op: op, addr: addr}
	}

	// errorOf builds a NetError with no operating system cause behind it, for a
	// failure the library detects itself (`errorOf(ErrorCode.Closed, "read",
	// "", "connection is closed")`).
	def errorOf(kind ErrorCode, op string, addr string, message string) NetError {
		let text = "{op}: {message}"
		text = "{op} {addr}: {message}" when addr != ""
		return NetError{message: text, code: kind.value, kind: kind, op: op, addr: addr}
	}
}
