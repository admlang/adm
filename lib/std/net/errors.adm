partial module std.net {
	// Common `error.code` values produced by runtime-backed socket operations.
	//
	// Note: these are currently POSIX errno-derived strings (Linux/macOS).
	const EAddrInUse = "EADDRINUSE"
	// EAddrNotAvail is the error text when the address cannot be assigned on
	// this host.
	const EAddrNotAvail = "EADDRNOTAVAIL"
	// EConnRefused is the error text when the peer refuses the connection.
	const EConnRefused = "ECONNREFUSED"
	// EConnReset is the error text when the peer resets the connection.
	const EConnReset = "ECONNRESET"
	// EHostUnreach is the error text when no route reaches the host.
	const EHostUnreach = "EHOSTUNREACH"
	// ENetUnreach is the error text when no route reaches the network.
	const ENetUnreach = "ENETUNREACH"
	// ETimedOut is the error text when the operation times out.
	const ETimedOut = "ETIMEDOUT"
	// EPipe is the error text when writing to a connection the peer has closed.
	const EPipe = "EPIPE"
}
