partial module std.net.features {
	use (
		std.crypto::(Ed25519PublicKey, generateEd25519Key)
		std.data.encoding::(JSON)
		std.formats.data.mmdb
		std.net.http
		std.net.http.httptest
		std.os
		std.services::(Application)
		std.testing
		std.time
	)

	// Writes a MaxMind DB file of one network for the tests.
	internal type PlaceFile {
		data byte[]

		def new() {}

		def number(value int, width int) {
			for let shift = (width - 1) * 8; shift >= 0; shift -= 8 {
				data.push(byte((value >> shift) & 0xFF))
			}
		}

		def text(value string) {
			data.push(byte(2 << 5 | value.len()))
			for let b in value.bytes() {
				data.push(b)
			}
		}

		def mapOf(count int) {
			data.push(byte(7 << 5 | count))
		}

		def arrayOf(count int) {
			data.push(byte(count))
			data.push(byte(4))
		}

		def small(key string, value int) {
			text(key)
			data.push(byte(5 << 5 | 1))
			data.push(byte(value))
		}
	}

	// A City database that places 203.0.113.0/24 in Île-de-France, France,
	// Europe, and knows no other address.
	internal def placeDatabase() byte[] {
		let file = new PlaceFile()
		let network = byte[203, 0, 113]
		let nodes = 24
		for let i = 0; i < nodes; i++ {
			let bit = (int(network[i >> 3]) >> (7 - (i & 7))) & 1
			let down = i == nodes - 1 ?? (nodes + 16, i + 1)
			file.number(bit == 0 ?? (down, nodes), 3)
			file.number(bit == 1 ?? (down, nodes), 3)
		}
		file.number(0, 8)
		file.number(0, 8)
		file.mapOf(3)
		file.text("continent")
		file.mapOf(1)
		file.text("code")
		file.text("EU")
		file.text("country")
		file.mapOf(1)
		file.text("iso_code")
		file.text("FR")
		file.text("subdivisions")
		file.arrayOf(1)
		file.mapOf(1)
		file.text("iso_code")
		file.text("IDF")
		for let b in byte[0xAB, 0xCD, 0xEF] {
			file.data.push(b)
		}
		for let b in "MaxMind.com".bytes() {
			file.data.push(b)
		}
		file.mapOf(4)
		file.small("binary_format_major_version", 2)
		file.small("node_count", nodes)
		file.small("record_size", 24)
		file.small("ip_version", 4)
		return file.data
	}

	// A subject with that id on linux/amd64, version 2.3.0, French locale.
	internal def subjectOf(id string) Subject {
		return Subject{id: id, app: "shop", version: "2.3.0", os: "linux", arch: "amd64", locale: "fr-FR", measured: true}
	}

	// The value of the key as text: a string as it is, anything else as
	// its JSON.
	internal def at(values map<string, any>, key string) string {
		let held = values.get(key)
		return held when held is string
		return canonical(held)
	}

	// Whether the first rule set gives the feature to the subject.
	internal def on(set RuleSet, name string, subject Subject, seen Seen = Seen{}) bool {
		return set.assign(subject, seen).features[name].enabled
	}

	// A rule set with one feature that the one segment turns on.
	internal def gated(segment Segment) !RuleSet {
		segment.name = "who"
		return try compile(Rules{segments: [segment], features: [Feature{name: "gate", rules: [Rule{segments: ["who"]}]}]})
	}

	// The message `compile` refuses the rules with, "" when it takes them.
	internal def refusal(rules Rules) string {
		let message = ""
		compileOnly(rules) onerror (err error) {
			message = err.message
			message = "not a FeaturesError: " + message unless err is FeaturesError
			recover none
		}
		return message
	}

	internal def compileOnly(rules Rules) !none {
		try compile(rules)
		return none
	}

	// Whether `verify` refuses the reply with a FeaturesError of that kind.
	internal def refused(reply byte[], key Ed25519PublicKey, kind FeaturesErrorKind) bool {
		let matched = false
		verifyOnly(reply, key) onerror (err error) {
			matched = err.kind == kind when err is FeaturesError
			recover none
		}
		return matched
	}

	internal def verifyOnly(reply byte[], key Ed25519PublicKey) !none {
		try verify(reply, key)
		return none
	}

	check "Feature assignments" {
		@test()
		def signedRepliesVerify() !none {
			let key = try generateEd25519Key()
			let other = try generateEd25519Key()
			let given = Assignments{subject: "s-1", issued: 100, refresh: 3600, expires: 5000}
			given.features["checkout"] = Assignment{enabled: true, value: 10}
			given.features["banner"] = Assignment{enabled: false}
			given.groups["login"] = GroupAssignment{arm: "bold", values: {"color": "red", "ratio": 1.5, "steps": ["a", "b"]}}
			let reply = try sign(given, key)
			try testing.expectEqual(88, given.signature.len(), "sign sets the signature, 64 bytes in base64")

			let read = try verify(reply, key.public)
			try testing.expectEqual("s-1", read.subject)
			try testing.expectEqual(int64(5000), read.expires)
			try testing.expectTrue(read.features["checkout"].enabled && !read.features["banner"].enabled)
			try testing.expectEqual("bold", read.groups["login"].arm)
			try testing.expectEqual("red", at(read.groups["login"].values, "color"))
			try testing.expectEqual("1.5", at(read.groups["login"].values, "ratio"))
			try testing.expectEqual("[\"a\",\"b\"]", at(read.groups["login"].values, "steps"))
			try testing.expectNone(read.features["banner"].value, "a feature without a value has none")

			try testing.expectTrue(refused(reply, other.public, FeaturesErrorKind.Signature), "another server's key does not verify")
			let moved = string(reply).replace("\"expires\":5000", "\"expires\":9000").bytes()
			try testing.expectTrue(refused(moved, key.public, FeaturesErrorKind.Signature), "a changed field breaks the signature")
			let renamed = string(reply).replace("s-1", "s-2").bytes()
			try testing.expectTrue(refused(renamed, key.public, FeaturesErrorKind.Signature), "so does another subject")
			let unsigned = string(reply).replace(given.signature, "").bytes()
			try testing.expectTrue(refused(unsigned, key.public, FeaturesErrorKind.Signature), "a reply without a signature is refused")
			try testing.expectTrue(refused("not json".bytes(), key.public, FeaturesErrorKind.Reply))
			try testing.expectTrue(refused("[1, 2]".bytes(), key.public, FeaturesErrorKind.Reply))

			// Spaces and the order of keys are not part of what is signed.
			let spaced = string(reply).replace("\{\"subject\"", "\{ \"subject\"").replace(",\"issued\"", " ,\n\"issued\"").bytes()
			try verify(spaced, key.public)
			return none
		}

		@test()
		def digestNamesTheContent() !none {
			let first = Assignments{subject: "s-1", issued: 100, refresh: 60, expires: 200}
			first.features["a"] = Assignment{enabled: true, value: "x"}
			let later = Assignments{subject: "s-1", issued: 900, refresh: 30, expires: 1900, signature: "abc"}
			later.features["a"] = Assignment{enabled: true, value: "x"}
			let digest = try digestOf(first)
			try testing.expectEqual(64, digest.len(), "a SHA-256 in hexadecimal")
			try testing.expectEqual(digest, try digestOf(later), "the times and the signature are not part of it")
			later.features["a"] = Assignment{enabled: true, value: "y"}
			try testing.expectNotEqual(digest, try digestOf(later), "another value is another digest")
			later.features["a"] = Assignment{enabled: true, value: "x"}
			later.subject = "s-2"
			try testing.expectNotEqual(digest, try digestOf(later), "so is another subject")
			return none
		}
	}

	check "Feature rules" {
		@test()
		def bucketsAreStableAndEven() !none {
			try testing.expectEqual(bucket("", "checkout", "subject-1"), bucket("", "checkout", "subject-1"))
			try testing.expectNotEqual(bucket("", "checkout", "subject-1"), bucket("v2", "checkout", "subject-1"), "a salt moves the subject")
			try testing.expectNotEqual(bucket("", "checkout", "subject-1"), bucket("", "banner", "subject-1"), "features bucket apart")
			try testing.expectNotEqual(bucket("a", "b", "subject-1"), bucket("", "ab", "subject-1"), "the texts do not run together")
			let low = 0
			for let i = 0; i < 20000; i++ {
				let at = bucket("", "checkout", "subject-{i}")
				fail "bucket {at} is outside 0 to 9999" when at < 0 || at >= bucketCount
				low++ when at < 500
			}
			try testing.expectTrue(low > 850 && low < 1150, "5% of the buckets hold about 5% of 20000 subjects, got {low}")
			return none
		}

		@test()
		def rolloutOnlyAddsSubjects() !none {
			let narrow = try compile(Rules{features: [Feature{name: "gate", rules: [Rule{rollout: 5.0}]}]})
			let wide = try compile(Rules{features: [Feature{name: "gate", rules: [Rule{rollout: 20.0}]}]})
			let all = try compile(Rules{features: [Feature{name: "gate", rules: [Rule{}]}]})
			let nobody = try compile(Rules{features: [Feature{name: "gate", rules: [Rule{rollout: 0.0}]}]})
			let fine = try compile(Rules{features: [Feature{name: "gate", rules: [Rule{rollout: 1.25}]}]})
			let inNarrow = 0
			let inWide = 0
			let inFine = 0
			for let i = 0; i < 20000; i++ {
				let subject = subjectOf("subject-{i}")
				let early = on(narrow, "gate", subject)
				let late = on(wide, "gate", subject)
				fail "subject-{i} lost the feature when the rollout grew" when early && !late
				fail "a rollout of 100 left subject-{i} out" unless on(all, "gate", subject)
				fail "a rollout of 0 took subject-{i}" when on(nobody, "gate", subject)
				inNarrow++ when early
				inWide++ when late
				inFine++ when on(fine, "gate", subject)
			}
			try testing.expectTrue(inNarrow > 850 && inNarrow < 1150, "5% of 20000, got {inNarrow}")
			try testing.expectTrue(inWide > 3700 && inWide < 4300, "20% of 20000, got {inWide}")
			try testing.expectTrue(inFine > 180 && inFine < 320, "1.25% of 20000, got {inFine}")
			return none
		}

		@test()
		def defaultsAndTheFirstMatchingRule() !none {
			let set = try compile(Rules{
				segments: [Segment{name: "france", countries: ["fr"]}, Segment{name: "pro", attributes: [Condition{attribute: "plan", equals: "pro"}]}],
				features: [
					Feature{name: "limit", enabled: true, value: 10, rules: [
						Rule{segments: ["france", "pro"], value: 500},
						Rule{segments: ["france"], rollout: 0.0, value: 50},
						Rule{segments: ["pro"], value: 100},
					]},
					Feature{name: "kill", enabled: true, rules: [Rule{segments: ["france"], enabled: false}]},
					Feature{name: "plain"},
				],
			})
			let paris = Seen{country: "FR"}
			let pro = subjectOf("s-1")
			pro.attributes["plan"] = "pro"
			let free = subjectOf("s-1")

			let nobody = set.assign(free, Seen{})
			try testing.expectEqual("s-1", nobody.subject)
			try testing.expectTrue(nobody.features["limit"].enabled, "the feature's default")
			try testing.expectEqual("10", canonical(nobody.features["limit"].value))
			try testing.expectFalse(nobody.features["plain"].enabled, "a feature is off unless said otherwise")
			try testing.expectNone(nobody.features["plain"].value)

			try testing.expectEqual("500", canonical(set.assign(pro, paris).features["limit"].value), "every segment of a rule must hold")
			try testing.expectEqual("100", canonical(set.assign(pro, Seen{country: "DE"}).features["limit"].value), "a later rule decides when the earlier ones do not match")
			try testing.expectEqual("10", canonical(set.assign(free, paris).features["limit"].value), "the first matching rule decides even outside its rollout")
			try testing.expectFalse(set.assign(free, paris).features["kill"].enabled, "a rule turns a feature off for a place")

			// The rule set has its own copy of the rules.
			let mine = Rules{features: [Feature{name: "gate", value: {"rows": 5}}]}
			let kept = try compile(mine)
			mine.features[0].enabled = true
			mine.features[0].value = 9
			mine.features.push(Feature{name: "later"})
			let after = kept.assign(free, Seen{})
			try testing.expectFalse(after.features["gate"].enabled, "rules changed after compile change nothing")
			try testing.expectEqual("\{\"rows\":5\}", canonical(after.features["gate"].value))
			try testing.expectEqual(1, after.features.len())
			try testing.expectTrue(set.assign(free, Seen{country: "DE"}).features["kill"].enabled)
			return none
		}

		@test()
		def segmentsMatchPlaces() !none {
			let country = try gated(Segment{countries: ["FR", "be"]})
			try testing.expectTrue(on(country, "gate", subjectOf("s"), Seen{country: "fr"}) && on(country, "gate", subjectOf("s"), Seen{country: "BE"}))
			try testing.expectFalse(on(country, "gate", subjectOf("s"), Seen{country: "DE"}) || on(country, "gate", subjectOf("s"), Seen{}), "an unknown place is in no country")

			let region = try gated(Segment{regions: ["FR-IDF"]})
			try testing.expectTrue(on(region, "gate", subjectOf("s"), Seen{country: "FR", region: "FR-IDF"}))
			try testing.expectFalse(on(region, "gate", subjectOf("s"), Seen{country: "FR", region: "FR-BRE"}))

			let continent = try gated(Segment{continents: ["EU"]})
			try testing.expectTrue(on(continent, "gate", subjectOf("s"), Seen{continent: "EU"}))
			try testing.expectFalse(on(continent, "gate", subjectOf("s"), Seen{continent: "NA"}))

			let both = try gated(Segment{countries: ["FR"], continents: ["NA"]})
			try testing.expectFalse(on(both, "gate", subjectOf("s"), Seen{country: "FR", continent: "EU"}), "every kind of condition must hold")

			let network = try gated(Segment{networks: ["203.0.113.7", "10.0.0.0/8", "2001:db8::/32"]})
			try testing.expectTrue(on(network, "gate", subjectOf("s"), Seen{address: "203.0.113.7"}), "one address")
			try testing.expectTrue(on(network, "gate", subjectOf("s"), Seen{address: "10.200.3.4"}), "an IPv4 block")
			try testing.expectTrue(on(network, "gate", subjectOf("s"), Seen{address: "2001:db8:1::9"}), "an IPv6 block")
			try testing.expectTrue(on(network, "gate", subjectOf("s"), Seen{address: "::ffff:10.1.2.3"}), "an IPv4 address carried in IPv6")
			try testing.expectFalse(on(network, "gate", subjectOf("s"), Seen{address: "203.0.113.8"}) || on(network, "gate", subjectOf("s"), Seen{address: "2001:db9::1"}) || on(network, "gate", subjectOf("s"), Seen{}))
			return none
		}

		@test()
		def segmentsMatchThePrograms() !none {
			let version = try gated(Segment{versions: ">=2.1.0 <3.0.0"})
			let subject = subjectOf("s")
			try testing.expectTrue(on(version, "gate", subject))
			subject.version = "3.0.0"
			try testing.expectFalse(on(version, "gate", subject))
			subject.version = "nightly"
			try testing.expectFalse(on(version, "gate", subject), "a version that is not one is in no range")

			let system = try gated(Segment{os: ["Linux", "darwin"]})
			try testing.expectTrue(on(system, "gate", subjectOf("s")))
			let windows = subjectOf("s")
			windows.os = "windows"
			try testing.expectFalse(on(system, "gate", windows))

			let french = try gated(Segment{locales: ["fr", "de-CH"]})
			let speaker = subjectOf("s")
			try testing.expectTrue(on(french, "gate", speaker), "fr holds fr-FR")
			speaker.locale = "fr_CA"
			try testing.expectTrue(on(french, "gate", speaker), "written with an underscore too")
			speaker.locale = "de-CH"
			try testing.expectTrue(on(french, "gate", speaker))
			speaker.locale = "de-DE"
			try testing.expectFalse(on(french, "gate", speaker), "de-CH holds only itself")
			speaker.locale = "frr"
			try testing.expectFalse(on(french, "gate", speaker), "fr is not the start of another language")
			return none
		}

		@test()
		def segmentsMatchAttributes() !none {
			let testers = try gated(Segment{attributes: [Condition{attribute: "email", oneOf: ["ana@example.com", "bo@example.com"]}]})
			let ana = subjectOf("s")
			ana.attributes["email"] = "ana@example.com"
			try testing.expectTrue(on(testers, "gate", ana), "one of a list")
			ana.attributes["email"] = "cy@example.com"
			try testing.expectFalse(on(testers, "gate", ana))
			try testing.expectFalse(on(testers, "gate", subjectOf("s")), "a subject without the attribute does not pass")

			let pro = try gated(Segment{attributes: [Condition{attribute: "plan", equals: "pro"}, Condition{attribute: "beta", equals: ""}]})
			let user = subjectOf("s")
			user.attributes["plan"] = "pro"
			try testing.expectFalse(on(pro, "gate", user), "every condition must hold")
			user.attributes["beta"] = ""
			try testing.expectTrue(on(pro, "gate", user), "an attribute may have to be empty")

			let byId = try gated(Segment{attributes: [Condition{attribute: "id", oneOf: ["tester-1"]}, Condition{attribute: "arch", equals: "amd64"}]})
			try testing.expectTrue(on(byId, "gate", subjectOf("tester-1")), "the subject's own fields are attributes")
			try testing.expectFalse(on(byId, "gate", subjectOf("tester-2")))
			let named = subjectOf("tester-2")
			named.attributes["id"] = "tester-1"
			try testing.expectTrue(on(byId, "gate", named), "an attribute of that name comes first")
			return none
		}

		@test()
		def attributesMatchPatterns() !none {
			let staff = try gated(Segment{attributes: [Condition{attribute: "email", matches: "^.+@example\\.com$"}]})
			let user = subjectOf("s")
			user.attributes["email"] = "ana@example.com"
			try testing.expectTrue(on(staff, "gate", user))
			user.attributes["email"] = "ana@example.com.evil.test"
			try testing.expectFalse(on(staff, "gate", user))
			return none
		}

		@test()
		def groupsDrawOneArmForEveryKey() !none {
			let rules = Rules{groups: [Group{
				name: "login-page",
				keys: {"button-color": "blue", "landing-message": "Welcome", "hero-image": "plain.png"},
				arms: [
					Variant{name: "control", weight: 50},
					Variant{name: "bold", weight: 50, values: {"button-color": "red", "landing-message": "Jump in"}},
				],
			}]}
			let set = try compile(rules)
			let bold = 0
			for let i = 0; i < 4000; i++ {
				let given = set.assign(subjectOf("subject-{i}"), Seen{}).groups["login-page"]
				if given.arm == "bold" {
					bold++
					fail "the arm's values do not come together" unless at(given.values, "button-color") == "red" && at(given.values, "landing-message") == "Jump in"
					fail "a key the arm leaves out lost its default" unless at(given.values, "hero-image") == "plain.png"
				} else {
					fail "subject-{i} is in the arm \"{given.arm}\"" unless given.arm == "control"
					fail "the control arm changed a value" unless at(given.values, "button-color") == "blue" && at(given.values, "landing-message") == "Welcome"
				}
			}
			try testing.expectTrue(bold > 1850 && bold < 2150, "half of 4000 subjects, got {bold}")

			let unmeasured = subjectOf("subject-1")
			unmeasured.measured = false
			let outside = set.assign(unmeasured, Seen{}).groups["login-page"]
			try testing.expectEqual("", outside.arm, "a subject that is not measured is outside the test")
			try testing.expectEqual("blue", at(outside.values, "button-color"), "and gets the defaults")
			rules.groups[0].everyone = true
			let open = try compile(rules)
			try testing.expectNotEqual("", open.assign(unmeasured, Seen{}).groups["login-page"].arm, "unless the group is for everyone")
			return none
		}

		@test()
		def groupRulesDecideWhoIsIn() !none {
			let group = Group{
				name:  "pricing",
				keys:  {"price": 10},
				arms:  [Variant{name: "a", weight: 1}, Variant{name: "b", weight: 3, values: {"price": 12}}],
				rules: [
					Rule{segments: ["testers"], weights: {"b": 1}},
					Rule{segments: ["blocked"], enabled: false},
					Rule{rollout: 10.0},
				],
			}
			let segments = [
				Segment{name: "testers", attributes: [Condition{attribute: "id", oneOf: ["tester-1", "tester-2"]}]},
				Segment{name: "blocked", countries: ["XX"]},
			]
			let narrow = try compile(Rules{segments: segments, groups: [group]})
			let wider = Group{name: group.name, keys: group.keys, arms: group.arms, rules: [group.rules[0], group.rules[1], Rule{rollout: 40.0}]}
			let wide = try compile(Rules{segments: segments, groups: [wider]})

			try testing.expectEqual("b", narrow.assign(subjectOf("tester-1"), Seen{}).groups["pricing"].arm, "a rule's weights put its subjects in an arm")
			try testing.expectEqual("12", at(narrow.assign(subjectOf("tester-2"), Seen{}).groups["pricing"].values, "price"))
			let inNarrow = 0
			let inWide = 0
			let inB = 0
			for let i = 0; i < 20000; i++ {
				let subject = subjectOf("subject-{i}")
				let early = narrow.assign(subject, Seen{}).groups["pricing"].arm
				let late = wide.assign(subject, Seen{}).groups["pricing"].arm
				fail "subject-{i} left the test when the rollout grew" when early != "" && late == ""
				fail "subject-{i} moved from {early} to {late} when the rollout grew" when early != "" && early != late
				fail "a blocked subject is in the test" unless narrow.assign(subject, Seen{country: "XX"}).groups["pricing"].arm == ""
				inNarrow++ when early != ""
				inWide++ when late != ""
				inB++ when late == "b"
			}
			try testing.expectTrue(inNarrow > 1800 && inNarrow < 2200, "10% of 20000, got {inNarrow}")
			try testing.expectTrue(inWide > 7600 && inWide < 8400, "40% of 20000, got {inWide}")
			try testing.expectTrue(inB * 100 > inWide * 71 && inB * 100 < inWide * 79, "three quarters of those in the test are in b, got {inB} of {inWide}")
			return none
		}

		@test()
		def compileNamesWhatIsWrong() !none {
			let arms = [Variant{name: "a"}]
			try testing.expectEqual("", refusal(Rules{}), "no rules are valid rules")
			try testing.expectTrue(refusal(Rules{segments: [Segment{}]}).contains("a segment has no name"))
			try testing.expectTrue(refusal(Rules{segments: [Segment{name: "s"}, Segment{name: "s"}]}).contains("two segments are named \"s\""))
			try testing.expectTrue(refusal(Rules{segments: [Segment{name: "s", networks: ["10.0.0.0/40"]}]}).contains("not an address or a CIDR block"))
			try testing.expectTrue(refusal(Rules{segments: [Segment{name: "s", versions: "about two"}]}).contains("does not parse"))
			try testing.expectTrue(refusal(Rules{segments: [Segment{name: "s", attributes: [Condition{equals: "x"}]}]}).contains("without an attribute"))
			try testing.expectTrue(refusal(Rules{segments: [Segment{name: "s", attributes: [Condition{attribute: "email", matches: "([a-z"}]}]}).contains("not a regular expression"))
			try testing.expectTrue(refusal(Rules{features: [Feature{}]}).contains("a feature has no name"))
			try testing.expectTrue(refusal(Rules{features: [Feature{name: "f"}, Feature{name: "f"}]}).contains("two features are named \"f\""))
			try testing.expectTrue(refusal(Rules{features: [Feature{name: "f", rules: [Rule{segments: ["nowhere"]}]}]}).contains("the segment \"nowhere\", which does not exist"))
			try testing.expectTrue(refusal(Rules{features: [Feature{name: "f", rules: [Rule{rollout: 100.5}]}]}).contains("outside 0 to 100"))
			try testing.expectTrue(refusal(Rules{features: [Feature{name: "f", rules: [Rule{rollout: -1.0}]}]}).contains("outside 0 to 100"))
			try testing.expectTrue(refusal(Rules{features: [Feature{name: "f", rules: [Rule{weights: {"a": 1}}]}]}).contains("only a group's rule takes"))
			try testing.expectTrue(refusal(Rules{groups: [Group{arms: arms}]}).contains("a group has no name"))
			try testing.expectTrue(refusal(Rules{groups: [Group{name: "g", arms: arms}, Group{name: "g", arms: arms}]}).contains("two groups are named \"g\""))
			try testing.expectTrue(refusal(Rules{groups: [Group{name: "g"}]}).contains("has no arms"))
			try testing.expectTrue(refusal(Rules{groups: [Group{name: "g", arms: [Variant{name: "a"}, Variant{name: "a"}]}]}).contains("two arms named \"a\""))
			try testing.expectTrue(refusal(Rules{groups: [Group{name: "g", arms: [Variant{}]}]}).contains("an arm without a name"))
			try testing.expectTrue(refusal(Rules{groups: [Group{name: "g", arms: [Variant{name: "a", weight: -1}]}]}).contains("a weight below 0"))
			try testing.expectTrue(refusal(Rules{groups: [Group{name: "g", arms: [Variant{name: "a", weight: 0}]}]}).contains("add up to 0"))
			try testing.expectTrue(refusal(Rules{groups: [Group{name: "g", arms: [Variant{name: "a", values: {"k": 1}}]}]}).contains("not one of the group's keys"))
			try testing.expectTrue(refusal(Rules{groups: [Group{name: "g", arms: arms, rules: [Rule{weights: {"z": 1}}]}]}).contains("not one of its arms"))
			try testing.expectTrue(refusal(Rules{groups: [Group{name: "g", arms: arms, rules: [Rule{weights: {"a": 0}}]}]}).contains("add up to 0"))
			try testing.expectTrue(refusal(Rules{groups: [Group{name: "g", arms: arms, rules: [Rule{segments: ["nowhere"]}]}]}).contains("does not exist"))
			return none
		}
	}

	check "Feature rule sources" {
		@test()
		def memoryRulesAreReplaced() !none {
			let source = new MemoryRules(try compile(Rules{features: [Feature{name: "gate"}]}))
			try testing.expectFalse(on(try source.rules(), "gate", subjectOf("s")))
			source.replace(try compile(Rules{features: [Feature{name: "gate", enabled: true}]}))
			try testing.expectTrue(on(try source.rules(), "gate", subjectOf("s")))
			return none
		}

		@test()
		def fileRulesFollowTheFile() !none {
			let dir = os.join(try Application.home(), "features-rules")
			try os.mkdir(dir, true)
			let path = os.join(dir, "rules.json")
			let source = new FileRules(path)
			source.recheck = 0s

			let missing = ""
			rulesOnly(source) onerror (err error) {
				missing = err.message
				recover none
			}
			try testing.expectTrue(missing.contains("cannot be read"), "no file and no earlier rules is a failure, got: {missing}")

			try os.writeFile(path, "\{\"segments\": [\{\"name\": \"fr\", \"countries\": [\"FR\"]\}], \"features\": [\{\"name\": \"gate\", \"value\": \{\"rows\": 5\}, \"rules\": [\{\"segments\": [\"fr\"], \"rollout\": 100\}]\}], \"groups\": [\{\"name\": \"g\", \"keys\": \{\"k\": 1\}, \"arms\": [\{\"name\": \"a\", \"weight\": 2, \"values\": \{\"k\": 2\}\}]\}]\}".bytes())
			let first = try source.rules()
			try testing.expectTrue(on(first, "gate", subjectOf("s"), Seen{country: "FR"}) && !on(first, "gate", subjectOf("s"), Seen{country: "DE"}), "the file's rules decide")
			try testing.expectEqual("2", at(first.assign(subjectOf("s"), Seen{}).groups["g"].values, "k"), "groups and arms read from the file")
			try testing.expectTrue(first == (try source.rules()), "an unchanged file is not compiled again")

			try os.writeFile(path, "\{\"features\": [\{\"name\": \"gate\", \"enabled\": true\}, \{\"name\": \"more\"\}]\}".bytes())
			let second = try source.rules()
			try testing.expectTrue(on(second, "gate", subjectOf("s"), Seen{country: "DE"}), "a changed file is read again")

			try os.writeFile(path, "\{\"features\": [\{\"name\": \"gate\"\}, \{\"name\": \"gate\"\}]\}".bytes())
			try testing.expectTrue(second == (try source.rules()), "a file that does not compile is left aside")
			try os.writeFile(path, "\{\"features\": [".bytes())
			try testing.expectTrue(second == (try source.rules()), "so is one that is not JSON")
			try os.remove(path, false)
			try testing.expectTrue(second == (try source.rules()), "and a file that went away")

			let fresh = new FileRules(path)
			try os.writeFile(path, "\{\"features\": [\{\"name\": \"gate\"\}, \{\"name\": \"gate\"\}]\}".bytes())
			let invalid = ""
			rulesOnly(fresh) onerror (err error) {
				invalid = err.message
				recover none
			}
			try testing.expectTrue(invalid.contains("two features are named"), "a first file that does not compile is a failure, got: {invalid}")
			return none
		}
	}

	internal def rulesOnly(source RuleSource) !none {
		try source.rules()
		return none
	}

	// A server over rules with one feature and one group, with short times.
	internal def testServer() !FeatureServer {
		let set = try compile(Rules{
			segments: [Segment{name: "france", countries: ["FR"]}, Segment{name: "idf", regions: ["FR-IDF"]}, Segment{name: "europe", continents: ["EU"]}],
			features: [
				Feature{name: "gate", rules: [Rule{segments: ["france"]}]},
				Feature{name: "regional", rules: [Rule{segments: ["idf", "europe"]}]},
			],
			groups: [Group{name: "g", keys: {"k": 1}, arms: [Variant{name: "a", values: {"k": 2}}], everyone: true}],
		})
		let server = new FeatureServer(new MemoryRules(set), try generateEd25519Key())
		server.refresh = 10min
		server.validity = 48h
		return server
	}

	check "Feature server" {
		@test()
		def answersAreSignedAndTimed() !none {
			let server = try testServer()
			let before = time.wallNs() / 1000000000
			let given = try server.evaluate(subjectOf("s-1"), Seen{country: "FR"})
			try testing.expectEqual("s-1", given.subject)
			try testing.expectTrue(given.issued >= before && given.issued <= before + 5, "issued now")
			try testing.expectEqual(int64(600), given.refresh, "the server's refresh in seconds")
			try testing.expectEqual(given.issued + 172800, given.expires, "valid for the server's validity")
			try testing.expectTrue(given.features["gate"].enabled && !given.unchanged)
			try testing.expectEqual("a", given.groups["g"].arm)
			let read = try verify((new JSON()).encode(given), server.key.public)
			try testing.expectTrue(read.features["gate"].enabled, "what evaluate gives verifies with the server's key")

			let knowing = subjectOf("s-1")
			knowing.known = try digestOf(given)
			let same = try server.evaluate(knowing, Seen{country: "FR"})
			try testing.expectTrue(same.unchanged, "a subject that holds the answer is told so")
			try testing.expectEqual(knowing.known, same.known)
			try testing.expectEqual(0, same.features.len() + same.groups.len(), "and is not sent it again")
			try testing.expectEqual(same.issued + 172800, same.expires, "with new times")
			try verify((new JSON()).encode(same), server.key.public)

			let moved = try server.evaluate(knowing, Seen{country: "DE"})
			try testing.expectFalse(moved.unchanged, "another answer is sent whole")
			try testing.expectFalse(moved.features["gate"].enabled)
			return none
		}

		@test()
		def requestsArePlaced() !none {
			let server = try testServer()
			try testing.expectEqual("198.51.100.4", server.seen("198.51.100.4", ["203.0.113.9"]).address, "a peer that is no proxy is the client, whatever it forwards")
			server.proxies = ["10.0.0.0/8", "192.0.2.1"]
			try testing.expectEqual("203.0.113.9", server.seen("10.0.0.5", ["203.0.113.9"]).address, "a proxy's forwarded address is believed")
			try testing.expectEqual("203.0.113.9", server.seen("192.0.2.1", ["1.2.3.4", "203.0.113.9", "10.0.0.7"]).address, "the nearest address that is not a proxy, not what the client claims")
			try testing.expectEqual("10.0.0.5", server.seen("10.0.0.5").address, "a proxy that forwards nothing is the client")
			try testing.expectEqual("10.0.0.7", server.seen("10.0.0.5", ["10.0.0.7"]).address, "a chain of proxies only ends at its first")
			try testing.expectEqual("", server.seen("198.51.100.4").country, "no database, no place")

			server.geo = try mmdb.open(placeDatabase())
			let paris = server.seen("203.0.113.9")
			try testing.expectEqual("FR", paris.country)
			try testing.expectEqual("FR-IDF", paris.region)
			try testing.expectEqual("EU", paris.continent)
			let elsewhere = server.seen("198.51.100.4")
			try testing.expectEqual("", elsewhere.country + elsewhere.region + elsewhere.continent, "an address the database does not know is nowhere")
			try testing.expectEqual("", server.seen("not an address").country)
			let given = try server.evaluate(subjectOf("s-1"), server.seen("10.0.0.5", ["203.0.113.9"]))
			try testing.expectTrue(given.features["gate"].enabled && given.features["regional"].enabled, "rules on places decide by the database")
			try testing.expectFalse((try server.evaluate(subjectOf("s-1"), elsewhere)).features["gate"].enabled)
			return none
		}

		@test()
		def theExchangeIsOnePost() !none {
			let server = try testServer()
			server.maxBody = 2048
			server.geo = try mmdb.open(placeDatabase())
			server.proxies = ["127.0.0.1"]
			let web = try httptest.Server.start(server.handler())
			let client = web.client()

			let body = (new JSON()).encode(subjectOf("s-9"))
			let posted = try http.newRequest(http.Method.POST, web.url + "/features", body)
			posted.headers.set("Content-Type", "application/json")
			posted.headers.set("X-Forwarded-For", "203.0.113.9")
			let answered = try client.do(posted)
			try testing.expectEqual(200, answered.status)
			try testing.expectEqual("no-store", answered.header("Cache-Control"))
			let given = try verify(try answered.bytes(), server.key.public)
			try testing.expectEqual("s-9", given.subject)
			try testing.expectTrue(given.features["gate"].enabled, "the proxy's forwarded address places the request")

			let direct = try client.post("/features", "application/json", body)
			try testing.expectFalse((try verify(try direct.bytes(), server.key.public)).features["gate"].enabled, "without it the request comes from the proxy itself")

			try testing.expectEqual(405, (try client.get("/features")).status, "only POST")
			try testing.expectEqual(400, (try client.post("/features", "application/json", "not json".bytes())).status)
			try testing.expectEqual(400, (try client.post("/features", "application/json", "\{\"app\": \"shop\"\}".bytes())).status, "a subject needs an id")
			let large byte[] = []
			large.len(4096)
			large.fill(byte(0x20))
			try testing.expectEqual(413, (try client.post("/features", "application/json", large)).status, "a body over maxBody is refused")
			try web.close()
			return none
		}
	}
}
