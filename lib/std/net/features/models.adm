// Feature gates decided by a server: gradual rollout per place, kill
// switches, attribute gates and A/B groups.
//
// A program sends a `Subject` (who is asking) and gets back `Assignments`
// (what that subject gets), signed by the server. The rules never leave the
// server. This module holds both sides' types, the evaluator and
// `FeatureServer`; a program reads its assignments through the `Features`
// service (`std.services.features`).
//
//     use std.net.features
//
//     let rules = try features.compile(features.Rules{features: [
//         features.Feature{name: "new-checkout", rules: [features.Rule{rollout: 5.0}]},
//     ]})
//     let server = new features.FeatureServer(new features.MemoryRules(rules), key)
//     try server.serve(":8443")
partial module std.net.features {
	use (
		std.crypto::(Ed25519PrivateKey, Ed25519PublicKey)
		std.crypto.hash::(Hash, digest)
		std.data.encoding::(JSON, base64decode, base64encode, hexencode)
		std.errors
	)

	// Who asks for assignments: what a program sends to the server.
	struct Subject {
		// Names the installation, the same on every request (`Vault.id()` for
		// the `Features` service). The server places the subject in a bucket
		// by it, so a subject keeps what it was given.
		id         string
		// The program's name and version, the system and processor it runs
		// on (`linux`, `amd64`) and the user's locale (`fr-FR`).
		app        string
		version    string
		os         string
		arch       string
		locale     string
		// Whatever the program chooses to say about its user: `plan`,
		// `email`. Rules match on them by name.
		attributes map<string, string>
		// The digest of the assignments the program already holds (`digestOf`),
		// "" for none. A server whose answer has that digest replies
		// `unchanged` instead of sending it again.
		known      string
		// Whether what this subject does is measured (telemetry is on and
		// the user agreed to it). A group takes only measured subjects
		// unless it is for `everyone`.
		measured   bool
	}

	// What only the server knows of a subject: where the request came from.
	struct Seen {
		// The client's IP address as text, "" when unknown.
		address   string
		// The ISO 3166-1 country code (`FR`), the ISO 3166-2 subdivision
		// (`FR-IDF`) and the continent code (`EU`); each "" when unknown.
		country   string
		region    string
		continent string
	}

	// What a subject gets for one feature.
	struct Assignment {
		enabled bool
		// The feature's value for this subject; none when it has none.
		value   ?any
	}

	// What a subject gets for one group: its arm, and the value of every key
	// of the group.
	struct GroupAssignment {
		// The arm the subject is in, "" outside the test.
		arm    string
		values map<string, any>
	}

	// The server's answer for one subject.
	struct Assignments {
		// The id the answer was made for.
		subject   string
		// When it was made and until when it holds, in seconds since the Unix
		// epoch, and how many seconds the program waits before asking again.
		issued    int64
		refresh   int64
		expires   int64
		// Set when the subject already holds this answer (`Subject.known`):
		// `known` is then that digest and `features` and `groups` are empty.
		// The times are new, so the answer the program holds stays valid
		// until the new `expires`.
		unchanged bool
		known     string
		features  map<string, Assignment>
		groups    map<string, GroupAssignment>
		// The Ed25519 signature over every field above, in base64 (`sign`).
		signature string
	}

	// Why a call of this module failed.
	enum FeaturesErrorKind {
		// The rules are not valid, or cannot be read.
		Rules,
		// A reply is not the JSON of `Assignments`.
		Reply,
		// A reply's signature is missing or not the server's.
		Signature,
		// A reply was made for another subject.
		Subject,
		// A reply is past its `expires`.
		Expired,
		// The server could not be reached, or answered with an error.
		Transport,
	}

	// The error this module and the `Features` service fail with.
	struct FeaturesError {
		message string
		code    string            = "features.error"
		cause   ?error
		stack   errors.StackTrace
		kind    FeaturesErrorKind
	}

	// The bytes a signature is made over: the value as JSON without spaces,
	// the keys of every object in byte order.
	internal def canonical(value ?any) string {
		return "null" when value is none
		let codec = new JSON()
		match value {
			case map<string, any>:
				let keys = value.keys()
				keys.sort((a, b string) => a < b)
				let members string[]
				for let key in keys {
					members.push(string(codec.encode(key)) + ":" + canonical(value.get(key)))
				}
				return "\{" + members.join(",") + "\}"
			case any[]:
				let items string[]
				for let item in value {
					items.push(canonical(item))
				}
				return "[" + items.join(",") + "]"
			default:
				return string(codec.encode(value))
		}
	}

	// The assignments as the plain values of their JSON, without the
	// signature. Fails when a value in them does not read back from JSON.
	internal def plain(assignments Assignments) !map<string, any> {
		let codec = new JSON()
		let tree = codec.parse(codec.encode(assignments)) onerror (err error) {
			fail FeaturesError{message: "features: the assignments do not encode: {err.message}", kind: FeaturesErrorKind.Reply, cause: err}
		}
		match tree {
			case map<string, any>:
				tree.delete("signature")
				return tree
			default:
				fail FeaturesError{message: "features: the assignments do not encode as an object", kind: FeaturesErrorKind.Reply}
		}
	}

	// The digest of what the assignments give: the SHA-256, in hexadecimal,
	// of the subject, the features and the groups. The times and the
	// signature are not part of it, so two answers that give the same have
	// the same digest. It is what `Subject.known` carries. Fails when a
	// value in the assignments does not encode as JSON.
	def digestOf(assignments Assignments) !string {
		let tree = try plain(assignments)
		let content = "\{\"features\":" + canonical(tree.get("features")) + ",\"groups\":" + canonical(tree.get("groups")) + ",\"subject\":" + canonical(tree.get("subject")) + "\}"
		return hexencode(digest(Hash.SHA256, content.bytes())).lower()
	}

	// Signs the assignments with the server's key, sets their `signature`
	// and returns the reply to send: their JSON. The signature covers every
	// other field, written as JSON without spaces and with the keys of each
	// object in byte order. Fails when a value in the assignments does not
	// encode as JSON.
	def sign(assignments Assignments, key Ed25519PrivateKey) !byte[] {
		let tree = try plain(assignments)
		assignments.signature = base64encode(key.sign(canonical(tree).bytes()))
		return (new JSON()).encode(assignments)
	}

	// Reads a reply and checks that the server holding the private half of
	// `key` signed it. Whether the reply is for this subject and still
	// holds is the caller's to check (`subject`, `expires`).
	//
	// Fails with a FeaturesError: `Reply` when the bytes are not the JSON of
	// assignments, `Signature` when the signature is missing or not made
	// with that key over these fields.
	def verify(reply byte[], key Ed25519PublicKey) !Assignments {
		let codec = new JSON()
		let tree = codec.parse(reply) onerror (err error) {
			fail FeaturesError{message: "features: the reply is not JSON: {err.message}", kind: FeaturesErrorKind.Reply, cause: err}
		}
		match tree {
			case map<string, any>:
				let carried = tree.get("signature")
				tree.delete("signature")
				let text = ""
				text = carried when carried is string
				let signature = base64decode(text) onerror recover byte[]
				fail FeaturesError{message: "features: the reply is not signed", kind: FeaturesErrorKind.Signature} when signature.len() == 0
				fail FeaturesError{message: "features: the reply's signature is not the server's", kind: FeaturesErrorKind.Signature} unless key.verify(canonical(tree).bytes(), signature)
			default:
				fail FeaturesError{message: "features: the reply is not an object", kind: FeaturesErrorKind.Reply}
		}
		let assignments = Assignments{}
		codec.decode(reply, assignments) onerror (err error) {
			fail FeaturesError{message: "features: the reply does not read as assignments: {err.message}", kind: FeaturesErrorKind.Reply, cause: err}
		}
		return assignments
	}
}
