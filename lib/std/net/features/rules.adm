partial module std.net.features {
	use (
		std.crypto.hash::(Hash, digest)
		std.data.encoding::(JSON)
		std.data.semver
		std.net
	)

	// How many buckets subjects are spread over: one is 0.01% of them.
	const bucketCount = 10000

	// One test of an attribute of the subject. Every part given must hold.
	struct Condition {
		// The attribute's name in `Subject.attributes`; `id`, `app`,
		// `version`, `os`, `arch` and `locale` name the subject's own fields
		// when no attribute is called so. A subject without the attribute
		// does not pass.
		attribute string
		// The value it must have.
		equals    ?string  = none
		// The values it may have; empty for any.
		oneOf     string[]
		// A regular expression the value must match somewhere (anchor it
		// with `^` and `$` for the whole value); "" for none.
		matches   string   = ""
	}

	// A named set of conditions, used by rules. Every kind of condition
	// given must hold; within one kind, one entry is enough. A segment with
	// no condition holds every subject.
	struct Segment {
		name       string
		// ISO 3166-1 country codes (`FR`), ISO 3166-2 subdivisions
		// (`FR-IDF`) and continent codes (`EU`), as the server's database
		// places the request. Without a database they hold nobody.
		countries  string[]
		regions    string[]
		continents string[]
		// IP addresses and CIDR blocks the request comes from
		// (`203.0.113.7`, `10.0.0.0/8`, `2001:db8::/32`).
		networks   string[]
		// A range the program's version must satisfy (`>=2.1.0 <3.0.0`, as
		// `std.data.semver` reads it); "" for any.
		versions   string      = ""
		// Systems (`linux`, `darwin`, `windows`).
		os         string[]
		// Locales: `fr` holds `fr` and every `fr-…`, `fr-CA` only itself.
		locales    string[]
		// Tests on attributes, all of which must hold. A list of testers
		// is one condition on `email` or on `id`.
		attributes Condition[]
	}

	// One rule of a feature or a group. The rules are tried in order and
	// the first whose segments all hold the subject decides, whether or not
	// the subject falls inside its rollout.
	struct Rule {
		// The names of the segments that must all hold the subject; empty
		// for every subject.
		segments string[]
		// The share of those subjects the rule's outcome goes to, in
		// percent with two decimals (`5.0`, `1.25`). The others get the
		// default.
		rollout  float            = 100.0
		// The outcome. For a feature: whether it is on, and its value (none
		// keeps the feature's own). For a group: whether the subject is in
		// the test.
		enabled  bool             = true
		value    ?any             = none
		// For a group only: weights that replace the arms' own for the
		// subjects of this rule (`\{"bold": 1\}` puts every tester in
		// `bold`); arms left out weigh 0. Empty keeps the arms' weights.
		weights  map<string, int>
	}

	// A feature: what every subject gets, and the rules that give some
	// subjects something else.
	struct Feature {
		name    string
		enabled bool   = false
		value   ?any   = none
		// Mixed into the bucket of each subject. Another salt spreads the
		// subjects anew.
		salt    string = ""
		rules   Rule[]
	}

	// One arm of a group: its share of the subjects in the test, and the
	// values it gives to the group's keys. A key it leaves out keeps the
	// group's default.
	struct Variant {
		name   string
		weight int              = 1
		values map<string, any>
	}

	// An A/B test over several keys at once: one draw per subject picks the
	// arm, and the arm fixes the value of every key together.
	struct Group {
		name     string
		// The keys with their default values: what a subject outside the
		// test gets, with the arm "".
		keys     map<string, any>
		// Who is in the test. Without rules, every subject is.
		rules    Rule[]
		arms     Variant[]
		// Takes subjects that are not measured too (`Subject.measured`),
		// for a test whose result is read some other way.
		everyone bool             = false
		// Mixed into the draws of each subject. Another salt starts the
		// test over with the subjects spread anew.
		salt     string           = ""
	}

	// Everything a server decides with: what a rules file holds.
	struct Rules {
		segments Segment[]
		features Feature[]
		groups   Group[]
	}

	// The bucket of a subject for a feature or a group: a number from 0 to
	// 9999 that depends only on the three texts, so a subject keeps its
	// bucket from one request to the next and from one server to another.
	def bucket(salt string, name string, id string) int {
		let sum = digest(Hash.SHA256, "{salt}\n{name}\n{id}".bytes())
		let folded = uint64(0)
		for let i = 0; i < 8; i++ {
			folded = folded << 8 | uint64(sum[i])
		}
		return int(folded % uint64(bucketCount))
	}

	// How many buckets a rollout in percent takes, none when it is not
	// between 0 and 100.
	internal def bucketsOf(rollout float) ?int {
		return none when rollout < 0.0 || rollout > 100.0
		return int(rollout * 100.0 + 0.5)
	}

	// A segment made ready to test subjects.
	internal type Matcher {
		countries  string[]
		regions    string[]
		continents string[]
		blocks     net.IPBlock[]
		// The version range, "" for any.
		versions   string
		os         string[]
		locales    string[]
		conditions BoundCondition[]

		def new() {}

		// Whether the segment holds the subject.
		def holds(subject Subject, seen Seen) bool {
			return false when countries.len() > 0 && !countries.includes(seen.country.upper())
			return false when regions.len() > 0 && !regions.includes(seen.region.upper())
			return false when continents.len() > 0 && !continents.includes(seen.continent.upper())
			return false when blocks.len() > 0 && !inBlocks(seen.address)
			return false when versions != "" && !inRange(subject.version)
			return false when os.len() > 0 && !os.includes(subject.os.lower())
			return false when locales.len() > 0 && !speaks(subject.locale)
			for let bound in conditions {
				return false unless passes(bound, subject)
			}
			return true
		}

		def inBlocks(address string) bool {
			let ip = net.parseIPText(address)
			return false when ip is none
			for let block in blocks {
				return true when block.contains(ip)
			}
			return false
		}

		def inRange(version string) bool {
			let parsed = versionOf(version) onerror recover none
			return false when parsed is none
			return parsed.satisfies(versions)
		}

		def speaks(locale string) bool {
			let spoken = locale.lower().replace("_", "-")
			for let wanted in locales {
				return true when spoken == wanted || spoken.startsWith(wanted + "-")
			}
			return false
		}

		def passes(bound BoundCondition, subject Subject) bool {
			let condition = bound.condition
			let held = attributeOf(subject, condition.attribute)
			return false when held is none
			let wanted = condition.equals
			return false when !(wanted is none) && wanted != held
			return false when condition.oneOf.len() > 0 && !condition.oneOf.includes(held)
			let pattern = bound.pattern
			return false when !(pattern is none) && !pattern.test(held)
			return true
		}
	}

	// A condition with its regular expression built; none without one.
	internal struct BoundCondition {
		condition Condition
		pattern   ?regex    = none
	}

	// The version the text gives; fails when it is not one.
	internal def versionOf(text string) !?semver.Semver {
		return try semver.parse(text)
	}

	// The subject's attribute of that name, else its own field of that
	// name; none when it has neither.
	internal def attributeOf(subject Subject, name string) ?string {
		return subject.attributes.get(name) when subject.attributes.hasKey(name)
		match name {
			case "id":
				return subject.id
			case "app":
				return subject.app
			case "version":
				return subject.version
			case "os":
				return subject.os
			case "arch":
				return subject.arch
			case "locale":
				return subject.locale
			default:
				return none
		}
	}

	// A rule with its segments found and its rollout in buckets.
	internal struct BoundRule {
		rule     Rule
		matchers Matcher[]
		buckets  int
	}

	internal struct BoundFeature {
		feature Feature
		rules   BoundRule[]
	}

	internal struct BoundGroup {
		group Group
		rules BoundRule[]
	}

	// Rules checked and made ready to decide: what `compile` gives and a
	// `RuleSource` hands to the server. It does not change once made, so
	// any number of tasks decide with it at once.
	type RuleSet {
		// The rules it was made from.
		rules    Rules
		features BoundFeature[]
		groups   BoundGroup[]

		def new(rules Rules) {
			self.rules = rules
		}

		// What the subject gets for every feature and every group: the
		// `features` and `groups` of its assignments, with `subject` set.
		// The server adds the times and the signature
		// (`FeatureServer.evaluate`).
		def assign(subject Subject, seen Seen) Assignments {
			let given = Assignments{subject: subject.id}
			for let bound in features {
				let feature = bound.feature
				let assignment = Assignment{enabled: feature.enabled, value: feature.value}
				let deciding = decides(bound.rules, subject, seen)
				if !(deciding is none) && bucket(feature.salt, feature.name, subject.id) < deciding.buckets {
					assignment.enabled = deciding.rule.enabled
					assignment.value = deciding.rule.value unless deciding.rule.value is none
				}
				given.features[feature.name] = assignment
			}
			for let bound in groups {
				let group = bound.group
				let assignment = GroupAssignment{arm: "", values: group.keys.clone()}
				let arm = armOf(bound, subject, seen)
				if !(arm is none) {
					assignment.arm = arm.name
					for let (key, value) in arm.values {
						assignment.values[key] = value
					}
				}
				given.groups[group.name] = assignment
			}
			return given
		}

		// The first rule whose segments all hold the subject.
		internal def decides(rules BoundRule[], subject Subject, seen Seen) ?BoundRule {
			for let bound in rules {
				let held = true
				for let matcher in bound.matchers {
					held = false unless matcher.holds(subject, seen)
					break unless held
				}
				return bound when held
			}
			return none
		}

		// The arm the subject is in; none outside the test. Two draws under
		// different salts: one against the rule's rollout, one across the
		// weights, so a wider rollout moves nobody to another arm.
		internal def armOf(bound BoundGroup, subject Subject, seen Seen) ?Variant {
			let group = bound.group
			return none unless group.everyone || subject.measured
			let weights = map<string, int>{}
			if bound.rules.len() > 0 {
				let deciding = decides(bound.rules, subject, seen)
				return none when deciding is none || !deciding.rule.enabled
				return none unless bucket(group.salt + "/in", group.name, subject.id) < deciding.buckets
				weights = deciding.rule.weights
			}
			let total = 0
			for let arm in group.arms {
				total += weightOf(arm, weights)
			}
			return none when total == 0
			let draw = bucket(group.salt + "/arm", group.name, subject.id)
			let reached = 0
			for let arm in group.arms {
				reached += weightOf(arm, weights)
				return arm when draw * total < reached * bucketCount
			}
			return none
		}
	}

	// The arm's weight: its own, or the one a rule's weights give it.
	internal def weightOf(arm Variant, weights map<string, int>) int {
		return arm.weight when weights.len() == 0
		return weights.hasKey(arm.name) ?? (weights[arm.name], 0)
	}

	// The failure `compile` reports.
	internal def invalid(message string) FeaturesError {
		return FeaturesError{message: "features: {message}", kind: FeaturesErrorKind.Rules}
	}

	// Checks the rules and makes them ready to decide. The rule set keeps a
	// copy of its own, so changing `rules` afterwards changes nothing; its
	// values are what their JSON reads back as (a whole number, a float, a
	// text, a bool, a `map<string, any>`, an `any[]`).
	//
	// Fails with a FeaturesError of kind `Rules` that names what is wrong:
	// a segment, feature, group or arm without a name or named twice, a
	// rule that names a segment there is none of, a rollout outside 0 to
	// 100, a network that is not an address or a CIDR block, a version
	// range or a regular expression that does not parse, a value that JSON
	// cannot carry, a condition
	// without an attribute, a group without arms, a weight below 0 or
	// weights that add up to 0, an arm that gives a value to a key the
	// group does not have, weights that name an arm the group does not
	// have, and weights on a feature's rule.
	def compile(given Rules) !RuleSet {
		let codec = new JSON()
		let rules = Rules{}
		codec.decode(codec.encode(given), rules) onerror (err error) {
			fail invalid("a value in the rules does not read back from JSON: {err.message}")
		}
		let matchers = map<string, Matcher>{}
		for let segment in rules.segments {
			fail invalid("a segment has no name") when segment.name == ""
			fail invalid("two segments are named \"{segment.name}\"") when matchers.hasKey(segment.name)
			matchers[segment.name] = try matcherOf(segment)
		}
		let made = new RuleSet(rules)
		let names = map<string, bool>{}
		for let feature in rules.features {
			fail invalid("a feature has no name") when feature.name == ""
			fail invalid("two features are named \"{feature.name}\"") when names.hasKey(feature.name)
			names[feature.name] = true
			let bound = BoundFeature{feature: feature}
			for let rule in feature.rules {
				fail invalid("the feature \"{feature.name}\" has a rule with weights, which only a group's rule takes") when rule.weights.len() > 0
				bound.rules.push(try boundRule(rule, matchers, "feature \"{feature.name}\""))
			}
			made.features.push(bound)
		}
		names = map<string, bool>{}
		for let group in rules.groups {
			fail invalid("a group has no name") when group.name == ""
			fail invalid("two groups are named \"{group.name}\"") when names.hasKey(group.name)
			names[group.name] = true
			fail invalid("the group \"{group.name}\" has no arms") when group.arms.len() == 0
			let arms = map<string, bool>{}
			let total = 0
			for let arm in group.arms {
				fail invalid("the group \"{group.name}\" has an arm without a name") when arm.name == ""
				fail invalid("the group \"{group.name}\" has two arms named \"{arm.name}\"") when arms.hasKey(arm.name)
				fail invalid("the arm \"{arm.name}\" of the group \"{group.name}\" has a weight below 0") when arm.weight < 0
				arms[arm.name] = true
				total += arm.weight
				for let key in arm.values.keys() {
					fail invalid("the arm \"{arm.name}\" of the group \"{group.name}\" sets \"{key}\", which is not one of the group's keys") unless group.keys.hasKey(key)
				}
			}
			fail invalid("the weights of the group \"{group.name}\" add up to 0") when total == 0
			let bound = BoundGroup{group: group}
			for let rule in group.rules {
				let weighed = 0
				for let (arm, weight) in rule.weights {
					fail invalid("a rule of the group \"{group.name}\" weighs \"{arm}\", which is not one of its arms") unless arms.hasKey(arm)
					fail invalid("a rule of the group \"{group.name}\" gives \"{arm}\" a weight below 0") when weight < 0
					weighed += weight
				}
				fail invalid("the weights of a rule of the group \"{group.name}\" add up to 0") when rule.weights.len() > 0 && weighed == 0
				bound.rules.push(try boundRule(rule, matchers, "group \"{group.name}\""))
			}
			made.groups.push(bound)
		}
		return made
	}

	// A rule with its segments found among `matchers`; `owner` names the
	// feature or group in a failure.
	internal def boundRule(rule Rule, matchers map<string, Matcher>, owner string) !BoundRule {
		let buckets = bucketsOf(rule.rollout)
		fail invalid("the {owner} has a rule with a rollout of {rule.rollout}, outside 0 to 100") when buckets is none
		let bound = BoundRule{rule: rule, buckets: buckets}
		for let name in rule.segments {
			fail invalid("the {owner} has a rule on the segment \"{name}\", which does not exist") unless matchers.hasKey(name)
			bound.matchers.push(matchers[name])
		}
		return bound
	}

	// The segment made ready to test subjects. Fails as `compile` says.
	internal def matcherOf(segment Segment) !Matcher {
		let matcher = new Matcher()
		for let code in segment.countries {
			matcher.countries.push(code.trim().upper())
		}
		for let code in segment.regions {
			matcher.regions.push(code.trim().upper())
		}
		for let code in segment.continents {
			matcher.continents.push(code.trim().upper())
		}
		for let text in segment.networks {
			let block = net.parseIPBlock(text.trim())
			fail invalid("the segment \"{segment.name}\" has the network \"{text}\", which is not an address or a CIDR block") when block is none
			matcher.blocks.push(block)
		}
		matcher.versions = segment.versions.trim()
		fail invalid("the segment \"{segment.name}\" has the version range \"{segment.versions}\", which does not parse") unless matcher.versions == "" || semver.isRange(matcher.versions)
		for let name in segment.os {
			matcher.os.push(name.trim().lower())
		}
		for let locale in segment.locales {
			matcher.locales.push(locale.trim().lower().replace("_", "-"))
		}
		for let condition in segment.attributes {
			fail invalid("the segment \"{segment.name}\" has a condition without an attribute") when condition.attribute == ""
			let bound = BoundCondition{condition: condition}
			if condition.matches != "" {
				let pattern = new regex(condition.matches, "")
				fail invalid("the segment \"{segment.name}\" has the pattern \"{condition.matches}\", which is not a regular expression") unless pattern.valid()
				bound.pattern = pattern
			}
			matcher.conditions.push(bound)
		}
		return matcher
	}
}
