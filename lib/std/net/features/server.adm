partial module std.net.features {
	use (
		std.crypto::(Ed25519PrivateKey)
		std.data.encoding::(JSON)
		std.formats.data.mmdb
		std.net
		std.net.http
		std.services.logging::(Logging)
		std.time
	)

	// The server side: answers each subject with its signed assignments.
	//
	// ```
	// let server = new FeatureServer(new FileRules("/etc/features/rules.json"), key)
	// server.geo = try mmdb.open("/usr/share/GeoIP/GeoLite2-City.mmdb")
	// try server.serve(":8443")
	// ```
	//
	// The exchange is one POST with the JSON of a `Subject`, answered with
	// the JSON of `Assignments`. Mount `handler()` on a server of your own
	// to serve it beside other routes, or under TLS; `evaluate` decides
	// without HTTP.
	type FeatureServer {
		// Where the rules come from.
		rules    RuleSource
		// Signs every answer. Programs verify with its public half.
		key      Ed25519PrivateKey
		// Places a request in a country, a region and a continent: a
		// GeoIP2 or GeoLite2 City or Country database. Without one, rules
		// on those hold nobody and everything else works.
		geo      ?mmdb.Database    = none
		// The proxies in front of the server, as addresses and CIDR blocks.
		// `X-Forwarded-For` is believed only when the request comes from
		// one of them.
		proxies  string[]
		// How long a program waits before it asks again, and how long an
		// answer holds for a program that cannot ask.
		refresh  duration          = 1h
		validity duration          = 720h
		// The largest request body taken, in bytes.
		maxBody  int               = 65536

		internal announced bool         = false
		internal running   ?http.Server = none

		def new(rules RuleSource, key Ed25519PrivateKey) {
			self.rules = rules
			self.key = key
		}

		// The signed assignments of the subject, as seen from `seen`. When
		// the subject already holds them (`Subject.known`), the answer is
		// `unchanged` and carries only the new times.
		//
		// Fails when the rule source has no usable rules, and when a value
		// in the rules does not encode as JSON.
		def evaluate(subject Subject, seen Seen) !Assignments {
			let given = try decide(subject, seen)
			try sign(given, key)
			return given
		}

		// The assignments of `evaluate` before they are signed.
		internal def decide(subject Subject, seen Seen) !Assignments {
			let set = try rules.rules()
			let given = set.assign(subject, seen)
			let now = time.wallNs() / 1000000000
			given.issued = now
			given.refresh = int64(refresh) / 1000000000
			given.expires = now + int64(validity) / 1000000000
			let content = try digestOf(given)
			if subject.known != "" && subject.known == content {
				given.unchanged = true
				given.known = content
				given.features = map<string, Assignment>{}
				given.groups = map<string, GroupAssignment>{}
			}
			return given
		}

		// Where a request comes from: the peer's address, or, when the peer
		// is one of `proxies`, the nearest address in `forwarded`
		// (`X-Forwarded-For`, nearest proxy last) that is not a proxy; and
		// the place `geo` gives for it.
		def seen(peer string, forwarded string[] = []) Seen {
			let address = peer
			for let i = forwarded.len() - 1; i >= 0 && trusted(address); i-- {
				address = forwarded[i]
			}
			let from = Seen{address: address}
			let database = geo
			return from when database is none || address == ""
			let place = database.location(address) onerror recover none
			return from when place is none
			from.country = place.country.code
			from.continent = place.continent.code
			from.region = "{place.country.code}-{place.subdivisions[0].code}" when place.subdivisions.len() > 0 && place.country.code != ""
			return from
		}

		// Whether the address is one of `proxies`.
		internal def trusted(address string) bool {
			for let entry in proxies {
				let block = net.parseIPBlock(entry.trim())
				return true when !(block is none) && block.contains(address)
			}
			return false
		}

		// Says once that no database is loaded.
		internal def announce() {
			return when announced
			announced = true
			Logging.info("features: no location database is loaded; rules on countries, regions and continents hold nobody") when geo is none
		}

		// The handler of the exchange, to mount on an `http.Server` or a
		// `ServeMux`. It answers a POST with the subject's assignments,
		// 405 to another method, 400 to a body that is not the JSON of a
		// subject or has no `id`, 413 to a body over `maxBody`, and 500
		// when `evaluate` fails.
		def handler() http.Handler {
			announce()
			return http.maxBytesHandler(new http.HandlerFunc(def (ctx http.Context) !none {
				return try answer(ctx)
			}), maxBody)
		}

		internal def answer(ctx http.Context) !none {
			if ctx.method() != http.Method.POST {
				ctx.setHeader("Allow", "POST")
				return try ctx.error(405)
			}
			let body = try ctx.bytes()
			let subject = Subject{}
			let readable = true
			(new JSON()).decode(body, subject) onerror (err error) {
				readable = false
				recover none
			}
			return try ctx.error(400, "the body is not the JSON of a subject") unless readable
			return try ctx.error(400, "the subject has no id") when subject.id == ""
			let peer = ctx.request.remote
			let from = seen(peer is none ?? ("", peer.host), ctx.request.forwardedFor())
			let reply = try sign(try decide(subject, from), key)
			ctx.setHeader("Cache-Control", "no-store")
			return try ctx.blob(200, "application/json", reply)
		}

		// Serves the exchange alone on `address` (`":8080"`, over plain
		// HTTP: put TLS in front, or mount `handler()` on a server with
		// TLS settings) until `close`. Fails when the address cannot be
		// bound or the policy denies listening there.
		def serve(address string) !none {
			let server = new http.Server(address, handler())
			running = server
			return try server.listenAndServe()
		}

		// Stops `serve`, letting requests in flight end. Does nothing when
		// it is not serving. Fails when the server cannot shut down in
		// time.
		def close() !none {
			let server = running
			return none when server is none
			running = none
			return try server.shutdown()
		}
	}
}
