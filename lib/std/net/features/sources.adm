partial module std.net.features {
	use (
		std.data.encoding::(JSON)
		std.os
		std.services.logging::(Logging)
		std.time
	)

	// Where a server takes its rules from. `MemoryRules` and `FileRules` are
	// the ones this module has; a database or a control plane is another
	// implementation.
	interface RuleSource {
		// The rules to decide with now. Called for every request, so an
		// implementation keeps the `RuleSet` it compiled and gives it again
		// until the rules change. Fails when there are no usable rules.
		def rules() !RuleSet
	}

	// Rules held in memory, for a server whose rules are written in code
	// and for tests.
	type MemoryRules {
		internal held RuleSet

		def new(rules RuleSet) {
			held = rules
		}

		// Rules implements RuleSource. Does not fail.
		atomic def rules() !RuleSet {
			return held
		}

		// Replaces the rules: requests answered from now on are decided
		// with them.
		atomic def replace(rules RuleSet) {
			held = rules
		}
	}

	// Rules read from a JSON file (the JSON of `Rules`) and read again
	// whenever the file changes, so an operator edits the file and the
	// server follows without a restart.
	//
	// A changed file that does not read or does not compile is logged as a
	// warning and left aside: the server goes on with the last rules that
	// were good, and tries the file again when it changes once more.
	type FileRules {
		// How long a look at the file answers for: the file is checked for
		// a change at most this often.
		recheck duration = 1s

		internal path   string
		internal held   ?RuleSet = none
		// The file's modification time and size when it was last read, and
		// the monotonic time it was last looked at.
		internal stamp  int64
		internal size   int64    = -1
		internal looked int64

		// path is the rules file. It is read at the first request.
		def new(path string) {
			self.path = path
		}

		// Rules implements RuleSource: the rules of the file as it is now,
		// looked at once per `recheck` at most.
		//
		// Fails with a FeaturesError of kind `Rules` while no version of
		// the file has ever been good: it cannot be read, is not the JSON
		// of `Rules`, or does not compile.
		atomic def rules() !RuleSet {
			let now = time.monoNs()
			let current = held
			return current when !(current is none) && now - looked < int64(recheck)
			looked = now
			let info = os.stat(path, true) onerror (err error) {
				return current unless current is none
				fail FeaturesError{message: "features: the rules file {path} cannot be read: {err.message}", kind: FeaturesErrorKind.Rules, cause: err}
			}
			let changed = info.modTime.unixNs()
			return current when !(current is none) && changed == stamp && info.size == size
			stamp = changed
			size = info.size
			let loaded = load() onerror (err error) {
				if !(current is none) {
					Logging.warning("features: the changed rules file is left aside: {err.message}", {"path": path})
					return current
				}
				fail err
			}
			held = loaded
			return loaded
		}

		// Reads and compiles the file.
		internal def load() !RuleSet {
			let text = os.readFile(path) onerror (err error) {
				fail FeaturesError{message: "features: the rules file {path} cannot be read: {err.message}", kind: FeaturesErrorKind.Rules, cause: err}
			}
			let read = Rules{}
			(new JSON()).decode(text, read) onerror (err error) {
				fail FeaturesError{message: "features: the rules file {path} is not the JSON of rules: {err.message}", kind: FeaturesErrorKind.Rules, cause: err}
			}
			return try compile(read)
		}
	}
}
