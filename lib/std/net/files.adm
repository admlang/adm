partial module std.net {
	use (
		std.fs
		std.io
	)

	// RemoteFiles is a `fs.FileStore` on another machine, reached through
	// a file transfer client (`ftp.Client`, `sftp.Client`), plus copies
	// between it and the local disk. Code written against it runs over
	// either protocol.
	interface RemoteFiles {
		fs.FileStore
		io.Closer
		// Copies a remote file to a local path; a remote directory is
		// copied with everything under it.
		// Fails when the remote path is missing or a local write fails.
		def download(remote string, local string) !none
		// Copies a local file to a remote path; a local directory is
		// copied with everything under it.
		// Fails when the local path is missing or a remote write fails.
		def upload(local string, remote string) !none
	}
}
