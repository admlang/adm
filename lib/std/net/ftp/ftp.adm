partial module std.net.ftp {
	use (
		std.fs
		std.errors
		std.net
	)

	// Security picks how a connection is protected.
	enum Security {
		// No TLS; passwords and files cross the network in the clear.
		Plain    = "plain",
		// FTPS with `AUTH TLS` on the ordinary port (21): the connection
		// starts plain and upgrades before login (RFC 4217).
		Explicit = "explicit",
		// FTPS with TLS from the first byte, on port 990.
		Implicit = "implicit",
	}

	// Mode picks who opens the data connection of a transfer.
	enum Mode {
		// The client connects to a port the server opens (EPSV, PASV).
		// Works through NAT and firewalls on the client side.
		Passive = "passive",
		// The server connects to a port the client opens (EPRT, PORT).
		Active  = "active",
	}

	// DataType is how a file crosses the data connection (RFC 959 §3.1.1).
	enum DataType {
		// Byte for byte (TYPE I): what every file but plain text wants.
		Binary = "binary",
		// As text (TYPE A): lines end in CRLF on the wire and in LF on
		// either side's disk.
		Ascii  = "ascii",
	}

	// FtpError is the payload of a failure the server reported: the
	// three-digit reply code (`550` for a missing file, `530` for a
	// refused login) and the reply text. `code` repeats the reply code as
	// text, so a handler that only reads `error` still sees it.
	struct FtpError {
		message string
		code    string
		cause   ?error
		stack   errors.StackTrace
		// The reply code, 0 when the failure is not a server reply (a
		// reply that does not parse).
		reply   int
		// The text of the reply, its lines joined by newlines.
		text    string
	}

	// Account is what a login grants: the files the user sees, rooted at
	// `/`, and whether they may only read them.
	struct Account {
		store    fs.FileStore
		readOnly bool         = false
	}

	// Authenticator decides the logins of a `Server`.
	interface Authenticator {
		// The account of a user. Fails when the user or the password is
		// wrong; the client is told `530`, not why.
		def login(user string, password Secret<string>) !Account
	}

	// Users is an `Authenticator` over a fixed list of users, each with
	// a password and an account.
	//
	// ```
	// let users = new ftp.Users()
	// users.add("alice", "s3cret", new net.DiskStore("/srv/alice"))
	// users.add("guest", "guest", new net.DiskStore("/srv/pub"), readOnly = true)
	// server.authenticator = users
	// ```
	type Users {
		internal passwords map<string, Secret<string>>
		internal accounts  map<string, Account>

		def new() {}

		// Adds a user, replacing one of the same name.
		atomic def add(user string, password Secret<string>, store fs.FileStore, readOnly bool = false) {
			passwords[user] = password
			accounts[user] = Account{store: store, readOnly: readOnly}
		}

		// Removes a user; an unknown name does nothing.
		atomic def remove(user string) {
			passwords.delete(user)
			accounts.delete(user)
		}

		// Implements Authenticator. Fails when the user is unknown or the
		// password does not match.
		atomic def login(user string, password Secret<string>) !Account {
			let want = passwords.get(user)
			let account = accounts.get(user)
			fail "login refused" when want is none
			fail "login refused" when account is none
			fail "login refused" unless sameText(want.reveal(), password.reveal())
			return account
		}
	}

	// sameText compares two strings in time that depends on their
	// lengths only, not on where they differ.
	internal def sameText(a string, b string) bool {
		let x = a.bytes()
		let y = b.bytes()
		return false when x.len() != y.len()
		let diff = 0
		for let i = 0; i < x.len(); i++ {
			diff = diff | (int(x[i]) ^ int(y[i]))
		}
		return diff == 0
	}
}
