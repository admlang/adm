partial module std.net.ftp {
	use (
		std.crypto.x509::(CertPool)
		std.fs
		std.io
		std.metrics::(Counter, Gauge, Histogram)
		std.net
		std.net.ftp.proto::*
		std.net.tls
		std.os
		std.services::(Diagnostics)
		std.testing
		std.time
	)

	// A self-signed P-256 certificate for 127.0.0.1, localhost and
	// example.com, valid for a century (the one httptest presents).
	internal const ftpCertPEM =
		"-----BEGIN CERTIFICATE-----\n" +
		"MIIByzCCAXCgAwIBAgIULZ61fkBLJqpHXo7Dg3TjjURKNKQwCgYIKoZIzj0EAwIw\n" +
		"EzERMA8GA1UEAwwIQURNIHRlc3QwIBcNMjYwOTE2MjEyNDQ4WhgPMjEyNjA4MjMy\n" +
		"MTI0NDhaMBMxETAPBgNVBAMMCEFETSB0ZXN0MFkwEwYHKoZIzj0CAQYIKoZIzj0D\n" +
		"AQcDQgAEWmnKIPFi8/hNfbTouWeJ0sX7jXIK0H2BdAa3ZlChTQUtkRXRuGnkYmY9\n" +
		"c9D2sLIU0D8YtBwSi1XCEXkyARGL3KOBnzCBnDAdBgNVHQ4EFgQUdGEQb1u97o8W\n" +
		"5FkheQ27r3JNU3AwHwYDVR0jBBgwFoAUdGEQb1u97o8W5FkheQ27r3JNU3AwDwYD\n" +
		"VR0TAQH/BAUwAwEB/zAnBgNVHREEIDAegglsb2NhbGhvc3SCC2V4YW1wbGUuY29t\n" +
		"hwR/AAABMAsGA1UdDwQEAwIHgDATBgNVHSUEDDAKBggrBgEFBQcDATAKBggqhkjO\n" +
		"PQQDAgNJADBGAiEA6p+D8so1nzo4nOkB8z0x1Tq+9iG1qIweVo/zTnSHG9cCIQDo\n" +
		"ANw/RkMk5iyYvJf8Qx75u8fY/n2s26d6Clj96iuH/g==\n" +
		"-----END CERTIFICATE-----\n"

	internal const ftpKeyPEM =
		"-----BEGIN PRIVATE KEY-----\n" +
		"MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgz6zLOlG3plulCC6J\n" +
		"73w4HvDFzW9lrGWy0U1PuM2M1gWhRANCAARaacog8WLz+E19tOi5Z4nSxfuNcgrQ\n" +
		"fYF0BrdmUKFNBS2RFdG4aeRiZj1z0PawshTQPxi0HBKLVcIReTIBEYvc\n" +
		"-----END PRIVATE KEY-----\n"

	// startServer serves a fresh memory store on an ephemeral loopback
	// port: `alice`/`s3cret` may write, anonymous logins may read.
	internal def startServer(security Security = Security.Plain) !Server {
		let files = new fs.MemoryStore()
		let users = new Users()
		users.add("alice", "s3cret", files)
		users.add("anonymous", "", files, readOnly = true)
		let server = new Server(files, "127.0.0.1:0")
		server.authenticator = users
		server.security = security
		server.banner = "Welcome to the test server\nNo lurking"
		server.welcome = "Hello alice"
		server.timeout = 5s
		let pair = try tls.parseKeyPair(ftpCertPEM, ftpKeyPEM)
		server.tls = tls.Config{certificates: [pair]}
		try server.start()
		return server
	}

	// connectTo connects and logs in as alice.
	internal def connectTo(server Server, security Security = Security.Plain, mode Mode = Mode.Passive) !Client {
		let client = new Client(security, mode, 5s)
		let pool = new CertPool()
		pool.appendCertsFromPEM(ftpCertPEM)
		client.tls = tls.Config{serverName: "localhost", rootCAs: pool}
		try client.connect(server.address().str())
		try client.login("alice", "s3cret")
		return client
	}

	// readAll reads a download to its end and closes it.
	internal def readAll(r io.ReadCloser) !string {
		let out byte[] = []
		let buf byte[] = []
		buf.len(1024)
		for {
			let n = try r.read(buf)
			break when n == 0
			out = out + buf[:n]
		}
		try r.close()
		return string(out)
	}

	// replyCodeOf runs fn and returns the FTP reply code it failed with, 0
	// when it succeeded and -1 when it failed some other way.
	internal def replyCodeOf(fn def () !none) int {
		let code = 0
		fn() onerror (err error) {
			code = -1
			code = err.reply when err is FtpError
			recover none
		}
		return code
	}

	// roundTrip runs the file operations a session needs, over any
	// security and mode.
	internal def roundTrip(client Client) !none {
		try client.makeDir("/docs")
		try client.upload("hello, ftp".bytes(), "/docs/hello.txt")
		let source = new ByteSource("streamed body".bytes())
		try client.upload(source, "/docs/stream.txt")
		let entries = try client.list("/docs")
		assert entries.len() == 2
		assert entries[0].name == "hello.txt" && entries[0].size == 10
		assert entries[0].path == "/docs/hello.txt"
		assert entries[1].name == "stream.txt"
		assert (try readAll(try client.download("/docs/hello.txt"))) == "hello, ftp"
		assert (try readAll(try client.download("/docs/hello.txt", int64(7)))) == "ftp"
		let appender = try client.create("/docs/hello.txt", true)
		try appender.write("!".bytes())
		try appender.close()
		assert (try readAll(try client.download("/docs/hello.txt"))) == "hello, ftp!"
		return none
	}

	// ByteSource is a reader over bytes.
	internal type ByteSource {
		data byte[]
		pos  int    = 0

		def new(data byte[]) {
			self.data = data
		}

		def read(buf byte[]) !int {
			return 0 when pos >= data.len()
			let n = data[pos:].copy(buf)
			pos += n
			return n
		}
	}

	check "FTP" {
		@test()
		def plainSession() !none {
			let server = try startServer()
			let client = try connectTo(server)
			assert client.banner() == "Welcome to the test server\nNo lurking"
			assert client.welcome() == "Hello alice"
			assert client.hasFeature("mlst") && client.hasFeature("EPSV")
			assert (try client.currentDir()) == "/"
			try roundTrip(client)

			let entry = try client.stat("/docs/hello.txt")
			assert entry.kind == fs.FileKind.File && entry.size == 11 && entry.name == "hello.txt"
			assert entry.modified.year() >= 2026
			assert (try client.stat("/docs")).kind == fs.FileKind.Dir

			try client.changeDir("docs")
			assert (try client.currentDir()) == "/docs"
			try client.rename("stream.txt", "renamed.txt")
			assert (try client.list()).len() == 2
			try client.remove("renamed.txt")
			try client.remove("/docs/hello.txt")
			try client.changeDir("..")
			try client.removeDir("docs")
			assert (try client.list("/")).len() == 0

			assert replyCodeOf(def () !none { return client.remove("/missing") }) == 550
			assert replyCodeOf(def () !none { return client.changeDir("/missing") }) == 550
			assert replyCodeOf(def () !none {
				try client.download("/missing")
				return none
			}) == 550
			// The client still works after the refusals.
			assert (try client.list("/")).len() == 0

			try client.close()
			assert !client.isOpen()
			try client.close()
			try server.close()
			return none
		}

		@test()
		def activeMode() !none {
			let server = try startServer()
			let client = try connectTo(server, Security.Plain, Mode.Active)
			try roundTrip(client)
			try client.close()
			try server.close()
			return none
		}

		@test()
		def explicitTLS() !none {
			let server = try startServer(Security.Explicit)
			let client = try connectTo(server, Security.Explicit)
			assert client.hasFeature("AUTH")
			try roundTrip(client)
			try client.close()

			// Logins wait for AUTH TLS.
			let plain = new Client(Security.Plain, Mode.Passive, 5s)
			try plain.connect(server.address().str())
			assert replyCodeOf(def () !none { return plain.login("alice", "s3cret") }) == 530
			try plain.close()
			try server.close()
			return none
		}

		@test()
		def implicitTLS() !none {
			let server = try startServer(Security.Implicit)
			let client = try connectTo(server, Security.Implicit)
			assert client.banner().startsWith("Welcome")
			try roundTrip(client)
			try client.close()
			try server.close()
			return none
		}

		@test()
		def loginsAndPermissions() !none {
			let server = try startServer()
			let client = try connectTo(server)
			try client.upload("public".bytes(), "/readme.txt")
			try client.close()

			let bad = new Client(Security.Plain, Mode.Passive, 5s)
			try bad.connect(server.address().str())
			assert replyCodeOf(def () !none { return bad.login("alice", "wrong") }) == 530
			assert replyCodeOf(def () !none {
				try bad.list("/")
				return none
			}) == 530
			try bad.close()

			let guest = new Client(Security.Plain, Mode.Passive, 5s)
			try guest.connect(server.address().str())
			try guest.login()
			assert (try readAll(try guest.download("/readme.txt"))) == "public"
			assert replyCodeOf(def () !none { return guest.upload("x".bytes(), "/x.txt") }) == 550
			assert replyCodeOf(def () !none { return guest.remove("/readme.txt") }) == 550
			assert replyCodeOf(def () !none { return guest.makeDir("/d") }) == 550
			try guest.close()
			try server.close()
			return none
		}

		@test()
		def recursiveTransfers() !none {
			let dir = "/tmp/adm-ftp-{time.now().unixNs()}"
			try os.mkdir(dir)
			try os.mkdir(dir + "/site")
			try os.mkdir(dir + "/site/img")
			try os.writeFile(dir + "/site/index.html", "<h1>hi</h1>".bytes())
			try os.writeFile(dir + "/site/img/logo.svg", "<svg/>".bytes())

			let server = try startServer()
			let client = try connectTo(server)
			try client.upload(dir + "/site", "/site")
			assert (try client.list("/site")).len() == 2
			assert (try readAll(try client.download("/site/img/logo.svg"))) == "<svg/>"

			try client.download("/site", dir + "/copy")
			assert string(try os.readFile(dir + "/copy/index.html")) == "<h1>hi</h1>"
			assert string(try os.readFile(dir + "/copy/img/logo.svg")) == "<svg/>"
			try client.download("/site/index.html", dir + "/one.html")
			assert string(try os.readFile(dir + "/one.html")) == "<h1>hi</h1>"

			// A client is a net.RemoteFiles.
			let remote net.RemoteFiles = client
			try remote.close()
			try server.close()

			for let f in ["/copy/img/logo.svg", "/copy/index.html", "/one.html", "/site/img/logo.svg", "/site/index.html"] {
				try os.remove(dir + f)
			}
			for let d in ["/copy/img", "/copy", "/site/img", "/site", ""] {
				try os.rmdir(dir + d)
			}
			return none
		}

		@test()
		def serverOverDisk() !none {
			let dir = "/tmp/adm-ftp-disk-{time.now().unixNs()}"
			try os.mkdir(dir)
			let users = new Users()
			users.add("bob", "pw", new fs.DiskStore(dir))
			let server = new Server(new fs.MemoryStore(), "127.0.0.1:0")
			server.authenticator = users
			try server.start()
			let client = new Client(Security.Plain, Mode.Passive, 5s)
			try client.connect(server.address().str())
			try client.login("bob", "pw")
			try client.upload("on disk".bytes(), "/../../escape.txt")
			assert string(try os.readFile(dir + "/escape.txt")) == "on disk"
			try client.close()
			try server.close()
			try os.remove(dir + "/escape.txt")
			try os.rmdir(dir)
			return none
		}

		@test()
		def serverMetrics() !none {
			let bytesIn = try Diagnostics.register<Counter>("net.ftp.server.bytes.in")
			let bytesOut = try Diagnostics.register<Counter>("net.ftp.server.bytes.out")
			let transfers = try Diagnostics.register<Counter>("net.ftp.server.transfers.total")
			let failed = try Diagnostics.register<Counter>("net.ftp.server.transfers.failed")
			let speed = try Diagnostics.register<Histogram>("net.ftp.server.transfer.speed")
			let logins = try Diagnostics.register<Counter>("net.ftp.server.logins.total")
			let loginFailures = try Diagnostics.register<Counter>("net.ftp.server.logins.failed")
			let connections = try Diagnostics.register<Counter>("net.ftp.server.connections.total")
			let open = try Diagnostics.register<Gauge>("net.ftp.server.connections.open")
			let inBefore = bytesIn.value()
			let outBefore = bytesOut.value()
			let transfersBefore = transfers.value()
			let failedBefore = failed.value()
			let samplesBefore = speed.value().count
			let loginsBefore = logins.value()
			let loginFailuresBefore = loginFailures.value()
			let connectionsBefore = connections.value()
			let openBefore = open.value()

			let server = try startServer()
			let client = try connectTo(server)
			assert open.value() == openBefore + 1.0
			try client.upload("0123456789".bytes(), "/ten.txt")
			assert (try readAll(try client.download("/ten.txt"))) == "0123456789"
			assert (try readAll(try client.download("/ten.txt", int64(4)))) == "456789"
			try client.close()

			let bad = new Client(Security.Plain, Mode.Passive, 5s)
			try bad.connect(server.address().str())
			bad.login("alice", "wrong") onerror recover none
			try bad.close()
			try server.close()

			assert bytesIn.value() - inBefore == 10
			assert bytesOut.value() - outBefore == 16
			assert transfers.value() - transfersBefore == 3
			assert failed.value() == failedBefore
			assert speed.value().count >= samplesBefore
			assert speed.value().max > 0.0
			assert logins.value() - loginsBefore == 1
			assert loginFailures.value() - loginFailuresBefore == 1
			assert connections.value() - connectionsBefore == 2
			// Sessions leave the count as their tasks end.
			for let i = 0; i < 100 && open.value() > openBefore; i++ {
				time.sleep(10ms)
			}
			assert open.value() == openBefore
			return none
		}

		@test()
		def notConnectedFails() {
			let client = new Client()
			assert !client.isOpen()
			assert replyCodeOf(def () !none { return client.makeDir("/x") }) == -1
		}

		@test()
		def listingsParse() !none {
			let unix = parseListLine("-rw-r--r--   1 ftp  ftp      1234 Jan  5  2024 my file.txt", "/pub")
			fail "unix line did not parse" when unix is none
			assert unix.name == "my file.txt" && unix.path == "/pub/my file.txt"
			assert unix.size == 1234 && unix.kind == fs.FileKind.File
			assert unix.modified.year() == 2024 && unix.modified.month() == 1 && unix.modified.day() == 5

			let dir = parseListLine("drwxr-xr-x 2 ftp ftp 4096 Mar 3 10:15 photos", "")
			fail "dir line did not parse" when dir is none
			assert dir.kind == fs.FileKind.Dir && dir.path == "photos"
			assert dir.modified.hour() == 10 && dir.modified.minute() == 15

			let link = parseListLine("lrwxrwxrwx 1 ftp ftp 7 Mar 3 10:15 latest -> v2.tar", "/")
			fail "link line did not parse" when link is none
			assert link.kind == fs.FileKind.Link && link.name == "latest"

			let dos = parseListLine("01-31-26  09:15PM       <DIR>          Old Stuff", "/")
			fail "dos line did not parse" when dos is none
			assert dos.kind == fs.FileKind.Dir && dos.name == "Old Stuff"
			assert parseListLine("total 12", "/") is none
			assert parseListLine("drwxr-xr-x 2 ftp ftp 4096 Mar 3 10:15 ..", "/") is none

			let facts = parseFacts("type=file;size=42;modify=20260928120030; notes.txt", "/d")
			fail "facts did not parse" when facts is none
			assert facts.size == 42 && facts.path == "/d/notes.txt"
			assert formatTime(facts.modified) == "20260928120030"
			assert parseFacts("type=cdir;modify=20260928120030; .", "/d") is none

			assert (try parseEpsv("Entering Extended Passive Mode (|||50123|)")) == 50123
			assert (try parsePasv("Entering Passive Mode (127,0,0,1,195,80)")) == 50000
			let (host, port) = try parseEprt("|1|10.0.0.2|6000|")
			assert host == "10.0.0.2" && port == 6000
			let (h2, p2) = try parseHostPort("10,0,0,2,23,112")
			assert h2 == "10.0.0.2" && p2 == 6000
			return none
		}
	}
}
