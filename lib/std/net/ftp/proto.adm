internal partial module std.net.ftp.proto {
	use (
		std.fs
		std.net
		std.net.ftp::*
		std.net.tls
		std.os
		std.time
		std.time::(Time)
	)

	// The longest command or reply line accepted.
	const maxLine = 8192

	// A read timeout that waits without end: the runtime's poll takes a
	// negative wait as none. Control connections are read with it where a
	// timeout would cut a TLS record in half.
	const waitForever = duration(-1)

	// Reply is one server reply: its code and its lines, the code and the
	// separator stripped.
	struct Reply {
		code  int
		lines string[]
	}

	// replyText is a reply's lines joined by newlines.
	def replyText(reply Reply) string {
		return reply.lines.join("\n")
	}

	// replyError is the FtpError of an unexpected reply to `op`.
	def replyError(op string, reply Reply) FtpError {
		let text = replyText(reply)
		return FtpError{message: "{op}: {reply.code} {text}", code: "{reply.code}", reply: reply.code, text: text}
	}

	// protocolError is the FtpError of a reply that breaks the protocol.
	def protocolError(op string, message string) FtpError {
		return FtpError{message: "{op}: {message}", code: "0", reply: 0, text: message}
	}

	// writeFully writes all of data to a stream. Fails when a write does
	// or moves nothing.
	def writeFully(stream net.Stream, data byte[], timeout duration) !none {
		let off = 0
		for off < data.len() {
			let n = try stream.write(data[off:], timeout)
			fail net.errorOf(net.ErrorCode.Pipe, "write", "", "wrote nothing") when n <= 0
			off += n
		}
		return none
	}

	// LineReader reads CRLF-terminated lines from a stream.
	type LineReader {
		stream  net.Stream
		pending byte[]

		def new(stream net.Stream) {
			self.stream = stream
		}

		// readLine is the next line without its line ending, waiting up to
		// `timeout` for each read. Fails when the stream ends first, a read
		// fails, or the line is longer than 8 KiB.
		def readLine(timeout duration) !string {
			let scanned = 0
			for {
				for let i = scanned; i < pending.len(); i++ {
					if pending[i] == byte(10) {
						let end = i
						end-- when end > 0 && pending[end - 1] == byte(13)
						let line = string(withoutTelnetCommands(pending[:end]))
						pending = pending[i + 1:].clone()
						return line
					}
				}
				scanned = pending.len()
				fail protocolError("read", "line longer than {maxLine} bytes") when pending.len() > maxLine
				let buf byte[] = []
				buf.len(4096)
				let n = try stream.read(buf, timeout)
				fail net.errorOf(net.ErrorCode.Closed, "read", "", "connection closed") when n == 0
				pending = pending + buf[:n]
			}
			fail "unreachable"
		}
	}

	// withoutTelnetCommands drops the Telnet commands (IAC and the byte
	// after it) a client may put in a command line, as the Interrupt
	// Process and Synch sent before ABOR (RFC 959 §4.1.3); an escaped
	// IAC IAC stays one 255 byte.
	def withoutTelnetCommands(line byte[]) byte[] {
		let out byte[] = []
		let i = 0
		for i < line.len() {
			let b = line[i]
			if b == byte(255) && i + 1 < line.len() {
				out.push(byte(255)) when line[i + 1] == byte(255)
				i += 2
				continue
			}
			out.push(b)
			i++
		}
		return out
	}

	// LineEndings converts a file between the local form, lines ending in
	// LF, and the ASCII form FTP sends in TYPE A, lines ending in CRLF
	// (RFC 959 §3.1.1.1). It keeps the state a CR at the end of one chunk
	// leaves for the next.
	type LineEndings {
		lastCR    bool = false
		pendingCR bool = false

		def new() {}

		// toWire is a local chunk in the ASCII form: an LF not already after
		// a CR gets one.
		def toWire(chunk byte[]) byte[] {
			let out byte[] = []
			for let b in chunk {
				out.push(byte(13)) when b == byte(10) && !lastCR
				out.push(b)
				lastCR = b == byte(13)
			}
			return out
		}

		// fromWire is an ASCII-form chunk in the local form: CRLF becomes LF,
		// a CR followed by anything else stays.
		def fromWire(chunk byte[]) byte[] {
			let out byte[] = []
			for let b in chunk {
				if pendingCR {
					pendingCR = false
					out.push(byte(13)) unless b == byte(10)
				}
				if b == byte(13) {
					pendingCR = true
					continue
				}
				out.push(b)
			}
			return out
		}

		// flush is what fromWire still holds at the end of the stream: a
		// trailing CR.
		def flush() byte[] {
			return [] unless pendingCR
			pendingCR = false
			return [byte(13)]
		}
	}

	// wireLength is how many bytes a local chunk takes in the ASCII form,
	// `lastCR` telling whether the byte before it was a CR.
	def wireLength(chunk byte[], lastCR bool) int64 {
		let n int64 = 0
		let cr = lastCR
		for let b in chunk {
			n++ when b == byte(10) && !cr
			n++
			cr = b == byte(13)
		}
		return n
	}

	// ControlLine is one command the session's reader took off the control
	// connection, or the failure that ended its reading.
	type ControlLine {
		line    string
		failure ?error = none

		def new(line string, failure ?error = none) {
			self.line = line
			self.failure = failure
		}
	}

	// verbOf is a command line's verb, upper-cased, and its argument.
	def verbOf(line string) (string, string) {
		let space = line.indexOf(" ")
		return (line.upper(), "") when space < 0
		return (line[:space].upper(), line[space + 1:])
	}

	// Control is the client side of the control connection: commands out,
	// replies in.
	type Control {
		socket      net.Connection
		stream      net.Stream
		lines       LineReader
		timeout     duration
		tlsConfig   tls.Config
		// The data connections carry TLS (PROT P).
		protected   bool                = false
		// A transfer is running: its reply is still to come.
		busy        bool                = false
		host        string
		features    map<string, string>
		// The TYPE in effect: "I" or "A", "" before the first.
		currentType string              = ""

		def new(socket net.Connection, timeout duration, host string) {
			self.socket = socket
			stream = socket
			lines = new LineReader(socket)
			self.timeout = timeout
			self.host = host
		}

		// upgrade runs the TLS client handshake over the control
		// connection; the replies read later come through TLS.
		def upgrade(config tls.Config) !none {
			let conn = tls.client(socket, config)
			try conn.handshake(timeout)
			stream = conn
			lines = new LineReader(conn)
			return none
		}

		// readReply reads one reply, multi-line ones included.
		// Fails when the connection fails or the reply does not parse.
		def readReply() !Reply {
			let first = try lines.readLine(timeout)
			fail protocolError("reply", "malformed reply {first.truncate(64)}") unless isReplyLine(first)
			let code = first[:3].toInt<int>()
			let out string[] = [first[4:]]
			return Reply{code: code, lines: out} unless first[3] == '-'
			let closing = first[:3] + " "
			for {
				let line = try lines.readLine(timeout)
				if line.startsWith(closing) {
					out.push(line[4:])
					break
				}
				out.push(line.trimPrefix(" "))
			}
			return Reply{code: code, lines: out}
		}

		// send writes one command line. A password argument is written but
		// never logged anywhere. Fails when the write does.
		def send(line string) !none {
			fail protocolError("command", "a transfer is still running") when busy
			fail protocolError("command", "line breaks in a command") when line.contains("\r") || line.contains("\n")
			return writeFully(stream, (line + "\r\n").bytes(), timeout)
		}

		// command sends a command and reads its reply.
		// Fails as send and readReply do.
		def command(line string) !Reply {
			try send(line)
			return try readReply()
		}

		// expect sends a command and fails unless the reply's first digit
		// is `class` (2 for success, 3 for more to come).
		// Fails with FtpError carrying the reply otherwise.
		def expect(op string, line string, class int) !Reply {
			let reply = try command(line)
			fail replyError(op, reply) unless reply.code / 100 == class
			return reply
		}

		def hasFeature(name string) bool {
			return features.hasKey(name)
		}

		// useType sends TYPE when the representation differs from the one
		// in effect: "I" (binary) or "A" (ASCII). Fails with FtpError when
		// the server refuses it.
		def useType(wanted string) !none {
			return none when currentType == wanted
			try expect("TYPE", "TYPE {wanted}", 2)
			currentType = wanted
			return none
		}

		// abortTransfer stops the transfer running (RFC 959 ABOR): the
		// data connection is already closed; the server answers the
		// transfer (426 when it cut it short, 226 when it had finished)
		// and then the ABOR itself.
		// Fails with FtpError when the server refuses the ABOR.
		def abortTransfer() !none {
			busy = false
			try send("ABOR")
			try readReply()
			let answer = try readReply()
			fail replyError("ABOR", answer) unless answer.code / 100 == 2
			return none
		}

		// endTransfer reads the reply that closes a transfer. With
		// `early` the reader stopped before the end, and the server's
		// "transfer aborted" is expected too.
		// Fails with FtpError when the server reports the transfer failed.
		def endTransfer(op string, early bool) !none {
			busy = false
			let reply = try readReply()
			return none when reply.code / 100 == 2
			return none when early && reply.code / 100 == 4
			fail replyError(op, reply)
		}
	}

	// isReplyLine reports whether a line starts with three digits and a
	// space or a dash.
	def isReplyLine(line string) bool {
		return false when line.len() < 4
		for let i = 0; i < 3; i++ {
			return false unless line[i] >= '0' && line[i] <= '9'
		}
		return line[3] == ' ' || line[3] == '-'
	}

	// TransferReader reads a download's data connection, back from the
	// ASCII form when the transfer runs under TYPE A, and reads the
	// transfer's closing reply on close. Closed before the end, it aborts
	// the transfer (ABOR).
	type TransferReader {
		data    net.Stream
		control Control
		op      string
		endings ?LineEndings = none
		spare   byte[]
		ended   bool         = false
		closed  bool         = false

		def new(data net.Stream, control Control, op string, ascii bool = false) {
			self.data = data
			self.control = control
			self.op = op
			endings = new LineEndings() when ascii
		}

		// Implements std.io.Reader; 0 at the end of the file.
		// Fails when the data connection does.
		def read(buf byte[]) !int {
			fail protocolError(op, "reader is closed") when closed
			return 0 when buf.len() == 0
			let conv = endings
			if conv is none {
				return 0 when ended
				let n = try data.read(buf, control.timeout)
				ended = true when n == 0
				return n
			}
			for spare.len() == 0 && !ended {
				let chunk byte[] = []
				chunk.len(buf.len())
				let n = try data.read(chunk, control.timeout)
				if n == 0 {
					ended = true
					spare = conv.flush()
				} else {
					spare = conv.fromWire(chunk[:n])
				}
			}
			let n = spare.copy(buf)
			spare = spare[n:].clone()
			return n
		}

		// Implements std.io.Closer: closes the data connection and reads
		// the server's reply; closed before the end of the file, it aborts
		// the transfer with ABOR. Fails when the server reports the
		// transfer failed.
		def close() !none {
			return none when closed
			closed = true
			data.close() onerror recover none
			return try control.abortTransfer() unless ended
			return try control.endTransfer(op, false)
		}
	}

	// TransferWriter writes an upload's data connection, in the ASCII form
	// when the transfer runs under TYPE A, and reads the transfer's
	// closing reply on close.
	type TransferWriter {
		data    net.Stream
		control Control
		op      string
		endings ?LineEndings = none
		closed  bool         = false

		def new(data net.Stream, control Control, op string, ascii bool = false) {
			self.data = data
			self.control = control
			self.op = op
			endings = new LineEndings() when ascii
		}

		// Implements std.io.Writer. Fails when the data connection does.
		def write(buf byte[]) !int {
			fail protocolError(op, "writer is closed") when closed
			let conv = endings
			let wire = conv is none ?? (buf, conv.toWire(buf))
			try writeFully(data, wire, control.timeout)
			return buf.len()
		}

		// Implements std.io.Closer: ends the file and reads the server's
		// reply. Fails when the server reports the transfer failed.
		def close() !none {
			return none when closed
			closed = true
			let failure ?error = none
			data.close() onerror (err error) {
				failure = err
				recover none
			}
			try control.endTransfer(op, false)
			fail failure unless failure is none
			return none
		}

		// Implements std.io.Aborter: abandons the upload with ABOR while
		// the data connection is still open, so the server knows the file
		// is incomplete and discards it, then closes the connection.
		// Fails with FtpError when the server refuses the ABOR.
		def abort() !none {
			return none when closed
			closed = true
			let failure ?error = none
			control.abortTransfer() onerror (err error) {
				failure = err
				recover none
			}
			data.close() onerror recover none
			fail failure unless failure is none
			return none
		}
	}

	// Deadline is a flag a watchdog task reads: set, the wait it guards
	// is over and the watchdog leaves the listener alone.
	type Deadline {
		atomic done bool = false

		def new() {}
	}

	// closeAfter closes the listener unless the deadline is done within
	// `timeout`, which ends an accept that waits on it.
	def closeAfter(ln net.Listener, deadline Deadline, timeout duration) {
		let limit = time.now() + timeout
		for !deadline.done {
			if time.now().after(limit) {
				ln.close() onerror recover none
				return
			}
			time.sleep(10ms)
		}
	}

	// acceptWithin accepts one connection, waiting up to `timeout`, and
	// closes the listener. Fails with NetError when nothing connects in
	// time or the accept fails.
	def acceptWithin(ln net.Listener, timeout duration) !net.Connection {
		let deadline = new Deadline()
		let watchdog = async closeAfter(ln, deadline, timeout)
		watchdog.keepAlive()
		let failure ?error = none
		let conn = ln.accept() onerror (err error) {
			failure = err
			recover new net.Connection(-1)
		}
		deadline.done = true
		ln.close() onerror recover none
		fail net.errorOf(net.ErrorCode.TimedOut, "accept", "", "no data connection within the timeout") unless failure is none
		return conn
	}

	// listenOn binds a listening socket on `host`, port 0 for any. Fails
	// when the address cannot be bound.
	def listenOn(host string, port int) !net.Listener {
		let a = net.parseAddress(joinHostPort(host, port)) onerror recover new net.Address()
		let domain = a.isIPv6 ?? (net.SocketDomain.IPv6, net.SocketDomain.IPv4)
		let sock = try net.socket(domain, net.SocketType.Stream)
		sock.setReuseAddr(true) onerror recover none
		try sock.bind(joinHostPort(host, port))
		return try sock.listen(1)
	}

	// joinHostPort is `host:port`, brackets around an IPv6 host.
	def joinHostPort(host string, port int) string {
		return "[{host}]:{port}" when host.contains(":")
		return "{host}:{port}"
	}

	// isIPLiteral reports whether a host is an IPv4 or IPv6 address rather
	// than a name.
	def isIPLiteral(host string) bool {
		let dotted = /^[0-9.]+$/
		return host.contains(":") || dotted.test(host)
	}

	// hostOf is the host of a `host:port` address, without brackets.
	def hostOf(addr string) string {
		let a = net.parseAddress(addr) onerror recover new net.Address()
		return a.host
	}

	// parseEpsv reads the port of a `229 Entering Extended Passive Mode
	// (|||port|)` reply. Fails when the reply holds none.
	def parseEpsv(text string) !int {
		let open = text.indexOf("(")
		let close = text.indexOf(")", open + 1)
		fail protocolError("EPSV", "no port in {text}") when open < 0 || close < 0
		let inner = text[open + 1:close]
		fail protocolError("EPSV", "no port in {text}") when inner.len() < 5
		let sep = inner[:1]
		let parts = inner.split(sep)
		fail protocolError("EPSV", "no port in {text}") when parts.len() < 5 || !parts[3].isNumeric()
		return parts[3].toInt<int>()
	}

	// parsePasv reads the port of a `227 Entering Passive Mode
	// (h1,h2,h3,h4,p1,p2)` reply; the host it names is ignored, the
	// control connection's is used. Fails when the reply holds none.
	def parsePasv(text string) !int {
		let start = -1
		for let i = 0; i < text.len(); i++ {
			if text[i] >= '0' && text[i] <= '9' {
				start = i
				break
			}
		}
		fail protocolError("PASV", "no address in {text}") when start < 0
		let end = start
		for end < text.len() && ((text[end] >= '0' && text[end] <= '9') || text[end] == ',') {
			end++
		}
		let parts = text[start:end].split(",")
		fail protocolError("PASV", "no address in {text}") when parts.len() != 6
		return parts[4].toInt<int>() * 256 + parts[5].toInt<int>()
	}

	// parseHostPort reads the address of a `PORT h1,h2,h3,h4,p1,p2`
	// argument. Fails when it does not parse.
	def parseHostPort(arg string) !(string, int) {
		let parts = arg.trim().split(",")
		fail "bad address" when parts.len() != 6
		for let p in parts {
			fail "bad address" unless p.isNumeric()
		}
		let host = parts[:4].join(".")
		return (host, parts[4].toInt<int>() * 256 + parts[5].toInt<int>())
	}

	// parseEprt reads the address of an `EPRT |proto|host|port|`
	// argument. Fails when it does not parse.
	def parseEprt(arg string) !(string, int) {
		let text = arg.trim()
		fail "bad address" when text.len() < 7
		let parts = text.split(text[:1])
		fail "bad address" when parts.len() < 5
		fail "bad address" unless parts[3].isNumeric()
		return (parts[2], parts[3].toInt<int>())
	}

	// formatTime writes a time as an MLSD `modify` fact:
	// YYYYMMDDHHMMSS, UTC.
	def formatTime(t Time) string {
		let parts = [t.year(), t.month(), t.day(), t.hour(), t.minute(), t.second()]
		let out = "{parts[0]}".padStart(4, "0")
		for let i = 1; i < parts.len(); i++ {
			out += "{parts[i]}".padStart(2, "0")
		}
		return out
	}

	// parseTime reads an MLSD `modify` fact, fractions of a second
	// dropped; the zero time when it does not parse.
	def parseTime(text string) Time {
		return Time{} when text.len() < 14 || !text[:14].isNumeric()
		let s = text
		let iso = "{s[0:4]}-{s[4:6]}-{s[6:8]}T{s[8:10]}:{s[10:12]}:{s[12:14]}Z"
		return time.parse(iso) onerror recover Time{}
	}

	// factsLine is an MLSD/MLST line for an entry: its facts, a space and
	// its name.
	def factsLine(entry fs.FileEntry, name string) string {
		let kind = entry.kind == fs.FileKind.Dir ?? ("dir", "file")
		let facts = "type={kind};"
		facts += "size={entry.size};" unless entry.kind == fs.FileKind.Dir
		facts += "modify={formatTime(entry.modified)};" unless entry.modified.unixNs() == 0
		facts += "unix.mode={entry.mode.toRadix(8).padStart(4, "0")};" unless entry.mode == 0
		return "{facts} {name}"
	}

	// parseFacts reads an MLSD/MLST line into an entry under `dir`; none
	// for the `.` and `..` entries.
	def parseFacts(line string, dir string) ?fs.FileEntry {
		let space = line.indexOf(" ")
		return none when space < 0
		let name = line[space + 1:]
		let entry = fs.FileEntry{name: name, path: remotePath(dir, name)}
		for let fact in line[:space].split(";") {
			let eq = fact.indexOf("=")
			continue when eq < 0
			let key = fact[:eq].lower()
			let value = fact[eq + 1:]
			switch {
				case key == "type":
					let kind = value.lower()
					return none when kind := "cdir" || "pdir"
					if kind == "dir" {
						entry.kind = fs.FileKind.Dir
					} else if kind.startsWith("os.unix=slink") || kind.startsWith("os.unix=symlink") {
						entry.kind = fs.FileKind.Link
					}
				case key == "size":
					entry.size = value.toInt<int64>() when value.isNumeric()
				case key == "modify":
					entry.modified = parseTime(value)
				case key == "unix.mode":
					entry.mode = value.toInt<int>(8) when /^[0-7]{1,5}$/.test(value)
			}
		}
		return entry
	}

	// listLine is a LIST line for an entry, in the Unix `ls -l` form
	// clients parse.
	def listLine(entry fs.FileEntry) string {
		let mode = entry.mode
		mode = (entry.kind == fs.FileKind.Dir ?? (0o755, 0o644)) when mode == 0
		let perms = (entry.kind == fs.FileKind.Dir ?? ("d", "-")) + permissionText(mode)
		let size = "{entry.size}".padStart(12, " ")
		let months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
		let t = entry.modified
		let month = months[t.month() - 1]
		let day = "{t.day()}".padStart(2, " ")
		let hour = "{t.hour()}".padStart(2, "0")
		let minute = "{t.minute()}".padStart(2, "0")
		let clock = "{hour}:{minute}"
		let sixMonths int64 = 182 * 24 * 3600 * 1000000000
		clock = " {t.year()}" when time.now().unixNs() - t.unixNs() > sixMonths
		return "{perms} 1 ftp ftp {size} {month} {day} {clock} {entry.name}"
	}

	// parseListLine reads one line of a LIST reply, Unix `ls -l` or DOS
	// form, into an entry under `dir`; none for a line it cannot read
	// and for `.` and `..`.
	def parseListLine(line string, dir string) ?fs.FileEntry {
		let fields = line.split(" ").filter(p => p != "")
		return none when fields.len() < 4
		let first = fields[0]
		if first.len() == 8 && first[2] == '-' && first[5] == '-' {
			// DOS: 01-31-26  09:15PM  <DIR>  name
			let name = restAfter(line, 3)
			return none when name := "" || "." || ".."
			let entry = fs.FileEntry{name: name, path: remotePath(dir, name)}
			if fields[2] == "<DIR>" {
				entry.kind = fs.FileKind.Dir
			} else if fields[2].isNumeric() {
				entry.size = fields[2].toInt<int64>()
			}
			return entry
		}
		return none when fields.len() < 9
		let name = restAfter(line, 8)
		let kind = fs.FileKind.File
		if first[0] == 'd' {
			kind = fs.FileKind.Dir
		} else if first[0] == 'l' {
			kind = fs.FileKind.Link
			let arrow = name.indexOf(" -> ")
			name = name[:arrow] when arrow >= 0
		}
		return none when name := "" || "." || ".."
		let size int64 = fields[4].isNumeric() ?? (fields[4].toInt<int64>(), int64(0))
		return fs.FileEntry{name: name, path: remotePath(dir, name), kind: kind, size: size, modified: listTime(fields[5], fields[6], fields[7]), mode: permissionBits(first)}
	}

	// permissionText is permission bits in the `ls -l` form: `rwxr-xr-x`.
	def permissionText(mode int) string {
		let letters = "rwxrwxrwx"
		let out = ""
		for let i = 0; i < 9; i++ {
			let bit = 1 << (8 - i)
			out += (mode & bit) != 0 ?? (letters[i:i + 1], "-")
		}
		return out
	}

	// permissionBits reads the permission bits of an `ls -l` mode column
	// (`-rw-r--r--`); 0 when it is not one.
	def permissionBits(column string) int {
		return 0 unless column.len() == 10
		let mode = 0
		for let i = 0; i < 9; i++ {
			let c = column[i + 1:i + 2]
			return 0 unless c := "r" || "w" || "x" || "-" || "s" || "S" || "t" || "T"
			mode = mode | (1 << (8 - i)) unless c := "-" || "S" || "T"
		}
		return mode
	}

	// restAfter is the text of a line after its first `skip` fields,
	// spaces inside it kept.
	def restAfter(line string, skip int) string {
		let i = 0
		for let f = 0; f < skip; f++ {
			for i < line.len() && line[i] == ' ' {
				i++
			}
			for i < line.len() && line[i] != ' ' {
				i++
			}
		}
		for i < line.len() && line[i] == ' ' {
			i++
		}
		return line[i:]
	}

	// listTime reads the `Mon DD HH:MM` or `Mon DD YYYY` date of a LIST
	// line; the zero time when it does not parse.
	def listTime(month string, day string, clock string) Time {
		let months = ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"]
		let m = months.indexOf(month.lower())
		return Time{} when m < 0 || !day.isNumeric()
		let year = time.now().year()
		let hour = "00"
		let minute = "00"
		if clock.contains(":") {
			let hm = clock.split(":")
			return Time{} when hm.len() != 2
			hour = hm[0].padStart(2, "0")
			minute = hm[1].padStart(2, "0")
		} else if clock.isNumeric() {
			year = clock.toInt<int>()
		} else {
			return Time{}
		}
		let mm = "{m + 1}".padStart(2, "0")
		let dd = day.padStart(2, "0")
		return time.parse("{year}-{mm}-{dd}T{hour}:{minute}:00Z") onerror recover Time{}
	}

	// remotePath joins a remote directory and a name; an empty directory
	// leaves the name relative.
	def remotePath(dir string, name string) string {
		return name when dir == ""
		return os.clean(os.join(dir, name))
	}

	// clientConfig is the TLS config of a client connection to `host`:
	// the caller's, else a fresh one, with the host as the server name
	// when it names none and a session cache so the data connections
	// resume the control connection's session (vsftpd requires it).
	def clientConfig(base ?tls.Config, host string) tls.Config {
		let config = tls.Config{}
		config = base unless base is none
		config = tls.withServerName(config, host) when config.serverName == ""
		config.sessionCache = new tls.SessionCache() when config.sessionCache is none
		return config
	}

	// secureData runs the TLS client handshake over a data connection.
	// Fails as the handshake does, the connection closed.
	def secureData(conn net.Connection, control Control) !net.Stream {
		let secured = tls.client(conn, control.tlsConfig)
		secured.handshake(control.timeout) onerror (err error) {
			conn.close() onerror recover none
			fail err
		}
		return secured
	}
}
