partial module std.net.ftp {
	use (
		std.fs
		std.io
		std.net
		std.net.ftp.proto::*
		std.testing
		std.time
	)

	// rawLogin is a control connection logged in as alice, driven command
	// by command.
	internal def rawLogin(server Server) !Control {
		return try rawLoginAs(server, "alice", "s3cret")
	}

	// rawLoginAs is a control connection logged in as `user`, or only
	// greeted when `user` is empty.
	internal def rawLoginAs(server Server, user string, password string) !Control {
		let socket = try net.dialStream(server.address().str(), 5s)
		let c = new Control(socket, 5s, "127.0.0.1")
		let greet = try c.readReply()
		fail "greeting {greet.code}" unless greet.code == 220
		return c when user == ""
		try c.expect("USER", "USER {user}", 3)
		try c.expect("PASS", "PASS {password}", 2)
		return c
	}

	// rawData opens a passive data connection (EPSV).
	internal def rawData(c Control) !net.Connection {
		let reply = try c.expect("EPSV", "EPSV", 2)
		let port = try parseEpsv(replyText(reply))
		return try net.dialStream("127.0.0.1:{port}", 5s)
	}

	// readAllFrom reads a connection to its end.
	internal def readAllFrom(conn net.Connection) !byte[] {
		let out byte[] = []
		let buf byte[] = []
		buf.len(4096)
		for {
			let n = try conn.read(buf, 5s)
			break when n == 0
			out = out + buf[:n]
		}
		try conn.close()
		return out
	}

	// drainSlowly reads a connection to its end a little at a time, so a
	// large download stays in progress for a while.
	internal def drainSlowly(conn net.Connection) !int {
		let buf byte[] = []
		buf.len(4096)
		let total = 0
		for {
			let n = conn.read(buf, 5s) onerror recover 0
			break when n == 0
			total += n
			time.sleep(1ms)
		}
		conn.close() onerror recover none
		return total
	}

	// putFile stores bytes in a store.
	internal def putFile(store fs.FileStore, path string, data byte[]) !none {
		let w = try store.create(path, false)
		try w.write(data)
		return try w.close()
	}

	// fileText reads a whole file of a store.
	internal def fileText(store fs.FileStore, path string) !string {
		let r = try store.open(path, 0)
		let out byte[] = []
		let buf byte[] = []
		buf.len(4096)
		for {
			let n = try r.read(buf)
			break when n == 0
			out = out + buf[:n]
		}
		try r.close()
		return string(out)
	}

	// bigFile is `size` bytes of a repeating pattern.
	internal def bigFile(size int) byte[] {
		let out byte[] = []
		out.len(size)
		for let i = 0; i < size; i++ {
			out[i] = byte(i % 251)
		}
		return out
	}

	check "FTP protocol" {
		@test()
		def asciiRetrieveSendsCRLF() !none {
			let server = try startServer()
			try putFile(server.store, "/notes.txt", "one\ntwo\n".bytes())
			let c = try rawLogin(server)
			try c.expect("TYPE", "TYPE A", 2)
			assert (try c.expect("SIZE", "SIZE /notes.txt", 2)).lines[0] == "10"
			let data = try rawData(c)
			try c.expect("RETR", "RETR /notes.txt", 1)
			assert string(try readAllFrom(data)) == "one\r\ntwo\r\n"
			assert (try c.readReply()).code == 226

			// REST counts ASCII-form bytes under TYPE A.
			let again = try rawData(c)
			try c.expect("REST", "REST 5", 3)
			try c.expect("RETR", "RETR /notes.txt", 1)
			assert string(try readAllFrom(again)) == "two\r\n"
			assert (try c.readReply()).code == 226

			try c.expect("TYPE", "TYPE I", 2)
			assert (try c.expect("SIZE", "SIZE /notes.txt", 2)).lines[0] == "8"
			let binary = try rawData(c)
			try c.expect("RETR", "RETR /notes.txt", 1)
			assert string(try readAllFrom(binary)) == "one\ntwo\n"
			assert (try c.readReply()).code == 226
			try c.expect("QUIT", "QUIT", 2)
			try server.close()
			return none
		}

		@test()
		def asciiStoreTakesCRLF() !none {
			let server = try startServer()
			let c = try rawLogin(server)
			try c.expect("TYPE", "TYPE A", 2)
			let data = try rawData(c)
			try c.expect("STOR", "STOR /in.txt", 1)
			try data.writeAll("x\r\ny\r\nlone\rcr\r\n".bytes())
			try data.close()
			assert (try c.readReply()).code == 226
			assert (try fileText(server.store, "/in.txt")) == "x\ny\nlone\rcr\n"

			// A restarted ASCII upload continues at the local byte the
			// ASCII-form offset stands for; one inside a CRLF is refused.
			try putFile(server.store, "/r.txt", "ab\ncd".bytes())
			let more = try rawData(c)
			try c.expect("REST", "REST 4", 3)
			try c.expect("STOR", "STOR /r.txt", 1)
			try more.writeAll("xy".bytes())
			try more.close()
			assert (try c.readReply()).code == 226
			assert (try fileText(server.store, "/r.txt")) == "ab\nxy"
			let split = try rawData(c)
			try c.expect("REST", "REST 3", 3)
			assert (try c.command("STOR /r.txt")).code == 554
			split.close() onerror recover none
			try c.expect("QUIT", "QUIT", 2)
			try server.close()
			return none
		}

		@test()
		def statAndAbortDuringATransfer() !none {
			let server = try startServer()
			try putFile(server.store, "/big.bin", bigFile(4 * 1024 * 1024))
			let c = try rawLogin(server)
			let data = try rawData(c)
			try c.expect("RETR", "RETR /big.bin", 1)
			let drain = async drainSlowly(data)
			time.sleep(20ms)
			let stat = try c.command("STAT")
			assert stat.code == 213
			assert replyText(stat).contains("Transferring big.bin")
			try c.send("ABOR")
			let first = try c.readReply()
			let second = try c.readReply()
			assert first.code == 426
			assert second.code == 226
			let got = try await drain
			assert got < 4 * 1024 * 1024
			// The session goes on after the abort.
			assert (try c.command("NOOP")).code == 200
			try c.expect("QUIT", "QUIT", 2)
			try server.close()
			return none
		}

		@test()
		def restartedUploads() !none {
			let server = try startServer()
			try putFile(server.store, "/r.bin", "hello!!!".bytes())
			let c = try rawLogin(server)
			let data = try rawData(c)
			try c.expect("REST", "REST 5", 3)
			try c.expect("STOR", "STOR /r.bin", 1)
			try data.writeAll(" world".bytes())
			try data.close()
			assert (try c.readReply()).code == 226
			assert (try fileText(server.store, "/r.bin")) == "hello world"
			// Past the end of the file is refused.
			let past = try rawData(c)
			try c.expect("REST", "REST 99", 3)
			assert (try c.command("STOR /r.bin")).code == 550
			past.close() onerror recover none
			try c.expect("QUIT", "QUIT", 2)

			let client = try connectTo(server)
			try client.upload("abc".bytes(), "/u.txt")
			try client.upload(new ByteSource("defg".bytes()), "/u.txt", int64(3))
			assert (try readAll(try client.download("/u.txt"))) == "abcdefg"
			try client.close()
			try server.close()
			return none
		}

		@test()
		def clientAsciiMode() !none {
			let server = try startServer()
			let client = try connectTo(server)
			client.dataType = DataType.Ascii
			try client.upload("line one\nline two\n".bytes(), "/t.txt")
			assert (try fileText(server.store, "/t.txt")) == "line one\nline two\n"
			try putFile(server.store, "/crlf.txt", "a\r\nb\n".bytes())
			assert (try readAll(try client.download("/crlf.txt"))) == "a\nb\n"
			client.dataType = DataType.Binary
			assert (try readAll(try client.download("/crlf.txt"))) == "a\r\nb\n"
			assert (try client.stat("/t.txt")).size == 18
			try client.close()
			try server.close()
			return none
		}

		@test()
		def clientClosingEarlyAborts() !none {
			let server = try startServer()
			try putFile(server.store, "/big.bin", bigFile(4 * 1024 * 1024))
			let client = try connectTo(server)
			let reader = try client.download("/big.bin")
			let buf byte[] = []
			buf.len(100)
			assert (try reader.read(buf)) > 0
			try reader.close()
			// The replies of the aborted transfer were all read.
			assert (try client.list("/")).len() == 1
			try client.close()
			try server.close()
			return none
		}

		@test()
		def moreCommands() !none {
			let server = try startServer()
			let c = try rawLogin(server)

			let help = try c.expect("HELP", "HELP", 2)
			assert help.code == 214 && replyText(help).contains("STOU")
			assert (try c.command("HELP RETR")).code == 214
			assert (try c.command("HELP BOGUS")).code == 502

			let status = try c.expect("STAT", "STAT", 2)
			assert status.code == 211 && replyText(status).contains("Logged in as alice")
			try putFile(server.store, "/s.txt", "abc".bytes())
			let listed = try c.expect("STAT", "STAT /", 2)
			assert listed.code == 213 && replyText(listed).contains("s.txt")

			assert (try c.command("SITE HELP")).code == 214
			assert (try c.command("SITE BOGUS 644 /s.txt")).code == 504
			assert (try c.command("ACCT x")).code == 202
			assert (try c.command("TYPE E")).code == 504
			assert (try c.command("TYPE A T")).code == 504
			assert (try c.command("TYPE L 8")).code == 200
			assert (try c.command("MODE B")).code == 504
			assert (try c.command("STRU R")).code == 504

			// STOU names the file it stores in its 150 reply.
			let data = try rawData(c)
			let opening = try c.expect("STOU", "STOU s.txt", 1)
			assert replyText(opening).contains("FILE: s.txt.1")
			try data.writeAll("unique".bytes())
			try data.close()
			assert (try c.readReply()).code == 226
			assert (try fileText(server.store, "/s.txt.1")) == "unique"
			assert (try fileText(server.store, "/s.txt")) == "abc"

			// REIN logs out; the connection stays.
			assert (try c.command("REIN")).code == 220
			assert (try c.command("PWD")).code == 530
			try c.expect("USER", "USER alice", 3)
			try c.expect("PASS", "PASS s3cret", 2)
			assert (try c.command("PWD")).code == 257
			try c.expect("QUIT", "QUIT", 2)
			try server.close()
			return none
		}

		@test()
		def permissionsAndTimes() !none {
			let server = try startServer()
			try putFile(server.store, "/p.txt", "perm".bytes())
			let c = try rawLogin(server)
			assert (try c.command("SITE CHMOD 640 /p.txt")).code == 200
			assert (try server.store.stat("/p.txt")).mode == 0o640
			assert (try c.command("SITE CHMOD 9x /p.txt")).code == 501
			let set = try c.command("MFMT 20240102030405 /p.txt")
			assert set.code == 213 && replyText(set) == "Modify=20240102030405; /p.txt"
			assert formatTime((try server.store.stat("/p.txt")).modified) == "20240102030405"
			assert (try c.command("MFMT yesterday /p.txt")).code == 501
			let facts = try c.expect("MLST", "MLST /p.txt", 2)
			assert replyText(facts).contains("unix.mode=0640;")
			try c.expect("QUIT", "QUIT", 2)

			// The client reads them back from MLSD and sets them through the
			// same commands.
			let client = try connectTo(server)
			let entry = (try client.list("/"))[0]
			assert entry.mode == 0o640 && formatTime(entry.modified) == "20240102030405"
			try client.chmod("/p.txt", 0o604)
			try client.touch("/p.txt", time.fromUnixNs(int64(1500000000) * 1000000000))
			let after = try client.stat("/p.txt")
			assert after.mode == 0o604 && after.modified.unixNs() == int64(1500000000) * 1000000000
			try client.close()

			// Read-only accounts cannot change them.
			let guest = new Client(Security.Plain, Mode.Passive, 5s)
			try guest.connect(server.address().str())
			try guest.login()
			assert replyCodeOf(def () !none { return guest.chmod("/p.txt", 0o777) }) == 550
			try guest.close()
			try server.close()
			return none
		}

		@test()
		def listLinesCarryPermissions() !none {
			let dir = parseListLine("drwxr-x--- 2 ftp ftp 4096 Mar 3 10:15 private", "/")
			fail "no entry" when dir is none
			assert dir.mode == 0o750
			let file = parseListLine("-rwsr-xr-x 1 ftp ftp 10 Mar 3 10:15 tool", "/")
			fail "no entry" when file is none
			assert file.mode == 0o755
			assert permissionText(0o640) == "rw-r-----"
			let shown = listLine(fs.FileEntry{name: "a", kind: fs.FileKind.File, mode: 0o600, modified: time.now()})
			assert shown.startsWith("-rw------- ")
			return none
		}

		@test()
		def virtualHosts() !none {
			let server = try startServer()
			let site = new fs.MemoryStore()
			try putFile(site, "/site.txt", "the other site".bytes())
			let siteUsers = new Users()
			siteUsers.add("carol", "pw", site)
			server.host("files.example.test", site, siteUsers)

			let c = try rawLoginAs(server, "", "")
			assert (try c.command("HOST nowhere.test")).code == 504
			assert (try c.command("HOST Files.Example.Test")).code == 220
			try c.expect("USER", "USER carol", 3)
			try c.expect("PASS", "PASS pw", 2)
			assert (try c.command("HOST files.example.test")).code == 503
			let listed = try c.expect("STAT", "STAT /", 2)
			assert replyText(listed).contains("site.txt")
			try c.expect("QUIT", "QUIT", 2)

			// Without HOST the server's own site answers, and alice is not
			// a user of the other one.
			let plain = try rawLoginAs(server, "", "")
			try plain.expect("HOST", "HOST files.example.test", 2)
			try plain.expect("USER", "USER alice", 3)
			assert (try plain.command("PASS s3cret")).code == 530
			try plain.expect("QUIT", "QUIT", 2)

			// A client dialling a name sends HOST with it.
			server.host("localhost", site, siteUsers)
			let byName = new Client(Security.Plain, Mode.Passive, 5s)
			try byName.connect("localhost:{server.address().port}")
			try byName.login("carol", "pw")
			assert (try byName.list("/"))[0].name == "site.txt"
			try byName.close()
			try server.close()
			return none
		}

		@test()
		def clientAbortsAnUpload() !none {
			let server = try startServer()
			try putFile(server.store, "/keep.txt", "original".bytes())
			let client = try connectTo(server)
			let writer = try client.create("/keep.txt", false)
			try writer.write("half of a new ver".bytes())
			if writer is io.Aborter {
				try writer.abort()
			} else {
				fail "the upload writer is not an io.Aborter"
			}
			// The server discarded the upload; the session goes on.
			assert (try fileText(server.store, "/keep.txt")) == "original"
			assert (try client.list("/")).len() == 1
			try client.close()
			try server.close()
			return none
		}

		@test()
		def lineEndingsAcrossChunks() {
			let e = new LineEndings()
			assert string(e.toWire("a\r".bytes()) + e.toWire("\nb\n".bytes())) == "a\r\nb\r\n"
			let d = new LineEndings()
			let back = d.fromWire("a\r".bytes()) + d.fromWire("\nb\r".bytes()) + d.flush()
			assert string(back) == "a\nb\r"
			assert wireLength("a\nb\r\n".bytes(), false) == 6
			let telnet byte[] = [byte(255), byte(244), byte(255), byte(242)] + "ABOR".bytes()
			assert string(withoutTelnetCommands(telnet)) == "ABOR"
		}
	}
}
