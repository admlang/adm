// GraphQL (the September 2025 specification): documents parsed and printed,
// schemas from SDL and from annotated types, validation, an executor with
// resolvers, introspection, schema coordinates; GraphQL over HTTP and over
// WebSocket (graphql-transport-ws) in a Handler for std.net.http and a Client.
partial module std.net.graphql {
	use (
		std.net.graphql.syntax
		std.net.graphql.syntax::(Node, NodeKind)
	)

	// A parsed GraphQL document: operations and fragments, or type-system
	// definitions (SDL), or both.
	type Document {
		internal root Node

		internal def new(root Node) {
			self.root = root
		}

		// The document printed as graphql-js prints it.
		def str() string {
			return syntax.print(root)
		}

		// The names of the document's operations, "" for an anonymous one, in
		// order.
		def operationNames() string[] {
			let out string[] = []
			for let d in root.items {
				out.push(d.name) when d.kind == NodeKind.OperationDefinition
			}
			return out
		}
	}

	// parse reads a GraphQL document. Fails with the syntax error, its line
	// and column, at the first place the grammar does not allow.
	def parse(text string) !Document {
		return new Document(try syntax.parseDocument(text))
	}
}
