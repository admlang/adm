partial module std.net.graphql {
	use (
		std.testing
		std.time
		std.data.encoding::(JSON)
		std.net.graphql.syntax
	)

	// Documents, a schema and requests with what graphql-js 17 answers for
	// them: printed documents, syntax errors, responses and validation
	// messages (sorted).
	@embed("testdata/graphql.json")
	internal const graphqlFixture byte[]

	internal def fixture() !map<string, any> {
		let doc = try JSON.parse(graphqlFixture)
		fail "testdata/graphql.json is not an object" unless doc is map<string, any>
		return doc
	}

	internal def fixtureList(doc map<string, any>, key string) !map<string, any>[] {
		let list = doc[key]
		fail "testdata/graphql.json has no {key} list" unless list is any[]
		let out map<string, any>[] = []
		for let item in list {
			out.push(item) when item is map<string, any>
		}
		return out
	}

	internal def jsonText(value any) string {
		return string(new JSON().encode(value))
	}

	internal def fixtureSchema(doc map<string, any>) !Schema {
		let sdl = doc["sdl"]
		fail "testdata/graphql.json has no sdl" unless sdl is string
		return try parseSchema(sdl)
	}

	// A book of the test library.
	@graphql(description = "A book of the library.")
	internal struct TestBook {
		// The title on the cover.
		@graphql()
		title string
		year int32
		genre TestGenre
		@graphql(name = "subtitle", deprecated = "Use title.")
		sub ?string
		@graphql(ignore = true)
		shelf string
		published ?time.Time
	}

	// What a book is about.
	@graphql()
	internal enum TestGenre {
		// Made up.
		Fiction,
		History
	}

	@graphql(name = "BookFilter")
	internal struct TestBookFilter {
		genres  TestGenre[]
		minYear ?int32
	}

	@graphql(name = "Query")
	internal type TestLibrary {
		books TestBook[]

		def new() {
			books = [
				TestBook{title: "Dune", year: 1965, genre: TestGenre.Fiction, shelf: "A1"},
				TestBook{title: "SPQR", year: 2015, genre: TestGenre.History, sub: "A History of Ancient Rome", shelf: "B2", published: time.fromUnixNs(1445472000 * 1000000000)},
				TestBook{title: "Foundation", year: 1951, genre: TestGenre.Fiction, shelf: "A2"},
			]
		}

		// The books of a genre, at most limit of them.
		// @param limit how many books at most
		@graphql()
		def byGenre(genre TestGenre, limit int = 10) TestBook[] {
			let out TestBook[] = []
			for let b in books {
				out.push(b) when b.genre == genre && out.len() < limit
			}
			return out
		}

		// The books a filter takes; the context, when a string, must be
		// "reader".
		@graphql(name = "search")
		def find(filter TestBookFilter, info ResolveInfo) !TestBook[] {
			let who = info.context
			fail "not allowed" when who is string && who != "reader"
			let floor = filter.minYear
			return books.filter(b => filter.genres.includes(b.genre) && (floor is none || b.year >= floor))
		}
	}

	@graphql(name = "Mutation")
	internal type TestLibraryMutations {
		@graphql(ignore = true)
		shelves TestLibrary

		def new(shelves TestLibrary) {
			self.shelves = shelves
		}

		// Adds a book and returns it.
		@graphql()
		def add(title string, year int32, genre TestGenre = TestGenre.Fiction) !TestBook {
			expects {
				assert !(title.isEmpty()) onerror fail "a title is required"
			}
			let book = TestBook{title: title, year: year, genre: genre}
			shelves.books.push(book)
			return book
		}
	}

	@graphql(name = "Subscription")
	internal type TestLibraryEvents {
		def new() {}

		// The books of the shelves, one event each.
		@graphql()
		def arrivals(shelves int = 2) channel<TestBook> {
			let out = new channel<TestBook>(4)
			for let i = 0; i < shelves; i++ {
				out <- TestBook{title: "Arrival {i}", year: int32(2000 + i), genre: TestGenre.History}
			}
			out.close()
			return out
		}
	}

	// The SDL schemaOf builds of TestLibrary and TestLibraryMutations.
	@embed("testdata/library.graphql")
	internal const testLibrarySDL byte[]

	// The deprecation reason of an element, "" when it has none or is none.
	internal def reasonOf(e ?SchemaElement) string {
		return "" when e is none
		let reason = e.deprecated
		return reason is none ?? ("", reason)
	}

	check "GraphQL" {
		// Documents print as graphql-js prints them, and print stably.
		@test()
		def printsDocumentsAsGraphqlJs() !none {
			for let item in try fixtureList(try fixture(), "print") {
				let src = item["src"]
				let want = item["printed"]
				fail "testdata/graphql.json holds a malformed entry" unless src is string && want is string
				let got = try parse(src)
				assert got.str() == want
				assert (try parse(got.str())).str() == want
			}
			return none
		}

		// What graphql-js refuses fails with its syntax error and a place.
		@test()
		def refusesBadSyntax() !none {
			for let item in try fixtureList(try fixture(), "bad") {
				let src = item["src"]
				let want = item["msg"]
				fail "testdata/graphql.json holds a malformed entry" unless src is string && want is string
				let message = ""
				parse(src) onerror (err error) {
					if err is syntax.SyntaxError {
						assert err.line > 0 && err.column > 0
						message = err.message
					}
					recover new Document(new syntax.Node(syntax.NodeKind.Document))
				}
				assert message == want
			}
			return none
		}

		// Queries, variables, abstract types, errors, null propagation and
		// introspection answer as graphql-js answers them.
		@test()
		def executesAsGraphqlJs() !none {
			let doc = try fixture()
			let schema = try fixtureSchema(doc)
			for let item in try fixtureList(doc, "cases") {
				let query = item["query"]
				let variables = item["variables"]
				fail "testdata/graphql.json holds a malformed entry" unless query is string && variables is map<string, any>
				let response = schema.execute(query, variables, root = doc["root"])
				assert jsonText(try JSON.parse(response.json().bytes())) == jsonText(item["expected"])
			}
			return none
		}

		// Every validation rule reports what graphql-js reports.
		@test()
		def validatesAsGraphqlJs() !none {
			let doc = try fixture()
			for let pair in [("sdl", "invalid"), ("plainSdl", "plainInvalid")] {
				let (sdlKey, listKey) = pair
				let sdl = doc[sdlKey]
				fail "testdata/graphql.json has no {sdlKey}" unless sdl is string
				let schema = try parseSchema(sdl)
				for let item in try fixtureList(doc, listKey) {
					let query = item["query"]
					fail "testdata/graphql.json holds a malformed entry" unless query is string
					let messages = schema.validate(try parse(query)).mapElem(e => e.message)
					messages.sort((a string, b string) => a < b)
					assert jsonText(messages) == jsonText(item["messages"])
				}
			}
			return none
		}

		// A nullable variable cannot fill a field of a OneOf Input Object
		// (spec IsNonNullPosition), unless it has a default; graphql-js 17
		// accepts it.
		@test()
		def refusesNullableVariablesInOneOfFields() !none {
			let schema = try parseSchema("input Lookup @oneOf \{ a: String b: Int \} type Query \{ find(by: Lookup!): String list(by: [Lookup!]): String \}")
			let message = "Variable \"$a\" is of type \"String\" but must be non-nullable to be used for OneOf Input Object \"Lookup\"."
			assert schema.validate(try parse("query Q($a: String) \{ find(by: \{a: $a\}) \}")).mapElem(e => e.message).join("|") == message
			assert schema.validate(try parse("query Q($a: String) \{ list(by: [\{a: $a\}]) \}")).mapElem(e => e.message).join("|") == message
			assert schema.validate(try parse("query Q($a: String = \"x\") \{ find(by: \{a: $a\}) \}")).len() == 0
			assert schema.validate(try parse("query Q($a: String!) \{ find(by: \{a: $a\}) \}")).len() == 0
			return none
		}

		// Resolvers compute fields from the parent and the arguments; a
		// failing resolver nulls its field and reports the error at its path.
		@test()
		def runsResolvers() !none {
			let schema = try parseSchema("type Query \{ hello(name: String = \"world\"): String fail: Int \}")
			try schema.resolve("Query", "hello", def (info ResolveInfo) !any {
				return "Hello, {info.arg("name")}"
			})
			try schema.resolve("Query", "fail", def (info ResolveInfo) !any {
				fail "no luck"
			})
			assert schema.execute("\{ a: hello b: hello(name: \"Ada\") \}").json() == "\{\"data\":\{\"a\":\"Hello, world\",\"b\":\"Hello, Ada\"\}\}"
			assert schema.execute("\{ fail \}").json() == "\{\"errors\":[\{\"message\":\"no luck\",\"locations\":[\{\"line\":1,\"column\":3\}],\"path\":[\"fail\"]\}],\"data\":\{\"fail\":null\}\}"
			assert schema.resolve("Query", "missing", def (info ResolveInfo) !any {
				return none
			}) is error
			return none
		}

		// An interface or union finds the object type of a value through its
		// resolveType, else through `__typename` or the value's ADM type
		// name; a custom scalar coerces through its functions both ways.
		@test()
		def resolvesAbstractTypesAndScalars() !none {
			let schema = try parseSchema("interface Pet \{ name: String \} type Cat implements Pet \{ name: String lives: Int \} type Dog implements Pet \{ name: String \} scalar Upper type Query \{ pets: [Pet] shout(text: Upper): Upper \}")
			try schema.resolve("Query", "pets", def (_ ResolveInfo) !any {
				return [map<string, any>{"name": "Tom", "lives": 9}, map<string, any>{"name": "Rex"}]
			})
			try schema.resolveType("Pet", def (value any, _ ResolveInfo) !string {
				return value is map<string, any> && value.hasKey("lives") ?? ("Cat", "Dog")
			})
			try schema.scalar("Upper", ScalarCoercion{
				serialize: def (value any) !any {
					return string(value).upper()
				},
				parseValue: def (value any) !any {
					fail "Upper takes text" unless value is string
					return value.lower()
				},
			})
			try schema.resolve("Query", "shout", def (info ResolveInfo) !any {
				return info.arg("text")
			})
			assert schema.execute("\{ pets \{ __typename name ... on Cat \{ lives \} \} shout(text: \"Hey\") \}").json() == "\{\"data\":\{\"pets\":[\{\"__typename\":\"Cat\",\"name\":\"Tom\",\"lives\":9\},\{\"__typename\":\"Dog\",\"name\":\"Rex\"\}],\"shout\":\"HEY\"\}\}"
			assert schema.execute("\{ shout(text: 1) \}").errors[0].message == "Expected value of type \"Upper\", but encountered error \"Upper takes text\"; found: 1."
			assert schema.resolveType("Cat", def (value any, _ ResolveInfo) !string {
				return "Cat"
			}) is error
			assert schema.scalar("Int", ScalarCoercion{}) is error
			let doc = try parse("query A \{ a \} \{ b \} mutation C \{ c \}")
			assert doc.operationNames().join(",") == "A,,C"
			return none
		}

		// A schema that breaks a rule of the type system is refused.
		@test()
		def refusesInvalidSchemas() !none {
			assert parseSchema("type Query \{ a: Missing \}") is error
			assert parseSchema("type Query \{ a: Int \} type Query \{ b: Int \}") is error
			assert parseSchema("interface I \{ a: Int \} type Query implements I \{ b: Int \}") is error
			assert parseSchema("input In \{ a: In! \} type Query \{ a(i: In): Int \}") is error
			assert parseSchema("type T \{ a: Int \}") is error
			assert parseSchema("\{ a \}") is error
			// OneOf input objects: nullable fields, no defaults, not added by
			// an extension.
			assert parseSchema("input L @oneOf \{ a: String! \} type Query \{ f(l: L): Int \}") is error
			assert parseSchema("input L @oneOf \{ a: String = \"x\" \} type Query \{ f(l: L): Int \}") is error
			assert parseSchema("input L \{ a: String \} extend input L @oneOf type Query \{ f(l: L): Int \}") is error
			assert !(parseSchema("input L @oneOf \{ a: String b: Int \} type Query \{ f(l: L): Int \}") is error)
			// An implementation deprecates only what its interface does.
			assert parseSchema("interface I \{ a: Int \} type Query implements I \{ a: Int @deprecated \}") is error
			assert !(parseSchema("interface I \{ a: Int @deprecated \} type Query implements I \{ a: Int @deprecated \}") is error)
			// Defaults that contain themselves (InputObjectDefaultValueHasCycle).
			assert parseSchema("input A \{ b: B = \{\} \} input B \{ a: A = \{\} \} type Query \{ f(a: A): Int \}") is error
			assert !(parseSchema("input A \{ b: B = \{\} \} input B \{ a: A \} type Query \{ f(a: A): Int \}") is error)
			// A required argument cannot be deprecated; @deprecated needs its
			// reason to be a string.
			assert parseSchema("type Query \{ f(a: Int! @deprecated): Int \}") is error
			assert parseSchema("type Query \{ f: Int @deprecated(reason: null) \}") is error
			let schema = try parseSchema("type Query \{ a: Int \}\nextend type Query \{ b: String \}")
			assert schema.str() == "type Query \{\n  a: Int\n  b: String\n\}"
			return none
		}

		// A schema coordinate names a type, field, argument, input field,
		// enum value, directive or directive argument (spec 2.14).
		@test()
		def resolvesSchemaCoordinates() !none {
			let schema = try parseSchema("\"\"\"A query.\"\"\" type Query \{ \"The user.\" user(id: ID! = 1 @deprecated(reason: \"no\")): String old: Int @deprecated(reason: \"gone\") \} enum E \{ A B \} input In \{ x: [Int!] \} directive @tag(\"what\" name: String) on FIELD scalar S")
			let t = try schema.element("Query")
			assert !(t is none) && t.kind == ElementKind.Type && t.description == "A query."
			let f = try schema.element("Query.user")
			assert !(f is none) && f.kind == ElementKind.Field && f.typeRef == "String" && f.description == "The user." && f.deprecated is none
			let old = try schema.element("Query.old")
			assert reasonOf(old) == "gone"
			let a = try schema.element("Query.user(id:)")
			assert !(a is none) && a.kind == ElementKind.Argument && a.typeRef == "ID!" && reasonOf(a) == "no"
			let v = try schema.element("E.B")
			assert !(v is none) && v.kind == ElementKind.EnumValue
			let x = try schema.element("In.x")
			assert !(x is none) && x.kind == ElementKind.InputField && x.typeRef == "[Int!]"
			let d = try schema.element("@tag")
			assert !(d is none) && d.kind == ElementKind.Directive
			let da = try schema.element("@tag(name:)")
			assert !(da is none) && da.kind == ElementKind.DirectiveArgument && da.description == "what"
			let builtin = try schema.element("@deprecated(reason:)")
			assert !(builtin is none) && builtin.typeRef == "String!"
			assert (try schema.element("Missing")) is none
			assert (try schema.element("Query.missing")) is none
			assert (try schema.element("Query.user(missing:)")) is none
			assert (try schema.element("@missing")) is none
			assert schema.element("Missing.field") is error
			assert schema.element("S.x") is error
			assert schema.element("Query.missing(id:)") is error
			assert schema.element("@missing(a:)") is error
			assert schema.element("Query. user") is error
			assert schema.element("Query(id:)") is error
			assert schema.element("@tag.x") is error
			return none
		}

		// A request's extensions reach the resolvers.
		@test()
		def passesRequestExtensions() !none {
			let schema = try parseSchema("type Query \{ trace: String \}")
			try schema.resolve("Query", "trace", def (info ResolveInfo) !any {
				return info.extensions["traceId"]
			})
			let response = schema.execute(Request{query: "\{ trace \}", extensions: map<string, any>{"traceId": "abc"}})
			assert response.json() == "\{\"data\":\{\"trace\":\"abc\"\}\}"
			return none
		}

		// A subscription runs its selection set once per event, in order,
		// and ends when the events do.
		@test()
		def runsSubscriptions() !none {
			let schema = try parseSchema("type Query \{ a: Int \} type Subscription \{ tick(upTo: Int!): Int \}")
			try schema.subscribe("tick", def (info ResolveInfo) !channel<any> {
				let events = new channel<any>(8)
				let upTo = info.arg("upTo")
				for let i = 1; i <= int(upTo); i++ {
					events <- i
				}
				events.close()
				return events
			})
			try schema.resolve("Subscription", "tick", def (info ResolveInfo) !any {
				return int(info.source) * 10
			})
			let sub = try schema.executeSubscription(Request{query: "subscription \{ tick(upTo: 3) \}"})
			let got string[] = []
			for let response in sub.responses {
				got.push(response.json())
			}
			assert got.join("|") == "\{\"data\":\{\"tick\":10\}\}|\{\"data\":\{\"tick\":20\}\}|\{\"data\":\{\"tick\":30\}\}"
			assert schema.executeSubscription(Request{query: "\{ a \}"}) is error
			assert schema.execute("subscription \{ tick(upTo: 1) \}").errors.len() == 1
			return none
		}

		// schemaOf builds the schema of annotated types: names, docs,
		// deprecations, nullability, enums, input objects and DateTime.
		@test()
		def buildsSchemasFromTypes() !none {
			let shelves = new TestLibrary()
			let schema = try schemaOf(shelves, new TestLibraryMutations(shelves))
			assert schema.str() == string(testLibrarySDL)
			assert (try parseSchema(schema.str())).str() == string(testLibrarySDL)
			return none
		}

		// Fields read the values, methods run with their arguments converted
		// (enums, defaults, input objects, the resolve info), and mutations
		// change the root value.
		@test()
		def executesSchemasFromTypes() !none {
			let shelves = new TestLibrary()
			let schema = try schemaOf(shelves, new TestLibraryMutations(shelves))
			assert schema.execute("\{ books \{ title year genre subtitle published \} \}").json() == "\{\"data\":\{\"books\":[\{\"title\":\"Dune\",\"year\":1965,\"genre\":\"Fiction\",\"subtitle\":null,\"published\":null\},\{\"title\":\"SPQR\",\"year\":2015,\"genre\":\"History\",\"subtitle\":\"A History of Ancient Rome\",\"published\":\"2015-10-22T00:00:00Z\"\},\{\"title\":\"Foundation\",\"year\":1951,\"genre\":\"Fiction\",\"subtitle\":null,\"published\":null\}]\}\}"
			assert schema.execute("\{ a: byGenre(genre: Fiction) \{ title \} b: byGenre(genre: Fiction, limit: 1) \{ title \} \}").json() == "\{\"data\":\{\"a\":[\{\"title\":\"Dune\"\},\{\"title\":\"Foundation\"\}],\"b\":[\{\"title\":\"Dune\"\}]\}\}"
			let search = "query S($f: BookFilterInput!) \{ search(filter: $f) \{ title \} \}"
			let filter = map<string, any>{"f": map<string, any>{"genres": ["Fiction", "History"], "minYear": 1960}}
			assert schema.execute(search, filter).json() == "\{\"data\":\{\"search\":[\{\"title\":\"Dune\"\},\{\"title\":\"SPQR\"\}]\}\}"
			assert schema.execute(search, filter, context = "stranger").json() == "\{\"errors\":[\{\"message\":\"not allowed\",\"locations\":[\{\"line\":1,\"column\":33\}],\"path\":[\"search\"]\}],\"data\":null\}"
			assert schema.execute("mutation \{ add(title: \"Emma\", year: 1815) \{ title genre \} \}").json() == "\{\"data\":\{\"add\":\{\"title\":\"Emma\",\"genre\":\"Fiction\"\}\}\}"
			assert shelves.books.len() == 4 && shelves.books[3].title == "Emma"
			assert schema.execute("mutation \{ add(title: \"\", year: 1) \{ title \} \}").json() == "\{\"errors\":[\{\"message\":\"a title is required\",\"locations\":[\{\"line\":1,\"column\":12\}],\"path\":[\"add\"]\}],\"data\":null\}"
			assert schema.execute("\{ byGenre(genre: Poetry) \{ title \} \}").errors[0].message == "Value \"Poetry\" does not exist in \"TestGenre\" enum."
			return none
		}

		// A subscription value's `@graphql` methods return channels of
		// their field's type: one event per value sent.
		@test()
		def subscribesThroughTypedChannels() !none {
			let shelves = new TestLibrary()
			let schema = try schemaOf(shelves, none, new TestLibraryEvents())
			assert schema.str().contains("type Subscription \{\n  \"\"\"The books of the shelves, one event each.\"\"\"\n  arrivals(shelves: Int = 2): TestBook!\n\}")
			let sub = try schema.executeSubscription(Request{query: "subscription \{ arrivals(shelves: 3) \{ title year \} \}"})
			let got string[] = []
			for let response in sub.responses {
				got.push(response.json())
			}
			assert got.len() == 3
			assert got[2] == "\{\"data\":\{\"arrivals\":\{\"title\":\"Arrival 2\",\"year\":2002\}\}\}"
			assert schemaOf(shelves, none, shelves) is error
			return none
		}

		// A type GraphQL cannot express is refused with what to do instead.
		@test()
		def refusesTypesWithoutAGraphqlForm() !none {
			let built = schemaOf(map<string, int>{})
			if built is error {}
			assert built is error && built.message.contains("parseSchema")
			return none
		}
	}
}
