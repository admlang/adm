partial module std.net.graphql {
	use (
		std.testing
		std.net.http
		std.net.http::(Method)
		std.net.http.httptest
		std.net.url
		std.net.http.websocket
		std.net.http.websocket::(DialOptions)
	)

	internal const transportSDL = "type Query \{ hello(name: String = \"world\"): String fail: String count: Int! \} type Mutation \{ add(n: Int!): Int! \} type Subscription \{ tick(upTo: Int!): Int! forever: Int \}"

	// A schema for the transport suites: a greeting, a field that fails, a
	// counter mutation and a ticking subscription.
	internal def transportSchema() !Schema {
		let schema = try parseSchema(transportSDL)
		let counter = [0]
		try schema.resolve("Query", "hello", def (info ResolveInfo) !any {
			return "Hello, {info.arg("name")}"
		})
		try schema.resolve("Query", "fail", def (_ ResolveInfo) !any {
			fail "no luck"
		})
		try schema.resolve("Query", "count", def (info ResolveInfo) !any {
			return counter[0]
		})
		try schema.resolve("Mutation", "add", def (info ResolveInfo) !any {
			counter[0] += int(info.arg("n"))
			return counter[0]
		})
		try schema.subscribe("tick", def (info ResolveInfo) !channel<any> {
			let events = new channel<any>(8)
			for let i = 1; i <= int(info.arg("upTo")); i++ {
				events <- i
			}
			events.close()
			return events
		})
		try schema.resolve("Subscription", "tick", def (info ResolveInfo) !any {
			return info.source
		})
		// Events that never come: the channel stays open while the schema
		// holds it.
		let held channel<any>[] = []
		try schema.subscribe("forever", def (_ ResolveInfo) !channel<any> {
			let events = new channel<any>(1)
			held.push(events)
			return events
		})
		return schema
	}

	// What a raw request to the handler answered.
	internal struct Answer {
		status int
		kind   string
		allow  string
		body   string
	}

	internal def send(method Method, target string, contentType string, accept string, body string) !Answer {
		let req = try http.newRequest(method, target, body)
		req.headers.set("Content-Type", contentType) unless contentType == ""
		req.headers.set("Accept", accept) unless accept == ""
		let res = try new http.Client().do(req)
		let text = try res.text()
		return Answer{status: res.status, kind: res.headers.get("Content-Type"), allow: res.headers.get("Allow"), body: text}
	}

	internal def post(ts httptest.Server, body string, accept string = "application/graphql-response+json") !Answer {
		return try send(Method.POST, ts.url + "/graphql", "application/json", accept, body)
	}

	internal const graphqlJSON = "application/graphql-response+json; charset=utf-8"

	// Reads the close code a raw graphql-ws socket ends with.
	internal def closeCodeOf(conn websocket.Conn) int {
		for {
			let failed = false
			let code = 0
			conn.readText() onerror (err error) {
				failed = true
				code = err is websocket.WebSocketError ?? (err.closeCode, -1)
				recover ""
			}
			return code when failed
		}
		return -1
	}

	internal def rawSocket(ts httptest.Server) !websocket.Conn {
		let (conn, _) = try websocket.dial(ts.url + "/graphql", DialOptions{subprotocols: [wsProtocol]})
		return conn
	}

	check "GraphQL over HTTP" {
		// The status says what happened: ran (200), ran with errors (294,
		// 200 for a legacy client), did not parse (400), did not validate,
		// name an operation or fit its variables (422).
		@test()
		def answersWithStatusAndMediaType() !none {
			let ts = try httptest.Server.start(new Handler(try transportSchema()))
			let ok = try post(ts, "\{\"query\": \"\{ hello \}\"\}")
			assert ok.status == 200 && ok.kind == graphqlJSON && ok.body == "\{\"data\":\{\"hello\":\"Hello, world\"\}\}"
			let withErrors = try post(ts, "\{\"query\": \"\{ hello fail \}\"\}")
			assert withErrors.status == 294 && withErrors.kind == graphqlJSON && withErrors.body.contains("no luck")
			let legacy = try post(ts, "\{\"query\": \"\{ hello fail \}\"\}", "application/json")
			assert legacy.status == 200 && legacy.kind == "application/json; charset=utf-8"
			let preferred = try post(ts, "\{\"query\": \"\{ hello \}\"\}", "application/graphql-response+json, application/json;q=0.9")
			assert preferred.kind == graphqlJSON
			let unparsed = try post(ts, "\{\"query\": \"\{\"\}")
			assert unparsed.status == 400 && unparsed.kind == graphqlJSON && unparsed.body.contains("Syntax Error")
			let invalid = try post(ts, "\{\"query\": \"\{ nope \}\"\}")
			assert invalid.status == 422 && invalid.kind == graphqlJSON && invalid.body.contains("Cannot query field")
			let unnamed = try post(ts, "\{\"query\": \"query A \{ hello \} query B \{ hello \}\"\}")
			assert unnamed.status == 422
			let coerced = try post(ts, "\{\"query\": \"mutation($n: Int!) \{ add(n: $n) \}\", \"variables\": \{\"n\": \"x\"\}\}")
			assert coerced.status == 422 && coerced.body.contains("Variable")
			let legacyInvalid = try post(ts, "\{\"query\": \"\{ nope \}\"\}", "application/json")
			assert legacyInvalid.status == 422 && legacyInvalid.kind == graphqlJSON
			let named = try post(ts, "\{\"query\": \"query A \{ hello \} query B \{ count \}\", \"operationName\": \"A\", \"extensions\": \{\"x\": 1\}, \"unknown\": true\}")
			assert named.status == 200 && named.body == "\{\"data\":\{\"hello\":\"Hello, world\"\}\}"
			return none
		}

		// The handler serves a context directly too, as a mux calls it; the
		// context function's value reaches the resolvers.
		@test()
		def servesWithoutAServer() !none {
			let schema = try parseSchema("type Query \{ who: String \}")
			try schema.resolve("Query", "who", def (info ResolveInfo) !any {
				return info.context
			})
			let handler = new Handler(schema)
			handler.context = def (ctx http.Context) !any {
				return ctx.header("X-User")
			}
			let rec = new httptest.ResponseRecorder()
			let req = try httptest.newJSONRequest(Method.POST, "/graphql", map<string, any>{"query": "\{ who \}"})
			req.headers.set("X-User", "ada")
			try handler.serve(rec.context(req))
			assert rec.status == 200 && rec.text() == "\{\"data\":\{\"who\":\"ada\"\}\}"
			return none
		}

		// A request GraphQL over HTTP does not allow is refused before it
		// runs.
		@test()
		def refusesMalformedRequests() !none {
			let ts = try httptest.Server.start(new Handler(try transportSchema()))
			let target = ts.url + "/graphql"
			let accept = "application/graphql-response+json"
			assert (try send(Method.POST, target, "", accept, "\{\"query\": \"\{ hello \}\"\}")).status == 415
			assert (try send(Method.POST, target, "text/plain", accept, "\{ hello \}")).status == 415
			assert (try send(Method.POST, target, "application/json; charset=latin1", accept, "\{\"query\": \"\{ hello \}\"\}")).status == 415
			assert (try send(Method.POST, target, "application/json", accept, "\{\"query\":")).status == 400
			assert (try send(Method.POST, target, "application/json", accept, "[1]")).status == 422
			assert (try send(Method.POST, target, "application/json", accept, "\{\"qeury\": \"\{ hello \}\"\}")).status == 422
			assert (try send(Method.POST, target, "application/json", accept, "\{\"query\": \"\{ hello \}\", \"variables\": [7]\}")).status == 422
			assert (try send(Method.POST, target, "application/json", "text/html", "\{\"query\": \"\{ hello \}\"\}")).status == 406
			let put = try send(Method.PUT, target, "application/json", accept, "\{\"query\": \"\{ hello \}\"\}")
			assert put.status == 405 && put.allow == "GET, POST"
			let accepted = try send(Method.POST, target, "application/json", accept, "\{\"query\": \"\{ hello \}\"\}")
			assert accepted.status == 200
			return none
		}

		// A GET runs queries from the URL; a mutation over GET is refused
		// with 405.
		@test()
		def servesQueriesOverGet() !none {
			let ts = try httptest.Server.start(new Handler(try transportSchema()))
			let accept = "application/graphql-response+json"
			let ok = try send(Method.GET, ts.url + "/graphql?query=" + url.queryEscape("query($n: String) \{ hello(name: $n) \}") + "&variables=" + url.queryEscape("\{\"n\": \"Ada\"\}") + "&operationName=", "", accept, "")
			assert ok.status == 200 && ok.body == "\{\"data\":\{\"hello\":\"Hello, Ada\"\}\}"
			let mutation = try send(Method.GET, ts.url + "/graphql?query=" + url.queryEscape("mutation \{ add(n: 1) \}"), "", accept, "")
			assert mutation.status == 405 && mutation.allow == "POST"
			let missing = try send(Method.GET, ts.url + "/graphql", "", accept, "")
			assert missing.status == 422
			let badVariables = try send(Method.GET, ts.url + "/graphql?query=" + url.queryEscape("\{ hello \}") + "&variables=%7B", "", accept, "")
			assert badVariables.status == 400
			let postOnly = new Handler(try transportSchema())
			postOnly.allowGet = false
			let ts2 = try httptest.Server.start(postOnly)
			let get = try send(Method.GET, ts2.url + "/graphql?query=" + url.queryEscape("\{ hello \}"), "", accept, "")
			assert get.status == 405 && get.allow == "POST"
			return none
		}

		// The client sends GraphQL over HTTP, reads both media types and
		// decodes data into a typed value.
		@test()
		def clientExecutesAndDecodes() !none {
			let ts = try httptest.Server.start(new Handler(try transportSchema()))
			let client = new Client(ts.url + "/graphql")
			let response = try client.execute("query($n: String) \{ hello(name: $n) count \}", map<string, any>{"n": "Ada"})
			assert response.errors.len() == 0
			let greeting = new TransportGreeting()
			try response.decode(greeting)
			assert greeting.hello == "Hello, Ada" && greeting.count == 0
			let added = try client.execute("mutation \{ add(n: 5) \}")
			assert added.json() == "\{\"data\":\{\"add\":5\}\}"
			let invalid = try client.execute("\{ nope \}")
			assert invalid.errors.len() == 1 && invalid.errors[0].message == "Cannot query field \"nope\" on type \"Query\"." && invalid.errors[0].locations[0].column == 3
			assert invalid.decode(greeting) is error
			let plain = try httptest.Server.start(http.notFoundHandler())
			let nowhere = new Client(plain.url + "/graphql")
			assert nowhere.execute("\{ hello \}") is error
			return none
		}

		// Subscriptions and single results over graphql-transport-ws, shared
		// on one socket.
		@test()
		def clientSubscribesOverWebSocket() !none {
			let ts = try httptest.Server.start(new Handler(try transportSchema()))
			let client = new Client(ts.url + "/graphql")
			let first = try client.subscribe("subscription \{ tick(upTo: 3) \}")
			let second = try client.subscribe("subscription \{ tick(upTo: 2) \}")
			let got string[] = []
			for let response in first.responses {
				got.push(response.json())
			}
			assert got.join("|") == "\{\"data\":\{\"tick\":1\}\}|\{\"data\":\{\"tick\":2\}\}|\{\"data\":\{\"tick\":3\}\}"
			let more string[] = []
			for let response in second.responses {
				more.push(response.json())
			}
			assert more.len() == 2
			let query = try client.subscribe("\{ hello \}")
			let answers string[] = []
			for let response in query.responses {
				answers.push(response.json())
			}
			assert answers.join("|") == "\{\"data\":\{\"hello\":\"Hello, world\"\}\}"
			let invalid = try client.subscribe("subscription \{ nope \}")
			let errors string[] = []
			for let response in invalid.responses {
				errors.push(response.errors[0].message)
			}
			assert errors.join("|") == "Cannot query field \"nope\" on type \"Subscription\"."
			let stopped = try client.subscribe("subscription \{ tick(upTo: 3) \}")
			stopped.close()
			client.close()
			return none
		}

		// Every close code of the protocol: 4400 for a message it has no
		// place for, 4401 for an operation before the acknowledgement, 4403
		// for a connection onConnect refuses, 4408 for no init in time, 4409
		// for an id running twice, 4429 for a second init; ping gets pong.
		@test()
		def closesSocketsAsTheProtocolSays() !none {
			let handler = new Handler(try transportSchema())
			handler.initTimeout = 300ms
			handler.onConnect = def (_ http.Context, payload map<string, any>) !any {
				fail "no token" unless payload.hasKey("token")
				return payload["token"]
			}
			let ts = try httptest.Server.start(handler)
			let init = "\{\"type\":\"connection_init\",\"payload\":\{\"token\":\"t\"\}\}"
			let timeout = try rawSocket(ts)
			assert closeCodeOf(timeout) == 4408
			let early = try rawSocket(ts)
			try early.writeText("\{\"id\":\"1\",\"type\":\"subscribe\",\"payload\":\{\"query\":\"\{ hello \}\"\}\}")
			assert closeCodeOf(early) == 4401
			let refused = try rawSocket(ts)
			try refused.writeText("\{\"type\":\"connection_init\"\}")
			assert closeCodeOf(refused) == 4403
			let twice = try rawSocket(ts)
			try twice.writeText(init)
			assert (try twice.readText()) == "\{\"type\":\"connection_ack\"\}"
			try twice.writeText("\{\"type\":\"ping\"\}")
			assert (try twice.readText()) == "\{\"type\":\"pong\"\}"
			try twice.writeText(init)
			assert closeCodeOf(twice) == 4429
			let garbage = try rawSocket(ts)
			try garbage.writeText(init)
			try garbage.readText()
			try garbage.writeText("\{\"type\":\"what\"\}")
			assert closeCodeOf(garbage) == 4400
			let duplicate = try rawSocket(ts)
			try duplicate.writeText(init)
			try duplicate.readText()
			let forever = "\{\"id\":\"a\",\"type\":\"subscribe\",\"payload\":\{\"query\":\"subscription \{ forever \}\"\}\}"
			try duplicate.writeText(forever)
			try duplicate.writeText(forever)
			assert closeCodeOf(duplicate) == 4409
			// A completed id may be used again.
			let reuse = try rawSocket(ts)
			try reuse.writeText(init)
			try reuse.readText()
			try reuse.writeText(forever)
			try reuse.writeText("\{\"id\":\"a\",\"type\":\"complete\"\}")
			try reuse.writeText("\{\"id\":\"a\",\"type\":\"subscribe\",\"payload\":\{\"query\":\"\{ hello \}\"\}\}")
			assert (try reuse.readText()) == "\{\"id\":\"a\",\"type\":\"next\",\"payload\":\{\"data\":\{\"hello\":\"Hello, world\"\}\}\}"
			assert (try reuse.readText()) == "\{\"id\":\"a\",\"type\":\"complete\"\}"
			try reuse.close()
			return none
		}
	}

	internal struct TransportGreeting {
		hello string
		count int
	}
}
