partial module std.net.graphql {
	use (
		std.net.graphql.syntax
		std.net.graphql.syntax::(Node, NodeKind)
	)

	// The source of a `__Type` value: a type reference in a schema.
	internal struct IntroType {
		schema Schema
		ref    Node
	}

	// The source of a `__Field`.
	internal struct IntroField {
		schema Schema
		field  FieldDef
	}

	// The source of an `__InputValue`.
	internal struct IntroInput {
		schema Schema
		input  InputDef
	}

	// The source of a `__Directive`.
	internal struct IntroDirective {
		schema    Schema
		directive DirectiveDef
	}

	// The fields of the introspection types (spec 4.2).
	internal def introspect(schema Schema, typeName string, fieldName string, info ResolveInfo) !any {
		let source = info.source
		let includeDeprecated = info.arg("includeDeprecated")
		let all = includeDeprecated is bool && includeDeprecated
		match typeName {
			case "__Schema":
				match fieldName {
					case "description":
						return none when schema.description == ""
						return schema.description
					case "types":
						return schema.order.mapElem(n => IntroType{schema: schema, ref: namedRef(n)})
					case "queryType":
						return IntroType{schema: schema, ref: namedRef(schema.queryType)}
					case "mutationType":
						return none when schema.mutationType == ""
						return IntroType{schema: schema, ref: namedRef(schema.mutationType)}
					case "subscriptionType":
						return none when schema.subscriptionType == ""
						return IntroType{schema: schema, ref: namedRef(schema.subscriptionType)}
					default:
						let out any[] = []
						for let (_, d) in schema.directives {
							out.push(IntroDirective{schema: schema, directive: d})
						}
						return out
				}
			case "__Type":
				return try introspectType(source, fieldName, all)
			case "__Field":
				return none unless source is IntroField
				let f = source.field
				match fieldName {
					case "name":
						return f.name
					case "description":
						return none when f.description == ""
						return f.description
					case "args":
						return f.args.filter(a => all || a.deprecated is none).mapElem(a => IntroInput{schema: source.schema, input: a})
					case "type":
						return IntroType{schema: source.schema, ref: f.typeRef}
					case "isDeprecated":
						return !(f.deprecated is none)
					default:
						let reason = f.deprecated
						return none when reason is none
						return reason
				}
			case "__InputValue":
				return none unless source is IntroInput
				let a = source.input
				match fieldName {
					case "name":
						return a.name
					case "description":
						return none when a.description == ""
						return a.description
					case "type":
						return IntroType{schema: source.schema, ref: a.typeRef}
					case "defaultValue":
						let d = a.defaultValue
						return none when d is none
						return syntax.print(d)
					case "isDeprecated":
						return !(a.deprecated is none)
					default:
						let reason = a.deprecated
						return none when reason is none
						return reason
				}
			case "__EnumValue":
				return none unless source is EnumValueDef
				match fieldName {
					case "name":
						return source.name
					case "description":
						return none when source.description == ""
						return source.description
					case "isDeprecated":
						return !(source.deprecated is none)
					default:
						let reason = source.deprecated
						return none when reason is none
						return reason
				}
			case "__Directive":
				return none unless source is IntroDirective
				let d = source.directive
				match fieldName {
					case "name":
						return d.name
					case "description":
						return none when d.description == ""
						return d.description
					case "locations":
						return d.locations
					case "args":
						return d.args.filter(a => all || a.deprecated is none).mapElem(a => IntroInput{schema: source.schema, input: a})
					default:
						return d.repeatable
				}
			default:
				return none
		}
	}

	internal def introspectType(source any, fieldName string, all bool) !any {
		return none unless source is IntroType
		let schema = source.schema
		let ref = source.ref
		if ref.kind != NodeKind.NamedType {
			match fieldName {
				case "kind":
					return ref.kind == NodeKind.ListType ?? ("LIST", "NON_NULL")
				case "ofType":
					return IntroType{schema: schema, ref: inner(ref)}
				default:
					return none
			}
		}
		let t = schema.types.get(ref.name)
		return none when t is none
		match fieldName {
			case "kind":
				let kinds = ["SCALAR", "OBJECT", "INTERFACE", "UNION", "ENUM", "INPUT_OBJECT"]
				return kinds[t.kind.value]
			case "name":
				return t.name
			case "description":
				return none when t.description == ""
				return t.description
			case "specifiedByURL":
				return none when t.specifiedBy == ""
				return t.specifiedBy
			case "fields":
				return none unless t.kind == TypeKind.Object || t.kind == TypeKind.Interface
				return t.fields.filter(f => all || f.deprecated is none).mapElem(f => IntroField{schema: schema, field: f})
			case "interfaces":
				return none unless t.kind == TypeKind.Object || t.kind == TypeKind.Interface
				return t.interfaces.mapElem(n => IntroType{schema: schema, ref: namedRef(n)})
			case "possibleTypes":
				return none unless t.isAbstract()
				return possibleTypes(schema, t).mapElem(p => IntroType{schema: schema, ref: namedRef(p.name)})
			case "enumValues":
				return none unless t.kind == TypeKind.Enum
				return t.values.filter(v => all || v.deprecated is none)
			case "inputFields":
				return none unless t.kind == TypeKind.InputObject
				return t.inputFields.filter(f => all || f.deprecated is none).mapElem(f => IntroInput{schema: schema, input: f})
			case "isOneOf":
				return none unless t.kind == TypeKind.InputObject
				return t.oneOf
			default:
				return none
		}
	}
}
