internal std.net.graphql partial module std.net.graphql.syntax {
	// Parses a whole document. Fails with a SyntaxError at the first token
	// the grammar does not allow, or for a document with no definition.
	def parseDocument(source string) !Node {
		let p = new Parser(source)
		try p.next()
		let doc = new Node(NodeKind.Document)
		for {
			doc.items.push(try p.definition())
			break when p.tok.kind == TokenKind.End
		}
		return doc
	}

	// Parses one value on its own, variables allowed unless constant.
	def parseValueText(source string, constant bool) !Node {
		let p = new Parser(source)
		try p.next()
		let v = try p.valueLiteral(constant)
		try p.expectEnd()
		return v
	}

	// Parses one type reference on its own (`[Int!]!`).
	def parseTypeText(source string) !Node {
		let p = new Parser(source)
		try p.next()
		let t = try p.typeReference()
		try p.expectEnd()
		return t
	}

	// The parser follows graphql-js 17's order of decisions, so that a
	// document it refuses fails with the same message at the same place; the
	// grammar is the specification's (graphql-js's directive extensions,
	// directives on directive definitions and fragment arguments are not).
	internal type Parser {
		lexer Lexer
		tok   Token

		def new(source string) {
			lexer = new Lexer(source)
			tok = Token{kind: TokenKind.End}
		}

		def next() !none {
			tok = try lexer.advance()
			return none
		}

		def expectEnd() !none {
			fail unexpected(tok) unless tok.kind == TokenKind.End
			return none
		}

		// A token as graphql-js names it: `<EOF>`, `"{"`, `Name "x"`.
		def describe(t Token) string {
			match t.kind {
				case TokenKind.End:
					return "<EOF>"
				case TokenKind.Punctuator:
					return "\"{t.text}\""
				case TokenKind.Name:
					return "Name \"{t.text}\""
				case TokenKind.Int:
					return "Int \"{t.text}\""
				case TokenKind.Float:
					return "Float \"{t.text}\""
				case TokenKind.String:
					return "String \"{t.text}\""
				default:
					return "BlockString \"{t.text}\""
			}
		}

		def unexpected(t Token) SyntaxError {
			return lexer.errorAt("Unexpected {describe(t)}.", t.start)
		}

		def at(text string) bool {
			return tok.kind == TokenKind.Punctuator && tok.text == text
		}

		def atKeyword(word string) bool {
			return tok.kind == TokenKind.Name && tok.text == word
		}

		def expect(text string) !none {
			fail lexer.errorAt("Expected \"{text}\", found {describe(tok)}.", tok.start) unless at(text)
			return try next()
		}

		// Moves past the punctuator when it comes next.
		def skip(text string) !bool {
			return false unless at(text)
			try next()
			return true
		}

		def expectKeyword(word string) !none {
			fail lexer.errorAt("Expected \"{word}\", found {describe(tok)}.", tok.start) unless atKeyword(word)
			return try next()
		}

		// Moves past the keyword when it comes next.
		def skipKeyword(word string) !bool {
			return false unless atKeyword(word)
			try next()
			return true
		}

		def node(kind NodeKind) Node {
			let n = new Node(kind)
			n.start = tok.start
			n.line = tok.line
			n.column = tok.column
			return n
		}

		def name() !string {
			fail lexer.errorAt("Expected Name, found {describe(tok)}.", tok.start) unless tok.kind == TokenKind.Name
			let text = tok.text
			try next()
			return text
		}

		def atDescription() bool {
			return tok.kind == TokenKind.String || tok.kind == TokenKind.BlockString
		}

		def definition() !Node {
			return try operation() when at("\{")
			let described = atDescription()
			let keyword = described ?? (try lexer.lookahead(), tok)
			fail lexer.errorAt("Unexpected description, descriptions are not supported on shorthand queries.", tok.start) when described && keyword.kind == TokenKind.Punctuator && keyword.text == "\{"
			if keyword.kind == TokenKind.Name {
				match keyword.text {
					case "schema", "scalar", "type", "interface", "union", "enum", "input", "directive":
						return try typeSystemDefinition(keyword.text)
					case "query", "mutation", "subscription":
						return try operation()
					case "fragment":
						return try fragmentDefinition()
					default:
				}
				fail lexer.errorAt("Unexpected description, only GraphQL definitions support descriptions.", tok.start) when described
				return try extension() when keyword.text == "extend"
			}
			fail unexpected(keyword)
		}

		def operation() !Node {
			let n = node(NodeKind.OperationDefinition)
			n.text = "query"
			if at("\{") {
				try selectionSet(n)
				return n
			}
			n.description = try description()
			n.text = try operationType()
			n.name = try name() when tok.kind == TokenKind.Name
			if try skip("(") {
				for {
					n.items.push(try variableDefinition())
					break when try skip(")")
				}
			}
			n.directives = try directives(false)
			try selectionSet(n)
			return n
		}

		def operationType() !string {
			let t = tok
			let word = try name()
			fail unexpected(t) unless word := "query" || "mutation" || "subscription"
			return word
		}

		def variableDefinition() !Node {
			let v = node(NodeKind.VariableDefinition)
			v.description = try description()
			try expect("$")
			v.name = try name()
			try expect(":")
			v.typeRef = try typeReference()
			v.value = try valueLiteral(true) when try skip("=")
			v.directives = try directives(true)
			return v
		}

		def fragmentDefinition() !Node {
			let n = node(NodeKind.FragmentDefinition)
			n.description = try description()
			try expectKeyword("fragment")
			fail unexpected(tok) when tok.text == "on" && (tok.kind := TokenKind.Name || TokenKind.String || TokenKind.BlockString)
			n.name = try name()
			try expectKeyword("on")
			n.text = try name()
			n.directives = try directives(false)
			try selectionSet(n)
			return n
		}

		def selectionSet(owner Node) !none {
			try expect("\{")
			owner.hasSelections = true
			for {
				owner.selections.push(try selection())
				break when try skip("\}")
			}
			return none
		}

		def selection() !Node {
			if at("...") {
				let fragment = node(NodeKind.InlineFragment)
				try next()
				let conditioned = try skipKeyword("on")
				if !conditioned && tok.kind == TokenKind.Name {
					fragment.kind = NodeKind.FragmentSpread
					fragment.name = try name()
					fragment.directives = try directives(false)
					return fragment
				}
				fragment.text = try name() when conditioned
				fragment.directives = try directives(false)
				try selectionSet(fragment)
				return fragment
			}
			let f = node(NodeKind.Field)
			let first = try name()
			if try skip(":") {
				f.alias = first
				f.name = try name()
			} else {
				f.name = first
			}
			f.arguments = try arguments(false)
			f.directives = try directives(false)
			try selectionSet(f) when at("\{")
			return f
		}

		def arguments(constant bool) !Node[] {
			let out Node[] = []
			return out unless try skip("(")
			for {
				let a = node(NodeKind.Argument)
				a.name = try name()
				try expect(":")
				a.value = try valueLiteral(constant)
				out.push(a)
				break when try skip(")")
			}
			return out
		}

		def directives(constant bool) !Node[] {
			let out Node[] = []
			for at("@") {
				let d = node(NodeKind.Directive)
				try next()
				d.name = try name()
				d.arguments = try arguments(constant)
				out.push(d)
			}
			return out
		}

		def valueLiteral(constant bool) !Node {
			let n = node(NodeKind.NullValue)
			let t = tok
			match tok.kind {
				case TokenKind.Int:
					n.kind = NodeKind.IntValue
					n.text = tok.text
					try next()
					return n
				case TokenKind.Float:
					n.kind = NodeKind.FloatValue
					n.text = tok.text
					try next()
					return n
				case TokenKind.String, TokenKind.BlockString:
					n.kind = NodeKind.StringValue
					n.text = tok.text
					n.block = tok.kind == TokenKind.BlockString
					try next()
					return n
				case TokenKind.Name:
					if tok.text := "true" || "false" {
						n.kind = NodeKind.BooleanValue
					} else if tok.text != "null" {
						n.kind = NodeKind.EnumValue
					}
					n.text = tok.text
					try next()
					return n
				default:
			}
			if at("$") {
				try next()
				if constant {
					fail lexer.errorAt("Unexpected variable \"${tok.text}\" in constant value.", t.start) when tok.kind == TokenKind.Name
					fail unexpected(t)
				}
				n.kind = NodeKind.Variable
				n.name = try name()
				return n
			}
			if try skip("[") {
				n.kind = NodeKind.ListValue
				for !(try skip("]")) {
					n.items.push(try valueLiteral(constant))
				}
				return n
			}
			if try skip("\{") {
				n.kind = NodeKind.ObjectValue
				for !(try skip("\}")) {
					let field = node(NodeKind.ObjectField)
					field.name = try name()
					try expect(":")
					field.value = try valueLiteral(constant)
					n.items.push(field)
				}
				return n
			}
			fail unexpected(tok)
		}

		def typeReference() !Node {
			let t = node(NodeKind.NamedType)
			if try skip("[") {
				t.kind = NodeKind.ListType
				t.typeRef = try typeReference()
				try expect("]")
			} else {
				t.name = try name()
			}
			if at("!") {
				let nn = node(NodeKind.NonNullType)
				try next()
				nn.typeRef = t
				nn.start = t.start
				nn.line = t.line
				nn.column = t.column
				return nn
			}
			return t
		}

		def description() !?Node {
			return none unless atDescription()
			let d = node(NodeKind.StringValue)
			d.text = tok.text
			d.block = tok.kind == TokenKind.BlockString
			try next()
			return d
		}

		def namedType() !Node {
			let t = node(NodeKind.NamedType)
			t.name = try name()
			return t
		}

		// `& A & B` after `implements`, or `| A | B` after `=`: a leading
		// delimiter allowed.
		def delimited(delimiter string) !Node[] {
			try skip(delimiter)
			let out Node[] = []
			for {
				out.push(try namedType())
				break unless try skip(delimiter)
			}
			return out
		}

		// `{ … }` or `( … )` holding at least one item when present.
		def listOf(open string, close string, item def () !Node) !(Node[], bool) {
			return ([], false) unless try skip(open)
			let out Node[] = []
			for {
				out.push(try item())
				break when try skip(close)
			}
			return (out, true)
		}

		def typeSystemDefinition(keyword string) !Node {
			let n = node(NodeKind.SchemaDefinition)
			n.description = try description()
			try body(n, keyword, false)
			return n
		}

		def extension() !Node {
			let n = node(NodeKind.SchemaExtension)
			let keyword = try lexer.lookahead()
			fail unexpected(keyword) unless keyword.kind == TokenKind.Name && (keyword.text := "schema" || "scalar" || "type" || "interface" || "union" || "enum" || "input")
			try expectKeyword("extend")
			try body(n, keyword.text, true)
			return n
		}

		// The rest of the definition or extension that starts with the
		// keyword. An extension that adds nothing fails at the token after
		// it.
		def body(n Node, keyword string, extension bool) !none {
			try expectKeyword(keyword)
			match keyword {
				case "schema":
					n.kind = extension ?? (NodeKind.SchemaExtension, NodeKind.SchemaDefinition)
					n.directives = try directives(true)
					if extension {
						let (types, given) = try listOf("\{", "\}", () => operationTypeDefinition())
						n.items = types
						fail unexpected(tok) when !given && n.directives.len() == 0
					} else {
						try expect("\{")
						for {
							n.items.push(try operationTypeDefinition())
							break when try skip("\}")
						}
					}
				case "scalar":
					n.kind = extension ?? (NodeKind.ScalarTypeExtension, NodeKind.ScalarTypeDefinition)
					n.name = try name()
					n.directives = try directives(true)
					fail unexpected(tok) when extension && n.directives.len() == 0
				case "type", "interface":
					n.kind = keyword == "type" ?? (extension ?? (NodeKind.ObjectTypeExtension, NodeKind.ObjectTypeDefinition), extension ?? (NodeKind.InterfaceTypeExtension, NodeKind.InterfaceTypeDefinition))
					n.name = try name()
					n.interfaces = try delimited("&") when try skipKeyword("implements")
					n.directives = try directives(true)
					let (fields, given) = try listOf("\{", "\}", () => fieldDefinition())
					n.items = fields
					fail unexpected(tok) when extension && !given && n.directives.len() == 0 && n.interfaces.len() == 0
				case "union":
					n.kind = extension ?? (NodeKind.UnionTypeExtension, NodeKind.UnionTypeDefinition)
					n.name = try name()
					n.directives = try directives(true)
					n.items = try delimited("|") when try skip("=")
					fail unexpected(tok) when extension && n.items.len() == 0 && n.directives.len() == 0
				case "enum":
					n.kind = extension ?? (NodeKind.EnumTypeExtension, NodeKind.EnumTypeDefinition)
					n.name = try name()
					n.directives = try directives(true)
					let (values, given) = try listOf("\{", "\}", () => enumValueDefinition())
					n.items = values
					fail unexpected(tok) when extension && !given && n.directives.len() == 0
				case "input":
					n.kind = extension ?? (NodeKind.InputObjectTypeExtension, NodeKind.InputObjectTypeDefinition)
					n.name = try name()
					n.directives = try directives(true)
					let (fields, given) = try listOf("\{", "\}", () => inputValueDefinition())
					n.items = fields
					fail unexpected(tok) when extension && !given && n.directives.len() == 0
				default:
					n.kind = NodeKind.DirectiveDefinition
					try expect("@")
					n.name = try name()
					let (args, _) = try listOf("(", ")", () => inputValueDefinition())
					n.arguments = args
					n.repeatable = try skipKeyword("repeatable")
					try expectKeyword("on")
					try skip("|")
					for {
						let start = tok
						let loc = node(NodeKind.NamedType)
						loc.name = try name()
						fail unexpected(start) unless directiveLocations.includes(loc.name)
						n.items.push(loc)
						break unless try skip("|")
					}
			}
			return none
		}

		def operationTypeDefinition() !Node {
			let op = node(NodeKind.OperationTypeDefinition)
			op.text = try operationType()
			try expect(":")
			op.name = try name()
			return op
		}

		def fieldDefinition() !Node {
			let f = node(NodeKind.FieldDefinition)
			f.description = try description()
			f.name = try name()
			let (args, _) = try listOf("(", ")", () => inputValueDefinition())
			f.arguments = args
			try expect(":")
			f.typeRef = try typeReference()
			f.directives = try directives(true)
			return f
		}

		def inputValueDefinition() !Node {
			let v = node(NodeKind.InputValueDefinition)
			v.description = try description()
			v.name = try name()
			try expect(":")
			v.typeRef = try typeReference()
			v.value = try valueLiteral(true) when try skip("=")
			v.directives = try directives(true)
			return v
		}

		def enumValueDefinition() !Node {
			let v = node(NodeKind.EnumValueDefinition)
			v.description = try description()
			fail lexer.errorAt("{describe(tok)} is reserved and cannot be used for an enum value.", tok.start) when tok.text := "true" || "false" || "null"
			v.name = try name()
			v.directives = try directives(true)
			return v
		}
	}

	// The locations a directive definition may name.
	const directiveLocations = ["QUERY", "MUTATION", "SUBSCRIPTION", "FIELD", "FRAGMENT_DEFINITION", "FRAGMENT_SPREAD", "INLINE_FRAGMENT", "VARIABLE_DEFINITION", "SCHEMA", "SCALAR", "OBJECT", "FIELD_DEFINITION", "ARGUMENT_DEFINITION", "INTERFACE", "UNION", "ENUM", "ENUM_VALUE", "INPUT_OBJECT", "INPUT_FIELD_DEFINITION"]
}
