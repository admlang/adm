internal std.net.graphql partial module std.net.graphql.syntax {
	// The longest field line before its arguments go one per line.
	internal const maxLineLength = 80

	// Prints a node as graphql-js 17 prints it: two-space indentation, a
	// query that needs no keyword written as its selection set, long
	// argument lists, lists and objects and descriptions over several lines.
	def print(n Node) string {
		match n.kind {
			case NodeKind.Document:
				return joinNonEmpty(n.items.mapElem(d => print(d)), "\n\n")
			case NodeKind.OperationDefinition:
				let printed = n.items.mapElem(v => print(v))
				let varDefs = hasMultiline(printed) ?? (wrap("(\n", joinNonEmpty(printed, "\n"), "\n)"), wrap("(", joinNonEmpty(printed, ", "), ")"))
				let prefix = describe(n) + joinNonEmpty([n.text, joinNonEmpty([n.name, varDefs], ""), printList(n.directives, " ")], " ")
				return (prefix == "query" ?? ("", prefix + " ")) + printSelections(n)
			case NodeKind.VariableDefinition:
				return describe(n) + "$" + n.name + ": " + printRef(n.typeRef) + wrap(" = ", printOptional(n.value), "") + wrap(" ", printList(n.directives, " "), "")
			case NodeKind.SelectionSet:
				return printSelections(n)
			case NodeKind.Field:
				let prefix = wrap("", n.alias, ": ") + n.name
				let argsLine = prefix + wrap("(", printList(n.arguments, ", "), ")")
				argsLine = prefix + wrap("(\n", indent(printList(n.arguments, "\n")), "\n)") when utf16Length(argsLine) > maxLineLength
				return joinNonEmpty([argsLine, printList(n.directives, " "), printSelections(n)], " ")
			case NodeKind.Argument, NodeKind.ObjectField:
				return n.name + ": " + printOptional(n.value)
			case NodeKind.FragmentSpread:
				return "..." + n.name + wrap(" ", printList(n.directives, " "), "")
			case NodeKind.InlineFragment:
				return joinNonEmpty(["...", wrap("on ", n.text, ""), printList(n.directives, " "), printSelections(n)], " ")
			case NodeKind.FragmentDefinition:
				return describe(n) + "fragment " + n.name + " on " + n.text + " " + wrap("", printList(n.directives, " "), " ") + printSelections(n)
			case NodeKind.Variable:
				return "$" + n.name
			case NodeKind.IntValue, NodeKind.FloatValue, NodeKind.BooleanValue, NodeKind.EnumValue:
				return n.text
			case NodeKind.NullValue:
				return "null"
			case NodeKind.StringValue:
				return n.block ?? (printBlockString(n.text), printString(n.text))
			case NodeKind.ListValue:
				let line = "[" + printList(n.items, ", ") + "]"
				return utf16Length(line) > maxLineLength ?? ("[\n" + indent(printList(n.items, "\n")) + "\n]", line)
			case NodeKind.ObjectValue:
				let line = "\{ " + printList(n.items, ", ") + " \}"
				return utf16Length(line) > maxLineLength ?? (block(n.items.mapElem(f => print(f))), line)
			case NodeKind.Directive:
				return "@" + n.name + wrap("(", printList(n.arguments, ", "), ")")
			case NodeKind.NamedType:
				return n.name
			case NodeKind.ListType:
				return "[" + printRef(n.typeRef) + "]"
			case NodeKind.NonNullType:
				return printRef(n.typeRef) + "!"
			case NodeKind.SchemaDefinition, NodeKind.SchemaExtension:
				let head = n.kind == NodeKind.SchemaExtension ?? ("extend schema", "schema")
				return describe(n) + joinNonEmpty([head, printList(n.directives, " "), block(n.items.mapElem(o => o.text + ": " + o.name))], " ")
			case NodeKind.OperationTypeDefinition:
				return n.text + ": " + n.name
			case NodeKind.ScalarTypeDefinition, NodeKind.ScalarTypeExtension:
				return describe(n) + joinNonEmpty([keywordOf(n.kind), n.name, printList(n.directives, " ")], " ")
			case NodeKind.ObjectTypeDefinition, NodeKind.ObjectTypeExtension, NodeKind.InterfaceTypeDefinition, NodeKind.InterfaceTypeExtension:
				return describe(n) + joinNonEmpty([keywordOf(n.kind), n.name, wrap("implements ", printList(n.interfaces, " & "), ""), printList(n.directives, " "), block(n.items.mapElem(f => print(f)))], " ")
			case NodeKind.FieldDefinition:
				return describe(n) + n.name + printArgumentDefinitions(n.arguments) + ": " + printRef(n.typeRef) + wrap(" ", printList(n.directives, " "), "")
			case NodeKind.InputValueDefinition:
				return describe(n) + joinNonEmpty([n.name + ": " + printRef(n.typeRef), wrap("= ", printOptional(n.value), ""), printList(n.directives, " ")], " ")
			case NodeKind.UnionTypeDefinition, NodeKind.UnionTypeExtension:
				return describe(n) + joinNonEmpty([keywordOf(n.kind), n.name, printList(n.directives, " "), wrap("= ", printList(n.items, " | "), "")], " ")
			case NodeKind.EnumTypeDefinition, NodeKind.EnumTypeExtension, NodeKind.InputObjectTypeDefinition, NodeKind.InputObjectTypeExtension:
				return describe(n) + joinNonEmpty([keywordOf(n.kind), n.name, printList(n.directives, " "), block(n.items.mapElem(v => print(v)))], " ")
			case NodeKind.EnumValueDefinition:
				return describe(n) + joinNonEmpty([n.name, printList(n.directives, " ")], " ")
			default:
				return describe(n) + "directive @" + n.name + printArgumentDefinitions(n.arguments) + (n.repeatable ?? (" repeatable", "")) + " on " + n.items.mapElem(l => l.name).join(" | ")
		}
	}

	internal def keywordOf(kind NodeKind) string {
		match kind {
			case NodeKind.ScalarTypeDefinition:
				return "scalar"
			case NodeKind.ScalarTypeExtension:
				return "extend scalar"
			case NodeKind.ObjectTypeDefinition:
				return "type"
			case NodeKind.ObjectTypeExtension:
				return "extend type"
			case NodeKind.InterfaceTypeDefinition:
				return "interface"
			case NodeKind.InterfaceTypeExtension:
				return "extend interface"
			case NodeKind.UnionTypeDefinition:
				return "union"
			case NodeKind.UnionTypeExtension:
				return "extend union"
			case NodeKind.EnumTypeDefinition:
				return "enum"
			case NodeKind.EnumTypeExtension:
				return "extend enum"
			case NodeKind.InputObjectTypeDefinition:
				return "input"
			default:
				return "extend input"
		}
	}

	internal def printArgumentDefinitions(args Node[]) string {
		let printed = args.mapElem(a => print(a))
		return wrap("(\n", indent(joinNonEmpty(printed, "\n")), "\n)") when hasMultiline(printed)
		return wrap("(", joinNonEmpty(printed, ", "), ")")
	}

	internal def hasMultiline(printed string[]) bool {
		for let p in printed {
			return true when p.contains("\n")
		}
		return false
	}

	// The length of text in UTF-16 code units, as graphql-js measures a
	// line: a character beyond U+FFFF counts twice.
	internal def utf16Length(text string) int {
		let n = 0
		for let b in text.bytes() {
			n++ unless b & 0xC0 == 0x80
			n++ when b >= 0xF0
		}
		return n
	}

	internal def describe(n Node) string {
		let d = n.description
		return "" when d is none
		return print(d) + "\n"
	}

	internal def printSelections(n Node) string {
		return "" unless n.hasSelections
		return block(n.selections.mapElem(s => print(s)))
	}

	internal def printList(nodes Node[], separator string) string {
		return joinNonEmpty(nodes.mapElem(x => print(x)), separator)
	}

	internal def printOptional(n ?Node) string {
		return "" when n is none
		return print(n)
	}

	internal def printRef(n ?Node) string {
		return printOptional(n)
	}

	internal def block(items string[]) string {
		return wrap("\{\n", indent(joinNonEmpty(items, "\n")), "\n\}")
	}

	internal def indent(text string) string {
		return wrap("  ", text.replace("\n", "\n  "), "")
	}

	internal def wrap(start string, text string, end string) string {
		return text == "" ?? ("", start + text + end)
	}

	internal def joinNonEmpty(parts string[], separator string) string {
		return parts.filter(p => p != "").join(separator)
	}

	// A string literal: quotes, and escapes for `"`, `\`, the C0 controls
	// and U+007F to U+009F.
	def printString(text string) string {
		let out byte[]
		out.push(34)
		let hex = "0123456789ABCDEF"
		for let c in text {
			let code = int(c)
			match code {
				case 8:
					out += "\\b".bytes()
				case 9:
					out += "\\t".bytes()
				case 10:
					out += "\\n".bytes()
				case 12:
					out += "\\f".bytes()
				case 13:
					out += "\\r".bytes()
				case 34:
					out += "\\\"".bytes()
				case 92:
					out += "\\\\".bytes()
				default:
					if code < 0x20 || (code >= 0x7F && code <= 0x9F) {
						out += ("\\u00" + hex[code >> 4] + hex[code & 15]).bytes()
					} else {
						out += string(c).bytes()
					}
			}
		}
		out.push(34)
		return string(out)
	}

	// A block string literal as graphql-js prints one: `"""` escaped, on
	// its own lines when it has several or would read back differently on
	// one.
	def printBlockString(value string) string {
		let escaped = value.replace("\"\"\"", "\\\"\"\"")
		let lines = splitLines(escaped)
		let single = lines.len() == 1
		let forceLeading = false
		if lines.len() > 1 {
			forceLeading = true
			for let i = 1; i < lines.len(); i++ {
				forceLeading = false unless lines[i] == "" || lines[i].startsWith(" ") || lines[i].startsWith("\t")
			}
		}
		let trailingTriple = escaped.endsWith("\\\"\"\"")
		let trailingQuote = value.endsWith("\"") && !trailingTriple
		let trailingSlash = value.endsWith("\\")
		let forceTrailing = trailingQuote || trailingSlash
		let multiple = !single || value.len() > 70 || forceTrailing || forceLeading || trailingTriple
		let skipLeading = single && (value.startsWith(" ") || value.startsWith("\t"))
		let out = ""
		out += "\n" when (multiple && !skipLeading) || forceLeading
		out += escaped
		out += "\n" when multiple || forceTrailing
		return "\"\"\"" + out + "\"\"\""
	}
}
