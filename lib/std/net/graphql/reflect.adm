partial module std.net.graphql {
	use (
		std.time
		std.reflection
		std.reflection::(AttrHit, DiscoveryMetaContext, FieldKind, FieldMetaContext, FunctionDescriptor, MethodMetaContext, TypeDescriptor, TypeMetaContext)
		std.data.encoding.jsonschema
		std.net.graphql.syntax
		std.net.graphql.syntax::(Node, NodeKind)
	)

	// Names, describes or hides a field in a schema built by schemaOf:
	//
	//     name         the GraphQL name instead of the field's
	//     description  instead of the doc comment
	//     deprecated   the reason the field is deprecated
	//     ignore       leave the field out
	//
	// A field's doc comment is its description only when the field carries
	// an annotation (an unannotated field's comment is not kept); `@graphql()`
	// keeps it.
	meta def graphql(ctx FieldMetaContext, name string = "", description string = "", deprecated string = "", ignore bool = false) {}

	// Exposes a method as a field of its type in a schema built by schemaOf;
	// its parameters become the field's arguments (one with a default or of
	// an optional type is optional), their `@param` texts the arguments'
	// descriptions. A parameter of type ResolveInfo is not an argument: it
	// receives the field's resolve information, with the request's context.
	// Takes the field form's options but `ignore`.
	meta def graphql(ctx DiscoveryMetaContext<MethodMetaContext>, name string = "", description string = "", deprecated string = "") {}

	// Names or describes a type, struct or enum in a schema built by
	// schemaOf; its doc comment is the description otherwise.
	meta def graphql(ctx DiscoveryMetaContext<TypeMetaContext>, name string = "", description string = "") {}

	internal const graphqlAnnotation = "std.net.graphql.graphql"
	internal const resolveInfoType = "std.net.graphql.ResolveInfo"

	// schemaOf builds a schema from the program's own types: the query
	// value's type is the query type (the mutation's the mutation type when
	// given), each public field of an object a field, each method marked
	// `@graphql` a field whose parameters are its arguments, and the types
	// they reach object and enum types; a struct or type that a method takes
	// is an input type (named with `Input` after its name). An optional
	// (`?T`) is nullable, anything else non-null; arrays are lists; `string`
	// is String, `bool` Boolean, integers Int, floats Float, `time.Time` the
	// DateTime scalar (RFC 3339 text) and `any` the JSON scalar (any JSON
	// value). The values given are the root values execute starts from.
	//
	// The subscription value's type is the subscription type: each of its
	// `@graphql` methods returns a `channel<T>` and is a field of type T,
	// subscribed to by calling the method; every value it sends is one
	// event, the field's value for that event's response, until the
	// channel is closed.
	//
	// Fails on a type GraphQL cannot express (a map, a tuple, a union, an
	// interface: write those as SDL for parseSchema), an object with no field
	// to show, a subscription method that does not return a channel, or one
	// name given to two types.
	def schemaOf(query any, mutation any = none, subscription any = none) !Schema {
		let b = new SchemaBuilder()
		let schema = b.schema
		try addDefinitions(schema, try syntax.parseDocument(string(builtinSDL)), true)
		schema.queryType = try b.objectType(try rootDescriptor(query, "query"))
		schema.queryRoot = query
		if !(mutation is none) {
			schema.mutationType = try b.objectType(try rootDescriptor(mutation, "mutation"))
			schema.mutationRoot = mutation
		}
		if !(subscription is none) {
			schema.subscriptionType = try b.subscriptionType(try rootDescriptor(subscription, "subscription"))
			schema.subscriptionRoot = subscription
		}
		try validateSchema(schema)
		return schema
	}

	internal def rootDescriptor(value any, role string) !TypeDescriptor {
		let d = reflection.descriptorOf(value)
		fail schemaError("the {role} value has no type schemaOf can read") when d is none
		return d
	}

	// Builds the types of schemaOf from type descriptors.
	internal type SchemaBuilder {
		schema  Schema
		// GraphQL type name → the ADM type (and use) it was built for.
		built   map<string, string>
		// The `@graphql` annotations on types, by qualified type name.
		types   map<string, AttrHit>
		// The `@graphql` methods, by the qualified name of their type.
		methods map<string, AttrHit[]>

		def new() {
			schema = new Schema()
			built = map<string, string>{}
			types = map<string, AttrHit>{}
			methods = map<string, AttrHit[]>{}
			for let hit in reflection.attrs(graphql) {
				let fn = reflection.asFunction(hit.node)
				if fn is none {
					types[hit.node.qualifiedName] = hit
					continue
				}
				let owner = fn.ownerType.typeName
				methods[owner] = [] unless methods.hasKey(owner)
				methods[owner].push(hit)
			}
		}

		// The GraphQL name of an ADM type: its annotated name, else its own
		// name without the module; input types end in `Input`.
		def nameOf(t TypeDescriptor, input bool) string {
			let parts = t.typeName.split(".")
			let base = parts[parts.len() - 1]
			let hit = types.get(t.typeName)
			if !(hit is none) {
				let annotated = argumentText(hit.attr, "name")
				base = annotated when annotated != ""
			}
			return input ?? (base + "Input", base)
		}

		def descriptionOf(t TypeDescriptor) string {
			let hit = types.get(t.typeName)
			return "" when hit is none
			let annotated = argumentText(hit.attr, "description")
			return annotated == "" ?? (hit.node.doc, annotated)
		}

		// Records that name stands for key; reports whether it was new.
		// Fails when name already stands for another ADM type.
		def claim(name string, key string) !bool {
			let held = built.get(name)
			if !(held is none) {
				return false when held == key
				fail schemaError("\"{name}\" names two types: {held} and {key}")
			}
			built[name] = key
			return true
		}

		def addType(t TypeDef) {
			schema.types[t.name] = t
			schema.order.push(t.name)
		}

		// The GraphQL object type of an ADM struct or type, built on first
		// use.
		def objectType(t TypeDescriptor) !string {
			fail schemaError("{t.typeName} is a scalar, not an object type") unless try scalarOf(t) == ""
			let name = nameOf(t, false)
			return name unless try claim(name, t.typeName)
			let sample = reflection.instantiate(t)
			fail schemaError("{t.typeName} cannot be made, so its fields cannot be read") when sample is none
			let object = new TypeDef(TypeKind.Object, name)
			object.description = descriptionOf(t)
			addType(object)
			for let f in reflection.fields(sample) {
				continue when f.attr(graphqlAnnotation, "ignore") == "true"
				let declared = f.descriptor
				continue when declared is none
				let fieldName = graphqlName(f)
				let field = new FieldDef(fieldName, try outputRef(declared, f.kind == FieldKind.Optional))
				let text = f.attr(graphqlAnnotation, "description")
				field.description = text == "" ?? (f.doc, text)
				deprecate(field, f.attr(graphqlAnnotation, "deprecated"))
				let own = f.name
				if own != fieldName {
					field.resolver = def (info ResolveInfo) !any {
						return defaultResolve(info.source, own)
					}
				}
				object.fields.push(field)
			}
			let marked = methods.get(t.typeName)
			if !(marked is none) {
				for let hit in marked {
					object.fields.push(try methodField(hit))
				}
			}
			fail schemaError("{t.typeName} has no field GraphQL can show") when object.fields.len() == 0
			return name
		}

		// The subscription type: the `@graphql` methods of the value's type,
		// each returning a channel of its field's type.
		def subscriptionType(t TypeDescriptor) !string {
			let name = nameOf(t, false)
			fail schemaError("\"{name}\" names two types: the subscription root and {built[name]}") when built.hasKey(name)
			built[name] = t.typeName + " (subscription)"
			let object = new TypeDef(TypeKind.Object, name)
			object.description = descriptionOf(t)
			addType(object)
			let marked = methods.get(t.typeName)
			if !(marked is none) {
				for let hit in marked {
					let m = reflection.asFunction(hit.node)
					fail schemaError("{hit.node.qualifiedName} is not a method") when m is none
					let result = m.signature.result
					let element = result.element
					fail schemaError("{hit.node.qualifiedName} is a subscription field, so it returns a channel, not {result.typeName}") unless result.kind == reflection.TypeKind.Channel && !(element is none)
					let annotated = argumentText(hit.attr, "name")
					let field = new FieldDef(annotated == "" ?? (m.node.name, annotated), try outputRef(element, false))
					let text = argumentText(hit.attr, "description")
					field.description = text == "" ?? (m.node.doc, text)
					deprecate(field, argumentText(hit.attr, "deprecated"))
					try addArguments(field, m)
					// Each event is the field's value.
					field.resolver = def (info ResolveInfo) !any {
						return info.source
					}
					field.boxedSubscriber = def (info ResolveInfo) !any {
						return try callMethod(m, info)
					}
					object.fields.push(field)
				}
			}
			fail schemaError("{t.typeName} has no @graphql method for a subscription") when object.fields.len() == 0
			return name
		}

		// A method's parameters as a field's arguments, with their defaults
		// where they need no earlier parameter; a ResolveInfo parameter is
		// not one.
		def addArguments(field FieldDef, m FunctionDescriptor) !none {
			for let (i, p) in m.signature.parameters {
				continue when p.paramType.typeName == resolveInfoType
				let arg = new InputDef(p.node.name, try inputRef(p.paramType, p.defaultLiteral != ""))
				arg.description = p.node.doc
				if p.defaultLiteral != "" {
					let made = reflection.defaultOf(m, i)
					arg.defaultValue = try literalOf(made, p.paramType) unless made is none
				}
				field.args.push(arg)
			}
			return none
		}

		// A `@graphql` method as a field: its parameters the arguments (with
		// their defaults where they need no earlier parameter), a resolver
		// that calls it on the parent value.
		def methodField(hit AttrHit) !FieldDef {
			let m = reflection.asFunction(hit.node)
			fail schemaError("{hit.node.qualifiedName} is not a method") when m is none
			let annotated = argumentText(hit.attr, "name")
			let field = new FieldDef(annotated == "" ?? (m.node.name, annotated), try outputRef(m.signature.result, false))
			let text = argumentText(hit.attr, "description")
			field.description = text == "" ?? (m.node.doc, text)
			deprecate(field, argumentText(hit.attr, "deprecated"))
			try addArguments(field, m)
			field.resolver = def (info ResolveInfo) !any {
				return try callMethod(m, info)
			}
			return field
		}

		// The type reference of an output position: nullable when the type
		// is optional or nullable says so.
		def outputRef(t TypeDescriptor, nullable bool) !Node {
			let named = new Node(NodeKind.NamedType)
			if t.kind == reflection.TypeKind.Array {
				let e = t.element
				fail schemaError("{t.typeName} has no element type") when e is none
				named = new Node(NodeKind.ListType)
				named.typeRef = try outputRef(e, false)
			} else if t.kind == reflection.TypeKind.Enum {
				named = namedRef(try enumType(t))
			} else {
				let scalar = try scalarOf(t)
				named = namedRef(scalar == "" ?? (try objectType(t), scalar))
			}
			return wrapRef(named, nullable || t.optional)
		}

		// The type reference of an input position.
		def inputRef(t TypeDescriptor, nullable bool) !Node {
			let named = new Node(NodeKind.NamedType)
			if t.kind == reflection.TypeKind.Array {
				let e = t.element
				fail schemaError("{t.typeName} has no element type") when e is none
				named = new Node(NodeKind.ListType)
				named.typeRef = try inputRef(e, false)
			} else if t.kind == reflection.TypeKind.Enum {
				named = namedRef(try enumType(t))
			} else {
				let scalar = try scalarOf(t)
				named = namedRef(scalar == "" ?? (try inputType(t), scalar))
			}
			return wrapRef(named, nullable || t.optional)
		}

		// The scalar an ADM type is, "" for a struct or type (an object),
		// failing for a type GraphQL has no form of.
		def scalarOf(t TypeDescriptor) !string {
			let name = t.typeName
			if name == "std.time.Time" {
				if !schema.types.hasKey("DateTime") {
					let s = new TypeDef(TypeKind.Scalar, "DateTime")
					s.description = "An instant, as RFC 3339 text."
					s.specifiedBy = "https://www.rfc-editor.org/rfc/rfc3339"
					s.directives = [appliedDirective("specifiedBy", "url", s.specifiedBy)]
					s.coercion = dateTimeCoercion()
					addType(s)
				}
				return "DateTime"
			}
			let own = primitiveName(t)
			if own != "" {
				return "String" when own := "string" || "char"
				return "Boolean" when own == "bool"
				return "Int" when own := "int" || "int8" || "int16" || "int32" || "int64" || "uint" || "uint8" || "uint16" || "uint32" || "uint64" || "byte"
				return "Float" when isFloatName(own)
				if own := "any" || "anydata" {
					if !schema.types.hasKey("JSON") {
						let s = new TypeDef(TypeKind.Scalar, "JSON")
						s.description = "Any JSON value."
						addType(s)
					}
					return "JSON"
				}
				fail schemaError("{own} has no GraphQL scalar")
			}
			// A `type` reflects as an alias of itself.
			return "" when t.kind := reflection.TypeKind.Struct || reflection.TypeKind.Datatype || reflection.TypeKind.Alias
			fail schemaError("{name} cannot be a GraphQL type: maps, tuples, unions and interfaces need an SDL schema (parseSchema)")
		}

		def enumType(t TypeDescriptor) !string {
			let name = nameOf(t, false)
			return name unless try claim(name, t.typeName)
			let e = new TypeDef(TypeKind.Enum, name)
			e.description = descriptionOf(t)
			for let m in reflection.members(t) {
				e.values.push(EnumValueDef{name: m.node.name, description: m.node.doc, value: m.value})
			}
			fail schemaError("{t.typeName} has no member") when e.values.len() == 0
			addType(e)
			return name
		}

		def inputType(t TypeDescriptor) !string {
			let name = nameOf(t, true)
			return name unless try claim(name, t.typeName + " (input)")
			let sample = reflection.instantiate(t)
			fail schemaError("{t.typeName} cannot be made, so it cannot be an input") when sample is none
			let input = new TypeDef(TypeKind.InputObject, name)
			input.description = descriptionOf(t)
			addType(input)
			for let f in reflection.fields(sample) {
				continue when f.attr(graphqlAnnotation, "ignore") == "true"
				let declared = f.descriptor
				continue when declared is none
				let field = new InputDef(graphqlName(f), try inputRef(declared, f.kind == FieldKind.Optional))
				let text = f.attr(graphqlAnnotation, "description")
				field.description = text == "" ?? (f.doc, text)
				input.inputFields.push(field)
			}
			fail schemaError("{t.typeName} has no field GraphQL can take") when input.inputFields.len() == 0
			return name
		}
	}

	// The name of a built-in type without its module (`builtin.string` is
	// `string`, as a field's descriptor spells it); "" for a declared type,
	// whose name is qualified.
	internal def primitiveName(t TypeDescriptor) string {
		return "" unless t.kind == reflection.TypeKind.Primitive || t.kind == reflection.TypeKind.Alias
		let own = t.typeName.trimPrefix("builtin.")
		return own.contains(".") ?? ("", own)
	}

	internal def graphqlName(f reflection.Field) string {
		let annotated = f.attr(graphqlAnnotation, "name")
		return annotated == "" ?? (f.name, annotated)
	}

	// Marks a field deprecated for reason, when there is one, as an applied
	// @deprecated prints it.
	internal def deprecate(field FieldDef, reason string) {
		return when reason == ""
		field.deprecated = reason
		field.directives = [appliedDirective("deprecated", "reason", reason)]
	}

	// `@name(argument: "text")`.
	internal def appliedDirective(name string, argument string, text string) Node {
		let d = new Node(NodeKind.Directive)
		d.name = name
		let a = new Node(NodeKind.Argument)
		a.name = argument
		let v = new Node(NodeKind.StringValue)
		v.text = text
		a.value = v
		d.arguments = [a]
		return d
	}

	// An ADM value of type t as a GraphQL literal: what an argument's
	// default prints as and is coerced from.
	internal def literalOf(value any, t TypeDescriptor) !Node {
		let n = new Node(NodeKind.NullValue)
		return n when value is none
		if t.kind == reflection.TypeKind.Enum {
			let number = reflection.scalarText(value)
			for let m in reflection.members(t) {
				if reflection.scalarText(m.value) == number {
					n.kind = NodeKind.EnumValue
					n.text = m.node.name
					return n
				}
			}
			fail schemaError("{number} is no member of {t.typeName}")
		}
		if t.kind == reflection.TypeKind.Array {
			let e = t.element
			fail schemaError("{t.typeName} has no element type") when e is none
			n.kind = NodeKind.ListValue
			for let item in reflection.elements(value) {
				n.items.push(try literalOf(item, e))
			}
			return n
		}
		if value is time.Time {
			n.kind = NodeKind.StringValue
			n.text = value.str(time.TimeFormat.RFC3339)
			return n
		}
		let own = primitiveName(t)
		if own == "" {
			n.kind = NodeKind.ObjectValue
			for let f in reflection.fields(value) {
				continue when f.attr(graphqlAnnotation, "ignore") == "true"
				let declared = f.descriptor
				continue when declared is none
				let field = new Node(NodeKind.ObjectField)
				field.name = graphqlName(f)
				field.value = try literalOf(fieldValue(f), declared)
				n.items.push(field)
			}
			return n
		}
		if value is string {
			n.kind = NodeKind.StringValue
			n.text = value
			return n
		}
		if value is bool {
			n.kind = NodeKind.BooleanValue
			n.text = value ?? ("true", "false")
			return n
		}
		n.text = reflection.scalarText(value)
		n.kind = isFloatName(own) ?? (NodeKind.FloatValue, NodeKind.IntValue)
		fail schemaError("a default of type {own} has no GraphQL literal") when n.text == ""
		return n
	}

	internal def isFloatName(name string) bool {
		return name := "float" || "float32" || "float64"
	}

	internal def wrapRef(named Node, nullable bool) Node {
		return named when nullable
		let nn = new Node(NodeKind.NonNullType)
		nn.typeRef = named
		return nn
	}

	internal def argumentText(attr reflection.AttributeInfo, key string) string {
		return "" unless attr.arguments.hasKey(key)
		let v = attr.arguments[key]
		return v is string ?? (v, "")
	}

	// Calls a `@graphql` method on the parent value with the field's
	// arguments as the values of its parameters; a parameter left out takes
	// its default.
	internal def callMethod(m FunctionDescriptor, info ResolveInfo) !any {
		let args any[] = []
		for let (i, p) in m.signature.parameters {
			if p.paramType.typeName == resolveInfoType {
				args.push(info)
				continue
			}
			if !info.args.hasKey(p.node.name) {
				let made = reflection.defaultOf(m, i, args)
				if made is none {
					args.push(none)
				} else {
					args.push(made)
				}
				continue
			}
			args.push(try admValue(info.args[p.node.name], p.paramType))
		}
		let out = reflection.invoke(m, info.source, args)
		fail out when out is error
		return out
	}

	// A coerced GraphQL input value as the ADM value of type t: enum values
	// and DateTime are such already, numbers take the declared width, lists
	// become arrays of the element type, input objects values of their
	// struct or type.
	internal def admValue(value any, t TypeDescriptor) !any {
		return none when value is none
		match t.kind {
			case reflection.TypeKind.Enum:
				return value
			case reflection.TypeKind.Array:
				let e = t.element
				fail schemaError("{t.typeName} has no element type") when e is none
				let items any[] = []
				for let item in reflection.elements(value) {
					items.push(try admValue(item, e))
				}
				let made = reflection.arrayOf(e, items)
				fail schemaError("an array of {e.typeName} cannot be built") when made is none
				return made
			default:
				let own = primitiveName(t)
				return value when t.typeName == "std.time.Time" || (own := "any" || "anydata")
				return try jsonschema.valueOf(value, t) when own != ""
				return try inputObject(value, t)
		}
	}

	// An input object's coerced fields as a new value of the struct or type
	// t describes.
	internal def inputObject(value any, t TypeDescriptor) !any {
		fail schemaError("an input object for {t.typeName} is not a map") unless value is map<string, any>
		let target = reflection.instantiate(t)
		fail schemaError("{t.typeName} cannot be made") when target is none
		for let f in reflection.fields(target) {
			let key = graphqlName(f)
			continue unless value.hasKey(key)
			let given = value[key]
			if given is none {
				fail schemaError("{t.typeName}.{f.name} cannot be null") unless f.setNone()
				continue
			}
			let declared = f.descriptor
			continue when declared is none
			fail schemaError("{t.typeName}.{f.name} cannot hold the value given") unless f.set(try admValue(given, declared))
		}
		return target
	}

	// DateTime: an instant as RFC 3339 text, both ways.
	internal def dateTimeCoercion() ScalarCoercion {
		return ScalarCoercion{
			serialize: def (value any) !any {
				return value.str(time.TimeFormat.RFC3339) when value is time.Time
				fail coercionError("DateTime cannot represent value: {describeValue(value)}")
			},
			parseValue: def (value any) !any {
				fail coercionError("DateTime cannot represent a non string value: {describeValue(value)}") unless value is string
				return time.parse(value, time.TimeFormat.RFC3339) onerror (err error) {
					fail coercionError("DateTime cannot represent \"{value}\": {err.message}")
				}
			},
		}
	}
}
