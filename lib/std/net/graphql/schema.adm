partial module std.net.graphql {
	use (
		std.errors
		std.net.graphql.syntax
		std.net.graphql.syntax::(Node, NodeKind)
	)

	// The kinds of named type (spec 3.4).
	internal enum TypeKind {
		Scalar,
		Object,
		Interface,
		Union,
		Enum,
		InputObject,
	}

	// An input value: a field argument, a directive argument or an input
	// object field.
	internal type InputDef {
		name         string
		description  string  = ""
		typeRef      Node
		// The default as written, none when there is none.
		defaultValue ?Node   = none
		deprecated   ?string = none
		directives   Node[]  = []

		def new(name string, typeRef Node) {
			self.name = name
			self.typeRef = typeRef
		}
	}

	// A field of an object or interface type.
	internal type FieldDef {
		name        string
		description string      = ""
		args        InputDef[]  = []
		typeRef     Node
		deprecated  ?string     = none
		directives  Node[]      = []
		resolver    ?Resolver   = none
		subscriber  ?Subscriber = none
		// A subscriber whose events come on a channel of any element type
		// (a `@graphql` method's `channel<T>`), boxed; schemaOf sets it.
		boxedSubscriber ?def (info ResolveInfo) !any = none

		def new(name string, typeRef Node) {
			self.name = name
			self.typeRef = typeRef
		}

		def arg(name string) ?InputDef {
			return args.find(a => a.name == name, 0)
		}
	}

	internal struct EnumValueDef {
		name        string
		description string  = ""
		deprecated  ?string = none
		directives  Node[]  = []
		// What the value stands for inside the program: the name, unless
		// the schema maps it (an ADM enum member).
		value       any
	}

	// A named type.
	internal type TypeDef {
		kind        TypeKind
		name        string
		description string          = ""
		fields      FieldDef[]      = []
		interfaces  string[]        = []
		members     string[]        = []
		values      EnumValueDef[]  = []
		inputFields InputDef[]      = []
		specifiedBy string          = ""
		// For an input object: whether it is a OneOf Input Object (`@oneOf`),
		// whose values set exactly one field.
		oneOf       bool            = false
		directives  Node[]          = []
		// For an abstract type: the object type a resolved value is.
		resolveType ?TypeResolver   = none
		// For a custom scalar: its coercions; none passes values through.
		coercion    ?ScalarCoercion = none
		// The definition's node, for error locations.
		node        ?Node           = none

		def new(kind TypeKind, name string) {
			self.kind = kind
			self.name = name
		}

		def field(name string) ?FieldDef {
			return fields.find(f => f.name == name, 0)
		}

		def inputField(name string) ?InputDef {
			return inputFields.find(f => f.name == name, 0)
		}

		def enumValue(name string) ?EnumValueDef {
			return values.find(v => v.name == name, 0)
		}

		def isComposite() bool {
			return kind == TypeKind.Object || kind == TypeKind.Interface || kind == TypeKind.Union
		}

		def isAbstract() bool {
			return kind == TypeKind.Interface || kind == TypeKind.Union
		}

		def isLeaf() bool {
			return kind == TypeKind.Scalar || kind == TypeKind.Enum
		}
	}

	internal type DirectiveDef {
		name        string
		description string     = ""
		args        InputDef[] = []
		locations   string[]   = []
		repeatable  bool       = false

		def new(name string) {
			self.name = name
		}

		def arg(name string) ?InputDef {
			return args.find(a => a.name == name, 0)
		}
	}

	// How a custom scalar's values are read and written.
	//
	//     schema.scalar("Date", graphql.ScalarCoercion{
	//         serialize: def (v any) !any { ... },        // program value to JSON
	//         parseValue: def (v any) !any { ... },       // variable value to program value
	//     })
	//
	// A literal in a query reaches parseValue as the JSON value it writes.
	struct ScalarCoercion {
		serialize  ?def (value any) !any = none
		parseValue ?def (value any) !any = none
	}

	// The specification's built-in scalars, directives and introspection
	// types, as SDL the schema builder reads like any other.
	@embed("builtin.graphql")
	internal const builtinSDL byte[]

	internal const builtinScalars = ["Int", "Float", "String", "Boolean", "ID"]
	internal const builtinDirectives = ["include", "skip", "deprecated", "specifiedBy", "oneOf"]

	// A GraphQL schema: its types, directives and root operation types, the
	// resolvers attached to its fields, and what runs requests against it.
	//
	//     let schema = try graphql.parseSchema("type Query \{ hello(name: String): String \}")
	//     try schema.resolve("Query", "hello", def (f graphql.ResolveInfo) !any {
	//         return "Hello, {f.arg("name")}"
	//     })
	//     let response = schema.execute("\{ hello(name: \"Ada\") \}")
	type Schema {
		internal types            map<string, TypeDef>
		internal directives       map<string, DirectiveDef>
		internal order            string[]
		internal queryType        string                    = ""
		internal mutationType     string                    = ""
		internal subscriptionType string                    = ""
		internal description      string                    = ""
		internal schemaDirectives Node[]                    = []
		// The root values of a schema built by schemaOf, used when execute
		// is given none.
		internal queryRoot        any                       = none
		internal mutationRoot     any                       = none
		internal subscriptionRoot any                       = none
		// The longest a query's selections may nest before validation refuses
		// it; 0 for no limit.
		maxDepth                  int                       = 64

		internal def new() {}

		// Attaches a resolver to a field: what computes its value from the
		// parent's. Fails when the type or field does not exist.
		def resolve(typeName string, fieldName string, resolver Resolver) !Schema {
			let f = try fieldOf(typeName, fieldName)
			f.resolver = resolver
			return self
		}

		// Attaches the source of a subscription field: the events whose
		// payloads each run the subscription's selection set. Fails when the
		// field is not a field of the subscription type.
		def subscribe(fieldName string, subscriber Subscriber) !Schema {
			fail schemaError("the schema has no subscription type") when subscriptionType == ""
			let f = try fieldOf(subscriptionType, fieldName)
			f.subscriber = subscriber
			return self
		}

		// Sets how an interface or union finds the object type of a value.
		// Without one, a value that is a map with `__typename`, or an object
		// whose ADM type is named like an object type, is found. Fails when
		// the type is not abstract.
		def resolveType(typeName string, resolver TypeResolver) !Schema {
			let t = types.get(typeName)
			fail schemaError("\"{typeName}\" is not an interface or union of the schema") unless !(t is none) && t.isAbstract()
			t.resolveType = resolver
			return self
		}

		// Sets the coercion of a custom scalar. Fails when the scalar does not
		// exist or is built in.
		def scalar(typeName string, coercion ScalarCoercion) !Schema {
			let t = types.get(typeName)
			fail schemaError("\"{typeName}\" is not a custom scalar of the schema") unless !(t is none) && t.kind == TypeKind.Scalar && !builtinScalars.includes(typeName)
			t.coercion = coercion
			return self
		}

		// The schema as SDL, built-in definitions left out.
		def str() string {
			return syntax.print(sdlDocument(self))
		}

		// Runs a query or mutation: parses it, validates it against the
		// schema, coerces the variables and executes the operation (the one
		// named, or the only one), with context reaching every resolver and
		// root as the root fields' source. Problems come back as the
		// response's errors: a request that cannot run has no data.
		def execute(query string, variables map<string, any> = map<string, any>{}, operationName string = "", context any = none, root any = none) Response {
			return runRequest(self, Request{query: query, variables: variables, operationName: operationName}, context, root)
		}

		// Runs a request; see execute(string, ...).
		def execute(request Request, context any = none, root any = none) Response {
			return runRequest(self, request, context, root)
		}

		// Starts a subscription (spec 6.2.3): each event of the subscription
		// field's subscriber runs the selection set, and its response arrives
		// on the subscription's `responses`, which close when the events end
		// or `close` is called. Fails when the request does not parse,
		// validate or coerce, or the subscriber fails.
		def executeSubscription(request Request, context any = none) !Subscription {
			let (sub, errors) = beginSubscription(self, request, context)
			fail requestError(errors[0].message) when sub is none
			return sub
		}

		// The validation errors of a document against the schema; empty when
		// it is valid.
		def validate(doc Document) GraphQLError[] {
			return validateDocument(self, doc.root)
		}

		// The element a schema coordinate names (spec 2.14): `Type`,
		// `Type.field`, `Type.field(arg:)`, `Enum.VALUE`, `Input.field`,
		// `@directive`, `@directive(arg:)`; none when the schema has no such
		// element. Fails when the text is not a coordinate, or the type, field
		// or directive that contains the element is missing or of a kind that
		// has no such member.
		def element(coordinate string) !?SchemaElement {
			return try resolveCoordinate(self, coordinate)
		}

		internal def fieldOf(typeName string, fieldName string) !FieldDef {
			let t = types.get(typeName)
			fail schemaError("the schema has no type \"{typeName}\"") when t is none
			let f = t.field(fieldName)
			fail schemaError("\"{typeName}\" has no field \"{fieldName}\"") when f is none
			return f
		}
	}

	internal const coordinatePattern = /^(@?)([_A-Za-z][_0-9A-Za-z]*)(?:\.([_A-Za-z][_0-9A-Za-z]*))?(?:\(([_A-Za-z][_0-9A-Za-z]*):\))?$/

	internal def resolveCoordinate(schema Schema, coordinate string) !?SchemaElement {
		let m = coordinatePattern.find(coordinate, 0)
		fail schemaError("\"{coordinate}\" is not a schema coordinate") when m is none
		let directive = m.groups[0] == "@"
		let name = m.groups[1]
		let member = m.groups[2]
		let argument = m.groups[3]
		fail schemaError("\"{coordinate}\" is not a schema coordinate: a directive has no members") when directive && member != ""
		fail schemaError("\"{coordinate}\" is not a schema coordinate: an argument belongs to a field or a directive") when !directive && member == "" && argument != ""
		if directive {
			let d = schema.directives.get(name)
			if argument == "" {
				return none when d is none
				return SchemaElement{kind: ElementKind.Directive, coordinate: coordinate, description: d.description, deprecated: none}
			}
			fail schemaError("\"{coordinate}\": the schema has no directive @{name}") when d is none
			let a = d.arg(argument)
			return none when a is none
			return inputElement(ElementKind.DirectiveArgument, coordinate, a)
		}
		let t = schema.types.get(name)
		if member == "" {
			return none when t is none
			return SchemaElement{kind: ElementKind.Type, coordinate: coordinate, description: t.description, deprecated: none}
		}
		fail schemaError("\"{coordinate}\": the schema has no type \"{name}\"") when t is none
		if argument != "" {
			fail schemaError("\"{coordinate}\": \"{name}\" is not an object or interface type") unless t.kind == TypeKind.Object || t.kind == TypeKind.Interface
			let f = t.field(member)
			fail schemaError("\"{coordinate}\": \"{name}\" has no field \"{member}\"") when f is none
			let a = f.arg(argument)
			return none when a is none
			return inputElement(ElementKind.Argument, coordinate, a)
		}
		match t.kind {
			case TypeKind.Enum:
				let v = t.enumValue(member)
				return none when v is none
				return SchemaElement{kind: ElementKind.EnumValue, coordinate: coordinate, description: v.description, deprecated: v.deprecated}
			case TypeKind.InputObject:
				let f = t.inputField(member)
				return none when f is none
				return inputElement(ElementKind.InputField, coordinate, f)
			case TypeKind.Object, TypeKind.Interface:
				let f = t.field(member)
				return none when f is none
				return SchemaElement{kind: ElementKind.Field, coordinate: coordinate, description: f.description, typeRef: syntax.print(f.typeRef), deprecated: f.deprecated}
			default:
				fail schemaError("\"{coordinate}\": \"{name}\" is not an enum, input object, object or interface type")
		}
	}

	internal def inputElement(kind ElementKind, coordinate string, a InputDef) SchemaElement {
		return SchemaElement{kind: kind, coordinate: coordinate, description: a.description, typeRef: syntax.print(a.typeRef), deprecated: a.deprecated}
	}

	internal def possibleTypes(schema Schema, t TypeDef) TypeDef[] {
		let out TypeDef[] = []
		if t.kind == TypeKind.Union {
			for let m in t.members {
				let member = schema.types.get(m)
				out.push(member) unless member is none
			}
			return out
		}
		for let name in schema.order {
			let candidate = schema.types.get(name)
			continue when candidate is none
			out.push(candidate) when candidate.kind == TypeKind.Object && candidate.interfaces.includes(t.name)
		}
		return out
	}

	internal def isPossible(abstract TypeDef, object TypeDef) bool {
		return abstract.members.includes(object.name) when abstract.kind == TypeKind.Union
		return object.interfaces.includes(abstract.name)
	}

	internal def isSubtype(maybeSub TypeDef, superType TypeDef) bool {
		return true when maybeSub.name == superType.name
		return superType.isAbstract() && (superType.kind == TypeKind.Union ?? (superType.members.includes(maybeSub.name), maybeSub.interfaces.includes(superType.name)))
	}

	// What a resolver is given: the parent value, the arguments (coerced, with
	// defaults), the request's context, and where the field is.
	type ResolveInfo {
		// The value of the parent object: the root value for a root field.
		source        any
		args          map<string, any>
		// What the caller passed to execute (or the handler's context).
		context       any
		fieldName     string
		parentType    string
		// The path to this field in the response: names and list indexes.
		path          any[]
		operationName string
		variables     map<string, any>
		// The request's extensions (spec 7.1.1): what the client sent beside
		// the query for this service to read.
		extensions    map<string, any> = map<string, any>{}

		internal def new() {}

		// The argument's value, none when it was not given and has no default.
		def arg(name string) any {
			return none unless args.hasKey(name)
			return args[name]
		}
	}

	// What a schema coordinate names.
	enum ElementKind {
		Type,
		Field,
		InputField,
		EnumValue,
		Argument,
		Directive,
		DirectiveArgument,
	}

	// One element of a schema, as Schema.element finds it by its coordinate.
	struct SchemaElement {
		kind        ElementKind
		coordinate  string
		description string
		// The type of a field, argument or input field as SDL writes it
		// (`[String!]`); empty for the other kinds.
		typeRef     string
		// The reason it is deprecated; none when it is not.
		deprecated  ?string
	}

	// Computes a field's value. Fails with an error the response reports at
	// the field's path; the field becomes null.
	type Resolver = def (info ResolveInfo) !any

	// Starts a subscription field's event stream: each value sent on the
	// channel runs the subscription's selection set with it as the root
	// value; closing the channel ends the subscription.
	type Subscriber = def (info ResolveInfo) !channel<any>

	// Names the object type of a value of an interface or union.
	type TypeResolver = def (value any, info ResolveInfo) !string

	// A schema that does not build: the message, and where in the SDL when it
	// comes from one.
	struct SchemaError {
		message string
		code    string
		cause   ?error
		stack   errors.StackTrace
	}

	internal def schemaError(message string) SchemaError {
		return SchemaError{message: "graphql: " + message, code: "graphql-schema"}
	}

	// parseSchema builds a schema from SDL: type, directive and schema
	// definitions and their extensions, the built-in scalars and directives
	// added. The root types are the schema definition's, else the types
	// named Query, Mutation and Subscription. Fails with the syntax error, or
	// the first rule of the type system (spec 3) the schema breaks.
	def parseSchema(sdl string) !Schema {
		let doc = try syntax.parseDocument(sdl)
		for let d in doc.items {
			fail schemaError("an SDL document cannot hold {d.kind == NodeKind.FragmentDefinition ?? ("a fragment", "an operation")}") when d.kind == NodeKind.OperationDefinition || d.kind == NodeKind.FragmentDefinition
		}
		let schema = new Schema()
		try addDefinitions(schema, try syntax.parseDocument(string(builtinSDL)), true)
		try addDefinitions(schema, doc, false)
		try validateSchema(schema)
		return schema
	}

	// Adds a document's definitions and then its extensions to the schema.
	internal def addDefinitions(schema Schema, doc Node, builtin bool) !none {
		let schemaDefs = 0
		for let d in doc.items {
			match d.kind {
				case NodeKind.SchemaDefinition:
					schemaDefs++
					fail schemaError("a schema has one schema definition") when schemaDefs > 1
					schema.description = descriptionOf(d)
					schema.schemaDirectives = d.directives
					try setRoots(schema, d)
				case NodeKind.DirectiveDefinition:
					fail schemaError("directive @{d.name} is defined twice") when schema.directives.hasKey(d.name)
					fail schemaError("@{d.name} is a built-in directive") when !builtin && builtinDirectives.includes(d.name)
					let dir = new DirectiveDef(d.name)
					dir.description = descriptionOf(d)
					dir.args = try inputDefs(d.arguments, "@" + d.name)
					dir.locations = d.items.mapElem(l => l.name)
					dir.repeatable = d.repeatable
					for let (i, l) in dir.locations {
						fail schemaError("@{d.name} names location {l} twice") when dir.locations.indexOf(l) != i
					}
					schema.directives[d.name] = dir
				case NodeKind.ScalarTypeDefinition, NodeKind.ObjectTypeDefinition, NodeKind.InterfaceTypeDefinition, NodeKind.UnionTypeDefinition, NodeKind.EnumTypeDefinition, NodeKind.InputObjectTypeDefinition:
					fail schemaError("type \"{d.name}\" is defined twice") when schema.types.hasKey(d.name)
					fail schemaError("\"{d.name}\" is a built-in type") when !builtin && (builtinScalars.includes(d.name) || d.name.startsWith("__"))
					let t = new TypeDef(kindOfDefinition(d.kind), d.name)
					t.description = descriptionOf(d)
					t.node = d
					try extendType(t, d)
					schema.types[d.name] = t
					schema.order.push(d.name)
				default:
			}
		}
		for let d in doc.items {
			match d.kind {
				case NodeKind.SchemaExtension:
					schema.schemaDirectives += d.directives
					try setRoots(schema, d)
				case NodeKind.ScalarTypeExtension, NodeKind.ObjectTypeExtension, NodeKind.InterfaceTypeExtension, NodeKind.UnionTypeExtension, NodeKind.EnumTypeExtension, NodeKind.InputObjectTypeExtension:
					let t = schema.types.get(d.name)
					fail schemaError("cannot extend \"{d.name}\": no such type") when t is none
					fail schemaError("cannot extend {t.kind.name} \"{d.name}\" as another kind") when t.kind != kindOfDefinition(d.kind)
					try extendType(t, d)
				default:
			}
		}
		if !builtin && schema.queryType == "" && schema.mutationType == "" && schema.subscriptionType == "" {
			schema.queryType = "Query" when schema.types.hasKey("Query")
			schema.mutationType = "Mutation" when schema.types.hasKey("Mutation")
			schema.subscriptionType = "Subscription" when schema.types.hasKey("Subscription")
		}
		return none
	}

	internal def setRoots(schema Schema, d Node) !none {
		for let op in d.items {
			match op.text {
				case "query":
					fail schemaError("the query type is given twice") when schema.queryType != ""
					schema.queryType = op.name
				case "mutation":
					fail schemaError("the mutation type is given twice") when schema.mutationType != ""
					schema.mutationType = op.name
				default:
					fail schemaError("the subscription type is given twice") when schema.subscriptionType != ""
					schema.subscriptionType = op.name
			}
		}
		return none
	}

	internal def kindOfDefinition(kind NodeKind) TypeKind {
		match kind {
			case NodeKind.ScalarTypeDefinition, NodeKind.ScalarTypeExtension:
				return TypeKind.Scalar
			case NodeKind.ObjectTypeDefinition, NodeKind.ObjectTypeExtension:
				return TypeKind.Object
			case NodeKind.InterfaceTypeDefinition, NodeKind.InterfaceTypeExtension:
				return TypeKind.Interface
			case NodeKind.UnionTypeDefinition, NodeKind.UnionTypeExtension:
				return TypeKind.Union
			case NodeKind.EnumTypeDefinition, NodeKind.EnumTypeExtension:
				return TypeKind.Enum
			default:
				return TypeKind.InputObject
		}
	}

	// Adds what a definition or extension declares to the type.
	internal def extendType(t TypeDef, d Node) !none {
		t.directives += d.directives
		match t.kind {
			case TypeKind.Scalar:
				let by = directiveArgument(d.directives, "specifiedBy", "url")
				t.specifiedBy = by unless by == ""
			case TypeKind.Object, TypeKind.Interface:
				for let i in d.interfaces {
					fail schemaError("\"{t.name}\" implements \"{i.name}\" twice") when t.interfaces.includes(i.name)
					t.interfaces.push(i.name)
				}
				for let f in d.items {
					fail schemaError("field \"{t.name}.{f.name}\" is defined twice") unless t.field(f.name) is none
					let found = new FieldDef(f.name, refOr(f.typeRef))
					found.description = descriptionOf(f)
					found.args = try inputDefs(f.arguments, "{t.name}.{f.name}")
					found.deprecated = deprecationOf(f.directives)
					found.directives = f.directives
					t.fields.push(found)
				}
			case TypeKind.Union:
				for let m in d.items {
					fail schemaError("union \"{t.name}\" has member \"{m.name}\" twice") when t.members.includes(m.name)
					t.members.push(m.name)
				}
			case TypeKind.Enum:
				for let v in d.items {
					fail schemaError("enum \"{t.name}\" has value \"{v.name}\" twice") unless t.enumValue(v.name) is none
					t.values.push(EnumValueDef{name: v.name, description: descriptionOf(v), deprecated: deprecationOf(v.directives), directives: v.directives, value: v.name})
				}
			default:
				if !(d.directives.find(x => x.name == "oneOf", 0) is none) {
					fail schemaError("@oneOf cannot be added to \"{t.name}\" by an extension") when d.kind == NodeKind.InputObjectTypeExtension
					t.oneOf = true
				}
				for let f in d.items {
					fail schemaError("input field \"{t.name}.{f.name}\" is defined twice") unless t.inputField(f.name) is none
				}
				t.inputFields += try inputDefs(d.items, t.name)
		}
		return none
	}

	internal def inputDefs(nodes Node[], owner string) !InputDef[] {
		let out InputDef[] = []
		for let n in nodes {
			fail schemaError("\"{owner}\" has argument \"{n.name}\" twice") unless out.find(a => a.name == n.name, 0) is none
			let found = new InputDef(n.name, refOr(n.typeRef))
			found.description = descriptionOf(n)
			found.defaultValue = n.value
			found.deprecated = deprecationOf(n.directives)
			found.directives = n.directives
			out.push(found)
		}
		return out
	}

	internal def descriptionOf(n Node) string {
		let d = n.description
		return d is none ?? ("", d.text)
	}

	// The reason of an applied @deprecated, none when it is not applied.
	internal def deprecationOf(directives Node[]) ?string {
		let d = directives.find(x => x.name == "deprecated", 0)
		return none when d is none
		let reason = d.arguments.find(a => a.name == "reason", 0)
		return "No longer supported" when reason is none
		let v = reason.value
		return v is none || v.kind != NodeKind.StringValue ?? ("No longer supported", v.text)
	}

	internal def directiveArgument(directives Node[], name string, arg string) string {
		let d = directives.find(x => x.name == name, 0)
		return "" when d is none
		let a = d.arguments.find(x => x.name == arg, 0)
		return "" when a is none
		let v = a.value
		return v is none ?? ("", v.text)
	}

	// The named type at the bottom of a type reference.
	internal def namedOf(ref Node) string {
		let at = ref
		for at.kind != NodeKind.NamedType {
			let inner = at.typeRef
			return "" when inner is none
			at = inner
		}
		return at.name
	}

	internal def isNonNull(ref Node) bool {
		return ref.kind == NodeKind.NonNullType
	}

	internal def inner(ref Node) Node {
		let i = ref.typeRef
		return i is none ?? (new Node(NodeKind.NamedType), i)
	}

	// Checks the type system rules (spec 3): roots are object types, names do
	// not start with `__`, fields and arguments have output and input types,
	// interfaces are implemented as declared, unions hold object types,
	// enums and input objects are not empty, input objects do not require
	// themselves, directives and applied directives are known and fit.
	internal def validateSchema(schema Schema) !none {
		fail schemaError("the schema has no query type") when schema.queryType == ""
		for let root in [("query", schema.queryType), ("mutation", schema.mutationType), ("subscription", schema.subscriptionType)] {
			continue when root.1 == ""
			let t = schema.types.get(root.1)
			fail schemaError("the {root.0} type \"{root.1}\" is not an object type of the schema") unless !(t is none) && t.kind == TypeKind.Object
		}
		for let name in schema.order {
			let t = schema.types.get(name)
			continue when t is none || name.startsWith("__") || builtinScalars.includes(name)
			try checkApplied(schema, t.directives, kindLocation(t.kind), name)
			match t.kind {
				case TypeKind.Object, TypeKind.Interface:
					fail schemaError("{t.kind.name.lower()} \"{name}\" needs a field") when t.fields.len() == 0
					for let f in t.fields {
						fail schemaError("field \"{name}.{f.name}\" starts with \"__\"") when f.name.startsWith("__")
						let ft = try referenced(schema, f.typeRef, "{name}.{f.name}")
						fail schemaError("field \"{name}.{f.name}\" has input type \"{ft.name}\"") when ft.kind == TypeKind.InputObject
						try checkApplied(schema, f.directives, "FIELD_DEFINITION", "{name}.{f.name}")
						for let a in f.args {
							try checkInput(schema, a, "{name}.{f.name}({a.name}:)", "ARGUMENT_DEFINITION")
						}
					}
					try checkInterfaces(schema, t)
				case TypeKind.Union:
					fail schemaError("union \"{name}\" needs a member") when t.members.len() == 0
					for let m in t.members {
						let member = schema.types.get(m)
						fail schemaError("union \"{name}\" has member \"{m}\", which is not an object type") unless !(member is none) && member.kind == TypeKind.Object
					}
				case TypeKind.Enum:
					fail schemaError("enum \"{name}\" needs a value") when t.values.len() == 0
					for let v in t.values {
						try checkApplied(schema, v.directives, "ENUM_VALUE", "{name}.{v.name}")
					}
				case TypeKind.InputObject:
					fail schemaError("input \"{name}\" needs a field") when t.inputFields.len() == 0
					for let f in t.inputFields {
						try checkInput(schema, f, "{name}.{f.name}", "INPUT_FIELD_DEFINITION")
						if t.oneOf {
							fail schemaError("OneOf input field \"{name}.{f.name}\" must be nullable") when isNonNull(f.typeRef)
							fail schemaError("OneOf input field \"{name}.{f.name}\" cannot have a default value") unless f.defaultValue is none
						}
					}
					try checkInputCycle(schema, t, [name])
					fail schemaError("the default values of input \"{name}\" refer to themselves") when defaultValueHasCycle(schema, t, noneNode(), [])
				default:
			}
		}
		for let (name, d) in schema.directives {
			continue when builtinDirectives.includes(name)
			fail schemaError("directive @{name} starts with \"__\"") when name.startsWith("__")
			for let a in d.args {
				try checkInput(schema, a, "@{name}({a.name}:)", "ARGUMENT_DEFINITION")
			}
		}
		try checkApplied(schema, schema.schemaDirectives, "SCHEMA", "the schema")
		return none
	}

	internal def kindLocation(kind TypeKind) string {
		match kind {
			case TypeKind.Scalar:
				return "SCALAR"
			case TypeKind.Object:
				return "OBJECT"
			case TypeKind.Interface:
				return "INTERFACE"
			case TypeKind.Union:
				return "UNION"
			case TypeKind.Enum:
				return "ENUM"
			default:
				return "INPUT_OBJECT"
		}
	}

	internal def referenced(schema Schema, ref Node, place string) !TypeDef {
		let name = namedOf(ref)
		let t = schema.types.get(name)
		fail schemaError("{place} names unknown type \"{name}\"") when t is none
		return t
	}

	internal def checkInput(schema Schema, a InputDef, place string, location string) !none {
		fail schemaError("{place} starts with \"__\"") when a.name.startsWith("__")
		let t = try referenced(schema, a.typeRef, place)
		fail schemaError("{place} has output type \"{t.name}\"") unless t.kind == TypeKind.Scalar || t.kind == TypeKind.Enum || t.kind == TypeKind.InputObject
		fail schemaError("{place} is required and cannot be deprecated") when !(a.deprecated is none) && isNonNull(a.typeRef) && a.defaultValue is none
		try checkApplied(schema, a.directives, location, place)
		let d = a.defaultValue
		if !(d is none) {
			let problems = literalProblems(schema, d, a.typeRef)
			fail schemaError("{place} has a default that is not a {syntax.print(a.typeRef)}: {problems[0]}") when problems.len() > 0
		}
		return none
	}

	// An input object must not require itself through non-null fields
	// (spec 3.10, "Circular References").
	internal def checkInputCycle(schema Schema, t TypeDef, path string[]) !none {
		for let f in t.inputFields {
			continue unless f.typeRef.kind == NodeKind.NonNullType && inner(f.typeRef).kind == NodeKind.NamedType
			let next = schema.types.get(inner(f.typeRef).name)
			continue unless !(next is none) && next.kind == TypeKind.InputObject
			fail schemaError("input \"{path[0]}\" requires itself through {(path + [next.name]).join(" -> ")}") when path.includes(next.name)
			try checkInputCycle(schema, next, path + [next.name])
		}
		return none
	}

	// Whether the defaults of an input object's fields, read through a
	// default value (none for the empty map), take a default that contains
	// itself (spec InputObjectDefaultValueHasCycle): such a value has no end.
	internal def defaultValueHasCycle(schema Schema, t TypeDef, value ?Node, visited string[]) bool {
		if !(value is none) {
			if value.kind == NodeKind.ListValue {
				for let item in value.items {
					return true when defaultValueHasCycle(schema, t, item, visited)
				}
				return false
			}
			return false unless value.kind == NodeKind.ObjectValue
		}
		for let f in t.inputFields {
			let named = schema.types.get(namedOf(f.typeRef))
			continue when named is none || named.kind != TypeKind.InputObject
			let given = value is none ?? (noneNode(), value.items.find(x => x.name == f.name, 0))
			if !(given is none) {
				return true when defaultValueHasCycle(schema, named, given.value, visited)
				continue
			}
			let d = f.defaultValue
			continue when d is none
			let key = "{t.name}.{f.name}"
			return true when visited.includes(key)
			return true when defaultValueHasCycle(schema, named, d, visited + [key])
		}
		return false
	}

	internal def noneNode() ?Node {
		return none
	}

	// An object or interface implements each of its interfaces: every field
	// with a covariant type, every argument with the same type, extra
	// arguments optional, and the interfaces those interfaces implement.
	internal def checkInterfaces(schema Schema, t TypeDef) !none {
		for let name in t.interfaces {
			let i = schema.types.get(name)
			fail schemaError("\"{t.name}\" implements \"{name}\", which is not an interface") unless !(i is none) && i.kind == TypeKind.Interface
			fail schemaError("\"{t.name}\" cannot implement itself") when name == t.name
			for let transitive in i.interfaces {
				fail schemaError("\"{t.name}\" implements \"{name}\" and so must implement \"{transitive}\" too") unless t.interfaces.includes(transitive)
			}
			for let f in i.fields {
				let own = t.field(f.name)
				fail schemaError("\"{t.name}\" must have field \"{f.name}\" of interface \"{name}\"") when own is none
				fail schemaError("\"{t.name}.{f.name}\" is a {syntax.print(own.typeRef)}, not a subtype of \"{name}.{f.name}\" ({syntax.print(f.typeRef)})") unless isTypeSubtype(schema, own.typeRef, f.typeRef)
				fail schemaError("\"{t.name}.{f.name}\" is deprecated but \"{name}.{f.name}\" is not") when !(own.deprecated is none) && f.deprecated is none
				for let a in f.args {
					let ownArg = own.arg(a.name)
					fail schemaError("\"{t.name}.{f.name}\" must take argument \"{a.name}\" of interface \"{name}\"") when ownArg is none
					fail schemaError("\"{t.name}.{f.name}({a.name}:)\" must be a {syntax.print(a.typeRef)} as in interface \"{name}\"") unless sameType(ownArg.typeRef, a.typeRef)
				}
				for let a in own.args {
					fail schemaError("\"{t.name}.{f.name}({a.name}:)\" is not in interface \"{name}\" and so cannot be required") when f.arg(a.name) is none && isNonNull(a.typeRef) && a.defaultValue is none
				}
			}
		}
		return none
	}

	internal def sameType(a Node, b Node) bool {
		return false when a.kind != b.kind
		return a.name == b.name when a.kind == NodeKind.NamedType
		return sameType(inner(a), inner(b))
	}

	// Whether an output type may stand where another is declared (spec
	// IsValidImplementationFieldType).
	internal def isTypeSubtype(schema Schema, maybeSub Node, superType Node) bool {
		return maybeSub.kind == NodeKind.NonNullType && isTypeSubtype(schema, inner(maybeSub), inner(superType)) when superType.kind == NodeKind.NonNullType
		return isTypeSubtype(schema, inner(maybeSub), superType) when maybeSub.kind == NodeKind.NonNullType
		return maybeSub.kind == NodeKind.ListType && isTypeSubtype(schema, inner(maybeSub), inner(superType)) when superType.kind == NodeKind.ListType
		return false when maybeSub.kind == NodeKind.ListType
		let sub = schema.types.get(maybeSub.name)
		let sup = schema.types.get(superType.name)
		return false when sub is none || sup is none
		return isSubtype(sub, sup)
	}

	// Applied directives are defined, allowed at the location, given once
	// unless repeatable, with known and required arguments.
	internal def checkApplied(schema Schema, applied Node[], location string, place string) !none {
		for let (i, d) in applied {
			let known = schema.directives.get(d.name)
			fail schemaError("{place} uses unknown directive @{d.name}") when known is none
			fail schemaError("@{d.name} cannot be used on {place} ({location})") unless known.locations.includes(location)
			if !known.repeatable {
				for let j = 0; j < i; j++ {
					fail schemaError("@{d.name} is applied twice to {place}") when applied[j].name == d.name
				}
			}
			for let a in d.arguments {
				let argDef = known.arg(a.name)
				fail schemaError("@{d.name} on {place} has no argument \"{a.name}\"") when argDef is none
				let problems = literalProblems(schema, valueOr(a.value), argDef.typeRef)
				fail schemaError("@{d.name}({a.name}:) on {place}: {problems[0]}") when problems.len() > 0
			}
			for let a in known.args {
				let given = d.arguments.find(x => x.name == a.name, 0)
				fail schemaError("@{d.name} on {place} needs argument \"{a.name}\"") when given is none && isNonNull(a.typeRef) && a.defaultValue is none
			}
		}
		return none
	}

	// The SDL of a schema: its schema definition when the roots are not the
	// default names, its directives and types in definition order.
	internal def sdlDocument(schema Schema) Node {
		let doc = new Node(NodeKind.Document)
		let defaultRoots = (schema.queryType == "Query") && (schema.mutationType := "" || "Mutation") && (schema.subscriptionType := "" || "Subscription")
		if !defaultRoots || schema.description != "" || schema.schemaDirectives.len() > 0 {
			let s = new Node(NodeKind.SchemaDefinition)
			s.description = descriptionNode(schema.description)
			s.directives = schema.schemaDirectives
			for let root in [("query", schema.queryType), ("mutation", schema.mutationType), ("subscription", schema.subscriptionType)] {
				continue when root.1 == ""
				let o = new Node(NodeKind.OperationTypeDefinition)
				o.text = root.0
				o.name = root.1
				s.items.push(o)
			}
			doc.items.push(s)
		}
		for let (name, d) in schema.directives {
			continue when builtinDirectives.includes(name)
			let n = new Node(NodeKind.DirectiveDefinition)
			n.name = name
			n.description = descriptionNode(d.description)
			n.arguments = d.args.mapElem(a => inputNode(a))
			n.repeatable = d.repeatable
			for let l in d.locations {
				let loc = new Node(NodeKind.NamedType)
				loc.name = l
				n.items.push(loc)
			}
			doc.items.push(n)
		}
		for let name in schema.order {
			let t = schema.types.get(name)
			continue when t is none || name.startsWith("__") || builtinScalars.includes(name)
			doc.items.push(typeNode(t))
		}
		return doc
	}

	internal def typeNode(t TypeDef) Node {
		let kinds = [NodeKind.ScalarTypeDefinition, NodeKind.ObjectTypeDefinition, NodeKind.InterfaceTypeDefinition, NodeKind.UnionTypeDefinition, NodeKind.EnumTypeDefinition, NodeKind.InputObjectTypeDefinition]
		let n = new Node(kinds[t.kind.value])
		n.name = t.name
		n.description = descriptionNode(t.description)
		n.directives = t.directives
		for let i in t.interfaces {
			let named = new Node(NodeKind.NamedType)
			named.name = i
			n.interfaces.push(named)
		}
		match t.kind {
			case TypeKind.Object, TypeKind.Interface:
				for let f in t.fields {
					let fd = new Node(NodeKind.FieldDefinition)
					fd.name = f.name
					fd.description = descriptionNode(f.description)
					fd.typeRef = f.typeRef
					fd.arguments = f.args.mapElem(a => inputNode(a))
					fd.directives = f.directives
					n.items.push(fd)
				}
			case TypeKind.Union:
				for let m in t.members {
					let named = new Node(NodeKind.NamedType)
					named.name = m
					n.items.push(named)
				}
			case TypeKind.Enum:
				for let v in t.values {
					let ev = new Node(NodeKind.EnumValueDefinition)
					ev.name = v.name
					ev.description = descriptionNode(v.description)
					ev.directives = v.directives
					n.items.push(ev)
				}
			case TypeKind.InputObject:
				n.items = t.inputFields.mapElem(a => inputNode(a))
			default:
		}
		return n
	}

	internal def inputNode(a InputDef) Node {
		let n = new Node(NodeKind.InputValueDefinition)
		n.name = a.name
		n.description = descriptionNode(a.description)
		n.typeRef = a.typeRef
		n.value = a.defaultValue
		n.directives = a.directives
		return n
	}

	internal def descriptionNode(text string) ?Node {
		return none when text == ""
		let d = new Node(NodeKind.StringValue)
		d.text = text
		d.block = true
		return d
	}
}
