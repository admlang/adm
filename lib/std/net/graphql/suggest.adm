partial module std.net.graphql {
	// The "Did you mean" part of a message, as graphql-js writes it: up to
	// five suggestions, quoted and joined with "or"; "" for none. subject,
	// when given, names what is suggested ("the enum value").
	internal def didYouMean(suggestions string[], subject string = "") string {
		return "" when suggestions.len() == 0
		let quoted = suggestions[0:suggestions.len() < 5 ?? (suggestions.len(), 5)].mapElem(s => "\"{s}\"")
		let lead = subject == "" ?? (" Did you mean ", " Did you mean {subject} ")
		return lead + orList(quoted) + "?"
	}

	internal def orList(items string[]) string {
		return items[0] when items.len() == 1
		return items[0] + " or " + items[1] when items.len() == 2
		return items[0:items.len() - 1].join(", ") + ", or " + items[items.len() - 1]
	}

	// The options close enough to input to suggest it was meant, nearest
	// first (graphql-js suggestionList): within an edit distance of 40% of
	// the input's length plus one, case differences counting one,
	// transpositions one; ties in natural order.
	internal def suggestionList(input string, options string[]) string[] {
		let threshold = input.len() * 4 / 10 + 1
		let lower = input.lower().bytes()
		let found Suggestion[] = []
		for let option in options {
			continue unless found.find(s => s.option == option, 0) is none
			let d = lexicalDistance(input, lower, option, threshold)
			found.push(Suggestion{option: option, distance: d}) when d >= 0
		}
		found.sort((a Suggestion, b Suggestion) => a.distance != b.distance ?? (a.distance < b.distance, naturalCompare(a.option, b.option) < 0))
		return found.mapElem(s => s.option)
	}

	internal struct Suggestion {
		option   string
		distance int
	}

	// The Damerau-Levenshtein distance of the lower-cased texts, -1 when
	// it is above threshold; 0 for the same text, 1 for one differing in
	// case only.
	internal def lexicalDistance(input string, inputLower byte[], option string, threshold int) int {
		return 0 when input == option
		let optionText = option.lower()
		return 1 when optionText == string(inputLower)
		let optionLower = optionText.bytes()
		let a = optionLower
		let b = inputLower
		if a.len() < b.len() {
			a = inputLower
			b = optionLower
		}
		return -1 when a.len() - b.len() > threshold
		let rows int[][] = []
		for let r = 0; r < 3; r++ {
			let row int[] = []
			row.len(b.len() + 1)
			rows.push(row)
		}
		for let j = 0; j <= b.len(); j++ {
			rows[0][j] = j
		}
		for let i = 1; i <= a.len(); i++ {
			let up = rows[(i - 1) % 3]
			let row = rows[i % 3]
			row[0] = i
			let smallest = i
			for let j = 1; j <= b.len(); j++ {
				let cost = a[i - 1] == b[j - 1] ?? (0, 1)
				let cell = (up[j] + 1).min(row[j - 1] + 1).min(up[j - 1] + cost)
				cell = cell.min(rows[(i - 2) % 3][j - 2] + 1) when i > 1 && j > 1 && a[i - 1] == b[j - 2] && a[i - 2] == b[j - 1]
				smallest = cell when cell < smallest
				row[j] = cell
			}
			return -1 when smallest > threshold
		}
		let d = rows[a.len() % 3][b.len()]
		return d <= threshold ?? (d, -1)
	}

	// Compares texts with runs of digits as numbers (graphql-js
	// naturalCompare): negative, zero or positive.
	internal def naturalCompare(a string, b string) int {
		let x = a.bytes()
		let y = b.bytes()
		let i = 0
		let j = 0
		for i < x.len() && j < y.len() {
			if isDigitByte(x[i]) && isDigitByte(y[j]) {
				let m = 0
				for {
					m = m * 10 + int(x[i]) - 48
					i++
					break unless i < x.len() && isDigitByte(x[i]) && m > 0
				}
				let n = 0
				for {
					n = n * 10 + int(y[j]) - 48
					j++
					break unless j < y.len() && isDigitByte(y[j]) && n > 0
				}
				return -1 when m < n
				return 1 when m > n
			} else {
				return -1 when x[i] < y[j]
				return 1 when x[i] > y[j]
				i++
				j++
			}
		}
		return x.len() - y.len()
	}

	internal def isDigitByte(c byte) bool {
		return c >= 48 && c <= 57
	}
}
