// The GraphQL language (September 2025 specification): the lexer, the
// parser of executable and type-system documents, and the printer, over one
// node type. Errors and printed text are graphql-js 17's.
internal std.net.graphql partial module std.net.graphql.syntax {
	use std.errors

	// What a node is.
	enum NodeKind {
		Document,
		OperationDefinition,
		VariableDefinition,
		SelectionSet,
		Field,
		Argument,
		FragmentSpread,
		InlineFragment,
		FragmentDefinition,
		Variable,
		IntValue,
		FloatValue,
		StringValue,
		BooleanValue,
		NullValue,
		EnumValue,
		ListValue,
		ObjectValue,
		ObjectField,
		Directive,
		NamedType,
		ListType,
		NonNullType,
		SchemaDefinition,
		OperationTypeDefinition,
		ScalarTypeDefinition,
		ObjectTypeDefinition,
		FieldDefinition,
		InputValueDefinition,
		InterfaceTypeDefinition,
		UnionTypeDefinition,
		EnumTypeDefinition,
		EnumValueDefinition,
		InputObjectTypeDefinition,
		DirectiveDefinition,
		SchemaExtension,
		ScalarTypeExtension,
		ObjectTypeExtension,
		InterfaceTypeExtension,
		UnionTypeExtension,
		EnumTypeExtension,
		InputObjectTypeExtension,
	}

	// One node of a document. Which members are set depends on the kind:
	//
	//     name        the name of a field, argument, fragment, variable,
	//                 directive, type, enum value or operation
	//     alias       a field's alias
	//     text        a literal's text (number as written, string decoded,
	//                 `true`/`false`, enum name), an operation's type
	//                 ("query", "mutation", "subscription"), a fragment's or
	//                 inline fragment's type condition
	//     typeRef     the type of a variable, field or input value; the
	//                 element of a list type, the inner type of a non-null
	//     value       an argument's, object field's or default value
	//     arguments   arguments of a field or directive; argument
	//                 definitions of a field or directive definition
	//     directives  directives applied
	//     selections  a selection set's selections; a node with a selection
	//                 set holds it here directly (hasSelections tells an
	//                 empty one from none)
	//     items       list values, object fields, variable definitions,
	//                 field definitions, input value definitions, enum
	//                 values, union members, implemented interfaces,
	//                 operation types, directive locations (as names),
	//                 a document's definitions
	type Node {
		kind          NodeKind
		name          string   = ""
		alias         string   = ""
		text          string   = ""
		block         bool     = false
		description   ?Node    = none
		typeRef       ?Node    = none
		value         ?Node    = none
		arguments     Node[]   = []
		directives    Node[]   = []
		selections    Node[]   = []
		hasSelections bool     = false
		items         Node[]   = []
		interfaces    Node[]   = []
		repeatable    bool     = false
		// Where the node starts in the source: offset, line and column (from
		// 1).
		start         int      = 0
		line          int      = 0
		column        int      = 0

		def new(kind NodeKind) {
			self.kind = kind
		}
	}

	// A syntax error: the message and where it is.
	struct SyntaxError {
		message string
		code    string
		cause   ?error
		stack   errors.StackTrace
		line    int
		column  int
	}

	internal enum TokenKind {
		End,
		Punctuator,
		Name,
		Int,
		Float,
		String,
		BlockString,
	}

	internal struct Token {
		kind   TokenKind
		text   string
		start  int
		end    int
		line   int
		column int
	}

	// Where a lexer stands, kept to look one token ahead.
	internal struct LexerMark {
		at        int
		line      int
		lineStart int
		colAt     int
		col       int
		current   Token
	}

	// Reads tokens from the source, skipping what the grammar ignores:
	// whitespace, line terminators, commas, comments, byte order marks. Its
	// decisions and messages are graphql-js 17's, so an error reads the same
	// as the reference implementation's.
	internal type Lexer {
		src       byte[]
		at        int    = 0
		line      int    = 1
		lineStart int    = 0
		// The column (in characters) of offset colAt on the current line:
		// a token's column costs only the bytes since the previous token.
		colAt     int    = 0
		col       int    = 1
		current   Token

		def new(source string) {
			src = source.bytes()
			current = Token{kind: TokenKind.End}
		}

		def mark() LexerMark {
			return LexerMark{at: at, line: line, lineStart: lineStart, colAt: colAt, col: col, current: current}
		}

		def reset(m LexerMark) {
			at = m.at
			line = m.line
			lineStart = m.lineStart
			colAt = m.colAt
			col = m.col
			current = m.current
		}

		// The token after the current one, leaving the lexer where it is.
		def lookahead() !Token {
			let m = mark()
			let next = try advance()
			reset(m)
			return next
		}

		// A syntax error at the byte offset, with its line and column.
		def errorAt(message string, offset int) SyntaxError {
			let lineNo = 1
			let lineAt = 0
			let i = 0
			for i < offset && i < src.len() {
				if src[i] := 10 || 13 {
					i++ when src[i] == 13 && i + 1 < offset && src[i + 1] == 10
					lineNo++
					lineAt = i + 1
				}
				i++
			}
			let column = 1 + characters(lineAt, offset)
			return SyntaxError{message: "Syntax Error: " + message, code: "graphql-syntax", line: lineNo, column: column}
		}

		// The number of characters (code points) in the bytes from..to.
		def characters(from int, to int) int {
			let n = 0
			for let i = from; i < to && i < src.len(); i++ {
				n++ unless src[i] & 0xC0 == 0x80
			}
			return n
		}

		def byteAt(offset int) int {
			return offset < src.len() ?? (int(src[offset]), -1)
		}

		// Moves to the next token.
		def advance() !Token {
			skipIgnored()
			let start = at
			if lineStart > colAt {
				colAt = lineStart
				col = 1
			}
			col += characters(colAt, start)
			colAt = start
			let column = col
			if at >= src.len() {
				current = Token{kind: TokenKind.End, start: at, end: at, line: line, column: column}
				return current
			}
			let c = src[at]
			if c == 46 {
				let next = byteAt(at + 1)
				if next == 46 && byteAt(at + 2) == 46 {
					at += 3
					current = Token{kind: TokenKind.Punctuator, text: "...", start: start, end: at, line: line, column: column}
					return current
				}
				fail errorAt("Unexpected \"..\", did you mean \"...\"?", at) when next == 46
				if isDigitCode(next) {
					let end = try readDigits(at + 1, next)
					fail errorAt("Invalid number, expected digit before \".\", did you mean \"0.{string(src[at + 1:end])}\"?", at)
				}
			} else if c := 33 || 36 || 38 || 40 || 41 || 58 || 61 || 64 || 91 || 93 || 123 || 124 || 125 {
				at++
				current = Token{kind: TokenKind.Punctuator, text: string(src[start:at]), start: start, end: at, line: line, column: column}
				return current
			} else if c == 34 {
				return try blockString(start, column) when byteAt(at + 1) == 34 && byteAt(at + 2) == 34
				return try quoted(start, column)
			}
			return try number(start, column) when isDigit(c) || c == 45
			if isNameStart(c) {
				at++
				for at < src.len() && isNameContinue(src[at]) {
					at++
				}
				current = Token{kind: TokenKind.Name, text: string(src[start:at]), start: start, end: at, line: line, column: column}
				return current
			}
			fail errorAt("Unexpected single quote character ('), did you mean to use a double quote (\")?", at) when c == 39
			fail errorAt("Invalid character: {codePointAt(at)}.", at) when utf8Length(at) < 0
			fail errorAt("Unexpected character: {codePointAt(at)}.", at)
		}

		def skipIgnored() {
			for at < src.len() {
				let c = src[at]
				if c := 32 || 9 || 44 {
					at++
				} else if c == 10 {
					at++
					line++
					lineStart = at
				} else if c == 13 {
					at++
					at++ when at < src.len() && src[at] == 10
					line++
					lineStart = at
				} else if c == 35 {
					for at < src.len() && src[at] != 10 && src[at] != 13 {
						at++
					}
				} else if c == 0xEF && byteAt(at + 1) == 0xBB && byteAt(at + 2) == 0xBF {
					at += 3
				} else {
					return
				}
			}
		}

		def readDigits(offset int, first int) !int {
			fail errorAt("Invalid number, expected digit but got: {codePointAt(offset)}.", offset) unless isDigitCode(first)
			let pos = offset + 1
			for isDigitCode(byteAt(pos)) {
				pos++
			}
			return pos
		}

		def number(start int, column int) !Token {
			let pos = at
			let code = byteAt(pos)
			if code == 45 {
				pos++
				code = byteAt(pos)
			}
			if code == 48 {
				pos++
				code = byteAt(pos)
				fail errorAt("Invalid number, unexpected digit after 0: {codePointAt(pos)}.", pos) when isDigitCode(code)
			} else {
				pos = try readDigits(pos, code)
				code = byteAt(pos)
			}
			let isFloat = false
			if code == 46 {
				isFloat = true
				pos++
				pos = try readDigits(pos, byteAt(pos))
				code = byteAt(pos)
			}
			if code := 69 || 101 {
				isFloat = true
				pos++
				code = byteAt(pos)
				if code := 43 || 45 {
					pos++
					code = byteAt(pos)
				}
				pos = try readDigits(pos, code)
				code = byteAt(pos)
			}
			fail errorAt("Invalid number, expected digit but got: {codePointAt(pos)}.", pos) when code == 46 || (code >= 0 && isNameStart(byte(code)))
			at = pos
			current = Token{kind: isFloat ?? (TokenKind.Float, TokenKind.Int), text: string(src[start:at]), start: start, end: at, line: line, column: column}
			return current
		}

		def quoted(start int, column int) !Token {
			let pos = at + 1
			let chunk = pos
			let out byte[]
			for pos < src.len() {
				let c = src[pos]
				if c == 34 {
					out += src[chunk:pos]
					at = pos + 1
					current = Token{kind: TokenKind.String, text: string(out), start: start, end: at, line: line, column: column}
					return current
				}
				if c == 92 {
					out += src[chunk:pos]
					let (value, size) = try escape(pos)
					out += string(char(value)).bytes()
					pos += size
					chunk = pos
					continue
				}
				break when c := 10 || 13
				let n = utf8Length(pos)
				fail errorAt("Invalid character within String: {codePointAt(pos)}.", pos) when n < 0
				pos += n
			}
			fail errorAt("Unterminated string.", pos)
		}

		// An escape sequence at offset (its backslash): the code point it
		// stands for and its length in bytes.
		def escape(offset int) !(int, int) {
			if byteAt(offset + 1) == 117 {
				return try unicodeBraced(offset) when byteAt(offset + 2) == 123
				let code = hex16(offset + 2)
				return (code, 6) when isScalarValue(code)
				if code >= 0xD800 && code <= 0xDBFF && byteAt(offset + 6) == 92 && byteAt(offset + 7) == 117 {
					let trailing = hex16(offset + 8)
					return (0x10000 + ((code - 0xD800) << 10) + (trailing - 0xDC00), 12) when trailing >= 0xDC00 && trailing <= 0xDFFF
				}
				fail errorAt("Invalid Unicode escape sequence: \"{slice(offset, offset + 6)}\".", offset)
			}
			match byteAt(offset + 1) {
				case 34:
					return (34, 2)
				case 92:
					return (92, 2)
				case 47:
					return (47, 2)
				case 98:
					return (8, 2)
				case 102:
					return (12, 2)
				case 110:
					return (10, 2)
				case 114:
					return (13, 2)
				case 116:
					return (9, 2)
				default:
					fail errorAt("Invalid character escape sequence: \"{slice(offset, offset + 2)}\".", offset)
			}
		}

		// `\u{…}`: up to the closing brace, as graphql-js reads it (32-bit
		// arithmetic, at most twelve bytes).
		def unicodeBraced(offset int) !(int, int) {
			let point = 0
			let size = 3
			for size < 12 {
				let code = byteAt(offset + size)
				size++
				if code == 125 {
					break when size < 5 || !isScalarValue(point)
					return (point, size)
				}
				let digit = code < 0 ?? (-1, hexValue(byte(code)))
				break when digit < 0
				point = ((point << 4) | digit) & 0xFFFFFFFF
				break when point >= 0x80000000
			}
			fail errorAt("Invalid Unicode escape sequence: \"{slice(offset, offset + size)}\".", offset)
		}

		// Four hex digits at offset as a number; -1 when one is not a digit.
		def hex16(offset int) int {
			let value = 0
			for let i = 0; i < 4; i++ {
				let code = byteAt(offset + i)
				let digit = code < 0 ?? (-1, hexValue(byte(code)))
				return -1 when digit < 0
				value = value * 16 + digit
			}
			return value
		}

		def slice(from int, to int) string {
			return string(src[from:to < src.len() ?? (to, src.len())])
		}

		def blockString(start int, column int) !Token {
			let pos = at + 3
			let chunk = pos
			let pending byte[]
			let lines string[] = []
			let lastLineStart = lineStart
			let startLine = line
			for pos < src.len() {
				let c = src[pos]
				if c == 34 && byteAt(pos + 1) == 34 && byteAt(pos + 2) == 34 {
					pending += src[chunk:pos]
					lines.push(string(pending))
					at = pos + 3
					line += lines.len() - 1
					lineStart = lastLineStart
					current = Token{kind: TokenKind.BlockString, text: blockStringValue(lines.join("\n")), start: start, end: at, line: startLine, column: column}
					return current
				}
				if c == 92 && byteAt(pos + 1) == 34 && byteAt(pos + 2) == 34 && byteAt(pos + 3) == 34 {
					pending += src[chunk:pos]
					chunk = pos + 1
					pos += 4
					continue
				}
				if c := 10 || 13 {
					pending += src[chunk:pos]
					lines.push(string(pending))
					pos += c == 13 && byteAt(pos + 1) == 10 ?? (2, 1)
					pending = []
					chunk = pos
					lastLineStart = pos
					continue
				}
				let n = utf8Length(pos)
				fail errorAt("Invalid character within String: {codePointAt(pos)}.", pos) when n < 0
				pos += n
			}
			fail errorAt("Unterminated string.", pos)
		}

		// The length of the UTF-8 sequence at offset, -1 when it is not one.
		def utf8Length(offset int) int {
			let c = byteAt(offset)
			return -1 when c < 0
			return 1 when c < 0x80
			let (n, low, high) = c >= 0xC2 && c <= 0xDF ?? ((2, 0x80, 0xBF), c == 0xE0 ?? ((3, 0xA0, 0xBF), c == 0xED ?? ((3, 0x80, 0x9F), c >= 0xE1 && c <= 0xEF ?? ((3, 0x80, 0xBF), c == 0xF0 ?? ((4, 0x90, 0xBF), c >= 0xF1 && c <= 0xF3 ?? ((4, 0x80, 0xBF), c == 0xF4 ?? ((4, 0x80, 0x8F), (-1, 0, 0))))))))
			return -1 when n < 0
			let second = byteAt(offset + 1)
			return -1 unless second >= low && second <= high
			for let i = 2; i < n; i++ {
				let next = byteAt(offset + i)
				return -1 unless next >= 0x80 && next <= 0xBF
			}
			return n
		}

		// The character at offset as graphql-js names it in a message:
		// `"c"` for printable ASCII (`'"'` for a quote), `U+XXXX` otherwise,
		// `<EOF>` at the end.
		def codePointAt(offset int) string {
			return "<EOF>" when offset >= src.len()
			let c = src[offset]
			return "'\"'" when c == 34
			return "\"{string(src[offset:offset + 1])}\"" when c >= 0x20 && c <= 0x7E
			let n = utf8Length(offset)
			let point = 0xFFFD
			if n > 0 {
				point = int(c) & (n == 2 ?? (0x1F, n == 3 ?? (0x0F, 0x07)))
				for let i = 1; i < n; i++ {
					point = (point << 6) | (int(src[offset + i]) & 0x3F)
				}
			}
			return "U+" + "%04X".format(point)
		}
	}

	internal def isDigit(c byte) bool {
		return c >= 48 && c <= 57
	}

	internal def isDigitCode(c int) bool {
		return c >= 48 && c <= 57
	}

	internal def isNameStart(c byte) bool {
		return c == 95 || (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
	}

	internal def isNameContinue(c byte) bool {
		return isNameStart(c) || isDigit(c)
	}

	internal def isScalarValue(point int) bool {
		return (point >= 0 && point <= 0xD7FF) || (point >= 0xE000 && point <= 0x10FFFF)
	}

	internal def hexValue(c byte) int {
		return int(c) - 48 when c >= 48 && c <= 57
		return int(c) - 87 when c >= 97 && c <= 102
		return int(c) - 55 when c >= 65 && c <= 70
		return -1
	}

	// The value of a block string (spec 2.9.5 BlockStringValue): lines split
	// on any terminator, the common indentation of all lines but the first
	// removed, blank leading and trailing lines dropped, joined with \n.
	def blockStringValue(raw string) string {
		let lines = splitLines(raw)
		let common = -1
		for let i = 1; i < lines.len(); i++ {
			let indent = leadingWhitespace(lines[i])
			common = indent when indent < lines[i].len() && (common < 0 || indent < common)
		}
		if common > 0 {
			for let i = 1; i < lines.len(); i++ {
				lines[i] = lines[i].len() >= common ?? (lines[i][common:], "")
			}
		}
		for lines.len() > 0 && leadingWhitespace(lines[0]) == lines[0].len() {
			lines.shift()
		}
		for lines.len() > 0 && leadingWhitespace(lines[lines.len() - 1]) == lines[lines.len() - 1].len() {
			lines.pop()
		}
		return lines.join("\n")
	}

	internal def splitLines(text string) string[] {
		let out string[] = []
		let b = text.bytes()
		let from = 0
		let i = 0
		for i < b.len() {
			if b[i] := 10 || 13 {
				out.push(string(b[from:i]))
				i++ when b[i] == 13 && i + 1 < b.len() && b[i + 1] == 10
				i++
				from = i
			} else {
				i++
			}
		}
		out.push(string(b[from:]))
		return out
	}

	internal def leadingWhitespace(line string) int {
		let b = line.bytes()
		let n = 0
		for n < b.len() && (b[n] == 32 || b[n] == 9) {
			n++
		}
		return n
	}
}
