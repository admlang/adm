partial module std.net.graphql {
	use (
		std.net.graphql.syntax
		std.net.graphql.syntax::(Node, NodeKind)
	)

	// Where a variable is used: the variable node, the type expected there,
	// and whether that position has a default of its own.
	internal struct VariableUse {
		node       Node
		expected   Node
		hasDefault bool
		// The OneOf Input Object whose field the variable fills, "" for
		// any other position (spec IsNonNullPosition).
		oneOf      string = ""
	}

	// What validating one operation or fragment found, for the rules that
	// look across definitions.
	internal type DefinitionFacts {
		spreads   Node[]        = []
		variables VariableUse[] = []

		def new() {}
	}

	// The validation state.
	internal type Validator {
		schema    Schema
		doc       Node
		fragments map<string, Node>
		errors    GraphQLError[]    = []
		facts     DefinitionFacts

		def new(schema Schema, doc Node) {
			self.schema = schema
			self.doc = doc
			fragments = map<string, Node>{}
			facts = new DefinitionFacts()
		}

		def report(message string, nodes Node[]) {
			errors.push(GraphQLError{message: message, locations: nodes.mapElem(n => Location{line: n.line, column: n.column})})
		}
	}

	// Checks a document against the schema with every rule of the
	// specification (section 5), in the order graphql-js runs them, and a
	// selection depth of at most `maxDepth`. Empty when the document is
	// valid.
	internal def validateDocument(schema Schema, doc Node) GraphQLError[] {
		let v = new Validator(schema, doc)
		let operations Node[] = []
		for let d in doc.items {
			match d.kind {
				case NodeKind.OperationDefinition:
					operations.push(d)
				case NodeKind.FragmentDefinition:
					if v.fragments.hasKey(d.name) {
						v.report("There can be only one fragment named \"{d.name}\".", [v.fragments[d.name], d])
					} else {
						v.fragments[d.name] = d
					}
				default:
					let label = d.kind == NodeKind.SchemaDefinition || d.kind == NodeKind.SchemaExtension ?? ("schema", "\"{d.name}\"")
					v.report("The {label} definition is not executable.", [d])
			}
		}
		let names = map<string, Node>{}
		for let op in operations {
			if op.name != "" {
				if names.hasKey(op.name) {
					v.report("There can be only one operation named \"{op.name}\".", [names[op.name], op])
				} else {
					names[op.name] = op
				}
			}
			v.report("This anonymous operation must be the only defined operation.", [op]) when op.name == "" && operations.len() > 1
		}
		let fragmentFacts = map<string, DefinitionFacts>{}
		for let (name, f) in v.fragments {
			v.facts = new DefinitionFacts()
			let condition = schema.types.get(f.text)
			if condition is none {
				reportUnknownType(v, f.text, f)
			} else if !condition.isComposite() {
				v.report("Fragment \"{name}\" cannot condition on non composite type \"{f.text}\".", [f])
			}
			checkDirectives(v, f.directives, "FRAGMENT_DEFINITION")
			checkSelections(v, compositeOrNone(condition), f.selections, 1)
			fragmentFacts[name] = v.facts
		}
		checkFragmentCycles(v, fragmentFacts)
		let usedFragments string[] = []
		for let op in operations {
			v.facts = new DefinitionFacts()
			checkOperation(v, op)
			let ownFacts = v.facts
			let reached = reachableFragments(ownFacts, fragmentFacts)
			usedFragments += reached
			let uses = ownFacts.variables.clone()
			for let name in reached {
				uses += fragmentFacts[name].variables
			}
			checkVariableUses(v, op, uses)
		}
		for let (name, f) in v.fragments {
			v.report("Fragment \"{name}\" is never used.", [f]) unless usedFragments.includes(name)
		}
		for let op in operations {
			checkMerging(v, op.selections, rootTypeOf(schema, op))
		}
		for let (_, f) in v.fragments {
			let condition = schema.types.get(f.text)
			checkMerging(v, f.selections, compositeOrNone(condition))
		}
		return v.errors
	}

	internal def noneType() ?TypeDef {
		return none
	}

	internal def rootTypeOf(schema Schema, op Node) ?TypeDef {
		let name = op.text == "mutation" ?? (schema.mutationType, op.text == "subscription" ?? (schema.subscriptionType, schema.queryType))
		return name == "" ?? (noneType(), schema.types.get(name))
	}

	internal def checkOperation(v Validator, op Node) {
		let root = rootTypeOf(v.schema, op)
		v.report("The {op.text} operation is not supported by the schema.", [op]) when root is none
		let seen string[] = []
		for let d in op.items {
			v.report("There can be only one variable named \"${d.name}\".", [firstNamed(op.items, d.name, d), d]) when seen.includes(d.name)
			seen.push(d.name)
			let ref = refOr(d.typeRef)
			let t = v.schema.types.get(namedOf(ref))
			if t is none {
				reportUnknownType(v, namedOf(ref), ref)
			} else if !(t.kind == TypeKind.Scalar || t.kind == TypeKind.Enum || t.kind == TypeKind.InputObject) {
				v.report("Variable \"${d.name}\" cannot be non-input type \"{syntax.print(ref)}\".", [ref])
			} else {
				let dv = d.value
				checkLiteral(v, dv, ref) unless dv is none
			}
			checkDirectives(v, d.directives, "VARIABLE_DEFINITION")
		}
		checkDirectives(v, op.directives, op.text.upper())
		if op.text == "subscription" && !(root is none) {
			let label = op.name == "" ?? ("Anonymous Subscription", "Subscription \"{op.name}\"")
			let forbidden Node[] = []
			let top = topFields(v, root, op.selections, [], forbidden)
			if forbidden.len() > 0 {
				v.report("{label} must not use `@skip` or `@include` directives in the top level selection.", forbidden)
			} else {
				let keys string[] = []
				for let f in top {
					let key = f.alias == "" ?? (f.name, f.alias)
					keys.push(key) unless keys.includes(key)
				}
				v.report("{label} must select only one top level field.", top.filter(f => (f.alias == "" ?? (f.name, f.alias)) != keys[0])) when keys.len() > 1
				for let key in keys {
					let group = top.filter(f => (f.alias == "" ?? (f.name, f.alias)) == key)
					v.report("{label} must not select an introspection top level field.", group) when group[0].name.startsWith("__")
				}
			}
		}
		checkSelections(v, root, op.selections, 1)
	}

	// The root fields a subscription selects (spec CollectSubscriptionFields):
	// fragments that apply to the root type spread in; a selection with
	// @skip or @include is left out and its directive recorded in forbidden.
	internal def topFields(v Validator, root TypeDef, selections Node[], visited string[], forbidden Node[]) Node[] {
		let out Node[] = []
		for let s in selections {
			let condition = s.directives.find(d => d.name := "skip" || "include", 0)
			if !(condition is none) {
				forbidden.push(condition)
				continue
			}
			match s.kind {
				case NodeKind.Field:
					out.push(s)
				case NodeKind.FragmentSpread:
					continue when visited.includes(s.name)
					visited.push(s.name)
					let f = v.fragments.get(s.name)
					continue when f is none
					let fragmentType = v.schema.types.get(f.text)
					continue unless !(fragmentType is none) && fragmentApplies(root, fragmentType)
					out += topFields(v, root, f.selections, visited, forbidden)
				default:
					if s.text != "" {
						let fragmentType = v.schema.types.get(s.text)
						continue unless !(fragmentType is none) && fragmentApplies(root, fragmentType)
					}
					out += topFields(v, root, s.selections, visited, forbidden)
			}
		}
		return out
	}

	// Whether a fragment on fragmentType applies to an object of objectType
	// (spec DoesFragmentTypeApply).
	internal def fragmentApplies(objectType TypeDef, fragmentType TypeDef) bool {
		return fragmentType.name == objectType.name when fragmentType.kind == TypeKind.Object
		return fragmentType.isAbstract() && isPossible(fragmentType, objectType)
	}

	// The rules on selections: fields exist on the type, leaves have no
	// selections and composites have them, arguments are known, unique, of
	// the right type and given when required, fragments are known, on
	// composite types and possible here, directives fit.
	internal def checkSelections(v Validator, parent ?TypeDef, selections Node[], depth int) {
		if v.schema.maxDepth > 0 && depth > v.schema.maxDepth {
			v.report("The query is nested deeper than {v.schema.maxDepth} levels.", selections.len() > 0 ?? ([selections[0]], []))
			return
		}
		for let s in selections {
			match s.kind {
				case NodeKind.Field:
					checkField(v, parent, s, depth)
				case NodeKind.FragmentSpread:
					v.facts.spreads.push(s)
					checkDirectives(v, s.directives, "FRAGMENT_SPREAD")
					let f = v.fragments.get(s.name)
					if f is none {
						v.report("Unknown fragment \"{s.name}\".", [s])
						continue
					}
					let condition = compositeOrNone(v.schema.types.get(f.text))
					if !(parent is none) {
						if !(condition is none) {
							v.report("Fragment \"{s.name}\" cannot be spread here as objects of type \"{parent.name}\" can never be of type \"{condition.name}\".", [s]) unless typesOverlap(v.schema, parent, condition)
						}
					}
				default:
					checkDirectives(v, s.directives, "INLINE_FRAGMENT")
					let scope = parent
					if s.text != "" {
						let condition = v.schema.types.get(s.text)
						if condition is none {
							reportUnknownType(v, s.text, s)
							scope = noneType()
						} else if !condition.isComposite() {
							v.report("Fragment cannot condition on non composite type \"{s.text}\".", [s])
							scope = noneType()
						} else {
							v.report("Fragment cannot be spread here as objects of type \"{parent.name}\" can never be of type \"{condition.name}\".", [s]) when !(parent is none) && !typesOverlap(v.schema, parent, condition)
							scope = condition
						}
					}
					checkSelections(v, scope, s.selections, depth)
			}
		}
	}

	internal def checkField(v Validator, parent ?TypeDef, s Node, depth int) {
		checkDirectives(v, s.directives, "FIELD")
		let field ?FieldDef = none
		if !(parent is none) {
			if s.name == "__typename" {
				field = typenameField
			} else {
				field = fieldDefinition(v.schema, parent, s.name)
				v.report("Cannot query field \"{s.name}\" on type \"{parent.name}\"." + fieldSuggestion(v.schema, parent, s.name), [s]) when field is none
			}
		}
		let seen string[] = []
		for let a in s.arguments {
			v.report("There can be only one argument named \"{a.name}\".", [firstNamed(s.arguments, a.name, a), a]) when seen.includes(a.name)
			seen.push(a.name)
			if field is none {
				recordVariables(v, valueOr(a.value), noneRef(), false, "")
				continue
			}
			let argDef = field.arg(a.name)
			if argDef is none {
				v.report("Unknown argument \"{a.name}\" on field \"{parentName(parent)}.{s.name}\"." + didYouMean(suggestionList(a.name, field.args.mapElem(x => x.name))), [a])
				recordVariables(v, valueOr(a.value), noneRef(), false, "")
				continue
			}
			checkLiteral(v, valueOr(a.value), argDef.typeRef)
			recordVariables(v, valueOr(a.value), argDef.typeRef, !(argDef.defaultValue is none), "")
		}
		if field is none {
			checkSelections(v, noneType(), s.selections, depth + 1)
			return
		}
		for let a in field.args {
			v.report("Argument \"{parentName(parent)}.{s.name}({a.name}:)\" of type \"{syntax.print(a.typeRef)}\" is required, but it was not provided.", [s]) when isNonNull(a.typeRef) && a.defaultValue is none && s.arguments.find(x => x.name == a.name, 0) is none
		}
		let t = v.schema.types.get(namedOf(field.typeRef))
		return when t is none
		if t.isLeaf() && s.hasSelections {
			v.report("Field \"{s.name}\" must not have a selection since type \"{syntax.print(field.typeRef)}\" has no subfields.", [s.selections[0]])
		} else if !t.isLeaf() && !s.hasSelections {
			v.report("Field \"{s.name}\" of type \"{syntax.print(field.typeRef)}\" must have a selection of subfields. Did you mean \"{s.name} \{ ... \}\"?", [s])
		}
		checkSelections(v, compositeOrNone(t), s.selections, depth + 1)
	}

	internal const typenameField = new FieldDef("__typename", nonNullNamed("String"))

	internal def nonNullNamed(name string) Node {
		let named = new Node(NodeKind.NamedType)
		named.name = name
		let nn = new Node(NodeKind.NonNullType)
		nn.typeRef = named
		return nn
	}

	// The type when it is composite, none otherwise.
	internal def compositeOrNone(t ?TypeDef) ?TypeDef {
		return none when t is none
		return none unless t.isComposite()
		return t
	}

	internal def noneRef() ?Node {
		return none
	}

	// Records the variables of a value with the type each position expects;
	// none when the position's type is unknown. oneOf names the OneOf Input
	// Object whose field the value fills.
	internal def recordVariables(v Validator, value Node, expected ?Node, hasDefault bool, oneOf string) {
		match value.kind {
			case NodeKind.Variable:
				// A position of unknown type is recorded with an empty type, so
				// the variable counts as used but its type is not checked.
				v.facts.variables.push(VariableUse{node: value, expected: expected is none ?? (new Node(NodeKind.NamedType), expected), hasDefault: hasDefault, oneOf: oneOf})
			case NodeKind.ListValue:
				let element ?Node = expected is none ?? (noneRef(), expectedElement(expected))
				for let item in value.items {
					recordVariables(v, item, element, false, "")
				}
			case NodeKind.ObjectValue:
				let named ?TypeDef = expected is none ?? (noneType(), v.schema.types.get(namedOf(expected)))
				let owner = ""
				owner = named.oneOf ?? (named.name, "") unless (named is none)
				for let f in value.items {
					let field ?InputDef = named is none ?? (noneInput(), named.inputField(f.name))
					let fieldType ?Node = none
					let fieldDefault = false
					if !(field is none) {
						fieldType = field.typeRef
						fieldDefault = !(field.defaultValue is none)
					}
					recordVariables(v, valueOr(f.value), fieldType, fieldDefault, owner)
				}
			default:
		}
	}

	// Reports what is wrong with a literal for an input type (Values of
	// Correct Type) and input fields given twice (Input Object Field
	// Uniqueness).
	internal def checkLiteral(v Validator, value Node, ref Node) {
		let problems InputProblem[] = []
		validateInputLiteral(v.schema, value, ref, noneVariables(), [], problems)
		for let p in problems {
			let at = p.node
			v.report(p.message, at is none ?? ([value], [at]))
		}
		checkUniqueInputFields(v, value)
	}

	internal def checkUniqueInputFields(v Validator, value Node) {
		match value.kind {
			case NodeKind.ObjectValue:
				for let (i, f) in value.items {
					let first = value.items[0:i].find(x => x.name == f.name, 0)
					v.report("There can be only one input field named \"{f.name}\".", [first, f]) unless first is none
					checkUniqueInputFields(v, valueOr(f.value))
				}
			case NodeKind.ListValue:
				for let item in value.items {
					checkUniqueInputFields(v, item)
				}
			default:
		}
	}

	internal def reportUnknownType(v Validator, name string, at Node) {
		v.report("Unknown type \"{name}\"." + didYouMean(suggestionList(name, v.schema.order)), [at])
	}

	// The suggestion of a field a type lacks (graphql-js
	// FieldsOnCorrectType): for an abstract type, the types that have it,
	// those more of them share first; else the type's fields named alike.
	internal def fieldSuggestion(schema Schema, parent TypeDef, name string) string {
		if parent.isAbstract() {
			let found SuggestedType[] = []
			for let possible in possibleTypes(schema, parent) {
				continue when possible.field(name) is none
				found.push(new SuggestedType(possible, 1)) when found.find(x => x.t.name == possible.name, 0) is none
				for let i in possible.interfaces {
					let it = schema.types.get(i)
					continue when it is none || it.field(name) is none
					let seen = found.find(x => x.t.name == i, 0)
					if seen is none {
						found.push(new SuggestedType(it, 1))
					} else {
						seen.uses++
					}
				}
			}
			found.sort((a SuggestedType, b SuggestedType) => suggestedTypeBefore(a, b))
			let types = didYouMean(found.mapElem(x => x.t.name), "to use an inline fragment on")
			return types unless types == ""
		}
		return "" unless parent.kind == TypeKind.Object || parent.kind == TypeKind.Interface
		return didYouMean(suggestionList(name, parent.fields.mapElem(f => f.name)))
	}

	// The order of suggested types: the ones more possible types share
	// first, an interface before the types implementing it, else by name.
	internal def suggestedTypeBefore(a SuggestedType, b SuggestedType) bool {
		return a.uses > b.uses when a.uses != b.uses
		return true when a.t.kind == TypeKind.Interface && isSubtype(b.t, a.t)
		return false when b.t.kind == TypeKind.Interface && isSubtype(a.t, b.t)
		return naturalCompare(a.t.name, b.t.name) < 0
	}

	// A type suggested for a field, and how many of the possible types
	// lead to it.
	internal type SuggestedType {
		t    TypeDef
		uses int

		def new(t TypeDef, uses int) {
			self.t = t
			self.uses = uses
		}
	}

	internal def noneInput() ?InputDef {
		return none
	}

	internal def expectedElement(ref Node) ?Node {
		let list = ref.kind == NodeKind.NonNullType ?? (inner(ref), ref)
		return list.kind == NodeKind.ListType ?? (inner(list), noneRef())
	}

	// Directives are defined, allowed at the location, given once unless
	// repeatable, with known, unique, fitting and required arguments.
	internal def checkDirectives(v Validator, directives Node[], location string) {
		for let (i, d) in directives {
			let known = v.schema.directives.get(d.name)
			if known is none {
				v.report("Unknown directive \"@{d.name}\".", [d])
				for let a in d.arguments {
					recordVariables(v, valueOr(a.value), noneRef(), false, "")
				}
				continue
			}
			v.report("Directive \"@{d.name}\" may not be used on {location}.", [d]) unless known.locations.includes(location)
			if !known.repeatable {
				for let j = 0; j < i; j++ {
					v.report("The directive \"@{d.name}\" can only be used once at this location.", [directives[j], d]) when directives[j].name == d.name
				}
			}
			let seen string[] = []
			for let a in d.arguments {
				v.report("There can be only one argument named \"{a.name}\".", [firstNamed(d.arguments, a.name, a), a]) when seen.includes(a.name)
				seen.push(a.name)
				let argDef = known.arg(a.name)
				if argDef is none {
					v.report("Unknown argument \"{a.name}\" on directive \"@{d.name}\"." + didYouMean(suggestionList(a.name, known.args.mapElem(x => x.name))), [a])
					recordVariables(v, valueOr(a.value), noneRef(), false, "")
					continue
				}
				checkLiteral(v, valueOr(a.value), argDef.typeRef)
				recordVariables(v, valueOr(a.value), argDef.typeRef, !(argDef.defaultValue is none), "")
			}
			for let a in known.args {
				v.report("Argument \"@{d.name}({a.name}:)\" of type \"{syntax.print(a.typeRef)}\" is required, but it was not provided.", [d]) when isNonNull(a.typeRef) && a.defaultValue is none && d.arguments.find(x => x.name == a.name, 0) is none
			}
		}
	}

	// Whether some object type can be both (spec GetPossibleTypes overlap).
	internal def typesOverlap(schema Schema, a TypeDef, b TypeDef) bool {
		let pa = a.isAbstract() ?? (possibleTypes(schema, a).mapElem(t => t.name), [a.name])
		let pb = b.isAbstract() ?? (possibleTypes(schema, b).mapElem(t => t.name), [b.name])
		for let name in pa {
			return true when pb.includes(name)
		}
		return false
	}

	// The fragments an operation reaches through its spreads, transitively.
	internal def reachableFragments(own DefinitionFacts, all map<string, DefinitionFacts>) string[] {
		let out string[] = []
		let queue = own.spreads.mapElem(s => s.name)
		for queue.len() > 0 {
			let name = queue.shift()
			continue when out.includes(name) || !all.hasKey(name)
			out.push(name)
			queue += all[name].spreads.mapElem(s => s.name)
		}
		return out
	}

	// The walk of the fragment-cycle rule.
	internal type CycleWalk {
		visited string[]         = []
		path    Node[]           = []
		index   map<string, int> = map<string, int>{}

		def new() {}
	}

	// No fragment spreads itself, directly or through others (spec 5.5.2.2),
	// each cycle reported once, as graphql-js reports it.
	internal def checkFragmentCycles(v Validator, facts map<string, DefinitionFacts>) {
		let walk = new CycleWalk()
		for let d in v.doc.items {
			cycleFrom(v, facts, walk, d.name) when d.kind == NodeKind.FragmentDefinition
		}
	}

	internal def cycleFrom(v Validator, facts map<string, DefinitionFacts>, walk CycleWalk, name string) {
		return when walk.visited.includes(name)
		walk.visited.push(name)
		let own = facts.get(name)
		return when own is none || own.spreads.len() == 0
		walk.index[name] = walk.path.len()
		for let spread in own.spreads {
			let cycleIndex = walk.index.get(spread.name)
			walk.path.push(spread)
			if cycleIndex is none {
				cycleFrom(v, facts, walk, spread.name)
			} else {
				let cycle = walk.path[cycleIndex:].clone()
				let via = cycle[:cycle.len() - 1].mapElem(n => "\"{n.name}\"")
				v.report("Cannot spread fragment \"{spread.name}\" within itself{via.len() > 0 ?? (" via " + via.join(", ") + ".", ".")}", cycle)
			}
			walk.path.pop()
		}
		walk.index.delete(name)
	}

	internal def firstNamed(nodes Node[], name string, fallback Node) Node {
		let found = nodes.find(n => n.name == name, 0)
		return found is none ?? (fallback, found)
	}

	internal def parentName(parent ?TypeDef) string {
		return parent is none ?? ("", parent.name)
	}

	// Every variable used is defined by the operation, every one defined is
	// used, and each use is in a position its type allows.
	internal def checkVariableUses(v Validator, op Node, uses VariableUse[]) {
		for let usage in uses {
			let d = op.items.find(x => x.name == usage.node.name, 0)
			if d is none {
				v.report(op.name == "" ?? ("Variable \"${usage.node.name}\" is not defined.", "Variable \"${usage.node.name}\" is not defined by operation \"{op.name}\"."), [usage.node, op])
				continue
			}
			continue when usage.expected.kind == NodeKind.NamedType && usage.expected.name == ""
			let varType = refOr(d.typeRef)
			let location = usage.expected
			let nonNullPosition = location.kind == NodeKind.NonNullType || usage.oneOf != ""
			let fits = false
			if nonNullPosition && varType.kind != NodeKind.NonNullType {
				let varDefault = d.value
				let hasDefault = !(varDefault is none) && varDefault.kind != NodeKind.NullValue
				let nullable = location.kind == NodeKind.NonNullType ?? (inner(location), location)
				fits = (hasDefault || usage.hasDefault) && typeFits(v.schema, varType, nullable)
			} else {
				fits = typeFits(v.schema, varType, location)
			}
			if !fits {
				if location.kind != NodeKind.NonNullType && usage.oneOf != "" && typeFits(v.schema, varType, location) {
					v.report("Variable \"${usage.node.name}\" is of type \"{syntax.print(varType)}\" but must be non-nullable to be used for OneOf Input Object \"{usage.oneOf}\".", [d, usage.node])
				} else {
					v.report("Variable \"${usage.node.name}\" of type \"{syntax.print(varType)}\" used in position expecting type \"{syntax.print(location)}\".", [d, usage.node])
				}
			}
		}
		for let d in op.items {
			v.report(op.name == "" ?? ("Variable \"${d.name}\" is never used.", "Variable \"${d.name}\" is never used in operation \"{op.name}\"."), [d]) when uses.find(u => u.node.name == d.name, 0) is none
		}
	}

	// Whether a variable of one type may stand where another is expected
	// (spec AreTypesCompatible).
	internal def typeFits(schema Schema, varType Node, location Node) bool {
		return varType.kind == NodeKind.NonNullType && typeFits(schema, inner(varType), inner(location)) when location.kind == NodeKind.NonNullType
		return typeFits(schema, inner(varType), location) when varType.kind == NodeKind.NonNullType
		return varType.kind == NodeKind.ListType && typeFits(schema, inner(varType), inner(location)) when location.kind == NodeKind.ListType
		return false when varType.kind == NodeKind.ListType
		return varType.name == location.name
	}

	// One field of a selection set as the merging rule sees it: the node,
	// the type it is selected on and its definition.
	internal struct MergeField {
		node       Node
		parent     ?TypeDef
		definition ?FieldDef
	}

	// Fields that share a response name can be merged (spec
	// FieldsInSetCanMerge): the same field with the same arguments when
	// their parents may be the same object, and responses of the same shape
	// always.
	internal def checkMerging(v Validator, selections Node[], parent ?TypeDef) {
		let groups = mergeGroups(v, parent, selections, [])
		let reported string[] = []
		for let (key, fields) in groups {
			for let i = 0; i < fields.len(); i++ {
				for let j = i + 1; j < fields.len(); j++ {
					let reason = conflict(v, fields[i], fields[j], false)
					if reason != "" && !reported.includes(key) {
						reported.push(key)
						v.report("Fields \"{key}\" conflict because {reason}. Use different aliases on the fields to fetch both if this was intentional.", [fields[i].node, fields[j].node])
					}
				}
			}
			for let f in fields {
				let fd = f.definition
				let sub ?TypeDef = fd is none ?? (noneType(), v.schema.types.get(namedOf(fd.typeRef)))
				checkMerging(v, f.node.selections, compositeOrNone(sub))
			}
		}
	}

	internal def mergeGroups(v Validator, parent ?TypeDef, selections Node[], visited string[]) map<string, MergeField[]> {
		let out = map<string, MergeField[]>{}
		for let s in selections {
			match s.kind {
				case NodeKind.Field:
					let key = s.alias == "" ?? (s.name, s.alias)
					let fd ?FieldDef = none
					if !(parent is none) {
						if s.name == "__typename" {
							fd = typenameField
						} else {
							fd = fieldDefinition(v.schema, parent, s.name)
						}
					}
					let list = out.get(key)
					let item = MergeField{node: s, parent: parent, definition: fd}
					out[key] = list is none ?? ([item], list + [item])
				case NodeKind.FragmentSpread:
					continue when visited.includes(s.name)
					visited.push(s.name)
					let f = v.fragments.get(s.name)
					continue when f is none
					let condition = v.schema.types.get(f.text)
					for let (key, items) in mergeGroups(v, condition, f.selections, visited) {
						let list = out.get(key)
						out[key] = list is none ?? (items, list + items)
					}
				default:
					let condition ?TypeDef = s.text == "" ?? (parent, v.schema.types.get(s.text))
					for let (key, items) in mergeGroups(v, condition, s.selections, visited) {
						let list = out.get(key)
						out[key] = list is none ?? (items, list + items)
					}
			}
		}
		return out
	}

	// Why two fields of one response name cannot merge, "" when they can.
	// mutuallyExclusive is set once their parents are known to be different
	// object types, which lets name and arguments differ.
	internal def conflict(v Validator, a MergeField, b MergeField, exclusiveAbove bool) string {
		let pa = a.parent
		let pb = b.parent
		let exclusive = exclusiveAbove || differentObjects(pa, pb)
		if !exclusive {
			return "\"{a.node.name}\" and \"{b.node.name}\" are different fields" when a.node.name != b.node.name
			return "they have differing arguments" unless sameArguments(a.node.arguments, b.node.arguments)
		}
		let da = a.definition
		let db = b.definition
		if !(da is none) && !(db is none) {
			let shape = shapeConflict(v, da.typeRef, db.typeRef)
			return "they return conflicting types \"{syntax.print(da.typeRef)}\" and \"{syntax.print(db.typeRef)}\"" when shape
			let ta = compositeOrNone(v.schema.types.get(namedOf(da.typeRef)))
			let tb = compositeOrNone(v.schema.types.get(namedOf(db.typeRef)))
			if !(ta is none) && !(tb is none) {
				let left = mergeGroups(v, ta, a.node.selections, [])
				let right = mergeGroups(v, tb, b.node.selections, [])
				let reasons string[] = []
				for let (key, lefts) in left {
					let rights = right.get(key)
					continue when rights is none
					for let l in lefts {
						for let r in rights {
							let inner = conflict(v, l, r, exclusive)
							if inner != "" {
								reasons.push("subfields \"{key}\" conflict because {inner}")
								break
							}
						}
						break when reasons.len() > 0 && reasons[reasons.len() - 1].startsWith("subfields \"{key}\"")
					}
				}
				return reasons.join(" and ") when reasons.len() > 0
			}
		}
		return ""
	}

	// Whether two parents are different object types, so no object is both.
	internal def differentObjects(a ?TypeDef, b ?TypeDef) bool {
		return false when a is none
		return false when b is none
		return a.name != b.name && a.kind == TypeKind.Object && b.kind == TypeKind.Object
	}

	// Whether two output types give responses of different shapes (spec
	// SameResponseShape, the type part).
	internal def shapeConflict(v Validator, a Node, b Node) bool {
		if a.kind == NodeKind.NonNullType || b.kind == NodeKind.NonNullType {
			return true unless a.kind == NodeKind.NonNullType && b.kind == NodeKind.NonNullType
			return shapeConflict(v, inner(a), inner(b))
		}
		if a.kind == NodeKind.ListType || b.kind == NodeKind.ListType {
			return true unless a.kind == NodeKind.ListType && b.kind == NodeKind.ListType
			return shapeConflict(v, inner(a), inner(b))
		}
		let ta = v.schema.types.get(a.name)
		let tb = v.schema.types.get(b.name)
		return false when ta is none || tb is none
		return ta.name != tb.name when ta.isLeaf() || tb.isLeaf()
		return false
	}

	internal def sameArguments(a Node[], b Node[]) bool {
		return false when a.len() != b.len()
		for let x in a {
			let y = b.find(n => n.name == x.name, 0)
			return false when y is none
			return false when syntax.print(valueOr(x.value)) != syntax.print(valueOr(y.value))
		}
		return true
	}
}
