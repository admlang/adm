partial module std.net.graphql {
	use (
		std.errors
		std.reflection
		std.math::(Decimal)
		std.net.graphql.syntax
		std.net.graphql.syntax::(Node, NodeKind)
	)

	internal const int32Min = -2147483648
	internal const int32Max = 2147483647

	// A literal as the JSON value it writes, variables replaced by their
	// values.
	internal def literalToJSON(literal Node, variables map<string, any>) any {
		match literal.kind {
			case NodeKind.IntValue:
				return literal.text.toInt<int>()
			case NodeKind.FloatValue:
				return parseFloat<float>(literal.text)
			case NodeKind.StringValue, NodeKind.EnumValue:
				return literal.text
			case NodeKind.BooleanValue:
				return literal.text == "true"
			case NodeKind.ListValue:
				let out any[] = []
				for let item in literal.items {
					out.push(literalToJSON(item, variables))
				}
				return out
			case NodeKind.ObjectValue:
				let out = map<string, any>{}
				for let f in literal.items {
					out[f.name] = literalToJSON(valueOr(f.value), variables)
				}
				return out
			case NodeKind.Variable:
				return none unless variables.hasKey(literal.name)
				return variables[literal.name]
			default:
				return none
		}
	}

	// Why a value coercion failed: the message and the path into the value.
	internal struct CoercionError {
		message string
		code    string
		cause   ?error
		stack   errors.StackTrace
	}

	// none as an `any`, for a conditional whose other arm is a value.
	internal def noneValue() any {
		return none
	}

	internal def valueOr(n ?Node) Node {
		return n is none ?? (new Node(NodeKind.NullValue), n)
	}

	internal def refOr(n ?Node) Node {
		return n is none ?? (new Node(NodeKind.NamedType), n)
	}

	internal def coercionError(message string) CoercionError {
		return CoercionError{message: message, code: "graphql-coercion"}
	}

	// One problem of an input value: graphql-js's message, the path into
	// the value (field names and list indexes) and, for a literal, the node
	// at fault.
	internal struct InputProblem {
		message string
		path    any[]
		node    ?Node  = none
	}

	// ` at .a[0].b`, as graphql-js prints a path into an input value; "" for
	// the value itself.
	internal def printPath(path any[]) string {
		return "" when path.len() == 0
		let out = " at "
		for let p in path {
			out += p is int ?? ("[{p}]", ".{p}")
		}
		return out
	}

	// Whether an input field or argument must be given: non-null without a
	// default.
	internal def isRequiredInput(f InputDef) bool {
		return isNonNull(f.typeRef) && f.defaultValue is none
	}

	internal def oneOfProblem(t TypeDef) string {
		return "Within OneOf Input Object type \"{t.name}\", exactly one field must be specified, and the value for that field must be non-null."
	}

	internal def noneVariables() ?map<string, any> {
		return none
	}

	// The value of an input value's default, coerced; (false, none) when
	// there is none.
	internal def coerceDefault(schema Schema, f InputDef) (bool, any) {
		let d = f.defaultValue
		return (false, none) when d is none
		return coerceInputLiteral(schema, d, f.typeRef, noneVariables())
	}

	// A list input value as its items: any array the program or a JSON
	// decoder made; none for anything else.
	internal def listItems(value any) ?any[] {
		return value when value is any[]
		return none unless reflection.kindOf(value) == reflection.FieldKind.Array
		return reflection.elements(value)
	}

	// An object input value as a map: a string-keyed map of any value type;
	// none for anything else.
	internal def objectEntries(value any) ?map<string, any> {
		return value when value is map<string, any>
		return none unless reflection.kindOf(value) == reflection.FieldKind.Map
		let out = map<string, any>{}
		for let k in reflection.keysOf(value) {
			let v = reflection.entryOf(value, k)
			out[k] = v is none ?? (noneValue(), v)
		}
		return out
	}

	// A variable's value from the request (JSON) as the input type ref
	// takes it (spec input coercion, graphql-js coerceInputValue): (true,
	// value) when it fits, (false, none) when not; validateInputValue tells
	// why. given is false for a variable the request left out.
	internal def coerceInputValue(schema Schema, value any, given bool, ref Node) (bool, any) {
		if ref.kind == NodeKind.NonNullType {
			return (false, none) when !given || value is none
			return coerceInputValue(schema, value, true, inner(ref))
		}
		return (true, none) when !given || value is none
		if ref.kind == NodeKind.ListType {
			let items = listItems(value)
			if !(items is none) {
				let out any[] = []
				for let item in items {
					let (ok, v) = coerceInputValue(schema, item, true, inner(ref))
					return (false, none) unless ok
					out.push(v)
				}
				return (true, out)
			}
			let (ok, v) = coerceInputValue(schema, value, true, inner(ref))
			return (false, none) unless ok
			return (true, any[v])
		}
		let t = schema.types.get(ref.name)
		return (false, none) when t is none
		match t.kind {
			case TypeKind.InputObject:
				let entries = objectEntries(value)
				return (false, none) when entries is none
				for let (k, _) in entries {
					return (false, none) when t.inputField(k) is none
				}
				let out = map<string, any>{}
				for let f in t.inputFields {
					if !entries.hasKey(f.name) {
						return (false, none) when isRequiredInput(f)
						let (has, d) = coerceDefault(schema, f)
						out[f.name] = d when has
						continue
					}
					let (ok, v) = coerceInputValue(schema, entries[f.name], true, f.typeRef)
					return (false, none) unless ok
					out[f.name] = v
				}
				if t.oneOf {
					return (false, none) unless entries.len() == 1 && out.len() == 1
					for let (_, v) in out {
						return (false, none) when v is none
					}
				}
				return (true, out)
			case TypeKind.Enum:
				let v = coerceEnumValue(t, value) onerror (err error) {
					return (false, none)
				}
				return (true, v)
			default:
				let v = coerceScalarValue(t, value) onerror (err error) {
					return (false, none)
				}
				return (true, v)
		}
	}

	// What is wrong with a variable's value for the input type ref, every
	// problem with its path, as graphql-js reports them (validateInputValue).
	internal def validateInputValue(schema Schema, value any, given bool, ref Node, path any[], out InputProblem[]) {
		if ref.kind == NodeKind.NonNullType {
			if !given {
				out.push(InputProblem{message: "Expected a value of non-null type \"{syntax.print(ref)}\" to be provided.", path: path})
				return
			}
			if value is none {
				out.push(InputProblem{message: "Expected value of non-null type \"{syntax.print(ref)}\" not to be null.", path: path})
				return
			}
			validateInputValue(schema, value, true, inner(ref), path, out)
			return
		}
		return when !given || value is none
		if ref.kind == NodeKind.ListType {
			let items = listItems(value)
			if !(items is none) {
				for let (i, item) in items {
					validateInputValue(schema, item, true, inner(ref), path + [i], out)
				}
			} else {
				validateInputValue(schema, value, true, inner(ref), path, out)
			}
			return
		}
		let t = schema.types.get(ref.name)
		return when t is none
		match t.kind {
			case TypeKind.InputObject:
				let entries = objectEntries(value)
				if entries is none {
					out.push(InputProblem{message: "Expected value of type \"{t.name}\" to be an object, found: {inspectValue(value)}.", path: path})
					return
				}
				for let f in t.inputFields {
					if !entries.hasKey(f.name) {
						out.push(InputProblem{message: "Expected value of type \"{t.name}\" to include required field \"{f.name}\", found: {inspectValue(entries)}.", path: path}) when isRequiredInput(f)
						continue
					}
					validateInputValue(schema, entries[f.name], true, f.typeRef, path + [f.name], out)
				}
				let known string[] = []
				for let (k, _) in entries {
					if t.inputField(k) is none {
						let suggestion = didYouMean(suggestionList(k, t.inputFields.mapElem(x => x.name)))
						out.push(InputProblem{message: "Expected value of type \"{t.name}\" not to include unknown field \"{k}\"{suggestion == "" ?? (", found", "." + suggestion + " Found")}: {inspectValue(entries)}.", path: path})
						continue
					}
					known.push(k)
				}
				if t.oneOf {
					out.push(InputProblem{message: oneOfProblem(t), path: path}) when known.len() != 1
					out.push(InputProblem{message: oneOfProblem(t), path: path + [known[0]]}) when known.len() > 0 && entries.hasKey(known[0]) && entries[known[0]] is none
				}
			case TypeKind.Enum:
				coerceEnumValue(t, value) onerror (err error) {
					out.push(InputProblem{message: err.message, path: path})
					recover none
				}
			default:
				coerceScalarValue(t, value) onerror (err error) {
					let message = err is CoercionError ?? (err.message, "Expected value of type \"{t.name}\", but encountered error \"{err.message}\"; found: {inspectValue(value)}.")
					out.push(InputProblem{message: message, path: path})
					recover none
				}
		}
	}

	// The value of a literal for the input type ref (spec input coercion,
	// graphql-js coerceInputLiteral), variables replaced by their coerced
	// values: (true, value) when it fits, (false, none) when not;
	// validateInputLiteral tells why. variables is none where a literal must
	// be constant (a default value).
	internal def coerceInputLiteral(schema Schema, node Node, ref Node, variables ?map<string, any>) (bool, any) {
		if node.kind == NodeKind.Variable {
			let (has, v) = variableOf(node, variables)
			return (false, none) when (!has || v is none) && isNonNull(ref)
			return (has, v)
		}
		if ref.kind == NodeKind.NonNullType {
			return (false, none) when node.kind == NodeKind.NullValue
			return coerceInputLiteral(schema, node, inner(ref), variables)
		}
		return (true, none) when node.kind == NodeKind.NullValue
		if ref.kind == NodeKind.ListType {
			if node.kind != NodeKind.ListValue {
				let (ok, v) = coerceInputLiteral(schema, node, inner(ref), variables)
				return (false, none) unless ok
				return (true, any[v])
			}
			let out any[] = []
			for let item in node.items {
				let (ok, v) = coerceInputLiteral(schema, item, inner(ref), variables)
				if !ok {
					let (has, held) = item.kind == NodeKind.Variable ?? (variableOf(item, variables), (true, noneValue()))
					return (false, none) unless item.kind == NodeKind.Variable && (!has || held is none) && !isNonNull(inner(ref))
				}
				out.push(v)
			}
			return (true, out)
		}
		let t = schema.types.get(ref.name)
		return (false, none) when t is none
		match t.kind {
			case TypeKind.InputObject:
				return (false, none) unless node.kind == NodeKind.ObjectValue
				for let f in node.items {
					return (false, none) when t.inputField(f.name) is none
				}
				let out = map<string, any>{}
				for let f in t.inputFields {
					let given = lastField(node, f.name)
					if given is none || (valueOr(given.value).kind == NodeKind.Variable && !variableOf(valueOr(given.value), variables).0) {
						return (false, none) when isRequiredInput(f)
						let (has, d) = coerceDefault(schema, f)
						out[f.name] = d when has
						continue
					}
					let (ok, v) = coerceInputLiteral(schema, valueOr(given.value), f.typeRef, variables)
					return (false, none) unless ok
					out[f.name] = v
				}
				if t.oneOf {
					let names string[] = []
					for let f in node.items {
						names.push(f.name) unless names.includes(f.name)
					}
					return (false, none) unless names.len() == 1 && out.len() == 1
					let only = lastField(node, names[0])
					return (false, none) when only is none || valueOr(only.value).kind == NodeKind.NullValue || !out.hasKey(names[0]) || out[names[0]] is none
				}
				return (true, out)
			case TypeKind.Enum:
				let v = coerceEnumLiteral(t, node) onerror (err error) {
					return (false, none)
				}
				return (true, v)
			default:
				let v = coerceScalarLiteral(t, node, variables) onerror (err error) {
					return (false, none)
				}
				return (true, v)
		}
	}

	// A variable's coerced value: (false, none) when it has none (not
	// given, no default) or there are no variables.
	internal def variableOf(node Node, variables ?map<string, any>) (bool, any) {
		return (false, none) when variables is none
		return (false, none) unless variables.hasKey(node.name)
		return (true, variables[node.name])
	}

	// The field of an object literal named name, the last one written when
	// it is written twice (as graphql-js keys them).
	internal def lastField(node Node, name string) ?Node {
		let found ?Node = none
		for let f in node.items {
			found = f when f.name == name
		}
		return found
	}

	// What is wrong with a literal for the input type ref, every problem
	// with its node and path, as graphql-js reports them
	// (validateInputLiteral). Without variables (validation) a variable is
	// taken to fit; with them, a variable that must hold a value and does
	// not is reported.
	internal def validateInputLiteral(schema Schema, node Node, ref Node, variables ?map<string, any>, path any[], out InputProblem[]) {
		if node.kind == NodeKind.Variable {
			return when variables is none
			if ref.kind == NodeKind.NonNullType {
				let (has, v) = variableOf(node, variables)
				if !has {
					out.push(InputProblem{message: "Expected variable \"${node.name}\" provided to type \"{syntax.print(ref)}\" to provide a runtime value.", path: path, node: node})
				} else if v is none {
					out.push(InputProblem{message: "Expected variable \"${node.name}\" provided to non-null type \"{syntax.print(ref)}\" not to be null.", path: path, node: node})
				}
			}
			return
		}
		if ref.kind == NodeKind.NonNullType {
			if node.kind == NodeKind.NullValue {
				out.push(InputProblem{message: "Expected value of non-null type \"{syntax.print(ref)}\" not to be null.", path: path, node: node})
				return
			}
			validateInputLiteral(schema, node, inner(ref), variables, path, out)
			return
		}
		return when node.kind == NodeKind.NullValue
		if ref.kind == NodeKind.ListType {
			if node.kind != NodeKind.ListValue {
				validateInputLiteral(schema, node, inner(ref), variables, path, out)
				return
			}
			for let (i, item) in node.items {
				validateInputLiteral(schema, item, inner(ref), variables, path + [i], out)
			}
			return
		}
		let t = schema.types.get(ref.name)
		return when t is none
		match t.kind {
			case TypeKind.InputObject:
				if node.kind != NodeKind.ObjectValue {
					out.push(InputProblem{message: "Expected value of type \"{t.name}\" to be an object, found: {syntax.print(node)}.", path: path, node: node})
					return
				}
				for let f in t.inputFields {
					let given = lastField(node, f.name)
					if given is none {
						out.push(InputProblem{message: "Expected value of type \"{t.name}\" to include required field \"{f.name}\", found: {syntax.print(node)}.", path: path, node: node}) when isRequiredInput(f)
						continue
					}
					let value = valueOr(given.value)
					if value.kind == NodeKind.Variable && !(variables is none) {
						let (has, v) = variableOf(value, variables)
						if t.oneOf {
							if !has {
								out.push(InputProblem{message: "Expected variable \"${value.name}\" provided to field \"{f.name}\" for OneOf Input Object type \"{t.name}\" to provide a runtime value.", path: path, node: node})
							} else if v is none {
								out.push(InputProblem{message: "Expected variable \"${value.name}\" provided to field \"{f.name}\" for OneOf Input Object type \"{t.name}\" not to be null.", path: path, node: node})
							}
						} else if !has && !isRequiredInput(f) {
							continue
						}
					}
					validateInputLiteral(schema, value, f.typeRef, variables, path + [f.name], out)
				}
				let known Node[] = []
				for let f in node.items {
					if t.inputField(f.name) is none {
						let suggestion = didYouMean(suggestionList(f.name, t.inputFields.mapElem(x => x.name)))
						out.push(InputProblem{message: "Expected value of type \"{t.name}\" not to include unknown field \"{f.name}\"{suggestion == "" ?? (", found", "." + suggestion + " Found")}: {syntax.print(node)}.", path: path, node: f})
						continue
					}
					known.push(f)
				}
				if t.oneOf {
					if known.len() != 1 {
						out.push(InputProblem{message: oneOfProblem(t), path: path, node: node})
						return
					}
					out.push(InputProblem{message: oneOfProblem(t), path: path + [known[0].name], node: node}) when valueOr(known[0].value).kind == NodeKind.NullValue
				}
			case TypeKind.Enum:
				coerceEnumLiteral(t, node) onerror (err error) {
					out.push(InputProblem{message: err.message, path: path, node: node})
					recover none
				}
			default:
				coerceScalarLiteral(t, node, variables) onerror (err error) {
					let message = err is CoercionError ?? (err.message, "Expected value of type \"{t.name}\", but encountered error \"{err.message}\"; found: {syntax.print(node)}.")
					out.push(InputProblem{message: message, path: path, node: node})
					recover none
				}
		}
	}

	// An enum value from a variable: its name as a string (graphql-js
	// GraphQLEnumType.coerceInputValue).
	internal def coerceEnumValue(t TypeDef, value any) !any {
		if !(value is string) {
			let shown = inspectValue(value)
			fail coercionError("Enum \"{t.name}\" cannot represent non-string value: {shown}." + enumSuggestion(t, shown))
		}
		let ev = t.enumValue(value)
		fail coercionError("Value \"{value}\" does not exist in \"{t.name}\" enum." + enumSuggestion(t, value)) when ev is none
		return ev.value
	}

	// An enum value from a literal: an enum name (graphql-js
	// GraphQLEnumType.coerceInputLiteral).
	internal def coerceEnumLiteral(t TypeDef, node Node) !any {
		let shown = syntax.print(node)
		fail coercionError("Enum \"{t.name}\" cannot represent non-enum value: {shown}." + enumSuggestion(t, shown)) unless node.kind == NodeKind.EnumValue
		let ev = t.enumValue(node.text)
		fail coercionError("Value \"{node.text}\" does not exist in \"{t.name}\" enum." + enumSuggestion(t, node.text)) when ev is none
		return ev.value
	}

	internal def enumSuggestion(t TypeDef, unknown string) string {
		return didYouMean(suggestionList(unknown, t.values.mapElem(v => v.name)), "the enum value")
	}

	// A scalar's value from a variable (spec 3.5 input coercion, graphql-js
	// coerceInputValue of the built-in scalars): Int a 32-bit integer (a
	// whole float too, as JSON may write one), Float a finite number,
	// String text, Boolean a truth value, ID text or a whole number (as
	// text); a custom scalar through its parseValue, else as given.
	internal def coerceScalarValue(t TypeDef, value any) !any {
		match t.name {
			case "Int":
				fail coercionError("Int cannot represent non-integer value: {inspectValue(value)}") unless value is int || value is float
				let n = try integerOf(value, "Int cannot represent non-integer value: {inspectValue(value)}")
				fail coercionError("Int cannot represent non 32-bit signed integer value: {inspectValue(value)}") when n < int32Min || n > int32Max
				return n
			case "Float":
				let f = numberOf(value)
				fail coercionError("Float cannot represent non numeric value: {inspectValue(value)}") when f != f || f - f != 0.0
				return f
			case "String":
				return value when value is string
				fail coercionError("String cannot represent a non string value: {inspectValue(value)}")
			case "Boolean":
				return value when value is bool
				fail coercionError("Boolean cannot represent a non boolean value: {inspectValue(value)}")
			case "ID":
				return value when value is string
				fail coercionError("ID cannot represent value: {inspectValue(value)}") unless value is int || value is float
				let n = try integerOf(value, "ID cannot represent value: {inspectValue(value)}")
				return "{n}"
			default:
				let coercion = t.coercion
				return value when coercion is none
				let parse = coercion.parseValue
				return value when parse is none
				return try parse(value)
		}
	}

	// A number as a whole number: an integer, or a float without a
	// fraction (as JSON may write a whole number); fails with problem
	// otherwise.
	internal def integerOf(value any, problem string) !int {
		return value when value is int
		if value is float {
			fail coercionError(problem) unless value == value.floor() && value.abs() < 9007199254740992.0
			return int(value)
		}
		fail coercionError(problem)
	}

	// A scalar's value from a literal (graphql-js coerceInputLiteral of the
	// built-in scalars); a custom scalar's parseValue is given the literal as
	// the JSON value it writes, variables replaced.
	internal def coerceScalarLiteral(t TypeDef, node Node, variables ?map<string, any>) !any {
		let shown = syntax.print(node)
		match t.name {
			case "Int":
				fail coercionError("Int cannot represent non-integer value: {shown}") unless node.kind == NodeKind.IntValue
				let n = parseBigInt(node.text) onerror recover bigint(0)
				fail coercionError("Int cannot represent non 32-bit signed integer value: {node.text}") when n < bigint(int32Min) || n > bigint(int32Max)
				return int(n)
			case "Float":
				fail coercionError("Float cannot represent non numeric value: {shown}") unless node.kind == NodeKind.IntValue || node.kind == NodeKind.FloatValue
				return parseFloat<float>(node.text)
			case "String":
				fail coercionError("String cannot represent a non string value: {shown}") unless node.kind == NodeKind.StringValue
				return node.text
			case "Boolean":
				fail coercionError("Boolean cannot represent a non boolean value: {shown}") unless node.kind == NodeKind.BooleanValue
				return node.text == "true"
			case "ID":
				fail coercionError("ID cannot represent a non-string and non-integer value: {shown}") unless node.kind == NodeKind.StringValue || node.kind == NodeKind.IntValue
				return node.text
			default:
				let json = literalToJSON(node, variables is none ?? (map<string, any>{}, variables))
				let coercion = t.coercion
				return json when coercion is none
				let parse = coercion.parseValue
				return json when parse is none
				return try parse(json)
		}
	}

	// The problems of a constant literal for an input type: their messages,
	// in order; empty when it fits. Validation's Values of Correct Type and
	// the schema's defaults use it.
	internal def literalProblems(schema Schema, literal Node, ref Node) string[] {
		let out InputProblem[] = []
		validateInputLiteral(schema, literal, ref, noneVariables(), [], out)
		return out.mapElem(p => p.message)
	}

	// A leaf's value as the response writes it (spec 3.5 result coercion):
	// Int and Float numbers (a numeric string or a bool converted), String
	// text, Boolean a truth value, ID text, an enum value its name, a custom
	// scalar through its serialize. Fails when the value has no such form.
	internal def serializeLeaf(t TypeDef, value any) !any {
		if t.kind == TypeKind.Enum {
			for let v in t.values {
				return v.name when sameEnumValue(v.value, value)
			}
			fail coercionError("Enum \"{t.name}\" cannot represent value: {describeValue(value)}")
		}
		match t.name {
			case "Int":
				return value ?? (1, 0) when value is bool
				let n = 0
				if value is string {
					fail coercionError("Int cannot represent non-integer value: {describeValue(value)}") unless value.isNumeric()
					n = try integerOf(parseFloat<float>(value), "Int cannot represent non-integer value: {describeValue(value)}")
				} else {
					n = try integerOf(numberOf(value), "Int cannot represent non-integer value: {describeValue(value)}")
				}
				fail coercionError("Int cannot represent non 32-bit signed integer value: {n}") when n < int32Min || n > int32Max
				return n
			case "Float":
				return value ?? (1.0, 0.0) when value is bool
				if value is string {
					fail coercionError("Float cannot represent non numeric value: {describeValue(value)}") unless value.isNumeric()
					return parseFloat<float>(value)
				}
				let f = numberOf(value)
				fail coercionError("Float cannot represent non numeric value: {describeValue(value)}") when f != f || f - f != 0.0
				return f
			case "String":
				return value when value is string
				return value ?? ("true", "false") when value is bool
				return "{value}" when value is int
				return graphqlFloatText(value) when value is float
				fail coercionError("String cannot represent value: {describeValue(value)}")
			case "Boolean":
				return value when value is bool
				return value != 0 when value is int
				return value != 0.0 when value is float
				fail coercionError("Boolean cannot represent a non boolean value: {describeValue(value)}")
			case "ID":
				return value when value is string
				return "{value}" when value is int
				fail coercionError("ID cannot represent value: {describeValue(value)}")
			default:
				let coercion = t.coercion
				return value when coercion is none
				let serialize = coercion.serialize
				return value when serialize is none
				return try serialize(value)
		}
	}

	// Whether a resolved value is the enum value a stands for: the same
	// name, or the same member of the same ADM enum (a boxed member's text
	// names only its type, so members compare by number). An ADM enum
	// member is a value of an SDL enum whose value of that name it is.
	internal def sameEnumValue(a any, b any) bool {
		return a == b when a is string && b is string
		if a is string {
			let described = reflection.descriptorOf(b)
			return false when described is none || described.kind != reflection.TypeKind.Enum
			let number = reflection.scalarText(b)
			for let m in reflection.members(described) {
				return m.node.name == a when reflection.scalarText(m.value) == number
			}
			return false
		}
		return reflection.typeName(a) == reflection.typeName(b) && reflection.scalarText(a) == reflection.scalarText(b)
	}

	// A number boxed as any, as a float; NaN for anything else.
	internal def numberOf(value any) float {
		return value when value is float
		return float(value) when value is int
		return float(value) when value is int32
		return float(value) when value is int64
		return float(value) when value is float32
		return 0.0 / 0.0
	}

	internal def graphqlFloatText(f float) string {
		return new Decimal(f).str()
	}

	internal def describeValue(value any) string {
		return inspectValue(value)
	}

	// A runtime value as graphql-js shows it in a message (its inspect):
	// strings quoted as JSON, objects `{ a: 1 }` and lists `[1, 2]` two
	// levels deep, at most ten list items.
	internal def inspectValue(value any, depth int = 0) string {
		return "null" when value is none
		return jsonQuoted(value) when value is string
		return value ?? ("true", "false") when value is bool
		return jsNumber(value) when value is float
		let items = listItems(value)
		if !(items is none) {
			return "[]" when items.len() == 0
			return "[Array]" when depth >= 2
			let shown = items[0:items.len() < 10 ?? (items.len(), 10)].mapElem(item => inspectValue(item, depth + 1))
			let rest = items.len() - shown.len()
			shown.push(rest == 1 ?? ("... 1 more item", "... {rest} more items")) when rest > 0
			return "[" + shown.join(", ") + "]"
		}
		let entries = objectEntries(value)
		if !(entries is none) {
			return "\{\}" when entries.len() == 0
			return "[Object]" when depth >= 2
			let parts string[] = []
			for let (k, v) in entries {
				parts.push(k + ": " + inspectValue(v, depth + 1))
			}
			return "\{ " + parts.join(", ") + " \}"
		}
		return "{value}"
	}

	// A number as JavaScript writes it: a whole value without a fraction.
	internal def jsNumber(f float) string {
		return "NaN" when f != f
		return f > 0.0 ?? ("Infinity", "-Infinity") when f - f != 0.0
		return "{int(f)}" when f == f.floor() && f.abs() < 1e21
		return graphqlFloatText(f)
	}

	// Text quoted as JSON.stringify quotes it.
	internal def jsonQuoted(text string) string {
		let out byte[] = [34]
		for let b in text.bytes() {
			match int(b) {
				case 34, 92:
					out += [92, b]
				case 8:
					out += "\\b".bytes()
				case 12:
					out += "\\f".bytes()
				case 10:
					out += "\\n".bytes()
				case 13:
					out += "\\r".bytes()
				case 9:
					out += "\\t".bytes()
				default:
					if b < 32 {
						out += "\\u%04x".format(int(b)).bytes()
					} else {
						out.push(b)
					}
			}
		}
		out.push(34)
		return string(out)
	}
}
