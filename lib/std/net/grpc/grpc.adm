// gRPC over HTTP/2 (https://github.com/grpc/grpc/blob/master/doc/PROTOCOL-HTTP2.md):
// unary and streaming calls, metadata, deadlines, status codes and message
// compression. Messages are Protocol Buffers by default (`Protobuf` from
// std.data.encoding); any value with the same encode/decode pair can be
// the codec.
//
//     let client = new grpc.Client("http://127.0.0.1:50051")
//     let reply = new HelloReply()
//     try client.call("/helloworld.Greeter/SayHello", request, reply)
//
//     let server = new grpc.Server()
//     server.unary("/helloworld.Greeter/SayHello", (call grpc.ServerCall) => { … })
//     mux.handle("/", server)   // served by std.net.http over HTTP/2
partial module std.net.grpc {
	use (
		std.io
		std.time
		std.errors
		std.data.encoding::(Base64)
		std.net.http.http2::(HeaderField)
		std.net.grpc.wire::*
	)

	// The status codes of a finished call (https://grpc.github.io/grpc/core/md_doc_statuscodes.html).
	enum Code {
		OK = 0,
		Cancelled = 1,
		Unknown = 2,
		InvalidArgument = 3,
		DeadlineExceeded = 4,
		NotFound = 5,
		AlreadyExists = 6,
		PermissionDenied = 7,
		ResourceExhausted = 8,
		FailedPrecondition = 9,
		Aborted = 10,
		OutOfRange = 11,
		Unimplemented = 12,
		Internal = 13,
		Unavailable = 14,
		DataLoss = 15,
		Unauthenticated = 16
	}

	// The error a call fails with: the status the server ended it with, or
	// one the client derived (Unavailable for a connection that failed,
	// DeadlineExceeded for a timeout). A server handler fails with one to
	// end its call with that status.
	//
	//     fail grpc.errorOf(grpc.Code.NotFound, "no user {id}")
	struct Status {
		message string
		code    string
		cause   ?error
		stack   errors.StackTrace
		kind    Code
		// `grpc-status-details-bin`: a serialized google.rpc.Status, empty
		// when the server sent none.
		details byte[]
		// The trailing metadata of the call.
		trailer Metadata
	}

	// A Status with the code and message, for a handler to fail with.
	def errorOf(code Code, message string, details byte[] = []) Status {
		return Status{message: message, code: code.name, kind: code, details: details, trailer: new Metadata()}
	}

	// The Code of a status number; Unknown for a number outside 0 to 16.
	def codeOf(number int) Code {
		return codeAt(number)
	}

	// How messages are compressed (`grpc-encoding`).
	enum Compression {
		Identity,
		Gzip,
		// zlib-wrapped deflate (RFC 1950), as gRPC names it.
		Deflate
	}

	// Encodes and decodes messages; `Protobuf` and `JSON` from
	// std.data.encoding both fit.
	interface Codec {
		def encode(obj any) byte[]
		def decode(input byte[], target any) !none
	}

	// Call metadata: lowercase keys, each with one or more values. Keys
	// ending in `-bin` carry bytes (base64 on the wire); the others carry
	// printable ASCII.
	type Metadata {
		internal keys   string[]
		internal values string[]

		// Every key, in the order first added.
		def names() string[] {
			let out string[] = []
			for let k in keys {
				out.push(k) when out.indexOf(k) < 0
			}
			return out
		}

		// The first value under key; "" when absent. For a `-bin` key this
		// is the base64 wire form; binary returns the bytes.
		def get(key string) string {
			let i = keys.indexOf(key.lower())
			return i < 0 ?? ("", values[i])
		}

		// Every value under key, in order.
		def getAll(key string) string[] {
			let k = key.lower()
			let out string[] = []
			for let (i, have) in keys {
				out.push(values[i]) when have == k
			}
			return out
		}

		// The bytes of the first value under a `-bin` key; empty when absent.
		// Fails when the key does not end in `-bin` or the value is not
		// base64.
		def binary(key string) !byte[] {
			expects {
				assert key.lower().endsWith("-bin") onerror fail "grpc: metadata key {key} is not binary (-bin)"
			}
			let text = get(key)
			return [] when text == ""
			return try decodeBase64(text)
		}

		// Reports whether key has a value.
		def has(key string) bool {
			return keys.indexOf(key.lower()) >= 0
		}

		// Adds a value under key. Fails when the key has characters other
		// than a-z, 0-9, `-`, `_` and `.`, starts with `grpc-` (reserved),
		// is a `-bin` key, or the value has characters outside printable
		// ASCII.
		def add(key string, value string) !none {
			let k = key.lower()
			try checkKey(k)
			fail "grpc: metadata key {k} is binary; use addBinary" when k.endsWith("-bin")
			fail "grpc: metadata value of {k} has characters outside printable ASCII" unless isPrintable(value)
			keys.push(k)
			values.push(value)
			return none
		}

		// Adds bytes under a key ending in `-bin`. Fails when the key is not
		// a valid `-bin` key.
		def addBinary(key string, value byte[]) !none {
			let k = key.lower()
			try checkKey(k)
			fail "grpc: metadata key {k} does not end in -bin" unless k.endsWith("-bin")
			let b = new Base64()
			b.padded = false
			keys.push(k)
			values.push(b.encode(value))
			return none
		}

		// Replaces every value under key with one. Fails as add does.
		def set(key string, value string) !none {
			delete(key)
			return try add(key, value)
		}

		// Removes every value under key.
		def delete(key string) {
			let k = key.lower()
			let ks string[] = []
			let vs string[] = []
			for let (i, have) in keys {
				continue when have == k
				ks.push(have)
				vs.push(values[i])
			}
			keys = ks
			values = vs
		}

		// The number of values.
		def len() int {
			return keys.len()
		}
	}

	// Takes the metadata among HTTP/2 header fields: everything but
	// pseudo-headers and the fields gRPC and HTTP/2 reserve.
	internal def metadataOf(fields HeaderField[]) Metadata {
		let md = new Metadata()
		for let f in fields {
			let name = f.name.lower()
			continue when name.startsWith(":") || name.startsWith("grpc-") || reservedHeader(name)
			md.keys.push(name)
			md.values.push(f.value)
		}
		return md
	}

	// The header fields of metadata.
	internal def fieldsOf(md Metadata) HeaderField[] {
		let out HeaderField[] = []
		for let (i, k) in md.keys {
			out.push(HeaderField{name: k, value: md.values[i]})
		}
		return out
	}

	// Writes one length-prefixed message: the compressed flag, the length as
	// four big-endian bytes, the bytes.
	internal def writeMessage(w io.Writer, data byte[], compression Compression) !none {
		let payload = data
		let flag = 0
		if compression != Compression.Identity {
			payload = try compress(data, compression)
			flag = 1
		}
		let head byte[] = [byte(flag), byte(payload.len() >> 24), byte((payload.len() >> 16) & 0xFF), byte((payload.len() >> 8) & 0xFF), byte(payload.len() & 0xFF)]
		try w.write(head + payload)
		return none
	}

	// Reads one length-prefixed message; none at a clean end of the stream.
	// Fails with a Status: ResourceExhausted past maxSize, Internal for a
	// truncated message or a compressed one without an encoding.
	internal def readMessage(r io.Reader, encoding Compression, maxSize int) !?byte[] {
		let head = try readFully(r, 5)
		return none when head.len() == 0
		fail errorOf(Code.Internal, "grpc: stream ends inside a message prefix") when head.len() < 5
		let flag = int(head[0])
		let n = (int(head[1]) << 24) | (int(head[2]) << 16) | (int(head[3]) << 8) | int(head[4])
		fail errorOf(Code.Internal, "grpc: message prefix has flag {flag}") when flag > 1
		fail errorOf(Code.ResourceExhausted, "grpc: received message larger than max ({n} vs. {maxSize})") when n > maxSize
		let body = try readFully(r, n)
		fail errorOf(Code.Internal, "grpc: stream ends inside a message") when body.len() < n
		return body when flag == 0
		fail errorOf(Code.Internal, "grpc: compressed message without grpc-encoding") when encoding == Compression.Identity
		let plain = decompress(body, encoding) onerror (err error) {
			fail errorOf(Code.Internal, "grpc: cannot decompress message: {err.message}")
		}
		fail errorOf(Code.ResourceExhausted, "grpc: received message larger than max ({plain.len()} vs. {maxSize}) after decompression") when plain.len() > maxSize
		return plain
	}
}

internal partial module std.net.grpc.wire {
	use (
		std.io
		std.time
		std.bytes::(Buffer)
		std.data.encoding::(Base64)
		std.data.compress.gzip
		std.data.compress.zlib
		std.net.grpc::*
	)

	def codeAt(i int) Code {
		match i {
			case 0:
				return Code.OK
			case 1:
				return Code.Cancelled
			case 3:
				return Code.InvalidArgument
			case 4:
				return Code.DeadlineExceeded
			case 5:
				return Code.NotFound
			case 6:
				return Code.AlreadyExists
			case 7:
				return Code.PermissionDenied
			case 8:
				return Code.ResourceExhausted
			case 9:
				return Code.FailedPrecondition
			case 10:
				return Code.Aborted
			case 11:
				return Code.OutOfRange
			case 12:
				return Code.Unimplemented
			case 13:
				return Code.Internal
			case 14:
				return Code.Unavailable
			case 15:
				return Code.DataLoss
			case 16:
				return Code.Unauthenticated
			default:
				return Code.Unknown
		}
	}

	def checkKey(k string) !none {
		expects {
			assert k != "" onerror fail "grpc: empty metadata key"
			assert !(k.startsWith("grpc-")) onerror fail "grpc: metadata key {k} is reserved (grpc-)"
		}
		for let c in k {
			fail "grpc: metadata key {k} has a character outside a-z 0-9 - _ ." unless (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-' || c == '_' || c == '.'
		}
		return none
	}

	def isPrintable(v string) bool {
		for let b in v.bytes() {
			return false when b < byte(0x20) || b > byte(0x7E)
		}
		return true
	}

	// Headers HTTP/2 or gRPC own, which are never metadata.
	def reservedHeader(name string) bool {
		return name := "content-type" || "te" || "user-agent" || "content-length" || "connection" || "host" || "accept-encoding"
	}

	// Decodes base64 with or without padding, standard or URL alphabet.
	def decodeBase64(text string) !byte[] {
		let t = text.replace("-", "+").replace("_", "/")
		for t.len() % 4 != 0 {
			t += "="
		}
		return try new Base64().decode(t)
	}

	// Reads n bytes, fewer only when the stream ends.
	def readFully(r io.Reader, n int) !byte[] {
		let out byte[]
		out.len(n)
		let got = 0
		for got < n {
			let part = out.slice(got, n - got)
			let k = try r.read(part)
			break when k <= 0
			for let i = 0; i < k; i++ {
				out[got + i] = part[i]
			}
			got += k
		}
		out.len(got)
		return out
	}

	def compress(data byte[], c Compression) !byte[] {
		let buf = new Buffer()
		if c == Compression.Gzip {
			let w = new gzip.Writer(buf)
			try w.write(data)
			try w.close()
		} else {
			let w = new zlib.Writer(buf)
			try w.write(data)
			try w.close()
		}
		return buf.bytes()
	}

	def decompress(data byte[], c Compression) !byte[] {
		return try zlib.decompress(data) when c == Compression.Deflate
		let r = new gzip.Reader(new Buffer(data))
		return try io.readAll(r)
	}

	// The `grpc-encoding` name of a compression.
	def encodingName(c Compression) string {
		match c {
			case Compression.Gzip:
				return "gzip"
			case Compression.Deflate:
				return "deflate"
			default:
				return "identity"
		}
	}

	// The compression a `grpc-encoding` value names; none for one this side
	// does not support.
	def compressionOf(name string) ?Compression {
		match name.trim().lower() {
			case "", "identity":
				return Compression.Identity
			case "gzip":
				return Compression.Gzip
			case "deflate":
				return Compression.Deflate
			default:
				return none
		}
	}

	// The `grpc-timeout` value of a duration: at most eight digits, in the
	// finest unit that holds it, rounded up.
	def timeoutText(d duration) string {
		let ns = int(d)
		ns = 1 when ns < 1
		let units = [(1, "n"), (1000, "u"), (1000000, "m"), (1000000000, "S"), (60000000000, "M"), (3600000000000, "H")]
		for let (_, u) in units {
			let (size, name) = u
			let v = (ns + size - 1) / size
			return "{v}{name}" when v <= 99999999
		}
		return "99999999H"
	}

	// The duration of a `grpc-timeout` value; none when malformed.
	def timeoutOf(text string) ?duration {
		return none when text.len() < 2 || text.len() > 9
		let digits = text.slice(0, text.len() - 1)
		for let c in digits {
			return none when c < '0' || c > '9'
		}
		let v = parseInt<int>(digits)
		match text.slice(text.len() - 1) {
			case "n":
				return duration(v)
			case "u":
				return duration(v * 1000)
			case "m":
				return duration(v * 1000000)
			case "S":
				return duration(v * 1000000000)
			case "M":
				return duration(v * 60000000000)
			case "H":
				return duration(v * 3600000000000)
			default:
				return none
		}
	}

	// Percent-encodes a status message (`grpc-message`): bytes outside
	// printable ASCII and `%` become %XX.
	def encodeMessage(text string) string {
		let out = ""
		for let b in text.bytes() {
			if b < byte(0x20) || b > byte(0x7E) || b == byte(0x25) {
				out += "%" + [b].hex().upper()
			} else {
				out += string([b])
			}
		}
		return out
	}

	// Decodes a `grpc-message`; a malformed escape is kept as it is.
	def decodeMessage(text string) string {
		let b = text.bytes()
		let out byte[]
		let i = 0
		for i < b.len() {
			if b[i] == byte(0x25) && i + 2 < b.len() + 0 && isHex(b[i + 1]) && isHex(b[i + 2]) {
				out.push(byte((hexValue(b[i + 1]) << 4) | hexValue(b[i + 2])))
				i += 3
				continue
			}
			out.push(b[i])
			i++
		}
		return string(out)
	}

	def isHex(b byte) bool {
		return (b >= byte(0x30) && b <= byte(0x39)) || (b >= byte(0x41) && b <= byte(0x46)) || (b >= byte(0x61) && b <= byte(0x66))
	}

	def hexValue(b byte) int {
		return int(b) - 0x30 when b <= byte(0x39)
		return int(b) - 0x41 + 10 when b <= byte(0x46)
		return int(b) - 0x61 + 10
	}

	// The status of an HTTP response that is not a gRPC one
	// (doc/http-grpc-status-mapping.md).
	def codeOfHTTP(status int) Code {
		match status {
			case 400:
				return Code.Internal
			case 401:
				return Code.Unauthenticated
			case 403:
				return Code.PermissionDenied
			case 404:
				return Code.Unimplemented
			case 429, 502, 503, 504:
				return Code.Unavailable
			default:
				return Code.Unknown
		}
	}
}
