partial module std.net.grpc {
	use (
		std.testing
		std.time
		std.bytes::(Buffer)
		std.net.http
		std.net.http.httptest
		std.data.encoding::(protoField)
		std.net.grpc.wire::*
	)

	struct GrpcMsg {
		@protoField(1)
		text string

		@protoField(2)
		n int32
	}

	def grpcMsg(text string, n int) GrpcMsg {
		let m = new GrpcMsg()
		m.text = text
		m.n = int32(n)
		return m
	}

	// The status code a failure carries; OK when it is not a Status.
	def grpcCode(err error) Code {
		return err.kind when err is Status
		return Code.OK
	}

	def grpcEchoServer() Server {
		let rpc = new Server()
		rpc.unary("/t.Echo/Unary", def (call ServerCall) !any {
			let m = new GrpcMsg()
			try call.receive(m)
			try call.header.add("x-initial", "hi")
			try call.trailer.add("x-trail", call.metadata.get("x-key"))
			m.text = m.text + "!"
			m.n = m.n + int32(1)
			return m
		})
		rpc.stream("/t.Echo/Bidi", def (call ServerCall) !none {
			for {
				let m = new GrpcMsg()
				break unless try call.receive(m)
				m.text = m.text.upper()
				try call.send(m)
			}
			return none
		})
		rpc.unary("/t.Echo/Fail", def (call ServerCall) !any {
			try call.trailer.addBinary("x-raw-bin", [byte(0), byte(0xFF)])
			fail errorOf(Code.FailedPrecondition, "not now: 100% ü", details = [byte(1), byte(2)])
		})
		rpc.unary("/t.Echo/Slow", def (call ServerCall) !any {
			for !call.expired() {
				time.sleep(5ms)
			}
			return new GrpcMsg()
		})
		rpc.stream("/t.Echo/Headers", def (call ServerCall) !none {
			try call.header.add("x-early", "yes")
			try call.sendHeader()
			let m = new GrpcMsg()
			for try call.receive(m) {
			}
			return none
		})
		rpc.unary("/t.Echo/Crash", def (call ServerCall) !any {
			fail "plain failure"
		})
		return rpc
	}

	// One pass of the loopback calls with a compression.
	def grpcRound(url string, comp Compression) !none {
		let c = new Client(url)
		let md = new Metadata()
		try md.add("x-key", "v")
		let s = try c.stream("/t.Echo/Unary", CallOptions{metadata: md, compression: comp})
		try s.send(grpcMsg("hi", 1))
		try s.closeSend()
		let out = new GrpcMsg()
		assert try s.receive(out)
		assert out.text == "hi!" && out.n == int32(2)
		assert !(try s.receive(new GrpcMsg()))
		assert (try s.header()).get("x-initial") == "hi"
		assert s.trailer().get("x-trail") == "v"

		let b = try c.stream("/t.Echo/Bidi", CallOptions{compression: comp})
		for let w in ["a", "b", "c"] {
			try b.send(grpcMsg(w, 0))
			let r = new GrpcMsg()
			assert try b.receive(r)
			assert r.text == w.upper()
		}
		try b.closeSend()
		assert !(try b.receive(new GrpcMsg()))

		let failed = Code.OK
		let details = ""
		let raw = ""
		let message = ""
		c.call("/t.Echo/Fail", grpcMsg("", 0), new GrpcMsg()) onerror (err error) {
			if err is Status {
				failed = err.kind
				message = err.message
				details = err.details.hex()
				raw = (err.trailer.binary("x-raw-bin") onerror recover byte[]).hex().lower()
			}
			recover none
		}
		assert failed == Code.FailedPrecondition && message == "not now: 100% ü" && details == "0102" && raw == "00ff"

		let slow = Code.OK
		c.call("/t.Echo/Slow", grpcMsg("", 0), new GrpcMsg(), CallOptions{timeout: 50ms}) onerror (err error) {
			slow = grpcCode(err)
			recover none
		}
		assert slow == Code.DeadlineExceeded

		let crash = Code.OK
		c.call("/t.Echo/Crash", grpcMsg("", 0), new GrpcMsg()) onerror (err error) {
			crash = grpcCode(err)
			recover none
		}
		assert crash == Code.Unknown

		let missing = Code.OK
		c.call("/t.Echo/Nope", grpcMsg("", 0), new GrpcMsg()) onerror (err error) {
			missing = grpcCode(err)
			recover none
		}
		assert missing == Code.Unimplemented
		try c.close()
		return none
	}

	check "gRPC" {
		@test()
		def TestMetadata() !none {
			let md = new Metadata()
			try md.add("X-Key", "one")
			try md.add("x-key", "two")
			try md.addBinary("x-blob-bin", [byte(0), byte(0xFB), byte(0xFF)])
			assert md.get("x-key") == "one" && md.getAll("X-KEY").len() == 2
			assert md.get("x-blob-bin") == "APv/"
			assert (try md.binary("x-blob-bin")).hex().lower() == "00fbff"
			assert md.names().len() == 2 && md.len() == 3 && md.has("x-blob-bin")
			try md.set("x-key", "three")
			assert md.getAll("x-key").len() == 1 && md.get("x-key") == "three"
			md.delete("x-key")
			assert !md.has("x-key")
			let refused = 0
			md.add("grpc-status", "0") onerror (err error) {
				refused++
				recover none
			}
			md.add("bad key", "v") onerror (err error) {
				refused++
				recover none
			}
			md.add("x-bin-bin", "v") onerror (err error) {
				refused++
				recover none
			}
			md.add("x-ok", "tab\there") onerror (err error) {
				refused++
				recover none
			}
			md.addBinary("x-text", [byte(1)]) onerror (err error) {
				refused++
				recover none
			}
			assert refused == 5
			// Padded and URL-alphabet base64 are accepted on receipt.
			assert (try decodeBase64("APv_")).hex().lower() == "00fbff"
			assert (try decodeBase64("AA==")).hex() == "00"
			return none
		}

		@test()
		def TestTimeouts() !none {
			assert timeoutText(1s) == "1000000u"
			assert timeoutText(200ms) == "200000u"
			assert timeoutText(5ns) == "5n"
			assert timeoutText(90000s) == "90000000m"
			assert timeoutText(1000000s) == "1000000S"
			assert timeoutText(1000000000s) == "16666667M"
			let back = timeoutOf("1000000u")
			assert !(back is none) && back == 1s
			let h = timeoutOf("2H")
			assert !(h is none) && h == 7200s
			assert timeoutOf("") is none && timeoutOf("5") is none && timeoutOf("5x") is none && timeoutOf("123456789S") is none && timeoutOf("-5S") is none
			return none
		}

		@test()
		def TestFraming() !none {
			for let c in [Compression.Identity, Compression.Gzip, Compression.Deflate] {
				let buf = new Buffer()
				let payload = "hello gRPC ".repeat(50).bytes()
				try writeMessage(buf, payload, c)
				try writeMessage(buf, [], c)
				let all = buf.bytes()
				assert all[0] == byte(c == Compression.Identity ?? (0, 1))
				let r = new Buffer(all)
				let first = try readMessage(r, c, 4096)
				assert !(first is none) && first.equals(payload)
				let second = try readMessage(r, c, 4096)
				assert !(second is none) && second.len() == 0
				assert (try readMessage(r, c, 4096)) is none
			}
			let big = new Buffer()
			try writeMessage(big, "x".repeat(100).bytes(), Compression.Identity)
			let tooBig = Code.OK
			readMessage(new Buffer(big.bytes()), Compression.Identity, 10) onerror (err error) {
				tooBig = grpcCode(err)
				recover none
			}
			assert tooBig == Code.ResourceExhausted
			let cut = Code.OK
			readMessage(new Buffer([byte(0), byte(0), byte(0), byte(0), byte(5), byte(1)]), Compression.Identity, 10) onerror (err error) {
				cut = grpcCode(err)
				recover none
			}
			assert cut == Code.Internal
			let flagged = Code.OK
			readMessage(new Buffer([byte(1), byte(0), byte(0), byte(0), byte(0)]), Compression.Identity, 10) onerror (err error) {
				flagged = grpcCode(err)
				recover none
			}
			assert flagged == Code.Internal
			return none
		}

		@test()
		def TestStatusMessages() !none {
			assert encodeMessage("a%b ü") == "a%25b %C3%BC"
			assert decodeMessage("a%25b %C3%BC") == "a%b ü"
			assert decodeMessage("50%") == "50%" && decodeMessage("%zz") == "%zz"
			assert codeOf(5) == Code.NotFound && codeOf(16) == Code.Unauthenticated && codeOf(17) == Code.Unknown && codeOf(-1) == Code.Unknown
			assert codeOfHTTP(404) == Code.Unimplemented && codeOfHTTP(503) == Code.Unavailable && codeOfHTTP(500) == Code.Unknown
			return none
		}

		@test()
		def TestLoopback() !none {
			let ts = try httptest.Server.start(grpcEchoServer())
			try grpcRound(ts.url, Compression.Identity)
			try grpcRound(ts.url, Compression.Gzip)
			let h = try new Client(ts.url).stream("/t.Echo/Headers")
			assert (try h.header()).get("x-early") == "yes"
			h.cancel()
			let afterCancel = Code.OK
			h.receive(new GrpcMsg()) onerror (err error) {
				afterCancel = grpcCode(err)
				recover false
			}
			assert afterCancel == Code.Cancelled
			let recorder = new httptest.ResponseRecorder()
			let get = try httptest.newRequest(http.Method.GET, "/t.Echo/Unary")
			try grpcEchoServer().serve(recorder.context(get))
			assert recorder.result().status == 405
			let gone = Code.OK
			new Client("http://127.0.0.1:1").call("/t.Echo/Unary", grpcMsg("", 0), new GrpcMsg()) onerror (err error) {
				gone = grpcCode(err)
				recover none
			}
			assert gone == Code.Unavailable
			try ts.close()
			return none
		}
	}
}
