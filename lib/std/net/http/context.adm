partial module std.net.http {
	use (
		std.formats
		std.io
		std.net
		std.net.multipart
		std.net.url::(URL)
		std.time
	)

	// Session is what the http module knows about a signed-in visitor's
	// session: its identifier. An application keeps its own session type
	// (user, roles, expiry, a store behind it) and sets it on the context
	// from an authentication middleware.
	interface Session {
		def id() string
	}

	// Context is what a handler receives: the request, the response
	// writer, the matched route, and the state middleware leaves for the
	// handler. Its helpers cover the common cases so a handler reads as
	// one line per step; `request` and `response` stay reachable for the
	// rest.
	//
	//     mux.get("/users/{id}", def (ctx Context) !none {
	//         let user = try users.find(ctx.param("id"))
	//         return ctx.json(user)
	//     })
	//
	// One context lives for one request, on the task that serves it. A
	// handler that spawns work must not hand the context to it past its
	// own return.
	type Context {
		request       Request
		response      ResponseWriter
		// The pattern that matched, "GET /users/{id}"; "" outside a mux.
		route         string           = ""
		// State middleware sets for later middleware and the handler, and
		// the handler for the middleware that runs after it: a tenant, a
		// locale, a parsed token. `set`, `get`, `has`.
		values        map<string, any>
		// Set by an authentication middleware once it accepted the
		// credentials; `requireAuth` checks it.
		authenticated bool             = false
		// The principal the authentication resolved: the application's
		// own user type. None until then.
		user          ?any             = none
		session       ?Session         = none

		// The server serving the request; none for a recorder's context.
		server ?Server = none

		def new(request Request, response ResponseWriter) {
			self.request = request
			self.response = response
			self.values = {}
		}

		// Request side.

		def method() Method {
			return request.method
		}

		def path() string {
			return request.path()
		}

		def url() URL {
			return request.url
		}

		// A route parameter, "" when the route has none by that name.
		def param(name string) string {
			return request.param(name)
		}

		def param(name string, fallback string) string {
			return request.param(name, fallback)
		}

		// A query parameter, none when absent.
		def query(name string) ?string {
			return request.query(name)
		}

		def query(name string, fallback string) string {
			return request.query(name, fallback)
		}

		def queries(name string) string[] {
			return request.queries(name)
		}

		// A request header, "" when absent.
		def header(name string) string {
			return request.header(name)
		}

		def cookie(name string) ?Cookie {
			return request.cookie(name)
		}

		def contentType() !?formats.MediaType {
			return request.contentType()
		}

		// The remote client, through a trusted proxy when the server's
		// `realIP` middleware ran.
		def clientAddr() string {
			return request.clientAddr()
		}

		// Body access, each reading it once and keeping it; fail as the
		// `Request` methods do.
		def bytes() !byte[] {
			return request.bytes()
		}

		def text() !string {
			return request.text()
		}

		def json(target any) !none {
			return request.json(target)
		}

		// Binds the body (JSON or form, by content type), the query and
		// the route parameters into target's fields, in that order of
		// precedence. Fails as `Request.bind` does.
		def bind(target any) !none {
			return request.bind(target)
		}

		def formValue(name string) string {
			return request.formValue(name)
		}

		def formFile(name string) !multipart.FileHeader {
			return request.formFile(name)
		}

		// Response side. Each commits the response; call one per request.
		// They fail when the connection write does, and with HttpError
		// (op "response") when the response was already committed.

		// Sets a response header before the response commits.
		def setHeader(name string, value string) {
			response.headers.set(name, value)
		}

		def addHeader(name string, value string) {
			response.headers.add(name, value)
		}

		def setCookie(c Cookie) !none {
			return response.cookie(c)
		}

		def deleteCookie(name string, path string = "/", domain string = "") {
			response.deleteCookie(name, path, domain)
		}

		def text(status int, text string) !none {
			return response.text(status, text)
		}

		def text(text string) !none {
			return response.text(text)
		}

		def html(status int, text string) !none {
			return response.html(status, text)
		}

		def html(text string) !none {
			return response.html(text)
		}

		def json(status int, value any, indent bool = false) !none {
			return response.json(status, value, indent)
		}

		def json(value any, indent bool = false) !none {
			return response.json(value, indent)
		}

		def blob(status int, contentType string, data byte[]) !none {
			return response.blob(status, contentType, data)
		}

		def stream(status int, contentType string, r io.Reader) !none {
			return response.stream(status, contentType, r)
		}

		// Sends the file at `path` with content type, conditionals and
		// ranges from the request (`serveFile`).
		def file(path string) !none {
			return serveFile(self, path)
		}

		def attachment(path string, name string = "") !none {
			return response.attachment(path, name)
		}

		def redirect(target string, status int = 302) !none {
			return response.redirect(target, status)
		}

		def noContent(status int = 204) !none {
			return response.noContent(status)
		}

		def notFound() !none {
			return response.notFound()
		}

		// Sends the status with `message` as `text/plain` (or the reason
		// phrase when empty). For a JSON API, `abort` and an error
		// middleware that renders instead.
		def error(status int, message string = "") !none {
			return response.error(status, message)
		}

		// Fails the handler with an HttpError carrying `status`: the
		// server (or `recoverer`) answers with that status and message,
		// and an error-rendering middleware can turn it into JSON.
		//
		//     fail ctx.abort(404, "no such user") when user is none
		def abort(status int, message string = "") HttpError {
			return HttpError{message: message, op: "handler", status: status}
		}

		// Server-sent event, after `stream(200, "text/event-stream", …)`
		// is not needed: the first `event` commits the response as an
		// event stream.
		def event(data string, name string = "", id string = "") !none {
			return response.event(data, name, id)
		}

		// Flushes what the response buffered so far to the client.
		def flush() !none {
			return response.flush()
		}

		// True once the response committed its status and headers.
		def committed() bool {
			return response.written()
		}

		// Takes the connection over for an upgrade (WebSocket); see
		// `ResponseWriter.hijack`.
		def hijack() !(net.Stream, io.Reader) {
			return response.hijack()
		}

		// Registers fn to run once the response is finished.
		def onFinish(fn def ()) {
			response.onFinish(fn)
		}

		// State.

		def set(key string, value any) {
			values[key] = value
		}

		// The value under key, none when unset.
		def get(key string) ?any {
			return values.get(key)
		}

		def has(key string) bool {
			return values.hasKey(key)
		}

		// True when the client went away or the deadline passed; a long
		// handler polls it between steps.
		def cancelled() bool {
			return request.cancelled()
		}

		def deadline() ?time.Time {
			return request.deadline
		}
	}
}
