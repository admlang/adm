partial module std.net.http {
	use (
		std.net.url::(URL)
		std.time
	)

	// SameSite is the `SameSite` attribute of a cookie. `Default` leaves the
	// attribute out; browsers then treat the cookie as `Lax`.
	enum SameSite {
		Default,
		Lax,
		Strict,
		None,
	}

	// Cookie is one HTTP cookie as sent in a `Cookie` request header or a
	// `Set-Cookie` response header. Only `name` and `value` travel in a
	// request; the attributes describe a `Set-Cookie`.
	//
	// Example:
	// ```example
	// let c = new http.Cookie("session", "abc123")
	// c.path = "/"
	// c.maxAge = 3600
	// c.secure = true
	// c.httpOnly = true
	// c.sameSite = http.SameSite.Strict
	// println(c.str())  // session=abc123; Path=/; Max-Age=3600; HttpOnly; Secure; SameSite=Strict
	// ```
	type Cookie {
		name        string
		value       string
		// Attributes of a `Set-Cookie`; empty or zero when unset.
		path        string     = ""
		domain      string     = ""
		// Absolute expiry; none when the cookie has none (a session cookie)
		// or `maxAge` is used.
		expires     ?time.Time = none
		// The `Expires` text as received, kept when it did not parse.
		rawExpires  string     = ""
		// Lifetime in seconds: 0 leaves the attribute out, a negative value
		// writes `Max-Age=0` (delete now).
		maxAge      int        = 0
		secure      bool       = false
		httpOnly    bool       = false
		sameSite    SameSite   = SameSite.Default
		partitioned bool       = false
		// The `Set-Cookie` line as received, when the cookie was parsed.
		raw         string     = ""
		// Attributes the parser did not recognise, as `name=value` text.
		unparsed    string[]   = []

		def new(name string, value string) {
			self.name = name
			self.value = value
		}

		// str renders the `Set-Cookie` form: `name=value` then the attributes
		// that are set, in the order browsers expect. The value is quoted
		// when it holds a space or comma. A cookie whose name is not a
		// valid token renders as "".
		def str() string {
			return "" unless validCookieName(name)
			let out = name + "=" + quoteCookieValue(sanitizeCookieValue(value))
			out += "; Path=" + sanitizeCookiePath(path) when path != ""
			if domain != "" {
				let d = domain.startsWith(".") ?? (domain[1:], domain)
				out += "; Domain=" + d when validCookieDomain(d)
			}
			let at = expires
			if at is none {} else {
				out += "; Expires=" + time.formatHTTPDate(at) when at.year() >= 1601
			}
			out += "; Max-Age=0" when maxAge < 0
			out += "; Max-Age={maxAge}" when maxAge > 0
			out += "; HttpOnly" when httpOnly
			out += "; Secure" when secure
			out += "; SameSite=Lax" when sameSite == SameSite.Lax
			out += "; SameSite=Strict" when sameSite == SameSite.Strict
			out += "; SameSite=None" when sameSite == SameSite.None
			out += "; Partitioned" when partitioned
			return out
		}

		// valid checks the cookie can go on the wire: a token name, a value
		// without control characters, semicolons or backslashes, a domain
		// and path that are well formed. Fails with HttpError (op "cookie")
		// naming the first problem.
		def valid() !none {
			fail HttpError{message: "invalid cookie name: {name}", op: "cookie", text: name} unless validCookieName(name)
			for let i = 0; i < value.len(); i++ {
				fail HttpError{message: "invalid byte in cookie value of {name}", op: "cookie", text: value} unless validCookieValueChar(value[i])
			}
			for let i = 0; i < path.len(); i++ {
				let c = path[i]
				fail HttpError{message: "invalid byte in cookie path of {name}", op: "cookie", text: path} when c < ' ' || int(c) == 127 || c == ';'
			}
			if domain != "" {
				let d = domain.startsWith(".") ?? (domain[1:], domain)
				fail HttpError{message: "invalid cookie domain: {domain}", op: "cookie", text: domain} unless validCookieDomain(d)
			}
			return none
		}

		// isExpired reports a cookie whose `expires` is in the past or whose
		// `maxAge` is negative, relative to `now`.
		def isExpired(now time.Time) bool {
			return true when maxAge < 0
			let at = expires
			return false when at is none
			return !at.after(now)
		}
	}

	// parseCookieHeader reads a `Cookie` request header: `a=1; b=2` pairs,
	// quoted values unquoted, pairs with an invalid name or value skipped.
	// With `filter` set only that cookie is returned.
	//
	// Example:
	// ```example
	// let cookies = http.parseCookieHeader("session=abc; theme=\"dark\"")
	// println(cookies[1].name, cookies[1].value)  // theme dark
	// ```
	def parseCookieHeader(text string, filter string = "") Cookie[] {
		let out Cookie[] = []
		for let piece in text.split(";") {
			let pair = piece.trim()
			continue when pair == ""
			let eq = pair.indexOf("=")
			let name = eq < 0 ?? (pair, pair[:eq])
			let value = eq < 0 ?? ("", pair[eq + 1:])
			continue unless validCookieName(name)
			continue when filter != "" && name != filter
			let unquoted = unquoteCookieValue(value)
			continue when unquoted is none
			out.push(new Cookie(name, unquoted))
		}
		return out
	}

	// parseSetCookie reads one `Set-Cookie` line into a Cookie with its
	// attributes (`Expires`, `Max-Age`, `Domain`, `Path`, `Secure`,
	// `HttpOnly`, `SameSite`, `Partitioned`); unknown attributes go to
	// `unparsed`. Fails with HttpError (op "cookie") on an empty or invalid
	// name or a value that cannot be a cookie value.
	//
	// Example:
	// ```example
	// let c = try http.parseSetCookie("id=a3f; Path=/; Expires=Wed, 21 Oct 2026 07:28:00 GMT; HttpOnly")
	// println(c.path, c.httpOnly)  // / true
	// ```
	def parseSetCookie(line string) !Cookie {
		let parts = line.split(";")
		let first = parts[0].trim()
		let eq = first.indexOf("=")
		fail HttpError{message: "Set-Cookie has no name=value pair", op: "cookie", text: line} when eq <= 0
		let name = first[:eq].trim()
		fail HttpError{message: "invalid cookie name: {name}", op: "cookie", text: line} unless validCookieName(name)
		let value = unquoteCookieValue(first[eq + 1:].trim())
		fail HttpError{message: "invalid cookie value for {name}", op: "cookie", text: line} when value is none
		let cookie = new Cookie(name, value)
		cookie.raw = line
		for let i = 1; i < parts.len(); i++ {
			let attr = parts[i].trim()
			continue when attr == ""
			let split = attr.indexOf("=")
			let key = (split < 0 ?? (attr, attr[:split])).trim().lower()
			let val = (split < 0 ?? ("", attr[split + 1:])).trim()
			if key == "secure" {
				cookie.secure = true
			} else if key == "httponly" {
				cookie.httpOnly = true
			} else if key == "partitioned" {
				cookie.partitioned = true
			} else if key == "samesite" {
				let mode = val.lower()
				cookie.sameSite = SameSite.Default
				cookie.sameSite = SameSite.Lax when mode == "lax"
				cookie.sameSite = SameSite.Strict when mode == "strict"
				cookie.sameSite = SameSite.None when mode == "none"
			} else if key == "domain" {
				cookie.domain = val.startsWith(".") ?? (val[1:], val)
			} else if key == "path" {
				cookie.path = val
			} else if key == "max-age" {
				let digits = val.startsWith("-") ?? (val[1:], val)
				if digits != "" && digits.isNumeric() {
					let seconds = digits.toInt<int>()
					cookie.maxAge = val.startsWith("-") || seconds == 0 ?? (-1, seconds)
				} else {
					cookie.unparsed.push(attr)
				}
			} else if key == "expires" {
				cookie.rawExpires = val
				cookie.expires = parseExpires(val)
			} else {
				cookie.unparsed.push(attr)
			}
		}
		return cookie
	}

	// readCookies reads every `Cookie` header of a request header block,
	// with `filter` narrowing to one name.
	def readCookies(headers Header, filter string = "") Cookie[] {
		let out Cookie[] = []
		for let line in headers.values("Cookie") {
			for let c in parseCookieHeader(line, filter) {
				out.push(c)
			}
		}
		return out
	}

	// readSetCookies reads every `Set-Cookie` header of a response header
	// block, skipping the ones that do not parse.
	def readSetCookies(headers Header) Cookie[] {
		let out Cookie[] = []
		for let line in headers.values("Set-Cookie") {
			let cookie = parseSetCookie(line) onerror recover new Cookie("", "")
			out.push(cookie) unless cookie.name == ""
		}
		return out
	}

	// cookieHeaderValue renders cookies as one `Cookie` request header value:
	// `a=1; b=2`.
	def cookieHeaderValue(cookies Cookie[]) string {
		let pairs string[] = []
		for let c in cookies {
			continue unless validCookieName(c.name)
			pairs.push(c.name + "=" + quoteCookieValue(sanitizeCookieValue(c.value)))
		}
		return pairs.join("; ")
	}

	// CookieJar stores cookies for a client across requests, the way a
	// browser does. `Jar` is the standard implementation.
	interface CookieJar {
		// setCookies records the cookies a response to `u` set, applying the
		// jar's policy (domain, path, expiry).
		def setCookies(u URL, cookies Cookie[])
		// cookies returns the cookies to send with a request to `u`, most
		// specific path first.
		def cookies(u URL) Cookie[]
	}

	// JarEntry is one stored cookie with the scope the jar computed for it.
	struct JarEntry {
		name       string
		value      string
		domain     string
		hostOnly   bool
		path       string
		secure     bool
		httpOnly   bool
		persistent bool
		expires    ?time.Time
		// Insertion order, so equal paths keep the order they were set in.
		sequence   int
	}

	// Jar is an in-memory CookieJar following RFC 6265: host-only cookies
	// for responses without `Domain`, domain matching on registrable
	// suffixes, path matching on the default or given `Path`, expiry by
	// `Expires` and `Max-Age`, `Secure` cookies only over https, and the
	// most specific path first when sending. Without a public suffix list
	// any domain a response names is accepted as long as the request host
	// is under it, so `co.uk`-style cookies are the caller's problem;
	// `publicSuffix` plugs a list in.
	//
	// Example:
	// ```example
	// let jar = new http.Jar()
	// jar.setCookies(try url.parse("https://example.com/app/"), [try http.parseSetCookie("id=1; Path=/app")])
	// println(jar.cookies(try url.parse("https://example.com/app/page")).len())  // 1
	// println(jar.cookies(try url.parse("https://example.com/other")).len())     // 0
	// ```
	type Jar {
		// Reports whether a domain is a public suffix (`com`, `co.uk`),
		// where a cookie may not be set; none accepts every domain.
		publicSuffix      ?def (domain string) bool = none
		internal entries  map<string, JarEntry>
		internal sequence int                       = 0

		def new() {
			self.entries = map<string, JarEntry>{}
		}

		// setCookies stores the cookies a response to `u` set; a cookie with
		// a domain the request host is not under, or one naming a public
		// suffix, is ignored; an expired one deletes what the jar held.
		def setCookies(u URL, cookies Cookie[]) {
			let host = u.hostname().lower()
			return when host == ""
			let now = time.now()
			for let c in cookies {
				continue unless validCookieName(c.name)
				let domain = host
				let hostOnly = true
				if c.domain != "" {
					let d = c.domain.lower()
					d = d[1:] when d.startsWith(".")
					continue unless d == host || host.endsWith("." + d)
					let suffix = publicSuffix
					if suffix is none {} else {
						continue when suffix(d)
					}
					domain = d
					hostOnly = false
				}
				let path = c.path
				path = defaultCookiePath(u.path) unless path.startsWith("/")
				let key = domain + ";" + path + ";" + c.name
				let expires ?time.Time = none
				let persistent = false
				if c.maxAge != 0 {
					if c.maxAge < 0 {
						entries.delete(key)
						continue
					}
					expires = time.fromUnixNs(now.unixNs() + int64(c.maxAge) * 1000000000)
					persistent = true
				} else {
					let at = c.expires
					if at is none {} else {
						if !at.after(now) {
							entries.delete(key)
							continue
						}
						expires = at
						persistent = true
					}
				}
				sequence++
				let previous = entries.get(key)
				let order = sequence
				if previous is none {} else {
					order = previous.sequence
				}
				entries.set(key, JarEntry{name: c.name, value: c.value, domain: domain, hostOnly: hostOnly, path: path, secure: c.secure, httpOnly: c.httpOnly, persistent: persistent, expires: expires, sequence: order})
			}
		}

		// cookies returns the cookies to send with a request to `u`: those
		// whose domain and path match, not expired, secure ones only over
		// https; longest path first, then in the order they were set.
		def cookies(u URL) Cookie[] {
			let host = u.hostname().lower()
			let https = u.scheme.lower() := "https" || "wss"
			let path = u.path
			path = "/" when path == ""
			let now = time.now()
			let matched JarEntry[] = []
			for let (_, entry) in entries {
				continue when entry.secure && !https
				let expiry = entry.expires
				if expiry is none {} else {
					continue unless expiry.after(now)
				}
				if entry.hostOnly {
					continue unless entry.domain == host
				} else {
					continue unless entry.domain == host || host.endsWith("." + entry.domain)
				}
				continue unless cookiePathMatches(path, entry.path)
				matched.push(entry)
			}
			matched.sort((a, b) => a.path.len() > b.path.len() || (a.path.len() == b.path.len() && a.sequence < b.sequence))
			let out Cookie[] = []
			for let entry in matched {
				out.push(new Cookie(entry.name, entry.value))
			}
			return out
		}

		// all lists every cookie held, expired ones dropped first.
		def all() Cookie[] {
			let now = time.now()
			let stale string[] = []
			let out Cookie[] = []
			for let (key, entry) in entries {
				let expiry = entry.expires
				if expiry is none {} else {
					if !expiry.after(now) {
						stale.push(key)
						continue
					}
				}
				let c = new Cookie(entry.name, entry.value)
				c.domain = entry.domain
				c.path = entry.path
				c.secure = entry.secure
				c.httpOnly = entry.httpOnly
				c.expires = entry.expires
				out.push(c)
			}
			for let key in stale {
				entries.delete(key)
			}
			return out
		}

		// clear forgets every cookie.
		def clear() {
			entries = map<string, JarEntry>{}
		}
	}

	// parseExpires reads an `Expires` attribute, none when it is not an HTTP
	// date (the attribute is then ignored, as RFC 6265 §5.2.1 says).
	internal def parseExpires(text string) ?time.Time {
		let sentinel = int64(-9000000000000000000)
		let parsed = time.parseHTTPDate(text) onerror recover time.fromUnixNs(sentinel)
		return none when parsed.unixNs() == sentinel
		return parsed
	}

	// defaultCookiePath is the RFC 6265 §5.1.4 default: the request path up
	// to its last slash, `/` when the path is empty or has no other slash.
	internal def defaultCookiePath(requestPath string) string {
		return "/" when requestPath == "" || !requestPath.startsWith("/")
		let last = -1
		for let i = 0; i < requestPath.len(); i++ {
			last = i when requestPath[i] == '/'
		}
		return "/" when last <= 0
		return requestPath[:last]
	}

	// cookiePathMatches applies RFC 6265 §5.1.4: equal paths, or the cookie
	// path is a prefix ending in `/`, or the prefix stops at a `/` of the
	// request path.
	internal def cookiePathMatches(requestPath string, cookiePath string) bool {
		return true when requestPath == cookiePath
		return false unless requestPath.startsWith(cookiePath)
		return true when cookiePath.endsWith("/")
		return requestPath.len() > cookiePath.len() && requestPath[cookiePath.len()] == '/'
	}

	// validCookieName is an RFC 6265 token: printable ASCII without
	// separators.
	internal def validCookieName(name string) bool {
		return validHeaderFieldName(name)
	}

	// validCookieValueChar is a byte a cookie value may carry: printable
	// ASCII except double quotes, semicolons and backslashes (RFC 6265
	// cookie-octet, plus space and comma which `quoteCookieValue` protects).
	internal def validCookieValueChar(c char) bool {
		return false unless c.isASCII()
		return false when c < ' ' || int(c) == 127
		return !(c := '"' || ';' || '\\')
	}

	// sanitizeCookieValue drops the bytes a value may not carry.
	internal def sanitizeCookieValue(value string) string {
		let out = ""
		for let i = 0; i < value.len(); i++ {
			out += string(value[i]) when validCookieValueChar(value[i])
		}
		return out
	}

	// quoteCookieValue wraps a value in double quotes when it holds a space
	// or a comma, which some receivers would otherwise split on.
	internal def quoteCookieValue(value string) string {
		return "\"" + value + "\"" when value.contains(" ") || value.contains(",")
		return value
	}

	// unquoteCookieValue strips a surrounding pair of double quotes and
	// rejects a value with a byte a cookie cannot carry.
	internal def unquoteCookieValue(value string) ?string {
		let v = value
		v = v[1:v.len() - 1] when v.len() >= 2 && v.startsWith("\"") && v.endsWith("\"")
		for let i = 0; i < v.len(); i++ {
			return none unless validCookieValueChar(v[i])
		}
		return v
	}

	// sanitizeCookiePath drops the bytes a path may not carry.
	internal def sanitizeCookiePath(path string) string {
		let out = ""
		for let i = 0; i < path.len(); i++ {
			let c = path[i]
			out += string(c) unless c < ' ' || int(c) == 127 || c == ';'
		}
		return out
	}

	// validCookieDomain accepts a host name: labels of letters, digits and
	// hyphens separated by dots, or an IP literal.
	internal def validCookieDomain(domain string) bool {
		return false when domain == "" || domain.len() > 255
		for let label in domain.split(".") {
			return false when label == "" || label.len() > 63
			return false when label.startsWith("-") || label.endsWith("-")
			for let i = 0; i < label.len(); i++ {
				let c = label[i]
				return false unless c.isASCII() && (c.isAlphanumeric() || c == '-')
			}
		}
		return true
	}
}
