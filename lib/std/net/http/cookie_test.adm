partial module std.net.http {
	use (
		std.net.url
		std.testing
		std.time
	)

	check "Cookie" {
		@test()
		def rendersSetCookie() !none {
			let c = new Cookie("session", "abc123")
			assert c.str() == "session=abc123"
			c.path = "/"
			c.maxAge = 3600
			c.secure = true
			c.httpOnly = true
			c.sameSite = SameSite.Strict
			assert c.str() == "session=abc123; Path=/; Max-Age=3600; HttpOnly; Secure; SameSite=Strict"
			c.domain = ".Example.com"
			c.maxAge = -1
			c.sameSite = SameSite.None
			c.partitioned = true
			c.expires = try time.parse("2026-10-21T07:28:00Z")
			assert c.str() == "session=abc123; Path=/; Domain=Example.com; Expires=Wed, 21 Oct 2026 07:28:00 GMT; Max-Age=0; HttpOnly; Secure; SameSite=None; Partitioned"
			let spaced = new Cookie("pref", "a b,c")
			assert spaced.str() == "pref=\"a b,c\""
			let bad = new Cookie("bad name", "v")
			assert bad.str() == ""
			let stripped = new Cookie("k", "v;x\"y\\z")
			assert stripped.str() == "k=vxyz"
			return none
		}

		@test()
		def validatesAndExpires() !none {
			let ok = new Cookie("id", "1")
			ok.domain = "example.com"
			ok.path = "/app"
			try ok.valid()
			let badName = new Cookie("a=b", "1")
			assert badName.valid() is error
			let badValue = new Cookie("a", "x;y")
			assert badValue.valid() is error
			let badDomain = new Cookie("a", "1")
			badDomain.domain = "-bad-.com"
			assert badDomain.valid() is error
			let now = try time.parse("2026-01-01T00:00:00Z")
			let fresh = new Cookie("a", "1")
			assert !fresh.isExpired(now)
			fresh.expires = try time.parse("2026-01-02T00:00:00Z")
			assert !fresh.isExpired(now)
			fresh.expires = try time.parse("2025-12-31T00:00:00Z")
			assert fresh.isExpired(now)
			let deleted = new Cookie("a", "1")
			deleted.maxAge = -1
			assert deleted.isExpired(now)
			badName.valid() onerror (e error) {
				assert e is HttpError
				recover none
			}
			return none
		}

		@test()
		def parsesCookieHeaders() !none {
			let cookies = parseCookieHeader("session=abc; theme=\"dark\"; bad name=1; ; empty=; ctl=" + string(char(1)) + "x")
			assert cookies.len() == 3
			assert cookies[0].name == "session"
			assert cookies[0].value == "abc"
			assert cookies[1].name == "theme"
			assert cookies[1].value == "dark"
			assert cookies[2].name == "empty"
			assert cookies[2].value == ""
			let only = parseCookieHeader("a=1; b=2; a=3", "a")
			assert only.len() == 2
			assert only[1].value == "3"
			let h = new Header()
			h.add("Cookie", "a=1")
			h.add("Cookie", "b=2; c=3")
			assert readCookies(h).len() == 3
			assert readCookies(h, "c").len() == 1
			assert cookieHeaderValue(readCookies(h)) == "a=1; b=2; c=3"
			assert cookieHeaderValue([new Cookie("x", "a b"), new Cookie("bad name", "1")]) == "x=\"a b\""
			return none
		}

		@test()
		def parsesSetCookie() !none {
			let c = try parseSetCookie("id=a3f; Path=/; Domain=.example.com; Expires=Wed, 21 Oct 2026 07:28:00 GMT; HttpOnly; Secure; SameSite=lax; Max-Age=60; Partitioned; Custom=1")
			assert c.name == "id"
			assert c.value == "a3f"
			assert c.path == "/"
			assert c.domain == "example.com"
			assert c.httpOnly
			assert c.secure
			assert c.sameSite == SameSite.Lax
			assert c.maxAge == 60
			assert c.partitioned
			assert c.rawExpires == "Wed, 21 Oct 2026 07:28:00 GMT"
			assert c.unparsed.equals(["Custom=1"])
			let at = c.expires
			assert !(at is none)
			return none when at is none
			assert at.year() == 2026 && at.month() == 10 && at.day() == 21
			let quoted = try parseSetCookie("v=\"with space\"; Max-Age=0; Expires=garbage; SameSite=Strict")
			assert quoted.value == "with space"
			assert quoted.maxAge == -1
			assert quoted.expires is none
			assert quoted.rawExpires == "garbage"
			assert quoted.sameSite == SameSite.Strict
			assert parseSetCookie("=novalue") is error
			assert parseSetCookie("nopair") is error
			assert parseSetCookie("bad name=1") is error
			assert parseSetCookie("a=x;y") is error || (try parseSetCookie("a=x;y")).value == "x"
			let h = new Header()
			h.add("Set-Cookie", "a=1; Path=/")
			h.add("Set-Cookie", "=broken")
			h.add("Set-Cookie", "b=2")
			let read = readSetCookies(h)
			assert read.len() == 2
			assert read[1].name == "b"
			return none
		}
	}

	check "Jar" {
		@test()
		def matchesDomainAndPath() !none {
			let jar = new Jar()
			let app = try url.parse("https://example.com/app/")
			jar.setCookies(app, [try parseSetCookie("id=1; Path=/app"), try parseSetCookie("wide=2; Domain=example.com; Path=/"), try parseSetCookie("here=3")])
			// `here` takes the default path `/app` from the request; `wide`
			// covers every path of every host under the domain.
			assert jar.cookies(try url.parse("https://example.com/app/page")).len() == 3
			assert cookieHeaderValue(jar.cookies(try url.parse("https://example.com/app/page"))) == "id=1; here=3; wide=2"
			assert cookieHeaderValue(jar.cookies(try url.parse("https://example.com/other"))) == "wide=2"
			assert cookieHeaderValue(jar.cookies(try url.parse("https://sub.example.com/app/x"))) == "wide=2"
			assert jar.cookies(try url.parse("https://elsewhere.org/app/")).len() == 0
			assert cookieHeaderValue(jar.cookies(try url.parse("https://example.com/application"))) == "wide=2"
			assert jar.all().len() == 3
			jar.clear()
			assert jar.all().len() == 0
			return none
		}

		@test()
		def honoursSecureExpiryAndDomainRules() !none {
			let jar = new Jar()
			let site = try url.parse("https://shop.example.com/")
			jar.setCookies(site, [try parseSetCookie("s=1; Secure"), try parseSetCookie("gone=2; Max-Age=0"), try parseSetCookie("far=3; Domain=other.com"), try parseSetCookie("old=4; Expires=Sun, 06 Nov 1994 08:49:37 GMT"), try parseSetCookie("live=5; Max-Age=3600")])
			assert cookieHeaderValue(jar.cookies(site)) == "s=1; live=5"
			assert cookieHeaderValue(jar.cookies(try url.parse("http://shop.example.com/"))) == "live=5"
			jar.setCookies(site, [try parseSetCookie("live=6; Max-Age=0")])
			assert cookieHeaderValue(jar.cookies(site)) == "s=1"
			jar.setCookies(site, [try parseSetCookie("s=7; Secure")])
			assert cookieHeaderValue(jar.cookies(site)) == "s=7"
			let guarded = new Jar()
			guarded.publicSuffix = def (d string) bool {
				return d := "com" || "example.com"
			}
			guarded.setCookies(site, [try parseSetCookie("a=1; Domain=example.com"), try parseSetCookie("b=2; Domain=shop.example.com")])
			assert cookieHeaderValue(guarded.cookies(site)) == "b=2"
			return none
		}
	}
}
