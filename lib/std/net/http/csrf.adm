partial module std.net.http {
	use std.net.url

	// denialMessage is the text of a validation failure, "" for an
	// unexpected error.
	internal def denialMessage(err error) string {
		return err.message when err is HttpError
		return ""
	}

	// CrossOriginProtection rejects non-safe requests (anything but GET,
	// HEAD, OPTIONS) that browsers mark as cross-site, using the
	// `Sec-Fetch-Site` header when present and `Origin` against `Host`
	// when not. No tokens, no cookies: modern browsers send the fetch
	// metadata, and a request from an old browser without it passes when
	// it carries no `Origin` either (a form from a non-browser client).
	//
	//     let csrf = new CrossOriginProtection()
	//     try csrf.addTrustedOrigin("https://app.example.com")
	//     mux.apply(csrf.middleware())
	type CrossOriginProtection {
		internal trustedOrigins string[]  = []
		internal bypassPatterns Pattern[] = []

		// Replaces the 403 answer.
		denyHandler ?Handler {
			value ?Handler = none

			def get() ?Handler {
				return value
			}

			def set(val ?Handler) {
				value = val
			}
		}

		def new() {}

		// Trusts requests from `origin` (`https://app.example.com`,
		// scheme, host and port exactly).
		// Fails with HttpError (op "csrf") when the origin is not a valid
		// scheme and host.
		def addTrustedOrigin(origin string) !none {
			let parsed = url.parse(origin) onerror (err error) {
				fail HttpError{message: "invalid origin: {origin}", op: "csrf", text: origin, cause: err}
			}
			fail HttpError{message: "origin needs a scheme and a host: {origin}", op: "csrf", text: origin} when parsed.scheme == "" || parsed.host == ""
			fail HttpError{message: "origin must not have a path, query or fragment: {origin}", op: "csrf", text: origin} when parsed.path != "" || parsed.rawQuery != "" || parsed.fragment != "" || !(parsed.user is none)
			let normalized = parsed.scheme.lower() + "://" + parsed.host.lower()
			trustedOrigins.push(normalized) unless trustedOrigins.includes(normalized)
			return none
		}

		// Skips the check for requests matching the path pattern
		// (`/webhooks/{path...}`), for endpoints other sites must post to.
		// Fails when the pattern does not parse.
		def addInsecureBypassPattern(pattern string) !none {
			let parsed = try parsePattern(pattern)
			bypassPatterns.push(parsed)
			return none
		}

		// Reports whether the request passes.
		// Fails with HttpError (op "csrf") naming the reason when it does
		// not.
		def validate(req Request) !none {
			return none when methodIsSafe(req.method)
			let path = req.url.path
			path = "/" when path == ""
			for let p in bypassPatterns {
				return none unless p.matches(requestMethodText(req), hostOnly(req.host), path) is none
			}
			let site = req.header("Sec-Fetch-Site").trim().lower()
			if site != "" {
				return none when site := "same-origin" || "none"
				return none when originTrusted(req)
				fail HttpError{message: "cross-origin request denied by Sec-Fetch-Site: {site}", op: "csrf", text: site, status: 403}
			}
			let originText = req.header("Origin").trim()
			// No fetch metadata and no origin: not a browser, or too old to
			// be attacked through one.
			return none when originText == ""
			let origin = url.parse(originText) onerror (err error) {
				fail HttpError{message: "invalid Origin header: {originText}", op: "csrf", text: originText, status: 403, cause: err}
			}
			return none when origin.host.lower() == req.host.lower()
			return none when originTrusted(req)
			fail HttpError{message: "cross-origin request denied: origin {originText} does not match host {req.host}", op: "csrf", text: originText, status: 403}
		}

		// Reports whether the request's `Origin` is in the trusted list.
		internal def originTrusted(req Request) bool {
			let originText = req.header("Origin").trim()
			return false when originText == ""
			let origin = url.parse(originText) onerror recover new url.URL()
			return false when origin.scheme == "" || origin.host == ""
			return trustedOrigins.includes(origin.scheme.lower() + "://" + origin.host.lower())
		}

		// Wraps `h` with the check; 403 (or the deny handler) on failure.
		def handler(h Handler) Handler {
			return new HandlerFunc(def (ctx Context) !none {
				let denied ?error = none
				validate(ctx.request) onerror (err error) {
					denied = err
					recover none
				}
				return h.serve(ctx) when denied is none
				let custom = denyHandler
				return custom.serve(ctx) unless custom is none
				return ctx.error(403, denialMessage(denied))
			})
		}

		// The check as middleware, for `mux.apply`.
		def middleware() Middleware {
			return new MiddlewareFunc(def (ctx Context, next Handler) !none {
				return handler(next).serve(ctx)
			})
		}
	}
}
