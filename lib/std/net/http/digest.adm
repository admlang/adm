partial module std.net.http {
	use (
		std.crypto::(constantTimeEqual, rand)
		std.crypto.hash::(Hash, digest, hmac)
		std.data.encoding::(base64decode, base64encode)
		std.time
		std.net.http.digest::*
	)

	// HTTP Digest access authentication (RFC 7616): the client answers a
	// `WWW-Authenticate: Digest` challenge (MD5, SHA-256, SHA-512-256 and
	// their `-sess` forms; qop `auth` and `auth-int`; `userhash`), and
	// `digestAuth` challenges on a server.

	// digestAuth challenges with Digest (RFC 7616) in `realm` and lets a
	// request through when its response proves the password `password`
	// gives for the user (none for an unknown user): the user becomes
	// `ctx.user`. The server offers SHA-256 and MD5 with qop `auth` and
	// `auth-int`; nonces are its own HMACs of their time, valid for five
	// minutes (then answered `stale=true`), and each nonce count is taken
	// once.
	//
	// ```
	// mux.use(http.digestAuth("files", def (user string) ?Secret<string> {
	//     return passwords.get(user)
	// }))
	// ```
	def digestAuth(realm string, password def(string) ?Secret<string>) Middleware {
		let secret = rand(32) onerror recover "adm digest fallback".bytes()
		let seen = new NonceCounts()
		return new MiddlewareFunc(def (ctx Context, next Handler) !none {
			let header = ctx.request.headers.get("Authorization")
			let stale = false
			if header.lower().startsWith("digest ") {
				let parsed = parseChallenges([header])
				if parsed.len() > 0 {
					let p = parsed[0].params
					let nonce = param(p, "nonce")
					let (fresh, known) = checkNonce(secret, realm, nonce)
					stale = known && !fresh
					let user = param(p, "username")
					let pw = password(user)
					if fresh && !(pw is none) && param(p, "realm") == realm && param(p, "uri") == ctx.request.requestURI() {
						let qop = param(p, "qop").lower()
						let nc = param(p, "nc")
						let body byte[] = qop == "auth-int" ?? (try ctx.request.bytes(), byte[])
						let expected = expectedResponse(p, requestMethodText(ctx.request), user, realm, pw.reveal(), body)
						if (qop == "" || seen.take(nonce, nc)) && constantTimeEqual(expected.bytes(), param(p, "response").lower().bytes()) {
							ctx.user = user
							ctx.authenticated = true
							return next.serve(ctx)
						}
					}
				}
			}
			let nonce = makeNonce(secret, realm)
			let tail = stale ?? (", stale=true", "")
			ctx.addHeader("WWW-Authenticate", "Digest realm=\"{quoteEscape(realm)}\", qop=\"auth, auth-int\", algorithm=SHA-256, nonce=\"{nonce}\", charset=UTF-8{tail}")
			ctx.addHeader("WWW-Authenticate", "Digest realm=\"{quoteEscape(realm)}\", qop=\"auth, auth-int\", algorithm=MD5, nonce=\"{nonce}\", charset=UTF-8{tail}")
			return ctx.error(401)
		})
	}
}

internal partial module std.net.http.digest {
	use (
		std.crypto::(constantTimeEqual, rand)
		std.crypto.hash::(Hash, digest, hmac)
		std.data.encoding::(base64decode, base64encode)
		std.time
		std.net.http::*
	)

	// One challenge of a `WWW-Authenticate` header: the scheme and its
	// parameters (names lower-cased).
	struct AuthChallenge {
		scheme string
		params map<string, string>
	}

	// The challenges of `WWW-Authenticate` values: a value may hold
	// several, `Basic realm="a", Digest realm="b", nonce="c"`.
	def parseChallenges(values string[]) AuthChallenge[] {
		let out AuthChallenge[] = []
		for let header in values {
			let s = header
			let i = 0
			let current ?AuthChallenge = none
			for i < s.len() {
				for i < s.len() && (s[i] == ' ' || s[i] == ',' || s[i] == '\t') {
					i++
				}
				break when i >= s.len()
				let start = i
				for i < s.len() && s[i] != ' ' && s[i] != '=' && s[i] != ',' {
					i++
				}
				let token = s[start:i]
				let j = i
				for j < s.len() && s[j] == ' ' {
					j++
				}
				if j < s.len() && s[j] == '=' {
					// A parameter of the current challenge.
					i = j + 1
					for i < s.len() && s[i] == ' ' {
						i++
					}
					let value = ""
					if i < s.len() && s[i] == '"' {
						i++
						for i < s.len() && s[i] != '"' {
							if s[i] == '\\' && i + 1 < s.len() {
								i++
							}
							value += s[i:i + 1]
							i++
						}
						i++
					} else {
						let vs = i
						for i < s.len() && s[i] != ',' && s[i] != ' ' {
							i++
						}
						value = s[vs:i]
					}
					let c = current
					c.params[token.lower()] = value unless c is none
					continue
				}
				let fresh = AuthChallenge{scheme: token.lower(), params: map<string, string>{}}
				out.push(fresh)
				current = fresh
			}
		}
		return out
	}

	// The hash of a Digest algorithm name; none for an unknown one.
	def digestHash(algorithm string) ?Hash {
		let name = algorithm.upper().trimSuffix("-SESS")
		return Hash.MD5 when name == "" || name == "MD5"
		return Hash.SHA256 when name == "SHA-256"
		return Hash.SHA512_256 when name == "SHA-512-256"
		return none
	}

	// How strong an algorithm is, to pick among several challenges.
	def digestRank(algorithm string) int {
		let name = algorithm.upper().trimSuffix("-SESS")
		return 3 when name == "SHA-512-256"
		return 2 when name == "SHA-256"
		return 1 when name == "" || name == "MD5"
		return 0
	}

	def hexDigest(h Hash, text string) string {
		return digest(h, text.bytes()).hex().lower()
	}

	// DigestState is what a client keeps of a Digest challenge to answer
	// it again without a new round trip: the challenge and the nonce
	// count.
	type DigestState {
		challenge    AuthChallenge
		atomic count int           = 0

		def new(challenge AuthChallenge) {
			self.challenge = challenge
		}

		atomic def next() int {
			count++
			return count
		}
	}

	// The `Authorization` value answering a Digest challenge (RFC 7616
	// §3.4) for `method` and `uri`, with the body for qop `auth-int`.
	// Fails when the challenge names an algorithm or qop this side does
	// not know, or the random source fails.
	def digestAuthorization(state DigestState, method string, uri string, username string, password string, body byte[]) !string {
		let p = state.challenge.params
		let algorithm = param(p, "algorithm")
		let h = digestHash(algorithm)
		fail HttpError{message: "digest: unsupported algorithm {algorithm}", op: "auth"} when h is none
		let realm = param(p, "realm")
		let nonce = param(p, "nonce")
		let offered = param(p, "qop").lower().split(",").mapElem<string>(q => q.trim())
		let qop = offered.includes("auth") ?? ("auth", offered.includes("auth-int") ?? ("auth-int", ""))
		fail HttpError{message: "digest: unsupported qop {param(p, "qop")}", op: "auth"} when qop == "" && param(p, "qop") != ""
		let cnonce = (try rand(16)).hex().lower()
		let nc = state.next()
		let ncText = hex8(nc)
		let ha1 = hexDigest(h, "{username}:{realm}:{password}")
		ha1 = hexDigest(h, "{ha1}:{nonce}:{cnonce}") when algorithm.upper().endsWith("-SESS")
		let a2 = qop == "auth-int" ?? ("{method}:{uri}:{digest(h, body).hex().lower()}", "{method}:{uri}")
		let ha2 = hexDigest(h, a2)
		let response = qop == "" ?? (hexDigest(h, "{ha1}:{nonce}:{ha2}"), hexDigest(h, "{ha1}:{nonce}:{ncText}:{cnonce}:{qop}:{ha2}"))
		let userhash = param(p, "userhash").lower() == "true"
		let user = userhash ?? (hexDigest(h, "{username}:{realm}"), username)
		let out = "Digest username=\"{quoteEscape(user)}\", realm=\"{quoteEscape(realm)}\", uri=\"{uri}\", nonce=\"{nonce}\", response=\"{response}\""
		out += ", algorithm={algorithm}" when algorithm != ""
		let opaque = p.get("opaque")
		out += ", opaque=\"{opaque}\"" unless opaque is none
		if qop != "" {
			out += ", qop={qop}, nc={ncText}, cnonce=\"{cnonce}\""
		}
		out += ", userhash=true" when userhash
		return out
	}

	// A parameter, "" when absent.
	def param(p map<string, string>, name string) string {
		let v = p.get(name)
		return v is none ?? ("", v)
	}

	// Eight lower-case hex digits, as `nc` is written.
	def hex8(n int) string {
		let digits = "0123456789abcdef"
		let out = ""
		for let shift = 28; shift >= 0; shift -= 4 {
			let d = (n >> shift) & 15
			out += digits[d:d + 1]
		}
		return out
	}

	def quoteEscape(text string) string {
		return text.replace("\\", "\\\\").replace("\"", "\\\"")
	}

	// The strongest Digest challenge this side can answer; none when
	// there is none.
	def pickDigest(challenges AuthChallenge[]) ?AuthChallenge {
		let best ?AuthChallenge = none
		let bestRank = 0
		for let c in challenges {
			continue unless c.scheme == "digest"
			let rank = digestRank(param(c.params, "algorithm"))
			if rank > bestRank {
				best = c
				bestRank = rank
			}
		}
		return best
	}

	// The response a client with the password would send.
	def expectedResponse(p map<string, string>, method string, user string, realm string, password string, body byte[]) string {
		let algorithm = param(p, "algorithm")
		let h = digestHash(algorithm)
		return "" when h is none
		let nonce = param(p, "nonce")
		let cnonce = param(p, "cnonce")
		let qop = param(p, "qop").lower()
		let ha1 = hexDigest(h, "{user}:{realm}:{password}")
		ha1 = hexDigest(h, "{ha1}:{nonce}:{cnonce}") when algorithm.upper().endsWith("-SESS")
		let uri = param(p, "uri")
		let ha2 = hexDigest(h, qop == "auth-int" ?? ("{method}:{uri}:{digest(h, body).hex().lower()}", "{method}:{uri}"))
		return qop == "" ?? (hexDigest(h, "{ha1}:{nonce}:{ha2}"), hexDigest(h, "{ha1}:{nonce}:{param(p, "nc")}:{cnonce}:{qop}:{ha2}"))
	}

	// A nonce: the time it was made and this server's HMAC of it.
	def makeNonce(secret byte[], realm string) string {
		let stamp = time.now().unixNs().str()
		let mac = hmac(Hash.SHA256, secret, (stamp + ":" + realm).bytes())[:16]
		return base64encode((stamp + ":" + mac.hex().lower()).bytes())
	}

	// Whether a nonce is fresh (made here within five minutes) and
	// whether it was made here at all.
	def checkNonce(secret byte[], realm string, nonce string) (bool, bool) {
		let raw = base64decode(nonce) onerror recover byte[]
		let text = string(raw)
		let colon = text.indexOf(":")
		return (false, false) when colon <= 0
		let stamp = text[:colon]
		let mac = hmac(Hash.SHA256, secret, (stamp + ":" + realm).bytes())[:16].hex().lower()
		return (false, false) unless constantTimeEqual(mac.bytes(), text[colon + 1:].bytes())
		let made = stamp.toInt<int64>()
		return (time.now().unixNs() - made < 300000000000, true)
	}

	// NonceCounts remembers the nonce counts used, so a replayed request
	// is refused.
	type NonceCounts {
		atomic used map<string, bool>

		def new() {}

		// Whether `nc` is new for `nonce`; remembers it.
		atomic def take(nonce string, nc string) bool {
			let key = nonce + "/" + nc
			return false when used.hasKey(key)
			used = map<string, bool>{} when used.len() > 100000
			used[key] = true
			return true
		}
	}
}
