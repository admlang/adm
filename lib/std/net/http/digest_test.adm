partial module std.net.http {
	use (
		std.net.http.digest::*
		std.net.http.httptest
		std.testing
	)

	check "Digest" {
		@test()
		def matchesRfc7616() {
			// RFC 7616 §3.9.1: Mufasa, "Circle of Life", MD5 and SHA-256.
			let p = map<string, string>{"realm": "http-auth@example.org", "nonce": "7ypf/xlj9XXwfDPEoM4URrv/xwf94BcCAzFZH4GiTo0v", "cnonce": "f2/wE4q74E6zIJEtWaHKaf5wv/H5QzzpXusqGemxURZJ", "nc": "00000001", "qop": "auth", "uri": "/dir/index.html", "algorithm": "MD5"}
			assert expectedResponse(p, "GET", "Mufasa", "http-auth@example.org", "Circle of Life", []) == "8ca523f5e9506fed4657c9700eebdbec"
			p["algorithm"] = "SHA-256"
			assert expectedResponse(p, "GET", "Mufasa", "http-auth@example.org", "Circle of Life", []) == "753927fa0e85d155564e2e272a28d1802ca10daf4496794697cf8db5856cb6c1"
			let parsed = parseChallenges(["Basic realm=\"x\", Digest realm=\"http-auth@example.org\", qop=\"auth, auth-int\", algorithm=SHA-256, nonce=\"n\", opaque=\"o\"", "Digest realm=\"r\", algorithm=MD5, nonce=\"m\""])
			assert parsed.len() == 3 && parsed[0].scheme == "basic" && parsed[1].params["qop"] == "auth, auth-int"
			let best = pickDigest(parsed)
			assert !(best is none) && param(best.params, "algorithm") == "SHA-256"
			assert hex8(255) == "000000ff"
		}

		@test()
		def logsInOverDigest() !none {
			let mux = new ServeMux()
			let passwords = map<string, Secret<string>>{"mufasa": "Circle of Life"}
			mux.apply(digestAuth("lions", def (user string) ?Secret<string> {
				return passwords.get(user)
			}))
			let challenges = 0
			try mux.handle("/", def (ctx Context) !none {
				let body = try ctx.request.text()
				return try ctx.text("hello {ctx.user} {body}")
			})
			let site = new httptest.Server(mux)
			try site.start()
			let base = "http://{site.address().str()}"
			let anonymous = new Client(base, 5s)
			assert (try anonymous.get("/a")).status == 401
			let c = new Client(base, 5s)
			c.username = "mufasa"
			c.password = "Circle of Life"
			c.onResponse(def (res Response) !none {
				challenges++ when res.status == 401
				return none
			})
			let first = try c.get("/a?x=1")
			assert first.status == 200 && (try first.text()) == "hello mufasa "
			// The second request answers the known challenge at once.
			let second = try c.post("/b", "text/plain", "payload".bytes())
			assert second.status == 200 && (try second.text()) == "hello mufasa payload"
			assert challenges == 1
			let wrong = new Client(base, 5s)
			wrong.username = "mufasa"
			wrong.password = "Circle of Death"
			assert (try wrong.get("/a")).status == 401
			try site.close()
			return none
		}
	}
}
