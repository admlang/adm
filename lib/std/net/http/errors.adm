partial module std.net.http {
	use std.errors

	// HttpError is the payload of every failure in the http modules: a header
	// block or cookie that does not parse, a status line out of range, a
	// body that breaks its framing.
	struct HttpError {
		message string
		code    string            = "http"
		cause   ?error
		stack   errors.StackTrace
		// The operation that failed: "header", "status", "cookie", "date".
		op      string
		// The text that was being read, when there is one.
		text    string
		// The response status a server sends when a handler fails with
		// this error (`Context.abort`); 0 means 500.
		status  int               = 0
	}
}
