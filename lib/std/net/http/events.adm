partial module std.net.http {
	use std.io

	// One server-sent event as a client reads it.
	struct ServerEvent {
		// The `event:` field; "" for an event without one, which a browser
		// calls `message`.
		name  string
		// The `data:` lines joined with line breaks.
		data  string
		// The `id:` field; "" when the event carries none.
		id    string
		// The `retry:` field in milliseconds, how long the server asks a
		// client to wait before reconnecting; none when not sent.
		retry ?int
	}

	// EventReader reads the server-sent events of a response body
	// (`Content-Type: text/event-stream`), the counterpart of
	// `Context.event`.
	//
	// ```
	// let res = try client.get("/updates")
	// let events = new http.EventReader(res.body)
	// for {
	// 	let event = try events.next()
	// 	break when event is none
	// 	println(event.data)
	// }
	// ```
	type EventReader {
		// The id of the last event that carried one: what a client sends as
		// `Last-Event-ID` to resume.
		lastId string = ""

		internal reader ?io.Reader
		internal buf    byte[]
		internal at     int        = 0
		internal ended  bool       = false

		def new(reader ?io.Reader) {
			self.reader = reader
		}

		// The next event; none at the end of the stream. Comment lines and
		// events without data are skipped, as the format says. Fails when
		// the read does.
		def next() !?ServerEvent {
			let event = ServerEvent{}
			let lines string[] = []
			let any = false
			for {
				let line = try readLine()
				return none when line is none
				if line == "" {
					if any {
						event.data = lines.join("\n")
						return event
					}
					event = ServerEvent{}
					continue
				}
				continue when line.startsWith(":")
				let colon = line.indexOf(":")
				let field = colon < 0 ?? (line, line[0:colon])
				let value = colon < 0 ?? ("", line[colon + 1:])
				value = value[1:] when value.startsWith(" ")
				match field {
					case "data":
						lines.push(value)
						any = true
					case "event":
						event.name = value
					case "id":
						if value.bytes().indexOf(byte(0)) < 0 {
							event.id = value
							lastId = value
						}
					case "retry":
						event.retry = value.toInt<int>() when value.isNumeric()
				}
			}
			fail "unreachable"
		}

		// The next line without its line break (CR, LF or CRLF); none at the
		// end of the stream. A last line without a break is dropped, as an
		// event it is part of is incomplete.
		internal def readLine() !?string {
			for {
				for let i = at; i < buf.len(); i++ {
					let b = buf[i]
					continue unless b == byte(0x0A) || b == byte(0x0D)
					// A CR at the end of what was read may be half of a CRLF.
					break when b == byte(0x0D) && i + 1 == buf.len() && !ended
					let line = string(buf[at:i])
					at = i + 1
					at++ when b == byte(0x0D) && at < buf.len() && buf[at] == byte(0x0A)
					return line
				}
				return none when ended
				let source = reader
				return none when source is none
				if at > 0 {
					buf = buf[at:].clone()
					at = 0
				}
				let chunk byte[]
				chunk.len(8192)
				let n = try source.read(chunk)
				if n <= 0 {
					ended = true
					continue
				}
				buf += chunk[0:n]
			}
			fail "unreachable"
		}
	}
}
