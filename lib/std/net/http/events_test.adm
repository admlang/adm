partial module std.net.http {
	use (
		std.testing
		std.bytes
		std.net.http.httptest
	)

	check "Server-sent events" {
		@test()
		def TestEventReader() !none {
			let text = ": hello\n\ndata: one\n\nevent: update\r\nid: 7\r\ndata: first\r\ndata:second\r\n\r\nretry: 1500\ndata\n\nid: 8\n\ndata: cut"
			let events = new EventReader(new bytes.Reader(text.bytes()))
			let one = try events.next()
			fail "no first event" when one is none
			assert one.name == "" && one.data == "one" && one.id == ""
			let two = try events.next()
			fail "no second event" when two is none
			assert two.name == "update" && two.data == "first\nsecond" && two.id == "7" && events.lastId == "7"
			let three = try events.next()
			fail "no third event" when three is none
			let wait = three.retry
			fail "no retry" when wait is none
			assert three.data == "" && wait == 1500
			// An event without data is not one, though its id counts; an
			// event cut off by the end of the stream is dropped.
			assert (try events.next()) is none
			assert events.lastId == "8"
			return none
		}

		@test()
		def TestEventRoundTrip() !none {
			let rec = new httptest.ResponseRecorder()
			let ctx = rec.context(try httptest.newRequest(Method.GET, "/events"))
			try ctx.event("line one\nline two", "note", "3")
			try ctx.event("plain")
			let events = new EventReader(rec.result().body)
			let first = try events.next()
			fail "no first event" when first is none
			assert first.name == "note" && first.data == "line one\nline two" && first.id == "3"
			let second = try events.next()
			fail "no second event" when second is none
			assert second.data == "plain" && second.name == ""
			return none
		}
	}
}
