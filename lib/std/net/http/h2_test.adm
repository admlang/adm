partial module std.net.http {
	use std.testing

	check "HTTP/2 wiring" {
		@test()
		def splitsCookiesIntoPairs() !none {
			let req = try newRequest(Method.GET, "https://example.org/a")
			req.headers.add("Cookie", "session=0123456789abcdef0123456789; theme=dark;  lang=en ;")
			req.headers.add("Cookie", "extra=1")
			req.headers.set("Accept", "text/html; q=0.9")
			let cookies string[] = []
			let kept = 0
			for let field in requestBlock(req) {
				// Only `cookie` is split on its semicolons.
				kept++ when field.name == "accept" && field.value == "text/html; q=0.9"
				continue when field.name != "cookie"
				cookies.push(field.value)
				// A short pair is never indexed, a long one may be.
				assert field.sensitive == (field.value.len() < 20)
			}
			assert kept == 1
			assert cookies.join("|") == "session=0123456789abcdef0123456789|theme=dark|lang=en|extra=1"
			return none
		}
	}
}
