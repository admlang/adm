partial module std.net.http {
	use (
		std.formats
		std.io
	)

	// Header is the header block of a request or response: an ordered map
	// from canonical field names (`Content-Type`, not `content-type`) to the
	// values they appeared with, in order. Lookups are case-insensitive;
	// the wire form writes fields in sorted order, one line per value.
	//
	// Example:
	// ```example
	// let h = new http.Header()
	// h.set("content-type", "text/html; charset=utf-8")
	// h.add("Set-Cookie", "a=1")
	// h.add("Set-Cookie", "b=2")
	// println(h.get("CONTENT-TYPE"))          // text/html; charset=utf-8
	// println(h.values("set-cookie").len())   // 2
	// println(h.str())                        // Content-Type: ...\r\nSet-Cookie: a=1\r\nSet-Cookie: b=2\r\n
	// ```
	type Header {
		internal fields map<string, string[]>
		internal order  string[]

		def new() {
			self.fields = map<string, string[]>{}
			self.order = []
		}

		// get returns the first value of a field, "" when absent. Use
		// `values` for fields that repeat (`Set-Cookie`, `Via`).
		def get(name string) string {
			let list = fields.get(canonicalHeaderKey(name))
			return "" when list is none
			return "" when list.len() == 0
			return list[0]
		}

		// values returns every value of a field in order, empty when absent.
		def values(name string) string[] {
			let list = fields.get(canonicalHeaderKey(name))
			return [] when list is none
			return list.clone()
		}

		// set replaces every value of a field with one value.
		def set(name string, value string) {
			let key = canonicalHeaderKey(name)
			order.push(key) unless fields.hasKey(key)
			fields.set(key, [value])
		}

		// add appends a value to a field, keeping the values before it.
		def add(name string, value string) {
			let key = canonicalHeaderKey(name)
			let list = fields.get(key)
			if list is none {
				order.push(key)
				fields.set(key, [value])
				return
			}
			list.push(value)
			fields.set(key, list)
		}

		// del removes a field entirely. Deleting an absent field is not an
		// error.
		def del(name string) {
			let key = canonicalHeaderKey(name)
			return unless fields.hasKey(key)
			fields.delete(key)
			order = order.filter(k => k != key)
		}

		// has reports whether the field is present, with any value.
		def has(name string) bool {
			return fields.hasKey(canonicalHeaderKey(name))
		}

		// hasToken reports whether a comma-separated field (`Connection`,
		// `Vary`, `Transfer-Encoding`, `Cache-Control`) lists the token,
		// case-insensitively, in any of its values.
		//
		// Example:
		// ```example
		// h.set("Connection", "keep-alive, Upgrade")
		// println(h.hasToken("connection", "upgrade"))  // true
		// ```
		def hasToken(name string, token string) bool {
			return tokens(name).includes(token.trim().lower())
		}

		// tokens splits a comma-separated field into its trimmed,
		// lower-cased tokens across every value; empty when absent.
		def tokens(name string) string[] {
			let out string[] = []
			for let value in values(name) {
				for let piece in value.split(",") {
					let token = piece.trim().lower()
					out.push(token) unless token == ""
				}
			}
			return out
		}

		// keys lists the canonical field names in first-seen order.
		def keys() string[] {
			return order.clone()
		}

		// len is the number of distinct fields.
		def len() int {
			return order.len()
		}

		// clone copies the header; the copy and the original do not share
		// value lists.
		def clone() Header {
			let out = new Header()
			for let key in order {
				out.fields.set(key, values(key))
				out.order.push(key)
			}
			return out
		}

		// contentLength reads `Content-Length` as a byte count, none when
		// absent. Fails with HttpError (op "header") when the value is not
		// a non-negative integer or two values disagree.
		def contentLength() !?int {
			let list = values("Content-Length")
			return none when list.len() == 0
			let length = -1
			for let value in list {
				let text = value.trim()
				fail HttpError{message: "Content-Length is not a byte count: {value}", op: "header", text: value} unless text != "" && text.isNumeric()
				let n = text.toInt<int>()
				fail HttpError{message: "Content-Length values disagree: {length} and {n}", op: "header", text: value} when length >= 0 && n != length
				length = n
			}
			return length
		}

		// contentType parses `Content-Type`, none when absent. Fails with
		// HttpError (op "header") when it does not parse as a media type.
		def contentType() !?formats.MediaType {
			let value = get("Content-Type")
			return none when value == ""
			return formats.parseMediaType(value) onerror (err error) {
				fail HttpError{message: "Content-Type does not parse: {value}", op: "header", text: value, cause: err}
			}
		}

		// stripHopByHop removes the connection-scoped fields a proxy must not
		// forward (RFC 9110 §7.6.1): `Connection` and every field it names,
		// `Keep-Alive`, `Proxy-Connection`, `Transfer-Encoding`, `TE`,
		// `Trailer`, `Upgrade`.
		def stripHopByHop() {
			for let named in tokens("Connection") {
				del(named)
			}
			for let name in ["Connection", "Keep-Alive", "Proxy-Connection", "Transfer-Encoding", "TE", "Trailer", "Upgrade"] {
				del(name)
			}
		}

		// write renders the block on the wire, each field sorted by name,
		// one `Name: value\r\n` line per value, without the blank line that
		// ends a block. Fails when the sink fails.
		def write(w io.Writer) !none {
			let data = str().bytes()
			let offset = 0
			for offset < data.len() {
				let n = try w.write(data.slice(offset, data.len() - offset))
				fail HttpError{message: "header sink accepted nothing", op: "header"} when n <= 0
				offset += n
			}
			return none
		}

		// str is the wire form `write` produces, as a string.
		def str() string {
			let names = order.clone().sort((a, b) => a < b)
			let out = ""
			for let name in names {
				for let value in values(name) {
					out += name + ": " + value + "\r\n"
				}
			}
			return out
		}
	}

	// canonicalHeaderKey renders a field name the way `Header` stores it:
	// the first letter of every dash-separated word upper-cased, the rest
	// lower-cased (`content-type` becomes `Content-Type`, `etag` becomes
	// `Etag`). A name with a character that is not a token character is
	// returned unchanged.
	def canonicalHeaderKey(name string) string {
		return name unless validHeaderFieldName(name)
		let out = ""
		let upper = true
		for let i = 0; i < name.len(); i++ {
			let c = name[i]
			if c == '-' {
				out += "-"
				upper = true
				continue
			}
			out += upper ?? (string(c.upper()), string(c.lower()))
			upper = false
		}
		return out
	}

	// parseHeaderBlock reads a header block as it arrives on the wire: lines
	// `Name: value` ending in CR LF or LF, folded continuation lines
	// (starting with a space or tab) joined with a space, up to the first
	// empty line or the end of the text. Fails with HttpError (op "header")
	// on a line without a colon, an invalid field name, or a block larger
	// than `maxBytes` (0 for no limit).
	//
	// Example:
	// ```example
	// let h = try http.parseHeaderBlock("Host: example.com\r\nAccept: text/html,\r\n application/xml\r\n\r\nbody")
	// println(h.get("accept"))  // text/html, application/xml
	// ```
	def parseHeaderBlock(text string, maxBytes int = 1024 * 1024) !Header {
		let header = new Header()
		let name = ""
		let value = ""
		let consumed = 0
		for let raw in text.split("\n") {
			let line = raw.trimSuffix("\r")
			break when line == ""
			consumed += raw.len() + 1
			fail HttpError{message: "header block exceeds {maxBytes} bytes", op: "header"} when maxBytes > 0 && consumed > maxBytes
			if (line.startsWith(" ") || line.startsWith("\t")) && name != "" {
				value += " " + line.trim()
				continue
			}
			header.add(name, value) when name != ""
			let colon = line.indexOf(":")
			fail HttpError{message: "malformed header line: {line}", op: "header", text: line} when colon <= 0
			name = line[:colon]
			fail HttpError{message: "invalid header field name: {name}", op: "header", text: line} unless validHeaderFieldName(name)
			value = line[colon + 1:].trim()
			fail HttpError{message: "invalid header field value for {name}", op: "header", text: line} unless validHeaderFieldValue(value)
		}
		header.add(name, value) when name != ""
		return header
	}

	// validHeaderFieldName reports an RFC 9110 token: printable ASCII
	// without separators.
	def validHeaderFieldName(name string) bool {
		return false when name == ""
		for let i = 0; i < name.len(); i++ {
			let c = name[i]
			return false unless c.isASCII() && c > ' ' && int(c) != 127
			return false when "()<>@,;:\\\"/[]?={}".indexOf(string(c)) >= 0
		}
		return true
	}

	// validHeaderFieldValue reports a value without control characters
	// other than tab, the only ones a field may carry.
	def validHeaderFieldValue(value string) bool {
		for let i = 0; i < value.len(); i++ {
			let c = value[i]
			return false when (c < ' ' && c != '\t') || int(c) == 127
		}
		return true
	}
}
