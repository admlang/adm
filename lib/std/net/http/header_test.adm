partial module std.net.http {
	use (
		std.bytes
		std.testing
	)

	check "Header" {
		@test()
		def storesCanonicalKeysInOrder() !none {
			let h = new Header()
			h.set("content-type", "text/html; charset=utf-8")
			h.add("Set-Cookie", "a=1")
			h.add("set-cookie", "b=2")
			h.add("X-Custom-Header", "x")
			assert h.get("CONTENT-TYPE") == "text/html; charset=utf-8"
			assert h.get("missing") == ""
			assert h.values("Set-Cookie").equals(["a=1", "b=2"])
			assert h.values("nothing").len() == 0
			assert h.keys().equals(["Content-Type", "Set-Cookie", "X-Custom-Header"])
			assert h.len() == 3
			assert h.has("x-custom-header")
			assert !h.has("x-other")
			h.set("Set-Cookie", "only")
			assert h.values("Set-Cookie").equals(["only"])
			h.del("SET-COOKIE")
			h.del("never-there")
			assert !h.has("Set-Cookie")
			assert h.keys().equals(["Content-Type", "X-Custom-Header"])
			return none
		}

		@test()
		def rendersSortedWireForm() !none {
			let h = new Header()
			h.set("Host", "example.com")
			h.add("Accept", "text/html")
			h.add("Accept", "application/xml")
			assert h.str() == "Accept: text/html\r\nAccept: application/xml\r\nHost: example.com\r\n"
			let sink = new bytes.Buffer()
			try h.write(sink)
			assert string(sink.bytes()) == h.str()
			let copy = h.clone()
			copy.add("Accept", "*/*")
			assert h.values("Accept").len() == 2
			assert copy.values("Accept").len() == 3
			return none
		}

		@test()
		def readsTokensAndHopByHop() !none {
			let h = new Header()
			h.set("Connection", "keep-alive, Upgrade")
			h.add("Connection", "X-Forward-Me")
			h.set("Upgrade", "websocket")
			h.set("X-Forward-Me", "v")
			h.set("Keep-Alive", "timeout=5")
			h.set("Host", "example.com")
			assert h.hasToken("connection", "upgrade")
			assert h.hasToken("Connection", "KEEP-ALIVE")
			assert !h.hasToken("Connection", "close")
			assert h.tokens("Connection").equals(["keep-alive", "upgrade", "x-forward-me"])
			assert h.tokens("Absent").len() == 0
			h.stripHopByHop()
			assert h.keys().equals(["Host"])
			return none
		}

		@test()
		def parsesContentLengthAndType() !none {
			let h = new Header()
			assert (try h.contentLength()) is none
			assert (try h.contentType()) is none
			h.set("Content-Length", " 42 ")
			assert orInt(try h.contentLength()) == 42
			h.add("Content-Length", "42")
			assert orInt(try h.contentLength()) == 42
			h.add("Content-Length", "7")
			assert h.contentLength() is error
			h.set("Content-Length", "abc")
			assert h.contentLength() is error
			h.set("Content-Type", "Text/HTML; charset=UTF-8")
			let mt = try h.contentType()
			assert !(mt is none)
			return none when mt is none
			assert mt.essence() == "text/html"
			h.set("Content-Type", "no slash here")
			assert h.contentType() is error
			return none
		}

		@test()
		def parsesHeaderBlocks() !none {
			let h = try parseHeaderBlock("Host: example.com\r\nAccept: text/html,\r\n application/xml\r\nx-a: 1\nX-A: 2\r\n\r\nbody: not a header")
			assert h.get("host") == "example.com"
			assert h.get("accept") == "text/html, application/xml"
			assert h.values("X-A").equals(["1", "2"])
			assert h.len() == 3
			assert parseHeaderBlock("no colon\r\n") is error
			assert parseHeaderBlock(": empty name\r\n") is error
			assert parseHeaderBlock("Bad Name: v\r\n") is error
			assert parseHeaderBlock("X: line" + string(char(1)) + "control\r\n") is error
			assert parseHeaderBlock("Host: example.com\r\nAccept: */*\r\n", 12) is error
			let err = parseHeaderBlock("nope") onerror (e error) {
				assert e is HttpError
				recover new Header()
			}
			assert err.len() == 0
			return none
		}

		@test()
		def canonicalisesAndValidatesNames() !none {
			assert canonicalHeaderKey("content-type") == "Content-Type"
			assert canonicalHeaderKey("CONTENT-DISPOSITION") == "Content-Disposition"
			assert canonicalHeaderKey("x-my-header") == "X-My-Header"
			assert canonicalHeaderKey("etag") == "Etag"
			assert canonicalHeaderKey("bad name") == "bad name"
			assert validHeaderFieldName("X-Token")
			assert !validHeaderFieldName("")
			assert !validHeaderFieldName("a:b")
			assert !validHeaderFieldName("sp ace")
			assert validHeaderFieldValue("text/html;\tq=1")
			assert !validHeaderFieldValue("line\r\nbreak")
			return none
		}
	}

	// orInt reads an optional count, -1 when absent.
	internal def orInt(value ?int) int {
		return -1 when value is none
		return value
	}
}
