partial module std.net.http.http2 {
	use (
		std.net
		std.testing
		std.time
	)

	// TimedStream is a socket as an io.Reader and io.Writer with fixed
	// timeouts, and its closer.
	internal type TimedStream {
		conn net.Stream

		def new(conn net.Stream) {
			self.conn = conn
		}

		def read(buf byte[]) !int {
			return conn.read(buf, 10s)
		}

		def write(buf byte[]) !int {
			return conn.write(buf, 10s)
		}

		def close() !none {
			return conn.close()
		}
	}

	// Loopback is a client and a server connection over a TCP socket
	// pair on 127.0.0.1, both handshaken.
	internal type Loopback {
		client   Conn
		server   Conn
		listener net.Listener

		def close() {
			client.close() onerror recover none
			server.close() onerror recover none
			listener.close() onerror recover none
		}
	}

	// echoStream answers a request with its method and path in headers
	// and the body echoed, with a trailer counting the bytes.
	internal def echoStream(s Stream) !none {
		let fields = try s.readHeaders()
		let body = try s.readAll()
		let response = [HeaderField{name:":status", value:"200"}, HeaderField{name:"x-method", value:valueOf(fields, ":method")}, HeaderField{name:"x-path", value:valueOf(fields, ":path")}]
		if body.len() == 0 {
			try s.writeHeaders(response, true)
			return none
		}
		try s.writeHeaders(response, false)
		try s.write(body)
		return try s.end([HeaderField{name:"x-size", value:body.len().str()}])
	}

	// `idle` and `pingEvery` are the client's `idleTimeout` and
	// `pingInterval` (answer awaited for 200ms).
	internal def loopback(handler def (s Stream) !none, idle duration = 0s, pingEvery duration = 0s) !Loopback {
		let sock = try net.socket(net.SocketDomain.IPv4, net.SocketType.Stream)
		sock.setReuseAddr(true) onerror recover none
		try sock.bind("127.0.0.1:0")
		let ln = try sock.listen(4)
		let addr = "127.0.0.1:" + ln.address().port.str()
		let accepting = async ln.accept()
		let clientConn = try net.dialStream(addr, 5s)
		let accepted = try await accepting
		let clientStream = new TimedStream(clientConn)
		let serverStream = new TimedStream(accepted)
		let server = new Conn(serverStream, serverStream, false, serverStream)
		server.onStream = handler
		let client = new Conn(clientStream, clientStream, true, clientStream)
		client.idleTimeout = idle
		client.pingInterval = pingEvery
		client.pingTimeout = 200ms
		let serving = async server.handshake()
		try client.handshake()
		try await serving
		return Loopback{client: client, server: server, listener: ln}
	}

	// exchange sends one request with the body and returns the response
	// fields, body and trailers.
	internal def exchange(c Conn, path string, body byte[]) !(HeaderField[], byte[], HeaderField[]) {
		let s = try c.newStream()
		s.deadline = time.now() + 10s
		let request = [HeaderField{name:":method", value:body.len() == 0 ?? ("GET", "POST")}, HeaderField{name:":scheme", value:"http"}, HeaderField{name:":path", value:path}, HeaderField{name:":authority", value:"test"}]
		if body.len() == 0 {
			try s.writeHeaders(request, true)
		} else {
			try s.writeHeaders(request, false)
			try s.write(body)
			try s.end()
		}
		let fields = try s.readHeaders()
		let data = try s.readAll()
		return (fields, data, s.trailers)
	}

	// Finished lists the streams whose response was read to the end, in
	// order.
	internal type Finished {
		paths string[] = []

		def new() {}

		atomic def add(path string) {
			paths.push(path)
		}
	}

	// The body every stream of the scheduling test is answered with.
	internal const scheduledBodySize = 3 * 1024 * 1024

	// largeBody answers any request with `scheduledBodySize` zero bytes.
	internal def largeBody(s Stream) !none {
		try s.readHeaders()
		let body byte[]
		body.len(scheduledBodySize)
		try s.writeHeaders([HeaderField{name:":status", value:"200"}], false)
		try s.write(body)
		return try s.end()
	}

	// drain reads a stream's response to its end, notes it in `finished`
	// and returns the body length, -1 on a failure.
	internal async def drain(s Stream, path string, finished Finished) int {
		let failed = false
		s.readHeaders() onerror (err error) {
			failed = true
			recover []
		}
		return -1 when failed
		let body = s.readAll() onerror (err error) {
			failed = true
			recover []
		}
		finished.add(path)
		return failed ?? (-1, body.len())
	}

	// Progress counts the body bytes read per stream and keeps, from the
	// moment the first stream ends, the least any other had by then.
	internal type Progress {
		counts int[] = []
		least  int   = -1

		def new(streams int) {
			counts.len(streams)
		}

		atomic def add(index int, n int) {
			counts[index] += n
		}

		atomic def ended(index int) {
			return unless least < 0
			for let (i, count) in counts {
				continue when i == index
				least = count when least < 0 || count < least
			}
		}
	}

	// drainCounting reads a stream's response to its end through
	// `progress` and returns the body length, -1 on a failure.
	internal async def drainCounting(s Stream, index int, progress Progress) int {
		let failed = false
		s.readHeaders() onerror (err error) {
			failed = true
			recover []
		}
		return -1 when failed
		let buf byte[]
		buf.len(32 * 1024)
		let total = 0
		for {
			let n = s.read(buf) onerror (err error) {
				failed = true
				recover 0
			}
			break when n == 0
			total += n
			progress.add(index, n)
		}
		progress.ended(index)
		return failed ?? (-1, total)
	}

	// requestAll opens `count` GET streams with the `priority` value and
	// returns them once the server has had time to take them all.
	internal def requestAll(c Conn, count int, priority string) !Stream[] {
		let streams Stream[] = []
		for let i = 0; i < count; i++ {
			let s = try c.newStream()
			s.deadline = time.now() + 30s
			try s.writeHeaders([HeaderField{name:":method", value:"GET"}, HeaderField{name:":scheme", value:"http"}, HeaderField{name:":path", value:"/r{i}"}, HeaderField{name:":authority", value:"test"}, HeaderField{name:"priority", value:priority}], true)
			streams.push(s)
		}
		time.sleep(100ms)
		return streams
	}

	check "HTTP/2 connection" {
		@test()
		def sendsWholeResponsesInRequestOrder() !none {
			// Four responses of one urgency, none incremental: each goes
			// out whole before the request after it (RFC 9218 §10).
			let finished = new Finished()
			let lb = try loopback(largeBody)
			let streams = try requestAll(lb.client, 4, "u=3")
			let reads array<async int> = []
			for let (i, s) in streams {
				reads.push(drain(s, "/r{i}", finished))
			}
			for let (_, task) in reads {
				assert (await task) == scheduledBodySize
			}
			assert finished.paths.join(" ") == "/r0 /r1 /r2 /r3"
			lb.close()
			return none
		}

		@test()
		def sharesTheConnectionAmongIncrementalStreams() !none {
			// Four incremental responses of one urgency take turns: when
			// the first one ends, every other is most of the way there.
			let progress = new Progress(4)
			let lb = try loopback(largeBody)
			let streams = try requestAll(lb.client, 4, "u=3, i")
			let reads array<async int> = []
			for let (i, s) in streams {
				reads.push(drainCounting(s, i, progress))
			}
			for let (_, task) in reads {
				assert (await task) == scheduledBodySize
			}
			fail "slowest stream had {progress.least} bytes when the first ended" unless progress.least >= scheduledBodySize / 2
			lb.close()
			return none
		}

		@test()
		def sendsUrgentStreamsFirst() !none {
			let (parsedUrgency, parsedIncremental) = priorityOf("u=1, i")
			assert parsedUrgency == 1 && parsedIncremental
			// Eight streams of a 1 MiB window each against a 4 MiB connection
			// window: the connection window is what they compete for. The
			// urgent request arrives last and its response must still be
			// the first one complete.
			let finished = new Finished()
			let lb = try loopback(largeBody)
			let streams Stream[] = []
			let paths string[] = []
			for let i = 0; i < 8; i++ {
				let s = try lb.client.newStream()
				s.deadline = time.now() + 30s
				let path = i == 7 ?? ("/urgent", "/background{i}")
				let request = [HeaderField{name:":method", value:"GET"}, HeaderField{name:":scheme", value:"http"}, HeaderField{name:":path", value:path}, HeaderField{name:":authority", value:"test"}, HeaderField{name:"priority", value:i == 7 ?? ("u=0", "u=7")}]
				try s.writeHeaders(request, true)
				streams.push(s)
				paths.push(path)
			}
			// The server has every request and a full connection window
			// before a byte is read here.
			time.sleep(100ms)
			let reads array<async int> = []
			for let (i, s) in streams {
				reads.push(drain(s, paths[i], finished))
			}
			for let (_, task) in reads {
				assert (await task) == scheduledBodySize
			}
			fail "finished in the order {finished.paths.join(" ")}" unless finished.paths.len() == 8 && finished.paths[0] == "/urgent"
			lb.close()
			return none
		}

		@test()
		def takesPriorityUpdates() !none {
			// The handler waits for the update, then answers with what the
			// stream recorded.
			let lb = try loopback(def (s Stream) !none {
				for let i = 0; i < 500 && s.priorityUpdate == ""; i++ {
					time.sleep(2ms)
				}
				return try s.writeHeaders([HeaderField{name:":status", value:"200"}, HeaderField{name:"x-priority", value:s.priorityUpdate}], true)
			})
			let s = try lb.client.newStream()
			s.deadline = time.now() + 10s
			// Before the headers went out the stream has no identifier.
			let early = "sent"
			s.updatePriority("u=1") onerror (err error) {
				early = "refused"
				recover none
			}
			assert early == "refused"
			try s.writeHeaders([HeaderField{name:":method", value:"GET"}, HeaderField{name:":scheme", value:"http"}, HeaderField{name:":path", value:"/"}, HeaderField{name:":authority", value:"test"}], true)
			try s.updatePriority("u=1, i")
			let fields = try s.readHeaders()
			assert valueOf(fields, "x-priority") == "u=1, i"
			// An update for a stream that is gone is dropped.
			try lb.client.framer.writePriorityUpdate(99, "u=7")
			let rtt = try lb.client.ping()
			assert rtt >= 0s

			// A server may not send one: the client fails the connection.
			try lb.server.framer.writePriorityUpdate(1, "u=0")
			for let i = 0; i < 500 && lb.client.isUsable(); i++ {
				time.sleep(2ms)
			}
			assert !lb.client.isUsable()
			lb.close()
			return none
		}

		@test()
		def exchangesRequestsOverOneConnection() !none {
			let lb = try loopback(echoStream)
			let (fields, body, _) = try exchange(lb.client, "/ping", [])
			assert valueOf(fields, ":status") == "200"
			assert valueOf(fields, "x-method") == "GET" && valueOf(fields, "x-path") == "/ping"
			assert body.len() == 0
			let (echoed, data, trailers) = try exchange(lb.client, "/echo", "hello h2".bytes())
			assert valueOf(echoed, "x-method") == "POST"
			assert string(data) == "hello h2"
			assert valueOf(trailers, "x-size") == "8"
			assert lb.client.activeStreams() == 0 && lb.server.activeStreams() == 0
			assert lb.client.settingsAcked && lb.server.settingsAcked
			let rtt = try lb.client.ping()
			assert rtt >= 0s
			lb.close()
			return none
		}

		@test()
		def multiplexesStreams() !none {
			let lb = try loopback(echoStream)
			let tasks (async !(HeaderField[], byte[], HeaderField[]))[]
			for let i = 0; i < 20; i++ {
				tasks.push(async exchange(lb.client, "/s" + i.str(), ("payload " + i.str()).bytes()))
			}
			for let i = 0; i < tasks.len(); i++ {
				let (fields, data, _) = try await tasks[i]
				assert valueOf(fields, "x-path") == "/s" + i.str()
				assert string(data) == "payload " + i.str()
			}
			assert lb.client.activeStreams() == 0
			lb.close()
			return none
		}

		@test()
		def streamsLargeBodiesThroughFlowControl() !none {
			let lb = try loopback(echoStream)
			let big byte[]
			big.len(3 * 1024 * 1024)
			for let i = 0; i < big.len(); i += 4096 {
				big[i] = byte(i / 4096)
			}
			let (fields, data, trailers) = try exchange(lb.client, "/big", big)
			assert valueOf(fields, ":status") == "200"
			assert data.len() == big.len()
			assert data[4096 * 100] == big[4096 * 100]
			assert valueOf(trailers, "x-size") == big.len().str()
			lb.close()
			return none
		}

		@test()
		def creditsBodiesNobodyRead() !none {
			// More unread DATA than the connection window holds: every
			// dropped body has to come back to it.
			let lb = try loopback(def (s Stream) !none {
				try s.readHeaders()
				let limit = time.now() + 5s
				for !s.endReceived && time.now().before(limit) {
					time.sleep(1ms)
				}
				try s.writeHeaders([HeaderField{name:":status", value:"204"}], true)
				return try s.reset(ErrorCode.NoError)
			})
			let body byte[]
			body.len(512 * 1024)
			for let i = 0; i < 10; i++ {
				let (fields, _, _) = try exchange(lb.client, "/drop", body)
				assert valueOf(fields, ":status") == "204"
			}
			lb.close()
			return none
		}

		@test()
		def upgradeIsForAServerNotYetStarted() !none {
			let lb = try loopback(echoStream)
			let codes string[] = []
			lb.client.upgrade([], []) onerror (err error) {
				codes.push(err.code)
				recover none
			}
			lb.server.upgrade([], []) onerror (err error) {
				codes.push(err.code)
				recover none
			}
			assert codes.len() == 2
			lb.close()
			return none
		}

		@test()
		def refusesStreamsAfterGoAwayAndResets() !none {
			let lb = try loopback(def (s Stream) !none {
				try s.readHeaders()
				return try s.reset(ErrorCode.RefusedStream)
			})
			let s = try lb.client.newStream()
			s.deadline = time.now() + 5s
			try s.writeHeaders([HeaderField{name:":method", value:"GET"}, HeaderField{name:":scheme", value:"http"}, HeaderField{name:":path", value:"/"}], true)
			let reset = s.readHeaders()
			assert reset is error
			let err = s.failure
			assert !(err is none) && err.errorCode == ErrorCode.RefusedStream
			try lb.server.goAway()
			time.sleep(50ms)
			assert lb.client.goAwayReceived
			assert !lb.client.isUsable()
			assert lb.client.newStream() is error
			lb.close()
			return none
		}

		@test()
		def closesAnIdleConnection() !none {
			let lb = try loopback(echoStream, 150ms)
			let (first, _, _) = try exchange(lb.client, "/one", [])
			assert valueOf(first, ":status") == "200"
			// A stream within the timeout starts the wait again.
			time.sleep(100ms)
			let (second, _, _) = try exchange(lb.client, "/two", [])
			assert valueOf(second, ":status") == "200"
			time.sleep(100ms)
			assert !lb.client.closed
			let limit = time.now() + 2s
			for !lb.client.closed && time.now().before(limit) {
				time.sleep(10ms)
			}
			assert lb.client.closed
			assert lb.client.goAwaySent
			let code = ErrorCode.NoError
			lb.client.newStream() onerror (err error) {
				let h = asHttp2Error(err)
				code = h.errorCode unless h is none
				recover new Stream(lb.client, 0, 0, 0)
			}
			assert code == ErrorCode.RefusedStream
			lb.server.wait()
			assert lb.server.goAwayReceived
			lb.close()
			return none
		}

		@test()
		def pingsAQuietPeerAndDropsAMuteOne() !none {
			// A live peer answers, so silence alone closes nothing.
			let lb = try loopback(echoStream, 0s, 40ms)
			time.sleep(400ms)
			assert !lb.client.closed
			let (fields, _, _) = try exchange(lb.client, "/still", [])
			assert valueOf(fields, ":status") == "200"
			lb.close()

			// A peer that accepts and never speaks.
			let sock = try net.socket(net.SocketDomain.IPv4, net.SocketType.Stream)
			try sock.bind("127.0.0.1:0")
			let ln = try sock.listen(4)
			let accepting = async ln.accept()
			let dialed = try net.dialStream("127.0.0.1:" + ln.address().port.str(), 5s)
			let mute = try await accepting
			let stream = new TimedStream(dialed)
			let client = new Conn(stream, stream, true, stream)
			client.pingInterval = 40ms
			client.pingTimeout = 100ms
			try client.handshake()
			let limit = time.now() + 2s
			for !client.closed && time.now().before(limit) {
				time.sleep(10ms)
			}
			assert client.closed
			let reason = client.closeError
			assert !(reason is none) && reason.message.contains("PING")
			try mute.close()
			try ln.close()
			return none
		}

		@test()
		def waitReturnsOnceTheConnectionCloses() !none {
			let lb = try loopback(echoStream)
			let waiting = async lb.server.wait()
			time.sleep(20ms)
			assert !lb.server.closed
			try lb.client.close()
			await waiting
			assert lb.server.closed
			// A second wait on a closed connection returns at once.
			lb.server.wait()
			lb.close()
			return none
		}
	}
}
