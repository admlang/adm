partial module std.net.http.http2 {
	use (
		std.bytes
		std.testing
	)

	// loop is a framer writing into and reading back from one buffer.
	internal def loop() (Framer, bytes.Buffer) {
		let buf = new bytes.Buffer()
		return (new Framer(buf, buf), buf)
	}

	internal def http2ErrorOf(err error) ?Http2Error {
		return err when err is Http2Error
		return none
	}

	// failsWith reports whether reading the next frame fails with the code
	// on the stream given (0 for a connection error).
	internal def failsWith(f Framer, code ErrorCode, streamID int) bool {
		let seen ?Http2Error = none
		f.readFrame() onerror (err error) {
			seen = http2ErrorOf(err)
			recover new Frame(FrameType.Unknown, 0)
		}
		return false when seen is none
		return seen.errorCode == code && seen.streamID == streamID
	}

	check "HTTP/2 frames" {
		@test()
		def roundTripsEveryType() !none {
			let (f, buf) = loop()
			try f.writeSettings([Setting{id:int(SettingID.MaxFrameSize), value:32768}, Setting{id:int(SettingID.EnablePush), value:0}])
			try f.writeSettingsAck()
			try f.writeHeaders(1, false, "hdr".bytes(), Priority{streamDependency: 0, exclusive: true, weight: 16})
			try f.writeData(1, true, "body".bytes(), 3)
			try f.writePriority(3, Priority{streamDependency: 1, exclusive: false, weight: 256})
			try f.writeRstStream(3, ErrorCode.Cancel)
			try f.writePing(false, "12345678".bytes())
			try f.writePing(true, "1234".bytes())
			try f.writeWindowUpdate(0, 65535)
			try f.writePushPromise(1, 2, "promise".bytes())
			try f.writeGoAway(7, ErrorCode.EnhanceYourCalm, "slow down".bytes())
			try f.writeFrame(FrameType.Unknown, 0, 0, "x".bytes())
			assert f.framesWritten == 12

			let settings = try f.readFrame()
			assert settings.kind == FrameType.Settings && !settings.ack()
			assert settings.settings.len() == 2 && settings.settings[0].id == 5 && settings.settings[0].value == 32768
			let ack = try f.readFrame()
			assert ack.kind == FrameType.Settings && ack.ack() && ack.settings.len() == 0
			let headers = try f.readFrame()
			assert headers.kind == FrameType.Headers && headers.streamID == 1 && !headers.endStream()
			assert string(headers.data) == "hdr"
			let prio = headers.priority
			assert !(prio is none) && prio.exclusive && prio.weight == 16 && prio.streamDependency == 0
			let data = try f.readFrame()
			assert data.kind == FrameType.Data && data.endStream() && string(data.data) == "body"
			assert (data.flags & flagPadded) != 0
			let priority = try f.readFrame()
			assert priority.kind == FrameType.Priority && priority.streamID == 3
			let p = priority.priority
			assert !(p is none) && p.weight == 256 && p.streamDependency == 1 && !p.exclusive
			let rst = try f.readFrame()
			assert rst.kind == FrameType.RstStream && rst.errorCode == ErrorCode.Cancel && rst.streamID == 3
			let ping = try f.readFrame()
			assert ping.kind == FrameType.Ping && !ping.ack() && string(ping.data) == "12345678"
			let pong = try f.readFrame()
			assert pong.ack() && pong.data.len() == 8 && string(pong.data.slice(0, 4)) == "1234" && pong.data[4] == 0
			let window = try f.readFrame()
			assert window.kind == FrameType.WindowUpdate && window.streamID == 0 && window.windowIncrement == 65535
			let promise = try f.readFrame()
			assert promise.kind == FrameType.PushPromise && promise.promisedStreamID == 2 && string(promise.data) == "promise"
			let goaway = try f.readFrame()
			assert goaway.kind == FrameType.GoAway && goaway.lastStreamID == 7 && goaway.errorCode == ErrorCode.EnhanceYourCalm
			assert string(goaway.data) == "slow down"
			let unknown = try f.readFrame()
			assert unknown.kind == FrameType.Unknown && unknown.rawType == 255 && string(unknown.data) == "x"
			assert f.framesRead == 12
			assert f.readFrame() is error
			return none
		}

		@test()
		def splitsAndJoinsHeaderBlocks() !none {
			let (f, buf) = loop()
			f.maxWriteFrameSize = 16
			let block byte[]
			block.len(40)
			for let i = 0; i < 40; i++ {
				block[i] = byte(i)
			}
			try f.writeHeaders(5, true, block)
			// HEADERS with 16, CONTINUATION 16, CONTINUATION 8.
			assert f.framesWritten == 3
			assert buf.len() == 40 + 3 * frameHeaderLen
			let joined = try f.readFrame()
			assert joined.kind == FrameType.Headers && joined.endStream() && (joined.flags & flagEndHeaders) != 0
			assert joined.data.len() == 40 && joined.data[39] == 39
			assert f.framesRead == 3
			// A block over the limit is refused.
			f.maxHeaderBlockBytes = 20
			try f.writeHeaders(7, false, block)
			assert failsWith(f, ErrorCode.EnhanceYourCalm, 0)
			return none
		}

		@test()
		def refusesProtocolViolations() !none {
			let (f, _) = loop()
			// DATA on stream 0.
			try f.writeFrame(FrameType.Data, 0, 0, "x".bytes())
			assert failsWith(f, ErrorCode.ProtocolError, 0)
			// SETTINGS on a stream, and a bad length.
			try f.writeFrame(FrameType.Settings, 1, 0, [])
			assert failsWith(f, ErrorCode.ProtocolError, 0)
			try f.writeFrame(FrameType.Settings, 0, 0, [0, 1, 2])
			assert failsWith(f, ErrorCode.FrameSizeError, 0)
			try f.writeFrame(FrameType.Settings, 0, flagAck, [0, 0, 0, 0, 0, 0])
			assert failsWith(f, ErrorCode.FrameSizeError, 0)
			// INITIAL_WINDOW_SIZE above 2^31-1, MAX_FRAME_SIZE below 2^14.
			try f.writeSettings([Setting{id:4, value:2147483648}])
			assert failsWith(f, ErrorCode.FlowControlError, 0)
			try f.writeSettings([Setting{id:5, value:100}])
			assert failsWith(f, ErrorCode.ProtocolError, 0)
			// Padding beyond the payload.
			try f.writeFrame(FrameType.Data, 1, flagPadded, [9, 1, 2])
			assert failsWith(f, ErrorCode.ProtocolError, 0)
			// PING of the wrong size, WINDOW_UPDATE of zero on a stream and
			// on the connection, RST_STREAM on stream 0.
			try f.writeFrame(FrameType.Ping, 0, 0, [1, 2, 3])
			assert failsWith(f, ErrorCode.FrameSizeError, 0)
			try f.writeFrame(FrameType.WindowUpdate, 3, 0, [0, 0, 0, 0])
			assert failsWith(f, ErrorCode.ProtocolError, 3)
			try f.writeFrame(FrameType.WindowUpdate, 0, 0, [0, 0, 0, 0])
			assert failsWith(f, ErrorCode.ProtocolError, 0)
			try f.writeFrame(FrameType.RstStream, 0, 0, [0, 0, 0, 8])
			assert failsWith(f, ErrorCode.ProtocolError, 0)
			// A stream depending on itself is a stream error.
			try f.writeHeaders(9, false, [], Priority{streamDependency: 9, exclusive: false, weight: 1})
			assert failsWith(f, ErrorCode.ProtocolError, 9)
			try f.writeFrame(FrameType.Priority, 9, 0, [1])
			assert failsWith(f, ErrorCode.FrameSizeError, 9)
			// A CONTINUATION out of the blue, and one on the wrong stream.
			try f.writeFrame(FrameType.Continuation, 1, flagEndHeaders, [])
			assert failsWith(f, ErrorCode.ProtocolError, 0)
			try f.writeFrame(FrameType.Headers, 1, 0, "a".bytes())
			try f.writeFrame(FrameType.Continuation, 3, flagEndHeaders, "b".bytes())
			assert failsWith(f, ErrorCode.ProtocolError, 0)
			// A frame above the read limit; and one the writer refuses.
			f.maxReadFrameSize = 4
			try f.writeFrame(FrameType.Data, 1, 0, "12345".bytes())
			assert failsWith(f, ErrorCode.FrameSizeError, 0)
			f.maxWriteFrameSize = 4
			assert f.writeData(1, false, "12345".bytes()) is error
			return none
		}
	}
}
