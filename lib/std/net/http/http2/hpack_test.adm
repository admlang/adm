partial module std.net.http.http2 {
	use (
		std.data.encoding::(hexdecode, hexencode)
		std.testing
	)

	// unhex decodes the spaced hex of the RFC examples.
	internal def unhex(text string) !byte[] {
		return try hexdecode(text.replace(" ", ""))
	}

	internal def field(name string, value string) HeaderField {
		return HeaderField{name: name, value: value}
	}

	internal def sameFields(got HeaderField[], want HeaderField[]) bool {
		return false unless got.len() == want.len()
		for let i = 0; i < got.len(); i++ {
			return false unless got[i].name == want[i].name && got[i].value == want[i].value
		}
		return true
	}

	check "HPACK" {
		@test()
		def codesIntegers() !none {
			// RFC 7541 C.1
			let out byte[]
			encodeInteger(out, 5, 0, 10)
			assert hexencode(out) == "0a"
			out = []
			encodeInteger(out, 5, 0, 1337)
			assert hexencode(out) == "1f9a0a"
			out = []
			encodeInteger(out, 8, 0, 42)
			assert hexencode(out) == "2a"
			let (v, at) = try decodeInteger(try unhex("1f9a0a"), 0, 5)
			assert v == 1337 && at == 3
			assert decodeInteger(try unhex("1f9a"), 0, 5) is error
			assert decodeInteger(try unhex("1fffffffffff"), 0, 5) is error
			return none
		}

		@test()
		def codesHuffmanStrings() !none {
			// RFC 7541 C.4.1 and C.6.1 strings.
			let www = "www.example.com".bytes()
			assert hexencode(huffmanEncode(www)) == "f1e3c2e5f23a6ba0ab90f4ff"
			assert huffmanEncodedLen(www) == 12
			assert string(try huffmanDecode(try unhex("f1e3c2e5f23a6ba0ab90f4ff"))) == "www.example.com"
			assert hexencode(huffmanEncode("no-cache".bytes())) == "a8eb10649cbf"
			assert hexencode(huffmanEncode("302".bytes())) == "6402"
			let date = "Mon, 21 Oct 2013 20:13:21 GMT".bytes()
			assert hexencode(huffmanEncode(date)) == "d07abe941054d444a8200595040b8166e082a62d1bff"
			assert string(try huffmanDecode(huffmanEncode(date))) == string(date)
			// Every byte round-trips.
			let all byte[]
			for let i = 0; i < 256; i++ {
				all.push(byte(i))
			}
			let back = try huffmanDecode(huffmanEncode(all))
			assert back.len() == 256
			for let i = 0; i < 256; i++ {
				assert back[i] == byte(i)
			}
			// EOS inside a string, and bad padding, are refused.
			assert huffmanDecode(try unhex("ffffffff")) is error
			assert huffmanDecode(try unhex("f1e3c2e5f23a6ba0ab90f4fe")) is error
			return none
		}

		@test()
		def decodesLiteralsOfAppendixC() !none {
			// C.2.1 literal with indexing, C.2.2 without, C.2.3 never
			// indexed, C.2.4 indexed.
			let d = new Decoder()
			let one = try d.decode(try unhex("400a 6375 7374 6f6d 2d6b 6579 0d63 7573 746f 6d2d 6865 6164 6572"))
			assert sameFields(one, [field("custom-key", "custom-header")])
			assert d.table.len() == 1 && d.table.size == 55
			let two = try d.decode(try unhex("040c 2f73 616d 706c 652f 7061 7468"))
			assert sameFields(two, [field(":path", "/sample/path")])
			assert d.table.len() == 1
			let three = try d.decode(try unhex("1008 7061 7373 776f 7264 0673 6563 7265 74"))
			assert sameFields(three, [field("password", "secret")])
			assert three[0].sensitive
			let four = try d.decode(try unhex("82"))
			assert sameFields(four, [field(":method", "GET")])
			return none
		}

		@test()
		def decodesRequestsWithoutHuffman() !none {
			// C.3: three requests on one connection.
			let d = new Decoder()
			let first = try d.decode(try unhex("8286 8441 0f77 7777 2e65 7861 6d70 6c65 2e63 6f6d"))
			assert sameFields(first, [field(":method", "GET"), field(":scheme", "http"), field(":path", "/"), field(":authority", "www.example.com")])
			assert d.table.size == 57
			let second = try d.decode(try unhex("8286 84be 5808 6e6f 2d63 6163 6865"))
			assert sameFields(second, [field(":method", "GET"), field(":scheme", "http"), field(":path", "/"), field(":authority", "www.example.com"), field("cache-control", "no-cache")])
			assert d.table.size == 110
			let third = try d.decode(try unhex("8287 85bf 400a 6375 7374 6f6d 2d6b 6579 0c63 7573 746f 6d2d 7661 6c75 65"))
			assert sameFields(third, [field(":method", "GET"), field(":scheme", "https"), field(":path", "/index.html"), field(":authority", "www.example.com"), field("custom-key", "custom-value")])
			assert d.table.size == 164 && d.table.len() == 3
			return none
		}

		@test()
		def encodesAndDecodesRequestsWithHuffman() !none {
			// C.4: the same requests Huffman-coded, from the encoder.
			let e = new Encoder()
			let d = new Decoder()
			let first = [field(":method", "GET"), field(":scheme", "http"), field(":path", "/"), field(":authority", "www.example.com")]
			let block = e.encode(first)
			assert hexencode(block) == "828684418cf1e3c2e5f23a6ba0ab90f4ff"
			assert sameFields(try d.decode(block), first)
			let second = first + [field("cache-control", "no-cache")]
			block = e.encode(second)
			assert hexencode(block) == "828684be5886a8eb10649cbf"
			assert sameFields(try d.decode(block), second)
			let third = [field(":method", "GET"), field(":scheme", "https"), field(":path", "/index.html"), field(":authority", "www.example.com"), field("custom-key", "custom-value")]
			block = e.encode(third)
			assert hexencode(block) == "828785bf408825a849e95ba97d7f8925a849e95bb8e8b4bf"
			assert sameFields(try d.decode(block), third)
			assert e.table.size == 164 && d.table.size == 164
			return none
		}

		@test()
		def evictsWithinASmallTable() !none {
			// C.6: responses with a 256-byte table, Huffman-coded.
			let e = new Encoder()
			e.table.resize(256)
			let d = new Decoder()
			d.table.resize(256)
			let first = [field(":status", "302"), field("cache-control", "private"), field("date", "Mon, 21 Oct 2013 20:13:21 GMT"), field("location", "https://www.example.com")]
			let block = e.encode(first)
			assert hexencode(block) == "488264025885aec3771a4b6196d07abe941054d444a8200595040b8166e082a62d1bff6e919d29ad171863c78f0b97c8e9ae82ae43d3"
			assert sameFields(try d.decode(block), first)
			assert e.table.size == 222 && d.table.size == 222
			let second = [field(":status", "307"), field("cache-control", "private"), field("date", "Mon, 21 Oct 2013 20:13:21 GMT"), field("location", "https://www.example.com")]
			block = e.encode(second)
			assert hexencode(block) == "4883640effc1c0bf"
			assert sameFields(try d.decode(block), second)
			assert e.table.size == 222 && d.table.len() == 4
			let third = [field(":status", "200"), field("cache-control", "private"), field("date", "Mon, 21 Oct 2013 20:13:22 GMT"), field("location", "https://www.example.com"), field("content-encoding", "gzip"), field("set-cookie", "foo=ASDJKHQKBZXOQWEOPIUAXQWEOIU; max-age=3600; version=1")]
			block = e.encode(third)
			assert hexencode(block) == "88c16196d07abe941054d444a8200595040b8166e084a62d1bffc05a839bd9ab77ad94e7821dd7f2e6c7b335dfdfcd5b3960d5af27087f3672c1ab270fb5291f9587316065c003ed4ee5b1063d5007"
			assert sameFields(try d.decode(block), third)
			assert e.table.size == 215 && d.table.size == 215 && d.table.len() == 3
			return none
		}

		@test()
		def announcesTableSizeChanges() !none {
			let e = new Encoder()
			let d = new Decoder()
			e.applyPeerTableSize(0)
			let block = e.encode([field("x-a", "1")])
			// A size update to 0 first, then a literal that indexes nothing.
			assert block[0] == 0x20
			assert sameFields(try d.decode(block), [field("x-a", "1")])
			assert d.table.maxSize == 0 && d.table.len() == 0 && e.table.len() == 0
			// A decoder refuses an update above what it announced.
			let strict = new Decoder()
			strict.announceTableSize(100)
			assert strict.decode(try unhex("3fe11f")) is error
			// Sensitive fields are never indexed.
			e.applyPeerTableSize(4096)
			let secret = HeaderField{name: "authorization", value: "Bearer x", sensitive: true}
			block = e.encode([secret])
			// The size update back to 4096 (`3f e1 1f`) comes first.
			assert hexencode(block.slice(0, 3)) == "3fe11f"
			assert (block[3] & 0xf0) == 0x10
			let got = try d.decode(block)
			assert got[0].sensitive && got[0].value == "Bearer x"
			assert d.table.len() == 0
			// Bad blocks.
			assert d.decode(try unhex("80")) is error
			assert d.decode(try unhex("ff7f")) is error
			assert d.decode(try unhex("400a63")) is error
			return none
		}
	}
}
