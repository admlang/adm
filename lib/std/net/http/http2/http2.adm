// std.net.http.http2 speaks HTTP/2 (RFC 9113) with HPACK header
// compression (RFC 7541): the frame codec (`Framer`), the header codec
// (`Encoder`, `Decoder`), flow-control windows, and the multiplexed
// client and server connections `std.net.http` runs over TLS when ALPN
// picks `h2`, or in the clear as `h2c`. Applications reach it through
// `http.Client` and `http.Server`; only a proxy or a test opens a
// connection here directly.

partial module std.net.http.http2 {
	use (
		std.errors
	)

	// The 24 bytes a client sends first on every connection.
	const clientPreface = "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n"

	// The largest frame payload before SETTINGS says otherwise (§4.2).
	const defaultMaxFrameSize = 16384
	// The largest payload SETTINGS_MAX_FRAME_SIZE may allow (§6.5.2).
	const maxAllowedFrameSize = 16777215
	// The flow-control window every stream and the connection start with (§6.9.2).
	const defaultInitialWindowSize = 65535
	// The largest window a WINDOW_UPDATE may reach, 2^31-1 (§6.9.1).
	const maxWindowSize = 2147483647
	// The HPACK dynamic table size before SETTINGS says otherwise (§6.5.2).
	const defaultHeaderTableSize = 4096
	// The last stream identifier, 2^31-1 (§5.1.1).
	const maxStreamID = 2147483647

	// ErrorCode is the code of a RST_STREAM or GOAWAY frame (§7).
	enum ErrorCode {
		NoError = 0,
		ProtocolError = 1,
		InternalError = 2,
		FlowControlError = 3,
		SettingsTimeout = 4,
		StreamClosed = 5,
		FrameSizeError = 6,
		RefusedStream = 7,
		Cancel = 8,
		CompressionError = 9,
		ConnectError = 10,
		EnhanceYourCalm = 11,
		InadequateSecurity = 12,
		Http11Required = 13,
	}

	// FrameType is the type field of a frame header (§6).
	enum FrameType {
		Data = 0,
		Headers = 1,
		Priority = 2,
		RstStream = 3,
		Settings = 4,
		PushPromise = 5,
		Ping = 6,
		GoAway = 7,
		WindowUpdate = 8,
		Continuation = 9,
		// A client's new priority for a request in flight (RFC 9218 §7.1).
		PriorityUpdate = 16,
		// A type this side does not know; ignored (§4.1).
		Unknown = 255,
	}

	// SettingID is the identifier of a SETTINGS parameter (§6.5.2).
	enum SettingID {
		HeaderTableSize = 1,
		EnablePush = 2,
		MaxConcurrentStreams = 3,
		InitialWindowSize = 4,
		MaxFrameSize = 5,
		MaxHeaderListSize = 6,
		// 1 says the sender ignores RFC 7540 stream priorities (RFC 9218
		// §2.1).
		NoRFC7540Priorities = 9,
	}

	// Setting is one SETTINGS parameter; an unknown id is carried
	// through as its number and ignored.
	struct Setting {
		id    int
		value int
	}

	// Http2Error is the payload of every failure here: a connection
	// error (`streamID` 0, the connection goes away with `errorCode`) or
	// a stream error (that stream is reset with it).
	struct Http2Error {
		message   string
		code      string            = "http2"
		cause     ?error
		stack     errors.StackTrace
		errorCode ErrorCode         = ErrorCode.ProtocolError
		streamID  int               = 0
	}

	// isConnectionError reports whether the whole connection is at fault.
	def isConnectionError(err Http2Error) bool {
		return err.streamID == 0
	}

	// connError builds a connection error.
	def connError(code ErrorCode, message string) Http2Error {
		return Http2Error{message: "http2: {message}", errorCode: code}
	}

	// streamError builds an error that resets one stream.
	def streamError(streamID int, code ErrorCode, message string) Http2Error {
		return Http2Error{message: "http2: stream {streamID}: {message}", errorCode: code, streamID: streamID}
	}

	// errorCodeName is the RFC name of a code, for logs and GOAWAY debug
	// data.
	def errorCodeName(code ErrorCode) string {
		match code {
			case ErrorCode.NoError:
				return "NO_ERROR"
			case ErrorCode.ProtocolError:
				return "PROTOCOL_ERROR"
			case ErrorCode.InternalError:
				return "INTERNAL_ERROR"
			case ErrorCode.FlowControlError:
				return "FLOW_CONTROL_ERROR"
			case ErrorCode.SettingsTimeout:
				return "SETTINGS_TIMEOUT"
			case ErrorCode.StreamClosed:
				return "STREAM_CLOSED"
			case ErrorCode.FrameSizeError:
				return "FRAME_SIZE_ERROR"
			case ErrorCode.RefusedStream:
				return "REFUSED_STREAM"
			case ErrorCode.Cancel:
				return "CANCEL"
			case ErrorCode.CompressionError:
				return "COMPRESSION_ERROR"
			case ErrorCode.ConnectError:
				return "CONNECT_ERROR"
			case ErrorCode.EnhanceYourCalm:
				return "ENHANCE_YOUR_CALM"
			case ErrorCode.InadequateSecurity:
				return "INADEQUATE_SECURITY"
			case ErrorCode.Http11Required:
				return "HTTP_1_1_REQUIRED"
		}
	}

	// errorCodeOf is the enum value of a wire code; an unknown code
	// reads as InternalError, as §7 directs.
	def errorCodeOf(wire int) ErrorCode {
		match wire {
			case 0:
				return ErrorCode.NoError
			case 1:
				return ErrorCode.ProtocolError
			case 2:
				return ErrorCode.InternalError
			case 3:
				return ErrorCode.FlowControlError
			case 4:
				return ErrorCode.SettingsTimeout
			case 5:
				return ErrorCode.StreamClosed
			case 6:
				return ErrorCode.FrameSizeError
			case 7:
				return ErrorCode.RefusedStream
			case 8:
				return ErrorCode.Cancel
			case 9:
				return ErrorCode.CompressionError
			case 10:
				return ErrorCode.ConnectError
			case 11:
				return ErrorCode.EnhanceYourCalm
			case 12:
				return ErrorCode.InadequateSecurity
			case 13:
				return ErrorCode.Http11Required
			default:
				return ErrorCode.InternalError
		}
	}
}
