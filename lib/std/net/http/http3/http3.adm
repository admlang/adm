// The HTTP/3 protocol layer (RFC 9114) over std.net.quic: connection
// setup, frames, QPACK and request streams. It knows nothing of
// std.net.http's messages; `std.net.http` bridges the two.
partial module std.net.http.http3 {
	use std.errors

	// The application protocol name HTTP/3 negotiates in TLS.
	const alpn = "h3"

	// ErrorCode is an HTTP/3 or QPACK error code (RFC 9114 §8.1, RFC
	// 9204 §6).
	enum ErrorCode {
		NoError = 0x100,
		GeneralProtocolError = 0x101,
		InternalError = 0x102,
		StreamCreationError = 0x103,
		ClosedCriticalStream = 0x104,
		FrameUnexpected = 0x105,
		FrameError = 0x106,
		ExcessiveLoad = 0x107,
		IdError = 0x108,
		SettingsError = 0x109,
		MissingSettings = 0x10a,
		RequestRejected = 0x10b,
		RequestCancelled = 0x10c,
		RequestIncomplete = 0x10d,
		MessageError = 0x10e,
		ConnectError = 0x10f,
		VersionFallback = 0x110,
		QpackDecompression = 0x200,
		QpackEncoderStream = 0x201,
		QpackDecoderStream = 0x202,
	}

	// Http3Error is the payload of every failure here: a connection
	// error (`streamID` -1, the connection closes with `errorCode`) or a
	// stream error (that stream is reset with it).
	struct Http3Error {
		message   string
		code      string            = "http3"
		cause     ?error
		stack     errors.StackTrace
		errorCode ErrorCode         = ErrorCode.GeneralProtocolError
		streamID  int               = -1
		// True when the peer reported it.
		remote    bool              = false
	}

	// connError builds a connection error.
	internal def connError(code ErrorCode, message string) Http3Error {
		return Http3Error{message: "http3: {message}", errorCode: code}
	}

	// streamError builds a stream error.
	internal def streamError(streamID int, code ErrorCode, message string) Http3Error {
		return Http3Error{message: "http3: {message}", errorCode: code, streamID: streamID}
	}

	// errorCodeOf maps a code from the wire to its ErrorCode; unknown
	// codes read as NoError (RFC 9114 §9).
	internal def errorCodeOf(code int) ErrorCode {
		for let known in [ErrorCode.NoError, ErrorCode.GeneralProtocolError, ErrorCode.InternalError, ErrorCode.StreamCreationError, ErrorCode.ClosedCriticalStream, ErrorCode.FrameUnexpected, ErrorCode.FrameError, ErrorCode.ExcessiveLoad, ErrorCode.IdError, ErrorCode.SettingsError, ErrorCode.MissingSettings, ErrorCode.RequestRejected, ErrorCode.RequestCancelled, ErrorCode.RequestIncomplete, ErrorCode.MessageError, ErrorCode.ConnectError, ErrorCode.VersionFallback, ErrorCode.QpackDecompression, ErrorCode.QpackEncoderStream, ErrorCode.QpackDecoderStream] {
			return known when known.value == code
		}
		return ErrorCode.NoError
	}
}
