partial module std.net.http.http3 {
	use (
		std.data.encoding::(hexencode, hexdecode)
		std.net.http.http2::(HeaderField)
		std.testing
	)

	// render is a field list as "name=value" lines.
	internal def render(fields HeaderField[]) string {
		let out string[] = []
		for let f in fields {
			out.push(f.name + "=" + f.value)
		}
		return out.join("\n")
	}

	internal def decodeOrNone(d Decoder, streamID int, block string) !string {
		let fields = try d.decode(streamID, try hexdecode(block))
		return "blocked" when fields is none
		return render(fields)
	}

	internal def decodeFailure(d Decoder, block string) string {
		let seen = ""
		decodeOrNone(d, 0, block) onerror (err error) {
			seen = err is Http3Error ?? ("{err.errorCode}", err.message)
			recover ""
		}
		return seen
	}

	check "QPACK" {
		// Sections and encoder stream bytes produced by ls-qpack.
		@test()
		def decodesWhatLsQpackWrote() !none {
			let d = new Decoder(4096, 16)
			try d.feedEncoderStream(try hexdecode("3fe11f"))
			assert d.table.capacity == 4096
			let first = try decodeOrNone(d, 0, "0000d1d750882f91d35d055c87a7518860d5485f2bce9a685f50891c94ac92a12c05707fdd")
			assert first == ":method=GET\n:scheme=https\n:authority=example.com\n:path=/index.html\nuser-agent=adm-test/1.0\naccept=*/*"
			assert d.takeOutput().len() == 0

			// The second section needs two inserts that have not arrived.
			let second = "0381d1d71051876109f54157221111dd2ef2b12d424f4f8b41e92a9dc745a55272d85f"
			assert (try decodeOrNone(d, 4, second)) == "blocked"
			// Half an instruction changes nothing.
			try d.feedEncoderStream(try hexdecode("c0882f91d35d"))
			assert d.table.inserted() == 0
			try d.feedEncoderStream(try hexdecode("055c87a7ff20891c94ac92a12c05707f"))
			assert d.table.inserted() == 2
			assert (try decodeOrNone(d, 4, second)) == ":method=GET\n:scheme=https\n:authority=example.com\n:path=/style.css\nuser-agent=adm-test/1.0\naccept=*/*\nx-custom=some value here"
			// An insert count increment of 2, then the acknowledgment of
			// stream 4.
			assert hexencode(d.takeOutput()) == "0284"

			try d.feedEncoderStream(try hexdecode("66f2b12d424f4f8b41e92a9dc745a55272d85f"))
			assert (try decodeOrNone(d, 8, "0480d9f41010")) == ":status=200\ncontent-type=text/html; charset=utf-8\nx-custom=some value here\nx-custom=some value here"
			assert hexencode(d.takeOutput()) == "0188"
			return none
		}

		@test()
		def encoderAndDecoderAgree() !none {
			let e = new Encoder()
			let d = new Decoder(4096, 16)
			e.applySettings(4096)
			let request = [HeaderField{name:":method", value:"POST"}, HeaderField{name:":scheme", value:"https"}, HeaderField{name:":authority", value:"api.example.com"}, HeaderField{name:":path", value:"/v1/things?page=2"}, HeaderField{name:"content-type", value:"application/json"}, HeaderField{name:"authorization", value:"Bearer secret-token"}, HeaderField{name:"x-request-id", value:"ÿ binary-ish é"}, HeaderField{name:"accept-encoding", value:"gzip, deflate, br"}]
			let first = e.encode(request)
			// Nothing is acknowledged yet: no dynamic reference.
			assert first[0] == 0x00 && first[1] == 0x00
			try d.feedEncoderStream(e.takeOutput())
			let decoded = try d.decode(0, first)
			assert !(decoded is none) && render(decoded) == render(request)
			// The secret never enters the table.
			for let entry in d.table.entries {
				assert entry.name != "authorization"
			}
			assert d.table.inserted() > 0
			try e.feedDecoderStream(d.takeOutput())
			assert e.knownReceived == d.table.inserted()

			// The same request now rides the dynamic table and is shorter.
			let second = e.encode(request)
			assert second.len() < first.len() / 2
			assert second[0] != 0x00
			let again = try d.decode(4, second)
			assert !(again is none) && render(again) == render(request)
			assert hexencode(d.takeOutput()) == "84"

			// A peer that allows no dynamic table gets literals only.
			let plain = new Encoder()
			plain.applySettings(0)
			let section = plain.encode(request)
			assert plain.takeOutput().len() == 0
			let strict = new Decoder(0, 0)
			let literal = try strict.decode(0, section)
			assert !(literal is none) && render(literal) == render(request)
			return none
		}

		@test()
		def rejectsMalformedInput() !none {
			let d = new Decoder(4096, 16)
			// A static index past the table, a dynamic reference with no
			// insert count, a cut section.
			assert decodeFailure(d, "0000ff24") == "QpackDecompression"
			assert decodeFailure(d, "000080") == "QpackDecompression"
			assert decodeFailure(d, "000051") == "QpackDecompression"
			assert decodeFailure(d, "00") == "QpackDecompression"
			let seen = ""
			d.feedEncoderStream(try hexdecode("3fe13f")) onerror (err error) {
				seen = err is Http3Error ?? ("{err.errorCode}", err.message)
				recover none
			}
			assert seen == "QpackEncoderStream"
			let e = new Encoder()
			e.applySettings(4096)
			let wrong = ""
			e.feedDecoderStream([0x05]) onerror (err error) {
				wrong = err is Http3Error ?? ("{err.errorCode}", err.message)
				recover none
			}
			assert wrong == "QpackDecoderStream"
			assert errorCodeOf(0x10c) == ErrorCode.RequestCancelled && errorCodeOf(0x999) == ErrorCode.NoError
			return none
		}

		@test()
		def tableEvictsTheOldest() !none {
			let t = new Table()
			t.resize(120)
			let a = HeaderField{name: "a", value: "0123456789"}
			assert t.fits(a) && !t.fits(HeaderField{name: "long", value: "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890"})
			t.insert(a)
			t.insert(HeaderField{name: "b", value: "0123456789"})
			assert t.inserted() == 2 && t.size == 86
			// A third entry pushes the first out; indexes do not move.
			t.insert(HeaderField{name: "c", value: "0123456789"})
			assert t.inserted() == 3 && t.entries.len() == 2
			assert t.get(0) is none
			let second = t.get(1)
			assert !(second is none) && second.name == "b"
			t.resize(50)
			assert t.entries.len() == 1 && t.dropped == 2

			// A decoder with entries tells the encoder about a stream it
			// gives up on; one without a table has nothing to say.
			let d = new Decoder(4096, 16)
			try d.feedEncoderStream(try hexdecode("3fe11f"))
			d.takeOutput()
			d.cancel(8)
			assert hexencode(d.takeOutput()) == "48"
			let bare = new Decoder(0, 0)
			bare.cancel(8)
			assert bare.takeOutput().len() == 0
			return none
		}
	}
}
