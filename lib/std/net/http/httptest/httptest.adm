// std.net.http.httptest is the test kit for handlers and clients: a
// server on an ephemeral port, a recorder that captures a handler's
// response, and a request builder for the recorder.

module std.net.http.httptest {
	use (
		std.bytes
		std.data.encoding
		std.io
		std.crypto.x509
		std.crypto.x509::(CertPool, Certificate, parseCertificatesPEM)
		std.net
		std.net.http
		std.net.http::(Context, Handler, Request, Response, ResponseWriter, Method)
		std.net.tls
		std.net.url
		std.time
	)

	// A self-signed P-256 certificate for 127.0.0.1, localhost and
	// example.com, valid for a century, from OpenSSL; `startTLS` presents
	// it and the test client trusts it.
	internal const testCertPEM =
		"-----BEGIN CERTIFICATE-----\n" +
		"MIIByzCCAXCgAwIBAgIULZ61fkBLJqpHXo7Dg3TjjURKNKQwCgYIKoZIzj0EAwIw\n" +
		"EzERMA8GA1UEAwwIQURNIHRlc3QwIBcNMjYwOTE2MjEyNDQ4WhgPMjEyNjA4MjMy\n" +
		"MTI0NDhaMBMxETAPBgNVBAMMCEFETSB0ZXN0MFkwEwYHKoZIzj0CAQYIKoZIzj0D\n" +
		"AQcDQgAEWmnKIPFi8/hNfbTouWeJ0sX7jXIK0H2BdAa3ZlChTQUtkRXRuGnkYmY9\n" +
		"c9D2sLIU0D8YtBwSi1XCEXkyARGL3KOBnzCBnDAdBgNVHQ4EFgQUdGEQb1u97o8W\n" +
		"5FkheQ27r3JNU3AwHwYDVR0jBBgwFoAUdGEQb1u97o8W5FkheQ27r3JNU3AwDwYD\n" +
		"VR0TAQH/BAUwAwEB/zAnBgNVHREEIDAegglsb2NhbGhvc3SCC2V4YW1wbGUuY29t\n" +
		"hwR/AAABMAsGA1UdDwQEAwIHgDATBgNVHSUEDDAKBggrBgEFBQcDATAKBggqhkjO\n" +
		"PQQDAgNJADBGAiEA6p+D8so1nzo4nOkB8z0x1Tq+9iG1qIweVo/zTnSHG9cCIQDo\n" +
		"ANw/RkMk5iyYvJf8Qx75u8fY/n2s26d6Clj96iuH/g==\n" +
		"-----END CERTIFICATE-----\n"

	internal const testKeyPEM =
		"-----BEGIN PRIVATE KEY-----\n" +
		"MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgz6zLOlG3plulCC6J\n" +
		"73w4HvDFzW9lrGWy0U1PuM2M1gWhRANCAARaacog8WLz+E19tOi5Z4nSxfuNcgrQ\n" +
		"fYF0BrdmUKFNBS2RFdG4aeRiZj1z0PawshTQPxi0HBKLVcIReTIBEYvc\n" +
		"-----END PRIVATE KEY-----\n"

	// Server runs a handler on a loopback listener with an ephemeral
	// port; `url` is its base. Close it when the suite is done.
	//
	//     let ts = new Server(mux)
	//     try ts.start()
	//     let res = try ts.client().get(ts.url + "/ping")
	//     try ts.close()
	//
	// `startTLS` serves https with a built-in certificate instead, which
	// `client()` trusts; `certificate()` hands it to a client built by
	// hand.
	type Server {
		handler  Handler
		// "http://127.0.0.1:PORT" or "https://…", set by `start` or
		// `startTLS`.
		url      string      = ""
		// Requests served so far.
		requests int         = 0
		// TLS settings of `startTLS`; none after `start`.
		tls      ?tls.Config = none

		internal server   ?http.Server  = none
		internal listener ?net.Listener = none

		def new(handler Handler) {
			self.handler = handler
		}

		// Builds and starts the server in one call.
		// Fails as `start` does.
		def start(handler Handler) !Server {
			let ts = new Server(handler)
			try ts.start()
			return ts
		}

		// Binds a loopback ephemeral port and serves in the background.
		// Fails with NetError when the bind does.
		def start() !none {
			return try launch(none)
		}

		// Like `start` over TLS with the built-in certificate: `url` is
		// https and `client()` trusts the certificate. Fails as `start`
		// does, or with TLSError when the built-in pair does not parse.
		def startTLS() !none {
			return none unless server is none
			return try launch(try builtInConfig())
		}

		// config is the http.Server behind it, for a test that changes its
		// settings (limits, timeouts); none before `start` and after `close`.
		def config() ?http.Server {
			return server
		}

		// The certificate `startTLS` presents; none before it.
		def certificate() ?Certificate {
			return none when tls is none
			let certs = parseCertificatesPEM(testCertPEM) onerror recover []
			return none when certs.len() == 0
			return certs[0]
		}

		internal def launch(config ?tls.Config) !none {
			return none unless server is none
			let sock = try net.socket(net.SocketDomain.IPv4, net.SocketType.Stream)
			sock.setReuseAddr(true) onerror recover none
			try sock.bind("127.0.0.1:0")
			let ln = try sock.listen(64)
			listener = ln
			let bound = ln.address()
			tls = config
			url = (config is none ?? ("http", "https")) + "://127.0.0.1:" + bound.port.str()
			let counted = new http.HandlerFunc(def (ctx Context) !none {
				requests++
				return handler.serve(ctx)
			})
			let srv = new http.Server(bound.str(), counted)
			srv.readHeaderTimeout = 5s
			srv.readTimeout = 10s
			srv.writeTimeout = 10s
			srv.idleTimeout = 5s
			srv.tls = config
			server = srv
			let task = async serveQuietly(srv, ln)
			task.keepAlive()
			return none
		}

		// Runs the server's accept loop; an accept failure ends it.
		internal def serveQuietly(srv http.Server, ln net.Listener) {
			srv.serve(ln) onerror recover none
		}

		// A client whose transport pools nothing, with `url` as base, so
		// `get("/path")` reaches this server and a closed server leaves
		// no dangling connection.
		def client() http.Client {
			let c = new http.Client(url)
			let t = new http.Transport()
			t.disableKeepAlives = true
			let cert = certificate()
			if !(cert is none) {
				let pool = new CertPool()
				pool.addCert(cert)
				t.tls = trustingConfig(pool)
			}
			c.transport = t
			return c
		}

		// The listener's address.
		def address() net.Address {
			let ln = listener
			return new net.Address() when ln is none
			return ln.address()
		}

		// Shuts the server down, waiting for in-flight requests up to a
		// second, and closes the listener, also when the serving task has
		// not taken it yet. A second close does nothing.
		// Fails as `Server.shutdown` does.
		def close() !none {
			let srv = server
			return none when srv is none
			let ln = listener
			server = none
			listener = none
			let failure ?error = none
			srv.shutdown(1s) onerror (err error) {
				failure = err
				recover none
			}
			if !(ln is none) {
				ln.close() onerror recover none
			}
			fail failure unless failure is none
			return none
		}

		// Closes every client connection now, without waiting: for
		// testing how a client handles a dropped connection.
		def closeClientConnections() {
			let srv = server
			srv.closeConnections() unless srv is none
		}
	}

	// builtInConfig is the server config presenting the built-in
	// certificate. Fails when the pair does not parse.
	internal def builtInConfig() !tls.Config {
		let pair = try tls.parseKeyPair(testCertPEM, testKeyPEM)
		return tls.Config{certificates: [pair], alpn: ["h2", "http/1.1"]}
	}

	// trustingConfig is a client TLS config anchored on the pool, with
	// the server name the built-in certificate carries.
	internal def trustingConfig(pool CertPool) tls.Config {
		return tls.Config{serverName: "localhost", rootCAs: pool}
	}

	// ResponseRecorder captures what a handler writes so a suite can
	// assert on it without a socket.
	//
	//     let rec = new ResponseRecorder()
	//     let req = try newRequest(Method.GET, "/users/42")
	//     try mux.serve(rec.context(req))
	//     check rec.status == 200
	//     check rec.text().contains("Ada")
	type ResponseRecorder {
		status    int         = 200
		headers   http.Header
		body      byte[]      = []
		trailer   http.Header
		// True once the handler committed the status and headers.
		committed bool        = false
		// True once the handler called `flush`.
		flushed   bool        = false

		internal sink    ?RecorderSink   = none
		internal active  ?ResponseWriter = none
		internal request ?Request        = none
		internal parsed  bool            = false

		def new() {
			self.headers = new http.Header()
			self.trailer = new http.Header()
		}

		// A `ResponseWriter` for the request whose output lands here;
		// what the handler wrote is available once `serve` returns.
		def writer(req Request) ResponseWriter {
			let collector = new RecorderSink()
			let w = new ResponseWriter(req, collector)
			sink = collector
			active = w
			request = req
			parsed = false
			w.onFinish(def () {capture()})
			return w
		}

		// A `Context` over `writer(req)`, for serving a handler or a mux
		// directly.
		def context(req Request) Context {
			return new Context(req, writer(req))
		}

		// The captured response as a `Response`, body readable, for
		// checks written against the client-side type.
		def result() Response {
			capture()
			let res = new Response()
			res.status = status
			res.reason = http.statusText(status)
			res.headers = headers.clone()
			res.trailer = trailer.clone()
			res.body = new bytes.Reader(body)
			res.contentLength = body.len()
			res.request = request
			return res
		}

		def text() string {
			capture()
			return string(body)
		}

		// Decodes the body as JSON into a new `T`.
		// Fails as `Response.json` does.
		def json<T>() !T {
			capture()
			let value = new T()
			let codec = new encoding.JSON()
			try codec.decode(body, value)
			return value
		}

		def header(name string) string {
			capture()
			return headers.get(name)
		}

		// Parses what the writer produced into the fields, once the
		// response is finished; a writer left open is ended first.
		internal def capture() {
			return when parsed
			let w = active
			return when w is none
			w.end() onerror recover none
			let collector = sink
			return when collector is none
			committed = collector.committed
			let raw = collector.buffer.bytes()
			return when raw.len() == 0
			let req = request
			let probe = req is none ?? (new Request(), req)
			let res = http.readResponse(new bytes.Reader(raw), probe) onerror recover new Response()
			parsed = true
			status = res.status
			headers = res.headers
			committed = true
			flushed = res.headers.hasToken("Transfer-Encoding", "chunked")
			body = res.bytes() onerror recover []
			trailer = res.trailer
		}
	}

	// RecorderSink collects the wire bytes a writer sends.
	internal type RecorderSink {
		buffer    bytes.Buffer
		committed bool         = false

		def new() {
			self.buffer = new bytes.Buffer()
		}

		// Implements io.Writer.
		def write(buf byte[]) !int {
			committed = true
			return buffer.write(buf)
		}
	}

	// The peer a recorder request comes from.
	internal const recorderRemote = "192.0.2.1:1234"

	// newRequest builds a server-side request for a recorder: `target`
	// is a path (`/users?x=1`) or an absolute URL, whose host becomes
	// `req.host`; the body sets `Content-Length`; `remote` is
	// 192.0.2.1:1234, `received` now.
	// Fails as `http.newRequest` does.
	def newRequest(method Method, target string, body ?io.Reader = none) !Request {
		let parsed = url.parseRequest(target) onerror (err error) {
			fail http.HttpError{message: "invalid request target: {target}", op: "httptest", text: target, cause: err}
		}
		let req = new Request()
		req.method = method
		req.url = parsed
		req.host = parsed.host == "" ?? ("example.com", parsed.host)
		req.remote = net.parseAddress(recorderRemote) onerror recover new net.Address()
		req.received = time.now()
		if !(body is none) {
			req.body = body
			req.contentLength = -1
		}
		return req
	}

	def newRequest(method Method, target string, body string) !Request {
		let req = try newRequest(method, target)
		req.replaceBody(body)
		req.headers.set("Content-Length", body.bytes().len().str())
		return req
	}

	// newJSONRequest builds a request with `value` encoded as the body
	// and `Content-Type: application/json`.
	// Fails as `newRequest` does, or when encoding fails.
	def newJSONRequest(method Method, target string, value any) !Request {
		let req = try newRequest(method, target)
		let codec = new encoding.JSON()
		let data = codec.encode(value)
		req.replaceBody(data)
		req.headers.set("Content-Length", data.len().str())
		req.headers.set("Content-Type", "application/json")
		return req
	}
}
