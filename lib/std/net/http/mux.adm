partial module std.net.http {
	// ServeMux routes a request to the handler whose pattern matches it
	// best. Register with `handle` and a pattern, or with the verb
	// helpers; group routes under a prefix with `route`, and wrap a mux
	// or a group in middleware with `apply`. Implements `Handler`.
	//
	//     let mux = new ServeMux()
	//     mux.apply(requestID(), logger())
	//     mux.get("/users/{id}", def (ctx Context) !none {
	//         return ctx.json(try users.find(ctx.param("id")))
	//     })
	//     let api = mux.route("/api/v1")
	//     api.apply(bearerAuth(verify))
	//     api.post("/orders", createOrder)
	//
	// Precedence: the most specific pattern wins; two that neither can
	// beat conflict at registration. A path that matches only with a
	// trailing slash added is redirected (301) to it; a path that needs
	// cleaning (`//`, `..`) is redirected to the clean form. A path that
	// matches a pattern under another method gets 405 with `Allow`;
	// otherwise `notFound`. `HEAD` falls back to `GET`, and `OPTIONS` to
	// an automatic `Allow` reply when nothing registered it.
	//
	// Planned, after the server lands: annotated handlers, so a type
	// marked `@controller("/users")` with methods marked `@get("/{id}")`
	// registers through `mux.controller(instance)`.
	type ServeMux {
		// Redirect `/dir` to `/dir/` when only the latter matches.
		redirectTrailingSlash bool = true
		// Redirect an uncleaned path to its cleaned form.
		redirectCleanPath     bool = true
		// Answer OPTIONS with `Allow` when no pattern handles it.
		autoOptions           bool = true

		internal root                    RoutingNode
		internal patterns                Pattern[]    = []
		internal middleware              Middleware[] = []
		internal notFoundHandler         ?Handler     = none
		internal methodNotAllowedHandler ?Handler     = none
		internal prefix                  string       = ""
		internal parent                  ?ServeMux    = none

		def new() {
			self.root = new RoutingNode()
		}

		// Registers handler for the pattern. A method-less pattern
		// serves every method.
		// Fails with HttpError (op "pattern") when the pattern does not
		// parse, is registered twice, or conflicts with one registered.
		def handle(pattern string, handler Handler) !none {
			let up = parent
			// A group registers on its parent, under its prefix, with a
			// handler that applies the group's middleware when served.
			return try up.handle(prefixPattern(prefix, pattern), new GroupHandler(self, handler)) unless up is none
			let parsed = try parsePattern(pattern)
			for let existing in patterns {
				fail HttpError{message: "pattern {pattern} is already registered", op: "pattern", text: pattern} when existing.text == parsed.text
				fail HttpError{message: "pattern {pattern} conflicts with {existing.text}", op: "pattern", text: pattern} when parsed.conflictsWith(existing)
			}
			let node = root.insert(parsed.segments)
			let route = Route{pattern: parsed, handler: handler}
			if parsed.prefix {
				node.prefixes[parsed.method] = route
			} else {
				node.routes[parsed.method] = route
			}
			patterns.push(parsed)
			return none
		}

		def handle(pattern string, fn def(Context) !none) !none {
			return handle(pattern, new HandlerFunc(fn))
		}

		// The verb helpers register `"GET " + path` and so on. They fail
		// as `handle` does.
		def get(path string, fn def(Context) !none) !none {
			return handle("GET " + path, fn)
		}

		def head(path string, fn def(Context) !none) !none {
			return handle("HEAD " + path, fn)
		}

		def post(path string, fn def(Context) !none) !none {
			return handle("POST " + path, fn)
		}

		def put(path string, fn def(Context) !none) !none {
			return handle("PUT " + path, fn)
		}

		def patch(path string, fn def(Context) !none) !none {
			return handle("PATCH " + path, fn)
		}

		def delete(path string, fn def(Context) !none) !none {
			return handle("DELETE " + path, fn)
		}

		def options(path string, fn def(Context) !none) !none {
			return handle("OPTIONS " + path, fn)
		}

		// Registers the handler for every method on the path.
		def all(path string, fn def(Context) !none) !none {
			return handle(path, fn)
		}

		// Serves a directory of files under a path prefix:
		// `mux.static("/assets/", "./public")`.
		// Fails as `handle` does.
		def static(prefix string, dir string) !none {
			let base = prefix.endsWith("/") ?? (prefix, prefix + "/")
			let strip = base.trimSuffix("/")
			return handle("GET " + base, stripPrefix(strip, new FileServer(dir)))
		}

		// Adds middleware around every handler registered on this mux
		// and its groups, in the order given, outermost first. Middleware
		// added after a route still wraps it: the chain is built when
		// the mux serves.
		def apply(middleware ...Middleware) {
			for let m in middleware {
				self.middleware.push(m)
			}
		}

		def apply(fn def(Context, Handler) !none) {
			apply(new MiddlewareFunc(fn))
		}

		// A group: a mux whose patterns are registered under `prefix`
		// on this one, with its own middleware on top of the parent's.
		// The prefix has no trailing slash (`/api/v1`).
		def route(prefix string) ServeMux {
			let group = new ServeMux()
			group.prefix = prefix.trimSuffix("/")
			group.parent = self
			return group
		}

		// Registers a group built by fn, for the block style:
		//
		//     mux.route("/admin", def (r ServeMux) !none {
		//         r.apply(requireRole("admin"))
		//         return r.get("/stats", stats)
		//     })
		def route(prefix string, fn def(ServeMux) !none) !none {
			return fn(route(prefix))
		}

		// Mounts a whole handler under a prefix, stripping the prefix
		// from the path it sees: another mux, a file server, a proxy.
		// Fails as `handle` does.
		def mount(prefix string, handler Handler) !none {
			let strip = prefix.trimSuffix("/")
			return handle(strip + "/", stripPrefix(strip, handler))
		}

		// Replaces the 404 handler; `notFoundHandler()` by default.
		def notFound(handler Handler) {
			notFoundHandler = handler
		}

		// Replaces the 405 handler; the default sends `Allow` and an
		// empty body.
		def methodNotAllowed(handler Handler) {
			methodNotAllowedHandler = handler
		}

		// Finds the handler for a request without serving it, with the
		// pattern text that matched, "" for a fallback (redirect, 404,
		// 405). The route parameters are set on the request. For tests
		// and for middleware that needs the route before dispatch.
		def handlerFor(req Request) (Handler, string) {
			let method = requestMethodText(req)
			let host = hostOnly(req.host)
			let path = req.url.path
			path = "/" when path == ""
			if redirectCleanPath {
				let cleaned = cleanPath(path)
				return (redirectTo(cleaned, req), "") when cleaned != path
			}
			let found = lookup(method, host, path)
			if !(found is none) {
				let (route, params) = found
				req.params = params
				return (route.handler, route.pattern.text)
			}
			if redirectTrailingSlash && !path.endsWith("/") {
				let withSlash = lookup(method, host, path + "/")
				return (redirectTo(path + "/", req), "") unless withSlash is none
			}
			let allowed = allowedMethods(host, path)
			if allowed.len() > 0 {
				return (allowHandler(allowed, 204), "") when method == "OPTIONS" && autoOptions
				let custom = methodNotAllowedHandler
				return (custom, "") unless custom is none
				return (allowHandler(allowed, 405), "")
			}
			let fallback = notFoundHandler
			return (fallback, "") unless fallback is none
			return (notFoundHandler(), "")
		}

		// The registered patterns in registration order, for a startup
		// route listing.
		def routes() Pattern[] {
			return patterns
		}

		// The handler with this mux's middleware around it, outermost
		// first; a group's routes are served through it.
		def wrapped(h Handler) Handler {
			return wrap(h, ...middleware)
		}

		// Implements Handler: sets `ctx.route` and the parameters, then
		// runs the middleware chain and the handler.
		def serve(ctx Context) !none {
			let (handler, route) = handlerFor(ctx.request)
			ctx.route = route
			return try wrapped(handler).serve(ctx)
		}

		// The best route for the request, with its parameters.
		internal def lookup(method string, host string, path string) ?(Route, map<string, string>) {
			let candidates Route[] = []
			root.collect(splitPath(path), 0, candidates)
			let best ?Route = none
			let bestParams = map<string, string>{}
			for let route in candidates {
				let params = route.pattern.matches(method, host, path)
				continue when params is none
				let current = best
				if current is none || route.pattern.moreSpecificThan(current.pattern) {
					best = route
					bestParams = params
				}
			}
			let winner = best
			return none when winner is none
			return (winner, bestParams)
		}

		// The methods some pattern would accept for the path, for `Allow`.
		internal def allowedMethods(host string, path string) string[] {
			let candidates Route[] = []
			root.collect(splitPath(path), 0, candidates)
			let methods string[] = []
			for let route in candidates {
				let p = route.pattern
				continue when p.matches(p.method, host, path) is none
				if p.method == "" {
					for let m in ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"] {
						methods.push(m) unless methods.includes(m)
					}
					continue
				}
				methods.push(p.method) unless methods.includes(p.method)
				methods.push("HEAD") when p.method == "GET" && !methods.includes("HEAD")
			}
			return methods
		}
	}

	// GroupHandler serves a group's route: the group's middleware around
	// the handler, applied when served so middleware added later counts.
	internal type GroupHandler {
		group ServeMux
		inner Handler

		def new(group ServeMux, inner Handler) {
			self.group = group
			self.inner = inner
		}

		// Implements Handler.
		def serve(ctx Context) !none {
			return try group.wrapped(inner).serve(ctx)
		}
	}

	// prefixPattern puts a group prefix in front of a pattern's path,
	// after its method and host.
	internal def prefixPattern(prefix string, pattern string) string {
		let text = pattern.trim()
		let head = ""
		let sp = text.indexOf(" ")
		if sp >= 0 {
			head = text[:sp + 1]
			text = text[sp + 1:].trim()
		}
		let slash = text.indexOf("/")
		return head + text + prefix when slash < 0
		return head + text[:slash] + prefix + text[slash:]
	}

	// requestMethodText is the method of a request as the router keys
	// it: the enum value, or the raw text for `Other`.
	internal def requestMethodText(req Request) string {
		return req.rawMethod.upper() when req.method == Method.Other && req.rawMethod != ""
		return req.method.value
	}

	// redirectTo answers with a permanent redirect to the path, keeping
	// the query.
	internal def redirectTo(path string, req Request) Handler {
		let target = path
		target = target + "?" + req.url.rawQuery when req.url.rawQuery != ""
		return redirectHandler(target, 301)
	}

	// allowHandler answers with the `Allow` header and the status: 204
	// for an automatic OPTIONS reply, 405 otherwise.
	internal def allowHandler(methods string[], status int) Handler {
		let allow = methods.join(", ")
		return new HandlerFunc(def (ctx Context) !none {
			ctx.setHeader("Allow", allow)
			return ctx.noContent(status) when status == 204
			return ctx.error(status)
		})
	}
}
