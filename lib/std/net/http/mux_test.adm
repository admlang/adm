partial module std.net.http {
	use (
		std.bytes
		std.data.compress.gzip
		std.net
		std.os
		std.testing
		std.time
	)

	// requestFor builds a server request from a request line and headers.
	internal def requestFor(method string, target string, headers string = "") !Request {
		return try readRequest(new bytes.Reader((method + " " + target + " HTTP/1.1\r\nHost: example.com\r\n" + headers + "\r\n").bytes()))
	}

	// serveWith runs the handler over a captured writer and parses what
	// it wrote.
	internal def serveWith(h Handler, req Request) !Response {
		let sink = new bytes.Buffer()
		let ctx = new Context(req, new ResponseWriter(req, sink))
		try h.serve(ctx)
		try ctx.response.end()
		let res = try readResponse(new bytes.Reader(sink.bytes()), req)
		try res.bytes()
		return res
	}

	// served runs the mux for the method and target.
	internal def served(mux ServeMux, method string, target string, headers string = "") !Response {
		return try serveWith(mux, try requestFor(method, target, headers))
	}

	internal def echoRoute() Handler {
		return new HandlerFunc(def (ctx Context) !none {
			return ctx.text(ctx.route + "|" + ctx.param("id") + "|" + ctx.param("rest"))
		})
	}

	internal def patternOf(text string) Pattern {
		return parsePattern(text) onerror recover new Pattern()
	}

	check "HTTP patterns" {
		@test()
		def parsesMethodHostAndSegments() !none {
			let p = try parsePattern("GET example.com/users/\{id\}/files/\{path...\}")
			assert p.method == "GET"
			assert p.host == "example.com"
			assert p.segments.len() == 4
			assert p.segments[1].param
			assert p.segments[3].rest
			assert !p.prefix
			assert p.paramNames().join(",") == "id,path"
			let root = try parsePattern("/")
			assert root.prefix && root.segments.len() == 0
			let dir = try parsePattern("/static/")
			assert dir.prefix && dir.segments.len() == 1
			let exact = try parsePattern("/exact/\{$\}")
			assert !exact.prefix && exact.segments.len() == 1
			return none
		}

		@test()
		def rejectsBadPatterns() {
			assert parsePattern("nope") is error
			assert parsePattern("GET /a/\{x\}/\{x\}") is error
			assert parsePattern("/a/\{rest...\}/b") is error
			assert parsePattern("/a/\{$\}/b") is error
			assert parsePattern("/a/\{1x\}") is error
			assert parsePattern("/a//b") is error
		}

		@test()
		def matchesPaths() {
			let p = patternOf("GET /users/\{id\}")
			let m = p.matches("GET", "h", "/users/42")
			assert !(m is none)
			assert !(p.matches("HEAD", "h", "/users/42") is none)
			assert p.matches("POST", "h", "/users/42") is none
			assert p.matches("GET", "h", "/users/42/") is none
			assert p.matches("GET", "h", "/users") is none
			let rest = patternOf("/files/\{path...\}")
			let r = rest.matches("PUT", "h", "/files/a/b/c")
			assert !(r is none)
			assert rest.matches("GET", "h", "/files") is none
			assert !(rest.matches("GET", "h", "/files/") is none)
			let prefix = patternOf("/static/")
			assert !(prefix.matches("GET", "h", "/static/x.css") is none)
			assert !(prefix.matches("GET", "h", "/static/") is none)
			assert prefix.matches("GET", "h", "/static") is none
			let exact = patternOf("/\{$\}")
			assert !(exact.matches("GET", "h", "/") is none)
			assert exact.matches("GET", "h", "/x") is none
			let host = patternOf("api.example.com/")
			assert !(host.matches("GET", "api.example.com", "/x") is none)
			assert host.matches("GET", "example.com", "/x") is none
		}

		@test()
		def matchedParams() {
			let m = patternOf("GET /users/\{id\}/files/\{path...\}").matches("GET", "h", "/users/7/files/a/b")
			assert !(m is none)
			let found = m
			return when found is none
			assert found["id"] == "7"
			assert found["path"] == "a/b"
		}

		@test()
		def ranksSpecificity() {
			assert patternOf("/a/b").moreSpecificThan(patternOf("/a/\{x\}"))
			assert patternOf("/a/\{x\}").moreSpecificThan(patternOf("/a/\{rest...\}"))
			assert patternOf("GET /a").moreSpecificThan(patternOf("/a"))
			assert patternOf("HEAD /a").moreSpecificThan(patternOf("GET /a"))
			assert patternOf("h.com/a").moreSpecificThan(patternOf("/a"))
			assert patternOf("/a/\{$\}").moreSpecificThan(patternOf("/a/"))
			assert !patternOf("/a/\{x\}").moreSpecificThan(patternOf("/a/b"))
			assert patternOf("/\{x\}/b").conflictsWith(patternOf("/a/\{y\}"))
			assert !patternOf("/a/b").conflictsWith(patternOf("/a/\{y\}"))
			assert !patternOf("GET /a").overlaps(patternOf("POST /a"))
			assert patternOf("GET /a").overlaps(patternOf("HEAD /a"))
			assert !patternOf("/a").overlaps(patternOf("/b"))
		}

		@test()
		def cleansPaths() {
			assert cleanPath("") == "/"
			assert cleanPath("/a//b/../c/./d/") == "/a/c/d/"
			assert cleanPath("/../x") == "/x"
			assert cleanPath("a/b") == "/a/b"
			assert cleanPath("/") == "/"
		}
	}

	check "HTTP mux" {
		@test()
		def routesWithParamsAndRouteText() !none {
			let mux = new ServeMux()
			try mux.handle("GET /users/\{id\}", echoRoute())
			try mux.handle("/files/\{rest...\}", echoRoute())
			let res = try served(mux, "GET", "/users/42")
			assert res.status == 200
			assert (try res.text()) == "GET /users/\{id\}|42|"
			let head = try served(mux, "HEAD", "/users/42")
			assert head.status == 200
			let rest = try served(mux, "POST", "/files/a/b")
			assert (try rest.text()) == "/files/\{rest...\}||a/b"
			return none
		}

		@test()
		def answers404And405WithAllow() !none {
			let mux = new ServeMux()
			try mux.get("/only", def (ctx Context) !none {return ctx.text("ok")})
			let missing = try served(mux, "GET", "/nope")
			assert missing.status == 404
			let wrong = try served(mux, "POST", "/only")
			assert wrong.status == 405
			assert wrong.headers.get("Allow").contains("GET")
			assert wrong.headers.get("Allow").contains("HEAD")
			let options = try served(mux, "OPTIONS", "/only")
			assert options.status == 204
			assert options.headers.get("Allow").contains("GET")
			return none
		}

		@test()
		def redirectsTrailingSlashAndUncleanPaths() !none {
			let mux = new ServeMux()
			try mux.get("/dir/", def (ctx Context) !none {return ctx.text("dir")})
			let res = try served(mux, "GET", "/dir?x=1")
			assert res.status == 301
			assert res.headers.get("Location") == "/dir/?x=1"
			let dirty = try served(mux, "GET", "/a/../dir/")
			assert dirty.status == 301
			assert dirty.headers.get("Location") == "/dir/"
			let fine = try served(mux, "GET", "/dir/")
			assert fine.status == 200
			return none
		}

		@test()
		def refusesConflictsAndDuplicates() !none {
			let mux = new ServeMux()
			try mux.handle("/a/\{x\}", echoRoute())
			assert mux.handle("/a/\{x\}", echoRoute()) is error
			assert mux.handle("/\{y\}/b", echoRoute()) is error
			try mux.handle("/a/b", echoRoute())
			assert mux.routes().len() == 2
			return none
		}

		@test()
		def groupsApplyMiddlewareOutermostFirst() !none {
			let mux = new ServeMux()
			let trail string[] = []
			mux.apply(def (ctx Context, next Handler) !none {
				trail.push("root")
				ctx.set("seen", true)
				return next.serve(ctx)
			})
			let api = mux.route("/api")
			api.apply(def (ctx Context, next Handler) !none {
				trail.push(ctx.has("seen") ?? ("api", "api-first"))
				return next.serve(ctx)
			})
			try api.get("/ping", def (ctx Context) !none {
				trail.push("handler")
				return ctx.text("pong")
			})
			let res = try served(mux, "GET", "/api/ping")
			assert res.status == 200
			assert (try res.text()) == "pong"
			assert trail.join(">") == "root>api>handler"
			let (_, route) = mux.handlerFor(try requestFor("GET", "/api/ping"))
			assert route == "GET /api/ping"
			return none
		}

		@test()
		def mountsAndStripsPrefixes() !none {
			let inner = new ServeMux()
			try inner.get("/x", def (ctx Context) !none {return ctx.text(ctx.path())})
			let mux = new ServeMux()
			try mux.mount("/sub", inner)
			let res = try served(mux, "GET", "/sub/x")
			assert res.status == 200
			assert (try res.text()) == "/x"
			return none
		}

		@test()
		def wrapOrdersMiddleware() !none {
			let order string[] = []
			let first = new MiddlewareFunc(def (ctx Context, next Handler) !none {
				order.push("first")
				return next.serve(ctx)
			})
			let second = new MiddlewareFunc(def (ctx Context, next Handler) !none {
				order.push("second")
				return next.serve(ctx)
			})
			let h = wrap(new HandlerFunc(def (ctx Context) !none {
				order.push("handler")
				return ctx.noContent()
			}), first, second)
			try serveWith(h, try requestFor("GET", "/"))
			assert order.join(",") == "first,second,handler"
			return none
		}
	}

	check "HTTP middleware" {
		@test()
		def recovererMapsFailuresToStatuses() !none {
			let mux = new ServeMux()
			mux.apply(recoverer())
			try mux.get("/missing", def (ctx Context) !none {fail ctx.abort(404, "no such user")})
			try mux.get("/boom", def (ctx Context) !none {fail HttpError{message: "db down", op: "test"}})
			let missing = try served(mux, "GET", "/missing")
			assert missing.status == 404
			assert (try missing.text()).trim() == "no such user"
			let boom = try served(mux, "GET", "/boom")
			assert boom.status == 500
			return none
		}

		@test()
		def errorJSONRendersFailures() !none {
			let mux = new ServeMux()
			mux.apply(errorJSON())
			try mux.get("/x", def (ctx Context) !none {fail ctx.abort(422, "bad input")})
			let res = try served(mux, "GET", "/x")
			assert res.status == 422
			assert res.headers.get("Content-Type").startsWith("application/json")
			let text = try res.text()
			assert text.contains("\"error\":\"bad input\"")
			assert text.contains("\"status\":422")
			return none
		}

		@test()
		def requestIDEchoesOrCreates() !none {
			let mux = new ServeMux()
			mux.apply(requestID())
			try mux.get("/x", def (ctx Context) !none {return ctx.text(ctx.request.id)})
			let given = try served(mux, "GET", "/x", "X-Request-Id: abc-123\r\n")
			assert (try given.text()) == "abc-123"
			assert given.headers.get("X-Request-Id") == "abc-123"
			let fresh = try served(mux, "GET", "/x")
			assert (try fresh.text()).len() >= 32
			return none
		}

		@test()
		def basicAndBearerAuth() !none {
			let mux = new ServeMux()
			let basic = mux.route("/basic")
			basic.apply(basicAuth("test", def (user string, password string) ?any {
				return none unless user == "ada" && password == "pw"
				return user
			}))
			try basic.get("/x", def (ctx Context) !none {
				return ctx.text(ctx.authenticated && !(ctx.user is none) ?? ("ada", "nobody"))
			})
			let bearer = mux.route("/bearer")
			bearer.apply(bearerAuth(def (token string) ?any {
				return none unless token == "t0k"
				return "bob"
			}))
			bearer.apply(requireAuth())
			try bearer.get("/x", def (ctx Context) !none {return ctx.text("in")})
			let denied = try served(mux, "GET", "/basic/x")
			assert denied.status == 401
			assert denied.headers.get("WWW-Authenticate").startsWith("Basic realm=\"test\"")
			let ok = try served(mux, "GET", "/basic/x", "Authorization: Basic YWRhOnB3\r\n")
			assert ok.status == 200
			assert (try ok.text()) == "ada"
			let noToken = try served(mux, "GET", "/bearer/x")
			assert noToken.status == 401
			assert noToken.headers.get("WWW-Authenticate") == "Bearer"
			let withToken = try served(mux, "GET", "/bearer/x", "Authorization: Bearer t0k\r\n")
			assert withToken.status == 200
			return none
		}

		@test()
		def rateLimitAnswers429() !none {
			let mux = new ServeMux()
			mux.apply(rateLimit(2, 1h))
			try mux.get("/x", def (ctx Context) !none {return ctx.noContent()})
			assert (try served(mux, "GET", "/x")).status == 204
			assert (try served(mux, "GET", "/x")).status == 204
			let third = try served(mux, "GET", "/x")
			assert third.status == 429
			assert third.headers.get("Retry-After") != ""
			return none
		}

		@test()
		def corsPreflightAndSimpleRequests() !none {
			let mux = new ServeMux()
			let opts = CorsOptions{}
			opts.origins = ["https://app.example.com"]
			opts.exposedHeaders = ["X-Total"]
			opts.maxAge = 10m
			mux.apply(cors(opts))
			try mux.get("/x", def (ctx Context) !none {return ctx.text("ok")})
			let preflight = try served(mux, "OPTIONS", "/x", "Origin: https://app.example.com\r\nAccess-Control-Request-Method: GET\r\nAccess-Control-Request-Headers: X-Auth\r\n")
			assert preflight.status == 204
			assert preflight.headers.get("Access-Control-Allow-Origin") == "https://app.example.com"
			assert preflight.headers.get("Access-Control-Allow-Methods").contains("GET")
			assert preflight.headers.get("Access-Control-Allow-Headers") == "X-Auth"
			assert preflight.headers.get("Access-Control-Max-Age") == "600"
			let simple = try served(mux, "GET", "/x", "Origin: https://app.example.com\r\n")
			assert simple.status == 200
			assert simple.headers.get("Access-Control-Expose-Headers") == "X-Total"
			assert simple.headers.get("Vary").contains("Origin")
			let other = try served(mux, "GET", "/x", "Origin: https://evil.example.com\r\n")
			assert other.headers.get("Access-Control-Allow-Origin") == ""
			return none
		}

		@test()
		def secureHeadersAndMaxBytes() !none {
			let mux = new ServeMux()
			mux.apply(recoverer(), secureHeaders(), maxBytes(4))
			try mux.post("/x", def (ctx Context) !none {
				let data = try ctx.bytes()
				return ctx.text(data.len().str())
			})
			let small = try served(mux, "POST", "/x", "Content-Length: 3\r\n\r\nabc")
			assert small.status == 200
			assert small.headers.get("X-Content-Type-Options") == "nosniff"
			let req = try readRequest(new bytes.Reader("POST /x HTTP/1.1\r\nHost: h\r\nContent-Length: 6\r\n\r\nabcdef".bytes()))
			let large = try serveWith(mux, req)
			assert large.status == 413
			return none
		}

		@test()
		def compressGzipsLargeTextBodies() !none {
			let mux = new ServeMux()
			mux.apply(compress(5, 16))
			try mux.get("/big", def (ctx Context) !none {return ctx.text("hello ".repeat(20))})
			try mux.get("/small", def (ctx Context) !none {return ctx.text("hi")})
			let big = try served(mux, "GET", "/big", "Accept-Encoding: gzip\r\n")
			assert big.headers.get("Content-Encoding") == "gzip"
			assert big.headers.get("Vary").contains("Accept-Encoding")
			let packed = try big.bytes()
			assert packed.len() > 2 && packed[0] == 0x1f && packed[1] == 0x8b
			let reader = new gzip.Reader(new bytes.Reader(packed))
			assert string(try readAll(reader)) == "hello ".repeat(20)
			let small = try served(mux, "GET", "/small", "Accept-Encoding: gzip\r\n")
			assert small.headers.get("Content-Encoding") == ""
			assert (try small.text()) == "hi"
			let plain = try served(mux, "GET", "/big")
			assert plain.headers.get("Content-Encoding") == ""
			return none
		}

		@test()
		def timeoutHandlerAnswers503() !none {
			let slow = new HandlerFunc(def (ctx Context) !none {
				time.sleep(80ms)
				return ctx.text("late")
			})
			let res = try serveWith(timeoutHandler(slow, 10ms, "too slow"), try requestFor("GET", "/"))
			assert res.status == 503
			assert (try res.text()).trim() == "too slow"
			let quick = new HandlerFunc(def (ctx Context) !none {return ctx.text("fast")})
			let ok = try serveWith(timeoutHandler(quick, 1s), try requestFor("GET", "/"))
			assert ok.status == 200
			assert (try ok.text()) == "fast"
			return none
		}

		@test()
		def realIPTrustsListedProxies() !none {
			let mux = new ServeMux()
			mux.apply(realIP("10.0.0.0/8"))
			try mux.get("/x", def (ctx Context) !none {return ctx.text(ctx.clientAddr())})
			let req = try requestFor("GET", "/x", "X-Forwarded-For: 203.0.113.9, 10.1.1.1\r\n")
			req.remote = try net.parseAddress("10.2.3.4:5555")
			let res = try serveWith(mux, req)
			assert (try res.text()) == "203.0.113.9"
			let untrusted = try requestFor("GET", "/x", "X-Forwarded-For: 203.0.113.9\r\n")
			untrusted.remote = try net.parseAddress("192.0.2.1:5555")
			let kept = try serveWith(mux, untrusted)
			assert (try kept.text()) == "192.0.2.1"
			return none
		}
	}

	check "HTTP cross-origin protection" {
		@test()
		def allowsSafeAndSameOriginRequests() !none {
			let csrf = new CrossOriginProtection()
			try csrf.validate(try requestFor("GET", "/x", "Sec-Fetch-Site: cross-site\r\n"))
			try csrf.validate(try requestFor("POST", "/x", "Sec-Fetch-Site: same-origin\r\n"))
			try csrf.validate(try requestFor("POST", "/x", "Sec-Fetch-Site: none\r\n"))
			try csrf.validate(try requestFor("POST", "/x"))
			try csrf.validate(try requestFor("POST", "/x", "Origin: http://example.com\r\n"))
			return none
		}

		@test()
		def deniesCrossSiteUnlessTrustedOrBypassed() !none {
			let csrf = new CrossOriginProtection()
			assert csrf.validate(try requestFor("POST", "/x", "Sec-Fetch-Site: cross-site\r\n")) is error
			assert csrf.validate(try requestFor("POST", "/x", "Origin: https://evil.example.com\r\n")) is error
			try csrf.addTrustedOrigin("https://app.example.com")
			assert csrf.addTrustedOrigin("app.example.com") is error
			try csrf.validate(try requestFor("POST", "/x", "Sec-Fetch-Site: cross-site\r\nOrigin: https://app.example.com\r\n"))
			try csrf.addInsecureBypassPattern("/webhooks/\{path...\}")
			try csrf.validate(try requestFor("POST", "/webhooks/github", "Sec-Fetch-Site: cross-site\r\n"))
			let mux = new ServeMux()
			mux.apply(csrf.middleware())
			try mux.post("/x", def (ctx Context) !none {return ctx.noContent()})
			let denied = try served(mux, "POST", "/x", "Sec-Fetch-Site: cross-site\r\n")
			assert denied.status == 403
			let fine = try served(mux, "POST", "/x", "Sec-Fetch-Site: same-origin\r\n")
			assert fine.status == 204
			return none
		}
	}

	// scratchDir lays out a small site under /tmp for the file server
	// tests.
	internal def scratchDir() !string {
		let stamp = time.now().unixNs().str()
		let dir = "/tmp/adm-http-fs-" + stamp
		try os.mkdir(dir)
		try os.mkdir(dir + "/sub")
		try os.writeFile(dir + "/index.html", "<h1>home</h1>".bytes())
		try os.writeFile(dir + "/sub/a.txt", "0123456789".bytes())
		try os.writeFile(dir + "/.secret", "hidden".bytes())
		try os.writeFile(dir + "/app.js", "console.log(1)".bytes())
		return dir
	}

	check "HTTP file server" {
		@test()
		def servesFilesIndexesRangesAndConditionals() !none {
			let dir = try scratchDir()
			let mux = new ServeMux()
			try mux.static("/static/", dir)
			let index = try served(mux, "GET", "/static/")
			assert index.status == 200
			assert (try index.text()) == "<h1>home</h1>"
			assert index.headers.get("Content-Type").startsWith("text/html")
			let file = try served(mux, "GET", "/static/sub/a.txt")
			assert file.status == 200
			assert file.headers.get("ETag").startsWith("W/")
			assert file.headers.get("Last-Modified") != ""
			assert file.headers.get("Accept-Ranges") == "bytes"
			let etag = file.headers.get("ETag")
			let cached = try served(mux, "GET", "/static/sub/a.txt", "If-None-Match: " + etag + "\r\n")
			assert cached.status == 304
			let range = try served(mux, "GET", "/static/sub/a.txt", "Range: bytes=2-4\r\n")
			assert range.status == 206
			assert range.headers.get("Content-Range") == "bytes 2-4/10"
			assert (try range.text()) == "234"
			let bad = try served(mux, "GET", "/static/sub/a.txt", "Range: bytes=50-60\r\n")
			assert bad.status == 416
			let head = try served(mux, "HEAD", "/static/sub/a.txt")
			assert head.status == 200
			assert head.headers.get("Content-Length") == "10"
			let dirRedirect = try served(mux, "GET", "/static/sub")
			assert dirRedirect.status == 301
			assert dirRedirect.headers.get("Location") == "/sub/"
			let hidden = try served(mux, "GET", "/static/.secret")
			assert hidden.status == 404
			let missing = try served(mux, "GET", "/static/nope.txt")
			assert missing.status == 404
			let escape = try served(mux, "GET", "/static/../../etc/passwd")
			assert escape.status == 301
			let indexRedirect = try served(mux, "GET", "/static/index.html")
			assert indexRedirect.status == 301
			return none
		}

		@test()
		def listsDirectoriesAndServesFallback() !none {
			let dir = try scratchDir()
			let server = new FileServer(dir)
			server.listDirectories = true
			server.indexFile = ""
			server.fallback = "/app.js"
			let listing = try serveWith(server, try requestFor("GET", "/"))
			assert listing.status == 200
			let page = try listing.text()
			assert page.contains("sub/")
			assert page.contains("app.js")
			assert !page.contains(".secret")
			let fallback = try serveWith(server, try requestFor("GET", "/missing"))
			assert fallback.status == 200
			assert (try fallback.text()) == "console.log(1)"
			assert fallback.headers.get("Content-Type").contains("javascript")
			return none
		}

		@test()
		def serveContentFromMemory() !none {
			let h = new HandlerFunc(def (ctx Context) !none {
				return serveContent(ctx, "report.csv", none, "a,b\n1,2\n".bytes())
			})
			let res = try serveWith(h, try requestFor("GET", "/"))
			assert res.status == 200
			assert res.headers.get("Content-Type").startsWith("text/csv")
			assert res.headers.get("Content-Length") == "8"
			assert (try res.text()) == "a,b\n1,2\n"
			let multi = try serveWith(h, try requestFor("GET", "/", "Range: bytes=0-0,2-2\r\n"))
			assert multi.status == 206
			assert multi.headers.get("Content-Type").startsWith("multipart/byteranges")
			return none
		}
	}
}
