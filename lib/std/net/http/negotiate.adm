partial module std.net.http {
	use std.time

	// AcceptEntry is one member of an `Accept`, `Accept-Encoding`,
	// `Accept-Language` or `Accept-Charset` header: the value, its quality
	// (1 when not given) and its parameters other than `q`.
	struct AcceptEntry {
		value  string
		q      float
		params map<string, string>
	}

	// parseAccept splits an `Accept`-style header value into its entries,
	// most preferred first: higher q wins, then a more specific value
	// (`text/html` over `text/*` over `*/*`), then header order. Entries
	// with q=0 stay in the list so a caller can see what is refused; a
	// malformed q counts as 1. Empty for an empty value.
	def parseAccept(value string) AcceptEntry[] {
		let out AcceptEntry[] = []
		for let member in value.split(",") {
			let text = member.trim()
			continue when text == ""
			let pieces = text.split(";")
			let entry = AcceptEntry{value: pieces[0].trim().lower(), q: 1.0, params: map<string, string>{}}
			for let i = 1; i < pieces.len(); i++ {
				let piece = pieces[i].trim()
				let eq = piece.indexOf("=")
				continue when eq < 0
				let name = piece[:eq].trim().lower()
				let val = unquoteToken(piece[eq + 1:].trim())
				if name == "q" {
					entry.q = parseQuality(val)
				} else {
					entry.params[name] = val
				}
			}
			out.push(entry)
		}
		// Insertion sort keeps header order among equals.
		for let i = 1; i < out.len(); i++ {
			let item = out[i]
			let j = i - 1
			for j >= 0 && acceptLess(out[j], item) {
				out[j + 1] = out[j]
				j--
			}
			out[j + 1] = item
		}
		return out
	}

	// negotiate picks the offer the entries prefer: the offer with the
	// highest quality among those an entry matches, a specific match over a
	// wildcard, earlier offers winning ties. Media types match by type and
	// subtype with `*` wildcards and by their `+suffix`; other values match
	// by case-insensitive equality or, for language tags, by prefix. None
	// when no offer is acceptable or every match has q=0; with no entries,
	// the first offer.
	def negotiate(offers string[], entries AcceptEntry[]) ?string {
		return none when offers.len() == 0
		return offers[0] when entries.len() == 0
		let best = ""
		let bestQ = 0.0
		let bestRank = -1
		for let offer in offers {
			// The most specific entry that matches the offer sets its
			// quality: `text/html;q=0, text/*` refuses html and accepts
			// the rest of text. Entries are ordered, so among equally
			// specific ones the first wins.
			let rank = -1
			let q = 0.0
			for let entry in entries {
				let r = acceptMatch(entry.value, offer.trim().lower())
				continue when r <= rank
				rank = r
				q = entry.q
			}
			continue when rank < 0
			if q > bestQ || (q == bestQ && rank > bestRank && best != "") {
				best = offer
				bestQ = q
				bestRank = rank
			}
		}
		return none when best == "" || bestQ <= 0.0
		return best
	}

	// acceptMatch ranks how well an entry value matches an offer: -1 for
	// no match, else higher for a more specific match.
	internal def acceptMatch(pattern string, offer string) int {
		return 0 when pattern := "*" || "*/*"
		if pattern.contains("/") || offer.contains("/") {
			let ps = pattern.indexOf("/")
			let os = offer.indexOf("/")
			return -1 when ps < 0 || os < 0
			let pType = pattern[:ps]
			let pSub = pattern[ps + 1:]
			let oType = offer[:os]
			let oSub = offer[os + 1:]
			return -1 when pType != "*" && pType != oType
			return 1 when pSub == "*"
			return 3 when pSub == oSub
			// `application/json` accepts `application/vnd.api+json`.
			let plus = oSub.indexOf("+")
			return 2 when plus >= 0 && oSub[plus + 1:] == pSub
			return -1
		}
		return 2 when pattern == offer
		// A language tag matches its prefix: `en` accepts `en-GB`.
		return 1 when offer.startsWith(pattern + "-")
		return -1
	}

	// acceptLess reports whether a is preferred less than b.
	internal def acceptLess(a AcceptEntry, b AcceptEntry) bool {
		return a.q < b.q when a.q != b.q
		return acceptSpecificity(a) < acceptSpecificity(b)
	}

	internal def acceptSpecificity(e AcceptEntry) int {
		let base = 0
		if e.value := "*" || "*/*" {
			base = 0
		} else if e.value.endsWith("/*") {
			base = 1
		} else {
			base = 2
		}
		return base * 16 + e.params.len()
	}

	// parseQuality reads a q-value: 0 to 1 with at most three decimals; a
	// malformed one counts as 1, and the range is clamped.
	internal def parseQuality(text string) float {
		return 1.0 when text == ""
		for let ch in text {
			return 1.0 unless ch.isDigit() || ch == '.'
		}
		let q = parseFloat<float>(text)
		return 0.0 when q < 0.0
		return 1.0 when q > 1.0
		return q
	}

	internal def unquoteToken(text string) string {
		return text[1:text.len() - 1] when text.len() >= 2 && text.startsWith("\"") && text.endsWith("\"")
		return text
	}

	// ByteRange is one satisfiable range of a body: the first byte offset
	// and the number of bytes.
	type ByteRange {
		start  int
		length int

		def new(start int, length int) {
			self.start = start
			self.length = length
		}

		// The `Content-Range` header value for the range over a body of
		// size bytes: `bytes 0-499/1234`.
		def contentRange(size int) string {
			return "bytes {start}-{start + length - 1}/{size}"
		}
	}

	// parseRange resolves a `Range` header value against a body of size
	// bytes: `bytes=0-499`, `bytes=500-`, `bytes=-500` and comma lists, each
	// clipped to the body. Overlapping or too many ranges are refused, as
	// browsers refuse them. Empty when the value is "" or the unit is not
	// `bytes`. Fails when the syntax is wrong or no range is satisfiable.
	def parseRange(value string, size int) !ByteRange[] {
		let text = value.trim()
		return [] when text == ""
		let eq = text.indexOf("=")
		return [] when eq < 0 || text[:eq].trim().lower() != "bytes"
		let out ByteRange[] = []
		let asked = 0
		let total = 0
		for let spec in text[eq + 1:].split(",") {
			let part = spec.trim()
			continue when part == ""
			asked++
			let dash = part.indexOf("-")
			fail HttpError{message: "invalid range: {part}", op: "range", text: value} when dash < 0
			let first = part[:dash].trim()
			let last = part[dash + 1:].trim()
			if first == "" {
				// `-n`: the last n bytes.
				fail HttpError{message: "invalid range: {part}", op: "range", text: value} unless isDigits(last)
				let n = parseInt<int>(last)
				continue when n == 0
				let length = n > size ?? (size, n)
				out.push(new ByteRange(size - length, length))
				total += length
				continue
			}
			fail HttpError{message: "invalid range: {part}", op: "range", text: value} unless isDigits(first)
			let start = parseInt<int>(first)
			// Past the end: unsatisfiable, but a sibling may still be.
			continue when start >= size
			let end = size - 1
			if last != "" {
				fail HttpError{message: "invalid range: {part}", op: "range", text: value} unless isDigits(last)
				let want = parseInt<int>(last)
				fail HttpError{message: "invalid range: {part}", op: "range", text: value} when want < start
				end = want when want < end
			}
			out.push(new ByteRange(start, end - start + 1))
			total += end - start + 1
		}
		fail HttpError{message: "no satisfiable range in {value}", op: "range", text: value} when asked > 0 && out.len() == 0
		// Ranges that together exceed the body overlap; browsers refuse
		// such a request, and serving it multiplies the work.
		fail HttpError{message: "overlapping ranges in {value}", op: "range", text: value} when total > size
		return out
	}

	internal def isDigits(text string) bool {
		return false when text == ""
		for let ch in text {
			return false unless ch.isDigit()
		}
		return true
	}

	// etagMatches reports whether a tag satisfies an `If-Match` or
	// `If-None-Match` header value: `*` matches any tag; otherwise the tags
	// are compared strongly (both strong and equal) or, with allowWeak,
	// weakly (equal ignoring a `W/` prefix), as the header requires.
	def etagMatches(header string, etag string, allowWeak bool) bool {
		let want = header.trim()
		return false when want == ""
		return true when want == "*"
		let tag = normalizeETag(etag)
		return false when tag == ""
		for let member in want.split(",") {
			let candidate = normalizeETag(member)
			continue when candidate == ""
			if allowWeak {
				return true when stripWeak(candidate) == stripWeak(tag)
			} else {
				return true when !isWeakETag(candidate) && !isWeakETag(tag) && candidate == tag
			}
		}
		return false
	}

	// normalizeETag quotes a bare tag so it compares with header form.
	internal def normalizeETag(etag string) string {
		let tag = etag.trim()
		return "" when tag == ""
		return tag when tag.startsWith("\"") || tag.startsWith("W/")
		return "\"" + tag + "\""
	}

	internal def isWeakETag(tag string) bool {
		return tag.startsWith("W/")
	}

	internal def stripWeak(tag string) string {
		return tag[2:] when tag.startsWith("W/")
		return tag
	}

	// evaluateConditions evaluates a request's conditional headers against
	// the resource's tag and modification time, in RFC 9110 order:
	// `If-Match`, `If-Unmodified-Since`, `If-None-Match`,
	// `If-Modified-Since`. `NotModified` says to answer 304 (GET, HEAD) and
	// `PreconditionFailed` 412; `Serve` says to serve the resource.
	def evaluateConditions(req Request, etag string, lastModified ?time.Time = none) ConditionResult {
		let readOnly = req.method == Method.GET || req.method == Method.HEAD
		let ifMatch = req.headers.get("If-Match")
		if ifMatch != "" {
			return ConditionResult.PreconditionFailed unless etagMatches(ifMatch, etag, false)
		} else {
			let since = req.headers.get("If-Unmodified-Since")
			if since != "" && !(lastModified is none) {
				let limit = parseDateHeader(since)
				if !(limit is none) {
					return ConditionResult.PreconditionFailed when modifiedAfter(lastModified, limit)
				}
			}
		}
		let noneMatch = req.headers.get("If-None-Match")
		if noneMatch != "" {
			return readOnly ?? (ConditionResult.NotModified, ConditionResult.PreconditionFailed) when etagMatches(noneMatch, etag, true)
			return ConditionResult.Serve
		}
		if readOnly && !(lastModified is none) {
			let since = req.headers.get("If-Modified-Since")
			if since != "" {
				let limit = parseDateHeader(since)
				if !(limit is none) {
					return ConditionResult.NotModified unless modifiedAfter(lastModified, limit)
				}
			}
		}
		return ConditionResult.Serve
	}

	// parseDateHeader reads an HTTP date, none when it does not parse: a
	// malformed conditional header is ignored, not an error.
	internal def parseDateHeader(text string) ?time.Time {
		let ok = true
		let t = time.parseHTTPDate(text) onerror (err error) {
			ok = false
			recover time.now()
		}
		return none unless ok
		return t
	}

	// modifiedAfter compares at the second precision HTTP dates carry.
	internal def modifiedAfter(modified time.Time, limit time.Time) bool {
		return modified.unixNs() / 1000000000 > limit.unixNs() / 1000000000
	}

	// ConditionResult is the outcome of evaluating a request's conditional
	// headers.
	enum ConditionResult {
		// No condition failed: serve the resource.
		Serve,
		// The client's copy is current: answer 304 without a body.
		NotModified,
		// A precondition failed: answer 412.
		PreconditionFailed
	}
}
