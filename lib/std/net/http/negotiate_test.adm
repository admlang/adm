partial module std.net.http {
	use (
		std.testing
		std.time
	)

	// picked is negotiate with "" for none, so tests compare strings.
	internal def picked(offers string[], entries AcceptEntry[]) string {
		let choice = negotiate(offers, entries)
		return "" when choice is none
		return choice
	}

	check "HTTP negotiation" {
		@test()
		def parseAcceptOrdersByQualityThenSpecificity() {
			let entries = parseAccept("text/*, text/html, */*;q=0.1, application/json;q=0.9, text/plain;format=flowed")
			assert entries.len() == 5
			assert entries[0].value == "text/plain"
			assert entries[0].params["format"] == "flowed"
			assert entries[1].value == "text/html"
			assert entries[2].value == "text/*"
			assert entries[3].value == "application/json"
			assert entries[3].q == 0.9
			assert entries[4].value == "*/*"
			assert entries[4].q == 0.1
		}

		@test()
		def parseAcceptTreatsMalformedQualityAsOne() {
			let entries = parseAccept("gzip;q=abc, br;q=0.5")
			assert entries[0].value == "gzip"
			assert entries[0].q == 1.0
			assert parseAccept("").len() == 0
		}

		@test()
		def negotiatePicksThePreferredOffer() {
			let browser = parseAccept("text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8")
			assert picked(["application/json", "text/html"], browser) == "text/html"
			assert picked(["application/json"], browser) == "application/json"
			assert picked(["application/json", "text/plain"], parseAccept("application/*")) == "application/json"
			assert picked(["application/vnd.api+json"], parseAccept("application/json")) == "application/vnd.api+json"
			assert picked(["application/json", "text/html"], []) == "application/json"
			assert picked([], browser) == ""
		}

		@test()
		def negotiateRefusesZeroQuality() {
			assert picked(["text/html"], parseAccept("text/html;q=0, */*;q=0")) == ""
			assert picked(["text/html"], parseAccept("application/json")) == ""
			// The specific refusal wins over the wildcard acceptance.
			assert picked(["text/html", "text/plain"], parseAccept("text/html;q=0, text/*")) == "text/plain"
		}

		@test()
		def negotiateMatchesLanguagePrefixesAndEncodings() {
			assert picked(["en-GB", "fr"], parseAccept("fr;q=0.8, en")) == "en-GB"
			assert picked(["de"], parseAccept("en, *;q=0.1")) == "de"
			assert picked(["gzip", "br"], parseAccept("br, gzip;q=0.5")) == "br"
		}

		@test()
		def parseRangeResolvesAgainstTheSize() !none {
			let one = try parseRange("bytes=0-499", 1000)
			assert one.len() == 1 && one[0].start == 0 && one[0].length == 500
			assert one[0].contentRange(1000) == "bytes 0-499/1000"
			let tail = try parseRange("bytes=-500", 1000)
			assert tail[0].start == 500 && tail[0].length == 500
			let open = try parseRange("bytes=900-", 1000)
			assert open[0].start == 900 && open[0].length == 100
			let clipped = try parseRange("bytes=990-2000", 1000)
			assert clipped[0].start == 990 && clipped[0].length == 10
			let two = try parseRange("bytes=0-9, 20-29", 1000)
			assert two.len() == 2 && two[1].start == 20 && two[1].length == 10
			let whole = try parseRange("bytes=-5000", 1000)
			assert whole[0].start == 0 && whole[0].length == 1000
			assert (try parseRange("", 1000)).len() == 0
			assert (try parseRange("items=0-1", 1000)).len() == 0
			return none
		}

		@test()
		def parseRangeRefusesBadRanges() {
			assert parseRange("bytes=2000-", 1000) is error
			assert parseRange("bytes=5-2", 1000) is error
			assert parseRange("bytes=a-b", 1000) is error
			assert parseRange("bytes=0-600,400-999", 1000) is error
			let err = parseRange("bytes=2000-", 1000) onerror (e error) {
				assert e is HttpError
				if e is HttpError {
					assert e.op == "range"
				}
				recover []
			}
			assert err.len() == 0
		}

		@test()
		def etagMatchesStrongAndWeak() {
			assert etagMatches("*", "\"a\"", false)
			assert etagMatches("\"a\", \"b\"", "\"b\"", false)
			assert !etagMatches("\"a\"", "\"b\"", false)
			assert !etagMatches("W/\"a\"", "\"a\"", false)
			assert etagMatches("W/\"a\"", "\"a\"", true)
			assert etagMatches("\"a\"", "a", true)
			assert !etagMatches("", "\"a\"", true)
		}

		@test()
		def evaluateConditionsFollowsTheRfcOrder() !none {
			let modified = try time.parseHTTPDate("Wed, 21 Oct 2015 07:28:00 GMT")
			let req = new Request()
			req.method = Method.GET
			assert evaluateConditions(req, "\"v1\"", modified) == ConditionResult.Serve

			req.headers.set("If-None-Match", "\"v1\"")
			assert evaluateConditions(req, "\"v1\"", modified) == ConditionResult.NotModified
			req.method = Method.POST
			assert evaluateConditions(req, "\"v1\"", modified) == ConditionResult.PreconditionFailed
			req.method = Method.GET
			assert evaluateConditions(req, "\"v2\"", modified) == ConditionResult.Serve
			req.headers.del("If-None-Match")

			req.headers.set("If-Modified-Since", "Wed, 21 Oct 2015 07:28:00 GMT")
			assert evaluateConditions(req, "\"v1\"", modified) == ConditionResult.NotModified
			req.headers.set("If-Modified-Since", "Tue, 20 Oct 2015 07:28:00 GMT")
			assert evaluateConditions(req, "\"v1\"", modified) == ConditionResult.Serve
			req.headers.set("If-Modified-Since", "garbage")
			assert evaluateConditions(req, "\"v1\"", modified) == ConditionResult.Serve
			req.headers.del("If-Modified-Since")

			req.headers.set("If-Match", "\"other\"")
			assert evaluateConditions(req, "\"v1\"", modified) == ConditionResult.PreconditionFailed
			req.headers.set("If-Match", "*")
			assert evaluateConditions(req, "\"v1\"", modified) == ConditionResult.Serve
			req.headers.del("If-Match")

			req.headers.set("If-Unmodified-Since", "Tue, 20 Oct 2015 07:28:00 GMT")
			assert evaluateConditions(req, "\"v1\"", modified) == ConditionResult.PreconditionFailed
			req.headers.set("If-Unmodified-Since", "Thu, 22 Oct 2015 07:28:00 GMT")
			assert evaluateConditions(req, "\"v1\"", modified) == ConditionResult.Serve
			return none
		}
	}
}
