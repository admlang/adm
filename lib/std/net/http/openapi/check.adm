partial module std.net.http.openapi {
	// Problem is one thing wrong with a document, a request or a response.
	struct Problem {
		// Where: "document", or for a request or response "path", "query",
		// "querystring", "header", "cookie", "body", "method", "security",
		// "status".
		location string
		// The parameter, header or form field, "" when none.
		name     string = ""
		// A JSON Pointer: into the document for a document problem, into
		// the value checked otherwise ("" for the whole).
		pointer  string = ""
		message  string
	}

	partial type Document {
		// What is wrong with the document: what its version's schema from
		// the OpenAPI Specification refuses, and the rules that schema
		// cannot express: unique operationIds, tag names and parameters,
		// path templates that differ only in parameter names, path
		// parameters that match their templates, `querystring` used alone,
		// response codes, security requirements naming declared schemes,
		// links naming operations, references that resolve and schemas that
		// compile. Empty when the document is valid. `documents` holds the
		// other documents it refers to, by URI.
		def problems(documents map<string, any> = map<string, any>{}) Problem[] {
			let c = new Checker(self)
			let (_, minor) = version()
			c.checkAgainstSpecification(minor)
			let schemas = compileSchemas(self, documents, false) onerror (err error) {
				c.add("", err.message)
				return c.problems
			}
			c.schemas = schemas
			c.run()
			return c.problems
		}
	}

	// The rules of `Document.problems` beyond the specification's schema.
	internal type Checker {
		doc          Document
		schemas      ?Schemas            = none
		problems     Problem[]           = []
		operationIds map<string, string>

		def new(doc Document) {
			self.doc = doc
			operationIds = map<string, string>{}
		}

		def checkAgainstSpecification(minor int) {
			let spec = specificationSchema(minor) onerror (err error) {
				add("", "the specification's schema of OpenAPI {doc.openapi} does not compile: {err.message}")
				return
			}
			for let e in spec.validate(doc.tree()) {
				add(e.instanceLocation, e.message)
			}
		}

		def add(pointer string, message string) {
			problems.push(Problem{location: "document", pointer: pointer, message: message})
		}

		def run() {
			checkTags()
			let shapes = map<string, string>{}
			for let (template, item) in doc.paths {
				let at = "/paths/" + escapePointer(template)
				add(at, "a path starts with /") unless template.startsWith("/")
				let shape = templateShape(template)
				let earlier = shapes.get(shape)
				add(at, "{template} and {earlier} differ only in parameter names") unless earlier is none
				shapes[shape] = template
				checkPathItem(item, at, template)
			}
			for let (name, item) in doc.webhooks {
				checkPathItem(item, "/webhooks/" + escapePointer(name), "")
			}
			for let (name, item) in doc.components.pathItems {
				checkPathItem(item, "/components/pathItems/" + escapePointer(name), "")
			}
			for let (name, p) in doc.components.parameters {
				checkParameter(p, "/components/parameters/" + escapePointer(name))
			}
			for let (name, r) in doc.components.responses {
				checkResponse(r, "/components/responses/" + escapePointer(name))
			}
			for let (name, b) in doc.components.requestBodies {
				checkRequestBody(b, "/components/requestBodies/" + escapePointer(name))
			}
			for let (name, h) in doc.components.headers {
				checkHeader(h, "/components/headers/" + escapePointer(name))
			}
			for let (name, m) in doc.components.mediaTypes {
				checkMediaType(m, "/components/mediaTypes/" + escapePointer(name))
			}
			for let (name, _) in doc.components.schemas {
				checkSchema("/components/schemas/" + escapePointer(name))
			}
			for let (name, s) in doc.components.securitySchemes {
				checkReference(s.ref, "/components/securitySchemes/" + escapePointer(name))
			}
			let requirements = doc.security
			checkSecurity(requirements, "/security") unless requirements is none
			checkServers(doc.servers, "/servers")
			checkLinksEverywhere()
		}

		def checkTags() {
			let names = map<string, int>{}
			for let (i, tag) in doc.tags {
				add("/tags/{i}", "the tag \"{tag.name}\" is declared twice") when names.hasKey(tag.name)
				names[tag.name] = i
			}
			for let (i, tag) in doc.tags {
				continue when tag.parent == ""
				if !names.hasKey(tag.parent) {
					add("/tags/{i}/parent", "the parent tag \"{tag.parent}\" is not declared")
					continue
				}
				// A parent chain must end.
				let seen = map<string, bool>{}
				let current = tag.name
				for current != "" && names.hasKey(current) {
					if seen.hasKey(current) {
						add("/tags/{i}/parent", "the tag \"{tag.name}\" is its own ancestor")
						break
					}
					seen[current] = true
					current = doc.tags[names[current]].parent
				}
			}
		}

		def checkReference(ref string, at string) {
			return when ref == ""
			let s = schemas
			return when s is none
			s.resolve(ref, at) onerror (err error) {
				add(at, err.message)
				recover none
			}
		}

		def checkSchema(at string) {
			let s = schemas
			return when s is none
			s.at(at) onerror (err error) {
				add(at, err.message)
				recover s.root
			}
		}

		def checkPathItem(item PathItem, at string, template string) {
			if item.ref != "" {
				checkReference(item.ref, at)
				return
			}
			let names = templateNames(template)
			let seenNames = map<string, bool>{}
			for let name in names {
				add(at, "the template expression \{{name}\} appears twice") when seenNames.hasKey(name)
				seenNames[name] = true
			}
			checkParameterList(item.parameters, at, names)
			checkServers(item.servers, at + "/servers")
			let operations = item.all()
			for let entry in operations {
				let (method, op) = entry
				let opAt = at + "/" + (fixedMethods.includes(method.lower()) ?? (method.lower(), "additionalOperations/" + escapePointer(method)))
				checkOperation(op, opAt, item, names)
			}
			if template != "" && operations.len() > 0 {
				for let name in names {
					for let entry in operations {
						let (method, op) = entry
						add(at, "{method} {template} has no path parameter \"{name}\"") when !declaresPath(item.parameters, name) && !declaresPath(op.parameters, name)
					}
				}
			}
		}

		// Whether a list declares a path parameter (a reference counts, as
		// it may).
		def declaresPath(parameters Parameter[], name string) bool {
			for let p in parameters {
				let resolved = resolvedParameter(p)
				return true when resolved is none
				return true when resolved.location == ParameterIn.Path && resolved.name == name
			}
			return false
		}

		def resolvedParameter(p Parameter) ?Parameter {
			return p when p.ref == ""
			let s = schemas
			return none when s is none
			let target = s.resolve(p.ref, "") onerror recover none
			return none unless target is map<string, any>
			return parameterOf(target, s.localPointer(p.ref)) onerror (err error) {
				return none
			}
		}

		def checkParameterList(parameters Parameter[], at string, names string[]) {
			let seen = map<string, bool>{}
			let query = false
			let querystring = 0
			for let (i, p) in parameters {
				let pat = "{at}/parameters/{i}"
				checkParameter(p, pat)
				let resolved = resolvedParameter(p)
				continue when resolved is none
				let key = locationName(resolved.location) + " " + (resolved.location == ParameterIn.Header ?? (resolved.name.lower(), resolved.name))
				add(pat, "the {locationName(resolved.location)} parameter \"{resolved.name}\" is declared twice") when seen.hasKey(key)
				seen[key] = true
				query = true when resolved.location == ParameterIn.Query
				querystring++ when resolved.location == ParameterIn.QueryString
				add(pat, "the path parameter \"{resolved.name}\" is not in the path template") when resolved.location == ParameterIn.Path && names.len() > 0 && !names.includes(resolved.name)
			}
			add(at, "an operation has one querystring parameter") when querystring > 1
			add(at, "query and querystring parameters cannot be used together") when query && querystring > 0
		}

		def checkParameter(p Parameter, at string) {
			if p.ref != "" {
				checkReference(p.ref, at)
				return
			}
			add(at, "a parameter has a schema or content, not both") when !(p.schema is none) && p.content.len() > 0
			add(at, "a parameter has a schema or content") when p.schema is none && p.content.len() == 0
			add(at, "a parameter's content has one media type") when p.content.len() > 1
			add(at, "a path parameter is required") when p.location == ParameterIn.Path && !p.required
			add(at, "a querystring parameter is described by content") when p.location == ParameterIn.QueryString && p.content.len() == 0
			add(at + "/style", "the style {styleName(p.style)} is not used {locationName(p.location)} parameters") when p.style != Style.Default && !styleAllowed(p.style, p.location)
			add(at, "example and examples cannot be used together") when p.hasExample && p.examples.len() > 0
			checkSchema(at + "/schema") unless p.schema is none
			checkContent(p.content, at)
			checkExamples(p.examples, at)
		}

		def checkOperation(op Operation, at string, item PathItem, names string[]) {
			if op.operationId != "" {
				let earlier = operationIds.get(op.operationId)
				add(at + "/operationId", "the operationId \"{op.operationId}\" is used at {earlier} too") unless earlier is none
				operationIds[op.operationId] = at
			}
			checkParameterList(op.parameters, at, names)
			// A querystring parameter may not meet a query one across the
			// path item and the operation either.
			let all Parameter[] = []
			all += item.parameters
			all += op.parameters
			let query = false
			let querystring = false
			for let p in all {
				let resolved = resolvedParameter(p)
				continue when resolved is none
				query = true when resolved.location == ParameterIn.Query
				querystring = true when resolved.location == ParameterIn.QueryString
			}
			add(at, "query and querystring parameters cannot be used together") when query && querystring
			let body = op.requestBody
			checkRequestBody(body, at + "/requestBody") unless body is none
			for let (code, r) in op.responses {
				let rat = at + "/responses/" + escapePointer(code)
				add(rat, "\"{code}\" is not a response code: 100 to 599, 1XX to 5XX, or default") unless code == "default" || /^[1-5]([0-9][0-9]|XX)$/.test(code)
				checkResponse(r, rat)
			}
			for let (name, cb) in op.callbacks {
				let cat = at + "/callbacks/" + escapePointer(name)
				if cb.ref != "" {
					checkReference(cb.ref, cat)
					continue
				}
				for let (expression, cbItem) in cb.expressions {
					checkPathItem(cbItem, cat + "/" + escapePointer(expression), "")
				}
			}
			let requirements = op.security
			checkSecurity(requirements, at + "/security") unless requirements is none
			checkServers(op.servers, at + "/servers")
		}

		def checkRequestBody(b RequestBody, at string) {
			if b.ref != "" {
				checkReference(b.ref, at)
				return
			}
			checkContent(b.content, at)
		}

		def checkResponse(r Response, at string) {
			if r.ref != "" {
				checkReference(r.ref, at)
				return
			}
			for let (name, h) in r.headers {
				checkHeader(h, at + "/headers/" + escapePointer(name))
			}
			checkContent(r.content, at)
			for let (name, l) in r.links {
				checkReference(l.ref, at + "/links/" + escapePointer(name))
			}
		}

		def checkHeader(h Header, at string) {
			if h.ref != "" {
				checkReference(h.ref, at)
				return
			}
			add(at, "a header has a schema or content, not both") when !(h.schema is none) && h.content.len() > 0
			add(at, "a header has a schema or content") when h.schema is none && h.content.len() == 0
			add(at, "a header's content has one media type") when h.content.len() > 1
			add(at + "/style", "a header's style is simple") unless h.style == Style.Default || h.style == Style.Simple
			checkSchema(at + "/schema") unless h.schema is none
			checkContent(h.content, at)
			checkExamples(h.examples, at)
		}

		def checkContent(content map<string, MediaType>, at string) {
			for let (name, m) in content {
				checkMediaType(m, at + "/content/" + escapePointer(name))
			}
		}

		def checkMediaType(m MediaType, at string) {
			if m.ref != "" {
				checkReference(m.ref, at)
				return
			}
			add(at, "example and examples cannot be used together") when m.hasExample && m.examples.len() > 0
			add(at, "encoding cannot be used with prefixEncoding or itemEncoding") when m.encoding.len() > 0 && (m.prefixEncoding.len() > 0 || !(m.itemEncoding is none))
			checkSchema(at + "/schema") unless m.schema is none
			checkSchema(at + "/itemSchema") unless m.itemSchema is none
			checkExamples(m.examples, at)
		}

		def checkExamples(examples map<string, Example>, at string) {
			for let (name, e) in examples {
				let eat = at + "/examples/" + escapePointer(name)
				if e.ref != "" {
					checkReference(e.ref, eat)
					continue
				}
				add(eat, "value cannot be used with dataValue or serializedValue") when e.hasValue && (e.hasDataValue || e.serializedValue != "")
				add(eat, "serializedValue and externalValue cannot be used together") when e.serializedValue != "" && e.externalValue != ""
				add(eat, "value and externalValue cannot be used together") when e.hasValue && e.externalValue != ""
			}
		}

		def checkSecurity(requirements map<string, string[]>[], at string) {
			for let (i, r) in requirements {
				for let (name, _) in r {
					continue when name.contains(":") || name.contains("/")
					add("{at}/{i}", "the security scheme \"{name}\" is not declared in components") unless doc.components.securitySchemes.hasKey(name)
				}
			}
		}

		def checkServers(servers Server[], at string) {
			for let (i, server) in servers {
				let sat = "{at}/{i}"
				for let name in templateNames(server.url) {
					add(sat, "the server variable \"{name}\" is not declared") unless server.variables.hasKey(name)
				}
				for let (name, v) in server.variables {
					add(sat + "/variables/" + escapePointer(name), "the default \"{v.defaultValue}\" is not one of the variable's values") when v.values.len() > 0 && !v.values.includes(v.defaultValue)
				}
			}
		}

		// Every link's operationId names an operation.
		def checkLinksEverywhere() {
			for let (template, item) in doc.paths {
				for let entry in item.all() {
					let (method, op) = entry
					for let (code, r) in op.responses {
						for let (name, l) in r.links {
							continue when l.operationId == "" || operationIds.hasKey(l.operationId)
							add("/paths/{escapePointer(template)}/{method.lower()}/responses/{escapePointer(code)}/links/{escapePointer(name)}", "no operation has the operationId \"{l.operationId}\"")
						}
					}
				}
			}
			for let (name, l) in doc.components.links {
				continue when l.operationId == "" || operationIds.hasKey(l.operationId)
				add("/components/links/" + escapePointer(name), "no operation has the operationId \"{l.operationId}\"")
			}
		}
	}

	// The names of a template's expressions (`/users/{id}` → `id`).
	internal def templateNames(template string) string[] {
		let out string[] = []
		let i = template.indexOf("\{")
		for i >= 0 {
			let close = template.indexOf("\}", i)
			break when close < 0
			out.push(template.slice(i + 1, close))
			i = template.indexOf("\{", close)
		}
		return out
	}

	// A template with its expression names left out: two templates of one
	// shape are the same path.
	internal def templateShape(template string) string {
		let out = ""
		let i = 0
		for i < template.len() {
			let open = template.indexOf("\{", i)
			if open < 0 {
				out += template.slice(i, template.len())
				break
			}
			let close = template.indexOf("\}", open)
			if close < 0 {
				out += template.slice(i, template.len())
				break
			}
			out += template.slice(i, open) + "\{\}"
			i = close + 1
		}
		return out
	}

	// Whether a style is one the location allows.
	internal def styleAllowed(value Style, location ParameterIn) bool {
		switch location {
			case ParameterIn.Path:
				return value := Style.Matrix || Style.Label || Style.Simple
			case ParameterIn.Header:
				return value == Style.Simple
			case ParameterIn.Query:
				return value := Style.Form || Style.SpaceDelimited || Style.PipeDelimited || Style.DeepObject
			case ParameterIn.Cookie:
				return value := Style.Form || Style.Cookie
			default:
				return false
		}
	}
}
