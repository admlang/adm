partial module std.net.http.openapi {
	use (
		std.net.http
		std.data.encoding::(JSON, htmlEncode)
		std.formats.docs::(Html, Markdown, Block, BlockKind, Inline, InlineKind)
	)

	partial type Document {
		// Serves the document from a mux: `{at}.json`, `{at}.yaml` and the
		// documentation page at `at` (default `/openapi`). The document is
		// served as it is when serve is called. Fails as `ServeMux.handle`
		// does, when one of the three paths is taken.
		def serve(mux http.ServeMux, at string = "/openapi") !none {
			let base = at.trimSuffix("/")
			let json = json()
			let yaml = yaml()
			let html = page(base + ".json").bytes()
			try mux.get(base + ".json", def (ctx http.Context) !none {
				return ctx.blob(200, "application/openapi+json", json)
			})
			try mux.get(base + ".yaml", def (ctx http.Context) !none {
				return ctx.blob(200, "application/openapi+yaml", yaml)
			})
			try mux.get(base, def (ctx http.Context) !none {
				return ctx.blob(200, "text/html; charset=utf-8", html)
			})
			return none
		}

		// The documentation page: one self-contained HTML page (no script,
		// no outside resource) with the API's description, its servers and
		// security schemes, the operations by tag with their parameters,
		// request bodies and responses, the webhooks, and the component
		// schemas. Descriptions are rendered as CommonMark, with HTML in
		// them shown as text. `source` is the URL the page links to as the
		// document itself ("" for none).
		def page(source string = "") string {
			let r = new PageRenderer(self)
			return r.render(source)
		}
	}

	// Writes the documentation page.
	internal type PageRenderer {
		doc Document
		out string   = ""

		def new(doc Document) {
			self.doc = doc
		}

		def add(text string) {
			out += text
		}

		def render(source string) string {
			let title = doc.info.title == "" ?? ("API", doc.info.title)
			add("<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">")
			add("<title>" + esc(title) + "</title><style>" + pageStyle + "</style></head><body>")
			add("<header><h1>" + esc(title) + "</h1><p class=\"meta\">")
			add("<span class=\"badge\">" + esc(doc.info.version) + "</span> ") unless doc.info.version == ""
			add("<span class=\"badge muted\">OpenAPI " + esc(doc.openapi) + "</span>")
			add(" <a href=\"" + esc(source) + "\">" + esc(source.split("/")[source.split("/").len() - 1]) + "</a>") unless source == ""
			add("</p>")
			add("<p class=\"summary\">" + esc(doc.info.summary) + "</p>") unless doc.info.summary == ""
			add(markdown(doc.info.description))
			let contact = doc.info.contact
			if !(contact is none) {
				let who = contact.name == "" ?? (contact.email, contact.name)
				let link = contact.url == "" ?? (contact.email == "" ?? ("", "mailto:" + contact.email), contact.url)
				add("<p class=\"meta\">Contact: " + linkTo(link, who) + "</p>") unless who == "" && link == ""
			}
			let license = doc.info.license
			if !(license is none) {
				let target = license.url == "" ?? (license.identifier == "" ?? ("", "https://spdx.org/licenses/" + license.identifier + ".html"), license.url)
				add("<p class=\"meta\">License: " + linkTo(target, license.name) + "</p>")
			}
			add("<p class=\"meta\">" + linkTo(doc.info.termsOfService, "Terms of service") + "</p>") unless doc.info.termsOfService == ""
			add("</header><main>")
			renderNavigation()
			add("<div class=\"content\">")
			renderServers(doc.servers)
			renderSecuritySchemes()
			renderOperations()
			renderWebhooks()
			renderSchemas()
			add("</div></main></body></html>\n")
			return out
		}

		// The tags in the order the document declares them, then the ones
		// only operations name, and "" for untagged operations last.
		def tagOrder() string[] {
			let order string[] = []
			for let t in doc.tags {
				order.push(t.name)
			}
			let untagged = false
			for let (_, item) in doc.paths {
				for let entry in item.all() {
					let (_, op) = entry
					untagged = true when op.tags.len() == 0
					for let tag in op.tags {
						order.push(tag) unless order.includes(tag)
					}
				}
			}
			order.push("") when untagged
			return order
		}

		def renderNavigation() {
			add("<nav><h2>Operations</h2><ul>")
			for let tag in tagOrder() {
				add("<li><a href=\"#tag-" + anchor(tag) + "\">" + esc(tag == "" ?? ("Other", tag)) + "</a></li>")
			}
			add("</ul>")
			add("<h2><a href=\"#webhooks\">Webhooks</a></h2>") when doc.webhooks.len() > 0
			add("<h2><a href=\"#schemas\">Schemas</a></h2>") when doc.components.schemas.len() > 0
			add("</nav>")
		}

		def renderServers(servers Server[]) {
			return when servers.len() == 0
			add("<section><h2>Servers</h2><ul class=\"servers\">")
			for let s in servers {
				add("<li><code>" + esc(s.url) + "</code>")
				add(" " + esc(s.name)) unless s.name == ""
				add(" – " + esc(s.description)) unless s.description == ""
				for let (name, v) in s.variables {
					add("<br><small><code>\{" + esc(name) + "\}</code> default <code>" + esc(v.defaultValue) + "</code>")
					add(" of " + v.values.mapElem(x => "<code>" + esc(x) + "</code>").join(", ")) when v.values.len() > 0
					add(": " + esc(v.description)) unless v.description == ""
					add("</small>")
				}
				add("</li>")
			}
			add("</ul></section>")
		}

		def renderSecuritySchemes() {
			return when doc.components.securitySchemes.len() == 0
			add("<section><h2>Authentication</h2><dl>")
			for let (name, s) in doc.components.securitySchemes {
				add("<dt id=\"security-" + anchor(name) + "\">" + esc(name) + "</dt><dd>" + esc(schemeText(s)))
				add(markdown(s.description))
				add("</dd>")
			}
			add("</dl></section>")
		}

		def schemeText(s SecurityScheme) string {
			switch s.kind {
				case SchemeKind.ApiKey:
					return "API key in the {locationName(s.location)} \"{s.name}\""
				case SchemeKind.MutualTLS:
					return "Mutual TLS"
				case SchemeKind.OAuth2:
					return "OAuth 2"
				case SchemeKind.OpenIdConnect:
					return "OpenID Connect: {s.openIdConnectUrl}"
				default:
					let format = s.bearerFormat == "" ?? ("", " ({s.bearerFormat})")
					return "HTTP {s.scheme}{format}"
			}
		}

		def renderOperations() {
			for let tag in tagOrder() {
				let declared = doc.tags.filter(t => t.name == tag)
				add("<section id=\"tag-" + anchor(tag) + "\"><h2>" + esc(tag == "" ?? ("Other", tag)) + "</h2>")
				if declared.len() > 0 {
					add("<p class=\"summary\">" + esc(declared[0].summary) + "</p>") unless declared[0].summary == ""
					add(markdown(declared[0].description))
				}
				for let (template, item) in doc.paths {
					for let entry in item.all() {
						let (method, op) = entry
						let listed = tag == "" ?? (op.tags.len() == 0, op.tags.includes(tag))
						renderOperation(method, template, item, op) when listed
					}
				}
				add("</section>")
			}
		}

		def renderWebhooks() {
			return when doc.webhooks.len() == 0
			add("<section id=\"webhooks\"><h2>Webhooks</h2>")
			for let (name, item) in doc.webhooks {
				for let entry in item.all() {
					let (method, op) = entry
					renderOperation(method, name, item, op)
				}
			}
			add("</section>")
		}

		def renderOperation(method string, template string, item PathItem, op Operation) {
			let id = op.operationId == "" ?? (method.lower() + template, op.operationId)
			add("<details class=\"operation" + (op.deprecated ?? (" deprecated", "")) + "\" id=\"op-" + anchor(id) + "\"><summary>")
			add("<span class=\"method " + method.lower() + "\">" + esc(method) + "</span> <code class=\"path\">" + esc(template) + "</code> ")
			add("<span>" + esc(op.summary == "" ?? (item.summary, op.summary)) + "</span>")
			add(" <span class=\"badge muted\">deprecated</span>") when op.deprecated
			add("</summary><div class=\"body\">")
			add(markdown(op.description == "" ?? (item.description, op.description)))
			add("<p class=\"meta\">operationId <code>" + esc(op.operationId) + "</code></p>") unless op.operationId == ""
			let requirements = op.security
			let effective = requirements is none ?? (doc.security, requirements)
			if !(effective is none) && effective.len() > 0 {
				let options string[] = []
				for let r in effective {
					let names string[] = []
					for let (name, scopes) in r {
						names.push("<a href=\"#security-" + anchor(name) + "\">" + esc(name) + "</a>" + (scopes.len() > 0 ?? (" (" + esc(scopes.join(", ")) + ")", "")))
					}
					options.push(names.len() == 0 ?? ("none", names.join(" and ")))
				}
				add("<p class=\"meta\">Authentication: " + options.join(" or ") + "</p>")
			}
			let parameters Parameter[] = []
			parameters += item.parameters
			parameters += op.parameters
			renderParameters(parameters)
			let body = op.requestBody
			if !(body is none) {
				let b = resolveRequestBody(body)
				add("<h4>Request body" + (b.required ?? (" <span class=\"required\">required</span>", "")) + "</h4>")
				add(markdown(b.description))
				renderContent(b.content)
			}
			if op.responses.len() > 0 {
				add("<h4>Responses</h4><table><thead><tr><th>Status</th><th>Description</th></tr></thead><tbody>")
				let codes string[] = []
				for let (code, _) in op.responses {
					codes.push(code)
				}
				codes.sort((a string, b string) => (a == "default" ?? ("999", a)) < (b == "default" ?? ("999", b)))
				for let code in codes {
					let given = op.responses.get(code)
					continue when given is none
					let r = resolveResponse(given)
					add("<tr><td><code>" + esc(code) + "</code></td><td>" + markdown(r.description))
					add("<p class=\"meta\">Headers: " + headerNames(r.headers) + "</p>") when r.headers.len() > 0
					renderContent(r.content)
					add("</td></tr>")
				}
				add("</tbody></table>")
			}
			add("<p class=\"meta\">Callbacks: " + esc(keysOf(op.callbacks).join(", ")) + "</p>") when op.callbacks.len() > 0
			add("</div></details>")
		}

		def keysOf(m map<string, Callback>) string[] {
			let names string[] = []
			for let (k, _) in m {
				names.push(k)
			}
			return names
		}

		def headerNames(headers map<string, Header>) string {
			let names string[] = []
			for let (name, h) in headers {
				let resolved = resolveHeader(h)
				names.push("<code>" + esc(name) + "</code>" + (resolved.schema is none ?? ("", " " + schemaHTML(resolved.schema, 0))))
			}
			return names.join(", ")
		}

		def renderParameters(parameters Parameter[]) {
			return when parameters.len() == 0
			add("<h4>Parameters</h4><table><thead><tr><th>Name</th><th>In</th><th>Type</th><th>Description</th></tr></thead><tbody>")
			for let given in parameters {
				let p = resolveParameter(given)
				let schema = p.schema
				if schema is none && p.content.len() > 0 {
					for let (_, m) in p.content {
						schema = resolveMediaType(m).schema
					}
				}
				add("<tr" + (p.deprecated ?? (" class=\"deprecated\"", "")) + "><td><code>" + esc(p.name) + "</code>" + (p.required ?? (" <span class=\"required\">required</span>", "")) + "</td>")
				add("<td>" + locationName(p.location) + "</td><td>" + schemaHTML(schema, 0) + "</td><td>" + markdown(p.description) + "</td></tr>")
			}
			add("</tbody></table>")
		}

		def renderContent(content map<string, MediaType>) {
			for let (name, given) in content {
				let m = resolveMediaType(given)
				add("<div class=\"media\"><code class=\"mediatype\">" + esc(name) + "</code> ")
				add(schemaHTML(m.schema, 0)) unless m.schema is none
				add(" items: " + schemaHTML(m.itemSchema, 0)) unless m.itemSchema is none
				add("</div>")
			}
		}

		def renderSchemas() {
			return when doc.components.schemas.len() == 0
			add("<section id=\"schemas\"><h2>Schemas</h2>")
			for let (name, schema) in doc.components.schemas {
				add("<div class=\"schema\" id=\"schema-" + anchor(name) + "\"><h3>" + esc(name) + "</h3>")
				if schema is map<string, any> && schema.hasKey("description") {
					let d = schema["description"]
					add(markdown(d)) when d is string
				}
				add(schemaHTML(schema, 0, true))
				add("</div>")
			}
			add("</section>")
		}

		// A schema as HTML: a reference to a component as a link, a type
		// with its constraints, an object's properties as a table (three
		// levels deep, or all of them for a component itself).
		def schemaHTML(schema any, depth int, expand bool = false) string {
			return schema ?? ("<span class=\"type\">any</span>", "<span class=\"type\">nothing</span>") when schema is bool
			return "<span class=\"type\">any</span>" unless schema is map<string, any>
			let ref = schema.hasKey("$ref") ?? (schema["$ref"], none)
			if ref is string {
				let prefix = "#/components/schemas/"
				if ref.startsWith(prefix) {
					let name = unescapePointer(ref[prefix.len():])
					return "<a class=\"type\" href=\"#schema-" + anchor(name) + "\">" + esc(name) + "</a>"
				}
				return "<code>" + esc(ref) + "</code>"
			}
			let parts string[] = []
			let t = schema.hasKey("type") ?? (schema["type"], none)
			let typeText = ""
			if t is string {
				typeText = t
			} else if t is any[] {
				let names string[] = []
				for let item in t {
					names.push(item) when item is string
				}
				typeText = names.join(" | ")
			}
			let format = schema.hasKey("format") ?? (schema["format"], none)
			typeText += " (" + format + ")" when format is string
			let nullable any = schema.hasKey("nullable") ?? (schema["nullable"], false)
			typeText += " | null" when nullable is bool && nullable
			let items = schema.hasKey("items") ?? (schema["items"], none)
			return "<span class=\"type\">array of</span> " + schemaHTML(items, depth + 1) when !(items is none) && !(items is any[])
			parts.push("<span class=\"type\">" + esc(typeText) + "</span>") unless typeText == ""
			for let keyword in ["oneOf", "anyOf", "allOf"] {
				let list = schema.hasKey(keyword) ?? (schema[keyword], none)
				if list is any[] {
					let joined string[] = []
					for let sub in list {
						joined.push(schemaHTML(sub, depth + 1))
					}
					let word = keyword == "allOf" ?? (" and ", keyword == "oneOf" ?? (" or ", " and/or "))
					parts.push(joined.join(word))
				}
			}
			let values = schema.hasKey("enum") ?? (schema["enum"], none)
			if values is any[] {
				let shown string[] = []
				for let v in values {
					shown.push("<code>" + esc(plainText(v)) + "</code>")
				}
				parts.push("one of " + shown.join(", "))
			}
			parts.push("always <code>" + esc(plainText(schema["const"])) + "</code>") when schema.hasKey("const")
			for let bound in ["minimum", "maximum", "exclusiveMinimum", "exclusiveMaximum", "minLength", "maxLength", "pattern", "minItems", "maxItems", "multipleOf"] {
				let v = schema.hasKey(bound) ?? (schema[bound], none)
				parts.push("<small>" + bound + " " + esc(plainText(v)) + "</small>") unless v is none || v is bool
			}
			let props = schema.hasKey("properties") ?? (schema["properties"], none)
			if props is map<string, any> && props.len() > 0 {
				if depth >= 3 && !expand {
					parts.push("<span class=\"type\">object</span> …")
				} else {
					let required = schema.hasKey("required") ?? (schema["required"], none)
					let table = "<table class=\"properties\"><tbody>"
					for let (name, sub) in props {
						let isRequired = required is any[] && required.includes(name)
						let description any = sub is map<string, any> && sub.hasKey("description") ?? (sub["description"], "")
						let described = ""
						described = markdown(description) when description is string
						table += "<tr><td><code>" + esc(name) + "</code>" + (isRequired ?? (" <span class=\"required\">required</span>", "")) + "</td><td>" + schemaHTML(sub, depth + 1) + described + "</td></tr>"
					}
					table += "</tbody></table>"
					parts.push(table)
				}
			}
			return parts.len() == 0 ?? ("<span class=\"type\">any</span>", parts.join(" "))
		}

		def resolveParameter(p Parameter) Parameter {
			return p when p.ref == ""
			let target = lookup(p.ref)
			return p unless target is map<string, any>
			return parameterOf(target, "") onerror (err error) {
				return p
			}
		}

		def resolveRequestBody(b RequestBody) RequestBody {
			return b when b.ref == ""
			let target = lookup(b.ref)
			return b unless target is map<string, any>
			return requestBodyOf(target, "") onerror (err error) {
				return b
			}
		}

		def resolveResponse(r Response) Response {
			return r when r.ref == ""
			let target = lookup(r.ref)
			return r unless target is map<string, any>
			let resolved = responseOf(target, "") onerror (err error) {
				return r
			}
			resolved.description = r.description when r.description != ""
			return resolved
		}

		def resolveHeader(h Header) Header {
			return h when h.ref == ""
			let target = lookup(h.ref)
			return h unless target is map<string, any>
			return headerOf(target, "") onerror (err error) {
				return h
			}
		}

		def resolveMediaType(m MediaType) MediaType {
			return m when m.ref == ""
			let target = lookup(m.ref)
			return m unless target is map<string, any>
			return mediaTypeOf(target, "") onerror (err error) {
				return m
			}
		}

		// The value a local reference names, none for another document.
		def lookup(ref string) any {
			return none unless ref.startsWith("#")
			return pointerValue(doc.tree(), ref[1:])
		}
	}

	internal def esc(text string) string {
		return htmlEncode(text)
	}

	internal def plainText(value any) string {
		return value when value is string
		return string(new JSON().encode(value))
	}

	internal def anchor(text string) string {
		return text.replace(" ", "-", -1).replace("\"", "", -1).replace("<", "", -1).replace(">", "", -1).replace("&", "", -1)
	}

	// A link, its target checked: only http, https, mailto and anchors.
	internal def linkTo(target string, text string) string {
		let shown = text == "" ?? (target, text)
		return esc(shown) unless safeURL(target)
		return "<a href=\"" + esc(target) + "\">" + esc(shown) + "</a>"
	}

	internal def safeURL(target string) bool {
		let lower = target.lower().trim()
		return lower.startsWith("http://") || lower.startsWith("https://") || lower.startsWith("mailto:") || lower.startsWith("#") || (lower != "" && !lower.contains(":"))
	}

	// CommonMark as HTML, with HTML in it turned to text and links to other
	// schemes than http, https and mailto dropped.
	internal def markdown(text string) string {
		return "" when text.trim() == ""
		let doc = new Markdown().decode(text)
		for let block in doc.blocks {
			sanitizeBlock(block)
		}
		let html = new Html(fragment: true).encode(doc)
		return "<div class=\"md\">" + string(html) + "</div>"
	}

	internal def sanitizeBlock(block Block) {
		if block.kind == BlockKind.Raw {
			block.kind = BlockKind.Code
			block.language = ""
		}
		block.source = "" unless safeURL(block.source)
		for let inline in block.inlines {
			sanitizeInline(inline)
		}
		for let child in block.children {
			sanitizeBlock(child)
		}
	}

	internal def sanitizeInline(inline Inline) {
		inline.kind = InlineKind.Text when inline.kind == InlineKind.Raw
		inline.url = "" unless safeURL(inline.url)
		for let child in inline.children {
			sanitizeInline(child)
		}
		for let block in inline.note {
			sanitizeBlock(block)
		}
	}

	internal const pageStyle = ":root\{--fg:#1d2330;--bg:#fff;--muted:#6b7385;--line:#e3e6ec;--soft:#f5f6f9;--accent:#3557c5\}@media (prefers-color-scheme:dark)\{:root\{--fg:#e3e6ec;--bg:#14171d;--muted:#98a0b3;--line:#2b303b;--soft:#1c2028;--accent:#8aa4ff\}\}*\{box-sizing:border-box\}body\{margin:0;font:15px/1.5 system-ui,-apple-system,Segoe UI,sans-serif;color:var(--fg);background:var(--bg)\}header\{padding:24px 32px;border-bottom:1px solid var(--line)\}h1\{margin:0 0 6px;font-size:28px\}main\{display:flex;align-items:flex-start\}nav\{position:sticky;top:0;width:220px;flex:none;padding:16px 24px;max-height:100vh;overflow:auto\}nav h2\{font-size:13px;text-transform:uppercase;color:var(--muted);margin:16px 0 6px\}nav ul\{list-style:none;padding:0;margin:0\}nav li\{margin:3px 0\}.content\{flex:1;min-width:0;padding:8px 32px 48px\}a\{color:var(--accent)\}code\{font:13px ui-monospace,SFMono-Regular,Menlo,monospace\}.meta\{color:var(--muted);font-size:13px\}.badge\{display:inline-block;padding:1px 8px;border-radius:10px;background:var(--accent);color:var(--bg);font-size:12px\}.badge.muted\{background:var(--line);color:var(--muted)\}.summary\{font-size:16px\}details.operation\{border:1px solid var(--line);border-radius:8px;margin:10px 0;background:var(--soft)\}details.operation>summary\{cursor:pointer;padding:10px 14px\}details.operation .body\{padding:4px 16px 14px;background:var(--bg);border-top:1px solid var(--line);border-radius:0 0 8px 8px\}.deprecated\{opacity:.65\}.deprecated .path\{text-decoration:line-through\}.method\{display:inline-block;min-width:64px;text-align:center;font-weight:600;font-size:12px;padding:2px 6px;border-radius:4px;color:#fff;background:#6b7385\}.method.get\{background:#2f80ed\}.method.post\{background:#27ae60\}.method.put\{background:#d68910\}.method.patch\{background:#8e44ad\}.method.delete\{background:#c0392b\}.method.query\{background:#16a085\}table\{border-collapse:collapse;width:100%;margin:6px 0 12px\}th,td\{text-align:left;vertical-align:top;padding:6px 8px;border-bottom:1px solid var(--line)\}th\{font-size:12px;color:var(--muted);font-weight:600\}table.properties td:first-child\{width:30%\}.type\{color:var(--accent);font-size:13px\}.required\{color:#c0392b;font-size:11px;text-transform:uppercase\}.media\{margin:4px 0\}.mediatype\{color:var(--muted)\}.schema\{border-top:1px solid var(--line);padding-top:8px\}.md p\{margin:4px 0\}@media (max-width:760px)\{main\{display:block\}nav\{position:static;width:auto\}.content\{padding:8px 16px 32px\}\}"
}
