partial module std.net.http.openapi {
	use std.errors

	// OpenAPI descriptions of HTTP APIs: OpenAPI 3.2 documents built in code
	// or read from JSON or YAML (versions 3.0, 3.1 and 3.2), written back,
	// checked against the specification, completed from a server's routes,
	// served with a documentation page, and used to validate requests and
	// responses.
	//
	//     let doc = try openapi.parse(try os.readFile("openapi.yaml"))
	//     let validator = try doc.validator()
	//     mux.apply(validator.middleware())
	//     try doc.serve(mux)
	//
	// Schemas are JSON Schema (2020-12 with the OpenAPI dialect, or the
	// OpenAPI 3.0 schema object for 3.0 documents) held as parsed JSON
	// values; `jsonschema.schemaOf` makes one from an ADM type.

	// The version of the OpenAPI Specification a document built here
	// follows.
	const specVersion = "3.2.0"

	// OpenAPIError is the payload of a description that cannot be read,
	// resolved or used.
	struct OpenAPIError {
		message string
		code    string            = "openapi"
		cause   ?error
		stack   errors.StackTrace
		// Where in the document, as a JSON Pointer ("" for the whole).
		pointer string            = ""
	}

	internal def openapiError(pointer string, problem string) OpenAPIError {
		let place = pointer == "" ?? ("", " at {pointer}")
		return OpenAPIError{message: "openapi{place}: {problem}", pointer: pointer}
	}

	// An OpenAPI description: the OpenAPI Object.
	partial type Document {
		// The OpenAPI Specification version: "3.2.0" for a document built
		// here, the document's own when read.
		openapi           string                   = specVersion
		// `$self`: the document's own URI, its base for references.
		selfURI           string                   = ""
		info              Info
		// The default `$schema` of the document's Schema Objects.
		jsonSchemaDialect string                   = ""
		servers           Server[]                 = []
		// Path templates (`/users/{id}`) and what they serve.
		paths             map<string, PathItem>
		// `x-` fields of the Paths Object.
		pathExtensions    map<string, any>
		webhooks          map<string, PathItem>
		components        Components
		// Alternative security requirements: scheme names and their scopes.
		security          ?map<string, string[]>[] = none
		tags              Tag[]                    = []
		externalDocs      ?ExternalDocs            = none
		// `x-` fields, by name with the prefix.
		extensions        map<string, any>

		def new() {
			info = Info{}
			paths = map<string, PathItem>{}
			pathExtensions = map<string, any>{}
			webhooks = map<string, PathItem>{}
			components = new Components()
			extensions = map<string, any>{}
		}

		def new(title string, version string) {
			info = Info{title: title, version: version}
			paths = map<string, PathItem>{}
			pathExtensions = map<string, any>{}
			webhooks = map<string, PathItem>{}
			components = new Components()
			extensions = map<string, any>{}
		}

		// The Path Item for a path template, made when it is not there.
		def path(template string) PathItem {
			let found = paths.get(template)
			return found unless found is none
			let item = new PathItem()
			paths[template] = item
			return item
		}

		// The operation for a method (any case) and path template, none
		// when the document has none.
		def operation(method string, template string) ?Operation {
			let item = paths.get(template)
			return none when item is none
			return item.operation(method)
		}

		// The operation with this operationId, with its method and path.
		def operationById(id string) ?(string, string, Operation) {
			for let (template, item) in paths {
				for let entry in item.all() {
					let (method, op) = entry
					return (method, template, op) when op.operationId == id
				}
			}
			return none
		}

		// The major and minor version of the document: (3, 0), (3, 1) or
		// (3, 2).
		def version() (int, int) {
			let parts = openapi.split(".")
			let major = parts.len() > 0 && /^[0-9]+$/.test(parts[0]) ?? (parseInt<int>(parts[0]), 0)
			let minor = parts.len() > 1 && /^[0-9]+$/.test(parts[1]) ?? (parseInt<int>(parts[1]), 0)
			return (major, minor)
		}
	}

	// The Info Object: what the API is.
	struct Info {
		title          string           = ""
		summary        string           = ""
		description    string           = ""
		termsOfService string           = ""
		contact        ?Contact         = none
		license        ?License         = none
		version        string           = ""
		extensions     map<string, any>
	}

	// The Contact Object: who to ask about the API.
	struct Contact {
		name       string           = ""
		url        string           = ""
		email      string           = ""
		extensions map<string, any>
	}

	// The License Object: `identifier` is an SPDX expression, exclusive with
	// `url`.
	struct License {
		name       string           = ""
		identifier string           = ""
		url        string           = ""
		extensions map<string, any>
	}

	// The Server Object: a base URL, which may hold `{variables}`.
	struct Server {
		url         string                      = ""
		description string                      = ""
		name        string                      = ""
		variables   map<string, ServerVariable>
		extensions  map<string, any>
	}

	// A variable of a server URL: its default and the values it may take.
	struct ServerVariable {
		// The values the variable may take (`enum`); empty for any.
		values       string[]         = []
		defaultValue string           = ""
		description  string           = ""
		extensions   map<string, any>
	}

	// The External Documentation Object: a link to more.
	struct ExternalDocs {
		description string           = ""
		url         string           = ""
		extensions  map<string, any>
	}

	// The Tag Object; `parent` nests tags, `kind` says what a tag is for
	// (`nav`, `badge`, `audience`, ...).
	struct Tag {
		name         string           = ""
		summary      string           = ""
		description  string           = ""
		externalDocs ?ExternalDocs    = none
		parent       string           = ""
		kind         string           = ""
		extensions   map<string, any>
	}

	// The Components Object: reusable parts, by name.
	type Components {
		schemas         map<string, any>
		responses       map<string, Response>
		parameters      map<string, Parameter>
		examples        map<string, Example>
		requestBodies   map<string, RequestBody>
		headers         map<string, Header>
		securitySchemes map<string, SecurityScheme>
		links           map<string, Link>
		callbacks       map<string, Callback>
		pathItems       map<string, PathItem>
		mediaTypes      map<string, MediaType>
		extensions      map<string, any>

		def new() {
			schemas = map<string, any>{}
			responses = map<string, Response>{}
			parameters = map<string, Parameter>{}
			examples = map<string, Example>{}
			requestBodies = map<string, RequestBody>{}
			headers = map<string, Header>{}
			securitySchemes = map<string, SecurityScheme>{}
			links = map<string, Link>{}
			callbacks = map<string, Callback>{}
			pathItems = map<string, PathItem>{}
			mediaTypes = map<string, MediaType>{}
			extensions = map<string, any>{}
		}

		// Whether nothing is held.
		def isEmpty() bool {
			return schemas.len() == 0 && responses.len() == 0 && parameters.len() == 0 && examples.len() == 0 && requestBodies.len() == 0 && headers.len() == 0 && securitySchemes.len() == 0 && links.len() == 0 && callbacks.len() == 0 && pathItems.len() == 0 && mediaTypes.len() == 0 && extensions.len() == 0
		}
	}

	// The methods a Path Item names with a field of its own, in the
	// specification's order.
	const fixedMethods = ["get", "put", "post", "delete", "options", "head", "patch", "trace", "query"]

	// The Path Item Object: the operations of one path. `ref` makes it a
	// reference to another Path Item, whose fields it shares.
	type PathItem {
		ref                  string                 = ""
		summary              string                 = ""
		description          string                 = ""
		// The operations of the fixed methods, by lower-case method.
		operations           map<string, Operation>
		// Operations of other methods (`additionalOperations`), by the
		// method as sent (`LINK`, `COPY`).
		additionalOperations map<string, Operation>
		servers              Server[]               = []
		// Parameters every operation of the path takes.
		parameters           Parameter[]            = []
		extensions           map<string, any>

		def new() {
			operations = map<string, Operation>{}
			additionalOperations = map<string, Operation>{}
			extensions = map<string, any>{}
		}

		// The operation for a method, in any case.
		def operation(method string) ?Operation {
			let lower = method.lower()
			return operations.get(lower) when fixedMethods.includes(lower)
			for let (name, op) in additionalOperations {
				return op when name.upper() == method.upper()
			}
			return none
		}

		// Sets the operation for a method: a fixed one by its field, any
		// other under `additionalOperations`.
		def set(method string, op Operation) {
			let lower = method.lower()
			if fixedMethods.includes(lower) {
				operations[lower] = op
			} else {
				additionalOperations[method.upper()] = op
			}
		}

		// Every operation with its method (upper case), fixed methods first.
		def all() (string, Operation)[] {
			let out (string, Operation)[] = []
			for let method in fixedMethods {
				let op = operations.get(method)
				out.push((method.upper(), op)) unless op is none
			}
			for let (method, op) in additionalOperations {
				out.push((method, op))
			}
			return out
		}
	}

	// The Operation Object: one method of one path.
	type Operation {
		tags               string[]                 = []
		summary            string                   = ""
		description        string                   = ""
		externalDocs       ?ExternalDocs            = none
		operationId        string                   = ""
		parameters         Parameter[]              = []
		requestBody        ?RequestBody             = none
		// Responses by status code (`200`), range (`4XX`) or `default`.
		responses          map<string, Response>
		// `x-` fields of the Responses Object.
		responseExtensions map<string, any>
		callbacks          map<string, Callback>
		deprecated         bool                     = false
		// none: the document's requirements apply; empty: none at all.
		security           ?map<string, string[]>[] = none
		servers            Server[]                 = []
		extensions         map<string, any>

		def new() {
			responses = map<string, Response>{}
			responseExtensions = map<string, any>{}
			callbacks = map<string, Callback>{}
			extensions = map<string, any>{}
		}
	}

	// Where a parameter is (`in`).
	enum ParameterIn {
		Query,
		// The whole query string, described by `content` (3.2).
		QueryString,
		Header,
		Path,
		Cookie
	}

	// How a parameter or form field is serialized (`style`).
	enum Style {
		// The location's default: `form` for query and cookie, `simple`
		// for path and header.
		Default,
		Matrix,
		Label,
		Simple,
		Form,
		SpaceDelimited,
		PipeDelimited,
		DeepObject,
		Cookie
	}

	// The Parameter Object, or a Reference Object when `ref` is set (then
	// only `summary` and `description` count besides it).
	type Parameter {
		ref             string                 = ""
		summary         string                 = ""
		name            string                 = ""
		location        ParameterIn            = ParameterIn.Query
		description     string                 = ""
		// Path parameters are always required.
		required        bool                   = false
		deprecated      bool                   = false
		allowEmptyValue bool                   = false
		example         any                    = none
		hasExample      bool                   = false
		examples        map<string, Example>
		style           Style                  = Style.Default
		// none: the style's default (true for form and cookie).
		explode         ?bool                  = none
		allowReserved   bool                   = false
		// The schema, none when `content` describes the value.
		schema          any                    = none
		content         map<string, MediaType>
		extensions      map<string, any>

		def new() {
			examples = map<string, Example>{}
			content = map<string, MediaType>{}
			extensions = map<string, any>{}
		}

		def new(name string, location ParameterIn, schema any) {
			self.name = name
			self.location = location
			self.schema = schema
			required = location == ParameterIn.Path
			examples = map<string, Example>{}
			content = map<string, MediaType>{}
			extensions = map<string, any>{}
		}
	}

	// The Request Body Object, or a Reference Object when `ref` is set.
	type RequestBody {
		ref         string                 = ""
		summary     string                 = ""
		description string                 = ""
		// By media type or range (`application/json`, `image/*`).
		content     map<string, MediaType>
		required    bool                   = false
		extensions  map<string, any>

		def new() {
			content = map<string, MediaType>{}
			extensions = map<string, any>{}
		}
	}

	// The Media Type Object, or a Reference Object when `ref` is set (3.2).
	type MediaType {
		ref            string                = ""
		summary        string                = ""
		description    string                = ""
		schema         any                   = none
		// The schema of each item of a sequential media type (JSON Lines,
		// server-sent events, multipart/mixed).
		itemSchema     any                   = none
		example        any                   = none
		hasExample     bool                  = false
		examples       map<string, Example>
		// Encodings of form fields by name.
		encoding       map<string, Encoding>
		// Encodings of multipart parts by position, then for the rest.
		prefixEncoding Encoding[]            = []
		itemEncoding   ?Encoding             = none
		extensions     map<string, any>

		def new() {
			examples = map<string, Example>{}
			encoding = map<string, Encoding>{}
			extensions = map<string, any>{}
		}

		def new(schema any) {
			self.schema = schema
			examples = map<string, Example>{}
			encoding = map<string, Encoding>{}
			extensions = map<string, any>{}
		}
	}

	// The Encoding Object: how one form field or multipart part is written.
	type Encoding {
		// Media types the value may be, comma-separated; "" for the
		// default its type gives.
		contentType    string                = ""
		headers        map<string, Header>
		encoding       map<string, Encoding>
		prefixEncoding Encoding[]            = []
		itemEncoding   ?Encoding             = none
		style          Style                 = Style.Default
		explode        ?bool                 = none
		allowReserved  ?bool                 = none
		extensions     map<string, any>

		def new() {
			headers = map<string, Header>{}
			encoding = map<string, Encoding>{}
			extensions = map<string, any>{}
		}
	}

	// The Response Object, or a Reference Object when `ref` is set.
	type Response {
		ref         string                 = ""
		summary     string                 = ""
		description string                 = ""
		headers     map<string, Header>
		content     map<string, MediaType>
		links       map<string, Link>
		extensions  map<string, any>

		def new() {
			headers = map<string, Header>{}
			content = map<string, MediaType>{}
			links = map<string, Link>{}
			extensions = map<string, any>{}
		}

		def new(description string) {
			self.description = description
			headers = map<string, Header>{}
			content = map<string, MediaType>{}
			links = map<string, Link>{}
			extensions = map<string, any>{}
		}
	}

	// The Callback Object: requests the API makes, by runtime expression
	// (`{$request.body#/callbackUrl}`); a Reference Object when `ref` is
	// set.
	type Callback {
		ref         string                = ""
		summary     string                = ""
		description string                = ""
		expressions map<string, PathItem>
		extensions  map<string, any>

		def new() {
			expressions = map<string, PathItem>{}
			extensions = map<string, any>{}
		}
	}

	// The Example Object, or a Reference Object when `ref` is set.
	// `dataValue` and `serializedValue` (3.2) replace `value`.
	type Example {
		ref             string           = ""
		summary         string           = ""
		description     string           = ""
		dataValue       any              = none
		hasDataValue    bool             = false
		serializedValue string           = ""
		externalValue   string           = ""
		value           any              = none
		hasValue        bool             = false
		extensions      map<string, any>

		def new() {
			extensions = map<string, any>{}
		}
	}

	// The Link Object, or a Reference Object when `ref` is set.
	type Link {
		ref            string           = ""
		summary        string           = ""
		description    string           = ""
		operationRef   string           = ""
		operationId    string           = ""
		parameters     map<string, any>
		requestBody    any              = none
		hasRequestBody bool             = false
		server         ?Server          = none
		extensions     map<string, any>

		def new() {
			parameters = map<string, any>{}
			extensions = map<string, any>{}
		}
	}

	// The Header Object, or a Reference Object when `ref` is set.
	type Header {
		ref         string                 = ""
		summary     string                 = ""
		description string                 = ""
		required    bool                   = false
		deprecated  bool                   = false
		example     any                    = none
		hasExample  bool                   = false
		examples    map<string, Example>
		style       Style                  = Style.Default
		explode     ?bool                  = none
		schema      any                    = none
		content     map<string, MediaType>
		extensions  map<string, any>

		def new() {
			examples = map<string, Example>{}
			content = map<string, MediaType>{}
			extensions = map<string, any>{}
		}

		def new(schema any) {
			self.schema = schema
			examples = map<string, Example>{}
			content = map<string, MediaType>{}
			extensions = map<string, any>{}
		}
	}

	// What a security scheme is (`type`).
	enum SchemeKind {
		ApiKey,
		Http,
		MutualTLS,
		OAuth2,
		OpenIdConnect
	}

	// The Security Scheme Object, or a Reference Object when `ref` is set.
	type SecurityScheme {
		ref               string           = ""
		summary           string           = ""
		description       string           = ""
		kind              SchemeKind       = SchemeKind.Http
		// The header, query parameter or cookie of an API key.
		name              string           = ""
		location          ParameterIn      = ParameterIn.Header
		// The HTTP authentication scheme (`basic`, `bearer`).
		scheme            string           = ""
		bearerFormat      string           = ""
		flows             ?OAuthFlows      = none
		openIdConnectUrl  string           = ""
		oauth2MetadataUrl string           = ""
		deprecated        bool             = false
		extensions        map<string, any>

		def new() {
			extensions = map<string, any>{}
		}
	}

	// The OAuth 2 flows a scheme supports (`deviceAuthorization` is 3.2).
	struct OAuthFlows {
		implicit            ?OAuthFlow       = none
		password            ?OAuthFlow       = none
		clientCredentials   ?OAuthFlow       = none
		authorizationCode   ?OAuthFlow       = none
		deviceAuthorization ?OAuthFlow       = none
		extensions          map<string, any>
	}

	// One OAuth 2 flow: its endpoints and scopes (name to description).
	struct OAuthFlow {
		authorizationUrl       string              = ""
		deviceAuthorizationUrl string              = ""
		tokenUrl               string              = ""
		refreshUrl             string              = ""
		scopes                 map<string, string>
		extensions             map<string, any>
	}
}
