partial module std.net.http.openapi {
	use (
		std.testing
		std.net.http
		std.net.http.httptest
		std.data.encoding::(JSON)
	)

	@embed("testdata/pets.yaml")
	internal const petsYAML byte[]

	// A request with headers ("Name: value" lines) and a body.
	internal def testRequest(method string, target string, headers string[] = [], body string = "") !http.Request {
		let req = try httptest.newRequest(http.parseMethod(method), target, body)
		req.rawMethod = method when req.method == http.Method.Other
		for let line in headers {
			let colon = line.indexOf(":")
			req.headers.add(line[0:colon].trim(), line[colon + 1:].trim())
		}
		return req
	}

	// The problems of a request as "location name pointer: message" lines.
	internal def problemsOf(v Validator, req http.Request) string[] {
		return v.request(req).mapElem(p => "{p.location} {p.name} {p.pointer}".trim() + ": " + p.message)
	}

	internal def petsValidator() !Validator {
		return try (try parse(petsYAML)).validator()
	}

	check "OpenAPI" {
		// A 3.2 description reads into the model, writes back to the same
		// tree, and passes the specification's schema and rules.
		@test()
		def readsAndWritesDocuments() !none {
			let doc = try parse(petsYAML)
			assert doc.openapi == "3.2.0" && doc.selfURI == "https://example.com/pets/openapi.yaml"
			assert doc.info.title == "Pets" && doc.servers[0].name == "production"
			assert doc.tags[1].parent == "pets"
			let get = doc.operation("GET", "/pets")
			assert !(get is none) && get.parameters.len() == 6 && get.parameters[5].ref == "#/components/parameters/Trace"
			let query = doc.operation("query", "/search")
			assert !(query is none) && query.parameters[0].location == ParameterIn.QueryString
			assert doc.components.securitySchemes["bearer"].kind == SchemeKind.Http
			let found = doc.operationById("deletePet")
			assert !(found is none)
			let again = try parse(doc.json())
			assert string(new JSON().encode(again.tree())) == string(new JSON().encode(doc.tree()))
			let viaYAML = try parse(doc.yaml())
			assert string(new JSON().encode(viaYAML.tree())) == string(new JSON().encode(doc.tree()))
			let problems = doc.problems()
			assert problems.len() == 0
			assert parse("swagger: '2.0'\ninfo: \{title: x, version: '1'\}\npaths: \{\}\n") is error
			assert parse("openapi: 4.0.0\n") is error
			return none
		}

		// problems() finds what the schema and the rules refuse.
		@test()
		def findsProblems() !none {
			let doc = try parse("openapi: 3.1.0\ninfo: \{title: T, version: '1'\}\npaths:\n  /a/\{id\}:\n    get:\n      operationId: same\n      responses: \{'200': \{description: ok\}, '600': \{description: no\}\}\n  /a/\{key\}:\n    get:\n      operationId: same\n      security: [\{nope: []\}]\n      parameters: [\{name: key, in: path, required: true, schema: \{type: string\}\}]\n      responses: \{'200': \{description: ok\}\}\n  /b:\n    get:\n      parameters: [\{name: q, in: query, schema: \{$ref: '#/components/schemas/Missing'\}\}]\n      responses: \{'200': \{description: ok\}\}\n")
			let messages = doc.problems().mapElem(p => p.message).join("\n")
			assert messages.contains("differ only in parameter names")
			assert messages.contains("operationId \"same\" is used")
			assert messages.contains("\"600\" is not a response code")
			assert messages.contains("security scheme \"nope\" is not declared")
			assert messages.contains("has no path parameter \"id\"")
			assert messages.contains("Missing")
			let broken = try parse("openapi: 3.1.0\ninfo: \{version: '1'\}\npaths: \{\}\n")
			assert broken.problems().len() > 0
			return none
		}

		// Routes of a mux become operations with their path parameters.
		@test()
		def describesRoutes() !none {
			let mux = new http.ServeMux()
			let ok = def (ctx http.Context) !none {
				return ctx.text("ok")
			}
			try mux.get("/users/\{id\}", ok)
			try mux.post("/users", ok)
			try mux.handle("/any", ok)
			try mux.get("/files/\{path...\}", ok)
			let doc = new Document("Users", "1")
			assert doc.components.isEmpty()
			doc.addRoutes(mux)
			assert doc.path("/users/\{id\}").all().len() == 1
			assert doc.paths.len() == 2
			let get = doc.operation("GET", "/users/\{id\}")
			assert !(get is none) && get.parameters[0].name == "id" && get.parameters[0].required
			assert !(doc.operation("POST", "/users") is none)
			doc.info.version = "1.0"
			let problems = doc.problems()
			assert problems.len() == 0
			return none
		}

		// The page shows the API and its operations, and HTML in
		// descriptions as text.
		@test()
		def rendersThePage() !none {
			let doc = try parse(petsYAML)
			let page = doc.page("/openapi.json")
			assert page.contains("<title>Pets</title>")
			assert page.contains("<strong>pets</strong>")
			assert !page.contains("<script>")
			assert page.contains("id=\"op-listPets\"")
			assert page.contains("id=\"schema-Pet\"")
			return none
		}

		// Paths match concrete templates first, with or without the
		// server's path; methods and security are checked.
		@test()
		def matchesOperations() !none {
			let v = try petsValidator()
			let mine = v.operationFor("GET", "/pets/mine")
			assert !(mine is none) && mine.operation.operationId == "myPets"
			let byId = v.operationFor("GET", "/v1/pets/7")
			assert !(byId is none) && byId.template == "/pets/\{id\}" && byId.pathValues["id"] == "7"
			assert v.operationFor("GET", "/nothing") is none
			assert problemsOf(v, try testRequest("PUT", "/pets/7", ["X-Key: k"]))[0].startsWith("method")
			assert problemsOf(v, try testRequest("GET", "/pets"))[0].startsWith("security")
			assert problemsOf(v, try testRequest("GET", "/pets/mine")).len() == 0
			assert problemsOf(v, try testRequest("DELETE", "/pets/7", ["X-Key: k"]))[0].startsWith("security")
			assert problemsOf(v, try testRequest("DELETE", "/pets/7", ["Authorization: Bearer t"])).len() == 0
			return none
		}

		// Parameters in every style, against their schemas.
		@test()
		def checksParameters() !none {
			let v = try petsValidator()
			let key = ["X-Key: k"]
			assert problemsOf(v, try testRequest("GET", "/pets?limit=10&tags=a&tags=b&ids=1,2&color%5BR%5D=1&color[G]=2&sizes=s|m", key)).len() == 0
			assert problemsOf(v, try testRequest("GET", "/pets?limit=0", key))[0].startsWith("query limit")
			assert problemsOf(v, try testRequest("GET", "/pets?ids=1,x", key))[0].startsWith("query ids /1")
			assert problemsOf(v, try testRequest("GET", "/pets?color[R]=red", key))[0].startsWith("query color /R")
			assert problemsOf(v, try testRequest("GET", "/pets?sizes=s|xl", key))[0].startsWith("query sizes /1")
			assert problemsOf(v, try testRequest("GET", "/pets", ["X-Key: k", "X-Trace: not-a-uuid"]))[0].startsWith("header X-Trace")
			assert problemsOf(v, try testRequest("GET", "/pets/7", ["X-Key: k", "Cookie: session=abc123", "Fields: a,b"])).len() == 0
			assert problemsOf(v, try testRequest("GET", "/pets/x", ["X-Key: k", "Cookie: session=abc"]))[0].startsWith("path id")
			assert problemsOf(v, try testRequest("GET", "/pets/7", key))[0].startsWith("cookie session")
			assert problemsOf(v, try testRequest("GET", "/pets/7", ["X-Key: k", "Cookie: other=1; session=XYZ"]))[0].startsWith("cookie session")
			assert problemsOf(v, try testRequest("GET", "/shelves/.1,2/;x=3;y=4", key)).len() == 0
			assert problemsOf(v, try testRequest("GET", "/shelves/.1,b/;x=3;y=4", key))[0].startsWith("path shelf /1")
			assert problemsOf(v, try testRequest("GET", "/shelves/.1/;x=3;y=z", key))[0].startsWith("path coords /y")
			assert problemsOf(v, try testRequest("QUERY", "/search?term=ab&page=2", key)).len() == 0
			assert problemsOf(v, try testRequest("QUERY", "/search?term=a", key))[0].startsWith("querystring q /term")
			return none
		}

		// Bodies of every media type the operation takes.
		@test()
		def checksBodies() !none {
			let v = try petsValidator()
			let json = ["X-Key: k", "Content-Type: application/json"]
			assert problemsOf(v, try testRequest("POST", "/pets", json, "\{\"name\": \"Rex\", \"age\": 3\}")).len() == 0
			assert problemsOf(v, try testRequest("POST", "/pets", json, "\{\"age\": -1\}")).len() == 2
			assert problemsOf(v, try testRequest("POST", "/pets", json, "\{"))[0].contains("not JSON")
			assert problemsOf(v, try testRequest("POST", "/pets", ["X-Key: k"]))[0].contains("required")
			assert problemsOf(v, try testRequest("POST", "/pets", ["X-Key: k", "Content-Type: text/csv"], "a,b"))[0].startsWith("content-type")
			let form = ["X-Key: k", "Content-Type: application/x-www-form-urlencoded"]
			assert problemsOf(v, try testRequest("POST", "/pets", form, "name=Rex+Two&age=3")).len() == 0
			assert problemsOf(v, try testRequest("POST", "/pets", form, "name=Rex&age=old"))[0].startsWith("body  /age")
			let boundary = "XyZ"
			let multipartBody = "--XyZ\r\nContent-Disposition: form-data; name=\"name\"\r\n\r\nRex\r\n--XyZ\r\nContent-Disposition: form-data; name=\"age\"\r\n\r\n4\r\n--XyZ\r\nContent-Disposition: form-data; name=\"photo\"; filename=\"p.png\"\r\nContent-Type: image/png\r\n\r\nPNG\r\n--XyZ--\r\n"
			let multipartHeaders = ["X-Key: k", "Content-Type: multipart/form-data; boundary={boundary}"]
			assert problemsOf(v, try testRequest("POST", "/pets", multipartHeaders, multipartBody)).len() == 0
			let missingPhoto = "--XyZ\r\nContent-Disposition: form-data; name=\"name\"\r\n\r\nRex\r\n--XyZ--\r\n"
			assert problemsOf(v, try testRequest("POST", "/pets", multipartHeaders, missingPhoto))[0].contains("photo")
			let xml = ["X-Key: k", "Content-Type: application/xml"]
			assert problemsOf(v, try testRequest("POST", "/pets", xml, "<pet id=\"3\"><name>Rex</name><age>2</age><aliases><alias>R</alias></aliases></pet>")).len() == 0
			assert problemsOf(v, try testRequest("POST", "/pets", xml, "<pet id=\"x\"><name>Rex</name></pet>"))[0].startsWith("body  /id")
			assert problemsOf(v, try testRequest("POST", "/pets", ["X-Key: k", "Content-Type: image/png"], "small")).len() == 0
			assert problemsOf(v, try testRequest("POST", "/pets", ["X-Key: k", "Content-Type: image/png"], "far more than sixteen bytes"))[0].contains("maxLength")
			assert v.webhook("newPet", try testRequest("POST", "/hook", ["Content-Type: application/json"], "\{\"id\": 1, \"name\": \"a\"\}")).len() == 0
			assert v.webhook("newPet", try testRequest("POST", "/hook", ["Content-Type: application/json"], "\{\"id\": 1\}"))[0].message.contains("name")
			assert v.webhook("other", try testRequest("POST", "/hook"))[0].location == "path"
			return none
		}

		// Responses: the documented status (by code, range or default),
		// required headers, and content including sequences.
		@test()
		def checksResponses() !none {
			let v = try petsValidator()
			let req = try testRequest("GET", "/pets", ["X-Key: k"])
			let headers = new http.Header()
			headers.set("Content-Type", "application/json")
			headers.set("X-Total", "1")
			assert v.response(req, 200, headers, "[\{\"id\": 1, \"name\": \"a\", \"tag\": null\}]".bytes()).len() == 0
			assert v.response(req, 200, headers, "[\{\"id\": 1\}]".bytes())[0].pointer == "/0"
			assert v.response(req, 500, headers, "[]".bytes())[0].location == "status"
			let problem = new http.Header()
			problem.set("Content-Type", "application/problem+json")
			assert v.response(req, 404, problem, "\{\"title\": \"x\"\}".bytes()).len() == 0
			let lines = new http.Header()
			lines.set("Content-Type", "application/jsonl")
			lines.set("X-Total", "2")
			assert v.response(req, 200, lines, "\{\"id\": 1, \"name\": \"a\"\}\n\{\"id\": 2\}\n".bytes())[0].pointer == "/1"
			let noTotal = new http.Header()
			noTotal.set("Content-Type", "application/json")
			assert v.response(req, 200, noTotal, "[]".bytes())[0].name == "X-Total"
			return none
		}

		// The middleware answers a request the description does not allow
		// with a problem document, and passes the rest on.
		@test()
		def refusesInMiddleware() !none {
			let v = try petsValidator()
			let mux = new http.ServeMux()
			mux.apply(v.middleware())
			try mux.get("/pets", def (ctx http.Context) !none {
				return ctx.text("listed")
			})
			let rec = new httptest.ResponseRecorder()
			try mux.serve(rec.context(try testRequest("GET", "/pets?limit=500", ["X-Key: k"])))
			assert rec.status == 400 && rec.header("Content-Type").startsWith("application/problem+json")
			let body = try new JSON().parse(rec.body)
			assert body is map<string, any>
			let ok = new httptest.ResponseRecorder()
			try mux.serve(ok.context(try testRequest("GET", "/pets?limit=5", ["X-Key: k"])))
			assert ok.status == 200 && ok.text() == "listed"
			let unauthorized = new httptest.ResponseRecorder()
			try mux.serve(unauthorized.context(try testRequest("GET", "/pets")))
			assert unauthorized.status == 401
			return none
		}

		// A 3.0 document's schemas: nullable and boolean exclusive bounds.
		@test()
		def readsVersion30Schemas() !none {
			let doc = try parse("openapi: 3.0.3\ninfo: \{title: T, version: '1'\}\npaths:\n  /n:\n    get:\n      parameters:\n        - \{name: n, in: query, schema: \{type: number, maximum: 10, exclusiveMaximum: true, nullable: true\}\}\n      responses: \{'200': \{description: ok\}\}\n")
			assert doc.problems().len() == 0
			let v = try doc.validator()
			assert problemsOf(v, try testRequest("GET", "/n?n=9")).len() == 0
			assert problemsOf(v, try testRequest("GET", "/n?n=10")).len() == 1
			return none
		}

		// serve answers the document as JSON and YAML and the page.
		@test()
		def servesTheDocument() !none {
			let doc = try parse(petsYAML)
			let mux = new http.ServeMux()
			try doc.serve(mux)
			let json = new httptest.ResponseRecorder()
			try mux.serve(json.context(try testRequest("GET", "/openapi.json")))
			assert json.header("Content-Type").startsWith("application/openapi+json")
			assert (try parse(json.body)).info.title == "Pets"
			let yaml = new httptest.ResponseRecorder()
			try mux.serve(yaml.context(try testRequest("GET", "/openapi.yaml")))
			assert (try parse(yaml.body)).paths.len() == doc.paths.len()
			let page = new httptest.ResponseRecorder()
			try mux.serve(page.context(try testRequest("GET", "/openapi")))
			assert page.text().contains("List pets")
			return none
		}
	}
}
