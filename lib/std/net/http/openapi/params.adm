partial module std.net.http.openapi {
	use (
		std.net.http
		std.net.url
	)

	partial type Validator {
		// The problems of one parameter of a request: missing when
		// required, or its value, read by its chosen or media type, against
		// its schema.
		internal def checkParameter(plan ParameterPlan, req http.Request, pathValues map<string, string>) Problem[] {
			let p = plan.parameter
			let place = locationName(p.location)
			let lower = p.name.lower()
			if p.location == ParameterIn.Header && (lower := "accept" || "content-type" || "authorization") {
				return []
			}
			if p.content.len() > 0 {
				let raw = rawParameterText(p, req, pathValues)
				return p.required ?? ([Problem{location: place, name: p.name, message: "the required {place} parameter \"{p.name}\" is missing"}], []) when raw is none
				let (mediaType, given) = firstEntry(p.content)
				let (m, mat) = resolveMediaTypeAt(given, plan.at + "/content/" + escapePointer(mediaType))
				return checkMediaValue(mediaType, mediaType, raw.bytes(), m, mat, place, p.name)
			}
			let value = parameterValue(p, req, pathValues)
			return p.required ?? ([Problem{location: place, name: p.name, message: "the required {place} parameter \"{p.name}\" is missing"}], []) when value is none
			let (present, data) = value
			return [] unless present
			return [] when p.schema is none
			return checkSchema(plan.at + "/schema", data, place, p.name)
		}

		// The text of a parameter described by content: the path segment or
		// query value decoded, the header or cookie as sent, the whole query
		// string; none when it is not there.
		internal def rawParameterText(p Parameter, req http.Request, pathValues map<string, string>) ?string {
			switch p.location {
				case ParameterIn.Path:
					let raw = pathValues.get(p.name)
					return none when raw is none
					return url.pathUnescape(raw) onerror recover raw
				case ParameterIn.Query:
					for let pair in queryPairs(req.url.rawQuery) {
						let (name, value) = pair
						return formDecode(value) when formDecode(name) == p.name
					}
					return none
				case ParameterIn.QueryString:
					return req.url.rawQuery
				case ParameterIn.Header:
					let values = req.headers.values(p.name)
					return values.len() == 0 ?? (none, values.join(", "))
				default:
					for let pair in cookiePairs(req) {
						let (name, value) = pair
						return value when name == p.name
					}
					return none
			}
		}

		// A parameter's value read by its style: none when it is not in the
		// request; (false, none) when it is there but empty and
		// `allowEmptyValue` says it is unused.
		internal def parameterValue(p Parameter, req http.Request, pathValues map<string, string>) ?(bool, any) {
			let schema = p.schema
			let explode = p.explode
			switch p.location {
				case ParameterIn.Path:
					let raw = pathValues.get(p.name)
					return none when raw is none
					let chosen = p.style == Style.Default ?? (Style.Simple, p.style)
					let exploded = explode is none ?? (false, explode)
					return (true, uriStyled(chosen, exploded, p.name, raw, schema, true))
				case ParameterIn.Header:
					let values = req.headers.values(p.name)
					return none when values.len() == 0
					let exploded = explode is none ?? (false, explode)
					return (true, uriStyled(Style.Simple, exploded, p.name, values.join(","), schema, false))
				case ParameterIn.Cookie:
					let chosen = p.style == Style.Default ?? (Style.Form, p.style)
					let exploded = explode is none ?? (true, explode)
					let pairs = cookiePairs(req)
					let decode = chosen == Style.Form
					return pairsStyled(p.name, exploded, pairs, schema, decode = decode, query = false)
				default:
					let chosen = p.style == Style.Default ?? (Style.Form, p.style)
					let exploded = explode is none ?? (chosen == Style.Form, explode)
					let pairs = queryPairs(req.url.rawQuery)
					switch chosen {
						case Style.DeepObject:
							return deepObject(p.name, pairs, schema)
						case Style.SpaceDelimited, Style.PipeDelimited:
							for let pair in pairs {
								let (name, value) = pair
								continue unless formDecode(name) == p.name
								let delimiter = chosen == Style.SpaceDelimited ?? (" ", "|")
								// The delimiter as sent: a space may come as `+`
								// or `%20`, a pipe as `%7C`.
								let parts = formDecode(value).split(delimiter)
								return (true, collection(parts, schema, false))
							}
							return none
						default:
							let found = pairsStyled(p.name, exploded, pairs, schema, decode = true, query = true)
							if !(found is none) && p.allowEmptyValue {
								let (_, data) = found
								return (false, none) when data is string && data == ""
							}
							return found
					}
			}
		}

		// A value in a URI-template style: `simple` (also headers),
		// `label` (`.blue`), `matrix` (`;color=blue`); pieces percent-decoded
		// when `decode`.
		internal def uriStyled(chosen Style, explode bool, name string, raw string, schema any, decode bool) any {
			let text = raw
			let separator = ","
			if chosen == Style.Label {
				text = text.trimPrefix(".")
				separator = explode ?? (".", ",")
			} else if chosen == Style.Matrix {
				text = text.trimPrefix(";")
				if explode {
					separator = ";"
				} else {
					text = text.trimPrefix(name + "=")
					text = "" when text == name
				}
			}
			let types = schemas.typesOf(schema)
			let isArray = types.includes("array")
			let isObject = types.includes("object") && !isArray
			if chosen == Style.Matrix && explode && !isObject {
				// `;color=blue;color=black`: each piece names the parameter.
				let values string[] = []
				for let piece in text.split(";") {
					values.push(piece.trimPrefix(name + "=").trimPrefix(name))
				}
				text = values.join(";")
			}
			if isArray {
				let parts = text == "" ?? ([], text.split(separator))
				return collection(parts, schema, decode)
			}
			if isObject {
				let out = map<string, any>{}
				let parts = text == "" ?? ([], text.split(separator))
				if explode {
					for let part in parts {
						let eq = part.indexOf("=")
						continue when eq < 0
						let key = decodePiece(part[0:eq], decode)
						out[key] = scalar(decodePiece(part[eq + 1:], decode), schemas.propertySchema(schema, key))
					}
				} else {
					for let i = 0; i + 1 < parts.len(); i += 2 {
						let key = decodePiece(parts[i], decode)
						out[key] = scalar(decodePiece(parts[i + 1], decode), schemas.propertySchema(schema, key))
					}
				}
				return out
			}
			return scalar(decodePiece(text, decode), schema)
		}

		// A value from name-value pairs (`form` query and cookie styles):
		// none when no pair belongs to it.
		internal def pairsStyled(name string, explode bool, pairs (string, string)[], schema any, decode bool, query bool) ?(bool, any) {
			let types = schemas.typesOf(schema)
			let isArray = types.includes("array")
			let isObject = types.includes("object") && !isArray
			let unescape = def (text string) string {
				return decode ?? (query ?? (formDecode(text), url.pathUnescape(text) onerror recover text), text)
			}
			if isObject && explode {
				// `R=100&G=200`: the pairs named by the object's properties.
				let out = map<string, any>{}
				for let pair in pairs {
					let (rawName, rawValue) = pair
					let key = unescape(rawName)
					let propertySchema = schemas.propertySchema(schema, key)
					continue when propertySchema is none
					out[key] = scalar(unescape(rawValue), propertySchema)
				}
				return out.len() == 0 ?? (none, (true, out))
			}
			let values string[] = []
			for let pair in pairs {
				let (rawName, rawValue) = pair
				continue unless unescape(rawName) == name
				if isArray && !explode || isObject {
					// Undecoded, so a comma in the data (sent as %2C) is
					// not taken for a delimiter.
					for let piece in rawValue == "" ?? ([], rawValue.split(",")) {
						values.push(unescape(piece))
					}
				} else {
					values.push(unescape(rawValue))
				}
			}
			let found = false
			for let pair in pairs {
				let (rawName, _) = pair
				found = true when unescape(rawName) == name
			}
			return none unless found
			return (true, collection(values, schema, false)) when isArray
			if isObject {
				let out = map<string, any>{}
				for let i = 0; i + 1 < values.len(); i += 2 {
					out[values[i]] = scalar(values[i + 1], schemas.propertySchema(schema, values[i]))
				}
				return (true, out)
			}
			return (true, scalar(values.len() == 0 ?? ("", values[0]), schema))
		}

		// `color[R]=100&color[G]=200`.
		internal def deepObject(name string, pairs (string, string)[], schema any) ?(bool, any) {
			let out = map<string, any>{}
			let found = false
			for let pair in pairs {
				let (rawName, rawValue) = pair
				let key = formDecode(rawName)
				continue unless key.startsWith(name + "[") && key.endsWith("]")
				let property = key[name.len() + 1:key.len() - 1]
				found = true
				out[property] = scalar(formDecode(rawValue), schemas.propertySchema(schema, property))
			}
			return none unless found
			return (true, out)
		}

		// Pieces as an array of the schema's items.
		internal def collection(parts string[], schema any, decode bool) any[] {
			let items = schemas.itemSchema(schema)
			let out any[] = []
			for let part in parts {
				out.push(scalar(decodePiece(part, decode), items))
			}
			return out
		}

		// A piece of text as the type its schema has (a boolean, an integer,
		// a number, null); as text when the schema allows strings or says
		// nothing, or when it does not read as the type.
		internal def scalar(text string, schema any) any {
			let types = schemas.typesOf(schema)
			return text when types.len() == 0 || types.includes("string")
			if types.includes("boolean") && (text := "true" || "false") {
				return text == "true"
			}
			return parseInt<int>(text) when (types.includes("integer") || types.includes("number")) && /^-?(0|[1-9][0-9]*)$/.test(text) && text.trimStart("-").len() <= 18
			return parseFloat<float>(text) when types.includes("number") && /^-?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][-+]?[0-9]+)?$/.test(text)
			return none when types.includes("null") && (text := "" || "null")
			return text
		}

		// The problems of a header of a response, read in the simple chosen
		// or by its media type.
		internal def checkHeaderValue(name string, raw string, h Header, at string) Problem[] {
			if h.content.len() > 0 {
				let (mediaType, given) = firstEntry(h.content)
				let (m, mat) = resolveMediaTypeAt(given, at + "/content/" + escapePointer(mediaType))
				return checkMediaValue(mediaType, mediaType, raw.bytes(), m, mat, "header", name)
			}
			return [] when h.schema is none
			let exploded = h.explode
			let value = uriStyled(Style.Simple, exploded is none ?? (false, exploded), name, raw, h.schema, false)
			return checkSchema(at + "/schema", value, "header", name)
		}
	}

	internal def decodePiece(text string, decode bool) string {
		return decode ?? (url.pathUnescape(text) onerror recover text, text)
	}

	// `application/x-www-form-urlencoded` decoding: `+` is a space.
	internal def formDecode(text string) string {
		return url.queryUnescape(text) onerror recover text
	}

	// The pairs of a query string as sent (not decoded).
	internal def queryPairs(rawQuery string) (string, string)[] {
		let out (string, string)[] = []
		return out when rawQuery == ""
		for let piece in rawQuery.split("&") {
			continue when piece == ""
			let eq = piece.indexOf("=")
			if eq < 0 {
				out.push((piece, ""))
			} else {
				out.push((piece[0:eq], piece[eq + 1:]))
			}
		}
		return out
	}

	// The name-value pairs of a request's Cookie headers, as sent.
	internal def cookiePairs(req http.Request) (string, string)[] {
		let out (string, string)[] = []
		for let header in req.headers.values("Cookie") {
			for let piece in header.split(";") {
				let item = piece.trim()
				continue when item == ""
				let eq = item.indexOf("=")
				if eq < 0 {
					out.push((item, ""))
				} else {
					let value = item[eq + 1:]
					// A quoted cookie value (RFC 6265) is the text between the
					// quotes.
					value = value[1:value.len() - 1] when value.len() >= 2 && value.startsWith("\"") && value.endsWith("\"")
					out.push((item[0:eq], value))
				}
			}
		}
		return out
	}

	// The first entry of a Content map (a parameter's or header's has one).
	internal def firstEntry(m map<string, MediaType>) (string, MediaType) {
		for let (key, value) in m {
			return (key, value)
		}
		return ("", new MediaType())
	}
}
