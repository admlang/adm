partial module std.net.http.openapi {
	use std.data.encoding::(YAML)

	// parse reads an OpenAPI description, JSON or YAML (any JSON document
	// is YAML), of version 3.0, 3.1 or 3.2. Fields the specification does not
	// name are kept as extensions when they start with `x-` and dropped
	// otherwise; schemas and examples are kept as they are.
	//
	// Fails with an OpenAPIError naming the place when the text is neither
	// JSON nor YAML, is a Swagger 2.0 document, names another OpenAPI
	// version, or a field has the wrong form (a string where an object
	// goes).
	def parse(input byte[]) !Document {
		let tree = try new YAML().parse(input)
		return try documentOf(tree)
	}

	// parse reads an OpenAPI description from text, as from bytes. Fails as
	// the bytes form does.
	def parse(input string) !Document {
		return try parse(input.bytes())
	}

	// A document from its parsed tree.
	internal def documentOf(tree any) !Document {
		fail openapiError("", "the document is not an object") unless tree is map<string, any>
		fail openapiError("", "this is a Swagger 2.0 document; only OpenAPI 3.x is read") when tree.hasKey("swagger")
		let version = text(tree, "openapi", "")
		fail openapiError("/openapi", "the document has no openapi version") when version == ""
		fail openapiError("/openapi", "OpenAPI {version} is not read here: 3.0, 3.1 and 3.2 are") unless /^3\.[012]\.[0-9]+(-.+)?$/.test(version)
		let doc = new Document()
		doc.openapi = version
		doc.selfURI = text(tree, "$self", "")
		doc.info = try infoOf(try object(tree, "info", "/info"), "/info")
		doc.jsonSchemaDialect = text(tree, "jsonSchemaDialect", "")
		doc.servers = try serversOf(tree, "servers", "/servers")
		let paths = try object(tree, "paths", "/paths")
		for let (template, value) in paths {
			continue when template.startsWith("x-")
			let at = "/paths/" + escapePointer(template)
			doc.paths[template] = try pathItemOf(try mustObject(value, at), at)
		}
		doc.pathExtensions = extensionsOf(paths)
		let webhooks = try object(tree, "webhooks", "/webhooks")
		for let (name, value) in webhooks {
			let at = "/webhooks/" + escapePointer(name)
			doc.webhooks[name] = try pathItemOf(try mustObject(value, at), at)
		}
		doc.components = try componentsOf(try object(tree, "components", "/components"), "/components")
		doc.security = try securityOf(tree["security"], "/security") when tree.hasKey("security")
		let tags = try array(tree, "tags", "/tags")
		for let (i, value) in tags {
			doc.tags.push(try tagOf(try mustObject(value, "/tags/{i}"), "/tags/{i}"))
		}
		doc.externalDocs = try externalDocsOf(try object(tree, "externalDocs", "/externalDocs"), "/externalDocs") when tree.hasKey("externalDocs")
		doc.extensions = extensionsOf(tree)
		return doc
	}

	// RFC 6901 escaping of one reference token.
	internal def escapePointer(token string) string {
		return token.replace("~", "~0", -1).replace("/", "~1", -1)
	}

	internal def unescapePointer(token string) string {
		return token.replace("~1", "/", -1).replace("~0", "~", -1)
	}

	// The `x-` fields of an object.
	internal def extensionsOf(m map<string, any>) map<string, any> {
		let out = map<string, any>{}
		for let (key, value) in m {
			out[key] = value when key.startsWith("x-")
		}
		return out
	}

	internal def mustObject(value any, at string) !map<string, any> {
		fail openapiError(at, "expected an object") unless value is map<string, any>
		return value
	}

	// The object under key, empty when absent.
	internal def object(m map<string, any>, key string, at string) !map<string, any> {
		return map<string, any>{} unless m.hasKey(key)
		let value = m[key]
		return map<string, any>{} when value is none
		return try mustObject(value, at)
	}

	internal def array(m map<string, any>, key string, at string) !any[] {
		return [] unless m.hasKey(key)
		let value = m[key]
		return [] when value is none
		fail openapiError(at, "expected an array") unless value is any[]
		return value
	}

	internal def text(m map<string, any>, key string, fallback string) string {
		return fallback unless m.hasKey(key)
		let value = m[key]
		return value is string ?? (value, fallback)
	}

	internal def textOf(m map<string, any>, key string, at string) !string {
		return "" unless m.hasKey(key)
		let value = m[key]
		return "" when value is none
		fail openapiError(at + "/" + key, "expected a string") unless value is string
		return value
	}

	internal def flag(m map<string, any>, key string, at string) !bool {
		return false unless m.hasKey(key)
		let value = m[key]
		return false when value is none
		fail openapiError(at + "/" + key, "expected a boolean") unless value is bool
		return value
	}

	internal def optionalFlag(m map<string, any>, key string, at string) !?bool {
		return none unless m.hasKey(key)
		return try flag(m, key, at)
	}

	internal def strings(m map<string, any>, key string, at string) !string[] {
		let out string[] = []
		for let (i, value) in try array(m, key, at + "/" + key) {
			fail openapiError("{at}/{key}/{i}", "expected a string") unless value is string
			out.push(value)
		}
		return out
	}

	internal def infoOf(m map<string, any>, at string) !Info {
		let out = Info{extensions: extensionsOf(m)}
		out.title = try textOf(m, "title", at)
		out.summary = try textOf(m, "summary", at)
		out.description = try textOf(m, "description", at)
		out.termsOfService = try textOf(m, "termsOfService", at)
		out.version = try textOf(m, "version", at)
		if m.hasKey("contact") {
			let c = try object(m, "contact", at + "/contact")
			out.contact = Contact{name: try textOf(c, "name", at + "/contact"), url: try textOf(c, "url", at + "/contact"), email: try textOf(c, "email", at + "/contact"), extensions: extensionsOf(c)}
		}
		if m.hasKey("license") {
			let l = try object(m, "license", at + "/license")
			out.license = License{name: try textOf(l, "name", at + "/license"), identifier: try textOf(l, "identifier", at + "/license"), url: try textOf(l, "url", at + "/license"), extensions: extensionsOf(l)}
		}
		return out
	}

	internal def serversOf(m map<string, any>, key string, at string) !Server[] {
		let out Server[] = []
		for let (i, value) in try array(m, key, at) {
			out.push(try serverOf(try mustObject(value, "{at}/{i}"), "{at}/{i}"))
		}
		return out
	}

	internal def serverOf(m map<string, any>, at string) !Server {
		let out = Server{variables: map<string, ServerVariable>{}, extensions: extensionsOf(m)}
		out.url = try textOf(m, "url", at)
		out.description = try textOf(m, "description", at)
		out.name = try textOf(m, "name", at)
		for let (name, value) in try object(m, "variables", at + "/variables") {
			let vat = at + "/variables/" + escapePointer(name)
			let v = try mustObject(value, vat)
			out.variables[name] = ServerVariable{values: try strings(v, "enum", vat), defaultValue: try textOf(v, "default", vat), description: try textOf(v, "description", vat), extensions: extensionsOf(v)}
		}
		return out
	}

	internal def externalDocsOf(m map<string, any>, at string) !ExternalDocs {
		return ExternalDocs{description: try textOf(m, "description", at), url: try textOf(m, "url", at), extensions: extensionsOf(m)}
	}

	internal def tagOf(m map<string, any>, at string) !Tag {
		let out = Tag{extensions: extensionsOf(m)}
		out.name = try textOf(m, "name", at)
		out.summary = try textOf(m, "summary", at)
		out.description = try textOf(m, "description", at)
		out.parent = try textOf(m, "parent", at)
		out.kind = try textOf(m, "kind", at)
		out.externalDocs = try externalDocsOf(try object(m, "externalDocs", at + "/externalDocs"), at + "/externalDocs") when m.hasKey("externalDocs")
		return out
	}

	internal def securityOf(value any, at string) !map<string, string[]>[] {
		fail openapiError(at, "expected an array") unless value is any[]
		let out map<string, string[]>[] = []
		for let (i, item) in value {
			let m = try mustObject(item, "{at}/{i}")
			let requirement = map<string, string[]>{}
			for let (name, _) in m {
				requirement[name] = try strings(m, name, "{at}/{i}")
			}
			out.push(requirement)
		}
		return out
	}

	internal def componentsOf(m map<string, any>, at string) !Components {
		let out = new Components()
		out.extensions = extensionsOf(m)
		for let (name, value) in try object(m, "schemas", at + "/schemas") {
			out.schemas[name] = value
		}
		for let (name, value) in try object(m, "responses", at + "/responses") {
			let rat = at + "/responses/" + escapePointer(name)
			out.responses[name] = try responseOf(try mustObject(value, rat), rat)
		}
		for let (name, value) in try object(m, "parameters", at + "/parameters") {
			let pat = at + "/parameters/" + escapePointer(name)
			out.parameters[name] = try parameterOf(try mustObject(value, pat), pat)
		}
		for let (name, value) in try object(m, "examples", at + "/examples") {
			let eat = at + "/examples/" + escapePointer(name)
			out.examples[name] = try exampleOf(try mustObject(value, eat), eat)
		}
		for let (name, value) in try object(m, "requestBodies", at + "/requestBodies") {
			let bat = at + "/requestBodies/" + escapePointer(name)
			out.requestBodies[name] = try requestBodyOf(try mustObject(value, bat), bat)
		}
		for let (name, value) in try object(m, "headers", at + "/headers") {
			let hat = at + "/headers/" + escapePointer(name)
			out.headers[name] = try headerOf(try mustObject(value, hat), hat)
		}
		for let (name, value) in try object(m, "securitySchemes", at + "/securitySchemes") {
			let sat = at + "/securitySchemes/" + escapePointer(name)
			out.securitySchemes[name] = try securitySchemeOf(try mustObject(value, sat), sat)
		}
		for let (name, value) in try object(m, "links", at + "/links") {
			let lat = at + "/links/" + escapePointer(name)
			out.links[name] = try linkOf(try mustObject(value, lat), lat)
		}
		for let (name, value) in try object(m, "callbacks", at + "/callbacks") {
			let cat = at + "/callbacks/" + escapePointer(name)
			out.callbacks[name] = try callbackOf(try mustObject(value, cat), cat)
		}
		for let (name, value) in try object(m, "pathItems", at + "/pathItems") {
			let iat = at + "/pathItems/" + escapePointer(name)
			out.pathItems[name] = try pathItemOf(try mustObject(value, iat), iat)
		}
		for let (name, value) in try object(m, "mediaTypes", at + "/mediaTypes") {
			let mat = at + "/mediaTypes/" + escapePointer(name)
			out.mediaTypes[name] = try mediaTypeOf(try mustObject(value, mat), mat)
		}
		return out
	}

	internal def pathItemOf(m map<string, any>, at string) !PathItem {
		let out = new PathItem()
		out.ref = try textOf(m, "$ref", at)
		out.summary = try textOf(m, "summary", at)
		out.description = try textOf(m, "description", at)
		for let method in fixedMethods {
			out.operations[method] = try operationOf(try mustObject(m[method], at + "/" + method), at + "/" + method) when m.hasKey(method)
		}
		for let (method, value) in try object(m, "additionalOperations", at + "/additionalOperations") {
			let oat = at + "/additionalOperations/" + escapePointer(method)
			out.additionalOperations[method] = try operationOf(try mustObject(value, oat), oat)
		}
		out.servers = try serversOf(m, "servers", at + "/servers")
		out.parameters = try parametersOf(m, at)
		out.extensions = extensionsOf(m)
		return out
	}

	internal def parametersOf(m map<string, any>, at string) !Parameter[] {
		let out Parameter[] = []
		for let (i, value) in try array(m, "parameters", at + "/parameters") {
			out.push(try parameterOf(try mustObject(value, "{at}/parameters/{i}"), "{at}/parameters/{i}"))
		}
		return out
	}

	internal def operationOf(m map<string, any>, at string) !Operation {
		let out = new Operation()
		out.tags = try strings(m, "tags", at)
		out.summary = try textOf(m, "summary", at)
		out.description = try textOf(m, "description", at)
		out.externalDocs = try externalDocsOf(try object(m, "externalDocs", at + "/externalDocs"), at + "/externalDocs") when m.hasKey("externalDocs")
		out.operationId = try textOf(m, "operationId", at)
		out.parameters = try parametersOf(m, at)
		out.requestBody = try requestBodyOf(try object(m, "requestBody", at + "/requestBody"), at + "/requestBody") when m.hasKey("requestBody")
		let responses = try object(m, "responses", at + "/responses")
		out.responseExtensions = extensionsOf(responses)
		for let (code, value) in responses {
			continue when code.startsWith("x-")
			let rat = at + "/responses/" + escapePointer(code)
			out.responses[code] = try responseOf(try mustObject(value, rat), rat)
		}
		for let (name, value) in try object(m, "callbacks", at + "/callbacks") {
			let cat = at + "/callbacks/" + escapePointer(name)
			out.callbacks[name] = try callbackOf(try mustObject(value, cat), cat)
		}
		out.deprecated = try flag(m, "deprecated", at)
		out.security = try securityOf(m["security"], at + "/security") when m.hasKey("security")
		out.servers = try serversOf(m, "servers", at + "/servers")
		out.extensions = extensionsOf(m)
		return out
	}

	internal def locationOf(name string, at string) !ParameterIn {
		switch name {
			case "query":
				return ParameterIn.Query
			case "querystring":
				return ParameterIn.QueryString
			case "header":
				return ParameterIn.Header
			case "path":
				return ParameterIn.Path
			case "cookie":
				return ParameterIn.Cookie
			default:
				fail openapiError(at, "\"{name}\" is not a parameter location")
		}
	}

	internal def styleOf(name string, at string) !Style {
		switch name {
			case "":
				return Style.Default
			case "matrix":
				return Style.Matrix
			case "label":
				return Style.Label
			case "simple":
				return Style.Simple
			case "form":
				return Style.Form
			case "spaceDelimited":
				return Style.SpaceDelimited
			case "pipeDelimited":
				return Style.PipeDelimited
			case "deepObject":
				return Style.DeepObject
			case "cookie":
				return Style.Cookie
			default:
				fail openapiError(at, "\"{name}\" is not a style")
		}
	}

	internal def examplesOf(m map<string, any>, at string) !map<string, Example> {
		let out = map<string, Example>{}
		for let (name, value) in try object(m, "examples", at + "/examples") {
			let eat = at + "/examples/" + escapePointer(name)
			out[name] = try exampleOf(try mustObject(value, eat), eat)
		}
		return out
	}

	internal def contentOf(m map<string, any>, at string) !map<string, MediaType> {
		let out = map<string, MediaType>{}
		for let (name, value) in try object(m, "content", at + "/content") {
			let mat = at + "/content/" + escapePointer(name)
			out[name] = try mediaTypeOf(try mustObject(value, mat), mat)
		}
		return out
	}

	internal def parameterOf(m map<string, any>, at string) !Parameter {
		let out = new Parameter()
		out.ref = try textOf(m, "$ref", at)
		out.summary = try textOf(m, "summary", at)
		out.description = try textOf(m, "description", at)
		return out when out.ref != ""
		out.name = try textOf(m, "name", at)
		out.location = try locationOf(try textOf(m, "in", at), at + "/in")
		out.required = try flag(m, "required", at)
		out.deprecated = try flag(m, "deprecated", at)
		out.allowEmptyValue = try flag(m, "allowEmptyValue", at)
		if m.hasKey("example") {
			out.example = m["example"]
			out.hasExample = true
		}
		out.examples = try examplesOf(m, at)
		out.style = try styleOf(try textOf(m, "style", at), at + "/style")
		out.explode = try optionalFlag(m, "explode", at)
		out.allowReserved = try flag(m, "allowReserved", at)
		out.schema = m.hasKey("schema") ?? (m["schema"], none)
		out.content = try contentOf(m, at)
		out.extensions = extensionsOf(m)
		return out
	}

	internal def requestBodyOf(m map<string, any>, at string) !RequestBody {
		let out = new RequestBody()
		out.ref = try textOf(m, "$ref", at)
		out.summary = try textOf(m, "summary", at)
		out.description = try textOf(m, "description", at)
		return out when out.ref != ""
		out.content = try contentOf(m, at)
		out.required = try flag(m, "required", at)
		out.extensions = extensionsOf(m)
		return out
	}

	internal def mediaTypeOf(m map<string, any>, at string) !MediaType {
		let out = new MediaType()
		out.ref = try textOf(m, "$ref", at)
		out.summary = try textOf(m, "summary", at)
		out.description = try textOf(m, "description", at)
		return out when out.ref != ""
		out.schema = m.hasKey("schema") ?? (m["schema"], none)
		out.itemSchema = m.hasKey("itemSchema") ?? (m["itemSchema"], none)
		if m.hasKey("example") {
			out.example = m["example"]
			out.hasExample = true
		}
		out.examples = try examplesOf(m, at)
		for let (name, value) in try object(m, "encoding", at + "/encoding") {
			let eat = at + "/encoding/" + escapePointer(name)
			out.encoding[name] = try encodingOf(try mustObject(value, eat), eat)
		}
		for let (i, value) in try array(m, "prefixEncoding", at + "/prefixEncoding") {
			out.prefixEncoding.push(try encodingOf(try mustObject(value, "{at}/prefixEncoding/{i}"), "{at}/prefixEncoding/{i}"))
		}
		out.itemEncoding = try encodingOf(try object(m, "itemEncoding", at + "/itemEncoding"), at + "/itemEncoding") when m.hasKey("itemEncoding")
		out.extensions = extensionsOf(m)
		return out
	}

	internal def encodingOf(m map<string, any>, at string) !Encoding {
		let out = new Encoding()
		out.contentType = try textOf(m, "contentType", at)
		for let (name, value) in try object(m, "headers", at + "/headers") {
			let hat = at + "/headers/" + escapePointer(name)
			out.headers[name] = try headerOf(try mustObject(value, hat), hat)
		}
		for let (name, value) in try object(m, "encoding", at + "/encoding") {
			let eat = at + "/encoding/" + escapePointer(name)
			out.encoding[name] = try encodingOf(try mustObject(value, eat), eat)
		}
		for let (i, value) in try array(m, "prefixEncoding", at + "/prefixEncoding") {
			out.prefixEncoding.push(try encodingOf(try mustObject(value, "{at}/prefixEncoding/{i}"), "{at}/prefixEncoding/{i}"))
		}
		out.itemEncoding = try encodingOf(try object(m, "itemEncoding", at + "/itemEncoding"), at + "/itemEncoding") when m.hasKey("itemEncoding")
		out.style = try styleOf(try textOf(m, "style", at), at + "/style")
		out.explode = try optionalFlag(m, "explode", at)
		out.allowReserved = try optionalFlag(m, "allowReserved", at)
		out.extensions = extensionsOf(m)
		return out
	}

	internal def responseOf(m map<string, any>, at string) !Response {
		let out = new Response()
		out.ref = try textOf(m, "$ref", at)
		out.summary = try textOf(m, "summary", at)
		out.description = try textOf(m, "description", at)
		return out when out.ref != ""
		for let (name, value) in try object(m, "headers", at + "/headers") {
			let hat = at + "/headers/" + escapePointer(name)
			out.headers[name] = try headerOf(try mustObject(value, hat), hat)
		}
		out.content = try contentOf(m, at)
		for let (name, value) in try object(m, "links", at + "/links") {
			let lat = at + "/links/" + escapePointer(name)
			out.links[name] = try linkOf(try mustObject(value, lat), lat)
		}
		out.extensions = extensionsOf(m)
		return out
	}

	internal def callbackOf(m map<string, any>, at string) !Callback {
		let out = new Callback()
		out.ref = try textOf(m, "$ref", at)
		out.summary = try textOf(m, "summary", at)
		out.description = try textOf(m, "description", at)
		return out when out.ref != ""
		for let (expression, value) in m {
			continue when expression.startsWith("x-")
			let pat = at + "/" + escapePointer(expression)
			out.expressions[expression] = try pathItemOf(try mustObject(value, pat), pat)
		}
		out.extensions = extensionsOf(m)
		return out
	}

	internal def exampleOf(m map<string, any>, at string) !Example {
		let out = new Example()
		out.ref = try textOf(m, "$ref", at)
		out.summary = try textOf(m, "summary", at)
		out.description = try textOf(m, "description", at)
		return out when out.ref != ""
		if m.hasKey("dataValue") {
			out.dataValue = m["dataValue"]
			out.hasDataValue = true
		}
		out.serializedValue = try textOf(m, "serializedValue", at)
		out.externalValue = try textOf(m, "externalValue", at)
		if m.hasKey("value") {
			out.value = m["value"]
			out.hasValue = true
		}
		out.extensions = extensionsOf(m)
		return out
	}

	internal def linkOf(m map<string, any>, at string) !Link {
		let out = new Link()
		out.ref = try textOf(m, "$ref", at)
		out.summary = try textOf(m, "summary", at)
		out.description = try textOf(m, "description", at)
		return out when out.ref != ""
		out.operationRef = try textOf(m, "operationRef", at)
		out.operationId = try textOf(m, "operationId", at)
		for let (name, value) in try object(m, "parameters", at + "/parameters") {
			out.parameters[name] = value
		}
		if m.hasKey("requestBody") {
			out.requestBody = m["requestBody"]
			out.hasRequestBody = true
		}
		out.server = try serverOf(try object(m, "server", at + "/server"), at + "/server") when m.hasKey("server")
		out.extensions = extensionsOf(m)
		return out
	}

	internal def headerOf(m map<string, any>, at string) !Header {
		let out = new Header()
		out.ref = try textOf(m, "$ref", at)
		out.summary = try textOf(m, "summary", at)
		out.description = try textOf(m, "description", at)
		return out when out.ref != ""
		out.required = try flag(m, "required", at)
		out.deprecated = try flag(m, "deprecated", at)
		if m.hasKey("example") {
			out.example = m["example"]
			out.hasExample = true
		}
		out.examples = try examplesOf(m, at)
		out.style = try styleOf(try textOf(m, "style", at), at + "/style")
		out.explode = try optionalFlag(m, "explode", at)
		out.schema = m.hasKey("schema") ?? (m["schema"], none)
		out.content = try contentOf(m, at)
		out.extensions = extensionsOf(m)
		return out
	}

	internal def securitySchemeOf(m map<string, any>, at string) !SecurityScheme {
		let out = new SecurityScheme()
		out.ref = try textOf(m, "$ref", at)
		out.summary = try textOf(m, "summary", at)
		out.description = try textOf(m, "description", at)
		return out when out.ref != ""
		let kind = try textOf(m, "type", at)
		switch kind {
			case "apiKey":
				out.kind = SchemeKind.ApiKey
			case "http":
				out.kind = SchemeKind.Http
			case "mutualTLS":
				out.kind = SchemeKind.MutualTLS
			case "oauth2":
				out.kind = SchemeKind.OAuth2
			case "openIdConnect":
				out.kind = SchemeKind.OpenIdConnect
			default:
				fail openapiError(at + "/type", "\"{kind}\" is not a security scheme type")
		}
		out.name = try textOf(m, "name", at)
		out.location = try locationOf(try textOf(m, "in", at), at + "/in") when m.hasKey("in")
		out.scheme = try textOf(m, "scheme", at)
		out.bearerFormat = try textOf(m, "bearerFormat", at)
		if m.hasKey("flows") {
			let f = try object(m, "flows", at + "/flows")
			let fat = at + "/flows"
			let flows = OAuthFlows{extensions: extensionsOf(f)}
			flows.implicit = try flowOf(f, "implicit", fat)
			flows.password = try flowOf(f, "password", fat)
			flows.clientCredentials = try flowOf(f, "clientCredentials", fat)
			flows.authorizationCode = try flowOf(f, "authorizationCode", fat)
			flows.deviceAuthorization = try flowOf(f, "deviceAuthorization", fat)
			out.flows = flows
		}
		out.openIdConnectUrl = try textOf(m, "openIdConnectUrl", at)
		out.oauth2MetadataUrl = try textOf(m, "oauth2MetadataUrl", at)
		out.deprecated = try flag(m, "deprecated", at)
		out.extensions = extensionsOf(m)
		return out
	}

	internal def flowOf(m map<string, any>, key string, at string) !?OAuthFlow {
		return none unless m.hasKey(key)
		let fat = at + "/" + key
		let f = try object(m, key, fat)
		let scopes = map<string, string>{}
		for let (name, value) in try object(f, "scopes", fat + "/scopes") {
			fail openapiError(fat + "/scopes/" + escapePointer(name), "expected a string") unless value is string
			scopes[name] = value
		}
		return OAuthFlow{authorizationUrl: try textOf(f, "authorizationUrl", fat), deviceAuthorizationUrl: try textOf(f, "deviceAuthorizationUrl", fat), tokenUrl: try textOf(f, "tokenUrl", fat), refreshUrl: try textOf(f, "refreshUrl", fat), scopes: scopes, extensions: extensionsOf(f)}
	}
}
