partial module std.net.http.openapi {
	use std.net.http

	partial type Document {
		// Adds the routes of a mux (and of its groups) to `paths`: each
		// pattern with a method becomes an operation of its path template,
		// with its path parameters (strings, required) declared. What the
		// document already says is kept: an operation it has stays as it is,
		// a parameter it declares is not added again. A pattern without a
		// method (it serves every method), one that matches a whole subtree
		// (`/static/`, `{path...}`, which a path template cannot express)
		// and one for a host is left out.
		def addRoutes(mux http.ServeMux) {
			for let pattern in mux.routes() {
				continue when pattern.method == "" || pattern.prefix || pattern.host != ""
				let template = ""
				let names string[] = []
				let whole = true
				for let segment in pattern.segments {
					if segment.rest {
						whole = false
						break
					}
					if segment.param {
						template += "/\{" + segment.text + "\}"
						names.push(segment.text)
					} else {
						template += "/" + escapeTemplateLiteral(segment.text)
					}
				}
				continue unless whole
				template = "/" when template == ""
				let item = path(template)
				let method = pattern.method.upper()
				// HEAD is served by GET.
				continue when method == "HEAD" && !(item.operation("GET") is none)
				let found = item.operation(method)
				let op = found is none ?? (new Operation(), found)
				item.set(method, op) when found is none
				for let name in names {
					let declared = false
					for let p in item.parameters {
						declared = true when p.location == ParameterIn.Path && p.name == name
					}
					for let p in op.parameters {
						declared = true when p.location == ParameterIn.Path && p.name == name
					}
					continue when declared
					let schema = map<string, any>{}
					schema["type"] = "string"
					op.parameters.push(new Parameter(name, ParameterIn.Path, schema))
				}
			}
		}
	}

	// A literal path segment as a template writes it: braces, which a
	// template reads as an expression, percent-encoded.
	internal def escapeTemplateLiteral(segment string) string {
		return segment.replace("\{", "%7B", -1).replace("\}", "%7D", -1)
	}
}
