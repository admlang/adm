partial module std.net.http.openapi {
	use (
		std.net.url
		std.data.encoding::(JSON)
		std.data.encoding.jsonschema
		std.data.encoding.jsonschema::(Draft)
	)

	// The OpenAPI Specification's own schemas of its documents (Apache-2.0,
	// `schema/LICENSE`): 3.0 in draft 4, 3.1 and 3.2 in 2020-12 with their
	// Schema Object dialects.
	@embed("schema/oas-3.0-schema.json")
	internal const oas30Schema byte[]
	@embed("schema/oas-3.1-schema.json")
	internal const oas31Schema byte[]
	@embed("schema/oas-3.1-dialect.json")
	internal const oas31Dialect byte[]
	@embed("schema/oas-3.1-meta.json")
	internal const oas31Meta byte[]
	@embed("schema/oas-3.2-schema.json")
	internal const oas32Schema byte[]
	@embed("schema/oas-3.2-dialect.json")
	internal const oas32Dialect byte[]
	@embed("schema/oas-3.2-meta.json")
	internal const oas32Meta byte[]

	// The base URI of a document without `$self`.
	internal const defaultBase = "urn:adm:openapi:document"

	// The dialects a Schema Object follows when it names none: the OpenAPI
	// ones (2020-12 with annotations) and the JSON Schema drafts.
	internal def draftOfDialect(dialect string) Draft {
		let d = dialect.trimSuffix("#")
		switch d {
			case "http://json-schema.org/draft-04/schema":
				return Draft.Draft4
			case "http://json-schema.org/draft-06/schema":
				return Draft.Draft6
			case "http://json-schema.org/draft-07/schema":
				return Draft.Draft7
			case "https://json-schema.org/draft/2019-09/schema":
				return Draft.Draft2019
			default:
				return Draft.Draft2020
		}
	}

	// The schemas of a document compiled for validation, with the other
	// documents it refers to by URI. A 3.0 document's schemas are converted
	// to 2020-12 first. Fails when a schema cannot be compiled.
	internal def compileSchemas(doc Document, documents map<string, any>, formats bool) !Schemas {
		let tree = doc.tree()
		let (major, minor) = doc.version()
		tree = convertSchemas30(tree) when major == 3 && minor == 0
		let base = doc.selfURI == "" ?? (defaultBase, resolveReference(defaultBase, doc.selfURI))
		let resources = map<string, any>{}
		for let (uri, value) in documents {
			resources[uri] = value
		}
		resources[base] = tree
		let root = jsonschema.compile(true, jsonschema.CompileOptions{resources: resources, formats: formats, baseURI: "urn:adm:openapi:root", draft: draftOfDialect(doc.jsonSchemaDialect)}) onerror (err error) {
			fail openapiError("", err.message)
		}
		return new Schemas(tree, base, documents, root)
	}

	// A reference resolved against a base URI, its fragment kept as
	// written.
	internal def resolveReference(base string, ref string) string {
		let hash = ref.indexOf("#")
		let path = hash < 0 ?? (ref, ref[0:hash])
		let fragment = hash < 0 ?? ("", ref[hash:])
		return base + fragment when path == ""
		let b = url.parse(base) onerror (err error) {
			return ref
		}
		let r = url.parse(path) onerror (err error) {
			return ref
		}
		let resolved = b.resolve(r)
		resolved.fragment = ""
		return resolved.str().trimSuffix("#") + fragment
	}

	// The schemas of a description, compiled once: a validator for any
	// schema in it by JSON Pointer, and the document tree to inspect them.
	internal type Schemas {
		tree      map<string, any>
		base      string
		// Other documents the description refers to, by URI.
		documents map<string, any>
		root      jsonschema.Validator
		compiled  map<string, jsonschema.Validator>

		def new(tree map<string, any>, base string, documents map<string, any>, root jsonschema.Validator) {
			self.tree = tree
			self.base = base
			self.documents = documents
			self.root = root
			compiled = map<string, jsonschema.Validator>{}
		}

		// The validator of the schema at a pointer of the document.
		def at(pointer string) !jsonschema.Validator {
			let known = compiled.get(pointer)
			return known unless known is none
			let made = root.at(base + "#" + pointer) onerror (err error) {
				fail openapiError(pointer, err.message)
			}
			compiled[pointer] = made
			return made
		}

		// The value a reference names, resolved against the document's base:
		// a pointer into it or into one of the other documents.
		def resolve(ref string, from string) !any {
			let target = resolveReference(base, ref)
			let hash = target.indexOf("#")
			let docURI = hash < 0 ?? (target, target[0:hash])
			let pointer = hash < 0 ?? ("", target[hash + 1:])
			let doc any = none
			if docURI == base || docURI == "" {
				doc = tree
			} else {
				fail openapiError(from, "{ref} names a document not given") unless documents.hasKey(docURI)
				doc = documents[docURI]
			}
			let found = pointerValue(doc, pointer)
			fail openapiError(from, "{ref} names nothing") when found is none
			return found
		}

		// The pointer a reference names within this document, "" when it
		// names another document.
		def localPointer(ref string) string {
			let target = resolveReference(base, ref)
			return "" unless target.startsWith(base + "#")
			return target[base.len() + 1:]
		}

		// The types an instance of a schema can have, found by following
		// `$ref` and `allOf` only (as the specification has parsers do):
		// empty when any type is allowed.
		def typesOf(schema any) string[] {
			let found = typeSets(schema, 0)
			return found.len() == 0 ?? ([], intersect(found))
		}

		def typeSets(schema any, depth int) string[][] {
			let out string[][] = []
			return out when depth > 32 || !(schema is map<string, any>)
			if schema.hasKey("type") {
				let t = schema["type"]
				if t is string {
					out.push([t])
				} else if t is any[] {
					let set string[] = []
					for let item in t {
						set.push(item) when item is string
					}
					out.push(set)
				}
			}
			let ref = schema.hasKey("$ref") ?? (schema["$ref"], none)
			if ref is string {
				let target = resolve(ref, "") onerror recover none
				out += typeSets(target, depth + 1) unless target is none
			}
			let all = schema.hasKey("allOf") ?? (schema["allOf"], none)
			if all is any[] {
				for let item in all {
					out += typeSets(item, depth + 1)
				}
			}
			return out
		}

		// The schema of a property, found through `properties`, `$ref` and
		// `allOf` (the first that names it), else `additionalProperties`;
		// none when nothing says.
		def propertySchema(schema any, name string) any {
			return lookupProperty(schema, name, 0)
		}

		def lookupProperty(schema any, name string, depth int) any {
			return none when depth > 32 || !(schema is map<string, any>)
			let props = schema.hasKey("properties") ?? (schema["properties"], none)
			return props[name] when props is map<string, any> && props.hasKey(name)
			let ref = schema.hasKey("$ref") ?? (schema["$ref"], none)
			if ref is string {
				let target = resolve(ref, "") onerror recover none
				let found = lookupProperty(target, name, depth + 1)
				return found unless found is none
			}
			let all = schema.hasKey("allOf") ?? (schema["allOf"], none)
			if all is any[] {
				for let item in all {
					let found = lookupProperty(item, name, depth + 1)
					return found unless found is none
				}
			}
			let extra = schema.hasKey("additionalProperties") ?? (schema["additionalProperties"], none)
			return extra is map<string, any> ?? (extra, none)
		}

		// The schema of an array's items (`items`, through `$ref` and
		// `allOf`), none when nothing says.
		def itemSchema(schema any) any {
			return lookupItems(schema, 0)
		}

		def lookupItems(schema any, depth int) any {
			return none when depth > 32 || !(schema is map<string, any>)
			let items = schema.hasKey("items") ?? (schema["items"], none)
			return items when items is map<string, any>
			let ref = schema.hasKey("$ref") ?? (schema["$ref"], none)
			if ref is string {
				let target = resolve(ref, "") onerror recover none
				let found = lookupItems(target, depth + 1)
				return found unless found is none
			}
			let all = schema.hasKey("allOf") ?? (schema["allOf"], none)
			if all is any[] {
				for let item in all {
					let found = lookupItems(item, depth + 1)
					return found unless found is none
				}
			}
			return none
		}

		// A keyword's value found through `$ref` and `allOf`.
		def keyword(schema any, name string) any {
			return lookupKeyword(schema, name, 0)
		}

		def lookupKeyword(schema any, name string, depth int) any {
			return none when depth > 32 || !(schema is map<string, any>)
			return schema[name] when schema.hasKey(name)
			let ref = schema.hasKey("$ref") ?? (schema["$ref"], none)
			if ref is string {
				let target = resolve(ref, "") onerror recover none
				let found = lookupKeyword(target, name, depth + 1)
				return found unless found is none
			}
			let all = schema.hasKey("allOf") ?? (schema["allOf"], none)
			if all is any[] {
				for let item in all {
					let found = lookupKeyword(item, name, depth + 1)
					return found unless found is none
				}
			}
			return none
		}
	}

	// The types every set allows.
	internal def intersect(sets string[][]) string[] {
		let out string[] = []
		for let t in sets[0] {
			let everywhere = true
			for let set in sets {
				// An integer is a number.
				let has = set.includes(t) || (t == "integer" && set.includes("number"))
				everywhere = false unless has
			}
			out.push(t) when everywhere
		}
		if out.len() == 0 {
			for let set in sets {
				return ["integer"] when set.includes("integer")
			}
		}
		return out
	}

	// The value at a JSON Pointer, none when there is none.
	internal def pointerValue(doc any, pointer string) any {
		let value = doc
		return value when pointer == ""
		for let raw in pointer[1:].split("/") {
			let token = unescapePointer(url.pathUnescape(raw) onerror recover raw)
			if value is map<string, any> {
				return none unless value.hasKey(token)
				value = value[token]
			} else if value is any[] {
				return none unless /^(0|[1-9][0-9]*)$/.test(token)
				let i = parseInt<int>(token)
				return none unless i < value.len()
				value = value[i]
			} else {
				return none
			}
		}
		return value
	}

	// An OpenAPI 3.0 document's Schema Objects as JSON Schema 2020-12:
	// `nullable` allows null, boolean `exclusiveMinimum`/`exclusiveMaximum`
	// become the numeric forms, and a `$ref` hides its siblings.
	internal def convertSchemas30(tree map<string, any>) map<string, any> {
		let out = convertTree30(tree, false)
		return out is map<string, any> ?? (out, tree)
	}

	// Walks a 3.0 document: values under `schema` keys and under
	// `components/schemas` are schemas; examples and extensions are data.
	internal def convertTree30(value any, componentsLevel bool) any {
		if value is any[] {
			let out any[] = []
			for let item in value {
				out.push(convertTree30(item, false))
			}
			return out
		}
		return value unless value is map<string, any>
		let out = map<string, any>{}
		for let (key, item) in value {
			if key == "example" || key == "examples" || key.startsWith("x-") {
				out[key] = item
			} else if key == "schema" {
				out[key] = convertSchema30(item)
			} else if componentsLevel && key == "schemas" && item is map<string, any> {
				let schemas = map<string, any>{}
				for let (name, schema) in item {
					schemas[name] = convertSchema30(schema)
				}
				out[key] = schemas
			} else {
				out[key] = convertTree30(item, key == "components")
			}
		}
		return out
	}

	internal def convertSchema30(schema any) any {
		return schema unless schema is map<string, any>
		if schema.hasKey("$ref") {
			let only = map<string, any>{}
			only["$ref"] = schema["$ref"]
			return only
		}
		let out = map<string, any>{}
		for let (key, value) in schema {
			switch key {
				case "properties", "patternProperties":
					if value is map<string, any> {
						let props = map<string, any>{}
						for let (name, sub) in value {
							props[name] = convertSchema30(sub)
						}
						out[key] = props
					} else {
						out[key] = value
					}
				case "items", "additionalProperties", "not":
					out[key] = convertSchema30(value)
				case "allOf", "anyOf", "oneOf":
					if value is any[] {
						let subs any[] = []
						for let sub in value {
							subs.push(convertSchema30(sub))
						}
						out[key] = subs
					} else {
						out[key] = value
					}
				case "nullable", "exclusiveMinimum", "exclusiveMaximum":
				default:
					out[key] = value
			}
		}
		let nullable any = schema.hasKey("nullable") ?? (schema["nullable"], false)
		if nullable is bool && nullable {
			let t = schema.hasKey("type") ?? (schema["type"], none)
			if t is string {
				let both any[] = [t, "null"]
				out["type"] = both
			}
			let values = schema.hasKey("enum") ?? (schema["enum"], none)
			if values is any[] {
				let withNull any[] = []
				for let v in values {
					withNull.push(v)
				}
				withNull.push(none)
				out["enum"] = withNull
			}
		}
		for let bound in [("exclusiveMinimum", "minimum"), ("exclusiveMaximum", "maximum")] {
			let (exclusive, inclusive) = bound
			let flagValue any = schema.hasKey(exclusive) ?? (schema[exclusive], none)
			if flagValue is bool && flagValue && schema.hasKey(inclusive) {
				out[exclusive] = schema[inclusive]
				out.delete(inclusive)
			} else if !(flagValue is bool) && !(flagValue is none) {
				out[exclusive] = flagValue
			}
		}
		return out
	}

	// The specification's schema of a 3.x document's minor version, compiled.
	internal def specificationSchema(minor int) !jsonschema.Validator {
		let json = new JSON()
		return try jsonschema.compile(try json.parse(oas30Schema), jsonschema.CompileOptions{draft: Draft.Draft4}) when minor == 0
		let resources = map<string, any>{}
		if minor == 1 {
			resources["https://spec.openapis.org/oas/3.1/dialect/base"] = try json.parse(oas31Dialect)
			resources["https://spec.openapis.org/oas/3.1/meta/base"] = try json.parse(oas31Meta)
			return try jsonschema.compile(try json.parse(oas31Schema), jsonschema.CompileOptions{resources: resources})
		}
		resources["https://spec.openapis.org/oas/3.2/dialect/2025-09-17"] = try json.parse(oas32Dialect)
		resources["https://spec.openapis.org/oas/3.2/meta/2025-09-17"] = try json.parse(oas32Meta)
		return try jsonschema.compile(try json.parse(oas32Schema), jsonschema.CompileOptions{resources: resources})
	}
}
