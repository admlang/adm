partial module std.net.http.openapi {
	use std.data.encoding::(JSON, YAML)

	partial type Document {
		// The document as JSON, two spaces an indentation level, fields in
		// the specification's order. Implements JSONEncoder.
		def json() byte[] {
			return JSON{indent: true, indentString: "  "}.encode(tree())
		}

		// The document as YAML. Implements YAMLEncoder.
		def yaml() byte[] {
			return new YAML().encode(tree())
		}

		// The document as the plain values JSON and YAML hold: objects as
		// `map<string, any>`, in the specification's field order, with what
		// is empty left out.
		def tree() map<string, any> {
			let out = map<string, any>{}
			out["openapi"] = openapi
			put(out, "$self", selfURI)
			out["info"] = infoTree(info)
			put(out, "jsonSchemaDialect", jsonSchemaDialect)
			putServers(out, servers)
			if paths.len() > 0 || pathExtensions.len() > 0 {
				let p = map<string, any>{}
				for let (template, item) in paths {
					p[template] = pathItemTree(item)
				}
				merge(p, pathExtensions)
				out["paths"] = p
			}
			if webhooks.len() > 0 {
				let w = map<string, any>{}
				for let (name, item) in webhooks {
					w[name] = pathItemTree(item)
				}
				out["webhooks"] = w
			}
			out["components"] = componentsTree(components) unless components.isEmpty()
			let requirements = security
			out["security"] = securityTree(requirements) unless requirements is none
			out["tags"] = plainList(tags.mapElem(t => tagTree(t))) when tags.len() > 0
			let docs = externalDocs
			out["externalDocs"] = externalDocsTree(docs) unless docs is none
			merge(out, extensions)
			return out
		}
	}

	// A list as the `any[]` JSON and YAML hold.
	internal def plainList(items map<string, any>[]) any[] {
		let out any[] = []
		for let item in items {
			out.push(item)
		}
		return out
	}

	internal def put(m map<string, any>, key string, value string) {
		m[key] = value when value != ""
	}

	internal def putFlag(m map<string, any>, key string, value bool) {
		m[key] = true when value
	}

	internal def merge(m map<string, any>, extensions map<string, any>) {
		for let (key, value) in extensions {
			m[key] = value
		}
	}

	internal def putServers(m map<string, any>, servers Server[]) {
		return when servers.len() == 0
		m["servers"] = plainList(servers.mapElem(s => serverTree(s)))
	}

	internal def infoTree(info Info) map<string, any> {
		let out = map<string, any>{}
		out["title"] = info.title
		put(out, "summary", info.summary)
		put(out, "description", info.description)
		put(out, "termsOfService", info.termsOfService)
		let contact = info.contact
		if !(contact is none) {
			let c = map<string, any>{}
			put(c, "name", contact.name)
			put(c, "url", contact.url)
			put(c, "email", contact.email)
			merge(c, contact.extensions)
			out["contact"] = c
		}
		let license = info.license
		if !(license is none) {
			let l = map<string, any>{}
			l["name"] = license.name
			put(l, "identifier", license.identifier)
			put(l, "url", license.url)
			merge(l, license.extensions)
			out["license"] = l
		}
		out["version"] = info.version
		merge(out, info.extensions)
		return out
	}

	internal def serverTree(s Server) map<string, any> {
		let out = map<string, any>{}
		out["url"] = s.url
		put(out, "description", s.description)
		put(out, "name", s.name)
		if s.variables.len() > 0 {
			let vars = map<string, any>{}
			for let (name, v) in s.variables {
				let m = map<string, any>{}
				if v.values.len() > 0 {
					let values any[] = []
					for let value in v.values {
						values.push(value)
					}
					m["enum"] = values
				}
				m["default"] = v.defaultValue
				put(m, "description", v.description)
				merge(m, v.extensions)
				vars[name] = m
			}
			out["variables"] = vars
		}
		merge(out, s.extensions)
		return out
	}

	internal def externalDocsTree(d ExternalDocs) map<string, any> {
		let out = map<string, any>{}
		put(out, "description", d.description)
		out["url"] = d.url
		merge(out, d.extensions)
		return out
	}

	internal def tagTree(t Tag) map<string, any> {
		let out = map<string, any>{}
		out["name"] = t.name
		put(out, "summary", t.summary)
		put(out, "description", t.description)
		let docs = t.externalDocs
		out["externalDocs"] = externalDocsTree(docs) unless docs is none
		put(out, "parent", t.parent)
		put(out, "kind", t.kind)
		merge(out, t.extensions)
		return out
	}

	internal def securityTree(requirements map<string, string[]>[]) any[] {
		let out any[] = []
		for let r in requirements {
			let m = map<string, any>{}
			for let (name, scopes) in r {
				let list any[] = []
				for let scope in scopes {
					list.push(scope)
				}
				m[name] = list
			}
			out.push(m)
		}
		return out
	}

	// A Reference Object: `$ref` with the summary and description that
	// override the target's.
	internal def referenceTree(ref string, summary string, description string) map<string, any> {
		let out = map<string, any>{}
		out["$ref"] = ref
		put(out, "summary", summary)
		put(out, "description", description)
		return out
	}

	internal def componentsTree(c Components) map<string, any> {
		let out = map<string, any>{}
		if c.schemas.len() > 0 {
			let m = map<string, any>{}
			for let (name, schema) in c.schemas {
				m[name] = schema
			}
			out["schemas"] = m
		}
		if c.responses.len() > 0 {
			let m = map<string, any>{}
			for let (name, r) in c.responses {
				m[name] = responseTree(r)
			}
			out["responses"] = m
		}
		if c.parameters.len() > 0 {
			let m = map<string, any>{}
			for let (name, p) in c.parameters {
				m[name] = parameterTree(p)
			}
			out["parameters"] = m
		}
		out["examples"] = examplesTree(c.examples) when c.examples.len() > 0
		if c.requestBodies.len() > 0 {
			let m = map<string, any>{}
			for let (name, b) in c.requestBodies {
				m[name] = requestBodyTree(b)
			}
			out["requestBodies"] = m
		}
		out["headers"] = headersTree(c.headers) when c.headers.len() > 0
		if c.securitySchemes.len() > 0 {
			let m = map<string, any>{}
			for let (name, s) in c.securitySchemes {
				m[name] = securitySchemeTree(s)
			}
			out["securitySchemes"] = m
		}
		out["links"] = linksTree(c.links) when c.links.len() > 0
		out["callbacks"] = callbacksTree(c.callbacks) when c.callbacks.len() > 0
		if c.pathItems.len() > 0 {
			let m = map<string, any>{}
			for let (name, item) in c.pathItems {
				m[name] = pathItemTree(item)
			}
			out["pathItems"] = m
		}
		out["mediaTypes"] = contentTree(c.mediaTypes) when c.mediaTypes.len() > 0
		merge(out, c.extensions)
		return out
	}

	internal def pathItemTree(item PathItem) map<string, any> {
		let out = map<string, any>{}
		put(out, "$ref", item.ref)
		put(out, "summary", item.summary)
		put(out, "description", item.description)
		for let method in fixedMethods {
			let op = item.operations.get(method)
			out[method] = operationTree(op) unless op is none
		}
		if item.additionalOperations.len() > 0 {
			let m = map<string, any>{}
			for let (method, op) in item.additionalOperations {
				m[method] = operationTree(op)
			}
			out["additionalOperations"] = m
		}
		putServers(out, item.servers)
		out["parameters"] = plainList(item.parameters.mapElem(p => parameterTree(p))) when item.parameters.len() > 0
		merge(out, item.extensions)
		return out
	}

	internal def operationTree(op Operation) map<string, any> {
		let out = map<string, any>{}
		if op.tags.len() > 0 {
			let tags any[] = []
			for let tag in op.tags {
				tags.push(tag)
			}
			out["tags"] = tags
		}
		put(out, "summary", op.summary)
		put(out, "description", op.description)
		let docs = op.externalDocs
		out["externalDocs"] = externalDocsTree(docs) unless docs is none
		put(out, "operationId", op.operationId)
		out["parameters"] = plainList(op.parameters.mapElem(p => parameterTree(p))) when op.parameters.len() > 0
		let body = op.requestBody
		out["requestBody"] = requestBodyTree(body) unless body is none
		if op.responses.len() > 0 || op.responseExtensions.len() > 0 {
			let m = map<string, any>{}
			for let (code, r) in op.responses {
				m[code] = responseTree(r)
			}
			merge(m, op.responseExtensions)
			out["responses"] = m
		}
		out["callbacks"] = callbacksTree(op.callbacks) when op.callbacks.len() > 0
		putFlag(out, "deprecated", op.deprecated)
		let requirements = op.security
		out["security"] = securityTree(requirements) unless requirements is none
		putServers(out, op.servers)
		merge(out, op.extensions)
		return out
	}

	internal def locationName(location ParameterIn) string {
		switch location {
			case ParameterIn.QueryString:
				return "querystring"
			case ParameterIn.Header:
				return "header"
			case ParameterIn.Path:
				return "path"
			case ParameterIn.Cookie:
				return "cookie"
			default:
				return "query"
		}
	}

	internal def styleName(value Style) string {
		switch value {
			case Style.Matrix:
				return "matrix"
			case Style.Label:
				return "label"
			case Style.Simple:
				return "simple"
			case Style.Form:
				return "form"
			case Style.SpaceDelimited:
				return "spaceDelimited"
			case Style.PipeDelimited:
				return "pipeDelimited"
			case Style.DeepObject:
				return "deepObject"
			case Style.Cookie:
				return "cookie"
			default:
				return ""
		}
	}

	internal def examplesTree(examples map<string, Example>) map<string, any> {
		let out = map<string, any>{}
		for let (name, e) in examples {
			out[name] = exampleTree(e)
		}
		return out
	}

	internal def contentTree(content map<string, MediaType>) map<string, any> {
		let out = map<string, any>{}
		for let (name, m) in content {
			out[name] = mediaTypeTree(m)
		}
		return out
	}

	internal def headersTree(headers map<string, Header>) map<string, any> {
		let out = map<string, any>{}
		for let (name, h) in headers {
			out[name] = headerTree(h)
		}
		return out
	}

	internal def linksTree(links map<string, Link>) map<string, any> {
		let out = map<string, any>{}
		for let (name, l) in links {
			out[name] = linkTree(l)
		}
		return out
	}

	internal def callbacksTree(callbacks map<string, Callback>) map<string, any> {
		let out = map<string, any>{}
		for let (name, c) in callbacks {
			out[name] = callbackTree(c)
		}
		return out
	}

	internal def parameterTree(p Parameter) map<string, any> {
		return referenceTree(p.ref, p.summary, p.description) when p.ref != ""
		let out = map<string, any>{}
		out["name"] = p.name
		out["in"] = locationName(p.location)
		put(out, "description", p.description)
		putFlag(out, "required", p.required)
		putFlag(out, "deprecated", p.deprecated)
		putFlag(out, "allowEmptyValue", p.allowEmptyValue)
		out["example"] = p.example when p.hasExample
		out["examples"] = examplesTree(p.examples) when p.examples.len() > 0
		put(out, "style", styleName(p.style))
		let explode = p.explode
		out["explode"] = explode unless explode is none
		putFlag(out, "allowReserved", p.allowReserved)
		out["schema"] = p.schema unless p.schema is none
		out["content"] = contentTree(p.content) when p.content.len() > 0
		merge(out, p.extensions)
		return out
	}

	internal def requestBodyTree(b RequestBody) map<string, any> {
		return referenceTree(b.ref, b.summary, b.description) when b.ref != ""
		let out = map<string, any>{}
		put(out, "description", b.description)
		out["content"] = contentTree(b.content)
		putFlag(out, "required", b.required)
		merge(out, b.extensions)
		return out
	}

	internal def mediaTypeTree(m MediaType) map<string, any> {
		return referenceTree(m.ref, m.summary, m.description) when m.ref != ""
		let out = map<string, any>{}
		out["schema"] = m.schema unless m.schema is none
		out["itemSchema"] = m.itemSchema unless m.itemSchema is none
		out["example"] = m.example when m.hasExample
		out["examples"] = examplesTree(m.examples) when m.examples.len() > 0
		if m.encoding.len() > 0 {
			let e = map<string, any>{}
			for let (name, enc) in m.encoding {
				e[name] = encodingTree(enc)
			}
			out["encoding"] = e
		}
		out["prefixEncoding"] = plainList(m.prefixEncoding.mapElem(enc => encodingTree(enc))) when m.prefixEncoding.len() > 0
		let item = m.itemEncoding
		out["itemEncoding"] = encodingTree(item) unless item is none
		merge(out, m.extensions)
		return out
	}

	internal def encodingTree(e Encoding) map<string, any> {
		let out = map<string, any>{}
		put(out, "contentType", e.contentType)
		out["headers"] = headersTree(e.headers) when e.headers.len() > 0
		if e.encoding.len() > 0 {
			let m = map<string, any>{}
			for let (name, inner) in e.encoding {
				m[name] = encodingTree(inner)
			}
			out["encoding"] = m
		}
		out["prefixEncoding"] = plainList(e.prefixEncoding.mapElem(inner => encodingTree(inner))) when e.prefixEncoding.len() > 0
		let item = e.itemEncoding
		out["itemEncoding"] = encodingTree(item) unless item is none
		put(out, "style", styleName(e.style))
		let explode = e.explode
		out["explode"] = explode unless explode is none
		let reserved = e.allowReserved
		out["allowReserved"] = reserved unless reserved is none
		merge(out, e.extensions)
		return out
	}

	internal def responseTree(r Response) map<string, any> {
		return referenceTree(r.ref, r.summary, r.description) when r.ref != ""
		let out = map<string, any>{}
		put(out, "summary", r.summary)
		out["description"] = r.description
		out["headers"] = headersTree(r.headers) when r.headers.len() > 0
		out["content"] = contentTree(r.content) when r.content.len() > 0
		out["links"] = linksTree(r.links) when r.links.len() > 0
		merge(out, r.extensions)
		return out
	}

	internal def callbackTree(c Callback) map<string, any> {
		return referenceTree(c.ref, c.summary, c.description) when c.ref != ""
		let out = map<string, any>{}
		for let (expression, item) in c.expressions {
			out[expression] = pathItemTree(item)
		}
		merge(out, c.extensions)
		return out
	}

	internal def exampleTree(e Example) map<string, any> {
		return referenceTree(e.ref, e.summary, e.description) when e.ref != ""
		let out = map<string, any>{}
		put(out, "summary", e.summary)
		put(out, "description", e.description)
		out["dataValue"] = e.dataValue when e.hasDataValue
		put(out, "serializedValue", e.serializedValue)
		put(out, "externalValue", e.externalValue)
		out["value"] = e.value when e.hasValue
		merge(out, e.extensions)
		return out
	}

	internal def linkTree(l Link) map<string, any> {
		return referenceTree(l.ref, l.summary, l.description) when l.ref != ""
		let out = map<string, any>{}
		put(out, "operationRef", l.operationRef)
		put(out, "operationId", l.operationId)
		if l.parameters.len() > 0 {
			let m = map<string, any>{}
			for let (name, value) in l.parameters {
				m[name] = value
			}
			out["parameters"] = m
		}
		out["requestBody"] = l.requestBody when l.hasRequestBody
		put(out, "description", l.description)
		let server = l.server
		out["server"] = serverTree(server) unless server is none
		merge(out, l.extensions)
		return out
	}

	internal def headerTree(h Header) map<string, any> {
		return referenceTree(h.ref, h.summary, h.description) when h.ref != ""
		let out = map<string, any>{}
		put(out, "description", h.description)
		putFlag(out, "required", h.required)
		putFlag(out, "deprecated", h.deprecated)
		out["example"] = h.example when h.hasExample
		out["examples"] = examplesTree(h.examples) when h.examples.len() > 0
		put(out, "style", styleName(h.style))
		let explode = h.explode
		out["explode"] = explode unless explode is none
		out["schema"] = h.schema unless h.schema is none
		out["content"] = contentTree(h.content) when h.content.len() > 0
		merge(out, h.extensions)
		return out
	}

	internal def securitySchemeTree(s SecurityScheme) map<string, any> {
		return referenceTree(s.ref, s.summary, s.description) when s.ref != ""
		let out = map<string, any>{}
		switch s.kind {
			case SchemeKind.ApiKey:
				out["type"] = "apiKey"
			case SchemeKind.MutualTLS:
				out["type"] = "mutualTLS"
			case SchemeKind.OAuth2:
				out["type"] = "oauth2"
			case SchemeKind.OpenIdConnect:
				out["type"] = "openIdConnect"
			default:
				out["type"] = "http"
		}
		put(out, "description", s.description)
		if s.kind == SchemeKind.ApiKey {
			out["name"] = s.name
			out["in"] = locationName(s.location)
		}
		put(out, "scheme", s.scheme)
		put(out, "bearerFormat", s.bearerFormat)
		let flows = s.flows
		if !(flows is none) {
			let m = map<string, any>{}
			putFlow(m, "implicit", flows.implicit)
			putFlow(m, "password", flows.password)
			putFlow(m, "clientCredentials", flows.clientCredentials)
			putFlow(m, "authorizationCode", flows.authorizationCode)
			putFlow(m, "deviceAuthorization", flows.deviceAuthorization)
			merge(m, flows.extensions)
			out["flows"] = m
		}
		put(out, "openIdConnectUrl", s.openIdConnectUrl)
		put(out, "oauth2MetadataUrl", s.oauth2MetadataUrl)
		putFlag(out, "deprecated", s.deprecated)
		merge(out, s.extensions)
		return out
	}

	internal def putFlow(m map<string, any>, key string, flow ?OAuthFlow) {
		return when flow is none
		let out = map<string, any>{}
		put(out, "authorizationUrl", flow.authorizationUrl)
		put(out, "deviceAuthorizationUrl", flow.deviceAuthorizationUrl)
		put(out, "tokenUrl", flow.tokenUrl)
		put(out, "refreshUrl", flow.refreshUrl)
		let scopes = map<string, any>{}
		for let (name, text) in flow.scopes {
			scopes[name] = text
		}
		out["scopes"] = scopes
		merge(out, flow.extensions)
		m[key] = out
	}
}
