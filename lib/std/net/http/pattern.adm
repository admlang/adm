partial module std.net.http {
	// Pattern is a parsed route pattern: `[METHOD ][HOST]/path`, in the
	// grammar of Go 1.22's `ServeMux` (`GET /users/{id}`,
	// `example.com/`, `/files/{path...}`, `/exact/{$}`). Path segments
	// match literally, `{name}` matches one segment and names it,
	// `{name...}` matches the rest, `{$}` matches only the end, and a
	// trailing `/` matches every path with that prefix.
	//
	// Two patterns conflict when a request could match both and neither
	// is more specific; `ServeMux.handle` fails on it, so a routing
	// mistake is found at startup, not by a user.
	type Pattern {
		// The pattern as written.
		text     string
		// "" when the pattern has no method; `GET` also matches `HEAD`.
		method   string    = ""
		host     string    = ""
		segments Segment[] = []
		// Ends in `/` and matches every path under it.
		prefix   bool      = false

		def new() {}

		// Reports whether the request matches, with the named parameters
		// when it does. Method "" on the pattern matches every method.
		def matches(method string, host string, path string) ?map<string, string> {
			return none unless methodMatches(method)
			return none unless self.host == "" || self.host == host
			let parts = splitPath(path)
			let params = map<string, string>{}
			let count = segments.len()
			for let i = 0; i < count; i++ {
				let seg = segments[i]
				if seg.rest {
					// The rest may be empty, but the slash before it must be
					// there: `/files/{path...}` matches `/files/`, not `/files`.
					return none when i >= parts.len() && !path.endsWith("/")
					params[seg.text] = parts.slice(i, parts.len()).join("/")
					return params
				}
				return none when i >= parts.len()
				if seg.param {
					params[seg.text] = parts[i]
				} else {
					return none when seg.text != parts[i]
				}
			}
			// Every segment matched; what is left decides.
			if prefix {
				return params when parts.len() > count
				return params when parts.len() == count && path.endsWith("/")
				return none
			}
			return none when parts.len() != count
			// `/users/{id}` does not match `/users/42/`; `/{$}` matches `/`.
			return none when count > 0 && path.endsWith("/")
			return params
		}

		// Reports whether the pattern's method accepts the request's.
		internal def methodMatches(method string) bool {
			return true when self.method == ""
			return true when self.method == method
			return self.method == "GET" && method == "HEAD"
		}

		// Reports whether this pattern matches a strict subset of the
		// requests `other` does: it has a method and `other` none, a host
		// and `other` none, or its path is more literal at the first
		// difference.
		def moreSpecificThan(other Pattern) bool {
			return false unless overlaps(other)
			let m = compareMethod(other)
			let h = compareHost(other)
			let p = comparePath(other)
			return false when p == 2 || m < 0 || h < 0 || p < 0
			return m > 0 || h > 0 || p > 0
		}

		// Reports whether some request matches both and neither is more
		// specific.
		def conflictsWith(other Pattern) bool {
			return false unless overlaps(other)
			return !moreSpecificThan(other) && !other.moreSpecificThan(self)
		}

		// Reports whether any request matches both.
		def overlaps(other Pattern) bool {
			return false unless methodsOverlap(method, other.method)
			return false unless host == "" || other.host == "" || host == other.host
			return pathsOverlap(self, 0, other, 0)
		}

		// 1 when this pattern's method is narrower, -1 when wider, 0 when
		// equal.
		internal def compareMethod(other Pattern) int {
			return 0 when method == other.method
			return -1 when method == ""
			return 1 when other.method == ""
			// GET matches HEAD too, so HEAD is narrower than GET.
			return 1 when method == "HEAD" && other.method == "GET"
			return -1 when method == "GET" && other.method == "HEAD"
			return 0
		}

		internal def compareHost(other Pattern) int {
			return 0 when host == other.host
			return -1 when host == ""
			return 1 when other.host == ""
			return 0
		}

		// Compares the paths of two overlapping patterns position by
		// position: a literal is narrower than a wildcard, a wildcard
		// narrower than a rest or a prefix tail, and an exact end narrower
		// than either. 1 when this path matches a strict subset of the
		// other's, -1 for the reverse, 0 when they match the same paths,
		// and 2 when each is narrower somewhere (`/{y}/b` against
		// `/a/{x}`), which is a conflict.
		internal def comparePath(other Pattern) int {
			let a = segments
			let b = other.segments
			let mine = false
			let theirs = false
			let n = a.len() > b.len() ?? (a.len(), b.len())
			for let i = 0; i < n; i++ {
				let ra = positionRank(self, i)
				let rb = positionRank(other, i)
				mine = true when ra > rb
				theirs = true when rb > ra
				// A rest covers every later position.
				break when (i < a.len() && a[i].rest) || (i < b.len() && b[i].rest)
			}
			if a.len() == b.len() && !(a.len() > 0 && a[a.len() - 1].rest) && !(b.len() > 0 && b[b.len() - 1].rest) {
				let ta = tailRank(self)
				let tb = tailRank(other)
				mine = true when ta > tb
				theirs = true when tb > ta
			}
			return 2 when mine && theirs
			return 1 when mine
			return -1 when theirs
			return 0
		}

		// The names of the `{name}` and `{name...}` segments in order.
		def paramNames() string[] {
			let names string[] = []
			for let seg in segments {
				names.push(seg.text) when seg.param || seg.rest
			}
			return names
		}

		// The pattern as written.
		def str() string {
			return text
		}
	}

	// Segment is one path element of a pattern.
	struct Segment {
		// The literal text, or the parameter name.
		text  string
		// A `{name}` segment.
		param bool   = false
		// A `{name...}` segment; always last.
		rest  bool   = false
	}

	// rankOf orders segment kinds by specificity: literal, then wildcard,
	// then rest.
	internal def rankOf(seg Segment) int {
		return 0 when seg.rest
		return 1 when seg.param
		return 2
	}

	// positionRank is the rank of a pattern at path position i: its
	// segment there, the rest that reached it, or its tail past the last
	// segment (a prefix matches anything there, an exact end nothing).
	internal def positionRank(p Pattern, i int) int {
		let segs = p.segments
		return rankOf(segs[i]) when i < segs.len()
		return 0 when segs.len() > 0 && segs[segs.len() - 1].rest
		return tailRank(p)
	}

	// tailRank ranks what a pattern says past its last segment: 0 for a
	// prefix (anything may follow), 3 for an exact end.
	internal def tailRank(p Pattern) int {
		return p.prefix ?? (0, 3)
	}

	// methodsOverlap reports whether one request method can satisfy both
	// pattern methods.
	internal def methodsOverlap(a string, b string) bool {
		return true when a == "" || b == "" || a == b
		return (a == "GET" && b == "HEAD") || (a == "HEAD" && b == "GET")
	}

	// pathsOverlap walks both segment lists from `i` and `j` and reports
	// whether some path satisfies both.
	internal def pathsOverlap(a Pattern, i int, b Pattern, j int) bool {
		let aDone = i >= a.segments.len()
		let bDone = j >= b.segments.len()
		if aDone && bDone {
			return true when a.prefix == b.prefix
			// A prefix pattern also matches the exact path.
			return true
		}
		// An exact pattern that ended matches one path; a longer pattern
		// needs at least one more segment (a rest needs its slash).
		return a.prefix when aDone
		return b.prefix when bDone
		let sa = a.segments[i]
		let sb = b.segments[j]
		return true when sa.rest || sb.rest
		return false when !sa.param && !sb.param && sa.text != sb.text
		return pathsOverlap(a, i + 1, b, j + 1)
	}

	// splitPath breaks a request path into its segments, dropping the
	// leading slash and, for a path ending in `/`, the empty tail.
	internal def splitPath(path string) string[] {
		let trimmed = path.trimPrefix("/")
		return [] when trimmed == ""
		let parts = trimmed.split("/")
		parts.pop() when parts.len() > 0 && parts[parts.len() - 1] == "" && trimmed.endsWith("/")
		return parts
	}

	// parsePattern parses the pattern text.
	// Fails with HttpError (op "pattern") when the method is not a token,
	// the path does not start with `/`, a parameter name repeats or is
	// not an identifier, a `{...}` is not last, or `{$}` is not last.
	def parsePattern(text string) !Pattern {
		let p = new Pattern()
		p.text = text
		let rest = text.trim()
		fail HttpError{message: "empty pattern", op: "pattern", text: text} when rest == ""
		let sp = rest.indexOf(" ")
		if sp >= 0 {
			let method = rest[:sp].trim()
			fail HttpError{message: "invalid method in pattern: {text}", op: "pattern", text: text} unless validToken(method)
			p.method = method.upper()
			rest = rest[sp + 1:].trim()
		}
		let slash = rest.indexOf("/")
		fail HttpError{message: "pattern path must start with /: {text}", op: "pattern", text: text} when slash < 0
		p.host = rest[:slash]
		fail HttpError{message: "invalid host in pattern: {text}", op: "pattern", text: text} when p.host.contains("\{")
		let path = rest[slash:]
		let parts = path.trimPrefix("/").split("/")
		let seen string[] = []
		let count = parts.len()
		for let i = 0; i < count; i++ {
			let part = parts[i]
			let last = i == count - 1
			if part == "" {
				fail HttpError{message: "empty path segment in pattern: {text}", op: "pattern", text: text} unless last
				// A trailing slash: everything under the prefix.
				p.prefix = true when count > 1 || path == "/"
				break
			}
			if part == "\{$\}" {
				fail HttpError{message: "the end marker must be the last segment: {text}", op: "pattern", text: text} unless last
				break
			}
			if part.startsWith("\{") && part.endsWith("\}") {
				let name = part[1:part.len() - 1]
				let isRest = name.endsWith("...")
				name = name[:name.len() - 3] when isRest
				fail HttpError{message: "invalid parameter name in pattern: {text}", op: "pattern", text: text} unless isIdentifier(name)
				fail HttpError{message: "repeated parameter {name} in pattern: {text}", op: "pattern", text: text} when seen.includes(name)
				fail HttpError{message: "a rest parameter must be the last segment: {text}", op: "pattern", text: text} when isRest && !last
				seen.push(name)
				p.segments.push(Segment{text: name, param:!isRest, rest: isRest})
				continue
			}
			fail HttpError{message: "unbalanced braces in pattern: {text}", op: "pattern", text: text} when part.contains("\{") || part.contains("\}")
			p.segments.push(Segment{text: part})
		}
		return p
	}

	// isIdentifier reports whether text is a letter or underscore followed
	// by letters, digits or underscores.
	internal def isIdentifier(text string) bool {
		return false when text == ""
		let n = text.len()
		for let i = 0; i < n; i++ {
			let c = text[i]
			let ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' || (i > 0 && c >= '0' && c <= '9')
			return false unless ok
		}
		return true
	}

	// cleanPath is the path with `.` and `..` elements resolved and
	// repeated slashes collapsed, keeping a trailing slash; "" and
	// relative paths become "/"-rooted.
	def cleanPath(path string) string {
		return "/" when path == ""
		let trailing = path.endsWith("/") && path != "/"
		let out string[] = []
		for let part in path.split("/") {
			continue when part := "" || "."
			if part == ".." {
				out.pop() when out.len() > 0
				continue
			}
			out.push(part)
		}
		return "/" when out.len() == 0
		let joined = "/" + out.join("/")
		return trailing ?? (joined + "/", joined)
	}

	// RoutingNode is the tree the mux searches: children by literal
	// segment, one wildcard child, one rest child, and the pattern that
	// ends at this node per method. Lookup walks the request path once;
	// on a method mismatch it collects the methods that would have
	// matched for the `Allow` header of a 405.
	internal type RoutingNode {
		children map<string, RoutingNode>
		wildcard ?RoutingNode             = none
		rest     ?RoutingNode             = none
		// Pattern and handler by method; "" for the method-less entry.
		routes   map<string, Route>
		// Routes registered with a trailing slash, matching every path
		// under this node, by method.
		prefixes map<string, Route>

		def new() {
			self.children = {}
			self.routes = {}
			self.prefixes = {}
		}

		// The node a pattern's segments lead to, created on the way.
		def insert(segments Segment[]) RoutingNode {
			let node = self
			for let seg in segments {
				if seg.rest {
					let r = node.rest
					if r is none {
						let made = new RoutingNode()
						node.rest = made
						node = made
					} else {
						node = r
					}
					continue
				}
				if seg.param {
					let w = node.wildcard
					if w is none {
						let made = new RoutingNode()
						node.wildcard = made
						node = made
					} else {
						node = w
					}
					continue
				}
				let child = node.children.get(seg.text)
				if child is none {
					let made = new RoutingNode()
					node.children[seg.text] = made
					node = made
				} else {
					node = child
				}
			}
			return node
		}

		// Collects every route whose pattern matches the path parts from
		// `index` on, without regard to method.
		def collect(parts string[], index int, into Route[]) {
			for let (_, route) in prefixes {
				into.push(route)
			}
			if index >= parts.len() {
				for let (_, route) in routes {
					into.push(route)
				}
				let r = rest
				r.collectRest(into) unless r is none
				return
			}
			let literal = children.get(parts[index])
			literal.collect(parts, index + 1, into) unless literal is none
			let w = wildcard
			w.collect(parts, index + 1, into) unless w is none
			let r = rest
			r.collectRest(into) unless r is none
		}

		def collectRest(into Route[]) {
			for let (_, route) in routes {
				into.push(route)
			}
		}
	}

	// Route is a registered pattern and its handler.
	internal struct Route {
		pattern Pattern
		handler Handler
	}
}
