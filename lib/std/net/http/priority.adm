partial module std.net.http {
	use std.net.http.http2

	// Priority is what the `Priority` header says about a request or a
	// response (RFC 9218): `urgency` from 0, most urgent, to 7, with 3
	// the default, and `incremental` for a response that is useful piece
	// by piece (a progressive image), so it may share bandwidth with
	// others of its urgency instead of going out whole.
	//
	//     let urgent = new Priority(1)
	//     req.headers.set("Priority", urgent.str())
	type Priority {
		urgency     int  = 3
		incremental bool = false

		def new(urgency int = 3, incremental bool = false) {
			self.urgency = urgency
			self.incremental = incremental
		}

		// str is the header value, leaving out what is the default:
		// `u=1, i`, `i`, or "" for the default priority.
		def str() string {
			let parts string[] = []
			parts.push("u={urgency}") when urgency != 3 && urgency >= 0 && urgency <= 7
			parts.push("i") when incremental
			return parts.join(", ")
		}
	}

	// parsePriority reads a `Priority` header value, a structured-field
	// dictionary such as `u=5, i`. It never fails: a member that is
	// unknown, malformed or out of range leaves its default, as RFC 9218
	// §4 asks.
	def parsePriority(value string) Priority {
		let (urgency, incremental) = http2.priorityOf(value)
		return new Priority(urgency, incremental)
	}
}
