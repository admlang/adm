partial module std.net.http {
	use std.testing

	check "Priority" {
		@test()
		def parsesAndWritesThePriorityHeader() !none {
			let cases = [
				("", 3, false, ""),
				("u=1", 1, false, "u=1"),
				("u=5, i", 5, true, "u=5, i"),
				("i, u=0", 0, true, "u=0, i"),
				("i=?0, u=7", 7, false, "u=7"),
				("u=3;x=1, i;y", 3, true, "i"),
				// Out of range, not an integer, unknown: the defaults stay.
				("u=8", 3, false, ""),
				("u=-1, i=1", 3, false, ""),
				("u=high, q=1", 3, false, ""),
				("u=2, u=4", 4, false, "u=4"),
			]
			for let (_, c) in cases {
				let (text, urgency, incremental, written) = c
				let got = parsePriority(text)
				fail "{text}: urgency {got.urgency} incremental {got.incremental}" when got.urgency != urgency || got.incremental != incremental
				fail "{text}: written as {got.str()}" when got.str() != written
			}
			let req = try newRequest(Method.GET, "https://example.org/")
			assert req.priority().urgency == 3 && !req.priority().incremental
			req.headers.add("Priority", "u=2")
			req.headers.add("Priority", "i")
			assert req.priority().urgency == 2 && req.priority().incremental
			return none
		}
	}
}
