partial module std.net.http {
	use (
		std.bytes
		std.net
		std.net.url
		std.net.url::(URL)
		std.time
		std.net.http.proxy::*
		std.net.http.request::(hostOnly)
		std.net.http.handlers::(cidrContains)
	)

	// Proxy names the proxy a request goes through, or none for a direct
	// connection. `Transport` tunnels https through an `http://` or
	// `https://` proxy with `CONNECT` and sends http requests to it in
	// absolute form (the `https` proxy itself reached over TLS), and
	// tunnels everything through a `socks5://`, `socks5h://`, `socks4://`
	// or `socks4a://` proxy (`std.net.proxy`). The proxy URL's user info
	// authenticates: `Proxy-Authorization: Basic`, the SOCKS5 username
	// and password, or the SOCKS4 user id.
	interface Proxy {
		// Fails when the proxy setting for the request cannot be parsed.
		def proxyFor(req Request) !?URL
	}

	// EnvironmentProxy reads `HTTP_PROXY`, `HTTPS_PROXY`, `ALL_PROXY` and
	// `NO_PROXY` (and their lowercase forms) once, the way curl and Go
	// do: `NO_PROXY` is a comma list of hosts, domain suffixes
	// (`.example.com`), IPs and CIDR blocks, or `*` for everything;
	// `localhost` and loopback never go through a proxy.
	type EnvironmentProxy {
		httpProxy  ?URL     = none
		httpsProxy ?URL     = none
		noProxy    string[] = []

		def new() {
			let all = firstSet(envAllProxy, envAllProxyLower)
			httpProxy = parseProxyURL(firstSet(envHTTPProxy, envHTTPProxyLower, all))
			httpsProxy = parseProxyURL(firstSet(envHTTPSProxy, envHTTPSProxyLower, all))
			for let entry in firstSet(envNoProxy, envNoProxyLower).split(",") {
				let host = entry.trim().lower()
				noProxy.push(host) when host != ""
			}
		}

		// Implements Proxy.
		def proxyFor(req Request) !?URL {
			let host = req.url.hostname()
			return none when bypasses(host)
			return req.url.scheme.lower() == "https" ?? (httpsProxy, httpProxy)
		}

		// Reports whether `host` (with or without port) bypasses the proxy
		// under `NO_PROXY`.
		def bypasses(host string) bool {
			let name = hostOnly(host).lower().trimPrefix("[").trimSuffix("]")
			return true when name == "" || name == "localhost" || name.endsWith(".localhost") || name == "::1" || name.startsWith("127.")
			for let rule in noProxy {
				return true when rule == "*"
				let bare = hostOnly(rule).trimPrefix("[").trimSuffix("]")
				continue when bare == ""
				return true when bare == name
				if bare.contains("/") {
					return true when cidrContains(bare, name)
					continue
				}
				// A suffix rule, with or without its leading dot.
				let suffix = bare.startsWith(".") ?? (bare, "." + bare)
				return true when name.endsWith(suffix)
			}
			return false
		}
	}

	// StaticProxy sends everything through one proxy URL.
	type StaticProxy {
		target URL

		def new(target URL) {
			self.target = target
		}

		// Implements Proxy.
		def proxyFor(req Request) !?URL {
			return target
		}
	}

	def proxyFromEnvironment() Proxy {
		let current = sharedEnvironmentProxy
		return current unless current is none
		let made = new EnvironmentProxy()
		sharedEnvironmentProxy = made
		return made
	}
}

internal partial module std.net.http.proxy {
	use (
		std.net.http.handlers::*
		std.net.http.request::*
		std.net.http.server::*
		std.bytes
		std.net
		std.net.url
		std.net.url::(URL)
		std.time
		std.net.http::*
		std.net.proxy::(connect, ProxyError)
	)

	// The proxy environment, read once when the process starts.
	@env("HTTP_PROXY")
	const envHTTPProxy string

	@env("http_proxy")
	const envHTTPProxyLower string

	@env("HTTPS_PROXY")
	const envHTTPSProxy string

	@env("https_proxy")
	const envHTTPSProxyLower string

	@env("ALL_PROXY")
	const envAllProxy string

	@env("all_proxy")
	const envAllProxyLower string

	@env("NO_PROXY")
	const envNoProxy string

	@env("no_proxy")
	const envNoProxyLower string

	// firstSet is the first non-empty value in the list, "" when none.
	def firstSet(values ...string) string {
		for let v in values {
			return v.trim() when v.trim() != ""
		}
		return ""
	}

	// parseProxyURL reads a proxy setting, adding `http://` when the
	// scheme is missing; none when empty or unparsable.
	def parseProxyURL(text string) ?URL {
		let value = text.trim()
		return none when value == ""
		value = "http://" + value unless value.contains("://")
		let parsed = url.parse(value) onerror recover new URL()
		return none when parsed.host == ""
		return parsed
	}

	// proxyFromEnvironment is the `Proxy` a new `Transport` uses; a
	// process reads the variables once.
	let sharedEnvironmentProxy ?EnvironmentProxy = none

	// tunnelThrough asks the proxy at the other end of the stream for a
	// tunnel to `target` ("host:443"): a SOCKS4, SOCKS4a or SOCKS5
	// request or an HTTP `CONNECT`, as the proxy URL's scheme says
	// (`std.net.proxy`).
	// Fails with HttpError (op "proxy") when the proxy refuses or does
	// not speak the protocol: `text` holds its reply code or status,
	// `cause` the `proxy.ProxyError`.
	def tunnelThrough(stream net.Stream, server URL, target string, timeout duration) !none {
		return connect(stream, server, target, timeout) onerror (err error) {
			fail err unless err is ProxyError
			fail HttpError{message: err.message, op: "proxy", text: err.reply.str(), status: err.reply >= 100 ?? (err.reply, 0), cause: err}
		}
	}
}
