partial module std.net.http {
	use (
		std.bytes
		std.data.encoding
		std.formats
		std.io
		std.net
		std.net.http.http2
		std.net.multipart
		std.net.tls
		std.net.url
		std.net.url::(URL, Values)
		std.reflection
		std.reflection::(Field, FieldKind, FieldMetaContext)
		std.time
	)

	// Qualified name of the `@form` meta function, used to look up field options.
	internal const formAttr = "std.net.http.form"

	// Names the form field, query key or route parameter a struct field is
	// bound from by `Request.bind`, `bindQuery` and `bindParams`, when it
	// differs from the field name.
	//
	//     struct Filter {
	//         @form("q")
	//         query string
	//         page int
	//     }
	meta def form(ctx FieldMetaContext, name string = "") {}

	// Request is one HTTP request: what a client sends, or what a server
	// received. The fields are the message; the methods read the parts
	// handlers reach for most (route parameters, query values, cookies, the
	// body as bytes, text, JSON or a form) and answer the questions a
	// handler asks of a request (what it accepts, whether it is secure,
	// where it came from).
	//
	// A client builds one with `newRequest`; a server fills one from the
	// wire with `readRequest` and hands it to the handler with `params` and
	// `remote` set.
	//
	// ```adm
	// let req = try http.newRequest(Method.POST, "https://example.com/items", "{\"n\":1}")
	// req.headers.set("Content-Type", "application/json")
	// req.bearerToken(token)
	// ```
	//
	// In a handler:
	//
	// ```adm
	// let id = req.param("id")
	// let page = req.query("page", "1")
	// let item = Item{}
	// try req.json(item)
	// ```
	type Request {
		method           Method               = Method.GET
		// The method as written when `method` is `Other` (`PROPFIND`);
		// "" otherwise.
		rawMethod        string               = ""
		url              URL
		// The protocol version as written: "HTTP/1.1", "HTTP/1.0", "HTTP/2".
		proto            string               = "HTTP/1.1"
		// The header block, canonical keys. `Host` is not in it: see `host`.
		headers          Header
		// The message body, none when there is none. A server request's
		// body is read once, from the connection; `bytes`, `text`, `json`,
		// `form` and `bind` read it to the end and keep it, so they can be
		// called in any order and more than once.
		body             ?io.Reader           = none
		// Length of the body in bytes when known, -1 when it is not (a
		// chunked or read-to-end body).
		contentLength    int                  = -1
		// The transfer codings applied to the body, outermost first;
		// empty means none.
		transferEncoding string[]             = []
		// True when the connection closes after this request (HTTP/1.0
		// default, or `Connection: close`).
		connectionClose  bool                 = false
		// The `Host` header of a server request, or the host a client
		// request is sent to when it differs from `url.host`.
		host             string               = ""
		// Trailer fields announced by the `Trailer` header. Filled once the
		// body has been read to the end.
		trailer          Header
		// Route parameters the router matched, `{id}` in `GET /users/{id}`.
		// Empty on a client request. Read with `param`.
		params           map<string, string>
		// Per-request state handlers and middleware share: a parsed session,
		// the authenticated user, a request-scoped logger. Never sent.
		state            map<string, any>
		// Identifier of the request for logs and tracing. A server assigns
		// one when the client sent none (`X-Request-Id`).
		id               string               = ""
		// When a server received the request, or a client sent it.
		received         time.Time
		// The peer a server request came from; none on a client request.
		remote           ?net.Address         = none
		// True when the request arrived over TLS. `isSecure` also honours a
		// trusted proxy's `X-Forwarded-Proto`.
		tls              bool                 = false
		// The TLS connection's negotiated state (version, suite, ALPN,
		// server name, resumption); none on a plain or client request.
		tlsState         ?tls.ConnectionState = none
		// When the request must be complete; none for no limit. A client
		// sets it from the timeout, a server from its read deadline. Once it
		// passes, body reads fail and `cancelled` reports true.
		deadline         ?time.Time           = none
		// The HTTP/2 stream a server took the request from; none over
		// HTTP/1.1 and on a client.
		stream           ?http2.Stream        = none

		// The `Form` values after `parseForm`: the query and, for a form
		// body, the body fields; none before.
		form          ?Values         = none
		// The body fields alone after `parseForm`; none before.
		postForm      ?Values         = none
		// The multipart form after `parseMultipartForm`; none before.
		multipartForm ?multipart.Form = none
		// The chunked reader behind `body` when the wire framed it so, for
		// the trailers it collects. Set by `readRequest`.
		chunkedBody   ?ChunkedReader  = none

		// The body's bytes once `replaceBody` set them or `bytes` read
		// them, so the body can be read again and a client can resend.
		internal bodyBytes   ?byte[]      = none
		internal bodyLimit   int          = 0
		internal parsedQuery ?Values      = none
		internal cancelFlag  bool         = false
		internal cancelHooks CancelHook[] = []

		def new() {
			self.headers = new Header()
			self.trailer = new Header()
			self.params = map<string, string>{}
			self.state = map<string, any>{}
			self.url = new URL()
			self.received = time.now()
		}

		// Route parameter, "" when the route has none by that name.
		//
		// ```adm
		// // GET /users/{id}
		// let id = req.param("id")
		// ```
		def param(name string) string {
			return param(name, "")
		}

		// Route parameter, or fallback when the route has none by that name.
		def param(name string, fallback string) string {
			let value = params.get(name)
			return fallback when value is none
			return value
		}

		// First query value under name, none when the query has no such key.
		// Decodes the query once and keeps it.
		def query(name string) ?string {
			return queryValues().get(name)
		}

		// First query value under name, or fallback when there is none.
		def query(name string, fallback string) string {
			let value = queryValues().get(name)
			return fallback when value is none
			return value
		}

		// Every query value under name, in order; empty when there are none.
		def queries(name string) string[] {
			return queryValues().all(name)
		}

		// The whole query, decoded. A query that does not decode is empty.
		def queryValues() Values {
			let cached = parsedQuery
			return cached unless cached is none
			let parsed = parseQueryText(self.url.rawQuery)
			parsedQuery = parsed
			return parsed
		}

		// The value of one header, "" when absent. Shorthand for
		// `headers.get(name)`.
		def header(name string) string {
			return headers.get(name)
		}

		// The host without a port: `example.com` for `example.com:8080`,
		// `::1` for `[::1]:8080`.
		def hostname() string {
			return hostOnly(host)
		}

		// The request path, decoded. Shorthand for `url.path`.
		def path() string {
			return url.path
		}

		// The request target as it goes on the wire: path and query
		// (`/search?q=x`), or `*` for a server-wide OPTIONS.
		def requestURI() string {
			return "*" when url.path == "*"
			return url.requestURI()
		}

		// The URL a client would show for this request: scheme, host and
		// request target, the way Django's `build_absolute_uri` does. Uses
		// `scheme(trustProxy)` and `host`.
		def absoluteURL(trustProxy bool = false) URL {
			let text = scheme(trustProxy) + "://" + host + requestURI()
			let parsed = parseURLText(text)
			return self.url when parsed is none
			return parsed
		}

		// "https" when the request is secure, else "http". With trustProxy,
		// a `X-Forwarded-Proto` or `Forwarded: proto=` from the peer wins.
		def scheme(trustProxy bool = false) string {
			if trustProxy {
				let forwarded = headers.get("X-Forwarded-Proto")
				if forwarded != "" {
					let first = firstToken(forwarded)
					return first.lower()
				}
				let viaForwarded = forwardedField(headers, "proto")
				return viaForwarded.lower() when viaForwarded != ""
			}
			return "https" when tls
			return url.scheme.lower() when url.scheme != ""
			return "http"
		}

		// Reports whether the request arrived over TLS, or, with trustProxy,
		// whether the proxy in front says it did.
		def isSecure(trustProxy bool = false) bool {
			return scheme(trustProxy) == "https"
		}

		// The client's address as text. Without trustProxy this is the peer
		// (`remote`); with it, the first address in `X-Forwarded-For`, then
		// `X-Real-IP`, then `Forwarded: for=`, then the peer. "" when unknown.
		def clientAddr(trustProxy bool = false) string {
			if trustProxy {
				let chain = forwardedFor()
				return chain[0] when chain.len() > 0
				let real = headers.get("X-Real-IP").trim()
				return real when real != ""
				let forwarded = forwardedField(headers, "for")
				return forwarded when forwarded != ""
			}
			let peer = remote
			return "" when peer is none
			return peer.host
		}

		// Every address in `X-Forwarded-For`, nearest proxy last; empty
		// when the header is absent.
		def forwardedFor() string[] {
			let out string[] = []
			for let value in headers.values("X-Forwarded-For") {
				for let part in value.split(",") {
					let addr = part.trim()
					out.push(addr) when addr != ""
				}
			}
			return out
		}

		// Reports whether the request asks to upgrade to a WebSocket
		// (`Connection: upgrade`, `Upgrade: websocket`).
		def isWebSocket() bool {
			return headers.hasToken("Connection", "upgrade") && headers.get("Upgrade").trim().lower() == "websocket"
		}

		// Reports whether the request was made by script rather than
		// navigation: `X-Requested-With: XMLHttpRequest`, or a
		// `Sec-Fetch-Mode` of `cors` or `same-origin`.
		def isAjax() bool {
			return true when headers.get("X-Requested-With").trim().lower() == "xmlhttprequest"
			let mode = headers.get("Sec-Fetch-Mode").trim().lower()
			return mode == "cors" || mode == "same-origin"
		}

		// Reports whether the request has a body to read: a content length
		// above zero, a transfer coding, or a client body reader.
		def hasBody() bool {
			return false when body is none
			return contentLength != 0
		}

		// Reports whether the client sent `Expect: 100-continue` and waits
		// for the server before sending the body.
		def expectsContinue() bool {
			return headers.hasToken("Expect", "100-continue")
		}

		// priority is what the client asks for (RFC 9218): its last
		// PRIORITY_UPDATE for the stream over HTTP/2, else the `Priority`
		// header, else the default priority. Several fields count as one
		// list.
		def priority() Priority {
			let s = stream
			if !(s is none) && s.priorityUpdate != "" {
				return parsePriority(s.priorityUpdate)
			}
			return parsePriority(headers.values("Priority").join(", "))
		}

		// Reports whether the protocol version is at least major.minor.
		def protoAtLeast(major int, minor int) bool {
			let (haveMajor, haveMinor) = protoVersion(proto)
			return haveMajor > major || (haveMajor == major && haveMinor >= minor)
		}

		// The body's media type from `Content-Type`, none when the header is
		// absent. Fails when the header does not parse.
		def contentType() !?formats.MediaType {
			return try headers.contentType()
		}

		// Reports whether the body's media type matches one of the given
		// ones: a full type (`application/json`), a type with a wildcard
		// (`text/*`, `*/*+json`), a bare subtype (`json`, also matching
		// `+json` suffixes), or an extension (`html`). False when there is
		// no `Content-Type` or it does not parse.
		//
		// ```adm
		// if req.bodyIs("json", "application/*+json") { … }
		// ```
		def bodyIs(types ...string) bool {
			let parsed = contentType() onerror recover none
			return false when parsed is none
			return mediaTypeIs(parsed, types)
		}

		// The offer the client prefers among the given media types, by
		// `Accept` and its q-values; none when it accepts none of them. No
		// `Accept` header accepts the first offer.
		//
		// ```adm
		// match req.accepts("application/json", "text/html") {
		//     case "text/html": …
		// }
		// ```
		def accepts(offers ...string) ?string {
			return negotiate(offers, parseAccept(headers.get("Accept")))
		}

		// The content coding the client prefers among the given ones, by
		// `Accept-Encoding`; none when it accepts none. `identity` is always
		// acceptable unless refused with q=0.
		def acceptsEncoding(offers ...string) ?string {
			let entries = parseAccept(headers.get("Accept-Encoding"))
			let choice = negotiate(offers, entries)
			return choice unless choice is none
			for let entry in entries {
				return none when (entry.value == "identity" || entry.value == "*") && entry.q <= 0.0
			}
			for let offer in offers {
				return offer when offer.lower() == "identity"
			}
			return none
		}

		// The language the client prefers among the given tags, by
		// `Accept-Language`; none when it accepts none. A tag matches its
		// prefix (`en` matches `en-GB`).
		def acceptsLanguage(offers ...string) ?string {
			return negotiate(offers, parseAccept(headers.get("Accept-Language")))
		}

		// The charset the client prefers among the given ones, by
		// `Accept-Charset`; none when it accepts none.
		def acceptsCharset(offers ...string) ?string {
			return negotiate(offers, parseAccept(headers.get("Accept-Charset")))
		}

		// Reports whether the client's copy is still current, from its
		// conditional headers: `If-None-Match` against etag, then
		// `If-Modified-Since` against lastModified. A fresh GET or HEAD is
		// answered 304 without a body; the writer's `file` and `conditional`
		// do this. False for other methods or without conditions.
		def isFresh(etag string, lastModified ?time.Time = none) bool {
			return evaluateConditions(self, etag, lastModified) == ConditionResult.NotModified
		}

		// The byte ranges a `Range` header asks for, resolved against a
		// body of size bytes and in request order; empty when there is no
		// `Range` header or the unit is not bytes. Fails when no range is
		// satisfiable (answer 416 with `Content-Range: bytes */size`).
		def ranges(size int) !ByteRange[] {
			return try parseRange(headers.get("Range"), size)
		}

		// The cookie of that name the client sent, none when it sent none.
		def cookie(name string) ?Cookie {
			let found = readCookies(headers, name)
			return none when found.len() == 0
			return found[0]
		}

		// Every cookie the client sent, in header order.
		def cookies() Cookie[] {
			return readCookies(headers)
		}

		// Adds a cookie to the `Cookie` header of a client request.
		def addCookie(c Cookie) {
			let pair = cookieHeaderValue([c])
			let existing = headers.get("Cookie")
			headers.set("Cookie", existing == "" ?? (pair, existing + "; " + pair))
		}

		// The credentials of a `Basic` `Authorization` header as (user,
		// password); none when the header is absent, is another scheme, or
		// does not decode.
		def basicAuth() ?(string, string) {
			let encoded = authScheme("basic")
			return none when encoded == ""
			let decoded = encoding.base64decode(encoded) onerror recover []
			return none when decoded.len() == 0
			let pair = string(decoded)
			let colon = pair.indexOf(":")
			return none when colon < 0
			let user = pair[:colon]
			let password = pair[colon + 1:]
			return (user, password)
		}

		// Sets the `Authorization` header to `Basic` with the user and
		// password. Not for a password containing a colon.
		def basicAuth(user string, password string) {
			headers.set("Authorization", "Basic " + encoding.base64encode((user + ":" + password).bytes()))
		}

		// The token of a `Bearer` `Authorization` header, none when absent
		// or another scheme.
		def bearerToken() ?string {
			let token = authScheme("bearer")
			return none when token == ""
			return token
		}

		// Sets the `Authorization` header to `Bearer` with the token.
		def bearerToken(token string) {
			headers.set("Authorization", "Bearer " + token)
		}

		// The credentials part of the `Authorization` header when its
		// scheme is the given one (case-insensitive), "" otherwise.
		internal def authScheme(scheme string) string {
			let value = headers.get("Authorization").trim()
			let sp = value.indexOf(" ")
			return "" when sp < 0
			return "" when value[:sp].lower() != scheme
			return value[sp + 1:].trim()
		}

		// The `User-Agent` header, "" when absent.
		def userAgent() string {
			return headers.get("User-Agent")
		}

		// The `Referer` header, "" when absent.
		def referer() string {
			return headers.get("Referer")
		}

		// The `Origin` header as a URL, none when absent or malformed.
		def origin() ?URL {
			let value = headers.get("Origin").trim()
			return none when value := "" || "null"
			return parseURLText(value)
		}

		// Replaces the body with data, sets `contentLength`, and keeps the
		// bytes so a client can resend the request on a redirect or a
		// stale pooled connection.
		def replaceBody(data byte[]) {
			bodyBytes = data
			body = new bytes.Reader(data)
			contentLength = data.len()
			transferEncoding = []
		}

		// Replaces the body with text, as `replaceBody(text.bytes())`.
		def replaceBody(text string) {
			replaceBody(text.bytes())
		}

		// Caps how much of the body may be read: once maxBytes have been
		// read, the next read fails with an `HttpError` whose `op` is
		// "body" and `code` "too-large", and the server sends 413. A server
		// applies its own limit before the handler runs; a handler tightens
		// it. No effect once the body has been read.
		def limitBody(maxBytes int) {
			bodyLimit = maxBytes
			let current = body
			return when current is none || !(bodyBytes is none)
			body = new MaxBytesReader(current, maxBytes)
		}

		// Reads the body to the end and keeps it, so a later `bytes`,
		// `text`, `json`, `form` or `bind` sees the same bytes. Empty when
		// there is no body. Fails when the read does, or the body exceeds
		// the `limitBody` cap.
		def bytes() !byte[] {
			let kept = bodyBytes
			return kept unless kept is none
			let source = body
			if source is none {
				bodyBytes = []
				return []
			}
			let data = try readAll(source)
			bodyBytes = data
			let chunked = chunkedBody
			trailer = chunked.trailer() unless chunked is none
			return data
		}

		// The body as text, decoded as the `Content-Type` charset: UTF-8
		// when it names none, ISO-8859-1 converted; other charsets are
		// returned as they are. Fails as `bytes` does.
		def text() !string {
			let data = try bytes()
			let parsed = contentType() onerror recover none
			return decodeCharset(data, parsed)
		}

		// Decodes the body as JSON onto target through
		// `std.data.encoding.JSON`. Fails as `bytes` does, when the body is
		// not JSON, or when the `Content-Type` is present and not a JSON type.
		def json(target any) !none {
			let parsed = try contentType()
			if !(parsed is none) {
				fail HttpError{message: "body is {parsed.essence()}, not JSON", op: "body", text: parsed.essence()} unless mediaTypeIs(parsed, ["json"])
			}
			let codec = new encoding.JSON()
			try codec.decode(try bytes(), target)
			return none
		}

		// Parses the query and, for a `application/x-www-form-urlencoded`
		// body, the body fields, into `form` and `postForm`; a body field
		// wins over a query key of the same name in `form`. Reads at most
		// 10 MiB of body. Fails when the body read fails or the encoding is
		// malformed. Calling it again is free.
		def parseForm() !none {
			return none unless form is none
			let fromBody = new Values()
			if methodAllowsBody(method) && bodyIs("application/x-www-form-urlencoded") {
				limitBody(10 * 1024 * 1024) when bodyLimit == 0
				let data = try bytes()
				fromBody = try parseQueryStrict(string(data), 100000)
			}
			let merged = new Values()
			for let pair in fromBody.pairs() {
				merged.add(pair.key, pair.value)
			}
			for let pair in queryValues().pairs() {
				merged.add(pair.key, pair.value)
			}
			postForm = fromBody
			form = merged
			return none
		}

		// Parses a `multipart/form-data` body into `multipartForm`, holding
		// up to maxMemory bytes of file parts in memory and spilling the
		// rest to temporary files, then calls `parseForm` so the fields
		// are in `form` and `postForm` too. Fails when the body is not
		// multipart, the read fails, or a part is malformed. Calling it
		// again is free.
		def parseMultipartForm(maxMemory int = 32 * 1024 * 1024) !none {
			return none unless multipartForm is none
			fail HttpError{message: "body is not multipart/form-data", op: "body"} unless bodyIs("multipart/form-data")
			let source = body
			fail HttpError{message: "request has no body", op: "body"} when source is none
			let reader = try multipart.readerFor(source, headers.get("Content-Type"))
			let parsed = try reader.readForm(maxMemory)
			multipartForm = parsed
			try parseForm()
			let merged = form
			let fields = postForm
			return none when merged is none
			return none when fields is none
			let extra = parsed.values
			for let pair in extra.pairs() {
				fields.add(pair.key, pair.value)
				merged.add(pair.key, pair.value)
			}
			return none
		}

		// First value of a form field from the query or a form body, ""
		// when absent. Parses the form first, multipart or urlencoded, and
		// ignores parse errors; call `parseForm` or `parseMultipartForm`
		// yourself to see them.
		def formValue(name string) string {
			ensureFormParsed()
			let values = form
			return "" when values is none
			let value = values.get(name)
			return "" when value is none
			return value
		}

		// First value of a form field from the body only, "" when absent.
		def postFormValue(name string) string {
			ensureFormParsed()
			let values = postForm
			return "" when values is none
			let value = values.get(name)
			return "" when value is none
			return value
		}

		internal def ensureFormParsed() {
			if bodyIs("multipart/form-data") {
				parseMultipartForm() onerror recover none
			} else {
				parseForm() onerror recover none
			}
		}

		// The first uploaded file under the field name, calling
		// `parseMultipartForm` first. Fails when the body is not multipart
		// or the field has no file.
		def formFile(name string) !multipart.FileHeader {
			try parseMultipartForm()
			let files = formFiles(name)
			fail HttpError{message: "no file under form field {name}", op: "form", text: name} when files.len() == 0
			return files[0]
		}

		// Every uploaded file under the field name; empty when none, or
		// when the body is not a multipart form.
		def formFiles(name string) multipart.FileHeader[] {
			parseMultipartForm() onerror recover none
			let parsed = multipartForm
			return [] when parsed is none
			return parsed.filesFor(name)
		}

		// Decodes the request onto target by its `Content-Type`: JSON as
		// `json`, a form or multipart body by field name onto the fields
		// (`@form("name")` renames one), and, for a request without a body,
		// the query values the same way. Fails when the body does not
		// decode, or a value does not fit its field.
		//
		// ```adm
		// let filter = SearchFilter{}
		// try req.bind(filter)
		// ```
		def bind(target any) !none {
			return try json(target) when bodyIs("json")
			if bodyIs("multipart/form-data") {
				try parseMultipartForm()
			} else if bodyIs("application/x-www-form-urlencoded") {
				try parseForm()
			} else {
				return try bindValues(queryValues(), target)
			}
			let values = form
			return none when values is none
			return try bindValues(values, target)
		}

		// Decodes the query values onto target by field name, whatever the
		// body holds. Fails when a value does not fit its field.
		def bindQuery(target any) !none {
			return try bindValues(queryValues(), target)
		}

		// Decodes the route parameters onto target by field name. Fails
		// when a value does not fit its field.
		def bindParams(target any) !none {
			let values = new Values()
			for let key in params.keys() {
				values.add(key, param(key))
			}
			return try bindValues(values, target)
		}

		// Reports whether the request was cancelled: the client went away,
		// the deadline passed, or `cancel` was called. A long handler polls
		// it between steps.
		def cancelled() bool {
			return true when cancelFlag
			let limit = deadline
			return false when limit is none
			return time.now().after(limit)
		}

		// Cancels the request: pending body reads fail, and a client
		// request in flight is abandoned. The `onCancel` hooks run once.
		def cancel() {
			return when cancelFlag
			cancelFlag = true
			let hooks = cancelHooks
			cancelHooks = []
			for let hook in hooks {
				hook.run()
			}
		}

		// Registers fn to run once when the request is cancelled, on the
		// cancelling task. Runs at once when it already is.
		def onCancel(fn def()) {
			if cancelled() {
				fn()
				return
			}
			cancelHooks.push(new CancelHook(fn))
		}

		// Writes the request in wire form: request line, headers, blank
		// line and body, framed by `contentLength` or chunked when it is
		// unknown. `Host` comes first, from `host` or the URL. Fails when
		// the writer or the body read does.
		def write(w io.Writer) !none {
			try writeHead(w)
			return try writeBody(w)
		}

		// Writes the request as a proxy forwards it: absolute URL in the
		// request line, hop-by-hop headers stripped. Fails as `write` does.
		def writeProxy(w io.Writer) !none {
			try writeHead(w, true)
			return try writeBody(w)
		}

		// Writes the request line and header block alone, as a client
		// holding the body back for `100 Continue` does; `writeBody`
		// follows. `viaProxy` writes the absolute-URL form of
		// `writeProxy`. Fails when the writer does.
		def writeHead(w io.Writer, viaProxy bool = false) !none {
			let out = new bytes.Buffer()
			let hostName = host != "" ?? (host, url.host)
			let target = viaProxy ?? (url.str(), requestURI())
			try out.writeString(methodText() + " " + target + " " + proto + "\r\n")
			try out.writeString("Host: " + hostName + "\r\n") when hostName != ""
			let fields = headers.clone()
			fields.stripHopByHop() when viaProxy
			fields.del("Host")
			let kept = bodyBytes
			let hasReader = !(body is none)
			if !(kept is none) {
				let size = kept.len()
				fields.set("Content-Length", size.str())
				fields.del("Transfer-Encoding")
			} else if hasReader && contentLength >= 0 {
				fields.set("Content-Length", contentLength.str())
				fields.del("Transfer-Encoding")
			} else if hasReader {
				fields.set("Transfer-Encoding", "chunked")
				fields.del("Content-Length")
			}
			try fields.write(out)
			try out.writeString("\r\n")
			return try writeFully(w, out.bytes())
		}

		// Bytes of body `writeBody` sends: the held bytes or
		// `contentLength`; 0 without a body, -1 when a reader's length is
		// unknown.
		def bodyLength() int {
			let kept = bodyBytes
			return kept.len() unless kept is none
			return 0 when body is none
			return contentLength
		}

		// Writes the body after `writeHead`, framed the same way: the
		// held bytes, a reader of `contentLength` bytes, or a chunked
		// stream when the length is unknown. With `chunked` false a body
		// of unknown length goes out as it is, for a transport that frames
		// it itself. Fails when the writer or the body read does.
		def writeBody(w io.Writer, chunked bool = true) !none {
			let kept = bodyBytes
			if !(kept is none) {
				try writeFully(w, kept)
				return none
			}
			let source = body
			return none when source is none
			if contentLength < 0 && chunked {
				let writer = new ChunkedWriter(w)
				let chunk byte[] = []
				chunk.len(32 * 1024)
				for {
					let n = try source.read(chunk)
					break when n <= 0
					try writer.write(chunk.slice(0, n))
				}
				try writer.close()
				return none
			}
			try copyBody(source, w)
			return none
		}

		// The method as text: the enum value, or `rawMethod` for `Other`.
		internal def methodText() string {
			return rawMethod when method == Method.Other && rawMethod != ""
			return method.value
		}

		// A copy with its own headers, params, state and query; the body
		// reader is shared unless `replaceBody` gave the request bytes, which
		// are copied too.
		def clone() Request {
			let copy = new Request()
			copy.method = method
			copy.rawMethod = rawMethod
			let reparsed = parseURLText(url.str())
			copy.url = reparsed is none ?? (url, reparsed)
			copy.proto = proto
			copy.headers = headers.clone()
			copy.body = body
			copy.contentLength = contentLength
			copy.transferEncoding = transferEncoding.clone()
			copy.connectionClose = connectionClose
			copy.host = host
			copy.trailer = trailer.clone()
			copy.params = params.clone()
			copy.state = state.clone()
			copy.id = id
			copy.received = received
			copy.remote = remote
			copy.tls = tls
			copy.tlsState = tlsState
			copy.deadline = deadline
			copy.bodyLimit = bodyLimit
			let kept = bodyBytes
			copy.replaceBody(kept.clone()) unless kept is none
			return copy
		}

		// The request line: `GET /path?q=1 HTTP/1.1`.
		def str() string {
			return methodText() + " " + requestURI() + " " + proto
		}
	}

	// CancelHook holds one `onCancel` callback.
	internal type CancelHook {
		internal fn def ()

		def new(fn def ()) {
			self.fn = fn
		}

		def run() {
			fn()
		}
	}

	// hostOnly strips the port from a host: `[::1]:80` gives `::1`.
	internal def hostOnly(host string) string {
		if host.startsWith("[") {
			let end = host.indexOf("]")
			return host[1:end] when end > 0
			return host
		}
		let colon = host.indexOf(":")
		return host when colon < 0
		// More than one colon is a bare IPv6 address, not host:port.
		return host when host[colon + 1:].contains(":")
		return host[:colon]
	}

	// parseQueryStrict decodes a form body. Fails when it does not decode
	// or has more than maxFields fields.
	internal def parseQueryStrict(text string, maxFields int) !Values {
		return try url.parseQuery(text, maxFields)
	}

	// parseQueryText decodes a query, empty when it does not decode.
	internal def parseQueryText(text string) Values {
		return url.parseQuery(text) onerror recover new Values()
	}

	// parseURLText parses a URL, none when it does not.
	internal def parseURLText(text string) ?URL {
		let ok = true
		let parsed = url.parse(text) onerror (err error) {
			ok = false
			recover new URL()
		}
		return none unless ok
		return parsed
	}

	// forwardedField is the named parameter of the first `Forwarded`
	// element (RFC 7239), unquoted; "" when absent.
	internal def forwardedField(headers Header, name string) string {
		let value = headers.get("Forwarded")
		return "" when value == ""
		let first = firstToken(value)
		for let piece in first.split(";") {
			let eq = piece.indexOf("=")
			continue when eq < 0
			continue when piece[:eq].trim().lower() != name
			return unquoteToken(piece[eq + 1:].trim())
		}
		return ""
	}

	// firstToken is the first comma-separated member of a header value.
	internal def firstToken(value string) string {
		let comma = value.indexOf(",")
		return value.trim() when comma < 0
		return value[:comma].trim()
	}

	// protoVersion reads `HTTP/major.minor`; (0, 0) for anything else.
	internal def protoVersion(proto string) (int, int) {
		return (0, 0) unless proto.startsWith("HTTP/")
		let rest = proto[5:]
		let dot = rest.indexOf(".")
		if dot < 0 {
			return (0, 0) unless isDigits(rest)
			return (parseInt<int>(rest), 0)
		}
		let major = rest[:dot]
		let minor = rest[dot + 1:]
		return (0, 0) unless isDigits(major) && isDigits(minor)
		return (parseInt<int>(major), parseInt<int>(minor))
	}

	// mediaTypeIs is the matching rule behind `Request.bodyIs`.
	internal def mediaTypeIs(mt formats.MediaType, types string[]) bool {
		let mainType = mt.mainType.lower()
		let subtype = mt.subtype.lower()
		for let raw in types {
			let pattern = raw.trim().lower()
			continue when pattern == ""
			let slash = pattern.indexOf("/")
			if slash >= 0 {
				let wantType = pattern[:slash]
				let wantSub = pattern[slash + 1:]
				continue unless wantType == "*" || wantType == mainType
				return true when wantSub == "*" || wantSub == subtype
				return true when wantSub.startsWith("*+") && subtype.endsWith(wantSub[1:])
				continue
			}
			return true when subtype == pattern || subtype.endsWith("+" + pattern)
			let byExt = formats.typeByExtension(pattern)
			continue when byExt is none
			let essence = byExt.lower()
			let sep = essence.indexOf(";")
			essence = essence[:sep].trim() when sep >= 0
			return true when essence == mainType + "/" + subtype
		}
		return false
	}

	// decodeCharset turns body bytes into text by the media type's
	// charset: UTF-8 as is (also for none), ISO-8859-1 converted, the rest
	// returned as they are.
	internal def decodeCharset(data byte[], mt ?formats.MediaType) string {
		return string(data) when mt is none
		let charset = mt.charset()
		return string(data) when charset is none
		let name = charset.lower()
		if name := "iso-8859-1" || "latin1" || "latin-1" || "windows-1252" {
			let out = ""
			for let b in data {
				out += string(char(b))
			}
			return out
		}
		return string(data)
	}

	// bindValues sets target's fields from the values with the same name,
	// or the name the field's `@form` annotation gives. Keys match exactly
	// first, then case-insensitively. Scalars take the first value, arrays
	// every value. Fails when a value does not fit its field, or a field
	// with a value has a type that cannot be bound.
	internal def bindValues(values Values, target any) !none {
		for let (_, f) in reflection.fields(target) {
			let explicit = f.attr(formAttr, "name")
			let key = explicit != "" ?? (explicit, f.name)
			let found = values.all(key)
			if found.len() == 0 {
				let lowered = key.lower()
				for let candidate in values.keys() {
					if candidate.lower() == lowered {
						found = values.all(candidate)
						break
					}
				}
			}
			continue when found.len() == 0
			match f.kind {
				case FieldKind.Array:
					f.setLen(found.len())
					for let i = 0; i < found.len(); i++ {
						try bindScalar(f.at(i), f.elemKind, found[i], f.name)
					}
				case FieldKind.Optional:
					continue
				default:
					try bindScalar(f, f.kind, found[0], f.name)
			}
		}
		return none
	}

	internal def bindScalar(f Field, kind FieldKind, text string, name string) !none {
		// An empty value leaves a number or flag at zero, as a blank form
		// field means "not given".
		return none when text.trim() == "" && kind != FieldKind.String
		match kind {
			case FieldKind.String:
				f.setString(text)
			case FieldKind.Bool:
				f.setBool(isTruthyValue(text))
			case FieldKind.Int:
				fail HttpError{message: "cannot read \"{text}\" into {name}: not an integer", op: "bind", text: text} unless isSignedDigits(text)
				f.setInt(parseInt<int>(text))
			case FieldKind.Uint:
				fail HttpError{message: "cannot read \"{text}\" into {name}: not a whole number", op: "bind", text: text} unless isDigits(text.trim())
				f.setUint(uint(parseInt<int>(text)))
			case FieldKind.Float:
				fail HttpError{message: "cannot read \"{text}\" into {name}: not a number", op: "bind", text: text} unless isNumberText(text)
				f.setFloat(parseFloat<float>(text))
			default:
				fail HttpError{message: "cannot bind {name}: unsupported field type", op: "bind", text: name}
		}
		return none
	}

	internal def isTruthyValue(text string) bool {
		match text.trim().lower() {
			case "true", "yes", "on", "y", "1":
				return true
			default:
				return false
		}
	}

	internal def isSignedDigits(raw string) bool {
		let text = raw.trim()
		text = text[1:] when text.startsWith("-") || text.startsWith("+")
		return isDigits(text)
	}

	internal def isNumberText(raw string) bool {
		return /^[+-]?([0-9]+(\.[0-9]+)?|\.[0-9]+)([eE][+-]?[0-9]+)?$/.test(raw.trim())
	}

	// newRequest builds a client request for the method and URL with an
	// optional body. The URL's host becomes `host`, and a body's length is
	// unknown until `replaceBody` or `contentLength` says. Fails when the URL
	// does not parse or has no scheme and host.
	//
	// ```adm
	// let req = try http.newRequest(Method.GET, "https://example.com/")
	// ```
	def newRequest(method Method, target string, body ?io.Reader = none) !Request {
		let parsed = url.parse(target) onerror (err error) {
			fail HttpError{message: "invalid request URL: {target}", op: "request", text: target, cause: err}
		}
		return try newRequest(method, parsed, body)
	}

	// newRequest builds a client request for the method and URL with a
	// body of bytes, kept for resends; `contentLength` is data's length.
	// Fails when the URL has no scheme and host.
	def newRequest(method Method, target string, body byte[]) !Request {
		let req = try newRequest(method, target)
		req.replaceBody(body)
		return req
	}

	// newRequest builds a client request with a text body, as bytes.
	// Fails when the URL has no scheme and host.
	def newRequest(method Method, target string, body string) !Request {
		return try newRequest(method, target, body.bytes())
	}

	// newRequest builds a client request for an already parsed URL. Fails
	// when the URL has no scheme and host.
	def newRequest(method Method, target URL, body ?io.Reader = none) !Request {
		fail HttpError{message: "request URL needs a scheme and a host: {target.str()}", op: "request", text: target.str()} when target.scheme == "" || target.host == ""
		let req = new Request()
		req.method = method
		req.url = target
		req.host = target.host
		req.body = body
		req.contentLength = body is none ?? (0, -1)
		return req
	}
}
