partial module std.net.http {
	use (
		std.bytes
		std.io
		std.net.url
		std.testing
	)

	internal struct Filter {
		@form("q")
		query string
		page int
		tags string[]
		exact bool
		ratio float
	}

	internal struct Item {
		name  string
		count int
	}

	internal type Counter {
		n int = 0

		def new() {}

		def bump() {
			n++
		}
	}

	// requestOf parses a request from wire text.
	internal def requestOf(text string) !Request {
		return try readRequest(new bytes.Reader(text.bytes()))
	}

	internal def orEmpty(value ?string) string {
		return "" when value is none
		return value
	}

	check "HTTP request" {
		@test()
		def paramsQueryAndHeaders() !none {
			let req = try requestOf("GET /users/7?page=2&tag=a&tag=b HTTP/1.1\r\nHost: example.com:8080\r\nX-Token: abc\r\n\r\n")
			req.params["id"] = "7"
			assert req.param("id") == "7"
			assert req.param("missing") == ""
			assert req.param("missing", "none") == "none"
			assert orEmpty(req.query("page")) == "2"
			assert req.query("page", "1") == "2"
			assert req.query("size", "10") == "10"
			assert req.query("size") is none
			assert req.queries("tag").len() == 2
			assert req.queries("tag")[1] == "b"
			assert req.header("x-token") == "abc"
			assert req.hostname() == "example.com"
			assert req.path() == "/users/7"
			assert req.requestURI() == "/users/7?page=2&tag=a&tag=b"
			assert req.str() == "GET /users/7?page=2&tag=a&tag=b HTTP/1.1"
			assert req.protoAtLeast(1, 1)
			assert !req.protoAtLeast(2, 0)
			assert hostOnly("[::1]:8080") == "::1"
			assert hostOnly("::1") == "::1"
			assert hostOnly("host") == "host"
			return none
		}

		@test()
		def schemeAddressAndProxyHeaders() !none {
			let req = try requestOf("GET / HTTP/1.1\r\nHost: h\r\nX-Forwarded-Proto: https\r\nX-Forwarded-For: 10.0.0.1, 10.0.0.2\r\n\r\n")
			assert req.scheme() == "http"
			assert !req.isSecure()
			assert req.scheme(true) == "https"
			assert req.isSecure(true)
			assert req.clientAddr() == ""
			assert req.clientAddr(true) == "10.0.0.1"
			assert req.forwardedFor().len() == 2
			assert req.absoluteURL(true).str() == "https://h/"
			req.tls = true
			assert req.scheme() == "https"
			let std = try requestOf("GET / HTTP/1.1\r\nHost: h\r\nForwarded: for=\"[2001:db8::1]\";proto=https, for=10.0.0.9\r\n\r\n")
			assert std.clientAddr(true) == "[2001:db8::1]"
			assert std.scheme(true) == "https"
			return none
		}

		@test()
		def kindOfRequest() !none {
			let ws = try requestOf("GET /chat HTTP/1.1\r\nHost: h\r\nConnection: keep-alive, Upgrade\r\nUpgrade: WebSocket\r\n\r\n")
			assert ws.isWebSocket()
			assert !ws.isAjax()
			assert !ws.hasBody()
			let ajax = try requestOf("GET /api HTTP/1.1\r\nHost: h\r\nX-Requested-With: XMLHttpRequest\r\n\r\n")
			assert ajax.isAjax()
			let fetch = try requestOf("GET /api HTTP/1.1\r\nHost: h\r\nSec-Fetch-Mode: cors\r\n\r\n")
			assert fetch.isAjax()
			let post = try requestOf("POST /api HTTP/1.1\r\nHost: h\r\nExpect: 100-continue\r\nContent-Length: 2\r\n\r\nok")
			assert post.hasBody()
			assert post.expectsContinue()
			return none
		}

		@test()
		def bodyTypesAndNegotiation() !none {
			let req = try requestOf("POST /api HTTP/1.1\r\nHost: h\r\nContent-Type: application/vnd.api+json; charset=utf-8\r\nAccept: text/html;q=0.9, application/json\r\nAccept-Encoding: gzip, br;q=0.8\r\nAccept-Language: fr;q=0.5, en\r\nContent-Length: 0\r\n\r\n")
			assert req.bodyIs("json")
			assert req.bodyIs("application/*+json")
			assert req.bodyIs("application/vnd.api+json")
			assert req.bodyIs("html", "application/*")
			assert !req.bodyIs("html")
			assert !req.bodyIs("text/*")
			assert orEmpty(req.accepts("text/html", "application/json")) == "application/json"
			assert orEmpty(req.accepts("text/plain")) == ""
			assert orEmpty(req.acceptsEncoding("br", "gzip")) == "gzip"
			assert orEmpty(req.acceptsEncoding("identity")) == "identity"
			assert orEmpty(req.acceptsLanguage("fr", "en-GB")) == "en-GB"
			assert orEmpty(req.acceptsCharset("utf-8")) == "utf-8"
			let bare = try requestOf("GET / HTTP/1.1\r\nHost: h\r\n\r\n")
			assert !bare.bodyIs("json")
			assert orEmpty(bare.accepts("text/html", "application/json")) == "text/html"
			let refused = try requestOf("GET / HTTP/1.1\r\nHost: h\r\nAccept-Encoding: identity;q=0\r\n\r\n")
			assert refused.acceptsEncoding("identity") is none
			return none
		}

		@test()
		def conditionalsAndRanges() !none {
			let req = try requestOf("GET /f HTTP/1.1\r\nHost: h\r\nIf-None-Match: \"v1\"\r\nRange: bytes=0-3\r\n\r\n")
			assert req.isFresh("\"v1\"")
			assert !req.isFresh("\"v2\"")
			let ranges = try req.ranges(100)
			assert ranges.len() == 1 && ranges[0].length == 4
			let plain = try requestOf("GET /f HTTP/1.1\r\nHost: h\r\n\r\n")
			assert (try plain.ranges(100)).len() == 0
			return none
		}

		@test()
		def cookiesAndAuthorization() !none {
			let req = try requestOf("GET / HTTP/1.1\r\nHost: h\r\nCookie: a=1; b=2\r\nAuthorization: Basic dXNlcjpwYXNz\r\nUser-Agent: adm/1\r\nReferer: http://h/prev\r\nOrigin: https://app.example\r\n\r\n")
			assert req.cookies().len() == 2
			let b = req.cookie("b")
			assert !(b is none)
			assert orEmpty(b is none ?? (none, b.value)) == "2"
			assert req.cookie("zz") is none
			let auth = req.basicAuth()
			assert !(auth is none)
			if !(auth is none) {
				let (user, password) = auth
				assert user == "user" && password == "pass"
			}
			assert req.bearerToken() is none
			assert req.userAgent() == "adm/1"
			assert req.referer() == "http://h/prev"
			let origin = req.origin()
			assert !(origin is none)
			assert orEmpty(origin is none ?? (none, origin.host)) == "app.example"

			let out = try newRequest(Method.GET, "http://h/")
			out.basicAuth("me", "secret")
			let back = out.basicAuth()
			assert !(back is none)
			if !(back is none) {
				let (user, password) = back
				assert user == "me" && password == "secret"
			}
			out.bearerToken("tok")
			assert orEmpty(out.bearerToken()) == "tok"
			assert out.basicAuth() is none
			out.addCookie(new Cookie("s", "1"))
			out.addCookie(new Cookie("t", "2"))
			assert out.headers.get("Cookie") == "s=1; t=2"
			assert out.cookies().len() == 2
			return none
		}

		@test()
		def bodyReadsRepeatAndDecode() !none {
			let req = try requestOf("POST /api HTTP/1.1\r\nHost: h\r\nContent-Type: application/json\r\nContent-Length: 24\r\n\r\n{\"name\":\"pen\",\"count\":3}")
			assert string(try req.bytes()) == "{\"name\":\"pen\",\"count\":3}"
			assert (try req.text()) == "{\"name\":\"pen\",\"count\":3}"
			let item = Item{}
			try req.json(item)
			assert item.name == "pen" && item.count == 3
			let again = Item{}
			try req.bind(again)
			assert again.count == 3

			let wrong = try requestOf("POST /api HTTP/1.1\r\nHost: h\r\nContent-Type: text/plain\r\nContent-Length: 2\r\n\r\n{}")
			assert wrong.json(Item{}) is error

			let raw = "POST /t HTTP/1.1\r\nHost: h\r\nContent-Type: text/plain; charset=iso-8859-1\r\nContent-Length: 4\r\n\r\ncaf".bytes().concat([0xE9])
			let latin = try readRequest(new bytes.Reader(raw))
			assert (try latin.text()) == "café"
			let blank = try requestOf("GET / HTTP/1.1\r\nHost: h\r\n\r\n")
			assert (try blank.bytes()).len() == 0
			return none
		}

		@test()
		def bodyLimitStopsLargeBodies() !none {
			let req = try requestOf("POST /api HTTP/1.1\r\nHost: h\r\nContent-Length: 6\r\n\r\nhello!")
			req.limitBody(5)
			let read = req.bytes() onerror (e error) {
				assert e.code == "too-large"
				recover []
			}
			assert read.len() == 0
			return none
		}

		@test()
		def formsUrlEncoded() !none {
			let req = try requestOf("POST /s?page=3&q=ignored HTTP/1.1\r\nHost: h\r\nContent-Type: application/x-www-form-urlencoded\r\nContent-Length: 35\r\n\r\nq=pens&tags=a&tags=b&exact=on&ratio=")
			assert req.formValue("q") == "pens"
			assert req.postFormValue("q") == "pens"
			assert req.formValue("page") == "3"
			assert req.postFormValue("page") == ""
			assert req.formValue("nope") == ""
			let filter = Filter{}
			try req.bind(filter)
			assert filter.query == "pens"
			assert filter.page == 3
			assert filter.tags.len() == 2 && filter.tags[1] == "b"
			assert filter.exact
			assert filter.ratio == 0.0
			return none
		}

		@test()
		def bindQueryAndParams() !none {
			let req = try requestOf("GET /s?Q=x&page=abc HTTP/1.1\r\nHost: h\r\n\r\n")
			let filter = Filter{}
			assert req.bind(filter) is error
			let loose = try requestOf("GET /s?Q=x&PAGE=4&ratio=1.5 HTTP/1.1\r\nHost: h\r\n\r\n")
			let f2 = Filter{}
			try loose.bindQuery(f2)
			assert f2.query == "x" && f2.page == 4 && f2.ratio == 1.5
			loose.params["page"] = "9"
			let f3 = Filter{}
			try loose.bindParams(f3)
			assert f3.page == 9 && f3.query == ""
			return none
		}

		@test()
		def multipartForm() !none {
			let body = "--b\r\nContent-Disposition: form-data; name=\"title\"\r\n\r\nholiday\r\n--b\r\nContent-Disposition: form-data; name=\"photo\"; filename=\"a.txt\"\r\nContent-Type: text/plain\r\n\r\nhello\r\n--b--\r\n"
			let req = try requestOf("POST /u HTTP/1.1\r\nHost: h\r\nContent-Type: multipart/form-data; boundary=b\r\nContent-Length: {body.len()}\r\n\r\n" + body)
			assert req.formValue("title") == "holiday"
			let file = try req.formFile("photo")
			assert file.filename == "a.txt"
			assert file.size == 5
			assert req.formFiles("photo").len() == 1
			assert req.formFiles("none").len() == 0
			assert req.formFile("none") is error
			let plain = try requestOf("GET / HTTP/1.1\r\nHost: h\r\n\r\n")
			assert plain.parseMultipartForm() is error
			return none
		}

		@test()
		def cancellation() !none {
			let req = try requestOf("GET / HTTP/1.1\r\nHost: h\r\n\r\n")
			assert !req.cancelled()
			let hits = new Counter()
			req.onCancel(def () {hits.bump()})
			req.cancel()
			req.cancel()
			assert req.cancelled()
			assert hits.n == 1
			req.onCancel(def () {hits.bump()})
			assert hits.n == 2
			return none
		}

		@test()
		def writesWireForm() !none {
			let req = try newRequest(Method.POST, "http://example.com/items?x=1", "{\"n\":1}")
			req.headers.set("Content-Type", "application/json")
			let out = new bytes.Buffer()
			try req.write(out)
			assert string(out.bytes()) == "POST /items?x=1 HTTP/1.1\r\nHost: example.com\r\nContent-Length: 7\r\nContent-Type: application/json\r\n\r\n{\"n\":1}"
			let back = try readRequest(new bytes.Reader(out.bytes()))
			assert back.host == "example.com"
			assert (try back.text()) == "{\"n\":1}"

			let streamed = try newRequest(Method.PUT, "http://example.com/up", new bytes.Reader("abc".bytes()))
			let out2 = new bytes.Buffer()
			try streamed.write(out2)
			assert string(out2.bytes()) == "PUT /up HTTP/1.1\r\nHost: example.com\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n0\r\n\r\n"

			let proxied = try newRequest(Method.GET, "http://example.com/p")
			proxied.headers.set("Connection", "keep-alive")
			proxied.headers.set("Accept", "*/*")
			let out3 = new bytes.Buffer()
			try proxied.writeProxy(out3)
			assert string(out3.bytes()) == "GET http://example.com/p HTTP/1.1\r\nHost: example.com\r\nAccept: */*\r\n\r\n"
			return none
		}

		@test()
		def cloneIsIndependent() !none {
			let req = try newRequest(Method.POST, "http://h/a", "body")
			req.headers.set("X-A", "1")
			req.params["id"] = "1"
			req.state["user"] = "ann"
			let copy = req.clone()
			copy.headers.set("X-A", "2")
			copy.params["id"] = "2"
			copy.url.path = "/b"
			assert req.headers.get("X-A") == "1"
			assert req.param("id") == "1"
			assert req.url.path == "/a"
			assert copy.url.path == "/b"
			assert (try copy.text()) == "body"
			assert (try req.text()) == "body"
			return none
		}

		@test()
		def newRequestValidatesTheUrl() !none {
			assert newRequest(Method.GET, "/relative") is error
			assert newRequest(Method.GET, "http://[::1") is error
			let req = try newRequest(Method.GET, "https://example.com:8443/x")
			assert req.host == "example.com:8443"
			assert req.hostname() == "example.com"
			assert req.body is none
			assert req.contentLength == 0
			let withBytes = try newRequest(Method.POST, "https://example.com/", [1, 2, 3])
			assert withBytes.contentLength == 3
			let parsed = try newRequest(Method.GET, try url.parse("https://example.com/"))
			assert parsed.url.host == "example.com"
			return none
		}
	}
}
