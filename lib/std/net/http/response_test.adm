partial module std.net.http {
	use (
		std.bytes
		std.io
		std.os
		std.testing
		std.time
	)

	internal struct Payload {
		name  string
		count int
	}

	// writerFor is a ResponseWriter over a buffer, answering the request in
	// the wire text.
	internal def writerFor(text string) !(ResponseWriter, bytes.Buffer) {
		let req = try readRequest(new bytes.Reader(text.bytes()))
		let sink = new bytes.Buffer()
		let w = new ResponseWriter(req, sink)
		return (w, sink)
	}

	internal def outputOf(sink bytes.Buffer) string {
		return string(sink.bytes())
	}

	// headBlock is the status line and headers, each line with its CRLF;
	// bodyOf is what follows the blank line.
	internal def headBlock(text string) string {
		let at = text.indexOf("\r\n\r\n")
		return text when at < 0
		return text[:at + 2]
	}

	internal def bodyOf(text string) string {
		let at = text.indexOf("\r\n\r\n")
		return "" when at < 0
		return text[at + 4:]
	}

	check "HTTP response" {
		@test()
		def responseFromTheWire() !none {
			let req = try newRequest(Method.GET, "http://h/items/1")
			let res = try readResponse(wireOf("HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nETag: \"v1\"\r\nLast-Modified: Wed, 21 Oct 2015 07:28:00 GMT\r\nSet-Cookie: a=1; Path=/\r\nLocation: /next\r\nContent-Length: 24\r\n\r\n{\"name\":\"pen\",\"count\":3}"), req)
			assert res.ok()
			assert res.statusClass() == StatusClass.Success
			assert res.header("etag") == "\"v1\""
			assert res.etag() == "\"v1\""
			assert !(res.lastModified() is none)
			assert res.cookies().len() == 1
			let location = try res.location()
			assert !(location is none)
			assert orEmpty(location is none ?? (none, location.str())) == "http://h/next"
			assert res.str() == "HTTP/1.1 200 OK"
			assert (try res.text()) == "{\"name\":\"pen\",\"count\":3}"
			let item = Payload{}
			try res.json(item)
			assert item.name == "pen" && item.count == 3
			let closes = new Counter()
			res.onClose(def () {closes.bump()})
			try res.close()
			try res.close()
			assert closes.n == 1
			let plain = try readResponse(wireOf("HTTP/1.1 503 Busy\r\nContent-Length: 0\r\n\r\n"), req)
			assert !plain.ok()
			assert plain.statusClass() == StatusClass.ServerError
			assert plain.location() is error == false
			assert (try plain.location()) is none
			assert plain.str() == "HTTP/1.1 503 Busy"
			return none
		}

		@test()
		def responseWritesWireForm() !none {
			let res = new Response()
			res.status = 201
			res.headers.set("X-A", "1")
			res.body = new bytes.Reader("hi".bytes())
			res.contentLength = 2
			let out = new bytes.Buffer()
			try res.write(out)
			assert string(out.bytes()) == "HTTP/1.1 201 Created\r\nContent-Length: 2\r\nX-A: 1\r\n\r\nhi"
			let streamed = new Response()
			streamed.body = new bytes.Reader("abc".bytes())
			let out2 = new bytes.Buffer()
			try streamed.write(out2)
			assert string(out2.bytes()) == "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n0\r\n\r\n"
			return none
		}

		@test()
		def responseCopiesAndSaves() !none {
			let req = try newRequest(Method.GET, "http://h/")
			let res = try readResponse(wireOf("HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhello"), req)
			let out = new bytes.Buffer()
			assert (try res.copyTo(out)) == 5
			assert string(out.bytes()) == "hello"
			let again = try readResponse(wireOf("HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhello"), req)
			let path = "/tmp/adm-http-response-save.txt"
			try again.save(path)
			assert string(try os.readFile(path)) == "hello"
			try os.remove(path)
			return none
		}

		@test()
		def writerSendsText() !none {
			let (w, sink) = try writerFor("GET / HTTP/1.1\r\nHost: h\r\n\r\n")
			assert !w.written()
			try w.text("hello")
			assert w.written()
			assert w.size() == 5
			let out = outputOf(sink)
			assert out.startsWith("HTTP/1.1 200 OK\r\n")
			assert headBlock(out).contains("Content-Length: 5\r\n")
			assert headBlock(out).contains("Content-Type: text/plain; charset=utf-8\r\n")
			assert headBlock(out).contains("Date: ")
			assert bodyOf(out) == "hello"
			// A second body write after the end is refused.
			assert w.write("x".bytes()) is error
			return none
		}

		@test()
		def writerSendsJsonAndBlobs() !none {
			let (w, sink) = try writerFor("GET / HTTP/1.1\r\nHost: h\r\n\r\n")
			try w.json(201, Payload{name: "x", count: 1})
			let out = outputOf(sink)
			assert out.startsWith("HTTP/1.1 201 Created\r\n")
			assert headBlock(out).contains("Content-Type: application/json\r\n")
			assert bodyOf(out) == "{\"name\":\"x\",\"count\":1}"
			let (w2, sink2) = try writerFor("GET / HTTP/1.1\r\nHost: h\r\n\r\n")
			try w2.json(Payload{name: "x", count: 1}, true)
			assert bodyOf(outputOf(sink2)).contains("\n")
			let (w3, sink3) = try writerFor("GET / HTTP/1.1\r\nHost: h\r\n\r\n")
			try w3.blob(200, "png", [0x89, 0x50])
			assert headBlock(outputOf(sink3)).contains("Content-Type: image/png\r\n")
			assert headBlock(outputOf(sink3)).contains("Content-Length: 2\r\n")
			// Without a type, the body is sniffed.
			let (w4, sink4) = try writerFor("GET / HTTP/1.1\r\nHost: h\r\n\r\n")
			try w4.write("<!DOCTYPE html><html></html>".bytes())
			try w4.end()
			assert headBlock(outputOf(sink4)).contains("Content-Type: text/html; charset=utf-8\r\n")
			return none
		}

		@test()
		def writerCountsButDoesNotSendForHead() !none {
			let (w, sink) = try writerFor("HEAD / HTTP/1.1\r\nHost: h\r\n\r\n")
			try w.text("hello")
			let out = outputOf(sink)
			assert headBlock(out).contains("Content-Length: 5\r\n")
			assert bodyOf(out) == ""
			assert w.size() == 5
			// A body past the buffer announces chunking and still sends
			// nothing, not even the last chunk.
			let (w2, sink2) = try writerFor("HEAD / HTTP/1.1\r\nHost: h\r\n\r\n")
			w2.bufferSize = 4
			try w2.write("hello world".bytes())
			try w2.end()
			let out2 = outputOf(sink2)
			assert headBlock(out2).contains("Transfer-Encoding: chunked\r\n")
			assert bodyOf(out2) == ""
			return none
		}

		@test()
		def writerStreamsChunkedPastTheBuffer() !none {
			let (w, sink) = try writerFor("GET / HTTP/1.1\r\nHost: h\r\n\r\n")
			w.bufferSize = 4
			w.headers.set("Trailer", "X-Sum")
			try w.write("hello".bytes())
			try w.write(" world".bytes())
			w.trailer.set("X-Sum", "11")
			try w.end()
			let out = outputOf(sink)
			assert headBlock(out).contains("Transfer-Encoding: chunked\r\n")
			assert !headBlock(out).contains("Content-Length")
			assert bodyOf(out) == "5\r\nhello\r\n6\r\n world\r\n0\r\nX-Sum: 11\r\n\r\n"
			assert w.size() == 11
			let (w2, sink2) = try writerFor("GET / HTTP/1.1\r\nHost: h\r\n\r\n")
			try w2.stream(200, "text/plain", new bytes.Reader("abc".bytes()))
			assert bodyOf(outputOf(sink2)) == "3\r\nabc\r\n0\r\n\r\n"
			let (w3, sink3) = try writerFor("GET / HTTP/1.0\r\nHost: h\r\n\r\n")
			w3.bufferSize = 1
			try w3.write("old".bytes())
			try w3.end()
			assert headBlock(outputOf(sink3)).contains("Connection: close\r\n")
			assert bodyOf(outputOf(sink3)) == "old"
			return none
		}

		@test()
		def writerSendsEvents() !none {
			let (w, sink) = try writerFor("GET /events HTTP/1.1\r\nHost: h\r\n\r\n")
			try w.event("hi")
			try w.event("line1\nline2", "tick", "7")
			let out = outputOf(sink)
			assert headBlock(out).contains("Content-Type: text/event-stream\r\n")
			assert bodyOf(out).contains("data: hi\n\n")
			assert bodyOf(out).contains("event: tick\nid: 7\ndata: line1\ndata: line2\n\n")
			return none
		}

		@test()
		def writerRedirects() !none {
			let (w, sink) = try writerFor("GET /base/page HTTP/1.1\r\nHost: h\r\n\r\n")
			try w.redirect("next")
			let out = outputOf(sink)
			assert out.startsWith("HTTP/1.1 302 Found\r\n")
			assert headBlock(out).contains("Location: /base/next\r\n")
			assert bodyOf(out).contains("<a href=\"/base/next\">Found</a>")
			let (w2, sink2) = try writerFor("POST /form HTTP/1.1\r\nHost: h\r\nContent-Length: 0\r\n\r\n")
			try w2.redirect("https://other.example/x", 303)
			let out2 = outputOf(sink2)
			assert out2.startsWith("HTTP/1.1 303 See Other\r\n")
			assert headBlock(out2).contains("Location: https://other.example/x\r\n")
			assert bodyOf(out2) == ""
			let (w3, sink3) = try writerFor("GET /a HTTP/1.1\r\nHost: h\r\nReferer: http://h/prev\r\n\r\n")
			try w3.redirectBack()
			assert headBlock(outputOf(sink3)).contains("Location: http://h/prev\r\n")
			let (w4, sink4) = try writerFor("GET /a HTTP/1.1\r\nHost: h\r\n\r\n")
			try w4.redirectBack("/home")
			assert headBlock(outputOf(sink4)).contains("Location: /home\r\n")
			return none
		}

		@test()
		def writerSendsErrors() !none {
			let (w, sink) = try writerFor("GET /x HTTP/1.1\r\nHost: h\r\n\r\n")
			try w.notFound()
			let out = outputOf(sink)
			assert out.startsWith("HTTP/1.1 404 Not Found\r\n")
			assert headBlock(out).contains("X-Content-Type-Options: nosniff\r\n")
			assert bodyOf(out) == "Not Found\n"
			let (w2, sink2) = try writerFor("GET /x HTTP/1.1\r\nHost: h\r\n\r\n")
			try w2.error(422, "bad field")
			assert outputOf(sink2).startsWith("HTTP/1.1 422 Unprocessable Entity\r\n")
			assert bodyOf(outputOf(sink2)) == "bad field\n"
			let (w3, sink3) = try writerFor("GET /x HTTP/1.1\r\nHost: h\r\n\r\n")
			try w3.noContent()
			assert outputOf(sink3).startsWith("HTTP/1.1 204 No Content\r\n")
			assert !headBlock(outputOf(sink3)).contains("Content-Length")
			assert bodyOf(outputOf(sink3)) == ""
			return none
		}

		@test()
		def writerAnswersConditionals() !none {
			let (w, sink) = try writerFor("GET /r HTTP/1.1\r\nHost: h\r\nIf-None-Match: \"v1\"\r\n\r\n")
			assert try w.conditional("\"v1\"")
			assert outputOf(sink).startsWith("HTTP/1.1 304 Not Modified\r\n")
			assert headBlock(outputOf(sink)).contains("Etag: \"v1\"\r\n")
			let (w2, sink2) = try writerFor("GET /r HTTP/1.1\r\nHost: h\r\nIf-None-Match: \"v1\"\r\n\r\n")
			assert !(try w2.conditional("v2"))
			assert !w2.written()
			assert w2.headers.get("ETag") == "\"v2\""
			try w2.text("fresh")
			assert outputOf(sink2).startsWith("HTTP/1.1 200 OK\r\n")
			w2.etag("w1", true)
			assert w2.headers.get("ETag") == "W/\"w1\""
			return none
		}

		@test()
		def writerNegotiatesAndVaries() !none {
			let (w, sink) = try writerFor("GET /r HTTP/1.1\r\nHost: h\r\nAccept: text/html;q=0.8, application/json\r\n\r\n")
			assert orEmpty(w.negotiate("text/html", "application/json")) == "application/json"
			w.vary("Accept")
			w.vary("Origin")
			assert w.headers.values("Vary").len() == 2
			try w.json(Payload{name: "n", count: 0})
			assert headBlock(outputOf(sink)).contains("Vary: Accept\r\n")
			return none
		}

		@test()
		def writerSetsAndDeletesCookies() !none {
			let (w, sink) = try writerFor("GET / HTTP/1.1\r\nHost: h\r\n\r\n")
			let c = new Cookie("session", "abc")
			c.path = "/"
			c.httpOnly = true
			try w.cookie(c)
			w.deleteCookie("old")
			assert w.cookie(new Cookie("bad name", "x")) is error
			try w.noContent()
			let head = headBlock(outputOf(sink))
			assert head.contains("Set-Cookie: session=abc; Path=/; HttpOnly\r\n")
			assert head.contains("Set-Cookie: old=; Path=/; Max-Age=0\r\n")
			return none
		}

		@test()
		def writerServesFiles() !none {
			let path = "/tmp/adm-http-file-test.txt"
			try os.writeFile(path, "hello world".bytes())
			let (w, sink) = try writerFor("GET /f HTTP/1.1\r\nHost: h\r\n\r\n")
			try w.file(path)
			let out = outputOf(sink)
			assert out.startsWith("HTTP/1.1 200 OK\r\n")
			assert headBlock(out).contains("Content-Length: 11\r\n")
			assert headBlock(out).contains("Content-Type: text/plain; charset=utf-8\r\n")
			assert headBlock(out).contains("Accept-Ranges: bytes\r\n")
			assert headBlock(out).contains("Last-Modified: ")
			assert bodyOf(out) == "hello world"

			let (w2, sink2) = try writerFor("GET /f HTTP/1.1\r\nHost: h\r\nRange: bytes=6-10\r\n\r\n")
			try w2.file(path)
			let out2 = outputOf(sink2)
			assert out2.startsWith("HTTP/1.1 206 Partial Content\r\n")
			assert headBlock(out2).contains("Content-Range: bytes 6-10/11\r\n")
			assert bodyOf(out2) == "world"

			let (w3, sink3) = try writerFor("GET /f HTTP/1.1\r\nHost: h\r\nRange: bytes=50-\r\n\r\n")
			try w3.file(path)
			assert outputOf(sink3).startsWith("HTTP/1.1 416 Requested Range Not Satisfiable\r\n")
			assert headBlock(outputOf(sink3)).contains("Content-Range: bytes */11\r\n")

			let later = time.formatHTTPDate(time.now() + 1h)
			let (w4, sink4) = try writerFor("GET /f HTTP/1.1\r\nHost: h\r\nIf-Modified-Since: " + later + "\r\n\r\n")
			try w4.file(path)
			assert outputOf(sink4).startsWith("HTTP/1.1 304 Not Modified\r\n")

			let (w5, sink5) = try writerFor("HEAD /f HTTP/1.1\r\nHost: h\r\n\r\n")
			try w5.file(path)
			assert headBlock(outputOf(sink5)).contains("Content-Length: 11\r\n")
			assert bodyOf(outputOf(sink5)) == ""

			let (w6, sink6) = try writerFor("GET /f HTTP/1.1\r\nHost: h\r\n\r\n")
			try w6.attachment(path, "report.txt")
			assert headBlock(outputOf(sink6)).contains("Content-Disposition: attachment; filename=\"report.txt\"\r\n")
			let (w7, sink7) = try writerFor("GET /f HTTP/1.1\r\nHost: h\r\n\r\n")
			try w7.inline(path)
			assert headBlock(outputOf(sink7)).contains("Content-Disposition: inline; filename=\"adm-http-file-test.txt\"\r\n")

			let (w8, sink8) = try writerFor("GET /missing HTTP/1.1\r\nHost: h\r\n\r\n")
			try w8.file("/tmp/adm-http-no-such-file.txt")
			assert outputOf(sink8).startsWith("HTTP/1.1 404 Not Found\r\n")
			let (w9, sink9) = try writerFor("GET /d HTTP/1.1\r\nHost: h\r\n\r\n")
			try w9.download("data.bin", "application/octet-stream", [1, 2, 3])
			assert headBlock(outputOf(sink9)).contains("Content-Disposition: attachment; filename=\"data.bin\"\r\n")
			assert headBlock(outputOf(sink9)).contains("Content-Length: 3\r\n")
			try os.remove(path)
			return none
		}

		@test()
		def writerHooksAndHijack() !none {
			let (w, sink) = try writerFor("GET / HTTP/1.1\r\nHost: h\r\n\r\n")
			let hits = new Counter()
			w.onFinish(def () {hits.bump()})
			assert w.hijack() is error
			try w.text("x")
			assert hits.n == 1
			w.onFinish(def () {hits.bump()})
			assert hits.n == 2
			assert outputOf(sink).endsWith("x")
			let req = try readRequest(new bytes.Reader("GET / HTTP/1.1\r\nHost: h\r\n\r\n".bytes()))
			let detached = new ResponseWriter(req)
			assert detached.text("x") is error
			return none
		}
	}
}
