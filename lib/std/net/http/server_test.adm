partial module std.net.http {
	use (
		std.net.tls
		std.testing
	)

	check "HTTP server TLS config" {
		@test()
		def addsKeyPairsToTheConfig() !none {
			let pair = new tls.KeyPair([byte[1, 2, 3]])
			let fresh = withKeyPair(none, pair)
			assert fresh.certificates.len() == 1
			assert fresh.alpn.len() == 0
			let given = tls.Config{alpn: ["http/1.1"], certificates: [pair]}
			let extended = withKeyPair(given, pair)
			assert extended.certificates.len() == 2
			assert extended.alpn.len() == 1 && extended.alpn[0] == "http/1.1"
			let missing = "ok"
			withWatchedKeyPair(none, "/nonexistent/server.crt", "/nonexistent/server.key") onerror (err error) {
				missing = "failed"
				recover fresh
			}
			assert missing == "failed"
			let srv = new Server("127.0.0.1:0")
			assert srv.tls is none
			let reason = "ok"
			srv.listenAndServeTLS("/nonexistent/server.crt", "/nonexistent/server.key") onerror (err error) {
				reason = "failed"
				recover none
			}
			assert reason == "failed"
			assert srv.tls is none
			return none
		}
	}
}
