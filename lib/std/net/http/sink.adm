partial module std.net.http {
	use (
		std.bytes
		std.io
	)

	// ResponseSink is where a ResponseWriter's committed response goes: the
	// HTTP/1.1 wire, or one HTTP/2 stream. It owns the framing; the writer
	// owns buffering, `Date`, content sniffing and HEAD handling.
	interface ResponseSink {
		// Sends an interim response (100, 103) ahead of the final one. Fails
		// when the connection write does.
		def writeInterim(status int, headers Header) !none

		// Sends the status and headers. `length` is the body size when the
		// whole body is known at commit, -1 when it is streamed; `hasBody`
		// is false for HEAD and for a status that carries none. Fails when
		// the connection write does.
		def writeHead(status int, headers Header, length int, hasBody bool) !none

		// Sends body bytes past the head. Fails when the connection write
		// does.
		def writeBody(buf byte[]) !none

		// Ends the message, with the trailer fields when there are any.
		// Fails when the connection write does.
		def end(trailer ?Header) !none
	}

	// WireSink frames a response as HTTP/1.x: a body of known length gets
	// a `Content-Length`, a streamed one goes chunked to an HTTP/1.1 client
	// and ends with the connection for an older one.
	internal type WireSink {
		out       io.Writer
		// The version the status line answers with, `HTTP/1.1`.
		proto     string
		// Whether the client takes `Transfer-Encoding: chunked`.
		chunkable bool
		chunked   bool      = false

		def new(out io.Writer, request Request) {
			self.out = out
			self.proto = request.proto
			self.chunkable = request.protoAtLeast(1, 1)
		}

		def writeInterim(status int, headers Header) !none {
			let head = new bytes.Buffer()
			try head.writeString("HTTP/1.1 " + status.str() + " " + statusText(status) + "\r\n")
			try headers.write(head)
			try head.writeString("\r\n")
			return try writeFully(out, head.bytes())
		}

		def writeHead(status int, headers Header, length int, hasBody bool) !none {
			if statusHasBody(status) && !headers.has("Content-Length") {
				if length >= 0 {
					headers.set("Content-Length", length.str())
				} else if chunkable {
					headers.set("Transfer-Encoding", "chunked")
					chunked = hasBody
				} else {
					headers.set("Connection", "close")
				}
			}
			let head = new bytes.Buffer()
			try head.writeString(proto + " " + status.str() + " " + statusText(status) + "\r\n")
			try headers.write(head)
			try head.writeString("\r\n")
			return try writeFully(out, head.bytes())
		}

		def writeBody(buf byte[]) !none {
			return none when buf.len() == 0
			if chunked {
				let writer = new ChunkedWriter(out)
				try writer.write(buf)
				return none
			}
			return try writeFully(out, buf)
		}

		def end(trailer ?Header) !none {
			return none unless chunked
			let closer = new ChunkedWriter(out)
			return try closer.close(trailer)
		}
	}
}
