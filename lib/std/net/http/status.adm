partial module std.net.http {
	// Method is a request method. The standard ones are enumerated; an
	// extension method arrives as `Other` with its text in the request.
	//
	// Example:
	// ```example
	// let m = http.parseMethod("post")
	// println(m == http.Method.POST)         // true (methods are case-sensitive on the wire; parse is lenient)
	// println(http.methodIsSafe(http.Method.GET))    // true
	// println(http.methodIsIdempotent(http.Method.PUT))  // true
	// ```
	enum Method {
		GET = "GET",
		HEAD = "HEAD",
		POST = "POST",
		PUT = "PUT",
		PATCH = "PATCH",
		DELETE = "DELETE",
		CONNECT = "CONNECT",
		OPTIONS = "OPTIONS",
		TRACE = "TRACE",
		Other = "",
	}

	// parseMethod maps method text to the enum: exact upper-case matches
	// and, since clients differ, a lower-case spelling too. Anything else
	// is `Other`.
	def parseMethod(text string) Method {
		let upper = text.trim().upper()
		return Method.GET when upper == "GET"
		return Method.HEAD when upper == "HEAD"
		return Method.POST when upper == "POST"
		return Method.PUT when upper == "PUT"
		return Method.PATCH when upper == "PATCH"
		return Method.DELETE when upper == "DELETE"
		return Method.CONNECT when upper == "CONNECT"
		return Method.OPTIONS when upper == "OPTIONS"
		return Method.TRACE when upper == "TRACE"
		return Method.Other
	}

	// methodIsSafe reports the read-only methods (RFC 9110 §9.2.1): GET,
	// HEAD, OPTIONS, TRACE.
	def methodIsSafe(m Method) bool {
		return m := Method.GET || Method.HEAD || Method.OPTIONS || Method.TRACE
	}

	// methodIsIdempotent reports the methods a client may retry (§9.2.2):
	// the safe ones plus PUT and DELETE.
	def methodIsIdempotent(m Method) bool {
		return methodIsSafe(m) || (m := Method.PUT || Method.DELETE)
	}

	// methodAllowsBody reports whether a request with this method carries a
	// body in practice: POST, PUT, PATCH, DELETE (and Other); GET, HEAD,
	// OPTIONS, TRACE, CONNECT do not.
	def methodAllowsBody(m Method) bool {
		return m := Method.POST || Method.PUT || Method.PATCH || Method.DELETE || Method.Other
	}

	// Status is a response status code, with every code of the IANA
	// registry that `net/http` knows. A code outside the list still works:
	// `statusText(code)` returns "" for it and `statusClass` still answers.
	//
	// Example:
	// ```example
	// println(int(http.Status.NotFound))          // 404
	// println(http.statusText(404))               // Not Found
	// println(http.statusClass(http.Status.SeeOther))  // StatusClass.Redirection
	// println(http.statusLine(200))               // 200 OK
	// ```
	enum Status {
		Continue = 100,
		SwitchingProtocols = 101,
		Processing = 102,
		EarlyHints = 103,

		OK = 200,
		Created = 201,
		Accepted = 202,
		NonAuthoritativeInfo = 203,
		NoContent = 204,
		ResetContent = 205,
		PartialContent = 206,
		MultiStatus = 207,
		AlreadyReported = 208,
		IMUsed = 226,

		MultipleChoices = 300,
		MovedPermanently = 301,
		Found = 302,
		SeeOther = 303,
		NotModified = 304,
		UseProxy = 305,
		TemporaryRedirect = 307,
		PermanentRedirect = 308,

		BadRequest = 400,
		Unauthorized = 401,
		PaymentRequired = 402,
		Forbidden = 403,
		NotFound = 404,
		MethodNotAllowed = 405,
		NotAcceptable = 406,
		ProxyAuthRequired = 407,
		RequestTimeout = 408,
		Conflict = 409,
		Gone = 410,
		LengthRequired = 411,
		PreconditionFailed = 412,
		RequestEntityTooLarge = 413,
		RequestURITooLong = 414,
		UnsupportedMediaType = 415,
		RequestedRangeNotSatisfiable = 416,
		ExpectationFailed = 417,
		Teapot = 418,
		MisdirectedRequest = 421,
		UnprocessableEntity = 422,
		Locked = 423,
		FailedDependency = 424,
		TooEarly = 425,
		UpgradeRequired = 426,
		PreconditionRequired = 428,
		TooManyRequests = 429,
		RequestHeaderFieldsTooLarge = 431,
		UnavailableForLegalReasons = 451,

		InternalServerError = 500,
		NotImplemented = 501,
		BadGateway = 502,
		ServiceUnavailable = 503,
		GatewayTimeout = 504,
		HTTPVersionNotSupported = 505,
		VariantAlsoNegotiates = 506,
		InsufficientStorage = 507,
		LoopDetected = 508,
		NotExtended = 510,
		NetworkAuthenticationRequired = 511,
	}

	// StatusClass is the first digit of a status code.
	enum StatusClass {
		Informational,
		Success,
		Redirection,
		ClientError,
		ServerError,
		Unknown,
	}

	// statusText is the reason phrase of a status code (`404` gives
	// "Not Found"), "" for a code the registry does not know. The phrase is
	// advisory on the wire; clients must not depend on it.
	def statusText(code int) string {
		let phrase = statusPhrases.get(code)
		return "" when phrase is none
		return phrase
	}

	// statusLine renders `code phrase` as it goes on a status line, the
	// phrase left empty for an unknown code.
	def statusLine(code int) string {
		let phrase = statusText(code)
		return "{code}" when phrase == ""
		return "{code} {phrase}"
	}

	// statusClass classifies a code by its first digit; `Unknown` outside
	// 100..599.
	def statusClass(code int) StatusClass {
		return StatusClass.Informational when code >= 100 && code <= 199
		return StatusClass.Success when code >= 200 && code <= 299
		return StatusClass.Redirection when code >= 300 && code <= 399
		return StatusClass.ClientError when code >= 400 && code <= 499
		return StatusClass.ServerError when code >= 500 && code <= 599
		return StatusClass.Unknown
	}

	// statusIsRedirect reports the codes a client follows: 301, 302, 303,
	// 307, 308.
	def statusIsRedirect(code int) bool {
		return code := 301 || 302 || 303 || 307 || 308
	}

	// statusHasBody reports whether a response with this code carries a
	// body (RFC 9112 §6.3): not for 1xx, 204 and 304.
	def statusHasBody(code int) bool {
		return false when code >= 100 && code <= 199
		return !(code := 204 || 304)
	}

	internal let statusPhrases = map<int, string>{
		100: "Continue", 101: "Switching Protocols", 102: "Processing", 103: "Early Hints",
		200: "OK", 201: "Created", 202: "Accepted", 203: "Non-Authoritative Information",
		204: "No Content", 205: "Reset Content", 206: "Partial Content", 207: "Multi-Status",
		208: "Already Reported", 226: "IM Used",
		300: "Multiple Choices", 301: "Moved Permanently", 302: "Found", 303: "See Other",
		304: "Not Modified", 305: "Use Proxy", 307: "Temporary Redirect", 308: "Permanent Redirect",
		400: "Bad Request", 401: "Unauthorized", 402: "Payment Required", 403: "Forbidden",
		404: "Not Found", 405: "Method Not Allowed", 406: "Not Acceptable",
		407: "Proxy Authentication Required", 408: "Request Timeout", 409: "Conflict", 410: "Gone",
		411: "Length Required", 412: "Precondition Failed", 413: "Request Entity Too Large",
		414: "Request URI Too Long", 415: "Unsupported Media Type",
		416: "Requested Range Not Satisfiable", 417: "Expectation Failed", 418: "I'm a teapot",
		421: "Misdirected Request", 422: "Unprocessable Entity", 423: "Locked",
		424: "Failed Dependency", 425: "Too Early", 426: "Upgrade Required",
		428: "Precondition Required", 429: "Too Many Requests",
		431: "Request Header Fields Too Large", 451: "Unavailable For Legal Reasons",
		500: "Internal Server Error", 501: "Not Implemented", 502: "Bad Gateway",
		503: "Service Unavailable", 504: "Gateway Timeout", 505: "HTTP Version Not Supported",
		506: "Variant Also Negotiates", 507: "Insufficient Storage", 508: "Loop Detected",
		510: "Not Extended", 511: "Network Authentication Required",
	}
}
