partial module std.net.http {
	use std.testing

	check "Method" {
		@test()
		def parsesAndClassifies() !none {
			assert parseMethod("GET") == Method.GET
			assert parseMethod("post") == Method.POST
			assert parseMethod(" Delete ") == Method.DELETE
			assert parseMethod("PROPFIND") == Method.Other
			assert Method.GET.value == "GET"
			assert methodIsSafe(Method.GET)
			assert methodIsSafe(Method.HEAD)
			assert methodIsSafe(Method.OPTIONS)
			assert !methodIsSafe(Method.POST)
			assert methodIsIdempotent(Method.PUT)
			assert methodIsIdempotent(Method.DELETE)
			assert methodIsIdempotent(Method.GET)
			assert !methodIsIdempotent(Method.POST)
			assert !methodIsIdempotent(Method.PATCH)
			assert methodAllowsBody(Method.POST)
			assert methodAllowsBody(Method.PATCH)
			assert methodAllowsBody(Method.Other)
			assert !methodAllowsBody(Method.GET)
			assert !methodAllowsBody(Method.HEAD)
			return none
		}
	}

	check "Status" {
		@test()
		def textLineAndClass() !none {
			assert int(Status.NotFound) == 404
			assert statusText(404) == "Not Found"
			assert statusText(200) == "OK"
			assert statusText(418) == "I'm a teapot"
			assert statusText(511) == "Network Authentication Required"
			assert statusText(299) == ""
			assert statusLine(200) == "200 OK"
			assert statusLine(299) == "299"
			assert statusClass(100) == StatusClass.Informational
			assert statusClass(int(Status.Created)) == StatusClass.Success
			assert statusClass(int(Status.SeeOther)) == StatusClass.Redirection
			assert statusClass(404) == StatusClass.ClientError
			assert statusClass(503) == StatusClass.ServerError
			assert statusClass(600) == StatusClass.Unknown
			assert statusClass(42) == StatusClass.Unknown
			return none
		}

		@test()
		def redirectsAndBodies() !none {
			assert statusIsRedirect(301)
			assert statusIsRedirect(308)
			assert !statusIsRedirect(300)
			assert !statusIsRedirect(304)
			assert statusHasBody(200)
			assert statusHasBody(404)
			assert !statusHasBody(204)
			assert !statusHasBody(304)
			assert !statusHasBody(100)
			assert !statusHasBody(int(Status.SwitchingProtocols))
			return none
		}
	}
}
