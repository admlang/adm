partial module std.net.http {
	use (
		std.bytes
		std.io
		std.testing
	)

	internal def wireOf(text string) WireReader {
		return new WireReader(new bytes.Reader(text.bytes()))
	}

	internal def textOf(body ?io.Reader) !string {
		return "" when body is none
		return string(try readAll(body))
	}

	// lineOf reads a line, "<eof>" at the end of the stream.
	internal def lineOf(wire WireReader) !string {
		let line = try wire.readLine()
		return "<eof>" when line is none
		return line
	}

	internal def opOf(err error) string {
		return err.op when err is HttpError
		return ""
	}

	check "HTTP wire codec" {
		@test()
		def wireReaderSplitsLinesAndHandsOverTheRest() !none {
			let wire = wireOf("a\r\nb\n\r\nrest")
			assert (try lineOf(wire)) == "a"
			assert (try lineOf(wire)) == "b"
			assert (try lineOf(wire)) == ""
			assert string(try readAll(wire)) == "rest"
			assert (try lineOf(wire)) == "<eof>"
			assert wire.atEnd()
			return none
		}

		@test()
		def wireReaderCapsLineLength() {
			let wire = wireOf("0123456789\r\n")
			assert wire.readLine(4) is error
		}

		@test()
		def chunkedReaderDecodesChunksExtensionsAndTrailers() !none {
			let reader = new ChunkedReader(new bytes.Reader("4\r\nWiki\r\n5;ext=1\r\npedia\r\n0\r\nX-Sum: 1\r\n\r\n".bytes()))
			assert string(try readAll(reader)) == "Wikipedia"
			assert reader.trailer().get("X-Sum") == "1"
			let buf byte[] = []
			buf.len(4)
			assert (try reader.read(buf)) == 0
			return none
		}

		@test()
		def chunkedReaderRefusesBadFraming() {
			assert readAll(new ChunkedReader(new bytes.Reader("zz\r\nab\r\n0\r\n\r\n".bytes()))) is error
			assert readAll(new ChunkedReader(new bytes.Reader("2\r\nabX\r\n0\r\n\r\n".bytes()))) is error
			assert readAll(new ChunkedReader(new bytes.Reader("5\r\nab".bytes()))) is error
		}

		@test()
		def chunkedWriterRoundTrips() !none {
			let sink = new bytes.Buffer()
			let writer = new ChunkedWriter(sink)
			assert (try writer.write("hello".bytes())) == 5
			assert (try writer.write([])) == 0
			let trailer = new Header()
			trailer.set("X-A", "b")
			try writer.close(trailer)
			assert string(sink.bytes()) == "5\r\nhello\r\n0\r\nX-A: b\r\n\r\n"
			let reader = new ChunkedReader(new bytes.Reader(sink.bytes()))
			assert string(try readAll(reader)) == "hello"
			assert reader.trailer().get("x-a") == "b"
			return none
		}

		@test()
		def maxBytesReaderCapsTheBody() !none {
			let ok = new MaxBytesReader(new bytes.Reader("hello".bytes()), 5)
			assert string(try readAll(ok)) == "hello"
			assert ok.remaining() == 0
			let over = new MaxBytesReader(new bytes.Reader("hello!".bytes()), 5)
			let err = readAll(over) onerror (e error) {
				assert e is HttpError
				assert e.code == "too-large"
				recover []
			}
			assert err.len() == 0
			return none
		}

		@test()
		def lengthReaderStopsAtItsLength() !none {
			let source = new bytes.Reader("abcdef".bytes())
			let reader = new LengthReader(source, 3)
			assert string(try readAll(reader)) == "abc"
			assert reader.left() == 0
			assert string(try readAll(source)) == "def"
			assert readAll(new LengthReader(new bytes.Reader("ab".bytes()), 3)) is error
			return none
		}

		@test()
		def readRequestParsesALineHeadersAndNoBody() !none {
			let req = try readRequest(wireOf("GET /index.html?x=1 HTTP/1.1\r\nHost: example.com\r\nAccept: */*\r\n\r\n"))
			assert req.method == Method.GET
			assert req.url.path == "/index.html"
			assert req.url.rawQuery == "x=1"
			assert req.host == "example.com"
			assert !req.headers.has("Host")
			assert req.headers.get("Accept") == "*/*"
			assert req.contentLength == 0
			assert req.body is none
			assert !req.connectionClose
			assert req.proto == "HTTP/1.1"
			return none
		}

		@test()
		def readRequestFramesByContentLength() !none {
			let req = try readRequest(wireOf("POST /a HTTP/1.1\r\nHost: h\r\nContent-Length: 5\r\n\r\nhello"))
			assert req.method == Method.POST
			assert req.contentLength == 5
			assert (try textOf(req.body)) == "hello"
			return none
		}

		@test()
		def readRequestFramesChunkedAndKeepsThePipeline() !none {
			let wire = wireOf("POST /a HTTP/1.1\r\nHost: h\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n0\r\n\r\nGET /b HTTP/1.1\r\nHost: h\r\n\r\n")
			let first = try readRequest(wire)
			assert first.contentLength == -1
			assert first.transferEncoding.len() == 1 && first.transferEncoding[0] == "chunked"
			assert (try textOf(first.body)) == "abc"
			let second = try readRequest(wire)
			assert second.url.path == "/b"
			assert second.body is none
			return none
		}

		@test()
		def readRequestDefendsAgainstSmuggling() !none {
			let both = try readRequest(wireOf("POST /a HTTP/1.1\r\nHost: h\r\nContent-Length: 3\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n0\r\n\r\n"))
			assert both.contentLength == -1
			assert !both.headers.has("Content-Length")
			assert (try textOf(both.body)) == "abc"
			assert readRequest(wireOf("POST /a HTTP/1.1\r\nContent-Length: 5\r\nContent-Length: 6\r\n\r\nhello!")) is error
			assert readRequest(wireOf("POST /a HTTP/1.1\r\nContent-Length: abc\r\n\r\n")) is error
			assert readRequest(wireOf("POST /a HTTP/1.1\r\nTransfer-Encoding: gzip, chunked\r\n\r\n")) is error
			let same = try readRequest(wireOf("POST /a HTTP/1.1\r\nContent-Length: 2\r\nContent-Length: 2\r\n\r\nok"))
			assert same.contentLength == 2
			return none
		}

		@test()
		def readRequestRefusesMalformedLines() {
			let bad = readRequest(wireOf("GET\r\n\r\n")) onerror (e error) {
				assert opOf(e) == "request"
				recover new Request()
			}
			assert bad.url.path == ""
			let ended = readRequest(wireOf("")) onerror (e error) {
				assert e.code == "eof"
				recover new Request()
			}
			assert ended.url.path == ""
			assert readRequest(wireOf("GET / HTTP/3\r\n\r\n")) is error
			assert readRequest(wireOf("GET /a b HTTP/1.1\r\n\r\n")) is error
			assert readRequest(wireOf("GET / HTTP/1.1\r\nBad Header\r\n\r\n")) is error
		}

		@test()
		def readRequestAppliesKeepAliveRules() !none {
			assert (try readRequest(wireOf("GET / HTTP/1.0\r\n\r\n"))).connectionClose
			assert !(try readRequest(wireOf("GET / HTTP/1.0\r\nConnection: keep-alive\r\n\r\n"))).connectionClose
			assert (try readRequest(wireOf("GET / HTTP/1.1\r\nConnection: close\r\n\r\n"))).connectionClose
			return none
		}

		@test()
		def readRequestAcceptsAbsoluteAndAsteriskTargets() !none {
			let abs = try readRequest(wireOf("GET http://example.org/p?q=1 HTTP/1.1\r\n\r\n"))
			assert abs.host == "example.org"
			assert abs.url.host == "example.org"
			assert abs.url.path == "/p"
			let star = try readRequest(wireOf("OPTIONS * HTTP/1.1\r\nHost: h\r\n\r\n"))
			assert star.method == Method.OPTIONS
			assert star.url.path == "*"
			let other = try readRequest(wireOf("PROPFIND /d HTTP/1.1\r\nHost: h\r\n\r\n"))
			assert other.method == Method.Other
			assert other.rawMethod == "PROPFIND"
			return none
		}

		@test()
		def readResponseParsesStatusHeadersAndBody() !none {
			let req = try newRequest(Method.GET, "http://h/")
			let res = try readResponse(wireOf("HTTP/1.1 200 OK\r\nContent-Length: 2\r\nContent-Type: text/plain\r\n\r\nok"), req)
			assert res.status == 200
			assert res.reason == "OK"
			assert res.contentLength == 2
			assert (try textOf(res.body)) == "ok"
			assert !res.connectionClose
			let bare = try readResponse(wireOf("HTTP/1.1 404\r\n\r\n"), req)
			assert bare.status == 404
			assert bare.reason == ""
			return none
		}

		@test()
		def readResponseKnowsBodilessResponses() !none {
			let head = try newRequest(Method.HEAD, "http://h/")
			let res = try readResponse(wireOf("HTTP/1.1 200 OK\r\nContent-Length: 10\r\n\r\n"), head)
			assert res.body is none
			let get = try newRequest(Method.GET, "http://h/")
			let interim = try readResponse(wireOf("HTTP/1.1 100 Continue\r\n\r\nHTTP/1.1 204 No Content\r\nX-A: b\r\n\r\n"), get)
			assert interim.status == 204
			assert interim.headers.get("X-A") == "b"
			assert interim.body is none
			let upgrade = try readResponse(wireOf("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\n\r\n"), get)
			assert upgrade.status == 101
			return none
		}

		@test()
		def readResponseReadsToCloseWithoutFraming() !none {
			let get = try newRequest(Method.GET, "http://h/")
			let res = try readResponse(wireOf("HTTP/1.1 200 OK\r\n\r\nhello"), get)
			assert res.contentLength == -1
			assert res.connectionClose
			assert (try textOf(res.body)) == "hello"
			let chunked = try readResponse(wireOf("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n2\r\nhi\r\n0\r\n\r\n"), get)
			assert chunked.transferEncoding.len() == 1 && chunked.transferEncoding[0] == "chunked"
			assert (try textOf(chunked.body)) == "hi"
			assert readResponse(wireOf("HTTP/1.1 2x OK\r\n\r\n"), get) is error
			assert readResponse(wireOf("nonsense\r\n\r\n"), get) is error
			return none
		}
	}
}
