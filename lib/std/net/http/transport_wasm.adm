@os("wasm")
partial module std.net.http {
	use (
		std.data.encoding::(JSON)
		std.net.url
		std.net.http.negotiation::(isDigits)
		std.net.http.transport::(joinHostPort)
		std.services.policy::(Policy, PolicyRequest)
		std.time
	)

	partial type Transport {
		// `roundTrip` without the metrics, on the web: the browser's `fetch`
		// sends the request. The browser holds the connections, picks HTTP/1.1,
		// 2 or 3, follows redirects (the response is the last one, `request.url`
		// where it came from), decodes a `Content-Encoding`, adds the page's
		// cookies and applies its CORS rules; `proxy`, `dialer`, `tls`, the pool
		// settings and `http3` have no effect. The network policy is asked as a
		// connection to the URL's host and port would be.
		internal def deliver(req Request) !Response {
			fail HttpError{message: "transport is closed", op: "transport"} when closed
			let scheme = req.url.scheme.lower()
			fail HttpError{message: "request URL needs a scheme and a host: {req.url.str()}", op: "transport", text: req.url.str()} when scheme == "" || req.url.host == ""
			fail HttpError{message: "unsupported scheme: {scheme}", op: "transport", text: scheme} unless scheme := "http" || "https"
			try Policy.require(PolicyRequest{action: "adm.network.connect", constrained: true})
			try Policy.validate("adm.network.connect", "std.services.policy.EndpointSpec", joinHostPort(req.url.hostname(), req.url.effectivePort()))
			let method = req.method == Method.Other && req.rawMethod != "" ?? (req.rawMethod, req.method.name)
			let sent = WebRequest{method: method, url: req.url.str()}
			for let name in req.headers.keys() {
				for let value in req.headers.values(name) {
					sent.headers.push([name, value])
				}
			}
			sent.timeoutMs = int(float(responseHeaderTimeout) / float(1ms)) when responseHeaderTimeout > 0s
			let deadline = req.deadline
			if !(deadline is none) {
				let left = int(float(deadline - time.now()) / float(1ms))
				fail HttpError{message: "request deadline passed", op: "timeout"} when left <= 0
				sent.timeoutMs = left when sent.timeoutMs == 0 || left < sent.timeoutMs
			}
			let body byte[] = req.body is none ?? (byte[], try req.bytes())
			let status = __webFetch(string(new JSON().encode(sent)), body, body.len())
			if status != 0 {
				let why = __webAnswer()
				fail HttpError{message: "request timed out", op: "timeout", text: req.url.str()} when why.contains("timed out")
				fail HttpError{message: "the browser could not send the request: {why}", op: "transport", text: req.url.str()} when status == -5
				fail HttpError{message: "the browser cannot send requests", op: "transport", text: req.url.str()}
			}
			let head = WebResponse{}
			try new JSON().decode(__webAnswer(), head)
			let res = new Response()
			res.status = head.status
			res.reason = head.statusText
			for let field in head.headers {
				res.headers.add(field[0], field[1]) when field.len() == 2
			}
			// The browser decoded a `Content-Encoding` already.
			if res.headers.has("Content-Encoding") {
				res.headers.del("Content-Encoding")
				res.uncompressed = true
			} else {
				let length = res.headers.get("Content-Length").trim()
				res.contentLength = parseInt<int>(length) when length != "" && isDigits(length)
			}
			let last = req.clone()
			if head.redirected && head.url != "" {
				last.url = url.parse(head.url) onerror recover req.url
			}
			res.request = last
			if head.status == 204 || head.status == 304 || req.method == Method.HEAD {
				__webFetchClose(head.id)
				return res
			}
			let reader = new FetchBody(head.id)
			res.body = reader
			res.onClose(def () {
				reader.close()
			})
			return res
		}
	}

	// A response body the browser streams in.
	internal type FetchBody {
		internal id   int32
		internal done bool

		def new(id int32) {
			self.id = id
		}

		// Implements io.Reader: the next bytes, 0 at the end.
		//
		// Fails when the stream breaks.
		def read(buf byte[]) !int {
			return 0 when done || buf.len() == 0
			let n = __webFetchRead(id, buf, buf.len())
			if n < 0 {
				done = true
				fail HttpError{message: "response body read failed: {__webAnswer()}", op: "transport", code: "body"}
			}
			done = true when n == 0
			return int(n)
		}

		// Stops the stream; reading after it gives the end.
		def close() {
			return when done
			done = true
			__webFetchClose(id)
		}
	}

	// What `adm_web_fetch` takes.
	internal struct WebRequest {
		method    string
		url       string
		headers   string[][] = []
		timeoutMs int
	}

	// What it answers with: the head of the (last) response.
	internal struct WebResponse {
		id         int32
		status     int
		statusText string     = ""
		url        string     = ""
		redirected bool
		headers    string[][] = []
	}

	@c("adm_web.h", symbol = "adm_web_fetch", ret = "int32_t", params = ["const char*", "const uint8_t*", "int64_t"])
	def __webFetch(request string, body byte[], length int) int32;

	@c("adm_web.h", symbol = "adm_web_fetch_read", ret = "int64_t", params = ["int32_t", "uint8_t*", "int64_t"])
	def __webFetchRead(id int32, buf byte[], cap int) int64;

	@c("adm_web.h", symbol = "adm_web_fetch_close", ret = "void", params = ["int32_t"])
	def __webFetchClose(id int32);

	@c("adm_web.h", symbol = "adm_web_answer", ret = "const char*", params = [])
	def __webAnswer() string;
}
