partial module std.net.http.webdav.caldav {
	use (
		std.time
		std.formats.calendar::(Calendar)
	)

	// CalDAV (RFC 4791): calendars on a WebDAV share. `Calendars` makes a
	// `webdav.Server` a CalDAV server; `Client` reads and writes the
	// calendars of a CalDAV account (Nextcloud, iCloud, Google, Radicale,
	// Fastmail...).
	//
	// ```
	// let dav = new webdav.Server(new fs.DiskStore("/srv/dav"), "/dav")
	// dav.accessControl = true
	// dav.extensions.push(new caldav.Calendars())
	// let mux = new http.ServeMux()
	// mux.handle("/dav/", http.basicAuth(dav, checkPassword))
	// mux.handleFunc("/.well-known/caldav", ctx => ctx.redirect("/dav/", 301))
	// ```
	//
	// ```
	// let account = new caldav.Client("https://dav.example.com/dav", "alice", secret)
	// for let cal in try account.calendars() {
	//     for let o in try account.events(cal, time.now(), time.now() + 168h) {
	//         println(o.calendar.entries[0].summary)
	//     }
	// }
	// ```

	// The namespace of every CalDAV element.
	const calNamespace = "urn:ietf:params:xml:ns:caldav"

	// CalendarCollection is a calendar collection on the server.
	struct CalendarCollection {
		// Its store path on the share.
		path        string
		displayName string   = ""
		description string   = ""
		// The colour clients show it in (`calendar-color`), "" unsaid.
		color       string   = ""
		// The state of its members: it changes whenever one does.
		syncToken   string   = ""
		// The components it holds (`VEVENT`, `VTODO`...); empty when the
		// server does not restrict them.
		components  string[] = []
		// The largest object the server stores in it, 0 when it does not
		// say.
		maxSize     int64    = 0
		// The zone floating times in it are read in (`calendar-timezone`,
		// a VCALENDAR with one VTIMEZONE), "" unsaid.
		timeZone    string   = ""
	}

	// CalendarObject is one calendar object resource: where it is, its
	// entity tag (for updates that must not overwrite another client's
	// change), and its calendar (one event, to-do or journal with its
	// overrides, and the time zones it names).
	struct CalendarObject {
		path     string
		etag     string   = ""
		calendar Calendar = new Calendar()
	}

	// Changes is what `Client.sync` learned: the objects created or
	// changed since a token, the paths of those removed, and the token of
	// this state.
	struct Changes {
		changed CalendarObject[] = []
		removed string[]         = []
		token   string           = ""
	}

	// TimeRange is a span of time in a query: from `start` (inclusive) to
	// `end` (exclusive); a side left none is open.
	struct TimeRange {
		start ?time.Time = none
		end   ?time.Time = none
	}

	// TextMatch tests a property or parameter value for holding `text`:
	// `collation` is `i;ascii-casemap` (case-insensitive for ASCII
	// letters) or `i;octet` (exact); `negate` inverts the result.
	struct TextMatch {
		text      string
		collation string = "i;ascii-casemap"
		negate    bool   = false
	}

	// ParamFilter tests a parameter of a property: that it is absent
	// (`notDefined`), present (no `text`), or that its value matches.
	struct ParamFilter {
		name       string
		notDefined bool       = false
		text       ?TextMatch = none
	}

	// PropFilter tests a property of a component: that it is absent
	// (`notDefined`), present, that its time falls in `timeRange`, or
	// that its value matches `text`; and its parameters.
	struct PropFilter {
		name       string
		notDefined bool          = false
		timeRange  ?TimeRange    = none
		text       ?TextMatch    = none
		params     ParamFilter[] = []
	}

	// CompFilter tests a component by name: that it is absent
	// (`notDefined`), or present with an instance in `timeRange`, the
	// properties `props` and the components `comps`. A query's filter is
	// a CompFilter named `VCALENDAR`.
	struct CompFilter {
		name       string
		notDefined bool         = false
		timeRange  ?TimeRange   = none
		props      PropFilter[] = []
		comps      CompFilter[] = []
	}
}
