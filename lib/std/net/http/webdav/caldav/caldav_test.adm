partial module std.net.http.webdav.caldav {
	use (
		std.bytes
		std.fs
		std.time
		std.formats.calendar::*
		std.data.encoding::(XML)
		std.net.http
		std.net.http.httptest
		std.net.http.webdav
		std.net.http.webdav::(WebDavError)
		std.net.http.webdav.caldav.wire::*
		std.testing
	)

	// A CalDAV server with access control, signing in anyone whose
	// password is "pw"; its base URL.
	internal def calServer() !(httptest.Server, string) {
		let dav = new webdav.Server(new fs.MemoryStore(), "/dav")
		dav.accessControl = true
		dav.extensions.push(new Calendars())
		let mux = new http.ServeMux()
		mux.apply(http.basicAuth("dav", def (user string, password string) ?any {
			return none unless password == "pw"
			return user
		}))
		try mux.handle("/dav/", dav)
		let site = new httptest.Server(mux)
		try site.start()
		return (site, "http://{site.address().str()}/dav")
	}

	internal def codeOf(err error) string {
		return err is WebDavError ?? (err.code, "other")
	}

	internal def at(text string) time.Time {
		let t = utcOf(text)
		return time.fromUnixNs(int64(0)) when t is none
		return t
	}

	// A calendar with one weekly event from 2024-01-01 10:00Z, 3 times.
	internal def weekly(summary string) Calendar {
		let cal = new Calendar()
		cal.entries = [CalendarEntry{summary:summary, start:CalendarTime{year:2024, month:1, day:1, hour:10, utc:true}, duration:CalendarDuration{hours:1}, rules:[RecurrenceRule{frequency:RecurrenceFrequency.Weekly, count:3}]}]
		return cal
	}

	check "CalDAV" {
		@test()
		def TestCalFilters() !none {
			let ics = "BEGIN:VCALENDAR\r\nVERSION:2.0\r\nPRODID:t\r\nBEGIN:VEVENT\r\nUID:f1\r\nDTSTAMP:20240101T000000Z\r\nDTSTART:20240105T090000Z\r\nDTEND:20240105T100000Z\r\nSUMMARY:Board Meeting\r\nATTENDEE;PARTSTAT=ACCEPTED:mailto:a@example.com\r\nBEGIN:VALARM\r\nACTION:DISPLAY\r\nDESCRIPTION:x\r\nTRIGGER:-PT30M\r\nEND:VALARM\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n"
			let stored = storedOf(ics.bytes())
			fail "not stored" when stored is none
			let s Stored = stored
			let event = def (f CompFilter) CompFilter {
				return CompFilter{name: "VCALENDAR", comps: [f]}
			}
			assert passes(event(CompFilter{name: "VEVENT"}), s)
			assert !passes(event(CompFilter{name: "VTODO"}), s)
			assert passes(event(CompFilter{name: "VTODO", notDefined: true}), s)
			assert passes(event(CompFilter{name: "VEVENT", timeRange: TimeRange{start: at("20240105T093000Z"), end: at("20240106T000000Z")}}), s)
			assert !passes(event(CompFilter{name: "VEVENT", timeRange: TimeRange{start: at("20240105T100000Z")}}), s)
			assert passes(event(CompFilter{name: "VEVENT", props: [PropFilter{name:"SUMMARY", text:TextMatch{text:"board"}}]}), s)
			assert !passes(event(CompFilter{name: "VEVENT", props: [PropFilter{name:"SUMMARY", text:TextMatch{text:"board", collation:"i;octet"}}]}), s)
			assert passes(event(CompFilter{name: "VEVENT", props: [PropFilter{name:"LOCATION", notDefined:true}]}), s)
			assert passes(event(CompFilter{name: "VEVENT", props: [PropFilter{name:"ATTENDEE", params:[ParamFilter{name:"PARTSTAT", text:TextMatch{text:"accepted"}}]}]}), s)
			assert passes(event(CompFilter{name: "VEVENT", props: [PropFilter{name:"DTSTAMP", timeRange:TimeRange{start:at("20231231T000000Z"), end:at("20240102T000000Z")}}]}), s)
			// The alarm fires at 08:30.
			let alarm = def (from string, to string) CompFilter {
				return event(CompFilter{name: "VEVENT", comps: [CompFilter{name:"VALARM", timeRange:TimeRange{start:at(from), end:at(to)}}]})
			}
			assert passes(alarm("20240105T082000Z", "20240105T084000Z"), s)
			assert !passes(alarm("20240105T090000Z", "20240105T100000Z"), s)
			// A filter written by the client reads back the same.
			let root = try new XML().parse(compFilterNode(alarm("20240105T082000Z", "20240105T084000Z")).str().bytes())
			let (read, problem) = parseCompFilter(root)
			assert problem is none && passes(read, s)
		}

		@test()
		def TestCalendarDataExpand() !none {
			let ics = "BEGIN:VCALENDAR\r\nVERSION:2.0\r\nPRODID:t\r\nBEGIN:VEVENT\r\nUID:w1\r\nDTSTAMP:20240101T000000Z\r\nDTSTART:20240101T100000Z\r\nDURATION:PT1H\r\nRRULE:FREQ=DAILY;COUNT=10\r\nSUMMARY:Daily\r\nEND:VEVENT\r\nBEGIN:VEVENT\r\nUID:w1\r\nDTSTAMP:20240101T000000Z\r\nRECURRENCE-ID:20240103T100000Z\r\nDTSTART:20240103T120000Z\r\nDURATION:PT1H\r\nSUMMARY:Moved\r\nEND:VEVENT\r\nBEGIN:VEVENT\r\nUID:w1\r\nDTSTAMP:20240101T000000Z\r\nRECURRENCE-ID:20240108T100000Z\r\nDTSTART:20240108T120000Z\r\nDURATION:PT1H\r\nSUMMARY:Far\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n"
			let stored = storedOf(ics.bytes())
			fail "not stored" when stored is none
			let s Stored = stored
			let r = TimeRange{start: at("20240102T000000Z"), end: at("20240104T000000Z")}
			let text = try calendarData(s, DataRequest{expand: r})
			assert !text.contains("RRULE") && text.contains("RECURRENCE-ID:20240102T100000Z") && text.contains("DTSTART:20240103T120000Z")
			assert text.contains("SUMMARY:Moved") && !text.contains("SUMMARY:Far")
			let limited = try calendarData(s, DataRequest{limitRecurrence: r})
			assert limited.contains("RRULE") && limited.contains("SUMMARY:Moved") && !limited.contains("SUMMARY:Far")
			let some = try calendarData(s, DataRequest{selection: Selector{name: "VCALENDAR", allProps: false, allComps: false, comps: [Selector{name:"VEVENT", allProps:false, props:["UID", "SUMMARY"]}]}})
			assert some.contains("SUMMARY:Daily") && !some.contains("DTSTART") && !some.contains("PRODID")
		}

		@test()
		def TestCalDAVAccount() !none {
			let (_, base) = try calServer()
			let alice = new Client(base, "alice", "pw", 5s)
			let cals = try alice.calendars()
			assert cals.len() == 1 && cals[0].path == "/calendars/alice/calendar"
			let cal = cals[0]
			let standup = try alice.add(cal, weekly("Standup"))
			assert standup.etag != "" && standup.calendar.entries[0].uid != ""
			let single = new Calendar()
			single.entries = [CalendarEntry{summary:"Dentist", start:CalendarTime{year:2024, month:3, day:1, hour:15, utc:true}, end:CalendarTime{year:2024, month:3, day:1, hour:16, utc:true}}]
			try alice.add(cal, single)
			assert (try alice.objects(cal)).len() == 2
			// The third standup (Jan 15) is in the window; the dentist is not.
			let week = try alice.events(cal, at("20240114T000000Z"), at("20240120T000000Z"))
			assert week.len() == 1 && week[0].calendar.entries[0].summary == "Standup"
			assert (try alice.events(cal, at("20240116T000000Z"), at("20240201T000000Z"))).len() == 0
			let found = try alice.query(cal, CompFilter{name: "VCALENDAR", comps: [CompFilter{name:"VEVENT", props:[PropFilter{name:"SUMMARY", text:TextMatch{text:"dent"}}]}]})
			assert found.len() == 1
			let busy = try alice.freeBusy(cal, at("20240101T000000Z"), at("20240110T000000Z"))
			assert busy.periods.len() == 2 && busy.periods[0].kind == "BUSY"
			// Updates need the current entity tag.
			let token = (try alice.sync(cal)).token
			standup.calendar.entries[0].summary = "Daily standup"
			let fresh = try alice.update(standup)
			let code = ""
			alice.update(standup) onerror (err error) {
				code = codeOf(err)
				recover fresh
			}
			assert code == "precondition"
			let changes = try alice.sync(cal, token)
			assert changes.changed.len() == 1 && changes.changed[0].calendar.entries[0].summary == "Daily standup"
			try alice.remove(fresh)
			assert (try alice.sync(cal, changes.token)).removed.len() == 1
			// A calendar for to-dos only refuses events.
			let tasks = try alice.createCalendar("tasks", "Tasks", "", ["VTODO"])
			code = ""
			alice.add(tasks, weekly("No")) onerror (err error) {
				code = codeOf(err)
				recover standup
			}
			assert code == "forbidden"
			let todo = new Calendar()
			todo.entries = [CalendarEntry{kind:EntryKind.Todo, summary:"Pay rent", due:CalendarTime{year:2024, month:2, day:1, allDay:true}}]
			try alice.add(tasks, todo)
			let listed = try alice.calendars()
			assert listed.len() == 2
			let names = listed.mapElem<string>(c => c.displayName)
			assert names.includes("Tasks")
			// No calendar inside a calendar; another user sees nothing.
			let raw = new webdav.Client(base, "alice", "pw", 5s)
			let nested = try raw.request("MKCALENDAR", tasks.path + "/inner/")
			assert nested.status == 403
			try nested.close()
			let bob = new Client(base, "bob", "pw", 5s)
			assert (try bob.calendars())[0].path == "/calendars/bob/calendar"
			code = ""
			bob.objects(cal) onerror (err error) {
				code = codeOf(err)
				recover CalendarObject[]
			}
			assert code == "forbidden"
		}

		@test()
		def TestCalDAVValidation() !none {
			let (_, base) = try calServer()
			let alice = new Client(base, "alice", "pw", 5s)
			let cal = (try alice.calendars())[0]
			let raw = new webdav.Client(base, "alice", "pw", 5s)
			let refused = def (name string, body string) string {
				let code = ""
				raw.writeFile(cal.path + "/" + name, body) onerror (err error) {
					code = codeOf(err)
					recover none
				}
				return code
			}
			let wrap = def (inner string) string {
				return "BEGIN:VCALENDAR\r\nVERSION:2.0\r\nPRODID:t\r\n" + inner + "END:VCALENDAR\r\n"
			}
			let event = def (uid string, extra string) string {
				return "BEGIN:VEVENT\r\nUID:" + uid + "\r\nDTSTAMP:20240101T000000Z\r\nDTSTART:20240101T100000Z\r\n" + extra + "END:VEVENT\r\n"
			}
			assert refused("a.ics", "not a calendar") == "forbidden"
			assert refused("b.ics", wrap(event("", ""))) == "forbidden"
			assert refused("c.ics", "BEGIN:VCALENDAR\r\nVERSION:2.0\r\nPRODID:t\r\nMETHOD:REQUEST\r\n" + event("m", "") + "END:VCALENDAR\r\n") == "forbidden"
			assert refused("d.ics", wrap(event("x", "") + event("y", ""))) == "forbidden"
			assert refused("e.ics", wrap(event("z", "DTEND;TZID=Europe/Nowhere:20240101T110000\r\n"))) == "forbidden"
			assert refused("f.ics", wrap(event("same", ""))) == ""
			assert refused("h.ics", wrap(event("known zone", "DTEND;TZID=Europe/Berlin:20240101T120000\r\n"))) == ""
			assert refused("g.ics", wrap(event("same", "SUMMARY:dup\r\n"))) == "forbidden"
			assert refused("f.ics", wrap(event("same", "SUMMARY:rewrite\r\n"))) == ""
			// An expanded query through the raw client.
			let body = "<?xml version=\"1.0\"?><C:calendar-query xmlns:C=\"urn:ietf:params:xml:ns:caldav\" xmlns:D=\"DAV:\"><D:prop><C:calendar-data><C:expand start=\"20240101T000000Z\" end=\"20240102T000000Z\"/></C:calendar-data></D:prop><C:filter><C:comp-filter name=\"VCALENDAR\"/></C:filter></C:calendar-query>"
			let res = try raw.request("REPORT", cal.path + "/", body.bytes(), map<string, string>{"Depth": "1", "Content-Type": "application/xml"})
			let answer = string(try res.bytes())
			assert res.status == 207 && answer.contains("DTSTART:20240101T100000Z")
		}
	}
}
