partial module std.net.http.webdav.caldav {
	use (
		std.bytes
		std.fs
		std.time
		std.crypto::(UUID)
		std.data.encoding::(XMLNode)
		std.formats.calendar::(Calendar, FreeBusy, ICalendar)
		std.net.http
		std.net.http.webdav
		std.net.http.webdav::(WebDavError, davNamespace)
		std.net.http.webdav.caldav.wire::*
	)

	// Client reaches the calendars of a CalDAV account: it finds them from
	// the account's principal (RFC 4791 §6.2.1), reads calendar objects
	// whole, in a window of time or by filter, adds, updates and removes
	// them with entity tags so another client's change is never
	// overwritten, asks for free/busy time, and follows changes with
	// sync-collection (RFC 6578). `url` is the account's DAV root.
	type Client {
		internal dav  webdav.Client
		internal home string        = ""

		def new(url string, timeout duration = 30s) {
			dav = new webdav.Client(url, timeout)
		}

		def new(url string, username string, password Secret<string>, timeout duration = 30s) {
			dav = new webdav.Client(url, username, password, timeout)
		}

		// The calendars in the account's home.
		// Fails when the server has no CalDAV home for the login, or
		// cannot be reached.
		def calendars() !CalendarCollection[] {
			let homePath = try homeOf()
			let prop = davNode("prop")
			for let name in ["resourcetype", "displayname", "sync-token"] {
				prop.add(davNode(name))
			}
			for let name in ["calendar-description", "supported-calendar-component-set", "max-resource-size", "calendar-timezone"] {
				prop.add(calNode(name))
			}
			let color = new XMLNode("A:calendar-color", "http://apple.com/ns/ical/")
			color.set("xmlns:A", "http://apple.com/ns/ical/")
			prop.add(color)
			let out CalendarCollection[] = []
			for let a in try propfind(homePath, prop, "1") {
				continue unless hasType(a, calNamespace, "calendar")
				let path = dav.pathOf(a.href)
				continue when path is none
				out.push(collectionOf(path, a))
			}
			return out
		}

		// Makes a calendar `name` in the account's home (MKCALENDAR), for
		// the component types `components` (all when empty).
		// Fails with WebDavError `exists` when the name is taken, or when
		// the server refuses.
		def createCalendar(name string, displayName string = "", description string = "", components string[] = []) !CalendarCollection {
			let homePath = try homeOf()
			let path = homePath.trimSuffix("/") + "/" + name
			let root = calNode("mkcalendar")
			root.set("xmlns:D", davNamespace)
			let prop = root.add(davNode("set")).add(davNode("prop"))
			prop.add(davText("displayname", displayName)) when displayName != ""
			prop.add(calText("calendar-description", description)) when description != ""
			if components.len() > 0 {
				let set = prop.add(calNode("supported-calendar-component-set"))
				for let c in components {
					set.add(calNode("comp")).set("name", c.upper())
				}
			}
			let res = try dav.request("MKCALENDAR", path + "/", document(root), map<string, string>{"Content-Type": "application/xml; charset=utf-8"})
			try expect(res, path, [201])
			return CalendarCollection{path: path, displayName: displayName, description: description, components: components}
		}

		// Removes a calendar and everything in it.
		// Fails when the server refuses.
		def removeCalendar(calendar CalendarCollection) !none {
			return try dav.removeAll(calendar.path)
		}

		// Every object of a calendar.
		// Fails when the server refuses the query.
		def objects(calendar CalendarCollection) !CalendarObject[] {
			return try query(calendar, CompFilter{name: "VCALENDAR"})
		}

		// The events of a calendar with an instance between `from` and
		// `to`, recurring ones whole.
		// Fails when the server refuses the query.
		def events(calendar CalendarCollection, from time.Time, to time.Time) !CalendarObject[] {
			let events = CompFilter{name: "VEVENT", timeRange: TimeRange{start: from, end: to}}
			return try query(calendar, CompFilter{name: "VCALENDAR", comps: [events]})
		}

		// The objects of a calendar that pass `filter` (a comp-filter
		// named `VCALENDAR`), at most `limit` of them (0 for all the
		// server gives).
		// Fails when the server refuses the query (an unsupported filter
		// or collation among the reasons).
		def query(calendar CalendarCollection, filter CompFilter, limit int = 0) !CalendarObject[] {
			let root = calNode("calendar-query")
			root.set("xmlns:D", davNamespace)
			root.add(objectProps())
			root.add(calNode("filter")).add(compFilterNode(filter))
			root.add(calNode("limit")).add(calText("nresults", limit.str())) when limit > 0
			let res = try dav.request("REPORT", calendar.path + "/", document(root), map<string, string>{"Content-Type": "application/xml; charset=utf-8", "Depth": "1"})
			return try objectsOf(res, calendar.path)
		}

		// The objects at `paths`, those that exist (calendar-multiget).
		// Fails when the server refuses the report.
		def get(calendar CalendarCollection, paths string[]) !CalendarObject[] {
			let root = calNode("calendar-multiget")
			root.set("xmlns:D", davNamespace)
			root.add(objectProps())
			for let p in paths {
				root.add(davText("href", dav.href(p)))
			}
			let res = try dav.request("REPORT", calendar.path + "/", document(root), map<string, string>{"Content-Type": "application/xml; charset=utf-8", "Depth": "1"})
			return try objectsOf(res, calendar.path)
		}

		// Adds a calendar object: `data` holds one event, to-do or journal
		// (with its overrides) and the time zones it names. Entries without
		// a uid get one.
		// Fails with WebDavError `forbidden` when the server refuses the
		// object (another with the same uid, an unsupported component, too
		// large), or `precondition` when the name is taken.
		def add(calendar CalendarCollection, data Calendar) !CalendarObject {
			let id = new UUID().str()
			let uid = ""
			for let e in data.entries {
				uid = e.uid when uid == "" && e.uid != ""
			}
			uid = id when uid == ""
			for let e in data.entries {
				e.uid = uid when e.uid == ""
			}
			let path = calendar.path + "/" + id + ".ics"
			let etag = try store(path, data, "", true)
			return CalendarObject{path: path, etag: etag, calendar: data}
		}

		// Stores a changed object over the version `object.etag` names.
		// Fails with WebDavError `precondition` when another client
		// changed or removed it since, or `forbidden` when the server
		// refuses it.
		def update(object CalendarObject) !CalendarObject {
			let etag = try store(object.path, object.calendar, object.etag, false)
			return CalendarObject{path: object.path, etag: etag, calendar: object.calendar}
		}

		// Removes an object, unless another client changed it since
		// `object.etag`.
		// Fails with WebDavError `precondition` when it changed, or
		// `notFound` when it is gone.
		def remove(object CalendarObject) !none {
			let headers = map<string, string>{}
			headers["If-Match"] = object.etag when object.etag != ""
			let res = try dav.request("DELETE", object.path, byte[], headers)
			return try expect(res, object.path, [200, 204])
		}

		// The busy time of a calendar between `from` and `to`
		// (free-busy-query).
		// Fails when the server refuses the report.
		def freeBusy(calendar CalendarCollection, from time.Time, to time.Time) !FreeBusy {
			let root = calNode("free-busy-query")
			root.add(timeRangeNode(TimeRange{start: from, end: to}))
			let res = try dav.request("REPORT", calendar.path + "/", document(root), map<string, string>{"Content-Type": "application/xml; charset=utf-8", "Depth": "1"})
			try expectStatus(res, calendar.path, [200])
			let data = try res.bytes()
			let cal = try new ICalendar().read(new bytes.Reader(data))
			return cal.freeBusy.len() > 0 ?? (cal.freeBusy[0], FreeBusy{})
		}

		// What changed in a calendar since `token` (none for everything
		// now): the changed objects read whole, the paths of those removed,
		// and the token to pass next time.
		// Fails with WebDavError `forbidden` when the token expired (sync
		// again without one).
		def sync(calendar CalendarCollection, token string = "") !Changes {
			let result = try dav.sync(calendar.path, token, false)
			let out = Changes{token: result.token, removed: result.removed}
			let paths string[] = []
			for let e in result.changed {
				paths.push(e.path) unless e.kind == fs.FileKind.Dir
			}
			out.changed = try get(calendar, paths) when paths.len() > 0
			return out
		}

		// Ends the connections.
		// Fails when closing them does.
		def close() !none {
			return try dav.close()
		}

		// ---- internals ----

		// The account's calendar home, found once.
		internal def homeOf() !string {
			return home when home != ""
			let prop = davNode("prop")
			prop.add(davNode("current-user-principal"))
			prop.add(calNode("calendar-home-set"))
			let answers = try propfind("/", prop, "0")
			let found = answers.len() > 0 ?? (hrefIn(answers[0], calNamespace, "calendar-home-set"), "")
			if found == "" {
				let principal = answers.len() > 0 ?? (hrefIn(answers[0], davNamespace, "current-user-principal"), "")
				fail WebDavError{message: "caldav: the server names no principal for the login", code: "unsupported"} when principal == ""
				let principalPath = dav.pathOf(principal)
				fail WebDavError{message: "caldav: the principal {principal} lies outside the share", code: "unsupported"} when principalPath is none
				let homes = try propfind(principalPath, prop, "0")
				found = homes.len() > 0 ?? (hrefIn(homes[0], calNamespace, "calendar-home-set"), "")
			}
			fail WebDavError{message: "caldav: the account has no calendar home", code: "unsupported"} when found == ""
			let path = dav.pathOf(found)
			fail WebDavError{message: "caldav: the home {found} lies outside the share", code: "unsupported"} when path is none
			home = path
			return home
		}

		// A PROPFIND of `prop` at `path`, as answers.
		internal def propfind(path string, prop XMLNode, depth string) !Answer[] {
			let root = davNode("propfind")
			root.add(prop)
			let target = path.endsWith("/") ?? (path, path + "/")
			let res = try dav.request("PROPFIND", target, document(root), map<string, string>{"Content-Type": "application/xml; charset=utf-8", "Depth": depth})
			try expectStatus(res, path, [207])
			return try answersOf(try res.bytes())
		}

		// The `prop` of a report for objects: the entity tag and the data.
		internal def objectProps() XMLNode {
			let prop = davNode("prop")
			prop.add(davNode("getetag"))
			prop.add(calNode("calendar-data"))
			return prop
		}

		// The objects of a report's multistatus.
		internal def objectsOf(res http.Response, path string) !CalendarObject[] {
			try expectStatus(res, path, [207])
			let out CalendarObject[] = []
			for let a in try answersOf(try res.bytes()) {
				continue unless a.status == 200
				let data = textOf(a, calNamespace, "calendar-data")
				continue when data == ""
				let found = dav.pathOf(a.href)
				continue when found is none
				let cal = new ICalendar().read(new bytes.Reader(data.bytes())) onerror recover new Calendar()
				out.push(CalendarObject{path: found, etag: textOf(a, davNamespace, "getetag"), calendar: cal})
			}
			return out
		}

		// PUTs an object: only when nothing is there (`create`), else only
		// over `etag` when there is one. The new entity tag, "" when the
		// server gives none.
		internal def store(path string, data Calendar, etag string, create bool) !string {
			let out = new bytes.Buffer()
			try new ICalendar().write(data, out)
			let headers = map<string, string>{"Content-Type": "text/calendar; charset=utf-8"}
			headers["If-None-Match"] = "*" when create
			headers["If-Match"] = etag when !create && etag != ""
			let res = try dav.request("PUT", path, out.bytes(), headers)
			let tag = res.headers.get("ETag")
			try expect(res, path, [200, 201, 204])
			return tag
		}

		// Fails with the WebDavError of an unexpected status, the response
		// closed; leaves an expected one open.
		internal def expectStatus(res http.Response, path string, ok int[]) !none {
			return none when ok.includes(res.status)
			let body = res.bytes() onerror recover byte[]
			res.close() onerror recover none
			fail errorOf(res.status, path, string(body))
		}

		// Checks the status and closes the response.
		internal def expect(res http.Response, path string, ok int[]) !none {
			try expectStatus(res, path, ok)
			res.close() onerror recover none
			return none
		}
	}

	// A calendar of a PROPFIND answer.
	internal def collectionOf(path string, a Answer) CalendarCollection {
		let size = textOf(a, calNamespace, "max-resource-size")
		let c = CalendarCollection{path: path, displayName: textOf(a, davNamespace, "displayname"), description: textOf(a, calNamespace, "calendar-description"), syncToken: textOf(a, davNamespace, "sync-token"), color: textOf(a, "http://apple.com/ns/ical/", "calendar-color"), timeZone: textOf(a, calNamespace, "calendar-timezone")}
		c.maxSize = size.isNumeric() ?? (size.toInt<int64>(), int64(0))
		let set = a.props.get(calNamespace + " supported-calendar-component-set")
		if !(set is none) {
			for let comp in set.elements("comp", calNamespace) {
				c.components.push(attr(comp, "name").upper())
			}
		}
		return c
	}

	// A request body.
	internal def document(root XMLNode) byte[] {
		return ("<?xml version=\"1.0\" encoding=\"utf-8\"?>\n" + root.str()).bytes()
	}

	// The WebDavError of a failed status; a CalDAV precondition in the
	// body names the reason.
	internal def errorOf(status int, path string, body string) WebDavError {
		let code = "status"
		switch {
			case status == 404:
				code = "notFound"
			case status == 403:
				code = "forbidden"
			case status == 409:
				code = "conflict"
			case status == 412:
				code = "precondition"
			case status == 423:
				code = "locked"
			case status == 405:
				code = "exists"
		}
		let reason = ""
		for let condition in ["no-uid-conflict", "valid-calendar-data", "valid-calendar-object-resource", "supported-calendar-component", "supported-calendar-data", "max-resource-size", "valid-filter", "supported-collation", "calendar-collection-location-ok"] {
			reason = " ({condition})" when reason == "" && body.contains(condition)
		}
		return WebDavError{message: "caldav: {path}: status {status}{reason}", code: code, status: status, path: path}
	}
}
