internal partial module std.net.http.webdav.caldav.wire {
	use (
		std.bytes
		std.fs
		std.time
		std.data.encoding::(XML, XMLNode)
		std.formats.calendar::*
		std.net.http.webdav::(davNamespace)
		std.net.http.webdav.caldav::*
	)

	// The CalDAV parts both sides share: filters as XML and their
	// evaluation, calendar data trimming and expansion, free/busy time,
	// and multistatus reading.

	// An element in the CalDAV namespace, written with the `C:` prefix.
	def calNode(localName string) XMLNode {
		let n = new XMLNode("C:" + localName, calNamespace)
		n.set("xmlns:C", calNamespace)
		return n
	}

	// A CalDAV element holding text.
	def calText(localName string, text string) XMLNode {
		let n = calNode(localName)
		n.add(text)
		return n
	}

	// An element in the DAV: namespace, written with the `D:` prefix.
	def davNode(localName string) XMLNode {
		let n = new XMLNode("D:" + localName, davNamespace)
		n.set("xmlns:D", davNamespace)
		return n
	}

	// A DAV: element holding text.
	def davText(localName string, text string) XMLNode {
		let n = davNode(localName)
		n.add(text)
		return n
	}

	// Whether a node is the CalDAV element `localName`.
	def isCal(node XMLNode, localName string) bool {
		return node.namespace == calNamespace && node.localName == localName
	}

	// An attribute of a node, "" when it has none.
	def attr(node XMLNode, name string) string {
		let value = node.attribute(name)
		return value is none ?? ("", value)
	}

	// ---- times ----

	// The earliest and latest moments an open time range stands for.
	def dawn() time.Time {
		return time.fromUnixNs(int64(-4000000000000000000))
	}

	def dusk() time.Time {
		return time.fromUnixNs(int64(4000000000000000000))
	}

	def two(n int) string {
		return n < 10 ?? ("0" + n.str(), n.str())
	}

	// A moment as an iCalendar UTC date-time.
	def utcText(t time.Time) string {
		return "{t.year()}{two(t.month())}{two(t.day())}T{two(t.hour())}{two(t.minute())}{two(t.second())}Z"
	}

	// A moment's UTC date as an iCalendar date.
	def dateText(t time.Time) string {
		return "{t.year()}{two(t.month())}{two(t.day())}"
	}

	// A UTC date-time (`20060104T000000Z`); none when it is not one.
	def utcOf(text string) ?time.Time {
		let t = timeOf(text, "")
		return none when t is none || !t.utc
		return instantOrNone(new Calendar(), t)
	}

	// A DATE or DATE-TIME value as a calendar time.
	def timeOf(text string, zone string) ?CalendarTime {
		let v = text.trim()
		return none unless v.len() >= 8 && v[:8].isNumeric()
		let t = CalendarTime{year: v[:4].toInt<int>(), month: v[4:6].toInt<int>(), day: v[6:8].toInt<int>()}
		if v.len() == 8 {
			t.allDay = true
			return t
		}
		return none unless v.len() >= 15 && v[8:9] == "T" && v[9:15].isNumeric()
		t.hour = v[9:11].toInt<int>()
		t.minute = v[11:13].toInt<int>()
		t.second = v[13:15].toInt<int>()
		t.utc = v.len() > 15 && v[15:16].upper() == "Z"
		t.zone = t.utc ?? ("", zone)
		return t
	}

	// `calendar.instant` for a time that may name an unknown zone.
	def instantOrNone(calendar Calendar, t CalendarTime) ?time.Time {
		return instantOf(calendar, t) onerror recover none
	}

	def instantOf(calendar Calendar, t CalendarTime) !?time.Time {
		return try calendar.instant(t)
	}

	// The start of a range, the earliest moment when open.
	def startOf(r TimeRange) time.Time {
		let s = r.start
		return dawn() when s is none
		return s
	}

	// The end of a range, the latest moment when open.
	def endOf(r TimeRange) time.Time {
		let e = r.end
		return dusk() when e is none
		return e
	}

	// Whether `a` is not later than `b`.
	def notAfter(a time.Time, b time.Time) bool {
		return !(a > b)
	}

	// Whether the span [from, to) overlaps the range; a zero-length span
	// at `from` counts.
	def overlaps(r TimeRange, from time.Time, to time.Time) bool {
		let start = startOf(r)
		let end = endOf(r)
		return from < end && (to > start || (to.equals(from) && notAfter(start, from)))
	}

	// ---- stored objects ----

	// A stored calendar object: its raw VCALENDAR and its model.
	struct Stored {
		raw      CalendarComponent
		calendar Calendar
		// The raw components the model's entries came from, in order.
		entries  CalendarComponent[]
	}

	// Reads a stored object; none when it is not iCalendar.
	def storedOf(data byte[]) ?Stored {
		let codec = new ICalendar()
		let raws = codec.readComponents(new bytes.Reader(data)) onerror recover CalendarComponent[]
		let roots = raws.filter(c => c.name == "VCALENDAR")
		return none when roots.len() == 0
		let calendar = parse(data) onerror recover new Calendar()
		let entries = roots[0].components.filter(c => c.name := "VEVENT" || "VTODO" || "VJOURNAL")
		return Stored{raw: roots[0], calendar: calendar, entries: entries}
	}

	def parse(data byte[]) !Calendar {
		return try new ICalendar().read(new bytes.Reader(data))
	}

	// Whether two entries are the same component: one uid, one
	// recurrence id.
	def sameEntry(a CalendarEntry, b CalendarEntry) bool {
		return false unless a.uid == b.uid && a.kind == b.kind
		let ra = a.recurrenceId
		let rb = b.recurrenceId
		return rb is none when ra is none
		return false when rb is none
		return ra.year == rb.year && ra.month == rb.month && ra.day == rb.day && ra.hour == rb.hour && ra.minute == rb.minute && ra.second == rb.second
	}

	// The model entry of a raw component; none when it has none.
	def entryOf(s Stored, comp CalendarComponent) ?CalendarEntry {
		for let i = 0; i < s.entries.len() && i < s.calendar.entries.len(); i++ {
			return s.calendar.entries[i] when s.entries[i] == comp
		}
		return none
	}

	// The raw component of a model entry.
	def rawOf(s Stored, entry CalendarEntry) ?CalendarComponent {
		for let i = 0; i < s.entries.len() && i < s.calendar.entries.len(); i++ {
			return s.entries[i] when sameEntry(s.calendar.entries[i], entry)
		}
		return none
	}

	// The master of an entry's recurrence set (itself when it has no
	// recurrence id and no master exists).
	def masterOf(s Stored, entry CalendarEntry) CalendarEntry {
		for let e in s.calendar.entries {
			return e when e.uid == entry.uid && e.kind == entry.kind && e.recurrenceId is none
		}
		return entry
	}

	// The instances of an entry's recurrence set in a range; overrides
	// describe their own.
	def instancesIn(s Stored, entry CalendarEntry, r TimeRange) Occurrence[] {
		let master = masterOf(s, entry)
		return s.calendar.occurrences(master, startOf(r), endOf(r)) onerror recover Occurrence[]
	}

	// ---- filters ----

	// A filter problem: the precondition element to answer with.
	struct FilterProblem {
		condition string
	}

	// Reads a `CALDAV:comp-filter`.
	def parseCompFilter(node XMLNode) (CompFilter, ?FilterProblem) {
		let f = CompFilter{name: attr(node, "name").upper()}
		return (f, FilterProblem{condition: "valid-filter"}) when f.name == ""
		for let child in node.elements() {
			switch {
				case isCal(child, "is-not-defined"):
					f.notDefined = true
				case isCal(child, "time-range"):
					let (r, problem) = parseTimeRange(child)
					return (f, problem) unless problem is none
					f.timeRange = r
				case isCal(child, "prop-filter"):
					let (p, problem) = parsePropFilter(child)
					return (f, problem) unless problem is none
					f.props.push(p)
				case isCal(child, "comp-filter"):
					let (c, problem) = parseCompFilter(child)
					return (f, problem) unless problem is none
					f.comps.push(c)
				default:
					return (f, FilterProblem{condition: "valid-filter"})
			}
		}
		return (f, none)
	}

	// Reads a `CALDAV:prop-filter`.
	def parsePropFilter(node XMLNode) (PropFilter, ?FilterProblem) {
		let f = PropFilter{name: attr(node, "name").upper()}
		return (f, FilterProblem{condition: "valid-filter"}) when f.name == ""
		for let child in node.elements() {
			switch {
				case isCal(child, "is-not-defined"):
					f.notDefined = true
				case isCal(child, "time-range"):
					let (r, problem) = parseTimeRange(child)
					return (f, problem) unless problem is none
					f.timeRange = r
				case isCal(child, "text-match"):
					let (t, problem) = parseTextMatch(child)
					return (f, problem) unless problem is none
					f.text = t
				case isCal(child, "param-filter"):
					let p = ParamFilter{name: attr(child, "name").upper()}
					return (f, FilterProblem{condition: "valid-filter"}) when p.name == ""
					for let inner in child.elements() {
						if isCal(inner, "is-not-defined") {
							p.notDefined = true
						} else if isCal(inner, "text-match") {
							let (t, problem) = parseTextMatch(inner)
							return (f, problem) unless problem is none
							p.text = t
						} else {
							return (f, FilterProblem{condition: "valid-filter"})
						}
					}
					f.params.push(p)
				default:
					return (f, FilterProblem{condition: "valid-filter"})
			}
		}
		return (f, none)
	}

	// Reads a `CALDAV:time-range`: `start` and `end` are UTC date-times.
	def parseTimeRange(node XMLNode) (TimeRange, ?FilterProblem) {
		let r = TimeRange{}
		let start = attr(node, "start")
		let end = attr(node, "end")
		return (r, FilterProblem{condition: "valid-filter"}) when start == "" && end == ""
		if start != "" {
			r.start = utcOf(start)
			return (r, FilterProblem{condition: "valid-filter"}) when r.start is none
		}
		if end != "" {
			r.end = utcOf(end)
			return (r, FilterProblem{condition: "valid-filter"}) when r.end is none
		}
		return (r, none)
	}

	// Reads a `CALDAV:text-match`.
	def parseTextMatch(node XMLNode) (TextMatch, ?FilterProblem) {
		let t = TextMatch{text: node.text(), negate: attr(node, "negate-condition") == "yes"}
		let collation = attr(node, "collation")
		if collation != "" {
			return (t, FilterProblem{condition: "supported-collation"}) unless collation := "i;ascii-casemap" || "i;octet"
			t.collation = collation
		}
		return (t, none)
	}

	// A comp-filter as XML.
	def compFilterNode(f CompFilter) XMLNode {
		let n = calNode("comp-filter")
		n.set("name", f.name)
		n.add(calNode("is-not-defined")) when f.notDefined
		let r = f.timeRange
		n.add(timeRangeNode(r)) unless r is none
		for let p in f.props {
			let pn = n.add(calNode("prop-filter"))
			pn.set("name", p.name)
			pn.add(calNode("is-not-defined")) when p.notDefined
			let pr = p.timeRange
			pn.add(timeRangeNode(pr)) unless pr is none
			let t = p.text
			pn.add(textMatchNode(t)) unless t is none
			for let q in p.params {
				let qn = pn.add(calNode("param-filter"))
				qn.set("name", q.name)
				qn.add(calNode("is-not-defined")) when q.notDefined
				let qt = q.text
				qn.add(textMatchNode(qt)) unless qt is none
			}
		}
		for let c in f.comps {
			n.add(compFilterNode(c))
		}
		return n
	}

	// A time range as XML.
	def timeRangeNode(r TimeRange) XMLNode {
		let n = calNode("time-range")
		let start = r.start
		n.set("start", utcText(start)) unless start is none
		let end = r.end
		n.set("end", utcText(end)) unless end is none
		return n
	}

	// A text match as XML.
	def textMatchNode(t TextMatch) XMLNode {
		let n = calText("text-match", t.text)
		n.set("collation", t.collation)
		n.set("negate-condition", t.negate ?? ("yes", "no"))
		return n
	}

	// Whether a stored object passes a filter (a comp-filter named
	// VCALENDAR).
	def passes(f CompFilter, s Stored) bool {
		return !f.notDefined && f.name == "VCALENDAR" && compPasses(f, s.raw, s, none)
	}

	// Whether a component passes a comp-filter of its name. `parent` is
	// the entry an alarm belongs to.
	def compPasses(f CompFilter, comp CalendarComponent, s Stored, parent ?CalendarEntry) bool {
		let r = f.timeRange
		if !(r is none) {
			return false unless compInRange(r, comp, s, parent)
		}
		for let p in f.props {
			return false unless propPasses(p, comp, s)
		}
		let entry = entryOf(s, comp)
		for let c in f.comps {
			let children = comp.components.filter(k => k.name == c.name)
			if c.notDefined {
				return false unless children.len() == 0
				continue
			}
			let any = false
			for let child in children {
				let owner ?CalendarEntry = parent
				owner = entry unless entry is none
				if compPasses(c, child, s, owner) {
					any = true
					break
				}
			}
			return false unless any
		}
		return true
	}

	// Whether a component has an instance in the range (RFC 4791 §9.9).
	def compInRange(r TimeRange, comp CalendarComponent, s Stored, parent ?CalendarEntry) bool {
		switch {
			case comp.name := "VEVENT" || "VJOURNAL":
				let entry = entryOf(s, comp)
				return false when entry is none
				return false when entry.start is none
				for let o in instancesIn(s, entry, r) {
					return true when sameEntry(o.entry, entry)
				}
				return false
			case comp.name == "VTODO":
				let entry = entryOf(s, comp)
				return false when entry is none
				if entry.start is none && entry.due is none {
					// Neither start nor due: CREATED and COMPLETED decide.
					let created = entry.created
					let completed = entry.completed
					let start = startOf(r)
					let end = endOf(r)
					if !(created is none) && !(completed is none) {
						return (notAfter(start, created) || notAfter(start, completed)) && (notAfter(created, end) || notAfter(completed, end))
					}
					return notAfter(start, completed) && notAfter(completed, end) unless completed is none
					return end > created unless created is none
					return true
				}
				for let o in instancesIn(s, entry, r) {
					return true when sameEntry(o.entry, entry)
				}
				return false
			case comp.name == "VFREEBUSY":
				let found = false
				for let p in comp.properties {
					continue unless p.name == "FREEBUSY"
					for let part in p.value.split(",") {
						found = true when periodInRange(r, part)
					}
				}
				return found
			case comp.name == "VALARM":
				return false when parent is none
				return alarmInRange(r, comp, s, parent)
		}
		return false
	}

	// Whether an alarm of `parent` fires in the range: for each instance,
	// its trigger and repeats.
	def alarmInRange(r TimeRange, comp CalendarComponent, s Stored, parent CalendarEntry) bool {
		let alarms = parent.alarms
		let index = 0
		let alarmComps = rawOf(s, parent)
		let own = alarmComps is none ?? (CalendarComponent[], alarmComps.components.filter(k => k.name == "VALARM"))
		for let i = 0; i < own.len(); i++ {
			index = i when own[i] == comp
		}
		return false unless index < alarms.len()
		let alarm = alarms[index]
		let at = alarm.triggerAt
		let interval = alarm.interval
		let step = interval is none ?? (0s, length(interval))
		if !(at is none) {
			for let k = 0; k <= alarm.repeat; k++ {
				let fire = at + duration(int64(step) * int64(k))
				return true when overlaps(r, fire, fire)
			}
			return false
		}
		let trigger = alarm.trigger
		let offset = trigger is none ?? (0s, length(trigger))
		let reach = (offset < 0s ?? (0s - offset, offset)) + duration(int64(step) * int64(alarm.repeat)) + 24h
		let start = r.start is none ?? (dawn(), startOf(r) - reach)
		let end = r.end is none ?? (dusk(), endOf(r) + reach)
		for let o in instancesIn(s, parent, TimeRange{start: start, end: end}) {
			continue unless sameEntry(o.entry, parent)
			let base = alarm.fromEnd ?? (o.end, o.start)
			for let k = 0; k <= alarm.repeat; k++ {
				let fire = base + offset + duration(int64(step) * int64(k))
				return true when overlaps(r, fire, fire)
			}
		}
		return false
	}

	// Whether a UTC PERIOD (`start/end` or `start/duration`) overlaps the
	// range.
	def periodInRange(r TimeRange, text string) bool {
		let slash = text.indexOf("/")
		return false when slash < 0
		let from = utcOf(text[:slash].trim())
		return false when from is none
		let rest = text[slash + 1:].trim()
		let to = utcOf(rest)
		if to is none {
			let span = spanOf(rest)
			return false when span < 0s
			return overlaps(r, from, from + span)
		}
		return overlaps(r, from, to)
	}

	// A positive DURATION (`PT1H`, `P1DT2H`, `P2W`) as a length; -1s when
	// it is not one.
	def spanOf(text string) duration {
		let v = text.upper().trimPrefix("+")
		return -1s unless v.startsWith("P")
		let total = int64(0)
		let number = int64(0)
		let digits = false
		let inTime = false
		for let c in v[1:].bytes() {
			if c >= byte('0') && c <= byte('9') {
				number = number * int64(10) + int64(c - byte('0'))
				digits = true
				continue
			}
			if c == byte('T') {
				inTime = true
				continue
			}
			return -1s unless digits
			switch {
				case c == byte('W'):
					total += number * int64(604800)
				case c == byte('D'):
					total += number * int64(86400)
				case c == byte('H') && inTime:
					total += number * int64(3600)
				case c == byte('M') && inTime:
					total += number * int64(60)
				case c == byte('S') && inTime:
					total += number
				default:
					return -1s
			}
			number = int64(0)
			digits = false
		}
		return duration(total * int64(1000000000))
	}

	// Whether a time is in the range; false for none or an unknown zone.
	def inRange(r TimeRange, calendar Calendar, t ?CalendarTime) bool {
		return false when t is none
		let at = instantOrNone(calendar, t)
		return false when at is none
		return overlaps(r, at, at)
	}

	// Whether a component passes a prop-filter.
	def propPasses(f PropFilter, comp CalendarComponent, s Stored) bool {
		let found = comp.properties.filter(p => p.name == f.name)
		return found.len() == 0 when f.notDefined
		return false when found.len() == 0
		for let p in found {
			let ok = true
			let r = f.timeRange
			if !(r is none) {
				let zone = paramOf(p, "TZID")
				ok = inRange(r, s.calendar, timeOf(p.value, zone))
			}
			let text = f.text
			ok = ok && textPasses(text, unescape(p.value)) unless text is none
			for let q in f.params {
				ok = ok && paramPasses(q, p)
			}
			return true when ok
		}
		return false
	}

	// Whether a property passes a param-filter.
	def paramPasses(f ParamFilter, p CalendarProperty) bool {
		let present = false
		let values string[] = []
		for let q in p.params {
			continue unless q.name == f.name
			present = true
			values = values + q.values
		}
		return !present when f.notDefined
		let text = f.text
		return present when text is none
		for let v in values {
			return true when textPasses(text, v)
		}
		return false
	}

	// Whether a value holds a text match's text.
	def textPasses(t TextMatch, value string) bool {
		let hit = t.collation == "i;octet" ?? (value.contains(t.text), asciiLower(value).contains(asciiLower(t.text)))
		return t.negate ?? (!hit, hit)
	}

	// Text with ASCII letters lower-cased.
	def asciiLower(text string) string {
		let out byte[] = []
		for let c in text.bytes() {
			out.push((c >= byte('A') && c <= byte('Z')) ?? (c + byte(32), c))
		}
		return string(out)
	}

	// The values of a parameter, comma-joined.
	def paramOf(p CalendarProperty, name string) string {
		let out string[] = []
		for let q in p.params {
			out = out + q.values when q.name == name
		}
		return out.join(",")
	}

	// Text with iCalendar escapes undone.
	def unescape(text string) string {
		return text unless text.contains("\\")
		return text.replace("\\\\", "\u0001").replace("\\n", "\n").replace("\\N", "\n").replace("\\,", ",").replace("\\;", ";").replace("\u0001", "\\")
	}

	// ---- calendar data ----

	// What a report asks of `calendar-data`: parts of the data
	// (`selection`), recurrence expanded into instances or trimmed to a
	// range, free/busy trimmed to a range.
	struct DataRequest {
		contentType     string     = "text/calendar"
		version         string     = "2.0"
		selection       ?Selector  = none
		expand          ?TimeRange = none
		limitRecurrence ?TimeRange = none
		limitFreeBusy   ?TimeRange = none
	}

	// A `CALDAV:comp` of calendar-data: the properties and components of
	// a component to keep.
	struct Selector {
		name     string
		allProps bool       = true
		props    string[]   = []
		novalue  string[]   = []
		allComps bool       = true
		comps    Selector[] = []
	}

	// Reads a `calendar-data` element of a report's `prop`.
	def dataRequestOf(node XMLNode) DataRequest {
		let r = DataRequest{}
		let contentType = attr(node, "content-type")
		r.contentType = contentType.lower() when contentType != ""
		let version = attr(node, "version")
		r.version = version when version != ""
		for let child in node.elements() {
			switch {
				case isCal(child, "comp"):
					r.selection = selectorOf(child)
				case isCal(child, "expand"):
					let (span, _) = parseTimeRange(child)
					r.expand = span
				case isCal(child, "limit-recurrence-set"):
					let (span, _) = parseTimeRange(child)
					r.limitRecurrence = span
				case isCal(child, "limit-freebusy-set"):
					let (span, _) = parseTimeRange(child)
					r.limitFreeBusy = span
			}
		}
		return r
	}

	// Reads a `CALDAV:comp`.
	def selectorOf(node XMLNode) Selector {
		let s = Selector{name: attr(node, "name").upper()}
		s.allProps = !(node.child("allprop", calNamespace) is none)
		s.allComps = !(node.child("allcomp", calNamespace) is none)
		for let p in node.elements("prop", calNamespace) {
			let name = attr(p, "name").upper()
			continue when name == ""
			s.props.push(name)
			s.novalue.push(name) when attr(p, "novalue") == "yes"
		}
		for let c in node.elements("comp", calNamespace) {
			s.comps.push(selectorOf(c))
		}
		return s
	}

	// Whether the server can give calendar data in the form asked.
	def supported(r DataRequest) bool {
		return r.contentType == "text/calendar" && r.version == "2.0"
	}

	// The calendar data of a stored object as a report asks for it.
	// Fails when the data cannot be written.
	def calendarData(s Stored, r DataRequest) !string {
		let root = s.raw
		let expand = r.expand
		if !(expand is none) {
			root = expanded(s, expand)
		} else {
			let limit = r.limitRecurrence
			root = limited(s, limit) unless limit is none
		}
		let busy = r.limitFreeBusy
		root = busyLimited(root, busy) unless busy is none
		let selection = r.selection
		root = selected(root, selection) unless selection is none
		let out = new bytes.Buffer()
		try new ICalendar().writeComponents([root], out)
		return string(out.bytes())
	}

	// A copy of a component with only its calendar-level properties.
	def shell(comp CalendarComponent) CalendarComponent {
		return CalendarComponent{name: comp.name, properties: comp.properties}
	}

	// The object with its recurrence sets as instances in the range, in
	// UTC (RFC 4791 §9.6.5): one component per instance, no rules, no
	// time zones.
	def expanded(s Stored, r TimeRange) CalendarComponent {
		let out = shell(s.raw)
		for let comp in s.raw.components {
			if comp.name == "VTIMEZONE" {
				continue
			}
			let entry = entryOf(s, comp)
			if entry is none {
				out.components.push(comp)
				continue
			}
			continue unless entry.recurrenceId is none
			let recurring = entry.rules.len() > 0 || entry.dates.len() > 0 || s.calendar.entries.filter(e => e.uid == entry.uid && !(e.recurrenceId is none)).len() > 0
			for let o in instancesIn(s, entry, r) {
				let describing = rawOf(s, o.entry)
				continue when describing is none
				let start = entry.start
				let allDay = !(start is none) && start.allDay
				out.components.push(instanceOf(describing, o, recurring, allDay, s))
			}
		}
		return out
	}

	// One instance as a component in UTC.
	def instanceOf(comp CalendarComponent, o Occurrence, recurring bool, allDay bool, s Stored) CalendarComponent {
		let c = CalendarComponent{name: comp.name, components: comp.components}
		for let p in comp.properties {
			continue when p.name := "DTSTART" || "DTEND" || "DURATION" || "DUE" || "RRULE" || "RDATE" || "EXDATE" || "RECURRENCE-ID"
			c.properties.push(p)
		}
		let dateParam = [CalendarParam{name:"VALUE", values:["DATE"]}]
		c.properties.push(CalendarProperty{name: "DTSTART", value: allDay ?? (dateText(o.start), utcText(o.start)), params: allDay ?? (dateParam, CalendarParam[])})
		if o.end > o.start {
			let closing = comp.name == "VTODO" ?? ("DUE", "DTEND")
			c.properties.push(CalendarProperty{name: closing, value: allDay ?? (dateText(o.end), utcText(o.end)), params: allDay ?? (dateParam, CalendarParam[])})
		}
		if recurring {
			let rid = instantOrNone(s.calendar, o.recurrenceId)
			if !(rid is none) {
				c.properties.push(CalendarProperty{name: "RECURRENCE-ID", value: allDay ?? (dateText(rid), utcText(rid)), params: allDay ?? (dateParam, CalendarParam[])})
			}
		}
		return c
	}

	// The object with only the overrides whose instance falls in the
	// range (RFC 4791 §9.6.6); masters and other components stay.
	def limited(s Stored, r TimeRange) CalendarComponent {
		let out = shell(s.raw)
		for let comp in s.raw.components {
			let entry = entryOf(s, comp)
			if entry is none || entry.recurrenceId is none {
				out.components.push(comp)
				continue
			}
			let keep = false
			for let o in instancesIn(s, entry, TimeRange{}) {
				keep = true when sameEntry(o.entry, entry) && overlaps(r, o.start, o.end)
			}
			keep = true when inRange(r, s.calendar, entry.recurrenceId)
			out.components.push(comp) when keep
		}
		return out
	}

	// Free/busy components with only the periods that overlap the range
	// (RFC 4791 §9.6.7).
	def busyLimited(root CalendarComponent, r TimeRange) CalendarComponent {
		let out = shell(root)
		for let comp in root.components {
			if comp.name != "VFREEBUSY" {
				out.components.push(comp)
				continue
			}
			let c = CalendarComponent{name: comp.name, components: comp.components}
			for let p in comp.properties {
				if p.name != "FREEBUSY" {
					c.properties.push(p)
					continue
				}
				let kept string[] = []
				for let part in p.value.split(",") {
					kept.push(part) when periodInRange(r, part)
				}
				c.properties.push(CalendarProperty{name: p.name, value: kept.join(","), params: p.params}) when kept.len() > 0
			}
			out.components.push(c)
		}
		return out
	}

	// A component with only what a selector keeps (RFC 4791 §9.6.1).
	def selected(comp CalendarComponent, s Selector) CalendarComponent {
		let c = CalendarComponent{name: comp.name}
		for let p in comp.properties {
			if s.allProps {
				c.properties.push(p)
			} else if s.props.includes(p.name) {
				c.properties.push(s.novalue.includes(p.name) ?? (CalendarProperty{name: p.name, value: "", params: p.params}, p))
			}
		}
		for let sub in comp.components {
			if s.allComps {
				c.components.push(sub)
				continue
			}
			for let inner in s.comps {
				if inner.name == sub.name {
					c.components.push(selected(sub, inner))
					break
				}
			}
		}
		return c
	}

	// ---- free/busy ----

	// The busy time of stored objects in a range (RFC 4791 §7.10):
	// opaque, not cancelled events and the periods of free/busy
	// components, merged per kind.
	def busyTime(objects Stored[], r TimeRange) BusyPeriod[] {
		let periods BusyPeriod[] = []
		let start = startOf(r)
		let end = endOf(r)
		for let s in objects {
			for let e in s.calendar.entries {
				continue unless e.kind == EntryKind.Event && e.recurrenceId is none
				for let o in instancesIn(s, e, r) {
					let d = o.entry
					continue when d.transparent || d.status == "CANCELLED"
					let kind = d.status == "TENTATIVE" ?? ("BUSY-TENTATIVE", "BUSY")
					let from = o.start < start ?? (start, o.start)
					let to = o.end > end ?? (end, o.end)
					periods.push(BusyPeriod{start: from, end: to, kind: kind}) when to > from
				}
			}
			for let f in s.calendar.freeBusy {
				for let p in f.periods {
					continue unless p.kind != "FREE" && overlaps(r, p.start, p.end)
					periods.push(BusyPeriod{start: p.start < start ?? (start, p.start), end: p.end > end ?? (end, p.end), kind: p.kind})
				}
			}
		}
		periods.sort((a, b) => a.start < b.start)
		let merged BusyPeriod[] = []
		for let p in periods {
			let joined = false
			for let m in merged {
				if m.kind == p.kind && p.start <= m.end && p.end >= m.start {
					m.end = p.end when p.end > m.end
					joined = true
					break
				}
			}
			merged.push(BusyPeriod{start: p.start, end: p.end, kind: p.kind}) unless joined
		}
		return merged
	}

	// A free/busy answer as a VCALENDAR with one VFREEBUSY.
	def freeBusyText(periods BusyPeriod[], r TimeRange) string {
		let cal = new Calendar()
		let fb = FreeBusy{stamp: time.now(), periods: periods}
		let start = r.start
		let end = r.end
		fb.start = timeOfInstant(start) unless start is none
		fb.end = timeOfInstant(end) unless end is none
		cal.freeBusy = [fb]
		let out = new bytes.Buffer()
		new ICalendar().write(cal, out) onerror recover none
		return string(out.bytes())
	}

	// A moment as a UTC calendar time.
	def timeOfInstant(t time.Time) CalendarTime {
		return CalendarTime{year: t.year(), month: t.month(), day: t.day(), hour: t.hour(), minute: t.minute(), second: t.second(), utc: true}
	}

	// ---- stores ----

	// The whole of a file of a store.
	// Fails when the file cannot be read.
	def readFile(store fs.FileStore, path string) !byte[] {
		let reader = try store.open(path, int64(0))
		let out = new bytes.Buffer()
		let failed ?error = none
		out.readFrom(reader) onerror (err error) {
			failed = err
			recover int64(0)
		}
		reader.close() onerror recover none
		fail failed unless failed is none
		return out.bytes()
	}

	// ---- multistatus ----

	// One response of a multistatus: href, status, properties found.
	struct Answer {
		href   string
		status int                  = 200
		props  map<string, XMLNode> = map<string, XMLNode>{}
	}

	// The responses of a multistatus body.
	// Fails when the body is not XML.
	def answersOf(data byte[]) !Answer[] {
		let root = try new XML().parse(data)
		let out Answer[] = []
		for let r in root.elements("response", davNamespace) {
			let href = r.child("href", davNamespace)
			continue when href is none
			let a = Answer{href: href.text().trim()}
			let own = r.child("status", davNamespace)
			a.status = statusOf(own.text()) unless own is none
			for let ps in r.elements("propstat", davNamespace) {
				let status = ps.child("status", davNamespace)
				continue unless status is none || statusOf(status.text()) == 200
				let prop = ps.child("prop", davNamespace)
				continue when prop is none
				for let p in prop.elements() {
					a.props[p.namespace + " " + p.localName] = p
				}
			}
			out.push(a)
		}
		return out
	}

	// The code of a status line.
	def statusOf(line string) int {
		let parts = line.trim().split(" ")
		return 0 unless parts.len() >= 2 && parts[1].isNumeric()
		return parts[1].toInt<int>()
	}

	// The text of a property of an answer, "" when not found.
	def textOf(a Answer, namespace string, localName string) string {
		let p = a.props.get(namespace + " " + localName)
		return p is none ?? ("", p.text().trim())
	}

	// Whether an answer's `resourcetype` holds the element.
	def hasType(a Answer, namespace string, localName string) bool {
		let p = a.props.get(davNamespace + " resourcetype")
		return false when p is none
		return !(p.child(localName, namespace) is none)
	}

	// The first `href` inside a property of an answer, "" when none.
	def hrefIn(a Answer, namespace string, localName string) string {
		let p = a.props.get(namespace + " " + localName)
		return "" when p is none
		let href = p.child("href", davNamespace)
		return href is none ?? ("", href.text().trim())
	}
}
