partial module std.net.http.webdav.carddav {
	use (
		std.formats.contacts::(Contact)
	)

	// CardDAV (RFC 6352): address books on a WebDAV share. `AddressBooks`
	// makes a `webdav.Server` a CardDAV server; `Client` reads and writes
	// the address books of a CardDAV account (Nextcloud, iCloud, Radicale,
	// Fastmail...).
	//
	// ```
	// let dav = new webdav.Server(new fs.DiskStore("/srv/dav"), "/dav")
	// dav.accessControl = true
	// dav.extensions.push(new carddav.AddressBooks())
	// let mux = new http.ServeMux()
	// mux.handle("/dav/", http.basicAuth(dav, checkPassword))
	// mux.handleFunc("/.well-known/carddav", ctx => ctx.redirect("/dav/", 301))
	// ```
	//
	// ```
	// let account = new carddav.Client("https://dav.example.com/dav", "alice", secret)
	// for let book in try account.addressBooks() {
	//     for let card in try account.contacts(book) {
	//         println(card.contact.fullName)
	//     }
	// }
	// ```

	// The namespace of every CardDAV element.
	const cardNamespace = "urn:ietf:params:xml:ns:carddav"

	// AddressBook is an address book collection.
	struct AddressBook {
		// Its store path on the share.
		path        string
		displayName string = ""
		description string = ""
		// The state of its members: it changes whenever one does.
		syncToken   string = ""
		// The largest vCard the server stores in it, 0 when it does not
		// say.
		maxSize     int64  = 0
	}

	// AddressObject is one contact stored in an address book: where it
	// is, its entity tag (for updates that must not overwrite another
	// client's change), and the contact.
	struct AddressObject {
		path    string
		etag    string  = ""
		contact Contact = Contact{}
	}

	// Changes is what `Client.sync` learned: the contacts created or
	// changed since a token, the paths of those removed, and the token of
	// this state for the next call.
	struct Changes {
		changed AddressObject[] = []
		removed string[]        = []
		token   string          = ""
	}

	// MatchType is how a `TextMatch` compares.
	enum MatchType {
		Equals     = "equals",
		Contains   = "contains",
		StartsWith = "starts-with",
		EndsWith   = "ends-with",
	}

	// TextMatch tests a property or parameter value against `text`.
	// `collation` is `i;unicode-casemap` (case-insensitive, any script),
	// `i;ascii-casemap` (case-insensitive for ASCII letters) or `i;octet`
	// (exact); `negate` inverts the result.
	struct TextMatch {
		text      string
		matchType MatchType = MatchType.Contains
		collation string    = "i;unicode-casemap"
		negate    bool      = false
	}

	// ParamFilter tests a parameter of a property: that it is absent
	// (`notDefined`), present (no `text`), or that a value matches `text`.
	struct ParamFilter {
		name       string
		notDefined bool       = false
		text       ?TextMatch = none
	}

	// PropFilter tests a vCard property by name (`EMAIL`, `FN`): that it
	// is absent (`notDefined`), present (no tests), or that one of its
	// occurrences passes the tests — any of them, or all when `all` is
	// set.
	struct PropFilter {
		name       string
		notDefined bool          = false
		all        bool          = false
		texts      TextMatch[]   = []
		params     ParamFilter[] = []
	}

	// CardFilter selects contacts in an address book query: those that
	// pass any of the property filters, or all of them when `all` is set.
	// No filters selects every contact.
	struct CardFilter {
		props PropFilter[] = []
		all   bool         = false
	}
}
