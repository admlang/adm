partial module std.net.http.webdav.carddav {
	use (
		std.bytes
		std.fs
		std.data.encoding::(XML, XMLNode)
		std.formats.contacts::(Contact, ContactValue, VCard)
		std.net.http
		std.net.http.httptest
		std.net.http.webdav
		std.net.http.webdav::(WebDavError)
		std.net.http.webdav.carddav.wire::*
		std.testing
	)

	// A CardDAV server with access control, signing in anyone whose
	// password is "pw"; its base URL.
	internal def cardServer() !(httptest.Server, webdav.Server, string) {
		let dav = new webdav.Server(new fs.MemoryStore(), "/dav")
		dav.accessControl = true
		dav.extensions.push(new AddressBooks())
		let mux = new http.ServeMux()
		mux.apply(http.basicAuth("dav", def (user string, password string) ?any {
			return none unless password == "pw"
			return user
		}))
		try mux.handle("/dav/", dav)
		let site = new httptest.Server(mux)
		try site.start()
		return (site, dav, "http://{site.address().str()}/dav")
	}

	internal def codeOf(err error) string {
		return err is WebDavError ?? (err.code, "other")
	}

	internal def person(name string, email string) Contact {
		let c = Contact{fullName: name}
		c.emails = [ContactValue{value:email, types:["work"]}]
		return c
	}

	check "CardDAV" {
		@test()
		def TestCardFilters() !none {
			let card = try new VCard().readCards(new bytes.Reader("BEGIN:VCARD\nVERSION:4.0\nFN:Jane Doe\nEMAIL;TYPE=work:jane@Example.com\nTEL;TYPE=cell:+1 555\nEND:VCARD\n".bytes()))
			let props = card[0]
			let parse = def (xml string) CardFilter {
				let root = new XML().parse(xml.bytes()) onerror recover new XMLNode("")
				let (filter, _) = parseFilter(root)
				return filter
			}
			let ns = "xmlns:C=\"urn:ietf:params:xml:ns:carddav\""
			assert passes(parse("<C:filter {ns}><C:prop-filter name=\"EMAIL\"><C:text-match>example.COM</C:text-match></C:prop-filter></C:filter>"), props)
			assert !passes(parse("<C:filter {ns}><C:prop-filter name=\"EMAIL\"><C:text-match collation=\"i;octet\">example.COM</C:text-match></C:prop-filter></C:filter>"), props)
			assert passes(parse("<C:filter {ns}><C:prop-filter name=\"fn\"><C:text-match match-type=\"starts-with\">jane</C:text-match></C:prop-filter></C:filter>"), props)
			assert !passes(parse("<C:filter {ns}><C:prop-filter name=\"FN\"><C:text-match match-type=\"equals\" negate-condition=\"yes\">Jane Doe</C:text-match></C:prop-filter></C:filter>"), props)
			assert passes(parse("<C:filter {ns}><C:prop-filter name=\"NICKNAME\"><C:is-not-defined/></C:prop-filter></C:filter>"), props)
			assert passes(parse("<C:filter {ns}><C:prop-filter name=\"TEL\"><C:param-filter name=\"TYPE\"><C:text-match match-type=\"equals\">cell</C:text-match></C:param-filter></C:prop-filter></C:filter>"), props)
			assert !passes(parse("<C:filter {ns} test=\"allof\"><C:prop-filter name=\"TEL\"/><C:prop-filter name=\"NOTE\"/></C:filter>"), props)
			assert passes(parse("<C:filter {ns} test=\"anyof\"><C:prop-filter name=\"TEL\"/><C:prop-filter name=\"NOTE\"/></C:filter>"), props)
			let root = try new XML().parse("<C:filter {ns}><C:prop-filter name=\"FN\"><C:text-match collation=\"i;klingon\">x</C:text-match></C:prop-filter></C:filter>".bytes())
			let (_, problem) = parseFilter(root)
			assert !(problem is none) && problem.condition == "supported-collation"
			// A filter written by the client reads back the same.
			let built = CardFilter{all: true, props: [PropFilter{name:"EMAIL", texts:[TextMatch{text:"example.com", matchType:MatchType.EndsWith}]}]}
			let again = try new XML().parse(filterNode(built).str().bytes())
			let (read, _) = parseFilter(again)
			assert read.all && read.props[0].name == "EMAIL" && read.props[0].texts[0].matchType == MatchType.EndsWith
			assert passes(read, props)
		}

		@test()
		def TestAddressDataConversion() !none {
			let stored = "BEGIN:VCARD\r\nVERSION:4.0\r\nUID:u1\r\nFN:Jane\r\nEMAIL:jane@example.com\r\nNOTE:secret\r\nEND:VCARD\r\n".bytes()
			let v3 = try addressData(stored, DataRequest{version: "3.0"})
			assert v3.contains("VERSION:3.0\r\n") && v3.contains("FN:Jane\r\n")
			let some = try addressData(stored, DataRequest{version: "4.0", names: ["EMAIL", "NOTE"], novalue: ["NOTE"]})
			assert some == "BEGIN:VCARD\r\nVERSION:4.0\r\nUID:u1\r\nEMAIL:jane@example.com\r\nNOTE:\r\nEND:VCARD\r\n"
		}

		@test()
		def TestCardDAVAccount() !none {
			let (_, _, base) = try cardServer()
			let alice = new Client(base, "alice", "pw", 5s)
			let books = try alice.addressBooks()
			assert books.len() == 1 && books[0].path == "/addressbooks/alice/contacts"
			let book = books[0]
			let jane = try alice.add(book, person("Jane Doe", "jane@example.com"))
			assert jane.contact.uid.startsWith("urn:uuid:") && jane.etag != ""
			try alice.add(book, person("John Roe", "john@other.org"))
			let all = try alice.contacts(book)
			assert all.len() == 2
			let found = try alice.query(book, CardFilter{props: [PropFilter{name:"EMAIL", texts:[TextMatch{text:"other.org"}]}]})
			assert found.len() == 1 && found[0].contact.fullName == "John Roe"
			let limited = try alice.query(book, CardFilter{}, 1)
			assert limited.len() == 1
			let got = try alice.get(book, [jane.path, book.path + "/missing.vcf"])
			assert got.len() == 1 && got[0].contact.emails[0].value == "jane@example.com"
			// An update over a stale tag is refused.
			let token0 = (try alice.sync(book)).token
			jane.contact.notes = [ContactValue{value:"met at the conference"}]
			let fresh = try alice.update(jane)
			assert fresh.etag != jane.etag
			let code = ""
			alice.update(jane) onerror (err error) {
				code = codeOf(err)
				recover fresh
			}
			assert code == "precondition"
			let changes = try alice.sync(book, token0)
			assert changes.changed.len() == 1 && changes.changed[0].contact.notes[0].value == "met at the conference"
			try alice.remove(fresh)
			let after = try alice.sync(book, changes.token)
			assert after.removed.len() == 1 && after.changed.len() == 0
			// A second address book, and another user sees none of them.
			let work = try alice.createAddressBook("work", "Work", "Colleagues")
			assert work.path == "/addressbooks/alice/work"
			let names = (try alice.addressBooks()).mapElem<string>(b => b.displayName)
			assert names.len() == 2 && names.includes("Work")
			let bob = new Client(base, "bob", "pw", 5s)
			let bobs = try bob.addressBooks()
			assert bobs.len() == 1 && bobs[0].path == "/addressbooks/bob/contacts"
			code = ""
			bob.contacts(book) onerror (err error) {
				code = codeOf(err)
				recover AddressObject[]
			}
			assert code == "forbidden"
		}

		@test()
		def TestCardDAVValidation() !none {
			let (_, _, base) = try cardServer()
			let alice = new Client(base, "alice", "pw", 5s)
			let book = (try alice.addressBooks())[0]
			let raw = new webdav.Client(base, "alice", "pw", 5s)
			let refused = def (path string, body string) string {
				let code = ""
				raw.writeFile(path, body) onerror (err error) {
					code = codeOf(err)
					recover none
				}
				return code
			}
			assert refused(book.path + "/a.vcf", "not a card") == "forbidden"
			assert refused(book.path + "/b.vcf", "BEGIN:VCARD\nVERSION:4.0\nFN:No uid\nEND:VCARD\n") == "forbidden"
			assert refused(book.path + "/c.vcf", "BEGIN:VCARD\nVERSION:2.1\nUID:x\nFN:Old\nEND:VCARD\n") == "forbidden"
			assert refused(book.path + "/d.vcf", "BEGIN:VCARD\nVERSION:4.0\nUID:same\nFN:One\nEND:VCARD\n") == ""
			assert refused(book.path + "/e.vcf", "BEGIN:VCARD\nVERSION:3.0\nUID:same\nFN:Two\nN:;;;;\nEND:VCARD\n") == "forbidden"
			// Rewriting the same resource keeps its uid.
			assert refused(book.path + "/d.vcf", "BEGIN:VCARD\nVERSION:4.0\nUID:same\nFN:One again\nEND:VCARD\n") == ""
			// Outside an address book anything goes.
			assert refused("/addressbooks/alice/notes.txt", "free text") == ""
			let v4 = new Client(base, "alice", "pw", 5s)
			v4.version = "4.0"
			let stored = try v4.add(book, person("Four", "four@example.com"))
			assert (try raw.readText(stored.path)).contains("VERSION:4.0")
			let back = try alice.get(book, [stored.path])
			assert back.len() == 1 && back[0].contact.fullName == "Four"
		}
	}
}
