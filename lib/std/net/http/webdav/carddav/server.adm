partial module std.net.http.webdav.carddav {
	use (
		std.bytes
		std.fs
		std.data.encoding::(XMLNode)
		std.formats.contacts::(ContactProperty, VCard)
		std.net.http::(Context)
		std.net.http.webdav::(Server, Ace, Privilege, davNamespace)
		std.net.http.webdav.carddav.wire::*
	)

	// AddressBooks makes a `webdav.Server` a CardDAV server (RFC 6352):
	// address book collections (extended MKCOL with a
	// `CARDDAV:addressbook` resource type), each user's address book home
	// on their principal (`addressbook-home-set`), the
	// `addressbook-query` and `addressbook-multiget` reports with vCard
	// 3.0 and 4.0 conversion, and the checks on what a client stores: one
	// vCard with a unique `UID` per resource. Discovery needs principals,
	// so turn on `Server.accessControl`.
	type AddressBooks {
		// The store path under which each user's home lies:
		// `<home>/<user>/`.
		home        string = "/addressbooks"
		// The address book made in a home the first time a client asks
		// for it; "" makes none.
		defaultBook string = "contacts"
		// The largest vCard stored, in bytes; 0 for no limit.
		maxSize     int64  = 0
		// The most contacts one query answers; a query with more gets
		// them cut with a 507 for the collection. 0 for no limit.
		maxResults  int    = 0

		def new() {}

		// compliance implements Extension.
		def compliance() string[] {
			return ["addressbook"]
		}

		// methods implements Extension: CardDAV adds none.
		def methods() string[] {
			return []
		}

		// collectionTypes implements Extension.
		def collectionTypes() XMLNode[] {
			return [cardNode("addressbook")]
		}

		// Makes `user`'s address book home, only they may use, and the
		// default address book in it, unless they exist.
		// Fails when the store cannot make them.
		def provision(share Server, user string) !none {
			let base = cleanPath(home)
			try share.store.makeDir(base) unless exists(share, base)
			let own = base + "/" + user
			return none when exists(share, own)
			try share.store.makeDir(own)
			let url = share.userURL(user)
			share.setAcl(own, [
				Ace{principal: url, privileges: [Privilege.All]},
				Ace{principal: url, privileges: [Privilege.All], grant: false, invert: true}
			])
			if defaultBook != "" {
				try share.store.makeDir(own + "/" + defaultBook)
				share.setCollectionTypes(own + "/" + defaultBook, [cardNode("addressbook")])
			}
			return none
		}

		// property implements Extension: `addressbook-home-set` on a user
		// principal (making the home first), and on an address book
		// `supported-address-data`, `supported-collation-set` and
		// `max-resource-size`.
		def property(share Server, path string, name XMLNode) ?XMLNode {
			return none unless name.namespace == cardNamespace
			let user = share.principalUser(path)
			if user != "" {
				return none unless name.localName == "addressbook-home-set"
				provision(share, user) onerror recover none
				let n = cardNode(name.localName)
				n.add(davText("href", share.href(cleanPath(home) + "/" + user)))
				return n
			}
			return none unless isAddressBook(share, path)
			switch {
				case name.localName == "supported-address-data":
					let n = cardNode(name.localName)
					for let version in ["3.0", "4.0"] {
						let t = n.add(cardNode("address-data-type"))
						t.set("content-type", "text/vcard")
						t.set("version", version)
					}
					return n
				case name.localName == "supported-collation-set":
					let n = cardNode(name.localName)
					for let collation in ["i;ascii-casemap", "i;octet", "i;unicode-casemap"] {
						n.add(cardText("supported-collation", collation))
					}
					return n
				case name.localName == "max-resource-size" && maxSize > 0:
					return cardText(name.localName, maxSize.str())
			}
			return none
		}

		// propertyNames implements Extension.
		def propertyNames(share Server, path string) XMLNode[] {
			return [cardNode("addressbook-home-set")] when share.principalUser(path) != ""
			return [] unless isAddressBook(share, path)
			let names = [cardNode("supported-address-data"), cardNode("supported-collation-set")]
			names.push(cardNode("max-resource-size")) when maxSize > 0
			return names
		}

		// reports implements Extension: both reports, on address books
		// and what they hold.
		def reports(share Server, path string) XMLNode[] {
			return [] unless isAddressBook(share, path) || isAddressBook(share, parentPath(path))
			return [cardNode("addressbook-query"), cardNode("addressbook-multiget")]
		}

		// report implements Extension.
		// Fails when writing the answer fails.
		def report(share Server, ctx Context, path string, body XMLNode) !bool {
			if isCard(body, "addressbook-query") {
				try query(share, ctx, path, body)
				return true
			}
			if isCard(body, "addressbook-multiget") {
				try multiget(share, ctx, path, body)
				return true
			}
			return false
		}

		// request implements Extension: CardDAV adds no methods, so it
		// answers none and never fails.
		def request(share Server, ctx Context, method string, _ string) !bool {
			return false
		}

		// validate implements Extension: a member of an address book must
		// be one vCard 3.0 or 4.0 with a `UID` no other member has, within
		// `maxSize`.
		def validate(share Server, path string, contentType string, content byte[]) ?XMLNode {
			let parent = parentPath(path)
			return none unless isAddressBook(share, parent)
			let essence = contentType.split(";")[0].trim().lower()
			return cardNode("supported-address-data") unless essence := "" || "text/vcard" || "text/x-vcard" || "text/directory"
			return cardNode("max-resource-size") when maxSize > 0 && int64(content.len()) > maxSize
			let cards = new VCard().readCards(new bytes.Reader(content)) onerror recover ContactProperty[][]
			return cardNode("valid-address-data") unless cards.len() == 1
			return cardNode("supported-address-data") unless versionOf(cards[0]) := "3.0" || "4.0"
			let uid = uidOf(cards[0])
			return cardNode("valid-address-data") when uid == ""
			let name = baseOf(path)
			for let member in share.store.list(parent) onerror recover fs.FileEntry[] {
				continue when member.kind == fs.FileKind.Dir || member.name == name
				let other = parent + "/" + member.name
				let data = readFile(share.store, other) onerror recover byte[]
				let theirs = new VCard().readCards(new bytes.Reader(data)) onerror recover ContactProperty[][]
				if theirs.len() > 0 && uidOf(theirs[0]) == uid {
					let n = cardNode("no-uid-conflict")
					n.add(davText("href", share.href(other)))
					return n
				}
			}
			return none
		}

		// ---- internals ----

		// Whether `path` is an address book collection.
		internal def isAddressBook(share Server, path string) bool {
			for let t in share.collectionTypes(path) {
				return true when isCard(t, "addressbook")
			}
			return false
		}

		internal def exists(share Server, path string) bool {
			return statOf(share, path) onerror recover false
		}

		internal def entryOf(share Server, path string) !?fs.FileEntry {
			return try share.store.stat(path)
		}

		internal def statOf(share Server, path string) !bool {
			try share.store.stat(path)
			return true
		}

		// The address objects at `path` and, as `Depth` says, below it.
		internal def members(share Server, path string, depth int) string[] {
			let out string[] = []
			let entry = entryOf(share, path) onerror recover none
			return out when entry is none
			if entry.kind != fs.FileKind.Dir {
				out.push(path) when isAddressBook(share, parentPath(path))
				return out
			}
			return out when depth == 0
			for let child in share.store.list(path) onerror recover fs.FileEntry[] {
				let childPath = path == "/" ?? ("/" + child.name, path + "/" + child.name)
				if child.kind == fs.FileKind.Dir {
					out = out + members(share, childPath, depth < 0 ?? (-1, depth - 1)) when depth != 1
				} else if isAddressBook(share, path) {
					out.push(childPath)
				}
			}
			return out
		}

		// The properties a report asks for, and what it asks of
		// `address-data`; an unsupported address data form is refused.
		internal def wantedOf(body XMLNode) (XMLNode[], DataRequest) {
			let prop = body.child("prop", davNamespace)
			let wanted XMLNode[] = prop is none ?? (XMLNode[], prop.elements())
			let request = DataRequest{}
			for let w in wanted {
				request = dataRequestOf(w) when isCard(w, "address-data")
			}
			return (wanted, request)
		}

		// The `address-data` of a member, for `describe`.
		internal def lookupFor(share Server, path string, request DataRequest) def(XMLNode) ?XMLNode {
			return def (w XMLNode) ?XMLNode {
				return none unless isCard(w, "address-data")
				let data = readFile(share.store, path) onerror recover byte[]
				let text = addressData(data, request) onerror recover ""
				return cardText("address-data", text)
			}
		}

		// addressbook-query (RFC 6352 §8.6).
		internal def query(share Server, ctx Context, path string, body XMLNode) !none {
			let (wanted, request) = wantedOf(body)
			return try share.refuse(ctx, 403, cardNode("supported-address-data")) unless supported(request)
			let filter = CardFilter{}
			let filterNode = body.child("filter", cardNamespace)
			if !(filterNode is none) {
				let (parsed, problem) = parseFilter(filterNode)
				return try share.refuse(ctx, 403, cardNode(problem.condition)) unless problem is none
				filter = parsed
			}
			let limit = maxResults
			let limitNode = body.child("limit", cardNamespace)
			if !(limitNode is none) {
				let n = limitNode.child("nresults", cardNamespace)
				let asked = n is none ?? (0, n.text().trim().toInt<int>())
				limit = asked when asked > 0 && (limit == 0 || asked < limit)
			}
			let depthText = ctx.header("Depth").trim().lower()
			let depth = depthText == "infinity" ?? (-1, depthText == "1" ?? (1, 0))
			let responses XMLNode[] = []
			let truncated = false
			for let member in members(share, path, depth) {
				continue unless share.allows(ctx, member, Privilege.Read)
				let data = readFile(share.store, member) onerror recover byte[]
				let cards = new VCard().readCards(new bytes.Reader(data)) onerror recover ContactProperty[][]
				continue unless cards.len() == 1 && passes(filter, cards[0])
				if limit > 0 && responses.len() >= limit {
					truncated = true
					break
				}
				responses.push(share.describe(ctx, member, wanted, lookupFor(share, member, request)))
			}
			if truncated {
				let cut = share.statusResponse(share.href(path), 507)
				cut.add(davNode("error")).add(davNode("number-of-matches-within-limits"))
				responses.push(cut)
			}
			return try share.answer(ctx, responses)
		}

		// addressbook-multiget (RFC 6352 §8.7).
		internal def multiget(share Server, ctx Context, _ string, body XMLNode) !none {
			let (wanted, request) = wantedOf(body)
			return try share.refuse(ctx, 403, cardNode("supported-address-data")) unless supported(request)
			let responses XMLNode[] = []
			for let h in body.elements("href", davNamespace) {
				let href = h.text().trim()
				let found = share.pathOf(href)
				if found is none {
					responses.push(share.statusResponse(href, 404))
					continue
				}
				let member string = found
				if !share.allows(ctx, member, Privilege.Read) {
					responses.push(share.statusResponse(href, 403))
					continue
				}
				responses.push(share.describe(ctx, member, wanted, lookupFor(share, member, request)))
			}
			return try share.answer(ctx, responses)
		}
	}

	// A store path without a trailing slash, starting with one.
	internal def cleanPath(path string) string {
		let p = "/" + path.trim().trimPrefix("/").trimSuffix("/")
		return p
	}

	// The collection holding `path`.
	internal def parentPath(path string) string {
		let p = cleanPath(path)
		let at = lastSlash(p)
		return at <= 0 ?? ("/", string(p.bytes()[:at]))
	}

	// The last segment of `path`.
	internal def baseOf(path string) string {
		let p = cleanPath(path)
		return string(p.bytes()[lastSlash(p) + 1:])
	}

	// The index of the last `/` of a path.
	internal def lastSlash(path string) int {
		let b = path.bytes()
		for let i = b.len() - 1; i >= 0; i-- {
			return i when b[i] == byte('/')
		}
		return -1
	}
}
