internal partial module std.net.http.webdav.carddav.wire {
	use (
		std.bytes
		std.fs
		std.data.encoding::(XML, XMLNode)
		std.formats.contacts::(ContactProperty, VCard)
		std.net.http.webdav::(davNamespace)
		std.net.http.webdav.carddav::*
	)

	// The CardDAV parts both sides share: the query filter as XML and its
	// evaluation, address data conversion, and multistatus reading.

	// An element in the CardDAV namespace, written with the `C:` prefix.
	def cardNode(localName string) XMLNode {
		let n = new XMLNode("C:" + localName, cardNamespace)
		n.set("xmlns:C", cardNamespace)
		return n
	}

	// A CardDAV element holding text.
	def cardText(localName string, text string) XMLNode {
		let n = cardNode(localName)
		n.add(text)
		return n
	}

	// An element in the DAV: namespace, written with the `D:` prefix.
	def davNode(localName string) XMLNode {
		let n = new XMLNode("D:" + localName, davNamespace)
		n.set("xmlns:D", davNamespace)
		return n
	}

	// A DAV: element holding text.
	def davText(localName string, text string) XMLNode {
		let n = davNode(localName)
		n.add(text)
		return n
	}

	// An attribute of a node, "" when it has none.
	def attr(node XMLNode, name string) string {
		let value = node.attribute(name)
		return value is none ?? ("", value)
	}

	// Whether a node is the CardDAV element `localName`.
	def isCard(node XMLNode, localName string) bool {
		return node.namespace == cardNamespace && node.localName == localName
	}

	// ---- filters ----

	// A filter problem: the precondition element to answer with.
	struct FilterProblem {
		condition string
	}

	// Reads a `CARDDAV:filter`; a problem names the precondition it fails
	// (`supported-filter`, `supported-collation`).
	def parseFilter(node XMLNode) (CardFilter, ?FilterProblem) {
		let filter = CardFilter{all: attr(node, "test") == "allof"}
		for let child in node.elements() {
			return (filter, FilterProblem{condition: "supported-filter"}) unless isCard(child, "prop-filter")
			let name = child.attribute("name")
			return (filter, FilterProblem{condition: "supported-filter"}) when name is none || name == ""
			let pf = PropFilter{name: name.upper(), all: attr(child, "test") == "allof"}
			for let test in child.elements() {
				switch {
					case isCard(test, "is-not-defined"):
						pf.notDefined = true
					case isCard(test, "text-match"):
						let (tm, problem) = parseTextMatch(test)
						return (filter, problem) unless problem is none
						pf.texts.push(tm)
					case isCard(test, "param-filter"):
						let pname = test.attribute("name")
						return (filter, FilterProblem{condition: "supported-filter"}) when pname is none || pname == ""
						let param = ParamFilter{name: pname.upper()}
						for let inner in test.elements() {
							if isCard(inner, "is-not-defined") {
								param.notDefined = true
							} else if isCard(inner, "text-match") {
								let (tm, problem) = parseTextMatch(inner)
								return (filter, problem) unless problem is none
								param.text = tm
							} else {
								return (filter, FilterProblem{condition: "supported-filter"})
							}
						}
						pf.params.push(param)
					default:
						return (filter, FilterProblem{condition: "supported-filter"})
				}
			}
			filter.props.push(pf)
		}
		return (filter, none)
	}

	// Reads a `CARDDAV:text-match`.
	def parseTextMatch(node XMLNode) (TextMatch, ?FilterProblem) {
		let tm = TextMatch{text: node.text()}
		let collation = node.attribute("collation")
		if !(collation is none) {
			return (tm, FilterProblem{condition: "supported-collation"}) unless collation := "i;unicode-casemap" || "i;ascii-casemap" || "i;octet"
			tm.collation = collation
		}
		tm.negate = attr(node, "negate-condition") == "yes"
		let kind = node.attribute("match-type")
		if !(kind is none) {
			switch {
				case kind == "equals":
					tm.matchType = MatchType.Equals
				case kind == "contains":
					tm.matchType = MatchType.Contains
				case kind == "starts-with":
					tm.matchType = MatchType.StartsWith
				case kind == "ends-with":
					tm.matchType = MatchType.EndsWith
				default:
					return (tm, FilterProblem{condition: "supported-filter"})
			}
		}
		return (tm, none)
	}

	// A filter as a `CARDDAV:filter` element.
	def filterNode(filter CardFilter) XMLNode {
		let n = cardNode("filter")
		n.set("test", filter.all ?? ("allof", "anyof"))
		for let pf in filter.props {
			let p = n.add(cardNode("prop-filter"))
			p.set("name", pf.name)
			p.set("test", pf.all ?? ("allof", "anyof"))
			p.add(cardNode("is-not-defined")) when pf.notDefined
			for let tm in pf.texts {
				p.add(textMatchNode(tm))
			}
			for let param in pf.params {
				let q = p.add(cardNode("param-filter"))
				q.set("name", param.name)
				q.add(cardNode("is-not-defined")) when param.notDefined
				let text = param.text
				q.add(textMatchNode(text)) unless text is none
			}
		}
		return n
	}

	// A text match as a `CARDDAV:text-match` element.
	def textMatchNode(tm TextMatch) XMLNode {
		let n = cardText("text-match", tm.text)
		n.set("collation", tm.collation)
		n.set("match-type", tm.matchType.value)
		n.set("negate-condition", tm.negate ?? ("yes", "no"))
		return n
	}

	// Whether a card, as its properties, passes the filter.
	def passes(filter CardFilter, card ContactProperty[]) bool {
		return true when filter.props.len() == 0
		for let pf in filter.props {
			let ok = propPasses(pf, card)
			return true when ok && !filter.all
			return false when !ok && filter.all
		}
		return filter.all
	}

	// Whether a card passes a property filter: one occurrence of the
	// property passes its tests.
	def propPasses(pf PropFilter, card ContactProperty[]) bool {
		let found = card.filter(p => p.name == pf.name)
		return found.len() == 0 when pf.notDefined
		return false when found.len() == 0
		return true when pf.texts.len() == 0 && pf.params.len() == 0
		for let p in found {
			let results bool[] = []
			for let tm in pf.texts {
				results.push(textPasses(tm, unescape(p.value)))
			}
			for let param in pf.params {
				results.push(paramPasses(param, p))
			}
			let ok = pf.all
			for let r in results {
				if pf.all {
					ok = ok && r
				} else {
					ok = ok || r
				}
			}
			return true when ok
		}
		return false
	}

	// Whether a property passes a parameter filter.
	def paramPasses(param ParamFilter, p ContactProperty) bool {
		let values string[] = []
		let present = false
		for let q in p.params {
			continue unless q.name == param.name
			present = true
			values = values + q.values
		}
		return !present when param.notDefined
		let text = param.text
		return present when text is none
		for let v in values {
			return true when textPasses(text, v)
		}
		return false
	}

	// Whether a value passes a text match.
	def textPasses(tm TextMatch, value string) bool {
		let v = collate(value, tm.collation)
		let t = collate(tm.text, tm.collation)
		let hit = false
		switch {
			case tm.matchType == MatchType.Equals:
				hit = v == t
			case tm.matchType == MatchType.StartsWith:
				hit = v.startsWith(t)
			case tm.matchType == MatchType.EndsWith:
				hit = v.endsWith(t)
			default:
				hit = v.contains(t)
		}
		return tm.negate ?? (!hit, hit)
	}

	// A value folded as the collation compares it.
	def collate(text string, collation string) string {
		return text when collation == "i;octet"
		return text.lower() when collation == "i;unicode-casemap"
		let b = text.bytes()
		let out byte[] = []
		for let c in b {
			out.push((c >= byte('A') && c <= byte('Z')) ?? (c + byte(32), c))
		}
		return string(out)
	}

	// Text with vCard escapes undone.
	def unescape(text string) string {
		return text unless text.contains("\\")
		return text.replace("\\\\", "\u0001").replace("\\n", "\n").replace("\\N", "\n").replace("\\,", ",").replace("\\;", ";").replace("\\:", ":").replace("\u0001", "\\")
	}

	// ---- address data ----

	// What a client asked of `CARDDAV:address-data`: the version, and the
	// properties to keep (all when `names` is empty), those in `novalue`
	// without their values.
	struct DataRequest {
		contentType string   = "text/vcard"
		version     string   = "3.0"
		names       string[] = []
		novalue     string[] = []
	}

	// Reads an `address-data` element of a report's `prop`.
	def dataRequestOf(node XMLNode) DataRequest {
		let r = DataRequest{}
		let contentType = node.attribute("content-type")
		r.contentType = contentType.lower() unless contentType is none || contentType == ""
		let version = node.attribute("version")
		r.version = version unless version is none || version == ""
		for let p in node.elements("prop", cardNamespace) {
			let name = p.attribute("name")
			continue when name is none || name == ""
			r.names.push(name.upper())
			r.novalue.push(name.upper()) when attr(p, "novalue") == "yes"
		}
		return r
	}

	// Whether the server can give address data in the form asked.
	def supported(r DataRequest) bool {
		return (r.contentType := "text/vcard" || "text/x-vcard") && (r.version := "3.0" || "4.0")
	}

	// A stored vCard in the version asked, with only the properties
	// asked.
	// Fails when the vCard cannot be read.
	def addressData(data byte[], r DataRequest) !string {
		let codec = new VCard()
		let cards = try codec.readCards(new bytes.Reader(data))
		let stored = cards.len() > 0 ?? (versionOf(cards[0]), "")
		if stored != r.version {
			let contacts = try codec.read(new bytes.Reader(data))
			let converter = new VCard()
			converter.version = r.version
			let out = new bytes.Buffer()
			try converter.write(contacts, out)
			cards = try codec.readCards(new bytes.Reader(out.bytes()))
		}
		if r.names.len() > 0 {
			let kept ContactProperty[][]
			for let card in cards {
				let props ContactProperty[] = []
				for let p in card {
					// VERSION and UID are always part of a card.
					continue unless (p.name := "VERSION" || "UID") || r.names.includes(p.name)
					if r.novalue.includes(p.name) {
						props.push(ContactProperty{name: p.name, value: "", params: p.params, group: p.group})
					} else {
						props.push(p)
					}
				}
				kept.push(props)
			}
			cards = kept
		}
		let out = new bytes.Buffer()
		try codec.writeCards(cards, out)
		return string(out.bytes())
	}

	// The `VERSION` of a card, "" when it has none.
	def versionOf(card ContactProperty[]) string {
		for let p in card {
			return p.value.trim() when p.name == "VERSION"
		}
		return ""
	}

	// The `UID` of a card, "" when it has none.
	def uidOf(card ContactProperty[]) string {
		for let p in card {
			return p.value.trim() when p.name == "UID"
		}
		return ""
	}

	// The whole of a file of a store.
	// Fails when the file cannot be read.
	def readFile(store fs.FileStore, path string) !byte[] {
		let reader = try store.open(path, int64(0))
		let out = new bytes.Buffer()
		let failed ?error = none
		out.readFrom(reader) onerror (err error) {
			failed = err
			recover int64(0)
		}
		reader.close() onerror recover none
		fail failed unless failed is none
		return out.bytes()
	}

	// ---- multistatus ----

	// One response of a multistatus as a client reads it: the href, its
	// own status, and each property found (status 200) by `ns local`.
	struct Answer {
		href   string
		status int                  = 200
		props  map<string, XMLNode> = map<string, XMLNode>{}
	}

	// The responses of a multistatus body.
	// Fails when the body is not XML.
	def answersOf(data byte[]) !Answer[] {
		let root = try new XML().parse(data)
		let out Answer[] = []
		for let r in root.elements("response", davNamespace) {
			let href = r.child("href", davNamespace)
			continue when href is none
			let a = Answer{href: href.text().trim()}
			let own = r.child("status", davNamespace)
			a.status = statusOf(own.text()) unless own is none
			for let ps in r.elements("propstat", davNamespace) {
				let status = ps.child("status", davNamespace)
				continue unless status is none || statusOf(status.text()) == 200
				let prop = ps.child("prop", davNamespace)
				continue when prop is none
				for let p in prop.elements() {
					a.props[p.namespace + " " + p.localName] = p
				}
			}
			out.push(a)
		}
		return out
	}

	// The code of a status line (`HTTP/1.1 404 Not Found`).
	def statusOf(line string) int {
		let parts = line.trim().split(" ")
		return 0 unless parts.len() >= 2 && parts[1].isNumeric()
		return parts[1].toInt<int>()
	}

	// The text of a property of an answer, "" when it was not found.
	def textOf(a Answer, namespace string, localName string) string {
		let p = a.props.get(namespace + " " + localName)
		return p is none ?? ("", p.text().trim())
	}

	// Whether an answer's `resourcetype` holds the element.
	def hasType(a Answer, namespace string, localName string) bool {
		let p = a.props.get(davNamespace + " resourcetype")
		return false when p is none
		return !(p.child(localName, namespace) is none)
	}

	// The first `href` inside a property of an answer, "" when none.
	def hrefIn(a Answer, namespace string, localName string) string {
		let p = a.props.get(namespace + " " + localName)
		return "" when p is none
		let href = p.child("href", davNamespace)
		return href is none ?? ("", href.text().trim())
	}
}
