internal partial module std.net.http.webdav.proto {
	use (
		std.data.encoding::(XMLNode)
		std.net.http.webdav::(Ace, Privilege, davNamespace)
	)

	// WebDAV Access Control (RFC 3744): privileges and how they
	// aggregate, access control entries as XML, the ACL and owner of each
	// resource, the principals, and the decision whether a user holds a
	// privilege.

	const allPrivileges = [Privilege.All, Privilege.Read, Privilege.Write, Privilege.WriteProperties, Privilege.WriteContent, Privilege.Bind, Privilege.Unbind, Privilege.Unlock, Privilege.ReadAcl, Privilege.ReadCurrentUserPrivilegeSet, Privilege.WriteAcl]

	// The privileges `p` holds directly (RFC 3744 §3.12).
	def privilegeChildren(p Privilege) Privilege[] {
		match p {
			case Privilege.All:
				return [Privilege.Read, Privilege.Write, Privilege.Unlock, Privilege.ReadAcl, Privilege.ReadCurrentUserPrivilegeSet, Privilege.WriteAcl]
			case Privilege.Write:
				return [Privilege.WriteProperties, Privilege.WriteContent, Privilege.Bind, Privilege.Unbind]
			default:
				return []
		}
	}

	// Whether holding `held` means holding `wanted`.
	def privilegeCovers(held Privilege, wanted Privilege) bool {
		return true when held == wanted
		for let c in privilegeChildren(held) {
			return true when privilegeCovers(c, wanted)
		}
		return false
	}

	// The privilege a DAV: element names; none for one this server does
	// not know.
	def privilegeNamed(name string) ?Privilege {
		for let p in allPrivileges {
			return p when p.value == name
		}
		return none
	}

	// The `DAV:supported-privilege-set` (RFC 3744 §5.3): the tree of
	// privileges with their descriptions.
	def supportedPrivilegeSet() XMLNode {
		let root = davNode("supported-privilege-set")
		root.add(supportedPrivilege(Privilege.All))
		return root
	}

	internal def supportedPrivilege(p Privilege) XMLNode {
		let n = davNode("supported-privilege")
		n.add(davNode("privilege")).add(davNode(p.value))
		let d = n.add(davText("description", privilegeDescription(p)))
		d.set("xml:lang", "en")
		for let c in privilegeChildren(p) {
			n.add(supportedPrivilege(c))
		}
		return n
	}

	internal def privilegeDescription(p Privilege) string {
		match p {
			case Privilege.All:
				return "Any operation"
			case Privilege.Read:
				return "Read the content and properties"
			case Privilege.Write:
				return "Write the content, properties and members"
			case Privilege.WriteProperties:
				return "Write properties"
			case Privilege.WriteContent:
				return "Write the content"
			case Privilege.Bind:
				return "Add members"
			case Privilege.Unbind:
				return "Remove members"
			case Privilege.Unlock:
				return "Remove another principal's lock"
			case Privilege.ReadAcl:
				return "Read the access control list"
			case Privilege.ReadCurrentUserPrivilegeSet:
				return "Read the current user's privileges"
			default:
				return "Write the access control list"
		}
	}

	// An ACE as `DAV:ace` (RFC 3744 §5.5).
	def aceNode(ace Ace) XMLNode {
		let n = davNode("ace")
		let principal = davNode("principal")
		switch {
			case ace.principal := "all" || "authenticated" || "unauthenticated" || "self":
				principal.add(davNode(ace.principal))
			case ace.principal == "owner":
				principal.add(davNode("property")).add(davNode("owner"))
			default:
				principal.add(davText("href", ace.principal))
		}
		if ace.invert {
			n.add(davNode("invert")).add(principal)
		} else {
			n.add(principal)
		}
		let decision = n.add(davNode(ace.grant ?? ("grant", "deny")))
		for let p in ace.privileges {
			decision.add(davNode("privilege")).add(davNode(p.value))
		}
		n.add(davNode("protected")) when ace.protected
		n.add(davNode("inherited")).add(davText("href", ace.inherited)) when ace.inherited != ""
		return n
	}

	// Reads a `DAV:ace`: the entry, or the precondition it breaks
	// (`not-supported-privilege`, `recognized-principal`), or "" with no
	// entry when it is malformed.
	def parseAce(node XMLNode) (?Ace, string) {
		let invert = node.child("invert", davNamespace)
		let holder = invert is none ?? (node, invert)
		let principal = holder.child("principal", davNamespace)
		return (none, "") when principal is none
		let who = ""
		let parts = principal.elements()
		return (none, "") unless parts.len() == 1
		let part = parts[0]
		return (none, "recognized-principal") unless part.namespace == davNamespace
		switch {
			case part.localName := "all" || "authenticated" || "unauthenticated" || "self":
				who = part.localName
			case part.localName == "href":
				who = part.text().trim()
			case part.localName == "property":
				let owner = part.child("owner", davNamespace)
				return (none, "recognized-principal") when owner is none
				who = "owner"
			default:
				return (none, "recognized-principal")
		}
		let grant = node.child("grant", davNamespace)
		let deny = node.child("deny", davNamespace)
		return (none, "") when (grant is none) == (deny is none)
		let decision = new XMLNode("")
		if !(grant is none) {
			decision = grant
		} else if !(deny is none) {
			decision = deny
		}
		let privileges Privilege[] = []
		for let p in decision.elements("privilege", davNamespace) {
			for let named in p.elements() {
				let known = privilegeNamed(named.localName)
				return (none, "not-supported-privilege") when known is none || named.namespace != davNamespace
				privileges.push(known)
			}
		}
		return (none, "") when privileges.len() == 0
		return (Ace{principal: who, privileges: privileges, grant: !(grant is none), invert: !(invert is none)}, "")
	}

	// A `DAV:acl` of some entries.
	def aclNode(aces Ace[]) XMLNode {
		let n = davNode("acl")
		for let ace in aces {
			n.add(aceNode(ace))
		}
		return n
	}

	// A `DAV:current-user-privilege-set`.
	def privilegeSet(held Privilege[]) XMLNode {
		let n = davNode("current-user-privilege-set")
		for let p in held {
			n.add(davNode("privilege")).add(davNode(p.value))
		}
		return n
	}

	// A `need-privileges` error body (RFC 3744 §7.1.1): the privilege
	// missing on each resource.
	def needPrivileges(hrefs string[], privileges Privilege[]) byte[] {
		let root = davNode("error")
		root.set("xmlns:D", davNamespace)
		let need = root.add(davNode("need-privileges"))
		for let i = 0; i < hrefs.len(); i++ {
			let r = need.add(davNode("resource"))
			r.add(davText("href", hrefs[i]))
			r.add(davNode("privilege")).add(davNode(privileges[i].value))
		}
		return document(root)
	}

	// Who is asking: the principal URLs they are (their own and those of
	// the groups they belong to), or none of them when unauthenticated.
	struct Asker {
		authenticated bool     = false
		principals    string[] = []
	}

	// Whether `asker` holds `wanted` under `aces` (RFC 3744 §6): the first
	// entry that applies to them and names a privilege holding `wanted`
	// decides; none that does denies. `owner` is the URL of the
	// resource's owner, `self` the resource's own URL when it is a
	// principal ("" otherwise).
	def aclAllows(aces Ace[], wanted Privilege, asker Asker, owner string, self_ string) bool {
		for let ace in aces {
			continue unless aceApplies(ace, asker, owner, self_)
			for let p in ace.privileges {
				return ace.grant when privilegeCovers(p, wanted)
			}
		}
		return false
	}

	internal def aceApplies(ace Ace, asker Asker, owner string, self_ string) bool {
		let matches = false
		switch {
			case ace.principal == "all":
				matches = true
			case ace.principal == "authenticated":
				matches = asker.authenticated
			case ace.principal == "unauthenticated":
				matches = !asker.authenticated
			case ace.principal == "self":
				matches = self_ != "" && asker.principals.includes(self_)
			case ace.principal == "owner":
				matches = owner != "" && asker.principals.includes(owner)
			default:
				matches = asker.principals.includes(ace.principal)
		}
		return matches != ace.invert
	}

	// The privileges `asker` holds, aggregates included when every
	// privilege they hold is held.
	def heldPrivileges(aces Ace[], asker Asker, owner string, self_ string) Privilege[] {
		let out Privilege[] = []
		for let p in allPrivileges {
			out.push(p) when holdsAll(aces, p, asker, owner, self_)
		}
		return out
	}

	internal def holdsAll(aces Ace[], p Privilege, asker Asker, owner string, self_ string) bool {
		return false unless aclAllows(aces, p, asker, owner, self_)
		for let c in privilegeChildren(p) {
			return false unless holdsAll(aces, c, asker, owner, self_)
		}
		return true
	}

	// AclTable keeps each resource's own ACL and owner. Paths are store
	// paths.
	type AclTable {
		internal atomic acls   map<string, Ace[]>
		internal atomic owners map<string, string>
		// The principal URL that took each lock.
		internal atomic lockers map<string, string>

		def new() {}

		// The principal URL that took a lock; "".
		atomic def lockerOf(token string) string {
			let l = lockers.get(token)
			return l is none ?? ("", l)
		}

		// Records who took a lock; "" forgets it.
		atomic def setLocker(token string, href string) {
			if href == "" {
				lockers.delete(token)
			} else {
				lockers[token] = href
			}
		}

		// The resource's own entries; none when it has none of its own.
		atomic def own(path string) ?Ace[] {
			return acls.get(path)
		}

		atomic def set(path string, aces Ace[]) {
			acls[path] = aces
		}

		// The URL of the resource's owner; "" when it has none.
		atomic def ownerOf(path string) string {
			let o = owners.get(path)
			return o is none ?? ("", o)
		}

		atomic def setOwner(path string, href string) {
			owners[path] = href
		}

		// Forgets `path` and everything below it.
		atomic def dropUnder(path string) {
			let keptAcls = map<string, Ace[]>{}
			for let (p, aces) in acls {
				keptAcls[p] = aces unless within(p, path)
			}
			acls = keptAcls
			let keptOwners = map<string, string>{}
			for let (p, o) in owners {
				keptOwners[p] = o unless within(p, path)
			}
			owners = keptOwners
		}

		// Moves the ACLs and owners of `from` and below to `to` (a MOVE
		// keeps them, RFC 3744 §7.3).
		atomic def carry(from string, to string) {
			let movedAcls = map<string, Ace[]>{}
			let keptAcls = map<string, Ace[]>{}
			for let (p, aces) in acls {
				if within(p, from) {
					movedAcls[cleanStorePath(to + p[from.len():])] = aces
				} else if !within(p, to) {
					keptAcls[p] = aces
				}
			}
			for let (p, aces) in movedAcls {
				keptAcls[p] = aces
			}
			acls = keptAcls
			let movedOwners = map<string, string>{}
			let keptOwners = map<string, string>{}
			for let (p, o) in owners {
				if within(p, from) {
					movedOwners[cleanStorePath(to + p[from.len():])] = o
				} else if !within(p, to) {
					keptOwners[p] = o
				}
			}
			for let (p, o) in movedOwners {
				keptOwners[p] = o
			}
			owners = keptOwners
		}
	}

	// Principals keeps the users and groups a share knows, by name.
	// Group members are principal URLs; `base` is the URL the principals
	// live under: `{base}/users/{name}`, `{base}/groups/{name}`.
	type Principals {
		internal atomic users  map<string, string>
		internal atomic groups map<string, string[]>
		internal atomic names  map<string, string>

		def new() {}

		// Adds or renames a user.
		atomic def addUser(name string, displayName string) {
			users[name] = displayName
		}

		// Adds a user not known yet.
		atomic def meet(name string) {
			users[name] = "" unless users.hasKey(name)
		}

		// Adds or replaces a group of member URLs (users and groups).
		atomic def addGroup(name string, displayName string, members string[]) {
			groups[name] = members
			names[name] = displayName
		}

		atomic def hasUser(name string) bool {
			return users.hasKey(name)
		}

		atomic def hasGroup(name string) bool {
			return groups.hasKey(name)
		}

		atomic def userNames() string[] {
			let out string[] = []
			for let (n, _) in users {
				out.push(n)
			}
			return out.sort((a, b) => a < b)
		}

		atomic def groupNames() string[] {
			let out string[] = []
			for let (n, _) in groups {
				out.push(n)
			}
			return out.sort((a, b) => a < b)
		}

		// The display name of a user (`kind` users) or group; the name
		// when none was given.
		atomic def displayNameOf(kind string, name string) string {
			let shown = kind == "users" ?? (users.get(name), names.get(name))
			return (shown is none || shown == "") ?? (name, shown)
		}

		// The member URLs of a group.
		atomic def membersOf(name string) string[] {
			let found = groups.get(name)
			return found is none ?? (string[], found.clone())
		}

		// The URLs of the groups `href` belongs to directly.
		atomic def groupsHolding(base string, href string) string[] {
			let out string[] = []
			for let (n, members) in groups {
				out.push("{base}/groups/{n}") when members.includes(href)
			}
			return out.sort((a, b) => a < b)
		}

		// `href` and every group it belongs to, directly or through other
		// groups.
		def closure(base string, href string) string[] {
			let out = [href]
			for let i = 0; i < out.len(); i++ {
				for let g in groupsHolding(base, out[i]) {
					out.push(g) unless out.includes(g)
				}
			}
			return out
		}

		// Who is asking: `user` ("" when the authentication named no one)
		// or no one when unauthenticated.
		def askerFor(base string, authenticated bool, user string) Asker {
			return Asker{} unless authenticated
			return Asker{authenticated: true} when user == ""
			return Asker{authenticated: true, principals: closure(base, "{base}/users/{user}")}
		}
	}
}
