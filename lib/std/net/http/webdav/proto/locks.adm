internal partial module std.net.http.webdav.proto {
	use (
		std.crypto::(UUID)
		std.net.http.webdav::(Lock)
		std.time
	)

	// Write locks (RFC 4918 §6–7) and the `If` header (§10.4).

	// The locks a server holds, by token.
	type LockTable {
		internal locks map<string, Lock>

		def new() {}

		// The live locks, expired ones dropped.
		atomic def all() Lock[] {
			let now = time.now()
			let kept map<string, Lock> = map<string, Lock>{}
			let out Lock[] = []
			for let (token, l) in locks {
				let ends = l.expires
				continue when !(ends is none) && now.after(ends)
				kept[token] = l
				out.push(l)
			}
			locks = kept
			return out
		}

		// The locks that cover `path`: on it, or on an ancestor with
		// depth infinity.
		def covering(path string) Lock[] {
			let out Lock[] = []
			for let l in all() {
				out.push(l) when l.path == path || (l.depth != 0 && within(path, l.path))
			}
			return out
		}

		// The locks on `path` or anywhere under it.
		def under(path string) Lock[] {
			let out Lock[] = []
			for let l in all() {
				out.push(l) when within(l.path, path)
			}
			return out
		}

		// Takes a new lock unless one conflicts: an exclusive lock
		// conflicts with any other covering or (for depth infinity) under
		// the path, a shared one with exclusive ones only. Returns none on
		// a conflict.
		atomic def take(path string, exclusive bool, depth int, owner string, timeout duration) ?Lock {
			let now = time.now()
			for let (_, l) in locks {
				let ends = l.expires
				continue when !(ends is none) && now.after(ends)
				let overlaps = l.path == path || (l.depth != 0 && within(path, l.path)) || (depth != 0 && within(l.path, path))
				continue unless overlaps
				return none when exclusive || l.exclusive
			}
			let token = "opaquelocktoken:" + new UUID().str()
			let l = Lock{token: token, path: path, exclusive: exclusive, depth: depth, owner: owner, timeout: timeout}
			l.expires = now + timeout when timeout > 0s
			locks[token] = l
			return l
		}

		// Restarts a lock's timeout. Returns none for an unknown token.
		atomic def refresh(token string, timeout duration) ?Lock {
			let found = locks.get(token)
			return none when found is none
			let l = Lock{...found, timeout: timeout}
			l.expires = timeout > 0s ?? (time.now() + timeout, none)
			locks[token] = l
			return l
		}

		atomic def release(token string) bool {
			let had = locks.hasKey(token)
			locks.delete(token)
			return had
		}

		// Drops every lock on `path` or under it (a DELETE or the source of
		// a MOVE).
		atomic def dropUnder(path string) {
			let kept map<string, Lock> = map<string, Lock>{}
			for let (token, l) in locks {
				kept[token] = l unless within(l.path, path)
			}
			locks = kept
		}
	}

	// One condition of an `If` list: a state token or an entity tag,
	// perhaps negated.
	struct IfCondition {
		negated bool   = false
		token   string = ""
		etag    string = ""
	}

	// One list of an `If` header, tagged with a resource or not.
	struct IfList {
		resource   string        = ""
		conditions IfCondition[] = []
	}

	// The lists of an `If` header; empty for none. Fails on a malformed
	// header.
	def parseIf(text string) !IfList[] {
		let out IfList[] = []
		let s = text.trim()
		let at = 0
		let tag = ""
		for at < s.len() {
			let c = s[at]
			if c := ' ' || '\t' {
				at++
				continue
			}
			if c == '<' {
				let end = s.indexOf(">", at)
				fail "unterminated resource tag" when end < 0
				tag = s[at + 1:end]
				at = end + 1
				continue
			}
			fail "expected ( in If header" unless c == '('
			let end = s.indexOf(")", at)
			fail "unterminated list in If header" when end < 0
			let list = IfList{resource: tag}
			let body = s[at + 1:end].trim()
			let i = 0
			for i < body.len() {
				let ch = body[i]
				if ch := ' ' || '\t' {
					i++
					continue
				}
				let negated = false
				if body[i:].startsWith("Not") || body[i:].startsWith("not") {
					negated = true
					i += 3
					continue unless i < body.len()
					for i < body.len() && (body[i] == ' ' || body[i] == '\t') {
						i++
					}
				}
				if body[i] == '<' {
					let close = body.indexOf(">", i)
					fail "unterminated state token" when close < 0
					list.conditions.push(IfCondition{negated: negated, token: body[i + 1:close]})
					i = close + 1
				} else if body[i] == '[' {
					let close = body.indexOf("]", i)
					fail "unterminated entity tag" when close < 0
					list.conditions.push(IfCondition{negated: negated, etag: body[i + 1:close]})
					i = close + 1
				} else {
					fail "unexpected {body[i:]} in If header"
				}
			}
			out.push(list)
			at = end + 1
		}
		return out
	}

	// Every state token an `If` header submits.
	def submittedTokens(lists IfList[]) string[] {
		let out string[] = []
		for let l in lists {
			for let c in l.conditions {
				out.push(c.token) when c.token != "" && !c.negated
			}
		}
		return out
	}
}
