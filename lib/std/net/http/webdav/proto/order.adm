internal partial module std.net.http.webdav.proto {
	// Ordered collections (RFC 3648): a collection whose ordering type is
	// `DAV:custom` lists its members in the order clients set, with
	// `Position` headers and ORDERPATCH.

	const orderingUnordered = "DAV:unordered"
	const orderingCustom = "DAV:custom"

	// Where a member goes (RFC 3648 §6.1): first, last, or before or
	// after another member.
	struct Position {
		kind    string = "last"
		segment string = ""
	}

	// parsePosition reads a `Position` header: `first`, `last`,
	// `before "x"`, `after "x"`. None when the header does not parse.
	def parsePosition(header string) ?Position {
		let text = header.trim()
		let lower = text.lower()
		return Position{kind: "first"} when lower == "first"
		return Position{kind: "last"} when lower == "last"
		for let kind in ["before", "after"] {
			if lower.startsWith(kind + " ") {
				let rest = text[kind.len():].trim()
				return none unless rest.len() >= 2 && rest.startsWith("\"") && rest.endsWith("\"")
				return Position{kind: kind, segment: rest[1:rest.len() - 1]}
			}
		}
		return none
	}

	// OrderTable keeps the ordering type of each collection and, for
	// custom ones, the order of their members' names.
	type OrderTable {
		internal atomic types  map<string, string>
		internal atomic orders map<string, string[]>

		def new() {}

		// The ordering type of a collection: DAV:unordered unless set.
		atomic def typeOf(dir string) string {
			let t = types.get(dir)
			return t is none ?? (orderingUnordered, t)
		}

		atomic def setType(dir string, kind string) {
			types[dir] = kind
			orders.delete(dir) when kind == orderingUnordered
		}

		// The names of a collection's members in order: the ones placed,
		// then the rest by name.
		atomic def arrange(dir string, names string[]) string[] {
			let known = orders.get(dir)
			let sorted = names.sort((a, b) => a < b)
			return sorted when known is none
			let out string[] = []
			for let n in known {
				out.push(n) when names.includes(n)
			}
			for let n in sorted {
				out.push(n) unless out.includes(n)
			}
			return out
		}

		// Puts `name` in `dir`'s order at `spot`. Fails when the segment
		// a position is relative to is not a member.
		atomic def place(dir string, name string, spot Position, members string[]) !none {
			if !types.hasKey(dir) || types[dir] == orderingUnordered {
				return none
			}
			let current = orders.get(dir)
			let list = current is none ?? (members.sort((a, b) => a < b), current.clone())
			for let m in members {
				list.push(m) unless list.includes(m)
			}
			list = list.filter(n => n != name)
			switch {
				case spot.kind == "first":
					list = [name] + list
				case spot.kind == "last":
					list.push(name)
				default:
					let at = -1
					for let i = 0; i < list.len(); i++ {
						at = i when list[i] == spot.segment
					}
					fail "position names {spot.segment}, which is not a member" when at < 0
					let insertAt = spot.kind == "before" ?? (at, at + 1)
					list = list[:insertAt] + [name] + list[insertAt:]
			}
			orders[dir] = list
			return none
		}

		// Forgets a member.
		atomic def drop(dir string, name string) {
			let current = orders.get(dir)
			return when current is none
			orders[dir] = current.filter(n => n != name)
		}

		// Forgets a collection and everything below it.
		atomic def dropUnder(path string) {
			let keptTypes = map<string, string>{}
			for let (dir, kind) in types {
				keptTypes[dir] = kind unless within(dir, path)
			}
			types = keptTypes
			let keptOrders = map<string, string[]>{}
			for let (dir, list) in orders {
				keptOrders[dir] = list unless within(dir, path)
			}
			orders = keptOrders
		}

		// Carries the ordering of `from` and the collections below it to
		// `to`.
		atomic def carry(from string, to string, keepSource bool) {
			let movedTypes = map<string, string>{}
			let movedOrders = map<string, string[]>{}
			for let (dir, kind) in types {
				movedTypes[cleanStorePath(to + dir[from.len():])] = kind when within(dir, from)
			}
			for let (dir, list) in orders {
				movedOrders[cleanStorePath(to + dir[from.len():])] = list when within(dir, from)
			}
			if !keepSource {
				let keptTypes = map<string, string>{}
				for let (dir, kind) in types {
					keptTypes[dir] = kind unless within(dir, from)
				}
				types = keptTypes
				let keptOrders = map<string, string[]>{}
				for let (dir, list) in orders {
					keptOrders[dir] = list unless within(dir, from)
				}
				orders = keptOrders
			}
			for let (dir, kind) in movedTypes {
				types[dir] = kind
			}
			for let (dir, list) in movedOrders {
				orders[dir] = list
			}
		}
	}
}
