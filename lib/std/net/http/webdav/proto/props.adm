internal partial module std.net.http.webdav.proto {
	use (
		std.data.encoding::(XMLNode)
	)

	// Dead properties (RFC 4918 §4): what clients stored with PROPPATCH,
	// by path, kept as standalone XML so any namespace round-trips.
	type DeadProps {
		internal byPath map<string, map<string, XMLNode>>

		def new() {}

		// The key of a property: namespace and local name.
		def keyOf(namespace string, name string) string {
			return namespace + " " + name
		}

		atomic def of(path string) XMLNode[] {
			let found = byPath.get(path)
			return [] when found is none
			let out XMLNode[] = []
			for let (_, node) in found {
				out.push(node)
			}
			return out
		}

		atomic def find(path string, namespace string, name string) ?XMLNode {
			let found = byPath.get(path)
			return none when found is none
			return found.get(keyOf(namespace, name))
		}

		atomic def put(path string, node XMLNode) {
			let found = byPath.get(path)
			let props = found is none ?? (map<string, XMLNode>{}, found)
			props[keyOf(node.namespace, node.localName)] = standalone(node)
			byPath[path] = props
		}

		atomic def drop(path string, namespace string, name string) {
			let found = byPath.get(path)
			return when found is none
			found.delete(keyOf(namespace, name))
			byPath[path] = found
		}

		// Every property of `path` and the paths under it, moved or copied
		// to the same places under `to`.
		atomic def carry(from string, to string, keepSource bool) {
			let moved map<string, map<string, XMLNode>> = map<string, map<string, XMLNode>>{}
			for let (path, props) in byPath {
				continue unless within(path, from)
				let target = to + path[from.len():]
				target = cleanStorePath(target)
				moved[target] = props
			}
			dropUnderLocked(from) unless keepSource
			for let (path, props) in moved {
				byPath[path] = props
			}
		}

		atomic def dropUnder(path string) {
			dropUnderLocked(path)
		}

		internal def dropUnderLocked(path string) {
			let kept map<string, map<string, XMLNode>> = map<string, map<string, XMLNode>>{}
			for let (p, props) in byPath {
				kept[p] = props unless within(p, path)
			}
			byPath = kept
		}
	}
}
