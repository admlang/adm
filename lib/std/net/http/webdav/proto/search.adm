internal partial module std.net.http.webdav.proto {
	use (
		std.data.encoding::(XMLNode)
		std.net.http.webdav::(davNamespace)
		std.time
	)

	// DAV Searching and Locating (RFC 5323): the `DAV:basicsearch`
	// grammar, parsed into a SearchQuery and evaluated resource by
	// resource with SQL's three-valued logic.

	const xmlNamespace = "http://www.w3.org/XML/1998/namespace"
	const xsdNamespace = "http://www.w3.org/2001/XMLSchema"

	// Truth values of a condition (RFC 5323 Appendix A).
	enum Truth {
		False
		True
		Unknown
	}

	// One `DAV:scope`: a store path and how deep below it to look (-1
	// for infinity).
	struct SearchScope {
		href  string
		path  ?string
		depth int     = -1
	}

	// One `DAV:order` key of `DAV:orderby`: a property, or the score.
	struct SearchOrder {
		prop       ?XMLNode
		descending bool     = false
		caseless   bool     = false
	}

	// SearchQuery is a parsed `DAV:basicsearch`.
	type SearchQuery {
		// `allprop` or `prop`.
		mode      string        = "prop"
		wanted    XMLNode[]     = []
		scopes    SearchScope[] = []
		// The one condition of `DAV:where`; none matches everything.
		condition ?XMLNode      = none
		orders    SearchOrder[] = []
		// Most results to return, -1 for all.
		limit     int           = -1

		def new() {}
	}

	// A search that cannot be run: the status to answer and the
	// precondition that failed ("" for a plain 400).
	struct SearchProblem {
		status    int
		condition string = ""
		message   string = ""
	}

	// The operators of `DAV:where` this server evaluates.
	const searchOperators = ["and", "or", "not", "eq", "lt", "lte", "gt", "gte", "like", "is-collection", "is-defined", "contains", "language-defined", "language-matches"]

	// parseSearch reads a `DAV:searchrequest` sent to `requestPath`
	// (mounted under `prefix`): the query, or the problem to answer.
	def parseSearch(root XMLNode, requestPath string, prefix string) (?SearchQuery, ?SearchProblem) {
		if !(root.namespace == davNamespace && root.localName == "searchrequest") {
			return (none, SearchProblem{status: 400, message: "the SEARCH body is not a searchrequest"})
		}
		let grammar = root.child("basicsearch", davNamespace)
		if grammar is none {
			return (none, SearchProblem{status: 422, condition: "search-grammar-supported"})
		}
		let q = new SearchQuery()
		let selection = grammar.child("select", davNamespace)
		if selection is none {
			return (none, SearchProblem{status: 400, message: "the search has no select"})
		}
		if selection.child("allprop", davNamespace) is none {
			let prop = selection.child("prop", davNamespace)
			return (none, SearchProblem{status: 400, message: "the select names nothing"}) when prop is none
			q.wanted = prop.elements()
		} else {
			q.mode = "allprop"
		}
		let from = grammar.child("from", davNamespace)
		let scopes = from is none ?? (XMLNode[], from.elements("scope", davNamespace))
		return (none, SearchProblem{status: 400, message: "the search has no scope"}) when scopes.len() == 0
		for let s in scopes {
			let hrefNode = s.child("href", davNamespace)
			return (none, SearchProblem{status: 400, message: "a scope has no href"}) when hrefNode is none
			let href = hrefNode.text().trim()
			let depthNode = s.child("depth", davNamespace)
			let depthText = depthNode is none ?? ("infinity", depthNode.text().trim().lower())
			if !(depthText := "0" || "1" || "infinity") {
				return (none, SearchProblem{status: 400, message: "bad scope depth {depthText}"})
			}
			let absolute = href.startsWith("/") || href.contains("://")
			let target = absolute ?? (href, hrefOf(prefix, requestPath, true) + href)
			q.scopes.push(SearchScope{
				href:  href,
				path:  pathOfHref(target, prefix),
				depth: depthText == "infinity" ?? (-1, depthText.toInt<int>())
			})
		}
		let whereNode = grammar.child("where", davNamespace)
		if !(whereNode is none) {
			let conditions = whereNode.elements()
			return (none, SearchProblem{status: 400, message: "the where clause holds one condition"}) unless conditions.len() == 1
			let bad = unsupportedOperator(conditions[0])
			return (none, SearchProblem{status: 422, condition: "search-grammar-supported", message: "unsupported operator {bad}"}) when bad != ""
			q.condition = conditions[0]
		}
		let orderby = grammar.child("orderby", davNamespace)
		if !(orderby is none) {
			for let o in orderby.elements("order", davNamespace) {
				let key = SearchOrder{
					descending: !(o.child("descending", davNamespace) is none),
					caseless:   caselessOf(o)
				}
				let prop = o.child("prop", davNamespace)
				if !(prop is none) {
					let names = prop.elements()
					return (none, SearchProblem{status: 400, message: "an order names one property"}) unless names.len() == 1
					key.prop = names[0]
				} else if o.child("score", davNamespace) is none {
					return (none, SearchProblem{status: 400, message: "an order names a property or the score"})
				}
				q.orders.push(key)
			}
		}
		let limitNode = grammar.child("limit", davNamespace)
		if !(limitNode is none) {
			let n = limitNode.child("nresults", davNamespace)
			let text = n is none ?? ("", n.text().trim())
			return (none, SearchProblem{status: 400, message: "bad nresults"}) unless text.len() > 0 && text.isNumeric()
			q.limit = text.toInt<int>()
		}
		return (q, none)
	}

	// The first operator of a condition this server does not know; "".
	internal def unsupportedOperator(node XMLNode) string {
		return "{node.namespace} {node.localName}" unless node.namespace == davNamespace && searchOperators.includes(node.localName)
		if node.localName := "and" || "or" || "not" {
			for let c in node.elements() {
				let bad = unsupportedOperator(c)
				return bad when bad != ""
			}
		}
		return ""
	}

	// The `caseless` attribute: yes, else no.
	internal def caselessOf(node XMLNode) bool {
		let v = node.attribute("caseless")
		return !(v is none) && v.lower() == "yes"
	}

	// SearchSubject is one resource a condition is evaluated against:
	// how to read its properties and, for `DAV:contains`, its content.
	type SearchSubject {
		path                string
		internal lookup     def(XMLNode) ?XMLNode
		internal collection bool
		internal read       def() ?string
		internal loaded     bool                  = false
		internal text       ?string               = none
		// The `DAV:contains` score, once evaluated.
		score               int                   = 0

		def new(path string, collection bool, lookup def(XMLNode) ?XMLNode, read def() ?string) {
			self.path = path
			self.collection = collection
			self.lookup = lookup
			self.read = read
		}

		// A property's value (live or dead); none when it is not defined.
		def property(name XMLNode) ?XMLNode {
			return lookup(name)
		}

		def isCollection() bool {
			return collection
		}

		// The resource's content, read once; none for a collection or
		// content that cannot be read.
		def content() ?string {
			if !loaded {
				loaded = true
				text = collection ?? (none, read())
			}
			return text
		}
	}

	// Evaluates a condition (RFC 5323 §5.5–5.16) with three-valued logic.
	def evaluate(cond XMLNode, subject SearchSubject) Truth {
		let op = cond.localName
		switch {
			case op == "and":
				let out = Truth.True
				for let c in cond.elements() {
					let t = evaluate(c, subject)
					return Truth.False when t == Truth.False
					out = Truth.Unknown when t == Truth.Unknown
				}
				return out
			case op == "or":
				let out = Truth.False
				for let c in cond.elements() {
					let t = evaluate(c, subject)
					return Truth.True when t == Truth.True
					out = Truth.Unknown when t == Truth.Unknown
				}
				return out
			case op == "not":
				let inner = cond.elements()
				return Truth.Unknown when inner.len() == 0
				let t = evaluate(inner[0], subject)
				return t == Truth.Unknown ?? (Truth.Unknown, t == Truth.True ?? (Truth.False, Truth.True))
			case op == "is-collection":
				return truthOf(subject.isCollection())
			case op == "is-defined":
				let name = propName(cond)
				return Truth.Unknown when name is none
				return truthOf(!(subject.property(name) is none))
			case op == "language-defined":
				let name = propName(cond)
				return Truth.Unknown when name is none
				let value = subject.property(name)
				return Truth.Unknown when value is none
				return truthOf(languageOf(value) != "")
			case op == "language-matches":
				let name = propName(cond)
				let literal = cond.child("literal", davNamespace)
				return Truth.Unknown when name is none || literal is none
				let value = subject.property(name)
				return Truth.Unknown when value is none
				let lang = languageOf(value).lower()
				let want = literal.text().trim().lower()
				return Truth.Unknown when lang == ""
				return truthOf(lang == want || lang.startsWith(want + "-"))
			case op == "contains":
				let text = subject.content()
				return Truth.False when text is none
				let score = containsScore(text, cond.text())
				subject.score = score when score > subject.score
				return truthOf(score > 0)
			case op == "like":
				let name = propName(cond)
				let literal = cond.child("literal", davNamespace)
				return Truth.Unknown when name is none || literal is none
				let value = subject.property(name)
				return Truth.Unknown when value is none || !isSimple(value)
				let caseless = caselessOf(cond)
				let text = caseless ?? (value.text().lower(), value.text())
				let pattern = caseless ?? (literal.text().lower(), literal.text())
				return truthOf(likeMatches(text, pattern))
		}
		// eq, lt, lte, gt, gte.
		let name = propName(cond)
		return Truth.Unknown when name is none
		let operand = cond.child("literal", davNamespace)
		let typed = cond.child("typed-literal", davNamespace)
		operand = typed when operand is none
		return Truth.Unknown when operand is none
		let value = subject.property(name)
		return Truth.Unknown when value is none || !isSimple(value)
		let kind = typeOfProperty(name)
		if !(typed is none) {
			let declared = typed.attribute("type", "http://www.w3.org/2001/XMLSchema-instance")
			kind = declared is none ?? ("string", localType(declared))
		}
		let order = compareAs(kind, value.text(), operand.text(), caselessOf(cond))
		return Truth.Unknown when order is none
		switch {
			case op == "eq":
				return truthOf(order == 0)
			case op == "lt":
				return truthOf(order < 0)
			case op == "lte":
				return truthOf(order <= 0)
			case op == "gt":
				return truthOf(order > 0)
		}
		return truthOf(order >= 0)
	}

	internal def truthOf(b bool) Truth {
		return b ?? (Truth.True, Truth.False)
	}

	// The one property a condition's `DAV:prop` names.
	internal def propName(cond XMLNode) ?XMLNode {
		let prop = cond.child("prop", davNamespace)
		return none when prop is none
		let names = prop.elements()
		return none unless names.len() == 1
		return names[0]
	}

	// Whether a value is text only (a property with child elements
	// compares as UNKNOWN).
	internal def isSimple(value XMLNode) bool {
		return value.elements().len() == 0
	}

	// The xml:lang of a property value; "".
	internal def languageOf(value XMLNode) string {
		let lang = value.attribute("lang", xmlNamespace)
		lang = value.attribute("xml:lang") when lang is none
		return lang is none ?? ("", lang)
	}

	// The type of a DAV: property's value (RFC 5323 §5.8.1).
	internal def typeOfProperty(name XMLNode) string {
		return "string" unless name.namespace == davNamespace
		return "integer" when name.localName == "getcontentlength" || name.localName == "quota-used-bytes" || name.localName == "quota-available-bytes"
		return "dateTime" when name.localName == "creationdate" || name.localName == "getlastmodified"
		return "string"
	}

	// The local part of an `xsi:type` value (`xs:integer` → integer).
	internal def localType(qname string) string {
		let parts = qname.split(":")
		return parts[parts.len() - 1]
	}

	// How `value` orders against `literal` as `kind`: -1, 0 or 1; none
	// when either does not read as that type.
	def compareAs(kind string, value string, literal string, caseless bool) ?int {
		switch {
			case kind := "integer" || "int" || "long" || "short" || "byte" || "unsignedLong" || "unsignedInt" || "nonNegativeInteger" || "positiveInteger" || "negativeInteger" || "nonPositiveInteger" || "decimal" || "double" || "float":
				let a = value.trim()
				let b = literal.trim()
				return none unless a.isNumeric() || isDecimal(a)
				return none unless b.isNumeric() || isDecimal(b)
				let x = parseFloat<float64>(a)
				let y = parseFloat<float64>(b)
				return x < y ?? (-1, x > y ?? (1, 0))
			case kind == "dateTime" || kind == "date":
				let x = readTime(value)
				let y = readTime(literal)
				return none when x is none || y is none
				let xn = x.unixNs()
				let yn = y.unixNs()
				return xn < yn ?? (-1, xn > yn ?? (1, 0))
			case kind == "boolean":
				let x = readBool(value)
				let y = readBool(literal)
				return none when x is none || y is none
				return x == y ?? (0, x ?? (1, -1))
		}
		let a = caseless ?? (value.lower(), value)
		let b = caseless ?? (literal.lower(), literal)
		return a < b ?? (-1, a > b ?? (1, 0))
	}

	internal def isDecimal(text string) bool {
		let digits = 0
		let dots = 0
		for let i = 0; i < text.len(); i++ {
			let c = text[i]
			if c >= '0' && c <= '9' {
				digits++
			} else if c == '.' {
				dots++
			} else if !((c == '-' || c == '+') && i == 0) && !(c == 'e' || c == 'E') {
				return false
			}
		}
		return digits > 0 && dots <= 1
	}

	// A time written as ISO 8601 or as an HTTP date.
	internal def readTime(text string) ?time.Time {
		let t = text.trim()
		let iso = time.parse(t) onerror (err error) {
			let http = time.parseHTTPDate(t) onerror (err2 error) {
				return none
			}
			return http
		}
		return iso
	}

	internal def readBool(text string) ?bool {
		let t = text.trim().lower()
		return true when t := "true" || "1"
		return false when t := "false" || "0"
		return none
	}

	// `DAV:like` (RFC 5323 §5.15.1): `%` matches any run, `_` one
	// character, `\` escapes the next.
	def likeMatches(text string, pattern string) bool {
		let t = text.split("")
		let p string[] = []
		let wild bool[] = []
		let chars = pattern.split("")
		for let i = 0; i < chars.len(); i++ {
			if chars[i] == "\\" && i + 1 < chars.len() {
				i++
				p.push(chars[i])
				wild.push(false)
				continue
			}
			p.push(chars[i])
			wild.push(chars[i] == "%" || chars[i] == "_")
		}
		// hits[j]: the pattern's first j elements match the text so far.
		let hits bool[] = []
		hits.len(p.len() + 1)
		hits.fill(false)
		hits[0] = true
		for let j = 1; j <= p.len(); j++ {
			hits[j] = hits[j - 1] && wild[j - 1] && p[j - 1] == "%"
		}
		for let c in t {
			let next bool[] = []
			next.len(p.len() + 1)
			next.fill(false)
			for let j = 1; j <= p.len(); j++ {
				if wild[j - 1] && p[j - 1] == "%" {
					next[j] = next[j - 1] || hits[j]
				} else if (wild[j - 1] && p[j - 1] == "_") || p[j - 1] == c {
					next[j] = hits[j - 1]
				}
			}
			hits = next
		}
		return hits[p.len()]
	}

	// How well `text` matches a `DAV:contains` phrase: 0 when it does
	// not, else up to 10000 by how often the phrase appears (RFC 5323
	// §5.18.1).
	def containsScore(text string, phrase string) int {
		let needle = phrase.trim().lower()
		return 0 when needle == ""
		let hay = text.lower()
		let count = 0
		let from = 0
		for {
			let at = hay[from:].indexOf(needle)
			break when at < 0
			count++
			from += at + needle.len()
		}
		return count * 1000 > 10000 ?? (10000, count * 1000)
	}

	// Orders two results by the query's keys (RFC 5323 §5.6): NULL
	// before any value, earlier keys first. -1, 0 or 1.
	def compareResults(orders SearchOrder[], a SearchSubject, b SearchSubject) int {
		for let o in orders {
			let order = 0
			let name = o.prop
			if name is none {
				order = a.score < b.score ?? (-1, a.score > b.score ?? (1, 0))
			} else {
				let x = a.property(name)
				let y = b.property(name)
				if x is none || y is none {
					order = (x is none && y is none) ?? (0, x is none ?? (-1, 1))
				} else {
					let byType = compareAs(typeOfProperty(name), x.text(), y.text(), o.caseless)
					order = byType is none ?? (0, byType)
				}
			}
			order = -order when o.descending
			return order when order != 0
		}
		return 0
	}

	// The query schema of `DAV:basicsearch` (RFC 5323 §5.19): every
	// property searchable, selectable and sortable, the DAV: ones
	// with their types, and the optional operators.
	def basicSearchSchema(live string[]) XMLNode {
		let schema = davNode("basicsearchschema")
		let properties = schema.add(davNode("properties"))
		for let name in live {
			let desc = properties.add(davNode("propdesc"))
			desc.add(davNode("prop")).add(davNode(name))
			let kind = typeOfProperty(davNode(name))
			let typeNode = desc.add(davNode("datatype"))
			typeNode.add(new XMLNode("xs:" + kind, xsdNamespace).set("xmlns:xs", xsdNamespace))
			desc.add(davNode("searchable"))
			desc.add(davNode("selectable"))
			desc.add(davNode("sortable"))
		}
		let others = properties.add(davNode("propdesc"))
		others.add(davNode("any-other-property"))
		others.add(davNode("searchable"))
		others.add(davNode("selectable"))
		others.add(davNode("sortable"))
		let operators = schema.add(davNode("operators"))
		let contains = operators.add(davNode("opdesc"))
		contains.set("allow-pcdata", "yes")
		contains.add(davNode("contains"))
		for let op in ["is-defined", "language-defined"] {
			let d = operators.add(davNode("opdesc"))
			d.add(davNode(op))
			d.add(davNode("operand-property"))
		}
		let matches = operators.add(davNode("opdesc"))
		matches.add(davNode("language-matches"))
		matches.add(davNode("operand-property"))
		matches.add(davNode("operand-literal"))
		return schema
	}
}
