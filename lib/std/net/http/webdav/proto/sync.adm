internal partial module std.net.http.webdav.proto {
	use (
		std.crypto::(rand)
	)

	// Collection synchronization (RFC 6578): the server numbers every
	// change and hands out the number as a sync token; a client that
	// comes back with a token learns what changed since.

	// The URI every sync token starts with.
	const syncTokenBase = "http://adm-lang.dev/ns/sync/"

	// One recorded change: a path created or changed, or removed.
	struct Change {
		seq     int64
		path    string
		removed bool
	}

	// ChangeLog keeps the latest `limit` changes of a share. Tokens name
	// this log's epoch, so tokens of a previous run of the server are
	// refused rather than misread.
	type ChangeLog {
		limit          int      = 10000
		internal epoch string
		atomic seq     int64    = 0
		atomic changes Change[] = []
		// The oldest sequence number a token may name and still be
		// answered.
		atomic floor   int64    = 0

		def new() {
			epoch = (rand(8) onerror recover byte[1, 2, 3, 4, 5, 6, 7, 8]).hex().lower()
		}

		// Records that `path` changed, or was removed.
		atomic def record(path string, removed bool) {
			seq++
			changes.push(Change{seq: seq, path: path, removed: removed})
			if changes.len() > limit {
				let cut = changes.len() - limit
				floor = changes[cut - 1].seq
				changes = changes[cut:].clone()
			}
		}

		// The token of the current state.
		atomic def token() string {
			return "{syncTokenBase}{epoch}/{seq}"
		}

		// The token of the state after change `n`.
		def tokenAt(n int64) string {
			return "{syncTokenBase}{epoch}/{n}"
		}

		// The sequence number a token names; -1 when it is not one of this
		// log's, or too old to answer.
		atomic def seqOf(token string) int64 {
			return -1 unless token.startsWith(syncTokenBase + epoch + "/")
			let text = token[(syncTokenBase + epoch + "/").len():]
			return -1 unless text.len() > 0 && text.isNumeric()
			let n = text.toInt<int64>()
			return -1 when n < floor || n > seq
			return n
		}

		// The changes after `n`, oldest first.
		atomic def since(n int64) Change[] {
			return changes.filter(c => c.seq > n)
		}
	}
}
