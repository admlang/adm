internal partial module std.net.http.webdav.proto {
	use (
		std.data.encoding::(XML, XMLNode, XMLNodeKind, XMLWriter)
		std.net.http::(statusText)
		std.net.url
		std.net.http.webdav::(WebDavError, davNamespace)
	)

	// The multistatus body (RFC 4918 §13–14) both sides speak, and the
	// XML helpers around it.

	// One `propstat`: the properties that share a status.
	struct PropStat {
		status int
		props  XMLNode[] = []
	}

	// One `response` of a multistatus: a resource with its propstats, or
	// with a status of its own.
	struct DavResponse {
		href      string
		status    int        = 0
		propstats PropStat[] = []
		// Elements after the propstats, such as RFC 5323's
		// `query-schema`.
		extra     XMLNode[]  = []
	}

	// An element in the DAV: namespace, written with the D: prefix.
	def davNode(localName string) XMLNode {
		return new XMLNode("D:" + localName, davNamespace)
	}

	// A DAV: element holding text.
	def davText(localName string, text string) XMLNode {
		let n = davNode(localName)
		n.add(text)
		return n
	}

	// The node as markup that stands alone: every element named with its
	// own prefix and namespace declaration, so it can be written into
	// another document (a dead property stored from one request and
	// returned in another).
	def standalone(node XMLNode) XMLNode {
		return copyText(node.content) when node.kind == XMLNodeKind.Text
		return rebuild(node, 0)
	}

	internal def copyText(content string) XMLNode {
		let t = new XMLNode("")
		t.kind = XMLNodeKind.Text
		t.content = content
		return t
	}

	internal def rebuild(node XMLNode, depth int) XMLNode {
		let out = node.namespace == "" ?? (new XMLNode(node.localName), new XMLNode("n{depth}:" + node.localName, node.namespace))
		out.set("xmlns:n{depth}", node.namespace) unless node.namespace == ""
		for let a in node.attributes {
			continue when a.name == "xmlns" || a.name.startsWith("xmlns:")
			// Attributes in a namespace keep their text; their prefix is
			// dropped with the declarations it depended on.
			out.set(a.localName, a.value) when a.namespace == ""
		}
		for let c in node.children {
			if c.kind == XMLNodeKind.Text {
				out.add(c.content)
			} else {
				out.add(rebuild(c, depth + 1))
			}
		}
		return out
	}

	// An empty element named like `node`, for a propstat that lists names
	// only (propname, 404s).
	def emptyLike(node XMLNode) XMLNode {
		return davNode(node.localName) when node.namespace == davNamespace
		let n = node.namespace == "" ?? (new XMLNode(node.localName), new XMLNode("x:" + node.localName, node.namespace))
		n.set("xmlns:x", node.namespace) unless node.namespace == ""
		return n
	}

	// The multistatus document.
	def multistatus(responses DavResponse[], extra XMLNode[] = []) byte[] {
		let root = davNode("multistatus")
		root.set("xmlns:D", davNamespace)
		for let r in responses {
			root.add(responseNode(r))
		}
		for let e in extra {
			root.add(e)
		}
		return document(root)
	}

	// The `response` element of a multistatus.
	def responseNode(r DavResponse) XMLNode {
		let resp = davNode("response")
		resp.add(davText("href", r.href))
		resp.add(davText("status", statusLine(r.status))) when r.status != 0
		for let ps in r.propstats {
			let propstat = resp.add(davNode("propstat"))
			let prop = propstat.add(davNode("prop"))
			for let p in ps.props {
				prop.add(p)
			}
			propstat.add(davText("status", statusLine(ps.status)))
		}
		for let e in r.extra {
			resp.add(e)
		}
		return resp
	}

	// An extended MKCOL answer (RFC 5689 §5.2): `mkcol-response` with
	// the status of each property.
	def mkcolResponse(propstats PropStat[]) byte[] {
		let root = davNode("mkcol-response")
		root.set("xmlns:D", davNamespace)
		for let ps in propstats {
			let propstat = root.add(davNode("propstat"))
			let prop = propstat.add(davNode("prop"))
			for let p in ps.props {
				prop.add(p)
			}
			propstat.add(davText("status", statusLine(ps.status)))
		}
		return document(root)
	}

	// An error body naming a precondition or postcondition (RFC 4918
	// §16): `<D:error><D:name/></D:error>`.
	def davError(condition string) byte[] {
		let root = davNode("error")
		root.set("xmlns:D", davNamespace)
		root.add(davNode(condition))
		return document(root)
	}

	// A document with the XML declaration.
	def document(root XMLNode) byte[] {
		let w = new XMLWriter()
		w.declaration()
		w.node(root)
		return w.bytes()
	}

	def statusLine(code int) string {
		return "HTTP/1.1 {code} {statusText(code)}"
	}

	// The code of an `HTTP/1.1 207 Multi-Status` line; 0 when it has none.
	def statusCodeOf(line string) int {
		let parts = line.trim().split(" ")
		return 0 when parts.len() < 2 || !parts[1].isNumeric()
		return parts[1].toInt<int>()
	}

	// The responses of a multistatus body. Fails with WebDavError
	// `protocol` when it is not one.
	// The `sync-token` a multistatus ends with (RFC 6578), "" for none.
	def multistatusToken(data byte[]) string {
		let root = new XML().parse(data) onerror recover new XMLNode("")
		let token = root.child("sync-token", davNamespace)
		return token is none ?? ("", token.text().trim())
	}

	def parseMultistatus(data byte[]) !DavResponse[] {
		let root = new XML().parse(data) onerror (err error) {
			fail WebDavError{message: "webdav: the multistatus body is not XML", code: "protocol", cause: err}
		}
		fail WebDavError{message: "webdav: expected a multistatus, got <{root.localName}>", code: "protocol"} unless root.localName == "multistatus" && root.namespace == davNamespace
		let out DavResponse[] = []
		for let resp in root.elements("response", davNamespace) {
			let hrefNode = resp.child("href", davNamespace)
			continue when hrefNode is none
			let r = DavResponse{href: hrefNode.text().trim()}
			let own = resp.child("status", davNamespace)
			r.status = statusCodeOf(own.text()) unless own is none
			for let ps in resp.elements("propstat", davNamespace) {
				let st = ps.child("status", davNamespace)
				let entry = PropStat{status: st is none ?? (200, statusCodeOf(st.text()))}
				let prop = ps.child("prop", davNamespace)
				if !(prop is none) {
					for let p in prop.elements() {
						entry.props.push(p)
					}
				}
				r.propstats.push(entry)
			}
			out.push(r)
		}
		return out
	}

	// The href of a path under `prefix`: each segment percent-encoded, a
	// collection ending in `/`.
	def hrefOf(prefix string, path string, collection bool) string {
		let segments string[] = []
		for let s in path.split("/") {
			segments.push(url.pathEscape(s)) unless s == ""
		}
		let base = prefix.trimSuffix("/")
		let joined = base + "/" + segments.join("/")
		return joined + "/" when collection && !joined.endsWith("/")
		return joined
	}

	// The store path an href names (absolute URL or path), without
	// `prefix`, decoded, cleaned, with no trailing slash; none when it
	// lies outside the prefix.
	def pathOfHref(href string, prefix string) ?string {
		let raw = href.trim()
		let schemeEnd = raw.indexOf("://")
		if schemeEnd > 0 {
			let rest = raw[schemeEnd + 3:]
			let slash = rest.indexOf("/")
			raw = slash < 0 ?? ("/", rest[slash:])
		}
		let decoded = url.pathUnescape(raw) onerror recover raw
		let base = prefix.trimSuffix("/")
		if base != "" {
			return none unless decoded == base || decoded.startsWith(base + "/")
			decoded = decoded[base.len():]
		}
		return cleanStorePath(decoded)
	}

	// A path with `.`, `..` and repeated slashes resolved, rooted, no
	// trailing slash ("/" for the root).
	def cleanStorePath(path string) string {
		let out string[] = []
		for let s in path.split("/") {
			continue when s := "" || "."
			if s == ".." {
				out.pop() when out.len() > 0
				continue
			}
			out.push(s)
		}
		return "/" + out.join("/")
	}

	// The parent of a store path ("/" for a top-level one).
	def parentOf(path string) string {
		let cleaned = cleanStorePath(path)
		let parts = cleaned.split("/").filter(s => s != "")
		return "/" when parts.len() <= 1
		return "/" + parts[:parts.len() - 1].join("/")
	}

	// The last segment of a store path.
	def baseName(path string) string {
		let parts = cleanStorePath(path).split("/").filter(s => s != "")
		return parts.len() == 0 ?? ("", parts[parts.len() - 1])
	}

	// Whether `path` is `root` or lies under it.
	def within(path string, root string) bool {
		return true when root == "/"
		return path == root || path.startsWith(root + "/")
	}
}
