partial module std.net.http.webdav {
	use (
		std.errors
		std.fs
		std.time
		std.data.encoding::(XMLNode)
		std.net.http::(Context)
	)

	// WebDAV (RFC 4918) over `std.net.http`: `Client` reaches a WebDAV
	// share as an `fs.FileStore` and `net.RemoteFiles` (list, read, write,
	// move, copy, lock, properties); `Server` serves any `fs.FileStore` as
	// a class 1 and 2 WebDAV share, locks included, as an `http.Handler`.
	//
	// ```
	// let dav = new webdav.Client("https://cloud.example.com/remote.php/dav/files/me")
	// dav.username = "me"
	// dav.password = "s3cret"
	// for let entry in try dav.list("/Photos") {
	//     println(entry.name)
	// }
	// ```

	// The namespace of every WebDAV property and element.
	const davNamespace = "DAV:"

	// Property is a WebDAV property of a resource: a live one the server
	// computes (`getcontentlength`, `getetag`...) or a dead one a client
	// stored. `value` is its text; `markup` its content as XML when it
	// holds elements.
	struct Property {
		namespace string
		name      string
		value     string = ""
		markup    string = ""
	}

	// Lock is a write lock on a resource: exclusive, or shared with other
	// shared locks. `depth` is 0 for the resource alone, -1 for a
	// collection and everything under it.
	struct Lock {
		token     string
		path      string
		exclusive bool       = true
		depth     int        = -1
		// Who holds it, as the client described itself.
		owner     string     = ""
		// How long the lock lasts from its last refresh; 0s never ends.
		timeout   duration   = 0s
		expires   ?time.Time = none
	}

	// WebDavError is the payload of a WebDAV failure. `code` is
	// `notFound`, `exists`, `conflict` (a missing parent), `locked`,
	// `forbidden`, `precondition`, `unsupported`, `protocol`, or `status`
	// for another HTTP status (in `status`).
	// SyncResult is what `Client.sync` learned (RFC 6578): what changed
	// in a collection since a token.
	struct SyncResult {
		// The token of this state: pass it to the next `sync`.
		token     string
		// Members created or changed since, with their figures.
		changed   fs.FileEntry[] = []
		// Paths of members removed since.
		removed   string[]       = []
		// The server stopped at the limit: `sync` again with `token` for
		// the rest.
		truncated bool           = false
	}

	// Privilege is a WebDAV access privilege (RFC 3744 §3). `All` holds
	// every other one; `Write` holds `WriteProperties`, `WriteContent`,
	// `Bind` and `Unbind`. The value is the element's name.
	enum Privilege {
		Read                         = "read",
		Write                        = "write",
		WriteProperties              = "write-properties",
		WriteContent                 = "write-content",
		Unlock                       = "unlock",
		ReadAcl                      = "read-acl",
		ReadCurrentUserPrivilegeSet  = "read-current-user-privilege-set",
		WriteAcl                     = "write-acl",
		Bind                         = "bind",
		Unbind                       = "unbind",
		All                          = "all",
	}

	// Ace is an access control entry (RFC 3744 §5.5): it grants or
	// denies `privileges` to `principal`, or to everyone but it when
	// `invert` is set. `principal` is a principal's URL (such as
	// `Server.userURL("alice")`) or one of `all`, `authenticated`,
	// `unauthenticated`, `self` and `owner`.
	struct Ace {
		principal  string
		privileges Privilege[]
		grant      bool        = true
		invert     bool        = false
		// Set by the server: an entry no ACL request can change.
		protected  bool        = false
		// Set by the server: the URL of the collection an inherited
		// entry comes from; "" for the resource's own entries.
		inherited  string      = ""
	}

	// Extension is a protocol built on a `Server` share, such as CardDAV
	// or CalDAV: it names collection types extended MKCOL may create,
	// computes live properties (of resources and of principals), answers
	// reports and methods of its own, and checks what is stored in its
	// collections. Add it to `Server.extensions`.
	interface Extension {
		// The tokens it adds to the `DAV` header (`addressbook`).
		def compliance() string[]

		// The methods it answers, added to `Allow` (`MKCALENDAR`).
		def methods() string[]

		// The collection types it defines: elements a `resourcetype` may
		// hold beside `DAV:collection` (`CARDDAV:addressbook`).
		def collectionTypes() XMLNode[]

		// A live property of the resource or principal at `path` (store
		// path); none when the name is not one of its own there.
		def property(share Server, path string, name XMLNode) ?XMLNode

		// The names of its live properties at `path`, for `propname`.
		def propertyNames(share Server, path string) XMLNode[]

		// The reports it answers at `path`, as `supported-report-set`
		// lists them (the report element, empty).
		def reports(share Server, path string) XMLNode[]

		// Answers a REPORT whose body is `body`; false when the report is
		// not one of its own.
		// Fails when writing the answer fails.
		def report(share Server, ctx Context, path string, body XMLNode) !bool

		// Answers a request with a method the share does not know; false
		// when the method is not one of its own either.
		// Fails when writing the answer fails.
		def request(share Server, ctx Context, method string, path string) !bool

		// Validates content about to be stored at `path`, a member of a
		// collection with a type (PUT, COPY and MOVE): none accepts it; a
		// precondition element refuses it with 403 and that element as
		// the `DAV:error` body.
		def validate(share Server, path string, contentType string, content byte[]) ?XMLNode
	}

	struct WebDavError {
		message string
		code    string
		cause   ?error
		stack   errors.StackTrace
		// The HTTP status the server answered, 0 when none.
		status  int               = 0
		path    string            = ""
	}
}
