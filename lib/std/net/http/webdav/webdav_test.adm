partial module std.net.http.webdav {
	use (
		std.fs
		std.net
		std.net.http
		std.net.http.httptest
		std.net.http.webdav.proto::*
		std.testing
		std.time
	)

	internal def share() !(httptest.Server, Server, fs.MemoryStore) {
		let store = new fs.MemoryStore()
		let dav = new Server(store, "/dav")
		let site = new httptest.Server(dav)
		try site.start()
		return (site, dav, store)
	}

	internal def clientOf(site httptest.Server) Client {
		return new Client("http://{site.address().str()}/dav", 5s)
	}

	internal def codeOf(err error) string {
		return err is WebDavError ?? (err.code, "other")
	}

	check "WebDAV" {
		@test()
		def parsesIfHeaders() !none {
			let lists = try parseIf("<http://h/dav/a> (<opaquelocktoken:1> [\"e1\"]) (Not <DAV:no-lock>)")
			assert lists.len() == 2
			assert lists[0].resource == "http://h/dav/a" && lists[0].conditions.len() == 2
			assert lists[0].conditions[0].token == "opaquelocktoken:1" && lists[0].conditions[1].etag == "\"e1\""
			assert lists[1].resource == "http://h/dav/a" && lists[1].conditions[0].negated
			assert submittedTokens(lists).equals(["opaquelocktoken:1"])
			let decoded = pathOfHref("http://h:80/dav/a%20b/c/", "/dav")
			assert !(decoded is none) && decoded == "/a b/c"
			assert pathOfHref("/other/x", "/dav") is none
			assert hrefOf("/dav", "/a b/c", true) == "/dav/a%20b/c/"
			assert cleanStorePath("/a/./b/../c//d") == "/a/c/d"
			return none
		}

		@test()
		def readsAndWritesFiles() !none {
			let (site, _, _) = try share()
			let dav = clientOf(site)
			let files net.RemoteFiles = dav
			try dav.makeDirs("/docs/2026")
			assert (try dav.stat("/docs")).kind == fs.FileKind.Dir
			try dav.writeFile("/docs/2026/note.txt", "hello, dav")
			assert (try dav.readText("/docs/2026/note.txt")) == "hello, dav"
			let entry = try dav.stat("/docs/2026/note.txt")
			assert entry.size == 10 && entry.kind == fs.FileKind.File && entry.name == "note.txt"
			assert time.now() - entry.modified < 1m
			let names = (try dav.list("/docs/2026")).mapElem<string>(e => e.name)
			assert names.equals(["note.txt"])
			assert (try dav.walk("/")).len() == 3
			assert try dav.exists("/docs/2026/note.txt")
			assert !(try dav.exists("/nope"))
			// A ranged read, an append and a resume.
			let reader = try dav.open("/docs/2026/note.txt", int64(7))
			let tail byte[] = []
			tail.len(16)
			let n = try reader.read(tail)
			try reader.close()
			assert string(tail[:n]) == "dav"
			let w = try dav.create("/docs/2026/note.txt", true)
			try w.write("!".bytes())
			try w.close()
			assert (try dav.readText("/docs/2026/note.txt")) == "hello, dav!"
			let r = try files.resume("/docs/2026/note.txt", int64(5))
			try r.write(" world".bytes())
			try r.close()
			assert (try dav.readText("/docs/2026/note.txt")) == "hello world"
			// Unicode and spaces in names.
			try dav.writeFile("/docs/größe und so.txt", [1, 2, 3])
			assert (try dav.readFile("/docs/größe und so.txt")).equals([1, 2, 3])
			let code = ""
			dav.readFile("/docs/missing") onerror (err error) {
				code = codeOf(err)
				recover []
			}
			assert code == "notFound"
			code = ""
			dav.writeFile("/nowhere/x.txt", "x") onerror (err error) {
				code = codeOf(err)
				recover none
			}
			assert code == "conflict"
			code = ""
			dav.makeDir("/docs") onerror (err error) {
				code = codeOf(err)
				recover none
			}
			assert code == "exists"
			code = ""
			dav.chmod("/docs", 0o755) onerror (err error) {
				code = codeOf(err)
				recover none
			}
			assert code == "unsupported"
			try site.close()
			return none
		}

		@test()
		def movesCopiesAndDeletes() !none {
			let (site, _, _) = try share()
			let dav = clientOf(site)
			try dav.makeDirs("/a/b")
			try dav.writeFile("/a/b/one.txt", "1")
			try dav.writeFile("/a/two.txt", "2")
			try dav.copy("/a", "/copy")
			assert (try dav.readText("/copy/b/one.txt")) == "1"
			try dav.rename("/copy/two.txt", "/copy/three.txt")
			assert !(try dav.exists("/copy/two.txt")) && (try dav.readText("/copy/three.txt")) == "2"
			let code = ""
			dav.rename("/a/two.txt", "/copy/three.txt", false) onerror (err error) {
				code = codeOf(err)
				recover none
			}
			assert code == "precondition"
			try dav.rename("/a/two.txt", "/copy/three.txt")
			assert (try dav.readText("/copy/three.txt")) == "2"
			code = ""
			dav.removeDir("/copy") onerror (err error) {
				code = codeOf(err)
				recover none
			}
			assert code == "conflict"
			code = ""
			dav.remove("/copy") onerror (err error) {
				code = codeOf(err)
				recover none
			}
			assert code == "conflict"
			try dav.remove("/copy/three.txt")
			try dav.removeAll("/copy")
			assert !(try dav.exists("/copy"))
			// fs.copy between the share and any other store.
			let local = new fs.MemoryStore()
			try fs.copy(dav, "/a", local, "/mirror")
			let back = try local.open("/mirror/b/one.txt", int64(0))
			let buf byte[] = []
			buf.len(8)
			let n = try back.read(buf)
			assert string(buf[:n]) == "1"
			try fs.copy(local, "/mirror", dav, "/back")
			assert (try dav.readText("/back/b/one.txt")) == "1"
			try site.close()
			return none
		}

		@test()
		def keepsProperties() !none {
			let (site, _, _) = try share()
			let dav = clientOf(site)
			try dav.writeFile("/f.txt", "x")
			try dav.setProperty("/f.txt", "urn:example", "color", "blue")
			let color = try dav.property("/f.txt", "urn:example", "color")
			assert !(color is none) && color.value == "blue"
			let all = try dav.properties("/f.txt")
			let names = all.mapElem<string>(p => p.name)
			assert names.includes("getetag") && names.includes("getcontentlength") && names.includes("color")
			// Dead properties follow a move.
			try dav.rename("/f.txt", "/g.txt")
			let moved = try dav.property("/g.txt", "urn:example", "color")
			assert !(moved is none) && moved.value == "blue"
			try dav.removeProperty("/g.txt", "urn:example", "color")
			assert (try dav.property("/g.txt", "urn:example", "color")) is none
			// Live properties other than the modification time are protected.
			let code = ""
			dav.setProperty("/g.txt", "DAV:", "getetag", "\"x\"") onerror (err error) {
				code = codeOf(err)
				recover none
			}
			assert code == "forbidden"
			// Without a quota the server reports what is used, not what is
			// left.
			let (used, available) = try dav.quota("/")
			assert used >= 0 && available == -1
			try site.close()
			return none
		}

		@test()
		def locksResources() !none {
			let (site, server, _) = try share()
			let alice = clientOf(site)
			let bob = clientOf(site)
			try alice.writeFile("/doc.txt", "v1")
			let held = try alice.lock("/doc.txt", 10m, owner = "alice")
			assert held.token.startsWith("opaquelocktoken:") && held.exclusive && held.timeout == 600s
			assert server.activeLocks().len() == 1
			// The holder writes; anyone else is locked out.
			try alice.writeFile("/doc.txt", "v2")
			let code = ""
			bob.writeFile("/doc.txt", "bob") onerror (err error) {
				code = codeOf(err)
				recover none
			}
			assert code == "locked"
			code = ""
			bob.lock("/doc.txt", 10m) onerror (err error) {
				code = codeOf(err)
				recover Lock{token: "", path: ""}
			}
			assert code == "locked"
			let refreshed = try alice.refresh(held, 20m)
			assert refreshed.timeout == 1200s
			try alice.unlock(held)
			try bob.writeFile("/doc.txt", "bob")
			// Shared locks share; an exclusive one waits.
			let s1 = try alice.lock("/doc.txt", exclusive = false)
			let s2 = try bob.lock("/doc.txt", exclusive = false)
			code = ""
			let carol = clientOf(site)
			carol.lock("/doc.txt") onerror (err error) {
				code = codeOf(err)
				recover Lock{token: "", path: ""}
			}
			assert code == "locked"
			try alice.unlock(s1)
			try bob.unlock(s2)
			// A lock on a collection covers what is under it; a lock on a
			// missing path creates it empty.
			try alice.makeDir("/folder")
			try alice.lock("/folder")
			let fresh = try alice.lock("/solo.txt", exclusive = false, depth = 0)
			assert (try alice.stat("/solo.txt")).size == 0 && !fresh.exclusive && fresh.depth == 0
			code = ""
			bob.writeFile("/folder/other.txt", "x") onerror (err error) {
				code = codeOf(err)
				recover none
			}
			assert code == "locked"
			try alice.writeFile("/folder/other.txt", "mine")
			try alice.close()
			assert alice.locks().len() == 0 && server.activeLocks().len() == 0
			try bob.writeFile("/folder/other.txt", "bob")
			try site.close()
			return none
		}

		@test()
		def answersPlainHttp() !none {
			let (site, _, _) = try share()
			let dav = clientOf(site)
			try dav.makeDir("/pub")
			try dav.writeFile("/pub/a.txt", "abcdef")
			let web = new http.Client("http://{site.address().str()}", 5s)
			let options = try web.options("/dav/")
			assert options.header("DAV").contains("2")
			let page = try web.get("/dav/pub/")
			assert page.status == 200 && (try page.text()).contains("a.txt")
			let req = try web.request(http.Method.GET, "/dav/pub/a.txt")
			req.headers.set("Range", "bytes=2-3")
			let part = try web.do(req)
			assert part.status == 206 && (try part.text()) == "cd"
			// An If header whose entity tag is stale: 412.
			let put = try web.request(http.Method.PUT, "/dav/pub/a.txt")
			put.replaceBody("new".bytes())
			put.headers.set("If", "([\"stale\"])")
			assert (try web.do(put)).status == 412
			let etag = (try web.head("/dav/pub/a.txt")).header("ETag")
			let good = try web.request(http.Method.PUT, "/dav/pub/a.txt")
			good.replaceBody("new".bytes())
			good.headers.set("If", "([{etag}])")
			assert (try web.do(good)).status == 204
			try site.close()
			return none
		}

		@test()
		def synchronizesCollections() !none {
			let (site, _, _) = try share()
			let dav = clientOf(site)
			try dav.makeDirs("/sync/deep")
			try dav.writeFile("/sync/a.txt", "a")
			try dav.writeFile("/sync/deep/b.txt", "b")
			// No token: every member.
			let first = try dav.sync("/sync")
			assert first.token.startsWith("http://") && first.changed.len() == 3 && first.removed.len() == 0
			// Nothing since.
			let quiet = try dav.sync("/sync", first.token)
			assert quiet.changed.len() == 0 && quiet.removed.len() == 0
			// A change, a new file, a removal and a move.
			try dav.writeFile("/sync/a.txt", "a2")
			try dav.writeFile("/sync/c.txt", "c")
			try dav.remove("/sync/deep/b.txt")
			try dav.rename("/sync/c.txt", "/sync/deep/c.txt")
			let next = try dav.sync("/sync", first.token)
			let changed = next.changed.mapElem<string>(e => e.path).sort((a, b) => a < b)
			fail "changed {changed.join(",")}" unless changed.equals(["/sync/a.txt", "/sync/deep/c.txt"])
			let removed = next.removed.sort((a, b) => a < b)
			fail "removed {removed.join(",")}" unless removed.equals(["/sync/c.txt", "/sync/deep/b.txt"])
			// Direct members only.
			let shallow = try dav.sync("/sync", first.token, false)
			assert shallow.changed.len() == 1 && shallow.changed[0].path == "/sync/a.txt"
			// A limit: two at a time, then the rest.
			let part = try dav.sync("/sync", first.token, true, 2)
			assert part.truncated && part.changed.len() + part.removed.len() == 2
			let rest = try dav.sync("/sync", part.token)
			assert !rest.truncated && rest.changed.len() + rest.removed.len() == 2
			// A token that is not ours.
			let code = ""
			dav.sync("/sync", "http://elsewhere/1") onerror (err error) {
				code = codeOf(err)
				recover SyncResult{token: ""}
			}
			assert code == "forbidden"
			return none
		}

		@test()
		def ordersCollections() !none {
			let (site, _, _) = try share()
			let dav = clientOf(site)
			try dav.makeDir("/o")
			for let n in ["a", "b", "c"] {
				try dav.writeFile("/o/{n}.txt", n)
			}
			let names = def () !string {
				return (try dav.list("/o")).mapElem<string>(e => e.name).join(",")
			}
			assert (try names()) == "a.txt,b.txt,c.txt"
			// Positions without an order: 409.
			let web = new http.Client("http://{site.address().str()}", 5s)
			let early = try web.request(http.Method.PUT, "/dav/o/d.txt")
			early.replaceBody("d".bytes())
			early.headers.set("Position", "first")
			let refused = try web.do(early)
			assert refused.status == 409 && (try refused.text()).contains("collection-must-be-ordered")
			try dav.order("/o", ["c.txt", "a.txt"])
			assert (try names()) == "c.txt,a.txt,b.txt"
			let kind = try dav.property("/o", "DAV:", "ordering-type")
			assert !(kind is none) && (kind.value + kind.markup).contains("DAV:custom")
			// New members go last; a Position puts them elsewhere.
			try dav.writeFile("/o/d.txt", "d")
			let put = try web.request(http.Method.PUT, "/dav/o/e.txt")
			put.replaceBody("e".bytes())
			put.headers.set("Position", "after \"c.txt\"")
			assert (try web.do(put)).status == 201
			assert (try names()) == "c.txt,e.txt,a.txt,b.txt,d.txt"
			let bad = try web.request(http.Method.PUT, "/dav/o/f.txt")
			bad.replaceBody("f".bytes())
			bad.headers.set("Position", "before \"nope.txt\"")
			let missing = try web.do(bad)
			assert missing.status == 409 && (try missing.text()).contains("segment-must-identify-member")
			// Removed and moved members leave the order.
			try dav.remove("/o/a.txt")
			try dav.rename("/o/e.txt", "/o/z.txt")
			assert (try names()) == "c.txt,b.txt,d.txt,z.txt"
			let unknown = ""
			dav.order("/o", ["nope.txt"]) onerror (err error) {
				unknown = codeOf(err)
				recover none
			}
			assert unknown == "conflict"
			try site.close()
			return none
		}

		@test()
		def searches() !none {
			let (site, _, _) = try share()
			let dav = clientOf(site)
			try dav.makeDirs("/s/notes")
			try dav.writeFile("/s/notes/Todo.txt", "buy milk and more milk")
			try dav.writeFile("/s/notes/done.txt", "nothing")
			try dav.writeFile("/s/big.bin", "0123456789012345678901234567890123456789")
			let names = def (found fs.FileEntry[]) string {
				return found.mapElem<string>(e => e.path).sort((a, b) => a < b).join(",")
			}
			assert names(try dav.search("/s", "%.txt")) == "/s/notes/Todo.txt,/s/notes/done.txt"
			assert names(try dav.search("/s", "todo%")) == "/s/notes/Todo.txt"
			assert names(try dav.search("/s", contains = "MILK")) == "/s/notes/Todo.txt"
			assert names(try dav.search("/s", collections = true)) == "/s,/s/notes"
			assert names(try dav.search("/s", largerThan = 30)) == "/s/big.bin"
			assert names(try dav.search("/s", "_one.txt")) == "/s/notes/done.txt"
			// Depth 1: the scope and its members.
			assert names(try dav.search("/s", depth = 1)) == "/s,/s/big.bin,/s/notes"
			// Ordered by size, largest first, two of them.
			let top = try dav.search("/s", collections = false, orderBy = "getcontentlength", descending = true, limit = 2)
			assert top.len() == 2 && top[0].path == "/s/big.bin" && top[1].path == "/s/notes/Todo.txt"
			// A missing scope.
			let code = ""
			dav.search("/nope") onerror (err error) {
				code = codeOf(err)
				recover fs.FileEntry[]
			}
			assert code == "notFound"
			// Discovery: the DASL header and the query schema.
			let web = new http.Client("http://{site.address().str()}", 5s)
			let options = try web.options("/dav/")
			assert options.header("DASL") == "<DAV:basicsearch>"
			let discover = try web.request(http.Method.Other, "/dav/s/")
			discover.rawMethod = "SEARCH"
			discover.replaceBody("<?xml version=\"1.0\"?><D:query-schema-discovery xmlns:D=\"DAV:\"><D:basicsearch><D:from><D:scope><D:href>/dav/s/</D:href></D:scope></D:from></D:basicsearch></D:query-schema-discovery>".bytes())
			let schema = try web.do(discover)
			assert schema.status == 207 && (try schema.text()).contains("basicsearchschema")
			// Three-valued logic: a comparison with a missing property is
			// UNKNOWN, and `not` of it is UNKNOWN too.
			let odd = try web.request(http.Method.Other, "/dav/s/")
			odd.rawMethod = "SEARCH"
			odd.replaceBody("<?xml version=\"1.0\"?><D:searchrequest xmlns:D=\"DAV:\" xmlns:x=\"urn:x\"><D:basicsearch><D:select><D:prop><D:displayname/></D:prop></D:select><D:from><D:scope><D:href>/dav/s/</D:href></D:scope></D:from><D:where><D:not><D:eq><D:prop><x:missing/></D:prop><D:literal>a</D:literal></D:eq></D:not></D:where></D:basicsearch></D:searchrequest>".bytes())
			let none_ = try web.do(odd)
			assert none_.status == 207 && !(try none_.text()).contains("<D:response>")
			// An operator the server does not know: 422.
			let unknown = try web.request(http.Method.Other, "/dav/s/")
			unknown.rawMethod = "SEARCH"
			unknown.replaceBody("<?xml version=\"1.0\"?><D:searchrequest xmlns:D=\"DAV:\"><D:basicsearch><D:select><D:allprop/></D:select><D:from><D:scope><D:href>/dav/s/</D:href></D:scope></D:from><D:where><D:fuzzy/></D:where></D:basicsearch></D:searchrequest>".bytes())
			assert (try web.do(unknown)).status == 422
			try site.close()
			return none
		}

		@test()
		def controlsAccess() !none {
			let store = new fs.MemoryStore()
			let dav = new Server(store, "/dav")
			dav.accessControl = true
			let mux = new http.ServeMux()
			mux.apply(http.basicAuth("dav", def (user string, password string) ?any {
				return none unless password == "pw"
				return user
			}))
			try mux.handle("/dav/", dav)
			let site = new httptest.Server(mux)
			try site.start()
			let base = "http://{site.address().str()}/dav"
			let alice = new Client(base, "alice", "pw", 5s)
			let bob = new Client(base, "bob", "pw", 5s)
			let failure = def (run def() !none) string {
				let code = ""
				run() onerror (err error) {
					code = codeOf(err)
					recover none
				}
				return code
			}
			try alice.makeDir("/a")
			try alice.writeFile("/a/x.txt", "x")
			// The root's default lets every signed-in user in.
			assert (try bob.readText("/a/x.txt")) == "x"
			assert (try alice.principal()) == dav.userURL("alice")
			// Alice owns /a: denying everyone else keeps her in.
			try alice.setAcl("/a", [Ace{principal: "authenticated", privileges: [Privilege.All], grant: false}])
			assert failure(def () !none {
				let _ = try bob.readText("/a/x.txt")
				return none
			}) == "forbidden"
			assert (try alice.readText("/a/x.txt")) == "x"
			// A group ahead of the deny lets bob read, not write.
			dav.addGroup("team", [dav.userURL("bob")])
			try alice.setAcl("/a", [
				Ace{principal: dav.groupURL("team"), privileges: [Privilege.Read, Privilege.ReadCurrentUserPrivilegeSet]},
				Ace{principal: "authenticated", privileges: [Privilege.All], grant: false}
			])
			assert (try bob.readText("/a/x.txt")) == "x"
			assert failure(def () !none {
				return try bob.writeFile("/a/y.txt", "y")
			}) == "forbidden"
			let held = try bob.privileges("/a/x.txt")
			assert held.includes(Privilege.Read) && !held.includes(Privilege.WriteContent)
			assert (try alice.privileges("/a/x.txt")).includes(Privilege.All)
			// Bob may not read the ACL; alice sees hers, owner entry first
			// and the root's inherited last.
			assert failure(def () !none {
				let _ = try bob.acl("/a")
				return none
			}) == "forbidden"
			let entries = try alice.acl("/a")
			assert entries.len() == 4 && entries[0].principal == "owner" && entries[0].protected
			assert entries[1].principal == dav.groupURL("team") && entries[3].inherited == "/dav/"
			// A principal the server does not know is refused.
			assert failure(def () !none {
				return try alice.setAcl("/a", [Ace{principal: "/dav/principals/users/nobody", privileges: [Privilege.Read]}])
			}) == "forbidden"
			// Principals: bob's group membership and a search by name.
			let web = new http.Client("http://{site.address().str()}", 5s)
			let find = try web.request(http.Method.Other, "/dav/principals/users/bob")
			find.rawMethod = "PROPFIND"
			find.basicAuth("bob", "pw")
			find.headers.set("Depth", "0")
			find.replaceBody("<?xml version=\"1.0\"?><D:propfind xmlns:D=\"DAV:\"><D:prop><D:group-membership/><D:resourcetype/></D:prop></D:propfind>".bytes())
			let found = try (try web.do(find)).text()
			assert found.contains("/dav/principals/groups/team") && found.contains("principal")
			let search = try web.request(http.Method.Other, "/dav/principals/")
			search.rawMethod = "REPORT"
			search.basicAuth("bob", "pw")
			search.replaceBody("<?xml version=\"1.0\"?><D:principal-property-search xmlns:D=\"DAV:\"><D:property-search><D:prop><D:displayname/></D:prop><D:match>LIC</D:match></D:property-search><D:prop><D:displayname/></D:prop></D:principal-property-search>".bytes())
			let hits = try (try web.do(search)).text()
			assert hits.contains("/dav/principals/users/alice") && !hits.contains("users/bob")
			// principal-match: what alice owns under /a.
			let owned = try web.request(http.Method.Other, "/dav/a/")
			owned.rawMethod = "REPORT"
			owned.basicAuth("alice", "pw")
			owned.replaceBody("<?xml version=\"1.0\"?><D:principal-match xmlns:D=\"DAV:\"><D:principal-property><D:owner/></D:principal-property></D:principal-match>".bytes())
			let mine = try (try web.do(owned)).text()
			assert mine.contains("/dav/a/x.txt")
			// expand-property: the owner, expanded to its display name.
			let expand = try web.request(http.Method.Other, "/dav/a/")
			expand.rawMethod = "REPORT"
			expand.basicAuth("alice", "pw")
			expand.replaceBody("<?xml version=\"1.0\"?><D:expand-property xmlns:D=\"DAV:\"><D:property name=\"owner\"><D:property name=\"displayname\"/></D:property></D:expand-property>".bytes())
			let expanded = try (try web.do(expand)).text()
			assert expanded.contains("<D:displayname>alice</D:displayname>") && expanded.contains("/dav/principals/users/alice")
			// A refused write names the missing privilege.
			let put = try web.request(http.Method.PUT, "/dav/a/z.txt")
			put.basicAuth("bob", "pw")
			put.replaceBody("z".bytes())
			let refused = try web.do(put)
			assert refused.status == 403 && (try refused.text()).contains("<D:bind")
			try site.close()
			return none
		}

		@test()
		def makesCollectionsWithProperties() !none {
			let (site, _, _) = try share()
			let dav = clientOf(site)
			let web = new http.Client("http://{site.address().str()}", 5s)
			let make = def (path string, body string) !http.Response {
				let req = try web.request(http.Method.Other, path)
				req.rawMethod = "MKCOL"
				req.replaceBody(body.bytes())
				return try web.do(req)
			}
			let good = try make("/dav/c1", "<?xml version=\"1.0\"?><D:mkcol xmlns:D=\"DAV:\" xmlns:x=\"urn:x\"><D:set><D:prop><D:resourcetype><D:collection/></D:resourcetype><x:color>red</x:color></D:prop></D:set></D:mkcol>")
			assert good.status == 201 && (try good.text()).contains("mkcol-response")
			let color = try dav.property("/c1", "urn:x", "color")
			assert !(color is none) && color.value == "red"
			// A resource type this server does not make: nothing is made.
			let bad = try make("/dav/c2", "<?xml version=\"1.0\"?><D:mkcol xmlns:D=\"DAV:\" xmlns:C=\"urn:ietf:params:xml:ns:caldav\"><D:set><D:prop><D:resourcetype><D:collection/><C:calendar/></D:resourcetype></D:prop></D:set></D:mkcol>")
			assert bad.status == 403 && (try bad.text()).contains("403")
			assert !(try dav.exists("/c2"))
			// Prefer: return=minimal drops the 404s; depth-noroot the
			// collection itself.
			try dav.writeFile("/c1/f.txt", "f")
			let find = try web.request(http.Method.Other, "/dav/c1/")
			find.rawMethod = "PROPFIND"
			find.headers.set("Depth", "1")
			find.headers.set("Prefer", "return=minimal, depth-noroot")
			find.replaceBody("<?xml version=\"1.0\"?><D:propfind xmlns:D=\"DAV:\"><D:prop><D:getcontentlength/></D:prop></D:propfind>".bytes())
			let res = try web.do(find)
			let text = try res.text()
			assert res.header("Preference-Applied").contains("return=minimal") && !text.contains("404") && !text.contains("<D:href>/dav/c1/</D:href>") && text.contains("f.txt")
			// POST to the add-member URL (RFC 5995).
			let addMember = try dav.property("/c1", "DAV:", "add-member")
			assert !(addMember is none) && (addMember.value + addMember.markup).contains("/dav/c1/?add-member")
			let post = try web.post("/dav/c1/?add-member", "text/plain", "hello".bytes())
			assert post.status == 201 && post.header("Location").startsWith("/dav/c1/") && post.header("Location").endsWith(".txt")
			let made = post.header("Location")["/dav".len():]
			assert (try dav.readText(made)) == "hello"
			assert (try web.post("/dav/c1/", "text/plain", "x".bytes())).status == 405
			try site.close()
			return none
		}

		@test()
		def enforcesQuotas() !none {
			let (site, server, _) = try share()
			server.quota = 1000
			let dav = clientOf(site)
			let block byte[] = []
			block.len(600)
			try dav.writeFile("/one.bin", block)
			let (used, available) = try dav.quota("/")
			assert used == 600 && available == 400
			let refused = ""
			dav.writeFile("/two.bin", block) onerror (err error) {
				refused = err.message
				recover none
			}
			assert refused.contains("507")
			assert !(try dav.exists("/two.bin"))
			// Replacing a file counts its old size out.
			try dav.writeFile("/one.bin", block)
			return none
		}
	}
}
