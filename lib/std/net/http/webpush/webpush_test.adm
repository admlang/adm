partial module std.net.http.webpush {
	use (
		std.testing
		std.time
		std.crypto
		std.crypto::(ECDSAPublicKey, ECDHKeyPair, scalarBaseMult, unmarshalPoint)
		std.net.http
		std.net.http.httptest
		std.proto.auth.jose
	)

	// What the push service of the suite was sent.
	internal struct PushReceived {
		method        string
		path          string
		ttl           string
		urgency       string
		topic         string
		encoding      string
		authorization string
		body          byte[]
	}

	// A push service for the suite: keeps each request and answers with
	// status (201 with a Location by default), Retry-After when set.
	internal type TestPushService {
		received   PushReceived[]
		status     int            = 201
		retryAfter string

		// Serve implements http.Handler.
		def serve(ctx http.Context) !none {
			let body = try ctx.bytes()
			let h = ctx.request.headers
			received.push(PushReceived{method: ctx.request.method.name, path: ctx.request.url.path, ttl: h.get("TTL"), urgency: h.get("Urgency"), topic: h.get("Topic"), encoding: h.get("Content-Encoding"), authorization: h.get("Authorization"), body: body})
			ctx.setHeader("Location", "/message/{received.len()}") when status == 201
			ctx.setHeader("Retry-After", retryAfter) unless retryAfter.isEmpty()
			return try ctx.blob(status, "text/plain", "answer {status}".bytes())
		}
	}

	// The test vector of RFC 8291 Appendix A (also its section 5 example).
	const rfcPlaintext = "When I grow up, I want to be a watermelon"
	const rfcAsPrivate = "yfWPiYE-n46HLnH0KqZOF1fJJU3MYrct3AELtAQ-oRw"
	const rfcUaPrivate = "q1dXpw3UpT5VOmu_cf_v6ih07Aems3njxI-JWgLcM94"
	const rfcUaPublic = "BCVxsr7N_eNgVRqvHtD0zTZsEc6-VV-JvLexhqUzORcxaOzi6-AYWXvTBHm4bjyPjs7Vd8pZGH6SRpkNtoIAiw4"
	const rfcSalt = "DGv6ra1nlYgDCS1FRnbzlw"
	const rfcAuth = "BTBZMqHH6r4Tts7J_aSIgg"
	const rfcBody = "DGv6ra1nlYgDCS1FRnbzlwAAEABBBP4z9KsN6nGRTbVYI_c7VJSPQTBtkgcy27mlmlMoZIIgDll6e3vCYLocInmYWAmS6TlzAC8wEqKK6PBru3jl7A_yl95bQpu6cVPTpK4Mqgkf1CXztLVBSt2Ks3oZwbuwXPXLWyouBWLVWGNWQexSgSxsj_Qulcy4a-fN"

	// The example of RFC 8292 §2.4: a token and the key that signed it.
	const rfcToken = "eyJ0eXAiOiJKV1QiLCJhbGciOiJFUzI1NiJ9.eyJhdWQiOiJodHRwczovL3B1c2guZXhhbXBsZS5uZXQiLCJleHAiOjE0NTM1MjM3NjgsInN1YiI6Im1haWx0bzpwdXNoQGV4YW1wbGUuY29tIn0.i3CYb7t4xfxCDquptFOepC9GAu_HLGkMlMuCGSK2rpiUfnK9ojFwDXb1JrErtmysazNjjvW2L9OkSSHzvoD1oA"
	const rfcVapidKey = "BA1Hxzyi1RUM1b5wjxsn7nGxAszw2u61m164i3MrAIxHF6YK5h4SDYic-dRuU_RCPCfA5aq9ojSwk5Y2EmClBPs"

	internal def zeros32() byte[] {
		let out byte[]
		out.len(32)
		return out
	}

	// A user agent's key pair and secret, made for a test.
	internal def userAgent() !(bigint, Subscription) {
		let pair = try crypto.ecdhKeyPair(crypto.p256)
		let auth = try crypto.rand(16)
		return (pair.scalar, Subscription{endpoint: "", p256dh: b64url(crypto.marshalPoint(crypto.p256, pair.public)), auth: b64url(auth)})
	}

	// What sending payload fails with; fails when it does not fail with a
	// PushError.
	internal def failureOf(sender Sender, sub Subscription, payload byte[]) !PushError {
		let found ?PushError = none
		sender.send(sub, payload) onerror (err error) {
			found = err when err is PushError
			recover PushMessage{}
		}
		fail "expected a PushError" when found is none
		return found
	}

	check "Web Push" {
		// RFC 8291 Appendix A byte for byte, and the user agent's side reads it.
		@test()
		def encryptsTheRFCExample() !none {
			let asScalar = parseBigInt(try b64urlDecode(rfcAsPrivate))
			let ephemeral = ECDHKeyPair{scalar: asScalar, public: scalarBaseMult(crypto.p256, asScalar)}
			let body = try encryptPayload(try b64urlDecode(rfcUaPublic), try b64urlDecode(rfcAuth), rfcPlaintext.bytes(), ephemeral, try b64urlDecode(rfcSalt))
			assert b64url(body) == rfcBody
			let plain = try decryptPayload(parseBigInt(try b64urlDecode(rfcUaPrivate)), try b64urlDecode(rfcUaPublic), try b64urlDecode(rfcAuth), try b64urlDecode(rfcBody))
			assert string(plain) == rfcPlaintext
			let damaged = try b64urlDecode(rfcBody)
			damaged[100] = damaged[100] ^ 1
			assert decryptPayload(parseBigInt(try b64urlDecode(rfcUaPrivate)), try b64urlDecode(rfcUaPublic), try b64urlDecode(rfcAuth), damaged) is error
		}

		// The RFC 8292 example token verifies as ES256 against its key; ours carry
		// aud, exp and sub, verify against our public key, and keys read back.
		@test()
		def signsVapidTokens() !none {
			let point = try unmarshalPoint(crypto.p256, try b64urlDecode(rfcVapidKey))
			let rfcKey = new jose.Jwk(new ECDSAPublicKey(crypto.p256, point))
			let at = time.fromUnixNs(int64(1453520000) * 1000000000)
			let rfcClaims = try jose.verifyJwt(rfcToken, rfcKey, jose.Validation{algorithms: [jose.SignatureAlgorithm.ES256], audience: "https://push.example.net", now: at, typ: "JWT"})
			let rfcSubject = rfcClaims.subject
			assert !(rfcSubject is none) && rfcSubject == "mailto:push@example.com"
			let key = try generateVapidKey("mailto:ops@example.com")
			let expires = time.now() + 12h
			let token = try key.token("https://push.example.net", expires)
			let claims = try jose.verifyJwt(token, new jose.Jwk(key.key.publicKey()), jose.Validation{algorithms: [jose.SignatureAlgorithm.ES256], audience: "https://push.example.net", typ: "JWT"})
			let subject = claims.subject
			assert !(subject is none) && subject == "mailto:ops@example.com"
			let back = try parseVapidKey(key.privateKey().reveal(), "mailto:ops@example.com")
			assert back.publicKey() == key.publicKey() && key.publicKey().len() == 87
			assert parseVapidKey("AAAA", "x") is error && parseVapidKey(b64url(zeros32()), "x") is error
		}

		// The browser's PushSubscription JSON reads; missing or malformed parts fail.
		@test()
		def readsSubscriptions() !none {
			let sub = try parseSubscription("\{\"endpoint\":\"https://push.example.net/p/JzLQ\",\"expirationTime\":null,\"keys\":\{\"p256dh\":\"{rfcUaPublic}\",\"auth\":\"{rfcAuth}\"\}\}")
			assert sub.endpoint == "https://push.example.net/p/JzLQ" && sub.auth == rfcAuth
			for let text in ["[]", "\{\"endpoint\":\"https://x/y\"\}", "\{\"endpoint\":\"http://x/y\",\"keys\":\{\"p256dh\":\"{rfcUaPublic}\",\"auth\":\"{rfcAuth}\"\}\}", "\{\"endpoint\":\"https://x/y\",\"keys\":\{\"p256dh\":\"AAAA\",\"auth\":\"{rfcAuth}\"\}\}", "\{\"endpoint\":\"https://x/y\",\"keys\":\{\"p256dh\":\"{rfcUaPublic}\",\"auth\":\"AAAA\"\}\}"] {
				assert parseSubscription(text) is error
			}
		}

		// A send reaches the push service with TTL, Urgency, Topic, aes128gcm and a
		// VAPID token reused for the origin; the user agent decrypts it; cancel
		// deletes the message; the service's refusals become PushError kinds.
		@test()
		def talksToAPushService() !none {
			let pushService = new TestPushService()
			let server = new httptest.Server(pushService)
			try server.startTLS()
			defer server.close()
			let (uaKey, sub) = try userAgent()
			sub.endpoint = server.url + "/push/abc"
			let key = try generateVapidKey("mailto:ops@example.com")
			let sender = new Sender(key)
			sender.client = server.client()
			let sent = try sender.send(sub, "hello", ttl = 90s, urgency = Urgency.High, topic = "news")
			assert sent.status == 201 && sent.location == "/message/1"
			let got = pushService.received[0]
			assert got.method == "POST" && got.path == "/push/abc" && got.ttl == "90" && got.urgency == "high" && got.topic == "news" && got.encoding == "aes128gcm"
			assert got.authorization.startsWith("vapid t=") && got.authorization.endsWith(", k={key.publicKey()}")
			let plain = try decryptPayload(uaKey, try b64urlDecode(sub.p256dh), try b64urlDecode(sub.auth), got.body)
			assert string(plain) == "hello"
			try sender.send(sub)
			assert pushService.received[1].body.len() == 0 && pushService.received[1].encoding == "" && pushService.received[1].ttl == "2419200"
			assert pushService.received[1].authorization == got.authorization
			let absolute = PushMessage{location: server.url + "/message/1", status: 201}
			pushService.status = 204
			try sender.cancel(absolute)
			assert pushService.received[2].method == "DELETE" && pushService.received[2].path == "/message/1"
			pushService.status = 410
			let gone = try failureOf(sender, sub, "x".bytes())
			assert gone.kind == PushErrorKind.Gone && gone.status == 410 && gone.body == "answer 410"
			try sender.cancel(absolute)
			pushService.status = 429
			pushService.retryAfter = "30"
			let busy = try failureOf(sender, sub, "x".bytes())
			let wait = busy.retryAfter
			assert busy.kind == PushErrorKind.RateLimited && !(wait is none) && wait == 30s
			pushService.retryAfter = ""
			pushService.status = 403
			assert (try failureOf(sender, sub, "x".bytes())).kind == PushErrorKind.Unauthorized
			pushService.status = 502
			assert (try failureOf(sender, sub, "x".bytes())).kind == PushErrorKind.Unavailable
			let big byte[]
			big.len(maxPayload + 1)
			assert (try failureOf(sender, sub, big)).kind == PushErrorKind.TooLarge
			assert sender.send(sub, "x", topic = "not a topic!") is error
			let count = pushService.received.len()
			assert count == 8
		}
	}
}
