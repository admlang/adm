partial module std.net.http.websocket {
	use (
		std.crypto::(rand)
		std.data.encoding::(base64encode)
		std.net.http::(Header, Method, Request, Response, Transport, newRequest, defaultTransport)
		std.net.url
		std.time
	)

	// DialOptions steers a client connection: the subprotocols to offer,
	// extra request headers (`Origin`, `Cookie`, `Authorization`), the
	// transport to dial through (proxies and TLS settings), the handshake
	// timeout, whether to offer permessage-deflate (RFC 7692; the
	// connection's `compression` says whether the server took it), and
	// whether to offer it with context takeover, where each side's
	// compressor keeps its history between messages: better ratios on
	// small similar messages, 32 KiB of history held per connection.
	struct DialOptions {
		subprotocols    string[]   = []
		headers         ?Header
		transport       ?Transport
		timeout         duration   = 30s
		compression     bool       = false
		contextTakeover bool       = false
	}

	// dial opens a WebSocket connection to a `ws://` or `wss://` URL
	// (`http` and `https` are accepted too) and returns it with the
	// server's `101` response. Fails with WebSocketError Handshake when
	// the server answers anything else or its accept key or subprotocol
	// is wrong, NetError when the dial does, TLSError for a `wss` chain
	// that does not verify, HttpError for a URL that does not parse.
	def dial(target string, options DialOptions = DialOptions{}) !(Conn, Response) {
		let parsed = try url.parse(target)
		let scheme = parsed.scheme.lower()
		fail wsError(ErrorKind.Handshake, "scheme {parsed.scheme} is not ws or wss") unless scheme := "ws" || "wss" || "http" || "https"
		parsed.scheme = (scheme := "wss" || "https") ?? ("https", "http")
		let req = try newRequest(Method.GET, parsed)
		let given = options.headers
		if !(given is none) {
			for let (_, name) in given.keys() {
				for let (_, value) in given.values(name) {
					req.headers.add(name, value)
				}
			}
		}
		let key = base64encode(try rand(16))
		req.headers.set("Connection", "Upgrade")
		req.headers.set("Upgrade", "websocket")
		req.headers.set("Sec-WebSocket-Version", "13")
		req.headers.set("Sec-WebSocket-Key", key)
		req.headers.set("Sec-WebSocket-Protocol", options.subprotocols.join(", ")) when options.subprotocols.len() > 0
		req.headers.set("Sec-WebSocket-Extensions", (options.contextTakeover ?? (deflateExtension, deflateOffer)) + clientWindowOffer) when options.compression
		req.deadline = time.now() + options.timeout when options.timeout > 0s
		let t = options.transport
		let transport Transport = t is none ?? (defaultTransport(), t)
		let (res, stream, buffered) = try transport.upgrade(req)
		let failure ?error = none
		let contexts = checkResponse(res, key, options) onerror (err error) {
			failure = err
			recover (false, false, 15)
		}
		if !(failure is none) {
			stream.close() onerror recover none
			fail failure
		}
		let conn = new Conn(stream, buffered, true)
		conn.subprotocol = res.headers.get("Sec-WebSocket-Protocol")
		conn.compression = res.headers.get("Sec-WebSocket-Extensions") != ""
		let (serverKeeps, clientKeeps, windowBits) = contexts
		conn.sendContextTakeover = clientKeeps
		conn.receiveContextTakeover = serverKeeps
		conn.sendWindowBits = windowBits
		return (conn, res)
	}

	// checkResponse validates the server's answer to the upgrade and
	// returns whether the server and the client keep their compression
	// context, and the window bits the client compresses within.
	internal def checkResponse(res Response, key string, options DialOptions) !(bool, bool, int) {
		let offered = options.subprotocols
		fail wsError(ErrorKind.Handshake, "server answered {res.status} instead of 101") when res.status != 101
		fail wsError(ErrorKind.Handshake, "server did not upgrade to websocket") unless res.headers.hasToken("Upgrade", "websocket")
		fail wsError(ErrorKind.Handshake, "server Connection header does not name upgrade") unless res.headers.hasToken("Connection", "upgrade")
		fail wsError(ErrorKind.Handshake, "server Sec-WebSocket-Accept does not match the key") when res.headers.get("Sec-WebSocket-Accept").trim() != acceptKey(key)
		let chosen = res.headers.get("Sec-WebSocket-Protocol")
		fail wsError(ErrorKind.Handshake, "server chose subprotocol {chosen}, which was not offered") when chosen != "" && !offered.includes(chosen)
		let extensions = res.headers.values("Sec-WebSocket-Extensions").join(", ")
		return (false, false, 15) when extensions.trim() == ""
		fail wsError(ErrorKind.Handshake, "server accepted an extension that was not offered") unless options.compression
		return try checkDeflate(extensions, options.contextTakeover)
	}
}
