@os("wasm")
partial module std.net.http.websocket {
	use std.testing

	check "browser WebSocket framing" {
		// Frames as `Conn` writes them read back whole, masked or not, and a
		// partial frame waits for the rest.
		@test()
		def framesReadBack() {
			let key = [byte(1), byte(2), byte(3), byte(4)]
			let masked = encodeFrame(true, opcodeText, "ping text".bytes(), key)
			let (frame, used) = takeFrame(masked)
			assert used == masked.len()
			assert frame.fin && frame.opcode == opcodeText && string(frame.payload) == "ping text"
			let (cut, taken) = takeFrame(masked[0:masked.len() - 1])
			assert taken == 0 && cut.payload.len() == 0
			let long byte[]
			long.len(70000)
			long[69999] = byte(7)
			let wire = encodeFrame(false, opcodeBinary, long, key) + encodeFrame(true, opcodeContinuation, [byte(9)])
			let (first, took) = takeFrame(wire)
			assert !first.fin && first.payload.len() == 70000 && first.payload[69999] == byte(7)
			let (second, rest) = takeFrame(wire[took:])
			assert second.fin && second.opcode == opcodeContinuation && rest == wire.len() - took
		}
	}
}
