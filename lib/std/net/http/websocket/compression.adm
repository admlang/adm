partial module std.net.http.websocket {
	// The extension of RFC 7692 as it appears in `Sec-WebSocket-Extensions`.
	const deflateExtension = "permessage-deflate"

	// What both sides of this implementation send: every message is
	// compressed on its own, so neither side keeps a window between
	// messages.
	const deflateOffer = "permessage-deflate; server_no_context_takeover; client_no_context_takeover"

	// What a client adds to its offer: the server may name the window this
	// side compresses within.
	const clientWindowOffer = "; client_max_window_bits"

	// Messages shorter than this go out uncompressed, DEFLATE would not
	// shrink them.
	const compressMin = 64

	// What a sender strips from the end of a compressed message (the
	// empty stored block of a sync flush), followed by an empty final
	// block so the decompressor meets the end of a stream.
	const deflateTail = byte[0x00, 0x00, 0xff, 0xff, 0x01, 0x00, 0x00, 0xff, 0xff]

	// DeflateSink collects what the compressor produces until it goes out
	// in a frame. Implements std.io.Writer; it cannot fail.
	internal type DeflateSink {
		data byte[]

		def new() {}

		def write(chunk byte[]) !int {
			data = data + chunk
			return chunk.len()
		}
	}

	// The longest distance a DEFLATE match reaches back: what a receiver
	// keeps of earlier messages under context takeover.
	const deflateWindow = 32768

	// acceptDeflate picks, from a client's `Sec-WebSocket-Extensions`
	// values, the first permessage-deflate offer this side can honour and
	// returns the response value, "" when there is none, with whether the
	// server and the client keep their compression context between
	// messages, and the window bits this side compresses within. Without
	// `takeover` neither keeps its context. With it each side does unless
	// the offer says otherwise (`server_no_context_takeover`,
	// `client_no_context_takeover`). A `server_max_window_bits` of the
	// offer is kept to and repeated in the answer. An offer is refused for
	// a parameter that is unknown, repeated or malformed.
	internal def acceptDeflate(offers string[], takeover bool = false) (string, bool, bool, int) {
		for let offer in offers {
			let parts = extensionParts(offer)
			continue when parts.len() == 0 || parts[0] != deflateExtension
			let seen string[] = []
			let usable = true
			let bits = 15
			for let i = 1; i < parts.len(); i++ {
				let (name, value) = extensionParam(parts[i])
				usable = false when seen.includes(name)
				seen.push(name)
				usable = false when value != "" && (name := "server_no_context_takeover" || "client_no_context_takeover")
				usable = false when name == "client_max_window_bits" && value != "" && !isWindowBits(value)
				if name == "server_max_window_bits" {
					bits = windowBits(value)
					usable = false when bits == 0
				}
				usable = false unless name := "server_no_context_takeover" || "client_no_context_takeover" || "client_max_window_bits" || "server_max_window_bits"
			}
			continue unless usable
			let window = seen.includes("server_max_window_bits") ?? ("; server_max_window_bits={bits}", "")
			return (deflateOffer + window, false, false, bits) unless takeover
			let serverKeeps = !seen.includes("server_no_context_takeover")
			let clientKeeps = !seen.includes("client_no_context_takeover")
			let answer = deflateExtension
			answer = answer + "; server_no_context_takeover" unless serverKeeps
			answer = answer + "; client_no_context_takeover" unless clientKeeps
			return (answer + window, serverKeeps, clientKeeps, bits)
		}
		return ("", false, false, 15)
	}

	// checkDeflate validates a server's answer to this side's offer and
	// returns whether the server and the client keep their compression
	// context between messages, and the window bits this side compresses
	// within (`client_max_window_bits`, 15 without one). The answer must
	// be the one extension. To
	// `deflateOffer` (`takeover` false) it must carry
	// `server_no_context_takeover`, since the server's messages are then
	// decoded one by one; to the bare offer each side keeps its context
	// unless the answer says otherwise. Fails with WebSocketError Handshake.
	internal def checkDeflate(answer string, takeover bool = false) !(bool, bool, int) {
		fail wsError(ErrorKind.Handshake, "server accepted more than one extension") when answer.contains(",")
		let parts = extensionParts(answer)
		fail wsError(ErrorKind.Handshake, "server accepted extension {answer}, which was not offered") when parts.len() == 0 || parts[0] != deflateExtension
		let seen string[] = []
		let bits = 15
		for let i = 1; i < parts.len(); i++ {
			let (name, value) = extensionParam(parts[i])
			fail wsError(ErrorKind.Handshake, "permessage-deflate parameter {name} is repeated") when seen.includes(name)
			seen.push(name)
			fail wsError(ErrorKind.Handshake, "{name} {value} is not 8 to 15") when (name := "server_max_window_bits" || "client_max_window_bits") && !isWindowBits(value)
			fail wsError(ErrorKind.Handshake, "server answered permessage-deflate parameter {name}, which was not offered") unless name := "server_no_context_takeover" || "client_no_context_takeover" || "server_max_window_bits" || "client_max_window_bits"
			bits = windowBits(value) when name == "client_max_window_bits"
		}
		let serverResets = seen.includes("server_no_context_takeover")
		fail wsError(ErrorKind.Handshake, "server did not agree to server_no_context_takeover") unless takeover || serverResets
		return (false, false, bits) unless takeover
		return (!serverResets,!seen.includes("client_no_context_takeover"), bits)
	}

	// extensionParts splits one extension into its name and parameters,
	// trimmed and lower-cased.
	internal def extensionParts(extension string) string[] {
		let out string[] = []
		for let piece in extension.split(";") {
			let part = piece.trim().lower()
			out.push(part) unless part == ""
		}
		return out
	}

	// extensionParam splits `name=value` (the value possibly quoted) into
	// its halves, the value "" when there is none.
	internal def extensionParam(param string) (string, string) {
		let at = param.indexOf("=")
		return (param, "") when at < 0
		let value = param[at + 1:].trim()
		value = value[1:value.len() - 1] when value.len() >= 2 && value.startsWith("\"") && value.endsWith("\"")
		return (param[0:at].trim(), value)
	}

	// isWindowBits reports whether the text is a window size of 8 to 15.
	internal def isWindowBits(value string) bool {
		return windowBits(value) != 0
	}

	// windowBits reads a window size of 8 to 15, 0 for anything else.
	internal def windowBits(value string) int {
		for let bits = 8; bits <= 15; bits++ {
			return bits when value == bits.str()
		}
		return 0
	}

	// incompleteTail counts the bytes at the end of data that start a
	// UTF-8 sequence without finishing it, 0 to 3, so text arriving in
	// pieces is validated up to the last whole character.
	internal def incompleteTail(data byte[]) int {
		let size = data.len()
		for let back = 1; back <= 3 && back <= size; back++ {
			let b = int(data[size - back])
			continue when (b & 0xc0) == 0x80
			let need = 1
			need = 2 when b >= 0xc0
			need = 3 when b >= 0xe0
			need = 4 when b >= 0xf0
			return need > back ?? (back, 0)
		}
		return 0
	}
}
