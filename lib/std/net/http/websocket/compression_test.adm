partial module std.net.http.websocket {
	use (
		std.bytes
		std.bytes::(Buffer)
		std.net.http.httptest
		std.testing
	)

	// answerTo is the response value acceptDeflate gives the offers.
	internal def answerTo(offers string[], takeover bool = false) string {
		let (answer, _, _, _) = acceptDeflate(offers, takeover)
		return answer
	}

	// contexts spells which side keeps its context: "server client", either
	// or "".
	internal def contexts(serverKeeps bool, clientKeeps bool) string {
		return ((serverKeeps ?? ("server", "")) + " " + (clientKeeps ?? ("client", ""))).trim()
	}

	check "Compression" {
		@test()
		def TestDeflateNegotiation() !none {
			assert answerTo(["permessage-deflate"]) == deflateOffer
			assert answerTo(["x-webkit-deflate-frame", "Permessage-Deflate; client_max_window_bits"]) == deflateOffer
			assert answerTo(["permessage-deflate; client_max_window_bits=10; server_no_context_takeover"]) == deflateOffer
			// A window asked of this side is kept to and named in the answer.
			assert answerTo(["permessage-deflate; server_max_window_bits=10", "permessage-deflate"]) == deflateOffer + "; server_max_window_bits=10"
			assert answerTo(["permessage-deflate; server_max_window_bits=\"15\""]) == deflateOffer + "; server_max_window_bits=15"
			assert answerTo(["permessage-deflate; server_max_window_bits=9; server_no_context_takeover"], true) == "permessage-deflate; server_no_context_takeover; server_max_window_bits=9"
			assert answerTo(["permessage-deflate; server_max_window_bits=7", "permessage-deflate"]) == deflateOffer
			assert answerTo(["permessage-deflate; server_max_window_bits"]) == ""
			let (_, _, _, askedBits) = acceptDeflate(["permessage-deflate; server_max_window_bits=10"])
			assert askedBits == 10
			let (_, _, _, freeBits) = acceptDeflate(["permessage-deflate; client_max_window_bits"])
			assert freeBits == 15
			assert answerTo(["permessage-deflate; unknown_parameter"]) == ""
			assert answerTo(["permessage-deflate; client_no_context_takeover; client_no_context_takeover"]) == ""
			assert answerTo(["permessage-deflate; client_max_window_bits=7"]) == ""
			assert answerTo(["permessage-deflate; server_no_context_takeover=1"]) == ""
			assert answerTo([]) == ""

			// With takeover each side keeps its context unless the offer
			// says otherwise, and the answer repeats what it said.
			assert answerTo(["permessage-deflate; client_max_window_bits"], true) == "permessage-deflate"
			assert answerTo(["permessage-deflate; server_no_context_takeover"], true) == "permessage-deflate; server_no_context_takeover"
			assert answerTo(["permessage-deflate; client_no_context_takeover; server_no_context_takeover"], true) == "permessage-deflate; server_no_context_takeover; client_no_context_takeover"
			let (_, serverKeeps, clientKeeps, _) = acceptDeflate(["permessage-deflate; client_no_context_takeover"], true)
			assert contexts(serverKeeps, clientKeeps) == "server"
			let (_, plainServer, plainClient, _) = acceptDeflate(["permessage-deflate"])
			assert contexts(plainServer, plainClient) == ""
			let (bothServer, bothClient, bothBits) = try checkDeflate("permessage-deflate", true)
			assert bothBits == 15
			assert contexts(bothServer, bothClient) == "server client"
			let (oneServer, oneClient, oneBits) = try checkDeflate("permessage-deflate; server_no_context_takeover; server_max_window_bits=10; client_max_window_bits=12", true)
			assert oneBits == 12
			assert contexts(oneServer, oneClient) == "client"
			let (noServer, noClient, _) = try checkDeflate(deflateOffer, true)
			assert contexts(noServer, noClient) == ""
			let (offServer, offClient, _) = try checkDeflate(deflateOffer)
			assert contexts(offServer, offClient) == ""

			try checkDeflate(deflateOffer)
			try checkDeflate("permessage-deflate; server_no_context_takeover; server_max_window_bits=12")
			let refused = [
				"permessage-deflate",
				"permessage-deflate; client_no_context_takeover",
				"permessage-deflate; server_no_context_takeover; client_max_window_bits=7",
				"permessage-deflate; server_no_context_takeover; client_max_window_bits",
				"permessage-deflate; server_no_context_takeover; server_max_window_bits=16",
				"permessage-deflate; server_no_context_takeover, permessage-deflate; server_no_context_takeover",
				"x-webkit-deflate-frame",
			]
			let unasked = "ok"
			checkDeflate("permessage-deflate; client_window=12", true) onerror (err error) {
				unasked = "handshake"
				recover (false, false, 15)
			}
			assert unasked == "handshake"
			for let (_, answer) in refused {
				let outcome = "ok"
				checkDeflate(answer) onerror (err error) {
					outcome = "handshake" when err is WebSocketError && err.kind == ErrorKind.Handshake
					recover (false, false, 15)
				}
				fail "accepted {answer}" when outcome != "handshake"
			}
			return none
		}

		@test()
		def TestDeflateOnTheWire() !none {
			// The RFC 7692 section 7.2.3 vectors: "Hello" whole, then in two
			// frames, then an uncompressed message on the same connection.
			let input = byte[0xc1, 0x07, 0xf2, 0x48, 0xcd, 0xc9, 0xc9, 0x07, 0x00] + byte[0x41, 0x03, 0xf2, 0x48, 0xcd, 0x80, 0x04, 0xc9, 0xc9, 0x07, 0x00] + encodeFrame(true, opcodeText, "plain".bytes())
			let client = new Conn(new BufferStream(new Buffer(input), new Buffer()), new bytes.Reader([]), true)
			client.compression = true
			assert (try client.readText()) == "Hello"
			assert (try client.readText()) == "Hello"
			assert (try client.readText()) == "plain"

			// What goes out: short messages as they are, long ones smaller
			// and with RSV1, and a peer reads them back.
			let text = "the quick brown fox jumps over the lazy dog. ".repeat(40)
			let out = new Buffer()
			let sender = new Conn(new BufferStream(new Buffer(), out), new bytes.Reader([]), true)
			sender.compression = true
			try sender.writeText("short")
			try sender.writeText(text)
			let w = sender.writer(MessageType.Binary)
			for let i = 0; i < 20; i++ {
				try w.write(text.bytes())
			}
			try w.close()
			try sender.writeText(text)
			let frames = new FrameReader(new bytes.Reader(out.bytes()))
			frames.allowCompressed = true
			let short = try frames.next()
			assert !short.compressed && string(short.payload) == "short"
			let long = try frames.next()
			assert long.compressed && long.fin && long.payload.len() < text.len() / 4
			let receiver = new Conn(new BufferStream(new Buffer(out.bytes()), new Buffer()), new bytes.Reader([]), false)
			receiver.compression = true
			assert (try receiver.readText()) == "short"
			assert (try receiver.readText()) == text
			// The fragmented one through a reader.
			let message = try receiver.reader()
			assert message.kind == MessageType.Binary
			let total = 0
			let buf byte[]
			buf.len(1000)
			for {
				let n = try message.read(buf)
				break when n == 0
				total += n
			}
			assert total == text.len() * 20
			assert (try receiver.readText()) == text

			// Decompressed size counts against the limit.
			let small = new Conn(new BufferStream(new Buffer(out.bytes()), new Buffer()), new bytes.Reader([]), false)
			small.compression = true
			small.maxMessageSize = 1000
			assert (try small.readText()) == "short"
			let limited = "ok"
			small.readText() onerror (err error) {
				limited = "too large" when err is WebSocketError && err.kind == ErrorKind.TooLarge
				recover ""
			}
			assert limited == "too large"

			// RSV1 without the extension, and data that is not DEFLATE.
			let sentClose = new Buffer()
			let strict = new Conn(new BufferStream(new Buffer(byte[0xc1, 0x07, 0xf2, 0x48, 0xcd, 0xc9, 0xc9, 0x07, 0x00]), sentClose), new bytes.Reader([]), true)
			let outcome = "ok"
			strict.readText() onerror (err error) {
				outcome = "protocol" when err is WebSocketError && err.kind == ErrorKind.Protocol
				recover ""
			}
			assert outcome == "protocol"
			let garbage = new Conn(new BufferStream(new Buffer(byte[0xc1, 0x04, 0xff, 0xff, 0xff, 0xff]), new Buffer()), new bytes.Reader([]), true)
			garbage.compression = true
			outcome = "ok"
			garbage.readText() onerror (err error) {
				outcome = "protocol" when err is WebSocketError && err.kind == ErrorKind.Protocol
				recover ""
			}
			assert outcome == "protocol"
			return none
		}

		@test()
		def TestDeflateContextTakeover() !none {
			// The RFC 7692 section 7.2.3.2 vectors: the second "Hello" refers
			// back to the first.
			let input = byte[0xc1, 0x07, 0xf2, 0x48, 0xcd, 0xc9, 0xc9, 0x07, 0x00] + byte[0xc1, 0x05, 0xf2, 0x00, 0x11, 0x00, 0x00]
			let client = new Conn(new BufferStream(new Buffer(input), new Buffer()), new bytes.Reader([]), true)
			client.compression = true
			client.receiveContextTakeover = true
			assert (try client.readText()) == "Hello"
			assert (try client.readText()) == "Hello"
			// Without the context the second one cannot be decoded.
			let alone = new Conn(new BufferStream(new Buffer(input), new Buffer()), new bytes.Reader([]), true)
			alone.compression = true
			assert (try alone.readText()) == "Hello"
			let outcome = "decoded"
			alone.readText() onerror (err error) {
				outcome = "protocol" when err is WebSocketError && err.kind == ErrorKind.Protocol
				recover ""
			}
			assert outcome == "protocol"

			// Sending: the same message again costs a few bytes, an
			// uncompressed one in between changes nothing, and a history
			// longer than the window still decodes.
			let text = "\{\"type\":\"quote\",\"symbol\":\"ADM\",\"bid\":101.25,\"ask\":101.5\}"
			let out = new Buffer()
			let sender = new Conn(new BufferStream(new Buffer(), out), new bytes.Reader([]), true)
			sender.compression = true
			sender.sendContextTakeover = true
			try sender.writeText(text)
			try sender.writeText(text)
			try sender.writeText("")
			try sender.writeText("hi")
			let long = "0123456789abcdefghijklmnopqrstuvwxyz ".repeat(2000)
			try sender.writeText(long)
			try sender.writeText(text)
			let frames = new FrameReader(new bytes.Reader(out.bytes()))
			frames.allowCompressed = true
			let first = try frames.next()
			let second = try frames.next()
			assert first.compressed && second.compressed
			fail "first {first.payload.len()} second {second.payload.len()}" unless second.payload.len() * 4 < first.payload.len()
			let blank = try frames.next()
			assert !blank.compressed && blank.payload.len() == 0
			let short = try frames.next()
			assert short.compressed
			let receiver = new Conn(new BufferStream(new Buffer(out.bytes()), new Buffer()), new bytes.Reader([]), false)
			receiver.compression = true
			receiver.receiveContextTakeover = true
			assert (try receiver.readText()) == text
			assert (try receiver.readText()) == text
			assert (try receiver.readText()) == ""
			assert (try receiver.readText()) == "hi"
			assert (try receiver.readText()) == long
			assert (try receiver.readText()) == text
			return none
		}

		@test()
		def TestDeflateWindowBits() !none {
			// 600 bytes without a repeat, then the same again: the only
			// matches reach back 600 bytes, past a 512-byte window.
			let blob byte[]
			blob.len(1200)
			let state = 12345
			for let i = 0; i < 600; i++ {
				state = (state * 1103515245 + 12345) % 2147483648
				blob[i] = byte((state >> 16) & 0xff)
				blob[600 + i] = blob[i]
			}
			let sizes int[] = []
			for let (_, bits) in [15, 9] {
				let out = new Buffer()
				let sender = new Conn(new BufferStream(new Buffer(), out), new bytes.Reader([]), false)
				sender.compression = true
				sender.sendWindowBits = bits
				try sender.writeBinary(blob)
				sizes.push(out.bytes().len())
				let receiver = new Conn(new BufferStream(new Buffer(out.bytes()), new Buffer()), new bytes.Reader([]), true)
				receiver.compression = true
				let (kind, data) = try receiver.readMessage()
				assert kind == MessageType.Binary && data.hex() == blob.hex()
			}
			fail "window of 9 bits sent {sizes[1]} bytes, of 15 bits {sizes[0]}" unless sizes[0] < 900 && sizes[1] > 1100
			return none
		}

		@test()
		def TestDeflateOverLoopback() !none {
			let seen = new ServerSeen()
			let ts = try httptest.Server.start(try echoMux(seen))
			let (conn, res) = try dial(wsURL(ts, "/deflate"), DialOptions{compression: true})
			assert conn.compression
			assert res.headers.get("Sec-WebSocket-Extensions") == deflateOffer
			let text = "compress me, compress me again. ".repeat(3000)
			try conn.writeText(text)
			assert (try conn.readText()) == text
			try conn.writeText("tiny")
			assert (try conn.readText()) == "tiny"
			let blob byte[]
			blob.len(70000)
			for let i = 0; i < blob.len(); i++ {
				blob[i] = byte((i * i) % 251)
			}
			let w = conn.writer(MessageType.Binary)
			try w.write(blob[0:30000])
			try w.write(blob[30000:])
			try w.close()
			let (kind, data) = try conn.readMessage()
			assert kind == MessageType.Binary && data.hex() == blob.hex()
			try conn.close()

			// Context takeover end to end, and offered to a server that
			// compresses without it.
			let (keeping, kept) = try dial(wsURL(ts, "/takeover"), DialOptions{compression: true, contextTakeover: true})
			assert keeping.compression && keeping.sendContextTakeover && keeping.receiveContextTakeover
			assert kept.headers.get("Sec-WebSocket-Extensions") == "permessage-deflate"
			for let i = 0; i < 5; i++ {
				try keeping.writeText("tick {i}: " + text[0:200])
				assert (try keeping.readText()) == "tick {i}: " + text[0:200]
			}
			try keeping.close()
			let (reset, _) = try dial(wsURL(ts, "/deflate"), DialOptions{compression: true, contextTakeover: true})
			assert reset.compression && !reset.sendContextTakeover && !reset.receiveContextTakeover
			try reset.writeText(text)
			assert (try reset.readText()) == text
			try reset.close()

			// Offered to a server that does not take it, and not offered to
			// one that would.
			let (declined, _) = try dial(wsURL(ts, "/ws"), DialOptions{compression: true})
			assert !declined.compression
			try declined.writeText(text)
			assert (try declined.readText()) == text
			try declined.close()
			let (plain, _) = try dial(wsURL(ts, "/deflate"))
			assert !plain.compression
			try plain.writeText(text)
			assert (try plain.readText()) == text
			try plain.close()
			try ts.close()
			return none
		}
	}
}
