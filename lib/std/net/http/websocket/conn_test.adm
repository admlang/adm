partial module std.net.http.websocket {
	use (
		std.bytes
		std.bytes::(Buffer)
		std.net
		std.testing
	)

	// BufferStream is a net.Stream over two buffers, for tests.
	type BufferStream {
		input  Buffer
		output Buffer
		open   bool   = true

		def new(input Buffer, output Buffer) {
			self.input = input
			self.output = output
		}

		def read(data byte[], timeout duration) !int {
			return try input.read(data)
		}

		def write(data byte[], timeout duration) !int {
			return try output.write(data)
		}

		def close() !none {
			open = false
			return none
		}

		def isOpen() bool {
			return open
		}
	}

	check "Conn" {
		@test()
		def TestConnOverBuffers() !none {
			let masked = encodeFrame(true, opcodeText, "hello".bytes(), byte[1, 2, 3, 4])
			let stream = new BufferStream(new Buffer(masked), new Buffer())
			let conn = new Conn(stream, new bytes.Reader([]), false)
			let got = conn.readText() onerror (err error) {
				fail "memory read failed: {err.message}"
			}
			fail "memory got {got.bytes().hex()}" when got != "hello"
			// The same with the frame arriving through the prefix reader.
			let stream2 = new BufferStream(new Buffer(), new Buffer())
			let conn2 = new Conn(stream2, new bytes.Reader(masked), false)
			let got2 = conn2.readText() onerror (err error) {
				fail "prefix read failed: {err.message}"
			}
			fail "prefix got {got2.bytes().hex()}" when got2 != "hello"
			// Split: header through the prefix, rest through the stream.
			let stream3 = new BufferStream(new Buffer(masked[3:]), new Buffer())
			let conn3 = new Conn(stream3, new bytes.Reader(masked[0:3]), false)
			let got3 = conn3.readText() onerror (err error) {
				fail "split read failed: {err.message}"
			}
			fail "split got {got3.bytes().hex()}" when got3 != "hello"
			// A write from a client is masked; unmask and compare.
			let out = new Buffer()
			let writer = new Conn(new BufferStream(new Buffer(), out), new bytes.Reader([]), true)
			try writer.writeText("hello")
			let frame = try (new FrameReader(new bytes.Reader(out.bytes()))).next()
			fail "written payload {frame.payload.hex()} masked={frame.masked}" when string(frame.payload) != "hello"
			return none
		}

		@test()
		def TestMessageReader() !none {
			// "héllo wörld" in three frames, the first ending inside the é,
			// then a second message.
			let text = "héllo wörld".bytes()
			let key = byte[9, 8, 7, 6]
			let input = encodeFrame(false, opcodeText, text[0:2], key) + encodeFrame(true, opcodePing, "p".bytes(), key) + encodeFrame(false, opcodeContinuation, text[2:7], key) + encodeFrame(true, opcodeContinuation, text[7:], key) + encodeFrame(true, opcodeBinary, byte[1, 2, 3], key) + encodeFrame(false, opcodeText, "skipped ".bytes(), key) + encodeFrame(true, opcodeContinuation, "rest".bytes(), key) + encodeFrame(true, opcodeText, "last".bytes(), key)
			let conn = new Conn(new BufferStream(new Buffer(input), new Buffer()), new bytes.Reader([]), false)
			let message = try conn.reader()
			assert message.kind == MessageType.Text
			let got byte[]
			let buf byte[]
			buf.len(3)
			for {
				let n = try message.read(buf)
				break when n == 0
				got = got + buf[0:n]
			}
			assert string(got) == "héllo wörld"
			assert (try message.read(buf)) == 0
			let (kind, data) = try conn.readMessage()
			assert kind == MessageType.Binary && data.hex() == "010203"
			// A reader left half read: the rest of its message is skipped.
			let abandoned = try conn.reader()
			assert (try abandoned.read(buf)) == 3
			assert (try conn.readText()) == "last"

			// Text that ends inside a character is refused at the end, and a
			// bad byte as soon as it is read.
			let cases = [
				encodeFrame(false, opcodeText, "ok".bytes(), key) + encodeFrame(true, opcodeContinuation, byte[0xc3], key),
				encodeFrame(false, opcodeText, byte[0x61, 0xff, 0x62], key) + encodeFrame(true, opcodeContinuation, "x".bytes(), key),
			]
			for let (_, frames) in cases {
				let out = new Buffer()
				let bad = new Conn(new BufferStream(new Buffer(frames), out), new bytes.Reader([]), false)
				let r = try bad.reader()
				let outcome = "ok"
				let large byte[]
				large.len(64)
				for let i = 0; i < 3 && outcome == "ok"; i++ {
					r.read(large) onerror (err error) {
						outcome = "protocol" when err is WebSocketError && err.kind == ErrorKind.Protocol
						recover 0
					}
				}
				assert outcome == "protocol"
				let sent = try (new FrameReader(new bytes.Reader(out.bytes()))).next()
				assert sent.opcode == opcodeClose && sent.payload[0:2].hex() == "03EF"
			}
			return none
		}
	}
}
