partial module std.net.http.websocket {
	use std.io

	// Opcodes of RFC 6455 §5.2.
	const opcodeContinuation = 0
	const opcodeText = 1
	const opcodeBinary = 2
	const opcodeClose = 8
	const opcodePing = 9
	const opcodePong = 10

	// The longest payload a control frame may carry.
	const maxControlPayload = 125

	// Frame is one frame as decoded: whether it ends its message, the
	// opcode, the payload unmasked, and whether RSV1 marks the message it
	// starts as compressed (permessage-deflate).
	struct Frame {
		fin        bool
		opcode     int
		masked     bool
		payload    byte[]
		compressed bool   = false
	}

	// isControl reports whether an opcode is a control frame's.
	def isControl(opcode int) bool {
		return opcode >= 8
	}

	// encodeFrame writes a frame: FIN and opcode, the mask bit and the
	// payload length in its shortest form, then the masking key and the
	// payload masked with it when a key of four bytes is given (a client
	// sends masked, a server never does). `compressed` sets RSV1, for the
	// first frame of a permessage-deflate message.
	def encodeFrame(fin bool, opcode int, payload byte[], maskKey byte[] = [], compressed bool = false) byte[] {
		let first = opcode & 0x0f
		first |= 0x80 when fin
		first |= 0x40 when compressed
		let out = byte[byte(first)]
		let length = payload.len()
		let maskBit = maskKey.len() == 4 ?? (0x80, 0)
		if length < 126 {
			out.push(byte(maskBit | length))
		} else if length < 65536 {
			out.push(byte(maskBit | 126))
			out.push(byte(length >> 8))
			out.push(byte(length & 0xff))
		} else {
			out.push(byte(maskBit | 127))
			for let shift = 56; shift >= 0; shift -= 8 {
				out.push(byte((length >> shift) & 0xff))
			}
		}
		return out + payload when maskKey.len() != 4
		return out + maskKey + maskBytes(payload, maskKey)
	}

	// maskBytes applies (or removes) a four-byte mask, XOR per position.
	def maskBytes(data byte[], key byte[]) byte[] {
		let out byte[]
		out.len(data.len())
		for let i = 0; i < data.len(); i++ {
			out[i] = data[i] ^ key[i % 4]
		}
		return out
	}

	// FrameReader decodes frames from a byte source, refusing what the
	// protocol forbids: reserved bits, unknown opcodes, fragmented or
	// long control frames, lengths not in their shortest form, and a
	// payload above `maxPayload`. RSV1 passes on the frame that starts a
	// message once `allowCompressed` says permessage-deflate was agreed.
	// Fails with WebSocketError (Protocol or TooLarge), or with the
	// source's error.
	type FrameReader {
		source          io.Reader
		maxPayload      int       = 32 * 1024 * 1024
		allowCompressed bool      = false

		def new(source io.Reader) {
			self.source = source
		}

		// next reads one frame.
		def next() !Frame {
			let header byte[]
			header.len(2)
			try io.readFull(source, header)
			let fin = (header[0] & 0x80) != 0
			let compressed = (header[0] & 0x40) != 0
			fail wsError(ErrorKind.Protocol, "reserved bits set without an extension") when (header[0] & 0x30) != 0 || (compressed && !allowCompressed)
			let opcode = int(header[0] & 0x0f)
			fail wsError(ErrorKind.Protocol, "RSV1 on a frame that does not start a message") when compressed && !(opcode := opcodeText || opcodeBinary)
			fail wsError(ErrorKind.Protocol, "unknown opcode {opcode}") unless opcode := opcodeContinuation || opcodeText || opcodeBinary || opcodeClose || opcodePing || opcodePong
			let masked = (header[1] & 0x80) != 0
			let length = int(header[1] & 0x7f)
			if isControl(opcode) {
				fail wsError(ErrorKind.Protocol, "fragmented control frame") unless fin
				fail wsError(ErrorKind.Protocol, "control frame of {length} bytes") when length > maxControlPayload
			}
			if length == 126 {
				let ext byte[]
				ext.len(2)
				try io.readFull(source, ext)
				length = int(ext[0]) << 8 | int(ext[1])
				fail wsError(ErrorKind.Protocol, "length {length} not in its shortest form") when length < 126
			} else if length == 127 {
				let ext byte[]
				ext.len(8)
				try io.readFull(source, ext)
				fail wsError(ErrorKind.Protocol, "length above 2^63") when (ext[0] & 0x80) != 0
				length = 0
				for let i = 0; i < 8; i++ {
					length = length << 8 | int(ext[i])
				}
				fail wsError(ErrorKind.Protocol, "length {length} not in its shortest form") when length < 65536
			}
			fail wsError(ErrorKind.TooLarge, "frame of {length} bytes exceeds the limit of {maxPayload}") when length > maxPayload
			let key byte[]
			if masked {
				key.len(4)
				try io.readFull(source, key)
			}
			let payload byte[]
			payload.len(length)
			try io.readFull(source, payload) when length > 0
			payload = maskBytes(payload, key) when masked
			return Frame{fin: fin, opcode: opcode, masked: masked, payload: payload, compressed: compressed}
		}
	}

	// encodeClose is the payload of a close frame: the code big-endian,
	// then the reason as UTF-8, together at most 125 bytes.
	def encodeClose(code int, reason string) byte[] {
		let text = reason.bytes()
		text = text[0:maxControlPayload - 2] when text.len() > maxControlPayload - 2
		return byte[byte(code >> 8), byte(code & 0xff)] + text
	}

	// decodeClose reads a close frame's payload into (code, reason):
	// NoStatus for an empty payload. Fails with Protocol for a one-byte
	// payload, a code that may not be sent, or a reason that is not UTF-8.
	def decodeClose(payload byte[]) !(int, string) {
		return (int(CloseCode.NoStatus), "") when payload.len() == 0
		fail wsError(ErrorKind.Protocol, "close frame with a one-byte payload") when payload.len() == 1
		let code = int(payload[0]) << 8 | int(payload[1])
		fail wsError(ErrorKind.Protocol, "close code {code} may not be sent") unless isValidCloseCode(code)
		let reason = string(payload[2:])
		fail wsError(ErrorKind.Protocol, "close reason is not UTF-8") unless reason.isUTF8()
		return (code, reason)
	}
}
