partial module std.net.http.websocket {
	use std.time

	// Hub fans messages out to connections grouped by topic, the rooms of
	// a chat or the channels of a feed. Connections join and leave; a
	// broadcast goes to every member of the topic, and a member whose
	// write fails is dropped from every topic. Safe from many tasks.
	//
	//     let rooms = new Hub()
	//     rooms.join("lobby", conn)
	//     try rooms.broadcastText("lobby", "hello all")
	type Hub {
		topics map<string, Conn[]>

		def new() {}

		// join adds the connection to the topic; joining twice is once.
		atomic def join(topic string, conn Conn) {
			let members = topics.get(topic)
			if members is none {
				topics[topic] = [conn]
				return
			}
			for let (_, member) in members {
				return when member == conn
			}
			members.push(conn)
			topics[topic] = members
		}

		// leave removes the connection from the topic; an empty topic goes.
		atomic def leave(topic string, conn Conn) {
			let members = topics.get(topic)
			return when members is none
			let kept Conn[]
			for let (_, member) in members {
				kept.push(member) unless member == conn
			}
			if kept.len() == 0 {
				topics.delete(topic)
				return
			}
			topics[topic] = kept
		}

		// leaveAll removes the connection from every topic.
		atomic def leaveAll(conn Conn) {
			for let (topic, _) in topics {
				leave(topic, conn)
			}
		}

		// members is a copy of the topic's connections.
		atomic def members(topic string) Conn[] {
			let found = topics.get(topic)
			return [] when found is none
			return found
		}

		// count is how many connections the topic has.
		def count(topic string) int {
			return members(topic).len()
		}

		// broadcast sends the message to every member of the topic and
		// returns how many received it; a member whose write fails is
		// closed and dropped from every topic. Never fails: a broadcast
		// outlives its weakest member.
		def broadcast(topic string, kind MessageType, data byte[]) int {
			let sent = 0
			for let (_, member) in members(topic) {
				let ok = true
				member.writeMessage(kind, data) onerror (err error) {
					ok = false
					recover none
				}
				if ok {
					sent++
					continue
				}
				leaveAll(member)
				member.close(CloseCode.GoingAway) onerror recover none
			}
			return sent
		}

		// broadcastText is `broadcast` for a text message.
		def broadcastText(topic string, text string) int {
			return broadcast(topic, MessageType.Text, text.bytes())
		}
	}

	// keepAlive pings the connection every interval from its own task and
	// closes it with GoingAway when a pong does not come back within the
	// timeout, so a peer that vanished is noticed while the reader waits.
	// The pong is seen by whichever read runs on the connection; a
	// connection nobody reads times out. Returns when the connection
	// closes.
	async def keepAlive(conn Conn, interval duration, timeout duration = 10s) none {
		let awaiting = false
		let sentAt = time.now()
		for conn.isOpen() {
			time.sleep(interval)
			break unless conn.isOpen()
			if awaiting {
				awaiting = false when conn.lastPong.len() > 0
				if awaiting && time.since(sentAt) > timeout {
					conn.closeWith(int(CloseCode.GoingAway), "no pong within {timeout}") onerror recover none
					break
				}
				continue when awaiting
			}
			conn.lastPong = []
			sentAt = time.now()
			awaiting = true
			conn.ping("keepalive".bytes()) onerror recover none
		}
		return none
	}
}
