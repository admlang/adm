partial module std.net.http.websocket {
	use (
		std.net.http
		std.net.http.httptest
		std.testing
	)

	// flakyMux echoes at /ws, except that "drop" makes the server cut the
	// stream without a close frame and "bye" makes it close with Normal.
	internal def flakyMux() !http.ServeMux {
		let mux = new http.ServeMux()
		try mux.handle("GET /ws", handler(def (conn Conn) !none {
			for let msg in conn.messages() {
				let text = string(msg.data)
				if text == "drop" {
					conn.stream.close() onerror recover none
					return none
				}
				return none when text == "bye"
				try conn.writeMessage(msg.kind, msg.data)
			}
			return none
		}))
		return mux
	}

	// errorKind names the kind of a WebSocketError, "" for another error.
	internal def errorKind(err error) string {
		return "" unless err is WebSocketError
		return "{err.kind}"
	}

	check "ReconnectingConn" {
		@test()
		def TestQueuesUntilConnected() !none {
			let ts = try httptest.Server.start(try flakyMux())
			let ws = new ReconnectingConn(wsURL(ts, "/ws"), ReconnectOptions{minDelay: 10ms, queueSize: 2})
			ws.onConnect = def (conn Conn) !none {
				return conn.writeText("hello")
			}
			// Nothing dialed yet: writes wait, the third is one too many.
			try ws.writeText("queued 1")
			try ws.writeText("queued 2")
			assert ws.pending() == 2 && !ws.isConnected() && ws.current() is none
			let full = ""
			ws.writeText("queued 3") onerror (err error) {
				full = errorKind(err)
				recover none
			}
			assert full == "QueueFull"
			// The first read dials: the hook's message, then the queue in order.
			assert (try ws.readText()) == "hello"
			assert (try ws.readText()) == "queued 1"
			assert (try ws.readText()) == "queued 2"
			assert ws.pending() == 0 && ws.isConnected() && ws.connects == 1
			try ws.writeText("direct")
			assert (try ws.readText()) == "direct"

			// The server cuts the stream: the read dials again and goes on.
			try ws.writeText("drop")
			assert (try ws.readText()) == "hello"
			assert ws.connects == 2
			try ws.writeText("after")
			assert (try ws.readText()) == "after"

			// The peer's Normal close reaches the reader; the next read dials.
			try ws.writeText("bye")
			let closed = ""
			ws.readText() onerror (err error) {
				closed = errorKind(err)
				recover ""
			}
			assert closed == "Closed" && !ws.isConnected()
			assert (try ws.readText()) == "hello"
			assert ws.connects == 3

			try ws.close()
			let after = ""
			ws.readText() onerror (err error) {
				after = errorKind(err)
				recover ""
			}
			assert after == "NotOpen"
			after = ""
			ws.writeText("late") onerror (err error) {
				after = errorKind(err)
				recover none
			}
			assert after == "NotOpen"
			try ts.close()
			return none
		}

		@test()
		def TestGivesUpAfterMaxAttempts() !none {
			let ts = try httptest.Server.start(try flakyMux())
			let target = wsURL(ts, "/ws")
			try ts.close()
			let ws = new ReconnectingConn(target, ReconnectOptions{minDelay: 5ms, maxDelay: 10ms, maxAttempts: 3})
			try ws.writeText("waits")
			assert ws.pending() == 1
			let outcome = "connected"
			ws.connect() onerror (err error) {
				outcome = "gave up"
				recover none
			}
			fail "outcome {outcome}, pending {ws.pending()}, connects {ws.connects}" unless outcome == "gave up" && ws.pending() == 0 && ws.connects == 0
			// Writes and reads now fail with the dial's failure.
			outcome = "queued"
			ws.writeText("more") onerror (err error) {
				outcome = "refused"
				recover none
			}
			assert outcome == "refused"

			// Without a queue a write while disconnected fails at once.
			let strict = new ReconnectingConn(target, ReconnectOptions{queueSize: 0})
			let kind = ""
			strict.writeText("now") onerror (err error) {
				kind = errorKind(err)
				recover none
			}
			assert kind == "NotOpen"
			return none
		}
	}
}
