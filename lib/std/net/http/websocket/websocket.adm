// std.net.http.websocket speaks WebSocket (RFC 6455) over an HTTP
// connection: an `Upgrader` turns a server request into a `Conn`, `dial`
// opens one from a client, and `handler` puts an echo-style function on a
// route. Messages are text or binary; the codec masks client frames,
// answers pings, bounds message sizes and validates text as UTF-8.
//
//     try mux.get("/ws", websocket.handler(def (conn websocket.Conn) !none {
//         let (kind, data) = try conn.readMessage()
//         return conn.writeMessage(kind, data)
//     }))
//
//     let (conn, _) = try websocket.dial("ws://127.0.0.1:8080/ws")
//     try conn.writeText("hello")

partial module std.net.http.websocket {
	use (
		std.errors
		std.io
		std.net
		std.time
	)

	// MessageType is what a message carries: text (UTF-8) or binary.
	enum MessageType {
		Text = 1,
		Binary = 2,
	}

	// CloseCode is a status code of a close frame (RFC 6455 §7.4.1);
	// codes 3000 to 4999 are application-defined and pass through
	// `closeWith` as plain ints.
	enum CloseCode {
		Normal = 1000,
		GoingAway = 1001,
		ProtocolError = 1002,
		UnsupportedData = 1003,
		// Never sent: reported when a close frame carried no code.
		NoStatus = 1005,
		// Never sent: reported when the connection dropped without a
		// close frame.
		Abnormal = 1006,
		InvalidPayload = 1007,
		PolicyViolation = 1008,
		MessageTooBig = 1009,
		MandatoryExtension = 1010,
		InternalError = 1011,
	}

	// ErrorKind says what went wrong on a WebSocket connection.
	enum ErrorKind {
		// The HTTP upgrade was refused or malformed.
		Handshake,
		// The peer broke the framing rules; a close frame with
		// ProtocolError went out.
		Protocol,
		// The peer closed the connection: `closeCode` and `reason` say
		// how. Not a fault, just the end of the stream.
		Closed,
		// A message exceeded `maxMessageSize`.
		TooLarge,
		// The connection was closed on this side already.
		NotOpen,
		// A ReconnectingConn held `queueSize` messages already when another
		// was written while it was disconnected.
		QueueFull,
	}

	// WebSocketError is the payload of every failure here. `closeCode`
	// and `reason` carry the peer's close frame for a `Closed` one.
	struct WebSocketError {
		message   string
		code      string            = "websocket"
		cause     ?error
		stack     errors.StackTrace
		kind      ErrorKind
		closeCode int               = 0
		reason    string            = ""
	}

	// wsError builds a failure of a kind.
	internal def wsError(kind ErrorKind, message string) WebSocketError {
		return WebSocketError{message: "websocket: {message}", kind: kind}
	}

	// closedError builds the failure that reports the peer's close frame.
	internal def closedError(code int, reason string) WebSocketError {
		return WebSocketError{message: "websocket: peer closed with {code} {reason}", kind: ErrorKind.Closed, closeCode: code, reason: reason}
	}

	// The GUID appended to the client's key before hashing (RFC 6455 §1.3).
	internal const acceptGUID = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"

	// acceptKey is the `Sec-WebSocket-Accept` value for a client's
	// `Sec-WebSocket-Key`: base64 of SHA-1 over the key and the GUID.
	def acceptKey(clientKey string) string {
		use (
			std.crypto.hash::(Hash, digest)
			std.data.encoding::(base64encode)
		)
		return base64encode(digest(Hash.SHA1, (clientKey + acceptGUID).bytes()))
	}

	// isValidCloseCode reports whether a code may travel in a close frame:
	// the defined ones a peer may send, or an application code from 3000
	// to 4999.
	def isValidCloseCode(code int) bool {
		return true when code >= 3000 && code <= 4999
		return code := 1000 || 1001 || 1002 || 1003 || 1007 || 1008 || 1009 || 1010 || 1011
	}

	// waitFor turns the "no limit" 0s into the longest wait a socket read
	// takes.
	internal def waitFor(d duration) duration {
		return d when d > 0s
		return 24h
	}
}
