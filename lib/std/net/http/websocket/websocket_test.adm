partial module std.net.http.websocket {
	use (
		std.bytes
		std.crypto.x509::(CertPool)
		std.net
		std.net.http
		std.net.http::(Context, Header, Request, Transport)
		std.net.http.httptest
		std.net.tls
		std.testing
		std.time
	)

	// Answer is the JSON message the echo test round-trips.
	struct Answer {
		answer int = 0
	}

	// ServerSeen is what the echo handler observed, for the client side.
	type ServerSeen {
		closeCode   int    = 0
		closeReason string = ""
		subprotocol string = ""
		messages    int    = 0
		failure     string = ""

		def new() {}
	}

	// echoMux serves an echo endpoint at /ws with a subprotocol offer, the
	// same with permessage-deflate at /deflate, a plain route at /plain,
	// and a strict-origin endpoint at /strict.
	internal def echoMux(seen ServerSeen) !http.ServeMux {
		let mux = new http.ServeMux()
		let ws = new Upgrader()
		ws.subprotocols = ["echo.v2", "echo.v1"]
		ws.checkOrigin = def (req Request) bool {return true}
		try mux.handle("GET /ws", handler(def (conn Conn) !none {
			seen.subprotocol = conn.subprotocol
			for let msg in conn.messages() {
				seen.messages++
				try conn.writeMessage(msg.kind, msg.data)
			}
			seen.closeCode = conn.closeCode
			seen.closeReason = conn.closeReason
			return none
		}, ws))
		let deflating = new Upgrader()
		deflating.compression = true
		try mux.handle("GET /deflate", handler(def (conn Conn) !none {
			for let msg in conn.messages() {
				seen.messages++
				try conn.writeMessage(msg.kind, msg.data)
			}
			return none
		}, deflating))
		let keeping = new Upgrader()
		keeping.compression = true
		keeping.contextTakeover = true
		try mux.handle("GET /takeover", handler(def (conn Conn) !none {
			for let msg in conn.messages() {
				try conn.writeMessage(msg.kind, msg.data)
			}
			return none
		}, keeping))
		try mux.handle("GET /strict", handler(def (conn Conn) !none {
			return conn.writeText("strict")
		}))
		try mux.get("/plain", def (ctx Context) !none {return ctx.text("plain")})
		return mux
	}

	// tlsTransport is a transport trusting the httptest certificate.
	internal def tlsTransport(ts httptest.Server) Transport {
		let t = new Transport()
		let cert = ts.certificate()
		if !(cert is none) {
			let pool = new CertPool()
			pool.addCert(cert)
			t.tls = tls.Config{serverName: "localhost", rootCAs: pool}
		}
		return t
	}

	// rawRequest writes an HTTP request as given and returns the response
	// head as text.
	internal def rawRequest(ts httptest.Server, request string) !string {
		let conn = try net.dialStream(ts.address().str(), 5s)
		try conn.writeAll(request.bytes())
		let buf byte[]
		buf.len(4096)
		let n = try conn.read(buf, 5s)
		conn.close() onerror recover none
		return string(buf[0:n])
	}

	// wsURL rewrites the test server's base URL to the WebSocket scheme.
	internal def wsURL(ts httptest.Server, path string) string {
		return "ws" + ts.url[4:] + path
	}

	check "WebSocket" {
		@test()
		def TestAcceptKey() {
			// The RFC 6455 §1.3 example.
			assert acceptKey("dGhlIHNhbXBsZSBub25jZQ==") == "s3pPLMBiTxaQ9kYGzzhZRbK+xOo="
			assert isValidCloseCode(1000) && isValidCloseCode(4999) && isValidCloseCode(1011)
			assert !isValidCloseCode(1005) && !isValidCloseCode(1006) && !isValidCloseCode(999) && !isValidCloseCode(5000)
		}

		@test()
		def TestFrameCodec() !none {
			// Every length form, masked and not.
			for let (_, size) in [0, 1, 125, 126, 65535, 65536, 70000] {
				let payload byte[]
				payload.len(size)
				for let i = 0; i < size; i++ {
					payload[i] = byte(i & 0xff)
				}
				let plain = encodeFrame(true, opcodeBinary, payload)
				let masked = encodeFrame(false, opcodeText, payload, byte[1, 2, 3, 4])
				assert (plain[1] & 0x80) == 0 && (masked[1] & 0x80) != 0
				let reader = new FrameReader(new bytes.Reader(plain + masked))
				let first = try reader.next()
				assert first.fin && first.opcode == opcodeBinary && !first.masked
				assert first.payload.len() == size && first.payload.hex() == payload.hex()
				let second = try reader.next()
				assert !second.fin && second.opcode == opcodeText && second.masked
				assert second.payload.hex() == payload.hex()
			}
			let ping = encodeFrame(true, opcodePing, "hi".bytes())
			assert ping.hex() == "89026869"

			// Close payloads.
			let close = encodeClose(1000, "bye")
			assert close.hex() == "03E8627965"
			let (code, reason) = try decodeClose(close)
			assert code == 1000 && reason == "bye"
			let (noStatus, blank) = try decodeClose([])
			assert noStatus == int(CloseCode.NoStatus) && blank == ""
			let longReason = encodeClose(1001, "x".repeat(200))
			assert longReason.len() == 125

			// What the reader refuses.
			let cases = [
				byte[0x89, 0x7e, 0x00, 0x7e],
				byte[0x09, 0x00],
				byte[0xc1, 0x00],
				byte[0x83, 0x00],
				byte[0x81, 0x7e, 0x00, 0x05, 1, 2, 3, 4, 5],
				byte[0x81, 0x7f, 0, 0, 0, 0, 0, 0, 0, 5, 1, 2, 3, 4, 5],
			]
			for let (i, bad) in cases {
				let reader = new FrameReader(new bytes.Reader(bad))
				let kind = "ok"
				reader.next() onerror (err error) {
					kind = "protocol" when err is WebSocketError && err.kind == ErrorKind.Protocol
					recover Frame{fin: true, opcode: 0, masked: false, payload: []}
				}
				assert kind == "protocol"
			}
			let big = new FrameReader(new bytes.Reader(byte[0x82, 0x7e, 0x10, 0x00]))
			big.maxPayload = 100
			let limited = "ok"
			big.next() onerror (err error) {
				limited = "too large" when err is WebSocketError && err.kind == ErrorKind.TooLarge
				recover Frame{fin: true, opcode: 0, masked: false, payload: []}
			}
			assert limited == "too large"
			let closeErrors = [byte[3], byte[0x03, 0xed], byte[0x03, 0xe8, 0xff]]
			for let (_, payload) in closeErrors {
				let outcome = "ok"
				decodeClose(payload) onerror (err error) {
					outcome = "protocol"
					recover (0, "")
				}
				assert outcome == "protocol"
			}
		}

		@test()
		def TestEchoOverLoopback() !none {
			let seen = new ServerSeen()
			let ts = try httptest.Server.start(try echoMux(seen))
			let (conn, res) = try dial(wsURL(ts, "/ws"), DialOptions{subprotocols: ["echo.v1", "echo.v2"]})
			assert res.status == 101
			assert conn.subprotocol == "echo.v2"
			try conn.writeText("hello")
			assert (try conn.readText()) == "hello"
			let blob byte[]
			blob.len(70000)
			for let i = 0; i < blob.len(); i++ {
				blob[i] = byte(i % 251)
			}
			try conn.writeBinary(blob)
			let (kind, data) = try conn.readMessage()
			assert kind == MessageType.Binary && data.len() == 70000 && data.hex() == blob.hex()
			// Fragmented: three frames make one message.
			let w = conn.writer(MessageType.Text)
			try w.write("one ".bytes())
			try w.write("two ".bytes())
			try w.write("three".bytes())
			try w.close()
			assert (try conn.readText()) == "one two three"
			// A ping is answered on the peer's read; the pong lands on ours.
			try conn.ping("beat".bytes())
			try conn.writeText("after ping")
			assert (try conn.readText()) == "after ping"
			assert string(conn.lastPong) == "beat"
			// JSON both ways.
			try conn.writeJSON(Answer{answer: 42})
			let decoded = Answer{}
			try conn.readJSON(decoded)
			assert decoded.answer == 42
			assert conn.isOpen()
			try conn.close(CloseCode.Normal, "done")
			assert !conn.isOpen()
			assert conn.closeCode == 1000 && conn.closeReason == ""
			let closed = "ok"
			conn.writeText("late") onerror (err error) {
				closed = "not open" when err is WebSocketError && err.kind == ErrorKind.NotOpen
				recover none
			}
			assert closed == "not open"
			time.sleep(50ms)
			assert seen.messages == 5
			assert seen.subprotocol == "echo.v2"
			assert seen.closeCode == 1000 && seen.closeReason == "done"
			try ts.close()
			return none
		}

		@test()
		def TestHandshakeRejects() !none {
			let seen = new ServerSeen()
			let ts = new httptest.Server(try echoMux(seen))
			try ts.start()
			let client = ts.client()
			// A plain GET on the endpoint.
			let plain = try client.get("/ws")
			assert plain.status == 400
			// The wrong version: 426 naming the one supported. The http
			// client owns the Connection header, so the request goes raw.
			let unsupported = try rawRequest(ts, "GET /ws HTTP/1.1\r\nHost: x\r\nConnection: Upgrade\r\nUpgrade: websocket\r\nSec-WebSocket-Version: 8\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n\r\n")
			assert unsupported.startsWith("HTTP/1.1 426")
			assert unsupported.lower().contains("sec-websocket-version: 13")
			// A key that is not 16 bytes, and a method that is not GET.
			let badKey = try rawRequest(ts, "GET /ws HTTP/1.1\r\nHost: x\r\nConnection: Upgrade\r\nUpgrade: websocket\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Key: c2hvcnQ=\r\n\r\n")
			assert badKey.startsWith("HTTP/1.1 400")
			let posted = try rawRequest(ts, "POST /ws HTTP/1.1\r\nHost: x\r\nConnection: Upgrade\r\nUpgrade: websocket\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nContent-Length: 0\r\n\r\n")
			assert posted.startsWith("HTTP/1.1 405")
			let reason = "ok"
			// A foreign origin on the strict endpoint, then its own.
			let foreign = new Header()
			foreign.set("Origin", "http://evil.example")
			reason = "ok"
			dial(wsURL(ts, "/strict"), DialOptions{headers: foreign}) onerror (err error) {
				reason = err.message
				recover (new Conn(new net.Connection(-1), new bytes.Reader([]), true), new http.Response())
			}
			assert reason.contains("403")
			let own = new Header()
			own.set("Origin", ts.url)
			let (strict, _) = try dial(wsURL(ts, "/strict"), DialOptions{headers: own})
			assert (try strict.readText()) == "strict"
			try strict.close()
			// Not an upgrade at all: a plain route.
			reason = "ok"
			dial(wsURL(ts, "/plain")) onerror (err error) {
				reason = err.message
				recover (new Conn(new net.Connection(-1), new bytes.Reader([]), true), new http.Response())
			}
			assert reason.contains("200 instead of 101")
			// A bad scheme.
			reason = "ok"
			dial("ftp://127.0.0.1/ws") onerror (err error) {
				reason = err.message
				recover (new Conn(new net.Connection(-1), new bytes.Reader([]), true), new http.Response())
			}
			assert reason.contains("not ws or wss")
			try ts.close()
			return none
		}

		@test()
		def TestProtocolErrorsCloseTheConnection() !none {
			let seen = new ServerSeen()
			let ts = new httptest.Server(try echoMux(seen))
			try ts.start()
			// An unmasked frame from a client: the server answers 1002.
			let (conn, _) = try dial(wsURL(ts, "/ws"))
			try conn.stream.write(encodeFrame(true, opcodeText, "raw".bytes()), 5s)
			let reason = "ok"
			conn.readText() onerror (err error) {
				reason = "closed {err.closeCode}" when err is WebSocketError && err.kind == ErrorKind.Closed
				recover ""
			}
			assert reason == "closed {int(CloseCode.ProtocolError)}"
			conn.close() onerror recover none
			// Text that is not UTF-8: 1007.
			let (second, _) = try dial(wsURL(ts, "/ws"))
			try second.writeMessage(MessageType.Text, byte[0xff, 0xfe, 0x41])
			reason = "ok"
			second.readText() onerror (err error) {
				reason = "closed {err.closeCode}" when err is WebSocketError && err.kind == ErrorKind.Closed
				recover ""
			}
			assert reason == "closed {int(CloseCode.InvalidPayload)}"
			second.close() onerror recover none
			// A message over the server's limit: 1009.
			let ws = new Upgrader()
			ws.maxMessageSize = 10
			ws.checkOrigin = def (req Request) bool {return true}
			let mux = new http.ServeMux()
			try mux.handle("GET /small", handler(def (c Conn) !none {
				for let msg in c.messages() {
					try c.writeMessage(msg.kind, msg.data)
				}
				return none
			}, ws))
			let small = new httptest.Server(mux)
			try small.start()
			let (third, _) = try dial(wsURL(small, "/small"))
			try third.writeText("short")
			assert (try third.readText()) == "short"
			try third.writeText("this one is too long")
			reason = "ok"
			third.readText() onerror (err error) {
				reason = "closed {err.closeCode}" when err is WebSocketError && err.kind == ErrorKind.Closed
				recover ""
			}
			assert reason == "closed {int(CloseCode.MessageTooBig)}"
			third.close() onerror recover none
			try small.close()
			try ts.close()
			return none
		}

		@test()
		def TestSecureWebSocket() !none {
			let seen = new ServerSeen()
			let ts = new httptest.Server(try echoMux(seen))
			try ts.startTLS()
			let (conn, res) = try dial("wss" + ts.url[5:] + "/ws", DialOptions{transport: tlsTransport(ts)})
			assert res.status == 101
			try conn.writeText("secure")
			assert (try conn.readText()) == "secure"
			try conn.close()
			try ts.close()
			return none
		}

		@test()
		def TestHubBroadcast() !none {
			let rooms = new Hub()
			let mux = new http.ServeMux()
			let ws = new Upgrader()
			ws.checkOrigin = def (req Request) bool {return true}
			try mux.handle("GET /room", handler(def (conn Conn) !none {
				rooms.join("lobby", conn)
				rooms.join("lobby", conn)
				for let msg in conn.messages() {
					rooms.broadcast("lobby", msg.kind, msg.data)
				}
				rooms.leaveAll(conn)
				return none
			}, ws))
			let ts = new httptest.Server(mux)
			try ts.start()
			let (a, _) = try dial(wsURL(ts, "/room"))
			let (b, _) = try dial(wsURL(ts, "/room"))
			try a.writeText("ping from a")
			assert (try a.readText()) == "ping from a"
			assert (try b.readText()) == "ping from a"
			time.sleep(20ms)
			assert rooms.count("lobby") == 2
			try b.close()
			time.sleep(50ms)
			assert rooms.count("lobby") == 1
			try a.writeText("alone")
			assert (try a.readText()) == "alone"
			try a.close()
			time.sleep(50ms)
			assert rooms.count("lobby") == 0
			assert rooms.members("lobby").len() == 0
			try ts.close()
			return none
		}

		@test()
		def TestKeepAlive() !none {
			let mux = new http.ServeMux()
			let ws = new Upgrader()
			ws.checkOrigin = def (req Request) bool {return true}
			try mux.handle("GET /alive", handler(def (conn Conn) !none {
				let beat = async keepAlive(conn, 30ms, 60ms)
				beat.keepAlive()
				for let msg in conn.messages() {
					try conn.writeMessage(msg.kind, msg.data)
				}
				return none
			}, ws))
			let ts = new httptest.Server(mux)
			try ts.start()
			// A client that reads answers the pings and stays connected.
			let (live, _) = try dial(wsURL(ts, "/alive"))
			for let i = 0; i < 5; i++ {
				time.sleep(30ms)
				try live.writeText("tick")
				assert (try live.readText()) == "tick"
			}
			assert live.isOpen()
			try live.close()
			// One that never reads gets closed with GoingAway.
			let (dead, _) = try dial(wsURL(ts, "/alive"))
			time.sleep(250ms)
			let reason = "ok"
			dead.readText() onerror (err error) {
				reason = "closed {err.closeCode}" when err is WebSocketError && err.kind == ErrorKind.Closed
				recover ""
			}
			assert reason == "closed {int(CloseCode.GoingAway)}"
			dead.close() onerror recover none
			try ts.close()
			return none
		}
	}
}
