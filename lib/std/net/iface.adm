partial module std.net {
	// NetInterface describes a single OS network interface (e.g. "lo0", "eth0").
	//
	// This type is intentionally "system-facing": addresses are returned as raw IP
	// literals (no ports), and the `flags` field is an ADM-stable bitmask derived
	// from the host OS.
	type NetInterface {
		name         string
		index        int
		flags        int
		mtu          int
		hardwareAddr string
		addrs        string[]

		// up reports whether the interface is administratively up.
		def up() bool {
			return (flags & NetIfaceUp) != 0
		}

		// running reports whether the interface has a link and is operating.
		def running() bool {
			return (flags & NetIfaceRunning) != 0
		}

		// loopback reports whether the interface is the loopback.
		def loopback() bool {
			return (flags & NetIfaceLoopback) != 0
		}

		// broadcast reports whether the interface supports broadcast.
		def broadcast() bool {
			return (flags & NetIfaceBroadcast) != 0
		}

		// multicast reports whether the interface supports multicast.
		def multicast() bool {
			return (flags & NetIfaceMulticast) != 0
		}

		// pointToPoint reports whether the interface is a point-to-point link.
		def pointToPoint() bool {
			return (flags & NetIfacePointToPoint) != 0
		}

		// hasHardwareAddr reports whether the interface has a hardware (MAC) address.
		def hasHardwareAddr() bool {
			return hardwareAddr.len() > 0
		}

		// str renders the interface's name, index, flags and addresses over several
		// lines.
		def str() string {
			return "NetworkInterface(\n"+
				"    name: {name},\n"+
				"    index: {index},\n"+
				"    flags: {flags}\n"+
				"    mtu: {mtu},\n"+
				"    hardwareAddr: {hardwareAddr},\n"+
				"    addrs: {addrs.str()}\n"+
				"    up: {up()},\n" +
				"    running: {running()},\n" +
				"    loopback: {loopback()},\n" +
				"    broadcast: {broadcast()},\n" +
				"    multicast: {multicast()},\n" +
				"    pointToPoint: {pointToPoint()},\n" +
				"    hasHardwareAddr: {hasHardwareAddr()}\n"+
				")"
		}
	}

	// NetInterface flag bits (ADM-stable across supported OSes).
	const NetIfaceUp = 1 << 0
	// NetIfaceRunning is the flag bit of an interface with a working link.
	const NetIfaceRunning = 1 << 1
	// NetIfaceLoopback is the flag bit of the loopback interface.
	const NetIfaceLoopback = 1 << 2
	// NetIfaceBroadcast is the flag bit of an interface supporting broadcast.
	const NetIfaceBroadcast = 1 << 3
	// NetIfaceMulticast is the flag bit of an interface supporting multicast.
	const NetIfaceMulticast = 1 << 4
	// NetIfacePointToPoint is the flag bit of a point-to-point link.
	const NetIfacePointToPoint = 1 << 5
}
