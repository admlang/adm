partial module std.net {
	// parseIPText reads a dotted IPv4 or an IPv6 text into 4 or 16 bytes;
	// none when it is neither.
	def parseIPText(text string) ?byte[] {
		return parseIPv6Text(text) when text.contains(":")
		let parts = text.split(".")
		return none when parts.len() != 4
		let out byte[]
		for let (_, part) in parts {
			return none when part == "" || part.len() > 3 || !part.isNumeric()
			let n = part.toInt<int>()
			return none when n > 255
			out.push(byte(n))
		}
		return out
	}

	// ipText renders 4 bytes dotted and 16 bytes as IPv6 with the longest
	// zero run compressed.
	def ipText(address byte[]) string {
		return "{int(address[0])}.{int(address[1])}.{int(address[2])}.{int(address[3])}" when address.len() == 4
		return "?" + address.hex() when address.len() != 16
		let groups int[]
		for let i = 0; i < 16; i += 2 {
			groups.push(int(address[i]) << 8 | int(address[i + 1]))
		}
		// Longest run of zero groups, two or more, gets "::".
		let bestStart = -1
		let bestLen = 0
		for let i = 0; i < 8; i++ {
			continue when groups[i] != 0
			let j = i
			for j < 8 && groups[j] == 0 {
				j++
			}
			if j - i > bestLen && j - i >= 2 {
				bestStart = i
				bestLen = j - i
			}
			i = j
		}
		let out = ""
		for let i = 0; i < 8; i++ {
			if i == bestStart {
				out += "::"
				i += bestLen - 1
				continue
			}
			out += ":" when out != "" && !out.endsWith(":")
			out += groups[i].toRadix(16).lower()
		}
		return out
	}

	// The 16 bytes of an IPv6 text, `::` and an embedded dotted IPv4 at the
	// end included; none when it is not one.
	internal def parseIPv6Text(text string) ?byte[] {
		let head string[]
		let tail string[]
		let gap = text.indexOf("::")
		if gap < 0 {
			head = text.split(":")
		} else {
			return none when text.indexOf("::", gap + 1) >= 0
			head = text[:gap].split(":") when gap > 0
			tail = text[gap + 2:].split(":") when gap + 2 < text.len()
		}
		let groups int[]
		let headGroups = ipv6Groups(head)
		let tailGroups = ipv6Groups(tail)
		return none when headGroups is none
		return none when tailGroups is none
		let missing = 8 - headGroups.len() - tailGroups.len()
		return none when missing < 0 || (gap < 0 && missing != 0) || (gap >= 0 && missing == 0)
		for let (_, g) in headGroups {
			groups.push(g)
		}
		for let i = 0; i < missing; i++ {
			groups.push(0)
		}
		for let (_, g) in tailGroups {
			groups.push(g)
		}
		let out byte[]
		for let (_, g) in groups {
			out.push(byte(g >> 8))
			out.push(byte(g & 0xff))
		}
		return out
	}

	// ipv6Groups reads hex groups, expanding an embedded dotted IPv4 in
	// the last position into two groups; none on a malformed group.
	internal def ipv6Groups(parts string[]) ?int[] {
		let out int[]
		for let i = 0; i < parts.len(); i++ {
			let part = parts[i]
			if i == parts.len() - 1 && part.contains(".") {
				let v4 = parseIPText(part)
				return none when v4 is none || v4.len() != 4
				out.push(int(v4[0]) << 8 | int(v4[1]))
				out.push(int(v4[2]) << 8 | int(v4[3]))
				continue
			}
			return none when part == "" || part.len() > 4
			let value = 0
			for let (_, c) in part {
				return none unless c.isHexDigit()
				value = value * 16 + c.digitValue(16)
			}
			out.push(value)
		}
		return out
	}

	// IPBlock is a range of IP addresses in CIDR notation: an address and
	// how many of its leading bits every address of the range shares
	// (`10.0.0.0/8`, `2001:db8::/32`). One address is a block of its own.
	//
	// ```
	// let office = net.parseIPBlock("203.0.113.0/24")
	// let inside = office.contains("203.0.113.9") unless office is none
	// ```
	type IPBlock {
		// The first address of the block: 4 or 16 bytes, zero after the
		// prefix.
		address byte[]
		// The length of the prefix in bits: 0 to 32, or 0 to 128.
		prefix  int

		def new(address byte[], prefix int) {
			self.address = address
			self.prefix = prefix
		}

		// Whether the block holds the address, given as 4 or 16 bytes. An
		// IPv4-mapped IPv6 address (`::ffff:192.0.2.1`) is the IPv4 address
		// it carries, so an IPv4 block holds it. An address of the other
		// family, or of another length, is not held.
		def contains(ip byte[]) bool {
			let candidate = ip
			candidate = ip[12:] when ip.len() == 16 && address.len() == 4 && isMappedIPv4(ip)
			return false unless candidate.len() == address.len()
			let whole = prefix / 8
			for let i = 0; i < whole; i++ {
				return false when candidate[i] != address[i]
			}
			let rest = prefix % 8
			return true when rest == 0
			let mask = byte(0xFF << (8 - rest))
			return candidate[whole] & mask == address[whole] & mask
		}

		// Whether the block holds the address, given as text. Text that is
		// not an IP address is not held.
		def contains(ip string) bool {
			let parsed = parseIPText(ip)
			return false when parsed is none
			return contains(parsed)
		}

		// The block in CIDR notation: `10.0.0.0/8`.
		def str() string {
			return "{ipText(address)}/{prefix}"
		}
	}

	// isMappedIPv4 reports whether the 16 bytes are an IPv4-mapped IPv6
	// address (`::ffff:a.b.c.d`).
	internal def isMappedIPv4(ip byte[]) bool {
		for let i = 0; i < 10; i++ {
			return false when ip[i] != byte(0)
		}
		return ip[10] == byte(0xFF) && ip[11] == byte(0xFF)
	}

	// parseIPBlock reads a block in CIDR notation, IPv4 or IPv6; an address
	// without a prefix is the block of that one address. The bits after the
	// prefix are cleared, so `10.1.2.3/8` is `10.0.0.0/8`. None when the
	// text is neither, or the prefix is longer than the address.
	def parseIPBlock(text string) ?IPBlock {
		let slash = text.indexOf("/")
		let address = parseIPText(slash < 0 ?? (text, text[:slash]))
		return none when address is none
		let prefix = address.len() * 8
		if slash >= 0 {
			let digits = text[slash + 1:]
			return none when digits.len() == 0 || digits.len() > 3 || !digits.isNumeric()
			prefix = digits.toInt<int>()
			return none when prefix > address.len() * 8
		}
		let whole = prefix / 8
		let rest = prefix % 8
		for let i = whole; i < address.len(); i++ {
			address[i] = i == whole && rest != 0 ?? (address[i] & byte(0xFF << (8 - rest)), byte(0))
		}
		return new IPBlock(address, prefix)
	}
}
