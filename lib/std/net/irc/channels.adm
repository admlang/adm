internal partial module std.net.irc.proto {
	use (
		std.net.irc::*
	)

	// ListEntry is one mask of a channel's ban, exception or invite list.
	struct ListEntry {
		mask  string
		setBy string
		setAt int64
	}

	// Member is one user in a channel and the channel status it holds.
	type Member {
		session Session
		op      bool    = false
		voice   bool    = false

		def new(session Session) {
			self.session = session
		}

		// The status prefixes, highest first; all of them under
		// `multi-prefix`, else only the highest.
		def prefixes(all bool) string {
			let out = ""
			out += "@" when op
			out += "+" when voice && (all || !op)
			return out
		}
	}

	// Chan is a channel of the server (RFC 2811): its members, topic,
	// modes and lists.
	type Chan {
		name       string
		created    int64
		topic      string               = ""
		topicBy    string               = ""
		topicAt    int64                = 0
		key        string               = ""
		limit      int                  = 0
		inviteOnly bool                 = false
		moderated  bool                 = false
		noExternal bool                 = false
		private    bool                 = false
		secret     bool                 = false
		topicLock  bool                 = false
		bans       ListEntry[]
		excepts    ListEntry[]
		invex      ListEntry[]
		// Members by folded nickname.
		members    map<string, Member>
		// Folded nicknames invited since they last joined.
		invited    map<string, bool>

		def new(name string, created int64) {
			self.name = name
			self.created = created
		}

		// The channel's modes as MODE shows them, with the key and
		// limit arguments when `withArgs`.
		def modeString(withArgs bool) string {
			let flags = "+"
			let args string[] = []
			flags += "i" when inviteOnly
			if key != "" {
				flags += "k"
				args.push(key) when withArgs
			}
			if limit > 0 {
				flags += "l"
				args.push("{limit}") when withArgs
			}
			flags += "m" when moderated
			flags += "n" when noExternal
			flags += "p" when private
			flags += "s" when secret
			flags += "t" when topicLock
			return flags when args.len() == 0
			return flags + " " + args.join(" ")
		}

		// The NAMES symbol: `@` secret, `*` private, `=` public.
		def symbol() string {
			return "@" when secret
			return "*" when private
			return "="
		}

		// The list a type A mode letter names.
		def list(letter char) ListEntry[] {
			return bans when letter == 'b'
			return excepts when letter == 'e'
			return invex
		}

		def setList(letter char, entries ListEntry[]) {
			switch {
				case letter == 'b':
					bans = entries
				case letter == 'e':
					excepts = entries
				default:
					invex = entries
			}
		}

		// Reports whether a `nick!user@host` matches a list.
		def listed(letter char, who string, mapping CaseMapping) bool {
			for let e in list(letter) {
				return true when matchMask(e.mask, who, mapping)
			}
			return false
		}

		// Reports whether a user is banned: on the ban list and not on
		// the exception list.
		def banned(who string, mapping CaseMapping) bool {
			return listed('b', who, mapping) && !listed('e', who, mapping)
		}
	}

	// WhowasEntry is what WHOWAS remembers of a nickname that left.
	struct WhowasEntry {
		nick     string
		user     string
		host     string
		realName string
		server   string
		left     int64
	}
}
