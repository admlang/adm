internal partial module std.net.irc.proto {
	use (
		std.net.irc::*
		std.time
	)

	// The version VERSION and RPL_MYINFO report.
	const serverVersion = "adm-irc-1.0"

	// How many departed nicknames WHOWAS remembers.
	const whowasKept = 200

	// Hub is the state a server shares between its sessions: the users by
	// nickname and the channels by name. Its `atomic` methods take one
	// command at a time, so a command sees and changes the network whole.
	type Hub {
		server      Server
		stats       ServerStats
		// Sessions that claimed a nickname, by folded nickname; not all of
		// them registered yet.
		users       map<string, Session>
		chans       map<string, Chan>
		whowas      WhowasEntry[]
		created     int64
		createdText string
		startMono   int64
		maxUsers    int                 = 0
		counts      map<string, int>

		def new(server Server, stats ServerStats) {
			self.server = server
			self.stats = stats
			created = time.wallNs() / 1000000000
			createdText = time.now().str()
			startMono = time.monoNs()
		}

		// Answers one command of a session.
		atomic def dispatch(s Session, m Message) {
			let seen = counts.get(m.command)
			if seen is none {
				counts[m.command] = 1
			} else {
				counts[m.command] = seen + 1
			}
			if !s.registered {
				switch {
					case m.command == "NICK":
						nickCommand(s, m)
					case m.command == "USER":
						userCommand(s, m)
					case m.command == "QUIT":
						quitCommand(s, m)
					case m.command == "SERVICE":
						s.num(421, ["SERVICE", "Services cannot register on this server"])
					default:
						s.num(451, ["You have not registered"])
				}
				return
			}
			command(s, m)
		}

		// Completes a registration CAP END released.
		atomic def tryRegister(s Session) {
			register(s)
		}

		// Takes a session off the network once its connection is over,
		// telling everyone who shares a channel with it.
		atomic def quit(s Session, reason string) {
			removeUser(s, reason)
		}

		// Tells a user's peers that asked for `account-notify` that it
		// logged in.
		atomic def accountChanged(s Session) {
			let m = from(s, "ACCOUNT", [s.account == "" ?? ("*", s.account)])
			for let (_, peer) in peersOf(s, true) {
				peer.send(m) when peer.hasCap("account-notify")
			}
		}

		// Users registered right now.
		atomic def userCount() int {
			return registeredCount()
		}

		internal def registeredCount() int {
			let n = 0
			for let (_, u) in users {
				n++ when u.registered
			}
			return n
		}

		internal def mapping() CaseMapping {
			return server.caseMapping
		}

		internal def f(name string) string {
			return fold(name, server.caseMapping)
		}

		internal def now() int64 {
			return time.wallNs() / 1000000000
		}

		// from is a message with a user as its source, tagged with the
		// time and the user's account.
		internal def from(s Session, command string, params string[]) Message {
			let m = new Message(command, params)
			m.source = s.mask()
			m.messageTags["time"] = serverTime()
			m.messageTags["account"] = s.account unless s.account == ""
			return m
		}

		// peersOf is every user sharing a channel with `s`, by folded
		// nickname, `s` itself included when `me`.
		internal def peersOf(s Session, me bool) map<string, Session> {
			let out = map<string, Session>{}
			for let (_, ch) in s.channels {
				for let (key, member) in ch.members {
					out[key] = member.session
				}
			}
			if me {
				out[s.folded] = s
			} else {
				out.delete(s.folded)
			}
			return out
		}

		internal def sendToChannel(ch Chan, m Message, except ?Session) {
			for let (_, member) in ch.members {
				continue when !(except is none) && member.session == except
				member.session.send(m)
			}
		}

		internal def register(s Session) {
			return when s.registered || s.folded == "" || s.user == "" || s.capHold
			let want = server.password
			if !(want is none) && !sameBytes(s.pass.bytes(), want.reveal().bytes()) {
				s.num(464, ["Password incorrect"])
				s.end("Bad Password")
				return
			}
			s.registered = true
			stats.registrations.inc()
			let count = registeredCount()
			maxUsers = count when count > maxUsers
			s.num(1, ["Welcome to the {server.network} Internet Relay Chat Network {s.mask()}"])
			s.num(2, ["Your host is {server.name}, running version {serverVersion}"])
			s.num(3, ["This server was created {createdText}"])
			s.num(4, [server.name, serverVersion, "iowrsO", "beiklmnopstv", "beIklov"])
			isupport(s)
			lusers(s)
			motd(s)
			let modes = userModes(s)
			s.send(from(s, "MODE", [s.nick, modes])) unless modes == "+"
		}

		internal def isupport(s Session) {
			let tokens = [
				"AWAYLEN={server.awayLength}",
				"CASEMAPPING={server.caseMapping.value}",
				"CHANLIMIT=#&:{server.maxChannels}",
				"CHANMODES=beI,k,l,imnpst",
				"CHANNELLEN={server.channelLength}",
				"CHANTYPES=#&",
				"EXCEPTS=e",
				"INVEX=I",
				"KICKLEN={server.kickLength}",
				"MAXLIST=beI:{server.maxList}",
				"MODES={server.maxModes}",
				"NETWORK={server.network}",
				"NICKLEN={server.nickLength}",
				"PREFIX=(ov)@+",
				"STATUSMSG=@+",
				"TARGMAX=JOIN:,KICK:1,LIST:1,NAMES:1,NOTICE:{server.maxTargets},PART:,PRIVMSG:{server.maxTargets},TAGMSG:{server.maxTargets},WHOIS:1",
				"TOPICLEN={server.topicLength}",
				"USERLEN={server.userLength}",
			]
			let i = 0
			for i < tokens.len() {
				let end = i + 12
				end = tokens.len() when end > tokens.len()
				s.num(5, tokens[i:end] + ["are supported by this server"])
				i = end
			}
		}

		internal def lusers(s Session) {
			let visible = 0
			let invisible = 0
			let opers = 0
			let unknown = 0
			for let (_, u) in users {
				if !u.registered {
					unknown++
					continue
				}
				invisible++ when u.invisible
				visible++ unless u.invisible
				opers++ when u.oper
			}
			let total = visible + invisible
			s.num(251, ["There are {visible} users and {invisible} invisible on 1 servers"])
			s.num(252, ["{opers}", "operator(s) online"]) when opers > 0
			s.num(253, ["{unknown}", "unknown connection(s)"]) when unknown > 0
			s.num(254, ["{chans.len()}", "channels formed"]) when chans.len() > 0
			s.num(255, ["I have {total} clients and 0 servers"])
			s.num(265, ["{total}", "{maxUsers}", "Current local users {total}, max {maxUsers}"])
			s.num(266, ["{total}", "{maxUsers}", "Current global users {total}, max {maxUsers}"])
		}

		internal def motd(s Session) {
			if server.motd == "" {
				s.num(422, ["MOTD File is missing"])
				return
			}
			s.num(375, ["- {server.name} Message of the day - "])
			for let line in server.motd.split("\n") {
				s.num(372, ["- {line.trimEnd("\r")}"])
			}
			s.num(376, ["End of MOTD command"])
		}

		internal def userModes(s Session) string {
			let out = "+"
			out += "i" when s.invisible
			out += "o" when s.oper
			out += "O" when s.localOper
			out += "r" when s.restricted
			out += "s" when s.notices
			out += "w" when s.wallops
			return out
		}

		internal def removeUser(s Session, reason string) {
			return when s.folded == ""
			let current = users.get(s.folded)
			users.delete(s.folded) when !(current is none) && current == s
			return unless s.registered
			let m = from(s, "QUIT", [reason])
			for let (_, peer) in peersOf(s, false) {
				peer.send(m)
			}
			for let (_, ch) in s.channels.clone() {
				leave(s, ch)
			}
			remember(s)
			s.registered = false
		}

		internal def remember(s Session) {
			whowas.push(WhowasEntry{nick: s.nick, user: s.user, host: s.host, realName: s.realName, server: server.name, left: now()})
			whowas = whowas[whowas.len() - whowasKept:].clone() when whowas.len() > whowasKept
		}

		internal def leave(s Session, ch Chan) {
			let key = f(ch.name)
			ch.members.delete(s.folded)
			s.channels.delete(key)
			chans.delete(key) when ch.members.len() == 0
		}

		internal def command(s Session, m Message) {
			let p = m.params
			switch {
				case m.command := "PRIVMSG" || "NOTICE" || "TAGMSG":
					message(s, m)
				case m.command == "JOIN":
					joinCommand(s, m)
				case m.command == "PART":
					partCommand(s, m)
				case m.command == "MODE":
					modeCommand(s, m)
				case m.command == "TOPIC":
					topicCommand(s, m)
				case m.command == "NAMES":
					namesCommand(s, m)
				case m.command == "LIST":
					listCommand(s, m)
				case m.command == "INVITE":
					inviteCommand(s, m)
				case m.command == "KICK":
					kickCommand(s, m)
				case m.command == "NICK":
					nickCommand(s, m)
				case m.command == "USER":
					s.num(462, ["You may not reregister"])
				case m.command == "SERVICE":
					s.num(462, ["You may not reregister"])
				case m.command == "QUIT":
					quitCommand(s, m)
				case m.command == "WHO":
					whoCommand(s, m)
				case m.command == "WHOIS":
					whoisCommand(s, m)
				case m.command == "WHOWAS":
					whowasCommand(s, m)
				case m.command == "USERHOST":
					userhostCommand(s, m)
				case m.command == "ISON":
					isonCommand(s, m)
				case m.command == "AWAY":
					awayCommand(s, m)
				case m.command == "OPER":
					operCommand(s, m)
				case m.command == "KILL":
					killCommand(s, m)
				case m.command == "WALLOPS":
					wallopsCommand(s, m)
				case m.command == "SETNAME":
					setnameCommand(s, m)
				case m.command == "MOTD":
					motd(s)
				case m.command == "LUSERS":
					lusers(s)
				case m.command == "VERSION":
					s.num(351, [serverVersion, server.name, "IRC server of the ADM standard library"])
					isupport(s)
				case m.command == "STATS":
					statsCommand(s, m)
				case m.command == "LINKS":
					s.num(364, [server.name, server.name, "0 {server.info}"])
					s.num(365, [p.len() > 0 ?? (p[p.len() - 1], "*"), "End of LINKS list"])
				case m.command == "TIME":
					s.num(391, [server.name, time.now().str()])
				case m.command == "CONNECT":
					if !s.oper {
						s.num(481, ["Permission Denied- You're not an IRC operator"])
						return
					}
					s.num(402, [p.len() > 0 ?? (p[0], "*"), "No such server"])
				case m.command == "SQUIT":
					if !s.oper {
						s.num(481, ["Permission Denied- You're not an IRC operator"])
						return
					}
					s.num(402, [p.len() > 0 ?? (p[0], "*"), "No such server"])
				case m.command == "TRACE":
					traceCommand(s, m)
				case m.command == "ADMIN":
					s.num(256, [server.name, "Administrative info"])
					s.num(257, [server.administrator])
					s.num(258, [server.network])
					s.num(259, [server.adminEmail])
				case m.command == "INFO":
					for let line in server.info.split("\n") {
						s.num(371, [line])
					}
					s.num(374, ["End of INFO list"])
				case m.command == "SERVLIST":
					s.num(235, [p.len() > 0 ?? (p[0], "*"), p.len() > 1 ?? (p[1], "*"), "End of service listing"])
				case m.command == "SQUERY":
					s.num(408, [p.len() > 0 ?? (p[0], "*"), "No such service"])
				case m.command == "SUMMON":
					s.num(445, ["SUMMON has been disabled"])
				case m.command == "USERS":
					s.num(446, ["USERS has been disabled"])
				case m.command == "REHASH":
					if !s.oper {
						s.num(481, ["Permission Denied- You're not an IRC operator"])
						return
					}
					s.num(382, ["ircd.conf", "Rehashing"])
				case m.command == "DIE":
					if !s.oper {
						s.num(481, ["Permission Denied- You're not an IRC operator"])
						return
					}
					let task = async server.close()
					task.keepAlive()
				case m.command == "RESTART":
					if !s.oper {
						s.num(481, ["Permission Denied- You're not an IRC operator"])
						return
					}
					for let (_, u) in users {
						u.end("Server restarting")
					}
				case m.command == "ERROR":
					return
				default:
					s.num(421, [m.command, "Unknown command"])
			}
		}

		internal def needs(s Session, m Message, count int) bool {
			return true when m.params.len() >= count
			s.num(461, [m.command, "Not enough parameters"])
			return false
		}

		internal def nickCommand(s Session, m Message) {
			if m.params.len() == 0 || m.params[0] == "" {
				s.num(431, ["No nickname given"])
				return
			}
			let nick = m.params[0]
			if !validNick(nick, server.nickLength) {
				s.num(432, [nick, "Erroneous nickname"])
				return
			}
			if s.registered && s.restricted {
				s.num(484, ["Your connection is restricted!"])
				return
			}
			let key = f(nick)
			let holder = users.get(key)
			if !(holder is none) && holder != s {
				s.num(433, [nick, "Nickname is already in use"])
				return
			}
			if !s.registered {
				users.delete(s.folded) unless s.folded == ""
				s.nick = nick
				s.folded = key
				users[key] = s
				register(s)
				return
			}
			return when nick == s.nick
			let m2 = from(s, "NICK", [nick])
			for let (_, peer) in peersOf(s, true) {
				peer.send(m2)
			}
			remember(s)
			let old = s.folded
			users.delete(old)
			users[key] = s
			for let (_, ch) in s.channels {
				let member = ch.members.get(old)
				continue when member is none
				ch.members.delete(old)
				ch.members[key] = member
				ch.invited.delete(old)
			}
			s.nick = nick
			s.folded = key
		}

		internal def userCommand(s Session, m Message) {
			return unless needs(s, m, 4)
			if s.user != "" {
				s.num(462, ["You may not reregister"])
				return
			}
			let user = m.params[0]
			user = user[:server.userLength] when user.len() > server.userLength
			if user == "" || user.contains("@") {
				s.num(461, ["USER", "Not enough parameters"])
				return
			}
			s.user = user
			if m.params[1].isNumeric() {
				let bits = m.params[1].toInt<int>()
				s.wallops = (bits & 4) != 0
				s.invisible = (bits & 8) != 0
			}
			s.realName = m.params[3]
			register(s)
		}

		internal def quitCommand(s Session, m Message) {
			let reason = m.params.len() > 0 ?? ("Quit: " + m.params[0], "Client Quit")
			s.end(reason)
		}

		internal def joinCommand(s Session, m Message) {
			return unless needs(s, m, 1)
			if m.params[0] == "0" {
				for let (_, ch) in s.channels.clone() {
					sendToChannel(ch, from(s, "PART", [ch.name]), none)
					leave(s, ch)
				}
				return
			}
			let names = m.params[0].split(",")
			let keys = m.params.len() > 1 ?? (m.params[1].split(","), [])
			for let i = 0; i < names.len(); i++ {
				let key = i < keys.len() ?? (keys[i], "")
				join(s, names[i], key)
			}
		}

		internal def join(s Session, name string, key string) {
			if !validChannel(name, server.channelLength) {
				s.num(403, [name, "No such channel"])
				return
			}
			let folded = f(name)
			return when s.channels.hasKey(folded)
			if s.channels.len() >= server.maxChannels {
				s.num(405, [name, "You have joined too many channels"])
				return
			}
			let existing = chans.get(folded)
			let creating = existing is none
			let ch = new Chan(name, now())
			if existing is none {
				ch.noExternal = true
				ch.topicLock = true
				chans[folded] = ch
			} else {
				ch = existing
				let who = s.mask()
				let invited = ch.invited.hasKey(s.folded)
				if ch.inviteOnly && !invited && !ch.listed('I', who, mapping()) {
					s.num(473, [ch.name, "Cannot join channel (+i)"])
					return
				}
				if ch.banned(who, mapping()) && !invited {
					s.num(474, [ch.name, "Cannot join channel (+b)"])
					return
				}
				if ch.key != "" && key != ch.key {
					s.num(475, [ch.name, "Cannot join channel (+k)"])
					return
				}
				if ch.limit > 0 && ch.members.len() >= ch.limit && !invited {
					s.num(471, [ch.name, "Cannot join channel (+l)"])
					return
				}
			}
			let member = new Member(s)
			member.op = creating
			ch.members[s.folded] = member
			ch.invited.delete(s.folded)
			s.channels[folded] = ch
			let plain = from(s, "JOIN", [ch.name])
			let extended = from(s, "JOIN", [ch.name, s.account == "" ?? ("*", s.account), s.realName])
			let away = from(s, "AWAY", [s.away])
			for let (_, other) in ch.members {
				let peer = other.session
				peer.send(peer.hasCap("extended-join") ?? (extended, plain))
				peer.send(away) when s.away != "" && peer != s && peer.hasCap("away-notify")
			}
			if ch.topic != "" {
				s.num(332, [ch.name, ch.topic])
				s.num(333, [ch.name, ch.topicBy, "{ch.topicAt}"])
			}
			sendNames(s, ch)
		}

		internal def partCommand(s Session, m Message) {
			return unless needs(s, m, 1)
			let reason = m.params.len() > 1 ?? (m.params[1], "")
			for let name in m.params[0].split(",") {
				let ch = chans.get(f(name))
				if ch is none {
					s.num(403, [name, "No such channel"])
					continue
				}
				if !ch.members.hasKey(s.folded) {
					s.num(442, [ch.name, "You're not on that channel"])
					continue
				}
				let params = reason == "" ?? ([ch.name], [ch.name, reason])
				sendToChannel(ch, from(s, "PART", params), none)
				leave(s, ch)
			}
		}

		internal def topicCommand(s Session, m Message) {
			return unless needs(s, m, 1)
			let ch = chans.get(f(m.params[0]))
			if ch is none {
				s.num(403, [m.params[0], "No such channel"])
				return
			}
			let member = ch.members.get(s.folded)
			if m.params.len() == 1 {
				if member is none && (ch.secret || ch.private) {
					s.num(442, [ch.name, "You're not on that channel"])
					return
				}
				if ch.topic == "" {
					s.num(331, [ch.name, "No topic is set"])
					return
				}
				s.num(332, [ch.name, ch.topic])
				s.num(333, [ch.name, ch.topicBy, "{ch.topicAt}"])
				return
			}
			if member is none {
				s.num(442, [ch.name, "You're not on that channel"])
				return
			}
			if ch.topicLock && !member.op {
				s.num(482, [ch.name, "You're not channel operator"])
				return
			}
			let text = m.params[1]
			text = text[:server.topicLength] when text.len() > server.topicLength
			ch.topic = text
			ch.topicBy = s.mask()
			ch.topicAt = now()
			sendToChannel(ch, from(s, "TOPIC", [ch.name, text]), none)
		}

		// seesMembers reports whether NAMES and WHO show a channel's
		// members to `s`: always to a member, else only on a channel
		// neither private nor secret.
		internal def seesMembers(s Session, ch Chan) bool {
			return true when ch.members.hasKey(s.folded)
			return !ch.secret && !ch.private
		}

		internal def sendNames(s Session, ch Chan) {
			if seesMembers(s, ch) {
				let inside = ch.members.hasKey(s.folded)
				let entries string[] = []
				for let (_, member) in ch.members {
					let u = member.session
					continue when !inside && u.invisible
					let who = s.hasCap("userhost-in-names") ?? (u.mask(), u.nick)
					entries.push(member.prefixes(s.hasCap("multi-prefix")) + who)
				}
				sendNameRows(s, ch.symbol(), ch.name, entries)
			}
			s.num(366, [ch.name, "End of NAMES list"])
		}

		internal def sendNameRows(s Session, symbol string, name string, entries string[]) {
			let row = ""
			for let e in entries {
				if row != "" && row.len() + e.len() > 380 {
					s.num(353, [symbol, name, row])
					row = ""
				}
				row = row == "" ?? (e, row + " " + e)
			}
			s.num(353, [symbol, name, row]) unless row == ""
		}

		internal def namesCommand(s Session, m Message) {
			if m.params.len() > 0 && m.params[0] != "" {
				for let name in m.params[0].split(",") {
					let ch = chans.get(f(name))
					if ch is none {
						s.num(366, [name, "End of NAMES list"])
						continue
					}
					sendNames(s, ch)
				}
				return
			}
			let shown = map<string, bool>{}
			for let (_, ch) in chans {
				continue unless seesMembers(s, ch)
				let inside = ch.members.hasKey(s.folded)
				let entries string[] = []
				for let (key, member) in ch.members {
					continue when !inside && member.session.invisible
					shown[key] = true
					entries.push(member.prefixes(s.hasCap("multi-prefix")) + member.session.nick)
				}
				sendNameRows(s, ch.symbol(), ch.name, entries)
			}
			let rest string[] = []
			for let (key, u) in users {
				continue when !u.registered || shown.hasKey(key)
				continue when u.invisible && u != s
				rest.push(u.nick)
			}
			sendNameRows(s, "=", "*", rest)
			s.num(366, ["*", "End of NAMES list"])
		}

		internal def listCommand(s Session, m Message) {
			let wanted = map<string, bool>{}
			if m.params.len() > 0 && m.params[0] != "" {
				for let name in m.params[0].split(",") {
					wanted[f(name)] = true
				}
			}
			s.num(321, ["Channel", "Users  Name"])
			for let (key, ch) in chans {
				continue when wanted.len() > 0 && !wanted.hasKey(key)
				let inside = ch.members.hasKey(s.folded)
				continue when ch.secret && !inside
				if ch.private && !inside {
					s.num(322, ["Prv", "{ch.members.len()}", ""])
					continue
				}
				s.num(322, [ch.name, "{ch.members.len()}", ch.topic])
			}
			s.num(323, ["End of LIST"])
		}

		internal def inviteCommand(s Session, m Message) {
			return unless needs(s, m, 2)
			let target = users.get(f(m.params[0]))
			if target is none || !target.registered {
				s.num(401, [m.params[0], "No such nick/channel"])
				return
			}
			let ch = chans.get(f(m.params[1]))
			if ch is none {
				s.num(403, [m.params[1], "No such channel"])
				return
			}
			let member = ch.members.get(s.folded)
			if member is none {
				s.num(442, [ch.name, "You're not on that channel"])
				return
			}
			if ch.members.hasKey(target.folded) {
				s.num(443, [target.nick, ch.name, "is already on channel"])
				return
			}
			if ch.inviteOnly && !member.op {
				s.num(482, [ch.name, "You're not channel operator"])
				return
			}
			ch.invited[target.folded] = true
			s.num(341, [target.nick, ch.name])
			let invite = from(s, "INVITE", [target.nick, ch.name])
			target.send(invite)
			s.num(301, [target.nick, target.away]) unless target.away == ""
			for let (_, other) in ch.members {
				let peer = other.session
				peer.send(invite) when other.op && peer != s && peer.hasCap("invite-notify")
			}
		}

		internal def kickCommand(s Session, m Message) {
			return unless needs(s, m, 2)
			let chanNames = m.params[0].split(",")
			let nicks = m.params[1].split(",")
			let reason = m.params.len() > 2 ?? (m.params[2], s.nick)
			reason = reason[:server.kickLength] when reason.len() > server.kickLength
			for let i = 0; i < nicks.len(); i++ {
				let name = chanNames.len() == 1 ?? (chanNames[0], i < chanNames.len() ?? (chanNames[i], ""))
				if name == "" {
					s.num(461, ["KICK", "Not enough parameters"])
					return
				}
				let ch = chans.get(f(name))
				if ch is none {
					s.num(403, [name, "No such channel"])
					continue
				}
				let member = ch.members.get(s.folded)
				if member is none {
					s.num(442, [ch.name, "You're not on that channel"])
					continue
				}
				if !member.op {
					s.num(482, [ch.name, "You're not channel operator"])
					continue
				}
				let victim = ch.members.get(f(nicks[i]))
				if victim is none {
					s.num(441, [nicks[i], ch.name, "They aren't on that channel"])
					continue
				}
				sendToChannel(ch, from(s, "KICK", [ch.name, victim.session.nick, reason]), none)
				leave(victim.session, ch)
			}
		}

		internal def modeCommand(s Session, m Message) {
			return unless needs(s, m, 1)
			if isChannel(m.params[0]) {
				channelMode(s, m)
				return
			}
			let target = users.get(f(m.params[0]))
			if target is none {
				s.num(401, [m.params[0], "No such nick/channel"])
				return
			}
			if target != s {
				s.num(502, ["Cannot change mode for other users"])
				return
			}
			if m.params.len() == 1 {
				s.num(221, [userModes(s)])
				return
			}
			let adding = true
			let changes = ""
			let sign = ""
			let unknown = false
			for let c in m.params[1] {
				if c := '+' || '-' {
					adding = c == '+'
					continue
				}
				let applied = true
				switch {
					case c == 'i':
						applied = s.invisible != adding
						s.invisible = adding
					case c == 'w':
						applied = s.wallops != adding
						s.wallops = adding
					case c == 's':
						applied = s.notices != adding
						s.notices = adding
					case c == 'o':
						// Only OPER grants operator status; dropping it is allowed.
						applied = !adding && s.oper
						s.oper = false when !adding
					case c == 'O':
						applied = !adding && s.localOper
						s.localOper = false when !adding
					case c == 'r':
						// A restriction can be taken, never dropped.
						applied = adding && !s.restricted
						s.restricted = true when adding
					case c == 'a':
						// Away is set with AWAY only.
						applied = false
					default:
						applied = false
						unknown = true
				}
				continue unless applied
				let want = adding ?? ("+", "-")
				if want != sign {
					changes += want
					sign = want
				}
				changes += string(c)
			}
			s.num(501, ["Unknown MODE flag"]) when unknown
			s.send(from(s, "MODE", [s.nick, changes])) unless changes == ""
		}

		// channelMode shows or changes a channel's modes (RFC 2811 §4).
		internal def channelMode(s Session, m Message) {
			let ch = chans.get(f(m.params[0]))
			if ch is none {
				s.num(403, [m.params[0], "No such channel"])
				return
			}
			let member = ch.members.get(s.folded)
			if m.params.len() == 1 {
				s.num(324, [ch.name, ch.modeString(!(member is none))])
				s.num(329, [ch.name, "{ch.created}"])
				return
			}
			let isOp = !(member is none) && member.op
			let args = m.params[2:]
			let next = 0
			let adding = true
			let changes = ""
			let sign = ""
			let applied string[] = []
			let withArgs = 0
			let refused = false
			for let c in m.params[1] {
				if c := '+' || '-' {
					adding = c == '+'
					continue
				}
				let isList = c := 'b' || 'e' || 'I'
				if isList && (next >= args.len()) {
					showList(s, ch, c)
					continue
				}
				if !(c := 'b' || 'e' || 'I' || 'k' || 'l' || 'o' || 'v' || 'i' || 'm' || 'n' || 'p' || 's' || 't') {
					s.num(472, [string(c), "is unknown mode char to me for {ch.name}"])
					continue
				}
				let takesArg = isList || (c := 'o' || 'v' || 'k') || (c == 'l' && adding)
				if !isOp {
					refused = true
					next++ when takesArg && next < args.len()
					continue
				}
				let arg = ""
				if takesArg {
					if next >= args.len() {
						s.num(461, ["MODE", "Not enough parameters"]) unless c == 'k' && !adding
						continue unless c == 'k' && !adding
					} else {
						if withArgs >= server.maxModes {
							break
						}
						arg = args[next]
						next++
						withArgs++
					}
				}
				let done = applyMode(s, ch, c, adding, arg)
				continue when done is none
				let want = adding ?? ("+", "-")
				if want != sign {
					changes += want
					sign = want
				}
				changes += string(c)
				applied.push(done) unless done == ""
			}
			s.num(482, [ch.name, "You're not channel operator"]) when refused
			sendToChannel(ch, from(s, "MODE", [ch.name, changes] + applied), none) unless changes == ""
		}

		// applyMode changes one mode; the argument to show with it ("" for
		// none), or none when nothing changed.
		internal def applyMode(s Session, ch Chan, c char, adding bool, arg string) ?string {
			switch {
				case c := 'o' || 'v':
					let target = ch.members.get(f(arg))
					if target is none {
						s.num(441, [arg, ch.name, "They aren't on that channel"])
						return none
					}
					if c == 'o' {
						return none when target.op == adding
						target.op = adding
					} else {
						return none when target.voice == adding
						target.voice = adding
					}
					return target.session.nick
				case c := 'b' || 'e' || 'I':
					let mask = normalizeMask(arg)
					let entries = ch.list(c)
					let kept ListEntry[] = []
					let found = false
					for let e in entries {
						if fold(e.mask, mapping()) == fold(mask, mapping()) {
							found = true
							continue unless adding
						}
						kept.push(e)
					}
					if adding {
						return none when found
						if entries.len() >= server.maxList {
							s.num(478, [ch.name, mask, "Channel list is full"])
							return none
						}
						kept.push(ListEntry{mask: mask, setBy: s.mask(), setAt: now()})
					} else {
						return none unless found
					}
					ch.setList(c, kept)
					return mask
				case c == 'k':
					if adding {
						if ch.key != "" {
							s.num(467, [ch.name, "Channel key already set"])
							return none
						}
						if arg == "" || arg.contains(" ") || arg.contains(",") {
							s.num(525, [ch.name, "Key is not well-formed"])
							return none
						}
						ch.key = arg
						return arg
					}
					return none when ch.key == ""
					let old = ch.key
					ch.key = ""
					return old
				case c == 'l':
					if adding {
						return none when !arg.isNumeric() || arg.toInt<int>() < 1
						ch.limit = arg.toInt<int>()
						return arg
					}
					return none when ch.limit == 0
					ch.limit = 0
					return ""
			}
			let before = flagOf(ch, c)
			return none when before == adding
			setFlag(ch, c, adding)
			return ""
		}

		internal def flagOf(ch Chan, c char) bool {
			switch {
				case c == 'i':
					return ch.inviteOnly
				case c == 'm':
					return ch.moderated
				case c == 'n':
					return ch.noExternal
				case c == 'p':
					return ch.private
				case c == 's':
					return ch.secret
			}
			return ch.topicLock
		}

		internal def setFlag(ch Chan, c char, on bool) {
			switch {
				case c == 'i':
					ch.inviteOnly = on
				case c == 'm':
					ch.moderated = on
				case c == 'n':
					ch.noExternal = on
				case c == 'p':
					ch.private = on
				case c == 's':
					ch.secret = on
				default:
					ch.topicLock = on
			}
		}

		internal def showList(s Session, ch Chan, c char) {
			let entry = 346
			let end = 347
			let label = "End of channel invite list"
			if c == 'b' {
				entry = 367
				end = 368
				label = "End of channel ban list"
			} else if c == 'e' {
				entry = 348
				end = 349
				label = "End of channel exception list"
			}
			for let e in ch.list(c) {
				s.num(entry, [ch.name, e.mask, e.setBy, "{e.setAt}"])
			}
			s.num(end, [ch.name, label])
		}

		// message delivers a PRIVMSG, NOTICE or TAGMSG. A NOTICE never gets
		// an error back (RFC 2812 §3.3.2).
		internal def message(s Session, m Message) {
			let notice = m.command == "NOTICE"
			let tagOnly = m.command == "TAGMSG"
			if m.params.len() == 0 || m.params[0] == "" {
				s.num(411, ["No recipient given ({m.command})"]) unless notice
				return
			}
			if !tagOnly && (m.params.len() < 2 || m.params[1] == "") {
				s.num(412, ["No text to send"]) unless notice
				return
			}
			let targets = m.params[0].split(",")
			if targets.len() > server.maxTargets {
				s.num(407, [m.params[0], "Too many recipients"]) unless notice
				return
			}
			s.spoke = time.monoNs() unless tagOnly
			for let t in targets {
				deliver(s, m, t, notice, tagOnly)
			}
		}

		internal def deliver(s Session, m Message, target string, notice bool, tagOnly bool) {
			let params = tagOnly ?? ([target], [target, m.params[1]])
			let out = from(s, m.command, params)
			for let (name, value) in m.messageTags {
				out.messageTags[name] = value when name.startsWith("+")
			}
			let status = ""
			let name = target
			if (name.startsWith("@") || name.startsWith("+")) && name.len() > 1 && isChannel(name[1:]) {
				status = name[:1]
				name = name[1:]
			}
			if isChannel(name) {
				let ch = chans.get(f(name))
				if ch is none {
					s.num(403, [name, "No such channel"]) unless notice
					return
				}
				let member = ch.members.get(s.folded)
				let voiced = !(member is none) && (member.op || member.voice)
				let blocked = (ch.noExternal && member is none) || (ch.moderated && !voiced) || (!voiced && ch.banned(s.mask(), mapping()))
				if blocked {
					s.num(404, [ch.name, "Cannot send to channel"]) unless notice
					return
				}
				for let (_, other) in ch.members {
					let peer = other.session
					continue when peer == s
					continue when status == "@" && !other.op
					continue when status == "+" && !(other.op || other.voice)
					continue when tagOnly && !peer.hasCap("message-tags")
					peer.send(out)
				}
				s.send(out) when s.hasCap("echo-message") && (!tagOnly || s.hasCap("message-tags"))
				return
			}
			if name.startsWith("$") {
				if !s.oper {
					s.num(481, ["Permission Denied- You're not an IRC operator"]) unless notice
					return
				}
				if !matchMask(name[1:], server.name, mapping()) {
					s.num(402, [name, "No such server"]) unless notice
					return
				}
				for let (_, u) in users {
					u.send(out) when u.registered && u != s
				}
				return
			}
			let nick = name
			let at = nick.indexOf("@")
			if at > 0 {
				let host = nick[at + 1:]
				nick = nick[:at] when fold(host, mapping()) == fold(server.name, mapping())
			}
			let bang = nick.indexOf("!")
			nick = nick[:bang] when bang > 0
			let peer = users.get(f(nick))
			if peer is none || !peer.registered {
				s.num(401, [name, "No such nick/channel"]) unless notice
				return
			}
			peer.send(out) when !tagOnly || peer.hasCap("message-tags")
			s.num(301, [peer.nick, peer.away]) when m.command == "PRIVMSG" && peer.away != ""
			s.send(out) when s.hasCap("echo-message") && peer != s && (!tagOnly || s.hasCap("message-tags"))
		}

		internal def whoCommand(s Session, m Message) {
			let mask = m.params.len() > 0 ?? (m.params[0], "*")
			mask = "*" when mask := "0" || ""
			let opersOnly = m.params.len() > 1 && m.params[1].contains("o")
			if isChannel(mask) {
				let ch = chans.get(f(mask))
				if !(ch is none) && seesMembers(s, ch) {
					let inside = ch.members.hasKey(s.folded)
					for let (_, member) in ch.members {
						let u = member.session
						continue when !inside && u.invisible
						continue when opersOnly && !u.oper
						whoRow(s, u, ch.name, member.prefixes(s.hasCap("multi-prefix")))
					}
				}
				s.num(315, [mask, "End of WHO list"])
				return
			}
			let peers = peersOf(s, true)
			for let (key, u) in users {
				continue unless u.registered
				continue when u.invisible && !peers.hasKey(key)
				continue when opersOnly && !u.oper
				let hit = matchMask(mask, u.nick, mapping()) || matchMask(mask, u.user, mapping()) || matchMask(mask, u.host, mapping()) || matchMask(mask, u.realName, mapping()) || matchMask(mask, server.name, mapping())
				continue unless hit
				whoRow(s, u, "*", "")
			}
			s.num(315, [mask, "End of WHO list"])
		}

		internal def whoRow(s Session, u Session, place string, prefix string) {
			let flags = u.away == "" ?? ("H", "G")
			flags += "*" when u.oper
			flags += prefix
			s.num(352, [place, u.user, u.host, server.name, u.nick, flags, "0 {u.realName}"])
		}

		internal def whoisCommand(s Session, m Message) {
			if m.params.len() == 0 {
				s.num(431, ["No nickname given"])
				return
			}
			let list = m.params[m.params.len() - 1]
			for let nick in list.split(",") {
				let u = users.get(f(nick))
				if u is none || !u.registered {
					s.num(401, [nick, "No such nick/channel"])
					s.num(318, [nick, "End of WHOIS list"])
					continue
				}
				s.num(311, [u.nick, u.user, u.host, "*", u.realName])
				let shown string[] = []
				for let (key, ch) in u.channels {
					let member = ch.members.get(u.folded)
					continue when member is none
					continue when (ch.secret || ch.private) && !s.channels.hasKey(key)
					shown.push(member.prefixes(s.hasCap("multi-prefix")) + ch.name)
				}
				s.num(319, [u.nick, shown.join(" ")]) when shown.len() > 0
				s.num(312, [u.nick, server.name, server.info])
				s.num(301, [u.nick, u.away]) unless u.away == ""
				s.num(313, [u.nick, "is an IRC operator"]) when u.oper
				s.num(330, [u.nick, u.account, "is logged in as"]) unless u.account == ""
				s.num(671, [u.nick, "is using a secure connection"]) when u.secured
				let idle = (time.monoNs() - u.spoke) / 1000000000
				s.num(317, [u.nick, "{idle}", "{u.signOn}", "seconds idle, signon time"])
				s.num(318, [u.nick, "End of WHOIS list"])
			}
		}

		internal def whowasCommand(s Session, m Message) {
			if m.params.len() == 0 || m.params[0] == "" {
				s.num(431, ["No nickname given"])
				return
			}
			let limit = 0
			limit = m.params[1].toInt<int>() when m.params.len() > 1 && m.params[1].isNumeric()
			for let nick in m.params[0].split(",") {
				let key = f(nick)
				let found = 0
				for let i = whowas.len() - 1; i >= 0; i-- {
					let e = whowas[i]
					continue unless f(e.nick) == key
					s.num(314, [e.nick, e.user, e.host, "*", e.realName])
					s.num(312, [e.nick, e.server, time.fromUnixNs(e.left * 1000000000).str()])
					found++
					break when limit > 0 && found >= limit
				}
				s.num(406, [nick, "There was no such nickname"]) when found == 0
				s.num(369, [nick, "End of WHOWAS"])
			}
		}

		internal def userhostCommand(s Session, m Message) {
			return unless needs(s, m, 1)
			let out string[] = []
			for let nick in m.params {
				break when out.len() >= 5
				let u = users.get(f(nick))
				continue when u is none || !u.registered
				let op = u.oper ?? ("*", "")
				let here = u.away == "" ?? ("+", "-")
				out.push("{u.nick}{op}={here}{u.user}@{u.host}")
			}
			s.num(302, [out.join(" ")])
		}

		internal def isonCommand(s Session, m Message) {
			return unless needs(s, m, 1)
			let out string[] = []
			for let param in m.params {
				for let nick in param.split(" ") {
					continue when nick == ""
					let u = users.get(f(nick))
					out.push(u.nick) when !(u is none) && u.registered
				}
			}
			s.num(303, [out.join(" ")])
		}

		internal def awayCommand(s Session, m Message) {
			let text = m.params.len() > 0 ?? (m.params[0], "")
			text = text[:server.awayLength] when text.len() > server.awayLength
			s.away = text
			if text == "" {
				s.num(305, ["You are no longer marked as being away"])
			} else {
				s.num(306, ["You have been marked as being away"])
			}
			let note = from(s, "AWAY", text == "" ?? ([], [text]))
			for let (_, peer) in peersOf(s, false) {
				peer.send(note) when peer.hasCap("away-notify")
			}
		}

		internal def operCommand(s Session, m Message) {
			return unless needs(s, m, 2)
			let want = server.operators.get(m.params[0])
			if want is none {
				s.num(491, ["No O-lines for your host"])
				return
			}
			if !sameBytes(m.params[1].bytes(), want.reveal().bytes()) {
				s.num(464, ["Password incorrect"])
				return
			}
			s.oper = true
			s.num(381, ["You are now an IRC operator"])
			s.send(from(s, "MODE", [s.nick, "+o"]))
		}

		internal def killCommand(s Session, m Message) {
			if !s.oper {
				s.num(481, ["Permission Denied- You're not an IRC operator"])
				return
			}
			return unless needs(s, m, 2)
			if fold(m.params[0], mapping()) == fold(server.name, mapping()) {
				s.num(483, ["You can't kill a server!"])
				return
			}
			let target = users.get(f(m.params[0]))
			if target is none || !target.registered {
				s.num(401, [m.params[0], "No such nick/channel"])
				return
			}
			let reason = "Killed ({s.nick} ({m.params[1]}))"
			target.send(from(s, "KILL", [target.nick, m.params[1]]))
			target.end(reason)
		}

		internal def wallopsCommand(s Session, m Message) {
			if !s.oper {
				s.num(481, ["Permission Denied- You're not an IRC operator"])
				return
			}
			return unless needs(s, m, 1)
			let note = from(s, "WALLOPS", [m.params[0]])
			for let (_, u) in users {
				u.send(note) when u.registered && u.wallops
			}
		}

		internal def setnameCommand(s Session, m Message) {
			if !s.hasCap("setname") {
				s.num(421, ["SETNAME", "Unknown command"])
				return
			}
			if m.params.len() == 0 || m.params[0] == "" || m.params[0].len() > server.realNameLength {
				s.fromServer("FAIL", ["SETNAME", "INVALID_REALNAME", "Realname is not valid"])
				return
			}
			s.realName = m.params[0]
			let note = from(s, "SETNAME", [s.realName])
			for let (_, peer) in peersOf(s, true) {
				peer.send(note) when peer.hasCap("setname")
			}
		}

		internal def statsCommand(s Session, m Message) {
			let query = m.params.len() > 0 ?? (m.params[0], "")
			let letter = query == "" ?? ("*", query[:1])
			switch {
				case letter == "u":
					let up = (time.monoNs() - startMono) / 1000000000
					let days = up / 86400
					let rest = up % 86400
					s.num(242, ["Server Up {days} days {rest / 3600}:{pad2(rest % 3600 / 60)}:{pad2(rest % 60)}"])
				case letter == "m":
					for let (name, count) in counts {
						s.num(212, [name, "{count}"])
					}
				case letter == "o":
					if s.oper {
						for let (name, _) in server.operators {
							s.num(243, ["O", "*", "*", name])
						}
					}
				case letter == "l":
					if s.oper {
						for let (_, u) in users {
							let open = time.wallNs() / 1000000000 - u.signOn
							s.num(211, [u.mask(), "{u.outbox.len()}", "0", "0", "0", "0", "{open}"])
						}
					}
			}
			s.num(219, [letter, "End of STATS report"])
		}

		internal def traceCommand(s Session, m Message) {
			if s.oper {
				for let (_, u) in users {
					continue unless u.registered
					if u.oper {
						s.num(204, ["Oper", "users", u.nick])
					} else {
						s.num(205, ["User", "users", u.nick])
					}
				}
			}
			s.num(262, [server.name, serverVersion, "End of TRACE"])
		}
	}

	// normalizeMask completes a ban-style mask to `nick!user@host`: a
	// bare nickname becomes `nick!*@*`, `user@host` becomes `*!user@host`.
	def normalizeMask(mask string) string {
		let bang = mask.indexOf("!")
		let at = mask.indexOf("@")
		return mask when bang >= 0 && at > bang
		return "{mask}!*@*" when bang < 0 && at < 0
		return "*!{mask}" when bang < 0
		return "{mask}@*"
	}

	internal def pad2(n int64) string {
		return n < 10 ?? ("0{n}", "{n}")
	}
}
