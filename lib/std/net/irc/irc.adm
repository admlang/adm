partial module std.net.irc {
	use (
		std.crypto::(rand)
		std.crypto.hash::(Hash, digest, hmac, pbkdf2)
		std.errors
	)

	// Security picks how a connection is protected.
	enum Security {
		// No TLS; messages and passwords cross the network in the clear
		// (port 6667).
		Plain = "plain",
		// TLS from the first byte (port 6697).
		Tls   = "tls",
	}

	// CaseMapping is how a server folds nicknames and channel names to
	// compare them (the ISUPPORT CASEMAPPING token).
	enum CaseMapping {
		// A-Z fold to a-z, and `[]\~` fold to `{}|^` (RFC 1459): the
		// default when a server announces none.
		Rfc1459       = "rfc1459",
		// As `Rfc1459`, but `~` and `^` stay apart.
		StrictRfc1459 = "strict-rfc1459",
		// Only A-Z fold to a-z.
		Ascii         = "ascii",
	}

	// SaslMechanism is how a client proves its account during
	// registration (IRCv3 `sasl`).
	enum SaslMechanism {
		// Account name and password, in the clear inside the connection:
		// use it over TLS.
		Plain       = "PLAIN",
		// The TLS client certificate the connection presented; the server
		// maps its fingerprint to an account.
		External    = "EXTERNAL",
		// Salted challenge and response (RFC 7677): the password never
		// crosses the connection.
		ScramSha256 = "SCRAM-SHA-256",
	}

	// IrcError is the payload of a failure the server reported: the
	// numeric reply (`433` for a nickname in use, `473` for an
	// invite-only channel) and its text. `code` repeats the numeric as
	// text, so a handler that only reads `error` still sees it.
	struct IrcError {
		message string
		code    string
		cause   ?error
		stack   errors.StackTrace
		// The numeric reply, 0 when the failure is not a server reply (an
		// ERROR, a closed connection, a line that does not parse).
		reply   int
		// The text of the reply.
		text    string
	}

	// Message is one IRC line: IRCv3 tags, the source it came from, the
	// command (a word, or a three-digit numeric reply) and its
	// parameters, the trailing one included without its colon.
	//
	// ```
	// let m = try irc.parse(":alice!a@host PRIVMSG #adm :hello there")
	// m.nick()     // "alice"
	// m.target()   // "#adm"
	// m.text()     // "hello there"
	// ```
	type Message {
		// The IRCv3 message tags, their values unescaped; a tag sent
		// without a value maps to "".
		messageTags map<string, string>
		// Where the message came from: `nick!user@host` or a server name;
		// empty for a message a client sends.
		source      string                 = ""
		// The command, upper-cased, or the numeric as three digits.
		command     string
		params      string[]

		def new(command string, params string[] = []) {
			self.command = command.upper()
			self.params = params
		}

		// The value of a message tag, "" when the message has none of
		// that name.
		def tagValue(name string) string {
			let v = messageTags.get(name)
			return "" when v is none
			return v
		}

		// Reports whether the message carries a tag of that name.
		def hasTag(name string) bool {
			return messageTags.hasKey(name)
		}

		// The nickname of the source, "" when the source is a server.
		def nick() string {
			let bang = source.indexOf("!")
			return source[:bang] when bang >= 0
			let at = source.indexOf("@")
			return source[:at] when at >= 0
			return "" when source.contains(".")
			return source
		}

		// The user (ident) part of the source, "" when it has none.
		def user() string {
			let bang = source.indexOf("!")
			return "" when bang < 0
			let at = source.indexOf("@", bang)
			return source[bang + 1:] when at < 0
			return source[bang + 1:at]
		}

		// The host part of the source, or the whole of it when it is a
		// server name.
		def host() string {
			let at = source.indexOf("@")
			return source[at + 1:] when at >= 0
			return "" unless nick() == ""
			return source
		}

		// The first parameter: the channel or nickname of a PRIVMSG,
		// NOTICE, JOIN, MODE and most other commands; "" when there is
		// none.
		def target() string {
			return "" when params.len() == 0
			return params[0]
		}

		// The last parameter: the text of a PRIVMSG or NOTICE, the reason
		// of a PART or QUIT; "" when there is none.
		def text() string {
			return "" when params.len() == 0
			return params[params.len() - 1]
		}

		// The numeric of a reply, 0 when the command is a word.
		def numeric() int {
			return 0 unless command.len() == 3 && command.isNumeric()
			return command.toInt<int>()
		}

		// Reports whether a PRIVMSG or NOTICE carries a CTCP request or
		// reply (text wrapped in 0x01 bytes).
		def isCtcp() bool {
			return false unless command := "PRIVMSG" || "NOTICE"
			let t = text()
			return t.len() >= 2 && t.startsWith(ctcpMark) && (t.endsWith(ctcpMark) || !t[1:].contains(ctcpMark))
		}

		// The CTCP command of a CTCP message, upper-cased (`ACTION`,
		// `VERSION`, `PING`); "" when it is not one.
		def ctcpCommand() string {
			return "" unless isCtcp()
			let body = ctcpBody(text())
			let space = body.indexOf(" ")
			return body.upper() when space < 0
			return body[:space].upper()
		}

		// The argument of a CTCP message: the action of an ACTION, the
		// token of a PING; "" when there is none.
		def ctcpText() string {
			return "" unless isCtcp()
			let body = ctcpBody(text())
			let space = body.indexOf(" ")
			return "" when space < 0
			return body[space + 1:]
		}

		// Reports whether the message is a `/me` action.
		def isAction() bool {
			return command == "PRIVMSG" && ctcpCommand() == "ACTION"
		}

		// The line as it goes on the wire, without the CRLF: tags escaped,
		// the last parameter written after a colon when it needs one.
		def str() string {
			let out = ""
			if messageTags.len() > 0 {
				let parts string[] = []
				for let (name, value) in messageTags {
					if value == "" {
						parts.push(name)
					} else {
						parts.push("{name}={escapeTagValue(value)}")
					}
				}
				parts.sort((a, b) => a < b)
				out = "@" + parts.join(";") + " "
			}
			out += ":{source} " unless source == ""
			out += command
			for let i = 0; i < params.len(); i++ {
				let p = params[i]
				let last = i == params.len() - 1
				if last && (p == "" || p.contains(" ") || p.startsWith(":")) {
					out += " :" + p
				} else {
					out += " " + p
				}
			}
			return out
		}
	}

	// Ctcp marks the start and end of a CTCP message.
	internal const ctcpMark = "\u0001"

	// ctcpBody is the text between the CTCP marks.
	internal def ctcpBody(t string) string {
		let body = t[1:]
		return body.trimSuffix(ctcpMark)
	}

	// parse reads one IRC line, its line ending optional: `@tags`,
	// `:source`, the command and up to fifteen parameters, the last after
	// a colon when it has spaces.
	// Fails when the line has no command.
	def parse(line string) !Message {
		let rest = line.trimEnd("\r\n")
		let tags = map<string, string>{}
		if rest.startsWith("@") {
			let space = rest.indexOf(" ")
			fail IrcError{message: "irc: message has only tags", code: "0", reply: 0, text: line} when space < 0
			for let item in rest[1:space].split(";") {
				continue when item == ""
				let eq = item.indexOf("=")
				if eq < 0 {
					tags[item] = ""
				} else {
					tags[item[:eq]] = unescapeTagValue(item[eq + 1:])
				}
			}
			rest = rest[space + 1:].trimStart(" ")
		}
		let source = ""
		if rest.startsWith(":") {
			let space = rest.indexOf(" ")
			fail IrcError{message: "irc: message has no command", code: "0", reply: 0, text: line} when space < 0
			source = rest[1:space]
			rest = rest[space + 1:].trimStart(" ")
		}
		let params string[] = []
		let command = ""
		for rest != "" {
			if command != "" && rest.startsWith(":") {
				params.push(rest[1:])
				break
			}
			let space = rest.indexOf(" ")
			let word = space < 0 ?? (rest, rest[:space])
			rest = space < 0 ?? ("", rest[space + 1:].trimStart(" "))
			if command == "" {
				command = word
			} else {
				params.push(word)
			}
		}
		fail IrcError{message: "irc: message has no command", code: "0", reply: 0, text: line} when command == ""
		let m = new Message(command, params)
		m.source = source
		m.messageTags = tags
		return m
	}

	// escapeTagValue writes a tag value in the escaped form of IRCv3
	// message tags: `;` as `\:`, space as `\s`, backslash, CR and LF
	// escaped too.
	def escapeTagValue(value string) string {
		let out = ""
		for let c in value {
			switch {
				case c == ';':
					out += "\\:"
				case c == ' ':
					out += "\\s"
				case c == '\\':
					out += "\\\\"
				case c == '\r':
					out += "\\r"
				case c == '\n':
					out += "\\n"
				default:
					out += string(c)
			}
		}
		return out
	}

	// unescapeTagValue reads a tag value back from its escaped form; an
	// unknown escape stands for the character after the backslash and a
	// lone backslash at the end is dropped.
	def unescapeTagValue(value string) string {
		let out = ""
		let escaped = false
		for let c in value {
			if !escaped {
				if c == '\\' {
					escaped = true
				} else {
					out += string(c)
				}
				continue
			}
			escaped = false
			switch {
				case c == ':':
					out += ";"
				case c == 's':
					out += " "
				case c == 'r':
					out += "\r"
				case c == 'n':
					out += "\n"
				default:
					out += string(c)
			}
		}
		return out
	}

	// fold is a nickname or channel name in the form two names that match
	// under the case mapping share.
	def fold(name string, mapping CaseMapping = CaseMapping.Rfc1459) string {
		let out = ""
		for let c in name {
			switch {
				case c >= 'A' && c <= 'Z':
					out += string(c.lower())
				case mapping == CaseMapping.Ascii:
					out += string(c)
				case c == '[':
					out += "\{"
				case c == ']':
					out += "\}"
				case c == '\\':
					out += "|"
				case c == '~' && mapping == CaseMapping.Rfc1459:
					out += "^"
				default:
					out += string(c)
			}
		}
		return out
	}

	// matchMask reports whether `text` matches a mask such as
	// `*!*@*.example.com`: `*` stands for any run of characters, `?` for
	// one, and `\` takes the next character as it is. Case folds under
	// `mapping`.
	def matchMask(mask string, text string, mapping CaseMapping = CaseMapping.Rfc1459) bool {
		// The mask as pattern characters, folded, each with whether it is
		// a wildcard; an escaped character is never one.
		let m char[] = []
		let wild bool[] = []
		let raw = charsOf(mask)
		for let i = 0; i < raw.len(); i++ {
			let c = raw[i]
			if c == '\\' && i + 1 < raw.len() {
				i++
				m.push(foldChar(raw[i], mapping))
				wild.push(false)
				continue
			}
			m.push(foldChar(c, mapping))
			wild.push(c := '*' || '?')
		}
		let t = charsOf(fold(text, mapping))
		let mi = 0
		let ti = 0
		let starAt = -1
		let starText = 0
		for ti < t.len() {
			if mi < m.len() && wild[mi] && m[mi] == '*' {
				starAt = mi
				starText = ti
				mi++
				continue
			}
			if mi < m.len() && ((wild[mi] && m[mi] == '?') || (!wild[mi] && m[mi] == t[ti])) {
				mi++
				ti++
				continue
			}
			return false when starAt < 0
			mi = starAt + 1
			starText++
			ti = starText
		}
		for mi < m.len() && wild[mi] && m[mi] == '*' {
			mi++
		}
		return mi == m.len()
	}

	// foldChar is one character as `fold` writes it.
	internal def foldChar(c char, mapping CaseMapping) char {
		return charsOf(fold(string(c), mapping))[0]
	}

	// stripFormatting is `text` without the mIRC formatting codes: bold,
	// italics, underline, strike-through, monospace, reverse, reset, and
	// colours with their numbers (`\x03` and `\x04` hex).
	def stripFormatting(text string) string {
		let out = ""
		let cs = charsOf(text)
		let i = 0
		for i < cs.len() {
			let code = int(cs[i])
			i++
			switch {
				case code := 0x02 || 0x0F || 0x11 || 0x16 || 0x1D || 0x1E || 0x1F:
					continue
				case code == 0x03:
					i = skipColor(cs, i, 2, false)
					continue
				case code == 0x04:
					i = skipColor(cs, i, 6, true)
					continue
			}
			out += string(cs[i - 1])
		}
		return out
	}

	// charsOf is the characters of a string, for walking it by index.
	internal def charsOf(s string) char[] {
		let out char[] = []
		for let c in s {
			out.push(c)
		}
		return out
	}

	// skipColor steps past the `fg[,bg]` of a colour code, each at most
	// `width` digits (hex digits when `hex`).
	internal def skipColor(cs char[], at int, width int, hex bool) int {
		let i = skipDigits(cs, at, width, hex)
		return i when i == at
		if i + 1 < cs.len() && cs[i] == ',' {
			let after = skipDigits(cs, i + 1, width, hex)
			return after when after > i + 1
		}
		return i
	}

	internal def skipDigits(cs char[], at int, width int, hex bool) int {
		let i = at
		for i < cs.len() && i - at < width {
			let c = cs[i]
			let ok = c >= '0' && c <= '9'
			ok = true when hex && ((c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F'))
			break unless ok
			i++
		}
		return i
	}

	// Account is who a SASL login proved the client to be.
	struct Account {
		name string
	}

	// Authenticator decides the SASL logins of a `Server`.
	interface Authenticator {
		// The account of a PLAIN login. Fails when the account or the
		// password is wrong; the client is told `904`, not why.
		def login(account string, password Secret<string>) !Account

		// The account a TLS client certificate belongs to, by the SHA-256
		// fingerprint of its DER in lower-case hex. Fails when no account
		// has that certificate.
		def certificate(fingerprint string) !Account

		// The SCRAM-SHA-256 credentials of an account, as
		// `scramCredentials` derives them from its password. Fails when
		// the account is unknown or has none.
		def scram(account string) !ScramCredentials
	}

	// ScramCredentials are what a server keeps of a password to check a
	// SCRAM-SHA-256 login (RFC 5802 §3): the salt, the iteration count and
	// two keys derived from them, never the password itself.
	struct ScramCredentials {
		salt       byte[]
		iterations int
		storedKey  byte[]
		serverKey  byte[]
	}

	// scramCredentials derives the SCRAM-SHA-256 credentials of a password
	// with `iterations` rounds of PBKDF2 over a random 16-byte salt.
	// Fails when the system has no randomness to give.
	def scramCredentials(password Secret<string>, iterations int = 4096) !ScramCredentials {
		let salt = try rand(16)
		return scramCredentials(password, salt, iterations)
	}

	// scramCredentials derives the credentials of a password over a given
	// salt, to rebuild stored ones.
	def scramCredentials(password Secret<string>, salt byte[], iterations int) ScramCredentials {
		let salted = pbkdf2(Hash.SHA256, password.reveal().bytes(), salt, iterations, 32)
		let clientKey = hmac(Hash.SHA256, salted, "Client Key".bytes())
		return ScramCredentials{
			salt: salt,
			iterations: iterations,
			storedKey: digest(Hash.SHA256, clientKey),
			serverKey: hmac(Hash.SHA256, salted, "Server Key".bytes()),
		}
	}

	// Accounts is an `Authenticator` over a fixed list of accounts, each
	// with a password and any number of certificate fingerprints.
	//
	// ```
	// let accounts = new irc.Accounts()
	// accounts.add("alice", "s3cret")
	// accounts.addCertificate("alice", "9f86d081884c7d65...")
	// server.authenticator = accounts
	// ```
	type Accounts {
		internal passwords    map<string, Secret<string>>
		internal fingerprints map<string, string>
		internal scramKeys    map<string, ScramCredentials>

		def new() {}

		// Adds an account, replacing the password of one of the same name.
		// Its SCRAM credentials are derived here, once.
		atomic def add(account string, password Secret<string>) {
			passwords[account] = password
			let keys = scramCredentials(password) onerror recover ScramCredentials{salt: [], iterations: 0, storedKey: [], serverKey: []}
			scramKeys[account] = keys
		}

		// Lets a TLS client certificate log in as the account, by the
		// SHA-256 fingerprint of its DER in hex (colons and case do not
		// matter).
		atomic def addCertificate(account string, fingerprint string) {
			fingerprints[fingerprint.replace(":", "").lower()] = account
		}

		// Removes an account and its certificates; an unknown name does
		// nothing.
		atomic def remove(account string) {
			passwords.delete(account)
			scramKeys.delete(account)
			let kept = map<string, string>{}
			for let (print, owner) in fingerprints {
				kept[print] = owner unless owner == account
			}
			fingerprints = kept
		}

		// Implements Authenticator. Fails when the account is unknown or
		// the password does not match.
		atomic def login(account string, password Secret<string>) !Account {
			let want = passwords.get(account)
			fail "login refused" when want is none
			fail "login refused" unless sameText(want.reveal(), password.reveal())
			return Account{name: account}
		}

		// Implements Authenticator. Fails when no account has the
		// certificate.
		atomic def certificate(fingerprint string) !Account {
			let owner = fingerprints.get(fingerprint.lower())
			fail "unknown certificate" when owner is none
			return Account{name: owner}
		}

		// Implements Authenticator. Fails when the account is unknown.
		atomic def scram(account string) !ScramCredentials {
			let keys = scramKeys.get(account)
			fail "login refused" when keys is none || keys.iterations == 0
			return keys
		}
	}

	// sameText compares two strings in time that depends on their
	// lengths only, not on where they differ.
	internal def sameText(a string, b string) bool {
		let x = a.bytes()
		let y = b.bytes()
		return false when x.len() != y.len()
		let diff = 0
		for let i = 0; i < x.len(); i++ {
			diff = diff | (int(x[i]) ^ int(y[i]))
		}
		return diff == 0
	}
}
