partial module std.net.irc {
	use (
		std.net.irc.proto::*
		std.testing
	)

	check "IRC messages" {
		@test()
		def parsesSourceCommandAndTrailing() !none {
			let m = try parse(":alice!ada@host.example PRIVMSG #adm :hello there\r\n")
			assert m.source == "alice!ada@host.example"
			assert m.nick() == "alice"
			assert m.user() == "ada"
			assert m.host() == "host.example"
			assert m.command == "PRIVMSG"
			assert m.target() == "#adm"
			assert m.text() == "hello there"
			assert m.params.len() == 2
			assert m.numeric() == 0
			return none
		}

		@test()
		def parsesNumericsAndServerSources() !none {
			let m = try parse(":irc.example.com 001 ada :Welcome to the network")
			assert m.numeric() == 1
			assert m.nick() == ""
			assert m.host() == "irc.example.com"
			assert m.params[0] == "ada"
			let bare = try parse("PING")
			assert bare.command == "PING"
			assert bare.params.len() == 0
			assert bare.text() == ""
			let spaced = try parse("MODE  #adm   +o  ada")
			assert spaced.params.len() == 3
			return none
		}

		@test()
		def parsesAndEscapesTags() !none {
			let m = try parse("@time=2026-09-28T10:00:00.000Z;+example/x=a\\sb\\:c\\\\d;flag :n!u@h TAGMSG #adm")
			assert m.tagValue("time") == "2026-09-28T10:00:00.000Z"
			assert m.tagValue("+example/x") == "a b;c\\d"
			assert m.hasTag("flag")
			assert m.tagValue("flag") == ""
			assert !m.hasTag("missing")
			assert m.command == "TAGMSG"
			assert escapeTagValue("a b;c\\d\r\n") == "a\\sb\\:c\\\\d\\r\\n"
			assert unescapeTagValue("x\\") == "x"
			assert unescapeTagValue("\\q") == "q"
			return none
		}

		@test()
		def writesTheWireForm() !none {
			let m = new Message("privmsg", ["#adm", "hello there"])
			assert m.str() == "PRIVMSG #adm :hello there"
			let single = new Message("JOIN", ["#adm"])
			assert single.str() == "JOIN #adm"
			let colon = new Message("PRIVMSG", ["#adm", ":)"])
			assert colon.str() == "PRIVMSG #adm ::)"
			let blank = new Message("AWAY", [""])
			assert blank.str() == "AWAY :"
			let tagged = new Message("TAGMSG", ["#adm"])
			tagged.messageTags["+typing"] = "active"
			tagged.messageTags["label"] = "a b"
			tagged.source = "ada!a@h"
			assert tagged.str() == "@+typing=active;label=a\\sb :ada!a@h TAGMSG #adm"
			let back = try parse(tagged.str())
			assert back.tagValue("label") == "a b"
			return none
		}

		@test()
		def rejectsLinesWithoutACommand() {
			for let bad in ["", ":source.only", "@tags=only"] {
				let failed = false
				parse(bad) onerror (err error) {
					failed = true
					recover new Message("")
				}
				assert failed
			}
		}

		@test()
		def readsCtcp() !none {
			let action = try parse(":ada!a@h PRIVMSG #adm :\u0001ACTION waves\u0001")
			assert action.isCtcp()
			assert action.isAction()
			assert action.ctcpCommand() == "ACTION"
			assert action.ctcpText() == "waves"
			let version = try parse(":ada!a@h PRIVMSG bob :\u0001version\u0001")
			assert version.ctcpCommand() == "VERSION"
			assert version.ctcpText() == ""
			let plain = try parse(":ada!a@h PRIVMSG bob :hi")
			assert !plain.isCtcp()
			assert plain.ctcpCommand() == ""
			return none
		}
	}

	check "IRC names and masks" {
		@test()
		def foldsUnderEachCaseMapping() {
			assert fold("Ada[]\\~") == "ada\{\}|^"
			assert fold("Ada[]\\~", CaseMapping.StrictRfc1459) == "ada\{\}|~"
			assert fold("Ada[]\\~", CaseMapping.Ascii) == "ada[]\\~"
		}

		@test()
		def matchesMasks() {
			assert matchMask("*!*@*.example.com", "ada!a@host.example.com")
			assert matchMask("ADA!*@*", "ada!a@h")
			assert matchMask("a?a!*@*", "ada!x@y")
			assert !matchMask("a?a!*@*", "adda!x@y")
			assert matchMask("*", "")
			assert !matchMask("*.org", "example.com")
			assert matchMask("a\\*b", "a*b")
			assert !matchMask("a\\*b", "axb")
			assert matchMask("[x]*", "\{x\}yz")
		}

		@test()
		def stripsFormatting() {
			let text = "\u0002bold\u0002 \u000304,12red\u000F plain \u000412ABCDhex\u001D it\u001F"
			assert stripFormatting(text) == "bold red plain hex it"
			assert stripFormatting("\u00031,2,3") == ",3"
			assert stripFormatting("no codes") == "no codes"
		}

		@test()
		def normalizesBanMasks() {
			assert normalizeMask("ada") == "ada!*@*"
			assert normalizeMask("a@host") == "*!a@host"
			assert normalizeMask("ada!a") == "ada!a@*"
			assert normalizeMask("*!*@x") == "*!*@x"
		}

		@test()
		def checksNamesAndChannels() {
			assert validNick("ada", 30)
			assert validNick("[ada]_", 30)
			assert !validNick("1ada", 30)
			assert !validNick("ada lovelace", 30)
			assert !validNick("abcdefghij", 9)
			assert validChannel("#adm", 50)
			assert validChannel("&local", 50)
			assert !validChannel("adm", 50)
			assert !validChannel("#a,b", 50)
			assert !validChannel("#", 50)
		}
	}

	check "IRC line limits" {
		@test()
		def splitsLongTextAtSpaces() {
			let words string[] = []
			for let i = 0; i < 100; i++ {
				words.push("word{i}")
			}
			let pieces = splitText(words.join(" "), 100)
			assert pieces.len() > 1
			for let p in pieces {
				assert p.bytes().len() <= 100
				assert !p.startsWith(" ")
			}
			assert pieces.join(" ") == words.join(" ")
			assert splitText("one\ntwo\r\n\nthree", 100).join("|") == "one|two|three"
		}

		@test()
		def neverSplitsInsideACharacter() {
			let text = "é".repeat(100)
			for let p in splitText(text, 51) {
				assert p.bytes().len() <= 51
				assert p == "é".repeat(p.len())
			}
		}

		@test()
		def cutsLinesTo512Bytes() {
			let long = "PRIVMSG #adm :" + "x".repeat(600)
			assert fitLine(long).bytes().len() == 510
			let tagged = "@label=1 " + long
			assert fitLine(tagged).bytes().len() == 510 + "@label=1 ".len()
			assert fitLine("PING :x") == "PING :x"
		}
	}
}
