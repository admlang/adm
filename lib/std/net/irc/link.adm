internal partial module std.net.irc.proto {
	use (
		std.net
		std.net.irc::*
		std.time
	)

	// Incoming is one message the reader passed on, or the failure that
	// ended the connection (none for a clean end).
	type Incoming {
		message ?Message = none
		failure ?error   = none
		ended   bool     = false

		def new() {}
	}

	// Waiter collects the replies to one request of a client: the
	// reader hands it every message `wants` accepts, and a message with
	// an empty command when the wait times out or the connection ends.
	type Waiter {
		wants def (Message) bool
		got   channel<Message>
		atomic over bool = false

		def new(wants def (Message) bool) {
			self.wants = wants
			got = new channel<Message>(1024)
		}

		// offer hands a message over when the waiter wants it and has
		// room.
		def offer(m Message) {
			return when over
			got <- m when wants(m) && got.len() < got.cap() - 1
		}

		// stop ends the wait with an empty message.
		def stop() {
			return when over
			over = true
			got <- new Message("")
		}
	}

	// Sender writes a client's lines, one at a time, holding back
	// bursts: `burst` lines go at once, then one each `interval`.
	type Sender {
		stream   net.Stream
		timeout  duration
		throttle bool
		burst    int
		interval duration
		// The flood timer: when the line after the burst may go.
		atomic next int64 = 0

		def new(stream net.Stream, timeout duration, throttle bool, burst int, interval duration) {
			self.stream = stream
			self.timeout = timeout
			self.throttle = throttle
			self.burst = burst
			self.interval = interval
		}

		// Writes one line, CRLF added. Fails when the write does.
		atomic def write(line string) !none {
			if throttle {
				let now = time.monoNs()
				let step = int64(interval)
				next = now - step * int64(burst) when next < now - step * int64(burst)
				next += step
				let wait = next - now
				time.sleep(duration(wait)) when wait > 0
			}
			return try writeFully(stream, (fitLine(line) + "\r\n").bytes(), timeout)
		}
	}

	// ChanView is what a client knows of a channel it is in.
	type ChanView {
		name    string
		topic   string            = ""
		topicBy string            = ""
		topicAt int64             = 0
		// Mode letters set, with the arguments of those that keep one
		// (key, limit) by letter.
		flags   map<string, string>
		// Members: nickname to status prefixes (`@`, `+`).
		members map<string, string>
		// Members by folded nickname to their nickname as shown.
		names   map<string, string>

		def new(name string) {
			self.name = name
		}
	}

	// ClientState is what a client learned from the server: its own
	// nickname, the ISUPPORT tokens, the capabilities acknowledged and
	// the channels it is in. The reader task updates it; the client's
	// callers read it, so every method is atomic.
	type ClientState {
		me       string                = ""
		account  string                = ""
		isupport map<string, string>
		caps     map<string, string>
		mapping  CaseMapping           = CaseMapping.Rfc1459
		// Prefix mode letter to prefix character, from PREFIX.
		prefixes map<string, string>
		chans    map<string, ChanView>
		waiters  Waiter[]

		def new() {
			prefixes["o"] = "@"
			prefixes["v"] = "+"
		}

		atomic def nick() string {
			return me
		}

		atomic def accountName() string {
			return account
		}

		atomic def feature(name string) string {
			let v = isupport.get(name.upper())
			return "" when v is none
			return v
		}

		atomic def hasFeature(name string) bool {
			return isupport.hasKey(name.upper())
		}

		atomic def hasCap(name string) bool {
			return caps.hasKey(name)
		}

		atomic def ackCap(name string, value string) {
			caps[name] = value
		}

		atomic def dropCap(name string) {
			caps.delete(name)
		}

		atomic def folded(name string) string {
			return fold(name, mapping)
		}

		atomic def channelNames() string[] {
			let out string[] = []
			for let (_, ch) in chans {
				out.push(ch.name)
			}
			out.sort((a, b) => a < b)
			return out
		}

		atomic def channel(name string) ?Channel {
			let ch = chans.get(fold(name, mapping))
			return none when ch is none
			let modes = "+"
			let args string[] = []
			let letters string[] = []
			for let (letter, _) in ch.flags {
				letters.push(letter)
			}
			letters.sort((a, b) => a < b)
			for let letter in letters {
				modes += letter
				let arg = ch.flags.get(letter)
				args.push(arg) when !(arg is none) && arg != ""
			}
			modes = modes + " " + args.join(" ") when args.len() > 0
			return Channel{name: ch.name, topic: ch.topic, topicBy: ch.topicBy, topicAt: ch.topicAt, modes: modes, members: ch.members.clone()}
		}

		atomic def addWaiter(w Waiter) {
			waiters.push(w)
		}

		atomic def removeWaiter(w Waiter) {
			let kept Waiter[] = []
			for let x in waiters {
				kept.push(x) unless x == w
			}
			waiters = kept
		}

		atomic def currentWaiters() Waiter[] {
			return waiters.clone()
		}

		// Learns from one message: nicknames, channels, topics, members,
		// modes, ISUPPORT.
		atomic def apply(m Message) {
			let who = m.nick()
			let mine = who != "" && fold(who, mapping) == fold(me, mapping)
			switch {
				case m.command == "001":
					me = m.target()
				case m.command == "005":
					isupportTokens(m)
				case m.command == "JOIN":
					let name = m.target()
					let key = fold(name, mapping)
					chans[key] = new ChanView(name) when mine
					let ch = chans.get(key)
					if !(ch is none) {
						ch.members[who] = ""
						ch.names[fold(who, mapping)] = who
					}
				case m.command == "PART":
					removeMember(m.target(), who, mine)
				case m.command == "KICK":
					let victim = m.params.len() > 1 ?? (m.params[1], "")
					removeMember(m.target(), victim, fold(victim, mapping) == fold(me, mapping))
				case m.command == "QUIT":
					for let (_, ch) in chans {
						dropMember(ch, who)
					}
				case m.command == "NICK":
					let fresh = m.target()
					for let (_, ch) in chans {
						let key = fold(who, mapping)
						let shown = ch.names.get(key)
						continue when shown is none
						let status = ch.members.get(shown)
						ch.members.delete(shown)
						ch.names.delete(key)
						ch.members[fresh] = status is none ?? ("", status)
						ch.names[fold(fresh, mapping)] = fresh
					}
					me = fresh when mine
				case m.command == "353":
					namesReply(m)
				case m.command == "332":
					let ch = chanOf(m.params, 1)
					ch.topic = m.text() unless ch is none
				case m.command == "333":
					let ch = chanOf(m.params, 1)
					if !(ch is none) && m.params.len() > 3 {
						ch.topicBy = m.params[2]
						ch.topicAt = m.params[3].toInt<int64>() when m.params[3].isNumeric()
					}
				case m.command == "TOPIC":
					let ch = chans.get(fold(m.target(), mapping))
					if !(ch is none) {
						ch.topic = m.text()
						ch.topicBy = m.source
						ch.topicAt = time.wallNs() / 1000000000
					}
				case m.command == "324":
					let ch = chanOf(m.params, 1)
					if !(ch is none) {
						ch.flags = map<string, string>{}
						applyModes(ch, m.params[2:])
					}
				case m.command == "MODE":
					let ch = chans.get(fold(m.target(), mapping))
					applyModes(ch, m.params[1:]) unless ch is none
				case m.command == "900":
					account = m.params.len() > 2 ?? (m.params[2], "")
				case m.command == "901":
					account = ""
				case m.command == "ACCOUNT":
					account = m.target() == "*" ?? ("", m.target()) when mine
			}
		}

		internal def chanOf(params string[], at int) ?ChanView {
			return none when params.len() <= at
			return chans.get(fold(params[at], mapping))
		}

		internal def removeMember(name string, nick string, mine bool) {
			let key = fold(name, mapping)
			if mine {
				chans.delete(key)
				return
			}
			let ch = chans.get(key)
			dropMember(ch, nick) unless ch is none
		}

		internal def dropMember(ch ChanView, nick string) {
			let key = fold(nick, mapping)
			let shown = ch.names.get(key)
			return when shown is none
			ch.members.delete(shown)
			ch.names.delete(key)
		}

		internal def isupportTokens(m Message) {
			return when m.params.len() < 3
			for let token in m.params[1:m.params.len() - 1] {
				if token.startsWith("-") {
					isupport.delete(token[1:].upper())
					continue
				}
				let eq = token.indexOf("=")
				let name = eq < 0 ?? (token, token[:eq])
				let value = eq < 0 ?? ("", unescapeIsupport(token[eq + 1:]))
				isupport[name.upper()] = value
				if name.upper() == "CASEMAPPING" {
					switch {
						case value == "ascii":
							mapping = CaseMapping.Ascii
						case value == "strict-rfc1459":
							mapping = CaseMapping.StrictRfc1459
						default:
							mapping = CaseMapping.Rfc1459
					}
				}
				if name.upper() == "PREFIX" && value.startsWith("(") {
					let close = value.indexOf(")")
					continue when close < 0
					let letters = value[1:close]
					let symbols = value[close + 1:]
					prefixes = map<string, string>{}
					for let i = 0; i < letters.len() && i < symbols.len(); i++ {
						prefixes[letters[i:i + 1]] = symbols[i:i + 1]
					}
				}
			}
		}

		internal def isPrefixChar(c string) bool {
			for let (_, symbol) in prefixes {
				return true when symbol == c
			}
			return false
		}

		internal def namesReply(m Message) {
			return when m.params.len() < 4
			let ch = chans.get(fold(m.params[2], mapping))
			return when ch is none
			for let entry in m.text().split(" ") {
				continue when entry == ""
				let status = ""
				let rest = entry
				for rest.len() > 0 && isPrefixChar(rest[:1]) {
					status += rest[:1]
					rest = rest[1:]
				}
				let bang = rest.indexOf("!")
				let nick = bang < 0 ?? (rest, rest[:bang])
				ch.members[nick] = status
				ch.names[fold(nick, mapping)] = nick
			}
		}

		// modeKinds is the CHANMODES kind of a letter: "A" list, "B"
		// always an argument, "C" an argument when set, "D" none, "P" a
		// prefix mode.
		internal def modeKind(letter string) string {
			return "P" when prefixes.hasKey(letter)
			let spec = isupport.get("CHANMODES")
			let groups = (spec is none ?? ("beI,k,l,imnpst", spec)).split(",")
			let kinds = ["A", "B", "C", "D"]
			for let i = 0; i < groups.len() && i < 4; i++ {
				return kinds[i] when groups[i].contains(letter)
			}
			return "D"
		}

		internal def applyModes(ch ChanView, params string[]) {
			return when params.len() == 0
			let args = params[1:]
			let next = 0
			let adding = true
			for let c in params[0] {
				let letter = string(c)
				if letter := "+" || "-" {
					adding = letter == "+"
					continue
				}
				let kind = modeKind(letter)
				let takes = (kind := "A" || "B" || "P") || (kind == "C" && adding)
				let arg = ""
				if takes && next < args.len() {
					arg = args[next]
					next++
				}
				switch {
					case kind == "P":
						let shown = ch.names.get(fold(arg, mapping))
						continue when shown is none
						let symbol = prefixes.get(letter)
						continue when symbol is none
						let current = ch.members.get(shown)
						let status = current is none ?? ("", current)
						if adding {
							status += symbol unless status.contains(symbol)
						} else {
							status = status.replace(symbol, "")
						}
						ch.members[shown] = orderPrefixes(status)
					case kind == "A":
						continue
					default:
						if adding {
							ch.flags[letter] = arg
						} else {
							ch.flags.delete(letter)
						}
				}
			}
		}

		// orderPrefixes puts status prefixes in PREFIX order, highest
		// first.
		internal def orderPrefixes(status string) string {
			let spec = isupport.get("PREFIX")
			let order = (spec is none ?? ("(ov)@+", spec))
			let close = order.indexOf(")")
			let symbols = close < 0 ?? ("@+", order[close + 1:])
			let out = ""
			for let i = 0; i < symbols.len(); i++ {
				let s = symbols[i:i + 1]
				out += s when status.contains(s)
			}
			return out
		}
	}

	// unescapeIsupport reads the `\xHH` escapes of an ISUPPORT value.
	def unescapeIsupport(value string) string {
		return value unless value.contains("\\x")
		let out byte[] = []
		let b = value.bytes()
		let i = 0
		for i < b.len() {
			if b[i] == byte(92) && i + 3 < b.len() && b[i + 1] == byte(120) {
				let hex = string(b[i + 2:i + 4])
				if hex.isHexadecimal() {
					out.push(byte(parseInt<int>(hex, 16)))
					i += 4
					continue
				}
			}
			out.push(b[i])
			i++
		}
		return string(out)
	}
}
