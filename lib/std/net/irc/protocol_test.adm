partial module std.net.irc {
	use (
		std.crypto.x509::(CertPool)
		std.net
		std.net.irc.proto::*
		std.net.tls
		std.testing
		std.time
	)

	// A self-signed P-256 certificate for 127.0.0.1, localhost and
	// example.com, valid for a century (the one httptest presents).
	internal const ircCertPEM =
		"-----BEGIN CERTIFICATE-----\n" +
		"MIIByzCCAXCgAwIBAgIULZ61fkBLJqpHXo7Dg3TjjURKNKQwCgYIKoZIzj0EAwIw\n" +
		"EzERMA8GA1UEAwwIQURNIHRlc3QwIBcNMjYwOTE2MjEyNDQ4WhgPMjEyNjA4MjMy\n" +
		"MTI0NDhaMBMxETAPBgNVBAMMCEFETSB0ZXN0MFkwEwYHKoZIzj0CAQYIKoZIzj0D\n" +
		"AQcDQgAEWmnKIPFi8/hNfbTouWeJ0sX7jXIK0H2BdAa3ZlChTQUtkRXRuGnkYmY9\n" +
		"c9D2sLIU0D8YtBwSi1XCEXkyARGL3KOBnzCBnDAdBgNVHQ4EFgQUdGEQb1u97o8W\n" +
		"5FkheQ27r3JNU3AwHwYDVR0jBBgwFoAUdGEQb1u97o8W5FkheQ27r3JNU3AwDwYD\n" +
		"VR0TAQH/BAUwAwEB/zAnBgNVHREEIDAegglsb2NhbGhvc3SCC2V4YW1wbGUuY29t\n" +
		"hwR/AAABMAsGA1UdDwQEAwIHgDATBgNVHSUEDDAKBggrBgEFBQcDATAKBggqhkjO\n" +
		"PQQDAgNJADBGAiEA6p+D8so1nzo4nOkB8z0x1Tq+9iG1qIweVo/zTnSHG9cCIQDo\n" +
		"ANw/RkMk5iyYvJf8Qx75u8fY/n2s26d6Clj96iuH/g==\n" +
		"-----END CERTIFICATE-----\n"

	internal const ircKeyPEM =
		"-----BEGIN PRIVATE KEY-----\n" +
		"MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgz6zLOlG3plulCC6J\n" +
		"73w4HvDFzW9lrGWy0U1PuM2M1gWhRANCAARaacog8WLz+E19tOi5Z4nSxfuNcgrQ\n" +
		"fYF0BrdmUKFNBS2RFdG4aeRiZj1z0PawshTQPxi0HBKLVcIReTIBEYvc\n" +
		"-----END PRIVATE KEY-----\n"

	// startIrc serves a test network on an ephemeral loopback port.
	internal def startIrc() !Server {
		return try startIrc(def (s Server) {})
	}

	// startIrc with the server's settings changed before it starts.
	internal def startIrc(configure def (Server)) !Server {
		let server = new Server("irc.test", "127.0.0.1:0")
		server.network = "TestNet"
		server.motd = "Welcome\nBe nice"
		server.floodControl = false
		server.timeout = 5s
		configure(server)
		try server.start()
		return server
	}

	// dialIrc registers a client with a nickname.
	internal def dialIrc(server Server, nick string) !Client {
		return try dialIrc(server, nick, def (c Client) {})
	}

	internal def dialIrc(server Server, nick string, configure def (Client)) !Client {
		let client = new Client(nick, Security.Plain, 5s)
		client.throttle = false
		configure(client)
		try client.connect(server.address().str())
		return client
	}

	// trustTest makes a client trust the test certificate.
	internal def trustTest(c Client) {
		let pool = new CertPool()
		pool.appendCertsFromPEM(ircCertPEM)
		c.tls = tls.Config{serverName: "localhost", rootCAs: pool}
	}

	// waitFor reads a client's messages until one `wanted` accepts; the
	// client is closed after 10 seconds so a missing message fails the
	// test instead of hanging it.
	internal def waitFor(c Client, wanted def (Message) bool) !Message {
		let guard = new Guard(c)
		let watchdog = async guard.watch(10s)
		watchdog.keepAlive()
		for {
			let next = try c.next()
			if next is none {
				guard.done = true
				fail "connection ended before the message came"
			}
			if wanted(next) {
				guard.done = true
				return next
			}
		}
		fail "unreachable"
	}

	// Guard closes a client unless its wait is done in time.
	internal type Guard {
		client Client
		atomic done bool = false

		def new(client Client) {
			self.client = client
		}

		def watch(after duration) {
			time.sleep(after)
			if !done {
				client.close() onerror recover none
			}
		}
	}

	// RawIrc is a bare connection driven line by line.
	internal type RawIrc {
		socket net.Connection
		lines  LineReader

		def new(socket net.Connection) {
			self.socket = socket
			lines = new LineReader(socket)
		}

		def send(line string) !none {
			return try writeFully(socket, (line + "\r\n").bytes(), 5s)
		}

		// expect reads until a message with the command comes.
		def expect(command string) !Message {
			for {
				let m = try parse(try lines.readLine(5s))
				return m when m.command == command
			}
			fail "unreachable"
		}
	}

	internal def rawIrc(server Server) !RawIrc {
		return new RawIrc(try net.dialStream(server.address().str(), 5s))
	}

	// statusOf is a member's status prefixes, "-" when not a member.
	internal def statusOf(ch Channel, nick string) string {
		let status = ch.members.get(nick)
		return "-" when status is none
		return status
	}

	// replyOf is the numeric an IrcError carries, 0 for any other error.
	internal def replyOf(err error) int {
		return err.reply when err is IrcError
		return 0
	}

	check "IRC protocol" {
		@test()
		def registersAndWelcomes() !none {
			let server = try startIrc()
			let ada = try dialIrc(server, "ada")
			assert ada.nickname() == "ada"
			assert ada.feature("NETWORK") == "TestNet"
			assert ada.feature("CASEMAPPING") == "rfc1459"
			assert ada.hasCapability("server-time")
			assert ada.hasCapability("message-tags")
			assert !ada.hasCapability("sasl")
			let welcome = try waitFor(ada, m => m.command == "001")
			assert welcome.text().contains("TestNet")
			let motd = try waitFor(ada, m => m.command == "372")
			assert motd.text() == "- Welcome"
			assert server.userCount() == 1
			assert server.connectionCount() == 1
			try ada.quit()
			try server.close()
			return none
		}

		@test()
		def takenNicknameGetsAnUnderscore() !none {
			let server = try startIrc()
			let first = try dialIrc(server, "ada")
			let second = try dialIrc(server, "ADA")
			assert second.nickname() == "ADA_"
			let failed = 0
			second.changeNick("ada") onerror (err error) {
				failed = replyOf(err)
				recover none
			}
			assert failed == 433
			try second.changeNick("lovelace")
			assert second.nickname() == "lovelace"
			try first.close()
			try second.close()
			try server.close()
			return none
		}

		@test()
		def talksInAChannel() !none {
			let server = try startIrc()
			let ada = try dialIrc(server, "ada")
			let bob = try dialIrc(server, "bob")
			try ada.join("#adm")
			try bob.join("#ADM")
			try waitFor(ada, m => m.command == "JOIN" && m.nick() == "bob")
			let ch = ada.getChannel("#adm")
			fail "no channel state" when ch is none
			assert statusOf(ch, "ada") == "@"
			assert statusOf(ch, "bob") == ""
			assert ada.channels().join(",") == "#adm"

			try ada.say("#adm", "hello there")
			let heard = try waitFor(bob, m => m.command == "PRIVMSG")
			assert heard.nick() == "ada"
			assert heard.target() == "#adm"
			assert heard.text() == "hello there"
			assert heard.hasTag("time")
			// echo-message sends the speaker its own line back.
			let echo = try waitFor(ada, m => m.command == "PRIVMSG")
			assert echo.text() == "hello there"

			try ada.action("#adm", "waves")
			let action = try waitFor(bob, m => m.isAction())
			assert action.ctcpText() == "waves"
			try ada.notice("bob", "psst")
			let note = try waitFor(bob, m => m.command == "NOTICE")
			assert note.target() == "bob"

			try ada.setTopic("#adm", "ADM talk")
			try waitFor(bob, m => m.command == "TOPIC")
			let seen = bob.getChannel("#adm")
			fail "no channel state" when seen is none
			assert seen.topic == "ADM talk"

			// Only operators change a locked topic.
			let refused = 0
			bob.setTopic("#adm", "mine now") onerror (err error) {
				refused = replyOf(err)
				recover none
			}
			assert refused == 482

			try bob.part("#adm", "later")
			let left = try waitFor(ada, m => m.command == "PART")
			assert left.nick() == "bob"
			assert left.text() == "later"
			assert bob.channels().len() == 0
			try ada.close()
			try bob.close()
			try server.close()
			return none
		}

		@test()
		def channelModesGuardTheDoor() !none {
			let server = try startIrc()
			let ada = try dialIrc(server, "ada")
			let bob = try dialIrc(server, "bob")
			try ada.join("#club")
			try ada.mode("#club", "+i")
			try waitFor(ada, m => m.command == "MODE" && m.target() == "#club")
			assert (try ada.mode("#club")).contains("i")

			let code = 0
			bob.join("#club") onerror (err error) {
				code = replyOf(err)
				recover none
			}
			assert code == 473
			try ada.invite("bob", "#club")
			try waitFor(bob, m => m.command == "INVITE")
			try bob.join("#club")

			try ada.mode("#club", "+o", ["bob"])
			try waitFor(bob, m => m.command == "MODE" && m.text() == "bob")
			let ch = bob.getChannel("#club")
			fail "no channel state" when ch is none
			assert statusOf(ch, "bob") == "@"

			try ada.mode("#club", "-i+k", ["sesame"])
			try waitFor(ada, m => m.command == "MODE" && m.params.len() > 2)
			let carol = try dialIrc(server, "carol")
			code = 0
			carol.join("#club") onerror (err error) {
				code = replyOf(err)
				recover none
			}
			assert code == 475
			try carol.join("#club", "sesame")

			try ada.kick("#club", "carol", "house rules")
			let kicked = try waitFor(carol, m => m.command == "KICK")
			assert kicked.params[1] == "carol"
			assert kicked.text() == "house rules"
			assert carol.channels().len() == 0

			try ada.mode("#club", "+b", ["carol"])
			try waitFor(ada, m => m.command == "MODE" && m.text() == "carol!*@*")
			code = 0
			carol.join("#club", "sesame") onerror (err error) {
				code = replyOf(err)
				recover none
			}
			assert code == 474
			try ada.close()
			try bob.close()
			try carol.close()
			try server.close()
			return none
		}

		@test()
		def answersQueries() !none {
			let server = try startIrc()
			let ada = try dialIrc(server, "ada", def (c Client) {
				c.realName = "Ada Lovelace"
				c.user = "al"
			})
			let bob = try dialIrc(server, "bob")
			try ada.join("#adm")
			try bob.join("#adm")
			try ada.setTopic("#adm", "engines")
			try ada.away("computing")

			let w = try bob.whois("ada")
			assert w.nick == "ada"
			assert w.user == "al"
			assert w.realName == "Ada Lovelace"
			assert w.server == "irc.test"
			assert w.channels.join(" ") == "@#adm"
			assert w.away == "computing"
			assert !w.operator
			let missing = 0
			bob.whois("nobody") onerror (err error) {
				missing = replyOf(err)
				recover Whois{nick: "", user: "", host: "", realName: "", server: "", serverInfo: "", channels: [], away: "", operator: false, account: "", secure: false, idle: 0, signOn: 0}
			}
			assert missing == 401

			let listing = try bob.list()
			assert listing.len() == 1
			assert listing[0].name == "#adm"
			assert listing[0].users == 2
			assert listing[0].topic == "engines"

			let who = try bob.who("#adm")
			assert who.len() == 2
			for let e in who {
				if e.nick == "ada" {
					assert e.away
					assert e.status == "@"
					assert e.realName == "Ada Lovelace"
				}
			}
			let names = try bob.names("#adm")
			assert names.len() == 2
			assert names.join(" ").contains("@ada")
			try ada.away()
			let back = try bob.whois("ada")
			assert back.away == ""
			try ada.close()
			try bob.close()
			try server.close()
			return none
		}

		@test()
		def answersCtcpAndTags() !none {
			let server = try startIrc()
			let ada = try dialIrc(server, "ada")
			let bob = try dialIrc(server, "bob", def (c Client) {
				c.version = "Bob 2.0"
			})
			try ada.ctcp("bob", "VERSION")
			let reply = try waitFor(ada, m => m.command == "NOTICE" && m.isCtcp())
			assert reply.ctcpCommand() == "VERSION"
			assert reply.ctcpText() == "Bob 2.0"

			try ada.join("#adm")
			try bob.join("#adm")
			try ada.send("@+typing=active TAGMSG #adm")
			let typing = try waitFor(bob, m => m.command == "TAGMSG")
			assert typing.tagValue("+typing") == "active"
			assert typing.nick() == "ada"
			try ada.close()
			try bob.close()
			try server.close()
			return none
		}

		@test()
		def broadcastsQuitAndAway() !none {
			let server = try startIrc()
			let ada = try dialIrc(server, "ada")
			let bob = try dialIrc(server, "bob")
			try ada.join("#adm")
			try bob.join("#adm")
			try bob.away("lunch")
			let away = try waitFor(ada, m => m.command == "AWAY")
			assert away.nick() == "bob"
			assert away.text() == "lunch"
			try bob.quit("bye")
			let quit = try waitFor(ada, m => m.command == "QUIT")
			assert quit.nick() == "bob"
			assert quit.text() == "Quit: bye"
			assert !bob.isOpen()
			let ch = ada.getChannel("#adm")
			fail "no channel state" when ch is none
			assert !ch.members.hasKey("bob")
			try ada.close()
			try server.close()
			return none
		}

		@test()
		def operatorsKill() !none {
			let server = try startIrc(def (s Server) {
				s.addOperator("root", "hunter2")
			})
			let ada = try dialIrc(server, "ada")
			let bob = try dialIrc(server, "bob")
			try ada.send("OPER root wrong")
			try waitFor(ada, m => m.command == "464")
			try ada.send("OPER root hunter2")
			try waitFor(ada, m => m.command == "381")
			assert (try bob.whois("ada")).operator
			try ada.send("KILL bob :spamming")
			let failed = false
			for {
				let m = bob.next() onerror (err error) {
					failed = true
					recover none
				}
				break when m is none
			}
			assert failed
			assert !bob.isOpen()
			// The server takes the user off once the connection is gone.
			for let i = 0; i < 200 && server.userCount() != 1; i++ {
				time.sleep(10ms)
			}
			assert server.userCount() == 1
			try ada.close()
			try server.close()
			return none
		}

		@test()
		def speaksTheRawProtocol() !none {
			let server = try startIrc()
			let raw = try rawIrc(server)
			try raw.send("PRIVMSG x :early")
			assert (try raw.expect("451")).text() == "You have not registered"
			try raw.send("NICK 1bad")
			assert (try raw.expect("432")).params[1] == "1bad"
			try raw.send("NICK raw")
			try raw.send("USER raw 8 * :Raw Client")
			try raw.expect("001")
			try raw.expect("376")
			try raw.send("FROB")
			assert (try raw.expect("421")).params[1] == "FROB"
			try raw.send("JOIN")
			assert (try raw.expect("461")).params[1] == "JOIN"
			try raw.send("PING :token")
			assert (try raw.expect("PONG")).text() == "token"
			try raw.send("MODE raw")
			assert (try raw.expect("221")).params[1] == "+i"
			try raw.send("JOIN #a,#b")
			try raw.expect("366")
			try raw.expect("366")
			try raw.send("ISON raw nobody")
			assert (try raw.expect("303")).text() == "raw"
			try raw.send("USERHOST raw")
			assert (try raw.expect("302")).text().startsWith("raw=+raw@")
			try raw.send("LUSERS")
			assert (try raw.expect("251")).text().contains("1 invisible")
			try raw.send("QUIT :done")
			assert (try raw.expect("ERROR")).text().contains("Quit: done")
			try server.close()
			return none
		}

		@test()
		def refusesAWrongServerPassword() !none {
			let server = try startIrc(def (s Server) {
				s.password = "letmein"
			})
			let code = 0
			dialIrc(server, "ada") onerror (err error) {
				code = replyOf(err)
				recover new Client("x")
			}
			assert code == 464
			let ok = try dialIrc(server, "ada", def (c Client) {
				c.password = "letmein"
			})
			assert ok.nickname() == "ada"
			try ok.close()
			try server.close()
			return none
		}

		@test()
		def logsInWithSasl() !none {
			let accounts = new Accounts()
			accounts.add("ada", "s3cret")
			let server = try startIrc(def (s Server) {
				s.authenticator = accounts
			})
			let plain = try dialIrc(server, "ada", def (c Client) {
				c.saslAccount = "ada"
				c.saslPassword = "s3cret"
			})
			assert plain.account() == "ada"
			assert plain.hasCapability("sasl")
			let scram = try dialIrc(server, "ada2", def (c Client) {
				c.saslAccount = "ada"
				c.saslPassword = "s3cret"
				c.saslMechanism = SaslMechanism.ScramSha256
			})
			assert scram.account() == "ada"
			assert (try plain.whois("ada2")).account == "ada"
			for let mech in [SaslMechanism.Plain, SaslMechanism.ScramSha256] {
				let code = 0
				dialIrc(server, "eve", def (c Client) {
					c.saslAccount = "ada"
					c.saslPassword = "guess"
					c.saslMechanism = mech
				}) onerror (err error) {
					code = replyOf(err)
					recover new Client("x")
				}
				assert code == 904
			}
			try plain.close()
			try scram.close()
			try server.close()
			return none
		}

		@test()
		def logsInWithACertificateOverTls() !none {
			let pair = try tls.parseKeyPair(ircCertPEM, ircKeyPEM)
			let accounts = new Accounts()
			accounts.addCertificate("ada", fingerprintOf(pair.chain[0]))
			let server = try startIrc(def (s Server) {
				s.security = Security.Tls
				s.tls = tls.Config{certificates: [pair], clientAuth: tls.ClientAuthType.RequestClientCert}
				s.authenticator = accounts
			})
			let ada = new Client("ada", Security.Tls, 5s)
			ada.throttle = false
			trustTest(ada)
			let config = ada.tls
			fail "no TLS config" when config is none
			config.certificates = [pair]
			ada.tls = config
			ada.saslAccount = "ada"
			ada.saslMechanism = SaslMechanism.External
			try ada.connect(server.address().str())
			assert ada.account() == "ada"
			let me = try ada.whois("ada")
			assert me.secure
			assert me.account == "ada"
			try ada.quit()
			try server.close()
			return none
		}
	}
}
