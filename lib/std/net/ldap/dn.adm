partial module std.net.ldap {
	// DN is a distinguished name (RFC 4514): relative names from the entry
	// up to the root, each one or more `type=value` pairs.
	//
	// ```
	// let dn = try ldap.parseDN("uid=alice,ou=people,dc=example,dc=com")
	// print(dn.rdn())                  // uid=alice
	// print(dn.parent().str())         // ou=people,dc=example,dc=com
	// ```
	type DN {
		// Each relative name's pairs, entry first.
		parts NamePart[][]

		def new(parts NamePart[][] = []) {
			self.parts = parts
		}

		// The name in RFC 4514 form, values escaped.
		def str() string {
			let rdns string[] = []
			for let rdn in parts {
				rdns.push(rdnText(rdn))
			}
			return rdns.join(",")
		}

		// The first relative name (`uid=alice`); "" for the root.
		def rdn() string {
			return parts.len() == 0 ?? ("", rdnText(parts[0]))
		}

		// The value of the first relative name's first pair.
		def rdnValue() string {
			return parts.len() == 0 || parts[0].len() == 0 ?? ("", parts[0][0].value)
		}

		// The name one level up; the root stays the root.
		def parent() DN {
			return parts.len() == 0 ?? (new DN(), new DN(parts[1:].clone()))
		}

		// Whether this is the empty name of the root.
		def isRoot() bool {
			return parts.len() == 0
		}

		// Whether two names are the same: types and values compared
		// without case, pairs in any order.
		def equals(other DN) bool {
			return canonical() == other.canonical()
		}

		// Whether this name is `base` or lies below it.
		def within(base DN) bool {
			return false when base.parts.len() > parts.len()
			let offset = parts.len() - base.parts.len()
			for let i = 0; i < base.parts.len(); i++ {
				return false when rdnKey(parts[offset + i]) != rdnKey(base.parts[i])
			}
			return true
		}

		// How many levels this name lies below `base`; -1 when it is not
		// within it.
		def depthBelow(base DN) int {
			return within(base) ?? (parts.len() - base.parts.len(), -1)
		}

		// The name with each type and value lowered and the pairs of each
		// relative name sorted: equal names give equal keys.
		def canonical() string {
			let rdns string[] = []
			for let rdn in parts {
				rdns.push(rdnKey(rdn))
			}
			return rdns.join(",")
		}

		// A child of this name: `rdn` in front (`cn=x`, unescaped value).
		def child(attribute string, value string) DN {
			let first NamePart[] = [NamePart{attribute:attribute, value:value}]
			let all NamePart[][] = [first]
			for let p in parts {
				all.push(p)
			}
			return new DN(all)
		}
	}

	// NamePart is one `type=value` of a relative name, the value
	// unescaped.
	struct NamePart {
		attribute string
		value     string
	}

	// parseDN reads a distinguished name in RFC 4514 form (RFC 2253 and
	// RFC 1779 spaces around separators are taken). Fails on a malformed
	// name.
	def parseDN(text string) !DN {
		let parts NamePart[][] = []
		let raw = text.trim().bytes()
		return new DN() when raw.len() == 0
		let i = 0
		let rdn NamePart[] = []
		for {
			for i < raw.len() && raw[i] == byte(32) {
				i++
			}
			let typeStart = i
			for i < raw.len() && raw[i] != byte(61) {
				i++
			}
			fail failure(ResultCode.InvalidDNSyntax, "no '=' in {text}") when i >= raw.len()
			let attribute = string(raw[typeStart:i]).trim()
			fail failure(ResultCode.InvalidDNSyntax, "empty attribute type in {text}") when attribute == ""
			i++
			for i < raw.len() && raw[i] == byte(32) {
				i++
			}
			let value byte[] = []
			if i < raw.len() && raw[i] == byte(35) {
				// #hex: the BER encoding of the value.
				i++
				let hexStart = i
				for i < raw.len() && raw[i] != byte(44) && raw[i] != byte(43) && raw[i] != byte(59) {
					i++
				}
				let decoded = hexValue(string(raw[hexStart:i]).trim()) onerror fail failure(ResultCode.InvalidDNSyntax, "bad #hex value in {text}")
				value = decoded
			} else if i < raw.len() && raw[i] == byte(34) {
				// A quoted value (RFC 1779).
				i++
				for i < raw.len() && raw[i] != byte(34) {
					if raw[i] == byte(92) && i + 1 < raw.len() {
						i++
					}
					value.push(raw[i])
					i++
				}
				i++
			} else {
				let trailing = 0
				for i < raw.len() && raw[i] != byte(44) && raw[i] != byte(43) && raw[i] != byte(59) {
					if raw[i] == byte(92) {
						fail failure(ResultCode.InvalidDNSyntax, "dangling escape in {text}") when i + 1 >= raw.len()
						let next = raw[i + 1]
						if isHexDigit(next) && i + 2 < raw.len() && isHexDigit(raw[i + 2]) {
							value.push(byte(hexDigit(next) * 16 + hexDigit(raw[i + 2])))
							i += 3
						} else {
							value.push(next)
							i += 2
						}
						trailing = 0
						continue
					}
					trailing = raw[i] == byte(32) ?? (trailing + 1, 0)
					value.push(raw[i])
					i++
				}
				value = value[:value.len() - trailing].clone()
			}
			rdn.push(NamePart{attribute: attribute, value: string(value)})
			for i < raw.len() && raw[i] == byte(32) {
				i++
			}
			if i >= raw.len() {
				parts.push(rdn)
				break
			}
			if raw[i] == byte(43) {
				i++
				continue
			}
			parts.push(rdn)
			rdn = []
			i++
		}
		return new DN(parts)
	}

	// escapeDN escapes a value for a DN (RFC 4514 §2.4): `,+"\<>;` and `=`,
	// a leading `#` or space and a trailing space.
	def escapeDN(value string) string {
		let raw = value.bytes()
		let out byte[] = []
		for let i = 0; i < raw.len(); i++ {
			let c = raw[i]
			let special = c == byte(44) || c == byte(43) || c == byte(34) || c == byte(92) || c == byte(60) || c == byte(62) || c == byte(59) || c == byte(61)
			let edge = (i == 0 && (c == byte(35) || c == byte(32))) || (i == raw.len() - 1 && c == byte(32))
			if c == byte(0) {
				out = out + "\\00".bytes()
				continue
			}
			out.push(byte(92)) when special || edge
			out.push(c)
		}
		return string(out)
	}

	internal def rdnText(rdn NamePart[]) string {
		let pairs string[] = []
		for let p in rdn {
			pairs.push(p.attribute + "=" + escapeDN(p.value))
		}
		return pairs.join("+")
	}

	internal def rdnKey(rdn NamePart[]) string {
		let pairs string[] = []
		for let p in rdn {
			pairs.push(p.attribute.lower() + "=" + p.value.trim().lower())
		}
		pairs.sort((a, b string) => a < b)
		return pairs.join("+")
	}

	internal def isHexDigit(c byte) bool {
		return (c >= byte(48) && c <= byte(57)) || (c >= byte(97) && c <= byte(102)) || (c >= byte(65) && c <= byte(70))
	}

	internal def hexDigit(c byte) int {
		return int(c) - 48 when c <= byte(57)
		return int(c) - 87 when c >= byte(97)
		return int(c) - 55
	}

	internal def hexValue(text string) !byte[] {
		let raw = text.bytes()
		fail "odd hex" when raw.len() % 2 != 0
		let out byte[] = []
		for let i = 0; i < raw.len(); i += 2 {
			fail "not hex" unless isHexDigit(raw[i]) && isHexDigit(raw[i + 1])
			out.push(byte(hexDigit(raw[i]) * 16 + hexDigit(raw[i + 1])))
		}
		return out
	}
}
