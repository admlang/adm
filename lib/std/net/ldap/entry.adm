partial module std.net.ldap {
	// Entry is one directory entry: its distinguished name and its
	// attributes. Attribute names are matched without regard to case;
	// values are kept as the bytes they are, so binary attributes
	// (`jpegPhoto`, `userCertificate`) survive, and read as text by the
	// string accessors.
	//
	// ```
	// let e = new ldap.Entry("uid=alice,ou=people,dc=example,dc=com")
	// e.set("objectClass", ["inetOrgPerson"])
	// e.set("cn", "Alice")
	// print(e.get("CN"))            // Alice
	// ```
	type Entry {
		dn              string
		internal names  map<string, string>
		internal values map<string, byte[][]>

		def new(dn string) {
			self.dn = dn
		}

		// The first value of an attribute as text; "" when it has none.
		def get(name string) string {
			let found = values.get(name.lower())
			return "" when found is none || found.len() == 0
			return string(found[0])
		}

		// Every value of an attribute as text.
		def getAll(name string) string[] {
			let found = values.get(name.lower())
			return [] when found is none
			let out string[] = []
			for let v in found {
				out.push(string(v))
			}
			return out
		}

		// The first value of an attribute as bytes; empty when it has none.
		def getBytes(name string) byte[] {
			let found = values.get(name.lower())
			return [] when found is none || found.len() == 0
			return found[0]
		}

		// Every value of an attribute as bytes.
		def getAllBytes(name string) byte[][] {
			let found = values.get(name.lower())
			return found is none ?? ([], found)
		}

		// Whether the entry has the attribute.
		def has(name string) bool {
			return values.hasKey(name.lower())
		}

		// Whether the attribute holds `value`, compared without case.
		def hasValue(name string, value string) bool {
			let wanted = value.lower()
			for let v in getAll(name) {
				return true when v.lower() == wanted
			}
			return false
		}

		// Replaces an attribute's values; no values removes it.
		def set(name string, texts string[]) {
			let raw byte[][] = []
			for let t in texts {
				raw.push(t.bytes())
			}
			setBytes(name, raw)
		}

		// Replaces an attribute with one text value.
		def set(name string, text string) {
			setBytes(name, [text.bytes()])
		}

		// Replaces an attribute with one binary value.
		def set(name string, value byte[]) {
			setBytes(name, [value])
		}

		// Replaces an attribute's values with bytes; no values removes it.
		def setBytes(name string, raw byte[][]) {
			let key = name.lower()
			if raw.len() == 0 {
				values.delete(key)
				names.delete(key)
				return
			}
			names[key] = name
			values[key] = raw
		}

		// Adds a text value to an attribute.
		def add(name string, text string) {
			add(name, text.bytes())
		}

		// Adds a binary value to an attribute.
		def add(name string, value byte[]) {
			let key = name.lower()
			let found = values.get(key)
			let list byte[][] = found is none ?? ([], found)
			list.push(value)
			names[key] = name unless names.hasKey(key)
			values[key] = list
		}

		// Removes an attribute.
		def remove(name string) {
			setBytes(name, [])
		}

		// The attribute names, as first written, sorted without case.
		def attributeNames() string[] {
			let keys = names.keys()
			keys.sort((a, b string) => a < b)
			let out string[] = []
			for let k in keys {
				let n = names.get(k)
				out.push(n is none ?? (k, n))
			}
			return out
		}

		// A copy with its own attribute lists.
		def clone() Entry {
			let out = new Entry(dn)
			for let (key, list) in values {
				let n = names.get(key)
				out.setBytes(n is none ?? (key, n), list.clone())
			}
			return out
		}

		// The entry as an LDIF record (RFC 2849).
		def ldif() string {
			return entryLdif(self)
		}

		// Names the entry.
		def str() string {
			return "ldap.Entry({dn})"
		}
	}
}
