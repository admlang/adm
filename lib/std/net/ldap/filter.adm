partial module std.net.ldap {
	// FilterKind is the operator of a `Filter`.
	enum FilterKind {
		And = "and",
		Or = "or",
		Not = "not",
		Equal = "equal",
		Substring = "substring",
		GreaterOrEqual = "greaterOrEqual",
		LessOrEqual = "lessOrEqual",
		Present = "present",
		Approx = "approx",
		Extensible = "extensible",
	}

	// Filter is a search filter (RFC 4511 §4.5.1), usually read from its
	// text form (RFC 4515) with `parseFilter`.
	//
	// ```
	// let f = try ldap.parseFilter("(&(objectClass=person)(|(uid=al*)(mail=*@example.com)))")
	// print(f.str())
	// ```
	type Filter {
		kind         FilterKind
		// And, Or, Not: the filters combined.
		children     Filter[]   = []
		attribute    string     = ""
		value        string     = ""
		// Substring: the pieces around the stars; `initial` and `final`
		// are "" when the pattern starts or ends with a star.
		initial      string     = ""
		any          string[]   = []
		final        string     = ""
		// Extensible: the matching rule and whether DN parts count.
		matchingRule string     = ""
		dnAttributes bool       = false

		def new(kind FilterKind) {
			self.kind = kind
		}

		// The filter in RFC 4515 text form, values escaped.
		def str() string {
			switch {
				case kind == FilterKind.And || kind == FilterKind.Or:
					let op = kind == FilterKind.And ?? ("&", "|")
					let inner = ""
					for let c in children {
						inner += c.str()
					}
					return "(" + op + inner + ")"
				case kind == FilterKind.Not:
					return "(!" + children[0].str() + ")"
				case kind == FilterKind.Present:
					return "(" + attribute + "=*)"
				case kind == FilterKind.Substring:
					let middle = ""
					for let a in any {
						middle += escapeFilter(a) + "*"
					}
					return "(" + attribute + "=" + escapeFilter(initial) + "*" + middle + escapeFilter(final) + ")"
				case kind == FilterKind.GreaterOrEqual:
					return "(" + attribute + ">=" + escapeFilter(value) + ")"
				case kind == FilterKind.LessOrEqual:
					return "(" + attribute + "<=" + escapeFilter(value) + ")"
				case kind == FilterKind.Approx:
					return "(" + attribute + "~=" + escapeFilter(value) + ")"
				case kind == FilterKind.Extensible:
					let head = attribute
					head += ":dn" when dnAttributes
					head += ":" + matchingRule when matchingRule != ""
					return "(" + head + ":=" + escapeFilter(value) + ")"
			}
			return "(" + attribute + "=" + escapeFilter(value) + ")"
		}

		// Whether an entry matches: values compared without case (the
		// caseIgnoreMatch most attributes use), numbers as numbers for
		// ordering when both sides are numeric, `dn` naming the entry's
		// own name. Approximate matches compare without case and spaces.
		def matches(entry Entry) bool {
			switch {
				case kind == FilterKind.And:
					for let c in children {
						return false unless c.matches(entry)
					}
					return true
				case kind == FilterKind.Or:
					for let c in children {
						return true when c.matches(entry)
					}
					return false
				case kind == FilterKind.Not:
					return !children[0].matches(entry)
				case kind == FilterKind.Present:
					return attribute.lower() == "objectclass" || entry.has(attribute)
			}
			let values = valuesOf(entry)
			for let v in values {
				return true when matchesValue(v)
			}
			return false
		}

		internal def valuesOf(entry Entry) string[] {
			return [entry.dn] when attribute.lower() := "dn" || "entrydn"
			let found = entry.getAll(attribute)
			if kind == FilterKind.Extensible && dnAttributes {
				let name = parseDN(entry.dn) onerror recover new DN()
				for let rdn in name.parts {
					for let p in rdn {
						found.push(p.value) when attribute == "" || p.attribute.lower() == attribute.lower()
					}
				}
			}
			return found
		}

		internal def matchesValue(v string) bool {
			let have = v.lower()
			let want = value.lower()
			switch {
				case kind == FilterKind.Equal || kind == FilterKind.Extensible:
					return have == want
				case kind == FilterKind.Approx:
					return have.replace(" ", "") == want.replace(" ", "")
				case kind == FilterKind.GreaterOrEqual:
					return compareValues(have, want) >= 0
				case kind == FilterKind.LessOrEqual:
					return compareValues(have, want) <= 0
				case kind == FilterKind.Substring:
					let rest = have
					if initial != "" {
						return false unless rest.startsWith(initial.lower())
						rest = rest[initial.lower().len():]
					}
					for let a in any {
						let at = rest.indexOf(a.lower())
						return false when at < 0
						rest = rest[at + a.lower().len():]
					}
					return final == "" || rest.endsWith(final.lower())
			}
			return false
		}
	}

	// Orders two values: as numbers when both are, else as text.
	internal def compareValues(a string, b string) int {
		if isInteger(a) && isInteger(b) {
			let x = a.toInt<int64>()
			let y = b.toInt<int64>()
			return x < y ?? (-1, x > y ?? (1, 0))
		}
		return a < b ?? (-1, a > b ?? (1, 0))
	}

	internal def isInteger(text string) bool {
		return false when text == ""
		let body = text.startsWith("-") ?? (text[1:], text)
		return body != "" && body.isNumeric()
	}

	// parseFilter reads a filter in RFC 4515 text form; a bare
	// `attr=value` without parentheses is taken too. Fails on a malformed
	// filter.
	def parseFilter(text string) !Filter {
		let trimmed = text.trim()
		let source = trimmed.startsWith("(") ?? (trimmed, "(" + trimmed + ")")
		let raw = source.bytes()
		let (f, next) = try readFilter(raw, 0)
		fail failure(ResultCode.ProtocolError, "trailing text after the filter in {text}") when next != raw.len()
		return f
	}

	internal def readFilter(raw byte[], start int) !(Filter, int) {
		fail failure(ResultCode.ProtocolError, "filter must start with '('") when start >= raw.len() || raw[start] != byte(40)
		let i = start + 1
		fail failure(ResultCode.ProtocolError, "truncated filter") when i >= raw.len()
		let op = raw[i]
		if op == byte(38) || op == byte(124) || op == byte(33) {
			let f = new Filter(op == byte(38) ?? (FilterKind.And, op == byte(124) ?? (FilterKind.Or, FilterKind.Not)))
			i++
			for i < raw.len() && raw[i] == byte(40) {
				let (child, next) = try readFilter(raw, i)
				f.children.push(child)
				i = next
			}
			fail failure(ResultCode.ProtocolError, "unclosed filter") when i >= raw.len() || raw[i] != byte(41)
			fail failure(ResultCode.ProtocolError, "'!' takes one filter") when f.kind == FilterKind.Not && f.children.len() != 1
			return (f, i + 1)
		}
		// An item: find the closing parenthesis (escapes cannot hide one).
		let end = i
		for end < raw.len() && raw[end] != byte(41) {
			end++
		}
		fail failure(ResultCode.ProtocolError, "unclosed filter") when end >= raw.len()
		let item = raw[i:end]
		return (try readItem(item), end + 1)
	}

	internal def readItem(item byte[]) !Filter {
		let eq = -1
		for let i = 0; i < item.len(); i++ {
			if item[i] == byte(61) {
				eq = i
				break
			}
		}
		fail failure(ResultCode.ProtocolError, "no '=' in filter item {string(item)}") when eq <= 0
		let before = item[eq - 1]
		let rawValue = item[eq + 1:]
		if before == byte(58) {
			// attr:dn:rule:=value
			let f = new Filter(FilterKind.Extensible)
			let head = string(item[:eq - 1]).split(":")
			f.attribute = head[0]
			for let part in head[1:] {
				if part.lower() == "dn" {
					f.dnAttributes = true
				} else if part != "" {
					f.matchingRule = part
				}
			}
			f.value = try unescapeFilter(rawValue)
			return f
		}
		let kind = FilterKind.Equal
		let nameEnd = eq
		if before == byte(62) || before == byte(60) || before == byte(126) {
			kind = before == byte(62) ?? (FilterKind.GreaterOrEqual, before == byte(60) ?? (FilterKind.LessOrEqual, FilterKind.Approx))
			nameEnd = eq - 1
		}
		let attribute = string(item[:nameEnd]).trim()
		fail failure(ResultCode.ProtocolError, "empty attribute in filter") when attribute == ""
		let f = new Filter(kind)
		f.attribute = attribute
		if kind == FilterKind.Equal && rawValue.includes(byte(42)) {
			if rawValue.len() == 1 {
				f.kind = FilterKind.Present
				return f
			}
			f.kind = FilterKind.Substring
			let pieces byte[][] = []
			let current byte[] = []
			for let b in rawValue {
				if b == byte(42) {
					pieces.push(current)
					current = []
				} else {
					current.push(b)
				}
			}
			pieces.push(current)
			f.initial = try unescapeFilter(pieces[0])
			f.final = try unescapeFilter(pieces[pieces.len() - 1])
			for let p in pieces[1:pieces.len() - 1] {
				f.any.push(try unescapeFilter(p)) when p.len() > 0
			}
			return f
		}
		f.value = try unescapeFilter(rawValue)
		return f
	}

	internal def unescapeFilter(raw byte[]) !string {
		let out byte[] = []
		let i = 0
		for i < raw.len() {
			if raw[i] == byte(92) {
				fail failure(ResultCode.ProtocolError, "bad escape in filter") unless i + 2 < raw.len() + 0 && isHexDigit(raw[i + 1]) && isHexDigit(raw[i + 2])
				out.push(byte(hexDigit(raw[i + 1]) * 16 + hexDigit(raw[i + 2])))
				i += 3
				continue
			}
			out.push(raw[i])
			i++
		}
		return string(out)
	}

	// escapeFilter escapes a value for a filter (RFC 4515 §3): `*`, `(`,
	// `)`, `\` and NUL become `\2a`, `\28`, `\29`, `\5c`, `\00`, so user
	// input cannot change a filter's meaning.
	def escapeFilter(value string) string {
		let out = ""
		for let b in value.bytes() {
			switch {
				case b == byte(42):
					out += "\\2a"
				case b == byte(40):
					out += "\\28"
				case b == byte(41):
					out += "\\29"
				case b == byte(92):
					out += "\\5c"
				case b == byte(0):
					out += "\\00"
				default:
					out += string([b])
			}
		}
		return out
	}
}
