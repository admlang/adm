partial module std.net.ldap {
	use std.errors

	// ResultCode is an LDAP result code (RFC 4511 §4.1.9).
	enum ResultCode {
		Success = 0,
		OperationsError = 1,
		ProtocolError = 2,
		TimeLimitExceeded = 3,
		SizeLimitExceeded = 4,
		CompareFalse = 5,
		CompareTrue = 6,
		AuthMethodNotSupported = 7,
		StrongerAuthRequired = 8,
		Referral = 10,
		AdminLimitExceeded = 11,
		UnavailableCriticalExtension = 12,
		ConfidentialityRequired = 13,
		SaslBindInProgress = 14,
		NoSuchAttribute = 16,
		UndefinedAttributeType = 17,
		InappropriateMatching = 18,
		ConstraintViolation = 19,
		AttributeOrValueExists = 20,
		InvalidAttributeSyntax = 21,
		NoSuchObject = 32,
		AliasProblem = 33,
		InvalidDNSyntax = 34,
		AliasDereferencingProblem = 36,
		InappropriateAuthentication = 48,
		InvalidCredentials = 49,
		InsufficientAccessRights = 50,
		Busy = 51,
		Unavailable = 52,
		UnwillingToPerform = 53,
		LoopDetect = 54,
		NamingViolation = 64,
		ObjectClassViolation = 65,
		NotAllowedOnNonLeaf = 66,
		NotAllowedOnRDN = 67,
		EntryAlreadyExists = 68,
		ObjectClassModsProhibited = 69,
		AffectsMultipleDSAs = 71,
		Other = 80,
	}

	// LdapError is the payload of a failure the server reported, or of a
	// reply that does not parse. `code` is the result's name
	// (`NoSuchObject`, `InvalidCredentials`, ...; `protocol` when the
	// reply was malformed).
	struct LdapError {
		message   string
		code      string
		cause     ?error
		stack     errors.StackTrace
		// The result code; 0 when the failure is not a server result.
		result    int
		// The deepest entry the server found on the way to the one named.
		matchedDN string
		// Where to go instead, for a `Referral` result.
		referrals string[]
	}

	// failure builds the error a `Directory` fails with to answer a
	// request with `code`.
	def failure(code ResultCode, text string = "") error {
		return LdapError{message: "ldap: " + (text == "" ?? (code.name, text)), code: code.name, result: code.value}
	}

	// Scope is how far below the base a search looks.
	enum Scope {
		// The base entry alone.
		Base = 0,
		// The entries right below the base.
		One = 1,
		// The base and everything below it.
		Subtree = 2,
		// Everything below the base, not the base itself.
		Children = 3,
	}

	// Deref is when a search follows alias entries.
	enum Deref {
		Never = 0,
		InSearching = 1,
		FindingBase = 2,
		Always = 3,
	}

	// Security picks how a connection is protected.
	enum Security {
		// No TLS; binds and entries cross the network in the clear.
		Plain = "plain",
		// StartTLS (RFC 4513 §3): the connection starts plain and upgrades
		// before the bind.
		StartTls = "starttls",
		// ldaps: TLS from the first byte, on port 636.
		Implicit = "implicit",
	}

	// ChangeKind is what a `Change` does to an attribute.
	enum ChangeKind {
		// Adds values (the attribute is created when missing).
		Add = 0,
		// Deletes the values given, or the whole attribute without values.
		Delete = 1,
		// Replaces every value (no values removes the attribute).
		Replace = 2,
		// Adds a number to an integer attribute (RFC 4525).
		Increment = 3,
	}

	// Change is one part of a `Client.modify`.
	struct Change {
		kind      ChangeKind
		attribute string
		values    string[]   = []
	}

	// SearchOptions are the less common parameters of a search.
	struct SearchOptions {
		scope      Scope    = Scope.Subtree
		// Attributes to return; empty returns every user attribute, `+`
		// the operational ones too, `1.1` none.
		attributes string[] = []
		// Entries the server may return; 0 is no limit beyond its own.
		sizeLimit  int      = 0
		// Seconds the server may spend; 0 is no limit beyond its own.
		timeLimit  int      = 0
		// Return attribute names without values.
		typesOnly  bool     = false
		deref      Deref    = Deref.Never
		// Entries per page with the paged results control (RFC 2696); the
		// client asks for every page. 0 asks for everything at once.
		pageSize   int      = 500
	}
}
