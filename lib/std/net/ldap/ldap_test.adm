partial module std.net.ldap {
	use (
		std.crypto.x509::(CertPool)
		std.data.encoding
		std.net.sasl
		std.net.tls
		std.testing
	)

	// A self-signed P-256 certificate for localhost and 127.0.0.1, and its
	// key, for the TLS tests.
	internal const ldapCertPEM = """
-----BEGIN CERTIFICATE-----
MIIBmzCCAUGgAwIBAgIUe0Hu9BHcV0SY1ysnR2r8y7nRo6IwCgYIKoZIzj0EAwIw
FDESMBAGA1UEAwwJbG9jYWxob3N0MCAXDTI2MDkyOTA2MzIxMFoYDzIxMjYwOTA1
MDYzMjEwWjAUMRIwEAYDVQQDDAlsb2NhbGhvc3QwWTATBgcqhkjOPQIBBggqhkjO
PQMBBwNCAATMaPIJ1maIe4YcW4vVrMahPtNjv9ehEBsaQtpz/8TpzgzVAXsKEnn7
RB+B1qJ9KsAQ3U1D1KLFALY7fecbRLBKo28wbTAdBgNVHQ4EFgQUlZfQWDBog/nM
FEGaYkdonTD9OoEwHwYDVR0jBBgwFoAUlZfQWDBog/nMFEGaYkdonTD9OoEwDwYD
VR0TAQH/BAUwAwEB/zAaBgNVHREEEzARgglsb2NhbGhvc3SHBH8AAAEwCgYIKoZI
zj0EAwIDSAAwRQIgY2aJ7/0r3cORZgPvZoMk53i0Y+GMdYgI5cLcmk8DSikCIQDX
VJNWwFd/S9HPKY6HNADow2uU/jrgBpREoaVzgQIiPg==
-----END CERTIFICATE-----
"""

	internal const ldapKeyPEM = """
-----BEGIN PRIVATE KEY-----
MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQg9LUp59BDD3rXcite
pHMhJZxZJrZwv5vI6APOig4suhGhRANCAATMaPIJ1maIe4YcW4vVrMahPtNjv9eh
EBsaQtpz/8TpzgzVAXsKEnn7RB+B1qJ9KsAQ3U1D1KLFALY7fecbRLBK
-----END PRIVATE KEY-----
"""

	internal const seedLdif = """
version: 1

dn: dc=example,dc=com
objectClass: domain
dc: example

dn: ou=people,dc=example,dc=com
objectClass: organizationalUnit
ou: people

dn: uid=alice,ou=people,dc=example,dc=com
objectClass: inetOrgPerson
uid: alice
cn: Alice Liddell
sn: Liddell
mail: alice@example.com
employeeNumber: 7
userPassword: wonder

dn: uid=bob,ou=people,dc=example,dc=com
objectClass: inetOrgPerson
uid: bob
cn: Bob Builder
sn: Builder
mail: bob@example.org
employeeNumber: 12
userPassword: placeholder

dn: cn=admin,dc=example,dc=com
objectClass: person
cn: admin
sn: admin
userPassword: s3cret
"""

	// A server over a MemoryDirectory seeded with a few people, and a
	// client connected to it.
	internal def ldapPair() !(Server, Client, MemoryDirectory) {
		let dir = new MemoryDirectory("dc=example,dc=com")
		try dir.load(seedLdif)
		dir.admins.push("cn=admin,dc=example,dc=com")
		let bob = dir.entry("uid=bob,ou=people,dc=example,dc=com")
		if !(bob is none) {
			bob.set("userPassword", try hashPassword("builder"))
			try dir.put(bob)
		}
		let server = new Server(dir, "127.0.0.1:0")
		try server.start()
		let client = new Client(timeout = 10s)
		try client.connect(server.address().str())
		return (server, client, dir)
	}

	check "Names, filters and LDIF" {
		@test()
		def parsesAndPrintsNames() !none {
			let dn = try parseDN("UID=Alice , OU=People,dc=example,dc=com")
			assert dn.parts.len() == 4
			assert dn.rdn() == "UID=Alice"
			assert dn.parent().str() == "OU=People,dc=example,dc=com"
			assert dn.equals(try parseDN("uid=alice,ou=people,dc=EXAMPLE,dc=com"))
			assert dn.within(try parseDN("dc=example,dc=com"))
			assert dn.depthBelow(try parseDN("dc=example,dc=com")) == 2
			let tricky = try parseDN("cn=Smith\\, John+uid=js,dc=x")
			assert tricky.parts[0].len() == 2
			assert tricky.rdnValue() == "Smith, John"
			assert escapeDN(" #a,b ") == "\\ #a\\,b\\ "
			assert escapeDN("#x") == "\\#x"
			let hex = try parseDN("cn=#414243,dc=x")
			assert hex.rdnValue() == "ABC"
			return none
		}

		@test()
		def parsesPrintsAndMatchesFilters() !none {
			let f = try parseFilter("(&(objectClass=person)(|(uid=al*ce)(mail=*@example.org))(!(employeeNumber>=10)))")
			assert f.kind == FilterKind.And
			assert f.children.len() == 3
			assert f.str() == "(&(objectClass=person)(|(uid=al*ce)(mail=*@example.org))(!(employeeNumber>=10)))"
			let alice = new Entry("uid=alice,dc=x")
			alice.set("objectClass", "person")
			alice.set("uid", "alice")
			alice.set("employeeNumber", "7")
			assert f.matches(alice)
			alice.set("employeeNumber", "12")
			assert !f.matches(alice)
			assert (try parseFilter("uid=*")).kind == FilterKind.Present
			assert (try parseFilter("(cn=a\\2ab)")).value == "a*b"
			assert escapeFilter("a*(b)\\") == "a\\2a\\28b\\29\\5c"
			let ext = try parseFilter("(ou:dn:caseIgnoreMatch:=People)")
			assert ext.kind == FilterKind.Extensible && ext.dnAttributes
			let refused = false
			parseFilter("(&(uid=a)") onerror (err error) {
				refused = true
				recover new Filter(FilterKind.Present)
			}
			assert refused
			return none
		}

		@test()
		def readsAndWritesLdif() !none {
			let entries = try parseLDIF(seedLdif)
			assert entries.len() == 5
			assert entries[2].get("cn") == "Alice Liddell"
			let odd = new Entry("cn=odd,dc=x")
			odd.set("description", " starts with a space")
			odd.set("jpegPhoto", byte[0, 255, 10])
			odd.set("note", "x".repeat(100))
			let text = odd.ldif()
			assert text.contains("description:: ")
			let back = try parseLDIF(text)
			assert back[0].get("description") == " starts with a space"
			assert back[0].getBytes("jpegPhoto").equals(byte[0, 255, 10])
			assert back[0].get("note").len() == 100
			return none
		}

		@test()
		def readsLenientBer() !none {
			// OpenLDAP writes lengths in four bytes: 0x84 0 0 0 n.
			let raw = byte[0x30, 0x84, 0, 0, 0, 3, 0x02, 0x01, 0x05]
			let (e, used) = try encoding.berParse(raw)
			assert used == 9
			assert (try (try e.at(0)).asInt()) == 5
			let indefinite = byte[0x30, 0x80, 0x01, 0x01, 0x01, 0, 0]
			let (seq, n) = try encoding.berParse(indefinite)
			assert n == 7
			assert try (try seq.at(0)).asBool()
			return none
		}

		@test()
		def hashesPasswords() !none {
			for let scheme in ["SSHA", "SSHA256", "SSHA512", "CRYPT"] {
				let stored = try hashPassword("pw", scheme)
				assert passwordMatches(stored, "pw")
				assert !passwordMatches(stored, "px")
			}
			assert passwordMatches("plain", "plain")
			return none
		}
	}

	check "Client and Server" {
		@test()
		def searches() !none {
			let (server, client, _) = try ldapPair()
			let people = try client.search("ou=people,dc=example,dc=com", "(objectClass=inetOrgPerson)")
			assert people.len() == 2
			let one = try client.search("dc=example,dc=com", "(objectClass=*)", SearchOptions{scope: Scope.One})
			assert one.len() == 2
			let alice = try client.get("uid=alice,ou=people,dc=example,dc=com", ["cn", "mail"])
			assert alice.get("cn") == "Alice Liddell"
			assert !alice.has("sn")
			assert !alice.has("userPassword")
			let found = try client.find("dc=example,dc=com", "(mail=*@example.org)")
			assert !(found is none) && found.get("uid") == "bob"
			assert !(try client.exists("uid=nobody,dc=example,dc=com"))
			let code = ""
			client.search("ou=nowhere,dc=example,dc=com", "(uid=*)") onerror (err error) {
				code = err.code
				recover Entry[]
			}
			assert code == "NoSuchObject"
			let root = try client.rootDSE()
			assert root.getAll("namingContexts").includes("dc=example,dc=com")
			try client.close()
			try server.close()
			return none
		}

		@test()
		def pagesThroughLargeResults() !none {
			let (server, client, dir) = try ldapPair()
			for let i = 0; i < 25; i++ {
				let e = new Entry("uid=user{i},ou=people,dc=example,dc=com")
				e.set("objectClass", "inetOrgPerson")
				e.set("uid", "user{i}")
				try dir.put(e)
			}
			let options = SearchOptions{pageSize: 4}
			let all = try client.search("ou=people,dc=example,dc=com", "(uid=user*)", options)
			assert all.len() == 25
			let code = ""
			client.search("ou=people,dc=example,dc=com", "(uid=user*)", SearchOptions{pageSize: 0, sizeLimit: 10}) onerror (err error) {
				code = err.code
				recover Entry[]
			}
			assert code == "SizeLimitExceeded"
			try client.close()
			try server.close()
			return none
		}

		@test()
		def bindsWithScram() !none {
			let (server, client, dir) = try ldapPair()
			// Stored SCRAM credentials for alice, plain text for the admin.
			let alice = dir.entry("uid=alice,ou=people,dc=example,dc=com")
			fail "no alice" when alice is none
			alice.set("authPassword", [(try sasl.scramCredentials("wonder", sasl.ScramMechanism.Sha512)).str()])
			alice.remove("userPassword")
			try dir.put(alice)
			let dse = try client.rootDSE()
			assert dse.getAll("supportedSASLMechanisms").includes("SCRAM-SHA-256")
			assert !dse.getAll("supportedSASLMechanisms").includes("SCRAM-SHA-256-PLUS")
			try client.bindScram("alice", "wonder", sasl.ScramMechanism.Sha512)
			assert (try client.whoAmI()) == "dn:uid=alice,ou=people,dc=example,dc=com"
			try client.bindScram("dn:cn=admin,dc=example,dc=com", "s3cret", sasl.ScramMechanism.Sha1)
			assert (try client.whoAmI()) == "dn:cn=admin,dc=example,dc=com"
			let wrong = ""
			client.bindScram("admin", "nope") onerror (err error) {
				wrong = err.code
				recover none
			}
			assert wrong == "InvalidCredentials"
			// alice has SHA-512 credentials only, and no plain password.
			let missing = ""
			client.bindScram("alice", "wonder") onerror (err error) {
				missing = err.code
				recover none
			}
			assert missing == "InvalidCredentials"
			try client.close()
			try server.close()
			return none
		}

		@test()
		def bindsScramToTheTlsChannel() !none {
			let dir = new MemoryDirectory("dc=example,dc=com")
			try dir.load(seedLdif)
			let server = new Server(dir, "127.0.0.1:0")
			server.security = Security.StartTls
			server.tls = tls.Config{certificates: [try tls.parseKeyPair(ldapCertPEM, ldapKeyPEM)]}
			try server.start()
			let pool = new CertPool()
			pool.appendCertsFromPEM(ldapCertPEM)
			for let kind in ["tls-exporter", "tls-server-end-point"] {
				let client = new Client(Security.StartTls, 10s)
				client.tls = tls.Config{serverName: "localhost", rootCAs: pool}
				client.channelBinding = kind
				try client.connect(server.address().str())
				assert (try client.rootDSE()).getAll("supportedSASLMechanisms").includes("SCRAM-SHA-256-PLUS")
				try client.bindScram("alice", "wonder")
				assert (try client.whoAmI()) == "dn:uid=alice,ou=people,dc=example,dc=com"
				try client.close()
			}
			// A client that binds no channel still gets in over TLS (),
			// with or without being able to.
			let plain = new Client(Security.StartTls, 10s)
			plain.tls = tls.Config{serverName: "localhost", rootCAs: pool}
			plain.channelBinding = ""
			try plain.connect(server.address().str())
			try plain.bindScram("bob", "placeholder")
			try plain.close()
			try server.close()
			return none
		}

		@test()
		def followsReferrals() !none {
			// B holds ou=remote, which A only refers to; C holds o=other,
			// A's default referral.
			let remote = new MemoryDirectory("ou=remote,dc=example,dc=com")
			try remote.load("dn: ou=remote,dc=example,dc=com\nobjectClass: organizationalUnit\nou: remote\n\ndn: uid=zed,ou=remote,dc=example,dc=com\nobjectClass: inetOrgPerson\nuid: zed\ncn: Zed\nsn: Z\n\ndn: cn=admin,ou=remote,dc=example,dc=com\nobjectClass: person\ncn: admin\nsn: admin\nuserPassword: remote\n")
			remote.admins.push("cn=admin,ou=remote,dc=example,dc=com")
			let b = new Server(remote, "127.0.0.1:0")
			try b.start()
			let other = new MemoryDirectory("o=other")
			try other.load("dn: o=other\nobjectClass: organization\no: other\n")
			let c = new Server(other, "127.0.0.1:0")
			try c.start()
			let (a, first, local) = try ldapPair()
			a.referrals = ["ldap://{c.address().str()}"]
			// A connection keeps the server's settings from when it was
			// accepted: connect after setting the default referral.
			try first.close()
			let client = new Client(timeout = 10s)
			try client.connect(a.address().str())
			let refer = new Entry("ou=remote,dc=example,dc=com")
			refer.set("objectClass", ["referral", "extensibleObject"])
			refer.set("ou", "remote")
			refer.set("ref", "ldap://{b.address().str()}/ou=remote,dc=example,dc=com")
			try local.put(refer)
			// A search over A reads B's part of the tree too.
			let everyone = try client.search("dc=example,dc=com", "(objectClass=*)")
			let names string[] = []
			for let e in everyone {
				names.push(e.dn)
			}
			fail "found {names.join("; ")}" unless names.includes("uid=zed,ou=remote,dc=example,dc=com") && names.includes("uid=alice,ou=people,dc=example,dc=com")
			// ou=remote once: B's entry, not A's referral object.
			let remotes = everyone.filter(e => e.dn == "ou=remote,dc=example,dc=com")
			fail "ou=remote {remotes.len()} times" unless remotes.len() == 1 && remotes[0].get("ref") == ""
			// The reference comes back whatever the filter.
			assert (try client.search("dc=example,dc=com", "(uid=zed)")).len() == 1
			// Base searches and writes below the referral object go to B.
			assert (try client.get("uid=zed,ou=remote,dc=example,dc=com")).get("cn") == "Zed"
			client.referralBind = def (other Client) !none {
				return try other.bind("cn=admin,ou=remote,dc=example,dc=com", "remote")
			}
			try client.add("uid=yan,ou=remote,dc=example,dc=com", {"objectClass": ["inetOrgPerson"], "cn": ["Yan"], "sn": ["Y"]})
			assert !(remote.entry("uid=yan,ou=remote,dc=example,dc=com") is none)
			try client.replace("uid=yan,ou=remote,dc=example,dc=com", "cn", "Yan Y")
			assert try client.compare("uid=yan,ou=remote,dc=example,dc=com", "cn", "Yan Y")
			try client.delete("uid=yan,ou=remote,dc=example,dc=com")
			assert remote.entry("uid=yan,ou=remote,dc=example,dc=com") is none
			// The default referral, for a name outside A's suffix; C is
			// read anonymously.
			client.referralBind = none
			assert (try client.get("o=other")).get("o") == "other"
			// ManageDsaIT shows the referral object itself.
			client.manageDsaIT = true
			assert (try client.get("ou=remote,dc=example,dc=com")).get("ref").startsWith("ldap://")
			client.manageDsaIT = false
			// A referral back to itself runs out of hops.
			let loop = new Entry("ou=loop,dc=example,dc=com")
			loop.set("objectClass", ["referral", "extensibleObject"])
			loop.set("ref", "ldap://{a.address().str()}/ou=loop,dc=example,dc=com")
			try local.put(loop)
			let looped = ""
			client.get("ou=loop,dc=example,dc=com") onerror (err error) {
				looped = err.code
				recover new Entry("")
			}
			assert looped == "LoopDetect"
			// Without following, the referral comes back as an error.
			client.followReferrals = false
			let urls string[] = []
			client.get("uid=zed,ou=remote,dc=example,dc=com") onerror (err error) {
				urls = referralsOf(err)
				recover new Entry("")
			}
			assert urls.len() == 1 && urls[0].endsWith("/uid=zed,ou=remote,dc=example,dc=com")
			assert (try client.search("dc=example,dc=com", "(uid=zed)")).len() == 0
			let url = try parseURL("ldaps://h.example/ou=a%20b,dc=x?cn,mail?one?(cn=*)")
			assert url.scheme == "ldaps" && url.host == "h.example:636" && url.dn == "ou=a b,dc=x" && url.attributes.len() == 2 && url.filter == "(cn=*)"
			let scope = url.scope
			assert !(scope is none) && scope == Scope.One
			try client.close()
			try a.close()
			try b.close()
			try c.close()
			return none
		}

		@test()
		def bindsAndChanges() !none {
			let (server, client, _) = try ldapPair()
			let refused = ""
			client.add(new Entry("uid=carol,ou=people,dc=example,dc=com")) onerror (err error) {
				refused = err.code
				recover none
			}
			assert refused == "InsufficientAccessRights"
			let wrong = ""
			client.bind("cn=admin,dc=example,dc=com", "nope") onerror (err error) {
				wrong = err.code
				recover none
			}
			assert wrong == "InvalidCredentials"
			try client.bind("cn=admin,dc=example,dc=com", "s3cret")
			assert (try client.whoAmI()) == "dn:cn=admin,dc=example,dc=com"
			try client.add("uid=carol,ou=people,dc=example,dc=com", {"objectClass": ["inetOrgPerson"], "cn": ["Carol"], "sn": ["C"]})
			assert (try client.get("uid=carol,ou=people,dc=example,dc=com")).get("uid") == "carol"
			try client.modify("uid=carol,ou=people,dc=example,dc=com", [
				Change{kind: ChangeKind.Add, attribute: "mail", values: ["c@example.com", "carol@example.com"]},
				Change{kind: ChangeKind.Replace, attribute: "cn", values: ["Carol C"]},
			])
			let carol = try client.get("uid=carol,ou=people,dc=example,dc=com")
			assert carol.getAll("mail").len() == 2
			assert carol.get("cn") == "Carol C"
			try client.replace("uid=alice,ou=people,dc=example,dc=com", "employeeNumber", "8")
			try client.modify("uid=alice,ou=people,dc=example,dc=com", [Change{kind:ChangeKind.Increment, attribute:"employeeNumber", values:["2"]}])
			assert (try client.get("uid=alice,ou=people,dc=example,dc=com")).get("employeeNumber") == "10"
			assert try client.compare("uid=alice,ou=people,dc=example,dc=com", "mail", "ALICE@example.com")
			assert !(try client.compare("uid=alice,ou=people,dc=example,dc=com", "mail", "x@y"))
			try client.rename("uid=carol,ou=people,dc=example,dc=com", "uid=caroline")
			assert try client.exists("uid=caroline,ou=people,dc=example,dc=com")
			try client.add("ou=staff,dc=example,dc=com", {"objectClass": ["organizationalUnit"]})
			try client.rename("uid=caroline,ou=people,dc=example,dc=com", "uid=caroline", "ou=staff,dc=example,dc=com")
			assert try client.exists("uid=caroline,ou=staff,dc=example,dc=com")
			let leaf = ""
			client.delete("ou=staff,dc=example,dc=com") onerror (err error) {
				leaf = err.code
				recover none
			}
			assert leaf == "NotAllowedOnNonLeaf"
			try client.delete("ou=staff,dc=example,dc=com", recursive = true)
			assert !(try client.exists("ou=staff,dc=example,dc=com"))
			try client.close()
			try server.close()
			return none
		}

		@test()
		def passwordsAndSasl() !none {
			let (server, client, _) = try ldapPair()
			try client.bind("uid=bob,ou=people,dc=example,dc=com", "builder")
			let made = try client.changePassword("", "builder", "")
			assert made.len() >= 12
			let again = new Client()
			try again.connect(server.address().str())
			try again.bind("uid=bob,ou=people,dc=example,dc=com", made)
			try again.close()
			let plain = new Client()
			try plain.connect(server.address().str())
			try plain.bindPlain("alice", "wonder")
			assert (try plain.whoAmI()) == "dn:uid=alice,ou=people,dc=example,dc=com"
			try plain.close()
			try client.close()
			try server.close()
			return none
		}
	}
}
