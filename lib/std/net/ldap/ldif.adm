partial module std.net.ldap {
	use (
		std.data.encoding
		std.os
	)

	// parseLDIF reads the entries of an LDIF file (RFC 2849): records
	// separated by blank lines, folded lines, `::` for Base64 values,
	// `:<` for `file://` URLs, comments and the `version:` line. Fails on
	// a malformed record, or on a change record (`changetype:`), which
	// describes an operation, not an entry.
	def parseLDIF(text string) !Entry[] {
		let out Entry[] = []
		let lines = unfoldLDIF(text)
		let current ?Entry = none
		for let line in lines {
			if line == "" {
				if !(current is none) {
					out.push(current)
					current = none
				}
				continue
			}
			continue when line.startsWith("#")
			let (name, value) = try ldifPair(line)
			if current is none {
				continue when name.lower() == "version"
				fail failure(ResultCode.ProtocolError, "an LDIF record must start with dn:, not {name}") unless name.lower() == "dn"
				current = new Entry(string(value))
				continue
			}
			fail failure(ResultCode.ProtocolError, "LDIF change records are not entries") when name.lower() == "changetype"
			let e = current
			e.add(name, value) unless e is none
		}
		out.push(current) unless current is none
		return out
	}

	// ldif writes entries as an LDIF file.
	def ldif(entries Entry[]) string {
		return entriesLdif(entries)
	}

	internal def entriesLdif(entries Entry[]) string {
		let parts = ["version: 1\n"]
		for let e in entries {
			parts.push(entryLdif(e))
		}
		return parts.join("\n")
	}

	// One entry as an LDIF record, lines folded at 76 columns.
	internal def entryLdif(e Entry) string {
		let lines = [ldifLine("dn", e.dn.bytes())]
		for let name in e.attributeNames() {
			for let v in e.getAllBytes(name) {
				lines.push(ldifLine(name, v))
			}
		}
		return lines.join("\n") + "\n"
	}

	internal def ldifLine(name string, value byte[]) string {
		let plain = name + ": " + string(value)
		let line = ldifSafe(value) ?? (plain, name + ":: " + encoding.base64encode(value))
		return line when line.len() <= 76
		let out = line[:76]
		let rest = line[76:]
		for rest.len() > 0 {
			let n = rest.len() < 75 ?? (rest.len(), 75)
			out += "\n " + rest[:n]
			rest = rest[n:]
		}
		return out
	}

	// Whether a value may be written as it is (RFC 2849 SAFE-STRING).
	internal def ldifSafe(value byte[]) bool {
		return true when value.len() == 0
		let first = value[0]
		return false when first == byte(32) || first == byte(58) || first == byte(60)
		return false when value[value.len() - 1] == byte(32)
		for let b in value {
			return false when b == byte(0) || b == byte(10) || b == byte(13) || b >= byte(128)
		}
		return true
	}

	// The lines of an LDIF file with folded lines joined.
	internal def unfoldLDIF(text string) string[] {
		let out string[] = []
		for let raw in text.replace("\r\n", "\n").split("\n") {
			if raw.startsWith(" ") && out.len() > 0 {
				out[out.len() - 1] = out[out.len() - 1] + raw[1:]
				continue
			}
			out.push(raw)
		}
		return out
	}

	// One `name: value` line: `:` text, `::` Base64, `:<` a file URL.
	internal def ldifPair(line string) !(string, byte[]) {
		let colon = line.indexOf(":")
		fail failure(ResultCode.ProtocolError, "LDIF line without ':': {line}") when colon <= 0
		let name = line[:colon]
		let rest = line[colon + 1:]
		if rest.startsWith(":") {
			let decoded = encoding.base64decode(rest[1:].trim()) onerror fail failure(ResultCode.ProtocolError, "bad Base64 for {name}")
			return (name, decoded)
		}
		if rest.startsWith("<") {
			let url = rest[1:].trim()
			fail failure(ResultCode.ProtocolError, "only file:// URLs are read, not {url}") unless url.startsWith("file://")
			return (name, try os.readFile(url["file://".len():]))
		}
		return (name, rest.trimPrefix(" ").bytes())
	}
}
