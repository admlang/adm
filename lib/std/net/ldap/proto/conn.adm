internal partial module std.net.ldap.proto {
	use (
		std.data.encoding
		std.data.encoding::(ASN1Element)
		std.net
		std.net.ldap::(LdapError)
		std.time
	)

	// Conn is the client side of one connection: requests go out with
	// message ids; a reader task files each reply under its id, where
	// the request (or a search's entry stream) takes it.
	type Conn {
		stream         net.Stream
		lines          net.LineReader
		timeout        duration
		atomic nextId  int            = 1
		atomic slots   map<int, Slot>
		atomic failure ?error         = none
		atomic reading bool           = false

		def new(stream net.Stream, timeout duration) {
			self.stream = stream
			self.timeout = timeout
			lines = new net.LineReader(stream, 1)
		}

		// Swaps the stream underneath (after StartTLS); only before the
		// reader task runs.
		def upgrade(secured net.Stream) {
			stream = secured
			lines = new net.LineReader(secured, 1)
		}

		// Sends one request and returns its id. Fails when the connection
		// is gone or the write fails.
		def send(op ASN1Element, controls Control[]) !int {
			let err = failure
			fail err unless err is none
			let id = register()
			let data = envelope(id, op, controls)
			try writeAll(data)
			return id
		}

		// Sends a request that gets no reply (unbind, abandon).
		def sendOnly(op ASN1Element) !none {
			let id = claimId()
			return try writeAll(envelope(id, op, []))
		}

		internal atomic def writeAll(data byte[]) !none {
			let off = 0
			for off < data.len() {
				let n = try stream.write(data[off:], timeout)
				fail protocolFailure("wrote nothing") when n <= 0
				off += n
			}
			return none
		}

		internal atomic def register() int {
			let id = nextId
			nextId++
			slots[id] = new Slot()
			return id
		}

		internal atomic def claimId() int {
			let id = nextId
			nextId++
			return id
		}

		// The next reply to request `id`, waiting up to `timeout`. Fails
		// when the connection breaks or no reply comes in time.
		def next(id int) !Message {
			let slot = slotOf(id)
			fail protocolFailure("no request {id}") when slot is none
			let deadline = time.now() + timeout
			for {
				let m = slot.take()
				return m unless m is none
				let err = failure
				fail err unless err is none
				let left = deadline - time.now()
				fail LdapError{message: "ldap: no reply within {timeout}", code: "timeout"} when left <= 0s
				let sleep = time.sleepChan(left)
				select {
					case slot.signal:
						slot.signal.flush()
					case sleep:
				}
			}
			fail "unreachable"
		}

		// Sends a request and waits for its single reply. Before the
		// reader runs, reads the reply directly.
		def request(op ASN1Element, controls Control[]) !Message {
			let id = try send(op, controls)
			if !reading {
				let m = try readMessage(lines, timeout)
				forget(id)
				fail protocolFailure("reply to {m.id}, expected {id}") when m.id != id
				return m
			}
			let m = try next(id)
			forget(id)
			return m
		}

		internal atomic def slotOf(id int) ?Slot {
			return slots.get(id)
		}

		atomic def forget(id int) {
			slots.delete(id)
		}

		// Starts the reader task.
		def start() {
			reading = true
			let task = async readLoop()
			task.keepAlive()
		}

		internal def readLoop() {
			for {
				let m = readMessage(lines, 87600h) onerror (err error) {
					failure = err
					recover Message{id: -1, op: -1, body: encoding.asn1Null(), controls: []}
				}
				break unless failure is none
				if m.id == 0 {
					// Unsolicited: the server is about to close.
					failure = LdapError{message: "ldap: the server ended the connection", code: "Unavailable", result: 52}
					break
				}
				let slot = slotOf(m.id)
				slot.put(m) unless slot is none
			}
			for let (_, slot) in allSlots() {
				slot.signal <- none when slot.signal.len() == 0
			}
		}

		internal atomic def allSlots() map<int, Slot> {
			return slots
		}

		// Closes the stream. Never fails.
		def close() {
			failure = LdapError{message: "ldap: connection closed", code: "closed"} when failure is none
			stream.close() onerror recover none
		}
	}

	// The replies received for one request, oldest first.
	type Slot {
		messages Message[]     = []
		signal   channel<none>

		def new() {
			signal = new channel<none>(1)
		}

		atomic def put(m Message) {
			messages.push(m)
			signal <- none when signal.len() == 0
		}

		atomic def take() ?Message {
			return none when messages.len() == 0
			return messages.shift()
		}
	}
}
