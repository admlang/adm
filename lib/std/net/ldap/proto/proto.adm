internal partial module std.net.ldap.proto {
	use (
		std.data.encoding
		std.data.encoding::(ASN1Class, ASN1Element, ASN1Tag, asn1Boolean, asn1Constructed, asn1Enumerated, asn1Integer, asn1OctetString, asn1Sequence, berParse)
		std.net
		std.net.ldap::(Change, Entry, Filter, FilterKind, LdapError, ResultCode)
	)

	// The LDAPv3 messages (RFC 4511 §4) in BER, and the framing of a
	// stream of them.

	// Protocol operation tags ([APPLICATION n]).
	const (
		opBindRequest      = 0
		opBindResponse     = 1
		opUnbindRequest    = 2
		opSearchRequest    = 3
		opSearchEntry      = 4
		opSearchDone       = 5
		opModifyRequest    = 6
		opModifyResponse   = 7
		opAddRequest       = 8
		opAddResponse      = 9
		opDelRequest       = 10
		opDelResponse      = 11
		opModifyDNRequest  = 12
		opModifyDNResponse = 13
		opCompareRequest   = 14
		opCompareResponse  = 15
		opAbandonRequest   = 16
		opSearchReference  = 19
		opExtendedRequest  = 23
		opExtendedResponse = 24
		opIntermediate     = 25
	)

	// Well-known object identifiers.
	const (
		oidStartTls              = "1.3.6.1.4.1.1466.20037"
		oidNoticeOfDisconnection = "1.3.6.1.4.1.1466.20036"
		oidWhoAmI                = "1.3.6.1.4.1.4203.1.11.3"
		oidPasswordModify        = "1.3.6.1.4.1.4203.1.11.1"
		oidPagedResults          = "1.2.840.113556.1.4.319"
		oidManageDsaIT           = "2.16.840.1.113730.3.4.2"
	)

	// Control is one request or response control (RFC 4511 §4.1.11).
	struct Control {
		oid      string
		critical bool    = false
		value    ?byte[] = none
	}

	// Message is one decoded LDAPMessage.
	struct Message {
		id       int
		op       int
		body     ASN1Element
		controls Control[]
	}

	// An LDAPMessage with its id, operation and controls.
	def envelope(id int, op ASN1Element, controls Control[]) byte[] {
		let items = [asn1Integer(id), op]
		if controls.len() > 0 {
			let list ASN1Element[] = []
			for let c in controls {
				let parts = [octets(c.oid)]
				parts.push(asn1Boolean(true)) when c.critical
				let v = c.value
				parts.push(asn1OctetString(v)) unless v is none
				list.push(asn1Sequence(parts))
			}
			items.push(asn1Constructed(ASN1Class.ContextSpecific, 0, list))
		}
		return asn1Sequence(items).encode()
	}

	// [APPLICATION tag] around children.
	def app(tag int, children ASN1Element[]) ASN1Element {
		return asn1Constructed(ASN1Class.Application, tag, children)
	}

	// A primitive [APPLICATION tag] holding bytes.
	def appPrimitive(tag int, content byte[]) ASN1Element {
		return new ASN1Element(ASN1Class.Application, tag, false, content)
	}

	// A primitive [n] holding bytes.
	def contextPrimitive(tag int, content byte[]) ASN1Element {
		return new ASN1Element(ASN1Class.ContextSpecific, tag, false, content)
	}

	def octets(text string) ASN1Element {
		return asn1OctetString(text.bytes())
	}

	// ---- requests ----

	def bindSimple(dn string, password string) ASN1Element {
		return app(opBindRequest, [asn1Integer(3), octets(dn), contextPrimitive(0, password.bytes())])
	}

	def bindSasl(dn string, mechanism string, credentials ?byte[]) ASN1Element {
		let parts = [octets(mechanism)]
		parts.push(asn1OctetString(credentials)) unless credentials is none
		return app(opBindRequest, [asn1Integer(3), octets(dn), asn1Constructed(ASN1Class.ContextSpecific, 3, parts)])
	}

	def unbind() ASN1Element {
		return appPrimitive(opUnbindRequest, [])
	}

	def searchRequest(base string, scope int, deref int, sizeLimit int, timeLimit int, typesOnly bool, filter Filter, attributes string[]) ASN1Element {
		let attrs ASN1Element[] = []
		for let a in attributes {
			attrs.push(octets(a))
		}
		return app(opSearchRequest, [octets(base), asn1Enumerated(scope), asn1Enumerated(deref), asn1Integer(sizeLimit), asn1Integer(timeLimit), asn1Boolean(typesOnly), encodeFilter(filter), asn1Sequence(attrs)])
	}

	def modifyRequest(dn string, changes Change[]) ASN1Element {
		let list ASN1Element[] = []
		for let c in changes {
			let vals ASN1Element[] = []
			for let v in c.values {
				vals.push(octets(v))
			}
			list.push(asn1Sequence([asn1Enumerated(c.kind.value), asn1Sequence([octets(c.attribute), setOf(vals)])]))
		}
		return app(opModifyRequest, [octets(dn), asn1Sequence(list)])
	}

	def addRequest(entry Entry) ASN1Element {
		return app(opAddRequest, [octets(entry.dn), attributeList(entry)])
	}

	def attributeList(entry Entry) ASN1Element {
		let list ASN1Element[] = []
		for let name in entry.attributeNames() {
			let vals ASN1Element[] = []
			for let v in entry.getAllBytes(name) {
				vals.push(asn1OctetString(v))
			}
			list.push(asn1Sequence([octets(name), setOf(vals)]))
		}
		return asn1Sequence(list)
	}

	def deleteRequest(dn string) ASN1Element {
		return appPrimitive(opDelRequest, dn.bytes())
	}

	def modifyDNRequest(dn string, newRDN string, deleteOld bool, newSuperior string) ASN1Element {
		let parts = [octets(dn), octets(newRDN), asn1Boolean(deleteOld)]
		parts.push(contextPrimitive(0, newSuperior.bytes())) when newSuperior != ""
		return app(opModifyDNRequest, parts)
	}

	def compareRequest(dn string, attribute string, value string) ASN1Element {
		return app(opCompareRequest, [octets(dn), asn1Sequence([octets(attribute), octets(value)])])
	}

	def abandonRequest(id int) ASN1Element {
		return appPrimitive(opAbandonRequest, asn1Integer(id).content)
	}

	def extendedRequest(oid string, value ?byte[]) ASN1Element {
		let parts = [contextPrimitive(0, oid.bytes())]
		parts.push(contextPrimitive(1, value)) unless value is none
		return app(opExtendedRequest, parts)
	}

	// A SET OF in the given order (LDAP does not ask for DER sorting).
	def setOf(items ASN1Element[]) ASN1Element {
		return asn1Constructed(ASN1Class.Universal, int(ASN1Tag.Set), items)
	}

	// ---- filters ----

	def encodeFilter(f Filter) ASN1Element {
		switch {
			case f.kind == FilterKind.And || f.kind == FilterKind.Or:
				let list ASN1Element[] = []
				for let c in f.children {
					list.push(encodeFilter(c))
				}
				return asn1Constructed(ASN1Class.ContextSpecific, f.kind == FilterKind.And ?? (0, 1), list)
			case f.kind == FilterKind.Not:
				return asn1Constructed(ASN1Class.ContextSpecific, 2, [encodeFilter(f.children[0])])
			case f.kind == FilterKind.Present:
				return contextPrimitive(7, f.attribute.bytes())
			case f.kind == FilterKind.Substring:
				let pieces ASN1Element[] = []
				pieces.push(contextPrimitive(0, f.initial.bytes())) when f.initial != ""
				for let a in f.any {
					pieces.push(contextPrimitive(1, a.bytes()))
				}
				pieces.push(contextPrimitive(2, f.final.bytes())) when f.final != ""
				return asn1Constructed(ASN1Class.ContextSpecific, 4, [octets(f.attribute), asn1Sequence(pieces)])
			case f.kind == FilterKind.Extensible:
				let parts ASN1Element[] = []
				parts.push(contextPrimitive(1, f.matchingRule.bytes())) when f.matchingRule != ""
				parts.push(contextPrimitive(2, f.attribute.bytes())) when f.attribute != ""
				parts.push(contextPrimitive(3, f.value.bytes()))
				parts.push(contextPrimitive(4, byte[255])) when f.dnAttributes
				return asn1Constructed(ASN1Class.ContextSpecific, 9, parts)
		}
		let tag = f.kind == FilterKind.GreaterOrEqual ?? (5, f.kind == FilterKind.LessOrEqual ?? (6, f.kind == FilterKind.Approx ?? (8, 3)))
		return asn1Constructed(ASN1Class.ContextSpecific, tag, [octets(f.attribute), octets(f.value)])
	}

	def decodeFilter(e ASN1Element) !Filter {
		fail protocolFailure("filter is not context-specific") unless e.class == ASN1Class.ContextSpecific
		switch {
			case e.tag == 0 || e.tag == 1:
				let f = new Filter(e.tag == 0 ?? (FilterKind.And, FilterKind.Or))
				for let c in e.children {
					f.children.push(try decodeFilter(c))
				}
				return f
			case e.tag == 2:
				let f = new Filter(FilterKind.Not)
				f.children.push(try decodeFilter(try e.inner()))
				return f
			case e.tag == 7:
				let f = new Filter(FilterKind.Present)
				f.attribute = string(e.content)
				return f
			case e.tag == 4:
				let f = new Filter(FilterKind.Substring)
				f.attribute = string((try e.at(0)).content)
				for let piece in (try e.at(1)).children {
					let text = string(piece.content)
					switch {
						case piece.tag == 0:
							f.initial = text
						case piece.tag == 2:
							f.final = text
						default:
							f.any.push(text)
					}
				}
				return f
			case e.tag == 9:
				let f = new Filter(FilterKind.Extensible)
				for let part in e.children {
					switch {
						case part.tag == 1:
							f.matchingRule = string(part.content)
						case part.tag == 2:
							f.attribute = string(part.content)
						case part.tag == 3:
							f.value = string(part.content)
						case part.tag == 4:
							f.dnAttributes = part.content.len() > 0 && part.content[0] != byte(0)
					}
				}
				return f
			case e.tag == 3 || e.tag == 5 || e.tag == 6 || e.tag == 8:
				let kind = e.tag == 5 ?? (FilterKind.GreaterOrEqual, e.tag == 6 ?? (FilterKind.LessOrEqual, e.tag == 8 ?? (FilterKind.Approx, FilterKind.Equal)))
				let f = new Filter(kind)
				f.attribute = string((try e.at(0)).content)
				f.value = string((try e.at(1)).content)
				return f
		}
		fail protocolFailure("unknown filter [{e.tag}]")
	}

	// ---- responses ----

	// An LDAPResult: code, matched DN, message, referrals.
	struct Result {
		code      int
		matchedDN string
		message   string
		referrals string[]
		// ExtendedResponse: name and value; BindResponse: SASL credentials.
		name      string   = ""
		value     ?byte[]  = none
	}

	def decodeResult(body ASN1Element) !Result {
		let r = Result{code: int(try (try body.at(0)).asInt()), matchedDN: string((try body.at(1)).content), message: string((try body.at(2)).content)}
		for let i = 3; i < body.children.len(); i++ {
			let c = body.children[i]
			if c.class == ASN1Class.ContextSpecific {
				switch {
					case c.tag == 3:
						for let url in c.children {
							r.referrals.push(string(url.content))
						}
					case c.tag == 7 || c.tag == 11:
						r.value = c.content
					case c.tag == 10:
						r.name = string(c.content)
				}
			}
		}
		return r
	}

	def resultElement(op int, code int, matchedDN string, message string, referrals string[], extra ASN1Element[]) ASN1Element {
		let parts = [asn1Enumerated(code), octets(matchedDN), octets(message)]
		if referrals.len() > 0 {
			let urls ASN1Element[] = []
			for let u in referrals {
				urls.push(octets(u))
			}
			parts.push(asn1Constructed(ASN1Class.ContextSpecific, 3, urls))
		}
		for let e in extra {
			parts.push(e)
		}
		return app(op, parts)
	}

	// The error for a result that is not a success.
	def resultError(r Result, op string) error {
		let name = resultName(r.code)
		let text = r.message == "" ?? (name, "{name}: {r.message}")
		return LdapError{message: "ldap: {op}: {text}", code: name, result: r.code, matchedDN: r.matchedDN, referrals: r.referrals}
	}

	def resultName(code int) string {
		let rc = resultCodeOf(code)
		return rc is none ?? ("result{code}", rc.name)
	}

	def resultCodeOf(code int) ?ResultCode {
		for let c in [ResultCode.Success, ResultCode.OperationsError, ResultCode.ProtocolError, ResultCode.TimeLimitExceeded, ResultCode.SizeLimitExceeded, ResultCode.CompareFalse, ResultCode.CompareTrue, ResultCode.AuthMethodNotSupported, ResultCode.StrongerAuthRequired, ResultCode.Referral, ResultCode.AdminLimitExceeded, ResultCode.UnavailableCriticalExtension, ResultCode.ConfidentialityRequired, ResultCode.SaslBindInProgress, ResultCode.NoSuchAttribute, ResultCode.UndefinedAttributeType, ResultCode.InappropriateMatching, ResultCode.ConstraintViolation, ResultCode.AttributeOrValueExists, ResultCode.InvalidAttributeSyntax, ResultCode.NoSuchObject, ResultCode.AliasProblem, ResultCode.InvalidDNSyntax, ResultCode.AliasDereferencingProblem, ResultCode.InappropriateAuthentication, ResultCode.InvalidCredentials, ResultCode.InsufficientAccessRights, ResultCode.Busy, ResultCode.Unavailable, ResultCode.UnwillingToPerform, ResultCode.LoopDetect, ResultCode.NamingViolation, ResultCode.ObjectClassViolation, ResultCode.NotAllowedOnNonLeaf, ResultCode.NotAllowedOnRDN, ResultCode.EntryAlreadyExists, ResultCode.ObjectClassModsProhibited, ResultCode.AffectsMultipleDSAs, ResultCode.Other] {
			return c when c.value == code
		}
		return none
	}

	def protocolFailure(text string) error {
		return LdapError{message: "ldap: " + text, code: "protocol", result: int(ResultCode.ProtocolError.value)}
	}

	// A SearchResultEntry as an Entry.
	def decodeEntry(body ASN1Element) !Entry {
		let e = new Entry(string((try body.at(0)).content))
		for let attr in (try body.at(1)).children {
			let name = string((try attr.at(0)).content)
			let raw byte[][] = []
			for let v in (try attr.at(1)).children {
				raw.push(v.content)
			}
			if raw.len() == 0 {
				// typesOnly: the attribute with no values.
				e.setBytes(name, [])
				e.add(name, byte[])
				continue
			}
			e.setBytes(name, raw)
		}
		return e
	}

	// The paged results control value (RFC 2696).
	def pagedControl(size int, cookie byte[]) Control {
		let value = asn1Sequence([asn1Integer(size), asn1OctetString(cookie)]).encode()
		return Control{oid: oidPagedResults, value: value}
	}

	// The cookie of a paged results response control; empty at the end.
	def pagedCookie(controls Control[]) byte[] {
		for let c in controls {
			continue unless c.oid == oidPagedResults
			let v = c.value
			return [] when v is none
			let (seq, _) = berParse(v) onerror recover (encoding.asn1Null(), 0)
			return [] when seq.children.len() < 2
			return seq.children[1].content
		}
		return []
	}

	// ---- framing ----

	// Reads one message off the stream. Fails when the stream ends or
	// the bytes are not an LDAPMessage.
	def readMessage(lines net.LineReader, timeout duration) !Message {
		let head = try lines.readBytes(2, timeout)
		let first = int(head[1])
		let lengthBytes byte[] = []
		let length = first
		if first >= 0x80 {
			let count = first & 0x7f
			fail protocolFailure("message length of {count} bytes") when count == 0 || count > 4
			lengthBytes = try lines.readBytes(count, timeout)
			length = 0
			for let b in lengthBytes {
				length = (length << 8) | int(b)
			}
		}
		fail protocolFailure("message of {length} bytes") when length > 64 * 1024 * 1024
		let body = try lines.readBytes(length, timeout)
		let (element, _) = berParse(head + lengthBytes + body) onerror fail protocolFailure("message is not BER")
		return try decodeMessage(element)
	}

	def decodeMessage(e ASN1Element) !Message {
		fail protocolFailure("message is not a SEQUENCE") unless e.isTag(ASN1Tag.Sequence) && e.children.len() >= 2
		let id = int(try (try e.at(0)).asInt())
		let op = e.children[1]
		fail protocolFailure("protocol op is not APPLICATION") unless op.class == ASN1Class.Application
		let controls Control[] = []
		if e.children.len() > 2 && e.children[2].isContext(0) {
			for let c in e.children[2].children {
				let ctl = Control{oid: string((try c.at(0)).content)}
				for let i = 1; i < c.children.len(); i++ {
					let part = c.children[i]
					if part.isTag(ASN1Tag.Boolean) {
						ctl.critical = part.asBool() onerror recover false
					} else {
						ctl.value = part.content
					}
				}
				controls.push(ctl)
			}
		}
		return Message{id: id, op: op.tag, body: op, controls: controls}
	}
}
