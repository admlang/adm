partial module std.net.ldap {
	use (
		std.net
		std.net.ldap.proto::*
		std.net.tls
	)

	// LdapURL is an LDAP URL (RFC 4516), as referrals and search
	// continuation references name other servers:
	// `ldap://host:port/dn?attributes?scope?filter`.
	struct LdapURL {
		// `ldap` or `ldaps`.
		scheme     string   = "ldap"
		// `host:port`, or "" when the URL names no server.
		host       string   = ""
		dn         string   = ""
		attributes string[] = []
		// None when the URL gives no scope.
		scope      ?Scope   = none
		filter     string   = ""
	}

	// parseURL reads an LDAP URL. Fails when it is not one, or its scope
	// is none of `base`, `one`, `sub`, `subordinates`.
	def parseURL(text string) !LdapURL {
		let lower = text.lower()
		let scheme = lower.startsWith("ldaps://") ?? ("ldaps", "ldap")
		fail LdapError{message: "ldap: {text} is not an LDAP URL", code: "protocol"} unless lower.startsWith("ldap://") || lower.startsWith("ldaps://")
		let rest = text[scheme.len() + 3:]
		let slash = rest.indexOf("/")
		let url = LdapURL{scheme: scheme, host: slash < 0 ?? (rest, rest[:slash])}
		url.host = net.withPort(url.host, scheme == "ldaps" ?? (636, 389)) unless url.host == ""
		return url when slash < 0
		let parts = rest[slash + 1:].split("?")
		url.dn = percentDecode(parts[0])
		if parts.len() > 1 && parts[1] != "" {
			for let a in parts[1].split(",") {
				url.attributes.push(percentDecode(a))
			}
		}
		if parts.len() > 2 && parts[2] != "" {
			let s = parts[2].lower()
			switch {
				case s == "base":
					url.scope = Scope.Base
				case s == "one":
					url.scope = Scope.One
				case s == "sub":
					url.scope = Scope.Subtree
				case s == "subordinates":
					url.scope = Scope.Children
				default:
					fail LdapError{message: "ldap: bad scope {parts[2]} in {text}", code: "protocol"}
			}
		}
		url.filter = percentDecode(parts[3]) when parts.len() > 3
		return url
	}

	// The referral URLs a failure carries: the server answered Referral.
	internal def referralsOf(err error) string[] {
		if err is LdapError {
			let e LdapError = err
			return e.referrals when e.result == ResultCode.Referral.value
		}
		return []
	}

	// A TLS config for another server: `base` checking `host` instead.
	internal def configFor(base tls.Config, host string) tls.Config {
		return tls.withServerName(base, host)
	}
}
