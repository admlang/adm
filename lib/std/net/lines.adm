partial module std.net {
	// LineReader buffers the reading side of a Stream for line protocols:
	// lines ending in CRLF or a bare LF, counted runs of bytes, and plain
	// reads that drain what is buffered before touching the stream.
	//
	// ```
	// let lines = new net.LineReader(conn)
	// let greeting = try lines.readLine()
	// let body = try lines.readBytes(512)
	// ```
	type LineReader {
		stream           Stream
		// The longest line accepted, in bytes.
		limit            int    = 16384
		// Whether `readLine` passes over empty lines.
		skipEmpty        bool   = false
		internal pending byte[] = []
		internal offset  int    = 0

		def new(stream Stream, limit int = 16384, skipEmpty bool = false) {
			self.stream = stream
			self.limit = limit
			self.skipEmpty = skipEmpty
		}

		// The next line without its line ending, waiting up to `timeout`
		// for each read. Fails when the stream ends first, a read fails, or
		// the line is longer than `limit`.
		def readLine(timeout duration = 30s) !string {
			return string(try readLineBytes(timeout))
		}

		// The next line as bytes, without its line ending. Fails as
		// `readLine` does.
		def readLineBytes(timeout duration = 30s) !byte[] {
			let scanned = offset
			for {
				for let i = scanned; i < pending.len(); i++ {
					if pending[i] == byte(10) {
						let end = i
						end-- when end > offset && pending[end - 1] == byte(13)
						fail errorOf(ErrorCode.Other, "read", "", "line longer than {limit} bytes") when end - offset > limit
						let line = pending[offset:end].clone()
						consume(i + 1)
						return try readLineBytes(timeout) when skipEmpty && line.len() == 0
						return line
					}
				}
				scanned = pending.len()
				fail errorOf(ErrorCode.Other, "read", "", "line longer than {limit} bytes") when pending.len() - offset > limit
				try fill(timeout)
			}
			fail "unreachable"
		}

		// The next `count` bytes. Fails when the stream ends first or a
		// read fails.
		def readBytes(count int, timeout duration = 30s) !byte[] {
			for pending.len() - offset < count {
				try fill(timeout)
			}
			let out = pending[offset:offset + count].clone()
			consume(offset + count)
			return out
		}

		// Reads into `data` from what is buffered, else from the stream;
		// 0 at the end of the stream. Fails when the read does.
		def read(data byte[], timeout duration = 30s) !int {
			return 0 when data.len() == 0
			return try stream.read(data, timeout) when pending.len() - offset == 0
			let n = pending.len() - offset
			n = data.len() when data.len() < n
			for let i = 0; i < n; i++ {
				data[i] = pending[offset + i]
			}
			consume(offset + n)
			return n
		}

		// Whether bytes were read ahead of the last line or run.
		def hasPending() bool {
			return pending.len() > offset
		}

		// Hands back what was read ahead and empties the buffer: for a
		// protocol that switches the stream to another reader (a TLS
		// upgrade, a binary phase).
		def takePending() byte[] {
			let out = pending[offset:].clone()
			pending = []
			offset = 0
			return out
		}

		internal def consume(upTo int) {
			offset = upTo
			if offset >= pending.len() {
				pending = []
				offset = 0
			} else if offset > 65536 && offset * 2 > pending.len() {
				pending = pending[offset:].clone()
				offset = 0
			}
		}

		internal def fill(timeout duration) !none {
			let buf byte[] = []
			buf.len(8192)
			let n = try stream.read(buf, timeout)
			fail errorOf(ErrorCode.Closed, "read", "", "connection closed") when n == 0
			pending = pending + buf[:n]
			return none
		}
	}
}
