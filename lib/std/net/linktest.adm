// An in-memory datagram link for the suites of std.net: what one end sends
// the other receives, with loss and reordering on request. Suite support
// only: a suite of another package cannot import a `_test.adm` file, so it
// lives here, and loads only into a program that names it.
internal std.net partial module std.net.linktest {
	use (
		std.net
		std.net.waiting::(awaitSignal)
		std.time
	)

	// LinkEnd is one end of an in-memory datagram link: what one end sends,
	// the other receives, unless this end drops it. Implements
	// net.DatagramTransport.
	type LinkEnd {
		weak other   ?LinkEnd
		atomic queue byte[][]      = []
		signal       channel<none>
		closed       bool          = false
		// Drops every n-th datagram this end sends; 0 drops none.
		dropEvery    int           = 0
		atomic sent  int           = 0
		// Holds back every n-th datagram and delivers it after the next
		// one; 0 reorders none.
		swapEvery    int           = 0
		held         ?byte[]       = none
		// Loses datagrams longer than this, as a path does; 0 passes all.
		limit        int           = 0
		// Loses the datagrams this end sends from the `dropFrom`-th to
		// the `dropUntil`-th (counted from 1); 0 loses none.
		dropFrom     int           = 0
		dropUntil    int           = 0
		// Loses this many in a thousand of the datagrams this end sends,
		// picked by a generator that starts from `seed`; 0 loses none.
		lossPerMille int           = 0
		seed         int           = 1
		// How long a datagram this end sends is on its way.
		delay        duration      = 0s
		// When each queued datagram may be received.
		atomic due   int[]         = []

		def new() {
			signal = new channel<none>(1)
		}

		def send(data byte[], timeout duration) !none {
			fail net.errorOf(net.ErrorCode.Closed, "send", "", "link is closed") when closed
			return none when limit > 0 && data.len() > limit
			let count = bump()
			return none when dropEvery > 0 && count % dropEvery == 0
			return none when dropFrom > 0 && count >= dropFrom && count <= dropUntil
			return none when lossPerMille > 0 && draw() < lossPerMille
			let peer = other
			return none when peer is none
			if swapEvery > 0 && count % swapEvery == 0 {
				held = data.clone()
				return none
			}
			let arrives = delay > 0s ?? (int(time.monoNs()) + int(delay), 0)
			peer.push(data.clone(), arrives)
			let late = held
			if !(late is none) {
				held = none
				peer.push(late, arrives)
			}
			return none
		}

		// draw is the next number below a thousand of the loss generator.
		atomic def draw() int {
			seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF
			return (seed >> 8) % 1000
		}

		atomic def bump() int {
			sent++
			return sent
		}

		def push(data byte[], arrives int = 0) {
			enqueue(data, arrives)
			signal.offer(none)
		}

		atomic def enqueue(data byte[], arrives int) {
			queue.push(data)
			due.push(arrives)
		}

		// dequeue is the next datagram that has arrived by `now`, none
		// while there is none.
		atomic def dequeue(now int) ?byte[] {
			return none when queue.len() == 0 || due[0] > now
			due.shift()
			return queue.shift()
		}

		// arriving is when the next datagram on its way arrives, 0 when
		// none is.
		atomic def arriving() int {
			return due.len() == 0 ?? (0, due[0])
		}

		def receive(buf byte[], timeout duration) !int {
			let deadline = timeout > 0s ?? (int(time.monoNs()) + int(timeout), 0)
			for {
				fail net.errorOf(net.ErrorCode.Closed, "receive", "", "link is closed") when closed
				let next = dequeue(int(time.monoNs()))
				if !(next is none) {
					next.copy(buf)
					return next.len()
				}
				// A datagram on its way is waited for, not signalled.
				let coming = arriving()
				if coming > 0 {
					let wait = coming - int(time.monoNs())
					time.sleep(duration(wait)) when wait > 0
					continue
				}
				fail net.errorOf(net.ErrorCode.TimedOut, "receive", "", "timed out") unless awaitSignal(signal, deadline)
			}
			fail "unreachable"
		}

		def close() !none {
			closed = true
			return none
		}

		def isOpen() bool {
			return !closed
		}
	}

	// linkPair is two connected ends.
	def linkPair() (LinkEnd, LinkEnd) {
		let a = new LinkEnd()
		let b = new LinkEnd()
		a.other = b
		b.other = a
		return (a, b)
	}
}
