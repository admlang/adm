partial module std.net.mail {
	use (
		std.formats.mail::(Message)
		std.net.mail.imap
		std.net.mail.smtp
		std.time::(Time)
	)

	// Protocol picks how a `Client` reads mail.
	enum Protocol {
		// IMAP: mailboxes stay on the server; flags, folders and moves work.
		Imap = "imap",
		// POP3: the inbox only; reading downloads, `delete` removes.
		Pop3 = "pop3",
	}

	// MessageInfo is one message as a mailbox listing shows it, without
	// its body. `id` names it for `fetch`, `delete`, `markSeen` and `move`:
	// the IMAP UID, or the POP3 unique ID.
	struct MessageInfo {
		id      string
		subject string
		from    string
		date    ?Time
		size    int64
		seen    bool
	}

	// Client is a mail account: it sends through SMTP and reads through
	// IMAP (or POP3), connecting on first use and keeping the connections
	// until `close`. Servers left empty are found from the address's domain
	// through the SRV records of RFC 6186 and RFC 8314
	// (`_submissions._tcp`, `_imaps._tcp`, `_pop3s._tcp`).
	//
	// ```
	// let account = new mail.Client("alice@example.com", "s3cret", "Alice")
	// try account.send(new Message().to("bob@example.com").subject("Hi").text("Hello"))
	// for let info in try account.messages() {
	//     let message = try account.fetch(info.id)
	// }
	// try account.close()
	// ```
	type Client {
		// The account's address; the `From` of messages that have none.
		address  string
		// The display name next to `address` in `From`.
		name     string           = ""
		// The login name; empty uses `address`.
		user     string           = ""
		password Secret<string>
		// The SMTP submission server, `host` or `host:port`; empty finds it.
		outgoing string           = ""
		// The IMAP or POP3 server, `host` or `host:port`; empty finds it.
		incoming string           = ""
		protocol Protocol         = Protocol.Imap
		// How long each command may wait.
		timeout  duration         = 60s

		def new(address string, password Secret<string>, name string = "") {}

		// Looks up `outgoing` and `incoming` from the address's domain where
		// they are empty. Fails when the domain publishes no servers.
		def discover() !none {}

		// Sends `message`, `From` set to the account when it has none.
		// Fails when the server refuses the login, the sender or every
		// recipient.
		def send(message Message) !smtp.Delivery {}

		// Sends a reply to `original` with `text` as its body (`all` copies
		// the other recipients). Fails as `send` does.
		def reply(original Message, text string, all bool = false) !smtp.Delivery {}

		// The mailbox names (INBOX only with POP3). Fails when the server
		// cannot be reached or refuses the login.
		def mailboxes() !string[] {}

		// The messages of `mailbox`, oldest first; with IMAP only those
		// matching `condition`, all when none. Fails when the mailbox does
		// not exist or the server cannot be reached.
		def messages(mailbox string = "INBOX", condition ?imap.Search = none) !MessageInfo[] {}

		// Message `id` of `mailbox`, whole. Fails when it is gone.
		def fetch(id string, mailbox string = "INBOX") !Message {}

		// Marks message `id` seen or unseen (IMAP only; POP3 has no flags).
		// Fails when it is gone or the protocol is POP3.
		def markSeen(id string, seen bool = true, mailbox string = "INBOX") !none {}

		// Moves message `id` to mailbox `to` (IMAP only). Fails when either
		// is missing or the protocol is POP3.
		def move(id string, to string, mailbox string = "INBOX") !none {}

		// Deletes message `id`: with IMAP it is flagged and expunged, with
		// POP3 removed when the session ends. Fails when it is gone.
		def delete(id string, mailbox string = "INBOX") !none {}

		// Waits up to `timeout` for new messages in `mailbox` (IMAP IDLE,
		// else polling) and returns them. Fails when the connection breaks.
		def watch(mailbox string = "INBOX", timeout duration = 29m) !MessageInfo[] {}

		// Closes the connections. Fails when one cannot be closed cleanly;
		// all are closed still.
		def close() !none {}

		def dispose() {}
	}
}
