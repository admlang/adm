partial module std.net.mail {
	use (
		std.formats.mail
		std.formats.mail::(Maildir, Message)
		std.net.mail.imap
		std.net.mail.pop3
		std.net.mail.smtp
		std.testing
		std.time
	)

	// Alice's password, for all three servers.
	internal type TestLogins {
		def new() {}

		def login(user string, password Secret<string>) !none {
			fail "refused" unless user == "alice@example.com" && password.reveal() == "s3cret"
			return none
		}
	}

	internal type TestImapAccounts {
		box Maildir

		def new(box Maildir) {
			self.box = box
		}

		def login(user string, password Secret<string>) !imap.Account {
			fail "refused" unless user == "alice@example.com" && password.reveal() == "s3cret"
			return new imap.MaildirAccount(box)
		}
	}

	internal type TestDrops {
		box Maildir

		def new(box Maildir) {
			self.box = box
		}

		def login(user string, password Secret<string>) !pop3.Maildrop {
			fail "refused" unless user == "alice@example.com" && password.reveal() == "s3cret"
			return new pop3.MaildirDrop(box)
		}
	}

	// An SMTP server delivering every recipient into `box`, and IMAP and
	// POP3 servers reading it.
	internal def mailServers(box Maildir) !(smtp.Server, imap.Server, pop3.Server) {
		let submission = new smtp.Server(new smtp.MaildirHandler(def (recipient string) ?Maildir {
			return box
		}), "127.0.0.1:0")
		submission.security = smtp.Security.Plain
		submission.authenticator = new TestLogins()
		submission.timeout = 5s
		try submission.start()
		let reading = new imap.Server(new TestImapAccounts(box), "127.0.0.1:0")
		reading.security = imap.Security.Plain
		reading.timeout = 5s
		try reading.start()
		let drop = new pop3.Server(new TestDrops(box), "127.0.0.1:0")
		drop.security = pop3.Security.Plain
		drop.timeout = 5s
		try drop.start()
		return (submission, reading, drop)
	}

	internal def sendLater(from Client, delay duration) {
		time.sleep(delay)
		from.send(new Message().to("alice@example.com").subject("new").text("y")) onerror (err error) {
			recover smtp.Delivery{accepted: [], rejected: []}
		}
	}

	internal def freshBox() !Maildir {
		let box = new Maildir("/tmp/adm-mail-client-{time.now().unixNs()}")
		try box.create()
		return box
	}

	internal def account(submission smtp.Server, incoming string, protocol Protocol) Client {
		let c = new Client("alice@example.com", "s3cret", "Alice")
		c.outgoing = "smtp://" + submission.address().str()
		c.incoming = incoming
		c.protocol = protocol
		c.timeout = 5s
		return c
	}

	check "mail.Client" {
		@test()
		def sendsAndReadsOverImap() !none {
			let box = try freshBox()
			let (submission, reading, drop) = try mailServers(box)
			let alice = account(submission, "imap://" + reading.address().str(), Protocol.Imap)
			let delivery = try alice.send(new Message().to("bob@example.com").subject("Hello").text("First message"))
			assert delivery.accepted.equals(["bob@example.com"])
			try alice.send(new Message().to("bob@example.com").subject("Second").text("Another"))
			assert (try alice.mailboxes()).includes("INBOX")
			let listed = try alice.messages()
			assert listed.len() == 2
			assert listed[0].subject == "Hello" && listed[0].from.contains("alice@example.com") && !listed[0].seen
			let first = try alice.fetch(listed[0].id)
			assert (try first.from())[0].name == "Alice"
			let body = first.text()
			assert !(body is none) && body.trim() == "First message"
			try alice.markSeen(listed[0].id)
			let unseen = try alice.messages(condition = new imap.Search().unseen())
			assert unseen.len() == 1 && unseen[0].subject == "Second"
			try alice.markSeen(listed[0].id, false)
			assert (try alice.messages(condition = new imap.Search().unseen())).len() == 2
			// A reply to all leaves the account's own address out.
			let original = new Message().from("carol@example.com").to("alice@example.com").cc("dave@example.com").subject("Plans").messageId("m1@example.com")
			try alice.reply(original, "Sounds good", all = true)
			// One copy per recipient lands in the shared test box.
			let replies = try alice.messages(condition = new imap.Search().subject("Re: Plans"))
			assert replies.len() == 2
			let reply = try alice.fetch(replies[0].id)
			assert (try reply.to()).mapElem<string>(a => a.address).equals(["carol@example.com"])
			assert (try reply.cc()).mapElem<string>(a => a.address).equals(["dave@example.com"])
			assert reply.inReplyTo().equals(["m1@example.com"])
			for let r in replies {
				try alice.delete(r.id)
			}
			assert (try alice.messages()).len() == 2
			let code = ""
			alice.fetch("999999") onerror (err error) {
				code = err is imap.ImapError ?? ("imap", "other")
				recover new Message()
			}
			assert code != ""
			try alice.close()
			try submission.close()
			try reading.close()
			try drop.close()
			return none
		}

		@test()
		def watchesForNewMail() !none {
			let box = try freshBox()
			let (submission, reading, drop) = try mailServers(box)
			let alice = account(submission, "imap://" + reading.address().str(), Protocol.Imap)
			try alice.send(new Message().to("alice@example.com").subject("old").text("x"))
			assert (try alice.messages()).len() == 1
			let sender = account(submission, "imap://" + reading.address().str(), Protocol.Imap)
			let task = async sendLater(sender, 300ms)
			task.keepAlive()
			let fresh = try alice.watch(timeout = 5s)
			assert fresh.len() == 1 && fresh[0].subject == "new"
			try alice.close()
			try sender.close()
			try submission.close()
			try reading.close()
			try drop.close()
			return none
		}

		@test()
		def readsOverPop3() !none {
			let box = try freshBox()
			let (submission, reading, drop) = try mailServers(box)
			let alice = account(submission, "pop3://" + drop.address().str(), Protocol.Pop3)
			try alice.send(new Message().to("alice@example.com").subject("via pop").text("pop body"))
			assert (try alice.mailboxes()).equals(["INBOX"])
			let listed = try alice.messages()
			assert listed.len() == 1 && listed[0].subject == "via pop" && listed[0].size > 0
			let m = try alice.fetch(listed[0].id)
			assert m.subject() == "via pop"
			let code = ""
			alice.markSeen(listed[0].id) onerror (err error) {
				code = err is MailError ?? (err.code, "other")
				recover none
			}
			assert code == "unsupported"
			code = ""
			alice.messages("Archive") onerror (err error) {
				code = err is MailError ?? (err.code, "other")
				recover []
			}
			assert code == "unsupported"
			try alice.delete(listed[0].id)
			try alice.close()
			// The deletion took effect when the session ended.
			let again = account(submission, "pop3://" + drop.address().str(), Protocol.Pop3)
			assert (try again.messages()).len() == 0
			try again.close()
			try submission.close()
			try reading.close()
			try drop.close()
			return none
		}

		@test()
		def refusesBadLoginsAndUnknownDomains() !none {
			let box = try freshBox()
			let (submission, reading, drop) = try mailServers(box)
			let mallory = new Client("alice@example.com", "wrong")
			mallory.outgoing = "smtp://" + submission.address().str()
			mallory.incoming = "imap://" + reading.address().str()
			assert mallory.send(new Message().to("x@example.com").subject("s").text("t")) is error
			assert mallory.messages() is error
			let lost = new Client("someone@adm-test.invalid", "x")
			let code = ""
			lost.discover() onerror (err error) {
				code = err is MailError ?? (err.code, "other")
				recover none
			}
			assert code == "discovery"
			try submission.close()
			try reading.close()
			try drop.close()
			return none
		}
	}
}
