partial module std.net.mail.imap {
	use (
		std.errors
		std.net.mail.imap.proto::*
		std.time::(Time)
	)

	// Security picks how a connection is protected.
	enum Security {
		// No TLS; the password and the mail cross the network in the clear.
		Plain    = "plain",
		// `STARTTLS` on port 143 before login (RFC 9051 §6.2.1). The client
		// fails when the server does not offer it.
		StartTls = "starttls",
		// TLS from the first byte, on port 993 (RFC 8314).
		Implicit = "implicit",
	}

	// AuthMethod is how a client logs in.
	enum AuthMethod {
		// `LOGIN user password`.
		Login   = "LOGIN",
		// `AUTHENTICATE PLAIN` (RFC 4616).
		Plain   = "PLAIN",
		// `AUTHENTICATE XOAUTH2`: an OAuth 2.0 access token in place of the
		// password.
		XOAuth2 = "XOAUTH2",
	}

	// Flag is a system flag of a message (RFC 9051 §2.3.2). Keywords a
	// server allows beyond these are plain strings (`$Forwarded`, `$Junk`).
	enum Flag {
		Seen     = "\\Seen",
		Answered = "\\Answered",
		Flagged  = "\\Flagged",
		Deleted  = "\\Deleted",
		Draft    = "\\Draft",
	}

	// ImapError is the payload of a failure the server reported: the
	// status (`NO` for a refusal, `BAD` for a command it did not take), the
	// response code of RFC 9051 §7.1 (`TRYCREATE`, `NONEXISTENT`,
	// `AUTHENTICATIONFAILED`, `OVERQUOTA`) when it sent one, and the text.
	struct ImapError {
		message  string
		code     string
		cause    ?error
		stack    errors.StackTrace
		status   string
		response string
		text     string
	}

	// Mailbox is one entry of `LIST`: its name, the hierarchy delimiter
	// (empty for a flat server), and its attributes (`\Noselect`,
	// `\HasChildren`, and the special uses of RFC 6154: `\Sent`, `\Trash`,
	// `\Drafts`, `\Junk`, `\Archive`, `\All`, `\Flagged`).
	struct Mailbox {
		name       string
		delimiter  string
		attributes string[]
	}

	// MailboxStatus is what `Client.open` and `Client.status` report. A count the
	// server did not send is 0.
	struct MailboxStatus {
		messages       int
		unseen         int
		uidNext        int64
		// Changes when the mailbox's UIDs no longer mean what they did;
		// cached UIDs must be dropped.
		uidValidity    int64
		// The highest modification sequence (CONDSTORE, RFC 7162), 0 when
		// the server lacks it.
		highestModSeq  int64
		// Bytes in the mailbox (RFC 8438), 0 when not reported.
		size           int64
		// The flags the mailbox knows, and those a client may set
		// (`\*` for new keywords).
		flags          string[]
		permanentFlags string[]
		readOnly       bool
	}

	// Summary is what `summaries` fetches of a message without its body:
	// its UID, flags, size, arrival time and the envelope's fields.
	struct Summary {
		uid          int64
		flags        string[]
		size         int64
		internalDate Time
		// The envelope (RFC 9051 §7.5.2), decoded.
		date         ?Time
		subject      string
		from         string[]
		to           string[]
		cc           string[]
		messageId    string
		inReplyTo    string
		modSeq       int64
	}

	// UpdateKind names what changed in the selected mailbox.
	enum UpdateKind {
		// A message arrived; `sequence` is the new count.
		Exists  = "exists",
		// A message was removed; `sequence` is its old number.
		Expunge = "expunge",
		// A message's flags changed.
		Flags   = "flags",
	}

	// Update is one change the server reported unasked, during `idle` or
	// after another command.
	struct Update {
		kind     UpdateKind
		sequence int
		// The UID when the server sent it (flag changes, QRESYNC
		// vanished messages), else 0.
		uid      int64
		flags    string[]
	}

	// Search is a search condition for `Client.search` (RFC 9051 §6.4.4),
	// built by chaining: every condition must hold unless combined with
	// `or`/`not`.
	//
	// ```
	// let recent = new imap.Search().unseen().from("alice@example.com").since(yesterday)
	// ```
	type Search {
		internal terms string[] = []

		def new() {}

		// add appends a term and returns the condition.
		internal def add(term string) Search {
			terms.push(term)
			return self
		}

		// value writes a string argument: quoted, or a literal when it
		// holds line breaks or non-ASCII text.
		internal def value(text string) string {
			let plain = true
			for let b in text.bytes() {
				plain = false when (b := 0x0D || 0x0A || 0x00) || b >= 0x80
			}
			return quote(text) when plain
			return literalMarker(text.bytes().len(), false).trimPrefix(" ") + text
		}

		// Messages without `\Seen`.
		def unseen() Search {
			return add("UNSEEN")
		}

		// Messages with `flag` (a `Flag` value or a keyword).
		def flagged(flag string) Search {
			let system = systemSearchKey(flag)
			return add(system == "" ?? ("KEYWORD " + flag, system))
		}

		// Messages without `flag`.
		def unflagged(flag string) Search {
			let system = systemSearchKey(flag)
			return add(system == "" ?? ("UNKEYWORD " + flag, "UN" + system))
		}

		// Messages whose `From` contains `text`.
		def from(text string) Search {
			return add("FROM " + value(text))
		}

		// Messages whose `To` contains `text`.
		def to(text string) Search {
			return add("TO " + value(text))
		}

		// Messages whose `Subject` contains `text`.
		def subject(text string) Search {
			return add("SUBJECT " + value(text))
		}

		// Messages whose header field `name` contains `text`.
		def header(name string, text string) Search {
			return add("HEADER " + value(name) + " " + value(text))
		}

		// Messages whose headers or body contain `text`.
		def text(text string) Search {
			return add("TEXT " + value(text))
		}

		// Messages whose body contains `text`.
		def body(text string) Search {
			return add("BODY " + value(text))
		}

		// Messages that arrived on or after the day of `time`.
		def since(time Time) Search {
			return add("SINCE " + formatDate(time))
		}

		// Messages that arrived before the day of `time`.
		def before(time Time) Search {
			return add("BEFORE " + formatDate(time))
		}

		// Messages larger than `bytes`.
		def larger(bytes int64) Search {
			return add("LARGER {bytes}")
		}

		// Messages smaller than `bytes`.
		def smaller(bytes int64) Search {
			return add("SMALLER {bytes}")
		}

		// Messages among `uids`.
		def uids(uids int64[]) Search {
			return add(uids.len() == 0 ?? ("UID 0", "UID " + formatSet(uids)))
		}

		// Messages changed after modification sequence `modSeq`
		// (CONDSTORE).
		def changedSince(modSeq int64) Search {
			return add("MODSEQ {modSeq}")
		}

		// Messages matching `either` or `or`.
		def or(either Search, or Search) Search {
			return add("OR (" + either.str() + ") (" + or.str() + ")")
		}

		// Messages not matching `condition`.
		def not(condition Search) Search {
			return add("NOT (" + condition.str() + ")")
		}

		// The condition in IMAP syntax.
		def str() string {
			return terms.len() == 0 ?? ("ALL", terms.join(" "))
		}
	}

	// systemSearchKey is the SEARCH key of a system flag (`SEEN` for
	// `\Seen`), empty for a keyword.
	internal def systemSearchKey(flag string) string {
		match flag.lower() {
			case "\\seen":
				return "SEEN"
			case "\\answered":
				return "ANSWERED"
			case "\\flagged":
				return "FLAGGED"
			case "\\deleted":
				return "DELETED"
			case "\\draft":
				return "DRAFT"
		}
		return ""
	}
}
