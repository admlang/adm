partial module std.net.mail.imap {
	use (
		std.crypto.x509::(CertPool)
		std.formats.mail
		std.formats.mail::(Maildir)
		std.net
		std.net.mail.imap.proto::*
		std.net.mail.wire::*
		std.net.tls
		std.testing
		std.time
	)

	// A self-signed P-256 certificate for 127.0.0.1, localhost and
	// example.com, valid for a century (the one httptest presents).
	internal const imapCertPEM =
		"-----BEGIN CERTIFICATE-----\n" +
		"MIIByzCCAXCgAwIBAgIULZ61fkBLJqpHXo7Dg3TjjURKNKQwCgYIKoZIzj0EAwIw\n" +
		"EzERMA8GA1UEAwwIQURNIHRlc3QwIBcNMjYwOTE2MjEyNDQ4WhgPMjEyNjA4MjMy\n" +
		"MTI0NDhaMBMxETAPBgNVBAMMCEFETSB0ZXN0MFkwEwYHKoZIzj0CAQYIKoZIzj0D\n" +
		"AQcDQgAEWmnKIPFi8/hNfbTouWeJ0sX7jXIK0H2BdAa3ZlChTQUtkRXRuGnkYmY9\n" +
		"c9D2sLIU0D8YtBwSi1XCEXkyARGL3KOBnzCBnDAdBgNVHQ4EFgQUdGEQb1u97o8W\n" +
		"5FkheQ27r3JNU3AwHwYDVR0jBBgwFoAUdGEQb1u97o8W5FkheQ27r3JNU3AwDwYD\n" +
		"VR0TAQH/BAUwAwEB/zAnBgNVHREEIDAegglsb2NhbGhvc3SCC2V4YW1wbGUuY29t\n" +
		"hwR/AAABMAsGA1UdDwQEAwIHgDATBgNVHSUEDDAKBggrBgEFBQcDATAKBggqhkjO\n" +
		"PQQDAgNJADBGAiEA6p+D8so1nzo4nOkB8z0x1Tq+9iG1qIweVo/zTnSHG9cCIQDo\n" +
		"ANw/RkMk5iyYvJf8Qx75u8fY/n2s26d6Clj96iuH/g==\n" +
		"-----END CERTIFICATE-----\n"

	internal const imapKeyPEM =
		"-----BEGIN PRIVATE KEY-----\n" +
		"MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgz6zLOlG3plulCC6J\n" +
		"73w4HvDFzW9lrGWy0U1PuM2M1gWhRANCAARaacog8WLz+E19tOi5Z4nSxfuNcgrQ\n" +
		"fYF0BrdmUKFNBS2RFdG4aeRiZj1z0PawshTQPxi0HBKLVcIReTIBEYvc\n" +
		"-----END PRIVATE KEY-----\n"

	// Accounts lets alice in with `s3cret`, over one Maildir tree.
	type Accounts {
		root Maildir

		def new(root Maildir) {
			self.root = root
		}

		def login(user string, password Secret<string>) !Account {
			fail "refused" unless user == "alice" && password.reveal() == "s3cret"
			return new MaildirAccount(root)
		}
	}

	internal def imapTree() !Maildir {
		let root = new Maildir("/tmp/adm-imap-{time.now().unixNs()}")
		try root.create()
		try root.deliver("From: Bob <bob@x.org>\r\nTo: alice@x.org\r\nSubject: first\r\nDate: Tue, 1 Jul 2003 10:52:37 +0200\r\n\r\nhello there\r\n".bytes())
		time.sleep(2ms)
		let multipart = [
			"From: carol@x.org",
			"To: alice@x.org",
			"Subject: =?utf-8?q?caf=C3=A9?=",
			"Content-Type: multipart/mixed; boundary=b1",
			"",
			"--b1",
			"Content-Type: text/plain; charset=utf-8",
			"",
			"part one",
			"--b1",
			"Content-Type: application/octet-stream",
			"Content-Transfer-Encoding: base64",
			"Content-Disposition: attachment; filename=data.bin",
			"",
			"AAEC",
			"--b1--",
			"",
		].join("\r\n")
		try root.deliver(multipart.bytes())
		return root
	}

	internal def startImap(root Maildir, security Security = Security.Plain) !Server {
		let server = new Server(new Accounts(root), "127.0.0.1:0")
		server.security = security
		server.timeout = 5s
		server.idleTimeout = 10s
		let pair = try tls.parseKeyPair(imapCertPEM, imapKeyPEM)
		server.tls = tls.Config{certificates: [pair]}
		try server.start()
		return server
	}

	internal def imapClient(server Server, security Security = Security.Plain) !Client {
		let client = new Client(security, 5s)
		let pool = new CertPool()
		pool.appendCertsFromPEM(imapCertPEM)
		client.tls = tls.Config{serverName: "localhost", rootCAs: pool}
		try client.connect(server.address().str())
		try client.login("alice", "s3cret")
		return client
	}

	check "imap" {
		@test()
		def browsesAndFlags() !none {
			let server = try startImap(try imapTree())
			let client = try imapClient(server)
			assert client.hasCapability("IDLE") && client.hasCapability("MOVE")
			try client.create("Sent")
			let boxes = try client.mailboxes()
			assert boxes.len() == 2
			let sent = try client.specialUse("\\Sent")
			assert !(sent is none) && sent.name == "Sent"
			let st = try client.open("INBOX")
			assert st.messages == 2 && st.uidValidity > 0 && st.uidNext == 3 && !st.readOnly
			let all = try client.search(new Search())
			assert all.equals([1, 2])
			let sums = try client.summaries(all)
			assert sums.len() == 2 && sums[0].subject == "first" && sums[1].subject == "café"
			assert sums[0].from.equals(["Bob <bob@x.org>"]) && sums[0].to.equals(["alice@x.org"])
			let date = sums[0].date
			assert !(date is none) && date.hour() == 8
			let msg = try client.message(1)
			assert msg.subject() == "first"
			assert (try client.search(new Search().unseen())).len() == 2
			try client.addFlags([1], [Flag.Seen.value, "$Junk"])
			assert (try client.search(new Search().unseen())).equals([2])
			assert (try client.search(new Search().flagged("$Junk"))).equals([1])
			try client.removeFlags([1], ["$Junk"])
			let again = try client.summaries([1])
			assert again[0].flags.equals(["\\Seen"])
			try client.setFlags([2], [Flag.Flagged.value])
			assert (try client.summaries([2]))[0].flags.equals(["\\Flagged"])
			let status = try client.status("INBOX")
			assert status.messages == 2 && status.unseen == 1
			try client.unselect()
			try client.close()
			try server.close()
			return none
		}

		@test()
		def copiesMovesAppendsAndExpunges() !none {
			let server = try startImap(try imapTree())
			let client = try imapClient(server)
			try client.create("Archive")
			try client.open("INBOX")
			let copied = try client.copy([1], "Archive")
			assert copied.len() == 1
			let moved = try client.move([2], "Archive")
			assert moved.len() == 1
			assert (try client.search(new Search())).equals([1])
			let code = ""
			client.copy([1], "Missing") onerror (err error) {
				code = err.response when err is ImapError
				recover []
			}
			assert code == "TRYCREATE"
			let appended = try client.append("Archive", new mail.Message().from("a@x.org").subject("appended").text("x"), [Flag.Draft.value])
			assert appended > 0
			let archive = try client.status("Archive")
			assert archive.messages == 3
			try client.addFlags([1], [Flag.Deleted.value])
			try client.expunge()
			assert (try client.search(new Search())).len() == 0
			try client.open("Archive")
			let drafts = try client.search(new Search().flagged(Flag.Draft.value))
			assert drafts.equals([appended])
			assert (try client.message(appended)).subject() == "appended"
			try client.rename("Archive", "Old")
			assert (try client.mailboxes()).filter(m => m.name == "Old").len() == 1
			try client.close()
			try server.close()
			return none
		}

		@test()
		def searchesConditions() !none {
			let server = try startImap(try imapTree())
			let client = try imapClient(server)
			try client.open("INBOX")
			assert (try client.search(new Search().from("bob"))).equals([1])
			assert (try client.search(new Search().subject("caf"))).equals([2])
			assert (try client.search(new Search().not(new Search().from("bob")))).equals([2])
			assert (try client.search(new Search().or(new Search().from("bob"), new Search().from("carol")))).equals([1, 2])
			assert (try client.search(new Search().body("hello"))).equals([1])
			assert (try client.search(new Search().text("part one"))).equals([2])
			assert (try client.search(new Search().larger(200))).equals([2])
			assert (try client.search(new Search().uids([2]))).equals([2])
			assert (try client.search(new Search().header("To", "alice"))).len() == 2
			assert (try client.search(new Search().since(time.fromUnixNs(0)))).len() == 2
			try client.close()
			try server.close()
			return none
		}

		@test()
		def reportsChangesDuringIdle() !none {
			let root = try imapTree()
			let server = try startImap(root)
			let watcher = try imapClient(server)
			try watcher.open("INBOX")
			let writer = try imapClient(server)
			let task = async appendLater(writer)
			let updates = try watcher.idle(5s)
			try await task
			assert updates.filter(u => u.kind == UpdateKind.Exists).len() >= 1
			try watcher.close()
			try writer.close()
			try server.close()
			return none
		}

		@test()
		def securesConnections() !none {
			let server = try startImap(try imapTree(), Security.StartTls)
			server.requireTls = true
			let client = try imapClient(server, Security.StartTls)
			assert client.isSecure() && !client.hasCapability("STARTTLS")
			try client.close()
			let implicit = try startImap(try imapTree(), Security.Implicit)
			let direct = try imapClient(implicit, Security.Implicit)
			assert (try direct.open("INBOX")).messages == 2
			try direct.close()
			try server.close()
			try implicit.close()
			return none
		}
	}

	internal async def appendLater(writer Client) !none {
		time.sleep(300ms)
		try writer.append("INBOX", new mail.Message().from("z@x.org").subject("late").text("x"))
		return none
	}

	check "imap protocol" {
		@test()
		def fetchesSections() !none {
			let server = try startImap(try imapTree())
			let conn = try net.dialStream(server.address().str(), 5s)
			let lines = new net.LineReader(conn, 65536)
			let ask = def (line string) !Response[] {
				try writeFully(conn, (line + "\r\n").bytes(), 5s)
				let out Response[] = []
				for {
					let r = try parseResponse(try readLogical(lines, 5s, 1 << 20, none))
					out.push(r)
					break unless r.tag == "*"
				}
				return out
			}
			try readLogical(lines, 5s, 1 << 20, none)
			assert (try ask("a LOGIN alice s3cret"))[0].status == "OK"
			let selected = try ask("b SELECT INBOX")
			assert selected[selected.len() - 1].code == "READ-WRITE"
			let header = try ask("c UID FETCH 1 (BODY.PEEK[HEADER.FIELDS (SUBJECT)])")
			let pairs = fetchPairs(header[0].items[2])
			let got = pairs.get("BODY[HEADER.FIELDS (SUBJECT)]")
			assert !(got is none) && string(got.data) == "Subject: first\r\n\r\n"
			let part = try ask("d UID FETCH 2 (BODY.PEEK[1] BINARY.PEEK[2] BODY.PEEK[1]<0.4> BODYSTRUCTURE)")
			let p = fetchPairs(part[0].items[2])
			let one = p.get("BODY[1]")
			let bin = p.get("BINARY[2]")
			let slice = p.get("BODY[1]<0>")
			let shape = p.get("BODYSTRUCTURE")
			assert !(one is none) && string(one.data) == "part one"
			assert !(bin is none) && bin.data.equals([0x00, 0x01, 0x02])
			assert !(slice is none) && string(slice.data) == "part"
			assert !(shape is none) && shape.items.len() >= 3 && shape.items[2].text.upper() == "MIXED"
			let seen = try ask("e UID FETCH 1 (BODY[TEXT])")
			let flags = fetchPairs(seen[0].items[2]).get("FLAGS")
			assert !(flags is none) && flags.items.len() == 1 && flags.items[0].text == "\\Seen"
			let rev1 = try ask("f UID SEARCH ALL")
			assert rev1[0].items[0].text == "SEARCH"
			try ask("g ENABLE IMAP4rev2")
			let rev2 = try ask("h UID SEARCH ALL")
			assert rev2[0].items[0].text == "ESEARCH"
			let saved = try ask("i UID SEARCH RETURN (SAVE) FROM bob")
			let viaSaved = try ask("j UID FETCH $ (UID)")
			assert saved[saved.len() - 1].status == "OK" && viaSaved.len() == 2
			let bad = try ask("k FETCH 9 (FLAGS)")
			assert bad[bad.len() - 1].status := "BAD" || "NO"
			let appendTag = try ask("l APPEND INBOX" + literalMarker(5, true) + "hello")
			assert appendTag[appendTag.len() - 1].code == "APPENDUID"
			try ask("m LOGOUT")
			try server.close()
			return none
		}

		@test()
		def codesNamesSetsAndLiterals() !none {
			assert encodeName("Entwürfe", false) == "Entw&APw-rfe"
			assert decodeName("Entw&APw-rfe") == "Entwürfe"
			assert encodeName("A&B", false) == "A&-B" && decodeName("A&-B") == "A&B"
			assert decodeName("&ZeVnLIqe-") == "日本語"
			assert formatSet([5, 1, 2, 3, 9]) == "1:3,5,9"
			assert (try parseSet("1:3,7", 10)).equals([1, 2, 3, 7])
			assert (try parseSet("8:*", 10)).equals([8, 9, 10])
			let r = try parseResponse(("* 1 FETCH (BODY[]" + literalMarker(5, false) + "hello UID 7)").bytes())
			let pairs = fetchPairs(r.items[2])
			let body = pairs.get("BODY[]")
			assert !(body is none) && string(body.data) == "hello" && numberOf(r.items[0]) == 1
			let ok = try parseResponse("a1 OK [APPENDUID 38505 3955] APPEND completed".bytes())
			assert ok.status == "OK" && ok.code == "APPENDUID" && ok.codeArgs.len() == 2 && ok.text == "APPEND completed"
			let pieces = chunks(("a APPEND x" + literalMarker(3, false) + "abc\r\n").bytes(), false)
			assert pieces.len() == 2 && pieces[0].wait && string(pieces[1].data) == "abc\r\n"
			let fast = chunks(("a APPEND x" + literalMarker(3, false) + "abc\r\n").bytes(), true)
			assert fast.len() == 1 && string(fast[0].data) == "a APPEND x" + literalMarker(3, true) + "abc\r\n"
			assert wildcardMatch("*", "Work.Clients", ".") && wildcardMatch("%", "Work", ".") && !wildcardMatch("%", "Work.Clients", ".")
			assert new Search().unseen().from("bob").str() == "UNSEEN FROM \"bob\""
			assert new Search().or(new Search().flagged("\\Seen"), new Search().flagged("$Junk")).str() == "OR (SEEN) (KEYWORD $Junk)"
			assert (try parseDateTime("17-Jul-1996 02:44:25 -0700")).hour() == 9
			return none
		}
	}
}
