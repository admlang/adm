partial module std.net.mail.imap {
	use (
		std.formats.mail::(Maildir)
		std.net.mail.imap.proto::*
		std.os
	)

	// MaildirAccount serves a Maildir++ tree as an IMAP account: the root
	// folder is INBOX, subfolders are mailboxes with `.` between levels,
	// and `Sent`, `Drafts`, `Trash`, `Junk` and `Archive` carry their
	// special-use attributes. UIDs, modification sequences and keywords
	// live in files beside each folder (`adm-imap-uidlist`,
	// `adm-imap-keywords`); subscriptions in `subscriptions`, as Dovecot
	// keeps them. Sessions of one process see each other's changes; other
	// programs writing the tree are picked up as new or gone messages.
	//
	// ```
	// def login(user string, password Secret<string>) !imap.Account {
	//     try check(user, password)
	//     return new imap.MaildirAccount(new mail.Maildir("/var/mail/" + user))
	// }
	// ```
	type MaildirAccount {
		root Maildir

		def new(root Maildir) {
			self.root = root
		}

		// Implements `Account`. Fails when the tree cannot be read.
		def mailboxes() !Mailbox[] {
			let out Mailbox[] = [Mailbox{name:"INBOX", delimiter:".", attributes:[]}]
			for let name in try root.folders() {
				let special string[] = []
				let specialUse = specialUseOf(name)
				special.push(specialUse) unless specialUse == ""
				out.push(Mailbox{name: name, delimiter: ".", attributes: special})
			}
			return out
		}

		// Implements `Account`. Fails with NONEXISTENT when there is no such
		// mailbox.
		def open(name string) !Folder {
			let dir = name.upper() == "INBOX" ?? (root, root.folder(name))
			let there = os.exists(os.join(dir.path, "cur")) onerror recover false
			fail ImapError{message: "imap: no mailbox " + name, code: "NONEXISTENT", status: "NO", response: "NONEXISTENT", text: "No such mailbox"} unless there
			return new MaildirFolder(dir)
		}

		// Implements `Account`. Fails with ALREADYEXISTS when it exists.
		def create(name string) !none {
			let there = os.exists(root.folder(name).path) onerror recover false
			fail ImapError{message: "imap: mailbox exists " + name, code: "ALREADYEXISTS", status: "NO", response: "ALREADYEXISTS", text: "Mailbox already exists"} when there || name.upper() == "INBOX"
			try root.createFolder(name)
			return none
		}

		// Implements `Account`. Fails with NONEXISTENT when there is no such
		// mailbox.
		def delete(name string) !none {
			root.removeFolder(name) onerror (err error) {
				fail ImapError{message: "imap: no mailbox " + name, code: "NONEXISTENT", status: "NO", response: "NONEXISTENT", text: "No such mailbox"}
			}
			return none
		}

		// Implements `Account`. Fails when `from` does not exist or `to`
		// does.
		def rename(from string, to string) !none {
			return try root.renameFolder(from, to)
		}

		// Implements `Account`.
		def subscriptions() string[] {
			let raw = os.readFile(os.join(root.path, "subscriptions")) onerror recover []
			let out string[] = []
			for let line in string(raw).split("\n") {
				out.push(line.trim()) unless line.trim() == ""
			}
			return out
		}

		// Implements `Account`: keeps the list in `subscriptions`.
		def subscribe(name string, subscribed bool) {
			let list = subscriptions().filter(n => n != name)
			list.push(name) when subscribed
			os.writeFile(os.join(root.path, "subscriptions"), (list.join("\n") + "\n").bytes()) onerror recover none
		}
	}
}
