internal partial module std.net.mail.imap.proto {
	use (
		std.formats
		std.formats.mail
		std.formats::(MediaType)
	)

	// Entity is one MIME entity of a stored message as raw bytes: its
	// header block (with the blank line), its body, and for a multipart or
	// `message/rfc822` entity the entities inside.
	type Entity {
		header byte[]
		body   byte[]
		parts  Entity[]    = []
		// The `message/rfc822` message this entity carries, when it does.
		inner  ?Entity     = none
		fields mail.Header

		def new(header byte[], body byte[], fields mail.Header) {
			self.header = header
			self.body = body
			self.fields = fields
		}

		def contentType() MediaType {
			let raw = fields.raw("Content-Type")
			let fallback = new MediaType("text", "plain", map<string, string>{"charset": "us-ascii"})
			return fallback when raw is none
			let parsed = formats.parseMediaType(raw) onerror recover fallback
			return parsed.subtype == "" ?? (fallback, parsed)
		}
	}

	// entityOf splits raw bytes into an entity tree, 50 levels at most.
	def entityOf(data byte[], depth int) Entity {
		let end = rawHeaderEnd(data)
		let header = data.slice(0, end)
		let body = data.slice(end, data.len() - end)
		let parsed = mail.parse(header.len() == 0 ?? ("\r\n".bytes(), header)) onerror recover new mail.Message()
		let fields = new mail.Header()
		for let name in parsed.header.names() {
			for let v in rawValues(parsed.header, name) {
				fields.add(name, v)
			}
		}
		for let name in parsed.body.header.names() {
			for let v in rawValues(parsed.body.header, name) {
				fields.add(name, v)
			}
		}
		let e = new Entity(header, body, fields)
		return e when depth >= 50
		let media = e.contentType()
		let boundary = media.boundary()
		if media.mainType == "multipart" && !(boundary is none) && boundary != "" {
			for let part in rawParts(body, boundary) {
				e.parts.push(entityOf(part, depth + 1))
			}
		} else if media.essence() == "message/rfc822" || media.essence() == "message/global" {
			e.inner = entityOf(body, depth + 1)
		}
		return e
	}

	// rawValues is every raw value of `name` in a header.
	def rawValues(h mail.Header, name string) string[] {
		let out string[] = []
		let first = h.raw(name)
		return out when first is none
		// Header has no raw form of every value; the decoded ones stand in
		// for repeats, which the protocol reads only for trace fields.
		out.push(first)
		let all = h.values(name)
		for let i = 1; i < all.len(); i++ {
			out.push(all[i])
		}
		return out
	}

	// rawHeaderEnd is the offset after the blank line ending the header
	// block, 0 when the entity starts with it, the length when there is
	// none.
	def rawHeaderEnd(data byte[]) int {
		return 2 when data.len() >= 2 && data[0] == 0x0D && data[1] == 0x0A
		return 1 when data.len() >= 1 && data[0] == 0x0A
		for let i = 0; i < data.len(); i++ {
			continue unless data[i] == 0x0A
			return i + 2 when i + 1 < data.len() && data[i + 1] == 0x0A
			return i + 3 when i + 2 < data.len() && data[i + 1] == 0x0D && data[i + 2] == 0x0A
		}
		return data.len()
	}

	// rawParts cuts a multipart body at its delimiters, as stored.
	def rawParts(body byte[], boundary string) byte[][] {
		let delimiter = ("--" + boundary).bytes()
		let out byte[][] = []
		let start = -1
		let lineStart = 0
		for lineStart <= body.len() {
			let lineEnd = lineStart
			for lineEnd < body.len() && body[lineEnd] != 0x0A {
				lineEnd++
			}
			let kind = delimiterAt(body, lineStart, lineEnd, delimiter)
			if kind > 0 {
				if start >= 0 {
					let end = lineStart
					end-- when end > start && body[end - 1] == 0x0A
					end-- when end > start && body[end - 1] == 0x0D
					out.push(body.slice(start, end - start))
				}
				return out when kind == 2
				start = lineEnd + 1
			}
			lineStart = lineEnd + 1
		}
		out.push(body.slice(start, body.len() - start)) when start >= 0 && start <= body.len()
		return out
	}

	def delimiterAt(body byte[], from int, to int, delimiter byte[]) int {
		return 0 when to - from < delimiter.len()
		for let i = 0; i < delimiter.len(); i++ {
			return 0 when body[from + i] != delimiter[i]
		}
		let i = from + delimiter.len()
		let closing = i + 1 < to && body[i] == 0x2D && body[i + 1] == 0x2D
		i += closing ?? (2, 0)
		for i < to {
			return 0 unless body[i] := 0x20 || 0x09 || 0x0D
			i++
		}
		return closing ?? (2, 1)
	}

	// lineCount is the number of lines of text.
	def lineCount(data byte[]) int {
		let n = 0
		for let b in data {
			n++ when b == 0x0A
		}
		n++ when data.len() > 0 && data[data.len() - 1] != 0x0A
		return n
	}

	// ---- sections (RFC 9051 §6.4.5) ------------------------------------------

	// Section is a parsed `BODY[...]` spec: the part path, the kind
	// (`""`, `HEADER`, `HEADER.FIELDS`, `HEADER.FIELDS.NOT`, `TEXT`, `MIME`)
	// and the field names of HEADER.FIELDS.
	struct Section {
		path   int[]
		kind   string
		fields string[]
	}

	// parseSection reads the text between `[` and `]`. Fails on a
	// malformed spec.
	def parseSection(text string) !Section {
		let s = Section{path: [], kind: "", fields: []}
		let rest = text.trim()
		let open = rest.indexOf("(")
		let head = open < 0 ?? (rest, rest[:open].trim())
		if open >= 0 {
			let close = rest.indexOf(")", open)
			fail protocolError("bad section {text}") when close < 0
			for let f in rest[open + 1:close].split(" ") {
				s.fields.push(f.trim().trimPrefix("\"").trimSuffix("\"").lower()) unless f.trim() == ""
			}
		}
		let words string[] = head == "" ?? ([], head.split("."))
		let i = 0
		for i < words.len() && words[i].isNumeric() {
			s.path.push(words[i].toInt<int>())
			i++
		}
		s.kind = words[i:].join(".").upper()
		fail protocolError("bad section {text}") unless s.kind := "" || "HEADER" || "HEADER.FIELDS" || "HEADER.FIELDS.NOT" || "TEXT" || "MIME"
		fail protocolError("MIME needs a part number") when s.kind == "MIME" && s.path.len() == 0
		return s
	}

	// sectionBytes is the bytes a section names in a message, empty when
	// the part does not exist.
	def sectionBytes(root Entity, whole byte[], s Section) byte[] {
		let e = root
		for let n in s.path {
			// A message/rfc822 part numbers the parts of the message it
			// carries.
			let inner = e.inner
			let host = inner is none ?? (e, inner)
			if host.parts.len() == 0 {
				// A non-multipart entity has only part 1: itself.
				return [] unless n == 1
				e = host
				continue
			}
			return [] when n < 1 || n > host.parts.len()
			e = host.parts[n - 1]
		}
		let atRoot = s.path.len() == 0
		match s.kind {
			case "":
				return atRoot ?? (whole, e.body)
			case "MIME":
				return e.header
			case "TEXT":
				let inner = e.inner
				return atRoot ?? (root.body, inner is none ?? (e.body, inner.body))
			case "HEADER":
				let inner = e.inner
				return atRoot ?? (root.header, inner is none ?? (e.header, inner.header))
		}
		let inner = e.inner
		let target = atRoot ?? (root, inner is none ?? (e, inner))
		return selectFields(target.header, s.fields, s.kind == "HEADER.FIELDS")
	}

	// selectFields keeps (or with `keep` false drops) the named fields of
	// a header block, folded lines included, and ends it with a blank line.
	def selectFields(header byte[], names string[], keep bool) byte[] {
		let out byte[] = []
		let taking = false
		let lineStart = 0
		for lineStart < header.len() {
			let end = lineStart
			for end < header.len() && header[end] != 0x0A {
				end++
			}
			let line = header.slice(lineStart, end + 1 > header.len() ?? (header.len() - lineStart, end + 1 - lineStart))
			let text = string(line)
			if text.trim() == "" {
				break
			}
			if !(line[0] := 0x20 || 0x09) {
				let colon = text.indexOf(":")
				let name = colon < 0 ?? ("", text[:colon].trim().lower())
				taking = (names.indexOf(name) >= 0) == keep
			}
			out = out + line when taking
			lineStart = end + 1
		}
		return out + "\r\n".bytes()
	}

	// ---- ENVELOPE and BODYSTRUCTURE -------------------------------------------

	// nstring writes text as a quoted string or literal, NIL when empty.
	def nstring(text string) string {
		return "NIL" when text == ""
		return quotedArgument(text, true)
	}

	// envelopeOf writes the ENVELOPE of an entity's header (RFC 9051
	// §7.5.2).
	def envelopeOf(h mail.Header) string {
		let from = addressList(h, "From")
		let sender = addressList(h, "Sender")
		let replyTo = addressList(h, "Reply-To")
		sender = from when sender == "NIL"
		replyTo = from when replyTo == "NIL"
		let parts = [
			nstring(orEmpty(h.raw("Date"))),
			nstring(orEmpty(h.raw("Subject"))),
			from, sender, replyTo,
			addressList(h, "To"),
			addressList(h, "Cc"),
			addressList(h, "Bcc"),
			nstring(orEmpty(h.raw("In-Reply-To"))),
			nstring(orEmpty(h.raw("Message-ID"))),
		]
		return "(" + parts.join(" ") + ")"
	}

	def orEmpty(text ?string) string {
		return "" when text is none
		return text.trim()
	}

	// addressList writes the addresses of a field as `((name NIL box
	// host) ...)`, NIL when there are none.
	def addressList(h mail.Header, field string) string {
		let list = h.addresses(field) onerror recover []
		return "NIL" when list.len() == 0
		let out string[] = []
		for let a in list {
			out.push("(" + nstring(a.name) + " NIL " + nstring(a.localPart()) + " " + nstring(a.domain()) + ")")
		}
		return "(" + out.join("") + ")"
	}

	// bodyStructure writes the BODYSTRUCTURE of an entity; `extended`
	// adds the extension data BODY leaves out.
	def bodyStructure(e Entity, extended bool) string {
		let media = e.contentType()
		if media.mainType == "multipart" && e.parts.len() > 0 {
			let out = "("
			for let p in e.parts {
				out += bodyStructure(p, extended)
			}
			out += " " + quote(media.subtype.upper())
			out += " " + paramList(media) + " " + dispositionOf(e.fields) + " " + extensionTail(e) when extended
			return out + ")"
		}
		let encodingName = orEmpty(e.fields.raw("Content-Transfer-Encoding")).upper()
		encodingName = "7BIT" when encodingName == ""
		let out = "(" + quote(media.mainType.upper()) + " " + quote(media.subtype.upper()) + " " + paramList(media)
		out += " " + nstring(orEmpty(e.fields.raw("Content-ID"))) + " " + nstring(orEmpty(e.fields.raw("Content-Description")))
		out += " " + quote(encodingName) + " {e.body.len()}"
		let inner = e.inner
		if !(inner is none) {
			out += " " + envelopeOf(inner.fields) + " " + bodyStructure(inner, extended) + " {lineCount(e.body)}"
		} else if media.mainType == "text" {
			out += " {lineCount(e.body)}"
		}
		out += " NIL " + dispositionOf(e.fields) + " " + extensionTail(e) when extended
		return out + ")"
	}

	// extensionTail is the language and location of the extension data.
	def extensionTail(e Entity) string {
		return nstring(orEmpty(e.fields.raw("Content-Language"))) + " " + nstring(orEmpty(e.fields.raw("Content-Location")))
	}

	// paramList writes the parameters of a media type, NIL when none.
	def paramList(media MediaType) string {
		let out string[] = []
		for let (name, value) in media.params {
			out.push(quote(name.upper()) + " " + quotedArgument(value, true))
		}
		return out.len() == 0 ?? ("NIL", "(" + out.join(" ") + ")")
	}

	// dispositionOf writes `("ATTACHMENT" ("FILENAME" "x"))` or NIL.
	def dispositionOf(h mail.Header) string {
		let raw = h.raw("Content-Disposition")
		return "NIL" when raw is none
		let parsed = formats.parseMediaType(raw) onerror recover new MediaType("", "")
		return "NIL" when parsed.mainType == ""
		return "(" + quote(parsed.mainType.upper()) + " " + paramList(parsed) + ")"
	}
}
