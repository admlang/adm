internal partial module std.net.mail.imap.proto {
	use (
		std.bytes
		std.data.encoding
		std.net
		std.net.mail.imap::*
		std.net.mail.wire::*
		std.time
		std.time::(Time)
	)

	// ItemKind is the kind of one token of an IMAP line.
	enum ItemKind {
		// An atom, number or flag (`FLAGS`, `42`, `\Seen`,
		// `BODY[HEADER.FIELDS (DATE)]<0.100>`).
		Atom,
		// A quoted string or a literal; `data` holds its bytes.
		Text,
		Nil,
		// A parenthesised list.
		List,
	}

	// Item is one token of an IMAP line.
	struct Item {
		kind  ItemKind
		text  string
		data  byte[]
		items Item[]
	}

	def atom(text string) Item {
		return Item{kind: ItemKind.Atom, text: text, data: [], items: []}
	}

	def textItem(data byte[]) Item {
		return Item{kind: ItemKind.Text, text: string(data), data: data, items: []}
	}

	def nilItem() Item {
		return Item{kind: ItemKind.Nil, text: "", data: [], items: []}
	}

	def listItem(items Item[]) Item {
		return Item{kind: ItemKind.List, text: "", data: [], items: items}
	}

	// isNumber reports an atom made of digits.
	def isNumber(item Item) bool {
		return item.kind == ItemKind.Atom && item.text != "" && item.text.isNumeric()
	}

	// numberOf is an atom's value, 0 when it is not a number.
	def numberOf(item Item) int64 {
		return isNumber(item) ?? (item.text.toInt<int64>(), int64(0))
	}

	// textOf is the text of an atom or string, empty for NIL and lists.
	def textOf(item Item) string {
		return (item.kind := ItemKind.Atom || ItemKind.Text) ?? (item.text, "")
	}

	// ---- reading ---------------------------------------------------------------

	// literalAt reads a literal marker (`{n}`, `{n+}`, `{n-}`, `~{n}`) at the
	// end of a line: its size and whether it is non-synchronizing; -1 when
	// the line does not end in one.
	def literalAt(line string) (int64, bool) {
		return (-1, false) unless line.endsWith("}")
		let open = -1
		for let i = line.len() - 1; i >= 0; i-- {
			if line[i] == '{' {
				open = i
				break
			}
		}
		return (-1, false) when open < 0
		let inner = line[open + 1:line.len() - 1]
		let fast = inner.endsWith("+") || inner.endsWith("-")
		let digits = fast ?? (inner[:inner.len() - 1], inner)
		return (-1, false) unless digits != "" && digits.isNumeric() && digits.len() <= 18
		return (digits.toInt<int64>(), fast)
	}

	// readLogical reads one logical line: the text up to CRLF, and every
	// literal it announces with the lines after it, kept inline as
	// `{n}CRLF` and the bytes. `ready` is called before a synchronizing
	// literal is read (the server's `+ Ready`); it fails to refuse one.
	// Fails when the stream fails or a literal passes `limit` bytes.
	def readLogical(lines net.LineReader, timeout duration, limit int64, ready ?def (size int64) !none) !byte[] {
		let out = new bytes.Buffer()
		for {
			let line = try lines.readLine(timeout)
			try out.write(line.bytes())
			let (size, fast) = literalAt(line)
			break when size < 0
			fail protocolError("literal of {size} bytes passes the limit of {limit}") when size > limit
			if !fast && !(ready is none) {
				try ready(size)
			}
			try out.write("\r\n".bytes())
			try out.write(try lines.readBytes(int(size), timeout))
		}
		return out.bytes()
	}

	// Scanner walks the bytes of a logical line.
	type Scanner {
		data byte[]
		at   int    = 0

		def new(data byte[]) {
			self.data = data
		}

		def atEnd() bool {
			return at >= data.len()
		}

		def peek() int {
			return at < data.len() ?? (int(data[at]), -1)
		}

		def skipSpaces() {
			for at < data.len() && data[at] == 0x20 {
				at++
			}
		}

		// word reads bytes up to the next space or the end.
		def word() string {
			let start = at
			for at < data.len() && data[at] != 0x20 {
				at++
			}
			return string(data.slice(start, at - start))
		}

		// rest is everything left, as text.
		def rest() string {
			let text = string(data.slice(at, data.len() - at))
			at = data.len()
			return text
		}

		// items reads tokens until the end or a closing parenthesis.
		def items() !Item[] {
			let out Item[] = []
			for {
				skipSpaces()
				break when atEnd() || peek() == 0x29
				out.push(try item())
			}
			return out
		}

		// item reads one token.
		def item() !Item {
			let c = peek()
			if c == 0x28 {
				at++
				let inner = try items()
				fail protocolError("unclosed list") unless peek() == 0x29
				at++
				return listItem(inner)
			}
			return textItem(try quoted()) when c == 0x22
			return textItem(try literal()) when c == 0x7B || (c == 0x7E && at + 1 < data.len() && data[at + 1] == 0x7B)
			return try atomItem()
		}

		internal def quoted() !byte[] {
			at++
			let out byte[] = []
			for {
				fail protocolError("unterminated quoted string") when atEnd()
				let b = data[at]
				at++
				return out when b == 0x22
				if b == 0x5C && at < data.len() {
					out.push(data[at])
					at++
					continue
				}
				out.push(b)
			}
			return out
		}

		internal def literal() !byte[] {
			at++ when data[at] == 0x7E
			let close = at
			for close < data.len() && data[close] != 0x7D {
				close++
			}
			fail protocolError("unterminated literal") when close >= data.len()
			let inner = string(data.slice(at + 1, close - at - 1)).trimSuffix("+").trimSuffix("-")
			fail protocolError("bad literal size") unless inner.isNumeric()
			let size = inner.toInt<int>()
			let start = close + 3
			fail protocolError("literal cut short") when start + size > data.len()
			at = start + size
			return data.slice(start, size)
		}

		// atomItem reads an atom; a `[` inside it runs to the matching `]`
		// (sections, response codes), and `<...>` after it is kept.
		internal def atomItem() !Item {
			let start = at
			let depth = 0
			for at < data.len() {
				let b = data[at]
				if depth > 0 {
					depth++ when b == 0x5B
					depth-- when b == 0x5D
					at++
					continue
				}
				if b == 0x5B {
					depth = 1
					at++
					continue
				}
				break when b := 0x20 || 0x28 || 0x29 || 0x22 || 0x7B || 0x0D || 0x0A || 0x5D
				at++
			}
			fail protocolError("empty atom at byte {start}") when at == start
			let text = string(data.slice(start, at - start))
			return text.upper() == "NIL" ?? (nilItem(), atom(text))
		}
	}

	// Response is one line a server sent: tagged (`tag`), untagged (`*`)
	// or a continuation (`+`). A status response (OK, NO, BAD, BYE,
	// PREAUTH) has `status`, its response code and text; other untagged
	// data has its items (`3`, `FETCH`, `(...)`).
	struct Response {
		tag      string
		status   string
		code     string
		codeArgs Item[]
		text     string
		items    Item[]
	}

	// parseResponse reads a server line.
	def parseResponse(line byte[]) !Response {
		let s = new Scanner(line)
		let tag = s.word()
		fail protocolError("empty response") when tag == ""
		let r = Response{tag: tag, status: "", code: "", codeArgs: [], text: "", items: []}
		s.skipSpaces()
		if tag == "+" {
			r.text = s.rest()
			return r
		}
		let save = s.at
		let head = s.word().upper()
		if head := "OK" || "NO" || "BAD" || "BYE" || "PREAUTH" {
			r.status = head
			s.skipSpaces()
			try readCode(s, r)
			r.text = s.rest()
			return r
		}
		s.at = save
		r.items = try s.items()
		return r
	}

	// readCode reads `[CODE args]` at the scanner into a response.
	def readCode(s Scanner, r Response) !none {
		return none unless s.peek() == 0x5B
		s.at++
		let start = s.at
		for !s.atEnd() && s.peek() != 0x20 && s.peek() != 0x5D {
			s.at++
		}
		r.code = string(s.data.slice(start, s.at - start)).upper()
		s.skipSpaces()
		let args Item[] = []
		for !s.atEnd() && s.peek() != 0x5D {
			args.push(try s.item())
			s.skipSpaces()
		}
		fail protocolError("unclosed response code") when s.atEnd()
		s.at++
		s.skipSpaces()
		r.codeArgs = args
		return none
	}

	// ---- writing ---------------------------------------------------------------

	// isAtomText reports text that can be sent as an atom.
	def isAtomText(text string) bool {
		return false when text == ""
		for let b in text.bytes() {
			return false when b <= 0x20 || b >= 0x7F || (b := 0x28 || 0x29 || 0x7B || 0x25 || 0x2A || 0x22 || 0x5C || 0x5D)
		}
		return true
	}

	// quote is text as a quoted string.
	def quote(text string) string {
		return "\"" + text.replace("\\", "\\\\").replace("\"", "\\\"") + "\""
	}

	// Chunk is a piece of a command: bytes to send and, for a
	// synchronizing literal, whether to wait for the server's `+` after it.
	struct Chunk {
		data byte[]
		wait bool
	}

	// argument writes a string argument: an atom when it can be one, a
	// quoted string when it holds no line break (nor 8-bit text without
	// `utf8`), else a literal (inline, split by `chunks`).
	def argument(value string, utf8 bool) string {
		return value when isAtomText(value) && value.upper() != "NIL"
		return quotedArgument(value, utf8)
	}

	// quotedArgument is `argument` without the atom form.
	def quotedArgument(value string, utf8 bool) string {
		let plain = true
		for let b in value.bytes() {
			plain = false when (b := 0x0D || 0x0A || 0x00) || (b >= 0x80 && !utf8)
		}
		return quote(value) when plain && value.len() < 4096
		return literalMarker(value.bytes().len(), false).trimPrefix(" ") + value
	}

	// chunks cuts a command line (with its CRLF) at the literals it holds:
	// with `fast` each marker becomes non-synchronizing and the line goes
	// in one piece, else each piece up to a marker waits for `+`.
	def chunks(line byte[], fast bool) Chunk[] {
		let out Chunk[] = []
		let piece byte[] = []
		let i = 0
		for i < line.len() {
			let b = line[i]
			if b == 0x7B {
				let close = i + 1
				for close < line.len() && line[close] >= 0x30 && line[close] <= 0x39 {
					close++
				}
				if close > i + 1 && close + 2 < line.len() && line[close] == 0x7D && line[close + 1] == 0x0D && line[close + 2] == 0x0A {
					let size = string(line.slice(i + 1, close - i - 1)).toInt<int>()
					piece = piece + line.slice(i, close - i)
					piece.push(0x2B) when fast
					piece = piece + [byte(0x7D), byte(0x0D), byte(0x0A)]
					if !fast {
						out.push(Chunk{data: piece, wait: true})
						piece = []
					}
					piece = piece + line.slice(close + 3, size)
					i = close + 3 + size
					continue
				}
			}
			piece.push(b)
			i++
		}
		out.push(Chunk{data: piece, wait: false})
		return out
	}

	// literalMarker is ` {n}` or ` {n+}` and CRLF.
	def literalMarker(size int, fast bool) string {
		let open = string(char(0x7B))
		let close = string(char(0x7D))
		return " " + open + "{size}" + (fast ?? ("+", "")) + close + "\r\n"
	}

	// ---- sets, dates, names ---------------------------------------------------

	// formatSet writes numbers as a sequence set, runs as `a:b`.
	def formatSet(values int64[]) string {
		let sorted = values.clone()
		sorted.sort((a, b) => a < b)
		let parts string[] = []
		let i = 0
		for i < sorted.len() {
			let start = sorted[i]
			let end = start
			for i + 1 < sorted.len() && (sorted[i + 1] == end + 1 || sorted[i + 1] == end) {
				i++
				end = sorted[i]
			}
			parts.push(start == end ?? ("{start}", "{start}:{end}"))
			i++
		}
		return parts.join(",")
	}

	// parseSet reads a sequence set into its numbers, `*` standing for
	// `largest`. Fails on a malformed set.
	def parseSet(text string, largest int64) !int64[] {
		let out int64[] = []
		for let part in text.split(",") {
			let colon = part.indexOf(":")
			let a = try setNumber(colon < 0 ?? (part, part[:colon]), largest)
			let b = colon < 0 ?? (a, try setNumber(part[colon + 1:], largest))
			let low = a < b ?? (a, b)
			let high = a < b ?? (b, a)
			fail protocolError("sequence set too large") when high - low > 10000000
			for let n = low; n <= high; n++ {
				out.push(n) when n > 0
			}
		}
		return out
	}

	def setNumber(text string, largest int64) !int64 {
		return largest when text == "*"
		fail protocolError("bad sequence set") unless text != "" && text.isNumeric() && text.len() <= 18
		return text.toInt<int64>()
	}

	// Range is one `a:b` piece of a sequence set, low to high.
	struct Range {
		low  int64
		high int64
	}

	// parseRanges reads a sequence set as ranges, `*` standing for
	// `largest`, without expanding them. Fails on a malformed set.
	def parseRanges(text string, largest int64) !Range[] {
		let out Range[] = []
		for let part in text.split(",") {
			let colon = part.indexOf(":")
			let a = try setNumber(colon < 0 ?? (part, part[:colon]), largest)
			let b = colon < 0 ?? (a, try setNumber(part[colon + 1:], largest))
			out.push(Range{low: a < b ?? (a, b), high: a < b ?? (b, a)})
		}
		return out
	}

	// inRanges reports whether `n` falls in one of the ranges.
	def inRanges(ranges Range[], n int64) bool {
		for let r in ranges {
			return true when n >= r.low && n <= r.high
		}
		return false
	}

	let months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]

	def two(n int) string {
		return n < 10 ?? ("0{n}", "{n}")
	}

	// formatDateTime writes an IMAP date-time (`01-Jan-2026 10:00:00
	// +0000`) in UTC.
	def formatDateTime(t Time) string {
		let day = t.day() < 10 ?? (" {t.day()}", "{t.day()}")
		return "{day}-{months[t.month() - 1]}-{t.year()} {two(t.hour())}:{two(t.minute())}:{two(t.second())} +0000"
	}

	// formatDate writes an IMAP date (`1-Jan-2026`) for SEARCH.
	def formatDate(t Time) string {
		return "{t.day()}-{months[t.month() - 1]}-{t.year()}"
	}

	// parseDateTime reads an IMAP date-time. Fails when it is not one.
	def parseDateTime(text string) !Time {
		let s = text.trim()
		let space = s.indexOf(" ")
		fail protocolError("bad date-time {text}") when space < 0
		let date = try dayOf(s[:space])
		return try time.parseMailDate("{date.day()} {months[date.month() - 1]} {date.year()} {s[space + 1:].trim()}")
	}

	// dayOf reads `d-Mon-yyyy` as midnight UTC. Fails when it is not one.
	def dayOf(text string) !Time {
		let parts = text.trim().trimPrefix("\"").trimSuffix("\"").split("-")
		fail protocolError("bad date {text}") unless parts.len() == 3 && parts[0].trim().isNumeric() && parts[2].isNumeric()
		let month = months.indexOf(parts[1].capitalize())
		fail protocolError("bad date {text}") when month < 0
		return try time.parse("{parts[2]}-{two(month + 1)}-{two(parts[0].trim().toInt<int>())}T00:00:00Z")
	}

	// encodeName writes a mailbox name in modified UTF-7 (RFC 3501 §5.1.3)
	// unless `utf8` allows it as is.
	def encodeName(name string, utf8 bool) string {
		return name when utf8
		let out = ""
		let pending string = ""
		for let c in name {
			let code = int(c)
			if code >= 0x20 && code <= 0x7E {
				if pending != "" {
					out += "&" + modifiedBase64(pending) + "-"
					pending = ""
				}
				out += c == '&' ?? ("&-", string(c))
				continue
			}
			pending += string(c)
		}
		out += "&" + modifiedBase64(pending) + "-" when pending != ""
		return out
	}

	// modifiedBase64 is text as UTF-16BE in base64 with `,` for `/` and no
	// padding.
	def modifiedBase64(text string) string {
		let raw byte[] = []
		for let c in text {
			let code = int(c)
			if code > 0xFFFF {
				let v = code - 0x10000
				let high = 0xD800 + (v >> 10)
				let low = 0xDC00 + (v & 0x3FF)
				raw.push(byte(high >> 8))
				raw.push(byte(high & 0xFF))
				raw.push(byte(low >> 8))
				raw.push(byte(low & 0xFF))
				continue
			}
			raw.push(byte(code >> 8))
			raw.push(byte(code & 0xFF))
		}
		return encoding.base64encode(raw).trimEnd("=").replace("/", ",")
	}

	// decodeName reads a modified UTF-7 mailbox name; text that is not
	// valid modified UTF-7 is kept as is.
	def decodeName(name string) string {
		return name unless name.contains("&")
		let out = ""
		let i = 0
		for i < name.len() {
			let c = name[i]
			if c != '&' {
				out += string(c)
				i++
				continue
			}
			let end = name.indexOf("-", i)
			return name when end < 0
			if end == i + 1 {
				out += "&"
				i = end + 1
				continue
			}
			let b64 = name[i + 1:end].replace(",", "/")
			for b64.len() % 4 != 0 {
				b64 += "="
			}
			let raw = encoding.base64decode(b64) onerror recover []
			return name when raw.len() == 0 || raw.len() % 2 != 0
			let units int[] = []
			for let k = 0; k + 1 < raw.len(); k += 2 {
				units.push(int(raw[k]) * 256 + int(raw[k + 1]))
			}
			let k = 0
			for k < units.len() {
				let u = units[k]
				if u >= 0xD800 && u <= 0xDBFF && k + 1 < units.len() {
					out += string(char(0x10000 + ((u - 0xD800) << 10) + (units[k + 1] - 0xDC00)))
					k += 2
					continue
				}
				out += string(char(u))
				k++
			}
			i = end + 1
		}
		return out
	}

	// ---- fetch responses ---------------------------------------------------

	// fetchPairs reads the `(KEY value ...)` list of a FETCH response into
	// upper-cased keys and their items.
	def fetchPairs(list Item) map<string, Item> {
		let out = map<string, Item>{}
		for let i = 0; i + 1 < list.items.len(); i += 2 {
			out[list.items[i].text.upper()] = list.items[i + 1]
		}
		return out
	}

	// addressesOf reads an envelope address list as `Name <box@host>` or
	// `box@host`; group markers are skipped.
	def addressesOf(item Item) string[] {
		let out string[] = []
		return out unless item.kind == ItemKind.List
		for let a in item.items {
			continue unless a.kind == ItemKind.List && a.items.len() == 4
			let box = textOf(a.items[2])
			let host = textOf(a.items[3])
			continue when a.items[3].kind == ItemKind.Nil
			let name = decodeWordsOf(textOf(a.items[0]))
			let address = box + "@" + host
			out.push(name == "" ?? (address, name + " <" + address + ">"))
		}
		return out
	}

	// decodeWordsOf undoes RFC 2047 words, keeping text that does not
	// decode.
	def decodeWordsOf(text string) string {
		return text unless text.contains("=?")
		return encoding.decodeWords(text) onerror recover text
	}

	// ---- errors ------------------------------------------------------------------

	// statusError is the ImapError of a NO, BAD or BYE answering `op`.
	def statusError(op string, r Response) ImapError {
		let shown = r.code == "" ?? (r.text, "[{r.code}] {r.text}")
		return ImapError{message: "imap: {op}: {r.status} {shown}", code: r.code == "" ?? (r.status, r.code), status: r.status, response: r.code, text: r.text}
	}

	// protocolError is the ImapError of something that breaks the protocol.
	def protocolError(message string) ImapError {
		return ImapError{message: "imap: " + message, code: "PROTOCOL", status: "", response: "", text: message}
	}
}
