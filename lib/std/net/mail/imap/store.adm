internal partial module std.net.mail.imap.proto {
	use (
		std.formats.mail::(Maildir, MaildirEntry)
		std.net.mail.imap::*
		std.os
		std.time
		std.time::(Time)
	)

	// specialUseOf is the RFC 6154 attribute a folder name suggests.
	def specialUseOf(name string) string {
		match name.lower() {
			case "sent", "sent messages", "sent items":
				return "\\Sent"
			case "drafts":
				return "\\Drafts"
			case "trash", "deleted messages":
				return "\\Trash"
			case "junk", "spam":
				return "\\Junk"
			case "archive":
				return "\\Archive"
		}
		return ""
	}

	// FolderLocks serialize the changes sessions of this process make to
	// one folder's UID list.
	type FolderLocks {
		held string[] = []

		def new() {}

		atomic def take(path string) bool {
			return false when held.indexOf(path) >= 0
			held.push(path)
			return true
		}

		atomic def give(path string) {
			let at = held.indexOf(path)
			held.remove(at) when at >= 0
		}
	}

	let folderLocks = new FolderLocks()

	// UidList is a folder's UID state: validity, next UID, highest
	// modification sequence, and per Maildir key its UID and modseq.
	type UidList {
		validity int64              = 0
		next     int64              = 1
		modSeq   int64              = 1
		uids     map<string, int64>
		mods     map<string, int64>

		def new() {
			uids = map<string, int64>{}
			mods = map<string, int64>{}
		}
	}

	// MaildirFolder is one Maildir served as an IMAP `Folder`.
	type MaildirFolder {
		dir Maildir

		def new(dir Maildir) {
			self.dir = dir
		}

		def status() !MailboxStatus {
			let list = try messages()
			let state = try withLock(def (s UidList, entries MaildirEntry[]) !bool {
				return false
			})
			let unseen = 0
			let size int64 = 0
			for let m in list {
				unseen++ unless hasFlag(m.flags, "\\Seen")
				size += m.size
			}
			let keywords = readKeywords(dir)
			let flags = ["\\Seen", "\\Answered", "\\Flagged", "\\Deleted", "\\Draft"] + keywords
			let permanent = flags.clone()
			permanent.push("\\*") when keywords.len() < 26
			return MailboxStatus{messages: list.len(), unseen: unseen, uidNext: state.next, uidValidity: state.validity, highestModSeq: state.modSeq, size: size, flags: flags, permanentFlags: permanent, readOnly: false}
		}

		def messages() !StoredMessage[] {
			let out StoredMessage[] = []
			let keywords = readKeywords(dir)
			let entries MaildirEntry[] = []
			let state = try withLock(def (_ UidList, found MaildirEntry[]) !bool {
				entries = found
				return false
			})
			for let e in entries {
				let uid = state.uids.get(e.key)
				continue when uid is none
				let mod = state.mods.get(e.key)
				out.push(StoredMessage{uid: uid, flags: flagsOf(e.flags, keywords), size: e.size, internalDate: e.modified, modSeq: mod is none ?? (int64(1), mod)})
			}
			out.sort((a, b) => a.uid < b.uid)
			return out
		}

		def read(uid int64) !byte[] {
			return try dir.read(try keyOf(uid))
		}

		def setFlags(uid int64, flags string[]) !int64 {
			let key = try keyOf(uid)
			let letters = try lettersOf(flags)
			let mod int64 = 0
			try withLock(def (s UidList, _ MaildirEntry[]) !bool {
				try dir.setFlags(key, letters)
				s.modSeq++
				s.mods[key] = s.modSeq
				mod = s.modSeq
				return true
			})
			return mod
		}

		def append(data byte[], flags string[], internalDate Time) !int64 {
			let letters = try lettersOf(flags)
			let key = try dir.deliver(data, letters)
			let path = letters == "" ?? (os.join(dir.path, "new", key), os.join(dir.path, "cur", key + ":2," + letters))
			os.touch(path, internalDate) onerror recover none
			let state = try withLock(def (s UidList, entries MaildirEntry[]) !bool {
				return false
			})
			let uid = state.uids.get(key)
			fail protocolError("delivered message has no UID") when uid is none
			return uid
		}

		def expunge(uids int64[]) !none {
			let keys string[] = []
			for let uid in uids {
				let key = keyOf(uid) onerror recover ""
				keys.push(key) unless key == ""
			}
			for let key in keys {
				dir.remove(key) onerror recover none
			}
			try withLock(def (s UidList, _ MaildirEntry[]) !bool {
				s.modSeq++
				return true
			})
			return none
		}

		// keyOf is the Maildir key of `uid`. Fails when it is gone.
		internal def keyOf(uid int64) !string {
			let found = ""
			try withLock(def (s UidList, _ MaildirEntry[]) !bool {
				for let (key, value) in s.uids {
					found = key when value == uid
				}
				return false
			})
			fail ImapError{message: "imap: no message with UID {uid}", code: "NONEXISTENT", status: "NO", response: "NONEXISTENT", text: "No such message"} when found == ""
			return found
		}

		// lettersOf maps IMAP flags to Maildir letters, keywords to `a`–`z`
		// (added to the keywords file as needed). Fails when a folder has
		// 26 keywords already.
		internal def lettersOf(flags string[]) !string {
			let keywords = readKeywords(dir)
			let letters = ""
			for let f in flags {
				match f.lower() {
					case "\\seen":
						letters += "S"
					case "\\answered":
						letters += "R"
					case "\\flagged":
						letters += "F"
					case "\\deleted":
						letters += "T"
					case "\\draft":
						letters += "D"
					case "\\recent":
						continue
					default:
						let at = keywords.indexOf(f)
						if at < 0 {
							fail ImapError{message: "imap: too many keywords", code: "LIMIT", status: "NO", response: "LIMIT", text: "Too many keywords"} when keywords.len() >= 26
							keywords.push(f)
							try os.writeFile(os.join(dir.path, "adm-imap-keywords"), (keywords.join("\n") + "\n").bytes())
							at = keywords.len() - 1
						}
						letters += string(char(0x61 + at))
				}
			}
			let sorted string[] = []
			for let c in letters {
				sorted.push(string(c)) unless sorted.indexOf(string(c)) >= 0
			}
			sorted.sort((a, b) => a < b)
			return sorted.join("")
		}

		// withLock loads the UID list under the folder's lock, gives new
		// messages UIDs and forgets gone ones, lets `change` edit it, and
		// saves it when anything changed.
		internal def withLock(change def (s UidList, entries MaildirEntry[]) !bool) !UidList {
			for !folderLocks.take(dir.path) {
				time.sleep(1ms)
			}
			let failure ?error = none
			let result = syncList(change) onerror (err error) {
				failure = err
				recover new UidList()
			}
			folderLocks.give(dir.path)
			fail failure unless failure is none
			return result
		}

		internal def syncList(change def (s UidList, entries MaildirEntry[]) !bool) !UidList {
			let path = os.join(dir.path, "adm-imap-uidlist")
			let state = readUidList(path)
			let changed = false
			if state.validity == 0 {
				state.validity = time.now().unixNs() / 1000000000
				changed = true
			}
			let entries = try dir.list()
			let present = map<string, bool>{}
			for let e in entries {
				present[e.key] = true
				if !state.uids.hasKey(e.key) {
					state.uids[e.key] = state.next
					state.next++
					state.modSeq++
					state.mods[e.key] = state.modSeq
					changed = true
				}
			}
			for let (key, _) in state.uids.clone() {
				if !present.hasKey(key) {
					state.uids.delete(key)
					state.mods.delete(key)
					changed = true
				}
			}
			changed = (try change(state, entries)) || changed
			try writeUidList(path, state) when changed
			return state
		}
	}

	// flagsOf maps Maildir letters to IMAP flags.
	def flagsOf(letters string, keywords string[]) string[] {
		let out string[] = []
		for let c in letters {
			match c {
				case 'S':
					out.push("\\Seen")
				case 'R':
					out.push("\\Answered")
				case 'F':
					out.push("\\Flagged")
				case 'T':
					out.push("\\Deleted")
				case 'D':
					out.push("\\Draft")
				default:
					let at = int(c) - 0x61
					out.push(keywords[at]) when at >= 0 && at < keywords.len()
			}
		}
		return out
	}

	def readKeywords(dir Maildir) string[] {
		let raw = os.readFile(os.join(dir.path, "adm-imap-keywords")) onerror recover []
		let out string[] = []
		for let line in string(raw).split("\n") {
			out.push(line.trim()) unless line.trim() == ""
		}
		return out
	}

	// readUidList reads `V validity N next M modseq` then `uid modseq key`
	// lines; a missing or broken file is an empty list.
	def readUidList(path string) UidList {
		let state = new UidList()
		let raw = os.readFile(path) onerror recover []
		let lines = string(raw).split("\n")
		return state when lines.len() == 0
		let head = lines[0].split(" ")
		if head.len() == 6 && head[0] == "V" && head[1].isNumeric() && head[3].isNumeric() && head[5].isNumeric() {
			state.validity = head[1].toInt<int64>()
			state.next = head[3].toInt<int64>()
			state.modSeq = head[5].toInt<int64>()
		}
		for let line in lines[1:] {
			let words = line.split(" ")
			continue unless words.len() == 3 && words[0].isNumeric() && words[1].isNumeric()
			state.uids[words[2]] = words[0].toInt<int64>()
			state.mods[words[2]] = words[1].toInt<int64>()
		}
		return state
	}

	// writeUidList saves a UID list through a temporary file and a rename.
	def writeUidList(path string, state UidList) !none {
		let out = "V {state.validity} N {state.next} M {state.modSeq}\n"
		for let (key, uid) in state.uids {
			let mod = state.mods.get(key)
			out += "{uid} {mod is none ?? (int64(1), mod)} {key}\n"
		}
		let staged = path + ".tmp"
		try os.writeFile(staged, out.bytes())
		return try os.rename(staged, path)
	}
}
