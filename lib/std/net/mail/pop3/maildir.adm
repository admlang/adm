partial module std.net.mail.pop3 {
	use (
		std.bytes
		std.formats.mail::(Maildir)
		std.io
		std.net.mail.pop3.proto::*
	)

	// MaildirDrop serves a `mail.Maildir` as a POP3 maildrop: messages in
	// `new` and `cur`, keyed by their Maildir key (the UIDL), removed from
	// disk at `QUIT`. One session of this process holds a folder at a time;
	// a second login is refused with `IN-USE` until the first ends.
	//
	// ```
	// def login(user string, password Secret<string>) !pop3.Maildrop {
	//     try check(user, password)
	//     return new pop3.MaildirDrop(new mail.Maildir("/var/mail/" + user))
	// }
	// ```
	type MaildirDrop {
		maildir Maildir

		internal locked bool = false

		def new(maildir Maildir) {
			self.maildir = maildir
		}

		// Implements `Maildrop`: locks the folder on the first call. Fails
		// with `IN-USE` when another session holds it, or when the folder
		// cannot be read.
		def list() !Entry[] {
			if !locked {
				fail Pop3Error{message: "pop3: maildrop in use", code: "IN-USE", response: "IN-USE", text: "Maildrop already locked"} unless dropLocks.take(maildir.path)
				locked = true
			}
			let out Entry[] = []
			for let entry in try maildir.list() {
				out.push(Entry{number: out.len() + 1, size: entry.size, uid: entry.key})
			}
			return out
		}

		// Implements `Maildrop`. Fails when the message is gone.
		def open(uid string) !io.Reader {
			return new bytes.Buffer(try maildir.read(uid))
		}

		// Implements `Maildrop`: deletes the files. Fails when one cannot be
		// removed; the others are removed still.
		def remove(uids string[]) !none {
			let failure ?error = none
			for let uid in uids {
				maildir.remove(uid) onerror (err error) {
					failure = err
					recover none
				}
			}
			fail failure unless failure is none
			return none
		}

		// Implements `Maildrop`: lets another session lock the folder.
		def release() {
			return unless locked
			locked = false
			dropLocks.give(maildir.path)
		}
	}
}
