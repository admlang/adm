partial module std.net.mail.pop3 {
	use (
		std.errors
	)

	// Security picks how a connection is protected.
	enum Security {
		// No TLS; the password and the mail cross the network in the clear.
		Plain    = "plain",
		// `STLS` on port 110: the connection starts plain and upgrades
		// before login (RFC 2595). The client fails when the server does
		// not offer it.
		StartTls = "starttls",
		// TLS from the first byte, on port 995 (RFC 8314).
		Implicit = "implicit",
	}

	// AuthMethod is how a client logs in.
	enum AuthMethod {
		// `USER` and `PASS` (RFC 1939).
		User    = "USER",
		// `APOP`: an MD5 digest of the server's greeting stamp and the
		// password, so the password never crosses the network (RFC 1939
		// §7). MD5 is weak; prefer TLS.
		Apop    = "APOP",
		// `AUTH PLAIN` (RFC 5034, RFC 4616).
		Plain   = "PLAIN",
		// `AUTH XOAUTH2`: an OAuth 2.0 access token in place of the password.
		XOAuth2 = "XOAUTH2",
	}

	// Pop3Error is the payload of a failure the server reported with
	// `-ERR`: its text, and the extended response code of RFC 2449 §8
	// (`IN-USE`, `LOGIN-DELAY`, `SYS/TEMP`, `AUTH`) when it sent one.
	struct Pop3Error {
		message  string
		code     string
		cause    ?error
		stack    errors.StackTrace
		// The response code without brackets, empty when there is none.
		response string
		// The text after `-ERR` and the response code.
		text     string
	}

	// Entry is one message of a maildrop: its number in this session, its
	// size in bytes and its unique ID (UIDL), which stays the same across
	// sessions.
	struct Entry {
		number int
		size   int64
		uid    string
	}
}
