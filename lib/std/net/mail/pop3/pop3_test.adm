partial module std.net.mail.pop3 {
	use (
		std.crypto.x509::(CertPool)
		std.formats.mail
		std.formats.mail::(Maildir)
		std.net
		std.net.mail.pop3.proto::*
		std.net.mail.smtp
		std.net.mail.wire::*
		std.net.tls
		std.testing
		std.time
	)

	// A self-signed P-256 certificate for 127.0.0.1, localhost and
	// example.com, valid for a century (the one httptest presents).
	internal const pop3CertPEM =
		"-----BEGIN CERTIFICATE-----\n" +
		"MIIByzCCAXCgAwIBAgIULZ61fkBLJqpHXo7Dg3TjjURKNKQwCgYIKoZIzj0EAwIw\n" +
		"EzERMA8GA1UEAwwIQURNIHRlc3QwIBcNMjYwOTE2MjEyNDQ4WhgPMjEyNjA4MjMy\n" +
		"MTI0NDhaMBMxETAPBgNVBAMMCEFETSB0ZXN0MFkwEwYHKoZIzj0CAQYIKoZIzj0D\n" +
		"AQcDQgAEWmnKIPFi8/hNfbTouWeJ0sX7jXIK0H2BdAa3ZlChTQUtkRXRuGnkYmY9\n" +
		"c9D2sLIU0D8YtBwSi1XCEXkyARGL3KOBnzCBnDAdBgNVHQ4EFgQUdGEQb1u97o8W\n" +
		"5FkheQ27r3JNU3AwHwYDVR0jBBgwFoAUdGEQb1u97o8W5FkheQ27r3JNU3AwDwYD\n" +
		"VR0TAQH/BAUwAwEB/zAnBgNVHREEIDAegglsb2NhbGhvc3SCC2V4YW1wbGUuY29t\n" +
		"hwR/AAABMAsGA1UdDwQEAwIHgDATBgNVHSUEDDAKBggrBgEFBQcDATAKBggqhkjO\n" +
		"PQQDAgNJADBGAiEA6p+D8so1nzo4nOkB8z0x1Tq+9iG1qIweVo/zTnSHG9cCIQDo\n" +
		"ANw/RkMk5iyYvJf8Qx75u8fY/n2s26d6Clj96iuH/g==\n" +
		"-----END CERTIFICATE-----\n"

	internal const pop3KeyPEM =
		"-----BEGIN PRIVATE KEY-----\n" +
		"MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgz6zLOlG3plulCC6J\n" +
		"73w4HvDFzW9lrGWy0U1PuM2M1gWhRANCAARaacog8WLz+E19tOi5Z4nSxfuNcgrQ\n" +
		"fYF0BrdmUKFNBS2RFdG4aeRiZj1z0PawshTQPxi0HBKLVcIReTIBEYvc\n" +
		"-----END PRIVATE KEY-----\n"

	// Drops lets alice in with `s3cret`, serving one Maildir.
	type Drops {
		box Maildir

		def new(box Maildir) {
			self.box = box
		}

		def login(user string, password Secret<string>) !Maildrop {
			fail "refused" unless user == "alice" && password.reveal() == "s3cret"
			return new MaildirDrop(box)
		}
	}

	internal def seededBox() !Maildir {
		let box = new Maildir("/tmp/adm-pop3-{time.now().unixNs()}")
		try box.create()
		try box.deliver("From: a@x.org\r\nSubject: first\r\n\r\nline one\r\n.dot line\r\nline three\r\n".bytes())
		time.sleep(2ms)
		try box.deliver("From: b@x.org\r\nSubject: second\r\n\r\nhello\r\n".bytes())
		return box
	}

	internal def startPop3(box Maildir, security Security = Security.Plain) !Server {
		let server = new Server(new Drops(box), "127.0.0.1:0")
		server.hostname = "pop.test"
		server.security = security
		server.timeout = 5s
		server.idleTimeout = 5s
		let pair = try tls.parseKeyPair(pop3CertPEM, pop3KeyPEM)
		server.tls = tls.Config{certificates: [pair]}
		try server.start()
		return server
	}

	internal def pop3Client(server Server, security Security = Security.Plain) !Client {
		let client = new Client(security, 5s)
		let pool = new CertPool()
		pool.appendCertsFromPEM(pop3CertPEM)
		client.tls = tls.Config{serverName: "localhost", rootCAs: pool}
		try client.connect(server.address().str())
		return client
	}

	check "pop3" {
		@test()
		def readsAndDeletesMail() !none {
			let box = try seededBox()
			let server = try startPop3(box)
			let client = try pop3Client(server)
			assert client.banner().startsWith("pop.test") && client.hasCapability("UIDL") && client.hasCapability("top")
			try client.login("alice", "s3cret")
			let (count, size) = try client.stat()
			assert count == 2 && size > 0
			let entries = try client.list()
			assert entries.len() == 2 && entries[0].number == 1 && entries[0].uid != "" && entries[0].uid != entries[1].uid
			let first = try client.retrieve(1)
			assert first.subject() == "first"
			let body = first.text()
			assert !(body is none) && body.contains("\r\n.dot line\r\n")
			let head = try client.top(1, 1)
			assert head.subject() == "first" && string(head.body.data()) == "line one\r\n"
			try client.delete(1)
			assert (try client.list()).len() == 1
			assert client.retrieve(1) is error
			try client.reset()
			assert (try client.list()).len() == 2
			try client.delete(2)
			try client.noop()
			try client.close()
			let left = try box.list()
			assert left.len() == 1 && left[0].key == entries[0].uid
			try server.close()
			return none
		}

		@test()
		def refusesBadLoginsAndLockedDrops() !none {
			let box = try seededBox()
			let server = try startPop3(box)
			let client = try pop3Client(server)
			let response = ""
			client.login("alice", "wrong") onerror (err error) {
				response = err.response when err is Pop3Error
				recover none
			}
			assert response == "AUTH"
			try client.login("alice", "s3cret", AuthMethod.Plain)
			let second = try pop3Client(server)
			response = ""
			second.login("alice", "s3cret") onerror (err error) {
				response = err.response when err is Pop3Error
				recover none
			}
			assert response == "IN-USE"
			try client.close()
			try second.login("alice", "s3cret")
			assert (try second.list()).len() == 2
			try second.close()
			try server.close()
			return none
		}

		@test()
		def upgradesWithStls() !none {
			let server = try startPop3(try seededBox(), Security.StartTls)
			server.requireTls = true
			let client = try pop3Client(server, Security.StartTls)
			assert client.isSecure() && !client.hasCapability("STLS")
			try client.login("alice", "s3cret")
			assert (try client.list()).len() == 2
			try client.close()
			let implicit = try startPop3(try seededBox(), Security.Implicit)
			let direct = try pop3Client(implicit, Security.Implicit)
			try direct.login("alice", "s3cret")
			try direct.close()
			try server.close()
			try implicit.close()
			return none
		}

		@test()
		def speaksTheWireForm() !none {
			let server = try startPop3(try seededBox())
			let conn = try net.dialStream(server.address().str(), 5s)
			let lines = new net.LineReader(conn)
			let ask = def (line string) !string {
				try writeFully(conn, (line + "\r\n").bytes(), 5s)
				return try lines.readLine(5s)
			}
			assert (try lines.readLine(5s)).startsWith("+OK")
			assert (try ask("STAT")).startsWith("-ERR")
			assert (try ask("APOP alice 0123")).startsWith("-ERR")
			assert (try ask("USER alice")).startsWith("+OK")
			assert (try ask("PASS s3cret")) == "+OK maildrop has 2 messages"
			assert (try ask("LIST 2")).startsWith("+OK 2 ")
			assert (try ask("LIST 9")).startsWith("-ERR")
			assert (try ask("RETR 1")).startsWith("+OK")
			let body = string(try readMultiline(lines, 5s))
			assert body.contains("\r\n.dot line\r\n")
			assert (try ask("DELE 1")).startsWith("+OK")
			assert (try ask("DELE 1")).startsWith("-ERR")
			assert (try ask("STAT")).startsWith("+OK 1 ")
			assert (try ask("FROB")).startsWith("-ERR")
			assert (try ask("QUIT")).startsWith("+OK")
			try server.close()
			return none
		}

		@test()
		def parsesStatusAndDigests() !none {
			let status = try parseStatus("-ERR [IN-USE] Do you have another POP session running?")
			assert !status.ok && status.response == "IN-USE" && status.text == "Do you have another POP session running?"
			assert (try parseStatus("+OK 2 320")).text == "2 320"
			assert parseStatus("* weird") is error
			// RFC 1939 §7 example.
			assert apopDigest("<1896.697170952@dbc.mtview.ca.us>", "tanstaaf") == "c4c9334bac560ecc979e58001b3e22fb"
			assert stampOf("+OK POP3 server ready <1896.697170952@dbc.mtview.ca.us>") == "<1896.697170952@dbc.mtview.ca.us>"
			assert stampOf("+OK ready") == ""
			assert string(topOf("A: 1\r\n\r\nx\r\ny\r\n".bytes(), 1)) == "A: 1\r\n\r\nx\r\n"
			return none
		}

		@test()
		def carriesMailFromSmtpToPop3() !none {
			let box = new Maildir("/tmp/adm-mailflow-{time.now().unixNs()}")
			try box.create()
			let handler = new smtp.MaildirHandler(def (to string) ?Maildir {
				return to == "alice@x.org" ?? (box, none)
			})
			let mx = new smtp.Server(handler, "127.0.0.1:0")
			try mx.start()
			let sender = new smtp.Client(smtp.Security.Plain, 5s)
			try sender.connect(mx.address().str())
			let delivery = try sender.send(new mail.Message().from("bob@x.org").to("alice@x.org").to("ghost@x.org").subject("hi alice").text("see you"))
			assert delivery.accepted.len() == 1 && delivery.rejected.len() == 1
			try sender.close()
			let server = try startPop3(box)
			let client = try pop3Client(server)
			try client.login("alice", "s3cret")
			let got = try client.retrieve(1)
			assert got.subject() == "hi alice"
			assert orEmpty(got.header.raw("Delivered-To")) == "alice@x.org" && orEmpty(got.header.raw("Return-Path")) == "<bob@x.org>"
			try client.close()
			try server.close()
			try mx.close()
			return none
		}
	}

	internal def orEmpty(text ?string) string {
		return "" when text is none
		return text
	}
}
