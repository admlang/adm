partial module std.net.mail.smtp {
	use (
		std.bytes
		std.formats.mail::(Maildir)
		std.io
	)

	// MaildirHandler is a `Handler` (and `RecipientFilter`) that files each
	// message into the Maildir `resolve` names for each recipient, with
	// `Return-Path:` and `Delivered-To:` in front (RFC 5321 §4.4). A
	// recipient `resolve` answers none for is refused with `550 5.1.1`.
	//
	// ```
	// let handler = new smtp.MaildirHandler(def (to string) ?mail.Maildir {
	//     return users.hasKey(to) ?? (new mail.Maildir("/var/mail/" + users[to]), none)
	// })
	// let server = new smtp.Server(handler, ":25")
	// ```
	type MaildirHandler {
		resolve def (recipient string) ?Maildir

		def new(resolve def (recipient string) ?Maildir) {
			self.resolve = resolve
		}

		// Implements `RecipientFilter`. Fails with 550 when no folder takes
		// `recipient`.
		def recipient(envelope Envelope, recipient string) !none {
			fail SmtpError{message: "smtp: no mailbox {recipient}", code: "550", reply: 550, enhanced: "5.1.1", text: "Mailbox unavailable"} when resolve(recipient) is none
			return none
		}

		// Implements `Handler`: one copy per recipient. Fails with 451 when
		// a folder cannot be written; copies already filed stay.
		def deliver(envelope Envelope, data io.Reader) !none {
			let buffer = new bytes.Buffer()
			try buffer.readFrom(data)
			let message = buffer.bytes()
			for let to in envelope.to {
				let folder = resolve(to)
				continue when folder is none
				let copy = "Return-Path: <{envelope.from}>\r\nDelivered-To: {to}\r\n".bytes() + message
				folder.deliver(copy) onerror (err error) {
					fail SmtpError{message: "smtp: cannot file mail for {to}: {err.message}", code: "451", reply: 451, enhanced: "4.3.0", text: "Mailbox temporarily unavailable", cause: err}
				}
			}
			return none
		}
	}
}
