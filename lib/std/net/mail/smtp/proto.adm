internal partial module std.net.mail.smtp.proto {
	use (
		std.metrics
		std.net
		std.net.mail.smtp::*
		std.net.mail.wire::*
		std.services::(metric)
	)

	// Reply is one server reply: its code, the enhanced status code when
	// the first line carries one, and its lines, code and separator
	// stripped (the enhanced code too).
	struct Reply {
		code     int
		enhanced string
		lines    string[]
	}

	// replyText is a reply's lines joined by newlines.
	def replyText(reply Reply) string {
		return reply.lines.join("\n")
	}

	// replyError is the SmtpError of an unexpected reply to `op`.
	def replyError(op string, reply Reply) SmtpError {
		let text = replyText(reply)
		let shown = reply.enhanced == "" ?? (text, reply.enhanced + " " + text)
		return SmtpError{message: "smtp: {op}: {reply.code} {shown}", code: "{reply.code}", reply: reply.code, enhanced: reply.enhanced, text: text}
	}

	// protocolError is the SmtpError of something that breaks the protocol
	// or cannot be sent.
	def protocolError(op string, message string) SmtpError {
		return SmtpError{message: "smtp: {op}: {message}", code: "0", reply: 0, enhanced: "", text: message}
	}

	// splitEnhanced takes an RFC 3463 enhanced status code
	// (`class.subject.detail`, class 2, 4 or 5) off the front of a reply
	// line: the code, empty when there is none, and the rest.
	def splitEnhanced(text string) (string, string) {
		let space = text.indexOf(" ")
		let head = space < 0 ?? (text, text[:space])
		let parts = head.split(".")
		return ("", text) unless parts.len() == 3 && (parts[0] := "2" || "4" || "5")
		for let p in parts[1:] {
			return ("", text) unless p.len() >= 1 && p.len() <= 3 && p.isNumeric()
		}
		return (head, space < 0 ?? ("", text[space + 1:]))
	}

	// isReplyLine reports whether a line starts with three digits and a
	// space, a dash or nothing more.
	def isReplyLine(line string) bool {
		return false when line.len() < 3
		for let i = 0; i < 3; i++ {
			return false unless line[i] >= '0' && line[i] <= '9'
		}
		return line.len() == 3 || line[3] == ' ' || line[3] == '-'
	}

	// readReply reads one reply, multi-line ones included. Fails when the
	// connection fails or the reply does not parse.
	def readReply(lines LineReader, timeout duration) !Reply {
		let out string[] = []
		let code = 0
		for {
			let line = try lines.readLine(timeout)
			fail protocolError("reply", "malformed reply {line.truncate(64)}") unless isReplyLine(line)
			let lineCode = line[:3].toInt<int>()
			fail protocolError("reply", "reply code changed inside a reply") when code != 0 && lineCode != code
			code = lineCode
			out.push(line.len() > 4 ?? (line[4:], ""))
			break unless line.len() > 3 && line[3] == '-'
		}
		let (enhanced, rest) = splitEnhanced(out[0])
		if enhanced != "" {
			out[0] = rest
			for let i = 1; i < out.len(); i++ {
				let (again, text) = splitEnhanced(out[i])
				out[i] = text when again == enhanced
			}
		}
		return Reply{code: code, enhanced: enhanced, lines: out}
	}

	// parseExtensions reads the keywords of an EHLO reply (every line after
	// the greeting) as upper-cased keyword to its parameters.
	def parseExtensions(reply Reply) map<string, string> {
		let out = map<string, string>{}
		for let line in reply.lines[1:] {
			let text = line.trim()
			continue when text == ""
			let space = text.indexOf(" ")
			let name = space < 0 ?? (text, text[:space])
			out[name.upper()] = space < 0 ?? ("", text[space + 1:].trim())
		}
		return out
	}

	// ---- DSN parameters (RFC 3461) ------------------------------------------

	// xtext encodes a DSN parameter value: `+`, `=`, controls, space and
	// non-ASCII as `+XX`.
	def xtext(value string) string {
		let out = ""
		let digits = "0123456789ABCDEF"
		for let b in value.bytes() {
			if b >= 0x21 && b <= 0x7E && b != 0x2B && b != 0x3D {
				out += string(char(b))
				continue
			}
			out += "+" + string(digits[int(b) / 16]) + string(digits[int(b) % 16])
		}
		return out
	}

	// unxtext decodes an xtext value; a malformed escape stays as written.
	def unxtext(value string) string {
		return value unless value.contains("+")
		let raw = value.bytes()
		let out byte[] = []
		let i = 0
		for i < raw.len() {
			if raw[i] == 0x2B && i + 2 < raw.len() && char(raw[i + 1]).isHexDigit() && char(raw[i + 2]).isHexDigit() {
				out.push(byte(char(raw[i + 1]).digitValue(16) * 16 + char(raw[i + 2]).digitValue(16)))
				i += 3
				continue
			}
			out.push(raw[i])
			i++
		}
		return string(out)
	}

	// notifyParam is the NOTIFY value of a list, empty when it is empty.
	def notifyParam(notify Notify[]) string {
		let names string[] = []
		for let n in notify {
			names.push(n.value)
		}
		return names.join(",")
	}

	// ---- server side ---------------------------------------------------------

	// ServerStats holds the metrics of SMTP servers, registered once per
	// process and shared by every server.
	type ServerStats {
		@metric("net.smtp.server.connections.open")
		connectionsOpen metrics.Gauge
		@metric("net.smtp.server.connections.total")
		connectionsTotal metrics.Counter
		@metric("net.smtp.server.messages.accepted")
		messagesAccepted metrics.Counter
		@metric("net.smtp.server.messages.rejected")
		messagesRejected metrics.Counter
		@metric("net.smtp.server.recipients.rejected")
		recipientsRejected metrics.Counter
		@metric("net.smtp.server.bytes.in")
		bytesIn metrics.Counter
		@metric("net.smtp.server.logins.total")
		logins metrics.Counter
		@metric("net.smtp.server.logins.failed")
		loginFailures metrics.Counter

		def new() {}
	}

	// failureReply is the reply a handler failure maps to: the SmtpError
	// payload's code, enhanced code and text when it carries a 4xx or 5xx
	// one, else `fallback`.
	def failureReply(err error, fallback int, fallbackEnhanced string, fallbackText string) Reply {
		if err is SmtpError {
			if err.reply >= 400 && err.reply <= 599 {
				let text = err.text == "" ?? (fallbackText, err.text)
				return Reply{code: err.reply, enhanced: err.enhanced, lines: text.split("\n")}
			}
		}
		return Reply{code: fallback, enhanced: fallbackEnhanced, lines: [fallbackText]}
	}

	// parsePath reads `FROM:<path> params` or `TO:<path> params` after the
	// verb: the path without brackets and the parameters as upper-cased
	// keyword to value. Fails when `keyword:` or the brackets are missing.
	def parsePath(arg string, keyword string) !(string, map<string, string>) {
		let text = arg.trim()
		fail protocolError("syntax", "expected {keyword}:") unless text.upper().startsWith(keyword + ":")
		text = text[keyword.len() + 1:].trim()
		fail protocolError("syntax", "expected <address>") unless text.startsWith("<")
		let close = findPathEnd(text)
		fail protocolError("syntax", "unterminated address") when close < 0
		let path = text[1:close]
		// A source route (`<@a,@b:user@host>`) is read and ignored.
		if path.startsWith("@") {
			let colon = path.indexOf(":")
			path = colon < 0 ?? (path, path[colon + 1:])
		}
		let params = map<string, string>{}
		for let word in text[close + 1:].split(" ") {
			continue when word == ""
			let eq = word.indexOf("=")
			let name = eq < 0 ?? (word, word[:eq])
			params[name.upper()] = eq < 0 ?? ("", word[eq + 1:])
		}
		return (path, params)
	}

	// findPathEnd is the index of the `>` closing a path, quoted local
	// parts skipped; -1 when there is none.
	def findPathEnd(text string) int {
		let quoted = false
		for let i = 1; i < text.len(); i++ {
			let c = text[i]
			if c == '\\' && quoted {
				i++
				continue
			}
			quoted = !quoted when c == '"'
			return i when c == '>' && !quoted
		}
		return -1
	}

	// isMailbox reports a plausible `local@domain` path.
	def isMailbox(path string) bool {
		let at = -1
		for let i = 0; i < path.len(); i++ {
			at = i when path[i] == '@'
		}
		return at > 0 && at < path.len() - 1
	}
}
