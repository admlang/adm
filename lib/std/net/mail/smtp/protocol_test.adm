partial module std.net.mail.smtp {
	use (
		std.net
		std.net.mail.smtp.proto::*
		std.net.mail.wire::*
		std.testing
	)

	// Raw is a hand-driven connection to a test server.
	type Raw {
		conn  net.Connection
		lines net.LineReader

		def new(conn net.Connection) {
			self.conn = conn
			lines = new net.LineReader(conn)
		}

		// say writes lines as one write, CRLF after each.
		def say(text...string) !none {
			return try writeFully(conn, (text.join("\r\n") + "\r\n").bytes(), 5s)
		}

		def hear() !Reply {
			return try readReply(lines, 5s)
		}

		// ask writes one line and returns the reply code.
		def ask(line string) !int {
			try say(line)
			return (try hear()).code
		}
	}

	internal def rawTo(server Server) !Raw {
		let raw = new Raw(try net.dialStream(server.address().str(), 5s))
		let greeting = try raw.hear()
		assert greeting.code == 220
		return raw
	}

	check "smtp protocol" {
		@test()
		def enforcesCommandOrder() !none {
			let server = try startSmtp(new Inbox())
			let raw = try rawTo(server)
			assert (try raw.ask("MAIL FROM:<a@x.org>")) == 503
			assert (try raw.ask("EHLO")) == 501
			assert (try raw.ask("EHLO client")) == 250
			assert (try raw.ask("RCPT TO:<b@x.org>")) == 503
			assert (try raw.ask("DATA")) == 503
			assert (try raw.ask("FOO bar")) == 500
			assert (try raw.ask("MAIL FROM:a@x.org")) == 501
			assert (try raw.ask("MAIL FROM:<a@x.org> FROB=1")) == 555
			assert (try raw.ask("MAIL FROM:<a@x.org> BODY=8BITMIME")) == 250
			assert (try raw.ask("MAIL FROM:<a@x.org>")) == 503
			assert (try raw.ask("DATA")) == 503
			assert (try raw.ask("RCPT TO:<zoë@x.org>")) == 553
			assert (try raw.ask("RCPT TO:<Postmaster>")) == 250
			assert (try raw.ask("RSET")) == 250
			assert (try raw.ask("RCPT TO:<b@x.org>")) == 503
			assert (try raw.ask("VRFY b")) == 252
			assert (try raw.ask("QUIT")) == 221
			try server.close()
			return none
		}

		@test()
		def unstuffsDataAndPipelines() !none {
			let inbox = new Inbox()
			let server = try startSmtp(inbox)
			let raw = try rawTo(server)
			try raw.say("EHLO client", "MAIL FROM:<>", "RCPT TO:<b@x.org>", "RCPT TO:<nobody@x.org>", "DATA")
			assert (try raw.hear()).code == 250
			let mail = try raw.hear()
			assert mail.code == 250 && mail.enhanced == "2.1.0"
			assert (try raw.hear()).code == 250
			let refused = try raw.hear()
			assert refused.code == 550 && refused.enhanced == "5.1.1" && replyText(refused) == "No such user here"
			assert (try raw.hear()).code == 354
			assert (try raw.ask("Subject: dots\r\n\r\n..one\r\ntwo\r\n.")) == 250
			assert inbox.count() == 1
			assert inbox.envelopes[0].from == "" && inbox.envelopes[0].to.equals(["b@x.org"])
			assert string(inbox.messages[0]).endsWith("\r\n\r\n.one\r\ntwo\r\n")
			try server.close()
			return none
		}

		@test()
		def takesChunks() !none {
			let inbox = new Inbox()
			let server = try startSmtp(inbox)
			let raw = try rawTo(server)
			assert (try raw.ask("EHLO client")) == 250
			assert (try raw.ask("MAIL FROM:<a@x.org>")) == 250
			assert (try raw.ask("RCPT TO:<b@x.org>")) == 250
			try writeFully(raw.conn, "BDAT 13\r\nSubject: bd\r\n".bytes(), 5s)
			assert (try raw.hear()).code == 250
			try writeFully(raw.conn, "BDAT 6 LAST\r\n\r\nbody".bytes(), 5s)
			assert (try raw.hear()).code == 250
			assert (try raw.ask("DATA")) == 503
			assert inbox.count() == 1 && string(inbox.messages[0]).endsWith("Subject: bd\r\n\r\nbody")
			try server.close()
			return none
		}

		@test()
		def refusesOversizeAndExtraRecipients() !none {
			let inbox = new Inbox()
			let server = try startSmtp(inbox)
			server.maxMessageSize = 20
			server.maxRecipients = 1
			let raw = try rawTo(server)
			assert (try raw.ask("EHLO client")) == 250
			assert (try raw.ask("MAIL FROM:<a@x.org> SIZE=50")) == 552
			assert (try raw.ask("MAIL FROM:<a@x.org>")) == 250
			assert (try raw.ask("RCPT TO:<b@x.org>")) == 250
			assert (try raw.ask("RCPT TO:<c@x.org>")) == 452
			assert (try raw.ask("DATA")) == 354
			assert (try raw.ask("Subject: long enough to overflow\r\n\r\nbody\r\n.")) == 552
			assert inbox.count() == 0
			try server.close()
			return none
		}

		@test()
		def authenticatesPlainAndLogin() !none {
			let server = try startSmtp(new Inbox())
			let raw = try rawTo(server)
			try raw.say("EHLO client")
			let ehlo = try raw.hear()
			assert orEmpty(parseExtensions(ehlo).get("AUTH")) == "PLAIN LOGIN"
			assert (try raw.ask("AUTH PLAIN " + plainResponse("alice", "nope"))) == 535
			assert (try raw.ask("AUTH LOGIN")) == 334
			assert (try raw.ask(b64("alice"))) == 334
			assert (try raw.ask(b64("s3cret"))) == 235
			assert (try raw.ask("AUTH PLAIN")) == 503
			assert (try raw.ask("AUTH CRAM-MD5")) == 503
			try server.close()
			return none
		}

		@test()
		def splitsEnhancedCodes() !none {
			let (code, rest) = splitEnhanced("5.1.1 No such user")
			assert code == "5.1.1" && rest == "No such user"
			let (none1, text) = splitEnhanced("mx.example.com ESMTP")
			assert none1 == "" && text == "mx.example.com ESMTP"
			let (none2, _) = splitEnhanced("3.1.1 not a class")
			assert none2 == ""
			return none
		}

		@test()
		def stuffsDots() !none {
			assert string(dotStuffed(".a\nb\r\n.".bytes())) == "..a\r\nb\r\n..\r\n.\r\n"
			assert string(dotStuffed("".bytes())) == ".\r\n"
			assert string(dotStuffed("end\r\n".bytes())) == "end\r\n.\r\n"
			return none
		}

		@test()
		def codesXtextAndPaths() !none {
			assert xtext("a+b=c d") == "a+2Bb+3Dc+20d"
			assert unxtext("a+2Bb+3Dc+20d") == "a+b=c d"
			let (path, params) = try parsePath("FROM:<@relay:a@x.org> SIZE=10 body=8bitmime", "FROM")
			assert path == "a@x.org" && orEmpty(params.get("SIZE")) == "10" && orEmpty(params.get("BODY")) == "8bitmime"
			let (quoted, _) = try parsePath("TO: <\"a>b\"@x.org>", "TO")
			assert quoted == "\"a>b\"@x.org"
			assert parsePath("TO:a@x.org", "TO") is error
			return none
		}

		@test()
		def computesCramMd5() !none {
			// RFC 2195 §2 example.
			let response = cramResponse("tim", "tanstaaftanstaaf", "<1896.697170952@postoffice.reston.mci.net>")
			assert (try unb64(response)) == "tim b913a602c7eda7a495b4e6e7334d3890"
			return none
		}
	}
}
