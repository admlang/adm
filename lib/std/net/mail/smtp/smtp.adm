partial module std.net.mail.smtp {
	use (
		std.errors
	)

	// Security picks how a connection is protected.
	enum Security {
		// No TLS; the message and any password cross the network in the
		// clear.
		Plain    = "plain",
		// `STARTTLS` on the ordinary port (25 or 587): the connection starts
		// plain and upgrades before `AUTH` and `MAIL` (RFC 3207). The client
		// fails when the server does not offer it.
		StartTls = "starttls",
		// TLS from the first byte, on port 465 (RFC 8314).
		Implicit = "implicit",
	}

	// AuthMethod is a SASL mechanism of `AUTH` (RFC 4954).
	enum AuthMethod {
		// `PLAIN` (RFC 4616): user and password in one message.
		Plain    = "PLAIN",
		// `LOGIN`: user and password in two prompts; older servers.
		Login    = "LOGIN",
		// `CRAM-MD5` (RFC 2195): a challenge answered with an HMAC, so the
		// password never crosses the network.
		CramMd5  = "CRAM-MD5",
		// `XOAUTH2`: an OAuth 2.0 access token in place of the password
		// (Gmail, Outlook).
		XOAuth2  = "XOAUTH2",
	}

	// Notify says which delivery status notifications a recipient asks for
	// (RFC 3461 `NOTIFY`).
	enum Notify {
		Never   = "NEVER",
		Success = "SUCCESS",
		Failure = "FAILURE",
		Delay   = "DELAY",
	}

	// Return says how much of the message a failure notification carries
	// (RFC 3461 `RET`).
	enum Return {
		Full    = "FULL",
		Headers = "HDRS",
	}

	// SmtpError is the payload of a failure the server reported: the
	// three-digit reply code (`550` for an unknown mailbox, `535` for a
	// refused login), the enhanced status code (RFC 3463, `5.1.1`) when
	// the server sent one, and the reply text. `code` repeats the reply
	// code as text, so a handler that only reads `error` still sees it.
	struct SmtpError {
		message  string
		code     string
		cause    ?error
		stack    errors.StackTrace
		// The reply code, 0 when the failure is not a server reply (a
		// reply that does not parse).
		reply    int
		// The enhanced status code, empty when the server sent none.
		enhanced string
		// The text of the reply, its lines joined by newlines.
		text     string
	}

	// Envelope is what `MAIL FROM` and `RCPT TO` carried for one message,
	// separate from the `From:` and `To:` headers inside it.
	struct Envelope {
		// The reverse path; empty for a bounce (`MAIL FROM:<>`).
		from       string
		to         string[]
		// The name the client gave in `EHLO` or `HELO`.
		helo       string
		// The user of a successful `AUTH`, empty when the client did not
		// log in.
		user       string
		// Whether the session runs over TLS.
		secure     bool
		// Whether the client asked for `SMTPUTF8` (RFC 6531).
		utf8       bool
		// `ENVID` of RFC 3461, empty when the client sent none.
		envelopeId string
	}

	// Rejection is one recipient the server refused, with its reply.
	struct Rejection {
		recipient string
		error     SmtpError
	}

	// Delivery is the outcome of `Client.send`: the recipients the server
	// took and the ones it refused. `send` fails when it refused them all.
	struct Delivery {
		accepted string[]
		rejected Rejection[]
	}
}
