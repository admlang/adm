partial module std.net.mail.smtp {
	use (
		std.bytes
		std.crypto.x509::(CertPool)
		std.formats.mail
		std.io
		std.net
		std.net.mail.smtp.proto::*
		std.net.mail.wire::*
		std.net.tls
		std.testing
	)

	// A self-signed P-256 certificate for 127.0.0.1, localhost and
	// example.com, valid for a century (the one httptest presents).
	internal const smtpCertPEM =
		"-----BEGIN CERTIFICATE-----\n" +
		"MIIByzCCAXCgAwIBAgIULZ61fkBLJqpHXo7Dg3TjjURKNKQwCgYIKoZIzj0EAwIw\n" +
		"EzERMA8GA1UEAwwIQURNIHRlc3QwIBcNMjYwOTE2MjEyNDQ4WhgPMjEyNjA4MjMy\n" +
		"MTI0NDhaMBMxETAPBgNVBAMMCEFETSB0ZXN0MFkwEwYHKoZIzj0CAQYIKoZIzj0D\n" +
		"AQcDQgAEWmnKIPFi8/hNfbTouWeJ0sX7jXIK0H2BdAa3ZlChTQUtkRXRuGnkYmY9\n" +
		"c9D2sLIU0D8YtBwSi1XCEXkyARGL3KOBnzCBnDAdBgNVHQ4EFgQUdGEQb1u97o8W\n" +
		"5FkheQ27r3JNU3AwHwYDVR0jBBgwFoAUdGEQb1u97o8W5FkheQ27r3JNU3AwDwYD\n" +
		"VR0TAQH/BAUwAwEB/zAnBgNVHREEIDAegglsb2NhbGhvc3SCC2V4YW1wbGUuY29t\n" +
		"hwR/AAABMAsGA1UdDwQEAwIHgDATBgNVHSUEDDAKBggrBgEFBQcDATAKBggqhkjO\n" +
		"PQQDAgNJADBGAiEA6p+D8so1nzo4nOkB8z0x1Tq+9iG1qIweVo/zTnSHG9cCIQDo\n" +
		"ANw/RkMk5iyYvJf8Qx75u8fY/n2s26d6Clj96iuH/g==\n" +
		"-----END CERTIFICATE-----\n"

	internal const smtpKeyPEM =
		"-----BEGIN PRIVATE KEY-----\n" +
		"MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgz6zLOlG3plulCC6J\n" +
		"73w4HvDFzW9lrGWy0U1PuM2M1gWhRANCAARaacog8WLz+E19tOi5Z4nSxfuNcgrQ\n" +
		"fYF0BrdmUKFNBS2RFdG4aeRiZj1z0PawshTQPxi0HBKLVcIReTIBEYvc\n" +
		"-----END PRIVATE KEY-----\n"

	// Inbox keeps what a test server received. Recipients starting with
	// `nobody` are refused; a message whose subject holds `spam` is
	// refused with 554.
	type Inbox {
		envelopes Envelope[] = []
		messages  byte[][]   = []

		def new() {}

		atomic def deliver(envelope Envelope, data io.Reader) !none {
			let buffer = new bytes.Buffer()
			try buffer.readFrom(data)
			let raw = buffer.bytes()
			fail SmtpError{message: "spam", code: "554", reply: 554, enhanced: "5.7.1", text: "Looks like spam"} when string(raw).contains("Subject: spam")
			envelopes.push(envelope)
			messages.push(raw)
			return none
		}

		def recipient(envelope Envelope, recipient string) !none {
			fail SmtpError{message: "no such user", code: "550", reply: 550, enhanced: "5.1.1", text: "No such user here"} when recipient.startsWith("nobody")
			return none
		}

		atomic def count() int {
			return messages.len()
		}
	}

	// TestUsers lets alice in with `s3cret`.
	type TestUsers {
		def new() {}

		def login(user string, password Secret<string>) !none {
			fail "refused" unless user == "alice" && password.reveal() == "s3cret"
			return none
		}
	}

	internal def startSmtp(inbox Inbox, security Security = Security.Plain) !Server {
		let server = new Server(inbox, "127.0.0.1:0")
		server.hostname = "mx.test"
		server.security = security
		server.timeout = 5s
		server.idleTimeout = 5s
		server.authenticator = new TestUsers()
		let pair = try tls.parseKeyPair(smtpCertPEM, smtpKeyPEM)
		server.tls = tls.Config{certificates: [pair]}
		try server.start()
		return server
	}

	internal def clientFor(server Server, security Security = Security.Plain) !Client {
		let client = new Client(security, 5s)
		let pool = new CertPool()
		pool.appendCertsFromPEM(smtpCertPEM)
		client.tls = tls.Config{serverName: "localhost", rootCAs: pool}
		client.localName = "client.test"
		try client.connect(server.address().str())
		return client
	}

	internal def sample() mail.Message {
		return new mail.Message().from("alice@example.com", "Alice").to("bob@example.com").cc("carol@example.com").bcc("dave@example.com").subject("Status").text("All good.\n.hidden dot line\n")
	}

	check "smtp" {
		@test()
		def sendsAMessage() !none {
			let inbox = new Inbox()
			let server = try startSmtp(inbox)
			let client = try clientFor(server)
			assert client.banner().startsWith("mx.test")
			assert client.hasExtension("pipelining") && client.hasExtension("CHUNKING") && client.hasExtension("SMTPUTF8")
			assert !client.isSecure()
			let delivery = try client.send(sample())
			assert delivery.accepted.len() == 3 && delivery.rejected.len() == 0
			try client.noop()
			try client.reset()
			try client.close()
			assert inbox.count() == 1
			let envelope = inbox.envelopes[0]
			assert envelope.from == "alice@example.com" && envelope.helo == "client.test"
			assert envelope.to.equals(["bob@example.com", "carol@example.com", "dave@example.com"])
			let received = try mail.parse(inbox.messages[0])
			assert received.subject() == "Status"
			assert !received.header.has("Bcc")
			assert received.header.has("Received")
			let body = received.text()
			assert !(body is none) && body.contains("\r\n.hidden dot line")
			try server.close()
			return none
		}

		@test()
		def reportsPartialRejection() !none {
			let inbox = new Inbox()
			let server = try startSmtp(inbox)
			let client = try clientFor(server)
			let delivery = try client.send("a@example.com", ["bob@example.com", "nobody@example.com"], "Subject: x\r\n\r\nhi\r\n".bytes())
			assert delivery.accepted.equals(["bob@example.com"])
			assert delivery.rejected.len() == 1
			let refusal = delivery.rejected[0]
			assert refusal.recipient == "nobody@example.com" && refusal.error.reply == 550 && refusal.error.enhanced == "5.1.1"
			let failed = false
			client.send("a@example.com", ["nobody@example.com"], "Subject: x\r\n\r\nhi\r\n".bytes()) onerror (err error) {
				failed = err.reply == 550 when err is SmtpError
				recover Delivery{accepted: [], rejected: []}
			}
			assert failed
			// The session still works after the refusal.
			assert (try client.send("a@example.com", ["bob@example.com"], "Subject: y\r\n\r\nhi\r\n".bytes())).accepted.len() == 1
			try client.close()
			try server.close()
			return none
		}

		@test()
		def passesHandlerRefusalToClient() !none {
			let inbox = new Inbox()
			let server = try startSmtp(inbox)
			let client = try clientFor(server)
			let code = 0
			let enhanced = ""
			client.send("a@example.com", ["bob@example.com"], "Subject: spam\r\n\r\nbuy\r\n".bytes()) onerror (err error) {
				if err is SmtpError {
					code = err.reply
					enhanced = err.enhanced
				}
				recover Delivery{accepted: [], rejected: []}
			}
			assert code == 554 && enhanced == "5.7.1"
			assert inbox.count() == 0
			try client.close()
			try server.close()
			return none
		}

		@test()
		def logsInWhenRequired() !none {
			let inbox = new Inbox()
			let server = try startSmtp(inbox)
			server.requireAuth = true
			let client = try clientFor(server)
			assert client.send(sample()) is error
			assert client.login("alice", "wrong") is error
			try client.login("alice", "s3cret", AuthMethod.Login)
			try client.send(sample())
			try client.close()
			let other = try clientFor(server)
			try other.login("alice", "s3cret")
			try other.send(sample())
			try other.close()
			assert inbox.count() == 2
			assert inbox.envelopes[0].user == "alice"
			try server.close()
			return none
		}

		@test()
		def upgradesWithStartTls() !none {
			let inbox = new Inbox()
			let server = try startSmtp(inbox, Security.StartTls)
			server.requireTls = true
			let client = try clientFor(server, Security.StartTls)
			assert client.isSecure()
			assert !client.hasExtension("STARTTLS")
			try client.login("alice", "s3cret", AuthMethod.Plain)
			try client.send(sample())
			try client.close()
			assert inbox.envelopes[0].secure
			let received = string(inbox.messages[0])
			assert received.contains("with ESMTPSA")
			try server.close()
			return none
		}

		@test()
		def speaksImplicitTls() !none {
			let inbox = new Inbox()
			let server = try startSmtp(inbox, Security.Implicit)
			let client = try clientFor(server, Security.Implicit)
			assert client.isSecure()
			try client.send(sample())
			try client.close()
			assert inbox.count() == 1 && inbox.envelopes[0].secure
			try server.close()
			return none
		}

		@test()
		def refusesStartTlsWhenNotOffered() !none {
			let server = try startSmtp(new Inbox())
			let client = new Client(Security.StartTls, 5s)
			assert client.connect(server.address().str()) is error
			assert !client.isOpen()
			try server.close()
			return none
		}

		@test()
		def honoursSizeLimit() !none {
			let inbox = new Inbox()
			let server = try startSmtp(inbox)
			server.maxMessageSize = 200
			let client = try clientFor(server)
			let limit = client.maxSize()
			assert !(limit is none) && limit == 200
			assert client.send("a@example.com", ["b@example.com"], "x".repeat(300).bytes()) is error
			try client.send("a@example.com", ["b@example.com"], "Subject: s\r\n\r\nshort\r\n".bytes())
			try client.close()
			assert inbox.count() == 1
			try server.close()
			return none
		}

		@test()
		def sendsInternationalAndDsn() !none {
			let inbox = new Inbox()
			let server = try startSmtp(inbox)
			let client = try clientFor(server)
			let delivery = try client.send("zoë@example.com", ["bob@example.com"], "Subject: é\r\n\r\ncafé\r\n".bytes(), [Notify.Success, Notify.Failure], Return.Headers)
			assert delivery.accepted.len() == 1
			try client.close()
			assert inbox.envelopes[0].utf8 && inbox.envelopes[0].from == "zoë@example.com"
			assert string(inbox.messages[0]).contains("with UTF8SMTP")
			try server.close()
			return none
		}

		@test()
		def verifiesAndLimitsConnections() !none {
			let server = try startSmtp(new Inbox())
			server.maxConnections = 1
			let client = try clientFor(server)
			assert client.verify("bob@example.com") is error
			let second = new Client(Security.Plain, 5s)
			assert second.connect(server.address().str()) is error
			try client.close()
			try server.close()
			assert server.connectionCount() == 0
			return none
		}
	}
}
