internal std.net.mail partial module std.net.mail.wire {
	use (
		std.crypto.hash
		std.data.encoding
		std.net
		std.net.tls
	)

	// What the mail protocols share: a buffered line reader, full writes,
	// TLS upgrades, SASL messages and dot-stuffing.

	// writeFully writes all of data to a stream. Fails when a write does
	// or moves nothing.
	def writeFully(stream net.Stream, data byte[], timeout duration) !none {
		let off = 0
		for off < data.len() {
			let n = try stream.write(data[off:], timeout)
			fail net.errorOf(net.ErrorCode.Pipe, "write", "", "wrote nothing") when n <= 0
			off += n
		}
		return none
	}

	// clientConfig is the TLS config a client uses: `base` with the server
	// name set to `host` when it has none.
	def clientConfig(base ?tls.Config, host string) tls.Config {
		let config = tls.Config{}
		config = base unless base is none
		config = tls.withServerName(config, host) when config.serverName == ""
		config.sessionCache = new tls.SessionCache() when config.sessionCache is none
		return config
	}

	// secureClient runs the TLS client handshake over a connection and
	// returns the protected stream. Fails as the handshake does.
	def secureClient(conn net.Connection, base ?tls.Config, host string, timeout duration) !net.Stream {
		let secured = tls.client(conn, clientConfig(base, host))
		try secured.handshake(timeout)
		return secured
	}

	// secureServer runs the TLS server handshake over an accepted
	// connection. Fails as the handshake does.
	def secureServer(conn net.Connection, config tls.Config, timeout duration) !net.Stream {
		let secured = tls.server(conn, config)
		try secured.handshake(timeout)
		return secured
	}

	// hostOf is the host of a `host:port` address, without brackets.
	def hostOf(addr string) string {
		let a = net.parseAddress(addr) onerror recover new net.Address()
		return a.host
	}

	// addressLiteral is the RFC 5321 §4.1.3 literal of an address:
	// `[192.0.2.1]` or `[IPv6:2001:db8::1]`.
	def addressLiteral(a net.Address) string {
		return "[IPv6:{a.host}]" when a.isIPv6
		return "[{a.host}]"
	}

	// b64 is text in base64, as AUTH exchanges carry it.
	def b64(text string) string {
		return encoding.base64encode(text.bytes())
	}

	// unb64 reads a base64 AUTH line. Fails when it is not base64.
	def unb64(text string) !string {
		let raw = encoding.base64decode(text.trim()) onerror (err error) {
			fail "not base64"
		}
		return string(raw)
	}

	// plainResponse is the PLAIN message (RFC 4616): no authorization
	// identity, the user and the password separated by NUL.
	def plainResponse(user string, password string) string {
		let raw byte[] = [0]
		raw = raw + user.bytes()
		raw.push(0)
		raw = raw + password.bytes()
		return encoding.base64encode(raw)
	}

	// plainFields splits a decoded PLAIN message at its NUL bytes: the
	// authorization identity, the user and the password. Fails when it
	// is not base64 or not three fields.
	def plainFields(response string) !string[] {
		let raw = encoding.base64decode(response.trim()) onerror (err error) {
			fail "not base64"
		}
		let fields string[] = []
		let start = 0
		for let i = 0; i <= raw.len(); i++ {
			continue unless i == raw.len() || raw[i] == 0
			fields.push(string(raw.slice(start, i - start)))
			start = i + 1
		}
		fail "malformed PLAIN response" unless fields.len() == 3
		return fields
	}

	// cramResponse answers a CRAM-MD5 challenge (RFC 2195): the user, a
	// space and the hex HMAC-MD5 of the challenge under the password.
	def cramResponse(user string, password string, challenge string) string {
		let mac = hash.hmac(hash.Hash.MD5, password.bytes(), challenge.bytes())
		return b64(user + " " + mac.hex().lower())
	}

	// xoauth2Response is the XOAUTH2 message: the user and the bearer
	// token.
	def xoauth2Response(user string, token string) string {
		return b64("user=" + user + "\u0001auth=Bearer " + token + "\u0001\u0001")
	}

	// dotStuffed is message data ready for DATA: every line end CRLF, a dot
	// doubled at the start of a line, and the closing `.` line (RFC 5321
	// §4.5.2).
	def dotStuffed(data byte[]) byte[] {
		let out byte[] = []
		out.cap(data.len() + data.len() / 32 + 5)
		let lineStart = true
		for let i = 0; i < data.len(); i++ {
			let b = data[i]
			out.push(0x2E) when lineStart && b == 0x2E
			lineStart = false
			if b == 0x0D {
				out.push(0x0D)
				out.push(0x0A)
				i++ when i + 1 < data.len() && data[i + 1] == 0x0A
				lineStart = true
				continue
			}
			if b == 0x0A {
				out.push(0x0D)
				out.push(0x0A)
				lineStart = true
				continue
			}
			out.push(b)
		}
		if !lineStart {
			out.push(0x0D)
			out.push(0x0A)
		}
		out.push(0x2E)
		out.push(0x0D)
		out.push(0x0A)
		return out
	}

	// hasHighBytes reports bytes outside 7-bit ASCII.
	def hasHighBytes(data byte[]) bool {
		for let b in data {
			return true when b >= 0x80
		}
		return false
	}

	// isASCII reports text of 7-bit characters only.
	def isASCII(text string) bool {
		return !hasHighBytes(text.bytes())
	}
}
