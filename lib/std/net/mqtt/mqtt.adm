partial module std.net.mqtt {
	use std.errors

	// Version is the MQTT protocol version spoken.
	enum Version {
		// MQTT 3.1.1 (OASIS, 2014).
		V311 = 4,
		// MQTT 5.0 (OASIS, 2019): reason codes, properties, shared
		// subscriptions, session and message expiry.
		V5 = 5,
	}

	// QoS is how hard a message is delivered.
	enum QoS {
		// Once at most: fire and forget.
		AtMostOnce = 0,
		// Once at least: acknowledged, may arrive twice.
		AtLeastOnce = 1,
		// Exactly once: a four-step handshake.
		ExactlyOnce = 2,
	}

	// Security picks how a connection is protected.
	enum Security {
		Plain = "plain",
		// TLS from the first byte (mqtts, port 8883).
		Implicit = "implicit",
	}

	// Message is one application message: its topic and payload, how it
	// was or is to be delivered, and the MQTT 5 properties that travel
	// with it.
	struct Message {
		topic           string
		payload         byte[]         = []
		qos             QoS            = QoS.AtMostOnce
		retain          bool           = false
		// MQTT 5: seconds the message lives on the broker; 0 forever.
		expiry          int            = 0
		// MQTT 5: a MIME type for the payload.
		contentType     string         = ""
		// MQTT 5: where a request wants its answer, and the data that
		// ties the answer to it.
		responseTopic   string         = ""
		correlationData byte[]         = []
		// MQTT 5: whether the payload is UTF-8 text.
		utf8            bool           = false
		// MQTT 5: name-value pairs, in order.
		properties      UserProperty[] = []
		// On a received message: whether it is a retransmission.
		duplicate       bool           = false
	}

	// UserProperty is one MQTT 5 user property.
	struct UserProperty {
		name  string
		value string
	}

	// text is a message's payload as UTF-8 text.
	def text(m Message) string {
		return string(m.payload)
	}

	// MqttError is the payload of a failure the broker reported (a CONNACK,
	// SUBACK or PUBACK reason code) or of a malformed packet. `code` is the
	// reason's name (`notAuthorized`, `badUserNameOrPassword`, ...),
	// `protocol` or `closed`.
	struct MqttError {
		message string
		code    string
		cause   ?error
		stack   errors.StackTrace
		// The MQTT 5 reason code (or the 3.1.1 return code).
		reason  int
	}

	// Matches reports whether a topic matches a subscription filter: `+`
	// one level, `#` the rest; wildcards at the first level do not match
	// topics starting with `$`.
	def matches(filter string, topic string) bool {
		return false when topic.startsWith("$") && (filter.startsWith("+") || filter.startsWith("#"))
		let f = filter.split("/")
		let t = topic.split("/")
		for let i = 0; i < f.len(); i++ {
			return true when f[i] == "#"
			return false when i >= t.len()
			continue when f[i] == "+"
			return false when f[i] != t[i]
		}
		return f.len() == t.len()
	}

	// Authenticator decides the connections of a `Server`.
	interface Authenticator {
		// Checks a client's credentials. Fails to refuse; the client is
		// told `badUserNameOrPassword`.
		def login(clientId string, username string, password Secret<string>) !none
	}

	// Authorizer decides what each client may publish and subscribe to.
	interface Authorizer {
		def canPublish(clientId string, username string, topic string) bool
		def canSubscribe(clientId string, username string, filter string) bool
	}

	// Users is an `Authenticator` over fixed user names and passwords.
	type Users {
		internal passwords map<string, Secret<string>>

		def new() {}

		// Lets `username` connect with `password`.
		atomic def add(username string, password Secret<string>) {
			passwords[username] = password
		}

		// Forgets a user.
		atomic def remove(username string) {
			passwords.delete(username)
		}

		// Implements Authenticator. Fails when the user is unknown or the
		// password does not match.
		atomic def login(clientId string, username string, password Secret<string>) !none {
			let want = passwords.get(username)
			fail "login refused" when want is none
			fail "login refused" unless sameText(want.reveal(), password.reveal())
			return none
		}
	}

	internal def sameText(a string, b string) bool {
		let x = a.bytes()
		let y = b.bytes()
		return false when x.len() != y.len()
		let diff = 0
		for let i = 0; i < x.len(); i++ {
			diff = diff | (int(x[i]) ^ int(y[i]))
		}
		return diff == 0
	}
}
