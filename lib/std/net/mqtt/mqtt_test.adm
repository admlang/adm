partial module std.net.mqtt {
	use (
		std.net
		std.net.http
		std.net.http.httptest
		std.net.mqtt.proto::*
		std.testing
		std.time
	)

	internal def testBroker() !Server {
		let broker = new Server("127.0.0.1:0")
		try broker.start()
		return broker
	}

	internal def clientOf(broker Server, id string, version Version = Version.V5) !Client {
		let c = new Client(id, version)
		c.timeout = 5s
		try c.connect(broker.address().str())
		return c
	}

	// Waits until `count` messages arrived in `got`, up to two seconds.
	internal def settle(got Message[], count int) {
		for let i = 0; i < 100 && got.len() < count; i++ {
			time.sleep(20ms)
		}
	}

	// Denies publishing under `secret/`.
	internal type NoSecrets {
		def new() {}

		def canPublish(clientId string, username string, topic string) bool {
			return !topic.startsWith("secret/")
		}

		def canSubscribe(clientId string, username string, filter string) bool {
			return true
		}
	}

	check "MQTT" {
		@test()
		def matchesTopics() {
			assert matches("a/+/c", "a/b/c")
			assert !matches("a/+/c", "a/b/d/c")
			assert matches("a/#", "a")
			assert matches("a/#", "a/b/c")
			assert matches("#", "x/y")
			assert !matches("#", "$SYS/uptime")
			assert matches("$SYS/#", "$SYS/uptime")
			assert !matches("a/b", "a/b/c")
			assert validFilter("a/+/#")
			assert !validFilter("a/#/b")
			assert !validFilter("a/b+")
			let (filter, group) = shareOf("$share/workers/jobs/+")
			assert filter == "jobs/+" && group == "workers"
		}

		@test()
		def roundTripsPackets() !none {
			for let version in [4, 5] {
				let p = Packet{kind: pktPublish, topic: "t/1", payload: "hi".bytes(), qos: 2, packetId: 77, retain: true}
				p.props.contentType = "text/plain"
				p.props.user = [UserProperty{name:"k", value:"v"}]
				let data = encodePacket(p, version)
				let back = try decodePacket(int(data[0]), data[2:], version)
				assert back.topic == "t/1" && back.qos == 2 && back.packetId == 77 && back.retain
				assert string(back.payload) == "hi"
				if version == 5 {
					assert back.props.contentType == "text/plain"
					assert back.props.user[0].value == "v"
				}
				let c = Packet{kind: pktConnect, clientId: "me", keepAlive: 30, hasWill: true, willTopic: "w", willPayload: "bye".bytes(), willQoS: 1}
				c.username = "u"
				c.password = "p".bytes()
				let raw = encodePacket(c, version)
				let conn = try decodePacket(int(raw[0]), raw[2:], version)
				assert conn.clientId == "me" && conn.keepAlive == 30 && conn.willTopic == "w" && conn.willQoS == 1
				assert conn.protocolLevel == version
			}
			return none
		}

		@test()
		def publishesAndSubscribesBothVersions() !none {
			let broker = try testBroker()
			for let version in [Version.V311, Version.V5] {
				let sub = try clientOf(broker, "sub-{version.value}", version)
				let got Message[] = []
				let granted = try sub.subscribe("home/+/temp", def (m Message) {
					got.push(m)
				}, QoS.ExactlyOnce)
				assert granted == QoS.ExactlyOnce
				let pub = try clientOf(broker, "pub-{version.value}", version)
				try pub.publish("home/kitchen/temp", "21", QoS.AtMostOnce)
				try pub.publish("home/hall/temp", "19".bytes(), QoS.AtLeastOnce)
				try pub.publish("home/attic/temp", "15", QoS.ExactlyOnce)
				try pub.publish("home/attic/humidity", "40", QoS.AtLeastOnce)
				settle(got, 3)
				assert got.len() == 3
				let topics = got.mapElem<string>(m => m.topic)
				assert topics.includes("home/attic/temp")
				// Retained: a later subscriber gets the last value at once.
				try pub.publish("status/door", "open", QoS.AtLeastOnce, retain = true)
				let late = try clientOf(broker, "late-{version.value}", version)
				try late.subscribe("status/#", QoS.AtLeastOnce)
				let first = try late.receive(2s)
				fail "no retained message" when first is none
				assert text(first) == "open" && first.retain
				try sub.unsubscribe("home/+/temp")
				try pub.publish("home/kitchen/temp", "22", QoS.AtLeastOnce)
				time.sleep(100ms)
				assert got.len() == 3
				try sub.close()
				try pub.close()
				try late.close()
			}
			try broker.close()
			return none
		}

		@test()
		def willsAndSessions() !none {
			let broker = try testBroker()
			let watcher = try clientOf(broker, "watcher")
			try watcher.subscribe("clients/+/status", QoS.AtLeastOnce)
			// A client that drops without DISCONNECT has its will published.
			let raw = try net.dialStream(broker.address().str(), 5s)
			let connect = Packet{kind: pktConnect, clientId: "fragile", keepAlive: 60, hasWill: true, willTopic: "clients/fragile/status", willPayload: "gone".bytes(), willQoS: 1}
			try raw.writeAll(encodePacket(connect, 5))
			let lines = new net.LineReader(raw, 1)
			let ack = try readPacket(lines, 5, 0, 5s)
			assert ack.kind == pktConnack && ack.reason == 0
			try raw.close()
			let will = try watcher.receive(3s)
			fail "no will" when will is none
			assert text(will) == "gone"
			// A persistent session gets what was published while it was away.
			let durable = new Client("durable")
			durable.cleanStart = false
			durable.sessionExpiry = 60s
			try durable.connect(broker.address().str())
			try durable.subscribe("jobs/#", QoS.AtLeastOnce)
			try durable.close()
			let producer = try clientOf(broker, "producer")
			try producer.publish("jobs/1", "work", QoS.AtLeastOnce)
			let back = new Client("durable")
			back.cleanStart = false
			back.sessionExpiry = 60s
			try back.connect(broker.address().str())
			let job = try back.receive(3s)
			fail "no queued job" when job is none
			assert text(job) == "work"
			try back.close()
			try producer.close()
			try watcher.close()
			try broker.close()
			return none
		}

		@test()
		def sharingNoLocalAndRequests() !none {
			let broker = try testBroker()
			let a = try clientOf(broker, "worker-a")
			let b = try clientOf(broker, "worker-b")
			let gotA Message[] = []
			let gotB Message[] = []
			try a.subscribe("$share/pool/tasks/#", def (m Message) {
				gotA.push(m)
			})
			try b.subscribe("$share/pool/tasks/#", def (m Message) {
				gotB.push(m)
			})
			let boss = try clientOf(broker, "boss")
			for let i = 0; i < 10; i++ {
				try boss.publish("tasks/{i}", "t", QoS.AtLeastOnce)
			}
			for let i = 0; i < 100 && gotA.len() + gotB.len() < 10; i++ {
				time.sleep(20ms)
			}
			assert gotA.len() + gotB.len() == 10
			assert gotA.len() > 0 && gotB.len() > 0
			// noLocal: a client does not hear itself.
			let echo = try clientOf(broker, "echo")
			try echo.subscribe("chat", QoS.AtLeastOnce, noLocal = true)
			try echo.publish("chat", "me", QoS.AtLeastOnce)
			assert (try echo.receive(300ms)) is none
			// Request/response.
			let server = try clientOf(broker, "responder")
			try server.subscribe("rpc/add", def (m Message) {
				server.publish(Message{topic: m.responseTopic, payload: "3".bytes(), correlationData: m.correlationData, qos: QoS.AtLeastOnce}) onerror recover none
			})
			let answer = try boss.request("rpc/add", "1+2", 3s)
			assert text(answer) == "3"
			try broker.close()
			return none
		}

		@test()
		def authenticatesAndAuthorizes() !none {
			let broker = new Server("127.0.0.1:0")
			let users = new Users()
			users.add("alice", "s3cret")
			broker.authenticator = users
			broker.authorizer = new NoSecrets()
			try broker.start()
			let bad = new Client("x")
			bad.username = "alice"
			bad.password = "nope"
			let code = ""
			bad.connect(broker.address().str()) onerror (err error) {
				code = err.code
				recover none
			}
			assert code == "badUserNameOrPassword"
			let good = new Client("y")
			good.username = "alice"
			good.password = "s3cret"
			try good.connect(broker.address().str())
			let denied = ""
			good.publish("secret/plans", "x", QoS.AtLeastOnce) onerror (err error) {
				denied = err.code
				recover none
			}
			assert denied == "notAuthorized"
			try good.publish("open/news", "x", QoS.AtLeastOnce)
			try good.close()
			try broker.close()
			return none
		}

		@test()
		def reconnectsAfterBrokerRestart() !none {
			let first = try testBroker()
			let addr = first.address().str()
			let c = new Client("comeback")
			c.autoReconnect = true
			c.cleanStart = false
			c.sessionExpiry = 60s
			try c.connect(addr)
			let got Message[] = []
			try c.subscribe("news", def (m Message) {
				got.push(m)
			})
			try first.close()
			// A new broker knows no session: the client subscribes again.
			let second = new Server(addr)
			try second.start()
			for let i = 0; i < 100 && !c.isConnected(); i++ {
				time.sleep(50ms)
			}
			assert c.isConnected()
			let pub = try clientOf(second, "reporter")
			for let i = 0; i < 100 && got.len() == 0; i++ {
				try pub.publish("news", "back", QoS.AtLeastOnce)
				time.sleep(50ms)
			}
			assert got.len() > 0 && text(got[0]) == "back"
			try c.close()
			try pub.close()
			try second.close()
			return none
		}

		@test()
		def speaksOverWebSocket() !none {
			let broker = try testBroker()
			let mux = new http.ServeMux()
			try mux.handle("GET /mqtt", broker.webSocketHandler())
			let site = new httptest.Server(mux)
			try site.start()
			let c = new Client("ws-client")
			try c.connect("ws://{site.address().str()}/mqtt")
			try c.subscribe("ws/test", QoS.AtLeastOnce)
			try c.publish("ws/test", "over websocket", QoS.AtLeastOnce)
			let m = try c.receive(3s)
			fail "no message over WebSocket" when m is none
			assert text(m) == "over websocket"
			try c.close()
			try site.close()
			try broker.close()
			return none
		}
	}
}
