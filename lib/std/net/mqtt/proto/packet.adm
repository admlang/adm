internal partial module std.net.mqtt.proto {
	use (
		std.net
		std.net.mqtt::(Message, MqttError, QoS, UserProperty)
	)

	// MQTT control packets (MQTT 3.1.1 §2-3, MQTT 5.0 §2-3) in both
	// versions, and the MQTT 5 properties.

	const (
		pktConnect     = 1
		pktConnack     = 2
		pktPublish     = 3
		pktPuback      = 4
		pktPubrec      = 5
		pktPubrel      = 6
		pktPubcomp     = 7
		pktSubscribe   = 8
		pktSuback      = 9
		pktUnsubscribe = 10
		pktUnsuback    = 11
		pktPingreq     = 12
		pktPingresp    = 13
		pktDisconnect  = 14
		pktAuth        = 15
	)

	// MQTT 5 property identifiers.
	const (
		propPayloadFormat      = 1
		propMessageExpiry      = 2
		propContentType        = 3
		propResponseTopic      = 8
		propCorrelationData    = 9
		propSubscriptionId     = 11
		propSessionExpiry      = 17
		propAssignedClientId   = 18
		propServerKeepAlive    = 19
		propAuthMethod         = 21
		propAuthData           = 22
		propRequestProblemInfo = 23
		propWillDelay          = 24
		propRequestResponse    = 25
		propResponseInfo       = 26
		propServerReference    = 28
		propReasonString       = 31
		propReceiveMaximum     = 33
		propTopicAliasMaximum  = 34
		propTopicAlias         = 35
		propMaximumQoS         = 36
		propRetainAvailable    = 37
		propUserProperty       = 38
		propMaximumPacketSize  = 39
		propWildcardAvailable  = 40
		propSubIdAvailable     = 41
		propSharedAvailable    = 42
	)

	// The MQTT 5 properties of a packet; -1 for a number that is absent.
	struct Props {
		payloadFormat     int            = -1
		messageExpiry     int64          = -1
		contentType       string         = ""
		responseTopic     string         = ""
		correlationData   byte[]         = []
		subscriptionIds   int[]          = []
		sessionExpiry     int64          = -1
		assignedClientId  string         = ""
		serverKeepAlive   int            = -1
		authMethod        string         = ""
		authData          byte[]         = []
		willDelay         int64          = -1
		requestProblem    int            = -1
		requestResponse   int            = -1
		responseInfo      string         = ""
		serverReference   string         = ""
		reasonString      string         = ""
		receiveMaximum    int            = -1
		topicAliasMaximum int            = -1
		topicAlias        int            = -1
		maximumQoS        int            = -1
		retainAvailable   int            = -1
		maximumPacketSize int64          = -1
		wildcardAvailable int            = -1
		subIdAvailable    int            = -1
		sharedAvailable   int            = -1
		user              UserProperty[] = []
	}

	// One subscription of a SUBSCRIBE: the filter and its options.
	struct Subscription {
		filter            string
		qos               int    = 0
		noLocal           bool   = false
		retainAsPublished bool   = false
		// 0 send retained, 1 only for a new subscription, 2 never.
		retainHandling    int    = 0
	}

	// Packet is one control packet, decoded or to be encoded.
	struct Packet {
		kind           int
		flags          int            = 0
		// CONNECT.
		protocolLevel  int            = 5
		cleanStart     bool           = true
		keepAlive      int            = 60
		clientId       string         = ""
		hasWill        bool           = false
		willQoS        int            = 0
		willRetain     bool           = false
		willTopic      string         = ""
		willPayload    byte[]         = []
		willProps      Props
		username       ?string        = none
		password       ?byte[]        = none
		// CONNACK, PUBACK/REC/REL/COMP, DISCONNECT, AUTH: the reason code.
		sessionPresent bool           = false
		reason         int            = 0
		// PUBLISH.
		topic          string         = ""
		packetId       int            = 0
		payload        byte[]         = []
		qos            int            = 0
		retain         bool           = false
		duplicate      bool           = false
		// SUBSCRIBE, UNSUBSCRIBE: subscriptions or filters; SUBACK,
		// UNSUBACK: reason codes.
		subscriptions  Subscription[] = []
		filters        string[]       = []
		reasons        int[]          = []
		props          Props
	}

	def protocolFailure(text string) error {
		return MqttError{message: "mqtt: " + text, code: "protocol", reason: 0x82}
	}

	// ---- writing ----

	type Out {
		data byte[] = []

		def new() {}

		def byte1(v int) Out {
			data.push(byte(v))
			return self
		}

		def int16(v int) Out {
			data.push(byte(v >> 8))
			data.push(byte(v))
			return self
		}

		def int32(v int64) Out {
			data.push(byte(v >> 24))
			data.push(byte(v >> 16))
			data.push(byte(v >> 8))
			data.push(byte(v))
			return self
		}

		def varint(v int) Out {
			let n = v
			for {
				let b = n % 128
				n = n / 128
				data.push(byte(n > 0 ?? (b | 0x80, b)))
				break when n == 0
			}
			return self
		}

		def text(s string) Out {
			return binary(s.bytes())
		}

		def binary(b byte[]) Out {
			self.int16(b.len())
			data = data + b
			return self
		}

		def raw(b byte[]) Out {
			data = data + b
			return self
		}
	}

	def encodeProps(p Props) byte[] {
		let o = new Out()
		o.byte1(propPayloadFormat).byte1(p.payloadFormat) when p.payloadFormat >= 0
		o.byte1(propMessageExpiry).int32(p.messageExpiry) when p.messageExpiry >= 0
		o.byte1(propContentType).text(p.contentType) when p.contentType != ""
		o.byte1(propResponseTopic).text(p.responseTopic) when p.responseTopic != ""
		o.byte1(propCorrelationData).binary(p.correlationData) when p.correlationData.len() > 0
		for let id in p.subscriptionIds {
			o.byte1(propSubscriptionId).varint(id)
		}
		o.byte1(propSessionExpiry).int32(p.sessionExpiry) when p.sessionExpiry >= 0
		o.byte1(propAssignedClientId).text(p.assignedClientId) when p.assignedClientId != ""
		o.byte1(propServerKeepAlive).int16(p.serverKeepAlive) when p.serverKeepAlive >= 0
		o.byte1(propAuthMethod).text(p.authMethod) when p.authMethod != ""
		o.byte1(propAuthData).binary(p.authData) when p.authData.len() > 0
		o.byte1(propRequestProblemInfo).byte1(p.requestProblem) when p.requestProblem >= 0
		o.byte1(propWillDelay).int32(p.willDelay) when p.willDelay >= 0
		o.byte1(propRequestResponse).byte1(p.requestResponse) when p.requestResponse >= 0
		o.byte1(propResponseInfo).text(p.responseInfo) when p.responseInfo != ""
		o.byte1(propServerReference).text(p.serverReference) when p.serverReference != ""
		o.byte1(propReasonString).text(p.reasonString) when p.reasonString != ""
		o.byte1(propReceiveMaximum).int16(p.receiveMaximum) when p.receiveMaximum >= 0
		o.byte1(propTopicAliasMaximum).int16(p.topicAliasMaximum) when p.topicAliasMaximum >= 0
		o.byte1(propTopicAlias).int16(p.topicAlias) when p.topicAlias >= 0
		o.byte1(propMaximumQoS).byte1(p.maximumQoS) when p.maximumQoS >= 0
		o.byte1(propRetainAvailable).byte1(p.retainAvailable) when p.retainAvailable >= 0
		for let u in p.user {
			o.byte1(propUserProperty).text(u.name).text(u.value)
		}
		o.byte1(propMaximumPacketSize).int32(p.maximumPacketSize) when p.maximumPacketSize >= 0
		o.byte1(propWildcardAvailable).byte1(p.wildcardAvailable) when p.wildcardAvailable >= 0
		o.byte1(propSubIdAvailable).byte1(p.subIdAvailable) when p.subIdAvailable >= 0
		o.byte1(propSharedAvailable).byte1(p.sharedAvailable) when p.sharedAvailable >= 0
		return new Out().varint(o.data.len()).raw(o.data).data
	}

	// The whole packet: fixed header, variable header and payload.
	def encodePacket(p Packet, version int) byte[] {
		let v5 = version == 5
		let body = new Out()
		let flags = 0
		switch {
			case p.kind == pktConnect:
				body.text("MQTT").byte1(version)
				let cf = 0
				cf = cf | 0x02 when p.cleanStart
				if p.hasWill {
					cf = cf | 0x04 | (p.willQoS << 3)
					cf = cf | 0x20 when p.willRetain
				}
				cf = cf | 0x80 unless p.username is none
				cf = cf | 0x40 unless p.password is none
				body.byte1(cf).int16(p.keepAlive)
				body.raw(encodeProps(p.props)) when v5
				body.text(p.clientId)
				if p.hasWill {
					body.raw(encodeProps(p.willProps)) when v5
					body.text(p.willTopic).binary(p.willPayload)
				}
				let user = p.username
				body.text(user) unless user is none
				let pass = p.password
				body.binary(pass) unless pass is none
			case p.kind == pktConnack:
				body.byte1(p.sessionPresent ?? (1, 0)).byte1(p.reason)
				body.raw(encodeProps(p.props)) when v5
			case p.kind == pktPublish:
				flags = (p.qos << 1)
				flags = flags | 0x08 when p.duplicate
				flags = flags | 0x01 when p.retain
				body.text(p.topic)
				body.int16(p.packetId) when p.qos > 0
				body.raw(encodeProps(p.props)) when v5
				body.raw(p.payload)
			case p.kind := pktPuback || pktPubrec || pktPubrel || pktPubcomp:
				flags = p.kind == pktPubrel ?? (0x02, 0)
				body.int16(p.packetId)
				if v5 && (p.reason != 0 || p.props.reasonString != "" || p.props.user.len() > 0) {
					body.byte1(p.reason)
					body.raw(encodeProps(p.props))
				}
			case p.kind == pktSubscribe:
				flags = 0x02
				body.int16(p.packetId)
				body.raw(encodeProps(p.props)) when v5
				for let s in p.subscriptions {
					let options = s.qos
					if v5 {
						options = options | 0x04 when s.noLocal
						options = options | 0x08 when s.retainAsPublished
						options = options | (s.retainHandling << 4)
					}
					body.text(s.filter).byte1(options)
				}
			case p.kind == pktSuback || p.kind == pktUnsuback:
				body.int16(p.packetId)
				body.raw(encodeProps(p.props)) when v5
				if v5 || p.kind == pktSuback {
					for let r in p.reasons {
						body.byte1(r)
					}
				}
			case p.kind == pktUnsubscribe:
				flags = 0x02
				body.int16(p.packetId)
				body.raw(encodeProps(p.props)) when v5
				for let f in p.filters {
					body.text(f)
				}
			case p.kind == pktDisconnect || p.kind == pktAuth:
				if v5 && (p.reason != 0 || p.kind == pktAuth || p.props.reasonString != "" || p.props.sessionExpiry >= 0) {
					body.byte1(p.reason)
					body.raw(encodeProps(p.props))
				}
		}
		let header = new Out().byte1((p.kind << 4) | flags).varint(body.data.len())
		return header.data + body.data
	}

	// ---- reading ----

	type In {
		data byte[]
		pos  int    = 0

		def new(data byte[]) {
			self.data = data
		}

		def left() int {
			return data.len() - pos
		}

		def byte1() !int {
			fail protocolFailure("packet too short") when pos >= data.len()
			pos++
			return int(data[pos - 1])
		}

		def int16() !int {
			fail protocolFailure("packet too short") when pos + 2 > data.len()
			let v = (int(data[pos]) << 8) | int(data[pos + 1])
			pos += 2
			return v
		}

		def int32() !int64 {
			fail protocolFailure("packet too short") when pos + 4 > data.len()
			let v = (int64(data[pos]) << 24) | (int64(data[pos + 1]) << 16) | (int64(data[pos + 2]) << 8) | int64(data[pos + 3])
			pos += 4
			return v
		}

		def varint() !int {
			let value = 0
			let shift = 0
			for {
				let b = try byte1()
				value = value | ((b & 0x7f) << shift)
				break when (b & 0x80) == 0
				shift += 7
				fail protocolFailure("variable byte integer too long") when shift > 21
			}
			return value
		}

		def binary() !byte[] {
			let n = try int16()
			fail protocolFailure("field runs past the packet") when pos + n > data.len()
			let v = data[pos:pos + n].clone()
			pos += n
			return v
		}

		def text() !string {
			return string(try binary())
		}

		def rest() byte[] {
			let v = data[pos:].clone()
			pos = data.len()
			return v
		}
	}

	def decodeProps(r In) !Props {
		let p = Props{}
		let length = try r.varint()
		let end = r.pos + length
		fail protocolFailure("properties run past the packet") when end > r.data.len()
		for r.pos < end {
			let id = try r.varint()
			switch {
				case id == propPayloadFormat:
					p.payloadFormat = try r.byte1()
				case id == propMessageExpiry:
					p.messageExpiry = try r.int32()
				case id == propContentType:
					p.contentType = try r.text()
				case id == propResponseTopic:
					p.responseTopic = try r.text()
				case id == propCorrelationData:
					p.correlationData = try r.binary()
				case id == propSubscriptionId:
					p.subscriptionIds.push(try r.varint())
				case id == propSessionExpiry:
					p.sessionExpiry = try r.int32()
				case id == propAssignedClientId:
					p.assignedClientId = try r.text()
				case id == propServerKeepAlive:
					p.serverKeepAlive = try r.int16()
				case id == propAuthMethod:
					p.authMethod = try r.text()
				case id == propAuthData:
					p.authData = try r.binary()
				case id == propRequestProblemInfo:
					p.requestProblem = try r.byte1()
				case id == propWillDelay:
					p.willDelay = try r.int32()
				case id == propRequestResponse:
					p.requestResponse = try r.byte1()
				case id == propResponseInfo:
					p.responseInfo = try r.text()
				case id == propServerReference:
					p.serverReference = try r.text()
				case id == propReasonString:
					p.reasonString = try r.text()
				case id == propReceiveMaximum:
					p.receiveMaximum = try r.int16()
				case id == propTopicAliasMaximum:
					p.topicAliasMaximum = try r.int16()
				case id == propTopicAlias:
					p.topicAlias = try r.int16()
				case id == propMaximumQoS:
					p.maximumQoS = try r.byte1()
				case id == propRetainAvailable:
					p.retainAvailable = try r.byte1()
				case id == propUserProperty:
					let name = try r.text()
					p.user.push(UserProperty{name: name, value: try r.text()})
				case id == propMaximumPacketSize:
					p.maximumPacketSize = try r.int32()
				case id == propWildcardAvailable:
					p.wildcardAvailable = try r.byte1()
				case id == propSubIdAvailable:
					p.subIdAvailable = try r.byte1()
				case id == propSharedAvailable:
					p.sharedAvailable = try r.byte1()
				default:
					fail protocolFailure("unknown property {id}")
			}
		}
		return p
	}

	// Reads one packet off the stream. `version` 0 reads a CONNECT whose
	// version is not known yet. Fails when the stream ends, the packet is
	// longer than `maxSize`, or it is malformed.
	def readPacket(lines net.LineReader, version int, maxSize int, wait duration) !Packet {
		let first = int((try lines.readBytes(1, wait))[0])
		let length = 0
		let shift = 0
		for {
			let b = int((try lines.readBytes(1, wait))[0])
			length = length | ((b & 0x7f) << shift)
			break when (b & 0x80) == 0
			shift += 7
			fail protocolFailure("remaining length too long") when shift > 21
		}
		fail MqttError{message: "mqtt: packet of {length} bytes is too large", code: "packetTooLarge", reason: 0x95} when maxSize > 0 && length > maxSize
		let body = try lines.readBytes(length, wait)
		return try decodePacket(first, body, version)
	}

	def decodePacket(first int, body byte[], version int) !Packet {
		let p = Packet{kind: first >> 4, flags: first & 0x0f}
		let r = new In(body)
		let v5 = version == 5
		switch {
			case p.kind == pktConnect:
				let name = try r.text()
				fail protocolFailure("protocol {name} is not MQTT") unless name := "MQTT" || "MQIsdp"
				p.protocolLevel = try r.byte1()
				let v5c = p.protocolLevel == 5
				let cf = try r.byte1()
				fail protocolFailure("reserved connect flag set") when (cf & 0x01) != 0
				p.cleanStart = (cf & 0x02) != 0
				p.hasWill = (cf & 0x04) != 0
				p.willQoS = (cf >> 3) & 0x03
				p.willRetain = (cf & 0x20) != 0
				p.keepAlive = try r.int16()
				p.props = try decodeProps(r) when v5c
				p.clientId = try r.text()
				if p.hasWill {
					p.willProps = try decodeProps(r) when v5c
					p.willTopic = try r.text()
					p.willPayload = try r.binary()
				}
				p.username = try r.text() when (cf & 0x80) != 0
				p.password = try r.binary() when (cf & 0x40) != 0
			case p.kind == pktConnack:
				p.sessionPresent = ((try r.byte1()) & 0x01) != 0
				p.reason = try r.byte1()
				p.props = try decodeProps(r) when v5 && r.left() > 0
			case p.kind == pktPublish:
				p.qos = (p.flags >> 1) & 0x03
				fail protocolFailure("PUBLISH with QoS 3") when p.qos == 3
				p.retain = (p.flags & 0x01) != 0
				p.duplicate = (p.flags & 0x08) != 0
				p.topic = try r.text()
				p.packetId = try r.int16() when p.qos > 0
				p.props = try decodeProps(r) when v5
				p.payload = r.rest()
			case p.kind := pktPuback || pktPubrec || pktPubrel || pktPubcomp:
				p.packetId = try r.int16()
				if v5 && r.left() > 0 {
					p.reason = try r.byte1()
					p.props = try decodeProps(r) when r.left() > 0
				}
			case p.kind == pktSubscribe:
				p.packetId = try r.int16()
				p.props = try decodeProps(r) when v5
				for r.left() > 0 {
					let filter = try r.text()
					let options = try r.byte1()
					p.subscriptions.push(Subscription{filter: filter, qos: options & 0x03, noLocal: (options & 0x04) != 0, retainAsPublished: (options & 0x08) != 0, retainHandling: (options >> 4) & 0x03})
				}
			case p.kind == pktSuback || p.kind == pktUnsuback:
				p.packetId = try r.int16()
				p.props = try decodeProps(r) when v5
				for r.left() > 0 {
					p.reasons.push(try r.byte1())
				}
			case p.kind == pktUnsubscribe:
				p.packetId = try r.int16()
				p.props = try decodeProps(r) when v5
				for r.left() > 0 {
					p.filters.push(try r.text())
				}
			case p.kind == pktDisconnect || p.kind == pktAuth:
				if v5 && r.left() > 0 {
					p.reason = try r.byte1()
					p.props = try decodeProps(r) when r.left() > 0
				}
			case p.kind == pktPingreq || p.kind == pktPingresp:
			default:
				fail protocolFailure("unknown packet type {p.kind}")
		}
		return p
	}

	// The application message a PUBLISH carries.
	def messageOf(p Packet) Message {
		let m = Message{topic: p.topic, payload: p.payload, qos: qosOf(p.qos), retain: p.retain, duplicate: p.duplicate}
		m.expiry = int(p.props.messageExpiry) when p.props.messageExpiry > 0
		m.contentType = p.props.contentType
		m.responseTopic = p.props.responseTopic
		m.correlationData = p.props.correlationData
		m.utf8 = p.props.payloadFormat == 1
		m.properties = p.props.user
		return m
	}

	// A PUBLISH carrying a message.
	def publishOf(m Message, qos int, packetId int) Packet {
		let p = Packet{kind: pktPublish, topic: m.topic, payload: m.payload, qos: qos, retain: m.retain, packetId: packetId}
		p.props.messageExpiry = int64(m.expiry) when m.expiry > 0
		p.props.contentType = m.contentType
		p.props.responseTopic = m.responseTopic
		p.props.correlationData = m.correlationData
		p.props.payloadFormat = 1 when m.utf8
		p.props.user = m.properties
		return p
	}

	def qosOf(n int) QoS {
		return QoS.ExactlyOnce when n == 2
		return QoS.AtLeastOnce when n == 1
		return QoS.AtMostOnce
	}

	// The name of a reason code (MQTT 5 §2.4, and the 3.1.1 CONNACK codes
	// mapped onto them).
	def reasonName(code int) string {
		switch {
			case code == 0:
				return "success"
			case code == 1:
				return "grantedQoS1"
			case code == 2:
				return "grantedQoS2"
			case code == 4:
				return "disconnectWithWill"
			case code == 16:
				return "noMatchingSubscribers"
			case code == 17:
				return "noSubscriptionExisted"
			case code == 0x80:
				return "unspecifiedError"
			case code == 0x81:
				return "malformedPacket"
			case code == 0x82:
				return "protocolError"
			case code == 0x83:
				return "implementationSpecificError"
			case code == 0x84:
				return "unsupportedProtocolVersion"
			case code == 0x85:
				return "clientIdentifierNotValid"
			case code == 0x86:
				return "badUserNameOrPassword"
			case code == 0x87:
				return "notAuthorized"
			case code == 0x88:
				return "serverUnavailable"
			case code == 0x89:
				return "serverBusy"
			case code == 0x8A:
				return "banned"
			case code == 0x8B:
				return "serverShuttingDown"
			case code == 0x8C:
				return "badAuthenticationMethod"
			case code == 0x8D:
				return "keepAliveTimeout"
			case code == 0x8E:
				return "sessionTakenOver"
			case code == 0x8F:
				return "topicFilterInvalid"
			case code == 0x90:
				return "topicNameInvalid"
			case code == 0x91:
				return "packetIdentifierInUse"
			case code == 0x92:
				return "packetIdentifierNotFound"
			case code == 0x93:
				return "receiveMaximumExceeded"
			case code == 0x94:
				return "topicAliasInvalid"
			case code == 0x95:
				return "packetTooLarge"
			case code == 0x96:
				return "messageRateTooHigh"
			case code == 0x97:
				return "quotaExceeded"
			case code == 0x98:
				return "administrativeAction"
			case code == 0x99:
				return "payloadFormatInvalid"
			case code == 0x9A:
				return "retainNotSupported"
			case code == 0x9B:
				return "qosNotSupported"
			case code == 0x9C:
				return "useAnotherServer"
			case code == 0x9D:
				return "serverMoved"
			case code == 0x9E:
				return "sharedSubscriptionsNotSupported"
			case code == 0x9F:
				return "connectionRateExceeded"
			case code == 0xA0:
				return "maximumConnectTime"
			case code == 0xA1:
				return "subscriptionIdentifiersNotSupported"
			case code == 0xA2:
				return "wildcardSubscriptionsNotSupported"
		}
		return "reason{code}"
	}

	// A 3.1.1 CONNACK return code as the MQTT 5 reason it stands for.
	def connackReason311(code int) int {
		return 0 when code == 0
		return 0x84 when code == 1
		return 0x85 when code == 2
		return 0x88 when code == 3
		return 0x86 when code == 4
		return 0x87
	}

	// The 3.1.1 CONNACK return code for an MQTT 5 reason.
	def connack311(reason int) int {
		return 0 when reason == 0
		return 1 when reason == 0x84
		return 2 when reason == 0x85
		return 4 when reason == 0x86
		return 5 when reason == 0x87
		return 3
	}

	def mqttError(code int, text string) error {
		let name = reasonName(code)
		return MqttError{message: "mqtt: " + (text == "" ?? (name, "{name}: {text}")), code: name, reason: code}
	}
}
