internal partial module std.net.mqtt.proto {
	use (
		std.net
		std.net.http.websocket
	)

	// WsStream carries MQTT over a WebSocket (MQTT 5.0 §6): binary
	// messages read as one byte stream. Implements `net.Stream`.
	type WsStream {
		conn                 websocket.Conn
		internal buffer      byte[]         = []
		internal atomic open bool           = true

		def new(conn websocket.Conn) {
			self.conn = conn
		}

		// Reads what the next binary messages hold; 0 once the peer
		// closed. Fails when the connection breaks.
		def read(data byte[], timeout duration) !int {
			return 0 when data.len() == 0
			for buffer.len() == 0 {
				return 0 unless open
				let ended = false
				let (kind, payload) = conn.readMessage() onerror (err error) {
					ended = true
					recover (websocket.MessageType.Binary, byte[])
				}
				if ended {
					open = false
					return 0
				}
				buffer = payload when kind == websocket.MessageType.Binary
			}
			let n = buffer.len() < data.len() ?? (buffer.len(), data.len())
			buffer[:n].copy(data)
			buffer = buffer[n:].clone()
			return n
		}

		// Sends `data` as one binary message. Fails when the connection
		// breaks.
		def write(data byte[], timeout duration) !int {
			try conn.writeMessage(websocket.MessageType.Binary, data.clone())
			return data.len()
		}

		def close() !none {
			open = false
			conn.close() onerror recover none
			return none
		}

		def isOpen() bool {
			return open
		}
	}
}
