partial module std.net.multipart {
	use (
		std.bytes
		std.os
		std.testing
	)

	// orText reads an optional lookup as text, "" when absent.
	internal def orText(value ?string) string {
		return "" when value is none
		return value
	}

	// body is a two-part form: a text field and a file, with a preamble and
	// an epilogue around the boundaries.
	internal def sampleBody(nl string) string {
		return "preamble ignored" + nl +
			"--xYz" + nl +
			"Content-Disposition: form-data; name=\"title\"" + nl +
			nl +
			"holiday" + nl +
			"--xYz" + nl +
			"Content-Disposition: form-data; name=\"photo\"; filename=\"dir/beach.jpg\"" + nl +
			"Content-Type: image/jpeg" + nl +
			"X-Note: first line" + nl +
			" folded tail" + nl +
			nl +
			"JPEG DATA" + nl +
			"with" + nl +
			nl +
			"blank line" + nl +
			"--xYz--" + nl +
			"epilogue ignored"
	}

	check "Reader" {
		@test()
		def readsPartsWithCrLf() !none {
			let reader = new Reader(new bytes.Buffer(sampleBody("\r\n").bytes()), "xYz")
			let first = try reader.nextPart()
			assert !(first is none)
			if first is none {
				return none
			}
			assert first.formName() == "title"
			assert first.fileName() is none
			assert (try first.contentType()).essence() == "text/plain"
			assert try first.text() == "holiday"
			let second = try reader.nextPart()
			if second is none {
				assert false
				return none
			}
			assert second.formName() == "photo"
			assert orText(second.fileName()) == "beach.jpg"
			assert (try second.contentType()).essence() == "image/jpeg"
			assert second.header("x-note") == "first line folded tail"
			assert second.header("missing") == ""
			assert try second.text() == "JPEG DATA\r\nwith\r\n\r\nblank line"
			assert (try reader.nextPart()) is none
			assert (try reader.nextPart()) is none
			return none
		}

		@test()
		def readsPartsWithBareLf() !none {
			let reader = new Reader(new bytes.Buffer(sampleBody("\n").bytes()), "xYz")
			let first = try reader.nextPart()
			if first is none {
				assert false
				return none
			}
			assert try first.text() == "holiday"
			let second = try reader.nextPart()
			if second is none {
				assert false
				return none
			}
			assert try second.text() == "JPEG DATA\nwith\n\nblank line"
			assert (try reader.nextPart()) is none
			return none
		}

		@test()
		def skipsUnreadPartsAndReadsEmptyOnes() !none {
			let body = "--b\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\n1\r\n--b\r\nContent-Disposition: form-data; name=\"empty\"\r\n\r\n--b\r\nContent-Disposition: form-data; name=\"c\"\r\n\r\n3\r\n--b--\r\n"
			let reader = new Reader(new bytes.Buffer(body.bytes()), "b")
			let a = try reader.nextPart()
			assert !(a is none)
			let blank = try reader.nextPart()
			if blank is none {
				assert false
				return none
			}
			assert blank.formName() == "empty"
			assert try blank.text() == ""
			let c = try reader.nextPart()
			if c is none {
				assert false
				return none
			}
			assert try c.text() == "3"
			assert (try reader.nextPart()) is none
			return none
		}

		@test()
		def readsLargePartsInChunks() !none {
			let payload = "0123456789".repeat(2000)
			let body = "--b\r\nContent-Disposition: form-data; name=\"big\"\r\n\r\n" + payload + "\r\n--b--\r\n"
			let reader = new Reader(new bytes.Buffer(body.bytes()), "b")
			let part = try reader.nextPart()
			if part is none {
				assert false
				return none
			}
			let buf byte[] = []
			buf.len(700)
			let total = 0
			for {
				let n = try part.read(buf)
				break when n == 0
				total += n
			}
			assert total == payload.len()
			assert (try reader.nextPart()) is none
			return none
		}

		@test()
		def rejectsMalformedBodies() !none {
			let noBoundary = new Reader(new bytes.Buffer("just text\r\n".bytes()), "b")
			assert noBoundary.nextPart() is error
			let unterminated = new Reader(new bytes.Buffer("--b\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nvalue without end".bytes()), "b")
			let part = try unterminated.nextPart()
			if part is none {
				assert false
				return none
			}
			assert part.bytes() is error
			let badHeader = new Reader(new bytes.Buffer("--b\r\nno colon here\r\n\r\nx\r\n--b--\r\n".bytes()), "b")
			assert badHeader.nextPart() is error
			assert readerFor(new bytes.Buffer([]), "text/plain") is error
			assert readerFor(new bytes.Buffer([]), "multipart/form-data") is error
			assert readerFor(new bytes.Buffer([]), "not a type") is error
			let err = readerFor(new bytes.Buffer([]), "multipart/mixed") onerror (e error) {
				assert e is MultipartError
				recover new Reader(new bytes.Buffer([]), "x")
			}
			assert err.boundary == "x"
			return none
		}
	}

	check "Form" {
		@test()
		def readsFieldsAndFilesInMemory() !none {
			let reader = try readerFor(new bytes.Buffer(sampleBody("\r\n").bytes()), "multipart/form-data; boundary=xYz")
			let form = try reader.readForm(1024 * 1024)
			assert orText(form.values.get("title")) == "holiday"
			assert form.filesFor("photo").len() == 1
			assert form.filesFor("missing").len() == 0
			let photo = form.filesFor("photo")[0]
			assert photo.field == "photo"
			assert photo.filename == "beach.jpg"
			assert photo.size == "JPEG DATA\r\nwith\r\n\r\nblank line".len()
			assert !photo.spilled()
			assert (try photo.contentType()).essence() == "image/jpeg"
			let opened = try photo.open()
			assert string(try opened.bytes()) == "JPEG DATA\r\nwith\r\n\r\nblank line"
			try opened.close()
			try form.removeAll()
			return none
		}

		@test()
		def spillsLargeFilesToDisk() !none {
			let reader = try readerFor(new bytes.Buffer(sampleBody("\r\n").bytes()), "multipart/form-data; boundary=xYz")
			reader.tempDir = try os.appHome()
			let form = try reader.readForm(4)
			let photo = form.filesFor("photo")[0]
			assert photo.spilled()
			assert try os.exists(photo.tempPath)
			assert photo.size == "JPEG DATA\r\nwith\r\n\r\nblank line".len()
			let opened = try photo.open()
			assert string(try opened.bytes()) == "JPEG DATA\r\nwith\r\n\r\nblank line"
			let path = photo.tempPath
			try form.removeAll()
			assert !(try os.exists(path))
			assert !photo.spilled()
			try form.removeAll()
			return none
		}
	}

	check "Writer" {
		@test()
		def roundTripsThroughReader() !none {
			let sink = new bytes.Buffer()
			let w = new Writer(sink)
			try w.chooseBoundary("simple-boundary_1")
			try w.writeField("title", "holiday")
			let file = try w.createFormFile("photo", "beach \"1\".jpg")
			try file.write("JPEG".bytes())
			try file.writeString(" DATA")
			try w.close()
			try w.close()
			assert w.formDataContentType() == "multipart/form-data; boundary=simple-boundary_1"
			let text = string(sink.bytes())
			assert text.startsWith("--simple-boundary_1\r\nContent-Disposition: form-data; name=\"title\"\r\n\r\nholiday\r\n--simple-boundary_1\r\n")
			assert text.endsWith("\r\n--simple-boundary_1--\r\n")
			let reader = try readerFor(new bytes.Buffer(sink.bytes()), w.formDataContentType())
			let form = try reader.readForm(1024)
			assert orText(form.values.get("title")) == "holiday"
			let photo = form.filesFor("photo")[0]
			assert photo.filename == "beach \"1\".jpg"
			assert string(try (try photo.open()).bytes()) == "JPEG DATA"
			assert (try photo.contentType()).essence() == "application/octet-stream"
			return none
		}

		@test()
		def picksAndValidatesBoundaries() !none {
			let w = new Writer(new bytes.Buffer())
			assert w.boundary == ""
			let header = w.formDataContentType()
			assert w.boundary.len() == 60
			assert header == "multipart/form-data; boundary=" + w.boundary
			assert w.chooseBoundary("") is error
			assert w.chooseBoundary("x".repeat(71)) is error
			assert w.chooseBoundary("ends with space ") is error
			assert w.chooseBoundary("bad;char") is error
			try w.chooseBoundary("with space inside")
			assert w.formDataContentType() == "multipart/form-data; boundary=\"with space inside\""
			try w.writeField("a", "1")
			assert w.chooseBoundary("late") is error
			return none
		}

		@test()
		def finishedPartsRejectWrites() !none {
			let w = new Writer(new bytes.Buffer())
			let first = try w.createFormField("a")
			try first.writeString("1")
			let second = try w.createFormField("b")
			assert first.writeString("late") is error
			try second.writeString("2")
			try w.close()
			assert second.writeString("late") is error
			assert w.createFormField("c") is error
			return none
		}
	}

	check "Header names" {
		@test()
		def canonicalisesNames() !none {
			assert canonicalHeaderKey("content-type") == "Content-Type"
			assert canonicalHeaderKey("CONTENT-DISPOSITION") == "Content-Disposition"
			assert canonicalHeaderKey("x-my-header") == "X-My-Header"
			assert canonicalHeaderKey("etag") == "Etag"
			return none
		}
	}
}
