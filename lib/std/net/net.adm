partial module std.net {
	// rpc, p2p, webrtc
	use std.services::(Network)
	use std.io

	// Note: std.net reuses the core stream I/O interfaces from std.io
	// (Reader/Writer/Closer) rather than redefining them.

	// Server is the shared contract for network servers (TCP/UDP/etc).
	//
	// `start()` allocates/binds the underlying socket(s) and prepares the server
	// to accept/receive.
	// `stop()` performs a best-effort graceful shutdown and releases resources.
	// `address()` returns the local address the server is bound to (may include
	// the chosen ephemeral port when bound to `:0`).
	interface Server {
		def start() !none
		def stop() !none
		def address() Address
	}

	// StreamServer is a Server that produces stream connections (TCP/Unix stream).
	interface StreamServer {
		Server
		def accept() !Connection
	}

	// DatagramServer is a Server that receives/sends datagrams (UDP/Unix dgram).
	interface DatagramServer {
		Server
		def recv(buf byte[]) !(int, Address)
		def send(buf byte[], addr Address) !int
	}

	interface Listener {
		io.Closer
	    def accept() !Connection
	    def address() Address
	}

	// socket creates a raw socket. Protocol is derived from domain+type by the OS.
	def socket(domain SocketDomain, typ SocketType) !Socket {
		return Network.socket(domain, typ)
	}

	// dialStream opens and connects a TCP/Unix stream socket and returns a Connection.
	def dialStream(addr string, timeout duration = 30s) !Connection {
		let fd = try Network.dialStream(addr, timeout)
		return new Connection(fd)
	}
}
