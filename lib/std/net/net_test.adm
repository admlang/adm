partial module std.net {
	use (
		std.testing
		std.time
	)

	// echo accepts one connection, sends back what it reads, then closes it.
	internal async def echoOnce(ln Listener) !none {
		let conn = try ln.accept()
		let buf byte[] = []
		buf.len(256)
		let n = try conn.read(buf, 5s)
		try conn.writeAll(buf[:n])
		try conn.close()
		return none
	}

	internal def acceptAndClose(ln Listener) !none {
		let conn = try ln.accept()
		return try conn.close()
	}

	// acceptOnce waits for one connection and returns the code the accept
	// failed with, "" when it got one.
	internal async def acceptOnce(ln Listener) string {
		let code = ""
		acceptAndClose(ln) onerror (err error) {
			code = err.code
			recover none
		}
		return code
	}

	// readOnce waits for bytes that never come and returns the code the
	// read failed with.
	internal async def readOnce(conn Connection) string {
		let buf byte[] = []
		buf.len(16)
		let code = ""
		conn.read(buf, 30s) onerror (err error) {
			code = err.code
			recover 0
		}
		return code
	}

	// listenLoopback binds a fresh IPv4 stream socket to an ephemeral port.
	internal def listenLoopback() !Listener {
		let sock = try socket(SocketDomain.IPv4, SocketType.Stream)
		try sock.bind("127.0.0.1:0")
		return sock.listen(8)
	}

	check "Address" {
		@test()
		def parsesHostPort() !none {
			let a = try parseAddress("127.0.0.1:8080")
			assert a.host == "127.0.0.1"
			assert a.port == 8080
			assert !a.isIPv6
			assert !a.isUnix
			assert a.str() == "127.0.0.1:8080"
			let wildcard = try parseAddress(":0")
			assert wildcard.host == ""
			assert wildcard.port == 0
			return none
		}

		@test()
		def parsesIPv6AndUnix() !none {
			let v6 = try parseAddress("[::1]:443")
			assert v6.isIPv6
			assert v6.host == "::1"
			assert v6.port == 443
			assert v6.str() == "[::1]:443"
			let sockPath = try parseAddress("/tmp/adm.sock")
			assert sockPath.isUnix
			assert sockPath.path == "/tmp/adm.sock"
			assert sockPath.str() == "/tmp/adm.sock"
			return none
		}

		@test()
		def rejectsMalformed() {
			let bad = ["", "localhost", "[::1]", "[::1]8080"]
			for let text in bad {
				let failed = false
				parseAddress(text) onerror (err error) {
					failed = true
					recover new Address()
				}
				assert failed
			}
		}
	}

	check "Errors" {
		@test()
		def mapsErrnoNames() {
			assert errorCodeOf("ECONNREFUSED") == ErrorCode.ConnRefused
			assert errorCodeOf("ETIMEDOUT") == ErrorCode.TimedOut
			assert errorCodeOf("EADDRINUSE") == ErrorCode.AddrInUse
			assert errorCodeOf("EPIPE") == ErrorCode.Pipe
			assert errorCodeOf("net") == ErrorCode.Other
			assert errorCodeOf("") == ErrorCode.Other
			assert ErrorCode.TimedOut.value == "ETIMEDOUT"
		}

		@test()
		def refusedDialCarriesKindAndAddress() {
			let seen = false
			dialStream("127.0.0.1:1", 2s) onerror (err error) {
				assert err.code == "ECONNREFUSED"
				// The whole text: the runtime part must outlive the call that made it.
				assert err.message == "dial 127.0.0.1:1: connect: Connection refused"
				if err is NetError {
					seen = err.kind == ErrorCode.ConnRefused && err.op == "dial" && err.addr == "127.0.0.1:1"
					assert !(err.cause is none)
				}
				recover new Connection(-1)
			}
			assert seen
		}

		@test()
		def errorOfBuildsPayload() {
			let err = errorOf(ErrorCode.Closed, "read", "", "connection is closed")
			assert err.code == "ECLOSED"
			assert err.kind == ErrorCode.Closed
			assert err.message == "read: connection is closed"
			assert err.cause is none
			let withAddr = errorOf(ErrorCode.BadAddress, "bind", "nowhere", "expected host:port")
			assert withAddr.message == "bind nowhere: expected host:port"
		}

		@test()
		def closedConnectionFailsWithClosed() {
			let conn = new Connection(-1)
			let buf byte[] = []
			buf.len(8)
			let seen = false
			conn.read(buf, 1s) onerror (err error) {
				if err is NetError {
					seen = err.kind == ErrorCode.Closed && err.op == "read"
				}
				recover 0
			}
			assert seen
			assert !conn.isOpen()
			conn.close() onerror recover none
		}
	}

	check "Sockets" {
		@test()
		def bindsEphemeralPort() !none {
			let ln = try listenLoopback()
			let addr = ln.address()
			assert addr.host == "127.0.0.1"
			assert addr.port > 0
			try ln.close()
			try ln.close()
			return none
		}

		@test()
		def closeWakesABlockedAccept() !none {
			let ln = try listenLoopback()
			let addr = ln.address().str()
			let pending = async acceptOnce(ln)
			time.sleep(50ms)
			let started = time.now()
			try ln.close()
			let code = await pending
			assert code == ErrorCode.Closed.value
			assert time.since(started) < 2s
			// Nothing listens any more: the accept did not keep the socket alive.
			let late = dialStream(addr, 1s)
			assert late is error
			return none
		}

		@test()
		def closeWakesAParkedRead() !none {
			let ln = try listenLoopback()
			let conn = try dialStream(ln.address().str(), 2s)
			let peer = try ln.accept()
			let pending = async readOnce(conn)
			time.sleep(50ms)
			let started = time.now()
			try conn.close()
			let code = await pending
			assert code == ErrorCode.Closed.value
			assert time.since(started) < 2s
			try peer.close()
			try ln.close()
			return none
		}

		@test()
		def echoesOverLoopback() !none {
			let ln = try listenLoopback()
			let server = async echoOnce(ln)
			let conn = try dialStream(ln.address().str(), 2s)
			assert conn.isOpen()
			assert conn.remoteAddr().port == ln.address().port
			assert conn.localAddr().host == "127.0.0.1"
			try conn.writeAll("hello".bytes())
			let buf byte[] = []
			buf.len(64)
			let n = try conn.read(buf, 5s)
			assert string(buf[:n]) == "hello"
			// The server closed its side: the next read reports end of stream.
			assert (try conn.read(buf, 5s)) == 0
			try await server
			try conn.close()
			try ln.close()
			return none
		}

		@test()
		def readTimesOut() !none {
			let ln = try listenLoopback()
			let conn = try dialStream(ln.address().str(), 2s)
			let buf byte[] = []
			buf.len(8)
			let seen = false
			conn.read(buf, 100ms) onerror (err error) {
				assert err.code == "ETIMEDOUT"
				if err is NetError {
					seen = err.kind == ErrorCode.TimedOut && err.op == "read"
				}
				recover 0
			}
			assert seen
			try conn.close()
			try ln.close()
			return none
		}

		@test()
		def addressInUseIsReported() !none {
			let ln = try listenLoopback()
			let again = try socket(SocketDomain.IPv4, SocketType.Stream)
			let seen = false
			again.bind(ln.address().str()) onerror (err error) {
				if err is NetError {
					seen = err.kind == ErrorCode.AddrInUse && err.op == "bind" && err.addr == ln.address().str()
				}
				recover none
			}
			assert seen
			try again.close()
			try ln.close()
			return none
		}

		@test()
		def resolvesLocalhost() !none {
			let addrs = try resolve("localhost")
			assert addrs.len() > 0
			let seen = false
			resolve("no-such-host.invalid") onerror (err error) {
				if err is NetError {
					seen = err.kind == ErrorCode.Resolve && err.addr == "no-such-host.invalid"
				}
				recover []
			}
			assert seen
			return none
		}
	}
}
