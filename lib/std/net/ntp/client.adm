partial module std.net.ntp {
	use (
		std.net
		std.net.ntp.proto::*
		std.net.tls
		std.services.policy::(Policy)
		std.time
	)

	// Client asks one NTP server for the time (SNTP, RFC 4330, over the
	// NTPv4 packet): each `query` is one or a few request/answer
	// exchanges, checked the way RFC 5905 §8 checks them (origin echoed,
	// no Kiss-o'-Death, server synchronized) and authenticated when a
	// `key` is set, or secured with Network Time Security (`nts`).
	//
	// ```
	// let client = new ntp.Client("time.cloudflare.com")
	// let answer = try client.query()
	// println("offset {answer.offset}, delay {answer.delay}, stratum {answer.stratum}")
	// ```
	type Client {
		// `host`, `host:port`, `[v6]:port`; port 123 when none is given.
		server           string      = "pool.ntp.org"
		// The NTP version sent (1–4); servers answer in kind.
		version          int         = 4
		// How long to wait for each answer.
		timeout          duration    = 5s
		// Signs requests and requires signed answers.
		key              ?Key        = none
		// Network Time Security (RFC 8915): a TLS key exchange with the
		// server's NTS-KE port first, then every exchange carries a cookie
		// and is authenticated both ways; time from a server that cannot
		// prove itself is refused. The key exchange may name another NTP
		// server and port.
		nts              bool        = false
		// The NTS-KE port.
		ntsPort          int         = 4460
		// TLS settings for the key exchange; none verifies the server
		// against the system roots under its name.
		tls              ?tls.Config = none
		internal session ?NtsSession = none

		def new(server string = "pool.ntp.org") {
			self.server = server
		}

		// One exchange. Fails with NtpError: `timeout` when no answer
		// comes, `kiss` for a Kiss-o'-Death, `auth` when a keyed answer
		// does not check out, `unsynchronized` when the server's clock is
		// not set, `nts` when the NTS key exchange fails; with PolicyDenied
		// when the policy denies the server.
		def query() !Response {
			let target = try targetOf()
			let m = try measure(target)
			return responseOf(target, m)
		}

		// One exchange, through NTS when asked: a key exchange first when
		// there is no session, and once more when the server wants a new
		// one (an NTS NAK, or no cookies left).
		internal def measure(target string) !Measured {
			return try exchange(target, version, key, timeout) unless nts
			let fresh = session is none
			let s = try ntsSession()
			let stale = false
			let m = exchange(target, version, key, timeout, s) onerror (err error) {
				fail err unless !fresh && err is NtpError && err.code == "nts"
				stale = true
				recover Measured{packet: Packet{}, arrived: time.now()}
			}
			return m unless stale
			session = none
			return try exchange(target, version, key, timeout, try ntsSession())
		}

		internal def ntsSession() !NtsSession {
			let s = session
			return s unless s is none
			let host = net.parseAddress(net.withPort(server, 123)) onerror recover new net.Address()
			try Policy.validate("adm.network.connect", "std.services.policy.EndpointSpec", "ntske://" + net.withPort(host.host, ntsPort))
			let made = try ntsKeyExchange(host.host, ntsPort, tls, timeout)
			// The key exchange may send the client to another NTP server.
			try Policy.validate("adm.network.connect", "std.services.policy.EndpointSpec", "ntp://" + net.withPort(made.target, 123))
			session = made
			return made
		}

		// The best of `samples` exchanges `interval` apart: the one with
		// the least delay, the clock filter's choice (RFC 5905 §10).
		// Public servers rate-limit clients that ask more often than every
		// two seconds. Fails as `query()` does when no exchange succeeds.
		def query(samples int, interval duration = 2s) !Response {
			let target = try targetOf()
			let best ?Measured = none
			let last ?error = none
			for let i = 0; i < samples; i++ {
				time.sleep(interval) when i > 0
				let failed = false
				let m = measure(target) onerror (err error) {
					failed = true
					last = err
					// A Kiss-o'-Death ends the burst.
					fail err when err is NtpError && err.code == "kiss"
					recover Measured{packet: Packet{}, arrived: time.now()}
				}
				continue when failed
				let b = best
				best = m when b is none || m.delay < b.delay
			}
			let b = best
			if b is none {
				fail last unless last is none
				fail NtpError{message: "ntp: no samples asked", code: "config"}
			}
			return responseOf(target, b)
		}

		// The server's time now: the local clock corrected by one
		// exchange. Fails as `query()` does.
		def now() !time.Time {
			let r = try query()
			return time.now() + r.offset
		}

		internal def targetOf() !string {
			let target = try resolveTarget(server)
			try Policy.validate("adm.network.connect", "std.services.policy.EndpointSpec", "ntp://" + target)
			return target
		}

		// Names the client and its server.
		def str() string {
			return "ntp.Client({server})"
		}
	}

	// The public view of one measured exchange.
	internal def responseOf(target string, m Measured) Response {
		let p = m.packet
		let offset = secondsToDuration(m.offset)
		return Response{
			server:         target,
			offset:         offset,
			delay:          secondsToDuration(m.delay),
			serverTime:     m.arrived + offset,
			stratum:        p.stratum,
			leap:           leapOf(p.leap),
			version:        p.version,
			precision:      p.precision,
			rootDelay:      secondsToDuration(p.rootDelay),
			rootDispersion: secondsToDuration(p.rootDispersion),
			referenceId:    referenceText(p.stratum, p.referenceId),
			referenceTime:  timeOf(p.reference),
			authenticated:  m.authenticated,
		}
	}

	internal def secondsToDuration(seconds float) duration {
		return duration(int64(seconds * 1000000000.0))
	}

	internal def leapOf(value int) Leap {
		return Leap.AddSecond when value == 1
		return Leap.DeleteSecond when value == 2
		return Leap.Unsynchronized when value == 3
		return Leap.None
	}
}
