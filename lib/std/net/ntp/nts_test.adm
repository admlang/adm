partial module std.net.ntp {
	use (
		std.crypto.x509::(CertPool)
		std.net.ntp.proto::*
		std.net.tls
		std.testing
		std.time
	)

	// A self-signed P-256 certificate for localhost and 127.0.0.1, and its
	// key, for the NTS tests.
	internal const ntsCertPEM = """
-----BEGIN CERTIFICATE-----
MIIBmzCCAUGgAwIBAgIUOrYqaxxYyW/PUCWRi7R1IzMWjDEwCgYIKoZIzj0EAwIw
FDESMBAGA1UEAwwJbG9jYWxob3N0MCAXDTI2MDkyOTA3MjQyM1oYDzIxMjYwOTA1
MDcyNDIzWjAUMRIwEAYDVQQDDAlsb2NhbGhvc3QwWTATBgcqhkjOPQIBBggqhkjO
PQMBBwNCAARLN/PD2fIVqqq7p1iL8gvazMrmDoo30lUctmz3GIKVRcQ0TLuTQKax
WL9Jfn4FB69UwmwFM9ZbwJIdgxI2ImECo28wbTAdBgNVHQ4EFgQUo8e+hTBoVHTI
NaPvElUQ5VuwrukwHwYDVR0jBBgwFoAUo8e+hTBoVHTINaPvElUQ5VuwrukwDwYD
VR0TAQH/BAUwAwEB/zAaBgNVHREEEzARgglsb2NhbGhvc3SHBH8AAAEwCgYIKoZI
zj0EAwIDSAAwRQIgJkeQ5eLdSByfznozVq83QKxZlyTr5tVaIPBC0nh3nkcCIQDu
pyVmqQKX8yRDbiF9ysGV3//XVsInvM8dU2Bca8mKXA==
-----END CERTIFICATE-----
"""

	internal const ntsKeyPEM = """
-----BEGIN PRIVATE KEY-----
MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgtzhv828FBvQUQftP
ofJ5AcmnnDasPM25Jy5jJEVH1+ahRANCAARLN/PD2fIVqqq7p1iL8gvazMrmDoo3
0lUctmz3GIKVRcQ0TLuTQKaxWL9Jfn4FB69UwmwFM9ZbwJIdgxI2ImEC
-----END PRIVATE KEY-----
"""

	internal def ntsServer() !Server {
		let s = new Server("127.0.0.1:0")
		s.ntsAddr = "127.0.0.1:0"
		s.tls = tls.Config{certificates: [try tls.parseKeyPair(ntsCertPEM, ntsKeyPEM)]}
		try s.start()
		return s
	}

	internal def ntsTrust() tls.Config {
		let pool = new CertPool()
		pool.appendCertsFromPEM(ntsCertPEM)
		return tls.Config{rootCAs: pool}
	}

	check "NTS and broadcast" {
		@test()
		def securesExchangesWithNts() !none {
			let server = try ntsServer()
			let c = new Client(server.address().str())
			c.timeout = 3s
			c.nts = true
			c.ntsPort = server.ntsAddress().port
			c.tls = ntsTrust()
			// More queries than the eight cookies of one key exchange: the
			// answers keep refilling them.
			for let i = 0; i < 12; i++ {
				let r = try c.query()
				assert r.authenticated
				assert abs(r.offset) < 100ms
			}
			// The key exchange by hand: keys, eight cookies, the NTP port.
			let session = try ntsKeyExchange("127.0.0.1", server.ntsAddress().port, ntsTrust(), 3s)
			assert session.cookieCount() == 8 && session.target.endsWith(":{server.address().port}")
			// A cookie the server cannot open gets an NTS NAK.
			let forged = new NtsSession(session.target, session.c2s, session.s2c)
			let garbage byte[] = []
			garbage.len(100)
			forged.addCookies([garbage])
			let code = ""
			exchange(server.address().str(), 4, none, 2s, forged) onerror (err error) {
				code = err.code
				recover Measured{packet: Packet{}, arrived: time.now()}
			}
			assert code == "nts"
			// A client that trusts another certificate refuses the server.
			let doubter = new Client(server.address().str())
			doubter.nts = true
			doubter.ntsPort = server.ntsAddress().port
			doubter.timeout = 2s
			let refused = false
			doubter.query() onerror (err error) {
				refused = true
				recover Response{server: "", serverTime: time.now(), referenceTime: time.now()}
			}
			assert refused
			// Clocks do NTS per server.
			let clock = new Clock(server.address().str())
			clock.nts = true
			clock.ntsPort = server.ntsAddress().port
			clock.tls = ntsTrust()
			clock.burst = 4
			clock.burstInterval = 50ms
			try clock.sync()
			assert clock.synchronized() && abs(clock.offset()) < 100ms
			try server.close()
			return none
		}

		@test()
		def keepsCookiesUnderTwoKeys() !none {
			let keys = new ServerKeys(24h)
			let c2s byte[] = []
			c2s.len(32)
			let s2c byte[] = []
			s2c.len(32)
			s2c[0] = byte(7)
			let cookie = try keys.cookie(c2s, s2c)
			assert cookie.len() == 100
			let opened = try keys.open(cookie)
			assert !(opened is none) && opened.s2c[0] == byte(7)
			cookie[40] = cookie[40] ^ byte(1)
			assert (try keys.open(cookie)) is none
			return none
		}

		@test()
		def followsBroadcasts() !none {
			let clock = new Clock()
			clock.pools = []
			try clock.listenBroadcasts("0.0.0.0:0")
			let server = new Server("0.0.0.0:0")
			server.broadcast = "127.255.255.255:{clock.broadcastAddress().port}"
			server.broadcastInterval = 1s
			let key = try key(1, KeyAlgorithm.SHA1, "broadcast secret")
			server.broadcastKey = key
			server.keys = [key]
			clock.key = key
			try server.start()
			// A calibration exchange, then a broadcast a second, until the
			// filter trusts it.
			let deadline = time.now() + 20s
			for time.now() < deadline && !clock.synchronized() {
				time.sleep(200ms)
			}
			let sources = clock.sources()
			fail "no broadcaster heard" when sources.len() == 0
			assert sources[0].reach >= 3
			assert abs(sources[0].offset) < 100ms
			assert clock.synchronized()
			try clock.close()
			try server.close()
			return none
		}
	}
}
