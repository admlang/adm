internal partial module std.net.ntp.proto {
	use (
		std.crypto::(constantTimeEqual)
		std.crypto.cipher
		std.crypto.hash::(Hash, digest)
		std.net.ntp::(Key, KeyAlgorithm, NtpError)
		std.time
	)

	// The NTP packet (RFC 5905 §7.3): the 48-byte header, the extension
	// fields of RFC 7822 kept whole, and the MAC (key id and digest).

	const modeSymmetricActive = 1
	const modeSymmetricPassive = 2
	const modeClient = 3
	const modeServer = 4
	const modeBroadcast = 5

	// Seconds from 1900-01-01 (the NTP era 0 epoch) to 1970-01-01.
	const unixOffset int64 = 2208988800

	// An NTP timestamp: seconds since 1900 in the top 32 bits, a binary
	// fraction in the low 32 (wrapping into era 1 in 2036).
	struct Stamp {
		seconds  int64 = 0
		fraction int64 = 0
	}

	struct Packet {
		leap           int      = 0
		version        int      = 4
		mode           int      = modeClient
		stratum        int      = 0
		poll           int      = 0
		precision      int      = 0
		// Root delay and dispersion in seconds, from their 16.16 form.
		rootDelay      float    = 0.0
		rootDispersion float    = 0.0
		referenceId    byte[]   = [0, 0, 0, 0]
		reference      Stamp    = Stamp{}
		origin         Stamp    = Stamp{}
		receive        Stamp    = Stamp{}
		transmit       Stamp    = Stamp{}
		// RFC 7822 extension fields, each whole (type, length, value).
		extensions     byte[][] = []
		// 0 when the packet carries no MAC; with `digest` empty a
		// crypto-NAK.
		keyId          int64    = 0
		hasMac         bool     = false
		digest         byte[]   = []
	}

	def isZero(s Stamp) bool {
		return s.seconds == 0 && s.fraction == 0
	}

	def sameStamp(a Stamp, b Stamp) bool {
		return a.seconds == b.seconds && a.fraction == b.fraction
	}

	// The timestamp of an instant.
	def stampOf(t time.Time) Stamp {
		let ns = t.unixNs()
		let secs = ns / 1000000000
		let rem = ns % 1000000000
		if rem < 0 {
			rem += 1000000000
			secs -= 1
		}
		let ntp = (secs + unixOffset) & 0xffffffff
		return Stamp{seconds: ntp, fraction: (rem << 32) / 1000000000}
	}

	// The instant of a timestamp; one with the top bit clear is taken as
	// era 1 (from 2036), the RFC 4330 §3 rule.
	def timeOf(s Stamp) time.Time {
		let secs = s.seconds
		secs += 4294967296 when (secs & 0x80000000) == 0
		let ns = (secs - unixOffset) * 1000000000 + ((s.fraction * 1000000000) >> 32)
		return time.fromUnixNs(ns)
	}

	// The timestamp as seconds (with fraction) since 1900, for
	// differences; era 1 as above.
	def secondsOf(s Stamp) float {
		let secs = s.seconds
		secs += 4294967296 when (secs & 0x80000000) == 0
		return float(secs) + float(s.fraction) / 4294967296.0
	}

	// The 16.16 short format of a non-negative duration in seconds.
	def shortOf(seconds float) int64 {
		return 0 when seconds <= 0.0
		let v = int64(seconds * 65536.0)
		return v > 0xffffffff ?? (0xffffffff, v)
	}

	def encodeHeader(p Packet) byte[] {
		let out byte[] = []
		out.push(byte(((p.leap & 3) << 6) | ((p.version & 7) << 3) | (p.mode & 7)))
		out.push(byte(p.stratum & 0xff))
		out.push(byte(p.poll & 0xff))
		out.push(byte(p.precision & 0xff))
		out = out + uint32Bytes(shortOf(p.rootDelay)) + uint32Bytes(shortOf(p.rootDispersion))
		let ref = p.referenceId
		for let i = 0; i < 4; i++ {
			out.push(i < ref.len() ?? (ref[i], byte(0)))
		}
		out = out + stampBytes(p.reference) + stampBytes(p.origin) + stampBytes(p.receive) + stampBytes(p.transmit)
		for let e in p.extensions {
			out = out + e
		}
		return out
	}

	// The whole packet, with a MAC under `key` when one is given.
	def encodePacket(p Packet, key ?Key = none) byte[] {
		let head = encodeHeader(p)
		return head + macOf(key, head) unless (key is none)
		return head
	}

	// A crypto-NAK: the header and a zero key id (RFC 5905 §7.4).
	def encodeCryptoNak(p Packet) byte[] {
		return encodeHeader(p) + uint32Bytes(0)
	}

	// The key id and digest appended to `head` (RFC 5905 §7.3, RFC 8573
	// for AES-CMAC).
	def macOf(key Key, head byte[]) byte[] {
		return uint32Bytes(key.id) + authDigest(key, head)
	}

	def authDigest(key Key, head byte[]) byte[] {
		let secret = key.secret.reveal()
		switch {
			case key.algorithm == KeyAlgorithm.MD5:
				return digest(Hash.MD5, secret + head)
			case key.algorithm == KeyAlgorithm.SHA1:
				return digest(Hash.SHA1, secret + head)
			default:
				return cipher.cmac(secret, head) onerror recover byte[]
		}
	}

	// Whether the packet's MAC is `key`'s digest over the rest of it.
	def macValid(key Key, data byte[], p Packet) bool {
		return false unless p.hasMac && p.keyId == key.id && p.digest.len() > 0
		let head = data[:data.len() - 4 - p.digest.len()]
		return constantTimeEqual(authDigest(key, head), p.digest)
	}

	def decodePacket(data byte[]) !Packet {
		fail NtpError{message: "ntp: packet of {data.len()} bytes is too short", code: "protocol"} when data.len() < 48
		let first = int(data[0])
		let p = Packet{leap: first >> 6, version: (first >> 3) & 7, mode: first & 7}
		p.stratum = int(data[1])
		p.poll = int(int8(data[2]))
		p.precision = int(int8(data[3]))
		p.rootDelay = float(uint32At(data, 4)) / 65536.0
		p.rootDispersion = float(uint32At(data, 8)) / 65536.0
		p.referenceId = data[12:16].clone()
		p.reference = stampAt(data, 16)
		p.origin = stampAt(data, 24)
		p.receive = stampAt(data, 32)
		p.transmit = stampAt(data, 40)
		// After the header: extension fields (each at least 16 bytes, a
		// multiple of 4), then a MAC of 4 + 16 or 4 + 20 bytes, or a
		// 4-byte crypto-NAK (RFC 7822 §7.5).
		let at = 48
		for {
			let left = data.len() - at
			break when left == 0
			if left == 4 {
				p.hasMac = true
				p.keyId = uint32At(data, at)
				break
			}
			if left := 20 || 24 {
				p.hasMac = true
				p.keyId = uint32At(data, at)
				p.digest = data[at + 4:].clone()
				break
			}
			fail NtpError{message: "ntp: truncated extension field", code: "protocol"} when left < 16
			let length = int(uint32At(data, at) & 0xffff)
			fail NtpError{message: "ntp: bad extension field length {length}", code: "protocol"} when length < 16 || length % 4 != 0 || length > left
			p.extensions.push(data[at:at + length].clone())
			at += length
		}
		return p
	}

	// The kiss code of a Kiss-o'-Death packet (stratum 0), or "".
	def kissCode(p Packet) string {
		return "" unless p.stratum == 0
		return "" unless p.mode := modeServer || modeSymmetricPassive || modeBroadcast
		return asciiOf(p.referenceId)
	}

	// The reference id as text: four ASCII letters for stratum 0 and 1,
	// an IPv4 address (or IPv6 hash) above.
	def referenceText(stratum int, id byte[]) string {
		return "" when id.len() < 4
		return asciiOf(id) when stratum <= 1
		return "{int(id[0])}.{int(id[1])}.{int(id[2])}.{int(id[3])}"
	}

	// Four ASCII letters up to the first NUL.
	def asciiOf(id byte[]) string {
		let out = ""
		for let b in id {
			break when b == 0
			out += string(char(b))
		}
		return out
	}

	def uint32Bytes(v int64) byte[] {
		return [byte((v >> 24) & 0xff), byte((v >> 16) & 0xff), byte((v >> 8) & 0xff), byte(v & 0xff)]
	}

	def stampBytes(s Stamp) byte[] {
		return uint32Bytes(s.seconds) + uint32Bytes(s.fraction)
	}

	def uint32At(data byte[], at int) int64 {
		return (int64(data[at]) << 24) | (int64(data[at + 1]) << 16) | (int64(data[at + 2]) << 8) | int64(data[at + 3])
	}

	def stampAt(data byte[], at int) Stamp {
		return Stamp{seconds: uint32At(data, at), fraction: uint32At(data, at + 4)}
	}
}
