internal partial module std.net.proxy.wire {
	use (
		std.net
		std.net.proxy::*
	)

	// SOCKS commands, the same numbers in versions 4 and 5.
	const commandConnect = 1
	const commandBind = 2
	const commandAssociate = 3

	// socks5Greet opens a SOCKS5 session on the stream: it offers no
	// authentication, and username/password (RFC 1929) when user is not
	// empty, then authenticates when the proxy picks that.
	// Fails with ProxyError: Protocol when the peer is not a SOCKS5
	// proxy, Auth when it wants credentials there are none of, rejects
	// them, or accepts none of the offered methods.
	def socks5Greet(stream net.Stream, user string, password string, via string, timeout duration) !none {
		let wantAuth = user != ""
		let greeting byte[] = wantAuth ?? ([0x05, 0x02, 0x00, 0x02], [0x05, 0x01, 0x00])
		try net.writeAll(stream, greeting, timeout)
		let choice = try readExact(stream, 2, timeout)
		fail ProxyError{message: "{via} is not a SOCKS5 proxy", kind: ErrorKind.Protocol, proxy: via, reply: int(choice[0])} when choice[0] != 0x05
		return none when choice[1] == 0x00
		fail ProxyError{message: "{via} accepts none of the offered authentication methods", kind: ErrorKind.Auth, proxy: via, reply: int(choice[1])} when choice[1] != 0x02
		fail ProxyError{message: "{via} wants a username and password", kind: ErrorKind.Auth, proxy: via, reply: 2} unless wantAuth
		let userBytes = user.bytes()
		let passBytes = password.bytes()
		fail ProxyError{message: "SOCKS5 credentials are longer than 255 bytes", kind: ErrorKind.Auth, proxy: via} when userBytes.len() > 255 || passBytes.len() > 255
		let auth byte[] = [0x01]
		auth.push(byte(userBytes.len()))
		auth.push(...userBytes)
		auth.push(byte(passBytes.len()))
		auth.push(...passBytes)
		try net.writeAll(stream, auth, timeout)
		let verdict = try readExact(stream, 2, timeout)
		fail ProxyError{message: "{via} rejected the credentials", kind: ErrorKind.Auth, proxy: via, reply: int(verdict[1])} unless verdict[1] == 0x00
		return none
	}

	// socks5Command sends a request for host and port and reads the
	// reply; it returns the address the proxy bound.
	// Fails with ProxyError (Refused) carrying the reply code when the
	// proxy answers anything but success.
	def socks5Command(stream net.Stream, command int, host string, port int, via string, timeout duration) !(string, int) {
		let request byte[] = [0x05, byte(command), 0x00]
		try encodeAddress(request, host, port)
		try net.writeAll(stream, request, timeout)
		return try socks5Reply(stream, joinTarget(host, port), via, timeout)
	}

	// socks5Reply reads one reply: the bound address on success.
	// Fails with ProxyError: Refused with the reply code, Protocol when
	// the reply is not SOCKS5.
	def socks5Reply(stream net.Stream, target string, via string, timeout duration) !(string, int) {
		let head = try readExact(stream, 3, timeout)
		fail ProxyError{message: "{via} answered with SOCKS version {head[0]}", kind: ErrorKind.Protocol, proxy: via, target: target, reply: int(head[0])} when head[0] != 0x05
		let code = int(head[1])
		fail ProxyError{message: "{via} refused {target}: " + socks5ReplyText(code), kind: ErrorKind.Refused, proxy: via, target: target, reply: code} unless code == 0
		return try readAddress(stream, timeout)
	}

	// socks4Command sends a SOCKS4 request and reads the reply; byName
	// sends the host name for the proxy to resolve (SOCKS4a), otherwise
	// a name is resolved here to its first IPv4 address.
	// Fails with ProxyError: Target when the host has no IPv4 address,
	// Refused with the reply code when the proxy says no.
	def socks4Command(stream net.Stream, command int, host string, port int, user string, byName bool, via string, timeout duration) !(string, int) {
		let target = joinTarget(host, port)
		let ip = net.parseIPText(host)
		fail ProxyError{message: "SOCKS4 reaches IPv4 only, not {host}", kind: ErrorKind.Target, proxy: via, target: target} when !(ip is none) && ip.len() != 4
		let name = ""
		let address byte[] = [0, 0, 0, 1]
		if ip is none {
			name = host when byName
			address = try firstIPv4(host, via) unless byName
		} else {
			address = ip
		}
		let request byte[] = [0x04, byte(command), byte((port >> 8) & 0xFF), byte(port & 0xFF)]
		request.push(...address)
		request.push(...user.bytes())
		request.push(0x00)
		if name != "" {
			request.push(...name.bytes())
			request.push(0x00)
		}
		try net.writeAll(stream, request, timeout)
		return try socks4Reply(stream, target, via, timeout)
	}

	// socks4Reply reads one SOCKS4 reply: the address in it on success.
	// Fails with ProxyError (Refused) carrying the reply code otherwise.
	def socks4Reply(stream net.Stream, target string, via string, timeout duration) !(string, int) {
		let reply = try readExact(stream, 8, timeout)
		fail ProxyError{message: "{via} is not a SOCKS4 proxy", kind: ErrorKind.Protocol, proxy: via, target: target, reply: int(reply[0])} when reply[0] != 0x00
		let code = int(reply[1])
		fail ProxyError{message: "{via} refused {target}: " + socks4ReplyText(code), kind: ErrorKind.Refused, proxy: via, target: target, reply: code} unless code == 90
		return (net.ipText(reply[4:8]), (int(reply[2]) << 8) | int(reply[3]))
	}

	// firstIPv4 is the first IPv4 address the host resolves to.
	// Fails with ProxyError (Target) when it has none, NetError (Resolve)
	// when it does not resolve.
	def firstIPv4(host string, via string) !byte[] {
		for let text in try net.resolve(host) {
			let ip = net.parseIPText(text)
			continue when ip is none
			return ip when ip.len() == 4
		}
		fail ProxyError{message: "{host} has no IPv4 address for a SOCKS4 proxy", kind: ErrorKind.Target, proxy: via, target: host}
	}

	// httpConnect asks an HTTP proxy for a tunnel to target (RFC 9110
	// §9.3.6) and reads its answer up to the empty line, byte by byte, so
	// nothing of the tunnel is taken with it.
	// Fails with ProxyError: Auth on 407 (the challenge in
	// `authenticate`), Refused on any other status outside 2xx, Protocol
	// when the answer is not HTTP; `reply` is the status.
	def httpConnect(stream net.Stream, target string, authorization string, via string, timeout duration) !none {
		let head = "CONNECT {target} HTTP/1.1\r\nHost: {target}\r\n"
		head += "Proxy-Authorization: {authorization}\r\n" when authorization != ""
		head += "\r\n"
		try net.writeAll(stream, head.bytes(), timeout)
		let lines = try readHead(stream, via, timeout)
		let status = statusOf(lines[0])
		fail ProxyError{message: "{via} did not answer CONNECT with HTTP: {lines[0]}", kind: ErrorKind.Protocol, proxy: via, target: target} when status < 100
		return none when status >= 200 && status < 300
		let challenge = ""
		for let i = 1; i < lines.len(); i++ {
			let line = lines[i]
			let colon = line.indexOf(":")
			continue when colon < 0
			challenge = line[colon + 1:].trim() when challenge == "" && line[:colon].trim().lower() == "proxy-authenticate"
		}
		let kind = status == 407 ?? (ErrorKind.Auth, ErrorKind.Refused)
		fail ProxyError{message: "{via} refused the tunnel to {target}: {lines[0]}", kind: kind, proxy: via, target: target, reply: status, authenticate: challenge}
	}

	// readHead reads the lines of a response head, without the empty
	// line that ends it; informational (1xx) heads are skipped.
	// Fails with ProxyError (Protocol) when the head passes 64 KiB or the
	// stream ends inside it.
	def readHead(stream net.Stream, via string, timeout duration) !string[] {
		let one byte[] = [0]
		for {
			let lines string[] = []
			let line byte[] = []
			let total = 0
			for {
				let got = try stream.read(one, timeout)
				fail ProxyError{message: "{via} closed the connection before answering", kind: ErrorKind.Protocol, proxy: via} when got <= 0
				total++
				fail ProxyError{message: "{via} sent a response head over 64 KiB", kind: ErrorKind.Protocol, proxy: via} when total > 65536
				if one[0] != byte(10) {
					line.push(one[0])
					continue
				}
				line.pop() when line.len() > 0 && line[line.len() - 1] == byte(13)
				break when line.len() == 0 && lines.len() > 0
				lines.push(string(line)) when line.len() > 0
				line = []
			}
			let status = statusOf(lines[0])
			return lines unless status >= 100 && status < 200
		}
		fail "unreachable"
	}

	// statusOf is the status code of an HTTP status line, 0 when the
	// line is not one.
	def statusOf(line string) int {
		return 0 unless line.startsWith("HTTP/")
		let parts = line.split(" ")
		return 0 when parts.len() < 2
		let code = parts[1]
		return 0 unless code.len() == 3 && code.isNumeric()
		return code.toInt<int>()
	}
}
