partial module std.net.proxy {
	use (
		std.net
		std.net.proxy.wire::*
		std.net.url
		std.testing
		std.time
	)

	// EchoServer answers every connection with what it reads, and counts
	// the connections it saw.
	internal type EchoServer {
		ln      net.Listener
		running bool         = true
		seen    int          = 0

		def new(ln net.Listener) {
			self.ln = ln
		}

		def run() {
			for running {
				let conn = acceptOne(ln) onerror recover none
				return when conn is none
				seen++
				let task = async echo(conn)
				task.keepAlive()
			}
		}

		def echo(conn net.Connection) {
			let buf byte[] = []
			buf.len(4096)
			for {
				let n = conn.read(buf, 5s) onerror recover 0
				break when n <= 0
				net.writeAll(conn, buf[:n], 5s) onerror recover none
			}
			conn.close() onerror recover none
		}

		def address() string {
			return ln.address().str()
		}

		def stop() {
			running = false
			ln.close() onerror recover none
		}
	}

	internal def listenLocal() !net.Listener {
		let sock = try net.socket(net.SocketDomain.IPv4, net.SocketType.Stream)
		try sock.bind("127.0.0.1:0")
		return try sock.listen(16)
	}

	internal def startEcho() !EchoServer {
		let server = new EchoServer(try listenLocal())
		let task = async server.run()
		task.keepAlive()
		return server
	}

	internal def startSocks() !SocksServer {
		let server = new SocksServer("127.0.0.1:0")
		server.idleTimeout = 5s
		server.dialTimeout = 3s
		try server.start()
		return server
	}

	internal def dialerFor(scheme string, server SocksServer, user string = "") !Dialer {
		let prefix = user == "" ?? ("", user + "@")
		return new Dialer(try url.parse("{scheme}://{prefix}{server.address().str()}"))
	}

	// roundTrip writes text to the stream and reads the same bytes back.
	internal def roundTrip(stream net.Stream, text string) !string {
		try net.writeAll(stream, text.bytes(), 5s)
		return string(try readExact(stream, text.bytes().len(), 5s))
	}

	// kindOf is the ProxyError kind of an error as text, "" for any
	// other error.
	internal def kindOf(err error) string {
		return "" unless err is ProxyError
		return "{err.kind}:{err.reply}"
	}

	// FakeHTTPProxy answers one CONNECT: with a tunnel to the target, or
	// with the canned refusal.
	internal type FakeHTTPProxy {
		ln       net.Listener
		refusal  string       = ""
		seenHead string       = ""

		def new(ln net.Listener, refusal string = "") {
			self.ln = ln
			self.refusal = refusal
		}

		def run() {
			let conn = acceptOne(ln) onerror recover none
			return when conn is none
			let lines = readHead(conn, "test", 5s) onerror recover string[]
			seenHead = lines.join("\n")
			if refusal != "" || lines.len() == 0 {
				net.writeAll(conn, refusal.bytes(), 5s) onerror recover none
				conn.close() onerror recover none
				return
			}
			let target = lines[0].split(" ")[1]
			let out = openTarget(target) onerror recover none
			if out is none {
				net.writeAll(conn, "HTTP/1.1 502 Bad Gateway\r\n\r\n".bytes(), 5s) onerror recover none
				conn.close() onerror recover none
				return
			}
			net.writeAll(conn, "HTTP/1.1 200 Connection established\r\nVia: test\r\n\r\n".bytes(), 5s) onerror recover none
			relay(conn, out, 5s)
		}
	}

	internal def openTarget(target string) !?net.Connection {
		return try net.dialStream(target, 3s)
	}

	// The calls below run an operation for its failure alone.
	internal def tryDial(dialer Dialer, target string) !none {
		let stream = try dialer.dial(target, 5s)
		stream.close() onerror recover none
		return none
	}

	internal def tryAssociation(dialer Dialer) !none {
		let made = try dialer.associate(2s)
		made.close() onerror recover none
		return none
	}

	internal def tryListen(dialer Dialer) !none {
		let made = try dialer.listen("127.0.0.1:0", 2s)
		made.close() onerror recover none
		return none
	}

	internal def tryAcceptPeer(binding Binding) !none {
		try binding.accept(5s)
		return none
	}

	internal def startHTTPProxy(refusal string = "") !FakeHTTPProxy {
		let server = new FakeHTTPProxy(try listenLocal(), refusal)
		let task = async server.run()
		task.keepAlive()
		return server
	}

	check "proxy" {
		@test()
		def socks5Connects() !none {
			let echo = try startEcho()
			let server = try startSocks()
			let stream = try (try dialerFor("socks5", server)).dial(echo.address(), 5s)
			assert (try roundTrip(stream, "through socks5")) == "through socks5"
			assert server.sessionCount() == 1
			try stream.close()

			// The same handshake over a connection the caller opened.
			let own = try net.dialStream(server.address().str(), 5s)
			try connect(own, try url.parse("socks5://unused.invalid"), echo.address(), 5s)
			assert (try roundTrip(own, "own socket")) == "own socket"
			try own.close()
			try server.close()
			echo.stop()
			return none
		}

		@test()
		def socks5ResolvesNamesAtTheProxy() !none {
			let echo = try startEcho()
			let server = try startSocks()
			let seen string[] = []
			server.allow(def (req Request) bool {
				seen.push("{req.version} {req.host}")
				return true
			})
			let port = echo.ln.address().port
			let stream = try (try dialerFor("socks5h", server)).dial("localhost:{port}", 5s)
			assert (try roundTrip(stream, "by name")) == "by name"
			try stream.close()
			assert seen.len() == 1 && seen[0] == "5 localhost"
			try server.close()
			echo.stop()
			return none
		}

		@test()
		def socks5Authenticates() !none {
			let echo = try startEcho()
			let server = try startSocks()
			server.authenticate((user string, password string) => user == "ana" && password == "secret")
			let stream = try (try dialerFor("socks5", server, "ana:secret")).dial(echo.address(), 5s)
			assert (try roundTrip(stream, "authenticated")) == "authenticated"
			try stream.close()

			let wrong = ""
			tryDial(try dialerFor("socks5", server, "ana:nope"), echo.address()) onerror (err error) {
				wrong = kindOf(err)
				recover none
			}
			assert wrong == "Auth:1"
			let missing = ""
			tryDial(try dialerFor("socks5", server), echo.address()) onerror (err error) {
				missing = kindOf(err)
				recover none
			}
			assert missing == "Auth:255"
			try server.close()
			echo.stop()
			return none
		}

		@test()
		def socks4AndSocks4a() !none {
			let echo = try startEcho()
			let server = try startSocks()
			let seen string[] = []
			server.allow(def (req Request) bool {
				seen.push("{req.version} {req.host} {req.user}")
				return true
			})
			let port = echo.ln.address().port
			let plain = try (try dialerFor("socks4", server, "ana")).dial("localhost:{port}", 5s)
			assert (try roundTrip(plain, "four")) == "four"
			try plain.close()
			let named = try (try dialerFor("socks4a", server)).dial("localhost:{port}", 5s)
			assert (try roundTrip(named, "four a")) == "four a"
			try named.close()
			assert seen.len() == 2
			assert seen[0] == "4 127.0.0.1 ana"
			assert seen[1] == "4 localhost "

			let v6 = ""
			tryDial(try dialerFor("socks4", server), "[::1]:{port}") onerror (err error) {
				v6 = kindOf(err)
				recover none
			}
			assert v6 == "Target:0"
			try server.close()
			echo.stop()
			return none
		}

		@test()
		def refusalsCarryTheReplyCode() !none {
			// Port 1 needs privileges to listen on, so no other test can
			// open it while this one expects it closed (a port taken from a
			// listener just stopped can be handed out again).
			let port = 1
			let server = try startSocks()
			let reported string[] = []
			server.onError(def (err error) { reported.push(err.message) })
			let closedPort = ""
			tryDial(try dialerFor("socks5", server), "127.0.0.1:{port}") onerror (err error) {
				closedPort = kindOf(err)
				recover none
			}
			assert closedPort == "Refused:5"
			// The server reports after it answered the client.
			for let i = 0; i < 200 && reported.len() == 0; i++ {
				time.sleep(5ms)
			}
			assert reported.len() == 1 && reported[0].contains("Connection refused")
			let four = ""
			tryDial(try dialerFor("socks4", server), "127.0.0.1:{port}") onerror (err error) {
				four = kindOf(err)
				recover none
			}
			assert four == "Refused:91"

			server.allow(req => false)
			let ruled = ""
			tryDial(try dialerFor("socks5", server), "127.0.0.1:{port}") onerror (err error) {
				ruled = kindOf(err)
				recover none
			}
			assert ruled == "Refused:2"

			let scheme = ""
			tryDial(new Dialer(try url.parse("gopher://{server.address().str()}")), "127.0.0.1:{port}") onerror (err error) {
				scheme = kindOf(err)
				recover none
			}
			assert scheme == "Scheme:0"
			try server.close()
			return none
		}

		@test()
		def chainsThroughAnotherProxy() !none {
			let echo = try startEcho()
			let first = try startSocks()
			let second = try startSocks()
			let hops string[] = []
			first.allow(def (req Request) bool {
				hops.push("first {req.port}")
				return true
			})
			second.allow(def (req Request) bool {
				hops.push("second {req.port}")
				return true
			})
			let inner = new Dialer(try url.parse("socks5://{second.address().str()}"), try dialerFor("socks4a", first))
			let stream = try inner.dial(echo.address(), 5s)
			assert (try roundTrip(stream, "two hops")) == "two hops"
			try stream.close()
			assert hops.len() == 2
			assert hops[0] == "first {second.address().port}"
			assert hops[1] == "second {echo.ln.address().port}"

			// The same chain made by the first server's upstream.
			first.upstream = try dialerFor("socks5", second)
			let again = try (try dialerFor("socks5", first)).dial(echo.address(), 5s)
			assert (try roundTrip(again, "upstream")) == "upstream"
			try again.close()
			assert hops.len() == 4
			try first.close()
			try second.close()
			echo.stop()
			return none
		}

		@test()
		def bindAcceptsThePeer() !none {
			let server = try startSocks()
			for let scheme in ["socks5", "socks4"] {
				let binding = try (try dialerFor(scheme, server)).listen("127.0.0.1:0", 5s)
				let (_, port) = try splitTarget(binding.address)
				assert port > 0
				let peer = try net.dialStream(binding.address, 3s)
				let stream = try binding.accept(5s)
				assert binding.peer == peer.localAddr().str()
				try net.writeAll(peer, "incoming".bytes(), 5s)
				assert string(try readExact(stream, 8, 5s)) == "incoming"
				try net.writeAll(stream, "answer".bytes(), 5s)
				assert string(try readExact(peer, 6, 5s)) == "answer"
				try binding.close()
				try peer.close()
			}
			try server.close()
			return none
		}

		@test()
		def bindTimesOutWithoutAPeer() !none {
			let server = try startSocks()
			server.dialTimeout = 300ms
			let binding = try (try dialerFor("socks5", server)).listen("127.0.0.1:0", 5s)
			let outcome = ""
			tryAcceptPeer(binding) onerror (err error) {
				outcome = kindOf(err)
				recover none
			}
			assert outcome == "Refused:6"
			try binding.close()
			try server.close()
			return none
		}

		@test()
		def udpAssociationRelaysDatagrams() !none {
			let server = try startSocks()
			let far = try net.socket(net.SocketDomain.IPv4, net.SocketType.Datagram)
			try far.bind("127.0.0.1:0")
			let farAddr = far.localAddr().str()

			let association = try (try dialerFor("socks5", server)).associate(5s)
			assert (try association.send("ping".bytes(), farAddr, 2s)) == 4
			let buf byte[] = []
			buf.len(64)
			let (n, relayed) = try far.readFrom(buf, 2s)
			assert string(buf[:n]) == "ping"
			// The datagram left from the proxy's relay socket.
			assert relayed.str() == association.relay

			try far.writeTo("pong".bytes(), relayed.str(), 2s)
			let reply byte[] = []
			reply.len(64)
			let (m, from) = try association.receive(reply, 2s)
			assert string(reply[:m]) == "pong"
			assert from == farAddr

			let unsupported = ""
			tryAssociation(try dialerFor("socks4", server)) onerror (err error) {
				unsupported = kindOf(err)
				recover none
			}
			assert unsupported == "Unsupported:0"
			try association.close()
			try far.close()
			try server.close()
			return none
		}

		@test()
		def httpConnectTunnels() !none {
			let echo = try startEcho()
			let web = try startHTTPProxy()
			let dialer = new Dialer(try url.parse("http://ana:secret@{web.ln.address().str()}"))
			let stream = try dialer.dial(echo.address(), 5s)
			assert (try roundTrip(stream, "through CONNECT")) == "through CONNECT"
			try stream.close()
			assert web.seenHead.startsWith("CONNECT {echo.address()} HTTP/1.1")
			assert web.seenHead.contains("Proxy-Authorization: Basic YW5hOnNlY3JldA==")
			echo.stop()

			let challenged = try startHTTPProxy("HTTP/1.1 407 Proxy Authentication Required\r\nProxy-Authenticate: Basic realm=\"corp\"\r\nContent-Length: 0\r\n\r\n")
			let challenge = ""
			let kind = ""
			tryDial(new Dialer(try url.parse("http://{challenged.ln.address().str()}")), "example.invalid:443") onerror (err error) {
				kind = kindOf(err)
				challenge = err.authenticate when err is ProxyError
				recover none
			}
			assert kind == "Auth:407"
			assert challenge == "Basic realm=\"corp\""

			let denied = try startHTTPProxy("HTTP/1.1 403 Forbidden\r\n\r\n")
			let refused = ""
			tryDial(new Dialer(try url.parse("http://{denied.ln.address().str()}")), "example.invalid:443") onerror (err error) {
				refused = kindOf(err)
				recover none
			}
			assert refused == "Refused:403"

			let unsupported = ""
			tryListen(new Dialer(try url.parse("http://{denied.ln.address().str()}"))) onerror (err error) {
				unsupported = kindOf(err)
				recover none
			}
			assert unsupported == "Unsupported:0"
			return none
		}

		@test()
		def targetsParse() !none {
			let (host, port) = try splitTarget("[2001:db8::1]:8443")
			assert host == "2001:db8::1" && port == 8443
			assert joinTarget(host, port) == "[2001:db8::1]:8443"
			let out byte[] = []
			try encodeAddress(out, host, port)
			assert out.len() == 1 + 16 + 2 && out[0] == 0x04
			let (back, backPort, next) = decodeAddress(out, 0)
			assert back == "2001:db8::1" && backPort == 8443 && next == out.len()
			let (_, _, short) = decodeAddress(out[:5], 0)
			assert short == -1
			let bad = ""
			splitTarget("example.com") onerror (err error) {
				bad = kindOf(err)
				recover ("", 0)
			}
			assert bad == "Target:0"
			return none
		}
	}
}
