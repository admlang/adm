partial module std.net.proxy {
	use (
		std.net
		std.net.proxy.wire::*
		std.net.url::(URL)
	)

	// Association is a UDP relay through a SOCKS5 proxy, from
	// `Dialer.associate`: datagrams sent through it leave from the proxy,
	// and what the proxy receives for it comes back. One task sends and
	// one receives at a time.
	type Association {
		// The proxy's relay address, "host:port".
		relay            string
		internal control net.Stream
		internal socket  net.Socket
		internal scratch byte[]     = []
		internal open    bool       = true

		def new(control net.Stream, socket net.Socket, relay string) {
			self.control = control
			self.socket = socket
			self.relay = relay
			scratch.len(65536)
		}

		// send relays one datagram to target ("host:port"; the proxy
		// resolves a host name) and returns the bytes of data sent.
		// Fails with ProxyError (Target) when the target does not parse,
		// NetError when the association is closed or the send fails.
		def send(data byte[], target string, timeout duration = 30s) !int {
			fail net.errorOf(net.ErrorCode.Closed, "send", target, "association is closed") unless open
			let (host, port) = try splitTarget(target)
			let packet byte[] = [0x00, 0x00, 0x00]
			try encodeAddress(packet, host, port)
			let header = packet.len()
			packet.push(...data)
			let sent = try socket.writeTo(packet, relay, timeout)
			return sent > header ?? (sent - header, 0)
		}

		// receive waits for the next relayed datagram, copies its
		// payload into buf (what does not fit is dropped) and returns the
		// length with the sender, "host:port".
		// Fails with NetError when the association is closed or nothing
		// arrives in time.
		def receive(buf byte[], timeout duration = 30s) !(int, string) {
			for {
				fail net.errorOf(net.ErrorCode.Closed, "receive", "", "association is closed") unless open
				let (n, _) = try socket.readFrom(scratch, timeout)
				// Reserved bytes, then the fragment number: fragments are
				// not reassembled, so they are dropped (RFC 1928 §7).
				continue when n < 4 || scratch[2] != 0x00
				let (host, port, start) = decodeAddress(scratch[:n], 3)
				continue when start < 0
				let size = n - start
				size = buf.len() when size > buf.len()
				for let i = 0; i < size; i++ {
					buf[i] = scratch[start + i]
				}
				return (size, joinTarget(host, port))
			}
			fail "unreachable"
		}

		// close ends the relay: the proxy drops it when the control
		// connection goes. A second close does nothing.
		// Fails when the socket or the connection refuses to close.
		def close() !none {
			return none unless open
			open = false
			socket.close() onerror recover none
			return try control.close()
		}
	}

	// tryAssociate is associateOn as an optional, so a failure can recover
	// to none.
	internal def tryAssociate(stream net.Stream, server URL, timeout duration) !?Association {
		return try associateOn(stream, server, timeout)
	}

	// associateOn sends UDP ASSOCIATE on an open stream to the proxy and
	// opens the local socket that talks to its relay.
	internal def associateOn(stream net.Stream, server URL, timeout duration) !Association {
		let about = describe(server)
		let (user, password) = credentials(server)
		try socks5Greet(stream, user, password, about, timeout)
		// The address this side will send from is not known yet: zeros.
		let (host, port) = try socks5Command(stream, commandAssociate, "0.0.0.0", 0, about, timeout)
		let relayHost = reachable(host, server)
		let ip = net.parseIPText(relayHost)
		if ip is none {
			let found = try net.resolve(relayHost)
			fail ProxyError{message: "{relayHost} resolves to no address", kind: ErrorKind.Target, proxy: about, target: relayHost} when found.len() == 0
			relayHost = found[0]
			ip = net.parseIPText(relayHost)
		}
		let v6 = !(ip is none) && ip.len() == 16
		let socket = try net.socket(v6 ?? (net.SocketDomain.IPv6, net.SocketDomain.IPv4), net.SocketType.Datagram)
		return new Association(stream, socket, joinTarget(relayHost, port))
	}
}
