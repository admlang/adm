internal partial module std.net.proxy.wire {
	use (
		std.net
		std.net.proxy::*
	)

	// SOCKS5 address types (RFC 1928 §4).
	const addressIPv4 = 0x01
	const addressName = 0x03
	const addressIPv6 = 0x04

	// readExact reads n bytes from the stream.
	// Fails with ProxyError (Protocol) when the stream ends first, else as
	// the read does.
	def readExact(stream net.Stream, n int, timeout duration) !byte[] {
		let out byte[] = []
		out.len(n)
		let have = 0
		for have < n {
			let got = try stream.read(out[have:], timeout)
			fail ProxyError{message: "the connection closed during the proxy handshake", kind: ErrorKind.Protocol} when got <= 0
			have += got
		}
		return out
	}

	// splitTarget is the host and port of "host:port" or "[v6]:port".
	// Fails with ProxyError (Target) when the text has no port or the
	// port is out of range.
	def splitTarget(target string) !(string, int) {
		let colon = -1
		for let i = target.len() - 1; i >= 0; i-- {
			break when target[i] == ']'
			if target[i] == ':' {
				colon = i
				break
			}
		}
		fail ProxyError{message: "the target {target} names no port", kind: ErrorKind.Target, target: target} when colon < 0
		let portText = target[colon + 1:]
		fail ProxyError{message: "the target {target} has no numeric port", kind: ErrorKind.Target, target: target} unless portText != "" && portText.isNumeric() && portText.len() <= 5
		let port = portText.toInt<int>()
		fail ProxyError{message: "the port of {target} is out of range", kind: ErrorKind.Target, target: target} when port > 65535
		let host = target[:colon].trimPrefix("[").trimSuffix("]")
		fail ProxyError{message: "the target {target} names no host", kind: ErrorKind.Target, target: target} when host == ""
		return (host, port)
	}

	// joinTarget is "host:port", an IPv6 host in brackets.
	def joinTarget(host string, port int) string {
		return "[{host}]:{port}" when host.contains(":") && !host.startsWith("[")
		return "{host}:{port}"
	}

	// encodeAddress appends a SOCKS5 address and port to out: 4 or 16
	// address bytes for an IP, a counted name otherwise.
	// Fails with ProxyError (Target) when a name is longer than 255 bytes.
	def encodeAddress(out byte[], host string, port int) !none {
		let ip = net.parseIPText(host)
		if ip is none {
			let name = host.bytes()
			fail ProxyError{message: "the host name {host} is longer than 255 bytes", kind: ErrorKind.Target, target: host} when name.len() > 255
			out.push(byte(addressName))
			out.push(byte(name.len()))
			out.push(...name)
		} else {
			out.push(byte(ip.len() == 4 ?? (addressIPv4, addressIPv6)))
			out.push(...ip)
		}
		out.push(byte((port >> 8) & 0xFF))
		out.push(byte(port & 0xFF))
		return none
	}

	// readAddress reads a SOCKS5 address and port from the stream.
	// Fails with ProxyError (Protocol) on an unknown address type.
	def readAddress(stream net.Stream, timeout duration) !(string, int) {
		let kind = try readExact(stream, 1, timeout)
		let host = ""
		match int(kind[0]) {
			case 0x01:
				host = net.ipText(try readExact(stream, 4, timeout))
			case 0x04:
				host = net.ipText(try readExact(stream, 16, timeout))
			case 0x03:
				let size = try readExact(stream, 1, timeout)
				host = string(try readExact(stream, int(size[0]), timeout))
			default:
				fail ProxyError{message: "unknown SOCKS5 address type {kind[0]}", kind: ErrorKind.Protocol, reply: int(kind[0])}
		}
		let port = try readExact(stream, 2, timeout)
		return (host, (int(port[0]) << 8) | int(port[1]))
	}

	// decodeAddress reads a SOCKS5 address and port from data at offset
	// and returns them with the offset after them; the offset is -1 when
	// the data is too short or the address type unknown.
	def decodeAddress(data byte[], offset int) (string, int, int) {
		return ("", 0, -1) when offset >= data.len()
		let at = offset + 1
		let host = ""
		match int(data[offset]) {
			case 0x01:
				return ("", 0, -1) when at + 4 + 2 > data.len()
				host = net.ipText(data[at:at + 4])
				at += 4
			case 0x04:
				return ("", 0, -1) when at + 16 + 2 > data.len()
				host = net.ipText(data[at:at + 16])
				at += 16
			case 0x03:
				return ("", 0, -1) when at >= data.len()
				let size = int(data[at])
				at++
				return ("", 0, -1) when at + size + 2 > data.len()
				host = string(data[at:at + size])
				at += size
			default:
				return ("", 0, -1)
		}
		return (host, (int(data[at]) << 8) | int(data[at + 1]), at + 2)
	}

	// socks5ReplyText names a SOCKS5 reply code (RFC 1928 §6).
	def socks5ReplyText(code int) string {
		match code {
			case 0x01:
				return "general failure"
			case 0x02:
				return "connection not allowed by ruleset"
			case 0x03:
				return "network unreachable"
			case 0x04:
				return "host unreachable"
			case 0x05:
				return "connection refused"
			case 0x06:
				return "TTL expired"
			case 0x07:
				return "command not supported"
			case 0x08:
				return "address type not supported"
			default:
				return "reply code {code}"
		}
	}

	// socks4ReplyText names a SOCKS4 reply code.
	def socks4ReplyText(code int) string {
		match code {
			case 91:
				return "request rejected or failed"
			case 92:
				return "the proxy cannot reach the client's identd"
			case 93:
				return "identd reports a different user"
			default:
				return "reply code {code}"
		}
	}

	// replyFor is the SOCKS5 reply code that tells a client why its
	// request failed here.
	def replyFor(err error) int {
		return 0x01 unless err is net.NetError
		let kind = err.kind
		return 0x05 when kind == net.ErrorCode.ConnRefused
		return 0x03 when kind == net.ErrorCode.NetUnreach
		return 0x04 when kind == net.ErrorCode.HostUnreach || kind == net.ErrorCode.Resolve
		return 0x06 when kind == net.ErrorCode.TimedOut
		return 0x01
	}
}
