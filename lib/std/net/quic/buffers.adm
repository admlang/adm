// Byte-stream bookkeeping shared by QUIC streams and the CRYPTO streams:
// sets of ranges, a send buffer that knows what was acknowledged and
// lost, and a receive buffer that puts segments back in order.
internal partial module std.net.quic.core {
	// RangeSet is a set of integers kept as sorted, disjoint,
	// non-adjacent half-open ranges [start, end).
	type RangeSet {
		starts int[] = []
		ends   int[] = []

		def isEmpty() bool {
			return starts.len() == 0
		}

		def count() int {
			return starts.len()
		}

		// add puts [start, end) in, merging what it touches.
		def add(start int, end int) {
			return when end <= start
			let n = starts.len()
			// The common cases: past the end, or extending the last range.
			if n == 0 || start > ends[n - 1] {
				starts.push(start)
				ends.push(end)
				return
			}
			if start >= starts[n - 1] {
				ends[n - 1] = end when end > ends[n - 1]
				return
			}
			let newStarts int[] = []
			let newEnds int[] = []
			let placed = false
			for let i = 0; i < n; i++ {
				if ends[i] < start {
					newStarts.push(starts[i])
					newEnds.push(ends[i])
					continue
				}
				if starts[i] > end {
					if !placed {
						newStarts.push(start)
						newEnds.push(end)
						placed = true
					}
					newStarts.push(starts[i])
					newEnds.push(ends[i])
					continue
				}
				start = starts[i] when starts[i] < start
				end = ends[i] when ends[i] > end
			}
			if !placed {
				newStarts.push(start)
				newEnds.push(end)
			}
			starts = newStarts
			ends = newEnds
		}

		// removeBelow drops every value under limit.
		def removeBelow(limit int) {
			let drop = 0
			for drop < starts.len() && ends[drop] <= limit {
				drop++
			}
			if drop > 0 {
				starts = starts[drop:].clone()
				ends = ends[drop:].clone()
			}
			starts[0] = limit when starts.len() > 0 && starts[0] < limit
		}

		// remove takes [start, end) out.
		def remove(start int, end int) {
			return when end <= start || starts.len() == 0
			let newStarts int[] = []
			let newEnds int[] = []
			for let i = 0; i < starts.len(); i++ {
				if ends[i] <= start || starts[i] >= end {
					newStarts.push(starts[i])
					newEnds.push(ends[i])
					continue
				}
				if starts[i] < start {
					newStarts.push(starts[i])
					newEnds.push(start)
				}
				if ends[i] > end {
					newStarts.push(end)
					newEnds.push(ends[i])
				}
			}
			starts = newStarts
			ends = newEnds
		}

		def contains(value int) bool {
			for let i = 0; i < starts.len(); i++ {
				return false when value < starts[i]
				return true when value < ends[i]
			}
			return false
		}

		// keepLast drops the lowest ranges beyond the newest `limit`.
		def keepLast(limit int) {
			let extra = starts.len() - limit
			return when extra <= 0
			starts = starts[extra:].clone()
			ends = ends[extra:].clone()
		}
	}

	// SendBuffer holds the bytes of one direction of a stream from the
	// first one not yet acknowledged: what was never sent, what was lost
	// and goes again, and whether the end of the stream is settled.
	type SendBuffer {
		data     byte[]   = []
		// The stream offset of data[0].
		base     int      = 0
		// The first offset never sent.
		next     int      = 0
		lost     RangeSet
		acked    RangeSet
		// The stream ends at this offset once the writer closed it; -1
		// while it is open.
		finAt    int      = -1
		finSent  bool     = false
		finAcked bool     = false

		def new() {
			lost = new RangeSet()
			acked = new RangeSet()
		}

		// The offset after the last byte written.
		def length() int {
			return base + data.len()
		}

		// Bytes written and not yet acknowledged.
		def buffered() int {
			return data.len()
		}

		def write(bytes byte[]) {
			data.push(...bytes)
		}

		def closeWrite() {
			finAt = length() when finAt < 0
		}

		// Whether there is anything to put in a packet: lost bytes, new
		// bytes, or an end of stream not sent yet.
		def pending() bool {
			return !lost.isEmpty() || next < length() || (finAt >= 0 && !finSent)
		}

		// Whether new bytes, as opposed to retransmissions, wait.
		def hasNew() bool {
			return next < length()
		}

		// take picks the next range to send, at most `max` bytes, and at
		// most `fresh` of them new (flow control credit): lost bytes
		// first. It returns the offset, a view of the bytes, and whether
		// the range ends the stream; the offset is -1 when nothing fits.
		def take(max int, fresh int) (int, byte[], bool) {
			if !lost.isEmpty() {
				let start = lost.starts[0]
				let end = lost.ends[0]
				end = start + max when end - start > max
				return (-1, [], false) when max <= 0
				lost.remove(start, end)
				let fin = finAt >= 0 && end == finAt
				finSent = true when fin
				return (start, data[start - base:end - base], fin)
			}
			let end = length()
			end = next + max when end - next > max
			end = next + fresh when end - next > fresh
			let fin = finAt >= 0 && end == finAt
			return (-1, [], false) when end <= next && !(fin && !finSent)
			let start = next
			next = end
			finSent = true when fin
			return (start, data[start - base:end - base], fin)
		}

		// ack records that [offset, offset + size) arrived, and the end
		// of the stream when fin; the acknowledged prefix is released.
		def ack(offset int, size int, fin bool) {
			finAcked = true when fin
			let end = offset + size
			return when end <= base
			acked.add(offset < base ?? (base, offset), end)
			lost.remove(offset, end)
			return when acked.isEmpty() || acked.starts[0] > base
			let upTo = acked.ends[0]
			data = data[upTo - base:].clone()
			base = upTo
			acked.removeBelow(base)
		}

		// lose marks [offset, offset + size) for sending again, except
		// what was acknowledged since, and the end of the stream when fin.
		def lose(offset int, size int, fin bool) {
			finSent = false when fin && !finAcked
			let start = offset < base ?? (base, offset)
			let end = offset + size
			return when end <= start
			lost.add(start, end)
			for let i = 0; i < acked.count(); i++ {
				lost.remove(acked.starts[i], acked.ends[i])
			}
		}

		// Whether every byte and the end of the stream were acknowledged.
		def settled() bool {
			return finAt >= 0 && finAcked && base == finAt
		}
	}

	// RecvBuffer puts the segments of one direction of a stream back in
	// order and hands the contiguous bytes to the reader.
	type RecvBuffer {
		// Segments above `delivered`, sorted by offset.
		offsets   int[]    = []
		chunks    byte[][] = []
		// Bytes made contiguous so far.
		delivered int      = 0
		// Contiguous bytes not read yet, and the read position in the
		// first chunk.
		ready     byte[][] = []
		readyAt   int      = 0
		unread    int      = 0
		// The highest offset any segment reached.
		highest   int      = 0
		// The size of the stream once its end is known; -1 before.
		finalSize int      = -1

		// insert adds a segment; bytes already delivered are ignored.
		def insert(offset int, data byte[]) {
			let end = offset + data.len()
			highest = end when end > highest
			return when end <= delivered
			if offset <= delivered {
				deliver(data[delivered - offset:])
				drain()
				return
			}
			// Out of order: keep it sorted; an exact repeat is dropped.
			let at = 0
			for at < offsets.len() && offsets[at] < offset {
				at++
			}
			return when at < offsets.len() && offsets[at] == offset && chunks[at].len() >= data.len()
			let newOffsets int[] = []
			let newChunks byte[][] = []
			for let i = 0; i < at; i++ {
				newOffsets.push(offsets[i])
				newChunks.push(chunks[i])
			}
			newOffsets.push(offset)
			newChunks.push(data.clone())
			for let i = at; i < offsets.len(); i++ {
				newOffsets.push(offsets[i])
				newChunks.push(chunks[i])
			}
			offsets = newOffsets
			chunks = newChunks
		}

		def deliver(data byte[]) {
			return when data.len() == 0
			ready.push(data.clone())
			delivered += data.len()
			unread += data.len()
		}

		// drain moves stored segments that now touch the delivered edge.
		def drain() {
			let used = 0
			for used < offsets.len() && offsets[used] <= delivered {
				let end = offsets[used] + chunks[used].len()
				deliver(chunks[used][delivered - offsets[used]:]) when end > delivered
				used++
			}
			if used > 0 {
				offsets = offsets[used:].clone()
				chunks = chunks[used:].clone()
			}
		}

		// read copies contiguous bytes into buf and returns the count.
		def read(buf byte[]) int {
			let n = 0
			for n < buf.len() && ready.len() > 0 {
				let head = ready[0]
				let take = head.len() - readyAt
				take = buf.len() - n when take > buf.len() - n
				for let i = 0; i < take; i++ {
					buf[n + i] = head[readyAt + i]
				}
				n += take
				readyAt += take
				if readyAt >= head.len() {
					ready = ready[1:].clone()
					readyAt = 0
				}
			}
			unread -= n
			return n
		}

		// Whether the end of the stream was reached by the reader.
		def finished() bool {
			return finalSize >= 0 && delivered == finalSize && unread == 0
		}

		// Whether every byte up to the end of the stream arrived.
		def complete() bool {
			return finalSize >= 0 && delivered == finalSize
		}
	}
}
