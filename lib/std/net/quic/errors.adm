partial module std.net.quic {
	use std.errors

	// TransportCode is a QUIC transport error code (RFC 9000 §20.1).
	enum TransportCode {
		NoError = 0,
		InternalError = 1,
		ConnectionRefused = 2,
		FlowControl = 3,
		StreamLimit = 4,
		StreamState = 5,
		FinalSize = 6,
		FrameEncoding = 7,
		TransportParameter = 8,
		ConnectionIDLimit = 9,
		ProtocolViolation = 10,
		InvalidToken = 11,
		Application = 12,
		CryptoBufferExceeded = 13,
		KeyUpdate = 14,
		AEADLimitReached = 15,
		NoViablePath = 16,
		// A TLS alert: `wireCode` is 0x100 plus the alert (RFC 9001 §4.8).
		Crypto = 256,
	}

	// TransportError is the payload of a failure of the connection
	// itself: this endpoint or the peer closed it with a transport error.
	struct TransportError {
		message   string
		code      string            = "quic"
		cause     ?error
		stack     errors.StackTrace
		kind      TransportCode     = TransportCode.InternalError
		// The code as it travels: `kind.value`, or 0x100 plus the TLS
		// alert for `Crypto`.
		wireCode  int               = 0
		// The frame type that caused the error, 0 when none did.
		frameType int               = 0
		// True when the peer closed the connection with this error.
		remote    bool              = false
	}

	// ApplicationError is the payload of what the application protocol
	// decided: the peer closed the connection, reset a stream, or asked
	// to stop sending on one, with a code of that protocol (HTTP/3's, for
	// one).
	struct ApplicationError {
		message  string
		code     string            = "quic.application"
		cause    ?error
		stack    errors.StackTrace
		// The application protocol's error code.
		appCode  int               = 0
		// The stream concerned, -1 when the connection was closed.
		streamID int               = -1
		// True when the peer sent it.
		remote   bool              = true
	}

	// ClosedError is the payload of a call on a connection or stream that
	// ended without an error code: an idle timeout, a stateless reset, a
	// local close, a handshake that timed out.
	struct ClosedError {
		message string
		code    string            = "quic.closed"
		cause   ?error
		stack   errors.StackTrace
		// Why: "idle", "reset", "closed", "timeout", "version".
		reason  string            = "closed"
	}
}
