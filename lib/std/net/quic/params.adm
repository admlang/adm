// QUIC transport parameters (RFC 9000 §18), carried in the TLS
// quic_transport_parameters extension.
internal partial module std.net.quic.wire {
	use std.net.quic::*

	// Parameters is one endpoint's transport parameters. A field left at
	// its default is the protocol's default and is not sent.
	struct Parameters {
		// Server only: the destination connection ID of the client's
		// first Initial, and the source connection ID of a Retry.
		originalDCID               byte[] = []
		hasOriginalDCID            bool   = false
		retrySCID                  byte[] = []
		hasRetrySCID               bool   = false
		// The source connection ID of this endpoint's first Initial.
		initialSCID                byte[] = []
		hasInitialSCID             bool   = false
		// Milliseconds; 0 is no idle timeout.
		maxIdleTimeout             int    = 0
		// Server only: the reset token of its handshake connection ID.
		statelessResetToken        byte[] = []
		maxUDPPayloadSize          int    = 65527
		initialMaxData             int    = 0
		initialMaxStreamBidiLocal  int    = 0
		initialMaxStreamBidiRemote int    = 0
		initialMaxStreamUni        int    = 0
		initialMaxStreamsBidi      int    = 0
		initialMaxStreamsUni       int    = 0
		ackDelayExponent           int    = 3
		// Milliseconds.
		maxAckDelay                int    = 25
		disableActiveMigration     bool   = false
		activeConnectionIDLimit    int    = 2
		// RFC 9221: the largest DATAGRAM frame accepted, 0 for none.
		maxDatagramFrameSize       int    = 0
	}

	// encodeParameters renders the parameters that differ from their
	// defaults.
	def encodeParameters(p Parameters) byte[] {
		let out byte[] = []
		putBytesParameter(out, 0x00, p.originalDCID) when p.hasOriginalDCID
		putIntParameter(out, 0x01, p.maxIdleTimeout) when p.maxIdleTimeout > 0
		putBytesParameter(out, 0x02, p.statelessResetToken) when p.statelessResetToken.len() == 16
		putIntParameter(out, 0x03, p.maxUDPPayloadSize) when p.maxUDPPayloadSize != 65527
		putIntParameter(out, 0x04, p.initialMaxData) when p.initialMaxData > 0
		putIntParameter(out, 0x05, p.initialMaxStreamBidiLocal) when p.initialMaxStreamBidiLocal > 0
		putIntParameter(out, 0x06, p.initialMaxStreamBidiRemote) when p.initialMaxStreamBidiRemote > 0
		putIntParameter(out, 0x07, p.initialMaxStreamUni) when p.initialMaxStreamUni > 0
		putIntParameter(out, 0x08, p.initialMaxStreamsBidi) when p.initialMaxStreamsBidi > 0
		putIntParameter(out, 0x09, p.initialMaxStreamsUni) when p.initialMaxStreamsUni > 0
		putIntParameter(out, 0x0a, p.ackDelayExponent) when p.ackDelayExponent != 3
		putIntParameter(out, 0x0b, p.maxAckDelay) when p.maxAckDelay != 25
		putBytesParameter(out, 0x0c, []) when p.disableActiveMigration
		putIntParameter(out, 0x0e, p.activeConnectionIDLimit) when p.activeConnectionIDLimit != 2
		putBytesParameter(out, 0x0f, p.initialSCID) when p.hasInitialSCID
		putBytesParameter(out, 0x10, p.retrySCID) when p.hasRetrySCID
		putIntParameter(out, 0x20, p.maxDatagramFrameSize) when p.maxDatagramFrameSize > 0
		return out
	}

	def putIntParameter(out byte[], id int, value int) {
		putVarint(out, id)
		putVarint(out, varintSize(value))
		putVarint(out, value)
	}

	def putBytesParameter(out byte[], id int, value byte[]) {
		putVarint(out, id)
		putVarint(out, value.len())
		out.push(...value)
	}

	// decodeParameters reads the peer's parameters; `fromServer` says
	// which side sent them, since a client must not send the server-only
	// ones. Unknown parameters are skipped.
	// Fails with TransportError (TransportParameter) for a malformed
	// block, a duplicate, a value out of range or a parameter the sender
	// may not send.
	def decodeParameters(data byte[], fromServer bool) !Parameters {
		let p = Parameters{}
		let c = new Cursor(data)
		let seen int[] = []
		for c.left() > 0 {
			let id = c.varint()
			let body = c.bytes(c.varint())
			fail transportError(TransportCode.TransportParameter, "transport parameters are cut short") when c.short
			fail transportError(TransportCode.TransportParameter, "transport parameter {id} is sent twice") when seen.includes(id)
			seen.push(id)
			let v = new Cursor(body)
			let value = 0
			let numeric = id := 0x01 || 0x03 || 0x04 || 0x05 || 0x06 || 0x07 || 0x08 || 0x09 || 0x0a || 0x0b || 0x0e || 0x20
			if numeric {
				value = v.varint()
				fail transportError(TransportCode.TransportParameter, "transport parameter {id} is not one integer") when v.short || v.left() != 0
			}
			let serverOnly = id := 0x00 || 0x02 || 0x0d || 0x10
			fail transportError(TransportCode.TransportParameter, "a client sent the server's transport parameter {id}") when serverOnly && !fromServer
			match id {
				case 0x00:
					p.originalDCID = body
					p.hasOriginalDCID = true
				case 0x01:
					p.maxIdleTimeout = value
				case 0x02:
					fail transportError(TransportCode.TransportParameter, "a stateless reset token is 16 bytes") when body.len() != 16
					p.statelessResetToken = body
				case 0x03:
					fail transportError(TransportCode.TransportParameter, "max_udp_payload_size is below 1200") when value < 1200
					p.maxUDPPayloadSize = value
				case 0x04:
					p.initialMaxData = value
				case 0x05:
					p.initialMaxStreamBidiLocal = value
				case 0x06:
					p.initialMaxStreamBidiRemote = value
				case 0x07:
					p.initialMaxStreamUni = value
				case 0x08:
					fail transportError(TransportCode.TransportParameter, "initial_max_streams_bidi passes 2^60") when value > 1152921504606846976
					p.initialMaxStreamsBidi = value
				case 0x09:
					fail transportError(TransportCode.TransportParameter, "initial_max_streams_uni passes 2^60") when value > 1152921504606846976
					p.initialMaxStreamsUni = value
				case 0x0a:
					fail transportError(TransportCode.TransportParameter, "ack_delay_exponent is above 20") when value > 20
					p.ackDelayExponent = value
				case 0x0b:
					fail transportError(TransportCode.TransportParameter, "max_ack_delay is 2^14 ms or more") when value >= 16384
					p.maxAckDelay = value
				case 0x0c:
					fail transportError(TransportCode.TransportParameter, "disable_active_migration carries a value") when body.len() != 0
					p.disableActiveMigration = true
				case 0x0d:
					// preferred_address: IPv4 and port, IPv6 and port, a
					// connection ID and its reset token. Read for its
					// shape; this endpoint stays on the address it dialed.
					fail transportError(TransportCode.TransportParameter, "preferred_address is malformed") when body.len() < 4 + 2 + 16 + 2 + 1 + 16 || body.len() != 4 + 2 + 16 + 2 + 1 + int(body[24]) + 16
				case 0x0e:
					fail transportError(TransportCode.TransportParameter, "active_connection_id_limit is below 2") when value < 2
					p.activeConnectionIDLimit = value
				case 0x0f:
					p.initialSCID = body
					p.hasInitialSCID = true
				case 0x10:
					p.retrySCID = body
					p.hasRetrySCID = true
				case 0x20:
					p.maxDatagramFrameSize = value
				default:
			}
		}
		return p
	}
}
