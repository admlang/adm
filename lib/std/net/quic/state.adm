// The parts a QUIC connection is made of: packet number spaces, streams
// and connection IDs.
internal partial module std.net.quic.core {
	use (
		std.net.quic.wire::*
		std.net.quic::*
	)

	// Packet number spaces, also the index of their encryption level in
	// the TLS handshake carrier.
	const spaceInitial = 0
	const spaceHandshake = 1
	const spaceApplication = 2

	// Space is one packet number space (RFC 9000 §12.3) with the keys of
	// its encryption level and its CRYPTO stream.
	type Space {
		index             int
		sendKeys          ?Keys
		recvKeys          ?Keys
		// Keys were dropped: packets of this space are ignored from now.
		discarded         bool         = false
		nextPN            int          = 0
		// The largest of this side's packet numbers the peer acknowledged.
		largestAcked      int          = -1
		// Packets sent and not yet acknowledged or lost, oldest first.
		sent              SentPacket[] = []
		// When the oldest unacknowledged packet behind an acknowledged
		// one is declared lost; -1 when none waits.
		lossTime          int          = -1
		lastElicitingSent int          = -1
		// Packet numbers received, for ACK frames and duplicate checks.
		received          RangeSet
		largestReceived   int          = -1
		largestReceivedAt int          = 0
		// An ACK is owed; `ackDeadline` is when it must leave at the
		// latest (-1: at once), `elicitingUnacked` counts what it covers.
		ackOwed           bool         = false
		ackDeadline       int          = -1
		elicitingUnacked  int          = 0
		// Probe packets a timeout asked for.
		probes            int          = 0
		cryptoSend        SendBuffer
		cryptoRecv        RecvBuffer

		def new(index int) {
			self.index = index
			received = new RangeSet()
			cryptoSend = new SendBuffer()
			cryptoRecv = new RecvBuffer()
		}

		// Whether an ack-eliciting packet waits for its acknowledgment.
		def elicitingInFlight() bool {
			for let p in sent {
				return true when p.ackEliciting
			}
			return false
		}
	}

	// StreamState is one stream of a connection: the sending and the
	// receiving half, each present when the stream has that direction.
	type StreamState {
		id            int
		// Sending half.
		canSend       bool          = true
		send          SendBuffer
		// The offset up to which the peer lets this side send.
		sendMax       int           = 0
		// This side reset the stream with this code; -1 when it did not.
		resetCode     int           = -1
		resetSent     bool          = false
		resetAcked    bool          = false
		// The peer asked to stop with this code; -1 when it did not.
		stoppedCode   int           = -1
		// Receiving half.
		canReceive    bool          = true
		recv          RecvBuffer
		// The offset up to which this side lets the peer send, the bytes
		// the reader took, and the window kept open ahead of the reader.
		recvMax       int           = 0
		recvWindow    int           = 0
		consumed      int           = 0
		// The peer reset the stream with this code; -1 when it did not.
		peerResetCode int           = -1
		// This side asked the peer to stop with this code; -1 when not.
		stopCode      int           = -1
		stopSent      bool          = false
		// Frames owed for this stream.
		owesMaxData   bool          = false
		// The reader waits on one and the writer on the other: a wake-up
		// one of them took would be lost to the other.
		readSignal    channel<none>
		writeSignal   channel<none>
		// Handed to the application by open or accept.
		announced     bool          = false
		// Counted against the peer's stream limit until released.
		released      bool          = false

		def new(id int) {
			self.id = id
			send = new SendBuffer()
			recv = new RecvBuffer()
			readSignal = new channel<none>(1)
			writeSignal = new channel<none>(1)
		}

		// Wakes the reader and the writer; each checks what it waits for.
		def wake() {
			readSignal.offer(none)
			writeSignal.offer(none)
		}

		// Whether the sending half needs nothing more from the peer.
		def sendDone() bool {
			return true unless canSend
			return resetAcked when resetCode >= 0
			return send.settled()
		}

		// Whether the receiving half is over: read to its end, or reset.
		def recvDone() bool {
			return true unless canReceive
			return true when peerResetCode >= 0
			return recv.finished()
		}
	}

	// streamIsUni reports whether the ID names a unidirectional stream.
	def streamIsUni(id int) bool {
		return (id & 0x02) != 0
	}

	// streamByClient reports whether the client opened the stream.
	def streamByClient(id int) bool {
		return (id & 0x01) == 0
	}

	// LocalID is a connection ID this endpoint issued to its peer.
	struct LocalID {
		sequence   int
		id         byte[]
		resetToken byte[]
		// NEW_CONNECTION_ID for it still has to be sent.
		announce   bool   = false
	}

	// PeerID is a connection ID the peer issued to this endpoint.
	struct PeerID {
		sequence   int
		id         byte[]
		resetToken byte[] = []
	}

	// PacketSink is where a connection hands its datagrams: the socket
	// of its endpoint.
	interface PacketSink {
		// Sends one datagram; a failure is the transport's to report.
		def sendDatagram(data byte[], to string)
		// Tells the endpoint a connection ID starts or stops routing to
		// the connection.
		def bindID(id byte[], conn Conn)
		def unbindID(id byte[])
		// A stateless reset token for a connection ID this endpoint
		// issues.
		def resetTokenFor(id byte[]) byte[]
		// A connection finished its handshake.
		def established(conn Conn)
	}
}
