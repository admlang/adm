// The QUIC wire image (RFC 9000 §12-§19): variable-length integers,
// packet headers and frames.
internal partial module std.net.quic.wire {
	use std.net.quic::*

	// Packet kinds. The first four are the long header types of version 1
	// by their two type bits (RFC 9000 §17.2).
	const packetInitial = 0
	const packetZeroRTT = 1
	const packetHandshake = 2
	const packetRetry = 3
	const packetShort = 4
	const packetVersionNegotiation = 5

	// Frame types (RFC 9000 §19, RFC 9221 for DATAGRAM).
	const framePadding = 0x00
	const framePing = 0x01
	const frameAck = 0x02
	const frameAckECN = 0x03
	const frameResetStream = 0x04
	const frameStopSending = 0x05
	const frameCrypto = 0x06
	const frameNewToken = 0x07
	const frameStream = 0x08
	const frameMaxData = 0x10
	const frameMaxStreamData = 0x11
	const frameMaxStreamsBidi = 0x12
	const frameMaxStreamsUni = 0x13
	const frameDataBlocked = 0x14
	const frameStreamDataBlocked = 0x15
	const frameStreamsBlockedBidi = 0x16
	const frameStreamsBlockedUni = 0x17
	const frameNewConnectionID = 0x18
	const frameRetireConnectionID = 0x19
	const framePathChallenge = 0x1a
	const framePathResponse = 0x1b
	const frameConnectionClose = 0x1c
	const frameApplicationClose = 0x1d
	const frameHandshakeDone = 0x1e
	const frameDatagram = 0x30
	const frameDatagramLength = 0x31

	// The largest value a variable-length integer holds: 2^62 - 1.
	const maxVarint = 4611686018427387903

	// varintSize is the number of bytes the shortest encoding of v takes.
	def varintSize(v int) int {
		return 1 when v < 64
		return 2 when v < 16384
		return 4 when v < 1073741824
		return 8
	}

	// putVarint appends v in its shortest encoding (RFC 9000 §16).
	def putVarint(out byte[], v int) {
		if v < 64 {
			out.push(byte(v))
		} else if v < 16384 {
			out.push(byte(0x40 | (v >> 8)), byte(v & 0xFF))
		} else if v < 1073741824 {
			out.push(byte(0x80 | (v >> 24)), byte((v >> 16) & 0xFF), byte((v >> 8) & 0xFF), byte(v & 0xFF))
		} else {
			out.push(byte(0xC0 | ((v >> 56) & 0x3F)), byte((v >> 48) & 0xFF), byte((v >> 40) & 0xFF), byte((v >> 32) & 0xFF))
			out.push(byte((v >> 24) & 0xFF), byte((v >> 16) & 0xFF), byte((v >> 8) & 0xFF), byte(v & 0xFF))
		}
	}

	// putVarint2 appends v in exactly two bytes; v is below 16384. A length
	// written before its content is known takes this form.
	def putVarint2(out byte[], v int) {
		out.push(byte(0x40 | (v >> 8)), byte(v & 0xFF))
	}

	// putUint32 appends v big-endian.
	def putUint32(out byte[], v int) {
		out.push(byte((v >> 24) & 0xFF), byte((v >> 16) & 0xFF), byte((v >> 8) & 0xFF), byte(v & 0xFF))
	}

	// Cursor reads a byte range front to back. A read past the end
	// returns zeros and sets `short`, which the caller checks once after
	// a whole structure.
	type Cursor {
		data  byte[]
		pos   int    = 0
		end   int    = 0
		short bool   = false

		def new(data byte[], pos int = 0, end int = -1) {
			self.data = data
			self.pos = pos
			self.end = end < 0 ?? (data.len(), end)
		}

		def left() int {
			return end - pos
		}

		def byte() int {
			if pos >= end {
				short = true
				return 0
			}
			pos++
			return int(data[pos - 1])
		}

		def uint32() int {
			if pos + 4 > end {
				short = true
				pos = end
				return 0
			}
			pos += 4
			return (int(data[pos - 4]) << 24) | (int(data[pos - 3]) << 16) | (int(data[pos - 2]) << 8) | int(data[pos - 1])
		}

		def varint() int {
			if pos >= end {
				short = true
				return 0
			}
			let first = int(data[pos])
			let size = 1 << (first >> 6)
			if pos + size > end {
				short = true
				pos = end
				return 0
			}
			let v = first & 0x3F
			for let i = 1; i < size; i++ {
				v = (v << 8) | int(data[pos + i])
			}
			pos += size
			return v
		}

		// The next n bytes as a view of the data.
		def bytes(n int) byte[] {
			if n < 0 || pos + n > end {
				short = true
				pos = end
				return []
			}
			pos += n
			return data[pos - n:pos]
		}
	}

	// Header is a packet header up to, and not including, the packet
	// number, which stays protected until the keys are applied.
	struct Header {
		kind     int    = 0
		version  int    = 0
		dcid     byte[] = []
		scid     byte[] = []
		// Initial: the address validation token. Retry: the retry token.
		token    byte[] = []
		// Where the packet number starts in the datagram.
		pnOffset int    = 0
		// Where the packet ends in the datagram: a datagram may hold
		// several long header packets (RFC 9000 §12.2).
		end      int    = 0
		// Version Negotiation: the versions the server speaks.
		versions int[]  = []
		// False when the bytes are not a packet this side can read.
		ok       bool   = true
	}

	// parseHeader reads the header of the packet that starts at offset in
	// a datagram. Short headers carry no connection ID length, so the
	// length this endpoint issues is given. `ok` is false for bytes that
	// are too short or carry a wrong fixed part.
	def parseHeader(datagram byte[], offset int, localIDLength int) Header {
		let h = Header{}
		let c = new Cursor(datagram, offset)
		let first = c.byte()
		if (first & 0x80) == 0 {
			h.kind = packetShort
			h.dcid = c.bytes(localIDLength)
			h.pnOffset = c.pos
			h.end = datagram.len()
			h.ok = !c.short && (first & 0x40) != 0
			return h
		}
		h.version = c.uint32()
		h.dcid = c.bytes(c.byte())
		h.scid = c.bytes(c.byte())
		if c.short {
			h.ok = false
			return h
		}
		if h.version == 0 {
			h.kind = packetVersionNegotiation
			for c.left() >= 4 {
				h.versions.push(c.uint32())
			}
			h.end = datagram.len()
			return h
		}
		h.kind = (first >> 4) & 0x03
		// Connection IDs of version 1 are at most 20 bytes; a longer one
		// in another version still reaches version negotiation.
		if h.kind == packetRetry {
			// The token runs up to the 16-byte integrity tag.
			h.end = datagram.len()
			h.ok = c.left() >= 16 && (first & 0x40) != 0
			h.token = c.bytes(c.left() - 16) when h.ok
			h.pnOffset = c.pos
			return h
		}
		h.token = c.bytes(c.varint()) when h.kind == packetInitial
		let length = c.varint()
		h.pnOffset = c.pos
		h.end = c.pos + length
		h.ok = !c.short && h.end <= datagram.len() && (first & 0x40) != 0
		return h
	}

	// longHeader writes a long header up to the packet number: the first
	// byte carries the type and the packet number length, and the length
	// field is two bytes so it can be filled in afterwards (the returned
	// offset is where it starts).
	def longHeader(out byte[], kind int, version int, dcid byte[], scid byte[], token byte[], pnLength int) int {
		out.push(byte(0xC0 | (kind << 4) | (pnLength - 1)))
		putUint32(out, version)
		out.push(byte(dcid.len()))
		out.push(...dcid)
		out.push(byte(scid.len()))
		out.push(...scid)
		if kind == packetInitial {
			putVarint(out, token.len())
			out.push(...token)
		}
		let at = out.len()
		out.push(0x40, 0x00)
		return at
	}

	// shortHeader writes a 1-RTT header up to the packet number.
	def shortHeader(out byte[], dcid byte[], keyPhase int, spin bool, pnLength int) {
		out.push(byte(0x40 | (spin ?? (0x20, 0x00)) | (keyPhase << 2) | (pnLength - 1)))
		out.push(...dcid)
	}

	// putPacketNumber appends the low bytes of a packet number.
	def putPacketNumber(out byte[], pn int, length int) {
		for let i = length - 1; i >= 0; i-- {
			out.push(byte((pn >> (8 * i)) & 0xFF))
		}
	}

	// packetNumberLength is the bytes needed so the peer can recover pn,
	// given the largest packet number it acknowledged (RFC 9000 §17.1):
	// twice the distance must fit.
	def packetNumberLength(pn int, largestAcked int) int {
		let distance = largestAcked < 0 ?? (pn + 1, pn - largestAcked)
		return 1 when distance < 0x80
		return 2 when distance < 0x8000
		return 3 when distance < 0x800000
		return 4
	}

	// decodePacketNumber recovers a full packet number from its low bits,
	// given the largest one received so far (RFC 9000 §A.3).
	def decodePacketNumber(largest int, truncated int, bits int) int {
		let expected = largest + 1
		let window = 1 << bits
		let half = window >> 1
		let mask = window - 1
		let candidate = (expected - (expected & mask)) | truncated
		return candidate + window when candidate <= expected - half && candidate < maxVarint - window
		return candidate - window when candidate > expected + half && candidate >= window
		return candidate
	}

	// AckRange is a run of acknowledged packet numbers, both ends included.
	struct AckRange {
		smallest int
		largest  int
	}

	// Frame is one frame of any type; a type reads the fields it has.
	struct Frame {
		kind          int        = 0
		// STREAM, RESET_STREAM, STOP_SENDING, MAX_STREAM_DATA,
		// STREAM_DATA_BLOCKED.
		streamID      int        = 0
		// STREAM and CRYPTO: where the data starts. RESET_STREAM: the
		// final size.
		offset        int        = 0
		// STREAM, CRYPTO, DATAGRAM, NEW_TOKEN, PATH_CHALLENGE and
		// PATH_RESPONSE: the bytes carried.
		data          byte[]     = []
		fin           bool       = false
		// ACK: ranges from the largest down, the delay as sent, the ECN
		// counts when the frame carries them.
		ranges        AckRange[] = []
		ackDelay      int        = 0
		ecn           bool       = false
		ect0          int        = 0
		ect1          int        = 0
		ecnCE         int        = 0
		// A limit, an error code, or a sequence number, by frame type.
		value         int        = 0
		// CONNECTION_CLOSE: the frame type that caused it, the reason.
		frameType     int        = 0
		reason        string     = ""
		// NEW_CONNECTION_ID.
		retirePriorTo int        = 0
		connectionID  byte[]     = []
		resetToken    byte[]     = []
	}

	// parseFrames reads every frame of a packet payload. Fails with
	// TransportError: FrameEncoding for a frame that does not parse or an
	// unknown type, ProtocolViolation for an empty payload.
	def parseFrames(payload byte[]) !Frame[] {
		fail transportError(TransportCode.ProtocolViolation, "a packet carries no frame") when payload.len() == 0
		let out Frame[] = []
		let c = new Cursor(payload)
		for c.left() > 0 {
			let kind = c.varint()
			if kind == framePadding {
				// Runs of padding are skipped byte by byte.
				for c.pos < c.end && c.data[c.pos] == 0x00 {
					c.pos++
				}
				continue
			}
			let f = Frame{kind: kind}
			if kind >= frameStream && kind <= 0x0f {
				f.kind = frameStream
				f.streamID = c.varint()
				f.offset = c.varint() when (kind & 0x04) != 0
				f.data = (kind & 0x02) != 0 ?? (c.bytes(c.varint()), c.bytes(c.left()))
				f.fin = (kind & 0x01) != 0
			} else if kind := frameAck || frameAckECN {
				f.kind = frameAck
				let largest = c.varint()
				f.ackDelay = c.varint()
				let count = c.varint()
				let first = c.varint()
				fail transportError(TransportCode.FrameEncoding, "an ACK range passes packet number 0", kind) when first > largest
				let smallest = largest - first
				f.ranges.push(AckRange{smallest: smallest, largest: largest})
				for let i = 0; i < count; i++ {
					let gap = c.varint()
					let length = c.varint()
					break when c.short
					let top = smallest - gap - 2
					fail transportError(TransportCode.FrameEncoding, "an ACK range passes packet number 0", kind) when top < 0 || length > top
					smallest = top - length
					f.ranges.push(AckRange{smallest: smallest, largest: top})
				}
				if kind == frameAckECN {
					f.ecn = true
					f.ect0 = c.varint()
					f.ect1 = c.varint()
					f.ecnCE = c.varint()
				}
			} else if kind == frameCrypto {
				f.offset = c.varint()
				f.data = c.bytes(c.varint())
			} else if kind == frameResetStream {
				f.streamID = c.varint()
				f.value = c.varint()
				f.offset = c.varint()
			} else if kind == frameStopSending {
				f.streamID = c.varint()
				f.value = c.varint()
			} else if kind == frameNewToken {
				f.data = c.bytes(c.varint())
				fail transportError(TransportCode.FrameEncoding, "NEW_TOKEN carries an empty token", kind) when f.data.len() == 0 && !c.short
			} else if kind := frameMaxData || frameMaxStreamsBidi || frameMaxStreamsUni || frameDataBlocked || frameStreamsBlockedBidi || frameStreamsBlockedUni || frameRetireConnectionID {
				f.value = c.varint()
			} else if kind := frameMaxStreamData || frameStreamDataBlocked {
				f.streamID = c.varint()
				f.value = c.varint()
			} else if kind == frameNewConnectionID {
				f.value = c.varint()
				f.retirePriorTo = c.varint()
				let size = c.byte()
				fail transportError(TransportCode.FrameEncoding, "NEW_CONNECTION_ID carries a connection ID of {size} bytes", kind) when (size < 1 || size > 20) && !c.short
				f.connectionID = c.bytes(size)
				f.resetToken = c.bytes(16)
				fail transportError(TransportCode.FrameEncoding, "NEW_CONNECTION_ID retires past its own sequence number", kind) when f.retirePriorTo > f.value
			} else if kind := framePathChallenge || framePathResponse {
				f.data = c.bytes(8)
			} else if kind := frameConnectionClose || frameApplicationClose {
				f.value = c.varint()
				f.frameType = c.varint() when kind == frameConnectionClose
				f.reason = string(c.bytes(c.varint()).clone())
			} else if kind == frameDatagram {
				f.data = c.bytes(c.left())
			} else if kind == frameDatagramLength {
				f.kind = frameDatagram
				f.data = c.bytes(c.varint())
			} else if kind != framePing && kind != frameHandshakeDone {
				fail transportError(TransportCode.FrameEncoding, "unknown frame type {kind}", kind)
			}
			fail transportError(TransportCode.FrameEncoding, "frame {kind} runs past the end of its packet", kind) when c.short
			out.push(f)
		}
		return out
	}

	// putAck appends an ACK frame for ranges given from the largest down,
	// with the delay already scaled by the ack delay exponent.
	def putAck(out byte[], ranges AckRange[], delay int) {
		putVarint(out, frameAck)
		putVarint(out, ranges[0].largest)
		putVarint(out, delay)
		putVarint(out, ranges.len() - 1)
		putVarint(out, ranges[0].largest - ranges[0].smallest)
		for let i = 1; i < ranges.len(); i++ {
			putVarint(out, ranges[i - 1].smallest - ranges[i].largest - 2)
			putVarint(out, ranges[i].largest - ranges[i].smallest)
		}
	}

	// putCrypto appends a CRYPTO frame.
	def putCrypto(out byte[], offset int, data byte[]) {
		putVarint(out, frameCrypto)
		putVarint(out, offset)
		putVarint(out, data.len())
		out.push(...data)
	}

	// putStream appends a STREAM frame with an explicit length.
	def putStream(out byte[], streamID int, offset int, data byte[], fin bool) {
		putVarint(out, frameStream | 0x02 | (offset > 0 ?? (0x04, 0x00)) | (fin ?? (0x01, 0x00)))
		putVarint(out, streamID)
		putVarint(out, offset) when offset > 0
		putVarint(out, data.len())
		out.push(...data)
	}

	// streamOverhead is the bytes a STREAM frame takes besides its data.
	def streamOverhead(streamID int, offset int, length int) int {
		return 1 + varintSize(streamID) + (offset > 0 ?? (varintSize(offset), 0)) + varintSize(length)
	}

	// putValue appends a frame that is a type and one integer.
	def putValue(out byte[], kind int, value int) {
		putVarint(out, kind)
		putVarint(out, value)
	}

	// putStreamValue appends a frame that is a type, a stream and one
	// integer.
	def putStreamValue(out byte[], kind int, streamID int, value int) {
		putVarint(out, kind)
		putVarint(out, streamID)
		putVarint(out, value)
	}

	// putResetStream appends RESET_STREAM.
	def putResetStream(out byte[], streamID int, code int, finalSize int) {
		putVarint(out, frameResetStream)
		putVarint(out, streamID)
		putVarint(out, code)
		putVarint(out, finalSize)
	}

	// putNewConnectionID appends NEW_CONNECTION_ID.
	def putNewConnectionID(out byte[], sequence int, retirePriorTo int, id byte[], resetToken byte[]) {
		putVarint(out, frameNewConnectionID)
		putVarint(out, sequence)
		putVarint(out, retirePriorTo)
		out.push(byte(id.len()))
		out.push(...id)
		out.push(...resetToken)
	}

	// putClose appends CONNECTION_CLOSE: the transport form with the
	// frame type that caused it, or the application form.
	def putClose(out byte[], app bool, code int, frameType int, reason string) {
		putVarint(out, app ?? (frameApplicationClose, frameConnectionClose))
		putVarint(out, code)
		putVarint(out, frameType) unless app
		let text = reason.bytes()
		putVarint(out, text.len())
		out.push(...text)
	}

	// transportError builds a TransportError this endpoint raises.
	def transportError(kind TransportCode, message string, frameType int = 0) TransportError {
		return TransportError{message: "quic: {message}", kind: kind, wireCode: kind.value, frameType: frameType}
	}

	// transportCodeOf maps a code from the wire to its TransportCode;
	// codes 0x100 to 0x1ff are Crypto, unknown ones InternalError.
	def transportCodeOf(wireCode int) TransportCode {
		return TransportCode.Crypto when wireCode >= 0x100 && wireCode <= 0x1ff
		for let code in [TransportCode.NoError, TransportCode.InternalError, TransportCode.ConnectionRefused, TransportCode.FlowControl, TransportCode.StreamLimit, TransportCode.StreamState, TransportCode.FinalSize, TransportCode.FrameEncoding, TransportCode.TransportParameter, TransportCode.ConnectionIDLimit, TransportCode.ProtocolViolation, TransportCode.InvalidToken, TransportCode.Application, TransportCode.CryptoBufferExceeded, TransportCode.KeyUpdate, TransportCode.AEADLimitReached, TransportCode.NoViablePath] {
			return code when code.value == wireCode
		}
		return TransportCode.InternalError
	}
}
