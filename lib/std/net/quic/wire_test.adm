internal partial module std.net.quic.wire {
	use (
		std.crypto.hash::(Hash, digest)
		std.data.encoding::(hexencode, hexdecode)
		std.net.quic::*
		std.net.tls
		std.testing
	)

	// frameError is the TransportCode of a payload that does not parse,
	// "" when it does.
	def frameError(payload byte[]) string {
		let seen = ""
		parseFrames(payload) onerror (err error) {
			seen = err is TransportError ?? ("{err.kind}", err.message)
			recover Frame[]
		}
		return seen
	}

	// Reference values come from aioquic 1.3 and RFC 9000 / RFC 9001.
	check "QUIC wire" {
		@test()
		def variableLengthIntegers() !none {
			// RFC 9000 §A.1.
			let samples = [(151288809941952652, "c2197c5eff14e88c"), (494878333, "9d7f3e7d"), (15293, "7bbd"), (37, "25"), (0, "00"), (63, "3f"), (64, "4040"), (16383, "7fff"), (16384, "80004000"), (1073741823, "bfffffff"), (1073741824, "c000000040000000"), (maxVarint, "ffffffffffffffff")]
			for let sample in samples {
				let (value, text) = sample
				let out byte[] = []
				putVarint(out, value)
				assert hexencode(out) == text
				assert varintSize(value) == out.len()
				let c = new Cursor(out)
				assert c.varint() == value && c.left() == 0 && !c.short
			}
			// A longer encoding of a small value reads the same.
			assert (new Cursor(try hexdecode("4025"))).varint() == 37
			let cut = new Cursor(try hexdecode("c2197c"))
			assert cut.varint() == 0 && cut.short
			return none
		}

		@test()
		def packetNumbers() {
			// RFC 9000 §A.2 and §A.3.
			assert packetNumberLength(0xac5c02, 0xabe8b3) == 2
			assert packetNumberLength(0xace8fe, 0xabe8b3) == 3
			assert packetNumberLength(0, -1) == 1
			assert decodePacketNumber(0xa82f30ea, 0x9b32, 16) == 0xa82f9b32
			assert decodePacketNumber(-1, 0, 8) == 0
			assert decodePacketNumber(255, 0, 8) == 256
			assert decodePacketNumber(300, 0xff, 8) == 255
		}

		@test()
		def initialKeysOfRFC9001() !none {
			let (client, server) = try initialKeys(try hexdecode("8394c8f03e515708"))
			assert hexencode(client.secret) == "c00cf151ca5be075ed0ebfb5c80323c42d6b7db67881289af4008f1f6c357aea"
			assert hexencode(client.iv) == "fa044b2f42a3fd3b46fb255c"
			assert hexencode(client.hpKey) == "9f50449e04a0e810283a1e9933adedd2"
			assert hexencode(server.secret) == "3c199828fd139efd216c155ad844cc81fb82fa8d7446fa7d78be803acdda951b"
			assert hexencode(server.iv) == "0ac1493ca1905853b0bba03e"
			assert hexencode(server.hpKey) == "c206b8d9b9f0f37644430b490eeaa314"
			return none
		}

		@test()
		def protectsInitialPackets() !none {
			let dcid = try hexdecode("8394c8f03e515708")
			let (client, server) = try initialKeys(dcid)
			let payload byte[] = []
			payload.len(1162)
			for let i = 0; i < 1024; i++ {
				payload[i] = byte(i & 0xFF)
			}
			let packet byte[] = []
			let at = longHeader(packet, packetInitial, version1, dcid, [], [], 4)
			setLength(packet, at, 4 + payload.len() + 16)
			putPacketNumber(packet, 2, 4)
			assert hexencode(packet) == "c300000001088394c8f03e5157080000449e00000002"
			try seal(client, packet, 0, 4, 2, payload)
			assert packet.len() == 1200
			assert hexencode(packet[:40]) == "c600000001088394c8f03e5157080000449e7852cbc8d7b08b7fd26d9952e71b33b1477823bdf112"
			assert hexencode(digest(Hash.SHA256, packet)) == "8b55aa9ecc4b73cef25e01b8867c1fb7311cc8a992221e7045034e4e776c2a84"

			let h = parseHeader(packet, 0, 0)
			assert h.ok && h.kind == packetInitial && h.version == 1 && hexencode(h.dcid) == "8394c8f03e515708" && h.scid.len() == 0
			assert h.pnOffset == 18 && h.end == 1200
			let opened = try unprotect(client, packet, 0, h, -1)
			assert opened.ok && opened.pn == 2 && opened.first == 0xc3
			assert (try open(client, opened)).equals(payload)

			// A packet aioquic sealed as the server.
			let fromServer = try hexdecode("cb000000010008f067a5502a4262b500406e30f62b2d5ea6fc68f27335c22c052e77cca3d89424a102bacd651f9c1aaedb3836c3ba7de44f7b98e0418c7b5a4cadf4c2938b31a0c56625a538c612e3db9a56c594e1de37a736e8b93914409deaa022af8823d1296fee4b64712034649002376ae0e7bebbef8b4d89b541561b13")
			let sh = parseHeader(fromServer, 0, 0)
			assert sh.ok && hexencode(sh.scid) == "f067a5502a4262b5" && sh.dcid.len() == 0
			let reply = try unprotect(server, fromServer, 0, sh, -1)
			assert reply.pn == 1
			assert string(try open(server, reply)) == "server hello bytes hereserver hello bytes hereserver hello bytes hereserver hello bytes here"
			// A flipped bit fails the tag.
			fromServer[fromServer.len() - 1] = fromServer[fromServer.len() - 1] ^ 0x01
			let broken = try unprotect(server, fromServer, 0, sh, -1)
			let failed = false
			open(server, broken) onerror (err error) {
				failed = true
				recover byte[]
			}
			assert failed
			return none
		}

		@test()
		def protectsShortHeaderPackets() !none {
			// RFC 9001 §A.5: ChaCha20-Poly1305.
			let keys = try deriveKeys(tls.CipherSuite.ChaCha20Poly1305SHA256, try hexdecode("9ac312a7f877468ebe69422748ad00a15443f18203a07d6060f688f30f21632b"))
			assert hexencode(keys.iv) == "e0459b3474bdd0e44a41c144"
			assert hexencode(keys.hpKey) == "25a282b9e82f06f21f488917a4fc8f1b73573685608597d0efcb076b0ab7a7a4"
			let packet byte[] = []
			shortHeader(packet, [], 0, false, 3)
			putPacketNumber(packet, 654360564, 3)
			try seal(keys, packet, 0, 3, 654360564, [0x01])
			assert hexencode(packet) == "4cfe4189655e5cd55c41f69080575d7999c25a5bfb"
			let h = parseHeader(packet, 0, 0)
			let opened = try unprotect(keys, packet, 0, h, 654360563)
			assert opened.pn == 654360564
			assert (try open(keys, opened)).equals([0x01])
			let updated = try nextKeys(keys)
			assert hexencode(updated.secret) == "1223504755036d556342ee9361d253421a826c9ecdf3c7148684b36b714881f9"
			assert updated.hpKey.equals(keys.hpKey)

			// AES-256-GCM with a connection ID.
			let secret byte[] = []
			for let i = 0; i < 48; i++ {
				secret.push(byte(i))
			}
			let strong = try deriveKeys(tls.CipherSuite.AES256GCMSHA384, secret)
			let second byte[] = []
			shortHeader(second, try hexdecode("a1a2a3a4a5a6a7a8"), 0, false, 2)
			putPacketNumber(second, 0x1234, 2)
			try seal(strong, second, 0, 2, 0x1234, "hello quic, aes-256".bytes())
			assert hexencode(second) == "57a1a2a3a4a5a6a7a87a4ef0ef291bd143c24171e36eec244fb4438bd7d57de3bf94c80b04bb7d3d92eb07a96a41"
			let sh = parseHeader(second, 0, 8)
			assert hexencode(sh.dcid) == "a1a2a3a4a5a6a7a8"
			assert string(try open(strong, try unprotect(strong, second, 0, sh, 0x1230))) == "hello quic, aes-256"
			return none
		}

		@test()
		def retryPackets() !none {
			let retry = try hexdecode("f0000000010008f067a5502a4262b5746f6b656e3e1f4242960d20f9b13d9f4e00027741")
			let h = parseHeader(retry, 0, 0)
			assert h.ok && h.kind == packetRetry && string(h.token) == "token" && hexencode(h.scid) == "f067a5502a4262b5"
			let tag = try retryTag(try hexdecode("8394c8f03e515708"), retry[:retry.len() - 16])
			assert tag.equals(retry[retry.len() - 16:])
			return none
		}

		@test()
		def versionNegotiationAndBadHeaders() !none {
			let vn = try hexdecode("8000000000" + "04a1a2a3a4" + "02b1b2" + "00000001" + "6b3343cf")
			let h = parseHeader(vn, 0, 0)
			assert h.ok && h.kind == packetVersionNegotiation && h.versions.len() == 2 && h.versions[1] == 0x6b3343cf
			assert !parseHeader(try hexdecode("c30000000108"), 0, 0).ok
			// The fixed bit must be set.
			assert !parseHeader(try hexdecode("00a1a2a3a4"), 0, 4).ok
			// A length that runs past the datagram.
			assert !parseHeader(try hexdecode("c3000000010000004400"), 0, 0).ok
			return none
		}

		@test()
		def framesRoundTrip() !none {
			let out byte[] = []
			putAck(out, [AckRange{smallest:90, largest:100}, AckRange{smallest:50, largest:80}, AckRange{smallest:3, largest:3}], 25)
			putCrypto(out, 1200, "crypto".bytes())
			putStream(out, 4, 0, "first".bytes(), false)
			putStream(out, 4, 5, "last".bytes(), true)
			putValue(out, frameMaxData, 1 << 20)
			putStreamValue(out, frameMaxStreamData, 8, 65536)
			putValue(out, frameMaxStreamsBidi, 100)
			putResetStream(out, 12, 0x10c, 77)
			putStreamValue(out, frameStopSending, 12, 0x10c)
			putNewConnectionID(out, 3, 1, try hexdecode("0102030405060708"), try hexdecode("000102030405060708090a0b0c0d0e0f"))
			putValue(out, frameRetireConnectionID, 2)
			putVarint(out, framePathChallenge)
			out.push(...(try hexdecode("1122334455667788")))
			putVarint(out, framePing)
			out.push(0, 0, 0)
			putVarint(out, frameHandshakeDone)
			putClose(out, false, 0x0a, frameStream, "bad stream")
			putClose(out, true, 0x100, 0, "bye")
			let frames = try parseFrames(out)
			assert frames.len() == 16
			let ack = frames[0]
			assert ack.kind == frameAck && ack.ackDelay == 25 && ack.ranges.len() == 3
			assert ack.ranges[1].largest == 80 && ack.ranges[1].smallest == 50 && ack.ranges[2].smallest == 3
			assert frames[1].kind == frameCrypto && frames[1].offset == 1200 && string(frames[1].data) == "crypto"
			assert frames[2].kind == frameStream && frames[2].streamID == 4 && frames[2].offset == 0 && !frames[2].fin
			assert frames[3].offset == 5 && frames[3].fin && string(frames[3].data) == "last"
			assert frames[4].value == 1 << 20
			assert frames[5].streamID == 8 && frames[5].value == 65536
			assert frames[7].kind == frameResetStream && frames[7].value == 0x10c && frames[7].offset == 77
			assert frames[9].kind == frameNewConnectionID && frames[9].value == 3 && frames[9].retirePriorTo == 1 && frames[9].connectionID.len() == 8 && frames[9].resetToken.len() == 16
			assert frames[11].kind == framePathChallenge && hexencode(frames[11].data) == "1122334455667788"
			assert frames[12].kind == framePing && frames[13].kind == frameHandshakeDone
			assert frames[14].kind == frameConnectionClose && frames[14].value == 0x0a && frames[14].frameType == frameStream && frames[14].reason == "bad stream"
			assert frames[15].kind == frameApplicationClose && frames[15].value == 0x100 && frames[15].reason == "bye"

			// A STREAM frame without a length runs to the end of the packet.
			let open = try parseFrames(try hexdecode("0c0407" + "616263"))
			assert open[0].streamID == 4 && open[0].offset == 7 && string(open[0].data) == "abc"
			// An ACK with ECN counts.
			let ecn = try parseFrames(try hexdecode("030a0000" + "05" + "010203"))
			assert ecn[0].ecn && ecn[0].ranges[0].smallest == 5 && ecn[0].ect0 == 1 && ecn[0].ecnCE == 3
			return none
		}

		@test()
		def rejectsMalformedFrames() !none {
			assert frameError([]) == "ProtocolViolation"
			assert frameError(try hexdecode("21")) == "FrameEncoding"
			assert frameError(try hexdecode("0600" + "05" + "6162")) == "FrameEncoding"
			assert frameError(try hexdecode("0205000006")) == "FrameEncoding"
			assert frameError(try hexdecode("18030400")) == "FrameEncoding"
			assert frameError(try hexdecode("0700")) == "FrameEncoding"
			assert frameError(try hexdecode("0001")) == ""
			assert transportCodeOf(0x0a) == TransportCode.ProtocolViolation
			assert transportCodeOf(0x12e) == TransportCode.Crypto
			return none
		}
	}
}
