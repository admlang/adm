// Forward error correction: one repair packet carries the XOR of a run
// of packets of a stream, so any one of them that is lost is put back
// without asking the sender. FlexFEC (RFC 8627) sends the repair packets
// as a stream of its own; ULPFEC (RFC 5109) sends them inside the
// protected stream, wrapped as redundant data (RFC 2198). Both are built
// and undone by the same code: a ULPFEC block is read as the FlexFEC
// repair packet that says the same.
partial module std.net.rtp {
	use (
		std.net.rtp.wire::*
		std.simd
	)

	// The repair packet's header behind the RTP header: the fixed part,
	// one source, a 15-bit mask.
	internal const fecHeaderSize = 20
	// A ULPFEC block's FEC header and level 0 header with a 16-bit mask.
	internal const ulpHeaderSize = 14
	// Packets a receiver remembers to repair from, and repair packets it
	// keeps for packets still on their way; powers of two.
	internal const fecMemory = 64
	internal const fecPending = 8

	// xorInto folds `count` bytes of `src` from `from` into `dst` at `at`,
	// 32 bytes a step.
	internal def xorInto(dst byte[], at int, src byte[], from int, count int) {
		let i = 0
		for i + 32 <= count {
			simd.storeBytes32(dst, at + i, simd.xor(simd.loadBytes32(dst, at + i), simd.loadBytes32(src, from + i)))
			i += 32
		}
		for i < count {
			dst[at + i] = dst[at + i] ^ src[from + i]
			i++
		}
	}

	// FecSender makes the repair packets of one stream: one for every
	// `group` packets in a row (2 to 15), under the repair stream's
	// payload type and source, with its own sequence numbers.
	type FecSender {
		payloadType      int
		ssrc             int
		sequence         int
		group            int    = 5
		// The ID of a two-byte header extension element the repair
		// packets carry (a transport-wide number), 0 for none. The caller
		// writes the element's value at `extensionOffset` of each packet.
		extension        int    = 0
		internal base    int    = -1
		internal count   int    = 0
		internal head    int    = 0
		internal lengths int    = 0
		internal stamps  int    = 0
		internal longest int    = 0
		internal source  int    = 0
		internal stamp   int    = 0
		internal body    byte[] = []

		def new(payloadType int, ssrc int, sequence int, group int = 5) {
			self.payloadType = payloadType
			self.ssrc = ssrc
			self.sequence = sequence
			self.group = group.max(2).min(15)
			body.len(1500)
		}

		// fold takes a packet into the group being built and reports
		// whether it completed it.
		internal def fold(packet byte[], length int) !bool {
			fail rtpError("a packet of {length} bytes cannot be protected") when length < 12 || length > 1500 || packet.len() < length
			let number = get16(packet, 2)
			count = 0 when count > 0 && number != ((base + count) & 0xFFFF)
			if count == 0 {
				base = number
				head = 0
				lengths = 0
				stamps = 0
				longest = 0
				source = get32(packet, 8)
				body.fill(0, 0, 1500)
			}
			head = head ^ get16(packet, 0)
			lengths = lengths ^ (length - 12)
			stamps = stamps ^ get32(packet, 4)
			stamp = get32(packet, 4)
			xorInto(body, 0, packet, 12, length - 12)
			longest = longest.max(length - 12)
			count++
			return count >= group
		}

		// protectUlp is `protect` for ULPFEC: when the packet completes
		// the group, the FEC header, the level 0 header and the level 0
		// payload (RFC 5109 §7.3, §7.4) are written into `out` and their
		// length returned, else 0. What is written goes into an RTP
		// packet of the protected stream behind a redundancy header
		// (`redBlock`). Fails as `protect` does.
		def protectUlp(packet byte[], length int, out byte[]) !int {
			return 0 unless try fold(packet, length)
			return try writeUlp(out)
		}

		// flushUlp ends the group being built early (a frame ended): the
		// block for the two or more packets it holds is written into `out`
		// and its length returned; a group of one or none is let go, 0.
		// Fails with RtpError for an `out` without room.
		def flushUlp(out byte[]) !int {
			if count < 2 {
				count = 0
				return 0
			}
			return try writeUlp(out)
		}

		internal def writeUlp(out byte[]) !int {
			let size = ulpHeaderSize + longest
			fail rtpError("a buffer of {out.len()} bytes has no room for a repair block of {size}") when out.len() < size
			// E and L clear: no extension, a 16-bit mask.
			out[0] = byte((head >> 8) & 0x3F)
			out[1] = byte(head & 0xFF)
			put16(out, 2, base)
			put32(out, 4, stamps)
			put16(out, 8, lengths & 0xFFFF)
			put16(out, 10, longest)
			// The first `count` packets from the base.
			put16(out, 12, ((1 << count) - 1) << (16 - count))
			body[0:longest].copy(out[ulpHeaderSize:])
			count = 0
			return size
		}

		// protect folds the RTP packet in the first `length` bytes of
		// `packet` into the group being built. When it completes the group
		// the repair packet (RFC 8627 §4.2) is written into `out` and its
		// length returned, else 0. A packet whose sequence number does not
		// follow the one before starts a new group. Fails with RtpError
		// for a packet shorter than an RTP header or longer than 1500
		// bytes, or an `out` without room.
		def protect(packet byte[], length int, out byte[]) !int {
			return 0 unless try fold(packet, length)
			let at = extension > 0 ?? (20, 12)
			let size = at + fecHeaderSize + longest
			fail rtpError("a buffer of {out.len()} bytes has no room for a repair packet of {size}") when out.len() < size
			out[0] = extension > 0 ?? (0x90, 0x80)
			out[1] = byte(payloadType & 0x7F)
			put16(out, 2, sequence & 0xFFFF)
			put32(out, 4, stamp)
			put32(out, 8, ssrc)
			if extension > 0 {
				// One element of two bytes in the one-byte form, padded.
				put16(out, 12, oneByteExtensions)
				put16(out, 14, 1)
				out[16] = byte((extension << 4) | 1)
				out[17] = 0
				out[18] = 0
				out[19] = 0
			}
			// R and F clear: a repair packet with a flexible mask.
			put16(out, at, head & 0x3FFF)
			put16(out, at + 2, lengths & 0xFFFF)
			put32(out, at + 4, stamps)
			put32(out, at + 8, 1 << 24)
			put32(out, at + 12, source)
			put16(out, at + 16, base)
			// One mask word (k set): the first `count` packets from the base.
			put16(out, at + 18, 0x8000 | (((1 << count) - 1) << (15 - count)))
			body[0:longest].copy(out[at + fecHeaderSize:])
			sequence = (sequence + 1) & 0xFFFF
			count = 0
			return size
		}
	}

	// ulpAsFlex writes the FlexFEC repair packet that says what the ULPFEC
	// block between `from` and `to` of `block` says of the stream `source`
	// into `out`, and returns its length; 0 for a block that ends inside
	// its headers, has an extension (E) or protects no packet. Only the
	// first protection level is read: later levels protect less of the
	// same packets.
	def ulpAsFlex(block byte[], from int, to int, source int, out byte[]) int {
		return 0 when to - from < ulpHeaderSize || (int(block[from]) & 0x80) != 0
		let long = (int(block[from]) & 0x40) != 0
		let at = from + (long ?? (ulpHeaderSize + 4, ulpHeaderSize))
		return 0 when to < at
		let covered = get16(block, from + 10).min(to - at)
		// The mask: 16 packets from the base, 48 with L.
		let offsets int[]
		let first = get16(block, from + 12)
		for let bit = 0; bit < 16; bit++ {
			offsets.push(bit) when (first & (0x8000 >> bit)) != 0
		}
		if long {
			let rest = get32(block, from + 14)
			for let bit = 0; bit < 32; bit++ {
				offsets.push(16 + bit) when (rest & (0x80000000 >> bit)) != 0
			}
		}
		return 0 when offsets.len() == 0
		let last = offsets[offsets.len() - 1]
		let words = last < 15 ?? (2, last < 46 ?? (6, 14))
		let size = 12 + 18 + words + covered
		return 0 when out.len() < size
		out.fill(0, 0, 12 + 18 + words)
		out[0] = 0x80
		// P, X, CC, M and the payload type recovery, R and F clear.
		out[12] = block[from] & 0x3F
		out[13] = block[from + 1]
		// Length and timestamp recovery, one source, the base.
		put16(out, 14, get16(block, from + 8))
		put32(out, 16, get32(block, from + 4))
		out[20] = 1
		put32(out, 24, source)
		put16(out, 28, get16(block, from + 2))
		// FlexFEC's mask words: 15 bits, then 31, then 63, each behind a
		// bit set on the last.
		let one = 0
		let two = 0
		let three = 0
		for let offset in offsets {
			if offset < 15 {
				one = one | (0x4000 >> offset)
			} else if offset < 46 {
				two = two | (0x40000000 >> (offset - 15))
			} else {
				three = three | (0x40000000 >> (offset - 46))
			}
		}
		put16(out, 30, one | (words == 2 ?? (0x8000, 0)))
		if words > 2 {
			put32(out, 32, two | (words == 6 ?? (0x80000000, 0)))
		}
		if words > 6 {
			put32(out, 36, three | 0x80000000)
			put32(out, 40, 0)
		}
		block[at:at + covered].copy(out[30 + words:])
		return size
	}

	// redBlock reads the redundancy headers (RFC 2198 §3) at `at` of a
	// packet that ends at `to`: the payload type of the primary block and
	// where its data starts, (-1, 0) for a packet that ends inside them.
	// Redundant blocks in front of the primary one are passed over.
	def redBlock(packet byte[], at int, to int) (int, int) {
		let head = at
		let before = 0
		for head < to && (int(packet[head]) & 0x80) != 0 {
			return (-1, 0) when head + 4 > to
			before += get16(packet, head + 2) & 0x03FF
			head += 4
		}
		return (-1, 0) when head >= to || head + 1 + before > to
		return (int(packet[head]) & 0x7F, head + 1 + before)
	}

	// redundantCount is how many redundant blocks the redundancy headers
	// at `at` of a packet that ends at `to` announce in front of the
	// primary one; 0 for a packet that ends inside its headers or
	// before the blocks they announce.
	def redundantCount(packet byte[], at int, to int) int {
		// `redBlock` has walked the headers and added the lengths up
		// within `to`: the walk below and the blocks stay inside.
		let (kind, _) = redBlock(packet, at, to)
		return 0 when kind < 0
		let count = 0
		for (int(packet[at + 4 * count]) & 0x80) != 0 {
			count++
		}
		return count
	}

	// redundant is the redundant block `index` (0 the oldest) of a packet
	// `redundantCount` counted blocks in: its payload type, where its
	// data starts, its length and how far its timestamp lies before the
	// packet's; (-1, 0, 0, 0) for a block the packet does not have.
	// Whether the packet it was had its marker set is not carried.
	def redundant(packet byte[], at int, to int, index int) (int, int, int, int) {
		let count = redundantCount(packet, at, to)
		return (-1, 0, 0, 0) when index < 0 || index >= count
		let from = at + 4 * count + 1
		for let i = 0; i < index; i++ {
			from += get16(packet, at + 4 * i + 2) & 0x03FF
		}
		let head = at + 4 * index
		let behind = (int(packet[head + 1]) << 6) | (int(packet[head + 2]) >> 2)
		return (int(packet[head]) & 0x7F, from, get16(packet, head + 2) & 0x03FF, behind)
	}

	// The longest redundant block and the furthest one may lie behind
	// its packet: their fields have 10 and 14 bits.
	const redundantMaxSize = 1023
	const redundantMaxAge = 16383

	// writeRedundant writes the header of a redundant block (RFC 2198
	// §3) at `at`: its payload type, how far its timestamp lies before
	// the packet's and its length. Returns where the next header goes.
	def writeRedundant(out byte[], at int, payloadType int, behind int, length int) int {
		out[at] = byte(0x80 | (payloadType & 0x7F))
		out[at + 1] = byte((behind >> 6) & 0xFF)
		out[at + 2] = byte(((behind & 0x3F) << 2) | ((length >> 8) & 0x03))
		out[at + 3] = byte(length & 0xFF)
		return at + 4
	}

	// extensionOffset is where the value of the header extension element
	// lies in a repair packet of a `FecSender` with an `extension`.
	const extensionOffset = 17

	// FecReceiver puts lost packets of one stream back from its repair
	// packets. It remembers the last packets received (a copy of each) and
	// the repair packets that could not be used yet.
	type FecReceiver {
		internal packets  byte[][] = []
		internal numbers  int[]    = []
		internal sources  int[]    = []
		internal repairs  byte[][] = []
		internal waiting  bool[]   = []
		internal nextSlot int      = 0
		// Packets put back so far.
		recovered         int      = 0

		def new() {
			for let i = 0; i < fecMemory; i++ {
				let slot byte[]
				packets.push(slot)
				numbers.push(-1)
				sources.push(0)
			}
			for let i = 0; i < fecPending; i++ {
				let slot byte[]
				repairs.push(slot)
				waiting.push(false)
			}
		}

		// keep remembers a packet of the stream that arrived (or was put
		// back). When it is the last one a waiting repair packet needed,
		// the packet that repair puts back is written into `out` and its
		// length returned, else 0.
		def keep(packet byte[], out byte[]) int {
			return 0 when packet.len() < 12
			let number = get16(packet, 2)
			let place = number & (fecMemory - 1)
			let slot = packets[place]
			slot.cap(1500) when slot.cap() < packet.len()
			slot.len(packet.len())
			packet.copy(slot)
			packets[place] = slot
			numbers[place] = number
			sources[place] = get32(packet, 8)
			for let i = 0; i < fecPending; i++ {
				continue unless waiting[i]
				let size = rebuild(repairs[i], out)
				continue when size <= 0
				waiting[i] = false
				recovered++
				return size
			}
			return 0
		}

		// repair takes a repair packet. When exactly one of the packets it
		// protects is missing, that packet is written into `out` as it was
		// sent and its length returned; 0 when none is missing; when more
		// are, the repair packet is kept for `keep` and 0 returned. Fails
		// with RtpError for a repair packet that ends inside its header, a
		// retransmission (R) or the fixed-block form (F), which FlexFEC
		// streams of WebRTC do not use, or more than one protected source.
		def repair(packet byte[], out byte[]) !int {
			let header = try headerLength(packet, packet.len())
			fail rtpError("a repair packet of {packet.len()} bytes ends inside its header") when packet.len() < header + fecHeaderSize
			fail rtpError("the repair packet is a retransmission or has a fixed block") unless (int(packet[header]) & 0xC0) == 0
			fail rtpError("the repair packet protects {int(packet[header + 8])} sources") unless int(packet[header + 8]) == 1
			let size = rebuild(packet, out)
			if size > 0 {
				recovered++
				return size
			}
			return 0 unless size < 0
			let slot = repairs[nextSlot]
			slot.cap(1600) when slot.cap() < packet.len()
			slot.len(packet.len())
			packet.copy(slot)
			repairs[nextSlot] = slot
			waiting[nextSlot] = true
			nextSlot = (nextSlot + 1) & (fecPending - 1)
			return 0
		}

		// rebuild puts back the one packet a repair packet lacks: its
		// length, 0 when nothing is missing or the repair is malformed, -1
		// when more than one is missing.
		internal def rebuild(packet byte[], out byte[]) int {
			let header = headerLength(packet, packet.len()) onerror recover 0
			return 0 when header == 0 || packet.len() < header + fecHeaderSize
			let source = get32(packet, header + 12)
			let base = get16(packet, header + 16)
			// The mask words: 15 bits, then 31, then 63, each behind a
			// bit that says whether it is the last.
			let at = header + 18
			let offsets int[]
			let first = get16(packet, at)
			for let bit = 0; bit < 15; bit++ {
				offsets.push(bit) when (first & (0x4000 >> bit)) != 0
			}
			at += 2
			if (first & 0x8000) == 0 {
				return 0 when packet.len() < at + 4
				let second = get32(packet, at)
				for let bit = 0; bit < 31; bit++ {
					offsets.push(15 + bit) when (second & (0x40000000 >> bit)) != 0
				}
				at += 4
				if (second & 0x80000000) == 0 {
					return 0 when packet.len() < at + 8
					let high = get32(packet, at)
					let low = get32(packet, at + 4)
					for let bit = 0; bit < 31; bit++ {
						offsets.push(46 + bit) when (high & (0x40000000 >> bit)) != 0
					}
					for let bit = 0; bit < 32; bit++ {
						offsets.push(77 + bit) when (low & (0x80000000 >> bit)) != 0
					}
					at += 8
				}
			}
			let missing = -1
			for let offset in offsets {
				let number = (base + offset) & 0xFFFF
				let place = number & (fecMemory - 1)
				continue when numbers[place] == number && sources[place] == source
				return -1 when missing >= 0
				missing = number
			}
			return 0 when missing < 0
			let room = packet.len() - at
			return 0 when out.len() < 12 + room
			let head = get16(packet, header) & 0x3FFF
			let length = get16(packet, header + 2)
			let stamp = get32(packet, header + 4)
			packet[at:].copy(out[12:])
			for let offset in offsets {
				let number = (base + offset) & 0xFFFF
				continue when number == missing
				let held = packets[number & (fecMemory - 1)]
				head = head ^ get16(held, 0)
				length = length ^ (held.len() - 12)
				stamp = stamp ^ get32(held, 4)
				xorInto(out, 12, held, 12, (held.len() - 12).min(room))
			}
			return 0 when length > room
			put16(out, 0, 0x8000 | (head & 0x3FFF))
			put16(out, 2, missing)
			put32(out, 4, stamp)
			put32(out, 8, source)
			return 12 + length
		}
	}
}
