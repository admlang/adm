// RTP payload formats: how the frames of a codec are cut into RTP payloads
// and put back together. Opus (RFC 7587), VP8 (RFC 7741), VP9 (RFC 9628),
// H.264 (RFC 6184, packetization mode 1) and AV1 (the AOM RTP
// specification). Frames stay encoded: nothing here decodes media.
partial module std.net.rtp {
	use std.net.rtp.wire::*

	// PayloadFormat names the payload formats this module packetizes.
	enum PayloadFormat {
		Opus,
		VP8,
		VP9,
		// Frames are Annex B byte streams: NAL units behind start codes.
		H264,
		// Frames are temporal units: OBUs with their size fields.
		AV1
	}

	// Packetizer cuts the encoded frames of one stream into RTP payloads no
	// longer than `maxPayload`. It numbers the pictures of VP8 and VP9.
	type Packetizer {
		format             PayloadFormat
		maxPayload         int           = 1200
		internal pictureID int           = 0
		// Frames of temporal layer 0 so far (VP8's TL0PICIDX).
		internal baseCount int           = 0

		def new(format PayloadFormat, maxPayload int = 1200) {
			self.format = format
			self.maxPayload = maxPayload
		}

		// packetize is the payloads of one frame, in order; the RTP packet
		// of the last one carries the marker for video. `keyframe` says
		// whether the frame can be decoded without the ones before it.
		// `layer` is the frame's temporal layer for an encoder that makes
		// layers (VP8: 0 for a frame later ones need, above it for one
		// that may be dropped), -1 for a stream without them.
		def packetize(frame byte[], keyframe bool = false, layer int = -1) byte[][] {
			let picture = pictureID
			pictureID = (pictureID + 1) & 0x7FFF
			switch {
				case format == PayloadFormat.VP8:
					baseCount = (baseCount + 1) & 0xFF when layer == 0
					return packetizeVP8(frame, picture, maxPayload, layer, baseCount)
				case format == PayloadFormat.VP9:
					return packetizeVP9(frame, picture, keyframe, maxPayload)
				case format == PayloadFormat.H264:
					return packetizeH264(frame, maxPayload)
				case format == PayloadFormat.AV1:
					return packetizeAV1(frame, keyframe, maxPayload)
			}
			return [frame]
		}
	}

	// depacketize puts the payloads of one frame, in order, back together:
	// the frame as the codec's decoder takes it (an Annex B byte stream for
	// H.264, a temporal unit with OBU size fields for AV1). Fails with
	// RtpError for a payload that is not of the format.
	def depacketize(format PayloadFormat, payloads byte[][]) !byte[] {
		switch {
			case format == PayloadFormat.VP8:
				return try depacketizeVP8(payloads)
			case format == PayloadFormat.VP9:
				return try depacketizeVP9(payloads)
			case format == PayloadFormat.H264:
				return try depacketizeH264(payloads)
			case format == PayloadFormat.AV1:
				return try depacketizeAV1(payloads)
		}
		let out byte[]
		for let payload in payloads {
			out = out + payload
		}
		return out
	}

	// temporalLayer is the temporal layer a payload's descriptor names, -1
	// when it names none (VP8 only: the other formats carry no layer
	// here).
	def temporalLayer(format PayloadFormat, payload byte[]) int {
		return format == PayloadFormat.VP8 ?? (vp8Layer(payload), -1)
	}

	// startsFrame reports whether a payload is the first of its frame; for
	// Opus every payload is a frame.
	def startsFrame(format PayloadFormat, payload byte[]) bool {
		return frameStart(format, payload, 0, payload.len())
	}

	// startsKeyframe reports whether a payload is the first of a frame that
	// can be decoded without the ones before it: a VP8 or VP9 key frame, an
	// H.264 packet carrying an IDR slice or a sequence parameter set, the
	// first packet of a new AV1 coded video sequence. Always true for Opus.
	def startsKeyframe(format PayloadFormat, payload byte[]) bool {
		return keyframeStart(format, payload, 0, payload.len())
	}
}
