partial module std.net.rtp {
	use (
		std.testing
		std.data.encoding::(hexdecode)
		std.net.rtp.wire::*
	)

	// numbered is `size` bytes counting up from `first`.
	internal def numbered(size int, first int) byte[] {
		let out byte[]
		out.len(size)
		for let i = 0; i < size; i++ {
			out[i] = byte((first + i) & 0xFF)
		}
		return out
	}

	// packetOf is a packet of a stream, read back from its bytes.
	internal def packetOf(sequence int, timestamp int, marker bool, payload byte[]) !Packet {
		let packet = new Packet()
		packet.payloadType = 96
		packet.sequence = sequence & 0xFFFF
		packet.timestamp = timestamp
		packet.marker = marker
		return try parsePacket(packet.encode(payload))
	}

	// pushFrame packetizes a frame and pushes its packets, but the ones
	// whose index within the frame is in `drop`; returns the next sequence
	// number.
	internal def pushFrame(buffer JitterBuffer, packetizer Packetizer, frame byte[], keyframe bool, sequence int, timestamp int, drop int[]) !int {
		let payloads = packetizer.packetize(frame, keyframe)
		for let (i, payload) in payloads {
			continue when drop.includes(i)
			buffer.push(try packetOf(sequence + i, timestamp, i == payloads.len() - 1, payload))
		}
		return sequence + payloads.len()
	}

	check "RTP payload formats" {
		// Frames of each format cut to small payloads come back the same,
		// and the first payload says whether a frame starts and is a key
		// frame.
		@test()
		def roundTrips() !none {
			// VP8: a key frame has bit 0 of its first byte clear.
			let vp8 = new Packetizer(PayloadFormat.VP8, 100)
			let key = numbered(950, 0x10)
			let pieces = vp8.packetize(key, true)
			assert pieces.len() == 10 && pieces[0].len() == 100 && pieces[0][0:4].hex() == "90808000"
			assert startsFrame(PayloadFormat.VP8, pieces[0]) && startsKeyframe(PayloadFormat.VP8, pieces[0]) && !startsFrame(PayloadFormat.VP8, pieces[1])
			assert (try depacketize(PayloadFormat.VP8, pieces)).equals(key)
			let delta = vp8.packetize(numbered(40, 0x11))
			assert delta.len() == 1 && delta[0][0:4].hex() == "90808001" && !startsKeyframe(PayloadFormat.VP8, delta[0])
			// Temporal layers: L and T behind the picture number, the count
			// of base frames, and N on a frame nothing needs.
			let layered = new Packetizer(PayloadFormat.VP8, 100)
			let base = layered.packetize(key, true, 0)
			assert base[0][0:6].hex() == "90E080000120" && temporalLayer(PayloadFormat.VP8, base[0]) == 0
			let upper = layered.packetize(byte[0x01, 0x02, 0x03], false, 1)
			assert upper[0][0:6].hex() == "B0E080010160" && temporalLayer(PayloadFormat.VP8, upper[0]) == 1
			assert (try depacketize(PayloadFormat.VP8, upper)).equals(byte[0x01, 0x02, 0x03])
			assert (layered.packetize(key, false, 0))[0][0:6].hex() == "90E080020220"
			assert temporalLayer(PayloadFormat.VP8, delta[0]) == -1 && temporalLayer(PayloadFormat.Opus, delta[0]) == -1

			let vp9 = new Packetizer(PayloadFormat.VP9, 100)
			let nine = vp9.packetize(numbered(250, 7), true)
			assert nine.len() == 3 && nine[0][0] == 0x88 && nine[1][0] == 0x80 && nine[2][0] == 0x84
			assert startsKeyframe(PayloadFormat.VP9, nine[0]) && !startsFrame(PayloadFormat.VP9, nine[1])
			assert (try depacketize(PayloadFormat.VP9, nine)).equals(numbered(250, 7))
			let inter = vp9.packetize(numbered(10, 1))
			assert inter[0][0] == 0xCC && startsFrame(PayloadFormat.VP9, inter[0]) && !startsKeyframe(PayloadFormat.VP9, inter[0])

			// H.264: an SPS, a PPS and an IDR slice long enough to be cut.
			let stream = byte[0, 0, 0, 1, 0x67, 1, 2, 3] + byte[0, 0, 1, 0x68, 4] + byte[0, 0, 0, 1, 0x65] + numbered(300, 9)
			let h264 = new Packetizer(PayloadFormat.H264, 120)
			let units = h264.packetize(stream, true)
			assert units.len() == 5 && units[0].hex() == "67010203" && units[1].hex() == "6804"
			assert units[2][0:2].hex() == "7C85" && units[3][0:2].hex() == "7C05" && units[4][0:2].hex() == "7C45"
			assert startsKeyframe(PayloadFormat.H264, units[0]) && startsKeyframe(PayloadFormat.H264, units[2]) && !startsFrame(PayloadFormat.H264, units[3])
			let annexB = try depacketize(PayloadFormat.H264, units)
			assert annexB.equals(byte[0, 0, 0, 1, 0x67, 1, 2, 3] + byte[0, 0, 0, 1, 0x68, 4] + byte[0, 0, 0, 1, 0x65] + numbered(300, 9))
			// An aggregation packet of two NAL units.
			let stap = try hexdecode("18" + "0002" + "6701" + "0003" + "680203")
			assert (try depacketize(PayloadFormat.H264, [stap])).hex() == "000000016701" + "00000001680203" && startsKeyframe(PayloadFormat.H264, stap)

			// AV1: a temporal delimiter (dropped), a sequence header and a
			// frame OBU with an extension byte, long enough to be cut.
			let unit = byte[0x12, 0x00] + byte[0x0A, 0x03, 1, 2, 3] + byte[0x36, 0x20, 0xC8, 0x01] + numbered(200, 3)
			let av1 = new Packetizer(PayloadFormat.AV1, 90)
			let elements = av1.packetize(unit, true)
			assert elements.len() == 4 && elements[0].hex() == "1808010203"
			assert elements[1][0] == 0x50 && elements[2][0] == 0xD0 && elements[3][0] == 0x90 && elements[1][1:3].hex() == "3420"
			assert startsKeyframe(PayloadFormat.AV1, elements[0]) && startsFrame(PayloadFormat.AV1, elements[1]) && !startsFrame(PayloadFormat.AV1, elements[2])
			assert (try depacketize(PayloadFormat.AV1, elements)).equals(byte[0x0A, 0x03, 1, 2, 3] + byte[0x36, 0x20, 0xC8, 0x01] + numbered(200, 3))
			// Two elements in one packet, the first with its length.
			let two = try hexdecode("28" + "03" + "0A0102" + "320506")
			assert (try depacketize(PayloadFormat.AV1, [two])).hex() == "0A020102" + "32020506"

			let opus = new Packetizer(PayloadFormat.Opus)
			let voice = opus.packetize(numbered(60, 0))
			assert voice.len() == 1 && voice[0].equals(numbered(60, 0)) && startsKeyframe(PayloadFormat.Opus, voice[0])
			return none
		}

		// What is not of the format is refused.
		@test()
		def malformedPayloads() {
			let refused = 0
			let cases = [(PayloadFormat.VP8, "90"), (PayloadFormat.VP9, "80"), (PayloadFormat.H264, ""), (PayloadFormat.H264, "7C"), (PayloadFormat.H264, "1800096701"), (PayloadFormat.H264, "3A00"), (PayloadFormat.AV1, ""), (PayloadFormat.AV1, "200A0102"), (PayloadFormat.AV1, "500A01")]
			for let item in cases {
				let (format, hex) = item
				let payload = hexdecode(hex) onerror recover []
				depacketize(format, [payload]) onerror (err error) {
					refused += err is RtpError ?? (1, 0)
					recover []
				}
			}
			assert refused == cases.len()
		}
	}

	check "RTP jitter buffer" {
		// Frames come out whole and in order whatever order their packets
		// arrive in, across the wrap of the sequence number.
		@test()
		def reordered() !none {
			let buffer = new JitterBuffer(PayloadFormat.VP8, 64)
			let packetizer = new Packetizer(PayloadFormat.VP8, 54)
			let first = packetizer.packetize(numbered(120, 2), true)
			let second = packetizer.packetize(numbered(70, 5))
			assert first.len() == 3 && second.len() == 2
			// Sequence numbers 65534, 65535, 0 for the first frame, 1 and 2
			// for the second; pushed out of order.
			buffer.push(try packetOf(65534, 9000, false, first[0]))
			assert (try buffer.pop()) is none
			buffer.push(try packetOf(2, 12000, true, second[1]))
			buffer.push(try packetOf(0, 9000, true, first[2]))
			assert (try buffer.pop()) is none && buffer.missing().equals([65535, 1])
			buffer.push(try packetOf(65535, 9000, false, first[1]))
			buffer.push(try packetOf(65535, 9000, false, first[1]))
			let one = try buffer.pop()
			fail "the first frame did not come out" when one is none
			assert one.data.equals(numbered(120, 2)) && one.keyframe && one.timestamp == 9000 && one.firstSequence == 65534 && one.lastSequence == 0
			assert (try buffer.pop()) is none && buffer.missing().equals([1])
			buffer.push(try packetOf(1, 12000, false, second[0]))
			let two = try buffer.pop()
			fail "the second frame did not come out" when two is none
			assert two.data.equals(numbered(70, 5)) && !two.keyframe && two.timestamp == 12000 && buffer.lost == 0
			assert (try buffer.pop()) is none && buffer.missing().len() == 0
			// A packet of a frame already handed out is late.
			buffer.push(try packetOf(0, 9000, true, first[2]))
			assert buffer.lost == 0 && buffer.late == 1
			return none
		}

		// A frame that never completes is skipped; audio packets are frames
		// each; a ring that overflows drops its oldest packets.
		@test()
		def lossAndOverflow() !none {
			let buffer = new JitterBuffer(PayloadFormat.H264, 32)
			let packetizer = new Packetizer(PayloadFormat.H264, 60)
			let idr = byte[0, 0, 0, 1, 0x65] + numbered(150, 1)
			let slice = byte[0, 0, 0, 1, 0x41] + numbered(20, 4)
			let next = try pushFrame(buffer, packetizer, idr, true, 100, 3000, [1])
			assert next == 103 && (try buffer.pop()) is none && buffer.missing().equals([101])
			next = try pushFrame(buffer, packetizer, slice, false, next, 6000, [])
			assert (try buffer.pop()) is none && buffer.skip()
			// The slice behind the frame given up needs it: it is dropped,
			// and the next frame that stands alone comes out.
			assert (try buffer.pop()) is none && buffer.lost == 4
			next = try pushFrame(buffer, packetizer, idr, true, next, 9000, [])
			let frame = try buffer.pop()
			fail "the key frame behind the lost one did not come out" when frame is none
			assert frame.data.equals(idr) && frame.keyframe && !buffer.skip()

			let audio = new JitterBuffer(PayloadFormat.Opus, 16)
			let voice = new Packetizer(PayloadFormat.Opus)
			for let i = 0; i < 40; i++ {
				try pushFrame(audio, voice, numbered(30, i), false, 500 + i, 960 * i, [])
			}
			// The ring holds 16: the 24 oldest were pushed out.
			let oldest = try audio.pop()
			fail "no audio frame" when oldest is none
			assert audio.lost == 24 && oldest.data.equals(numbered(30, 24)) && oldest.timestamp == 960 * 24
			return none
		}

		// Numbers missing between two frames whose picture numbers follow
		// each other held no frame (a repair packet that was lost): the
		// second frame comes out without them. A hole a frame fell into
		// holds the next one back, and once it is given up frames are
		// dropped up to a key frame. A sound packet that is missing is
		// passed over when two later ones came.
		@test()
		def holesBetweenFrames() !none {
			let vp8 = new Packetizer(PayloadFormat.VP8, 100)
			let wide = vp8.packetize(numbered(50, 1))[0]
			assert pictureNumber(PayloadFormat.VP8, wide, 0, wide.len()) == 0 && pictureTurn(PayloadFormat.VP8, wide, 0, wide.len()) == 0x8000
			let short = byte[0x90, 0x80, 0x05, 0x01]
			let ninth = byte[0x88, 0x85, 0x01, 0x00]
			let without = byte[0x65, 0x01, 0x02]
			assert pictureNumber(PayloadFormat.VP8, short, 0, 4) == 5 && pictureTurn(PayloadFormat.VP8, short, 0, 4) == 0x80
			assert pictureNumber(PayloadFormat.VP9, ninth, 0, 4) == 0x501 && pictureTurn(PayloadFormat.VP9, ninth, 0, 4) == 0x8000
			assert pictureNumber(PayloadFormat.H264, without, 0, 3) == -1 && pictureTurn(PayloadFormat.H264, without, 0, 3) == 0
			// VP9 with layer indices: the second spatial layer of a picture
			// starts a frame of its own under the picture's number.
			let upper = byte[0xA8, 0x85, 0x01, 0x02, 0x00]
			assert spatialLayer(PayloadFormat.VP9, upper, 0, 5) == 1 && spatialLayer(PayloadFormat.VP9, ninth, 0, 4) == 0 && pictureNumber(PayloadFormat.VP9, upper, 0, 5) == 0x501
			let layered = new JitterBuffer(PayloadFormat.VP9, 64)
			layered.push(try packetOf(1, 3000, true, byte[0x8C, 0x85, 0x00, 7, 7]))
			assert !((try layered.pop()) is none)
			// The base layer's packet (number 2) is missing: the layer above
			// it is no start to leap to.
			layered.push(try packetOf(3, 6000, true, byte[0xEC, 0x85, 0x01, 0x02, 7, 7]))
			assert (try layered.pop()) is none && layered.missing().equals([2])

			let buffer = new JitterBuffer(PayloadFormat.VP8, 64)
			let packetizer = new Packetizer(PayloadFormat.VP8, 100)
			let next = try pushFrame(buffer, packetizer, numbered(250, 0), true, 10, 3000, [])
			let key = try buffer.pop()
			fail "the key frame did not come out" when key is none
			// Number 13 never comes; picture 1 starts at 14.
			assert next == 13
			next = try pushFrame(buffer, packetizer, numbered(250, 1), false, next + 1, 6000, [])
			assert buffer.missing().equals([13])
			let second = try buffer.pop()
			fail "the frame behind the hole did not come out" when second is none
			assert second.data.equals(numbered(250, 1)) && second.firstSequence == 14 && buffer.missing().len() == 0 && buffer.lost == 0 && buffer.hollow == 1
			// Picture 2 is lost whole: picture 3 waits for it.
			packetizer.packetize(numbered(250, 3), false)
			next = try pushFrame(buffer, packetizer, numbered(250, 5), false, next + 3, 12000, [])
			assert (try buffer.pop()) is none && buffer.missing().len() == 3
			assert buffer.skip() && (try buffer.pop()) is none
			next = try pushFrame(buffer, packetizer, numbered(250, 7), false, next, 15000, [])
			assert (try buffer.pop()) is none
			next = try pushFrame(buffer, packetizer, numbered(250, 8), true, next, 18000, [])
			let fresh = try buffer.pop()
			fail "the key frame behind the frames dropped did not come out" when fresh is none
			assert fresh.keyframe && fresh.data.equals(numbered(250, 8))
			// push says whether the buffer kept the packet.
			assert !buffer.push(try packetOf(next - 1, 18000, true, wide))
			assert buffer.push(try packetOf(next, 21000, true, wide)) && !buffer.push(try packetOf(next, 21000, true, wide))

			let audio = new JitterBuffer(PayloadFormat.Opus, 16)
			audio.push(try packetOf(1, 0, false, numbered(30, 1)))
			assert !((try audio.pop()) is none)
			audio.push(try packetOf(3, 1920, false, numbered(30, 3)))
			assert (try audio.pop()) is none
			audio.push(try packetOf(4, 2880, false, numbered(30, 4)))
			let third = try audio.pop()
			fail "the sound behind the missing packet did not come out" when third is none
			assert third.data.equals(numbered(30, 3)) && audio.lost == 1
			// The packet passed over comes after all: late, not lost again.
			assert !audio.push(try packetOf(2, 960, false, numbered(30, 2))) && audio.lost == 1 && audio.late == 1
			return none
		}

		// 999 packets (333 frames of three) pushed and popped.
		@benchmark()
		def BenchJitterBuffer() {
			jitterLoop() onerror recover none
		}
	}

	internal def jitterLoop() !none {
		let buffer = new JitterBuffer(PayloadFormat.VP8)
		let packetizer = new Packetizer(PayloadFormat.VP8, 1200)
		let payloads = packetizer.packetize(numbered(3500, 0), true)
		let wire byte[][]
		let packet = new Packet()
		packet.payloadType = 96
		for let (i, payload) in payloads {
			packet.marker = i == payloads.len() - 1
			wire.push(packet.encode(payload))
		}
		let sequence = 0
		for let frame = 0; frame < 333; frame++ {
			for let bytes in wire {
				bytes[2] = byte((sequence >> 8) & 0xFF)
				bytes[3] = byte(sequence & 0xFF)
				put32(bytes, 4, frame * 3000)
				try packet.read(bytes)
				buffer.push(packet)
				sequence++
			}
			try buffer.pop()
		}
		return none
	}
}
