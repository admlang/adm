// The jitter buffer: RTP packets in whatever order they arrive, frames out
// in the order they were sent.
partial module std.net.rtp {
	use (
		std.net.sequence::(expand)
		std.net.rtp.wire::*
	)

	// Frame is one encoded frame out of a jitter buffer: its bytes as the
	// codec's decoder takes them, its RTP timestamp taken to full width (it
	// does not wrap), whether it needs no frame before it, and the
	// sequence numbers of its first and last packet.
	struct Frame {
		data          byte[]
		timestamp     int
		keyframe      bool
		firstSequence int
		lastSequence  int
	}

	// JitterSlot is one place of the ring: a packet's sequence number taken
	// to full width (-1 when the place is free), its timestamp and marker,
	// and its payload in a buffer the place keeps.
	internal type JitterSlot {
		sequence  int    = -1
		timestamp int    = 0
		marker    bool   = false
		// A packet that carries no part of a frame (`pass`).
		filler    bool   = false
		size      int    = 0
		data      byte[]

		def new() {}
	}

	// JitterBuffer holds the packets of one RTP stream in a ring indexed by
	// sequence number and hands out whole frames in order. `push` takes a
	// packet (its payload is copied into the ring, so the packet's buffer
	// is free again); `pop` gives the next frame once every packet of it
	// arrived. When the frame at the head stays incomplete, `missing` says
	// which packets to ask for again and `skip` gives up on it.
	type JitterBuffer {
		format            PayloadFormat
		// Packets given up on: pushed out of the ring, passed over, or
		// skipped with their frame.
		lost              int           = 0
		// Packets that came after their place was handed out or given up
		// (a second copy of one already out among them): not held, and
		// not counted lost a second time.
		late              int           = 0
		// Numbers that never came and held no frame: what was missing
		// between two frames whose picture numbers follow each other.
		hollow            int           = 0
		internal slots    JitterSlot[]
		internal mask     int
		// The sequence number, at full width, of the first packet of the
		// next frame to hand out, and of the newest packet seen; -1 before
		// the first packet.
		internal next     int           = -1
		internal newest   int           = -1
		internal lastTime int           = 0
		// The timestamp, at full width, of the frame handed out last; -1
		// before the first.
		internal handed   int           = -1
		// The picture number of the frame handed out last (-1 when it had
		// none or a frame was given up since), and whether frames are
		// dropped until one that needs none before it.
		internal picture  int           = -1
		internal needsKey bool          = false

		// A buffer for a stream of the format, with room for `capacity`
		// packets, which is rounded up to a power of two.
		def new(format PayloadFormat, capacity int = 512) {
			self.format = format
			let size = 16
			for size < capacity {
				size = size * 2
			}
			mask = size - 1
			for let i = 0; i < size; i++ {
				slots.push(new JitterSlot())
			}
		}

		// push takes a packet that was read and reports whether the buffer
		// kept it. A packet older than the frame at the head, or a second
		// copy of one held, is dropped; one too far ahead for the ring
		// pushes the oldest out.
		def push(packet Packet) bool {
			let low = packet.sequence
			// The first packet starts one round up, so an older one that
			// comes after it still has a number.
			let sequence = newest < 0 ?? (65536 + low, expand(newest + 1, low, 16))
			if next < 0 {
				next = sequence
				lastTime = packet.timestamp
			}
			if sequence < next {
				late++
				return false
			}
			if sequence - next > mask {
				// The ring is full: the oldest packets go.
				let from = sequence - mask
				for let i = next; i < from && i <= newest; i++ {
					let old = slots[i & mask]
					if old.sequence == i {
						old.sequence = -1
						lost++
					}
				}
				next = from
			}
			let slot = slots[sequence & mask]
			return false when slot.sequence == sequence
			let size = packet.payloadEnd - packet.payloadStart
			slot.data.len(size.max(1500)) when slot.data.len() < size
			packet.data[packet.payloadStart:packet.payloadEnd].copy(slot.data)
			slot.sequence = sequence
			slot.size = size
			slot.marker = packet.marker
			slot.filler = false
			lastTime = expand(lastTime, packet.timestamp, 32)
			slot.timestamp = lastTime
			newest = sequence when sequence > newest
			return true
		}

		// placeFor is the number to put a packet under of which only the
		// timestamp is known and that it was sent before the packet
		// numbered `before` (a block of redundant data, RFC 2198, names
		// no number): the highest free number below `before` with no
		// held packet of a later time under it, four numbers down at
		// most. -1 when a packet of that time is held or was handed out
		// (it came), or there is no such place. Two packets lost in a
		// row of which one is carried again leave it under the upper
		// number: its time, which is what it is played by, is its own.
		def placeFor(timestamp int, before int) int {
			return (before - 1) & 0xFFFF when newest < 0
			let time = expand(lastTime, timestamp, 32)
			return -1 when handed >= 0 && time <= handed
			let top = expand(newest + 1, before, 16)
			let place = -1
			for let n = top - 1; n >= top - 4 && n >= next; n-- {
				let slot = slots[n & mask]
				if slot.sequence != n {
					place = n when place < 0
					continue
				}
				continue when slot.filler
				return -1 when slot.timestamp == time
				// A packet of an earlier time: the place found is above it.
				break when slot.timestamp < time
				// One of a later time: the packet goes below it.
				place = -1
			}
			return place < 0 ?? (-1, place & 0xFFFF)
		}

		// pass takes a packet that was read and carries no part of a frame
		// (a repair packet in the stream's own numbering): its number is
		// not missing, and frames are put together around it.
		def pass(packet Packet) {
			let sequence = newest < 0 ?? (65536 + packet.sequence, expand(newest + 1, packet.sequence, 16))
			next = sequence when next < 0
			return when sequence < next || sequence - next > mask
			let slot = slots[sequence & mask]
			return when slot.sequence == sequence
			slot.sequence = sequence
			slot.size = 0
			slot.marker = false
			slot.filler = true
			slot.timestamp = lastTime
			newest = sequence when sequence > newest
		}

		// pop is the next frame, none while a packet of it is missing.
		// Numbers missing between two frames do not hold it back when the
		// frames' picture numbers follow each other (VP8, VP9): what was
		// lost there carried no frame (a repair packet, padding). A sound
		// packet that is missing is passed over once two later ones came.
		// After `skip`, frames are dropped up to one that needs none
		// before it. Fails with RtpError when its payloads are not of the
		// format; the frame is dropped then.
		def pop() !?Frame {
			for {
				// Fillers in front of the frame are done with.
				for next >= 0 && next <= newest && slots[next & mask].sequence == next && slots[next & mask].filler {
					slots[next & mask].sequence = -1
					next++
				}
				return none when next < 0 || next > newest
				let first = slots[next & mask]
				if first.sequence != next {
					return none unless leap()
					continue
				}
				if !frameStart(format, first.data, 0, first.size) {
					// The rest of a frame whose start was given up.
					first.sequence = -1
					lost++
					next++
					continue
				}
				// The frame ends with the marker, or where the timestamp
				// changes; for audio every packet is a frame.
				let last = next
				for format != PayloadFormat.Opus && !slots[last & mask].marker {
					let following = slots[(last + 1) & mask]
					return none unless following.sequence == last + 1
					break when !following.filler && following.timestamp != first.timestamp
					last++
				}
				let keyframe = keyframeStart(format, first.data, 0, first.size)
				let dropped = needsKey && !keyframe
				let number = pictureNumber(format, first.data, 0, first.size)
				let payloads byte[][]
				for let i = next; i <= last; i++ {
					let slot = slots[i & mask]
					payloads.push(slot.data[0:slot.size]) unless slot.filler || dropped
					slot.sequence = -1
				}
				let from = next
				next = last + 1
				if dropped {
					lost += last - from + 1
					continue
				}
				needsKey = false
				picture = number
				handed = first.timestamp
				return Frame{data: try depacketize(format, payloads), timestamp: first.timestamp, keyframe: keyframe, firstSequence: from & 0xFFFF, lastSequence: last & 0xFFFF}
			}
			return none
		}

		// leap moves the head past numbers that are missing when what was
		// lost there can be told to be no frame, and reports whether it
		// did: for video the next packet held starts the frame whose
		// picture number follows the last one handed out; for sound two
		// packets came behind the gap.
		internal def leap() bool {
			if format == PayloadFormat.Opus {
				return false when newest - next < 2
				for next <= newest && slots[next & mask].sequence != next {
					lost++
					next++
				}
				return true
			}
			return false when picture < 0
			for let i = next + 1; i <= newest; i++ {
				let slot = slots[i & mask]
				continue when slot.sequence != i || slot.filler
				// The first packet of the picture: with spatial layers every
				// layer's frame starts one and carries the same number.
				return false unless frameStart(format, slot.data, 0, slot.size) && spatialLayer(format, slot.data, 0, slot.size) == 0
				let turn = pictureTurn(format, slot.data, 0, slot.size)
				return false unless turn > 0 && pictureNumber(format, slot.data, 0, slot.size) == (picture + 1) % turn
				for let k = next; k < i; k++ {
					hollow++ unless slots[k & mask].sequence == k
					slots[k & mask].sequence = -1
				}
				next = i
				return true
			}
			return false
		}

		// missing is the sequence numbers that have not arrived among the
		// packets up to the newest one, oldest first, 64 at most: what a
		// NACK asks for.
		def missing() int[] {
			let out int[]
			for let i = next; next >= 0 && i < newest && out.len() < 64; i++ {
				out.push(i & 0xFFFF) unless slots[i & mask].sequence == i
			}
			return out
		}

		// skip gives up on the frame at the head and moves to the next
		// packet that starts a frame; false when the buffer holds none.
		// Video frames are dropped from here to one that needs none
		// before it: without the frame given up they do not decode.
		def skip() bool {
			return false when next < 0 || next > newest
			needsKey = format != PayloadFormat.Opus
			picture = -1
			for let i = next; i <= newest; i++ {
				let slot = slots[i & mask]
				let held = slot.sequence == i
				if held && i > next && !slot.filler && frameStart(format, slot.data, 0, slot.size) {
					next = i
					return true
				}
				slot.sequence = -1 when held
				lost++
			}
			next = newest + 1
			return false
		}
	}
}
