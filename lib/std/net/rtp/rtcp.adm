// RTCP (RFC 3550 §6): sender and receiver reports, source descriptions and
// BYE, with the feedback messages of RFC 4585 (NACK, PLI), RFC 5104 (FIR),
// REMB and transport-wide congestion control feedback.
partial module std.net.rtp {
	use std.net.rtp.wire::*

	// RtcpType names the RTCP packet types, the value being the one on the
	// wire.
	enum RtcpType {
		SenderReport = 200,
		ReceiverReport = 201,
		SourceDescription = 202,
		Bye = 203,
		Application = 204,
		// Transport layer feedback (RFC 4585 §6.2): NACK, transport-cc.
		TransportFeedback = 205,
		// Payload-specific feedback (RFC 4585 §6.3): PLI, FIR, REMB.
		PayloadFeedback = 206,
		ExtendedReport = 207,
	}

	// ReceptionReport is one report block (RFC 3550 §6.4.1): what a
	// receiver saw of one source. `fractionLost` is in 1/256, `lost` the
	// cumulative count (it can be negative with duplicates), `jitter` in
	// timestamp units, `lastSenderReport` the middle 32 bits of the NTP
	// time of the last SR and `delay` the time since it in 1/65536 s.
	struct ReceptionReport {
		ssrc             int
		fractionLost     int = 0
		lost             int = 0
		highestSequence  int = 0
		jitter           int = 0
		lastSenderReport int = 0
		delay            int = 0
	}

	// SenderReport is an SR: the sender's clock (NTP seconds since 1900 and
	// the fraction in 1/2^32) beside the RTP timestamp of the same moment,
	// what it sent so far, and its reception reports.
	struct SenderReport {
		ssrc        int
		ntpSeconds  int               = 0
		ntpFraction int               = 0
		rtpTime     int               = 0
		packetCount int               = 0
		octetCount  int               = 0
		reports     ReceptionReport[] = []
	}

	// ReceiverReport is an RR: reception reports of a participant that
	// sends no media.
	struct ReceiverReport {
		ssrc    int
		reports ReceptionReport[] = []
	}

	// SourceDescription is one chunk of an SDES: the canonical name of a
	// source (RFC 3550 §6.5.1); other items are not kept.
	struct SourceDescription {
		ssrc  int
		cname string = ""
	}

	// Bye says sources leave, with an optional reason.
	struct Bye {
		ssrcs  int[]
		reason string = ""
	}

	// Nack is a generic NACK (RFC 4585 §6.2.1): the sequence numbers a
	// receiver misses from a media source.
	struct Nack {
		sender int
		media  int
		lost   int[]
	}

	// Pli is a picture loss indication (RFC 4585 §6.3.1): the receiver
	// needs a keyframe.
	struct Pli {
		sender int
		media  int
	}

	// Fir is a full intra request (RFC 5104 §4.3.1) for one source, with
	// the command sequence number that tells a repeat from a new request.
	struct Fir {
		sender   int
		media    int
		sequence int = 0
	}

	// Remb is a receiver estimated maximum bitrate
	// (draft-alvestrand-rmcat-remb): bits per second for the sources
	// listed.
	struct Remb {
		sender  int
		bitrate int
		ssrcs   int[] = []
	}

	// TransportFeedback is transport-wide congestion control feedback
	// (draft-holmer-rmcat-transport-wide-cc-extensions-01): for the packets
	// from `baseSequence` on, in order, when each arrived. `referenceTime`
	// is in 64 ms; `deltas` holds, per packet, the time since the packet
	// before it (the reference time for the first) in 250 µs, or
	// `notReceived`.
	struct TransportFeedback {
		sender        int
		media         int
		baseSequence  int
		referenceTime int
		feedbackCount int   = 0
		deltas        int[] = []
	}

	// What `TransportFeedback.deltas` holds for a packet that did not
	// arrive.
	const notReceived = -1000000

	// UnknownRtcp is an RTCP packet this module has no reader for (APP, XR,
	// other feedback formats), kept whole: the type, the five bits beside
	// the version, and the bytes after the four-byte header.
	struct UnknownRtcp {
		packetType int
		count      int
		body       byte[]
	}

	// Compound is a compound RTCP packet (RFC 3550 §6.1) taken apart: the
	// packets of each kind in the order they came. `encode` writes the
	// reports first, as a compound packet must start, then the source
	// descriptions and the rest.
	type Compound {
		senderReports     SenderReport[]      = []
		receiverReports   ReceiverReport[]    = []
		descriptions      SourceDescription[] = []
		byes              Bye[]               = []
		nacks             Nack[]              = []
		plis              Pli[]               = []
		firs              Fir[]               = []
		rembs             Remb[]              = []
		transportFeedback TransportFeedback[] = []
		unknown           UnknownRtcp[]       = []

		def new() {}

		// encode is the compound packet on the wire.
		def encode() byte[] {
			return encodeCompound(self)
		}
	}

	// parseRtcp takes a compound RTCP packet apart in one pass. Fails with
	// RtpError for another version than 2, a packet that runs past the
	// datagram, or a report or feedback message shorter than its kind
	// needs.
	def parseRtcp(data byte[]) !Compound {
		return try decodeCompound(data)
	}
}
