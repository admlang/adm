// RTP and RTCP (RFC 3550) with the feedback messages of RFC 4585 and
// RFC 5104, header extensions (RFC 8285) and SRTP (RFC 3711, RFC 7714).
// The module carries encoded media: it knows packets, not codecs.
//
//     let packet = try rtp.parsePacket(datagram)
//     println("{packet.payloadType} #{packet.sequence} {packet.payload.len()} bytes")
//     let bytes = packet.encode()
partial module std.net.rtp {
	use (
		std.errors
		std.net.rtp.wire::*
	)

	// The one-byte and two-byte header extension profiles of RFC 8285.
	const oneByteExtensions = 0xBEDE
	// The two-byte form: the low four bits are free for the application.
	const twoByteExtensions = 0x1000

	// RtpError is the payload of a failure of this module.
	struct RtpError {
		message string
		code    string            = "rtp"
		cause   ?error
		stack   errors.StackTrace
	}

	// Packet is an RTP packet (RFC 3550 §5.1): the payload type and marker,
	// the 16-bit sequence number, the 32-bit timestamp, the synchronization
	// source and the contributing ones, the header extension and the
	// payload. A packet object is made once and used for many packets:
	// `read` points it at a received datagram without copying anything, and
	// `writeHeader` writes its header into a buffer of the caller's, so
	// neither allocates.
	type Packet {
		payloadType      int    = 0
		marker           bool   = false
		sequence         int    = 0
		timestamp        int    = 0
		ssrc             int    = 0
		csrcs            int[]  = []
		// The "defined by profile" word of the header extension, 0 when
		// the packet has none: `oneByteExtensions`, `twoByteExtensions`
		// (with any low four bits), or another profile's.
		extensionProfile int    = 0
		// Bytes of padding behind the payload, the octet that counts them
		// included; 0 for none.
		padding          int    = 0
		// A packet that was read: its bytes, and where the payload lies in
		// them.
		data             byte[] = []
		payloadStart     int    = 0
		payloadEnd       int    = 0
		// The body of the header extension (its elements, in the RFC 8285
		// forms): a stretch of `data` after `read`, of the packet's own
		// buffer after `writeExtension`.
		internal body    byte[] = []
		internal bodyAt  int    = 0
		internal bodyEnd int    = 0

		def new() {}

		// read points the packet at an RTP packet in `data`, which the
		// caller must not change while the packet is in use. Fails with
		// RtpError for another version than 2 or a packet shorter than its
		// header, extension or padding say.
		def read(data byte[]) !none {
			fail rtpError("a packet of {data.len()} bytes is shorter than an RTP header") when data.len() < 12
			let first = int(data[0])
			fail rtpError("RTP version {first >> 6}") unless first >> 6 == 2
			marker = (int(data[1]) & 0x80) != 0
			payloadType = int(data[1]) & 0x7F
			sequence = get16(data, 2)
			timestamp = get32(data, 4)
			ssrc = get32(data, 8)
			let at = 12
			let count = first & 0x0F
			fail rtpError("the packet ends inside its CSRC list") when data.len() < at + 4 * count
			csrcs.flush() when csrcs.len() > 0
			for let i = 0; i < count; i++ {
				csrcs.push(get32(data, at))
				at += 4
			}
			extensionProfile = 0
			bodyAt = 0
			bodyEnd = 0
			if (first & 0x10) != 0 {
				fail rtpError("the packet ends inside its header extension") when data.len() < at + 4
				let end = at + 4 + 4 * get16(data, at + 2)
				fail rtpError("the packet ends inside its header extension") when data.len() < end
				extensionProfile = get16(data, at)
				body = data
				bodyAt = at + 4
				bodyEnd = end
				at = end
			}
			let stop = data.len()
			padding = 0
			if (first & 0x20) != 0 {
				padding = int(data[stop - 1])
				fail rtpError("{padding} bytes of padding in a payload of {stop - at}") when padding == 0 || padding > stop - at
				stop -= padding
			}
			self.data = data
			payloadStart = at
			payloadEnd = stop
			return none
		}

		// payload is the payload of a packet that was read: a view into its
		// bytes.
		def payload() byte[] {
			return data[payloadStart:payloadEnd]
		}

		// extension is the data of the header extension element with the
		// ID (RFC 8285), a view; none when the packet has none or its
		// extension is of another profile.
		def extension(id int) ?byte[] {
			let (at, size) = locate(id)
			return none when at < 0
			return body[at:at + size]
		}

		// extensionOffset is where the data of the header extension
		// element with the ID lies: in the packet's bytes for one that was
		// read, in the header `writeHeader` writes for one being built. -1
		// when the packet has no such element. Nothing is allocated, so
		// this is how a field is read or changed per packet.
		def extensionOffset(id int) int {
			let (at, _) = locate(id)
			return -1 when at < 0
			// A packet being built keeps the body in a buffer of its own.
			return bodyAt == 0 ?? (16 + 4 * csrcs.len() + at, at)
		}

		// locate is the place in `body` and the length of the element
		// with the ID, (-1, 0) without one.
		internal def locate(id int) (int, int) {
			let small = isOneByte()
			return (-1, 0) unless small || isTwoByte()
			let at = bodyAt
			for at < bodyEnd {
				if body[at] == 0 {
					at++
					continue
				}
				let found = small ?? (int(body[at]) >> 4, int(body[at]))
				let size = 0
				if small {
					return (-1, 0) when found == 15
					size = (int(body[at]) & 0x0F) + 1
					at++
				} else {
					return (-1, 0) when at + 1 >= bodyEnd
					size = int(body[at + 1])
					at += 2
				}
				return (-1, 0) when at + size > bodyEnd
				return (at, size) when found == id
				at += size
			}
			return (-1, 0)
		}

		// writeExtension puts a header extension element into a packet
		// being built. An element of the same ID and length is overwritten
		// where it lies, which costs nothing. With no element of the ID, or
		// one of another length, the extension is laid out again with the
		// new value (an allocation): in the one-byte form while every
		// element fits it (IDs up to 14, 1 to 16 bytes), else in the
		// two-byte form.
		def writeExtension(id int, value byte[]) {
			let old = extension(id)
			if !(old is none) && old.len() == value.len() {
				value.copy(old)
				return
			}
			let ids int[]
			let values byte[][]
			let small = isOneByte()
			let at = bodyAt
			for (small || isTwoByte()) && at < bodyEnd {
				if body[at] == 0 {
					at++
					continue
				}
				let found = small ?? (int(body[at]) >> 4, int(body[at]))
				let size = small ?? ((int(body[at]) & 0x0F) + 1, int(body[(at + 1).min(bodyEnd - 1)]))
				at += small ?? (1, 2)
				break when at + size > bodyEnd || (small && found == 15)
				if found != id {
					ids.push(found)
					values.push(body[at:at + size].clone())
				}
				at += size
			}
			ids.push(id)
			values.push(value)
			let fits = true
			let size = 0
			for let (i, v) in values {
				fits = false when ids[i] > 14 || v.len() == 0 || v.len() > 16
			}
			for let v in values {
				size += (fits ?? (1, 2)) + v.len()
			}
			let laid byte[]
			laid.len((size + 3) / 4 * 4)
			let to = 0
			for let (i, v) in values {
				if fits {
					laid[to] = byte((ids[i] << 4) | (v.len() - 1))
					to++
				} else {
					laid[to] = byte(ids[i])
					laid[to + 1] = byte(v.len())
					to += 2
				}
				v.copy(laid[to:])
				to += v.len()
			}
			extensionProfile = fits ?? (oneByteExtensions, twoByteExtensions)
			body = laid
			bodyAt = 0
			bodyEnd = laid.len()
		}

		// headerSize is the length of the header as written: the fixed
		// part, the CSRCs and the header extension.
		def headerSize() int {
			return 12 + 4 * csrcs.len() + (extensionProfile == 0 ?? (0, 4 + bodyEnd - bodyAt))
		}

		// writeHeader writes the header at an offset of a buffer that has
		// `headerSize()` bytes of room there and returns its length; the
		// payload goes behind it. The padding bit is set when `padding` is
		// not 0; the padding itself is the caller's to write.
		def writeHeader(out byte[], at int = 0) int {
			let extended = extensionProfile != 0
			out[at] = byte(0x80 | (padding > 0 ?? (0x20, 0)) | (extended ?? (0x10, 0)) | (csrcs.len() & 0x0F))
			out[at + 1] = byte((marker ?? (0x80, 0)) | (payloadType & 0x7F))
			put16(out, at + 2, sequence)
			put32(out, at + 4, timestamp)
			put32(out, at + 8, ssrc)
			let to = at + 12
			for let csrc in csrcs {
				put32(out, to, csrc)
				to += 4
			}
			if extended {
				let size = bodyEnd - bodyAt
				put16(out, to, extensionProfile)
				put16(out, to + 2, size / 4)
				// Byte by byte: the body is a few bytes, and a slice of it
				// would be an allocation per packet.
				for let i = 0; i < size; i++ {
					out[to + 4 + i] = body[bodyAt + i]
				}
				to += 4 + size
			}
			return to - at
		}

		// encode is the packet on the wire with a payload: a new array.
		def encode(payload byte[]) byte[] {
			let header = headerSize()
			let out byte[]
			out.len(header + payload.len() + padding)
			writeHeader(out)
			payload.copy(out[header:])
			out[out.len() - 1] = byte(padding) when padding > 0
			return out
		}

		internal def isOneByte() bool {
			return extensionProfile == oneByteExtensions
		}

		internal def isTwoByte() bool {
			return (extensionProfile & 0xFFF0) == twoByteExtensions
		}
	}

	// parsePacket is a new packet pointed at an RTP packet in `data`. Fails
	// as `Packet.read` does.
	def parsePacket(data byte[]) !Packet {
		let packet = new Packet()
		try packet.read(data)
		return packet
	}

	// isRtcp reports whether a datagram on a port shared by RTP and RTCP
	// ("a=rtcp-mux") is RTCP: its packet type is 192 to 223 (RFC 5761 §4).
	def isRtcp(data byte[]) bool {
		return data.len() >= 2 && int(data[1]) >= 192 && int(data[1]) <= 223
	}
}
