partial module std.net.rtp {
	use (
		std.testing
		std.data.encoding::(hexdecode)
		std.net.rtp.wire::*
	)

	// A packet with the marker, one CSRC, a one-byte header extension with
	// two elements (and a byte of padding between), a payload of five bytes
	// and three bytes of padding.
	internal const samplePacket = "B1E012340000A00011223344AABBCCDDBEDE000210AA003211223300" + "0102030405" + "000003"

	// readFails reports whether bytes are refused as an RTP packet.
	internal def readFails(hex string) bool {
		let refused = false
		let data = hexdecode(hex) onerror recover []
		parsePacket(data) onerror (err error) {
			refused = err is RtpError
			recover new Packet()
		}
		return refused
	}

	// writtenTo is a buffer of a size, for building packets.
	internal def room(size int) byte[] {
		let out byte[]
		out.len(size)
		return out
	}

	check "RTP packets" {
		// Every field of a packet reads, and the packet writes back the
		// same bytes.
		@test()
		def readAndWrite() !none {
			let data = try hexdecode(samplePacket)
			let packet = try parsePacket(data)
			assert packet.marker && packet.payloadType == 96 && packet.sequence == 0x1234 && packet.timestamp == 0xA000 && packet.ssrc == 0x11223344
			assert packet.csrcs.equals([0xAABBCCDD]) && packet.extensionProfile == oneByteExtensions && packet.padding == 3
			assert packet.payload().hex() == "0102030405" && packet.headerSize() == 28
			let level = packet.extension(1)
			let mid = packet.extension(3)
			fail "an extension element is missing" when level is none || mid is none
			assert level.hex() == "AA" && mid.hex() == "112233" && packet.extension(2) is none

			let out = room(data.len())
			assert packet.writeHeader(out) == 28
			packet.payload().copy(out[28:])
			out[out.len() - 1] = 3
			assert out.hex() == data.hex()

			// The same packet object reads the next packet.
			let plain = try hexdecode("80000001000000020000000301")
			try packet.read(plain)
			assert !packet.marker && packet.payloadType == 0 && packet.sequence == 1 && packet.csrcs.len() == 0
			assert packet.extensionProfile == 0 && packet.extension(1) is none && packet.payload().hex() == "01" && packet.headerSize() == 12
			assert isRtcp(try hexdecode("80C80006")) && !isRtcp(plain)
			return none
		}

		// A packet is built: header fields, extension elements in the
		// one-byte form, moved to the two-byte form by an element that
		// needs it, and an element overwritten where it lies.
		@test()
		def build() !none {
			let packet = new Packet()
			packet.payloadType = 111
			packet.sequence = 65535
			packet.timestamp = 0xFFFFFFFF
			packet.ssrc = 0xDEADBEEF
			packet.writeExtension(1, byte[0x7F])
			packet.writeExtension(4, "0".bytes())
			assert packet.extensionProfile == oneByteExtensions && packet.headerSize() == 20
			let sent = packet.encode("opus".bytes())
			assert sent.hex() == "906FFFFFFFFFFFFFDEADBEEFBEDE0001107F40306F707573"
			let back = try parsePacket(sent)
			let level = back.extension(1)
			fail "no level" when level is none
			assert back.sequence == 65535 && back.timestamp == 0xFFFFFFFF && back.ssrc == 0xDEADBEEF && level.hex() == "7F" && string(back.payload()) == "opus"

			packet.writeExtension(1, byte[0x10])
			let again = packet.extension(1)
			fail "no level" when again is none
			assert again.hex() == "10" && packet.headerSize() == 20
			packet.writeExtension(20, "a long element value".bytes())
			assert (packet.extensionProfile & 0xFFF0) == twoByteExtensions
			let wide = try parsePacket(packet.encode([]))
			let long = wide.extension(20)
			let kept = wide.extension(4)
			fail "the two-byte form lost an element" when long is none || kept is none
			assert string(long) == "a long element value" && string(kept) == "0"
			return none
		}

		// What is no RTP packet is refused.
		@test()
		def refused() !none {
			let cases = ["8000", "40000001000000020000000301", "81000001000000020000000301", "90000001000000020000000301", "900000010000000200000003BEDE0002AA", "A0000001000000020000000301020A", "A0000001000000020000000300"]
			for let hex in cases {
				assert readFails(hex)
			}
			return none
		}

		// 1000 packets read by one packet object.
		@benchmark()
		def BenchReadPacket() {
			let data = hexdecode(samplePacket) onerror recover []
			let packet = new Packet()
			for let i = 0; i < 1000; i++ {
				packet.read(data) onerror recover none
			}
		}

		// 1000 headers written into one buffer.
		@benchmark()
		def BenchWriteHeader() {
			let packet = new Packet()
			packet.payloadType = 96
			packet.writeExtension(1, byte[0x7F])
			packet.writeExtension(3, byte[1, 2, 3])
			let out = room(1500)
			for let i = 0; i < 1000; i++ {
				packet.sequence = i
				packet.writeHeader(out, 16)
			}
		}
	}

	check "RTP retransmission" {
		// A packet with an extension becomes a retransmission packet with
		// the original sequence number in front of its payload (RFC 4588
		// §4) and comes back the same; one without a payload is a probe;
		// what ends inside its header is refused.
		@test()
		def retransmissionPackets() !none {
			let packet = new Packet()
			packet.payloadType = 96
			packet.marker = true
			packet.sequence = 0xABCD
			packet.timestamp = 123456
			packet.ssrc = 0x11223344
			packet.writeExtension(1, "0".bytes())
			let plain = packet.encode(byte[9, 8, 7, 6, 5])
			let out byte[]
			out.len(plain.len() + 2)
			let size = try retransmission(plain, plain.len(), out, 97, 0x55667788, 7)
			let header = try headerLength(plain, plain.len())
			assert size == plain.len() + 2 && header == 20 && out.hex() == "90E10007" + "0001E240" + "55667788" + plain[12:20].hex() + "ABCD" + "0908070605"
			let back = try original(out, 96, 0x11223344)
			out.len(back)
			assert back == plain.len() && out.equals(plain)

			let probe = byte[0x80, 97, 0, 9, 0, 0, 0, 1, 0x55, 0x66, 0x77, 0x88]
			assert (try original(probe, 96, 1)) == 0
			let refused = 0
			headerLength(byte[0x90, 96, 0, 1, 0, 0, 0, 1, 0, 0, 0, 2, 0xBE, 0xDE, 0, 3], 16) onerror (err error) {
				refused++ when err is RtpError
				recover 0
			}
			retransmission(plain, plain.len(), out[0:10], 97, 1, 1) onerror (err error) {
				refused++ when err is RtpError
				recover 0
			}
			assert refused == 2
			return none
		}
	}

	// fecGroup is five packets of one source in sequence, of different
	// lengths, one with an extension and a marker.
	internal def fecGroup() byte[][] {
		let out byte[][]
		for let i = 0; i < 5; i++ {
			let packet = new Packet()
			packet.payloadType = 96
			packet.sequence = 65533 + i
			packet.timestamp = 90000 + 3000 * i
			packet.ssrc = 0xCAFE
			packet.marker = i == 4
			packet.writeExtension(1, "0".bytes()) when i == 2
			let payload byte[]
			payload.len(40 + 300 * i)
			for let j = 0; j < payload.len(); j++ {
				payload[j] = byte((i * 17 + j * 3) & 0xFF)
			}
			out.push(packet.encode(payload))
		}
		return out
	}

	check "RTP forward error correction" {
		// A repair packet of five packets (RFC 8627) puts each of them
		// back when it alone is lost, across the sequence wrap, whatever
		// its length; a repair that comes before the last packet waits
		// for it; two lost packets stay lost; a retransmission form is
		// refused.
		@test()
		def repairsOneOfFive() !none {
			let group = fecGroup()
			let sender = new FecSender(120, 0xFEC, 7)
			let repair byte[]
			repair.len(1600)
			let size = 0
			for let packet in group {
				size = try sender.protect(packet, packet.len(), repair)
			}
			repair.len(size)
			assert size == 12 + 20 + group[4].len() - 12 && (int(repair[1]) & 0x7F) == 120 && get16(repair, 2) == 7 && get32(repair, 8) == 0xFEC && get16(repair, 28) == 65533 && get16(repair, 30) == 0xFC00
			let out byte[]
			for let lost = 0; lost < 5; lost++ {
				let receiver = new FecReceiver()
				out.len(1600)
				for let (i, packet) in group {
					assert receiver.keep(packet, out) == 0 unless i == lost
				}
				let got = try receiver.repair(repair, out)
				out.len(got)
				assert got == group[lost].len() && out.equals(group[lost]) && receiver.recovered == 1
			}

			let early = new FecReceiver()
			out.len(1600)
			assert early.keep(group[0], out) == 0 && early.keep(group[1], out) == 0 && (try early.repair(repair, out)) == 0
			assert early.keep(group[3], out) == 0
			let late = early.keep(group[4], out)
			out.len(late)
			assert late == group[2].len() && out.equals(group[2])

			let whole = new FecReceiver()
			out.len(1600)
			for let packet in group {
				whole.keep(packet, out)
			}
			assert (try whole.repair(repair, out)) == 0 && whole.recovered == 0
			let refused = false
			repair[12] = repair[12] | 0x80
			whole.repair(repair, out) onerror (err error) {
				refused = err is RtpError
				recover 0
			}
			assert refused
			return none
		}

		// ULPFEC (RFC 5109): the block a group of five makes has the FEC
		// and level 0 headers of the RFC, and read as the FlexFEC repair
		// packet that says the same it puts any one of the five back; a
		// 48-bit mask is read too; redundancy headers (RFC 2198) give the
		// primary block behind redundant ones.
		@test()
		def repairsOneOfFiveInBand() !none {
			let group = fecGroup()
			let sender = new FecSender(0, 0, 0)
			let block byte[]
			block.len(1600)
			let size = 0
			for let packet in group {
				size = try sender.protectUlp(packet, packet.len(), block)
			}
			let longest = group[4].len() - 12
			assert size == 14 + longest && (int(block[0]) & 0xC0) == 0 && get16(block, 2) == 65533 && get16(block, 10) == longest && get16(block, 12) == 0xF800
			let flex byte[]
			flex.len(1700)
			let out byte[]
			for let lost = 0; lost < 5; lost++ {
				let receiver = new FecReceiver()
				out.len(1600)
				for let (i, packet) in group {
					assert receiver.keep(packet, out) == 0 unless i == lost
				}
				flex.len(1700)
				let made = ulpAsFlex(block, 0, size, get32(group[0], 8), flex)
				assert made > 0
				flex.len(made)
				let got = try receiver.repair(flex, out)
				out.len(got)
				assert got == group[lost].len() && out.equals(group[lost])
			}
			// The same block with its mask written long: bits 0 to 4 of 48.
			let long byte[]
			long.len(size + 4)
			block[0:14].copy(long)
			long[0] = long[0] | 0x40
			block[14:size].copy(long[18:])
			let wide = new FecReceiver()
			out.len(1600)
			for let (i, packet) in group {
				wide.keep(packet, out) unless i == 2
			}
			flex.len(1700)
			let made = ulpAsFlex(long, 0, size + 4, get32(group[0], 8), flex)
			flex.len(made)
			let got = try wide.repair(flex, out)
			out.len(got)
			assert out.equals(group[2])
			flex.len(1700)
			assert ulpAsFlex(block, 0, 10, 1, flex) == 0
			block[0] = block[0] | 0x80
			assert ulpAsFlex(block, 0, size, 1, flex) == 0

			// One block; then a redundant block of 3 bytes in front.
			// Redundant blocks in front of the primary one: two headers
			// written and read back, each block where its length puts it.
			let doubled byte[]
			doubled.len(4 + 4 + 1 + 3 + 2 + 5)
			let next = writeRedundant(doubled, 0, 111, 1920, 3)
			next = writeRedundant(doubled, next, 111, 960, 2)
			doubled[next] = 111
			for let i = next + 1; i < doubled.len(); i++ {
				doubled[i] = byte(i)
			}
			let (main, mainAt) = redBlock(doubled, 0, doubled.len())
			let (oldKind, oldAt, oldSize, oldBehind) = redundant(doubled, 0, doubled.len(), 0)
			let (newKind, newAt, newSize, newBehind) = redundant(doubled, 0, doubled.len(), 1)
			assert next == 8 && main == 111 && mainAt == 14 && redundantCount(doubled, 0, doubled.len()) == 2
			assert oldKind == 111 && oldAt == 9 && oldSize == 3 && oldBehind == 1920 && newKind == 111 && newAt == 12 && newSize == 2 && newBehind == 960
			// The widest fields, and a packet that ends inside its headers.
			let widest byte[]
			widest.len(5)
			writeRedundant(widest, 0, 127, redundantMaxAge, redundantMaxSize)
			assert widest.equals(byte[0xFF, 0xFF, 0xFF, 0xFF, 0]) && redundantCount(widest, 0, 5) == 0 && redundantCount(byte[0x6F, 1], 0, 2) == 0
			// Every header announcing another, and a block the packet
			// does not have: no block is read.
			let endless byte[]
			endless.len(16)
			endless.fill(byte(0xFF))
			let (none0, _, _, _) = redundant(doubled, 0, doubled.len(), 2)
			let (none1, _, _, _) = redundant(endless, 0, 16, 0)
			assert redundantCount(endless, 0, 16) == 0 && none0 == -1 && none1 == -1
			let (single, at) = redBlock(byte[0x60, 1, 2], 0, 3)
			assert single == 0x60 && at == 1
			let (primary, behind) = redBlock(byte[0xE0, 0, 0, 3, 0x61, 9, 9, 9, 7, 7], 0, 10)
			assert primary == 0x61 && behind == 8
			let (bad, _) = redBlock(byte[0xE0, 0, 0], 0, 3)
			assert bad == -1
			return none
		}

		// Where a packet known by its time alone goes (a block of
		// redundant sound): under the number below the packet that
		// carried it when that is free; below a held packet of a later
		// time; nowhere when a packet of its time is held or was played.
		@test()
		def placeByTime() !none {
			let buffer = new JitterBuffer(PayloadFormat.Opus)
			let packet = new Packet()
			let feed = def (sequence int, timestamp int) !bool {
				let one = new Packet()
				one.sequence = sequence
				one.timestamp = timestamp
				try packet.read(one.encode(byte[byte(sequence)]))
				return buffer.push(packet)
			}
			// Before any packet: the number below.
			assert buffer.placeFor(960, 11) == 10
			assert try feed(10, 960)
			// 11 never came, 12 carries it.
			assert buffer.placeFor(1920, 12) == 11
			assert try feed(12, 2880)
			// 14 carries the packet two behind it (12, which is held)
			// while 13 never came: nowhere. With 13 held and 12 not, it
			// would go below 13.
			assert buffer.placeFor(2880, 14) == -1
			assert try feed(15, 5760)
			assert buffer.placeFor(3840, 16) == 14 && buffer.placeFor(3840, 15) == 14
			assert try feed(14, 4800)
			assert buffer.placeFor(3840, 15) == 13 && buffer.placeFor(4800, 15) == -1
			// What was played does not come back.
			let first = try buffer.pop()
			assert !(first is none) && first.timestamp == 960 && buffer.placeFor(960, 11) == -1 && buffer.placeFor(0, 10) == -1
			return none
		}

		// A packet that carries no part of a frame takes its number in
		// the jitter buffer: nothing is missing around it, and the
		// frames before, around and behind it come out whole.
		@test()
		def frameAroundAFiller() !none {
			let buffer = new JitterBuffer(PayloadFormat.VP8)
			let packet = new Packet()
			let feed = def (sequence int, timestamp int, marker bool, start bool, filler bool) !none {
				let one = new Packet()
				one.sequence = sequence
				one.timestamp = timestamp
				one.marker = marker
				try packet.read(one.encode(byte[start ?? (0x10, 0x00), byte(sequence)]))
				if filler {
					buffer.pass(packet)
				} else {
					buffer.push(packet)
				}
				return none
			}
			try feed(10, 100, false, true, false)
			try feed(11, 100, false, false, true)
			try feed(12, 100, true, false, false)
			try feed(13, 100, false, false, true)
			try feed(15, 200, true, false, false)
			assert buffer.missing().equals([14])
			let first = try buffer.pop()
			fail "no frame" when first is none
			assert first.data.equals(byte[10, 12]) && first.firstSequence == 10 && first.lastSequence == 12
			assert (try buffer.pop()) is none
			try feed(14, 200, false, true, false)
			let second = try buffer.pop()
			fail "no second frame" when second is none
			assert second.data.equals(byte[14, 15]) && buffer.missing().len() == 0
			return none
		}

		// The repair packet of a group of five 1200-byte packets, made
		// and used a thousand times.
		@benchmark()
		def BenchRepairPacket() {
			fecLoop() onerror recover none
		}
	}

	internal def fecLoop() !none {
		let sender = new FecSender(120, 1, 0)
		let packets byte[][]
		for let i = 0; i < 5; i++ {
			let packet = new Packet()
			packet.sequence = i
			let payload byte[]
			payload.len(1188)
			packets.push(packet.encode(payload))
		}
		let repair byte[]
		repair.len(1600)
		let out byte[]
		out.len(1600)
		for let round = 0; round < 1000; round++ {
			let receiver = new FecReceiver()
			let size = 0
			for let (i, packet) in packets {
				put16(packet, 2, round * 5 + i)
				size = try sender.protect(packet, packet.len(), repair)
				receiver.keep(packet, out) unless i == 2
			}
			repair.len(size)
			try receiver.repair(repair, out)
			repair.len(1600)
		}
		return none
	}

	check "RTCP" {
		// Packets with a known layout read as what they are.
		@test()
		def knownLayouts() !none {
			// A PLI from 1 about 2, then a NACK for 100, 101 and 105.
			let data = try hexdecode("81CE00020000000100000002" + "81CD00030000000100000002" + "00640011")
			let compound = try parseRtcp(data)
			let pli = compound.plis[0]
			let nack = compound.nacks[0]
			assert compound.plis.len() == 1 && pli.sender == 1 && pli.media == 2
			assert nack.lost.equals([100, 101, 105]) && compound.encode().hex() == "81CD0003000000010000000200640011" + "81CE00020000000100000002"

			// A receiver report with one block: 25% lost, 3 in all.
			let report = try parseRtcp(try hexdecode("81C90007" + "0000000A" + "0000000B40000003" + "00010005" + "00000007" + "AABBCCDD" + "00000010"))
			let rr = report.receiverReports[0]
			let block = rr.reports[0]
			assert rr.ssrc == 10 && block.ssrc == 11 && block.fractionLost == 64 && block.lost == 3 && block.highestSequence == 0x10005
			assert block.jitter == 7 && block.lastSenderReport == 0xAABBCCDD && block.delay == 16

			let refused = false
			parseRtcp(try hexdecode("81CE0003000000010000000200")) onerror (err error) {
				refused = err is RtpError
				recover new Compound()
			}
			assert refused
			return none
		}

		// A compound packet of every kind comes back the same.
		@test()
		def roundTrip() !none {
			let compound = new Compound()
			compound.senderReports.push(SenderReport{ssrc: 1, ntpSeconds: 0xE8D4A510, ntpFraction: 0x80000000, rtpTime: 90000, packetCount: 12, octetCount: 3400, reports: [ReceptionReport{ssrc: 2, fractionLost: 12, lost: -2, highestSequence: 70000, jitter: 9, lastSenderReport: 5, delay: 6}]})
			compound.receiverReports.push(ReceiverReport{ssrc: 3})
			compound.descriptions.push(SourceDescription{ssrc: 1, cname: "marta@adm"})
			compound.descriptions.push(SourceDescription{ssrc: 2, cname: "x"})
			compound.nacks.push(Nack{sender: 1, media: 2, lost: [65535, 0, 16, 40]})
			compound.plis.push(Pli{sender: 1, media: 2})
			compound.firs.push(Fir{sender: 1, media: 2, sequence: 7})
			compound.rembs.push(Remb{sender: 1, bitrate: 2500000, ssrcs: [2, 4]})
			compound.transportFeedback.push(TransportFeedback{sender: 1, media: 2, baseSequence: 65530, referenceTime: 0x123456, feedbackCount: 9, deltas: [4, 0, notReceived, notReceived, 300, -8, 255, 1]})
			compound.byes.push(Bye{ssrcs: [1, 2], reason: "done"})
			compound.unknown.push(UnknownRtcp{packetType: int(RtcpType.Application), count: 3, body: byte[0, 0, 0, 1, 0x41, 0x44, 0x4D, 0x21]})
			let wire = compound.encode()
			assert wire.len() % 4 == 0 && isRtcp(wire)
			let back = try parseRtcp(wire)
			assert back.encode().hex() == wire.hex()
			let sr = back.senderReports[0]
			let block = sr.reports[0]
			assert sr.ntpSeconds == 0xE8D4A510 && sr.ntpFraction == 0x80000000 && sr.octetCount == 3400 && block.lost == -2 && block.highestSequence == 70000
			let first = back.descriptions[0]
			let second = back.descriptions[1]
			assert first.cname == "marta@adm" && second.ssrc == 2 && second.cname == "x"
			let nack = back.nacks[0]
			let fir = back.firs[0]
			let remb = back.rembs[0]
			assert nack.lost.equals([65535, 0, 16, 40]) && fir.media == 2 && fir.sequence == 7
			// 2.5 Mbit/s needs more than 18 bits: the low bits are lost.
			assert remb.bitrate == 2500000 - 2500000 % 16 && remb.ssrcs.equals([2, 4])
			let feedback = back.transportFeedback[0]
			assert feedback.baseSequence == 65530 && feedback.referenceTime == 0x123456 && feedback.feedbackCount == 9
			assert feedback.deltas.equals([4, 0, notReceived, notReceived, 300, -8, 255, 1])
			let bye = back.byes[0]
			let app = back.unknown[0]
			assert bye.ssrcs.equals([1, 2]) && bye.reason == "done" && app.packetType == 204 && app.count == 3 && app.body.len() == 8
			return none
		}

		// Transport feedback in the chunk forms this module does not write
		// itself: a status vector of fourteen one-bit symbols, then one of
		// seven two-bit symbols.
		@test()
		def statusVectors() !none {
			// 21 packets from 10. One-bit vector: received, lost, received,
			// eleven lost. Two-bit vector: small, large, lost, small, three
			// lost. Deltas 1, 2, 3, -2, 4; two bytes of padding.
			let wire = try hexdecode("8FCD0007" + "00000001" + "00000002" + "000A0015" + "00000105" + "A800" + "D840" + "010203FFFE04" + "0000")
			let feedback = (try parseRtcp(wire)).transportFeedback[0]
			assert feedback.baseSequence == 10 && feedback.referenceTime == 1 && feedback.feedbackCount == 5
			let lost = notReceived
			assert feedback.deltas.equals([1, lost, 2, lost, lost, lost, lost, lost, lost, lost, lost, lost, lost, lost, 3, -2, lost, 4, lost, lost, lost])
			return none
		}
	}
}
