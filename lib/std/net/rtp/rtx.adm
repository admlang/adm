// Retransmission as a stream of its own (RFC 4588): a packet sent again
// travels under the retransmission payload type and source, with its own
// sequence numbers, the original sequence number in front of the payload.
partial module std.net.rtp {
	use std.net.rtp.wire::*

	// retransmission writes the retransmission packet (RFC 4588 §4) of the
	// RTP packet in the first `length` bytes of `packet` into `out` and
	// returns its length, `length + 2`: the same header under the
	// retransmission payload type and source with the sequence number
	// given, then the original sequence number, then the payload. Fails
	// with RtpError for a packet that ends inside its header or an `out`
	// without room.
	def retransmission(packet byte[], length int, out byte[], payloadType int, ssrc int, sequence int) !int {
		let header = try headerLength(packet, length)
		fail rtpError("a buffer of {out.len()} bytes has no room for a retransmission of {length + 2}") when out.len() < length + 2
		packet[0:header].copy(out)
		out[1] = byte((int(packet[1]) & 0x80) | (payloadType & 0x7F))
		put16(out, 2, sequence & 0xFFFF)
		put32(out, 8, ssrc)
		out[header] = packet[2]
		out[header + 1] = packet[3]
		packet[header:length].copy(out[header + 2:]) when length > header
		return length + 2
	}

	// original turns the retransmission packet `packet` back into the RTP
	// packet it carries, in place, under the payload type and source of
	// the stream it repairs, and returns its length (two bytes less); 0
	// for a retransmission packet without a payload, which only probes the
	// path. Fails with RtpError for a packet that ends inside its header.
	def original(packet byte[], payloadType int, ssrc int) !int {
		let length = packet.len()
		let header = try headerLength(packet, length)
		return 0 when length < header + 2 || (length == header + 2 + int(packet[length - 1]) && (int(packet[0]) & 0x20) != 0)
		packet[1] = byte((int(packet[1]) & 0x80) | (payloadType & 0x7F))
		packet[2] = packet[header]
		packet[3] = packet[header + 1]
		put32(packet, 8, ssrc)
		// Two bytes down, front first: the stretches overlap.
		for let i = header; i < length - 2; i++ {
			packet[i] = packet[i + 2]
		}
		return length - 2
	}
}
