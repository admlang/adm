partial module std.net.rtp {
	use (
		std.testing
		std.crypto.cipher::(newAES, newGCM)
		std.crypto.hash::(Hash, HMAC)
		std.data.encoding::(hexdecode)
		std.net.tls::(SRTPProfile, SRTPKeys)
		std.net.rtp.wire::*
	)

	// The RTP packet number `sequence` and the RTCP packet the libsrtp
	// vectors below protect: an RTP header with a one-byte extension and a
	// payload of 1 to 20, and a receiver report.
	internal def vectorPacket(sequence int) !byte[] {
		let head = try hexdecode("90E0")
		let rest = try hexdecode("CAFEBABE" + "BEDE0001" + "10AA0000" + "0102030405060708090A0B0C0D0E0F1011121314")
		let middle byte[]
		middle.len(6)
		put16(middle, 0, sequence)
		put32(middle, 2, 1000 + sequence)
		return head + middle + rest
	}

	internal const vectorRtcp = "81C90007" + "CAFEBABE" + "0000000B40000003" + "00010005" + "00000007" + "AABBCCDD" + "00000010"

	// padded is bytes in a buffer with room behind them.
	internal def padded(data byte[], extra int) byte[] {
		let out byte[]
		out.len(data.len() + extra)
		data.copy(out)
		return out
	}

	// refuses reports whether a session refuses to unprotect a packet.
	internal def refuses(session SrtpSession, packet byte[], rtcp bool) bool {
		let refused = false
		let buffer = packet.clone()
		if rtcp {
			session.unprotectRtcp(buffer, buffer.len()) onerror (err error) {
				refused = err is RtpError
				recover 0
			}
		} else {
			session.unprotect(buffer, buffer.len()) onerror (err error) {
				refused = err is RtpError
				recover 0
			}
		}
		return refused
	}

	// againstLibsrtp checks a profile against what libsrtp 2 (through
	// pylibsrtp 1.0) made of the vector packets under the key and salt: RTP
	// packets 65534, 65535, 0 and 1 (the rollover counter moves between
	// the second and the third) and the RTCP packet twice. This module
	// must write the same bytes and read them back.
	internal def againstLibsrtp(profile SRTPProfile, key string, salt string, rtpVectors string[], rtcpVectors string[]) !none {
		let keys = SRTPKeys{profile: profile, localKey: try hexdecode(key), localSalt: try hexdecode(salt), remoteKey: try hexdecode(key), remoteSalt: try hexdecode(salt)}
		let sender = try srtp(keys)
		let receiver = try srtp(keys)
		let sequences = [65534, 65535, 0, 1]
		for let (i, sequence) in sequences {
			let plain = try vectorPacket(sequence)
			let buffer = padded(plain, sender.overhead())
			let size = try sender.protect(buffer, plain.len())
			fail "{profile}: RTP packet {sequence} differs from libsrtp's" unless size == buffer.len() && buffer.hex() == rtpVectors[i]
			let received = try hexdecode(rtpVectors[i])
			let opened = try receiver.unprotect(received, received.len())
			fail "{profile}: RTP packet {sequence} does not open" unless opened == plain.len() && received[0:opened].hex() == plain.hex()
		}
		// libsrtp numbers its first SRTCP packet 1; RFC 3711 §3.4 and this
		// module start at 0. So the packets after this module's first are
		// the ones that must equal libsrtp's.
		let report = try hexdecode(vectorRtcp)
		let first = padded(report, sender.rtcpOverhead())
		let firstSize = try sender.protectRtcp(first, report.len())
		let own = try srtp(keys)
		fail "{profile}: this module's first RTCP packet does not open" unless (try own.unprotectRtcp(first, firstSize)) == report.len() && first[0:report.len()].hex() == report.hex()
		for let vector in rtcpVectors {
			let buffer = padded(report, sender.rtcpOverhead())
			let size = try sender.protectRtcp(buffer, report.len())
			fail "{profile}: an RTCP packet differs from libsrtp's" unless size == buffer.len() && buffer.hex() == vector
			let received = try hexdecode(vector)
			let opened = try receiver.unprotectRtcp(received, received.len())
			fail "{profile}: an RTCP packet does not open" unless opened == report.len() && received[0:opened].hex() == report.hex()
		}
		// A packet seen before, and one with a bit changed, are refused.
		let again = try hexdecode(rtpVectors[3])
		let changed = try hexdecode(rtpVectors[3])
		changed[20] = changed[20] ^ 1
		let fresh = try srtp(keys)
		let third = try hexdecode(rtpVectors[1])
		try fresh.unprotect(third, third.len())
		fail "{profile}: a replayed or changed packet was taken" unless refuses(receiver, again, false) && refuses(fresh, changed, false)
		let control = try hexdecode(rtcpVectors[1])
		let flipped = try hexdecode(rtcpVectors[0])
		flipped[9] = flipped[9] ^ 1
		fail "{profile}: a replayed or changed RTCP packet was taken" unless refuses(receiver, control, true) && refuses(fresh, flipped, true)
		return none
	}

	// protectLoop protects and opens 1000 RTP packets of 1200 bytes.
	internal def protectLoop(profile SRTPProfile) !none {
		let size = profile == SRTPProfile.AEADAES128GCM ?? (12, 14)
		let key byte[]
		key.len(16)
		let salt byte[]
		salt.len(size)
		let keys = SRTPKeys{profile: profile, localKey: key, localSalt: salt, remoteKey: key, remoteSalt: salt}
		let sender = try srtp(keys)
		let receiver = try srtp(keys)
		let packet = new Packet()
		packet.payloadType = 96
		packet.ssrc = 7
		let buffer byte[]
		buffer.len(1200 + sender.overhead())
		for let i = 0; i < 1000; i++ {
			packet.sequence = i & 0xFFFF
			packet.writeHeader(buffer)
			let sent = try sender.protect(buffer, 1200)
			try receiver.unprotect(buffer, sent)
		}
		return none
	}

	// floorCounterMode is what the counter mode profile cannot go below for
	// 1000 packets protected and opened: 2000 times the AES blocks of 1188
	// bytes and an HMAC-SHA1 over 1200.
	internal def floorCounterMode() !none {
		let key byte[]
		key.len(16)
		let block = try newAES(key)
		let mac = new HMAC(Hash.SHA1, key)
		let counter byte[]
		counter.len(16)
		let stream byte[]
		stream.len(16)
		let data byte[]
		data.len(1200)
		for let i = 0; i < 2000; i++ {
			for let at = 0; at < 1188; at += 16 {
				block.encryptBlock(stream, counter)
			}
			mac.reset()
			mac.hash(data)
		}
		return none
	}

	// floorGCM is 1000 times the AES-GCM seal and open of 1188 bytes.
	internal def floorGCM() !none {
		let key byte[]
		key.len(16)
		let aead = try newGCM(try newAES(key))
		let nonce byte[]
		nonce.len(12)
		let header byte[]
		header.len(12)
		let data byte[]
		data.len(1188)
		for let i = 0; i < 1000; i++ {
			let sealed = aead.seal(nonce, data, header)
			try aead.open(nonce, sealed, header)
		}
		return none
	}

	check "SRTP" {
		// The key derivation of RFC 3711 Appendix B.3.
		@test()
		def keyDerivation() !none {
			let master = try newAES(try hexdecode("E1F97A0D3E018BE0D64FA32C06DE4139"))
			let salt = try hexdecode("0EC675AD498AFEEBB6960B3AABE6")
			assert deriveKey(master, salt, 0, 16).hex() == "C61E7A93744F39EE10734AFE3FF7A087"
			assert deriveKey(master, salt, 2, 14).hex() == "30CBBC08863D8C85D49DB34A9AE1"
			assert deriveKey(master, salt, 1, 20).hex() == "CEBE321F6FF7716B6FD4AB49AF256A156D38BAA4"
			return none
		}

		// Each profile writes what libsrtp writes and reads it back.
		@test()
		def libsrtpVectors() !none {
			try againstLibsrtp(SRTPProfile.AES128CMHMACSHA1Tag80, "101112131415161718191A1B1C1D1E1F", "A0A1A2A3A4A5A6A7A8A9AAABACAD", ["90E0FFFE000103E6CAFEBABEBEDE000110AA0000179991F981ADC39E031745206376FB46E79D848742A10905D6CAFEFCC3A7", "90E0FFFF000103E7CAFEBABEBEDE000110AA0000670979BC9389067C476DAEA0A6F00694CF6872B765DB49A93CA9B09B8943", "90E00000000003E8CAFEBABEBEDE000110AA00002F79B376941A5415D7886CC66A4F2AC6F545A51DAB51FFCB8F3FA137B252", "90E00001000003E9CAFEBABEBEDE000110AA000064F77D44BD6A425ABC42055B0DDC31E00E0A2C59607CA08D2A13C909944F"], ["81C90007CAFEBABE4C16F9A5448997E694FF40DC83F51E8623E1791CA313E1B9800000018A0045CA097A397EAC53", "81C90007CAFEBABEC21C6248FFC6AF9C95DE88B420E683E76A8BD8399FEAE0F180000002DEA7B4ABB93DA18A02CC"])
			try againstLibsrtp(SRTPProfile.AES128CMHMACSHA1Tag32, "101112131415161718191A1B1C1D1E1F", "A0A1A2A3A4A5A6A7A8A9AAABACAD", ["90E0FFFE000103E6CAFEBABEBEDE000110AA0000179991F981ADC39E031745206376FB46E79D848742A10905", "90E0FFFF000103E7CAFEBABEBEDE000110AA0000670979BC9389067C476DAEA0A6F00694CF6872B765DB49A9", "90E00000000003E8CAFEBABEBEDE000110AA00002F79B376941A5415D7886CC66A4F2AC6F545A51DAB51FFCB", "90E00001000003E9CAFEBABEBEDE000110AA000064F77D44BD6A425ABC42055B0DDC31E00E0A2C59607CA08D"], ["81C90007CAFEBABE4C16F9A5448997E694FF40DC83F51E8623E1791CA313E1B9800000018A0045CA097A397EAC53", "81C90007CAFEBABEC21C6248FFC6AF9C95DE88B420E683E76A8BD8399FEAE0F180000002DEA7B4ABB93DA18A02CC"])
			try againstLibsrtp(SRTPProfile.AEADAES128GCM, "101112131415161718191A1B1C1D1E1F", "A0A1A2A3A4A5A6A7A8A9AAAB", ["90E0FFFE000103E6CAFEBABEBEDE000110AA0000797B28396FA4B17F030243EFD019A3109DA2A1E05C7EB41417324DF48FA106D997FE05D4", "90E0FFFF000103E7CAFEBABEBEDE000110AA0000638197F81E499AD167FC67E00F5286FD10F9C7CB1D3E8F4837DBDDADA212C016E9179EE8", "90E00000000003E8CAFEBABEBEDE000110AA000090E23A7AB6A9B76DC159E78DCAE7A848B06A776911F2E91045D8F8A129C9DC42598B4D08", "90E00001000003E9CAFEBABEBEDE000110AA0000B62F9E11D3B2AC5C560397A7BCB8CF25919601DAD05AED0A0E6E1167C04844EBB05779ED"], ["81C90007CAFEBABE7DB5521FD54FD8891A4C08CAF2F36D4DADE2DD98A682E5CEB763207ABD4E5841798684E59031F00180000001", "81C90007CAFEBABE52E07825E12052712BCBB68EA8D416F8CEBFB2E81D06EAE6831B93AC2E9B2525210DB22FA083009080000002"])
			try againstLibsrtp(SRTPProfile.AEADAES256GCM, "101112131415161718191A1B1C1D1E1F202122232425262728292A2B2C2D2E2F", "A0A1A2A3A4A5A6A7A8A9AAAB", ["90E0FFFE000103E6CAFEBABEBEDE000110AA0000350D6EBB04660481DE21DA072AE437D8E83552D2B8A9AF300A69FE47CB29700A6CCCF987", "90E0FFFF000103E7CAFEBABEBEDE000110AA000069714552DAF84B8FF3D2994190F311044EFEBAB9A29B0E28FD7C293618D093C7E3266841", "90E00000000003E8CAFEBABEBEDE000110AA00008CAE89D0BDACA34CAB71099FA197766E0681E067EE6A45E683462B8C1E3FB8BF49FDECBB", "90E00001000003E9CAFEBABEBEDE000110AA0000F3C505702B48049E0FCF0BDE66839B596D831E67A16605FFB510460CD01B2E42EF4DEAB0"], ["81C90007CAFEBABE0AAB903D5B9BE76721B1868F00B12E7D6765F14F5CB28617562283D5800907B9FDCFA47539E03FC580000001", "81C90007CAFEBABE5A8C0A63D7E9E80E7C53CC3AA511F315A1C9F6E2DB0D2FCBD6573E656EAA678ECDA951CFFB1B376880000002"])
			return none
		}

		// The NULL cipher profiles authenticate without encrypting; a
		// buffer without room, keys of the wrong length and an MKI are
		// refused.
		@test()
		def nullCipherAndRefusals() !none {
			let key = try hexdecode("000102030405060708090A0B0C0D0E0F")
			let salt = try hexdecode("A0A1A2A3A4A5A6A7A8A9AAABACAD")
			let keys = SRTPKeys{profile: SRTPProfile.NullHMACSHA1Tag32, localKey: key, localSalt: salt, remoteKey: key, remoteSalt: salt}
			let session = try srtp(keys)
			let plain = try vectorPacket(5)
			let buffer = padded(plain, session.overhead())
			let size = try session.protect(buffer, plain.len())
			assert session.overhead() == 4 && size == plain.len() + 4 && buffer[0:plain.len()].hex() == plain.hex()
			let other = try srtp(keys)
			assert (try other.unprotect(buffer, size)) == plain.len()

			let cramped = false
			session.protect(plain.clone(), plain.len()) onerror (err error) {
				cramped = err is RtpError
				recover 0
			}
			let short = false
			srtp(SRTPKeys{profile: SRTPProfile.AEADAES128GCM, localKey: key, localSalt: salt, remoteKey: key, remoteSalt: salt}) onerror (err error) {
				short = err is RtpError
				recover session
			}
			let tagged = false
			srtp(SRTPKeys{profile: SRTPProfile.NullHMACSHA1Tag32, localKey: key, localSalt: salt, remoteKey: key, remoteSalt: salt, mki: byte[1]}) onerror (err error) {
				tagged = err is RtpError
				recover session
			}
			assert cramped && short && tagged
			return none
		}

		// 1000 packets of 1200 bytes protected and opened; the floors are
		// the ciphers alone over the same bytes.
		@benchmark()
		def BenchProtectCounterMode() {
			protectLoop(SRTPProfile.AES128CMHMACSHA1Tag80) onerror recover none
		}

		@benchmark()
		def BenchProtectGCM() {
			protectLoop(SRTPProfile.AEADAES128GCM) onerror recover none
		}

		@benchmark()
		def BenchFloorCounterModeAndHMAC() {
			floorCounterMode() onerror recover none
		}

		@benchmark()
		def BenchFloorGCM() {
			floorGCM() onerror recover none
		}
	}
}
