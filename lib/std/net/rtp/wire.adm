// The byte-level pieces of std.net.rtp: big-endian fields at an offset of
// a packet being read or written.
internal partial module std.net.rtp.wire {
	use std.net.rtp::*

	// get16 is the big-endian 16-bit number at an offset.
	def get16(data byte[], at int) int {
		return int(data[at]) << 8 | int(data[at + 1])
	}

	// get24 is the big-endian 24-bit number at an offset.
	def get24(data byte[], at int) int {
		return int(data[at]) << 16 | int(data[at + 1]) << 8 | int(data[at + 2])
	}

	// get32 is the big-endian 32-bit number at an offset.
	def get32(data byte[], at int) int {
		return int(data[at]) << 24 | int(data[at + 1]) << 16 | int(data[at + 2]) << 8 | int(data[at + 3])
	}

	// put16 writes a 16-bit number big-endian at an offset.
	def put16(data byte[], at int, value int) {
		data[at] = byte((value >> 8) & 0xFF)
		data[at + 1] = byte(value & 0xFF)
	}

	// put24 writes a 24-bit number big-endian at an offset.
	def put24(data byte[], at int, value int) {
		data[at] = byte((value >> 16) & 0xFF)
		data[at + 1] = byte((value >> 8) & 0xFF)
		data[at + 2] = byte(value & 0xFF)
	}

	// put32 writes a 32-bit number big-endian at an offset.
	def put32(data byte[], at int, value int) {
		data[at] = byte((value >> 24) & 0xFF)
		data[at + 1] = byte((value >> 16) & 0xFF)
		data[at + 2] = byte((value >> 8) & 0xFF)
		data[at + 3] = byte(value & 0xFF)
	}

	// rtpError is a failure of this module.
	def rtpError(message string) RtpError {
		return RtpError{message: "rtp: {message}"}
	}

	// The feedback message types this module reads (the FMT field): of
	// transport layer feedback, and of payload-specific feedback.
	const formatNack = 1
	const formatTransportCC = 15
	const formatPli = 1
	const formatFir = 4
	const formatApplication = 15

	// rtcpHeader appends the four-byte header of an RTCP packet whose body
	// is `words` 32-bit words long.
	def rtcpHeader(out byte[], count int, packetType int, words int) byte[] {
		return out + byte[byte(0x80 | (count & 0x1F)), byte(packetType), byte((words >> 8) & 0xFF), byte(words & 0xFF)]
	}

	def word(value int) byte[] {
		return byte[byte((value >> 24) & 0xFF), byte((value >> 16) & 0xFF), byte((value >> 8) & 0xFF), byte(value & 0xFF)]
	}

	def reportBytes(reports ReceptionReport[]) byte[] {
		let out byte[]
		for let report in reports {
			out = out + word(report.ssrc) + byte[byte(report.fractionLost & 0xFF), byte((report.lost >> 16) & 0xFF), byte((report.lost >> 8) & 0xFF), byte(report.lost & 0xFF)] + word(report.highestSequence) + word(report.jitter) + word(report.lastSenderReport) + word(report.delay)
		}
		return out
	}

	def readReports(data byte[], at int, count int) ReceptionReport[] {
		let out ReceptionReport[]
		for let i = 0; i < count; i++ {
			let from = at + 24 * i
			let lost = get24(data, from + 5)
			// The cumulative loss is a signed 24-bit number.
			lost = lost - 0x1000000 when lost >= 0x800000
			out.push(ReceptionReport{ssrc: get32(data, from), fractionLost: int(data[from + 4]), lost: lost, highestSequence: get32(data, from + 8), jitter: get32(data, from + 12), lastSenderReport: get32(data, from + 16), delay: get32(data, from + 20)})
		}
		return out
	}

	// encodeCompound writes the packets of a compound in the order a
	// compound packet wants them.
	def encodeCompound(compound Compound) byte[] {
		let out byte[]
		for let sr in compound.senderReports {
			out = rtcpHeader(out, sr.reports.len(), int(RtcpType.SenderReport), 6 + 6 * sr.reports.len())
			out = out + word(sr.ssrc) + word(sr.ntpSeconds) + word(sr.ntpFraction) + word(sr.rtpTime) + word(sr.packetCount) + word(sr.octetCount) + reportBytes(sr.reports)
		}
		for let rr in compound.receiverReports {
			out = rtcpHeader(out, rr.reports.len(), int(RtcpType.ReceiverReport), 1 + 6 * rr.reports.len())
			out = out + word(rr.ssrc) + reportBytes(rr.reports)
		}
		if compound.descriptions.len() > 0 {
			let chunks byte[]
			for let description in compound.descriptions {
				let name = description.cname.bytes()
				let chunk = word(description.ssrc) + byte[1, byte(name.len())] + name + byte[0]
				for chunk.len() % 4 != 0 {
					chunk.push(0)
				}
				chunks = chunks + chunk
			}
			out = rtcpHeader(out, compound.descriptions.len(), int(RtcpType.SourceDescription), chunks.len() / 4) + chunks
		}
		for let nack in compound.nacks {
			let pairs = nackPairs(nack.lost)
			out = rtcpHeader(out, formatNack, int(RtcpType.TransportFeedback), 2 + pairs.len() / 4) + word(nack.sender) + word(nack.media) + pairs
		}
		for let feedback in compound.transportFeedback {
			let body = transportFeedbackBytes(feedback)
			out = rtcpHeader(out, formatTransportCC, int(RtcpType.TransportFeedback), 2 + body.len() / 4) + word(feedback.sender) + word(feedback.media) + body
		}
		for let pli in compound.plis {
			out = rtcpHeader(out, formatPli, int(RtcpType.PayloadFeedback), 2) + word(pli.sender) + word(pli.media)
		}
		for let fir in compound.firs {
			out = rtcpHeader(out, formatFir, int(RtcpType.PayloadFeedback), 4) + word(fir.sender) + word(0) + word(fir.media) + byte[byte(fir.sequence & 0xFF), 0, 0, 0]
		}
		for let remb in compound.rembs {
			// The bitrate as a 18-bit mantissa and a 6-bit exponent.
			let mantissa = remb.bitrate
			let exponent = 0
			for mantissa > 0x3FFFF {
				mantissa = mantissa >> 1
				exponent++
			}
			let body = "REMB".bytes() + byte[byte(remb.ssrcs.len()), byte((exponent << 2) | (mantissa >> 16)), byte((mantissa >> 8) & 0xFF), byte(mantissa & 0xFF)]
			for let ssrc in remb.ssrcs {
				body = body + word(ssrc)
			}
			out = rtcpHeader(out, formatApplication, int(RtcpType.PayloadFeedback), 2 + body.len() / 4) + word(remb.sender) + word(0) + body
		}
		for let bye in compound.byes {
			let body byte[]
			for let ssrc in bye.ssrcs {
				body = body + word(ssrc)
			}
			if bye.reason != "" {
				let reason = bye.reason.bytes()
				body = body + byte[byte(reason.len())] + reason
				for body.len() % 4 != 0 {
					body.push(0)
				}
			}
			out = rtcpHeader(out, bye.ssrcs.len(), int(RtcpType.Bye), body.len() / 4) + body
		}
		for let other in compound.unknown {
			out = rtcpHeader(out, other.count, other.packetType, other.body.len() / 4) + other.body
		}
		return out
	}

	// nackPairs is lost sequence numbers as PID and BLP pairs (RFC 4585
	// §6.2.1): a sequence number and a bit for each of the sixteen after
	// it. The numbers are taken in the order given, which should be
	// increasing.
	def nackPairs(lost int[]) byte[] {
		let out byte[]
		let i = 0
		for i < lost.len() {
			let pid = lost[i] & 0xFFFF
			let mask = 0
			i++
			for i < lost.len() {
				let ahead = (lost[i] - pid) & 0xFFFF
				break when ahead == 0 || ahead > 16
				mask = mask | (1 << (ahead - 1))
				i++
			}
			out = out + byte[byte(pid >> 8), byte(pid & 0xFF), byte(mask >> 8), byte(mask & 0xFF)]
		}
		return out
	}

	// transportFeedbackBytes is the body of transport-cc feedback behind
	// its two SSRCs: base sequence, packet count, reference time and
	// feedback count, then the status of the packets as run-length chunks
	// and the arrival deltas, padded to 32 bits.
	def transportFeedbackBytes(feedback TransportFeedback) byte[] {
		let count = feedback.deltas.len()
		let out = byte[byte((feedback.baseSequence >> 8) & 0xFF), byte(feedback.baseSequence & 0xFF), byte((count >> 8) & 0xFF), byte(count & 0xFF), byte((feedback.referenceTime >> 16) & 0xFF), byte((feedback.referenceTime >> 8) & 0xFF), byte(feedback.referenceTime & 0xFF), byte(feedback.feedbackCount & 0xFF)]
		let deltas byte[]
		let i = 0
		for i < count {
			let symbol = deltaSymbol(feedback.deltas[i])
			let run = 0
			for i < count && run < 8191 && deltaSymbol(feedback.deltas[i]) == symbol {
				let delta = feedback.deltas[i]
				deltas.push(byte(delta)) when symbol == 1
				deltas.push(byte((delta >> 8) & 0xFF), byte(delta & 0xFF)) when symbol == 2
				run++
				i++
			}
			let chunk = (symbol << 13) | run
			out.push(byte(chunk >> 8), byte(chunk & 0xFF))
		}
		out = out + deltas
		for out.len() % 4 != 0 {
			out.push(0)
		}
		return out
	}

	// deltaSymbol is the packet status symbol of an arrival delta: 0 not
	// received, 1 a small delta (one byte), 2 a large or negative one.
	def deltaSymbol(delta int) int {
		return 0 when delta == notReceived
		return delta >= 0 && delta <= 255 ?? (1, 2)
	}

	// decodeCompound takes a compound packet apart. Fails with RtpError as
	// `parseRtcp` says.
	def decodeCompound(data byte[]) !Compound {
		let compound = new Compound()
		let at = 0
		for at < data.len() {
			fail rtpError("an RTCP packet header runs past the datagram") when data.len() - at < 4
			let first = int(data[at])
			fail rtpError("RTCP version {first >> 6}") unless first >> 6 == 2
			let count = first & 0x1F
			let packetType = int(data[at + 1])
			let end = at + 4 + 4 * get16(data, at + 2)
			fail rtpError("an RTCP packet runs past the datagram") when end > data.len()
			let body = at + 4
			// The padding of the last packet is not part of its content.
			let stop = end
			if (first & 0x20) != 0 {
				let padding = int(data[end - 1])
				fail rtpError("RTCP padding of {padding} bytes") when padding == 0 || padding > end - body
				stop = end - padding
			}
			let size = stop - body
			switch {
				case packetType == int(RtcpType.SenderReport):
					fail rtpError("a sender report of {size} bytes") when size < 24 + 24 * count
					compound.senderReports.push(SenderReport{ssrc: get32(data, body), ntpSeconds: get32(data, body + 4), ntpFraction: get32(data, body + 8), rtpTime: get32(data, body + 12), packetCount: get32(data, body + 16), octetCount: get32(data, body + 20), reports: readReports(data, body + 24, count)})
				case packetType == int(RtcpType.ReceiverReport):
					fail rtpError("a receiver report of {size} bytes") when size < 4 + 24 * count
					compound.receiverReports.push(ReceiverReport{ssrc: get32(data, body), reports: readReports(data, body + 4, count)})
				case packetType == int(RtcpType.SourceDescription):
					readDescriptions(compound, data, body, stop, count)
				case packetType == int(RtcpType.Bye):
					fail rtpError("a BYE of {size} bytes for {count} sources") when size < 4 * count
					let bye = Bye{ssrcs: []}
					for let i = 0; i < count; i++ {
						bye.ssrcs.push(get32(data, body + 4 * i))
					}
					let reasonAt = body + 4 * count
					if reasonAt < stop {
						let length = int(data[reasonAt])
						bye.reason = string(data[reasonAt + 1:reasonAt + 1 + length]) when reasonAt + 1 + length <= stop
					}
					compound.byes.push(bye)
				case packetType == int(RtcpType.TransportFeedback) && count == formatNack && size >= 8:
					let nack = Nack{sender: get32(data, body), media: get32(data, body + 4), lost: []}
					for let pair = body + 8; pair + 4 <= stop; pair += 4 {
						let pid = get16(data, pair)
						let mask = get16(data, pair + 2)
						nack.lost.push(pid)
						for let bit = 0; bit < 16; bit++ {
							nack.lost.push((pid + bit + 1) & 0xFFFF) when (mask & (1 << bit)) != 0
						}
					}
					compound.nacks.push(nack)
				case packetType == int(RtcpType.TransportFeedback) && count == formatTransportCC && size >= 16:
					compound.transportFeedback.push(try readTransportFeedback(data, body, stop))
				case packetType == int(RtcpType.PayloadFeedback) && count == formatPli && size >= 8:
					compound.plis.push(Pli{sender: get32(data, body), media: get32(data, body + 4)})
				case packetType == int(RtcpType.PayloadFeedback) && count == formatFir && size >= 16:
					for let entry = body + 8; entry + 8 <= stop; entry += 8 {
						compound.firs.push(Fir{sender: get32(data, body), media: get32(data, entry), sequence: int(data[entry + 4])})
					}
				case packetType == int(RtcpType.PayloadFeedback) && count == formatApplication && size >= 16 && string(data[body + 8:body + 12]) == "REMB":
					let sources = int(data[body + 12])
					fail rtpError("a REMB of {size} bytes for {sources} sources") when size < 16 + 4 * sources
					let exponent = int(data[body + 13]) >> 2
					let mantissa = (int(data[body + 13]) & 0x03) << 16 | get16(data, body + 14)
					let remb = Remb{sender: get32(data, body), bitrate: mantissa << exponent}
					for let i = 0; i < sources; i++ {
						remb.ssrcs.push(get32(data, body + 16 + 4 * i))
					}
					compound.rembs.push(remb)
				default:
					compound.unknown.push(UnknownRtcp{packetType: packetType, count: count, body: data[body:end].clone()})
			}
			at = end
		}
		return compound
	}

	// readDescriptions reads the chunks of an SDES into the compound: the
	// CNAME of each source.
	def readDescriptions(compound Compound, data byte[], start int, stop int, count int) {
		let at = start
		for let chunk = 0; chunk < count && at + 4 <= stop; chunk++ {
			let description = SourceDescription{ssrc: get32(data, at)}
			at += 4
			for at < stop && data[at] != 0 {
				break when at + 2 > stop
				let length = int(data[at + 1])
				break when at + 2 + length > stop
				description.cname = string(data[at + 2:at + 2 + length]) when data[at] == 1
				at += 2 + length
			}
			// The item list ends with a zero and padding to 32 bits.
			at = start + ((at - start) / 4 + 1) * 4
			compound.descriptions.push(description)
		}
	}

	// readTransportFeedback reads transport-cc feedback between two
	// offsets. Fails with RtpError when its chunks or deltas run past it.
	def readTransportFeedback(data byte[], body int, stop int) !TransportFeedback {
		let feedback = TransportFeedback{sender: get32(data, body), media: get32(data, body + 4), baseSequence: get16(data, body + 8), referenceTime: get24(data, body + 12), feedbackCount: int(data[body + 15])}
		let count = get16(data, body + 10)
		let symbols int[]
		let at = body + 16
		for symbols.len() < count {
			fail rtpError("transport feedback ends inside its status chunks") when at + 2 > stop
			let chunk = get16(data, at)
			at += 2
			if (chunk & 0x8000) == 0 {
				let symbol = (chunk >> 13) & 0x03
				for let i = 0; i < (chunk & 0x1FFF) && symbols.len() < count; i++ {
					symbols.push(symbol)
				}
			} else if (chunk & 0x4000) == 0 {
				for let i = 0; i < 14 && symbols.len() < count; i++ {
					symbols.push((chunk >> (13 - i)) & 0x01)
				}
			} else {
				for let i = 0; i < 7 && symbols.len() < count; i++ {
					symbols.push((chunk >> (12 - 2 * i)) & 0x03)
				}
			}
		}
		for let symbol in symbols {
			if symbol == 1 {
				fail rtpError("transport feedback ends inside its deltas") when at + 1 > stop
				feedback.deltas.push(int(data[at]))
				at++
			} else if symbol == 2 {
				fail rtpError("transport feedback ends inside its deltas") when at + 2 > stop
				let delta = get16(data, at)
				feedback.deltas.push(delta >= 0x8000 ?? (delta - 0x10000, delta))
				at += 2
			} else {
				feedback.deltas.push(notReceived)
			}
		}
		return feedback
	}

	// ---- Payload formats ----

	// chunks cuts the bytes of `data` from `from` on into pieces of at most
	// `size`, each behind a copy of `head` whose byte `flagAt` gets
	// `first` or-ed in on the first piece and `last` on the last one.
	def chunks(data byte[], from int, size int, head byte[], flagAt int, first int, last int) byte[][] {
		let out byte[][]
		let room = (size - head.len()).max(1)
		let at = from
		for at < data.len() || out.len() == 0 {
			let n = (data.len() - at).min(room)
			let piece byte[]
			piece.len(head.len() + n)
			head.copy(piece)
			piece[flagAt] = piece[flagAt] | byte(first) when at == from
			piece[flagAt] = piece[flagAt] | byte(last) when at + n >= data.len()
			for let i = 0; i < n; i++ {
				piece[head.len() + i] = data[at + i]
			}
			out.push(piece)
			at += n
			break when n == 0
		}
		return out
	}

	// joined is the bytes of each payload from its own offset on, one after
	// the other.
	def joined(payloads byte[][], offsets int[]) byte[] {
		let size = 0
		for let (i, payload) in payloads {
			size += payload.len() - offsets[i]
		}
		let out byte[]
		out.len(size)
		let at = 0
		for let (i, payload) in payloads {
			for let j = offsets[i]; j < payload.len(); j++ {
				out[at] = payload[j]
				at++
			}
		}
		return out
	}

	// vp8Descriptor is the length of the VP8 payload descriptor at the
	// front of a payload (RFC 7741 §4.2), -1 when the payload is too short
	// for it.
	def vp8Descriptor(payload byte[], from int, to int) int {
		return -1 when to - from < 1
		let at = from + 1
		if (int(payload[from]) & 0x80) != 0 {
			return -1 when at >= to
			let extended = int(payload[at])
			at++
			if (extended & 0x80) != 0 {
				return -1 when at >= to
				at += (int(payload[at]) & 0x80) != 0 ?? (2, 1)
			}
			at++ when (extended & 0x40) != 0
			at++ when (extended & 0x30) != 0
		}
		return at > to ?? (-1, at - from)
	}

	// packetizeVP8 cuts a frame behind the VP8 payload descriptor (RFC
	// 7741 §4.2): X with I and a 15-bit PictureID, S on the first payload.
	// With a temporal `layer` (0 or above) the descriptor also carries L
	// and T: `base` counts the frames of layer 0, a frame above it is
	// marked as one no frame needs (N) that needs only layer 0 itself (Y).
	def packetizeVP8(frame byte[], picture int, size int, layer int = -1, base int = 0) byte[][] {
		let head = byte[0x80, 0x80, byte(0x80 | (picture >> 8)), byte(picture & 0xFF)]
		if layer >= 0 {
			head[0] = byte(0xA0) when layer > 0
			head[1] = byte(0xE0)
			head.push(byte(base & 0xFF), byte(((layer & 3) << 6) | 0x20))
		}
		return chunks(frame, 0, size, head, 0, 0x10, 0)
	}

	// vp8Layer is the temporal layer a VP8 payload names, -1 when its
	// descriptor names none or the payload ends inside it.
	def vp8Layer(payload byte[]) int {
		return -1 when payload.len() < 2 || (int(payload[0]) & 0x80) == 0
		let extended = int(payload[1])
		return -1 when (extended & 0x20) == 0
		let at = 2
		if (extended & 0x80) != 0 {
			return -1 when at >= payload.len()
			at += (int(payload[at]) & 0x80) != 0 ?? (2, 1)
		}
		at++ when (extended & 0x40) != 0
		return -1 when at >= payload.len()
		return int(payload[at]) >> 6
	}

	def depacketizeVP8(payloads byte[][]) !byte[] {
		let offsets int[]
		for let payload in payloads {
			let size = vp8Descriptor(payload, 0, payload.len())
			fail rtpError("a VP8 payload of {payload.len()} bytes ends inside its descriptor") when size < 0
			offsets.push(size)
		}
		return joined(payloads, offsets)
	}

	// vp9Descriptor is the length of the VP9 payload descriptor (RFC 9628
	// §4.2), -1 when the payload is too short for it.
	def vp9Descriptor(payload byte[], from int, to int) int {
		return -1 when to - from < 1
		let flags = int(payload[from])
		let at = from + 1
		if (flags & 0x80) != 0 {
			return -1 when at >= to
			at += (int(payload[at]) & 0x80) != 0 ?? (2, 1)
		}
		// Layer indices, and TL0PICIDX in non-flexible mode.
		at += (flags & 0x10) != 0 ?? (1, 2) when (flags & 0x20) != 0
		if (flags & 0x10) != 0 && (flags & 0x40) != 0 {
			// Up to three reference indices, each with a bit for "more".
			for let i = 0; i < 3; i++ {
				return -1 when at >= to
				let more = (int(payload[at]) & 0x01) != 0
				at++
				break unless more
			}
		}
		if (flags & 0x02) != 0 {
			// The scalability structure.
			return -1 when at >= to
			let structure = int(payload[at])
			at++
			let layers = (structure >> 5) + 1
			at += 4 * layers when (structure & 0x10) != 0
			if (structure & 0x08) != 0 {
				return -1 when at >= to
				let pictures = int(payload[at])
				at++
				for let i = 0; i < pictures; i++ {
					return -1 when at >= to
					let references = (int(payload[at]) >> 2) & 0x03
					at += 1 + references
				}
			}
		}
		return at > to ?? (-1, at - from)
	}

	def packetizeVP9(frame byte[], picture int, keyframe bool, size int) byte[][] {
		// I with a 15-bit PictureID, P for an inter frame; B on the first
		// payload and E on the last.
		return chunks(frame, 0, size, byte[byte(0x80 | (keyframe ?? (0, 0x40))), byte(0x80 | (picture >> 8)), byte(picture & 0xFF)], 0, 0x08, 0x04)
	}

	def depacketizeVP9(payloads byte[][]) !byte[] {
		let offsets int[]
		for let payload in payloads {
			let size = vp9Descriptor(payload, 0, payload.len())
			fail rtpError("a VP9 payload of {payload.len()} bytes ends inside its descriptor") when size < 0
			offsets.push(size)
		}
		return joined(payloads, offsets)
	}

	// nalUnits is where the NAL units of an Annex B byte stream lie: start
	// and end offsets in pairs, the start codes left out.
	def nalUnits(stream byte[]) int[] {
		let out int[]
		let start = -1
		let i = 0
		for i + 2 < stream.len() {
			if stream[i] == 0 && stream[i + 1] == 0 && stream[i + 2] == 1 {
				if start >= 0 {
					// A four-byte start code has a zero before the three.
					let end = i > start && stream[i - 1] == 0 ?? (i - 1, i)
					out.push(start, end)
				}
				start = i + 3
				i += 3
				continue
			}
			i++
		}
		out.push(start, stream.len()) when start >= 0
		return out
	}

	def packetizeH264(frame byte[], size int) byte[][] {
		let out byte[][]
		let units = nalUnits(frame)
		for let u = 0; u < units.len(); u += 2 {
			let start = units[u]
			let end = units[u + 1]
			continue when end <= start
			if end - start <= size {
				out.push(frame[start:end].clone())
				continue
			}
			// FU-A (RFC 6184 §5.8): the NAL header's F and NRI with type
			// 28, then S, E and the NAL type; the NAL header itself is not
			// sent.
			let header = int(frame[start])
			let pieces = chunks(frame, start + 1, size, byte[byte((header & 0xE0) | 28), byte(header & 0x1F)], 1, 0x80, 0x40)
			for let piece in pieces {
				out.push(piece)
			}
		}
		return out
	}

	def depacketizeH264(payloads byte[][]) !byte[] {
		let out byte[]
		let code = byte[0, 0, 0, 1]
		for let payload in payloads {
			fail rtpError("an empty H.264 payload") when payload.len() == 0
			let kind = int(payload[0]) & 0x1F
			switch {
				case kind >= 1 && kind <= 23:
					out = out + code + payload
				case kind == 24:
					// STAP-A: NAL units, each behind its 16-bit size.
					let at = 1
					for at + 2 <= payload.len() {
						let size = get16(payload, at)
						fail rtpError("an H.264 aggregation packet ends inside a NAL unit") when at + 2 + size > payload.len()
						out = out + code + payload[at + 2:at + 2 + size]
						at += 2 + size
					}
				case kind == 28:
					fail rtpError("an H.264 fragmentation unit of {payload.len()} bytes") when payload.len() < 2
					let fragment = int(payload[1])
					out = out + code + byte[byte((int(payload[0]) & 0xE0) | (fragment & 0x1F))] when (fragment & 0x80) != 0
					out = out + payload[2:]
				default:
					fail rtpError("H.264 packet type {kind} (only single NAL units, STAP-A and FU-A are read)")
			}
		}
		return out
	}

	// leb128 reads the LEB128 number at an offset: its value and the bytes
	// it takes, 0 bytes when it runs past `to`.
	def leb128(data byte[], at int, to int) (int, int) {
		let value = 0
		for let i = 0; i < 8 && at + i < to; i++ {
			let b = int(data[at + i])
			value = value | ((b & 0x7F) << (7 * i))
			return (value, i + 1) when (b & 0x80) == 0
		}
		return (0, 0)
	}

	def leb128Bytes(value int) byte[] {
		let out byte[]
		let rest = value
		for {
			let b = rest & 0x7F
			rest = rest >> 7
			out.push(byte(rest > 0 ?? (b | 0x80, b)))
			break when rest == 0
		}
		return out
	}

	// packetizeAV1 sends each OBU of a temporal unit but the temporal
	// delimiter as one OBU element per packet, without its size field
	// (aggregation header W = 1), cut across packets with Z and Y when it
	// is longer than a payload; N marks the first packet of a new coded
	// video sequence.
	def packetizeAV1(unit byte[], keyframe bool, size int) byte[][] {
		let out byte[][]
		let at = 0
		for at < unit.len() {
			let header = int(unit[at])
			let extended = (header & 0x04) != 0
			let headerSize = extended ?? (2, 1)
			let bodyAt = at + headerSize
			let bodySize = unit.len() - bodyAt
			if (header & 0x02) != 0 {
				let (value, used) = leb128(unit, bodyAt, unit.len())
				break when used == 0
				bodyAt += used
				bodySize = value
			}
			let end = (bodyAt + bodySize).min(unit.len())
			// The temporal delimiter (type 2) is not sent.
			if ((header >> 3) & 0x0F) != 2 {
				let obu byte[]
				obu.len(headerSize + end - bodyAt)
				obu[0] = byte(header & 0xFD)
				obu[1] = unit[at + 1] when extended
				for let i = bodyAt; i < end; i++ {
					obu[headerSize + i - bodyAt] = unit[i]
				}
				// Aggregation header: Z on a continuation, Y when the OBU
				// goes on, W = 1, N on the very first packet of a keyframe.
				let room = (size - 1).max(1)
				let from = 0
				for from < obu.len() {
					let n = (obu.len() - from).min(room)
					let piece byte[]
					piece.len(1 + n)
					piece[0] = byte(0x10 | (from > 0 ?? (0x80, 0)) | (from + n < obu.len() ?? (0x40, 0)) | (keyframe && out.len() == 0 ?? (0x08, 0)))
					for let i = 0; i < n; i++ {
						piece[1 + i] = obu[from + i]
					}
					out.push(piece)
					from += n
				}
			}
			at = end
		}
		return out
	}

	def depacketizeAV1(payloads byte[][]) !byte[] {
		let out byte[]
		// The OBU being put together: an element may go on in the next
		// packet.
		let pending byte[]
		for let payload in payloads {
			fail rtpError("an empty AV1 payload") when payload.len() == 0
			let aggregation = int(payload[0])
			let count = (aggregation >> 4) & 0x03
			let at = 1
			let element = 0
			for at < payload.len() {
				element++
				let size = payload.len() - at
				// Every element has a length but the last of a packet that
				// says how many it holds.
				if count == 0 || element < count {
					let (value, used) = leb128(payload, at, payload.len())
					fail rtpError("an AV1 payload ends inside an element length") when used == 0 || at + used + value > payload.len()
					at += used
					size = value
				}
				pending = pending + payload[at:at + size]
				at += size
				let goesOn = at >= payload.len() && (aggregation & 0x40) != 0
				continue when goesOn
				if pending.len() > 0 {
					// The OBU gets its size field back.
					let extended = (int(pending[0]) & 0x04) != 0
					let headerSize = extended ?? (2, 1)
					fail rtpError("an AV1 OBU shorter than its header") when pending.len() < headerSize
					out = out + byte[pending[0] | byte(0x02)]
					out = out + byte[pending[1]] when extended
					out = out + leb128Bytes(pending.len() - headerSize) + pending[headerSize:]
				}
				pending = []
			}
		}
		fail rtpError("an AV1 frame ends inside an OBU") when pending.len() > 0
		return out
	}

	// frameStart reports whether the payload in a buffer is the first of
	// its frame.
	def frameStart(format PayloadFormat, payload byte[], from int, to int) bool {
		return false when to <= from
		let first = int(payload[from])
		switch {
			case format == PayloadFormat.VP8:
				return (first & 0x10) != 0 && (first & 0x07) == 0
			case format == PayloadFormat.VP9:
				return (first & 0x08) != 0
			case format == PayloadFormat.H264:
				return (first & 0x1F) != 28 || (to - from > 1 && (int(payload[from + 1]) & 0x80) != 0)
			case format == PayloadFormat.AV1:
				return (first & 0x80) == 0
		}
		return true
	}

	// pictureAt is where the number a payload's descriptor gives its
	// frame lies: the PictureID of VP8 (RFC 7741 §4.2) and VP9 (RFC 9628
	// §4.2). -1 for a format or a payload without one.
	def pictureAt(format PayloadFormat, payload byte[], from int, to int) int {
		return -1 when to - from < 2
		let at = from + 1
		if format == PayloadFormat.VP8 {
			// X, then I among the extension bits.
			return -1 when (int(payload[from]) & 0x80) == 0 || (int(payload[at]) & 0x80) == 0
			at++
		} else if format != PayloadFormat.VP9 || (int(payload[from]) & 0x80) == 0 {
			return -1
		}
		return -1 when at >= to || ((int(payload[at]) & 0x80) != 0 && at + 1 >= to)
		return at
	}

	// pictureNumber is the number a payload's descriptor gives its frame,
	// 7 or 15 bits wide; -1 for a format or a payload without one.
	def pictureNumber(format PayloadFormat, payload byte[], from int, to int) int {
		let at = pictureAt(format, payload, from, to)
		return -1 when at < 0
		let high = int(payload[at])
		return (high & 0x80) == 0 ?? (high, (high & 0x7F) << 8 | int(payload[at + 1]))
	}

	// spatialLayer is the spatial layer a payload's descriptor names: the
	// SID of VP9 (RFC 9628 §4.2), 0 for a payload that names none.
	def spatialLayer(format PayloadFormat, payload byte[], from int, to int) int {
		return 0 unless format == PayloadFormat.VP9 && to > from && (int(payload[from]) & 0x20) != 0
		let at = from + 1
		at += (int(payload[at]) & 0x80) != 0 ?? (2, 1) when (int(payload[from]) & 0x80) != 0 && at < to
		return 0 when at >= to
		return (int(payload[at]) >> 1) & 0x07
	}

	// pictureTurn is what the picture numbers of a payload's stream count
	// up to before they start over (128 or 32768), 0 without a number.
	def pictureTurn(format PayloadFormat, payload byte[], from int, to int) int {
		let at = pictureAt(format, payload, from, to)
		return 0 when at < 0
		return (int(payload[at]) & 0x80) == 0 ?? (0x80, 0x8000)
	}

	// keyframeStart reports whether the payload in a buffer starts a frame
	// that needs none before it.
	def keyframeStart(format PayloadFormat, payload byte[], from int, to int) bool {
		return false unless frameStart(format, payload, from, to)
		let first = int(payload[from])
		switch {
			case format == PayloadFormat.VP8:
				let size = vp8Descriptor(payload, from, to)
				return size > 0 && from + size < to && (int(payload[from + size]) & 0x01) == 0
			case format == PayloadFormat.VP9:
				return (first & 0x40) == 0
			case format == PayloadFormat.H264:
				let kind = first & 0x1F
				kind = int(payload[from + 1]) & 0x1F when kind == 28
				// The first NAL of an aggregation packet says what it holds.
				kind = int(payload[from + 3]) & 0x1F when kind == 24 && to - from > 3
				return kind := 5 || 7
			case format == PayloadFormat.AV1:
				return (first & 0x08) != 0
		}
		return true
	}
}
