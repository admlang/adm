partial module std.net.sasl {
	use std.testing

	check "SCRAM" {
		@test()
		def matchesTheRfcExamples() !none {
			// RFC 5802 §5 (SHA-1) and RFC 7677 §3 (SHA-256): user "user",
			// password "pencil".
			let cases = [
				["SCRAM-SHA-1", "fyko+d2lbbFgONRv9qkxdawL", "3rfcNHYJY1ZVvWVs7j", "QSXCR+Q6sek8bf92", "v0X8v3Bz2T0CJGbJQyF0X+HI4Ts=", "rmF9pqV8S7suAoZWja4dJRkFsKQ="],
				["SCRAM-SHA-256", "rOprNGfwEbeRWgbNEkqO", "%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0", "W22ZaJ0SNY7soEsUEjb6gQ==", "dHzbZapWIk4jUhN+Ute9ytag9zjfMHgsqmmiz7AndVQ=", "6rriTRBi23WpRR/wtup+mMhUZUn/dB5nLTJRsjl95G4="],
			]
			for let c in cases {
				let mechanism = scramMechanismOf(c[0])
				fail "no mechanism {c[0]}" when mechanism is none
				let client = new ScramClient("user", "pencil", mechanism)
				let first = client.first(c[1])
				assert first == "n,,n=user,r={c[1]}"
				let serverFirst = "r={c[1]}{c[2]},s={c[3]},i=4096"
				let final = try client.final(serverFirst)
				assert final == "c=biws,r={c[1]}{c[2]},p={c[4]}"
				try client.verify("v={c[5]}")
				// The server side, from stored credentials.
				let stored = scramCredentials("pencil", try decode(c[3]), 4096, mechanism)
				let server = new ScramServer(def (user string) !ScramCredentials {
					fail "who?" unless user == "user"
					return stored
				}, mechanism)
				assert (try server.first(first, c[2])) == serverFirst
				assert (try server.final(final)) == "v={c[5]}"
				assert server.user() == "user"
				let back = try parseScramCredentials(stored.str())
				assert back.str() == stored.str() && back.mechanism == mechanism
			}
			return none
		}

		@test()
		def refusesWrongPasswordsAndServers() !none {
			for let mechanism in [ScramMechanism.Sha1, ScramMechanism.Sha256, ScramMechanism.Sha512] {
				let stored = try scramCredentials("right", mechanism, 4096)
				let lookup = def (user string) !ScramCredentials {
					return stored
				}
				// The right password, and a user name that needs escaping.
				let good = new ScramClient("a=b,c", "right", mechanism)
				good.authzId = "admin"
				let server = new ScramServer(lookup, mechanism)
				let final = try good.final(try server.first(try good.first()))
				try good.verify(try server.final(final))
				assert server.user() == "a=b,c" && server.authzId() == "admin"
				// A wrong password: the server says invalid-proof.
				let bad = new ScramClient("u", "wrong", mechanism)
				let checker = new ScramServer(lookup, mechanism)
				let badFinal = try bad.final(try checker.first(try bad.first()))
				let reply = ""
				checker.final(badFinal) onerror (err error) {
					if err is SaslError {
						let e SaslError = err
						reply = e.reply
					}
					recover ""
				}
				assert reply == "invalid-proof"
				// A server that does not know the password cannot prove it.
				let fooled = new ScramClient("u", "right", mechanism)
				try fooled.final(try new ScramServer(lookup, mechanism).first(try fooled.first()))
				let refused = false
				fooled.verify("v=AAAA") onerror (err error) {
					refused = true
					recover none
				}
				assert refused
			}
			return none
		}

		@test()
		def matchesScrampWithBinding() !none {
			// Python scramp 1.4.5 with the same nonces, salt and binding data.
			let cb = ChannelBinding{kind: "tls-server-end-point", data: "exported keying material".bytes()}
			let client = new ScramClient("user", "pencil", ScramMechanism.Sha256, cb)
			assert client.first("cnonce") == "p=tls-server-end-point,,n=user,r=cnonce"
			let final = try client.final("r=cnoncesnonce,s=W22ZaJ0SNY7soEsUEjb6gQ==,i=4096")
			assert final == "c=cD10bHMtc2VydmVyLWVuZC1wb2ludCwsZXhwb3J0ZWQga2V5aW5nIG1hdGVyaWFs,r=cnoncesnonce,p=f5tw/+Og5YAUw3nqnMfkRzHYJSGAOaWtqG7JjOOWWVg="
			return none
		}

		@test()
		def bindsToTheChannel() !none {
			let stored = try scramCredentials("pw")
			let lookup = def (user string) !ScramCredentials {
				return stored
			}
			let cb = ChannelBinding{kind: "tls-exporter", data: "exported keying material".bytes()}
			// Both sides on the same channel.
			let client = new ScramClient("u", "pw", ScramMechanism.Sha256, cb)
			assert client.mechanismName() == "SCRAM-SHA-256-PLUS"
			let server = new ScramServer(lookup, ScramMechanism.Sha256, [ChannelBinding{kind: "tls-server-end-point", data: "hash".bytes()}, cb], true)
			let first = try client.first()
			assert first.startsWith("p=tls-exporter,,")
			try client.verify(try server.final(try client.final(try server.first(first))))
			// A relay: the server's channel differs.
			let relayed = new ScramClient("u", "pw", ScramMechanism.Sha256, cb)
			let other = new ScramServer(lookup, ScramMechanism.Sha256, [ChannelBinding{kind: "tls-exporter", data: "another channel".bytes()}], true)
			let relayedFinal = try relayed.final(try other.first(try relayed.first()))
			let code = ""
			other.final(relayedFinal) onerror (err error) {
				code = err.code
				recover ""
			}
			assert code == "binding"
			// A stripped -PLUS offer: the client says `y`, the server notices.
			let downgraded = new ScramClient("u", "pw", ScramMechanism.Sha256, cb)
			downgraded.bindingOffered = false
			assert downgraded.mechanismName() == "SCRAM-SHA-256"
			let yFirst = try downgraded.first()
			assert yFirst.startsWith("y,,")
			let noticed = ""
			new ScramServer(lookup, ScramMechanism.Sha256, [cb], false).first(yFirst) onerror (err error) {
				if err is SaslError {
					let e SaslError = err
					noticed = e.reply
				}
				recover ""
			}
			assert noticed == "server-does-support-channel-binding"
			// `y` to a server without TLS is fine.
			let plainServer = new ScramServer(lookup)
			try downgraded.verify(try plainServer.final(try downgraded.final(try plainServer.first(yFirst))))
			return none
		}
	}
}
