// SCTP (RFC 9260) in user space over any datagram transport, as WebRTC
// data channels run it over DTLS (RFC 8261): associations with streams of
// messages, ordered or not.
//
//     let association = try sctp.connect(dtls)
//     let stream = association.openStream(1)
//     try stream.send("hello".bytes(), sctp.PayloadProtocol.String)
//     let message = try stream.receive(5s)
partial module std.net.sctp {
	use (
		std.errors
		std.net
		std.net.sctp.wire::*
	)

	// SctpError is the payload of a failure of this module.
	struct SctpError {
		message     string
		code        string            = "sctp"
		cause       ?error
		stack       errors.StackTrace
		// The peer reset the stream (RFC 6525): what it sent before was
		// read, and the stream starts over.
		streamReset bool              = false
		stream      int               = -1
	}

	// AssociationState is where an association stands (RFC 9260 §4).
	enum AssociationState {
		Closed,
		CookieWait,
		CookieEchoed,
		Established,
		ShutdownPending,
		ShutdownSent,
		ShutdownReceived,
		ShutdownAckSent
	}

	// PayloadProtocol names the payload protocol identifiers WebRTC data
	// channels use (RFC 8831 §8), the value being the one on the wire;
	// a message carries any number.
	enum PayloadProtocol {
		None = 0,
		// The data channel establishment protocol (RFC 8832).
		DCEP = 50,
		String = 51,
		Binary = 53,
		StringEmpty = 56,
		BinaryEmpty = 57,
	}

	// Options steers an association: its port and the peer's (both 5000
	// for WebRTC), how many streams each way it offers, the largest message
	// it takes, the receive buffer its window advertises, the largest
	// packet it sends, the retransmission timer's bounds, how many
	// retransmissions without an answer end the association (and the
	// attempt to open it), the idle time before a heartbeat, and how long
	// `connect` and `accept` wait.
	struct Options {
		port               int      = 5000
		remotePort         int      = 5000
		streams            int      = 1024
		maxMessageSize     int      = 262144
		receiveBuffer      int      = 1048576
		mtu                int      = 1200
		// The largest packet the path may carry: above `mtu`, the
		// association probes for it (RFC 8899) and sends packets as large as
		// the path was seen to pass. A path that narrows afterwards loses
		// the chunks already cut for the larger size, since nothing below
		// SCTP fragments them; equal to `mtu`, packets never grow.
		maxMtu             int      = 1200
		rtoInitial         duration = 1s
		rtoMin             duration = 1s
		rtoMax             duration = 60s
		maxRetransmits     int      = 10
		maxInitRetransmits int      = 8
		heartbeat          duration = 30s
		connectTimeout     duration = 30s
		// Offer I-DATA (RFC 8260): with a peer that does too, the messages
		// of different streams interleave chunk by chunk.
		interleaving       bool     = true
	}

	// Message is one message of a stream: its bytes and its payload
	// protocol identifier.
	struct Message {
		stream   int
		data     byte[]
		protocol int    = 0
	}

	// Stream is one stream of an association: messages sent on it arrive
	// whole, in the order sent unless `ordered` is turned off.
	type Stream {
		id             int
		// Deliver this side's messages in the order sent.
		ordered        bool      = true
		// Partial reliability (RFC 3758, RFC 7496): a message is given up
		// once it was sent again this many times, or once it is this old.
		// none: sent until it arrives.
		maxRetransmits ?int      = none
		maxLifetime    ?duration = none
		internal core  Core

		def new(core Core, id int) {
			self.core = core
			self.id = id
		}

		// send sends one message; it returns once the message is queued,
		// waiting while the send buffer is full. Fails with SctpError when
		// the association is closed or the message is longer than the
		// largest the association sends, as the transport does otherwise.
		def send(data byte[], protocol PayloadProtocol = PayloadProtocol.Binary) !none {
			let limit = maxRetransmits
			let lifetime = maxLifetime
			return try core.send(id, data, int(protocol), ordered, limit is none ?? (-1, limit), lifetime is none ?? (0s, lifetime))
		}

		// receive waits for the next message of the stream; 0s or less
		// waits without end. Fails with NetError (TimedOut) when none comes
		// in time, SctpError once the association is closed and nothing is
		// left to read.
		def receive(timeout duration = 30s) !Message {
			return try core.receive(id, timeout)
		}

		// reset ends this side's use of the stream (RFC 6525), as closing a
		// data channel does: once what was sent arrived, the peer's
		// `receive` fails with SctpError (`streamReset`) and the stream's
		// numbering starts over. Returns once the request is queued. Fails
		// with SctpError when the association is closed or the peer does
		// not reset streams.
		def reset() !none {
			return try core.reset(id)
		}
	}

	// Association is an SCTP association over a datagram transport. A task
	// of its own reads the transport, acknowledges, retransmits and keeps
	// the association alive until `close` or `abort`.
	type Association {
		internal core Core

		def new(core Core) {
			self.core = core
		}

		// state is where the association stands.
		def state() AssociationState {
			return core.currentState()
		}

		// mtu is the largest packet the association sends now.
		def mtu() int {
			return core.currentMtu()
		}

		// openStream is the stream with the number, for sending and
		// receiving; streams need no opening on the wire.
		def openStream(id int) Stream {
			return new Stream(core, id)
		}

		// acceptStream waits for the first message on a stream the peer
		// started and returns the stream; 0s or less waits without end.
		// Fails with NetError (TimedOut), SctpError once the association is
		// closed.
		def acceptStream(timeout duration = 0s) !Stream {
			return new Stream(core, try core.nextStream(timeout))
		}

		// receive waits for the next message of any stream, in the order
		// they became ready; 0s or less waits without end. Fails as
		// `Stream.receive` does, a reset naming its stream.
		def receive(timeout duration = 30s) !Message {
			return try core.receiveAny(timeout)
		}

		// close ends the association once everything sent was
		// acknowledged (RFC 9260 §9.2) and closes the transport. Never
		// fails.
		def close() !none {
			core.shutdown()
			return none
		}

		// abort ends the association at once, telling the peer why.
		def abort(reason string = "") {
			core.abort(reason)
		}

		// Aborts the association when the last reference is released.
		def dispose() {
			core.abort("") unless core.isOver()
		}
	}

	// connect opens an association over the transport by sending INIT; the
	// peer may do the same at once, as WebRTC peers do. Fails with
	// SctpError when the peer does not answer within the connect timeout
	// or refuses.
	def connect(transport net.DatagramTransport, options Options = Options{}) !Association {
		let core = new Core(transport, options)
		try core.start(true)
		return new Association(core)
	}

	// accept waits for the peer to open an association over the transport.
	// Fails with SctpError when it does not within the connect timeout.
	def accept(transport net.DatagramTransport, options Options = Options{}) !Association {
		let core = new Core(transport, options)
		try core.start(false)
		return new Association(core)
	}
}
