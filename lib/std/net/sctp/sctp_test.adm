partial module std.net.sctp {
	use (
		std.testing
		std.net
		std.net.linktest::(LinkEnd, linkPair)
		std.net.sctp.wire::*
		std.time
	)

	// quick is options with timers short enough for a suite.
	internal def quick() Options {
		return Options{rtoInitial: 100ms, rtoMin: 50ms, rtoMax: 1s, connectTimeout: 5s}
	}

	// opened is an association on one end of a link, connecting or
	// accepting. Fails as `connect` and `accept` do.
	internal def opened(end LinkEnd, active bool) !?Association {
		return try connect(end, quick()) when active
		return try accept(end, quick())
	}

	internal def firstStream(association Association) !?Stream {
		return try association.acceptStream(10s)
	}

	// accepted waits for an association on one end of a link.
	internal async def accepted(end LinkEnd) ?Association {
		return opened(end, false) onerror recover none
	}

	// connected opens an association from one end of a link, as the other
	// side of a simultaneous open.
	internal async def connected(end LinkEnd) ?Association {
		return opened(end, true) onerror recover none
	}

	internal def acceptSlowly(end LinkEnd, options Options) !?Association {
		return try accept(end, options)
	}

	// acceptedSlowly waits for an association with the options given.
	internal async def acceptedSlowly(end LinkEnd, options Options) ?Association {
		return acceptSlowly(end, options) onerror recover none
	}

	// timedReceive is when the next message of a stream came, 0 when none
	// did.
	internal async def timedReceive(association Association, stream int) int {
		association.openStream(stream).receive(5s) onerror recover Message{stream: -1, data: []}
		return int(time.monoNs())
	}

	internal async def timedReceiveAny(association Association) int {
		association.receive(5s) onerror recover Message{stream: -1, data: []}
		return int(time.monoNs())
	}

	// sendOnceAnswered sends text on a stream that was reset, as soon as
	// the peer has answered the reset: until then the stream refuses.
	internal def sendOnceAnswered(stream Stream, text string) !none {
		for let refusals = 0; refusals < 5000; refusals++ {
			let sent = true
			stream.send(text.bytes()) onerror (err error) {
				sent = false
				recover none
			}
			return none when sent
			time.sleep(1ms)
		}
		fail "the reset was not answered"
	}

	// patterned is `size` bytes that depend on `seed` and their place.
	internal def patterned(size int, seed int) byte[] {
		let out byte[]
		out.len(size)
		for let i = 0; i < size; i++ {
			out[i] = byte((seed * 31 + i * 7) & 0xFF)
		}
		return out
	}

	// pair is two established associations over a link, the first having
	// connected and the second accepted.
	internal def pair(a LinkEnd, b LinkEnd, interleave bool = true) !(Association, Association) {
		let waiting = async accepted(b)
		let options = quick()
		options.interleaving = interleave
		let client = try connect(a, options)
		let server = await waiting
		fail "the accepting side did not establish" when server is none
		return (client, server)
	}

	// transfer sends `count` messages of growing size on a stream and
	// checks that they arrive whole and in order; returns the bytes moved.
	internal def transfer(from Association, to Association, stream int, count int, largest int) !int {
		let out = from.openStream(stream)
		let total = 0
		for let i = 0; i < count; i++ {
			let message = patterned(1 + (i * 977) % largest, i)
			try out.send(message)
			total += message.len()
		}
		let incoming = try to.acceptStream(5s)
		fail "the messages came on stream {incoming.id}" unless incoming.id == stream
		for let i = 0; i < count; i++ {
			let message = try incoming.receive(10s)
			fail "message {i} arrived changed or out of order ({message.data.len()} bytes)" unless message.data.equals(patterned(1 + (i * 977) % largest, i)) && message.protocol == int(PayloadProtocol.Binary)
		}
		return total
	}

	// bulk moves `megabytes` of 16 kB messages from one side to the other
	// over a link that drops every `dropEvery`-th datagram one way.
	internal def bulk(megabytes int, dropEvery int) !none {
		let (a, b) = linkPair()
		let (client, server) = try pair(a, b)
		a.dropEvery = dropEvery
		let out = client.openStream(0)
		let reading = async drained(server, megabytes * 64)
		let message = patterned(16384, 1)
		for let i = 0; i < megabytes * 64; i++ {
			try out.send(message)
		}
		let got = await reading
		fail "{got} of {megabytes * 64} messages arrived" unless got == megabytes * 64
		client.abort()
		return none
	}

	// drained reads `count` messages of the first stream the peer starts
	// and returns how many came.
	internal async def drained(association Association, count int) int {
		let stream = firstStream(association) onerror recover none
		return 0 when stream is none
		let got = 0
		for got < count {
			let failed = false
			stream.receive(10s) onerror (err error) {
				failed = true
				recover Message{stream: 0, data: []}
			}
			break when failed
			got++
		}
		return got
	}

	check "SCTP packets" {
		// A packet's chunks and parameters come back, its checksum holds
		// until a bit changes, and serial numbers compare across the wrap.
		@test()
		def packetsAndChunks() !none {
			let init = word(0x11223344) + word(131072) + half(10) + half(2048) + word(7) + parameter(paramForwardTSN, []) + parameter(paramSupportedExtensions, byte[chunkForwardTSN, chunkReconfig, chunkIData])
			let packet = packetBytes(5000, 5001, 0, chunkBytes(chunkInit, 0, init) + chunkBytes(chunkCookieAck, 0, []))
			assert packet.len() % 4 == 0 && get16(packet, 0) == 5000 && get16(packet, 2) == 5001 && checksumHolds(packet)
			assert int(packet[12]) == chunkInit && get16(packet, 14) == 4 + init.len() && int(packet[12 + 4 + init.len()]) == chunkCookieAck
			let parameters = parametersOf(init, 16)
			let extensions = parameters[1]
			assert parameters.len() == 2 && parameters[0].kind == paramForwardTSN && extensions.kind == paramSupportedExtensions && extensions.value.equals(byte[chunkForwardTSN, chunkReconfig, chunkIData])
			packet[20] = packet[20] ^ 1
			assert !checksumHolds(packet)

			return none
		}

		// The CRC32c of RFC 9260 Appendix A over a known packet: the bytes
		// "123456789" check to E3069283, written least significant byte
		// first.
		@test()
		def checksumBytes() {
			let packet = packetBytes(0, 0, 0, [])
			writeChecksum(packet)
			assert checksumHolds(packet) && packet.len() == 12
		}
	}

	internal def lossy(interleave bool) !none {
		let (a, b) = linkPair()
		let (client, server) = try pair(a, b, interleave)
		a.dropEvery = 7
		b.dropEvery = 5
		a.swapEvery = 4
		assert (try transfer(client, server, 3, 40, 9000)) > 100000
		client.abort()
		return none
	}

	internal def givenUp(interleave bool) !none {
		let (a, b) = linkPair()
		let (client, server) = try pair(a, b, interleave)
		let lossy = client.openStream(1)
		lossy.maxRetransmits = 0
		a.dropEvery = 7
		for let i = 0; i < 60; i++ {
			try lossy.send(patterned(2500, i))
			time.sleep(1ms)
		}
		a.dropEvery = 0
		lossy.maxRetransmits = none
		try lossy.send("end".bytes(), PayloadProtocol.String)
		let incoming = try server.acceptStream(5s)
		let got = 0
		let last = -1
		for {
			let message = try incoming.receive(5s)
			break when message.protocol == int(PayloadProtocol.String)
			let index = -1
			for let i = last + 1; i < 60 && index < 0; i++ {
				index = i when message.data.equals(patterned(2500, i))
			}
			assert index > last
			last = index
			got++
		}
		assert got > 0 && got < 60

		let timed = client.openStream(2)
		timed.maxLifetime = 30ms
		a.dropEvery = 1
		for let i = 0; i < 5; i++ {
			try timed.send(patterned(100, i))
		}
		time.sleep(150ms)
		a.dropEvery = 0
		timed.maxLifetime = none
		try timed.send("alive".bytes(), PayloadProtocol.String)
		let other = try server.acceptStream(5s)
		let first = try other.receive(5s)
		assert other.id == 2 && string(first.data) == "alive"
		client.abort()
		return none
	}

	check "SCTP associations" {
		// An association opens, carries messages both ways (small, cut
		// into many chunks, unordered, of every payload protocol), and
		// closes on both sides.
		@test()
		def openTransferClose() !none {
			let (a, b) = linkPair()
			let (client, server) = try pair(a, b, false)
			assert client.state() == AssociationState.Established && server.state() == AssociationState.Established
			assert (try transfer(client, server, 3, 40, 30000)) > 100000
			assert (try transfer(server, client, 4, 10, 5000)) > 0

			let text = server.openStream(9)
			text.ordered = false
			try text.send("hello".bytes(), PayloadProtocol.String)
			try text.send([0], PayloadProtocol.StringEmpty)
			let refused = false
			text.send([]) onerror (err error) {
				refused = err is SctpError
				recover none
			}
			assert refused
			let other = try client.acceptStream(5s)
			let first = try other.receive(5s)
			let second = try other.receive(5s)
			assert other.id == 9 && first.stream == 9
			// Unordered messages may swap; both arrive.
			let greeting = first.data.len() > 1 ?? (first, second)
			let blank = first.data.len() > 1 ?? (second, first)
			assert string(greeting.data) == "hello" && greeting.protocol == int(PayloadProtocol.String) && blank.protocol == int(PayloadProtocol.StringEmpty)

			let tooLong = false
			text.send(patterned(300000, 0)) onerror (err error) {
				tooLong = err is SctpError
				recover none
			}
			let nothing = false
			other.receive(100ms) onerror (err error) {
				nothing = err is net.NetError && err.kind == net.ErrorCode.TimedOut
				recover Message{stream: 0, data: []}
			}
			assert tooLong && nothing
			try client.close()
			for let i = 0; i < 100 && server.state() != AssociationState.Closed; i++ {
				time.sleep(10ms)
			}
			assert client.state() == AssociationState.Closed && server.state() == AssociationState.Closed
			let closed = false
			text.send("late".bytes()) onerror (err error) {
				closed = err is SctpError
				recover none
			}
			assert closed
			return none
		}

		// Both sides open at once, as WebRTC peers do, and meet in one
		// association.
		@test()
		def simultaneousOpen() !none {
			let (a, b) = linkPair()
			let other = async connected(b)
			let one = try connect(a, quick())
			let two = await other
			fail "the second side did not establish" when two is none
			assert one.state() == AssociationState.Established && two.state() == AssociationState.Established
			assert (try transfer(one, two, 3, 5, 3000)) > 0 && (try transfer(two, one, 4, 5, 3000)) > 0
			one.abort("done")
			for let i = 0; i < 100 && two.state() != AssociationState.Closed; i++ {
				time.sleep(10ms)
			}
			assert two.state() == AssociationState.Closed
			return none
		}

		// Messages arrive whole and in order over a link that loses every
		// seventh datagram one way and every fifth the other, and holds
		// back every fourth.
		@test()
		def lossAndReordering() !none {
			try lossy(true)
			return try lossy(false)
		}

		// A receive that waits before the send is woken by it, on its
		// stream and on the association: it returns well before the 200 ms
		// its wait would last by itself.
		@test()
		def receiveWakesAtOnce() !none {
			let (a, b) = linkPair()
			let (client, server) = try pair(a, b)
			let waiting = async timedReceive(server, 2)
			time.sleep(300ms)
			let sentAt = int(time.monoNs())
			try client.openStream(2).send("now".bytes())
			let gotAt = await waiting
			assert gotAt > 0 && gotAt - sentAt < 150000000
			let any = async timedReceiveAny(server)
			time.sleep(300ms)
			sentAt = int(time.monoNs())
			try client.openStream(8).send("again".bytes())
			gotAt = await any
			assert gotAt > 0 && gotAt - sentAt < 150000000
			client.abort()
			return none
		}

		// Messages that may not be sent again are given up when lost, and
		// the stream goes on in order behind them; messages that expire
		// while the link is down never arrive.
		@test()
		def partialReliability() !none {
			try givenUp(true)
			return try givenUp(false)
		}

		// A stream reset tells the peer behind what was sent, both ways,
		// and the stream is used again from the start.
		@test()
		def streamReset() !none {
			let (a, b) = linkPair()
			let (client, server) = try pair(a, b)
			let out = client.openStream(5)
			try out.send("one".bytes())
			try out.send("two".bytes())
			try out.reset()
			// Until the peer answers, the stream refuses to send; then a
			// message goes out with the stream's first number again. One
			// on another stream behind it shows when both have arrived.
			try sendOnceAnswered(out, "after")
			try client.openStream(6).send("behind".bytes())
			let behind = try server.openStream(6).receive(5s)
			assert string(behind.data) == "behind"
			// The reader is told of the reset where it happened: behind
			// the messages sent before it, before the one sent after,
			// though all three wait by now.
			let first = try server.receive(5s)
			let second = try server.receive(5s)
			assert first.stream == 5 && string(first.data) == "one" && string(second.data) == "two"
			let reset = -1
			server.receive(5s) onerror (err error) {
				reset = err.stream when err is SctpError && err.streamReset
				recover Message{stream: 0, data: []}
			}
			assert reset == 5
			let after = try server.receive(5s)
			assert after.stream == 5 && string(after.data) == "after"
			let back = server.openStream(5)
			try back.reset()
			let mirrored = false
			out.receive(5s) onerror (err error) {
				mirrored = err is SctpError && err.streamReset
				recover Message{stream: 0, data: []}
			}
			assert mirrored
			// The request was answered by now: the stream sends again.
			try out.send("three".bytes())
			let third = try server.receive(5s)
			assert third.stream == 5 && string(third.data) == "three"
			client.abort()
			return none
		}

		// Two resets of a stream with messages between and behind them,
		// read when all have arrived: each reset is told at its place.
		@test()
		def resetsKeepTheirPlaces() !none {
			let (a, b) = linkPair()
			let (client, server) = try pair(a, b)
			let out = client.openStream(5)
			try out.send("one".bytes())
			try out.reset()
			try sendOnceAnswered(out, "two")
			try out.reset()
			try sendOnceAnswered(out, "three")
			try client.openStream(6).send("behind".bytes())
			let behind = try server.openStream(6).receive(5s)
			assert string(behind.data) == "behind"
			let seen = ""
			for let i = 0; i < 5; i++ {
				let text = "reset"
				let message = server.receive(5s) onerror (err error) {
					fail err unless err is SctpError && err.streamReset && err.stream == 5
					recover Message{stream: -1, data: []}
				}
				text = string(message.data) when message.stream == 5
				seen = seen + text + " "
			}
			assert seen == "one reset two reset three "
			client.abort()
			return none
		}

		// With I-DATA a short message on one stream passes a long one on
		// another that was sent first; with DATA it waits behind it. Either
		// way both arrive whole.
		@test()
		def interleaving() !none {
			for let interleave in [true, false] {
				let (a, b) = linkPair()
				let (client, server) = try pair(a, b, interleave)
				let long = patterned(200000, 3)
				try client.openStream(1).send(long)
				try client.openStream(2).send("short".bytes())
				let first = try server.receive(5s)
				let second = try server.receive(5s)
				assert first.stream == (interleave ?? (2, 1)) && second.stream == (interleave ?? (1, 2))
				let whole = interleave ?? (second, first)
				assert whole.data.equals(long)
				client.abort()
			}
			return none
		}

		// The association finds the largest packet a path of 1333 bytes
		// passes, to within 16 bytes, and sends messages cut for it.
		@test()
		def pathMtu() !none {
			let (a, b) = linkPair()
			a.limit = 1333
			b.limit = 1333
			let waiting = async accepted(b)
			let options = Options{rtoInitial: 20ms, rtoMin: 10ms, rtoMax: 1s, connectTimeout: 5s, maxMtu: 1400}
			let client = try connect(a, options)
			let server = await waiting
			fail "the accepting side did not establish" when server is none
			// The search runs from the moment the association is up, so
			// where it stands by now depends on the machine: only its
			// end is asserted.
			for let i = 0; i < 2000 && client.mtu() < 1317; i++ {
				time.sleep(10ms)
			}
			assert client.mtu() >= 1317 && client.mtu() <= 1333 && server.mtu() == 1200
			assert (try transfer(client, server, 3, 10, 20000)) > 0
			client.abort()
			return none
		}

		// Nobody answers: the attempt gives up.
		@test()
		def nobodyThere() {
			let (a, _) = linkPair()
			let options = quick()
			options.connectTimeout = 300ms
			let refused = false
			connect(a, options) onerror (err error) {
				refused = err is SctpError
				recover new Association(new Core(a, options))
			}
			assert refused
		}

		// 4 MB in 16 kB messages over a clean link, and over one that loses
		// one datagram in a hundred or in twenty.
		// The end of a burst lost on a path with delay: the last chunks
		// have nothing behind them to make the peer report them missing.
		// A probe of the last chunk and the time of its acknowledgment
		// find them, so a message whose last three packets are lost
		// arrives long before the retransmission timer (one second here)
		// would have sent them again.
		@test()
		def tailLossIsFoundBeforeTheTimer() !none {
			let (a, b) = linkPair()
			a.delay = 10ms
			b.delay = 10ms
			let options = Options{connectTimeout: 5s}
			let waiting = acceptedSlowly(b, options)
			let near = try connect(a, options)
			let far = await waiting
			fail "the accepting side did not establish" when far is none
			let stream = near.openStream(1)
			// A round trip is measured first: the probe waits by it.
			try stream.send(patterned(3000, 1))
			let first = try far.receive(5s)
			assert first.data.len() == 3000
			time.sleep(300ms)
			// Twelve packets; the 10th to 12th this end sends are lost.
			let started = a.sent
			a.dropFrom = started + 10
			a.dropUntil = started + 12
			let began = time.monoNs()
			try stream.send(patterned(13000, 2))
			let whole = try far.receive(5s)
			let took = int(time.monoNs() - began) / 1000000
			fail "the message took {took} ms" unless whole.data.equals(patterned(13000, 2)) && took < 700
			near.abort()
			far.abort()
			return none
		}

		@benchmark()
		def BenchBulkClean() {
			bulk(4, 0) onerror recover none
		}

		@benchmark()
		def BenchBulkOnePercentLoss() {
			bulk(4, 100) onerror recover none
		}

		@benchmark()
		def BenchBulkFivePercentLoss() {
			bulk(4, 20) onerror recover none
		}
	}
}
