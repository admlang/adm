// The packets and chunks of SCTP (RFC 9260 §3) as the association reads
// and writes them.
internal partial module std.net.sctp.wire {
	use (
		std.crypto.hash::(crc32c)
		std.net.sctp::*
	)

	// The chunk types of RFC 9260 §3.2, RFC 3758 (FORWARD-TSN), RFC 6525
	// (RE-CONFIG), RFC 8260 (I-DATA, I-FORWARD-TSN) and RFC 4820 (PAD).
	const chunkData = 0
	const chunkInit = 1
	const chunkInitAck = 2
	const chunkSack = 3
	const chunkHeartbeat = 4
	const chunkHeartbeatAck = 5
	const chunkAbort = 6
	const chunkShutdown = 7
	const chunkShutdownAck = 8
	const chunkError = 9
	const chunkCookieEcho = 10
	const chunkCookieAck = 11
	const chunkShutdownComplete = 14
	const chunkIData = 64
	const chunkReconfig = 130
	const chunkPad = 132
	const chunkForwardTSN = 192
	const chunkIForwardTSN = 194

	// Parameters of INIT and INIT ACK (RFC 9260 §3.3.2, RFC 3758 §3.1,
	// RFC 5061 §4.2.7).
	const paramStateCookie = 7
	const paramUnrecognized = 8
	const paramForwardTSN = 0xC000
	const paramSupportedExtensions = 0x8008

	// Parameters of RE-CONFIG (RFC 6525 §4) and the results of a response
	// (§4.4).
	const paramOutgoingReset = 13
	const paramIncomingReset = 14
	const paramTSNReset = 15
	const paramReconfigResponse = 16
	const paramAddOutgoing = 17
	const paramAddIncoming = 18
	const resultPerformed = 1
	const resultDenied = 2
	const resultBadSequence = 5
	const resultInProgress = 6

	// The common header of a packet.
	const packetHeaderSize = 12
	// The header of a DATA chunk: the chunk header, TSN, stream, stream
	// sequence number and payload protocol.
	const dataHeaderSize = 16
	// The header of an I-DATA chunk: TSN, stream, reserved, message ID and
	// the payload protocol or fragment sequence number.
	const iDataHeaderSize = 20

	// Chunk is one chunk of a packet: its type, flags and value (the bytes
	// behind the four-byte chunk header, without padding).
	struct Chunk {
		kind  int
		flags int
		value byte[]
	}

	// get16 is the big-endian 16-bit number at an offset.
	def get16(data byte[], at int) int {
		return int(data[at]) << 8 | int(data[at + 1])
	}

	// get32 is the big-endian 32-bit number at an offset.
	def get32(data byte[], at int) int {
		return int(data[at]) << 24 | int(data[at + 1]) << 16 | int(data[at + 2]) << 8 | int(data[at + 3])
	}

	// put16 writes a 16-bit number big-endian at an offset.
	def put16(data byte[], at int, value int) {
		data[at] = byte((value >> 8) & 0xFF)
		data[at + 1] = byte(value & 0xFF)
	}

	// put32 writes a 32-bit number big-endian at an offset.
	def put32(data byte[], at int, value int) {
		data[at] = byte((value >> 24) & 0xFF)
		data[at + 1] = byte((value >> 16) & 0xFF)
		data[at + 2] = byte((value >> 8) & 0xFF)
		data[at + 3] = byte(value & 0xFF)
	}

	// word is a 32-bit number as four big-endian bytes.
	def word(value int) byte[] {
		return byte[byte((value >> 24) & 0xFF), byte((value >> 16) & 0xFF), byte((value >> 8) & 0xFF), byte(value & 0xFF)]
	}

	// half is a 16-bit number as two big-endian bytes.
	def half(value int) byte[] {
		return byte[byte((value >> 8) & 0xFF), byte(value & 0xFF)]
	}

	// sctpError is a failure of this module.
	def sctpError(message string) SctpError {
		return SctpError{message: "sctp: {message}"}
	}

	// chunkBytes is a chunk on the wire: type, flags, length and value,
	// padded with zeros to four bytes.
	def chunkBytes(kind int, flags int, value byte[]) byte[] {
		let out byte[]
		out.len((4 + value.len() + 3) / 4 * 4)
		out[0] = byte(kind)
		out[1] = byte(flags)
		put16(out, 2, 4 + value.len())
		value.copy(out[4:])
		return out
	}

	// parameter is a parameter or error cause on the wire: type, length
	// and value, padded to four bytes.
	def parameter(kind int, value byte[]) byte[] {
		let out byte[]
		out.len((4 + value.len() + 3) / 4 * 4)
		put16(out, 0, kind)
		put16(out, 2, 4 + value.len())
		value.copy(out[4:])
		return out
	}

	// packetBytes is a packet: the common header with the checksum over
	// the whole packet (CRC32c, RFC 9260 Appendix A, its least significant
	// byte first), then the chunks.
	def packetBytes(sourcePort int, destinationPort int, tag int, chunks byte[]) byte[] {
		let out byte[]
		out.len(packetHeaderSize + chunks.len())
		put16(out, 0, sourcePort)
		put16(out, 2, destinationPort)
		put32(out, 4, tag)
		chunks.copy(out[packetHeaderSize:])
		writeChecksum(out)
		return out
	}

	// writeChecksum puts the checksum of a packet into its header.
	def writeChecksum(packet byte[]) {
		for let i = 8; i < 12; i++ {
			packet[i] = 0
		}
		let sum = crc32c(packet)
		for let i = 0; i < 4; i++ {
			packet[8 + i] = byte((sum >> uint32(8 * i)) & uint32(0xFF))
		}
	}

	// checksumHolds reports whether a packet's checksum is right; the
	// packet is left as it was.
	def checksumHolds(packet byte[]) bool {
		let b0 = packet[8]
		let b1 = packet[9]
		let b2 = packet[10]
		let b3 = packet[11]
		writeChecksum(packet)
		let holds = packet[8] == b0 && packet[9] == b1 && packet[10] == b2 && packet[11] == b3
		packet[8] = b0
		packet[9] = b1
		packet[10] = b2
		packet[11] = b3
		return holds
	}

	// parametersOf is the parameters in the bytes from an offset on, as
	// chunks (type, no flags, value); one that runs past the end ends the
	// list.
	def parametersOf(data byte[], from int) Chunk[] {
		let out Chunk[]
		let at = from
		for at + 4 <= data.len() {
			let length = get16(data, at + 2)
			break when length < 4 || at + length > data.len()
			out.push(Chunk{kind: get16(data, at), flags: 0, value: data[at + 4:at + length]})
			at += (length + 3) / 4 * 4
		}
		return out
	}

	// serialBefore reports whether a serial number of the width a mask
	// gives (a stream sequence number, a message identifier; RFC 1982)
	// comes before another.
	def serialBefore(a int, b int, mask int) bool {
		let ahead = (b - a) & mask
		return ahead != 0 && ahead <= mask >> 1
	}
}
