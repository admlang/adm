// SDP (RFC 8866): session descriptions as offers and answers carry them,
// with the attributes of WebRTC (RFC 8839 ICE, RFC 8122 fingerprints,
// RFC 4145 setup, RFC 8285 header extensions, RFC 4585 feedback, RFC 5576
// sources, RFC 8851 and 8853 simulcast, RFC 8841 SCTP, RFC 9143 BUNDLE).
//
//     let offer = try sdp.parse(text)
//     for let media in offer.media {
//         println("{media.media} mid {media.mid()} {media.direction()}")
//     }
//     let answerText = answer.str()
partial module std.net.sdp {
	use (
		std.errors
		std.net
		std.net.sdp.wire::*
	)

	// SdpError is the payload of a description that does not parse: the
	// reason and the line it is about, counted from 1 (0 when no line is).
	struct SdpError {
		message string
		code    string            = "sdp"
		cause   ?error
		stack   errors.StackTrace
		line    int               = 0
	}

	// MediaKind names the media types of RFC 8866 §8.2.1; Other is one this
	// module does not name, whose token `MediaDescription.media` holds.
	enum MediaKind {
		Audio,
		Video,
		Text,
		Application,
		Message,
		Image,
		Other
	}

	// Direction is which way media flows (RFC 8866 §6.7).
	enum Direction {
		SendRecv,
		SendOnly,
		RecvOnly,
		Inactive
	}

	// Setup is the role in opening the DTLS (or TCP) connection (RFC 4145
	// §4, RFC 8842).
	enum Setup {
		Active,
		Passive,
		ActPass,
		HoldConn
	}

	// CandidateType is the kind of an ICE candidate (RFC 8839 §5.1).
	enum CandidateType {
		Host,
		ServerReflexive,
		PeerReflexive,
		Relay
	}

	// CandidateTransport is the transport of an ICE candidate.
	enum CandidateTransport {
		UDP,
		TCP
	}

	// Attribute is one "a=" line: `name` alone for a property attribute
	// ("a=rtcp-mux", `flag` set), or `name:value`.
	struct Attribute {
		name  string
		value string = ""
		flag  bool   = false
	}

	// Origin is the "o=" line: who made the session and its version
	// (RFC 8866 §5.2). The ID and version are numeric strings.
	struct Origin {
		username       string = "-"
		sessionID      string = "0"
		sessionVersion string = "0"
		netType        string = "IN"
		addrType       string = "IP4"
		address        string = "0.0.0.0"
	}

	// Connection is a "c=" line (RFC 8866 §5.7): the address, and for
	// multicast its TTL and the number of addresses (0 when not given).
	struct Connection {
		netType  string = "IN"
		addrType string = "IP4"
		address  string = "0.0.0.0"
		ttl      int    = 0
		count    int    = 0
	}

	// Bandwidth is a "b=" line: a modifier (AS, TIAS, CT, RR, RS) and its
	// value.
	struct Bandwidth {
		kind  string
		value int
	}

	// Timing is a "t=" line with the "r=" lines that follow it: start and
	// stop in NTP seconds, 0 for unbounded.
	struct Timing {
		start   int      = 0
		stop    int      = 0
		repeats string[] = []
	}

	// RtpMap is "a=rtpmap": a payload type's encoding name, clock rate and
	// channels (0 when not given).
	struct RtpMap {
		payloadType int
		encoding    string
		clockRate   int
		channels    int    = 0
	}

	// FormatParameters is "a=fmtp": the parameters of a payload type as
	// written, "name=value" pairs separated by ";" for most codecs.
	struct FormatParameters {
		payloadType int
		parameters  string
	}

	// RtcpFeedback is "a=rtcp-fb" (RFC 4585 §4.2): a feedback kind ("nack",
	// "ccm", "transport-cc", "goog-remb") with its parameter ("pli",
	// "fir"), for a payload type or all of them (-1).
	struct RtcpFeedback {
		payloadType int    = -1
		kind        string
		parameter   string = ""
	}

	// Extension is "a=extmap" (RFC 8285): the ID a header extension goes by,
	// its URI, the direction when one is given ("sendonly"), and the
	// extension's own attributes.
	struct Extension {
		id         int
		uri        string
		direction  string = ""
		attributes string = ""
	}

	// SourceAttribute is "a=ssrc" (RFC 5576): one attribute of a
	// synchronization source ("cname", "msid").
	struct SourceAttribute {
		ssrc  int
		name  string
		value string = ""
	}

	// SourceGroup is "a=ssrc-group": sources that belong together ("FID"
	// a stream and its retransmissions, "SIM" simulcast, "FEC-FR").
	struct SourceGroup {
		semantics string
		ssrcs     int[]
	}

	// Group is "a=group" (RFC 5888): media sections that belong together,
	// by their mids ("BUNDLE" on one transport, "LS" lip sync).
	struct Group {
		semantics string
		mids      string[]
	}

	// Fingerprint is "a=fingerprint" (RFC 8122): the hash of a certificate
	// under a hash function ("sha-256").
	struct Fingerprint {
		algorithm string
		digest    byte[]
	}

	// Candidate is "a=candidate" (RFC 8839 §5.1): one ICE candidate. The
	// address may be a name (mDNS). `related` is the base of a reflexive or
	// relayed candidate; `tcpType` is "active", "passive" or "so" for a TCP
	// one; `extensions` holds the rest as name, value pairs in order
	// ("generation", "ufrag", "network-cost").
	struct Candidate {
		foundation  string
		componentID int                = 1
		transport   CandidateTransport = CandidateTransport.UDP
		priority    int
		address     net.Address
		kind        CandidateType      = CandidateType.Host
		related     ?net.Address       = none
		tcpType     string             = ""
		extensions  string[]           = []
	}

	// Rid is "a=rid" (RFC 8851): an RTP stream of a media section by its
	// identifier, its direction ("send" or "recv"), the payload types it
	// is restricted to and its restrictions as written ("max-width=1280").
	struct Rid {
		id           string
		direction    string
		formats      int[]  = []
		restrictions string = ""
	}

	// SimulcastStream is one simulcast stream: the rids that may stand for
	// it, in preference order, each paused or not (RFC 8853 §5.1).
	struct SimulcastStream {
		rids   string[]
		paused bool[]
	}

	// Simulcast is "a=simulcast": the streams sent and those received.
	struct Simulcast {
		send SimulcastStream[] = []
		recv SimulcastStream[] = []
	}

	// Msid is "a=msid" (RFC 8830): the MediaStream and track a media
	// section belongs to.
	struct Msid {
		stream string
		track  string = ""
	}

	// TransportParameters is what a media section's transport runs on, the
	// media section's own attributes before the session's (RFC 8839 §5.4,
	// RFC 8122 §5): the ICE credentials and options, the certificate
	// fingerprints and the setup role (none when not given).
	struct TransportParameters {
		ufrag        string        = ""
		password     string        = ""
		options      string[]      = []
		fingerprints Fingerprint[] = []
		setup        ?Setup        = none
	}

	// MediaDescription is one "m=" section (RFC 8866 §5.14): the media
	// type, the port and how many, the transport protocol, the formats
	// (payload types for RTP, "webrtc-datachannel" for SCTP), and the lines
	// under it.
	type MediaDescription {
		media       string       = "audio"
		port        int          = 9
		portCount   int          = 0
		protocol    string       = "UDP/TLS/RTP/SAVPF"
		formats     string[]     = []
		information string       = ""
		connections Connection[] = []
		bandwidths  Bandwidth[]  = []
		key         string       = ""
		attributes  Attribute[]  = []

		def new(media string = "audio", protocol string = "UDP/TLS/RTP/SAVPF") {
			self.media = media
			self.protocol = protocol
		}

		// kind is the media type as an enum, Other for a token this module
		// does not name.
		def kind() MediaKind {
			return mediaKindOf(media)
		}

		// get is the value of the first attribute of the name, none when
		// there is none; "" for a property attribute.
		def get(name string) ?string {
			return valueOf(attributes, name)
		}

		// all is the values of every attribute of the name, in order.
		def all(name string) string[] {
			return valuesOf(attributes, name)
		}

		// has reports whether an attribute of the name is present.
		def has(name string) bool {
			return !(valueOf(attributes, name) is none)
		}

		// add appends a property attribute ("rtcp-mux").
		def add(name string) {
			attributes.push(Attribute{name: name, flag: true})
		}

		// add appends an attribute with a value.
		def add(name string, value string) {
			attributes.push(Attribute{name: name, value: value})
		}

		// add appends "a=rtpmap".
		def add(map RtpMap) {
			add("rtpmap", formatRtpMap(map))
		}

		// add appends "a=fmtp".
		def add(parameters FormatParameters) {
			add("fmtp", "{parameters.payloadType} {parameters.parameters}")
		}

		// add appends "a=rtcp-fb".
		def add(feedback RtcpFeedback) {
			add("rtcp-fb", formatFeedback(feedback))
		}

		// add appends "a=extmap".
		def add(extension Extension) {
			add("extmap", formatExtension(extension))
		}

		// add appends "a=ssrc".
		def add(source SourceAttribute) {
			add("ssrc", source.value == "" ?? ("{source.ssrc} {source.name}", "{source.ssrc} {source.name}:{source.value}"))
		}

		// add appends "a=ssrc-group".
		def add(group SourceGroup) {
			add("ssrc-group", group.semantics + " " + joinNumbers(group.ssrcs, " "))
		}

		// add appends "a=fingerprint".
		def add(fingerprint Fingerprint) {
			add("fingerprint", formatFingerprint(fingerprint))
		}

		// add appends "a=candidate".
		def add(candidate Candidate) {
			add("candidate", formatCandidate(candidate))
		}

		// add appends "a=rid".
		def add(rid Rid) {
			add("rid", formatRid(rid))
		}

		// add appends "a=simulcast".
		def add(simulcast Simulcast) {
			add("simulcast", formatSimulcast(simulcast))
		}

		// add appends "a=msid".
		def add(msid Msid) {
			add("msid", msid.track == "" ?? (msid.stream, "{msid.stream} {msid.track}"))
		}

		// set replaces the direction attribute.
		def set(direction Direction) {
			attributes = attributes.filter(a => !isDirection(a.name))
			add(directionName(direction))
		}

		// set replaces "a=setup".
		def set(setup Setup) {
			attributes = attributes.filter(a => a.name != "setup")
			add("setup", setupName(setup))
		}

		// remove drops every attribute of the name.
		def remove(name string) {
			attributes = attributes.filter(a => a.name != name)
		}

		// mid is the media section's identifier ("a=mid"), "" without one.
		def mid() string {
			let value = get("mid")
			return value is none ?? ("", value)
		}

		// direction is the direction attribute of the section, none when it
		// has none (the session's applies, else sendrecv).
		def direction() ?Direction {
			for let a in attributes {
				continue unless a.flag && isDirection(a.name)
				return directionOf(a.name)
			}
			return none
		}

		// rtpMaps is the "a=rtpmap" lines that parse, in order.
		def rtpMaps() RtpMap[] {
			let out RtpMap[]
			for let value in all("rtpmap") {
				let map = parseRtpMap(value)
				out.push(map) unless map is none
			}
			return out
		}

		// formatParameters is the "a=fmtp" line of a payload type, none
		// without one.
		def formatParameters(payloadType int) ?FormatParameters {
			for let value in all("fmtp") {
				let (head, rest) = splitToken(value)
				return FormatParameters{payloadType: payloadType, parameters: rest} when head == "{payloadType}"
			}
			return none
		}

		// formatParameter is one "name=value" parameter of a payload
		// type's "a=fmtp" line ("apt", "profile-level-id"), none when absent.
		def formatParameter(payloadType int, name string) ?string {
			let found = formatParameters(payloadType)
			return none when found is none
			for let part in found.parameters.split(";") {
				let pair = part.trim()
				let at = pair.indexOf("=")
				continue when at < 0
				return pair[at + 1:] when pair[:at].trim() == name
			}
			return none
		}

		// rtcpFeedback is the "a=rtcp-fb" lines that parse, in order.
		def rtcpFeedback() RtcpFeedback[] {
			let out RtcpFeedback[]
			for let value in all("rtcp-fb") {
				let feedback = parseFeedback(value)
				out.push(feedback) unless feedback is none
			}
			return out
		}

		// extensions is the "a=extmap" lines that parse, in order.
		def extensions() Extension[] {
			let out Extension[]
			for let value in all("extmap") {
				let extension = parseExtension(value)
				out.push(extension) unless extension is none
			}
			return out
		}

		// sources is the "a=ssrc" lines that parse, in order.
		def sources() SourceAttribute[] {
			let out SourceAttribute[]
			for let value in all("ssrc") {
				let source = parseSource(value)
				out.push(source) unless source is none
			}
			return out
		}

		// sourceGroups is the "a=ssrc-group" lines that parse, in order.
		def sourceGroups() SourceGroup[] {
			let out SourceGroup[]
			for let value in all("ssrc-group") {
				let group = parseSourceGroup(value)
				out.push(group) unless group is none
			}
			return out
		}

		// candidates is the "a=candidate" lines that parse, in order.
		def candidates() Candidate[] {
			let out Candidate[]
			for let value in all("candidate") {
				let candidate = parseCandidateValue(value)
				out.push(candidate) unless candidate is none
			}
			return out
		}

		// rids is the "a=rid" lines that parse, in order.
		def rids() Rid[] {
			let out Rid[]
			for let value in all("rid") {
				let rid = parseRid(value)
				out.push(rid) unless rid is none
			}
			return out
		}

		// simulcast is the "a=simulcast" line, none without one that
		// parses.
		def simulcast() ?Simulcast {
			let value = get("simulcast")
			return none when value is none
			return parseSimulcast(value)
		}

		// msids is the "a=msid" lines, in order.
		def msids() Msid[] {
			let out Msid[]
			for let value in all("msid") {
				let (stream, track) = splitToken(value)
				out.push(Msid{stream: stream, track: track})
			}
			return out
		}

		// sctpPort is "a=sctp-port" (RFC 8841), 0 without one.
		def sctpPort() int {
			return numberOf(get("sctp-port"))
		}

		// maxMessageSize is "a=max-message-size" (RFC 8841), 0 without one
		// (the default of 64 kB applies).
		def maxMessageSize() int {
			return numberOf(get("max-message-size"))
		}
	}

	// SessionDescription is a whole description (RFC 8866 §5): the session
	// lines and the media sections in order.
	type SessionDescription {
		version     int                = 0
		origin      Origin
		name        string             = "-"
		information string             = ""
		uri         string             = ""
		emails      string[]           = []
		phones      string[]           = []
		connection  ?Connection        = none
		bandwidths  Bandwidth[]        = []
		timings     Timing[]           = []
		zones       string             = ""
		key         string             = ""
		attributes  Attribute[]        = []
		media       MediaDescription[] = []

		def new() {}

		// str is the description as text: the lines in the order RFC 8866
		// §5 gives, each ended with CRLF.
		def str() string {
			return formatSession(self)
		}

		// get is the value of the first session attribute of the name, none
		// when there is none; "" for a property attribute.
		def get(name string) ?string {
			return valueOf(attributes, name)
		}

		// all is the values of every session attribute of the name.
		def all(name string) string[] {
			return valuesOf(attributes, name)
		}

		// has reports whether a session attribute of the name is present.
		def has(name string) bool {
			return !(valueOf(attributes, name) is none)
		}

		// add appends a session property attribute ("ice-lite").
		def add(name string) {
			attributes.push(Attribute{name: name, flag: true})
		}

		// add appends a session attribute with a value.
		def add(name string, value string) {
			attributes.push(Attribute{name: name, value: value})
		}

		// add appends "a=group".
		def add(group Group) {
			add("group", group.mids.len() == 0 ?? (group.semantics, group.semantics + " " + group.mids.join(" ")))
		}

		// add appends a session-level "a=fingerprint".
		def add(fingerprint Fingerprint) {
			add("fingerprint", formatFingerprint(fingerprint))
		}

		// remove drops every session attribute of the name.
		def remove(name string) {
			attributes = attributes.filter(a => a.name != name)
		}

		// groups is the "a=group" lines, in order.
		def groups() Group[] {
			let out Group[]
			for let value in all("group") {
				let tokens = value.split(" ").filter(t => t != "")
				continue when tokens.len() == 0
				out.push(Group{semantics: tokens[0], mids: tokens[1:].clone()})
			}
			return out
		}

		// bundle is the mids of the first BUNDLE group, empty without one.
		def bundle() string[] {
			for let group in groups() {
				return group.mids when group.semantics == "BUNDLE"
			}
			return []
		}

		// direction is the direction that applies to a media section: its
		// own, else the session's, else sendrecv (RFC 8866 §6.7).
		def direction(section MediaDescription) Direction {
			let own = section.direction()
			return own unless own is none
			for let a in attributes {
				continue unless a.flag && isDirection(a.name)
				return directionOf(a.name)
			}
			return Direction.SendRecv
		}

		// transport is the ICE and DTLS parameters that apply to a media
		// section: its own attributes, else the session's.
		def transport(section MediaDescription) TransportParameters {
			return transportOf(section.attributes, attributes)
		}

		// find is the media section with the mid, none without one.
		def find(mid string) ?MediaDescription {
			for let section in media {
				return section when section.mid() == mid
			}
			return none
		}
	}

	// parse reads a session description. Lines end with CRLF or LF. Fails
	// with SdpError naming the line: a line that is not "x=value", a type
	// letter RFC 8866 does not define, a session without "v=", "o=" and
	// "s=" in front, a malformed "o=", "c=", "b=", "t=" or "m=" line. An
	// attribute this module has no reader for is kept as it is.
	def parse(text string) !SessionDescription {
		return try parseSession(text)
	}

	// parseCandidate reads an ICE candidate as trickled outside a
	// description (RFC 8840): "candidate:..." with or without "a=" in
	// front. Fails with SdpError when it is malformed.
	def parseCandidate(text string) !Candidate {
		let value = text.trim()
		value = value[2:] when value.startsWith("a=")
		value = value[10:] when value.startsWith("candidate:")
		let candidate = parseCandidateValue(value)
		fail SdpError{message: "sdp: malformed candidate {text}"} when candidate is none
		return candidate
	}

	// candidateText is an ICE candidate as trickled: "candidate:...".
	def candidateText(candidate Candidate) string {
		return "candidate:" + formatCandidate(candidate)
	}
}
