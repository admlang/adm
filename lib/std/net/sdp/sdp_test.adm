		"m=application 9 UDP/DTLS/SCTP webrtc-datachannel\r\n" +
		"c=IN IP4 0.0.0.0\r\n" +
		"a=candidate:2924330333 1 udp 2113937151 4be4ab0e-a464-478a-b810-a38168b64233.local 49187 typ host generation 0 network-cost 999\r\n" +
		"a=ice-ufrag:GCx4\r\n" +
		"a=ice-pwd:8FHwqWTiDACW6s0+hets2KkM\r\n" +
		"a=ice-options:trickle\r\n" +
		"a=fingerprint:sha-256 D8:2C:16:3E:A5:37:F6:69:91:81:FB:52:9F:DB:87:E7:1B:F5:20:96:AC:3F:BD:40:18:AE:E3:71:E2:A1:A5:FB\r\n" +
		"a=setup:actpass\r\n" +
		"a=mid:2\r\n" +
		"a=sctp-port:5000\r\n" +
		"a=max-message-size:262144\r\n"

	// The example of RFC 8866 §5.
	internal const rfcExample =
		"v=0\r\n" +
		"o=jdoe 3724394400 3724394405 IN IP4 198.51.100.1\r\n" +
		"s=Call to John Smith\r\n" +
		"i=SDP Offer #1\r\n" +
		"u=http://www.jdoe.example.com/home.html\r\n" +
		"e=Jane Doe <jane@jdoe.example.com>\r\n" +
		"p=+1 617 555-6011\r\n" +
		"c=IN IP4 198.51.100.1\r\n" +
		"t=0 0\r\n" +
		"m=audio 49170 RTP/AVP 0\r\n" +
		"m=audio 49180 RTP/AVP 0\r\n" +
		"m=video 51372 RTP/AVP 99\r\n" +
		"c=IN IP6 2001:db8::2\r\n" +
		"a=rtpmap:99 h263-1998/90000\r\n"

	// lineOf is the line a text fails to parse at, 0 when it parses.
	internal def lineOf(text string) int {
		let line = 0
		parse(text) onerror (err error) {
			line = err is SdpError ?? (err.line, -1)
			recover new SessionDescription()
		}
		return line
	}

	check "SDP" {
		// Chrome's offer comes back byte for byte, and its sections read as
		// what they are.
		@test()
		def chromeOfferRoundTrip() !none {
			let offer = try parse(chromeOffer)
			assert offer.str() == chromeOffer
			assert offer.origin.username == "-" && offer.origin.sessionVersion == "2" && offer.name == "-"
			assert offer.bundle().equals(["0", "1", "2"]) && offer.media.len() == 3
			let bundle = offer.groups()[0]
			assert bundle.semantics == "BUNDLE" && bundle.mids.len() == 3 && !(offer.get("group") is none)
			assert offer.has("extmap-allow-mixed") && offer.all("msid-semantic").equals([" WMS"])

			let audio = offer.media[0]
			assert audio.kind() == MediaKind.Audio && audio.port == 9 && audio.protocol == "UDP/TLS/RTP/SAVPF" && audio.mid() == "0"
			assert offer.direction(audio) == Direction.SendRecv && audio.has("rtcp-mux")
			let opus = audio.rtpMaps()[0]
			assert opus.payloadType == 111 && opus.encoding == "opus" && opus.clockRate == 48000 && opus.channels == 2
			let inband = audio.formatParameter(111, "useinbandfec")
			fail "opus has no useinbandfec" when inband is none
			assert inband == "1" && audio.formatParameter(111, "nothing") is none
			let red = audio.formatParameters(63)
			fail "red has no fmtp" when red is none
			assert red.parameters == "111/111" && audio.formatParameters(9) is none && audio.get("nothing") is none
			let level = audio.extensions()[0]
			assert level.id == 1 && level.uri == "urn:ietf:params:rtp-hdrext:ssrc-audio-level"
			let cname = audio.sources()[0]
			assert cname.name == "cname" && cname.value.len() > 0 && cname.ssrc > 0

			let transport = offer.transport(audio)
			assert transport.ufrag.len() == 4 && transport.password.len() >= 22 && transport.options.equals(["trickle"])
			assert transport.fingerprints.len() == 1 && transport.fingerprints[0].algorithm == "sha-256" && transport.fingerprints[0].digest.len() == 32
			let setup = transport.setup
			fail "no setup role" when setup is none
			assert setup == Setup.ActPass
			let candidate = audio.candidates()[0]
			assert candidate.kind == CandidateType.Host && candidate.transport == CandidateTransport.UDP && candidate.componentID == 1
			assert candidate.address.host.endsWith(".local") && candidate.address.port > 0 && candidate.extensions[0] == "generation"

			let video = offer.media[1]
			assert video.kind() == MediaKind.Video && video.mid() == "1"
			let vp8 = video.rtpMaps()[0]
			assert vp8.encoding == "VP8" && vp8.clockRate == 90000 && vp8.channels == 0
			let apt = video.formatParameter(97, "apt")
			fail "rtx has no apt" when apt is none
			assert apt == "96"
			let feedback = video.rtcpFeedback().filter(f => f.payloadType == 96)
			assert feedback.len() == 5 && feedback[4].kind == "nack" && feedback[4].parameter == "pli"
			let rids = video.rids()
			assert rids.len() == 3 && rids[0].id == "h" && rids[0].direction == "send"
			let simulcast = video.simulcast()
			fail "no simulcast" when simulcast is none
			let low = simulcast.send[2]
			assert simulcast.send.len() == 3 && low.rids.equals(["l"]) && !low.paused[0] && simulcast.recv.len() == 0

			let data = offer.media[2]
			assert data.kind() == MediaKind.Application && data.protocol == "UDP/DTLS/SCTP" && data.formats.equals(["webrtc-datachannel"])
			assert data.sctpPort() == 5000 && data.maxMessageSize() == 262144 && data.direction() is none
			let found = offer.find("2")
			fail "no section with mid 2" when found is none
			assert found.media == "application" && offer.find("9") is none
			return none
		}

		// The example of RFC 8866 comes back as written; LF line ends parse
		// too.
		@test()
		def sessionLines() !none {
			let session = try parse(rfcExample)
			assert session.str() == rfcExample
			assert session.origin.username == "jdoe" && session.information == "SDP Offer #1" && session.emails.len() == 1 && session.phones.len() == 1
			let connection = session.connection
			fail "no session connection" when connection is none
			assert connection.address == "198.51.100.1" && session.media[2].connections[0].addrType == "IP6"
			assert session.media[0].formats.equals(["0"]) && session.media[2].rtpMaps()[0].encoding == "h263-1998"
			assert (try parse(rfcExample.replace("\r\n", "\n"))).str() == rfcExample

			let timed = try parse("v=0\no=- 1 1 IN IP4 0.0.0.0\ns=x\nb=AS:512\nt=3034423619 3042462419\nr=604800 3600 0 90000\nz=2882844526 -1h\nk=prompt\nm=audio 49170/2 RTP/AVP 0\ni=left and right\nc=IN IP4 233.252.0.1/127/3\nb=TIAS:64000\na=sendonly\n")
			let timing = timed.timings[0]
			assert timing.start == 3034423619 && timing.repeats.equals(["604800 3600 0 90000"]) && timed.bandwidths[0].value == 512
			let section = timed.media[0]
			assert section.portCount == 2 && section.connections[0].ttl == 127 && section.connections[0].count == 3 && section.information == "left and right"
			let direction = section.direction()
			fail "no direction" when direction is none
			assert direction == Direction.SendOnly && timed.direction(section) == Direction.SendOnly
			assert (try parse(timed.str())).str() == timed.str()
			return none
		}

		// A description built attribute by attribute reads back the same.
		@test()
		def builtDescription() !none {
			let answer = new SessionDescription()
			answer.origin = Origin{sessionID: "42", sessionVersion: "1", address: "127.0.0.1"}
			answer.add(Group{semantics: "BUNDLE", mids: ["0"]})
			answer.add("ice-lite")
			let video = new MediaDescription("video")
			video.formats = ["96", "97"]
			video.connections = [Connection{}]
			video.add("mid", "0")
			video.add("ice-ufrag", "abcd")
			video.add("ice-pwd", "0123456789012345678901")
			video.add(Fingerprint{algorithm: "sha-256", digest: byte[0xAB, 0x01, 0xFF]})
			video.set(Setup.Active)
			video.set(Direction.SendOnly)
			video.set(Direction.RecvOnly)
			video.add("rtcp-mux")
			video.add(RtpMap{payloadType: 96, encoding: "VP8", clockRate: 90000})
			video.add(RtcpFeedback{payloadType: 96, kind: "nack", parameter: "pli"})
			video.add(RtcpFeedback{kind: "transport-cc"})
			video.add(RtpMap{payloadType: 97, encoding: "rtx", clockRate: 90000})
			video.add(FormatParameters{payloadType: 97, parameters: "apt=96"})
			video.add(Extension{id: 3, uri: "urn:example:ext", direction: "recvonly"})
			video.add(SourceGroup{semantics: "FID", ssrcs: [11, 12]})
			video.add(SourceAttribute{ssrc: 11, name: "cname", value: "me"})
			video.add(Msid{stream: "s", track: "t"})
			video.add(Rid{id: "hi", direction: "recv", formats: [96], restrictions: "max-width=1280"})
			video.add(Simulcast{recv: [SimulcastStream{rids: ["hi", "lo"], paused: [false, true]}]})
			let relay = try parseCandidate("candidate:7 1 UDP 5000 203.0.113.9 3478 typ relay raddr 192.0.2.1 rport 50000 generation 0")
			video.add(relay)
			answer.media.push(video)

			let back = try parse(answer.str())
			assert back.str() == answer.str() && back.has("ice-lite") && back.bundle().equals(["0"])
			let section = back.media[0]
			let direction = section.direction()
			fail "no direction" when direction is none
			assert direction == Direction.RecvOnly && section.all("recvonly").len() == 1 && !section.has("sendonly")
			let transport = back.transport(section)
			let print = transport.fingerprints[0]
			assert transport.ufrag == "abcd" && print.digest.equals(byte[0xAB, 0x01, 0xFF])
			assert section.all("fingerprint").equals(["sha-256 AB:01:FF"])
			let feedback = section.rtcpFeedback()
			assert feedback[0].parameter == "pli" && feedback[1].payloadType == -1 && feedback[1].kind == "transport-cc"
			let extension = section.extensions()[0]
			let group = section.sourceGroups()[0]
			assert extension.direction == "recvonly" && group.ssrcs.equals([11, 12])
			let source = section.sources()[0]
			let msid = section.msids()[0]
			assert source.value == "me" && msid.track == "t"
			let rid = section.rids()[0]
			assert rid.formats.equals([96]) && rid.restrictions == "max-width=1280"
			let simulcast = section.simulcast()
			fail "no simulcast" when simulcast is none
			let stream = simulcast.recv[0]
			assert stream.rids.equals(["hi", "lo"]) && stream.paused[1] && !stream.paused[0]
			let candidate = section.candidates()[0]
			let related = candidate.related
			fail "no related address" when related is none
			assert candidate.kind == CandidateType.Relay && candidate.priority == 5000 && related.str() == "192.0.2.1:50000"
			assert candidateText(candidate) == "candidate:7 1 udp 5000 203.0.113.9 3478 typ relay raddr 192.0.2.1 rport 50000 generation 0"
			let passive = try parseCandidate("a=candidate:1 1 TCP 100 2001:db8::1 9 typ host tcptype passive")
			assert passive.transport == CandidateTransport.TCP && passive.tcpType == "passive" && passive.address.isIPv6
			section.remove("rid")
			assert section.rids().len() == 0
			return none
		}

		// What does not parse fails at its line.
		@test()
		def malformedLines() {
			assert lineOf(rfcExample) == 0
			assert lineOf("") == 0 && lineOf("v=0\n") == 1
			assert lineOf("o=- 1 1 IN IP4 0.0.0.0\n") == 1
			assert lineOf("v=1\n") == 1
			assert lineOf("v=0\ns=x\n") == 2
			assert lineOf("v=0\no=- 1 1 IN IP4\ns=x\n") == 2
			assert lineOf("v=0\no=- one 1 IN IP4 0.0.0.0\ns=x\n") == 2
			assert lineOf("v=0\no=- 1 1 IN IP4 0.0.0.0\ns=x\nq=what\n") == 4
			assert lineOf("v=0\no=- 1 1 IN IP4 0.0.0.0\ns=x\nbroken\n") == 4
			assert lineOf("v=0\no=- 1 1 IN IP4 0.0.0.0\ns=x\nt=0\n") == 4
			assert lineOf("v=0\no=- 1 1 IN IP4 0.0.0.0\ns=x\nm=audio x RTP/AVP 0\n") == 4
			assert lineOf("v=0\no=- 1 1 IN IP4 0.0.0.0\ns=x\nm=audio 9 RTP/AVP 0\nt=0 0\n") == 5
			assert lineOf("v=0\no=- 1 1 IN IP4 0.0.0.0\ns=x\nc=IN IP4\n") == 4
			assert lineOf("v=0\no=- 1 1 IN IP4 0.0.0.0\ns=x\nb=AS\n") == 4
			let malformed = false
			parseCandidate("candidate:1 1 udp x 192.0.2.1 9 typ host") onerror (err error) {
				malformed = err is SdpError
				recover Candidate{foundation: "", priority: 0, address: new net.Address()}
			}
			assert malformed
		}

		// Parses Chrome's offer; `adm test std/net/sdp --release --bench .`
		// gives the time and allocations of one parse.
		@benchmark()
		def BenchParseChromeOffer() {
			parse(chromeOffer) onerror recover new SessionDescription()
		}

		// Parses Chrome's offer and writes it out again: the cost of `str`
		// is this less BenchParseChromeOffer.
		@benchmark()
		def BenchRoundTripChromeOffer() {
			let offer = parse(chromeOffer) onerror recover new SessionDescription()
			offer.str()
		}
	}
}
