partial module std.net.sdp {
	use (
		std.testing
		std.net
		std.net.sdp.wire::*
	)

	// An offer of Chrome 154 on Linux (createOffer with an audio and a
	// simulcast video transceiver and a data channel, after ICE gathering),
	// as RTCPeerConnection.localDescription.sdp gave it.
	internal const chromeOffer =
		"v=0\r\n" +
		"o=- 592953642034198416 2 IN IP4 127.0.0.1\r\n" +
		"s=-\r\n" +
		"t=0 0\r\n" +
