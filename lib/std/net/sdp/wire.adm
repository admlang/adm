// The line scanner of std.net.sdp and the codecs of its attribute values.
internal partial module std.net.sdp.wire {
	use (
		std.data.encoding::(hexdecode)
		std.net
		std.net.sdp::*
	)

	// mediaKindOf is a media token as an enum.
	def mediaKindOf(media string) MediaKind {
		switch {
			case media == "audio":
				return MediaKind.Audio
			case media == "video":
				return MediaKind.Video
			case media == "text":
				return MediaKind.Text
			case media == "application":
				return MediaKind.Application
			case media == "message":
				return MediaKind.Message
			case media == "image":
				return MediaKind.Image
		}
		return MediaKind.Other
	}

	// valueOf is the value of the first attribute of the name, none when
	// there is none.
	def valueOf(attributes Attribute[], name string) ?string {
		for let a in attributes {
			return a.value when a.name == name
		}
		return none
	}

	// valuesOf is the values of every attribute of the name, in order.
	def valuesOf(attributes Attribute[], name string) string[] {
		let out string[]
		for let a in attributes {
			out.push(a.value) when a.name == name
		}
		return out
	}

	// isDirection reports whether an attribute name is a direction.
	def isDirection(name string) bool {
		return name := "sendrecv" || "sendonly" || "recvonly" || "inactive"
	}

	// directionOf is the direction an attribute name stands for.
	def directionOf(name string) Direction {
		return Direction.SendOnly when name == "sendonly"
		return Direction.RecvOnly when name == "recvonly"
		return Direction.Inactive when name == "inactive"
		return Direction.SendRecv
	}

	// directionName is a direction as its attribute name.
	def directionName(direction Direction) string {
		return "sendonly" when direction == Direction.SendOnly
		return "recvonly" when direction == Direction.RecvOnly
		return "inactive" when direction == Direction.Inactive
		return "sendrecv"
	}

	// setupName is a setup role as the value of "a=setup".
	def setupName(setup Setup) string {
		return "active" when setup == Setup.Active
		return "passive" when setup == Setup.Passive
		return "holdconn" when setup == Setup.HoldConn
		return "actpass"
	}

	// setupOf is the setup role a value of "a=setup" names, none for
	// another.
	def setupOf(value string) ?Setup {
		return Setup.Active when value == "active"
		return Setup.Passive when value == "passive"
		return Setup.ActPass when value == "actpass"
		return Setup.HoldConn when value == "holdconn"
		return none
	}

	// splitToken is the first space-separated token of a value and the
	// rest, without the spaces between; "" when there is no rest.
	def splitToken(value string) (string, string) {
		let text = value.trim()
		let at = text.indexOf(" ")
		return (text, "") when at < 0
		return (text[:at], text[at + 1:].trim())
	}

	// number is a text of digits as an integer, none for anything else.
	def number(text string) ?int {
		return none unless text.len() > 0 && text.len() <= 18 && text.isNumeric()
		return text.toInt<int>()
	}

	// numberOf is an attribute value as an integer, 0 when it is absent or
	// no number.
	def numberOf(value ?string) int {
		return 0 when value is none
		let n = number(value.trim())
		return n is none ?? (0, n)
	}

	// tokens is the space-separated tokens of a value.
	def tokens(value string) string[] {
		return value.split(" ").filter(t => t != "")
	}

	// joinNumbers is integers as text with a separator between.
	def joinNumbers(values int[], separator string) string {
		let parts string[]
		for let value in values {
			parts.push("{value}")
		}
		return parts.join(separator)
	}

	def parseRtpMap(value string) ?RtpMap {
		let (head, rest) = splitToken(value)
		let payloadType = number(head)
		let parts = rest.split("/")
		return none when payloadType is none || parts.len() < 2
		let rate = number(parts[1])
		return none when rate is none
		let channels = parts.len() > 2 ?? (numberOf(parts[2]), 0)
		return RtpMap{payloadType: payloadType, encoding: parts[0], clockRate: rate, channels: channels}
	}

	def formatRtpMap(map RtpMap) string {
		let text = "{map.payloadType} {map.encoding}/{map.clockRate}"
		return map.channels > 0 ?? ("{text}/{map.channels}", text)
	}

	def parseFeedback(value string) ?RtcpFeedback {
		let (head, rest) = splitToken(value)
		let (kind, parameter) = splitToken(rest)
		return none when kind == ""
		return RtcpFeedback{payloadType: -1, kind: kind, parameter: parameter} when head == "*"
		let payloadType = number(head)
		return none when payloadType is none
		return RtcpFeedback{payloadType: payloadType, kind: kind, parameter: parameter}
	}

	def formatFeedback(feedback RtcpFeedback) string {
		let head = feedback.payloadType < 0 ?? ("*", "{feedback.payloadType}")
		return feedback.parameter == "" ?? ("{head} {feedback.kind}", "{head} {feedback.kind} {feedback.parameter}")
	}

	def parseExtension(value string) ?Extension {
		let (head, rest) = splitToken(value)
		let (uri, attributes) = splitToken(rest)
		let slash = head.indexOf("/")
		let id = number(slash < 0 ?? (head, head[:slash]))
		return none when id is none || uri == ""
		return Extension{id: id, uri: uri, direction: slash < 0 ?? ("", head[slash + 1:]), attributes: attributes}
	}

	def formatExtension(extension Extension) string {
		let head = extension.direction == "" ?? ("{extension.id}", "{extension.id}/{extension.direction}")
		return extension.attributes == "" ?? ("{head} {extension.uri}", "{head} {extension.uri} {extension.attributes}")
	}

	def parseSource(value string) ?SourceAttribute {
		let (head, rest) = splitToken(value)
		let ssrc = number(head)
		return none when ssrc is none || rest == ""
		let colon = rest.indexOf(":")
		return SourceAttribute{ssrc: ssrc, name: rest} when colon < 0
		return SourceAttribute{ssrc: ssrc, name: rest[:colon], value: rest[colon + 1:]}
	}

	def parseSourceGroup(value string) ?SourceGroup {
		let parts = tokens(value)
		return none when parts.len() < 2
		let ssrcs int[]
		for let part in parts[1:] {
			let ssrc = number(part)
			return none when ssrc is none
			ssrcs.push(ssrc)
		}
		return SourceGroup{semantics: parts[0], ssrcs: ssrcs}
	}

	def parseFingerprint(value string) ?Fingerprint {
		let (algorithm, hex) = splitToken(value)
		let digest = hexdecode(hex.replace(":", "")) onerror recover []
		return none when algorithm == "" || digest.len() == 0
		return Fingerprint{algorithm: algorithm.lower(), digest: digest}
	}

	def formatFingerprint(fingerprint Fingerprint) string {
		let pairs string[]
		for let i = 0; i < fingerprint.digest.len(); i++ {
			pairs.push(fingerprint.digest[i:i + 1].hex())
		}
		return fingerprint.algorithm + " " + pairs.join(":")
	}

	def candidateTypeOf(text string) ?CandidateType {
		return CandidateType.Host when text == "host"
		return CandidateType.ServerReflexive when text == "srflx"
		return CandidateType.PeerReflexive when text == "prflx"
		return CandidateType.Relay when text == "relay"
		return none
	}

	def candidateTypeName(kind CandidateType) string {
		return "srflx" when kind == CandidateType.ServerReflexive
		return "prflx" when kind == CandidateType.PeerReflexive
		return "relay" when kind == CandidateType.Relay
		return "host"
	}

	// addressOf is a candidate's connection address and port as an
	// address; the host may be a name.
	def addressOf(host string, port int) net.Address {
		let address = new net.Address()
		address.host = host
		address.port = port
		address.isIPv6 = host.contains(":")
		address.raw = address.str()
		return address
	}

	// parseCandidateValue reads the value of "a=candidate" (RFC 8839
	// §5.1), none when it is malformed.
	def parseCandidateValue(value string) ?Candidate {
		let parts = tokens(value)
		return none when parts.len() < 8 || parts[6] != "typ"
		let componentID = number(parts[1])
		let priority = number(parts[3])
		let port = number(parts[5])
		let kind = candidateTypeOf(parts[7])
		let transport = parts[2].lower()
		return none when componentID is none || priority is none || port is none || kind is none || !(transport := "udp" || "tcp")
		let candidate = Candidate{foundation: parts[0], componentID: componentID, transport: transport == "tcp" ?? (CandidateTransport.TCP, CandidateTransport.UDP), priority: priority, address: addressOf(parts[4], port), kind: kind}
		let relatedHost = ""
		let relatedPort = -1
		for let i = 8; i + 1 < parts.len(); i += 2 {
			let name = parts[i]
			let text = parts[i + 1]
			switch {
				case name == "raddr":
					relatedHost = text
				case name == "rport":
					relatedPort = numberOf(text)
				case name == "tcptype":
					candidate.tcpType = text
				default:
					candidate.extensions.push(name, text)
			}
		}
		candidate.related = addressOf(relatedHost, relatedPort.max(0)) when relatedHost != ""
		return candidate
	}

	def formatCandidate(candidate Candidate) string {
		let parts = [candidate.foundation, "{candidate.componentID}", candidate.transport == CandidateTransport.TCP ?? ("tcp", "udp"), "{candidate.priority}", candidate.address.host, "{candidate.address.port}", "typ", candidateTypeName(candidate.kind)]
		let related = candidate.related
		parts.push("raddr", related.host, "rport", "{related.port}") unless related is none
		parts.push("tcptype", candidate.tcpType) when candidate.tcpType != ""
		for let extension in candidate.extensions {
			parts.push(extension)
		}
		return parts.join(" ")
	}

	def parseRid(value string) ?Rid {
		let (id, rest) = splitToken(value)
		let (direction, parameters) = splitToken(rest)
		return none when id == "" || !(direction := "send" || "recv")
		let rid = Rid{id: id, direction: direction}
		let restrictions string[]
		for let part in parameters.split(";") {
			let item = part.trim()
			continue when item == ""
			if item.startsWith("pt=") {
				for let pt in item[3:].split(",") {
					let payloadType = number(pt.trim())
					rid.formats.push(payloadType) unless payloadType is none
				}
				continue
			}
			restrictions.push(item)
		}
		rid.restrictions = restrictions.join(";")
		return rid
	}

	def formatRid(rid Rid) string {
		let parameters string[]
		parameters.push("pt=" + joinNumbers(rid.formats, ",")) when rid.formats.len() > 0
		parameters.push(rid.restrictions) when rid.restrictions != ""
		let head = "{rid.id} {rid.direction}"
		return parameters.len() == 0 ?? (head, head + " " + parameters.join(";"))
	}

	def parseStreams(list string) SimulcastStream[] {
		let out SimulcastStream[]
		for let entry in list.split(";") {
			let stream = SimulcastStream{rids: [], paused: []}
			for let alternative in entry.split(",") {
				let rid = alternative.trim()
				continue when rid := "" || "~"
				stream.paused.push(rid.startsWith("~"))
				stream.rids.push(rid.startsWith("~") ?? (rid[1:], rid))
			}
			out.push(stream) when stream.rids.len() > 0
		}
		return out
	}

	def formatStreams(streams SimulcastStream[]) string {
		let entries string[]
		for let stream in streams {
			let alternatives string[]
			for let (i, rid) in stream.rids {
				alternatives.push(i < stream.paused.len() && stream.paused[i] ?? ("~" + rid, rid))
			}
			entries.push(alternatives.join(","))
		}
		return entries.join(";")
	}

	def parseSimulcast(value string) ?Simulcast {
		let parts = tokens(value)
		let simulcast = Simulcast{}
		for let i = 0; i + 1 < parts.len(); i += 2 {
			return none unless parts[i] := "send" || "recv"
			if parts[i] == "send" {
				simulcast.send = parseStreams(parts[i + 1])
			} else {
				simulcast.recv = parseStreams(parts[i + 1])
			}
		}
		return none when simulcast.send.len() == 0 && simulcast.recv.len() == 0
		return simulcast
	}

	def formatSimulcast(simulcast Simulcast) string {
		let parts string[]
		parts.push("send", formatStreams(simulcast.send)) when simulcast.send.len() > 0
		parts.push("recv", formatStreams(simulcast.recv)) when simulcast.recv.len() > 0
		return parts.join(" ")
	}

	// transportOf is the ICE and DTLS parameters of a media section: each
	// from the section's attributes when it has them, else the session's.
	def transportOf(section Attribute[], session Attribute[]) TransportParameters {
		let out = TransportParameters{}
		let ufrag = valueOf(section, "ice-ufrag")
		ufrag = valueOf(session, "ice-ufrag") when ufrag is none
		out.ufrag = ufrag unless ufrag is none
		let password = valueOf(section, "ice-pwd")
		password = valueOf(session, "ice-pwd") when password is none
		out.password = password unless password is none
		let options = valueOf(section, "ice-options")
		options = valueOf(session, "ice-options") when options is none
		out.options = tokens(options) unless options is none
		let prints = valuesOf(section, "fingerprint")
		prints = valuesOf(session, "fingerprint") when prints.len() == 0
		for let value in prints {
			let fingerprint = parseFingerprint(value)
			out.fingerprints.push(fingerprint) unless fingerprint is none
		}
		let setup = valueOf(section, "setup")
		setup = valueOf(session, "setup") when setup is none
		out.setup = setupOf(setup) unless setup is none
		return out
	}

	def malformed(line int, message string) SdpError {
		return SdpError{message: "sdp: line {line}: {message}", line: line}
	}

	// attributeOf is the attribute in the bytes from `start` up to `stop`:
	// a name alone, or a name and the value behind its first colon.
	def attributeOf(data byte[], start int, stop int) Attribute {
		for let at = start; at < stop; at++ {
			return Attribute{name: string(data[start:at]), value: string(data[at + 1:stop])} when data[at] == 58
		}
		return Attribute{name: string(data[start:stop]), flag: true}
	}

	def parseConnection(value string, line int) !Connection {
		let parts = tokens(value)
		fail malformed(line, "c= needs a network type, an address type and an address") unless parts.len() == 3
		let pieces = parts[2].split("/")
		let connection = Connection{netType: parts[0], addrType: parts[1], address: pieces[0]}
		if parts[1] == "IP4" {
			connection.ttl = numberOf(pieces[1]) when pieces.len() > 1
			connection.count = numberOf(pieces[2]) when pieces.len() > 2
		} else {
			connection.count = numberOf(pieces[1]) when pieces.len() > 1
		}
		return connection
	}

	def formatConnection(connection Connection) string {
		let address = connection.address
		address = "{address}/{connection.ttl}" when connection.ttl > 0 && connection.addrType == "IP4"
		address = "{address}/{connection.count}" when connection.count > 0
		return "{connection.netType} {connection.addrType} {address}"
	}

	def parseBandwidth(value string, line int) !Bandwidth {
		let colon = value.indexOf(":")
		let amount = colon < 0 ?? (none, number(value[colon + 1:].trim()))
		fail malformed(line, "b= needs a modifier and a number") when amount is none
		return Bandwidth{kind: value[:colon], value: amount}
	}

	def parseMedia(value string, line int) !MediaDescription {
		let parts = tokens(value)
		fail malformed(line, "m= needs a media type, a port and a protocol") when parts.len() < 3
		let section = new MediaDescription(parts[0], parts[2])
		let slash = parts[1].indexOf("/")
		let port = number(slash < 0 ?? (parts[1], parts[1][:slash]))
		fail malformed(line, "m= port {parts[1]}") when port is none || port > 65535
		section.port = port
		section.portCount = numberOf(parts[1][slash + 1:]) when slash >= 0
		section.formats = parts[3:].clone()
		return section
	}

	// parseSession reads a description in one pass over its bytes. Fails
	// with SdpError as `parse` says.
	def parseSession(text string) !SessionDescription {
		let data = text.bytes()
		let session = new SessionDescription()
		let current ?MediaDescription = none
		let line = 0
		let at = 0
		for at < data.len() {
			let end = at
			for end < data.len() && data[end] != 10 {
				end++
			}
			let stop = end > at && data[end - 1] == 13 ?? (end - 1, end)
			let start = at
			at = end + 1
			continue when stop == start
			line++
			fail malformed(line, "not a type letter, \"=\" and a value") when stop - start < 2 || data[start + 1] != 61
			let kind = char(data[start])
			let value = kind == 'a' ?? ("", string(data[start + 2:stop]))
			fail malformed(line, "a description starts with v=0") when line == 1 && (kind != 'v' || value != "0")
			fail malformed(line, "o= follows v=") when line == 2 && kind != 'o'
			fail malformed(line, "s= follows o=") when line == 3 && kind != 's'
			let section = current
			switch {
				case kind == 'a':
					let attribute = attributeOf(data, start + 2, stop)
					if section is none {
						session.attributes.push(attribute)
					} else {
						section.attributes.push(attribute)
					}
				case kind == 'm':
					let next = try parseMedia(value, line)
					session.media.push(next)
					current = next
				case kind == 'c':
					let connection = try parseConnection(value, line)
					if section is none {
						session.connection = connection
					} else {
						section.connections.push(connection)
					}
				case kind == 'b':
					let bandwidth = try parseBandwidth(value, line)
					if section is none {
						session.bandwidths.push(bandwidth)
					} else {
						section.bandwidths.push(bandwidth)
					}
				case kind == 'i':
					if section is none {
						session.information = value
					} else {
						section.information = value
					}
				case kind == 'k':
					if section is none {
						session.key = value
					} else {
						section.key = value
					}
				case !(section is none):
					fail malformed(line, "{kind}= does not belong in a media section")
				case kind == 'v':
					fail malformed(line, "a second v=") when line != 1
				case kind == 'o':
					let parts = tokens(value)
					fail malformed(line, "o= needs six fields") unless parts.len() == 6
					fail malformed(line, "o= session ID and version are numbers") unless parts[1].isNumeric() && parts[2].isNumeric()
					session.origin = Origin{username: parts[0], sessionID: parts[1], sessionVersion: parts[2], netType: parts[3], addrType: parts[4], address: parts[5]}
				case kind == 's':
					session.name = value
				case kind == 'u':
					session.uri = value
				case kind == 'e':
					session.emails.push(value)
				case kind == 'p':
					session.phones.push(value)
				case kind == 't':
					let parts = tokens(value)
					let from = parts.len() == 2 ?? (number(parts[0]), none)
					let to = parts.len() == 2 ?? (number(parts[1]), none)
					fail malformed(line, "t= needs a start and a stop time") when from is none || to is none
					session.timings.push(Timing{start: from, stop: to})
				case kind == 'r':
					fail malformed(line, "r= without a t= before it") when session.timings.len() == 0
					session.timings[session.timings.len() - 1].repeats.push(value)
				case kind == 'z':
					session.zones = value
				default:
					fail malformed(line, "unknown type letter {kind}")
			}
		}
		fail malformed(line, "a description needs v=, o= and s=") when line < 3
		return session
	}

	// formatSession is a description as text, lines ended with CRLF.
	def formatSession(session SessionDescription) string {
		let lines string[]
		let origin = session.origin
		lines.push("v={session.version}", "o={origin.username} {origin.sessionID} {origin.sessionVersion} {origin.netType} {origin.addrType} {origin.address}", "s={session.name}")
		lines.push("i=" + session.information) when session.information != ""
		lines.push("u=" + session.uri) when session.uri != ""
		for let email in session.emails {
			lines.push("e=" + email)
		}
		for let phone in session.phones {
			lines.push("p=" + phone)
		}
		let connection = session.connection
		lines.push("c=" + formatConnection(connection)) unless connection is none
		for let bandwidth in session.bandwidths {
			lines.push("b={bandwidth.kind}:{bandwidth.value}")
		}
		lines.push("t=0 0") when session.timings.len() == 0
		for let timing in session.timings {
			lines.push("t={timing.start} {timing.stop}")
			for let repeat in timing.repeats {
				lines.push("r=" + repeat)
			}
		}
		lines.push("z=" + session.zones) when session.zones != ""
		lines.push("k=" + session.key) when session.key != ""
		pushAttributes(lines, session.attributes)
		for let section in session.media {
			let port = section.portCount > 0 ?? ("{section.port}/{section.portCount}", "{section.port}")
			let head = "m={section.media} {port} {section.protocol}"
			lines.push(section.formats.len() == 0 ?? (head, head + " " + section.formats.join(" ")))
			lines.push("i=" + section.information) when section.information != ""
			for let own in section.connections {
				lines.push("c=" + formatConnection(own))
			}
			for let bandwidth in section.bandwidths {
				lines.push("b={bandwidth.kind}:{bandwidth.value}")
			}
			lines.push("k=" + section.key) when section.key != ""
			pushAttributes(lines, section.attributes)
		}
		return lines.join("\r\n") + "\r\n"
	}

	def pushAttributes(lines string[], attributes Attribute[]) {
		for let a in attributes {
			lines.push(a.flag ?? ("a=" + a.name, "a={a.name}:{a.value}"))
		}
	}
}
