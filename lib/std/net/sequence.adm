// Sequence number bookkeeping shared by the protocols of std.net that
// number their packets (DTLS records, SRTP packets, the RTP jitter buffer).
internal std.net partial module std.net.sequence {
	// ReplayWindow remembers which of the 64 newest sequence numbers were
	// taken (RFC 6347 §4.1.2.6, RFC 3711 §3.3.2): one taken again, or one
	// older than the window, is a replay.
	type ReplayWindow {
		// The newest number taken, -1 before the first.
		highest int    = -1
		// Bit n is the number `highest - n`.
		taken   uint64 = 0

		def new() {}

		// seen reports whether a number was taken already or lies below the
		// window.
		def seen(seq int) bool {
			return false when seq > highest
			let back = highest - seq
			return true when back >= 64
			return ((taken >> uint64(back)) & uint64(1)) == uint64(1)
		}

		// mark takes a number.
		def mark(seq int) {
			if seq > highest {
				let shift = seq - highest
				taken = shift >= 64 ?? (uint64(0), taken << uint64(shift))
				taken = taken | uint64(1)
				highest = seq
				return
			}
			taken = taken | (uint64(1) << uint64(highest - seq))
		}
	}

	// expand is the full number nearest to `expected` whose low `bits` bits
	// are `low`: how a sequence number or timestamp sent in a few bits is
	// taken back to its full width (RFC 9147 §4.2.2, RFC 3711 §3.3.1).
	def expand(expected int, low int, bits int) int {
		let span = 1 << bits
		let candidate = expected - expected % span + low
		return candidate + span when candidate + span / 2 < expected
		return candidate - span when candidate - span / 2 > expected && candidate >= span
		return candidate
	}

	// Ranges is a set of ranges of numbers (bytes of a message, sequence
	// numbers above a point), kept sorted and merged, so it stays as small
	// as the gaps are few.
	type Ranges {
		// start, end pairs (end exclusive), increasing, no two touching.
		bounds int[] = []

		def new() {}

		// add puts the bytes from start up to end into the set.
		def add(start int, end int) {
			return when end <= start
			let lo = start
			let hi = end
			let merged int[]
			let placed = false
			for let i = 0; i < bounds.len(); i += 2 {
				let s = bounds[i]
				let e = bounds[i + 1]
				if e < lo {
					merged.push(s, e)
					continue
				}
				if s > hi {
					if !placed {
						merged.push(lo, hi)
						placed = true
					}
					merged.push(s, e)
					continue
				}
				lo = s when s < lo
				hi = e when e > hi
			}
			merged.push(lo, hi) unless placed
			bounds = merged
		}

		// dropBelow takes every number below `limit` out of the set.
		def dropBelow(limit int) {
			let kept int[]
			for let i = 0; i < bounds.len(); i += 2 {
				continue when bounds[i + 1] <= limit
				kept.push(bounds[i].max(limit), bounds[i + 1])
			}
			bounds = kept
		}

		// holds reports whether a number is in the set.
		def holds(value int) bool {
			for let i = 0; i < bounds.len(); i += 2 {
				return true when value >= bounds[i] && value < bounds[i + 1]
			}
			return false
		}

		// isEmpty reports whether the set holds nothing.
		def isEmpty() bool {
			return bounds.len() == 0
		}

		// reach is how many bytes from 0 the set holds without a gap.
		def reach() int {
			return 0 when bounds.len() == 0 || bounds[0] != 0
			return bounds[1]
		}

		// gaps is the ranges of 0 up to length the set lacks, as start, end
		// pairs.
		def gaps(length int) int[] {
			let out int[]
			let at = 0
			for let i = 0; i < bounds.len() && at < length; i += 2 {
				out.push(at, bounds[i]) when bounds[i] > at
				at = bounds[i + 1]
			}
			out.push(at, length) when at < length
			return out
		}
	}

	// RoundTrip estimates a retransmission timeout from measured round
	// trips (RFC 6298 §2): the smoothed round trip plus four times its
	// variance (no less than `granularity`), kept between `minimum` and
	// `maximum`. Times are in nanoseconds.
	type RoundTrip {
		initial     int
		minimum     int
		maximum     int
		granularity int = 0
		srtt        int = 0
		rttvar      int = 0
		// The timeout to use now.
		rto         int

		def new(initial int, minimum int, maximum int) {
			self.initial = initial
			self.minimum = minimum
			self.maximum = maximum
			rto = initial
		}

		// measure folds one round trip in. A retransmitted exchange must
		// not be measured (Karn's algorithm): its answer may belong to
		// either send.
		def measure(rtt int) {
			if srtt == 0 {
				srtt = rtt
				rttvar = rtt / 2
			} else {
				rttvar = (3 * rttvar + (srtt - rtt).abs()) / 4
				srtt = (7 * srtt + rtt) / 8
			}
			rto = (srtt + (4 * rttvar).max(granularity)).max(minimum).min(maximum)
		}

		// backoff doubles the timeout after one expired, up to the maximum.
		def backoff() {
			rto = (rto * 2).min(maximum)
		}

		// settle takes the doubling of `backoff` back: the timeout is what
		// the measurements say again. For when the peer answers again.
		def settle() {
			rto = srtt == 0 ?? (initial, (srtt + (4 * rttvar).max(granularity)).max(minimum).min(maximum))
		}

		// reset forgets the estimate: the timeout is the initial one again.
		def reset() {
			srtt = 0
			rttvar = 0
			rto = initial
		}
	}
}
