internal partial module std.net.sftp.proto {
	use (
		std.fs
		std.net.sftp::(SftpError)
		std.net.sshwire::*
		std.time
		std.time::(Time)
	)

	// SFTP version 3 (draft-ietf-secsh-filexfer-02), the version OpenSSH
	// speaks, and the OpenSSH extensions (PROTOCOL in its source tree).

	const (
		fxpInit          = 1
		fxpVersion       = 2
		fxpOpen          = 3
		fxpClose         = 4
		fxpRead          = 5
		fxpWrite         = 6
		fxpLstat         = 7
		fxpFstat         = 8
		fxpSetstat       = 9
		fxpFsetstat      = 10
		fxpOpendir       = 11
		fxpReaddir       = 12
		fxpRemove        = 13
		fxpMkdir         = 14
		fxpRmdir         = 15
		fxpRealpath      = 16
		fxpStat          = 17
		fxpRename        = 18
		fxpReadlink      = 19
		fxpSymlink       = 20
		fxpStatus        = 101
		fxpHandle        = 102
		fxpData          = 103
		fxpName          = 104
		fxpAttrs         = 105
		fxpExtended      = 200
		fxpExtendedReply = 201
	)

	// Status codes.
	const (
		fxOk               = 0
		fxEof              = 1
		fxNoSuchFile       = 2
		fxPermissionDenied = 3
		fxFailure          = 4
		fxBadMessage       = 5
		fxOpUnsupported    = 8
	)

	// Open flags.
	const (
		openRead   = 1
		openWrite  = 2
		openAppend = 4
		openCreate = 8
		openTrunc  = 16
		openExcl   = 32
	)

	// Attribute flags.
	const (
		attrSize        = 1
		attrUidGid      = 2
		attrPermissions = 4
		attrTimes       = 8
		attrExtended    = 2147483648
	)

	// File type bits of the permissions field.
	const (
		typeMask = 0o170000
		typeDir  = 0o040000
		typeFile = 0o100000
		typeLink = 0o120000
	)

	// Attrs is the ATTRS of version 3: each field present when its flag
	// is set.
	struct Attrs {
		flags       int64 = 0
		size        int64 = 0
		uid         int64 = 0
		gid         int64 = 0
		permissions int64 = 0
		atime       int64 = 0
		mtime       int64 = 0
	}

	def readAttrs(r Reader) !Attrs {
		let a = Attrs{}
		a.flags = try r.readUint32()
		a.size = int64(try r.readUint64()) when (a.flags & attrSize) != 0
		if (a.flags & attrUidGid) != 0 {
			a.uid = try r.readUint32()
			a.gid = try r.readUint32()
		}
		a.permissions = try r.readUint32() when (a.flags & attrPermissions) != 0
		if (a.flags & attrTimes) != 0 {
			a.atime = try r.readUint32()
			a.mtime = try r.readUint32()
		}
		if (a.flags & attrExtended) != 0 {
			let count = try r.readUint32()
			for let i = int64(0); i < count; i++ {
				try r.readString()
				try r.readString()
			}
		}
		return a
	}

	def writeAttrs(w Writer, a Attrs) {
		let flags = a.flags & (attrSize | attrUidGid | attrPermissions | attrTimes)
		w.putUint32(flags)
		w.putUint64(uint64(a.size)) when (flags & attrSize) != 0
		if (flags & attrUidGid) != 0 {
			w.putUint32(a.uid)
			w.putUint32(a.gid)
		}
		w.putUint32(a.permissions) when (flags & attrPermissions) != 0
		if (flags & attrTimes) != 0 {
			w.putUint32(a.atime)
			w.putUint32(a.mtime)
		}
	}

	// The FileEntry a name and its attributes describe.
	def entryOf(name string, path string, a Attrs) fs.FileEntry {
		let e = fs.FileEntry{name: name, path: path}
		let kind = a.permissions & typeMask
		e.kind = kind == typeDir ?? (fs.FileKind.Dir, kind == typeLink ?? (fs.FileKind.Link, fs.FileKind.File))
		e.size = e.kind == fs.FileKind.Dir ?? (int64(0), a.size)
		e.mode = int(a.permissions & 0o7777)
		e.modified = timeOf(a.mtime) when (a.flags & attrTimes) != 0
		return e
	}

	// The attributes of a FileEntry: size, type and permission bits,
	// times when the entry has one.
	def attrsOf(e fs.FileEntry) Attrs {
		let a = Attrs{flags: attrSize | attrPermissions}
		a.size = e.size
		let kind = e.kind == fs.FileKind.Dir ?? (typeDir, e.kind == fs.FileKind.Link ?? (typeLink, typeFile))
		let mode = e.mode != 0 ?? (e.mode, e.kind == fs.FileKind.Dir ?? (0o755, 0o644))
		a.permissions = int64(kind | mode)
		let seconds = e.modified.unixNs() / 1000000000
		if seconds > 0 {
			a.flags = a.flags | attrTimes
			a.atime = seconds
			a.mtime = seconds
		}
		return a
	}

	// The `ls -l` line OpenSSH's server sends as a long name.
	def longName(e fs.FileEntry) string {
		return fs.longListing(e, "owner", "group")
	}

	// The SftpError of a STATUS reply.
	def statusError(code int, message string, op string) error {
		let kind = code == fxNoSuchFile ?? ("not-found", code == fxPermissionDenied ?? ("denied", code == fxOpUnsupported ?? ("unsupported", code == fxEof ?? ("eof", "failure"))))
		let text = message == "" ?? (statusText(code), message)
		return SftpError{message: "sftp: {op}: {text}", code: kind, status: code}
	}

	def statusText(code int) string {
		return "no such file" when code == fxNoSuchFile
		return "permission denied" when code == fxPermissionDenied
		return "operation not supported" when code == fxOpUnsupported
		return "end of file" when code == fxEof
		return "bad message" when code == fxBadMessage
		return "failure"
	}

	// The time an SFTP mtime stands for.
	def timeOf(seconds int64) Time {
		return time.fromUnixNs(seconds * 1000000000)
	}
}
