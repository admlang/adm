partial module std.net.sftp {
	use (
		std.fs
		std.net
		std.net.sftp.proto::*
		std.net.ssh
	)

	// Server serves an `fs.FileStore` over SFTP, rooted at `/`, which is
	// also each user's home directory. It is an `ssh.Handler`: add it to
	// an `ssh.Server`'s `subsystems["sftp"]`, or run it on its own with
	// `start`/`listenAndServe`, which make that SSH server from
	// `hostKeys` and `authenticator`. Symbolic links are not served.
	//
	// ```
	// let files = new sftp.Server(new fs.DiskStore("/srv/files"), ":2222")
	// files.hostKeys.push(try ssh.loadKey("/etc/myapp/host_key"))
	// let users = new ssh.Users()
	// users.add("alice", "s3cret")
	// files.authenticator = users
	// try files.listenAndServe()
	// ```
	type Server {
		store         fs.FileStore
		// Refuse every change.
		readOnly      bool                        = false
		// The store of each user; none serves `store` to everyone.
		storeFor      ?def (string) !fs.FileStore = none
		// On its own: where to listen, the host keys, who may log in.
		addr          string                      = ":22"
		hostKeys      ssh.PrivateKey[]            = []
		authenticator ?ssh.Authenticator          = none
		internal ssh  ?ssh.Server                 = none

		def new(store fs.FileStore, addr string = ":22") {
			self.store = store
			self.addr = addr
		}

		// Implements ssh.Handler: answers one SFTP session. Fails when
		// the stream breaks or the client does not speak SFTP.
		def serve(session ssh.Session) !none {
			let chosen = try storeOf(session.user())
			let s = new ServerSession(session, chosen, readOnly)
			return try s.run()
		}

		internal def storeOf(user string) !fs.FileStore {
			let pick = storeFor
			return store when pick is none
			return try pick(user)
		}

		// Binds `addr` and serves SFTP until `close`. Fails as
		// `ssh.Server.listenAndServe` does.
		def listenAndServe() !none {
			return try sshServer().listenAndServe()
		}

		// Binds and serves in the background. Fails as `ssh.Server.start`
		// does.
		def start() !none {
			return try sshServer().start()
		}

		// Stops serving and ends every session. Never fails.
		def close() !none {
			let s = ssh
			if !(s is none) {
				s.close() onerror recover none
			}
			return none
		}

		// The bound address, or `addr` parsed before `start`.
		def address() net.Address {
			let s = ssh
			return s.address() unless s is none
			return net.parseAddress(addr) onerror recover new net.Address()
		}

		internal def sshServer() ssh.Server {
			let made = ssh
			return made unless made is none
			let s = new ssh.Server(addr)
			s.hostKeys = hostKeys
			s.authenticator = authenticator
			s.subsystems["sftp"] = self
			ssh = s
			return s
		}

		// Names the server and its address.
		def str() string {
			return "sftp.Server({addr})"
		}
	}
}
