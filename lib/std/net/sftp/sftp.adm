partial module std.net.sftp {
	use std.errors

	// SftpError is the payload of a failure the server reported, or of a
	// reply that does not parse. `code` names the kind: `not-found`,
	// `denied`, `unsupported`, `eof`, `failure` or `protocol`.
	struct SftpError {
		message string
		code    string
		cause   ?error
		stack   errors.StackTrace
		// The SSH_FX status code of the server's reply; 0 when the
		// failure is not a status reply.
		status  int
	}

	// Space is what `Client.space` reports of the file system holding a
	// path (OpenSSH's `statvfs@openssh.com`), in bytes.
	struct Space {
		total     int64
		free      int64
		// Free to users without special rights.
		available int64
	}
}
