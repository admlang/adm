partial module std.net.sftp {
	use (
		std.bytes
		std.fs
		std.io
		std.net
		std.net.ssh
		std.os
		std.testing
		std.time
	)

	// An SSH server offering SFTP over `store`, and a client logged in to
	// it.
	internal def sftpPair(store fs.FileStore, readOnly bool = false) !(ssh.Server, Client) {
		let files = new Server(store)
		files.readOnly = readOnly
		let server = new ssh.Server("127.0.0.1:0")
		server.hostKeys.push(try ssh.generateKey())
		let users = new ssh.Users()
		users.add("alice", "s3cret")
		server.authenticator = users
		server.subsystems["sftp"] = files
		try server.start()
		let client = new Client(10s)
		client.ssh.hostKeyPolicy = ssh.HostKeyPolicy.Insecure
		client.ssh.useAgent = false
		try client.connect(server.address().str(), "alice", "s3cret")
		return (server, client)
	}

	internal def pattern(size int) byte[] {
		let out byte[] = []
		out.len(size)
		for let i = 0; i < size; i++ {
			out[i] = byte((i * 7 + i / 251) % 256)
		}
		return out
	}

	check "SFTP" {
		@test()
		def filesAndDirectories() !none {
			let (server, client) = try sftpPair(new fs.MemoryStore())
			try client.makeDir("/docs")
			try client.writeFile("/docs/a.txt", "hello")
			assert string(try client.readFile("/docs/a.txt")) == "hello"
			let entry = try client.stat("/docs/a.txt")
			assert entry.size == 5
			assert entry.kind == fs.FileKind.File
			assert (try client.stat("/docs")).kind == fs.FileKind.Dir
			let names = (try client.list("/docs")).mapElem<string>(e => e.name)
			assert names.includes("a.txt")
			try client.rename("/docs/a.txt", "/docs/b.txt")
			assert !(try client.exists("/docs/a.txt"))
			assert try client.exists("/docs/b.txt")
			try client.chmod("/docs/b.txt", 0o600)
			assert (try client.stat("/docs/b.txt")).mode == 0o600
			let stamp = time.fromUnixNs(1700000000 * 1000000000)
			try client.touch("/docs/b.txt", stamp)
			assert (try client.stat("/docs/b.txt")).modified.unixNs() == stamp.unixNs()
			let missing = ""
			client.readFile("/nope") onerror (err error) {
				missing = err.code
				recover byte[]
			}
			assert missing == "not-found"
			assert (try client.realPath("docs/../docs")) == "/docs"
			assert (try client.home()) == "/"
			try client.remove("/docs/b.txt")
			try client.removeDir("/docs")
			assert (try client.list("/")).len() == 0
			try client.close()
			try server.close()
			return none
		}

		@test()
		def transfersMegabytesBothWays() !none {
			let (server, client) = try sftpPair(new fs.MemoryStore())
			let data = pattern(1500000)
			try client.upload(data, "/big.bin")
			assert (try client.stat("/big.bin")).size == int64(data.len())
			let back = try client.readFile("/big.bin")
			assert back.equals(data)
			// A reader from an offset.
			let reader = try client.download("/big.bin", int64(1000000))
			let tail = try io.readAll(reader)
			try reader.close()
			assert tail.equals(data[1000000:])
			// Appending, resuming and truncating.
			try client.writeFile("/log.txt", "one\n")
			let appender = try client.create("/log.txt", true)
			try appender.write("two\n".bytes())
			try appender.close()
			assert string(try client.readFile("/log.txt")) == "one\ntwo\n"
			try client.upload(new bytes.Reader("TWO\n".bytes()), "/log.txt", int64(4))
			assert string(try client.readFile("/log.txt")) == "one\nTWO\n"
			try client.truncate("/log.txt", int64(3))
			assert string(try client.readFile("/log.txt")) == "one"
			try client.copy("/log.txt", "/copy.txt")
			assert string(try client.readFile("/copy.txt")) == "one"
			try client.close()
			try server.close()
			return none
		}

		@test()
		def readOnlyRefusesChanges() !none {
			let store = new fs.MemoryStore()
			let w = try store.create("/keep.txt", false)
			try w.write("kept".bytes())
			try w.close()
			let (server, client) = try sftpPair(store, readOnly = true)
			assert string(try client.readFile("/keep.txt")) == "kept"
			let code = ""
			client.writeFile("/new.txt", "x") onerror (err error) {
				code = err.code
				recover none
			}
			assert code == "denied"
			try client.close()
			try server.close()
			return none
		}

		@test()
		def standaloneServerOverDisk() !none {
			let dir = "/tmp/adm-sftp-disk-{time.now().unixNs()}"
			try os.mkdir(dir)
			let files = new Server(new fs.DiskStore(dir), "127.0.0.1:0")
			files.hostKeys.push(try ssh.generateKey())
			let users = new ssh.Users()
			users.add("bob", "pw")
			files.authenticator = users
			try files.start()
			let client = new Client()
			client.ssh.hostKeyPolicy = ssh.HostKeyPolicy.Insecure
			client.ssh.useAgent = false
			try client.connect(files.address().str(), "bob", "pw")
			try client.writeFile("/../../escape.txt", "on disk")
			assert string(try os.readFile(dir + "/escape.txt")) == "on disk"
			// net.RemoteFiles: a directory both ways.
			let local = dir + "-local"
			try os.mkdir(local)
			try os.writeFile(local + "/one.txt", "1".bytes())
			try os.mkdir(local + "/sub")
			try os.writeFile(local + "/sub/two.txt", "22".bytes())
			let remote net.RemoteFiles = client
			try remote.upload(local, "/tree")
			assert string(try client.readFile("/tree/sub/two.txt")) == "22"
			try remote.download("/tree", local + "/back")
			assert string(try os.readFile(local + "/back/one.txt")) == "1"
			try client.close()
			try files.close()
			for let f in [dir + "/tree/sub/two.txt", dir + "/tree/one.txt", dir + "/escape.txt", local + "/one.txt", local + "/sub/two.txt", local + "/back/one.txt", local + "/back/sub/two.txt"] {
				os.remove(f) onerror recover none
			}
			for let d in [dir + "/tree/sub", dir + "/tree", dir, local + "/sub", local + "/back/sub", local + "/back", local] {
				os.rmdir(d) onerror recover none
			}
			return none
		}
	}
}
