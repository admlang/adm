partial module std.net.snmp {
	use std.net.snmp.proto::(arcsOf, compareArcs)

	// SecurityModel is who vouches for a request's security name (RFC
	// 3411): the SNMPv1 or v2c community, the SNMPv3 user (USM), or the
	// TLS certificate (TSM, RFC 6353).
	enum SecurityModel {
		// Any model, in an access rule.
		Any = 0,
		V1  = 1,
		V2c = 2,
		Usm = 3,
		Tsm = 4,
	}

	// SecurityLevel is how well a request is protected.
	enum SecurityLevel {
		NoAuthNoPriv = 1,
		AuthNoPriv   = 2,
		AuthPriv     = 3,
	}

	// AccessKind is what a request does with an object.
	enum AccessKind {
		Read   = "read",
		Write  = "write",
		Notify = "notify",
	}

	// AccessResult is the answer of the access control (RFC 3415 §3.2).
	enum AccessResult {
		Allowed       = "accessAllowed",
		NotInView     = "notInView",
		NoSuchView    = "noSuchView",
		NoSuchContext = "noSuchContext",
		NoGroupName   = "noGroupName",
		NoAccessEntry = "noAccessEntry",
	}

	// Access is an agent's View-based Access Control (RFC 3415): views
	// name sets of objects, groups gather security names (communities,
	// SNMPv3 users, TLS names), and rules give a group a read, write and
	// notify view in its contexts at a security level. Set it on a
	// `Server` to decide every object of every request by it.
	//
	// ```
	// let access = new snmp.Access()
	// access.include("system", "1.3.6.1.2.1.1")
	// access.include("all", "1.3")
	// access.exclude("all", "1.3.6.1.6.3.15")   // not the USM user table
	// access.group("monitors", snmp.SecurityModel.V2c, "public")
	// access.group("admins", snmp.SecurityModel.Usm, "alice")
	// access.allow("monitors", "system")
	// access.allow("admins", "all", "all", level = snmp.SecurityLevel.AuthPriv)
	// agent.access = access
	// ```
	type Access {
		internal families ViewFamily[]  = []
		internal members  GroupMember[] = []
		internal rules    AccessRule[]  = []
		// The contexts the agent knows besides the default "".
		contexts          string[]      = []

		def new() {}

		// Adds the objects under `subtree` to a view; the most specific
		// family of a view decides an object. `mask` (hex, like `ff:a0` or
		// `ffa0`) marks with 0 bits the sub-identifiers of `subtree` any
		// value matches, for table rows; missing bits are 1.
		def include(name string, subtree string, mask string = "") {
			families.push(ViewFamily{viewName: name, subtree: arcsOf(subtree), mask: maskBits(mask), included: true})
		}

		// Takes the objects under `subtree` out of a view, below a wider
		// subtree it includes. `mask` as for `include`.
		def exclude(name string, subtree string, mask string = "") {
			families.push(ViewFamily{viewName: name, subtree: arcsOf(subtree), mask: maskBits(mask), included: false})
		}

		// Puts a security name in a group, under a security model: a
		// community for V1 and V2c, a user for Usm, a TLS name for Tsm.
		def group(name string, model SecurityModel, securityName string) {
			members.push(GroupMember{group: name, model: model, name: securityName})
		}

		// Gives a group views for reading, writing and notifications
		// ("" for none) in the context `context` (with `prefix`, every
		// context starting with it), for requests of `model` (Any for all)
		// at `level` or better.
		def allow(group string, readView string, writeView string = "", notifyView string = "", level SecurityLevel = SecurityLevel.NoAuthNoPriv, model SecurityModel = SecurityModel.Any, context string = "", prefix bool = false) {
			rules.push(AccessRule{group: group, context: context, prefix: prefix, model: model, level: level, readView: readView, writeView: writeView, notifyView: notifyView})
		}

		// Whether a security name may act on `oid` (RFC 3415
		// isAccessAllowed).
		def decide(model SecurityModel, securityName string, level SecurityLevel, kind AccessKind, context string, oid string) AccessResult {
			let (result, name) = viewFor(model, securityName, level, kind, context)
			return result when result != AccessResult.Allowed
			return inView(name, oid) ?? (AccessResult.Allowed, AccessResult.NotInView)
		}

		// The view a request of `kind` gets, before any object is looked
		// at; the result is Allowed when there is one.
		def viewFor(model SecurityModel, securityName string, level SecurityLevel, kind AccessKind, context string) (AccessResult, string) {
			return (AccessResult.NoSuchContext, "") unless context == "" || contexts.includes(context)
			let group = ""
			for let m in members {
				if m.model == model && m.name == securityName {
					group = m.group
					break
				}
			}
			return (AccessResult.NoGroupName, "") when group == ""
			let best ?AccessRule = none
			for let r in rules {
				continue unless r.group == group
				continue unless r.model == SecurityModel.Any || r.model == model
				continue unless int(r.level) <= int(level)
				continue unless r.prefix ?? (context.startsWith(r.context), context == r.context)
				best = r when best is none || betterRule(r, best, model, context)
			}
			return (AccessResult.NoAccessEntry, "") when best is none
			let chosen = kind == AccessKind.Read ?? (best.readView, kind == AccessKind.Write ?? (best.writeView, best.notifyView))
			return (AccessResult.NoSuchView, "") when chosen == "" || !hasView(chosen)
			return (AccessResult.Allowed, chosen)
		}

		// Whether a view holds `oid`: the most specific family that
		// matches it includes it (the longest subtree; between two as long,
		// the one greater in OID order).
		def inView(name string, oid string) bool {
			let arcs = arcsOf(oid)
			let best ?ViewFamily = none
			for let f in families {
				continue unless f.viewName == name && matchesFamily(f, arcs)
				let b = best
				if b is none || f.subtree.len() > b.subtree.len() || (f.subtree.len() == b.subtree.len() && compareArcs(f.subtree, b.subtree) > 0) {
					best = f
				}
			}
			return !(best is none) && best.included
		}

		internal def hasView(name string) bool {
			for let f in families {
				return true when f.viewName == name
			}
			return false
		}
	}

	// One vacmViewTreeFamilyEntry.
	internal struct ViewFamily {
		viewName string
		subtree  int64[]
		mask     bool[]
		included bool
	}

	// Whether `arcs` lies under the family's subtree, the masked-out
	// sub-identifiers matching anything.
	internal def matchesFamily(f ViewFamily, arcs int64[]) bool {
		return false when arcs.len() < f.subtree.len()
		for let i = 0; i < f.subtree.len(); i++ {
			let exact = i >= f.mask.len() || f.mask[i]
			return false when exact && arcs[i] != f.subtree[i]
		}
		return true
	}

	// One vacmSecurityToGroupEntry.
	internal struct GroupMember {
		group string
		model SecurityModel
		name  string
	}

	// One vacmAccessEntry.
	internal struct AccessRule {
		group      string
		context    string
		prefix     bool
		model      SecurityModel
		level      SecurityLevel
		readView   string
		writeView  string
		notifyView string
	}

	// Whether rule `a` beats `b` for a request (RFC 3415 §4, the order of
	// vacmAccessTable selection): a rule of the request's own model over
	// Any, an exact context over a prefix, a longer prefix, a higher
	// level.
	internal def betterRule(a AccessRule, b AccessRule, model SecurityModel, context string) bool {
		let aModel = a.model == model
		let bModel = b.model == model
		return aModel when aModel != bModel
		let aExact = !a.prefix && a.context == context
		let bExact = !b.prefix && b.context == context
		return aExact when aExact != bExact
		return a.context.len() > b.context.len() when a.context.len() != b.context.len()
		return int(a.level) > int(b.level)
	}

	// A view mask from hex, one bit per sub-identifier, most significant
	// first.
	internal def maskBits(hex string) bool[] {
		let digits = hex.replace(":", "").replace(" ", "").lower()
		let out bool[] = []
		for let c in digits.bytes() {
			let v = c >= byte(97) ?? (int(c) - 87, int(c) - 48)
			for let bit = 3; bit >= 0; bit-- {
				out.push(((v >> bit) & 1) == 1)
			}
		}
		return out
	}
}
