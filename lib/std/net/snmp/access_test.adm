	// Whether  fails; its code, "" when it does not.
	internal def failureOf(f def () !none) string {
		let code = ""
		f() onerror (err error) {
			code = err.code == "" ?? ("failed", err.code)
			recover none
		}
		return code
	}

	internal def monitorAccess() Access {
		let access = new Access()
		access.include("system", "1.3.6.1.2.1.1")
		access.include("all", "1.3")
		access.exclude("all", "1.3.6.1.4.1.32473.9.5")
		// Rows 1 to 9 of column .9 under any index: the mask leaves the
		// last sub-identifier free.
		access.include("rows", "1.3.6.1.4.1.32473.9.1", "ffc0")
		access.group("monitors", SecurityModel.V2c, "public")
		access.group("admins", SecurityModel.V2c, "private")
		access.group("admins", SecurityModel.Usm, "sha256")
		access.group("admins", SecurityModel.Usm, "plain")
		access.group("ops", SecurityModel.Tsm, "ops")
		access.allow("monitors", "system")
		access.allow("admins", "all", "all", level = SecurityLevel.AuthPriv, model = SecurityModel.Usm)
		access.allow("admins", "all", "all", model = SecurityModel.V2c)
		access.allow("ops", "all", "all", level = SecurityLevel.AuthPriv)
		return access
	}

	check "SNMP access and transports" {
		@test()
		def decidesLikeVacm() {
			let a = monitorAccess()
			assert a.decide(SecurityModel.V2c, "public", SecurityLevel.NoAuthNoPriv, AccessKind.Read, "", sysDescr) == AccessResult.Allowed
			assert a.decide(SecurityModel.V2c, "public", SecurityLevel.NoAuthNoPriv, AccessKind.Read, "", "1.3.6.1.4.1.32473.9.1") == AccessResult.NotInView
			assert a.decide(SecurityModel.V2c, "public", SecurityLevel.NoAuthNoPriv, AccessKind.Write, "", sysName) == AccessResult.NoSuchView
			assert a.decide(SecurityModel.V2c, "nobody", SecurityLevel.NoAuthNoPriv, AccessKind.Read, "", sysDescr) == AccessResult.NoGroupName
			assert a.decide(SecurityModel.Usm, "plain", SecurityLevel.NoAuthNoPriv, AccessKind.Read, "", sysDescr) == AccessResult.NoAccessEntry
			assert a.decide(SecurityModel.Usm, "sha256", SecurityLevel.AuthPriv, AccessKind.Write, "", sysName) == AccessResult.Allowed
			assert a.decide(SecurityModel.Usm, "sha256", SecurityLevel.AuthPriv, AccessKind.Read, "other", sysName) == AccessResult.NoSuchContext
			// The excluded subtree inside .
			assert !a.inView("all", "1.3.6.1.4.1.32473.9.5")
			assert a.inView("all", "1.3.6.1.4.1.32473.9.6")
			// The mask: 1.3.6.1.4.1.32473.9.1.x for any x, and nothing
			// shorter.
			assert a.inView("rows", "1.3.6.1.4.1.32473.9.1.77")
			assert !a.inView("rows", "1.3.6.1.4.1.32473.9")
			assert !a.inView("rows", "1.3.6.1.4.1.32473.8.1.77")
		}

		@test()
		def enforcesAccessOnTheAgent() !none {
			let agent = try testAgent()
			agent.access = monitorAccess()
			let monitor = try clientFor(agent, Version.V2c)
			assert text(try monitor.get(sysDescr)) == "ADM SNMP agent"
			assert (try monitor.get("1.3.6.1.4.1.32473.9.1")).kind == ValueKind.NoSuchObject
			let seen = try monitor.walk("1.3.6.1")
			assert seen.len() == 7
			assert failureOf(def () !none {
				try monitor.set(octets(sysName, "x"))
				return none
			}) == "authorizationError"
			// The write community's group sees everything but .9.5.
			let admin = try clientFor(agent, Version.V2c)
			admin.community = "private"
			try admin.set(octets(sysName, "renamed"))
			assert text(try admin.get(sysName)) == "renamed"
			assert (try admin.get("1.3.6.1.4.1.32473.9.5")).kind == ValueKind.NoSuchObject
			assert (try admin.walk("1.3.6.1.4.1.32473.9")).len() == 29
			// A community in no group is not answered.
			let stranger = try clientFor(agent, Version.V2c)
			stranger.community = "guess"
			assert failureOf(def () !none {
				try stranger.get(sysDescr)
				return none
			}) == "timeout"
			// USM: authPriv gets in, noAuthNoPriv finds no access entry.
			let secure = try clientFor(agent, Version.V3)
			secure.user = User{name: "sha256", authProtocol: AuthProtocol.SHA256, authPassword: "authpass3", privProtocol: PrivProtocol.AES256, privPassword: "privpass3"}
			assert text(try secure.get(sysName)) == "renamed"
			let plain = try clientFor(agent, Version.V3)
			plain.user = User{name: "plain"}
			assert failureOf(def () !none {
				try plain.get(sysName)
				return none
			}) == "authorizationError"
			// An unknown context is reported.
			secure.contextName = "vlan-7"
			assert failureOf(def () !none {
				try secure.get(sysName)
				return none
			}) == "unknownContexts"
			try agent.close()
			return none
		}

		@test()
		def speaksOverTcp() !none {
			let agent = try testAgent()
			agent.tcpAddr = "127.0.0.1:0"
			try agent.close()
			try agent.start()
			let c = new Client(Version.V2c, 5s)
			try c.connect("tcp://" + agent.address(Transport.Tcp).str())
			assert text(try c.get(sysName)) == "test-agent"
			assert (try c.walk("1.3.6.1.4.1.32473.9")).len() == 30
			let v3 = new Client(Version.V3, 5s)
			v3.user = User{name: "shaaes", authProtocol: AuthProtocol.SHA, authPassword: "authpass2", privProtocol: PrivProtocol.AES, privPassword: "privpass2"}
			try v3.connect("tcp://" + agent.address(Transport.Tcp).str())
			assert text(try v3.get(sysName)) == "test-agent"
			// Notifications over TCP.
			let heard = new channel<string>(4)
			let receiver = new TrapReceiver(def (t Trap) {
				heard <- "{t.trapOid} inform={t.inform}"
			}, "127.0.0.1:0")
			receiver.tcpAddr = "127.0.0.1:0"
			try receiver.start()
			let sender = new Client(Version.V2c, 5s)
			try sender.connect("tcp://" + receiver.address(Transport.Tcp).str())
			try sender.trap("1.3.6.1.4.1.32473.0.1")
			assert (<-heard) == "1.3.6.1.4.1.32473.0.1 inform=false"
			try sender.inform("1.3.6.1.4.1.32473.0.2")
			assert (<-heard) == "1.3.6.1.4.1.32473.0.2 inform=true"
			try receiver.close()
			try agent.close()
			return none
		}

		@test()
		def speaksTsmOverTls() !none {
			let agent = try testAgent()
			agent.tlsAddr = "127.0.0.1:0"
			agent.tls = tls.Config{certificates: [try tls.parseKeyPair(agentCertPEM, agentKeyPEM)], clientAuth: tls.ClientAuthType.RequireAnyClientCert}
			let managerPair = try tls.parseKeyPair(managerCertPEM, managerKeyPEM)
			agent.certificateNames[certificateFingerprint(managerPair.chain[0])] = "ops"
			agent.access = monitorAccess()
			try agent.close()
			try agent.start()
			let pool = new CertPool()
			pool.appendCertsFromPEM(agentCertPEM)
			let c = new Client(Version.V3, 5s)
			c.tls = tls.Config{serverName: "localhost", rootCAs: pool, certificates: [managerPair]}
			try c.connect("tls://" + agent.address(Transport.Tls).str())
			assert text(try c.get(sysName)) == "test-agent"
			try c.set(octets(sysLocation, "rack 4"))
			assert text(try c.get(sysLocation)) == "rack 4"
			assert (try c.get(snmpEngineID)).data.len() == 13
			// A certificate the agent has no name for gets no answer.
			let other = new Client(Version.V3, 2s)
			other.retries = 0
			other.tls = tls.Config{serverName: "localhost", rootCAs: pool, certificates: [try tls.parseKeyPair(strangerCertPEM, strangerKeyPEM)]}
			try other.connect("tls://" + agent.address(Transport.Tls).str())
			assert failureOf(def () !none {
				try other.get(sysName)
				return none
			}) == "timeout"
			// TLS carries SNMPv3 only.
			assert failureOf(def () !none {
				try new Client(Version.V2c).connect("tls://127.0.0.1:1")
				return none
			}) == "config"
			// Informs to a receiver over TLS.
			let heard = new channel<string>(2)
			let receiver = new TrapReceiver(def (t Trap) {
				heard <- "{t.community} {t.trapOid}"
			}, "127.0.0.1:0")
			receiver.tlsAddr = "127.0.0.1:0"
			receiver.tls = agent.tls
			receiver.certificateNames = agent.certificateNames
			try receiver.start()
			let sender = new Client(Version.V3, 5s)
			sender.tls = c.tls
			try sender.connect("tls://" + receiver.address(Transport.Tls).str())
			try sender.inform("1.3.6.1.4.1.32473.0.3")
			assert (<-heard) == "ops 1.3.6.1.4.1.32473.0.3"
			try receiver.close()
			try agent.close()
			return none
		}
	}
}
