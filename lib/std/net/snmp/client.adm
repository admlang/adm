partial module std.net.snmp {
	use (
		std.crypto::(rand)
		std.net
		std.net.snmp.proto::*
		std.net.tls
		std.net.udp
		std.services.policy::(Policy)
		std.time
		std.net.snmp.transport::(transportTarget, clientTls, readFrame, writeFully)
	)

	// Client is an SNMP manager: it reads and writes an agent's objects
	// with SNMPv1, v2c (communities) or v3 (users with authentication and
	// privacy, or a TLS certificate), walks subtrees, and sends traps and
	// informs, over UDP, TCP or TLS.
	//
	// ```
	// let c = new snmp.Client(snmp.Version.V2c)
	// try c.connect("router.example.com")
	// print(snmp.text(try c.get("1.3.6.1.2.1.1.1.0")))        // sysDescr
	// for let v in try c.walk("1.3.6.1.2.1.2.2.1.2") {         // ifDescr
	//     print("{v.oid} = {snmp.text(v)}")
	// }
	// ```
	type Client {
		version              Version         = Version.V2c
		community            Secret<string>  = "public"
		// The SNMPv3 user; needed with V3.
		user                 ?User           = none
		// The SNMPv3 context name, "" for the default context.
		contextName          string          = ""
		// How long to wait for each answer, and how many times to ask again.
		timeout              duration        = 5s
		retries              int             = 2
		// Rows a walk asks for at once (GetBulk).
		maxRepetitions       int             = 25
		// The TLS settings for `tls://` agents: `certificates` holds this
		// manager's certificate, which the agent maps to a security name
		// (the Transport Security Model, RFC 6353). None verifies the
		// agent against the system roots and presents no certificate.
		tls                  ?tls.Config     = none
		internal socket      ?udp.Client     = none
		internal stream      ?net.Stream     = none
		internal lines       ?net.LineReader = none
		internal carrier     Transport       = Transport.Udp
		internal target      string          = ""
		internal nextId      int             = 1
		internal engineId    byte[]          = []
		internal engineBoots int             = 0
		internal engineTime  int             = 0
		internal learnedAt   time.Time
		internal keys        ?Keys           = none
		internal salt        int64           = 0
		internal ownEngine   byte[]          = []
		internal started     time.Time

		def new(version Version = Version.V2c, timeout duration = 5s) {
			self.version = version
			self.timeout = timeout
			started = time.now()
			learnedAt = started
		}

		// Aims the client at an agent: `host` or `host:port` over UDP (161
		// by default; use 162 for a trap receiver), or `tcp://host:port`
		// (RFC 3430) or `tls://host:port` (RFC 6353, port 10161; SNMPv3
		// only, identified by the certificate in `tls`). TCP and TLS
		// connect here. Fails when the policy denies it, the address does
		// not resolve, or the connection or TLS handshake fails.
		def connect(addr string) !none {
			fail SnmpError{message: "snmp: already connected", code: "protocol"} unless socket is none && stream is none
			let (kind, dial) = transportTarget(addr, 161, 10161)
			fail SnmpError{message: "snmp: TLS carries SNMPv3 only", code: "config"} when kind == Transport.Tls && version != Version.V3
			target = dial
			carrier = kind
			let scheme = kind == Transport.Udp ?? ("snmp", "snmp+" + kind.value)
			try Policy.validate("adm.network.connect", "std.services.policy.EndpointSpec", scheme + "://" + target)
			if kind == Transport.Udp {
				let a = try net.parseAddress(target)
				let s = new udp.Client()
				try s.start(a.isIPv6 ?? (net.SocketDomain.IPv6, net.SocketDomain.IPv4))
				socket = s
			} else {
				let conn = try net.dialStream(target, timeout)
				let opened net.Stream = conn
				if kind == Transport.Tls {
					opened = clientTls(conn, tls, target, timeout) onerror (err error) {
						conn.close() onerror recover none
						fail err
					}
				}
				stream = opened
				lines = new net.LineReader(opened, 1)
			}
			let seed = try rand(4)
			nextId = ((int(seed[0]) << 16) | (int(seed[1]) << 8) | int(seed[2])) + 1
			salt = (int64(seed[3]) << 24) | int64(nextId)
			return none
		}

		// The value of one object. With SNMPv2c and v3 a missing object
		// comes back as a NoSuchObject or NoSuchInstance value; with
		// SNMPv1 it fails with `noSuchName`. Fails when the agent does not
		// answer or refuses.
		def get(oid string) !Variable {
			return (try get([oid]))[0]
		}

		// The values of several objects at once. Fails as `get(oid)` does.
		def get(oids string[]) !Variable[] {
			return try request(pduGet, oids, 0, 0)
		}

		// The object after `oid` in the agent's order. Fails as `get` does.
		def getNext(oid string) !Variable {
			return (try getNext([oid]))[0]
		}

		// The objects after each of `oids`. Fails as `get` does.
		def getNext(oids string[]) !Variable[] {
			return try request(pduGetNext, oids, 0, 0)
		}

		// GetBulk (SNMPv2c and v3): the objects after the first
		// `nonRepeaters` oids once each, then up to `maxRepetitions`
		// objects after each of the rest. Fails with SNMPv1, or as `get`
		// does.
		def getBulk(oids string[], nonRepeaters int = 0, maxRepetitions int = 25) !Variable[] {
			fail SnmpError{message: "snmp: GetBulk needs SNMPv2c or v3", code: "protocol"} when version == Version.V1
			return try request(pduGetBulk, oids, nonRepeaters, maxRepetitions)
		}

		// Writes one object. Fails with the agent's error-status
		// (`notWritable`, `wrongType`, ...) or as `get` does.
		def set(v Variable) !Variable {
			return (try set([v]))[0]
		}

		// Writes several objects at once, all or none. Fails as
		// `set(variable)` does.
		def set(variables Variable[]) !Variable[] {
			let p = PDU{kind: pduSet, requestId: 0, variables: variables}
			let answer = try exchange(p)
			return answer.variables
		}

		// Every object below `root`, in order (GetBulk with SNMPv2c and
		// v3, GetNext with SNMPv1). Fails when the agent stops answering.
		def walk(root string = "1.3.6.1.2.1") !Variable[] {
			let out Variable[] = []
			try each(root, def (v Variable) !none {
				out.push(v)
				return none
			})
			return out
		}

		// Calls `fn` for each object below `root` as the walk reaches it.
		// Fails as `walk` does, or when `fn` does.
		def each(root string, fn def (Variable) !none) !none {
			let prefix = root.trimSuffix(".")
			let cursor = prefix
			for {
				let batch = try nextBatch(cursor)
				let advanced = false
				for let v in batch {
					return none unless hasValue(v) && within(v.oid, prefix)
					return none unless oidAfter(v.oid, cursor)
					try fn(v)
					cursor = v.oid
					advanced = true
				}
				return none unless advanced
			}
			return none
		}

		// The objects after `cursor`: GetBulk, or GetNext with SNMPv1, where
		// noSuchName marks the end of the agent's objects.
		internal def nextBatch(cursor string) !Variable[] {
			return try getBulk([cursor], 0, maxRepetitions) unless version == Version.V1
			let ended = false
			let got = getNext([cursor]) onerror (err error) {
				ended = err.code == "noSuchName"
				fail err unless ended
				recover Variable[]
			}
			return got
		}

		// Sends an SNMPv2 trap (or an SNMPv1 one built from it, RFC 3584)
		// to the connected address: `sysUpTime` and `snmpTrapOID` first,
		// then `variables`. With V3 this client is the authoritative engine
		// (`engineID()` is what receivers need). Fails when the policy
		// denies the address or the send fails.
		def trap(trapOid string, variables Variable[] = []) !none {
			return try trapV1(trapOid, 6, 0, variables) when version == Version.V1
			let p = PDU{kind: pduTrapV2, requestId: takeId(), variables: notification(trapOid, variables)}
			return try sendOnly(p)
		}

		// Sends an SNMPv1 Trap-PDU: `enterprise`, the generic trap number
		// (6 for enterprise-specific) and the specific one. Fails when the
		// send fails.
		def trapV1(enterprise string, generic int, specific int, variables Variable[] = []) !none {
			let p = PDU{kind: pduTrapV1, requestId: 0, variables: variables, enterprise: enterprise, agentAddr: byte[0, 0, 0, 0], generic: generic, specific: specific, timestamp: uptimeTicks()}
			return try sendRaw(try encodeCommunity(Version.V1, community.reveal(), p))
		}

		// Sends an inform and waits for the receiver to acknowledge it
		// (SNMPv2c and v3). Fails when no acknowledgement comes after the
		// retries.
		def inform(trapOid string, variables Variable[] = []) !none {
			fail SnmpError{message: "snmp: informs need SNMPv2c or v3", code: "protocol"} when version == Version.V1
			let p = PDU{kind: pduInform, requestId: 0, variables: notification(trapOid, variables)}
			try exchange(p)
			return none
		}

		// This client's own SNMPv3 engine ID, the one its traps carry.
		// Fails when the random source does.
		def engineID() !byte[] {
			ownEngine = try newEngineId() when ownEngine.len() == 0
			return ownEngine
		}

		// Stops using the socket or connection. Never fails.
		def close() !none {
			let s = socket
			socket = none
			if !(s is none) {
				s.close() onerror recover none
			}
			let st = stream
			stream = none
			lines = none
			if !(st is none) {
				st.close() onerror recover none
			}
			return none
		}

		def dispose() {
			close() onerror recover none
		}

		// ---- internals ----

		internal def connected() !none {
			fail SnmpError{message: "snmp: not connected; call connect first", code: "closed"} when socket is none && stream is none
			return none
		}

		internal def takeId() int {
			let id = nextId
			nextId = (nextId + 1) & 0x7fffffff
			return id
		}

		internal def uptimeTicks() int64 {
			return int64(time.now() - started) / 10000000
		}

		internal def notification(trapOid string, variables Variable[]) Variable[] {
			let out = [timeTicks(sysUpTime, uptimeTicks()), objectId(snmpTrapOID, trapOid)]
			for let v in variables {
				out.push(v)
			}
			return out
		}

		internal def request(kind int, oids string[], status int, index int) !Variable[] {
			let vars Variable[] = []
			for let oid in oids {
				vars.push(null(oid))
			}
			let answer = try exchange(PDU{kind: kind, requestId: 0, status: status, index: index, variables: vars})
			return answer.variables
		}

		// Sends a request and returns the Response, asking again on a
		// timeout. Fails with the error-status, a Report, or a timeout.
		internal def exchange(p PDU) !PDU {
			try connected()
			return try exchangeTsm(p) when version == Version.V3 && carrier == Transport.Tls
			return try exchangeV3(p, true) when version == Version.V3
			p.requestId = takeId()
			let data = try encodeCommunity(version, community.reveal(), p)
			for let attempt = 0; attempt <= retries; attempt++ {
				try sendRaw(data)
				let answer = try awaitAnswer(def (m Message) ?PDU {
					let got = m.pdu
					return none when got is none || m.version != version.value
					return got.requestId == p.requestId && got.kind == pduResponse ?? (got, none)
				})
				if !(answer is none) {
					try failOnStatus(answer)
					return answer
				}
			}
			fail SnmpError{message: "snmp: no answer from {target} after {retries + 1} tries", code: "timeout"}
		}

		internal def exchangeV3(p PDU, retryTime bool) !PDU {
			let u = user
			fail SnmpError{message: "snmp: SNMPv3 needs a user", code: "config"} when u is none
			if engineId.len() == 0 {
				try discover()
			}
			let k = keys
			let secured = k is none ?? (try keysFor(u, engineId), k)
			keys = secured
			p.requestId = takeId()
			let m = V3Message{msgId: p.requestId, flags: flagsFor(u) | flagReportable, engineId: engineId, boots: engineBoots, time: currentTime(), userName: u.name, contextEngineId: engineId, contextName: contextName, pdu: p}
			salt++
			let data = try encodeV3(m, secured, salt)
			for let attempt = 0; attempt <= retries; attempt++ {
				try sendRaw(data)
				let answer = try awaitV3(p.requestId, secured)
				if !(answer is none) {
					if answer.kind == pduReport {
						let reason = reportReason(answer)
						return try exchangeV3(p, false) when reason == "notInTimeWindows" && retryTime
						fail SnmpError{message: "snmp: the agent reported {reason}", code: reason}
					}
					try failOnStatus(answer)
					return answer
				}
			}
			fail SnmpError{message: "snmp: no answer from {target} after {retries + 1} tries", code: "timeout"}
		}

		// Engine discovery (RFC 3414 §4): an empty request the agent
		// answers with a Report naming its engine, boots and time.
		// Sends a request under the Transport Security Model: the TLS
		// session protects it, no keys or engine discovery (the context is
		// the agent's `localEngineID` until a reply names it, RFC 5343).
		// Fails with a Report's reason, the error-status or a timeout.
		internal def exchangeTsm(p PDU) !PDU {
			p.requestId = takeId()
			let context = engineId.len() == 0 ?? (localEngineId, engineId)
			let m = V3Message{model: modelTsm, msgId: p.requestId, flags: flagAuth | flagPriv | flagReportable, contextEngineId: context, contextName: contextName, pdu: p}
			let data = try encodeV3(m, none, 0)
			for let attempt = 0; attempt <= retries; attempt++ {
				try sendRaw(data)
				let found = try awaitAny(def (got Message) ?V3Message {
					let v3 = got.v3
					return none when v3 is none
					return v3.msgId == p.requestId ?? (v3, none)
				})
				if !(found is none) {
					let answer = found.pdu
					fail SnmpError{message: "snmp: an answer without a PDU", code: "protocol"} when answer is none
					fail SnmpError{message: "snmp: the agent reported {reportReason(answer)}", code: reportReason(answer)} when answer.kind == pduReport
					engineId = found.contextEngineId when found.contextEngineId.len() > 0 && !sameBytes(found.contextEngineId, localEngineId)
					try failOnStatus(answer)
					return answer
				}
			}
			fail SnmpError{message: "snmp: no answer from {target} after {retries + 1} tries", code: "timeout"}
		}

		internal def discover() !none {
			let id = takeId()
			let probe = V3Message{msgId: id, flags: flagReportable, pdu: PDU{kind: pduGet, requestId: id}}
			let data = try encodeV3(probe, none, 0)
			for let attempt = 0; attempt <= retries; attempt++ {
				try sendRaw(data)
				let found = try awaitAny(def (m Message) ?V3Message {
					let v3 = m.v3
					return none when v3 is none
					return v3.msgId == id ?? (v3, none)
				})
				if !(found is none) {
					fail SnmpError{message: "snmp: the agent sent no engine ID", code: "protocol"} when found.engineId.len() == 0
					learn(found)
					return none
				}
			}
			fail SnmpError{message: "snmp: no answer from {target} to engine discovery", code: "timeout"}
		}

		internal def learn(m V3Message) {
			engineId = m.engineId
			engineBoots = m.boots
			engineTime = m.time
			learnedAt = time.now()
		}

		// The agent's engine time now, from when it was learned.
		internal def currentTime() int {
			return engineTime + int(int64(time.now() - learnedAt) / 1000000000)
		}

		internal def awaitV3(id int, k Keys) !?PDU {
			let found = try awaitAny(def (m Message) ?V3Message {
				let v3 = m.v3
				return none when v3 is none
				return v3.msgId == id ?? (v3, none)
			})
			return none when found is none
			if (found.flags & flagAuth) != 0 {
				fail SnmpError{message: "snmp: the answer does not authenticate", code: "wrongDigests"} unless verifyDigest(found, k)
			}
			try openScoped(found, k)
			// A Report may bring the engine's clock.
			learn(found) when found.boots > engineBoots || (found.boots == engineBoots && found.time > currentTime())
			return found.pdu
		}

		internal def awaitAnswer(pick def (Message) ?PDU) !?PDU {
			let deadline = time.now() + timeout
			for {
				let left = deadline - time.now()
				return none when left <= 0s
				let data = receive(left) onerror recover byte[]
				return none when data.len() == 0
				let m = decodeMessage(data) onerror recover Message{version: -1}
				let got = pick(m)
				return got unless got is none
			}
			return none
		}

		internal def awaitAny(pick def (Message) ?V3Message) !?V3Message {
			let deadline = time.now() + timeout
			for {
				let left = deadline - time.now()
				return none when left <= 0s
				let data = receive(left) onerror recover byte[]
				return none when data.len() == 0
				let m = decodeMessage(data) onerror recover Message{version: -1}
				let got = pick(m)
				return got unless got is none
			}
			return none
		}

		// The next message from the agent. Fails on a timeout or when the
		// transport breaks.
		internal def receive(wait duration) !byte[] {
			let r = lines
			return try readFrame(r, wait) unless r is none
			let s = socket
			fail SnmpError{message: "snmp: not connected", code: "closed"} when s is none
			let buf byte[] = []
			buf.len(65536)
			let (n, _) = try s.recvFrom(buf, wait)
			return buf[:n].clone()
		}

		internal def sendOnly(p PDU) !none {
			try connected()
			if version == Version.V3 && carrier == Transport.Tls {
				let m = V3Message{model: modelTsm, msgId: p.requestId, flags: flagAuth | flagPriv, contextEngineId: try engineID(), contextName: contextName, pdu: p}
				return try sendRaw(try encodeV3(m, none, 0))
			}
			if version == Version.V3 {
				let u = user
				fail SnmpError{message: "snmp: SNMPv3 needs a user", code: "config"} when u is none
				let own = try engineID()
				let k = try keysFor(u, own)
				let m = V3Message{msgId: p.requestId, flags: flagsFor(u), engineId: own, boots: 1, time: int(int64(time.now() - started) / 1000000000), userName: u.name, contextEngineId: own, contextName: contextName, pdu: p}
				salt++
				return try sendRaw(try encodeV3(m, k, salt))
			}
			return try sendRaw(try encodeCommunity(version, community.reveal(), p))
		}

		internal def sendRaw(data byte[]) !none {
			let st = stream
			if !(st is none) {
				fail SnmpError{message: "snmp: the connection to {target} closed", code: "closed"} unless try writeFully(st, data, timeout)
				return none
			}
			let s = socket
			fail SnmpError{message: "snmp: not connected; call connect first", code: "closed"} when s is none
			try s.sendTo(data, target, timeout)
			return none
		}

		// Names the client and its agent.
		def str() string {
			return "snmp.Client({target})"
		}
	}

	// The security flags of a user: authentication, privacy.
	internal def flagsFor(u User) int {
		let flags = 0
		flags = flags | flagAuth when u.authProtocol != AuthProtocol.None
		flags = flags | flagPriv when u.privProtocol != PrivProtocol.None
		return flags
	}

	// Fails with the error-status of a Response.
	internal def failOnStatus(p PDU) !none {
		return none when p.status == errNone
		let name = statusName(p.status)
		let at = p.index > 0 && p.index <= p.variables.len() ?? (" ({p.variables[p.index - 1].oid})", "")
		fail SnmpError{message: "snmp: the agent answered {name}{at}", code: name, status: p.status, index: p.index}
	}

	// The usmStats counter a Report names, as its short name.
	internal def reportReason(p PDU) string {
		for let v in p.variables {
			return "unsupportedSecLevels" when v.oid == usmStatsUnsupportedSecLevels
			return "notInTimeWindows" when v.oid == usmStatsNotInTimeWindows
			return "unknownUserNames" when v.oid == usmStatsUnknownUserNames
			return "unknownEngineIDs" when v.oid == usmStatsUnknownEngineIDs
			return "wrongDigests" when v.oid == usmStatsWrongDigests
			return "decryptionErrors" when v.oid == usmStatsDecryptionErrors
			return "unknownContexts" when v.oid == snmpUnknownContexts
		}
		return "report"
	}

	// Whether `oid` lies below `root`.
	internal def within(oid string, root string) bool {
		return oid.startsWith(root + ".")
	}

	// Whether `a` comes after `b` in OID order.
	internal def oidAfter(a string, b string) bool {
		return compareOids(a, b) > 0
	}

	// Orders two dotted OIDs arc by arc.
	def compareOids(a string, b string) int {
		let x = a.split(".")
		let y = b.split(".")
		let n = x.len() < y.len() ?? (x.len(), y.len())
		for let i = 0; i < n; i++ {
			let p = x[i].toInt<int64>()
			let q = y[i].toInt<int64>()
			return -1 when p < q
			return 1 when p > q
		}
		return x.len() < y.len() ?? (-1, x.len() > y.len() ?? (1, 0))
	}
}
