internal partial module std.net.snmp.proto {
	use (
		std.net.snmp::(AuthProtocol, PrivProtocol, User, counter32)
		std.time
	)

	// The authoritative side of SNMPv3 (an agent, or a receiver of
	// informs): its engine, the Reports of RFC 3414 §3.2, and the checks
	// every incoming message goes through.

	// What checking an incoming v3 message gave: the request to answer,
	// or a Report to send instead (then `request` is none).
	struct Checked {
		request ?PDU    = none
		report  ?byte[] = none
		user    ?User   = none
		keys    ?Keys   = none
	}

	type Engine {
		id            byte[]
		boots         int                = 1
		started       time.Time
		users         User[]             = []
		atomic keys   map<string, Keys>
		atomic counts map<string, int64>
		atomic salt   int64              = 1

		def new(id byte[]) {
			self.id = id
			started = time.now()
		}

		def now() int {
			return int(int64(time.now() - started) / 1000000000)
		}

		atomic def bump(oid string) int64 {
			let n = counts.get(oid)
			let next = (n is none ?? (int64(0), n)) + 1
			counts[oid] = next
			return next
		}

		atomic def nextSalt() int64 {
			salt++
			return salt
		}

		internal def userNamed(name string) ?User {
			for let u in users {
				return u when u.name == name
			}
			return none
		}

		atomic def keysOf(u User) !Keys {
			let found = keys.get(u.name)
			return found unless found is none
			let made = try keysFor(u, id)
			keys[u.name] = made
			return made
		}

		// Checks an incoming message as the authoritative engine. Returns
		// the PDU to answer, or the Report to send.
		def admit(m V3Message) !Checked {
			let reportable = (m.flags & flagReportable) != 0
			return try reportOf(m, usmStatsUnknownEngineIDs, none, none, reportable) when m.engineId.len() == 0 || !sameBytes(m.engineId, id)
			let u = userNamed(m.userName)
			return try reportOf(m, usmStatsUnknownUserNames, none, none, reportable) when u is none
			let wantsAuth = (m.flags & flagAuth) != 0
			let wantsPriv = (m.flags & flagPriv) != 0
			return try reportOf(m, usmStatsUnsupportedSecLevels, none, none, reportable) when (wantsAuth && u.authProtocol == AuthProtocol.None) || (wantsPriv && u.privProtocol == PrivProtocol.None) || (wantsPriv && !wantsAuth)
			let k = try keysOf(u)
			if wantsAuth {
				return try reportOf(m, usmStatsWrongDigests, none, none, reportable) unless verifyDigest(m, k)
				let drift = m.time - now()
				return try reportOf(m, usmStatsNotInTimeWindows, u, k, reportable) when m.boots != boots || drift > 150 || drift < -150
			}
			let failed = false
			openScoped(m, k) onerror (err error) {
				failed = true
				recover none
			}
			return try reportOf(m, usmStatsDecryptionErrors, none, none, reportable) when failed
			return Checked{request: m.pdu, user: u, keys: k}
		}

		// A Report naming the counter that went up; authenticated with the
		// user's keys when given, else plain.
		internal def reportOf(m V3Message, counter string, u ?User, k ?Keys, reportable bool) !Checked {
			let count = bump(counter)
			return Checked{} unless reportable
			let requestPdu = m.pdu
			let requestId = requestPdu is none ?? (m.msgId, requestPdu.requestId)
			let pdu = PDU{kind: pduReport, requestId: requestId, variables: [counter32(counter, count)]}
			let flags = k is none ?? (0, flagAuth)
			let reply = V3Message{msgId: m.msgId, flags: flags, engineId: id, boots: boots, time: now(), userName: u is none ?? ("", u.name), contextEngineId: id, contextName: m.contextName, pdu: pdu}
			return Checked{report: try encodeV3(reply, k, 0)}
		}

		// The Response to a checked request at the same security level.
		def respond(request V3Message, checked Checked, answer PDU) !byte[] {
			let u = checked.user
			let flags = request.flags & (flagAuth | flagPriv)
			// The context is the request's (RFC 3412 §7.1): a sender of an
			// inform names its own engine there, and matches on it.
			let context = request.contextEngineId.len() == 0 ?? (id, request.contextEngineId)
			let reply = V3Message{model: request.model, msgId: request.msgId, flags: flags, engineId: id, boots: boots, time: now(), userName: u is none ?? ("", u.name), contextEngineId: context, contextName: request.contextName, pdu: answer}
			return try encodeV3(reply, checked.keys, nextSalt())
		}
	}

	def sameBytes(a byte[], b byte[]) bool {
		return false when a.len() != b.len()
		for let i = 0; i < a.len(); i++ {
			return false when a[i] != b[i]
		}
		return true
	}
}
