internal partial module std.net.snmp.proto {
	use std.net.snmp::(ValueKind, Variable, hasValue, null)

	// The objects an agent answers for, in OID order, and how it answers
	// Get, GetNext, GetBulk and Set (RFC 3416 §4.2).

	// One object: a fixed value, or functions that read and write it.
	type MibEntry {
		oid    string
		arcs   int64[]
		value  ?Variable             = none
		reader ?def () Variable      = none
		writer ?def (Variable) !none = none

		def new(oid string) {
			self.oid = oid
			arcs = arcsOf(oid)
		}

		// The current value, named by this entry's OID.
		def read() Variable {
			let r = reader
			if !(r is none) {
				let v = r()
				v.oid = oid
				return v
			}
			let fixed = value
			return fixed is none ?? (null(oid), fixed)
		}
	}

	def arcsOf(oid string) int64[] {
		let out int64[] = []
		for let part in oid.trimPrefix(".").split(".") {
			out.push(part.isNumeric() ?? (part.toInt<int64>(), int64(0)))
		}
		return out
	}

	def compareArcs(a int64[], b int64[]) int {
		let n = a.len() < b.len() ?? (a.len(), b.len())
		for let i = 0; i < n; i++ {
			return -1 when a[i] < b[i]
			return 1 when a[i] > b[i]
		}
		return a.len() < b.len() ?? (-1, a.len() > b.len() ?? (1, 0))
	}

	type Mib {
		atomic entries MibEntry[] = []

		def new() {}

		// Adds or replaces an entry.
		atomic def put(e MibEntry) {
			let at = position(e.arcs)
			if at < entries.len() && compareArcs(entries[at].arcs, e.arcs) == 0 {
				entries[at] = e
				return
			}
			let before = entries[:at].clone()
			before.push(e)
			entries = before + entries[at:]
		}

		atomic def remove(oid string) {
			let arcs = arcsOf(oid)
			let at = position(arcs)
			entries.remove(at) when at < entries.len() && compareArcs(entries[at].arcs, arcs) == 0
		}

		// The entry named `oid`; none when there is none.
		atomic def find(oid string) ?MibEntry {
			let arcs = arcsOf(oid)
			let at = position(arcs)
			return at < entries.len() && compareArcs(entries[at].arcs, arcs) == 0 ?? (entries[at], none)
		}

		// The first entry after `oid`; none past the last.
		atomic def after(oid string) ?MibEntry {
			let arcs = arcsOf(oid)
			let at = position(arcs)
			if at < entries.len() && compareArcs(entries[at].arcs, arcs) == 0 {
				at++
			}
			return at < entries.len() ?? (entries[at], none)
		}

		// Whether any entry lies below `oid` (for NoSuchObject against
		// NoSuchInstance).
		atomic def hasBelow(oid string) bool {
			let arcs = arcsOf(oid)
			let at = position(arcs)
			return false when at >= entries.len()
			let e = entries[at].arcs
			return false when e.len() <= arcs.len()
			return compareArcs(e[:arcs.len()], arcs) == 0
		}

		// The first index whose entry is not before `arcs`.
		internal def position(arcs int64[]) int {
			let lo = 0
			let hi = entries.len()
			for lo < hi {
				let mid = (lo + hi) / 2
				if compareArcs(entries[mid].arcs, arcs) < 0 {
					lo = mid + 1
				} else {
					hi = mid
				}
			}
			return lo
		}
	}

	// Answers a Get, GetNext, GetBulk or Set with `version`'s rules:
	// SNMPv1 errors (noSuchName) or SNMPv2 exceptions. `writable` is
	// whether the requester may Set; `allowed`, when given, whether the
	// access control lets it read (false) or write (true) an object: an
	// object it may not read is absent, one it may not write is noAccess.
	def answer(mib Mib, request PDU, version int, writable bool, allowed ?def (string, bool) bool = none) PDU {
		let out = PDU{kind: pduResponse, requestId: request.requestId, variables: []}
		let v1 = version == 0
		switch {
			case request.kind == pduGet:
				for let i = 0; i < request.variables.len(); i++ {
					let oid = request.variables[i].oid
					let e = visible(allowed, oid, false) ?? (mib.find(oid), none)
					let value = e is none ?? (null(oid), e.read())
					if !hasValue(value) || (v1 && value.kind == ValueKind.Counter64) {
						return failed(request, errNoSuchName, i + 1) when v1
						value = Variable{oid: oid, kind: mib.hasBelow(oid) ?? (ValueKind.NoSuchInstance, ValueKind.NoSuchObject)}
					}
					out.variables.push(value)
				}
			case request.kind == pduGetNext:
				for let i = 0; i < request.variables.len(); i++ {
					let value = nextOf(mib, request.variables[i].oid, v1, allowed)
					if value is none {
						return failed(request, errNoSuchName, i + 1) when v1
						out.variables.push(Variable{oid: request.variables[i].oid, kind: ValueKind.EndOfMibView})
						continue
					}
					out.variables.push(value)
				}
			case request.kind == pduGetBulk:
				let nonRepeaters = request.status < 0 ?? (0, request.status)
				let repetitions = request.index < 0 ?? (0, request.index)
				let rest string[] = []
				for let i = 0; i < request.variables.len(); i++ {
					let oid = request.variables[i].oid
					if i < nonRepeaters {
						let value = nextOf(mib, oid, false, allowed)
						out.variables.push(value is none ?? (Variable{oid: oid, kind: ValueKind.EndOfMibView}, value))
					} else {
						rest.push(oid)
					}
				}
				let cursors = rest.clone()
				for let r = 0; r < repetitions && rest.len() > 0; r++ {
					let allEnded = true
					for let j = 0; j < cursors.len(); j++ {
						let value = nextOf(mib, cursors[j], false, allowed)
						if value is none {
							out.variables.push(Variable{oid: cursors[j], kind: ValueKind.EndOfMibView})
							continue
						}
						out.variables.push(value)
						cursors[j] = value.oid
						allEnded = false
					}
					break when allEnded || out.variables.len() > 1000
				}
			case request.kind == pduSet:
				return try2Set(mib, request, v1, writable, allowed)
		}
		return out
	}

	// The object after `oid` that has a value and may be read (SNMPv1
	// skips Counter64).
	def nextOf(mib Mib, oid string, v1 bool, allowed ?def (string, bool) bool = none) ?Variable {
		let cursor = oid
		for {
			let e = mib.after(cursor)
			return none when e is none
			if visible(allowed, e.oid, false) {
				let value = e.read()
				return value when hasValue(value) && !(v1 && value.kind == ValueKind.Counter64)
			}
			cursor = e.oid
		}
		return none
	}

	// Whether the access control, when there is one, lets a requester
	// read or write an object.
	def visible(allowed ?def (string, bool) bool, oid string, write bool) bool {
		return allowed is none || allowed(oid, write)
	}

	// Checks every variable first, then writes them all.
	def try2Set(mib Mib, request PDU, v1 bool, writable bool, allowed ?def (string, bool) bool) PDU {
		let entries MibEntry[] = []
		for let i = 0; i < request.variables.len(); i++ {
			let v = request.variables[i]
			return failed(request, v1 ?? (errNoSuchName, errNoAccess), i + 1) unless visible(allowed, v.oid, true)
			let e = mib.find(v.oid)
			return failed(request, v1 ?? (errNoSuchName, (!writable ?? (errNoAccess, errNotWritable))), i + 1) when !writable || e is none || e.writer is none
			let current = e.read()
			return failed(request, v1 ?? (errBadValue, errWrongType), i + 1) when hasValue(current) && current.kind != v.kind
			entries.push(e)
		}
		for let i = 0; i < entries.len(); i++ {
			let w = entries[i].writer
			if !(w is none) {
				let refused = false
				w(request.variables[i]) onerror (err error) {
					refused = true
					recover none
				}
				return failed(request, v1 ?? (errBadValue, errWrongValue), i + 1) when refused
			}
		}
		let out = PDU{kind: pduResponse, requestId: request.requestId, variables: request.variables}
		return out
	}

	// A Response carrying an error-status: the request's variables back,
	// as RFC 3416 asks.
	def failed(request PDU, status int, index int) PDU {
		return PDU{kind: pduResponse, requestId: request.requestId, status: status, index: index, variables: request.variables}
	}
}
