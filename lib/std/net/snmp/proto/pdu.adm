internal partial module std.net.snmp.proto {
	use (
		std.data.encoding
		std.data.encoding::(ASN1Class, ASN1Element, ASN1Tag, asn1Constructed, asn1Integer, asn1Null, asn1OctetString, asn1OID, asn1Sequence, berParse, parseOID)
		std.net.snmp::(SnmpError, ValueKind, Variable, Version)
	)

	// SNMP messages (RFC 1157, RFC 3416, RFC 3412) and their PDUs in BER.

	// PDU types ([CONTEXT n] constructed).
	const (
		pduGet      = 0
		pduGetNext  = 1
		pduResponse = 2
		pduSet      = 3
		pduTrapV1   = 4
		pduGetBulk  = 5
		pduInform   = 6
		pduTrapV2   = 7
		pduReport   = 8
	)

	// Error-status values (RFC 3416 §3).
	const (
		errNone        = 0
		errTooBig      = 1
		errNoSuchName  = 2
		errBadValue    = 3
		errReadOnly    = 4
		errGenErr      = 5
		errNoAccess    = 6
		errWrongType   = 7
		errWrongValue  = 10
		errNotWritable = 17
		// RFC 3416: the access control refused the request.
		errAuthorizationError = 16
	)

	// PDU is one protocol data unit.
	struct PDU {
		kind       int
		requestId  int
		// Error-status and -index; GetBulk: non-repeaters and
		// max-repetitions.
		status     int        = 0
		index      int        = 0
		variables  Variable[] = []
		// SNMPv1 Trap-PDU fields.
		enterprise string     = ""
		agentAddr  byte[]     = []
		generic    int        = 0
		specific   int        = 0
		timestamp  int64      = 0
	}

	def statusName(status int) string {
		let names = ["noError", "tooBig", "noSuchName", "badValue", "readOnly", "genErr", "noAccess", "wrongType", "wrongLength", "wrongEncoding", "wrongValue", "noCreation", "inconsistentValue", "resourceUnavailable", "commitFailed", "undoFailed", "authorizationError", "notWritable", "inconsistentName"]
		return status >= 0 && status < names.len() ?? (names[status], "error{status}")
	}

	def protocolFailure(text string) error {
		return SnmpError{message: "snmp: " + text, code: "protocol"}
	}

	// ---- values ----

	def encodeValue(v Variable) !ASN1Element {
		match v.kind {
			case ValueKind.Integer:
				return asn1Integer(int(v.number))
			case ValueKind.OctetString:
				return asn1OctetString(v.data)
			case ValueKind.ObjectId:
				return asn1OID(try parseOID(v.objectId))
			case ValueKind.IpAddress:
				return new ASN1Element(ASN1Class.Application, 0, false, v.data)
			case ValueKind.Counter32:
				return unsignedElement(1, v.number)
			case ValueKind.Gauge32:
				return unsignedElement(2, v.number)
			case ValueKind.TimeTicks:
				return unsignedElement(3, v.number)
			case ValueKind.Opaque:
				return new ASN1Element(ASN1Class.Application, 4, false, v.data)
			case ValueKind.Counter64:
				return unsignedElement(6, v.number)
			case ValueKind.NoSuchObject:
				return new ASN1Element(ASN1Class.ContextSpecific, 0, false, [])
			case ValueKind.NoSuchInstance:
				return new ASN1Element(ASN1Class.ContextSpecific, 1, false, [])
			case ValueKind.EndOfMibView:
				return new ASN1Element(ASN1Class.ContextSpecific, 2, false, [])
			default:
				return asn1Null()
		}
	}

	// An [APPLICATION tag] unsigned integer: minimal two's complement of a
	// non-negative number.
	def unsignedElement(tag int, value int64) ASN1Element {
		let bytes byte[] = []
		let v = value
		for {
			bytes.unshift(byte(v & 0xff))
			v = v >> 8
			break when v == 0
		}
		bytes.unshift(byte(0)) when (int(bytes[0]) & 0x80) != 0 && value >= 0
		return new ASN1Element(ASN1Class.Application, tag, false, bytes)
	}

	def decodeValue(oid string, e ASN1Element) !Variable {
		let v = Variable{oid: oid}
		if e.class == ASN1Class.Universal {
			switch {
				case e.tag == int(ASN1Tag.Integer):
					v.kind = ValueKind.Integer
					v.number = int64(try e.asInt())
				case e.tag == int(ASN1Tag.OctetString):
					v.kind = ValueKind.OctetString
					v.data = e.content
				case e.tag == int(ASN1Tag.ObjectIdentifier):
					v.kind = ValueKind.ObjectId
					v.objectId = (try e.asOID()).str()
				default:
					v.kind = ValueKind.Null
			}
			return v
		}
		if e.class == ASN1Class.ContextSpecific {
			v.kind = e.tag == 0 ?? (ValueKind.NoSuchObject, e.tag == 1 ?? (ValueKind.NoSuchInstance, ValueKind.EndOfMibView))
			return v
		}
		switch {
			case e.tag == 0:
				v.kind = ValueKind.IpAddress
				v.data = e.content
			case e.tag == 4:
				v.kind = ValueKind.Opaque
				v.data = e.content
			default:
				v.kind = e.tag == 1 ?? (ValueKind.Counter32, e.tag == 2 ?? (ValueKind.Gauge32, e.tag == 3 ?? (ValueKind.TimeTicks, ValueKind.Counter64)))
				let n int64 = 0
				for let b in e.content {
					n = (n << 8) | int64(b)
				}
				v.number = n
		}
		return v
	}

	// ---- PDUs ----

	def encodePDU(p PDU) !ASN1Element {
		let binds ASN1Element[] = []
		for let v in p.variables {
			binds.push(asn1Sequence([asn1OID(try parseOID(v.oid)), try encodeValue(v)]))
		}
		if p.kind == pduTrapV1 {
			return asn1Constructed(ASN1Class.ContextSpecific, pduTrapV1, [
				asn1OID(try parseOID(p.enterprise)),
				new ASN1Element(ASN1Class.Application, 0, false, p.agentAddr.len() == 4 ?? (p.agentAddr, byte[0, 0, 0, 0])),
				asn1Integer(p.generic),
				asn1Integer(p.specific),
				unsignedElement(3, p.timestamp),
				asn1Sequence(binds),
			])
		}
		return asn1Constructed(ASN1Class.ContextSpecific, p.kind, [asn1Integer(p.requestId), asn1Integer(p.status), asn1Integer(p.index), asn1Sequence(binds)])
	}

	def decodePDU(e ASN1Element) !PDU {
		fail protocolFailure("PDU is not context-specific") unless e.class == ASN1Class.ContextSpecific && e.constructed
		let p = PDU{kind: e.tag, requestId: 0}
		let bindsAt = 3
		if e.tag == pduTrapV1 {
			p.enterprise = (try (try e.at(0)).asOID()).str()
			p.agentAddr = (try e.at(1)).content
			p.generic = int(try (try e.at(2)).asInt())
			p.specific = int(try (try e.at(3)).asInt())
			let ticks = try decodeValue("", try e.at(4))
			p.timestamp = ticks.number
			bindsAt = 5
		} else {
			p.requestId = int(try (try e.at(0)).asInt())
			p.status = int(try (try e.at(1)).asInt())
			p.index = int(try (try e.at(2)).asInt())
		}
		for let bind in (try e.at(bindsAt)).children {
			let oid = (try (try bind.at(0)).asOID()).str()
			p.variables.push(try decodeValue(oid, try bind.at(1)))
		}
		return p
	}

	// ---- community messages ----

	def encodeCommunity(version Version, community string, p PDU) !byte[] {
		return asn1Sequence([asn1Integer(version.value), asn1OctetString(community.bytes()), try encodePDU(p)]).encode()
	}

	// A decoded message of any version.
	struct Message {
		version   int
		community string     = ""
		pdu       ?PDU       = none
		// SNMPv3.
		v3        ?V3Message = none
	}

	// Reads the version and, for v1/v2c, the community and PDU.
	def decodeMessage(data byte[]) !Message {
		let (top, _) = berParse(data) onerror fail protocolFailure("message is not BER")
		fail protocolFailure("message is not a SEQUENCE") unless top.isTag(ASN1Tag.Sequence) && top.children.len() >= 3
		let version = int(try (try top.at(0)).asInt())
		return Message{version: 3, v3: try decodeV3(top, data)} when version == 3
		fail protocolFailure("version {version} is not SNMP") unless version := 0 || 1
		return Message{version: version, community: string((try top.at(1)).content), pdu: try decodePDU(try top.at(2))}
	}
}
