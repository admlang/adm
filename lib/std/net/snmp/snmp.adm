partial module std.net.snmp {
	use (
		std.errors
		std.net
	)

	// Version is the SNMP version a message speaks.
	enum Version {
		// SNMPv1 (RFC 1157): community strings, 32-bit counters.
		V1 = 0,
		// SNMPv2c (RFC 3416): community strings, GetBulk, Counter64.
		V2c = 1,
		// SNMPv3 (RFC 3412, 3414): users with authentication and privacy.
		V3 = 3,
	}

	// ValueKind is the type of a `Variable`'s value.
	enum ValueKind {
		Integer = "integer",
		OctetString = "octetString",
		Null = "null",
		ObjectId = "objectId",
		IpAddress = "ipAddress",
		Counter32 = "counter32",
		Gauge32 = "gauge32",
		TimeTicks = "timeTicks",
		Opaque = "opaque",
		Counter64 = "counter64",
		// The agent has no such object (SNMPv2 exceptions).
		NoSuchObject = "noSuchObject",
		NoSuchInstance = "noSuchInstance",
		// A walk ran past the last object.
		EndOfMibView = "endOfMibView",
	}

	// Variable is one variable binding: an object identifier and its
	// value. Build values with `integer`, `octets`, `counter32` and the
	// other constructors; read them with `int`, `text` and `bytes`.
	struct Variable {
		oid      string
		kind     ValueKind = ValueKind.Null
		// Integer, Counter32, Gauge32, TimeTicks and Counter64 values.
		number   int64     = 0
		// OctetString, Opaque and IpAddress values as bytes.
		data     byte[]    = []
		// ObjectId values, dotted.
		objectId string    = ""
	}

	// integer is an INTEGER value.
	def integer(oid string, value int64) Variable {
		return Variable{oid: oid, kind: ValueKind.Integer, number: value}
	}

	// octets is an OCTET STRING value holding text.
	def octets(oid string, text string) Variable {
		return Variable{oid: oid, kind: ValueKind.OctetString, data: text.bytes()}
	}

	// octets is an OCTET STRING value holding bytes.
	def octets(oid string, data byte[]) Variable {
		return Variable{oid: oid, kind: ValueKind.OctetString, data: data}
	}

	// objectId is an OBJECT IDENTIFIER value, dotted.
	def objectId(oid string, value string) Variable {
		return Variable{oid: oid, kind: ValueKind.ObjectId, objectId: value}
	}

	// ipAddress is an IpAddress value from dotted IPv4 text; 0.0.0.0 for
	// text that is not one.
	def ipAddress(oid string, address string) Variable {
		let parts = address.split(".")
		let raw byte[] = [0, 0, 0, 0]
		if parts.len() == 4 {
			for let i = 0; i < 4; i++ {
				raw[i] = byte(parts[i].toInt<int>()) when parts[i].isNumeric()
			}
		}
		return Variable{oid: oid, kind: ValueKind.IpAddress, data: raw}
	}

	// counter32 is a Counter32 value.
	def counter32(oid string, value int64) Variable {
		return Variable{oid: oid, kind: ValueKind.Counter32, number: value & 0xffffffff}
	}

	// gauge32 is a Gauge32 (Unsigned32) value.
	def gauge32(oid string, value int64) Variable {
		return Variable{oid: oid, kind: ValueKind.Gauge32, number: value & 0xffffffff}
	}

	// timeTicks is a TimeTicks value, hundredths of a second.
	def timeTicks(oid string, ticks int64) Variable {
		return Variable{oid: oid, kind: ValueKind.TimeTicks, number: ticks & 0xffffffff}
	}

	// timeTicks from a duration.
	def timeTicks(oid string, elapsed duration) Variable {
		return timeTicks(oid, int64(elapsed) / 10000000)
	}

	// counter64 is a Counter64 value (SNMPv2c and v3 only).
	def counter64(oid string, value int64) Variable {
		return Variable{oid: oid, kind: ValueKind.Counter64, number: value}
	}

	// null is a variable with no value, as Get requests carry.
	def null(oid string) Variable {
		return Variable{oid: oid}
	}

	// The value of a variable as text: the octets as UTF-8, numbers in
	// decimal, identifiers dotted, addresses dotted.
	def text(v Variable) string {
		match v.kind {
			case ValueKind.OctetString, ValueKind.Opaque:
				return string(v.data)
			case ValueKind.IpAddress:
				return v.data.len() == 4 ?? ("{int(v.data[0])}.{int(v.data[1])}.{int(v.data[2])}.{int(v.data[3])}", "")
			case ValueKind.ObjectId:
				return v.objectId
			case ValueKind.Null, ValueKind.NoSuchObject, ValueKind.NoSuchInstance, ValueKind.EndOfMibView:
				return ""
			default:
				return "{v.number}"
		}
	}

	// Whether a variable holds a value (not Null and not one of the
	// SNMPv2 exceptions).
	def hasValue(v Variable) bool {
		return !(v.kind := ValueKind.Null || ValueKind.NoSuchObject || ValueKind.NoSuchInstance || ValueKind.EndOfMibView)
	}

	// AuthProtocol is how an SNMPv3 user's messages are authenticated
	// (RFC 3414, RFC 7860).
	enum AuthProtocol {
		None = "none",
		MD5 = "md5",
		SHA = "sha",
		SHA224 = "sha224",
		SHA256 = "sha256",
		SHA384 = "sha384",
		SHA512 = "sha512",
	}

	// PrivProtocol is how an SNMPv3 user's messages are encrypted (RFC
	// 3414 DES, RFC 3826 AES-128; AES-192/256 with the key extension of
	// draft-blumenthal-aes-usm, as Net-SNMP does).
	enum PrivProtocol {
		None = "none",
		DES = "des",
		AES = "aes",
		AES192 = "aes192",
		AES256 = "aes256",
	}

	// User is an SNMPv3 user: its name and, for each security level, the
	// protocol and password. Passwords must have 8 characters at least.
	struct User {
		name         string
		authProtocol AuthProtocol   = AuthProtocol.None
		authPassword Secret<string> = ""
		privProtocol PrivProtocol   = PrivProtocol.None
		privPassword Secret<string> = ""
	}

	// SnmpError is the payload of a failure the agent reported (its
	// error-status and error-index), a Report of an SNMPv3 security
	// problem, a timeout or a reply that does not parse. `code` is the
	// error-status name (`noSuchName`, `notWritable`, ...), the Report's
	// counter (`unknownUserNames`, `wrongDigests`, ...), `timeout` or
	// `protocol`.
	struct SnmpError {
		message string
		code    string
		cause   ?error
		stack   errors.StackTrace
		// The error-status, 0 when the failure is not one.
		status  int
		// Which variable (from 1) the error-status is about.
		index   int
	}

	// Trap is a notification a `TrapReceiver` heard: an SNMPv1 Trap, an
	// SNMPv2 Trap or an Inform (acknowledged before the handler runs).
	struct Trap {
		version    Version
		// The community, or the SNMPv3 user.
		community  string
		source     net.Address
		// snmpTrapOID: what happened (for SNMPv1, built from the
		// enterprise and trap numbers as RFC 3584 says).
		trapOid    string
		// sysUpTime of the sender, hundredths of a second.
		uptime     int64
		variables  Variable[]
		inform     bool        = false
		// SNMPv1 only.
		enterprise string      = ""
		agentAddr  string      = ""
		generic    int         = 0
		specific   int         = 0
	}

	// Well-known object identifiers.
	const (
		// sysDescr: what the system is (SNMPv2-MIB).
		sysDescr                 = "1.3.6.1.2.1.1.1.0"
		// sysObjectID: the vendor's identifier of the system.
		sysObjectID              = "1.3.6.1.2.1.1.2.0"
		// sysUpTime: hundredths of a second since the agent started.
		sysUpTime                = "1.3.6.1.2.1.1.3.0"
		// sysContact: who looks after the system.
		sysContact               = "1.3.6.1.2.1.1.4.0"
		// sysName: the system's name.
		sysName                  = "1.3.6.1.2.1.1.5.0"
		// sysLocation: where the system is.
		sysLocation              = "1.3.6.1.2.1.1.6.0"
		// sysServices: the layers the system offers services at.
		sysServices              = "1.3.6.1.2.1.1.7.0"
		// snmpTrapOID: the second variable of every v2 trap, naming it.
		snmpTrapOID              = "1.3.6.1.6.3.1.1.4.1.0"
		// SNMP-FRAMEWORK-MIB: the agent's engine (RFC 3411).
		snmpEngineID             = "1.3.6.1.6.3.10.2.1.1.0"
		snmpEngineBoots          = "1.3.6.1.6.3.10.2.1.2.0"
		snmpEngineTime           = "1.3.6.1.6.3.10.2.1.3.0"
		snmpEngineMaxMessageSize = "1.3.6.1.6.3.10.2.1.4.0"
		// SNMP-TARGET-MIB: requests for a context the agent does not have.
		snmpUnknownContexts      = "1.3.6.1.6.3.12.1.5.0"
	)
}
