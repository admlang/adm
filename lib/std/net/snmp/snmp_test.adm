partial module std.net.snmp {
	use (
		std.crypto.hash::(Hash)
		std.data.encoding::(hexdecode)
		std.net.snmp.proto::*
		std.testing
		std.time
	)

	internal def testAgent() !Server {
		let agent = new Server("127.0.0.1:0")
		agent.name = "test-agent"
		agent.users = [
			User{name: "md5des", authProtocol: AuthProtocol.MD5, authPassword: "authpass1", privProtocol: PrivProtocol.DES, privPassword: "privpass1"},
			User{name: "shaaes", authProtocol: AuthProtocol.SHA, authPassword: "authpass2", privProtocol: PrivProtocol.AES, privPassword: "privpass2"},
			User{name: "sha256", authProtocol: AuthProtocol.SHA256, authPassword: "authpass3", privProtocol: PrivProtocol.AES256, privPassword: "privpass3"},
			User{name: "sha512", authProtocol: AuthProtocol.SHA512, authPassword: "authpass4", privProtocol: PrivProtocol.AES192, privPassword: "privpass4"},
			User{name: "plain"},
		]
		agent.writeCommunity = "private"
		for let i = 1; i <= 30; i++ {
			agent.set(integer("1.3.6.1.4.1.32473.9.{i}", int64(i * 10)))
		}
		agent.set(counter64("1.3.6.1.4.1.32473.8.1", 5000000000))
		let level = 3
		agent.writable("1.3.6.1.4.1.32473.7.1", () => integer("", int64(level)), def (v Variable) !none {
			fail "out of range" when v.number > 9
			level = int(v.number)
			return none
		})
		try agent.start()
		return agent
	}

	internal def clientFor(agent Server, version Version) !Client {
		let c = new Client(version, 2s)
		c.retries = 0
		try c.connect(agent.address().str())
		return c
	}

	check "SNMP" {
		@test()
		def localizesKeysLikeRfc3414() !none {
			let engine = hexdecode("000000000000000000000002") onerror recover byte[]
			let md5 = try passwordToKey("maplesyrup", Hash.MD5)
			assert md5.hex() == "9FAF3283884E92834EBC9847D8EDD963"
			assert localize(md5, engine, Hash.MD5).hex() == "526F5EED9FCCE26F8964C2930787D82B"
			let sha = try passwordToKey("maplesyrup", Hash.SHA1)
			assert sha.hex() == "9FB5CC0381497B3793528939FF788D5D79145211"
			assert localize(sha, engine, Hash.SHA1).hex() == "6695FEBC9288E36282235FC7151F128497B38F3F"
			return none
		}

		@test()
		def digestRoundTrip() !none {
			let u = User{name: "md5des", authProtocol: AuthProtocol.MD5, authPassword: "authpass1", privProtocol: PrivProtocol.None}
			let engine = try newEngineId()
			let k = try keysFor(u, engine)
			let m = V3Message{msgId: 7, flags: flagAuth, engineId: engine, boots: 1, time: 5, userName: "md5des", contextEngineId: engine, pdu: PDU{kind: pduGet, requestId: 7, variables: [null(sysName)]}}
			let data = try encodeV3(m, k, 1)
			let back = try decodeMessage(data)
			let v3 = back.v3
			fail "no v3" when v3 is none
			assert verifyDigest(v3, k)
			return none
		}

		@test()
		def ordersOids() {
			assert compareOids("1.3.6.1.2", "1.3.6.1.10") < 0
			assert compareOids("1.3.6.1", "1.3.6.1.0") < 0
			assert compareOids("1.3.6.2", "1.3.6.1.9") > 0
			assert text(ipAddress("x", "10.1.2.3")) == "10.1.2.3"
		}

		@test()
		def communityVersions() !none {
			let agent = try testAgent()
			let c = try clientFor(agent, Version.V2c)
			assert text(try c.get(sysName)) == "test-agent"
			let values = try c.get([sysDescr, "1.3.6.1.4.1.32473.9.3", "1.3.6.1.4.1.32473.99.0"])
			assert text(values[0]) == "ADM SNMP agent"
			assert values[1].number == 30
			assert values[2].kind == ValueKind.NoSuchObject
			assert (try c.getNext("1.3.6.1.4.1.32473.8.1")).oid == "1.3.6.1.4.1.32473.9.1"
			// SNMP-FRAMEWORK-MIB's engine objects follow, then the end.
			let engineIdValue = try c.getNext("1.3.6.1.4.1.32473.9.30")
			assert engineIdValue.oid == snmpEngineID && engineIdValue.data.len() == 13
			assert (try c.getNext(snmpEngineMaxMessageSize)).kind == ValueKind.EndOfMibView
			let walked = try c.walk("1.3.6.1.4.1.32473.9")
			assert walked.len() == 30
			assert walked[1].oid == "1.3.6.1.4.1.32473.9.2"
			let big = try c.get("1.3.6.1.4.1.32473.8.1")
			assert big.kind == ValueKind.Counter64 && big.number == 5000000000
			let uptime = try c.get(sysUpTime)
			assert uptime.kind == ValueKind.TimeTicks
			// Writes need the write community.
			let refused = ""
			c.set(integer("1.3.6.1.4.1.32473.7.1", 5)) onerror (err error) {
				refused = err.code
				recover integer("", 0)
			}
			assert refused == "noAccess"
			c.community = "private"
			try c.set(integer("1.3.6.1.4.1.32473.7.1", 5))
			assert (try c.get("1.3.6.1.4.1.32473.7.1")).number == 5
			let wrong = ""
			c.set(integer("1.3.6.1.4.1.32473.7.1", 50)) onerror (err error) {
				wrong = err.code
				recover integer("", 0)
			}
			assert wrong == "wrongValue"
			let fixed = ""
			c.set(integer(sysServices, 1)) onerror (err error) {
				fixed = err.code
				recover integer("", 0)
			}
			assert fixed == "notWritable"
			try c.set(octets(sysLocation, "rack 7"))
			assert agent.location == "rack 7"
			// SNMPv1: a missing object is an error, Counter64 is hidden.
			let v1 = try clientFor(agent, Version.V1)
			let missing = ""
			v1.get("1.3.6.1.4.1.32473.99.0") onerror (err error) {
				missing = err.code
				recover integer("", 0)
			}
			assert missing == "noSuchName"
			assert (try v1.walk("1.3.6.1.4.1.32473.9")).len() == 30
			// A wrong community gets no answer.
			let silent = try clientFor(agent, Version.V2c)
			silent.community = "nope"
			silent.timeout = 300ms
			let quiet = ""
			silent.get(sysName) onerror (err error) {
				quiet = err.code
				recover integer("", 0)
			}
			assert quiet == "timeout"
			try agent.close()
			return none
		}

		@test()
		def usersOfVersion3() !none {
			let agent = try testAgent()
			for let u in agent.users {
				let c = try clientFor(agent, Version.V3)
				c.user = u
				assert text(try c.get(sysName)) == "test-agent"
				assert (try c.walk("1.3.6.1.4.1.32473.9")).len() == 30
				if u.authProtocol != AuthProtocol.None {
					try c.set(integer("1.3.6.1.4.1.32473.7.1", 7))
				}
			}
			let bad = try clientFor(agent, Version.V3)
			bad.user = User{name: "shaaes", authProtocol: AuthProtocol.SHA, authPassword: "wrongpass", privProtocol: PrivProtocol.AES, privPassword: "privpass2"}
			let digest = ""
			bad.get(sysName) onerror (err error) {
				digest = err.code
				recover integer("", 0)
			}
			assert digest == "wrongDigests"
			let stranger = try clientFor(agent, Version.V3)
			stranger.user = User{name: "nobody"}
			let unknown = ""
			stranger.get(sysName) onerror (err error) {
				unknown = err.code
				recover integer("", 0)
			}
			assert unknown == "unknownUserNames"
			try agent.close()
			return none
		}

		@test()
		def trapsAndInforms() !none {
			let heard Trap[] = []
			let secure = User{name: "trapper", authProtocol: AuthProtocol.SHA256, authPassword: "trappass1", privProtocol: PrivProtocol.AES, privPassword: "trappass2"}
			let receiver = new TrapReceiver(def (t Trap) {
				heard.push(t)
			}, "127.0.0.1:0")
			receiver.users = [secure]
			try receiver.start()
			let port = receiver.address().str()
			let v2 = new Client(Version.V2c, 2s)
			v2.retries = 0
			try v2.connect(port)
			try v2.trap("1.3.6.1.4.1.32473.0.1", [octets("1.3.6.1.4.1.32473.5.1", "disk full")])
			try v2.inform("1.3.6.1.4.1.32473.0.2")
			let v1 = new Client(Version.V1, 2s)
			try v1.connect(port)
			try v1.trapV1("1.3.6.1.4.1.32473", 6, 17)
			let v3 = new Client(Version.V3, 2s)
			v3.user = secure
			v3.retries = 0
			try v3.connect(port)
			try v3.trap("1.3.6.1.4.1.32473.0.3")
			try v3.inform("1.3.6.1.4.1.32473.0.4")
			for let i = 0; i < 50 && heard.len() < 5; i++ {
				time.sleep(20ms)
			}
			assert heard.len() == 5
			let oids = heard.mapElem<string>(t => t.trapOid)
			assert oids.includes("1.3.6.1.4.1.32473.0.1")
			assert oids.includes("1.3.6.1.4.1.32473.0.2")
			assert oids.includes("1.3.6.1.4.1.32473.0.17")
			assert oids.includes("1.3.6.1.4.1.32473.0.3")
			assert oids.includes("1.3.6.1.4.1.32473.0.4")
			for let t in heard {
				if t.trapOid == "1.3.6.1.4.1.32473.0.1" {
					assert text(t.variables[0]) == "disk full"
				}
			}
			try receiver.close()
			return none
		}
	}
}
