partial module std.net {
	use std.services::(Network)

	// SocketDomain is the address family of a socket: IPv4, IPv6 or a Unix path.
	enum SocketDomain {
		IPv4,        // AF_INET
		IPv6,        // AF_INET6
		Unix,        // AF_UNIX
	}

	// SocketType is how a socket carries data: a reliable byte stream or
	// datagrams.
	enum SocketType {
		// SOCK_STREAM. Reliable, ordered bytes, no message boundaries
		// Used by TCP and Unix stream sockets
		Stream,
		// SOCK_DGRAM. Message-based (UDP-like), message boundaries preserved, every send -> one recive, may be lost or reordered (UDP)
		// Used by UDP and Unix datagram sockets
		Datagram,
	}

	// Socket is a raw socket before it becomes a Listener or a Connection:
	// options, bind, listen and connect, plus datagram sends and receives. It
	// closes its descriptor unless listen or connect handed it on.
	type Socket {
		internal fd   int
		// False once listen or connect handed the descriptor to a Listener or
		// Connection, which then closes it; the socket itself no longer does.
		internal owns bool

		def new(fd int) {
			self.fd = fd
			owns = true
		}

		// setOption sets an integer socket option at SOL_SOCKET level.
		//
		// For advanced control, use `std.services.Network.setSockOptInt`.
		// Fails when the option is unknown or the change is refused.
		def setOption(option int, value int) !none {
			// Default to SOL_SOCKET options (level=1 on POSIX).
			return Network.setSockOptInt(fd, 1, option, value)
		}

		// getOption returns an integer socket option at SOL_SOCKET level.
		// Fails when the option is unknown or cannot be read.
		def getOption(option int) !int {
			return Network.getSockOptInt(fd, 1, option)
		}

		// setReuseAddr enables SO_REUSEADDR.
		// Fails when the operating system refuses the change.
		def setReuseAddr(enabled bool = true) !none {
			return Network.setReuseAddr(fd, enabled)
		}

		// setReusePort enables SO_REUSEPORT when available.
		// Fails when the operating system refuses the change or lacks the option.
		def setReusePort(enabled bool = true) !none {
			return Network.setReusePort(fd, enabled)
		}

		// setNoDelay enables TCP_NODELAY (TCP only).
		// Fails when the operating system refuses the change.
		def setNoDelay(enabled bool = true) !none {
			return Network.setNoDelay(fd, enabled)
		}

		// setKeepAlive enables SO_KEEPALIVE.
		// Fails when the operating system refuses the change.
		def setKeepAlive(enabled bool = true) !none {
			return Network.setKeepAlive(fd, enabled)
		}

		// setLinger controls SO_LINGER.
		// Fails when the operating system refuses the change.
		def setLinger(enabled bool, seconds int = 0) !none {
			return Network.setLinger(fd, enabled, seconds)
		}

		// setRecvBuf sets SO_RCVBUF.
		// Fails when the operating system refuses the change.
		def setRecvBuf(bytes int) !none {
			return Network.setRecvBuf(fd, bytes)
		}

		// setSendBuf sets SO_SNDBUF.
		// Fails when the operating system refuses the change.
		def setSendBuf(bytes int) !none {
			return Network.setSendBuf(fd, bytes)
		}

		// bind binds the socket to a local address.
		// Fails when the address does not parse or is in use.
		def bind(addr string) !none {
			return Network.bind(fd, addr)
		}

		// listen marks the socket as a listening stream socket.
		// Fails when the socket is not bound or the operating system refuses.
		def listen(backlog int) !Listener {
			try Network.listen(fd, backlog)
			owns = false
			let ln Listener = new SocketListener(fd)
			return ln
		}

		// connect connects the socket to a remote stream endpoint.
		// Fails when the address does not parse, the connection is refused or it times out.
		def connect(addr string, timeout duration = 30s) !Connection {
			try Network.connect(fd, addr, timeout)
			owns = false
			return new Connection(fd)
		}

		// shutdownRead closes the read side of the connection.
		// Fails when the socket is not connected or the call is refused.
		def shutdownRead() !none {
			return Network.shutdown(fd, 0)
		}

		// shutdownWrite closes the write side of the connection.
		// Fails when the socket is not connected or the call is refused.
		def shutdownWrite() !none {
			return Network.shutdown(fd, 1)
		}

		// shutdown closes both sides of the connection.
		// Fails when the socket is not connected or the call is refused.
		def shutdown() !none {
			return Network.shutdown(fd, 2)
		}

		// writeTo sends a datagram to the provided address (UDP / Unix datagram).
		// Fails when the address does not parse, or the send is refused or times out.
		def writeTo(data byte[], addr string, timeout duration = 30s) !int {
			return Network.sendTo(fd, data, addr, timeout)
		}

		// readFrom receives a datagram and returns the sender address.
		// Fails when the receive is refused or times out.
		def readFrom(data byte[], timeout duration = 30s) !(int, Address) {
			let (n, addrStr) = try Network.recvFrom(fd, data, timeout)
			let addr = new Address()
			addr.parse(addrStr) onerror recover none
			return (n, addr)
		}

		// localAddr returns the local address of this socket.
		def localAddr() Address {
			let s = Network.localAddr(fd) onerror recover ""
			let a = new Address()
			a.parse(s) onerror recover none
			return a
		}

		// Closes the descriptor. Closing an already closed socket does nothing.
		// Fails when the descriptor refuses to close.
		def close() !none {
			return none when fd < 0
			let handle = fd
			fd = -1
			owns = false
			return Network.close(handle)
		}

		// Reports whether the socket still holds an open descriptor.
		def isOpen() bool {
			return fd >= 0
		}

		// Closes the descriptor when the last reference is released, unless a
		// Listener or Connection took it over.
		def dispose() {
			return unless owns
			close() onerror recover none
		}
	}

	internal type SocketListener {
		internal fd int

		def new(fd int) {
			self.fd = fd
		}

		def accept() !Connection {
			let cfd = try Network.accept(fd)
			return new Connection(cfd)
		}

		// Closes the listening descriptor. A second close does nothing.
		def close() !none {
			return none when fd < 0
			let handle = fd
			fd = -1
			return Network.close(handle)
		}

		// Closes the descriptor when the last reference is released.
		def dispose() {
			close() onerror recover none
		}

		def address() Address {
			let s = Network.localAddr(fd) onerror recover ""
			let a = new Address()
			a.parse(s) onerror recover none
			return a
		}
	}
}
