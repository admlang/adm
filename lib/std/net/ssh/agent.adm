partial module std.net.ssh {
	use (
		std.net
		std.net.ssh.keyformat::*
		std.net.sshwire::*
		std.services.runtime::(Runtime)
	)

	// Agent is a running SSH agent (`ssh-agent`, gpg-agent, a password
	// manager's): it holds private keys and signs with them without
	// handing them out. Reached over the Unix socket in `SSH_AUTH_SOCK`
	// (draft-miller-ssh-agent).
	//
	// ```
	// let agent = new ssh.Agent()
	// for let key in try agent.keys() {
	//     print(key.publicKey().fingerprint())
	// }
	// try agent.add(try ssh.loadKey("~/.ssh/id_ed25519"), lifetime = 1h)
	// ```
	type Agent {
		// The agent's socket.
		path    string
		timeout duration = 30s

		// The agent at `path`, `SSH_AUTH_SOCK` when empty.
		def new(path string = "") {
			let fromEnv = Runtime.getEnv("SSH_AUTH_SOCK")
			self.path = path != "" ?? (path, fromEnv is none ?? ("", fromEnv))
		}

		// Whether an agent socket is configured.
		def available() bool {
			return path != ""
		}

		// The keys the agent holds, each usable as a `Signer`. Fails when
		// the agent cannot be reached or answers garbage.
		def keys() !AgentKey[] {
			let reply = try call(message(agentRequestIdentities))
			fail sshError("agent", "agent refused to list keys") when int(reply[0]) != agentIdentitiesAnswer
			let r = new Reader(reply[1:])
			let count = try r.readUint32()
			let out AgentKey[] = []
			for let i = int64(0); i < count; i++ {
				let blob = try r.readString()
				let comment = try r.readText()
				// Keys of types this module does not read (certificates,
				// security keys) are skipped.
				let key = optionalKey(blob) onerror recover none
				continue when key is none
				key.comment = comment
				out.push(new AgentKey(self, key))
			}
			return out
		}

		// A signature by the agent's key `key` over `data`, with the
		// named algorithm. Fails when the agent does not hold the key or
		// refuses.
		def sign(key PublicKey, data byte[], algorithm string) !byte[] {
			let plain = plainName(algorithm)
			let flags = plain == "rsa-sha2-256" ?? (2, plain == "rsa-sha2-512" ?? (4, 0))
			let request = new Writer(agentSignRequest).putString(key.blob()).putString(data).putUint32(int64(flags))
			let reply = try call(request.bytes())
			fail sshError("agent", "agent refused to sign with {key.fingerprint()}") when int(reply[0]) != agentSignResponse
			return try new Reader(reply[1:]).readString()
		}

		// Hands `key` to the agent; with a `lifetime` it forgets the key
		// after that long, with `confirm` it asks the user before each
		// use. Fails when the agent refuses.
		def add(key PrivateKey, lifetime duration = 0s, confirm bool = false) !none {
			let constrained = lifetime > 0s || confirm
			let w = new Writer(constrained ?? (agentAddIdConstrained, agentAddIdentity))
			w.putRaw(try encodePrivateFields(key.cryptoKey(), key.kind.value)).putText(key.comment)
			w.putByte(1).putUint32(int64(lifetime) / 1000000000) when lifetime > 0s
			w.putByte(2) when confirm
			return try expectSuccess(w.bytes(), "add the key")
		}

		// Makes the agent forget `key`. Fails when it does not hold it.
		def remove(key PublicKey) !none {
			return try expectSuccess(new Writer(agentRemoveIdentity).putString(key.blob()).bytes(), "remove the key")
		}

		// Makes the agent forget every key. Fails when it refuses.
		def removeAll() !none {
			return try expectSuccess(message(agentRemoveAllIdentities), "remove its keys")
		}

		internal def expectSuccess(request byte[], what string) !none {
			let reply = try call(request)
			fail sshError("agent", "agent refused to {what}") when int(reply[0]) != agentSuccess
			return none
		}

		// Sends one request and reads the reply, each framed by a length.
		internal def call(request byte[]) !byte[] {
			fail sshError("agent", "no agent: SSH_AUTH_SOCK is not set; start one with `eval $(ssh-agent)`") when path == ""
			let conn = try net.dialStream(path, timeout)
			defer conn.close()
			let framed = new Writer().putString(request).bytes()
			try conn.writeAll(framed)
			let lines = new net.LineReader(conn)
			let length = uint32At(try lines.readBytes(4, timeout), 0)
			fail sshError("agent", "agent reply too long") when length > 262144 || length == 0
			return try lines.readBytes(int(length), timeout)
		}
	}

	internal def optionalKey(blob byte[]) !?PublicKey {
		return try parsePublicKey(blob)
	}

	// AgentKey is a key an `Agent` holds. Implements `Signer`.
	type AgentKey {
		agent        Agent
		internal key PublicKey

		def new(agent Agent, key PublicKey) {
			self.agent = agent
			self.key = key
		}

		// Implements Signer.
		def publicKey() PublicKey {
			return key
		}

		// Implements Signer: the agent signs. Fails when it refuses.
		def sign(data byte[], algorithm string) !byte[] {
			return try agent.sign(key, data, algorithm)
		}
	}

	// The agent protocol's message numbers.
	internal const (
		agentSuccess             = 6
		agentRequestIdentities   = 11
		agentIdentitiesAnswer    = 12
		agentSignRequest         = 13
		agentSignResponse        = 14
		agentAddIdentity         = 17
		agentRemoveIdentity      = 18
		agentRemoveAllIdentities = 19
		agentAddIdConstrained    = 25
	)
}
