partial module std.net.ssh {
	use (
		std.crypto::(rand)
		std.net::(parseIPText)
		std.net
		std.net.ssh.keyformat::*
		std.net.sshwire::*
		std.time
	)

	// CertificateKind says who a certificate vouches for.
	enum CertificateKind {
		// A user logging in; its principals are user names.
		User = 1,
		// A server; its principals are host names.
		Host = 2,
	}

	// Certificate is an OpenSSH certificate (PROTOCOL.certkeys): a public
	// key a certificate authority vouches for, for some principals and a
	// span of time. A server trusts every user certificate its
	// `userAuthorities` signed instead of listing each user's key; a
	// client trusts host certificates of the authorities `known_hosts`
	// marks `@cert-authority`.
	//
	// ```
	// let ca = try ssh.loadKey("/etc/ssh/user_ca")
	// let cert = try ca.certify(userKey.publicKey(), ssh.CertificateKind.User,
	// 	ssh.CertificateOptions{keyId: "alice@laptop", principals: ["alice"], validBefore: time.now() + 24h})
	// try client.connect("example.com:22", "alice", userKey.withCertificate(cert))
	// ```
	//
	// The fields describe the certificate as it was signed; changing them
	// does not change `blob()`.
	type Certificate {
		kind               CertificateKind
		// The certified key, as a plain key.
		key                PublicKey
		// The key of the authority that signed it.
		authority          PublicKey
		serial             uint64
		// The authority's name for the certificate, which servers log.
		keyId              string
		// The user or host names it is valid for; empty for any host
		// (a user certificate with none is refused).
		principals         string[]
		// None when unbounded.
		validAfter         ?time.Time
		validBefore        ?time.Time
		// Restrictions a server must enforce or refuse the certificate
		// (`force-command`, `source-address`, `verify-required`); the
		// values of flags are "".
		criticalOptions    map<string, string>
		// Permissions (`permit-pty`, `permit-port-forwarding`,
		// `permit-agent-forwarding`, `permit-X11-forwarding`,
		// `permit-user-rc`) and other extensions a server may ignore.
		extensions         map<string, string>
		internal encoded   byte[]
		internal signedLen int

		def new(kind CertificateKind, key PublicKey, authority PublicKey, encoded byte[], signedLen int) {
			self.kind = kind
			self.key = key
			self.authority = authority
			self.encoded = encoded
			self.signedLen = signedLen
		}

		// The certificate in the SSH wire encoding.
		def blob() byte[] {
			return encoded
		}

		// The certificate as a public key: what a client logs in with and
		// a server presents, and what a `-cert.pub` file holds.
		def publicKey() PublicKey {
			return new PublicKey(key.kind, key.cryptoKey(), encoded, key.comment, self)
		}

		// Whether the authority's signature over the certificate verifies.
		// An authority that is itself a certificate, or a SHA-1 RSA
		// signature (`ssh-rsa`, refused by OpenSSH since 8.2), does not.
		def verify() bool {
			return false unless authority.certificate() is none
			let r = new Reader(encoded[signedLen:])
			let signature = r.readString() onerror recover byte[]
			let algorithm = new Reader(signature).readText() onerror recover ""
			return false when algorithm == "ssh-rsa" || algorithm == ""
			return authority.verify(encoded[:signedLen], signature)
		}

		// Checks that the certificate is of `kind`, signed, valid at `at`
		// and lists `principal` (a host certificate listing nobody is
		// valid for any host). A user certificate must also carry only
		// critical options this implementation enforces. Fails with a
		// `certificate` SshError saying what is wrong. Whether the
		// authority is trusted is the caller's question.
		def validate(kind CertificateKind, principal string, at time.Time = time.now()) !none {
			fail certificateError("a {self.kind.name} certificate, not a {kind.name} one") when self.kind != kind
			fail certificateError("the signature of {authority.fingerprint()} does not verify") unless verify()
			let after = validAfter
			fail certificateError("not valid before {after}") when !(after is none) && at.before(after)
			let before = validBefore
			fail certificateError("expired at {before}") when !(before is none) && !at.before(before)
			if principals.len() == 0 {
				fail certificateError("lists no principals") when kind == CertificateKind.User
			} else {
				fail certificateError("not valid for {principal}; it lists {principals.join(", ")}") unless principals.includes(principal)
			}
			for let (name, _) in criticalOptions {
				fail certificateError("unsupported critical option {name}") unless name := "force-command" || "source-address"
			}
			return none
		}

		// Whether a `source-address` critical option, when present, lists
		// `addr` (addresses and CIDR blocks, comma-separated).
		def allowsSource(addr net.Address) bool {
			let list = criticalOptions.get("source-address")
			return true when list is none
			for let entry in list.split(",") {
				return true when sourceMatches(entry.trim(), addr.host)
			}
			return false
		}

		// Whether the certificate grants an extension such as
		// `permit-pty`.
		def permits(extension string) bool {
			return extensions.hasKey(extension)
		}

		// The certificate as a `-cert.pub` line.
		def str() string {
			return publicKey().str()
		}
	}

	// CertificateOptions are what `PrivateKey.certify` writes into a
	// certificate besides the key and its kind.
	struct CertificateOptions {
		keyId           string              = ""
		principals      string[]            = []
		serial          uint64              = 0
		// None for no bound, as ssh-keygen's default.
		validAfter      ?time.Time          = none
		validBefore     ?time.Time          = none
		// Only for user certificates: `force-command` (the command every
		// session runs) and `source-address` (the addresses logins may
		// come from).
		criticalOptions map<string, string> = map<string, string>{}
		// Only for user certificates. The default grants what ssh-keygen
		// grants: a terminal, port, agent and X11 forwarding, and
		// `~/.ssh/rc`.
		extensions      map<string, string> = map<string, string>{"permit-X11-forwarding": "", "permit-agent-forwarding": "", "permit-port-forwarding": "", "permit-pty": "", "permit-user-rc": ""}
	}

	internal def certificateError(text string) error {
		return sshError("certificate", "certificate {text}")
	}

	// Signs a certificate for `key` with the authority `ca`.
	internal def issueCertificate(ca PrivateKey, key PublicKey, kind CertificateKind, options CertificateOptions) !Certificate {
		fail sshError("key", "cannot certify a certificate") unless key.certificate() is none
		let plain = key.blob()
		let name = key.kind.value
		// The plain blob is the type name, then the fields.
		let fields = plain[4 + name.len():]
		let w = new Writer().putText(name + certSuffix).putString(try rand(32)).putRaw(fields)
		w.putUint64(options.serial).putUint32(int64(int(kind))).putText(options.keyId)
		let principals = new Writer()
		for let p in options.principals {
			principals.putText(p)
		}
		w.putString(principals.bytes())
		w.putUint64(certTime(options.validAfter, uint64(0)))
		w.putUint64(certTime(options.validBefore, 0xFFFFFFFFFFFFFFFF))
		let user = kind == CertificateKind.User
		w.putString(user ?? (encodeCertOptions(options.criticalOptions), byte[]))
		w.putString(user ?? (encodeCertOptions(options.extensions), byte[]))
		w.putString([])
		w.putString(ca.publicKey().blob())
		let signature = try ca.sign(w.bytes())
		w.putString(signature)
		return try parseCertificate(w.bytes())
	}

	internal def certTime(t ?time.Time, unbounded uint64) uint64 {
		return unbounded when t is none
		return uint64(t.unixNs() / 1000000000)
	}

	internal def timeOfCert(secs uint64, unbounded uint64) ?time.Time {
		return none when secs == unbounded
		return time.fromUnixNs(int64(secs) * 1000000000)
	}

	// Critical options and extensions: name and value pairs in name
	// order, a value as a string within the value field, a flag as an
	// empty field.
	internal def encodeCertOptions(options map<string, string>) byte[] {
		let names string[] = []
		for let (name, _) in options {
			names.push(name)
		}
		let w = new Writer()
		for let name in names.sort((a, b) => a < b) {
			let value = options[name]
			w.putText(name).putString(value == "" ?? (byte[], new Writer().putText(value).bytes()))
		}
		return w.bytes()
	}

	internal def decodeCertOptions(data byte[]) !map<string, string> {
		let out = map<string, string>{}
		let r = new Reader(data)
		for !r.done() {
			let name = try r.readText()
			let value = try r.readString()
			out[name] = value.len() == 0 ?? ("", new Reader(value).readText() onerror recover string(value))
		}
		return out
	}

	// Reads a certificate blob. Fails when it is malformed, of an
	// unknown key type, or signed by a certificate.
	internal def parseCertificate(blob byte[]) !Certificate {
		let r = new Reader(blob)
		let name = try r.readText()
		fail sshError("key", "{name} is not a certificate type") unless isCertName(name)
		try r.readString()
		let start = r.pos
		let inner = try decodeKeyFields(plainName(name), r)
		let plainBlob = new Writer().putText(plainName(name)).putRaw(blob[start:r.pos]).bytes()
		let key = try wrapPublic(inner, plainBlob, "")
		let serial = try r.readUint64()
		let kindCode = try r.readUint32()
		fail sshError("key", "unknown certificate type {kindCode}") unless kindCode == 1 || kindCode == 2
		let keyId = try r.readText()
		let principals string[] = []
		let pr = new Reader(try r.readString())
		for !pr.done() {
			principals.push(try pr.readText())
		}
		let after = try r.readUint64()
		let before = try r.readUint64()
		let critical = try decodeCertOptions(try r.readString())
		let extensions = try decodeCertOptions(try r.readString())
		try r.readString()
		let authority = try parsePublicKey(try r.readString())
		fail sshError("key", "certificate signed by a certificate") unless authority.certificate() is none
		let signedLen = r.pos
		try r.readString()
		let cert = new Certificate(kindCode == 1 ?? (CertificateKind.User, CertificateKind.Host), key, authority, blob, signedLen)
		cert.serial = serial
		cert.keyId = keyId
		cert.principals = principals
		cert.validAfter = timeOfCert(after, uint64(0))
		cert.validBefore = timeOfCert(before, 0xFFFFFFFFFFFFFFFF)
		cert.criticalOptions = critical
		cert.extensions = extensions
		return cert
	}

	// A `source-address` entry: an address, or a CIDR block.
	internal def sourceMatches(entry string, host string) bool {
		let slash = entry.indexOf("/")
		return entry == host when slash < 0
		let bitsText = entry[slash + 1:]
		return false when bitsText.len() == 0 || bitsText.len() > 3
		for let c in bitsText.bytes() {
			return false when c < byte(48) || c > byte(57)
		}
		let bits = bitsText.toInt<int>()
		let network = parseIPText(entry[:slash])
		return false when network is none
		let ip = parseIPText(host)
		return false when ip is none
		return false when network.len() != ip.len() || bits > 8 * ip.len()
		for let i = 0; i < bits; i++ {
			let mask = byte(0x80 >> (i % 8))
			return false when (network[i / 8] & mask) != (ip[i / 8] & mask)
		}
		return true
	}

	// CertifiedSigner logs in with a certificate: it shows the
	// certificate and signs with the key it certifies.
	internal type CertifiedSigner {
		cert Certificate
		key  PrivateKey

		def new(cert Certificate, key PrivateKey) {
			self.cert = cert
			self.key = key
		}

		def publicKey() PublicKey {
			return cert.publicKey()
		}

		def sign(data byte[], algorithm string) !byte[] {
			return try key.sign(data, plainName(algorithm))
		}
	}
}
