partial module std.net.ssh {
	use (
		std.io
		std.net
		std.net.ssh.mux::*
		std.net.sshwire::*
	)

	// A read with no deadline: channels sit idle as long as their users
	// like.
	internal const waitForever = 0s

	// Channel is a byte stream through an SSH connection: a connection
	// `Client.dial` or a forward opened, or a subsystem such as SFTP.
	// Implements `net.Stream`, `io.Reader` and `io.Writer`.
	type Channel {
		internal ch Chan

		def new(ch Chan) {
			self.ch = ch
		}

		// Reads what arrived, waiting up to `timeout` (0 without end); 0
		// once the other side finished sending. Fails when the connection
		// breaks or the wait times out.
		def read(data byte[], timeout duration) !int {
			return try ch.read(data, false, timeout)
		}

		// read without a deadline. Implements io.Reader. Fails when the
		// connection breaks.
		def read(data byte[]) !int {
			return try ch.read(data, false, waitForever)
		}

		// Writes all of `data`, waiting up to `timeout` (0 without end) for
		// the other side to take it. Fails when the channel is closed.
		def write(data byte[], timeout duration) !int {
			return try ch.write(data, false, timeout)
		}

		// write without a deadline. Implements io.Writer. Fails when the
		// channel is closed.
		def write(data byte[]) !int {
			return try ch.write(data, false, waitForever)
		}

		// write of text as UTF-8. Fails when the channel is closed.
		def write(text string) !int {
			return try ch.write(text.bytes(), false, waitForever)
		}

		// Tells the other side nothing more will be written; reading goes
		// on. Fails when the connection breaks.
		def closeWrite() !none {
			return try ch.sendEof()
		}

		// Closes the channel both ways. Never fails.
		def close() !none {
			ch.close()
			return none
		}

		// Whether neither side closed the channel.
		def isOpen() bool {
			return !ch.sentClose && !ch.peerClosed
		}
	}

	// Process is a command running on the server (`Client.start`,
	// `Client.shell`): its standard input to write, its output and error
	// output to read, its exit to wait for. Implements `net.Stream` over
	// input and output.
	//
	// ```
	// let p = try client.start("sort")
	// try p.write("b\na\n")
	// try p.closeInput()
	// print(try p.output())      // a\nb\n
	// assert (try p.wait()) == 0
	// ```
	type Process {
		internal ch Chan

		def new(ch Chan) {
			self.ch = ch
		}

		// Reads its standard output, waiting up to `timeout` (0 without
		// end); 0 once it ended. Fails when the connection breaks or the
		// wait times out.
		def read(data byte[], timeout duration) !int {
			return try ch.read(data, false, timeout)
		}

		// read without a deadline. Implements io.Reader. Fails when the
		// connection breaks.
		def read(data byte[]) !int {
			return try ch.read(data, false, waitForever)
		}

		// Reads its error output; 0 once it ended. Error output is
		// buffered as it arrives, so leaving it unread never stalls
		// the standard output. Fails when the connection breaks.
		def readErrors(data byte[], timeout duration = 0s) !int {
			return try ch.read(data, true, timeout)
		}

		// Writes to its standard input. Fails when the input was closed
		// or the process ended.
		def write(data byte[], timeout duration) !int {
			return try ch.write(data, false, timeout)
		}

		// write without a deadline. Implements io.Writer. Fails when the
		// input was closed or the process ended.
		def write(data byte[]) !int {
			return try ch.write(data, false, waitForever)
		}

		// write of text as UTF-8. Fails as `write(bytes)` does.
		def write(text string) !int {
			return try ch.write(text.bytes(), false, waitForever)
		}

		// Copies everything `from` holds to its standard input. Fails when
		// a read or the write fails.
		def write(from io.Reader) !int64 {
			return try io.copy(from, new Channel(ch))
		}

		// Closes its standard input: the process reads end of file.
		// Fails when the connection breaks.
		def closeInput() !none {
			return try ch.sendEof()
		}

		// The rest of its standard output, as text. Fails when the
		// connection breaks.
		def output() !string {
			return string(try drain(ch, false))
		}

		// The rest of its error output, as text. Fails when the
		// connection breaks.
		def errors() !string {
			return string(try drain(ch, true))
		}

		// Waits for it to end and returns its exit code: -1 when a signal
		// killed it (`exitSignal` names it) or the server did not say.
		// Output nobody read is dropped. Fails when the connection breaks
		// first.
		def wait() !int {
			try ch.waitClosed()
			return ch.exitStatus
		}

		// The signal that killed it (`TERM`, `KILL`, ...); "" when none
		// did or it still runs.
		def exitSignal() string {
			return ch.exitSignal
		}

		// Sends it a signal. Servers may ignore it (OpenSSH before 7.9
		// did). Fails when the connection breaks.
		def signal(sig Signal) !none {
			try ch.request("signal", false, new Writer().putText(sig.value).bytes())
			return none
		}

		// Tells it its terminal changed size. Fails when the connection
		// breaks.
		def resize(columns int, rows int, width int = 0, height int = 0) !none {
			let w = new Writer().putUint32(int64(columns)).putUint32(int64(rows)).putUint32(int64(width)).putUint32(int64(height))
			try ch.request("window-change", false, w.bytes())
			return none
		}

		// Implements net.Stream: closes the channel; the process sees its
		// connection gone. Never fails.
		def close() !none {
			ch.close()
			return none
		}

		// Whether the process's channel is still open.
		def isOpen() bool {
			return !ch.sentClose && !ch.peerClosed
		}
	}

	// Everything left on one stream of a channel, until its end.
	internal def drain(ch Chan, extended bool) !byte[] {
		let chunks byte[][] = []
		let total = 0
		for {
			let buf byte[] = []
			buf.len(65536)
			let n = try ch.read(buf, extended, waitForever)
			break when n == 0
			chunks.push(buf[:n])
			total += n
		}
		let out byte[] = []
		out.len(total)
		let at = 0
		for let c in chunks {
			c.copy(out[at:])
			at += c.len()
		}
		return out
	}
}
