internal partial module std.net.ssh.keyformat {
	use (
		std.crypto
		std.crypto::(ECDSAPrivateKey, ECDSAPublicKey, Ed25519PrivateKey, Ed25519PublicKey, RSAPrivateKey, RSAPublicKey, bcryptPbkdf, generateECDSAKey, generateEd25519Key, generateRSAKey, marshalPoint, newEd25519PrivateKey, newEd25519PublicKey, p256, p384, p521, rand, unmarshalPoint)
		std.crypto.cipher
		std.crypto.hash::(Hash, digest)
		std.data.encoding
		std.net.sshwire::*
		std.services::(Runtime)
	)

	// The key formats of SSH: public key blobs and signatures (RFC 4253
	// §6.6, RFC 5656, RFC 8332, RFC 8709), the `authorized_keys` line,
	// RFC 4716 public keys and OpenSSH's private key file
	// (PROTOCOL.key), plus the PEM files older tools write.

	const opensshMagic = "openssh-key-v1"

	// What OpenSSH appends to a key type to name its certificates
	// (PROTOCOL.certkeys): `ssh-ed25519-cert-v01@openssh.com`.
	const certSuffix = "-cert-v01@openssh.com"

	// Whether an algorithm name is a certificate's.
	def isCertName(name string) bool {
		return name.endsWith(certSuffix)
	}

	// The plain key type or signature algorithm under a certificate
	// name; a plain name as it is.
	def plainName(name string) string {
		return isCertName(name) ?? (name[:name.len() - certSuffix.len()], name)
	}

	// The SSH algorithm name of a public key.
	def kindName(key crypto.PublicKey) string {
		return "ssh-ed25519" when key is Ed25519PublicKey
		if key is ECDSAPublicKey {
			let k ECDSAPublicKey = key
			return "ecdsa-sha2-" + curveName(k.curve.name)
		}
		return "ssh-rsa"
	}

	// The SSH name of a NIST curve (`nistp256`), from its crypto name.
	def curveName(name string) string {
		return "nistp384" when name == "P-384"
		return "nistp521" when name == "P-521"
		return "nistp256"
	}

	def curveOfName(name string) !crypto.curve {
		return p256 when name == "nistp256"
		return p384 when name == "nistp384"
		return p521 when name == "nistp521"
		fail sshError("key", "unsupported curve {name}")
	}

	// The public half of a private key.
	def publicOf(key crypto.PrivateKey) crypto.PublicKey {
		if key is Ed25519PrivateKey {
			let k Ed25519PrivateKey = key
			return k.public
		}
		if key is ECDSAPrivateKey {
			let k ECDSAPrivateKey = key
			return k.publicKey()
		}
		let k RSAPrivateKey = key
		return k.publicKey()
	}

	// The SSH wire encoding of a public key.
	def encodePublicBlob(key crypto.PublicKey) byte[] {
		let w = new Writer()
		if key is Ed25519PublicKey {
			let k Ed25519PublicKey = key
			w.putText("ssh-ed25519").putString(k.bytes)
			return w.bytes()
		}
		if key is ECDSAPublicKey {
			let k ECDSAPublicKey = key
			let curve = curveName(k.curve.name)
			w.putText("ecdsa-sha2-" + curve).putText(curve).putString(marshalPoint(k.curve, k.point))
			return w.bytes()
		}
		let k RSAPublicKey = key
		w.putText("ssh-rsa").putMpint(bigint(k.e)).putMpint(k.n)
		return w.bytes()
	}

	// Reads a public key blob. Fails on an unknown type or a malformed
	// key.
	def decodePublicBlob(blob byte[]) !crypto.PublicKey {
		let r = new Reader(blob)
		let name = try r.readText()
		if isCertName(name) {
			// A certificate's nonce comes before the key's fields.
			try r.readString()
			return try decodeKeyFields(plainName(name), r)
		}
		return try decodeKeyFields(name, r)
	}

	// Reads the fields of a key of type `name` (a blob after its name).
	// Fails on an unknown type or a malformed key.
	def decodeKeyFields(name string, r Reader) !crypto.PublicKey {
		if name == "ssh-ed25519" {
			let raw = try r.readString()
			return newEd25519PublicKey(raw) onerror fail sshError("key", "bad Ed25519 public key")
		}
		if name.startsWith("ecdsa-sha2-") {
			let curveText = try r.readText()
			fail sshError("key", "curve {curveText} does not match {name}") when "ecdsa-sha2-" + curveText != name
			let c = try curveOfName(curveText)
			let point = unmarshalPoint(c, try r.readString()) onerror fail sshError("key", "bad ECDSA public point")
			return new ECDSAPublicKey(c, point)
		}
		if name == "ssh-rsa" {
			let e = try r.readMpint()
			let n = try r.readMpint()
			fail sshError("key", "RSA key below 1024 bits") when n.bitLen() < 1024
			fail sshError("key", "bad RSA exponent") when e.bitLen() > 31 || e.sign() <= 0
			return new RSAPublicKey(n, int(e))
		}
		fail sshError("key", "unsupported key type {name}")
	}

	// Reads a public key from text: an `authorized_keys` line, an RFC
	// 4716 block or a PEM `PUBLIC KEY`. Returns the key, its blob and its
	// comment.
	def decodePublicText(text string) !(crypto.PublicKey, byte[], string) {
		let trimmed = text.trim()
		return try decodeRfc4716(trimmed) when trimmed.startsWith("---- BEGIN SSH2 PUBLIC KEY ----")
		if trimmed.startsWith("-----BEGIN") {
			let block = encoding.pemDecode(trimmed) onerror fail sshError("key", "not a PEM block")
			fail sshError("key", "PEM block is {block.kind}, not PUBLIC KEY") when block.kind != "PUBLIC KEY"
			let inner = crypto.parsePKIXPublicKey(block.bytes) onerror fail sshError("key", "bad PEM public key")
			return (inner, encodePublicBlob(inner), "")
		}
		let line = trimmed.split("\n")[0].trim()
		let fields = line.split(" ").filter(p => p != "")
		for let i = 0; i + 1 < fields.len(); i++ {
			continue unless isKeyAlgorithm(plainName(fields[i]))
			let blob = encoding.base64decode(fields[i + 1]) onerror fail sshError("key", "public key is not Base64")
			let inner = try decodePublicBlob(blob)
			let blobName = new Reader(blob).readText() onerror recover ""
			fail sshError("key", "key type {fields[i]} does not match its blob") when kindName(inner) != plainName(fields[i]) || blobName != fields[i]
			let comment = fields[i + 2:].join(" ")
			return (inner, blob, comment)
		}
		fail sshError("key", "no public key found")
	}

	def isKeyAlgorithm(name string) bool {
		return name := "ssh-ed25519" || "ssh-rsa" || "ecdsa-sha2-nistp256" || "ecdsa-sha2-nistp384" || "ecdsa-sha2-nistp521"
	}

	// RFC 4716: header lines (with `\` continuations), then the Base64
	// blob, between the BEGIN and END markers.
	def decodeRfc4716(text string) !(crypto.PublicKey, byte[], string) {
		let comment = ""
		let body = ""
		let continuing = false
		for let raw in text.split("\n") {
			let line = raw.trim()
			continue when line.startsWith("---- ") || line == ""
			if continuing {
				continuing = line.endsWith("\\")
				continue
			}
			let colon = line.indexOf(":")
			// Base64 has no colon, so a line with one is a header.
			if colon > 0 && isHeaderName(line[:colon]) {
				let name = line[:colon].lower()
				let value = line[colon + 1:].trim()
				continuing = value.endsWith("\\")
				comment = value.trimPrefix("\"").trimSuffix("\"") when name == "comment"
				continue
			}
			body += line
		}
		let blob = encoding.base64decode(body) onerror fail sshError("key", "RFC 4716 key is not Base64")
		let inner = try decodePublicBlob(blob)
		return (inner, blob, comment)
	}

	def isHeaderName(text string) bool {
		for let c in text.bytes() {
			return false unless (c >= byte(97) && c <= byte(122)) || (c >= byte(65) && c <= byte(90)) || (c >= byte(48) && c <= byte(57)) || c == byte(45)
		}
		return text.len() > 0
	}

	// The signature algorithm a key signs with when none is asked for.
	def defaultSignatureAlgorithm(kind string) string {
		return kind == "ssh-rsa" ?? ("rsa-sha2-512", kind)
	}

	// The hash an SSH signature algorithm signs over.
	def signatureHash(algorithm string) Hash {
		return Hash.SHA512 when algorithm := "rsa-sha2-512" || "ecdsa-sha2-nistp521"
		return Hash.SHA384 when algorithm == "ecdsa-sha2-nistp384"
		return Hash.SHA1 when algorithm == "ssh-rsa"
		return Hash.SHA256
	}

	// Whether a signature algorithm fits a key type.
	def signatureFits(kind string, algorithm string) bool {
		return algorithm := "rsa-sha2-256" || "rsa-sha2-512" || "ssh-rsa" when kind == "ssh-rsa"
		return algorithm == kind
	}

	// An SSH signature blob by `key` over `data`.
	def signData(key crypto.PrivateKey, kind string, algorithm string, data byte[]) !byte[] {
		fail sshError("key", "a {kind} key cannot sign with {algorithm}") unless signatureFits(kind, algorithm)
		let w = new Writer()
		w.putText(algorithm)
		if key is Ed25519PrivateKey {
			let k Ed25519PrivateKey = key
			w.putString(k.sign(data))
			return w.bytes()
		}
		let hashed = digest(signatureHash(algorithm), data)
		if key is ECDSAPrivateKey {
			let k ECDSAPrivateKey = key
			let (r, s) = try k.sign(hashed)
			w.putString(new Writer().putMpint(r).putMpint(s).bytes())
			return w.bytes()
		}
		let k RSAPrivateKey = key
		w.putString(try k.signPKCS1v15(signatureHash(algorithm), hashed))
		return w.bytes()
	}

	// Whether `signature` is `key`'s SSH signature over `data`.
	def verifySignature(key crypto.PublicKey, kind string, data byte[], signature byte[]) bool {
		let r = new Reader(signature)
		let algorithm = r.readText() onerror recover ""
		return false unless signatureFits(kind, algorithm)
		let raw = r.readString() onerror recover byte[]
		return false when raw.len() == 0
		if key is Ed25519PublicKey {
			let k Ed25519PublicKey = key
			return k.verify(data, raw)
		}
		let hashed = digest(signatureHash(algorithm), data)
		if key is ECDSAPublicKey {
			let k ECDSAPublicKey = key
			let inner = new Reader(raw)
			let rv = inner.readMpint() onerror recover bigint(0)
			let sv = inner.readMpint() onerror recover bigint(0)
			return false when rv.isZero() || sv.isZero()
			return k.verify(hashed, rv, sv)
		}
		let k RSAPublicKey = key
		// Some signers drop leading zero bytes; RSA wants the full width.
		let sig = raw
		for sig.len() < k.size() {
			sig = byte[0] + sig
		}
		return k.verifyPKCS1v15(signatureHash(algorithm), hashed, sig)
	}

	// A fresh crypto key of an SSH key type.
	def generateInner(kind string, bits int) !crypto.PrivateKey {
		return try generateEd25519Key() when kind == "ssh-ed25519"
		return try generateECDSAKey(try curveOfName(kind["ecdsa-sha2-".len():])) when kind.startsWith("ecdsa-sha2-")
		fail sshError("key", "RSA keys need at least 2048 bits") when bits < 2048
		return try generateRSAKey(bits)
	}

	// `~/` at the start of a path is the user's home folder.
	def expandHome(path string) string {
		return path unless path == "~" || path.startsWith("~/")
		let home = Runtime.getEnv("HOME")
		return path when home is none
		return home + path[1:]
	}

	// The cipher of an OpenSSH or PEM key file: key and IV sizes, block
	// size, and whether it is GCM (a 16-byte tag after the data).
	struct FileCipher {
		keySize   int
		ivSize    int
		blockSize int
		gcm       bool = false
		cbc       bool = false
	}

	def fileCipher(name string) !FileCipher {
		return FileCipher{keySize: 16, ivSize: 16, blockSize: 16} when name == "aes128-ctr"
		return FileCipher{keySize: 24, ivSize: 16, blockSize: 16} when name == "aes192-ctr"
		return FileCipher{keySize: 32, ivSize: 16, blockSize: 16} when name == "aes256-ctr"
		return FileCipher{keySize: 16, ivSize: 16, blockSize: 16, cbc: true} when name == "aes128-cbc"
		return FileCipher{keySize: 24, ivSize: 16, blockSize: 16, cbc: true} when name == "aes192-cbc"
		return FileCipher{keySize: 32, ivSize: 16, blockSize: 16, cbc: true} when name == "aes256-cbc"
		return FileCipher{keySize: 16, ivSize: 12, blockSize: 16, gcm: true} when name == "aes128-gcm@openssh.com"
		return FileCipher{keySize: 32, ivSize: 12, blockSize: 16, gcm: true} when name == "aes256-gcm@openssh.com"
		fail sshError("key", "key file cipher {name} is not supported")
	}

	// Decrypts (or with `seal`, encrypts) the private section of a key
	// file.
	def cryptSection(spec FileCipher, key byte[], iv byte[], data byte[], seal bool) !byte[] {
		let block = try cipher.newAES(key)
		if spec.gcm {
			let aead = try cipher.newGCM(block)
			return aead.seal(iv, data, []) when seal
			return aead.open(iv, data, []) onerror fail sshError("key", "wrong passphrase")
		}
		if spec.cbc {
			let cbc = try cipher.newCBC(block, iv)
			return try cbc.encrypt(data) when seal
			return try cbc.decrypt(data)
		}
		let ctr = try cipher.newCTR(block, iv)
		return ctr.encrypt(data)
	}

	// Reads a private key file of any supported format. Returns the key
	// and its comment.
	def decodePrivate(text string, passphrase string) !(crypto.PrivateKey, string) {
		let block = encoding.pemDecode(text) onerror fail sshError("key", "no PEM block in the key file")
		return try decodeOpenSSH(block.bytes, passphrase) when block.kind == "OPENSSH PRIVATE KEY"
		let der = try decryptPem(block, passphrase)
		if block.kind == "RSA PRIVATE KEY" {
			let k = crypto.parsePKCS1PrivateKey(der) onerror fail sshError("key", "bad PKCS#1 key (wrong passphrase?)")
			return (k, "")
		}
		if block.kind == "EC PRIVATE KEY" {
			let k = crypto.parseECPrivateKey(der) onerror fail sshError("key", "bad EC key (wrong passphrase?)")
			return (k, "")
		}
		if block.kind == "PRIVATE KEY" {
			let k = crypto.parsePKCS8PrivateKey(der) onerror fail sshError("key", "bad PKCS#8 key")
			return (k, "")
		}
		fail sshError("key", "{block.kind} is not a private key format")
	}

	// The body of a legacy PEM key, decrypted when its headers say so
	// (`Proc-Type: 4,ENCRYPTED` with an AES-CBC `DEK-Info`, the key from
	// OpenSSL's EVP_BytesToKey over MD5).
	def decryptPem(block encoding.PEMBlock, passphrase string) !byte[] {
		let procType = block.headers.get("Proc-Type")
		return block.bytes when procType is none
		return block.bytes unless procType.contains("ENCRYPTED")
		let info = block.headers.get("DEK-Info")
		fail sshError("key", "encrypted PEM key without DEK-Info") when info is none
		fail sshError("key", "the key is encrypted; a passphrase is needed") when passphrase == ""
		let parts = info.split(",")
		fail sshError("key", "bad DEK-Info") when parts.len() != 2
		let name = parts[0].trim().lower()
		let iv = encoding.hexdecode(parts[1].trim()) onerror fail sshError("key", "bad DEK-Info IV")
		let keySize = name == "aes-128-cbc" ?? (16, name == "aes-192-cbc" ?? (24, name == "aes-256-cbc" ?? (32, 0)))
		fail sshError("key", "PEM cipher {name} is not supported") when keySize == 0 || iv.len() != 16
		let key byte[] = []
		let prev byte[] = []
		for key.len() < keySize {
			prev = digest(Hash.MD5, prev + passphrase.bytes() + iv[:8])
			key = key + prev
		}
		let cbc = try cipher.newCBC(try cipher.newAES(key[:keySize]), iv)
		let plain = cbc.decrypt(block.bytes) onerror fail sshError("key", "wrong passphrase")
		return cipher.unpadPKCS7(plain, 16) onerror fail sshError("key", "wrong passphrase")
	}

	// Reads OpenSSH's private key format (PROTOCOL.key).
	def decodeOpenSSH(data byte[], passphrase string) !(crypto.PrivateKey, string) {
		let magic = opensshMagic.bytes()
		fail sshError("key", "not an OpenSSH private key") when data.len() < magic.len() + 1 || string(data[:magic.len()]) != opensshMagic
		let r = new Reader(data[magic.len() + 1:])
		let cipherName = try r.readText()
		let kdfName = try r.readText()
		let kdfOptions = try r.readString()
		let count = try r.readUint32()
		fail sshError("key", "key files with {count} keys are not supported") when count != 1
		try r.readString()
		let section = try r.readString()
		let plain = section
		if cipherName != "none" {
			fail sshError("key", "the key is encrypted; a passphrase is needed") when passphrase == ""
			fail sshError("key", "key file KDF {kdfName} is not supported") when kdfName != "bcrypt"
			let spec = try fileCipher(cipherName)
			let options = new Reader(kdfOptions)
			let salt = try options.readString()
			let rounds = try options.readUint32()
			let derived = try bcryptPbkdf(passphrase.bytes(), salt, int(rounds), spec.keySize + spec.ivSize)
			let sealed = spec.gcm ?? (section + r.rest(), section)
			plain = try cryptSection(spec, derived[:spec.keySize], derived[spec.keySize:], sealed, false)
		}
		let p = new Reader(plain)
		let check1 = try p.readUint32()
		let check2 = try p.readUint32()
		fail sshError("key", "wrong passphrase") when check1 != check2
		let kind = try p.readText()
		if kind == "ssh-ed25519" {
			try p.readString()
			let secret = try p.readString()
			fail sshError("key", "bad Ed25519 private key") when secret.len() != 64
			let key = try newEd25519PrivateKey(secret[:32])
			return (key, try p.readText())
		}
		if kind.startsWith("ecdsa-sha2-") {
			let c = try curveOfName(try p.readText())
			let point = unmarshalPoint(c, try p.readString()) onerror fail sshError("key", "bad ECDSA public point")
			let d = try p.readMpint()
			return (new ECDSAPrivateKey(c, d, point), try p.readText())
		}
		if kind == "ssh-rsa" {
			let n = try p.readMpint()
			let e = try p.readMpint()
			let d = try p.readMpint()
			let qinv = try p.readMpint()
			let pr = try p.readMpint()
			let q = try p.readMpint()
			let key = new RSAPrivateKey(n, int(e), d, pr, q, d.mod(pr - 1), d.mod(q - 1), qinv)
			return (key, try p.readText())
		}
		fail sshError("key", "unsupported key type {kind}")
	}

	// A key's type name and private fields as OpenSSH's key file and the
	// agent protocol write them.
	def encodePrivateFields(key crypto.PrivateKey, kind string) byte[] {
		let p = new Writer()
		p.putText(kind)
		if key is Ed25519PrivateKey {
			let k Ed25519PrivateKey = key
			p.putString(k.public.bytes).putString(k.seed + k.public.bytes)
		} else if key is ECDSAPrivateKey {
			let k ECDSAPrivateKey = key
			p.putText(curveName(k.curve.name)).putString(marshalPoint(k.curve, k.point)).putMpint(k.d)
		} else {
			let k RSAPrivateKey = key
			p.putMpint(k.n).putMpint(bigint(k.e)).putMpint(k.d).putMpint(k.qinv).putMpint(k.p).putMpint(k.q)
		}
		return p.bytes()
	}

	// Writes OpenSSH's private key format, encrypted with AES-256-CTR
	// when there is a passphrase.
	def encodeOpenSSH(key crypto.PrivateKey, kind string, pubBlob byte[], comment string, passphrase string, rounds int) !string {
		let checkint = try rand(4)
		let p = new Writer()
		p.putRaw(checkint).putRaw(checkint).putRaw(encodePrivateFields(key, kind))
		p.putText(comment)
		let blockSize = passphrase == "" ?? (8, 16)
		let plain = p.bytes()
		for let i = 1; plain.len() % blockSize != 0; i++ {
			plain.push(byte(i))
		}
		let cipherName = "none"
		let kdfName = "none"
		let kdfOptions byte[] = []
		let section = plain
		if passphrase != "" {
			cipherName = "aes256-ctr"
			kdfName = "bcrypt"
			let salt = try rand(16)
			kdfOptions = new Writer().putString(salt).putUint32(int64(rounds)).bytes()
			let derived = try bcryptPbkdf(passphrase.bytes(), salt, rounds, 48)
			section = try cryptSection(try fileCipher(cipherName), derived[:32], derived[32:], plain, true)
		}
		let w = new Writer()
		w.putRaw(opensshMagic.bytes()).putByte(0)
		w.putText(cipherName).putText(kdfName).putString(kdfOptions).putUint32(1).putString(pubBlob).putString(section)
		return new encoding.PEMBlock("OPENSSH PRIVATE KEY", w.bytes()).encode()
	}
}
