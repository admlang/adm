partial module std.net.ssh {
	use (
		std.crypto
		std.crypto.hash::(Hash, digest)
		std.data.encoding
		std.net.ssh.keyformat::*
		std.net.sshwire::*
		std.os
	)

	// PublicKey is an SSH public key: what `authorized_keys` and
	// `known_hosts` list, what a server proves it holds and what a user
	// logs in with.
	//
	// ```
	// let key = try ssh.parsePublicKey("ssh-ed25519 AAAAC3Nza... alice@laptop")
	// print(key.fingerprint())   // SHA256:...
	// ```
	type PublicKey {
		// The key's type; a certificate's is the type of the key it
		// certifies.
		kind             KeyKind
		// The comment after the key in `authorized_keys`, usually the
		// owner's `user@host`.
		comment          string           = ""
		internal encoded byte[]
		internal inner   crypto.PublicKey
		internal cert    ?Certificate     = none

		def new(kind KeyKind, inner crypto.PublicKey, encoded byte[], comment string = "", cert ?Certificate = none) {
			self.kind = kind
			self.inner = inner
			self.encoded = encoded
			self.comment = comment
			self.cert = cert
		}

		// The key in the SSH wire encoding (RFC 4253 §6.6); a
		// certificate's blob when the key is one.
		def blob() byte[] {
			return encoded
		}

		// The certificate this key is, or none for a plain key.
		def certificate() ?Certificate {
			return cert
		}

		// The key type as SSH names it on the wire and in files:
		// `ssh-ed25519`, or `ssh-ed25519-cert-v01@openssh.com` for a
		// certificate.
		def algorithm() string {
			return cert is none ?? (kind.value, kind.value + certSuffix)
		}

		// The key as the crypto module holds it.
		def cryptoKey() crypto.PublicKey {
			return inner
		}

		// The SHA-256 fingerprint `ssh-keygen -l` prints: `SHA256:` and the
		// unpadded Base64 of the hash of the blob. A certificate's is its
		// key's.
		def fingerprint() string {
			let c = cert
			return c.key.fingerprint() unless c is none
			let codec = new encoding.Base64()
			codec.padded = false
			return "SHA256:" + codec.encode(digest(Hash.SHA256, encoded))
		}

		// Whether two keys are the same key; comments do not count.
		def equals(other PublicKey) bool {
			return crypto.constantTimeEqual(encoded, other.encoded)
		}

		// Whether `signature`, an SSH signature blob (RFC 4253 §6.6), is
		// this key's signature over `data`. The signature names its
		// algorithm; RSA keys accept `rsa-sha2-256`, `rsa-sha2-512` and
		// `ssh-rsa`.
		def verify(data byte[], signature byte[]) bool {
			return verifySignature(inner, kind.value, data, signature)
		}

		// The key as one `authorized_keys` line: algorithm, Base64 blob,
		// comment.
		def str() string {
			let line = algorithm() + " " + encoding.base64encode(encoded)
			return comment == "" ?? (line, line + " " + comment)
		}
	}

	// PrivateKey is an SSH private key: a host key of a `Server`, or an
	// identity a `Client` logs in with.
	//
	// ```
	// let key = try ssh.loadKey("~/.ssh/id_ed25519")
	// let fresh = try ssh.generateKey()
	// try fresh.save("/etc/myapp/host_key")
	// ```
	type PrivateKey {
		kind           KeyKind
		comment        string            = ""
		internal inner crypto.PrivateKey
		internal pub   PublicKey

		def new(kind KeyKind, inner crypto.PrivateKey, pub PublicKey, comment string = "") {
			self.kind = kind
			self.inner = inner
			self.pub = pub
			self.comment = comment
			pub.comment = comment
		}

		// The matching public key.
		def publicKey() PublicKey {
			return pub
		}

		// The key as the crypto module holds it.
		def cryptoKey() crypto.PrivateKey {
			return inner
		}

		// An SSH signature blob over `data`, RSA keys with `rsa-sha2-512`.
		// Fails when the random source does (ECDSA).
		def sign(data byte[]) !byte[] {
			return try sign(data, defaultSignatureAlgorithm(kind.value))
		}

		// An SSH signature blob over `data` with the named algorithm:
		// `rsa-sha2-256`, `rsa-sha2-512` or `ssh-rsa` for an RSA key, the
		// key's own algorithm otherwise. Fails when the algorithm does not
		// fit the key, or the random source does.
		def sign(data byte[], algorithm string) !byte[] {
			return try signData(inner, kind.value, algorithm, data)
		}

		// The key in the OpenSSH format `ssh-keygen` writes, encrypted
		// with AES-256-CTR under a key `bcrypt_pbkdf` derives from the
		// passphrase with `rounds` rounds; plain with no passphrase.
		// Fails when the random source does.
		def encode(passphrase ?Secret<string> = none, rounds int = 16) !string {
			let secret = passphrase is none ?? ("", passphrase.reveal())
			return try encodeOpenSSH(inner, kind.value, pub.blob(), comment, secret, rounds)
		}

		// Signs a certificate for `key` as a certificate authority, as
		// `ssh-keygen -s` does: a fresh nonce, the options, and this key's
		// signature (RSA with rsa-sha2-512). Fails when `key` is itself a
		// certificate, or the random source fails.
		def certify(key PublicKey, kind CertificateKind, options CertificateOptions = CertificateOptions{}) !Certificate {
			return try issueCertificate(self, key, kind, options)
		}

		// This key logging in with `cert`, a certificate of its public
		// key: pass it where a `Signer` goes. Fails when the certificate
		// is for another key.
		def withCertificate(cert Certificate) !Signer {
			fail sshError("key", "the certificate is for {cert.key.fingerprint()}, not {pub.fingerprint()}") unless cert.key.equals(pub)
			return new CertifiedSigner(cert, self)
		}

		// Writes `encode(passphrase)` to `path`, readable by its owner
		// only, as OpenSSH insists. Fails as `encode` does, or when the
		// file cannot be written.
		def save(path string, passphrase ?Secret<string> = none) !none {
			let text = try encode(passphrase)
			let file = expandHome(path)
			try os.writeFile(file, text.bytes())
			return try os.chmod(file, 0o600)
		}
	}

	// generateKey makes a fresh key pair: Ed25519 by default, `bits`
	// sized for RSA (3072 unless given). Fails when the random source
	// does or `bits` is below 2048.
	def generateKey(kind KeyKind = KeyKind.Ed25519, bits int = 3072, comment string = "") !PrivateKey {
		let inner crypto.PrivateKey = try generateInner(kind.value, bits)
		return try wrapPrivate(inner, comment)
	}

	// parseKey reads a private key: the OpenSSH format, or PEM PKCS#1
	// (`RSA PRIVATE KEY`), SEC 1 (`EC PRIVATE KEY`) or PKCS#8 (`PRIVATE
	// KEY`). An encrypted OpenSSH key needs its passphrase. Fails when
	// the text holds no key, the passphrase is wrong or missing, or the
	// key type or cipher is not supported.
	def parseKey(text string, passphrase ?Secret<string> = none) !PrivateKey {
		let secret = passphrase is none ?? ("", passphrase.reveal())
		let (inner, comment) = try decodePrivate(text, secret)
		return try wrapPrivate(inner, comment)
	}

	// parseKey over the bytes of a key file. Fails as `parseKey(string)`
	// does.
	def parseKey(data byte[], passphrase ?Secret<string> = none) !PrivateKey {
		return try parseKey(string(data), passphrase)
	}

	// loadKey reads a private key file; a leading `~/` is the home
	// folder. Fails when the file cannot be read or `parseKey` fails.
	def loadKey(path string, passphrase ?Secret<string> = none) !PrivateKey {
		let data = try os.readFile(expandHome(path))
		return try parseKey(string(data), passphrase)
	}

	// parsePublicKey reads a public key: an `authorized_keys` or `.pub`
	// line (options before the algorithm are skipped), an RFC 4716
	// `---- BEGIN SSH2 PUBLIC KEY ----` block or a PEM `PUBLIC KEY`.
	// Fails when the text holds no key of a supported type.
	def parsePublicKey(text string) !PublicKey {
		let (inner, blob, comment) = try decodePublicText(text)
		return try wrapPublic(inner, blob, comment)
	}

	// parsePublicKey over a blob in the SSH wire encoding. Fails when the
	// blob holds no key of a supported type.
	def parsePublicKey(blob byte[]) !PublicKey {
		let inner = try decodePublicBlob(blob)
		return try wrapPublic(inner, blob, "")
	}

	// loadPublicKey reads a `.pub` file; a leading `~/` is the home
	// folder. Fails when the file cannot be read or holds no key.
	def loadPublicKey(path string) !PublicKey {
		let data = try os.readFile(expandHome(path))
		return try parsePublicKey(string(data))
	}

	// The KeyKind of an algorithm name; none for another.
	internal def kindFromName(name string) ?KeyKind {
		for let kind in [KeyKind.Ed25519, KeyKind.Ed448, KeyKind.EcdsaP256, KeyKind.EcdsaP384, KeyKind.EcdsaP521, KeyKind.Rsa] {
			return kind when kind.value == name
		}
		return none
	}

	// A PrivateKey around a crypto key.
	internal def wrapPrivate(inner crypto.PrivateKey, comment string) !PrivateKey {
		let pubInner = crypto.publicKeyOf(inner)
		let blob = try encodePublicBlob(pubInner)
		let pub = try wrapPublic(pubInner, blob, comment)
		return new PrivateKey(pub.kind, inner, pub, comment)
	}

	// A PublicKey around a crypto key and its blob, a certificate when
	// the blob is one.
	internal def wrapPublic(inner crypto.PublicKey, blob byte[], comment string) !PublicKey {
		let name = kindName(inner)
		let kind = kindFromName(name)
		fail sshError("key", "unsupported key type {name}") when kind is none
		let blobName = new Reader(blob).readText() onerror recover ""
		return new PublicKey(kind, inner, blob, comment) unless isCertName(blobName)
		let cert = try parseCertificate(blob)
		cert.key.comment = comment
		return new PublicKey(kind, inner, blob, comment, cert)
	}
}
