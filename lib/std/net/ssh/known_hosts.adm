partial module std.net.ssh {
	use (
		std.crypto::(constantTimeEqual, rand)
		std.crypto.hash::(Hash, hmac)
		std.data.encoding
		std.net.ssh.keyformat::*
		std.net.sshwire::*
		std.os
	)

	// HostKeyStatus is what `KnownHosts.status` finds for a host and key.
	enum HostKeyStatus {
		// The host is listed with this key.
		Known   = "known",
		// The host is not listed with a key of this type.
		Unknown = "unknown",
		// The host is listed with another key of this type: the server's
		// key was replaced, or someone is in the middle.
		Changed = "changed",
		// The key is marked `@revoked`.
		Revoked = "revoked",
	}

	// HostKeyPolicy is what a `Client` does with a server key its
	// `KnownHosts` does not list.
	enum HostKeyPolicy {
		// Refuse it: the connection fails.
		Strict    = "strict",
		// Trust it and add it to `knownHosts` (OpenSSH's `accept-new`); a
		// changed key still fails.
		AcceptNew = "accept-new",
		// Trust any key, changed ones included. For tests only: it gives
		// up the protection against a server in the middle.
		Insecure  = "insecure",
	}

	// KnownHosts is an OpenSSH `known_hosts` file: which keys each host
	// may present. Reads plain and hashed (`|1|`) host names, `[host]:port`
	// for ports other than 22, `*` and `?` patterns, `!` negations and
	// `@revoked` lines.
	//
	// ```
	// let hosts = new ssh.KnownHosts()          // ~/.ssh/known_hosts
	// if hosts.status("example.com", key) == ssh.HostKeyStatus.Unknown {
	//     try hosts.add("example.com", key)
	// }
	// ```
	type KnownHosts {
		// The file `add` appends to; "" keeps the list in memory.
		path             string
		// Whether `add` writes hashed host names, as OpenSSH's
		// `HashKnownHosts yes` does.
		hashNames        bool        = false
		internal entries KnownHost[] = []

		// Reads `path` when it exists; a missing or unreadable file gives
		// an empty list. A leading `~/` is the home folder.
		def new(path string = "~/.ssh/known_hosts") {
			self.path = expandHome(path)
			if path != "" {
				let data = os.readFile(self.path) onerror recover byte[]
				parse(string(data))
			}
		}

		// Adds the lines of `text` to the list, in `known_hosts` format.
		def parse(text string) {
			for let raw in text.split("\n") {
				let line = raw.trim()
				continue when line == "" || line.startsWith("#")
				let entry = maybeKnownHost(line) onerror recover none
				entries.push(entry) unless entry is none
			}
		}

		// What the list says about `host` (a name or address, with
		// `:port` when not 22) presenting `key`.
		def status(host string, key PublicKey) HostKeyStatus {
			let name = hostEntryName(host)
			let sameType = false
			for let e in entries {
				continue unless e.matches(name)
				if e.key.equals(key) {
					return HostKeyStatus.Revoked when e.marker == "@revoked"
					return HostKeyStatus.Known when e.marker == ""
				}
				sameType = true when e.marker == "" && e.key.kind == key.kind
			}
			return sameType ?? (HostKeyStatus.Changed, HostKeyStatus.Unknown)
		}

		// Whether a line marked `@cert-authority` trusts `authority` to
		// sign host certificates for `host`, and no `@revoked` line
		// names it.
		def isAuthority(host string, authority PublicKey) bool {
			let name = hostEntryName(host)
			let found = false
			for let e in entries {
				continue unless e.key.equals(authority)
				return false when e.marker == "@revoked"
				found = true when e.marker == "@cert-authority" && e.matches(name)
			}
			return found
		}

		// Trusts `authority` to sign host certificates for the hosts
		// `pattern` matches (`*.example.com`) and appends the
		// `@cert-authority` line to `path`. Fails when the file cannot be
		// written.
		def addAuthority(pattern string, authority PublicKey) !none {
			let line = "@cert-authority " + pattern + " " + authority.algorithm() + " " + encoding.base64encode(authority.blob())
			entries.push(try parseKnownHost(line))
			return none when path == ""
			let existing = os.readFile(path) onerror recover byte[]
			let text = string(existing)
			text += "\n" when text != "" && !text.endsWith("\n")
			try os.writeFile(path, (text + line + "\n").bytes())
			return none
		}

		// The keys listed for `host`.
		def keys(host string) PublicKey[] {
			let name = hostEntryName(host)
			let out PublicKey[] = []
			for let e in entries {
				out.push(e.key) when e.marker == "" && e.matches(name)
			}
			return out
		}

		// Lists `key` for `host` and appends the line to `path`. Fails
		// when the file cannot be written.
		def add(host string, key PublicKey) !none {
			let name = hostEntryName(host)
			let field = name
			if hashNames {
				let salt = try rand(20)
				field = "|1|" + encoding.base64encode(salt) + "|" + encoding.base64encode(hmac(Hash.SHA1, salt, name.bytes()))
			}
			let line = field + " " + key.algorithm() + " " + encoding.base64encode(key.blob())
			let entry = try parseKnownHost(line)
			entries.push(entry)
			return none when path == ""
			let existing = os.readFile(path) onerror recover byte[]
			let text = string(existing)
			text += "\n" when text != "" && !text.endsWith("\n")
			try os.writeFile(path, (text + line + "\n").bytes())
			return none
		}

		// Drops every line naming `host` and rewrites `path`, as
		// `ssh-keygen -R` does. Returns how many were dropped. Fails when
		// the file cannot be written.
		def remove(host string) !int {
			let name = hostEntryName(host)
			let kept KnownHost[] = []
			for let e in entries {
				kept.push(e) unless e.names(name)
			}
			let dropped = entries.len() - kept.len()
			entries = kept
			return dropped when path == "" || dropped == 0
			let lines string[] = []
			for let e in entries {
				lines.push(e.line)
			}
			try os.writeFile(path, (lines.join("\n") + "\n").bytes())
			return dropped
		}

		// The list in `known_hosts` format.
		def str() string {
			let lines string[] = []
			for let e in entries {
				lines.push(e.line)
			}
			return lines.join("\n")
		}
	}

	// The name a host is listed under: `host`, or `[host]:port` when
	// the port is not 22.
	internal def hostEntryName(host string) string {
		return host.lower() when host.startsWith("[")
		let colon = host.indexOf(":")
		// A bare IPv6 address has several colons and no port.
		return host.lower() when colon < 0 || host[colon + 1:].contains(":")
		let port = host[colon + 1:]
		return host[:colon].lower() when port == "22"
		return "[" + host[:colon].lower() + "]:" + port
	}

	// KnownHost is one line of a known_hosts file.
	internal type KnownHost {
		line     string
		marker   string    = ""
		patterns string[]  = []
		salt     byte[]    = []
		hashed   byte[]    = []
		key      PublicKey

		def new(line string, key PublicKey) {
			self.line = line
			self.key = key
		}

		// Whether the line applies to `name`: a hashed name that matches,
		// or a pattern that matches with no negated one matching.
		def matches(name string) bool {
			return constantTimeEqual(hmac(Hash.SHA1, salt, name.bytes()), hashed) when hashed.len() > 0
			let hit = false
			for let p in patterns {
				if p.startsWith("!") {
					return false when globMatch(p[1:], name)
					continue
				}
				hit = true when globMatch(p, name)
			}
			return hit
		}

		// Whether the line names `name` exactly (for `remove`).
		def names(name string) bool {
			return matches(name) when hashed.len() > 0
			return patterns.includes(name)
		}
	}

	internal def maybeKnownHost(line string) !?KnownHost {
		return try parseKnownHost(line)
	}

	internal def parseKnownHost(line string) !KnownHost {
		let fields = line.split(" ").filter(p => p != "")
		let at = 0
		let marker = ""
		if fields.len() > 0 && fields[0].startsWith("@") {
			marker = fields[0]
			at = 1
		}
		fail sshError("key", "short known_hosts line") when fields.len() < at + 3
		let key = try parsePublicKey(fields[at + 1] + " " + fields[at + 2])
		let entry = new KnownHost(line, key)
		entry.marker = marker
		let hosts = fields[at]
		if hosts.startsWith("|1|") {
			let parts = hosts.split("|")
			fail sshError("key", "bad hashed host name") when parts.len() != 4
			entry.salt = try encoding.base64decode(parts[2])
			entry.hashed = try encoding.base64decode(parts[3])
		} else {
			entry.patterns = hosts.lower().split(",")
		}
		return entry
	}

	// `*` any run of characters, `?` one character.
	internal def globMatch(pattern string, text string) bool {
		let p = pattern.bytes()
		let t = text.bytes()
		let pat = 0
		let ti = 0
		let star = -1
		let mark = 0
		for ti < t.len() {
			if pat < p.len() && (p[pat] == byte(63) || p[pat] == t[ti]) {
				pat++
				ti++
			} else if pat < p.len() && p[pat] == byte(42) {
				star = pat
				mark = ti
				pat++
			} else if star >= 0 {
				pat = star + 1
				mark++
				ti = mark
			} else {
				return false
			}
		}
		for pat < p.len() && p[pat] == byte(42) {
			pat++
		}
		return pat == p.len()
	}
}
