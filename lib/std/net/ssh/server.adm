partial module std.net.ssh {
	use (
		std.crypto::(constantTimeEqual)
		std.metrics
		std.net
		std.net.ssh.host::*
		std.os
		std.services.policy::(Policy)
		std.services.diagnostics::(metric)
		std.net.ssh.keyformat::(expandHome)
		std.net.sshwire::(sshError)
	)

	// Handler serves one session: a shell, a command or a subsystem.
	interface Handler {
		// Fails with whatever went wrong; the client sees the message on
		// its error output and exit code 1.
		def serve(session Session) !none
	}

	// HandlerFunc makes a closure a `Handler`.
	//
	// ```
	// let server = new ssh.Server(new ssh.HandlerFunc(def (s ssh.Session) !none {
	//     try s.write("hello {s.user()}, you ran {s.command()}\n")
	//     return none
	// }), ":2222")
	// ```
	type HandlerFunc {
		fn def (Session) !none

		def new(fn def (Session) !none) {
			self.fn = fn
		}

		// Implements Handler. Fails as the closure does.
		def serve(session Session) !none {
			return fn(session)
		}
	}

	// Users is an `Authenticator` over fixed lists of passwords and
	// public keys.
	//
	// ```
	// let users = new ssh.Users()
	// users.add("alice", "s3cret")
	// try users.addKeys("bob", "/home/bob/.ssh/authorized_keys")
	// server.authenticator = users
	// ```
	type Users {
		internal passwords map<string, Secret<string>>
		internal keys      map<string, PublicKey[]>

		def new() {}

		// Lets `user` log in with `password`, replacing an earlier one.
		atomic def add(user string, password Secret<string>) {
			passwords[user] = password
		}

		// Lets `user` log in with `key`.
		atomic def addKey(user string, key PublicKey) {
			let list = keys.get(user)
			let held PublicKey[] = list is none ?? ([], list)
			held.push(key)
			keys[user] = held
		}

		// Lets `user` log in with every key of an `authorized_keys` file.
		// Options before a key are not enforced. Fails when the file
		// cannot be read; lines that hold no key are skipped.
		def addKeys(user string, path string) !none {
			let text = string(try os.readFile(expandHome(path)))
			for let line in text.split("\n") {
				let trimmed = line.trim()
				continue when trimmed == "" || trimmed.startsWith("#")
				let key = optionalKeyText(trimmed) onerror recover none
				addKey(user, key) unless key is none
			}
			return none
		}

		// Forgets `user`'s password and keys.
		atomic def remove(user string) {
			passwords.delete(user)
			keys.delete(user)
		}

		// Implements Authenticator. Fails when the user has no password or
		// it does not match.
		atomic def password(user string, password Secret<string>) !none {
			let want = passwords.get(user)
			fail "login refused" when want is none
			fail "login refused" unless sameSecret(want.reveal(), password.reveal())
			return none
		}

		// Implements Authenticator. Fails when the key is not listed for
		// the user.
		atomic def publicKey(user string, key PublicKey) !none {
			let held = keys.get(user)
			fail "login refused" when held is none
			for let k in held {
				return none when k.equals(key)
			}
			fail "login refused"
		}
	}

	internal def optionalKeyText(text string) !?PublicKey {
		return try parsePublicKey(text)
	}

	// Compares two strings in time that depends on their lengths only.
	internal def sameSecret(a string, b string) bool {
		return constantTimeEqual(a.bytes(), b.bytes())
	}

	// Session is one session on a `Server`, handed to the `Handler`: who
	// logged in, what they asked to run, their terminal, and the streams.
	// Reading reads the client's input; writing writes its output.
	// Implements `net.Stream`.
	type Session {
		internal state SessionState

		def new(state SessionState) {
			self.state = state
		}

		// The user who logged in.
		def user() string {
			return state.user
		}

		// The public key the user logged in with; none for a password.
		def key() ?PublicKey {
			return state.key
		}

		// The command the client asked to run; "" for a shell or a
		// subsystem.
		def command() string {
			return state.command
		}

		// The subsystem the client asked for (`sftp`); "" otherwise.
		def subsystem() string {
			return state.subsystem
		}

		// The pseudo-terminal the client asked for; none without one.
		def terminal() ?Terminal {
			return state.terminal
		}

		// The environment variables the client sent.
		def environment() map<string, string> {
			return state.environment
		}

		// The client's address.
		def remoteAddr() net.Address {
			return state.remote
		}

		// Reads the client's input, waiting up to `timeout` (0 without
		// end); 0 once the client closed its input. Fails when the
		// connection breaks or the wait times out.
		def read(data byte[], timeout duration) !int {
			return try state.channel.read(data, false, timeout)
		}

		// read without a deadline. Implements io.Reader. Fails when the
		// connection breaks.
		def read(data byte[]) !int {
			return try state.channel.read(data, false, waitForever)
		}

		// The next line of input without its line ending. Fails when the
		// input ends first or the connection breaks.
		def readLine(timeout duration = 0s) !string {
			return try state.lines().readLine(timeout)
		}

		// Writes to the client's output. Fails when the client closed the
		// session.
		def write(data byte[], timeout duration) !int {
			return try state.channel.write(data, false, timeout)
		}

		// write without a deadline. Implements io.Writer. Fails when the
		// client closed the session.
		def write(data byte[]) !int {
			return try state.channel.write(data, false, waitForever)
		}

		// write of text as UTF-8; a terminal session gets `\r\n` for each
		// `\n`, as terminals need. Fails when the client closed the session.
		def write(text string) !int {
			let out = state.terminal is none ?? (text, text.replace("\r\n", "\n").replace("\n", "\r\n"))
			return try state.channel.write(out.bytes(), false, waitForever)
		}

		// Writes to the client's error output. Fails when the client
		// closed the session.
		def writeErrors(data byte[]) !int {
			return try state.channel.write(data, true, waitForever)
		}

		// writeErrors of text as UTF-8. Fails when the client closed the
		// session.
		def writeErrors(text string) !int {
			return try writeErrors(text.bytes())
		}

		// Ends the session with an exit code; the handler returning ends
		// it with 0 unless it called `exit`. Fails when the connection
		// breaks.
		def exit(code int) !none {
			return try state.exitWith(code)
		}

		// Calls `fn` with the new columns and rows each time the client's
		// terminal changes size.
		def onResize(fn def (int, int)) {
			state.addResize(fn)
		}

		// Calls `fn` with each signal the client sends.
		def onSignal(fn def (Signal)) {
			state.addSignal(fn)
		}

		// Implements net.Stream.
		def isOpen() bool {
			return !state.exited && !state.channel.peerClosed
		}

		// Implements net.Stream: ends the session with exit code 0.
		// Never fails.
		def close() !none {
			state.exitWith(0) onerror recover none
			return none
		}
	}

	// Server is an SSH server: it proves itself with `hostKeys`, logs
	// users in through `authenticator`, and runs `handler` for each
	// shell or command in its own task, the `subsystems` handlers for
	// subsystems. Forwarding is off unless allowed. Implements
	// `net.Server`: `start` returns at once and `close` stops it;
	// `listenAndServe` is the blocking form, `serve` the form over a
	// listener the caller made.
	//
	// ```
	// let server = new ssh.Server(new ssh.HandlerFunc(def (s ssh.Session) !none {
	//     try s.write("hello {s.user()}\n")
	//     return none
	// }), ":2222")
	// server.hostKeys.push(try ssh.loadKey("/etc/myapp/host_key"))
	// let users = new ssh.Users()
	// users.add("alice", "s3cret")
	// server.authenticator = users
	// try server.listenAndServe()
	// ```
	type Server {
		addr string = ":22"
		// The keys the server proves itself with; at least one.
		hostKeys PrivateKey[] = []
		// Certificates of `hostKeys` signed by a certificate authority
		// (`ssh-keygen -s ca -h`): a client that trusts the authority
		// accepts the server without knowing its key.
		hostCertificates Certificate[] = []
		// Certificate authorities whose user certificates log in, as
		// OpenSSH's `TrustedUserCAKeys`: a certificate valid now that
		// lists the user name gets in without the authenticator. Its
		// critical options (`force-command`, `source-address`) and
		// permissions (`permit-pty`, `permit-port-forwarding`) are
		// enforced.
		userAuthorities PublicKey[] = []
		handler ?Handler = none
		// Handlers by subsystem name (`sftp`).
		subsystems map<string, Handler>
		// Decides the logins; without one anyone gets in, as any user.
		authenticator ?Authenticator = none
		// Text shown to clients before they log in.
		banner string = ""
		algorithms Algorithms
		// Let clients open connections from the server (`ssh -L`, `-W`).
		allowForwarding bool = false
		// Let clients have the server listen for them (`ssh -R`).
		allowRemoteForwarding bool = false
		// Bytes after which the session keys are replaced (OpenSSH's
		// `RekeyLimit`).
		rekeyLimit int64 = 1073741824
		// Failed logins before a connection is dropped.
		maxAuthTries int = 6
		// How long the key exchange and the login may take.
		timeout duration = 60s
		// Connections served at once; one past it is refused. 0 is no limit.
		maxConnections int = 0
		backlog int = 128
		internal listener ?net.Listener = none
		internal atomic running bool = false
		internal atomic open Connection[] = []
		// Shared by every server of the process.
		@metric("net.ssh.server.connections.open")
		internal connectionsOpen metrics.Gauge
		@metric("net.ssh.server.connections.total")
		internal connectionsTotal metrics.Counter
		@metric("net.ssh.server.logins.failed")
		internal loginsFailed metrics.Counter

		def new(handler Handler, addr string = ":22") {
			self.handler = handler
			self.addr = addr
		}

		// A server with no shell handler, for subsystems alone.
		def new(addr string = ":22") {
			self.addr = addr
		}

		// Binds `addr` and serves until `close`.
		// Fails with PolicyDenied when the policy denies listening there,
		// NetError when the address cannot be bound, or when no host key
		// is set.
		def listenAndServe() !none {
			let ln = try bind()
			return try serve(ln)
		}

		// Accepts on the listener until it closes; each connection runs in
		// its own task. Returns none after `close`.
		// Fails with NetError when an accept fails for another reason, or
		// when no host key is set.
		def serve(ln net.Listener) !none {
			try needKeys()
			fail sshError("closed", "server is already serving") when running
			listener = ln
			running = true
			for running {
				let failure ?error = none
				let accepted = tryAccept(ln) onerror (err error) {
					failure = err
					recover none
				}
				if !(failure is none) {
					return none unless running
					fail failure
				}
				continue when accepted is none
				if !running {
					accepted.close() onerror recover none
					return none
				}
				if maxConnections > 0 && open.len() >= maxConnections {
					accepted.close() onerror recover none
					continue
				}
				let c = new Connection(accepted, self.config())
				track(c)
				let task = async runConnection(c)
				task.keepAlive()
			}
			return none
		}

		// Implements net.Server: binds and serves in the background.
		// Fails with PolicyDenied or NetError when the address cannot be
		// bound, or when no host key is set.
		def start() !none {
			return none when running
			try needKeys()
			let ln = try bind()
			listener = ln
			let task = async serveInBackground(ln)
			task.keepAlive()
			return none
		}

		// Implements net.Server: stops accepting and ends every
		// connection. A second call does nothing. Never fails.
		def close() !none {
			running = false
			let ln = listener
			listener = none
			if !(ln is none) {
				ln.close() onerror recover none
			}
			for let c in takeConnections() {
				c.end()
			}
			return none
		}

		// Implements net.Server: the bound address, or `addr` parsed
		// before `start`.
		def address() net.Address {
			let ln = listener
			return ln.address() unless ln is none
			return net.parseAddress(addr) onerror recover new net.Address()
		}

		// Connections open right now.
		def connectionCount() int {
			return open.len()
		}

		internal def config() ServerConfig {
			return ServerConfig{
				hostKeys:              hostKeys,
				hostCertificates:      hostCertificates,
				userAuthorities:       userAuthorities,
				handler:               handler,
				subsystems:            subsystems,
				authenticator:         authenticator,
				banner:                banner,
				algorithms:            algorithms,
				allowForwarding:       allowForwarding,
				allowRemoteForwarding: allowRemoteForwarding,
				maxAuthTries:          maxAuthTries,
				timeout:               timeout,
			}
		}

		internal def needKeys() !none {
			fail sshError("config", "the server has no host key: add one, e.g. `server.hostKeys.push(try ssh.generateKey())`, or load a saved one with `ssh.loadKey(path)`") when hostKeys.len() == 0
			return none
		}

		internal def serveInBackground(ln net.Listener) {
			serve(ln) onerror recover none
		}

		internal def runConnection(c Connection) {
			let ok = c.run()
			loginsFailed.inc() unless ok
			untrack(c)
		}

		internal def tryAccept(ln net.Listener) !?net.Connection {
			return try ln.accept()
		}

		internal atomic def track(c Connection) {
			open.push(c)
			connectionsOpen.inc()
			connectionsTotal.inc()
		}

		internal atomic def untrack(c Connection) {
			let kept Connection[] = []
			for let x in open {
				kept.push(x) unless x == c
			}
			connectionsOpen.dec() when kept.len() < open.len()
			open = kept
		}

		internal atomic def takeConnections() Connection[] {
			let all = open
			open = []
			connectionsOpen.update(connectionsOpen.value() - float64(all.len()))
			return all
		}

		// Binds `addr` once the `listen` permission allows `ssh://addr`.
		internal def bind() !net.Listener {
			try Policy.validate("adm.network.listen", "std.services.policy.EndpointSpec", "ssh://" + addr)
			let a = net.parseAddress(addr) onerror recover new net.Address()
			let domain = a.isIPv6 ?? (net.SocketDomain.IPv6, net.SocketDomain.IPv4)
			let sock = try net.socket(domain, net.SocketType.Stream)
			sock.setReuseAddr(true) onerror recover none
			try sock.bind(addr)
			return try sock.listen(backlog)
		}

		// Names the server and its address.
		def str() string {
			return "ssh.Server({addr})"
		}
	}
}
