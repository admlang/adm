partial module std.net.ssh {
	use std.errors

	// SshError is the payload of every SSH failure. `code` names the
	// kind: `protocol` (a malformed or unexpected message), `kex` (no
	// common algorithm, a bad signature), `hostkey` (the server's key is
	// unknown or changed), `auth` (every method refused), `channel` (an
	// open or request refused), `disconnect` (the peer ended the
	// connection) or `closed` (used after `close`).
	struct SshError {
		message string
		code    string
		cause   ?error
		stack   errors.StackTrace
		// The disconnect reason the peer sent (RFC 4250 §4.2.2), or why a
		// channel open was refused (§4.3); 0 when neither.
		reason  int
	}

	// KeyKind is the algorithm of a key.
	enum KeyKind {
		Ed25519   = "ssh-ed25519",
		EcdsaP256 = "ecdsa-sha2-nistp256",
		EcdsaP384 = "ecdsa-sha2-nistp384",
		EcdsaP521 = "ecdsa-sha2-nistp521",
		Rsa       = "ssh-rsa",
	}

	// Result is what `Client.run` returns: what the command wrote and how
	// it ended.
	struct Result {
		// Its standard output.
		output string
		// Its standard error.
		errors string
		// Its exit code; 0 means success, -1 when it was killed by a
		// signal or the server did not say.
		code   int
		// The signal that killed it (`TERM`, `KILL`, ...), or "".
		signal string
	}

	// Signal is a POSIX signal sent to a remote process (RFC 4254 §6.10).
	enum Signal {
		Abort     = "ABRT",
		Alarm     = "ALRM",
		FloatingPoint = "FPE",
		Hangup    = "HUP",
		Illegal   = "ILL",
		Interrupt = "INT",
		Kill      = "KILL",
		Pipe      = "PIPE",
		Quit      = "QUIT",
		Segfault  = "SEGV",
		Terminate = "TERM",
		User1     = "USR1",
		User2     = "USR2",
	}

	// Terminal describes a pseudo-terminal asked for with a shell or a
	// command (RFC 4254 §6.2).
	struct Terminal {
		// The terminal type, the TERM environment variable.
		name    string        = "xterm-256color"
		columns int           = 80
		rows    int           = 24
		// Size in pixels; 0 when unknown.
		width   int           = 0
		height  int           = 0
		// Terminal modes (RFC 4254 §8) by opcode; empty for the server's
		// defaults.
		modes   map<int, int>
	}

	// Algorithms are the algorithms a `Client` or `Server` offers, each
	// list in order of preference. The defaults are what OpenSSH offers,
	// minus what it has deprecated; drop names to narrow them. Unknown
	// names are ignored.
	struct Algorithms {
		// Key exchange methods.
		kex         string[] = ["mlkem768x25519-sha256", "curve25519-sha256", "curve25519-sha256@libssh.org", "ecdh-sha2-nistp256", "ecdh-sha2-nistp384", "ecdh-sha2-nistp521", "diffie-hellman-group-exchange-sha256", "diffie-hellman-group16-sha512", "diffie-hellman-group18-sha512", "diffie-hellman-group14-sha256"]
		// Server host key signature algorithms.
		hostKeys    string[] = ["ssh-ed25519-cert-v01@openssh.com", "ecdsa-sha2-nistp256-cert-v01@openssh.com", "ecdsa-sha2-nistp384-cert-v01@openssh.com", "ecdsa-sha2-nistp521-cert-v01@openssh.com", "rsa-sha2-512-cert-v01@openssh.com", "rsa-sha2-256-cert-v01@openssh.com", "ssh-ed25519", "ecdsa-sha2-nistp256", "ecdsa-sha2-nistp384", "ecdsa-sha2-nistp521", "rsa-sha2-512", "rsa-sha2-256"]
		// Ciphers, the same list both ways.
		ciphers     string[] = ["chacha20-poly1305@openssh.com", "aes128-gcm@openssh.com", "aes256-gcm@openssh.com", "aes128-ctr", "aes192-ctr", "aes256-ctr"]
		// Message authentication codes, for the ciphers that need one
		// (the CTR ciphers).
		macs        string[] = ["hmac-sha2-256-etm@openssh.com", "hmac-sha2-512-etm@openssh.com", "hmac-sha2-256", "hmac-sha2-512", "hmac-sha1-etm@openssh.com", "hmac-sha1"]
		// Compression methods: `zlib@openssh.com` compresses once the
		// user logged in, `zlib` from the first key exchange (RFC 4253
		// §6.2). A client gets what it lists first and the server also
		// offers; put a zlib method first to compress, which pays on slow
		// links and costs CPU on fast ones.
		compression string[] = ["none", "zlib@openssh.com", "zlib"]
	}

	// Negotiation is what the last key exchange of a connection settled
	// on; "out" is what this side sends, "in" what it receives.
	struct Negotiation {
		kex            string
		hostKey        string
		cipherOut      string
		cipherIn       string
		// `none` for an AEAD cipher, which authenticates on its own.
		macOut         string
		macIn          string
		// `zlib@openssh.com` runs from the login on, `zlib` from the
		// first key exchange.
		compressionOut string
		compressionIn  string
	}

	// Signer is an identity a `Client` logs in with: a `PrivateKey`, or
	// a key an `Agent` holds.
	interface Signer {
		// The public half the server checks against.
		def publicKey() PublicKey
		// An SSH signature blob over `data` with the named algorithm.
		// Fails when the key cannot sign with it.
		def sign(data byte[], algorithm string) !byte[]
	}

	// Authenticator decides the logins of a `Server`. Each method fails
	// to refuse; the client learns only that the method failed.
	interface Authenticator {
		// A password login (also keyboard-interactive, which asks for the
		// password).
		def password(user string, password Secret<string>) !none
		// A public key login; the client already proved it holds the
		// private key.
		def publicKey(user string, key PublicKey) !none
	}

	// Prompt is one question of a keyboard-interactive login (RFC 4256).
	struct Prompt {
		text string
		// Whether the answer may be shown as it is typed.
		echo bool
	}

	// Challenge is what a server asks in one keyboard-interactive round.
	struct Challenge {
		name        string
		instruction string
		prompts     Prompt[]
	}
}
