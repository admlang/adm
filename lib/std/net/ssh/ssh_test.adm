partial module std.net.ssh {
	use (
		std.io
		std.net
		std.testing
		std.time
	)

	// A test server on a free loopback port: commands echo, copy their
	// input, fail or exit with a code; `tty` names the terminal.
	internal def testServer(host PrivateKey) !Server {
		let server = new Server(new HandlerFunc(def (s Session) !none {
			let cmd = s.command()
			if cmd == "cat" {
				try io.copy(s, s)
				return none
			}
			fail "it went wrong" when cmd == "fail"
			if cmd.startsWith("exit ") {
				try s.write("bye\n")
				try s.exit(cmd[5:].toInt<int>())
				return none
			}
			if cmd == "tty" {
				let term = s.terminal()
				let name = term is none ?? ("none", "{term.name} {term.columns}x{term.rows}")
				let lang = s.environment().get("LANG")
				let langText = lang is none ?? ("", lang)
				try s.write("{name} {langText}\n")
				return none
			}
			if cmd == "who" {
				let key = s.key()
				try s.write("{s.user()} {key is none ?? ("password", key.kind.value)}\n")
				return none
			}
			if cmd.startsWith("cert ") {
				let original = s.environment().get("SSH_ORIGINAL_COMMAND")
				let tail = original is none ?? ("-", original)
				let key = s.key()
				let cert = key is none ?? (none, key.certificate())
				if cert is none {
					try s.write("none {tail}\n")
					return none
				}
				try s.write("{cert.keyId} {tail}\n")
				return none
			}
			if cmd == "wait-signal" {
				let got = new channel<string>(1)
				s.onSignal(def (sig Signal) {
					got <- sig.value
				})
				try s.write("ready\n")
				let name = <-got
				try s.write("got {name}\n")
				return none
			}
			try s.write("{cmd}\n")
			try s.writeErrors("to stderr\n")
			return none
		}), "127.0.0.1:0")
		server.hostKeys.push(host)
		let users = new Users()
		users.add("alice", "s3cret")
		server.authenticator = users
		server.subsystems["upper"] = new HandlerFunc(def (s Session) !none {
			let line = try s.readLine()
			try s.write(line.upper() + "\n")
			return none
		})
		try server.start()
		return server
	}

	// Whether `f` fails.
	internal def refuses(f def () !none) bool {
		let failed = false
		f() onerror (err error) {
			failed = true
			recover none
		}
		return failed
	}

	internal def testClient() Client {
		let client = new Client()
		client.hostKeyPolicy = HostKeyPolicy.Insecure
		client.useAgent = false
		return client
	}

	internal async def echoLine(ln net.Listener) !none {
		let conn = try ln.accept()
		let line = try new net.LineReader(conn).readLine(10s)
		try conn.writeAll("echo {line}\n".bytes())
		return try conn.close()
	}

	check "Keys" {
		@test()
		def generatesSignsAndEncodes() !none {
			for let kind in [KeyKind.Ed25519, KeyKind.Ed448, KeyKind.EcdsaP256, KeyKind.EcdsaP384, KeyKind.EcdsaP521] {
				let key = try generateKey(kind, comment = "t@host")
				let signature = try key.sign("data".bytes())
				assert key.publicKey().verify("data".bytes(), signature)
				assert !key.publicKey().verify("other".bytes(), signature)
				let plain = try parseKey(try key.encode())
				assert plain.publicKey().equals(key.publicKey())
				assert plain.comment == "t@host"
				let sealed = try key.encode("pass")
				let back = try parseKey(sealed, "pass")
				assert back.publicKey().equals(key.publicKey())
				let refused = false
				parseKey(sealed, "wrong") onerror (err error) {
					refused = true
					recover key
				}
				assert refused
				assert key.publicKey().fingerprint().startsWith("SHA256:")
			}
			return none
		}

		@test()
		def rsaSignsWithEachAlgorithm() !none {
			let key = try generateKey(KeyKind.Rsa, 2048)
			for let algorithm in ["rsa-sha2-512", "rsa-sha2-256", "ssh-rsa"] {
				let signature = try key.sign("data".bytes(), algorithm)
				assert key.publicKey().verify("data".bytes(), signature)
			}
			return none
		}

		@test()
		def readsPublicKeyForms() !none {
			let key = try generateKey()
			let line = key.publicKey().str()
			let fromLine = try parsePublicKey("no-pty,command=\"x\" " + line + " me@there")
			assert fromLine.equals(key.publicKey())
			assert fromLine.comment == "me@there"
			let blob = key.publicKey().blob()
			assert (try parsePublicKey(blob)).equals(key.publicKey())
			let body = line.split(" ")[1]
			let rfc = "---- BEGIN SSH2 PUBLIC KEY ----\nComment: \"a comment\"\n" + body + "\n---- END SSH2 PUBLIC KEY ----\n"
			let fromRfc = try parsePublicKey(rfc)
			assert fromRfc.equals(key.publicKey())
			assert fromRfc.comment == "a comment"
			return none
		}
	}

	check "KnownHosts" {
		@test()
		def matchesHostsAndKeys() !none {
			let a = (try generateKey()).publicKey()
			let b = (try generateKey()).publicKey()
			let hosts = new KnownHosts("")
			hosts.parse("example.com,10.0.0.1 {a.str()}\n*.corp.net,!evil.corp.net {a.str()}\n@revoked old.example.com {b.str()}\n")
			assert hosts.status("example.com", a) == HostKeyStatus.Known
			assert hosts.status("10.0.0.1:22", a) == HostKeyStatus.Known
			assert hosts.status("example.com", b) == HostKeyStatus.Changed
			assert hosts.status("other.com", a) == HostKeyStatus.Unknown
			assert hosts.status("db.corp.net", a) == HostKeyStatus.Known
			assert hosts.status("evil.corp.net", a) == HostKeyStatus.Unknown
			assert hosts.status("old.example.com", b) == HostKeyStatus.Revoked
			hosts.hashNames = true
			try hosts.add("secret.host:2222", b)
			assert hosts.status("secret.host:2222", b) == HostKeyStatus.Known
			assert hosts.status("secret.host", b) == HostKeyStatus.Unknown
			assert hosts.str().contains("|1|")
			assert (try hosts.remove("example.com")) == 1
			assert hosts.status("example.com", a) == HostKeyStatus.Unknown
			return none
		}
	}

	check "Certificates" {
		@test()
		def issuesReadsAndValidates() !none {
			for let caKind in [KeyKind.Ed25519, KeyKind.Rsa] {
				let ca = try generateKey(caKind, 2048)
				let user = try generateKey(KeyKind.EcdsaP256, comment = "alice@laptop")
				let options = CertificateOptions{keyId: "alice-1", principals: ["alice", "ops"], serial: 42, validBefore: time.now() + 1h}
				options.criticalOptions["source-address"] = "10.0.0.0/8,127.0.0.1"
				let cert = try ca.certify(user.publicKey(), CertificateKind.User, options)
				assert cert.verify()
				let line = cert.str()
				assert line.startsWith("ecdsa-sha2-nistp256-cert-v01@openssh.com ")
				let back = try parsePublicKey(line)
				let read = back.certificate()
				fail "no certificate read back" when read is none
				assert back.algorithm() == "ecdsa-sha2-nistp256-cert-v01@openssh.com"
				assert back.fingerprint() == user.publicKey().fingerprint()
				assert read.key.equals(user.publicKey()) && read.authority.equals(ca.publicKey())
				assert read.keyId == "alice-1" && read.serial == uint64(42) && read.principals.len() == 2
				assert read.kind == CertificateKind.User && read.permits("permit-pty")
				assert read.validAfter is none && !(read.validBefore is none)
				try read.validate(CertificateKind.User, "ops")
				let wrong = ""
				read.validate(CertificateKind.User, "mallory") onerror (err error) {
					wrong = err.code
					recover none
				}
				assert wrong == "certificate"
				let late = false
				read.validate(CertificateKind.User, "alice", time.now() + 2h) onerror (err error) {
					late = true
					recover none
				}
				assert late
				let asHost = false
				read.validate(CertificateKind.Host, "alice") onerror (err error) {
					asHost = true
					recover none
				}
				assert asHost
				assert read.allowsSource(try net.parseAddress("10.1.2.3:5")) && read.allowsSource(try net.parseAddress("127.0.0.1:5"))
				assert !read.allowsSource(try net.parseAddress("192.168.1.1:5"))
				// A flipped byte in the signed part breaks the signature.
				let bad = cert.blob().clone()
				bad[60] = bad[60] ^ byte(1)
				let tampered = try parsePublicKey(bad)
				let tamperedCert = tampered.certificate()
				assert !(tamperedCert is none) && !tamperedCert.verify()
			}
			let refused = false
			let ca = try generateKey()
			let cert = try ca.certify((try generateKey()).publicKey(), CertificateKind.Host)
			ca.certify(cert.publicKey(), CertificateKind.User) onerror (err error) {
				refused = true
				recover cert
			}
			assert refused
			// A host certificate listing nobody is valid for any host.
			try cert.validate(CertificateKind.Host, "anything.example")
			return none
		}

		@test()
		def logsInAndProvesHosts() !none {
			let ca = try generateKey()
			let host = try generateKey()
			let server = try testServer(host)
			server.allowForwarding = true
			server.userAuthorities.push(ca.publicKey())
			server.hostCertificates.push(try ca.certify(host.publicKey(), CertificateKind.Host, CertificateOptions{principals: ["127.0.0.1"]}))
			let user = try generateKey()
			let cert = try ca.certify(user.publicKey(), CertificateKind.User, CertificateOptions{keyId: "bob-cert", principals: ["bob"]})
			// The client trusts the authority, not the host key.
			let hosts = new KnownHosts("")
			try hosts.addAuthority("[127.0.0.1]:*", ca.publicKey())
			let client = new Client()
			client.useAgent = false
			client.knownHosts = hosts
			try client.connect(server.address().str(), "bob", try user.withCertificate(cert))
			let n = client.negotiation()
			assert !(n is none) && n.hostKey == "ssh-ed25519-cert-v01@openssh.com"
			assert (try client.output("cert x")) == "bob-cert -\n"
			try client.close()
			// Not listed as a principal: refused.
			let other = new Client()
			other.useAgent = false
			other.knownHosts = hosts
			let code = ""
			other.connect(server.address().str(), "carol", try user.withCertificate(cert)) onerror (err error) {
				code = err.code
				recover none
			}
			assert code == "auth"
			// A forced command without a terminal or forwarding.
			let options = CertificateOptions{keyId: "locked", principals: ["bob"], extensions: map<string, string>{}}
			options.criticalOptions["force-command"] = "cert forced"
			let locked = try ca.certify(user.publicKey(), CertificateKind.User, options)
			let limited = new Client()
			limited.useAgent = false
			limited.knownHosts = hosts
			try limited.connect(server.address().str(), "bob", try user.withCertificate(locked))
			assert (try limited.output("rm -rf /")) == "locked rm -rf /\n"
			assert refuses(def () !none {
				try limited.start("tty", Terminal{})
				return none
			})
			assert refuses(def () !none {
				try limited.dial("127.0.0.1:1")
				return none
			})
			try limited.close()
			// Another authority's host certificate falls back to the host key,
			// which a strict client does not know.
			let stranger = new Client()
			stranger.useAgent = false
			let unrelated = new KnownHosts("")
			try unrelated.addAuthority("[127.0.0.1]:*", (try generateKey()).publicKey())
			stranger.knownHosts = unrelated
			let hostCode = ""
			stranger.connect(server.address().str(), "alice", "s3cret") onerror (err error) {
				hostCode = err.code
				recover none
			}
			assert hostCode == "hostkey"
			try server.close()
			return none
		}
	}

	check "Client and Server" {
		@test()
		def runsCommands() !none {
			let server = try testServer(try generateKey())
			let client = testClient()
			try client.connect(server.address().str(), "alice", "s3cret")
			let r = try client.run("hello")
			assert r.output == "hello\n"
			assert r.errors == "to stderr\n"
			assert r.code == 0
			let exited = try client.run("exit 7")
			assert exited.output == "bye\n"
			assert exited.code == 7
			let failed = try client.run("fail")
			assert failed.code == 1
			assert failed.errors.contains("it went wrong")
			assert (try client.run("cat", "piped in")).output == "piped in"
			assert (try client.output("who")) == "alice password\n"
			let refused = ""
			client.output("fail") onerror (err error) {
				refused = err.code
				recover ""
			}
			assert refused == "exit"
			try client.close()
			try server.close()
			return none
		}

		@test()
		def movesMegabytesAcrossKeyChanges() !none {
			let server = try testServer(try generateKey())
			server.rekeyLimit = 262144
			let client = testClient()
			client.rekeyLimit = 262144
			try client.connect(server.address().str(), "alice", "s3cret")
			let data byte[] = []
			data.len(3000000)
			for let i = 0; i < data.len(); i++ {
				data[i] = byte(65 + i % 26)
			}
			let r = try client.run("cat", data)
			assert r.output.len() == data.len()
			assert r.output.bytes().equals(data)
			try client.close()
			try server.close()
			return none
		}

		@test()
		def compressesAcrossKeyChanges() !none {
			let server = try testServer(try generateKey())
			server.rekeyLimit = 65536
			let data byte[] = []
			// Half-random text: it compresses, but not below the rekey limit.
			data.len(600000)
			let state = 7
			for let i = 0; i < data.len(); i++ {
				state = (state * 1103515245 + 12345) % 2147483648
				data[i] = byte(65 + (state >> 16) % 16)
			}
			for let method in ["zlib@openssh.com", "zlib"] {
				let client = testClient()
				client.rekeyLimit = 65536
				client.algorithms.compression = [method]
				try client.connect(server.address().str(), "alice", "s3cret")
				let n = client.negotiation()
				assert !(n is none) && n.compressionOut == method && n.compressionIn == method
				let r = try client.run("cat", data)
				assert r.output.bytes().equals(data)
				try client.close()
			}
			try server.close()
			return none
		}

		@test()
		def terminalsEnvironmentAndSignals() !none {
			let server = try testServer(try generateKey())
			let client = testClient()
			client.environment["LANG"] = "C.UTF-8"
			try client.connect(server.address().str(), "alice", "s3cret")
			let p = try client.start("tty", Terminal{name: "xterm", columns: 100, rows: 30})
			assert (try p.output()) == "xterm 100x30 C.UTF-8\r\n"
			let waiting = try client.start("wait-signal")
			let lines = new net.LineReader(waiting)
			assert (try lines.readLine(10s)) == "ready"
			try waiting.signal(Signal.Terminate)
			assert (try lines.readLine(10s)) == "got TERM"
			try client.close()
			try server.close()
			return none
		}

		@test()
		def logsInEachWay() !none {
			let host = try generateKey()
			let server = try testServer(host)
			let userKey = try generateKey(KeyKind.EcdsaP256)
			let users = new Users()
			users.add("alice", "s3cret")
			users.addKey("bob", userKey.publicKey())
			server.authenticator = users
			let withKey = testClient()
			withKey.hostKey = host.publicKey()
			try withKey.connect(server.address().str(), "bob", userKey)
			assert (try withKey.output("who")) == "bob ecdsa-sha2-nistp256\n"
			try withKey.close()
			// Keyboard-interactive: the server asks for the password.
			let kbd = testClient()
			let asked = 0
			kbd.answer = def (c Challenge) !string[] {
				asked += c.prompts.len()
				return ["s3cret"]
			}
			try kbd.connect(server.address().str(), "alice")
			assert asked == 1
			try kbd.close()
			// A wrong password.
			let wrong = testClient()
			let code = ""
			wrong.connect(server.address().str(), "alice", "nope") onerror (err error) {
				code = err.code
				recover none
			}
			assert code == "auth"
			// A pinned key that does not match.
			let pinned = testClient()
			pinned.hostKey = (try generateKey()).publicKey()
			let pinCode = ""
			pinned.connect(server.address().str(), "alice", "s3cret") onerror (err error) {
				pinCode = err.code
				recover none
			}
			assert pinCode == "hostkey"
			try server.close()
			return none
		}

		@test()
		def subsystemsAndForwarding() !none {
			let server = try testServer(try generateKey())
			server.allowForwarding = true
			server.allowRemoteForwarding = true
			let client = testClient()
			try client.connect(server.address().str(), "alice", "s3cret")
			let upper = try client.subsystem("upper")
			try upper.write("shout\n")
			assert (try new net.LineReader(upper).readLine(10s)) == "SHOUT"
			let missing = ""
			client.subsystem("nope") onerror (err error) {
				missing = err.code
				recover upper
			}
			assert missing == "channel"
			// direct-tcpip to a listener here.
			let sock = try net.socket(net.SocketDomain.IPv4, net.SocketType.Stream)
			try sock.bind("127.0.0.1:0")
			let ln = try sock.listen(4)
			let target = async echoLine(ln)
			let ch = try client.dial(ln.address().str())
			try ch.write("hi\n")
			assert (try new net.LineReader(ch).readLine(10s)) == "echo hi"
			try await target
			// -R: the server listens and connections come back here.
			let again = async echoLine(ln)
			let fwd = try client.forwardRemote("127.0.0.1:0", ln.address().str())
			assert fwd.remotePort > 0
			let conn = try net.dialStream("127.0.0.1:{fwd.remotePort}", 5s)
			try conn.writeAll("back\n".bytes())
			assert (try new net.LineReader(conn).readLine(10s)) == "echo back"
			try await again
			try fwd.close()
			try ln.close()
			try client.close()
			try server.close()
			return none
		}

		@test()
		def negotiatesEachAlgorithm() !none {
			let rsaHost = try generateKey(KeyKind.Rsa, 2048)
			let server = try testServer(try generateKey())
			server.hostKeys.push(rsaHost)
			server.hostKeys.push(try generateKey(KeyKind.EcdsaP384))
			let combos = [
				["curve25519-sha256", "chacha20-poly1305@openssh.com", "hmac-sha2-256", "ssh-ed25519"],
				["mlkem768x25519-sha256", "aes256-gcm@openssh.com", "hmac-sha2-256", "ecdsa-sha2-nistp384"],
				["ecdh-sha2-nistp256", "aes128-gcm@openssh.com", "hmac-sha2-256", "rsa-sha2-512"],
				["ecdh-sha2-nistp521", "aes256-ctr", "hmac-sha2-512-etm@openssh.com", "ecdsa-sha2-nistp384"],
				["diffie-hellman-group14-sha256", "aes192-ctr", "hmac-sha1", "rsa-sha2-256"],
				["diffie-hellman-group-exchange-sha256", "aes256-gcm@openssh.com", "hmac-sha2-256", "ssh-ed25519"],
			]
			for let combo in combos {
				let client = testClient()
				client.algorithms.kex = [combo[0]]
				client.algorithms.ciphers = [combo[1]]
				client.algorithms.macs = [combo[2]]
				client.algorithms.hostKeys = [combo[3]]
				try client.connect(server.address().str(), "alice", "s3cret")
				assert (try client.output("ok")) == "ok\n"
				try client.close()
			}
			try server.close()
			return none
		}
	}
}
