internal partial module std.net.ssh.transport {
	use (
		std.net
		std.net.ssh::(Algorithms, generateKey)
		std.net.sshwire::(disconnectByApplication)
		std.sync
		std.testing
		std.time
	)

	// Reads packets until the connection ends and returns how many
	// arrived; `reached` is done once `count` have, or when the
	// connection ends short of them. The reader goes on past its count:
	// a key exchange the peer starts with its last packets needs it.
	internal async def readPackets(t Transport, count int, reached sync.WaitGroup) int {
		let got = 0
		for {
			let ended = false
			t.readPacket() onerror (err error) {
				ended = true
				recover []
			}
			break when ended
			got++
			reached.done() when got == count
		}
		reached.done() when got < count
		return got
	}

	// Writes `count` packets of `size` bytes.
	internal async def writePackets(t Transport, count int, size int) !int {
		let payload byte[] = []
		payload.len(size)
		payload[0] = byte(94)
		for let i = 0; i < count; i++ {
			try t.writePacket(payload)
		}
		return count
	}

	internal async def serverHandshake(t Transport) !none {
		return try t.handshake()
	}

	// Disconnects and returns how long it took.
	internal async def timedDisconnect(t Transport) duration {
		let started = time.now()
		t.disconnect(disconnectByApplication, "done")
		return time.now() - started
	}

	// Two transports over loopback with 16 KiB socket buffers, handshaken,
	// whose packets wait `timeout` at most.
	internal def transportPair(timeout duration) !(Transport, Transport, net.Listener) {
		let sock = try net.socket(net.SocketDomain.IPv4, net.SocketType.Stream)
		try sock.setRecvBuf(16384)
		try sock.bind("127.0.0.1:0")
		let ln = try sock.listen(1)
		let dialer = try net.socket(net.SocketDomain.IPv4, net.SocketType.Stream)
		try dialer.setSendBuf(16384)
		try dialer.setRecvBuf(16384)
		let clientConn = try dialer.connect(ln.address().str(), 5s)
		let serverConn = try ln.accept()
		let server = new Transport(serverConn, false, Algorithms{}, timeout)
		server.hostKeys = [try generateKey()]
		let client = new Transport(clientConn, true, Algorithms{}, timeout)
		let accepted = serverHandshake(server)
		try client.handshake()
		try await accepted
		return (client, server, ln)
	}

	check "Transport" {
		// Both sides write more than the sockets hold while keys change
		// every 64 KiB: a reader that answered a KEXINIT behind a writer
		// blocked on the full socket stopped reading, and so did the peer's.
		@test()
		def keyChangesWhileBothSocketsAreFull() !none {
			let (client, server, ln) = try transportPair(10s)
			server.rekeyBytes = 65536
			client.rekeyBytes = 65536
			let count = 256
			let size = 8192
			let reached = new sync.WaitGroup()
			reached.add(2)
			let serverReads = readPackets(server, count, reached)
			let clientReads = readPackets(client, count, reached)
			let serverWrites = writePackets(server, count, size)
			let clientWrites = writePackets(client, count, size)
			assert (try await clientWrites) == count
			assert (try await serverWrites) == count
			assert reached.wait(10s)
			client.close()
			server.close()
			assert (await clientReads) == count
			assert (await serverReads) == count
			assert client.kexCount > 4 && server.kexCount > 4
			try ln.close()
			return none
		}

		// A DISCONNECT waits for what was sent before it to be written. When
		// the connection closes meanwhile (here the peer goes away while the
		// writer is stuck on a full socket), the wait ends then, not at the
		// timeout.
		@test()
		def disconnectEndsWhenTheConnectionCloses() !none {
			let (client, server, ln) = try transportPair(10s)
			let packet byte[] = []
			packet.len(8192)
			packet[0] = byte(94)
			for let i = 0; i < 256; i++ {
				try client.queuePacket(packet)
			}
			let took = timedDisconnect(client)
			time.sleep(100ms)
			server.close()
			assert (await took) < 3s
			try ln.close()
			return none
		}
	}
}
