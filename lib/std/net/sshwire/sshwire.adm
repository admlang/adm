internal partial module std.net.sshwire {
	use std.net.ssh::(SshError)

	// The SSH data types of RFC 4251 §5 and the message numbers of RFC
	// 4250 §4.1, shared by the transport, the authentication and the
	// connection layers, the key formats and the agent protocol.

	const (
		msgDisconnect              = 1
		msgIgnore                  = 2
		msgUnimplemented           = 3
		msgDebug                   = 4
		msgServiceRequest          = 5
		msgServiceAccept           = 6
		msgExtInfo                 = 7
		msgKexInit                 = 20
		msgNewKeys                 = 21
		msgKexEcdhInit             = 30
		msgKexEcdhReply            = 31
		msgKexDhGexGroup           = 31
		msgKexDhGexInit            = 32
		msgKexDhGexReply           = 33
		msgKexDhGexRequest         = 34
		msgUserauthRequest         = 50
		msgUserauthFailure         = 51
		msgUserauthSuccess         = 52
		msgUserauthBanner          = 53
		msgUserauthPkOk            = 60
		msgUserauthInfoRequest     = 60
		msgUserauthInfoResponse    = 61
		msgGlobalRequest           = 80
		msgRequestSuccess          = 81
		msgRequestFailure          = 82
		msgChannelOpen             = 90
		msgChannelOpenConfirmation = 91
		msgChannelOpenFailure      = 92
		msgChannelWindowAdjust     = 93
		msgChannelData             = 94
		msgChannelExtendedData     = 95
		msgChannelEof              = 96
		msgChannelClose            = 97
		msgChannelRequest          = 98
		msgChannelSuccess          = 99
		msgChannelFailure          = 100
	)

	// Disconnect reason codes (RFC 4250 §4.2.2).
	const (
		disconnectProtocolError        = 2
		disconnectKeyExchangeFailed    = 3
		disconnectMacError             = 5
		disconnectServiceNotAvailable  = 7
		disconnectHostKeyNotVerifiable = 9
		disconnectByApplication        = 11
		disconnectTooManyConnections   = 12
		disconnectAuthCancelledByUser  = 13
		disconnectNoMoreAuthMethods    = 14
	)

	// Channel open failure reason codes (RFC 4254 §5.1).
	const (
		openAdministrativelyProhibited = 1
		openConnectFailed              = 2
		openUnknownChannelType         = 3
		openResourceShortage           = 4
	)

	// Writer builds one message from SSH data types.
	type Writer {
		data byte[] = []

		def new(message int = -1) {
			data.push(byte(message)) when message >= 0
		}

		def putByte(v int) Writer {
			data.push(byte(v))
			return self
		}

		def putBool(v bool) Writer {
			data.push(byte(v ?? (1, 0)))
			return self
		}

		def putUint32(v int64) Writer {
			data.push(byte(v >> 24))
			data.push(byte(v >> 16))
			data.push(byte(v >> 8))
			data.push(byte(v))
			return self
		}

		def putUint64(v uint64) Writer {
			for let shift = 56; shift >= 0; shift -= 8 {
				data.push(byte(v >> uint64(shift)))
			}
			return self
		}

		// A `string`: a uint32 length, then the bytes.
		def putString(v byte[]) Writer {
			putUint32(int64(v.len()))
			data = data + v
			return self
		}

		// A `string` holding UTF-8 text.
		def putText(v string) Writer {
			return putString(v.bytes())
		}

		// An `mpint`: two's complement, big-endian, no needless leading
		// byte, a zero byte in front of a set top bit of a positive value.
		def putMpint(v bigint) Writer {
			return putString(mpintBytes(v))
		}

		// A `name-list`: the names joined by commas.
		def putNames(v string[]) Writer {
			return putText(v.join(","))
		}

		// Bytes as they are, with no length.
		def putRaw(v byte[]) Writer {
			data = data + v
			return self
		}

		def bytes() byte[] {
			return data
		}
	}

	// The minimal two's complement form of a non-negative value.
	def mpintBytes(v bigint) byte[] {
		return [] when v.isZero()
		let raw = v.bytes()
		return raw when (int(raw[0]) & 0x80) == 0
		return byte[0] + raw
	}

	// Reader takes SSH data types off a message in order. Every read
	// fails with a protocol error when the message is too short.
	type Reader {
		data byte[]
		pos  int    = 0

		def new(data byte[]) {
			self.data = data
		}

		def readByte() !int {
			fail protocolError("message too short") when pos >= data.len()
			pos++
			return int(data[pos - 1])
		}

		def readBool() !bool {
			return (try readByte()) != 0
		}

		def readUint32() !int64 {
			fail protocolError("message too short") when pos + 4 > data.len()
			let v = (int64(data[pos]) << 24) | (int64(data[pos + 1]) << 16) | (int64(data[pos + 2]) << 8) | int64(data[pos + 3])
			pos += 4
			return v
		}

		def readUint64() !uint64 {
			fail protocolError("message too short") when pos + 8 > data.len()
			let v uint64 = 0
			for let i = 0; i < 8; i++ {
				v = (v << uint64(8)) | uint64(data[pos + i])
			}
			pos += 8
			return v
		}

		def readString() !byte[] {
			let n = try readUint32()
			fail protocolError("string runs past the message") when n > int64(data.len() - pos)
			let v = data[pos:pos + int(n)].clone()
			pos += int(n)
			return v
		}

		def readText() !string {
			return string(try readString())
		}

		def readMpint() !bigint {
			let raw = try readString()
			return bigint(0) when raw.len() == 0
			fail protocolError("negative mpint") when (int(raw[0]) & 0x80) != 0
			return parseBigInt(raw)
		}

		def readNames() !string[] {
			let text = try readText()
			return [] when text == ""
			return text.split(",")
		}

		// The bytes not read yet.
		def rest() byte[] {
			let v = data[pos:].clone()
			pos = data.len()
			return v
		}

		def done() bool {
			return pos >= data.len()
		}
	}

	// `count` zero bytes.
	def zeros(count int) byte[] {
		let out byte[] = []
		out.len(count)
		return out
	}

	// A message built from a type code and nothing else.
	def message(code int) byte[] {
		return byte[code]
	}

	def putUint32At(buf byte[], at int, v int64) {
		buf[at] = byte(v >> 24)
		buf[at + 1] = byte(v >> 16)
		buf[at + 2] = byte(v >> 8)
		buf[at + 3] = byte(v)
	}

	def uint32At(buf byte[], at int) int64 {
		return (int64(buf[at]) << 24) | (int64(buf[at + 1]) << 16) | (int64(buf[at + 2]) << 8) | int64(buf[at + 3])
	}

	// An SshError of kind `code`.
	def sshError(code string, text string, reason int = 0) error {
		return SshError{message: "ssh: " + text, code: code, reason: reason}
	}

	// A malformed or unexpected message.
	def protocolError(text string) error {
		return sshError("protocol", text)
	}
}
