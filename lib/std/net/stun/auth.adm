partial module std.net.stun {
	use (
		std.crypto.hash::(Hash, digest, hmac)
		std.data.encoding::(base64encode)
		std.net.stun.wire::*
	)

	// PasswordAlgorithm names the algorithms that derive a long-term key
	// from a password (RFC 8489 §18.5), the value being the code on the
	// wire.
	enum PasswordAlgorithm {
		MD5 = 0x0001,
		SHA256 = 0x0002,
	}

	// shortTermKey is the HMAC key of the short-term credential mechanism:
	// the password after OpaqueString (RFC 8489 §9.1.1). Fails as `opaque`
	// does.
	def shortTermKey(password string) !byte[] {
		return (try opaque(password)).bytes()
	}

	// longTermKey is the HMAC key of the long-term credential mechanism:
	// the digest the algorithm names over username ":" realm ":" password,
	// each after OpaqueString (RFC 8489 §9.2.2, §18.5.1). Fails as `opaque`
	// does.
	def longTermKey(username string, realm string, password string, algorithm PasswordAlgorithm = PasswordAlgorithm.MD5) !byte[] {
		let input = (try opaque(username)) + ":" + (try opaque(realm)) + ":" + (try opaque(password))
		return digest(algorithm == PasswordAlgorithm.SHA256 ?? (Hash.SHA256, Hash.MD5), input.bytes())
	}

	// RestCredentials is a TURN username and password made from a secret
	// shared with the TURN server (the "TURN REST API" scheme coturn and
	// WebRTC deployments use): the username is the expiry time in Unix
	// seconds and the user, the password the base64 of the HMAC-SHA1 of the
	// username under the secret.
	struct RestCredentials {
		username string
		password string
	}

	// restCredentials makes credentials good for `ttl` from now for a user
	// ("" for none).
	def restCredentials(secret string, user string = "", ttl duration = 24h) RestCredentials {
		let expiry = unixNow() + int(ttl) / 1000000000
		let username = user == "" ?? ("{expiry}", "{expiry}:{user}")
		return RestCredentials{username: username, password: restPassword(secret, username)}
	}

	// restPassword is the password the REST scheme gives a username.
	def restPassword(secret string, username string) string {
		return base64encode(hmac(Hash.SHA1, secret.bytes(), username.bytes()))
	}

	// restExpired reports whether a REST username's expiry time has passed,
	// or the username carries none.
	def restExpired(username string) bool {
		let colon = username.indexOf(":")
		let stamp = colon < 0 ?? (username, username[0:colon])
		return true unless stamp.len() > 0 && stamp.isNumeric()
		return stamp.toInt<int>() < unixNow()
	}
}
