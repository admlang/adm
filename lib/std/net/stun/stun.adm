// STUN (RFC 8489) and TURN (RFC 8656, RFC 6062): the message codec, the
// short-term and long-term credential mechanisms, STUN and TURN URIs, a
// client that learns its public address and creates relay allocations, and
// a server that answers Binding requests and relays for its clients.
//
//     let client = try stun.dial("stun:stun.example.org")
//     let mine = try client.binding()
//     println("seen from outside as {mine.str()}")
//
// A relay through a TURN server:
//
//     let turn = try stun.dial("turn:turn.example.org?transport=udp", stun.ClientConfig{username: "u", password: "p"})
//     let relay = try turn.allocate()
//     try relay.permit([peer])
//     try relay.send("hello".bytes(), peer)
partial module std.net.stun {
	use (
		std.bytes::(Endian)
		std.errors
		std.net
		std.crypto::(constantTimeEqual)
		std.crypto.hash::(Hash, hmac, crc32)
		std.net.stun.wire::*
	)

	// MessageClass is the class of a STUN message (RFC 8489 §5).
	enum MessageClass {
		Request = 0,
		Indication = 1,
		SuccessResponse = 2,
		ErrorResponse = 3,
	}

	// Method names the STUN methods of RFC 8489, RFC 8656 and RFC 6062, the
	// value being the 12-bit method on the wire; a method this module does
	// not name keeps its number.
	enum Method {
		Binding = 0x001,
		Allocate = 0x003,
		Refresh = 0x004,
		Send = 0x006,
		Data = 0x007,
		CreatePermission = 0x008,
		ChannelBind = 0x009,
		Connect = 0x00A,
		ConnectionBind = 0x00B,
		ConnectionAttempt = 0x00C,
	}

	// AttributeType names the STUN attributes of RFC 8489, RFC 8656,
	// RFC 6062 and the ICE ones of RFC 8445; values 0x0000-0x7FFF must be
	// understood, the others may be ignored.
	enum AttributeType {
		MappedAddress = 0x0001,
		Username = 0x0006,
		MessageIntegrity = 0x0008,
		ErrorCode = 0x0009,
		UnknownAttributes = 0x000A,
		ChannelNumber = 0x000C,
		Lifetime = 0x000D,
		XorPeerAddress = 0x0012,
		Data = 0x0013,
		Realm = 0x0014,
		Nonce = 0x0015,
		XorRelayedAddress = 0x0016,
		RequestedAddressFamily = 0x0017,
		EvenPort = 0x0018,
		RequestedTransport = 0x0019,
		DontFragment = 0x001A,
		MessageIntegritySHA256 = 0x001C,
		PasswordAlgorithm = 0x001D,
		UserHash = 0x001E,
		XorMappedAddress = 0x0020,
		ReservationToken = 0x0022,
		Priority = 0x0024,
		UseCandidate = 0x0025,
		ConnectionID = 0x002A,
		AdditionalAddressFamily = 0x8000,
		AddressErrorCode = 0x8001,
		PasswordAlgorithms = 0x8002,
		AlternateDomain = 0x8003,
		ICMP = 0x8004,
		Software = 0x8022,
		AlternateServer = 0x8023,
		Fingerprint = 0x8028,
		IceControlled = 0x8029,
		IceControlling = 0x802A,
	}

	// ErrorCode names the error codes of RFC 8489 §14.8, RFC 8656 §19 and
	// RFC 6062 §6.3, the value being the code on the wire.
	enum ErrorCode {
		// 300: the client should ask the server ALTERNATE-SERVER names.
		TryAlternate = 300,
		// 400: the request is malformed.
		BadRequest = 400,
		// 401: the request lacks credentials, or they are wrong.
		Unauthenticated = 401,
		// 403: the request is valid and refused by policy.
		Forbidden = 403,
		// 420: the request holds an attribute the server must but does not understand; UNKNOWN-ATTRIBUTES lists it.
		UnknownAttribute = 420,
		// 437: the client's address has an allocation where none is expected, or none where one is.
		AllocationMismatch = 437,
		// 438: the nonce is no longer good; the response brings a new one.
		StaleNonce = 438,
		// 440: the server relays no address of the family asked for.
		AddressFamilyNotSupported = 440,
		// 441: the credentials are not those the allocation was made with.
		WrongCredentials = 441,
		// 442: the server does not relay over the transport asked for.
		UnsupportedTransport = 442,
		// 443: a peer address is of another family than the relayed address.
		PeerAddressFamilyMismatch = 443,
		// 446: the allocation already has a connection to the peer.
		ConnectionAlreadyExists = 446,
		// 447: the server could not connect to the peer.
		ConnectionTimeoutOrFailure = 447,
		// 486: the user has as many allocations as allowed.
		AllocationQuotaReached = 486,
		// 487: both ICE agents claim the same role (RFC 8445 §7.3.1.1).
		RoleConflict = 487,
		// 500: the server failed; the client may try again.
		ServerError = 500,
		// 508: the server has no relayed address or port left to give.
		InsufficientCapacity = 508,
	}

	// Attribute is one attribute as it travels: its type and value, without
	// padding.
	struct Attribute {
		kind  int
		value byte[]
	}

	// Refusal is the content of an ERROR-CODE attribute: a code from 300 to
	// 699 and its reason phrase.
	struct Refusal {
		code   int
		reason string
	}

	// StunError is the payload of a failure of this module. When a server
	// answered with an error: `kind` (none for a code `ErrorCode` does not
	// name), the code as sent and its reason, and for a 420 the attributes
	// the server did not understand. `timedOut` when no answer came.
	struct StunError {
		message   string
		code      string            = "stun"
		cause     ?error
		stack     errors.StackTrace
		kind      ?ErrorCode        = none
		errorCode int               = 0
		reason    string            = ""
		unknown   int[]             = []
		timedOut  bool              = false
	}

	// Message is a STUN message: class, method, transaction ID and
	// attributes in order. A parsed message also keeps its bytes, which the
	// integrity and fingerprint checks run over.
	type Message {
		class         MessageClass
		method        Method
		transactionID byte[]
		attributes    Attribute[]
		// The message as received, empty for one built here.
		raw           byte[]       = []
		// Where each attribute of `raw` starts, in step with `attributes`.
		offsets       int[]        = []

		def new(class MessageClass, method Method, transactionID byte[]) {
			self.class = class
			self.method = method
			self.transactionID = transactionID
		}

		// add appends an attribute.
		def add(kind AttributeType, value byte[]) {
			attributes.push(Attribute{kind: int(kind), value: value})
		}

		// get is the value of the first attribute of the type, none when
		// there is none.
		def get(kind AttributeType) ?byte[] {
			for let a in attributes {
				return a.value when a.kind == int(kind)
			}
			return none
		}

		// has reports whether an attribute of the type is present.
		def has(kind AttributeType) bool {
			return !(get(kind) is none)
		}

		// all is the values of every attribute of the type, in order.
		def all(kind AttributeType) byte[][] {
			let out byte[][]
			for let a in attributes {
				out.push(a.value) when a.kind == int(kind)
			}
			return out
		}

		// add appends a UTF-8 text attribute (USERNAME, REALM, NONCE,
		// SOFTWARE, ALTERNATE-DOMAIN).
		def add(kind AttributeType, text string) {
			add(kind, text.bytes())
		}

		// text is the first text attribute of the type, none when absent.
		def text(kind AttributeType) ?string {
			let value = get(kind)
			return none when value is none
			return string(value)
		}

		// add appends a 32-bit attribute (LIFETIME, PRIORITY, CONNECTION-ID).
		def add(kind AttributeType, value uint32) {
			add(kind, value.bytes(Endian.Big))
		}

		// uint32 is the first 32-bit attribute of the type, none when absent
		// or not four bytes.
		def uint32(kind AttributeType) ?int {
			let value = get(kind)
			return none when value is none || value.len() != 4
			return int(uint32(0).fromBytes(value[0:4], Endian.Big))
		}

		// add appends an address attribute: in the clear (MAPPED-ADDRESS,
		// ALTERNATE-SERVER), or with `xor` XORed with the magic cookie and
		// transaction ID (XOR-MAPPED-ADDRESS, XOR-PEER-ADDRESS,
		// XOR-RELAYED-ADDRESS). Fails with StunError when the address's host
		// is not an IP address.
		def add(kind AttributeType, address net.Address, xor bool = false) !none {
			add(kind, try encodeAddress(address, xor, transactionID))
			return none
		}

		// address is the first plain address attribute of the type, none
		// when absent or malformed.
		def address(kind AttributeType) ?net.Address {
			let value = get(kind)
			return none when value is none
			return optionalAddress(value, false, transactionID) onerror recover none
		}

		// xorAddress is the first XOR address attribute of the type, none
		// when absent or malformed.
		def xorAddress(kind AttributeType) ?net.Address {
			let value = get(kind)
			return none when value is none
			return optionalAddress(value, true, transactionID) onerror recover none
		}

		// xorAddresses is every XOR address attribute of the type that
		// decodes, in order.
		def xorAddresses(kind AttributeType) net.Address[] {
			let out net.Address[]
			for let (_, value) in all(kind) {
				let address = optionalAddress(value, true, transactionID) onerror recover none
				out.push(address) unless address is none
			}
			return out
		}

		// add appends an ERROR-CODE attribute: the code with its reason, the
		// RFC's phrase when none is given.
		def add(code ErrorCode, reason string = "") {
			add(AttributeType.ErrorCode, encodeErrorCode(int(code), reason == "" ?? (reasonOf(code), reason)))
		}

		// refusal is the ERROR-CODE attribute, none when absent or
		// malformed.
		def refusal() ?Refusal {
			let value = get(AttributeType.ErrorCode)
			return none when value is none
			return optionalRefusal(value) onerror recover none
		}

		// unknownAttributes is the UNKNOWN-ATTRIBUTES list of a 420 answer.
		def unknownAttributes() int[] {
			let out int[]
			let value = get(AttributeType.UnknownAttributes)
			return out when value is none
			for let i = 0; i + 1 < value.len(); i += 2 {
				out.push(int(value[i]) << 8 | int(value[i + 1]))
			}
			return out
		}

		// comprehensionRequired is the attribute types this module does not
		// know in the comprehension-required range (0x0000-0x7FFF), for a
		// 420 answer (RFC 8489 §6.3.1).
		def comprehensionRequired() int[] {
			let out int[]
			for let a in attributes {
				out.push(a.kind) when a.kind < 0x8000 && !knownAttribute(a.kind) && !out.includes(a.kind)
			}
			return out
		}

		// encode is the message on the wire, attributes padded to four
		// bytes. With a key, MESSAGE-INTEGRITY-SHA256, MESSAGE-INTEGRITY or
		// both are appended as `integrity` says, computed as RFC 8489
		// §14.5-14.6 describe; FINGERPRINT last when `fingerprint`.
		def encode(key byte[] = [], integrity Integrity = Integrity.None, fingerprint bool = false) byte[] {
			let body byte[]
			for let a in attributes {
				body = body + attributeBytes(a.kind, a.value)
			}
			if key.len() > 0 && (integrity := Integrity.SHA1 || Integrity.Both) {
				let mac = hmac(Hash.SHA1, key, header(body.len() + 24) + body)
				body = body + attributeBytes(int(AttributeType.MessageIntegrity), mac)
			}
			if key.len() > 0 && (integrity := Integrity.SHA256 || Integrity.Both) {
				let mac = hmac(Hash.SHA256, key, header(body.len() + 36) + body)
				body = body + attributeBytes(int(AttributeType.MessageIntegritySHA256), mac)
			}
			if fingerprint {
				let crc = int(crc32(header(body.len() + 8) + body)) ^ fingerprintXor
				body = body + attributeBytes(int(AttributeType.Fingerprint), uint32(crc).bytes(Endian.Big))
			}
			return header(body.len()) + body
		}

		// header is the 20-byte header for a body of the length.
		internal def header(length int) byte[] {
			let m = int(method)
			let c = int(class)
			let kind = (m & 0x000F) | ((m & 0x0070) << 1) | ((m & 0x0F80) << 2) | ((c & 1) << 4) | ((c & 2) << 7)
			return uint16(kind).bytes(Endian.Big) + uint16(length).bytes(Endian.Big) + uint32(magicCookie).bytes(Endian.Big) + transactionID
		}

		// integrityUsed is the integrity attribute the parsed message
		// carries: SHA256 when it has MESSAGE-INTEGRITY-SHA256, SHA1 when
		// only MESSAGE-INTEGRITY, None without either.
		def integrityUsed() Integrity {
			return Integrity.SHA256 when has(AttributeType.MessageIntegritySHA256)
			return Integrity.SHA1 when has(AttributeType.MessageIntegrity)
			return Integrity.None
		}

		// checkIntegrity verifies the parsed message's integrity attribute
		// with the key: MESSAGE-INTEGRITY-SHA256 when present, else
		// MESSAGE-INTEGRITY (RFC 8489 §9.1.3). false when neither is
		// present or the value does not match.
		def checkIntegrity(key byte[]) bool {
			return checkMAC(int(AttributeType.MessageIntegritySHA256), Hash.SHA256, key) when has(AttributeType.MessageIntegritySHA256)
			return checkMAC(int(AttributeType.MessageIntegrity), Hash.SHA1, key) when has(AttributeType.MessageIntegrity)
			return false
		}

		// checkMAC recomputes one integrity attribute over the raw bytes
		// before it, with the length field pointing at its end.
		internal def checkMAC(kind int, hash Hash, key byte[]) bool {
			for let (i, a) in attributes {
				continue unless a.kind == kind
				let at = offsets[i]
				let end = at + 4 + a.value.len()
				let head = raw[0:2] + uint16(end - headerSize).bytes(Endian.Big) + raw[4:headerSize]
				let mac = hmac(hash, key, head + raw[headerSize:at])
				// MESSAGE-INTEGRITY is the whole HMAC-SHA1;
				// MESSAGE-INTEGRITY-SHA256 may be truncated to 16 bytes or
				// more, in multiples of four (RFC 8489 §14.5-14.6).
				return false when a.value.len() > mac.len() || a.value.len() % 4 != 0
				return false when a.value.len() < (hash == Hash.SHA1 ?? (mac.len(), 16))
				return constantTimeEqual(mac[0:a.value.len()], a.value)
			}
			return false
		}

		// checkFingerprint reports whether the parsed message ends with a
		// FINGERPRINT attribute of the right value.
		def checkFingerprint() bool {
			for let (i, a) in attributes {
				continue unless a.kind == int(AttributeType.Fingerprint)
				return false unless a.value.len() == 4
				let at = offsets[i]
				let crc = int(crc32(raw[0:at])) ^ fingerprintXor
				return int(uint32(0).fromBytes(a.value[0:4], Endian.Big)) == (crc & 0xFFFFFFFF)
			}
			return false
		}
	}

	// Integrity names which message integrity attributes a message carries.
	enum Integrity {
		None,
		// MESSAGE-INTEGRITY, HMAC-SHA1.
		SHA1,
		// MESSAGE-INTEGRITY-SHA256.
		SHA256,
		// Both, for a peer whose algorithm is not known yet (RFC 8489
		// §9.1.2).
		Both,
	}

	// isMessage reports whether the bytes look like a STUN message: the two
	// top bits clear, the magic cookie, a length that is a multiple of four
	// and matches (RFC 8489 §5). Use it to tell STUN from other protocols on
	// one port.
	def isMessage(data byte[]) bool {
		return false when data.len() < headerSize || (int(data[0]) & 0xC0) != 0
		return false unless int(uint32(0).fromBytes(data[4:8], Endian.Big)) == magicCookie
		let length = int(data[2]) << 8 | int(data[3])
		return length % 4 == 0 && headerSize + length == data.len()
	}

	// parseMessage decodes a message and keeps `data`, which the caller
	// must not change afterwards: the attribute values are views into it.
	// Attributes that follow
	// MESSAGE-INTEGRITY other than MESSAGE-INTEGRITY-SHA256 and FINGERPRINT,
	// those that follow MESSAGE-INTEGRITY-SHA256 other than FINGERPRINT, and
	// anything after FINGERPRINT are ignored (RFC 8489 §9). Fails with
	// StunError when the bytes are not a well-formed STUN message.
	def parseMessage(data byte[]) !Message {
		fail stunError("not a STUN message") unless isMessage(data)
		let kind = int(data[0]) << 8 | int(data[1])
		let methodBits = (kind & 0x000F) | ((kind & 0x00E0) >> 1) | ((kind & 0x3E00) >> 2)
		let classBits = ((kind & 0x0010) >> 4) | ((kind & 0x0100) >> 7)
		let m = new Message(MessageClass(classBits), Method(methodBits), data[8:headerSize])
		m.raw = data
		let at = headerSize
		let sawSHA1 = false
		let sawSHA256 = false
		let done = false
		for at < data.len() {
			fail stunError("attribute header runs past the message") when data.len() - at < 4
			let attrType = int(data[at]) << 8 | int(data[at + 1])
			let length = int(data[at + 2]) << 8 | int(data[at + 3])
			let padded = (length + 3) / 4 * 4
			fail stunError("attribute {attrType} runs past the message") when at + 4 + padded > data.len()
			let keep = !done
			keep = false when sawSHA256 && attrType != int(AttributeType.Fingerprint)
			keep = false when sawSHA1 && !(attrType := int(AttributeType.MessageIntegritySHA256) || int(AttributeType.Fingerprint))
			if keep {
				m.attributes.push(Attribute{kind: attrType, value: data[at + 4:at + 4 + length]})
				m.offsets.push(at)
				sawSHA1 = true when attrType == int(AttributeType.MessageIntegrity)
				sawSHA256 = true when attrType == int(AttributeType.MessageIntegritySHA256)
				done = true when attrType == int(AttributeType.Fingerprint)
			}
			at += 4 + padded
		}
		return m
	}

	// request is a new request of the method with a fresh transaction ID.
	// Fails when the random source does.
	def request(method Method) !Message {
		return new Message(MessageClass.Request, method, try newTransactionID())
	}

	// indication is a new indication of the method with a fresh
	// transaction ID. Fails when the random source does.
	def indication(method Method) !Message {
		return new Message(MessageClass.Indication, method, try newTransactionID())
	}

	// response is the success or error response to a request: same method
	// and transaction ID.
	def response(to Message, success bool) Message {
		return new Message(success ?? (MessageClass.SuccessResponse, MessageClass.ErrorResponse), to.method, to.transactionID)
	}

	// errorCodeOf is the error code a number names, none for one `ErrorCode`
	// does not list.
	def errorCodeOf(code int) ?ErrorCode {
		return none unless ErrorCode.values().includes(code)
		return ErrorCode(code)
	}
}
