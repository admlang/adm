	// testServer is a started server on a free loopback port that knows
	// alice and relays to loopback peers.
	internal def testServer() !Server {
		let server = new Server("127.0.0.1:0")
		server.realm = "adm.test"
		server.users["alice"] = "secret"
		server.turn = true
		server.allowLocalPeers = true
		server.minPort = 50000
		server.maxPort = 50400
		try server.start()
		return server
	}

	internal def alice() ClientConfig {
		return ClientConfig{username: "alice", password: "secret", rto: 200ms}
	}

	// serveUntilClosed runs a server's listenAndServe and returns its
	// failure, "" for none.
	internal async def serveUntilClosed(server Server) string {
		let failure = ""
		server.listenAndServe() onerror (err error) {
			failure = err.message
			recover none
		}
		return failure
	}

	// allocationFailure is what a plain Allocate fails with, none when it
	// succeeds (the allocation is closed again).
	internal def allocationFailure(client Client) ?error {
		let failure ?error = none
		tryAllocate(client) onerror (err error) {
			failure = err
			recover none
		}
		return failure
	}

	internal def tryAllocate(client Client) !none {
		let relay = try client.allocate()
		return try relay.close()
	}

	// codeOf is the STUN error code a call failed with, 0 when it did not
	// fail or failed otherwise.
	internal def codeOf(failure ?error) int {
		return 0 when failure is none
		return failure is StunError ?? (failure.errorCode, -1)
	}

	// udpPeer is a bound loopback UDP socket to stand for a peer.
	internal def udpPeer() !net.Socket {
		let socket = try net.socket(net.SocketDomain.IPv4, net.SocketType.Datagram)
		try socket.bind("127.0.0.1:0")
		return socket
	}

	// socketLoop sends 1000 datagrams of 1200 bytes between two loopback
	// sockets and as many back: the floor under relayLoop, which moves
	// four datagrams where this moves two.
	internal def socketLoop() !none {
		let a = try udpPeer()
		let b = try udpPeer()
		let to = b.localAddr().str()
		let payload byte[]
		payload.len(1200)
		let buf byte[]
		buf.len(2048)
		for let i = 0; i < 1000; i++ {
			try a.writeTo(payload, to, 2s)
			let (n, from) = try b.readFrom(buf, 2s)
			try b.writeTo(buf[0:n], from.raw, 2s)
			try a.readFrom(buf, 2s)
		}
		try a.close()
		try b.close()
		return none
	}

	// relayLoop sends 500 datagrams of 1200 bytes through a relay to a peer
	// on loopback and as many back: over a channel when `channel`, else in
	// Send and Data indications.
	internal def relayLoop(channel bool) !none {
		let server = try testServer()
		let client = try dial("turn:127.0.0.1:{server.address().port}", alice())
		let relay = try client.allocate()
		let peer = try udpPeer()
		let peerAddress = peer.localAddr().str()
		try relay.permit([peerAddress])
		let payload byte[]
		payload.len(1200)
		let buf byte[]
		buf.len(2048)
		if channel {
			let bound = try relay.bind(peerAddress)
			for let i = 0; i < 500; i++ {
				try bound.send(payload, 2s)
				let (n, from) = try peer.readFrom(buf, 2s)
				try peer.writeTo(buf[0:n], from.raw, 2s)
				try bound.receive(buf, 2s)
			}
		} else {
			for let i = 0; i < 500; i++ {
				try relay.send(payload, peerAddress)
				let (n, from) = try peer.readFrom(buf, 2s)
				try peer.writeTo(buf[0:n], from.raw, 2s)
				try relay.receive(2s)
			}
		}
		try relay.close()
		try client.close()
		try peer.close()
		try server.close()
		return none
	}

	// relayRoundTrip sends through an allocation to a peer and back, as
	// Send and Data indications and then over a channel.
	internal def relayRoundTrip(client Client) !none {
		let relay = try client.allocate()
		assert relay.relayed.len() == 1 && relay.lifetime() == 600s
		assert relay.isOpen()
		let peer = try udpPeer()
		let peerAddress = peer.localAddr().str()
		try relay.permit([peerAddress])
		try relay.send("ping".bytes(), peerAddress)
		let buf byte[]
		buf.len(2048)
		let (n, from) = try peer.readFrom(buf, 2s)
		assert string(buf[0:n]) == "ping" && from.str() == relay.relayed[0]
		try peer.writeTo("pong".bytes(), from.str(), 2s)
		let back = try relay.receive(2s)
		assert string(back.data) == "pong" && back.peer == peerAddress

		// A peer without a permission reaches nobody: permissions go by IP
		// address.
		let stranger = try net.socket(net.SocketDomain.IPv4, net.SocketType.Datagram)
		try stranger.bind("127.0.0.2:0")
		try stranger.writeTo("nope".bytes(), relay.relayed[0], 2s)

		let channel = try relay.bind(peerAddress)
		assert channel.isOpen()
		try channel.send("over the channel".bytes(), 2s)
		let (m, _) = try peer.readFrom(buf, 2s)
		assert string(buf[0:m]) == "over the channel"
		try peer.writeTo("and back".bytes(), from.str(), 2s)
		let k = try channel.receive(buf, 2s)
		assert string(buf[0:k]) == "and back"
		let nothing = false
		relay.receive(200ms) onerror (err error) {
			nothing = err is net.NetError && err.kind == net.ErrorCode.TimedOut
			recover Relayed{peer: "", data: []}
		}
		assert nothing
		try relay.refresh(120s)
		assert relay.lifetime() == 120s
		try relay.close()
		try peer.close()
		try stranger.close()
		return none
	}

	check "STUN server" {
		// listenAndServe serves until close; OpaqueString leaves ASCII alone
		// and maps other spaces to SPACE.
		@test()
		def servesUntilClosed() !none {
			assert (try opaque("pass word")) == "pass word" && (try opaque("a\u3000b")) == "a b"
			let server = new Server("127.0.0.1:0")
			let serving = async serveUntilClosed(server)
			for let i = 0; i < 200 && server.address().port == 0; i++ {
				time.sleep(5ms)
			}
			let client = try dial("stun:127.0.0.1:{server.address().port}")
			assert (try client.binding()).host == "127.0.0.1"
			try client.close()
			try server.close()
			let failure = await serving
			assert failure == ""
		}

		@benchmark()
		def BenchSocketsOnly() {
			socketLoop() onerror recover none
		}

		@benchmark()
		def BenchRelayIndications() {
			relayLoop(false) onerror recover none
		}

		@benchmark()
		def BenchRelayChannel() {
			relayLoop(true) onerror recover none
		}

		// The relay loops of the benchmarks run to the end.
		@test()
		def relayLoops() !none {
			try relayLoop(false)
			return try relayLoop(true)
		}

		// Binding over UDP and TCP gives the client its own address.
		@test()
		def binding() !none {
			let server = try testServer()
			let port = server.address().port
			let overUDP = try dial("stun:127.0.0.1:{port}")
			let mapped = try overUDP.binding()
			assert mapped.host == "127.0.0.1" && mapped.port == overUDP.localAddress().port
			try overUDP.close()
			let overTCP = try dial("turn:127.0.0.1:{port}?transport=tcp")
			assert (try overTCP.binding()).host == "127.0.0.1"
			try overTCP.close()
			try server.close()
		}

		// The long-term credential mechanism: a challenge answered with the
		// SHA-256 key and USERHASH, a wrong password and an unknown user
		// refused, the shared-secret credentials taken until they expire.
		@test()
		def credentials() !none {
			let server = try testServer()
			let uri = "turn:127.0.0.1:{server.address().port}"
			let good = try dial(uri, alice())
			let relay = try good.allocate()
			let algorithm = good.core.algorithm
			fail "no password algorithm was agreed" when algorithm is none
			assert algorithm == PasswordAlgorithm.SHA256 && good.core.useHash && good.core.integrity == Integrity.SHA256
			try relay.close()
			server.secret = "shared"

			let failure ?error = none
			let wrong = try dial(uri, ClientConfig{username: "alice", password: "guess", rto: 200ms})
			failure = allocationFailure(wrong)
			assert codeOf(failure) == int(ErrorCode.Unauthenticated)
			try wrong.close()

			failure = none
			let anonymous = try dial(uri, ClientConfig{rto: 200ms})
			failure = allocationFailure(anonymous)
			assert codeOf(failure) == int(ErrorCode.Unauthenticated)
			try anonymous.close()

			let rest = restCredentials("shared", "bob", 60s)
			let guest = try dial(uri, ClientConfig{username: rest.username, password: rest.password, rto: 200ms})
			let guestRelay = try guest.allocate()
			try guestRelay.close()
			let stale = "100:bob"
			assert restExpired(stale) && !restExpired(rest.username)
			failure = none
			let late = try dial(uri, ClientConfig{username: stale, password: restPassword("shared", stale), rto: 200ms})
			failure = allocationFailure(late)
			assert codeOf(failure) == int(ErrorCode.Unauthenticated)
			try late.close()
			try server.close()
		}

		// A UDP relay reached over each transport: UDP, TCP, TLS and DTLS.
		@test()
		def relayOverEachTransport() !none {
			let server = try testServer()
			server.close() onerror recover none
			let secure = new Server("127.0.0.1:0")
			secure.realm = "adm.test"
			secure.users["alice"] = "secret"
			secure.turn = true
			secure.allowLocalPeers = true
			secure.minPort = 50000
			secure.maxPort = 50400
			secure.secureAddr = "127.0.0.1:0"
			secure.tls = tls.Config{certificates: [try tls.parseKeyPair(serverCertPEM, serverKeyPEM)]}
			try secure.start()
			let pool = new x509.CertPool()
			for let cert in try x509.parseCertificatesPEM(serverCertPEM) {
				pool.addCert(cert)
			}
			let config = alice()
			config.tls = tls.Config{rootCAs: pool, serverName: "localhost"}
			let plain = secure.address().port
			let safe = secure.secureAddress().port
			for let uri in ["turn:127.0.0.1:{plain}", "turn:127.0.0.1:{plain}?transport=tcp", "turns:127.0.0.1:{safe}", "turns:127.0.0.1:{safe}?transport=udp"] {
				let client = try dial(uri, config)
				try relayRoundTrip(client)
			}
			assert secure.allocationCount() == 0
			try secure.close()
		}

		// What a server refuses: a second allocation on one client (437),
		// one over a user's quota (486), DONT-FRAGMENT (420), a peer on its
		// own host unless allowed (403); and an even port with the next one
		// reserved for the allocation that brings its token.
		@test()
		def refusals() !none {
			let server = try testServer()
			server.userQuota = 2
			let uri = "turn:127.0.0.1:{server.address().port}"
			let first = try dial(uri, alice())
			let relay = try first.allocate(AllocateOptions{evenPort: true, reserveNext: true})
			let port = (try net.parseAddress(relay.relayed[0])).port
			assert port % 2 == 0 && relay.reservationToken.len() == 8

			// The client itself would answer 437 by starting over from a new
			// port; the request alone shows what the server says.
			let failure ?error = none
			first.transact(try allocateRequest(AllocateOptions{})) onerror (err error) {
				failure = err
				recover new Message(MessageClass.ErrorResponse, Method.Allocate, [])
			}
			assert codeOf(failure) == int(ErrorCode.AllocationMismatch)

			let second = try dial(uri, alice())
			let paired = try second.allocate(AllocateOptions{reservationToken: relay.reservationToken})
			assert (try net.parseAddress(paired.relayed[0])).port == port + 1

			failure = none
			let third = try dial(uri, alice())
			third.allocate() onerror (err error) {
				failure = err
				recover relay
			}
			assert codeOf(failure) == int(ErrorCode.AllocationQuotaReached)
			try paired.close()

			failure = none
			third.allocate(AllocateOptions{dontFragment: true}) onerror (err error) {
				failure = err
				recover relay
			}
			assert codeOf(failure) == int(ErrorCode.UnknownAttribute)
			try third.close()

			server.allowLocalPeers = false
			failure = none
			relay.permit(["127.0.0.1:9"]) onerror (err error) {
				failure = err
				recover none
			}
			assert codeOf(failure) == int(ErrorCode.Forbidden)
			try relay.close()
			assert server.allocationCount() == 0
			try server.close()
		}

		// A TCP relay (RFC 6062): the client connects out to a peer through
		// it, and a peer with a permission connects in.
		@test()
		def tcpRelay() !none {
			let server = try testServer()
			let client = try dial("turn:127.0.0.1:{server.address().port}?transport=tcp", alice())
			let relay = try client.allocate(AllocateOptions{protocol: RelayProtocol.TCP})
			let socket = try net.socket(net.SocketDomain.IPv4, net.SocketType.Stream)
			try socket.bind("127.0.0.1:0")
			let listener = try socket.listen(4)
			let peerAddress = listener.address().str()
			try relay.permit([peerAddress])

			let out = try relay.connect(peerAddress)
			let peerSide = try listener.accept()
			try net.writeAll(out, "hello".bytes(), 2s)
			let buf byte[]
			buf.len(64)
			let n = try peerSide.read(buf, 2s)
			assert string(buf[0:n]) == "hello" && peerSide.remoteAddr().str() == relay.relayed[0]
			try peerSide.writeAll("answer".bytes(), 2s)
			let m = try out.read(buf, 2s)
			assert string(buf[0:m]) == "answer"

			// A second connection to the same peer is refused while the
			// first stands.
			let failure ?error = none
			relay.connect(peerAddress) onerror (err error) {
				failure = err
				recover out
			}
			assert codeOf(failure) == int(ErrorCode.ConnectionAlreadyExists)
			try out.close()
			try peerSide.close()

			// A peer with a permission connects to the relayed address.
			let incoming = try net.dialStream(relay.relayed[0], 2s)
			let (inward, from) = try relay.accept(2s)
			assert from == incoming.localAddr().str()
			try incoming.writeAll("knock".bytes(), 2s)
			let k = try inward.read(buf, 2s)
			assert string(buf[0:k]) == "knock"
			try net.writeAll(inward, "come in".bytes(), 2s)
			let j = try incoming.read(buf, 2s)
			assert string(buf[0:j]) == "come in"
			try inward.close()
			try incoming.close()
			try relay.close()
			try listener.close()
			try server.close()
		}
	}
}
