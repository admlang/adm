partial module std.net.stun {
	use (
		std.net.stun.wire::*
		std.bytes::(Endian)
		std.net
		std.net.waiting::(awaitSignal)
		std.time
	)

	// The lifetime of a TURN permission (RFC 8656 §9) and a channel binding
	// (§12), in nanoseconds; both are refreshed a minute early.
	internal const permissionLifetime = 300000000000
	internal const channelLifetime = 600000000000
	internal const refreshMargin = 60000000000
	// The channel numbers a client may bind (RFC 8656 §12).
	internal const firstChannel = 0x4000
	internal const lastChannel = 0x4FFF

	// RelayProtocol is the transport between the TURN server and the peers,
	// the value being the IP protocol number REQUESTED-TRANSPORT carries.
	enum RelayProtocol {
		UDP = 17,
		// RFC 6062: needs a TCP or TLS connection to the server.
		TCP = 6,
	}

	// AddressFamily names the families of the TURN family attributes.
	enum AddressFamily {
		IPv4 = 1,
		IPv6 = 2,
	}

	// AllocateOptions is what an Allocate request asks for (RFC 8656 §7.1,
	// RFC 6062 §4.1): the relay protocol, the family of the relayed address
	// (none for the server's choice, IPv4) or one of each, a lifetime (0s
	// for the server's default), an even port and the reservation of the
	// next one, a port reserved earlier, and whether Send indications may
	// ask for the DF bit.
	struct AllocateOptions {
		protocol         RelayProtocol  = RelayProtocol.UDP
		family           ?AddressFamily = none
		dualStack        bool           = false
		lifetime         duration       = 0s
		evenPort         bool           = false
		reserveNext      bool           = false
		reservationToken byte[]         = []
		dontFragment     bool           = false
	}

	// Relayed is data that came through the relay: the peer that sent it
	// ("host:port") and the data; or, from a peer's network, the ICMP type
	// and code of an error (data empty, -1 for none).
	struct Relayed {
		peer     string
		data     byte[]
		icmpType int    = -1
		icmpCode int    = -1
	}

	// Allocation is a relayed transport address on a TURN server (RFC 8656
	// §6): data sent through it leaves the server from the relayed address,
	// and what peers with a permission send there comes back. The
	// allocation, its permissions and channels are refreshed on a task of
	// their own until `close`. A TCP allocation (RFC 6062) relays connections
	// with `connect` and `accept` instead.
	type Allocation {
		// The relayed addresses ("ip:port"), one per family.
		relayed           string[]
		// This side's address as the server saw it.
		mapped            string
		// The token of the port the server reserved for a later allocation
		// (EVEN-PORT with R), empty for none.
		reservationToken  byte[]
		// Why the second family of a dual-stack request was not allocated
		// (ADDRESS-ERROR-CODE), 0 when it was or none was asked.
		familyError       int
		protocol          RelayProtocol
		internal relaying Relaying

		def new(relaying Relaying) {
			self.relaying = relaying
			relayed = relaying.relayed
			mapped = relaying.mapped
			reservationToken = relaying.reservationToken
			familyError = relaying.familyError
			protocol = relaying.protocol
		}

		// lifetime is how long the allocation lasts without a refresh, as
		// the server last set it.
		def lifetime() duration {
			return relaying.granted()
		}

		// permit installs or refreshes permissions for peers ("ip:port",
		// the port does not matter) in one CreatePermission (RFC 8656
		// §10); they are refreshed until the allocation closes. Fails with
		// StunError when the server refuses (403 for a forbidden peer, 443
		// for another family).
		def permit(peers string[]) !none {
			return try relaying.permit(peers)
		}

		// send relays one datagram to a peer ("ip:port"): as ChannelData
		// when the peer has a channel, else in a Send indication, with the DF
		// bit asked for when `dontFragment` (RFC 8656 §11.1). A peer without
		// a permission gets one first. Fails with StunError when the
		// permission is refused, as the transport does otherwise.
		def send(data byte[], peer string, dontFragment bool = false) !none {
			return try relaying.send(data, peer, dontFragment)
		}

		// receive waits for the next datagram a peer sent through the relay,
		// or an ICMP error a peer's network reported (RFC 8656 §11.6); data
		// for a peer that has a RelayedPeer goes there instead. 0s or less
		// waits without end. Fails with NetError (TimedOut) when nothing
		// comes in time, StunError once the allocation is closed or lost.
		def receive(timeout duration = 30s) !Relayed {
			return try relaying.receive(timeout)
		}

		// bind binds a channel to a peer ("ip:port") with ChannelBind
		// (RFC 8656 §12.1), which also installs a permission, and returns the
		// peer as a datagram transport: data to and from it travels as
		// ChannelData. Binding a peer again returns a new transport on the
		// same channel. Fails with StunError when the server refuses or the
		// 4096 channels are used up.
		def bind(peer string) !RelayedPeer {
			return try relaying.bind(peer)
		}

		// refresh refreshes the allocation, for the server's default lifetime
		// or the one asked for (RFC 8656 §8); a task does this a minute
		// before it expires. Fails with StunError when the allocation is
		// gone (437) or the server refuses.
		def refresh(lifetime duration = 0s) !none {
			return try relaying.refresh(lifetime)
		}

		// connect opens a TCP connection from the relayed address to a peer
		// ("ip:port") and returns it as a stream to this side (RFC 6062
		// §4.3). The peer needs a permission. Fails with StunError for a UDP
		// allocation, when the server cannot reach the peer (447) or
		// refuses, NetError when the data connection cannot be opened.
		def connect(peer string) !net.Stream {
			return try relaying.connect(peer)
		}

		// accept waits for a peer to connect to the relayed address and
		// returns the connection with the peer ("ip:port", RFC 6062 §4.4).
		// Only peers with a permission get through. Fails with NetError
		// (TimedOut) when none comes in time, StunError for a UDP allocation
		// or once the allocation is closed.
		def accept(timeout duration = 0s) !(net.Stream, string) {
			return try relaying.accept(timeout)
		}

		// isOpen reports whether the allocation still stands.
		def isOpen() bool {
			return relaying.open
		}

		// close deletes the allocation (a Refresh with LIFETIME 0) and closes
		// the client's transport with it. Never fails.
		def close() !none {
			return try relaying.close()
		}

		// Deletes the allocation when the last reference is released.
		def dispose() {
			close() onerror recover none
		}
	}

	// Relaying is the state behind an Allocation: what the session's
	// reader, the keeper task and the peers' transports work on.
	internal type Relaying {
		// The relayed addresses ("ip:port"), one per family.
		relayed            string[]
		// This side's address as the server saw it.
		mapped             string
		// How long the allocation lasts without a refresh, as the server
		// set it.
		lifetime           duration
		// The token of the port the server reserved for a later
		// allocation (EVEN-PORT with R), empty for none.
		reservationToken   byte[]
		// Why the second family of a dual-stack request was not allocated
		// (ADDRESS-ERROR-CODE), 0 when it was or none was asked.
		familyError        int                     = 0
		protocol           RelayProtocol
		core               Requester
		// Peer IP addresses with a permission and when each was last
		// installed (monotonic ns).
		atomic permits     map<string, int>
		// Peers ("ip:port") bound to channels, and back.
		atomic channels    map<string, int>
		atomic peersOf     map<int, string>
		atomic boundAt     map<int, int>
		atomic nextChannel int                     = firstChannel
		atomic expiresAt   int                     = 0
		// Data not taken yet, and data for peers that have a RelayedPeer.
		atomic inbox       Relayed[]               = []
		signal             channel<none>
		atomic routes      map<string, RelayInbox>
		atomic open        bool                    = true

		def new(core Requester, protocol RelayProtocol) {
			self.core = core
			self.protocol = protocol
			signal = new channel<none>(1)
		}

		// permit installs or refreshes permissions for peers ("ip:port",
		// the port does not matter) in one CreatePermission (RFC 8656
		// §10); they are refreshed until the allocation closes. Fails with
		// StunError when the server refuses (403 for a forbidden peer, 443
		// for another family).
		def permit(peers string[]) !none {
			fail closedError() unless open
			let m = try request(Method.CreatePermission)
			for let (_, p) in peers {
				try m.add(AttributeType.XorPeerAddress, try net.parseAddress(p), true)
			}
			try core.transact(m)
			let now = int(time.monoNs())
			for let (_, p) in peers {
				markPermit(ipOf(p), now)
			}
			return none
		}

		// send relays one datagram to a peer ("ip:port"): as ChannelData
		// when the peer has a channel, else in a Send indication, with the DF
		// bit asked for when `dontFragment` (RFC 8656 §11.1). A peer without
		// a permission gets one first. Fails with StunError when the
		// permission is refused, as the transport does otherwise.
		def send(data byte[], peer string, dontFragment bool = false) !none {
			fail closedError() unless open
			try permit([peer]) unless permitted(ipOf(peer))
			let channel = channelOf(peer)
			return try core.session.send(channelData(channel, data, core.session.reliable())) when channel > 0 && !dontFragment
			let m = try indication(Method.Send)
			try m.add(AttributeType.XorPeerAddress, try net.parseAddress(peer), true)
			m.add(AttributeType.Data, data)
			m.add(AttributeType.DontFragment, []) when dontFragment
			return try core.session.send(m.encode([], Integrity.None, core.config.fingerprint))
		}

		// receive waits for the next datagram a peer sent through the relay,
		// or an ICMP error a peer's network reported (RFC 8656 §11.6); data
		// for a peer that has a RelayedPeer goes there instead. 0s or less
		// waits without end. Fails with NetError (TimedOut) when nothing
		// comes in time, StunError once the allocation is closed or lost.
		def receive(timeout duration = 30s) !Relayed {
			let deadline = timeout > 0s ?? (int(time.monoNs()) + int(timeout), 0)
			for {
				let next = take()
				return next unless next is none
				fail closedError() unless open
				let failure = core.session.closedError
				fail failure unless failure is none
				try sleepUntil(signal, deadline, "receive")
			}
			fail stunError("unreachable")
		}

		// bind binds a channel to a peer ("ip:port") with ChannelBind
		// (RFC 8656 §12.1), which also installs a permission, and returns the
		// peer as a datagram transport: data to and from it travels as
		// ChannelData. Binding a peer again returns a new transport on the
		// same channel. Fails with StunError when the server refuses or the
		// 4096 channels are used up.
		def bind(peer string) !RelayedPeer {
			fail closedError() unless open
			let address = try net.parseAddress(peer)
			let canonical = address.str()
			let channel = channelOf(canonical)
			channel = try claimChannel(canonical) when channel == 0
			try bindChannel(canonical, channel)
			return new RelayedPeer(self, canonical, channel)
		}

		// bindChannel sends the ChannelBind for a channel and records the
		// permission and binding it installs.
		internal def bindChannel(peer string, channel int) !none {
			let m = try request(Method.ChannelBind)
			m.add(AttributeType.ChannelNumber, uint16(channel).bytes(Endian.Big) + byte[0, 0])
			try m.add(AttributeType.XorPeerAddress, try net.parseAddress(peer), true)
			try core.transact(m)
			let now = int(time.monoNs())
			markPermit(ipOf(peer), now)
			markBound(channel, now)
			return none
		}

		// refresh refreshes the allocation, for the server's default lifetime
		// or the one asked for (RFC 8656 §8); the keeper does this a minute
		// before it expires. Fails with StunError when the allocation is
		// gone (437) or the server refuses.
		def refresh(lifetime duration = 0s) !none {
			fail closedError() unless open
			let m = try request(Method.Refresh)
			m.add(AttributeType.Lifetime, uint32(int(lifetime) / 1000000000)) when lifetime > 0s
			let answer = try core.transact(m)
			let seconds = answer.uint32(AttributeType.Lifetime)
			takeLifetime(seconds is none ?? (int(lifetime) / 1000000000, seconds))
			return none
		}

		// close deletes the allocation (a Refresh with LIFETIME 0, a 437
		// counting as done, RFC 8656 §8.3) and closes the client's transport
		// with it. Never fails.
		def close() !none {
			return none unless open
			let m = request(Method.Refresh) onerror recover new Message(MessageClass.Request, Method.Refresh, [])
			if m.transactionID.len() > 0 {
				m.add(AttributeType.Lifetime, uint32(0))
				core.transact(m) onerror recover new Message(MessageClass.SuccessResponse, Method.Refresh, [])
			}
			open = false
			signal.offer(none)
			for let (_, r) in allRoutes() {
				r.wake()
			}
			core.close()
			return none
		}

		// connect opens a TCP connection from the relayed address to a peer
		// ("ip:port") and returns it as a stream to this side (RFC 6062
		// §4.3): a Connect on the control connection, then a new connection
		// to the server bound to it with ConnectionBind. The peer needs a
		// permission. Fails with StunError for a UDP allocation, when the
		// server cannot reach the peer (447) or refuses, NetError when the
		// data connection cannot be opened.
		def connect(peer string) !net.Stream {
			fail stunError("connect needs a TCP allocation") unless protocol == RelayProtocol.TCP
			fail closedError() unless open
			let m = try request(Method.Connect)
			try m.add(AttributeType.XorPeerAddress, try net.parseAddress(peer), true)
			let answer = try core.transact(m)
			let id = answer.get(AttributeType.ConnectionID)
			fail stunError("the Connect response carries no CONNECTION-ID") when id is none
			return try core.bindConnection(id)
		}

		// accept waits for a peer to connect to the relayed address, binds a
		// new connection to the server to it with ConnectionBind and returns
		// it with the peer ("ip:port", RFC 6062 §4.4). Only peers with a
		// permission get through. Fails with NetError (TimedOut) when none
		// comes in time, StunError for a UDP allocation or once the
		// allocation is closed.
		def accept(timeout duration = 0s) !(net.Stream, string) {
			fail stunError("accept needs a TCP allocation") unless protocol == RelayProtocol.TCP
			let deadline = timeout > 0s ?? (int(time.monoNs()) + int(timeout), 0)
			for {
				fail closedError() unless open
				let attempt = core.session.takeAttempt()
				if !(attempt is none) {
					let id = attempt.get(AttributeType.ConnectionID)
					let peer = attempt.xorAddress(AttributeType.XorPeerAddress)
					continue when id is none || peer is none
					return (try core.bindConnection(id), peer.str())
				}
				let failure = core.session.closedError
				fail failure unless failure is none
				try sleepUntil(core.session.attemptSignal, deadline, "accept")
			}
			fail stunError("unreachable")
		}

		// route takes data the session received: to the RelayedPeer of its
		// peer, else to the inbox; dropped when it comes from a peer without
		// a permission or on a channel not bound (RFC 8656 §11.4, §12.6), or
		// when the queue it belongs in is full.
		def route(d Delivery) {
			let peer = ""
			if d.channel > 0 {
				// A bound channel has its permission (RFC 8656 §12.1).
				peer = peerOf(d.channel)
				return when peer == ""
			} else {
				let from = d.peer
				return when from is none
				peer = from.str()
				return unless permitted(from.host)
			}
			let item = Relayed{peer: peer, data: d.data, icmpType: d.icmpType, icmpCode: d.icmpCode}
			let target = routeOf(peer)
			if !(target is none) {
				target.push(item)
				return
			}
			enqueue(item)
			signal.offer(none)
		}

		// keep refreshes the allocation, permissions and channels before
		// they expire, until the allocation closes.
		def keep() {
			for open {
				time.sleep(1s)
				break unless open
				let now = int(time.monoNs())
				if now >= expiry() - refreshMargin {
					refresh() onerror (err error) {
						lose(err) when err is StunError && err.errorCode == int(ErrorCode.AllocationMismatch)
						recover none
					}
				}
				let stale string[]
				for let (ip, at) in allPermits() {
					stale.push(ip) when now - at >= permissionLifetime - refreshMargin
				}
				if stale.len() > 0 {
					let peers string[]
					for let (_, ip) in stale {
						peers.push(ip.contains(":") ?? ("[{ip}]:0", "{ip}:0"))
					}
					permit(peers) onerror recover none
				}
				for let (channel, at) in allBindings() {
					continue unless now - at >= channelLifetime - refreshMargin
					bindChannel(peerOf(channel), channel) onerror recover none
				}
			}
		}

		// lose marks the allocation gone after the server said so.
		internal def lose(err error) {
			open = false
			core.session.failAll(err)
			signal.offer(none)
		}

		// granted is the lifetime the server last set.
		atomic def granted() duration {
			return lifetime
		}

		// takeLifetime keeps the lifetime the server granted.
		atomic def takeLifetime(seconds int) {
			lifetime = duration(seconds * 1000000000)
			expiresAt = int(time.monoNs()) + seconds * 1000000000
		}

		// expiry is when the allocation lapses (monotonic ns).
		atomic def expiry() int {
			return expiresAt
		}

		// markPermit notes that a peer IP address got its permission at `at`.
		atomic def markPermit(ip string, at int) {
			permits[ip] = at
		}

		// permitted reports whether a peer IP address has a permission.
		atomic def permitted(ip string) bool {
			return permits.hasKey(ip)
		}

		// allPermits is each permitted IP address with when it was installed.
		atomic def allPermits() map<string, int> {
			return permits.clone()
		}

		// markBound notes that a channel was bound or refreshed at `at`.
		atomic def markBound(channel int, at int) {
			boundAt[channel] = at
		}

		// allBindings is each bound channel with when it was bound.
		atomic def allBindings() map<int, int> {
			return boundAt.clone()
		}

		// channelOf is the channel bound to a peer, 0 for none.
		atomic def channelOf(peer string) int {
			let found = channels.get(peer)
			return found is none ?? (0, found)
		}

		// peerOf is the peer a channel is bound to, "" for none.
		atomic def peerOf(channel int) string {
			let found = peersOf.get(channel)
			return found is none ?? ("", found)
		}

		// claimChannel takes the next free channel number for a peer. Fails
		// with StunError when all 4096 are used.
		atomic def claimChannel(peer string) !int {
			fail stunError("all channels are bound") when nextChannel > lastChannel
			let channel = nextChannel
			nextChannel++
			channels[peer] = channel
			peersOf[channel] = peer
			return channel
		}

		// setRoute sends what a peer relays to the inbox of its transport.
		atomic def setRoute(peer string, inbox RelayInbox) {
			routes[peer] = inbox
		}

		// routeOf is the inbox of a peer's transport, none without one.
		atomic def routeOf(peer string) ?RelayInbox {
			return routes.get(peer)
		}

		// allRoutes is the inboxes of every peer transport.
		atomic def allRoutes() RelayInbox[] {
			let out RelayInbox[]
			for let (_, r) in routes {
				out.push(r)
			}
			return out
		}

		// dropRoute sends what a peer relays to the allocation's own inbox
		// again.
		atomic def dropRoute(peer string) {
			routes.delete(peer)
		}

		// enqueue keeps relayed data for `receive`, unless too much waits.
		atomic def enqueue(item Relayed) {
			inbox.push(item) when inbox.len() < relayBacklog
		}

		// take is the next relayed data, none when none waits.
		atomic def take() ?Relayed {
			return none when inbox.len() == 0
			return inbox.shift()
		}
	}

	// RelayInbox is where an allocation puts what one peer relays, for the
	// peer's transport to take.
	internal type RelayInbox {
		atomic waiting Relayed[]     = []
		signal         channel<none>

		def new() {
			signal = new channel<none>(1)
		}

		// push keeps relayed data, unless too much waits, and wakes the
		// reader.
		def push(item Relayed) {
			enqueue(item)
			wake()
		}

		// wake wakes the reader.
		def wake() {
			signal.offer(none)
		}

		internal atomic def enqueue(item Relayed) {
			waiting.push(item) when waiting.len() < relayBacklog
		}

		// take is the next relayed data, none when none waits.
		atomic def take() ?Relayed {
			return none when waiting.len() == 0
			return waiting.shift()
		}
	}

	// RelayedPeer is one peer of an allocation bound to a channel, as a
	// datagram transport: what is sent goes to the peer as ChannelData, and
	// what the peer sends comes back here. Implements net.DatagramTransport.
	type RelayedPeer {
		internal allocation Relaying
		// The peer, "ip:port".
		peer                string
		channel             int
		internal inbox      RelayInbox
		atomic closed       bool       = false

		def new(allocation Relaying, peer string, channel int) {
			self.allocation = allocation
			self.peer = peer
			self.channel = channel
			inbox = new RelayInbox()
			allocation.setRoute(peer, inbox)
		}

		// send sends one datagram to the peer. Fails when the transport or
		// the allocation is closed, as the transport to the server does
		// otherwise.
		def send(data byte[], timeout duration) !none {
			fail closedError() when closed || !allocation.open
			let session = allocation.core.session
			return try session.send(channelData(channel, data, session.reliable()))
		}

		// receive waits for the next datagram from the peer, copies it into
		// buf and returns its length; 0s or less waits without end. Fails
		// with NetError (TimedOut) when nothing comes in time, StunError
		// when the peer's network reported an ICMP error, when the datagram
		// does not fit or once closed.
		def receive(buf byte[], timeout duration) !int {
			let deadline = timeout > 0s ?? (int(time.monoNs()) + int(timeout), 0)
			for {
				fail closedError() when closed || !allocation.open
				let next = inbox.take()
				if !(next is none) {
					fail stunError("ICMP type {next.icmpType} code {next.icmpCode} from {peer}") when next.icmpType >= 0
					fail stunError("a datagram of {next.data.len()} bytes does not fit in {buf.len()}") when next.data.len() > buf.len()
					next.data.copy(buf)
					return next.data.len()
				}
				try sleepUntil(inbox.signal, deadline, "receive")
			}
			fail stunError("unreachable")
		}

		// close stops this transport; the channel stays bound until the
		// allocation closes. Never fails.
		def close() !none {
			return none when closed
			closed = true
			allocation.dropRoute(peer)
			inbox.wake()
			return none
		}

		// isOpen reports whether the transport and its allocation are open.
		def isOpen() bool {
			return !closed && allocation.open
		}

		// Stops the transport when the last reference is released.
		def dispose() {
			close() onerror recover none
		}
	}

	// channelData is a ChannelData message (RFC 8656 §12.4), padded to four
	// bytes over a stream (§12.5).
	internal def channelData(channel int, data byte[], padded bool) byte[] {
		let out = uint16(channel).bytes(Endian.Big) + uint16(data.len()).bytes(Endian.Big) + data
		if padded {
			let zeros byte[]
			zeros.len((4 - data.len() % 4) % 4)
			out = out + zeros
		}
		return out
	}

	// ipOf is the IP address of "ip:port".
	internal def ipOf(address string) string {
		let a = net.parseAddress(address) onerror recover new net.Address()
		return a.host
	}

	// sleepUntil waits for a signal, up to the deadline (monotonic ns, 0 for
	// none). Fails with NetError (TimedOut) when the deadline passed.
	internal def sleepUntil(signal channel<none>, deadline int, op string) !none {
		fail net.errorOf(net.ErrorCode.TimedOut, op, "", "timed out") unless awaitSignal(signal, deadline)
		return none
	}

	internal def closedError() StunError {
		return stunError("the allocation is closed")
	}
}
