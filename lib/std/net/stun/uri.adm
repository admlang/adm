partial module std.net.stun {
	use (
		std.net.stun.wire::*
		std.net
		std.net.dns
		std.net.url
	)

	// The default ports of STUN and TURN (RFC 8489 §18.6, RFC 8656 §5).
	const defaultPort = 3478
	// The default port of STUN and TURN over TLS and DTLS.
	const defaultSecurePort = 5349

	// Transport is what STUN messages travel on between client and server.
	enum Transport {
		UDP,
		TCP,
		// TLS over TCP (RFC 8489 §6.2.3).
		TLS,
		// DTLS over UDP (RFC 7350).
		DTLS,
	}

	// ServerURI is a parsed "stun", "stuns", "turn" or "turns" URI
	// (RFC 7064, RFC 7065): the scheme, the host, the port (0 when the URI
	// gives none) and the transport between client and server.
	struct ServerURI {
		scheme    string
		host      string
		port      int       = 0
		transport Transport = Transport.UDP
	}

	// parseURI reads a STUN or TURN URI: "stun:host[:port]",
	// "stuns:host[:port]", "turn:host[:port][?transport=udp|tcp]",
	// "turns:...". An IPv6 host is in brackets. "stuns" and "turns" run over
	// TLS, or DTLS for "turns:...?transport=udp" (RFC 7350). Fails with
	// StunError for another scheme, a malformed host or port, an unknown
	// transport, or a "stuns" URI with an IP address (RFC 8489 §8.1); with
	// UrlError when the text is no URI at all.
	def parseURI(text string) !ServerURI {
		let parsed = try url.parse(text)
		let scheme = parsed.scheme.lower()
		fail stunError("{text}: scheme {scheme} is not stun, stuns, turn or turns") unless scheme := "stun" || "stuns" || "turn" || "turns"
		fail stunError("{text}: a STUN or TURN URI has no authority") when parsed.opaque == ""
		// The opaque part is an authority: read it as one.
		let authority = try parsed.with("host", parsed.opaque)
		let host = authority.hostname()
		let port = authority.port()
		fail stunError("{text}: no host") when host.len() == 0
		// A port is written when the authority is more than the host.
		let written = parsed.opaque != host && parsed.opaque != "[{host}]"
		fail stunError("{text}: port {port}") when written && (port <= 0 || port > 65535)
		let secure = scheme := "stuns" || "turns"
		fail stunError("{text}: a stuns URI must name a host, not an IP address") when scheme == "stuns" && !(net.parseIPText(host) is none)
		let transport = secure ?? (Transport.TLS, Transport.UDP)
		let values = parsed.query()
		let names = values.keys()
		if names.len() > 0 {
			fail stunError("{text}: a stun URI takes no query") unless scheme := "turn" || "turns"
			fail stunError("{text}: query {parsed.rawQuery}") unless names.len() == 1 && names[0] == "transport"
			let given = values.get("transport")
			fail stunError("{text}: transport has no value") when given is none
			let name = given.lower()
			switch {
				case name == "udp":
					transport = secure ?? (Transport.DTLS, Transport.UDP)
				case name == "tcp":
					transport = secure ?? (Transport.TLS, Transport.TCP)
				default:
					fail stunError("{text}: transport {name}")
			}
		}
		return ServerURI{scheme: scheme, host: host, port: port, transport: transport}
	}

	// resolveURI is the transport addresses ("ip:port") to try for a URI, in
	// order (RFC 8489 §8.1, RFC 8656 §4): an IP address as it is; with a
	// port, the host's addresses; without one, the SRV records of
	// "_scheme._udp" or "_scheme._tcp" and then, when there are none, the
	// host's addresses at the default port. Fails with NetError when the
	// name resolves to nothing.
	def resolveURI(uri ServerURI) !string[] {
		let secure = uri.scheme := "stuns" || "turns"
		let port = uri.port
		port = secure ?? (defaultSecurePort, defaultPort) when port == 0
		return [net.withPort(uri.host, port)] unless net.parseIPText(uri.host) is none
		if uri.port == 0 {
			let proto = (uri.transport := Transport.UDP || Transport.DTLS) ?? ("udp", "tcp")
			let found string[]
			for let (_, target) in dns.serviceTargets(uri.scheme, proto, uri.host) {
				let at = net.parseAddress(target) onerror recover new net.Address()
				let ips = net.resolve(at.host) onerror recover []
				for let (_, ip) in ips {
					found.push(net.withPort(ip, at.port))
				}
			}
			return found when found.len() > 0
		}
		let out string[]
		for let (_, ip) in try net.resolve(uri.host) {
			out.push(net.withPort(ip, port))
		}
		fail net.errorOf(net.ErrorCode.Resolve, "resolve", uri.host, "the name resolves to no address") when out.len() == 0
		return out
	}
}
