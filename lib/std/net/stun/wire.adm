// The wire-level pieces of std.net.stun: constants of the header and the
// nonce, the codecs of attribute values, and the credential preparation the
// client and the server share.
internal partial module std.net.stun.wire {
	use (
		std.bytes::(Endian)
		std.crypto::(rand)
		std.crypto.hash::(Hash, digest)
		std.data.encoding::(base64encode, base64decode)
		std.net
		std.net.stun::*
		std.text.precis
	)

	// The fixed value of every STUN header since RFC 5389.
	const magicCookie = 0x2112A442

	// The STUN header: type, length, magic cookie, transaction ID.
	const headerSize = 20

	// The XOR that sets FINGERPRINT apart from other CRCs (RFC 8489 §14.7).
	const fingerprintXor = 0x5354554E

	// The address families of MAPPED-ADDRESS and the TURN family attributes.
	const familyIPv4 = 0x01

	// IPv6 in the same attributes.
	const familyIPv6 = 0x02

	// messageSize is the size of the whole message whose first four bytes
	// are given, for reading STUN off a stream: the header and its length
	// field.
	def messageSize(head byte[]) int {
		return headerSize + (int(head[2]) << 8 | int(head[3]))
	}

	// newTransactionID is 96 cryptographically random bits (RFC 8489 §5).
	// Fails when the random source does.
	def newTransactionID() !byte[] {
		return try rand(12)
	}

	// knownAttribute reports whether this module understands an attribute
	// type: one `AttributeType` names.
	def knownAttribute(kind int) bool {
		return AttributeType.values().includes(kind)
	}

	// encodeAddress is the value of an address attribute: the family, the
	// port and the address, XORed with the magic cookie (and transaction ID
	// for IPv6) when `xor`. Fails with StunError when the address's host is
	// not an IP address.
	def encodeAddress(address net.Address, xor bool, transactionID byte[]) !byte[] {
		let ip = net.parseIPText(address.host)
		fail stunError("{address.host} is not an IP address") when ip is none
		let out byte[]
		out.len(4 + ip.len())
		out[1] = byte(ip.len() == 16 ?? (familyIPv6, familyIPv4))
		let port = xor ?? (address.port ^ (magicCookie >> 16), address.port)
		out[2] = byte((port >> 8) & 0xFF)
		out[3] = byte(port & 0xFF)
		ip.copy(out[4:])
		xorAddress(out[4:], transactionID) when xor
		return out
	}

	// xorAddress XORs an address in place with the magic cookie and, past
	// its first four bytes, the transaction ID (RFC 8489 §14.2).
	def xorAddress(ip byte[], transactionID byte[]) {
		for let i = 0; i < ip.len(); i++ {
			ip[i] = ip[i] ^ (i < 4 ?? (byte((magicCookie >> (24 - 8 * i)) & 0xFF), transactionID[i - 4]))
		}
	}

	// decodeAddress reads an address attribute's value. Fails with StunError
	// for an unknown family or a value of the wrong length.
	def decodeAddress(value byte[], xor bool, transactionID byte[]) !net.Address {
		fail stunError("address attribute of {value.len()} bytes") when value.len() < 8
		let family = int(value[1])
		let size = family == familyIPv6 ?? (16, 4)
		fail stunError("address family {family}") unless family := familyIPv4 || familyIPv6
		fail stunError("address attribute of {value.len()} bytes for family {family}") unless value.len() == 4 + size
		let port = int(value[2]) << 8 | int(value[3])
		let ip = value[4:].clone()
		if xor {
			port = port ^ (magicCookie >> 16)
			xorAddress(ip, transactionID)
		}
		let address = new net.Address()
		address.host = net.ipText(ip)
		address.port = port
		address.isIPv6 = size == 16
		address.raw = address.str()
		return address
	}

	// encodeErrorCode is the value of an ERROR-CODE attribute (RFC 8489
	// §14.8): class and number, then the reason.
	def encodeErrorCode(code int, reason string) byte[] {
		return byte[0, 0, byte(code / 100), byte(code % 100)] + reason.bytes()
	}

	// decodeErrorCode reads an ERROR-CODE value. Fails with StunError when
	// it is shorter than four bytes or the code is out of range.
	def decodeErrorCode(value byte[]) !Refusal {
		fail stunError("ERROR-CODE of {value.len()} bytes") when value.len() < 4
		let code = (int(value[2]) & 0x07) * 100 + int(value[3])
		fail stunError("error code {code}") when code < 300 || code > 699
		return Refusal{code: code, reason: string(value[4:])}
	}

	def optionalAddress(value byte[], xor bool, transactionID byte[]) !?net.Address {
		return try decodeAddress(value, xor, transactionID)
	}

	def optionalRefusal(value byte[]) !?Refusal {
		return try decodeErrorCode(value)
	}

	// attributeBytes is one attribute on the wire: type, length, value,
	// zero padding to four bytes.
	def attributeBytes(kind int, value byte[]) byte[] {
		let pad = (4 - value.len() % 4) % 4
		let zeros byte[]
		zeros.len(pad)
		return uint16(kind).bytes(Endian.Big) + uint16(value.len()).bytes(Endian.Big) + value + zeros
	}

	// reasonOf is the reason phrase the RFCs give an error code.
	def reasonOf(code ErrorCode) string {
		switch {
			case code == ErrorCode.TryAlternate:
				return "Try Alternate"
			case code == ErrorCode.BadRequest:
				return "Bad Request"
			case code == ErrorCode.Unauthenticated:
				return "Unauthenticated"
			case code == ErrorCode.Forbidden:
				return "Forbidden"
			case code == ErrorCode.UnknownAttribute:
				return "Unknown Attribute"
			case code == ErrorCode.AllocationMismatch:
				return "Allocation Mismatch"
			case code == ErrorCode.StaleNonce:
				return "Stale Nonce"
			case code == ErrorCode.AddressFamilyNotSupported:
				return "Address Family not Supported"
			case code == ErrorCode.WrongCredentials:
				return "Wrong Credentials"
			case code == ErrorCode.UnsupportedTransport:
				return "Unsupported Transport Protocol"
			case code == ErrorCode.PeerAddressFamilyMismatch:
				return "Peer Address Family Mismatch"
			case code == ErrorCode.ConnectionAlreadyExists:
				return "Connection Already Exists"
			case code == ErrorCode.ConnectionTimeoutOrFailure:
				return "Connection Timeout or Failure"
			case code == ErrorCode.AllocationQuotaReached:
				return "Allocation Quota Reached"
			case code == ErrorCode.RoleConflict:
				return "Role Conflict"
			case code == ErrorCode.ServerError:
				return "Server Error"
			case code == ErrorCode.InsufficientCapacity:
				return "Insufficient Capacity"
		}
		return ""
	}

	def stunError(message string) StunError {
		return StunError{message: "stun: {message}"}
	}

	// The 13-character prefix of a NONCE from a server of RFC 8489 (§9.2):
	// "obMatJos2" and the base64 of its 24 security feature bits.
	const nonceCookie = "obMatJos2"

	// Security feature: the server lists PASSWORD-ALGORITHMS (bit 0).
	const featurePasswordAlgorithms = 0x800000

	// Security feature: the server takes USERHASH for USERNAME (bit 1).
	const featureUsernameAnonymity = 0x400000

	// opaque is a username, realm or password processed with the PRECIS
	// OpaqueString profile, as every credential is before it is hashed or
	// sent (RFC 8489 §9). Fails with PrecisError when the profile refuses it.
	def opaque(text string) !string {
		return try precis.enforce(text, precis.Profile.OpaqueString)
	}

	// userHash is the USERHASH that stands for a username in a realm when
	// the server offers username anonymity (RFC 8489 §14.4). Fails as
	// `opaque` does.
	def userHash(username string, realm string) !byte[] {
		return digest(Hash.SHA256, ((try opaque(username)) + ":" + (try opaque(realm))).bytes())
	}

	// nonceWithFeatures is a NONCE value that announces the security
	// feature bits ahead of the server's own part (RFC 8489 §9.2).
	def nonceWithFeatures(features int, value string) string {
		return nonceCookie + base64encode(byte[byte((features >> 16) & 0xFF), byte((features >> 8) & 0xFF), byte(features & 0xFF)]) + value
	}

	// nonceFeatures is the security feature bits a NONCE announces, none
	// when it does not start with the nonce cookie (a server of RFC 5389).
	def nonceFeatures(nonce string) ?int {
		return none unless nonce.len() >= 13 && nonce.startsWith(nonceCookie)
		let bits = base64decode(nonce[9:13]) onerror recover []
		return none unless bits.len() == 3
		return int(bits[0]) << 16 | int(bits[1]) << 8 | int(bits[2])
	}

	// encodePasswordAlgorithms is the value of PASSWORD-ALGORITHMS: each
	// algorithm with its (empty) parameters (RFC 8489 §14.11).
	def encodePasswordAlgorithms(algorithms PasswordAlgorithm[]) byte[] {
		let out byte[]
		for let (_, a) in algorithms {
			out = out + uint16(int(a)).bytes(Endian.Big) + uint16(0).bytes(Endian.Big)
		}
		return out
	}

	// decodePasswordAlgorithms reads PASSWORD-ALGORITHMS into algorithm
	// codes, those this module does not know included, in order. Fails with
	// StunError when the value is malformed.
	def decodePasswordAlgorithms(value byte[]) !int[] {
		let out int[]
		let at = 0
		for at < value.len() {
			fail stunError("PASSWORD-ALGORITHMS is truncated") when value.len() - at < 4
			out.push(int(value[at]) << 8 | int(value[at + 1]))
			let length = int(value[at + 2]) << 8 | int(value[at + 3])
			at += 4 + (length + 3) / 4 * 4
			fail stunError("PASSWORD-ALGORITHMS parameters run past the value") when at > value.len()
		}
		return out
	}

	// encodePasswordAlgorithm is the value of PASSWORD-ALGORITHM.
	def encodePasswordAlgorithm(algorithm PasswordAlgorithm) byte[] {
		return uint16(int(algorithm)).bytes(Endian.Big) + uint16(0).bytes(Endian.Big)
	}

	// passwordAlgorithmOf maps a code to an algorithm this module
	// implements, none for another.
	def passwordAlgorithmOf(code int) ?PasswordAlgorithm {
		return PasswordAlgorithm.MD5 when code == int(PasswordAlgorithm.MD5)
		return PasswordAlgorithm.SHA256 when code == int(PasswordAlgorithm.SHA256)
		return none
	}
}
