partial module std.net.syslog {
	use (
		std.net
		std.net.syslog.wire::*
		std.net.tls
		std.services.policy::(Policy)
	)

	// Client sends messages to a syslog daemon or collector. It fills the
	// header fields a message leaves empty with `appName` (else the
	// application's name), `hostname` (else the machine's; left out on the
	// local socket) and `procId` (else the process ID); `log` and the
	// severity methods use `facility`. Over UDP and `/dev/log` a lost
	// message is not noticed; over TCP and TLS a failed send reconnects
	// once and tries again before it fails.
	//
	// ```
	// let log = new syslog.Client(syslog.Transport.Tls)
	// log.appName = "billing"
	// try log.connect("logs.example.com")
	// try log.warning("card declined")
	// ```
	type Client {
		transport Transport   = Transport.Udp
		// The wire form; `new` picks RFC 3164 for `Transport.Unix`, which
		// local daemons read.
		format    Format      = Format.Rfc5424
		framing   Framing     = Framing.OctetCounting
		facility  Facility    = Facility.User
		appName   string      = ""
		hostname  string      = ""
		procId    string      = ""
		// The TLS settings of `Transport.Tls`; none verifies the collector
		// against the system roots.
		tls       ?tls.Config = none
		// How long a connect or a send may wait.
		timeout   duration    = 5s
		// Messages longer than this many bytes are cut (UDP) or refused
		// (TCP, TLS); RFC 5426 advises 2048 where the path is unknown.
		maxLength int         = 2048

		internal socket ?net.Socket = none
		internal stream ?net.Stream = none
		internal target string      = ""
		internal peer   string      = ""

		def new(transport Transport = Transport.Udp, timeout duration = 5s) {
			self.transport = transport
			self.timeout = timeout
			format = Format.Rfc3164 when transport == Transport.Unix
		}

		// Connects to `addr`: `host` or `host:port` (port 514, 6514 for TLS),
		// or a socket path with `Transport.Unix`, where the empty default is
		// `/dev/log` (`/var/run/syslog` on macOS). Fails when the collector
		// cannot be reached or the TLS handshake fails.
		def connect(addr string = "") !none {
			fail syslogError("NotConnected", "already connected") when isOpen()
			peer = addr
			if transport == Transport.Unix {
				target = addr == "" ?? (localSocket(), addr)
				socket = try net.socket(net.SocketDomain.Unix, net.SocketType.Datagram)
				return none
			}
			fail syslogError("NotConnected", "no collector address") when addr == ""
			target = net.withPort(addr, transport == Transport.Tls ?? (6514, 514))
			let scheme = transport == Transport.Tls ?? ("syslog-tls", "syslog")
			try Policy.validate("adm.network.connect", "std.services.policy.EndpointSpec", scheme + "://" + target)
			if transport == Transport.Udp {
				let a = net.parseAddress(target) onerror recover new net.Address()
				socket = try net.socket(a.isIPv6 ?? (net.SocketDomain.IPv6, net.SocketDomain.IPv4), net.SocketType.Datagram)
				return none
			}
			let conn = try net.dialStream(target, timeout)
			if transport == Transport.Tls {
				let host = (net.parseAddress(target) onerror recover new net.Address()).host
				stream = secureClient(conn, tls, host, timeout) onerror (err error) {
					conn.close() onerror recover none
					fail err
				}
				return none
			}
			stream = conn
			return none
		}

		// Sends `message`, its empty header fields filled. Fails when the
		// client is not connected, the message is too long for a stream
		// transport, or the write fails.
		def send(message Message) !none {
			// A copy, so the caller's message keeps its empty fields.
			let m = new Message(message.severity, message.text)
			m.facility = message.facility
			m.time = message.time
			m.hostname = message.hostname
			m.appName = message.appName
			m.procId = message.procId
			m.msgId = message.msgId
			m.data = message.data
			m.appName = appName == "" ?? (defaultAppName(), appName) when m.appName == ""
			m.procId = procId == "" ?? (defaultProcId(), procId) when m.procId == ""
			m.hostname = hostname == "" ?? (defaultHostname(), hostname) when m.hostname == "" && transport != Transport.Unix
			return try transmit(m.format(format).bytes())
		}

		// Sends `text` at `severity`, with `data` as structured data. Fails
		// as `send` does.
		def log(severity Severity, text string, data Element[] = []) !none {
			let m = new Message(severity, text)
			m.facility = facility
			m.data = data
			return try send(m)
		}

		// Sends `text` at `Emergency`. Fails as `send` does.
		def emergency(text string) !none {
			return try log(Severity.Emergency, text)
		}

		// Sends `text` at `Alert`. Fails as `send` does.
		def alert(text string) !none {
			return try log(Severity.Alert, text)
		}

		// Sends `text` at `Critical`. Fails as `send` does.
		def critical(text string) !none {
			return try log(Severity.Critical, text)
		}

		// Sends `text` at `Error`. Fails as `send` does.
		def error(text string) !none {
			return try log(Severity.Error, text)
		}

		// Sends `text` at `Warning`. Fails as `send` does.
		def warning(text string) !none {
			return try log(Severity.Warning, text)
		}

		// Sends `text` at `Notice`. Fails as `send` does.
		def notice(text string) !none {
			return try log(Severity.Notice, text)
		}

		// Sends `text` at `Info`. Fails as `send` does.
		def info(text string) !none {
			return try log(Severity.Info, text)
		}

		// Sends `text` at `Debug`. Fails as `send` does.
		def debug(text string) !none {
			return try log(Severity.Debug, text)
		}

		// Implements `io.Writer`: sends `data` as one already-formatted
		// message (what `Encoder` produces), framed for the transport, and
		// returns its length. Fails as `send` does.
		def write(data byte[]) !int {
			try transmit(data)
			return data.len()
		}

		// Whether the client is connected.
		def isOpen() bool {
			return !(socket is none) || !(stream is none)
		}

		// Closes the connection. Fails when it is already closed.
		def close() !none {
			fail syslogError("NotConnected", "not connected") unless isOpen()
			drop()
			return none
		}

		def dispose() {
			drop()
		}

		// transmit sends one formatted message: a datagram cut to
		// `maxLength`, or a frame on the stream, reconnecting once when the
		// stream write fails.
		internal def transmit(data byte[]) !none {
			let dgram = socket
			if !(dgram is none) {
				try dgram.writeTo(cutUTF8(data, maxLength), target, timeout)
				return none
			}
			fail syslogError("NotConnected", "not connected") when stream is none
			fail syslogError("TooLong", "message of {data.len()} bytes, the limit is {maxLength}") when data.len() > maxLength
			fail syslogError("BadMessage", "a line break cannot be sent with non-transparent framing") when framing == Framing.NonTransparent && data.indexOf(byte(0x0A)) >= 0
			let wire = frame(data, framing)
			let failed = false
			writeFully(try output(), wire, timeout) onerror (err error) {
				failed = true
				recover none
			}
			return none unless failed
			drop()
			try connect(peer)
			return try writeFully(try output(), wire, timeout)
		}

		internal def output() !net.Stream {
			let s = stream
			fail syslogError("NotConnected", "not connected") when s is none
			return s
		}

		internal def drop() {
			let s = stream
			if !(s is none) {
				s.close() onerror recover none
			}
			let d = socket
			if !(d is none) {
				d.close() onerror recover none
			}
			stream = none
			socket = none
		}
	}
}
