partial module std.net.syslog {
	use (
		std.net.syslog.wire::*
		std.services.logging::(LogRecord, LogLevel)
	)

	// Encoder turns records of the `Logging` service into syslog messages,
	// so a `Client` can be one of its writers:
	//
	// ```
	// let client = new syslog.Client()
	// try client.connect()
	// Logging.config(
	//    LogConfig{
	//         writers: [
	//           LogWriterConfig{
	//                writer: client,
	//                encoder: new syslog.Encoder("billing"),
	//                levels: [LogLevel.Warning, LogLevel.Error, LogLevel.Fatal],
	//           }
	//         ]
	//    }
	// )
	// ```
	//
	// Levels map to severities `Debug`, `Info`, `Warning`, `Error` and
	// `Critical` (for `Fatal`); the record's fields go into the structured
	// data element `fieldsId`, their values as text.
	type Encoder {
		appName  string   = ""
		facility Facility = Facility.User
		format   Format   = Format.Rfc5424
		// The SD-ID holding a record's fields, under the ADM Language
		// Project's private enterprise number 67015.
		fieldsId string   = "adm@67015"

		def new(appName string = "", facility Facility = Facility.User, format Format = Format.Rfc5424) {
			self.appName = appName
			self.facility = facility
			self.format = format
		}

		// Implements `LogEncoder`. Does not fail.
		def encode(record LogRecord) !byte[] {
			let m = new Message(severityOf(record.level), record.message)
			m.facility = facility
			m.appName = appName == "" ?? (defaultAppName(), appName)
			m.procId = defaultProcId()
			// RFC 3164 mostly goes to the local socket, which takes no host
			// name.
			m.hostname = defaultHostname() unless format == Format.Rfc3164
			let params Param[] = []
			for let (name, value) in record.fields {
				params.push(Param{name: name, value: "{value}"})
			}
			params.sort((a, b) => a.name < b.name)
			for let p in params {
				m.add(fieldsId, p.name, p.value)
			}
			return m.format(format).bytes()
		}

		// severityOf is the severity a log level is sent at.
		internal def severityOf(level LogLevel) Severity {
			match level {
				case LogLevel.Debug:
					return Severity.Debug
				case LogLevel.Info:
					return Severity.Info
				case LogLevel.Warning:
					return Severity.Warning
				case LogLevel.Error:
					return Severity.Error
				default:
					return Severity.Critical
			}
		}
	}
}
