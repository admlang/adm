partial module std.net.syslog {
	use (
		std.errors
		std.net.syslog.wire::*
		std.time::(Time)
	)

	// Facility is the part of the system a message comes from (RFC 5424
	// §6.2.1); its code is its position, `Kern` 0 to `Local7` 23.
	enum Facility {
		Kern,
		User,
		Mail,
		Daemon,
		Auth,
		Syslog,
		Lpr,
		News,
		Uucp,
		Cron,
		AuthPriv,
		Ftp,
		Ntp,
		Audit,
		Alert,
		Clock,
		Local0,
		Local1,
		Local2,
		Local3,
		Local4,
		Local5,
		Local6,
		Local7,
	}

	// Severity is how urgent a message is (RFC 5424 §6.2.1); its code is
	// its position, `Emergency` 0 to `Debug` 7.
	enum Severity {
		Emergency,
		Alert,
		Critical,
		Error,
		Warning,
		Notice,
		Info,
		Debug,
	}

	// Transport picks how messages travel.
	enum Transport {
		// UDP datagrams, one message each (RFC 5426), port 514.
		Udp  = "udp",
		// TCP with framed messages (RFC 6587), port 514.
		Tcp  = "tcp",
		// TLS over TCP (RFC 5425), port 6514.
		Tls  = "tls",
		// The local syslog daemon's Unix datagram socket (`/dev/log`).
		Unix = "unix",
	}

	// Format picks the wire form of a message.
	enum Format {
		// `<PRI>1 TIMESTAMP HOSTNAME APP-NAME PROCID MSGID [SD] MSG`
		// (RFC 5424).
		Rfc5424 = "rfc5424",
		// The BSD form `<PRI>Mmm dd hh:mm:ss HOSTNAME TAG[PID]: MSG`
		// (RFC 3164), what older daemons and `/dev/log` readers expect.
		Rfc3164 = "rfc3164",
	}

	// Framing picks how messages are delimited on TCP and TLS (RFC 6587).
	enum Framing {
		// `LENGTH SP MESSAGE`; the only framing RFC 5425 allows.
		OctetCounting  = "octet-counting",
		// Messages ended by LF; a message cannot hold a line break.
		NonTransparent = "non-transparent",
	}

	// SyslogError is the payload of a message that does not parse or
	// cannot be sent. `code` names the kind: `BadMessage`, `TooLong`,
	// `NotConnected`.
	struct SyslogError {
		message string
		code    string
		cause   ?error
		stack   errors.StackTrace
	}

	// Param is one `name="value"` pair of a structured data element.
	struct Param {
		name  string
		value string
	}

	// Element is one structured data element (RFC 5424 §6.3):
	// `[id name="value" ...]`. An `id` without `@` is an IANA-registered
	// one (`timeQuality`, `origin`, `meta`); others read `name@number`.
	struct Element {
		id     string
		params Param[]
	}

	// Message is one syslog message. Empty header fields are the NILVALUE
	// `-` on the wire; `time` none is filled with the send time.
	//
	// ```
	// let msg = new syslog.Message(syslog.Severity.Warning, "disk almost full")
	//     .add("disk@32473", "free", "3%")
	// ```
	type Message {
		facility Facility  = Facility.User
		severity Severity  = Severity.Notice
		time     ?Time     = none
		hostname string    = ""
		appName  string    = ""
		procId   string    = ""
		msgId    string    = ""
		data     Element[] = []
		text     string    = ""

		def new(severity Severity = Severity.Notice, text string = "") {
			self.severity = severity
			self.text = text
		}

		// The PRI value: facility code × 8 + severity code.
		def priority() int {
			return int(facility) * 8 + int(severity)
		}

		// Adds `name="value"` to the element `id`, creating it when absent,
		// and returns the message.
		def add(id string, name string, value string) Message {
			for let e in data {
				continue unless e.id == id
				e.params.push(Param{name: name, value: value})
				return self
			}
			data.push(Element{id: id, params: [Param{name:name, value:value}]})
			return self
		}

		// The value of `name` in the element `id`, none when absent.
		def param(id string, name string) ?string {
			for let e in data {
				continue unless e.id == id
				for let p in e.params {
					return p.value when p.name == name
				}
			}
			return none
		}

		// The message in `format`, without framing. RFC 3164 has no
		// structured data or MSGID; they are left out.
		def format(format Format = Format.Rfc5424) string {
			let at = stampOf(time)
			return format == Format.Rfc3164 ?? (format3164(self, at), format5424(self, at))
		}

		// The RFC 5424 form.
		def str() string {
			return format(Format.Rfc5424)
		}
	}

	// Parses a message: RFC 5424 when the version `1` follows the PRI,
	// else the RFC 3164 form, where a missing or broken header keeps the
	// text as `text` (RFC 3164 §4.3). Fails when the PRI is missing or out
	// of range, or an RFC 5424 header or structured data is malformed.
	def parse(text string) !Message {
		return try parseMessage(text)
	}
}
