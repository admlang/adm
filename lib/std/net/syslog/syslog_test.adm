partial module std.net.syslog {
	use (
		std.crypto.x509::(CertPool)
		std.net
		std.net.syslog.wire::*
		std.net.tls
		std.services.logging::(LogLevel, LogRecord, LogWriterConfig)
		std.testing
		std.time
	)

	// A self-signed P-256 certificate for 127.0.0.1, localhost and
	// example.com, valid for a century (the one httptest presents).
	internal const syslogCertPEM =
		"-----BEGIN CERTIFICATE-----\n" +
		"MIIByzCCAXCgAwIBAgIULZ61fkBLJqpHXo7Dg3TjjURKNKQwCgYIKoZIzj0EAwIw\n" +
		"EzERMA8GA1UEAwwIQURNIHRlc3QwIBcNMjYwOTE2MjEyNDQ4WhgPMjEyNjA4MjMy\n" +
		"MTI0NDhaMBMxETAPBgNVBAMMCEFETSB0ZXN0MFkwEwYHKoZIzj0CAQYIKoZIzj0D\n" +
		"AQcDQgAEWmnKIPFi8/hNfbTouWeJ0sX7jXIK0H2BdAa3ZlChTQUtkRXRuGnkYmY9\n" +
		"c9D2sLIU0D8YtBwSi1XCEXkyARGL3KOBnzCBnDAdBgNVHQ4EFgQUdGEQb1u97o8W\n" +
		"5FkheQ27r3JNU3AwHwYDVR0jBBgwFoAUdGEQb1u97o8W5FkheQ27r3JNU3AwDwYD\n" +
		"VR0TAQH/BAUwAwEB/zAnBgNVHREEIDAegglsb2NhbGhvc3SCC2V4YW1wbGUuY29t\n" +
		"hwR/AAABMAsGA1UdDwQEAwIHgDATBgNVHSUEDDAKBggrBgEFBQcDATAKBggqhkjO\n" +
		"PQQDAgNJADBGAiEA6p+D8so1nzo4nOkB8z0x1Tq+9iG1qIweVo/zTnSHG9cCIQDo\n" +
		"ANw/RkMk5iyYvJf8Qx75u8fY/n2s26d6Clj96iuH/g==\n" +
		"-----END CERTIFICATE-----\n"

	internal const syslogKeyPEM =
		"-----BEGIN PRIVATE KEY-----\n" +
		"MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgz6zLOlG3plulCC6J\n" +
		"73w4HvDFzW9lrGWy0U1PuM2M1gWhRANCAARaacog8WLz+E19tOi5Z4nSxfuNcgrQ\n" +
		"fYF0BrdmUKFNBS2RFdG4aeRiZj1z0PawshTQPxi0HBKLVcIReTIBEYvc\n" +
		"-----END PRIVATE KEY-----\n"

	// Archive keeps what a test collector received.
	type Archive {
		messages Message[] = []

		def new() {}

		atomic def receive(message Message, from net.Address) !none {
			messages.push(message)
			return none
		}

		atomic def count() int {
			return messages.len()
		}

		// waitFor waits up to two seconds for `n` messages.
		def waitFor(n int) bool {
			for let i = 0; i < 200; i++ {
				return true when count() >= n
				time.sleep(10ms)
			}
			return false
		}
	}

	internal def at(text string) time.Time {
		return time.parse(text) onerror recover time.fromUnixNs(0)
	}

	internal def collector(archive Archive, transport Transport, addr string = "127.0.0.1:0") !Server {
		let server = new Server(archive, addr, transport)
		let pair = try tls.parseKeyPair(syslogCertPEM, syslogKeyPEM)
		server.tls = tls.Config{certificates: [pair]}
		server.idleTimeout = 5s
		try server.start()
		return server
	}

	internal def clientOf(server Server, transport Transport) !Client {
		let client = new Client(transport, 5s)
		let pool = new CertPool()
		pool.appendCertsFromPEM(syslogCertPEM)
		client.tls = tls.Config{serverName: "localhost", rootCAs: pool}
		client.appName = "tester"
		client.hostname = "box"
		client.procId = "42"
		try client.connect(transport == Transport.Unix ?? (server.addr, server.address().str()))
		return client
	}

	check "syslog format" {
		@test()
		def writesRfc5424() !none {
			let m = new Message(Severity.Warning, "disk almost full")
			m.facility = Facility.Local4
			m.time = at("2003-10-11T22:14:15.003123456Z")
			m.hostname = "mymachine.example.com"
			m.appName = "evntslog"
			m.msgId = "ID47"
			m.add("exampleSDID@32473", "iut", "3").add("exampleSDID@32473", "note", "a \"quoted\" ] \\ value")
			assert m.priority() == 164
			assert m.str() == "<164>1 2003-10-11T22:14:15.003123Z mymachine.example.com evntslog - ID47 [exampleSDID@32473 iut=\"3\" note=\"a \\\"quoted\\\" \\] \\\\ value\"] disk almost full"
			let bare = new Message(Severity.Emergency)
			bare.facility = Facility.Kern
			bare.time = at("2003-10-11T22:14:15Z")
			assert bare.str() == "<0>1 2003-10-11T22:14:15Z - - - - -"
			let accented = new Message(Severity.Info, "café")
			accented.time = at("2003-10-11T22:14:15Z")
			assert accented.str().endsWith(" - ﻿café")
			assert orEmpty(m.param("exampleSDID@32473", "iut")) == "3"
			assert m.param("exampleSDID@32473", "none") is none
			return none
		}

		@test()
		def writesRfc3164() !none {
			let m = new Message(Severity.Critical, "'su root' failed")
			m.facility = Facility.Auth
			m.time = at("2003-10-01T22:14:15Z")
			m.hostname = "mymachine"
			m.appName = "su"
			assert m.format(Format.Rfc3164) == "<34>Oct  1 22:14:15 mymachine su: 'su root' failed"
			m.hostname = ""
			m.procId = "77"
			assert m.format(Format.Rfc3164) == "<34>Oct  1 22:14:15 su[77]: 'su root' failed"
			return none
		}

		@test()
		def parsesRfc5424Examples() !none {
			// RFC 5424 §6.5, examples 1 and 3 (the BOM of example 1 kept out).
			let one = try parse("<34>1 2003-10-11T22:14:15.003Z mymachine.example.com su - ID47 - 'su root' failed for lonvick on /dev/pts/8")
			assert one.facility == Facility.Auth && one.severity == Severity.Critical
			assert one.hostname == "mymachine.example.com" && one.appName == "su" && one.procId == "" && one.msgId == "ID47"
			assert one.text == "'su root' failed for lonvick on /dev/pts/8"
			let three = try parse("<165>1 2003-10-11T22:14:15.003Z mymachine.example.com evntslog - ID47 [exampleSDID@32473 iut=\"3\" eventSource=\"Application\" eventID=\"1011\"][examplePriority@32473 class=\"high\"]")
			assert three.data.len() == 2 && orEmpty(three.param("exampleSDID@32473", "eventID")) == "1011" && three.text == ""
			let four = try parse("<165>1 2003-08-24T05:14:15.000003-07:00 192.0.2.1 myproc 8710 - - ﻿%% It's time to make the do-nuts.")
			let stamp = four.time
			fail "no timestamp" when stamp is none
			assert stamp.hour() == 12
			assert four.procId == "8710" && four.text == "%% It's time to make the do-nuts."
			let escaped = try parse("<13>1 - - - - - [a@1 v=\"x\\\"y\\]z\"] msg")
			assert orEmpty(escaped.param("a@1", "v")) == "x\"y]z" && escaped.text == "msg"
			return none
		}

		@test()
		def parsesRfc3164() !none {
			let m = try parse("<34>Oct 11 22:14:15 mymachine su: 'su root' failed for lonvick on /dev/pts/8")
			assert m.facility == Facility.Auth && m.hostname == "mymachine" && m.appName == "su"
			assert m.text == "'su root' failed for lonvick on /dev/pts/8"
			let local = try parse("<13>Sep  8 10:00:00 app[12]: hi there")
			assert local.hostname == "" && local.appName == "app" && local.procId == "12" && local.text == "hi there"
			let raw = try parse("<13>just some text")
			assert raw.text == "just some text" && raw.time is none
			return none
		}

		@test()
		def rejectsBadPri() !none {
			assert parse("no pri") is error
			assert parse("<192>1 - - - - - -") is error
			assert parse("<013>x") is error
			assert parse("<13>1 - - - - [broken") is error
			return none
		}

		@test()
		def encodesLogRecords() !none {
			let encoder = new Encoder("billing", Facility.Local0)
			let bytes = try encoder.encode(LogRecord{level: LogLevel.Fatal, message: "card declined", fields: {"user": "u1", "amount": 12}})
			let m = try parse(string(bytes))
			assert m.severity == Severity.Critical && m.facility == Facility.Local0 && m.appName == "billing"
			assert orEmpty(m.param("adm@67015", "user")) == "u1" && orEmpty(m.param("adm@67015", "amount")) == "12"
			assert m.text == "card declined"
			let as3164 = new Encoder("billing", Facility.User, Format.Rfc3164)
			let old = string(try as3164.encode(LogRecord{level: LogLevel.Info, message: "hi", fields: {}}))
			assert old.startsWith("<14>") && old.contains(" billing[") && old.endsWith("]: hi")
			return none
		}
	}

	check "syslog transport" {
		@test()
		def sendsOverUdp() !none {
			let archive = new Archive()
			let server = try collector(archive, Transport.Udp)
			let client = try clientOf(server, Transport.Udp)
			try client.warning("over udp")
			assert client.isOpen()
			for let severity in [Severity.Emergency, Severity.Alert, Severity.Critical, Severity.Debug] {
				try client.log(severity, "level {int(severity)}")
			}
			try client.emergency("e")
			try client.alert("a")
			try client.critical("c")
			try client.debug("d")
			client.maxLength = 64
			try client.info("x".repeat(200))
			assert archive.waitFor(10)
			let first = archive.messages[0]
			assert first.severity == Severity.Warning && first.text == "over udp" && first.appName == "tester" && first.hostname == "box" && first.procId == "42"
			assert archive.messages[9].text.len() < 64 && archive.messages[1].severity == Severity.Emergency
			try client.close()
			try server.close()
			return none
		}

		@test()
		def sendsOverTcpBothFramings() !none {
			let archive = new Archive()
			let server = try collector(archive, Transport.Tcp)
			let counted = try clientOf(server, Transport.Tcp)
			try counted.send(new Message(Severity.Error, "line one\nline two"))
			let lined = try clientOf(server, Transport.Tcp)
			lined.framing = Framing.NonTransparent
			try lined.notice("plain line")
			assert lined.notice("two\nlines") is error
			assert archive.waitFor(2)
			let texts string[] = []
			for let m in archive.messages {
				texts.push(m.text)
			}
			assert texts.indexOf("line one\nline two") >= 0 && texts.indexOf("plain line") >= 0
			assert server.connectionCount() == 2
			counted.maxLength = 10
			assert counted.info("far too long for the limit") is error
			try counted.close()
			try lined.close()
			try server.close()
			return none
		}

		@test()
		def sendsOverTls() !none {
			let archive = new Archive()
			let server = try collector(archive, Transport.Tls)
			let client = try clientOf(server, Transport.Tls)
			let m = new Message(Severity.Alert, "secured")
			m.add("origin", "ip", "192.0.2.1")
			try client.send(m)
			assert archive.waitFor(1)
			assert archive.messages[0].text == "secured" && orEmpty(archive.messages[0].param("origin", "ip")) == "192.0.2.1"
			assert m.appName == ""
			try client.close()
			try server.close()
			return none
		}

		@test()
		def sendsOverUnixSocket() !none {
			let archive = new Archive()
			let path = "/tmp/adm-syslog-{time.now().unixNs()}.sock"
			let server = try collector(archive, Transport.Unix, path)
			let client = try clientOf(server, Transport.Unix)
			assert client.format == Format.Rfc3164
			try client.error("local daemon")
			assert archive.waitFor(1)
			let got = archive.messages[0]
			assert got.text == "local daemon" && got.appName == "tester" && got.procId == "42" && got.hostname == ""
			try client.close()
			try server.close()
			return none
		}

		@test()
		def deliversUnparsedText() !none {
			let archive = new Archive()
			let server = try collector(archive, Transport.Udp)
			let client = try clientOf(server, Transport.Udp)
			try client.write("no pri at all".bytes())
			assert archive.waitFor(1)
			assert archive.messages[0].text == "no pri at all" && archive.messages[0].severity == Severity.Notice
			try client.close()
			try server.close()
			return none
		}

		@test()
		def fitsTheLoggingService() !none {
			let client = new Client()
			let config = LogWriterConfig{writer: client, encoder: new Encoder("app"), levels: [LogLevel.Error]}
			assert config.levels.len() == 1
			assert client.write("x".bytes()) is error
			assert client.close() is error
			return none
		}
	}

	// orEmpty is the text of an optional, empty when none.
	internal def orEmpty(text ?string) string {
		return "" when text is none
		return text
	}
}
