internal partial module std.net.syslog.wire {
	use (
		std.metrics
		std.net
		std.net.syslog::*
		std.net.tls
		std.os
		std.services::(Application)
		std.services.runtime::(Runtime)
		std.services.diagnostics::(metric)
		std.time
		std.time::(Time)
	)

	// The facilities and severities in code order.
	let facilities = [Facility.Kern, Facility.User, Facility.Mail, Facility.Daemon, Facility.Auth, Facility.Syslog, Facility.Lpr, Facility.News, Facility.Uucp, Facility.Cron, Facility.AuthPriv, Facility.Ftp, Facility.Ntp, Facility.Audit, Facility.Alert, Facility.Clock, Facility.Local0, Facility.Local1, Facility.Local2, Facility.Local3, Facility.Local4, Facility.Local5, Facility.Local6, Facility.Local7]
	let severities = [Severity.Emergency, Severity.Alert, Severity.Critical, Severity.Error, Severity.Warning, Severity.Notice, Severity.Info, Severity.Debug]

	let monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]

	// The byte-order mark RFC 5424 §6.4 puts before a UTF-8 MSG.
	const bom = "﻿"

	// syslogError is the SyslogError of `code` with `message`.
	def syslogError(code string, message string) SyslogError {
		return SyslogError{message: "syslog: " + message, code: code}
	}

	// stampOf is a message's time, now when it has none.
	def stampOf(t ?Time) Time {
		return time.now() when t is none
		return t
	}

	// ---- writing -------------------------------------------------------------

	// format5424 writes `<PRI>1 TIMESTAMP HOSTNAME APP-NAME PROCID MSGID SD
	// [MSG]`, header fields cut to their RFC 5424 lengths and made of
	// printable ASCII, `-` for empty ones.
	def format5424(m Message, at Time) string {
		let out = "<{m.priority()}>1 " + timestamp5424(at)
		out += " " + headerField(m.hostname, 255)
		out += " " + headerField(m.appName, 48)
		out += " " + headerField(m.procId, 128)
		out += " " + headerField(m.msgId, 32)
		out += " " + structuredData(m.data)
		if m.text != "" {
			out += " "
			out += bom unless isASCII(m.text)
			out += m.text
		}
		return out
	}

	// format3164 writes `<PRI>Mmm dd hh:mm:ss [HOSTNAME ]TAG[[PID]]: MSG`;
	// the host name is left out when empty, as the local socket expects.
	def format3164(m Message, at Time) string {
		let out = "<{m.priority()}>" + timestamp3164(at) + " "
		out += headerField(m.hostname, 255) + " " when m.hostname != ""
		let tag = m.appName == "" ?? ("-", headerField(m.appName, 32))
		out += tag
		out += "[" + headerField(m.procId, 128) + "]" when m.procId != ""
		return out + ": " + m.text
	}

	// timestamp5424 is RFC 3339 in UTC with at most six fraction digits.
	def timestamp5424(t Time) string {
		let text = t.str()
		let dot = text.indexOf(".")
		return text when dot < 0
		let digits = text[dot + 1:text.len() - 1]
		digits = digits[:6] when digits.len() > 6
		return text[:dot + 1] + digits + "Z"
	}

	// timestamp3164 is `Mmm dd hh:mm:ss` in UTC, the day padded with a
	// space.
	def timestamp3164(t Time) string {
		let day = t.day() < 10 ?? (" {t.day()}", "{t.day()}")
		return "{monthNames[t.month() - 1]} {day} {two(t.hour())}:{two(t.minute())}:{two(t.second())}"
	}

	def two(n int) string {
		return n < 10 ?? ("0{n}", "{n}")
	}

	// headerField is `text` as a header field: printable ASCII (others
	// become `?`), at most `limit` bytes, `-` when empty.
	def headerField(text string, limit int) string {
		return "-" when text == ""
		let out byte[] = []
		for let b in text.bytes() {
			out.push(b >= 0x21 && b <= 0x7E ?? (b, byte(0x3F)))
			break when out.len() == limit
		}
		return string(out)
	}

	// structuredData writes the elements, `-` when there are none.
	def structuredData(data Element[]) string {
		return "-" when data.len() == 0
		let out = ""
		for let e in data {
			out += "[" + sdName(e.id)
			for let p in e.params {
				out += " " + sdName(p.name) + "=\"" + p.value.replace("\\", "\\\\").replace("\"", "\\\"").replace("]", "\\]") + "\""
			}
			out += "]"
		}
		return out
	}

	// sdName is an SD-ID or PARAM-NAME: printable ASCII without `=`, space,
	// `]` and `"` (others become `_`), at most 32 bytes.
	def sdName(text string) string {
		let out byte[] = []
		for let b in text.bytes() {
			let ok = b >= 0x21 && b <= 0x7E && !(b := 0x3D || 0x5D || 0x22)
			out.push(ok ?? (b, byte(0x5F)))
			break when out.len() == 32
		}
		return out.len() == 0 ?? ("_", string(out))
	}

	def isASCII(text string) bool {
		for let b in text.bytes() {
			return false when b >= 0x80
		}
		return true
	}

	// frame wraps a message for a stream: `LENGTH SP MSG` or `MSG LF`.
	def frame(data byte[], framing Framing) byte[] {
		return "{data.len()} ".bytes() + data when framing == Framing.OctetCounting
		let out = data.clone()
		out.push(0x0A)
		return out
	}

	// ---- reading -------------------------------------------------------------

	// parseMessage reads RFC 5424 when `1 ` follows the PRI, else RFC 3164.
	def parseMessage(text string) !Message {
		let line = text.trimEnd("\r\n\u0000")
		fail syslogError("BadMessage", "no PRI") unless line.startsWith("<")
		let close = line.indexOf(">")
		fail syslogError("BadMessage", "no PRI") unless close >= 2 && close <= 4
		let digits = line[1:close]
		fail syslogError("BadMessage", "bad PRI <{digits}>") unless digits.isNumeric() && (digits == "0" || !digits.startsWith("0"))
		let pri = digits.toInt<int>()
		fail syslogError("BadMessage", "PRI {pri} out of range") when pri > 191
		let m = new Message(severities[pri % 8], "")
		m.facility = facilities[pri / 8]
		let rest = line[close + 1:]
		if rest.startsWith("1 ") {
			try parse5424(m, rest[2:])
		} else {
			parse3164(m, rest)
		}
		return m
	}

	// parse5424 reads the header after the version, the structured data and
	// the MSG.
	def parse5424(m Message, text string) !none {
		let fields string[] = []
		let at = 0
		for fields.len() < 5 {
			let space = text.indexOf(" ", at)
			fail syslogError("BadMessage", "RFC 5424 header cut short") when space < 0
			fields.push(text[at:space])
			at = space + 1
		}
		if fields[0] != "-" {
			m.time = time.parse(fields[0]) onerror (err error) {
				fail syslogError("BadMessage", "bad timestamp {fields[0]}")
			}
		}
		m.hostname = nil5424(fields[1])
		m.appName = nil5424(fields[2])
		m.procId = nil5424(fields[3])
		m.msgId = nil5424(fields[4])
		let rest = text[at:]
		if rest.startsWith("-") {
			rest = rest[1:]
		} else {
			let (data, after) = try parseStructured(rest)
			m.data = data
			rest = after
		}
		fail syslogError("BadMessage", "no space before MSG") unless rest == "" || rest.startsWith(" ")
		rest = rest.trimPrefix(" ")
		m.text = rest.trimPrefix(bom)
		return none
	}

	def nil5424(field string) string {
		return field == "-" ?? ("", field)
	}

	// parseStructured reads `[id name="value" ...]...` from the front of
	// `text`: the elements and what follows them.
	def parseStructured(text string) !(Element[], string) {
		let elements Element[] = []
		let i = 0
		for i < text.len() && text[i] == '[' {
			i++
			let start = i
			for i < text.len() && !(text[i] := ' ' || ']') {
				i++
			}
			fail syslogError("BadMessage", "unterminated structured data") when i >= text.len()
			let element = Element{id: text[start:i], params: []}
			fail syslogError("BadMessage", "empty SD-ID") when element.id == ""
			for i < text.len() && text[i] == ' ' {
				i++
				let nameStart = i
				for i < text.len() && text[i] != '=' {
					i++
				}
				fail syslogError("BadMessage", "bad SD-PARAM") unless i + 1 < text.len() && text[i + 1] == '"'
				let name = text[nameStart:i]
				i += 2
				let value = ""
				for {
					fail syslogError("BadMessage", "unterminated PARAM-VALUE") when i >= text.len()
					let c = text[i]
					if c == '\\' && i + 1 < text.len() && (text[i + 1] := '"' || '\\' || ']') {
						value += string(text[i + 1])
						i += 2
						continue
					}
					i++
					break when c == '"'
					value += string(c)
				}
				element.params.push(Param{name: name, value: value})
			}
			fail syslogError("BadMessage", "unterminated structured data") unless i < text.len() && text[i] == ']'
			i++
			elements.push(element)
		}
		fail syslogError("BadMessage", "bad structured data") when elements.len() == 0
		return (elements, text[i:])
	}

	// parse3164 reads the BSD form. A missing or broken timestamp leaves
	// the whole rest as the text (RFC 3164 §4.3.2); after a timestamp, a
	// first word followed by a tag is the host name.
	def parse3164(m Message, text string) {
		let stamp = parseTimestamp3164(text)
		if stamp is none {
			m.text = text
			return
		}
		m.time = stamp
		let rest = text.len() > 16 ?? (text[16:], "")
		// A first word that does not end the tag is the host name.
		let space = rest.indexOf(" ")
		if space > 0 {
			let first = rest[:space]
			if !first.endsWith(":") && !first.contains("[") {
				m.hostname = first
				rest = rest[space + 1:]
			}
		}
		let colon = rest.indexOf(": ")
		let tagEnd = colon < 0 ?? (rest.endsWith(":") ?? (rest.len() - 1, -1), colon)
		if tagEnd <= 0 || rest[:tagEnd].contains(" ") {
			m.text = rest
			return
		}
		let tag = rest[:tagEnd]
		let open = tag.indexOf("[")
		if open > 0 && tag.endsWith("]") {
			m.appName = tag[:open]
			m.procId = tag[open + 1:tag.len() - 1]
		} else {
			m.appName = tag
		}
		m.text = colon < 0 ?? ("", rest[colon + 2:])
	}

	// parseTimestamp3164 reads `Mmm dd hh:mm:ss` and a space at the front of
	// `text`, in the current year, none when it is not there.
	def parseTimestamp3164(text string) ?Time {
		return none when text.len() < 16 || text[15] != ' '
		let month = monthNames.indexOf(text[:3])
		return none when month < 0 || text[3] != ' '
		let dayText = text[4:6].trim()
		let clock = text[7:15]
		return none unless dayText.isNumeric() && clock[2] == ':' && clock[5] == ':'
		let year = time.now().year()
		let iso = "{year}-{two(month + 1)}-{two(dayText.toInt<int>())}T{clock}Z"
		return time.parse(iso) onerror recover time.fromUnixNs(-1)
	}

	// ---- defaults and transport helpers ------------------------------------

	// defaultHostname is the machine's name: `HOSTNAME`, else
	// `/etc/hostname`, else empty.
	def defaultHostname() string {
		let env = Runtime.getEnv("HOSTNAME")
		return env.trim() unless env is none || env.trim() == ""
		let raw = os.readFile("/etc/hostname") onerror recover []
		return string(raw).trim()
	}

	// defaultAppName is the application's name.
	def defaultAppName() string {
		return Application.name()
	}

	// defaultProcId is the process ID.
	def defaultProcId() string {
		return "{Application.pid()}"
	}

	// localSocket is the local daemon's socket: `/dev/log`, else
	// `/var/run/syslog` (macOS).
	def localSocket() string {
		let dev = os.exists("/dev/log") onerror recover false
		let mac = os.exists("/var/run/syslog") onerror recover false
		return mac && !dev ?? ("/var/run/syslog", "/dev/log")
	}

	// cutUTF8 is at most `limit` bytes of `data`, not splitting a UTF-8
	// sequence.
	def cutUTF8(data byte[], limit int) byte[] {
		return data when data.len() <= limit
		let end = limit
		for end > 0 && data[end] >= 0x80 && data[end] < 0xC0 {
			end--
		}
		return data.slice(0, end)
	}

	// writeFully writes all of data to a stream. Fails when a write does
	// or moves nothing.
	def writeFully(stream net.Stream, data byte[], timeout duration) !none {
		let off = 0
		for off < data.len() {
			let n = try stream.write(data[off:], timeout)
			fail net.errorOf(net.ErrorCode.Pipe, "write", "", "wrote nothing") when n <= 0
			off += n
		}
		return none
	}

	// secureClient runs the TLS client handshake with `base`, the server
	// name set to `host` when it has none. Fails as the handshake does.
	def secureClient(conn net.Connection, base ?tls.Config, host string, timeout duration) !net.Stream {
		let config = tls.Config{}
		config = base unless base is none
		config = tls.withServerName(config, host) when config.serverName == ""
		let secured = tls.client(conn, config)
		try secured.handshake(timeout)
		return secured
	}

	// secureServer runs the TLS server handshake. Fails as it does.
	def secureServer(conn net.Connection, config tls.Config, timeout duration) !net.Stream {
		let secured = tls.server(conn, config)
		try secured.handshake(timeout)
		return secured
	}

	// ---- collector side --------------------------------------------------------

	// ServerStats holds the metrics of syslog servers, registered once per
	// process and shared by every server.
	type ServerStats {
		@metric("net.syslog.server.messages.received")
		received metrics.Counter
		@metric("net.syslog.server.messages.unparsed")
		unparsed metrics.Counter
		@metric("net.syslog.server.handler.failures")
		failures metrics.Counter
		@metric("net.syslog.server.bytes.in")
		bytesIn metrics.Counter
		@metric("net.syslog.server.connections.open")
		connectionsOpen metrics.Gauge
		@metric("net.syslog.server.connections.total")
		connectionsTotal metrics.Counter

		def new() {}
	}

	// received parses raw message text, keeping text that does not parse as
	// a `user.notice` message (RFC 3164 §4.3.3).
	def received(raw string, stats ServerStats) Message {
		stats.received.inc()
		let failed = false
		let m = parseMessage(raw) onerror (err error) {
			failed = true
			recover new Message(Severity.Notice, "")
		}
		if failed {
			stats.unparsed.inc()
			m.text = raw.trimEnd("\r\n")
		}
		return m
	}

	// FrameReader reads RFC 6587 frames from a stream, octet-counted or
	// LF-ended, detected per message.
	type FrameReader {
		stream  net.Stream
		limit   int
		pending byte[]     = []

		def new(stream net.Stream, limit int) {
			self.stream = stream
			self.limit = limit
		}

		// next is the next message. Fails when the stream ends, a read
		// fails, or a frame is longer than `limit`.
		def next(timeout duration) !string {
			try fill(1, timeout)
			if pending[0] >= 0x31 && pending[0] <= 0x39 {
				let space = -1
				for space < 0 {
					for let i = 0; i < pending.len(); i++ {
						if pending[i] == 0x20 {
							space = i
							break
						}
						fail syslogError("BadMessage", "bad frame length") unless pending[i] >= 0x30 && pending[i] <= 0x39 && i < 9
					}
					try fill(pending.len() + 1, timeout) when space < 0
				}
				let count = string(pending[:space]).toInt<int>()
				fail syslogError("TooLong", "frame of {count} bytes") when count > limit
				try fill(space + 1 + count, timeout)
				let body = pending.slice(space + 1, count)
				pending = pending[space + 1 + count:].clone()
				return string(body)
			}
			let scanned = 0
			for {
				for let i = scanned; i < pending.len(); i++ {
					if pending[i] == 0x0A {
						let body = pending.slice(0, i)
						pending = pending[i + 1:].clone()
						return string(body)
					}
				}
				scanned = pending.len()
				fail syslogError("TooLong", "line longer than {limit} bytes") when pending.len() > limit
				try fill(pending.len() + 1, timeout)
			}
			fail "unreachable"
		}

		// fill reads until at least `count` bytes are pending.
		internal def fill(count int, timeout duration) !none {
			for pending.len() < count {
				let buf byte[] = []
				buf.len(8192)
				let n = try stream.read(buf, timeout)
				fail net.errorOf(net.ErrorCode.Closed, "read", "", "connection closed") when n == 0
				pending = pending + buf[:n]
			}
			return none
		}
	}
}
