partial module std.net.tcp {
	use std.net

	// Client is a TCP client backed by a stream socket.
	type Client {
		internal conn ?net.Connection = none

		// connect dials a TCP server and stores the resulting connection.
		// Fails when the address does not parse, the connection is refused or it times out.
		def connect(addr string, timeout duration = 30s) !none {
			conn = try net.dialStream(addr, timeout)
			return none
		}

		internal def connection() !net.Connection {
			fail "tcp client is not connected" when conn is none
			return conn
		}

		// read reads from the established connection.
		// Fails when no connection is established, or the read does.
		def read(buf byte[]) !int {
			let c = try connection()
			return c.read(buf)
		}

		// write writes to the established connection.
		// Fails when no connection is established, or the write does.
		def write(buf byte[]) !int {
			let c = try connection()
			return c.write(buf)
		}

		// remoteAddr returns the peer address of the established connection.
		// Fails when no connection is established.
		def remoteAddr() !net.Address {
			let c = try connection()
			return c.remoteAddr()
		}

		// localAddr returns the local address of the established connection.
		// Fails when no connection is established.
		def localAddr() !net.Address {
			let c = try connection()
			return c.localAddr()
		}

		// close shuts down and closes the underlying connection (best-effort).
		// Fails when the connection refuses to close.
		def close() !none {
			return none when conn is none
			let c net.Connection = conn
			c.shutdown() onerror recover none
			c.close() onerror recover none
			conn = none
			return none
		}

		// Closes the client when the last reference is released.
		def dispose() {
			close() onerror recover none
		}
	}
}
