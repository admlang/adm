partial module std.net.tcp {
	use std.net

	// Server is a basic TCP server that binds and accepts connections.
	//
	// This is a low-level server: it does not spawn accept loops; callers are
	// expected to call `accept()` and handle connections.
	type Server {
		addr    string
		backlog int    = 128

		internal ln      ?net.Listener = none
		internal running bool          = false

		def new(addr string, backlog int = 128) {
			self.addr = addr
			self.backlog = backlog
		}

		// start binds and begins listening.
		// Fails when the address cannot be bound or listening is refused.
		def start() !none {
			return none when running
			let a = net.parseAddress(addr) onerror recover new net.Address()

			let domain = net.SocketDomain.IPv4
			if a.isUnix {
				domain = net.SocketDomain.Unix
			} else if a.isIPv6 {
				domain = net.SocketDomain.IPv6
			}

			let sock = try net.socket(domain, net.SocketType.Stream)
			sock.setReuseAddr(true) onerror recover none
			sock.setReusePort(true) onerror recover none
			try sock.bind(addr)
			ln = try sock.listen(backlog)

			running = true
			return none
		}

		// accept accepts the next incoming connection.
		// Fails when the server is not started, or accepting does.
		def accept() !net.Connection {
			fail "tcp server is not started" when ln is none
			return ln.accept()
		}

		// stop closes the listener socket.
		// Fails when the listener refuses to close.
		def stop() !none {
			return none unless running
			if ln is none {
				running = false
				return none
			}
			let l net.Listener = ln
			l.close() onerror recover none
			ln = none
			running = false
			return none
		}

		// address returns the server's local bound address.
		def address() net.Address {
			if ln is none {
				return net.parseAddress(addr) onerror recover new net.Address()
			}
			return ln.address()
		}
	}
}
