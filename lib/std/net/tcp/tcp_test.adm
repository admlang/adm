partial module std.net.tcp {
	use (
		std.net
		std.testing
	)

	// serveUpper accepts one client, upper-cases what it reads and sends it back.
	internal async def serveUpper(server Server) !none {
		let conn = try server.accept()
		let buf byte[] = []
		buf.len(64)
		let n = try conn.read(buf, 5s)
		try conn.writeAll(string(buf[:n]).upper().bytes())
		try conn.close()
		return none
	}

	check "TCP" {
		@test()
		def serverRoundTrip() !none {
			let server = new Server("127.0.0.1:0")
			try server.start()
			try server.start()
			assert server.address().port > 0
			let task = async serveUpper(server)

			let client = new Client()
			assert !client.isOpen()
			try client.connect(server.address().str(), 2s)
			assert client.isOpen()
			assert (try client.remoteAddr()).port == server.address().port
			assert (try client.localAddr()).host == "127.0.0.1"
			assert (try client.write("ping".bytes(), 2s)) == 4
			let buf byte[] = []
			buf.len(16)
			let n = try client.read(buf)
			assert string(buf[:n]) == "PING"
			try await task
			// The server closed its side: the client, as a `net.Stream`,
			// reads the end of the stream.
			let stream net.Stream = client
			assert (try stream.read(buf, 1s)) == 0
			try client.close()
			assert !client.isOpen()
			try client.close()
			try server.close()
			try server.close()
			return none
		}

		@test()
		def acceptBeforeStartFails() {
			let server = new Server("127.0.0.1:0")
			let seen = false
			server.accept() onerror (err error) {
				if err is net.NetError {
					seen = err.kind == net.ErrorCode.Closed && err.op == "accept"
				}
				recover new net.Connection(-1)
			}
			assert seen
		}

		@test()
		def clientBeforeConnectFails() {
			let client = new Client()
			let seen = false
			client.write("x".bytes()) onerror (err error) {
				if err is net.NetError {
					seen = err.kind == net.ErrorCode.Closed
				}
				recover 0
			}
			assert seen
		}

		@test()
		def connectRefused() {
			let client = new Client()
			let seen = false
			client.connect("127.0.0.1:1", 2s) onerror (err error) {
				if err is net.NetError {
					seen = err.kind == net.ErrorCode.ConnRefused && err.addr == "127.0.0.1:1"
				}
				recover none
			}
			assert seen
		}
	}
}
