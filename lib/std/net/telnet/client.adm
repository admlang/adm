partial module std.net.telnet {
	use (
		std.net
		std.net.telnet.proto::*
		std.net.tls
		std.time
	)

	// Client is a Telnet client: it answers the server's option requests
	// from its fields (terminal type, window size, environment, ...) and
	// hands the text through. Writes are what a user types: with LINEMODE
	// the client edits the line locally and sends it on Enter, with the
	// echo read back through `read` when the server does not echo.
	// Implements `net.Stream`, `io.Reader` and `io.Writer`.
	//
	// ```
	// let client = new telnet.Client()
	// try client.connect("bbs.example.com")
	// try client.readUntil("login: ")
	// try client.writeLine("guest")
	// ```
	type Client {
		security    Security            = Security.Plain
		// The TLS settings for telnets; none verifies the server against the
		// system roots under the host name it was dialled by.
		tls         ?tls.Config         = none
		// How long each read or write may wait.
		timeout     duration            = 30s
		// Terminal types to name (TERMINAL-TYPE), most specific first.
		terminals   string[]            = ["xterm-256color", "xterm", "vt100"]
		// The window size to report (NAWS); `resize` changes it later.
		window      WindowSize          = WindowSize{columns: 80, rows: 24}
		// The speed to report (TERMINAL-SPEED), "transmit,receive".
		speed       string              = "38400,38400"
		// The X display to report (X-DISPLAY-LOCATION); "" sends none.
		display     string              = ""
		// Environment variables the server may ask for (NEW-ENVIRON).
		environment map<string, string>
		// Character sets this client speaks (CHARSET), in preference order.
		charsets    string[]            = ["UTF-8"]
		// Take GMCP messages and compressed output (MCCP2) when offered, and
		// compress input (MCCP3) when the server takes it.
		gmcp        bool                = true
		compression bool                = true

		internal engine ?Engine = none

		def new(security Security = Security.Plain, timeout duration = 30s) {
			self.security = security
			self.timeout = timeout
		}

		// Connects to a server, `host` or `host:port`; the port defaults to
		// 23, or 992 with `Security.Implicit`. Options are negotiated as the
		// server asks, while reading.
		// Fails with NetError when the dial does, TLSError when the handshake
		// does.
		def connect(addr string) !none {
			fail telnetError("already connected") unless engine is none
			let target = withDefaultPort(addr, security == Security.Implicit ?? (992, 23))
			let conn = try net.dialStream(target, timeout)
			conn.urgentInline() onerror recover none
			let stream net.Stream = conn
			let plain = true
			if security == Security.Implicit {
				let host = hostOf(target)
				stream = clientTLS(conn, clientConfig(tls, host), timeout) onerror (err error) {
					conn.close() onerror recover none
					fail err
				}
				plain = false
			}
			let e = new Engine(conn, stream, false, timeout)
			e.plainTCP = plain
			e.myTerminals = terminals
			e.myWindow = window
			e.mySpeed = speed
			e.myDisplay = display
			e.myEnvironment = environment
			e.myCharsets = charsets
			let local = [int(Option.TerminalType), int(Option.WindowSize), int(Option.TerminalSpeed), int(Option.Environment), int(Option.Linemode), int(Option.Binary), int(Option.FlowControl), int(Option.Charset), int(Option.TimingMark)]
			local.push(int(Option.DisplayLocation)) unless display == ""
			local.push(int(Option.Gmcp)) when gmcp
			for let o in local {
				e.acceptLocal[o] = true
			}
			let remote = [int(Option.Echo), int(Option.SuppressGoAhead), int(Option.Status), int(Option.Binary), int(Option.EndOfRecord), int(Option.Charset), int(Option.Mssp)]
			remote.push(int(Option.Gmcp)) when gmcp
			if compression {
				remote.push(int(Option.Mccp2))
				remote.push(int(Option.Mccp3))
			}
			for let o in remote {
				e.acceptRemote[o] = true
			}
			engine = e
			return none
		}

		internal def connected() !Engine {
			let e = engine
			fail net.errorOf(net.ErrorCode.Closed, "telnet", "", "not connected") when e is none
			return e
		}

		// read copies what the server sent into buf, waiting up to `timeout`;
		// 0 once it closed. Fails when the connection does.
		def read(buf byte[], timeout duration) !int {
			let e = try connected()
			return try e.read(buf, timeout)
		}

		// read with the client's timeout. Implements std.io.Reader.
		// Fails when the connection does.
		def read(buf byte[]) !int {
			return try read(buf, timeout)
		}

		// write sends what the user typed, through the local line editor
		// under LINEMODE. Fails when the connection does.
		def write(buf byte[], timeout duration) !int {
			let e = try connected()
			try e.writeInput(buf)
			return buf.len()
		}

		// write with the client's timeout. Implements std.io.Writer.
		// Fails when the connection does.
		def write(buf byte[]) !int {
			return try write(buf, timeout)
		}

		// writeLine sends a line of text and Enter. Fails when the connection
		// does.
		def writeLine(text string) !none {
			try write((text + "\r").bytes())
			return none
		}

		// readLine is the next line the server sends, without its line end.
		// Fails when the connection closes first or a read times out.
		def readLine(timeout duration = 30s) !string {
			let text = try readUntil("\n", timeout)
			return text.trimEnd("\n").trimEnd("\r")
		}

		// readUntil reads until the text read ends with `marker` (a prompt
		// such as "login: ") and returns all of it.
		// Fails when the connection closes first or `timeout` passes.
		def readUntil(marker string, timeout duration = 30s) !string {
			let e = try connected()
			let limit = time.now() + timeout
			let got byte[] = []
			let want = marker.bytes()
			let one byte[] = [byte(0)]
			for {
				fail net.errorOf(net.ErrorCode.TimedOut, "read", "", "no {marker} within the timeout") when time.now().after(limit)
				let n = try e.read(one, limit - time.now())
				fail net.errorOf(net.ErrorCode.Closed, "read", "", "connection closed before {marker}") when n == 0
				got.push(one[0])
				return string(got) when got.len() >= want.len() && got[got.len() - want.len():].hex() == want.hex()
			}
			fail "unreachable"
		}

		// readUntil a regular expression matching the end of what was read.
		// Fails when the connection closes first or `timeout` passes.
		def readUntil(pattern regex, timeout duration = 30s) !string {
			let e = try connected()
			let limit = time.now() + timeout
			let got byte[] = []
			let one byte[] = [byte(0)]
			for {
				fail net.errorOf(net.ErrorCode.TimedOut, "read", "", "no match within the timeout") when time.now().after(limit)
				let n = try e.read(one, limit - time.now())
				fail net.errorOf(net.ErrorCode.Closed, "read", "", "connection closed before a match") when n == 0
				got.push(one[0])
				let text = string(got)
				return text when pattern.test(text)
			}
			fail "unreachable"
		}

		// Sends a signal: Interrupt, Abort Output and Break are followed by a
		// Synch (urgent data), so the server drops what it has not read.
		// Fails when the connection does.
		def sendSignal(signal Signal) !none {
			let e = try connected()
			return try e.sendSignal(signal)
		}

		// Sends Interrupt Process (Ctrl-C). Fails when the connection does.
		def interrupt() !none {
			return try sendSignal(Signal.Interrupt)
		}

		// Sends Abort Output. Fails when the connection does.
		def abortOutput() !none {
			return try sendSignal(Signal.AbortOutput)
		}

		// Sends Are You There; the server answers with visible text.
		// Fails when the connection does.
		def areYouThere() !none {
			return try sendSignal(Signal.AreYouThere)
		}

		// Sends Break. Fails when the connection does.
		def sendBreak() !none {
			return try sendSignal(Signal.Break)
		}

		// Sends Erase Character: the server drops the last character typed.
		// Fails when the connection does.
		def eraseChar() !none {
			let e = try connected()
			return try e.sendCommand(cmdEC)
		}

		// Sends Erase Line: the server drops the line being typed.
		// Fails when the connection does.
		def eraseLine() !none {
			let e = try connected()
			return try e.sendCommand(cmdEL)
		}

		// Reports a new window size (NAWS) when the server agreed to it.
		// Fails when the connection does.
		def resize(columns int, rows int) !none {
			window = WindowSize{columns: columns, rows: rows}
			let e = try connected()
			e.myWindow = window
			return none unless e.localEnabled(int(Option.WindowSize))
			return try e.sendSub(int(Option.WindowSize), nawsBody(window))
		}

		// synchronize waits until the server has answered everything sent
		// before and its replies were read (TIMING-MARK).
		// Fails when no answer comes within `timeout`.
		def synchronize(timeout duration = 5s) !none {
			let e = try connected()
			return try e.timingMark(timeout)
		}

		// Reports whether the server echoes what is typed (ECHO), so a
		// terminal should not.
		def serverEchoes() bool {
			let e = engine
			return !(e is none) && e.remoteEnabled(int(Option.Echo))
		}

		// Reports whether lines are edited here (LINEMODE with EDIT).
		def editsLines() bool {
			let e = engine
			return !(e is none) && e.linemode.editing()
		}

		// Reports whether an option is on, on either side.
		def hasOption(option Option) bool {
			let e = engine
			return false when e is none
			return e.localEnabled(int(option)) || e.remoteEnabled(int(option))
		}

		// Reports whether the server asked this client to handle XON/XOFF
		// flow control itself (TOGGLE-FLOW-CONTROL, on by default).
		def flowControl() bool {
			let e = engine
			return e is none || e.flowControl
		}

		// The character set agreed on (CHARSET); "" when none was.
		def charset() string {
			let e = engine
			return "" when e is none
			return e.charset
		}

		// The status the server sent (MSSP): NAME, PLAYERS, ... with their
		// values; empty when it sent none.
		def serverStatus() map<string, string[]> {
			let e = engine
			let nothing map<string, string[]>
			return nothing when e is none
			return e.serverStatus
		}

		// Registers fn to hear the signals the server sends.
		// Fails when not connected.
		def onSignal(fn def (Signal)) !none {
			let e = try connected()
			e.addSignalHook(fn)
			return none
		}

		// Registers fn to hear GMCP messages: the message name and its JSON
		// text. Fails when not connected.
		def onGmcp(fn def (string, string)) !none {
			let e = try connected()
			e.addGmcpHook(fn)
			return none
		}

		// Sends a GMCP message. Fails with TelnetError when the server did
		// not offer GMCP, or as the connection does.
		def sendGmcp(message string, json string = "") !none {
			let e = try connected()
			fail telnetError("the server did not offer GMCP") unless e.remoteEnabled(int(Option.Gmcp))
			return try e.sendSub(int(Option.Gmcp), gmcpBody(message, json))
		}

		// Implements net.Stream: whether the connection is open.
		def isOpen() bool {
			let e = engine
			return !(e is none) && !e.closed
		}

		// The server's address. Fails when not connected.
		def remoteAddr() !net.Address {
			let e = try connected()
			return e.socket.remoteAddr()
		}

		// Implements net.Stream: closes the connection. Closing twice does
		// nothing. Fails when the connection refuses to close.
		def close() !none {
			let e = engine
			return none when e is none
			engine = none
			return try e.close()
		}

		// Closes the connection when the last reference is released.
		def dispose() {
			close() onerror recover none
		}
	}
}
