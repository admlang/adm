internal partial module std.net.telnet.proto {
	use std.net.telnet::*

	// LINEMODE (RFC 1184) suboptions, MODE bits and SLC codes.
	const lmMODE = 1
	const lmFORWARDMASK = 2
	const lmSLC = 3
	const modeEDIT = 1
	const modeTRAPSIG = 2
	const modeACK = 4
	const modeSOFT_TAB = 8
	const modeLIT_ECHO = 16
	const modeMASK = 27

	const slcSYNCH = 1
	const slcBRK = 2
	const slcIP = 3
	const slcAO = 4
	const slcAYT = 5
	const slcEOR = 6
	const slcABORT = 7
	const slcEOF = 8
	const slcSUSP = 9
	const slcEC = 10
	const slcEL = 11
	const slcEW = 12
	const slcRP = 13
	const slcLNEXT = 14
	const slcXON = 15
	const slcXOFF = 16
	const slcFORW1 = 17
	const slcFORW2 = 18
	const slcCount = 18

	const slcNOSUPPORT = 0
	const slcCANTCHANGE = 1
	const slcVALUE = 2
	const slcDEFAULT = 3
	const slcLEVELBITS = 3
	const slcFLUSHOUT = 32
	const slcFLUSHIN = 64
	const slcACK = 128

	// SlcEntry is one special character: its level and flags, and the
	// character (0 for none).
	type SlcEntry {
		modifiers int = 0
		value     int = 0

		def new(modifiers int, value int) {
			self.modifiers = modifiers
			self.value = value
		}

		def supported() bool {
			return (modifiers & slcLEVELBITS) != slcNOSUPPORT && value != 0
		}
	}

	// defaultSlc is the special character table a client starts with: the
	// usual Unix keys.
	def defaultSlc() map<int, SlcEntry> {
		let t map<int, SlcEntry>
		let flushBoth = slcVALUE | slcFLUSHIN | slcFLUSHOUT
		t[slcSYNCH] = new SlcEntry(slcNOSUPPORT, 0)
		t[slcBRK] = new SlcEntry(slcNOSUPPORT, 0)
		t[slcIP] = new SlcEntry(flushBoth, 3)
		t[slcAO] = new SlcEntry(slcVALUE | slcFLUSHOUT, 15)
		t[slcAYT] = new SlcEntry(slcVALUE, 20)
		t[slcEOR] = new SlcEntry(slcNOSUPPORT, 0)
		t[slcABORT] = new SlcEntry(flushBoth, 28)
		t[slcEOF] = new SlcEntry(slcVALUE, 4)
		t[slcSUSP] = new SlcEntry(slcVALUE | slcFLUSHIN, 26)
		t[slcEC] = new SlcEntry(slcVALUE, 127)
		t[slcEL] = new SlcEntry(slcVALUE, 21)
		t[slcEW] = new SlcEntry(slcVALUE, 23)
		t[slcRP] = new SlcEntry(slcVALUE, 18)
		t[slcLNEXT] = new SlcEntry(slcVALUE, 22)
		t[slcXON] = new SlcEntry(slcVALUE, 17)
		t[slcXOFF] = new SlcEntry(slcVALUE, 19)
		t[slcFORW1] = new SlcEntry(slcNOSUPPORT, 0)
		t[slcFORW2] = new SlcEntry(slcNOSUPPORT, 0)
		return t
	}

	// Linemode is one end's LINEMODE state (RFC 1184): the mode agreed,
	// the special character table and forward mask, and on a client the
	// line being edited.
	type Linemode {
		isServer bool
		// The mode in effect, acknowledged by both ends.
		mode     int                = 0
		active   bool               = false
		slc      map<int, SlcEntry>
		forward  byte[]
		line     byte[]
		literal  bool               = false

		def new(isServer bool) {
			self.isServer = isServer
			slc = defaultSlc()
		}

		// editing reports whether this end edits lines locally: a client with
		// LINEMODE on in EDIT mode.
		def editing() bool {
			return active && !isServer && (mode & modeEDIT) != 0
		}

		// enabled starts LINEMODE: a server asks for local editing with
		// signals trapped, a client sends its special character table.
		def enabled(e Engine) !none {
			active = true
			return try e.sendSub(int(Option.Linemode), [byte(lmMODE), byte(modeEDIT | modeTRAPSIG)]) when isServer
			return try e.sendSub(int(Option.Linemode), [byte(lmSLC)] + slcTriplets(true))
		}

		// disabled ends LINEMODE: a half-edited line is sent as it is.
		def disabled(e Engine) !none {
			active = false
			mode = 0
			if line.len() > 0 && !isServer {
				let pending = line
				line = []
				return try e.write(pending)
			}
			return none
		}

		// slcTriplets is the table as SLC triplets; `all` includes entries
		// this end does not support.
		def slcTriplets(all bool) byte[] {
			let out byte[] = []
			for let f = 1; f <= slcCount; f++ {
				let entry = slc.get(f)
				continue when entry is none
				continue unless all || entry.supported()
				out.push(byte(f))
				out.push(byte(entry.modifiers))
				out.push(byte(entry.value))
			}
			return out
		}

		// sub takes a LINEMODE subnegotiation.
		def sub(e Engine, body byte[]) !none {
			return none when body.len() == 0
			let kind = int(body[0])
			switch {
				case kind == lmMODE && body.len() >= 2:
					return try modeSub(e, int(body[1]))
				case kind == lmSLC:
					return try slcSub(e, body[1:])
				case kind == cmdDO && body.len() >= 2 && int(body[1]) == lmFORWARDMASK:
					forward = body[2:].clone()
					return try e.sendSub(int(Option.Linemode), [byte(cmdWILL), byte(lmFORWARDMASK)])
				case kind == cmdDONT && body.len() >= 2 && int(body[1]) == lmFORWARDMASK:
					forward = []
					return try e.sendSub(int(Option.Linemode), [byte(cmdWONT), byte(lmFORWARDMASK)])
			}
			return none
		}

		// modeSub takes MODE: an acknowledgement settles the mode; a
		// proposal is taken (the bits this end knows) and acknowledged.
		internal def modeSub(e Engine, value int) !none {
			if (value & modeACK) != 0 {
				mode = value & modeMASK
				return none
			}
			let agreed = value & modeMASK
			return none when agreed == mode && active
			mode = agreed
			active = true
			return try e.sendSub(int(Option.Linemode), [byte(lmMODE), byte(agreed | modeACK)])
		}

		// slcSub takes SLC triplets: SLC_DEFAULT on function 0 asks for the
		// whole table; an acknowledged triplet is stored; any other is taken
		// and acknowledged, one this end cannot use answered NOSUPPORT.
		internal def slcSub(e Engine, triplets byte[]) !none {
			let reply byte[] = []
			let i = 0
			for i + 3 <= triplets.len() {
				let f = int(triplets[i])
				let modifiers = int(triplets[i + 1])
				let value = int(triplets[i + 2])
				i += 3
				if f == 0 && (modifiers & slcLEVELBITS) == slcDEFAULT {
					slc = defaultSlc()
					reply = reply + slcTriplets(true)
					continue
				}
				continue when f < 1 || f > slcCount
				let stored = modifiers & 127
				if (modifiers & slcACK) != 0 {
					slc[f] = new SlcEntry(stored, value)
					continue
				}
				let current = slc.get(f)
				if !(current is none) && current.modifiers == stored && current.value == value {
					continue
				}
				slc[f] = new SlcEntry(stored, value)
				reply = reply + [byte(f), byte(stored | slcACK), byte(value)]
			}
			return none when reply.len() == 0
			return try e.sendSub(int(Option.Linemode), [byte(lmSLC)] + reply)
		}

		// signalFor is the command a special character stands for when
		// signals are trapped, 0 for none, and whether it flushes input.
		internal def signalFor(c int) (int, bool) {
			return (0, false) when (mode & modeTRAPSIG) == 0
			for let (f, entry) in slc {
				continue unless entry.supported() && entry.value == c
				let flush = (entry.modifiers & slcFLUSHIN) != 0
				switch {
					case f == slcIP:
						return (cmdIP, flush)
					case f == slcAO:
						return (cmdAO, flush)
					case f == slcAYT:
						return (cmdAYT, flush)
					case f == slcBRK:
						return (cmdBRK, flush)
					case f == slcABORT:
						return (cmdABORT, flush)
					case f == slcSUSP:
						return (cmdSUSP, flush)
				}
			}
			return (0, false)
		}

		// isFunction reports whether a character is the special character of
		// an SLC function.
		internal def isFunction(f int, c int) bool {
			let entry = slc.get(f)
			return !(entry is none) && entry.supported() && entry.value == c
		}

		// forwards reports whether a character sends the line at once: the
		// forward mask's bit for it, or FORW1/FORW2.
		internal def forwards(c int) bool {
			return true when isFunction(slcFORW1, c) || isFunction(slcFORW2, c)
			let index = c / 8
			return false when index >= forward.len()
			return (int(forward[index]) & (128 >> (c % 8))) != 0
		}

		// edit runs typed bytes through the line editor: it sends completed
		// lines and trapped signals, and returns what to echo.
		// Fails when the connection does.
		def edit(e Engine, typed byte[]) !byte[] {
			let echo byte[] = []
			for let b in typed {
				let c = int(b)
				if literal {
					literal = false
					line.push(b)
					echo = echo + echoOf(c)
					continue
				}
				if isFunction(slcLNEXT, c) {
					literal = true
					continue
				}
				let (command, flush) = signalFor(c)
				if command != 0 {
					line = [] when flush
					try e.sendCommand(command)
					try e.synch() when command := cmdIP || cmdAO || cmdABORT
					continue
				}
				switch {
					case isFunction(slcEOF, c):
						try e.write(line) when line.len() > 0
						line = []
						try e.sendCommand(cmdEOF)
					case isFunction(slcEC, c):
						if line.len() > 0 {
							line = line[:line.len() - 1].clone()
							echo = echo + "\b \b".bytes()
						}
					case isFunction(slcEL, c):
						for let i = 0; i < line.len(); i++ {
							echo = echo + "\b \b".bytes()
						}
						line = []
					case isFunction(slcEW, c):
						for line.len() > 0 && line[line.len() - 1] == byte(32) {
							line = line[:line.len() - 1].clone()
							echo = echo + "\b \b".bytes()
						}
						for line.len() > 0 && line[line.len() - 1] != byte(32) {
							line = line[:line.len() - 1].clone()
							echo = echo + "\b \b".bytes()
						}
					case isFunction(slcRP, c):
						echo = echo + "^R\r\n".bytes() + line
					case c := 13 || 10:
						let sent = line + "\r\n".bytes()
						line = []
						echo = echo + "\r\n".bytes()
						try e.sendRaw(e.nvtOut.encode(sent[:sent.len() - 2], e.localEnabled(int(Option.Binary))) + [byte(13), byte(10)])
					case forwards(c):
						let sent = line + [b]
						line = []
						echo = echo + echoOf(c)
						try e.write(sent)
					default:
						line.push(b)
						echo = echo + echoOf(c)
				}
			}
			return echo
		}

		// echoOf is how a typed character echoes: control characters as ^X
		// unless LIT_ECHO asks for them as they are; a tab as spaces under
		// SOFT_TAB.
		internal def echoOf(c int) byte[] {
			return "        ".bytes() when c == 9 && (mode & modeSOFT_TAB) != 0
			if (c < 32 || c == 127) && (mode & modeLIT_ECHO) == 0 {
				let shown = c == 127 ?? (63, c + 64)
				return [byte(94), byte(shown)]
			}
			return [byte(c)]
		}
	}
}
