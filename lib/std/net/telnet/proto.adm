internal partial module std.net.telnet.proto {
	use (
		std.net.telnet::*
	)

	// Commands (RFC 854; EOF, SUSP, ABORT from RFC 1184; EOR from RFC 885).
	const cmdEOF = 236
	const cmdSUSP = 237
	const cmdABORT = 238
	const cmdEOR = 239
	const cmdSE = 240
	const cmdNOP = 241
	const cmdDM = 242
	const cmdBRK = 243
	const cmdIP = 244
	const cmdAO = 245
	const cmdAYT = 246
	const cmdEC = 247
	const cmdEL = 248
	const cmdGA = 249
	const cmdSB = 250
	const cmdWILL = 251
	const cmdWONT = 252
	const cmdDO = 253
	const cmdDONT = 254
	const IAC = 255

	// Subnegotiation verbs shared by several options.
	const subIS = 0
	const subSEND = 1
	const subINFO = 2

	// NEW-ENVIRON (RFC 1572) item types.
	const envVAR = 0
	const envVALUE = 1
	const envESC = 2
	const envUSERVAR = 3

	// MSSP item types.
	const msspVAR = 1
	const msspVAL = 2

	// CHARSET (RFC 2066) verbs.
	const charsetREQUEST = 1
	const charsetACCEPTED = 2
	const charsetREJECTED = 3
	const charsetTTABLE_IS = 4
	const charsetTTABLE_REJECTED = 5

	// TOGGLE-FLOW-CONTROL (RFC 1372) commands.
	const flowOFF = 0
	const flowON = 1
	const flowRESTART_ANY = 2
	const flowRESTART_XON = 3

	// Option states of RFC 1143's Q method.
	const qNO = 0
	const qYES = 1
	const qWANTNO = 2
	const qWANTYES = 3

	// OptionSide is one side of one option in RFC 1143's Q method: its state
	// and the queue bit that remembers a request made while a reply is
	// still awaited.
	type OptionSide {
		state    int  = 0
		opposite bool = false

		def new() {}

		def enabled() bool {
			return state == qYES
		}
	}

	// Negotiation is what the Q method decided on receiving or requesting:
	// the command to send (0 for none) and whether the option's state
	// changed to enabled or disabled.
	struct Negotiation {
		send    int  = 0
		changed bool = false
		enabled bool = false
	}

	// receiveEnable runs the Q method for an incoming WILL (for the peer's
	// side) or DO (for ours): `accept` says whether this side agrees.
	// `yes`/`no` are the commands to answer with (DO/DONT or WILL/WONT).
	def receiveEnable(side OptionSide, accept bool, yes int, no int) Negotiation {
		switch {
			case side.state == qNO:
				if accept {
					side.state = qYES
					return Negotiation{send: yes, changed: true, enabled: true}
				}
				return Negotiation{send: no}
			case side.state == qWANTNO:
				if side.opposite {
					side.state = qYES
					side.opposite = false
					return Negotiation{changed: true, enabled: true}
				}
				// A DONT/WONT answered with WILL/DO: the peer misbehaves.
				side.state = qNO
				return Negotiation{}
			case side.state == qWANTYES:
				if side.opposite {
					side.state = qWANTNO
					side.opposite = false
					return Negotiation{send: no}
				}
				side.state = qYES
				return Negotiation{changed: true, enabled: true}
		}
		return Negotiation{}
	}

	// receiveDisable runs the Q method for an incoming WONT (the peer's
	// side) or DONT (ours), answered with `no`; `yes` re-requests when a
	// queued request wants the option back.
	def receiveDisable(side OptionSide, yes int, no int) Negotiation {
		switch {
			case side.state == qYES:
				side.state = qNO
				return Negotiation{send: no, changed: true, enabled: false}
			case side.state == qWANTNO:
				if side.opposite {
					side.state = qWANTYES
					side.opposite = false
					return Negotiation{send: yes}
				}
				side.state = qNO
				return Negotiation{changed: true, enabled: false}
			case side.state == qWANTYES:
				side.state = qNO
				side.opposite = false
				return Negotiation{}
		}
		return Negotiation{}
	}

	// requestEnable asks for an option (DO for the peer's side, WILL for
	// ours): the command to send, 0 when a request is already under way.
	def requestEnable(side OptionSide, yes int) int {
		switch {
			case side.state == qNO:
				side.state = qWANTYES
				return yes
			case side.state == qWANTNO:
				side.opposite = true
			case side.state == qWANTYES:
				side.opposite = false
		}
		return 0
	}

	// requestDisable asks to turn an option off (DONT or WONT).
	def requestDisable(side OptionSide, no int) int {
		switch {
			case side.state == qYES:
				side.state = qWANTNO
				return no
			case side.state == qWANTNO:
				side.opposite = false
			case side.state == qWANTYES:
				side.opposite = true
		}
		return 0
	}

	// Parser states.
	const pData = 0
	const pIAC = 1
	const pVerb = 2
	const pSB = 3
	const pSBData = 4
	const pSBIAC = 5

	// Event is one thing the parser found in the byte stream.
	struct Event {
		// 0 data, 1 command, 2 negotiation, 3 subnegotiation.
		kind   int    = 0
		data   byte[]
		// The command, or the negotiation verb (WILL/WONT/DO/DONT).
		code   int    = 0
		option int    = 0
	}

	const evData = 0
	const evCommand = 1
	const evNegotiation = 2
	const evSub = 3

	// The longest subnegotiation accepted.
	const maxSub = 65536

	// Parser splits a Telnet byte stream into data, commands, negotiations
	// and subnegotiations (RFC 854), keeping its state between chunks.
	type Parser {
		state  int    = 0
		verb   int    = 0
		option int    = 0
		sub    byte[]

		def new() {}

		// feed parses a chunk and returns the events in it, data runs
		// joined. `stopAt` returns early right after a subnegotiation of
		// that option (the stream after it changes, as MCCP starts
		// compressing), with `consumed` telling how far it got.
		def feed(chunk byte[], stopAt int = -1) (Event[], int) {
			let out Event[] = []
			let data byte[] = []
			let i = 0
			for i < chunk.len() {
				let b = int(chunk[i])
				i++
				switch {
					case state == pData:
						if b == IAC {
							state = pIAC
						} else {
							data.push(byte(b))
						}
					case state == pIAC:
						if b == IAC {
							data.push(byte(255))
							state = pData
						} else if b := cmdWILL || cmdWONT || cmdDO || cmdDONT {
							verb = b
							state = pVerb
						} else if b == cmdSB {
							state = pSB
						} else {
							flushData(out, data)
							data = []
							out.push(Event{kind: evCommand, code: b})
							state = pData
						}
					case state == pVerb:
						flushData(out, data)
						data = []
						out.push(Event{kind: evNegotiation, code: verb, option: b})
						state = pData
					case state == pSB:
						option = b
						sub = []
						state = pSBData
					case state == pSBData:
						if b == IAC {
							state = pSBIAC
						} else if sub.len() < maxSub {
							sub.push(byte(b))
						}
					case state == pSBIAC:
						if b == IAC {
							sub.push(byte(255)) when sub.len() < maxSub
							state = pSBData
						} else if b == cmdSE {
							flushData(out, data)
							data = []
							out.push(Event{kind: evSub, option: option, data: sub})
							sub = []
							state = pData
							return (out, i) when option == stopAt
						} else {
							// IAC and a command inside a subnegotiation: RFC 855
							// ends it there; the command is taken as it is.
							flushData(out, data)
							data = []
							out.push(Event{kind: evSub, option: option, data: sub})
							sub = []
							out.push(Event{kind: evCommand, code: b})
							state = pData
						}
				}
			}
			flushData(out, data)
			return (out, i)
		}

		internal def flushData(out Event[], data byte[]) {
			out.push(Event{kind: evData, data: data}) when data.len() > 0
		}
	}

	// escapeIAC doubles every 255 byte, as data and subnegotiations carry it.
	def escapeIAC(data byte[]) byte[] {
		let out byte[] = []
		for let b in data {
			out.push(b)
			out.push(b) when b == byte(255)
		}
		return out
	}

	// NvtOut writes data in the network virtual terminal's form (RFC 854):
	// LF becomes CR LF, a CR not followed by LF becomes CR NUL, IAC doubles.
	// With `binary` the bytes pass as they are, IAC doubled.
	type NvtOut {
		lastCR bool = false

		def new() {}

		def encode(data byte[], binary bool) byte[] {
			return escapeIAC(data) when binary
			let out byte[] = []
			for let i = 0; i < data.len(); i++ {
				let b = data[i]
				if b == byte(10) {
					out.push(byte(13)) unless lastCR
					out.push(byte(10))
					lastCR = false
					continue
				}
				out.push(byte(0)) when lastCR
				lastCR = b == byte(13)
				out.push(b)
				out.push(b) when b == byte(255)
			}
			return out
		}

		// close ends a CR left open at the end of what was written.
		def close() byte[] {
			return [] unless lastCR
			lastCR = false
			return [byte(0)]
		}
	}

	// NvtIn reads data in the network virtual terminal's form: CR NUL
	// becomes CR, CR LF stays, NUL padding elsewhere is dropped. With
	// `binary` the bytes pass as they are.
	type NvtIn {
		lastCR bool = false

		def new() {}

		def decode(data byte[], binary bool) byte[] {
			return data when binary
			let out byte[] = []
			for let b in data {
				if b == byte(0) {
					lastCR = false
					continue
				}
				lastCR = b == byte(13)
				out.push(b)
			}
			return out
		}
	}

	// negotiationBytes is IAC verb option.
	def negotiationBytes(verb int, option int) byte[] {
		return [byte(IAC), byte(verb), byte(option)]
	}

	// subBytes is IAC SB option data IAC SE, data escaped.
	def subBytes(option int, data byte[]) byte[] {
		return [byte(IAC), byte(cmdSB), byte(option)] + escapeIAC(data) + [byte(IAC), byte(cmdSE)]
	}

	// nawsBody is a NAWS subnegotiation body: width and height, 16 bits
	// each, big-endian (RFC 1073).
	def nawsBody(size WindowSize) byte[] {
		let w = size.columns & 0xFFFF
		let h = size.rows & 0xFFFF
		return [byte(w >> 8), byte(w & 0xFF), byte(h >> 8), byte(h & 0xFF)]
	}

	// parseNaws reads a NAWS body; none when it is not four bytes.
	def parseNaws(body byte[]) ?WindowSize {
		return none unless body.len() == 4
		return WindowSize{columns: (int(body[0]) << 8) | int(body[1]), rows: (int(body[2]) << 8) | int(body[3])}
	}

	// textBody is a verb followed by text: TTYPE IS, TSPEED IS, ...
	def textBody(verb int, text string) byte[] {
		return [byte(verb)] + text.bytes()
	}

	// EnvVar is one NEW-ENVIRON item: a well-known VAR or a USERVAR, with
	// its value (none: no VALUE sent, the variable is undefined).
	struct EnvVar {
		name  string
		user  bool    = false
		value ?string = none
	}

	// envEscape escapes the bytes NEW-ENVIRON uses as markers.
	def envEscape(text string) byte[] {
		let out byte[] = []
		for let b in text.bytes() {
			out.push(byte(envESC)) when int(b) := envVAR || envVALUE || envESC || envUSERVAR
			out.push(b)
		}
		return out
	}

	// envBody is a NEW-ENVIRON IS/INFO/SEND body.
	def envBody(verb int, vars EnvVar[]) byte[] {
		let out byte[] = [byte(verb)]
		for let v in vars {
			out.push(byte(v.user ?? (envUSERVAR, envVAR)))
			out = out + envEscape(v.name)
			let value = v.value
			if !(value is none) {
				out.push(byte(envVALUE))
				out = out + envEscape(value)
			}
		}
		return out
	}

	// parseEnv reads the items of a NEW-ENVIRON body after its verb.
	def parseEnv(body byte[]) EnvVar[] {
		let out EnvVar[] = []
		let name byte[] = []
		let value byte[] = []
		let started = false
		let user = false
		let hasValue = false
		let inValue = false
		let i = 0
		for i < body.len() {
			let b = int(body[i])
			i++
			if b := envVAR || envUSERVAR {
				out.push(EnvVar{name: string(name), user: user, value: hasValue ?? (string(value), none)}) when started
				started = true
				user = b == envUSERVAR
				name = []
				value = []
				hasValue = false
				inValue = false
				continue
			}
			if b == envVALUE {
				hasValue = true
				inValue = true
				continue
			}
			if b == envESC && i < body.len() {
				b = int(body[i])
				i++
			}
			if inValue {
				value.push(byte(b))
			} else {
				name.push(byte(b))
			}
		}
		out.push(EnvVar{name: string(name), user: user, value: hasValue ?? (string(value), none)}) when started
		return out
	}

	// msspBody is an MSSP subnegotiation body: VAR name VAL value, one VAL
	// per value.
	def msspBody(status map<string, string[]>) byte[] {
		let out byte[] = []
		let names = status.keys()
		names.sort((a, b) => a.compare(b))
		for let name in names {
			out.push(byte(msspVAR))
			out = out + name.bytes()
			let values = status.get(name)
			continue when values is none
			for let v in values {
				out.push(byte(msspVAL))
				out = out + v.bytes()
			}
		}
		return out
	}

	// parseMssp reads an MSSP body.
	def parseMssp(body byte[]) map<string, string[]> {
		let out map<string, string[]>
		let name = ""
		let values string[] = []
		let text byte[] = []
		// 0 before the first VAR, 1 in a name, 2 in a value.
		let part = 0
		for let i = 0; i <= body.len(); i++ {
			let b = i == body.len() ?? (msspVAR, int(body[i]))
			if b := msspVAR || msspVAL {
				if part == 1 {
					name = string(text)
				} else if part == 2 {
					values.push(string(text))
				}
				if b == msspVAR {
					out[name] = values when part != 0 && name != ""
					values = []
					part = 1
				} else {
					part = 2
				}
				text = []
				continue
			}
			text.push(byte(b))
		}
		return out
	}

	// gmcpBody is a GMCP message: the package and message name, and the
	// JSON after a space when there is any.
	def gmcpBody(message string, json string) byte[] {
		return message.bytes() when json == ""
		return (message + " " + json).bytes()
	}

	// parseGmcp splits a GMCP message into its name and JSON.
	def parseGmcp(body byte[]) (string, string) {
		let text = string(body)
		let space = text.indexOf(" ")
		return (text, "") when space < 0
		return (text[:space], text[space + 1:].trim())
	}

	// commandSignal is the Signal a command stands for; none for others.
	def commandSignal(code int) ?Signal {
		switch {
			case code == cmdIP:
				return Signal.Interrupt
			case code == cmdAO:
				return Signal.AbortOutput
			case code == cmdAYT:
				return Signal.AreYouThere
			case code == cmdBRK:
				return Signal.Break
			case code == cmdSUSP:
				return Signal.Suspend
			case code == cmdABORT:
				return Signal.Abort
			case code == cmdEOF:
				return Signal.EndOfFile
		}
		return none
	}

	// signalCommand is the command a Signal is sent as.
	def signalCommand(signal Signal) int {
		switch {
			case signal == Signal.Interrupt:
				return cmdIP
			case signal == Signal.AbortOutput:
				return cmdAO
			case signal == Signal.AreYouThere:
				return cmdAYT
			case signal == Signal.Break:
				return cmdBRK
			case signal == Signal.Suspend:
				return cmdSUSP
			case signal == Signal.Abort:
				return cmdABORT
		}
		return cmdEOF
	}

	// telnetError is a TelnetError with a message.
	def telnetError(message string) TelnetError {
		return TelnetError{message: "telnet: {message}", code: "telnet"}
	}
}
