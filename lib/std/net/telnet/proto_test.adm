partial module std.net.telnet {
	use (
		std.net.telnet.proto::*
		std.testing
	)

	check "Telnet wire" {
		@test()
		def parserSplitsTheStream() {
			let p = new Parser()
			let chunk byte[] = "ab".bytes() + [byte(255), byte(255), byte(99), byte(255), byte(244), byte(255), byte(251), byte(24), byte(255), byte(250), byte(24), byte(0)] + "xt".bytes() + [byte(255), byte(255), byte(255), byte(240)] + "z".bytes()
			// Fed one byte at a time: state carries across chunks.
			let events Event[] = []
			for let b in chunk {
				let (got, _) = p.feed([b])
				events = events + got
			}
			let data byte[] = []
			let commands int[] = []
			let subs = 0
			for let e in events {
				switch {
					case e.kind == evData:
						data = data + e.data
					case e.kind == evCommand:
						commands.push(e.code)
					case e.kind == evNegotiation:
						assert e.code == cmdWILL && e.option == 24
					case e.kind == evSub:
						subs++
						assert e.option == 24
						assert e.data.hex() == ([byte(0)] + "xt".bytes() + [byte(255)]).hex()
				}
			}
			assert data.hex() == ("ab".bytes() + [byte(255), byte(99)] + "z".bytes()).hex()
			assert commands.len() == 1 && commands[0] == cmdIP
			assert subs == 1
		}

		@test()
		def parserStopsAfterACompressionStart() {
			let p = new Parser()
			let chunk byte[] = [byte(255), byte(250), byte(86), byte(255), byte(240), byte(1), byte(2)]
			let (events, used) = p.feed(chunk, 86)
			assert events.len() == 1 && events[0].option == 86
			assert used == 5
		}

		@test()
		def qMethodAvoidsLoops() {
			// A peer's WILL we accept: answered DO once, then ignored.
			let side = new OptionSide()
			let first = receiveEnable(side, true, cmdDO, cmdDONT)
			assert first.send == cmdDO && first.changed && first.enabled
			let again = receiveEnable(side, true, cmdDO, cmdDONT)
			assert again.send == 0 && !again.changed
			// Our DO answered with WONT: no reply, no loop.
			let asked = new OptionSide()
			assert requestEnable(asked, cmdDO) == cmdDO
			assert requestEnable(asked, cmdDO) == 0
			let refused = receiveDisable(asked, cmdDO, cmdDONT)
			assert refused.send == 0 && asked.state == qNO
			// A refused WILL is answered DONT and stays off.
			let no = receiveEnable(new OptionSide(), false, cmdDO, cmdDONT)
			assert no.send == cmdDONT && !no.changed
			// Switching off while a request is pending queues it.
			let pending = new OptionSide()
			requestEnable(pending, cmdDO)
			assert requestDisable(pending, cmdDONT) == 0 && pending.opposite
			let answered = receiveEnable(pending, true, cmdDO, cmdDONT)
			assert answered.send == cmdDONT && pending.state == qWANTNO
		}

		@test()
		def nvtLineEnds() {
			let out = new NvtOut()
			let text = out.encode("a\nb\rc".bytes(), false) + out.close()
			assert text.hex() == ("a\r\nb\r".bytes() + [byte(0)] + "c".bytes()).hex()
			let crAtEnd = new NvtOut()
			assert (crAtEnd.encode("x\r".bytes(), false) + crAtEnd.close()).hex() == ("x\r".bytes() + [byte(0)]).hex()
			assert new NvtOut().encode([byte(255), byte(10)], true).hex() == [byte(255), byte(255), byte(10)].hex()
			let back = new NvtIn()
			assert string(back.decode("a\r".bytes() + [byte(0)] + "b\r\n".bytes(), false)) == "a\rb\r\n"
		}

		@test()
		def subnegotiationBodies() !none {
			let size = parseNaws(nawsBody(WindowSize{columns: 300, rows: 255}))
			assert !(size is none) && size.columns == 300 && size.rows == 255
			// A 255 byte in a body is doubled on the wire.
			assert subBytes(31, [byte(0), byte(255)]).hex() == [byte(255), byte(250), byte(31), byte(0), byte(255), byte(255), byte(255), byte(240)].hex()

			let vars = [EnvVar{name:"USER", value:"ada"}, EnvVar{name:"ODD\u0001", user:true, value:"v"}, EnvVar{name:"UNSET"}]
			let body = envBody(subIS, vars)
			let back = parseEnv(body[1:])
			assert back.len() == 3
			let userValue = back[0].value
			fail "USER has no value" when userValue is none
			assert back[0].name == "USER" && userValue == "ada" && !back[0].user
			assert back[1].name == "ODD\u0001" && back[1].user
			assert back[2].name == "UNSET" && back[2].value is none

			let status map<string, string[]>
			status["NAME"] = ["Test MUD"]
			status["PORT"] = ["23", "992"]
			let parsed = parseMssp(msspBody(status))
			assert parsed["NAME"][0] == "Test MUD"
			assert parsed["PORT"].len() == 2 && parsed["PORT"][1] == "992"

			let (message, json) = parseGmcp(gmcpBody("Char.Vitals", "\{\"hp\":10\}"))
			assert message == "Char.Vitals" && json == "\{\"hp\":10\}"
			return none
		}
	}
}
