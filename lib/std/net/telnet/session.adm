partial module std.net.telnet {
	use (
		std.net
		std.net.telnet.proto::*
	)

	// Session is the server side of one Telnet connection, handed to a
	// `Handler`. Data read and written is plain text (or bytes once BINARY
	// is on); the Telnet commands and options are handled underneath. What
	// the client told about itself (terminal type, window size, speed,
	// environment, character set) is known once the handler runs.
	// Implements `net.Stream`, `io.Reader` and `io.Writer`.
	type Session {
		internal engine  Engine
		internal pending byte[]
		internal afterCR bool   = false
		// Whether the server echoes what the client types (character mode),
		// rather than the client echoing it locally.
		internal echoing bool   = false

		def new(engine Engine, echoing bool) {
			self.engine = engine
			self.echoing = echoing
		}

		// read copies what the client sent into buf, waiting up to `timeout`;
		// 0 once it closed. Fails when the connection does.
		def read(buf byte[], timeout duration) !int {
			if pending.len() > 0 {
				let n = pending.copy(buf)
				pending = pending[n:].clone()
				return n
			}
			return try engine.read(buf, timeout)
		}

		// read with the server's timeout. Implements std.io.Reader.
		// Fails when the connection does.
		def read(buf byte[]) !int {
			return try read(buf, engine.timeout)
		}

		// write sends data to the client: LF as CR LF unless BINARY is on.
		// Fails when the connection does.
		def write(buf byte[], timeout duration) !int {
			try engine.write(buf)
			return buf.len()
		}

		// write with the server's timeout. Implements std.io.Writer.
		// Fails when the connection does.
		def write(buf byte[]) !int {
			try engine.write(buf)
			return buf.len()
		}

		// writeLine sends text and a line end. Fails when the connection does.
		def writeLine(text string) !none {
			return try engine.write((text + "\n").bytes())
		}

		// readLine is the next line the client sends, without its line end
		// (CR LF, CR NUL, CR or LF). When the server echoes, the typed
		// characters are echoed and Backspace/Delete erase.
		// Fails when the connection closes first or a read times out.
		def readLine(timeout duration) !string {
			return try collectLine(timeout, echoing)
		}

		// readLine with the server's timeout. Fails as the other form does.
		def readLine() !string {
			return try collectLine(engine.timeout, echoing)
		}

		// readSecret writes a prompt and reads a line the client does not
		// echo: the server takes the ECHO option for the prompt (and so the
		// client stops echoing) and gives it back after, unless it echoes
		// anyway. Fails as readLine does.
		def readSecret(prompt string = "") !Secret<string> {
			try engine.write(prompt.bytes()) unless prompt == ""
			try engine.requestLocal(int(Option.Echo), true) unless echoing
			let failure ?error = none
			let line = collectLine(engine.timeout, false) onerror (err error) {
				failure = err
				recover ""
			}
			try engine.requestLocal(int(Option.Echo), false) unless echoing || engine.closed
			fail failure unless failure is none
			try engine.write("\n".bytes())
			return line
		}

		internal def collectLine(timeout duration, echo bool) !string {
			let line byte[] = []
			let buf byte[] = []
			buf.len(256)
			for {
				if pending.len() == 0 {
					let n = try engine.read(buf, timeout)
					fail net.errorOf(net.ErrorCode.Closed, "read", "", "telnet session closed") when n == 0
					pending = buf[:n].clone()
					// Erase commands that came after what the line already holds.
					let (chars, wholeLine) = engine.takeErase()
					line = [] when wholeLine
					for let k = 0; k < chars && line.len() > 0; k++ {
						line = line[:line.len() - 1].clone()
					}
				}
				let i = 0
				for i < pending.len() {
					let b = pending[i]
					i++
					if afterCR {
						afterCR = false
						continue when b == byte(10)
					}
					if b := byte(13) || byte(10) {
						afterCR = b == byte(13)
						pending = pending[i:].clone()
						try engine.write("\n".bytes()) when echo
						return string(line)
					}
					if echo && (b := byte(8) || byte(127)) {
						if line.len() > 0 {
							line = line[:line.len() - 1].clone()
							try engine.write("\b \b".bytes())
						}
						continue
					}
					line.push(b)
					try engine.write([b]) when echo
				}
				pending = []
			}
			fail "unreachable"
		}

		// echo switches who echoes: true has the server echo each character
		// it reads (character mode, ECHO and SUPPRESS-GO-AHEAD on), false has
		// the client echo. Fails when the connection does.
		def echo(enabled bool) !none {
			echoing = enabled
			try engine.requestLocal(int(Option.SuppressGoAhead), true) when enabled
			return try engine.requestLocal(int(Option.Echo), enabled)
		}

		// binary asks for 8-bit transparent data both ways (BINARY), or back
		// to text. Fails when the connection does.
		def binary(enabled bool) !none {
			try engine.requestLocal(int(Option.Binary), enabled)
			return try engine.requestRemote(int(Option.Binary), enabled)
		}

		// prompt writes a prompt and marks its end: End of Record when the
		// client agreed to it, else Go Ahead unless both suppress it, so a
		// client can tell a prompt without a line end from output still
		// coming. Fails when the connection does.
		def prompt(text string) !none {
			try engine.write(text.bytes())
			return try engine.sendCommand(cmdEOR) when engine.localEnabled(int(Option.EndOfRecord))
			return none when engine.localEnabled(int(Option.SuppressGoAhead))
			return try engine.sendCommand(cmdGA)
		}

		// flowControl tells the client whether to act on XON/XOFF itself
		// (TOGGLE-FLOW-CONTROL); it needs the client to have agreed to the
		// option. Fails with TelnetError otherwise, or as the connection does.
		def flowControl(enabled bool) !none {
			fail telnetError("the client did not agree to FLOW-CONTROL") unless engine.remoteEnabled(int(Option.FlowControl))
			return try engine.sendSub(int(Option.FlowControl), [byte(enabled ?? (flowON, flowOFF))])
		}

		// The first terminal type the client named, "" when it named none.
		def terminal() string {
			return engine.terminal
		}

		// Every terminal type the client named, most specific first.
		def terminals() string[] {
			return engine.terminals
		}

		// The client's window size; 0 by 0 when it did not tell.
		def windowSize() WindowSize {
			return engine.window
		}

		// The client's terminal speed, "transmit,receive" in bits per second;
		// "" when it did not tell.
		def speed() string {
			return engine.speed
		}

		// The client's X display, "host:display.screen"; "" when none.
		def displayLocation() string {
			return engine.display
		}

		// The environment variables the client sent (USER, TERM, ...).
		def environment() map<string, string> {
			return engine.environment
		}

		// The character set agreed on (CHARSET); "" when none was.
		def charset() string {
			return engine.charset
		}

		// Reports whether an option is on, on either side.
		def hasOption(option Option) bool {
			return engine.localEnabled(int(option)) || engine.remoteEnabled(int(option))
		}

		// Registers fn to hear the signals the client sends (Ctrl-C and
		// the rest); the first one registered also hears those sent before.
		def onSignal(fn def (Signal)) {
			engine.addSignalHook(fn)
		}

		// Registers fn to hear the client's window size when it changes.
		def onResize(fn def (WindowSize)) {
			engine.addResizeHook(fn)
		}

		// Registers fn to hear GMCP messages: the message name
		// (`Core.Hello`) and its JSON text ("" when none); the first one
		// registered also hears those sent before.
		def onGmcp(fn def (string, string)) {
			engine.addGmcpHook(fn)
		}

		// Sends a GMCP message. Fails with TelnetError when the client did
		// not agree to GMCP, or as the connection does.
		def sendGmcp(message string, json string = "") !none {
			fail telnetError("the client did not agree to GMCP") unless engine.localEnabled(int(Option.Gmcp))
			return try engine.sendSub(int(Option.Gmcp), gmcpBody(message, json))
		}

		// synchronize waits until the client has answered everything sent
		// before (TIMING-MARK). Fails when no answer comes in `timeout`.
		def synchronize(timeout duration = 5s) !none {
			return try engine.timingMark(timeout)
		}

		// The client's address.
		def remoteAddr() net.Address {
			return engine.socket.remoteAddr()
		}

		// Implements net.Stream: whether the connection is open.
		def isOpen() bool {
			return !engine.closed
		}

		// Implements net.Stream: closes the connection, ending MCCP
		// compression first. Fails when the connection refuses to close.
		def close() !none {
			return try engine.close()
		}
	}
}
