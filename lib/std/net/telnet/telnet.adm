partial module std.net.telnet {
	use (
		std.errors
	)

	// Security picks how a connection is protected.
	enum Security {
		// No TLS: everything, passwords included, crosses in the clear.
		Plain    = "plain",
		// Telnet over TLS from the first byte (telnets, port 992).
		Implicit = "implicit",
	}

	// Option names a Telnet option by its code (IANA "Telnet Options").
	enum Option {
		Binary          = 0,
		Echo            = 1,
		SuppressGoAhead = 3,
		Status          = 5,
		TimingMark      = 6,
		TerminalType    = 24,
		EndOfRecord     = 25,
		WindowSize      = 31,
		TerminalSpeed   = 32,
		FlowControl     = 33,
		Linemode        = 34,
		DisplayLocation = 35,
		Environment     = 39,
		Charset         = 42,
		// Mud Server Status Protocol: the server's name, players, ...
		Mssp            = 70,
		// Mud Client Compression Protocol v2: server output is zlib-compressed.
		Mccp2           = 86,
		// Mud Client Compression Protocol v3: client output is zlib-compressed.
		Mccp3           = 87,
		// Generic Mud Communication Protocol: JSON messages beside the text.
		Gmcp            = 201,
	}

	// Signal is a Telnet command that stands for a key the user pressed:
	// what a session's `onSignal` hears and a client's methods send.
	enum Signal {
		// Interrupt Process (Ctrl-C).
		Interrupt   = "interrupt",
		// Abort Output: stop sending what is under way.
		AbortOutput = "abortOutput",
		// Are You There: the peer answers with visible text.
		AreYouThere = "areYouThere",
		// The Break key.
		Break       = "break",
		// Suspend Process (Ctrl-Z, LINEMODE).
		Suspend     = "suspend",
		// Abort Process (Ctrl-\, LINEMODE).
		Abort       = "abort",
		// End of File (Ctrl-D, LINEMODE).
		EndOfFile   = "endOfFile",
	}

	// WindowSize is a terminal's size in characters (NAWS); 0 means unknown.
	struct WindowSize {
		columns int = 0
		rows    int = 0
	}

	// TelnetError is the payload of a failure the protocol itself caused:
	// a malformed command or subnegotiation, a refused option. `code` is
	// "telnet".
	struct TelnetError {
		message string
		code    string
		cause   ?error
		stack   errors.StackTrace
	}

	// Handler serves one Telnet session of a `Server`: the connection
	// closes when it returns.
	interface Handler {
		// Fails with whatever went wrong; the server closes the session
		// and reports the error to its `onError` hooks.
		def serve(session Session) !none
	}

	// HandlerFunc makes a closure a `Handler`.
	//
	// ```
	// let server = new telnet.Server(new telnet.HandlerFunc(def (s telnet.Session) !none {
	//     try s.writeLine("hello {s.terminal()}")
	//     return none
	// }))
	// ```
	type HandlerFunc {
		fn def (Session) !none

		def new(fn def (Session) !none) {
			self.fn = fn
		}

		// Implements Handler. Fails as the closure does.
		def serve(session Session) !none {
			return fn(session)
		}
	}
}
