partial module std.net.telnet {
	use (
		std.crypto.x509::(CertPool)
		std.net
		std.net.telnet.proto::*
		std.net.tls
		std.testing
		std.time
	)

	// A self-signed P-256 certificate for 127.0.0.1, localhost and
	// example.com, valid for a century (the one httptest presents).
	internal const telnetCertPEM =
		"-----BEGIN CERTIFICATE-----\n" +
		"MIIByzCCAXCgAwIBAgIULZ61fkBLJqpHXo7Dg3TjjURKNKQwCgYIKoZIzj0EAwIw\n" +
		"EzERMA8GA1UEAwwIQURNIHRlc3QwIBcNMjYwOTE2MjEyNDQ4WhgPMjEyNjA4MjMy\n" +
		"MTI0NDhaMBMxETAPBgNVBAMMCEFETSB0ZXN0MFkwEwYHKoZIzj0CAQYIKoZIzj0D\n" +
		"AQcDQgAEWmnKIPFi8/hNfbTouWeJ0sX7jXIK0H2BdAa3ZlChTQUtkRXRuGnkYmY9\n" +
		"c9D2sLIU0D8YtBwSi1XCEXkyARGL3KOBnzCBnDAdBgNVHQ4EFgQUdGEQb1u97o8W\n" +
		"5FkheQ27r3JNU3AwHwYDVR0jBBgwFoAUdGEQb1u97o8W5FkheQ27r3JNU3AwDwYD\n" +
		"VR0TAQH/BAUwAwEB/zAnBgNVHREEIDAegglsb2NhbGhvc3SCC2V4YW1wbGUuY29t\n" +
		"hwR/AAABMAsGA1UdDwQEAwIHgDATBgNVHSUEDDAKBggrBgEFBQcDATAKBggqhkjO\n" +
		"PQQDAgNJADBGAiEA6p+D8so1nzo4nOkB8z0x1Tq+9iG1qIweVo/zTnSHG9cCIQDo\n" +
		"ANw/RkMk5iyYvJf8Qx75u8fY/n2s26d6Clj96iuH/g==\n" +
		"-----END CERTIFICATE-----\n"

	internal const telnetKeyPEM =
		"-----BEGIN PRIVATE KEY-----\n" +
		"MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgz6zLOlG3plulCC6J\n" +
		"73w4HvDFzW9lrGWy0U1PuM2M1gWhRANCAARaacog8WLz+E19tOi5Z4nSxfuNcgrQ\n" +
		"fYF0BrdmUKFNBS2RFdG4aeRiZj1z0PawshTQPxi0HBKLVcIReTIBEYvc\n" +
		"-----END PRIVATE KEY-----\n"

	// Seen collects what a test's handler observed.
	internal type Seen {
		signals Signal[]
		sizes   WindowSize[]
		gmcp    string[]

		def new() {}

		atomic def signal(s Signal) {
			signals.push(s)
		}

		atomic def resized(size WindowSize) {
			sizes.push(size)
		}

		atomic def message(text string) {
			gmcp.push(text)
		}
	}

	// startTelnet serves `fn` on an ephemeral loopback port.
	internal def startTelnet(fn def (Session) !none) !Server {
		return try startTelnet(fn, def (s Server) {})
	}

	// startTelnet with the server's settings changed before it starts.
	internal def startTelnet(fn def (Session) !none, configure def (Server)) !Server {
		let server = new Server(new HandlerFunc(fn), "127.0.0.1:0")
		server.linemode = false
		server.negotiationTimeout = 2s
		server.timeout = 10s
		configure(server)
		try server.start()
		return server
	}

	// dial connects a client to a test server.
	internal def dial(server Server, security Security = Security.Plain) !Client {
		let client = new Client(security, 10s)
		client.environment["USER"] = "ada"
		client.environment["LANG"] = "en_GB.UTF-8"
		client.window = WindowSize{columns: 100, rows: 40}
		if security == Security.Implicit {
			let pool = new CertPool()
			pool.appendCertsFromPEM(telnetCertPEM)
			client.tls = tls.Config{serverName: "localhost", rootCAs: pool}
		}
		try client.connect(server.address().str())
		return client
	}

	check "Telnet" {
		@test()
		def sessionKnowsTheClient() !none {
			let server = try startTelnet(def (s Session) !none {
				let env = s.environment()
				let user = env.get("USER")
				let lang = env.get("LANG")
				let size = s.windowSize()
				try s.writeLine("term={s.terminal()} all={s.terminals().join(",")} size={size.columns}x{size.rows} speed={s.speed()} user={user is none ?? ("", user)} lang={lang is none ?? ("", lang)} charset={s.charset()}")
				try s.write("Name: ".bytes())
				let name = try s.readLine()
				let password = try s.readSecret("Password: ")
				try s.writeLine("hi {name} {password.reveal().len()}")
				try s.readLine()
				return none
			})
			let client = try dial(server)
			let info = try client.readLine()
			assert info == "term=xterm-256color all=xterm-256color,xterm,vt100 size=100x40 speed=38400,38400 user=ada lang=en_GB.UTF-8 charset=UTF-8"
			try client.readUntil("Name: ")
			assert !client.serverEchoes()
			try client.writeLine("ada")
			try client.readUntil("Password: ")
			try client.synchronize()
			assert client.serverEchoes()
			try client.writeLine("hunter2")
			assert (try client.readLine()) == ""
			assert (try client.readLine()) == "hi ada 7"
			try client.synchronize()
			assert !client.serverEchoes()
			try client.writeLine("bye")
			try client.close()
			try server.close()
			return none
		}

		@test()
		def serverEchoMode() !none {
			let server = try startTelnet(def (s Session) !none {
				let line = try s.readLine()
				try s.writeLine("got {line}")
				return none
			}, def (s Server) {
				s.serverEcho = true
			})
			let client = try dial(server)
			try client.synchronize()
			assert client.serverEchoes() && client.hasOption(Option.SuppressGoAhead)
			try client.write("abx".bytes() + [byte(127)] + "c\r".bytes())
			assert (try client.readLine()) == "abx\b \bc"
			assert (try client.readLine()) == "got abc"
			try client.close()
			try server.close()
			return none
		}

		@test()
		def signalsAndEditingCommands() !none {
			let seen = new Seen()
			let server = try startTelnet(def (s Session) !none {
				s.onSignal(def (sig Signal) {
					seen.signal(sig)
				})
				let line = try s.readLine()
				try s.writeLine("line {line}")
				let second = try s.readLine()
				try s.writeLine("second {second}")
				try s.readLine()
				return none
			})
			let client = try dial(server)
			try client.synchronize()
			try client.write("hellx".bytes())
			try client.eraseChar()
			try client.write("o\r".bytes())
			assert (try client.readLine()) == "line hello"
			try client.write("drop this".bytes())
			try client.eraseLine()
			try client.write("kept\r".bytes())
			assert (try client.readLine()) == "second kept"
			try client.interrupt()
			try client.sendBreak()
			try client.areYouThere()
			assert (try client.readUntil("[Yes]")).endsWith("[Yes]")
			assert seen.signals.len() == 3
			assert seen.signals[0] == Signal.Interrupt && seen.signals[1] == Signal.Break && seen.signals[2] == Signal.AreYouThere
			try client.writeLine("bye")
			try client.close()
			try server.close()
			return none
		}

		@test()
		def linemodeEditsOnTheClient() !none {
			let seen = new Seen()
			let server = try startTelnet(def (s Session) !none {
				s.onSignal(def (sig Signal) {
					seen.signal(sig)
				})
				let line = try s.readLine()
				try s.writeLine("line {line}")
				try s.readLine()
				return none
			}, def (s Server) {
				s.linemode = true
			})
			let client = try dial(server)
			try client.synchronize()
			try client.synchronize()
			assert client.editsLines()
			try client.write("hellx".bytes() + [byte(127)] + "o\r".bytes())
			// The editor echoes locally, the server does not.
			assert (try client.readLine()) == "hellx\b \bo"
			assert (try client.readLine()) == "line hello"
			// Ctrl-C is trapped into Interrupt Process.
			try client.write([byte(3)])
			try client.synchronize()
			assert seen.signals.len() == 1 && seen.signals[0] == Signal.Interrupt
			try client.writeLine("end")
			try client.close()
			try server.close()
			return none
		}

		@test()
		def resizeReachesTheSession() !none {
			let seen = new Seen()
			let server = try startTelnet(def (s Session) !none {
				s.onResize(def (size WindowSize) {
					seen.resized(size)
				})
				try s.writeLine("ready")
				try s.readLine()
				try s.writeLine("size {s.windowSize().columns}x{s.windowSize().rows}")
				return none
			})
			let client = try dial(server)
			assert (try client.readLine()) == "ready"
			try client.resize(132, 50)
			try client.writeLine("go")
			assert (try client.readLine()) == "size 132x50"
			assert seen.sizes.len() >= 1 && seen.sizes[seen.sizes.len() - 1].columns == 132
			try client.close()
			try server.close()
			return none
		}

		@test()
		def mudExtensions() !none {
			let seen = new Seen()
			let server = try startTelnet(def (s Session) !none {
				s.onGmcp(def (message string, json string) {
					seen.message("{message} {json}")
				})
				try s.sendGmcp("Core.Hello", "\{\"server\":\"test\"\}")
				try s.readLine()
				try s.writeLine("done")
				return none
			}, def (s Server) {
				s.gmcp = true
				s.status["NAME"] = ["Test MUD"]
				s.status["PLAYERS"] = ["3"]
			})
			let client = try dial(server)
			let heard = new Seen()
			try client.onGmcp(def (message string, json string) {
				heard.message("{message} {json}")
			})
			try client.synchronize()
			try client.synchronize()
			let name = client.serverStatus().get("NAME")
			fail "no NAME in the server status" when name is none
			assert name.len() == 1 && name[0] == "Test MUD"
			assert client.hasOption(Option.Gmcp)
			try client.sendGmcp("Core.Supports.Set", "[\"Char 1\"]")
			try client.writeLine("go")
			assert (try client.readLine()) == "done"
			assert heard.gmcp.len() == 1 && heard.gmcp[0] == "Core.Hello \{\"server\":\"test\"\}"
			assert seen.gmcp.len() == 1 && seen.gmcp[0] == "Core.Supports.Set [\"Char 1\"]"
			try client.close()
			try server.close()
			return none
		}

		@test()
		def compressionBothWays() !none {
			let server = try startTelnet(def (s Session) !none {
				for let i = 0; i < 3; i++ {
					let line = try s.readLine()
					try s.writeLine("echo {line} {"x".repeat(2000)}")
				}
				return none
			}, def (s Server) {
				s.compression = true
				s.compressedInput = true
			})
			let client = try dial(server)
			try client.synchronize()
			try client.synchronize()
			assert client.hasOption(Option.Mccp2) && client.hasOption(Option.Mccp3)
			for let i = 0; i < 3; i++ {
				try client.writeLine("line {i}")
				assert (try client.readLine()) == "echo line {i} {"x".repeat(2000)}"
			}
			try client.close()
			try server.close()
			return none
		}

		@test()
		def binaryTransmission() !none {
			let server = try startTelnet(def (s Session) !none {
				try s.binary(true)
				try s.synchronize()
				try s.write([byte(255), byte(10), byte(13), byte(0), byte(1)])
				let buf byte[] = []
				buf.len(8)
				let n = try s.read(buf)
				try s.write(buf[:n])
				return none
			})
			let client = try dial(server)
			let got byte[] = []
			let buf byte[] = []
			buf.len(16)
			for got.len() < 5 {
				let n = try client.read(buf)
				break when n == 0
				got = got + buf[:n]
			}
			assert got.hex() == [byte(255), byte(10), byte(13), byte(0), byte(1)].hex()
			assert client.hasOption(Option.Binary)
			try client.write([byte(255), byte(13), byte(0)])
			let back byte[] = []
			for back.len() < 3 {
				let n = try client.read(buf)
				break when n == 0
				back = back + buf[:n]
			}
			assert back.hex() == [byte(255), byte(13), byte(0)].hex()
			try client.close()
			try server.close()
			return none
		}

		@test()
		def overTLS() !none {
			let pair = try tls.parseKeyPair(telnetCertPEM, telnetKeyPEM)
			let server = try startTelnet(def (s Session) !none {
				let line = try s.readLine()
				try s.writeLine("secure {line} {s.terminal()}")
				return none
			}, def (s Server) {
				s.security = Security.Implicit
				s.tls = tls.Config{certificates: [pair]}
			})
			let client = try dial(server, Security.Implicit)
			try client.writeLine("hello")
			assert (try client.readLine()) == "secure hello xterm-256color"
			try client.close()
			try server.close()
			return none
		}

		@test()
		def synchDropsDataBeforeTheMark() !none {
			let server = try startTelnet(def (s Session) !none {
				try s.writeLine("ready")
				time.sleep(200ms)
				let line = try s.readLine()
				try s.writeLine("got {line}")
				try s.readLine()
				return none
			})
			let client = try dial(server)
			assert (try client.readLine()) == "ready"
			// Typed before the interrupt, never read: the Synch drops it.
			try client.write("junk".bytes())
			try client.interrupt()
			try client.writeLine("real")
			assert (try client.readLine()) == "got real"
			try client.writeLine("bye")
			try client.close()
			try server.close()
			return none
		}

		@test()
		def optionsAnsweredOnRequest() !none {
			let server = try startTelnet(def (s Session) !none {
				try s.flowControl(false)
				try s.prompt("> ")
				let line = try s.readLine()
				try s.writeLine("display={s.displayLocation()} line={line}")
				try s.readLine()
				return none
			}, def (s Server) {
				s.endOfRecord = true
			})
			let client = new Client(Security.Plain, 10s)
			client.display = "workstation:0.0"
			try client.connect(server.address().str())
			try client.readUntil("> ")
			try client.synchronize()
			assert !client.flowControl()
			assert client.hasOption(Option.EndOfRecord)
			try client.writeLine("x")
			assert (try client.readUntil(/display=[a-z]+:0\.0 line=x/)).endsWith("display=workstation:0.0 line=x")
			try client.readLine()
			try client.writeLine("bye")
			try client.close()
			try server.close()
			return none
		}

		@test()
		def linemodeTrapsMoreKeys() !none {
			let seen = new Seen()
			let server = try startTelnet(def (s Session) !none {
				s.onSignal(def (sig Signal) {
					seen.signal(sig)
				})
				try s.writeLine("ready")
				let line = try s.readLine()
				try s.writeLine("line [{line}]")
				try s.readLine()
				return none
			}, def (s Server) {
				s.linemode = true
			})
			let client = try dial(server)
			try client.readUntil("ready\r\n")
			try client.synchronize()
			assert client.editsLines()
			// Ctrl-Z traps into Suspend; Ctrl-V makes the next key literal;
			// Ctrl-W erases a word.
			try client.write([byte(26)])
			try client.write("one two".bytes() + [byte(23)] + "x".bytes() + [byte(22), byte(3)] + "\r".bytes())
			let echoed = try client.readUntil("line [")
			assert echoed.contains("one ")
			let tail = try client.readLine()
			assert tail.bytes().hex() == ("one x".bytes() + [byte(3)] + "]".bytes()).hex()
			assert seen.signals.len() == 1 && seen.signals[0] == Signal.Suspend
			try client.writeLine("bye")
			try client.close()
			try server.close()
			return none
		}

		@test()
		def statusOnRequest() !none {
			let server = try startTelnet(def (s Session) !none {
				try s.readLine()
				return none
			}, def (s Server) {
				s.negotiationTimeout = 200ms
			})
			let raw = try net.dialStream(server.address().str(), 5s)
			// Refuse everything the server asks, then ask for its status.
			try raw.writeAll([byte(255), byte(253), byte(5), byte(255), byte(250), byte(5), byte(1), byte(255), byte(240)])
			let parser = new Parser()
			let buf byte[] = []
			buf.len(512)
			let status ?byte[] = none
			let limit = time.now() + 5s
			for status is none && !time.now().after(limit) {
				let n = try raw.read(buf, 5s)
				break when n == 0
				let (events, _) = parser.feed(buf[:n])
				for let e in events {
					if e.kind == evNegotiation && e.code == cmdDO {
						try raw.writeAll([byte(255), byte(252), byte(e.option)])
					}
					status = e.data when e.kind == evSub && e.option == 5
				}
			}
			fail "no STATUS reply" when status is none
			// IS, then WILL/DO pairs for what is on: only STATUS, since this
			// raw client left the server's other offers unanswered.
			assert status.hex() == [byte(subIS), byte(251), byte(5)].hex()
			try raw.writeAll("bye\r\n".bytes())
			try raw.close()
			try server.close()
			return none
		}
	}
}
