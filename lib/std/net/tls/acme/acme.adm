// ACME (RFC 8555): accounts with external account binding, orders for DNS
// names and IP addresses (RFC 8738), the http-01, dns-01 and tls-alpn-01
// (RFC 8737) challenges, certificate issue, download, renewal information
// (ARI, RFC 9773) and revocation; and a certificate Manager the HTTP server
// uses, obtaining and renewing on demand and storing in a folder or the
// Vault.
//
//     let manager = new acme.Manager(["example.com", "www.example.com"], "ops@example.com")
//     let server = new http.Server(":443", app)
//     server.tls = try manager.tlsConfig()
//     try manager.start()
//     try server.listenAndServe()
partial module std.net.tls.acme {
	use (
		std.time
		std.errors
		std.crypto
		std.crypto::(PrivateKey, ECDSAPrivateKey, RSAPrivateKey, Ed25519PrivateKey)
		std.crypto.hash::(Hash)
		std.crypto.x509
		std.data.encoding::(Base64, JSON, pemDecodeAll)
		std.net
		std.net.http
		std.net.http::(Method)
		std.proto.auth.jose
	)

	// Let's Encrypt's production directory.
	const letsEncrypt = "https://acme-v02.api.letsencrypt.org/directory"
	// Let's Encrypt's staging directory: untrusted certificates, generous
	// rate limits, for trying a setup.
	const letsEncryptStaging = "https://acme-staging-v02.api.letsencrypt.org/directory"
	// ZeroSSL's directory; it needs an external account binding.
	const zeroSSL = "https://acme.zerossl.com/v2/DV90"
	// Buypass Go SSL's production directory.
	const buypass = "https://api.buypass.com/acme/directory"
	// Buypass Go SSL's test directory.
	const buypassStaging = "https://api.test4.buypass.no/acme/directory"
	// Google Trust Services' production directory; it needs an external
	// account binding.
	const googleTrustServices = "https://dv.acme-v02.api.pki.goog/directory"
	// Google Trust Services' test directory.
	const googleTrustServicesStaging = "https://dv.acme-v02.test-api.pki.goog/directory"

	// A CA's directory: the URL of each operation and what it says about
	// itself.
	struct Directory {
		newNonce                string
		newAccount              string
		newOrder                string
		// Pre-authorization; "" when the CA does not offer it.
		newAuthz                string
		revokeCert              string
		keyChange               string
		// Renewal information (RFC 9773); "" when the CA does not offer it.
		renewalInfo             string
		termsOfService          string
		website                 string
		caaIdentities           string[]
		// The CA needs an external account binding to register.
		externalAccountRequired bool
	}

	// What an ACME object's state is.
	enum Status {
		Pending = "pending",
		Ready = "ready",
		Processing = "processing",
		Valid = "valid",
		Invalid = "invalid",
		Expired = "expired",
		Deactivated = "deactivated",
		Revoked = "revoked",
	}

	// An ACME account.
	struct Account {
		url     string
		status  Status   = Status.Valid
		contact string[]
		// Where the account's orders are listed; "" when the CA gives none.
		orders  string
	}

	// What a certificate is for: a DNS name (a wildcard is `*.` and the
	// base) or an IP address.
	struct Identifier {
		// "dns" or "ip".
		kind  string
		value string
	}

	// An order for a certificate.
	struct Order {
		url            string
		status         Status       = Status.Pending
		expires        ?time.Time
		identifiers    Identifier[]
		notBefore      ?time.Time
		notAfter       ?time.Time
		// The authorizations to complete, by URL.
		authorizations string[]
		finalize       string
		// Where the certificate is once the order is valid.
		certificate    string
		// Why the order failed, when it did.
		problem        ?Problem
		// The certificate this one replaces (RFC 9773), as its ARI id.
		replaces       string
	}

	// The kinds of challenge this module answers, by their ACME names.
	enum ChallengeType {
		// A file served over HTTP on port 80.
		Http01 = "http-01",
		// A TXT record in DNS.
		Dns01 = "dns-01",
		// A certificate presented over TLS with ALPN "acme-tls/1" on port 443.
		TlsAlpn01 = "tls-alpn-01",
	}

	// One way to prove control of an identifier.
	struct Challenge {
		// The ACME name ("http-01", "dns-01", "tls-alpn-01", or one this
		// module does not answer).
		kind      string
		url       string
		token     string
		status    Status     = Status.Pending
		validated ?time.Time
		problem   ?Problem
	}

	// The proof of control of one identifier an order needs.
	struct Authorization {
		url        string
		identifier Identifier
		status     Status      = Status.Pending
		expires    ?time.Time
		challenges Challenge[]
		wildcard   bool
	}

	// An RFC 7807 problem document as ACME sends it.
	struct Problem {
		// "urn:ietf:params:acme:error:badNonce" and the like.
		kind        string
		detail      string
		status      int
		subproblems Problem[]
		identifier  ?Identifier
	}

	// The error an ACME request fails with: the CA's problem when it sent
	// one.
	struct AcmeError {
		message string
		code    string
		cause   ?error
		stack   errors.StackTrace
		problem ?Problem
		status  int
	}

	// When the CA suggests renewing a certificate (RFC 9773).
	struct RenewalInfo {
		start       time.Time
		end         time.Time
		// A page explaining an early window, "" when none.
		explanation string
		// When to ask again.
		retryAfter  duration
	}

	// An external account binding: the key id and MAC key a CA gives out of
	// band (ZeroSSL, Google Trust Services, and others require one).
	struct ExternalAccountBinding {
		keyId   string
		// The MAC key, decoded from the base64url the CA shows.
		hmacKey byte[]
	}

	// Speaks ACME to one CA with one account key.
	type Client {
		directoryURL string
		// The account key: ECDSA P-256 (ES256) unless set otherwise; P-384,
		// RSA (2048 bits or more) and Ed25519 sign too where the CA takes
		// them.
		key          PrivateKey
		http         http.Client
		// The account URL, set by register or account().
		accountURL   string      = ""

		internal dir           ?Directory = none
		internal atomic nonces string[]

		def new(directoryURL string, key PrivateKey) {
			self.directoryURL = directoryURL
			self.key = key
			http = new http.Client(timeout = 60s)
		}

		// The CA's directory, fetched once. Fails when it cannot be fetched
		// or read.
		def directory() !Directory {
			let cached = dir
			return cached unless cached is none
			let res = try http.get(directoryURL)
			let doc = try readObject(res)
			let d = Directory{newNonce: text(doc, "newNonce"), newAccount: text(doc, "newAccount"), newOrder: text(doc, "newOrder"), newAuthz: text(doc, "newAuthz"), revokeCert: text(doc, "revokeCert"), keyChange: text(doc, "keyChange"), renewalInfo: text(doc, "renewalInfo")}
			let about = doc.get("meta")
			if about is map<string, any> {
				d.termsOfService = text(about, "termsOfService")
				d.website = text(about, "website")
				d.caaIdentities = texts(about, "caaIdentities")
				let required = about.get("externalAccountRequired")
				d.externalAccountRequired = required is bool && required
			}
			fail acmeError("the directory has no newNonce, newAccount or newOrder", 0, none) when d.newNonce == "" || d.newAccount == "" || d.newOrder == ""
			dir = d
			return d
		}

		// register creates the account, or finds the one the key already
		// has: contacts are `mailto:` URIs (a bare address gets the prefix),
		// termsAgreed agrees to the CA's terms of service, eab binds an
		// external account. Fails with the CA's problem, or when the CA wants
		// an external account binding and none is given.
		def register(contact string[] = [], termsAgreed bool = false, eab ?ExternalAccountBinding = none) !Account {
			let d = try directory()
			fail acmeError("this CA needs an external account binding", 0, none) when d.externalAccountRequired && eab is none
			let payload = map<string, any>{}
			payload["contact"] = contactURIs(contact) when contact.len() > 0
			payload["termsOfServiceAgreed"] = true when termsAgreed
			payload["externalAccountBinding"] = try JSON.parse(try bindingJWS(eab, d.newAccount, key)) unless eab is none
			let res = try post(d.newAccount, JSON.encode(payload), true)
			accountURL = res.headers.get("Location")
			return accountOf(try readObject(res), accountURL)
		}

		// The account of the key. Fails with the CA's accountDoesNotExist
		// problem when the key has none.
		def account() !Account {
			let d = try directory()
			let res = try post(d.newAccount, "\{\"onlyReturnExisting\":true\}".bytes(), true)
			accountURL = res.headers.get("Location")
			return accountOf(try readObject(res), accountURL)
		}

		// Replaces the account's contacts. Fails as register does.
		def updateContact(contact string[]) !Account {
			try ensureAccount()
			let res = try post(accountURL, JSON.encode(map<string, any>{"contact": contactURIs(contact)}), false)
			return accountOf(try readObject(res), accountURL)
		}

		// Deactivates the account for good: the CA refuses its requests
		// after. Fails with the CA's problem.
		def deactivate() !none {
			try ensureAccount()
			let res = try post(accountURL, "\{\"status\":\"deactivated\"\}".bytes(), false)
			res.close() onerror recover none
			return none
		}

		// Moves the account to a new key (RFC 8555 §7.3.5); the client signs
		// with it from then on. Fails with the CA's problem.
		def changeKey(newKey PrivateKey) !none {
			try ensureAccount()
			let d = try directory()
			fail acmeError("this CA does not offer key changes", 0, none) when d.keyChange == ""
			let inner = new jose.Jws(JSON.encode(map<string, any>{"account": accountURL, "oldKey": try JSON.parse(new jose.Jwk(key).publicKey().json())}))
			let header = new jose.Header()
			header.jwk = new jose.Jwk(newKey).publicKey()
			try header.set("url", d.keyChange)
			try inner.sign(new jose.Jwk(newKey), try algorithmOf(newKey), header)
			let res = try post(d.keyChange, (try inner.json(true)).bytes(), false)
			res.close() onerror recover none
			key = newKey
			return none
		}

		// Asks for a certificate for the identifiers (DNS names, or IP
		// addresses written as such), optionally for a validity window, and
		// replacing a certificate (its ARI id, see renewalId). Fails with
		// the CA's problem.
		def newOrder(names string[], notBefore ?time.Time = none, notAfter ?time.Time = none, replaces string = "") !Order {
			try ensureAccount()
			let d = try directory()
			let ids any[] = []
			for let name in names {
				let id = identifierOf(name)
				ids.push(map<string, any>{"type": id.kind, "value": id.value})
			}
			let payload = map<string, any>{"identifiers": ids}
			payload["notBefore"] = notBefore.str(time.TimeFormat.RFC3339) unless notBefore is none
			payload["notAfter"] = notAfter.str(time.TimeFormat.RFC3339) unless notAfter is none
			payload["replaces"] = replaces unless replaces == ""
			let res = try post(d.newOrder, JSON.encode(payload), false)
			let location = res.headers.get("Location")
			return try orderOf(try readObject(res), location)
		}

		// The order as it stands now. Fails with the CA's problem.
		def order(url string) !Order {
			let res = try postAsGet(url)
			return try orderOf(try readObject(res), url)
		}

		// An authorization and its challenges. Fails with the CA's problem.
		def authorization(url string) !Authorization {
			let res = try postAsGet(url)
			return try authorizationOf(try readObject(res), url)
		}

		// Gives up an authorization, so a later order proves control again.
		// Fails with the CA's problem.
		def deactivateAuthorization(url string) !none {
			let res = try post(url, "\{\"status\":\"deactivated\"\}".bytes(), false)
			res.close() onerror recover none
			return none
		}

		// What the challenge's response must carry: its token and the account
		// key's thumbprint (RFC 8555 §8.1).
		def keyAuthorization(token string) string {
			return token + "." + b64url(new jose.Jwk(key).thumbprint(Hash.SHA256))
		}

		// Tells the CA the challenge is ready to be checked. Fails with the
		// CA's problem.
		def accept(challenge Challenge) !Challenge {
			let res = try post(challenge.url, "\{\}".bytes(), false)
			return try challengeOf(try readObject(res))
		}

		// Polls the authorization until it is valid or failed, as often as the
		// CA's Retry-After asks (at least a second), for at most timeout.
		// Fails when it ends invalid (with the challenge's problem) or the
		// time runs out.
		def waitAuthorization(url string, timeout duration = 120s) !Authorization {
			let deadline = time.now() + timeout
			for {
				let res = try postAsGet(url)
				let pause = res.retryAfter()
				let a = try authorizationOf(try readObject(res), url)
				return a when a.status == Status.Valid
				if a.status != Status.Pending {
					let reason = a.challenges.find(c => !(c.problem is none), 0)
					let problem ?Problem = none
					problem = reason.problem unless reason is none
					fail acmeError("the authorization of {a.identifier.value} is {a.status.value}", 0, problem)
				}
				fail acmeError("the authorization of {a.identifier.value} is still pending after {timeout}", 0, none) when time.now() > deadline
				time.sleep(pollPause(pause))
			}
			fail acmeError("unreachable", 0, none)
		}

		// Polls the order until it leaves pending and processing, for at most
		// timeout. Fails when it ends invalid or the time runs out.
		def waitOrder(order Order, timeout duration = 120s) !Order {
			let deadline = time.now() + timeout
			for {
				let res = try postAsGet(order.url)
				let pause = res.retryAfter()
				let o = try orderOf(try readObject(res), order.url)
				fail acmeError("the order is invalid", 0, o.problem) when o.status == Status.Invalid
				return o unless o.status == Status.Pending || o.status == Status.Processing
				fail acmeError("the order is still {o.status.value} after {timeout}", 0, none) when time.now() > deadline
				time.sleep(pollPause(pause))
			}
			fail acmeError("unreachable", 0, none)
		}

		// Sends the certificate signing request (DER, see x509.createRequest)
		// of a ready order. Fails with the CA's problem.
		def finalize(order Order, csr byte[]) !Order {
			let res = try post(order.finalize, JSON.encode(map<string, any>{"csr": b64url(csr)}), false)
			return try orderOf(try readObject(res), order.url)
		}

		// The certificate chain of a valid order, leaf first (DER), and the
		// URLs of the alternate chains the CA offers. Fails when the download
		// does.
		def certificate(order Order) !(byte[][], string[]) {
			fail acmeError("the order has no certificate yet", 0, none) when order.certificate == ""
			return try chainAt(order.certificate)
		}

		// The certificate chain at a certificate or alternate-chain URL. Fails
		// when the download does or it holds no certificate.
		def chainAt(url string) !(byte[][], string[]) {
			let res = try post(url, byte[], false, "application/pem-certificate-chain")
			let alternates = linksOf(res, "alternate")
			let pem = try res.text()
			let chain byte[][] = []
			for let block in try pemDecodeAll(pem) {
				chain.push(block.bytes) when block.kind == "CERTIFICATE"
			}
			fail acmeError("the CA sent no certificate", res.status, none) when chain.len() == 0
			return (chain, alternates)
		}

		// Revokes a certificate (DER) with the account, or with the
		// certificate's own key when certificateKey is given (for a
		// certificate whose account is lost). The reason is an RFC 5280
		// CRLReason code (0 unspecified, 1 keyCompromise, 4 superseded, 5
		// cessationOfOperation). Fails with the CA's problem.
		def revoke(certificate byte[], reason int = 0, certificateKey ?PrivateKey = none) !none {
			let d = try directory()
			let payload = map<string, any>{"certificate": b64url(certificate)}
			payload["reason"] = reason unless reason == 0
			let res = certificateKey is none ?? (try post(d.revokeCert, JSON.encode(payload), false), try postWith(d.revokeCert, JSON.encode(payload), certificateKey, true, ""))
			res.close() onerror recover none
			return none
		}

		// The CA's suggested renewal window for a certificate (DER). Fails
		// when the CA does not offer renewal information or the request does.
		def renewalInfo(certificate byte[]) !RenewalInfo {
			let d = try directory()
			fail acmeError("this CA does not offer renewal information", 0, none) when d.renewalInfo == ""
			let id = try renewalId(certificate)
			let base = d.renewalInfo.endsWith("/") ?? (d.renewalInfo, d.renewalInfo + "/")
			let res = try http.get(base + id)
			let pause = res.retryAfter()
			let doc = try readObject(res)
			let window = doc.get("suggestedWindow")
			fail acmeError("the renewal information has no suggested window", res.status, none) unless window is map<string, any>
			let start = try time.parse(text(window, "start"), time.TimeFormat.RFC3339)
			let end = try time.parse(text(window, "end"), time.TimeFormat.RFC3339)
			return RenewalInfo{start: start, end: end, explanation: text(doc, "explanationURL"), retryAfter: pause is none ?? (6h, pause)}
		}

		internal def ensureAccount() !none {
			return none unless accountURL == ""
			try account()
			return none
		}

		internal def postAsGet(url string) !http.Response {
			return try post(url, byte[], false)
		}

		internal def post(url string, payload byte[], withJwk bool, accept string = "") !http.Response {
			return try postWith(url, payload, key, withJwk, accept)
		}

		// A signed request, sent again with a fresh nonce when the CA says
		// the nonce was bad (RFC 8555 §6.5).
		internal def postWith(url string, payload byte[], signer PrivateKey, withJwk bool, accept string) !http.Response {
			let attempt = 0
			for {
				attempt++
				let body = try signedBody(url, payload, signer, withJwk)
				let req = try http.request(Method.POST, url)
				req.replaceBody(body)
				req.headers.set("Content-Type", "application/jose+json")
				req.headers.set("Accept", accept) unless accept == ""
				let res = try http.do(req)
				let nonce = res.headers.get("Replay-Nonce")
				nonces.push(nonce) unless nonce == ""
				return res when res.status < 400
				let problem = try problemOf(res)
				continue when problem.kind == "urn:ietf:params:acme:error:badNonce" && attempt < 5
				fail acmeError("{url}: {problem.detail}", res.status, problem)
			}
			fail acmeError("unreachable", 0, none)
		}

		internal def signedBody(url string, payload byte[], signer PrivateKey, withJwk bool) !byte[] {
			let jws = new jose.Jws(payload)
			let header = new jose.Header()
			let jwk = new jose.Jwk(signer)
			if withJwk {
				header.jwk = jwk.publicKey()
			} else {
				header.kid = accountURL
			}
			try header.set("nonce", try nonce())
			try header.set("url", url)
			try jws.sign(jwk, try algorithmOf(signer), header)
			return (try jws.json(true)).bytes()
		}

		// A nonce kept from an earlier answer, else a fresh one.
		internal def nonce() !string {
			let kept = takeNonce()
			return kept unless kept == ""
			let d = try directory()
			let res = try http.head(d.newNonce)
			let fresh = res.headers.get("Replay-Nonce")
			fail acmeError("the CA sent no nonce", res.status, none) when fresh == ""
			return fresh
		}

		internal atomic def takeNonce() string {
			return "" when nonces.len() == 0
			return nonces.pop()
		}
	}

	// The ARI id of a certificate (RFC 9773 §4.1): the authority key
	// identifier and the serial number, each base64url, joined by a dot.
	// Fails when the certificate does not parse or has no authority key
	// identifier.
	def renewalId(certificate byte[]) !string {
		let cert = try x509.parseCertificate(certificate)
		fail acmeError("the certificate has no authority key identifier", 0, none) when cert.authorityKeyId.len() == 0
		return b64url(cert.authorityKeyId) + "." + b64url(serialBytes(cert.serialNumber))
	}

	// The serial number's DER content octets: big-endian, a leading zero
	// when the top bit is set.
	internal def serialBytes(serial bigint) byte[] {
		let hex = serial.toRadix(16)
		hex = "0" + hex when hex.len() % 2 == 1
		let out byte[] = []
		for let i = 0; i < hex.len(); i += 2 {
			out.push(parseInt<byte>(hex[i:i + 2], 16))
		}
		out.unshift(byte(0)) when out.len() > 0 && out[0] >= byte(0x80)
		return out
	}

	internal def algorithmOf(key PrivateKey) !jose.SignatureAlgorithm {
		match key {
			case ECDSAPrivateKey:
				let bits = key.curve.bitsize
				return jose.SignatureAlgorithm.ES256 when bits == 256
				return jose.SignatureAlgorithm.ES384 when bits == 384
				return jose.SignatureAlgorithm.ES512
			case RSAPrivateKey:
				return jose.SignatureAlgorithm.RS256
			case Ed25519PrivateKey:
				return jose.SignatureAlgorithm.EdDSA
			default:
				fail acmeError("this key cannot sign ACME requests", 0, none)
		}
	}

	// The external account binding JWS (RFC 8555 §7.3.4): the account's
	// public key, signed with the MAC key under the CA's key id.
	internal def bindingJWS(eab ExternalAccountBinding, newAccountURL string, accountKey PrivateKey) !string {
		let jws = new jose.Jws(new jose.Jwk(accountKey).publicKey().json().bytes())
		let header = new jose.Header()
		header.kid = eab.keyId
		try header.set("url", newAccountURL)
		try jws.sign(new jose.Jwk(eab.hmacKey), jose.SignatureAlgorithm.HS256, header)
		return try jws.json(true)
	}

	internal def contactURIs(contact string[]) string[] {
		return contact.mapElem(c => c.contains(":") ?? (c, "mailto:" + c))
	}

	// An identifier for a name: an IP address when it reads as one.
	internal def identifierOf(name string) Identifier {
		let ip = net.parseIPText(name)
		return Identifier{kind: "ip", value: name} unless ip is none
		return Identifier{kind: "dns", value: name.lower()}
	}

	internal def pollPause(asked ?duration) duration {
		return 1s when asked is none
		return asked < 1s ?? (1s, asked > 60s ?? (60s, asked))
	}

	// The URLs of a response's Link headers with the relation.
	internal def linksOf(res http.Response, relation string) string[] {
		let out string[] = []
		for let value in res.headers.values("Link") {
			for let part in value.split(",") {
				let p = part.trim()
				continue unless p.startsWith("<") && p.indexOf(">") > 0
				let target = p[1:p.indexOf(">")]
				let params = p[p.indexOf(">") + 1:].lower()
				out.push(target) when params.contains("rel=\"{relation}\"") || params.contains("rel={relation}")
			}
		}
		return out
	}

	internal def readObject(res http.Response) !map<string, any> {
		let body = try res.bytes()
		return map<string, any>{} when body.len() == 0
		let doc = try JSON.parse(body)
		fail acmeError("the CA sent JSON that is not an object", res.status, none) unless doc is map<string, any>
		return doc
	}

	internal def problemOf(res http.Response) !Problem {
		let body = res.bytes() onerror recover byte[]
		let doc = JSON.parse(body) onerror recover none
		return Problem{kind: "", detail: "HTTP {res.status}: {string(body).trim()}", status: res.status} unless doc is map<string, any>
		return problemFrom(doc, res.status)
	}

	internal def problemFrom(doc map<string, any>, status int) Problem {
		let p = Problem{kind: text(doc, "type"), detail: text(doc, "detail"), status: status}
		let id = doc.get("identifier")
		p.identifier = Identifier{kind: text(id, "type"), value: text(id, "value")} when id is map<string, any>
		let subs = doc.get("subproblems")
		if subs is any[] {
			for let s in subs {
				p.subproblems.push(problemFrom(s, status)) when s is map<string, any>
			}
		}
		return p
	}

	internal def acmeError(message string, status int, problem ?Problem) AcmeError {
		return AcmeError{message: "acme: " + message, code: "acme", status: status, problem: problem}
	}

	internal def accountOf(doc map<string, any>, url string) Account {
		return Account{url: url, status: statusOf(text(doc, "status"), Status.Valid), contact: texts(doc, "contact"), orders: text(doc, "orders")}
	}

	internal def orderOf(doc map<string, any>, url string) !Order {
		let o = Order{url: url, status: statusOf(text(doc, "status"), Status.Pending), authorizations: texts(doc, "authorizations"), finalize: text(doc, "finalize"), certificate: text(doc, "certificate"), replaces: text(doc, "replaces")}
		o.expires = timeOf(doc, "expires")
		o.notBefore = timeOf(doc, "notBefore")
		o.notAfter = timeOf(doc, "notAfter")
		let ids = doc.get("identifiers")
		if ids is any[] {
			for let id in ids {
				o.identifiers.push(Identifier{kind: text(id, "type"), value: text(id, "value")}) when id is map<string, any>
			}
		}
		let problem = doc.get("error")
		o.problem = problemFrom(problem, 0) when problem is map<string, any>
		return o
	}

	internal def authorizationOf(doc map<string, any>, url string) !Authorization {
		let a = Authorization{url: url, status: statusOf(text(doc, "status"), Status.Pending)}
		let id = doc.get("identifier")
		a.identifier = Identifier{kind: text(id, "type"), value: text(id, "value")} when id is map<string, any>
		a.expires = timeOf(doc, "expires")
		let wildcard = doc.get("wildcard")
		a.wildcard = wildcard is bool && wildcard
		let list = doc.get("challenges")
		if list is any[] {
			for let c in list {
				a.challenges.push(try challengeOf(c)) when c is map<string, any>
			}
		}
		return a
	}

	internal def challengeOf(doc map<string, any>) !Challenge {
		let c = Challenge{kind: text(doc, "type"), url: text(doc, "url"), token: text(doc, "token"), status: statusOf(text(doc, "status"), Status.Pending)}
		c.validated = timeOf(doc, "validated")
		let problem = doc.get("error")
		c.problem = problemFrom(problem, 0) when problem is map<string, any>
		return c
	}

	internal def statusOf(value string, fallback Status) Status {
		for let s in [Status.Pending, Status.Ready, Status.Processing, Status.Valid, Status.Invalid, Status.Expired, Status.Deactivated, Status.Revoked] {
			return s when s.value == value
		}
		return fallback
	}

	internal def text(doc any, name string) string {
		return "" unless doc is map<string, any>
		let v = doc.get(name)
		return v when v is string
		return ""
	}

	internal def texts(doc map<string, any>, name string) string[] {
		let out string[] = []
		let v = doc.get(name)
		if v is any[] {
			for let item in v {
				out.push(item) when item is string
			}
		}
		return out
	}

	internal def timeOf(doc map<string, any>, name string) ?time.Time {
		let value = text(doc, name)
		return none when value == ""
		let readable = true
		let at = time.parse(value, time.TimeFormat.RFC3339) onerror (err error) {
			readable = false
			recover time.now()
		}
		return none unless readable
		return at
	}

	internal def b64urlDecode(text string) !byte[] {
		let codec = new Base64()
		codec.urlSafe = true
		codec.padded = false
		return try codec.decode(text.replace("=", ""))
	}

	internal def b64url(data byte[]) string {
		let codec = new Base64()
		codec.urlSafe = true
		codec.padded = false
		return codec.encode(data)
	}
}
