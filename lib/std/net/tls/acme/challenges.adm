partial module std.net.tls.acme {
	use (
		std.time
		std.crypto
		std.crypto::(PrivateKey, generateECDSAKey, publicKeyOf)
		std.crypto.hash::(Hash, digest)
		std.crypto.x509
		std.data.encoding::(OID, asn1OctetString)
		std.net
		std.net.tls
	)

	// The ALPN protocol a tls-alpn-01 validation connects with (RFC 8737).
	const acmeTLSProtocol = "acme-tls/1"

	// Where the CA looks for an http-01 response: `/.well-known/acme-challenge/`
	// and the token.
	const http01Prefix = "/.well-known/acme-challenge/"

	// Sets and removes the TXT records of dns-01 challenges. Implement it for
	// the DNS host the domains live at (the `adm.cloud.*` libraries carry
	// implementations).
	interface DNSProvider {
		// Adds a TXT record named name (`_acme-challenge.` and the domain)
		// holding value, beside any it has, and returns once the provider has
		// taken it.
		def present(name string, value string) !none
		// Removes the record present added.
		def cleanup(name string, value string) !none
	}

	// The name of a domain's dns-01 TXT record: `_acme-challenge.` and the
	// domain, a wildcard's `*.` left out.
	def dnsRecordName(domain string) string {
		let base = domain.startsWith("*.") ?? (domain[2:], domain)
		return "_acme-challenge." + base
	}

	// The value of a dns-01 TXT record: the SHA-256 of the key
	// authorization, base64url.
	def dnsRecordValue(keyAuthorization string) string {
		return b64url(digest(Hash.SHA256, keyAuthorization.bytes()))
	}

	// The certificate a tls-alpn-01 validation must see (RFC 8737 §3): a
	// fresh P-256 key, self-signed, the identifier as its only subject
	// alternative name (a DNS name, or an IP address, RFC 8738), and the
	// critical acmeIdentifier extension holding the SHA-256 of the key
	// authorization. Fails when the random source does.
	def tlsAlpnCertificate(identifier string, keyAuthorization string) !tls.KeyPair {
		let key PrivateKey = try generateECDSAKey(crypto.p256)
		let template = x509.Template{notBefore: time.now() - 1h, notAfter: time.now() + 168h}
		let ip = net.parseIPText(identifier)
		if ip is none {
			template.dnsNames = [identifier]
		} else {
			template.ipAddresses = [ip]
		}
		let proof = asn1OctetString(digest(Hash.SHA256, keyAuthorization.bytes())).encode()
		template.extensions = [x509.Extension{id: oidAcmeIdentifier, critical: true, value: proof}]
		let der = try x509.createCertificate(template, publicKeyOf(key), none, key)
		return new tls.KeyPair([der], key)
	}

	// id-pe-acmeIdentifier (RFC 8737 §6.1).
	internal const oidAcmeIdentifier = new OID([1, 3, 6, 1, 5, 5, 7, 1, 31])

	// The name a tls-alpn-01 validation of an IP address sends as its server
	// name (RFC 8738 §6): the reverse-DNS name, `4.3.2.1.in-addr.arpa` or the
	// nibbles of an IPv6 address under `ip6.arpa`. "" for text that is no
	// address.
	def reverseName(address string) string {
		let ip = net.parseIPText(address)
		return "" when ip is none
		return "{ip[3]}.{ip[2]}.{ip[1]}.{ip[0]}.in-addr.arpa" when ip.len() == 4
		let out = ""
		let digits = "0123456789abcdef"
		for let i = ip.len() - 1; i >= 0; i-- {
			out += digits[int(ip[i] & 0x0F)] + "." + digits[int(ip[i] >> 4)] + "."
		}
		return out + "ip6.arpa"
	}
}
