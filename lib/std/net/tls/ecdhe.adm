partial module std.net.tls {
	use std.crypto::(ECDHKeyPair, rand, x25519, x25519Base, ecdhKeyPair, ecdh, marshalPoint, unmarshalPoint, p256, p384)

	// EphemeralKey is one side's ECDHE key of a TLS 1.2 key exchange
	// (RFC 8422): the named group, the public key as it goes on the wire,
	// and the private half.
	type EphemeralKey {
		group         int
		public        byte[]
		x25519Private byte[]
		pair          ?ECDHKeyPair

		def new(group int) {
			self.group = group
		}

		// sharedSecret completes the exchange with the peer's public key:
		// the X25519 output, or the x coordinate of the shared point. Fails
		// with IllegalParameter when the peer's key is not valid for the
		// group.
		def sharedSecret(peer byte[]) !byte[] {
			if group == groupX25519 {
				return x25519(x25519Private, peer) onerror fail tlsError(Alert.IllegalParameter, "peer X25519 key is invalid")
			}
			let own = pair
			fail tlsError(Alert.InternalError, "no ECDHE key for group {group}") when own is none
			let curve = group == groupSecp256r1 ?? (p256, p384)
			let point = unmarshalPoint(curve, peer) onerror fail tlsError(Alert.IllegalParameter, "peer ECDHE key is not a point on the curve")
			return ecdh(curve, own.scalar, point) onerror fail tlsError(Alert.IllegalParameter, "peer ECDHE key is invalid")
		}
	}

	// newEphemeralKey draws a fresh key for X25519, P-256 or P-384. Fails
	// with IllegalParameter for another group, or when the random source
	// does.
	def newEphemeralKey(group int) !EphemeralKey {
		fail tlsError(Alert.IllegalParameter, "key exchange group {group} is not supported") unless group := groupX25519 || groupSecp256r1 || groupSecp384r1
		let key = new EphemeralKey(group)
		if group == groupX25519 {
			key.x25519Private = try rand(32)
			key.public = try x25519Base(key.x25519Private)
			return key
		}
		let curve = group == groupSecp256r1 ?? (p256, p384)
		let own = try ecdhKeyPair(curve)
		key.pair = own
		key.public = marshalPoint(curve, own.public)
		return key
	}
}
