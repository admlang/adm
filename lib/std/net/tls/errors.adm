// TLS 1.3 (RFC 8446) for std.net: client and server over any
// net.Connection, the record layer, key schedule and handshake codec they
// are built on, and TLS 1.2 (RFC 5246) with ECDHE and an AEAD suite for old
// peers. Pure ADM on the std.crypto primitives; no 0-RTT.

partial module std.net.tls {
	use std.errors

	// Alert names the alert descriptions of RFC 8446 §6, the value being
	// the byte on the wire. A TLSError carries the one its failure maps to.
	enum Alert {
		CloseNotify = 0,
		UnexpectedMessage = 10,
		BadRecordMAC = 20,
		RecordOverflow = 22,
		HandshakeFailure = 40,
		BadCertificate = 42,
		UnsupportedCertificate = 43,
		CertificateRevoked = 44,
		CertificateExpired = 45,
		CertificateUnknown = 46,
		IllegalParameter = 47,
		UnknownCA = 48,
		AccessDenied = 49,
		DecodeError = 50,
		DecryptError = 51,
		ProtocolVersion = 70,
		InsufficientSecurity = 71,
		InternalError = 80,
		InappropriateFallback = 86,
		UserCanceled = 90,
		NoRenegotiation = 100,
		MissingExtension = 109,
		UnsupportedExtension = 110,
		UnrecognizedName = 112,
		BadCertificateStatusResponse = 113,
		UnknownPSKIdentity = 115,
		CertificateRequired = 116,
		NoApplicationProtocol = 120,
		// Any description this module does not name.
		Unknown = 255,
	}

	// alertOf maps a wire byte to its Alert, Unknown for one not listed.
	def alertOf(code int) Alert {
		match code {
			case 0:
				return Alert.CloseNotify
			case 10:
				return Alert.UnexpectedMessage
			case 20:
				return Alert.BadRecordMAC
			case 22:
				return Alert.RecordOverflow
			case 40:
				return Alert.HandshakeFailure
			case 42:
				return Alert.BadCertificate
			case 43:
				return Alert.UnsupportedCertificate
			case 44:
				return Alert.CertificateRevoked
			case 45:
				return Alert.CertificateExpired
			case 46:
				return Alert.CertificateUnknown
			case 47:
				return Alert.IllegalParameter
			case 48:
				return Alert.UnknownCA
			case 49:
				return Alert.AccessDenied
			case 50:
				return Alert.DecodeError
			case 51:
				return Alert.DecryptError
			case 70:
				return Alert.ProtocolVersion
			case 71:
				return Alert.InsufficientSecurity
			case 80:
				return Alert.InternalError
			case 86:
				return Alert.InappropriateFallback
			case 90:
				return Alert.UserCanceled
			case 100:
				return Alert.NoRenegotiation
			case 109:
				return Alert.MissingExtension
			case 110:
				return Alert.UnsupportedExtension
			case 112:
				return Alert.UnrecognizedName
			case 113:
				return Alert.BadCertificateStatusResponse
			case 115:
				return Alert.UnknownPSKIdentity
			case 116:
				return Alert.CertificateRequired
			case 120:
				return Alert.NoApplicationProtocol
			default:
				return Alert.Unknown
		}
	}

	// TLSError is the payload every std.net.tls failure carries. `alert` is
	// the alert the failure maps to: the one this side sends before closing
	// when it detected the problem, or the one the peer sent when `fromPeer`
	// is set. A CloseNotify from the peer is not an error; reads report the
	// end of the stream instead.
	struct TLSError {
		message  string
		code     string            = "tls"
		cause    ?error
		stack    errors.StackTrace
		alert    Alert
		fromPeer bool              = false
	}

	// tlsError builds the payload for a failure detected on this side.
	internal def tlsError(alert Alert, message string) TLSError {
		return TLSError{message: "tls: {message}", alert: alert}
	}

	// peerAlert builds the payload for an alert the peer sent.
	internal def peerAlert(alert Alert) TLSError {
		return TLSError{message: "tls: peer sent alert {alert}", alert: alert, fromPeer: true}
	}
}
