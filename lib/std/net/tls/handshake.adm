partial module std.net.tls {
	// Handshake message types of RFC 8446 §4, the byte on the wire. The
	// client's first flight.
	const handshakeClientHello = 1
	// The server's answer, or a HelloRetryRequest.
	const handshakeServerHello = 2
	// A resumption ticket after the handshake.
	const handshakeNewSessionTicket = 4
	// Ends 0-RTT data; not sent by this module.
	const handshakeEndOfEarlyData = 5
	// The first protected server message.
	const handshakeEncryptedExtensions = 8
	// A certificate chain.
	const handshakeCertificate = 11
	// A request for the client's certificate.
	const handshakeCertificateRequest = 13
	// A signature over the transcript.
	const handshakeCertificateVerify = 15
	// The MAC over the transcript that ends a flight.
	const handshakeFinished = 20
	// A traffic key rotation after the handshake.
	const handshakeKeyUpdate = 24
	// The synthetic message replacing the first ClientHello after a HelloRetryRequest.
	const handshakeMessageHash = 254

	// Handshake message types TLS 1.2 adds (RFC 5246 §7.4). A server's
	// request to renegotiate, which this module declines.
	const handshakeHelloRequest = 0
	// The server's ephemeral key, signed.
	const handshakeServerKeyExchange = 12
	// Ends the server's first flight.
	const handshakeServerHelloDone = 14
	// The client's ephemeral key.
	const handshakeClientKeyExchange = 16

	// Extension types of RFC 8446 §4.2. Server name indication.
	const extensionServerName = 0
	// The (EC)DHE groups offered.
	const extensionSupportedGroups = 10
	// The signature schemes accepted in CertificateVerify.
	const extensionSignatureAlgorithms = 13
	// Application-layer protocol negotiation.
	const extensionALPN = 16
	// Offered or selected pre-shared keys.
	const extensionPreSharedKey = 41
	// 0-RTT data indication.
	const extensionEarlyData = 42
	// The protocol versions offered or selected.
	const extensionSupportedVersions = 43
	// The cookie a HelloRetryRequest hands back.
	const extensionCookie = 44
	// The PSK key exchange modes offered.
	const extensionPSKModes = 45
	// The signature schemes accepted in certificates.
	const extensionSignatureAlgorithmsCert = 50
	// The (EC)DHE public keys.
	const extensionKeyShare = 51

	// The padding extension of RFC 7685.
	const extensionPadding = 21

	// Extensions of a TLS 1.2 handshake. The point formats of RFC 8422
	// §5.1.2; only uncompressed exists here.
	const extensionECPointFormats = 11
	// The extended master secret of RFC 7627.
	const extensionExtendedMasterSecret = 23
	// A session ticket of RFC 5077: the ticket to resume with, or empty to
	// ask for one.
	const extensionSessionTicket = 35
	// Secure renegotiation (RFC 5746), sent empty: no renegotiation happens.
	const extensionRenegotiationInfo = 0xff01
	// The cipher suite value that stands for an empty renegotiation_info
	// in a ClientHello (RFC 5746 §3.3).
	const suiteEmptyRenegotiationInfo = 0x00ff

	// The PSK key exchange mode this module offers: PSK with (EC)DHE.
	const pskModeDHE = 1

	// The ServerHello.random that marks a HelloRetryRequest (RFC 8446 §4.1.3).
	const helloRetryRequestRandom = "CF21AD74E59A6111BE1D8C021E65B891C2A211167ABB8C5E079E09E2C8A8339C"

	// Cursor reads big-endian integers and length-prefixed vectors from a
	// byte array, failing with a DecodeError alert when the bytes run out.
	type Cursor {
		data byte[]
		pos  int    = 0

		def new(data byte[]) {
			self.data = data
		}

		// remaining is how many bytes are left to read.
		def remaining() int {
			return data.len() - pos
		}

		// done reports whether every byte was read.
		def done() bool {
			return pos >= data.len()
		}

		// bytes takes the next count bytes. Fails with DecodeError when
		// fewer are left; so do the readers below.
		def bytes(count int) !byte[] {
			fail tlsError(Alert.DecodeError, "handshake message is truncated") when count < 0 || pos + count > data.len()
			let out = data[pos:pos + count]
			pos += count
			return out
		}

		// u8 reads one byte as an integer. Fails as bytes does.
		def u8() !int {
			let b = try bytes(1)
			return int(b[0])
		}

		// u16 reads a big-endian 16-bit integer. Fails as bytes does.
		def u16() !int {
			let b = try bytes(2)
			return int(b[0]) << 8 | int(b[1])
		}

		// u24 reads a big-endian 24-bit integer. Fails as bytes does.
		def u24() !int {
			let b = try bytes(3)
			return int(b[0]) << 16 | int(b[1]) << 8 | int(b[2])
		}

		// u32 reads a big-endian 32-bit integer. Fails as bytes does.
		def u32() !int {
			let b = try bytes(4)
			return int(b[0]) << 24 | int(b[1]) << 16 | int(b[2]) << 8 | int(b[3])
		}

		// vec8 reads a vector with a one-byte length. Fails as bytes does.
		def vec8() !byte[] {
			return try bytes(try u8())
		}

		// vec16 reads a vector with a two-byte length. Fails as bytes does.
		def vec16() !byte[] {
			return try bytes(try u16())
		}

		// vec24 reads a vector with a three-byte length. Fails as bytes does.
		def vec24() !byte[] {
			return try bytes(try u24())
		}

		// u16List reads a two-byte-length vector of 16-bit integers. Fails
		// as bytes does, and with DecodeError for an odd length.
		def u16List() !int[] {
			let body = new Cursor(try vec16())
			fail tlsError(Alert.DecodeError, "odd list length") when body.remaining() % 2 != 0
			let out int[]
			for !body.done() {
				out.push(try body.u16())
			}
			return out
		}
	}

	internal def u8(v int) byte[] {
		return byte[byte(v & 0xFF)]
	}

	internal def u16(v int) byte[] {
		return byte[byte((v >> 8) & 0xFF), byte(v & 0xFF)]
	}

	internal def u24(v int) byte[] {
		return byte[byte((v >> 16) & 0xFF), byte((v >> 8) & 0xFF), byte(v & 0xFF)]
	}

	internal def u32(v int) byte[] {
		return byte[byte((v >> 24) & 0xFF), byte((v >> 16) & 0xFF), byte((v >> 8) & 0xFF), byte(v & 0xFF)]
	}

	internal def vec8(body byte[]) byte[] {
		return u8(body.len()) + body
	}

	internal def vec16(body byte[]) byte[] {
		return u16(body.len()) + body
	}

	internal def vec24(body byte[]) byte[] {
		return u24(body.len()) + body
	}

	internal def u16ListBytes(values int[]) byte[] {
		let out byte[]
		for let (_, v) in values {
			out = out + u16(v)
		}
		return vec16(out)
	}

	internal def extension(kind int, body byte[]) byte[] {
		return u16(kind) + vec16(body)
	}

	// handshakeMessage frames a message body with its type and 24-bit length.
	def handshakeMessage(kind int, body byte[]) byte[] {
		return u8(kind) + vec24(body)
	}

	// splitHandshake returns the first complete handshake message in buffer
	// as (type, body, bytes consumed), none when more bytes are needed.
	def splitHandshake(buffer byte[]) ?(int, byte[], int) {
		return none when buffer.len() < 4
		let length = int(buffer[1]) << 16 | int(buffer[2]) << 8 | int(buffer[3])
		return none when buffer.len() < 4 + length
		return (int(buffer[0]), buffer[4:4 + length], 4 + length)
	}

	// HandshakeReader hands out the handshake messages of a connection one
	// at a time, reading records as needed and keeping the bytes of a
	// message not complete yet. change_cipher_spec records are dropped, an
	// alert record fails with the peer's alert.
	type HandshakeReader {
		records RecordLayer
		buffer  byte[]

		def new(records RecordLayer) {
			self.records = records
		}

		// next returns the next message as (type, body, framed bytes).
		// Fails with TLSError for an alert or an unexpected record, NetError
		// from the transport.
		def next() !(int, byte[], byte[]) {
			for {
				let ready = splitHandshake(buffer)
				return take(ready) unless ready is none
				let record = try records.read()
				switch {
					case record.contentType == recordHandshake:
						buffer = buffer + record.payload
					case record.contentType == recordChangeCipherSpec:
						fail tlsError(Alert.UnexpectedMessage, "malformed change_cipher_spec") unless record.payload.len() == 1 && record.payload[0] == 1
						fail tlsError(Alert.UnexpectedMessage, "change_cipher_spec inside a handshake message") when records.legacy && buffer.len() > 0
					case record.contentType == recordAlert:
						fail tlsError(Alert.DecodeError, "alert record of {record.payload.len()} bytes") when record.payload.len() != 2
						fail peerAlert(alertOf(int(record.payload[1])))
					default:
						fail tlsError(Alert.UnexpectedMessage, "unexpected record type {record.contentType} during the handshake")
				}
			}
			fail tlsError(Alert.InternalError, "unreachable")
		}

		// take removes a complete message from the buffer.
		internal def take(ready (int, byte[], int)) (int, byte[], byte[]) {
			let (kind, body, used) = ready
			let framed = buffer[0:used]
			buffer = buffer[used:]
			return (kind, body, framed)
		}
	}

	// KeyShare is one (EC)DHE share: the named group and its public key.
	struct KeyShare {
		group int
		data  byte[]
	}

	// PSKIdentity offers one pre-shared key: the ticket and the obfuscated
	// ticket age (RFC 8446 §4.2.11).
	struct PSKIdentity {
		identity            byte[]
		obfuscatedTicketAge int
	}

	// ClientHello is the first flight (RFC 8446 §4.1.2), with the extensions
	// this module sends or reads. Binders, when identities are offered, come
	// last in the encoding so the client can patch them in.
	struct ClientHello {
		random               byte[]
		sessionID            byte[]
		cipherSuites         int[]
		serverName           string        = ""
		supportedVersions    int[]
		supportedGroups      int[]
		keyShares            KeyShare[]
		signatureAlgorithms  int[]
		alpnProtocols        string[]
		pskModes             int[]
		pskIdentities        PSKIdentity[]
		pskBinders           byte[][]
		cookie               byte[]
		earlyData            bool          = false
		// What a TLS 1.2 server needs: the uncompressed point format, the
		// extended master secret and an empty renegotiation_info.
		ecPointFormats       bool          = false
		extendedMasterSecret bool          = false
		secureRenegotiation  bool          = false
		// The session_ticket extension of RFC 5077: whether it is sent,
		// and the TLS 1.2 ticket to resume with, empty to ask for one.
		offersSessionTicket  bool          = false
		sessionTicket        byte[]
	}

	// marshalClientHello encodes the message, header included. Fields left
	// empty are omitted; a pre_shared_key extension is written last.
	def marshalClientHello(hello ClientHello) byte[] {
		let body = u16(0x0303) + hello.random + vec8(hello.sessionID) + u16ListBytes(hello.cipherSuites) + vec8(byte[0])
		let extensions byte[]
		if hello.serverName != "" {
			let name = hello.serverName.bytes()
			extensions = extensions + extension(extensionServerName, vec16(u8(0) + vec16(name)))
		}
		extensions = extensions + extension(extensionSupportedGroups, u16ListBytes(hello.supportedGroups)) when hello.supportedGroups.len() > 0
		extensions = extensions + extension(extensionECPointFormats, vec8(byte[0])) when hello.ecPointFormats
		extensions = extensions + extension(extensionExtendedMasterSecret, []) when hello.extendedMasterSecret
		extensions = extensions + extension(extensionRenegotiationInfo, vec8([])) when hello.secureRenegotiation
		extensions = extensions + extension(extensionSessionTicket, hello.sessionTicket) when hello.offersSessionTicket
		extensions = extensions + extension(extensionSignatureAlgorithms, u16ListBytes(hello.signatureAlgorithms)) when hello.signatureAlgorithms.len() > 0
		if hello.alpnProtocols.len() > 0 {
			let list byte[]
			for let (_, p) in hello.alpnProtocols {
				list = list + vec8(p.bytes())
			}
			extensions = extensions + extension(extensionALPN, vec16(list))
		}
		if hello.supportedVersions.len() > 0 {
			let list byte[]
			for let (_, v) in hello.supportedVersions {
				list = list + u16(v)
			}
			extensions = extensions + extension(extensionSupportedVersions, vec8(list))
		}
		extensions = extensions + extension(extensionCookie, vec16(hello.cookie)) when hello.cookie.len() > 0
		if hello.pskModes.len() > 0 {
			let list byte[]
			for let (_, m) in hello.pskModes {
				list = list + u8(m)
			}
			extensions = extensions + extension(extensionPSKModes, vec8(list))
		}
		if hello.keyShares.len() > 0 {
			let list byte[]
			for let (_, share) in hello.keyShares {
				list = list + u16(share.group) + vec16(share.data)
			}
			extensions = extensions + extension(extensionKeyShare, vec16(list))
		}
		extensions = extensions + extension(extensionEarlyData, []) when hello.earlyData
		let psk byte[]
		if hello.pskIdentities.len() > 0 {
			let identities byte[]
			for let (_, id) in hello.pskIdentities {
				identities = identities + vec16(id.identity) + u32(id.obfuscatedTicketAge)
			}
			let binders byte[]
			for let (_, b) in hello.pskBinders {
				binders = binders + vec8(b)
			}
			psk = extension(extensionPreSharedKey, vec16(identities) + vec16(binders))
		}
		return assembleClientHello(body, extensions, psk)
	}

	// assembleClientHello frames a ClientHello body, its extensions and
	// the pre_shared_key extension (empty for none), which stays last:
	// padding of a message of 256 to 507 bytes to 512 (RFC 7685, the
	// workaround for middleboxes that choke on those lengths) goes before
	// it.
	def assembleClientHello(body, extensions, psk byte[]) byte[] {
		let length = 4 + body.len() + 2 + extensions.len() + psk.len()
		let padded = extensions
		if length >= 256 && length <= 507 {
			let zeros byte[]
			zeros.len(512 - length - 4)
			padded = padded + extension(extensionPadding, zeros)
		}
		return handshakeMessage(handshakeClientHello, body + vec16(padded + psk))
	}

	// retryClientHello is the second ClientHello after a HelloRetryRequest
	// (RFC 8446 §4.1.2): the first one byte for byte, with the key_share
	// body replaced, early_data and padding dropped, and the cookie, when
	// the server sent one, inserted before psk_key_exchange_modes (or
	// pre_shared_key, or last). Binders keep their size, to be patched
	// afterwards. Fails with DecodeError when the message does not parse.
	def retryClientHello(message byte[], keyShareBody byte[], cookie byte[]) !byte[] {
		let c = new Cursor(message)
		try c.u8()
		let body = new Cursor(try c.vec24())
		let fixed = try body.bytes(2 + 32)
		let sessionID = try body.vec8()
		let suites = try body.vec16()
		let compression = try body.vec8()
		let head = fixed + vec8(sessionID) + vec16(suites) + vec8(compression)
		let extensions = new Cursor(try body.vec16())
		let out byte[]
		let psk byte[]
		let cookiePlaced = false
		for !extensions.done() {
			let kind = try extensions.u16()
			let ext = try extensions.vec16()
			if cookie.len() > 0 && !cookiePlaced && (kind := extensionPSKModes || extensionPreSharedKey) {
				out = out + extension(extensionCookie, vec16(cookie))
				cookiePlaced = true
			}
			switch {
				case kind == extensionKeyShare:
					out = out + extension(extensionKeyShare, keyShareBody)
				case kind == extensionPreSharedKey:
					psk = extension(kind, ext)
				case kind := extensionEarlyData || extensionPadding || extensionCookie:
				// Dropped: no 0-RTT on a retry, padding is redone, an
				// old cookie is replaced.
				default:
					out = out + extension(kind, ext)
			}
		}
		out = out + extension(extensionCookie, vec16(cookie)) when cookie.len() > 0 && !cookiePlaced
		return assembleClientHello(head, out, psk)
	}

	// clientHelloBindersLength is how many trailing bytes of the encoded
	// message the binders list takes, the part a binder does not cover.
	def clientHelloBindersLength(hello ClientHello) int {
		return 0 when hello.pskIdentities.len() == 0
		let n = 2
		for let (_, b) in hello.pskBinders {
			n += 1 + b.len()
		}
		return n
	}

	// parseClientHello decodes a message body. Fails with DecodeError when
	// the bytes are malformed, IllegalParameter for an unknown legacy field.
	def parseClientHello(body byte[]) !ClientHello {
		let c = new Cursor(body)
		let version = try c.u16()
		fail tlsError(Alert.ProtocolVersion, "ClientHello legacy version {version}") when version != 0x0303
		let hello = ClientHello{random: try c.bytes(32), sessionID: try c.vec8(), cipherSuites: try c.u16List()}
		let compression = try c.vec8()
		fail tlsError(Alert.IllegalParameter, "ClientHello without null compression") unless compression.includes(0)
		hello.secureRenegotiation = hello.cipherSuites.includes(suiteEmptyRenegotiationInfo)
		return hello when c.done()
		let extensions = new Cursor(try c.vec16())
		for !extensions.done() {
			let kind = try extensions.u16()
			let ext = new Cursor(try extensions.vec16())
			switch {
				case kind == extensionServerName:
					let names = new Cursor(try ext.vec16())
					for !names.done() {
						let nameType = try names.u8()
						let name = try names.vec16()
						hello.serverName = string(name) when nameType == 0
					}
				case kind == extensionSupportedGroups:
					hello.supportedGroups = try ext.u16List()
				case kind == extensionSignatureAlgorithms:
					hello.signatureAlgorithms = try ext.u16List()
				case kind == extensionALPN:
					let list = new Cursor(try ext.vec16())
					for !list.done() {
						hello.alpnProtocols.push(string(try list.vec8()))
					}
				case kind == extensionSupportedVersions:
					let list = new Cursor(try ext.vec8())
					for !list.done() {
						hello.supportedVersions.push(try list.u16())
					}
				case kind == extensionCookie:
					hello.cookie = try ext.vec16()
				case kind == extensionPSKModes:
					let list = new Cursor(try ext.vec8())
					for !list.done() {
						hello.pskModes.push(try list.u8())
					}
				case kind == extensionKeyShare:
					let list = new Cursor(try ext.vec16())
					for !list.done() {
						hello.keyShares.push(KeyShare{group: try list.u16(), data: try list.vec16()})
					}
				case kind == extensionEarlyData:
					hello.earlyData = true
				case kind == extensionECPointFormats:
					let formats = try ext.vec8()
					fail tlsError(Alert.IllegalParameter, "client does not take uncompressed points") unless formats.includes(0)
					hello.ecPointFormats = true
				case kind == extensionExtendedMasterSecret:
					hello.extendedMasterSecret = true
				case kind == extensionSessionTicket:
					hello.offersSessionTicket = true
					hello.sessionTicket = try ext.bytes(ext.remaining())
				case kind == extensionRenegotiationInfo:
					let renegotiated = try ext.vec8()
					fail tlsError(Alert.HandshakeFailure, "ClientHello renegotiates") when renegotiated.len() > 0
					hello.secureRenegotiation = true
				case kind == extensionPreSharedKey:
					let identities = new Cursor(try ext.vec16())
					for !identities.done() {
						hello.pskIdentities.push(PSKIdentity{identity: try identities.vec16(), obfuscatedTicketAge: try identities.u32()})
					}
					let binders = new Cursor(try ext.vec16())
					for !binders.done() {
						hello.pskBinders.push(try binders.vec8())
					}
				default:
					// Extensions this module does not read are skipped.
					ext.pos = ext.data.len()
			}
		}
		return hello
	}

	// ServerHello is the server's answer (RFC 8446 §4.1.3), also a
	// HelloRetryRequest when its random is the special value: then
	// `selectedGroup` or `cookie` says what to change and there is no share.
	struct ServerHello {
		random               byte[]
		sessionID            byte[]
		cipherSuite          int
		supportedVersion     int       = 0
		keyShare             ?KeyShare
		selectedGroup        int       = 0
		selectedIdentity     int       = -1
		cookie               byte[]
		isHelloRetryRequest  bool      = false
		// What only a TLS 1.2 ServerHello carries, TLS 1.3 having moved it
		// to EncryptedExtensions or dropped it.
		alpnProtocol         string    = ""
		extendedMasterSecret bool      = false
		secureRenegotiation  bool      = false
		ecPointFormats       bool      = false
		serverNameAck        bool      = false
		// A NewSessionTicket follows before the server's Finished.
		sessionTicket        bool      = false
	}

	// marshalServerHello encodes the message, header included.
	def marshalServerHello(hello ServerHello) byte[] {
		let body = u16(0x0303) + hello.random + vec8(hello.sessionID) + u16(hello.cipherSuite) + u8(0)
		let extensions byte[]
		let share = hello.keyShare
		extensions = extensions + extension(extensionKeyShare, u16(share.group) + vec16(share.data)) unless share is none
		extensions = extensions + extension(extensionKeyShare, u16(hello.selectedGroup)) when hello.selectedGroup != 0
		extensions = extensions + extension(extensionSupportedVersions, u16(hello.supportedVersion)) when hello.supportedVersion != 0
		extensions = extensions + extension(extensionPreSharedKey, u16(hello.selectedIdentity)) when hello.selectedIdentity >= 0
		extensions = extensions + extension(extensionCookie, vec16(hello.cookie)) when hello.cookie.len() > 0
		extensions = extensions + extension(extensionRenegotiationInfo, vec8([])) when hello.secureRenegotiation
		extensions = extensions + extension(extensionExtendedMasterSecret, []) when hello.extendedMasterSecret
		extensions = extensions + extension(extensionECPointFormats, vec8(byte[0])) when hello.ecPointFormats
		extensions = extensions + extension(extensionServerName, []) when hello.serverNameAck
		extensions = extensions + extension(extensionSessionTicket, []) when hello.sessionTicket
		extensions = extensions + extension(extensionALPN, vec16(vec8(hello.alpnProtocol.bytes()))) when hello.alpnProtocol != ""
		return handshakeMessage(handshakeServerHello, body + vec16(extensions))
	}

	// parseServerHello decodes a message body, marking a HelloRetryRequest.
	// Fails with DecodeError when the bytes are malformed, IllegalParameter
	// for an unknown legacy field.
	def parseServerHello(body byte[]) !ServerHello {
		let c = new Cursor(body)
		let version = try c.u16()
		fail tlsError(Alert.ProtocolVersion, "ServerHello legacy version {version}") when version != 0x0303
		let hello = ServerHello{random: try c.bytes(32), sessionID: try c.vec8(), cipherSuite: try c.u16()}
		let compression = try c.u8()
		fail tlsError(Alert.IllegalParameter, "ServerHello selects compression {compression}") when compression != 0
		hello.isHelloRetryRequest = hello.random.hex() == helloRetryRequestRandom
		return hello when c.done()
		let extensions = new Cursor(try c.vec16())
		for !extensions.done() {
			let kind = try extensions.u16()
			let ext = new Cursor(try extensions.vec16())
			switch {
				case kind == extensionSupportedVersions:
					hello.supportedVersion = try ext.u16()
				case kind == extensionKeyShare:
					if hello.isHelloRetryRequest {
						hello.selectedGroup = try ext.u16()
					} else {
						hello.keyShare = KeyShare{group: try ext.u16(), data: try ext.vec16()}
					}
				case kind == extensionPreSharedKey:
					hello.selectedIdentity = try ext.u16()
				case kind == extensionCookie:
					hello.cookie = try ext.vec16()
				case kind == extensionRenegotiationInfo:
					let renegotiated = try ext.vec8()
					fail tlsError(Alert.HandshakeFailure, "ServerHello renegotiates") when renegotiated.len() > 0
					hello.secureRenegotiation = true
				case kind == extensionExtendedMasterSecret:
					hello.extendedMasterSecret = true
				case kind == extensionECPointFormats:
					try ext.vec8()
					hello.ecPointFormats = true
				case kind == extensionServerName:
					hello.serverNameAck = true
				case kind == extensionSessionTicket:
					hello.sessionTicket = true
				case kind == extensionALPN:
					let list = new Cursor(try ext.vec16())
					hello.alpnProtocol = string(try list.vec8())
					fail tlsError(Alert.IllegalParameter, "server selected more than one ALPN protocol") unless list.done()
				default:
					fail tlsError(Alert.UnsupportedExtension, "ServerHello carries extension {kind}")
			}
			fail tlsError(Alert.DecodeError, "ServerHello extension {kind} has trailing bytes") unless ext.done()
		}
		return hello
	}

	// EncryptedExtensions carries the server's answers that need no
	// protection from tampering by the key exchange (RFC 8446 §4.3.1).
	struct EncryptedExtensions {
		alpnProtocol string = ""
		earlyData    bool   = false
	}

	// marshalEncryptedExtensions encodes the message, header included.
	def marshalEncryptedExtensions(ee EncryptedExtensions) byte[] {
		let extensions byte[]
		extensions = extensions + extension(extensionALPN, vec16(vec8(ee.alpnProtocol.bytes()))) when ee.alpnProtocol != ""
		extensions = extensions + extension(extensionEarlyData, []) when ee.earlyData
		return handshakeMessage(handshakeEncryptedExtensions, vec16(extensions))
	}

	// parseEncryptedExtensions decodes a message body; extensions it does
	// not read are skipped. Fails with DecodeError when malformed.
	def parseEncryptedExtensions(body byte[]) !EncryptedExtensions {
		let c = new Cursor(body)
		let out = EncryptedExtensions{}
		let extensions = new Cursor(try c.vec16())
		fail tlsError(Alert.DecodeError, "EncryptedExtensions has trailing bytes") unless c.done()
		for !extensions.done() {
			let kind = try extensions.u16()
			let ext = new Cursor(try extensions.vec16())
			switch {
				case kind == extensionALPN:
					let list = new Cursor(try ext.vec16())
					out.alpnProtocol = string(try list.vec8())
					fail tlsError(Alert.IllegalParameter, "server selected more than one ALPN protocol") unless list.done()
				case kind == extensionEarlyData:
					out.earlyData = true
				default:
					ext.pos = ext.data.len()
			}
		}
		return out
	}

	// CertificateEntry is one certificate of a chain with its extensions.
	struct CertificateEntry {
		data       byte[]
		extensions byte[]
	}

	// CertificateMessage carries the chain, leaf first (RFC 8446 §4.4.2).
	struct CertificateMessage {
		requestContext byte[]
		entries        CertificateEntry[]
	}

	// marshalCertificateMessage encodes the message, header included.
	def marshalCertificateMessage(msg CertificateMessage) byte[] {
		let list byte[]
		for let (_, entry) in msg.entries {
			list = list + vec24(entry.data) + vec16(entry.extensions)
		}
		return handshakeMessage(handshakeCertificate, vec8(msg.requestContext) + vec24(list))
	}

	// parseCertificateMessage decodes a message body. Fails with DecodeError when
	// malformed.
	def parseCertificateMessage(body byte[]) !CertificateMessage {
		let c = new Cursor(body)
		let msg = CertificateMessage{requestContext: try c.vec8()}
		let list = new Cursor(try c.vec24())
		fail tlsError(Alert.DecodeError, "Certificate has trailing bytes") unless c.done()
		for !list.done() {
			msg.entries.push(CertificateEntry{data: try list.vec24(), extensions: try list.vec16()})
		}
		return msg
	}

	// marshalCertificate12 encodes a TLS 1.2 Certificate (RFC 5246 §7.4.2),
	// header included: the chain as DER, leaf first, without the request
	// context and per-certificate extensions of TLS 1.3. An empty chain is
	// how a client declines a CertificateRequest.
	def marshalCertificate12(chain byte[][]) byte[] {
		let list byte[]
		for let (_, der) in chain {
			list = list + vec24(der)
		}
		return handshakeMessage(handshakeCertificate, vec24(list))
	}

	// parseCertificate12 decodes a TLS 1.2 Certificate body into the chain
	// as DER. Fails with DecodeError when malformed.
	def parseCertificate12(body byte[]) !byte[][] {
		let c = new Cursor(body)
		let list = new Cursor(try c.vec24())
		fail tlsError(Alert.DecodeError, "Certificate has trailing bytes") unless c.done()
		let chain byte[][]
		for !list.done() {
			chain.push(try list.vec24())
		}
		return chain
	}

	// Client certificate types of RFC 5246 §7.4.4 and RFC 8422 §5.5: a
	// certificate with an RSA key that signs.
	const certificateTypeRSASign = 1
	// A certificate with an ECDSA key.
	const certificateTypeECDSASign = 64

	// CertificateRequest12 asks a TLS 1.2 client for a certificate
	// (RFC 5246 §7.4.4): the key types and signature schemes the server
	// takes, and the distinguished names of the authorities it trusts as
	// DER, empty for any.
	struct CertificateRequest12 {
		certificateTypes    int[]
		signatureAlgorithms int[]
		authorities         byte[][]
	}

	// marshalCertificateRequest12 encodes the message, header included.
	def marshalCertificateRequest12(req CertificateRequest12) byte[] {
		let types byte[]
		for let (_, t) in req.certificateTypes {
			types = types + u8(t)
		}
		let names byte[]
		for let (_, name) in req.authorities {
			names = names + vec16(name)
		}
		return handshakeMessage(handshakeCertificateRequest, vec8(types) + u16ListBytes(req.signatureAlgorithms) + vec16(names))
	}

	// parseCertificateRequest12 decodes a message body. Fails with
	// DecodeError when malformed.
	def parseCertificateRequest12(body byte[]) !CertificateRequest12 {
		let c = new Cursor(body)
		let req = CertificateRequest12{}
		for let (_, t) in try c.vec8() {
			req.certificateTypes.push(int(t))
		}
		req.signatureAlgorithms = try c.u16List()
		let names = new Cursor(try c.vec16())
		fail tlsError(Alert.DecodeError, "CertificateRequest has trailing bytes") unless c.done()
		for !names.done() {
			req.authorities.push(try names.vec16())
		}
		return req
	}

	// ServerKeyExchange is the server's ephemeral ECDHE key in TLS 1.2
	// (RFC 8422 §5.4): the named group, the public key, and the signature
	// of the certificate's key over both randoms and these parameters.
	struct ServerKeyExchange {
		group     int
		point     byte[]
		algorithm int
		signature byte[]
	}

	// serverKeyExchangeParams encodes the ServerECDHParams a
	// ServerKeyExchange carries and signs: a named curve and its point.
	def serverKeyExchangeParams(group int, point byte[]) byte[] {
		return u8(3) + u16(group) + vec8(point)
	}

	// marshalServerKeyExchange encodes the message, header included.
	def marshalServerKeyExchange(kx ServerKeyExchange) byte[] {
		return handshakeMessage(handshakeServerKeyExchange, serverKeyExchangeParams(kx.group, kx.point) + u16(kx.algorithm) + vec16(kx.signature))
	}

	// parseServerKeyExchange decodes a message body. Fails with DecodeError
	// when malformed, HandshakeFailure for parameters that are not a named
	// curve.
	def parseServerKeyExchange(body byte[]) !ServerKeyExchange {
		let c = new Cursor(body)
		let curveType = try c.u8()
		fail tlsError(Alert.HandshakeFailure, "ServerKeyExchange with curve type {curveType}") when curveType != 3
		let kx = ServerKeyExchange{group: try c.u16(), point: try c.vec8(), algorithm: try c.u16(), signature: try c.vec16()}
		fail tlsError(Alert.DecodeError, "ServerKeyExchange has trailing bytes") unless c.done()
		return kx
	}

	// NewSessionTicket12 is a TLS 1.2 resumption ticket (RFC 5077 §3.3):
	// how long the client may keep it in seconds, 0 for unspecified, and
	// the ticket, opaque to the client.
	struct NewSessionTicket12 {
		lifetimeHint int
		ticket       byte[]
	}

	// marshalNewSessionTicket12 encodes the message, header included.
	def marshalNewSessionTicket12(t NewSessionTicket12) byte[] {
		return handshakeMessage(handshakeNewSessionTicket, u32(t.lifetimeHint) + vec16(t.ticket))
	}

	// parseNewSessionTicket12 decodes a message body. Fails with DecodeError
	// when malformed.
	def parseNewSessionTicket12(body byte[]) !NewSessionTicket12 {
		let c = new Cursor(body)
		let t = NewSessionTicket12{lifetimeHint: try c.u32(), ticket: try c.vec16()}
		fail tlsError(Alert.DecodeError, "NewSessionTicket has trailing bytes") unless c.done()
		return t
	}

	// marshalServerHelloDone encodes the empty message that ends a TLS 1.2
	// server's first flight.
	def marshalServerHelloDone() byte[] {
		return handshakeMessage(handshakeServerHelloDone, [])
	}

	// marshalClientKeyExchange encodes the client's ephemeral ECDHE public
	// key (RFC 8422 §5.7), header included.
	def marshalClientKeyExchange(point byte[]) byte[] {
		return handshakeMessage(handshakeClientKeyExchange, vec8(point))
	}

	// parseClientKeyExchange decodes a message body into the client's
	// public key. Fails with DecodeError when malformed.
	def parseClientKeyExchange(body byte[]) !byte[] {
		let c = new Cursor(body)
		let point = try c.vec8()
		fail tlsError(Alert.DecodeError, "ClientKeyExchange has trailing bytes") unless c.done()
		return point
	}

	// CertificateRequest asks the client for a certificate (RFC 8446 §4.3.2).
	struct CertificateRequest {
		requestContext      byte[]
		signatureAlgorithms int[]
	}

	// marshalCertificateRequest encodes the message, header included, with
	// the signature_algorithms extension.
	def marshalCertificateRequest(req CertificateRequest) byte[] {
		let extensions = extension(extensionSignatureAlgorithms, u16ListBytes(req.signatureAlgorithms))
		return handshakeMessage(handshakeCertificateRequest, vec8(req.requestContext) + vec16(extensions))
	}

	// parseCertificateRequest decodes a message body, reading the signature
	// algorithms and skipping other extensions. Fails with DecodeError when
	// malformed.
	def parseCertificateRequest(body byte[]) !CertificateRequest {
		let c = new Cursor(body)
		let req = CertificateRequest{requestContext: try c.vec8()}
		let extensions = new Cursor(try c.vec16())
		for !extensions.done() {
			let kind = try extensions.u16()
			let ext = new Cursor(try extensions.vec16())
			req.signatureAlgorithms = try ext.u16List() when kind == extensionSignatureAlgorithms
		}
		return req
	}

	// CertificateVerify signs the transcript (RFC 8446 §4.4.3).
	struct CertificateVerify {
		algorithm int
		signature byte[]
	}

	// marshalCertificateVerify encodes the message, header included.
	def marshalCertificateVerify(cv CertificateVerify) byte[] {
		return handshakeMessage(handshakeCertificateVerify, u16(cv.algorithm) + vec16(cv.signature))
	}

	// parseCertificateVerify decodes a message body. Fails with DecodeError
	// when malformed.
	def parseCertificateVerify(body byte[]) !CertificateVerify {
		let c = new Cursor(body)
		let cv = CertificateVerify{algorithm: try c.u16(), signature: try c.vec16()}
		fail tlsError(Alert.DecodeError, "CertificateVerify has trailing bytes") unless c.done()
		return cv
	}

	// certificateVerifyContent is what CertificateVerify signs: 64 spaces,
	// the context string, a zero byte and the transcript hash.
	def certificateVerifyContent(context string, transcriptHash byte[]) byte[] {
		let pad byte[]
		pad.len(64)
		pad.fill(0x20)
		return pad + context.bytes() + byte[0] + transcriptHash
	}

	// marshalFinished encodes a Finished message over its verify data.
	def marshalFinished(verifyData byte[]) byte[] {
		return handshakeMessage(handshakeFinished, verifyData)
	}

	// NewSessionTicket is a resumption ticket (RFC 8446 §4.6.1).
	struct NewSessionTicket {
		lifetime     int
		ageAdd       int
		nonce        byte[]
		ticket       byte[]
		maxEarlyData int    = 0
	}

	// marshalNewSessionTicket encodes the message, header included.
	def marshalNewSessionTicket(t NewSessionTicket) byte[] {
		let extensions byte[]
		extensions = extension(extensionEarlyData, u32(t.maxEarlyData)) when t.maxEarlyData > 0
		return handshakeMessage(handshakeNewSessionTicket, u32(t.lifetime) + u32(t.ageAdd) + vec8(t.nonce) + vec16(t.ticket) + vec16(extensions))
	}

	// parseNewSessionTicket decodes a message body. Fails with DecodeError
	// when malformed.
	def parseNewSessionTicket(body byte[]) !NewSessionTicket {
		let c = new Cursor(body)
		let t = NewSessionTicket{lifetime: try c.u32(), ageAdd: try c.u32(), nonce: try c.vec8(), ticket: try c.vec16()}
		let extensions = new Cursor(try c.vec16())
		fail tlsError(Alert.DecodeError, "NewSessionTicket has trailing bytes") unless c.done()
		for !extensions.done() {
			let kind = try extensions.u16()
			let ext = new Cursor(try extensions.vec16())
			t.maxEarlyData = try ext.u32() when kind == extensionEarlyData
		}
		return t
	}

	// marshalKeyUpdate encodes a KeyUpdate, asking the peer to update too
	// when requested.
	def marshalKeyUpdate(requestUpdate bool) byte[] {
		return handshakeMessage(handshakeKeyUpdate, u8(requestUpdate ?? (1, 0)))
	}

	// parseKeyUpdate decodes a message body into whether an update is
	// requested. Fails with IllegalParameter for any other value.
	def parseKeyUpdate(body byte[]) !bool {
		let c = new Cursor(body)
		let v = try c.u8()
		fail tlsError(Alert.IllegalParameter, "KeyUpdate request {v}") when v > 1 || !c.done()
		return v == 1
	}
}
