partial module std.net.tls {
	use std.crypto.hash::(Hash, hmac)

	// The length of a TLS 1.2 master secret (RFC 5246 §8.1).
	const masterSecretSize = 48
	// The length of the verify data in a TLS 1.2 Finished (RFC 5246 §7.4.9).
	const finishedSize12 = 12

	// pHash is P_hash of RFC 5246 §5: HMAC chained over the seed until
	// length bytes are out.
	def pHash(hash Hash, secret, seed byte[], length int) byte[] {
		let out byte[]
		let a = seed
		for out.len() < length {
			a = hmac(hash, secret, a)
			out = out + hmac(hash, secret, a + seed)
		}
		return out[0:length]
	}

	// prf is the TLS 1.2 pseudorandom function (RFC 5246 §5) under the hash
	// of the cipher suite: P_hash over the label and the seed.
	def prf(hash Hash, secret byte[], label string, seed byte[], length int) byte[] {
		return pHash(hash, secret, label.bytes() + seed, length)
	}

	// extendedMasterSecret is the master secret of RFC 7627 §4: bound to the
	// hash of the handshake through ClientKeyExchange instead of the two
	// randoms alone.
	def extendedMasterSecret(hash Hash, preMaster, sessionHash byte[]) byte[] {
		return prf(hash, preMaster, "extended master secret", sessionHash, masterSecretSize)
	}

	// finishedVerifyData is the verify data of a TLS 1.2 Finished
	// (RFC 5246 §7.4.9) over the hash of the handshake so far; label is
	// "client finished" or "server finished".
	def finishedVerifyData(hash Hash, master byte[], label string, transcriptHash byte[]) byte[] {
		return prf(hash, master, label, transcriptHash, finishedSize12)
	}

	// KeyBlock is the key material of a TLS 1.2 connection with an AEAD
	// suite (RFC 5246 §6.3): a write key and an implicit nonce per side.
	struct KeyBlock {
		clientKey byte[]
		serverKey byte[]
		clientIV  byte[]
		serverIV  byte[]
	}

	// keyBlock expands the master secret into the suite's key material. The
	// implicit nonce is the 4-byte salt of AES-GCM (RFC 5288 §3) or the
	// whole 12-byte IV of ChaCha20-Poly1305 (RFC 7905 §2).
	def keyBlock(suite CipherSuite, master, clientRandom, serverRandom byte[]) KeyBlock {
		let keySize = suiteKeySize(suite)
		let ivSize = suiteUsesChaCha20(suite) ?? (12, 4)
		let block = prf(suiteHash(suite), master, "key expansion", serverRandom + clientRandom, 2 * keySize + 2 * ivSize)
		let ivs = 2 * keySize
		return KeyBlock{clientKey: block[0:keySize], serverKey: block[keySize:ivs], clientIV: block[ivs:ivs + ivSize], serverIV: block[ivs + ivSize:]}
	}
}
