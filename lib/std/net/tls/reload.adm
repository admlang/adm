partial module std.net.tls {
	use (
		std.os
		std.time
	)

	// CertificateGetter is the shape of `Config.getCertificate`: the key
	// pair for a ClientHello, none to fall back on `Config.certificates`.
	type CertificateGetter = def (info ClientHelloInfo) !?KeyPair

	// KeyPairFile keeps the key pair of a certificate file and a key file
	// current, for a server that outlives its certificate: a renewal that
	// replaces the files is picked up by the next handshake, without a
	// restart. The files are looked at once per `checkEvery` at most, and
	// read again when the size or modification time of either changed. A
	// reload that fails (a file half written, a key that does not match)
	// leaves the pair before in use and is kept in `lastError`.
	//
	//     let files = try watchKeyPair("/etc/ssl/site.pem", "/etc/ssl/site.key")
	//     config.getCertificate = files.getter()
	type KeyPairFile {
		certFile   string
		keyFile    string
		// How long a loaded pair is used before the files are looked at
		// again; 0s looks at them on every handshake.
		checkEvery duration = 1m
		// Why the last reload failed, none when it worked.
		lastError  ?error   = none
		// How many times the files were read, the first load included.
		loads      int      = 0

		internal pair      ?KeyPair  = none
		internal certStamp string    = ""
		internal keyStamp  string    = ""
		internal checkedAt time.Time

		def new(certFile string, keyFile string) {
			self.certFile = certFile
			self.keyFile = keyFile
			checkedAt = time.now()
		}

		// keyPair is the pair to present now, read again when the files
		// changed since the last look. Fails only while no pair was ever
		// loaded: as loadKeyPair does.
		atomic def keyPair() !KeyPair {
			let loaded = pair
			return loaded when !(loaded is none) && checkEvery > 0s && time.since(checkedAt) < checkEvery
			checkedAt = time.now()
			let certNow = stamp(certFile)
			let keyNow = stamp(keyFile)
			return loaded when !(loaded is none) && certNow == certStamp && keyNow == keyStamp
			let failure ?error = none
			let fresh = tryLoad() onerror (err error) {
				failure = err
				recover none
			}
			lastError = failure
			if fresh is none {
				fail failure when loaded is none && !(failure is none)
				fail tlsError(Alert.InternalError, "no key pair loaded from {certFile}") when loaded is none
				return loaded
			}
			loads++
			certStamp = certNow
			keyStamp = keyNow
			pair = fresh
			return fresh
		}

		// getter is `keyPair` in the shape of `Config.getCertificate`.
		def getter() CertificateGetter {
			let source = self
			return def (info ClientHelloInfo) !?KeyPair {
				return try source.keyPair()
			}
		}

		// tryLoad is loadKeyPair as an optional, so a failure can recover
		// to none.
		internal def tryLoad() !?KeyPair {
			return try loadKeyPair(certFile, keyFile)
		}

		// stamp is a file's size and modification time as text, "" for a
		// file that cannot be looked at.
		internal def stamp(path string) string {
			let failed = false
			let info = os.stat(path) onerror (err error) {
				failed = true
				recover os.FileInfo{}
			}
			return "" when failed
			return "{info.size}@{info.modTime.unixNs()}"
		}
	}

	// watchKeyPair loads the pair of the two PEM files and keeps it current
	// afterwards. Fails as loadKeyPair does.
	def watchKeyPair(certFile string, keyFile string) !KeyPairFile {
		let files = new KeyPairFile(certFile, keyFile)
		try files.keyPair()
		return files
	}
}
