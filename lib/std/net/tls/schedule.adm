partial module std.net.tls {
	use std.crypto.hash::(Hash, hashSize, digest, hkdfExtract, hkdfExpand, hmac)

	// The label prefix of HKDF-Expand-Label under TLS 1.3 (RFC 8446 §7.1).
	const labelTLS13 = "tls13 "
	// The prefix under DTLS 1.3 (RFC 9147 §5.9): no trailing space, so a
	// label still fits one hash block.
	const labelDTLS13 = "dtls13"

	// hkdfExpandLabel is HKDF-Expand-Label of RFC 8446 §7.1: HKDF-Expand
	// with the label after the prefix ("tls13 ", or "dtls13" for DTLS 1.3)
	// and the context, both length prefixed, in the info. Fails when
	// length exceeds 255 digests.
	def hkdfExpandLabel(hash Hash, secret byte[], label string, context byte[], length int, prefix string = labelTLS13) !byte[] {
		let name = (prefix + label).bytes()
		let info = byte[byte(length >> 8), byte(length & 0xFF), byte(name.len())] + name + byte[byte(context.len())] + context
		return try hkdfExpand(hash, secret, info, length)
	}

	// deriveSecret is Derive-Secret of RFC 8446 §7.1: an expansion to one
	// digest with a transcript hash as the context. Fails only when HKDF
	// does, as every derivation below.
	def deriveSecret(hash Hash, secret byte[], label string, transcriptHash byte[], prefix string = labelTLS13) !byte[] {
		return try hkdfExpandLabel(hash, secret, label, transcriptHash, hashSize(hash), prefix)
	}

	// trafficKeys derives the AEAD key and 12-byte IV of a traffic secret
	// (RFC 8446 §7.3). Fails when HKDF does.
	def trafficKeys(hash Hash, secret byte[], keySize int, prefix string = labelTLS13) !(byte[], byte[]) {
		let key = try hkdfExpandLabel(hash, secret, "key", [], keySize, prefix)
		let iv = try hkdfExpandLabel(hash, secret, "iv", [], 12, prefix)
		return (key, iv)
	}

	// nextTrafficSecret is the secret after a KeyUpdate (RFC 8446 §7.2).
	// Fails when HKDF does.
	def nextTrafficSecret(hash Hash, secret byte[], prefix string = labelTLS13) !byte[] {
		return try hkdfExpandLabel(hash, secret, "traffic upd", [], hashSize(hash), prefix)
	}

	// finishedKey is the HMAC key of a Finished message (RFC 8446 §4.4.4).
	// Fails when HKDF does.
	def finishedKey(hash Hash, trafficSecret byte[], prefix string = labelTLS13) !byte[] {
		return try hkdfExpandLabel(hash, trafficSecret, "finished", [], hashSize(hash), prefix)
	}

	// resumptionPSK is the pre-shared key a session ticket stands for
	// (RFC 8446 §4.6.1): the resumption master secret expanded with the
	// ticket nonce. Fails when HKDF does.
	def resumptionPSK(hash Hash, resumptionMaster, nonce byte[], prefix string = labelTLS13) !byte[] {
		return try hkdfExpandLabel(hash, resumptionMaster, "resumption", nonce, hashSize(hash), prefix)
	}

	// pskBinder is the binder of a pre-shared key offer (RFC 8446 §4.2.11.2):
	// the Finished-style MAC under the binder key of the early secret the
	// PSK extracts, over the transcript hash of the ClientHello up to the
	// binders list. Fails when HKDF does.
	def pskBinder(hash Hash, psk, transcriptHash byte[], prefix string = labelTLS13) !byte[] {
		let early = hkdfExtract(hash, [], psk)
		let binderKey = try deriveSecret(hash, early, "res binder", digest(hash, []), prefix)
		return hmac(hash, try finishedKey(hash, binderKey, prefix), transcriptHash)
	}

	// exportKeying is the keying material both ends of a connection, and
	// nobody else, can compute for a label and context: RFC 5705 when
	// `randoms12` holds the two randoms of a (D)TLS 1.2 handshake and
	// `secret` its master secret (a context of none differs from an empty
	// one there), RFC 8446 §7.5 from the exporter master secret otherwise.
	// Fails when HKDF does.
	internal def exportKeying(hash Hash, secret byte[], randoms12 byte[], label string, context ?byte[], length int, prefix string = labelTLS13) !byte[] {
		if randoms12.len() > 0 {
			let seed = randoms12
			seed = seed + [byte(context.len() >> 8), byte(context.len())] + context unless (context is none)
			return prf(hash, secret, label, seed, length)
		}
		let derived = try deriveSecret(hash, secret, label, digest(hash, []), prefix)
		return try hkdfExpandLabel(hash, derived, "exporter", digest(hash, context is none ?? (byte[], context)), length, prefix)
	}

	// TranscriptFramer gives the form a DTLS 1.2 handshake message takes in
	// the transcript (RFC 6347 §4.2.6): its 12-byte DTLS header, with the
	// message_seq it was sent or received with and as one fragment.
	interface TranscriptFramer {
		// The messages of `messages` (TLS framing, one or more) in
		// DTLS 1.2 framing.
		def datagramForm(messages byte[]) byte[]
	}

	// KeySchedule is the TLS 1.3 key schedule of RFC 8446 §7.1 for one
	// connection: the running transcript and every secret derived from the
	// early, handshake and master secrets. Feed each handshake message with
	// `update` in order and call the derive steps at the points the protocol
	// reaches them.
	type KeySchedule {
		hash                         Hash
		transcript                   byte[]
		// The HKDF-Expand-Label prefix: "dtls13" over DTLS 1.3.
		labelPrefix                  string            = labelTLS13
		// Over DTLS, the framer gives each message's DTLS 1.2 form, kept
		// beside the TLS form until the version is known; once DTLS 1.2
		// is (`useDatagramTranscript`), that form is the transcript.
		framer                       ?TranscriptFramer = none
		datagramTranscript           byte[]            = []
		datagramForm                 bool              = false
		earlySecret                  byte[]
		handshakeSecret              byte[]
		masterSecret                 byte[]
		clientHandshakeTrafficSecret byte[]
		serverHandshakeTrafficSecret byte[]
		clientTrafficSecret          byte[]
		serverTrafficSecret          byte[]
		exporterMasterSecret         byte[]
		resumptionMasterSecret       byte[]

		def new(hash Hash) {
			self.hash = hash
		}

		// update appends a handshake message (header included) to the
		// transcript.
		def update(message byte[]) {
			let dtls = framer
			if dtls is none {
				transcript = transcript + message
				return
			}
			let framed = dtls.datagramForm(message)
			if datagramForm {
				transcript = transcript + framed
				return
			}
			transcript = transcript + message
			datagramTranscript = datagramTranscript + framed
		}

		// useDatagramTranscript makes the DTLS 1.2 form the transcript, once
		// a DTLS handshake turns out to be DTLS 1.2.
		def useDatagramTranscript() {
			return when framer is none || datagramForm
			transcript = datagramTranscript
			datagramTranscript = []
			datagramForm = true
		}

		// useTLSTranscript drops the DTLS 1.2 form once DTLS 1.3 is agreed:
		// its transcript holds the messages in TLS framing (RFC 9147 §5.2).
		def useTLSTranscript() {
			framer = none
			datagramTranscript = []
		}

		// restart empties the transcript: a DTLS 1.2 HelloVerifyRequest
		// leaves the first ClientHello and itself out of it (RFC 6347
		// §4.2.1).
		def restart() {
			transcript = []
			datagramTranscript = []
		}

		// transcriptHash is the digest of every message fed so far.
		def transcriptHash() byte[] {
			return digest(hash, transcript)
		}

		// replaceWithMessageHash implements the HelloRetryRequest rule of
		// RFC 8446 §4.4.1: the first ClientHello is replaced in the
		// transcript by a synthetic message_hash message over its hash.
		def replaceWithMessageHash() {
			let sum = transcriptHash()
			transcript = byte[254, 0, 0, byte(sum.len())] + sum
		}

		// deriveEarly extracts the early secret from a pre-shared key, or
		// from zeros when there is none.
		def deriveEarly(psk byte[] = []) {
			let ikm = psk
			ikm.len(hashSize(hash)) when ikm.len() == 0
			earlySecret = hkdfExtract(hash, [], ikm)
		}

		// deriveHandshake extracts the handshake secret from the (EC)DHE
		// shared secret and derives both handshake traffic secrets over the
		// transcript through ServerHello. Fails only when HKDF does.
		def deriveHandshake(sharedSecret byte[]) !none {
			let derived = try deriveSecret(hash, earlySecret, "derived", emptyHash(), labelPrefix)
			handshakeSecret = hkdfExtract(hash, derived, sharedSecret)
			let sum = transcriptHash()
			clientHandshakeTrafficSecret = try deriveSecret(hash, handshakeSecret, "c hs traffic", sum, labelPrefix)
			serverHandshakeTrafficSecret = try deriveSecret(hash, handshakeSecret, "s hs traffic", sum, labelPrefix)
			return none
		}

		// deriveMaster extracts the master secret and derives the
		// application traffic and exporter secrets over the transcript
		// through the server Finished. Fails only when HKDF does.
		def deriveMaster() !none {
			let derived = try deriveSecret(hash, handshakeSecret, "derived", emptyHash(), labelPrefix)
			let zeros byte[]
			zeros.len(hashSize(hash))
			masterSecret = hkdfExtract(hash, derived, zeros)
			let sum = transcriptHash()
			clientTrafficSecret = try deriveSecret(hash, masterSecret, "c ap traffic", sum, labelPrefix)
			serverTrafficSecret = try deriveSecret(hash, masterSecret, "s ap traffic", sum, labelPrefix)
			exporterMasterSecret = try deriveSecret(hash, masterSecret, "exp master", sum, labelPrefix)
			return none
		}

		// deriveResumption derives the resumption master secret over the
		// transcript through the client Finished. Fails only when HKDF does.
		def deriveResumption() !none {
			resumptionMasterSecret = try deriveSecret(hash, masterSecret, "res master", transcriptHash(), labelPrefix)
			return none
		}

		// verifyData is the Finished MAC of one side over the transcript so
		// far, keyed from its handshake traffic secret. Fails when HKDF does.
		def verifyData(trafficSecret byte[]) !byte[] {
			return hmac(hash, try finishedKey(hash, trafficSecret, labelPrefix), transcriptHash())
		}

		internal def emptyHash() byte[] {
			return digest(hash, [])
		}
	}
}
