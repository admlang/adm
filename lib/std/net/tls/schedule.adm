partial module std.net.tls {
	use std.crypto.hash::(Hash, hashSize, digest, hkdfExtract, hkdfExpand, hmac)

	// hkdfExpandLabel is HKDF-Expand-Label of RFC 8446 §7.1: HKDF-Expand
	// with the label prefixed by "tls13 " and the context, both length
	// prefixed, in the info. Fails when length exceeds 255 digests.
	def hkdfExpandLabel(hash Hash, secret byte[], label string, context byte[], length int) !byte[] {
		let name = ("tls13 " + label).bytes()
		let info = byte[byte(length >> 8), byte(length & 0xFF), byte(name.len())] + name + byte[byte(context.len())] + context
		return try hkdfExpand(hash, secret, info, length)
	}

	// deriveSecret is Derive-Secret of RFC 8446 §7.1: an expansion to one
	// digest with a transcript hash as the context. Fails only when HKDF
	// does, as every derivation below.
	def deriveSecret(hash Hash, secret byte[], label string, transcriptHash byte[]) !byte[] {
		return try hkdfExpandLabel(hash, secret, label, transcriptHash, hashSize(hash))
	}

	// trafficKeys derives the AEAD key and 12-byte IV of a traffic secret
	// (RFC 8446 §7.3). Fails when HKDF does.
	def trafficKeys(hash Hash, secret byte[], keySize int) !(byte[], byte[]) {
		let key = try hkdfExpandLabel(hash, secret, "key", [], keySize)
		let iv = try hkdfExpandLabel(hash, secret, "iv", [], 12)
		return (key, iv)
	}

	// nextTrafficSecret is the secret after a KeyUpdate (RFC 8446 §7.2).
	// Fails when HKDF does.
	def nextTrafficSecret(hash Hash, secret byte[]) !byte[] {
		return try hkdfExpandLabel(hash, secret, "traffic upd", [], hashSize(hash))
	}

	// finishedKey is the HMAC key of a Finished message (RFC 8446 §4.4.4).
	// Fails when HKDF does.
	def finishedKey(hash Hash, trafficSecret byte[]) !byte[] {
		return try hkdfExpandLabel(hash, trafficSecret, "finished", [], hashSize(hash))
	}

	// resumptionPSK is the pre-shared key a session ticket stands for
	// (RFC 8446 §4.6.1): the resumption master secret expanded with the
	// ticket nonce. Fails when HKDF does.
	def resumptionPSK(hash Hash, resumptionMaster, nonce byte[]) !byte[] {
		return try hkdfExpandLabel(hash, resumptionMaster, "resumption", nonce, hashSize(hash))
	}

	// pskBinder is the binder of a pre-shared key offer (RFC 8446 §4.2.11.2):
	// the Finished-style MAC under the binder key of the early secret the
	// PSK extracts, over the transcript hash of the ClientHello up to the
	// binders list. Fails when HKDF does.
	def pskBinder(hash Hash, psk, transcriptHash byte[]) !byte[] {
		let early = hkdfExtract(hash, [], psk)
		let binderKey = try deriveSecret(hash, early, "res binder", digest(hash, []))
		return hmac(hash, try finishedKey(hash, binderKey), transcriptHash)
	}

	// KeySchedule is the TLS 1.3 key schedule of RFC 8446 §7.1 for one
	// connection: the running transcript and every secret derived from the
	// early, handshake and master secrets. Feed each handshake message with
	// `update` in order and call the derive steps at the points the protocol
	// reaches them.
	type KeySchedule {
		hash                         Hash
		transcript                   byte[]
		earlySecret                  byte[]
		handshakeSecret              byte[]
		masterSecret                 byte[]
		clientHandshakeTrafficSecret byte[]
		serverHandshakeTrafficSecret byte[]
		clientTrafficSecret          byte[]
		serverTrafficSecret          byte[]
		exporterMasterSecret         byte[]
		resumptionMasterSecret       byte[]

		def new(hash Hash) {
			self.hash = hash
		}

		// update appends a handshake message (header included) to the
		// transcript.
		def update(message byte[]) {
			transcript = transcript + message
		}

		// transcriptHash is the digest of every message fed so far.
		def transcriptHash() byte[] {
			return digest(hash, transcript)
		}

		// replaceWithMessageHash implements the HelloRetryRequest rule of
		// RFC 8446 §4.4.1: the first ClientHello is replaced in the
		// transcript by a synthetic message_hash message over its hash.
		def replaceWithMessageHash() {
			let sum = transcriptHash()
			transcript = byte[254, 0, 0, byte(sum.len())] + sum
		}

		// deriveEarly extracts the early secret from a pre-shared key, or
		// from zeros when there is none.
		def deriveEarly(psk byte[] = []) {
			let ikm = psk
			ikm.len(hashSize(hash)) when ikm.len() == 0
			earlySecret = hkdfExtract(hash, [], ikm)
		}

		// deriveHandshake extracts the handshake secret from the (EC)DHE
		// shared secret and derives both handshake traffic secrets over the
		// transcript through ServerHello. Fails only when HKDF does.
		def deriveHandshake(sharedSecret byte[]) !none {
			let derived = try deriveSecret(hash, earlySecret, "derived", emptyHash())
			handshakeSecret = hkdfExtract(hash, derived, sharedSecret)
			let sum = transcriptHash()
			clientHandshakeTrafficSecret = try deriveSecret(hash, handshakeSecret, "c hs traffic", sum)
			serverHandshakeTrafficSecret = try deriveSecret(hash, handshakeSecret, "s hs traffic", sum)
			return none
		}

		// deriveMaster extracts the master secret and derives the
		// application traffic and exporter secrets over the transcript
		// through the server Finished. Fails only when HKDF does.
		def deriveMaster() !none {
			let derived = try deriveSecret(hash, handshakeSecret, "derived", emptyHash())
			let zeros byte[]
			zeros.len(hashSize(hash))
			masterSecret = hkdfExtract(hash, derived, zeros)
			let sum = transcriptHash()
			clientTrafficSecret = try deriveSecret(hash, masterSecret, "c ap traffic", sum)
			serverTrafficSecret = try deriveSecret(hash, masterSecret, "s ap traffic", sum)
			exporterMasterSecret = try deriveSecret(hash, masterSecret, "exp master", sum)
			return none
		}

		// deriveResumption derives the resumption master secret over the
		// transcript through the client Finished. Fails only when HKDF does.
		def deriveResumption() !none {
			resumptionMasterSecret = try deriveSecret(hash, masterSecret, "res master", transcriptHash())
			return none
		}

		// verifyData is the Finished MAC of one side over the transcript so
		// far, keyed from its handshake traffic secret. Fails when HKDF does.
		def verifyData(trafficSecret byte[]) !byte[] {
			return hmac(hash, try finishedKey(hash, trafficSecret), transcriptHash())
		}

		internal def emptyHash() byte[] {
			return digest(hash, [])
		}
	}
}
