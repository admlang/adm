partial module std.net.tls {
	use (
		std.crypto
		std.crypto::(PrivateKey, PublicKey, RSAPrivateKey, ECDSAPrivateKey, RSAPublicKey, ECDSAPublicKey, ECDHKeyPair, rand, x25519, x25519Base, ecdhKeyPair, ecdh, marshalPoint, unmarshalPoint, scalarBaseMult, p256, p384, constantTimeEqual, parsePKCS8PrivateKey, parsePKCS1PrivateKey, parseECPrivateKey)
		std.crypto.hash::(Hash, hashSize, digest)
		std.crypto.cipher::(AEAD, newAES, newGCM)
		std.crypto.x509::(Certificate, CertPool, VerifyOptions, ExtKeyUsage, parseCertificate)
		std.data.encoding::(hexdecode, pemDecodeAll)
		std.os
		std.time
	)

	// KeyPair is what a side presents: its certificate chain, leaf first as
	// DER, the leaf's private key, and the parsed leaf, which picks a chain
	// by server name and verifies what the key signed.
	type KeyPair {
		chain      byte[][]
		privateKey ?PrivateKey
		leaf       ?Certificate

		def new(chain byte[][], privateKey ?PrivateKey = none, leaf ?Certificate = none) {
			self.chain = chain
			self.privateKey = privateKey
			self.leaf = leaf
		}

		// sign signs content with the private key, hashed as the scheme
		// says: RSA-PSS with a salt as long as the hash, RSA PKCS#1 v1.5, or
		// ECDSA as DER. Without a scheme the key's preferred one signs:
		// RSA-PSS over SHA-256 for an RSA key, the hash of its curve for an
		// ECDSA key. Fails when there is no private key, the scheme does not
		// fit the key or has no hash, or signing does.
		def sign(content byte[], scheme ?SignatureScheme = none) !byte[] {
			let key = privateKey
			fail tlsError(Alert.InternalError, "certificate has no private key") when key is none
			let chosen = scheme
			if chosen is none {
				let preferred = preferredSchemes(key)
				fail tlsError(Alert.InternalError, "unsupported private key") when preferred.len() == 0
				return try sign(content, preferred[0])
			}
			let schemeDigest = schemeHash(chosen)
			fail tlsError(Alert.InternalError, "signature scheme {chosen} has no hash") when schemeDigest is none
			let sum = digest(schemeDigest, content)
			if key is RSAPrivateKey {
				let rsa RSAPrivateKey = key
				return try rsa.signPKCS1v15(schemeDigest, sum) when isPKCS1Scheme(chosen)
				fail tlsError(Alert.InternalError, "RSA key with signature scheme {chosen}") unless isPSSScheme(chosen)
				return try rsa.signPSS(schemeDigest, sum)
			}
			if key is ECDSAPrivateKey {
				let ec ECDSAPrivateKey = key
				fail tlsError(Alert.InternalError, "ECDSA key with signature scheme {chosen}") unless isECDSAScheme(chosen)
				return try ec.signASN1(sum)
			}
			fail tlsError(Alert.InternalError, "unsupported private key")
		}

		// verify checks a signature over content with the public key of
		// the leaf, hashed as the scheme says; without a scheme, the one
		// `sign` prefers for the key. Fails with TLSError: InternalError
		// without a leaf, UnsupportedCertificate for a key type this module
		// does not verify, IllegalParameter for a scheme that does not fit
		// the key, DecodeError for an ECDSA signature that is not DER,
		// DecryptError when the signature does not verify.
		def verify(content byte[], signature byte[], scheme ?SignatureScheme = none) !none {
			let cert = leaf
			fail tlsError(Alert.InternalError, "key pair has no parsed leaf") when cert is none
			let key = cert.publicKey
			fail tlsError(Alert.UnsupportedCertificate, "certificate key type is not supported") when key is none
			let chosen = scheme
			return try verifySignature(key, content, signature, preferredSchemeOf(key)) when chosen is none
			return try verifySignature(key, content, signature, chosen)
		}
	}

	// ClientHelloInfo is what a ClientHello offers, for `getCertificate`:
	// the server name, the ALPN protocols, the suites this module
	// implements among those offered, the signature schemes and the key
	// exchange groups as wire codes.
	struct ClientHelloInfo {
		serverName       string
		alpnProtocols    string[]
		cipherSuites     CipherSuite[]
		signatureSchemes int[]
		supportedGroups  int[]
	}

	// parseKeyPair reads a PEM certificate chain, leaf first, and a PEM
	// private key: PKCS#8 ("PRIVATE KEY"), PKCS#1 ("RSA PRIVATE KEY") or
	// SEC 1 ("EC PRIVATE KEY"). Fails when either does not parse, the chain
	// has no certificate, the key has no block this module reads, or the
	// key does not match the leaf's public key.
	def parseKeyPair(certPEM string, keyPEM string) !KeyPair {
		let chain byte[][]
		for let (_, block) in try pemDecodeAll(certPEM) {
			chain.push(block.bytes) when block.kind == "CERTIFICATE"
		}
		fail tlsError(Alert.InternalError, "no CERTIFICATE block in the chain") when chain.len() == 0
		let key ?PrivateKey = none
		for let (_, block) in try pemDecodeAll(keyPEM) {
			continue unless key is none
			switch {
				case block.kind == "PRIVATE KEY":
					key = try parsePKCS8PrivateKey(block.bytes)
				case block.kind == "RSA PRIVATE KEY":
					key = try parsePKCS1PrivateKey(block.bytes)
				case block.kind == "EC PRIVATE KEY":
					key = try parseECPrivateKey(block.bytes)
			}
		}
		fail tlsError(Alert.InternalError, "no private key block") when key is none
		let leaf = try parseCertificate(chain[0])
		fail tlsError(Alert.InternalError, "private key does not match the certificate") unless keyMatches(key, leaf.publicKey)
		return new KeyPair(chain, key, leaf)
	}

	// loadKeyPair reads the PEM chain and key from files. Fails as
	// parseKeyPair does, or with the error of a file that cannot be read.
	def loadKeyPair(certFile string, keyFile string) !KeyPair {
		let cert = try os.readFile(certFile)
		let key = try os.readFile(keyFile)
		return try parseKeyPair(string(cert), string(key))
	}

	// keyMatches reports whether a private key belongs to a public key.
	internal def keyMatches(key PrivateKey, public ?PublicKey) bool {
		return false when public is none
		if key is RSAPrivateKey {
			let rsa RSAPrivateKey = key
			return false unless public is RSAPublicKey
			let pub RSAPublicKey = public
			return pub.n == rsa.n && pub.e == rsa.e
		}
		if key is ECDSAPrivateKey {
			let ec ECDSAPrivateKey = key
			return false unless public is ECDSAPublicKey
			let pub ECDSAPublicKey = public
			return pub.curve.name == ec.curve.name && pub.point.x == ec.point.x && pub.point.y == ec.point.y
		}
		return false
	}

	// sessionTicketLifetime is how long a ticket may be used, in seconds:
	// the seven-day cap of RFC 8446 §4.6.1.
	const sessionTicketLifetime = 7 * 24 * 3600

	// ticketAEAD is the cipher a server seals its tickets under. Fails when
	// the key is not 16, 24 or 32 bytes.
	internal def ticketAEAD(key byte[]) !AEAD {
		return try newGCM(try newAES(key), 12, 16)
	}

	// sealTicket encrypts a resumable session: the suite, the pre-shared
	// key, the ALPN protocol and the issue time in Unix seconds, under a
	// fresh nonce that leads the ticket. Fails when the key does not fit
	// the cipher or the random source is unavailable.
	internal def sealTicket(key byte[], suite CipherSuite, psk byte[], alpn string, issued int) !byte[] {
		let aead = try ticketAEAD(key)
		let nonce = try rand(12)
		let plain = u16(int(suite)) + vec8(psk) + vec8(alpn.bytes()) + u32(issued)
		return nonce + aead.seal(nonce, plain, [])
	}

	// openTicket decrypts a ticket sealed here into (suite, pre-shared key,
	// ALPN protocol, issue time). Fails when the ticket was sealed under
	// another key or is malformed.
	internal def openTicket(key byte[], ticket byte[]) !(CipherSuite, byte[], string, int) {
		fail tlsError(Alert.DecodeError, "ticket of {ticket.len()} bytes") when ticket.len() < 12
		let aead = try ticketAEAD(key)
		let plain = try aead.open(ticket[0:12], ticket[12:], [])
		let c = new Cursor(plain)
		let code = try c.u16()
		let suite = cipherSuiteOf(code)
		fail tlsError(Alert.DecodeError, "ticket names cipher suite {code}") when suite is none
		let psk = try c.vec8()
		let alpn = string(try c.vec8())
		let issued = try c.u32()
		return (suite, psk, alpn, issued)
	}

	// unixSeconds is the current time in seconds since the Unix epoch.
	internal def unixSeconds() int {
		return int(time.now().unixNs() / 1000000000)
	}

	// ServerHandshake runs the TLS 1.3 server handshake of RFC 8446 §2 over
	// a record layer: ClientHello, a HelloRetryRequest when the client
	// shared no key for the group taken, ServerHello, the encrypted flight
	// with the chain and the signature over the transcript, Finished both
	// ways, then a session ticket. `run` leaves the record layer keyed for
	// application data and the traffic secrets in `schedule`. A client
	// without TLS 1.3 gets the TLS 1.2 handshake of RFC 5246 §7.3 when the
	// config's `minVersion` allows it: ECDHE with an AEAD suite and the
	// extended master secret, resumed from the same stateless tickets
	// (RFC 5077) when the config has a ticket key.
	type ServerHandshake {
		config               Config
		records              RecordLayer
		reader               HandshakeReader
		schedule             KeySchedule
		hello                ClientHello
		helloBytes           byte[]
		suite                CipherSuite       = CipherSuite.AES128GCMSHA256
		hash                 Hash              = Hash.SHA256
		state                ConnectionState
		keyPair              ?KeyPair
		// The scheme this side signs with, and the group of the key
		// exchange as a wire code.
		scheme               ?SignatureScheme
		group                int               = 0
		// Whether a CertificateRequest was sent.
		certificateRequested bool              = false
		// The pre-shared key accepted, and which offer it was.
		psk                  byte[]
		resumed              bool              = false
		selectedIdentity     int               = -1
		// Whether TLS 1.2 was negotiated, and the master secret of the
		// ticket it resumes from, empty for a full handshake.
		version12            bool              = false
		resumedMaster        byte[]
		// For a test: fixed values instead of random ones.
		random               byte[]
		x25519Private        byte[]
		ecdheScalar          ?bigint
		// The ticket sent after the handshake, none when none was.
		ticket               ?NewSessionTicket

		def new(config Config, records RecordLayer) {
			self.config = config
			self.records = records
			reader = new HandshakeReader(records)
			schedule = new KeySchedule(Hash.SHA256)
		}

		// run performs the whole handshake. Fails with TLSError naming the
		// alert to send, NetError from the transport.
		def run() !none {
			try readClientHello()
			return try run12() when version12
			try sendServerFlight()
			try readClientFinished()
			try sendTicket()
			return none
		}

		// readClientHello reads the first flight, negotiates, runs the
		// HelloRetryRequest round when the client shared no key for the
		// group taken, and accepts a pre-shared key offer the ticket key
		// opens. Leaves the transcript through the ClientHello the
		// ServerHello answers.
		def readClientHello() !none {
			let (kind, body, raw) = try reader.next()
			fail tlsError(Alert.UnexpectedMessage, "expected ClientHello, got message {kind}") when kind != handshakeClientHello
			hello = try parseClientHello(body)
			helloBytes = raw
			records.version = 0x0303
			try negotiate()
			schedule.hash = hash
			if version12 {
				schedule.update(helloBytes)
				return none
			}
			try helloRetry() when shareFor(group) is none
			try checkPSK()
			schedule.update(helloBytes)
			return none
		}

		// negotiate picks the version, suite, ALPN protocol, group,
		// certificate and signature scheme from what the client offers.
		internal def negotiate() !none {
			fail tlsError(Alert.InternalError, "minVersion is above maxVersion") when config.minVersion == Version.TLS13 && config.maxVersion == Version.TLS12
			if config.maxVersion == Version.TLS12 || !hello.supportedVersions.includes(0x0304) {
				let offers12 = hello.supportedVersions.len() == 0 || hello.supportedVersions.includes(0x0303)
				fail tlsError(Alert.ProtocolVersion, "client does not offer TLS 1.3") when config.minVersion == Version.TLS13
				fail tlsError(Alert.ProtocolVersion, "no protocol version in common") unless offers12
				return try negotiate12()
			}
			let suites = config.cipherSuites
			suites = defaultCipherSuites() when suites.len() == 0
			let found = false
			for let (_, s) in suites {
				continue when found || !suiteIsTLS13(s)
				if hello.cipherSuites.includes(int(s)) {
					suite = s
					found = true
				}
			}
			fail tlsError(Alert.HandshakeFailure, "no cipher suite in common") unless found
			hash = suiteHash(suite)
			try negotiateALPNAndGroup()
			try selectCertificate()
			return none
		}

		// negotiateALPNAndGroup takes the first ALPN protocol of the config
		// the client offers, and the first group of `curvePreferences` it
		// supports.
		internal def negotiateALPNAndGroup() !none {
			state.alpn = ""
			if config.alpn.len() > 0 && hello.alpnProtocols.len() > 0 {
				for let (_, protocol) in config.alpn {
					continue when state.alpn != ""
					state.alpn = protocol when hello.alpnProtocols.includes(protocol)
				}
				fail tlsError(Alert.NoApplicationProtocol, "no application protocol in common") when state.alpn == ""
			}
			let curves = config.curvePreferences
			curves = defaultCurves() when curves.len() == 0
			group = 0
			for let (_, curve) in curves {
				continue when group != 0
				group = int(curve) when hello.supportedGroups.includes(int(curve))
			}
			fail tlsError(Alert.HandshakeFailure, "no key exchange group in common") when group == 0
			return none
		}

		// negotiate12 picks what a TLS 1.2 handshake needs: the ALPN
		// protocol and group as TLS 1.3 does, the certificate, the scheme
		// its key signs the key exchange with, and the first suite of the
		// config for that key the client offers. Refuses a client without
		// the extended master secret (RFC 7627 §5.3).
		internal def negotiate12() !none {
			version12 = true
			fail tlsError(Alert.HandshakeFailure, "client does not offer the extended master secret") unless hello.extendedMasterSecret
			try negotiateALPNAndGroup()
			return none when resumeFromTicket()
			let pair = try pickKeyPair()
			keyPair = pair
			let key = pair.privateKey
			fail tlsError(Alert.InternalError, "certificate has no private key") when key is none
			scheme = keyExchangeSchemeFor(key, hello.signatureAlgorithms)
			fail tlsError(Alert.HandshakeFailure, "client accepts no signature scheme for the server key") when scheme is none
			let signsWithRSA = key is RSAPrivateKey
			if key is ECDSAPrivateKey {
				// TLS 1.2 clients name the curves they verify signatures
				// on in supported_groups too (RFC 8422 §5.1.1).
				let ec ECDSAPrivateKey = key
				let curveGroup = ec.curve.name == "P-256" ?? (groupSecp256r1, groupSecp384r1)
				fail tlsError(Alert.HandshakeFailure, "client does not support the curve of the server key") unless hello.supportedGroups.includes(curveGroup)
			}
			let suites = config.cipherSuites
			suites = defaultTLS12CipherSuites() when suites.len() == 0
			let found = false
			for let (_, s) in suites {
				continue when found || suiteIsTLS13(s) || suiteSignsWithRSA(s) != signsWithRSA
				if hello.cipherSuites.includes(int(s)) {
					suite = s
					found = true
				}
			}
			fail tlsError(Alert.HandshakeFailure, "no cipher suite in common") unless found
			hash = suiteHash(suite)
			return none
		}

		// shareFor is the client's key share for a group, none when it sent
		// none.
		internal def shareFor(wanted int) ?KeyShare {
			for let (_, share) in hello.keyShares {
				return share when share.group == wanted
			}
			return none
		}

		// offeredSuites is the suites this module implements among those
		// the client offers, in the client's order.
		internal def offeredSuites() CipherSuite[] {
			let out CipherSuite[]
			for let (_, code) in hello.cipherSuites {
				let suite = cipherSuiteOf(code)
				out.push(suite) unless suite is none
			}
			return out
		}

		// selectCertificate picks the chain to present, through
		// `getCertificate` when set, else the first of `certificates` whose
		// leaf matches the server name, else the first, and the signature
		// scheme its key signs with among those the client accepts.
		internal def selectCertificate() !none {
			let pick = try pickKeyPair()
			keyPair = pick
			let key = pick.privateKey
			fail tlsError(Alert.InternalError, "certificate has no private key") when key is none
			scheme = signatureSchemeFor(key, hello.signatureAlgorithms)
			fail tlsError(Alert.HandshakeFailure, "client accepts no signature scheme for the server key") when scheme is none
			return none
		}

		// resumeFromTicket takes the session of the ticket a TLS 1.2 client
		// offers (RFC 5077 §3.1) when the ticket key opens it: a TLS 1.2
		// suite the client and the config still allow, issued within the
		// ticket lifetime. Client certificates are not kept in a ticket, so
		// a server that asks for them runs the full handshake.
		internal def resumeFromTicket() bool {
			return false when config.sessionTicketKey.len() == 0 || hello.sessionTicket.len() == 0 || hello.sessionID.len() == 0
			return false when config.clientAuth != ClientAuthType.NoClientCert
			let (ticketSuite, master, _, issued) = openTicket(config.sessionTicketKey, hello.sessionTicket) onerror recover (suite, [], "", 0)
			return false when master.len() != masterSecretSize || suiteIsTLS13(ticketSuite)
			return false unless hello.cipherSuites.includes(int(ticketSuite))
			return false when config.cipherSuites.len() > 0 && !config.cipherSuites.includes(ticketSuite)
			let now = unixSeconds()
			return false when now < issued || now - issued > sessionTicketLifetime
			suite = ticketSuite
			hash = suiteHash(suite)
			resumedMaster = master
			resumed = true
			state.resumed = true
			return true
		}

		// pickKeyPair is the chain to present: through `getCertificate`
		// when set, else the first of `certificates` whose leaf matches the
		// server name, else the first. Fails when the config has none.
		internal def pickKeyPair() !KeyPair {
			let info = ClientHelloInfo{serverName: hello.serverName, alpnProtocols: hello.alpnProtocols, cipherSuites: offeredSuites(), signatureSchemes: hello.signatureAlgorithms, supportedGroups: hello.supportedGroups}
			let pick ?KeyPair = none
			let getter = config.getCertificate
			pick = try getter(info) unless getter is none
			if pick is none {
				for let (_, pair) in config.certificates {
					continue unless pick is none
					let leaf = pair.leaf
					continue when leaf is none
					let matches = true
					leaf.verifyHostname(hello.serverName) onerror (err error) {
						matches = false
						recover none
					}
					pick = pair when matches
				}
			}
			pick = config.certificates[0] when pick is none && config.certificates.len() > 0
			fail tlsError(Alert.InternalError, "no certificate configured") when pick is none
			return pick
		}

		// helloRetry sends a HelloRetryRequest for the group taken and reads
		// the second ClientHello, which must keep the suite, session id and
		// server name and now share a key for the group (RFC 8446 §4.1.4).
		internal def helloRetry() !none {
			fail tlsError(Alert.IllegalParameter, "second ClientHello shares no key for group {group}") when hello.cookie.len() > 0
			let retryRandom = hexdecode(helloRetryRequestRandom) onerror recover []
			let retry = ServerHello{random: retryRandom, sessionID: hello.sessionID, cipherSuite: int(suite), supportedVersion: 0x0304, selectedGroup: group, isHelloRetryRequest: true}
			let retryBytes = marshalServerHello(retry)
			schedule.update(helloBytes)
			schedule.replaceWithMessageHash()
			schedule.update(retryBytes)
			try records.write(recordHandshake, retryBytes)
			try records.write(recordChangeCipherSpec, byte[1]) when hello.sessionID.len() > 0
			let (kind, body, raw) = try reader.next()
			fail tlsError(Alert.UnexpectedMessage, "expected the second ClientHello, got message {kind}") when kind != handshakeClientHello
			let second = try parseClientHello(body)
			fail tlsError(Alert.IllegalParameter, "second ClientHello drops the cipher suite") unless second.cipherSuites.includes(int(suite))
			fail tlsError(Alert.IllegalParameter, "second ClientHello changes the session id") when second.sessionID.hex() != hello.sessionID.hex()
			fail tlsError(Alert.IllegalParameter, "second ClientHello changes the server name") when second.serverName != hello.serverName
			hello = second
			helloBytes = raw
			fail tlsError(Alert.IllegalParameter, "second ClientHello shares no key for group {group}") when shareFor(group) is none
			return none
		}

		// checkPSK accepts the first pre-shared key offer whose ticket the
		// ticket key opens, when it fits the suite and is not stale, after
		// checking its binder (RFC 8446 §4.2.11). A binder that does not
		// verify is fatal; a ticket that does not open is skipped.
		internal def checkPSK() !none {
			psk = []
			resumed = false
			selectedIdentity = -1
			return none when config.sessionTicketKey.len() == 0 || hello.pskIdentities.len() == 0
			return none unless hello.pskModes.includes(pskModeDHE)
			fail tlsError(Alert.IllegalParameter, "{hello.pskIdentities.len()} pre-shared key identities with {hello.pskBinders.len()} binders") when hello.pskBinders.len() != hello.pskIdentities.len()
			let now = unixSeconds()
			for let (i, identity) in hello.pskIdentities {
				continue when resumed
				let (ticketSuite, ticketPSK, ticketALPN, issued) = openTicket(config.sessionTicketKey, identity.identity) onerror recover (suite, [], "", 0)
				continue when ticketPSK.len() == 0 || !suiteIsTLS13(ticketSuite)
				continue when suiteHash(ticketSuite) != hash
				continue when now < issued || now - issued > sessionTicketLifetime
				let cut = helloBytes.len() - clientHelloBindersLength(hello)
				let sum = digest(hash, schedule.transcript + helloBytes[0:cut])
				let expected = try pskBinder(hash, ticketPSK, sum)
				fail tlsError(Alert.DecryptError, "pre-shared key binder does not verify") unless constantTimeEqual(expected, hello.pskBinders[i])
				psk = ticketPSK
				resumed = true
				selectedIdentity = i
				state.resumed = true
			}
			return none
		}

		// sendServerFlight completes the key exchange, sends ServerHello,
		// then EncryptedExtensions, the chain and CertificateVerify (unless
		// resumed) and Finished under the handshake keys, and keys this
		// side's application data.
		def sendServerFlight() !none {
			let share = shareFor(group)
			fail tlsError(Alert.InternalError, "no key share for group {group}") when share is none
			let (mine, shared) = try keyExchange(share)
			random = try rand(32) when random.len() == 0
			let sh = ServerHello{random: random, sessionID: hello.sessionID, cipherSuite: int(suite), supportedVersion: 0x0304, keyShare: mine, selectedIdentity: selectedIdentity}
			let shBytes = marshalServerHello(sh)
			try records.write(recordHandshake, shBytes)
			schedule.update(shBytes)
			schedule.deriveEarly(psk)
			try schedule.deriveHandshake(shared)
			// Middlebox compatibility (RFC 8446 §D.4): a dummy
			// change_cipher_spec when the client sent a legacy session id.
			try records.write(recordChangeCipherSpec, byte[1]) when hello.sessionID.len() > 0
			let (writeKey, writeIV) = try trafficKeyFor(suite, hash, schedule.serverHandshakeTrafficSecret)
			records.setWriteKey(writeKey, writeIV)
			let (readKey, readIV) = try trafficKeyFor(suite, hash, schedule.clientHandshakeTrafficSecret)
			records.setReadKey(readKey, readIV)

			let flight = marshalEncryptedExtensions(EncryptedExtensions{alpnProtocol: state.alpn})
			schedule.update(flight)
			if !resumed && config.clientAuth != ClientAuthType.NoClientCert {
				let request = marshalCertificateRequest(CertificateRequest{requestContext: [], signatureAlgorithms: signatureSchemeCodes(supportedSignatureSchemes())})
				schedule.update(request)
				flight = flight + request
				certificateRequested = true
			}
			if !resumed {
				let pair = keyPair
				fail tlsError(Alert.InternalError, "no certificate selected") when pair is none
				let entries CertificateEntry[]
				for let (_, der) in pair.chain {
					entries.push(CertificateEntry{data: der, extensions: []})
				}
				let cert = marshalCertificateMessage(CertificateMessage{requestContext: [], entries: entries})
				schedule.update(cert)
				let signsWith = scheme
				fail tlsError(Alert.InternalError, "no signature scheme selected") when signsWith is none
				let verify = marshalCertificateVerify(CertificateVerify{algorithm: int(signsWith), signature: try pair.sign(certificateVerifyContent("TLS 1.3, server CertificateVerify", schedule.transcriptHash()), signsWith)})
				schedule.update(verify)
				flight = flight + cert + verify
			}
			let finished = marshalFinished(try schedule.verifyData(schedule.serverHandshakeTrafficSecret))
			schedule.update(finished)
			try records.write(recordHandshake, flight + finished)
			try schedule.deriveMaster()
			let (appKey, appIV) = try trafficKeyFor(suite, hash, schedule.serverTrafficSecret)
			records.setWriteKey(appKey, appIV)
			return none
		}

		// keyExchange answers the client's share with a fresh one of the
		// same group and returns (own share, shared secret).
		internal def keyExchange(peer KeyShare) !(KeyShare, byte[]) {
			if peer.group == groupX25519 {
				x25519Private = try rand(32) when x25519Private.len() == 0
				let mine = KeyShare{group: groupX25519, data: try x25519Base(x25519Private)}
				let shared = x25519(x25519Private, peer.data) onerror fail tlsError(Alert.IllegalParameter, "client X25519 share is invalid")
				return (mine, shared)
			}
			let curve = peer.group == groupSecp256r1 ?? (p256, p384)
			let pair = try ecdhKeyPair(curve)
			let fixed = ecdheScalar
			pair = ECDHKeyPair{scalar: fixed, public: scalarBaseMult(curve, fixed)} unless fixed is none
			let point = unmarshalPoint(curve, peer.data) onerror fail tlsError(Alert.IllegalParameter, "client ECDHE share is not a point on the curve")
			let shared = ecdh(curve, pair.scalar, point) onerror fail tlsError(Alert.IllegalParameter, "client ECDHE share is invalid")
			return (KeyShare{group: peer.group, data: marshalPoint(curve, pair.public)}, shared)
		}

		// readClientFinished reads the client's Certificate and
		// CertificateVerify when one was requested, then checks the client
		// Finished, derives the resumption secret and keys the client's
		// application data.
		def readClientFinished() !none {
			try readClientCertificate() when certificateRequested
			let (kind, body, raw) = try reader.next()
			fail tlsError(Alert.UnexpectedMessage, "expected Finished, got message {kind}") when kind != handshakeFinished
			let expected = try schedule.verifyData(schedule.clientHandshakeTrafficSecret)
			fail tlsError(Alert.DecryptError, "client Finished does not verify") unless constantTimeEqual(expected, body)
			schedule.update(raw)
			try schedule.deriveResumption()
			let (readKey, readIV) = try trafficKeyFor(suite, hash, schedule.clientTrafficSecret)
			records.setReadKey(readKey, readIV)
			state.version = Version.TLS13
			state.cipherSuite = suite
			state.serverName = hello.serverName
			state.handshakeComplete = true
			return none
		}

		// readClientCertificate reads the answer to the CertificateRequest:
		// an empty Certificate declines, which `clientAuth` may refuse; a
		// chain is kept in the state, verified against `clientCAs` for
		// client authentication when `clientAuth` verifies, and its
		// CertificateVerify checked over the transcript.
		internal def readClientCertificate() !none {
			let (kind, body, raw) = try reader.next()
			fail tlsError(Alert.UnexpectedMessage, "expected Certificate, got message {kind}") when kind != handshakeCertificate
			let msg = try parseCertificateMessage(body)
			fail tlsError(Alert.IllegalParameter, "client Certificate carries a request context") when msg.requestContext.len() > 0
			schedule.update(raw)
			let ders byte[][]
			for let (_, entry) in msg.entries {
				ders.push(entry.data)
			}
			try takeClientChain(ders, Alert.CertificateRequired)
			return none when ders.len() == 0
			let chain = state.peerCertificates
			let (kind2, body2, raw2) = try reader.next()
			fail tlsError(Alert.UnexpectedMessage, "expected CertificateVerify, got message {kind2}") when kind2 != handshakeCertificateVerify
			try verifyCertificateVerify(try parseCertificateVerify(body2), chain[0].publicKey, "TLS 1.3, client CertificateVerify", schedule.transcriptHash())
			schedule.update(raw2)
			return none
		}

		// run12 is the TLS 1.2 handshake after the ClientHello: ServerHello
		// with the downgrade sentinel when this server also speaks TLS 1.3
		// (RFC 8446 §4.1.3), Certificate, the signed ServerKeyExchange, a
		// CertificateRequest when `clientAuth` asks, and ServerHelloDone in
		// the clear; then the client's Certificate when asked,
		// ClientKeyExchange, CertificateVerify when it presented a chain,
		// change_cipher_spec and Finished, answered in kind.
		internal def run12() !none {
			records.legacy = true
			random = try rand(32) when random.len() == 0
			if config.maxVersion == Version.TLS13 {
				let sentinel = hexdecode(downgradeTLS12) onerror recover []
				random = random[0:24] + sentinel
			}
			return try resume12() when resumed
			let pair = keyPair
			fail tlsError(Alert.InternalError, "no certificate selected") when pair is none
			let issuesTicket = config.sessionTicketKey.len() > 0 && hello.offersSessionTicket && config.clientAuth == ClientAuthType.NoClientCert
			let key = try newEphemeralKey(group)
			let sh = ServerHello{random: random, sessionID: [], cipherSuite: int(suite), alpnProtocol: state.alpn, extendedMasterSecret: true, secureRenegotiation: hello.secureRenegotiation, ecPointFormats: hello.ecPointFormats, serverNameAck: hello.serverName != "", sessionTicket: issuesTicket}
			let params = hello.random + random + serverKeyExchangeParams(group, key.public)
			let signsWith = scheme
			fail tlsError(Alert.InternalError, "no signature scheme selected") when signsWith is none
			let exchange = ServerKeyExchange{group: group, point: key.public, algorithm: int(signsWith), signature: try pair.sign(params, signsWith)}
			let flight = marshalServerHello(sh) + marshalCertificate12(pair.chain) + marshalServerKeyExchange(exchange)
			if config.clientAuth != ClientAuthType.NoClientCert {
				flight = flight + marshalCertificateRequest12(CertificateRequest12{certificateTypes: [certificateTypeRSASign, certificateTypeECDSASign], signatureAlgorithms: signatureSchemeCodes(supportedTLS12SignatureSchemes())})
				certificateRequested = true
			}
			flight = flight + marshalServerHelloDone()
			try records.write(recordHandshake, flight)
			schedule.update(flight)

			if certificateRequested {
				let (certKind, certBody, certRaw) = try reader.next()
				fail tlsError(Alert.UnexpectedMessage, "expected Certificate, got message {certKind}") when certKind != handshakeCertificate
				schedule.update(certRaw)
				try takeClientChain(try parseCertificate12(certBody), Alert.HandshakeFailure)
			}
			let (kind, body, raw) = try reader.next()
			fail tlsError(Alert.UnexpectedMessage, "expected ClientKeyExchange, got message {kind}") when kind != handshakeClientKeyExchange
			let preMaster = try key.sharedSecret(try parseClientKeyExchange(body))
			schedule.update(raw)
			let master = extendedMasterSecret(hash, preMaster, schedule.transcriptHash())
			let keys = keyBlock(suite, master, hello.random, random)
			if state.peerCertificates.len() > 0 {
				let (verifyKind, verifyBody, verifyRaw) = try reader.next()
				fail tlsError(Alert.UnexpectedMessage, "expected CertificateVerify, got message {verifyKind}") when verifyKind != handshakeCertificateVerify
				let cv = try parseCertificateVerify(verifyBody)
				try verifySignature(state.peerCertificates[0].publicKey, schedule.transcript, cv.signature, try offeredScheme(cv.algorithm, supportedTLS12SignatureSchemes()))
				schedule.update(verifyRaw)
			}

			fail tlsError(Alert.UnexpectedMessage, "handshake data before change_cipher_spec") when reader.buffer.len() > 0
			records.stageReadKey(try suiteAEAD(suite, keys.clientKey), keys.clientIV)
			let (kind2, body2, raw2) = try reader.next()
			fail tlsError(Alert.UnexpectedMessage, "expected Finished, got message {kind2}") when kind2 != handshakeFinished
			fail tlsError(Alert.UnexpectedMessage, "client Finished came before change_cipher_spec") unless records.isProtected()
			let expected = finishedVerifyData(hash, master, "client finished", schedule.transcriptHash())
			fail tlsError(Alert.DecryptError, "client Finished does not verify") unless constantTimeEqual(expected, body2)
			schedule.update(raw2)

			try sendTicket12(master) when issuesTicket
			try records.write(recordChangeCipherSpec, byte[1])
			records.setWriteKey(try suiteAEAD(suite, keys.serverKey), keys.serverIV)
			try records.write(recordHandshake, marshalFinished(finishedVerifyData(hash, master, "server finished", schedule.transcriptHash())))
			complete12()
			return none
		}

		// resume12 answers a ticket `resumeFromTicket` took (RFC 5077 §3.1):
		// ServerHello echoing the client's session id and announcing a
		// fresh ticket, that ticket, change_cipher_spec and Finished under
		// the session's master secret and the new randoms, then the
		// client's change_cipher_spec and Finished.
		internal def resume12() !none {
			let master = resumedMaster
			let sh = ServerHello{random: random, sessionID: hello.sessionID, cipherSuite: int(suite), alpnProtocol: state.alpn, extendedMasterSecret: true, secureRenegotiation: hello.secureRenegotiation, serverNameAck: hello.serverName != "", sessionTicket: true}
			let shBytes = marshalServerHello(sh)
			try records.write(recordHandshake, shBytes)
			schedule.update(shBytes)
			let keys = keyBlock(suite, master, hello.random, random)
			try sendTicket12(master)
			try records.write(recordChangeCipherSpec, byte[1])
			records.setWriteKey(try suiteAEAD(suite, keys.serverKey), keys.serverIV)
			let finished = marshalFinished(finishedVerifyData(hash, master, "server finished", schedule.transcriptHash()))
			try records.write(recordHandshake, finished)
			schedule.update(finished)

			fail tlsError(Alert.UnexpectedMessage, "handshake data before change_cipher_spec") when reader.buffer.len() > 0
			records.stageReadKey(try suiteAEAD(suite, keys.clientKey), keys.clientIV)
			let (kind, body, _) = try reader.next()
			fail tlsError(Alert.UnexpectedMessage, "expected Finished, got message {kind}") when kind != handshakeFinished
			fail tlsError(Alert.UnexpectedMessage, "client Finished came before change_cipher_spec") unless records.isProtected()
			let expected = finishedVerifyData(hash, master, "client finished", schedule.transcriptHash())
			fail tlsError(Alert.DecryptError, "client Finished does not verify") unless constantTimeEqual(expected, body)
			complete12()
			return none
		}

		// sendTicket12 issues a TLS 1.2 ticket in the clear, before this
		// side's change_cipher_spec: the suite, master secret, ALPN protocol
		// and issue time sealed under `sessionTicketKey`.
		internal def sendTicket12(master byte[]) !none {
			let issued = marshalNewSessionTicket12(NewSessionTicket12{lifetimeHint: sessionTicketLifetime, ticket: try sealTicket(config.sessionTicketKey, suite, master, state.alpn, unixSeconds())})
			try records.write(recordHandshake, issued)
			schedule.update(issued)
			return none
		}

		internal def complete12() {
			state.version = Version.TLS12
			state.cipherSuite = suite
			state.serverName = hello.serverName
			state.handshakeComplete = true
		}

		// takeClientChain keeps the chain a client presented, as DER and leaf
		// first, in the state, verified against `clientCAs` for client
		// authentication when `clientAuth` verifies. An empty chain declines,
		// which fails with the given alert when `clientAuth` requires one.
		// Fails with BadCertificate for a certificate that does not parse,
		// the alert of `chainError` for a chain that does not verify.
		internal def takeClientChain(ders byte[][], missing Alert) !none {
			if ders.len() == 0 {
				let required = config.clientAuth := ClientAuthType.RequireAnyClientCert || ClientAuthType.RequireAndVerifyClientCert
				fail tlsError(missing, "client sent no certificate") when required
				return none
			}
			let chain Certificate[]
			for let (_, der) in ders {
				let cert = parseCertificate(der) onerror fail tlsError(Alert.BadCertificate, "client certificate does not parse")
				chain.push(cert)
			}
			state.peerCertificates = chain
			if config.clientAuth := ClientAuthType.VerifyClientCertIfGiven || ClientAuthType.RequireAndVerifyClientCert {
				let intermediates = new CertPool()
				for let i = 1; i < chain.len(); i++ {
					intermediates.addCert(chain[i])
				}
				let opts = VerifyOptions{roots: config.clientCAs, intermediates: intermediates, keyUsages: [ExtKeyUsage.ClientAuth]}
				let failure ?error = none
				let chains = chain[0].verify(opts) onerror (err error) {
					failure = err
					recover []
				}
				fail chainError(failure) unless failure is none
				state.verifiedChains = chains
			}
			return none
		}

		// sendTicket issues one session ticket when the config has a ticket
		// key: the resumption secret expanded with a nonce, sealed with the
		// suite and ALPN protocol.
		def sendTicket() !none {
			return none when config.sessionTicketKey.len() == 0
			let nonce = byte[0, 0]
			let key = try resumptionPSK(hash, schedule.resumptionMasterSecret, nonce)
			let add = try rand(4)
			let ageAdd = int(add[0]) << 24 | int(add[1]) << 16 | int(add[2]) << 8 | int(add[3])
			let issued = NewSessionTicket{lifetime: sessionTicketLifetime, ageAdd: ageAdd, nonce: nonce, ticket: try sealTicket(config.sessionTicketKey, suite, key, state.alpn, unixSeconds())}
			ticket = issued
			try records.write(recordHandshake, marshalNewSessionTicket(issued))
			return none
		}
	}
}
