partial module std.net.tls {
	use (
		std.crypto::(PrivateKey, PublicKey, RSAPrivateKey, ECDSAPrivateKey, RSAPublicKey, ECDSAPublicKey, parseECDSASignature)
		std.crypto.hash::(Hash, hashSize, digest)
	)

	// SignatureScheme names the signature schemes of RFC 8446 §4.2.3, the
	// value being the code on the wire: ECDSA with the hash named (tied to
	// the curve in TLS 1.3 only), RSA-PSS with an rsaEncryption key (RSAE)
	// or an RSASSA-PSS key (PSS), RSA PKCS#1 v1.5 (certificates, and TLS 1.2
	// handshakes), Ed25519. Messages carry the codes as the peer sent them,
	// `signatureSchemeOf` maps one to its scheme.
	enum SignatureScheme {
		RSAPKCS1SHA256 = 0x0401,
		RSAPKCS1SHA384 = 0x0501,
		RSAPKCS1SHA512 = 0x0601,
		ECDSASecp256r1SHA256 = 0x0403,
		ECDSASecp384r1SHA384 = 0x0503,
		ECDSASecp521r1SHA512 = 0x0603,
		RSAPSSRSAESHA256 = 0x0804,
		RSAPSSRSAESHA384 = 0x0805,
		RSAPSSRSAESHA512 = 0x0806,
		Ed25519 = 0x0807,
		RSAPSSPSSSHA256 = 0x0809,
		RSAPSSPSSSHA384 = 0x080a,
		RSAPSSPSSSHA512 = 0x080b,
	}

	// The signature schemes a peer may use in a TLS 1.3 CertificateVerify,
	// in preference order: the ones std.crypto verifies.
	def supportedSignatureSchemes() SignatureScheme[] {
		return [SignatureScheme.ECDSASecp256r1SHA256, SignatureScheme.ECDSASecp384r1SHA384, SignatureScheme.RSAPSSRSAESHA256, SignatureScheme.RSAPSSRSAESHA384, SignatureScheme.RSAPSSRSAESHA512, SignatureScheme.RSAPSSPSSSHA256, SignatureScheme.RSAPSSPSSSHA384, SignatureScheme.RSAPSSPSSSHA512]
	}

	// The signature schemes a TLS 1.2 peer may sign with: the TLS 1.3 ones,
	// then RSA PKCS#1 v1.5.
	def supportedTLS12SignatureSchemes() SignatureScheme[] {
		return supportedSignatureSchemes() + [SignatureScheme.RSAPKCS1SHA256, SignatureScheme.RSAPKCS1SHA384, SignatureScheme.RSAPKCS1SHA512]
	}

	// signatureSchemeOf maps a wire code to its scheme, none for one this
	// module does not name.
	def signatureSchemeOf(code int) ?SignatureScheme {
		let known = supportedTLS12SignatureSchemes() + [SignatureScheme.ECDSASecp521r1SHA512, SignatureScheme.Ed25519]
		for let (_, scheme) in known {
			return scheme when int(scheme) == code
		}
		return none
	}

	// signatureSchemeCodes is the wire codes of schemes, as a
	// signature_algorithms list carries them.
	def signatureSchemeCodes(schemes SignatureScheme[]) int[] {
		let codes int[]
		for let (_, scheme) in schemes {
			codes.push(int(scheme))
		}
		return codes
	}

	// schemeHash is the digest a signature scheme signs, none for Ed25519,
	// which signs the message itself and is not implemented here.
	def schemeHash(scheme SignatureScheme) ?Hash {
		return Hash.SHA256 when scheme := SignatureScheme.ECDSASecp256r1SHA256 || SignatureScheme.RSAPSSRSAESHA256 || SignatureScheme.RSAPSSPSSSHA256 || SignatureScheme.RSAPKCS1SHA256
		return Hash.SHA384 when scheme := SignatureScheme.ECDSASecp384r1SHA384 || SignatureScheme.RSAPSSRSAESHA384 || SignatureScheme.RSAPSSPSSSHA384 || SignatureScheme.RSAPKCS1SHA384
		return Hash.SHA512 when scheme := SignatureScheme.ECDSASecp521r1SHA512 || SignatureScheme.RSAPSSRSAESHA512 || SignatureScheme.RSAPSSPSSSHA512 || SignatureScheme.RSAPKCS1SHA512
		return none
	}

	internal def isPKCS1Scheme(scheme SignatureScheme) bool {
		return scheme := SignatureScheme.RSAPKCS1SHA256 || SignatureScheme.RSAPKCS1SHA384 || SignatureScheme.RSAPKCS1SHA512
	}

	internal def isPSSScheme(scheme SignatureScheme) bool {
		return scheme := SignatureScheme.RSAPSSRSAESHA256 || SignatureScheme.RSAPSSRSAESHA384 || SignatureScheme.RSAPSSRSAESHA512 || SignatureScheme.RSAPSSPSSSHA256 || SignatureScheme.RSAPSSPSSSHA384 || SignatureScheme.RSAPSSPSSSHA512
	}

	internal def isECDSAScheme(scheme SignatureScheme) bool {
		return scheme := SignatureScheme.ECDSASecp256r1SHA256 || SignatureScheme.ECDSASecp384r1SHA384
	}

	// preferredSchemes is the schemes a private key signs a TLS 1.3
	// handshake with, best first: RSA keys RSA-PSS over SHA-256, SHA-384 or
	// SHA-512, ECDSA keys the hash of their curve.
	internal def preferredSchemes(key PrivateKey) SignatureScheme[] {
		return [SignatureScheme.RSAPSSRSAESHA256, SignatureScheme.RSAPSSRSAESHA384, SignatureScheme.RSAPSSRSAESHA512] when key is RSAPrivateKey
		if key is ECDSAPrivateKey {
			let ec ECDSAPrivateKey = key
			return [SignatureScheme.ECDSASecp256r1SHA256] when ec.curve.name == "P-256"
			return [SignatureScheme.ECDSASecp384r1SHA384]
		}
		return []
	}

	// preferredSchemeOf is the scheme a signature by the owner of a public
	// key is expected in when none is named: what preferredSchemes puts
	// first for the matching private key.
	internal def preferredSchemeOf(key PublicKey) SignatureScheme {
		if key is ECDSAPublicKey {
			let ec ECDSAPublicKey = key
			return SignatureScheme.ECDSASecp256r1SHA256 when ec.curve.name == "P-256"
			return SignatureScheme.ECDSASecp384r1SHA384
		}
		return SignatureScheme.RSAPSSRSAESHA256
	}

	// signatureSchemeFor is the scheme a private key signs with among the
	// wire codes a peer accepts, none when there is none: RSA keys sign
	// RSA-PSS over SHA-256, SHA-384 or SHA-512 in that order, ECDSA keys
	// with their curve's hash.
	def signatureSchemeFor(key PrivateKey, accepted int[]) ?SignatureScheme {
		for let (_, candidate) in preferredSchemes(key) {
			return candidate when accepted.includes(int(candidate))
		}
		return none
	}

	// keyExchangeSchemeFor is the scheme a private key signs a TLS 1.2
	// handshake with among the wire codes a peer accepts, none when there
	// is none: what signatureSchemeFor picks, else RSA PKCS#1 v1.5 for an
	// RSA key and the other ECDSA hash for an ECDSA key, which TLS 1.2 does
	// not tie to the curve.
	def keyExchangeSchemeFor(key PrivateKey, accepted int[]) ?SignatureScheme {
		let preferred = signatureSchemeFor(key, accepted)
		return preferred unless preferred is none
		let fallback = [SignatureScheme.ECDSASecp256r1SHA256, SignatureScheme.ECDSASecp384r1SHA384]
		fallback = [SignatureScheme.RSAPKCS1SHA256, SignatureScheme.RSAPKCS1SHA384, SignatureScheme.RSAPKCS1SHA512] when key is RSAPrivateKey
		for let (_, candidate) in fallback {
			return candidate when accepted.includes(int(candidate))
		}
		return none
	}

	// verifySignature checks a signature over content, hashed as the scheme
	// says, with a public key: RSA-PSS with a salt as long as the hash,
	// RSA PKCS#1 v1.5, or ECDSA as DER. Which schemes a handshake allows,
	// and TLS 1.3 tying ECDSA schemes to curves, is the caller's to check.
	// Fails with TLSError: UnsupportedCertificate without a key,
	// IllegalParameter for a scheme that does not fit the key, DecodeError
	// for an ECDSA signature that is not DER, DecryptError when the
	// signature does not verify.
	internal def verifySignature(key ?PublicKey, content byte[], signature byte[], scheme SignatureScheme) !none {
		let schemeDigest = schemeHash(scheme)
		fail tlsError(Alert.IllegalParameter, "unsupported signature scheme {scheme}") when schemeDigest is none
		fail tlsError(Alert.UnsupportedCertificate, "peer certificate key type is not supported") when key is none
		let sum = digest(schemeDigest, content)
		let ok = false
		if key is RSAPublicKey {
			let rsa RSAPublicKey = key
			if isPSSScheme(scheme) {
				ok = rsa.verifyPSS(schemeDigest, sum, signature, hashSize(schemeDigest))
			} else {
				fail tlsError(Alert.IllegalParameter, "RSA key with signature scheme {scheme}") unless isPKCS1Scheme(scheme)
				ok = rsa.verifyPKCS1v15(schemeDigest, sum, signature)
			}
		}
		if key is ECDSAPublicKey {
			let ec ECDSAPublicKey = key
			fail tlsError(Alert.IllegalParameter, "ECDSA key with signature scheme {scheme}") unless isECDSAScheme(scheme)
			let (r, s) = parseECDSASignature(signature) onerror fail tlsError(Alert.DecodeError, "ECDSA signature is not DER")
			ok = ec.verify(sum, r, s)
		}
		fail tlsError(Alert.DecryptError, "peer signature does not verify") unless ok
		return none
	}

	// offeredScheme is the scheme of a wire code a peer signed with, which
	// must be among the ones this side offered. Fails with IllegalParameter.
	internal def offeredScheme(code int, offered SignatureScheme[]) !SignatureScheme {
		let scheme = signatureSchemeOf(code)
		fail tlsError(Alert.IllegalParameter, "peer signed with scheme {code}, which was not offered") when scheme is none
		fail tlsError(Alert.IllegalParameter, "peer signed with scheme {code}, which was not offered") unless offered.includes(scheme)
		return scheme
	}
}
