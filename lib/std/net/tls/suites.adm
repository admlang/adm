partial module std.net.tls {
	use (
		std.crypto.hash::(Hash)
		std.crypto.cipher::(AEAD, newAES, newGCM, newChaCha20Poly1305)
	)

	// Version is a protocol version as it appears on the wire.
	enum Version {
		TLS12 = 0x0303,
		TLS13 = 0x0304,
	}

	// CipherSuite names the TLS 1.3 suites of RFC 8446 §B.4 and the TLS 1.2
	// ECDHE suites with an AEAD (RFC 5289, RFC 7905), the value being the
	// code on the wire. A TLS 1.2 suite also says which key the server
	// signs its key exchange with. The hash of a suite drives its key
	// schedule or PRF.
	enum CipherSuite {
		AES128GCMSHA256 = 0x1301,
		AES256GCMSHA384 = 0x1302,
		ChaCha20Poly1305SHA256 = 0x1303,
		ECDHEECDSAWithAES128GCMSHA256 = 0xC02B,
		ECDHEECDSAWithAES256GCMSHA384 = 0xC02C,
		ECDHERSAWithAES128GCMSHA256 = 0xC02F,
		ECDHERSAWithAES256GCMSHA384 = 0xC030,
		ECDHERSAWithChaCha20Poly1305SHA256 = 0xCCA8,
		ECDHEECDSAWithChaCha20Poly1305SHA256 = 0xCCA9,
	}

	// The TLS 1.3 suites this module implements, in preference order.
	def defaultCipherSuites() CipherSuite[] {
		return [CipherSuite.AES128GCMSHA256, CipherSuite.ChaCha20Poly1305SHA256, CipherSuite.AES256GCMSHA384]
	}

	// The TLS 1.2 suites this module implements, in preference order.
	def defaultTLS12CipherSuites() CipherSuite[] {
		return [CipherSuite.ECDHEECDSAWithAES128GCMSHA256, CipherSuite.ECDHERSAWithAES128GCMSHA256, CipherSuite.ECDHEECDSAWithChaCha20Poly1305SHA256, CipherSuite.ECDHERSAWithChaCha20Poly1305SHA256, CipherSuite.ECDHEECDSAWithAES256GCMSHA384, CipherSuite.ECDHERSAWithAES256GCMSHA384]
	}

	// cipherSuiteOf maps a wire code to its suite, none for one this module
	// does not implement.
	def cipherSuiteOf(code int) ?CipherSuite {
		let known = defaultCipherSuites() + defaultTLS12CipherSuites()
		for let (_, suite) in known {
			return suite when int(suite) == code
		}
		return none
	}

	// suiteIsTLS13 reports whether the suite belongs to TLS 1.3; the others
	// belong to TLS 1.2.
	def suiteIsTLS13(suite CipherSuite) bool {
		return suite := CipherSuite.AES128GCMSHA256 || CipherSuite.AES256GCMSHA384 || CipherSuite.ChaCha20Poly1305SHA256
	}

	// suiteSignsWithRSA reports whether a TLS 1.2 suite has the server sign
	// its key exchange with an RSA key, an ECDSA key otherwise.
	def suiteSignsWithRSA(suite CipherSuite) bool {
		return suite := CipherSuite.ECDHERSAWithAES128GCMSHA256 || CipherSuite.ECDHERSAWithAES256GCMSHA384 || CipherSuite.ECDHERSAWithChaCha20Poly1305SHA256
	}

	// suiteHash is the hash the suite's key schedule, PRF and transcript use.
	def suiteHash(suite CipherSuite) Hash {
		return Hash.SHA384 when suite := CipherSuite.AES256GCMSHA384 || CipherSuite.ECDHEECDSAWithAES256GCMSHA384 || CipherSuite.ECDHERSAWithAES256GCMSHA384
		return Hash.SHA256
	}

	// suiteKeySize is the traffic key length of the suite's AEAD.
	def suiteKeySize(suite CipherSuite) int {
		return 16 when suite := CipherSuite.AES128GCMSHA256 || CipherSuite.ECDHEECDSAWithAES128GCMSHA256 || CipherSuite.ECDHERSAWithAES128GCMSHA256
		return 32
	}

	// suiteUsesChaCha20 reports whether the suite's AEAD is
	// ChaCha20-Poly1305, AES-GCM otherwise.
	def suiteUsesChaCha20(suite CipherSuite) bool {
		return suite := CipherSuite.ChaCha20Poly1305SHA256 || CipherSuite.ECDHEECDSAWithChaCha20Poly1305SHA256 || CipherSuite.ECDHERSAWithChaCha20Poly1305SHA256
	}

	// suiteAEAD builds the suite's AEAD under a traffic key of suiteKeySize
	// bytes. Fails when the key has another length.
	def suiteAEAD(suite CipherSuite, key byte[]) !AEAD {
		return try newChaCha20Poly1305(key) when suiteUsesChaCha20(suite)
		return try newGCM(try newAES(key), 12, 16)
	}

	// ClientAuthType is a server's policy on client certificates: none
	// asked for; asked for but optional and unverified; required but
	// unverified; verified against `clientCAs` when given; required and
	// verified.
	enum ClientAuthType {
		NoClientCert,
		RequestClientCert,
		RequireAnyClientCert,
		VerifyClientCertIfGiven,
		RequireAndVerifyClientCert,
	}

	// CurveID names a key exchange group of RFC 8446 §4.2.7, the value
	// being the code on the wire.
	enum CurveID {
		X25519 = 0x001d,
		P256 = 0x0017,
		P384 = 0x0018,
	}

	// The groups this module implements, in preference order.
	def defaultCurves() CurveID[] {
		return [CurveID.X25519, CurveID.P256, CurveID.P384]
	}

	// Named groups of RFC 8446 §4.2.7 this module offers, wire codes:
	// X25519, the share sent first.
	const groupX25519 = 0x001d
	// NIST P-256, on a HelloRetryRequest.
	const groupSecp256r1 = 0x0017
	// NIST P-384, on a HelloRetryRequest.
	const groupSecp384r1 = 0x0018
}
