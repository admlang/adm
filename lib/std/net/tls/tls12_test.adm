partial module std.net.tls {
	use (
		std.testing
		std.bytes::(Buffer)
		std.crypto.hash::(Hash)
		std.crypto.cipher::(newAES, newGCM, newChaCha20Poly1305)
		std.data.encoding::(hexdecode)
		std.crypto::(rand)
		std.net
	)

	// serveForged serves one connection like serveOnce, with a server
	// random that ends in the TLS 1.2 downgrade sentinel.
	internal async def serveForged(ln net.Listener, config Config, report ServerReport) none {
		let raw = ln.accept() onerror (err error) {
			report.failure = "accept: {err.message}"
			recover new net.Connection(-1)
		}
		return none when report.failure != ""
		let conn = server(raw, config)
		let hs = new ServerHandshake(config, conn.records)
		let sentinel = hexdecode(downgradeTLS12) onerror recover []
		let head = rand(24) onerror recover []
		hs.random = head + sentinel
		conn.preparedServer = hs
		serveConn(conn, report) onerror (err error) {
			report.failure = err.message
			recover none
		}
		conn.close() onerror recover none
		return none
	}

	// echoOver dials a server of serveOnce, sends "ping", expects "PING"
	// and the server's close, and returns what the client negotiated.
	internal def echoOver(ln net.Listener, serverConfig Config, clientConfig Config, report ServerReport) !ConnectionState {
		let task = async serveOnce(ln, serverConfig, report)
		let conn = try dial(ln.address().str(), clientConfig, 5s)
		let state = conn.connectionState()
		try conn.write("ping".bytes(), 5s)
		let buf byte[]
		buf.len(64)
		let n = try conn.read(buf, 5s)
		assert string(buf[0:n]) == "PING"
		assert (try conn.read(buf, 5s)) == 0
		try conn.close()
		await task
		return state
	}

	// refusalOf dials a server of serveOnce and returns the message the
	// handshake failed with, "" when it completed.
	internal def refusalOf(ln net.Listener, serverConfig Config, clientConfig Config, report ServerReport) !string {
		let task = async serveOnce(ln, serverConfig, report)
		let reason = ""
		let raw = try net.dialStream(ln.address().str(), 5s)
		let conn = client(raw, clientConfig)
		conn.handshake(5s) onerror (err error) {
			reason = err.message
			recover none
		}
		conn.close() onerror recover none
		await task
		return reason
	}

	check "TLS 1.2" {
		// The TLS 1.2 PRF test vectors that circulate with RFC 5246, SHA-256
		// and SHA-384, label "test label".
		@test()
		def TestPRFVectors() !none {
			let secret = try hexdecode("9bbe436ba940f017b17652849a71db35")
			let seed = try hexdecode("a0ba9f936cda311827a6f796ffd5198c")
			assert prf(Hash.SHA256, secret, "test label", seed, 100).hex() == "E3F229BA727BE17B8D122620557CD453C2AAB21D07C3D495329B52D4E61EDB5A6B301791E90D35C9C9A46B4E14BAF9AF0FA022F7077DEF17ABFD3797C0564BAB4FBC91666E9DEF9B97FCE34F796789BAA48082D122EE42C5A72E5A5110FFF70187347B66"
			let secret384 = try hexdecode("b80b733d6ceefcdc71566ea48e5567df")
			let seed384 = try hexdecode("cd665cf6a8447dd6ff8b27555edb7465")
			assert prf(Hash.SHA384, secret384, "test label", seed384, 148).hex() == "7B0C18E9CED410ED1804F2CFA34A336A1C14DFFB4900BB5FD7942107E81C83CDE9CA0FAA60BE9FE34F82B1233C9146A0E534CB400FED2700884F9DC236F80EDD8BFA961144C9E8D792ECA722A7B32FC3D416D473EBC2C5FD4ABFDAD05D9184259B5BF8CD4D90FA0D31E2DEC479E4F1A26066F2EEA9A69236A3E52655C9E9AEE691C8F3A26854308D5EAA3BE85E0990703D73E56F"
			assert pHash(Hash.SHA256, secret, seed, 5).len() == 5
			let master = extendedMasterSecret(Hash.SHA256, secret, seed)
			assert master.len() == masterSecretSize
			assert finishedVerifyData(Hash.SHA256, master, "client finished", seed).len() == finishedSize12
			let gcm = keyBlock(CipherSuite.ECDHERSAWithAES256GCMSHA384, master, seed, secret)
			assert gcm.clientKey.len() == 32 && gcm.serverKey.len() == 32 && gcm.clientIV.len() == 4 && gcm.serverIV.len() == 4
			assert gcm.clientKey.hex() != gcm.serverKey.hex()
			let chacha = keyBlock(CipherSuite.ECDHEECDSAWithChaCha20Poly1305SHA256, master, seed, secret)
			assert chacha.clientKey.len() == 32 && chacha.serverIV.len() == 12
		}

		// A TLS 1.2 record: explicit nonce for AES-GCM, none for
		// ChaCha20-Poly1305, the sequence number and header authenticated.
		@test()
		def TestRecordProtection12() !none {
			let header = byte[23, 3, 3, 0, 0]
			let key = try rand(16)
			let salt = try rand(4)
			let sealer = new TrafficKey(try newGCM(try newAES(key), 12, 16), salt)
			let opener = new TrafficKey(try newGCM(try newAES(key), 12, 16), salt)
			let first = sealer.seal12(header, "hello".bytes())
			assert first.len() == 8 + 5 + 16
			assert first[0:8].hex() == "0000000000000000"
			assert string(try opener.open12(header, first)) == "hello"
			let second = sealer.seal12(header, "again".bytes())
			assert second[0:8].hex() == "0000000000000001"
			assert string(try opener.open12(header, second)) == "again"
			// Replayed: the sequence number moved on.
			let replay = "ok"
			opener.open12(header, second) onerror (err error) {
				replay = err.message
				recover []
			}
			assert replay.contains("authentication")
			// Another content type in the header.
			let third = sealer.seal12(header, "typed".bytes())
			let retyped = "ok"
			opener.open12(byte[22, 3, 3, 0, 0], third) onerror (err error) {
				retyped = err.message
				recover []
			}
			assert retyped.contains("authentication")

			let chachaKey = try rand(32)
			let iv = try rand(12)
			let chachaSealer = new TrafficKey(try newChaCha20Poly1305(chachaKey), iv)
			let chachaOpener = new TrafficKey(try newChaCha20Poly1305(chachaKey), iv)
			let sealed = chachaSealer.seal12(header, "hello".bytes())
			assert sealed.len() == 5 + 16
			assert string(try chachaOpener.open12(header, sealed)) == "hello"
			assert string(try chachaOpener.open12(header, chachaSealer.seal12(header, "two".bytes()))) == "two"
			let short = "ok"
			chachaOpener.open12(header, byte[1, 2, 3]) onerror (err error) {
				short = err.message
				recover []
			}
			assert short.contains("authentication")
		}

		// change_cipher_spec switches a TLS 1.2 reader to the staged key,
		// and is refused while none is staged.
		@test()
		def TestChangeCipherSpecSwitchesKeys() !none {
			let key = try rand(16)
			let salt = try rand(4)
			let wire = new Buffer()
			let sender = new RecordLayer(new Buffer(), wire)
			sender.legacy = true
			try sender.write(recordHandshake, "clear".bytes())
			try sender.write(recordChangeCipherSpec, byte[1])
			sender.setWriteKey(try newGCM(try newAES(key), 12, 16), salt)
			try sender.write(recordHandshake, "sealed".bytes())
			try sender.writeAlert(Alert.CloseNotify, false)

			let receiver = new RecordLayer(new Buffer(wire.bytes()), new Buffer())
			receiver.legacy = true
			assert string((try receiver.read()).payload) == "clear"
			receiver.stageReadKey(try newGCM(try newAES(key), 12, 16), salt)
			assert !receiver.isProtected()
			assert (try receiver.read()).contentType == recordChangeCipherSpec
			assert receiver.isProtected()
			let sealed = try receiver.read()
			assert sealed.contentType == recordHandshake && string(sealed.payload) == "sealed"
			let alert = try receiver.read()
			assert alert.contentType == recordAlert && alert.payload.hex() == "0100"

			let early = new RecordLayer(new Buffer(wire.bytes()), new Buffer())
			early.legacy = true
			try early.read()
			let refused = "ok"
			early.read() onerror (err error) {
				refused = err.message
				recover Record{contentType: 0, payload: []}
			}
			assert refused.contains("before the keys")
		}

		// The ServerKeyExchange signature per key type and scheme, and what
		// the client refuses.
		@test()
		def TestKeyExchangeSignature() !none {
			let randoms = try rand(64)
			let point = (try newEphemeralKey(groupX25519)).public
			let content = randoms + serverKeyExchangeParams(groupX25519, point)
			let rsa = try parseKeyPair(testRSACertPEM, testRSAKeyPEM)
			let rsaLeaf = rsa.leaf
			fail "no leaf" when rsaLeaf is none
			for let (_, scheme) in [SignatureScheme.RSAPKCS1SHA256, SignatureScheme.RSAPSSRSAESHA384] {
				let kx = ServerKeyExchange{group: groupX25519, point: point, algorithm: int(scheme), signature: try rsa.sign(content, scheme)}
				try verifyKeyExchange(kx, rsaLeaf.publicKey, randoms, true)
			}
			let ec = try parseKeyPair(testECCertPEM, testECKeyPEM)
			let ecLeaf = ec.leaf
			fail "no leaf" when ecLeaf is none
			// The pair checks what it signed, with the key's preferred
			// scheme when none is named.
			let own = try ec.sign(content)
			try ec.verify(content, own)
			try ec.verify(content, own, SignatureScheme.ECDSASecp256r1SHA256)
			try rsa.verify(content, try rsa.sign(content))
			try rsa.verify(content, try rsa.sign(content, SignatureScheme.RSAPKCS1SHA512), SignatureScheme.RSAPKCS1SHA512)
			let wrongScheme = "ok"
			rsa.verify(content, try rsa.sign(content), SignatureScheme.RSAPKCS1SHA256) onerror (err error) {
				wrongScheme = err.message
				recover none
			}
			assert wrongScheme.contains("does not verify")
			let wrongKey = "ok"
			ec.sign(content, SignatureScheme.RSAPSSRSAESHA256) onerror (err error) {
				wrongKey = err.message
				recover []
			}
			assert wrongKey.contains("ECDSA key with signature scheme")
			let signed = ServerKeyExchange{group: groupX25519, point: point, algorithm: int(SignatureScheme.ECDSASecp256r1SHA256), signature: try ec.sign(content)}
			try verifyKeyExchange(signed, ecLeaf.publicKey, randoms, false)

			let reasons string[]
			// Other randoms, an ECDSA key under an RSA suite, a scheme that
			// was not offered.
			verifyKeyExchange(signed, ecLeaf.publicKey, try rand(64), false) onerror (err error) {
				reasons.push(err.message)
				recover none
			}
			verifyKeyExchange(signed, ecLeaf.publicKey, randoms, true) onerror (err error) {
				reasons.push(err.message)
				recover none
			}
			signed.algorithm = int(SignatureScheme.Ed25519)
			verifyKeyExchange(signed, ecLeaf.publicKey, randoms, false) onerror (err error) {
				reasons.push(err.message)
				recover none
			}
			assert reasons.len() == 3
			assert reasons[0].contains("does not verify") && reasons[1].contains("RSA cipher suite") && reasons[2].contains("not offered")
			assert defaultTLS12CipherSuites().len() == 6
		}

		@test()
		def TestHandshakeCodec12() !none {
			let kx = ServerKeyExchange{group: groupSecp256r1, point: byte[4, 1, 2], algorithm: int(SignatureScheme.RSAPKCS1SHA256), signature: byte[9, 8, 7]}
			let framed = marshalServerKeyExchange(kx)
			let next = splitHandshake(framed)
			fail "no message" when next is none
			let (kind, body, used) = next
			assert kind == handshakeServerKeyExchange && used == framed.len()
			let parsed = try parseServerKeyExchange(body)
			assert parsed.group == groupSecp256r1 && parsed.point.hex() == "040102"
			assert parsed.algorithm == int(SignatureScheme.RSAPKCS1SHA256) && parsed.signature.hex() == "090807"
			assert serverKeyExchangeParams(groupSecp256r1, byte[4, 1, 2]).hex() == "03001703040102"
			let explicitCurve = "ok"
			parseServerKeyExchange(byte[1, 0, 23, 0, 0, 0, 0, 0]) onerror (err error) {
				explicitCurve = err.message
				recover kx
			}
			assert explicitCurve.contains("curve type")

			let exchange = marshalClientKeyExchange(byte[4, 5, 6])
			assert exchange.hex() == "1000000403040506"
			assert (try parseClientKeyExchange(exchange[4:])).hex() == "040506"
			assert marshalServerHelloDone().hex() == "0E000000"

			let chain = try parseCertificate12(marshalCertificate12([byte[1, 2], byte[3]])[4:])
			assert chain.len() == 2 && chain[0].hex() == "0102" && chain[1].hex() == "03"
			assert (try parseCertificate12(marshalCertificate12([])[4:])).len() == 0

			let hello = ClientHello{random: try rand(32), sessionID: [], cipherSuites: [0xC02B], supportedVersions: [0x0303], supportedGroups: [groupX25519], signatureAlgorithms: signatureSchemeCodes(supportedTLS12SignatureSchemes()), ecPointFormats: true, extendedMasterSecret: true, secureRenegotiation: true}
			let back = try parseClientHello(marshalClientHello(hello)[4:])
			assert back.ecPointFormats && back.extendedMasterSecret && back.secureRenegotiation
			assert back.signatureAlgorithms.includes(int(SignatureScheme.RSAPKCS1SHA512))
			let scsv = try parseClientHello(marshalClientHello(ClientHello{random: try rand(32), sessionID: [], cipherSuites: [0xC02B, suiteEmptyRenegotiationInfo]})[4:])
			assert scsv.secureRenegotiation && !scsv.extendedMasterSecret

			let answer = ServerHello{random: try rand(32), sessionID: [], cipherSuite: 0xC02F, alpnProtocol: "h2", extendedMasterSecret: true, secureRenegotiation: true, ecPointFormats: true, serverNameAck: true}
			let read = try parseServerHello(marshalServerHello(answer)[4:])
			assert read.supportedVersion == 0 && read.keyShare is none
			assert read.alpnProtocol == "h2" && read.extendedMasterSecret && read.secureRenegotiation && read.ecPointFormats && read.serverNameAck

			let chacha = cipherSuiteOf(0xCCA8)
			fail "no suite" when chacha is none
			assert chacha == CipherSuite.ECDHERSAWithChaCha20Poly1305SHA256 && suiteUsesChaCha20(chacha)
			let aes = cipherSuiteOf(0x1302)
			fail "no suite" when aes is none
			assert aes == CipherSuite.AES256GCMSHA384 && !suiteUsesChaCha20(aes)
			assert cipherSuiteOf(0x002F) is none
			assert suiteIsTLS13(CipherSuite.AES128GCMSHA256) && !suiteIsTLS13(CipherSuite.ECDHEECDSAWithAES128GCMSHA256)
			assert suiteSignsWithRSA(CipherSuite.ECDHERSAWithAES128GCMSHA256) && !suiteSignsWithRSA(CipherSuite.ECDHEECDSAWithAES256GCMSHA384)

			let ec = try parseKeyPair(testECCertPEM, testECKeyPEM)
			let ecKey = ec.privateKey
			fail "no key" when ecKey is none
			assert picks(keyExchangeSchemeFor(ecKey, signatureSchemeCodes([SignatureScheme.RSAPKCS1SHA256, SignatureScheme.ECDSASecp384r1SHA384])), SignatureScheme.ECDSASecp384r1SHA384)
			let rsa = try parseKeyPair(testRSACertPEM, testRSAKeyPEM)
			let rsaKey = rsa.privateKey
			fail "no key" when rsaKey is none
			assert picks(keyExchangeSchemeFor(rsaKey, signatureSchemeCodes([SignatureScheme.RSAPKCS1SHA384, SignatureScheme.ECDSASecp256r1SHA256])), SignatureScheme.RSAPKCS1SHA384)
			assert picks(keyExchangeSchemeFor(rsaKey, signatureSchemeCodes([SignatureScheme.RSAPKCS1SHA384, SignatureScheme.RSAPSSRSAESHA512])), SignatureScheme.RSAPSSRSAESHA512)
			assert keyExchangeSchemeFor(rsaKey, signatureSchemeCodes([SignatureScheme.ECDSASecp256r1SHA256])) is none
		}

		@test()
		def TestEphemeralKeys() !none {
			for let (_, group) in [groupX25519, groupSecp256r1, groupSecp384r1] {
				let mine = try newEphemeralKey(group)
				let theirs = try newEphemeralKey(group)
				assert (try mine.sharedSecret(theirs.public)).hex() == (try theirs.sharedSecret(mine.public)).hex()
			}
			let bad = "ok"
			let p256Key = try newEphemeralKey(groupSecp256r1)
			p256Key.sharedSecret(byte[4, 1, 2, 3]) onerror (err error) {
				bad = err.message
				recover []
			}
			assert bad.contains("not a point")
			let unknown = "ok"
			newEphemeralKey(0x0019) onerror (err error) {
				unknown = err.message
				recover p256Key
			}
			assert unknown.contains("not supported")
		}

		// An ECDSA pair over loopback at TLS 1.2 with ALPN: a client that
		// stops at TLS 1.2 takes the downgrade sentinel of a server that
		// also speaks TLS 1.3.
		@test()
		def TestLoopbackECDSA() !none {
			let pair = try parseKeyPair(testECCertPEM, testECKeyPEM)
			let serverConfig = Config{certificates: [pair], alpn: ["h2", "http/1.1"], minVersion: Version.TLS12}
			let clientConfig = Config{serverName: "localhost", rootCAs: try poolOf(testECCertPEM), alpn: ["http/1.1"], minVersion: Version.TLS12, maxVersion: Version.TLS12}
			let ln = try listenLoopback()
			let report = new ServerReport()
			let state = try echoOver(ln, serverConfig, clientConfig, report)
			assert state.handshakeComplete && !state.resumed
			assert state.version == Version.TLS12
			assert state.cipherSuite == CipherSuite.ECDHEECDSAWithAES128GCMSHA256
			assert state.alpn == "http/1.1"
			assert state.peerCertificates.len() == 1 && state.verifiedChains.len() == 1
			assert report.failure == "" && report.echoed == "ping"
			assert report.state.version == Version.TLS12
			assert report.state.cipherSuite == CipherSuite.ECDHEECDSAWithAES128GCMSHA256
			assert report.state.alpn == "http/1.1" && report.state.serverName == "localhost"

			// Both ends speak both versions: TLS 1.3 wins.
			let both = new ServerReport()
			let newest = try echoOver(ln, serverConfig, Config{serverName: "localhost", rootCAs: try poolOf(testECCertPEM), minVersion: Version.TLS12}, both)
			assert newest.version == Version.TLS13 && newest.cipherSuite == CipherSuite.AES128GCMSHA256
			assert both.failure == "" && both.state.version == Version.TLS13

			// P-384 and AES-256 with SHA-384 as the PRF hash.
			let strong = new ServerReport()
			let strongServer = Config{certificates: [pair], minVersion: Version.TLS12, maxVersion: Version.TLS12, curvePreferences: [CurveID.P384], cipherSuites: [CipherSuite.ECDHEECDSAWithAES256GCMSHA384]}
			let strongState = try echoOver(ln, strongServer, clientConfig, strong)
			assert strongState.version == Version.TLS12 && strongState.cipherSuite == CipherSuite.ECDHEECDSAWithAES256GCMSHA384
			assert strong.failure == ""
			try ln.close()
		}

		// An RSA pair at TLS 1.2 with ChaCha20-Poly1305, against a client
		// that also offers TLS 1.3.
		@test()
		def TestLoopbackRSA() !none {
			let pair = try parseKeyPair(testRSACertPEM, testRSAKeyPEM)
			let serverConfig = Config{certificates: [pair], minVersion: Version.TLS12, maxVersion: Version.TLS12, cipherSuites: [CipherSuite.ECDHERSAWithChaCha20Poly1305SHA256, CipherSuite.ECDHEECDSAWithAES128GCMSHA256]}
			let clientConfig = Config{serverName: "localhost", rootCAs: try poolOf(testRSACertPEM), minVersion: Version.TLS12}
			let ln = try listenLoopback()
			let report = new ServerReport()
			let state = try echoOver(ln, serverConfig, clientConfig, report)
			assert state.version == Version.TLS12
			assert state.cipherSuite == CipherSuite.ECDHERSAWithChaCha20Poly1305SHA256
			assert report.failure == "" && report.state.version == Version.TLS12

			// A payload over several records both ways.
			let big = new ServerReport()
			let task = async serveOnce(ln, serverConfig, big)
			let conn = try dial(ln.address().str(), clientConfig, 5s)
			let payload byte[]
			payload.len(200)
			payload.fill(0x61)
			try conn.write(payload, 5s)
			let buf byte[]
			buf.len(512)
			let got = 0
			for got < 200 {
				let n = try conn.read(buf, 5s)
				break when n == 0
				assert buf[0] == 0x41
				got += n
			}
			assert got == 200
			try conn.close()
			await task
			assert big.failure == ""
			try ln.close()
		}

		// Client certificates at TLS 1.2: required and verified, an RSA
		// chain taken unverified, declined where optional and where
		// required, and the request codec.
		@test()
		def TestClientCertificates12() !none {
			let pair = try parseKeyPair(testECCertPEM, testECKeyPEM)
			let clientPair = try parseKeyPair(testClientCertPEM, testClientKeyPEM)
			let rsaPair = try parseKeyPair(testRSACertPEM, testRSAKeyPEM)
			let roots = try poolOf(testECCertPEM)
			let ln = try listenLoopback()

			let strict = Config{certificates: [pair], minVersion: Version.TLS12, maxVersion: Version.TLS12, clientAuth: ClientAuthType.RequireAndVerifyClientCert, clientCAs: try poolOf(testClientCertPEM)}
			let report = new ServerReport()
			let state = try echoOver(ln, strict, Config{serverName: "localhost", rootCAs: roots, minVersion: Version.TLS12, certificates: [clientPair]}, report)
			assert state.version == Version.TLS12
			assert report.failure == ""
			assert report.state.peerCertificates.len() == 1 && report.state.verifiedChains.len() == 1
			assert report.state.peerCertificates[0].subject.str().contains("ADM client")

			let any = Config{certificates: [pair], minVersion: Version.TLS12, maxVersion: Version.TLS12, clientAuth: ClientAuthType.RequireAnyClientCert}
			let unverified = new ServerReport()
			try echoOver(ln, any, Config{serverName: "localhost", rootCAs: roots, minVersion: Version.TLS12, certificates: [rsaPair]}, unverified)
			assert unverified.failure == ""
			assert unverified.state.peerCertificates.len() == 1 && unverified.state.verifiedChains.len() == 0

			let optional = Config{certificates: [pair], minVersion: Version.TLS12, maxVersion: Version.TLS12, clientAuth: ClientAuthType.VerifyClientCertIfGiven, clientCAs: try poolOf(testClientCertPEM)}
			let declined = new ServerReport()
			try echoOver(ln, optional, Config{serverName: "localhost", rootCAs: roots, minVersion: Version.TLS12}, declined)
			assert declined.failure == "" && declined.state.peerCertificates.len() == 0

			let missing = new ServerReport()
			let reason = try refusalOf(ln, strict, Config{serverName: "localhost", rootCAs: roots, minVersion: Version.TLS12}, missing)
			assert reason.contains("HandshakeFailure")
			assert missing.failure.contains("no certificate")

			// A chain the server's roots do not anchor.
			let unknown = new ServerReport()
			reason = try refusalOf(ln, strict, Config{serverName: "localhost", rootCAs: roots, minVersion: Version.TLS12, certificates: [rsaPair]}, unknown)
			assert reason.contains("UnknownCA")
			try ln.close()

			let req = CertificateRequest12{certificateTypes: [certificateTypeRSASign, certificateTypeECDSASign], signatureAlgorithms: [int(SignatureScheme.RSAPKCS1SHA256)], authorities: [byte[0x30, 0]]}
			let parsed = try parseCertificateRequest12(marshalCertificateRequest12(req)[4:])
			assert parsed.certificateTypes.len() == 2 && parsed.certificateTypes[1] == certificateTypeECDSASign
			assert parsed.signatureAlgorithms.len() == 1 && parsed.authorities.len() == 1 && parsed.authorities[0].hex() == "3000"
		}

		// Session tickets at TLS 1.2 (RFC 5077): a full handshake leaves a
		// session in the cache, the next connection resumes it and reports
		// the chain again, a rotated ticket key falls back to a full
		// handshake, and TLS 1.3 takes over when the server allows it.
		@test()
		def TestTicketResumption12() !none {
			let pair = try parseKeyPair(testECCertPEM, testECKeyPEM)
			let ticketKey = try rand(32)
			let serverConfig = Config{certificates: [pair], alpn: ["http/1.1"], minVersion: Version.TLS12, maxVersion: Version.TLS12, sessionTicketKey: ticketKey}
			let cache = new SessionCache()
			let clientConfig = Config{serverName: "localhost", rootCAs: try poolOf(testECCertPEM), alpn: ["http/1.1"], minVersion: Version.TLS12, sessionCache: cache}
			let ln = try listenLoopback()

			let first = new ServerReport()
			let full = try echoOver(ln, serverConfig, clientConfig, first)
			assert full.version == Version.TLS12 && !full.resumed
			assert first.failure == "" && !first.state.resumed
			assert cache.count() == 1
			let kept = cache.get("localhost")
			fail "no session" when kept is none
			assert kept.version == Version.TLS12 && kept.psk.len() == masterSecretSize

			let second = new ServerReport()
			let again = try echoOver(ln, serverConfig, clientConfig, second)
			assert again.version == Version.TLS12 && again.resumed
			assert again.alpn == "http/1.1"
			assert again.peerCertificates.len() == 1 && again.verifiedChains.len() == 1
			assert second.failure == "" && second.state.resumed && second.echoed == "ping"
			let renewed = cache.get("localhost")
			fail "no session" when renewed is none
			assert renewed.ticket.hex() != kept.ticket.hex()

			// The renewed ticket resumes too.
			let third = new ServerReport()
			assert (try echoOver(ln, serverConfig, clientConfig, third)).resumed
			assert third.failure == ""

			// A ticket key the server no longer holds.
			let rotated = new ServerReport()
			let rotatedConfig = Config{certificates: [pair], alpn: ["http/1.1"], minVersion: Version.TLS12, maxVersion: Version.TLS12, sessionTicketKey: try rand(32)}
			let fresh = try echoOver(ln, rotatedConfig, clientConfig, rotated)
			assert !fresh.resumed && fresh.peerCertificates.len() == 1
			assert rotated.failure == "" && !rotated.state.resumed

			// A server that asks for client certificates issues no ticket
			// and takes none.
			let asking = new ServerReport()
			let askingConfig = Config{certificates: [pair], minVersion: Version.TLS12, maxVersion: Version.TLS12, sessionTicketKey: ticketKey, clientAuth: ClientAuthType.RequestClientCert}
			cache.remove("localhost")
			assert !(try echoOver(ln, askingConfig, clientConfig, asking)).resumed
			assert asking.failure == "" && cache.count() == 0

			// The same client against a server that speaks TLS 1.3: the
			// TLS 1.2 session in the cache is no pre-shared key.
			let seeded = new ServerReport()
			try echoOver(ln, serverConfig, clientConfig, seeded)
			assert cache.count() == 1
			let newer = new ServerReport()
			let newest = try echoOver(ln, Config{certificates: [pair], alpn: ["http/1.1"], minVersion: Version.TLS12, sessionTicketKey: ticketKey}, clientConfig, newer)
			assert newest.version == Version.TLS13 && !newest.resumed
			assert newer.failure == ""
			try ln.close()

			let ticket = NewSessionTicket12{lifetimeHint: 300, ticket: byte[1, 2, 3]}
			let parsed = try parseNewSessionTicket12(marshalNewSessionTicket12(ticket)[4:])
			assert parsed.lifetimeHint == 300 && parsed.ticket.hex() == "010203"
			let hello = ClientHello{random: try rand(32), sessionID: [], cipherSuites: [0xC02B], offersSessionTicket: true, sessionTicket: byte[7, 7]}
			let back = try parseClientHello(marshalClientHello(hello)[4:])
			assert back.offersSessionTicket && back.sessionTicket.hex() == "0707"
			let asks = try parseClientHello(marshalClientHello(ClientHello{random: try rand(32), sessionID: [], cipherSuites: [0xC02B], offersSessionTicket: true})[4:])
			assert asks.offersSessionTicket && asks.sessionTicket.len() == 0
		}

		// Versions that do not meet, and the downgrade sentinel.
		@test()
		def TestVersionRefusals() !none {
			let pair = try parseKeyPair(testECCertPEM, testECKeyPEM)
			let roots = try poolOf(testECCertPEM)
			let ln = try listenLoopback()

			// A TLS 1.3 client against a server that stops at TLS 1.2.
			let oldServer = new ServerReport()
			let reason = try refusalOf(ln, Config{certificates: [pair], maxVersion: Version.TLS12}, Config{serverName: "localhost", rootCAs: roots, minVersion: Version.TLS13}, oldServer)
			assert reason.contains("ProtocolVersion")
			assert oldServer.failure.contains("no protocol version in common")

			// A client that stops at TLS 1.2 against a TLS 1.3 server.
			let newServer = new ServerReport()
			reason = try refusalOf(ln, Config{certificates: [pair], minVersion: Version.TLS13}, Config{serverName: "localhost", rootCAs: roots, maxVersion: Version.TLS12}, newServer)
			assert reason != ""
			assert newServer.failure.contains("does not offer TLS 1.3")

			// The sentinel in the random of a TLS 1.2 answer to a client
			// that offered TLS 1.3: a downgrade, refused.
			let forged = new ServerReport()
			let task = async serveForged(ln, Config{certificates: [pair], minVersion: Version.TLS12, maxVersion: Version.TLS12}, forged)
			let raw = try net.dialStream(ln.address().str(), 5s)
			let conn = client(raw, Config{serverName: "localhost", rootCAs: roots, minVersion: Version.TLS12})
			let downgrade = ""
			conn.handshake(5s) onerror (err error) {
				downgrade = err.message
				recover none
			}
			conn.close() onerror recover none
			await task
			assert downgrade.contains("downgrade sentinel")
			try ln.close()
		}
	}
}
