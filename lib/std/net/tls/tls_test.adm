		internal def unhex(text string) byte[] {
			return hexdecode(text) onerror recover []
		}

		internal def lower(data byte[]) string {
			return data.hex().lower()
		}

		internal def readFailure(layer RecordLayer) string {
			let reason = "ok"
			layer.read() onerror (err error) {
				reason = "alert {int(err.alert)}" when err is TLSError
				recover Record{contentType: 0, payload: []}
			}
			return reason
		}

		@test()
		def TestHKDFExpandLabel() !none {
			let early = unhex(rfcEarlySecret)
			let derived = try deriveSecret(Hash.SHA256, early, "derived", unhex("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"))
			assert lower(derived) == "6f2615a108c702c5678f54fc9dbab69716c076189c48250cebeac3576c3611ba"
			let (key, iv) = try trafficKeys(Hash.SHA256, unhex(rfcServerHsTraffic), 16)
			assert lower(key) == rfcServerHsKey
			assert lower(iv) == rfcServerHsIV
		}

		@test()
		def TestKeyScheduleRFC8448() !none {
			let schedule = new KeySchedule(Hash.SHA256)
			schedule.deriveEarly()
			assert lower(schedule.earlySecret) == rfcEarlySecret
			schedule.update(unhex(rfcClientHello))
			schedule.update(unhex(rfcServerHello))
			try schedule.deriveHandshake(unhex(rfcSharedSecret))
			assert lower(schedule.handshakeSecret) == rfcHandshakeSecret
			assert lower(schedule.clientHandshakeTrafficSecret) == rfcClientHsTraffic
			assert lower(schedule.serverHandshakeTrafficSecret) == rfcServerHsTraffic

			let flight = unhex(rfcServerFlightPayload)
			let finishedAt = flight.len() - 36
			schedule.update(flight[0:finishedAt])
			assert lower(try schedule.verifyData(schedule.serverHandshakeTrafficSecret)) == rfcServerFinishedVerify
			schedule.update(flight[finishedAt:])
			try schedule.deriveMaster()
			assert lower(schedule.masterSecret) == rfcMasterSecret
			assert lower(schedule.clientTrafficSecret) == rfcClientApTraffic
			assert lower(schedule.serverTrafficSecret) == rfcServerApTraffic
			assert lower(schedule.exporterMasterSecret) == rfcExporterMaster

			let clientVerify = try schedule.verifyData(schedule.clientHandshakeTrafficSecret)
			assert lower(clientVerify) == rfcClientFinishedVerify
			schedule.update(byte[20, 0, 0, 32] + clientVerify)
			try schedule.deriveResumption()
			assert lower(schedule.resumptionMasterSecret) == rfcResumptionMaster
			assert lower(try resumptionPSK(Hash.SHA256, schedule.resumptionMasterSecret, byte[0, 0])) == rfcResumptionPSK
		}

		@test()
		def TestRecordLayerPlaintext() !none {
			let out = new Buffer()
			let input = new Buffer(unhex(rfcServerHelloRecord))
			let layer = new RecordLayer(input, out)
			try layer.write(recordHandshake, unhex(rfcClientHello))
			assert lower(out.bytes()) == rfcClientHelloRecord
			let record = try layer.read()
			assert record.contentType == recordHandshake
			assert lower(record.payload) == rfcServerHello

			// Fragmentation at 2^14.
			let big byte[]
			big.len(20000)
			let sink = new Buffer()
			let writer = new RecordLayer(new Buffer(), sink)
			writer.version = 0x0303
			try writer.write(recordHandshake, big)
			assert sink.len() == 20000 + 10
			let back = new RecordLayer(new Buffer(sink.bytes()), new Buffer())
			assert (try back.read()).payload.len() == 16384
			assert (try back.read()).payload.len() == 20000 - 16384
			assert readFailure(back) == "alert 50"
		}

		@test()
		def TestRecordLayerProtectedRFC8448() !none {
			let out = new Buffer()
			let input = new Buffer(unhex(rfcServerFlightRecord))
			let layer = new RecordLayer(input, out)
			layer.version = 0x0303
			layer.setReadKey(try suiteAEAD(CipherSuite.AES128GCMSHA256, unhex(rfcServerHsKey)), unhex(rfcServerHsIV))
			let flight = try layer.read()
			assert flight.contentType == recordHandshake
			assert lower(flight.payload) == rfcServerFlightPayload

			layer.setWriteKey(try suiteAEAD(CipherSuite.AES128GCMSHA256, unhex(rfcClientHsKey)), unhex(rfcClientHsIV))
			try layer.write(recordHandshake, byte[20, 0, 0, 32] + unhex(rfcClientFinishedVerify))
			assert lower(out.bytes()) == rfcClientFinishedRecord

			// Sequence numbers advance per record in both directions.
			let serverStream = new Buffer(unhex(rfcTicketRecord) + unhex(rfcServerAppRecord) + unhex(rfcServerAlertRecord))
			let sink = new Buffer()
			let app = new RecordLayer(serverStream, sink)
			app.version = 0x0303
			app.setReadKey(try suiteAEAD(CipherSuite.AES128GCMSHA256, unhex(rfcServerApKey)), unhex(rfcServerApIV))
			app.setWriteKey(try suiteAEAD(CipherSuite.AES128GCMSHA256, unhex(rfcClientApKey)), unhex(rfcClientApIV))
			let ticket = try app.read()
			assert ticket.contentType == recordHandshake
			assert lower(ticket.payload) == rfcTicketPayload
			let data = try app.read()
			assert data.contentType == recordApplicationData
			assert lower(data.payload) == rfcAppData
			let alert = try app.read()
			assert alert.contentType == recordAlert
			assert lower(alert.payload) == "0100"
			try app.write(recordApplicationData, unhex(rfcAppData))
			assert lower(sink.bytes()) == rfcClientAppRecord
			sink.reset()
			try app.writeAlert(Alert.CloseNotify, false)
			assert lower(sink.bytes()) == rfcClientAlertRecord

			// A modified record fails authentication.
			let tampered = unhex(rfcServerAppRecord)
			tampered[10] = tampered[10] ^ 1
			let bad = new RecordLayer(new Buffer(tampered), new Buffer())
			bad.setReadKey(try suiteAEAD(CipherSuite.AES128GCMSHA256, unhex(rfcServerApKey)), unhex(rfcServerApIV))
			assert readFailure(bad) == "alert 20"
		}

		@test()
		def TestClientHelloCodec() !none {
			let hello = try parseClientHello(unhex(rfcClientHello)[4:])
			assert hello.serverName == "server"
			assert hello.cipherSuites.equals([0x1301, 0x1303, 0x1302])
			assert hello.supportedVersions.equals([0x0304])
			assert hello.supportedGroups[0] == groupX25519
			assert hello.keyShares.len() == 1
			assert hello.keyShares[0].group == groupX25519
			assert lower(hello.keyShares[0].data) == "99381de560e4bd43d23d8e435a7dbafeb3c06e51c13cae4d5413691e529aaf2c"
			assert hello.signatureAlgorithms.len() == 15
			assert hello.pskModes.equals([pskModeDHE])
			assert hello.sessionID.len() == 0

			let mine = ClientHello{random: unhex(rfcServerPublic), sessionID: unhex("0102"), cipherSuites: [0x1301], serverName: "example.com", supportedVersions: [0x0304], supportedGroups: [groupX25519, groupSecp256r1], keyShares: [KeyShare{group:groupX25519, data:unhex(rfcClientPrivate)}], signatureAlgorithms: signatureSchemeCodes(supportedSignatureSchemes()), alpnProtocols: ["h2", "http/1.1"], pskModes: [pskModeDHE], pskIdentities: [PSKIdentity{identity:unhex("aabb"), obfuscatedTicketAge:0xfad6aac5}], pskBinders: [unhex(rfcEarlySecret)], cookie: unhex("cc")}
			let encoded = marshalClientHello(mine)
			assert clientHelloBindersLength(mine) == 2 + 1 + 32
			assert int(encoded[0]) == handshakeClientHello
			let back = try parseClientHello(encoded[4:])
			assert back.serverName == "example.com"
			assert lower(back.sessionID) == "0102"
			assert back.alpnProtocols.equals(["h2", "http/1.1"])
			assert back.supportedGroups.equals([groupX25519, groupSecp256r1])
			assert back.signatureAlgorithms.equals(signatureSchemeCodes(supportedSignatureSchemes()))
			assert back.pskIdentities.len() == 1
			assert back.pskIdentities[0].obfuscatedTicketAge == 0xfad6aac5
			assert lower(back.pskBinders[0]) == rfcEarlySecret
			assert lower(back.cookie) == "cc"
			// The pre_shared_key extension is the last one.
			assert lower(encoded[encoded.len() - 33:]) == "20" + rfcEarlySecret
		}

		@test()
		def TestServerHelloCodec() !none {
			let hello = try parseServerHello(unhex(rfcServerHello)[4:])
			assert !hello.isHelloRetryRequest
			assert hello.cipherSuite == 0x1301
			assert hello.supportedVersion == 0x0304
			assert hello.sessionID.len() == 0
			let share = hello.keyShare
			assert !(share is none)
			assert share.group == groupX25519 unless share is none
			assert lower(share.data) == rfcServerPublic unless share is none
			assert lower(marshalServerHello(hello)) == rfcServerHello

			let retry = ServerHello{random: unhex(helloRetryRequestRandom), cipherSuite: 0x1302, supportedVersion: 0x0304, selectedGroup: groupSecp256r1, cookie: unhex("0102")}
			let parsed = try parseServerHello(marshalServerHello(retry)[4:])
			assert parsed.isHelloRetryRequest
			assert parsed.selectedGroup == groupSecp256r1
			assert parsed.keyShare is none
			assert lower(parsed.cookie) == "0102"
		}

		@test()
		def TestServerFlightCodec() !none {
			let flight = unhex(rfcServerFlightPayload)
			let kinds int[]
			let bodies byte[][]
			for {
				let next = splitHandshake(flight)
				break when next is none
				let (kind, body, used) = next
				kinds.push(kind)
				bodies.push(body)
				flight = flight[used:]
			}
			assert flight.len() == 0
			assert kinds.equals([handshakeEncryptedExtensions, handshakeCertificate, handshakeCertificateVerify, handshakeFinished])
			let ee = try parseEncryptedExtensions(bodies[0])
			assert ee.alpnProtocol == ""
			let chain = try parseCertificateMessage(bodies[1])
			assert chain.requestContext.len() == 0
			assert chain.entries.len() == 1
			assert chain.entries[0].data.len() == 432
			assert lower(marshalCertificateMessage(chain)) == lower(handshakeMessage(handshakeCertificate, bodies[1]))
			let verify = try parseCertificateVerify(bodies[2])
			assert verify.algorithm == int(SignatureScheme.RSAPSSRSAESHA256)
			assert verify.signature.len() == 128
			assert bodies[3].len() == 32
			assert splitHandshake(unhex("0b0001")) is none

			let ticket = try parseNewSessionTicket(unhex(rfcTicketPayload)[4:])
			assert ticket.lifetime == 30
			assert ticket.ageAdd == 0xfad6aac5
			assert lower(ticket.nonce) == "0000"
			assert ticket.ticket.len() == 178
			assert ticket.maxEarlyData == 1024
			assert lower(marshalNewSessionTicket(ticket)) == rfcTicketPayload
			assert try parseKeyUpdate(marshalKeyUpdate(true)[4:])
			assert !(try parseKeyUpdate(marshalKeyUpdate(false)[4:]))
			let content = certificateVerifyContent("TLS 1.3, server CertificateVerify", unhex("0000"))
			assert content.len() == 64 + 33 + 1 + 2
			assert content[0] == 0x20 && content[64] == 0x54 && content[97] == 0
		}

		internal def preparedConn(serverBytes byte[], sink Buffer, config Config) !Conn {
			let conn = new Conn(new Buffer(serverBytes), sink, config)
			let hs = new ClientHandshake(config, conn.records)
			hs.hello = try parseClientHello(unhex(rfcClientHello)[4:])
			hs.helloBytes = unhex(rfcClientHello)
			hs.x25519Private = unhex(rfcClientPrivate)
			conn.prepared = hs
			return conn
		}

		internal def handshakeFailure(conn Conn) string {
			let reason = "ok"
			conn.handshake() onerror (err error) {
				reason = "alert {int(err.alert)}: {err.message}" when err is TLSError
				reason = "other: {err.message}" unless err is TLSError
				recover none
			}
			return reason
		}

		@test()
		def TestClientHandshakeRFC8448() !none {
			let sink = new Buffer()
			let server = unhex(rfcServerHelloRecord) + unhex(rfcServerFlightRecord) + unhex(rfcTicketRecord) + unhex(rfcServerAppRecord) + unhex(rfcServerAlertRecord)
			let conn = try preparedConn(server, sink, Config{serverName: "server", insecureSkipVerify: true})
			try conn.handshake()
			let state = conn.connectionState()
			assert state.handshakeComplete
			assert state.cipherSuite == CipherSuite.AES128GCMSHA256
			assert state.version == Version.TLS13
			assert state.alpn == ""
			assert state.peerCertificates.len() == 1
			assert state.verifiedChains.len() == 0
			assert lower(sink.bytes()) == rfcClientHelloRecord + rfcClientFinishedRecord
			assert lower(conn.resumptionSecret) == rfcResumptionMaster
			sink.reset()

			let buf byte[]
			buf.len(100)
			let n = try conn.read(buf)
			assert n == 50
			assert lower(buf[0:n]) == rfcAppData
			assert conn.tickets.len() == 1
			assert conn.tickets[0].lifetime == 30
			assert (try conn.write(unhex(rfcAppData))) == 50
			assert lower(sink.bytes()) == rfcClientAppRecord
			sink.reset()
			assert (try conn.read(buf)) == 0
			assert (try conn.read(buf)) == 0
			try conn.close()
			assert lower(sink.bytes()) == rfcClientAlertRecord
			assert !conn.isOpen()
		}

		@test()
		def TestClientHandshakeRejects() !none {
			// A modified server Finished: decrypt_error goes out, protected
			// under the handshake key.
			let flight = unhex(rfcServerFlightRecord)
			flight[flight.len() - 20] = flight[flight.len() - 20] ^ 1
			let sink = new Buffer()
			let bad = try preparedConn(unhex(rfcServerHelloRecord) + flight, sink, Config{serverName: "server", insecureSkipVerify: true})
			assert handshakeFailure(bad).startsWith("alert 20")

			// The chain is checked unless verification is skipped: the RFC
			// certificate is self-signed and expired.
			let chain = try parseCertificateMessage(unhex(rfcServerFlightPayload)[40 + 4:40 + 4 + 441])
			let roots = new CertPool()
			roots.addCert(try parseCertificate(chain.entries[0].data))
			let sink2 = new Buffer()
			let expired = try preparedConn(unhex(rfcServerHelloRecord) + unhex(rfcServerFlightRecord), sink2, Config{serverName: "rsa", rootCAs: roots})
			let reason = handshakeFailure(expired)
			assert reason.startsWith("alert 42")
			let written = sink2.bytes()
			assert written.len() == unhex(rfcClientHelloRecord).len() + 5 + 2 + 1 + 16
			assert int(written[written.len() - 24]) == recordApplicationData

			// A name is required unless verification is skipped.
			let unnamed = try preparedConn(unhex(rfcServerHelloRecord), new Buffer(), Config{})
			assert handshakeFailure(unnamed).startsWith("alert 80")
		}

		@test()
		def TestSuitesAndAlerts() !none {
			assert defaultCipherSuites().len() == 3
			let picked = cipherSuiteOf(0x1302)
			assert !(picked is none)
			assert picked == CipherSuite.AES256GCMSHA384 unless picked is none
			assert cipherSuiteOf(0x1304) is none
			assert suiteHash(CipherSuite.AES256GCMSHA384) == Hash.SHA384
			assert suiteHash(CipherSuite.ChaCha20Poly1305SHA256) == Hash.SHA256
			assert suiteKeySize(CipherSuite.AES128GCMSHA256) == 16
			assert suiteKeySize(CipherSuite.ChaCha20Poly1305SHA256) == 32
			let scheme = schemeHash(SignatureScheme.ECDSASecp384r1SHA384)
			assert !(scheme is none)
			assert scheme == Hash.SHA384 unless scheme is none
			assert schemeHash(SignatureScheme.Ed25519) is none
			assert alertOf(20) == Alert.BadRecordMAC
			assert alertOf(7) == Alert.Unknown
			assert int(Alert.CloseNotify) == 0
			let (key, iv) = try trafficKeyFor(CipherSuite.AES128GCMSHA256, Hash.SHA256, unhex(rfcServerHsTraffic))
			assert key.nonceSize() == 12 && iv.len() == 12
			let copy = withServerName(Config{alpn: ["h2"], insecureSkipVerify: true}, "example.com")
			assert copy.serverName == "example.com" && copy.alpn.equals(["h2"]) && copy.insecureSkipVerify
			assert lower(try hkdfExpandLabel(Hash.SHA256, unhex(rfcServerHsTraffic), "key", [], 16)) == rfcServerHsKey
			assert (try finishedKey(Hash.SHA256, unhex(rfcServerHsTraffic))).len() == 32
			assert (try nextTrafficSecret(Hash.SHA256, unhex(rfcServerApTraffic))).len() == 32
		}

		@test()
		def TestCursorAndBuilders() !none {
			let c = new Cursor(unhex("01" + "0203" + "040506" + "0708090a" + "02aabb" + "0001cc" + "000001dd" + "0004000100ff"))
			assert c.remaining() == 26
			assert (try c.u8()) == 1
			assert (try c.u16()) == 0x0203
			assert (try c.u24()) == 0x040506
			assert (try c.u32()) == 0x0708090a
			assert lower(try c.vec8()) == "aabb"
			assert lower(try c.vec16()) == "cc"
			assert lower(try c.vec24()) == "dd"
			assert (try c.u16List()).equals([1, 0xff])
			assert c.done()
			let short = new Cursor(unhex("00"))
			let truncated = "ok"
			short.u16() onerror (err error) {
				truncated = "alert {int(err.alert)}" when err is TLSError
				recover 0
			}
			assert truncated == "alert 50"

			assert lower(marshalEncryptedExtensions(EncryptedExtensions{alpnProtocol: "h2"})) == "0800000b0009001000050003026832"
			assert (try parseEncryptedExtensions(marshalEncryptedExtensions(EncryptedExtensions{alpnProtocol: "h2"})[4:])).alpnProtocol == "h2"
			let request = try parseCertificateRequest(unhex("00" + "0008" + "000d00040002" + "0403"))
			assert request.requestContext.len() == 0 && request.signatureAlgorithms.equals([int(SignatureScheme.ECDSASecp256r1SHA256)])
			let cv = try parseCertificateVerify(marshalCertificateVerify(CertificateVerify{algorithm: int(SignatureScheme.RSAPSSRSAESHA256), signature: unhex("0102")})[4:])
			assert cv.algorithm == int(SignatureScheme.RSAPSSRSAESHA256) && lower(cv.signature) == "0102"
			assert lower(marshalFinished(unhex("aa"))) == "14000001aa"
		}

		@test()
		def TestKeyScheduleMessageHash() !none {
			let schedule = new KeySchedule(Hash.SHA256)
			schedule.update(unhex(rfcClientHello))
			let sum = schedule.transcriptHash()
			schedule.replaceWithMessageHash()
			assert lower(schedule.transcript) == "fe000020" + lower(sum)
		}

		@test()
		def TestClientHandshakeRun() !none {
			let sink = new Buffer()
			let records = new RecordLayer(new Buffer(unhex(rfcServerHelloRecord) + unhex(rfcServerFlightRecord)), sink)
			assert !records.isProtected()
			let hs = new ClientHandshake(Config{insecureSkipVerify: true}, records)
			hs.hello = try parseClientHello(unhex(rfcClientHello)[4:])
			hs.helloBytes = unhex(rfcClientHello)
			hs.x25519Private = unhex(rfcClientPrivate)
			try hs.run()
			assert records.isProtected()
			assert hs.state.handshakeComplete
			assert lower(hs.schedule.clientTrafficSecret) == rfcClientApTraffic
			assert lower(sink.bytes()) == rfcClientHelloRecord + rfcClientFinishedRecord
		}

		@test()
		def TestConnOverSockets() !none {
			// A closed descriptor: the wrapper builds, addresses are empty,
			// and the handshake fails on the transport.
			let conn = client(new net.Connection(-1), Config{serverName: "example.com"})
			assert conn.remoteAddr().host == "" && conn.localAddr().host == ""
			assert !conn.connectionState().handshakeComplete
			let reason = "ok"
			conn.writeAll(unhex("00")) onerror (err error) {
				reason = "net" when err is net.NetError
				recover none
			}
			assert reason == "net"
			let refused = "ok"
			dial("127.0.0.1:1", Config{}, 2s) onerror (err error) {
				refused = "net" when err is net.NetError
				recover conn
			}
			assert refused == "net"
		}

		@test()
		def TestResumptionBinderRFC8448() !none {
			// The ticket of §3 offered in §4: its PSK, the early secret it
			// extracts, and the binder over the ClientHello prefix.
			let psk = try resumptionPSK(Hash.SHA256, unhex(rfcResumptionMaster), unhex("0000"))
			assert lower(psk) == rfcResumptionPSK
			let hello = unhex(rfcRes4ClientHello)
			let prefix = hello[0:hello.len() - 35]
			let binder = try pskBinder(Hash.SHA256, psk, digest(Hash.SHA256, prefix))
			assert lower(binder) == lower(hello[hello.len() - 32:])
			let parsed = try parseClientHello(hello[4:])
			assert parsed.pskIdentities.len() == 1 && parsed.pskBinders.len() == 1
			assert lower(parsed.pskIdentities[0].identity) == lower((try parseNewSessionTicket(unhex(rfcTicketPayload)[4:])).ticket)
			assert parsed.earlyData
			assert clientHelloBindersLength(parsed) == 35
		}

		@test()
		def TestResumedHandshakeRFC8448() !none {
			let sink = new Buffer()
			let records = new RecordLayer(new Buffer(unhex(rfcRes4ServerHelloRecord) + unhex(rfcRes4ServerFlightRecord)), sink)
			let hs = new ClientHandshake(Config{serverName: "server", insecureSkipVerify: true}, records)
			hs.hello = try parseClientHello(unhex(rfcRes4ClientHello)[4:])
			hs.helloBytes = unhex(rfcRes4ClientHello)
			hs.x25519Private = unhex(rfcRes4ClientPrivate)
			hs.psk = unhex(rfcResumptionPSK)
			hs.session = ClientSession{ticket: hs.hello.pskIdentities[0].identity, psk: hs.psk, lifetime: 30, ageAdd: 0, receivedAt: time.now(), suite: CipherSuite.AES128GCMSHA256}
			try hs.run()
			assert hs.resumed && hs.state.resumed && hs.state.handshakeComplete
			assert lower(hs.schedule.earlySecret) == rfcRes4EarlySecret
			assert lower(hs.schedule.clientHandshakeTrafficSecret) == rfcRes4ClientHsTraffic
			assert lower(hs.schedule.serverHandshakeTrafficSecret) == rfcRes4ServerHsTraffic
			assert lower(hs.schedule.serverTrafficSecret) == rfcRes4ServerApTraffic
			// The trace's client sends early data and EndOfEarlyData, which
			// this client never offers; up to the server Finished the bytes
			// agree, after it only the record count does.
			let written = sink.bytes()
			assert lower(written[0:unhex(rfcRes4ClientHelloRecord).len()]) == rfcRes4ClientHelloRecord
			assert written.len() == unhex(rfcRes4ClientHelloRecord).len() + 58
		}

		@test()
		def TestHelloRetryRequestRFC8448() !none {
			let sink = new Buffer()
			let server = unhex(rfcHrrRetryRecord) + unhex(rfcHrrServerHelloRecord) + unhex(rfcHrrServerFlightRecord)
			let conn = new Conn(new Buffer(server), sink, Config{serverName: "server", insecureSkipVerify: true})
			let hs = new ClientHandshake(conn.config, conn.records)
			hs.hello = try parseClientHello(unhex(rfcHrrClientHello1)[4:])
			hs.helloBytes = unhex(rfcHrrClientHello1)
			hs.x25519Private = unhex(rfcHrrClientPrivate)
			hs.ecdheScalar = parseBigInt(unhex(rfcHrrP256Private))
			conn.prepared = hs
			try conn.handshake()
			assert conn.connectionState().handshakeComplete
			assert lower(sink.bytes()) == rfcHrrClientHello1Record + rfcHrrClientHello2Record + rfcHrrClientFinishedRecord
			assert lower(hs.schedule.clientTrafficSecret) == rfcHrrClientApTraffic
			assert hs.hello.cookie.len() == 116 - 2
			assert hs.hello.keyShares.len() == 1 && hs.hello.keyShares[0].group == groupSecp256r1
			sink.reset()
			try conn.close()
			assert lower(sink.bytes()) == rfcHrrClientAlertRecord
		}

		@test()
		def TestRetryClientHelloBytes() !none {
			// The second ClientHello of RFC 8448 §5 is the first with the
			// P-256 share and the cookie patched in, padded to 512.
			let second = unhex(rfcHrrClientHello2Record)[5:]
			let parsed = try parseClientHello(second[4:])
			let share = parsed.keyShares[0]
			let body = vec16(u16(share.group) + vec16(share.data))
			let rebuilt = try retryClientHello(unhex(rfcHrrClientHello1), body, parsed.cookie)
			assert lower(rebuilt) == lower(second)
			assert rebuilt.len() == 512

			// Padding applies from 256 to 507 bytes and keeps pre_shared_key last.
			let filler byte[]
			filler.len(200)
			let psk = extension(extensionPreSharedKey, unhex("0000" + "0000"))
			let padded = assembleClientHello(filler, extension(extensionServerName, filler), psk)
			assert padded.len() == 512
			assert lower(padded[padded.len() - psk.len():]) == lower(psk)
			let small byte[]
			small.len(100)
			assert assembleClientHello(small, [], []).len() == 4 + 100 + 2
		}

		@test()
		def TestSessionCache() !none {
			let cache = new SessionCache()
			assert cache.get("a") is none
			let fresh = ClientSession{ticket: unhex("01"), psk: unhex("02"), lifetime: 60, ageAdd: 5, receivedAt: time.now(), suite: CipherSuite.AES128GCMSHA256}
			cache.put("a", fresh)
			assert cache.count() == 1
			assert !(cache.get("a") is none)
			assert obfuscatedTicketAge(fresh) >= 5 && obfuscatedTicketAge(fresh) < 5 + 1000
			assert sessionIsValid(fresh)
			let stale = ClientSession{ticket: unhex("01"), psk: unhex("02"), lifetime: 0, ageAdd: 0, receivedAt: time.now(), suite: CipherSuite.AES128GCMSHA256}
			cache.put("b", stale)
			assert cache.get("b") is none
			assert cache.count() == 1
			cache.remove("a")
			assert cache.count() == 0

			// A full handshake stores the ticket the server sends.
			let sink = new Buffer()
			let server = unhex(rfcServerHelloRecord) + unhex(rfcServerFlightRecord) + unhex(rfcTicketRecord) + unhex(rfcServerAppRecord)
			let conn = try preparedConn(server, sink, Config{serverName: "server", insecureSkipVerify: true, sessionCache: cache})
			let buf byte[]
			buf.len(64)
			assert (try conn.read(buf)) == 50
			let stored = cache.get("server")
			assert !(stored is none)
			assert lower(stored.psk) == rfcResumptionPSK unless stored is none
			assert stored.lifetime == 30 unless stored is none
			assert stored.peerCertificates.len() == 1 unless stored is none

			// The next ClientHello for that name offers it, with a binder
			// the RFC 8448 math accepts.
			let offer = new ClientHandshake(Config{serverName: "server", insecureSkipVerify: true, sessionCache: cache}, new RecordLayer(new Buffer(), new Buffer()))
			try offer.buildHello()
			let parsed = try parseClientHello(offer.helloBytes[4:])
			assert parsed.pskIdentities.len() == 1
			assert lower(parsed.pskIdentities[0].identity) == lower(stored.ticket) unless stored is none
			let cut = offer.helloBytes.len() - clientHelloBindersLength(parsed)
			let expected = try pskBinder(Hash.SHA256, unhex(rfcResumptionPSK), digest(Hash.SHA256, offer.helloBytes[0:cut]))
			assert lower(parsed.pskBinders[0]) == lower(expected)
			assert offer.helloBytes.len() == 512
		}

		// The server side of RFC 8448 §3: given the trace's ClientHello and
		// the server's ephemeral key, the ServerHello and the handshake
		// secrets come out byte for byte; the flight differs only by the
		// signature, so it is checked structurally.
		@test()
		def TestServerHandshakeRFC8448() !none {
			assert lower(try x25519Base(unhex(rfcServerPrivate))) == rfcServerPublic
			let input = new Buffer(unhex(rfcClientHelloRecord))
			let sink = new Buffer()
			let pair = try parseKeyPair(testRSACertPEM, testRSAKeyPEM)
			let conn = new Conn(input, sink, Config{certificates: [pair]}, false)
			let hs = new ServerHandshake(conn.config, conn.records)
			hs.x25519Private = unhex(rfcServerPrivate)
			hs.random = unhex(rfcServerHello)[6:38]
			try hs.readClientHello()
			assert hs.suite == CipherSuite.AES128GCMSHA256
			assert hs.group == groupX25519
			assert picks(hs.scheme, SignatureScheme.RSAPSSRSAESHA256)
			assert hs.hello.serverName == "server"
			assert !hs.resumed
			try hs.sendServerFlight()
			let out = sink.bytes()
			let helloLen = rfcServerHelloRecord.len() / 2
			assert lower(out[0:helloLen]) == rfcServerHelloRecord
			assert lower(hs.schedule.earlySecret) == rfcEarlySecret
			assert lower(hs.schedule.handshakeSecret) == rfcHandshakeSecret
			assert lower(hs.schedule.clientHandshakeTrafficSecret) == rfcClientHsTraffic
			assert lower(hs.schedule.serverHandshakeTrafficSecret) == rfcServerHsTraffic

			// The flight decrypts under the RFC's server handshake key and
			// holds EncryptedExtensions, Certificate, CertificateVerify and
			// Finished.
			let peer = new RecordLayer(new Buffer(out[helloLen:]), new Buffer())
			peer.setReadKey(try suiteAEAD(CipherSuite.AES128GCMSHA256, unhex(rfcServerHsKey)), unhex(rfcServerHsIV))
			let record = try peer.read()
			assert record.contentType == recordHandshake
			let kinds int[]
			let rest = record.payload
			for {
				let next = splitHandshake(rest)
				break when next is none
				let (kind, body, used) = next
				kinds.push(kind)
				rest = rest[used:]
				if kind == handshakeCertificate {
					let msg = try parseCertificateMessage(body)
					assert msg.entries.len() == 1 && msg.entries[0].data.hex() == pair.chain[0].hex()
				}
				if kind == handshakeCertificateVerify {
					assert (try parseCertificateVerify(body)).algorithm == int(SignatureScheme.RSAPSSRSAESHA256)
				}
			}
			assert kinds.len() == 4
			assert kinds[0] == handshakeEncryptedExtensions && kinds[1] == handshakeCertificate
			assert kinds[2] == handshakeCertificateVerify && kinds[3] == handshakeFinished

			// The client's Finished over the transcript so far completes it.
			let clientSide = new RecordLayer(new Buffer(), input)
			clientSide.version = 0x0303
			let (key, iv) = try trafficKeyFor(CipherSuite.AES128GCMSHA256, Hash.SHA256, hs.schedule.clientHandshakeTrafficSecret)
			clientSide.setWriteKey(key, iv)
			try clientSide.write(recordHandshake, marshalFinished(try hs.schedule.verifyData(hs.schedule.clientHandshakeTrafficSecret)))
			try hs.readClientFinished()
			assert hs.state.handshakeComplete
			assert hs.state.serverName == "server"
			assert hs.schedule.resumptionMasterSecret.len() == 32
			assert hs.ticket is none
		}

		@test()
		def TestServerRejects() !none {
			// No certificate configured.
			let input = new Buffer(unhex(rfcClientHelloRecord))
			let sink = new Buffer()
			let bare = new Conn(input, sink, Config{}, false)
			let reason = "ok"
			bare.handshake() onerror (err error) {
				reason = err.message
				recover none
			}
			assert reason.contains("no certificate configured")
			// The alert went out in the clear.
			assert sink.bytes().len() == 7 && sink.bytes()[0] == recordAlert && int(sink.bytes()[6]) == int(Alert.InternalError)

			// Nothing in common: a ClientHello offering only a suite this
			// module does not implement.
			let pair = try parseKeyPair(testECCertPEM, testECKeyPEM)
			let odd = try parseClientHello(unhex(rfcClientHello)[4:])
			odd.cipherSuites = [0x00ff]
			let oddMessage = marshalClientHello(odd)
			let picky = new Conn(new Buffer(byte[22, 3, 1] + u16(oddMessage.len()) + oddMessage), new Buffer(), Config{certificates: [pair]}, false)
			reason = "ok"
			picky.handshake() onerror (err error) {
				reason = "alert {int(err.alert)}" when err is TLSError
				recover none
			}
			assert reason == "alert {int(Alert.HandshakeFailure)}"

			// Not a ClientHello.
			let wrong = new Conn(new Buffer(unhex(rfcServerHelloRecord)), new Buffer(), Config{certificates: [pair]}, false)
			reason = "ok"
			wrong.handshake() onerror (err error) {
				reason = "alert {int(err.alert)}" when err is TLSError
				recover none
			}
			assert reason == "alert {int(Alert.UnexpectedMessage)}"

			// A server ignores tickets a client sends after the handshake.
			assert !wrong.isClient
		}
	}

	check "TLS server" {
		@test()
		def TestKeyPairs() !none {
			let ec = try parseKeyPair(testECCertPEM, testECKeyPEM)
			assert ec.chain.len() == 1
			let leaf = ec.leaf
			fail "no leaf" when leaf is none
			try leaf.verifyHostname("localhost")
			try leaf.verifyHostname("127.0.0.1")
			let rsa = try parseKeyPair(testRSACertPEM, testRSAKeyPEM)
			assert rsa.chain.len() == 1
			let mismatch = "ok"
			parseKeyPair(testECCertPEM, testRSAKeyPEM) onerror (err error) {
				mismatch = err.message
				recover ec
			}
			assert mismatch.contains("does not match")
			let noCert = "ok"
			parseKeyPair(testECKeyPEM, testECKeyPEM) onerror (err error) {
				noCert = err.message
				recover ec
			}
			assert noCert.contains("no CERTIFICATE")
			let missing = "ok"
			loadKeyPair("/nonexistent/cert.pem", "/nonexistent/key.pem") onerror (err error) {
				missing = "failed"
				recover ec
			}
			assert missing == "failed"
			// From files.
			let stem = "/tmp/adm-tls-test-" + (try rand(8)).hex()
			try os.writeFile(stem + ".crt", testECCertPEM.bytes())
			try os.writeFile(stem + ".key", testECKeyPEM.bytes())
			let loaded = try loadKeyPair(stem + ".crt", stem + ".key")
			os.remove(stem + ".crt") onerror recover none
			os.remove(stem + ".key") onerror recover none
			assert loaded.chain[0].hex() == ec.chain[0].hex()
			assert !(loaded.privateKey is none)
		}

		@test()
		def TestTicketCodec() !none {
			let key = try rand(32)
			let psk = try rand(32)
			let ticket = try sealTicket(key, CipherSuite.AES256GCMSHA384, psk, "h2", 1700000000)
			let (suite, opened, alpn, issued) = try openTicket(key, ticket)
			assert suite == CipherSuite.AES256GCMSHA384
			assert opened.hex() == psk.hex()
			assert alpn == "h2" && issued == 1700000000
			let (_, other, _, _) = openTicket(try rand(32), ticket) onerror recover (CipherSuite.AES128GCMSHA256, [], "", 0)
			assert other.len() == 0
			ticket[20] ^= 1
			let (_, tampered, _, _) = openTicket(key, ticket) onerror recover (CipherSuite.AES128GCMSHA256, [], "", 0)
			assert tampered.len() == 0
		}

		// A client and a server of this module over loopback TCP: ALPN,
		// chain verification against the test root, data both ways, a
		// ticket, and a resumed second connection.
		@test()
		def TestServerClientLoopback() !none {
			let pair = try parseKeyPair(testECCertPEM, testECKeyPEM)
			let ticketKey = try rand(32)
			let serverConfig = Config{certificates: [pair], alpn: ["http/1.1"], sessionTicketKey: ticketKey}
			let cache = new SessionCache()
			let clientConfig = Config{serverName: "localhost", rootCAs: try poolOf(testECCertPEM), alpn: ["h2", "http/1.1"], sessionCache: cache}

			let ln = try listenLoopback()
			let report = new ServerReport()
			let task = async serveOnce(ln, serverConfig, report)
			let conn = try dial(ln.address().str(), clientConfig, 5s)
			let state = conn.connectionState()
			assert state.handshakeComplete && !state.resumed
			assert state.alpn == "http/1.1"
			assert state.cipherSuite == CipherSuite.AES128GCMSHA256
			assert state.peerCertificates.len() == 1
			assert state.verifiedChains.len() == 1
			try conn.write("ping".bytes(), 5s)
			let buf byte[]
			buf.len(64)
			let n = try conn.read(buf, 5s)
			assert string(buf[0:n]) == "PING"
			assert (try conn.read(buf, 5s)) == 0
			assert conn.tickets.len() == 1
			assert cache.count() == 1
			try conn.close()
			await task
			assert report.failure == ""
			assert report.echoed == "ping"
			assert report.state.handshakeComplete && !report.state.resumed
			assert report.state.alpn == "http/1.1"
			assert report.state.serverName == "localhost"

			// The second connection resumes with the ticket.
			let again = new ServerReport()
			let second = async serveOnce(ln, serverConfig, again)
			let resumed = try dial(ln.address().str(), clientConfig, 5s)
			assert resumed.connectionState().resumed
			assert resumed.connectionState().peerCertificates.len() == 1
			assert resumed.connectionState().verifiedChains.len() == 1
			try resumed.write("again".bytes(), 5s)
			n = try resumed.read(buf, 5s)
			assert string(buf[0:n]) == "AGAIN"
			assert (try resumed.read(buf, 5s)) == 0
			try resumed.close()
			await second
			assert again.failure == ""
			assert again.state.resumed
			assert again.state.alpn == "http/1.1"

			// A ticket key the server no longer holds: a full handshake.
			let rotated = new ServerReport()
			let third = async serveOnce(ln, Config{certificates: [pair], alpn: ["http/1.1"], sessionTicketKey: try rand(32)}, rotated)
			let fresh = try dial(ln.address().str(), clientConfig, 5s)
			assert !fresh.connectionState().resumed
			try fresh.write("x".bytes(), 5s)
			assert (try fresh.read(buf, 5s)) == 1
			try fresh.close()
			await third
			assert rotated.failure == ""
			try ln.close()
		}

		// An RSA certificate signs with RSA-PSS, and a server that takes
		// P-256 ahead of the X25519 share the client sent answers with a
		// HelloRetryRequest.
		@test()
		def TestServerRSAHelloRetry() !none {
			let pair = try parseKeyPair(testRSACertPEM, testRSAKeyPEM)
			let serverConfig = Config{certificates: [pair], curvePreferences: [CurveID.P256], cipherSuites: [CipherSuite.ChaCha20Poly1305SHA256]}
			let clientConfig = Config{serverName: "localhost", rootCAs: try poolOf(testRSACertPEM)}
			let ln = try listenLoopback()
			let report = new ServerReport()
			let task = async serveOnce(ln, serverConfig, report)
			let conn = try dial(ln.address().str(), clientConfig, 5s)
			let state = conn.connectionState()
			assert state.handshakeComplete
			assert state.cipherSuite == CipherSuite.ChaCha20Poly1305SHA256
			assert state.alpn == ""
			try conn.write("retry".bytes(), 5s)
			let buf byte[]
			buf.len(64)
			let n = try conn.read(buf, 5s)
			assert string(buf[0:n]) == "RETRY"
			try conn.close()
			await task
			assert report.failure == ""
			assert report.state.cipherSuite == CipherSuite.ChaCha20Poly1305SHA256
			// No ticket key: nothing to resume with.
			assert conn.tickets.len() == 0

			// A name the certificate does not carry: the client rejects the
			// chain and the server sees its alert.
			let rejected = new ServerReport()
			let second = async serveOnce(ln, serverConfig, rejected)
			let reason = "ok"
			dial(ln.address().str(), Config{serverName: "other.example", rootCAs: try poolOf(testRSACertPEM)}, 5s) onerror (err error) {
				reason = err.message
				recover conn
			}
			assert reason.contains("tls:")
			await second
			fail "server saw: {rejected.failure}" unless rejected.failure.contains("alert")
			try ln.close()
		}

		// getCertificate picks the chain per ClientHello, ahead of the list.
		@test()
		def TestServerGetCertificate() !none {
			let ec = try parseKeyPair(testECCertPEM, testECKeyPEM)
			let rsa = try parseKeyPair(testRSACertPEM, testRSAKeyPEM)
			let seen string[]
			let serverConfig = Config{certificates: [ec], getCertificate: def (info ClientHelloInfo) !?KeyPair {
				seen.push(info.serverName)
				return rsa when info.serverName == "localhost"
				return none
			}}
			let ln = try listenLoopback()
			let report = new ServerReport()
			let task = async serveOnce(ln, serverConfig, report)
			let conn = try dial(ln.address().str(), Config{serverName: "localhost", rootCAs: try poolOf(testRSACertPEM)}, 5s)
			assert conn.connectionState().peerCertificates.len() == 1
			try conn.write("k".bytes(), 5s)
			let buf byte[]
			buf.len(8)
			assert (try conn.read(buf, 5s)) == 1
			try conn.close()
			await task
			assert report.failure == ""
			assert seen.len() == 1 && seen[0] == "localhost"

			// none falls back on the list: the EC chain, matched by name.
			let fallback = new ServerReport()
			let second = async serveOnce(ln, serverConfig, fallback)
			let byIP = try dial(ln.address().str(), Config{serverName: "example.com", rootCAs: try poolOf(testECCertPEM)}, 5s)
			assert byIP.connectionState().handshakeComplete
			try byIP.write("k".bytes(), 5s)
			assert (try byIP.read(buf, 5s)) == 1
			try byIP.close()
			await second
			assert fallback.failure == ""
			assert seen.len() == 2 && seen[1] == "example.com"
			try ln.close()
		}

		// A key pair watched on disk: a renewal is presented by the next
		// handshake, a broken one leaves the pair before in use.
		@test()
		def TestKeyPairFileReloads() !none {
			let dir = "/tmp/adm-tls-reload-" + time.now().unixNs().str()
			try os.mkdir(dir)
			let certFile = dir + "/site.pem"
			let keyFile = dir + "/site.key"
			try os.writeFile(certFile, testECCertPEM.bytes())
			try os.writeFile(keyFile, testECKeyPEM.bytes())
			let files = try watchKeyPair(certFile, keyFile)
			files.checkEvery = 0s
			assert files.loads == 1
			let ln = try listenLoopback()
			let serverConfig = Config{getCertificate: files.getter()}
			let buf byte[]
			buf.len(8)

			let first = new ServerReport()
			let task = async serveOnce(ln, serverConfig, first)
			let conn = try dial(ln.address().str(), Config{serverName: "localhost", rootCAs: try poolOf(testECCertPEM)}, 5s)
			try conn.write("k".bytes(), 5s)
			assert (try conn.read(buf, 5s)) == 1
			try conn.close()
			await task
			assert first.failure == "" && files.loads == 1

			// Renewed: the RSA pair replaces the files.
			try os.writeFile(certFile, testRSACertPEM.bytes())
			try os.writeFile(keyFile, testRSAKeyPEM.bytes())
			let second = new ServerReport()
			let again = async serveOnce(ln, serverConfig, second)
			let renewed = try dial(ln.address().str(), Config{serverName: "localhost", rootCAs: try poolOf(testRSACertPEM)}, 5s)
			try renewed.write("k".bytes(), 5s)
			assert (try renewed.read(buf, 5s)) == 1
			try renewed.close()
			await again
			assert second.failure == "" && files.loads == 2 && files.lastError is none

			// A certificate half written: the RSA pair stays, the failure is kept.
			try os.writeFile(certFile, "-----BEGIN CERTIFICATE-----\nnot base64".bytes())
			let kept = try files.keyPair()
			assert kept.chain[0].hex() == (try parseKeyPair(testRSACertPEM, testRSAKeyPEM)).chain[0].hex()
			assert files.loads == 2 && !(files.lastError is none)

			// Inside `checkEvery` the files are not looked at.
			files.checkEvery = 1h
			try os.writeFile(certFile, testECCertPEM.bytes())
			try os.writeFile(keyFile, testECKeyPEM.bytes())
			try files.keyPair()
			assert files.loads == 2

			// Nothing to fall back on: the first load fails.
			let missing = "loaded"
			watchKeyPair(dir + "/absent.pem", keyFile) onerror (err error) {
				missing = "failed"
				recover files
			}
			assert missing == "failed"
			try ln.close()
			os.remove(certFile) onerror recover none
			os.remove(keyFile) onerror recover none
			os.remove(dir) onerror recover none
			return none
		}

		@test()
		def TestCertificateRequestCodec() !none {
			let req = CertificateRequest{requestContext: byte[1, 2], signatureAlgorithms: signatureSchemeCodes([SignatureScheme.ECDSASecp256r1SHA256, SignatureScheme.RSAPSSRSAESHA256])}
			let framed = marshalCertificateRequest(req)
			let next = splitHandshake(framed)
			fail "no message" when next is none
			let (kind, body, used) = next
			assert kind == handshakeCertificateRequest && used == framed.len()
			let parsed = try parseCertificateRequest(body)
			assert parsed.requestContext.hex() == "0102"
			assert parsed.signatureAlgorithms.len() == 2 && parsed.signatureAlgorithms[1] == int(SignatureScheme.RSAPSSRSAESHA256)
			let ec = try parseKeyPair(testClientCertPEM, testClientKeyPEM)
			let key = ec.privateKey
			fail "no key" when key is none
			assert picks(signatureSchemeFor(key, parsed.signatureAlgorithms), SignatureScheme.ECDSASecp256r1SHA256)
			assert signatureSchemeFor(key, signatureSchemeCodes([SignatureScheme.RSAPSSRSAESHA256])) is none
			let rsa = try parseKeyPair(testRSACertPEM, testRSAKeyPEM)
			let rsaKey = rsa.privateKey
			fail "no key" when rsaKey is none
			assert picks(signatureSchemeFor(rsaKey, signatureSchemeCodes([SignatureScheme.RSAPSSRSAESHA384, SignatureScheme.RSAPSSRSAESHA256])), SignatureScheme.RSAPSSRSAESHA256)
			assert signatureSchemeFor(rsaKey, signatureSchemeCodes([SignatureScheme.ECDSASecp256r1SHA256])) is none
		}

		// Client certificates: required and verified, declined, optional,
		// and one the server's roots do not anchor.
		@test()
		def TestServerClientCertificates() !none {
			let pair = try parseKeyPair(testECCertPEM, testECKeyPEM)
			let clientPair = try parseKeyPair(testClientCertPEM, testClientKeyPEM)
			let ln = try listenLoopback()
			let buf byte[]
			buf.len(16)

			let strict = Config{certificates: [pair], clientAuth: ClientAuthType.RequireAndVerifyClientCert, clientCAs: try poolOf(testClientCertPEM)}
			let report = new ServerReport()
			let task = async serveOnce(ln, strict, report)
			let conn = try dial(ln.address().str(), Config{serverName: "localhost", rootCAs: try poolOf(testECCertPEM), certificates: [clientPair]}, 5s)
			assert conn.connectionState().handshakeComplete
			try conn.write("id".bytes(), 5s)
			assert (try conn.read(buf, 5s)) == 2
			try conn.close()
			await task
			assert report.failure == ""
			assert report.state.peerCertificates.len() == 1
			assert report.state.verifiedChains.len() == 1
			assert report.state.peerCertificates[0].subject.str().contains("ADM client")

			// Declined where required: the client's handshake completes
			// with its Finished, the server's certificate_required alert
			// then meets its first read.
			let refused = new ServerReport()
			let second = async serveOnce(ln, strict, refused)
			let anon = try dial(ln.address().str(), Config{serverName: "localhost", rootCAs: try poolOf(testECCertPEM)}, 5s)
			assert anon.connectionState().handshakeComplete
			let reason = "ok"
			anon.read(buf, 5s) onerror (err error) {
				reason = "alert {int(err.alert)} from peer" when err is TLSError && err.fromPeer
				recover 0
			}
			assert reason == "alert {int(Alert.CertificateRequired)} from peer"
			anon.close() onerror recover none
			await second
			assert refused.failure.contains("no certificate")

			// Optional: declining is fine, nothing verified.
			let lax = Config{certificates: [pair], clientAuth: ClientAuthType.RequestClientCert}
			let optional = new ServerReport()
			let third = async serveOnce(ln, lax, optional)
			let plain = try dial(ln.address().str(), Config{serverName: "localhost", rootCAs: try poolOf(testECCertPEM)}, 5s)
			try plain.write("x".bytes(), 5s)
			assert (try plain.read(buf, 5s)) == 1
			try plain.close()
			await third
			assert optional.failure == ""
			assert optional.state.peerCertificates.len() == 0

			// Given but unverified when asked for any.
			let any = Config{certificates: [pair], clientAuth: ClientAuthType.RequireAnyClientCert}
			let unverified = new ServerReport()
			let fourth = async serveOnce(ln, any, unverified)
			let shown = try dial(ln.address().str(), Config{serverName: "localhost", rootCAs: try poolOf(testECCertPEM), certificates: [clientPair]}, 5s)
			try shown.write("x".bytes(), 5s)
			assert (try shown.read(buf, 5s)) == 1
			try shown.close()
			await fourth
			assert unverified.failure == ""
			assert unverified.state.peerCertificates.len() == 1
			assert unverified.state.verifiedChains.len() == 0

			// A chain the server's roots do not anchor: unknown_ca.
			let wrongRoots = Config{certificates: [pair], clientAuth: ClientAuthType.VerifyClientCertIfGiven, clientCAs: try poolOf(testRSACertPEM)}
			let rejected = new ServerReport()
			let fifth = async serveOnce(ln, wrongRoots, rejected)
			let unknown = try dial(ln.address().str(), Config{serverName: "localhost", rootCAs: try poolOf(testECCertPEM), certificates: [clientPair]}, 5s)
			reason = "ok"
			unknown.read(buf, 5s) onerror (err error) {
				reason = "alert {int(err.alert)} from peer" when err is TLSError && err.fromPeer
				recover 0
			}
			assert reason == "alert {int(Alert.UnknownCA)} from peer"
			unknown.close() onerror recover none
			await fifth
			assert rejected.failure.contains("tls:")

			// An RSA client chain signs its CertificateVerify with RSA-PSS;
			// its certificate is a server one, so it is asked for but not
			// verified.
			let rsaClient = try parseKeyPair(testRSACertPEM, testRSAKeyPEM)
			let rsaRoots = Config{certificates: [pair], clientAuth: ClientAuthType.RequireAnyClientCert}
			let rsaReport = new ServerReport()
			let sixth = async serveOnce(ln, rsaRoots, rsaReport)
			let rsaConn = try dial(ln.address().str(), Config{serverName: "localhost", rootCAs: try poolOf(testECCertPEM), certificates: [rsaClient]}, 5s)
			try rsaConn.write("r".bytes(), 5s)
			assert (try rsaConn.read(buf, 5s)) == 1
			try rsaConn.close()
			await sixth
			try ln.close()
			assert rsaReport.failure == ""
			assert rsaReport.state.peerCertificates.len() == 1
			assert rsaReport.state.verifiedChains.len() == 0
		}
	}
}
