	// The server's ephemeral X25519 private key of RFC 8448 §3.
	internal const rfcServerPrivate = "b1580eeadf6dd589b8ef4f2d5652578cc810e9980191ec8d058308cea216a21e"

	// ServerReport is what a test server saw, for the client side to check.
	type ServerReport {
		state   ConnectionState
		failure string          = ""
		echoed  string          = ""

		def new() {}
	}

	// serveOnce accepts one connection, runs the handshake, echoes one
	// message back in upper case and closes, reporting what it saw.
	internal async def serveOnce(ln net.Listener, config Config, report ServerReport) none {
		let raw = ln.accept() onerror (err error) {
			report.failure = "accept: {err.message}"
			recover new net.Connection(-1)
		}
		return none when report.failure != ""
		let conn = server(raw, config)
		serveConn(conn, report) onerror (err error) {
			report.failure = err.message
			recover none
		}
		conn.close() onerror recover none
		return none
	}

	internal def serveConn(conn Conn, report ServerReport) !none {
		try conn.handshake(5s)
		report.state = conn.connectionState()
		let buf byte[]
		buf.len(256)
		let n = try conn.read(buf, 5s)
		report.echoed = string(buf[0:n])
		try conn.write(report.echoed.upper().bytes(), 5s)
		return none
	}

	// picks reports whether a scheme was picked and is the wanted one.
	internal def picks(picked ?SignatureScheme, wanted SignatureScheme) bool {
		return false when picked is none
		return picked == wanted
	}

	// listenLoopback binds an ephemeral loopback port.
	internal def listenLoopback() !net.Listener {
		let sock = try net.socket(net.SocketDomain.IPv4, net.SocketType.Stream)
		try sock.bind("127.0.0.1:0")
		return try sock.listen(8)
	}

	// poolOf is a pool holding the certificates of a PEM text.
	internal def poolOf(pem string) !CertPool {
		let pool = new CertPool()
		for let (_, cert) in try parseCertificatesPEM(pem) {
			pool.addCert(cert)
		}
		return pool
	}

