partial module std.net.udp {
	use std.net

	// Client is a UDP client backed by a datagram socket.
	type Client {
		internal sock ?net.Socket = none

		// start creates a datagram socket (not bound by default).
		// Fails when the operating system refuses to create the socket.
		def start(domain net.SocketDomain = net.SocketDomain.IPv4) !none {
			return none unless sock is none
			sock = try net.socket(domain, net.SocketType.Datagram)
			return none
		}

		// bind binds the socket to a local address (e.g. ":0" for ephemeral).
		// Fails when the client is not started, the address does not parse or it is in use.
		def bind(addr string) !none {
			fail "udp client is not started" when sock is none
			let s net.Socket = sock
			return s.bind(addr)
		}

		// sendTo sends a datagram to `addr`.
		// Fails when the client is not started, the address does not parse, or the send is refused or times out.
		def sendTo(data byte[], addr string, timeout duration = 30s) !int {
			fail "udp client is not started" when sock is none
			let s net.Socket = sock
			return s.writeTo(data, addr, timeout)
		}

		// recvFrom receives a datagram and returns the sender.
		// Fails when the client is not started, or the receive is refused or times out.
		def recvFrom(buf byte[], timeout duration = 30s) !(int, net.Address) {
			fail "udp client is not started" when sock is none
			let s net.Socket = sock
			return s.readFrom(buf, timeout)
		}

		// close closes the socket.
		// Fails when the socket refuses to close.
		def close() !none {
			return none when sock is none
			let s net.Socket = sock
			s.close() onerror recover none
			sock = none
			return none
		}

		// Closes the client when the last reference is released.
		def dispose() {
			close() onerror recover none
		}
	}
}
