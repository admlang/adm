partial module std.net.udp {
	use (
		std.net
		std.time
	)

	// Peer is a UDP socket that exchanges datagrams with one remote
	// address: what DTLS, or anything else built on a
	// `net.DatagramTransport`, runs over. Datagrams from other senders
	// are dropped. Implements net.DatagramTransport.
	type Peer {
		internal sock   net.Socket
		internal remote string
		// The peer's IP address and port, which a sender is compared by.
		internal ip     byte[]     = []
		internal port   int        = 0
		// A datagram as large as UDP allows, so a long one is detected
		// instead of cut.
		internal inbox  byte[]

		// A peer of `sock` at `remote`, an IP address and port
		// ("192.0.2.1:4433", "[2001:db8::1]:4433").
		def new(sock net.Socket, remote string) {
			self.sock = sock
			self.remote = remote
			let at = net.parseAddress(remote) onerror recover new net.Address()
			port = at.port
			let address = net.parseIPText(at.host)
			ip = address unless address is none
			inbox.len(65536)
		}

		// send sends one datagram to the peer. Fails with NetError when the
		// socket is closed, or the send is refused or times out.
		def send(data byte[], timeout duration) !none {
			try sock.writeTo(data, remote, timeout)
			return none
		}

		// receive waits for the next datagram from the peer, copies it into
		// buf and returns its length; 0s or less waits without end. Fails
		// with NetError when the socket is closed, the wait times out, or
		// the datagram does not fit in buf.
		def receive(buf byte[], timeout duration) !int {
			let deadline = int(time.monoNs()) + int(timeout)
			for {
				let left = timeout
				if timeout > 0s {
					left = duration(deadline - int(time.monoNs()))
					fail net.errorOf(net.ErrorCode.TimedOut, "receive", remote, "timed out") when left <= 0s
				}
				let (n, from) = try sock.readFrom(inbox, left)
				continue unless from.port == port
				let sender = net.parseIPText(from.host)
				continue when sender is none || !sender.equals(ip)
				fail net.errorOf(net.ErrorCode.Other, "receive", remote, "datagram of {n} bytes does not fit in {buf.len()}") when n > buf.len()
				inbox[:n].copy(buf)
				return n
			}
			fail "unreachable"
		}

		// localAddr is the address the socket is bound to.
		def localAddr() net.Address {
			return sock.localAddr()
		}

		// remoteAddr is the peer's address.
		def remoteAddr() net.Address {
			return net.parseAddress(remote) onerror recover new net.Address()
		}

		// close closes the socket; closing twice does nothing. Fails when the
		// descriptor refuses to close.
		def close() !none {
			return try sock.close()
		}

		// isOpen reports whether close was not called yet.
		def isOpen() bool {
			return sock.isOpen()
		}

		// Closes the socket when the last reference is released.
		def dispose() {
			close() onerror recover none
		}
	}

	// dial opens a UDP socket for one peer: the address is "host:port",
	// the host resolved to its first address. `local` binds the socket to
	// a local address (an ephemeral port of any address when empty).
	// Fails with NetError when the name does not resolve, or the socket
	// cannot be created or bound.
	def dial(address string, local string = "") !Peer {
		let target = try net.parseAddress(address)
		let host = target.host
		let ip = net.parseIPText(host)
		if ip is none {
			let found = try net.resolve(host)
			fail net.errorOf(net.ErrorCode.Resolve, "dial", address, "the name resolves to no address") when found.len() == 0
			host = found[0]
			ip = net.parseIPText(host)
		}
		let v6 = !(ip is none) && ip.len() == 16
		let sock = try net.socket(v6 ?? (net.SocketDomain.IPv6, net.SocketDomain.IPv4), net.SocketType.Datagram)
		let bindTo = local
		bindTo = v6 ?? ("[::]:0", "0.0.0.0:0") when bindTo == ""
		sock.bind(bindTo) onerror (err error) {
			sock.close() onerror recover none
			fail err
		}
		return new Peer(sock, v6 ?? ("[{host}]:{target.port}", "{host}:{target.port}"))
	}
}
