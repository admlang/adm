partial module std.net.udp {
	use std.net

	// Server is a basic UDP server that binds and receives datagrams.
	type Server {
		addr             string
		internal sock    ?net.Socket = none
		internal running bool        = false

		def new(addr string) {
			self.addr = addr
		}

		// start creates and binds the datagram socket.
		// Fails when the socket cannot be created or the address cannot be bound.
		def start() !none {
			return none when running
			let a = net.parseAddress(addr) onerror recover new net.Address()

			let domain = net.SocketDomain.IPv4
			if a.isUnix {
				domain = net.SocketDomain.Unix
			} else if a.isIPv6 {
				domain = net.SocketDomain.IPv6
			}

			let s = try net.socket(domain, net.SocketType.Datagram)
			s.setReuseAddr(true) onerror recover none
			s.setReusePort(true) onerror recover none
			try s.bind(addr)
			sock = s
			running = true
			return none
		}

		// recv receives a datagram and returns the sender, waiting up to 30s.
		// Fails with NetError (Closed) when the server is not started, else
		// when the receive is refused or times out.
		def recv(buf byte[]) !(int, net.Address) {
			return recv(buf, 30s)
		}

		// recv receives a datagram and returns the sender, waiting up to
		// `timeout`. Fails as the form without one does.
		def recv(buf byte[], timeout duration) !(int, net.Address) {
			fail net.errorOf(net.ErrorCode.Closed, "receive", addr, "udp server is not started") when sock is none
			let s net.Socket = sock
			return s.readFrom(buf, timeout)
		}

		// send sends a datagram to the given address, waiting up to 30s.
		// Fails with NetError (Closed) when the server is not started, else
		// when the send is refused or times out.
		def send(buf byte[], to net.Address) !int {
			return send(buf, to, 30s)
		}

		// send sends a datagram to the given address, waiting up to
		// `timeout`. Fails as the form without one does.
		def send(buf byte[], to net.Address, timeout duration) !int {
			fail net.errorOf(net.ErrorCode.Closed, "send", to.str(), "udp server is not started") when sock is none
			let s net.Socket = sock
			return s.writeTo(buf, to.str(), timeout)
		}

		// close closes the socket; a second close does nothing.
		// Fails when the socket refuses to close.
		def close() !none {
			return none unless running
			if sock is none {
				running = false
				return none
			}
			let s net.Socket = sock
			s.close() onerror recover none
			sock = none
			running = false
			return none
		}

		// address returns the local bound address.
		def address() net.Address {
			if sock is none {
				return net.parseAddress(addr) onerror recover new net.Address()
			}
			return sock.localAddr()
		}
	}
}
