partial module std.net.udp {
	use (
		std.net
		std.testing
	)

	check "UDP" {
		@test()
		def datagramRoundTrip() !none {
			let server = new Server("127.0.0.1:0")
			try server.start()
			assert server.address().port > 0

			let client = new Client()
			try client.start()
			try client.bind("127.0.0.1:0")
			assert (try client.sendTo("ping".bytes(), server.address().str(), 2s)) == 4

			let buf byte[] = []
			buf.len(64)
			let (n, from) = try server.recv(buf)
			assert string(buf[:n]) == "ping"
			assert from.host == "127.0.0.1"
			assert from.port > 0

			assert (try server.send("pong".bytes(), from)) == 4
			let reply byte[] = []
			reply.len(64)
			let (m, _) = try client.recvFrom(reply, 2s)
			assert string(reply[:m]) == "pong"

			try client.close()
			try server.close()
			try server.close()
			return none
		}

		@test()
		def receiveTimesOut() !none {
			let client = new Client()
			try client.start()
			try client.bind("127.0.0.1:0")
			let buf byte[] = []
			buf.len(8)
			let seen = false
			client.recvFrom(buf, 100ms) onerror (err error) {
				if err is net.NetError {
					seen = err.kind == net.ErrorCode.TimedOut && err.op == "receive"
				}
				recover (0, new net.Address())
			}
			assert seen
			try client.close()
			return none
		}

		@test()
		def sendBeforeStartFails() {
			let client = new Client()
			let seen = false
			client.sendTo("x".bytes(), "127.0.0.1:9") onerror (err error) {
				seen = err.message.contains("not started") && err is net.NetError && err.kind == net.ErrorCode.Closed
				recover 0
			}
			assert seen
			let server = new Server("127.0.0.1:0")
			let refused = false
			server.send("x".bytes(), new net.Address()) onerror (err error) {
				refused = err is net.NetError && err.kind == net.ErrorCode.Closed && err.op == "send"
				recover 0
			}
			assert refused
		}

		@test()
		def serverTimesOutAndAnswersTheSender() !none {
			let server = new Server("127.0.0.1:0")
			try server.start()
			let buf byte[] = []
			buf.len(16)
			let timedOut = false
			server.recv(buf, 100ms) onerror (err error) {
				timedOut = err is net.NetError && err.kind == net.ErrorCode.TimedOut
				recover (0, new net.Address())
			}
			assert timedOut

			// The client's bound address is where the answer goes.
			let client = new Client()
			try client.start()
			try client.bind("127.0.0.1:0")
			let bound = try client.localAddr()
			assert bound.port > 0
			try client.sendTo("ping".bytes(), server.address().str(), 2s)
			let (n, from) = try server.recv(buf, 2s)
			assert string(buf[:n]) == "ping" && from.port == bound.port
			assert (try server.send("pong".bytes(), from, 2s)) == 4
			let (m, _) = try client.recvFrom(buf, 2s)
			assert string(buf[:m]) == "pong"
			try client.close()
			try server.close()
			return none
		}
	}
}
