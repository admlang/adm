partial module std.net.url {
	use std.strings::(Scanner)

	// Pattern matches URLs the way a router does (the WHATWG URLPattern):
	// `:name` captures one path segment, `:name*` the rest of the path, `*`
	// any text, and each part of the URL can have its own pattern. The HTTP
	// server's mux is built on this; it is also the shape of a route table
	// in a client or a static-site tool.
	//
	// ```
	// let p = try parsePattern("/users/:id/posts/:post")
	// let m = p.exec("/users/42/posts/7")
	// m != none && m.params == {"id": "42", "post": "7"}
	// p.test("/users/42") == false
	//
	// let files = try parsePattern("/static/:path*")
	// files.exec("/static/css/site.css").params["path"] == "css/site.css"
	//
	// let full = try parsePattern("https://:tenant.example.com/api/*")
	// full.exec("https://acme.example.com/api/v1/x").params["tenant"] == "acme"
	// ```
	type Pattern {
		internal source     string
		internal full       bool
		internal scheme     string
		internal hostTokens PatternToken[]
		internal pathTokens PatternToken[]

		def new() {}

		// test reports whether the text matches, without the captures.
		def test(text string) bool {
			return !(exec(text) is none)
		}

		// exec returns the captures, none when the text does not fit. A
		// path-only pattern matches a path or the path of a full URL.
		// (`match` is a keyword.)
		def exec(text string) ?Match {
			if full || text.contains("://") {
				let u = parse(text) onerror recover new URL()
				return none when u.scheme == "" && full
				return exec(u, text)
			}
			return matchParts("", "", text, text)
		}

		// exec with a parsed URL, so a handler passes the request's URL in as
		// it is. `input` in the match is the URL rendered.
		def exec(u URL) ?Match {
			return exec(u, u.str())
		}

		// test with a parsed URL.
		def test(u URL) bool {
			return !(exec(u) is none)
		}

		internal def exec(u URL, input string) ?Match {
			return matchParts(u.scheme, u.hostname(), u.escapedPath(), input)
		}

		// matchParts runs the host and path tokens over the URL's parts.
		internal def matchParts(schemeText string, hostText string, pathText string, input string) ?Match {
			let params = map<string, string>{}
			let wildcards string[] = []
			if full {
				return none when schemeText != scheme
				return none unless matchTokens(hostTokens, 0, hostText, 0, '.', params, wildcards)
			}
			return none unless matchTokens(pathTokens, 0, pathText, 0, '/', params, wildcards)
			let decoded = map<string, string>{}
			for let key in params.keys() {
				let value = params.get(key)
				continue when value is none
				let plain = unescapeWith(value, Encoding.Path) onerror recover value
				decoded.set(key, plain)
			}
			return Match{params: decoded, wildcards: wildcards, input: input}
		}

		// params is every `:name` in the pattern, in order.
		def params() string[] {
			let out string[] = []
			for let t in hostTokens {
				out.push(t.name) when t.kind == PatternTokenKind.Capture || t.kind == PatternTokenKind.Rest
			}
			for let t in pathTokens {
				out.push(t.name) when t.kind == PatternTokenKind.Capture || t.kind == PatternTokenKind.Rest
			}
			return out
		}

		def str() string {
			return source
		}

		// compile reads a pattern into this value: a path (`/a/:b`) or a full
		// URL with patterns in the host and path. Fails with UrlError (op
		// "pattern") on a bad capture name.
		def compile(text string) !none {
			source = text
			full = false
			scheme = ""
			hostTokens = []
			pathTokens = []
			let sep = text.indexOf("://")
			if sep < 0 {
				pathTokens = try tokenize(text, text)
				return none
			}
			full = true
			scheme = text[:sep].lower()
			let rest = text[sep + 3:]
			let slash = rest.indexOf("/")
			let hostPart = rest
			let pathPart = ""
			if slash >= 0 {
				hostPart = rest[:slash]
				pathPart = rest[slash:]
			}
			hostTokens = try tokenize(hostPart, text)
			pathTokens = try tokenize(pathPart, text)
			return none
		}

		// matchTokens matches tokens[index:] against text[pos:], a capture
		// stopping at the delimiter, a rest or wildcard taking as much as
		// still lets the remaining tokens match.
		internal def matchTokens(tokens PatternToken[], index int, text string, pos int, delimiter char, params map<string, string>, wildcards string[]) bool {
			return pos == text.len() when index == tokens.len()
			let token = tokens[index]
			if token.kind == PatternTokenKind.Literal {
				return false unless text[pos:].startsWith(token.text)
				return matchTokens(tokens, index + 1, text, pos + token.text.len(), delimiter, params, wildcards)
			}
			if token.kind == PatternTokenKind.Capture {
				let limit = pos
				for limit < text.len() && text[limit] != delimiter {
					limit++
				}
				for let end = pos + 1; end <= limit; end++ {
					params.set(token.name, text[pos:end])
					return true when matchTokens(tokens, index + 1, text, end, delimiter, params, wildcards)
					params.delete(token.name)
				}
				return false
			}
			for let end = text.len(); end >= pos; end-- {
				if token.kind == PatternTokenKind.Rest {
					params.set(token.name, text[pos:end])
				} else {
					wildcards.push(text[pos:end])
				}
				return true when matchTokens(tokens, index + 1, text, end, delimiter, params, wildcards)
				if token.kind == PatternTokenKind.Rest {
					params.delete(token.name)
				} else {
					wildcards.pop()
				}
			}
			return false
		}
	}

	// Match is what a Pattern captured: named parameters and, for `*`, the
	// positional wildcards.
	struct Match {
		params    map<string, string>
		wildcards string[]
		// The URL or path that matched.
		input     string
	}

	internal enum PatternTokenKind {
		Literal,
		Capture,
		Rest,
		Wildcard,
	}

	// PatternToken is a literal run, a `:name` capture, a `:name*` rest
	// capture or a `*` wildcard.
	internal struct PatternToken {
		kind PatternTokenKind
		text string
		name string
	}

	// tokenize splits one part of a pattern into tokens. Fails on `:` with
	// no name after it.
	internal def tokenize(text string, source string) !PatternToken[] {
		let out PatternToken[] = []
		let s = new Scanner(text)
		for !s.atEnd() {
			let literal = s.takeUntil(def (c char) bool {
				return c == '*' || c == ':'
			})
			out.push(PatternToken{kind: PatternTokenKind.Literal, text: literal, name: ""}) when literal != ""
			if s.expect('*') {
				out.push(PatternToken{kind: PatternTokenKind.Wildcard, text: "", name: ""})
				continue
			}
			continue unless s.expect(':')
			let name = s.takeWhile(def (c char) bool {
				return c.isAlphanumeric() || c == '_'
			})
			fail UrlError{message: "':' needs a capture name in pattern", op: "pattern", text: source} when name == ""
			if s.expect('*') {
				out.push(PatternToken{kind: PatternTokenKind.Rest, text: "", name: name})
			} else {
				out.push(PatternToken{kind: PatternTokenKind.Capture, text: "", name: name})
			}
		}
		return out
	}

	// parsePattern reads a pattern: a path (`/a/:b`) or a full URL with
	// patterns in the host and path. Fails with UrlError (op "pattern") on a
	// bad capture name.
	def parsePattern(text string) !Pattern {
		let p = new Pattern()
		try p.compile(text)
		return p
	}
}
