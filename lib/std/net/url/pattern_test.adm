partial module std.net.url {
	use std.testing

	check "Pattern" {
		@test()
		def capturesSegments() !none {
			let p = try parsePattern("/users/:id/posts/:post")
			let m = p.exec("/users/42/posts/7")
			fail "expected a match" when m is none
			assert orEmpty(m.params.get("id")) == "42"
			assert orEmpty(m.params.get("post")) == "7"
			assert m.input == "/users/42/posts/7"
			assert !p.test("/users/42")
			assert !p.test("/users/42/posts/7/extra")
			assert p.params().equals(["id", "post"])
			return none
		}

		@test()
		def restAndWildcards() !none {
			let files = try parsePattern("/static/:path*")
			let m = files.exec("/static/css/site.css")
			fail "expected a match" when m is none
			assert orEmpty(m.params.get("path")) == "css/site.css"
			let any = try parsePattern("/api/*/items/*")
			let w = any.exec("/api/v1/items/9")
			fail "expected a match" when w is none
			assert w.wildcards.equals(["v1", "9"])
			let suffix = try parsePattern("/files/:name.txt")
			let s = suffix.exec("/files/report.txt")
			fail "expected a match" when s is none
			assert orEmpty(s.params.get("name")) == "report"
			assert !suffix.test("/files/report.pdf")
			return none
		}

		@test()
		def fullUrlPatterns() !none {
			let full = try parsePattern("https://:tenant.example.com/api/*")
			let m = full.exec("https://acme.example.com/api/v1/x")
			fail "expected a match" when m is none
			assert orEmpty(m.params.get("tenant")) == "acme"
			assert !full.test("http://acme.example.com/api/v1/x")
			assert !full.test("https://acme.other.com/api/v1/x")
			let pathOnly = try parsePattern("/users/:id")
			let viaUrl = pathOnly.exec("http://host:8080/users/a%20b?x=1")
			fail "expected a match" when viaUrl is none
			assert orEmpty(viaUrl.params.get("id")) == "a b"
			return none
		}

		@test()
		def rejectsBareColon() {
			let failed = false
			parsePattern("/users/:") onerror (err error) {
				if err is UrlError {
					failed = err.op == "pattern"
				}
				recover new Pattern()
			}
			assert failed
		}
	}
}
