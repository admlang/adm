partial module std.net.url {
	use std.strings::(Scanner)

	// Template is an RFC 6570 URI template: a URL with `{name}` holes that
	// expand from a map and match back into one. APIs publish them
	// (`/users/{id}/posts{?page,limit}`), clients expand them, servers extract
	// from them. Operators: `{var}` escapes everything, `{+var}` keeps
	// reserved characters, `{/a,b}` path segments, `{?a,b}` a query, `{&a}`
	// more query, `{#frag}`, `{.a}` a dotted suffix, `{;a}` path parameters,
	// `{var*}` explodes a list, `{var:3}` keeps a prefix.
	//
	// ```
	// let t = try parseTemplate("https://api.example.com/users/{id}/posts{?page,limit}")
	// t.expand(map<string, string>{"id": "42", "page": "2"}) == "https://api.example.com/users/42/posts?page=2"
	// t.variables() == ["id", "page", "limit"]
	// let got = t.extract("https://api.example.com/users/7/posts?page=3")
	// got != none && got["id"] == "7" && got["page"] == "3"
	// ```
	type Template {
		internal source string
		internal pieces TemplatePiece[]

		def new() {}

		// variables is every hole's name in order of first appearance.
		def variables() string[] {
			let out string[] = []
			for let piece in pieces {
				continue unless piece.isExpr
				for let v in piece.vars {
					out.push(v.name) unless out.includes(v.name)
				}
			}
			return out
		}

		// expand fills the holes from the map; a missing variable expands to
		// nothing, the way RFC 6570 says.
		def expand(values map<string, string>) string {
			let lists = map<string, string[]>{}
			for let key in values.keys() {
				let value = values.get(key)
				continue when value is none
				lists.set(key, [value])
			}
			return expand(lists)
		}

		// expand with a list variable: `{/segments*}` and `{?tags*}` take
		// every element.
		def expand(values map<string, string[]>) string {
			let out = ""
			for let piece in pieces {
				if !piece.isExpr {
					out += piece.literal
					continue
				}
				let op = operatorFor(piece.op)
				let parts string[] = []
				for let v in piece.vars {
					let list = values.get(v.name)
					continue when list is none
					continue when list.len() == 0
					if v.explode {
						for let item in list {
							parts.push(expandOne(op, v.name, item, v.prefix))
						}
						continue
					}
					let joined string[] = []
					for let item in list {
						joined.push(escapeTemplate(clip(item, v.prefix), op.allowReserved))
					}
					let text = joined.join(",")
					if op.named {
						text = v.name + op.ifEmpty when text == ""
						text = v.name + "=" + text when text != "" && !text.startsWith(v.name + op.ifEmpty)
					}
					parts.push(text)
				}
				continue when parts.len() == 0
				out += op.first + parts.join(op.separator)
			}
			return out
		}

		// extract matches a URL against the template and returns the hole
		// values, none when the URL does not fit. The shortest text that lets
		// the rest of the template match wins each hole, and a list hole
		// yields its elements joined with the operator's separator.
		def extract(text string) ?map<string, string> {
			let out = map<string, string>{}
			return none unless matchPieces(0, text, 0, out)
			return out
		}

		// matchPieces matches pieces[index:] against text[pos:], filling out.
		internal def matchPieces(index int, text string, pos int, out map<string, string>) bool {
			return pos == text.len() when index == pieces.len()
			let piece = pieces[index]
			if !piece.isExpr {
				return false unless text[pos:].startsWith(piece.literal)
				return matchPieces(index + 1, text, pos + piece.literal.len(), out)
			}
			for let end = pos; end <= text.len(); end++ {
				let segment = text[pos:end]
				let trial = out.clone()
				continue unless bindExpression(piece, segment, trial)
				if matchPieces(index + 1, text, end, trial) {
					for let key in trial.keys() {
						let v = trial.get(key)
						continue when v is none
						out.set(key, v)
					}
					return true
				}
			}
			return false
		}

		// bindExpression reads one expression's expansion back into its
		// variables; an empty segment means every variable was undefined.
		internal def bindExpression(piece TemplatePiece, segment string, out map<string, string>) bool {
			return true when segment == ""
			let op = operatorFor(piece.op)
			let body = segment
			if op.first != "" {
				return false unless body.startsWith(op.first)
				body = body[op.first.len():]
			}
			let parts = body.split(op.separator)
			if op.named {
				for let part in parts {
					let name = part
					let value = ""
					let eq = part.indexOf("=")
					if eq >= 0 {
						name = part[:eq]
						value = part[eq + 1:]
					}
					let known = false
					for let v in piece.vars {
						known = true when v.name == name
					}
					return false unless known
					let decoded = unescapeWith(value, Encoding.Path) onerror recover ""
					let previous = out.get(name)
					if previous is none {
						out.set(name, decoded)
					} else {
						out.set(name, previous + op.separator + decoded)
					}
				}
				return true
			}
			return false when parts.len() > piece.vars.len() && !piece.vars[piece.vars.len() - 1].explode
			for let (i, part) in parts {
				let idx = i
				idx = piece.vars.len() - 1 when idx >= piece.vars.len()
				let name = piece.vars[idx].name
				let decoded = unescapeWith(part, Encoding.Path) onerror recover ""
				let previous = out.get(name)
				if previous is none {
					out.set(name, decoded)
				} else {
					out.set(name, previous + op.separator + decoded)
				}
			}
			return true
		}

		def str() string {
			return source
		}

		// parse reads a template into this value. Fails with UrlError (op
		// "template") on an unbalanced brace, an unknown operator or an
		// empty expression.
		def parse(text string) !none {
			source = text
			pieces = []
			let noVars TemplateVar[] = []
			let s = new Scanner(text)
			for !s.atEnd() {
				let literal = s.takeUntil(def (c char) bool {
					return c == '{' || c == '}'
				})
				pieces.push(TemplatePiece{literal: literal, isExpr: false, op: "", vars: noVars}) when literal != ""
				fail UrlError{message: "unbalanced closing brace in template", op: "template", text: text} when s.expect('}')
				continue unless s.expect('{')
				let inner = s.takeUntil("}")
				fail UrlError{message: "unbalanced opening brace in template", op: "template", text: text} unless s.expect('}')
				fail UrlError{message: "empty expression in template", op: "template", text: text} when inner == ""
				let op = ""
				let head = inner[0]
				if head := '+' || '#' || '.' || '/' || ';' || '?' || '&' {
					op = string(head)
					inner = inner[1:]
				} else if head := '=' || ',' || '!' || '@' || '|' {
					fail UrlError{message: "reserved operator '{head}' in template", op: "template", text: text}
				}
				let vars TemplateVar[] = []
				for let spec in inner.split(",") {
					let name = spec
					let explode = false
					let prefix = 0
					if name.endsWith("*") {
						explode = true
						name = name[:name.len() - 1]
					}
					let colon = name.indexOf(":")
					if colon >= 0 {
						prefix = parseInt<int>(name[colon + 1:], 10)
						name = name[:colon]
					}
					fail UrlError{message: "empty variable name in template", op: "template", text: text} when name == ""
					vars.push(TemplateVar{name: name, explode: explode, prefix: prefix})
				}
				pieces.push(TemplatePiece{literal: "", isExpr: true, op: op, vars: vars})
			}
			return none
		}
	}

	// TemplateVar is one variable of an expression: `{name*}` explodes a
	// list, `{name:3}` keeps a prefix.
	internal struct TemplateVar {
		name    string
		explode bool
		prefix  int
	}

	// TemplatePiece is a literal run or an `{expression}` of a template.
	internal struct TemplatePiece {
		literal string
		isExpr  bool
		op      string
		vars    TemplateVar[]
	}

	// TemplateOp is how an operator expands (RFC 6570 §3.2.1 table).
	internal struct TemplateOp {
		first         string
		separator     string
		named         bool
		ifEmpty       string
		allowReserved bool
	}

	internal def operatorFor(op string) TemplateOp {
		return TemplateOp{first: "", separator: ",", named: false, ifEmpty: "", allowReserved: true} when op == "+"
		return TemplateOp{first: "#", separator: ",", named: false, ifEmpty: "", allowReserved: true} when op == "#"
		return TemplateOp{first: ".", separator: ".", named: false, ifEmpty: "", allowReserved: false} when op == "."
		return TemplateOp{first: "/", separator: "/", named: false, ifEmpty: "", allowReserved: false} when op == "/"
		return TemplateOp{first: ";", separator: ";", named: true, ifEmpty: "", allowReserved: false} when op == ";"
		return TemplateOp{first: "?", separator: "&", named: true, ifEmpty: "=", allowReserved: false} when op == "?"
		return TemplateOp{first: "&", separator: "&", named: true, ifEmpty: "=", allowReserved: false} when op == "&"
		return TemplateOp{first: "", separator: ",", named: false, ifEmpty: "", allowReserved: false}
	}

	internal def clip(value string, prefix int) string {
		return value when prefix <= 0 || prefix >= value.len()
		return value[:prefix]
	}

	// expandOne renders one value of an exploded variable.
	internal def expandOne(op TemplateOp, name string, value string, prefix int) string {
		let text = escapeTemplate(clip(value, prefix), op.allowReserved)
		return text unless op.named
		return name + op.ifEmpty when text == ""
		return name + "=" + text
	}

	// escapeTemplate percent-encodes for a template: only unreserved bytes
	// stay, or, with allowReserved, reserved ones and existing escapes too.
	internal def escapeTemplate(text string, allowReserved bool) string {
		let out = ""
		let src = text.bytes()
		for let i = 0; i < src.len(); i++ {
			let c = int(src[i])
			if isUnreserved(src[i]) {
				out += string(char(c))
				continue
			}
			if allowReserved {
				// Reserved characters and well-formed escapes pass through.
				if isSubDelim(c) || c == 58 || c == 47 || c == 63 || c == 35 || c == 91 || c == 93 || c == 64 {
					out += string(char(c))
					continue
				}
				if c == 37 && i + 2 < src.len() && isHexByte(src[i + 1]) && isHexByte(src[i + 2]) {
					out += "%" + string(char(int(src[i + 1]))) + string(char(int(src[i + 2])))
					i += 2
					continue
				}
			}
			out += "%" + string(hexDigits[c >> 4]) + string(hexDigits[c & 15])
		}
		return out
	}

	// parseTemplate reads a template. Fails with UrlError (op "template")
	// on an unbalanced brace, an unknown operator or an empty expression.
	def parseTemplate(text string) !Template {
		let t = new Template()
		try t.parse(text)
		return t
	}
}
