partial module std.net.url {
	use std.testing

	check "Template" {
		@test()
		def expandsLevelsOneToThree() !none {
			let vars = map<string, string>{}
			vars.set("id", "42")
			vars.set("page", "2")
			vars.set("q", "a b")
			vars.set("path", "/foo/bar")
			let t = try parseTemplate("https://api.example.com/users/\{id}/posts\{?page,limit}")
			assert t.expand(vars) == "https://api.example.com/users/42/posts?page=2"
			assert t.variables().equals(["id", "page", "limit"])
			assert (try parseTemplate("/search\{?q}")).expand(vars) == "/search?q=a%20b"
			assert (try parseTemplate("\{+path}/here")).expand(vars) == "/foo/bar/here"
			assert (try parseTemplate("\{path}")).expand(vars) == "%2Ffoo%2Fbar"
			assert (try parseTemplate("X\{#id}")).expand(vars) == "X#42"
			assert (try parseTemplate("X\{.id,page}")).expand(vars) == "X.42.2"
			assert (try parseTemplate("\{/id,page}")).expand(vars) == "/42/2"
			assert (try parseTemplate("\{;id,empty}")).expand(vars) == ";id=42"
			assert (try parseTemplate("\{&id,page}")).expand(vars) == "&id=42&page=2"
			assert (try parseTemplate("\{id:1}\{q:1}")).expand(vars) == "4a"
			assert (try parseTemplate("\{missing}")).expand(vars) == ""
			return none
		}

		@test()
		def explodesLists() !none {
			let lists = map<string, string[]>{}
			lists.set("segments", ["a", "b"])
			lists.set("tags", ["x", "y z"])
			assert (try parseTemplate("/root\{/segments*}")).expand(lists) == "/root/a/b"
			assert (try parseTemplate("/root\{/segments}")).expand(lists) == "/root/a,b"
			assert (try parseTemplate("/t\{?tags*}")).expand(lists) == "/t?tags=x&tags=y%20z"
			assert (try parseTemplate("/t\{?tags}")).expand(lists) == "/t?tags=x,y%20z"
			return none
		}

		@test()
		def extractsValues() !none {
			let t = try parseTemplate("https://api.example.com/users/\{id}/posts\{?page,limit}")
			let got = t.extract("https://api.example.com/users/7/posts?page=3")
			fail "expected a match" when got is none
			assert orEmpty(got.get("id")) == "7"
			assert orEmpty(got.get("page")) == "3"
			assert got.get("limit") is none
			assert t.extract("https://api.example.com/other/7") is none
			let plain = try parseTemplate("/files/\{name}.txt")
			let m = plain.extract("/files/a%20b.txt")
			fail "expected a match" when m is none
			assert orEmpty(m.get("name")) == "a b"
			return none
		}

		@test()
		def rejectsMalformed() {
			for let bad in ["/a/\{b", "/a}b", "\{}", "\{=x}"] {
				let failed = false
				parseTemplate(bad) onerror (err error) {
					if err is UrlError {
						failed = err.op == "template"
					}
					recover new Template()
				}
				assert failed
			}
		}
	}
}
