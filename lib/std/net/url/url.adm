partial module std.net.url {
	use std.errors

	// UrlError is the payload a failed parse, unescape or resolve carries.
	struct UrlError {
		message string
		code    string            = "url"
		cause   ?error
		stack   errors.StackTrace
		// The operation that failed: "parse", "unescape", "resolve", "join".
		op      string
		// The text that was being read.
		text    string
	}

	// UserInfo is the user name and optional password in front of the host
	// (`user:secret@host`), decoded.
	type UserInfo {
		username string
		password ?string = none

		def new(username string, password ?string = none) {
			self.username = username
			self.password = password
		}

		// str renders `username` or `username:password`, escaped for a URL.
		def str() string {
			let out = escapeWith(username, Encoding.UserPassword)
			let pw = password
			return out when pw is none
			return out + ":" + escapeWith(pw, Encoding.UserPassword)
		}
	}

	// HostKind says what the host text is: a DNS name, an IPv4 or an IPv6
	// literal. `Host.kind` saves every caller from sniffing dots and colons.
	enum HostKind {
		Domain,
		IPv4,
		IPv6,
	}

	// Host is the authority's host and port taken apart: `example.com`,
	// `10.0.0.1:8080` or `[::1]:443`. `port` is 0 when the URL wrote none;
	// `text` is the host alone, unbracketed.
	//
	// ```
	// let h = (try parse("https://[::1]:8443/x")).authority()
	// h.kind == HostKind.IPv6 && h.text == "::1" && h.port == 8443
	// ```
	type Host {
		kind HostKind
		text string
		port int

		// str renders the host as the authority wants it: brackets back
		// around IPv6, `:port` when there is one.
		def str() string {
			let out = text
			out = "[" + text + "]" when kind == HostKind.IPv6
			out += ":{port}" when port > 0
			return out
		}
	}

	// defaultPort is the port a scheme implies: 80 for http, 443 for https,
	// 21 ftp, 22 ssh, 80 ws, 443 wss. 0 for an unknown scheme.
	//
	// ```
	// defaultPort("https") == 443
	// ```
	def defaultPort(scheme string) int {
		let s = scheme.lower()
		return 80 when s == "http" || s == "ws"
		return 443 when s == "https" || s == "wss"
		return 21 when s == "ftp"
		return 22 when s == "ssh" || s == "sftp"
		return 0
	}

	// canParse reports whether parse would succeed, without the error.
	//
	// ```
	// canParse("http://x/a b") == true      // spaces are escaped on the way in
	// canParse("http://[::1") == false
	// ```
	def canParse(text string) bool {
		let ok = true
		parse(text) onerror (err error) {
			ok = false
			recover new URL()
		}
		return ok
	}

	// URL is a parsed URI reference (RFC 3986): every part decoded and kept
	// separately, so `str` re-encodes only what each part needs.
	//
	//   scheme://user:password@host:port/path?query#fragment
	//   scheme:opaque?query#fragment
	//
	// A relative reference has no scheme (and often no host); `resolve` turns
	// it into an absolute one against a base.
	type URL {
		scheme     string
		// The text after `scheme:` when the URL has no `//` authority
		// (`mailto:a@b`, `urn:isbn:...`), still encoded; "" otherwise.
		opaque     string
		user       ?UserInfo = none
		// The authority's host, with `:port` when one was given; IPv6 stays
		// bracketed (`[::1]:8080`). "" for a relative reference.
		host       string
		// The path, decoded (`/a b`).
		path       string
		// The path as written when its encoding matters (`/a%2Fb`); "" when
		// the default encoding of `path` reproduces it.
		rawPath    string
		// The query without `?`, still encoded; `query()` decodes it.
		rawQuery   string
		// True when the URL had a `?` with nothing after it, so `str` keeps it.
		forceQuery bool
		// The fragment, decoded.
		fragment   string

		def new() {}

		// setPath stores an escaped path: `path` decoded, `rawPath` only when
		// the default encoding of `path` would not reproduce the text.
		internal def setPath(escaped string) !none {
			return storePath(self, escaped)
		}

		internal def clone() URL {
			let out = new URL()
			out.scheme = scheme
			out.opaque = opaque
			out.user = user
			out.host = host
			out.path = path
			out.rawPath = rawPath
			out.rawQuery = rawQuery
			out.forceQuery = forceQuery
			out.fragment = fragment
			return out
		}

		// isAbs reports whether the URL has a scheme.
		def isAbs() bool {
			return scheme != ""
		}

		// hostname is the host without the port and without IPv6 brackets.
		def hostname() string {
			let (name, _) = splitHostPort(host)
			return name
		}

		// port is the port in the host, 0 when there is none.
		def port() int {
			let (_, portText) = splitHostPort(host)
			return 0 when portText == ""
			return parseInt<int>(portText, 10)
		}

		// authority is the host taken apart: kind, text and port (`host` is
		// the raw field).
		//
		// ```
		// (try parse("http://10.0.0.1:8080/")).authority().kind == HostKind.IPv4
		// ```
		def authority() Host {
			let out = new Host()
			out.text = hostname()
			out.port = port()
			out.kind = HostKind.Domain
			out.kind = HostKind.IPv6 when host.startsWith("[")
			out.kind = HostKind.IPv4 when isIPv4(out.text)
			return out
		}

		// effectivePort is the written port, else the scheme's default, else 0.
		// What a dialer uses.
		//
		// ```
		// (try parse("https://example.com/")).effectivePort() == 443
		// ```
		def effectivePort() int {
			let p = port()
			return p when p != 0
			return defaultPort(scheme)
		}

		// origin is `scheme://host:port`, the part a browser treats as one
		// security domain: two URLs with the same origin may share cookies and
		// pass CORS; different origins are different sites. The default port
		// is dropped, path, query and fragment are not included; "" for an
		// opaque or relative URL.
		//
		// ```
		// (try parse("https://example.com:443/a?b#c")).origin() == "https://example.com"
		// (try parse("http://example.com:8080/x")).origin() == "http://example.com:8080"
		// ```
		def origin() string {
			return "" when scheme == "" || opaque != "" || host == ""
			let out = scheme.lower() + "://" + hostname().lower()
			out = scheme.lower() + "://[" + hostname().lower() + "]" when host.startsWith("[")
			let p = port()
			out += ":{p}" when p != 0 && p != defaultPort(scheme)
			return out
		}

		// sameOrigin is true when both URLs have the same scheme, host and
		// effective port, the check behind CORS and CSRF decisions.
		//
		// ```
		// let a = try parse("https://example.com/login")
		// let b = try parse("https://example.com:443/api")
		// a.sameOrigin(b) == true
		// ```
		def sameOrigin(other URL) bool {
			return scheme.lower() == other.scheme.lower() && hostname().lower() == other.hostname().lower() && effectivePort() == other.effectivePort()
		}

		// segments is the path split on `/`, decoded, without the leading
		// empty piece: `/users/42/posts` gives `["users", "42", "posts"]`;
		// a trailing slash gives a final "".
		//
		// ```
		// (try parse("http://x/users/42/posts")).segments() == ["users", "42", "posts"]
		// (try parse("http://x/a%2Fb/c")).segments() == ["a/b", "c"]
		// ```
		def segments() string[] {
			let p = escapedPath()
			return [] when p == "" || p == "/"
			p = p[1:] when p.startsWith("/")
			let out string[] = []
			for let piece in p.split("/") {
				let decoded = unescapeWith(piece, Encoding.PathSegment) onerror recover piece
				out.push(decoded)
			}
			return out
		}

		// withSegments is a copy with the path rebuilt from decoded segments,
		// each escaped as a path segment (`/` inside one becomes `%2F`).
		//
		// ```
		// let u = try parse("http://x/old")
		// u.withSegments(["users", "a/b"]).str() == "http://x/users/a%2Fb"
		// ```
		def withSegments(segments string[]) URL {
			let out = clone()
			let escaped string[] = []
			for let seg in segments {
				escaped.push(escapeWith(seg, Encoding.PathSegment))
			}
			out.path = "/" + segments.join("/")
			out.rawPath = "/" + escaped.join("/")
			out.rawPath = "" when out.rawPath == out.path
			return out
		}

		// lastSegment is the final path segment, "" for `/` or an empty path.
		//
		// ```
		// (try parse("http://x/docs/guide.pdf")).lastSegment() == "guide.pdf"
		// ```
		def lastSegment() string {
			let segs = segments()
			return "" when segs.len() == 0
			return segs[segs.len() - 1]
		}

		// relativeTo is the shortest reference that resolves to this URL
		// against the base: the inverse of resolve. Both must share scheme
		// and host, else the absolute URL comes back. For generating links
		// from one page to another.
		//
		// ```
		// let base = try parse("http://x/docs/guide/intro.html")
		// let target = try parse("http://x/docs/api/index.html?v=2")
		// target.relativeTo(base).str() == "../api/index.html?v=2"
		// base.resolve(target.relativeTo(base)).equals(target)
		// ```
		def relativeTo(base URL) URL {
			return clone() when scheme.lower() != base.scheme.lower() || host.lower() != base.host.lower() || opaque != "" || base.opaque != ""
			let target = pathPieces(escapedPath())
			let from = pathPieces(base.escapedPath())
			// The base's last piece names a file, not a directory, so drop it.
			from.pop() when from.len() > 0
			let i = 0
			for i < from.len() && i < target.len() && from[i] == target[i] {
				i++
			}
			let rel = ""
			for let k = i; k < from.len(); k++ {
				rel += "../"
			}
			rel += target.slice(i, none).join("/")
			rel = "./" when rel == ""
			let out = new URL()
			out.setPath(rel) onerror recover none
			out.rawQuery = rawQuery
			out.forceQuery = forceQuery
			out.fragment = fragment
			return out
		}

		// normalize is the URL in its RFC 3986 §6 canonical form: scheme and
		// host lowercased, unreserved percent-escapes decoded (`%7E` to `~`),
		// escape hex uppercased, `.` and `..` segments removed, the default
		// port dropped, an empty path made `/`. Two URLs that normalize the
		// same identify the same resource.
		//
		// ```
		// (try parse("HTTP://Example.COM:80/a/./b/../c/%7ex")).normalize().str() == "http://example.com/a/c/~x"
		// ```
		def normalize() URL {
			let out = clone()
			out.scheme = scheme.lower()
			return out when opaque != ""
			if host != "" {
				let (name, portText) = splitHostPort(host)
				let h = new Host()
				h.text = name.lower()
				h.kind = HostKind.Domain
				h.kind = HostKind.IPv6 when host.startsWith("[")
				h.port = 0
				h.port = parseInt<int>(portText, 10) when portText != ""
				h.port = 0 when h.port == defaultPort(out.scheme)
				out.host = h.str()
			}
			let p = resolvePath(escapedPath(), "")
			p = "/" when p == "" && out.host != ""
			out.setPath(p) onerror recover none
			out.rawPath = ""
			return out
		}

		// filePath is the local path a `file://` URL names. Fails with
		// UrlError when the scheme is not `file` or the host is another
		// machine.
		//
		// ```
		// (try parse("file:///home/sy/notes.txt")).filePath() == "/home/sy/notes.txt"
		// (try parse("file:///C:/Users/sy/a.txt")).filePath() == "C:/Users/sy/a.txt"     // Windows form
		// ```
		def filePath() !string {
			fail UrlError{message: "not a file URL: {str()}", op: "file", text: str()} when scheme.lower() != "file"
			fail UrlError{message: "file URL names another host: {host}", op: "file", text: str()} when host != "" && host.lower() != "localhost"
			let p = path
			p = p[1:] when p.len() >= 3 && p[0] == '/' && p[2] == ':' && p[1].isLetter()
			return p
		}

		// with is a copy with one part replaced, for building a URL from a
		// base without touching the others. An unknown part name fails.
		//
		// ```
		// let api = try parse("https://api.example.com/v1")
		// (try api.with("path", "/v1/users")).str() == "https://api.example.com/v1/users"
		// (try api.with("query", "page=2")).str() == "https://api.example.com/v1?page=2"
		// ```
		def with(part string, value string) !URL {
			let out = clone()
			if part == "scheme" {
				out.scheme = value.lower()
			} else if part == "opaque" {
				out.opaque = value
			} else if part == "host" {
				out.host = value
			} else if part == "path" {
				try out.setPath(value)
			} else if part == "query" {
				out.rawQuery = value
				out.forceQuery = false
			} else if part == "fragment" {
				out.fragment = value
			} else if part == "user" {
				let current = user
				if current is none {
					out.user = new UserInfo(value)
				} else {
					out.user = new UserInfo(value, current.password)
				}
			} else if part == "password" {
				let current = user
				if current is none {
					out.user = new UserInfo("", value)
				} else {
					out.user = new UserInfo(current.username, value)
				}
			} else {
				fail UrlError{message: "no URL part named {part}", op: "with", text: part}
			}
			return out
		}

		// query parses rawQuery; a malformed escape drops that pair and keeps
		// the rest, so a request with a bad parameter still routes.
		def query() Values {
			return parseQueryWith(rawQuery, 0, false) onerror recover new Values()
		}

		// setQuery replaces rawQuery with the encoded values.
		def setQuery(values Values) {
			rawQuery = values.encode()
			forceQuery = false
		}

		// escapedPath is the path as it goes on the wire: rawPath when it is a
		// valid encoding of path, else path escaped.
		def escapedPath() string {
			if rawPath != "" && validEncoded(rawPath, Encoding.Path) {
				let decoded = unescapeWith(rawPath, Encoding.Path) onerror recover ""
				return rawPath when decoded == path
			}
			return "*" when path == "*"
			return escapeWith(path, Encoding.Path)
		}

		// requestURI is what a request line carries: the escaped path (`/`
		// when empty) and `?query` when there is one; opaque URLs give
		// `scheme:opaque`.
		def requestURI() string {
			let out = opaque
			if out == "" {
				out = escapedPath()
				out = "/" when out == ""
			} else if out.startsWith("//") {
				out = scheme + ":" + out
			}
			out += "?" + rawQuery when forceQuery || rawQuery != ""
			return out
		}

		// resolve applies a reference to this URL as a base (RFC 3986 §5.2):
		// an absolute reference is returned as is, a relative one takes the
		// base's scheme and authority and merges paths with `.` and `..`
		// removed.
		def resolve(ref URL) URL {
			let out = new URL()
			out.scheme = ref.scheme
			out.scheme = scheme when ref.scheme == ""
			if ref.scheme != "" || ref.host != "" || !(ref.user is none) {
				// The reference is absolute or brings its own authority.
				out.host = ref.host
				out.user = ref.user
				out.opaque = ref.opaque
				out.rawQuery = ref.rawQuery
				out.forceQuery = ref.forceQuery
				out.fragment = ref.fragment
				out.setPath(resolvePath(ref.escapedPath(), "")) onerror recover none
				return out
			}
			if ref.opaque != "" {
				out.opaque = ref.opaque
				out.rawQuery = ref.rawQuery
				out.forceQuery = ref.forceQuery
				out.fragment = ref.fragment
				return out
			}
			out.host = host
			out.user = user
			if ref.path == "" && ref.rawPath == "" && !ref.forceQuery && ref.rawQuery == "" {
				// Only a fragment (or nothing): the base with that fragment.
				out.path = path
				out.rawPath = rawPath
				out.rawQuery = rawQuery
				out.forceQuery = forceQuery
				out.fragment = ref.fragment
				return out
			}
			out.rawQuery = ref.rawQuery
			out.forceQuery = ref.forceQuery
			out.fragment = ref.fragment
			out.setPath(resolvePath(escapedPath(), ref.escapedPath())) onerror recover none
			return out
		}

		// resolve parses the reference first. Fails with UrlError (op
		// "resolve") when it does not parse.
		def resolve(ref string) !URL {
			let parsed = parse(ref) onerror (err error) {
				fail UrlError{message: "resolve {ref}: {err.message}", op: "resolve", text: ref, cause: err}
			}
			return resolve(parsed)
		}

		// join appends path elements, each cleaned of `.` and `..`, keeping a
		// trailing slash when the last element has one. Fails with UrlError
		// (op "join") when an element escapes above the root.
		def join(elems string[]) !URL {
			let out = clone()
			let joined = escapedPath()
			for let elem in elems {
				joined += "/" + elem
			}
			let cleaned = try cleanPath(joined, str())
			try out.setPath(cleaned)
			return out
		}

		// redacted is str with the password replaced by `xxxxx`, for logs.
		def redacted() string {
			let current = user
			return str() when current is none
			return str() when current.password is none
			let out = clone()
			out.user = new UserInfo(current.username, "xxxxx")
			return out.str()
		}

		// str renders the URL: parts escaped as each needs, `//` authority
		// only when there is a host or user, `?` when there is a query or
		// forceQuery is set, `#` when there is a fragment.
		def str() string {
			let out = ""
			out += scheme + ":" when scheme != ""
			if opaque != "" {
				out += opaque
			} else {
				if scheme != "" || host != "" || !(user is none) {
					if host != "" || path != "" || !(user is none) {
						out += "//"
					}
					let current = user
					if !(current is none) {
						out += current.str() + "@"
					}
					out += escapeWith(host, Encoding.Host)
				}
				let p = escapedPath()
				out += "/" when p != "" && !p.startsWith("/") && host != ""
				out += p
			}
			out += "?" + rawQuery when forceQuery || rawQuery != ""
			out += "#" + escapeWith(fragment, Encoding.Fragment) when fragment != ""
			return out
		}

		// Percent-encodes `text` for use in a URL component (RFC 3986 unreserved
		// characters pass through, everything else is `%XX` per UTF-8 byte).
		def encode() string {
			return urlEncode(str())
		}

		def equals(other URL) bool {
			return str() == other.str()
		}

		// json renders the URL as a JSON string.
		def json() byte[] {
			let out = "\""
			for let (_, ch) in str() {
				if ch == '"' {
					out += "\\\""
				} else if ch == '\\' {
					out += "\\\\"
				} else if int(ch) < 32 {
					out += "\\u" + int(ch).toRadix(16, 4)
				} else {
					out += string(ch)
				}
			}
			return (out + "\"").bytes()
		}

		// json sets the URL from a JSON string. Fails when the text is not a
		// JSON string or does not parse as a URL.
		def json(data byte[]) !none {
			let text = string(data).trim()
			fail UrlError{message: "expected a JSON string", op: "json", text: text} when text.len() < 2 || text[0] != '"' || text[text.len() - 1] != '"'
			let inner = ""
			let body = text[1:text.len() - 1]
			let i = 0
			for i < body.len() {
				let ch = body[i]
				if ch == '\\' && i + 1 < body.len() {
					inner += string(body[i + 1])
					i += 2
					continue
				}
				inner += string(ch)
				i += 1
			}
			let parsed = try parse(inner)
			scheme = parsed.scheme
			opaque = parsed.opaque
			user = parsed.user
			host = parsed.host
			path = parsed.path
			rawPath = parsed.rawPath
			rawQuery = parsed.rawQuery
			forceQuery = parsed.forceQuery
			fragment = parsed.fragment
			return none
		}
	}

	// parse reads a URI reference, absolute or relative. Fails with UrlError
	// (op "parse") on a control character, a bad escape, an invalid scheme, a
	// bare port that is not a number, or a relative path in the first segment
	// that holds a colon (`a:b`, which would read as a scheme).
	def parse(text string) !URL {
		return parseRef(text, false)
	}

	// parseRequest reads the target of a request line: an absolute URL or an
	// absolute path (`/index.html?x=1`), never a fragment. Fails with
	// UrlError (op "parse") for anything else.
	def parseRequest(text string) !URL {
		fail UrlError{message: "invalid URI for request: a fragment is not part of a request target", op: "parse", text: text} when text.contains("#")
		return parseRef(text, true)
	}

	// pathEscape percent-encodes text for one path segment: `/` becomes `%2F`.
	def pathEscape(text string) string {
		return escapeWith(text, Encoding.PathSegment)
	}

	// pathUnescape decodes a path segment. Fails with UrlError (op
	// "unescape") on a malformed escape; `+` stays `+`.
	def pathUnescape(text string) !string {
		return unescapeWith(text, Encoding.PathSegment)
	}

	// queryEscape percent-encodes text for a query key or value: a space
	// becomes `+`.
	def queryEscape(text string) string {
		return escapeWith(text, Encoding.QueryComponent)
	}

	// queryUnescape decodes a query key or value: `+` becomes a space. Fails
	// with UrlError (op "unescape") on a malformed escape.
	def queryUnescape(text string) !string {
		return unescapeWith(text, Encoding.QueryComponent)
	}

	// fromFilePath is the `file://` URL for a local absolute path; each
	// segment escaped, a Windows drive kept as `/C:/`. Fails with UrlError
	// when the path is relative.
	//
	// ```
	// (try fromFilePath("/home/sy/my notes.txt")).str() == "file:///home/sy/my%20notes.txt"
	// ```
	def fromFilePath(path string) !URL {
		let p = path.replace("\\", "/")
		let drive = p.len() >= 2 && p[0].isLetter() && p[1] == ':'
		fail UrlError{message: "file path is not absolute: {path}", op: "file", text: path} unless p.startsWith("/") || drive
		p = "/" + p when drive
		let out = new URL()
		out.scheme = "file"
		out.path = p
		return out
	}

	// escape percent-encodes every byte that is not unreserved (letters,
	// digits, `-._~`) and not in `safe`. One function for the cases the
	// path and query variants do not cover, as Python's quote(text, safe).
	//
	// ```
	// escape("a/b c", "/") == "a/b%20c"
	// escape("a/b c", "") == "a%2Fb%20c"
	// ```
	def escape(text string, safe string = "") string {
		let out = ""
		for let b in text.bytes() {
			let c = int(b)
			if isUnreserved(b) || (c < 128 && safe.contains(string(char(c)))) {
				out += string(char(c))
			} else {
				out += "%" + string(hexDigits[c >> 4]) + string(hexDigits[c & 15])
			}
		}
		return out
	}

	// unescape decodes every `%XX`; `+` stays `+`. Fails with UrlError on a
	// malformed escape.
	//
	// ```
	// (try unescape("a%2Fb%20c")) == "a/b c"
	// ```
	def unescape(text string) !string {
		return unescapeWith(text, Encoding.Path)
	}

	// heuristicParse reads text a person typed: `example.com/x` gets
	// `http://`, `localhost:8080` too, a full URL passes through. For CLI
	// arguments and config files, never for untrusted input.
	//
	// ```
	// (try heuristicParse("example.com/docs")).str() == "http://example.com/docs"
	// (try heuristicParse("https://x/y")).str() == "https://x/y"
	// ```
	def heuristicParse(text string) !URL {
		let trimmed = text.trim()
		return parse(trimmed) when trimmed.contains("://")
		return parse("http://" + trimmed)
	}

	// joinPath parses the base and appends the elements as URL.join does.
	// Fails with UrlError when the base does not parse or an element escapes
	// the root.
	def joinPath(base string, elems string[]) !string {
		let u = parse(base) onerror (err error) {
			fail UrlError{message: "join {base}: {err.message}", op: "join", text: base, cause: err}
		}
		return (try u.join(elems)).str()
	}

	// Percent-encodes `text` for use in a URL component (RFC 3986 unreserved
	// characters pass through, everything else is `%XX` per UTF-8 byte).
	def urlEncode(text string) string {
		let result = ""
		for let (_, ch) in text {
			if (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || (ch := '-' || '_' || '.' || '~') {
				result += string(ch)
			} else {
				// This is a simplified hex encoding. A full implementation would need a robust hex formatting utility.
				let code = int(ch)
				let hex = "0123456789ABCDEF"
				result += "%" + string(hex[code >> 4]) + string(hex[code & 0x0F])
			}
		}
		return result
	}

	// Decodes percent escapes and plus signs in a URL-encoded `text`.
	def urlDecode(text string) string {
		let result = ""
		let i = 0
		let n = text.len()
		for i < n {
			let ch = text[i]
			if ch == '%' {
				if i + 2 < n {
					let hi = text[i + 1]
					let lo = text[i + 2]
					let hiVal = 0
					let loVal = 0

					if hi >= '0' && hi <= '9' {
						hiVal = int(hi) - int('0')
					} else if hi >= 'A' && hi <= 'F' {
						hiVal = int(hi) - int('A') + 10
					} else if hi >= 'a' && hi <= 'f' {
						hiVal = int(hi) - int('a') + 10
					}

					if lo >= '0' && lo <= '9' {
						loVal = int(lo) - int('0')
					} else if lo >= 'A' && lo <= 'F' {
						loVal = int(lo) - int('A') + 10
					} else if lo >= 'a' && lo <= 'f' {
						loVal = int(lo) - int('a') + 10
					}

					result += string(char(hiVal * 16 + loVal))
					i += 3
				} else {
					result += "%"
					i += 1
				}
			} else if ch == '+' {
				result += " "
				i += 1
			} else {
				result += string(ch)
				i += 1
			}
		}
		return result
	}

	internal const hexDigits = "0123456789ABCDEF"

	// Encoding is which part of a URL a byte sits in; each part keeps a
	// different set of characters bare (RFC 3986 §2.2, as Go's net/url).
	internal enum Encoding {
		Path,
		PathSegment,
		Host,
		UserPassword,
		QueryComponent,
		Fragment,
	}

	// Unreserved bytes never need escaping: letters, digits, `-._~`.
	internal def isUnreserved(b byte) bool {
		let c = int(b)
		return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 45 || c == 95 || c == 46 || c == 126
	}

	// Sub-delimiters: `!$&'()*+,;=`.
	internal def isSubDelim(c int) bool {
		return c == 33 || c == 36 || c == 38 || c == 39 || c == 40 || c == 41 || c == 42 || c == 43 || c == 44 || c == 59 || c == 61
	}

	internal def isHexByte(b byte) bool {
		let c = int(b)
		return (c >= 48 && c <= 57) || (c >= 97 && c <= 102) || (c >= 65 && c <= 70)
	}

	internal def hexValue(b byte) int {
		let c = int(b)
		return c - 48 when c >= 48 && c <= 57
		return c - 97 + 10 when c >= 97 && c <= 102
		return c - 65 + 10
	}

	// shouldEscape says whether a byte must be percent-encoded in the part.
	internal def shouldEscape(b byte, mode Encoding) bool {
		return false when isUnreserved(b)
		let c = int(b)
		if mode == Encoding.Host {
			// A host keeps sub-delimiters, `:` for the port, `[]` for IPv6.
			return !(isSubDelim(c) || c == 58 || c == 91 || c == 93)
		}
		if isSubDelim(c) || c == 58 || c == 47 || c == 63 || c == 64 {
			// `:` `/` `?` `@` and the sub-delimiters: allowed in some parts.
			return c == 63 when mode == Encoding.Path
			return c == 47 || c == 59 || c == 44 || c == 63 when mode == Encoding.PathSegment
			return c == 64 || c == 47 || c == 63 || c == 58 when mode == Encoding.UserPassword
			return true when mode == Encoding.QueryComponent
			return false
		}
		return true
	}

	// escapeWith percent-encodes text for the part; a query component writes
	// a space as `+`.
	internal def escapeWith(text string, mode Encoding) string {
		let out = ""
		for let b in text.bytes() {
			let c = int(b)
			if c == 32 && mode == Encoding.QueryComponent {
				out += "+"
			} else if shouldEscape(b, mode) {
				out += "%" + string(hexDigits[c >> 4]) + string(hexDigits[c & 15])
			} else {
				out += string(char(c))
			}
		}
		return out
	}

	// unescapeWith decodes every `%XX`; a query component reads `+` as a
	// space. Fails with UrlError on a malformed escape.
	internal def unescapeWith(text string, mode Encoding) !string {
		let src = text.bytes()
		let out byte[] = []
		let n = src.len()
		let i = 0
		for i < n {
			let c = int(src[i])
			if c == 37 {
				fail UrlError{message: "invalid URL escape in \"{text}\"", op: "unescape", text: text} when i + 2 >= n || !isHexByte(src[i + 1]) || !isHexByte(src[i + 2])
				out.push(byte(hexValue(src[i + 1]) * 16 + hexValue(src[i + 2])))
				i += 3
			} else if c == 43 && mode == Encoding.QueryComponent {
				out.push(byte(32))
				i += 1
			} else {
				out.push(src[i])
				i += 1
			}
		}
		return string(out)
	}

	// validEncoded reports whether text is a well-formed encoding for the
	// part: every `%` starts a full escape and no byte is one the part would
	// escape (`?` in a path, say).
	internal def validEncoded(text string, mode Encoding) bool {
		let src = text.bytes()
		for let i = 0; i < src.len(); i++ {
			let c = int(src[i])
			if c == 37 {
				return false when i + 2 >= src.len() || !isHexByte(src[i + 1]) || !isHexByte(src[i + 2])
				i += 2
				continue
			}
			// `[`, `]` and `:` stay bare in a raw path (Go does the same).
			continue when c == 91 || c == 93 || c == 58
			return false when c > 127 || shouldEscape(src[i], mode)
		}
		return true
	}

	internal def lastIndexOfChar(text string, ch char) int {
		for let i = text.len() - 1; i >= 0; i-- {
			return i when text[i] == ch
		}
		return -1
	}

	// splitHostPort separates `host:port` and `[v6]:port`; the port is ""
	// when the text has none.
	internal def splitHostPort(hostPort string) (string, string) {
		let host = hostPort
		let portText = ""
		let colon = lastIndexOfChar(hostPort, ':')
		if colon >= 0 && colon > lastIndexOfChar(hostPort, ']') {
			portText = hostPort[colon + 1:]
			host = hostPort[:colon]
		}
		host = host[1:host.len() - 1] when host.startsWith("[") && host.endsWith("]")
		return (host, portText)
	}

	internal def isIPv4(text string) bool {
		let parts = text.split(".")
		return false when parts.len() != 4
		for let part in parts {
			return false when part == "" || part.len() > 3
			for let (_, ch) in part {
				return false unless ch.isDigit()
			}
			return false when parseInt<int>(part, 10) > 255
		}
		return true
	}

	// pathPieces splits an escaped path on `/` without the leading empty piece.
	internal def pathPieces(p string) string[] {
		return [] when p == ""
		p = p[1:] when p.startsWith("/")
		return p.split("/")
	}

	// getScheme splits `scheme:rest`; no scheme gives ("", text). Fails when
	// the text starts with a character no scheme may start with, or a scheme
	// is empty.
	internal def getScheme(raw string) !(string, string) {
		for let i = 0; i < raw.len(); i++ {
			let c = raw[i]
			continue when c.isLetter()
			if c.isDigit() || c == '+' || c == '-' || c == '.' {
				return ("", raw) when i == 0
				continue
			}
			if c == ':' {
				fail UrlError{message: "missing protocol scheme", op: "parse", text: raw} when i == 0
				return (raw[:i], raw[i + 1:])
			}
			return ("", raw)
		}
		return ("", raw)
	}

	// parseAuthority fills user and host from `user:pass@host:port`.
	internal def parseAuthority(u URL, authority string) !none {
		let hostText = authority
		let at = lastIndexOfChar(authority, '@')
		if at >= 0 {
			let info = authority[:at]
			hostText = authority[at + 1:]
			for let (_, ch) in info {
				fail UrlError{message: "invalid userinfo", op: "parse", text: authority} when ch == '/' || ch == '?' || ch == '#' || ch == '[' || ch == ']'
			}
			let colon = info.indexOf(":")
			if colon < 0 {
				u.user = new UserInfo(try unescapeWith(info, Encoding.UserPassword))
			} else {
				u.user = new UserInfo(try unescapeWith(info[:colon], Encoding.UserPassword), try unescapeWith(info[colon + 1:], Encoding.UserPassword))
			}
		}
		u.host = try parseHost(hostText)
		return none
	}

	// parseHost validates `host`, `host:port`, `[v6]` and `[v6]:port`.
	internal def parseHost(hostText string) !string {
		if hostText.startsWith("[") {
			let close = lastIndexOfChar(hostText, ']')
			fail UrlError{message: "missing ']' in host", op: "parse", text: hostText} when close < 0
			let tail = hostText[close + 1:]
			try validPort(tail, hostText)
			return hostText
		}
		let colon = lastIndexOfChar(hostText, ':')
		if colon >= 0 {
			try validPort(hostText[colon:], hostText)
		}
		return unescapeWith(hostText, Encoding.Host)
	}

	// validPort accepts "" or `:` followed by digits.
	internal def validPort(tail string, hostText string) !none {
		return none when tail == ""
		fail UrlError{message: "invalid port \"{tail}\" after host", op: "parse", text: hostText} unless tail.startsWith(":")
		for let (_, ch) in tail[1:] {
			fail UrlError{message: "invalid port \"{tail}\" after host", op: "parse", text: hostText} unless ch.isDigit()
		}
		return none
	}

	// parseRef reads a URI reference; viaRequest applies the request-line
	// rules (no relative paths, no empty text).
	internal def parseRef(text string, viaRequest bool) !URL {
		fail UrlError{message: "empty url", op: "parse", text: text} when text == "" && viaRequest
		for let (_, ch) in text {
			fail UrlError{message: "invalid control character in URL", op: "parse", text: text} when int(ch) < 32 || int(ch) == 127
		}
		let u = new URL()
		let rest = text
		let hash = rest.indexOf("#")
		if hash >= 0 {
			u.fragment = try unescapeWith(rest[hash + 1:], Encoding.Fragment)
			rest = rest[:hash]
		}
		if rest == "*" {
			u.path = "*"
			return u
		}
		let (scheme, after) = try getScheme(rest)
		u.scheme = scheme.lower()
		rest = after
		if rest.endsWith("?") && rest.count("?") == 1 {
			u.forceQuery = true
			rest = rest[:rest.len() - 1]
		} else {
			let q = rest.indexOf("?")
			if q >= 0 {
				u.rawQuery = rest[q + 1:]
				rest = rest[:q]
			}
		}
		if !rest.startsWith("/") {
			if u.scheme != "" {
				u.opaque = rest
				return u
			}
			fail UrlError{message: "invalid URI for request", op: "parse", text: text} when viaRequest
			let segEnd = rest.indexOf("/")
			let seg = rest
			seg = rest[:segEnd] when segEnd >= 0
			fail UrlError{message: "first path segment in URL cannot contain colon", op: "parse", text: text} when seg.contains(":")
		}
		if (u.scheme != "" || (!viaRequest && !rest.startsWith("///"))) && rest.startsWith("//") {
			let authority = rest[2:]
			rest = ""
			let slash = authority.indexOf("/")
			if slash >= 0 {
				rest = authority[slash:]
				authority = authority[:slash]
			}
			try parseAuthority(u, authority)
		}
		try storePath(u, rest)
		return u
	}

	// storePath stores an escaped path on a URL: `path` decoded, `rawPath`
	// only when the default encoding of `path` would not reproduce the text.
	internal def storePath(u URL, escaped string) !none {
		u.path = try unescapeWith(escaped, Encoding.Path)
		u.rawPath = ""
		u.rawPath = escaped when escapeWith(u.path, Encoding.Path) != escaped
		return none
	}

	// resolvePath merges a reference path into a base path and removes `.`
	// and `..` segments (RFC 3986 §5.2.4), as Go's resolvePath does.
	internal def resolvePath(base string, ref string) string {
		let full = ""
		if ref == "" {
			full = base
		} else if ref[0] != '/' {
			let i = lastIndexOfChar(base, '/')
			full = base[:i + 1] + ref
		} else {
			full = ref
		}
		return "" when full == ""
		let out = "/"
		let first = true
		let elem = ""
		for let piece in full.split("/") {
			elem = piece
			if elem == "." {
				first = false
				continue
			}
			if elem == ".." {
				let body = out[1:]
				let idx = lastIndexOfChar(body, '/')
				out = "/"
				if idx == -1 {
					first = true
				} else {
					out += body[:idx]
				}
				continue
			}
			out += "/" unless first
			out += elem
			first = false
		}
		out += "/" when elem == "." || elem == ".."
		out = out[1:] when out.len() > 1 && out[1] == '/'
		return out
	}

	// cleanPath removes `.` and `..` from a joined path, keeping a trailing
	// slash. Fails when `..` climbs above the root.
	internal def cleanPath(joined string, text string) !string {
		let absolute = joined.startsWith("/")
		let trailing = joined.endsWith("/") || joined.endsWith("/.") || joined.endsWith("/..")
		let stack string[] = []
		for let piece in joined.split("/") {
			continue when piece == "" || piece == "."
			if piece == ".." {
				fail UrlError{message: "path escapes the root: {joined}", op: "join", text: text} when stack.len() == 0
				stack.pop()
				continue
			}
			stack.push(piece)
		}
		let out = stack.join("/")
		out = "/" + out when absolute
		out += "/" when trailing && !out.endsWith("/")
		return out
	}
}
