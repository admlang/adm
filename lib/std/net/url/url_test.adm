partial module std.net.url {
	use std.testing

	check "URL encoding" {
		@test()
		def encode() {
			assert urlEncode("https://example.com") == "https%3A%2F%2Fexample.com"
			assert urlEncode("hello world") == "hello%20world"
			assert urlEncode("a/b?c=d&e") == "a%2Fb%3Fc%3Dd%26e"
			assert urlEncode("abc-123_.~") == "abc-123_.~"
		}

		@test()
		def decode() {
			assert urlDecode("https%3A%2F%2Fexample.com") == "https://example.com"
			assert urlDecode("hello%20world") == "hello world"
			assert urlDecode("a%2Fb%3Fc%3Dd%26e") == "a/b?c=d&e"
			assert urlDecode("invalid%2G") == "invalid "
			assert urlDecode("incomplete%") == "incomplete%"
		}
	}

	check "URL parse" {
		@test()
		def partsOfAnAbsoluteUrl() !none {
			let u = try parse("https://user:pa%20ss@example.com:8443/a%20b/c?x=1&y=2#frag%20ment")
			assert u.scheme == "https"
			assert u.host == "example.com:8443"
			assert u.hostname() == "example.com"
			assert u.port() == 8443
			assert u.path == "/a b/c"
			assert u.rawPath == ""
			assert u.escapedPath() == "/a%20b/c"
			assert u.rawQuery == "x=1&y=2"
			assert u.fragment == "frag ment"
			let info = u.user
			fail "expected user info" when info is none
			assert info.username == "user"
			let pw = info.password
			fail "expected password" when pw is none
			assert pw == "pa ss"
			assert u.str() == "https://user:pa%20ss@example.com:8443/a%20b/c?x=1&y=2#frag%20ment"
			assert u.isAbs()
			return none
		}

		@test()
		def keepsRawPathWhenEncodingMatters() !none {
			let u = try parse("http://x/a%2Fb/c")
			assert u.path == "/a/b/c"
			assert u.rawPath == "/a%2Fb/c"
			assert u.escapedPath() == "/a%2Fb/c"
			assert u.segments().equals(["a/b", "c"])
			assert u.str() == "http://x/a%2Fb/c"
			return none
		}

		@test()
		def relativeOpaqueAndQueryForms() !none {
			let rel = try parse("../a/b?q#f")
			assert !rel.isAbs()
			assert rel.path == "../a/b"
			assert rel.str() == "../a/b?q#f"
			let mail = try parse("mailto:someone@example.com")
			assert mail.opaque == "someone@example.com"
			assert mail.str() == "mailto:someone@example.com"
			let forced = try parse("http://x/p?")
			assert forced.forceQuery
			assert forced.str() == "http://x/p?"
			let v6 = try parse("http://[::1]:8080/x")
			assert v6.hostname() == "::1"
			assert v6.port() == 8080
			assert v6.authority().kind == HostKind.IPv6
			assert v6.authority().str() == "[::1]:8080"
			let v4 = try parse("http://10.0.0.1:8080/")
			assert v4.authority().kind == HostKind.IPv4
			assert (try parse("http://example.com/")).authority().kind == HostKind.Domain
			return none
		}

		@test()
		def rejectsMalformed() {
			for let bad in ["http://[::1", "http://x:abc/", "1a:b/c", "http://x/\u0001", "%zz"] {
				let failed = false
				parse(bad) onerror (err error) {
					if err is UrlError {
						failed = err.op == "parse" || err.op == "unescape"
					}
					recover new URL()
				}
				assert failed
			}
			assert !canParse("http://[::1")
			assert canParse("http://x/a b")
		}

		@test()
		def requestTargets() !none {
			let u = try parseRequest("/index.html?x=1")
			assert u.path == "/index.html"
			assert u.requestURI() == "/index.html?x=1"
			assert (try parse("http://x")).requestURI() == "/"
			let failed = false
			parseRequest("index.html#f") onerror (err error) {
				failed = true
				recover new URL()
			}
			assert failed
			return none
		}
	}

	check "URL helpers" {
		@test()
		def originsAndPorts() !none {
			assert (try parse("https://example.com:443/a?b#c")).origin() == "https://example.com"
			assert (try parse("http://example.com:8080/x")).origin() == "http://example.com:8080"
			assert (try parse("/relative")).origin() == ""
			assert (try parse("https://example.com/")).effectivePort() == 443
			assert defaultPort("https") == 443
			assert defaultPort("gopher") == 0
			let a = try parse("https://example.com/login")
			let b = try parse("https://example.com:443/api")
			let c = try parse("http://example.com/api")
			assert a.sameOrigin(b)
			assert !a.sameOrigin(c)
			return none
		}

		@test()
		def segmentsAndJoins() !none {
			let u = try parse("http://x/users/42/posts")
			assert u.segments().equals(["users", "42", "posts"])
			assert u.lastSegment() == "posts"
			assert u.withSegments(["users", "a/b"]).str() == "http://x/users/a%2Fb"
			assert (try u.join(["7", "comments"])).str() == "http://x/users/42/posts/7/comments"
			assert (try u.join(["..", "..", "42", "profile"])).str() == "http://x/users/42/profile"
			assert (try joinPath("http://x/a/", ["b", "c/"])) == "http://x/a/b/c/"
			let failed = false
			u.join(["..", "..", "..", "..", "up"]) onerror (err error) {
				if err is UrlError {
					failed = err.op == "join"
				}
				recover new URL()
			}
			assert failed
			return none
		}

		@test()
		def resolvesReferences() !none {
			let base = try parse("http://a/b/c/d;p?q")
			let cases = [
				["g", "http://a/b/c/g"],
				["./g", "http://a/b/c/g"],
				["g/", "http://a/b/c/g/"],
				["/g", "http://a/g"],
				["//g", "http://g"],
				["?y", "http://a/b/c/d;p?y"],
				["g?y", "http://a/b/c/g?y"],
				["#s", "http://a/b/c/d;p?q#s"],
				["", "http://a/b/c/d;p?q"],
				[".", "http://a/b/c/"],
				["..", "http://a/b/"],
				["../g", "http://a/b/g"],
				["../..", "http://a/"],
				["../../g", "http://a/g"],
				["../../../g", "http://a/g"],
				["g;x=1/../y", "http://a/b/c/y"],
				["http://z/q", "http://z/q"],
			]
			for let pair in cases {
				let got = (try base.resolve(pair[0])).str()
				assert got == pair[1]
			}
			return none
		}

		@test()
		def relativeToInvertsResolve() !none {
			let base = try parse("http://x/docs/guide/intro.html")
			let target = try parse("http://x/docs/api/index.html?v=2")
			assert target.relativeTo(base).str() == "../api/index.html?v=2"
			assert base.resolve(target.relativeTo(base)).equals(target)
			let sibling = try parse("http://x/docs/guide/next.html")
			assert sibling.relativeTo(base).str() == "next.html"
			let other = try parse("https://y/docs")
			assert other.relativeTo(base).str() == "https://y/docs"
			return none
		}

		@test()
		def normalizesAndCompares() !none {
			let u = try parse("HTTP://Example.COM:80/a/./b/../c/%7ex")
			assert u.normalize().str() == "http://example.com/a/c/~x"
			assert (try parse("http://x")).normalize().str() == "http://x/"
			assert (try parse("http://x/a")).equals(try parse("http://x/a"))
			return none
		}

		@test()
		def withReplacesOneParts() !none {
			let api = try parse("https://api.example.com/v1")
			assert (try api.with("path", "/v1/users")).str() == "https://api.example.com/v1/users"
			assert (try api.with("query", "page=2")).str() == "https://api.example.com/v1?page=2"
			assert (try api.with("fragment", "top")).str() == "https://api.example.com/v1#top"
			assert (try api.with("scheme", "http")).str() == "http://api.example.com/v1"
			assert (try api.with("user", "bob")).str() == "https://bob@api.example.com/v1"
			let failed = false
			api.with("colour", "red") onerror (err error) {
				failed = true
				recover new URL()
			}
			assert failed
			assert (try parse("https://bob:secret@x/")).redacted() == "https://bob:xxxxx@x/"
			return none
		}

		@test()
		def fileUrls() !none {
			assert (try (try parse("file:///home/sy/notes.txt")).filePath()) == "/home/sy/notes.txt"
			assert (try (try parse("file:///C:/Users/sy/a.txt")).filePath()) == "C:/Users/sy/a.txt"
			assert (try fromFilePath("/home/sy/my notes.txt")).str() == "file:///home/sy/my%20notes.txt"
			assert (try fromFilePath("C:\\Users\\sy\\a.txt")).str() == "file:///C:/Users/sy/a.txt"
			let failed = false
			let noFile = try parse("http://x/a")
			noFile.filePath() onerror (err error) {
				failed = true
				recover ""
			}
			assert failed
			return none
		}

		@test()
		def escapes() !none {
			assert pathEscape("a/b c") == "a%2Fb%20c"
			assert queryEscape("a b&c=d") == "a+b%26c%3Dd"
			assert (try pathUnescape("a%2Fb%20c")) == "a/b c"
			assert (try queryUnescape("a+b%26c")) == "a b&c"
			assert escape("a/b c", "/") == "a/b%20c"
			assert escape("a/b c") == "a%2Fb%20c"
			assert (try unescape("a%2Fb%20c")) == "a/b c"
			assert escape("é") == "%C3%A9"
			assert (try unescape("%C3%A9")) == "é"
			let failed = false
			unescape("%zz") onerror (err error) {
				if err is UrlError {
					failed = err.op == "unescape"
				}
				recover ""
			}
			assert failed
			return none
		}

		@test()
		def heuristicsAndJson() !none {
			assert (try heuristicParse("example.com/docs")).str() == "http://example.com/docs"
			assert (try heuristicParse("https://x/y")).str() == "https://x/y"
			let u = try parse("http://x/a?b=1")
			assert string(u.json()) == "\"http://x/a?b=1\""
			let back = new URL()
			try back.json("\"http://y/z#f\"".bytes())
			assert back.str() == "http://y/z#f"
			assert back.fragment == "f"
			return none
		}

		@test()
		def queryValues() !none {
			let u = try parse("http://x/p?q=adm+lang&tag=a&tag=b&bad=%zz&ok=1")
			let v = u.query()
			assert orEmpty(v.get("q")) == "adm lang"
			assert v.all("tag").equals(["a", "b"])
			assert !v.has("bad")
			assert orEmpty(v.get("ok")) == "1"
			let fresh = new Values()
			fresh.add("z", "1")
			fresh.add("a", "x y")
			u.setQuery(fresh)
			assert u.rawQuery == "a=x+y&z=1"
			return none
		}
	}
}
