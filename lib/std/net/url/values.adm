partial module std.net.url {
	// Pair is one key and value of a query or form.
	struct Pair {
		key   string
		value string
	}

	// Values is the parameters of a query string or an urlencoded form: keys
	// in first-seen order, each with the values it appeared with. Keys are
	// case-sensitive, as RFC 3986 leaves them.
	type Values {
		internal order string[]
		internal items map<string, string[]>

		def new() {
			items = map<string, string[]>{}
		}

		// get is the first value of the key, none when the key is absent.
		def get(key string) ?string {
			let list = items.get(key)
			return none when list is none
			return none when list.len() == 0
			return list[0]
		}

		// all is every value of the key in order, empty when absent.
		def all(key string) string[] {
			let list = items.get(key)
			return [] when list is none
			return list.clone()
		}

		// set replaces every value of the key with one.
		def set(key string, value string) {
			order.push(key) unless items.hasKey(key)
			items.set(key, [value])
		}

		// add appends a value to the key, keeping the ones it has.
		def add(key string, value string) {
			let list = items.get(key)
			if list is none {
				order.push(key)
				items.set(key, [value])
				return
			}
			list.push(value)
			items.set(key, list)
		}

		// del removes the key and all its values; an absent key is not an error.
		def del(key string) {
			return unless items.hasKey(key)
			items.delete(key)
			order = order - key
		}

		def has(key string) bool {
			return items.hasKey(key)
		}

		// keys is every key in first-seen order.
		def keys() string[] {
			return order.clone()
		}

		// len is the number of keys.
		def len() int {
			return order.len()
		}

		// pairs is every key and value, one Pair per value: keys in first-seen
		// order, each key's values together in the order they were added. For
		// iterating a form.
		//
		// ```
		// let v = try parseQuery("b=2&a=1&b=3")
		// v.pairs()[1].key == "b" && v.pairs()[1].value == "3"
		// v.pairs()[2].key == "a"
		// ```
		def pairs() Pair[] {
			let out Pair[] = []
			for let key in order {
				for let value in all(key) {
					out.push(Pair{key: key, value: value})
				}
			}
			return out
		}

		// sort orders the keys (and each key's values) so two forms with the
		// same content encode the same, as in signatures and cache keys.
		//
		// ```
		// let v = try parseQuery("b=2&a=1")
		// v.sort()
		// v.keys() == ["a", "b"]
		// ```
		def sort() {
			order.sort(def (a, b string) int {
				return a.compare(b)
			})
			for let key in order {
				let list = all(key)
				list.sort(def (a, b string) int {
					return a.compare(b)
				})
				items.set(key, list)
			}
		}

		// encode renders the values as `a=1&b=2&b=3`: keys sorted, each value
		// query-escaped, spaces as `+`. The form a request body or a query
		// string wants.
		def encode() string {
			let sorted = order.clone()
			sorted.sort(def (a, b string) int {
				return a.compare(b)
			})
			let out = ""
			for let key in sorted {
				let escapedKey = escapeWith(key, Encoding.QueryComponent)
				for let value in all(key) {
					out += "&" when out != ""
					out += escapedKey + "=" + escapeWith(value, Encoding.QueryComponent)
				}
			}
			return out
		}

		def str() string {
			return encode()
		}
	}

	// parseQuery reads `a=1&b=2&b=3` into Values, unescaping keys and values
	// and reading `+` as a space; `maxFields` caps the pairs so a hostile
	// query cannot make a server allocate without bound. Fails with UrlError
	// when an escape is malformed (`%zz`, a lone `%`) or the cap is passed.
	//
	// ```
	// let v = try parseQuery("q=adm+lang&page=2&tag=a&tag=b")
	// v.get("q") == "adm lang"
	// v.all("tag") == ["a", "b"]
	// ```
	def parseQuery(query string, maxFields int = 1000) !Values {
		return parseQueryWith(query, maxFields, true)
	}

	// parseQueryWith reads the pairs; strict fails on the first bad escape,
	// lenient skips that pair. A maxFields of 0 means no cap.
	internal def parseQueryWith(query string, maxFields int, strict bool) !Values {
		let out = new Values()
		let count = 0
		for let pair in query.split("&") {
			continue when pair == ""
			count++
			fail UrlError{message: "too many query parameters (more than {maxFields})", op: "query", text: query} when maxFields > 0 && count > maxFields
			let key = pair
			let value = ""
			let eq = pair.indexOf("=")
			if eq >= 0 {
				key = pair[:eq]
				value = pair[eq + 1:]
			}
			let ok = true
			let decodedKey = unescapeWith(key, Encoding.QueryComponent) onerror (err error) {
				ok = false
				recover ""
			}
			let decodedValue = unescapeWith(value, Encoding.QueryComponent) onerror (err error) {
				ok = false
				recover ""
			}
			if !ok {
				fail UrlError{message: "invalid URL escape in query pair \"{pair}\"", op: "query", text: query} when strict
				continue
			}
			out.add(decodedKey, decodedValue)
		}
		return out
	}
}
