partial module std.net.url {
	use std.testing

	// orEmpty reads an optional lookup as text, "" when absent.
	internal def orEmpty(value ?string) string {
		return "" when value is none
		return value
	}

	check "Values" {
		@test()
		def parsesAndEncodes() !none {
			let v = try parseQuery("q=adm+lang&page=2&tag=a&tag=b")
			assert orEmpty(v.get("q")) == "adm lang"
			assert v.all("tag").equals(["a", "b"])
			assert v.get("missing") is none
			assert v.all("missing").len() == 0
			assert v.keys().equals(["q", "page", "tag"])
			assert v.len() == 3
			assert v.has("page")
			assert v.encode() == "page=2&q=adm+lang&tag=a&tag=b"
			return none
		}

		@test()
		def setAddDelAndPairs() !none {
			let v = try parseQuery("b=2&a=1&b=3")
			assert v.pairs().len() == 3
			assert v.pairs()[1].key == "b" && v.pairs()[1].value == "3"
			assert v.pairs()[2].key == "a" && v.pairs()[2].value == "1"
			v.set("b", "9")
			assert v.all("b").equals(["9"])
			v.add("b", "10")
			assert v.all("b").equals(["9", "10"])
			v.del("a")
			assert !v.has("a")
			assert v.keys().equals(["b"])
			v.del("a")
			v.sort()
			assert v.all("b").equals(["10", "9"])
			return none
		}

		@test()
		def sortsKeys() !none {
			let v = try parseQuery("b=2&a=1")
			v.sort()
			assert v.keys().equals(["a", "b"])
			return none
		}

		@test()
		def rejectsBadEscapesAndTooMany() {
			let failed = false
			parseQuery("a=%zz") onerror (err error) {
				if err is UrlError {
					failed = err.op == "query"
				}
				recover new Values()
			}
			assert failed
			let capped = false
			parseQuery("a=1&b=2&c=3", 2) onerror (err error) {
				capped = err.message.contains("too many")
				recover new Values()
			}
			assert capped
		}
	}
}
