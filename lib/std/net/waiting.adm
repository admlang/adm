// Waiting for a signal with a deadline, for the protocols of std.net. One
// place, because a timed wait cannot be cancelled today (`time.sleepChan`
// starts a task that sleeps its whole duration): when a channel receive
// takes a deadline or a timer can be stopped, only this changes.
internal std.net partial module std.net.waiting {
	use std.time

	// The longest one wait sleeps, in nanoseconds: the task behind it
	// outlives a wait that was signalled early by at most this.
	const waitSlice = 200000000

	// awaitSignal waits until the channel is signalled, the deadline
	// (monotonic nanoseconds, 0 for none) has passed, or 200 ms went by,
	// whichever is first; false when the deadline had passed already. The
	// caller looks at its condition again and calls once more.
	def awaitSignal(on channel<none>, deadline int) bool {
		let left = deadline == 0 ?? (waitSlice, deadline - int(time.monoNs()))
		return false when left <= 0
		let sleep = time.sleepChan(duration(left.min(waitSlice)))
		select {
			case on:
				on.flush()
			case sleep:
		}
		return true
	}

	// Signal wakes whoever waits on it. Any number of tasks may `raise`
	// it and none of them waits: a signal that is up stays up. A raiser
	// sets what the waiter looks at before it raises, and the caller of
	// `wait` looks again when it returns: a raise that lands while a
	// waiter is taking the signal is then not lost.
	type Signal {
		internal on channel<none>

		def new() {
			on = new channel<none>(1)
		}

		def raise() {
			on.offer(none)
		}

		// wait is `awaitSignal` on the signal: until it is raised, the
		// deadline (monotonic nanoseconds, 0 for none) has passed, or
		// 200 ms went by; false when the deadline had passed already.
		def wait(deadline int) bool {
			return awaitSignal(on, deadline)
		}
	}
}
