internal std.net partial module std.net.waiting {
	use (
		std.testing::*
		std.time
	)

	// raising raises a signal `times` times.
	internal async def raising(signal Signal, times int) int {
		for let i = 0; i < times; i++ {
			signal.raise()
		}
		return times
	}

	check "Waiting" {
		// Eight tasks raise one signal at once with nobody waiting on it:
		// none of them is left waiting, and the signal is up afterwards,
		// once.
		@test()
		def raisedByMany() {
			let signal = new Signal()
			let tasks = [raising(signal, 20000), raising(signal, 20000), raising(signal, 20000), raising(signal, 20000), raising(signal, 20000), raising(signal, 20000), raising(signal, 20000), raising(signal, 20000)]
			let raised = 0
			for let task in tasks {
				raised += await task
			}
			assert raised == 160000
			let began = int(time.monoNs())
			assert signal.wait(began + 1000000000) && int(time.monoNs()) - began < 100000000
			// Taken: the next wait runs to its deadline.
			assert signal.wait(int(time.monoNs()) + 20000000) && int(time.monoNs()) - began >= 20000000
		}
	}
}
