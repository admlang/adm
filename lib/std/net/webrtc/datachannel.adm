// Data channels (RFC 8831): messages between the peers of a connection,
// over SCTP streams, opened in-band with DCEP (RFC 8832) or agreed
// beforehand.
partial module std.net.webrtc {
	use std.net.webrtc.peer::(ChannelCore, Channels)

	// DataChannelState is where a data channel stands.
	enum DataChannelState {
		Connecting,
		Open,
		Closing,
		Closed
	}

	// DataChannelOptions says how a channel delivers: in order or not;
	// reliably (the default), or giving a message up after a number of
	// retransmissions or after a time (one of the two at most); its
	// subprotocol; and whether both sides agreed on it beforehand
	// (`negotiated`, with the stream `id` both use) instead of opening it
	// in-band.
	struct DataChannelOptions {
		ordered           bool      = true
		maxRetransmits    ?int      = none
		maxPacketLifeTime ?duration = none
		protocol          string    = ""
		negotiated        bool      = false
		id                ?int      = none
	}

	// DataMessage is one message of a data channel: its bytes, and whether
	// the sender sent it as text (UTF-8).
	struct DataMessage {
		data byte[]
		text bool   = false
	}

	// DataChannel is one data channel of a peer connection.
	type DataChannel {
		label         string
		protocol      string
		options       DataChannelOptions
		internal core ChannelCore
		internal all  Channels

		def new(all Channels, core ChannelCore) {
			self.all = all
			self.core = core
			label = core.label
			protocol = core.options.protocol
			options = core.options
		}

		// id is the SCTP stream the channel uses, -1 while a channel made
		// before the connection has none yet.
		def id() int {
			return all.idOf(core)
		}

		// waitOpen waits until the channel is open: at once for one the
		// peer opened or one made on an established connection. Fails with
		// NetError (TimedOut), WebRtcError when it closed instead.
		def waitOpen(timeout duration = 30s) !none {
			return try all.waitOpen(core, timeout)
		}

		// state is where the channel stands.
		def state() DataChannelState {
			return all.stateOf(core)
		}

		// send sends a text message. Fails with WebRtcError when the
		// channel is not open or the message is longer than the peer
		// takes, as SCTP does otherwise.
		def send(text string) !none {
			return try all.send(core, text.bytes(), true)
		}

		// send sends a binary message. Fails as the text form does.
		def send(data byte[]) !none {
			return try all.send(core, data, false)
		}

		// receive waits for the next message; 0s or less waits without
		// end. Fails with NetError (TimedOut), WebRtcError once the channel
		// is closed and everything sent before was read.
		def receive(timeout duration = 30s) !DataMessage {
			return try all.receive(core, timeout)
		}

		// close closes the channel: what was sent is delivered first, then
		// the peer closes its side (RFC 8831 §6.7). Fails as SCTP does.
		def close() !none {
			return try all.close(core)
		}
	}
}
