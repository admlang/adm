internal std.net.webrtc partial module std.net.webrtc.ice {
	use (
		std.net
		std.net.sdp
		std.net.stun
		std.net.udp
		std.net.webrtc::*
		std.testing::*
		std.time
	)

	// quick is a configuration for the loopback with short timers.
	internal def quick() AgentConfig {
		return AgentConfig{addresses: ["127.0.0.1"], pace: 5ms, rto: 40ms, consentEvery: 50ms, consentTimeout: 400ms, patience: 20ms, gatherTimeout: 1s}
	}

	// signal hands one agent's credentials and candidates to the other,
	// as the signalling channel of an application does.
	internal def signal(from Agent, to Agent, candidates bool = true) !int {
		let (ufrag, pwd) = from.credentials()
		to.setRemote(ufrag, pwd)
		let count = 0
		for {
			let candidate = try from.nextCandidate(5s)
			break when candidate is none
			count++
			try to.addRemote(candidate) when candidates
		}
		to.endOfCandidates() when candidates
		return count
	}

	// connected is two agents with the given configurations, gathered,
	// signalled both ways and connected, the first controlling.
	internal def connected(first AgentConfig, second AgentConfig) !(Agent, Agent) {
		let a = try newAgent(first)
		let b = try newAgent(second)
		try a.gather()
		try b.gather()
		try signal(a, b)
		try signal(b, a)
		a.start(true)
		b.start(false)
		try a.waitConnected(5s)
		try b.waitConnected(5s)
		return (a, b)
	}

	// exchange sends a datagram each way and checks it arrives.
	internal def exchange(a Agent, b Agent) !none {
		let buf byte[]
		buf.len(1500)
		try a.send("to b".bytes(), 1s)
		let n = try b.receive(buf, 2s)
		fail "b received {n} bytes" unless string(buf[0:n]) == "to b"
		try b.send("to a".bytes(), 1s)
		n = try a.receive(buf, 2s)
		fail "a received {n} bytes" unless string(buf[0:n]) == "to a"
		return none
	}

	internal def settled(agent Agent, want IceConnectionState) bool {
		for let i = 0; i < 300 && agent.currentState() != want; i++ {
			time.sleep(10ms)
		}
		return agent.currentState() == want
	}

	// relayServer is a STUN and TURN server on the loopback that knows
	// alice.
	internal def relayServer() !stun.Server {
		let server = new stun.Server("127.0.0.1:0")
		server.realm = "adm.test"
		server.users["alice"] = "secret"
		server.turn = true
		server.allowLocalPeers = true
		server.minPort = 50500
		server.maxPort = 50900
		try server.start()
		return server
	}

	internal async def serve(server stun.Server) {
		server.listenAndServe() onerror recover none
	}

	check "ICE" {
		// Priorities as RFC 8445 §5.1.2.1 and §6.1.2.3 compute them.
		@test()
		def priorities() {
			assert candidatePriority(preferHost, 65535) == 2130706431
			assert candidatePriority(preferRelay, 65535) == 16777215
			assert pairPriority(2130706431, 1694498815) == 1694498815 * (1 << 32) + 2 * 2130706431 + 1
			assert pairPriority(1694498815, 2130706431) == 1694498815 * (1 << 32) + 2 * 2130706431
		}

		// Two agents on the loopback gather host candidates, connect over
		// them with a regular nomination, complete, and carry data; when
		// one closes, the other loses consent and stops sending.
		@test()
		def hostToHost() !none {
			let (a, b) = try connected(quick(), quick())
			try exchange(a, b)
			let pair = a.selectedPair()
			fail "no pair selected" when pair is none
			let (local, remote) = pair
			assert local.kind == sdp.CandidateType.Host && remote.kind == sdp.CandidateType.Host && local.address.host == "127.0.0.1"
			assert a.isControlling() && !b.isControlling()
			assert settled(a, IceConnectionState.Completed) && settled(b, IceConnectionState.Completed)
			assert a.gatheringState() == IceGatheringState.Complete && a.localCandidates().len() == 1
			try a.close()
			assert settled(b, IceConnectionState.Failed)
			let refused = false
			b.send("late".bytes(), 1s) onerror (err error) {
				refused = err is net.NetError
				recover none
			}
			assert refused && a.currentState() == IceConnectionState.Closed
			try b.close()
			return none
		}

		// A connected agent with nothing left to check has nothing due
		// before its next consent request: its timer task sleeps until
		// then.
		@test()
		def quietWhenConnected() !none {
			let calm = quick()
			calm.consentEvery = 5s
			calm.consentTimeout = 30s
			let (a, b) = try connected(calm, calm)
			assert settled(a, IceConnectionState.Completed) && settled(b, IceConnectionState.Completed)
			let now = int(time.monoNs())
			assert a.tick(now) - now > 2000000000 && b.tick(now) - now > 2000000000
			try exchange(a, b)
			try a.close()
			try b.close()
			return none
		}

		// The same over IPv6: host candidates on ::1, written with their
		// brackets, connect and carry data.
		@test()
		def overIPv6() !none {
			let six = quick()
			six.addresses = ["::1"]
			let (a, b) = try connected(six, six)
			try exchange(a, b)
			let pair = a.selectedPair()
			fail "no pair selected" when pair is none
			let (local, remote) = pair
			assert local.address.host == "::1" && remote.address.host == "::1" && sdp.candidateText(local).contains(" ::1 ")
			try a.close()
			try b.close()
			return none
		}

		// With UDP left out, two agents connect over TCP: one's active
		// candidate to the other's passive one, datagrams framed with
		// their length; the candidates are written with their type.
		@test()
		def overTcp() !none {
			let streams = quick()
			streams.tcp = true
			streams.udp = false
			let a = try newAgent(streams)
			let b = try newAgent(streams)
			try a.gather()
			try b.gather()
			let offered = a.localCandidates()
			assert offered.len() == 2 && sdp.candidateText(offered[0]).contains(" tcp ") && sdp.candidateText(offered[0]).contains("tcptype passive") && sdp.candidateText(offered[1]).contains(" 9 typ host tcptype active")
			assert (try signal(a, b)) == 2 && (try signal(b, a)) == 2
			a.start(true)
			b.start(false)
			try a.waitConnected(5s)
			try b.waitConnected(5s)
			try exchange(a, b)
			let pair = a.selectedPair()
			fail "no pair selected" when pair is none
			let (local, remote) = pair
			assert local.transport == sdp.CandidateTransport.TCP && remote.transport == sdp.CandidateTransport.TCP
			let big byte[]
			big.len(1400)
			big[1399] = 9
			try a.send(big, 1s)
			let buf byte[]
			buf.len(1500)
			assert (try b.receive(buf, 2s)) == 1400 && buf[1399] == byte(9)
			try a.close()
			assert settled(b, IceConnectionState.Failed)
			try b.close()
			return none
		}

		// Host candidates written with an mDNS name, on the host's real
		// interfaces: the peer, told nothing else, resolves the names on
		// the link and connects. A host without multicast (no name can be
		// announced) has nothing to check here.
		@test()
		def namedCandidates() !none {
			let hidden = quick()
			hidden.addresses = []
			hidden.mdnsNames = true
			hidden.ipv6 = false
			let a = try newAgent(hidden)
			let open = quick()
			open.addresses = []
			open.ipv6 = false
			let b = try newAgent(open)
			let announced = true
			a.gather() onerror (err error) {
				announced = false
				recover none
			}
			if !announced {
				try a.close()
				try b.close()
				return none
			}
			try b.gather()
			for let candidate in a.localCandidates() {
				assert candidate.address.host.endsWith(".local")
			}
			assert (try signal(a, b)) > 0
			try signal(b, a, false)
			a.start(true)
			b.start(false)
			try a.waitConnected(8s)
			try b.waitConnected(8s)
			try exchange(a, b)
			try a.close()
			try b.close()
			return none
		}

		// A side that was told no candidates learns the peer's from its
		// checks (peer reflexive) and connects.
		@test()
		def peerReflexive() !none {
			let a = try newAgent(quick())
			let b = try newAgent(quick())
			try a.gather()
			try b.gather()
			try signal(a, b, false)
			try signal(b, a)
			a.start(true)
			b.start(false)
			try a.waitConnected(5s)
			try b.waitConnected(5s)
			try exchange(a, b)
			let pair = b.selectedPair()
			fail "no pair selected" when pair is none
			let (_, remote) = pair
			assert remote.kind == sdp.CandidateType.PeerReflexive
			try a.close()
			try b.close()
			return none
		}

		// Both sides start as controlling: the tiebreakers settle it, and
		// they connect with one in each role. The aggressive nomination
		// connects too.
		@test()
		def rolesAndNomination() !none {
			let a = try newAgent(quick())
			let b = try newAgent(quick())
			try a.gather()
			try b.gather()
			try signal(a, b)
			try signal(b, a)
			a.start(true)
			b.start(true)
			try a.waitConnected(5s)
			try b.waitConnected(5s)
			assert a.isControlling() != b.isControlling()
			try exchange(a, b)
			try a.close()
			try b.close()

			let eager = quick()
			eager.nomination = Nomination.Aggressive
			let (c, d) = try connected(eager, quick())
			try exchange(c, d)
			try c.close()
			try d.close()
			return none
		}

		// With a STUN and TURN server: the server-reflexive candidate of a
		// host without a NAT is the host candidate and is left out, the
		// relayed one is offered; two agents that may only use relays
		// connect through the server.
		@test()
		def serversAndRelays() !none {
			let server = try relayServer()
			let serving = serve(server)
			let port = server.address().port
			let open = quick()
			open.servers = [IceServer{urls: ["stun:127.0.0.1:{port}", "turn:127.0.0.1:{port}"], username: "alice", credential: "secret"}]
			let one = try newAgent(open)
			try one.gather()
			let kinds sdp.CandidateType[]
			for {
				let candidate = try one.nextCandidate(5s)
				break when candidate is none
				kinds.push(candidate.kind)
			}
			assert kinds.len() == 2 && kinds.includes(sdp.CandidateType.Host) && kinds.includes(sdp.CandidateType.Relay)
			try one.close()

			let hidden = quick()
			hidden.policy = IceTransportPolicy.Relay
			hidden.servers = [IceServer{urls: ["turn:127.0.0.1:{port}"], username: "alice", credential: "secret"}]
			let (a, b) = try connected(hidden, hidden)
			try exchange(a, b)
			let pair = a.selectedPair()
			fail "no pair selected" when pair is none
			let (local, remote) = pair
			assert local.kind == sdp.CandidateType.Relay && remote.kind == sdp.CandidateType.Relay && a.localCandidates().len() == 1
			try a.close()
			try b.close()
			try server.close()
			await serving
			return none
		}

		// An ICE restart: new credentials, the candidates signalled
		// again, a new pair selected; data flows before and after.
		@test()
		def restart() !none {
			let (a, b) = try connected(quick(), quick())
			try exchange(a, b)
			let (before, _) = a.credentials()
			try a.restart()
			try b.restart()
			let (after, _) = a.credentials()
			assert before != after && a.currentState() == IceConnectionState.New
			// The old pair still carries data while the new one is found.
			try exchange(a, b)
			assert (try signal(a, b)) == 1 && (try signal(b, a)) == 1
			a.start(true)
			b.start(false)
			try a.waitConnected(5s)
			try b.waitConnected(5s)
			try exchange(a, b)
			try a.close()
			try b.close()
			return none
		}

		// A peer whose only candidate answers nothing: the agent fails
		// once its checks ran out.
		@test()
		def nothingAnswers() !none {
			let hasty = quick()
			hasty.requests = 3
			let a = try newAgent(hasty)
			try a.gather()
			for !((try a.nextCandidate(5s)) is none) {}
			a.setRemote("nobody", "nopasswordnopasswordno")
			let address = try net.parseAddress("127.0.0.1:9")
			try a.addRemote(sdp.Candidate{foundation: "1", priority: candidatePriority(preferHost, 65535), address: address})
			a.endOfCandidates()
			a.start(true)
			assert settled(a, IceConnectionState.Failed)
			let failed = false
			a.waitConnected(1s) onerror (err error) {
				failed = err is WebRtcError
				recover none
			}
			assert failed
			try a.close()
			return none
		}

		// Datagrams handed to a function arrive there instead of at
		// `receive`.
		@test()
		def deliveredToAFunction() !none {
			let (a, b) = try connected(quick(), quick())
			let counter = new Counter()
			b.deliverTo(counter.take)
			for let i = 0; i < 20; i++ {
				try a.send(patterned(100 + i), 1s)
			}
			for let i = 0; i < 200 && counter.count() < 20; i++ {
				time.sleep(5ms)
			}
			assert counter.count() == 20 && counter.total() == 20 * 100 + 190
			try a.close()
			try b.close()
			return none
		}

		// 10000 datagrams of 1200 bytes from one agent to another on the
		// loopback, handed to a function on the reading task; beside it
		// the same through `receive`, and over two bare sockets with a
		// reading task.
		@benchmark()
		def BenchAgentDeliver() {
			agentStream(true) onerror recover none
		}

		@benchmark()
		def BenchAgentReceive() {
			agentStream(false) onerror recover none
		}

		@benchmark()
		def BenchSocketStream() {
			socketStream() onerror recover none
		}
	}

	// Counter counts datagrams and their bytes.
	internal type Counter {
		atomic seen  int = 0
		atomic bytes int = 0

		def new() {}

		def take(data byte[]) {
			bump(data.len())
		}

		atomic def bump(size int) {
			seen++
			bytes += size
		}

		atomic def count() int {
			return seen
		}

		atomic def total() int {
			return bytes
		}
	}

	internal def patterned(size int) byte[] {
		let out byte[]
		out.len(size)
		return out
	}

	// paced waits until the receiver is at most 32 datagrams behind.
	internal def paced(counter Counter, sent int) {
		for let spins = 0; counter.count() < sent - 32 && spins < 200000; spins++ {
			time.sleep(20us)
		}
	}

	internal async def drain(agent Agent, counter Counter, want int) {
		let buf byte[]
		buf.len(1500)
		for counter.count() < want {
			let failed = false
			let n = agent.receive(buf, 2s) onerror (err error) {
				failed = true
				recover 0
			}
			break when failed
			counter.bump(n)
		}
	}

	internal def agentStream(direct bool) !none {
		let (a, b) = try connected(quick(), quick())
		let counter = new Counter()
		let reading = async drain(b, counter, direct ?? (0, 10000))
		b.deliverTo(counter.take) when direct
		let data = patterned(1200)
		for let i = 0; i < 10000; i++ {
			try a.send(data, 1s)
			paced(counter, i)
		}
		paced(counter, 10032)
		await reading
		try a.close()
		try b.close()
		return none
	}

	internal async def drainSocket(sock udp.Client, counter Counter, want int) {
		let buf byte[]
		buf.len(1500)
		for counter.count() < want {
			let failed = false
			sock.recvFrom(buf, 2s) onerror (err error) {
				failed = true
				recover (0, new net.Address())
			}
			break when failed
			counter.bump(1200)
		}
	}

	internal def socketStream() !none {
		let a = new udp.Client()
		let b = new udp.Client()
		try a.start()
		try b.start()
		try a.bind("127.0.0.1:0")
		try b.bind("127.0.0.1:0")
		let to = "127.0.0.1:{(try b.localAddr()).port}"
		let counter = new Counter()
		let reading = async drainSocket(b, counter, 10000)
		let data = patterned(1200)
		for let i = 0; i < 10000; i++ {
			try a.sendTo(data, to, 1s)
			paced(counter, i)
		}
		paced(counter, 10032)
		await reading
		try a.close()
		try b.close()
		return none
	}
}
