// The certificate of a peer connection: a self-signed ECDSA P-256
// certificate made for it (RFC 8827 §6.5), and certificate fingerprints as
// SDP carries them (RFC 8122).
internal std.net.webrtc partial module std.net.webrtc.peer {
	use (
		std.crypto::(PrivateKey, generateECDSAKey, publicKeyOf, p256)
		std.crypto.hash::(Hash, digest)
		std.crypto.x509
		std.net.sdp
		std.net.tls
		std.time
	)

	// selfSigned makes a key and a certificate for it, signed with the key
	// itself, good from a day ago for thirty days: an X.509 v3 certificate
	// with the name as common name of issuer and subject and
	// ecdsa-with-SHA256 as signature. Fails when the system gives no
	// random bytes.
	def selfSigned(name string = "WebRTC") !tls.KeyPair {
		let key PrivateKey = try generateECDSAKey(p256)
		let template = x509.Template{notBefore: time.now() - 24h, notAfter: time.now() + 720h}
		template.subject.commonName = name
		let certificate = try x509.createCertificate(template, publicKeyOf(key), none, key)
		return new tls.KeyPair([certificate], key)
	}

	// fingerprintOf is the SHA-256 fingerprint of a certificate in DER.
	def fingerprintOf(certificate byte[]) sdp.Fingerprint {
		return sdp.Fingerprint{algorithm: "sha-256", digest: digest(Hash.SHA256, certificate)}
	}

	// matches reports whether a certificate has one of the fingerprints,
	// under the hash each names (RFC 8122 §5).
	def matches(certificate byte[], fingerprints sdp.Fingerprint[]) bool {
		for let fingerprint in fingerprints {
			let hash = hashNamed(fingerprint.algorithm)
			continue when hash is none
			return true when digest(hash, certificate).equals(fingerprint.digest)
		}
		return false
	}

	internal def hashNamed(name string) ?Hash {
		return Hash.SHA256 when name == "sha-256"
		return Hash.SHA384 when name == "sha-384"
		return Hash.SHA512 when name == "sha-512"
		return Hash.SHA1 when name == "sha-1"
		return none
	}
}
