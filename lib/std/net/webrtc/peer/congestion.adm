// Congestion control of a connection's media (draft-ietf-rmcat-gcc-02)
// over transport-wide feedback
// (draft-holmer-rmcat-transport-wide-cc-extensions-01): the sending side
// numbers every packet, the receiving side reports when each arrived, and
// the sender turns the reports into the bitrate the path carries, from
// how the delay between packet groups grows and from what is lost.
internal std.net.webrtc partial module std.net.webrtc.peer {
	use std.net.rtp

	// The header extension that carries the transport-wide number.
	const transportWideExtension = "http://www.ietf.org/id/draft-holmer-rmcat-transport-wide-cc-extensions-01"

	// Packets the estimator remembers having sent and the arrivals a
	// receiver keeps for its next report (powers of two).
	const sentHistory = 4096
	const arrivalHistory = 4096

	// Packets sent within this many nanoseconds of a group's first are
	// one group (draft §5.2).
	const burstSpan = 5000000

	// Samples the delay trend is fitted over, and what multiplies it
	// before it meets the threshold.
	const trendSamples = 20
	const trendGain = 4.0

	// Probes: a cluster of packets sent at a multiple of the estimate
	// shows in a few packets whether the path carries more (the scheme of
	// libwebrtc's probe controller). A cluster is at least `probePackets`
	// packets of `probeSize` bytes and `probeSpan` long; the first one of
	// a connection asks for `probeFirst` times the estimate, later ones
	// for twice; one that the path carried is followed by the next after
	// `probeSoon`, else the next comes after `probeEvery`. A result
	// counts as bitrate acknowledged for `probeHolds`.
	const probePackets = 5
	const probeSize = 1200
	const probeSpan = 15000000
	const probeFirst = 3
	const probeSoon = 100000000
	const probeEvery = 5000000000
	const probeHolds = 3000000000

	// The span the acknowledged bitrate is measured over.
	const ackedSpan = 250000000

	// Loss that does not come from the rate. A fall of the loss-based rate
	// to `lossTrial` of where it began is a trial. A path that loses a
	// share of its packets at any rate shows two things in it: the share
	// lost during the fall is still much of what it was (`lossStayed` of
	// it at least; loss from a rate a little above what the path carries
	// goes away with the first steps down), and what arrived fell with
	// the rate (below `lossFollowed` of what arrived before; a path that
	// is full by far delivers what it did). With both, the loss is
	// tolerated from then on and the loss-based rate let go. Whatever is tolerated, the rate stays below
	// `lossBalance / (loss - lossOffset)` (the bound libwebrtc's
	// loss-based estimator sets: 2 Mbit/s at 10% lost, 667 kbit/s at 20%).
	// Loss is judged over at least `lossWindow` packets, or the packets
	// of a second when they are 20 or more, and smoothed over about
	// `lossMemory` packets: a few packets say little of a share.
	const lossWindow = 100
	const lossMemory = 200.0
	const lossTrial = 0.7
	const lossFollowed = 0.85
	const lossStayed = 0.5
	const lossBalance = 100000.0
	const lossOffset = 0.05

	// Usage is what the delay trend says of the path (draft §5.4).
	enum Usage {
		Normal,
		Over,
		Under,
	}

	// RateState is the state of the rate controller (draft §5.5).
	enum RateState {
		Hold,
		Increase,
		Decrease,
	}

	// Estimator is the sending side: `sending` numbers a packet, `heard`
	// takes a report of arrivals, `target` is the bitrate media may use.
	type Estimator {
		floor          int
		start          int       = 0
		ceiling        int
		// What was sent, by transport-wide number modulo the history:
		// when, how many bytes, and the whole number (-1 for none).
		sentAt         int[]     = []
		sentSize       int[]     = []
		sentNumber     int[]     = []
		next           int       = 0
		// The reference time of the last report, with its turns counted.
		reference      int       = -1
		// The group of packets being gathered and the one before it:
		// first and last send time, last arrival.
		groupOpen      bool      = false
		groupFirst     int       = 0
		groupSent      int       = 0
		groupArrived   int       = 0
		earlier        bool      = false
		earlierSent    int       = 0
		earlierArrived int       = 0
		// The delay trend: the deltas seen, their sum and its smoothed
		// value, and the last samples (arrival in ms, smoothed delay).
		deltas         int       = 0
		accumulated    float     = 0.0
		smoothed       float     = 0.0
		firstArrival   int       = 0
		xs             float[]   = []
		ys             float[]   = []
		filled         int       = 0
		trend          float     = 0.0
		earlierTrend   float     = 0.0
		// The over-use detector: its threshold in ms, when it last
		// moved, and for how long and how often the trend sat above it.
		threshold      float     = 12.5
		adaptedAt      int       = 0
		overFor        float     = -1.0
		overCount      int       = 0
		usage          Usage     = Usage.Normal
		// The rate controller.
		state          RateState = RateState.Increase
		rate           float
		updatedAt      int       = 0
		ackedRate      float     = 0.0
		ackedFrom      int       = 0
		ackedBytes     int       = 0
		// The mean of the acknowledged rate where the path was last
		// over-used: near it the rate grows by addition.
		knee           float     = 0.0
		// The loss-based rate and what the reports since its last move
		// said.
		lossRate       float
		lossMovedAt    int       = 0
		lostCount      int       = 0
		heardCount     int       = 0
		heardSince     int       = 0
		// The loss of the last reports, smoothed (-1 before any); the
		// share of loss taken to be the path's own; where the rate and
		// what arrived stood when the fall under way began (0 for none).
		lossAverage    float     = -1.0
		tolerated      float     = 0.0
		trialRate      float     = 0.0
		trialAcked     float     = 0.0
		// The share lost when the fall began, and what the reports since
		// then counted.
		trialLoss      float     = 0.0
		trialLost      int       = 0
		trialHeard     int       = 0
		roundTrip      int       = 100000000
		// The probe cluster: its number (0 before the first), the rate it
		// asks for, the bytes it still has to send (0 once it is sent),
		// whether its result is awaited, the last number it sent, and
		// when the next may start. Per packet sent, the cluster it was
		// part of.
		cluster        int       = 0
		clusterRate    int       = 0
		clusterLeft    int       = 0
		clusterOpen    bool      = false
		clusterLast    int       = 0
		probeAt        int       = 0
		sentCluster    int[]     = []
		// What the cluster's packets were on leaving and on arriving:
		// how many, their bytes, the first one's size and the first and
		// last times.
		outCount       int       = 0
		outBytes       int       = 0
		outFirstSize   int       = 0
		outFirst       int       = 0
		outLast        int       = 0
		inCount        int       = 0
		inBytes        int       = 0
		inFirstSize    int       = 0
		inFirst        int       = 0
		inLast         int       = 0
		// The rate the last probe measured and when; when media (not
		// padding) was last sent.
		probedRate     float     = 0.0
		probedAt       int       = 0
		mediaAt        int       = 0
		// The peer reports arrivals: the delay-based rate counts.
		wide           bool      = false
		// What the peer's REMB allows, 0 without one.
		peerLimit      int       = 0

		// An estimator that starts at `start` bits per second and stays
		// between `floor` and `ceiling`.
		def new(start int, floor int, ceiling int) {
			self.floor = floor
			self.ceiling = ceiling
			self.start = start
			rate = float(start)
			lossRate = 1.0e12
			sentAt.len(sentHistory)
			sentSize.len(sentHistory)
			sentNumber.len(sentHistory)
			sentNumber.fill(-1)
			sentCluster.len(sentHistory)
			xs.len(trendSamples)
			ys.len(trendSamples)
		}

		// restart forgets what the estimator learnt of the path, for a
		// path that is a new one (an ICE restart, a new transport): the
		// rate starts over and the first probe asks again. Packet numbers
		// go on.
		atomic def restart() {
			rate = float(start)
			lossRate = 1.0e12
			lossMovedAt = 0
			lostCount = 0
			heardCount = 0
			heardSince = 0
			lossAverage = -1.0
			tolerated = 0.0
			trialRate = 0.0
			trialAcked = 0.0
			sentNumber.fill(-1)
			groupOpen = false
			earlier = false
			deltas = 0
			accumulated = 0.0
			smoothed = 0.0
			filled = 0
			trend = 0.0
			earlierTrend = 0.0
			threshold = 12.5
			adaptedAt = 0
			overFor = -1.0
			overCount = 0
			usage = Usage.Normal
			state = RateState.Increase
			updatedAt = 0
			ackedRate = 0.0
			ackedFrom = 0
			ackedBytes = 0
			knee = 0.0
			cluster = 0
			clusterOpen = false
			clusterLeft = 0
			probeAt = 0
			probedAt = 0
			mediaAt = 0
			reference = -1
		}

		// sending records a packet of `size` bytes leaving at `now` and
		// returns the transport-wide number it carries (16 bits).
		// `padding` says the packet only repeats one for a probe.
		atomic def sending(size int, now int, padding bool = false) int {
			let place = next & (sentHistory - 1)
			sentAt[place] = now
			sentSize[place] = size
			sentNumber[place] = next
			sentCluster[place] = 0
			mediaAt = now unless padding
			if clusterOpen && clusterLeft > 0 {
				// Whatever leaves while a cluster is being sent is part of
				// it: the path carries media and padding alike.
				sentCluster[place] = cluster
				if outCount == 0 {
					outFirst = now
					outFirstSize = size
				}
				outCount++
				outBytes += size
				outLast = now
				clusterLast = next
				clusterLeft -= size
				clusterLeft = 0 when clusterLeft < 0 && outCount >= probePackets
				clusterLeft = 1 when clusterLeft <= 0 && outCount < probePackets
			}
			next++
			return (next - 1) & 0xFFFF
		}

		// probe is the bits per second a probe wants packets to leave at
		// now, 0 when none is being sent. A cluster starts when one is
		// due, media flowed in the last second and the estimate is below
		// its ceiling; the pacing task then sends at that rate, padding
		// what the tracks do not fill.
		atomic def probe(now int) int {
			return 0 unless wide
			if clusterOpen {
				return clusterRate when clusterLeft > 0 && now - outLast < 1000000000
				// A cluster whose report never came is given up.
				return 0 unless now - outLast >= 1000000000
				clusterOpen = false
				probeAt = now + probeEvery
				return 0
			}
			return 0 when now < probeAt || mediaAt == 0 || now - mediaAt > 1000000000 || rate >= float(ceiling) * 0.98
			return 0 when state == RateState.Decrease || usage == Usage.Over
			let wanted = (rate * float(cluster == 0 ?? (probeFirst, 2))).min(float(ceiling) * 1.2)
			cluster++
			clusterRate = int(wanted)
			clusterLeft = (clusterRate * (probeSpan / 1000000) / 8000).max(probePackets * probeSize)
			clusterOpen = true
			outCount = 0
			outBytes = 0
			outLast = now
			inCount = 0
			inBytes = 0
			return clusterRate
		}

		// target is the bitrate media may use now.
		atomic def target() int {
			// Without reports of arrivals only loss and the peer's own
			// limit say anything.
			let allowed = wide ?? (rate.min(lossRate), lossRate)
			allowed = allowed.min(float(peerLimit)) when peerLimit > 0
			return int(allowed).max(floor).min(ceiling)
		}

		// numbered says the peer reports the arrival of numbered packets:
		// the delay-based rate counts from here on.
		atomic def numbered() {
			wide = true
		}

		// bound changes the range the estimate stays in.
		atomic def bound(floor int, ceiling int) {
			self.floor = floor
			self.ceiling = ceiling
		}

		// limit takes what the peer's REMB allows.
		atomic def limit(bitrate int) {
			peerLimit = bitrate
		}

		// timed takes the round-trip time the reception reports measure.
		atomic def timed(roundTrip int) {
			self.roundTrip = roundTrip when roundTrip > 0
		}

		// turn is the round-trip time last measured, 100 ms before any.
		atomic def turn() int {
			return roundTrip
		}

		// lost takes the loss a reception report names (in 1/256) for a
		// peer that sends no transport-wide feedback.
		atomic def lost(fraction int, now int) {
			lostCount += fraction
			heardCount += 256
			moveLoss(now)
		}

		// heard takes a report of arrivals: every packet it names goes
		// through the delay filter, then the rate moves.
		atomic def heard(feedback rtp.TransportFeedback, now int) {
			// The 24-bit reference time, continued past its turns.
			let turned = feedback.referenceTime
			if reference >= 0 {
				let step = (feedback.referenceTime - reference) & 0xFFFFFF
				step -= 0x1000000 when step >= 0x800000
				turned = reference + step
			}
			reference = turned
			// The first number, continued to the whole one nearest below
			// what was sent last.
			let number = feedback.baseSequence + ((next - 1) & ~0xFFFF)
			number -= 0x10000 when number > next - 1
			let arrival = turned * 64000000
			for let delta in feedback.deltas {
				if delta == rtp.notReceived {
					lostCount++ when number >= 0
				} else {
					arrival += delta * 250000
					arrived(number, arrival) when number >= 0
				}
				heardCount++ when number >= 0
				number++
			}
			concludeProbe(now) when clusterOpen && clusterLeft == 0 && number > clusterLast
			moveLoss(now)
			moveRate(now)
		}

		// concludeProbe takes the result of a cluster whose packets were
		// all reported: the rate they arrived at, when at least four did,
		// becomes the estimate if it is above it. A path that delivered
		// them slower than they were sent has shown its capacity.
		internal def concludeProbe(now int) {
			clusterOpen = false
			probeAt = now + probeEvery
			return unless inCount >= 4 && inLast > inFirst && outLast > outFirst
			let arrivedAt = float(inBytes - inFirstSize) * 8.0e9 / float(inLast - inFirst)
			let sentAt = float(outBytes - outFirstSize) * 8.0e9 / float(outLast - outFirst)
			let measured = arrivedAt < 0.9 * sentAt ?? (0.95 * arrivedAt, sentAt.min(arrivedAt))
			// Whatever it measured is what the path was seen to carry.
			probedRate = measured
			probedAt = now
			return unless measured > rate
			rate = measured.min(float(ceiling))
			knee = 0.0
			state = RateState.Increase
			// The path carried it: ask for more soon.
			probeAt = now + probeSoon when arrivedAt >= 0.9 * sentAt
		}

		// arrived takes one packet's arrival: into the acknowledged
		// bitrate and into its group, whose end measures a delay.
		internal def arrived(number int, arrival int) {
			let place = number & (sentHistory - 1)
			return unless sentNumber[place] == number
			let sent = sentAt[place]
			if clusterOpen && sentCluster[place] == cluster {
				if inCount == 0 {
					inFirst = arrival
					inFirstSize = sentSize[place]
				}
				inCount++
				inBytes += sentSize[place]
				inLast = arrival when arrival > inLast || inCount == 1
			}
			ackedFrom = arrival when ackedFrom == 0
			ackedBytes += sentSize[place]
			if arrival - ackedFrom >= ackedSpan {
				ackedRate = float(ackedBytes) * 8.0e9 / float(arrival - ackedFrom)
				ackedFrom = arrival
				ackedBytes = 0
			}
			if !groupOpen {
				groupOpen = true
				groupFirst = sent
				groupSent = sent
				groupArrived = arrival
				return
			}
			// A packet from before the group came late: no group is its.
			return when sent < groupFirst
			if sent - groupFirst <= burstSpan {
				groupSent = sent when sent > groupSent
				groupArrived = arrival when arrival > groupArrived
				return
			}
			measure(groupSent - earlierSent, groupArrived - earlierArrived, groupArrived) when earlier
			earlier = true
			earlierSent = groupSent
			earlierArrived = groupArrived
			groupFirst = sent
			groupSent = sent
			groupArrived = arrival
		}

		// measure takes how much later a group arrived than it was sent,
		// against the group before: the smoothed sum of those delays
		// over arrival time is a line whose slope says whether a queue
		// grows (draft §5.3, as a least-squares fit).
		internal def measure(sentApart int, arrivedApart int, arrival int) {
			let delay = float(arrivedApart - sentApart) / 1.0e6
			firstArrival = arrival when deltas == 0
			deltas++
			accumulated += delay
			smoothed = 0.9 * smoothed + 0.1 * accumulated
			let at = (deltas - 1) % trendSamples
			xs[at] = float(arrival - firstArrival) / 1.0e6
			ys[at] = smoothed
			filled++ when filled < trendSamples
			if filled == trendSamples {
				let meanX = 0.0
				let meanY = 0.0
				for let i = 0; i < trendSamples; i++ {
					meanX += xs[i]
					meanY += ys[i]
				}
				meanX = meanX / float(trendSamples)
				meanY = meanY / float(trendSamples)
				let above = 0.0
				let below = 0.0
				for let i = 0; i < trendSamples; i++ {
					above += (xs[i] - meanX) * (ys[i] - meanY)
					below += (xs[i] - meanX) * (xs[i] - meanX)
				}
				trend = above / below when below > 0.0
			}
			detect(float(sentApart) / 1.0e6, arrival)
		}

		// detect compares the trend with the threshold: over-use is a
		// trend above it for 10 ms over two groups that does not fall,
		// and the threshold follows the trend slowly (draft §5.4).
		internal def detect(sentApartMs float, arrival int) {
			let seen = deltas > 60 ?? (60, deltas)
			let scaled = float(seen) * trend * trendGain
			if scaled > threshold {
				overFor = overFor < 0.0 ?? (sentApartMs / 2.0, overFor + sentApartMs)
				overCount++
				if overFor > 10.0 && overCount > 1 && trend >= earlierTrend {
					overFor = 0.0
					overCount = 0
					usage = Usage.Over
				}
			} else {
				overFor = -1.0
				overCount = 0
				usage = scaled < 0.0 - threshold ?? (Usage.Under, Usage.Normal)
			}
			earlierTrend = trend
			let size = scaled.abs()
			if size - threshold <= 15.0 {
				let since = adaptedAt == 0 ?? (0.0, float(arrival - adaptedAt) / 1.0e6)
				since = 100.0 when since > 100.0
				let gain = size < threshold ?? (0.039, 0.0087)
				threshold += gain * (size - threshold) * since
				threshold = 6.0 when threshold < 6.0
				threshold = 600.0 when threshold > 600.0
			}
			adaptedAt = arrival
		}

		// moveRate turns the usage into a rate (draft §5.5): grow while
		// the path is normal, by a share while far from where it was
		// last over-used and by about a packet per response time near
		// it; fall to 85% of what arrived when it is over-used; hold
		// while it empties.
		internal def moveRate(now int) {
			let since = updatedAt == 0 ?? (0.0, float(now - updatedAt) / 1.0e9)
			since = 1.0 when since > 1.0
			updatedAt = now
			match usage {
				case Usage.Over:
					state = RateState.Decrease
				case Usage.Under:
					state = RateState.Hold
				case Usage.Normal:
					state = RateState.Increase when state == RateState.Hold
			}
			if state == RateState.Increase {
				// Far above the last knee, the path has changed.
				knee = 0.0 when knee > 0.0 && ackedRate > knee * 1.5
				if knee > 0.0 {
					let perFrame = rate / 30.0
					let packets = (perFrame / 9600.0).ceil().max(1.0)
					let response = 0.1 + float(roundTrip) / 1.0e9
					rate += (perFrame / packets / response).max(4000.0) * since
				} else {
					rate += (rate * 0.08).max(1000.0) * since
				}
				// What a probe measured counts as acknowledged while it holds.
				let carried = probedAt > 0 && now - probedAt < probeHolds ?? (ackedRate.max(probedRate), ackedRate)
				rate = rate.min(1.5 * carried + 10000.0) when carried > 0.0
			} else if state == RateState.Decrease {
				let seen = probedAt > 0 && now - probedAt < probeHolds ?? (ackedRate.max(probedRate), ackedRate)
				let fallen = 0.85 * (seen > 0.0 ?? (seen, rate))
				rate = fallen when fallen < rate
				knee = knee == 0.0 ?? (ackedRate, 0.95 * knee + 0.05 * ackedRate) when ackedRate > 0.0
				probeAt = now + probeEvery
				state = RateState.Hold
				// The verdict is spent: the next groups give a new one.
				usage = Usage.Normal
			}
			rate = float(floor) when rate < float(floor)
			rate = float(ceiling) when rate > float(ceiling)
		}

		// moveLoss turns the loss the reports name into a rate (draft
		// §6): above a tenth lost it falls by half the loss, below a
		// fiftieth it grows, in between it stays. The loss counted is
		// the smoothed share that exceeds the path's own: a fall that
		// takes what arrives down with it shows loss the rate does not
		// cause, which is tolerated from then on and the rate put back.
		internal def moveLoss(now int) {
			heardSince = now when heardSince == 0
			return when heardCount < 20 || (heardCount < lossWindow && now - heardSince < 1000000000)
			let fraction = float(lostCount) / float(heardCount)
			let weight = float(heardCount) / (float(heardCount) + lossMemory)
			if trialRate > 0.0 {
				trialLost += lostCount
				trialHeard += heardCount
			}
			let since = lossMovedAt == 0 ?? (0.0, float(now - lossMovedAt) / 1.0e9)
			since = 1.0 when since > 1.0
			lostCount = 0
			heardCount = 0
			heardSince = now
			lossAverage = lossAverage < 0.0 ?? (fraction, lossAverage + weight * (fraction - lossAverage))
			// Less loss than was tolerated: the path's own share shrank.
			tolerated += 0.1 * (lossAverage - tolerated) when lossAverage < tolerated
			let excess = lossAverage - tolerated
			if excess > 0.1 {
				// One fall per round trip: the loss of the packets
				// already under way is the same event.
				return when lossMovedAt != 0 && now - lossMovedAt < 300000000 + roundTrip
				let from = lossRate.min(wide ?? (rate, float(ceiling)))
				if trialRate == 0.0 {
					trialRate = from
					trialAcked = ackedRate
					// The lower of the two: loss of before (a path that was
					// full) still sits in the smoothed share.
					trialLoss = lossAverage.min(fraction)
					trialLost = 0
					trialHeard = 0
				}
				lossRate = from * (1.0 - 0.5 * excess)
				if lossRate <= lossTrial * trialRate {
					let during = trialHeard > 0 ?? (float(trialLost) / float(trialHeard), fraction)
					let followed = trialAcked > 0.0 && ackedRate > 0.0 && ackedRate < lossFollowed * trialAcked
					if followed && during >= lossStayed * trialLoss {
						tolerated = lossAverage
						// Loss says nothing of the rate any more: the delay
						// has the say again, below the bound.
						lossRate = 1.0e12
					}
					// Judged either way: a further fall is a new trial.
					trialRate = 0.0
				}
			} else if excess < 0.02 {
				lossRate += (lossRate * 0.08).max(1000.0) * since
				trialRate = 0.0
			}
			lossRate = lossRate.min(lossBalance / (lossAverage - lossOffset)) when lossAverage > lossOffset
			lossMovedAt = now
			lossRate = float(floor) when lossRate < float(floor)
			lossRate = float(ceiling) when lossRate > float(ceiling)
		}
	}

	// Arrivals is the receiving side: `note` takes the transport-wide
	// number of each packet as it arrives, `report` writes the feedback
	// for what came since the last one.
	type Arrivals {
		// Arrival times by whole number modulo the history, 0 for a
		// packet not seen.
		at      int[] = []
		number  int[] = []
		// The newest whole number seen and the first one the next
		// report covers (-1 before any packet).
		newest  int   = -1
		from    int   = -1
		reports int   = 0

		def new() {
			at.len(arrivalHistory)
			number.len(arrivalHistory)
			number.fill(-1)
		}

		// note records the packet numbered `short` (16 bits) arriving at
		// `now`.
		atomic def note(short int, now int) {
			let whole = short
			if newest >= 0 {
				let step = (short - newest) & 0xFFFF
				step -= 0x10000 when step >= 0x8000
				whole = newest + step
			}
			return when whole < 0 || (newest >= 0 && whole <= newest - arrivalHistory)
			let place = whole & (arrivalHistory - 1)
			at[place] = now
			number[place] = whole
			newest = whole when whole > newest
			from = whole when from < 0 || whole < from
		}

		// pending says whether a report has anything to say.
		atomic def pending() bool {
			return from >= 0 && from <= newest
		}

		// report is the feedback for the packets from the first not yet
		// reported to the newest, none when nothing came. A report ends
		// before a packet whose delta does not fit its 16 bits; the next
		// one starts there.
		atomic def report(sender int, media int) ?rtp.TransportFeedback {
			return none unless from >= 0 && from <= newest
			from = newest - arrivalHistory + 1 when from < newest - arrivalHistory + 1
			// A report starts at the first number not reported yet, lost
			// or not, and takes its time from the first that arrived.
			let seen = from
			for seen <= newest && number[seen & (arrivalHistory - 1)] != seen {
				seen++
			}
			return none when seen > newest
			let first = at[seen & (arrivalHistory - 1)]
			let feedback = rtp.TransportFeedback{sender: sender, media: media, baseSequence: from & 0xFFFF, referenceTime: (first / 64000000) & 0xFFFFFF, feedbackCount: reports & 0xFF}
			reports++
			let last = (first / 64000000) * 64000000
			let missing = 0
			for from <= newest {
				let place = from & (arrivalHistory - 1)
				if number[place] != from {
					missing++
					from++
					continue
				}
				let delta = (at[place] - last) / 250000
				break when delta < -32768 || delta > 32767 || feedback.deltas.len() + missing >= 0xFFFF
				for missing > 0 {
					feedback.deltas.push(rtp.notReceived)
					missing--
				}
				feedback.deltas.push(delta)
				last += delta * 250000
				from++
			}
			// Trailing gaps wait for the report that knows more.
			from -= missing
			return feedback
		}
	}
}
