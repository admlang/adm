internal std.net.webrtc partial module std.net.webrtc.peer {
	use (
		std.net.rtp
		std.testing::*
	)

	// Bottleneck is a path in virtual time: packets leave one after the
	// other at `capacity` bits per second behind a queue that drops what
	// would wait longer than `patience`, and every `dropEvery`th packet is
	// lost besides (0 for none), as are `lossPerMille` in a thousand at
	// random (the same ones every run).
	internal type Bottleneck {
		capacity     int
		patience     int   = 300000000
		dropEvery    int   = 0
		lossPerMille int   = 0
		chance       int   = 12345
		free         int   = 0
		count        int   = 0
		dropped      int   = 0
		// Packets under way: their numbers and when each arrives, in the
		// order sent (the path keeps order), and the first not arrived yet.
		underWay     int[] = []
		arriving     int[] = []
		head         int   = 0

		def new(capacity int) {
			self.capacity = capacity
		}

		// through is when a packet of `size` bytes sent at `now` arrives,
		// -1 when the path loses it.
		def through(size int, now int) int {
			count++
			return -1 when dropEvery > 0 && count % dropEvery == 0
			chance = (chance * 1103515245 + 12345) & 0x7FFFFFFF
			return -1 when lossPerMille > 0 && (chance >> 8) % 1000 < lossPerMille
			let start = free > now ?? (free, now)
			if start - now > patience {
				dropped++
				return -1
			}
			free = start + size * 8 * 1000000000 / capacity
			return free + 20000000
		}
	}

	// drive sends 1200-byte packets at the estimator's target through the
	// path for `span` of virtual time from `from`, reporting arrivals every
	// 100 ms through the wire form, and returns the time it ended at.
	internal def drive(estimator Estimator, path Bottleneck, arrivals Arrivals, from int, span int) !int {
		let now = from
		let reportAt = from + 100000000
		for now < from + span {
			let number = estimator.sending(1200, now)
			let arrives = path.through(1200, now)
			if arrives >= 0 {
				path.underWay.push(number)
				path.arriving.push(arrives)
			}
			// A probe sets the pace while it lasts, as in the pacing task.
			let probing = estimator.probe(now)
			now += 1200 * 8 * 1000000000 / (probing > 0 ?? (probing, estimator.target()))
			for path.head < path.arriving.len() && path.arriving[path.head] <= now {
				arrivals.note(path.underWay[path.head], path.arriving[path.head])
				path.head++
			}
			if now >= reportAt {
				reportAt += 100000000
				let feedback = arrivals.report(1, 2)
				if !(feedback is none) {
					let compound = new rtp.Compound()
					compound.transportFeedback.push(feedback)
					let read = try rtp.parseRtcp(compound.encode())
					estimator.heard(read.transportFeedback[0], now)
				}
			}
		}
		return now
	}

	check "Congestion control" {
		@test()
		def findsWhatThePathCarries() !none {
			let estimator = new Estimator(300000, 30000, 5000000)
			estimator.numbered()
			let path = new Bottleneck(1000000)
			let arrivals = new Arrivals()
			let now = try drive(estimator, path, arrivals, 1000000000, 30000000000)
			let found = estimator.target()
			fail "found {found}" unless found > 600000 && found < 1300000

			// The path narrows: the estimate follows it down.
			path.capacity = 400000
			now = try drive(estimator, path, arrivals, now, 10000000000)
			let narrowed = estimator.target()
			assert narrowed < 520000 && narrowed > 150000

			// And up again when it widens.
			path.capacity = 2000000
			now = try drive(estimator, path, arrivals, now, 40000000000)
			assert estimator.target() > 1000000
			return none
		}

		@test()
		def lossLowersTheRate() !none {
			let estimator = new Estimator(1000000, 30000, 5000000)
			estimator.numbered()
			let path = new Bottleneck(50000000)
			path.dropEvery = 5
			let arrivals = new Arrivals()
			let now = try drive(estimator, path, arrivals, 1000000000, 10000000000)
			// A fifth lost: 100 kbit/s / (0.2 - 0.05) at most.
			assert estimator.target() < 700000

			// A little loss changes nothing: the rate grows again.
			let low = estimator.target()
			path.dropEvery = 100
			now = try drive(estimator, path, arrivals, now, 20000000000)
			assert estimator.target() > low
			return none
		}

		@test()
		def staysInItsRange() !none {
			let estimator = new Estimator(300000, 100000, 800000)
			estimator.numbered()
			let wide = new Bottleneck(50000000)
			let arrivals = new Arrivals()
			let now = try drive(estimator, wide, arrivals, 1000000000, 40000000000)
			fail "wide {estimator.target()}" unless estimator.target() == 800000
			estimator.limit(250000)
			assert estimator.target() == 250000
			estimator.limit(0)
			let narrow = new Bottleneck(20000)
			now = try drive(estimator, narrow, arrivals, now, 20000000000)
			assert estimator.target() == 100000
			// A new path: the estimate starts over.
			estimator.restart()
			assert estimator.target() == 300000
			return none
		}

		@test()
		def reportsNameWhatArrived() !none {
			let arrivals = new Arrivals()
			assert !arrivals.pending()
			// Numbers across the 16-bit turn, one lost, one out of order.
			let base = 5000000000
			arrivals.note(65534, base)
			arrivals.note(65535, base + 3000000)
			arrivals.note(1, base + 9000000)
			arrivals.note(0, base + 10000000)
			arrivals.note(3, base + 12000000)
			assert arrivals.pending()
			let feedback = arrivals.report(7, 9)
			fail "no report" when feedback is none
			assert feedback.baseSequence == 65534
			assert feedback.sender == 7 && feedback.media == 9
			assert feedback.deltas.len() == 6
			let reference = feedback.referenceTime * 64000000
			let times int[]
			let at = reference
			for let delta in feedback.deltas {
				if delta == rtp.notReceived {
					times.push(-1)
					continue
				}
				at += delta * 250000
				times.push(at)
			}
			assert times.equals([base, base + 3000000, base + 10000000, base + 9000000, -1, base + 12000000])
			assert !arrivals.pending()
			assert arrivals.report(7, 9) is none

			// A gap of more than a delta holds starts the next report.
			arrivals.note(4, base + 13000000)
			arrivals.note(5, base + 13000000 + 9000000000)
			let first = arrivals.report(7, 9)
			fail "no report" when first is none
			assert first.deltas.len() == 1 && first.baseSequence == 4
			let second = arrivals.report(7, 9)
			fail "no second report" when second is none
			assert second.deltas.len() == 1 && second.baseSequence == 5
			assert second.feedbackCount == 2
			return none
		}

		// Packets lost before the first one a report can time are named
		// in it: the report starts at the first number not reported yet.
		@test()
		def reportsLossAtItsStart() !none {
			let arrivals = new Arrivals()
			let base = 5000000000
			arrivals.note(10, base)
			arrivals.note(11, base + 1000000)
			let first = arrivals.report(7, 9)
			fail "no report" when first is none
			assert first.baseSequence == 10 && first.deltas.len() == 2
			arrivals.note(14, base + 5000000)
			let second = arrivals.report(7, 9)
			fail "no second report" when second is none
			assert second.baseSequence == 12 && second.deltas.len() == 3
			assert second.deltas[0] == rtp.notReceived && second.deltas[1] == rtp.notReceived && second.deltas[2] != rtp.notReceived
			assert second.referenceTime * 64000000 + second.deltas[2] * 250000 == base + 5000000
			// An estimator counts them as lost.
			let estimator = new Estimator(300000, 30000, 2000000)
			for let i = 0; i < 15; i++ {
				estimator.sending(1200, base)
			}
			estimator.heard(rtp.TransportFeedback{sender: 7, media: 9, baseSequence: 0, referenceTime: 78, feedbackCount: 0, deltas: [rtp.notReceived, rtp.notReceived, 4, 4]}, base)
			assert estimator.lostCount == 2 && estimator.heardCount == 4
			return none
		}

		// Loss the path has at any rate is not congestion: with one packet
		// in twenty or one in ten lost at random on a wide path, the rate
		// comes up in the first seconds (with a tenth lost it falls once,
		// to find that the loss stays) and then stays near its ceiling. Loss
		// from a path that drops what exceeds its capacity without
		// delaying anything takes the rate down to that capacity.
		@test()
		def tellsItsOwnLossFromCongestion() !none {
			for let perMille in [50, 100] {
				let estimator = new Estimator(300000, 30000, 1500000)
				estimator.numbered()
				let path = new Bottleneck(50000000)
				path.lossPerMille = perMille
				let arrivals = new Arrivals()
				let now = 1000000000
				let sum = 0
				let least = 1500000
				for let second = 0; second < 40; second++ {
					now = try drive(estimator, path, arrivals, now, 1000000000)
					fail "{perMille} lost in a thousand: {estimator.target()} after 3 s" when second == 2 && estimator.target() < (perMille == 50 ?? (900000, 500000))
					if second >= 10 {
						sum += estimator.target()
						least = least.min(estimator.target())
					}
				}
				fail "{perMille} lost in a thousand: mean {sum / 30}, least {least}" unless sum / 30 > 1300000 && least > 900000
			}
			let estimator = new Estimator(300000, 30000, 5000000)
			estimator.numbered()
			let policed = new Bottleneck(1000000)
			policed.patience = 0
			let arrivals = new Arrivals()
			let now = 1000000000
			let sum = 0
			for let second = 0; second < 40; second++ {
				now = try drive(estimator, policed, arrivals, now, 1000000000)
				sum += estimator.target() when second >= 10
			}
			fail "policed at 1 Mbit/s: mean {sum / 30}" unless sum / 30 > 600000 && sum / 30 < 1200000

			// A rate a little above what a policed path carries: the loss
			// is gone with the first steps down and none of it is taken
			// for the path's own; the path is not oversent afterwards.
			let near = new Estimator(1150000, 30000, 5000000)
			near.numbered()
			let tight = new Bottleneck(1000000)
			tight.patience = 0
			let reports = new Arrivals()
			now = try drive(near, tight, reports, 1000000000, 20000000000)
			let sentBefore = tight.count
			let droppedBefore = tight.dropped
			now = try drive(near, tight, reports, now, 40000000000)
			let share = (tight.dropped - droppedBefore) * 1000 / (tight.count - sentBefore)
			fail "a little above a policed path: tolerated {near.tolerated}, {share} lost in a thousand, target {near.target()}" unless near.tolerated < 0.03 && share < 120 && near.target() > 600000 && near.target() < 1250000

			// From a low rate, where a report names few packets: a narrow
			// path takes the rate down, then the path is wide and loses a
			// tenth at random.
			let slow = new Estimator(300000, 30000, 1500000)
			slow.numbered()
			let path = new Bottleneck(150000)
			let seen = new Arrivals()
			now = try drive(slow, path, seen, 1000000000, 15000000000)
			fail "narrow: {slow.target()}" unless slow.target() < 220000
			path.capacity = 50000000
			path.lossPerMille = 100
			let low = 1500000
			for let second = 0; second < 60; second++ {
				now = try drive(slow, path, seen, now, 1000000000)
				low = low.min(slow.target())
				fail "wide and lossy from a low rate: {slow.target()} after {second + 1} s" when second == 29 && slow.target() < 900000
			}
			fail "wide and lossy from a low rate: fell to {low}, ends at {slow.target()}" unless low > 80000 && slow.target() > 1000000
			return none
		}

		// How fast the estimate follows the path: the first probe takes it
		// from 300 kbit/s to most of a 1 Mbit/s path's capacity in its
		// first second, where it stays between 60% and 110%; two seconds
		// after the path narrows to 400 kbit/s it is below 450; six
		// seconds after the path widens to 2 Mbit/s a probe has found
		// more than 1.2 Mbit/s; a path of 2 Mbit/s that loses one packet
		// in a hundred is used as one that loses none.
		@test()
		def followsThePathSecondBySecond() !none {
			let estimator = new Estimator(300000, 30000, 5000000)
			estimator.numbered()
			let path = new Bottleneck(1000000)
			let arrivals = new Arrivals()
			let now = 1000000000
			for let second = 0; second < 25; second++ {
				now = try drive(estimator, path, arrivals, now, 1000000000)
				let target = estimator.target()
				assert target >= 600000 && target <= 1100000
			}
			path.capacity = 400000
			for let second = 0; second < 15; second++ {
				now = try drive(estimator, path, arrivals, now, 1000000000)
				assert estimator.target() < 450000 && estimator.target() > 250000 when second >= 2
			}
			path.capacity = 2000000
			for let second = 0; second < 15; second++ {
				now = try drive(estimator, path, arrivals, now, 1000000000)
				assert estimator.target() > 1200000 && estimator.target() < 2200000 when second >= 6
			}

			let lossy = new Estimator(300000, 30000, 5000000)
			lossy.numbered()
			let thin = new Bottleneck(2000000)
			thin.dropEvery = 100
			let seen = new Arrivals()
			let sum = 0
			now = 1000000000
			for let second = 0; second < 60; second++ {
				now = try drive(lossy, thin, seen, now, 1000000000)
				sum += lossy.target() when second >= 30
				assert lossy.target() < 2200000
			}
			assert sum / 30 > 1500000
			return none
		}

		@benchmark()
		def BenchFeedback() !none {
			let estimator = new Estimator(2000000, 30000, 5000000)
			estimator.numbered()
			let path = new Bottleneck(3000000)
			let arrivals = new Arrivals()
			try drive(estimator, path, arrivals, 1000000000, 60000000000)
			return none
		}
	}
}
