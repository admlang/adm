// The offer/answer exchange of a peer connection (JSEP, RFC 9429): its
// state machine and the descriptions it writes.
internal std.net.webrtc partial module std.net.webrtc.peer {
	use (
		std.net.rtp
		std.net.sdp
		std.net.webrtc::*
	)

	// The SCTP port data channels use on both sides (RFC 8841 §5.2 leaves
	// the choice; browsers use 5000) and the largest message this side
	// takes.
	const sctpPort = 5000
	const maxMessage = 262144
	// The header extension that names a packet's media section (RFC 9143
	// §15.1), and the number this side offers it under.
	const midExtension = "urn:ietf:params:rtp-hdrext:sdes:mid"
	const midNumber = 1
	const wideNumber = 2
	// The header extensions that name the simulcast layer a packet belongs
	// to and the one a retransmission repairs (RFC 8852), and the numbers
	// this side offers them under.
	const ridExtension = "urn:ietf:params:rtp-hdrext:sdes:rtp-stream-id"
	const repairedExtension = "urn:ietf:params:rtp-hdrext:sdes:repaired-rtp-stream-id"
	const ridNumber = 3
	const repairedNumber = 4
	// FlexFEC as browsers name it in "a=rtpmap", and the payload type
	// this side offers it under.
	const fecEncoding = "flexfec-03"
	const fecNumber = 118
	// ULPFEC inside the stream (RFC 5109) as descriptions name it: the
	// payload types this side offers for redundant data (RFC 2198), its
	// retransmissions and the repair blocks.
	const redEncoding = "red"
	const ulpEncoding = "ulpfec"
	const redNumber = 100
	const redRtxNumber = 101
	const ulpNumber = 102
	// Redundant sound (RFC 2198: a packet carries the one before it
	// again): the payload type this side offers it under.
	const soundRedNumber = 63

	// nextSignaling is the state after a description of a kind was set,
	// by this side (`local`) or from the peer (RFC 9429 §3.2). Fails with
	// WebRtcError (code "webrtc.invalid-state") for a description that
	// cannot be set in the state.
	def nextSignaling(state SignalingState, local bool, kind SdpType) !SignalingState {
		switch {
			case state == SignalingState.Stable && kind == SdpType.Offer:
				return local ?? (SignalingState.HaveLocalOffer, SignalingState.HaveRemoteOffer)
			case state == SignalingState.HaveLocalOffer && local && kind == SdpType.Offer:
				return SignalingState.HaveLocalOffer
			case state == SignalingState.HaveLocalOffer && local && kind == SdpType.Rollback:
				return SignalingState.Stable
			case state == SignalingState.HaveLocalOffer && !local && kind == SdpType.Answer:
				return SignalingState.Stable
			case state == SignalingState.HaveLocalOffer && !local && kind == SdpType.PrAnswer:
				return SignalingState.HaveRemotePrAnswer
			case state == SignalingState.HaveRemoteOffer && !local && kind == SdpType.Offer:
				return SignalingState.HaveRemoteOffer
			case state == SignalingState.HaveRemoteOffer && !local && kind == SdpType.Rollback:
				return SignalingState.Stable
			case state == SignalingState.HaveRemoteOffer && local && kind == SdpType.Answer:
				return SignalingState.Stable
			case state == SignalingState.HaveRemoteOffer && local && kind == SdpType.PrAnswer:
				return SignalingState.HaveLocalPrAnswer
			case state == SignalingState.HaveLocalPrAnswer && local && kind == SdpType.PrAnswer:
				return SignalingState.HaveLocalPrAnswer
			case state == SignalingState.HaveLocalPrAnswer && local && kind == SdpType.Answer:
				return SignalingState.Stable
			case state == SignalingState.HaveRemotePrAnswer && !local && kind == SdpType.PrAnswer:
				return SignalingState.HaveRemotePrAnswer
			case state == SignalingState.HaveRemotePrAnswer && !local && kind == SdpType.Answer:
				return SignalingState.Stable
		}
		fail WebRtcError{message: "webrtc: a {local ?? ("local", "remote")} {kind} cannot be set in the state {state}", code: "webrtc.invalid-state"}
	}

	// LocalTransport is what this side's description says of its
	// transport: the ICE credentials, the certificate's fingerprint, the
	// DTLS role offered or taken, the candidates gathered so far and
	// whether they are all.
	struct LocalTransport {
		ufrag       string
		password    string
		fingerprint sdp.Fingerprint
		setup       sdp.Setup
		candidates  sdp.Candidate[] = []
		complete    bool            = false
	}

	// sessionFor is a description of the sections, bundled on one
	// transport (RFC 9143).
	def sessionFor(sessionID string, version int, sections sdp.MediaDescription[]) sdp.SessionDescription {
		let out = new sdp.SessionDescription()
		out.origin = sdp.Origin{sessionID: sessionID, sessionVersion: "{version}", address: "127.0.0.1"}
		out.timings = [sdp.Timing{}]
		let mids string[]
		for let section in sections {
			mids.push(section.mid()) unless section.port == 0
		}
		out.add(sdp.Group{semantics: "BUNDLE", mids: mids}) when mids.len() > 0
		out.add("msid-semantic", " WMS")
		out.media = sections
		return out
	}

	// transportInto writes this side's transport into a media section.
	def transportInto(section sdp.MediaDescription, local LocalTransport) {
		section.connections = [sdp.Connection{}]
		section.add("ice-ufrag", local.ufrag)
		section.add("ice-pwd", local.password)
		section.add("ice-options", "trickle")
		section.add(local.fingerprint)
		section.set(local.setup)
		for let candidate in local.candidates {
			section.add(candidate)
		}
		section.add("end-of-candidates") when local.complete
	}

	// dataSection is the media section of the data channels (RFC 8841).
	def dataSection(mid string, local LocalTransport) sdp.MediaDescription {
		let section = new sdp.MediaDescription("application", "UDP/DTLS/SCTP")
		section.formats = ["webrtc-datachannel"]
		transportInto(section, local)
		section.add("mid", mid)
		section.add("sctp-port", "{sctpPort}")
		section.add("max-message-size", "{maxMessage}")
		return section
	}

	// rejected is the answer to a media section this side does not take:
	// the same media and formats on port 0 (RFC 3264 §6).
	def rejected(offered sdp.MediaDescription) sdp.MediaDescription {
		let section = new sdp.MediaDescription(offered.media, offered.protocol)
		section.port = 0
		section.formats = offered.formats
		section.connections = [sdp.Connection{}]
		section.add("mid", offered.mid()) unless offered.mid() == ""
		return section
	}

	// encodingOf is the name a format has in "a=rtpmap".
	def encodingOf(format rtp.PayloadFormat) string {
		switch {
			case format == rtp.PayloadFormat.Opus:
				return "opus"
			case format == rtp.PayloadFormat.VP8:
				return "VP8"
			case format == rtp.PayloadFormat.VP9:
				return "VP9"
			case format == rtp.PayloadFormat.H264:
				return "H264"
		}
		return "AV1"
	}

	// formatNamed is the format with an "a=rtpmap" name, none for the
	// names this side has no payload format for (rtx, red, ulpfec and
	// other codecs).
	def formatNamed(name string) ?rtp.PayloadFormat {
		let known = name.upper()
		return rtp.PayloadFormat.Opus when known == "OPUS"
		return rtp.PayloadFormat.VP8 when known == "VP8"
		return rtp.PayloadFormat.VP9 when known == "VP9"
		return rtp.PayloadFormat.H264 when known == "H264"
		return rtp.PayloadFormat.AV1 when known == "AV1"
		return none
	}

	// payloadTypeOf is the payload type this side offers a format under
	// (the dynamic numbers browsers use for them).
	def payloadTypeOf(format rtp.PayloadFormat) int {
		switch {
			case format == rtp.PayloadFormat.Opus:
				return 111
			case format == rtp.PayloadFormat.VP8:
				return 96
			case format == rtp.PayloadFormat.VP9:
				return 98
			case format == rtp.PayloadFormat.H264:
				// Not 102, which is the repair blocks' (`ulpNumber`).
				return 106
		}
		return 45
	}

	// parametersOf is the "a=fmtp" parameters this side offers a format
	// with, "" for none: Opus with in-band FEC, H.264 constrained
	// baseline in packetization mode 1, VP9 profile 0.
	def parametersOf(format rtp.PayloadFormat) string {
		return "minptime=10;useinbandfec=1" when format == rtp.PayloadFormat.Opus
		return "level-asymmetry-allowed=1;packetization-mode=1;profile-level-id=42e01f" when format == rtp.PayloadFormat.H264
		return "profile-id=0" when format == rtp.PayloadFormat.VP9
		return ""
	}

	// MediaPlan is one media section of this side: its mid, the format
	// and payload type, the direction, the local track that sends on it
	// (its place among the connection's tracks, -1 for none) with its
	// source and track identifier.
	struct MediaPlan {
		mid          string
		format       rtp.PayloadFormat
		payloadType  int
		direction    sdp.Direction     = sdp.Direction.SendRecv
		track        int               = -1
		ssrc         int               = 0
		trackID      string            = ""
		// The number of the MID header extension, 0 without it.
		midID        int               = 0
		// The number of the transport-wide header extension (congestion
		// control), 0 without it.
		wideID       int               = 0
		// Simulcast (RFC 8853): the names of the section's layers, best
		// first, empty for a section with one stream; whether this side
		// receives them (else it sends them); the numbers of the two
		// header extensions that name a packet's layer.
		rids         string[]          = []
		ridsReceived bool              = false
		ridID        int               = 0
		repairedID   int               = 0
		// The payload type and source of retransmissions (RFC 4588), 0
		// without them.
		rtxType      int               = 0
		rtxSsrc      int               = 0
		// The payload type and source of FlexFEC repair packets (RFC 8627),
		// 0 without them.
		fecType      int               = 0
		fecSsrc      int               = 0
		// The payload types of redundant data, of its retransmissions
		// and of ULPFEC repair blocks, 0 without them.
		redType      int               = 0
		redRtxType   int               = 0
		ulpType      int               = 0
	}

	// mediaSection is the media section of a plan (RFC 8829 §5.2.1):
	// one format, RTCP on the RTP port, NACK, PLI, FIR and REMB feedback
	// for video, and the source of the track that sends.
	def mediaSection(plan MediaPlan, local LocalTransport, cname string) sdp.MediaDescription {
		let section = new sdp.MediaDescription(isAudio(plan.format) ?? ("audio", "video"), "UDP/TLS/RTP/SAVPF")
		section.formats = ["{plan.payloadType}"]
		section.formats.push("{plan.rtxType}") when plan.rtxType > 0
		section.formats.push("{plan.fecType}") when plan.fecType > 0
		let shielded = plan.redType > 0 && plan.ulpType > 0
		// Redundant sound goes first: a browser sends the first format.
		let doubled = isAudio(plan.format) && plan.redType > 0
		section.formats.unshift("{plan.redType}") when doubled
		if shielded {
			section.formats.push("{plan.redType}")
			section.formats.push("{plan.redRtxType}") when plan.redRtxType > 0
			section.formats.push("{plan.ulpType}")
		}
		transportInto(section, local)
		section.add("mid", plan.mid)
		section.set(plan.direction)
		section.add("rtcp-mux")
		section.add(sdp.Extension{id: plan.midID, uri: midExtension}) when plan.midID > 0
		section.add(sdp.Extension{id: plan.wideID, uri: transportWideExtension}) when plan.wideID > 0
		let layered = plan.rids.len() > 0 && plan.ridID > 0
		if layered {
			section.add(sdp.Extension{id: plan.ridID, uri: ridExtension})
			section.add(sdp.Extension{id: plan.repairedID, uri: repairedExtension}) when plan.repairedID > 0
		}
		section.add(sdp.RtpMap{payloadType: plan.payloadType, encoding: encodingOf(plan.format), clockRate: clockRateOf(plan.format), channels: isAudio(plan.format) ?? (2, 0)})
		let parameters = parametersOf(plan.format)
		section.add(sdp.FormatParameters{payloadType: plan.payloadType, parameters: parameters}) unless parameters == ""
		section.add(sdp.RtcpFeedback{payloadType: plan.payloadType, kind: "transport-cc"}) when plan.wideID > 0
		if !isAudio(plan.format) {
			section.add(sdp.RtcpFeedback{payloadType: plan.payloadType, kind: "nack"})
			section.add(sdp.RtcpFeedback{payloadType: plan.payloadType, kind: "nack", parameter: "pli"})
			section.add(sdp.RtcpFeedback{payloadType: plan.payloadType, kind: "ccm", parameter: "fir"})
			section.add(sdp.RtcpFeedback{payloadType: plan.payloadType, kind: "goog-remb"})
		}
		if plan.rtxType > 0 {
			section.add(sdp.RtpMap{payloadType: plan.rtxType, encoding: "rtx", clockRate: clockRateOf(plan.format)})
			section.add(sdp.FormatParameters{payloadType: plan.rtxType, parameters: "apt={plan.payloadType}"})
		}
		if plan.fecType > 0 {
			section.add(sdp.RtpMap{payloadType: plan.fecType, encoding: fecEncoding, clockRate: clockRateOf(plan.format)})
			section.add(sdp.FormatParameters{payloadType: plan.fecType, parameters: "repair-window=10000000"})
		}
		if doubled {
			section.add(sdp.RtpMap{payloadType: plan.redType, encoding: redEncoding, clockRate: clockRateOf(plan.format), channels: 2})
			section.add(sdp.FormatParameters{payloadType: plan.redType, parameters: "{plan.payloadType}/{plan.payloadType}"})
		}
		if shielded {
			section.add(sdp.RtpMap{payloadType: plan.redType, encoding: redEncoding, clockRate: clockRateOf(plan.format)})
			if plan.redRtxType > 0 {
				section.add(sdp.RtpMap{payloadType: plan.redRtxType, encoding: "rtx", clockRate: clockRateOf(plan.format)})
				section.add(sdp.FormatParameters{payloadType: plan.redRtxType, parameters: "apt={plan.redType}"})
			}
			section.add(sdp.RtpMap{payloadType: plan.ulpType, encoding: ulpEncoding, clockRate: clockRateOf(plan.format)})
		}
		if layered {
			// The layers are told apart by their names, not their sources
			// (RFC 8853 §5.2).
			let streams sdp.SimulcastStream[]
			for let rid in plan.rids {
				section.add(sdp.Rid{id: rid, direction: plan.ridsReceived ?? ("recv", "send")})
				streams.push(sdp.SimulcastStream{rids: [rid], paused: [false]})
			}
			section.add(plan.ridsReceived ?? (sdp.Simulcast{recv: streams}, sdp.Simulcast{send: streams}))
			section.add(sdp.Msid{stream: cname, track: plan.trackID}) when plan.ssrc != 0
			return section
		}
		if plan.ssrc != 0 {
			section.add(sdp.Msid{stream: cname, track: plan.trackID})
			section.add(sdp.SourceGroup{semantics: "FEC-FR", ssrcs: [plan.ssrc, plan.fecSsrc]}) when plan.fecType > 0 && plan.fecSsrc != 0
			section.add(sdp.SourceGroup{semantics: "FID", ssrcs: [plan.ssrc, plan.rtxSsrc]}) when plan.rtxType > 0 && plan.rtxSsrc != 0
			section.add(sdp.SourceAttribute{ssrc: plan.ssrc, name: "cname", value: cname})
			section.add(sdp.SourceAttribute{ssrc: plan.rtxSsrc, name: "cname", value: cname}) when plan.rtxType > 0 && plan.rtxSsrc != 0
			section.add(sdp.SourceAttribute{ssrc: plan.fecSsrc, name: "cname", value: cname}) when plan.fecType > 0 && plan.fecSsrc != 0
		}
		return section
	}

	// Choice is a format a media section offers and its payload type.
	struct Choice {
		format      rtp.PayloadFormat
		payloadType int
	}

	// chosen is the first format of a media section this side has a
	// payload format for (the one wanted, when one is): H.264 only in
	// packetization mode 1. None when the section offers none.
	def chosen(section sdp.MediaDescription, wanted ?rtp.PayloadFormat) ?Choice {
		let maps = section.rtpMaps()
		for let listed in section.formats {
			for let map in maps {
				continue unless "{map.payloadType}" == listed
				let format = formatNamed(map.encoding)
				continue when format is none
				continue unless wanted is none || format == wanted
				if format == rtp.PayloadFormat.H264 {
					let mode = section.formatParameter(map.payloadType, "packetization-mode")
					continue when mode is none || mode != "1"
				}
				return Choice{format: format, payloadType: map.payloadType}
			}
		}
		return none
	}

	// wideNumberOf is the number a media section gives the transport-wide
	// header extension, 0 when it has none.
	def wideNumberOf(section sdp.MediaDescription) int {
		for let extension in section.extensions() {
			return extension.id when extension.uri == transportWideExtension
		}
		return 0
	}

	// extensionNumberOf is the number a media section gives a header
	// extension, 0 when it has none.
	def extensionNumberOf(section sdp.MediaDescription, uri string) int {
		for let extension in section.extensions() {
			return extension.id when extension.uri == uri
		}
		return 0
	}

	// layersOf is the names of the simulcast layers a media section sends
	// (`sent`) or takes, best first: the first name of each stream of its
	// "a=simulcast" that an "a=rid" of that direction declares. Empty for
	// a section without simulcast or without the header extension that
	// names a packet's layer.
	def layersOf(section sdp.MediaDescription, sent bool) string[] {
		let names string[]
		let simulcast = section.simulcast()
		return names when simulcast is none || extensionNumberOf(section, ridExtension) == 0
		let declared string[]
		for let rid in section.rids() {
			declared.push(rid.id) when rid.direction == (sent ?? ("send", "recv"))
		}
		for let stream in sent ?? (simulcast.send, simulcast.recv) {
			names.push(stream.rids[0]) when stream.rids.len() > 0 && declared.includes(stream.rids[0])
		}
		return names
	}

	// midNumberOf is the number a media section gives the MID header
	// extension, 0 when it has none.
	def midNumberOf(section sdp.MediaDescription) int {
		for let extension in section.extensions() {
			return extension.id when extension.uri == midExtension
		}
		return 0
	}

	// encodedAs is the payload type a media section lists under an
	// encoding name ("red", "ulpfec"), 0 when it has none.
	def encodedAs(section sdp.MediaDescription, encoding string) int {
		for let map in section.rtpMaps() {
			return map.payloadType when map.encoding.lower() == encoding && section.formats.includes("{map.payloadType}")
		}
		return 0
	}

	// soundRedOf is the payload type a media section carries a sound
	// format as redundant data under ("a=rtpmap:N red", "a=fmtp:N
	// 111/111"), 0 when it has none for that format.
	def soundRedOf(section sdp.MediaDescription, payloadType int) int {
		let red = encodedAs(section, redEncoding)
		return 0 when red == 0
		let carried = section.formatParameters(red)
		return 0 when carried is none
		for let part in carried.parameters.trim().split("/") {
			return 0 unless part == "{payloadType}"
		}
		return red
	}

	// rtxOf is the payload type a media section retransmits a payload
	// type under ("a=rtpmap:N rtx", "a=fmtp:N apt=..."), 0 when it has
	// none.
	def rtxOf(section sdp.MediaDescription, payloadType int) int {
		for let map in section.rtpMaps() {
			continue unless map.encoding.lower() == "rtx" && section.formats.includes("{map.payloadType}")
			let repaired = section.formatParameter(map.payloadType, "apt")
			return map.payloadType when !(repaired is none) && repaired == "{payloadType}"
		}
		return 0
	}

	// repairsOf is the sources of a media section in pairs: a source and
	// the source that repairs it, for retransmissions
	// ("a=ssrc-group:FID") or for FlexFEC ("FEC-FR").
	def repairsOf(section sdp.MediaDescription, semantics string = "FID") int[] {
		let out int[]
		for let group in section.sourceGroups() {
			out.push(group.ssrcs[0], group.ssrcs[1]) when group.semantics == semantics && group.ssrcs.len() == 2
		}
		return out
	}

	// fecOf is the payload type a media section sends FlexFEC under, 0
	// when it has none.
	def fecOf(section sdp.MediaDescription) int {
		for let map in section.rtpMaps() {
			return map.payloadType when map.encoding.lower() == fecEncoding && section.formats.includes("{map.payloadType}")
		}
		return 0
	}

	// sends and receives say what a direction lets its side do.
	def sends(direction sdp.Direction) bool {
		return direction := sdp.Direction.SendRecv || sdp.Direction.SendOnly
	}

	def receives(direction sdp.Direction) bool {
		return direction := sdp.Direction.SendRecv || sdp.Direction.RecvOnly
	}

	// directionOf is the direction of a side that sends, receives, both
	// or neither.
	def directionOf(sending bool, receiving bool) sdp.Direction {
		return sdp.Direction.SendRecv when sending && receiving
		return sdp.Direction.SendOnly when sending
		return sdp.Direction.RecvOnly when receiving
		return sdp.Direction.Inactive
	}
}
