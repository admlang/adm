internal std.net.webrtc partial module std.net.webrtc.peer {
	use (
		std.crypto.x509
		std.net
		std.net.rtp
		std.net.sdp
		std.net.tls
		std.net.webrtc::*
		std.net.webrtc.ice::(Agent, AgentConfig, newAgent)
		std.testing::*
		std.time
	)

	// agents is two ICE agents connected over the loopback, the first
	// controlling.
	internal def agents() !(Agent, Agent) {
		let config = AgentConfig{addresses: ["127.0.0.1"], pace: 5ms, rto: 40ms, patience: 20ms}
		let a = try newAgent(config)
		let b = try newAgent(config)
		try a.gather()
		try b.gather()
		try introduce(a, b)
		try introduce(b, a)
		a.start(true)
		b.start(false)
		try a.waitConnected(5s)
		try b.waitConnected(5s)
		return (a, b)
	}

	internal def introduce(from Agent, to Agent) !none {
		let (ufrag, pwd) = from.credentials()
		to.setRemote(ufrag, pwd)
		for {
			let candidate = try from.nextCandidate(5s)
			break when candidate is none
			try to.addRemote(candidate)
		}
		to.endOfCandidates()
		return none
	}

	internal async def accepting(transport Transport, identity tls.KeyPair, fingerprints sdp.Fingerprint[]) string {
		let failure = ""
		transport.connect(false, identity, fingerprints, 5s) onerror (err error) {
			failure = err.message
			recover none
		}
		return failure
	}

	// transports is two transports connected over two agents, the first
	// the DTLS client.
	internal def transports() !(Transport, Transport) {
		let (a, b) = try agents()
		let one = new Transport(a)
		let two = new Transport(b)
		let first = try selfSigned()
		let second = try selfSigned()
		let waiting = accepting(two, second, [fingerprintOf(first.chain[0])])
		try one.connect(true, first, [fingerprintOf(second.chain[0])], 5s)
		let failure = await waiting
		fail failure unless failure == ""
		return (one, two)
	}

	// HandshakeDropper hands a transport its datagrams but the DTLS
	// datagram with the index `drop` (-1 for none), and counts them.
	internal type HandshakeDropper {
		transport   Transport
		drop        int       = -1
		atomic seen int       = 0

		def new(transport Transport, drop int) {
			self.transport = transport
			self.drop = drop
		}

		def take(data byte[]) {
			if data.len() > 0 && int(data[0]) >= 20 && int(data[0]) <= 63 {
				let index = count()
				return when index == drop
			}
			transport.take(data)
		}

		atomic def count() int {
			seen++
			return seen - 1
		}
	}

	// handshakeLosing connects two transports, the first the DTLS client,
	// with the DTLS datagram of index `drop` to the server lost, the
	// client's connection read by nothing but `serve`; returns the number
	// of DTLS datagrams the server's side saw arrive.
	internal def handshakeLosing(drop int) !int {
		let (a, b) = try agents()
		let one = new Transport(a)
		let two = new Transport(b)
		let filter = new HandshakeDropper(two, drop)
		b.deliverTo(filter.take)
		let first = try selfSigned()
		let second = try selfSigned()
		let waiting = accepting(two, second, [fingerprintOf(first.chain[0])])
		try one.connect(true, first, [fingerprintOf(second.chain[0])], 5s)
		// Without a loss the server ends its handshake by itself, and what
		// it saw by then is all the client sent.
		one.serve() when drop >= 0
		let failure = await waiting
		fail failure unless failure == ""
		let sent = filter.seen
		one.serve()
		// A data channel takes the connection over from the task.
		try one.data()
		assert !one.isServing()
		try one.close()
		try two.close()
		try a.close()
		try b.close()
		return sent
	}

	// Collector keeps what a transport hands on.
	internal type Collector {
		atomic packets byte[][] = []

		def new() {}

		atomic def take(data byte[]) {
			packets.push(data.clone())
		}

		atomic def count() int {
			return packets.len()
		}

		atomic def at(index int) byte[] {
			return packets[index]
		}
	}

	internal def waitFor(collector Collector, count int) bool {
		for let i = 0; i < 400 && collector.count() < count; i++ {
			time.sleep(5ms)
		}
		return collector.count() >= count
	}

	// numbered is an RTP packet with a sequence number and a payload of
	// `size` bytes, in an array with room for the SRTP tag.
	internal def numbered(sequence int, size int) !(byte[], int) {
		let packet = new rtp.Packet()
		packet.payloadType = 96
		packet.sequence = sequence
		packet.timestamp = 3000 * (sequence / 3)
		packet.ssrc = 0x1234
		packet.marker = sequence % 3 == 2
		let payload byte[]
		payload.len(size)
		for let i = 0; i < size; i++ {
			payload[i] = byte((sequence + i) & 0xFF)
		}
		// A VP8 payload descriptor that starts a partition on the first
		// packet of a frame.
		payload[0] = sequence % 3 == 0 ?? (byte(0x10), byte(0x00))
		let plain = packet.encode(payload)
		let out byte[]
		out.len(plain.len() + 32)
		plain.copy(out)
		return (out, plain.len())
	}

	check "WebRTC transport" {
		// A certificate made for a connection parses, is signed by its own
		// key, and has the fingerprint computed for it and no other.
		@test()
		def certificate() !none {
			let identity = try selfSigned("adm test")
			let parsed = try x509.parseCertificate(identity.chain[0])
			let key = parsed.publicKey
			fail "the certificate's key was not read" when key is none
			try x509.verifySignature(parsed.signatureAlgorithm, parsed.rawTBS, parsed.signature, key)
			assert parsed.version == 3 && parsed.subject.str().contains("adm test") && parsed.notAfter.after(time.now()) && parsed.notBefore.before(time.now())
			let print = fingerprintOf(identity.chain[0])
			let other = try selfSigned()
			assert print.algorithm == "sha-256" && print.digest.len() == 32
			assert matches(identity.chain[0], [print]) && !matches(other.chain[0], [print]) && !matches(identity.chain[0], [])
			return none
		}

		// Two transports over two ICE agents: the DTLS handshake with both
		// certificates checked by fingerprint, then RTP and RTCP protected
		// The last datagram of the client's handshake is lost on a
		// connection without data channels: the server repeats its flight,
		// the task that reads the client's connection answers, and the
		// server's handshake ends.
		@test()
		def lastFlightLost() !none {
			let sent = try handshakeLosing(-1)
			assert sent >= 2
			try handshakeLosing(sent - 1)
			return none
		}

		// one way and opened the other, and DTLS data both ways beside
		// them.
		@test()
		def mediaAndData() !none {
			let (one, two) = try transports()
			let media = new Collector()
			let control = new Collector()
			two.rtpSink = media.take
			two.rtcpSink = control.take
			assert one.rtpOverhead() > 0 && one.rtcpOverhead() > 4
			let sent byte[][]
			for let i = 0; i < 5; i++ {
				let (packet, length) = try numbered(i, 200)
				sent.push(packet[0:length].clone())
				try one.sendRtp(packet, length)
				assert packet.len() == length + 32
			}
			let compound = new rtp.Compound()
			compound.plis.push(rtp.Pli{sender: 1, media: 0x1234})
			let report = compound.encode()
			let room byte[]
			room.len(report.len() + 32)
			report.copy(room)
			try one.sendRtcp(room, report.len())
			assert waitFor(media, 5) && waitFor(control, 1)
			for let i = 0; i < 5; i++ {
				assert media.at(i).equals(sent[i])
			}
			assert control.at(0).equals(report)

			let near = try one.data()
			let far = try two.data()
			try near.send("over dtls".bytes(), 2s)
			assert string(try far.receive(2s)) == "over dtls"
			try far.send("and back".bytes(), 2s)
			assert string(try near.receive(2s)) == "and back"
			try one.close()
			try two.close()
			try one.agent.close()
			try two.agent.close()
			return none
		}

		// One received SRTP packet of 1200 bytes end to end, a thousand an
		// iteration over one pair of transports kept for the run: made and
		// sealed, sent over the loopback, read by the agent, sorted by its
		// first byte, opened in place, parsed and pushed into a jitter
		// buffer (`BenchReceivePath`). Beside it the same without the
		// sockets (the sealed packet handed straight to the receiver's
		// demultiplexer), and its parts: making the packets, sealing
		// them, parsing and pushing plain ones.
		@benchmark()
		def BenchReceivePath() {
			receivePath(3) onerror recover none
		}

		@benchmark()
		def BenchSealDemuxOpenPush() {
			receivePath(2) onerror recover none
		}

		@benchmark()
		def BenchSealOnly() {
			receivePath(1) onerror recover none
		}

		@benchmark()
		def BenchParsePush() {
			receivePath(0) onerror recover none
		}

		@benchmark()
		def BenchPacketsOnly() {
			receivePath(-1) onerror recover none
		}

		// Packets lost on the way are asked for again (NACK) and answered
		// from the sender's ring, so the frame arrives whole; a packet
		// that never comes makes the receiver give its frame up after
		// half a second and ask for a keyframe (PLI), which the sender
		// sees; the next keyframe is delivered.
		@test()
		def lostPackets() !none {
			try recovering(false)
			// The same with retransmissions as a stream of their own (RFC
			// 4588): they arrive under the other payload type and source.
			return try recovering(true)
		}

		@test()
		def simulcastLayersRepaired() !none {
			return try layersRepaired()
		}
	}

	// layersRepaired is two simulcast layers of one media section, told
	// apart by the names their packets carry: a packet lost from one layer
	// comes back as a retransmission that names the layer it repairs, and
	// the other layer's frame is its own.
	internal def layersRepaired() !none {
		let (one, two) = try transports()
		let sending = new Media()
		let receiving = new Media()
		sending.name(byte[1, 2, 3, 4, 5, 6, 7, 8])
		receiving.name(byte[8, 7, 6, 5, 4, 3, 2, 1])
		sending.attach(one)
		receiving.attach(two)
		let high = new Sender(rtp.PayloadFormat.VP8, try startOf())
		let low = new Sender(rtp.PayloadFormat.VP8, try startOf())
		sending.send(high, 96, "0", 1, 97, 0, 2, "h", 3, 4)
		sending.send(low, 96, "0", 1, 97, 0, 2, "l", 3, 4)
		// No source is announced: the names route the packets.
		receiving.receive("0", rtp.PayloadFormat.VP8, 96, [], 1, 97, [], 0, [], 2, "h", 3, 4)
		receiving.receive("0", rtp.PayloadFormat.VP8, 96, [], 1, 97, [], 0, [], 2, "l", 3, 4)
		let first = try receiving.accept(1s)
		let second = try receiving.accept(1s)
		let upper = first.rid == "h" ?? (first, second)
		let lower = first.rid == "h" ?? (second, first)
		assert upper.rid == "h" && lower.rid == "l"
		let lossy = new Dropper(two)
		two.agent.deliverTo(lossy.take)

		let big byte[]
		big.len(10000)
		let small byte[]
		small.len(3000)
		for let i = 1; i < big.len(); i++ {
			big[i] = byte(i & 0xFF)
			small[i] = byte((i * 7) & 0xFF) when i < small.len()
		}
		big[0] = 0x10
		small[0] = 0x10
		lossy.once = [2, 5]
		try high.write(big, 33ms, true)
		let whole = try receiving.frame(upper, 5s)
		assert whole.data.equals(big) && high.resent == 2 && lossy.dropped == 2 && lossy.repaired == 2 && low.resent == 0
		try low.write(small, 33ms, true)
		assert (try receiving.frame(lower, 5s)).data.equals(small)
		assert upper.source == high.ssrc && lower.source == low.ssrc && upper.repairs.equals([high.rtxSsrc]) && lower.repairs.len() == 0
		sending.shut()
		receiving.shut()
		try one.close()
		try two.close()
		return none
	}

	internal def recovering(withRtx bool) !none {
		let (one, two) = try transports()
		let sending = new Media()
		let receiving = new Media()
		sending.name(byte[1, 2, 3, 4, 5, 6, 7, 8])
		receiving.name(byte[8, 7, 6, 5, 4, 3, 2, 1])
		sending.attach(one)
		receiving.attach(two)
		let sender = new Sender(rtp.PayloadFormat.VP8, try startOf())
		sending.send(sender, 96, "0", 0, withRtx ?? (97, 0))
		receiving.receive("0", rtp.PayloadFormat.VP8, 96, [sender.ssrc], 0, withRtx ?? (97, 0), withRtx ?? ([sender.rtxSsrc], []))
		let receiver = try receiving.accept(1s)
		// Lost before the transport sees them, as on a network.
		let lossy = new Dropper(two)
		two.agent.deliverTo(lossy.take)

		let frame byte[]
		frame.len(10000)
		for let i = 1; i < frame.len(); i++ {
			frame[i] = byte(i & 0xFF)
		}
		frame[0] = 0x10
		lossy.once = [2, 5]
		try sender.write(frame, 33ms, true)
		let whole = try receiving.frame(receiver, 5s)
		assert whole.data.equals(frame) && whole.keyframe && sender.resent == 2 && lossy.dropped == 2 && lossy.repaired == (withRtx ?? (2, 0))
		// The receiver counts what came itself, what it asked for and
		// what came back; nothing stays lost.
		let counted = receiver.statistics()
		// (Sent again in the stream itself, a packet counts as one of it,
		// and the dropper may take it for the second packet to lose.)
		let back = withRtx ?? (2, 0)
		// The retransmission stream is reported as a stream of its own.
		let stream = receiver.repairReception()
		assert (stream is none) == !withRtx
		assert stream.ssrc == sender.rtxSsrc && stream.lost == 0 unless stream is none
		assert counted.packets == sender.packets - back && counted.requested >= 1 && counted.requested <= 2 && (counted.requested == 2 || !withRtx) && counted.resent == back && counted.repaired == 0 && counted.lost == 0 && counted.keyframeRequests == 0

		// The third packet of the next frame never arrives.
		lossy.never = (sender.sequence + 2) & 0xFFFF
		frame[0] = 0x11
		try sender.write(frame, 33ms, false)
		let asked = false
		for let i = 0; i < 300 && !asked; i++ {
			time.sleep(10ms)
			asked = sender.takeKeyframeRequest()
		}
		assert asked
		frame[0] = 0x10
		try sender.write(frame, 33ms, true)
		let next = try receiving.frame(receiver, 5s)
		assert next.data.equals(frame) && next.keyframe && receiver.statistics().keyframeRequests >= 1
		sending.shut()
		receiving.shut()
		try one.close()
		try two.close()
		try one.agent.close()
		try two.agent.close()
		return none
	}

	check "WebRTC media routing" {
		// A packet that came back as a retransmission under another
		// header than the stream's packets have (a sender names the media
		// section there for longer) is not what the repair packet was
		// made from: it is not used to put another packet back, which
		// would come out wrong. Under the same header it is.
		@test()
		def repairsOnlyFromWhatWasProtected() !none {
			for let longer in [false, true] {
				let receiver = new Receiver("0", rtp.PayloadFormat.VP8, 96, [5])
				receiver.protect(118, [6])
				let maker = new rtp.FecSender(118, 6, 0)
				let packet = new rtp.Packet()
				packet.payloadType = 96
				packet.ssrc = 5
				packet.timestamp = 3000
				let wire byte[][]
				let repair byte[]
				repair.len(1700)
				let made = 0
				for let i = 0; i < 5; i++ {
					packet.sequence = 200 + i
					packet.marker = i == 4
					let payload = byte[i == 0 ?? (0x10, 0x00), byte(i), 1, 2, 3, 4, 5, 6]
					let bytes = packet.encode(payload)
					wire.push(bytes)
					made = try maker.protect(bytes, bytes.len(), repair)
				}
				assert made > 0
				let now = 1000000000
				for let i = 0; i < 3; i++ {
					receiver.take(wire[i], now)
				}
				// The fourth comes back as a retransmission, the fifth is
				// lost.
				let again = wire[3]
				if longer {
					packet.sequence = 203
					packet.marker = false
					packet.writeExtension(4, "0".bytes())
					again = packet.encode(byte[0x00, 3, 1, 2, 3, 4, 5, 6])
				}
				receiver.take(again, now, true)
				receiver.mend(repair[0:made].clone(), now)
				let counted = receiver.statistics()
				assert counted.resent == 1 && counted.repaired == (longer ?? (0, 1))
				let frame = try receiver.pop()
				assert (frame is none) == longer
			}
			return none
		}

		// A packet that is missing is asked for at once, again a round
		// trip later and ten times at most; when its frame is given up a
		// keyframe is asked for. Sound is never asked for again.
		@test()
		def asksAgainARoundTripLater() !none {
			let receiver = new Receiver("0", rtp.PayloadFormat.VP8, 96, [5])
			let packet = new rtp.Packet()
			packet.payloadType = 96
			packet.ssrc = 5
			packet.timestamp = 3000
			let second = 1000000000
			for let number in [100, 102] {
				packet.sequence = number
				receiver.take(packet.encode(byte[number == 100 ?? (0x10, 0x00), 0x00, 1, 2, 3]), second)
			}
			assert receiver.takeGap() && !receiver.takeGap()
			assert receiver.lacking(second, 100000000).equals([101])
			assert receiver.lacking(second + 50000000, 100000000).len() == 0
			assert receiver.lacking(second + 100000000, 100000000).len() == 0 && receiver.lacking(second + 125000000, 100000000).equals([101])
			// With a short round trip the tries run out: eight more.
			let asked = 2
			for let i = 0; i < 12; i++ {
				asked += receiver.lacking(second + 150000000 + i * 25000000, 20000000).len()
			}
			assert asked == 10 && receiver.statistics().requested == 1
			assert receiver.lacking(second + 500000000, 20000000).len() == 0 && receiver.takePictureRequest(second + 500000000)
			assert receiver.statistics().keyframeRequests == 1

			let sound = new Receiver("1", rtp.PayloadFormat.Opus, 111, [6])
			packet.payloadType = 111
			packet.ssrc = 6
			for let number in [7, 9] {
				packet.sequence = number
				sound.take(packet.encode(byte[1, 2, 3]), second)
			}
			assert sound.lacking(second, 100000000).len() == 0 && sound.lacking(second + 600000000, 100000000).len() == 0 && !sound.takePictureRequest(second + 600000000)
			return none
		}

		// With FlexFEC agreed, a packet lost among five is put back from
		// their repair packet: the frame is whole and nothing was asked
		// for again.
		@test()
		def repairedWithoutAsking() !none {
			let (one, two) = try transports()
			let sending = new Media()
			let receiving = new Media()
			sending.name(byte[1, 2, 3, 4, 5, 6, 7, 8])
			receiving.name(byte[8, 7, 6, 5, 4, 3, 2, 1])
			sending.attach(one)
			receiving.attach(two)
			let sender = new Sender(rtp.PayloadFormat.VP8, try startOf())
			sending.send(sender, 96, "0", 0, 0, 118)
			receiving.receive("0", rtp.PayloadFormat.VP8, 96, [sender.ssrc], 0, 0, [], 118, [sender.fecSsrc])
			let receiver = try receiving.accept(1s)
			let lossy = new Dropper(two)
			two.agent.deliverTo(lossy.take)
			let frame byte[]
			frame.len(5500)
			for let i = 1; i < frame.len(); i++ {
				frame[i] = byte((i * 3) & 0xFF)
			}
			frame[0] = 0x10
			lossy.once = [2]
			try sender.write(frame, 33ms, true)
			let whole = try receiving.frame(receiver, 5s)
			let guard = receiver.fec
			assert whole.data.equals(frame) && lossy.dropped == 1 && sender.resent == 0 && !(guard is none) && guard.recovered == 1
			sending.shut()
			receiving.shut()
			try one.close()
			try two.close()
			try one.agent.close()
			try two.agent.close()
			return none
		}

		// Sound as redundant data: each packet carries the one before it
		// again, so a packet lost alone is played from the next one, in
		// its place and once; a packet after a pause carries none.
		@test()
		def soundCarriedAgain() !none {
			let (one, two) = try transports()
			let sending = new Media()
			let receiving = new Media()
			sending.name(byte[1, 2, 3, 4, 5, 6, 7, 8])
			receiving.name(byte[8, 7, 6, 5, 4, 3, 2, 1])
			sending.attach(one)
			receiving.attach(two)
			let sender = new Sender(rtp.PayloadFormat.Opus, try startOf())
			sending.send(sender, 111, "0", 0, 0)
			receiving.receive("0", rtp.PayloadFormat.Opus, 111, [sender.ssrc], 0, 0)
			sending.guard(sender, "0", 63, 0, 0, false)
			receiving.guard(none, "0", 63, 0, 0, false)
			let receiver = try receiving.accept(1s)
			let lossy = new Dropper(two)
			two.agent.deliverTo(lossy.take)
			// Eight packets of sound; the third and the sixth are lost.
			lossy.once = [2, 5]
			for let n = 0; n < 8; n++ {
				let sound byte[]
				sound.len(40 + n)
				sound.fill(byte(n + 1))
				try sender.write(sound, 20ms, false)
			}
			for let n = 0; n < 8; n++ {
				let heard = try receiving.frame(receiver, 5s)
				fail "packet {n} came as {heard.data.len()} bytes of {heard.data[0]}" unless heard.data.len() == 40 + n && heard.data[0] == byte(n + 1) && heard.data[39 + n] == byte(n + 1)
			}
			assert lossy.dropped == 2 && receiver.repaired == 2 && receiver.received == 6 && receiver.statistics().lost == 0
			// After a pause longer than the field for it holds (341 ms
			// at 48 kHz) the packet goes without the one before it.
			sender.skip(400ms)
			let alone byte[]
			alone.len(30)
			alone.fill(byte(77))
			try sender.write(alone, 20ms, false)
			let late = try receiving.frame(receiver, 5s)
			assert late.data.equals(alone) && receiver.repaired == 2
			try one.close()
			try two.close()
			try one.agent.close()
			try two.agent.close()
			return none
		}

		// With ULPFEC agreed, every packet goes as redundant data and a
		// packet lost among five is put back from the repair block that
		// follows them in the stream's own numbering: both frames are
		// whole, nothing was asked for again, and the repair packets'
		// numbers are not taken for missing ones.
		@test()
		def repairedInBand() !none {
			let (one, two) = try transports()
			let sending = new Media()
			let receiving = new Media()
			sending.name(byte[1, 2, 3, 4, 5, 6, 7, 8])
			receiving.name(byte[8, 7, 6, 5, 4, 3, 2, 1])
			sending.attach(one)
			receiving.attach(two)
			let sender = new Sender(rtp.PayloadFormat.VP8, try startOf())
			sending.send(sender, 96, "0", 0, 0)
			receiving.receive("0", rtp.PayloadFormat.VP8, 96, [sender.ssrc], 0, 0)
			sending.guard(sender, "0", 100, 102, 0, true)
			receiving.guard(none, "0", 100, 102, 0, false)
			let receiver = try receiving.accept(1s)
			let lossy = new Dropper(two)
			two.agent.deliverTo(lossy.take)
			let frame byte[]
			frame.len(5500)
			for let i = 1; i < frame.len(); i++ {
				frame[i] = byte((i * 3) & 0xFF)
			}
			frame[0] = 0x10
			lossy.once = [2]
			try sender.write(frame, 33ms, true)
			let whole = try receiving.frame(receiver, 5s)
			let guard = receiver.fec
			assert whole.data.equals(frame) && lossy.dropped == 1 && sender.resent == 0 && !(guard is none) && guard.recovered == 1
			// Six packets left for five payloads: the sixth is the repair.
			// Four of them and the repair packet came in the stream.
			assert sender.sequence - sender.unsent == 0 && receiver.received == 4 + 1 && receiver.repaired == 1 && receiver.statistics().lost == 0
			// Repair takes its share of what the track may use.
			assert sender.statistics().repairs == 1 && sender.allowed() < sender.estimate && sender.allowed() >= sender.estimate / 2
			frame[0] = 0x11
			frame[77] = 0x5A
			lossy.once = [lossy.seen + 4]
			try sender.write(frame, 33ms, false)
			let second = try receiving.frame(receiver, 5s)
			assert second.data.equals(frame) && lossy.dropped == 2 && !(guard is none) && sender.resent + guard.recovered == 2 && receiver.lacking(0, 0).len() == 0
			// A frame of eight packets: a group of five and one of three,
			// their two repair packets behind the frame's last packet,
			// where a receiver that wants a frame's packets in a row can
			// have them. One packet of each group is lost.
			let long byte[]
			long.len(9000)
			for let i = 1; i < long.len(); i++ {
				long[i] = byte((i * 5) & 0xFF)
			}
			long[0] = 0x11
			let before = sender.sequence
			lossy.once = [lossy.seen + 1, lossy.seen + 6]
			try sender.write(long, 33ms, false)
			let third = try receiving.frame(receiver, 5s)
			// Each of the two is put back once: from its repair packet, or
			// by a retransmission when the receiver asked before the
			// repair packet came (it follows the whole frame).
			let fixed = guard is none ?? (-1, guard.recovered)
			assert sender.sequence - before == 10 && third.data.equals(long) && third.lastSequence == ((before + 7) & 0xFFFF) && lossy.dropped == 4 && fixed >= 2 && sender.resent + fixed == 4
			sending.shut()
			receiving.shut()
			try one.close()
			try two.close()
			try one.agent.close()
			try two.agent.close()
			return none
		}

		// Packets of a source nobody announced go to the receiver of the
		// media section their MID header extension names, and without the
		// extension to the first receiver of their payload type that has
		// no source yet; once a source is known its packets need neither.
		@test()
		def routedByMid() !none {
			let media = new Media()
			media.receive("a", rtp.PayloadFormat.VP8, 96, [], 3)
			media.receive("b", rtp.PayloadFormat.VP8, 96, [], 3)
			let first = try media.accept(1s)
			let second = try media.accept(1s)
			let packet = new rtp.Packet()
			packet.payloadType = 96
			packet.ssrc = 500
			packet.sequence = 1
			packet.writeExtension(3, "b".bytes())
			media.takeRtp(packet.encode(byte[0x10, 1, 2]))
			assert first.mid == "a" && first.statistics().packets == 0 && second.statistics().packets == 1 && second.source == 500
			let plain = new rtp.Packet()
			plain.payloadType = 96
			plain.ssrc = 600
			plain.sequence = 9
			media.takeRtp(plain.encode(byte[0x10, 1, 2]))
			assert first.statistics().packets == 1 && first.source == 600
			plain.ssrc = 500
			plain.sequence = 2
			media.takeRtp(plain.encode(byte[0x11, 1, 2]))
			assert second.statistics().packets == 2
			plain.payloadType = 97
			plain.ssrc = 700
			media.takeRtp(plain.encode(byte[0x10]))
			assert first.statistics().packets == 1 && second.statistics().packets == 2
			media.shut()
			return none
		}

		// A peer whose certificate is not the one its description named
		// is refused.
		@test()
		def wrongFingerprint() !none {
			let (a, b) = try agents()
			let one = new Transport(a)
			let two = new Transport(b)
			let first = try selfSigned()
			let second = try selfSigned()
			let stranger = try selfSigned()
			let waiting = accepting(two, second, [fingerprintOf(first.chain[0])])
			let refused = false
			one.connect(true, first, [fingerprintOf(stranger.chain[0])], 5s) onerror (err error) {
				refused = err is WebRtcError
				recover none
			}
			await waiting
			let early = false
			one.sendRtp([], 0) onerror (err error) {
				early = err is WebRtcError
				recover 0
			}
			assert refused && early
			try a.close()
			try b.close()
			return none
		}
	}

	// Dropper stands between an agent and its transport: it loses the
	// RTP packets whose place in the stream is listed, once each, and the
	// packet with one sequence number always.
	internal type Dropper {
		transport       Transport
		once            int[]     = []
		never           int       = -1
		atomic seen     int       = 0
		atomic dropped  int       = 0
		// Packets seen under the retransmission payload type 97.
		atomic repaired int       = 0

		def new(transport Transport) {
			self.transport = transport
		}

		def take(data byte[]) {
			if data.len() < 4 || int(data[0]) < 128 || int(data[0]) > 191 || rtp.isRtcp(data) {
				transport.take(data)
				return
			}
			if (int(data[1]) & 0x7F) == 97 {
				// Which packet a retransmission repairs is encrypted: once
				// a packet is to stay lost, every retransmission is lost.
				if never >= 0 {
					lose()
					return
				}
				note()
				transport.take(data)
				return
			}
			let place = count()
			let number = int(data[2]) << 8 | int(data[3])
			if once.includes(place) || number == never {
				lose()
				once.pull(place)
				return
			}
			transport.take(data)
		}

		atomic def count() int {
			seen++
			return seen - 1
		}

		atomic def note() {
			repaired++
		}

		atomic def lose() {
			dropped++
		}
	}

	// Feeder parses packets and pushes them into a jitter buffer, popping
	// a frame at each marker.
	internal type Feeder {
		buffer     rtp.JitterBuffer
		packet     rtp.Packet
		atomic fed int              = 0

		def new() {
			buffer = new rtp.JitterBuffer(rtp.PayloadFormat.VP8)
			packet = new rtp.Packet()
		}

		def take(data byte[]) {
			packet.read(data) onerror recover none
			buffer.push(packet)
			if packet.marker {
				buffer.pop() onerror recover none
			}
			bump()
		}

		atomic def bump() {
			fed++
		}

		atomic def count() int {
			return fed
		}
	}

	// Rig is a pair of connected transports with a feeder behind the
	// second, kept for all the iterations of the benchmarks; the sequence
	// numbers go on from one iteration to the next.
	internal type Rig {
		one    Transport
		two    Transport
		feeder Feeder
		plain  Feeder
		next   int       = 0

		def new(one Transport, two Transport) {
			self.one = one
			self.two = two
			feeder = new Feeder()
			plain = new Feeder()
			two.rtpSink = feeder.take
		}
	}

	internal let rig ?Rig = none

	internal def theRig() !Rig {
		let kept = rig
		return kept unless kept is none
		let (one, two) = try transports()
		let made = new Rig(one, two)
		rig = made
		return made
	}

	// receivePath runs a thousand packets through a stage: -1 makes them,
	// 0 parses and pushes them plain, 1 seals them, 2 seals them and
	// hands them to the receiver's demultiplexer, 3 sends them over the
	// sockets.
	internal def receivePath(stage int) !none {
		let bench = try theRig()
		let keyed = bench.one.session
		fail "no SRTP session" when keyed is none
		let before = bench.feeder.count()
		for let i = 0; i < 1000; i++ {
			let (packet, length) = try numbered(bench.next, 1188)
			bench.next++
			continue when stage < 0
			if stage == 0 {
				packet.len(length)
				bench.plain.take(packet)
				continue
			}
			if stage == 3 {
				try bench.one.sendRtp(packet, length)
				for let spins = 0; bench.feeder.count() - before < i - 32 && spins < 100000; spins++ {
					time.sleep(20us)
				}
				continue
			}
			packet.len(try keyed.protect(packet, length))
			bench.two.take(packet) when stage == 2
		}
		return none unless stage >= 2
		for let spins = 0; bench.feeder.count() - before < 1000 && spins < 20000; spins++ {
			time.sleep(100us)
		}
		fail "{bench.feeder.count() - before} of 1000 packets came through" unless bench.feeder.count() - before == 1000
		return none
	}
}
