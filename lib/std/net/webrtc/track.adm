// Tracks: the audio and video a peer connection sends and receives, as
// encoded frames. Encoding and decoding are the program's (or
// std.media.call's): this module carries what the codec made.
partial module std.net.webrtc {
	use (
		std.bytes::(Endian)
		std.net.rtp
		std.net.webrtc.peer::(Media, Receiver, Sender, isAudio, startOf)
		std.time
	)

	// TrackKind is what a track carries.
	enum TrackKind {
		Audio,
		Video
	}

	// SendStats is what a track sent and what the peer reported of it (its
	// RTCP reception reports): packets and payload bytes sent, packets
	// sent again on request, repair packets sent (forward error
	// correction), packets the peer counts lost in all and the
	// fraction lost lately (0 to 1), the peer's interarrival jitter, the
	// round trip measured through its reports, and the bits per second
	// the track may use.
	struct SendStats {
		packets      int      = 0
		bytes        int      = 0
		resent       int      = 0
		repairs      int      = 0
		lost         int      = 0
		fractionLost float    = 0.0
		jitter       duration = 0s
		roundTrip    duration = 0s
		bitrate      int      = 0
	}

	// ReceiveStats is what arrived of a track: packets that came in the
	// stream itself, payload bytes and whole frames; packets that never
	// came by any way (but those known to have held no frame: repair
	// packets lost between two frames); packets asked for again, packets a retransmission
	// put back and packets a repair packet put back (forward error
	// correction); keyframes asked for; and the interarrival jitter (RFC
	// 3550 §6.4.1).
	struct ReceiveStats {
		packets          int      = 0
		bytes            int      = 0
		frames           int      = 0
		lost             int      = 0
		requested        int      = 0
		resent           int      = 0
		repaired         int      = 0
		keyframeRequests int      = 0
		jitter           duration = 0s
	}

	// LocalTrack is a track this side sends: frames of one format (Opus
	// for audio; VP8, VP9, H.264 or AV1 for video), written as the encoder
	// makes them. `PeerConnection.addTrack` puts it on a connection.
	type LocalTrack {
		kind   TrackKind
		format rtp.PayloadFormat
		// The track's identifier in the description ("a=msid").
		id     string
		// The track's name as a simulcast layer
		// (`PeerConnection.addSimulcast`), empty for a track that is none.
		rid    string            = ""
		// The sending side the connection drives.
		sender Sender

		def new(format rtp.PayloadFormat, id string = "") {
			self.format = format
			kind = isAudio(format) ?? (TrackKind.Audio, TrackKind.Video)
			self.id = id == "" ?? (isAudio(format) ?? ("audio", "video"), id)
			// The source and the first sequence number and timestamp are
			// random so that sources do not collide (RFC 3550 §5.1); a
			// system without random bytes starts them from the clock.
			let start = startOf() onerror recover uint64(time.monoNs()).bytes(Endian.Big) + uint64(time.monoNs() * 31).bytes(Endian.Big) + uint64(time.monoNs() * 131).bytes(Endian.Big)
			sender = new Sender(format, start)
			sender.trackID = self.id
		}

		// writeFrame sends one encoded frame that lasts `length` (20 ms
		// of audio, a frame interval of video); `keyframe` says it can be
		// decoded without the frames before it. The frame is cut into RTP
		// packets, numbered, stamped, protected and sent. Fails with
		// WebRtcError until the connection is up and the peer's answer
		// takes the track, as the transport does otherwise. `layer` is the
		// frame's temporal layer when the encoder makes layers (0 for a
		// frame later ones need, 1 for one a receiver may drop), which a
		// relay reads from the packets; -1 for a stream without layers.
		def writeFrame(frame byte[], length duration, keyframe bool = false, layer int = -1) !none {
			return try sender.write(frame, length, keyframe, layer)
		}

		// ready reports whether the connection carries the track: frames
		// written before it does are refused, so an encoder need not make
		// them.
		def ready() bool {
			return sender.carried() && sender.payloadType >= 0
		}

		// skip lets `length` pass without sending anything: the next
		// frame is stamped that much later. For sound an encoder left out
		// as silence (discontinuous transmission).
		def skip(length duration) {
			sender.skip(length)
		}

		// keyframeRequested reports whether the peer asked for a keyframe
		// (PLI or FIR) since the last one was written or the last call:
		// the encoder makes the next frame one.
		def keyframeRequested() bool {
			return sender.takeKeyframeRequest()
		}

		// bitrate is the bits per second the track's frames may take now:
		// `limit` lowered to what the path carries and the peer said it
		// can take, less the share repair packets and retransmissions
		// take of what is sent.
		def bitrate() int {
			return sender.allowed()
		}

		// stats is what the track sent and what the peer reported of it.
		def stats() SendStats {
			return sender.statistics()
		}

		// limit sets the most bits per second the track uses.
		def limit(bitsPerSecond int) {
			sender.maxBitrate = bitsPerSecond
			sender.limit(bitsPerSecond)
		}
	}

	// RemoteTrack is a track the peer sends: whole encoded frames in
	// order, as its packets arrive.
	type RemoteTrack {
		kind              TrackKind
		format            rtp.PayloadFormat
		// The media section the track belongs to.
		mid               string
		// The simulcast layer the track is when the peer sends several
		// encodings of one picture (each comes out of `acceptTrack` as a
		// track of its own), empty otherwise.
		rid               string
		internal receiver Receiver
		internal media    Media

		def new(media Media, receiver Receiver) {
			self.media = media
			self.receiver = receiver
			format = receiver.format
			kind = isAudio(format) ?? (TrackKind.Audio, TrackKind.Video)
			mid = receiver.mid
			rid = receiver.rid
		}

		// readFrame waits for the next whole frame: its bytes as the
		// decoder takes them, its RTP timestamp at full width, and whether
		// it is a keyframe; 0s or less waits without end. Packets missing
		// in front of it are asked for again; a frame that stays
		// incomplete for half a second is given up and a keyframe asked
		// for. Fails with NetError (TimedOut), RtpError for payloads that
		// are not of the format, WebRtcError once the connection is
		// closed.
		def readFrame(timeout duration = 30s) !rtp.Frame {
			return try media.frame(receiver, timeout)
		}

		// stats is what arrived of the track.
		def stats() ReceiveStats {
			return receiver.statistics()
		}

		// requestKeyframe asks the peer for a keyframe (PLI), at most
		// twice a second.
		def requestKeyframe() {
			receiver.askForPicture()
		}
	}
}
