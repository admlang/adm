// WebRTC: live audio, video and messages between peers through NATs, with
// the protocol stack browsers speak (RFC 8825). Design and order of work:
// docs/requirements/webrtc.md.
partial module std.net.webrtc {
	use std.errors

	// WebRtcError is the payload of a failure of this module.
	struct WebRtcError {
		message string
		code    string            = "webrtc"
		cause   ?error
		stack   errors.StackTrace
	}

	// IceServer names STUN and TURN servers by their URIs ("stun:host:port",
	// "turn:host:port?transport=udp", RFC 7064, RFC 7065), with the
	// long-term credentials a TURN server asks for.
	struct IceServer {
		urls       string[]
		username   string   = ""
		credential string   = ""
	}

	// IceTransportPolicy says which paths a connection may use: any, or
	// only those through a TURN relay (which hides the host's addresses
	// from the peer).
	enum IceTransportPolicy {
		All,
		Relay
	}

	// IceConnectionState is where the search for a path to the peer
	// stands: checking candidates, connected over a pair, completed (the
	// pair is final), disconnected (the pair stopped answering), failed
	// (no pair works, or consent to send was lost), closed.
	enum IceConnectionState {
		New,
		Checking,
		Connected,
		Completed,
		Disconnected,
		Failed,
		Closed
	}

	// IceGatheringState is where the collection of this side's candidates
	// stands.
	enum IceGatheringState {
		New,
		Gathering,
		Complete
	}

	// SdpType says what a description is in the offer/answer exchange
	// (RFC 9429 §4.1.8.1): an offer, a final answer, a provisional answer,
	// or the withdrawal of an offer.
	enum SdpType {
		Offer,
		Answer,
		PrAnswer,
		Rollback
	}

	// SignalingState is where the offer/answer exchange stands (RFC 9429
	// §3.2).
	enum SignalingState {
		Stable,
		HaveLocalOffer,
		HaveRemoteOffer,
		HaveLocalPrAnswer,
		HaveRemotePrAnswer,
		Closed
	}

	// PeerConnectionState is where a connection stands as a whole: its
	// ICE path, its DTLS handshake and, with data channels, its SCTP
	// association.
	enum PeerConnectionState {
		New,
		Connecting,
		Connected,
		Disconnected,
		Failed,
		Closed
	}
}
