partial module std.net.webrtc {
	use (
		std.net
		std.net.http
		std.net.rtp
		std.net.sdp
		std.net.webrtc.peer::(nextSignaling)
		std.testing::*
		std.time
	)

	// local is a configuration that gathers on the loopback only.
	internal def onLoopback() Configuration {
		return Configuration{addresses: ["127.0.0.1"], connectTimeout: 10s}
	}

	// trickle hands one side's candidates to the other as they come.
	internal async def trickle(from PeerConnection, to PeerConnection) int {
		let count = 0
		for {
			let failed = false
			let candidate = from.nextCandidate(10s) onerror (err error) {
				failed = true
				recover none
			}
			break when failed || candidate is none
			to.addCandidate(candidate) onerror recover none
			count++
		}
		to.endOfCandidates() onerror recover none
		return count
	}

	// said is the text of a description read back, as it crosses a
	// signalling channel.
	internal def said(description SessionDescription) !SessionDescription {
		return try sdp.parse(description.str())
	}

	// joined is two connections with what `prepare` put on them, the
	// first offering, signalled without trickle and connected.
	internal def joined(caller PeerConnection, callee PeerConnection) !(SessionDescription, SessionDescription) {
		try caller.setLocalDescription(try caller.createOffer())
		try caller.gatheringComplete(5s)
		let offer = caller.localDescription()
		fail "no offer" when offer is none
		try callee.setRemoteDescription(try said(offer))
		try callee.setLocalDescription(try callee.createAnswer())
		try callee.gatheringComplete(5s)
		let answer = callee.localDescription()
		fail "no answer" when answer is none
		try caller.setRemoteDescription(try said(answer))
		try caller.waitConnected(10s)
		try callee.waitConnected(10s)
		return (offer, answer)
	}

	// picture is an encoded video frame of `size` bytes as VP8 marks them:
	// the first bit says whether it is a keyframe.
	internal def picture(size int, keyframe bool, seed int) byte[] {
		let out byte[]
		out.len(size)
		for let i = 1; i < size; i++ {
			out[i] = byte((seed * 13 + i * 5) & 0xFF)
		}
		out[0] = keyframe ?? (byte(0x10), byte(0x11))
		return out
	}

	// Call is two connections with a video track each way, kept for the
	// iterations of the benchmark.
	internal type Call {
		caller PeerConnection
		callee PeerConnection
		out    LocalTrack
		into   RemoteTrack
		count  int            = 0

		def new(caller PeerConnection, callee PeerConnection, out LocalTrack, into RemoteTrack) {
			self.caller = caller
			self.callee = callee
			self.out = out
			self.into = into
		}
	}

	internal let call ?Call = none

	internal def theCall() !Call {
		let kept = call
		return kept unless kept is none
		let caller = new PeerConnection(onLoopback())
		let callee = new PeerConnection(onLoopback())
		let out = try caller.addTrack(new LocalTrack(rtp.PayloadFormat.VP8))
		try joined(caller, callee)
		let made = new Call(caller, callee, out, try callee.acceptTrack(5s))
		call = made
		return made
	}

	// videoFrames sends ten frames of 30 kB and reads them on the other
	// side.
	internal def videoFrames() !none {
		let rig = try theCall()
		for let i = 0; i < 10; i++ {
			let frame = picture(30000, rig.count % 30 == 0, rig.count)
			rig.count++
			try rig.out.writeFrame(frame, 33ms, frame[0] == byte(0x10))
			let got = try rig.into.readFrame(5s)
			fail "a frame of {got.data.len()} bytes arrived" unless got.data.len() == 30000
		}
		return none
	}

	check "WebRTC peer connection" {
		// Simulcast: three encodings of one picture leave as the layers
		// of one media section, named in the offer and taken in the
		// answer; the receiving side gets a track per layer, each with
		// the frames written to that layer and no other; what is not
		// simulcast is refused.
		@test()
		def simulcastLayers() !none {
			let caller = new PeerConnection(onLoopback())
			let callee = new PeerConnection(onLoopback())
			let high = new LocalTrack(rtp.PayloadFormat.VP8, "camera")
			let middle = new LocalTrack(rtp.PayloadFormat.VP8, "camera")
			let low = new LocalTrack(rtp.PayloadFormat.VP8, "camera")
			high.rid = "h"
			low.rid = "l"
			let refused = 0
			for let wrong in [[high], [high, new LocalTrack(rtp.PayloadFormat.Opus)], [high, high]] {
				caller.addSimulcast(wrong) onerror (err error) {
					refused++ when err is WebRtcError
					recover none
				}
			}
			assert refused == 3
			try caller.addSimulcast([high, middle, low], true)
			let (offer, answer) = try joined(caller, callee)
			let offered = offer.str()
			let answered = answer.str()
			assert offer.media.len() == 1 && offered.contains("a=extmap:3 urn:ietf:params:rtp-hdrext:sdes:rtp-stream-id") && offered.contains("a=extmap:4 urn:ietf:params:rtp-hdrext:sdes:repaired-rtp-stream-id")
			assert offered.contains("a=rid:h send") && offered.contains("a=rid:1 send") && offered.contains("a=rid:l send") && offered.contains("a=simulcast:send h;1;l") && !offered.contains("a=ssrc:")
			assert answered.contains("a=rid:h recv") && answered.contains("a=rid:1 recv") && answered.contains("a=rid:l recv") && answered.contains("a=simulcast:recv h;1;l")

			let layers map<string, RemoteTrack>
			for let n = 0; n < 3; n++ {
				let track = try callee.acceptTrack(5s)
				assert track.kind == TrackKind.Video && track.mid == "0" && !layers.hasKey(track.rid)
				layers[track.rid] = track
			}
			assert layers.hasKey("h") && layers.hasKey("1") && layers.hasKey("l")
			for let round = 0; round < 3; round++ {
				let big = picture(9000 + round, round == 0, 10 + round)
				let medium = picture(4000 + round, round == 0, 20 + round)
				let small = picture(1500 + round, round == 0, 30 + round)
				try high.writeFrame(big, 33ms, round == 0)
				try middle.writeFrame(medium, 33ms, round == 0)
				try low.writeFrame(small, 33ms, round == 0)
				assert (try layers["h"].readFrame(5s)).data.equals(big)
				assert (try layers["1"].readFrame(5s)).data.equals(medium)
				assert (try layers["l"].readFrame(5s)).data.equals(small)
			}
			assert high.stats().packets > middle.stats().packets && middle.stats().packets > low.stats().packets && low.stats().packets >= 3
			assert layers["h"].stats().frames == 3 && layers["l"].stats().frames == 3
			assert caller.stats().sending.len() == 3 && callee.stats().receiving.len() == 3
			try caller.close()
			try callee.close()
			return none
		}

		// A peer that takes no simulcast (its answer names no layers) gets
		// the first layer as a plain track.
		@test()
		def simulcastToAPeerWithout() !none {
			let caller = new PeerConnection(onLoopback())
			let callee = new PeerConnection(onLoopback())
			let high = new LocalTrack(rtp.PayloadFormat.VP8)
			let low = new LocalTrack(rtp.PayloadFormat.VP8)
			try caller.addSimulcast([high, low], true)
			try caller.setLocalDescription(try caller.createOffer())
			try caller.gatheringComplete(5s)
			let offer = caller.localDescription()
			fail "no offer" when offer is none
			// What a peer without simulcast sees of the offer: no layers.
			let plain string[]
			for let line in offer.str().split("\r\n") {
				plain.push(line) unless line.startsWith("a=rid:") || line.startsWith("a=simulcast:") || line.contains("rtp-stream-id")
			}
			try callee.setRemoteDescription(try sdp.parse(plain.join("\r\n")), SdpType.Offer)
			try callee.setLocalDescription(try callee.createAnswer())
			try callee.gatheringComplete(5s)
			let answer = callee.localDescription()
			fail "no answer" when answer is none
			assert !answer.str().contains("a=simulcast") && !answer.str().contains("a=rid")
			try caller.setRemoteDescription(try said(answer))
			try caller.waitConnected(10s)
			try callee.waitConnected(10s)
			let seen = try callee.acceptTrack(5s)
			assert seen.rid == ""
			let key = picture(5000, true, 3)
			try high.writeFrame(key, 33ms, true)
			assert (try seen.readFrame(5s)).data.equals(key)
			let unsent = false
			low.writeFrame(key, 33ms, true) onerror (err error) {
				unsent = err is WebRtcError
				recover none
			}
			assert unsent && caller.stats().sending.len() == 1
			try caller.close()
			try callee.close()
			return none
		}

		// Sound beside paced pictures: while 55 kB pictures leave paced,
		// every 20 ms sound packet arrives once, in order, with its own
		// timestamp, and none waits behind a picture (each is read within
		// 15 ms of being written).
		@test()
		def soundDoesNotWaitForPictures() !none {
			let caller = new PeerConnection(onLoopback())
			let callee = new PeerConnection(onLoopback())
			let voice = try caller.addTrack(new LocalTrack(rtp.PayloadFormat.Opus))
			let camera = try caller.addTrack(new LocalTrack(rtp.PayloadFormat.VP8, "camera"))
			try joined(caller, callee)
			let first = try callee.acceptTrack(5s)
			let second = try callee.acceptTrack(5s)
			let heard = first.kind == TrackKind.Audio ?? (first, second)
			let worst = 0
			let before = -1
			for let n = 0; n < 50; n++ {
				try camera.writeFrame(picture(55000, n == 0, n), 33ms, n == 0) when n % 2 == 0
				let sound = picture(80, false, n)
				let began = time.monoNs()
				try voice.writeFrame(sound, 20ms)
				let frame = try heard.readFrame(2s)
				let took = int(time.monoNs() - began)
				worst = took when took > worst
				assert frame.data.equals(sound)
				assert frame.timestamp == before + 960 when before >= 0
				before = frame.timestamp
				time.sleep(20ms)
			}
			let stats = heard.stats()
			fail "a sound packet took {worst / 1000000} ms; {stats.packets} packets, {stats.lost} lost" unless worst < 15000000 && stats.packets == 50 && stats.lost == 0
			try caller.close()
			try callee.close()
			return none
		}

		// Every format's offer names each payload type once: the format,
		// its retransmissions, redundant data, repair blocks and FlexFEC
		// each have their own (H.264 once shared 102 with the
		// repair blocks, and no H.264 packet was taken as one).
		@test()
		def payloadTypesAreDistinct() !none {
			for let format in [rtp.PayloadFormat.Opus, rtp.PayloadFormat.VP8, rtp.PayloadFormat.VP9, rtp.PayloadFormat.H264, rtp.PayloadFormat.AV1] {
				for let repair in [true, false] {
					let config = onLoopback()
					config.forwardErrorCorrection = repair
					let caller = new PeerConnection(config)
					try caller.addTrack(new LocalTrack(format, "camera"))
					let offer = try caller.createOffer()
					let seen int[]
					for let map in offer.media[0].rtpMaps() {
						fail "{format}: payload type {map.payloadType} is named twice" when seen.includes(map.payloadType)
						seen.push(map.payloadType)
					}
					assert seen.len() >= 2
					try caller.close()
				}
			}
			return none
		}

		// Congestion control end to end: both descriptions carry the
		// transport-wide extension and its feedback; the receiving side
		// reports arrivals, and within three seconds of video at about
		// 700 kbit/s the probes (repeats of the last packets as
		// retransmissions) have taken the estimate from its start of
		// 300 kbit/s to more than 900 (a loopback path carries anything). A frame of fifty packets
		// leaves paced: it takes longer than the call that queued it.
		@test()
		def estimateFollowsFeedback() !none {
			let caller = new PeerConnection(onLoopback())
			let callee = new PeerConnection(onLoopback())
			let camera = try caller.addTrack(new LocalTrack(rtp.PayloadFormat.VP8, "camera"))
			let (offer, answer) = try joined(caller, callee)
			// ULPFEC inside the stream is offered and taken for video.
			for let said in [offer.str(), answer.str()] {
				assert said.contains("m=video 9 UDP/TLS/RTP/SAVPF 96 97 100 101 102") && said.contains("a=rtpmap:100 red/90000") && said.contains("a=fmtp:101 apt=100") && said.contains("a=rtpmap:102 ulpfec/90000")
			}
			let wide = "a=extmap:2 http://www.ietf.org/id/draft-holmer-rmcat-transport-wide-cc-extensions-01"
			assert offer.str().contains(wide) && answer.str().contains(wide) && offer.str().contains("a=rtcp-fb:96 transport-cc") && answer.str().contains("a=rtcp-fb:96 transport-cc")
			let seen = try callee.acceptTrack(5s)
			assert camera.bitrate() == 300000

			let began = time.monoNs()
			try camera.writeFrame(picture(55000, true, 0), 33ms, true)
			let queued = time.monoNs() - began
			assert (try seen.readFrame(5s)).data.len() == 55000
			let arrived = time.monoNs() - began
			assert arrived > queued && arrived > 100000000

			for let n = 1; n < 90; n++ {
				try camera.writeFrame(picture(2900, false, n), 33ms)
				time.sleep(33ms)
				try seen.readFrame(5s)
			}
			fail "the estimate is {camera.bitrate()} after three seconds" unless camera.bitrate() > 900000 && camera.bitrate() <= 1500000
			try caller.close()
			try callee.close()
			return none
		}

		// Audio and video: the caller offers an Opus and a VP8 track, the
		// callee answers with a VP8 track of its own on the video
		// section. Frames cross both ways whole, with their keyframe
		// flag and growing timestamps; a keyframe request reaches the
		// sending track; a track nothing carries refuses frames.
		@test()
		def tracksBothWays() !none {
			let caller = new PeerConnection(onLoopback())
			let callee = new PeerConnection(onLoopback())
			let voice = try caller.addTrack(new LocalTrack(rtp.PayloadFormat.Opus))
			let camera = try caller.addTrack(new LocalTrack(rtp.PayloadFormat.VP8, "camera"))
			let reply = try callee.addTrack(new LocalTrack(rtp.PayloadFormat.VP8))
			let early = false
			camera.writeFrame(picture(100, true, 0), 33ms, true) onerror (err error) {
				early = err is WebRtcError
				recover none
			}
			assert early && voice.kind == TrackKind.Audio && camera.kind == TrackKind.Video

			let (offer, answer) = try joined(caller, callee)
			let offered = offer.str()
			let answered = answer.str()
			assert offered.contains("m=audio 9 UDP/TLS/RTP/SAVPF 63 111") && offered.contains("a=rtpmap:63 red/48000/2") && offered.contains("a=fmtp:63 111/111") && answered.contains("m=audio 9 UDP/TLS/RTP/SAVPF 63 111") && answered.contains("a=fmtp:63 111/111") && offered.contains("a=rtpmap:111 opus/48000/2") && offered.contains("m=video 9 UDP/TLS/RTP/SAVPF 96") && offered.contains("a=rtpmap:96 VP8/90000") && offered.contains("a=rtcp-fb:96 nack pli") && offered.contains("a=group:BUNDLE 0 1") && offered.contains("a=ssrc:{camera.sender.ssrc} cname:") && offered.contains(" camera") && offered.contains("a=extmap:1 urn:ietf:params:rtp-hdrext:sdes:mid") && offered.contains("m=video 9 UDP/TLS/RTP/SAVPF 96 97") && offered.contains("a=rtpmap:97 rtx/90000") && offered.contains("a=fmtp:97 apt=96") && offered.contains("a=ssrc-group:FID {camera.sender.ssrc} {camera.sender.rtxSsrc}") && answered.contains("a=fmtp:97 apt=96") && answered.contains("a=extmap:1 urn:ietf:params:rtp-hdrext:sdes:mid")
			let audio = answer.media[0]
			let video = answer.media[1]
			assert answer.media.len() == 2 && answer.direction(audio) == sdp.Direction.RecvOnly && answer.direction(video) == sdp.Direction.SendRecv && answered.contains("a=ssrc:{reply.sender.ssrc} cname:")

			let first = try callee.acceptTrack(5s)
			let second = try callee.acceptTrack(5s)
			let heard = first.kind == TrackKind.Audio ?? (first, second)
			let seen = first.kind == TrackKind.Audio ?? (second, first)
			assert heard.format == rtp.PayloadFormat.Opus && heard.mid == "0" && seen.format == rtp.PayloadFormat.VP8 && seen.mid == "1"
			let back = try caller.acceptTrack(5s)
			assert back.kind == TrackKind.Video && back.mid == "1"

			let key = picture(30000, true, 1)
			let delta = picture(2500, false, 2)
			try camera.writeFrame(key, 33ms, true)
			try camera.writeFrame(delta, 33ms)
			let one = try seen.readFrame(5s)
			let two = try seen.readFrame(5s)
			assert one.data.equals(key) && one.keyframe && two.data.equals(delta) && !two.keyframe && two.timestamp - one.timestamp == 2970
			for let i = 0; i < 3; i++ {
				try voice.writeFrame(byte[0x78, byte(i), 3, 4, 5], 20ms)
			}
			for let i = 0; i < 3; i++ {
				let sound = try heard.readFrame(5s)
				assert sound.data.equals(byte[0x78, byte(i), 3, 4, 5])
			}
			try reply.writeFrame(key, 33ms, true)
			assert (try back.readFrame(5s)).data.equals(key)

			let sent = camera.stats()
			let got = seen.stats()
			assert sent.packets == 30 && sent.bytes > 32500 && sent.resent == 0 && sent.bitrate > 0 && sent.bitrate <= 1500000 && got.packets == 30 && got.frames == 2 && got.lost == 0 && got.bytes == sent.bytes
			let whole = caller.stats()
			assert whole.state == PeerConnectionState.Connected && whole.sending.len() == 2 && whole.receiving.len() == 1 && !(whole.localCandidate is none) && !(whole.remoteCandidate is none)
			assert !camera.keyframeRequested() && camera.bitrate() <= 1500000
			seen.requestKeyframe()
			let asked = false
			for let i = 0; i < 300 && !asked; i++ {
				time.sleep(10ms)
				asked = camera.keyframeRequested()
			}
			assert asked && !camera.keyframeRequested()
			camera.limit(200000)
			assert camera.bitrate() <= 200000
			// Closing says goodbye (BYE): the peer's tracks end at once.
			try caller.close()
			let ended = false
			seen.readFrame(3s) onerror (err error) {
				ended = err is WebRtcError
				recover rtp.Frame{data: [], timestamp: 0, keyframe: false, firstSequence: 0, lastSequence: 0}
			}
			assert ended
			try callee.close()
			let after = false
			callee.acceptTrack(1s) onerror (err error) {
				after = err is WebRtcError
				recover seen
			}
			assert after
			return none
		}

		// An ICE restart through `createOffer(true)`: new credentials in
		// the offer and in its answer, a new pair found, frames before and
		// after. Then another peer takes the connection over with an
		// answer of its own (another certificate): the DTLS connection is
		// made anew and frames reach the new peer.
		@test()
		def restartAndTakeover() !none {
			let caller = new PeerConnection(onLoopback())
			let callee = new PeerConnection(onLoopback())
			let camera = try caller.addTrack(new LocalTrack(rtp.PayloadFormat.VP8))
			let (offer, answer) = try joined(caller, callee)
			let seen = try callee.acceptTrack(5s)
			let key = picture(4000, true, 1)
			try camera.writeFrame(key, 33ms, true)
			assert (try seen.readFrame(5s)).data.equals(key)

			let again = try caller.createOffer(true)
			try caller.setLocalDescription(again)
			try callee.setRemoteDescription(try said(again))
			let reply = try callee.createAnswer()
			try callee.setLocalDescription(reply)
			try caller.setRemoteDescription(try said(reply))
			let before = offer.transport(offer.media[0])
			let after = again.transport(again.media[0])
			let theirs = reply.transport(reply.media[0])
			assert before.ufrag != after.ufrag && before.password != after.password && theirs.ufrag != answer.transport(answer.media[0]).ufrag && again.str().contains("a=candidate:")
			for let i = 0; i < 500 && !(caller.iceState() := IceConnectionState.Connected || IceConnectionState.Completed); i++ {
				time.sleep(10ms)
			}
			assert (caller.iceState() := IceConnectionState.Connected || IceConnectionState.Completed) && caller.state() == PeerConnectionState.Connected
			try camera.writeFrame(key, 33ms, true)
			assert (try seen.readFrame(5s)).data.equals(key)

			let other = new PeerConnection(onLoopback())
			let moved = try caller.createOffer(true)
			try caller.setLocalDescription(moved)
			try caller.gatheringComplete(5s)
			try other.setRemoteDescription(try said(moved))
			try other.setLocalDescription(try other.createAnswer())
			try other.gatheringComplete(5s)
			let taken = other.localDescription()
			fail "no answer" when taken is none
			try caller.setRemoteDescription(try said(taken))
			try other.waitConnected(10s)
			let fresh = try other.acceptTrack(5s)
			for let i = 0; i < 500 && caller.state() != PeerConnectionState.Connected; i++ {
				time.sleep(10ms)
			}
			try caller.waitConnected(10s)
			let delivered = false
			for let i = 0; i < 20 && !delivered; i++ {
				try camera.writeFrame(key, 33ms, true)
				let failed = false
				let frame = fresh.readFrame(300ms) onerror (err error) {
					failed = true
					recover rtp.Frame{data: [], timestamp: 0, keyframe: false, firstSequence: 0, lastSequence: 0}
				}
				delivered = !failed && frame.data.equals(key)
			}
			assert delivered
			try caller.close()
			try callee.close()
			try other.close()
			return none
		}

		// WHIP and WHEP over a local HTTP server: a client publishes a
		// track with one POST (a wrong token is refused 401) and the
		// server reads its frames; a viewer asks for a track with one
		// POST and reads the frames the server writes; DELETE of a session
		// closes its connection.
		@test()
		def whipAndWhep() !none {
			let ingest = new WhipServer(onLoopback(), "secret")
			let viewing = new WhepServer([rtp.PayloadFormat.VP8], onLoopback())
			let mux = new http.ServeMux()
			try mux.handle("/whip", ingest)
			try mux.handle("/whip/\{id\}", ingest)
			try mux.handle("/whep", viewing)
			try mux.handle("/whep/\{id\}", viewing)
			let site = new http.Server("127.0.0.1:0", mux)
			try site.start()
			let base = "http://127.0.0.1:{site.address().port}"

			let camera = new LocalTrack(rtp.PayloadFormat.VP8)
			let stranger = new WhipClient(base + "/whip", "wrong")
			let refused = false
			stranger.publish([camera], onLoopback()) onerror (err error) {
				refused = err is WebRtcError && err.message.contains("401")
				recover new PeerConnection()
			}
			assert refused

			let whip = new WhipClient(base + "/whip", "secret")
			let out = try whip.publish([camera], onLoopback())
			let taken = try ingest.accept(5s)
			try out.waitConnected(10s)
			try taken.waitConnected(10s)
			let arriving = try taken.acceptTrack(5s)
			let key = picture(5000, true, 4)
			try camera.writeFrame(key, 33ms, true)
			assert (try arriving.readFrame(5s)).data.equals(key) && whip.session.startsWith(base + "/whip/")
			let offered = out.localDescription()
			assert !(offered is none) && offered.str().contains("a=sendonly")

			let whep = new WhepClient(base + "/whep")
			let playing = try whep.play([rtp.PayloadFormat.VP8], onLoopback())
			let viewer = try viewing.accept(5s)
			try playing.waitConnected(10s)
			try viewer.waitConnected(10s)
			let shown = try playing.acceptTrack(5s)
			assert viewing.writeFrame(0, key, 33ms, true) == 1 && !viewing.keyframeRequested(0)
			assert (try shown.readFrame(5s)).data.equals(key)
			let asked = playing.localDescription()
			assert !(asked is none) && asked.str().contains("a=recvonly")

			try whip.close()
			for let i = 0; i < 400 && taken.state() != PeerConnectionState.Closed; i++ {
				time.sleep(5ms)
			}
			assert taken.state() == PeerConnectionState.Closed && whip.session == ""
			let asking = new PeerConnection(onLoopback())
			try asking.expectTrack(rtp.PayloadFormat.Opus)
			assert (try asking.createOffer()).str().contains("m=audio 9 UDP/TLS/RTP/SAVPF 63 111") && asking.signalingState() == SignalingState.Stable
			try asking.close()
			try whep.close()
			ingest.close()
			viewing.close()
			try site.close()
			return none
		}

		// FlexFEC is offered when asked for and answered by a side that
		// has it: both descriptions name the payload type, the repair
		// window and the repair source.
		@test()
		def forwardErrorCorrectionOffered() !none {
			let guarded = onLoopback()
			guarded.forwardErrorCorrection = true
			let caller = new PeerConnection(guarded)
			let callee = new PeerConnection(onLoopback())
			let camera = try caller.addTrack(new LocalTrack(rtp.PayloadFormat.VP8))
			let (offer, answer) = try joined(caller, callee)
			assert offer.str().contains("m=video 9 UDP/TLS/RTP/SAVPF 96 97 118") && offer.str().contains("a=rtpmap:118 flexfec-03/90000") && offer.str().contains("a=fmtp:118 repair-window=10000000") && offer.str().contains("a=ssrc-group:FEC-FR {camera.sender.ssrc} {camera.sender.fecSsrc}") && answer.str().contains("a=rtpmap:118 flexfec-03/90000")
			let seen = try callee.acceptTrack(5s)
			let key = picture(9000, true, 6)
			try camera.writeFrame(key, 33ms, true)
			assert (try seen.readFrame(5s)).data.equals(key)
			try caller.close()
			try callee.close()
			return none
		}

		// An offer of a browser's shape with codecs this side has none
		// of beside the ones it has: the answer takes VP8 under the
		// offer's payload type, sends on it with a local track, and
		// refuses a section with only unknown codecs.
		@test()
		def codecsOfAnOffer() !none {
			let pc = new PeerConnection(onLoopback())
			let camera = try pc.addTrack(new LocalTrack(rtp.PayloadFormat.VP8))
			let transport = "c=IN IP4 0.0.0.0\r\na=ice-ufrag:abcd\r\na=ice-pwd:aaaaaaaaaaaaaaaaaaaaaaaa\r\na=fingerprint:sha-256 " + "AA:".repeat(31) + "AA\r\na=setup:actpass\r\n"
			let offer = "v=0\r\no=- 1 1 IN IP4 127.0.0.1\r\ns=-\r\nt=0 0\r\na=group:BUNDLE 0 1 2\r\n" + "m=video 9 UDP/TLS/RTP/SAVPF 35 36 100 101 103\r\n" + transport + "a=mid:0\r\na=sendrecv\r\na=rtcp-mux\r\na=rtpmap:35 H265/90000\r\na=rtpmap:36 rtx/90000\r\na=fmtp:36 apt=35\r\na=rtpmap:103 H264/90000\r\na=fmtp:103 packetization-mode=0;profile-level-id=42e01f\r\na=rtpmap:100 VP8/90000\r\na=rtpmap:101 rtx/90000\r\na=fmtp:101 apt=100\r\na=ssrc:777 cname:peer\r\n" + "m=audio 9 UDP/TLS/RTP/SAVPF 9 0\r\n" + transport + "a=mid:1\r\na=sendonly\r\na=rtcp-mux\r\na=rtpmap:9 G722/8000\r\na=rtpmap:0 PCMU/8000\r\n" + "m=audio 9 UDP/TLS/RTP/SAVPF 109\r\n" + transport + "a=mid:2\r\na=sendonly\r\na=rtcp-mux\r\na=rtpmap:109 opus/48000/2\r\n"
			try pc.setRemoteDescription(try sdp.parse(offer))
			let answer = try pc.createAnswer()
			let text = answer.str()
			assert answer.media.len() == 3 && text.contains("m=video 9 UDP/TLS/RTP/SAVPF 100 101") && text.contains("a=rtpmap:100 VP8/90000") && text.contains("a=rtpmap:101 rtx/90000") && text.contains("a=fmtp:101 apt=100") && text.contains("a=ssrc:{camera.sender.ssrc}") && answer.direction(answer.media[0]) == sdp.Direction.SendRecv
			assert text.contains("m=audio 0 UDP/TLS/RTP/SAVPF 9 0") && text.contains("m=audio 9 UDP/TLS/RTP/SAVPF 109") && answer.direction(answer.media[2]) == sdp.Direction.RecvOnly && text.contains("a=group:BUNDLE 0 2")
			try pc.close()
			return none
		}

		// One video frame of 30 kB through two connections on the
		// loopback, ten an iteration over one call kept for the run: cut
		// into 27 packets, each given its header, protected, sent, read,
		// opened, put into the jitter buffer, and the frame handed out.
		@benchmark()
		def BenchVideoFrame() {
			videoFrames() onerror recover none
		}

		// Every description that may be set in every state moves it as
		// RFC 9429 §3.2 says; every other one fails with the invalid
		// state error and nothing else.
		@test()
		def signalingStates() {
			let states = [SignalingState.Stable, SignalingState.HaveLocalOffer, SignalingState.HaveRemoteOffer, SignalingState.HaveLocalPrAnswer, SignalingState.HaveRemotePrAnswer, SignalingState.Closed]
			let kinds = [SdpType.Offer, SdpType.Answer, SdpType.PrAnswer, SdpType.Rollback]
			let allowed = 0
			let refused = 0
			for let state in states {
				for let kind in kinds {
					for let local in [true, false] {
						let invalid = false
						let other = false
						let next = nextSignaling(state, local, kind) onerror (err error) {
							invalid = err is WebRtcError && err.code == "webrtc.invalid-state"
							other = !invalid
							recover SignalingState.Closed
						}
						assert !other
						let want = expected(state, local, kind)
						assert invalid == (want is none)
						if invalid {
							refused++
						} else {
							allowed++
							assert !(want is none) && next == want
						}
					}
				}
			}
			assert allowed == 14 && refused == states.len() * kinds.len() * 2 - 14
		}

		// Two connections on the loopback: an offer with a data channel,
		// the answer, candidates trickled both ways; the channel opens,
		// messages cross both ways, the answering side opens one too, and
		// closing one side closes the other's channels.
		@test()
		def dataChannelsWithTrickle() !none {
			let caller = new PeerConnection(onLoopback())
			let callee = new PeerConnection(onLoopback())
			let chat = try caller.createDataChannel("chat", DataChannelOptions{protocol: "v1"})
			assert chat.state() == DataChannelState.Connecting && chat.id() == -1 && caller.state() == PeerConnectionState.New

			let offer = try caller.createOffer()
			try caller.setLocalDescription(offer)
			assert caller.signalingState() == SignalingState.HaveLocalOffer
			try callee.setRemoteDescription(try said(offer))
			assert callee.signalingState() == SignalingState.HaveRemoteOffer
			let answer = try callee.createAnswer()
			try callee.setLocalDescription(answer)
			try caller.setRemoteDescription(try said(answer))
			assert caller.signalingState() == SignalingState.Stable && callee.signalingState() == SignalingState.Stable
			let there = trickle(caller, callee)
			let back = trickle(callee, caller)

			try caller.waitConnected(10s)
			try callee.waitConnected(10s)
			assert (await there) == 1 && (await back) == 1
			assert caller.state() == PeerConnectionState.Connected && callee.state() == PeerConnectionState.Connected
			assert (caller.iceState() := IceConnectionState.Connected || IceConnectionState.Completed) && caller.iceGatheringState() == IceGatheringState.Complete
			let theirs = caller.remoteDescription()
			assert !(theirs is none) && theirs.media.len() == 1
			try chat.waitOpen(5s)
			let seen = try callee.acceptDataChannel(5s)
			assert seen.label == "chat" && seen.protocol == "v1" && seen.id() == chat.id() && seen.state() == DataChannelState.Open
			// One side is the DTLS client and has the even streams.
			let reply = try callee.createDataChannel("reply")
			let heard = try caller.acceptDataChannel(5s)
			assert heard.label == "reply" && reply.id() % 2 != chat.id() % 2

			try chat.send("hello")
			try chat.send(byte[1, 2, 3])
			let text = try seen.receive(5s)
			let binary = try seen.receive(5s)
			assert text.text && string(text.data) == "hello" && !binary.text && binary.data.equals(byte[1, 2, 3])
			try seen.send("hello yourself")
			assert string((try chat.receive(5s)).data) == "hello yourself"
			let large byte[]
			large.len(100000)
			large[99999] = 7
			try reply.send(large)
			let got = try heard.receive(5s)
			assert got.data.len() == 100000 && got.data[99999] == byte(7)

			try caller.close()
			for let i = 0; i < 600 && seen.state() != DataChannelState.Closed; i++ {
				time.sleep(5ms)
			}
			assert seen.state() == DataChannelState.Closed && caller.state() == PeerConnectionState.Closed && caller.signalingState() == SignalingState.Closed
			try callee.close()
			return none
		}

		// Without trickle: each side waits for its candidates and sends
		// its description with all of them in it.
		@test()
		def descriptionsWithCandidates() !none {
			let caller = new PeerConnection(onLoopback())
			let callee = new PeerConnection(onLoopback())
			let chat = try caller.createDataChannel("chat")
			try caller.setLocalDescription(try caller.createOffer())
			try caller.gatheringComplete(5s)
			let offer = caller.localDescription()
			fail "no local description" when offer is none
			let text = offer.str()
			assert text.contains("m=application 9 UDP/DTLS/SCTP webrtc-datachannel") && text.contains("a=candidate:") && text.contains("a=end-of-candidates") && text.contains("a=setup:actpass") && text.contains("a=sctp-port:5000") && text.contains("a=group:BUNDLE 0") && text.contains("a=fingerprint:sha-256 ")
			try callee.setRemoteDescription(try sdp.parse(text))
			try callee.setLocalDescription(try callee.createAnswer())
			try callee.gatheringComplete(5s)
			let answer = callee.localDescription()
			fail "no answer" when answer is none
			assert answer.str().contains("a=setup:active") && answer.str().contains("a=candidate:")
			try caller.setRemoteDescription(try said(answer))
			try caller.waitConnected(10s)
			try callee.waitConnected(10s)
			try chat.waitOpen(5s)
			try chat.send("no trickle")
			let seen = try callee.acceptDataChannel(5s)
			assert string((try seen.receive(5s)).data) == "no trickle"
			try caller.close()
			try callee.close()
			return none
		}

		// What cannot be done yet fails with the invalid state error: an
		// answer without an offer, candidates before descriptions, a
		// second answer; an offer of audio beside data is answered with
		// the audio taken to receive; a description without credentials
		// is refused.
		@test()
		def refusals() !none {
			let pc = new PeerConnection(onLoopback())
			let invalid = 0
			pc.createAnswer() onerror (err error) {
				invalid++ when err is WebRtcError && err.code == "webrtc.invalid-state"
				recover new sdp.SessionDescription()
			}
			pc.nextCandidate(1s) onerror (err error) {
				invalid++ when err is WebRtcError && err.code == "webrtc.invalid-state"
				recover none
			}
			pc.endOfCandidates() onerror (err error) {
				invalid++ when err is WebRtcError && err.code == "webrtc.invalid-state"
				recover none
			}
			let offer = try pc.createOffer()
			pc.setLocalDescription(offer, SdpType.Answer) onerror (err error) {
				invalid++ when err is WebRtcError && err.code == "webrtc.invalid-state"
				recover none
			}
			assert invalid == 4 && pc.signalingState() == SignalingState.Stable
			try pc.setLocalDescription(offer)
			try pc.setLocalDescription(offer, SdpType.Rollback)
			assert pc.signalingState() == SignalingState.Stable

			let media = "v=0\r\no=- 1 1 IN IP4 127.0.0.1\r\ns=-\r\nt=0 0\r\na=group:BUNDLE 0 1\r\nm=audio 9 UDP/TLS/RTP/SAVPF 111\r\nc=IN IP4 0.0.0.0\r\na=ice-ufrag:abcd\r\na=ice-pwd:aaaaaaaaaaaaaaaaaaaaaaaa\r\na=fingerprint:sha-256 " + "AA:".repeat(31) + "AA\r\na=setup:actpass\r\na=mid:0\r\na=sendrecv\r\na=rtcp-mux\r\na=rtpmap:111 opus/48000/2\r\nm=application 9 UDP/DTLS/SCTP webrtc-datachannel\r\nc=IN IP4 0.0.0.0\r\na=ice-ufrag:abcd\r\na=ice-pwd:aaaaaaaaaaaaaaaaaaaaaaaa\r\na=fingerprint:sha-256 " + "AA:".repeat(31) + "AA\r\na=setup:actpass\r\na=mid:1\r\na=sctp-port:5000\r\n"
			try pc.setRemoteDescription(try sdp.parse(media))
			let answer = (try pc.createAnswer()).str()
			assert answer.contains("m=audio 9 UDP/TLS/RTP/SAVPF 111") && answer.contains("a=recvonly") && answer.contains("m=application 9 UDP/DTLS/SCTP webrtc-datachannel") && answer.contains("a=group:BUNDLE 0 1") && answer.contains("a=mid:1")

			let bare = new PeerConnection(onLoopback())
			let incomplete = false
			bare.setRemoteDescription(try sdp.parse("v=0\r\no=- 1 1 IN IP4 127.0.0.1\r\ns=-\r\nt=0 0\r\nm=application 9 UDP/DTLS/SCTP webrtc-datachannel\r\nc=IN IP4 0.0.0.0\r\na=mid:0\r\n")) onerror (err error) {
				incomplete = err is WebRtcError && err.code != "webrtc.invalid-state"
				recover none
			}
			assert incomplete
			try pc.close()
			try bare.close()
			let closed = false
			pc.createOffer() onerror (err error) {
				closed = err is WebRtcError && err.code == "webrtc.invalid-state"
				recover new sdp.SessionDescription()
			}
			assert closed
			return none
		}
	}

	// expected is the transition table of RFC 9429 §3.2, written apart
	// from the code it checks: the state after a description, none when
	// it may not be set.
	internal def expected(state SignalingState, local bool, kind SdpType) ?SignalingState {
		let stable = SignalingState.Stable
		if state == SignalingState.Stable {
			return SignalingState.HaveLocalOffer when kind == SdpType.Offer && local
			return SignalingState.HaveRemoteOffer when kind == SdpType.Offer && !local
			return none
		}
		if state == SignalingState.HaveLocalOffer {
			return SignalingState.HaveLocalOffer when local && kind == SdpType.Offer
			return stable when local && kind == SdpType.Rollback
			return stable when !local && kind == SdpType.Answer
			return SignalingState.HaveRemotePrAnswer when !local && kind == SdpType.PrAnswer
			return none
		}
		if state == SignalingState.HaveRemoteOffer {
			return SignalingState.HaveRemoteOffer when !local && kind == SdpType.Offer
			return stable when !local && kind == SdpType.Rollback
			return stable when local && kind == SdpType.Answer
			return SignalingState.HaveLocalPrAnswer when local && kind == SdpType.PrAnswer
			return none
		}
		if state == SignalingState.HaveLocalPrAnswer {
			return SignalingState.HaveLocalPrAnswer when local && kind == SdpType.PrAnswer
			return stable when local && kind == SdpType.Answer
			return none
		}
		if state == SignalingState.HaveRemotePrAnswer {
			return SignalingState.HaveRemotePrAnswer when !local && kind == SdpType.PrAnswer
			return stable when !local && kind == SdpType.Answer
			return none
		}
		return none
	}
}
