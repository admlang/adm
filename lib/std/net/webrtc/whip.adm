// WHIP (RFC 9725) and WHEP (draft-ietf-wish-whep): a peer connection set
// up with one HTTP request. The client POSTs its offer as application/sdp
// and gets the answer in the 201 response, whose Location names the
// session; DELETE on it ends the session. WHIP publishes media to a
// server, WHEP plays media from one.
//
//     let whip = new webrtc.WhipClient("https://media.example/whip/room", token)
//     let pc = try whip.publish([audio, video])
//     try pc.waitConnected()
//     try video.writeFrame(frame, 33ms, true)
partial module std.net.webrtc {
	use (
		std.crypto::(UUID)
		std.net
		std.net.http
		std.net.rtp
		std.net.sdp
		std.net.url
		std.net.waiting::(awaitSignal)
		std.time
	)

	internal def whipError(message string) WebRtcError {
		return WebRtcError{message: "webrtc: {message}", code: "webrtc.whip"}
	}

	// exchange POSTs an offer to an endpoint and returns the answer of
	// its 201 response and the session's URL (the Location, resolved
	// against the endpoint). Fails with WebRtcError naming the status of
	// another response or a response without a Location, as the HTTP
	// client and the SDP reader do.
	internal def exchange(client http.Client, endpoint string, token string, offer SessionDescription) !(SessionDescription, string) {
		let request = try http.newRequest(http.Method.POST, endpoint, offer.str())
		request.headers.set("Content-Type", "application/sdp")
		request.headers.set("Accept", "application/sdp")
		request.headers.set("Authorization", "Bearer {token}") unless token == ""
		let response = try client.do(request)
		fail whipError("{endpoint} answered {response.status} to the offer") unless response.status == 201
		let answer = try sdp.parse(try response.text())
		let location = response.header("Location")
		fail whipError("{endpoint} named no session (no Location)") when location == ""
		let base = try url.parse(endpoint)
		return (answer, (try base.resolve(location)).str())
	}

	// endSession DELETEs a session (RFC 9725 §4.2). Fails as the HTTP
	// client does; the status is not looked at.
	internal def endSession(client http.Client, session string, token string) !none {
		let request = try http.newRequest(http.Method.DELETE, session, "")
		request.headers.set("Authorization", "Bearer {token}") unless token == ""
		try client.do(request)
		return none
	}

	// WhipClient publishes tracks to a WHIP endpoint.
	type WhipClient {
		endpoint        string
		// The bearer token the endpoint asks for, "" for none.
		token           string          = ""
		// The connection of the session, none before `publish`.
		connection      ?PeerConnection = none
		// The session's URL, "" before `publish`.
		session         string          = ""
		internal client http.Client

		def new(endpoint string, token string = "") {
			self.endpoint = endpoint
			self.token = token
			client = new http.Client()
		}

		// publish offers the tracks to the endpoint, each to send only,
		// with every candidate in the offer, takes the answer, and returns
		// the connection, which comes up by itself (`waitConnected`).
		// Fails with WebRtcError when the endpoint does not answer 201
		// Created with a Location, as the connection, the HTTP client and
		// the SDP reader do.
		def publish(tracks LocalTrack[], config Configuration = Configuration{}) !PeerConnection {
			let pc = new PeerConnection(config)
			for let track in tracks {
				try pc.addTrack(track, true)
			}
			try pc.setLocalDescription(try pc.createOffer())
			try pc.gatheringComplete(config.connectTimeout)
			let offer = pc.localDescription()
			fail whipError("the connection has no offer") when offer is none
			let (answer, location) = exchange(client, endpoint, token, offer) onerror (err error) {
				pc.close() onerror recover none
				fail err
			}
			try pc.setRemoteDescription(answer)
			connection = pc
			session = location
			return pc
		}

		// close ends the session at the endpoint and closes the
		// connection. Fails as the HTTP client does; the connection is
		// closed either way.
		def close() !none {
			let pc = connection
			if !(pc is none) {
				pc.close() onerror recover none
			}
			return none when session == ""
			let ended = session
			session = ""
			return try endSession(client, ended, token)
		}
	}

	// WhepClient plays tracks from a WHEP endpoint.
	type WhepClient {
		endpoint        string
		token           string          = ""
		connection      ?PeerConnection = none
		session         string          = ""
		internal client http.Client

		def new(endpoint string, token string = "") {
			self.endpoint = endpoint
			self.token = token
			client = new http.Client()
		}

		// play asks the endpoint for a track of each format, to receive
		// only, and returns the connection; the tracks come out of its
		// `acceptTrack`. Fails as `WhipClient.publish` does.
		def play(formats rtp.PayloadFormat[] = [rtp.PayloadFormat.Opus, rtp.PayloadFormat.VP8], config Configuration = Configuration{}) !PeerConnection {
			let pc = new PeerConnection(config)
			for let format in formats {
				try pc.expectTrack(format)
			}
			try pc.setLocalDescription(try pc.createOffer())
			try pc.gatheringComplete(config.connectTimeout)
			let offer = pc.localDescription()
			fail whipError("the connection has no offer") when offer is none
			let (answer, location) = exchange(client, endpoint, token, offer) onerror (err error) {
				pc.close() onerror recover none
				fail err
			}
			try pc.setRemoteDescription(answer)
			connection = pc
			session = location
			return pc
		}

		// close ends the session at the endpoint and closes the
		// connection. Fails as the HTTP client does.
		def close() !none {
			let pc = connection
			if !(pc is none) {
				pc.close() onerror recover none
			}
			return none when session == ""
			let ended = session
			session = ""
			return try endSession(client, ended, token)
		}
	}

	// Sessions is the sessions of a WHIP or WHEP server by the last part
	// of their URL.
	internal type Sessions {
		atomic byID   map<string, PeerConnection>
		atomic fresh  PeerConnection[]            = []
		changed       channel<none>
		atomic closed bool                        = false

		def new() {
			changed = new channel<none>(1)
		}

		atomic def add(id string, pc PeerConnection) {
			byID[id] = pc
			fresh.push(pc)
			changed.offer(none)
		}

		atomic def take(id string) ?PeerConnection {
			let pc = byID.get(id)
			byID.delete(id) unless pc is none
			return pc
		}

		atomic def find(id string) ?PeerConnection {
			return byID.get(id)
		}

		internal atomic def next() !?PeerConnection {
			return fresh.shift() when fresh.len() > 0
			fail whipError("the server is closed") when closed
			return none
		}

		// accept waits for the next session. Fails with NetError
		// (TimedOut), WebRtcError once the server is closed.
		def accept(timeout duration) !PeerConnection {
			let deadline = timeout > 0s ?? (int(time.monoNs()) + int(timeout), 0)
			for {
				let pc = try next()
				return pc unless pc is none
				fail net.errorOf(net.ErrorCode.TimedOut, "accept", "", "no session before the timeout") unless awaitSignal(changed, deadline)
			}
			fail whipError("unreachable")
		}

		atomic def all() PeerConnection[] {
			closed = true
			changed.offer(none)
			return byID.values()
		}
	}

	// serveSession answers the requests of RFC 9725 §4 that WHIP and WHEP
	// share: POST of an offer (`answered` makes the connection and its
	// answer) with 201, the answer and the session's Location; DELETE of a
	// session; OPTIONS; anything else 405. A token, when the server has
	// one, must come as a bearer token.
	internal def serveSession(ctx http.Context, sessions Sessions, token string, answered def (SessionDescription) !(PeerConnection, SessionDescription)) !none {
		if token != "" && ctx.header("Authorization") != "Bearer {token}" {
			ctx.setHeader("WWW-Authenticate", "Bearer")
			return try ctx.error(401)
		}
		let method = ctx.method()
		if method == http.Method.OPTIONS {
			ctx.setHeader("Accept-Post", "application/sdp")
			ctx.setHeader("Allow", "POST, DELETE, OPTIONS")
			return try ctx.noContent()
		}
		let path = ctx.path()
		if method == http.Method.DELETE {
			let pc = sessions.take(path[path.lastIndexOf("/") + 1:])
			return try ctx.error(404) when pc is none
			pc.close() onerror recover none
			return try ctx.noContent(200)
		}
		if method != http.Method.POST {
			ctx.setHeader("Allow", "POST, DELETE, OPTIONS")
			return try ctx.error(405)
		}
		let kind = ctx.header("Content-Type").lower()
		return try ctx.error(415) unless kind.startsWith("application/sdp")
		let offer = sdp.parse(try ctx.text()) onerror (err error) {
			ctx.error(400, err.message) onerror recover none
			fail err
		}
		let (pc, answer) = try answered(offer)
		let id = (new UUID()).str()
		sessions.add(id, pc)
		ctx.setHeader("Content-Type", "application/sdp")
		ctx.setHeader("Location", (path.endsWith("/") ?? (path, path + "/")) + id)
		return try ctx.text(201, answer.str())
	}

	// answerTo makes a connection that answers an offer, with every
	// candidate in the answer; `prepare` puts on it what the answer is to
	// send. Fails as the connection does.
	internal def answerTo(offer SessionDescription, config Configuration, prepare def (PeerConnection) !none) !(PeerConnection, SessionDescription) {
		let pc = new PeerConnection(config)
		try prepare(pc)
		try pc.setRemoteDescription(offer)
		try pc.setLocalDescription(try pc.createAnswer())
		try pc.gatheringComplete(config.connectTimeout)
		let answer = pc.localDescription()
		fail whipError("the connection has no answer") when answer is none
		return (pc, answer)
	}

	// asOffered adds nothing to a connection: the answer only receives.
	internal def asOffered(pc PeerConnection) !none {
		return none
	}

	// WhipServer takes what WHIP clients publish: an http.Handler to put
	// under a path of a server. Each client is a connection out of
	// `accept`, its tracks out of that connection's `acceptTrack`.
	type WhipServer {
		config            Configuration
		// The bearer token clients must send, "" for none.
		token             string        = ""
		internal sessions Sessions

		def new(config Configuration = Configuration{}, token string = "") {
			self.config = config
			self.token = token
			sessions = new Sessions()
		}

		// serve answers one request (http.Handler). Fails as the
		// connection and the response do; a malformed offer is answered
		// 400.
		def serve(ctx http.Context) !none {
			return try serveSession(ctx, sessions, token, (offer SessionDescription) => answerTo(offer, config, (pc PeerConnection) => asOffered(pc)))
		}

		// accept waits for the next publisher; 0s or less waits without
		// end. Fails with NetError (TimedOut), WebRtcError once the server
		// is closed.
		def accept(timeout duration = 30s) !PeerConnection {
			return try sessions.accept(timeout)
		}

		// close closes every session.
		def close() {
			for let pc in sessions.all() {
				pc.close() onerror recover none
			}
		}
	}

	// WhepServer sends tracks to WHEP clients: an http.Handler to put
	// under a path of a server. Every viewer gets tracks of the server's
	// formats; a frame written to the server goes to every viewer.
	type WhepServer {
		config                  Configuration
		token                   string              = ""
		// The formats every viewer is sent, in order.
		formats                 rtp.PayloadFormat[]
		internal sessions       Sessions
		internal atomic viewers LocalTrack[][]      = []

		def new(formats rtp.PayloadFormat[], config Configuration = Configuration{}, token string = "") {
			self.formats = formats
			self.config = config
			self.token = token
			sessions = new Sessions()
		}

		// serve answers one request (http.Handler). Fails as
		// `WhipServer.serve` does.
		def serve(ctx http.Context) !none {
			return try serveSession(ctx, sessions, token, (offer SessionDescription) => answerTo(offer, config, (pc PeerConnection) => admit(pc)))
		}

		// admit puts a track of each format on a viewer's connection.
		internal def admit(pc PeerConnection) !none {
			let tracks LocalTrack[]
			for let format in formats {
				tracks.push(try pc.addTrack(new LocalTrack(format), true))
			}
			keep(tracks)
			return none
		}

		internal atomic def keep(tracks LocalTrack[]) {
			viewers.push(tracks)
		}

		internal atomic def watching() LocalTrack[][] {
			return viewers.clone()
		}

		// accept waits for the next viewer's connection; 0s or less waits
		// without end. Fails with NetError (TimedOut), WebRtcError once
		// the server is closed.
		def accept(timeout duration = 30s) !PeerConnection {
			return try sessions.accept(timeout)
		}

		// writeFrame sends an encoded frame of the format at `index` to
		// every viewer whose connection carries it, and returns how many
		// took it.
		def writeFrame(index int, frame byte[], length duration, keyframe bool = false) int {
			let sent = 0
			for let tracks in watching() {
				let failed = false
				tracks[index].writeFrame(frame, length, keyframe) onerror (err error) {
					failed = true
					recover none
				}
				sent++ unless failed
			}
			return sent
		}

		// keyframeRequested reports whether any viewer asked for a
		// keyframe of the format at `index` since the last call.
		def keyframeRequested(index int) bool {
			let wanted = false
			for let tracks in watching() {
				wanted = true when tracks[index].keyframeRequested()
			}
			return wanted
		}

		// close closes every session.
		def close() {
			for let pc in sessions.all() {
				pc.close() onerror recover none
			}
		}
	}
}
