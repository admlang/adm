partial module std.os {
	use (
		std.services::(Storage)
		std.bytes
		std.time
	)

	enum FileMode {
		Dir        = 0b10000000 00000000 00000000 00000000,
		Append     = 0b01000000 00000000 00000000 00000000,
		Exclusive  = 0b00100000 00000000 00000000 00000000,
		Temporary  = 0b00010000 00000000 00000000 00000000,
		Symlink    = 0b00001000 00000000 00000000 00000000,
		Device     = 0b00000100 00000000 00000000 00000000,
		NamedPipe  = 0b00000010 00000000 00000000 00000000,
		Socket     = 0b00000001 00000000 00000000 00000000,
		Setuid     = 0b00000000 10000000 00000000 00000000,
		Setgid     = 0b00000000 01000000 00000000 00000000,
		CharDevice = 0b00000000 00100000 00000000 00000000,
		Sticky     = 0b00000000 00010000 00000000 00000000,
		Irregular  = 0b00000000 00001000 00000000 00000000,
		Type       = Dir | Symlink | NamedPipe | Socket | Device | CharDevice | Irregular,
		Perm       = 0o777
	}

	struct FileInfo {
		// base name of the file
		name    string
		// length in bytes for regular files; system-dependent for others
		size    int64
		// file mode bits
		mode    FileMode
		// true if file is a directory
		isDir   bool
		// modification time
		modTime time.Time
	}

	struct DirEntry {
		// full path to the entry
		path string
		info FileInfo
	}

	type File {
		internal fd       int // file descriptor
		internal filename string // full path of the file
		internal stats    FileInfo // file information
		internal buf      byte[]

		// File constructor. Shouldn't be called directly by the user. Files are instantiated by the Storage service
		// which provides the file descriptor.
		def new(filename string, fd int) {
			self.fd = fd
			self.filename = filename
			self.stats = Storage.stat(filename) onerror recover FileInfo{}
		}

		// Reports whether the file still holds an open descriptor.
		def isOpen() bool {
			return fd >= 0
		}

		// Closes the descriptor when the last reference to the file is released.
		def dispose() {
			close() onerror recover none
		}

		ext string {
			def get() string {
				return extension(filename)
			}
		}

		// Seeks to the specified offset in the file.
		def seek(offset int64, whence bytes.Whence = bytes.Whence.Start) !int64 {
			return Storage.seek(fd, offset, int(whence))
		}

		// Writes the provided data to the file at the current position.
		def write(data byte[]) !int {
			return Storage.write(fd, data)
		}

		def write<T: Numeric>(val T, endian bytes.Endian = bytes.Endian.Big) !none {
			try self.write(val.bytes(endian))
			return none
		}

		// Writes the provided data to the file at the specified absolute position
		// without changing the current position.
		def writeAt(data byte[], pos int) !int {
			return Storage.writeAt(fd, data, int64(pos))
		}

		// Reads data from the file into the provided buffer starting from the current position.
		// Returns the number of bytes read.
		def read(data byte[]) !int {
			return Storage.read(fd, data)
		}

		def read<T: Numeric>(endian bytes.Endian = bytes.Endian.Big) !T {
			let out T = 0
			buf.len(out.size())
			let got = try self.read(buf)
			return out.fromBytes(buf, endian)
		}

		// Reads data from the file into the provided buffer at the specified absolute position.
		// Returns the number of bytes read.
		def readAt(data byte[], pos int) !int {
			return Storage.readAt(fd, data, int64(pos))
		}

		// Return file information
		def stat() !FileInfo {
			self.stats = try Storage.stat(filename)
			return self.stats
		}

		// Returns true if the file is a directory.
		def isDir() bool {
			return self.stats.isDir
		}

		// Returns the name of file/directory
		def name() string {
			return self.stats.name
		}

		// Truncates the file to the specified size.
		def truncate(size int) !none {
			return Storage.truncate(fd, int64(size))
		}

		// Closes the file.
		// Closes the descriptor. Closing an already closed file does nothing;
		// the error is the one the operating system reports for the close.
		def close() !none {
			return none when fd < 0
			let handle = fd
			fd = -1
			return Storage.close(handle)
		}
	}
}
