partial module std.os {
	// The Unix `st_mode` of a FileMode: file type, set-id and sticky bits, and
	// permissions, as `stat(2)` and the archive formats store them.
	def unixMode(mode FileMode) int {
		let bits = int(mode)
		let out = bits & 0o777
		out |= 0o4000 when bits & int(FileMode.Setuid) != 0
		out |= 0o2000 when bits & int(FileMode.Setgid) != 0
		out |= 0o1000 when bits & int(FileMode.Sticky) != 0
		if bits & int(FileMode.Dir) != 0 {
			out |= 0o040000
		} else if bits & int(FileMode.Symlink) != 0 {
			out |= 0o120000
		} else if bits & int(FileMode.NamedPipe) != 0 {
			out |= 0o010000
		} else if bits & int(FileMode.Socket) != 0 {
			out |= 0o140000
		} else if bits & int(FileMode.CharDevice) != 0 {
			out |= 0o020000
		} else if bits & int(FileMode.Device) != 0 {
			out |= 0o060000
		} else {
			out |= 0o100000
		}
		return out
	}

	// The FileMode of a Unix `st_mode`.
	def fromUnixMode(unix int) FileMode {
		let out = unix & 0o777
		out |= int(FileMode.Setuid) when unix & 0o4000 != 0
		out |= int(FileMode.Setgid) when unix & 0o2000 != 0
		out |= int(FileMode.Sticky) when unix & 0o1000 != 0
		let kind = unix & 0o170000
		switch {
			case kind == 0o040000:
				out |= int(FileMode.Dir)
			case kind == 0o120000:
				out |= int(FileMode.Symlink)
			case kind == 0o010000:
				out |= int(FileMode.NamedPipe)
			case kind == 0o140000:
				out |= int(FileMode.Socket)
			case kind == 0o020000:
				out |= int(FileMode.Device) | int(FileMode.CharDevice)
			case kind == 0o060000:
				out |= int(FileMode.Device)
		}
		return FileMode(out)
	}
}
