partial module std.os {
	use (
		std.bytes::(BinaryReader, Endian, Whence)
		std.services::(Application)
		std.services.storage::(Storage, MapAccess)
		std.services.runtime::(Runtime, ProcessResult)
		std.time
	)

	// The standard input the process started with. Reads block until input
	// arrives; 0 bytes read means the input ended.
	const stdin = new File(0, "stdin")

	// The standard output the process started with; `print` writes here too,
	// and what it buffered is written first.
	const stdout = new File(1, "stdout")

	// The standard error the process started with, unbuffered.
	const stderr = new File(2, "stderr")

	// Returns the per-user folder this application owns, named after `__app_name__`
	// under the platform's data folder, creating it when missing. Same as `Application.home()`.
	def appHome() !string {
		return Application.home()
	}

	// Returns the user's home folder (`HOME`, `USERPROFILE` on Windows). Same as
	// `Storage.homeDir()`.
	//
	// Fails when the environment names none.
	def homeDir() !string {
		return Storage.homeDir()
	}

	// resolve returns the absolute path a path names, in its shortest form:
	// `~` and `~/...` start at the user's home folder, a relative path at
	// the working directory. Same as `Storage.resolve`.
	//
	// ```
	// os.resolve("~/notes.txt") == "/home/ada/notes.txt"
	// os.resolve("../x") == "/work/x"          // in /work/project
	// ```
	//
	// Fails when the path starts with `~` and no home folder is known, or
	// names a package without shipped files.
	def resolve(path string) !string {
		return Storage.resolve(path)
	}

	// Runs a command through the system shell, with `input` as its standard input,
	// and returns what it printed and its exit code. Same as `Runtime.run`, so it
	// needs the `adm.runtime.spawn` permission.
	//
	// Fails when the policy denies it or the process could not be started; a command
	// that exited with an error is reported through the exit code.
	def run(command string, input string = "") !ProcessResult {
		return Runtime.run(command, input)
	}

	// Runs a command and returns what it printed, for the common case where only
	// the output matters. Needs the `adm.runtime.spawn` permission.
	//
	// Fails when the policy denies it, the process could not be started, or the
	// command exited with a code other than 0.
	def output(command string) !string {
		let ran = try Runtime.run(command)
		fail "os: {command} exited with {ran.code}" when ran.code != 0
		return ran.output
	}

	// Convenience helpers.
	// Fails when the file cannot be opened or read.
	def readFile(path string) !byte[] {
		return Storage.readFile(path)
	}

	// writeFile replaces the file at path with data, creating it when missing.
	// Fails when the file cannot be created or written.
	def writeFile(path string, data byte[]) !none {
		return Storage.writeFile(path, data)
	}

	// Open a file for reading or writing.
	// Fails when the file cannot be opened in that mode.
	def open(path string, mode string) !File {
		let fd = try Storage.open(path, mode)
		return new File(path, fd)
	}

	// open opens the file for reading. Fails when it does not exist or cannot be
	// read.
	def open(path string) !File {
		let fd = try Storage.open(path, "r")
		return new File(path, fd)
	}

	// stat returns the file's information. A symbolic link is followed to
	// what it points at; with `followLinks` off the link itself is described,
	// its mode carrying `FileMode.Symlink`. Fails when the path does not exist
	// or cannot be inspected.
	def stat(path string, followLinks bool = true) !FileInfo {
		return Storage.stat(path, followLinks)
	}

	// symlink creates a symbolic link at `link` that holds `target` as written:
	// a relative target is relative to the link's folder, and the target need
	// not exist. Fails when something is at `link` already or the link cannot
	// be created.
	def symlink(target string, link string) !none {
		return Storage.symlink(target, link)
	}

	// freeSpace returns the bytes still free for the program on the disk that
	// holds the path. Fails when the path does not exist or cannot be asked.
	def freeSpace(path string) !int64 {
		return Storage.freeSpace(path)
	}

	// totalSpace returns the size in bytes of the disk that holds the path.
	// Fails when the path does not exist or cannot be asked.
	def totalSpace(path string) !int64 {
		return Storage.totalSpace(path)
	}

	// readLink returns the target the symbolic link at path holds, as written in
	// the link (a relative target is relative to the link's folder). Fails when
	// path is not a link or cannot be read.
	def readLink(path string) !string {
		return Storage.readLink(path)
	}

	// chmod sets the file's permission bits. Fails when the path does not exist or
	// the change is refused.
	def chmod(path string, mode int64) !none {
		return Storage.chmod(path, mode)
	}

	// touch sets the file's modification time; the access time is left as it
	// is. Fails when the path does not exist or the change is refused.
	def touch(path string, modified time.Time) !none {
		return Storage.touch(path, modified)
	}

	// exists reports whether a file or directory is at path. Fails when the path
	// cannot be inspected.
	def exists(path string) !bool {
		return Storage.exists(path)
	}

	// remove deletes the file at path. With `recursive` it deletes whatever is
	// at path: a file, a symbolic link (the link, not what it points at), or a
	// directory with everything in it, and nothing being there is fine.
	// Fails when the path cannot be removed, and without `recursive` when it
	// does not exist or is a directory.
	def remove(path string, recursive bool = false) !none {
		return Storage.remove(path) unless recursive
		let info = Storage.stat(path, false) onerror recover FileInfo{name: ""}
		return none when info.name == "" && !(try Storage.exists(path))
		return removeTree(path)
	}

	// Deletes what is at path, a directory's contents first. A link to a
	// directory is deleted as a link.
	internal def removeTree(path string) !none {
		let info = try Storage.stat(path, false)
		return Storage.remove(path) unless info.isDir
		for let (_, entry) in try Storage.readDir(path) {
			try removeTree(entry.path)
		}
		return Storage.rmdir(path)
	}

	// rename moves the file at oldPath to newPath, replacing what is there. Fails
	// when the source is missing or the move is refused.
	def rename(oldPath string, newPath string) !none {
		return Storage.rename(oldPath, newPath)
	}

	// mkdir creates the directory. With `parents` it creates the missing
	// directories above it too, and the directory being there already is fine.
	// Fails when the directory cannot be created, and without `parents` when
	// it exists already or its parent is missing.
	def mkdir(path string, parents bool = false) !none {
		return Storage.mkdir(path) unless parents
		return none when path == "" || path == "." || path == SEPARATOR
		if try Storage.exists(path) {
			let info = try Storage.stat(path)
			fail "os: {path} exists and is not a directory" unless info.isDir
			return none
		}
		let above = dir(path)
		try mkdir(above, true) when above != path
		Storage.mkdir(path) onerror (err error) {
			// Another task may have created it meanwhile.
			let made = Storage.exists(path) onerror recover false
			fail err unless made
			recover none
		}
		return none
	}

	// rmdir removes an empty directory. Fails when it is missing, not empty or
	// not a directory.
	def rmdir(path string) !none {
		return Storage.rmdir(path)
	}

	// readDir lists a directory's entries, descending depth levels into
	// subdirectories (0 lists the directory alone). Fails when the path is not a
	// readable directory.
	def readDir(path string, depth int = 0) !DirEntry[] {
		return Storage.readDir(path, depth)
	}

	// A file mapped into memory; see Storage.mmap. The pages stay until the
	// mapping is closed, whatever happens to the file's descriptor.
	//
	// Bytes are read by range, through a reader over a window of the mapping,
	// or through a BinaryReader for numbers, strings and varints.
	//
	// Example:
	// ```example
	// let m = try os.mapFile("notes.txt")
	// defer m.close()
	// println(string(try m.read(0, m.length())))
	// let header = m.binary(Endian.Big)
	// let magic = try header.read<uint32>()
	// ```
	type Mapping {
		internal handle int
		internal open   bool = true

		// Mappings come from `mapFile`, which opens the file and maps it before
		// there is anything to construct.
		internal def new(handle int) {
			self.handle = handle
		}

		// The mapped bytes from offset.
		// Fails when the mapping is closed or the range leaves it.
		def read(offset int, length int) !byte[] {
			fail "os: the mapping is closed" unless open
			return Storage.mmapRead(handle, offset, length)
		}

		// Writes into the mapping at offset.
		// Fails when the mapping is closed or read-only, or the range leaves it.
		def write(offset int, data byte[]) !none {
			fail "os: the mapping is closed" unless open
			return Storage.mmapWrite(handle, offset, data)
		}

		// Whether the mapping is still there to read.
		def isOpen() bool {
			return open
		}

		// Bytes the mapping covers, 0 once it is closed.
		def length() int {
			return 0 unless open
			return Storage.mmapLength(handle)
		}

		// Pushes a shared mapping's changes to the file.
		// Fails when the mapping is closed or the file refuses the write.
		def flush() !none {
			fail "os: the mapping is closed" unless open
			return Storage.mmapFlush(handle)
		}

		// Releases the mapping; safe to call twice.
		def close() {
			return unless open
			open = false
			Storage.munmap(handle) onerror recover none
		}

		// Every mapped byte. Fails when the mapping is closed.
		def bytes() !byte[] {
			return read(0, length())
		}

		// A reader over length bytes of the mapping from offset; length 0 reads to
		// the end. Reads past the window report the end of the stream.
		def reader(offset int = 0, length int = 0) MappingReader {
			let end = length > 0 ?? (offset + length, self.length())
			return new MappingReader(self, offset, end)
		}

		// A BinaryReader over a window of the mapping, for numbers in the byte
		// order given, fixed and zero-terminated strings and varints.
		def binary(endian Endian = Endian.Little, offset int = 0, length int = 0) BinaryReader {
			return new BinaryReader(reader(offset, length), endian)
		}

		// Releases the mapping when the last reference to it goes.
		def dispose() {
			close()
		}
	}

	// Reads a window of a Mapping as a stream: io.Reader with a position,
	// readAt for random access and seek to move. Mapping.reader makes one.
	type MappingReader {
		internal mapping  Mapping
		internal start    int
		internal end      int
		internal position int

		internal def new(mapping Mapping, start int, end int) {
			self.mapping = mapping
			self.start = start
			self.end = end
			position = start
		}

		// Bytes left before the window ends.
		def len() int {
			return end - position when position < end
			return 0
		}

		// Bytes the window covers.
		def size() int {
			return end - start
		}

		// Copies the next bytes into buf and returns how many; 0 at the end of the
		// window. Fails when the mapping is closed.
		def read(buf byte[]) !int {
			let n = try readAt(buf, position - start)
			position += n
			return n
		}

		// Copies bytes at offset within the window into buf and returns how many;
		// 0 past its end. Fails when the mapping is closed.
		def readAt(buf byte[], offset int) !int {
			fail "os: the mapping is closed" unless mapping.isOpen()
			return 0 when offset < 0 || start + offset >= end || buf.len() == 0
			let n = buf.len()
			n = end - start - offset when start + offset + n > end
			let data = try mapping.read(start + offset, n)
			for let i = 0; i < n; i++ {
				buf[i] = data[i]
			}
			return n
		}

		// The mapping outlives its readers: a reader borrows it and releases only
		// its own reference, so closing stays the mapping's business.
		def dispose() {
			dispose mapping
		}

		// Moves the position and returns it, relative to the window. Fails when the
		// target is outside the window.
		def seek(offset int, whence Whence = Whence.Start) !int {
			let target = offset
			match whence {
				case Whence.Current: target = position - start + offset
				case Whence.End: target = end - start + offset
				default:
			}
			fail "os: seek outside the mapping's window" when target < 0 || target > end - start
			position = start + target
			return target
		}
	}

	// Opens the file and maps it; Read opens it read-only, the other accesses
	// read-write. The descriptor is closed as soon as the mapping exists, which
	// the mapping does not mind: it keeps the pages.
	//
	// Fails when the file cannot be opened or mapped.
	def mapFile(path string, access MapAccess = MapAccess.Read, offset int = 0, length int = 0) !Mapping {
		let fd = try Storage.open(path, access == MapAccess.Read ?? ("r", "r+"))
		let handle = Storage.mmap(fd, offset, length, access) onerror (err error) {
			Storage.close(fd) onerror recover none
			fail err
		}
		Storage.close(fd) onerror recover none
		return new Mapping(handle)
	}
}
