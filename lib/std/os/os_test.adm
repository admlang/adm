partial module std.os {
	use (
		std.testing
		std.time
		std.services::(MapAccess)
		std.bytes::(Endian, Whence)
	)

	check "os processes" {
		@test()
		def TestRunReturnsResult() !none {
			let ran = try run("printf hi; exit 2")
			assert ran.output == "hi"
			assert ran.code == 2
			return none
		}

		@test()
		def TestOutputFailsOnError() !none {
			assert try output("printf ok") == "ok"
			let failed = false
			output("exit 1") onerror (err error) {
				failed = true
				recover ""
			}
			assert failed
			return none
		}
	}

	check "os mappings" {
		// A scratch path nothing else in the suite uses.
		internal def scratchPath(name string) string {
			return "/tmp/adm-os-map-{name}-{time.now().unixNs()}"
		}

		// A read-only mapping reads the file and refuses to be written to.
		@test()
		def TestMappingReaders() !none {
			let path = scratchPath("readers")
			// magic "ADM!" big-endian, a little-endian u16 of 513, a varint of 300, a name.
			let payload = "ADM!".bytes() + byte[0x01, 0x02] + byte[0xAC, 0x02] + "brio".bytes() + byte[0]
			try writeFile(path, payload)
			let m = try mapFile(path)
			defer m.close()
			try testing.expectEqual(payload.len(), m.length())
			try testing.expectEqual(string(payload), string(try m.bytes()))

			let header = m.binary(Endian.Big)
			try testing.expectEqual(0x41444D21, int(try header.read<uint32>()))
			try testing.expectEqual(513, int(try header.read<uint16>(Endian.Little)))
			try testing.expectEqual(300, int(try header.readUvarint()))
			try testing.expectEqual("brio", try header.readString())

			// A window reader: 4 bytes from offset 8 is the name without its terminator.
			let window = m.reader(8, 4)
			try testing.expectEqual(4, window.size())
			let buf = byte[]
			buf.len(16)
			let n = try window.read(buf)
			try testing.expectEqual(4, n)
			try testing.expectEqual("brio", string(buf[0:4]))
			try testing.expectEqual(0, try window.read(buf))
			let back = try window.seek(-2, Whence.End)
			try testing.expectEqual(2, back)
			try testing.expectEqual(2, try window.read(buf))
			try testing.expectEqual("io", string(buf[0:2]))
			try testing.expectError(window.seek(9))

			m.close()
			try testing.expectError(window.read(buf))
		}

		@test()
		def TestMapFileReads() !none {
			let path = scratchPath("read")
			try writeFile(path, "mapped through os".bytes())

			let m = try mapFile(path)
			assert m.length() == 17
			assert string(try m.read(0, 6)) == "mapped"

			let refused = false
			m.write(0, "x".bytes()) onerror (err error) {
				refused = true
				recover none
			}
			assert refused

			m.close()
			// Closing twice does nothing, and a closed mapping covers no bytes.
			m.close()
			assert m.length() == 0

			let gone = false
			m.read(0, 1) onerror (err error) {
				gone = true
				recover "".bytes()
			}
			assert gone

			remove(path) onerror recover none
			return none
		}

		// A read-write mapping's writes are in the file once flushed.
		@test()
		def TestMapFileWritesThrough() !none {
			let path = scratchPath("write")
			try writeFile(path, "0123456789".bytes())

			let m = try mapFile(path, MapAccess.ReadWrite)
			try m.write(4, "WXYZ".bytes())
			try m.flush()
			m.close()

			assert string(try readFile(path)) == "0123WXYZ89"

			remove(path) onerror recover none
			return none
		}

		// A missing file has nothing to map.
		@test()
		def TestMapFileFailsOnAMissingFile() !none {
			let failed = false
			mapFile(scratchPath("absent")) onerror (err error) {
				failed = true
				recover new Mapping(-1)
			}
			assert failed
			return none
		}
	}
}
