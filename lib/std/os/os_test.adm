partial module std.os {
	use (
		std.testing
		std.time
		std.services.runtime::(Runtime)
		std.services.storage::(MapAccess)
		std.bytes::(Endian, Whence)
	)

	check "os processes" {
		@test()
		def TestRunReturnsResult() !none {
			let ran = try run("printf hi; exit 2")
			assert ran.output == "hi"
			assert ran.code == 2
			return none
		}

		@test()
		def TestOutputFailsOnError() !none {
			assert try output("printf ok") == "ok"
			let failed = false
			output("exit 1") onerror (err error) {
				failed = true
				recover ""
			}
			assert failed
			return none
		}
	}

	check "os mappings" {
		// A scratch path nothing else in the suite uses.
		internal def scratchPath(name string) string {
			return "/tmp/adm-os-map-{name}-{time.now().unixNs()}"
		}

		// A read-only mapping reads the file and refuses to be written to.
		@test()
		def TestMappingReaders() !none {
			let path = scratchPath("readers")
			// magic "ADM!" big-endian, a little-endian u16 of 513, a varint of 300, a name.
			let payload = "ADM!".bytes() + byte[0x01, 0x02] + byte[0xAC, 0x02] + "brio".bytes() + byte[0]
			try writeFile(path, payload)
			let m = try mapFile(path)
			defer m.close()
			try testing.expectEqual(payload.len(), m.length())
			try testing.expectEqual(string(payload), string(try m.bytes()))

			let header = m.binary(Endian.Big)
			try testing.expectEqual(0x41444D21, int(try header.read<uint32>()))
			try testing.expectEqual(513, int(try header.read<uint16>(Endian.Little)))
			try testing.expectEqual(300, int(try header.readUvarint()))
			try testing.expectEqual("brio", try header.readString())

			// A window reader: 4 bytes from offset 8 is the name without its terminator.
			let window = m.reader(8, 4)
			try testing.expectEqual(4, window.size())
			let buf = byte[]
			buf.len(16)
			let n = try window.read(buf)
			try testing.expectEqual(4, n)
			try testing.expectEqual("brio", string(buf[0:4]))
			try testing.expectEqual(0, try window.read(buf))
			let back = try window.seek(-2, Whence.End)
			try testing.expectEqual(2, back)
			try testing.expectEqual(2, try window.read(buf))
			try testing.expectEqual("io", string(buf[0:2]))
			try testing.expectError(window.seek(9))

			m.close()
			try testing.expectError(window.read(buf))
		}

		@test()
		def TestMapFileReads() !none {
			let path = scratchPath("read")
			try writeFile(path, "mapped through os".bytes())

			let m = try mapFile(path)
			assert m.length() == 17
			assert string(try m.read(0, 6)) == "mapped"

			let refused = false
			m.write(0, "x".bytes()) onerror (err error) {
				refused = true
				recover none
			}
			assert refused

			m.close()
			// Closing twice does nothing, and a closed mapping covers no bytes.
			m.close()
			assert m.length() == 0

			let gone = false
			m.read(0, 1) onerror (err error) {
				gone = true
				recover "".bytes()
			}
			assert gone

			remove(path) onerror recover none
			return none
		}

		// A read-write mapping's writes are in the file once flushed.
		@test()
		def TestMapFileWritesThrough() !none {
			let path = scratchPath("write")
			try writeFile(path, "0123456789".bytes())

			let m = try mapFile(path, MapAccess.ReadWrite)
			try m.write(4, "WXYZ".bytes())
			try m.flush()
			m.close()

			assert string(try readFile(path)) == "0123WXYZ89"

			remove(path) onerror recover none
			return none
		}

		// A missing file has nothing to map.
		@test()
		def TestMapFileFailsOnAMissingFile() !none {
			let failed = false
			mapFile(scratchPath("absent")) onerror (err error) {
				failed = true
				recover new Mapping(-1)
			}
			assert failed
			return none
		}
	}

	check "os directories" {
		// Refusals of the operating system reach the caller.
		@test()
		def TestDirectoryRefusalsFail() !none {
			let dir = "/tmp/adm-os-dirs-{time.now().unixNs()}"
			try mkdir(dir)
			try writeFile(dir + "/f.txt", "x".bytes())
			let failures = 0
			mkdir(dir) onerror (err error) {
				failures++
				recover none
			}
			rmdir(dir) onerror (err error) {
				failures++
				recover none
			}
			remove(dir + "/missing") onerror (err error) {
				failures++
				recover none
			}
			rename(dir + "/missing", dir + "/other") onerror (err error) {
				failures++
				recover none
			}
			assert failures == 4
			let stamp = time.fromUnixNs(int64(1700000000123456789))
			try touch(dir + "/f.txt", stamp)
			assert (try stat(dir + "/f.txt")).modTime.unixNs() == stamp.unixNs()
			try chmod(dir + "/f.txt", 0o600)
			assert (int64((try stat(dir + "/f.txt")).mode) & 0o777) == 0o600
			let missing = false
			touch(dir + "/missing", stamp) onerror (err error) {
				missing = true
				recover none
			}
			assert missing
			try remove(dir + "/f.txt")
			try rmdir(dir)
			assert !(try exists(dir))
			return none
		}

		// readLink returns a link's target as written, longer ones too, and
		// fails on a file that is not a link.
		@test()
		def TestReadLink() !none {
			let dir = "/tmp/adm-os-links-{time.now().unixNs()}"
			try mkdir(dir)
			try writeFile(dir + "/f.txt", "x".bytes())
			let long = "segment/".repeat(80) + "end"
			try run("ln -s f.txt {dir}/rel && ln -s {dir}/f.txt {dir}/abs && ln -s {long} {dir}/long")
			assert try readLink(dir + "/rel") == "f.txt"
			assert try readLink(dir + "/abs") == dir + "/f.txt"
			assert try readLink(dir + "/long") == long
			let failures = 0
			readLink(dir + "/f.txt") onerror (err error) {
				failures++
				recover ""
			}
			readLink(dir + "/missing") onerror (err error) {
				failures++
				recover ""
			}
			assert failures == 2
			try run("rm -r {dir}")
			return none
		}

		// mkdir with parents makes the whole path; remove with recursive
		// takes a tree away and deletes a link without following it.
		@test()
		def TestTrees() !none {
			let dir = "/tmp/adm-os-trees-{time.now().unixNs()}"
			let kept = dir + "-kept"
			try mkdir(dir + "/a/b/c", true)
			assert (try stat(dir + "/a/b/c")).isDir
			try mkdir(dir + "/a/b/c", true)
			try mkdir(dir + "/a/b/", true)
			try writeFile(dir + "/a/file.txt", "x".bytes())
			let refused = false
			mkdir(dir + "/a/file.txt/under", true) onerror (err error) {
				refused = true
				recover none
			}
			assert refused
			refused = false
			mkdir(dir + "/a/file.txt", true) onerror (err error) {
				refused = true
				recover none
			}
			assert refused

			try mkdir(kept)
			try writeFile(kept + "/keep.txt", "x".bytes())
			try writeFile(dir + "/a/b/c/deep.txt", "x".bytes())
			try run("ln -s {kept} {dir}/a/outside && ln -s {dir}/nowhere {dir}/a/b/dangling && ln -s {kept}/keep.txt {dir}/a/b/c/file")
			refused = false
			remove(dir) onerror (err error) {
				refused = true
				recover none
			}
			assert refused
			try remove(dir + "/a/b/dangling", true)
			try remove(dir + "/a/b/c/deep.txt", true)
			assert !(try exists(dir + "/a/b/c/deep.txt")) && try exists(dir + "/a/b/c/file")
			try remove(dir, true)
			assert !(try exists(dir))
			assert try exists(kept + "/keep.txt")
			try remove(dir, true)
			try remove(kept, true)
			assert !(try exists(kept))
			return none
		}

		// symlink writes the target as given; stat follows a link unless
		// told not to; readDir marks links and stays out of them.
		@test()
		def TestLinks() !none {
			let dir = "/tmp/adm-os-symlinks-{time.now().unixNs()}"
			try mkdir(dir + "/real/inner", true)
			try writeFile(dir + "/real/f.txt", "hello".bytes())
			try symlink("real", dir + "/dir-link")
			try symlink("real/f.txt", dir + "/file-link")
			try symlink("gone", dir + "/dangling")
			assert try readLink(dir + "/dir-link") == "real"
			let again = false
			symlink("real", dir + "/dir-link") onerror (err error) {
				again = true
				recover none
			}
			assert again

			let followed = try stat(dir + "/file-link")
			assert followed.size == 5 && int(followed.mode) & int(FileMode.Symlink) == 0
			let itself = try stat(dir + "/file-link", false)
			assert int(itself.mode) & int(FileMode.Symlink) != 0 && !itself.isDir
			assert (try stat(dir + "/dir-link")).isDir && !(try stat(dir + "/dir-link", false)).isDir
			assert int((try stat(dir + "/real")).mode) & int(FileMode.Dir) != 0
			assert int((try stat(dir + "/real/f.txt")).mode) & int(FileMode.Type) == 0
			assert stat(dir + "/dangling") is error
			assert int((try stat(dir + "/dangling", false)).mode) & int(FileMode.Symlink) != 0

			let names string[] = []
			for let (_, entry) in try readDir(dir, -1) {
				let linked = int(entry.info.mode) & int(FileMode.Symlink) != 0
				names.push(entry.path[dir.len() + 1:] + (linked ?? ("@", "")) + (entry.info.isDir ?? ("/", "")))
			}
			names.sort(def (a string, b string) bool {
				return a < b
			})
			assert names.join(" ") == "dangling@ dir-link@/ file-link@ real/ real/f.txt real/inner/"
			try remove(dir, true)
			return none
		}

		@test()
		def TestDiskSpace() !none {
			let free = try freeSpace("/tmp")
			let total = try totalSpace("/tmp")
			assert free > int64(0) && total >= free
			assert freeSpace("/nonexistent/adm/path") is error
			return none
		}

		// A watcher reports what happens in a directory and, when
		// recursive, in directories made after it started.
		@test()
		def TestWatch() !none {
			let dir = "/tmp/adm-os-watch-{time.now().unixNs()}"
			try mkdir(dir + "/sub", true)
			let watcher = try watch(dir, recursive = true)
			assert (try watcher.next(20ms)) is none

			try writeFile(dir + "/a.txt", "x".bytes())
			let seen string[] = []
			for {
				let change = try watcher.next(500ms)
				break when change is none
				seen.push("{change.kind.name} {change.path[dir.len():]}")
				break when change.kind == ChangeKind.Written
			}
			assert seen.len() >= 2 && seen[0] == "Created /a.txt" && seen[seen.len() - 1] == "Written /a.txt"
			for !((try watcher.next(100ms)) is none) {}

			try writeFile(dir + "/sub/b.txt", "x".bytes())
			let below = try watcher.next(500ms)
			fail "nothing seen in the watched subdirectory" when below is none
			assert below.kind == ChangeKind.Created && below.path == dir + "/sub/b.txt" && !below.isDir
			for !((try watcher.next(100ms)) is none) {}

			try mkdir(dir + "/late")
			let made = try watcher.next(500ms)
			fail "the new directory was not seen" when made is none
			assert made.kind == ChangeKind.Created && made.isDir && made.path == dir + "/late"
			try writeFile(dir + "/late/c.txt", "x".bytes())
			let inside = try watcher.next(500ms)
			fail "nothing seen in the directory made later" when inside is none
			assert inside.path == dir + "/late/c.txt"
			for !((try watcher.next(100ms)) is none) {}

			try rename(dir + "/a.txt", dir + "/moved.txt")
			let away = try watcher.next(500ms)
			let back = try watcher.next(500ms)
			fail "the rename was not seen" when away is none
			fail "the rename's second half was not seen" when back is none
			assert away.kind == ChangeKind.MovedAway && away.path == dir + "/a.txt"
			assert back.kind == ChangeKind.MovedIn && back.path == dir + "/moved.txt"

			try remove(dir + "/moved.txt")
			let gone = try watcher.next(500ms)
			fail "the removal was not seen" when gone is none
			assert gone.kind == ChangeKind.Removed && gone.path == dir + "/moved.txt"

			try watcher.close()
			assert watcher.next(10ms) is error && watcher.close() is error
			assert watch(dir + "/missing") is error
			try remove(dir, true)
			return none
		}
	}

	check "os home and resolve" {
		@test()
		def TestHomeDir() !none {
			let home = try homeDir()
			assert home != "" && isAbs(home)
			let held = Runtime.getEnv("HOME")
			assert !(held is none) && held == home
			return none
		}

		@test()
		def TestResolve() !none {
			let home = clean(try homeDir())
			let work = Runtime.workingDir()
			assert (try resolve("~")) == home
			assert (try resolve("~/notes/../a.txt")) == home + "/a.txt"
			assert (try resolve("/tmp//x/./y/..")) == "/tmp/x"
			assert (try resolve("a/b")) == clean(work + "/a/b")
			assert (try resolve("")) == clean(work)
			assert (try resolve(".")) == clean(work)
			// Only a leading `~` alone is the home folder.
			assert (try resolve("~other/x")) == clean(work + "/~other/x")
			assert (try resolve("/a/~/b")) == "/a/~/b"
			return none
		}
	}
}
