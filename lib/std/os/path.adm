partial module std.os {
	use std.os.paths::*

	// SEPARATOR is the character between the elements of a path on this
	// platform.
	@os("linux", "darwin", "android", "ios", "wasm")
	const SEPARATOR = "/"
	@os("windows")
	const SEPARATOR = "\\"

	// Extension returns the file name extension used by path.
	def extension(path string) string {
		return "" when path == ""
		for let i = path.len() - 1; i >= 0 && !isSeparator(path[i]); i-- {
			return path[i + 1:] when path[i] == '.'
		}
		return ""
	}

	// Base returns the last element of path.
	def base(path string) string {
		let n = path.len()
		return "" when n <= 0

		// Trim trailing separators.
		let end = n
		for end > 0 {
			let ch = path[end - 1]
			if ch == '/' || ch == '\\' {
				end--
				continue
			}
			break
		}
		if end <= 0 {
			return ""
		}

		for let i = end - 1; i >= 0; i-- {
			let ch = path[i]
			if ch == '/' || ch == '\\' {
				return path[i + 1:end]
			}
		}
		return path[:end]
	}

	// Dir returns all but the last element of path, typically the path's directory.
	def dir(path string) string {
		return "" when path == ""
		let vol = volumeLen(path)
		let end = path.len()
		for end > vol && isSeparator(path[end - 1]) {
			end--
		}
		for let i = end - 1; i >= vol; i-- {
			return path[:i] when isSeparator(path[i])
		}
		return path[:vol]
	}

	// Split splits path immediately following the final slash,
	// separating it into a directory and file name component.
	def split(path string) (string, string) {
		return ("", "") when path == ""
		let vol = volumeLen(path)
		for let i = path.len() - 1; i >= vol; i-- {
			if isSeparator(path[i]) {
				return (path[:i], path[i + 1:])
			}
		}
		return (path[:vol], path[vol:])
	}

	// Join joins path elements into a single path, inserting a slash between elements.
	def join(parts...string) string {
		return "" when parts.len() == 0
		let tmp string[]
		tmp.cap(parts.len())
		for let (_, part) in parts {
			tmp.push(part) when part != ""
		}
		return tmp.join(SEPARATOR)
	}

	// absolute returns the absolute, clean path `path` names from the folder
	// `dir`, as the system reads it: an absolute path as it is, a relative
	// one inside dir; on Windows a path from the root (`\x`) on dir's
	// volume, and a drive-relative one (`C:x`) inside dir when dir is on
	// that drive, else at the drive's root. Unlike `resolve` it reads
	// nothing: no `~`, no working directory, no package paths.
	//
	// ```
	// os.absolute("notes/../a.txt", "/work") == "/work/a.txt"
	// os.absolute("\\x", "C:\\work") == "C:\\x"       // on Windows
	// ```
	def absolute(path string, dir string) string {
		return clean(path) when isAbs(path)
		let vol = volumeLen(path)
		if vol > 0 {
			let same = volumeLen(dir) == vol && dir[:vol].lower() == path[:vol].lower()
			return clean(join(dir, path[vol:])) when same
			return clean(path[:vol] + SEPARATOR + path[vol:])
		}
		return clean(dir[:volumeLen(dir)] + path) when isSeparator(path[0])
		return clean(join(dir, path))
	}

	// IsAbs reports whether the path is absolute: it starts at the root, and
	// on Windows names its volume too (`C:\dir`, `\\server\share\dir`).
	def isAbs(path string) bool {
		let vol = volumeLen(path)
		// A share is absolute by itself; a drive (`C:`) needs its root.
		return true when vol > 2
		return isSeparator(path[vol]) && (vol > 0 || SEPARATOR == "/")
	}

	// clean returns the shortest path naming the same file: repeated
	// separators collapse, `.` elements go, and `..` removes the element
	// before it. A rooted path stays rooted and `..` never climbs above
	// the root; a relative one keeps the `..` it cannot resolve. An empty
	// result is `.`.
	//
	// ```
	// os.clean("/a//b/./c/..") == "/a/b"
	// os.clean("/../x") == "/x"
	// os.clean("a/../../b") == "../b"
	// ```
	def clean(path string) string {
		let vol = path[:volumeLen(path)]
		path = path[vol.len():]
		let rooted = isSeparator(path[0])
		let parts string[] = []
		// `\` is an ordinary character in a POSIX file name.
		let elements = SEPARATOR == "\\" ?? (path.replace("\\", "/"), path)
		for let part in elements.split("/") {
			continue when part := "" || "."
			if part == ".." {
				if parts.len() > 0 && parts[parts.len() - 1] != ".." {
					parts.pop()
				} else if !rooted {
					parts.push(part)
				}
				continue
			}
			parts.push(part)
		}
		let body = parts.join(SEPARATOR)
		return vol + SEPARATOR + body when rooted
		return vol + (body == "" ?? (".", body))
	}
}
