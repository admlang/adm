partial module std.os {
	use std.testing

	check "Path" {
		@test()
		def TestExtension() {
			assert extension("/path/to/file.txt") == "txt"
			assert extension("/path/to/file") == ""
			assert extension("file.txt") == "txt"
			assert extension("file") == ""
			assert extension(".zshrc") == "zshrc"
		}

		@test()
		def TestBase() {
			assert base("/path/to/file.txt") == "file.txt"
			assert base("/path/to/file") == "file"
			assert base("file.txt") == "file.txt"
			assert base("file") == "file"
			assert base(".zshrc") == ".zshrc"
		}

		@test()
		def TestDir() {
			assert dir("/path/to/file.txt") == "/path/to"
			assert dir("/path/to/file") == "/path/to"
			assert dir("file.txt") == ""
			assert dir("file") == ""
			assert dir(".zshrc") == ""
		}

		@test()
		def TestSplit() {
		    let (d1, f1) = split("/path/to/file.txt")
		    assert d1 == "/path/to"
            assert f1 == "file.txt"
            let (d2, f2) = split("/path/to/file")
            assert d2 == "/path/to"
            assert f2 == "file"
            let (d3, f3) = split("file.txt")
            assert d3 == ""
            assert f3 == "file.txt"
            let (d4, f4) = split("file")
            assert d4 == ""
            assert f4 == "file"
            let (d5, f5) = split(".zshrc")
            assert d5 == ""
            assert f5 == ".zshrc"
		}

		@test()
        def TestJoin() {
            assert join("/path/to", "file.txt") == "/path/to/file.txt"
            assert join("/path/to", "file") == "/path/to/file"
            assert join("file.txt", "") == "file.txt"
            assert join("file", "") == "file"
            assert join(".zshrc", "") == ".zshrc"
        }
	}
}
