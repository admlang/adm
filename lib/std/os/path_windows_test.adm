partial module std.os {
	use (
		std.os.paths::*
		std.testing
	)

	check "Windows paths" {
		@test()
		def drivesAndSharesAreVolumes() {
			assert volumeLen("C:\\dir") == 2
			assert volumeLen("c:") == 2
			assert volumeLen("\\\\server\\share\\dir") == 14
			assert volumeLen("//server/share") == 14
			assert volumeLen("\\\\server") == 0
			assert volumeLen("\\dir") == 0
			assert volumeLen("dir") == 0
		}

		@test()
		def absolutePathsNameTheirVolume() {
			assert isAbs("C:\\dir")
			assert isAbs("C:/dir")
			assert isAbs("\\\\server\\share")
			assert isAbs("\\\\server\\share\\dir")
			assert !isAbs("C:dir")
			assert !isAbs("\\dir")
			assert !isAbs("dir")
			assert !isAbs("")
		}

		@test()
		def cleanKeepsTheVolume() {
			assert clean("C:\\a\\..\\b") == "C:\\b"
			assert clean("C:/a//b/./c/..") == "C:\\a\\b"
			assert clean("C:\\..") == "C:\\"
			assert clean("C:") == "C:."
			assert clean("C:a\\..") == "C:."
			assert clean("\\\\server\\share\\a\\..\\b") == "\\\\server\\share\\b"
		}

		@test()
		def absoluteTakesTheVolume() {
			assert absolute("a\\b", "C:\\work") == "C:\\work\\a\\b"
			assert absolute("\\x", "C:\\work") == "C:\\x"
			assert absolute("C:x", "C:\\work") == "C:\\work\\x"
			assert absolute("D:x", "C:\\work") == "D:\\x"
			assert absolute("D:\\y", "C:\\work") == "D:\\y"
			assert absolute("\\x", "\\\\srv\\share\\w") == "\\\\srv\\share\\x"
		}

		@test()
		def bothSeparatorsSplit() {
			assert dir("C:\\dir\\file.txt") == "C:\\dir"
			assert dir("C:\\file.txt") == "C:"
			assert dir("C:file.txt") == "C:"
			assert base("C:\\dir\\file.txt") == "file.txt"
			assert extension("C:\\dir.d\\file") == ""
			let (d, f) = split("C:/dir/file.txt")
			assert d == "C:/dir"
			assert f == "file.txt"
			let (vd, vf) = split("C:file")
			assert vd == "C:"
			assert vf == "file"
		}
	}
}
