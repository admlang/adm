// The parts of a path that differ between systems: the volume a Windows
// path starts with and the separators it reads.
internal partial module std.os.paths {
	use std.os::(SEPARATOR)

	// Whether ch separates the elements of a path: `/`, and on Windows `\`
	// too, which Windows reads the same.
	def isSeparator(ch char) bool {
		return ch == '/' || (SEPARATOR == "\\" && ch == '\\')
	}

	// The length of the volume a Windows path starts with: a drive (`C:`) or
	// a network share (`\\server\share`, either separator); 0 for a path
	// without one, and always 0 elsewhere.
	def volumeLen(path string) int {
		return 0 when SEPARATOR != "\\" || path.len() < 2
		let first = path[0]
		if path[1] == ':' && ((first >= 'a' && first <= 'z') || (first >= 'A' && first <= 'Z')) {
			return 2
		}
		return 0 unless path.len() > 2 && isSeparator(path[0]) && isSeparator(path[1]) && !isSeparator(path[2])
		// The server, a separator, then the share.
		let n = 3
		for n < path.len() && !isSeparator(path[n]) {
			n++
		}
		return 0 when n >= path.len() - 1
		n++
		return 0 when isSeparator(path[n])
		for n < path.len() && !isSeparator(path[n]) {
			n++
		}
		return n
	}
}
