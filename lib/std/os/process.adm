partial module std.os {
	// This program's end of a pipe to a program it started: what it writes
	// reaches the other program's standard input, what it reads is what the
	// other program wrote to its standard output or error. Implements
	// `io.Reader` and `io.Writer`.
	type Pipe {
		internal fd int

		// Wraps the descriptor of a pipe end. Pipes come from `Runtime.start`;
		// user code has no reason to call this.
		def new(fd int) {
			self.fd = fd
		}

		// Reports whether the pipe is still open on this side.
		def isOpen() bool {
			return fd >= 0
		}

		// Reads what the other program wrote into `data`, waiting until there is
		// something. Returns the number of bytes read; 0 means the other program
		// closed its end (it exited, usually).
		// Fails when the pipe is closed on this side.
		def read(data byte[]) !int {
			fail "pipe: closed" when fd < 0
			return __proc_pipe_read(fd, data)
		}

		// Writes all of `data`, waiting while the other program is slow to read.
		// Returns the number of bytes written.
		// Fails when the pipe is closed on this side, or the other program closed
		// its end or exited.
		def write(data byte[]) !int {
			fail "pipe: closed" when fd < 0
			return __proc_pipe_write(fd, data)
		}

		// Closes this side. The other program reads the end of its input once
		// what was written is consumed; a task waiting in `read` or `write` here
		// fails. Closing a closed pipe does nothing.
		def close() !none {
			return none when fd < 0
			let handle = fd
			fd = -1
			return __proc_pipe_close(handle)
		}

		// Closes the pipe when the last reference to it is released.
		def dispose() {
			close() onerror recover none
		}
	}

	// A program started by `Runtime.start`, running beside this one.
	//
	// Example:
	// ```example
	// let sort = try Runtime.start("sort", ["-r"])
	// try sort.input.write("a\nb\n".bytes())
	// try sort.input.close()
	// let buf byte[]
	// buf.len(64)
	// let n = try sort.output.read(buf)
	// println(string(buf[:n]))
	// println(try sort.wait())
	// ```
	type Process {
		internal handle int64
		internal pid    int
		internal exited bool
		internal code   int

		// The program's standard input.
		input  Pipe
		// The program's standard output.
		output Pipe
		// The program's standard error when it was started with `errors`; none
		// when it shares this program's.
		errors ?Pipe

		// Wraps a started program. Processes come from `Runtime.start`; user
		// code has no reason to call this.
		def new(handle int64, pid int, input int, output int, errors int) {
			self.handle = handle
			self.pid = pid
			self.input = new Pipe(input)
			self.output = new Pipe(output)
			self.errors = new Pipe(errors) when errors >= 0
		}

		// Returns the operating system's id of the process.
		def id() int {
			return pid
		}

		// Waits until the program has exited and returns its exit code: 0 for
		// success, 128 + the signal number when a signal ended it. Calling it
		// again returns the same code.
		// Fails when the wait itself is refused by the operating system.
		def wait() !int {
			return code when exited
			let (done, status) = try __proc_wait(handle, -1)
			exited = done
			code = status
			return code
		}

		// Waits at most `timeout` for the program to exit. Returns its exit
		// code, or none when it is still running.
		// Fails when the wait itself is refused by the operating system.
		def wait(timeout duration) !?int {
			return code when exited
			let (done, status) = try __proc_wait(handle, int64(timeout) < 0 ?? (0, int64(timeout)))
			return none unless done
			exited = true
			code = status
			return code
		}

		// Asks the program to stop (SIGTERM); it may clean up first, or ignore
		// the request. Does nothing once it has exited.
		// Fails when the operating system refuses to signal the process.
		def terminate() !none {
			return none when exited
			return __proc_signal(handle, false)
		}

		// Stops the program at once (SIGKILL). Does nothing once it has exited.
		// Fails when the operating system refuses to signal the process.
		def kill() !none {
			return none when exited
			return __proc_signal(handle, true)
		}

		// Closes the pipes when the last reference to the process is released.
		// The program keeps running; one that reads its input sees it end.
		def dispose() {
			input.close() onerror recover none
			output.close() onerror recover none
			if errors is Pipe {
				errors.close() onerror recover none
			}
			__proc_release(handle)
		}
	}
}
