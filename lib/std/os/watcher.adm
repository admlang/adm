partial module std.os {
	use (
		std.services.storage::(Storage)
		std.time
	)

	// ChangeKind is what happened to a watched file or directory entry.
	enum ChangeKind {
		// The entry appeared: created, or linked in.
		Created,
		// The entry is gone.
		Removed,
		// The file's contents were written. One write may be reported more
		// than once: while it is written and when the writer closes it.
		Written,
		// The entry was moved or renamed away; `MovedIn` names where it went
		// when that place is watched too.
		MovedAway,
		// An entry was moved or renamed to this name.
		MovedIn,
		// Permissions, owner or times changed.
		Attributes,
		// Changes came faster than they were read and some were dropped:
		// look at the watched folders again.
		Lost,
	}

	// Change is one change a Watcher saw.
	struct Change {
		// The path of the entry: the watched path joined with the entry's
		// name. Empty for `Lost`.
		path  string
		kind  ChangeKind
		// Whether the entry is a directory.
		isDir bool
	}

	// watch starts watching a file or a directory: the entries of the
	// directory, and with `recursive` those of every directory below it,
	// including directories created later. Close the watcher when done.
	//
	// ```
	// let watcher = try os.watch("config", recursive = true)
	// defer watcher.close()
	// for {
	// 	let change = try watcher.next()
	// 	println("{change.kind.name} {change.path}")
	// }
	// ```
	//
	// Fails when the path does not exist, may not be read, or the operating
	// system cannot watch files (only Linux can today).
	def watch(path string, recursive bool = false) !Watcher {
		let watcher = new Watcher(try Storage.watchOpen(), recursive)
		watcher.add(path) onerror (err error) {
			watcher.close() onerror recover none
			fail err
		}
		return watcher
	}

	// Watcher reports changes under the paths it watches. One task reads
	// from a watcher at a time.
	type Watcher {
		internal handle    int
		internal recursive bool
		// The watched path of each watch number.
		internal watched   map<int, string>
		internal closed    bool

		def new(handle int, recursive bool) {
			self.handle = handle
			self.recursive = recursive
			watched = map<int, string>{}
			closed = false
		}

		// Watches one more file or directory, with the watcher's choice of
		// `recursive`. Fails when the path does not exist or may not be read.
		def add(path string) !none {
			fail "os: the watcher is closed" when closed
			let watch = try Storage.watchAdd(handle, path)
			watched[watch] = path
			return none unless recursive
			let info = try Storage.stat(path, false)
			return none unless info.isDir
			for let (_, entry) in try Storage.readDir(path, -1) {
				continue unless entry.info.isDir && int(entry.info.mode) & int(FileMode.Symlink) == 0
				let below = try Storage.watchAdd(handle, entry.path)
				watched[below] = entry.path
			}
			return none
		}

		// The next change, waiting for one as long as it takes.
		// Fails when the watcher is closed or the operating system refuses.
		def next() !Change {
			for {
				let found = try next(1h)
				return found unless found is none
			}
			fail "os: the watcher is closed"
		}

		// The next change, waiting up to `wait` for one; none when nothing
		// changed in that time.
		// Fails when the watcher is closed or the operating system refuses.
		def next(wait duration) !?Change {
			fail "os: the watcher is closed" when closed
			let until = time.now() + wait
			for {
				let (watch, bits, name) = try Storage.watchNext(handle)
				if watch < 0 && bits & 128 == 0 {
					let left = until - time.now()
					return none when left <= 0s
					let ready = try Storage.wait(handle, left)
					return none unless ready
					continue
				}
				return Change{path: "", kind: ChangeKind.Lost, isDir: false} when bits & 128 != 0
				let dir = watched.get(watch)
				continue when dir is none
				if bits & 256 != 0 {
					watched.delete(watch)
					continue when bits & 63 == 0
				}
				let path = name == "" ?? (dir, join(dir, name))
				let isDir = bits & 64 != 0
				let kind = ChangeKind.Attributes
				if bits & 1 != 0 {
					kind = ChangeKind.Created
				} else if bits & 2 != 0 {
					kind = ChangeKind.Removed
				} else if bits & 4 != 0 {
					kind = ChangeKind.Written
				} else if bits & 8 != 0 {
					kind = ChangeKind.MovedAway
				} else if bits & 16 != 0 {
					kind = ChangeKind.MovedIn
				}
				if recursive && isDir && (kind == ChangeKind.Created || kind == ChangeKind.MovedIn) {
					// A directory that is gone again before it is watched is
					// reported all the same.
					add(path) onerror recover none
				}
				return Change{path: path, kind: kind, isDir: isDir}
			}
			return none
		}

		// Stops watching. Fails when the watcher was closed before.
		def close() !none {
			fail "os: the watcher is closed" when closed
			closed = true
			return Storage.watchClose(handle)
		}
	}
}
