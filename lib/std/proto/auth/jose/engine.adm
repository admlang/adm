internal partial module std.proto.auth.jose.engine {
	use (
		std.proto.auth.jose::*
		std.crypto
		std.crypto::(RSAPublicKey, RSAPrivateKey, RSAPadding, ECDSAPublicKey, ECDSAPrivateKey, Ed25519PublicKey, Ed25519PrivateKey, Ed448PublicKey, Ed448PrivateKey, curve, coordinateSize, constantTimeEqual, rand, ecdh, ecdhKeyPair, x25519, x25519Base, x448, x448Base)
		std.crypto.cipher
		std.crypto.hash::(Hash, digest, hashSize, hmac, pbkdf2, concatKDF)
		std.data.encoding::(Base64, JSON)
		std.data.compress.flate
		std.bytes::(Buffer)
	)

	// joseError builds the payload for a failure of the given kind.
	def joseError(kind JoseErrorKind, text string) error {
		return JoseError{message: "jose: " + text, code: kind.name, kind: kind}
	}

	// Encoding -----------------------------------------------------------

	// b64 is unpadded base64url (RFC 7515 §2).
	def b64(data byte[]) string {
		let codec = new Base64()
		codec.padded = false
		codec.urlSafe = true
		return codec.encode(data)
	}

	// unb64 reads unpadded base64url, refusing padding, other characters and
	// a final character with bits set past the data, so each value has one
	// encoding. Fails with Malformed naming `what`.
	def unb64(text string, what string) !byte[] {
		let bytes = text.bytes()
		for let b in bytes {
			let ok = (b >= byte(65) && b <= byte(90)) || (b >= byte(97) && b <= byte(122)) || (b >= byte(48) && b <= byte(57)) || b == byte(45) || b == byte(95)
			fail joseError(JoseErrorKind.Malformed, "{what} is not base64url") unless ok
		}
		fail joseError(JoseErrorKind.Malformed, "{what} is not base64url") when bytes.len() % 4 == 1
		let codec = new Base64()
		codec.padded = false
		codec.urlSafe = true
		let out = codec.decode(text) onerror fail joseError(JoseErrorKind.Malformed, "{what} is not base64url")
		fail joseError(JoseErrorKind.Malformed, "{what} is not canonical base64url") unless b64(out) == text
		return out
	}

	// unb64std reads standard padded base64, as `x5c` carries certificates.
	def unb64std(text string, what string) !byte[] {
		return new Base64().decode(text) onerror fail joseError(JoseErrorKind.Malformed, "{what} is not base64")
	}

	def b64std(data byte[]) string {
		return new Base64().encode(data)
	}

	// JSON members -------------------------------------------------------

	// parseObject reads a JSON object. Fails with Malformed when the text is
	// not JSON, not an object, or repeats a member name (RFC 7515 §5.2).
	def parseObject(text string, what string) !map<string, any> {
		let doc = new JSON().parse(text) onerror fail joseError(JoseErrorKind.Malformed, "{what} is not JSON")
		match doc {
			case map<string, any>:
				fail joseError(JoseErrorKind.Malformed, "{what} repeats a member name") when hasDuplicateKey(text)
				return doc
			default:
				fail joseError(JoseErrorKind.Malformed, "{what} is not a JSON object")
		}
	}

	// hasDuplicateKey reports whether any object in the document names a
	// member twice; `parse` keeps the last, which a JOSE reader must refuse.
	def hasDuplicateKey(text string) bool {
		let data = text.bytes()
		let stack map<string, bool>[] = []
		let i = 0
		let expectKey = false
		for i < data.len() {
			let b = data[i]
			if b == byte(123) {
				stack.push(new map<string, bool>())
				expectKey = true
				i++
				continue
			}
			if b == byte(125) {
				stack.len(stack.len() - 1) when stack.len() > 0
				expectKey = false
				i++
				continue
			}
			if b == byte(91) || b == byte(93) {
				expectKey = false
				i++
				continue
			}
			if b == byte(44) {
				// After a comma inside an object comes a key; inside an array a value.
				expectKey = stack.len() > 0 && insideObject(data, i)
				i++
				continue
			}
			if b == byte(34) {
				let start = i + 1
				i++
				for i < data.len() && data[i] != byte(34) {
					i += data[i] == byte(92) ?? (2, 1)
				}
				if expectKey && stack.len() > 0 {
					let key = string(data[start:i])
					let seen = stack[stack.len() - 1]
					return true when seen.hasKey(key)
					seen.set(key, true)
					expectKey = false
				}
				i++
				continue
			}
			i++
		}
		return false
	}

	// insideObject reports whether the comma at `at` separates members of
	// an object rather than elements of an array: the nearest unclosed
	// bracket before it is `{`.
	def insideObject(data byte[], at int) bool {
		let depth = 0
		let inString = false
		// Strings are scanned forwards to know where they are.
		let opens int[] = []
		let i = 0
		for i < at {
			let b = data[i]
			if inString {
				if b == byte(92) {
					i += 2
					continue
				}
				inString = b != byte(34)
				i++
				continue
			}
			if b == byte(34) {
				inString = true
			} else if b == byte(123) || b == byte(91) {
				opens.push(int(b))
			} else if (b == byte(125) || b == byte(93)) && opens.len() > 0 {
				opens.len(opens.len() - 1)
			}
			i++
		}
		depth = opens.len()
		return depth > 0 && opens[depth - 1] == 123
	}

	// member is the value of a member. Fails with Malformed when it is
	// missing.
	def member(m map<string, any>, name string) !any {
		let v = m.get(name)
		fail joseError(JoseErrorKind.Malformed, "\"{name}\" is missing") when v is none
		return v
	}

	def textOf(m map<string, any>, name string) !string {
		let v = try member(m, name)
		match v {
			case string:
				return v
			default:
				fail joseError(JoseErrorKind.Malformed, "\"{name}\" must be a string")
		}
	}

	def bytesOf(m map<string, any>, name string) !byte[] {
		return try unb64(try textOf(m, name), "\"{name}\"")
	}

	def intOf(m map<string, any>, name string) !int {
		let v = try member(m, name)
		match v {
			case int:
				return v
			default:
				fail joseError(JoseErrorKind.Malformed, "\"{name}\" must be an integer")
		}
	}

	def boolOf(m map<string, any>, name string) !bool {
		let v = try member(m, name)
		match v {
			case bool:
				return v
			default:
				fail joseError(JoseErrorKind.Malformed, "\"{name}\" must be true or false")
		}
	}

	def stringsOf(m map<string, any>, name string) !string[] {
		let v = try member(m, name)
		match v {
			case any[]:
				let out string[] = []
				for let e in v {
					match e {
						case string:
							out.push(e)
						default:
							fail joseError(JoseErrorKind.Malformed, "\"{name}\" must hold strings")
					}
				}
				return out
			default:
				fail joseError(JoseErrorKind.Malformed, "\"{name}\" must be an array")
		}
	}

	def objectOf(m map<string, any>, name string) !map<string, any> {
		let v = try member(m, name)
		match v {
			case map<string, any>:
				return v
			default:
				fail joseError(JoseErrorKind.Malformed, "\"{name}\" must be an object")
		}
	}

	def encodeJSON(m map<string, any>) string {
		return string(new JSON().encode(m))
	}

	// Algorithms ---------------------------------------------------------

	def signatureAlgorithmOf(name string) ?SignatureAlgorithm {
		for let (i, v) in SignatureAlgorithm.values() {
			return SignatureAlgorithm(i) when v == name
		}
		return none
	}

	def keyAlgorithmOf(name string) ?KeyAlgorithm {
		for let (i, v) in KeyAlgorithm.values() {
			return KeyAlgorithm(i) when v == name
		}
		return none
	}

	def contentEncryptionOf(name string) ?ContentEncryption {
		for let (i, v) in ContentEncryption.values() {
			return ContentEncryption(i) when v == name
		}
		return none
	}

	def curveOf(name string) ?Curve {
		for let (i, v) in Curve.values() {
			return Curve(i) when v == name
		}
		return none
	}

	// The digest of an HMAC, RSA or ECDSA signature algorithm.
	def signatureHash(alg SignatureAlgorithm) Hash {
		match alg {
			case SignatureAlgorithm.HS384, SignatureAlgorithm.RS384, SignatureAlgorithm.PS384, SignatureAlgorithm.ES384:
				return Hash.SHA384
			case SignatureAlgorithm.HS512, SignatureAlgorithm.RS512, SignatureAlgorithm.PS512, SignatureAlgorithm.ES512:
				return Hash.SHA512
			default:
				return Hash.SHA256
		}
	}

	// The curve an ECDSA algorithm requires, none for other algorithms.
	def signatureCurve(alg SignatureAlgorithm) ?Curve {
		match alg {
			case SignatureAlgorithm.ES256:
				return Curve.P256
			case SignatureAlgorithm.ES384:
				return Curve.P384
			case SignatureAlgorithm.ES512:
				return Curve.P521
			case SignatureAlgorithm.ES256K:
				return Curve.Secp256k1
			default:
				return none
		}
	}

	def isHmac(alg SignatureAlgorithm) bool {
		return alg := SignatureAlgorithm.HS256 || SignatureAlgorithm.HS384 || SignatureAlgorithm.HS512
	}

	def isRsaSignature(alg SignatureAlgorithm) bool {
		return alg := SignatureAlgorithm.RS256 || SignatureAlgorithm.RS384 || SignatureAlgorithm.RS512 || SignatureAlgorithm.PS256 || SignatureAlgorithm.PS384 || SignatureAlgorithm.PS512
	}

	def isPss(alg SignatureAlgorithm) bool {
		return alg := SignatureAlgorithm.PS256 || SignatureAlgorithm.PS384 || SignatureAlgorithm.PS512
	}

	// The crypto curve behind a JWK curve; none for the Edwards and
	// Montgomery curves.
	def cryptoCurve(c Curve) ?curve {
		match c {
			case Curve.P256:
				return crypto.p256
			case Curve.P384:
				return crypto.p384
			case Curve.P521:
				return crypto.p521
			case Curve.Secp256k1:
				return crypto.secp256k1
			default:
				return none
		}
	}

	def curveOfCrypto(c curve) Curve {
		return Curve.P384 when c.name == "P-384"
		return Curve.P521 when c.name == "P-521"
		return Curve.Secp256k1 when c.name == "secp256k1"
		return Curve.P256
	}

	// rsaBits is the modulus size of an RSA JWK, 0 for other keys.
	def rsaBits(key Jwk) int {
		let pub = key.public
		match pub {
			case RSAPublicKey:
				return pub.n.bitLen()
			default:
				return 0
		}
	}

	// signatureFits reports whether a key can sign or verify with alg: the
	// right key type, curve and size, and a key `alg` that agrees.
	def signatureFits(alg SignatureAlgorithm, key Jwk, signing bool) bool {
		return false unless absentOr(key.alg, alg.value) && absentOr(key.usage, "sig")
		if key.keyOps.len() > 0 {
			return false unless (signing ?? ("sign", "verify")) in key.keyOps
		}
		return false when signing && !key.isPrivate() && key.kty != KeyType.Oct
		return key.kty == KeyType.Oct && key.secret.len() >= hashSizeOf(signatureHash(alg)) when isHmac(alg)
		return key.kty == KeyType.Rsa && rsaBits(key) >= 2048 when isRsaSignature(alg)
		let c = signatureCurve(alg)
		return key.kty == KeyType.Ec && curveIs(key.curve, [c]) unless (c is none)
		match alg {
			case SignatureAlgorithm.EdDSA:
				return key.kty == KeyType.Okp && curveIs(key.curve, [Curve.Ed25519, Curve.Ed448])
			case SignatureAlgorithm.Ed25519:
				return key.kty == KeyType.Okp && curveIs(key.curve, [Curve.Ed25519])
			case SignatureAlgorithm.Ed448:
				return key.kty == KeyType.Okp && curveIs(key.curve, [Curve.Ed448])
			default:
				return false
		}
	}

	def hashSizeOf(h Hash) int {
		return hashSize(h)
	}

	// absentOr reports whether an optional parameter is unset or holds want.
	def absentOr(v ?string, want string) bool {
		return true when v is none
		return v == want
	}

	// curveIs reports whether an optional curve is set to one of wants.
	def curveIs(v ?Curve, wants Curve[]) bool {
		return false when v is none
		return v in wants
	}

	// signWith signs the JWS signing input. The key must fit the algorithm
	// (signatureFits). Fails when a private operation does.
	def signWith(alg SignatureAlgorithm, key Jwk, input byte[]) !byte[] {
		return [] when alg == SignatureAlgorithm.None
		return hmac(signatureHash(alg), key.secret, input) when isHmac(alg)
		let priv = key.private
		match priv {
			case RSAPrivateKey:
				let h = signatureHash(alg)
				return try priv.signPSS(h, digest(h, input)) when isPss(alg)
				return try priv.signPKCS1v15(h, digest(h, input))
			case ECDSAPrivateKey:
				let (r, s) = try priv.sign(digest(signatureHash(alg), input))
				let size = coordinateSize(priv.curve)
				return (try r.bytes(size)) + (try s.bytes(size))
			case Ed25519PrivateKey:
				return priv.sign(input)
			case Ed448PrivateKey:
				return try priv.sign(input)
			default:
				fail joseError(JoseErrorKind.KeyMismatch, "the key cannot sign with {alg.value}")
		}
	}

	// verifyWith checks a JWS signature with a key that fits the algorithm.
	def verifyWith(alg SignatureAlgorithm, key Jwk, input byte[], signature byte[]) bool {
		return signature.len() == 0 when alg == SignatureAlgorithm.None
		return constantTimeEqual(hmac(signatureHash(alg), key.secret, input), signature) when isHmac(alg)
		let pub = key.public
		match pub {
			case RSAPublicKey:
				let h = signatureHash(alg)
				return pub.verifyPSS(h, digest(h, input), signature, hashSizeOf(h)) when isPss(alg)
				return pub.verifyPKCS1v15(h, digest(h, input), signature)
			case ECDSAPublicKey:
				let size = coordinateSize(pub.curve)
				return false when signature.len() != 2 * size
				let r = parseBigInt(signature[0:size])
				let s = parseBigInt(signature[size:2 * size])
				return pub.verify(digest(signatureHash(alg), input), r, s)
			case Ed25519PublicKey:
				return pub.verify(input, signature)
			case Ed448PublicKey:
				return pub.verify(input, signature)
			default:
				return false
		}
	}

	// Content encryption -------------------------------------------------

	// The content encryption key length for enc.
	def contentKeySize(enc ContentEncryption) int {
		match enc {
			case ContentEncryption.A128CbcHs256:
				return 32
			case ContentEncryption.A192CbcHs384:
				return 48
			case ContentEncryption.A256CbcHs512:
				return 64
			case ContentEncryption.A128Gcm:
				return 16
			case ContentEncryption.A192Gcm:
				return 24
			default:
				return 32
		}
	}

	def isGcm(enc ContentEncryption) bool {
		return enc := ContentEncryption.A128Gcm || ContentEncryption.A192Gcm || ContentEncryption.A256Gcm
	}

	// sealContent encrypts with a fresh IV: (iv, ciphertext, tag). Fails
	// when the key has the wrong length or the random source is unavailable.
	def sealContent(enc ContentEncryption, cek, plaintext, aad byte[]) !(byte[], byte[], byte[]) {
		fail joseError(JoseErrorKind.KeyMismatch, "content key has the wrong length for {enc.value}") when cek.len() != contentKeySize(enc)
		if isGcm(enc) {
			let iv = try rand(12)
			let gcm = try cipher.newGCM(try cipher.newAES(cek))
			let sealed = gcm.seal(iv, plaintext, aad)
			return (iv, sealed[0:sealed.len() - 16], sealed[sealed.len() - 16:sealed.len()])
		}
		let iv = try rand(16)
		let aead = try cipher.newCBCHMAC(cek)
		let sealed = aead.seal(iv, plaintext, aad)
		let tagLen = aead.tagSize()
		return (iv, sealed[0:sealed.len() - tagLen], sealed[sealed.len() - tagLen:sealed.len()])
	}

	// openContent decrypts and authenticates. Fails with DecryptionFailed
	// whatever went wrong.
	def openContent(enc ContentEncryption, cek, iv, ciphertext, tag, aad byte[]) !byte[] {
		let failed = joseError(JoseErrorKind.DecryptionFailed, "decryption failed")
		fail failed when cek.len() != contentKeySize(enc)
		if isGcm(enc) {
			fail failed when iv.len() != 12 || tag.len() != 16
			let gcm = cipher.newGCM(cipher.newAES(cek) onerror fail failed) onerror fail failed
			return gcm.open(iv, ciphertext + tag, aad) onerror fail failed
		}
		let aead = cipher.newCBCHMAC(cek) onerror fail failed
		fail failed when iv.len() != 16 || tag.len() != aead.tagSize()
		return aead.open(iv, ciphertext + tag, aad) onerror fail failed
	}

	// deflate is raw DEFLATE (RFC 1951), the JWE `zip: "DEF"` format.
	def deflate(data byte[]) !byte[] {
		let out = new Buffer()
		let w = new flate.Writer(out, 6)
		try w.write(data)
		try w.close()
		return out.bytes()
	}

	// inflate undoes deflate, refusing output past limit bytes.
	def inflate(data byte[], limit int) !byte[] {
		let r = new flate.Reader(new Buffer(data))
		let out byte[] = []
		let chunk byte[]
		chunk.len(32768)
		for {
			let n = r.read(chunk) onerror fail joseError(JoseErrorKind.DecryptionFailed, "compressed content is corrupt")
			break when n <= 0
			fail joseError(JoseErrorKind.DecryptionFailed, "decompressed content exceeds {limit} bytes") when out.len() + n > limit
			out += chunk[0:n]
		}
		return out
	}

	// Key management -----------------------------------------------------

	// The AES key length a key-wrapping algorithm uses: its KEK for AES-KW
	// and AES-GCMKW, the derived KEK for ECDH-ES and PBES2; 0 for the rest.
	def wrapKeySize(alg KeyAlgorithm) int {
		match alg {
			case KeyAlgorithm.A128Kw, KeyAlgorithm.EcdhEsA128Kw, KeyAlgorithm.A128GcmKw, KeyAlgorithm.Pbes2Hs256A128Kw:
				return 16
			case KeyAlgorithm.A192Kw, KeyAlgorithm.EcdhEsA192Kw, KeyAlgorithm.A192GcmKw, KeyAlgorithm.Pbes2Hs384A192Kw:
				return 24
			case KeyAlgorithm.A256Kw, KeyAlgorithm.EcdhEsA256Kw, KeyAlgorithm.A256GcmKw, KeyAlgorithm.Pbes2Hs512A256Kw:
				return 32
			default:
				return 0
		}
	}

	def isRsaKeyAlgorithm(alg KeyAlgorithm) bool {
		return alg := KeyAlgorithm.Rsa1_5 || KeyAlgorithm.RsaOaep || KeyAlgorithm.RsaOaep256 || KeyAlgorithm.RsaOaep384 || KeyAlgorithm.RsaOaep512
	}

	def isEcdh(alg KeyAlgorithm) bool {
		return alg := KeyAlgorithm.EcdhEs || KeyAlgorithm.EcdhEsA128Kw || KeyAlgorithm.EcdhEsA192Kw || KeyAlgorithm.EcdhEsA256Kw
	}

	def isPbes2(alg KeyAlgorithm) bool {
		return alg := KeyAlgorithm.Pbes2Hs256A128Kw || KeyAlgorithm.Pbes2Hs384A192Kw || KeyAlgorithm.Pbes2Hs512A256Kw
	}

	def isGcmKw(alg KeyAlgorithm) bool {
		return alg := KeyAlgorithm.A128GcmKw || KeyAlgorithm.A192GcmKw || KeyAlgorithm.A256GcmKw
	}

	def isAesKw(alg KeyAlgorithm) bool {
		return alg := KeyAlgorithm.A128Kw || KeyAlgorithm.A192Kw || KeyAlgorithm.A256Kw
	}

	// The OAEP digest of an RSA-OAEP algorithm.
	def oaepHash(alg KeyAlgorithm) Hash {
		return Hash.SHA1 when alg == KeyAlgorithm.RsaOaep
		return Hash.SHA384 when alg == KeyAlgorithm.RsaOaep384
		return Hash.SHA512 when alg == KeyAlgorithm.RsaOaep512
		return Hash.SHA256
	}

	// keyFits reports whether a key can carry a content key with alg for
	// enc, encrypting or decrypting.
	def keyFits(alg KeyAlgorithm, enc ContentEncryption, key Jwk, decrypting bool) bool {
		// A dir key may name the content encryption it is for (RFC 7520 §5.6).
		let named = absentOr(key.alg, alg.value) || (alg == KeyAlgorithm.Direct && absentOr(key.alg, enc.value))
		return false unless named && absentOr(key.usage, "enc")
		if key.keyOps.len() > 0 {
			let op = decrypting ?? ((alg := KeyAlgorithm.Direct || KeyAlgorithm.EcdhEs) ?? ("deriveKey", "unwrapKey"), (alg := KeyAlgorithm.Direct || KeyAlgorithm.EcdhEs) ?? ("deriveKey", "wrapKey"))
			return false unless op in key.keyOps || (alg == KeyAlgorithm.Direct && (decrypting ?? ("decrypt", "encrypt")) in key.keyOps)
		}
		if isRsaKeyAlgorithm(alg) {
			return false unless key.kty == KeyType.Rsa && rsaBits(key) >= 2048
			return !decrypting || key.isPrivate()
		}
		if isEcdh(alg) {
			let ecCurve = key.kty == KeyType.Ec && curveIs(key.curve, [Curve.P256, Curve.P384, Curve.P521])
			let okpCurve = key.kty == KeyType.Okp && curveIs(key.curve, [Curve.X25519, Curve.X448])
			return false unless ecCurve || okpCurve
			return !decrypting || key.isPrivate()
		}
		return false unless key.kty == KeyType.Oct
		return key.secret.len() == contentKeySize(enc) when alg == KeyAlgorithm.Direct
		return key.secret.len() > 0 when isPbes2(alg)
		return key.secret.len() == wrapKeySize(alg)
	}

	// agree runs the ECDH of RFC 7518 §4.6 with the recipient's public key:
	// a fresh ephemeral key on its curve, the shared secret Z, and the
	// ephemeral public JWK for the `epk` header.
	def agreeAsSender(recipient Jwk) !(byte[], Jwk) {
		let crv = recipient.curve
		if curveIs(crv, [Curve.X25519, Curve.X448]) {
			let wide = curveIs(crv, [Curve.X448])
			let scalar = try rand(wide ?? (56, 32))
			let pub = wide ?? (try x448Base(scalar), try x25519Base(scalar))
			let z = wide ?? (try x448(scalar, recipient.agreementPublic), try x25519(scalar, recipient.agreementPublic))
			let epk = new Jwk(wide ?? (Curve.X448, Curve.X25519), pub)
			return (z, epk)
		}
		let pub = recipient.public
		match pub {
			case ECDSAPublicKey:
				let pair = try ecdhKeyPair(pub.curve)
				let z = try ecdh(pub.curve, pair.scalar, pub.point)
				let epk = new Jwk(new ECDSAPublicKey(pub.curve, pair.public))
				return (z, epk)
			default:
				fail joseError(JoseErrorKind.KeyMismatch, "ECDH-ES needs an EC or OKP agreement key")
		}
	}

	// agreeAsRecipient computes Z from the sender's `epk` and our private
	// key. Fails when the curves differ or the point is invalid.
	def agreeAsRecipient(key Jwk, epk Jwk) !byte[] {
		let mine = key.curve
		let theirs = epk.curve
		fail joseError(JoseErrorKind.KeyMismatch, "the key has no curve") when mine is none
		fail joseError(JoseErrorKind.KeyMismatch, "epk is on another curve") unless epk.kty == key.kty && curveIs(theirs, [mine])
		if mine == Curve.X25519 {
			return x25519(key.agreementPrivate, epk.agreementPublic) onerror fail joseError(JoseErrorKind.DecryptionFailed, "bad epk")
		}
		if mine == Curve.X448 {
			return x448(key.agreementPrivate, epk.agreementPublic) onerror fail joseError(JoseErrorKind.DecryptionFailed, "bad epk")
		}
		let priv = key.private
		let peer = epk.public
		match priv {
			case ECDSAPrivateKey:
				match peer {
					case ECDSAPublicKey:
						return ecdh(priv.curve, priv.d, peer.point) onerror fail joseError(JoseErrorKind.DecryptionFailed, "bad epk")
					default:
				}
			default:
		}
		fail joseError(JoseErrorKind.KeyMismatch, "ECDH-ES needs an EC or OKP private key")
	}

	// ecdhKey is the Concat KDF of RFC 7518 §4.6.2: AlgorithmID, PartyUInfo,
	// PartyVInfo each with a 32-bit length, then the key length in bits.
	def ecdhKey(z byte[], algorithmId string, apu, apv byte[], bytes int) !byte[] {
		let id = algorithmId.bytes()
		let other = lengthPrefixed(id) + lengthPrefixed(apu) + lengthPrefixed(apv) + uint32Bytes(bytes * 8)
		return try concatKDF(Hash.SHA256, z, other, bytes)
	}

	// partyInfo is the first of the recipient's and the shared value that
	// is set, else empty.
	def partyInfo(own ?byte[], shared ?byte[]) byte[] {
		return own unless own is none
		return shared unless shared is none
		return []
	}

	def lengthPrefixed(data byte[]) byte[] {
		return uint32Bytes(data.len()) + data
	}

	def uint32Bytes(v int) byte[] {
		return byte[byte((v >> 24) & 0xFF), byte((v >> 16) & 0xFF), byte((v >> 8) & 0xFF), byte(v & 0xFF)]
	}

	// pbes2Key derives the key-encryption key of RFC 7518 §4.8.1.1.
	def pbes2Key(alg KeyAlgorithm, password, p2s byte[], p2c int) byte[] {
		let h = Hash.SHA256
		h = Hash.SHA384 when alg == KeyAlgorithm.Pbes2Hs384A192Kw
		h = Hash.SHA512 when alg == KeyAlgorithm.Pbes2Hs512A256Kw
		let salt = alg.value.bytes() + byte[0] + p2s
		return pbkdf2(h, password, salt, p2c, wrapKeySize(alg))
	}

	// The most PBKDF2 iterations a received `p2c` may ask for.
	const maxPbes2Iterations = 1200000

	// The iterations PBES2 encryption uses when the header sets none.
	const defaultPbes2Iterations = 600000

	// encryptKey produces the content encryption key and what the recipient
	// receives for it (empty for dir and ECDH-ES), filling the per-recipient
	// header with the parameters the algorithm adds (epk, iv/tag, p2s/p2c).
	// `cek` is the shared content key when one exists already (another
	// recipient made it); empty draws or derives one.
	def encryptKey(alg KeyAlgorithm, enc ContentEncryption, key Jwk, header Header, shared Header, cek byte[]) !(byte[], byte[]) {
		let size = contentKeySize(enc)
		if alg == KeyAlgorithm.Direct {
			fail joseError(JoseErrorKind.Malformed, "dir cannot share a content key with other recipients") when cek.len() > 0
			return (key.secret.clone(), byte[])
		}
		if isEcdh(alg) {
			let (z, epk) = try agreeAsSender(key)
			header.epk = epk
			let apu = partyInfo(header.apu, shared.apu)
			let apv = partyInfo(header.apv, shared.apv)
			if alg == KeyAlgorithm.EcdhEs {
				fail joseError(JoseErrorKind.Malformed, "ECDH-ES cannot share a content key with other recipients") when cek.len() > 0
				return (try ecdhKey(z, enc.value, apu, apv, size), byte[])
			}
			let kek = try ecdhKey(z, alg.value, apu, apv, wrapKeySize(alg))
			let content = cek.len() > 0 ?? (cek, try rand(size))
			return (content, try cipher.wrapKey(try cipher.newAES(kek), content))
		}
		let content = cek.len() > 0 ?? (cek, try rand(size))
		if isRsaKeyAlgorithm(alg) {
			let pub = key.public
			match pub {
				case RSAPublicKey:
					return (content, try pub.encrypt(content, RSAPadding.PKCS1v15)) when alg == KeyAlgorithm.Rsa1_5
					return (content, try pub.encrypt(content, RSAPadding.OAEP, oaepHash(alg)))
				default:
					fail joseError(JoseErrorKind.KeyMismatch, "{alg.value} needs an RSA key")
			}
		}
		return (content, try cipher.wrapKey(try cipher.newAES(key.secret), content)) when isAesKw(alg)
		if isGcmKw(alg) {
			let iv = try rand(12)
			let gcm = try cipher.newGCM(try cipher.newAES(key.secret))
			let sealed = gcm.seal(iv, content, [])
			header.iv = iv
			header.tag = sealed[sealed.len() - 16:sealed.len()]
			return (content, sealed[0:sealed.len() - 16])
		}
		// PBES2.
		let givenSalt = header.p2s
		let givenCount = header.p2c
		let salt = givenSalt is none ?? (try rand(16), givenSalt)
		let count = givenCount is none ?? (defaultPbes2Iterations, givenCount)
		fail joseError(JoseErrorKind.Malformed, "p2s must be at least 8 bytes") when salt.len() < 8
		fail joseError(JoseErrorKind.Malformed, "p2c must be at least 1000") when count < 1000
		header.p2s = salt
		header.p2c = count
		let kek = pbes2Key(alg, key.secret, salt, count)
		return (content, try cipher.wrapKey(try cipher.newAES(kek), content))
	}

	// decryptKey recovers the content encryption key from what a recipient
	// received, under the merged header. RSA1_5 never fails: a bad value
	// yields a random key, so the content decryption fails instead and the
	// two cases look alike (RFC 7516 §11.5).
	def decryptKey(alg KeyAlgorithm, enc ContentEncryption, key Jwk, header Header, encryptedKey byte[]) !byte[] {
		let size = contentKeySize(enc)
		let failed = joseError(JoseErrorKind.DecryptionFailed, "decryption failed")
		if alg == KeyAlgorithm.Direct {
			fail failed when encryptedKey.len() != 0
			return key.secret
		}
		if isEcdh(alg) {
			let epk = header.epk
			fail joseError(JoseErrorKind.Malformed, "ECDH-ES needs an epk header") when epk is none
			let z = try agreeAsRecipient(key, epk)
			let apu = partyInfo(header.apu, none)
			let apv = partyInfo(header.apv, none)
			if alg == KeyAlgorithm.EcdhEs {
				fail failed when encryptedKey.len() != 0
				return try ecdhKey(z, enc.value, apu, apv, size)
			}
			let kek = try ecdhKey(z, alg.value, apu, apv, wrapKeySize(alg))
			return cipher.unwrapKey(cipher.newAES(kek) onerror fail failed, encryptedKey) onerror fail failed
		}
		if isRsaKeyAlgorithm(alg) {
			let priv = key.private
			match priv {
				case RSAPrivateKey:
					if alg == KeyAlgorithm.Rsa1_5 {
						let random = try rand(size)
						let cek = priv.decrypt(encryptedKey, RSAPadding.PKCS1v15) onerror recover random
						return cek.len() == size ?? (cek, random)
					}
					return priv.decrypt(encryptedKey, RSAPadding.OAEP, oaepHash(alg)) onerror fail failed
				default:
					fail joseError(JoseErrorKind.KeyMismatch, "{alg.value} needs an RSA private key")
			}
		}
		if isAesKw(alg) {
			return cipher.unwrapKey(cipher.newAES(key.secret) onerror fail failed, encryptedKey) onerror fail failed
		}
		if isGcmKw(alg) {
			let iv = header.iv
			let tag = header.tag
			fail joseError(JoseErrorKind.Malformed, "{alg.value} needs iv and tag headers") when iv is none || tag is none
			let gcm = cipher.newGCM(cipher.newAES(key.secret) onerror fail failed) onerror fail failed
			fail failed when iv.len() != 12 || tag.len() != 16
			return gcm.open(iv, encryptedKey + tag, []) onerror fail failed
		}
		let salt = header.p2s
		let count = header.p2c
		fail joseError(JoseErrorKind.Malformed, "{alg.value} needs p2s and p2c headers") when salt is none || count is none
		fail joseError(JoseErrorKind.Malformed, "p2s must be at least 8 bytes") when salt.len() < 8
		fail joseError(JoseErrorKind.Malformed, "p2c is out of range") when count < 1 || count > maxPbes2Iterations
		let kek = pbes2Key(alg, key.secret, salt, count)
		return cipher.unwrapKey(cipher.newAES(kek) onerror fail failed, encryptedKey) onerror fail failed
	}
}
