partial module std.proto.auth.jose {
	use std.proto.auth.jose.engine::*

	// Header is a JOSE header (RFC 7515 §4, RFC 7516 §4, RFC 7518 §4.6-4.8,
	// RFC 7797): every registered parameter as a field, the rest through
	// get and set. Byte-valued parameters hold the decoded bytes.
	type Header {
		// The algorithm, as its registered name.
		alg            ?string
		enc            ?string
		zip            ?string
		kid            ?string
		typ            ?string
		cty            ?string
		crit           string[]         = []
		// RFC 7797: false signs the payload as it is, not base64url-encoded.
		b64            ?bool
		jku            ?string
		jwk            ?Jwk
		x5u            ?string
		x5c            byte[][]         = []
		x5t            ?byte[]
		x5tS256        ?byte[]
		// ECDH-ES: the sender's ephemeral public key and party information.
		epk            ?Jwk
		apu            ?byte[]
		apv            ?byte[]
		// AES-GCM key wrap: the IV and tag of the wrapped key.
		iv             ?byte[]
		tag            ?byte[]
		// PBES2: the salt input and the iteration count.
		p2s            ?byte[]
		p2c            ?int
		internal extra map<string, any>

		def new() {}

		// get returns a parameter as it appears in JSON (a string, number,
		// bool, array or object; bytes as base64url text); none when the
		// header does not have it.
		def get(name string) ?any {
			let m = headerMembers(self)
			return m.get(name)
		}

		// set sets a parameter from its JSON form, as get returns it; a
		// registered name sets its field. Fails with Malformed when the
		// value does not fit a registered parameter.
		def set(name string, value any) !none {
			let m map<string, any>
			m.set(name, value)
			try applyMember(self, m, name)
			return none
		}

		// names lists the parameters the header carries.
		def names() string[] {
			return headerMembers(self).keys()
		}

		// json renders the header as a JSON object.
		def json() string {
			return encodeJSON(headerMembers(self))
		}
	}

	// The header as JSON values, registered parameters first.
	internal def headerMembers(h Header) map<string, any> {
		let m map<string, any>
		let algValue = h.alg
		m.set("alg", algValue) unless algValue is none
		let encValue = h.enc
		m.set("enc", encValue) unless encValue is none
		let zipValue = h.zip
		m.set("zip", zipValue) unless zipValue is none
		let kidValue = h.kid
		m.set("kid", kidValue) unless kidValue is none
		let typValue = h.typ
		m.set("typ", typValue) unless typValue is none
		let ctyValue = h.cty
		m.set("cty", ctyValue) unless ctyValue is none
		let b64Value = h.b64
		m.set("b64", b64Value) unless b64Value is none
		if h.crit.len() > 0 {
			let list any[] = []
			for let c in h.crit {
				list.push(c)
			}
			m.set("crit", list)
		}
		let jkuValue = h.jku
		m.set("jku", jkuValue) unless jkuValue is none
		let key = h.jwk
		m.set("jwk", jwkObject(key, false)) unless key is none
		let x5uValue = h.x5u
		m.set("x5u", x5uValue) unless x5uValue is none
		if h.x5c.len() > 0 {
			let list any[] = []
			for let c in h.x5c {
				list.push(b64std(c))
			}
			m.set("x5c", list)
		}
		let t = h.x5t
		m.set("x5t", b64(t)) unless t is none
		let t256 = h.x5tS256
		m.set("x5t#S256", b64(t256)) unless t256 is none
		let e = h.epk
		m.set("epk", jwkObject(e, false)) unless e is none
		let u = h.apu
		m.set("apu", b64(u)) unless u is none
		let v = h.apv
		m.set("apv", b64(v)) unless v is none
		let i = h.iv
		m.set("iv", b64(i)) unless i is none
		let g = h.tag
		m.set("tag", b64(g)) unless g is none
		let s = h.p2s
		m.set("p2s", b64(s)) unless s is none
		let p2cValue = h.p2c
		m.set("p2c", p2cValue) unless p2cValue is none
		for let (name, nameValue) in h.extra {
			m.set(name, nameValue) unless m.hasKey(name)
		}
		return m
	}

	// parseHeader reads a header object. Fails with Malformed when a
	// registered parameter has the wrong type or encoding.
	internal def parseHeader(m map<string, any>) !Header {
		let h = new Header()
		for let name in m.keys() {
			try applyMember(h, m, name)
		}
		return h
	}

	// headerFromText reads a header from its JSON text.
	internal def headerFromText(text string, what string) !Header {
		return try parseHeader(try parseObject(text, what))
	}

	// applyMember stores one member of m in the header.
	internal def applyMember(h Header, m map<string, any>, name string) !none {
		match name {
			case "alg":
				h.alg = try textOf(m, name)
			case "enc":
				h.enc = try textOf(m, name)
			case "zip":
				h.zip = try textOf(m, name)
			case "kid":
				h.kid = try textOf(m, name)
			case "typ":
				h.typ = try textOf(m, name)
			case "cty":
				h.cty = try textOf(m, name)
			case "crit":
				h.crit = try stringsOf(m, name)
				fail joseError(JoseErrorKind.Malformed, "\"crit\" must not be empty") when h.crit.len() == 0
			case "b64":
				h.b64 = try boolOf(m, name)
			case "jku":
				h.jku = try textOf(m, name)
			case "jwk":
				h.jwk = try jwkFromMembers(try objectOf(m, name))
			case "x5u":
				h.x5u = try textOf(m, name)
			case "x5c":
				h.x5c = []
				for let c in try stringsOf(m, name) {
					h.x5c.push(try unb64std(c, "\"x5c\""))
				}
			case "x5t":
				h.x5t = try bytesOf(m, name)
			case "x5t#S256":
				h.x5tS256 = try bytesOf(m, name)
			case "epk":
				h.epk = try jwkFromMembers(try objectOf(m, name))
			case "apu":
				h.apu = try bytesOf(m, name)
			case "apv":
				h.apv = try bytesOf(m, name)
			case "iv":
				h.iv = try bytesOf(m, name)
			case "tag":
				h.tag = try bytesOf(m, name)
			case "p2s":
				h.p2s = try bytesOf(m, name)
			case "p2c":
				h.p2c = try intOf(m, name)
			default:
				h.extra.set(name, try member(m, name))
		}
		return none
	}

	// mergeHeaders combines headers whose parameter names must not overlap
	// (RFC 7515 §7.2.1, RFC 7516 §7.2.1). Fails with Malformed when they
	// do.
	internal def mergeHeaders(parts Header[]) !Header {
		let all map<string, any>
		for let part in parts {
			let m = headerMembers(part)
			for let name in m.keys() {
				fail joseError(JoseErrorKind.Malformed, "header parameter \"{name}\" appears twice") when all.hasKey(name)
				all.set(name, m[name]) when m.hasKey(name)
			}
		}
		return try parseHeader(all)
	}

	// checkCritical enforces `crit` (RFC 7515 §4.1.11): only in the
	// protected header, no registered names, each named parameter present,
	// each one understood. Fails with Malformed or CriticalUnknown.
	internal def checkCritical(protected Header, merged Header, understood string[]) !none {
		let crit = merged.crit
		return none when crit.len() == 0
		fail joseError(JoseErrorKind.Malformed, "\"crit\" must be in the protected header") when protected.crit.len() == 0
		let registered = ["alg", "enc", "zip", "jku", "jwk", "kid", "x5u", "x5c", "x5t", "x5t#S256", "typ", "cty", "crit", "epk", "apu", "apv", "iv", "tag", "p2s", "p2c"]
		let present = merged.names()
		for let name in crit {
			fail joseError(JoseErrorKind.Malformed, "\"crit\" names registered parameter \"{name}\"") when name in registered
			fail joseError(JoseErrorKind.Malformed, "\"crit\" names \"{name}\", which the header lacks") unless name in present
			fail joseError(JoseErrorKind.CriticalUnknown, "critical extension \"{name}\" is not supported") unless name in understood
		}
		return none
	}
}
