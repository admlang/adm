// JSON Object Signing and Encryption: signed (JWS, RFC 7515) and encrypted
// (JWE, RFC 7516) objects, JSON Web Keys (RFC 7517), the algorithms of RFC
// 7518, RFC 8037, RFC 8812 and RFC 9864, and JSON Web Tokens (RFC 7519)
// with the checks of RFC 8725.
//
// Verification always takes the list of algorithms the caller accepts, and
// never trusts a key that a header names (`jwk`, `jku`, `x5u`, `x5c`).
//
// ```
// let key = try jose.generateKey(jose.SignatureAlgorithm.ES256)
// let token = try jose.sign("hello".bytes(), key)
// let body = try (try jose.parseJws(token)).verify(key.publicKey(), [jose.SignatureAlgorithm.ES256])
// ```
partial module std.proto.auth.jose {
	use std.errors

	// SignatureAlgorithm is a JWS `alg` (RFC 7518 §3, RFC 8037, RFC 8812, RFC
	// 9864); its value is the registered name.
	enum SignatureAlgorithm {
		// HMAC with SHA-2 over an `oct` key at least as long as the digest.
		HS256 = "HS256",
		HS384 = "HS384",
		HS512 = "HS512",
		// RSASSA-PKCS1-v1_5 with an RSA key of 2048 bits or more.
		RS256 = "RS256",
		RS384 = "RS384",
		RS512 = "RS512",
		// RSASSA-PSS, MGF1 and a salt as long as the digest.
		PS256 = "PS256",
		PS384 = "PS384",
		PS512 = "PS512",
		// ECDSA over P-256, P-384, P-521 and secp256k1.
		ES256 = "ES256",
		ES384 = "ES384",
		ES512 = "ES512",
		ES256K = "ES256K",
		// EdDSA with an Ed25519 or Ed448 key (RFC 8037).
		EdDSA = "EdDSA",
		// EdDSA fixed to one curve (RFC 9864).
		Ed25519 = "Ed25519",
		Ed448 = "Ed448",
		// No signature: an unsecured JWS. Accepted only when a verification
		// lists it.
		None = "none",
	}

	// KeyAlgorithm is a JWE `alg`: how the content encryption key reaches
	// the recipient (RFC 7518 §4).
	enum KeyAlgorithm {
		// RSAES-PKCS1-v1_5; a decryption failure is hidden behind a random key.
		Rsa1_5 = "RSA1_5",
		// RSAES-OAEP with SHA-1, SHA-256, SHA-384 or SHA-512.
		RsaOaep = "RSA-OAEP",
		RsaOaep256 = "RSA-OAEP-256",
		RsaOaep384 = "RSA-OAEP-384",
		RsaOaep512 = "RSA-OAEP-512",
		// AES Key Wrap under a shared `oct` key.
		A128Kw = "A128KW",
		A192Kw = "A192KW",
		A256Kw = "A256KW",
		// The shared `oct` key is the content encryption key.
		Direct = "dir",
		// ECDH-ES with an ephemeral key: the agreed key is the content key.
		EcdhEs = "ECDH-ES",
		// ECDH-ES, then AES Key Wrap with the agreed key.
		EcdhEsA128Kw = "ECDH-ES+A128KW",
		EcdhEsA192Kw = "ECDH-ES+A192KW",
		EcdhEsA256Kw = "ECDH-ES+A256KW",
		// AES-GCM key wrap under a shared `oct` key.
		A128GcmKw = "A128GCMKW",
		A192GcmKw = "A192GCMKW",
		A256GcmKw = "A256GCMKW",
		// PBKDF2 from a password (an `oct` key), then AES Key Wrap.
		Pbes2Hs256A128Kw = "PBES2-HS256+A128KW",
		Pbes2Hs384A192Kw = "PBES2-HS384+A192KW",
		Pbes2Hs512A256Kw = "PBES2-HS512+A256KW",
	}

	// ContentEncryption is a JWE `enc` (RFC 7518 §5).
	enum ContentEncryption {
		A128CbcHs256 = "A128CBC-HS256",
		A192CbcHs384 = "A192CBC-HS384",
		A256CbcHs512 = "A256CBC-HS512",
		A128Gcm = "A128GCM",
		A192Gcm = "A192GCM",
		A256Gcm = "A256GCM",
	}

	// KeyType is a JWK `kty` (RFC 7518 §6, RFC 8037).
	enum KeyType {
		Ec = "EC",
		Rsa = "RSA",
		Oct = "oct",
		Okp = "OKP",
	}

	// Curve is a JWK `crv`: the NIST and SEC curves of `EC` keys, the
	// Edwards and Montgomery curves of `OKP` keys.
	enum Curve {
		P256 = "P-256",
		P384 = "P-384",
		P521 = "P-521",
		Secp256k1 = "secp256k1",
		Ed25519 = "Ed25519",
		Ed448 = "Ed448",
		X25519 = "X25519",
		X448 = "X448",
	}

	// JoseErrorKind says why a JOSE operation failed.
	enum JoseErrorKind {
		// The input is not a JWS, JWE, JWK or JWT of valid shape.
		Malformed,
		// An algorithm, curve or header this module does not implement.
		UnsupportedAlgorithm,
		// The algorithm is not one the caller allowed.
		AlgorithmNotAllowed,
		// No key fits the algorithm, or the key does not fit it.
		KeyMismatch,
		// No signature verified.
		BadSignature,
		// The content could not be decrypted.
		DecryptionFailed,
		// A `crit` header names an extension this module does not process.
		CriticalUnknown,
		// The token's `exp` has passed.
		Expired,
		// The token's `nbf` has not been reached.
		NotYetValid,
		// A claim or `typ` is missing or does not match what was asked.
		ClaimMismatch,
		// A remote key set could not be fetched or read.
		KeyUnavailable,
	}

	// JoseError is the payload of every failure in this module; `kind`
	// tells them apart and `code` holds its name.
	struct JoseError {
		message string
		code    string
		cause   ?error
		stack   errors.StackTrace
		kind    JoseErrorKind
	}
}
