	internal def orEmpty(v ?string) string {
		return v is none ?? ("", v)
	}

	internal struct TestCase {
		key   string
		token string
		alg   SignatureAlgorithm
	}

	internal struct VerifyCase {
		text string
		key  string
		alg  SignatureAlgorithm
	}

	internal struct DecryptCase {
		texts string[]
		key   string
		alg   KeyAlgorithm
		enc   ContentEncryption
		plain string
	}

	check "JOSE" {
		@test()
		def TestJwkCookbookKeys() !none {
			// RFC 7520 §3: every key parses and round-trips through json().
			for let text in [key1, key2, key3, key4, key5, key6, key73, key84, key108, key120, key130, key138, key151, key224] {
				let key = try parseKey(text)
				let again = try parseKey(key.json())
				assert again.thumbprint().hex() == key.thumbprint().hex()
				assert again.isPrivate() == key.isPrivate()
			}
			let ec = try parseKey(key2)
			assert ec.kty == KeyType.Ec && ec.isPrivate() && orEmpty(ec.kid) == "bilbo.baggins@hobbiton.example"
			assert !ec.publicKey().isPrivate()
			assert ec.publicKey().thumbprint().hex() == (try parseKey(key1)).thumbprint().hex()
			// RFC 7638 §3.1 and RFC 8037 A.3 thumbprints.
			assert b64((try parseKey(tp_key)).thumbprint()) == "NzbLsXh8uDCcd-6MNwXF4W_7noWXFZAfHkxZsRGC9Xs"
			let ed = try parseKey("\{\"kty\":\"OKP\",\"crv\":\"Ed25519\",\"d\":\"nWGxne_9WmC6hEr0kuwsxERJxWl7MmkZcDusAxyuf2A\",\"x\":\"11qYAYKxCrfVS_7TyWQHOg7hcvPapiMlrwIaaPcHURo\"\}")
			assert b64(ed.thumbprint()) == "kPrK_qmxVWaYVA9wwBF6Iuo3vVzz7TxHCTwXBygrS4k"
			assert (try ed.thumbprintUri()) == "urn:ietf:params:oauth:jwk-thumbprint:sha-256:kPrK_qmxVWaYVA9wwBF6Iuo3vVzz7TxHCTwXBygrS4k"
			// A set keeps the keys it can use and drops the rest.
			let set = try parseKeySet("\{\"keys\":[" + key1 + ",\{\"kty\":\"XYZ\"\}," + key5 + "]\}")
			assert set.keys.len() == 2
			assert !(set.find("bilbo.baggins@hobbiton.example") is none)
		}

		@test()
		def TestJwkRejects() !none {
			let bad = [
				"\{\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"f83OJ3D2xF1Bg8vub9tLe1gHMzV76e8Tus9uPHvRVEU\",\"y\":\"x_FEzRu9m36HLN_tue659LNpXW6pCyStikYjKIWI5a1\"\}",
				"\{\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"f83O\",\"y\":\"x_FE\"\}",
				"\{\"kty\":\"OKP\",\"crv\":\"Ed25519\",\"d\":\"nWGxne_9WmC6hEr0kuwsxERJxWl7MmkZcDusAxyuf2A\",\"x\":\"3p7bfXt9wbTTW2HC7OQ1Nz-DQ8hbeGdNrfx-FG-IK08\"\}",
				"\{\"kty\":\"oct\",\"k\":\"AyM1+ysP\"\}",
				"\{\"kty\":\"oct\",\"k\":\"AyM1SysP\",\"k\":\"AyM1SysP\"\}",
				"\{\"kty\":\"oct\",\"k\":\"AyM1SysP\",\"key_ops\":[\"sign\",\"sign\"]\}",
				"\{\"kty\":\"RSA\",\"n\":\"AQAB\",\"e\":\"AQAB\",\"oth\":[]\}",
				"\{\"kty\":\"oct\"\}",
				"[1]"
			]
			for let text in bad {
				assert parseKey(text) is error
			}
		}

		@test()
		def TestJwsRfc7515() !none {
			// RFC 7515 Appendix A: HS256, RS256, ES256, ES512, unsecured.
			let all = [TestCase{key:a1_key, token:a1_token, alg:SignatureAlgorithm.HS256}, TestCase{key:a2_key, token:a2_token, alg:SignatureAlgorithm.RS256}, TestCase{key:a3_key, token:a3_token, alg:SignatureAlgorithm.ES256}, TestCase{key:a4_key, token:a4_token, alg:SignatureAlgorithm.ES512}]
			for let c in all {
				let key = try parseKey(c.key)
				let jws = try parseJws(c.token)
				assert (try jws.verify(key.publicKey(), [c.alg])).len() > 0
				assert jws.verify(key.publicKey(), [SignatureAlgorithm.PS256]) is error
				let tampered = c.token[0:c.token.len() - 2] + (c.token.endsWith("A") ?? ("BA", "AA"))
				assert (try parseJws(tampered)).verify(key.publicKey(), [c.alg]) is error
			}
			// HS256 and RS256 are deterministic: signing reproduces the token.
			let rsa = try parseKey(a2_key)
			assert (try sign((try parseJws(a2_token)).payload, rsa, SignatureAlgorithm.RS256)) == a2_token
			let unsecuredJws = try parseJws(a5_token)
			assert unsecuredJws.verify(new JwkSet(), [SignatureAlgorithm.HS256]) is error
			assert (try unsecuredJws.verify(new JwkSet(), [SignatureAlgorithm.None])).len() > 0
			// RFC 8037 A.4: Ed25519 is deterministic too.
			let ed = try parseKey("\{\"kty\":\"OKP\",\"crv\":\"Ed25519\",\"d\":\"nWGxne_9WmC6hEr0kuwsxERJxWl7MmkZcDusAxyuf2A\",\"x\":\"11qYAYKxCrfVS_7TyWQHOg7hcvPapiMlrwIaaPcHURo\"\}")
			let edToken = try sign("Example of Ed25519 signing".bytes(), ed)
			assert edToken == "eyJhbGciOiJFZERTQSJ9.RXhhbXBsZSBvZiBFZDI1NTE5IHNpZ25pbmc.hgyY0il_MGCjP0JzlnLWG1PPOt7-09PGcvMg3AIbQR6dWbhijcNR4ki4iylGjg5BhVsPt9g7sVvpAr_MuM0KAg"
			assert string(try (try parseJws(edToken)).verify(ed.publicKey(), [SignatureAlgorithm.EdDSA])) == "Example of Ed25519 signing"
		}

		@test()
		def TestJwsUnencodedPayload() !none {
			// RFC 7797 §4.
			let key = try parseKey(a1_key)
			let plain = try sign("$.02".bytes(), key, SignatureAlgorithm.HS256, new Header())
			assert plain == "eyJhbGciOiJIUzI1NiJ9.JC4wMg.5mvfOroL-g7HyqJoozehmsaqmvTYGEq5jTI1gVvoEoQ"
			let header = new Header()
			header.b64 = false
			let jws = new Jws("$.02".bytes())
			jws.detached = true
			try jws.sign(key, SignatureAlgorithm.HS256, header)
			assert (try jws.compact()) == "eyJhbGciOiJIUzI1NiIsImI2NCI6ZmFsc2UsImNyaXQiOlsiYjY0Il19..A5dxf2s96_n5FLueVuW1Z_vh161FwXZC4YLPff6dmDY"
			let flat = try parseJws("\{\"protected\":\"eyJhbGciOiJIUzI1NiIsImI2NCI6ZmFsc2UsImNyaXQiOlsiYjY0Il19\",\"payload\":\"$.02\",\"signature\":\"A5dxf2s96_n5FLueVuW1Z_vh161FwXZC4YLPff6dmDY\"\}")
			assert string(try flat.verify(key, [SignatureAlgorithm.HS256])) == "$.02"
			let detached = try parseJws("eyJhbGciOiJIUzI1NiIsImI2NCI6ZmFsc2UsImNyaXQiOlsiYjY0Il19..A5dxf2s96_n5FLueVuW1Z_vh161FwXZC4YLPff6dmDY")
			detached.payload = "$.02".bytes()
			assert string(try detached.verify(key, [SignatureAlgorithm.HS256])) == "$.02"
			// b64 must be critical.
			let unlisted = try parseJws("eyJhbGciOiJIUzI1NiIsImI2NCI6ZmFsc2V9..A5dxf2s96_n5FLueVuW1Z_vh161FwXZC4YLPff6dmDY")
			unlisted.payload = "$.02".bytes()
			assert unlisted.verify(key, [SignatureAlgorithm.HS256]) is error
		}

		@test()
		def TestJwsCookbook() !none {
			let rsa = try parseKey(key4)
			let ec = try parseKey(key2)
			let hmac = try parseKey(key5)
			let payload = payload7.bytes()
			// §4.1 RS256 and §4.4 HS256 reproduce exactly.
			let header = new Header()
			header.kid = "bilbo.baggins@hobbiton.example"
			assert (try sign(payload, rsa, SignatureAlgorithm.RS256, header)) == compact13
			let hmacHeader = new Header()
			hmacHeader.kid = "018c0ae5-4d9b-471b-bfd6-eef314bc7037"
			assert (try sign(payload, hmac, SignatureAlgorithm.HS256, hmacHeader)) == compact34
			let cases = [
				VerifyCase{text: compact13, key: key3, alg: SignatureAlgorithm.RS256},
				VerifyCase{text: json14, key: key3, alg: SignatureAlgorithm.RS256},
				VerifyCase{text: json15, key: key3, alg: SignatureAlgorithm.RS256},
				VerifyCase{text: compact20, key: key3, alg: SignatureAlgorithm.PS384},
				VerifyCase{text: json21, key: key3, alg: SignatureAlgorithm.PS384},
				VerifyCase{text: json22, key: key3, alg: SignatureAlgorithm.PS384},
				VerifyCase{text: compact27, key: key1, alg: SignatureAlgorithm.ES512},
				VerifyCase{text: json28, key: key1, alg: SignatureAlgorithm.ES512},
				VerifyCase{text: json29, key: key1, alg: SignatureAlgorithm.ES512},
				VerifyCase{text: compact34, key: key5, alg: SignatureAlgorithm.HS256},
				VerifyCase{text: json35, key: key5, alg: SignatureAlgorithm.HS256},
				VerifyCase{text: json36, key: key5, alg: SignatureAlgorithm.HS256},
				VerifyCase{text: json49, key: key5, alg: SignatureAlgorithm.HS256},
				VerifyCase{text: json50, key: key5, alg: SignatureAlgorithm.HS256},
				VerifyCase{text: json54, key: key5, alg: SignatureAlgorithm.HS256},
				VerifyCase{text: json55, key: key5, alg: SignatureAlgorithm.HS256},
				VerifyCase{text: json71, key: key3, alg: SignatureAlgorithm.RS256},
				VerifyCase{text: json71, key: key1, alg: SignatureAlgorithm.ES512},
				VerifyCase{text: json71, key: key5, alg: SignatureAlgorithm.HS256}
			]
			for let c in cases {
				let jws = try parseJws(c.text)
				assert string(try jws.verify(try parseKey(c.key), [c.alg])) == payload7
			}
			// §4.5 detached content.
			for let text in [compact41, json42, json43] {
				let jws = try parseJws(text)
				assert jws.detached
				jws.payload = payload
				assert string(try jws.verify(hmac, [SignatureAlgorithm.HS256])) == payload7
				jws.payload = "other".bytes()
				assert jws.verify(hmac, [SignatureAlgorithm.HS256]) is error
			}
			// Our own multi-signature JWS reads back in both JSON forms.
			let multi = new Jws(payload)
			try multi.sign(rsa, SignatureAlgorithm.PS256)
			try multi.sign(ec)
			let unprotected = new Header()
			unprotected.kid = "018c0ae5-4d9b-471b-bfd6-eef314bc7037"
			try multi.sign(hmac, SignatureAlgorithm.HS256, new Header(), unprotected)
			// RFC 7518 §3.2: a 256-bit key is too short for HS512.
			assert multi.sign(hmac, SignatureAlgorithm.HS512) is error
			let back = try parseJws(try multi.json())
			assert string(try back.verify(ec.publicKey(), [SignatureAlgorithm.ES512])) == payload7
			assert string(try back.verify(hmac, [SignatureAlgorithm.HS256])) == payload7
			assert multi.compact() is error
			assert multi.json(true) is error
			assert back.signatures[2].protected.names().join(",") == "alg"
		}

		@test()
		def TestJwsPolicy() !none {
			let rsa = try parseKey(key4)
			let hmac = try parseKey(key5)
			let token = try sign("x".bytes(), rsa, SignatureAlgorithm.RS256)
			// The algorithm must be allowed, and a public RSA key is never an HMAC secret.
			assert (try parseJws(token)).verify(rsa.publicKey(), []) is error
			let confused = new Jwk(rsa.publicKey().json().bytes())
			let forged = try sign("x".bytes(), confused, SignatureAlgorithm.HS256)
			assert (try parseJws(forged)).verify(rsa.publicKey(), [SignatureAlgorithm.RS256, SignatureAlgorithm.HS256]) is error
			// Keys too weak to use, and a public key, cannot sign.
			assert sign("x".bytes(), new Jwk("short".bytes()), SignatureAlgorithm.HS256) is error
			assert sign("x".bytes(), rsa.publicKey(), SignatureAlgorithm.RS256) is error
			assert sign("x".bytes(), hmac, SignatureAlgorithm.ES256) is error
			// An unknown critical extension and a header repeated in both parts are refused.
			let crit = new Header()
			crit.crit = ["exp"]
			try crit.set("exp", 1)
			let critical = try sign("x".bytes(), hmac, SignatureAlgorithm.HS256, crit)
			let err = (try parseJws(critical)).verify(hmac, [SignatureAlgorithm.HS256])
			assert err is error
			let repeated = new Jws("x".bytes())
			let dup = new Header()
			dup.kid = "a"
			assert repeated.sign(hmac, SignatureAlgorithm.HS256, dup, dup) is error
			// A key with another kid is still tried when it has none; one with a different kid is not.
			let named = try parseKey(key5)
			named.kid = "other"
			assert (try parseJws(try sign("x".bytes(), hmac))).verify(named, [SignatureAlgorithm.HS256]) is error
		}

		@test()
		def TestJweCookbook() !none {
			let cases = [
				DecryptCase{texts: [compact81, json82, json83], key: key73, alg: KeyAlgorithm.Rsa1_5, enc: ContentEncryption.A128CbcHs256, plain: plain72},
				DecryptCase{texts: [compact92, json93, json94], key: key84, alg: KeyAlgorithm.RsaOaep, enc: ContentEncryption.A256Gcm, plain: plain72},
				DecryptCase{texts: [compact117, json118, json119], key: key108, alg: KeyAlgorithm.EcdhEsA128Kw, enc: ContentEncryption.A128Gcm, plain: plain72},
				DecryptCase{texts: [compact128, json129], key: key120, alg: KeyAlgorithm.EcdhEs, enc: ContentEncryption.A128CbcHs256, plain: plain72},
				DecryptCase{texts: [compact136, json137], key: key130, alg: KeyAlgorithm.Direct, enc: ContentEncryption.A128Gcm, plain: plain72},
				DecryptCase{texts: [compact148, json149, json150], key: key138, alg: KeyAlgorithm.A256GcmKw, enc: ContentEncryption.A128CbcHs256, plain: plain72},
				DecryptCase{texts: [compact159, json160, json161, compact170, json171, json172, json182, json183, json192, json193, json200, json201], key: key151, alg: KeyAlgorithm.A128Kw, enc: ContentEncryption.A128Gcm, plain: plain72}
			]
			for let c in cases {
				let key = try parseKey(c.key)
				for let text in c.texts {
					let jwe = try parseJwe(text)
					assert string(try jwe.decrypt(key, [c.alg], [c.enc])) == c.plain
					assert jwe.decrypt(key, [c.alg], [ContentEncryption.A192Gcm]) is error
				}
			}
			// §5.3 PBES2 with a password, the plaintext a JWK Set.
			let password = new Jwk(password96.bytes())
			for let text in [compact105, json106, json107] {
				let plain = try (try parseJwe(text)).decrypt(password, [KeyAlgorithm.Pbes2Hs512A256Kw], [ContentEncryption.A128CbcHs256])
				assert string(plain) == plain95
			}
			// §5.13 three recipients, each with its own key.
			let jwe = try parseJwe(json221)
			assert jwe.recipients.len() == 3
			assert string(try jwe.decrypt(try parseKey(key73), [KeyAlgorithm.Rsa1_5], [ContentEncryption.A128CbcHs256])) == plain72
			assert string(try jwe.decrypt(try parseKey(key108), [KeyAlgorithm.EcdhEsA256Kw], [ContentEncryption.A128CbcHs256])) == plain72
			assert string(try jwe.decrypt(try parseKey(key138), [KeyAlgorithm.A256GcmKw], [ContentEncryption.A128CbcHs256])) == plain72
		}

		@test()
		def TestJweRoundTrips() !none {
			let plain = "attack at dawn".bytes()
			let encs = [ContentEncryption.A128CbcHs256, ContentEncryption.A192CbcHs384, ContentEncryption.A256CbcHs512, ContentEncryption.A128Gcm, ContentEncryption.A192Gcm, ContentEncryption.A256Gcm]
			// The cookbook RSA key is marked for signing; this one is not.
			let rsa = try parseKey(key4)
			assert encrypt(plain, rsa.publicKey(), KeyAlgorithm.RsaOaep, ContentEncryption.A128Gcm) is error
			rsa.usage = none
			let algs = [KeyAlgorithm.Rsa1_5, KeyAlgorithm.RsaOaep, KeyAlgorithm.RsaOaep256, KeyAlgorithm.RsaOaep384, KeyAlgorithm.RsaOaep512, KeyAlgorithm.A128Kw, KeyAlgorithm.A192Kw, KeyAlgorithm.A256Kw, KeyAlgorithm.Direct, KeyAlgorithm.EcdhEs, KeyAlgorithm.EcdhEsA128Kw, KeyAlgorithm.EcdhEsA192Kw, KeyAlgorithm.EcdhEsA256Kw, KeyAlgorithm.A128GcmKw, KeyAlgorithm.A192GcmKw, KeyAlgorithm.A256GcmKw, KeyAlgorithm.Pbes2Hs256A128Kw, KeyAlgorithm.Pbes2Hs384A192Kw, KeyAlgorithm.Pbes2Hs512A256Kw]
			let pbes = new Header()
			pbes.p2c = 1000
			for let alg in algs {
				for let enc in encs {
					let key = isRsaKeyAlgorithm(alg) ?? (rsa, try generateKey(alg, enc))
					key.alg = none
					let header = isPbes2(alg) ?? (pbes, new Header())
					let sealed = try encrypt(plain, key.publicKey(), alg, enc, header)
					assert string(try (try parseJwe(sealed)).decrypt(key, [alg], [enc])) == "attack at dawn"
				}
			}
			// X25519, X448, P-384 and P-521 agreement keys.
			for let crv in [Curve.X25519, Curve.X448, Curve.P384, Curve.P521] {
				let key = try generateKey(crv)
				let sealed = try encrypt(plain, key.publicKey(), KeyAlgorithm.EcdhEsA256Kw, ContentEncryption.A256Gcm)
				assert string(try (try parseJwe(sealed)).decrypt(key, [KeyAlgorithm.EcdhEsA256Kw], [ContentEncryption.A256Gcm])) == "attack at dawn"
				let roundTrip = try parseKey(key.json())
				assert string(try (try parseJwe(sealed)).decrypt(roundTrip, [KeyAlgorithm.EcdhEsA256Kw], [ContentEncryption.A256Gcm])) == "attack at dawn"
			}
			// Compression, and several recipients in one JWE.
			let zipped = new Header()
			zipped.zip = "DEF"
			let aes = try generateKey(KeyAlgorithm.A128Kw)
			let big byte[] = []
			big.len(10000)
			let compressed = try encrypt(big, aes, KeyAlgorithm.A128Kw, ContentEncryption.A128Gcm, zipped)
			assert compressed.len() < 2000
			assert (try (try parseJwe(compressed)).decrypt(aes, [KeyAlgorithm.A128Kw], [ContentEncryption.A128Gcm])).len() == 10000
			assert (try parseJwe(compressed)).decrypt(aes, [KeyAlgorithm.A128Kw], [ContentEncryption.A128Gcm], 5000) is error
			let ecKey = try generateKey(Curve.P256)
			let many = try encrypt(plain, [Recipient{key:rsa.publicKey(), alg:KeyAlgorithm.RsaOaep256, header:none}, Recipient{key:ecKey.publicKey(), alg:KeyAlgorithm.EcdhEsA128Kw, header:none}, Recipient{key:aes, alg:KeyAlgorithm.A128Kw, header:none}], ContentEncryption.A256CbcHs512, none, none, "extra".bytes())
			let back = try parseJwe(try many.json())
			assert string(try back.decrypt(ecKey, [KeyAlgorithm.EcdhEsA128Kw], [ContentEncryption.A256CbcHs512])) == "attack at dawn"
			assert string(try back.decrypt(rsa, [KeyAlgorithm.RsaOaep256], [ContentEncryption.A256CbcHs512])) == "attack at dawn"
			assert many.compact() is error
			assert encrypt(plain, [Recipient{key:aes, alg:KeyAlgorithm.Direct, header:none}, Recipient{key:aes, alg:KeyAlgorithm.A128Kw, header:none}], ContentEncryption.A128Gcm) is error
		}

		@test()
		def TestJwt() !none {
			// RFC 7519 §3.1 (the RFC 7515 A.1 token) before and after it expired.
			let key = try parseKey(a1_key)
			let at = time.fromUnixNs(int64(1300819000) * 1000000000)
			let claims = try verifyJwt(a1_token, key, Validation{algorithms: [SignatureAlgorithm.HS256], issuer: "joe", now: at})
			assert orEmpty(claims.issuer) == "joe"
			let root = claims.get("http://example.com/is_root")
			match root {
				case bool:
					assert root
				default:
					assert false
			}
			let unverified = try parseClaims(string((try parseJws(a1_token)).payload))
			assert orEmpty(unverified.issuer) == "joe" && !(unverified.expires is none)
			assert parseClaims("\{\"exp\": \"soon\"\}") is error
			let late = verifyJwt(a1_token, key, Validation{algorithms: [SignatureAlgorithm.HS256], now: time.fromUnixNs(int64(1400000000) * 1000000000)})
			assert late is error
			assert verifyJwt(a1_token, key, Validation{algorithms: [SignatureAlgorithm.HS256], issuer: "jim", now: at}) is error
			assert verifyJwt(a1_token, key, Validation{algorithms: [SignatureAlgorithm.HS512], now: at}) is error
			// Claims we make: audience, not-before, typ, missing exp.
			let signer = try generateKey(SignatureAlgorithm.ES256)
			let c = new Claims()
			c.issuer = "https://issuer.example"
			c.audience = ["api", "web"]
			c.expires = time.now() + 1h
			c.notBefore = time.now() - 1m
			try c.set("role", "admin")
			let token = try c.sign(signer)
			let ok = Validation{algorithms: [SignatureAlgorithm.ES256], issuer: "https://issuer.example", audience: "api", typ: "JWT"}
			let back = try verifyJwt(token, signer.publicKey(), ok)
			assert back.audience.len() == 2
			let role = back.get("role")
			match role {
				case string:
					assert role == "admin"
				default:
					assert false
			}
			assert verifyJwt(token, signer.publicKey(), Validation{algorithms: [SignatureAlgorithm.ES256]}) is error
			assert verifyJwt(token, signer.publicKey(), Validation{algorithms: [SignatureAlgorithm.ES256], audience: "other"}) is error
			assert verifyJwt(token, signer.publicKey(), Validation{algorithms: [SignatureAlgorithm.ES256], audience: "api", typ: "at+jwt"}) is error
			let early = new Claims()
			early.expires = time.now() + 1h
			early.notBefore = time.now() + 10m
			assert verifyJwt(try early.sign(signer), signer.publicKey(), Validation{algorithms: [SignatureAlgorithm.ES256]}) is error
			let forever = new Claims()
			assert verifyJwt(try forever.sign(signer), signer.publicKey(), Validation{algorithms: [SignatureAlgorithm.ES256]}) is error
			assert (try verifyJwt(try forever.sign(signer), signer.publicKey(), Validation{algorithms: [SignatureAlgorithm.ES256], requireExpiry: false})).audience.len() == 0
			// Unsecured only when allowed.
			let open = try forever.unsecured()
			assert verifyJwt(open, new JwkSet(), Validation{algorithms: [SignatureAlgorithm.ES256], requireExpiry: false}) is error
			assert !(verifyJwt(open, new JwkSet(), Validation{algorithms: [SignatureAlgorithm.None], requireExpiry: false}) is error)
		}

		@test()
		def TestNestedJwt() !none {
			// RFC 7520 §6: a PS256 JWT inside an RSA-OAEP/A128GCM JWE.
			let keys = new JwkSet([(try parseKey(key224)).publicKey(), try parseKey(key84)])
			let at = time.fromUnixNs(int64(1300819000) * 1000000000)
			let v = Validation{algorithms: [SignatureAlgorithm.PS256], keyAlgorithms: [KeyAlgorithm.RsaOaep], encryptions: [ContentEncryption.A128Gcm], issuer: "hobbiton.example", now: at}
			for let text in [compact236] {
				let claims = try verifyJwt(text, keys, v)
				assert orEmpty(claims.issuer) == "hobbiton.example"
			}
			assert verifyJwt(compact236, keys, Validation{algorithms: [SignatureAlgorithm.PS256], now: at}) is error
			// Encrypt-then-sign of our own.
			let signer = try generateKey(SignatureAlgorithm.Ed448)
			let recipient = try generateKey(Curve.X25519)
			let c = new Claims()
			c.subject = "frodo"
			c.expires = time.now() + 1h
			let inner = try c.sign(signer)
			let header = new Header()
			header.cty = "JWT"
			let outer = try encrypt(inner.bytes(), recipient.publicKey(), KeyAlgorithm.EcdhEs, ContentEncryption.A256Gcm, header)
			let got = try verifyJwt(outer, new JwkSet([signer.publicKey(), recipient]), Validation{algorithms: [SignatureAlgorithm.Ed448], keyAlgorithms: [KeyAlgorithm.EcdhEs], encryptions: [ContentEncryption.A256Gcm]})
			assert orEmpty(got.subject) == "frodo"
		}

		@test()
		def TestEverySignatureAlgorithm() !none {
			let algs = [SignatureAlgorithm.HS256, SignatureAlgorithm.HS384, SignatureAlgorithm.HS512, SignatureAlgorithm.RS256, SignatureAlgorithm.RS384, SignatureAlgorithm.RS512, SignatureAlgorithm.PS256, SignatureAlgorithm.PS384, SignatureAlgorithm.PS512, SignatureAlgorithm.ES256, SignatureAlgorithm.ES384, SignatureAlgorithm.ES512, SignatureAlgorithm.ES256K, SignatureAlgorithm.EdDSA, SignatureAlgorithm.Ed25519, SignatureAlgorithm.Ed448]
			let rsa = try parseKey(key4)
			for let alg in algs {
				let key = isRsaSignature(alg) ?? (rsa, try generateKey(alg))
				let token = try sign("payload".bytes(), key, alg)
				let verifier = key.kty == KeyType.Oct ?? (key, key.publicKey())
				assert string(try (try parseJws(token)).verify(verifier, [alg])) == "payload"
			}
		}
	}
}
