partial module std.proto.auth.jose {
	use std.proto.auth.jose.engine::*

	// JweRecipient is one recipient of a JWE: its unprotected header (JSON
	// serialization only) and the encrypted content key it receives.
	struct JweRecipient {
		header       ?Header
		encryptedKey byte[]
	}

	// Recipient names a key and how its content key is delivered, for
	// encrypting to several recipients at once.
	struct Recipient {
		key    Jwk
		alg    KeyAlgorithm
		// More per-recipient parameters (kid, apu, apv, p2c, ...).
		header ?Header
	}

	// Jwe is a JSON Web Encryption (RFC 7516): content encrypted once
	// under a content key that each recipient receives in its own way.
	//
	// ```
	// let token = try jose.encrypt(secret, recipientKey, jose.KeyAlgorithm.RsaOaep256, jose.ContentEncryption.A256Gcm)
	// let jwe = try jose.parseJwe(token)
	// let plain = try jwe.decrypt(myKey, [jose.KeyAlgorithm.RsaOaep256], [jose.ContentEncryption.A256Gcm])
	// ```
	type Jwe {
		protected              Header
		// The shared unprotected header (JSON serialization only).
		unprotected            ?Header
		recipients             JweRecipient[] = []
		iv                     byte[]         = []
		ciphertext             byte[]         = []
		tag                    byte[]         = []
		// Additional authenticated data (JSON serialization only).
		aad                    ?byte[]
		internal protectedText string         = ""

		def new() {
			protected = new Header()
		}

		// decrypt returns the plaintext when a recipient's content key can
		// be recovered with one of keys under an allowed key algorithm and
		// the content decrypts under an allowed encryption. Compressed
		// content (`zip: "DEF"`) is inflated up to maxSize bytes. Keys are
		// matched by `kid` (keys without one are tried too), then by type,
		// curve, length, `alg`, `use` and `key_ops`. Fails with
		// AlgorithmNotAllowed, UnsupportedAlgorithm, KeyMismatch,
		// CriticalUnknown or Malformed for the first recipient that could
		// not be tried, DecryptionFailed when none decrypted.
		def decrypt(keys JwkSet, algorithms KeyAlgorithm[], encryptions ContentEncryption[], maxSize int = 16777216) !byte[] {
			fail joseError(JoseErrorKind.Malformed, "JWE has no recipient") when recipients.len() == 0
			let first ?error = none
			for let r in recipients {
				let plain = decryptFor(self, r, keys, algorithms, encryptions, maxSize) onerror (err error) {
					let kind = err is JoseError ?? (err.kind, JoseErrorKind.DecryptionFailed)
					first = err when first is none && kind != JoseErrorKind.DecryptionFailed
					recover none
				}
				return plain unless plain is none
			}
			fail first unless first is none
			fail joseError(JoseErrorKind.DecryptionFailed, "decryption failed")
		}

		// decrypt with a remote key set, fetched again when it lacks the
		// `kid` a recipient names. Fails as the JwkSet overload does, and
		// with KeyUnavailable when the set cannot be fetched.
		def decrypt(keys RemoteKeySet, algorithms KeyAlgorithm[], encryptions ContentEncryption[], maxSize int = 16777216) !byte[] {
			let kids string[] = []
			let top = protected.kid
			kids.push(top) unless top is none
			for let r in recipients {
				let h = r.header
				let id = h is none ?? (none, h.kid)
				kids.push(id) unless id is none
			}
			return try decrypt(try keys.keysFor(kids), algorithms, encryptions, maxSize)
		}

		// decrypt with one key. Fails as the JwkSet overload does.
		def decrypt(key Jwk, algorithms KeyAlgorithm[], encryptions ContentEncryption[], maxSize int = 16777216) !byte[] {
			return try decrypt(new JwkSet([key]), algorithms, encryptions, maxSize)
		}

		// compact renders the JWE Compact Serialization. Fails with
		// Malformed unless there is one recipient and no unprotected
		// header or aad.
		def compact() !string {
			fail joseError(JoseErrorKind.Malformed, "compact form needs exactly one recipient") when recipients.len() != 1
			let r = recipients[0]
			fail joseError(JoseErrorKind.Malformed, "compact form has no unprotected header") unless unprotected is none && r.header is none
			fail joseError(JoseErrorKind.Malformed, "compact form has no aad") unless aad is none
			return [protectedText, b64(r.encryptedKey), b64(iv), b64(ciphertext), b64(tag)].join(".")
		}

		// json renders the JWE JSON Serialization, general by default,
		// flattened when asked. Fails with Malformed when flattened has
		// other than one recipient.
		def json(flattened bool = false) !string {
			fail joseError(JoseErrorKind.Malformed, "flattened form needs exactly one recipient") when flattened && recipients.len() != 1
			let m map<string, any>
			m.set("protected", protectedText) when protectedText != ""
			let shared = unprotected
			m.set("unprotected", headerMembers(shared)) unless shared is none
			if flattened {
				let r = recipients[0]
				let h = r.header
				m.set("header", headerMembers(h)) unless h is none
				m.set("encrypted_key", b64(r.encryptedKey)) when r.encryptedKey.len() > 0
			} else {
				let list any[] = []
				for let r in recipients {
					let entry map<string, any>
					let h = r.header
					entry.set("header", headerMembers(h)) unless h is none
					entry.set("encrypted_key", b64(r.encryptedKey)) when r.encryptedKey.len() > 0
					list.push(entry)
				}
				m.set("recipients", list)
			}
			let extra = aad
			m.set("aad", b64(extra)) unless extra is none
			m.set("iv", b64(iv))
			m.set("ciphertext", b64(ciphertext))
			m.set("tag", b64(tag))
			return encodeJSON(m)
		}
	}

	// encrypt encrypts plaintext to one key and returns the JWE Compact
	// Serialization; header supplies more protected parameters (`zip:
	// "DEF"` compresses, `apu`/`apv` feed ECDH-ES, `p2c` sets the PBES2
	// iterations, 600000 unless given). Fails with KeyMismatch when the key
	// does not fit the algorithm (RSA under 2048 bits, an `oct` key of the
	// wrong length, a curve ECDH-ES does not use), UnsupportedAlgorithm for
	// a `zip` other than DEF.
	def encrypt(plaintext byte[], key Jwk, alg KeyAlgorithm, enc ContentEncryption, header ?Header = none) !string {
		return try encryptCompact(plaintext, key, alg, enc, header)
	}

	internal def encryptCompact(plaintext byte[], key Jwk, alg KeyAlgorithm, enc ContentEncryption, header ?Header) !string {
		let p = header is none ?? (new Header(), try headerFromText(header.json(), "header"))
		p.alg = alg.value
		p.enc = enc.value
		let keyId = key.kid
		let headerId = p.kid
		p.kid = keyId when headerId is none && !(keyId is none)
		fail joseError(JoseErrorKind.KeyMismatch, "the key cannot be used with {alg.value} and {enc.value}") unless keyFits(alg, enc, key, false)
		let (cek, encryptedKey) = try encryptKey(alg, enc, key, p, p, [])
		let jwe = new Jwe()
		jwe.protected = p
		jwe.protectedText = b64(p.json().bytes())
		jwe.recipients.push(JweRecipient{header: none, encryptedKey: encryptedKey})
		try sealInto(jwe, enc, cek, plaintext)
		return try jwe.compact()
	}

	// encrypt encrypts plaintext once for several recipients, each
	// receiving the content key through its own algorithm, and returns the
	// JWE for json(). `dir` and `ECDH-ES` (the agreed key is the content
	// key) allow only one recipient. Fails as the one-key encrypt does, and
	// with Malformed when headers share a parameter.
	def encrypt(plaintext byte[], recipients Recipient[], enc ContentEncryption, protected ?Header = none, unprotected ?Header = none, aad ?byte[] = none) !Jwe {
		fail joseError(JoseErrorKind.Malformed, "no recipients") when recipients.len() == 0
		let p = protected is none ?? (new Header(), try headerFromText(protected.json(), "header"))
		p.enc = enc.value
		let shared = unprotected is none ?? (new Header(), unprotected)
		let jwe = new Jwe()
		jwe.protected = p
		jwe.unprotected = unprotected
		jwe.aad = aad
		let cek byte[] = []
		for let r in recipients {
			fail joseError(JoseErrorKind.Malformed, "{r.alg.value} allows only one recipient") when recipients.len() > 1 && (r.alg := KeyAlgorithm.Direct || KeyAlgorithm.EcdhEs)
			fail joseError(JoseErrorKind.KeyMismatch, "a key cannot be used with {r.alg.value} and {enc.value}") unless keyFits(r.alg, enc, r.key, false)
			let given = r.header
			let h = given is none ?? (new Header(), try headerFromText(given.json(), "header"))
			h.alg = r.alg.value
			let keyId = r.key.kid
			let headerId = h.kid
			h.kid = keyId when headerId is none && !(keyId is none)
			let (content, encryptedKey) = try encryptKey(r.alg, enc, r.key, h, shared, cek)
			cek = content
			try mergeHeaders([p, shared, h])
			jwe.recipients.push(JweRecipient{header: h, encryptedKey: encryptedKey})
		}
		jwe.protectedText = b64(p.json().bytes())
		try sealInto(jwe, enc, cek, plaintext)
		return jwe
	}

	// parseJwe reads a JWE in the compact, flattened JSON or general JSON
	// serialization. Nothing is decrypted. Fails with Malformed when the
	// text is none of those, a part is not base64url, or a header is not a
	// JSON object.
	def parseJwe(text string) !Jwe {
		let t = text.trim()
		return try parseJweJson(t) when t.startsWith("\{")
		let parts = t.split(".")
		fail joseError(JoseErrorKind.Malformed, "a compact JWE has five parts") when parts.len() != 5
		let jwe = new Jwe()
		jwe.protectedText = parts[0]
		jwe.protected = try headerFromText(string(try unb64(parts[0], "protected header")), "protected header")
		jwe.recipients.push(JweRecipient{header: none, encryptedKey: try unb64(parts[1], "encrypted key")})
		jwe.iv = try unb64(parts[2], "iv")
		jwe.ciphertext = try unb64(parts[3], "ciphertext")
		jwe.tag = try unb64(parts[4], "tag")
		return jwe
	}

	internal def parseJweJson(text string) !Jwe {
		let m = try parseObject(text, "JWE")
		let jwe = new Jwe()
		if m.hasKey("protected") {
			jwe.protectedText = try textOf(m, "protected")
			jwe.protected = try headerFromText(string(try unb64(jwe.protectedText, "protected header")), "protected header")
		}
		jwe.unprotected = try parseHeader(try objectOf(m, "unprotected")) when m.hasKey("unprotected")
		if m.hasKey("recipients") {
			fail joseError(JoseErrorKind.Malformed, "a JWE has \"recipients\" or \"encrypted_key\", not both") when m.hasKey("encrypted_key") || m.hasKey("header")
			let list = m["recipients"]
			match list {
				case any[]:
					for let item in list {
						match item {
							case map<string, any>:
								jwe.recipients.push(try recipientOf(item))
							default:
								fail joseError(JoseErrorKind.Malformed, "\"recipients\" must hold objects")
						}
					}
				default:
					fail joseError(JoseErrorKind.Malformed, "\"recipients\" must be an array")
			}
		} else {
			jwe.recipients.push(try recipientOf(m))
		}
		fail joseError(JoseErrorKind.Malformed, "JWE has no recipient") when jwe.recipients.len() == 0
		jwe.aad = try bytesOf(m, "aad") when m.hasKey("aad")
		jwe.iv = try bytesOf(m, "iv") when m.hasKey("iv")
		fail joseError(JoseErrorKind.Malformed, "JWE has no \"ciphertext\"") unless m.hasKey("ciphertext")
		jwe.ciphertext = try bytesOf(m, "ciphertext")
		jwe.tag = try bytesOf(m, "tag") when m.hasKey("tag")
		return jwe
	}

	internal def recipientOf(m map<string, any>) !JweRecipient {
		let header = m.hasKey("header") ?? (try parseHeader(try objectOf(m, "header")), none)
		let key = m.hasKey("encrypted_key") ?? (try bytesOf(m, "encrypted_key"), byte[])
		return JweRecipient{header: header, encryptedKey: key}
	}

	// The additional authenticated data of RFC 7516 §5.1 step 14: the
	// protected header text, and `.` and the aad when there is one.
	internal def authenticatedData(jwe Jwe) byte[] {
		let extra = jwe.aad
		return extra is none ?? (jwe.protectedText.bytes(), (jwe.protectedText + "." + b64(extra)).bytes())
	}

	// sealInto compresses when the protected header asks and encrypts the
	// content.
	internal def sealInto(jwe Jwe, enc ContentEncryption, cek, plaintext byte[]) !none {
		let content = plaintext
		let zip = jwe.protected.zip
		if !(zip is none) {
			fail joseError(JoseErrorKind.UnsupportedAlgorithm, "unsupported zip \"{zip}\"") unless zip == "DEF"
			content = try deflate(plaintext)
		}
		let (iv, ciphertext, tag) = try sealContent(enc, cek, content, authenticatedData(jwe))
		jwe.iv = iv
		jwe.ciphertext = ciphertext
		jwe.tag = tag
		return none
	}

	// decryptFor tries one recipient: the plaintext, none when no
	// candidate key decrypted. Policy failures are errors.
	internal def decryptFor(jwe Jwe, r JweRecipient, keys JwkSet, algorithms KeyAlgorithm[], encryptions ContentEncryption[], maxSize int) !?byte[] {
		let parts Header[] = [jwe.protected]
		let shared = jwe.unprotected
		parts.push(shared) unless shared is none
		let own = r.header
		parts.push(own) unless own is none
		let merged = try mergeHeaders(parts)
		let algName = merged.alg
		let encName = merged.enc
		fail joseError(JoseErrorKind.Malformed, "the header has no \"alg\"") when algName is none
		fail joseError(JoseErrorKind.Malformed, "the header has no \"enc\"") when encName is none
		let alg = keyAlgorithmOf(algName)
		let enc = contentEncryptionOf(encName)
		fail joseError(JoseErrorKind.UnsupportedAlgorithm, "unsupported algorithm \"{algName}\"") when alg is none
		fail joseError(JoseErrorKind.UnsupportedAlgorithm, "unsupported encryption \"{encName}\"") when enc is none
		fail joseError(JoseErrorKind.AlgorithmNotAllowed, "algorithm {algName} is not allowed") unless alg in algorithms
		fail joseError(JoseErrorKind.AlgorithmNotAllowed, "encryption {encName} is not allowed") unless enc in encryptions
		try checkCritical(jwe.protected, merged, [])
		let zip = merged.zip
		if !(zip is none) {
			fail joseError(JoseErrorKind.Malformed, "\"zip\" must be in the protected header") when jwe.protected.zip is none
			fail joseError(JoseErrorKind.UnsupportedAlgorithm, "unsupported zip \"{zip}\"") unless zip == "DEF"
		}
		let tried = false
		for let key in candidateKeys(keys, merged.kid) {
			continue unless keyFits(alg, enc, key, true)
			tried = true
			let cek = decryptKey(alg, enc, key, merged, r.encryptedKey) onerror recover byte[]
			continue when cek.len() == 0
			let opened = true
			let content = openContent(enc, cek, jwe.iv, jwe.ciphertext, jwe.tag, authenticatedData(jwe)) onerror (err error) {
				opened = false
				recover byte[]
			}
			continue unless opened
			let plain = zip is none ?? (content, try inflate(content, maxSize))
			fail joseError(JoseErrorKind.DecryptionFailed, "plaintext exceeds {maxSize} bytes") when plain.len() > maxSize
			return plain
		}
		fail joseError(JoseErrorKind.KeyMismatch, "no key fits {algName}") unless tried
		return none
	}
}
