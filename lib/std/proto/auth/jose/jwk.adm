partial module std.proto.auth.jose {
	use (
		std.crypto
		std.crypto::(PublicKey, PrivateKey, RSAPublicKey, RSAPrivateKey, ECDSAPublicKey, ECDSAPrivateKey, Ed25519PublicKey, Ed25519PrivateKey, Ed448PublicKey, Ed448PrivateKey, X25519PublicKey, X25519PrivateKey, X448PublicKey, X448PrivateKey, Point, coordinateSize, isOnCurve, scalarBaseMult, marshalPKIXPublicKey, rand)
		std.crypto.hash::(Hash, digest, hashSize)
		std.crypto.x509
		std.proto.auth.jose.engine::*
	)

	// Jwk is a JSON Web Key (RFC 7517): an RSA, EC, OKP or symmetric key
	// with its parameters. The key itself is in `public`/`private` for RSA,
	// EC, Ed25519 and Ed448, in `agreementPublic`/`agreementPrivate` for
	// X25519 and X448, and in `secret` for `oct`.
	//
	// ```
	// let key = new jose.Jwk(try crypto.generateEd25519Key())
	// key.kid = "2026-10"
	// println(key.publicKey().json())
	// ```
	type Jwk {
		kty              KeyType
		// The curve of an EC or OKP key.
		curve            ?Curve
		kid              ?string
		// The `use` parameter: "sig" or "enc".
		usage            ?string
		// The `key_ops` parameter: "sign", "verify", "encrypt", "decrypt",
		// "wrapKey", "unwrapKey", "deriveKey", "deriveBits".
		keyOps           string[]         = []
		// The algorithm the key is meant for, as its registered name.
		alg              ?string
		x5u              ?string
		// The certificate chain, DER, the key's own certificate first.
		x5c              byte[][]         = []
		x5t              ?byte[]
		x5tS256          ?byte[]
		public           ?PublicKey
		private          ?PrivateKey
		secret           byte[]           = []
		agreementPublic  byte[]           = []
		agreementPrivate byte[]           = []
		// Members this module does not know, kept for json().
		internal extra   map<string, any>

		// new wraps a private key; the public half comes with it.
		def new(key PrivateKey) {
			private = key
			match key {
				case RSAPrivateKey:
					kty = KeyType.Rsa
					public = key.publicKey()
				case ECDSAPrivateKey:
					kty = KeyType.Ec
					curve = curveOfCrypto(key.curve)
					public = key.publicKey()
				case Ed25519PrivateKey:
					kty = KeyType.Okp
					curve = Curve.Ed25519
					public = key.public
				case Ed448PrivateKey:
					kty = KeyType.Okp
					curve = Curve.Ed448
					public = key.public
				case X25519PrivateKey:
					kty = KeyType.Okp
					curve = Curve.X25519
					public = key.public
					agreementPublic = key.public.bytes
					agreementPrivate = key.scalar
				case X448PrivateKey:
					kty = KeyType.Okp
					curve = Curve.X448
					public = key.public
					agreementPublic = key.public.bytes
					agreementPrivate = key.scalar
			}
		}

		// new wraps a public key.
		def new(key PublicKey) {
			public = key
			match key {
				case RSAPublicKey:
					kty = KeyType.Rsa
				case ECDSAPublicKey:
					kty = KeyType.Ec
					curve = curveOfCrypto(key.curve)
				case Ed25519PublicKey:
					kty = KeyType.Okp
					curve = Curve.Ed25519
				case Ed448PublicKey:
					kty = KeyType.Okp
					curve = Curve.Ed448
				case X25519PublicKey:
					kty = KeyType.Okp
					curve = Curve.X25519
					agreementPublic = key.bytes
				case X448PublicKey:
					kty = KeyType.Okp
					curve = Curve.X448
					agreementPublic = key.bytes
			}
		}

		// new wraps symmetric key material as an `oct` key: an HMAC secret,
		// an AES key, or a PBES2 password.
		def new(secret byte[]) {
			kty = KeyType.Oct
			self.secret = secret
		}

		// new wraps an X25519 or X448 key from its raw public value (32 or
		// 56 bytes) and, for a private key, its private scalar.
		def new(curve Curve, publicValue byte[], privateValue byte[] = []) {
			kty = KeyType.Okp
			self.curve = curve
			agreementPublic = publicValue
			agreementPrivate = privateValue
		}

		// isPrivate reports whether the key holds private or secret
		// material.
		def isPrivate() bool {
			return true when kty == KeyType.Oct
			return !(private is none) || agreementPrivate.len() > 0
		}

		// publicKey is the key without its private parts, with the same
		// parameters. An `oct` key has no public half and comes back as it
		// is.
		def publicKey() Jwk {
			let out = new Jwk(secret)
			if kty != KeyType.Oct {
				out.kty = kty
				out.curve = curve
				out.public = public
				out.agreementPublic = agreementPublic
				out.secret = []
			}
			out.kid = kid
			out.usage = usage
			out.keyOps = keyOps.clone()
			out.alg = alg
			out.x5u = x5u
			out.x5c = x5c.clone()
			out.x5t = x5t
			out.x5tS256 = x5tS256
			for let (k, kValue) in extra {
				out.extra.set(k, kValue)
			}
			return out
		}

		// json renders the key as a JWK, private parts included when the
		// key has them; use publicKey().json() to publish it.
		def json() string {
			return encodeJSON(jwkObject(self, true))
		}

		// thumbprint is the RFC 7638 thumbprint: the digest of the key's
		// required public members in lexicographic order.
		def thumbprint(hash Hash = Hash.SHA256) byte[] {
			let m = keyMembers(self, false)
			let ordered map<string, any>
			let names = m.keys()
			names.sort((a, b string) => a < b)
			for let name in names {
				ordered.set(name, m[name]) when m.hasKey(name)
			}
			return digest(hash, encodeJSON(ordered).bytes())
		}

		// thumbprintUri is the RFC 9278 URI of the thumbprint,
		// `urn:ietf:params:oauth:jwk-thumbprint:sha-256:...`. Fails for a
		// hash other than SHA-256, SHA-384 and SHA-512.
		def thumbprintUri(hash Hash = Hash.SHA256) !string {
			let name = ""
			name = "sha-256" when hash == Hash.SHA256
			name = "sha-384" when hash == Hash.SHA384
			name = "sha-512" when hash == Hash.SHA512
			fail joseError(JoseErrorKind.UnsupportedAlgorithm, "no thumbprint URI name for {hash}") when name == ""
			return "urn:ietf:params:oauth:jwk-thumbprint:{name}:{b64(thumbprint(hash))}"
		}
	}

	// The key type's members (RFC 7518 §6, RFC 8037 §2), the private
	// ones too when asked and present, in thumbprint order.
	internal def keyMembers(key Jwk, withPrivate bool) map<string, any> {
		let m map<string, any>
		match key.kty {
			case KeyType.Oct:
				m.set("k", b64(key.secret))
				m.set("kty", "oct")
			case KeyType.Rsa:
				let pub = key.public
				match pub {
					case RSAPublicKey:
						m.set("e", b64(bigint(pub.e).bytes()))
						m.set("kty", "RSA")
						m.set("n", b64(pub.n.bytes()))
					default:
				}
				let priv = key.private
				if withPrivate {
					match priv {
						case RSAPrivateKey:
							m.set("d", b64(priv.d.bytes()))
							if !priv.p.isZero() {
								m.set("p", b64(priv.p.bytes()))
								m.set("q", b64(priv.q.bytes()))
								m.set("dp", b64(priv.dp.bytes()))
								m.set("dq", b64(priv.dq.bytes()))
								m.set("qi", b64(priv.qinv.bytes()))
							}
						default:
					}
				}
			case KeyType.Ec:
				let pub = key.public
				match pub {
					case ECDSAPublicKey:
						let size = coordinateSize(pub.curve)
						m.set("crv", curveOfCrypto(pub.curve).value)
						m.set("kty", "EC")
						m.set("x", b64(pub.point.x.bytes(size) onerror recover []))
						m.set("y", b64(pub.point.y.bytes(size) onerror recover []))
					default:
				}
				let priv = key.private
				if withPrivate {
					match priv {
						case ECDSAPrivateKey:
							m.set("d", b64(priv.d.bytes(coordinateSize(priv.curve)) onerror recover []))
						default:
					}
				}
			case KeyType.Okp:
				let crv = key.curve
				m.set("crv", crv is none ?? (Curve.Ed25519.value, crv.value))
				m.set("kty", "OKP")
				let pub = key.public
				let priv = key.private
				match pub {
					case Ed25519PublicKey:
						m.set("x", b64(pub.bytes))
					case Ed448PublicKey:
						m.set("x", b64(pub.bytes))
					default:
						m.set("x", b64(key.agreementPublic))
				}
				if withPrivate {
					match priv {
						case Ed25519PrivateKey:
							m.set("d", b64(priv.seed))
						case Ed448PrivateKey:
							m.set("d", b64(priv.seed))
						default:
							m.set("d", b64(key.agreementPrivate)) when key.agreementPrivate.len() > 0
					}
				}
		}
		return m
	}

	// jwkObject is the key as a JWK object: its key members (the private
	// ones when asked and present) and the common parameters.
	internal def jwkObject(key Jwk, withPrivate bool) map<string, any> {
		let m = keyMembers(key, withPrivate)
		let kidValue = key.kid
		m.set("kid", kidValue) unless (kidValue is none)
		let usageValue = key.usage
		m.set("use", usageValue) unless (usageValue is none)
		if key.keyOps.len() > 0 {
			let ops any[] = []
			for let op in key.keyOps {
				ops.push(op)
			}
			m.set("key_ops", ops)
		}
		let algValue = key.alg
		m.set("alg", algValue) unless (algValue is none)
		let x5uValue = key.x5u
		m.set("x5u", x5uValue) unless (x5uValue is none)
		if key.x5c.len() > 0 {
			let certs any[] = []
			for let c in key.x5c {
				certs.push(b64std(c))
			}
			m.set("x5c", certs)
		}
		let t = key.x5t
		m.set("x5t", b64(t)) unless (t is none)
		let t256 = key.x5tS256
		m.set("x5t#S256", b64(t256)) unless (t256 is none)
		for let (k, kValue) in key.extra {
			m.set(k, kValue) unless m.hasKey(k)
		}
		return m
	}

	// JwkSet is a JWK Set (RFC 7517 §5).
	type JwkSet {
		keys Jwk[] = []

		def new(keys Jwk[] = []) {
			self.keys = keys
		}

		// find returns the key with this `kid`; none when no key has it.
		def find(kid string) ?Jwk {
			for let k in keys {
				let own = k.kid
				return k when !(own is none) && own == kid
			}
			return none
		}

		// json renders the set as `{"keys": [...]}`, each key as its json()
		// gives it.
		def json() string {
			let parts string[] = []
			for let k in keys {
				parts.push(k.json())
			}
			return "\{\"keys\":[" + parts.join(",") + "]\}"
		}
	}

	// parseKey reads one JWK. Fails with Malformed when the text is not a
	// JWK of valid shape, a public and private part disagree, or the first
	// `x5c` certificate holds another key; with UnsupportedAlgorithm for a
	// `kty` or `crv` this module does not implement, or a multi-prime RSA
	// key (`oth`).
	def parseKey(text string) !Jwk {
		return try jwkFromMembers(try parseObject(text, "JWK"))
	}

	// parseKeySet reads a JWK Set. Keys this module cannot use (an unknown
	// `kty` or `crv`, or a malformed key) are left out, as RFC 7517 §5
	// asks. Fails with Malformed when the text is not an object with a
	// `keys` array.
	def parseKeySet(text string) !JwkSet {
		let m = try parseObject(text, "JWK Set")
		fail joseError(JoseErrorKind.Malformed, "JWK Set has no \"keys\"") unless m.hasKey("keys")
		let list = m["keys"]
		let set = new JwkSet()
		match list {
			case any[]:
				for let item in list {
					match item {
						case map<string, any>:
							let key = jwkFromMembers(item)
							set.keys.push(key) when key is Jwk
						default:
					}
				}
			default:
				fail joseError(JoseErrorKind.Malformed, "\"keys\" must be an array")
		}
		return set
	}

	// generateKey makes a fresh key for a signature algorithm, with `alg`
	// set: a 256-, 384- or 512-bit secret for HS*, a 2048-bit RSA key for
	// RS* and PS*, the algorithm's curve for ES*, Ed25519 for EdDSA and
	// Ed25519, Ed448 for Ed448. Fails for None and when the random source
	// is unavailable.
	def generateKey(alg SignatureAlgorithm) !Jwk {
		fail joseError(JoseErrorKind.UnsupportedAlgorithm, "\"none\" has no key") when alg == SignatureAlgorithm.None
		let key = new Jwk(byte[])
		if isHmac(alg) {
			key = new Jwk(try rand(hashSize(signatureHash(alg))))
		} else if isRsaSignature(alg) {
			key = new Jwk(try crypto.generateRSAKey(2048))
		} else if alg == SignatureAlgorithm.Ed448 {
			key = new Jwk(try crypto.generateEd448Key())
		} else if alg := SignatureAlgorithm.EdDSA || SignatureAlgorithm.Ed25519 {
			key = new Jwk(try crypto.generateEd25519Key())
		} else {
			let crv = signatureCurve(alg)
			key = try generateKey(crv is none ?? (Curve.P256, crv))
		}
		key.alg = alg.value
		return key
	}

	// generateKey makes a fresh key for a key management algorithm, with
	// `alg` set: a 2048-bit RSA key for RSA*, a P-256 key for ECDH-ES*, a
	// secret of the right length for AES-KW, AES-GCMKW and dir (sized for
	// enc), a 32-byte random password for PBES2. Fails when the random
	// source is unavailable.
	def generateKey(alg KeyAlgorithm, enc ContentEncryption = ContentEncryption.A256Gcm) !Jwk {
		let key = new Jwk(byte[])
		if isRsaKeyAlgorithm(alg) {
			key = new Jwk(try crypto.generateRSAKey(2048))
		} else if isEcdh(alg) {
			key = try generateKey(Curve.P256)
		} else if alg == KeyAlgorithm.Direct {
			key = new Jwk(try rand(contentKeySize(enc)))
		} else if isPbes2(alg) {
			key = new Jwk(try rand(32))
		} else {
			key = new Jwk(try rand(wrapKeySize(alg)))
		}
		key.alg = alg.value
		return key
	}

	// generateKey makes a fresh EC or OKP key on a curve. Fails when the
	// random source is unavailable.
	def generateKey(curve Curve) !Jwk {
		match curve {
			case Curve.Ed25519:
				return new Jwk(try crypto.generateEd25519Key())
			case Curve.Ed448:
				return new Jwk(try crypto.generateEd448Key())
			case Curve.X25519:
				let scalar = try rand(32)
				return new Jwk(curve, try crypto.x25519Base(scalar), scalar)
			case Curve.X448:
				let scalar = try rand(56)
				return new Jwk(curve, try crypto.x448Base(scalar), scalar)
			default:
				let c = cryptoCurve(curve)
				return new Jwk(try crypto.generateECDSAKey(c is none ?? (crypto.p256, c)))
		}
	}

	// jwkFromMembers builds a key from a parsed JWK object.
	internal def jwkFromMembers(m map<string, any>) !Jwk {
		fail joseError(JoseErrorKind.Malformed, "JWK has no \"kty\"") unless m.hasKey("kty")
		let kty = try textOf(m, "kty")
		let key = new Jwk(byte[])
		let known string[] = ["kty", "kid", "use", "key_ops", "alg", "x5u", "x5c", "x5t", "x5t#S256"]
		match kty {
			case "oct":
				fail joseError(JoseErrorKind.Malformed, "oct JWK has no \"k\"") unless m.hasKey("k")
				key = new Jwk(try bytesOf(m, "k"))
				known.push("k")
			case "RSA":
				key = try rsaFromMembers(m)
				known.push("n", "e", "d", "p", "q", "dp", "dq", "qi")
			case "EC":
				key = try ecFromMembers(m)
				known.push("crv", "x", "y", "d")
			case "OKP":
				key = try okpFromMembers(m)
				known.push("crv", "x", "d")
			default:
				fail joseError(JoseErrorKind.UnsupportedAlgorithm, "unsupported kty \"{kty}\"")
		}
		key.kid = try textOf(m, "kid") when m.hasKey("kid")
		key.usage = try textOf(m, "use") when m.hasKey("use")
		key.alg = try textOf(m, "alg") when m.hasKey("alg")
		key.x5u = try textOf(m, "x5u") when m.hasKey("x5u")
		if m.hasKey("key_ops") {
			key.keyOps = try stringsOf(m, "key_ops")
			for let (i, op) in key.keyOps {
				fail joseError(JoseErrorKind.Malformed, "\"key_ops\" repeats \"{op}\"") when op in key.keyOps[0:i]
			}
		}
		if m.hasKey("x5c") {
			for let cert in try stringsOf(m, "x5c") {
				key.x5c.push(try unb64std(cert, "\"x5c\""))
			}
			fail joseError(JoseErrorKind.Malformed, "\"x5c\" is empty") when key.x5c.len() == 0
			let leaf = x509.parseCertificate(key.x5c[0]) onerror fail joseError(JoseErrorKind.Malformed, "\"x5c\" holds a certificate that does not parse")
			let certKey = leaf.publicKey
			let own = key.public
			let mismatch = joseError(JoseErrorKind.Malformed, "the first \"x5c\" certificate holds another key")
			fail mismatch when certKey is none || own is none
			fail mismatch unless marshalPKIXPublicKey(certKey).hex() == marshalPKIXPublicKey(own).hex()
		}
		if m.hasKey("x5t") {
			let t = try bytesOf(m, "x5t")
			fail joseError(JoseErrorKind.Malformed, "\"x5t\" must be 20 bytes") when t.len() != 20
			key.x5t = t
		}
		if m.hasKey("x5t#S256") {
			let t = try bytesOf(m, "x5t#S256")
			fail joseError(JoseErrorKind.Malformed, "\"x5t#S256\" must be 32 bytes") when t.len() != 32
			key.x5tS256 = t
		}
		for let (name, nameValue) in m {
			key.extra.set(name, nameValue) unless name in known
		}
		return key
	}

	internal def rsaFromMembers(m map<string, any>) !Jwk {
		fail joseError(JoseErrorKind.UnsupportedAlgorithm, "multi-prime RSA keys (\"oth\") are not supported") when m.hasKey("oth")
		fail joseError(JoseErrorKind.Malformed, "RSA JWK needs \"n\" and \"e\"") unless m.hasKey("n") && m.hasKey("e")
		let n = parseBigInt(try bytesOf(m, "n"))
		let eBig = parseBigInt(try bytesOf(m, "e"))
		fail joseError(JoseErrorKind.Malformed, "RSA exponent is out of range") when eBig < bigint(3) || eBig.bitLen() > 31
		let e = parseInt<int>(eBig.toRadix(10))
		fail joseError(JoseErrorKind.Malformed, "RSA modulus is too small") when n.bitLen() < 512
		if !m.hasKey("d") {
			fail joseError(JoseErrorKind.Malformed, "RSA public JWK has private members") when m.hasKey("p") || m.hasKey("q") || m.hasKey("dp") || m.hasKey("dq") || m.hasKey("qi")
			return new Jwk(new RSAPublicKey(n, e))
		}
		let d = parseBigInt(try bytesOf(m, "d"))
		let crt = m.hasKey("p") || m.hasKey("q") || m.hasKey("dp") || m.hasKey("dq") || m.hasKey("qi")
		return new Jwk(new RSAPrivateKey(n, e, d, bigint(0), bigint(0), bigint(0), bigint(0), bigint(0))) unless crt
		fail joseError(JoseErrorKind.Malformed, "RSA JWK has some CRT members but not all") unless m.hasKey("p") && m.hasKey("q") && m.hasKey("dp") && m.hasKey("dq") && m.hasKey("qi")
		let p = parseBigInt(try bytesOf(m, "p"))
		let q = parseBigInt(try bytesOf(m, "q"))
		fail joseError(JoseErrorKind.Malformed, "RSA primes do not multiply to the modulus") unless p * q == n
		let dp = parseBigInt(try bytesOf(m, "dp"))
		let dq = parseBigInt(try bytesOf(m, "dq"))
		let qi = parseBigInt(try bytesOf(m, "qi"))
		return new Jwk(new RSAPrivateKey(n, e, d, p, q, dp, dq, qi))
	}

	internal def ecFromMembers(m map<string, any>) !Jwk {
		fail joseError(JoseErrorKind.Malformed, "EC JWK needs \"crv\", \"x\" and \"y\"") unless m.hasKey("crv") && m.hasKey("x") && m.hasKey("y")
		let name = try textOf(m, "crv")
		let crv = curveOf(name)
		let c = crv is none ?? (none, cryptoCurve(crv))
		fail joseError(JoseErrorKind.UnsupportedAlgorithm, "unsupported EC curve \"{name}\"") when c is none
		let size = coordinateSize(c)
		let x = try bytesOf(m, "x")
		let y = try bytesOf(m, "y")
		fail joseError(JoseErrorKind.Malformed, "EC coordinates must be {size} bytes") when x.len() != size || y.len() != size
		let point = Point{x: parseBigInt(x), y: parseBigInt(y)}
		fail joseError(JoseErrorKind.Malformed, "EC point is not on {name}") unless isOnCurve(c, point)
		return new Jwk(new ECDSAPublicKey(c, point)) unless m.hasKey("d")
		let dBytes = try bytesOf(m, "d")
		fail joseError(JoseErrorKind.Malformed, "EC private key must be {size} bytes") when dBytes.len() != size
		let d = parseBigInt(dBytes)
		fail joseError(JoseErrorKind.Malformed, "EC private key is out of range") when d.isZero() || d >= c.n
		let derived = scalarBaseMult(c, d)
		fail joseError(JoseErrorKind.Malformed, "EC private key does not match its public point") unless derived.x == point.x && derived.y == point.y
		return new Jwk(new ECDSAPrivateKey(c, d, point))
	}

	internal def okpFromMembers(m map<string, any>) !Jwk {
		fail joseError(JoseErrorKind.Malformed, "OKP JWK needs \"crv\" and \"x\"") unless m.hasKey("crv") && m.hasKey("x")
		let name = try textOf(m, "crv")
		let crv = curveOf(name)
		fail joseError(JoseErrorKind.UnsupportedAlgorithm, "unsupported OKP curve \"{name}\"") when crv is none
		fail joseError(JoseErrorKind.UnsupportedAlgorithm, "unsupported OKP curve \"{name}\"") unless crv in [Curve.Ed25519, Curve.Ed448, Curve.X25519, Curve.X448]
		let x = try bytesOf(m, "x")
		let d = m.hasKey("d") ?? (try bytesOf(m, "d"), byte[])
		let mismatch = joseError(JoseErrorKind.Malformed, "OKP private key does not match its public key")
		match crv {
			case Curve.Ed25519:
				let pub = crypto.newEd25519PublicKey(x) onerror fail joseError(JoseErrorKind.Malformed, "bad Ed25519 public key")
				return new Jwk(pub) when d.len() == 0
				let priv = crypto.newEd25519PrivateKey(d) onerror fail joseError(JoseErrorKind.Malformed, "bad Ed25519 private key")
				fail mismatch unless priv.public.bytes.hex() == x.hex()
				return new Jwk(priv)
			case Curve.Ed448:
				let pub = crypto.newEd448PublicKey(x) onerror fail joseError(JoseErrorKind.Malformed, "bad Ed448 public key")
				return new Jwk(pub) when d.len() == 0
				let priv = crypto.newEd448PrivateKey(d) onerror fail joseError(JoseErrorKind.Malformed, "bad Ed448 private key")
				fail mismatch unless priv.public.bytes.hex() == x.hex()
				return new Jwk(priv)
			default:
				let wide = curveIs(crv, [Curve.X448])
				let size = wide ?? (56, 32)
				fail joseError(JoseErrorKind.Malformed, "{name} keys are {size} bytes") when x.len() != size || (d.len() > 0 && d.len() != size)
				if d.len() > 0 {
					let derived = wide ?? (try crypto.x448Base(d), try crypto.x25519Base(d))
					fail mismatch unless derived.hex() == x.hex()
				}
				return new Jwk(wide ?? (Curve.X448, Curve.X25519), x, d)
		}
	}
}
