partial module std.proto.auth.jose {
	use std.proto.auth.jose.engine::*

	// JwsSignature is one signature of a JWS: its protected header, its
	// unprotected header (JSON serialization only) and the signature bytes.
	struct JwsSignature {
		protected              Header
		header                 ?Header
		signature              byte[]
		// The protected header as base64url text, as it was signed.
		internal protectedText string
	}

	// Jws is a JSON Web Signature (RFC 7515): a payload and one or more
	// signatures over it. With `detached` the payload travels separately
	// (RFC 7515 Appendix F): set `payload` before verify.
	//
	// ```
	// let jws = new jose.Jws("hello".bytes())
	// try jws.sign(rsaKey, jose.SignatureAlgorithm.PS256)
	// try jws.sign(ecKey)
	// let text = try jws.json()
	// ```
	type Jws {
		payload                byte[]         = []
		signatures             JwsSignature[] = []
		detached               bool           = false
		// The payload as it appeared in the serialization, when parsed.
		internal signedPayload byte[]         = []
		internal received      bool           = false

		def new(payload byte[] = []) {
			self.payload = payload
		}

		// sign adds a signature by key. alg defaults to the key's `alg`, else
		// to the usual algorithm for the key (HS256, RS256, the curve's ES*,
		// EdDSA). The protected header gets `alg` and, unless it has one,
		// the key's `kid`; `b64: false` is added to `crit` as RFC 7797
		// requires. Fails with KeyMismatch when the key cannot sign with
		// the algorithm (an RSA key under 2048 bits, an HMAC key shorter
		// than its digest, a public key), with Malformed when the headers
		// share a parameter or disagree with earlier signatures on `b64`.
		def sign(key Jwk, alg ?SignatureAlgorithm = none, protected ?Header = none, unprotected ?Header = none) !none {
			let a = alg is none ?? (try defaultAlgorithm(key), alg)
			fail joseError(JoseErrorKind.UnsupportedAlgorithm, "use unsecured() for \"none\"") when a == SignatureAlgorithm.None
			fail joseError(JoseErrorKind.KeyMismatch, "the key cannot sign with {a.value}") unless signatureFits(a, key, true)
			let p = protected is none ?? (new Header(), try headerFromText(protected.json(), "header"))
			p.alg = a.value
			let keyId = key.kid
			let headerId = p.kid
			let sharedId = unprotected is none ?? (none, unprotected.kid)
			p.kid = keyId when headerId is none && sharedId is none && !(keyId is none)
			let encoded = try addProtected(p, unprotected)
			let input = (encoded + ".").bytes() + payloadPart(self, isEncoded(p))
			let signature = try signWith(a, key, input)
			signatures.push(JwsSignature{protected: p, header: unprotected, signature: signature, protectedText: encoded})
			return none
		}

		// verify checks the signatures against keys and returns the payload
		// when one verifies with an algorithm from `algorithms`. Keys are
		// matched by `kid` (keys without one are tried too), then by type,
		// curve, size, `alg`, `use` and `key_ops`. Fails with
		// AlgorithmNotAllowed, UnsupportedAlgorithm, KeyMismatch,
		// CriticalUnknown or Malformed for the first signature that could
		// not be checked, BadSignature when the rest did not verify.
		def verify(keys JwkSet, algorithms SignatureAlgorithm[]) !byte[] {
			fail joseError(JoseErrorKind.Malformed, "JWS has no signature") when signatures.len() == 0
			let first ?error = none
			for let sig in signatures {
				let ok = verifyOne(self, sig, keys, algorithms) onerror (err error) {
					first = err when first is none
					recover false
				}
				return payload when ok
			}
			fail first unless first is none
			fail joseError(JoseErrorKind.BadSignature, "no signature verified")
		}

		// verify checks the signatures against a remote key set, fetching it
		// again when it lacks the `kid` a signature names. Fails as the
		// JwkSet overload does, and with KeyUnavailable when the set cannot
		// be fetched.
		def verify(keys RemoteKeySet, algorithms SignatureAlgorithm[]) !byte[] {
			let kids string[] = []
			for let sig in signatures {
				let id = sig.protected.kid
				let unprotected = sig.header
				let shared = unprotected is none ?? (none, unprotected.kid)
				kids.push(id) unless id is none
				kids.push(shared) unless shared is none
			}
			return try verify(try keys.keysFor(kids), algorithms)
		}

		// verify checks the signatures against one key. Fails as the JwkSet
		// overload does.
		def verify(key Jwk, algorithms SignatureAlgorithm[]) !byte[] {
			return try verify(new JwkSet([key]), algorithms)
		}

		// compact renders the JWS Compact Serialization. Fails with
		// Malformed unless there is exactly one signature without an
		// unprotected header, or when a `b64: false` payload holds a period
		// and is not detached.
		def compact() !string {
			fail joseError(JoseErrorKind.Malformed, "compact form needs exactly one signature") when signatures.len() != 1
			let sig = signatures[0]
			fail joseError(JoseErrorKind.Malformed, "compact form has no unprotected header") unless sig.header is none
			let encoded = isEncoded(sig.protected)
			let body = detached ?? ("", string(payloadPart(self, encoded)))
			fail joseError(JoseErrorKind.Malformed, "an unencoded payload with a period cannot be compact") when !encoded && !detached && body.contains(".")
			return sig.protectedText + "." + body + "." + b64(sig.signature)
		}

		// json renders the JWS JSON Serialization, general by default,
		// flattened when asked. Fails with Malformed when flattened has
		// other than one signature.
		def json(flattened bool = false) !string {
			fail joseError(JoseErrorKind.Malformed, "JWS has no signature") when signatures.len() == 0
			fail joseError(JoseErrorKind.Malformed, "flattened form needs exactly one signature") when flattened && signatures.len() != 1
			let m map<string, any>
			m.set("payload", string(payloadPart(self, isEncoded(signatures[0].protected)))) unless detached
			let list any[] = []
			for let sig in signatures {
				let entry map<string, any>
				entry.set("protected", sig.protectedText) when sig.protectedText != ""
				let h = sig.header
				entry.set("header", headerMembers(h)) unless h is none
				entry.set("signature", b64(sig.signature))
				if flattened {
					for let (k, kValue) in entry {
						m.set(k, kValue)
					}
				} else {
					list.push(entry)
				}
			}
			m.set("signatures", list) unless flattened
			return encodeJSON(m)
		}

		// addProtected encodes a new signature's protected header, checking
		// it against the unprotected one and the other signatures.
		internal def addProtected(p Header, unprotected ?Header) !string {
			let parts Header[] = [p]
			parts.push(unprotected) unless unprotected is none
			try mergeHeaders(parts)
			let encoded = isEncoded(p)
			p.crit.push("b64") when !encoded && !("b64" in p.crit)
			for let other in signatures {
				fail joseError(JoseErrorKind.Malformed, "signatures disagree on \"b64\"") when isEncoded(other.protected) != encoded
			}
			return b64(p.json().bytes())
		}
	}

	// sign signs payload with key and returns the JWS Compact
	// Serialization; header supplies more protected parameters. Defaults
	// as Jws.sign; fails as Jws.sign and Jws.compact do.
	//
	// ```
	// let token = try jose.sign("hello".bytes(), key, jose.SignatureAlgorithm.ES256)
	// ```
	def sign(payload byte[], key Jwk, alg ?SignatureAlgorithm = none, header ?Header = none) !string {
		return try signCompact(payload, key, alg, header)
	}

	internal def signCompact(payload byte[], key Jwk, alg ?SignatureAlgorithm, header ?Header) !string {
		let jws = new Jws(payload)
		try jws.sign(key, alg, header)
		return try jws.compact()
	}

	// unsecured returns an unsecured JWS (`alg: "none"`, empty signature)
	// in the compact form. Only a verification that lists
	// SignatureAlgorithm.None accepts it. Fails with Malformed when header
	// has a malformed parameter.
	def unsecured(payload byte[], header ?Header = none) !string {
		return try unsecuredCompact(payload, header)
	}

	internal def unsecuredCompact(payload byte[], header ?Header) !string {
		let p = header is none ?? (new Header(), try headerFromText(header.json(), "header"))
		p.alg = SignatureAlgorithm.None.value
		return b64(p.json().bytes()) + "." + b64(payload) + "."
	}

	// parseJws reads a JWS in the compact, flattened JSON or general JSON
	// serialization. Nothing is verified. Fails with Malformed when the
	// text is none of those, a part is not base64url, or a header is not
	// a JSON object.
	def parseJws(text string) !Jws {
		let t = text.trim()
		return try parseJwsJson(t) when t.startsWith("\{")
		let parts = t.split(".")
		fail joseError(JoseErrorKind.Malformed, "a compact JWS has three parts") when parts.len() != 3
		let protected = try headerFromText(string(try unb64(parts[0], "protected header")), "protected header")
		let jws = new Jws()
		jws.signatures.push(JwsSignature{protected: protected, header: none, signature: try unb64(parts[2], "signature"), protectedText: parts[0]})
		try setPayload(jws, parts[1], isEncoded(protected))
		return jws
	}

	// payloadPart is the payload as signed: as it appeared when parsed,
	// else base64url text, or the bytes themselves under `b64: false`.
	internal def payloadPart(jws Jws, encoded bool) byte[] {
		return jws.signedPayload when jws.received && !jws.detached
		return encoded ?? (b64(jws.payload).bytes(), jws.payload)
	}

	// isEncoded reports whether the payload is base64url-encoded: true
	// unless the protected header says `b64: false`.
	internal def isEncoded(h Header) bool {
		let flag = h.b64
		return flag is none ?? (true, flag)
	}

	internal def setPayload(jws Jws, part string, encoded bool) !none {
		jws.received = true
		jws.detached = part == ""
		jws.signedPayload = part.bytes()
		jws.payload = encoded ?? (try unb64(part, "payload"), part.bytes())
		return none
	}

	internal def parseJwsJson(text string) !Jws {
		let m = try parseObject(text, "JWS")
		let jws = new Jws()
		let entries map<string, any>[] = []
		if m.hasKey("signatures") {
			fail joseError(JoseErrorKind.Malformed, "a JWS has \"signatures\" or \"signature\", not both") when m.hasKey("signature")
			let list = m["signatures"]
			match list {
				case any[]:
					for let item in list {
						match item {
							case map<string, any>:
								entries.push(item)
							default:
								fail joseError(JoseErrorKind.Malformed, "\"signatures\" must hold objects")
						}
					}
				default:
					fail joseError(JoseErrorKind.Malformed, "\"signatures\" must be an array")
			}
		} else {
			fail joseError(JoseErrorKind.Malformed, "JWS has no signature") unless m.hasKey("signature")
			entries.push(m)
		}
		fail joseError(JoseErrorKind.Malformed, "JWS has no signature") when entries.len() == 0
		for let entry in entries {
			let protectedText = entry.hasKey("protected") ?? (try textOf(entry, "protected"), "")
			fail joseError(JoseErrorKind.Malformed, "a signature needs a header") when protectedText == "" && !entry.hasKey("header")
			let protected = protectedText == "" ?? (new Header(), try headerFromText(string(try unb64(protectedText, "protected header")), "protected header"))
			let header = entry.hasKey("header") ?? (try parseHeader(try objectOf(entry, "header")), none)
			fail joseError(JoseErrorKind.Malformed, "a signature needs \"signature\"") unless entry.hasKey("signature")
			jws.signatures.push(JwsSignature{protected: protected, header: header, signature: try bytesOf(entry, "signature"), protectedText: protectedText})
		}
		let encoded = isEncoded(jws.signatures[0].protected)
		for let sig in jws.signatures {
			fail joseError(JoseErrorKind.Malformed, "signatures disagree on \"b64\"") when isEncoded(sig.protected) != encoded
		}
		if m.hasKey("payload") {
			try setPayload(jws, try textOf(m, "payload"), encoded)
		} else {
			jws.detached = true
		}
		return jws
	}

	// verifyOne checks one signature: true when a key verifies it, false
	// when the candidate keys do not. Policy failures are errors.
	internal def verifyOne(jws Jws, sig JwsSignature, keys JwkSet, algorithms SignatureAlgorithm[]) !bool {
		let parts Header[] = [sig.protected]
		let unprotected = sig.header
		parts.push(unprotected) unless unprotected is none
		let merged = try mergeHeaders(parts)
		let name = merged.alg
		fail joseError(JoseErrorKind.Malformed, "the header has no \"alg\"") when name is none
		let alg = signatureAlgorithmOf(name)
		fail joseError(JoseErrorKind.UnsupportedAlgorithm, "unsupported algorithm \"{name}\"") when alg is none
		fail joseError(JoseErrorKind.AlgorithmNotAllowed, "algorithm {name} is not allowed") unless alg in algorithms
		try checkCritical(sig.protected, merged, ["b64"])
		if !(unprotected is none) {
			fail joseError(JoseErrorKind.Malformed, "\"b64\" must be in the protected header") unless unprotected.b64 is none
		}
		let encoded = isEncoded(sig.protected)
		fail joseError(JoseErrorKind.Malformed, "\"b64\" must be listed in \"crit\"") when !(sig.protected.b64 is none) && !("b64" in sig.protected.crit)
		let input = (sig.protectedText + ".").bytes() + payloadPart(jws, encoded)
		return sig.signature.len() == 0 when alg == SignatureAlgorithm.None
		let candidates = candidateKeys(keys, merged.kid)
		let tried = false
		for let key in candidates {
			continue unless signatureFits(alg, key, false)
			tried = true
			return true when verifyWith(alg, key, input, sig.signature)
		}
		fail joseError(JoseErrorKind.KeyMismatch, "no key fits {name}") unless tried
		return false
	}

	// candidateKeys narrows a key set by `kid`: the keys with that id and
	// the keys with none; every key when the header names none.
	internal def candidateKeys(keys JwkSet, kid ?string) Jwk[] {
		return keys.keys when kid is none
		let out Jwk[] = []
		for let k in keys.keys {
			let own = k.kid
			out.push(k) when own is none || own == kid
		}
		return out
	}

	// defaultAlgorithm is the algorithm a key signs with when none is
	// given: its `alg`, else HS256, RS256, the curve's ECDSA algorithm or
	// EdDSA. Fails with UnsupportedAlgorithm for an `alg` that is not a
	// signature algorithm, KeyMismatch for an X25519 or X448 key.
	internal def defaultAlgorithm(key Jwk) !SignatureAlgorithm {
		let named = key.alg
		if !(named is none) {
			let a = signatureAlgorithmOf(named)
			fail joseError(JoseErrorKind.UnsupportedAlgorithm, "key alg \"{named}\" is not a signature algorithm") when a is none
			return a
		}
		match key.kty {
			case KeyType.Oct:
				return SignatureAlgorithm.HS256
			case KeyType.Rsa:
				return SignatureAlgorithm.RS256
			case KeyType.Ec:
				let c = key.curve
				return SignatureAlgorithm.ES384 when curveIs(c, [Curve.P384])
				return SignatureAlgorithm.ES512 when curveIs(c, [Curve.P521])
				return SignatureAlgorithm.ES256K when curveIs(c, [Curve.Secp256k1])
				return SignatureAlgorithm.ES256
			default:
				fail joseError(JoseErrorKind.KeyMismatch, "an agreement key cannot sign") unless curveIs(key.curve, [Curve.Ed25519, Curve.Ed448])
				return SignatureAlgorithm.EdDSA
		}
	}
}
