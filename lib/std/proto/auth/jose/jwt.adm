partial module std.proto.auth.jose {
	use (
		std.time
		std.proto.auth.jose.engine::*
	)

	// Claims is a JWT claims set (RFC 7519 §4): the registered claims as
	// fields, any other claim through get and set. Times are whole or
	// fractional seconds since the epoch on the wire (NumericDate).
	//
	// ```
	// let claims = new jose.Claims()
	// claims.subject = "alice"
	// claims.expires = time.now() + 1h
	// try claims.set("role", "admin")
	// let token = try claims.sign(key)
	// ```
	type Claims {
		issuer         ?string
		subject        ?string
		// One or more audiences; one is written as a plain string.
		audience       string[]         = []
		expires        ?time.Time
		notBefore      ?time.Time
		issuedAt       ?time.Time
		id             ?string
		internal extra map<string, any>

		def new() {}

		// get returns a claim as it appears in JSON (a registered time as
		// its NumericDate); none when the set does not have it.
		def get(name string) ?any {
			let m = claimMembers(self)
			return m.get(name)
		}

		// set sets a claim from its JSON form; a registered name sets its
		// field. Fails with Malformed when the value does not fit a
		// registered claim.
		def set(name string, value any) !none {
			let m map<string, any>
			m.set(name, value)
			try applyClaim(self, m, name)
			return none
		}

		// json renders the claims set as a JSON object.
		def json() string {
			return encodeJSON(claimMembers(self))
		}

		// sign returns the claims as a signed JWT (JWS compact form, `typ:
		// "JWT"` unless header sets another). See Jws.sign for the
		// algorithm default and when it fails.
		def sign(key Jwk, alg ?SignatureAlgorithm = none, header ?Header = none) !string {
			let h = header is none ?? (new Header(), try headerFromText(header.json(), "header"))
			let t = h.typ
			h.typ = "JWT" when t is none
			return try signCompact(json().bytes(), key, alg, h)
		}

		// encrypt returns the claims as an encrypted JWT (JWE compact form,
		// `typ: "JWT"` unless header sets another). See jose.encrypt for
		// when it fails.
		def encrypt(key Jwk, alg KeyAlgorithm, enc ContentEncryption, header ?Header = none) !string {
			let h = header is none ?? (new Header(), try headerFromText(header.json(), "header"))
			let t = h.typ
			h.typ = "JWT" when t is none
			return try encryptCompact(json().bytes(), key, alg, enc, h)
		}

		// unsecured returns the claims as an unsecured JWT (`alg: "none"`),
		// which only a Validation listing SignatureAlgorithm.None accepts.
		// Fails only when header has a malformed parameter.
		def unsecured(header ?Header = none) !string {
			let h = header is none ?? (new Header(), try headerFromText(header.json(), "header"))
			let t = h.typ
			h.typ = "JWT" when t is none
			return try unsecuredCompact(json().bytes(), h)
		}
	}

	// Validation says what verifyJwt accepts. `algorithms` must list the
	// signature algorithms expected (RFC 8725 §3.1); an encrypted JWT also
	// needs `keyAlgorithms` and `encryptions`.
	struct Validation {
		algorithms    SignatureAlgorithm[] = []
		keyAlgorithms KeyAlgorithm[]       = []
		encryptions   ContentEncryption[]  = []
		// The `iss` the token must have; none accepts any.
		issuer        ?string
		// This party's audience: the token's `aud` must contain it. A token
		// with an `aud` is refused when this is none (RFC 7519 §4.1.3).
		audience      ?string
		// The `sub` the token must have; none accepts any.
		subject       ?string
		// The `typ` the token must have, compared without case and with or
		// without "application/" (RFC 8725 §3.11); none accepts any.
		typ           ?string
		// Slack for clock differences when checking `exp` and `nbf`.
		leeway        duration             = 60s
		// The time the token is checked at; none means now.
		now           ?time.Time
		// Refuse a token without `exp`.
		requireExpiry bool                 = true
		// The largest decrypted plaintext accepted.
		maxSize       int                  = 16777216
	}

	// verifyJwt checks a JWT and returns its claims: the signature (or, for
	// an encrypted JWT, the decryption), nested JWTs (`cty: "JWT"`, at most
	// two levels), `typ`, then the claims against validation. Fails with
	// AlgorithmNotAllowed, BadSignature, DecryptionFailed and the other
	// kinds Jws.verify and Jwe.decrypt report, Expired, NotYetValid,
	// ClaimMismatch for a missing `exp` or a claim that does not match,
	// Malformed when the token or its claims are not well formed.
	def verifyJwt(token string, keys JwkSet, validation Validation) !Claims {
		return try verifyNested(token, keys, validation, 0, true)
	}

	// verifyJwt against a remote key set (an issuer's `jwks_uri`), fetched
	// again when it lacks the token's `kid`. Fails as the JwkSet overload
	// does, and with KeyUnavailable when the set cannot be fetched.
	def verifyJwt(token string, keys RemoteKeySet, validation Validation) !Claims {
		let kid = tokenKid(token)
		return try verifyJwt(token, try keys.keysFor(kid is none ?? ([], [kid])), validation)
	}

	// tokenKid is the `kid` of a compact token's protected header, none when
	// it has none or the token does not parse.
	internal def tokenKid(token string) ?string {
		let parts = token.trim().split(".")
		return none when parts.len() < 3
		let text = unb64(parts[0], "header") onerror recover byte[]
		let header = headerFromText(string(text), "header") onerror recover new Header()
		return header.kid
	}

	// verifyJwt with one key. Fails as the JwkSet overload does.
	def verifyJwt(token string, key Jwk, validation Validation) !Claims {
		return try verifyJwt(token, new JwkSet([key]), validation)
	}

	// parseClaims reads a claims set without verifying anything. Fails
	// with Malformed when the text is not a JSON object or a registered
	// claim has the wrong type.
	def parseClaims(text string) !Claims {
		let m = try parseObject(text, "claims")
		let c = new Claims()
		for let name in m.keys() {
			try applyClaim(c, m, name)
		}
		return c
	}

	internal def verifyNested(token string, keys JwkSet, validation Validation, depth int, outer bool) !Claims {
		fail joseError(JoseErrorKind.Malformed, "nested JWTs are limited to two levels") when depth > 2
		let parts = token.trim().split(".")
		let header Header = new Header()
		let body byte[] = []
		if parts.len() == 5 {
			let jwe = try parseJwe(token)
			body = try jwe.decrypt(keys, validation.keyAlgorithms, validation.encryptions, validation.maxSize)
			header = jwe.protected
		} else if parts.len() == 3 {
			let jws = try parseJws(token)
			body = try jws.verify(keys, validation.algorithms)
			header = jws.signatures[0].protected
		} else {
			fail joseError(JoseErrorKind.Malformed, "a JWT is a compact JWS or JWE")
		}
		if outer {
			try checkType(header, validation.typ)
		}
		let cty = header.cty
		return try verifyNested(string(body), keys, validation, depth + 1, false) when !(cty is none) && (cty.lower() == "jwt" || cty.lower() == "application/jwt")
		let claims = try parseClaims(string(body))
		try checkClaims(claims, validation)
		return claims
	}

	internal def checkType(header Header, want ?string) !none {
		return none when want is none
		let got = header.typ
		fail joseError(JoseErrorKind.ClaimMismatch, "the token has no \"typ\"") when got is none
		fail joseError(JoseErrorKind.ClaimMismatch, "\"typ\" is \"{got}\", not \"{want}\"") unless mediaType(got) == mediaType(want)
		return none
	}

	// mediaType lowers a `typ` and drops "application/" (RFC 7515 §4.1.9).
	internal def mediaType(t string) string {
		let lower = t.lower()
		return lower.startsWith("application/") ?? (lower["application/".len():], lower)
	}

	internal def checkClaims(c Claims, v Validation) !none {
		let given = v.now
		let now = given is none ?? (time.now(), given)
		let exp = c.expires
		if exp is none {
			fail joseError(JoseErrorKind.ClaimMismatch, "the token has no \"exp\"") when v.requireExpiry
		} else {
			fail joseError(JoseErrorKind.Expired, "the token expired at {exp.str()}") unless now.before(exp + v.leeway)
		}
		let nbf = c.notBefore
		if !(nbf is none) {
			fail joseError(JoseErrorKind.NotYetValid, "the token is not valid before {nbf.str()}") when (now + v.leeway).before(nbf)
		}
		let wantIssuer = v.issuer
		if !(wantIssuer is none) {
			let iss = c.issuer
			fail joseError(JoseErrorKind.ClaimMismatch, "\"iss\" does not match") unless !(iss is none) && iss == wantIssuer
		}
		let wantSubject = v.subject
		if !(wantSubject is none) {
			let sub = c.subject
			fail joseError(JoseErrorKind.ClaimMismatch, "\"sub\" does not match") unless !(sub is none) && sub == wantSubject
		}
		let wantAudience = v.audience
		if wantAudience is none {
			fail joseError(JoseErrorKind.ClaimMismatch, "the token has an \"aud\" and no audience was given") when c.audience.len() > 0
		} else {
			fail joseError(JoseErrorKind.ClaimMismatch, "\"aud\" does not include {wantAudience}") unless wantAudience in c.audience
		}
		return none
	}

	// The claims as JSON values, registered claims first.
	internal def claimMembers(c Claims) map<string, any> {
		let m map<string, any>
		let iss = c.issuer
		m.set("iss", iss) unless iss is none
		let sub = c.subject
		m.set("sub", sub) unless sub is none
		if c.audience.len() == 1 {
			m.set("aud", c.audience[0])
		} else if c.audience.len() > 1 {
			let list any[] = []
			for let a in c.audience {
				list.push(a)
			}
			m.set("aud", list)
		}
		let exp = c.expires
		m.set("exp", numericDate(exp)) unless exp is none
		let nbf = c.notBefore
		m.set("nbf", numericDate(nbf)) unless nbf is none
		let iat = c.issuedAt
		m.set("iat", numericDate(iat)) unless iat is none
		let jti = c.id
		m.set("jti", jti) unless jti is none
		for let (name, nameValue) in c.extra {
			m.set(name, nameValue) unless m.hasKey(name)
		}
		return m
	}

	// numericDate is whole seconds since the epoch, the usual form.
	internal def numericDate(t time.Time) int {
		return int(t.unixNs() / 1000000000)
	}

	internal def timeOf(m map<string, any>, name string) !time.Time {
		let v = try member(m, name)
		match v {
			case int:
				return time.fromUnixNs(int64(v) * 1000000000)
			case float:
				return time.fromUnixNs(int64(v * 1000000000.0))
			default:
				fail joseError(JoseErrorKind.Malformed, "\"{name}\" must be a number of seconds")
		}
	}

	internal def applyClaim(c Claims, m map<string, any>, name string) !none {
		match name {
			case "iss":
				c.issuer = try textOf(m, name)
			case "sub":
				c.subject = try textOf(m, name)
			case "aud":
				let v = try member(m, name)
				match v {
					case string:
						c.audience = [v]
					default:
						c.audience = try stringsOf(m, name)
				}
			case "exp":
				c.expires = try timeOf(m, name)
			case "nbf":
				c.notBefore = try timeOf(m, name)
			case "iat":
				c.issuedAt = try timeOf(m, name)
			case "jti":
				c.id = try textOf(m, name)
			default:
				c.extra.set(name, try member(m, name))
		}
		return none
	}
}
