partial module std.proto.auth.jose {
	use (
		std.time
		std.net.http
		std.proto.auth.jose.engine::*
	)

	// RemoteKeySet is a JWK Set published at a URL (an issuer's `jwks_uri`).
	// It is fetched on first use and kept for the response's `Cache-Control`
	// max-age, at most maxAge. When a token names a `kid` the cached set
	// lacks, the set is fetched again (the issuer rotated its keys), at most
	// once per minRefresh. Safe to share between tasks; a fetch never holds
	// the lock verifications read the cache under.
	//
	// ```
	// let keys = new jose.RemoteKeySet("https://issuer.example/jwks")
	// let claims = try jose.verifyJwt(token, keys, validation)
	// ```
	type RemoteKeySet {
		url                  string
		// The client fetches go through; a default client when none.
		client               ?http.Client
		// The longest a fetched set is trusted without fetching again.
		maxAge               duration = 1h
		// The shortest time between two fetches caused by unknown `kid`s.
		minRefresh           duration = 30s
		internal cached      JwkSet
		internal expires     time.Time
		internal lastFetch   time.Time
		internal fetchedOnce bool     = false

		def new(url string, client ?http.Client = none) {
			self.url = url
			self.client = client
			cached = new JwkSet()
		}

		// keys returns the set, fetching it when it was never fetched or has
		// expired. Fails with KeyUnavailable when a fetch is needed and fails
		// and no earlier set exists; an expired set is kept while the URL
		// is unreachable.
		def keys() !JwkSet {
			let (set, fresh, any) = snapshot(time.now())
			return set when fresh
			let fetched = fetch() onerror (err error) {
				fail err unless any
				recover set
			}
			return fetched
		}

		// keysFor returns the set, fetched again first when it holds none of
		// the given `kid`s and the last fetch is older than minRefresh. Fails
		// as keys does.
		def keysFor(kids string[]) !JwkSet {
			let set = try keys()
			return set when kids.len() == 0 || holdsAny(set, kids)
			return set unless claimRefresh(time.now())
			return fetch() onerror recover set
		}

		// refresh fetches the set now. Fails with KeyUnavailable when the
		// URL does not answer with a JWK Set.
		def refresh() !JwkSet {
			return try fetch()
		}

		internal def fetch() !JwkSet {
			let c = client
			let http = c is none ?? (new http.Client(), c)
			let res = http.get(url) onerror (err error) {
				fail JoseError{message: "jose: cannot fetch keys from {url}: {err.message}", code: JoseErrorKind.KeyUnavailable.name, cause: err, kind: JoseErrorKind.KeyUnavailable}
			}
			fail joseError(JoseErrorKind.KeyUnavailable, "{url} answered {res.status}") unless res.ok()
			let text = res.text() onerror fail joseError(JoseErrorKind.KeyUnavailable, "cannot read keys from {url}")
			let set = parseKeySet(text) onerror fail joseError(JoseErrorKind.KeyUnavailable, "{url} did not return a JWK Set")
			let now = time.now()
			let age = cacheAge(res.header("Cache-Control"), maxAge)
			store(set, now + age, now)
			return set
		}

		internal atomic def snapshot(now time.Time) (JwkSet, bool, bool) {
			return (cached, fetchedOnce && now.before(expires), fetchedOnce)
		}

		internal atomic def store(set JwkSet, until time.Time, at time.Time) {
			cached = set
			expires = until
			lastFetch = at
			fetchedOnce = true
		}

		internal atomic def claimRefresh(now time.Time) bool {
			return false when fetchedOnce && now.before(lastFetch + minRefresh)
			lastFetch = now
			return true
		}
	}

	// holdsAny reports whether the set has a key with one of the ids.
	internal def holdsAny(set JwkSet, kids string[]) bool {
		for let k in set.keys {
			let id = k.kid
			return true when !(id is none) && id in kids
		}
		return false
	}

	// cacheAge reads `max-age` from a Cache-Control value, bounded by
	// limit; limit when there is none, zero for `no-store`/`no-cache`.
	internal def cacheAge(header string, limit duration) duration {
		let age = limit
		for let part in header.lower().split(",") {
			let p = part.trim()
			return 0s when p == "no-store" || p == "no-cache"
			if p.startsWith("max-age=") {
				let given = 1s * float(parseInt<int>(p["max-age=".len():]))
				age = given when given >= 0s && given < limit
			}
		}
		return age
	}
}
