partial module std.proto.auth.jose {
	use (
		std.testing
		std.net.http::(ServeMux, Context)
		std.net.http.httptest
	)

	check "Remote keys" {
		@test()
		def TestRemoteKeySetRotation() !none {
			let first = try generateKey(SignatureAlgorithm.ES256)
			first.kid = "one"
			let second = try generateKey(SignatureAlgorithm.ES256)
			second.kid = "two"
			let published = [first.publicKey()]
			let fetches = 0
			let mux = new ServeMux()
			try mux.handle("/jwks", def (ctx Context) !none {
				fetches++
				ctx.response.headers.set("Cache-Control", "public, max-age=600")
				return try ctx.text(new JwkSet(published).json())
			})
			let site = new httptest.Server(mux)
			try site.start()
			let remote = new RemoteKeySet(site.url + "/jwks", site.client())
			let v = Validation{algorithms: [SignatureAlgorithm.ES256], requireExpiry: false}
			let claims = new Claims()
			claims.subject = "alice"
			assert orEmpty((try verifyJwt(try claims.sign(first), remote, v)).subject) == "alice"
			assert orEmpty((try verifyJwt(try claims.sign(first), remote, v)).subject) == "alice"
			assert fetches == 1
			// The issuer rotates; a token with the new kid fetches the set again.
			published = [first.publicKey(), second.publicKey()]
			remote.minRefresh = 0s
			assert orEmpty((try verifyJwt(try claims.sign(second), remote, v)).subject) == "alice"
			assert fetches == 2
			// An unknown kid fetches at most once per minRefresh, counted from
			// the last fetch of any kind.
			let stranger = try generateKey(SignatureAlgorithm.ES256)
			stranger.kid = "three"
			remote.minRefresh = 1h
			assert verifyJwt(try claims.sign(stranger), remote, v) is error
			assert fetches == 2
			remote.minRefresh = 0s
			assert verifyJwt(try claims.sign(stranger), remote, v) is error
			assert fetches == 3
			// The cached set outlives an unreachable URL.
			try site.close()
			assert (try remote.keys()).keys.len() == 2
			let gone = new RemoteKeySet(site.url + "/jwks")
			let err = gone.keys()
			assert err is error
			assert cacheAge("no-store", 1h) == 0s && cacheAge("max-age=60", 1h) == 60s && cacheAge("", 1h) == 1h && cacheAge("max-age=99999", 1h) == 1h
		}
	}
}
