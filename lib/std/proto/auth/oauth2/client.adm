partial module std.proto.auth.oauth2 {
	use (
		std.time
		std.net.http
		std.net.http::(Request, Response, Method, newRequest)
		std.net.url
		std.net.url::(Values)
		std.data.encoding::(Base64)
		std.crypto.hash::(Hash, digest)
		std.proto.auth.jose
		std.proto.auth.oauth2.engine::*
	)

	// AuthorizationOptions adds to an authorization request.
	struct AuthorizationOptions {
		// The `state` to send; a fresh random value when none.
		state        ?string
		// An OpenID Connect `nonce`.
		nonce        ?string
		// `none`, `login`, `consent`, `select_account` or a combination.
		prompt       ?string
		responseType string              = "code"
		// `query`, `fragment` or `form_post`.
		responseMode ?string
		// Resource indicators (RFC 8707).
		resource     string[]            = []
		// Sign the parameters into a request object (RFC 9101) with the
		// client's key. Always done when the server requires it.
		signRequest  bool                = false
		// More parameters, such as `login_hint`, `max_age`, `acr_values`,
		// `claims` or `ui_locales`.
		extra        map<string, string>
	}

	// AuthorizationRequest is a started authorization: the URL to send the
	// user to, and what exchange needs to finish it. Keep it with the
	// user's session until the callback.
	type AuthorizationRequest {
		url          string         = ""
		state        string         = ""
		// The PKCE code verifier (RFC 7636).
		verifier     Secret<string> = ""
		redirectUri  string         = ""
		scopes       string[]       = []
		responseType string         = "code"
		nonce        ?string
		// The `request_uri` a pushed request (RFC 9126) returned.
		requestUri   ?string

		def new() {}
	}

	// DeviceAuthorization is a started device flow (RFC 8628 §3.2): show the
	// user `userCode` and `verificationUri` (or `verificationUriComplete`),
	// then poll.
	type DeviceAuthorization {
		deviceCode              Secret<string> = ""
		userCode                string         = ""
		verificationUri         string         = ""
		verificationUriComplete ?string
		expiresAt               time.Time
		// The wait between polls; slow_down raises it by five seconds.
		interval                duration       = 5s

		def new() {
			expiresAt = time.now()
		}
	}

	// TokenExchange is the optional part of a token exchange request (RFC
	// 8693 §2.1).
	struct TokenExchange {
		resource           string[]        = []
		audience           string[]        = []
		scopes             string[]        = []
		requestedTokenType ?TokenType
		actorToken         ?Secret<string>
		actorTokenType     ?TokenType
	}

	// Introspection is an introspection response (RFC 7662 §2.2).
	type Introspection {
		active         bool             = false
		scope          string[]         = []
		clientId       ?string
		username       ?string
		tokenType      ?string
		expires        ?time.Time
		issuedAt       ?time.Time
		notBefore      ?time.Time
		subject        ?string
		audience       string[]         = []
		issuer         ?string
		id             ?string
		internal extra map<string, any>

		def new() {}

		// get returns a member this type has no field for (`cnf`, custom
		// claims); none when absent.
		def get(name string) ?any {
			return extra.get(name)
		}
	}

	// ClientMetadata is the metadata a client registers (RFC 7591 §2).
	type ClientMetadata {
		redirectUris            string[]         = []
		tokenEndpointAuthMethod ?string
		grantTypes              string[]         = []
		responseTypes           string[]         = []
		clientName              ?string
		clientUri               ?string
		logoUri                 ?string
		scope                   ?string
		contacts                string[]         = []
		tosUri                  ?string
		policyUri               ?string
		jwksUri                 ?string
		jwks                    ?jose.JwkSet
		softwareId              ?string
		softwareVersion         ?string
		softwareStatement       ?string
		internal extra          map<string, any>

		def new() {}

		// get returns a member this type has no field for; none when absent.
		def get(name string) ?any {
			return extra.get(name)
		}

		// set sets a member this type has no field for (OpenID Connect
		// registration members, for one).
		def set(name string, value any) {
			extra.set(name, value)
		}

		// json renders the metadata as a registration request body.
		def json() string {
			return encodeJSON(clientMetadataMembers(self))
		}
	}

	// ClientRegistration is a registration response (RFC 7591 §3.2.1, RFC
	// 7592 §3): the issued credentials and the metadata the server
	// accepted.
	type ClientRegistration {
		clientId                string          = ""
		clientSecret            ?Secret<string>
		clientIdIssuedAt        ?time.Time
		clientSecretExpiresAt   ?time.Time
		registrationAccessToken ?Secret<string>
		registrationClientUri   ?string
		metadata                ClientMetadata

		def new() {
			metadata = new ClientMetadata()
		}
	}

	// Client is an OAuth client of one authorization server. Set `secret`
	// for a confidential client (client_secret_basic unless
	// `authentication` says otherwise), `key` for private_key_jwt and
	// signed request objects, `dpopKey` to bind tokens with DPoP. Safe to
	// use from several tasks once configured.
	type Client {
		id              string
		secret          ?Secret<string>
		// How the client authenticates; none picks SecretBasic with a
		// secret, PrivateKeyJwt with a key, None otherwise.
		authentication  ?ClientAuthentication
		key             ?jose.Jwk
		dpopKey         ?jose.Jwk
		// Send authorization requests through PAR (RFC 9126); done anyway
		// when the server requires it.
		pushRequests    bool                  = false
		metadata        ServerMetadata
		// The client requests go through; a default client when none. Give
		// it a TLS client certificate for tls_client_auth.
		httpClient      ?http.Client
		internal nonces map<string, string>

		def new(id string, metadata ServerMetadata) {
			self.id = id
			self.metadata = metadata
		}

		// authorize starts an authorization code flow with PKCE (S256): a
		// fresh `state` and verifier, the parameters in the URL, in a
		// signed request object, or pushed first (PAR). Fails with
		// Malformed when the server has no authorization endpoint (or no
		// PAR endpoint when pushing), and as the PAR request does.
		def authorize(redirectUri string, scopes string[] = [], options ?AuthorizationOptions = none) !AuthorizationRequest {
			let opts = options is none ?? (AuthorizationOptions{}, options)
			let endpoint = metadata.authorizationEndpoint
			fail oauthError(OAuthErrorKind.Malformed, "the server has no authorization endpoint") when endpoint is none
			let req = new AuthorizationRequest()
			let givenState = opts.state
			req.state = givenState is none ?? (try randomToken(), givenState)
			let verifier = try randomToken(32)
			req.verifier = verifier
			req.redirectUri = redirectUri
			req.scopes = scopes
			req.responseType = opts.responseType
			req.nonce = opts.nonce
			let params = new Values()
			params.set("response_type", opts.responseType)
			params.set("client_id", id)
			params.set("redirect_uri", redirectUri)
			params.set("scope", scopes.join(" ")) when scopes.len() > 0
			params.set("state", req.state)
			if opts.responseType.contains("code") {
				params.set("code_challenge", pkceChallenge(verifier))
				params.set("code_challenge_method", "S256")
			}
			let nonce = opts.nonce
			params.set("nonce", nonce) unless nonce is none
			let prompt = opts.prompt
			params.set("prompt", prompt) unless prompt is none
			let mode = opts.responseMode
			params.set("response_mode", mode) unless mode is none
			for let r in opts.resource {
				params.add("resource", r)
			}
			for let (k, v) in opts.extra {
				params.set(k, v)
			}
			params = try requestObject(params) when opts.signRequest || metadata.requireSignedRequestObject
			if pushRequests || metadata.requirePushedAuthorizationRequests {
				let par = metadata.pushedAuthorizationRequestEndpoint
				fail oauthError(OAuthErrorKind.Malformed, "the server has no PAR endpoint") when par is none
				let res = try postForm(endpointFor("pushed_authorization_request_endpoint", par), params, authenticate = true, withDpop = true)
				let uri = try textOf(res, "request_uri")
				req.requestUri = uri
				let pushed = new Values()
				pushed.set("client_id", id)
				pushed.set("request_uri", uri)
				params = pushed
			}
			req.url = endpoint + (endpoint.contains("?") ?? ("&", "?")) + params.encode()
			return req
		}

		// exchange finishes an authorization code flow from the callback:
		// the full callback URL, or its query (a form_post body works too).
		// It checks `state` and, when present or required, `iss` (RFC 9207),
		// then redeems the code with the PKCE verifier. Fails with the
		// error the server put in the callback, StateMismatch,
		// IssuerMismatch, Malformed without a code, and as the token
		// request does.
		def exchange(request AuthorizationRequest, callback string) !Token {
			let params = try callbackParams(callback)
			let state = params.get("state")
			fail oauthError(OAuthErrorKind.StateMismatch, "the callback's state does not match") unless !(state is none) && state == request.state
			if params.has("error") {
				let code = params.get("error")
				let kind = kindOf(code is none ?? ("", code))
				let description = params.get("error_description")
				let text = description is none ?? ("", description)
				fail OAuthError{message: "oauth2: authorization failed: {code}", code: kind.value, kind: kind, error: code is none ?? ("", code), description: text}
			}
			let iss = params.get("iss")
			if iss is none {
				fail oauthError(OAuthErrorKind.IssuerMismatch, "the callback has no iss") when metadata.authorizationResponseIssParameterSupported
			} else {
				fail oauthError(OAuthErrorKind.IssuerMismatch, "the callback names issuer {iss}") unless iss == metadata.issuer
			}
			let code = params.get("code")
			fail oauthError(OAuthErrorKind.Malformed, "the callback has no code") when code is none
			let form = new Values()
			form.set("grant_type", "authorization_code")
			form.set("code", code)
			form.set("redirect_uri", request.redirectUri)
			form.set("code_verifier", request.verifier.reveal())
			return try tokenRequest(form)
		}

		// clientCredentials gets a token for the client itself (RFC 6749
		// §4.4). Fails as the token request does.
		def clientCredentials(scopes string[] = [], resource string[] = []) !Token {
			let form = new Values()
			form.set("grant_type", "client_credentials")
			form.set("scope", scopes.join(" ")) when scopes.len() > 0
			for let r in resource {
				form.add("resource", r)
			}
			return try tokenRequest(form)
		}

		// password gets a token with the user's credentials (RFC 6749
		// §4.3). Deprecated by RFC 9700; use only where nothing else works.
		// Fails as the token request does.
		def password(username string, password Secret<string>, scopes string[] = []) !Token {
			let form = new Values()
			form.set("grant_type", "password")
			form.set("username", username)
			form.set("password", password.reveal())
			form.set("scope", scopes.join(" ")) when scopes.len() > 0
			return try tokenRequest(form)
		}

		// refresh redeems the token's refresh token (RFC 6749 §6); the old
		// refresh token stays in the result when the server issues none.
		// Fails with Malformed when the token has no refresh token, and as
		// the token request does.
		def refresh(token Token, scopes string[] = []) !Token {
			let old = token.refreshToken
			fail oauthError(OAuthErrorKind.Malformed, "the token has no refresh token") when old is none
			let form = new Values()
			form.set("grant_type", "refresh_token")
			form.set("refresh_token", old.reveal())
			form.set("scope", scopes.join(" ")) when scopes.len() > 0
			let fresh = try tokenRequest(form)
			let issued = fresh.refreshToken
			fresh.refreshToken = old when issued is none
			return fresh
		}

		// deviceAuthorization starts a device flow (RFC 8628 §3.1). Fails
		// with Malformed when the server has no device endpoint, and as
		// the request does.
		def deviceAuthorization(scopes string[] = []) !DeviceAuthorization {
			let endpoint = metadata.deviceAuthorizationEndpoint
			fail oauthError(OAuthErrorKind.Malformed, "the server has no device authorization endpoint") when endpoint is none
			let form = new Values()
			form.set("scope", scopes.join(" ")) when scopes.len() > 0
			let res = try postForm(endpointFor("device_authorization_endpoint", endpoint), form, authenticate = true, withDpop = false)
			let d = new DeviceAuthorization()
			d.deviceCode = try textOf(res, "device_code")
			d.userCode = try textOf(res, "user_code")
			d.verificationUri = try textOf(res, "verification_uri")
			d.verificationUriComplete = try textOf(res, "verification_uri_complete") when res.hasKey("verification_uri_complete")
			d.expiresAt = time.now() + 1s * float(try intOf(res, "expires_in"))
			d.interval = 1s * float(try intOf(res, "interval")) when res.hasKey("interval")
			return d
		}

		// poll waits for the user to finish a device flow, asking every
		// `interval` and slowing down when told to (RFC 8628 §3.4-3.5).
		// Fails with AccessDenied or ExpiredToken when the user refused or
		// the code expired, and as the token request does.
		def poll(device DeviceAuthorization) !Token {
			let form = new Values()
			form.set("grant_type", "urn:ietf:params:oauth:grant-type:device_code")
			form.set("device_code", device.deviceCode.reveal())
			for {
				fail oauthError(OAuthErrorKind.ExpiredToken, "the device code expired") unless time.now().before(device.expiresAt)
				time.sleep(device.interval)
				let pending = false
				let token = tokenRequest(form) onerror (err error) {
					let kind = err is OAuthError ?? (err.kind, OAuthErrorKind.Other)
					fail err unless kind == OAuthErrorKind.AuthorizationPending || kind == OAuthErrorKind.SlowDown
					device.interval = device.interval + 5s when kind == OAuthErrorKind.SlowDown
					pending = true
					recover new Token("")
				}
				return token unless pending
			}
		}

		// exchangeToken trades a token for another (RFC 8693). Fails as the
		// token request does.
		def exchangeToken(subjectToken Secret<string>, subjectTokenType TokenType, options ?TokenExchange = none) !Token {
			let opts = options is none ?? (TokenExchange{}, options)
			let form = new Values()
			form.set("grant_type", "urn:ietf:params:oauth:grant-type:token-exchange")
			form.set("subject_token", subjectToken.reveal())
			form.set("subject_token_type", subjectTokenType.value)
			for let r in opts.resource {
				form.add("resource", r)
			}
			for let a in opts.audience {
				form.add("audience", a)
			}
			form.set("scope", opts.scopes.join(" ")) when opts.scopes.len() > 0
			let wanted = opts.requestedTokenType
			form.set("requested_token_type", wanted.value) unless wanted is none
			let actor = opts.actorToken
			if !(actor is none) {
				form.set("actor_token", actor.reveal())
				let actorType = opts.actorTokenType
				form.set("actor_token_type", actorType is none ?? (TokenType.AccessToken.value, actorType.value))
			}
			return try tokenRequest(form)
		}

		// jwtBearer redeems a JWT assertion for a token (RFC 7523 §2.1).
		// Fails as the token request does.
		def jwtBearer(assertion string, scopes string[] = []) !Token {
			let form = new Values()
			form.set("grant_type", "urn:ietf:params:oauth:grant-type:jwt-bearer")
			form.set("assertion", assertion)
			form.set("scope", scopes.join(" ")) when scopes.len() > 0
			return try tokenRequest(form)
		}

		// revoke revokes the token's refresh token when it has one, else
		// its access token (RFC 7009). Fails as the revocation request does.
		def revoke(token Token) !none {
			let refresh = token.refreshToken
			return try revoke(refresh, "refresh_token") unless refresh is none
			return try revoke(token.accessToken, "access_token")
		}

		// revoke revokes one token; hint is `access_token`, `refresh_token`
		// or none. Fails with Malformed when the server has no revocation
		// endpoint, and with the server's error.
		def revoke(value Secret<string>, hint ?string = none) !none {
			let endpoint = metadata.revocationEndpoint
			fail oauthError(OAuthErrorKind.Malformed, "the server has no revocation endpoint") when endpoint is none
			let form = new Values()
			form.set("token", value.reveal())
			form.set("token_type_hint", hint) unless hint is none
			try postForm(endpointFor("revocation_endpoint", endpoint), form, authenticate = true, withDpop = false, emptyOk = true)
			return none
		}

		// introspect asks the server about a token (RFC 7662). Fails with
		// Malformed when the server has no introspection endpoint or the
		// response is not one, and with the server's error.
		def introspect(value Secret<string>, hint ?string = none) !Introspection {
			let endpoint = metadata.introspectionEndpoint
			fail oauthError(OAuthErrorKind.Malformed, "the server has no introspection endpoint") when endpoint is none
			let form = new Values()
			form.set("token", value.reveal())
			form.set("token_type_hint", hint) unless hint is none
			return try introspectionFromMembers(try postForm(endpointFor("introspection_endpoint", endpoint), form, authenticate = true, withDpop = false))
		}

		// register registers a client (RFC 7591), with an initial access
		// token when the server asks for one. Fails with Malformed when the
		// server has no registration endpoint, and with the server's error.
		def register(client ClientMetadata, initialAccessToken ?Secret<string> = none) !ClientRegistration {
			let endpoint = metadata.registrationEndpoint
			fail oauthError(OAuthErrorKind.Malformed, "the server has no registration endpoint") when endpoint is none
			return try registrationFromMembers(try sendJson(Method.POST, endpoint, client.json(), initialAccessToken))
		}

		// readRegistration reads a registration back (RFC 7592 §2.1). Fails
		// with Malformed when it has no registration_client_uri, and with
		// the server's error.
		def readRegistration(registration ClientRegistration) !ClientRegistration {
			let (uri, token) = try managementOf(registration)
			return try registrationFromMembers(try sendJson(Method.GET, uri, "", token))
		}

		// updateRegistration replaces a registration's metadata (RFC 7592
		// §2.2). Fails as readRegistration does.
		def updateRegistration(registration ClientRegistration, client ClientMetadata) !ClientRegistration {
			let (uri, token) = try managementOf(registration)
			let body = clientMetadataMembers(client)
			body.set("client_id", registration.clientId)
			let issuedSecret = registration.clientSecret
			body.set("client_secret", issuedSecret.reveal()) unless issuedSecret is none
			return try registrationFromMembers(try sendJson(Method.PUT, uri, encodeJSON(body), token))
		}

		// deleteRegistration deletes a registration (RFC 7592 §2.3). Fails
		// as readRegistration does.
		def deleteRegistration(registration ClientRegistration) !none {
			let (uri, token) = try managementOf(registration)
			try sendJson(Method.DELETE, uri, "", token, true)
			return none
		}

		// send sends a resource request with the token: `Authorization:
		// Bearer` (RFC 6750), or a DPoP proof bound to the token when the
		// token is a DPoP token (RFC 9449 §7), retried once when the
		// resource server asks for a nonce. Fails as the HTTP client does.
		def send(request Request, token Token) !Response {
			let dpop = token.tokenType.lower() == "dpop"
			for let attempt = 0; attempt < 2; attempt++ {
				request.headers.set("Authorization", (dpop ?? ("DPoP ", "Bearer ")) + token.accessToken.reveal())
				request.headers.set("DPoP", try dpopProof(request.method.value, request.url.str(), token.accessToken.reveal())) when dpop
				let res = try transport().do(request)
				rememberNonce(request.url.str(), res.header("DPoP-Nonce"))
				let retry = dpop && attempt == 0 && res.status == 401 && res.header("WWW-Authenticate").contains("use_dpop_nonce") && res.header("DPoP-Nonce") != ""
				return res unless retry
			}
			fail oauthError(OAuthErrorKind.Transport, "unreachable")
		}

		// The effective client authentication method.
		internal def authMethod() ClientAuthentication {
			let chosen = authentication
			return chosen unless chosen is none
			return ClientAuthentication.SecretBasic unless secret is none
			return ClientAuthentication.PrivateKeyJwt unless key is none
			return ClientAuthentication.None
		}

		internal def transport() http.Client {
			let c = httpClient
			return c is none ?? (new http.Client(), c)
		}

		// endpointFor picks the mTLS alias of an endpoint when the client
		// authenticates with a certificate (RFC 8705 §5).
		internal def endpointFor(name string, plain string) string {
			let method = authMethod()
			if method == ClientAuthentication.TlsClient || method == ClientAuthentication.SelfSignedTlsClient {
				let alias = metadata.mtlsEndpointAliases.get(name)
				return alias unless alias is none
			}
			return plain
		}

		// tokenRequest posts a grant to the token endpoint.
		internal def tokenRequest(form Values) !Token {
			let endpoint = metadata.tokenEndpoint
			fail oauthError(OAuthErrorKind.Malformed, "the server has no token endpoint") when endpoint is none
			return try tokenFromMembers(try postForm(endpointFor("token_endpoint", endpoint), form, authenticate = true, withDpop = true))
		}

		// postForm posts a form with client authentication and, when asked
		// and the client has a DPoP key, a DPoP proof, retrying once for a
		// server nonce. Returns the JSON object of a 2xx answer (empty when
		// emptyOk and the body is empty). Fails with the server's error.
		internal def postForm(target string, form Values, authenticate bool, withDpop bool, emptyOk bool = false) !map<string, any> {
			let body = new Values()
			for let p in form.pairs() {
				body.add(p.key, p.value)
			}
			let basic = ""
			basic = try addClientAuth(body) when authenticate
			for let attempt = 0; attempt < 2; attempt++ {
				let req = try newRequest(Method.POST, target, body.encode())
				req.headers.set("Content-Type", "application/x-www-form-urlencoded")
				req.headers.set("Accept", "application/json")
				req.headers.set("Authorization", basic) when basic != ""
				let proof = withDpop && !(dpopKey is none)
				req.headers.set("DPoP", try dpopProof("POST", target, none)) when proof
				let res = transport().do(req) onerror (err error) {
					fail OAuthError{message: "oauth2: cannot reach {target}: {err.message}", code: OAuthErrorKind.Transport.value, cause: err, kind: OAuthErrorKind.Transport}
				}
				rememberNonce(target, res.header("DPoP-Nonce"))
				let text = res.text() onerror fail oauthError(OAuthErrorKind.Transport, "cannot read the answer of {target}")
				if res.status >= 200 && res.status < 300 {
					return new map<string, any>() when emptyOk && text.trim() == ""
					return try parseObject(text, "response")
				}
				let err = serverError(res.status, text, res.header("WWW-Authenticate"))
				let nonceAsked = err is OAuthError ?? (err.kind == OAuthErrorKind.UseDpopNonce, false)
				fail err unless proof && attempt == 0 && nonceAsked
			}
			fail oauthError(OAuthErrorKind.Transport, "unreachable")
		}

		// addClientAuth adds the client's credentials to a request body and
		// returns the Authorization header value for client_secret_basic
		// ("" otherwise). Fails with Malformed when the method needs a
		// secret or key the client lacks.
		internal def addClientAuth(body Values) !string {
			let method = authMethod()
			let clientSecret = secret
			match method {
				case ClientAuthentication.SecretBasic:
					fail oauthError(OAuthErrorKind.Malformed, "client_secret_basic needs a secret") when clientSecret is none
					let pair = url.queryEscape(id) + ":" + url.queryEscape(clientSecret.reveal())
					return "Basic " + new Base64().encode(pair.bytes())
				case ClientAuthentication.SecretPost:
					fail oauthError(OAuthErrorKind.Malformed, "client_secret_post needs a secret") when clientSecret is none
					body.set("client_id", id)
					body.set("client_secret", clientSecret.reveal())
				case ClientAuthentication.SecretJwt, ClientAuthentication.PrivateKeyJwt:
					body.set("client_id", id)
					body.set("client_assertion_type", "urn:ietf:params:oauth:client-assertion-type:jwt-bearer")
					body.set("client_assertion", try clientAssertion(method))
				default:
					body.set("client_id", id)
			}
			return ""
		}

		// clientAssertion is the RFC 7523 §3 JWT: issuer and subject the
		// client, audience the token endpoint, a minute's lifetime.
		internal def clientAssertion(method ClientAuthentication) !string {
			let claims = new jose.Claims()
			claims.issuer = id
			claims.subject = id
			let endpoint = metadata.tokenEndpoint
			claims.audience = [endpoint is none ?? (metadata.issuer, endpoint)]
			claims.id = try randomToken(16)
			claims.issuedAt = time.now()
			claims.expires = time.now() + 60s
			if method == ClientAuthentication.SecretJwt {
				let s = secret
				fail oauthError(OAuthErrorKind.Malformed, "client_secret_jwt needs a secret") when s is none
				return try claims.sign(new jose.Jwk(s.reveal().bytes()), jose.SignatureAlgorithm.HS256)
			}
			let k = key
			fail oauthError(OAuthErrorKind.Malformed, "private_key_jwt needs a key") when k is none
			return try claims.sign(k)
		}

		// requestObject moves the parameters into a signed request object
		// (RFC 9101 §4), keeping client_id, response_type and scope outside
		// for servers that read them there.
		internal def requestObject(params Values) !Values {
			let k = key
			fail oauthError(OAuthErrorKind.Malformed, "a request object needs the client's key") when k is none
			let claims = new jose.Claims()
			claims.issuer = id
			claims.audience = [metadata.issuer]
			claims.issuedAt = time.now()
			claims.notBefore = time.now()
			claims.expires = time.now() + 5m
			claims.id = try randomToken(16)
			for let name in params.keys() {
				let all = params.all(name)
				try claims.set(name, all.len() == 1 ?? (all[0], stringsValue(all)))
			}
			let header = new jose.Header()
			header.typ = "oauth-authz-req+jwt"
			let out = new Values()
			out.set("client_id", id)
			let responseType = params.get("response_type")
			out.set("response_type", responseType) unless responseType is none
			let scope = params.get("scope")
			out.set("scope", scope) unless scope is none
			out.set("request", try claims.sign(k, none, header))
			return out
		}

		// dpopProof is a DPoP proof JWT (RFC 9449 §4.2) for one request,
		// bound to an access token when one is given.
		internal def dpopProof(method string, target string, accessToken ?string) !string {
			let k = dpopKey
			fail oauthError(OAuthErrorKind.Malformed, "DPoP needs a key") when k is none
			let header = new jose.Header()
			header.typ = "dpop+jwt"
			header.jwk = k.publicKey()
			let claims = new jose.Claims()
			claims.id = try randomToken(16)
			claims.issuedAt = time.now()
			let htu = target.split("#")[0].split("?")[0]
			try claims.set("htm", method)
			try claims.set("htu", htu)
			let nonce = nonces.get(originOf(target))
			try claims.set("nonce", nonce) unless nonce is none
			try claims.set("ath", b64url(digest(Hash.SHA256, accessToken.bytes()))) unless accessToken is none
			return try claims.sign(dpopSigner(k), none, header)
		}

		internal def rememberNonce(target string, nonce string) {
			nonces.set(originOf(target), nonce) when nonce != ""
		}

		// managementOf is a registration's management URI and token.
		internal def managementOf(registration ClientRegistration) !(string, ?Secret<string>) {
			let uri = registration.registrationClientUri
			fail oauthError(OAuthErrorKind.Malformed, "the registration has no registration_client_uri") when uri is none
			return (uri, registration.registrationAccessToken)
		}

		// sendJson sends a JSON request with an optional bearer token and
		// returns the JSON object of a 2xx answer.
		internal def sendJson(method Method, target string, body string, token ?Secret<string>, emptyOk bool = false) !map<string, any> {
			let req = try newRequest(method, target, body)
			req.headers.set("Content-Type", "application/json") when body != ""
			req.headers.set("Accept", "application/json")
			req.headers.set("Authorization", "Bearer " + token.reveal()) unless token is none
			let res = transport().do(req) onerror (err error) {
				fail OAuthError{message: "oauth2: cannot reach {target}: {err.message}", code: OAuthErrorKind.Transport.value, cause: err, kind: OAuthErrorKind.Transport}
			}
			let text = res.text() onerror fail oauthError(OAuthErrorKind.Transport, "cannot read the answer of {target}")
			fail serverError(res.status, text, res.header("WWW-Authenticate")) unless res.status >= 200 && res.status < 300
			return new map<string, any>() when emptyOk && text.trim() == ""
			return try parseObject(text, "response")
		}
	}

	// dpopSigner is the DPoP key without its `kid`, so the proof's header
	// carries only `jwk` (RFC 9449 §4.2).
	internal def dpopSigner(key jose.Jwk) jose.Jwk {
		let out = new jose.Jwk(key.secret)
		out.kty = key.kty
		out.curve = key.curve
		out.public = key.public
		out.private = key.private
		out.alg = key.alg
		return out
	}

	// originOf is scheme://host[:port] of a URL, the key DPoP nonces are
	// kept under.
	internal def originOf(target string) string {
		let at = target.indexOf("://")
		return target when at < 0
		let rest = target[at + 3:]
		let slash = rest.indexOf("/")
		return slash < 0 ?? (target, target[0:at + 3 + slash])
	}

	// callbackParams reads an authorization response from a callback URL
	// (query, or fragment for fragment response modes) or a bare query.
	internal def callbackParams(callback string) !url.Values {
		let text = callback
		let hash = text.indexOf("#")
		if text.contains("?") {
			let q = text[text.indexOf("?") + 1:]
			let frag = q.indexOf("#")
			text = frag < 0 ?? (q, q[0:frag])
		} else if hash >= 0 {
			text = text[hash + 1:]
		}
		return url.parseQuery(text) onerror fail oauthError(OAuthErrorKind.Malformed, "the callback query does not parse")
	}
}
