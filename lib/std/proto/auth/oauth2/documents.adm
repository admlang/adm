partial module std.proto.auth.oauth2 {
	use (
		std.time
		std.net
		std.net.http
		std.net.url
		std.proto.auth.oauth2.engine::*
	)

	// The address blocks a server-side fetch must not reach unless told to:
	// this host, private and link-local networks, multicast and reserved
	// space.
	const privateBlocks = ["0.0.0.0/8", "10.0.0.0/8", "100.64.0.0/10", "127.0.0.0/8", "169.254.0.0/16", "172.16.0.0/12", "192.0.0.0/24", "192.168.0.0/16", "198.18.0.0/15", "224.0.0.0/3", "::/127", "fc00::/7", "fe80::/10", "ff00::/8"]

	// ClientDocuments lets an authorization server take the URL of a Client
	// ID Metadata Document as a client id
	// (draft-ietf-oauth-client-id-metadata-document): a client nobody
	// registered publishes its metadata at an https URL and uses that URL as
	// its `client_id`; the server fetches the document when it meets the id.
	//
	// ```
	// server.clientDocuments = new oauth2.ClientDocuments()
	// ```
	//
	// A document is refused when its `client_id` is not its URL, it lacks a
	// name or redirect URIs, or it authenticates with a shared secret; the
	// redirect URI of a request is then matched against the document's, as
	// for a registered client. Safe to use from several tasks.
	type ClientDocuments {
		// The client documents are fetched with. None uses one that waits
		// ten seconds and follows no redirect; give one to add a proxy or
		// other limits.
		httpClient     ?http.Client
		// The largest document accepted, in bytes (§6.6).
		maxBytes       int                         = 5120
		// How long a fetched document is used before it is fetched again;
		// a shorter `Cache-Control: max-age` of the response wins, and
		// `no-store` or `no-cache` keeps nothing (§4.4).
		lifetime       duration                    = 1h
		// Decides whether a client id URL is accepted, by its domain for
		// one (§6.8); none accepts every URL.
		trusted        ?def (string) bool
		// Fetch from this host, private and link-local addresses too
		// (§6.5); for development only.
		allowPrivate   bool                        = false
		internal cache map<string, CachedDocument>

		def new() {}

		// client returns the client the URL names, fetching its document
		// unless a fetched one is still fresh; none when id is not the URL
		// of a Client ID Metadata Document (§3), so a plain client id.
		// Fails with InvalidClient when the URL is not trusted or resolves
		// to an address it must not reach, the document cannot be fetched,
		// is too large or not JSON, or does not describe this client.
		def client(id string) !?RegisteredClient {
			return none unless clientIdProblem(id) == ""
			let kept = cached(id)
			return kept unless kept is none
			let policy = trusted
			fail documentError(id, "this server does not accept it") unless policy is none || policy(id)
			try checkReachable(id, id)
			let given = httpClient
			let fetcher = given is none ?? (documentFetcher(maxBytes), given)
			let req = http.newRequest(http.Method.GET, id) onerror fail documentError(id, "it is not a URL")
			req.headers.set("Accept", "application/json")
			let res = fetcher.do(req) onerror (err error) {
				fail documentError(id, "it cannot be fetched: {err.message}")
			}
			if res.status != 200 {
				let status = res.status
				res.close() onerror recover none
				fail documentError(id, "it answered {status}")
			}
			let kind = res.header("Content-Type").split(";")[0].trim().lower()
			let data = res.bytes() onerror fail documentError(id, "it cannot be read, or is larger than {maxBytes} bytes")
			fail documentError(id, "it is larger than {maxBytes} bytes") when data.len() > maxBytes
			fail documentError(id, "it is served as {kind}, not JSON") unless kind == "application/json" || (kind.startsWith("application/") && kind.endsWith("+json"))
			let members = parseObject(string(data), "the document") onerror fail documentError(id, "it is not a JSON object")
			let named = textOf(members, "client_id") onerror fail documentError(id, "it has no client_id")
			fail documentError(id, "its client_id is {named}") unless named == id
			fail documentError(id, "it carries a client secret") when members.hasKey("client_secret") || members.hasKey("client_secret_expires_at")
			members.delete("client_id")
			let failure ?error = none
			let metadata = clientMetadataFromMembers(members) onerror (err error) {
				failure = err
				recover new ClientMetadata()
			}
			try checkClientDocument(id, metadata) when failure is none
			checkClientMetadata(metadata) onerror (err error) {
				failure = err
				recover none
			}
			fail documentError(id, failure.message.trimPrefix("oauth2: ")) unless failure is none
			let keys = metadata.jwksUri
			if !(keys is none) {
				fail documentError(id, "its jwks_uri must use https") unless keys.startsWith("https://")
				try checkReachable(keys, id)
			}
			let found = new RegisteredClient(id, metadata)
			let age = cacheAge(res.header("Cache-Control"), lifetime)
			keep(id, found, time.now() + age) when age > 0s
			return found
		}

		// checkReachable refuses a URL whose host is, or resolves to, an
		// address a server-side fetch must not reach.
		internal def checkReachable(target string, id string) !none {
			return none when allowPrivate
			let u = url.parse(target) onerror fail documentError(id, "{target} is not a URL")
			let host = u.hostname().trimPrefix("[").trimSuffix("]")
			let addresses = [host]
			if net.parseIPText(host) is none {
				addresses = net.resolve(host) onerror fail documentError(id, "{host} does not resolve")
			}
			fail documentError(id, "{host} does not resolve") when addresses.len() == 0
			for let address in addresses {
				let ip = net.parseIPText(address)
				fail documentError(id, "{host} is not a public address") when ip is none
				for let text in privateBlocks {
					let block = net.parseIPBlock(text)
					fail documentError(id, "{host} is not a public address") when !(block is none) && block.contains(ip)
				}
			}
			return none
		}

		internal atomic def cached(id string) ?RegisteredClient {
			let entry = cache.get(id)
			return none when entry is none
			return entry.client when time.now().before(entry.until)
			cache.delete(id)
			return none
		}

		internal atomic def keep(id string, client RegisteredClient, until time.Time) {
			cache.set(id, new CachedDocument(client, until))
		}
	}

	internal type CachedDocument {
		client RegisteredClient
		until  time.Time

		def new(client RegisteredClient, until time.Time) {
			self.client = client
			self.until = until
		}
	}

	// StopAtRedirect follows no redirect: a client id is the URL of its
	// document, and a redirect could lead where the fetch must not go.
	internal type StopAtRedirect {
		def new() {}

		// Implements http.RedirectPolicy.
		def follow(next http.Request, via http.Request[]) !bool {
			return false
		}
	}

	internal def documentFetcher(maxBytes int) http.Client {
		let fetcher = new http.Client("", 10s)
		fetcher.maxBodyBytes = maxBytes + 1
		fetcher.redirects = new StopAtRedirect()
		return fetcher
	}

	internal def documentError(id string, text string) error {
		return kindError(OAuthErrorKind.InvalidClient, "the client document {id} is refused: {text}", 401)
	}

	// clientIdProblem says why id cannot be the URL of a Client ID Metadata
	// Document (§3: https, a path without dot segments, no fragment, no user
	// name or password); "" when it can.
	internal def clientIdProblem(id string) string {
		let parsed = true
		let u = url.parse(id) onerror (err error) {
			parsed = false
			recover new url.URL()
		}
		return "it is not a URL" unless parsed
		return "it must use https" unless u.scheme == "https"
		return "it has no host" when u.host == ""
		return "it carries a user name or password" unless u.user is none
		return "it has a fragment" when id.contains("#")
		let at = id.indexOf(u.host) + u.host.len()
		let path = id[at:].split("?")[0]
		return "it has no path" when path == ""
		for let segment in path.split("/") {
			return "its path has a dot segment" when segment := "." || ".."
		}
		return ""
	}

	// checkClientDocument refuses metadata that cannot be a Client ID
	// Metadata Document at id: an id that is no such URL, no name or
	// redirect URIs (what a server shows the user and matches requests
	// against), or authentication with a shared secret, which a client
	// nobody registered cannot have (§4.1).
	internal def checkClientDocument(id string, metadata ClientMetadata) !none {
		let problem = clientIdProblem(id)
		fail kindError(OAuthErrorKind.InvalidClientMetadata, "{id} cannot be a client id: {problem}") when problem != ""
		fail kindError(OAuthErrorKind.InvalidClientMetadata, "a client document needs client_name") when metadata.clientName is none
		fail kindError(OAuthErrorKind.InvalidClientMetadata, "a client document needs redirect_uris") when metadata.redirectUris.len() == 0
		let method = metadata.tokenEndpointAuthMethod
		fail kindError(OAuthErrorKind.InvalidClientMetadata, "a client document cannot authenticate with {method}: it has no shared secret") when !(method is none) && method.startsWith("client_secret_")
		return none
	}

	// cacheAge is how long a response may be kept by its `Cache-Control`,
	// at most limit: nothing for `no-store` and `no-cache`, `max-age` when
	// given, limit otherwise.
	internal def cacheAge(header string, limit duration) duration {
		let age = limit
		for let part in header.lower().split(",") {
			let directive = part.trim()
			return 0s when directive := "no-store" || "no-cache"
			continue unless directive.startsWith("max-age=")
			let digits = directive[8:].trim()
			continue unless digits != "" && digits.isNumeric()
			let given = 1s * float(digits.toInt<int>())
			age = given when given < age
		}
		return age
	}

	// findClient is the client an id names: one the server's store holds,
	// else one described by a Client ID Metadata Document when the server
	// takes them. None when unknown.
	internal def findClient(server AuthorizationServer, id string) !?RegisteredClient {
		let known = try server.clients.client(id)
		return known unless known is none
		let documents = server.clientDocuments
		return none when documents is none
		return try documents.client(id)
	}
}
