partial module std.proto.auth.oauth2 {
	use (
		std.time
		std.crypto.hash::(Hash, digest)
		std.proto.auth.jose
		std.proto.auth.oauth2.engine::*
	)

	// The signature algorithms a DPoP proof may use: asymmetric only.
	internal const dpopAlgorithms = [jose.SignatureAlgorithm.ES256, jose.SignatureAlgorithm.ES384, jose.SignatureAlgorithm.ES512, jose.SignatureAlgorithm.PS256, jose.SignatureAlgorithm.PS384, jose.SignatureAlgorithm.PS512, jose.SignatureAlgorithm.RS256, jose.SignatureAlgorithm.RS384, jose.SignatureAlgorithm.RS512, jose.SignatureAlgorithm.EdDSA, jose.SignatureAlgorithm.Ed25519, jose.SignatureAlgorithm.Ed448, jose.SignatureAlgorithm.ES256K]

	// ReplayCache remembers the `jti` of recent DPoP proofs so each is
	// accepted once (RFC 9449 §11.1).
	internal type ReplayCache {
		internal seen   map<string, time.Time>
		internal writes int                    = 0

		def new() {}

		// first records the id and reports whether it was new.
		atomic def first(id string, until time.Time) bool {
			let now = time.now()
			let known = seen.get(id)
			return false when !(known is none) && now.before(known)
			seen.set(id, until)
			writes++
			if writes % 512 == 0 {
				for let k in seen.keys() {
					let t = seen.get(k)
					seen.delete(k) when !(t is none) && !now.before(t)
				}
			}
			return true
		}
	}

	// verifyDpop checks a DPoP proof (RFC 9449 §4.3) for a request and
	// returns the JWK thumbprint of its key: one compact JWS with `typ:
	// "dpop+jwt"`, an asymmetric algorithm, a public `jwk` that verifies
	// it, `htm` and `htu` matching the request, `iat` within the window,
	// a `jti` not seen before, the expected `nonce` when one is required,
	// and `ath` matching the access token when one is presented. Fails
	// with InvalidDpopProof, or UseDpopNonce when the nonce is missing or
	// stale.
	internal def verifyDpop(proof string, method string, target string, accessToken ?string, nonce ?string, replay ReplayCache, window duration = 5m) !string {
		let bad = (text string) => OAuthError{message: "oauth2: invalid DPoP proof: " + text, code: OAuthErrorKind.InvalidDpopProof.value, kind: OAuthErrorKind.InvalidDpopProof, error: OAuthErrorKind.InvalidDpopProof.value, description: text, status: 400}
		let jws = jose.parseJws(proof) onerror fail bad("not a JWS")
		fail bad("not one signature") unless jws.signatures.len() == 1
		let header = jws.signatures[0].protected
		let typ = header.typ
		fail bad("typ is not dpop+jwt") unless !(typ is none) && typ.lower() == "dpop+jwt"
		let key = header.jwk
		fail bad("no jwk header") when key is none
		fail bad("jwk holds a private key") when key.isPrivate()
		let payload = jws.verify(key, dpopAlgorithms) onerror fail bad("the signature does not verify")
		let claims = jose.parseClaims(string(payload)) onerror fail bad("the claims are not a JSON object")
		let htm = claims.get("htm")
		let htu = claims.get("htu")
		let gotMethod = htm is none ?? ("", "{htm}")
		let gotTarget = htu is none ?? ("", "{htu}")
		fail bad("htm does not match") unless gotMethod == method
		fail bad("htu does not match") unless normalizeHtu(gotTarget) == normalizeHtu(target)
		let iat = claims.issuedAt
		fail bad("no iat") when iat is none
		let now = time.now()
		fail bad("iat is outside the accepted window") unless now.before(iat + window) && (iat - window).before(now)
		let jti = claims.id
		fail bad("no jti") when jti is none || jti == ""
		let jkt = b64url(key.thumbprint())
		fail bad("jti was used before") unless replay.first(jkt + ":" + jti, iat + window + window)
		if !(nonce is none) {
			let sent = claims.get("nonce")
			let ok = !(sent is none) && "{sent}" == nonce
			fail OAuthError{message: "oauth2: a DPoP nonce is required", code: OAuthErrorKind.UseDpopNonce.value, kind: OAuthErrorKind.UseDpopNonce, error: OAuthErrorKind.UseDpopNonce.value, description: "use the nonce in DPoP-Nonce", status: 400} unless ok
		}
		if !(accessToken is none) {
			let ath = claims.get("ath")
			let want = b64url(digest(Hash.SHA256, accessToken.bytes()))
			fail bad("ath does not match the access token") unless !(ath is none) && "{ath}" == want
		}
		return jkt
	}

	// normalizeHtu drops the query and fragment and lowers the scheme and
	// host, as RFC 9449 §4.3 compares `htu`.
	internal def normalizeHtu(target string) string {
		let t = target.split("#")[0].split("?")[0]
		let at = t.indexOf("://")
		return t when at < 0
		let rest = t[at + 3:]
		let slash = rest.indexOf("/")
		let host = slash < 0 ?? (rest, rest[0:slash])
		let path = slash < 0 ?? ("/", rest[slash:])
		return t[0:at].lower() + "://" + host.lower() + path
	}
}
