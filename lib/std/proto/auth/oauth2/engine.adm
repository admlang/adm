internal partial module std.proto.auth.oauth2.engine {
	use (
		std.time
		std.crypto::(rand)
		std.crypto.hash::(Hash, digest)
		std.data.encoding::(Base64, JSON)
		std.net.http
		std.net.url
		std.proto.auth.oauth2::*
	)

	// oauthError builds the payload for a failure the client detected.
	def oauthError(kind OAuthErrorKind, text string) error {
		return OAuthError{message: "oauth2: " + text, code: kind.value, kind: kind}
	}

	// Encoding -----------------------------------------------------------

	// b64url is unpadded base64url (RFC 7636 §3, RFC 4648 §5).
	def b64url(data byte[]) string {
		let codec = new Base64()
		codec.padded = false
		codec.urlSafe = true
		return codec.encode(data)
	}

	// randomToken is `bytes` random bytes as base64url: a `state`, `nonce`,
	// PKCE verifier, code or token. Fails when the random source is
	// unavailable.
	def randomToken(bytes int = 32) !string {
		return b64url(try rand(bytes))
	}

	// pkceChallenge is the S256 code challenge of a verifier (RFC 7636
	// §4.2).
	def pkceChallenge(verifier string) string {
		return b64url(digest(Hash.SHA256, verifier.bytes()))
	}

	// JSON members -------------------------------------------------------

	def parseObject(text string, what string) !map<string, any> {
		let doc = new JSON().parse(text) onerror fail oauthError(OAuthErrorKind.Malformed, "{what} is not JSON")
		match doc {
			case map<string, any>:
				return doc
			default:
				fail oauthError(OAuthErrorKind.Malformed, "{what} is not a JSON object")
		}
	}

	def member(m map<string, any>, name string) !any {
		let v = m.get(name)
		fail oauthError(OAuthErrorKind.Malformed, "\"{name}\" is missing") when v is none
		return v
	}

	def textOf(m map<string, any>, name string) !string {
		let v = try member(m, name)
		match v {
			case string:
				return v
			default:
				fail oauthError(OAuthErrorKind.Malformed, "\"{name}\" must be a string")
		}
	}

	def intOf(m map<string, any>, name string) !int {
		let v = try member(m, name)
		match v {
			case int:
				return v
			case string:
				// Some servers send numbers as strings; accept digits only.
				fail oauthError(OAuthErrorKind.Malformed, "\"{name}\" must be an integer") unless /^[0-9]+$/.test(v)
				return parseInt<int>(v)
			default:
				fail oauthError(OAuthErrorKind.Malformed, "\"{name}\" must be an integer")
		}
	}

	def boolOf(m map<string, any>, name string) !bool {
		let v = try member(m, name)
		match v {
			case bool:
				return v
			default:
				fail oauthError(OAuthErrorKind.Malformed, "\"{name}\" must be true or false")
		}
	}

	def stringsOf(m map<string, any>, name string) !string[] {
		let v = try member(m, name)
		match v {
			case any[]:
				let out string[] = []
				for let e in v {
					match e {
						case string:
							out.push(e)
						default:
							fail oauthError(OAuthErrorKind.Malformed, "\"{name}\" must hold strings")
					}
				}
				return out
			default:
				fail oauthError(OAuthErrorKind.Malformed, "\"{name}\" must be an array")
		}
	}

	def objectOf(m map<string, any>, name string) !map<string, any> {
		let v = try member(m, name)
		match v {
			case map<string, any>:
				return v
			default:
				fail oauthError(OAuthErrorKind.Malformed, "\"{name}\" must be an object")
		}
	}

	def stringsValue(list string[]) any[] {
		let out any[] = []
		for let s in list {
			out.push(s)
		}
		return out
	}

	def encodeJSON(m map<string, any>) string {
		return string(new JSON().encode(m))
	}

	// spaceList splits a space-separated list (`scope`), dropping empty
	// entries.
	def spaceList(text string) string[] {
		return text.split(" ").filter(s => s != "")
	}

	// Metadata -----------------------------------------------------------

	// wellKnown is the RFC 8414 §3.1 URL: the well-known path between the
	// issuer's host and its path.
	def wellKnown(issuer string, suffix string) string {
		let parsed = true
		let u = url.parse(issuer) onerror (err error) {
			parsed = false
			recover new url.URL()
		}
		return issuer.trimSuffix("/") + "/.well-known/" + suffix unless parsed
		return u.scheme + "://" + u.host + "/.well-known/" + suffix + u.path.trimSuffix("/")
	}

	// fetchMetadata reads metadata from one URL: none when it does not
	// answer 200. Fails with Transport when it cannot be reached, Malformed
	// for a bad document, IssuerMismatch for another issuer.
	def fetchMetadata(client http.Client, target string, issuer string) !?ServerMetadata {
		let res = client.get(target) onerror (err error) {
			fail OAuthError{message: "oauth2: cannot reach {target}: {err.message}", code: OAuthErrorKind.Transport.value, cause: err, kind: OAuthErrorKind.Transport}
		}
		return none unless res.status == 200
		let text = res.text() onerror fail oauthError(OAuthErrorKind.Transport, "cannot read {target}")
		let doc = try parseMetadata(text)
		fail oauthError(OAuthErrorKind.IssuerMismatch, "{target} names issuer {doc.issuer}, not {issuer}") unless doc.issuer == issuer
		return doc
	}

	// Responses ----------------------------------------------------------

	def kindOf(code string) OAuthErrorKind {
		for let (i, v) in OAuthErrorKind.values() {
			return OAuthErrorKind(i) when v == code
		}
		return OAuthErrorKind.Other
	}

	// serverError is the error an OAuth response carries (RFC 6749 §5.2):
	// its JSON `error`, `error_description` and `error_uri`, or the HTTP
	// status when the body is not such an object.
	def serverError(status int, body string, wwwAuthenticate string = "") error {
		let o = parseObject(body, "error") onerror recover new map<string, any>()
		let code = o.hasKey("error") ?? (textOf(o, "error") onerror recover "", "")
		code = challengeParam(wwwAuthenticate, "error") when code == "" && wwwAuthenticate != ""
		let description = o.hasKey("error_description") ?? (textOf(o, "error_description") onerror recover "", challengeParam(wwwAuthenticate, "error_description"))
		let uri = o.hasKey("error_uri") ?? (textOf(o, "error_uri") onerror recover "", "")
		let kind = code == "" ?? ((status >= 500) ?? (OAuthErrorKind.ServerError, OAuthErrorKind.Malformed), kindOf(code))
		let text = code == "" ?? ("the server answered {status}", description == "" ?? (code, code + ": " + description))
		return OAuthError{message: "oauth2: " + text, code: kind.value, kind: kind, error: code, description: description, uri: uri, status: status}
	}

	// challengeParam reads one auth-param from a WWW-Authenticate value
	// (RFC 6750 §3), "" when absent.
	def challengeParam(header string, name string) string {
		let at = header.indexOf(name + "=\"")
		return "" when at < 0
		let start = at + name.len() + 2
		let end = header.indexOf("\"", start)
		return end < 0 ?? ("", header[start:end])
	}
}
