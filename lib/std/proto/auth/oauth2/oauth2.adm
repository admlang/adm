// OAuth 2.0 (RFC 6749) and its extensions: a client for every grant, an
// authorization server, and a resource server. PKCE (RFC 7636), the device
// flow (RFC 8628), revocation (RFC 7009), introspection (RFC 7662), server
// metadata (RFC 8414), dynamic registration (RFC 7591, RFC 7592), pushed
// requests (RFC 9126), request objects (RFC 9101), DPoP (RFC 9449), token
// exchange (RFC 8693), JWT access tokens (RFC 9068), JWT client
// authentication and grants (RFC 7523), mTLS (RFC 8705), resource
// indicators (RFC 8707) and the `iss` response parameter (RFC 9207), with
// the security practice of RFC 9700.
//
// ```
// let meta = try oauth2.discover("https://as.example")
// let client = new oauth2.Client("my-app", meta)
// let req = try client.authorize("https://app.example/cb", ["read"])
// // send the browser to req.url; on return:
// let token = try client.exchange(req, callbackURL)
// ```
partial module std.proto.auth.oauth2 {
	use (
		std.errors
		std.time
		std.net.http
		std.proto.auth.oauth2.engine::*
	)

	// ClientAuthentication is how a client proves itself at the token
	// endpoint (RFC 6749 §2.3, RFC 7523, RFC 8705); its value is the
	// registered `token_endpoint_auth_method` name.
	enum ClientAuthentication {
		// A public client: `client_id` only.
		None = "none",
		// HTTP Basic with the client id and secret.
		SecretBasic = "client_secret_basic",
		// The id and secret in the request body.
		SecretPost = "client_secret_post",
		// A JWT signed with the secret (HS256).
		SecretJwt = "client_secret_jwt",
		// A JWT signed with the client's private key.
		PrivateKeyJwt = "private_key_jwt",
		// A CA-issued TLS client certificate.
		TlsClient = "tls_client_auth",
		// A self-signed TLS client certificate registered by key.
		SelfSignedTlsClient = "self_signed_tls_client_auth",
	}

	// TokenType names a token's kind in a token exchange (RFC 8693 §3).
	enum TokenType {
		AccessToken = "urn:ietf:params:oauth:token-type:access_token",
		RefreshToken = "urn:ietf:params:oauth:token-type:refresh_token",
		IdToken = "urn:ietf:params:oauth:token-type:id_token",
		Saml1 = "urn:ietf:params:oauth:token-type:saml1",
		Saml2 = "urn:ietf:params:oauth:token-type:saml2",
		Jwt = "urn:ietf:params:oauth:token-type:jwt",
	}

	// OAuthErrorKind says why an OAuth exchange failed: the error codes of
	// RFC 6749, 6750, 7591, 8628, 8693, 8707, 9101, 9126 and 9449 and of
	// OpenID Connect (the value is the code on the wire), and the failures
	// a client detects itself.
	enum OAuthErrorKind {
		InvalidRequest = "invalid_request",
		InvalidClient = "invalid_client",
		InvalidGrant = "invalid_grant",
		UnauthorizedClient = "unauthorized_client",
		UnsupportedGrantType = "unsupported_grant_type",
		InvalidScope = "invalid_scope",
		AccessDenied = "access_denied",
		UnsupportedResponseType = "unsupported_response_type",
		ServerError = "server_error",
		TemporarilyUnavailable = "temporarily_unavailable",
		InvalidToken = "invalid_token",
		InsufficientScope = "insufficient_scope",
		AuthorizationPending = "authorization_pending",
		SlowDown = "slow_down",
		ExpiredToken = "expired_token",
		InvalidTarget = "invalid_target",
		InvalidRedirectUri = "invalid_redirect_uri",
		InvalidClientMetadata = "invalid_client_metadata",
		InvalidSoftwareStatement = "invalid_software_statement",
		UnapprovedSoftwareStatement = "unapproved_software_statement",
		InvalidRequestUri = "invalid_request_uri",
		InvalidRequestObject = "invalid_request_object",
		RequestNotSupported = "request_not_supported",
		RequestUriNotSupported = "request_uri_not_supported",
		InvalidDpopProof = "invalid_dpop_proof",
		UseDpopNonce = "use_dpop_nonce",
		LoginRequired = "login_required",
		ConsentRequired = "consent_required",
		InteractionRequired = "interaction_required",
		AccountSelectionRequired = "account_selection_required",
		// The server answered with an error code not listed here; `error`
		// holds it.
		Other = "other",
		// The authorization response's `state` is not the one sent.
		StateMismatch = "state_mismatch",
		// The authorization response or metadata names another issuer.
		IssuerMismatch = "issuer_mismatch",
		// A response was not the JSON or form the protocol defines.
		Malformed = "malformed",
		// The request could not be sent or answered.
		Transport = "transport",
	}

	// OAuthError is the payload of every failure in this module. `kind`
	// tells them apart; `error`, `description` and `uri` hold what the
	// server sent, and `status` its HTTP status (0 when there was none).
	struct OAuthError {
		message     string
		code        string
		cause       ?error
		stack       errors.StackTrace
		kind        OAuthErrorKind
		error       string
		description string
		uri         string
		status      int
	}

	// Token is what a token endpoint issues (RFC 6749 §5.1).
	type Token {
		accessToken     Secret<string>
		// "Bearer", "DPoP", or "N_A" for an exchanged token that is not an
		// access token.
		tokenType       string           = "Bearer"
		expiresAt       ?time.Time
		refreshToken    ?Secret<string>
		scope           string[]         = []
		idToken         ?string
		// RFC 8693: the type of the issued token.
		issuedTokenType ?string
		internal extra  map<string, any>

		def new(accessToken Secret<string>) {
			self.accessToken = accessToken
		}

		// expired reports whether the token has passed its expiry, or will
		// within leeway; false when the server gave no lifetime.
		def expired(leeway duration = 30s) bool {
			let at = expiresAt
			return false when at is none
			return !time.now().before(at - leeway)
		}

		// get returns a response member this type has no field for; none
		// when the response did not have it.
		def get(name string) ?any {
			return extra.get(name)
		}
	}

	// ServerMetadata is an authorization server's metadata (RFC 8414 §2 and
	// the members later RFCs register). Members not listed stay readable
	// through get.
	type ServerMetadata {
		issuer                                     string
		authorizationEndpoint                      ?string
		tokenEndpoint                              ?string
		jwksUri                                    ?string
		registrationEndpoint                       ?string
		scopesSupported                            string[]            = []
		responseTypesSupported                     string[]            = []
		responseModesSupported                     string[]            = []
		grantTypesSupported                        string[]            = []
		tokenEndpointAuthMethodsSupported          string[]            = []
		tokenEndpointAuthSigningAlgValuesSupported string[]            = []
		serviceDocumentation                       ?string
		uiLocalesSupported                         string[]            = []
		opPolicyUri                                ?string
		opTosUri                                   ?string
		revocationEndpoint                         ?string
		revocationEndpointAuthMethodsSupported     string[]            = []
		introspectionEndpoint                      ?string
		introspectionEndpointAuthMethodsSupported  string[]            = []
		codeChallengeMethodsSupported              string[]            = []
		deviceAuthorizationEndpoint                ?string
		pushedAuthorizationRequestEndpoint         ?string
		requirePushedAuthorizationRequests         bool                = false
		requireSignedRequestObject                 bool                = false
		requestObjectSigningAlgValuesSupported     string[]            = []
		dpopSigningAlgValuesSupported              string[]            = []
		authorizationResponseIssParameterSupported bool                = false
		tlsClientCertificateBoundAccessTokens      bool                = false
		// RFC 8705 §5: endpoints to use with mutual TLS, by member name.
		mtlsEndpointAliases                        map<string, string>
		internal extra                             map<string, any>

		def new(issuer string) {
			self.issuer = issuer
		}

		// get returns a metadata member as JSON gives it (such as an
		// OpenID Connect member); none when absent.
		def get(name string) ?any {
			return extra.get(name)
		}

		// set sets a member this type has no field for, as JSON gives it.
		def set(name string, value any) {
			extra.set(name, value)
		}

		// json renders the metadata document.
		def json() string {
			return encodeJSON(metadataMembers(self))
		}
	}

	// discover fetches an authorization server's metadata from
	// `/.well-known/oauth-authorization-server` (RFC 8414 §3, inserted
	// before the issuer's path), falling back to OpenID Connect's
	// `/.well-known/openid-configuration`. Fails with Transport when
	// neither answers, Malformed when the document is not metadata, and
	// IssuerMismatch when it names another issuer (RFC 8414 §3.3).
	def discover(issuer string, client ?http.Client = none) !ServerMetadata {
		let http = client is none ?? (new http.Client(), client)
		let first = try fetchMetadata(http, wellKnown(issuer, "oauth-authorization-server"), issuer)
		return first unless first is none
		let second = try fetchMetadata(http, issuer.trimSuffix("/") + "/.well-known/openid-configuration", issuer)
		return second unless second is none
		fail oauthError(OAuthErrorKind.Transport, "no metadata found for {issuer}")
	}

	// parseMetadata reads a metadata document. Fails with Malformed when a
	// member has the wrong type.
	def parseMetadata(text string) !ServerMetadata {
		return try metadataFromMembers(try parseObject(text, "metadata"))
	}
}
