partial module std.proto.auth.oauth2 {
	use (
		std.net.http
		std.net.http::(Context, Handler, HandlerFunc)
		std.net.url
		std.proto.auth.oauth2.engine::*
	)

	// ResourceMetadata is a protected resource's metadata (RFC 9728 §2): what
	// a resource server publishes so a client finds the authorization
	// servers that issue tokens for it. Members not listed stay readable
	// through get.
	//
	// ```
	// let meta = new oauth2.ResourceMetadata("https://api.example/v1", ["https://as.example"])
	// try mux.handle(meta.metadataPath(), meta.handler())
	// ```
	type ResourceMetadata {
		// The resource identifier: the URL clients address, without a
		// fragment. It is the `resource` a client asks a token for (RFC
		// 8707) and the audience the token names.
		resource                              string
		// The issuers of the authorization servers that serve the resource.
		authorizationServers                  string[]         = []
		jwksUri                               ?string
		scopesSupported                       string[]         = []
		// `header`, `body`, `query` (RFC 6750 §2).
		bearerMethodsSupported                string[]         = []
		resourceSigningAlgValuesSupported     string[]         = []
		resourceName                          ?string
		resourceDocumentation                 ?string
		resourcePolicyUri                     ?string
		resourceTosUri                        ?string
		tlsClientCertificateBoundAccessTokens bool             = false
		authorizationDetailsTypesSupported    string[]         = []
		dpopSigningAlgValuesSupported         string[]         = []
		dpopBoundAccessTokensRequired         bool             = false
		// The metadata again as a JWT signed by its issuer (RFC 9728 §2.2),
		// as received; this module does not verify it.
		signedMetadata                        ?string
		internal extra                        map<string, any>

		def new(resource string, authorizationServers string[] = []) {
			self.resource = resource
			self.authorizationServers = authorizationServers
		}

		// get returns a member this type has no field for, such as a name
		// in one language (`resource_name#fr`); none when absent.
		def get(name string) ?any {
			return extra.get(name)
		}

		// set sets a member this type has no field for, as JSON gives it.
		def set(name string, value any) {
			extra.set(name, value)
		}

		// json renders the metadata document.
		def json() string {
			return encodeJSON(resourceMembers(self))
		}

		// metadataUrl is where the document is published: `resource` with
		// `/.well-known/oauth-protected-resource` between its host and its
		// path (RFC 9728 §3.1).
		def metadataUrl() string {
			return wellKnown(resource, "oauth-protected-resource")
		}

		// metadataPath is the path of metadataUrl, the route to serve
		// handler on.
		def metadataPath() string {
			return "/.well-known/oauth-protected-resource" + basePath(resource)
		}

		// covers reports whether the metadata describes the resource at
		// target: `resource` is target itself, or names the same origin and
		// a path target lies under (a server at `https://api.example/mcp`
		// may call itself `https://api.example`).
		def covers(target string) bool {
			return true when resource == target
			let parsed = true
			let own = url.parse(resource) onerror (err error) {
				parsed = false
				recover new url.URL()
			}
			let other = url.parse(target) onerror (err error) {
				parsed = false
				recover new url.URL()
			}
			return false unless parsed && own.rawQuery == "" && own.fragment == ""
			return false unless own.scheme.lower() == other.scheme.lower() && own.host.lower() == other.host.lower()
			let under = own.path.trimSuffix("/")
			return other.path == under || other.path.startsWith(under + "/")
		}

		// handler serves the document (RFC 9728 §3.2); mount it on metadataPath().
		def handler() Handler {
			let document = self
			return new HandlerFunc(def (ctx Context) !none {
				ctx.setHeader("Cache-Control", "max-age=3600")
				ctx.setHeader("Access-Control-Allow-Origin", "*")
				return try ctx.blob(200, "application/json", document.json().bytes())
			})
		}
	}

	// parseResourceMetadata reads a protected resource metadata document.
	// Fails with Malformed without `resource` or when a member has the wrong
	// type.
	def parseResourceMetadata(text string) !ResourceMetadata {
		return try resourceFromMembers(try parseObject(text, "resource metadata"))
	}

	// discoverResource fetches the metadata of the protected resource at
	// target. With metadataUrl, the `resource_metadata` a challenge named
	// (RFC 9728 §5.1), that document is fetched; without, the well-known
	// URL of target (§3.1) and then the one of its origin are tried. Fails
	// with Transport when nothing answers, Malformed when the document is
	// not metadata, and ResourceMismatch when it describes a resource that
	// does not cover target (§3.3).
	def discoverResource(target string, client ?http.Client = none, metadataUrl ?string = none) !ResourceMetadata {
		let http = client is none ?? (new http.Client(), client)
		let candidates string[] = []
		if metadataUrl is none {
			candidates.push(wellKnown(target, "oauth-protected-resource"))
			let root = wellKnown(originOf(target), "oauth-protected-resource")
			candidates.push(root) unless root in candidates
		} else {
			candidates.push(metadataUrl)
		}
		for let at in candidates {
			let res = http.get(at) onerror (err error) {
				fail OAuthError{message: "oauth2: cannot reach {at}: {err.message}", code: OAuthErrorKind.Transport.value, cause: err, kind: OAuthErrorKind.Transport}
			}
			if res.status != 200 {
				res.close() onerror recover none
				continue
			}
			let text = res.text() onerror fail oauthError(OAuthErrorKind.Transport, "cannot read {at}")
			let doc = try parseResourceMetadata(text)
			fail oauthError(OAuthErrorKind.ResourceMismatch, "{at} describes {doc.resource}, not {target}") unless doc.covers(target)
			return doc
		}
		fail oauthError(OAuthErrorKind.Transport, "no protected resource metadata found for {target}")
	}

	internal def resourceFromMembers(o map<string, any>) !ResourceMetadata {
		let m = new ResourceMetadata(try textOf(o, "resource"))
		for let (name, value) in o {
			match name {
				case "resource":
				case "authorization_servers":
					m.authorizationServers = try stringsOf(o, name)
				case "jwks_uri":
					m.jwksUri = try textOf(o, name)
				case "scopes_supported":
					m.scopesSupported = try stringsOf(o, name)
				case "bearer_methods_supported":
					m.bearerMethodsSupported = try stringsOf(o, name)
				case "resource_signing_alg_values_supported":
					m.resourceSigningAlgValuesSupported = try stringsOf(o, name)
				case "resource_name":
					m.resourceName = try textOf(o, name)
				case "resource_documentation":
					m.resourceDocumentation = try textOf(o, name)
				case "resource_policy_uri":
					m.resourcePolicyUri = try textOf(o, name)
				case "resource_tos_uri":
					m.resourceTosUri = try textOf(o, name)
				case "tls_client_certificate_bound_access_tokens":
					m.tlsClientCertificateBoundAccessTokens = try boolOf(o, name)
				case "authorization_details_types_supported":
					m.authorizationDetailsTypesSupported = try stringsOf(o, name)
				case "dpop_signing_alg_values_supported":
					m.dpopSigningAlgValuesSupported = try stringsOf(o, name)
				case "dpop_bound_access_tokens_required":
					m.dpopBoundAccessTokensRequired = try boolOf(o, name)
				case "signed_metadata":
					m.signedMetadata = try textOf(o, name)
				default:
					m.extra.set(name, value)
			}
		}
		return m
	}

	// resourceMembers is resource metadata as JSON values; members without a
	// value are left out (RFC 9728 §3.2).
	internal def resourceMembers(m ResourceMetadata) map<string, any> {
		let o map<string, any>
		o.set("resource", m.resource)
		o.set("authorization_servers", stringsValue(m.authorizationServers)) when m.authorizationServers.len() > 0
		let jwksUri = m.jwksUri
		o.set("jwks_uri", jwksUri) unless jwksUri is none
		o.set("scopes_supported", stringsValue(m.scopesSupported)) when m.scopesSupported.len() > 0
		o.set("bearer_methods_supported", stringsValue(m.bearerMethodsSupported)) when m.bearerMethodsSupported.len() > 0
		o.set("resource_signing_alg_values_supported", stringsValue(m.resourceSigningAlgValuesSupported)) when m.resourceSigningAlgValuesSupported.len() > 0
		let name = m.resourceName
		o.set("resource_name", name) unless name is none
		let documentation = m.resourceDocumentation
		o.set("resource_documentation", documentation) unless documentation is none
		let policy = m.resourcePolicyUri
		o.set("resource_policy_uri", policy) unless policy is none
		let tos = m.resourceTosUri
		o.set("resource_tos_uri", tos) unless tos is none
		o.set("tls_client_certificate_bound_access_tokens", true) when m.tlsClientCertificateBoundAccessTokens
		o.set("authorization_details_types_supported", stringsValue(m.authorizationDetailsTypesSupported)) when m.authorizationDetailsTypesSupported.len() > 0
		o.set("dpop_signing_alg_values_supported", stringsValue(m.dpopSigningAlgValuesSupported)) when m.dpopSigningAlgValuesSupported.len() > 0
		o.set("dpop_bound_access_tokens_required", true) when m.dpopBoundAccessTokensRequired
		let signed = m.signedMetadata
		o.set("signed_metadata", signed) unless signed is none
		for let (member, value) in m.extra {
			o.set(member, value) unless o.hasKey(member)
		}
		return o
	}
}
