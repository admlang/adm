partial module std.proto.auth.oauth2 {
	use (
		std.time
	)

	// GrantKind says what a stored Grant stands for.
	enum GrantKind {
		// An authorization request parked while the user logs in, keyed by
		// its id.
		Pending,
		// An authorization request pushed with PAR, keyed by its
		// request_uri.
		Pushed,
		// An authorization code.
		Code,
		// An opaque access token.
		AccessToken,
		// A refresh token.
		RefreshToken,
		// A device code, keyed by the device code.
		DeviceCode,
		// The same device authorization, keyed by its user code.
		UserCode,
	}

	// Grant is what the authorization server remembers about a request,
	// code or token: who it is for, what it allows, and the request
	// parameters it came from.
	type Grant {
		clientId        string              = ""
		// The user the grant is for; "" until the user logs in, and for a
		// client_credentials grant.
		subject         string              = ""
		scopes          string[]            = []
		redirectUri     string              = ""
		// The PKCE challenge and its method.
		codeChallenge   string              = ""
		challengeMethod string              = ""
		resource        string[]            = []
		authTime        ?time.Time
		acr             ?string
		amr             string[]            = []
		// The DPoP key thumbprint (RFC 9449 §6) or certificate thumbprint
		// (RFC 8705 §3) tokens issued from this grant are bound to.
		dpopJkt         ?string
		certThumbprint  ?string
		expiresAt       time.Time
		// The authorization request's parameters, by name.
		params          map<string, string>
		// Claims a provider adds (OpenID Connect).
		claims          map<string, any>
		// Device flow state: "pending", "approved" or "denied".
		status          string              = "pending"
		// The last time a device code was polled, for slow_down.
		lastPoll        ?time.Time

		def new(expiresAt time.Time) {
			self.expiresAt = expiresAt
		}

		// expired reports whether the grant has passed its lifetime.
		def expired() bool {
			return !time.now().before(expiresAt)
		}
	}

	// RegisteredClient is what the authorization server knows of a client.
	type RegisteredClient {
		id                      string
		// The client secret; none for a public client or one that
		// authenticates with a key or certificate.
		secret                  ?Secret<string>
		metadata                ClientMetadata
		// The registration access token (RFC 7592), when it was registered
		// dynamically.
		registrationAccessToken ?Secret<string>

		def new(id string, metadata ClientMetadata) {
			self.id = id
			self.metadata = metadata
		}

		// authMethod is the client's registered token endpoint
		// authentication method; client_secret_basic when it has a secret
		// and says none, `none` without one.
		def authMethod() string {
			let method = metadata.tokenEndpointAuthMethod
			return method unless method is none
			return secret is none ?? ("none", "client_secret_basic")
		}

		// isPublic reports whether the client cannot keep a credential:
		// its authentication method is `none`.
		def isPublic() bool {
			return authMethod() == "none"
		}

		// allows reports whether the client registered a grant type; every
		// client may use authorization_code and refresh_token when it
		// registered none (RFC 7591 §2 default).
		def allows(grantType string) bool {
			return grantType := "authorization_code" || "refresh_token" when metadata.grantTypes.len() == 0
			return grantType in metadata.grantTypes
		}
	}

	// ClientStore holds the clients an authorization server knows.
	interface ClientStore {
		// client returns the client with this id, none when unknown.
		def client(id string) !?RegisteredClient
		// save adds or replaces a client.
		def save(client RegisteredClient) !none
		// remove deletes a client.
		def remove(id string) !none
	}

	// GrantStore holds pending requests, codes and tokens. `take` must
	// return a grant at most once, even under concurrent calls: it is how
	// codes stay single-use.
	interface GrantStore {
		def put(kind GrantKind, key string, grant Grant) !none
		// get returns a live grant, none when absent or expired.
		def get(kind GrantKind, key string) !?Grant
		// take returns a live grant and removes it, none when absent or
		// expired.
		def take(kind GrantKind, key string) !?Grant
		def remove(kind GrantKind, key string) !none
	}

	// MemoryClientStore keeps clients in memory; the default ClientStore.
	type MemoryClientStore {
		internal clients map<string, RegisteredClient>

		def new() {}

		// client implements ClientStore. Never fails.
		atomic def client(id string) !?RegisteredClient {
			return clients.get(id)
		}

		// save implements ClientStore. Never fails.
		atomic def save(client RegisteredClient) !none {
			clients.set(client.id, client)
			return none
		}

		// remove implements ClientStore. Never fails.
		atomic def remove(id string) !none {
			clients.delete(id)
			return none
		}
	}

	// MemoryGrantStore keeps grants in memory and drops expired ones as it
	// meets them; the default GrantStore.
	type MemoryGrantStore {
		internal grants map<string, Grant>
		internal writes int                = 0

		def new() {}

		// put implements GrantStore. Never fails.
		atomic def put(kind GrantKind, key string, grant Grant) !none {
			grants.set(kind.name + ":" + key, grant)
			writes++
			if writes % 256 == 0 {
				for let k in grants.keys() {
					let g = grants.get(k)
					grants.delete(k) when !(g is none) && g.expired()
				}
			}
			return none
		}

		// get implements GrantStore. Never fails.
		atomic def get(kind GrantKind, key string) !?Grant {
			let g = grants.get(kind.name + ":" + key)
			return none when g is none || g.expired()
			return g
		}

		// take implements GrantStore. Never fails.
		atomic def take(kind GrantKind, key string) !?Grant {
			let k = kind.name + ":" + key
			let g = grants.get(k)
			grants.delete(k)
			return none when g is none || g.expired()
			return g
		}

		// remove implements GrantStore. Never fails.
		atomic def remove(kind GrantKind, key string) !none {
			grants.delete(kind.name + ":" + key)
			return none
		}
	}
}
