partial module std.proto.auth.oauth2 {
	use (
		std.time
		std.proto.auth.jose
		std.proto.auth.oauth2.engine::*
	)

	internal def metadataFromMembers(o map<string, any>) !ServerMetadata {
		let m = new ServerMetadata(try textOf(o, "issuer"))
		for let (name, value) in o {
			match name {
				case "issuer":
				case "authorization_endpoint":
					m.authorizationEndpoint = try textOf(o, name)
				case "token_endpoint":
					m.tokenEndpoint = try textOf(o, name)
				case "jwks_uri":
					m.jwksUri = try textOf(o, name)
				case "registration_endpoint":
					m.registrationEndpoint = try textOf(o, name)
				case "scopes_supported":
					m.scopesSupported = try stringsOf(o, name)
				case "response_types_supported":
					m.responseTypesSupported = try stringsOf(o, name)
				case "response_modes_supported":
					m.responseModesSupported = try stringsOf(o, name)
				case "grant_types_supported":
					m.grantTypesSupported = try stringsOf(o, name)
				case "token_endpoint_auth_methods_supported":
					m.tokenEndpointAuthMethodsSupported = try stringsOf(o, name)
				case "token_endpoint_auth_signing_alg_values_supported":
					m.tokenEndpointAuthSigningAlgValuesSupported = try stringsOf(o, name)
				case "service_documentation":
					m.serviceDocumentation = try textOf(o, name)
				case "ui_locales_supported":
					m.uiLocalesSupported = try stringsOf(o, name)
				case "op_policy_uri":
					m.opPolicyUri = try textOf(o, name)
				case "op_tos_uri":
					m.opTosUri = try textOf(o, name)
				case "revocation_endpoint":
					m.revocationEndpoint = try textOf(o, name)
				case "revocation_endpoint_auth_methods_supported":
					m.revocationEndpointAuthMethodsSupported = try stringsOf(o, name)
				case "introspection_endpoint":
					m.introspectionEndpoint = try textOf(o, name)
				case "introspection_endpoint_auth_methods_supported":
					m.introspectionEndpointAuthMethodsSupported = try stringsOf(o, name)
				case "code_challenge_methods_supported":
					m.codeChallengeMethodsSupported = try stringsOf(o, name)
				case "device_authorization_endpoint":
					m.deviceAuthorizationEndpoint = try textOf(o, name)
				case "pushed_authorization_request_endpoint":
					m.pushedAuthorizationRequestEndpoint = try textOf(o, name)
				case "require_pushed_authorization_requests":
					m.requirePushedAuthorizationRequests = try boolOf(o, name)
				case "require_signed_request_object":
					m.requireSignedRequestObject = try boolOf(o, name)
				case "request_object_signing_alg_values_supported":
					m.requestObjectSigningAlgValuesSupported = try stringsOf(o, name)
				case "dpop_signing_alg_values_supported":
					m.dpopSigningAlgValuesSupported = try stringsOf(o, name)
				case "authorization_response_iss_parameter_supported":
					m.authorizationResponseIssParameterSupported = try boolOf(o, name)
				case "tls_client_certificate_bound_access_tokens":
					m.tlsClientCertificateBoundAccessTokens = try boolOf(o, name)
				case "mtls_endpoint_aliases":
					let aliases = try objectOf(o, name)
					for let (k, v) in aliases {
						match v {
							case string:
								m.mtlsEndpointAliases.set(k, v)
							default:
								fail oauthError(OAuthErrorKind.Malformed, "\"mtls_endpoint_aliases\" must hold strings")
						}
					}
				default:
					m.extra.set(name, value)
			}
		}
		return m
	}

	internal def metadataMembers(m ServerMetadata) map<string, any> {
		let o map<string, any>
		o.set("issuer", m.issuer)
		let authorizationEndpointValue = m.authorizationEndpoint
		o.set("authorization_endpoint", authorizationEndpointValue) unless authorizationEndpointValue is none
		let tokenEndpointValue = m.tokenEndpoint
		o.set("token_endpoint", tokenEndpointValue) unless tokenEndpointValue is none
		let jwksUriValue = m.jwksUri
		o.set("jwks_uri", jwksUriValue) unless jwksUriValue is none
		let registrationEndpointValue = m.registrationEndpoint
		o.set("registration_endpoint", registrationEndpointValue) unless registrationEndpointValue is none
		o.set("scopes_supported", stringsValue(m.scopesSupported)) when m.scopesSupported.len() > 0
		o.set("response_types_supported", stringsValue(m.responseTypesSupported)) when m.responseTypesSupported.len() > 0
		o.set("response_modes_supported", stringsValue(m.responseModesSupported)) when m.responseModesSupported.len() > 0
		o.set("grant_types_supported", stringsValue(m.grantTypesSupported)) when m.grantTypesSupported.len() > 0
		o.set("token_endpoint_auth_methods_supported", stringsValue(m.tokenEndpointAuthMethodsSupported)) when m.tokenEndpointAuthMethodsSupported.len() > 0
		o.set("token_endpoint_auth_signing_alg_values_supported", stringsValue(m.tokenEndpointAuthSigningAlgValuesSupported)) when m.tokenEndpointAuthSigningAlgValuesSupported.len() > 0
		let serviceDocumentationValue = m.serviceDocumentation
		o.set("service_documentation", serviceDocumentationValue) unless serviceDocumentationValue is none
		o.set("ui_locales_supported", stringsValue(m.uiLocalesSupported)) when m.uiLocalesSupported.len() > 0
		let opPolicyUriValue = m.opPolicyUri
		o.set("op_policy_uri", opPolicyUriValue) unless opPolicyUriValue is none
		let opTosUriValue = m.opTosUri
		o.set("op_tos_uri", opTosUriValue) unless opTosUriValue is none
		let revocationEndpointValue = m.revocationEndpoint
		o.set("revocation_endpoint", revocationEndpointValue) unless revocationEndpointValue is none
		o.set("revocation_endpoint_auth_methods_supported", stringsValue(m.revocationEndpointAuthMethodsSupported)) when m.revocationEndpointAuthMethodsSupported.len() > 0
		let introspectionEndpointValue = m.introspectionEndpoint
		o.set("introspection_endpoint", introspectionEndpointValue) unless introspectionEndpointValue is none
		o.set("introspection_endpoint_auth_methods_supported", stringsValue(m.introspectionEndpointAuthMethodsSupported)) when m.introspectionEndpointAuthMethodsSupported.len() > 0
		o.set("code_challenge_methods_supported", stringsValue(m.codeChallengeMethodsSupported)) when m.codeChallengeMethodsSupported.len() > 0
		let deviceAuthorizationEndpointValue = m.deviceAuthorizationEndpoint
		o.set("device_authorization_endpoint", deviceAuthorizationEndpointValue) unless deviceAuthorizationEndpointValue is none
		let pushedAuthorizationRequestEndpointValue = m.pushedAuthorizationRequestEndpoint
		o.set("pushed_authorization_request_endpoint", pushedAuthorizationRequestEndpointValue) unless pushedAuthorizationRequestEndpointValue is none
		o.set("require_pushed_authorization_requests", true) when m.requirePushedAuthorizationRequests
		o.set("require_signed_request_object", true) when m.requireSignedRequestObject
		o.set("request_object_signing_alg_values_supported", stringsValue(m.requestObjectSigningAlgValuesSupported)) when m.requestObjectSigningAlgValuesSupported.len() > 0
		o.set("dpop_signing_alg_values_supported", stringsValue(m.dpopSigningAlgValuesSupported)) when m.dpopSigningAlgValuesSupported.len() > 0
		o.set("authorization_response_iss_parameter_supported", true) when m.authorizationResponseIssParameterSupported
		o.set("tls_client_certificate_bound_access_tokens", true) when m.tlsClientCertificateBoundAccessTokens
		if m.mtlsEndpointAliases.len() > 0 {
			let aliases map<string, any>
			for let (k, v) in m.mtlsEndpointAliases {
				aliases.set(k, v)
			}
			o.set("mtls_endpoint_aliases", aliases)
		}
		for let (name, value) in m.extra {
			o.set(name, value) unless o.hasKey(name)
		}
		return o
	}

	// tokenFromMembers reads a token response (RFC 6749 §5.1, RFC 8693
	// §2.2.1). Fails with Malformed when `access_token` or `token_type`
	// is missing or a member has the wrong type.
	internal def tokenFromMembers(o map<string, any>) !Token {
		let t = new Token(try textOf(o, "access_token"))
		t.tokenType = try textOf(o, "token_type")
		for let (name, value) in o {
			match name {
				case "access_token", "token_type":
				case "expires_in":
					t.expiresAt = time.now() + 1s * float(try intOf(o, name))
				case "refresh_token":
					t.refreshToken = try textOf(o, name)
				case "scope":
					t.scope = spaceList(try textOf(o, name))
				case "id_token":
					t.idToken = try textOf(o, name)
				case "issued_token_type":
					t.issuedTokenType = try textOf(o, name)
				default:
					t.extra.set(name, value)
			}
		}
		return t
	}

	// introspectionFromMembers reads an introspection response (RFC 7662
	// §2.2). Fails with Malformed without `active` or for a member of the
	// wrong type.
	internal def introspectionFromMembers(o map<string, any>) !Introspection {
		let r = new Introspection()
		r.active = try boolOf(o, "active")
		for let (name, value) in o {
			match name {
				case "active":
				case "scope":
					r.scope = spaceList(try textOf(o, name))
				case "client_id":
					r.clientId = try textOf(o, name)
				case "username":
					r.username = try textOf(o, name)
				case "token_type":
					r.tokenType = try textOf(o, name)
				case "exp":
					r.expires = time.fromUnixNs(int64(try intOf(o, name)) * 1000000000)
				case "iat":
					r.issuedAt = time.fromUnixNs(int64(try intOf(o, name)) * 1000000000)
				case "nbf":
					r.notBefore = time.fromUnixNs(int64(try intOf(o, name)) * 1000000000)
				case "sub":
					r.subject = try textOf(o, name)
				case "aud":
					match value {
						case string:
							r.audience = [value]
						default:
							r.audience = try stringsOf(o, name)
					}
				case "iss":
					r.issuer = try textOf(o, name)
				case "jti":
					r.id = try textOf(o, name)
				default:
					r.extra.set(name, value)
			}
		}
		return r
	}

	// clientMetadataMembers is client metadata as JSON values (RFC 7591 §2).
	internal def clientMetadataMembers(c ClientMetadata) map<string, any> {
		let o map<string, any>
		o.set("redirect_uris", stringsValue(c.redirectUris)) when c.redirectUris.len() > 0
		let auth = c.tokenEndpointAuthMethod
		o.set("token_endpoint_auth_method", auth) unless auth is none
		o.set("grant_types", stringsValue(c.grantTypes)) when c.grantTypes.len() > 0
		o.set("response_types", stringsValue(c.responseTypes)) when c.responseTypes.len() > 0
		let name = c.clientName
		o.set("client_name", name) unless name is none
		let clientUri = c.clientUri
		o.set("client_uri", clientUri) unless clientUri is none
		let logo = c.logoUri
		o.set("logo_uri", logo) unless logo is none
		let scope = c.scope
		o.set("scope", scope) unless scope is none
		o.set("contacts", stringsValue(c.contacts)) when c.contacts.len() > 0
		let tos = c.tosUri
		o.set("tos_uri", tos) unless tos is none
		let policy = c.policyUri
		o.set("policy_uri", policy) unless policy is none
		let jwksUri = c.jwksUri
		o.set("jwks_uri", jwksUri) unless jwksUri is none
		let jwks = c.jwks
		o.set("jwks", parseObject(jwks.json(), "jwks") onerror recover new map<string, any>()) unless jwks is none
		let softwareId = c.softwareId
		o.set("software_id", softwareId) unless softwareId is none
		let softwareVersion = c.softwareVersion
		o.set("software_version", softwareVersion) unless softwareVersion is none
		let statement = c.softwareStatement
		o.set("software_statement", statement) unless statement is none
		for let (k, v) in c.extra {
			o.set(k, v) unless o.hasKey(k)
		}
		return o
	}

	// clientMetadataFromMembers reads client metadata. Fails with
	// Malformed for a member of the wrong type.
	internal def clientMetadataFromMembers(o map<string, any>) !ClientMetadata {
		let c = new ClientMetadata()
		for let (name, value) in o {
			match name {
				case "redirect_uris":
					c.redirectUris = try stringsOf(o, name)
				case "token_endpoint_auth_method":
					c.tokenEndpointAuthMethod = try textOf(o, name)
				case "grant_types":
					c.grantTypes = try stringsOf(o, name)
				case "response_types":
					c.responseTypes = try stringsOf(o, name)
				case "client_name":
					c.clientName = try textOf(o, name)
				case "client_uri":
					c.clientUri = try textOf(o, name)
				case "logo_uri":
					c.logoUri = try textOf(o, name)
				case "scope":
					c.scope = try textOf(o, name)
				case "contacts":
					c.contacts = try stringsOf(o, name)
				case "tos_uri":
					c.tosUri = try textOf(o, name)
				case "policy_uri":
					c.policyUri = try textOf(o, name)
				case "jwks_uri":
					c.jwksUri = try textOf(o, name)
				case "jwks":
					c.jwks = jose.parseKeySet(encodeJSON(try objectOf(o, name))) onerror fail oauthError(OAuthErrorKind.InvalidClientMetadata, "\"jwks\" is not a JWK Set")
				case "software_id":
					c.softwareId = try textOf(o, name)
				case "software_version":
					c.softwareVersion = try textOf(o, name)
				case "software_statement":
					c.softwareStatement = try textOf(o, name)
				default:
					c.extra.set(name, value)
			}
		}
		return c
	}

	// registrationFromMembers reads a registration response (RFC 7591
	// §3.2.1). Fails with Malformed without `client_id`.
	internal def registrationFromMembers(o map<string, any>) !ClientRegistration {
		let r = new ClientRegistration()
		r.clientId = try textOf(o, "client_id")
		let rest map<string, any>
		for let (name, value) in o {
			match name {
				case "client_id":
				case "client_secret":
					r.clientSecret = try textOf(o, name)
				case "client_id_issued_at":
					r.clientIdIssuedAt = time.fromUnixNs(int64(try intOf(o, name)) * 1000000000)
				case "client_secret_expires_at":
					let at = try intOf(o, name)
					r.clientSecretExpiresAt = time.fromUnixNs(int64(at) * 1000000000) when at > 0
				case "registration_access_token":
					r.registrationAccessToken = try textOf(o, name)
				case "registration_client_uri":
					r.registrationClientUri = try textOf(o, name)
				default:
					rest.set(name, value)
			}
		}
		r.metadata = try clientMetadataFromMembers(rest)
		return r
	}
}
