internal partial module std.proto.auth.openid.engine {
	use (
		std.time
		std.data.encoding::(Base64, JSON)
		std.proto.auth.oauth2
	)

	def openidError(kind oauth2.OAuthErrorKind, text string) error {
		return oauth2.OAuthError{message: "openid: " + text, code: kind.value, kind: kind, description: text}
	}

	def b64url(data byte[]) string {
		let codec = new Base64()
		codec.padded = false
		codec.urlSafe = true
		return codec.encode(data)
	}

	def parseObject(text string, what string) !map<string, any> {
		let doc = new JSON().parse(text) onerror fail openidError(oauth2.OAuthErrorKind.Malformed, "{what} is not JSON")
		match doc {
			case map<string, any>:
				return doc
			default:
				fail openidError(oauth2.OAuthErrorKind.Malformed, "{what} is not a JSON object")
		}
	}

	def member(m map<string, any>, name string) !any {
		let v = m.get(name)
		fail openidError(oauth2.OAuthErrorKind.Malformed, "\"{name}\" is missing") when v is none
		return v
	}

	def textOf(m map<string, any>, name string) !string {
		let v = try member(m, name)
		match v {
			case string:
				return v
			default:
				fail openidError(oauth2.OAuthErrorKind.Malformed, "\"{name}\" must be a string")
		}
	}

	def boolOf(m map<string, any>, name string) !bool {
		let v = try member(m, name)
		match v {
			case bool:
				return v
			case string:
				// Some providers send "true"/"false" (Core §5.1 notes it).
				return v == "true"
			default:
				fail openidError(oauth2.OAuthErrorKind.Malformed, "\"{name}\" must be true or false")
		}
	}

	def stringsOf(m map<string, any>, name string) !string[] {
		let v = try member(m, name)
		match v {
			case any[]:
				let out string[] = []
				for let e in v {
					match e {
						case string:
							out.push(e)
						default:
							fail openidError(oauth2.OAuthErrorKind.Malformed, "\"{name}\" must hold strings")
					}
				}
				return out
			default:
				fail openidError(oauth2.OAuthErrorKind.Malformed, "\"{name}\" must be an array")
		}
	}

	def objectOf(m map<string, any>, name string) !map<string, any> {
		let v = try member(m, name)
		match v {
			case map<string, any>:
				return v
			default:
				fail openidError(oauth2.OAuthErrorKind.Malformed, "\"{name}\" must be an object")
		}
	}

	def timeOf(m map<string, any>, name string) !time.Time {
		let v = try member(m, name)
		match v {
			case int:
				return time.fromUnixNs(int64(v) * 1000000000)
			case float:
				return time.fromUnixNs(int64(v * 1000000000.0))
			default:
				fail openidError(oauth2.OAuthErrorKind.Malformed, "\"{name}\" must be a number of seconds")
		}
	}

	// textMember reads an OpenID member of OAuth metadata; none when absent
	// or not a string.
	def textMember(m oauth2.ServerMetadata, name string) ?string {
		let v = m.get(name)
		match v {
			case string:
				return v
			default:
				return none
		}
	}

	def boolMember(m oauth2.ServerMetadata, name string, fallback bool) bool {
		let v = m.get(name)
		match v {
			case bool:
				return v
			default:
				return fallback
		}
	}

	def listMember(m oauth2.ServerMetadata, name string) string[] {
		let v = m.get(name)
		let out string[] = []
		match v {
			case any[]:
				for let e in v {
					match e {
						case string:
							out.push(e)
						default:
					}
				}
			default:
		}
		return out
	}

	def encodeJSON(m map<string, any>) string {
		return string(new JSON().encode(m))
	}
}
