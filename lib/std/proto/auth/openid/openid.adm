// OpenID Connect: a relying party and a provider on top of
// std.proto.auth.oauth2. Core 1.0 (ID tokens, UserInfo, the code, implicit
// and hybrid flows, the claims parameter, pairwise subjects), Discovery,
// Dynamic Registration, RP-Initiated, Front-Channel and Back-Channel Logout,
// and Session Management.
//
// ```
// let rp = try openid.connect("https://op.example", "my-app", secret)
// let req = try rp.authorize("https://app.example/cb", ["profile"])
// // send the browser to req.url; on return:
// let login = try rp.exchange(req, callbackURL)
// println(login.claims.subject)
// ```
partial module std.proto.auth.openid {
	use (
		std.time
		std.net.http
		std.crypto.hash::(Hash, digest, shake256)
		std.proto.auth.jose
		std.proto.auth.oauth2
		std.proto.auth.openid.engine::*
	)

	// The event a back-channel logout token carries (Back-Channel Logout
	// §2.4).
	const backChannelLogoutEvent = "http://schemas.openid.net/event/backchannel-logout"

	// ProviderMetadata is an OpenID provider's metadata (Discovery §3): the
	// OAuth metadata and the OpenID members.
	type ProviderMetadata {
		oauth                               oauth2.ServerMetadata
		userinfoEndpoint                    ?string
		endSessionEndpoint                  ?string
		checkSessionIframe                  ?string
		frontchannelLogoutSupported         bool                  = false
		frontchannelLogoutSessionSupported  bool                  = false
		backchannelLogoutSupported          bool                  = false
		backchannelLogoutSessionSupported   bool                  = false
		subjectTypesSupported               string[]              = []
		idTokenSigningAlgValuesSupported    string[]              = []
		idTokenEncryptionAlgValuesSupported string[]              = []
		userinfoSigningAlgValuesSupported   string[]              = []
		acrValuesSupported                  string[]              = []
		claimsSupported                     string[]              = []
		claimsParameterSupported            bool                  = false
		requestParameterSupported           bool                  = false
		requestUriParameterSupported        bool                  = true

		def new(oauth oauth2.ServerMetadata) {
			self.oauth = oauth
			userinfoEndpoint = textMember(oauth, "userinfo_endpoint")
			endSessionEndpoint = textMember(oauth, "end_session_endpoint")
			checkSessionIframe = textMember(oauth, "check_session_iframe")
			frontchannelLogoutSupported = boolMember(oauth, "frontchannel_logout_supported", false)
			frontchannelLogoutSessionSupported = boolMember(oauth, "frontchannel_logout_session_supported", false)
			backchannelLogoutSupported = boolMember(oauth, "backchannel_logout_supported", false)
			backchannelLogoutSessionSupported = boolMember(oauth, "backchannel_logout_session_supported", false)
			subjectTypesSupported = listMember(oauth, "subject_types_supported")
			idTokenSigningAlgValuesSupported = listMember(oauth, "id_token_signing_alg_values_supported")
			idTokenEncryptionAlgValuesSupported = listMember(oauth, "id_token_encryption_alg_values_supported")
			userinfoSigningAlgValuesSupported = listMember(oauth, "userinfo_signing_alg_values_supported")
			acrValuesSupported = listMember(oauth, "acr_values_supported")
			claimsSupported = listMember(oauth, "claims_supported")
			claimsParameterSupported = boolMember(oauth, "claims_parameter_supported", false)
			requestParameterSupported = boolMember(oauth, "request_parameter_supported", false)
			requestUriParameterSupported = boolMember(oauth, "request_uri_parameter_supported", true)
		}
	}

	// discover fetches a provider's metadata from
	// `/.well-known/openid-configuration` (Discovery §4). Fails with
	// oauth2's Transport, Malformed or IssuerMismatch errors.
	def discover(issuer string, client ?http.Client = none) !ProviderMetadata {
		return new ProviderMetadata(try oauth2.discover(issuer, client))
	}

	// IdClaims are the claims of an ID token or UserInfo response (Core §2,
	// §5.1): the ID token claims and the standard claims as fields, the rest
	// through get.
	type IdClaims {
		issuer              ?string
		subject             string            = ""
		audience            string[]          = []
		expires             ?time.Time
		issuedAt            ?time.Time
		authTime            ?time.Time
		nonce               ?string
		acr                 ?string
		amr                 string[]          = []
		// The authorized party (Core §2).
		azp                 ?string
		// The session id (Front-Channel Logout §3).
		sid                 ?string
		name                ?string
		givenName           ?string
		familyName          ?string
		middleName          ?string
		nickname            ?string
		preferredUsername   ?string
		profile             ?string
		picture             ?string
		website             ?string
		email               ?string
		emailVerified       ?bool
		gender              ?string
		birthdate           ?string
		zoneinfo            ?string
		locale              ?string
		phoneNumber         ?string
		phoneNumberVerified ?bool
		address             ?map<string, any>
		updatedAt           ?time.Time
		internal extra      map<string, any>

		def new() {}

		// get returns a claim as JSON gives it, including the ones with
		// fields; none when absent.
		def get(name string) ?any {
			return extra.get(name)
		}
	}

	// Login is what a completed sign-in yields: the tokens, the ID token as
	// it was received, and its validated claims.
	type Login {
		token   oauth2.Token
		idToken string
		claims  IdClaims

		def new(token oauth2.Token, idToken string, claims IdClaims) {
			self.token = token
			self.idToken = idToken
			self.claims = claims
		}
	}

	// LogoutEvent is a validated front- or back-channel logout request: the
	// subject and session to end (one of them may be none).
	struct LogoutEvent {
		subject   ?string
		sessionId ?string
	}

	// claimsFromJson reads ID token or UserInfo claims. Fails with Malformed
	// when a claim has the wrong type or `sub` is missing.
	internal def claimsFromJson(text string) !IdClaims {
		let m = try parseObject(text, "claims")
		let c = new IdClaims()
		c.subject = try textOf(m, "sub")
		for let (name, value) in m {
			c.extra.set(name, value)
			match name {
				case "iss":
					c.issuer = try textOf(m, name)
				case "aud":
					match value {
						case string:
							c.audience = [value]
						default:
							c.audience = try stringsOf(m, name)
					}
				case "exp":
					c.expires = try timeOf(m, name)
				case "iat":
					c.issuedAt = try timeOf(m, name)
				case "auth_time":
					c.authTime = try timeOf(m, name)
				case "updated_at":
					c.updatedAt = try timeOf(m, name)
				case "nonce":
					c.nonce = try textOf(m, name)
				case "acr":
					c.acr = try textOf(m, name)
				case "amr":
					c.amr = try stringsOf(m, name)
				case "azp":
					c.azp = try textOf(m, name)
				case "sid":
					c.sid = try textOf(m, name)
				case "address":
					c.address = try objectOf(m, name)
				case "name":
					c.name = try textOf(m, name)
				case "given_name":
					c.givenName = try textOf(m, name)
				case "family_name":
					c.familyName = try textOf(m, name)
				case "middle_name":
					c.middleName = try textOf(m, name)
				case "nickname":
					c.nickname = try textOf(m, name)
				case "preferred_username":
					c.preferredUsername = try textOf(m, name)
				case "profile":
					c.profile = try textOf(m, name)
				case "picture":
					c.picture = try textOf(m, name)
				case "website":
					c.website = try textOf(m, name)
				case "email":
					c.email = try textOf(m, name)
				case "email_verified":
					c.emailVerified = try boolOf(m, name)
				case "gender":
					c.gender = try textOf(m, name)
				case "birthdate":
					c.birthdate = try textOf(m, name)
				case "zoneinfo":
					c.zoneinfo = try textOf(m, name)
				case "locale":
					c.locale = try textOf(m, name)
				case "phone_number":
					c.phoneNumber = try textOf(m, name)
				case "phone_number_verified":
					c.phoneNumberVerified = try boolOf(m, name)
				default:
			}
		}
		return c
	}

	// tokenHash is the `at_hash` / `c_hash` of a value (Core §3.1.3.6,
	// §3.3.2.11): the left half of its digest under the ID token's
	// algorithm, base64url. Ed25519 uses SHA-512, Ed448 SHAKE256 with 114
	// bytes.
	def tokenHash(value string, alg string, curve ?jose.Curve = none) string {
		let data = value.bytes()
		let full = digest(Hash.SHA256, data)
		if alg.endsWith("384") {
			full = digest(Hash.SHA384, data)
		} else if alg.endsWith("512") {
			full = digest(Hash.SHA512, data)
		} else if alg == "Ed448" || (alg == "EdDSA" && !(curve is none) && curve == jose.Curve.Ed448) {
			full = shake256(data, 114)
		} else if alg == "Ed25519" || alg == "EdDSA" {
			full = digest(Hash.SHA512, data)
		}
		return b64url(full[0:full.len() / 2])
	}
}
