partial module std.proto.auth.openid {
	use (
		std.testing
		std.time
		std.net.http
		std.net.http::(Context, ServeMux, Request, Method, newRequest)
		std.net.http.httptest
		std.proto.auth.jose
		std.proto.auth.oauth2
	)

	internal type StopRedirects {
		def new() {}

		def follow(next Request, via Request[]) !bool {
			return false
		}
	}

	// A provider on a loopback server whose login page signs in "alice"
	// with session "s-1", and a relying party back-channel endpoint that
	// records logout events.
	internal type TestProvider {
		site    httptest.Server
		op      Provider
		api     http.Client
		rp      ?RelyingParty
		logouts LogoutEvent[]   = []

		def new(site httptest.Server, op Provider) {
			self.site = site
			self.op = op
			api = site.client()
			api.redirects = new StopRedirects()
		}

		def login(authorizationURL string) !string {
			let first = try api.get(authorizationURL)
			assert first.status == 303
			let second = try api.get(first.header("Location"))
			assert second.status == 303
			return second.header("Location")
		}
	}

	internal def startProvider(allowImplicit bool = false) !TestProvider {
		let signing = try jose.generateKey(jose.SignatureAlgorithm.RS256)
		signing.kid = "op-1"
		let server = new oauth2.AuthorizationServer("http://placeholder", new jose.JwkSet([signing]))
		let users = new MemoryUserStore()
		users.add("alice", map<string, any>{"name": "Alice Liddell", "email": "alice@example.com", "email_verified": true, "locale": "en"})
		let op = new Provider(server, users)
		op.allowImplicit = allowImplicit
		let holder ?TestProvider = none
		let mux = new ServeMux()
		try mux.handle("/login", def (ctx Context) !none {
			let id = ctx.query("request", "")
			let pending = try server.pending(id)
			let prompt = pending.param("prompt")
			return try server.deny(ctx, id, oauth2.OAuthErrorKind.LoginRequired) when !(prompt is none) && prompt == "none"
			let claims map<string, any>
			claims.set("sid", "s-1")
			return try server.complete(ctx, id, oauth2.Decision{subject: "alice", claims: claims})
		})
		try mux.handle("/rp/backchannel", def (ctx Context) !none {
			let t = holder
			fail "no harness" when t is none
			let rp = t.rp
			fail "no rp" when rp is none
			let event = try rp.backChannelLogout(ctx)
			t.logouts.push(event)
			return try ctx.text("ok")
		})
		try mux.handle("/", op.handler())
		let site = new httptest.Server(mux)
		try site.start()
		server.issuer = site.url
		server.loginURL = site.url + "/login"
		let t = new TestProvider(site, op)
		holder = t
		return t
	}

	internal def rpClient(t TestProvider, secret string, implicit bool = false) !oauth2.RegisteredClient {
		let m = new oauth2.ClientMetadata()
		m.redirectUris = [t.site.url + "/cb"]
		m.tokenEndpointAuthMethod = "client_secret_basic"
		m.grantTypes = implicit ?? (["authorization_code", "refresh_token", "implicit"], ["authorization_code", "refresh_token"])
		m.set("backchannel_logout_uri", t.site.url + "/rp/backchannel")
		m.set("post_logout_redirect_uris", ["https://app.example/bye"])
		let c = new oauth2.RegisteredClient("rp", m)
		c.secret = secret
		try t.op.server.clients.save(c)
		return c
	}

	check "OpenID Connect" {
		@test()
		def TestTokenHashes() !none {
			// Core Appendix A.4 and A.6 (RS256).
			assert tokenHash("Qcb0Orv1zh30vL1MPRsbm-diHiMwcLyZvn1arpZv-Jxf_11jnpEX3Tgfvk", "RS256") == "LDktKdoQak3Pk0cnXxCltA"
			assert tokenHash("jHkWEdUXMU1BwAsC4vtUsZwnNvTIxEl0z9K3vx5KF0Y", "RS256") == "77QmUPtjPfzWtF2AnpK9RQ"
			assert tokenHash("x", "ES384").len() == 32 && tokenHash("x", "EdDSA").len() == 43
			assert tokenHash("x", "Ed448").len() == 76
		}

		@test()
		def TestCodeFlow() !none {
			let t = try startProvider()
			try rpClient(t, "rp-secret")
			let rp = try connect(t.site.url, "rp", "rp-secret", t.site.client())
			t.rp = rp
			assert !(rp.provider.userinfoEndpoint is none) && rp.provider.backchannelLogoutSupported
			let options = oauth2.AuthorizationOptions{}
			options.extra.set("max_age", "600")
			let req = try rp.authorize(t.site.url + "/cb", ["profile", "email"], options)
			assert req.url.contains("nonce=") && req.url.contains("scope=openid")
			let login = try rp.exchange(req, try t.login(req.url))
			assert login.claims.subject == "alice" && !(login.claims.authTime is none)
			let sid = login.claims.sid
			assert !(sid is none) && sid == "s-1"
			let info = try rp.userInfo(login)
			let name = info.name
			assert !(name is none) && name == "Alice Liddell"
			let verified = info.emailVerified
			assert !(verified is none) && verified
			// locale belongs to the profile scope (Core §5.4).
			let locale = info.locale
			assert !(locale is none) && locale == "en"
			// Refresh keeps the subject.
			let again = try rp.refresh(login)
			assert again.claims.subject == "alice"
			// A tampered ID token, another nonce, another audience all fail.
			let parts = login.idToken.split(".")
			let forged = parts[0] + "." + parts[1] + "." + parts[2][0:parts[2].len() - 2] + "AA"
			assert rp.validateIdToken(forged, none) is error
			assert rp.validateIdToken(login.idToken, "other-nonce") is error
			let otherRp = new RelyingParty("someone-else", rp.provider)
			otherRp.keys = rp.keys
			assert otherRp.validateIdToken(login.idToken, none) is error
			// prompt=none without a session comes back as login_required.
			let silent = oauth2.AuthorizationOptions{prompt: "none"}
			let quiet = try rp.authorize(t.site.url + "/cb", [], silent)
			let refusal = rp.exchange(quiet, try t.login(quiet.url))
			assert refusal is error
			// RP-initiated logout ends the session and notifies the RP's back channel.
			let bye = try rp.logoutURL(login.idToken, "https://app.example/bye", "st")
			let res = try t.api.get(bye)
			assert res.status == 303 && res.header("Location") == "https://app.example/bye?state=st"
			assert t.logouts.len() == 1
			let ended = t.logouts[0].sessionId
			assert !(ended is none) && ended == "s-1"
			try t.site.close()
		}

		@test()
		def TestHybridImplicitAndPairwise() !none {
			let t = try startProvider(true)
			try rpClient(t, "rp-secret", true)
			let rp = try connect(t.site.url, "rp", "rp-secret", t.site.client())
			rp.allowImplicit = true
			// Hybrid: the front-channel ID token carries c_hash, then the code is redeemed.
			let hybrid = try rp.authorize(t.site.url + "/cb", [], oauth2.AuthorizationOptions{responseType: "code id_token"})
			let callback = try t.login(hybrid.url)
			assert callback.contains("#") && callback.contains("id_token=")
			let login = try rp.exchange(hybrid, callback)
			assert login.claims.subject == "alice"
			// Implicit with a token: at_hash is required and checked.
			let implicit = try rp.authorize(t.site.url + "/cb", ["profile"], oauth2.AuthorizationOptions{responseType: "id_token token"})
			let fragment = try rp.exchange(implicit, try t.login(implicit.url))
			assert fragment.token.accessToken.reveal() != ""
			let name = (try rp.userInfo(fragment)).name
			assert !(name is none) && name == "Alice Liddell"
			// The claims parameter puts a claim into the ID token.
			let options = oauth2.AuthorizationOptions{}
			options.extra.set("claims", "\{\"id_token\":\{\"email\":null\}\}")
			let asked = try rp.authorize(t.site.url + "/cb", [], options)
			let withEmail = try rp.exchange(asked, try t.login(asked.url))
			let email = withEmail.claims.email
			assert !(email is none) && email == "alice@example.com"
			// Pairwise subjects differ from the user's own.
			t.op.subjectType = SubjectType.Pairwise
			let pw = try rp.authorize(t.site.url + "/cb", [])
			let pairwise = try rp.exchange(pw, try t.login(pw.url))
			assert pairwise.claims.subject != "alice" && pairwise.claims.subject.len() == 43
			// Implicit stays off unless the RP turns it on.
			let strict = try connect(t.site.url, "rp", "rp-secret", t.site.client())
			assert strict.authorize(t.site.url + "/cb", [], oauth2.AuthorizationOptions{responseType: "id_token"}) is error
			try t.site.close()
		}

		@test()
		def TestSessionsAndFrontChannel() !none {
			let t = try startProvider()
			let client = try rpClient(t, "rp-secret")
			let rp = try connect(t.site.url, "rp", "rp-secret", t.site.client())
			t.rp = rp
			// session_state has the form hash.salt (Session Management §3.2).
			let state = t.op.sessionState("rp", "https://app.example/cb", "s-9")
			let parts = state.split(".")
			assert parts.len() == 2 && parts[0].len() == 64
			// A token issued directly carries the grant's scopes and works at UserInfo.
			let g = new oauth2.Grant(time.now() + 1m)
			g.clientId = "rp"
			g.subject = "alice"
			g.scopes = ["openid", "email"]
			let issued = try t.op.server.issue(g, client)
			let token = new oauth2.Token("{issued.get("access_token")}")
			let login = new Login(token, "", new IdClaims())
			login.claims.subject = "alice"
			let email = (try rp.userInfo(login)).email
			assert !(email is none) && email == "alice@example.com"
			// Ending an unknown session is quiet; a front-channel request names its session.
			assert (try t.op.endSession("nothing")).len() == 0
			let req = try newRequest(Method.GET, t.site.url + "/rp/front?iss=" + t.site.url + "&sid=s-7")
			let ctx = new Context(req, new http.ResponseWriter(req))
			let event = try rp.frontChannelLogout(ctx)
			let sid = event.sessionId
			assert !(sid is none) && sid == "s-7"
			let foreign = try newRequest(Method.GET, t.site.url + "/rp/front?iss=https://evil.example&sid=s-7")
			assert rp.frontChannelLogout(new Context(foreign, new http.ResponseWriter(foreign))) is error
			try t.site.close()
		}
	}
}

