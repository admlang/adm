// One-time passwords: HOTP (RFC 4226), counted codes, and TOTP (RFC 6238),
// codes that change every period, plus the `otpauth://` key URIs
// authenticator apps scan from a QR code.
//
//     let secret = try otp.generateSecret()
//     let totp = new otp.TOTP(secret)
//     let uri = new otp.KeyURI(totp, "Example", "alice@example.com").str()
//
//     let step = try totp.verify(code)
//     // none: wrong code; otherwise refuse a step at or below the last one used
partial module std.proto.auth.otp {
	use (
		std.crypto
		std.crypto.hash::(Hash, hmac)
		std.data.encoding::(Base32)
		std.net.url
		std.time
		std.time::(Time)
		std.proto.auth.otp.codes::*
	)

	// Which kind of one-time password a key URI describes.
	enum OTPKind {
		// Counter-based (RFC 4226).
		HOTP,
		// Time-based (RFC 6238).
		TOTP
	}

	// HOTP makes and checks counter-based one-time passwords (RFC 4226):
	// the HMAC of an 8-byte big-endian counter under the shared secret,
	// truncated to `digits` decimal digits. Both sides advance the counter
	// after each use.
	//
	//     let h = new HOTP(secret)
	//     let code = try h.generate(7)
	type HOTP {
		// The shared secret key.
		secret byte[]

		// Code length, 6 to 10.
		digits int = 6

		// The HMAC hash: SHA1 (the default and what RFC 4226 defines),
		// SHA256 or SHA512.
		algorithm Hash = Hash.SHA1

		def new(secret byte[], digits int = 6, algorithm Hash = Hash.SHA1) {
			self.secret = secret
			self.digits = digits
			self.algorithm = algorithm
		}

		// The code for a counter value. Fails when digits is outside 6 to 10,
		// the secret is empty or the algorithm is not SHA1, SHA256 or SHA512.
		def generate(counter uint64) !string {
			return try otpCode(secret, counter, digits, algorithm)
		}

		// Checks a code against the counters from counter to counter + window
		// (the look-ahead of RFC 4226 §7.4, for a token pressed without
		// logging in) and returns the counter that matched, none when none
		// did. The next expected counter is the match + 1. Codes are compared
		// in constant time. Fails as generate does.
		def verify(code string, counter uint64, window int = 0) !?uint64 {
			for let i = 0; i <= window; i++ {
				let c = counter + uint64(i)
				return c when crypto.constantTimeEqual((try otpCode(secret, c, digits, algorithm)).bytes(), code.bytes())
			}
			return none
		}
	}

	// TOTP makes and checks time-based one-time passwords (RFC 6238): HOTP
	// over the number of whole periods since `start`.
	//
	//     let t = new TOTP(secret)
	//     let code = try t.generate()
	//     let step = try t.verify(code)
	type TOTP {
		// The shared secret key.
		secret byte[]

		// Code length, 6 to 10.
		digits int = 6

		// The HMAC hash: SHA1, SHA256 or SHA512.
		algorithm Hash = Hash.SHA1

		// How long one code lasts (X in RFC 6238).
		period duration = 30s

		// The instant step 0 begins (T0 in RFC 6238), the Unix epoch by default.
		start Time = time.fromUnixNs(0)

		def new(secret byte[], digits int = 6, algorithm Hash = Hash.SHA1, period duration = 30s) {
			self.secret = secret
			self.digits = digits
			self.algorithm = algorithm
			self.period = period
		}

		// The time step an instant falls in: whole periods since start. Fails
		// when the instant is before start or the period is not positive.
		def step(at Time) !uint64 {
			fail "otp: period must be positive" when period <= 0s
			let elapsed = at.unixNs() - start.unixNs()
			fail "otp: {at} is before the start of step 0" when elapsed < 0
			return uint64(elapsed / int64(period.nanoseconds()))
		}

		// The time step of now. Fails when the period is not positive or now is
		// before start.
		def step() !uint64 {
			return try step(time.now())
		}

		// The code at an instant. Fails as step and HOTP.generate do.
		def generate(at Time) !string {
			return try otpCode(secret, try step(at), digits, algorithm)
		}

		// The code for now. Fails as generate(Time) does.
		def generate() !string {
			return try generate(time.now())
		}

		// Checks a code against the steps from `skew` periods before the
		// instant to `skew` after (RFC 6238 §5.2 recommends 1, allowing for
		// clock drift and typing time) and returns the step that matched,
		// none when none did. A server records the step and refuses codes
		// at or below it, so a code works once. Codes are compared in
		// constant time. Fails as step and HOTP.generate do.
		def verify(code string, at Time, skew int = 1) !?uint64 {
			let now = try step(at)
			for let d = -skew; d <= skew; d++ {
				continue when d < 0 && uint64(-d) > now
				let s = d < 0 ?? (now - uint64(-d), now + uint64(d))
				return s when crypto.constantTimeEqual((try otpCode(secret, s, digits, algorithm)).bytes(), code.bytes())
			}
			return none
		}

		// Checks a code against now; see verify(string, Time, int). Fails as
		// that does.
		def verify(code string, skew int = 1) !?uint64 {
			return try verify(code, time.now(), skew)
		}

		// How long the code at the instant stays current. Fails as step does.
		def remaining(at Time) !duration {
			let s = try step(at)
			let ends = start.unixNs() + int64(s + uint64(1)) * int64(period.nanoseconds())
			return duration(ends - at.unixNs())
		}
	}

	// KeyURI is an `otpauth://` key URI, the format authenticator apps read
	// from a QR code (Google Authenticator's Key Uri Format):
	//
	//     otpauth://totp/Example:alice@example.com?secret=JBSWY3DPEHPK3PXP&issuer=Example
	//
	// The label is the issuer and the account name joined by a colon;
	// `secret` is the key in unpadded Base32. `algorithm`, `digits` and
	// `period` are written only when they differ from SHA1, 6 and 30
	// seconds, `counter` only for HOTP.
	type KeyURI {
		kind OTPKind = OTPKind.TOTP

		// Who the account is with, shown above the code.
		issuer string

		// The account, usually a user name or e-mail address.
		account string

		secret    byte[]
		algorithm Hash   = Hash.SHA1
		digits    int    = 6

		// TOTP only.
		period duration = 30s

		// HOTP only: the counter of the next code.
		counter uint64

		// A picture to show beside the account (the `image` parameter
		// FreeOTP reads), "" for none.
		image string

		def new() {}

		// The key URI of a TOTP generator.
		def new(t TOTP, issuer string, account string) {
			kind = OTPKind.TOTP
			self.issuer = issuer
			self.account = account
			secret = t.secret
			algorithm = t.algorithm
			digits = t.digits
			period = t.period
		}

		// The key URI of an HOTP generator at a counter.
		def new(h HOTP, issuer string, account string, counter uint64) {
			kind = OTPKind.HOTP
			self.issuer = issuer
			self.account = account
			self.counter = counter
			secret = h.secret
			algorithm = h.algorithm
			digits = h.digits
		}

		// The generator the URI describes; for a HOTP URI, start the counter
		// at `counter`.
		def hotp() HOTP {
			return new HOTP(secret, digits, algorithm)
		}

		// The generator the URI describes.
		def totp() TOTP {
			return new TOTP(secret, digits, algorithm, period)
		}

		// The URI text.
		def str() string {
			let b32 = new Base32()
			b32.padded = false
			let label = url.pathEscape(account)
			label = url.pathEscape(issuer) + ":" + label when issuer != ""
			let q = "secret=" + b32.encode(secret)
			q += "&issuer=" + url.queryEscape(issuer) when issuer != ""
			q += "&algorithm=" + otpAlgorithmName(algorithm) when algorithm != Hash.SHA1
			q += "&digits={digits}" when digits != 6
			q += "&counter={counter}" when kind == OTPKind.HOTP
			q += "&period={period.seconds()}" when kind == OTPKind.TOTP && period != 30s
			q += "&image=" + url.queryEscape(image) when image != ""
			let kindName = kind == OTPKind.HOTP ?? ("hotp", "totp")
			return "otpauth://{kindName}/{label}?{q}"
		}
	}

	// Reads an `otpauth://` key URI. The issuer comes from the `issuer`
	// parameter, else the label's prefix. Fails when the text is not an
	// otpauth URI, the kind is not hotp or totp, the secret is missing or not
	// Base32, a HOTP URI has no counter, the algorithm is not SHA1, SHA256 or
	// SHA512, digits is outside 6 to 10, the period is not a positive number
	// of seconds, or the label's issuer and the parameter disagree.
	def parseKeyURI(text string) !KeyURI {
		let u = try url.parse(text)
		fail "otp: not an otpauth URI" when u.scheme.lower() != "otpauth"
		let k = new KeyURI()
		match u.host.lower() {
			case "hotp":
				k.kind = OTPKind.HOTP
			case "totp":
				k.kind = OTPKind.TOTP
			default:
				fail "otp: unknown kind \"{u.host}\""
		}

		let label = u.path.trimPrefix("/")
		let colon = label.indexOf(":")
		let labelIssuer = ""
		if colon >= 0 {
			labelIssuer = label[:colon].trim()
			label = label[colon + 1:]
		}
		k.account = label.trim()

		let q = u.query()
		let secret = q.get("secret")
		fail "otp: the URI has no secret" when secret is none
		k.secret = try parseSecret(secret)

		let issuer = q.get("issuer")
		if issuer is none {
			k.issuer = labelIssuer
		} else {
			fail "otp: label issuer \"{labelIssuer}\" differs from issuer parameter \"{issuer}\"" when labelIssuer != "" && labelIssuer != issuer
			k.issuer = issuer
		}

		let algorithm = q.get("algorithm")
		k.algorithm = try otpAlgorithm(algorithm) unless algorithm is none

		let digits = q.get("digits")
		if !(digits is none) {
			let n = digits.toInt<int>()
			fail "otp: digits \"{digits}\" is not 6 to 10" when n is none
			k.digits = n
			fail "otp: digits \"{digits}\" is not 6 to 10" when k.digits < 6 || k.digits > 10
		}

		let counter = q.get("counter")
		if k.kind == OTPKind.HOTP {
			fail "otp: a hotp URI needs a counter" when counter is none
			let n = counter.toInt<uint64>()
			fail "otp: counter \"{counter}\" is not a number" when n is none
			k.counter = n
		}

		let period = q.get("period")
		if !(period is none) {
			let n = period.toInt<int>()
			fail "otp: period \"{period}\" is not a positive number of seconds" when n is none
			let seconds = n
			fail "otp: period \"{period}\" is not a positive number of seconds" when seconds <= 0
			k.period = duration(int64(seconds) * 1000000000)
		}

		let image = q.get("image")
		k.image = image unless image is none
		return k
	}

	// A fresh random secret, 20 bytes by default (160 bits, the size RFC
	// 4226 recommends; use 32 for SHA256 and 64 for SHA512). Fails when the
	// system random source is unavailable or size is below 16.
	def generateSecret(size int = 20) !byte[] {
		expects {
			assert size >= 16 onerror fail "otp: a secret needs at least 16 bytes"
		}
		return try crypto.rand(size)
	}

	// Reads a secret written in Base32, the way apps and sites show it:
	// either case, with or without padding, spaces and hyphens ignored.
	// Fails when the text is not Base32 or decodes to nothing.
	def parseSecret(text string) !byte[] {
		let clean = text.replace(" ", "").replace("-", "").upper()
		let b = try new Base32().decode(clean)
		fail "otp: the secret is empty" when b.len() == 0
		return b
	}
}

internal partial module std.proto.auth.otp.codes {
	use (
		std.crypto.hash::(Hash, hmac)
		std.proto.auth.otp::*
	)

	// The RFC 4226 §5.3 code: dynamic truncation of the HMAC of the
	// big-endian counter, reduced to digits decimal digits.
	def otpCode(secret byte[], counter uint64, digits int, algorithm Hash) !string {
		expects {
			assert digits >= 6 && digits <= 10 onerror fail "otp: digits must be 6 to 10, not {digits}"
			assert secret.len() != 0 onerror fail "otp: the secret is empty"
			assert algorithm := Hash.SHA1 || Hash.SHA256 || Hash.SHA512 onerror fail "otp: {algorithm} is not SHA1, SHA256 or SHA512"
		}
		let msg byte[]
		for let s = 56; s >= 0; s -= 8 {
			msg.push(byte((counter >> s) & uint64(0xFF)))
		}
		let mac = hmac(algorithm, secret, msg)
		let offset = int(mac[mac.len() - 1]) & 0x0F
		let bin = (int64(mac[offset]) & 0x7F) << 24 | int64(mac[offset + 1]) << 16 | int64(mac[offset + 2]) << 8 | int64(mac[offset + 3])
		let mod int64 = 1
		for let i = 0; i < digits; i++ {
			mod *= 10
		}
		let text = (bin % mod).str()
		return "0".repeat(digits - text.len()) + text
	}

	// The key URI name of a hash.
	def otpAlgorithmName(h Hash) string {
		match h {
			case Hash.SHA256:
				return "SHA256"
			case Hash.SHA512:
				return "SHA512"
			default:
				return "SHA1"
		}
	}

	// The hash a key URI names. Fails for anything but SHA1, SHA256 and
	// SHA512.
	def otpAlgorithm(name string) !Hash {
		match name.upper() {
			case "SHA1":
				return Hash.SHA1
			case "SHA256":
				return Hash.SHA256
			case "SHA512":
				return Hash.SHA512
			default:
				fail "otp: unknown algorithm \"{name}\""
		}
	}
}
