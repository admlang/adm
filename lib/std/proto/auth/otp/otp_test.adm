partial module std.proto.auth.otp {
	use (
		std.testing
		std.time
		std.time::(Time)
		std.crypto.hash::(Hash)
	)

	def otpAt(seconds int64) Time {
		return time.fromUnixNs(seconds * 1000000000)
	}

	check "OTP" {
		@test()
		def TestHOTPVectors() !none {
			let h = new HOTP("12345678901234567890".bytes())
			let want = ["755224", "287082", "359152", "969429", "338314", "254676", "287922", "162583", "399871", "520489"]
			for let (i, code) in want {
				assert (try h.generate(uint64(i))) == code
			}
			return none
		}

		@test()
		def TestHOTPVerifyWindow() !none {
			let h = new HOTP("12345678901234567890".bytes())
			let hit = try h.verify("969429", 1, 2)
			assert hit is none ?? (false, hit == uint64(3))
			let miss = try h.verify("969429", 1, 1)
			assert miss is none
			let bad = h.generate(0) onerror recover "fail"
			assert bad == "755224"
			h.digits = 5
			let short = h.generate(0) onerror recover "fail"
			assert short == "fail"
			return none
		}

		@test()
		def TestTOTPVectors() !none {
			let sha1 = new TOTP("12345678901234567890".bytes(), 8)
			let sha256 = new TOTP("12345678901234567890123456789012".bytes(), 8, Hash.SHA256)
			let sha512 = new TOTP("1234567890123456789012345678901234567890123456789012345678901234".bytes(), 8, Hash.SHA512)
			let times = int64[59, 1111111109, 1111111111, 1234567890, 2000000000]
			let want1 = ["94287082", "07081804", "14050471", "89005924", "69279037", "65353130"]
			let want256 = ["46119246", "68084774", "67062674", "91819424", "90698825", "77737706"]
			let want512 = ["90693936", "25091201", "99943326", "93441116", "38618901", "47863826"]
			for let (i, t) in times {
				assert (try sha1.generate(otpAt(t))) == want1[i]
				assert (try sha256.generate(otpAt(t))) == want256[i]
				assert (try sha512.generate(otpAt(t))) == want512[i]
			}
			assert (try sha1.step(otpAt(1111111109))) == uint64(0x23523EC)

			// T = 20000000000 lies past what Time holds; its step is 666666666.
			let far = uint64(666666666)
			assert (try new HOTP(sha1.secret, 8).generate(far)) == want1[5]
			assert (try new HOTP(sha256.secret, 8, Hash.SHA256).generate(far)) == want256[5]
			assert (try new HOTP(sha512.secret, 8, Hash.SHA512).generate(far)) == want512[5]
			return none
		}

		@test()
		def TestTOTPVerifySkew() !none {
			let t = new TOTP("12345678901234567890".bytes(), 8)
			let at = otpAt(1111111111 + 30)
			let hit = try t.verify("14050471", at)
			assert hit is none ?? (false, hit == uint64(0x23523ED))
			let strict = try t.verify("14050471", at, 0)
			assert strict is none
			assert (try t.remaining(otpAt(1111111111))) == 29s
			let early = t.generate(otpAt(59)) onerror recover "fail"
			assert early == "94287082"
			t.start = otpAt(100)
			let before = t.generate(otpAt(59)) onerror recover "fail"
			assert before == "fail"
			return none
		}

		@test()
		def TestKeyURIRoundTrip() !none {
			let secret = try parseSecret("JBSW Y3DP EHPK 3PXP")
			assert secret.equals(byte[0x48, 0x65, 0x6C, 0x6C, 0x6F, 0x21, 0xDE, 0xAD, 0xBE, 0xEF])
			let t = new TOTP(secret)
			let uri = new KeyURI(t, "Example", "alice@example.com")
			assert uri.str() == "otpauth://totp/Example:alice@example.com?secret=JBSWY3DPEHPK3PXP&issuer=Example"
			let back = try parseKeyURI(uri.str())
			assert back.kind == OTPKind.TOTP && back.issuer == "Example" && back.account == "alice@example.com"
			assert back.secret.equals(secret) && back.digits == 6 && back.period == 30s && back.algorithm == Hash.SHA1

			let h = new HOTP(secret, 8, Hash.SHA256)
			let hu = new KeyURI(h, "ACME Co", "john", 42)
			let hb = try parseKeyURI(hu.str())
			assert hb.kind == OTPKind.HOTP && hb.counter == uint64(42) && hb.digits == 8 && hb.algorithm == Hash.SHA256
			assert hb.issuer == "ACME Co" && hb.account == "john"
			assert (try hb.hotp().generate(42)) == (try h.generate(42))
			assert (try back.totp().generate(otpAt(59))) == (try t.generate(otpAt(59)))
			return none
		}

		@test()
		def TestKeyURIParsing() !none {
			let k = try parseKeyURI("otpauth://totp/ACME%20Co:john.doe@email.com?secret=HXDMVJECJJWSRB3HWIZR4IFUGFTMXBOZ&issuer=ACME%20Co&algorithm=SHA1&digits=6&period=60")
			assert k.issuer == "ACME Co" && k.account == "john.doe@email.com" && k.period == 60s
			let noIssuer = try parseKeyURI("otpauth://totp/bob?secret=JBSWY3DPEHPK3PXP")
			assert noIssuer.issuer == "" && noIssuer.account == "bob"
			let labelOnly = try parseKeyURI("otpauth://totp/Corp:bob?secret=jbswy3dpehpk3pxp")
			assert labelOnly.issuer == "Corp"
			assert otpRejects("https://example.com/?secret=JBSWY3DPEHPK3PXP")
			assert otpRejects("otpauth://totp/a?issuer=x")
			assert otpRejects("otpauth://hotp/a?secret=JBSWY3DPEHPK3PXP")
			assert otpRejects("otpauth://xotp/a?secret=JBSWY3DPEHPK3PXP")
			assert otpRejects("otpauth://totp/A:b?secret=JBSWY3DPEHPK3PXP&issuer=B")
			assert otpRejects("otpauth://totp/a?secret=JBSWY3DPEHPK3PXP&algorithm=MD5")
			assert otpRejects("otpauth://totp/a?secret=JBSWY3DPEHPK3PXP&digits=4")
			assert otpRejects("otpauth://totp/a?secret=JBSWY3DPEHPK3PXP&period=0")
			assert otpRejects("otpauth://totp/a?secret=1189")
			return none
		}

		@test()
		def TestGenerateSecret() !none {
			let s = try generateSecret()
			assert s.len() == 20
			let small = generateSecret(8) onerror recover byte[]
			assert small.len() == 0
			return none
		}
	}

	def otpRejects(text string) bool {
		let failed = false
		parseKeyURI(text) onerror (err error) {
			failed = true
			recover new KeyURI()
		}
		return failed
	}
}
