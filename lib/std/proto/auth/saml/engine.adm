internal partial module std.proto.auth.saml.engine {
	use (
		std.time
		std.time::(TimeFormat)
		std.bytes
		std.crypto::(PublicKey, PrivateKey, RSAPublicKey, RSAPrivateKey, ECDSAPublicKey, ECDSAPrivateKey, Ed25519PublicKey, Ed25519PrivateKey, Ed448PublicKey, Ed448PrivateKey, rand, coordinateSize, marshalECDSASignature, parseECDSASignature, parsePKIXPublicKey, marshalPKIXPublicKey)
		std.crypto.hash::(Hash, digest, hashSize)
		std.crypto.x509
		std.data.compress.flate
		std.data.encoding::(XML, XMLNode, XMLNodeKind, Base64, SignatureMethod, XMLKeys, parseXMLSignature, signXML, decryptXML, xmlDsigNamespace, xmlEncNamespace, hexencode)
		std.net.http
		std.net.http::(Context, Method, newRequest)
		std.net.url
		std.proto.auth.saml::*
	)

	const samlNS = "urn:oasis:names:tc:SAML:2.0:assertion"
	const samlpNS = "urn:oasis:names:tc:SAML:2.0:protocol"
	const mdNS = "urn:oasis:names:tc:SAML:2.0:metadata"
	const soapNS = "http://schemas.xmlsoap.org/soap/envelope/"
	const xsiNS = "http://www.w3.org/2001/XMLSchema-instance"
	const xsNS = "http://www.w3.org/2001/XMLSchema"
	const dsig11NS = "http://www.w3.org/2009/xmldsig11#"
	const bearerMethod = "urn:oasis:names:tc:SAML:2.0:cm:bearer"
	const soapAction = "http://www.oasis-open.org/committees/security"

	// The largest message accepted, inflated (a deflate bomb stops here)
	// or posted.
	const maxMessageSize = 1048576

	// RelayState may not exceed 80 bytes (saml-bindings §3.4.3, §3.5.3).
	const maxRelayState = 80

	def samlError(kind SamlErrorKind, text string) error {
		return SamlError{message: "saml: " + text, code: kind.str(), kind: kind}
	}

	def statusError(codes string[], message string) error {
		let text = codes.len() == 0 ?? ("no status", codes.join(" / "))
		text += ": " + message when message != ""
		return SamlError{message: "saml: the peer answered " + text, code: SamlErrorKind.StatusNotSuccess.str(), kind: SamlErrorKind.StatusNotSuccess, status: codes, statusMessage: message}
	}

	// newId is a fresh message or assertion ID: an NCName (saml-core
	// §1.3.4) with 160 random bits.
	def newId() !string {
		return "_" + hexencode(try rand(20))
	}

	// Time ---------------------------------------------------------------

	// instant writes an xs:dateTime in UTC to the second.
	def instant(t time.Time) string {
		let text = t.str(TimeFormat.RFC3339)
		let dot = text.indexOf(".")
		return dot < 0 ?? (text, text[:dot] + "Z")
	}

	def parseInstant(text string, what string) !time.Time {
		return time.parse(text.trim(), TimeFormat.RFC3339) onerror fail samlError(SamlErrorKind.Malformed, "{what} is not a dateTime")
	}

	def optionalInstant(e XMLNode, name string) !?time.Time {
		let v = e.attribute(name)
		return none when v is none
		return try parseInstant(v, name)
	}

	// parseXsDuration reads an xs:duration (`P1Y2M3DT4H5M6.5S`, a leading
	// `-` allowed); a year counts 365 days and a month 30. None when it does
	// not parse.
	def parseXsDuration(text string) ?duration {
		let s = text.trim()
		let negative = s.startsWith("-")
		s = s[1:] when negative
		return none unless s.startsWith("P") && s.len() > 1
		let total = 0s
		let inTime = false
		let number = ""
		let units = 0
		for let i = 1; i < s.len(); i++ {
			let c = s[i]
			if c == 'T' {
				return none when inTime || number != ""
				inTime = true
				continue
			}
			if (c >= '0' && c <= '9') || c == '.' {
				number += string(c)
				continue
			}
			return none unless /^[0-9]+(\.[0-9]+)?$/.test(number)
			let amount = parseFloat<float>(number)
			let fractional = number.contains(".")
			number = ""
			units++
			if inTime {
				match c {
					case 'H':
						total += 1h * amount
					case 'M':
						total += 1m * amount
					case 'S':
						total += 1s * amount
					default:
						return none
				}
			} else {
				return none when fractional
				match c {
					case 'Y':
						total += 24h * 365.0 * amount
					case 'M':
						total += 24h * 30.0 * amount
					case 'D':
						total += 24h * amount
					default:
						return none
				}
			}
		}
		return none when number != "" || units == 0
		return negative ?? (0s - total, total)
	}

	// xsDuration writes a duration as xs:duration seconds (`PT3600S`).
	def xsDuration(d duration) string {
		let seconds = d.seconds()
		return seconds == float(int(seconds)) ?? ("PT{int(seconds)}S", "PT{seconds}S")
	}

	// Documents ----------------------------------------------------------

	// parseDocument parses a received message or metadata: no DOCTYPE, so
	// no entity expansion either.
	def parseDocument(data byte[]) !XMLNode {
		fail samlError(SamlErrorKind.Malformed, "the message is larger than {maxMessageSize} bytes") when data.len() > maxMessageSize
		let codec = new XML()
		codec.allowDoctype = false
		return codec.parse(data) onerror (err error) {
			fail samlError(SamlErrorKind.Malformed, "the message is not well-formed XML: {err.message}")
		}
	}

	def element(parent XMLNode, name string, namespace string) XMLNode {
		return parent.add(new XMLNode(name, namespace))
	}

	def textElement(parent XMLNode, name string, namespace string, text string) XMLNode {
		let e = element(parent, name, namespace)
		e.add(text)
		return e
	}

	// attr returns an attribute's value, "" when absent.
	def attr(e XMLNode, name string) string {
		let v = e.attribute(name)
		return v is none ?? ("", v)
	}

	def requiredAttr(e XMLNode, name string) !string {
		let v = e.attribute(name)
		fail samlError(SamlErrorKind.Malformed, "{e.localName} has no {name}") when v is none || v == ""
		return v
	}

	// childText returns the trimmed text of the first child element, none
	// when there is none.
	def childText(e XMLNode, name string, namespace string) ?string {
		let c = e.child(name, namespace)
		return none when c is none
		return c.text().trim()
	}

	def isTrue(value string) bool {
		return value.trim() := "true" || "1"
	}

	def decodeB64(text string, what string) !byte[] {
		let compact = text.replace(" ", "").replace("\n", "").replace("\r", "").replace("\t", "")
		return new Base64().decode(compact) onerror fail samlError(SamlErrorKind.Malformed, "{what} is not base64")
	}

	// protocolRoot starts a samlp message with the attributes every
	// request and response has (saml-core §3.2.1, §3.2.2), and its Issuer.
	def protocolRoot(name string, id string, issuer string, destination string) XMLNode {
		let root = new XMLNode("samlp:" + name, samlpNS)
		root.set("xmlns:samlp", samlpNS)
		root.set("xmlns:saml", samlNS)
		root.set("ID", id)
		root.set("Version", "2.0")
		root.set("IssueInstant", instant(time.now()))
		root.set("Destination", destination) when destination != ""
		textElement(root, "saml:Issuer", samlNS, issuer)
		return root
	}

	def statusElement(parent XMLNode, codes string[], message string = "") XMLNode {
		let status = element(parent, "samlp:Status", samlpNS)
		let at = status
		for let code in codes {
			at = element(at, "samlp:StatusCode", samlpNS)
			at.set("Value", code)
		}
		textElement(status, "samlp:StatusMessage", samlpNS, message) when message != ""
		return status
	}

	// statusOf reads a response's Status: the codes, outermost first, and
	// the StatusMessage.
	def statusOf(message XMLNode) !(string[], string) {
		let status = message.child("Status", samlpNS)
		fail samlError(SamlErrorKind.Malformed, "{message.localName} has no Status") when status is none
		let codes string[] = []
		let at = status.child("StatusCode", samlpNS)
		for {
			let current = at
			break when current is none
			codes.push(try requiredAttr(current, "Value"))
			at = current.child("StatusCode", samlpNS)
		}
		fail samlError(SamlErrorKind.Malformed, "Status has no StatusCode") when codes.len() == 0
		let text = childText(status, "StatusMessage", samlpNS)
		return (codes, text is none ?? ("", text))
	}

	// checkProtocol checks what every received samlp message must have:
	// the element, Version 2.0, an ID and an IssueInstant not in the
	// future.
	def checkProtocol(message XMLNode, name string, leeway duration) !none {
		fail samlError(SamlErrorKind.Malformed, "expected samlp:{name}, got {message.name}") unless message.localName == name && message.namespace == samlpNS
		let version = attr(message, "Version")
		fail samlError(SamlErrorKind.Unsupported, "SAML version {version} is not 2.0") unless version == "2.0"
		try requiredAttr(message, "ID")
		let issued = try parseInstant(try requiredAttr(message, "IssueInstant"), "IssueInstant")
		fail samlError(SamlErrorKind.NotYetValid, "{name} was issued in the future") when issued.after(time.now() + leeway)
		return none
	}

	// issuerOf returns a message's or assertion's Issuer, "" when absent.
	// An Issuer with a Format other than entity is refused.
	def issuerOf(e XMLNode) !string {
		let issuer = e.child("Issuer", samlNS)
		return "" when issuer is none
		let format = attr(issuer, "Format")
		fail samlError(SamlErrorKind.Malformed, "the Issuer has format {format}, not entity") unless format == "" || format == NameIdFormat.Entity.value
		return issuer.text().trim()
	}

	// Signatures ---------------------------------------------------------

	// defaultMethod is the signature method a key usually signs with.
	def defaultMethod(key PrivateKey) SignatureMethod {
		match key {
			case ECDSAPrivateKey:
				let size = coordinateSize(key.curve)
				return SignatureMethod.EcdsaSha512 when size > 48
				return SignatureMethod.EcdsaSha384 when size > 32
				return SignatureMethod.EcdsaSha256
			case Ed25519PrivateKey:
				return SignatureMethod.Ed25519
			case Ed448PrivateKey:
				return SignatureMethod.Ed448
			default:
				return SignatureMethod.RsaSha256
		}
	}

	// signElement signs an element with an enveloped signature over its ID.
	// The signature goes after the child named `after`, or first when
	// `after` is empty (metadata), as the schemas place it.
	def signElement(e XMLNode, key PrivateKey, method ?SignatureMethod, certificate ?byte[], after string) !none {
		let chosen = method is none ?? (defaultMethod(key), method)
		let signature = signXML(e, key, chosen, certificate = certificate, after = after, document = e) onerror (err error) {
			fail samlError(SamlErrorKind.Unsupported, "cannot sign: {err.message}")
		}
		if after == "" {
			// Moving the enveloped signature leaves the digest alone.
			let reordered XMLNode[] = [signature]
			for let child in e.children {
				reordered.push(child) unless child == signature
			}
			e.children = reordered
		}
		return none
	}

	// verifyEnveloped checks the enveloped signature of a message or
	// assertion: none (false), or exactly one ds:Signature child with one
	// Reference that resolves, by the `ID` attribute, to the element
	// itself and verifies with one of the keys (true). A signature over any
	// other element, a second signature, or a failing one is refused: the
	// defence against signature wrapping.
	def verifyEnveloped(e XMLNode, document XMLNode, keys PublicKey[], allowSha1 bool) !bool {
		let signatures = e.elements("Signature", xmlDsigNamespace)
		return false when signatures.len() == 0
		fail samlError(SamlErrorKind.BadSignature, "{e.localName} carries {signatures.len()} signatures") when signatures.len() > 1
		let sig = parseXMLSignature(signatures[0]) onerror (err error) {
			fail samlError(SamlErrorKind.BadSignature, "the signature of {e.localName} does not parse: {err.message}")
		}
		fail samlError(SamlErrorKind.BadSignature, "the signature of {e.localName} must have one Reference") unless sig.references.len() == 1
		let id = attr(e, "ID")
		fail samlError(SamlErrorKind.BadSignature, "the signature of {e.localName} does not reference it") unless id != "" && sig.references[0].uri == "#" + id
		fail samlError(SamlErrorKind.BadSignature, "no key to verify {e.localName} with") when keys.len() == 0
		let covered = sig.verify(document, keys, allowSha1, ["ID"]) onerror (err error) {
			fail samlError(SamlErrorKind.BadSignature, "the signature of {e.localName} does not verify: {err.message}")
		}
		fail samlError(SamlErrorKind.BadSignature, "the signature of {e.localName} covers another element") unless covered.len() == 1 && covered[0] == e
		return true
	}

	def methodHash(method SignatureMethod) Hash {
		match method {
			case SignatureMethod.RsaSha1, SignatureMethod.EcdsaSha1:
				return Hash.SHA1
			case SignatureMethod.RsaSha384, SignatureMethod.RsaPssSha384, SignatureMethod.EcdsaSha384:
				return Hash.SHA384
			case SignatureMethod.RsaSha512, SignatureMethod.RsaPssSha512, SignatureMethod.EcdsaSha512:
				return Hash.SHA512
			default:
				return Hash.SHA256
		}
	}

	def isPss(method SignatureMethod) bool {
		return method := SignatureMethod.RsaPssSha256 || SignatureMethod.RsaPssSha384 || SignatureMethod.RsaPssSha512
	}

	// signatureMethodOf maps an algorithm URI to an asymmetric method; none
	// for an unknown or HMAC one (a shared secret cannot sign a query
	// string to a public peer).
	def signatureMethodOf(uri string) ?SignatureMethod {
		for let (i, v) in SignatureMethod.values() {
			continue unless v == uri
			let m = SignatureMethod(i)
			return none when m := SignatureMethod.HmacSha1 || SignatureMethod.HmacSha224 || SignatureMethod.HmacSha256 || SignatureMethod.HmacSha384 || SignatureMethod.HmacSha512
			return m
		}
		return none
	}

	// rawSign signs the octets of a Redirect query string (saml-bindings
	// §3.4.4.1). ECDSA values are DER, as the Redirect implementations
	// (OpenSAML, Keycloak, SimpleSAMLphp) write them.
	def rawSign(method SignatureMethod, key PrivateKey, data byte[]) !byte[] {
		let h = methodHash(method)
		match key {
			case RSAPrivateKey:
				return try key.signPSS(h, digest(h, data)) when isPss(method)
				return try key.signPKCS1v15(h, digest(h, data))
			case ECDSAPrivateKey:
				let (r, s) = try key.sign(digest(h, data))
				return marshalECDSASignature(r, s)
			case Ed25519PrivateKey:
				return key.sign(data)
			case Ed448PrivateKey:
				return try key.sign(data)
			default:
				fail samlError(SamlErrorKind.Unsupported, "the key cannot sign")
		}
	}

	// rawVerify checks a Redirect signature. ECDSA takes DER or the r || s
	// form of XML-DSig.
	def rawVerify(method SignatureMethod, key PublicKey, data byte[], value byte[]) bool {
		let h = methodHash(method)
		let isRsa = method := SignatureMethod.RsaSha1 || SignatureMethod.RsaSha256 || SignatureMethod.RsaSha384 || SignatureMethod.RsaSha512 || SignatureMethod.RsaPssSha256 || SignatureMethod.RsaPssSha384 || SignatureMethod.RsaPssSha512
		let isEc = method := SignatureMethod.EcdsaSha1 || SignatureMethod.EcdsaSha256 || SignatureMethod.EcdsaSha384 || SignatureMethod.EcdsaSha512
		match key {
			case RSAPublicKey:
				return false unless isRsa
				return key.verifyPSS(h, digest(h, data), value, hashSize(h)) when isPss(method)
				return key.verifyPKCS1v15(h, digest(h, data), value)
			case ECDSAPublicKey:
				return false unless isEc
				let size = coordinateSize(key.curve)
				return key.verify(digest(h, data), parseBigInt(value[0:size]), parseBigInt(value[size:2 * size])) when value.len() == 2 * size && value[0] != byte(0x30)
				// A value that is not DER gives zeros, which never verify.
				let (r, s) = parseECDSASignature(value) onerror recover (parseBigInt(byte[]), parseBigInt(byte[]))
				return key.verify(digest(h, data), r, s)
			case Ed25519PublicKey:
				return method == SignatureMethod.Ed25519 && key.verify(data, value)
			case Ed448PublicKey:
				return method == SignatureMethod.Ed448 && key.verify(data, value)
			default:
				return false
		}
	}

	// Bindings -----------------------------------------------------------

	// Inbound is a message received through a binding: its XML, and what
	// the binding carried with it.
	type Inbound {
		binding    Binding
		// SAMLRequest (true) or SAMLResponse (false).
		request    bool    = false
		xml        byte[]  = []
		relayState string  = ""
		// Redirect: the signature algorithm, value and signed octets.
		sigAlg     string  = ""
		signature  byte[]  = []
		signed     byte[]  = []
		// Artifact: the SAMLart value.
		artifact   string  = ""

		def new(binding Binding) {
			self.binding = binding
		}
	}

	// readInbound reads the message of a request: a Redirect query, a POST
	// form (HTTP-POST or HTTP-Artifact), a GET SAMLart, or a SOAP envelope.
	def readInbound(ctx Context) !Inbound {
		if ctx.method() == Method.POST {
			let body = ctx.bytes() onerror fail samlError(SamlErrorKind.Malformed, "cannot read the request body")
			fail samlError(SamlErrorKind.Malformed, "the request body is larger than {maxMessageSize} bytes") when body.len() > maxMessageSize
			let kind = ctx.header("Content-Type").lower()
			if kind.contains("xml") {
				let message = new Inbound(Binding.Soap)
				message.xml = body
				return message
			}
			let form = url.parseQuery(string(body)) onerror fail samlError(SamlErrorKind.Malformed, "the form does not parse")
			return try fromValues(form, Binding.Post)
		}
		return try fromQuery(ctx.url().rawQuery)
	}

	def fromValues(form url.Values, binding Binding) !Inbound {
		for let name in ["SAMLRequest", "SAMLResponse", "SAMLart", "RelayState"] {
			fail samlError(SamlErrorKind.Malformed, "{name} appears twice") when form.all(name).len() > 1
		}
		let relay = form.get("RelayState")
		let art = form.get("SAMLart")
		if !(art is none) {
			let message = new Inbound(Binding.Artifact)
			message.artifact = art
			message.relayState = relay is none ?? ("", relay)
			return message
		}
		let req = form.get("SAMLRequest")
		let res = form.get("SAMLResponse")
		fail samlError(SamlErrorKind.Malformed, "no SAMLRequest, SAMLResponse or SAMLart") when req is none && res is none
		fail samlError(SamlErrorKind.Malformed, "both SAMLRequest and SAMLResponse") unless req is none || res is none
		let message = new Inbound(binding)
		message.request = !(req is none)
		let encoded = form.get(message.request ?? ("SAMLRequest", "SAMLResponse"))
		fail samlError(SamlErrorKind.Malformed, "no message") when encoded is none
		message.xml = try decodeB64(encoded, "the message")
		message.relayState = relay is none ?? ("", relay)
		return message
	}

	// fromQuery reads a Redirect query: the deflated message, RelayState,
	// and the signature over the parameters exactly as they were sent
	// (saml-bindings §3.4.4.1).
	def fromQuery(raw string) !Inbound {
		let values map<string, string>
		for let pair in raw.split("&") {
			continue when pair == ""
			let eq = pair.indexOf("=")
			let name = eq < 0 ?? (pair, pair[:eq])
			fail samlError(SamlErrorKind.Malformed, "{name} appears twice") when values.hasKey(name) && (name := "SAMLRequest" || "SAMLResponse" || "SAMLart" || "RelayState" || "SigAlg" || "Signature")
			values.set(name, eq < 0 ?? ("", pair[eq + 1:]))
		}
		let rawOf = def (name string) string {
			let v = values.get(name)
			return v is none ?? ("", v)
		}
		let unescape = def (name string) !string {
			let v = values.get(name)
			return "" when v is none
			return url.queryUnescape(v) onerror fail samlError(SamlErrorKind.Malformed, "{name} is not URL-encoded")
		}
		let art = values.get("SAMLart")
		if !(art is none) {
			let message = new Inbound(Binding.Artifact)
			message.artifact = try unescape("SAMLart")
			message.relayState = try unescape("RelayState")
			return message
		}
		let isRequest = values.hasKey("SAMLRequest")
		fail samlError(SamlErrorKind.Malformed, "no SAMLRequest, SAMLResponse or SAMLart") unless isRequest || values.hasKey("SAMLResponse")
		fail samlError(SamlErrorKind.Malformed, "both SAMLRequest and SAMLResponse") when isRequest && values.hasKey("SAMLResponse")
		let param = isRequest ?? ("SAMLRequest", "SAMLResponse")
		let message = new Inbound(Binding.Redirect)
		message.request = isRequest
		message.xml = try inflate(try decodeB64(try unescape(param), param))
		message.relayState = try unescape("RelayState")
		if values.hasKey("SigAlg") {
			message.sigAlg = try unescape("SigAlg")
			message.signature = try decodeB64(try unescape("Signature"), "Signature")
			let octets = param + "=" + rawOf(param)
			octets += "&RelayState=" + rawOf("RelayState") when values.hasKey("RelayState")
			octets += "&SigAlg=" + rawOf("SigAlg")
			message.signed = octets.bytes()
		}
		return message
	}

	// verifyRedirect checks the query signature of a Redirect message:
	// false when there is none, true when one of the keys verifies it.
	// Fails with BadSignature or Unsupported.
	def verifyRedirect(message Inbound, keys PublicKey[], allowSha1 bool) !bool {
		return false unless message.binding == Binding.Redirect && message.sigAlg != ""
		let method = signatureMethodOf(message.sigAlg)
		fail samlError(SamlErrorKind.Unsupported, "unsupported SigAlg {message.sigAlg}") when method is none
		fail samlError(SamlErrorKind.Unsupported, "SHA-1 signatures are not allowed") when (method := SignatureMethod.RsaSha1 || SignatureMethod.EcdsaSha1) && !allowSha1
		for let key in keys {
			return true when rawVerify(method, key, message.signed, message.signature)
		}
		fail samlError(SamlErrorKind.BadSignature, "the query signature does not verify")
	}

	def deflate(data byte[]) !byte[] {
		let out = new bytes.Buffer()
		let w = new flate.Writer(out, 6)
		try w.write(data)
		try w.close()
		return out.bytes()
	}

	// inflate undoes the Redirect binding's DEFLATE, refusing output past
	// maxMessageSize.
	def inflate(data byte[]) !byte[] {
		let r = new flate.Reader(new bytes.Reader(data))
		let out = new bytes.Buffer()
		let chunk byte[]
		chunk.len(16384)
		for {
			let n = r.read(chunk) onerror (err error) {
				fail samlError(SamlErrorKind.Malformed, "the message does not inflate")
			}
			break when n <= 0
			out.write(chunk[0:n]) onerror recover 0
			fail samlError(SamlErrorKind.Malformed, "the message inflates past {maxMessageSize} bytes") when out.len() > maxMessageSize
		}
		return out.bytes()
	}

	// redirectURL encodes a message for the Redirect binding, signing the
	// query when a key is given.
	def redirectURL(endpoint string, param string, xml string, relayState string, key ?PrivateKey, method ?SignatureMethod) !string {
		let query = param + "=" + url.queryEscape(new Base64().encode(try deflate(xml.bytes())))
		query += "&RelayState=" + url.queryEscape(relayState) when relayState != ""
		if !(key is none) {
			let chosen = method is none ?? (defaultMethod(key), method)
			query += "&SigAlg=" + url.queryEscape(chosen.value)
			query += "&Signature=" + url.queryEscape(new Base64().encode(try rawSign(chosen, key, query.bytes())))
		}
		return endpoint + (endpoint.contains("?") ?? ("&", "?")) + query
	}

	// postPage is the auto-submitting form of the POST and Artifact
	// bindings (saml-bindings §3.5.4).
	def postPage(target string, field string, value string, relayState string) string {
		let fields = "<input type=\"hidden\" name=\"{field}\" value=\"{htmlEscape(value)}\">"
		fields += "<input type=\"hidden\" name=\"RelayState\" value=\"{htmlEscape(relayState)}\">" when relayState != ""
		return "<!doctype html><html><head><meta charset=\"utf-8\"><title>Continue</title></head><body onload=\"document.forms[0].submit()\"><form method=\"post\" action=\"{htmlEscape(target)}\">{fields}<noscript><button type=\"submit\">Continue</button></noscript></form></body></html>"
	}

	def htmlEscape(text string) string {
		return text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;").replace("'", "&#39;")
	}

	def checkRelayState(relayState string) !none {
		fail samlError(SamlErrorKind.Malformed, "RelayState is longer than {maxRelayState} bytes") when relayState.bytes().len() > maxRelayState
		return none
	}

	// outgoing encodes a message for a front-channel binding: Redirect
	// (query signature with the key), or Post (the XML is signed already).
	def outgoing(id string, endpoint Endpoint, isRequest bool, xml XMLNode, relayState string, key ?PrivateKey, method ?SignatureMethod) !Message {
		try checkRelayState(relayState)
		let target = isRequest || endpoint.responseLocation == "" ?? (endpoint.location, endpoint.responseLocation)
		let message = new Message(id, endpoint.binding, target)
		message.relayState = relayState
		let param = isRequest ?? ("SAMLRequest", "SAMLResponse")
		match endpoint.binding {
			case Binding.Redirect:
				message.url = try redirectURL(target, param, xml.str(), relayState, key, method)
			case Binding.Post:
				message.page = postPage(target, param, new Base64().encode(xml.str().bytes()), relayState)
			default:
				fail samlError(SamlErrorKind.Unsupported, "cannot send through {endpoint.binding.value}")
		}
		return message
	}

	// SOAP ---------------------------------------------------------------

	def soapEnvelope(body XMLNode) string {
		return "<SOAP-ENV:Envelope xmlns:SOAP-ENV=\"{soapNS}\"><SOAP-ENV:Body>" + body.str() + "</SOAP-ENV:Body></SOAP-ENV:Envelope>"
	}

	// soapMessage returns the one element in a SOAP envelope's Body. Fails
	// with Transport for a Fault, Malformed otherwise.
	def soapMessage(envelope XMLNode) !XMLNode {
		fail samlError(SamlErrorKind.Malformed, "not a SOAP 1.1 envelope") unless envelope.localName == "Envelope" && envelope.namespace == soapNS
		let body = envelope.child("Body", soapNS)
		fail samlError(SamlErrorKind.Malformed, "the SOAP envelope has no Body") when body is none
		let parts = body.elements()
		fail samlError(SamlErrorKind.Malformed, "the SOAP Body must hold one element") unless parts.len() == 1
		let fault = parts[0]
		if fault.localName == "Fault" && fault.namespace == soapNS {
			let reason = childText(fault, "faultstring", "")
			fail samlError(SamlErrorKind.Transport, "SOAP fault: {reason is none ?? ("", reason)}")
		}
		return parts[0]
	}

	// soapCall posts a SAML request in a SOAP envelope and returns the
	// answer's envelope and the message inside it.
	def soapCall(client ?http.Client, endpoint string, message XMLNode) !(XMLNode, XMLNode) {
		let c = client is none ?? (new http.Client(), client)
		let req = try newRequest(Method.POST, endpoint, soapEnvelope(message))
		req.headers.set("Content-Type", "text/xml; charset=utf-8")
		req.headers.set("SOAPAction", soapAction)
		let res = c.do(req) onerror (err error) {
			fail samlError(SamlErrorKind.Transport, "cannot reach {endpoint}: {err.message}")
		}
		let body = res.bytes() onerror fail samlError(SamlErrorKind.Transport, "cannot read the answer of {endpoint}")
		fail samlError(SamlErrorKind.Transport, "{endpoint} answered HTTP {res.status}") unless res.status := 200 || 500
		let envelope = try parseDocument(body)
		return (envelope, try soapMessage(envelope))
	}

	def sendSoap(ctx Context, message XMLNode) !none {
		ctx.setHeader("Cache-Control", "no-cache, no-store")
		return try ctx.blob(200, "text/xml; charset=utf-8", soapEnvelope(message).bytes())
	}

	def sendSoapFault(ctx Context, text string) !none {
		let body = "<SOAP-ENV:Envelope xmlns:SOAP-ENV=\"{soapNS}\"><SOAP-ENV:Body><SOAP-ENV:Fault><faultcode>SOAP-ENV:Client</faultcode><faultstring>{htmlEscape(text)}</faultstring></SOAP-ENV:Fault></SOAP-ENV:Body></SOAP-ENV:Envelope>"
		return try ctx.blob(500, "text/xml; charset=utf-8", body.bytes())
	}

	// Artifacts ----------------------------------------------------------

	// sourceId is the SourceID of a type 0x0004 artifact: SHA-1 of the
	// issuer's entity ID (saml-bindings §3.6.4).
	def sourceId(entityId string) byte[] {
		return digest(Hash.SHA1, entityId.bytes())
	}

	// newArtifact makes a type 0x0004 artifact for an endpoint index.
	def newArtifact(entityId string, index int) !string {
		let raw byte[] = [byte(0), byte(4), byte((index >> 8) & 0xFF), byte(index & 0xFF)]
		raw = raw + sourceId(entityId) + (try rand(20))
		return new Base64().encode(raw)
	}

	// parseArtifact reads a type 0x0004 artifact: its endpoint index and
	// SourceID.
	def parseArtifact(text string) !(int, byte[]) {
		let raw = try decodeB64(text, "SAMLart")
		fail samlError(SamlErrorKind.Malformed, "SAMLart is not a 44-byte artifact") unless raw.len() == 44
		fail samlError(SamlErrorKind.Unsupported, "artifact type {int(raw[0])}.{int(raw[1])} is not 0x0004") unless raw[0] == byte(0) && raw[1] == byte(4)
		return ((int(raw[2]) << 8) | int(raw[3]), raw[4:24])
	}

	// Endpoints ----------------------------------------------------------

	def bindingOf(uri string) ?Binding {
		for let (i, v) in Binding.values() {
			return Binding(i) when v == uri
		}
		return none
	}

	// pick returns the first endpoint with the first binding of the
	// preference list that has one.
	def pick(list Endpoint[], preference Binding[]) ?Endpoint {
		for let b in preference {
			for let e in list {
				return e when e.binding == b
			}
		}
		return none
	}

	// defaultEndpoint is the default of indexed endpoints (saml-metadata
	// §2.2.3): the first marked isDefault, else the first not marked false,
	// else the first.
	def defaultEndpoint(list Endpoint[]) ?Endpoint {
		for let e in list {
			let d = e.isDefault
			return e when !(d is none) && d
		}
		for let e in list {
			return e when e.isDefault is none
		}
		return none when list.len() == 0
		return list[0]
	}

	def keysFor(keys KeyDescriptor[], usage KeyUse) PublicKey[] {
		let out PublicKey[] = []
		for let k in keys {
			out.push(k.key) when k.usage == KeyUse.Any || k.usage == usage
		}
		return out
	}

	// Metadata -----------------------------------------------------------

	def verifyMetadata(root XMLNode, trusted PublicKey[]) !none {
		return none when trusted.len() == 0
		let signed = try verifyEnveloped(root, root, trusted, false)
		fail samlError(SamlErrorKind.Unsigned, "the metadata is not signed") unless signed
		return none
	}

	def collectEntities(e XMLNode, out EntityDescriptor[], inherited ?time.Time) !none {
		fail samlError(SamlErrorKind.Malformed, "not SAML metadata: {e.name}") unless e.namespace == mdNS
		let validUntil = try optionalInstant(e, "validUntil")
		if !(validUntil is none) {
			fail samlError(SamlErrorKind.Expired, "the metadata expired at {instant(validUntil)}") unless time.now().before(validUntil)
		}
		let effective = inherited
		effective = validUntil unless validUntil is none
		if e.localName == "EntitiesDescriptor" {
			for let child in e.elements() {
				try collectEntities(child, out, effective) when child.namespace == mdNS && (child.localName := "EntitiesDescriptor" || "EntityDescriptor")
			}
			return none
		}
		fail samlError(SamlErrorKind.Malformed, "not SAML metadata: {e.name}") unless e.localName == "EntityDescriptor"
		let entity = new EntityDescriptor(try requiredAttr(e, "entityID"))
		entity.validUntil = effective
		let cache = e.attribute("cacheDuration")
		entity.cacheDuration = parseXsDuration(cache) unless cache is none
		for let role in e.elements("IDPSSODescriptor", mdNS) {
			continue unless supportsSaml2(role)
			entity.idp = try idpDescriptorOf(role)
			break
		}
		for let role in e.elements("SPSSODescriptor", mdNS) {
			continue unless supportsSaml2(role)
			entity.sp = try spDescriptorOf(role)
			break
		}
		out.push(entity)
		return none
	}

	def supportsSaml2(role XMLNode) bool {
		return samlpNS in attr(role, "protocolSupportEnumeration").split(" ")
	}

	def idpDescriptorOf(role XMLNode) !IdpDescriptor {
		let d = new IdpDescriptor()
		d.keys = try keyDescriptorsOf(role)
		d.nameIdFormats = formatsOf(role)
		d.singleSignOn = try endpointsOf(role, "SingleSignOnService", false)
		d.singleLogout = try endpointsOf(role, "SingleLogoutService", false)
		d.artifactResolution = try endpointsOf(role, "ArtifactResolutionService", true)
		d.wantAuthnRequestsSigned = isTrue(attr(role, "WantAuthnRequestsSigned"))
		return d
	}

	def spDescriptorOf(role XMLNode) !SpDescriptor {
		let d = new SpDescriptor()
		d.keys = try keyDescriptorsOf(role)
		d.nameIdFormats = formatsOf(role)
		d.assertionConsumers = try endpointsOf(role, "AssertionConsumerService", true)
		d.singleLogout = try endpointsOf(role, "SingleLogoutService", false)
		d.artifactResolution = try endpointsOf(role, "ArtifactResolutionService", true)
		d.authnRequestsSigned = isTrue(attr(role, "AuthnRequestsSigned"))
		d.wantAssertionsSigned = isTrue(attr(role, "WantAssertionsSigned"))
		return d
	}

	def formatsOf(role XMLNode) string[] {
		return role.elements("NameIDFormat", mdNS).mapElem<string>(f => f.text().trim())
	}

	def endpointsOf(role XMLNode, name string, indexed bool) !Endpoint[] {
		let out Endpoint[] = []
		for let e in role.elements(name, mdNS) {
			let binding = bindingOf(try requiredAttr(e, "Binding"))
			continue when binding is none
			let endpoint = Endpoint{binding: binding, location: try requiredAttr(e, "Location"), responseLocation: attr(e, "ResponseLocation")}
			if indexed {
				let index = try requiredAttr(e, "index")
				fail samlError(SamlErrorKind.Malformed, "{name} index {index} is not a number") unless /^[0-9]{1,5}$/.test(index)
				endpoint.index = parseInt<int>(index)
				let d = e.attribute("isDefault")
				endpoint.isDefault = isTrue(d) unless d is none
			}
			out.push(endpoint)
		}
		return out
	}

	// keyDescriptorsOf reads the keys of a role: X509Certificate,
	// DEREncodedKeyValue or RSAKeyValue. A KeyDescriptor whose key cannot be
	// read is skipped; verification then has fewer keys, never a wrong one.
	def keyDescriptorsOf(role XMLNode) !KeyDescriptor[] {
		let out KeyDescriptor[] = []
		for let kd in role.elements("KeyDescriptor", mdNS) {
			let usage = attr(kd, "use")
			let keyUse = usage == "signing" ?? (KeyUse.Signing, usage == "encryption" ?? (KeyUse.Encryption, KeyUse.Any))
			fail samlError(SamlErrorKind.Malformed, "KeyDescriptor use \"{usage}\" is neither signing nor encryption") unless usage := "" || "signing" || "encryption"
			let info = kd.child("KeyInfo", xmlDsigNamespace)
			continue when info is none
			let found = keyOf(info)
			continue when found is none
			let (key, cert) = found
			let descriptor = new KeyDescriptor(key, cert, keyUse)
			for let m in kd.elements("EncryptionMethod", mdNS) {
				descriptor.encryptionMethods.push(attr(m, "Algorithm"))
			}
			out.push(descriptor)
		}
		return out
	}

	def keyOf(info XMLNode) ?(PublicKey, ?byte[]) {
		for let data in info.elements("X509Data", xmlDsigNamespace) {
			for let c in data.elements("X509Certificate", xmlDsigNamespace) {
				let der = decodeB64(c.text(), "X509Certificate") onerror recover byte[]
				continue when der.len() == 0
				let key = certificateKey(der)
				return (key, der) unless key is none
			}
		}
		for let encoded in info.elements("DEREncodedKeyValue", dsig11NS) {
			let der = decodeB64(encoded.text(), "DEREncodedKeyValue") onerror recover byte[]
			let key = pkixKey(der)
			return (key, none) unless key is none
		}
		for let value in info.elements("KeyValue", xmlDsigNamespace) {
			let rsa = value.child("RSAKeyValue", xmlDsigNamespace)
			continue when rsa is none
			let modulus = childText(rsa, "Modulus", xmlDsigNamespace)
			let exponent = childText(rsa, "Exponent", xmlDsigNamespace)
			continue when modulus is none || exponent is none
			let n = decodeB64(modulus, "Modulus") onerror recover byte[]
			let e = decodeB64(exponent, "Exponent") onerror recover byte[]
			continue when n.len() == 0 || e.len() == 0 || e.len() > 4
			let exp = 0
			for let b in e {
				exp = (exp << 8) | int(b)
			}
			return (new RSAPublicKey(parseBigInt(n), exp), none)
		}
		return none
	}

	def certificateKey(der byte[]) ?PublicKey {
		let cert = x509.parseCertificate(der) onerror (err error) {
			return none
		}
		return cert.publicKey
	}

	def pkixKey(der byte[]) ?PublicKey {
		let key = parsePKIXPublicKey(der) onerror (err error) {
			return none
		}
		return key
	}

	// entityId-derived document IDs keep metadata writing infallible; an ID
	// only has to be unique within its document.
	def metadataId(entityId string) string {
		return "_" + hexencode(digest(Hash.SHA256, entityId.bytes()))[0:40]
	}

	def entityElement(e EntityDescriptor) XMLNode {
		let root = new XMLNode("md:EntityDescriptor", mdNS)
		root.set("xmlns:md", mdNS)
		root.set("xmlns:ds", xmlDsigNamespace)
		fillEntity(root, e)
		return root
	}

	def entitiesElement(entities EntityDescriptor[], name string) XMLNode {
		let root = new XMLNode("md:EntitiesDescriptor", mdNS)
		root.set("xmlns:md", mdNS)
		root.set("xmlns:ds", xmlDsigNamespace)
		root.set("ID", metadataId("entities:" + name))
		root.set("Name", name) when name != ""
		for let e in entities {
			fillEntity(element(root, "md:EntityDescriptor", mdNS), e)
		}
		return root
	}

	def fillEntity(root XMLNode, e EntityDescriptor) {
		root.set("ID", metadataId(e.entityId))
		root.set("entityID", e.entityId)
		let until = e.validUntil
		root.set("validUntil", instant(until)) unless until is none
		let cache = e.cacheDuration
		root.set("cacheDuration", xsDuration(cache)) unless cache is none
		let idp = e.idp
		if !(idp is none) {
			let role = element(root, "md:IDPSSODescriptor", mdNS)
			role.set("protocolSupportEnumeration", samlpNS)
			role.set("WantAuthnRequestsSigned", "true") when idp.wantAuthnRequestsSigned
			writeKeys(role, idp.keys)
			writeEndpoints(role, "md:ArtifactResolutionService", idp.artifactResolution, true)
			writeEndpoints(role, "md:SingleLogoutService", idp.singleLogout, false)
			writeFormats(role, idp.nameIdFormats)
			writeEndpoints(role, "md:SingleSignOnService", idp.singleSignOn, false)
		}
		let sp = e.sp
		if !(sp is none) {
			let role = element(root, "md:SPSSODescriptor", mdNS)
			role.set("protocolSupportEnumeration", samlpNS)
			role.set("AuthnRequestsSigned", sp.authnRequestsSigned ?? ("true", "false"))
			role.set("WantAssertionsSigned", sp.wantAssertionsSigned ?? ("true", "false"))
			writeKeys(role, sp.keys)
			writeEndpoints(role, "md:ArtifactResolutionService", sp.artifactResolution, true)
			writeEndpoints(role, "md:SingleLogoutService", sp.singleLogout, false)
			writeFormats(role, sp.nameIdFormats)
			writeEndpoints(role, "md:AssertionConsumerService", sp.assertionConsumers, true)
		}
	}

	def writeKeys(role XMLNode, keys KeyDescriptor[]) {
		for let k in keys {
			let kd = element(role, "md:KeyDescriptor", mdNS)
			kd.set("use", "signing") when k.usage == KeyUse.Signing
			kd.set("use", "encryption") when k.usage == KeyUse.Encryption
			let info = element(kd, "ds:KeyInfo", xmlDsigNamespace)
			let cert = k.certificate
			if cert is none {
				let value = textElement(info, "dsig11:DEREncodedKeyValue", dsig11NS, new Base64().encode(marshalPKIXPublicKey(k.key)))
				value.set("xmlns:dsig11", dsig11NS)
			} else {
				textElement(element(info, "ds:X509Data", xmlDsigNamespace), "ds:X509Certificate", xmlDsigNamespace, new Base64().encode(cert))
			}
			for let m in k.encryptionMethods {
				element(kd, "md:EncryptionMethod", mdNS).set("Algorithm", m)
			}
		}
	}

	def writeEndpoints(role XMLNode, name string, list Endpoint[], indexed bool) {
		for let e in list {
			let node = element(role, name, mdNS)
			node.set("Binding", e.binding.value)
			node.set("Location", e.location)
			node.set("ResponseLocation", e.responseLocation) when e.responseLocation != ""
			if indexed {
				node.set("index", "{e.index}")
				let d = e.isDefault
				node.set("isDefault", d ?? ("true", "false")) unless d is none
			}
		}
	}

	def writeFormats(role XMLNode, formats string[]) {
		for let f in formats {
			textElement(role, "md:NameIDFormat", mdNS, f)
		}
	}

	// Assertions ---------------------------------------------------------

	// decryptWrapped decrypts an EncryptedAssertion, EncryptedID or
	// EncryptedAttribute in place and returns the one element it held.
	def decryptWrapped(wrapper XMLNode, keys PrivateKey[], document XMLNode) !XMLNode {
		fail samlError(SamlErrorKind.DecryptionFailed, "{wrapper.localName} needs a decryption key") when keys.len() == 0
		let data = wrapper.elements("EncryptedData", xmlEncNamespace)
		fail samlError(SamlErrorKind.Malformed, "{wrapper.localName} must hold one EncryptedData") unless data.len() == 1
		let nodes = decryptXML(data[0], XMLKeys{privateKeys: keys}, document) onerror (err error) {
			fail samlError(SamlErrorKind.DecryptionFailed, "{wrapper.localName} does not decrypt: {err.message}")
		}
		let elements = nodes.filter(n => n.kind == XMLNodeKind.Element)
		fail samlError(SamlErrorKind.DecryptionFailed, "{wrapper.localName} does not hold one element") unless elements.len() == 1
		return elements[0]
	}

	// nameIdOf reads a NameID, decrypting an EncryptedID.
	def nameIdOf(parent XMLNode, keys PrivateKey[], document XMLNode) !?NameId {
		let n = try nameIdNode(parent, keys, document)
		return none when n is none
		let id = new NameId(n.text().trim(), attr(n, "Format"))
		id.nameQualifier = attr(n, "NameQualifier")
		id.spNameQualifier = attr(n, "SPNameQualifier")
		id.spProvidedId = attr(n, "SPProvidedID")
		return id
	}

	def nameIdNode(parent XMLNode, keys PrivateKey[], document XMLNode) !?XMLNode {
		let found = parent.child("NameID", samlNS)
		return found unless found is none
		let encrypted = parent.child("EncryptedID", samlNS)
		return none when encrypted is none
		let plain = try decryptWrapped(encrypted, keys, document)
		fail samlError(SamlErrorKind.Malformed, "EncryptedID does not hold a NameID") unless plain.localName == "NameID" && plain.namespace == samlNS
		return plain
	}

	def nameIdElement(parent XMLNode, id NameId) XMLNode {
		let n = textElement(parent, "saml:NameID", samlNS, id.value)
		n.set("Format", id.format) when id.format != ""
		n.set("NameQualifier", id.nameQualifier) when id.nameQualifier != ""
		n.set("SPNameQualifier", id.spNameQualifier) when id.spNameQualifier != ""
		n.set("SPProvidedID", id.spProvidedId) when id.spProvidedId != ""
		return n
	}

	// attributesOf reads every Attribute and EncryptedAttribute of the
	// AttributeStatements.
	def attributesOf(assertion XMLNode, keys PrivateKey[], document XMLNode) !Attributes {
		let out = new Attributes()
		for let statement in assertion.elements("AttributeStatement", samlNS) {
			for let child in statement.elements() {
				let a = child
				a = try decryptWrapped(child, keys, document) when child.localName == "EncryptedAttribute" && child.namespace == samlNS
				continue unless a.localName == "Attribute" && a.namespace == samlNS
				let attribute = Attribute{name: try requiredAttr(a, "Name"), nameFormat: attr(a, "NameFormat"), friendlyName: attr(a, "FriendlyName")}
				for let v in a.elements("AttributeValue", samlNS) {
					attribute.values.push(v.text())
				}
				out.list.push(attribute)
			}
		}
		return out
	}

	// ReplayCache remembers IDs until they expire.
	type ReplayCache {
		internal seen   map<string, time.Time>
		internal writes int                    = 0

		def new() {}

		// first records the id and reports whether it was new.
		atomic def first(id string, until time.Time) bool {
			let now = time.now()
			let known = seen.get(id)
			return false when !(known is none) && now.before(known)
			seen.set(id, until)
			writes++
			if writes % 512 == 0 {
				for let k in seen.keys() {
					let t = seen.get(k)
					seen.delete(k) when !(t is none) && !now.before(t)
				}
			}
			return true
		}
	}

	// basePath is the path of a URL, without a trailing slash.
	def basePath(base string) string {
		let at = base.indexOf("://")
		let rest = at < 0 ?? (base, base[at + 3:])
		let slash = rest.indexOf("/")
		return slash < 0 ?? ("", rest[slash:].trimSuffix("/"))
	}
}
