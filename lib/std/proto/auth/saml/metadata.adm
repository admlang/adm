partial module std.proto.auth.saml {
	use (
		std.time
		std.crypto::(PublicKey, PrivateKey)
		std.data.encoding::(SignatureMethod)
		std.proto.auth.saml.engine::*
	)

	// KeyUse is what a metadata key is for (saml-metadata §2.4.1.1).
	enum KeyUse {
		// No `use`: both signing and encryption.
		Any,
		Signing,
		Encryption,
	}

	// KeyDescriptor is a key a SAML entity publishes: the public key, the
	// certificate it came in (DER), and for encryption keys the algorithms
	// the entity accepts.
	type KeyDescriptor {
		key               PublicKey
		certificate       ?byte[]
		usage             KeyUse    = KeyUse.Any
		// EncryptionMethod Algorithm URIs, in the entity's order of
		// preference.
		encryptionMethods string[]  = []

		def new(key PublicKey, certificate ?byte[] = none, usage KeyUse = KeyUse.Any) {
			self.key = key
			self.certificate = certificate
			self.usage = usage
		}
	}

	// Endpoint is a protocol endpoint of an entity: the binding, where to
	// send requests (`location`) and responses (`responseLocation`, the
	// location when empty), and for indexed endpoints (assertion consumer,
	// artifact resolution) the index and the isDefault flag.
	struct Endpoint {
		binding          Binding
		location         string
		responseLocation string  = ""
		index            int     = 0
		isDefault        ?bool
	}

	// IdpDescriptor is an identity provider role (IDPSSODescriptor).
	type IdpDescriptor {
		keys                    KeyDescriptor[] = []
		nameIdFormats           string[]        = []
		singleSignOn            Endpoint[]      = []
		singleLogout            Endpoint[]      = []
		artifactResolution      Endpoint[]      = []
		wantAuthnRequestsSigned bool            = false

		def new() {}

		// signingKeys returns the keys the identity provider signs with.
		def signingKeys() PublicKey[] {
			return keysFor(keys, KeyUse.Signing)
		}
	}

	// SpDescriptor is a service provider role (SPSSODescriptor).
	type SpDescriptor {
		keys                 KeyDescriptor[] = []
		nameIdFormats        string[]        = []
		assertionConsumers   Endpoint[]      = []
		singleLogout         Endpoint[]      = []
		artifactResolution   Endpoint[]      = []
		authnRequestsSigned  bool            = false
		wantAssertionsSigned bool            = false

		def new() {}

		// signingKeys returns the keys the service provider signs with.
		def signingKeys() PublicKey[] {
			return keysFor(keys, KeyUse.Signing)
		}

		// encryptionKey returns the first key to encrypt for, none when the
		// service provider publishes none.
		def encryptionKey() ?KeyDescriptor {
			for let k in keys {
				return k when k.usage != KeyUse.Signing
			}
			return none
		}
	}

	// EntityDescriptor is a SAML entity's metadata (saml-metadata §2.3.2):
	// its entity ID, validity, and its identity provider and service
	// provider roles.
	type EntityDescriptor {
		entityId      string
		validUntil    ?time.Time
		// How long the metadata may be cached. xs:duration years and months
		// count as 365 and 30 days.
		cacheDuration ?duration
		idp           ?IdpDescriptor
		sp            ?SpDescriptor

		def new(entityId string) {
			self.entityId = entityId
		}

		// xml writes the metadata as an md:EntityDescriptor document.
		def xml() string {
			return entityElement(self).str()
		}

		// xml writes the metadata signed with the key (enveloped, exclusive
		// canonicalization; the certificate goes in KeyInfo when given).
		// The method defaults to the key's usual one (RSA-SHA256,
		// ECDSA-SHA256/384/512 by curve, EdDSA). Fails when the key cannot
		// sign with the method.
		def xml(key PrivateKey, certificate ?byte[] = none, method ?SignatureMethod = none) !string {
			let root = entityElement(self)
			try signElement(root, key, method, certificate, "")
			return root.str()
		}
	}

	// parseMetadata reads the metadata of one entity: an md:EntityDescriptor,
	// or an md:EntitiesDescriptor holding exactly one. With trusted keys the
	// document must carry an enveloped signature on its root that one of
	// them verifies; without, a signature is not checked. Roles that do not
	// support the SAML 2.0 protocol are skipped, and so are endpoints with
	// a binding this module does not implement. Fails with Malformed,
	// Unsigned or BadSignature, and Expired when a validUntil has passed.
	def parseMetadata(text string, trusted PublicKey[] = []) !EntityDescriptor {
		let all = try parseMetadataSet(text, trusted)
		fail samlError(SamlErrorKind.Malformed, "the metadata holds {all.len()} entities, not one") unless all.len() == 1
		return all[0]
	}

	// parseMetadataSet reads an md:EntitiesDescriptor (nested ones
	// included) or an md:EntityDescriptor and returns every entity. Fails
	// as parseMetadata does.
	def parseMetadataSet(text string, trusted PublicKey[] = []) !EntityDescriptor[] {
		let root = try parseDocument(text.bytes())
		try verifyMetadata(root, trusted)
		let out EntityDescriptor[] = []
		try collectEntities(root, out, none)
		return out
	}

	// writeMetadataSet writes entities as one md:EntitiesDescriptor
	// document, signed when a key is given (see EntityDescriptor.xml).
	// Fails when signing does.
	def writeMetadataSet(entities EntityDescriptor[], key ?PrivateKey = none, certificate ?byte[] = none, method ?SignatureMethod = none, name string = "") !string {
		let root = entitiesElement(entities, name)
		if !(key is none) {
			try signElement(root, key, method, certificate, "")
		}
		return root.str()
	}
}
