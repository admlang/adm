// SAML 2.0 service provider and identity provider: Core (assertions,
// protocols, signatures, encryption), Bindings (HTTP-Redirect, HTTP-POST,
// HTTP-Artifact, SOAP), Profiles (Web Browser SSO, Single Logout, Artifact
// Resolution) and Metadata. Signatures are XML-DSig, encryption XML-Enc,
// from std.data.encoding; every message is parsed with DOCTYPEs refused.
//
// ```
// let idp = try saml.parseMetadata(idpMetadataXml)
// let sp = new saml.ServiceProvider("https://sp.example/saml", "https://sp.example/acs", idp)
// let req = try sp.login(saml.Binding.Redirect, relayState = "/app")
// try req.send(ctx)
// // at the ACS, with req.id kept in the user's session:
// let assertion = try sp.consume(ctx, req.id)
// println(assertion.nameId.value, assertion.attributes.get("mail"))
// ```
partial module std.proto.auth.saml {
	use (
		std.time
		std.errors
		std.data.encoding::(XMLNode)
		std.net.http::(Context)
		std.proto.auth.saml.engine::*
	)

	// Binding is a SAML protocol binding (saml-bindings); its value is the
	// binding URI.
	enum Binding {
		// Deflated, base64 message in the URL query; signed by `SigAlg` and
		// `Signature` query parameters (§3.4).
		Redirect = "urn:oasis:names:tc:SAML:2.0:bindings:HTTP-Redirect",
		// Base64 message in an auto-submitted HTML form; signed by an
		// enveloped XML signature (§3.5).
		Post = "urn:oasis:names:tc:SAML:2.0:bindings:HTTP-POST",
		// A reference sent through the browser, resolved over SOAP (§3.6).
		Artifact = "urn:oasis:names:tc:SAML:2.0:bindings:HTTP-Artifact",
		// A SOAP 1.1 request and response, server to server (§3.2).
		Soap = "urn:oasis:names:tc:SAML:2.0:bindings:SOAP",
	}

	// NameIdFormat is a name identifier format (saml-core §8.3); its value
	// is the format URI.
	enum NameIdFormat {
		Unspecified = "urn:oasis:names:tc:SAML:1.1:nameid-format:unspecified",
		EmailAddress = "urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress",
		X509SubjectName = "urn:oasis:names:tc:SAML:1.1:nameid-format:X509SubjectName",
		WindowsDomainQualifiedName = "urn:oasis:names:tc:SAML:1.1:nameid-format:WindowsDomainQualifiedName",
		Kerberos = "urn:oasis:names:tc:SAML:2.0:nameid-format:kerberos",
		Entity = "urn:oasis:names:tc:SAML:2.0:nameid-format:entity",
		// An opaque identifier that stays the same for the user at one
		// service provider and differs between providers.
		Persistent = "urn:oasis:names:tc:SAML:2.0:nameid-format:persistent",
		// An opaque identifier for one login only.
		Transient = "urn:oasis:names:tc:SAML:2.0:nameid-format:transient",
	}

	// StatusCode is a SAML status code (saml-core §3.2.2.2): the four
	// top-level codes, then the second-level ones; its value is the URI.
	enum StatusCode {
		Success = "urn:oasis:names:tc:SAML:2.0:status:Success",
		Requester = "urn:oasis:names:tc:SAML:2.0:status:Requester",
		Responder = "urn:oasis:names:tc:SAML:2.0:status:Responder",
		VersionMismatch = "urn:oasis:names:tc:SAML:2.0:status:VersionMismatch",
		AuthnFailed = "urn:oasis:names:tc:SAML:2.0:status:AuthnFailed",
		InvalidAttrNameOrValue = "urn:oasis:names:tc:SAML:2.0:status:InvalidAttrNameOrValue",
		InvalidNameIdPolicy = "urn:oasis:names:tc:SAML:2.0:status:InvalidNameIDPolicy",
		NoAuthnContext = "urn:oasis:names:tc:SAML:2.0:status:NoAuthnContext",
		NoAvailableIdp = "urn:oasis:names:tc:SAML:2.0:status:NoAvailableIDP",
		NoPassive = "urn:oasis:names:tc:SAML:2.0:status:NoPassive",
		NoSupportedIdp = "urn:oasis:names:tc:SAML:2.0:status:NoSupportedIDP",
		PartialLogout = "urn:oasis:names:tc:SAML:2.0:status:PartialLogout",
		ProxyCountExceeded = "urn:oasis:names:tc:SAML:2.0:status:ProxyCountExceeded",
		RequestDenied = "urn:oasis:names:tc:SAML:2.0:status:RequestDenied",
		RequestUnsupported = "urn:oasis:names:tc:SAML:2.0:status:RequestUnsupported",
		RequestVersionDeprecated = "urn:oasis:names:tc:SAML:2.0:status:RequestVersionDeprecated",
		RequestVersionTooHigh = "urn:oasis:names:tc:SAML:2.0:status:RequestVersionTooHigh",
		RequestVersionTooLow = "urn:oasis:names:tc:SAML:2.0:status:RequestVersionTooLow",
		ResourceNotRecognized = "urn:oasis:names:tc:SAML:2.0:status:ResourceNotRecognized",
		TooManyResponses = "urn:oasis:names:tc:SAML:2.0:status:TooManyResponses",
		UnknownAttrProfile = "urn:oasis:names:tc:SAML:2.0:status:UnknownAttrProfile",
		UnknownPrincipal = "urn:oasis:names:tc:SAML:2.0:status:UnknownPrincipal",
		UnsupportedBinding = "urn:oasis:names:tc:SAML:2.0:status:UnsupportedBinding",
	}

	// AuthnComparison is how an identity provider matches the requested
	// authentication contexts (saml-core §3.3.2.2.1).
	enum AuthnComparison {
		Exact = "exact",
		Minimum = "minimum",
		Maximum = "maximum",
		Better = "better",
	}

	// The authentication context class of a password over a protected
	// transport (saml-authn-context §3.4.7), what Decision defaults to.
	const passwordProtectedTransport = "urn:oasis:names:tc:SAML:2.0:ac:classes:PasswordProtectedTransport"

	// SamlErrorKind says why a SAML operation failed.
	enum SamlErrorKind {
		// The message is not well formed, misses a required part, or
		// carries a DOCTYPE.
		Malformed,
		// A signature does not verify, or covers another element than the
		// one it must.
		BadSignature,
		// A message or assertion that must be signed is not.
		Unsigned,
		// The message, assertion, metadata or a confirmation is past its
		// end of validity.
		Expired,
		// The assertion's NotBefore is still ahead.
		NotYetValid,
		// The assertion is not addressed to this provider.
		AudienceMismatch,
		// The message's Destination or a confirmation's Recipient is not
		// the endpoint it arrived at.
		DestinationMismatch,
		// The message answers another request, or is unsolicited where
		// that is not allowed.
		InResponseToMismatch,
		// The message's Issuer is not the expected entity.
		IssuerMismatch,
		// The message comes from, or names, an entity this provider does
		// not know.
		UnknownEntity,
		// The assertion or message was seen before.
		Replayed,
		// The peer answered with a status other than Success; `status` holds
		// its codes.
		StatusNotSuccess,
		DecryptionFailed,
		// An algorithm, binding or construct this module does not
		// implement or allow.
		Unsupported,
		// A SOAP exchange (artifact resolution, back-channel logout) could
		// not be completed.
		Transport,
	}

	// SamlError is the payload of every failure in this module.
	struct SamlError {
		message       string
		code          string
		cause         ?error
		stack         errors.StackTrace
		kind          SamlErrorKind
		// For StatusNotSuccess: the top-level status code URI, then the
		// nested ones.
		status        string[]
		statusMessage string
	}

	// NameId is a SAML name identifier (saml-core §2.2.3).
	type NameId {
		value           string
		format          string = ""
		nameQualifier   string = ""
		spNameQualifier string = ""
		spProvidedId    string = ""

		def new(value string, format string = "") {
			self.value = value
			self.format = format
		}
	}

	// Attribute is one SAML attribute: its name, how the name is to be read,
	// and its values as text.
	struct Attribute {
		name         string
		nameFormat   string   = ""
		friendlyName string   = ""
		values       string[] = []
	}

	// Attributes are the attributes of an assertion's AttributeStatements,
	// looked up by Name or by FriendlyName.
	type Attributes {
		list Attribute[] = []

		def new() {}

		// get returns the first value of the attribute with this Name or
		// FriendlyName, none when there is none.
		def get(name string) ?string {
			for let a in list {
				return a.values[0] when (a.name == name || a.friendlyName == name) && a.values.len() > 0
			}
			return none
		}

		// all returns every value of the attributes with this Name or
		// FriendlyName.
		def all(name string) string[] {
			let out string[] = []
			for let a in list {
				continue unless a.name == name || a.friendlyName == name
				for let v in a.values {
					out.push(v)
				}
			}
			return out
		}

		// names returns the attribute names, in document order.
		def names() string[] {
			return list.mapElem<string>(a => a.name)
		}
	}

	// Assertion is an assertion a service provider accepted: every check of
	// ServiceProvider.consume passed. `element` is the verified
	// saml:Assertion, for extensions this type does not read.
	type Assertion {
		id                  string
		issuer              string
		issueInstant        time.Time
		nameId              NameId
		// The SessionIndex of the first AuthnStatement, needed to log out.
		sessionIndex        ?string
		authnInstant        ?time.Time
		// The AuthnContextClassRef of the first AuthnStatement.
		authnContext        ?string
		sessionNotOnOrAfter ?time.Time
		notBefore           ?time.Time
		notOnOrAfter        ?time.Time
		audiences           string[]   = []
		attributes          Attributes
		// The request the response answered; none when unsolicited.
		inResponseTo        ?string
		// The RelayState that came with the response.
		relayState          string     = ""
		element             XMLNode

		def new(id string, issuer string, issueInstant time.Time, nameId NameId, element XMLNode) {
			self.id = id
			self.issuer = issuer
			self.issueInstant = issueInstant
			self.nameId = nameId
			self.element = element
			attributes = new Attributes()
		}
	}

	// LoginOptions shape an AuthnRequest (saml-core §3.4.1).
	struct LoginOptions {
		// Ask the identity provider to authenticate the user again.
		forceAuthn      bool            = false
		// Ask it not to interact with the user.
		isPassive       bool            = false
		// The NameIDPolicy Format; none leaves it to the identity provider.
		nameIdFormat    ?NameIdFormat
		// NameIDPolicy AllowCreate.
		allowCreate     bool            = true
		// RequestedAuthnContext class references; empty sends none.
		authnContexts   string[]        = []
		comparison      AuthnComparison = AuthnComparison.Exact
		// The binding the response is to come back with: Post or Artifact.
		responseBinding Binding         = Binding.Post
	}

	// Message is a SAML message on its way to a peer through the browser:
	// a URL to redirect to (Redirect, Artifact) or an auto-submitting form
	// page (Post). A Soap message was already exchanged when it was made,
	// and send writes nothing.
	type Message {
		// The ID of the request or response; keep a request's to check the
		// answer.
		id          string
		binding     Binding
		// The peer's endpoint.
		destination string
		// Redirect and Artifact: where to send the browser.
		url         string  = ""
		// Post: the HTML page that posts the message.
		page        string  = ""
		relayState  string  = ""

		def new(id string, binding Binding, destination string) {
			self.id = id
			self.binding = binding
			self.destination = destination
		}

		// send delivers the message through the browser: a 303 redirect,
		// or the form page (uncached). Fails when the response cannot be
		// written.
		def send(ctx Context) !none {
			return none when binding == Binding.Soap
			ctx.setHeader("Cache-Control", "no-cache, no-store")
			ctx.setHeader("Pragma", "no-cache")
			return try ctx.redirect(url, 303) unless binding == Binding.Post
			return try ctx.html(200, page)
		}
	}

	// Logout is a Single Logout message a provider received and checked:
	// a LogoutRequest from the peer (`request`), or the LogoutResponse to
	// one this provider sent.
	type Logout {
		// True for a LogoutRequest, false for a LogoutResponse.
		request        bool
		id             string
		issuer         string
		// A request: who to log out, and which sessions (none listed means
		// all of them).
		nameId         ?NameId
		sessionIndexes string[] = []
		// A response: its InResponseTo, and whether the peer logged the
		// user out everywhere (Success without PartialLogout).
		inResponseTo   string   = ""
		success        bool     = true
		// The status codes of a response.
		status         string[] = []
		relayState     string   = ""

		def new(request bool, id string, issuer string) {
			self.request = request
			self.id = id
			self.issuer = issuer
		}
	}
}
