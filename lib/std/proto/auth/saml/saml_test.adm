	internal def pemKey(text string) !PrivateKey {
		return try crypto.parsePKCS8PrivateKey((try pemDecode(text)).bytes)
	}

	internal def pemDer(text string) !byte[] {
		return (try pemDecode(text)).bytes
	}

	internal type StopRedirects {
		def new() {}

		def follow(next Request, via Request[]) !bool {
			return false
		}
	}

	// A loopback site with an identity provider under /idp, its login page
	// at /login, and two service providers under /sp and /sp2 with ACS
	// and Single Logout handlers.
	internal type Site {
		server      httptest.Server
		provider    IdentityProvider
		api         http.Client
		sp          ?ServiceProvider
		sp2         ?ServiceProvider
		// What the login page does: "allow", "deny" or "passive".
		mode        string           = "allow"
		session     string           = "s-1"
		requestId   ?string
		accepted    ?Assertion
		acsError    string           = ""
		logouts     Logout[]         = []
		logoutError string           = ""
		appSessions string[]         = []

		def new(server httptest.Server, provider IdentityProvider) {
			self.server = server
			self.provider = provider
			api = server.client()
			api.redirects = new StopRedirects()
		}

		def url(path string) string {
			return server.url + path
		}

		def serviceProvider() !ServiceProvider {
			let s = sp
			fail "no sp" when s is none
			return s
		}
	}

	internal def startSite(idpKey ?PrivateKey = none, idpCert ?byte[] = none) !Site {
		let key = idpKey is none ?? (try pemKey(idpKeyPem), idpKey)
		let cert = idpCert is none ?? (try pemDer(idpCertPem), idpCert)
		let provider = new IdentityProvider("http://placeholder/idp", key, cert)
		provider.persistentSecret = "test persistent secret".bytes()
		let holder ?Site = none
		let mux = new ServeMux()
		try mux.handle("/login", def (ctx Context) !none {
			let t = holder
			fail "no site" when t is none
			let id = ctx.query("request", "")
			let pending = try provider.pending(id)
			return try provider.deny(ctx, id) when t.mode == "deny"
			return try provider.deny(ctx, id, StatusCode.NoPassive, "no session") when t.mode == "passive" || pending.isPassive
			let attrs map<string, string[]>
			attrs.set("mail", ["alice@example.com"])
			attrs.set("groups", ["staff", "admins"])
			return try provider.complete(ctx, id, Decision{nameId: "alice", attributes: attrs, session: t.session})
		})
		try mux.handle("/sp/acs", def (ctx Context) !none {
			let t = holder
			fail "no site" when t is none
			let sp = try t.serviceProvider()
			let a = sp.consume(ctx, t.requestId) onerror (err error) {
				t.acsError = err.message
				return try ctx.text(403, err.message)
			}
			t.accepted = a
			return try ctx.text("welcome")
		})
		try mux.handle("/sp/slo", def (ctx Context) !none {
			let t = holder
			fail "no site" when t is none
			let sp = try t.serviceProvider()
			let ended = def (_ Logout) !bool {
				t.appSessions.push("sp")
				return true
			}
			let logout = sp.handleLogout(ctx, ended, t.requestId) onerror (err error) {
				t.logoutError = err.message
				return try ctx.text(403, err.message)
			}
			t.logouts.push(logout)
			return try ctx.text("bye") unless logout.request
			return none
		})
		try mux.handle("/sp2/slo", def (ctx Context) !none {
			let t = holder
			fail "no site" when t is none
			let sp = t.sp2
			fail "no sp2" when sp is none
			let ended = def (_ Logout) !bool {
				t.appSessions.push("sp2")
				return true
			}
			let logout = sp.handleLogout(ctx, ended) onerror (err error) {
				t.logoutError = err.message
				return try ctx.text(403, err.message)
			}
			t.logouts.push(logout)
			return none
		})
		try mux.handle("/sp/metadata", def (ctx Context) !none {
			let t = holder
			fail "no site" when t is none
			return try (try t.serviceProvider()).metadataHandler().serve(ctx)
		})
		try mux.handle("/sp/start", def (ctx Context) !none {
			let t = holder
			fail "no site" when t is none
			let req = try (try t.serviceProvider()).login(Binding.Post)
			t.requestId = req.id
			return try req.send(ctx)
		})
		try mux.handle("/idp/", provider.handler())
		let server = new httptest.Server(mux)
		try server.start()
		provider.entityId = server.url + "/idp"
		provider.baseURL = server.url + "/idp"
		provider.loginURL = server.url + "/login"
		provider.endSession = def (_ Context, session string) !none {
			let t = holder
			t.appSessions.push("idp:" + session) unless t is none
			return none
		}
		let t = new Site(server, provider)
		holder = t
		return t
	}

	// addSp makes a service provider at path for the site's identity
	// provider and registers its metadata there.
	internal def addSp(t Site, path string, withKey bool = true) !ServiceProvider {
		let idpMetadata = try parseMetadata(t.provider.metadata().xml())
		let sp = new ServiceProvider(t.url(path), t.url(path + "/acs"), idpMetadata)
		sp.sloURL = t.url(path + "/slo")
		sp.httpClient = t.server.client()
		if withKey {
			sp.key = try pemKey(spKeyPem)
			sp.certificate = try pemDer(spCertPem)
		}
		try t.provider.serviceProviders.save(try parseMetadata(sp.metadata().xml()))
		return sp
	}

	// formField reads a hidden input of an auto-submitting form page.
	internal def formField(page string, name string) string {
		let marker = "name=\"" + name + "\" value=\""
		let at = page.indexOf(marker)
		return "" when at < 0
		let rest = page[at + marker.len():]
		return rest[:rest.indexOf("\"")].replace("&quot;", "\"").replace("&#39;", "'").replace("&lt;", "<").replace("&gt;", ">").replace("&amp;", "&")
	}

	// browse follows a login message to the identity provider and its login
	// page and returns the page that posts the response.
	internal def browse(t Site, req Message) !string {
		let first ?http.Response = none
		if req.binding == Binding.Redirect {
			first = try t.api.get(req.url)
		} else {
			let form = new Values()
			form.set("SAMLRequest", formField(req.page, "SAMLRequest"))
			form.set("RelayState", req.relayState) when req.relayState != ""
			first = try t.api.postForm(req.destination, form)
		}
		fail "no answer" when first is none
		assert first.status == 303
		let login = try t.api.get(first.header("Location"))
		return try login.text()
	}

	// issued logs alice in through the browser flow and returns the base64
	// SAMLResponse the identity provider posted.
	internal def issued(t Site, sp ServiceProvider, relayState string = "") !(string, string) {
		let req = try sp.login(Binding.Redirect, relayState)
		let page = try browse(t, req)
		return (formField(page, "SAMLResponse"), req.id)
	}

	internal def responseXml(encoded string) !string {
		return string(try new Base64().decode(encoded))
	}

	internal def encode(xml string) string {
		return new Base64().encode(xml.bytes())
	}

	// kindOf runs a consume and returns the name of the SamlErrorKind it
	// failed with, "" when it passed.
	internal def kindOf(sp ServiceProvider, encoded string, requestId ?string) string {
		let kind = ""
		sp.consume(encoded, requestId) onerror (err error) {
			kind = "not a SamlError: " + err.message
			kind = err.kind.str() when err is SamlError
			recover new Assertion("", "", time.now(), new NameId(""), new XMLNode("x"))
		}
		return kind
	}

	// unsignedAssertionSite is a site whose identity provider signs
	// assertions only and does not encrypt, for wrapping attacks.
	internal def plainSite() !(Site, ServiceProvider) {
		let t = try startSite()
		t.provider.encryptAssertions = false
		let sp = try addSp(t, "/sp")
		t.sp = sp
		return (t, sp)
	}

	// signedDocument parses a response XML and returns its root and only
	// assertion.
	internal def parts(xml string) !(XMLNode, XMLNode) {
		let root = try new XML().parse(xml)
		let a = root.child("Assertion", samlNS)
		fail "no assertion" when a is none
		return (root, a)
	}

	internal def withoutChild(e XMLNode, name string) XMLNode[] {
		return e.children.filter(c => c.localName != name)
	}

	internal def copyOf(e XMLNode) !XMLNode {
		return try new XML().parse(e.str())
	}

	check "SAML" {
		@test()
		def TestXsDuration() !none {
			let d = parseXsDuration("PT1H30M")
			assert !(d is none) && d == 90m
			let days = parseXsDuration("P2DT0.5S")
			assert !(days is none) && days == 48h + 500ms
			assert parseXsDuration("P") is none && parseXsDuration("1H") is none && parseXsDuration("P1.5D") is none
			assert xsDuration(3600s) == "PT3600S"
		}

		@test()
		def TestArtifactFormat() !none {
			let art = try newArtifact("https://idp.example", 3)
			let (index, source) = try parseArtifact(art)
			assert index == 3 && source.len() == 20
			assert parseArtifact(encode("short")) is error
		}

		@test()
		def TestMetadata() !none {
			let t = try startSite()
			let sp = try addSp(t, "/sp")
			let entity = sp.metadata()
			let back = try parseMetadata(entity.xml())
			let role = back.sp
			fail "no sp role" when role is none
			assert role.assertionConsumers.len() == 2 && role.assertionConsumers[0].binding == Binding.Post
			let d = role.assertionConsumers[0].isDefault
			assert !(d is none) && d && role.authnRequestsSigned
			assert role.keys.len() == 2 && !(role.encryptionKey() is none) && role.signingKeys().len() == 1
			assert role.singleLogout.len() == 3
			// Signed metadata verifies with the right key only.
			let spKey = try pemKey(spKeyPem)
			let signed = try entity.xml(spKey, try pemDer(spCertPem))
			let checked = try parseMetadata(signed, [publicKeyOf(spKey)])
			assert checked.entityId == sp.entityId
			let idpPub = publicKeyOf(t.provider.key)
			assert parseMetadata(signed, [idpPub]) is error
			assert parseMetadata(entity.xml(), [publicKeyOf(spKey)]) is error
			assert parseMetadata(signed.replace("/sp/acs", "/evil/acs"), [publicKeyOf(spKey)]) is error
			// Expired metadata and DOCTYPEs are refused.
			let old = sp.metadata()
			old.validUntil = time.now() - 1h
			assert parseMetadata(old.xml()) is error
			assert parseMetadata("<!DOCTYPE x [<!ENTITY a \"b\">]>" + entity.xml()) is error
			// A set of two.
			let both = try writeMetadataSet([entity, t.provider.metadata()], name = "fed")
			let set = try parseMetadataSet(both)
			assert set.len() == 2 && !(set[1].idp is none)
			assert parseMetadata(both) is error
			let idp = set[1].idp
			assert !(idp is none) && idp.singleSignOn.len() == 2 && idp.artifactResolution.len() == 1
			// The served metadata is signed with the SP key.
			t.sp = sp
			let served = try t.api.get(t.url("/sp/metadata"))
			assert served.status == 200 && served.header("Content-Type").startsWith("application/samlmetadata+xml")
			assert (try parseMetadata(try served.text(), [publicKeyOf(spKey)])).entityId == sp.entityId
			// A removed service provider is unknown to the IdP.
			try t.provider.serviceProviders.remove(sp.entityId)
			assert (try t.provider.serviceProviders.serviceProvider(sp.entityId)) is none
			let refused = try t.api.get((try sp.login(Binding.Redirect)).url)
			assert refused.status == 400
		}

		@test()
		def TestRedirectLogin() !none {
			let t = try startSite()
			let sp = try addSp(t, "/sp")
			t.sp = sp
			let req = try sp.login(Binding.Redirect, "/app?x=1")
			assert req.url.contains("SigAlg=") && req.url.contains("Signature=") && req.url.contains("RelayState=")
			let page = try browse(t, req)
			let encoded = formField(page, "SAMLResponse")
			assert formField(page, "RelayState") == "/app?x=1"
			// The SP has an encryption key, so the assertion is encrypted.
			assert (try responseXml(encoded)).contains("EncryptedAssertion")
			let a = try sp.consume(encoded, req.id, "/app?x=1")
			assert a.issuer == t.provider.entityId && a.relayState == "/app?x=1"
			assert a.nameId.format == NameIdFormat.Persistent.value && a.nameId.value != "alice" && a.nameId.spNameQualifier == sp.entityId
			let mail = a.attributes.get("mail")
			assert !(mail is none) && mail == "alice@example.com"
			assert a.attributes.all("groups").len() == 2 && a.attributes.names().join(",") == "groups,mail"
			assert !(a.sessionIndex is none) && a.audiences.join("|") == sp.entityId
			let ctxRef = a.authnContext
			assert !(ctxRef is none) && ctxRef == passwordProtectedTransport
			// Persistent IDs are stable for the user at this SP.
			let (again, againId) = try issued(t, sp)
			let b = try sp.consume(again, againId)
			assert b.nameId.value == a.nameId.value
			// Replays, other requests and unsolicited use are refused.
			assert kindOf(sp, encoded, req.id) == "Replayed"
			let (third, _) = try issued(t, sp)
			assert kindOf(sp, third, "_other") == "InResponseToMismatch"
			assert kindOf(sp, third, none) == "InResponseToMismatch"
		}

		@test()
		def TestPostLoginAndAcsHandler() !none {
			let t = try startSite()
			t.provider.requireSignedRequests = true
			let sp = try addSp(t, "/sp")
			t.sp = sp
			let options = LoginOptions{forceAuthn: true, nameIdFormat: NameIdFormat.EmailAddress, authnContexts: [passwordProtectedTransport]}
			let req = try sp.login(Binding.Post, "rs", options)
			assert req.page.contains("SAMLRequest")
			let xml = string(try new Base64().decode(formField(req.page, "SAMLRequest")))
			assert xml.contains("<ds:Signature") && xml.contains("ForceAuthn=\"true\"")
			t.requestId = req.id
			let page = try browse(t, req)
			let form = new Values()
			form.set("SAMLResponse", formField(page, "SAMLResponse"))
			form.set("RelayState", formField(page, "RelayState"))
			let res = try t.api.postForm(t.url("/sp/acs"), form)
			assert res.status == 200
			// The login page an app serves: the form posting the request.
			let start = try t.api.get(t.url("/sp/start"))
			assert start.status == 200 && start.header("Cache-Control").contains("no-store") && (try start.text()).contains("name=\"SAMLRequest\"")
			let a = t.accepted
			assert !(a is none) && a.nameId.value == "alice" && a.nameId.format == NameIdFormat.EmailAddress.value && a.relayState == "rs"
		}

		@test()
		def TestUnsignedRequestRefused() !none {
			let t = try startSite()
			t.provider.requireSignedRequests = true
			let sp = try addSp(t, "/sp", false)
			let req = try sp.login(Binding.Redirect)
			assert !req.url.contains("Signature=")
			let res = try t.api.get(req.url)
			assert res.status == 400
			// A changed RelayState breaks the query signature.
			let signedSp = try addSp(t, "/sp")
			let signedReq = try signedSp.login(Binding.Redirect, "a")
			let tampered = try t.api.get(signedReq.url.replace("RelayState=a", "RelayState=b"))
			assert tampered.status == 400
		}

		@test()
		def TestArtifactLogin() !none {
			let t = try startSite()
			let sp = try addSp(t, "/sp")
			t.sp = sp
			let req = try sp.login(Binding.Redirect, "art", LoginOptions{responseBinding: Binding.Artifact})
			t.requestId = req.id
			let first = try t.api.get(req.url)
			assert first.status == 303
			let login = try t.api.get(first.header("Location"))
			assert login.status == 303
			let acs = login.header("Location")
			assert acs.contains("SAMLart=")
			let res = try t.api.get(acs)
			assert res.status == 200
			let a = t.accepted
			assert !(a is none) && a.relayState == "art" && !(a.attributes.get("mail") is none)
			// An artifact resolves once.
			t.accepted = none
			let again = try t.api.get(acs)
			assert again.status == 403 && t.accepted is none
		}

		@test()
		def TestDeniedAndPassive() !none {
			let t = try startSite()
			let sp = try addSp(t, "/sp")
			t.mode = "deny"
			let (denied, deniedId) = try issued(t, sp)
			let err = sp.consume(denied, deniedId) onerror (e error) {
				assert e is SamlError
				if e is SamlError {
					assert e.kind == SamlErrorKind.StatusNotSuccess && e.status.join("|") == StatusCode.Responder.value + "|" + StatusCode.AuthnFailed.value
				}
				recover new Assertion("", "", time.now(), new NameId(""), new XMLNode("x"))
			}
			assert err.id == ""
			t.mode = "allow"
			let req = try sp.login(Binding.Redirect, options = LoginOptions{isPassive: true})
			let page = try browse(t, req)
			assert kindOf(sp, formField(page, "SAMLResponse"), req.id) == "StatusNotSuccess"
			// An exact authentication context the login did not use.
			let strict = try sp.login(Binding.Redirect, options = LoginOptions{authnContexts: ["urn:oasis:names:tc:SAML:2.0:ac:classes:X509"]})
			let strictPage = try browse(t, strict)
			let refused = sp.consume(formField(strictPage, "SAMLResponse"), strict.id) onerror (e error) {
				if e is SamlError {
					assert e.status.join("|") == StatusCode.Responder.value + "|" + StatusCode.NoAuthnContext.value
				}
				recover new Assertion("", "", time.now(), new NameId(""), new XMLNode("x"))
			}
			assert refused.id == ""
		}

		@test()
		def TestEcdsaIdp() !none {
			let t = try startSite(try pemKey(ecKeyPem), try pemDer(ecCertPem))
			let sp = try addSp(t, "/sp")
			let (encoded, id) = try issued(t, sp)
			let a = try sp.consume(encoded, id)
			assert a.issuer == t.provider.entityId
		}

		@test()
		def TestAssertionChecks() !none {
			let (t, sp) = try plainSite()
			// Another SP's assertion: same ACS, other entity ID.
			let (encoded, id) = try issued(t, sp)
			let other = new ServiceProvider(t.url("/elsewhere"), sp.acsURL, sp.idp)
			assert kindOf(other, encoded, id) == "AudienceMismatch"
			// Another ACS.
			let moved = new ServiceProvider(sp.entityId, t.url("/moved"), sp.idp)
			assert kindOf(moved, encoded, id) == "DestinationMismatch"
			// Expired.
			t.provider.assertionLifetime = -5m
			let (old, oldId) = try issued(t, sp)
			assert kindOf(sp, old, oldId) == "Expired"
			t.provider.assertionLifetime = 5m
			// An IdP key the SP does not trust.
			let rogue = new ServiceProvider(sp.entityId, sp.acsURL, try parseMetadata(sp.idp.xml().replace(new Base64().encode(try pemDer(idpCertPem)), new Base64().encode(try pemDer(spCertPem)))))
			assert kindOf(rogue, encoded, id) == "BadSignature"
			// wantAssertionsSigned with a response-only signature.
			t.provider.signAssertions = false
			let (responseOnly, responseOnlyId) = try issued(t, sp)
			sp.wantAssertionsSigned = true
			assert kindOf(sp, responseOnly, responseOnlyId) == "Unsigned"
			sp.wantAssertionsSigned = false
			let ok = try sp.consume(responseOnly, responseOnlyId)
			assert ok.nameId.value != ""
		}

		@test()
		def TestTamperingAndUnsigned() !none {
			let (t, sp) = try plainSite()
			let (encoded, id) = try issued(t, sp)
			let xml = try responseXml(encoded)
			// A changed attribute value breaks the assertion's digest.
			assert kindOf(sp, encode(xml.replace("alice@example.com", "mallory@example.com")), id) == "BadSignature"
			// Stripping the signature leaves nothing signed.
			let (root, a) = try parts(xml)
			a.children = withoutChild(a, "Signature")
			assert kindOf(sp, encode(root.str()), id) == "Unsigned"
			// A DOCTYPE is refused before anything else.
			assert kindOf(sp, encode("<!DOCTYPE r [<!ENTITY e \"x\">]>" + xml), id) == "Malformed"
		}

		@test()
		def TestCommentInNameId() !none {
			// The comment-truncation attack: a comment inside the NameID does
			// not change the signed value, and the full text is read.
			let (t, sp) = try plainSite()
			t.provider.nameIdFormats = [NameIdFormat.Unspecified]
			let req = try sp.login(Binding.Redirect)
			let page = try browse(t, req)
			let xml = try responseXml(formField(page, "SAMLResponse"))
			let injected = xml.replace(">alice</saml:NameID>", ">ali<!-- injected -->ce</saml:NameID>")
			assert injected != xml
			let a = try sp.consume(encode(injected), req.id)
			assert a.nameId.value == "alice"
		}

		@test()
		def TestSignatureWrapping() !none {
			// XSW1-8 (Somorovsky et al., "On Breaking SAML"): an evil
			// assertion or response next to, around or inside the signed
			// original. Every variant is refused.
			let (t, sp) = try plainSite()
			t.provider.signResponses = true
			let (encoded, id) = try issued(t, sp)
			let xml = try responseXml(encoded)
			let attacks string[] = []
			// XSW1: an evil response whose Signature holds the original
			// response.
			let (r1, _) = try parts(xml)
			let original1 = try copyOf(r1)
			let sig1 = r1.child("Signature", xmlDsigNamespace)
			fail "no response signature" when sig1 is none
			r1.set("ID", "_evil")
			sig1.add(original1)
			attacks.push(r1.str())
			// XSW2: the original response as a sibling before the evil
			// one's signature.
			let (r2, _) = try parts(xml)
			let original2 = try copyOf(r2)
			r2.set("ID", "_evil")
			let reordered XMLNode[] = []
			for let c in r2.children {
				reordered.push(original2) when c.localName == "Signature"
				reordered.push(c)
			}
			r2.children = reordered
			attacks.push(r2.str())
			// Assertion-level variants work on the assertion signature.
			let (r3, _) = try parts(xml)
			r3.children = withoutChild(r3, "Signature")
			let base = r3.str()
			// XSW3: an evil assertion with the same ID before the original.
			let (r4, a4) = try parts(base)
			let evil4 = try copyOf(a4)
			evil4.children = withoutChild(evil4, "Signature")
			let kids4 XMLNode[] = []
			for let c in r4.children {
				kids4.push(evil4) when c == a4
				kids4.push(c)
			}
			r4.children = kids4
			attacks.push(r4.str())
			// XSW4: the original wrapped inside the evil assertion.
			let (r5, a5) = try parts(base)
			let evil5 = try copyOf(a5)
			evil5.set("ID", "_evil")
			evil5.children = withoutChild(evil5, "Signature")
			evil5.add(a5)
			r5.children = r5.children.filter(c => !(c == a5))
			r5.add(evil5)
			attacks.push(r5.str())
			// XSW5: the evil assertion keeps the signature; the original
			// copy, unsigned, goes after it.
			let (r6, a6) = try parts(base)
			let copy6 = try copyOf(a6)
			copy6.children = withoutChild(copy6, "Signature")
			a6.set("ID", "_evil")
			r6.add(copy6)
			attacks.push(r6.str())
			// XSW6: the original inside the evil assertion's Signature.
			let (r7, a7) = try parts(base)
			let copy7 = try copyOf(a7)
			let sig7 = a7.child("Signature", xmlDsigNamespace)
			fail "no assertion signature" when sig7 is none
			a7.set("ID", "_evil")
			sig7.add(copy7)
			attacks.push(r7.str())
			// XSW7: the original inside an Extensions element.
			let (r8, a8) = try parts(base)
			let copy8 = try copyOf(a8)
			a8.set("ID", "_evil")
			a8.children = withoutChild(a8, "Signature")
			let ext = new XMLNode("samlp:Extensions", samlpNS)
			ext.add(copy8)
			let kids8 XMLNode[] = []
			for let c in r8.children {
				kids8.push(c)
				kids8.push(ext) when c.localName == "Issuer"
			}
			r8.children = kids8
			attacks.push(r8.str())
			// XSW8: the original, without its signature, in an Object of
			// the evil assertion's signature.
			let (r9, a9) = try parts(base)
			let copy9 = try copyOf(a9)
			copy9.children = withoutChild(copy9, "Signature")
			let sig9 = a9.child("Signature", xmlDsigNamespace)
			fail "no assertion signature" when sig9 is none
			a9.set("ID", "_evil")
			sig9.add(new XMLNode("ds:Object", xmlDsigNamespace)).add(copy9)
			attacks.push(r9.str())
			for let (i, attack) in attacks {
				assert kindOf(sp, encode(attack), id) != "" onerror fail "XSW{i + 1} was accepted"
			}
			// A lone evil assertion whose signature points at an ID that is
			// not its own.
			let (r10, a10) = try parts(base)
			a10.set("ID", "_evil")
			assert kindOf(sp, encode(r10.str()), id) == "BadSignature"
			// The untouched response still passes.
			let a = try sp.consume(encoded, id)
			assert a.nameId.value != ""
		}

		@test()
		def TestSingleLogout() !none {
			let t = try startSite()
			let sp = try addSp(t, "/sp")
			let sp2 = try addSp(t, "/sp2")
			t.sp = sp
			t.sp2 = sp2
			let (encoded, id) = try issued(t, sp)
			let a = try sp.consume(encoded, id)
			let (encoded2, id2) = try issued(t, sp2)
			try sp2.consume(encoded2, id2)
			// SP-initiated: sp -> IdP -> sp2 -> IdP -> sp.
			let req = try sp.logout(a, Binding.Redirect, "bye")
			t.requestId = req.id
			let toIdp = try t.api.get(req.url)
			assert toIdp.status == 303
			let toSp2 = try t.api.get(toIdp.header("Location"))
			assert toSp2.status == 303
			let back = try t.api.get(toSp2.header("Location"))
			assert back.status == 303
			let done = try t.api.get(back.header("Location"))
			assert done.status == 200 && t.logoutError == ""
			assert t.appSessions.join("|") == "idp:s-1|sp2"
			assert t.logouts.len() == 2 && t.logouts[0].request && !t.logouts[1].request
			assert t.logouts[1].success && t.logouts[1].relayState == "bye"
			// The session is gone: a second logout is answered without
			// propagation.
			t.appSessions = []
			let again = try sp.logout(a, Binding.Post)
			assert again.page.contains("SAMLRequest")
		}

		@test()
		def TestIdpInitiatedLogoutOverSoap() !none {
			let t = try startSite()
			let sp = try addSp(t, "/sp")
			t.sp = sp
			// Only a SOAP Single Logout endpoint for this SP.
			let m = sp.metadata()
			let role = m.sp
			fail "no role" when role is none
			role.singleLogout = role.singleLogout.filter(e => e.binding == Binding.Soap)
			try t.provider.serviceProviders.save(m)
			let (encoded, id) = try issued(t, sp)
			try sp.consume(encoded, id)
			let mux = new ServeMux()
			let res = try t.api.get(t.url("/idp/metadata"))
			assert res.status == 200 && (try res.text()).contains("IDPSSODescriptor")
			// The app starts the logout of session s-1.
			let probe = new httptest.Server(mux)
			try mux.handle("/out", def (ctx Context) !none {
				return try t.provider.logout(ctx, "s-1", "https://app.example/bye")
			})
			try probe.start()
			let out = try t.api.get(probe.url + "/out")
			assert out.status == 303 && out.header("Location") == "https://app.example/bye"
			assert t.appSessions.join("|") == "sp" && t.logouts.len() == 1 && t.logouts[0].request
		}

		@test()
		def TestUnsolicited() !none {
			let (t, sp) = try plainSite()
			let mux = new ServeMux()
			try mux.handle("/go", def (ctx Context) !none {
				return try t.provider.unsolicited(ctx, sp.entityId, Decision{nameId: "bob"}, "/home")
			})
			let probe = new httptest.Server(mux)
			try probe.start()
			let page = try (try t.api.get(probe.url + "/go")).text()
			let encoded = formField(page, "SAMLResponse")
			assert kindOf(sp, encoded, none) == "InResponseToMismatch"
			sp.allowUnsolicited = true
			let a = try sp.consume(encoded, none, formField(page, "RelayState"))
			assert a.relayState == "/home" && a.inResponseTo is none
		}
	}
}
