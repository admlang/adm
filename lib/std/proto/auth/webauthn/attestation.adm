partial module std.proto.auth.webauthn {
	use (
		std.crypto
		std.crypto.x509
		std.crypto.x509::(Certificate, CertPool, VerifyOptions, ExtKeyUsage)
		std.data.encoding::(CBORValue, CBORKind)
		std.time
		std.time::(Time)
		std.proto.auth.webauthn.formats::*
	)

	// AttestationResult is what an attestation statement established about
	// the authenticator that made a credential.
	type AttestationResult {
		// The statement format: "none", "packed", "tpm", "android-key",
		// "android-safetynet", "fido-u2f", "apple" or "compound".
		format string

		kind AttestationType = AttestationType.None

		// The attestation certificate chain, leaf first; empty for None and
		// Self.
		chain Certificate[]

		// Whether the chain was verified against trusted roots.
		trusted bool

		// For "compound", the result of each statement inside it.
		parts AttestationResult[]

		def new() {}
	}

	// Verifies an attestation statement (WebAuthn §8) over authenticator
	// data and the client data hash, then, when roots are given and the
	// statement carries a chain, verifies the chain against them at the
	// instant. Fails when the format is unknown, the statement is
	// malformed, a signature or binding does not verify, a certificate
	// breaks its format's rules, or the chain does not reach the roots.
	def verifyAttestation(format string, statement CBORValue, authData AuthenticatorData, clientDataHash byte[], roots ?CertPool, at Time) !AttestationResult {
		let r = new AttestationResult()
		r.format = format
		match format {
			case "none":
				fail "webauthn: a none attestation statement must be empty" when statement.kind != CBORKind.Map || statement.len() != 0
				return r
			case "packed":
				try verifyPacked(statement, authData, clientDataHash, r)
			case "fido-u2f":
				try verifyU2F(statement, authData, clientDataHash, r)
			case "apple":
				try verifyApple(statement, authData, clientDataHash, r)
			case "android-key":
				try verifyAndroidKey(statement, authData, clientDataHash, r)
			case "android-safetynet":
				try verifySafetyNet(statement, authData, clientDataHash, r, at)
			case "tpm":
				try verifyTPM(statement, authData, clientDataHash, r)
			case "compound":
				fail "webauthn: a compound attestation statement must be an array of two or more" when statement.kind != CBORKind.Array || statement.len() < 2
				for let (_, part) in statement.elements() {
					let fmt = try part.get("fmt").asString()
					fail "webauthn: a compound attestation cannot nest compound" when fmt == "compound"
					r.parts.push(try verifyAttestation(fmt, part.get("attStmt"), authData, clientDataHash, roots, at))
				}
				r.kind = r.parts[0].kind
				r.trusted = true
				for let (_, p) in r.parts {
					r.trusted = r.trusted && p.trusted
				}
				return r
			default:
				fail "webauthn: unknown attestation format \"{format}\""
		}
		if r.chain.len() > 0 && !(roots is none) {
			let intermediates = new CertPool()
			for let i = 1; i < r.chain.len(); i++ {
				intermediates.addCert(r.chain[i])
			}
			try r.chain[0].verify(VerifyOptions{intermediates: intermediates, roots: roots, currentTime: at, keyUsages: [ExtKeyUsage.Any]})
			r.trusted = true
		}
		return r
	}
}
