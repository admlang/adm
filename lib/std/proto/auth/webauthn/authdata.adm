partial module std.proto.auth.webauthn {
	use (
		std.data.encoding::(CBOR, CBORValue, CBORKind, CBORReader, CBORKeyOrder)
	)

	// The flag bits of authenticator data (WebAuthn §6.1).
	enum AuthFlag {
		// The user was present (touched the key).
		UserPresent = 0x01,
		// The user was verified (PIN, biometric).
		UserVerified = 0x04,
		// The credential can be backed up.
		BackupEligible = 0x08,
		// The credential is backed up.
		BackedUp = 0x10,
		// Attested credential data follows the counter.
		AttestedData = 0x40,
		// Extension outputs follow.
		Extensions = 0x80
	}

	// AuthenticatorData is what an authenticator signs over in every
	// ceremony (WebAuthn §6.1): the hash of the relying party id, flags, a
	// signature counter and, at registration, the new credential.
	type AuthenticatorData {
		// SHA-256 of the relying party id the credential is scoped to.
		rpIdHash byte[]

		// The AuthFlag bits.
		flags int

		// The signature counter; 0 when the authenticator keeps none.
		signCount uint32

		// The authenticator model, 16 bytes; set with attested data.
		aaguid byte[]

		// The credential id; set with attested data.
		credentialId byte[]

		// The credential public key; set with attested data.
		credentialKey COSEKey = new COSEKey()

		// The authenticator extension outputs, a CBOR map; null when absent.
		extensions CBORValue = new CBORValue()

		// The bytes as received; what signatures cover.
		raw byte[]

		def new() {}

		// Reports whether a flag is set.
		def has(flag AuthFlag) bool {
			return (flags & flag.value) != 0
		}

		// Sets or clears a flag.
		def set(flag AuthFlag, on bool) {
			flags = on ?? (flags | flag.value, flags & (0xFF ^ flag.value))
		}

		// The encoding: raw when parsed, else built from the fields with the
		// AttestedData and Extensions flags following what is present. Fails
		// when the credential key does not encode.
		def encode() !byte[] {
			return raw when raw.len() > 0
			let hasCred = credentialId.len() > 0
			let hasExt = extensions.kind == CBORKind.Map
			set(AuthFlag.AttestedData, hasCred)
			set(AuthFlag.Extensions, hasExt)
			let out byte[]
			out.push(...rpIdHash)
			out.push(byte(flags))
			out.push(byte(signCount >> 24), byte((signCount >> 16) & 0xFF), byte((signCount >> 8) & 0xFF), byte(signCount & 0xFF))
			if hasCred {
				let id byte[]
				id.len(16)
				id = aaguid when aaguid.len() == 16
				out.push(...id)
				out.push(byte(credentialId.len() >> 8), byte(credentialId.len() & 0xFF))
				out.push(...credentialId)
				out.push(...(try credentialKey.encode()))
			}
			if hasExt {
				let c = new CBOR()
				c.keyOrder = CBORKeyOrder.LengthFirst
				out.push(...c.encode(extensions))
			}
			return out
		}
	}

	// Reads authenticator data. Fails when it is shorter than 37 bytes, the
	// AttestedData flag is set without a credential that parses, the
	// Extensions flag is set without a CBOR map, or bytes are left over.
	def parseAuthenticatorData(data byte[]) !AuthenticatorData {
		expects {
			assert data.len() >= 37 onerror fail "webauthn: authenticator data is {data.len()} bytes, below 37"
		}
		let a = new AuthenticatorData()
		a.raw = data
		a.rpIdHash = data.slice(0, 32).clone()
		a.flags = int(data[32])
		a.signCount = uint32(data[33]) << 24 | uint32(data[34]) << 16 | uint32(data[35]) << 8 | uint32(data[36])
		let at = 37
		if a.has(AuthFlag.AttestedData) {
			fail "webauthn: attested credential data is truncated" when data.len() < at + 18
			a.aaguid = data.slice(at, 16).clone()
			let n = int(data[at + 16]) << 8 | int(data[at + 17])
			at += 18
			fail "webauthn: credential id runs past the authenticator data" when at + n > data.len()
			a.credentialId = data.slice(at, n).clone()
			at += n
			let r = new CBORReader(data)
			r.pos = at
			try r.next()
			a.credentialKey = try parseCOSEKey(data.slice(at, r.pos - at).clone())
			at = r.pos
		}
		if a.has(AuthFlag.Extensions) {
			let r = new CBORReader(data)
			r.pos = at
			a.extensions = try r.next()
			fail "webauthn: extensions are not a CBOR map" when a.extensions.kind != CBORKind.Map
			at = r.pos
		}
		fail "webauthn: {data.len() - at} bytes left over after authenticator data" when at != data.len()
		return a
	}
}
