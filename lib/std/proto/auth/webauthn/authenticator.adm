partial module std.proto.auth.webauthn {
	use (
		std.errors
		std.data.encoding::(CBOR, CBORValue, CBORKind)
		std.proto.auth.webauthn.ctap::*
	)

	// CTAP status codes (CTAP 2.2 §8.2) an authenticator answers with.
	enum CTAPStatus {
		Ok = 0x00,
		InvalidCommand = 0x01,
		InvalidParameter = 0x02,
		InvalidLength = 0x03,
		InvalidSeq = 0x04,
		Timeout = 0x05,
		ChannelBusy = 0x06,
		LockRequired = 0x0A,
		InvalidChannel = 0x0B,
		CBORUnexpectedType = 0x11,
		InvalidCBOR = 0x12,
		MissingParameter = 0x14,
		LimitExceeded = 0x15,
		FingerprintDatabaseFull = 0x17,
		LargeBlobStorageFull = 0x18,
		CredentialExcluded = 0x19,
		Processing = 0x21,
		InvalidCredential = 0x22,
		UserActionPending = 0x23,
		OperationPending = 0x24,
		NoOperations = 0x25,
		UnsupportedAlgorithm = 0x26,
		OperationDenied = 0x27,
		KeyStoreFull = 0x28,
		UnsupportedOption = 0x2B,
		InvalidOption = 0x2C,
		KeepaliveCancel = 0x2D,
		NoCredentials = 0x2E,
		UserActionTimeout = 0x2F,
		NotAllowed = 0x30,
		PINInvalid = 0x31,
		PINBlocked = 0x32,
		PINAuthInvalid = 0x33,
		PINAuthBlocked = 0x34,
		PINNotSet = 0x35,
		PUATRequired = 0x36,
		PINPolicyViolation = 0x37,
		RequestTooLarge = 0x39,
		ActionTimeout = 0x3A,
		UPRequired = 0x3B,
		UVBlocked = 0x3C,
		IntegrityFailure = 0x3D,
		InvalidSubcommand = 0x3E,
		UVInvalid = 0x3F,
		UnauthorizedPermission = 0x40,
		Other = 0x7F
	}

	// CTAPError is an authenticator's refusal: the CTAP status it answered
	// with.
	struct CTAPError {
		message string
		// The status name, such as "NoCredentials".
		code    string
		cause   ?error
		stack   errors.StackTrace

		status CTAPStatus
	}

	// The relying party a credential is for.
	struct RelyingPartyEntity {
		id   string
		name string
	}

	// MakeCredentialRequest is the authenticatorMakeCredential command
	// (CTAP 2.2 §6.1) without its PIN/UV auth parameters, which the
	// transport adds.
	type MakeCredentialRequest {
		// SHA-256 of the client data.
		clientDataHash byte[]

		rp   RelyingPartyEntity = RelyingPartyEntity{}
		user User               = User{}

		// The acceptable algorithms, most preferred first.
		algorithms COSEAlgorithm[]

		// Credentials the authenticator must not already hold for the user.
		exclude CredentialDescriptor[]

		// Store the credential on the authenticator (discoverable).
		residentKey bool

		// Verify the user (the `uv` option).
		userVerification bool

		// Authenticator extension inputs beyond the ones below, a CBOR map;
		// null for none.
		extensions CBORValue = new CBORValue()

		// credProtect: 1 user verification optional, 2 optional with a
		// credential id list, 3 required; 0 to leave it unset.
		credProtect int

		// Ask for an hmac-secret credential (the WebAuthn prf extension).
		hmacSecret bool

		// Ask for a large-blob key (largeBlobKey).
		largeBlobKey bool

		// A small blob to store with the credential (credBlob); empty for none.
		credBlob byte[]

		// Ask for the minimum PIN length in the authenticator data
		// (minPinLength).
		minPinLength bool

		// Attestation formats preferred, most preferred first.
		attestationFormats string[]

		// Ask for enterprise attestation: 0 for none, 1 or 2 (CTAP 2.2 §7.1).
		enterpriseAttestation int

		def new() {}
	}

	// MakeCredentialResult is the authenticator's answer to
	// authenticatorMakeCredential: an attestation object's parts.
	type MakeCredentialResult {
		format    string
		authData  byte[]
		statement CBORValue = new CBORValue()

		// Whether an enterprise attestation was returned.
		enterpriseAttestation bool

		// The credential's large-blob key, when the largeBlobKey extension
		// asked for it.
		largeBlobKey byte[]

		def new() {}

		// The CBOR attestation object `{fmt, authData, attStmt}`.
		def attestationObject() byte[] {
			let m = new CBORValue(CBORKind.Map)
			m.set("fmt", new CBORValue(format))
			m.set("attStmt", statement)
			m.set("authData", new CBORValue(authData))
			return new CBOR().encode(m)
		}
	}

	// GetAssertionRequest is the authenticatorGetAssertion command (CTAP
	// 2.2 §6.2) without its PIN/UV auth parameters.
	type GetAssertionRequest {
		rpId string

		// SHA-256 of the client data.
		clientDataHash byte[]

		// The credentials that may answer; empty for discoverable ones.
		allow CredentialDescriptor[]

		// Test user presence (the `up` option).
		userPresence bool = true

		// Verify the user (the `uv` option).
		userVerification bool

		// Authenticator extension inputs beyond the ones below, a CBOR map;
		// null for none.
		extensions CBORValue = new CBORValue()

		// One or two 32-byte salts to evaluate with each credential's
		// hmac-secret; empty for none.
		hmacSalts byte[]

		// Ask for each credential's credBlob.
		getCredBlob bool

		// Ask for each credential's large-blob key.
		largeBlobKey bool

		def new() {}
	}

	// GetAssertionResult is one assertion an authenticator returned.
	type GetAssertionResult {
		credentialId byte[]
		authData     byte[]
		signature    byte[]

		// The user of a discoverable credential; an empty id otherwise.
		user User = User{}

		// Whether the user picked this credential on the authenticator.
		userSelected bool

		// The hmac-secret outputs for the salts asked for, 32 bytes each;
		// empty when not asked for or the credential has no hmac-secret.
		hmacSecret byte[]

		// The credBlob stored with the credential, when asked for.
		credBlob byte[]

		// The credential's large-blob key, when the largeBlobKey extension
		// asked for it.
		largeBlobKey byte[]

		def new() {}
	}

	// AuthenticatorInfo is what authenticatorGetInfo reports (CTAP 2.2 §6.4).
	type AuthenticatorInfo {
		// Protocol versions: "FIDO_2_0", "FIDO_2_1", "FIDO_2_2", "U2F_V2".
		versions   string[]
		extensions string[]
		aaguid     byte[]

		// The options and whether each is on: "rk", "up", "uv",
		// "clientPin", "plat", "pinUvAuthToken", "credMgmt", "ep", …
		options map<string, bool>

		maxMsgSize         int
		pinUvAuthProtocols int[]

		// How many credentials an allow or exclude list may hold, and how
		// long an id may be; 0 when not stated.
		maxCredentialCount    int
		maxCredentialIdLength int

		algorithms COSEAlgorithm[]
		transports string[]

		// The largest serialized large-blob array it stores; 0 without
		// large blobs.
		maxLargeBlobArray int

		// Whether the PIN must be changed before it is used again.
		forcePINChange bool

		// The shortest PIN it accepts.
		minPINLength int = 4

		firmwareVersion   int
		maxCredBlobLength int

		// How many more discoverable credentials fit; -1 when not stated.
		remainingDiscoverableCredentials int = -1

		// The attestation statement formats it can produce.
		attestationFormats string[]

		def new() {}

		// Reports whether it speaks CTAP2 (any FIDO_2_x version).
		def ctap2() bool {
			for let (_, v) in versions {
				return true when v.startsWith("FIDO_2_")
			}
			return false
		}

		// Reports whether an option is present and on.
		def option(name string) bool {
			return options.hasKey(name) && options[name]
		}
	}

	// Authenticator is a FIDO2 authenticator: a security key reached over
	// CTAP, or one implemented in software.
	interface Authenticator {
		// Creates a credential. Fails with a CTAPError when the
		// authenticator refuses, such as CredentialExcluded,
		// UnsupportedAlgorithm or OperationDenied.
		def makeCredential(request MakeCredentialRequest) !MakeCredentialResult

		// Signs with every credential that matches, most recent first.
		// Fails with a CTAPError, NoCredentials when none matches.
		def getAssertion(request GetAssertionRequest) !GetAssertionResult[]

		// What the authenticator supports.
		def info() !AuthenticatorInfo

		// The large blob stored for the credential whose large-blob key is
		// given; none when it has none. Fails when the authenticator has no
		// large-blob storage or its array is corrupt.
		def largeBlob(key byte[]) !?byte[]

		// Stores a credential's large blob, replacing the one it had. Fails
		// when the authenticator has no large-blob storage or no room.
		def storeLargeBlob(key byte[], data byte[]) !none
	}
}
