partial module std.proto.auth.webauthn {
	use (
		std.data.encoding::(JSON, json)
		std.proto.auth.webauthn.json::*
		std.proto.auth.webauthn.formats::*
	)

	// ClientData is the collected client data of a ceremony (WebAuthn
	// §5.8.1): what the client saw, serialized to JSON and hashed into
	// every signature.
	type ClientData {
		// "webauthn.create" or "webauthn.get".
		@json("type")
		kind string

		// The challenge, base64url without padding.
		challenge string

		// The origin of the page that called WebAuthn.
		origin string

		// Whether the call came from a frame of another origin than the top
		// level page.
		crossOrigin bool

		// The top level origin when crossOrigin is set.
		@json(omitempty = true)
		topOrigin string

		def new() {}

		def new(kind string, challenge byte[], origin string, crossOrigin bool = false, topOrigin string = "") {
			self.kind = kind
			self.challenge = base64url(challenge)
			self.origin = origin
			self.crossOrigin = crossOrigin
			self.topOrigin = topOrigin
		}

		// The JSON serialization of §5.8.1.1, the form clients produce: the
		// members in order, crossOrigin always, topOrigin only when set.
		def json() string {
			let out = "\{\"type\":" + ccdString(kind) + ",\"challenge\":" + ccdString(challenge) + ",\"origin\":" + ccdString(origin)
			out += ",\"crossOrigin\":" + (crossOrigin ?? ("true", "false"))
			out += ",\"topOrigin\":" + ccdString(topOrigin) when topOrigin != ""
			return out + "\}"
		}
	}

	// Reads collected client data. Fails when it is not UTF-8 JSON holding
	// string type, challenge and origin members.
	def parseClientData(data byte[]) !ClientData {
		let text = string(data)
		fail "webauthn: client data is not UTF-8" when !text.isUTF8() || text.bytes().len() != data.len()
		let c = new ClientData()
		try new JSON().decode(text, c)
		fail "webauthn: client data has no type" when c.kind == ""
		fail "webauthn: client data has no challenge" when c.challenge == ""
		fail "webauthn: client data has no origin" when c.origin == ""
		return c
	}
}
