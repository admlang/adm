// Web Authentication (W3C WebAuthn Level 3) and the FIDO2 protocols under
// it: a relying party that registers and checks passkeys and security keys,
// a client that plays the browser's part, a software authenticator, and a
// CTAP2/U2F client for security keys on USB.
//
//     let rp = new webauthn.RelyingParty("example.com", "Example", "https://example.com")
//     let options = try rp.beginRegistration(user)
//     // send options.json() to the browser, keep options
//     let credential = try rp.finishRegistration(options, responseJSON)
partial module std.proto.auth.webauthn {
	use (
		std.crypto
		std.crypto::(PublicKey, RSAPublicKey, ECDSAPublicKey)
		std.data.encoding::(CBOR, CBORValue, CBORKind, CBORKeyOrder)
		std.proto.auth.webauthn.cose::*
	)

	// A COSE signature algorithm (IANA COSE Algorithms registry), the
	// numbers WebAuthn uses in `pubKeyCredParams` and credential keys.
	enum COSEAlgorithm {
		// ECDSA over P-256 with SHA-256.
		ES256 = -7,
		// EdDSA: Ed25519 or Ed448, by the COSE key's curve.
		EdDSA = -8,
		// Ed25519, fully specified (RFC 9864).
		Ed25519 = -19,
		// Ed448, fully specified (RFC 9864).
		Ed448 = -53,
		// ECDSA over P-384 with SHA-384.
		ES384 = -35,
		// ECDSA over P-521 with SHA-512.
		ES512 = -36,
		// RSASSA-PSS with SHA-256, SHA-384, SHA-512.
		PS256 = -37,
		PS384 = -38,
		PS512 = -39,
		// RSASSA-PKCS1-v1_5 with SHA-256, SHA-384, SHA-512.
		RS256 = -257,
		RS384 = -258,
		RS512 = -259,
		// RSASSA-PKCS1-v1_5 with SHA-1: TPM attestation only.
		RS1 = -65535
	}

	// The algorithm a COSE number names; none for one not supported here.
	def coseAlgorithm(number int) ?COSEAlgorithm {
		match number {
			case - 7:
				return COSEAlgorithm.ES256
			case - 8:
				return COSEAlgorithm.EdDSA
			case - 19:
				return COSEAlgorithm.Ed25519
			case - 53:
				return COSEAlgorithm.Ed448
			case - 35:
				return COSEAlgorithm.ES384
			case - 36:
				return COSEAlgorithm.ES512
			case - 37:
				return COSEAlgorithm.PS256
			case - 38:
				return COSEAlgorithm.PS384
			case - 39:
				return COSEAlgorithm.PS512
			case - 257:
				return COSEAlgorithm.RS256
			case - 258:
				return COSEAlgorithm.RS384
			case - 259:
				return COSEAlgorithm.RS512
			case - 65535:
				return COSEAlgorithm.RS1
			default:
				return none
		}
	}

	// A credential public key in COSE_Key form (RFC 9052 §7, RFC 9053),
	// the form authenticators hand a relying party: an EC2 key on P-256,
	// P-384 or P-521, an OKP key on Ed25519 or Ed448, or an RSA key.
	type COSEKey {
		// The algorithm the key signs with.
		algorithm COSEAlgorithm = COSEAlgorithm.ES256

		// The key itself.
		key PublicKey

		// The key's CBOR encoding: exactly what the authenticator sent when
		// parsed, the canonical CTAP2 form when built.
		raw byte[]

		def new() {}

		// The COSE form of a public key for an algorithm; encode reports a key
		// that does not suit it.
		def new(key PublicKey, algorithm COSEAlgorithm) {
			self.key = key
			self.algorithm = algorithm
		}

		// The key's encoding: raw when it was parsed, else the canonical
		// CTAP2 encoding of key and algorithm. Fails when the key does not
		// suit the algorithm or its curve has no COSE number.
		def encode() !byte[] {
			return raw when raw.len() > 0
			let c = new CBOR()
			c.keyOrder = CBORKeyOrder.LengthFirst
			return c.encode(try coseKeyMap(key, algorithm))
		}

		// Checks a signature over data the way WebAuthn signs: ECDSA as a
		// DER ECDSA-Sig-Value, EdDSA as the 64 raw bytes, RSA as PKCS #1
		// v1.5 or PSS by the algorithm. False for a bad signature or a key
		// that does not suit the algorithm.
		def verify(data byte[], signature byte[]) bool {
			return coseVerify(algorithm, key, data, signature)
		}
	}

	// Reads a COSE_Key. Fails when it is not a map, names an algorithm,
	// key type or curve not supported here, holds coordinates of the wrong
	// size or a point off its curve, or pairs an algorithm with the wrong
	// key type.
	def parseCOSEKey(data byte[]) !COSEKey {
		let k = try parseCOSEKey(try new CBOR().parse(data))
		k.raw = data
		return k
	}

	// Reads a COSE_Key already parsed from CBOR. Fails as parseCOSEKey(byte[]) does.
	def parseCOSEKey(item CBORValue) !COSEKey {
		expects {
			assert item.kind == CBORKind.Map onerror fail "webauthn: COSE key is not a map"
		}
		let kty = try item.get(1).asInt()
		let algNumber = try item.get(3).asInt()
		let alg = coseAlgorithm(algNumber)
		fail "webauthn: COSE algorithm {algNumber} is not supported" when alg is none
		let out = new COSEKey()
		out.algorithm = alg
		match kty {
			case 2:
				let crv = try item.get(-1).asInt()
				let c = crypto.p256
				match crv {
					case 1:
						c = crypto.p256
					case 2:
						c = crypto.p384
					case 3:
						c = crypto.p521
					default:
						fail "webauthn: EC2 curve {crv} is not supported"
				}
				let want = crv == 1 ?? (COSEAlgorithm.ES256, crv == 2 ?? (COSEAlgorithm.ES384, COSEAlgorithm.ES512))
				fail "webauthn: algorithm {alg} does not suit an EC2 key on {c.name}" when alg != want && !(alg == COSEAlgorithm.ES256 && crv == 1)
				let size = crypto.coordinateSize(c)
				let x = try item.get(-2).asBytes()
				let y = try item.get(-3).asBytes()
				fail "webauthn: EC2 coordinates must be {size} bytes" when x.len() != size || y.len() != size
				let point = try crypto.unmarshalPoint(c, byte[4] + x + y)
				out.key = new ECDSAPublicKey(c, point)
			case 1:
				let crv = try item.get(-1).asInt()
				match crv {
					case 6:
						fail "webauthn: algorithm {alg} does not suit an Ed25519 key" when !(alg := COSEAlgorithm.EdDSA || COSEAlgorithm.Ed25519)
						out.key = try crypto.newEd25519PublicKey(try item.get(-2).asBytes())
					case 7:
						fail "webauthn: algorithm {alg} does not suit an Ed448 key" when !(alg := COSEAlgorithm.EdDSA || COSEAlgorithm.Ed448)
						out.key = try crypto.newEd448PublicKey(try item.get(-2).asBytes())
					default:
						fail "webauthn: OKP curve {crv} is not supported"
				}
			case 3:
				fail "webauthn: algorithm {alg} does not suit an RSA key" when !(alg := COSEAlgorithm.RS256 || COSEAlgorithm.RS384 || COSEAlgorithm.RS512 || COSEAlgorithm.PS256 || COSEAlgorithm.PS384 || COSEAlgorithm.PS512 || COSEAlgorithm.RS1)
				let n = try item.get(-1).asBytes()
				let e = try item.get(-2).asBytes()
				fail "webauthn: RSA exponent of {e.len()} bytes is not supported" when e.len() == 0 || e.len() > 4
				let ev = 0
				for let (_, b) in e {
					ev = ev << 8 | int(b)
				}
				out.key = new RSAPublicKey(parseBigInt(n), ev)
			default:
				fail "webauthn: COSE key type {kty} is not supported"
		}
		return out
	}
}
