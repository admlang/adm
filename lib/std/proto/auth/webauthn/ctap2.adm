partial module std.proto.auth.webauthn {
	use (
		std.data.encoding::(CBOR, CBORValue, CBORKind, CBORKeyOrder)
		std.time
		std.proto.auth.webauthn.ctap::*
	)

	// CTAP2 authenticator commands (CTAP 2.2 §6).
	enum CTAPCommand {
		MakeCredential = 0x01,
		GetAssertion = 0x02,
		GetInfo = 0x04,
		ClientPIN = 0x06,
		Reset = 0x07,
		GetNextAssertion = 0x08,
		BioEnrollment = 0x09,
		CredentialManagement = 0x0A,
		Selection = 0x0B,
		LargeBlobs = 0x0C,
		Config = 0x0D,
		// The CTAP 2.1 preview numbers of bio enrollment and credential
		// management, which FIDO_2_1_PRE authenticators answer to.
		BioEnrollmentPreview = 0x40,
		CredentialManagementPreview = 0x41
	}

	// SecurityKey drives a FIDO2 authenticator over CTAP2 (CTAP 2.2), or
	// over CTAP1/U2F when the authenticator speaks nothing else,
	// implementing Authenticator. It obtains PIN/UV auth tokens as an
	// operation needs them: from the authenticator's own user verification
	// when it has one, else from `pin`.
	//
	//     let devices = try securityKeys()
	//     let hid = new HIDTransport()
	//     try hid.open(devices[0])
	//     let key = new SecurityKey(hid)
	//     key.pin = "1234"
	//     let client = new Client("https://example.com", key)
	partial type SecurityKey {
		transport CTAPTransport

		// The PIN, when the authenticator has one set and an operation
		// needs it; empty otherwise.
		pin Secret<string> = ""

		internal cached ?AuthenticatorInfo = none

		def new(transport CTAPTransport) {
			self.transport = transport
		}

		// What the authenticator reports (authenticatorGetInfo), read once.
		// A U2F-only authenticator reports versions ["U2F_V2"]. Fails when
		// the authenticator does not answer.
		def info() !AuthenticatorInfo {
			let have = cached
			return have unless have is none
			let i = new AuthenticatorInfo()
			if (transport.capabilities() & CTAPHIDCapability.CBOR.value) == 0 {
				i.versions = ["U2F_V2"]
				i.algorithms = [COSEAlgorithm.ES256]
				i.aaguid.len(16)
				i.transports = ["usb"]
				cached = i
				return i
			}
			let m = try command(CTAPCommand.GetInfo, none)
			for let (_, v) in m.get(1).elements() {
				i.versions.push(try v.asString())
			}
			for let (_, v) in m.get(2).elements() {
				i.extensions.push(try v.asString())
			}
			i.aaguid = m.get(3).asBytes() onerror recover byte[]
			for let (_, entry) in m.get(4).entries() {
				let (k, v) = entry
				i.options[try k.asString()] = try v.asBool()
			}
			i.maxMsgSize = m.has(5) ?? (try m.get(5).asInt(), 1024)
			for let (_, v) in m.get(6).elements() {
				i.pinUvAuthProtocols.push(try v.asInt())
			}
			i.maxCredentialCount = m.has(7) ?? (try m.get(7).asInt(), 0)
			i.maxCredentialIdLength = m.has(8) ?? (try m.get(8).asInt(), 0)
			for let (_, v) in m.get(9).elements() {
				i.transports.push(try v.asString())
			}
			for let (_, v) in m.get(10).elements() {
				let alg = coseAlgorithm(v.get("alg").asInt() onerror recover 0)
				i.algorithms.push(alg) unless alg is none
			}
			i.algorithms = [COSEAlgorithm.ES256] when !m.has(10)
			i.maxLargeBlobArray = m.has(11) ?? (try m.get(11).asInt(), 0)
			i.forcePINChange = m.has(12) && (try m.get(12).asBool())
			i.minPINLength = m.has(13) ?? (try m.get(13).asInt(), 4)
			i.firmwareVersion = m.has(14) ?? (try m.get(14).asInt(), 0)
			i.maxCredBlobLength = m.has(15) ?? (try m.get(15).asInt(), 0)
			i.remainingDiscoverableCredentials = m.has(20) ?? (try m.get(20).asInt(), -1)
			for let (_, v) in m.get(22).elements() {
				i.attestationFormats.push(try v.asString())
			}
			cached = i
			return i
		}

		// Creates a credential, implementing Authenticator: over CTAP2 with a
		// PIN/UV auth token when the authenticator needs one, else over U2F.
		// Fails with a CTAPError the authenticator answers with, PUATRequired
		// when it needs a PIN that is not set, or UnsupportedAlgorithm when a
		// U2F authenticator is asked for anything but ES256.
		def makeCredential(request MakeCredentialRequest) !MakeCredentialResult {
			let i = try info()
			return try u2fRegister(request) when !i.ctap2()
			let p = new CBORValue(CBORKind.Map)
			p.set(1, new CBORValue(request.clientDataHash))
			let rp = new CBORValue(CBORKind.Map)
			rp.set("id", new CBORValue(request.rp.id))
			rp.set("name", new CBORValue(request.rp.name)) when request.rp.name != ""
			p.set(2, rp)
			p.set(3, ctapUser(request.user))
			let params = new CBORValue(CBORKind.Array)
			for let (_, alg) in request.algorithms {
				let entry = new CBORValue(CBORKind.Map)
				entry.set("alg", new CBORValue(alg.value))
				entry.set("type", new CBORValue("public-key"))
				params.push(entry)
			}
			p.set(4, params)
			let exclude = try usableCredentials(request.rp.id, request.exclude, i)
			p.set(5, ctapDescriptors(exclude)) when exclude.len() > 0
			let ext = request.extensions.kind == CBORKind.Map ?? (request.extensions, new CBORValue(CBORKind.Map))
			ext.set("credProtect", new CBORValue(request.credProtect)) when request.credProtect > 0
			ext.set("hmac-secret", new CBORValue(true)) when request.hmacSecret
			ext.set("largeBlobKey", new CBORValue(true)) when request.largeBlobKey
			ext.set("credBlob", new CBORValue(request.credBlob)) when request.credBlob.len() > 0
			ext.set("minPinLength", new CBORValue(true)) when request.minPinLength
			p.set(6, ext) when ext.len() > 0
			let needed = i.option("alwaysUv") || (i.option("clientPin") && (request.residentKey || !i.option("makeCredUvNotRqd")))
			let (token, protocol, optionUV) = try verification(PinPermission.MakeCredential, request.rp.id, request.userVerification, needed, i)
			let options = new CBORValue(CBORKind.Map)
			options.set("rk", new CBORValue(true)) when request.residentKey
			options.set("uv", new CBORValue(true)) when optionUV
			p.set(7, options) when options.len() > 0
			if token.len() > 0 {
				p.set(8, new CBORValue(protocol.authenticate(token, request.clientDataHash)))
				p.set(9, new CBORValue(protocol.version))
			}
			p.set(10, new CBORValue(request.enterpriseAttestation)) when request.enterpriseAttestation > 0
			if request.attestationFormats.len() > 0 {
				let formats = new CBORValue(CBORKind.Array)
				for let (_, f) in request.attestationFormats {
					formats.push(new CBORValue(f))
				}
				p.set(11, formats)
			}
			let m = try command(CTAPCommand.MakeCredential, p)
			let r = new MakeCredentialResult()
			r.format = try m.get(1).asString()
			r.authData = try m.get(2).asBytes()
			r.statement = m.get(3)
			r.enterpriseAttestation = m.has(4) && (try m.get(4).asBool())
			r.largeBlobKey = m.get(5).asBytes() onerror recover byte[]
			return r
		}

		// Signs with the credentials that match, implementing Authenticator:
		// every one the authenticator offers (authenticatorGetNextAssertion
		// after the first), over U2F for a U2F-only authenticator. Fails with
		// a CTAPError, NoCredentials when none matches.
		def getAssertion(request GetAssertionRequest) !GetAssertionResult[] {
			let i = try info()
			return try u2fAuthenticate(request) when !i.ctap2()
			let allow = try usableCredentials(request.rpId, request.allow, i)
			fail ctapError(CTAPStatus.NoCredentials, "none of the allowed credentials is on this authenticator") when request.allow.len() > 0 && allow.len() == 0
			let p = new CBORValue(CBORKind.Map)
			p.set(1, new CBORValue(request.rpId))
			p.set(2, new CBORValue(request.clientDataHash))
			p.set(3, ctapDescriptors(allow)) when allow.len() > 0
			let ext = request.extensions.kind == CBORKind.Map ?? (request.extensions, new CBORValue(CBORKind.Map))
			let saltProtocol = new PinProtocol(1)
			let saltShared byte[]
			if request.hmacSalts.len() > 0 {
				fail ctapError(CTAPStatus.InvalidLength, "hmac-secret takes one or two 32-byte salts") when request.hmacSalts.len() != 32 && request.hmacSalts.len() != 64
				let (protocol, keyAgreement, shared) = try agree()
				let saltEnc = try protocol.encrypt(shared, request.hmacSalts)
				let input = new CBORValue(CBORKind.Map)
				input.set(1, keyAgreement)
				input.set(2, new CBORValue(saltEnc))
				input.set(3, new CBORValue(protocol.authenticate(shared, saltEnc)))
				input.set(4, new CBORValue(protocol.version)) when protocol.version != 1
				ext.set("hmac-secret", input)
				saltProtocol = protocol
				saltShared = shared
			}
			ext.set("credBlob", new CBORValue(true)) when request.getCredBlob
			ext.set("largeBlobKey", new CBORValue(true)) when request.largeBlobKey
			p.set(4, ext) when ext.len() > 0
			let (token, protocol, optionUV) = try verification(PinPermission.GetAssertion, request.rpId, request.userVerification, i.option("alwaysUv") && request.userPresence, i)
			let options = new CBORValue(CBORKind.Map)
			options.set("up", new CBORValue(false)) when !request.userPresence
			options.set("uv", new CBORValue(true)) when optionUV
			p.set(5, options) when options.len() > 0
			if token.len() > 0 {
				p.set(6, new CBORValue(protocol.authenticate(token, request.clientDataHash)))
				p.set(7, new CBORValue(protocol.version))
			}
			let m = try command(CTAPCommand.GetAssertion, p)
			let out GetAssertionResult[] = [try ctapAssertion(m, allow)]
			let total = m.has(5) ?? (try m.get(5).asInt(), 1)
			for let k = 1; k < total; k++ {
				out.push(try ctapAssertion(try command(CTAPCommand.GetNextAssertion, none), allow))
			}
			for let (_, r) in out {
				let outputs = (try parseAuthenticatorData(r.authData)).extensions
				continue when outputs.kind != CBORKind.Map
				r.hmacSecret = try saltProtocol.decrypt(saltShared, try outputs.get("hmac-secret").asBytes()) when saltShared.len() > 0 && outputs.has("hmac-secret")
				r.credBlob = outputs.get("credBlob").asBytes() onerror recover byte[]
			}
			return out
		}

		// Flashes the key's LED or beeps so the user can tell which one it is
		// (CTAPHID_WINK). Fails when the key does not support it.
		def wink() !none {
			fail ctapError(CTAPStatus.InvalidCommand, "the key cannot wink") when (transport.capabilities() & CTAPHIDCapability.Wink.value) == 0
			try transport.transact(CTAPHIDCommand.Wink, byte[])
			return none
		}

		// Erases every credential and the PIN (authenticatorReset). Most
		// authenticators accept it only within seconds of being plugged in
		// and after a touch. Fails with NotAllowed outside that window or
		// OperationDenied when the user declines.
		def reset() !none {
			try command(CTAPCommand.Reset, none)
			cached = none
			return none
		}

		// Waits for the user to touch this authenticator, to pick it among
		// several (authenticatorSelection). Fails when the key does not
		// support it or the user does not touch it in time.
		def selection() !none {
			try command(CTAPCommand.Selection, none)
			return none
		}

		// How many PIN attempts are left before the authenticator locks.
		// Fails when it has no PIN support.
		def pinRetries() !int {
			let p = new CBORValue(CBORKind.Map)
			p.set(1, new CBORValue(try pinProtocolVersion()))
			p.set(2, new CBORValue(0x01))
			return try (try command(CTAPCommand.ClientPIN, p)).get(3).asInt()
		}

		// How many built-in user verification attempts are left. Fails when
		// the authenticator has no built-in verification.
		def uvRetries() !int {
			let p = new CBORValue(CBORKind.Map)
			p.set(1, new CBORValue(try pinProtocolVersion()))
			p.set(2, new CBORValue(0x07))
			return try (try command(CTAPCommand.ClientPIN, p)).get(5).asInt()
		}

		// Sets the first PIN of an authenticator that has none. Fails when
		// the PIN is shorter than 4 characters or the authenticator's
		// minimum, longer than 63 bytes, or the authenticator already has
		// one (NotAllowed; change it with changePIN(current, newPIN)).
		def changePIN(newPIN string) !none {
			let i = try info()
			fail ctapError(CTAPStatus.PINPolicyViolation, "the PIN needs at least {i.minPINLength} characters") when newPIN.len() < i.minPINLength
			let (protocol, keyAgreement, shared) = try agree()
			let enc = try protocol.encrypt(shared, try paddedPIN(newPIN))
			let p = new CBORValue(CBORKind.Map)
			p.set(1, new CBORValue(protocol.version))
			p.set(2, new CBORValue(0x03))
			p.set(3, keyAgreement)
			p.set(4, new CBORValue(protocol.authenticate(shared, enc)))
			p.set(5, new CBORValue(enc))
			try command(CTAPCommand.ClientPIN, p)
			cached = none
			pin = newPIN
			return none
		}

		// Changes the PIN. Fails with PINInvalid when the current PIN is
		// wrong (each failure uses up a retry), PINBlocked when none are
		// left, or as changePIN(newPIN) for the new PIN.
		def changePIN(current string, newPIN string) !none {
			let i = try info()
			fail ctapError(CTAPStatus.PINPolicyViolation, "the PIN needs at least {i.minPINLength} characters") when newPIN.len() < i.minPINLength
			let (protocol, keyAgreement, shared) = try agree()
			let newEnc = try protocol.encrypt(shared, try paddedPIN(newPIN))
			let hashEnc = try protocol.encrypt(shared, pinHash(current))
			let p = new CBORValue(CBORKind.Map)
			p.set(1, new CBORValue(protocol.version))
			p.set(2, new CBORValue(0x04))
			p.set(3, keyAgreement)
			p.set(4, new CBORValue(protocol.authenticate(shared, newEnc + hashEnc)))
			p.set(5, new CBORValue(newEnc))
			p.set(6, new CBORValue(hashEnc))
			try command(CTAPCommand.ClientPIN, p)
			cached = none
			pin = newPIN
			return none
		}

		// A PIN/UV auth token for the permissions (PinPermission bits) and
		// relying party ("" for none), with the protocol that protects it:
		// from built-in user verification when the authenticator offers it,
		// else from the PIN. Fails with PUATRequired when neither is
		// available, or with the authenticator's refusal (PINInvalid,
		// UVInvalid, …).
		def token(permissions int, rpId string = "") !(byte[], PinProtocol) {
			let i = try info()
			let (protocol, keyAgreement, shared) = try agree()
			let p = new CBORValue(CBORKind.Map)
			p.set(1, new CBORValue(protocol.version))
			p.set(3, keyAgreement)
			let tokens = i.option("pinUvAuthToken")
			if tokens && i.option("uv") {
				p.set(2, new CBORValue(0x06))
				p.set(9, new CBORValue(permissions))
				p.set(10, new CBORValue(rpId)) when rpId != ""
			} else {
				fail ctapError(CTAPStatus.PUATRequired, "the authenticator needs its PIN; set SecurityKey.pin") when pin.reveal() == "" || !i.option("clientPin")
				p.set(6, new CBORValue(try protocol.encrypt(shared, pinHash(pin.reveal()))))
				if tokens {
					p.set(2, new CBORValue(0x09))
					p.set(9, new CBORValue(permissions))
					p.set(10, new CBORValue(rpId)) when rpId != ""
				} else {
					p.set(2, new CBORValue(0x05))
				}
			}
			let m = try command(CTAPCommand.ClientPIN, p)
			return (try protocol.decrypt(shared, try m.get(2).asBytes()), protocol)
		}

		// Sends a CTAP2 command with its parameters (none for none) and
		// returns the answer map, empty when the authenticator answered
		// with the status alone. Fails with a CTAPError for a non-zero
		// status, or when the answer is not CBOR.
		def command(cmd CTAPCommand, params ?CBORValue) !CBORValue {
			let c = new CBOR()
			c.keyOrder = CBORKeyOrder.LengthFirst
			let req byte[] = [byte(cmd.value)]
			req.push(...c.encode(params)) unless params is none
			let resp = try transport.transact(CTAPHIDCommand.CBOR, req)
			fail ctapError(CTAPStatus.InvalidLength, "empty answer") when resp.len() == 0
			let status = int(resp[0])
			fail ctapError(ctapStatus(status), "the authenticator refused command {cmd} (status {status})") when status != 0
			return new CBORValue(CBORKind.Map) when resp.len() == 1
			return try c.parse(resp.slice(1, resp.len() - 1))
		}

		// The protocol to use: 2 when the authenticator offers it, else 1.
		internal def pinProtocolVersion() !int {
			let i = try info()
			return 2 when i.pinUvAuthProtocols.includes(2)
			return 1
		}

		// Agrees on a shared secret with the authenticator
		// (getKeyAgreement): the protocol, our key-agreement COSE_Key and
		// the shared secret.
		internal def agree() !(PinProtocol, CBORValue, byte[]) {
			let protocol = new PinProtocol(try pinProtocolVersion())
			let p = new CBORValue(CBORKind.Map)
			p.set(1, new CBORValue(protocol.version))
			p.set(2, new CBORValue(0x02))
			let peer = (try command(CTAPCommand.ClientPIN, p)).get(1)
			let (scalar, mine) = try protocol.keyPair()
			return (protocol, mine, try protocol.sharedSecret(scalar, peer))
		}

		// How to verify the user for an operation: a token with its
		// protocol, or the CTAP 2.0 `uv` option, or neither. needed forces a
		// token where the authenticator demands one without verification
		// being asked for (a PIN set and makeCredUvNotRqd absent).
		internal def verification(permission PinPermission, rpId string, wanted bool, needed bool, i AuthenticatorInfo) !(byte[], PinProtocol, bool) {
			let noToken byte[]
			let builtin = i.option("uv")
			let tokens = i.option("pinUvAuthToken")
			let protocol = new PinProtocol(2)
			if (wanted || needed) && ((builtin && tokens) || (i.option("clientPin") && pin.reveal() != "")) {
				let (t, pr) = try token(permission.value, rpId)
				return (t, pr, false)
			}
			return (noToken, protocol, true) when wanted && builtin
			fail ctapError(CTAPStatus.PUATRequired, "the authenticator needs its PIN; set SecurityKey.pin") when wanted && i.option("clientPin")
			fail ctapError(CTAPStatus.UnsupportedOption, "the authenticator cannot verify the user") when wanted
			return (noToken, protocol, false)
		}

		// The credentials of a list that this authenticator holds for the
		// relying party, when the list is longer than the authenticator
		// takes at once (CTAP 2.2 §6.2.2 pre-flight with up = false); the
		// list unchanged otherwise. Ids longer than the authenticator's
		// maximum are dropped, as it could not have made them.
		internal def usableCredentials(rpId string, list CredentialDescriptor[], i AuthenticatorInfo) !CredentialDescriptor[] {
			let fit CredentialDescriptor[] = []
			for let (_, d) in list {
				fit.push(d) when i.maxCredentialIdLength == 0 || d.id.len() <= i.maxCredentialIdLength
			}
			let batch = i.maxCredentialCount
			return fit when batch == 0 || fit.len() <= batch
			let found CredentialDescriptor[] = []
			let dummy byte[]
			dummy.len(32)
			for let start = 0; start < fit.len(); start += batch {
				let n = fit.len() - start < batch ?? (fit.len() - start, batch)
				let p = new CBORValue(CBORKind.Map)
				p.set(1, new CBORValue(rpId))
				p.set(2, new CBORValue(dummy))
				p.set(3, ctapDescriptors(fit.slice(start, n)))
				let options = new CBORValue(CBORKind.Map)
				options.set("up", new CBORValue(false))
				p.set(5, options)
				let m = command(CTAPCommand.GetAssertion, p) onerror (err error) {
					if err is CTAPError && err.status == CTAPStatus.NoCredentials {
						recover new CBORValue()
					}
					fail err
				}
				continue when m.kind != CBORKind.Map
				let id = try m.get(1).get("id").asBytes()
				for let (_, d) in fit.slice(start, n) {
					if d.id.equals(id) {
						found.push(d)
						return found
					}
				}
			}
			return found
		}
	}
}
