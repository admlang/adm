partial module std.proto.auth.webauthn {
	use (
		std.crypto
		std.crypto.hash::(Hash, digest)
		std.data.encoding::(CBOR, CBORValue, CBORKind, CBORKeyOrder)
		std.proto.auth.webauthn.ctap::*
	)

	// A relying party with discoverable credentials on an authenticator.
	struct StoredRelyingParty {
		rp       RelyingPartyEntity
		rpIdHash byte[]
	}

	// A discoverable credential on an authenticator, as credential
	// management lists it.
	struct StoredCredential {
		id   byte[]
		user User

		// The credential public key in COSE form.
		publicKey byte[]

		// The credProtect level: 1 user verification optional, 2 optional
		// with a credential id list, 3 required; 0 when not reported.
		credProtect int

		// The credential's large-blob key; empty when it has none.
		largeBlobKey byte[]
	}

	// A fingerprint template enrolled on an authenticator.
	struct Fingerprint {
		id   byte[]
		name string
	}

	// The fingerprint sensor of an authenticator.
	struct FingerprintSensor {
		// 1 for a touch sensor, 2 for a swipe sensor.
		kind int

		// How many good samples an enrollment takes.
		samplesRequired int

		// The longest friendly name, in bytes.
		maxNameLength int
	}

	// The credential management, authenticator config, large-blob and bio
	// enrollment commands of a SecurityKey (CTAP 2.2 §6.7, §6.8, §6.10, §6.11).
	partial type SecurityKey {
		// How many discoverable credentials the authenticator holds and how
		// many more fit (credential management getCredsMetadata). Fails
		// without credential management, or as token does.
		def credentialsMetadata() !(int, int) {
			let m = try manage(0x01, none)
			return (try m.get(1).asInt(), try m.get(2).asInt())
		}

		// The relying parties with discoverable credentials on the
		// authenticator. Fails without credential management, or as token
		// does.
		def relyingParties() !StoredRelyingParty[] {
			let out StoredRelyingParty[] = []
			let (token, protocol, cmd) = try manageToken()
			let first = manageWith(cmd, token, protocol, 0x02, none) onerror (err error) {
				if err is CTAPError && err.status == CTAPStatus.NoCredentials {
					recover new CBORValue()
				}
				fail err
			}
			return out when first.kind != CBORKind.Map
			let total = try first.get(5).asInt()
			let m = first
			for let k = 0; k < total; k++ {
				m = try command(cmd, ctapSub(0x03)) when k > 0
				let rp = m.get(3)
				out.push(StoredRelyingParty{rp: RelyingPartyEntity{id: try rp.get("id").asString(), name: rp.get("name").asString() onerror recover ""}, rpIdHash: try m.get(4).asBytes()})
			}
			return out
		}

		// The discoverable credentials of a relying party. Fails without
		// credential management, or as token does.
		def credentials(rpId string) !StoredCredential[] {
			let out StoredCredential[] = []
			let (token, protocol, cmd) = try manageToken()
			let params = new CBORValue(CBORKind.Map)
			params.set(1, new CBORValue(digest(Hash.SHA256, rpId.bytes())))
			let first = manageWith(cmd, token, protocol, 0x04, params) onerror (err error) {
				if err is CTAPError && err.status == CTAPStatus.NoCredentials {
					recover new CBORValue()
				}
				fail err
			}
			return out when first.kind != CBORKind.Map
			let total = try first.get(9).asInt()
			let m = first
			for let k = 0; k < total; k++ {
				m = try command(cmd, ctapSub(0x05)) when k > 0
				let u = m.get(6)
				let c = new CBOR()
				c.keyOrder = CBORKeyOrder.LengthFirst
				out.push(StoredCredential{
					id:           try m.get(7).get("id").asBytes(),
					user:         User{id: try u.get("id").asBytes(), name: u.get("name").asString() onerror recover "", displayName: u.get("displayName").asString() onerror recover ""},
					publicKey:    c.encode(m.get(8)),
					credProtect:  m.get(10).asInt() onerror recover 0,
					largeBlobKey: m.get(11).asBytes() onerror recover byte[],
				})
			}
			return out
		}

		// Deletes a discoverable credential. Fails with NoCredentials when
		// the authenticator does not hold it, or as token does.
		def deleteCredential(id byte[]) !none {
			let params = new CBORValue(CBORKind.Map)
			params.set(2, ctapDescriptor(id))
			try manage(0x06, params)
			return none
		}

		// Replaces the user information stored with a discoverable
		// credential; the user id must stay the same. Fails as
		// deleteCredential does, or when the authenticator does not support
		// updates.
		def updateUser(id byte[], user User) !none {
			let params = new CBORValue(CBORKind.Map)
			params.set(2, ctapDescriptor(id))
			params.set(3, ctapUser(user))
			try manage(0x07, params)
			return none
		}

		// Turns on enterprise attestation (authenticatorConfig). Fails when
		// the authenticator does not support it, or as token does.
		def enableEnterpriseAttestation() !none {
			try configure(0x01, none)
			return none
		}

		// Toggles whether every operation requires user verification.
		// Fails as enableEnterpriseAttestation does.
		def toggleAlwaysUV() !none {
			try configure(0x02, none)
			return none
		}

		// Raises the minimum PIN length (0 keeps it), lists the relying
		// parties that may read it through the minPinLength extension, and
		// can force a PIN change. Fails when the length is below the current
		// minimum, or as enableEnterpriseAttestation does.
		def setMinPINLength(length int = 0, rpIds string[] = [], forceChange bool = false) !none {
			let params = new CBORValue(CBORKind.Map)
			params.set(1, new CBORValue(length)) when length > 0
			if rpIds.len() > 0 {
				let list = new CBORValue(CBORKind.Array)
				for let (_, id) in rpIds {
					list.push(new CBORValue(id))
				}
				params.set(2, list)
			}
			params.set(3, new CBORValue(true)) when forceChange
			try configure(0x03, params)
			return none
		}

		// The authenticator's large-blob array, read in fragments and
		// checked. Fails when the authenticator has no large blobs or the
		// check value does not match.
		def largeBlobArray() !CBORValue {
			let i = try info()
			let size = i.maxMsgSize - 64
			let all byte[]
			for {
				let p = new CBORValue(CBORKind.Map)
				p.set(1, new CBORValue(size))
				p.set(3, new CBORValue(all.len()))
				let part = try (try command(CTAPCommand.LargeBlobs, p)).get(1).asBytes()
				all.push(...part)
				break when part.len() < size
			}
			return try parseLargeBlobArray(all)
		}

		// Replaces the authenticator's large-blob array, in fragments, each
		// authorized by a token with the LargeBlobWrite permission. Fails
		// when the array is larger than the authenticator stores, or as
		// token does.
		def writeLargeBlobArray(array CBORValue) !none {
			let i = try info()
			let data = serializeLargeBlobArray(array)
			fail ctapError(CTAPStatus.LargeBlobStorageFull, "the array is {data.len()} bytes, the authenticator stores {i.maxLargeBlobArray}") when i.maxLargeBlobArray > 0 && data.len() > i.maxLargeBlobArray
			let size = i.maxMsgSize - 64
			let (token, protocol) = try token(PinPermission.LargeBlobWrite.value)
			for let offset = 0; offset < data.len(); offset += size {
				let n = data.len() - offset < size ?? (data.len() - offset, size)
				let fragment = data.slice(offset, n)
				let p = new CBORValue(CBORKind.Map)
				p.set(2, new CBORValue(fragment))
				p.set(3, new CBORValue(offset))
				p.set(4, new CBORValue(data.len())) when offset == 0
				let msg byte[]
				for let k = 0; k < 32; k++ {
					msg.push(byte(0xFF))
				}
				msg.push(byte(0x0C), byte(0x00))
				msg.push(byte(offset & 0xFF), byte((offset >> 8) & 0xFF), byte((offset >> 16) & 0xFF), byte((offset >> 24) & 0xFF))
				msg.push(...digest(Hash.SHA256, fragment))
				p.set(5, new CBORValue(protocol.authenticate(token, msg)))
				p.set(6, new CBORValue(protocol.version))
				try command(CTAPCommand.LargeBlobs, p)
			}
			return none
		}

		// The large blob of the credential whose large-blob key is given;
		// none when it has none. Fails as largeBlobArray does.
		def largeBlob(key byte[]) !?byte[] {
			for let (_, entry) in (try largeBlobArray()).elements() {
				let data = try openLargeBlob(key, entry)
				return data unless data is none
			}
			return none
		}

		// Stores a credential's large blob, replacing the one it had. Fails
		// as writeLargeBlobArray does.
		def storeLargeBlob(key byte[], data byte[]) !none {
			let next = new CBORValue(CBORKind.Array)
			for let (_, entry) in (try largeBlobArray()).elements() {
				next.push(entry) when (try openLargeBlob(key, entry)) is none
			}
			next.push(try sealLargeBlob(key, data))
			return try writeLargeBlobArray(next)
		}

		// Removes a credential's large blob. Fails as writeLargeBlobArray
		// does.
		def removeLargeBlob(key byte[]) !none {
			let next = new CBORValue(CBORKind.Array)
			for let (_, entry) in (try largeBlobArray()).elements() {
				next.push(entry) when (try openLargeBlob(key, entry)) is none
			}
			return try writeLargeBlobArray(next)
		}

		// The fingerprint sensor. Fails when the authenticator has none.
		def fingerprintSensor() !FingerprintSensor {
			let p = new CBORValue(CBORKind.Map)
			p.set(1, new CBORValue(1))
			p.set(2, new CBORValue(0x07))
			let m = try command(bioCommand(try info()), p)
			return FingerprintSensor{kind: try m.get(2).asInt(), samplesRequired: m.get(3).asInt() onerror recover 0, maxNameLength: m.get(8).asInt() onerror recover 0}
		}

		// Enrolls a fingerprint, asking for samples until the template is
		// complete, and returns its id. onSample is told each sample's
		// status (0 good, otherwise why it was refused) and how many samples
		// remain. Fails when the user does not touch in time or the
		// authenticator refuses.
		def enrollFingerprint(timeout duration = 10s, onSample ?def (int, int) = none) !byte[] {
			let params = new CBORValue(CBORKind.Map)
			params.set(3, new CBORValue(int(timeout.milliseconds())))
			let (token, protocol) = try token(PinPermission.BioEnrollment.value)
			let m = try bio(token, protocol, 0x01, params)
			let id = try m.get(4).asBytes()
			for {
				let remaining = try m.get(6).asInt()
				let hook = onSample
				hook(m.get(5).asInt() onerror recover 0, remaining) unless hook is none
				return id when remaining == 0
				let next = new CBORValue(CBORKind.Map)
				next.set(1, new CBORValue(id))
				next.set(3, new CBORValue(int(timeout.milliseconds())))
				m = try bio(token, protocol, 0x02, next)
			}
		}

		// Abandons an enrollment in progress. Fails when none is.
		def cancelEnrollment() !none {
			let p = new CBORValue(CBORKind.Map)
			p.set(1, new CBORValue(1))
			p.set(2, new CBORValue(0x03))
			try command(bioCommand(try info()), p)
			return none
		}

		// The enrolled fingerprints. Fails as token does.
		def fingerprints() !Fingerprint[] {
			let (token, protocol) = try token(PinPermission.BioEnrollment.value)
			let m = bio(token, protocol, 0x04, none) onerror (err error) {
				if err is CTAPError && err.status == CTAPStatus.InvalidOption {
					recover new CBORValue()
				}
				fail err
			}
			let out Fingerprint[] = []
			for let (_, t) in m.get(7).elements() {
				out.push(Fingerprint{id: try t.get(1).asBytes(), name: t.get(2).asString() onerror recover ""})
			}
			return out
		}

		// Names an enrolled fingerprint. Fails when there is no such template.
		def renameFingerprint(id byte[], name string) !none {
			let params = new CBORValue(CBORKind.Map)
			params.set(1, new CBORValue(id))
			params.set(2, new CBORValue(name))
			let (token, protocol) = try token(PinPermission.BioEnrollment.value)
			try bio(token, protocol, 0x05, params)
			return none
		}

		// Removes an enrolled fingerprint. Fails when there is no such
		// template.
		def removeFingerprint(id byte[]) !none {
			let params = new CBORValue(CBORKind.Map)
			params.set(1, new CBORValue(id))
			let (token, protocol) = try token(PinPermission.BioEnrollment.value)
			try bio(token, protocol, 0x06, params)
			return none
		}

		// The credential management command this authenticator answers to
		// and a token for it.
		internal def manageToken() !(byte[], PinProtocol, CTAPCommand) {
			let i = try info()
			let cmd = CTAPCommand.CredentialManagement
			if !i.option("credMgmt") {
				fail ctapError(CTAPStatus.InvalidCommand, "the authenticator has no credential management") when !i.option("credentialMgmtPreview")
				cmd = CTAPCommand.CredentialManagementPreview
			}
			let (token, protocol) = try token(PinPermission.CredentialManagement.value)
			return (token, protocol, cmd)
		}

		// A credential management subcommand under a fresh token.
		internal def manage(sub int, params ?CBORValue) !CBORValue {
			let (token, protocol, cmd) = try manageToken()
			return try manageWith(cmd, token, protocol, sub, params)
		}

		// A credential management subcommand, authorized by
		// authenticate(token, subCommand || params).
		internal def manageWith(cmd CTAPCommand, token byte[], protocol PinProtocol, sub int, params ?CBORValue) !CBORValue {
			let c = new CBOR()
			c.keyOrder = CBORKeyOrder.LengthFirst
			let p = ctapSub(sub)
			let msg byte[] = [byte(sub)]
			if !(params is none) {
				p.set(2, params)
				msg.push(...c.encode(params))
			}
			p.set(3, new CBORValue(protocol.version))
			p.set(4, new CBORValue(protocol.authenticate(token, msg)))
			return try command(cmd, p)
		}

		// An authenticatorConfig subcommand, authorized by
		// authenticate(token, 32 × 0xff || 0x0d || subCommand || params).
		internal def configure(sub int, params ?CBORValue) !CBORValue {
			let (token, protocol) = try token(PinPermission.AuthenticatorConfig.value)
			let c = new CBOR()
			c.keyOrder = CBORKeyOrder.LengthFirst
			let p = ctapSub(sub)
			let msg byte[]
			for let k = 0; k < 32; k++ {
				msg.push(byte(0xFF))
			}
			msg.push(byte(0x0D), byte(sub))
			if !(params is none) {
				p.set(2, params)
				msg.push(...c.encode(params))
			}
			p.set(3, new CBORValue(protocol.version))
			p.set(4, new CBORValue(protocol.authenticate(token, msg)))
			return try command(CTAPCommand.Config, p)
		}

		// A fingerprint bio enrollment subcommand, authorized by
		// authenticate(token, modality || subCommand || params).
		internal def bio(token byte[], protocol PinProtocol, sub int, params ?CBORValue) !CBORValue {
			let c = new CBOR()
			c.keyOrder = CBORKeyOrder.LengthFirst
			let p = new CBORValue(CBORKind.Map)
			p.set(1, new CBORValue(1))
			p.set(2, new CBORValue(sub))
			let msg byte[] = [1, byte(sub)]
			if !(params is none) {
				p.set(3, params)
				msg.push(...c.encode(params))
			}
			p.set(4, new CBORValue(protocol.version))
			p.set(5, new CBORValue(protocol.authenticate(token, msg)))
			return try command(bioCommand(try info()), p)
		}
	}
}
