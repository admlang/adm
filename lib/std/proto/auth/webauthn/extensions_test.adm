partial module std.proto.auth.webauthn {
	use (
		std.testing
		std.proto.auth.webauthn.json::*
	)

	check "WebAuthn extensions" {
		@test()
		def TestOptionsJSONRoundTrip() !none {
			let rp = new RelyingParty("example.com", "Example", "https://example.com")
			rp.attestation = AttestationConveyance.Direct
			rp.userVerification = UserVerification.Required
			let ext = RegistrationExtensions{credentialProtection: CredentialProtection.OptionalWithCredentialIDList, enforceCredentialProtection: true, largeBlob: LargeBlobSupport.Preferred, prf: true, credBlob: byte[1, 2, 3], minPinLength: true, appidExclude: "https://example.com/appid.json"}
			let reg = try rp.beginRegistration(User{id: byte[7, 7], name: "a@b", displayName: "A B"}, [CredentialDescriptor{id:byte[9], transports:["usb", "nfc"]}], ResidentKey.Required, Attachment.CrossPlatform, ext)
			let back = try parseRegistrationOptions(reg.json())
			assert back.rpId == "example.com" && back.rpName == "Example"
			assert back.user.id.equals(byte[7, 7]) && back.user.name == "a@b" && back.user.displayName == "A B"
			assert back.challenge.equals(reg.challenge)
			assert back.algorithms.len() == 3 && back.algorithms[0] == COSEAlgorithm.EdDSA
			assert back.timeout == reg.timeout
			assert back.exclude.len() == 1 && back.exclude[0].id.equals(byte[9]) && back.exclude[0].transports.len() == 2
			assert back.attachment == Attachment.CrossPlatform && back.residentKey == ResidentKey.Required
			assert back.userVerification == UserVerification.Required && back.attestation == AttestationConveyance.Direct
			let e = back.extensions
			assert e.credentialProtection == CredentialProtection.OptionalWithCredentialIDList && e.enforceCredentialProtection
			assert e.largeBlob == LargeBlobSupport.Preferred && e.prf && e.credBlob.equals(byte[1, 2, 3]) && e.minPinLength
			assert e.appidExclude == "https://example.com/appid.json"

			let byCred map<string, PRFValues> = {}
			byCred[base64url(byte[9])] = PRFValues{first: byte[4], second: byte[5]}
			let aext = AuthenticationExtensions{prf: PRFValues{first: byte[1]}, prfByCredential: byCred, largeBlobRead: true, getCredBlob: true}
			let auth = try rp.beginAuthentication([CredentialDescriptor{id:byte[9]}], aext)
			let aback = try parseAuthenticationOptions(auth.json())
			assert aback.rpId == "example.com" && aback.challenge.equals(auth.challenge)
			assert aback.allow.len() == 1 && aback.userVerification == UserVerification.Required
			assert aback.extensions.prf.first.equals(byte[1]) && aback.extensions.prf.second.len() == 0
			let v = aback.extensions.prfByCredential.get(base64url(byte[9]))
			assert v is none ?? (false, v.first.equals(byte[4]) && v.second.equals(byte[5]))
			assert aback.extensions.largeBlobRead && aback.extensions.getCredBlob
			return none
		}

		@test()
		def TestExtensionCeremony() !none {
			let rp = new RelyingParty("example.com", "Example", "https://example.com")
			let auth = new SoftAuthenticator()
			let client = new Client("https://example.com", auth)
			let ext = RegistrationExtensions{credentialProtection: CredentialProtection.Required, enforceCredentialProtection: true, largeBlob: LargeBlobSupport.Required, prf: true, credBlob: "tiny".bytes()}
			let reg = try rp.beginRegistration(User{id: byte[1], name: "u", displayName: "U"}, [], ResidentKey.Required, Attachment.Any, ext)

			// The client works from the JSON the relying party sends.
			let created = try client.create(try parseRegistrationOptions(reg.json()))
			let cred = try rp.finishRegistration(reg, created.json())
			assert cred.credProtect == 3 && cred.prfEnabled && cred.largeBlobSupported && cred.credBlobStored

			// prf: the same input gives the same output, another input another.
			let prfIn = AuthenticationExtensions{prf: PRFValues{first: "salt-a".bytes(), second: "salt-b".bytes()}}
			let l1 = try rp.beginAuthentication([cred.descriptor()], prfIn)
			let r1 = try rp.finishAuthentication(l1, try client.get(try parseAuthenticationOptions(l1.json())), cred)
			assert r1.prf.first.len() == 32 && r1.prf.second.len() == 32 && !r1.prf.first.equals(r1.prf.second)
			let l2 = try rp.beginAuthentication([cred.descriptor()], AuthenticationExtensions{prf: PRFValues{first: "salt-a".bytes()}})
			let r2 = try rp.finishAuthentication(l2, try client.get(l2), cred)
			assert r2.prf.first.equals(r1.prf.first) && r2.prf.second.len() == 0

			// largeBlob: write, then read back.
			let l3 = try rp.beginAuthentication([cred.descriptor()], AuthenticationExtensions{largeBlobWrite: "a certificate".bytes()})
			let r3 = try rp.finishAuthentication(l3, try client.get(l3), cred)
			assert r3.largeBlobWritten
			let l4 = try rp.beginAuthentication([cred.descriptor()], AuthenticationExtensions{largeBlobRead: true, getCredBlob: true})
			let r4 = try rp.finishAuthentication(l4, try client.get(l4), cred)
			assert string(r4.largeBlob) == "a certificate" && string(r4.credBlob) == "tiny"

			// credProtect 3: without user verification the credential stays hidden.
			auth.userVerified = false
			rp.userVerification = UserVerification.Discouraged
			let l5 = try rp.beginAuthentication([cred.descriptor()])
			let failed = false
			client.get(l5) onerror (err error) {
				failed = true
				recover new AuthenticationResponse()
			}
			assert failed
			return none
		}

		@test()
		def TestEnforcedCredProtectRefused() !none {
			let rp = new RelyingParty("example.com", "Example", "https://example.com")
			let device = new SoftDevice(new SoftAuthenticator())
			let key = new SecurityKey(device)
			let client = new Client("https://example.com", key)
			let reg = try rp.beginRegistration(User{id: byte[1], name: "u", displayName: "U"}, [], ResidentKey.Required, Attachment.Any, RegistrationExtensions{credentialProtection: CredentialProtection.Required, enforceCredentialProtection: true})
			let cred = try rp.finishRegistration(reg, try client.create(reg))
			assert cred.credProtect == 3
			// A response without the credProtect output fails the enforced policy.
			let plain = try rp.beginRegistration(User{id: byte[2], name: "v", displayName: "V"}, [], ResidentKey.Required)
			let response = try client.create(plain)
			plain.extensions = RegistrationExtensions{credentialProtection: CredentialProtection.Required, enforceCredentialProtection: true}
			let refused = false
			rp.finishRegistration(plain, response) onerror (err error) {
				refused = true
				recover new Credential()
			}
			assert refused
			return none
		}
	}
}
