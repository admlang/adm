internal partial module std.proto.auth.webauthn.cose {
	use (
		std.crypto
		std.crypto::(ECDSAPrivateKey, ECDSAPublicKey, Ed25519PrivateKey, Ed25519PublicKey, Ed448PrivateKey, Ed448PublicKey, PrivateKey, PublicKey, RSAPrivateKey, RSAPublicKey, publicKeyOf)
		std.crypto.hash::(Hash, digest, hashSize)
		std.data.encoding::(CBORKind, CBORValue, json)
		std.proto.auth.webauthn::*
		std.proto.auth.webauthn.json::*
		std.proto.auth.webauthn.formats::*
		std.proto.auth.webauthn.ctap::*
	)

	// The hash an algorithm signs with; SHA512 for the EdDSA ones, which
	// hash inside the signature.
	def coseHash(alg COSEAlgorithm) Hash {
		match alg {
			case COSEAlgorithm.ES384, COSEAlgorithm.PS384, COSEAlgorithm.RS384:
				return Hash.SHA384
			case COSEAlgorithm.ES512, COSEAlgorithm.PS512, COSEAlgorithm.RS512, COSEAlgorithm.EdDSA, COSEAlgorithm.Ed25519, COSEAlgorithm.Ed448:
				return Hash.SHA512
			case COSEAlgorithm.RS1:
				return Hash.SHA1
			default:
				return Hash.SHA256
		}
	}

	// The COSE number of an algorithm.
	def coseNumber(alg COSEAlgorithm) int {
		return alg.value
	}

	// The COSE_Key map of a key.
	def coseKeyMap(key PublicKey, alg COSEAlgorithm) !CBORValue {
		let m = new CBORValue(CBORKind.Map)
		if key is ECDSAPublicKey {
			let ec ECDSAPublicKey = key
			let crv = 0
			match ec.curve.name {
				case "P-256":
					crv = 1
				case "P-384":
					crv = 2
				case "P-521":
					crv = 3
				default:
					fail "webauthn: curve {ec.curve.name} has no COSE number"
			}
			let size = crypto.coordinateSize(ec.curve)
			m.set(1, new CBORValue(2))
			m.set(3, new CBORValue(coseNumber(alg)))
			m.set(-1, new CBORValue(crv))
			m.set(-2, new CBORValue(try ec.point.x.bytes(size)))
			m.set(-3, new CBORValue(try ec.point.y.bytes(size)))
			return m
		}
		if key is Ed25519PublicKey {
			let ed Ed25519PublicKey = key
			m.set(1, new CBORValue(1))
			m.set(3, new CBORValue(coseNumber(alg)))
			m.set(-1, new CBORValue(6))
			m.set(-2, new CBORValue(ed.bytes))
			return m
		}
		if key is Ed448PublicKey {
			let ed Ed448PublicKey = key
			m.set(1, new CBORValue(1))
			m.set(3, new CBORValue(coseNumber(alg)))
			m.set(-1, new CBORValue(7))
			m.set(-2, new CBORValue(ed.bytes))
			return m
		}
		fail "webauthn: this key type has no COSE form" unless key is RSAPublicKey
		let rsa RSAPublicKey = key
		m.set(1, new CBORValue(3))
		m.set(3, new CBORValue(coseNumber(alg)))
		m.set(-1, new CBORValue(rsa.n.bytes()))
		m.set(-2, new CBORValue(bigint(rsa.e).bytes()))
		return m
	}

	// Checks a WebAuthn signature over data under an algorithm and key.
	def coseVerify(alg COSEAlgorithm, key PublicKey, data byte[], signature byte[]) bool {
		if key is Ed25519PublicKey {
			let ed Ed25519PublicKey = key
			return false when !(alg := COSEAlgorithm.EdDSA || COSEAlgorithm.Ed25519)
			return ed.verify(data, signature)
		}
		if key is Ed448PublicKey {
			let ed Ed448PublicKey = key
			return false when !(alg := COSEAlgorithm.EdDSA || COSEAlgorithm.Ed448)
			return ed.verify(data, signature)
		}
		let hash = coseHash(alg)
		let sum = digest(hash, data)
		if key is ECDSAPublicKey {
			let ec ECDSAPublicKey = key
			return false when !(alg := COSEAlgorithm.ES256 || COSEAlgorithm.ES384 || COSEAlgorithm.ES512)
			let (r, s) = crypto.parseECDSASignature(signature) onerror recover (bigint(0), bigint(0))
			return ec.verify(sum, r, s)
		}
		return false unless key is RSAPublicKey
		let rsa RSAPublicKey = key
		match alg {
			case COSEAlgorithm.RS256, COSEAlgorithm.RS384, COSEAlgorithm.RS512, COSEAlgorithm.RS1:
				return rsa.verifyPKCS1v15(hash, sum, signature)
			case COSEAlgorithm.PS256, COSEAlgorithm.PS384, COSEAlgorithm.PS512:
				return rsa.verifyPSS(hash, sum, signature, hashSize(hash))
			default:
				return false
		}
	}

	// Signs data the way WebAuthn expects for the algorithm: DER ECDSA,
	// raw EdDSA, PKCS #1 v1.5 or PSS. Fails when the key does not suit the
	// algorithm or signing fails.
	def coseSign(alg COSEAlgorithm, key PrivateKey, data byte[]) !byte[] {
		if key is Ed25519PrivateKey {
			let ed Ed25519PrivateKey = key
			fail "webauthn: {alg} does not suit an Ed25519 key" when !(alg := COSEAlgorithm.EdDSA || COSEAlgorithm.Ed25519)
			return ed.sign(data)
		}
		if key is Ed448PrivateKey {
			let ed Ed448PrivateKey = key
			fail "webauthn: {alg} does not suit an Ed448 key" when !(alg := COSEAlgorithm.EdDSA || COSEAlgorithm.Ed448)
			return try ed.sign(data)
		}
		let hash = coseHash(alg)
		let sum = digest(hash, data)
		if key is ECDSAPrivateKey {
			let ec ECDSAPrivateKey = key
			fail "webauthn: {alg} does not suit an ECDSA key" when !(alg := COSEAlgorithm.ES256 || COSEAlgorithm.ES384 || COSEAlgorithm.ES512)
			return try ec.signASN1(sum)
		}
		fail "webauthn: {alg} cannot sign with this key type" unless key is RSAPrivateKey
		let rsa RSAPrivateKey = key
		match alg {
			case COSEAlgorithm.RS256, COSEAlgorithm.RS384, COSEAlgorithm.RS512, COSEAlgorithm.RS1:
				return try rsa.signPKCS1v15(hash, sum)
			case COSEAlgorithm.PS256, COSEAlgorithm.PS384, COSEAlgorithm.PS512:
				return try rsa.signPSS(hash, sum, hashSize(hash))
			default:
				fail "webauthn: {alg} does not suit an RSA key"
		}
	}

	// Reports whether two public keys are the same key.
	def sameKey(a PublicKey, b PublicKey) bool {
		if a is ECDSAPublicKey && b is ECDSAPublicKey {
			let x ECDSAPublicKey = a
			let y ECDSAPublicKey = b
			return x.curve.name == y.curve.name && x.point.x == y.point.x && x.point.y == y.point.y
		}
		if a is Ed25519PublicKey && b is Ed25519PublicKey {
			let x Ed25519PublicKey = a
			let y Ed25519PublicKey = b
			return x.bytes.equals(y.bytes)
		}
		if a is Ed448PublicKey && b is Ed448PublicKey {
			let x Ed448PublicKey = a
			let y Ed448PublicKey = b
			return x.bytes.equals(y.bytes)
		}
		if a is RSAPublicKey && b is RSAPublicKey {
			let x RSAPublicKey = a
			let y RSAPublicKey = b
			return x.n == y.n && x.e == y.e
		}
		return false
	}

	// Reports whether a key is an ECDSA key on P-256.
	def isP256(key PublicKey) bool {
		if key is ECDSAPublicKey {
			let ec ECDSAPublicKey = key
			return ec.curve.name == "P-256"
		}
		return false
	}
}
