internal partial module std.proto.auth.webauthn.formats {
	use (
		std.crypto
		std.crypto.x509
		std.time
		std.crypto::(ECDSAPublicKey, PublicKey, RSAPublicKey)
		std.crypto.hash::(Hash, digest)
		std.crypto.x509::(Certificate)
		std.data.encoding::(ASN1Element, Base64, CBORKind, CBORValue, JSON, OID, asn1Parse, json)
		std.time::(Time)
		std.proto.auth.webauthn::*
		std.proto.auth.webauthn.cose::*
		std.proto.auth.webauthn.json::*
		std.proto.auth.webauthn.ctap::*
	)

	// Object identifiers WebAuthn attestation certificates carry.
	let (
		// id-fido-gen-ce-aaguid: the AAGUID in a packed or TPM certificate.
		oidFIDOAAGUID = new OID([1, 3, 6, 1, 4, 1, 45724, 1, 1, 4])

		// Android key attestation: the KeyDescription extension.
		oidAndroidKeyDescription = new OID([1, 3, 6, 1, 4, 1, 11129, 2, 1, 17])

		// Apple anonymous attestation: the nonce extension.
		oidAppleNonce = new OID([1, 2, 840, 113635, 100, 8, 2])
	)

	// Reads the x5c array of a statement into certificates, leaf first.
	// Fails when it is absent, empty or holds something that does not parse.
	def attestationChain(statement CBORValue) !Certificate[] {
		let x5c = statement.get("x5c")
		fail "webauthn: attestation statement has no x5c" when x5c.kind != CBORKind.Array || x5c.len() == 0
		let out Certificate[] = []
		for let (_, der) in x5c.elements() {
			out.push(try x509.parseCertificate(try der.asBytes()))
		}
		return out
	}

	// The certificate's public key. Fails when its algorithm is not supported.
	def certificateKey(cert Certificate) !PublicKey {
		let key = cert.publicKey
		fail "webauthn: the attestation certificate's key algorithm is not supported" when key is none
		return key
	}

	// Checks that an attestation certificate's AAGUID extension, when
	// present, is not critical and matches the authenticator data.
	def checkAAGUIDExtension(cert Certificate, authData AuthenticatorData) !none {
		for let (_, ext) in cert.extensions {
			continue when !ext.id.equals(oidFIDOAAGUID)
			fail "webauthn: the AAGUID extension must not be critical" when ext.critical
			let inner = try (try asn1Parse(ext.value)).asBytes()
			fail "webauthn: the certificate's AAGUID differs from the authenticator data" when !inner.equals(authData.aaguid)
		}
		return none
	}

	// The packed format (§8.2), with a certificate chain or self attestation.
	def verifyPacked(statement CBORValue, authData AuthenticatorData, clientDataHash byte[], r AttestationResult) !none {
		let algNumber = try statement.get("alg").asInt()
		let alg = coseAlgorithm(algNumber)
		fail "webauthn: packed attestation algorithm {algNumber} is not supported" when alg is none
		let sig = try statement.get("sig").asBytes()
		let signed = authData.raw + clientDataHash
		if !statement.has("x5c") {
			fail "webauthn: self attestation algorithm differs from the credential's" when alg != authData.credentialKey.algorithm
			fail "webauthn: packed self attestation signature does not verify" when !authData.credentialKey.verify(signed, sig)
			r.kind = AttestationType.Self
			return none
		}
		r.chain = try attestationChain(statement)
		let leaf = r.chain[0]
		fail "webauthn: packed attestation signature does not verify" when !coseVerify(alg, try certificateKey(leaf), signed, sig)
		fail "webauthn: packed attestation certificate is not version 3" when leaf.version != 3
		let subject = leaf.subject
		fail "webauthn: packed attestation certificate subject needs C, O, OU and CN" when subject.country.len() == 0 || subject.organization.len() == 0 || subject.organizationalUnit.len() == 0 || subject.commonName == ""
		fail "webauthn: packed attestation certificate OU must be \"Authenticator Attestation\"" when subject.organizationalUnit[0] != "Authenticator Attestation"
		fail "webauthn: packed attestation certificate must not be a CA" when leaf.isCA
		try checkAAGUIDExtension(leaf, authData)
		r.kind = AttestationType.Basic
		return none
	}

	// The FIDO U2F format (§8.6).
	def verifyU2F(statement CBORValue, authData AuthenticatorData, clientDataHash byte[], r AttestationResult) !none {
		r.chain = try attestationChain(statement)
		fail "webauthn: fido-u2f attestation must carry exactly one certificate" when r.chain.len() != 1
		let key = try certificateKey(r.chain[0])
		fail "webauthn: fido-u2f attestation certificate key is not P-256" when !isP256(key)
		let cred = authData.credentialKey.key
		fail "webauthn: fido-u2f credential key is not P-256" unless cred is ECDSAPublicKey
		let ec ECDSAPublicKey = cred
		fail "webauthn: fido-u2f credential key is not P-256" when ec.curve.name != "P-256"
		let signed byte[] = [0]
		signed.push(...authData.rpIdHash)
		signed.push(...clientDataHash)
		signed.push(...authData.credentialId)
		signed.push(...crypto.marshalPoint(ec.curve, ec.point))
		let sig = try statement.get("sig").asBytes()
		fail "webauthn: fido-u2f attestation signature does not verify" when !coseVerify(COSEAlgorithm.ES256, key, signed, sig)
		r.kind = AttestationType.Uncertain
		return none
	}

	// The Apple anonymous format (§8.8).
	def verifyApple(statement CBORValue, authData AuthenticatorData, clientDataHash byte[], r AttestationResult) !none {
		r.chain = try attestationChain(statement)
		let leaf = r.chain[0]
		let nonce = digest(Hash.SHA256, authData.raw + clientDataHash)
		let found = false
		for let (_, ext) in leaf.extensions {
			continue when !ext.id.equals(oidAppleNonce)
			let seq = try asn1Parse(ext.value)
			let tagged = seq.tagged(1)
			fail "webauthn: apple nonce extension has no [1] field" when tagged is none
			let value = try (try tagged.inner()).asBytes()
			fail "webauthn: apple attestation nonce does not match" when !value.equals(nonce)
			found = true
		}
		fail "webauthn: apple attestation certificate has no nonce extension" when !found
		fail "webauthn: apple attestation certificate key differs from the credential key" when !sameKey(try certificateKey(leaf), authData.credentialKey.key)
		r.kind = AttestationType.AnonCA
		return none
	}

	// The Android key attestation format (§8.4).
	def verifyAndroidKey(statement CBORValue, authData AuthenticatorData, clientDataHash byte[], r AttestationResult) !none {
		let algNumber = try statement.get("alg").asInt()
		let alg = coseAlgorithm(algNumber)
		fail "webauthn: android-key attestation algorithm {algNumber} is not supported" when alg is none
		let sig = try statement.get("sig").asBytes()
		r.chain = try attestationChain(statement)
		let leaf = r.chain[0]
		let key = try certificateKey(leaf)
		fail "webauthn: android-key attestation signature does not verify" when !coseVerify(alg, key, authData.raw + clientDataHash, sig)
		fail "webauthn: android-key certificate key differs from the credential key" when !sameKey(key, authData.credentialKey.key)
		let description ?ASN1Element = none
		for let (_, ext) in leaf.extensions {
			description = try asn1Parse(ext.value) when ext.id.equals(oidAndroidKeyDescription)
		}
		fail "webauthn: android-key certificate has no key description" when description is none
		// KeyDescription ::= SEQUENCE { attestationVersion, attestationSecurityLevel,
		//   keymasterVersion, keymasterSecurityLevel, attestationChallenge OCTET STRING,
		//   uniqueId OCTET STRING, softwareEnforced AuthorizationList, teeEnforced AuthorizationList }
		fail "webauthn: android-key description is too short" when description.children.len() < 8
		let challenge = try (try description.at(4)).asBytes()
		fail "webauthn: android-key attestation challenge differs from the client data hash" when !challenge.equals(clientDataHash)
		let software = try description.at(6)
		let tee = try description.at(7)
		fail "webauthn: android-key credential is scoped to all applications" when !(software.tagged(600) is none) || !(tee.tagged(600) is none)
		let origin = tee.tagged(702)
		origin = software.tagged(702) when origin is none
		fail "webauthn: android-key key origin is not stated" when origin is none
		fail "webauthn: android-key key was not generated in the keystore" when (try (try origin.inner()).asInt()) != 0
		let purposes = tee.tagged(1)
		purposes = software.tagged(1) when purposes is none
		fail "webauthn: android-key key purpose is not stated" when purposes is none
		let signs = false
		for let (_, p) in (try purposes.inner()).children {
			signs = true when (try p.asInt()) == 2
		}
		fail "webauthn: android-key key is not for signing" when !signs
		r.kind = AttestationType.Basic
		return none
	}

	// The Android SafetyNet format (§8.5): a JWS from Google Play services.
	def verifySafetyNet(statement CBORValue, authData AuthenticatorData, clientDataHash byte[], r AttestationResult, at Time) !none {
		expects {
			assert (try statement.get("ver").asString()) != "" onerror fail "webauthn: android-safetynet attestation has no version"
		}
		let jws = string(try statement.get("response").asBytes())
		let parts = jws.split(".")
		fail "webauthn: android-safetynet response is not a compact JWS" when parts.len() != 3
		let header = SafetyNetHeader{}
		try new JSON().decode(try fromBase64url(parts[0]), header)
		let payload = SafetyNetPayload{}
		try new JSON().decode(try fromBase64url(parts[1]), payload)
		let sig = try fromBase64url(parts[2])

		let std = new Base64()
		fail "webauthn: android-safetynet response carries no certificates" when header.x5c.len() == 0
		for let (_, b64) in header.x5c {
			r.chain.push(try x509.parseCertificate(try std.decode(b64)))
		}
		let leaf = r.chain[0]
		fail "webauthn: android-safetynet certificate is not for attest.android.com" when !leaf.dnsNames.includes("attest.android.com") && leaf.subject.commonName != "attest.android.com"
		let key = try certificateKey(leaf)
		let signed = (parts[0] + "." + parts[1]).bytes()
		let ok = false
		match header.alg {
			case "RS256":
				ok = coseVerify(COSEAlgorithm.RS256, key, signed, sig)
			case "RS384":
				ok = coseVerify(COSEAlgorithm.RS384, key, signed, sig)
			case "RS512":
				ok = coseVerify(COSEAlgorithm.RS512, key, signed, sig)
			case "PS256":
				ok = coseVerify(COSEAlgorithm.PS256, key, signed, sig)
			case "ES256", "ES384", "ES512":
				let alg = header.alg == "ES256" ?? (COSEAlgorithm.ES256, header.alg == "ES384" ?? (COSEAlgorithm.ES384, COSEAlgorithm.ES512))
				fail "webauthn: android-safetynet ECDSA signature has an odd length" when sig.len() % 2 != 0
				let half = sig.len() / 2
				let der = crypto.marshalECDSASignature(parseBigInt(sig.slice(0, half)), parseBigInt(sig.slice(half, half)))
				ok = coseVerify(alg, key, signed, der)
			default:
				fail "webauthn: android-safetynet JWS algorithm {header.alg} is not supported"
		}
		fail "webauthn: android-safetynet JWS signature does not verify" when !ok
		let nonce = std.encode(digest(Hash.SHA256, authData.raw + clientDataHash))
		fail "webauthn: android-safetynet nonce does not match" when payload.nonce != nonce
		fail "webauthn: android-safetynet device fails the CTS profile" when !payload.ctsProfileMatch
		let now = at.unixNs() / 1000000
		fail "webauthn: android-safetynet response is from the future" when payload.timestampMs > now + 60000
		fail "webauthn: android-safetynet response is too old" when payload.timestampMs < now - 600000
		r.kind = AttestationType.Basic
		return none
	}

	struct SafetyNetHeader {
		alg string
		x5c string[]
	}

	struct SafetyNetPayload {
		nonce           string
		timestampMs     int64
		ctsProfileMatch bool
		basicIntegrity  bool
	}

	let (
		// TCG: tcg-kp-AIKCertificate, the extended key usage of an AIK certificate.
		oidTCGKpAIKCertificate = new OID([2, 23, 133, 8, 3])

		// TCG: the TPM manufacturer, model and version in an AIK certificate's
		// subject alternative name.
		oidTCGManufacturer = new OID([2, 23, 133, 2, 1])
		oidTCGModel        = new OID([2, 23, 133, 2, 2])
		oidTCGVersion      = new OID([2, 23, 133, 2, 3])
	)

	// A big-endian cursor over a TPM 2.0 structure.
	type TPMReader {
		data byte[]
		pos  int    = 0

		def new(data byte[]) {
			self.data = data
		}

		def u8() !int {
			fail "webauthn: TPM structure is truncated" when pos + 1 > data.len()
			pos++
			return int(data[pos - 1])
		}

		def u16() !int {
			fail "webauthn: TPM structure is truncated" when pos + 2 > data.len()
			pos += 2
			return int(data[pos - 2]) << 8 | int(data[pos - 1])
		}

		def u32() !uint32 {
			fail "webauthn: TPM structure is truncated" when pos + 4 > data.len()
			pos += 4
			return uint32(data[pos - 4]) << 24 | uint32(data[pos - 3]) << 16 | uint32(data[pos - 2]) << 8 | uint32(data[pos - 1])
		}

		def bytes(n int) !byte[] {
			expects {
				assert n >= 0 && pos + n <= data.len() onerror fail "webauthn: TPM structure is truncated"
			}
			pos += n
			return data.slice(pos - n, n).clone()
		}

		// A TPM2B: a 16-bit size and that many bytes.
		def sized() !byte[] {
			return try bytes(try u16())
		}

		def done() bool {
			return pos == data.len()
		}
	}

	// TPM algorithm ids.
	const (
		tpmAlgRSA  = 0x0001
		tpmAlgNull = 0x0010
		tpmAlgECC  = 0x0023
	)

	// The hash a TPM name algorithm id names (SHA1 0x0004, SHA256 0x000B,
	// SHA384 0x000C, SHA512 0x000D). Fails for one not supported.
	def tpmHash(alg int) !Hash {
		match alg {
			case 0x0004:
				return Hash.SHA1
			case 0x000B:
				return Hash.SHA256
			case 0x000C:
				return Hash.SHA384
			case 0x000D:
				return Hash.SHA512
			default:
				fail "webauthn: TPM hash algorithm {alg} is not supported"
		}
	}

	// Skips a TPMT scheme: an algorithm id and, unless it is TPM_ALG_NULL,
	// its hash algorithm.
	def tpmSkipScheme(r TPMReader) !none {
		let scheme = try r.u16()
		try r.u16() when scheme != tpmAlgNull
		return none
	}

	// The TPM attestation format (§8.3).
	def verifyTPM(statement CBORValue, authData AuthenticatorData, clientDataHash byte[], r AttestationResult) !none {
		expects {
			assert (try statement.get("ver").asString()) == "2.0" onerror fail "webauthn: tpm attestation version must be 2.0"
		}
		let algNumber = try statement.get("alg").asInt()
		let alg = coseAlgorithm(algNumber)
		fail "webauthn: tpm attestation algorithm {algNumber} is not supported" when alg is none
		let sig = try statement.get("sig").asBytes()
		let certInfo = try statement.get("certInfo").asBytes()
		let pubArea = try statement.get("pubArea").asBytes()
		fail "webauthn: tpm attestation needs an x5c chain" when !statement.has("x5c")

		// pubArea (TPMT_PUBLIC) must describe the credential key.
		let p = new TPMReader(pubArea)
		let keyType = try p.u16()
		let nameAlg = try p.u16()
		try p.u32()
		try p.sized()
		let cred = authData.credentialKey.key
		if keyType == tpmAlgRSA {
			fail "webauthn: tpm pubArea is RSA but the credential key is not" unless cred is RSAPublicKey
			let rsa RSAPublicKey = cred
			let symmetric = try p.u16()
			fail "webauthn: tpm pubArea of a signing key has a symmetric algorithm" when symmetric != tpmAlgNull
			try tpmSkipScheme(p)
			try p.u16()
			let exponent = int(try p.u32())
			exponent = 65537 when exponent == 0
			let n = try p.sized()
			fail "webauthn: tpm pubArea RSA key differs from the credential key" when parseBigInt(n) != rsa.n || exponent != rsa.e
		} else if keyType == tpmAlgECC {
			fail "webauthn: tpm pubArea is ECC but the credential key is not" unless cred is ECDSAPublicKey
			let ec ECDSAPublicKey = cred
			let symmetric = try p.u16()
			fail "webauthn: tpm pubArea of a signing key has a symmetric algorithm" when symmetric != tpmAlgNull
			try tpmSkipScheme(p)
			let curveId = try p.u16()
			try tpmSkipScheme(p)
			let curveName = curveId == 3 ?? ("P-256", curveId == 4 ?? ("P-384", curveId == 5 ?? ("P-521", "")))
			fail "webauthn: tpm pubArea curve differs from the credential key" when curveName != ec.curve.name
			let x = try p.sized()
			let y = try p.sized()
			fail "webauthn: tpm pubArea ECC key differs from the credential key" when parseBigInt(x) != ec.point.x || parseBigInt(y) != ec.point.y
		} else {
			fail "webauthn: tpm pubArea key type {keyType} is not supported"
		}
		fail "webauthn: tpm pubArea has trailing bytes" when !p.done()

		// certInfo (TPMS_ATTEST) must certify that key over this ceremony.
		let c = new TPMReader(certInfo)
		fail "webauthn: tpm certInfo magic is not TPM_GENERATED_VALUE" when (try c.u32()) != uint32(0xFF544347)
		fail "webauthn: tpm certInfo type is not TPM_ST_ATTEST_CERTIFY" when (try c.u16()) != 0x8017
		try c.sized()
		let extraData = try c.sized()
		fail "webauthn: tpm certInfo extraData does not match the ceremony" when !extraData.equals(digest(coseHash(alg), authData.raw + clientDataHash))
		try c.bytes(17)
		try c.bytes(8)
		let name = try c.sized()
		try c.sized()
		fail "webauthn: tpm certInfo has trailing bytes" when !c.done()
		let want byte[] = [byte(nameAlg >> 8), byte(nameAlg & 0xFF)]
		want.push(...digest(try tpmHash(nameAlg), pubArea))
		fail "webauthn: tpm certInfo name does not match pubArea" when !name.equals(want)

		// The AIK certificate signed certInfo and follows the TPM profile.
		r.chain = try attestationChain(statement)
		let aik = r.chain[0]
		fail "webauthn: tpm attestation signature does not verify" when !coseVerify(alg, try certificateKey(aik), certInfo, sig)
		fail "webauthn: tpm AIK certificate is not version 3" when aik.version != 3
		fail "webauthn: tpm AIK certificate subject must be empty" when !aik.subject.isEmpty()
		try tpmCheckSubjectAltName(aik)
		let aikUsage = false
		for let (_, oid) in aik.unknownExtKeyUsage {
			aikUsage = true when oid.equals(oidTCGKpAIKCertificate)
		}
		fail "webauthn: tpm AIK certificate lacks the tcg-kp-AIKCertificate key usage" when !aikUsage
		fail "webauthn: tpm AIK certificate must not be a CA" when !aik.basicConstraintsValid || aik.isCA
		try checkAAGUIDExtension(aik, authData)
		r.kind = AttestationType.AttCA
		return none
	}

	// Checks that an AIK certificate's subject alternative name holds a
	// directory name with the TPM manufacturer, model and version.
	def tpmCheckSubjectAltName(aik Certificate) !none {
		let seen = 0
		for let (_, ext) in aik.extensions {
			continue when !ext.id.equals(x509.oidExtSubjectAltName)
			let names = try asn1Parse(ext.value)
			for let (_, general) in names.children {
				continue when !general.isContext(4)
				let dn = try general.inner()
				for let (_, rdn) in dn.children {
					for let (_, atv) in rdn.children {
						let oid = try (try atv.at(0)).asOID()
						seen |= 1 when oid.equals(oidTCGManufacturer)
						seen |= 2 when oid.equals(oidTCGModel)
						seen |= 4 when oid.equals(oidTCGVersion)
					}
				}
			}
		}
		fail "webauthn: tpm AIK certificate subject alternative name lacks the TPM manufacturer, model or version" when seen != 7
		return none
	}
}
