internal partial module std.proto.auth.webauthn.json {
	use (
		std.data.encoding::(Base64, json)
		std.proto.auth.webauthn::*
		std.proto.auth.webauthn.cose::*
		std.proto.auth.webauthn.formats::*
		std.proto.auth.webauthn.ctap::*
	)

	// A JSON string as §5.8.1.2 writes it: quotes, `"` and `\` escaped,
	// U+0000 to U+001F as `\u00xx`, everything else as is.
	def ccdString(text string) string {
		let out = "\""
		for let (_, ch) in text {
			if ch := '"' || '\\' {
				out += "\\" + string(ch)
			} else if int(ch) < 0x20 {
				let hex = "0123456789abcdef"
				out += "\\u00" + string(hex[int(ch) >> 4]) + string(hex[int(ch) & 0x0F])
			} else {
				out += string(ch)
			}
		}
		return out + "\""
	}

	// Base64url without padding, the form WebAuthn JSON carries bytes in.
	def base64url(data byte[]) string {
		let b = new Base64()
		b.urlSafe = true
		b.padded = false
		return b.encode(data)
	}

	// Reads base64url, with or without padding. The standard alphabet's `+`
	// and `/` are read too, as some clients send them. Fails when the text
	// is not base64.
	def fromBase64url(text string) !byte[] {
		let b = new Base64()
		b.urlSafe = true
		b.padded = false
		return try b.decode(text.replace("+", "-").replace("/", "_").trimSuffix("=").trimSuffix("="))
	}

	// A JSON array of credential descriptors.
	def descriptorsJSON(list CredentialDescriptor[]) string {
		let out = "["
		for let (i, d) in list {
			out += "," when i > 0
			out += "\{\"type\":\"public-key\",\"id\":" + ccdString(base64url(d.id))
			out += ",\"transports\":" + stringsJSON(d.transports) when d.transports.len() > 0
			out += "\}"
		}
		return out + "]"
	}

	// A JSON array of strings.
	def stringsJSON(list string[]) string {
		let out = "["
		for let (i, s) in list {
			out += "," when i > 0
			out += ccdString(s)
		}
		return out + "]"
	}

	// A prf values object: first, and second when set.
	def prfJSON(v PRFValues) string {
		let out = "\{\"first\":" + ccdString(base64url(v.first))
		out += ",\"second\":" + ccdString(base64url(v.second)) when v.second.len() > 0
		return out + "\}"
	}

	// The descriptors of a JSON credential list, public-key ones only.
	def jsonDescriptors(v ?any) !CredentialDescriptor[] {
		let out CredentialDescriptor[] = []
		for let (_, d) in jsonArray(v) {
			let m = jsonObject(d)
			continue when jsonString(m.get("type")) != "public-key"
			out.push(CredentialDescriptor{id: try fromBase64url(jsonString(m.get("id"))), transports: jsonStrings(m.get("transports"))})
		}
		return out
	}

	// A prf values object: first and second, base64url.
	def jsonPRF(v ?any) !PRFValues {
		let m = jsonObject(v)
		return PRFValues{first: try fromBase64url(jsonString(m.get("first"))), second: try fromBase64url(jsonString(m.get("second")))}
	}

	// A userVerification string; Preferred, the default, for anything else.
	def jsonUserVerification(v ?any) UserVerification {
		match jsonString(v) {
			case "required":
				return UserVerification.Required
			case "discouraged":
				return UserVerification.Discouraged
			default:
				return UserVerification.Preferred
		}
	}

	// A JSON object as a map; empty for anything else.
	def jsonObject(v ?any) map<string, any> {
		let nothing map<string, any> = {}
		match v {
			case map<string, any>:
				return v
			default:
				return nothing
		}
	}

	// A JSON array; empty for anything else.
	def jsonArray(v ?any) any[] {
		let nothing any[] = []
		match v {
			case any[]:
				return v
			default:
				return nothing
		}
	}

	// A JSON string; "" for anything else.
	def jsonString(v ?any) string {
		match v {
			case string:
				return v
			default:
				return ""
		}
	}

	// A JSON integer; 0 for anything else.
	def jsonInt(v ?any) int {
		match v {
			case int:
				return v
			case float:
				return int(v)
			default:
				return 0
		}
	}

	// A JSON boolean; false for anything else.
	def jsonBool(v ?any) bool {
		match v {
			case bool:
				return v
			default:
				return false
		}
	}

	// The strings of a JSON array, skipping anything else.
	def jsonStrings(v ?any) string[] {
		let out string[] = []
		for let (_, s) in jsonArray(v) {
			let text = jsonString(s)
			out.push(text) when text != ""
		}
		return out
	}

	// The credential id from a response's id and rawId. Fails when they
	// differ or are not base64url.
	def responseId(id string, rawId string) !byte[] {
		let a = try fromBase64url(id)
		fail "webauthn: credential has no id" when a.len() == 0
		if rawId != "" {
			fail "webauthn: id and rawId differ" when !a.equals(try fromBase64url(rawId))
		}
		return a
	}
}
