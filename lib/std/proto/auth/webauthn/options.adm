partial module std.proto.auth.webauthn {
	use (
		std.time::(Time)
		std.proto.auth.webauthn.json::*
	)

	// RegistrationOptions is one registration ceremony: the options sent
	// to the client (`json()` gives `PublicKeyCredentialCreationOptionsJSON`
	// for `PublicKeyCredential.parseCreationOptionsFromJSON`) and the state
	// the relying party keeps until the response comes back.
	type RegistrationOptions {
		// The relying party id and name.
		rpId   string
		rpName string

		user User = User{}

		// The random challenge the client data must echo.
		challenge byte[]

		// The algorithms accepted, most preferred first.
		algorithms COSEAlgorithm[]

		// How long the client may take.
		timeout duration = 300s

		// Credentials the user already has, so an authenticator holding one
		// declines.
		exclude CredentialDescriptor[]

		attachment       Attachment            = Attachment.Any
		residentKey      ResidentKey           = ResidentKey.Preferred
		userVerification UserVerification      = UserVerification.Preferred
		attestation      AttestationConveyance = AttestationConveyance.None

		// Attestation statement formats preferred, most preferred first;
		// empty leaves the choice to the authenticator.
		attestationFormats string[]

		// Hints for the client's UI: "security-key", "client-device", "hybrid".
		hints string[]

		// A conditional (automatic, passkey upgrade) registration, where the
		// authenticator may skip the user presence test.
		conditional bool

		// The extensions asked for; credProps is always asked for.
		extensions RegistrationExtensions = RegistrationExtensions{}

		// When the ceremony began.
		created Time

		def new() {}

		// The options as `PublicKeyCredentialCreationOptionsJSON`.
		def json() string {
			let out = "\{\"rp\":\{\"id\":" + ccdString(rpId) + ",\"name\":" + ccdString(rpName) + "\}"
			out += ",\"user\":\{\"id\":" + ccdString(base64url(user.id)) + ",\"name\":" + ccdString(user.name) + ",\"displayName\":" + ccdString(user.displayName) + "\}"
			out += ",\"challenge\":" + ccdString(base64url(challenge))
			out += ",\"pubKeyCredParams\":["
			for let (i, alg) in algorithms {
				out += "," when i > 0
				out += "\{\"type\":\"public-key\",\"alg\":{alg.value}\}"
			}
			out += "],\"timeout\":{timeout.milliseconds()}"
			out += ",\"excludeCredentials\":" + descriptorsJSON(exclude)
			out += ",\"authenticatorSelection\":\{"
			out += "\"authenticatorAttachment\":" + ccdString(attachment.value) + "," when attachment != Attachment.Any
			out += "\"residentKey\":" + ccdString(residentKey.value)
			out += ",\"requireResidentKey\":" + (residentKey == ResidentKey.Required ?? ("true", "false"))
			out += ",\"userVerification\":" + ccdString(userVerification.value) + "\}"
			out += ",\"attestation\":" + ccdString(attestation.value)
			out += ",\"attestationFormats\":" + stringsJSON(attestationFormats) when attestationFormats.len() > 0
			out += ",\"hints\":" + stringsJSON(hints) when hints.len() > 0
			let e = extensions
			out += ",\"extensions\":\{\"credProps\":true"
			out += ",\"credentialProtectionPolicy\":" + ccdString(e.credentialProtection.value) when e.credentialProtection != CredentialProtection.None
			out += ",\"enforceCredentialProtectionPolicy\":true" when e.enforceCredentialProtection
			out += ",\"largeBlob\":\{\"support\":" + ccdString(e.largeBlob.value) + "\}" when e.largeBlob != LargeBlobSupport.None
			out += ",\"prf\":\{\}" when e.prf
			out += ",\"credBlob\":" + ccdString(base64url(e.credBlob)) when e.credBlob.len() > 0
			out += ",\"minPinLength\":true" when e.minPinLength
			out += ",\"appidExclude\":" + ccdString(e.appidExclude) when e.appidExclude != ""
			return out + "\}\}"
		}
	}

	// AuthenticationOptions is one authentication ceremony: the options
	// sent to the client (`json()` gives
	// `PublicKeyCredentialRequestOptionsJSON`) and the state kept until the
	// response comes back.
	type AuthenticationOptions {
		rpId string

		// The random challenge the client data must echo.
		challenge byte[]

		timeout duration = 300s

		// The credentials that may answer; empty lets the user pick any
		// discoverable credential for the relying party (passkey sign-in).
		allow CredentialDescriptor[]

		userVerification UserVerification = UserVerification.Preferred

		hints string[]

		// The FIDO AppID (`appid` extension) of credentials registered with
		// U2F; "" for none.
		appid string

		// A conditional (autofill) request.
		conditional bool

		// The extensions asked for, besides appid.
		extensions AuthenticationExtensions = AuthenticationExtensions{}

		// When the ceremony began.
		created Time

		def new() {}

		// The options as `PublicKeyCredentialRequestOptionsJSON`.
		def json() string {
			let out = "\{\"challenge\":" + ccdString(base64url(challenge))
			out += ",\"timeout\":{timeout.milliseconds()}"
			out += ",\"rpId\":" + ccdString(rpId)
			out += ",\"allowCredentials\":" + descriptorsJSON(allow)
			out += ",\"userVerification\":" + ccdString(userVerification.value)
			out += ",\"hints\":" + stringsJSON(hints) when hints.len() > 0
			let e = extensions
			let ext string[] = []
			ext.push("\"appid\":" + ccdString(appid)) when appid != ""
			let prf string[] = []
			prf.push("\"eval\":" + prfJSON(e.prf)) when e.prf.first.len() > 0
			if e.prfByCredential.len() > 0 {
				let by string[] = []
				for let (id, v) in e.prfByCredential {
					by.push(ccdString(id) + ":" + prfJSON(v))
				}
				prf.push("\"evalByCredential\":\{" + by.join(",") + "\}")
			}
			ext.push("\"prf\":\{" + prf.join(",") + "\}") when prf.len() > 0
			ext.push("\"largeBlob\":\{\"read\":true\}") when e.largeBlobRead
			ext.push("\"largeBlob\":\{\"write\":" + ccdString(base64url(e.largeBlobWrite)) + "\}") when e.largeBlobWrite.len() > 0
			ext.push("\"getCredBlob\":true") when e.getCredBlob
			out += ",\"extensions\":\{" + ext.join(",") + "\}" when ext.len() > 0
			return out + "\}"
		}
	}
}
