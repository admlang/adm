partial module std.proto.auth.webauthn {
	use (
		std.data.encoding::(JSON)
		std.time
		std.proto.auth.webauthn.json::*
	)

	// Reads `PublicKeyCredentialCreationOptionsJSON`, what a relying party
	// sends a client to start a registration. Algorithms and values a
	// client does not know are skipped or read as their defaults, as
	// WebAuthn asks of clients. Fails when the text is not a JSON object,
	// lacks rp.id, user.id or the challenge, or a byte field is not
	// base64url.
	def parseRegistrationOptions(text string) !RegistrationOptions {
		let doc = jsonObject(try new JSON().parse(text))
		let o = new RegistrationOptions()
		let rp = jsonObject(doc.get("rp"))
		o.rpId = jsonString(rp.get("id"))
		o.rpName = jsonString(rp.get("name"))
		let user = jsonObject(doc.get("user"))
		o.user = User{id: try fromBase64url(jsonString(user.get("id"))), name: jsonString(user.get("name")), displayName: jsonString(user.get("displayName"))}
		o.challenge = try fromBase64url(jsonString(doc.get("challenge")))
		fail "webauthn: creation options need rp.id, user.id and a challenge" when o.rpId == "" || o.user.id.len() == 0 || o.challenge.len() == 0
		for let (_, p) in jsonArray(doc.get("pubKeyCredParams")) {
			let param = jsonObject(p)
			continue when jsonString(param.get("type")) != "public-key"
			let alg = coseAlgorithm(jsonInt(param.get("alg")))
			o.algorithms.push(alg) unless alg is none
		}
		let ms = jsonInt(doc.get("timeout"))
		o.timeout = duration(int64(ms) * 1000000) when ms > 0
		o.exclude = try jsonDescriptors(doc.get("excludeCredentials"))
		let sel = jsonObject(doc.get("authenticatorSelection"))
		match jsonString(sel.get("authenticatorAttachment")) {
			case "platform":
				o.attachment = Attachment.Platform
			case "cross-platform":
				o.attachment = Attachment.CrossPlatform
			default:
				o.attachment = Attachment.Any
		}
		match jsonString(sel.get("residentKey")) {
			case "required":
				o.residentKey = ResidentKey.Required
			case "preferred":
				o.residentKey = ResidentKey.Preferred
			case "discouraged":
				o.residentKey = ResidentKey.Discouraged
			default:
				o.residentKey = jsonBool(sel.get("requireResidentKey")) ?? (ResidentKey.Required, ResidentKey.Discouraged)
		}
		o.userVerification = jsonUserVerification(sel.get("userVerification"))
		match jsonString(doc.get("attestation")) {
			case "indirect":
				o.attestation = AttestationConveyance.Indirect
			case "direct":
				o.attestation = AttestationConveyance.Direct
			case "enterprise":
				o.attestation = AttestationConveyance.Enterprise
			default:
				o.attestation = AttestationConveyance.None
		}
		o.attestationFormats = jsonStrings(doc.get("attestationFormats"))
		o.hints = jsonStrings(doc.get("hints"))

		let ext = jsonObject(doc.get("extensions"))
		let e = RegistrationExtensions{}
		match jsonString(ext.get("credentialProtectionPolicy")) {
			case "userVerificationOptional":
				e.credentialProtection = CredentialProtection.Optional
			case "userVerificationOptionalWithCredentialIDList":
				e.credentialProtection = CredentialProtection.OptionalWithCredentialIDList
			case "userVerificationRequired":
				e.credentialProtection = CredentialProtection.Required
			default:
		}
		e.enforceCredentialProtection = jsonBool(ext.get("enforceCredentialProtectionPolicy"))
		match jsonString(jsonObject(ext.get("largeBlob")).get("support")) {
			case "required":
				e.largeBlob = LargeBlobSupport.Required
			case "preferred":
				e.largeBlob = LargeBlobSupport.Preferred
			default:
		}
		e.prf = ext.hasKey("prf")
		e.credBlob = try fromBase64url(jsonString(ext.get("credBlob")))
		e.minPinLength = jsonBool(ext.get("minPinLength"))
		e.appidExclude = jsonString(ext.get("appidExclude"))
		o.extensions = e
		o.created = time.now()
		return o
	}

	// Reads `PublicKeyCredentialRequestOptionsJSON`, what a relying party
	// sends a client to start an authentication. Fails when the text is not
	// a JSON object, lacks the challenge, or a byte field is not base64url.
	def parseAuthenticationOptions(text string) !AuthenticationOptions {
		let doc = jsonObject(try new JSON().parse(text))
		let o = new AuthenticationOptions()
		o.challenge = try fromBase64url(jsonString(doc.get("challenge")))
		fail "webauthn: request options need a challenge" when o.challenge.len() == 0
		let ms = jsonInt(doc.get("timeout"))
		o.timeout = duration(int64(ms) * 1000000) when ms > 0
		o.rpId = jsonString(doc.get("rpId"))
		o.allow = try jsonDescriptors(doc.get("allowCredentials"))
		o.userVerification = jsonUserVerification(doc.get("userVerification"))
		o.hints = jsonStrings(doc.get("hints"))
		let ext = jsonObject(doc.get("extensions"))
		o.appid = jsonString(ext.get("appid"))
		let e = AuthenticationExtensions{}
		let prf = jsonObject(ext.get("prf"))
		e.prf = try jsonPRF(prf.get("eval"))
		for let (id, v) in jsonObject(prf.get("evalByCredential")) {
			e.prfByCredential[id] = try jsonPRF(v)
		}
		let blob = jsonObject(ext.get("largeBlob"))
		e.largeBlobRead = jsonBool(blob.get("read"))
		e.largeBlobWrite = try fromBase64url(jsonString(blob.get("write")))
		e.getCredBlob = jsonBool(ext.get("getCredBlob"))
		o.extensions = e
		o.created = time.now()
		return o
	}
}
