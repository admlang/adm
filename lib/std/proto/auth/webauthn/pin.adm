partial module std.proto.auth.webauthn {
	use (
		std.crypto
		std.crypto.cipher
		std.crypto.hash::(Hash, digest, hmac, hkdf)
		std.data.encoding::(CBORValue)
		std.proto.auth.webauthn.ctap::*
	)

	// Permissions a PIN/UV auth token is granted for (CTAP 2.2 §6.5.5.7).
	enum PinPermission {
		MakeCredential = 0x01,
		GetAssertion = 0x02,
		CredentialManagement = 0x04,
		BioEnrollment = 0x08,
		LargeBlobWrite = 0x10,
		AuthenticatorConfig = 0x20,
		PersistentCredentialManagementReadOnly = 0x40
	}

	// PinProtocol is a PIN/UV auth protocol (CTAP 2.2 §6.5.6 and §6.5.7):
	// the ECDH key agreement over P-256 that the platform and the
	// authenticator share a secret through, and the encryption and MAC
	// they protect PINs and tokens with. Version 1 derives one key with
	// SHA-256 and encrypts with a zero IV; version 2 derives separate HMAC
	// and AES keys with HKDF and sends a random IV.
	type PinProtocol {
		// 1 or 2.
		version int = 2

		def new(version int) {
			self.version = version
		}

		// A fresh key-agreement key: its scalar and its COSE_Key (EC2 P-256,
		// alg -25, ECDH-ES+HKDF-256). Fails when the random source is
		// unavailable.
		def keyPair() !(bigint, CBORValue) {
			let pair = try crypto.ecdhKeyPair(crypto.p256)
			return (pair.scalar, pinCOSEKey(pair.public))
		}

		// The shared secret from our scalar and the peer's key-agreement
		// COSE_Key: 32 bytes for version 1, the HMAC key and the AES key (64
		// bytes) for version 2. Fails when the peer key is not an EC2 P-256
		// point on the curve.
		def sharedSecret(scalar bigint, peer CBORValue) !byte[] {
			let x = try peer.get(-2).asBytes()
			let y = try peer.get(-3).asBytes()
			fail "ctap: key agreement key is not EC2 P-256" when (try peer.get(1).asInt()) != 2 || (try peer.get(-1).asInt()) != 1 || x.len() != 32 || y.len() != 32
			let point = try crypto.unmarshalPoint(crypto.p256, byte[4] + x + y)
			let z = try crypto.ecdh(crypto.p256, scalar, point)
			return try kdf(z)
		}

		// The key derivation of the protocol from the ECDH x-coordinate Z.
		// Fails only when HKDF does.
		def kdf(z byte[]) !byte[] {
			return digest(Hash.SHA256, z) when version == 1
			let salt byte[]
			salt.len(32)
			let hmacKey = try hkdf(Hash.SHA256, z, salt, "CTAP2 HMAC key".bytes(), 32)
			let aesKey = try hkdf(Hash.SHA256, z, salt, "CTAP2 AES key".bytes(), 32)
			return hmacKey + aesKey
		}

		// Encrypts with AES-256-CBC under the shared secret: a zero IV for
		// version 1, a random IV prepended for version 2. Fails when the
		// plaintext is not whole blocks or the random source is unavailable.
		def encrypt(shared byte[], plaintext byte[]) !byte[] {
			let iv byte[]
			iv.len(16)
			iv = try crypto.rand(16) when version == 2
			let cbc = try cipher.newCBC(try cipher.newAES(aesKey(shared)), iv)
			let ct = try cbc.encrypt(plaintext)
			return version == 2 ?? (iv + ct, ct)
		}

		// Decrypts what encrypt produced. Fails when the ciphertext is not
		// whole blocks.
		def decrypt(shared byte[], ciphertext byte[]) !byte[] {
			let iv byte[]
			iv.len(16)
			let body = ciphertext
			if version == 2 {
				fail "ctap: ciphertext is shorter than its IV" when ciphertext.len() < 16
				iv = ciphertext.slice(0, 16)
				body = ciphertext.slice(16, ciphertext.len() - 16)
			}
			let cbc = try cipher.newCBC(try cipher.newAES(aesKey(shared)), iv)
			return try cbc.decrypt(body)
		}

		// The MAC of a message: HMAC-SHA-256 under the key (for version 2 the
		// first 32 bytes of a shared secret), the first 16 bytes of it for
		// version 1.
		def authenticate(key byte[], message byte[]) byte[] {
			let k = key.len() > 32 ?? (key.slice(0, 32), key)
			let mac = hmac(Hash.SHA256, k, message)
			return version == 1 ?? (mac.slice(0, 16), mac)
		}

		// Reports whether a signature is the MAC of a message, in constant
		// time.
		def verify(key byte[], message byte[], signature byte[]) bool {
			return crypto.constantTimeEqual(authenticate(key, message), signature)
		}

		// The AES key of a shared secret.
		internal def aesKey(shared byte[]) byte[] {
			return version == 2 && shared.len() == 64 ?? (shared.slice(32, 32), shared.slice(0, 32))
		}
	}
}
