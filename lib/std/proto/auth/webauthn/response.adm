partial module std.proto.auth.webauthn {
	use (
		std.data.encoding::(JSON, json)
		std.proto.auth.webauthn.json::*
	)

	// RegistrationResponse is what the client returns from a registration
	// ceremony (`navigator.credentials.create`).
	type RegistrationResponse {
		// The new credential's id.
		id byte[]

		// The collected client data, as the client serialized it.
		clientDataJSON byte[]

		// The CBOR attestation object: fmt, authData and attStmt.
		attestationObject byte[]

		// The transports the authenticator reported.
		transports string[]

		// "platform" or "cross-platform"; "" when the client did not say.
		attachment string

		// What the credProps extension reported: whether the credential is
		// discoverable, and whether the client said at all.
		discoverable      bool
		discoverableKnown bool

		// prf: whether it is enabled for the credential.
		prfEnabled bool

		// largeBlob: whether the credential has large-blob storage.
		largeBlobSupported bool

		// appidExclude: whether the client checked the AppID's credentials.
		appidExclude bool

		def new() {}

		// The response as `RegistrationResponseJSON`, the form
		// `PublicKeyCredential.toJSON()` gives.
		def json() string {
			let out = "\{\"id\":" + ccdString(base64url(id)) + ",\"rawId\":" + ccdString(base64url(id))
			out += ",\"type\":\"public-key\",\"response\":\{\"clientDataJSON\":" + ccdString(base64url(clientDataJSON))
			out += ",\"attestationObject\":" + ccdString(base64url(attestationObject))
			out += ",\"transports\":" + stringsJSON(transports) + "\}"
			out += ",\"authenticatorAttachment\":" + ccdString(attachment) when attachment != ""
			out += ",\"clientExtensionResults\":\{"
			let ext string[] = []
			ext.push("\"credProps\":\{\"rk\":" + (discoverable ?? ("true", "false")) + "\}") when discoverableKnown
			ext.push("\"prf\":\{\"enabled\":true\}") when prfEnabled
			ext.push("\"largeBlob\":\{\"supported\":true\}") when largeBlobSupported
			ext.push("\"appidExclude\":true") when appidExclude
			out += ext.join(",")
			return out + "\}\}"
		}
	}

	// AuthenticationResponse is what the client returns from an
	// authentication ceremony (`navigator.credentials.get`).
	type AuthenticationResponse {
		// The id of the credential that answered.
		id byte[]

		clientDataJSON    byte[]
		authenticatorData byte[]
		signature         byte[]

		// The user handle a discoverable credential returns; empty otherwise.
		userHandle byte[]

		// "platform" or "cross-platform"; "" when the client did not say.
		attachment string

		// Whether the client used the appid extension's AppID as the
		// relying party id.
		appid bool

		// prf: the evaluated outputs; empty when not asked for or the
		// credential has no prf.
		prf PRFValues = PRFValues{}

		// largeBlob: the blob read, and whether a write succeeded.
		largeBlob        byte[]
		largeBlobWritten bool

		def new() {}

		// The response as `AuthenticationResponseJSON`.
		def json() string {
			let out = "\{\"id\":" + ccdString(base64url(id)) + ",\"rawId\":" + ccdString(base64url(id))
			out += ",\"type\":\"public-key\",\"response\":\{\"clientDataJSON\":" + ccdString(base64url(clientDataJSON))
			out += ",\"authenticatorData\":" + ccdString(base64url(authenticatorData))
			out += ",\"signature\":" + ccdString(base64url(signature))
			out += ",\"userHandle\":" + ccdString(base64url(userHandle)) when userHandle.len() > 0
			out += "\}"
			out += ",\"authenticatorAttachment\":" + ccdString(attachment) when attachment != ""
			out += ",\"clientExtensionResults\":\{"
			let ext string[] = []
			ext.push("\"appid\":true") when appid
			if prf.first.len() > 0 {
				let results = "\"first\":" + ccdString(base64url(prf.first))
				results += ",\"second\":" + ccdString(base64url(prf.second)) when prf.second.len() > 0
				ext.push("\"prf\":\{\"results\":\{" + results + "\}\}")
			}
			ext.push("\"largeBlob\":\{\"blob\":" + ccdString(base64url(largeBlob)) + "\}") when largeBlob.len() > 0
			ext.push("\"largeBlob\":\{\"written\":true\}") when largeBlobWritten
			out += ext.join(",")
			return out + "\}\}"
		}
	}

	// Reads a `RegistrationResponseJSON`. Fails when the text is not JSON
	// of that shape, the type is not "public-key", a field is not
	// base64url, or id and rawId differ.
	def parseRegistrationResponse(text string) !RegistrationResponse {
		let j = RegistrationJSON{}
		try new JSON().decode(text, j)
		fail "webauthn: credential type {j.kind} is not public-key" when j.kind != "public-key"
		let r = new RegistrationResponse()
		r.id = try responseId(j.id, j.rawId)
		r.clientDataJSON = try fromBase64url(j.response.clientDataJSON)
		r.attestationObject = try fromBase64url(j.response.attestationObject)
		r.transports = j.response.transports
		r.attachment = j.authenticatorAttachment
		let ext = j.clientExtensionResults
		r.discoverableKnown = ext.credProps.hasKey("rk")
		r.discoverable = r.discoverableKnown && ext.credProps["rk"]
		r.prfEnabled = ext.prf.enabled
		r.largeBlobSupported = ext.largeBlob.supported
		r.appidExclude = ext.appidExclude
		return r
	}

	// Reads an `AuthenticationResponseJSON`. Fails as
	// parseRegistrationResponse does.
	def parseAuthenticationResponse(text string) !AuthenticationResponse {
		let j = AuthenticationJSON{}
		try new JSON().decode(text, j)
		fail "webauthn: credential type {j.kind} is not public-key" when j.kind != "public-key"
		let r = new AuthenticationResponse()
		r.id = try responseId(j.id, j.rawId)
		r.clientDataJSON = try fromBase64url(j.response.clientDataJSON)
		r.authenticatorData = try fromBase64url(j.response.authenticatorData)
		r.signature = try fromBase64url(j.response.signature)
		r.userHandle = try fromBase64url(j.response.userHandle)
		r.attachment = j.authenticatorAttachment
		let ext = j.clientExtensionResults
		r.appid = ext.appid
		r.prf = PRFValues{first: try fromBase64url(ext.prf.results.first), second: try fromBase64url(ext.prf.results.second)}
		r.largeBlob = try fromBase64url(ext.largeBlob.blob)
		r.largeBlobWritten = ext.largeBlob.written
		return r
	}

	internal struct PRFResultsJSON {
		first  string
		second string
	}

	internal struct PRFJSON {
		enabled bool
		results PRFResultsJSON
	}

	internal struct LargeBlobJSON {
		supported bool
		blob      string
		written   bool
	}

	internal struct ExtensionResultsJSON {
		// credProps.rk, absent when the client did not report it.
		credProps    map<string, bool>
		appid        bool
		appidExclude bool
		prf          PRFJSON
		largeBlob    LargeBlobJSON
	}

	internal struct AttestationResponseJSON {
		clientDataJSON    string
		attestationObject string
		transports        string[]
	}

	internal struct RegistrationJSON {
		id    string
		rawId string

		@json("type")
		kind string

		response                AttestationResponseJSON
		authenticatorAttachment string
		clientExtensionResults  ExtensionResultsJSON
	}

	internal struct AssertionResponseJSON {
		clientDataJSON    string
		authenticatorData string
		signature         string
		userHandle        string
	}

	internal struct AuthenticationJSON {
		id    string
		rawId string

		@json("type")
		kind string

		response                AssertionResponseJSON
		authenticatorAttachment string
		clientExtensionResults  ExtensionResultsJSON
	}
}
