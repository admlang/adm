partial module std.proto.auth.webauthn {
	use (
		std.crypto
		std.crypto.hash::(Hash, digest)
		std.crypto.x509::(CertPool)
		std.data.encoding::(CBOR, CBORKind)
		std.time
		std.time::(Time)
		std.proto.auth.webauthn.json::*
		std.proto.auth.webauthn.formats::*
	)

	// AuthenticationResult is a successful sign-in.
	type AuthenticationResult {
		// The credential record with its counter, backup state and user
		// verification brought up to date: the record passed in, updated in
		// place. Store it back.
		credential Credential = new Credential()

		// Whether the authenticator verified the user this time.
		userVerified bool

		// Whether the signature counter failed to advance though the
		// authenticator keeps one: a sign the credential may have been
		// cloned (WebAuthn §6.1.1). What to do about it is the relying
		// party's call.
		counterWarning bool

		// The prf outputs the client reported.
		prf PRFValues = PRFValues{}

		// The large blob the client read, and whether its write succeeded.
		largeBlob        byte[]
		largeBlobWritten bool

		// The credBlob the authenticator returned.
		credBlob byte[]

		def new() {}
	}

	// RelyingParty runs WebAuthn ceremonies for one relying party id: it
	// makes the options a client needs and verifies what comes back
	// (WebAuthn §7).
	//
	//     let rp = new RelyingParty("example.com", "Example", "https://example.com")
	//     let reg = try rp.beginRegistration(User{id: userId, name: "alice", displayName: "Alice"})
	//     // send reg.json(), keep reg; then:
	//     let cred = try rp.finishRegistration(reg, responseJSON)
	//
	//     let auth = try rp.beginAuthentication([cred.descriptor()])
	//     let response = try parseAuthenticationResponse(json)
	//     let result = try rp.finishAuthentication(auth, response, storedCredentialWith(response.id))
	//
	// Storing credentials, and refusing a registration whose credential id
	// is already registered, is the caller's part.
	type RelyingParty {
		// The relying party id: a registrable domain the origins are on.
		id string

		// The name shown to the user.
		name string

		// The origins the client data may name, such as "https://example.com".
		origins string[]

		// The top-level origins that may embed a ceremony in a cross-origin
		// frame; empty refuses cross-origin ceremonies.
		topOrigins string[]

		// The credential algorithms accepted, most preferred first.
		algorithms COSEAlgorithm[] = [COSEAlgorithm.EdDSA, COSEAlgorithm.ES256, COSEAlgorithm.RS256]

		// How long a client may take before a ceremony expires.
		timeout duration = 300s

		userVerification UserVerification = UserVerification.Preferred

		// The attestation asked for at registration.
		attestation AttestationConveyance = AttestationConveyance.None

		// The roots attestation chains are verified against; none leaves
		// attestation chains unverified (AttestationResult.trusted false).
		attestationRoots ?CertPool = none

		// Refuse registrations whose attestation does not chain to
		// attestationRoots, including self and none attestation.
		requireTrustedAttestation bool

		def new(id string, name string, origins ...string) {
			self.id = id
			self.name = name
			self.origins = origins
		}

		// Starts a registration ceremony for a user. exclude lists the
		// credentials the user already has. Fails when the user handle is
		// empty or longer than 64 bytes, or the random source is unavailable.
		def beginRegistration(user User, exclude CredentialDescriptor[] = [], residentKey ResidentKey = ResidentKey.Preferred, attachment Attachment = Attachment.Any, extensions RegistrationExtensions = RegistrationExtensions{}) !RegistrationOptions {
			expects {
				assert user.id.len() != 0 && user.id.len() <= 64 onerror fail "webauthn: the user handle must be 1 to 64 bytes"
			}
			let o = new RegistrationOptions()
			o.rpId = id
			o.rpName = name
			o.user = user
			o.challenge = try crypto.rand(32)
			o.algorithms = algorithms
			o.timeout = timeout
			o.exclude = exclude
			o.attachment = attachment
			o.residentKey = residentKey
			o.userVerification = userVerification
			o.attestation = attestation
			o.extensions = extensions
			o.created = time.now()
			return o
		}

		// Finishes a registration from the client's
		// `RegistrationResponseJSON`. Fails as finishRegistration with a
		// parsed response does, or when the JSON does not parse.
		def finishRegistration(options RegistrationOptions, responseJSON string) !Credential {
			return try finishRegistration(options, try parseRegistrationResponse(responseJSON))
		}

		// Finishes a registration (WebAuthn §7.1): checks the client data
		// against the options and this relying party, the authenticator
		// data, the credential's algorithm and the attestation statement,
		// and returns the credential record to store. Fails when the
		// ceremony expired or any check does not hold.
		def finishRegistration(options RegistrationOptions, response RegistrationResponse) !Credential {
			try checkExpiry(options.created, options.timeout)
			let c = try parseClientData(response.clientDataJSON)
			try checkClientData(c, "webauthn.create", options.challenge)

			let obj = try new CBOR().parse(response.attestationObject)
			let fmt = try obj.get("fmt").asString()
			let authData = try parseAuthenticatorData(try obj.get("authData").asBytes())
			let statement = obj.get("attStmt")
			fail "webauthn: attestation object has no attStmt map" when statement.kind != CBORKind.Map && statement.kind != CBORKind.Array

			fail "webauthn: rpIdHash does not match {id}" when !authData.rpIdHash.equals(digest(Hash.SHA256, options.rpId.bytes()))
			fail "webauthn: the user was not present" when !options.conditional && !authData.has(AuthFlag.UserPresent)
			fail "webauthn: the user was not verified" when options.userVerification == UserVerification.Required && !authData.has(AuthFlag.UserVerified)
			fail "webauthn: backed up but not backup eligible" when authData.has(AuthFlag.BackedUp) && !authData.has(AuthFlag.BackupEligible)
			fail "webauthn: authenticator data holds no credential" when !authData.has(AuthFlag.AttestedData)
			fail "webauthn: credential id is longer than 1023 bytes" when authData.credentialId.len() > 1023
			fail "webauthn: credential id differs from the response id" when !authData.credentialId.equals(response.id)
			fail "webauthn: credential algorithm {authData.credentialKey.algorithm} was not offered" when !options.algorithms.includes(authData.credentialKey.algorithm)

			let clientDataHash = digest(Hash.SHA256, response.clientDataJSON)
			let attested = try verifyAttestation(fmt, statement, authData, clientDataHash, attestationRoots, time.now())
			fail "webauthn: attestation does not chain to a trusted root" when requireTrustedAttestation && !attested.trusted

			let cred = new Credential()
			cred.id = authData.credentialId
			cred.publicKey = try authData.credentialKey.encode()
			cred.algorithm = authData.credentialKey.algorithm
			cred.userId = options.user.id
			cred.signCount = authData.signCount
			cred.uvInitialized = authData.has(AuthFlag.UserVerified)
			cred.backupEligible = authData.has(AuthFlag.BackupEligible)
			cred.backedUp = authData.has(AuthFlag.BackedUp)
			cred.transports = response.transports
			cred.aaguid = authData.aaguid
			cred.attestationFormat = fmt
			cred.attestationType = attested.kind
			cred.attestationTrusted = attested.trusted
			cred.attestationObject = response.attestationObject
			cred.attestationClientData = response.clientDataJSON
			cred.discoverable = response.discoverableKnown && response.discoverable
			cred.prfEnabled = response.prfEnabled
			cred.largeBlobSupported = response.largeBlobSupported
			let outputs = authData.extensions
			if outputs.kind == CBORKind.Map {
				cred.credProtect = outputs.get("credProtect").asInt() onerror recover 0
				cred.credBlobStored = outputs.get("credBlob").asBool() onerror recover false
				cred.minPINLength = outputs.get("minPinLength").asInt() onerror recover 0
			}
			let wanted = options.extensions.credentialProtection
			if options.extensions.enforceCredentialProtection && wanted != CredentialProtection.None {
				let level = wanted == CredentialProtection.Optional ?? (1, wanted == CredentialProtection.OptionalWithCredentialIDList ?? (2, 3))
				fail "webauthn: the authenticator applied credProtect {cred.credProtect}, below {level}" when cred.credProtect < level
			}
			return cred
		}

		// Starts an authentication ceremony. allow lists the credentials
		// that may answer; leave it empty for passkey sign-in, where the
		// user picks a discoverable credential and the response names the
		// user. Fails when the random source is unavailable.
		def beginAuthentication(allow CredentialDescriptor[] = [], extensions AuthenticationExtensions = AuthenticationExtensions{}) !AuthenticationOptions {
			let o = new AuthenticationOptions()
			o.rpId = id
			o.challenge = try crypto.rand(32)
			o.timeout = timeout
			o.allow = allow
			o.userVerification = userVerification
			o.extensions = extensions
			o.created = time.now()
			return o
		}

		// Finishes an authentication (WebAuthn §7.2) against the stored
		// credential the response names (look it up by response.id, or by
		// response.userHandle for passkey sign-in). Fails when the ceremony
		// expired, the credential was not allowed, the user handle does not
		// match, or a check of the client data, authenticator data or
		// signature does not hold.
		def finishAuthentication(options AuthenticationOptions, response AuthenticationResponse, credential Credential) !AuthenticationResult {
			try checkExpiry(options.created, options.timeout)
			fail "webauthn: the response credential differs from the stored one" when !response.id.equals(credential.id)
			if options.allow.len() > 0 {
				let allowed = false
				for let (_, d) in options.allow {
					allowed = true when d.id.equals(response.id)
				}
				fail "webauthn: the credential was not in allowCredentials" when !allowed
			} else {
				fail "webauthn: a discoverable credential must return its user handle" when response.userHandle.len() == 0
			}
			fail "webauthn: the user handle differs from the credential's user" when response.userHandle.len() > 0 && !response.userHandle.equals(credential.userId)

			let c = try parseClientData(response.clientDataJSON)
			try checkClientData(c, "webauthn.get", options.challenge)
			let authData = try parseAuthenticatorData(response.authenticatorData)
			let rpId = (response.appid && options.appid != "") ?? (options.appid, options.rpId)
			fail "webauthn: rpIdHash does not match {rpId}" when !authData.rpIdHash.equals(digest(Hash.SHA256, rpId.bytes()))
			fail "webauthn: the user was not present" when !options.conditional && !authData.has(AuthFlag.UserPresent)
			fail "webauthn: the user was not verified" when options.userVerification == UserVerification.Required && !authData.has(AuthFlag.UserVerified)
			fail "webauthn: backed up but not backup eligible" when authData.has(AuthFlag.BackedUp) && !authData.has(AuthFlag.BackupEligible)
			fail "webauthn: backup eligibility changed since registration" when authData.has(AuthFlag.BackupEligible) != credential.backupEligible

			let key = try credential.key()
			let signed = authData.raw + digest(Hash.SHA256, response.clientDataJSON)
			fail "webauthn: the assertion signature does not verify" when !key.verify(signed, response.signature)

			let result = new AuthenticationResult()
			result.userVerified = authData.has(AuthFlag.UserVerified)
			result.counterWarning = (authData.signCount != uint32(0) || credential.signCount != uint32(0)) && authData.signCount <= credential.signCount
			let updated = credential
			updated.signCount = authData.signCount when authData.signCount > credential.signCount
			updated.backedUp = authData.has(AuthFlag.BackedUp)
			updated.uvInitialized = true when result.userVerified
			result.credential = updated
			result.prf = response.prf
			result.largeBlob = response.largeBlob
			result.largeBlobWritten = response.largeBlobWritten
			if authData.extensions.kind == CBORKind.Map {
				result.credBlob = authData.extensions.get("credBlob").asBytes() onerror recover byte[]
			}
			return result
		}

		// Checks the parts of collected client data every ceremony shares.
		internal def checkClientData(c ClientData, kind string, challenge byte[]) !none {
			expects {
				assert c.kind == kind onerror fail "webauthn: client data type is {c.kind}, not {kind}"
			}
			let got = try fromBase64url(c.challenge)
			fail "webauthn: the challenge does not match" when !crypto.constantTimeEqual(got, challenge)
			fail "webauthn: origin {c.origin} is not allowed" when !origins.includes(c.origin)
			if c.crossOrigin {
				fail "webauthn: cross-origin ceremonies are not allowed" when topOrigins.len() == 0
				fail "webauthn: top origin {c.topOrigin} is not allowed" when !topOrigins.includes(c.topOrigin)
			} else {
				fail "webauthn: topOrigin is set but crossOrigin is not" when c.topOrigin != ""
			}
			return none
		}

		// Fails when a ceremony begun at created has outlived its timeout.
		internal def checkExpiry(created Time, limit duration) !none {
			expects {
				assert time.now().since(created) <= limit onerror fail "webauthn: the ceremony has expired"
			}
			return none
		}
	}
}
