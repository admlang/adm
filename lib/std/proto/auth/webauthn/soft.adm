partial module std.proto.auth.webauthn {
	use (
		std.crypto
		std.crypto::(PrivateKey)
		std.crypto.hash::(Hash, digest)
		std.proto.auth.webauthn.formats::*
		std.proto.auth.webauthn.ctap::*
	)

	// One credential a SoftAuthenticator holds.
	type SoftCredential {
		id byte[]

		// The relying party id; "" for a U2F registration, which carries
		// only its hash.
		rpId string

		// SHA-256 of the relying party id (the U2F application parameter).
		rpIdHash byte[]

		user      User          = User{}
		key       PrivateKey
		algorithm COSEAlgorithm = COSEAlgorithm.ES256

		// Whether it is discoverable (resident).
		discoverable bool

		signCount uint32

		// The credProtect level (1 to 3).
		credProtect int = 1

		// The hmac-secret CredRandom values without and with user
		// verification, 32 bytes each; empty without hmac-secret.
		credRandom byte[]

		// The credBlob stored with it.
		credBlob byte[]

		// Its large-blob key; empty without one.
		largeBlobKey byte[]

		def new(id byte[], rpId string, user User, key PrivateKey, algorithm COSEAlgorithm, discoverable bool) {
			self.id = id
			self.rpId = rpId
			self.rpIdHash = digest(Hash.SHA256, rpId.bytes())
			self.user = user
			self.key = key
			self.algorithm = algorithm
			self.discoverable = discoverable
		}
	}

	// SoftAuthenticator is a FIDO2 authenticator in software: it keeps its
	// credentials in memory and answers makeCredential and getAssertion as
	// a CTAP2 authenticator does. For tests, and for a platform
	// authenticator whose keys the application stores itself.
	//
	//     let auth = new SoftAuthenticator()
	//     let client = new Client("https://example.com", auth)
	//     let response = try client.create(options)
	type SoftAuthenticator {
		// The authenticator model; all zeros by default.
		aaguid byte[]

		// The algorithms it can make keys for, most preferred first.
		algorithms COSEAlgorithm[] = [COSEAlgorithm.ES256, COSEAlgorithm.EdDSA, COSEAlgorithm.RS256]

		// Whether it reports the user as present and verified. Clear them
		// to test how a relying party handles their absence.
		userPresent  bool = true
		userVerified bool = true

		// Whether its credentials are backup eligible and backed up, like a
		// synced passkey.
		backupEligible bool
		backedUp       bool

		// Keep a signature counter per credential; clear for 0 always.
		counters bool = true

		// The packed attestation key and its certificate chain (DER, leaf
		// first). With no key it attests with "packed" self attestation.
		attestationKey   ?PrivateKey = none
		attestationChain byte[][]

		// Answer with "none" attestation instead of "packed".
		noAttestation bool

		// The credentials it holds, oldest first.
		credentials SoftCredential[]

		// The serialized large-blob array (CTAP 2.2 §6.10.2).
		largeBlobs byte[]

		def new() {
			aaguid.len(16)
			largeBlobs = emptyLargeBlobArray()
		}

		// Creates a credential, implementing Authenticator: the request goes
		// through a SoftDevice in CTAP2 form, so it behaves as a security key
		// would. Fails with a CTAPError: CredentialExcluded,
		// UnsupportedAlgorithm, OperationDenied when the user is not present,
		// or UnsupportedOption when verification is asked of a user it does
		// not verify.
		def makeCredential(request MakeCredentialRequest) !MakeCredentialResult {
			return try new SecurityKey(new SoftDevice(self)).makeCredential(request)
		}

		// Signs with every credential for the relying party that the
		// request allows (or every discoverable one when it allows none),
		// most recent first, implementing Authenticator. Fails with a
		// CTAPError: NoCredentials when none matches, OperationDenied or
		// UnsupportedOption as makeCredential does.
		def getAssertion(request GetAssertionRequest) !GetAssertionResult[] {
			return try new SecurityKey(new SoftDevice(self)).getAssertion(request)
		}

		// What it supports, implementing Authenticator. Does not fail.
		def info() !AuthenticatorInfo {
			return try new SecurityKey(new SoftDevice(self)).info()
		}

		// The large blob of the credential whose large-blob key is given,
		// implementing Authenticator; none when it has none. Fails when the
		// stored array is corrupt.
		def largeBlob(key byte[]) !?byte[] {
			return try new SecurityKey(new SoftDevice(self)).largeBlob(key)
		}

		// Stores a credential's large blob, implementing Authenticator.
		// Fails when the array would exceed 1024 bytes.
		def storeLargeBlob(key byte[], data byte[]) !none {
			return try new SecurityKey(new SoftDevice(self)).storeLargeBlob(key, data)
		}
	}
}
