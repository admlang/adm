partial module std.proto.auth.webauthn {
	use (
		std.proto.auth.webauthn.json::*
	)

	// Whether the authenticator must verify the user (PIN, biometric) and
	// not just test their presence.
	enum UserVerification {
		Required = "required",
		Preferred = "preferred",
		Discouraged = "discouraged"
	}

	// Whether the credential should be discoverable: stored on the
	// authenticator with the user handle, so sign-in needs no user name
	// first (a passkey).
	enum ResidentKey {
		Discouraged = "discouraged",
		Preferred = "preferred",
		Required = "required"
	}

	// Which authenticators may take part.
	enum Attachment {
		// Any authenticator.
		Any = "",
		// One built into the client device (Touch ID, Windows Hello).
		Platform = "platform",
		// A roaming one: a security key on USB, NFC or BLE, or a phone.
		CrossPlatform = "cross-platform"
	}

	// How much attestation a relying party asks for.
	enum AttestationConveyance {
		None = "none",
		Indirect = "indirect",
		Direct = "direct",
		Enterprise = "enterprise"
	}

	// The credProtect policy a relying party asks for (CTAP 2.2 §12.1).
	enum CredentialProtection {
		// Leave it to the authenticator.
		None = "",
		// The credential works without user verification.
		Optional = "userVerificationOptional",
		// Without user verification it works only when the relying party
		// names it in allowCredentials (it is not discoverable then).
		OptionalWithCredentialIDList = "userVerificationOptionalWithCredentialIDList",
		// It works only with user verification.
		Required = "userVerificationRequired"
	}

	// Whether a relying party needs large-blob storage for a credential.
	enum LargeBlobSupport {
		None = "",
		Preferred = "preferred",
		Required = "required"
	}

	// Inputs and outputs of the WebAuthn pseudo-random function extension
	// (prf): two values, the second optional.
	struct PRFValues {
		first  byte[]
		second byte[]
	}

	// The extensions a registration asks for (WebAuthn §9, §10).
	struct RegistrationExtensions {
		// credProtect, and whether the client must refuse an authenticator
		// that cannot honour it.
		credentialProtection        CredentialProtection = CredentialProtection.None
		enforceCredentialProtection bool

		// Ask for large-blob storage (largeBlob).
		largeBlob LargeBlobSupport = LargeBlobSupport.None

		// Enable the pseudo-random function (prf), backed by hmac-secret.
		prf bool

		// A small blob to store with the credential (credBlob).
		credBlob byte[]

		// Ask for the authenticator's minimum PIN length (minPinLength).
		minPinLength bool

		// The U2F AppID whose credentials should also be excluded
		// (appidExclude); "" for none.
		appidExclude string
	}

	// The extensions an authentication asks for.
	struct AuthenticationExtensions {
		// Evaluate the prf with these values, or with the per-credential
		// ones keyed by credential id (base64url).
		prf             PRFValues              = PRFValues{}
		prfByCredential map<string, PRFValues>

		// Read the credential's large blob, or write this one.
		largeBlobRead  bool
		largeBlobWrite byte[]

		// Ask for the credential's credBlob (getCredBlob).
		getCredBlob bool
	}

	// How an attestation vouches for the authenticator (WebAuthn §6.5.4).
	enum AttestationType {
		// No attestation, or the client removed it.
		None,
		// Signed by the credential key itself: no claim about the model.
		Self,
		// Signed by a key the model's batch shares, with a certificate chain.
		Basic,
		// Signed by a per-credential key certified by an attestation CA (TPM).
		AttCA,
		// Signed by a per-credential key certified by an anonymizing CA (Apple).
		AnonCA,
		// A chain that could be Basic or AttCA (FIDO U2F).
		Uncertain
	}

	// A user account as the authenticator stores it with a credential.
	struct User {
		// The user handle: an opaque, stable id of up to 64 bytes. Never
		// put personal information in it.
		id byte[]

		// The account name, such as an e-mail address.
		name string

		// The name to show, such as the person's full name.
		displayName string
	}

	// A credential a ceremony names: one to exclude from registration or
	// to allow in authentication.
	struct CredentialDescriptor {
		id byte[]

		// How the client can reach the authenticator: "usb", "nfc", "ble",
		// "smart-card", "hybrid", "internal".
		transports string[]
	}

	// Credential is a registered public key credential, what a relying
	// party stores per user after registration and updates after each
	// authentication (WebAuthn's credential record).
	type Credential {
		// The credential id.
		id byte[]

		// The credential public key in COSE form.
		publicKey byte[]

		// The algorithm the key signs with.
		algorithm COSEAlgorithm = COSEAlgorithm.ES256

		// The user handle the credential belongs to.
		userId byte[]

		// The signature counter last seen; 0 when the authenticator keeps none.
		signCount uint32

		// Whether the authenticator ever verified the user with it.
		uvInitialized bool

		// Whether the credential can be backed up (synced), and whether it is.
		backupEligible bool
		backedUp       bool

		// The transports the authenticator reported.
		transports string[]

		// The authenticator model (AAGUID); zeros when not given.
		aaguid byte[]

		// The attestation statement format and what it established.
		attestationFormat string
		attestationType   AttestationType = AttestationType.None

		// Whether the attestation chained to the relying party's trusted roots.
		attestationTrusted bool

		// The attestation object and client data of the registration, kept
		// so the attestation can be checked again later.
		attestationObject     byte[]
		attestationClientData byte[]

		// Whether the client reported the credential as discoverable; false
		// when it did not say.
		discoverable bool

		// The credProtect level the authenticator applied (1 to 3); 0 when it
		// did not report one.
		credProtect int

		// Whether the prf extension is available for the credential.
		prfEnabled bool

		// Whether the credential has large-blob storage.
		largeBlobSupported bool

		// Whether the authenticator stored the credBlob.
		credBlobStored bool

		// The authenticator's minimum PIN length, when the minPinLength
		// extension reported it; 0 otherwise.
		minPINLength int

		def new() {}

		// The credential's descriptor, for allowCredentials and
		// excludeCredentials.
		def descriptor() CredentialDescriptor {
			return CredentialDescriptor{id: id, transports: transports}
		}

		// The public key. Fails when the stored key does not parse.
		def key() !COSEKey {
			return try parseCOSEKey(publicKey)
		}
	}
}
