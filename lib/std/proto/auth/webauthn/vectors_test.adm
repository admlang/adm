partial module std.proto.auth.webauthn {
	use (
		std.testing
		std.proto.auth.webauthn.json::*
		std.time
	)

	// Registers a credential from a recorded RegistrationResponseJSON with
	// the ceremony values it was made for, accepting every algorithm and no
	// user verification. Attestation chains are not checked against roots.
	def waVector(json string, challenge string, rpId string, origin string) !Credential {
		let rp = new RelyingParty(rpId, "test", origin)
		rp.algorithms = [COSEAlgorithm.ES256, COSEAlgorithm.EdDSA, COSEAlgorithm.ES384, COSEAlgorithm.ES512, COSEAlgorithm.RS256, COSEAlgorithm.PS256, COSEAlgorithm.RS1]
		let o = new RegistrationOptions()
		o.rpId = rpId
		o.challenge = try fromBase64url(challenge)
		o.algorithms = rp.algorithms
		o.userVerification = UserVerification.Discouraged
		o.user = User{id: byte[1]}
		o.created = time.now()
		return try rp.finishRegistration(o, json)
	}

	// Registration responses recorded from real authenticators, from the
	// py_webauthn test suite (BSD-3-Clause, Duo Security).
	check "WebAuthn vectors" {
		@test()
		def TestVerifiesNoneAttestationResponse() !none {
			let json = "\{\"id\":\"9y1xA8Tmg1FEmT-c7_fvWZ_uoTuoih3OvR45_oAK-cwHWhAbXrl2q62iLVTjiyEZ7O7n-CROOY494k7Q3xrs_w\",\"rawId\":\"9y1xA8Tmg1FEmT-c7_fvWZ_uoTuoih3OvR45_oAK-cwHWhAbXrl2q62iLVTjiyEZ7O7n-CROOY494k7Q3xrs_w\",\"response\":\{\"attestationObject\":\"o2NmbXRkbm9uZWdhdHRTdG10oGhhdXRoRGF0YVjESZYN5YgOjGh0NBcPZHZgW4_krrmihjLHmVzzuoMdl2NFAAAAFwAAAAAAAAAAAAAAAAAAAAAAQPctcQPE5oNRRJk_nO_371mf7qE7qIodzr0eOf6ACvnMB1oQG165dqutoi1U44shGezu5_gkTjmOPeJO0N8a7P-lAQIDJiABIVggSFbUJF-42Ug3pdM8rDRFu_N5oiVEysPDB6n66r_7dZAiWCDUVnB39FlGypL-qAoIO9xWHtJygo2jfDmHl-_eKFRLDA\",\"clientDataJSON\":\"eyJ0eXBlIjoid2ViYXV0aG4uY3JlYXRlIiwiY2hhbGxlbmdlIjoiVHdON240V1R5R0tMYzRaWS1xR3NGcUtuSE00bmdscXN5VjBJQ0psTjJUTzlYaVJ5RnRya2FEd1V2c3FsLWdrTEpYUDZmbkYxTWxyWjUzTW00UjdDdnciLCJvcmlnaW4iOiJodHRwOi8vbG9jYWxob3N0OjUwMDAiLCJjcm9zc09yaWdpbiI6ZmFsc2V9\"\},\"type\":\"public-key\",\"clientExtensionResults\":\{\},\"transports\":[\"nfc\",\"usb\"]\}"
			let cred = try waVector(json, "TwN7n4WTyGKLc4ZY-qGsFqKnHM4nglqsyV0ICJlN2TO9XiRyFtrkaDwUvsql-gkLJXP6fnF1MlrZ53Mm4R7Cvw", "localhost", "http://localhost:5000")
			assert cred.attestationFormat == "none"
			return none
		}

		@test()
		def TestVerifiesRegistrationOverCable() !none {
			let json = "\{\"id\":\"9y1xA8Tmg1FEmT-c7_fvWZ_uoTuoih3OvR45_oAK-cwHWhAbXrl2q62iLVTjiyEZ7O7n-CROOY494k7Q3xrs_w\",\"rawId\":\"9y1xA8Tmg1FEmT-c7_fvWZ_uoTuoih3OvR45_oAK-cwHWhAbXrl2q62iLVTjiyEZ7O7n-CROOY494k7Q3xrs_w\",\"response\":\{\"attestationObject\":\"o2NmbXRkbm9uZWdhdHRTdG10oGhhdXRoRGF0YVjESZYN5YgOjGh0NBcPZHZgW4_krrmihjLHmVzzuoMdl2NFAAAAFwAAAAAAAAAAAAAAAAAAAAAAQPctcQPE5oNRRJk_nO_371mf7qE7qIodzr0eOf6ACvnMB1oQG165dqutoi1U44shGezu5_gkTjmOPeJO0N8a7P-lAQIDJiABIVggSFbUJF-42Ug3pdM8rDRFu_N5oiVEysPDB6n66r_7dZAiWCDUVnB39FlGypL-qAoIO9xWHtJygo2jfDmHl-_eKFRLDA\",\"clientDataJSON\":\"eyJ0eXBlIjoid2ViYXV0aG4uY3JlYXRlIiwiY2hhbGxlbmdlIjoiVHdON240V1R5R0tMYzRaWS1xR3NGcUtuSE00bmdscXN5VjBJQ0psTjJUTzlYaVJ5RnRya2FEd1V2c3FsLWdrTEpYUDZmbkYxTWxyWjUzTW00UjdDdnciLCJvcmlnaW4iOiJodHRwOi8vbG9jYWxob3N0OjUwMDAiLCJjcm9zc09yaWdpbiI6ZmFsc2V9\"\},\"type\":\"public-key\",\"clientExtensionResults\":\{\},\"transports\":[\"cable\"]\}"
			let cred = try waVector(json, "TwN7n4WTyGKLc4ZY-qGsFqKnHM4nglqsyV0ICJlN2TO9XiRyFtrkaDwUvsql-gkLJXP6fnF1MlrZ53Mm4R7Cvw", "localhost", "http://localhost:5000")
			assert cred.attestationFormat == "none"
			return none
		}

		@test()
		def TestRaisesOnBadAttestationobject() !none {
			let json = "\{\"id\":\"9y1xA8Tmg1FEmT-c7_fvWZ_uoTuoih3OvR45_oAK-cwHWhAbXrl2q62iLVTjiyEZ7O7n-CROOY494k7Q3xrs_w\",\"rawId\":\"9y1xA8Tmg1FEmT-c7_fvWZ_uoTuoih3OvR45_oAK-cwHWhAbXrl2q62iLVTjiyEZ7O7n-CROOY494k7Q3xrs_w\",\"response\":\{\"attestationObject\":\"o2NmbXRkbm9uZWdhdHRTdG10oGhhdXRoRGF0YVjESZYN5YgOjGh0NBcPZHZgW4_krrmihjLHmVzzuoMdl2NFAAAAFwAAAAAAAAAAAAAAAAAAAAAAQPctcQPE5oNRRJk_nO_371mf7qE7qIodzr0eOf6ACvnMB1oQG165dqutoi1U44shGezu5_gkTjmOPeJO0N8a7P\",\"clientDataJSON\":\"eyJ0eXBlIjoid2ViYXV0aG4uY3JlYXRlIiwiY2hhbGxlbmdlIjoiVHdON240V1R5R0tMYzRaWS1xR3NGcUtuSE00bmdscXN5VjBJQ0psTjJUTzlYaVJ5RnRya2FEd1V2c3FsLWdrTEpYUDZmbkYxTWxyWjUzTW00UjdDdnciLCJvcmlnaW4iOiJodHRwOi8vbG9jYWxob3N0OjUwMDAiLCJjcm9zc09yaWdpbiI6ZmFsc2V9\"\},\"type\":\"public-key\",\"clientExtensionResults\":\{\},\"transports\":[\"nfc\",\"usb\"]\}"
			let failed = false
			waVector(json, "TwN7n4WTyGKLc4ZY-qGsFqKnHM4nglqsyV0ICJlN2TO9XiRyFtrkaDwUvsql-gkLJXP6fnF1MlrZ53Mm4R7Cvw", "localhost", "http://localhost:5000") onerror (err error) {
				failed = true
				recover new Credential()
			}
			assert failed
			return none
		}

