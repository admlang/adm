partial module std.proto {
	use std.testing

	@os("linux")
	check "DBus" {
		@test()
		def TestWriterAlignsEachType() {
			let w = new DBusWriter()
			w.putByte(7)
			w.putUint32(0x01020304)
			let got = w.bytes()
			assert got.len() == 8
			assert got[0] == byte(7)
			assert got[1] == byte(0) && got[2] == byte(0) && got[3] == byte(0)
			assert got[4] == byte(4) && got[5] == byte(3) && got[6] == byte(2) && got[7] == byte(1)

			let s = new DBusWriter()
			s.putRaw([1])
			s.pad(4)
			assert s.len() == 4
			s.putSignature("su")
			assert s.len() == 8
			s.putField(3, "s", "Member")
			s.putString("hi")
			let text = s.bytes()
			// the field lands on an 8-byte boundary (8), then code, "s" signature (3), string (4 + 7)
			let at = text.len() - 7
			assert dbusReadUint32(text, at) == uint32(2)
			assert text[text.len() - 1] == byte(0)
			assert dbusReadString(text, at) == "hi"
			assert dbusReadString(text, 8 + 1 + 3) == "Member"
			assert dbusAlign(7, 8) == 8 && dbusAlign(8, 8) == 8
		}

		@test()
		def TestWriterArrayLengthExcludesPadding() {
			let w = new DBusWriter()
			w.putStringArray(["a", "bc"])
			let got = w.bytes()
			// 4 (length) + "a": 4+1+1 = 6, pad to 8, "bc": 4+2+1 = 7 → elements span 15 bytes
			assert dbusReadUint32(got, 0) == uint32(15)
			assert got.len() == 19

			let d = new DBusWriter()
			d.putUint32(1)
			d.beginDict()
			d.dictByte("urgency", 2)
			d.dictString("category", "im")
			d.endDict()
			let dict = d.bytes()
			// entries start at the 8-byte boundary after the length; the length counts from there
			assert dbusReadUint32(dict, 4) == uint32(dict.len() - 8)
		}

		@test()
		def TestEncodeCallRoundTrips() {
			let body = new DBusWriter()
			body.putInt32(-1)
			let raw = dbusEncodeCall(9, "org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus", "GetId", "i", body.bytes())
			assert raw[0] == byte(108)
			assert raw[1] == DBUS_CALL
			assert raw[3] == byte(1)
			assert dbusReadUint32(raw, 4) == uint32(4)
			assert dbusReadUint32(raw, 8) == uint32(9)
			let fieldsLen = int(dbusReadUint32(raw, 12))
			let headerLen = dbusAlign(16 + fieldsLen, 8)
			assert raw.len() == headerLen + 4
			let message = dbusDecodeMessage(raw, headerLen, fieldsLen)
			assert message.kind == DBUS_CALL
			assert message.serial == uint32(9)
			assert message.member == "GetId"
			assert message.signature == "i"
			assert dbusReadUint32(message.body, 0) == uint32(0xFFFFFFFF)
		}

		@test()
		def TestErrorMessageReadsTheBody() {
			let w = new DBusWriter()
			w.putString("No such notification")
			let message = DBusMessage{kind: DBUS_ERROR, errorName: "org.freedesktop.DBus.Error.Failed", signature: "s", body: w.bytes()}
			assert dbusErrorMessage(message) == "No such notification"
			let bare = DBusMessage{kind: DBUS_ERROR, errorName: "org.freedesktop.DBus.Error.Failed"}
			assert dbusErrorMessage(bare) == "org.freedesktop.DBus.Error.Failed"
			assert dbusReadFailure("ETIMEDOUT").errorName == "ETIMEDOUT"
		}

		@test()
		def TestSessionBusAddressFromEnvironment() !none {
			let previous = __env_get("DBUS_SESSION_BUS_ADDRESS")
			try __env_set("DBUS_SESSION_BUS_ADDRESS", "unix:path=/run/user/1000/bus,guid=abc")
			let got = try dbusSessionBusAddress()
			assert got == "/run/user/1000/bus"
			if previous is none {
				try __env_set("DBUS_SESSION_BUS_ADDRESS", "")
			} else {
				let restore string = previous
				try __env_set("DBUS_SESSION_BUS_ADDRESS", restore)
			}
			return none
		}

		// Reads replies for `call` the way a service's listener task does.
		def pump(connection DBusConnection) {
			for {
				let message = connection.readMessage(2s) onerror (err error) {
					recover dbusReadFailure(err.code)
				}
				return when message.kind == 0 && message.errorName != "ETIMEDOUT"
				return when connection.stopping
				connection.deliver(message.replySerial, message) when message.kind == DBUS_REPLY || message.kind == DBUS_ERROR
			}
		}

		// Talks to the session bus when this machine has one: Hello (in
		// dbusConnect), a match rule, and GetId through the listener path.
		@test()
		def TestSessionBusRoundTrip() !none {
			let address = dbusSessionBusAddress() onerror recover ""
			return none when address == ""
			let connection = dbusConnect(address) onerror (err error) {
				recover new DBusConnection(-1)
			}
			return none when connection.stopping
			try connection.subscribe("org.freedesktop.DBus", "NameOwnerChanged")
			let direct = try connection.callSync("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus", "GetId", "", [])
			assert direct.kind == DBUS_REPLY
			async pump(connection)
			let reply = try connection.call("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus", "GetId", "", [])
			assert reply.kind == DBUS_REPLY
			assert reply.signature == "s"
			assert dbusReadString(reply.body, 0).len() > 0
			connection.close()
			// after close, a lost report is a no-op
			connection.lost()
			assert connection.stopping
			return none
		}
	}
}
