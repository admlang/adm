partial module std.proto.journald {
	use (
		std.net
		std.os
		std.services::(Application)
	)

	// Sends entries to the systemd journal over its native socket.
	//
	// The socket is opened on the first entry and again after `close`. The journal adds
	// what it knows of the sender itself (`_PID`, `_UID`, `_COMM`, the unit, the time it
	// received the entry); `identifier` is the name the entry is filed under
	// (`journalctl -t`), the application's name unless set. An entry travels as one
	// datagram; one larger than a datagram holds is written to a sealed memory file
	// that is handed to the journal over the socket. Sending needs the
	// `adm.network.connect` permission for the socket's path.
	//
	// ```
	// let journal = new journald.Client()
	// try journal.log("backup finished", journald.Priority.Notice, {"FILES": "1204"})
	// ```
	type Client {
		// The journal's socket.
		path       string   = defaultSocket
		// The `SYSLOG_IDENTIFIER` of entries that carry none; empty for the application's
		// name.
		identifier string   = ""
		// How long a send may wait.
		timeout    duration = 5s

		internal socket ?net.Socket = none
		// The largest datagram the socket sends, in bytes.
		internal limit  int
		// The largest entry the journal reads, in bytes.
		internal most   int         = entrySizeMax

		def new(path string = defaultSocket) {
			self.path = path
		}

		// Reports whether the journal's socket is there, so a program can choose another
		// writer on a system without systemd.
		def available() bool {
			return os.exists(path) onerror recover false
		}

		// Sends an entry, with `SYSLOG_IDENTIFIER` added when it has none.
		//
		// Fails with `JournalError`: `BadField` or `BadEntry` when the entry does not
		// encode, `TooLarge` when it is more than the journal reads (768 MiB),
		// `Unreachable` when the socket cannot be opened or refuses the entry.
		def send(entry Entry) !none {
			let out = entry
			if !entry.has("SYSLOG_IDENTIFIER") {
				out = new Entry()
				out.fields = entry.fields[:]
				out.fields.push(Field{name: "SYSLOG_IDENTIFIER", value: (identifier == "" ?? (Application.name(), identifier)).bytes()})
			}
			try transmit(try out.encode())
			return none
		}

		// Sends a message at a priority, with more fields by name. Fails as `send` does.
		def log(message string, priority Priority = Priority.Info, fields map<string, string> = {}) !none {
			let entry = new Entry(message, priority)
			for let (name, value) in fields {
				entry.add(name, value)
			}
			return try send(entry)
		}

		// Implements `io.Writer`: sends data as one already-encoded entry (what `Encoder`
		// and `Entry.encode` produce) and returns its length. Fails as `send` does.
		def write(data byte[]) !int {
			try transmit(data)
			return data.len()
		}

		// Whether the socket is open.
		def isOpen() bool {
			return !(socket is none)
		}

		// Implements `io.Closer`: closes the socket; the next entry opens it again. Does
		// not fail.
		def close() !none {
			let open = socket
			socket = none
			return none when open is none
			open.close() onerror recover none
			return none
		}

		def dispose() {
			close() onerror recover none
		}

		// Opens the socket when it is not open, with the largest send buffer the system
		// gives.
		internal def connect() !net.Socket {
			let open = socket
			return open unless open is none
			let made = net.socket(net.SocketDomain.Unix, net.SocketType.Datagram) onerror (err error) {
				fail unreachable(err)
			}
			// The journal's own client asks for 8 MiB; the system caps it.
			made.setSendBuf(8 * 1024 * 1024) onerror recover none
			// SO_SNDBUF; a Unix datagram may be the buffer less its header of 32 bytes.
			let buffer = made.getOption(7) onerror recover 212992
			limit = buffer - 32
			socket = made
			return made
		}

		internal def transmit(data byte[]) !none {
			fail journalError(JournalErrorKind.TooLarge, "entry of {data.len()} bytes, the journal reads {most} at most") when data.len() > most
			let open = try connect()
			return try transmitFile(open, data) when data.len() > limit
			let failure ?error = none
			open.writeTo(data, path, timeout) onerror (err error) {
				failure = err
				recover 0
			}
			return none when failure is none
			// The system's bound for one datagram can be lower than the send buffer says.
			let cause = failure.cause
			return try transmitFile(open, data) when !(cause is none) && (cause.code == "EMSGSIZE" || cause.code == "ENOBUFS")
			fail unreachable(failure)
		}

		// Sends an entry too large for a datagram the way the journal's own client does:
		// as a memory file, sealed so the journal can trust it stays as it is, whose
		// descriptor travels in an otherwise empty datagram.
		internal def transmitFile(open net.Socket, data byte[]) !none {
			let file = os.memoryFile("journal-entry") onerror (err error) {
				fail unreachable(err)
			}
			defer file.close()
			let sent = 0
			for sent < data.len() {
				let n = file.write(data[sent:]) onerror (err error) {
					fail unreachable(err)
				}
				fail journalError(JournalErrorKind.Unreachable, "the memory file takes no more bytes") when n <= 0
				sent += n
			}
			file.seal() onerror (err error) {
				fail unreachable(err)
			}
			open.sendDescriptor(file.descriptor(), path, timeout) onerror (err error) {
				fail unreachable(err)
			}
			return none
		}

		internal def unreachable(err error) JournalError {
			return JournalError{message: "journald: {err.message}", code: JournalErrorKind.Unreachable.name, cause: err, kind: JournalErrorKind.Unreachable}
		}
	}
}
