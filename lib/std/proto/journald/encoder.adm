partial module std.proto.journald {
	use std.services.logging::(LogLevel, LogRecord)

	// Encoder turns records of the `Logging` service into journal entries, so a `Client`
	// can be one of its writers:
	//
	// ```
	// Logging.config(
	// 	LogConfig{
	// 		writers: [LogWriterConfig{writer: new journald.Client(), encoder: new journald.Encoder()}],
	// 	}
	// )
	// ```
	//
	// The message is `MESSAGE` and the level `PRIORITY`: `Debug` 7, `Info` 6, `Warning` 4,
	// `Error` 3, `Fatal` 2, and 5 (notice) for a plain entry. The call site goes into
	// `CODE_FILE`, `CODE_LINE` and `CODE_FUNC`, the module into `ADM_MODULE`. Each field of
	// the record becomes a field of the entry, its name through `fieldName` (`order.id` is
	// `ORDER_ID`) and its value as text; one named like a field the encoder writes itself
	// gets `FIELD_` in front. The journal keeps the time it received the entry.
	type Encoder {
		// The `SYSLOG_IDENTIFIER` entries are filed under; empty leaves it to the client.
		identifier string = ""

		def new(identifier string = "") {
			self.identifier = identifier
		}

		// Implements `LogEncoder`. Does not fail.
		def encode(record LogRecord) !byte[] {
			let entry = new Entry()
			entry.add("MESSAGE", record.message)
			entry.add("PRIORITY", "{priorityOf(record.level).ordinal}")
			entry.add("SYSLOG_IDENTIFIER", identifier) when identifier != ""
			if record.caller.fileName != "" {
				entry.add("CODE_FILE", record.caller.filePath == "" ?? (record.caller.fileName, record.caller.filePath))
				entry.add("CODE_LINE", "{record.caller.line}")
			}
			entry.add("CODE_FUNC", record.caller.name) when record.caller.name != ""
			entry.add("ADM_MODULE", record.caller.moduleName) when record.caller.moduleName != ""
			let names = record.fields.keys()
			names.sort((a, b) => a < b)
			for let (_, name) in names {
				let value = record.fields.get(name)
				let field = fieldName(name)
				field = ("FIELD_" + field)[:64] when entry.has(field)
				entry.add(field, value is none ?? ("none", "{value}"))
			}
			return try entry.encode()
		}

		// The priority a log level is filed at.
		internal def priorityOf(level ?LogLevel) Priority {
			return Priority.Notice when level is none
			match level {
				case LogLevel.Debug:
					return Priority.Debug
				case LogLevel.Info:
					return Priority.Info
				case LogLevel.Warning:
					return Priority.Warning
				case LogLevel.Error:
					return Priority.Error
				default:
					return Priority.Critical
			}
		}
	}
}
