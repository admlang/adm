// The native protocol of the systemd journal: an entry is a set of named fields sent as one
// datagram to the journal's Unix socket. `Entry` holds and encodes the fields, `Client`
// sends them, and `Encoder` turns the records of the `Logging` service into entries.
partial module std.proto.journald {
	use (
		std.bytes
		std.errors
	)

	// The socket the journal listens on for native entries.
	const defaultSocket = "/run/systemd/journal/socket"

	// The largest entry the journal reads from a memory file, in bytes.
	internal const entrySizeMax = 768 * 1024 * 1024

	// How urgent an entry is: the `PRIORITY` field, the syslog severities 0 to 7.
	enum Priority {
		Emergency,
		Alert,
		Critical,
		Error,
		Warning,
		Notice,
		Info,
		Debug
	}

	// Why an entry could not be built, read or sent.
	enum JournalErrorKind {
		// A field's name is not one the journal takes.
		BadField,
		// The bytes are not an entry in the native form.
		BadEntry,
		// The entry is larger than the journal reads.
		TooLarge,
		// The journal's socket could not be reached.
		Unreachable
	}

	// JournalError is the payload of an entry that cannot be encoded, parsed or sent;
	// `kind` says which.
	struct JournalError {
		message string
		code    string
		cause   ?error
		stack   errors.StackTrace
		kind    JournalErrorKind
	}

	// One field of an entry. A name may appear several times in an entry.
	struct Field {
		name  string
		value byte[]
	}

	// An entry of the journal: fields in the order they were added.
	//
	// The journal takes a field whose name is 1 to 64 characters of `A`-`Z`, `0`-`9` and
	// `_`, starting with a letter; `fieldName` turns any text into such a name. The fields
	// it knows include `MESSAGE`, `PRIORITY`, `SYSLOG_IDENTIFIER`, `CODE_FILE`, `CODE_LINE`
	// and `CODE_FUNC`; any other name is kept and can be searched (`journalctl ORDER=A-17`).
	//
	// ```
	// let entry = new journald.Entry("card declined", journald.Priority.Error)
	// entry.set("ORDER", "A-17").set("AMOUNT", "12")
	// try new journald.Client().send(entry)
	// ```
	type Entry {
		fields Field[]

		def new(message string = "", priority Priority = Priority.Info) {
			if message != "" {
				fields.push(Field{name: "MESSAGE", value: message.bytes()})
				fields.push(Field{name: "PRIORITY", value: "{priority.ordinal}".bytes()})
			}
		}

		// Sets a field, replacing every value the name has, and returns the entry.
		def set(name string, value string) Entry {
			return set(name, value.bytes())
		}

		// Sets a field to bytes, which need not be text, replacing every value the name
		// has, and returns the entry.
		def set(name string, value byte[]) Entry {
			let kept = Field[]
			let placed = false
			for let (_, f) in fields {
				if f.name != name {
					kept.push(f)
				} else if !placed {
					kept.push(Field{name: name, value: value})
					placed = true
				}
			}
			kept.push(Field{name: name, value: value}) unless placed
			fields = kept
			return self
		}

		// Adds one more value under a name, beside those it has, and returns the entry.
		def add(name string, value string) Entry {
			fields.push(Field{name: name, value: value.bytes()})
			return self
		}

		// The first value of a field as text; none when the entry has no such field.
		def get(name string) ?string {
			for let (_, f) in fields {
				return string(f.value) when f.name == name
			}
			return none
		}

		// Every value of a field as text, in the order added.
		def values(name string) string[] {
			let out = string[]
			for let (_, f) in fields {
				out.push(string(f.value)) when f.name == name
			}
			return out
		}

		// Reports whether the entry has a field of that name.
		def has(name string) bool {
			for let (_, f) in fields {
				return true when f.name == name
			}
			return false
		}

		// The entry in the native form: `NAME=value` and a line break for a value on one
		// line, and for a value holding a line break the name, a line break, the value's
		// length as 64 bits little-endian, the value and a line break.
		//
		// Fails with `JournalError` (`BadField`) when a name is not one the journal takes,
		// and (`BadEntry`) when the entry has no field.
		def encode() !byte[] {
			fail journalError(JournalErrorKind.BadEntry, "an entry needs at least one field") when fields.len() == 0
			let out = new bytes.Buffer()
			for let (_, f) in fields {
				fail journalError(JournalErrorKind.BadField, "{f.name} is not a field name: 1 to 64 of A-Z, 0-9 and _, starting with a letter") unless validName(f.name)
				try out.write(f.name.bytes())
				if f.value.indexOf(byte(0x0A)) < 0 {
					try out.write("=".bytes())
				} else {
					try out.write("\n".bytes())
					try out.write<uint64>(uint64(f.value.len()), bytes.Endian.Little)
				}
				try out.write(f.value)
				try out.write("\n".bytes())
			}
			return out.bytes()
		}
	}

	// Reads one entry from its native form, as `Entry.encode` writes it.
	//
	// Fails with `JournalError` (`BadEntry`) when a field has no `=` and no length, when a
	// length runs past the data, or when a value is not ended by a line break.
	def parse(data byte[]) !Entry {
		let entry = new Entry()
		let at = 0
		for at < data.len() {
			let end = at
			for end < data.len() && data[end] != byte(0x0A) && data[end] != byte(0x3D) {
				end++
			}
			fail journalError(JournalErrorKind.BadEntry, "field at byte {at} has no value") when end >= data.len()
			let name = string(data[at:end])
			if data[end] == byte(0x3D) {
				let stop = end + 1
				for stop < data.len() && data[stop] != byte(0x0A) {
					stop++
				}
				fail journalError(JournalErrorKind.BadEntry, "field {name} is not ended by a line break") when stop >= data.len()
				entry.fields.push(Field{name: name, value: data[end + 1:stop]})
				at = stop + 1
				continue
			}
			fail journalError(JournalErrorKind.BadEntry, "field {name} has no length") when end + 9 > data.len()
			let length = 0
			for let i = 7; i >= 0; i-- {
				length = length * 256 + int(data[end + 1 + i])
			}
			let start = end + 9
			fail journalError(JournalErrorKind.BadEntry, "field {name} runs past the entry") when length < 0 || start + length >= data.len()
			fail journalError(JournalErrorKind.BadEntry, "field {name} is not ended by a line break") when data[start + length] != byte(0x0A)
			entry.fields.push(Field{name: name, value: data[start:start + length]})
			at = start + length + 1
		}
		fail journalError(JournalErrorKind.BadEntry, "no field") when entry.fields.len() == 0
		return entry
	}

	// Reports whether the journal takes a field of that name from a program: 1 to 64
	// characters of `A`-`Z`, `0`-`9` and `_`, the first a letter.
	def validName(name string) bool {
		return /^[A-Z][A-Z0-9_]{0,63}$/.test(name)
	}

	// The field name closest to any text: letters in upper case, every other character
	// but a digit as `_`, what stands before the first letter dropped, cut to 64
	// characters; `FIELD` when no letter is left.
	//
	// ```
	// journald.fieldName("order.id") == "ORDER_ID"
	// journald.fieldName("2nd try") == "ND_TRY"
	// ```
	def fieldName(text string) string {
		let out = ""
		for let (_, ch) in text.upper() {
			let letter = ch >= 'A' && ch <= 'Z'
			let digit = ch >= '0' && ch <= '9'
			continue when out == "" && !letter
			break when out.len() >= 64
			if letter || digit {
				out += "{ch}"
			} else {
				out += "_"
			}
		}
		return "FIELD" when out == ""
		return out
	}

	internal def journalError(kind JournalErrorKind, message string) JournalError {
		return JournalError{message: "journald: " + message, code: kind.name, kind: kind}
	}
}
