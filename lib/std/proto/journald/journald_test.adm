partial module std.proto.journald {
	use (
		std.bytes
		std.net
		std.os
		std.services.logging::(LogLevel, LogRecord)
		std.testing
		std.time
	)

	// A socket standing in for the journal's: binds a path and reads one datagram.
	internal type FakeJournal {
		path   string
		socket net.Socket

		def new(path string, socket net.Socket) {
			self.path = path
			self.socket = socket
		}

		def next() !Entry {
			let buf byte[] = []
			buf.len(65536)
			let (n, _) = try socket.readFrom(buf, 5s)
			return try parse(buf[:n])
		}

		// The entry of a datagram that carries a memory file instead of bytes, and
		// whether the file was sealed.
		def nextFile() !(Entry, bool) {
			let file = new os.File("", try socket.receiveDescriptor(5s))
			let size = int(try file.seek(0, bytes.Whence.End))
			try file.seek(0)
			let data byte[] = []
			data.len(size)
			let got = 0
			for got < size {
				let n = try file.read(data[got:])
				break when n <= 0
				got += n
			}
			let sealed = file.write("x".bytes()) is error
			try file.close()
			return (try parse(data[:got]), sealed)
		}

		def close() {
			socket.close() onerror recover none
			os.remove(path) onerror recover none
		}
	}

	internal def fakeJournal(name string) !FakeJournal {
		let path = os.join(os.tempDir(), "adm-journald-{name}-{time.now().unixNs()}.sock")
		let socket = try net.socket(net.SocketDomain.Unix, net.SocketType.Datagram)
		try socket.bind(path)
		return new FakeJournal(path, socket)
	}

	// A field's first value, empty when the entry has none.
	internal def fieldOf(entry Entry, name string) string {
		let value = entry.get(name)
		return "" when value is none
		return value
	}

	internal def kindOf(failure error) string {
		return failure.kind.name when failure is JournalError
		return "other"
	}

	check "journald entries" {
		@test()
		def encodesFieldsOnOneLine() !none {
			let entry = new Entry("card declined", Priority.Error)
			entry.set("ORDER", "A-17").add("TAG", "billing").add("TAG", "cards")
			assert string(try entry.encode()) == "MESSAGE=card declined\nPRIORITY=3\nORDER=A-17\nTAG=billing\nTAG=cards\n"
			assert fieldOf(entry, "ORDER") == "A-17" && entry.get("MISSING") is none
			assert entry.values("TAG").equals(["billing", "cards"])
			entry.set("TAG", "one")
			assert entry.values("TAG").equals(["one"])
			assert entry.has("PRIORITY") && !entry.has("NOPE")
			return none
		}

		@test()
		def encodesAValueWithLineBreaksByLength() !none {
			let entry = new Entry()
			entry.set("MESSAGE", "first\nsecond")
			let wire = try entry.encode()
			// MESSAGE, line break, 12 as 64 bits little-endian, the value, line break.
			let expected byte[] = "MESSAGE\n".bytes()
			expected.push(byte(12))
			for let _ in 0..7 {
				expected.push(byte(0))
			}
			expected = expected + "first\nsecond\n".bytes()
			assert wire.equals(expected)
			let back = try parse(wire)
			assert fieldOf(back, "MESSAGE") == "first\nsecond"
			return none
		}

		@test()
		def parsesWhatItEncodes() !none {
			let entry = new Entry("multi\nline", Priority.Warning)
			entry.set("EMPTY", "").set("EQUALS", "a=b=c").set("BYTES", byte[0, 10, 255])
			let back = try parse(try entry.encode())
			assert back.fields.len() == 5
			assert fieldOf(back, "MESSAGE") == "multi\nline" && fieldOf(back, "PRIORITY") == "4"
			assert fieldOf(back, "EMPTY") == "" && fieldOf(back, "EQUALS") == "a=b=c"
			assert back.fields[4].value.equals(byte[0, 10, 255])
			return none
		}

		@test()
		def refusesBadNamesAndBadBytes() !none {
			let lower = new Entry()
			lower.set("message", "x")
			let failed = lower.encode()
			assert failed is error && kindOf(failed) == "BadField"
			let trusted = new Entry()
			trusted.set("_PID", "1")
			assert trusted.encode() is error
			assert new Entry().encode() is error
			let noValue = parse("MESSAGE".bytes())
			assert noValue is error && kindOf(noValue) == "BadEntry"
			assert parse("MESSAGE=open".bytes()) is error
			assert parse("MESSAGE\nxx".bytes()) is error
			assert parse(byte[]) is error
			return none
		}

		@test()
		def namesFieldsFromAnyText() !none {
			assert validName("MESSAGE") && validName("A1_B") && !validName("_PID") && !validName("1ST") && !validName("lower") && !validName("")
			assert fieldName("order.id") == "ORDER_ID"
			assert fieldName("user name") == "USER_NAME"
			assert fieldName("2nd try") == "ND_TRY"
			assert fieldName("__trace") == "TRACE"
			assert fieldName("42") == "FIELD"
			assert fieldName("x".repeat(80)).len() == 64
			return none
		}
	}

	// The journal's socket is a Unix datagram socket, which Windows lacks.
	@os("linux", "darwin")
	check "journald client" {
		@test()
		def sendsEntriesToTheSocket() !none {
			let journal = try fakeJournal("send")
			let client = new Client(journal.path)
			client.identifier = "billing"
			assert client.available() && !client.isOpen()
			try client.log("backup finished", Priority.Notice, {"FILES": "1204"})
			assert client.isOpen()
			let got = try journal.next()
			assert fieldOf(got, "MESSAGE") == "backup finished" && fieldOf(got, "PRIORITY") == "5"
			assert fieldOf(got, "FILES") == "1204" && fieldOf(got, "SYSLOG_IDENTIFIER") == "billing"
			// An entry that names its identifier keeps it.
			let own = new Entry("named", Priority.Info)
			own.set("SYSLOG_IDENTIFIER", "other")
			try client.send(own)
			assert (try journal.next()).values("SYSLOG_IDENTIFIER").equals(["other"])
			// A closed client opens the socket again.
			try client.close()
			assert !client.isOpen()
			try client.log("again")
			assert fieldOf(try journal.next(), "MESSAGE") == "again"
			try client.close()
			journal.close()
			return none
		}

		// Sealed memory files are Linux's (memfd), as is the journal.
		@os("linux")
		@test()
		def sendsAnEntryLargerThanADatagramAsASealedMemoryFile() !none {
			let journal = try fakeJournal("file")
			let client = new Client(journal.path)
			client.identifier = "billing"
			try client.log("opens the socket")
			assert fieldOf(try journal.next(), "MESSAGE") == "opens the socket"
			// What a datagram holds depends on the system; the test fixes it.
			client.limit = 65536
			let report = "line of a long report\n".repeat(40000)
			try client.log(report, Priority.Warning, {"PAGES": "512"})
			let (got, sealed) = try journal.nextFile()
			assert sealed
			assert fieldOf(got, "MESSAGE") == report && fieldOf(got, "PRIORITY") == "4"
			assert fieldOf(got, "PAGES") == "512" && fieldOf(got, "SYSLOG_IDENTIFIER") == "billing"
			// A small entry after it travels as a datagram again.
			try client.log("short")
			assert fieldOf(try journal.next(), "MESSAGE") == "short"
			try client.close()
			journal.close()
			return none
		}

		@test()
		def reportsAMissingJournalAndAnEntryTooLarge() !none {
			let absent = new Client(os.join(os.tempDir(), "adm-journald-absent-{time.now().unixNs()}.sock"))
			assert !absent.available()
			let failed = absent.log("nobody listens")
			assert failed is error && kindOf(failed) == "Unreachable"
			let journal = try fakeJournal("large")
			let client = new Client(journal.path)
			// The journal's own bound is 768 MiB; the test lowers it.
			client.most = 4096
			let big = new Entry()
			big.set("MESSAGE", "x".repeat(8192))
			let refused = client.send(big)
			assert refused is error && kindOf(refused) == "TooLarge"
			try client.close()
			journal.close()
			return none
		}
	}

	check "journald encoder" {
		@test()
		def encodesLogRecords() !none {
			let record = LogRecord{
				level:   LogLevel.Fatal,
				message: "card declined\nissuer said no",
				fields:  {"order.id": "A-17", "amount": 12, "message": "shadow"},
				caller:  CallerLocation{fileName: "invoice.adm", filePath: "/src/invoice.adm", line: 17, moduleName: "billing", name: "charge"},
			}
			let entry = try parse(try new Encoder("shop").encode(record))
			assert fieldOf(entry, "MESSAGE") == "card declined\nissuer said no" && fieldOf(entry, "PRIORITY") == "2"
			assert fieldOf(entry, "SYSLOG_IDENTIFIER") == "shop"
			assert fieldOf(entry, "CODE_FILE") == "/src/invoice.adm" && fieldOf(entry, "CODE_LINE") == "17" && fieldOf(entry, "CODE_FUNC") == "charge"
			assert fieldOf(entry, "ADM_MODULE") == "billing"
			assert fieldOf(entry, "ORDER_ID") == "A-17" && fieldOf(entry, "AMOUNT") == "12"
			// A field named like one the encoder writes is kept apart.
			assert fieldOf(entry, "FIELD_MESSAGE") == "shadow" && entry.values("MESSAGE").len() == 1
			let plain = try parse(try new Encoder().encode(LogRecord{message: "started", fields: {}}))
			assert fieldOf(plain, "PRIORITY") == "5" && !plain.has("SYSLOG_IDENTIFIER") && !plain.has("CODE_FILE")
			let levels = [LogLevel.Debug, LogLevel.Info, LogLevel.Warning, LogLevel.Error]
			let priorities = ["7", "6", "4", "3"]
			for let (i, level) in levels {
				let made = try parse(try new Encoder().encode(LogRecord{level: level, message: "m", fields: {}}))
				assert fieldOf(made, "PRIORITY") == priorities[i]
			}
			return none
		}

		@os("linux", "darwin")
		@test()
		def aClientAndAnEncoderWorkAsAWriter() !none {
			let journal = try fakeJournal("writer")
			let client = new Client(journal.path)
			let wire = try new Encoder("shop").encode(LogRecord{level: LogLevel.Warning, message: "low disk", fields: {"free": "4%"}})
			assert (try client.write(wire)) == wire.len()
			let got = try journal.next()
			assert fieldOf(got, "MESSAGE") == "low disk" && fieldOf(got, "PRIORITY") == "4" && fieldOf(got, "FREE") == "4%"
			try client.close()
			journal.close()
			return none
		}
	}
}
