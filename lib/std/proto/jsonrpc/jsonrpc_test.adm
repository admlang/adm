partial module std.proto.jsonrpc {
	use (
		std.testing
		std.time
		std.net.http
		std.net.http.httptest
		std.data.encoding::(JSON)
	)

	// One direction of an in-memory stream. close makes the reader see the
	// end of the stream.
	type RpcPipe {
		internal ch   channel<byte[]>
		internal rest byte[]
		internal eof  bool

		def new() {
			self.ch = new channel<byte[]>(256)
		}

		def write(buf byte[]) !int {
			ch <- buf.clone() when buf.len() > 0
			return buf.len()
		}

		def read(buf byte[]) !int {
			return 0 when eof
			if rest.len() == 0 {
				let chunk = <-ch
				if chunk.len() == 0 {
					eof = true
					return 0
				}
				rest = chunk
			}
			let n = rest.len() < buf.len() ?? (rest.len(), buf.len())
			for let i = 0; i < n; i++ {
				buf[i] = rest[i]
			}
			rest = rest.slice(n, rest.len() - n)
			return n
		}

		def close() {
			ch <- byte[]
		}
	}

	struct RpcSubtract {
		minuend    int
		subtrahend int
	}

	struct RpcSum {
		total int
	}

	// Two peers wired to each other, started, with the pipes that join
	// them.
	struct RpcPair {
		a   Peer
		b   Peer
		toB RpcPipe
		toA RpcPipe
	}

	def rpcPair(framing Framing) RpcPair {
		let toB = new RpcPipe()
		let toA = new RpcPipe()
		let a = new Peer(toA, toB, framing)
		let b = new Peer(toB, toA, framing)
		b.handle("subtract", def (req Request) !any {
			match req.params {
				case any[]:
					let args = req.params
					let x = args[0]
					let y = args[1]
					match x {
						case int:
							match y {
								case int:
									return x - y
								default:
							}
						default:
					}
					fail errorOf(-32602, "positional params must be integers")
				default:
					let args = new RpcSubtract()
					try req.bind(args)
					return args.minuend - args.subtrahend
			}
		})
		b.handle("busy", def (req Request) !any {
			fail errorOf(-32001, "busy", data = "later")
		})
		b.handle("boom", def (req Request) !any {
			fail "boom"
		})
		b.handle("sum", def (_ Request) !any {
			let s = new RpcSum()
			s.total = 7
			return s
		})
		a.start()
		b.start()
		return RpcPair{a: a, b: b, toB: toB, toA: toA}
	}

	def rpcText(v any) string {
		return string(new JSON().encode(v))
	}

	def rpcCloseLater(pipe RpcPipe, after duration) {
		time.sleep(after)
		pipe.close()
	}

	def rpcDispatch(d Dispatcher, text string) string {
		let out = d.dispatch(text.bytes())
		return "<none>" when out is none
		return string(out)
	}

	def rpcFails(fn def () !any, kind ErrorCode) bool {
		let got = ErrorCode.Protocol
		let failed = false
		fn() onerror (err error) {
			failed = true
			got = err.kind when err is RPCError
			recover none
		}
		println("wanted {kind.name}, failed={failed} got={got.name}") when !failed || got != kind
		return failed && got == kind
	}

	check "JSON-RPC" {
		@test()
		def TestSpecificationExamples() !none {
			let d = new Dispatcher()
			d.handle("subtract", def (req Request) !any {
				match req.params {
					case any[]:
						let args = req.params
						let x = args[0]
						let y = args[1]
						match x {
							case int:
								match y {
									case int:
										return x - y
									default:
								}
							default:
						}
						fail errorOf(-32602, "invalid params")
					default:
						let args = new RpcSubtract()
						try req.bind(args)
						return args.minuend - args.subtrahend
				}
			})
			d.handle("sum", def (req Request) !any {
				return 7
			})
			d.handle("notify_hello", def (req Request) !any {
				return none
			})
			d.handle("get_data", def (_ Request) !any {
				let out any[] = ["hello", 5]
				return out
			})
			assert rpcDispatch(d, "\{\"jsonrpc\": \"2.0\", \"method\": \"subtract\", \"params\": [42, 23], \"id\": 1\}") == "\{\"jsonrpc\":\"2.0\",\"result\":19,\"id\":1\}"
			assert rpcDispatch(d, "\{\"jsonrpc\": \"2.0\", \"method\": \"subtract\", \"params\": [23, 42], \"id\": 2\}") == "\{\"jsonrpc\":\"2.0\",\"result\":-19,\"id\":2\}"
			assert rpcDispatch(d, "\{\"jsonrpc\": \"2.0\", \"method\": \"subtract\", \"params\": \{\"subtrahend\": 23, \"minuend\": 42\}, \"id\": 3\}") == "\{\"jsonrpc\":\"2.0\",\"result\":19,\"id\":3\}"
			assert rpcDispatch(d, "\{\"jsonrpc\": \"2.0\", \"method\": \"update\", \"params\": [1,2,3,4,5]\}") == "<none>"
			assert rpcDispatch(d, "\{\"jsonrpc\": \"2.0\", \"method\": \"foobar\"\}") == "<none>"
			assert rpcDispatch(d, "\{\"jsonrpc\": \"2.0\", \"method\": \"foobar\", \"id\": \"1\"\}") == "\{\"jsonrpc\":\"2.0\",\"error\":\{\"code\":-32601,\"message\":\"method not found: foobar\"\},\"id\":\"1\"\}"
			assert rpcDispatch(d, "\{\"jsonrpc\": \"2.0\", \"method\": \"foobar, \"params\": \"bar\", \"baz]").startsWith("\{\"jsonrpc\":\"2.0\",\"error\":\{\"code\":-32700,")
			assert rpcDispatch(d, "\{\"jsonrpc\": \"2.0\", \"method\": 1, \"params\": \"bar\"\}") == "\{\"jsonrpc\":\"2.0\",\"error\":\{\"code\":-32600,\"message\":\"invalid request\"\},\"id\":null\}"
			assert rpcDispatch(d, "[\{\"jsonrpc\": \"2.0\", \"method\": \"sum\", \"params\": [1,2,4], \"id\": \"1\"\},\{\"jsonrpc\": \"2.0\", \"method\"\n]").startsWith("\{\"jsonrpc\":\"2.0\",\"error\":\{\"code\":-32700,")
			assert !(d.handler("sum") is none) && d.handler("nope") is none
			assert rpcDispatch(d, "[]") == "\{\"jsonrpc\":\"2.0\",\"error\":\{\"code\":-32600,\"message\":\"empty batch\"\},\"id\":null\}"
			let invalid = "\{\"jsonrpc\":\"2.0\",\"error\":\{\"code\":-32600,\"message\":\"invalid request\"\},\"id\":null\}"
			assert rpcDispatch(d, "[1]") == "[" + invalid + "]"
			assert rpcDispatch(d, "[1,2,3]") == "[" + invalid + "," + invalid + "," + invalid + "]"
			let mixed = rpcDispatch(d, "[\{\"jsonrpc\": \"2.0\", \"method\": \"sum\", \"params\": [1,2,4], \"id\": \"1\"\}, \{\"jsonrpc\": \"2.0\", \"method\": \"notify_hello\", \"params\": [7]\}, \{\"jsonrpc\": \"2.0\", \"method\": \"subtract\", \"params\": [42,23], \"id\": \"2\"\}, \{\"foo\": \"boo\"\}, \{\"jsonrpc\": \"2.0\", \"method\": \"foo.get\", \"params\": \{\"name\": \"myself\"\}, \"id\": \"5\"\}, \{\"jsonrpc\": \"2.0\", \"method\": \"get_data\", \"id\": \"9\"\}]")
			assert mixed == "[\{\"jsonrpc\":\"2.0\",\"result\":7,\"id\":\"1\"\},\{\"jsonrpc\":\"2.0\",\"result\":19,\"id\":\"2\"\}," + invalid + ",\{\"jsonrpc\":\"2.0\",\"error\":\{\"code\":-32601,\"message\":\"method not found: foo.get\"\},\"id\":\"5\"\},\{\"jsonrpc\":\"2.0\",\"result\":[\"hello\",5],\"id\":\"9\"\}]"
			assert rpcDispatch(d, "[\{\"jsonrpc\": \"2.0\", \"method\": \"notify_sum\", \"params\": [1,2,4]\}, \{\"jsonrpc\": \"2.0\", \"method\": \"notify_hello\", \"params\": [7]\}]") == "<none>"
			// Version, params and id are checked.
			assert rpcDispatch(d, "\{\"jsonrpc\": \"1.0\", \"method\": \"sum\", \"id\": 1\}") == "\{\"jsonrpc\":\"2.0\",\"error\":\{\"code\":-32600,\"message\":\"invalid request\"\},\"id\":1\}"
			assert rpcDispatch(d, "\{\"jsonrpc\": \"2.0\", \"method\": \"sum\", \"params\": 3, \"id\": 1\}").contains("-32600")
			assert rpcDispatch(d, "\{\"jsonrpc\": \"2.0\", \"method\": \"sum\", \"id\": [1]\}").contains("-32600")
			assert rpcDispatch(d, "\{\"jsonrpc\": \"2.0\", \"method\": \"sum\", \"id\": null\}") == "\{\"jsonrpc\":\"2.0\",\"result\":7,\"id\":null\}"
			assert rpcDispatch(d, "\{\"jsonrpc\": \"2.0\", \"method\": \"subtract\", \"params\": \{\"minuend\": \"x\"\}, \"id\": 4\}").contains("\"code\":-32602")
			return none
		}

		@test()
		def TestErrorKinds() !none {
			assert kindOf(-32700) == ErrorCode.ParseError
			assert kindOf(-32600) == ErrorCode.InvalidRequest
			assert kindOf(-32601) == ErrorCode.MethodNotFound
			assert kindOf(-32602) == ErrorCode.InvalidParams
			assert kindOf(-32603) == ErrorCode.InternalError
			assert kindOf(-32000) == ErrorCode.ServerError && kindOf(-32099) == ErrorCode.ServerError
			assert kindOf(-32100) == ErrorCode.Application && kindOf(1) == ErrorCode.Application
			let e = errorOf(-32001, "busy", data = 3)
			assert e.kind == ErrorCode.ServerError && e.number == -32001 && e.message == "busy"
			return none
		}

		@test()
		def TestPeerCalls() !none {
			for let framing in [Framing.ContentLength, Framing.Newline] {
				let p = rpcPair(framing)
				assert rpcText(try p.a.call("subtract", [42, 23])) == "19"
				let named = map<string, any>{}
				named["minuend"] = 42
				named["subtrahend"] = 23
				assert rpcText(try p.a.call("subtract", named)) == "19"
				let sum = new RpcSum()
				try p.a.call("sum", none, sum)
				assert sum.total == 7
				assert rpcFails(() => p.a.call("busy"), ErrorCode.ServerError)
				assert rpcFails(() => p.a.call("boom"), ErrorCode.InternalError)
				assert rpcFails(() => p.a.call("nope"), ErrorCode.MethodNotFound)
				assert rpcFails(() => p.a.call("subtract", ["x", 1]), ErrorCode.InvalidParams)
				p.a.call("busy") onerror (err error) {
					if err is RPCError {
						assert err.number == -32001 && err.message == "busy"
						let data = err.data
						match data {
							case string:
								assert data == "later"
							default:
								assert false
						}
					}
					recover none
				}
				p.toB.close()
				p.toA.close()
				p.a.wait()
				p.b.wait()
			}
			return none
		}

		@test()
		def TestCallbacksAndOrder() !none {
			let p = rpcPair(Framing.ContentLength)
			p.a.handle("ping", def (req Request) !any {
				return "pong"
			})
			// A handler that calls back into the peer that called it.
			let b = p.b
			p.b.handle("relay", def (req Request) !any {
				return try b.call("ping")
			})
			assert rpcText(try p.a.call("relay")) == "\"pong\""
			// Notifications run in arrival order, each before the next
			// message is read.
			let seen int[] = []
			p.b.handle("tick", def (req Request) !any {
				let args = req.params
				match args {
					case any[]:
						let n = args[0]
						match n {
							case int:
								seen.push(n)
							default:
						}
					default:
				}
				return none
			})
			p.b.handle("count", def (req Request) !any {
				return seen.len()
			})
			for let i = 0; i < 50; i++ {
				try p.a.notify("tick", [i])
			}
			assert rpcText(try p.a.call("count")) == "50"
			for let i = 0; i < 50; i++ {
				assert seen[i] == i
			}
			p.toB.close()
			p.toA.close()
			p.a.wait()
			return none
		}

		@test()
		def TestBatch() !none {
			let p = rpcPair(Framing.Newline)
			let calls Call[] = [Call{method:"subtract", params:[5, 3]}, Call{method:"tick", params:[1], notification:true}, Call{method:"busy"}, Call{method:"sum"}]
			let replies = try p.a.batch(calls)
			assert replies.len() == 4
			assert rpcText(replies[0].result) == "2" && replies[0].error is none
			assert replies[1].result is none && replies[1].error is none
			let busy = replies[2].error
			assert !(busy is none) && busy.number == -32001
			let total = replies[3].result
			match total {
				case map<string, any>:
					assert rpcText(total["total"]) == "7"
				default:
					assert false
			}
			p.toB.close()
			p.toA.close()
			p.a.wait()
			return none
		}

		@test()
		def TestTimeoutAndClose() !none {
			let p = rpcPair(Framing.ContentLength)
			p.b.handle("slow", def (_ Request) !any {
				time.sleep(300ms)
				return 1
			})
			p.a.timeout = 30ms
			assert rpcFails(() => p.a.call("slow"), ErrorCode.Timeout)
			p.a.timeout = 0s
			// The stream from b ends while a call waits: the call fails.
			let closer = async rpcCloseLater(p.toA, 30ms)
			closer.keepAlive()
			assert rpcFails(() => p.a.call("slow"), ErrorCode.Closed)
			p.a.wait()
			assert p.a.endReason() == ""
			assert rpcFails(() => p.a.call("sum"), ErrorCode.Closed)
			let early = new Peer(new RpcPipe(), new RpcPipe())
			assert rpcFails(() => early.call("sum"), ErrorCode.Closed)
			p.toB.close()
			return none
		}

		@test()
		def TestFraming() !none {
			let input = new RpcPipe()
			let output = new RpcPipe()
			let peer = new Peer(input, output)
			peer.handle("sum", def (req Request) !any {
				return 7
			})
			peer.start()
			let body = "\{\"jsonrpc\":\"2.0\",\"method\":\"sum\",\"id\":1\}"
			// Header names are case-insensitive, other headers are skipped,
			// and a message may arrive in pieces.
			let message = "content-length: {body.len()}\r\nContent-Type: application/vscode-jsonrpc; charset=utf-8\r\n\r\n" + body
			for let b in message.bytes() {
				try input.write([b])
			}
			let buf byte[]
			buf.len(4096)
			let n = try output.read(buf)
			let text = string(buf.slice(0, n))
			assert text == "Content-Length: 35\r\n\r\n\{\"jsonrpc\":\"2.0\",\"result\":7,\"id\":1\}"
			// A header block without Content-Length ends the stream.
			try input.write("Content-Type: x\r\n\r\n".bytes())
			peer.wait()
			assert peer.endReason().contains("without Content-Length")

			let lines = new RpcPipe()
			let out2 = new RpcPipe()
			let nd = new Peer(lines, out2, Framing.Newline)
			nd.handle("sum", def (req Request) !any {
				return 7
			})
			nd.start()
			try lines.write(("\r\n" + body + "\r\n").bytes())
			let m = try out2.read(buf)
			assert string(buf.slice(0, m)) == "\{\"jsonrpc\":\"2.0\",\"result\":7,\"id\":1\}\n"
			let small = new RpcPipe()
			let out3 = new RpcPipe()
			let capped = new Peer(small, out3)
			capped.maxMessageSize = 10
			capped.start()
			try small.write("Content-Length: 11\r\n\r\n".bytes())
			capped.wait()
			assert capped.endReason().contains("exceeds maxMessageSize")
			lines.close()
			return none
		}

		@test()
		def TestHttp() !none {
			let d = new Dispatcher()
			d.handle("subtract", def (req Request) !any {
				let args = new RpcSubtract()
				try req.bind(args)
				return args.minuend - args.subtrahend
			})
			d.handle("log", def (req Request) !any {
				return none
			})
			let ts = try httptest.Server.start(d)
			let rpc = new HttpClient(ts.url, ts.client())
			let named = map<string, any>{}
			named["minuend"] = 10
			named["subtrahend"] = 4
			assert rpcText(try rpc.call("subtract", named)) == "6"
			try rpc.notify("log", ["x"])
			assert rpcFails(() => rpc.call("missing"), ErrorCode.MethodNotFound)
			let replies = try rpc.batch([Call{method:"subtract", params:named}, Call{method:"log", notification:true}, Call{method:"missing"}])
			assert replies.len() == 3 && rpcText(replies[0].result) == "6" && replies[1].result is none
			let missing = replies[2].error
			assert !(missing is none) && missing.kind == ErrorCode.MethodNotFound
			let res = try ts.client().get("/")
			assert res.status == 405
			let recorder = new httptest.ResponseRecorder()
			let post = try httptest.newRequest(http.Method.POST, "/", "\{\"jsonrpc\":\"2.0\",\"method\":\"log\"\}")
			try d.serve(recorder.context(post))
			assert recorder.result().status == 204
			try ts.close()
			return none
		}
	}
}
