// How a client reaches a server: requests it can name while they wait, and
// what the server sends on its own.
internal partial module std.proto.mcp.session {
	use (
		std.io
		std.proto.jsonrpc
	)

	// A client's transport.
	interface Carrier {
		// Sends a request and returns the handle `receive` and `cancel`
		// take, which is also the request's JSON-RPC id.
		// mirrored holds the tool arguments an HTTP transport repeats as
		// headers, by header name.
		def send(method string, params map<string, any>, mirrored map<string, string>) !int

		// Waits for the result of a request; within 0s waits until the
		// connection ends. Fails with a `jsonrpc.RPCError`.
		def receive(handle int, within duration) !any

		// Tells the server to stop working on a request and drops its
		// response.
		def cancel(handle int)

		def notify(method string, params map<string, any>) !none

		def alive() bool

		// Whether tool arguments marked `x-mcp-header` travel as headers too.
		def mirrors() bool

		// Told once the revision is agreed; modern for 2026-07-28 and later.
		def agreed(revision string, modern bool)

		// Switches to an older transport of the same address when there is
		// one; false when there is none.
		def fallback() bool

		// Ends the connection as the transport ends one.
		def close()
	}

	// The methods a server calls on a client in the revisions before
	// 2026-07-28.
	def clientMethods() string[] {
		return ["sampling/createMessage", "roots/list", "elicitation/create", "ping"]
	}

	// The notifications a server sends.
	def serverNotifications() string[] {
		return ["notifications/progress", "notifications/message", "notifications/tools/list_changed", "notifications/resources/list_changed", "notifications/prompts/list_changed", "notifications/resources/updated", "notifications/subscriptions/acknowledged", "notifications/cancelled", "notifications/elicitation/complete", "notifications/tasks/status", "notifications/tasks"]
	}

	// A server at the other end of a stream of lines.
	type StreamCarrier {
		peer   jsonrpc.Peer
		reader io.Reader
		writer io.Writer

		// told receives each notification of the server, asked answers each
		// of its requests.
		def new(reader io.Reader, writer io.Writer, told def (string, any), asked def (string, any) !any) {
			self.reader = reader
			self.writer = writer
			peer = new jsonrpc.Peer(reader, writer, jsonrpc.Framing.Newline)
			for let (_, method) in serverNotifications() {
				peer.handle(method, def (req jsonrpc.Request) !any {
					told(req.method, req.params)
					return none
				})
			}
			for let (_, method) in clientMethods() {
				peer.handle(method, def (req jsonrpc.Request) !any {
					return try asked(req.method, req.params)
				})
			}
			peer.start()
		}

		// Implements Carrier.
		def send(method string, params map<string, any>, mirrored map<string, string>) !int {
			return try peer.request(method, params)
		}

		// Implements Carrier.
		def mirrors() bool {
			return false
		}

		// Implements Carrier.
		def agreed(revision string, modern bool) {}

		// Implements Carrier.
		def fallback() bool {
			return false
		}

		// Implements Carrier.
		def receive(handle int, within duration) !any {
			return try peer.response(handle, within)
		}

		// Implements Carrier.
		def cancel(handle int) {
			peer.notify("notifications/cancelled", map<string, any>{"requestId": handle}) onerror recover none
			peer.abandon(handle)
		}

		// Implements Carrier.
		def notify(method string, params map<string, any>) !none {
			return try peer.notify(method, params)
		}

		// Implements Carrier.
		def alive() bool {
			return peer.isOpen()
		}

		// Implements Carrier: closes the writer when it can be closed, which
		// is how a client of the stdio transport asks the server to leave.
		def close() {
			peer.close()
			let end any = writer
			match end {
				case io.Closer:
					end.close() onerror recover none
				default:
			}
		}
	}
}
