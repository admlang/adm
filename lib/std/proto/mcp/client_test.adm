partial module std.proto.mcp {
	use (
		std.testing
		std.time
		std.bytes
		std.proto.mcp.wire::*
	)

	// A client and a server of this module joined by two pipes.
	internal type McpPair {
		server  Server
		client  Client
		up      bytes.Pipe
		down    bytes.Pipe
		serving async none

		def new() {
			server = new Server("test-server", "1.2.3")
			client = new Client("test-client", "0.1")
			up = new bytes.Pipe()
			down = new bytes.Pipe()
		}

		// Starts the server and opens the client.
		def open() !none {
			try server.discover()
			try server.add(new McpDesk())
			serving = mcpServePair(self)
			return try client.open(down, up)
		}

		def end() !none {
			try client.close()
			let task = serving
			await task unless task is none
			return none
		}
	}

	// A tool that sends the user to a page; served where the value is added.
	internal type McpTill {
		def new() {}

		// Takes a payment in the browser.
		@tool()
		def mcpPay(request Request) !string {
			let answer = try request.elicit("Pay here", "https://pay.example/7", "pay-7")
			return answer.action == ElicitAction.Accept ?? ("opened", "declined")
		}
	}

	internal async def mcpServePair(pair McpPair) {
		pair.server.serve(pair.up, pair.down)
	}

	// A pair whose client accepts only the given revisions; all when empty.
	internal def mcpPair(revisions string[] = []) !McpPair {
		let pair = new McpPair()
		pair.client.revisions = revisions when revisions.len() > 0
		try pair.open()
		return pair
	}

	// Waits for a value a handler sends, "" when none comes.
	internal def mcpAwait(events channel<string>) string {
		let late = time.sleepChan(2s)
		select {
			case events:
				return <- events
			case late:
				return ""
		}
	}

	// Everything a client reads from a server, the same in every revision.
	internal def mcpReadsEverything(client Client) !none {
		assert client.server.name == "test-server" && client.server.version == "1.2.3" && client.capabilities.tools && client.capabilities.resourcesSubscribe
		let tools = try client.tools()
		assert tools.len() >= 7 && tools[0].name == "mcpAdd" && tools[0].description == "Adds two numbers."
		let sum = try client.call("mcpAdd", map<string, any>{"a": 2, "b": 3})
		assert sum.content.len() == 1 && sum.content[0].text == "5" && !sum.isError
		let failed = try client.call("divide", map<string, any>{"a": 1, "b": 0})
		assert failed.isError && failed.content[0].text == "division by zero"
		let kind = ""
		client.call("nothing") onerror (err error) {
			kind = err.kind.name when err is McpError
			recover ToolResult{}
		}
		assert kind == "InvalidParams"
		let resources = try client.resources()
		assert resources.len() == 1 && resources[0].uri == "config://app" && resources[0].mimeType == "application/json"
		let templates = try client.templates()
		assert templates.len() == 1 && templates[0].uriTemplate == "notes://\{id\}"
		let note = try client.read("notes://4")
		assert note.len() == 1 && note[0].text == "note 4" && note[0].uri == "notes://4" && !note[0].binary
		client.read("other://x") onerror (err error) {
			kind = err.kind.name when err is McpError
			recover ResourceContents[]
		}
		assert kind == "NotFound"
		let prompts = try client.prompts()
		assert prompts.len() == 1 && prompts[0].name == "review" && prompts[0].arguments.len() == 2 && prompts[0].arguments[0].required
		let review = try client.prompt("review", map<string, string>{"code": "x", "focus": "Style"})
		assert review.messages.len() == 1 && review.messages[0].role == Role.User && review.messages[0].content.text == "Review for Style: x"
		let offered = try client.complete("review", "focus", "b")
		assert offered.values.equals(string["Bugs"])
		try client.ping()
		return none
	}

	// Asks the client's model, lists its roots, and remembers a step between runs.
	@tool()
	internal def mcpConsult(request Request, question string) !string {
		request.keep("asked:{question}")
		let roots = try request.roots()
		let written = try request.sample(SamplingRequest{messages: [SamplingMessage{role: Role.User, content: [text(question)]}], maxTokens: 50, systemPrompt: "Be brief."})
		return "{written.content[0].text} ({written.model}) in {roots[0].name} after [{request.state}]"
	}

	// One of each kind of content.
	@tool()
	internal def mcpGallery() Content[] {
		return [
			text("caption"),
			image(byte[1, 2, 3], "image/png"),
			audio(byte[4, 5], "audio/wav"),
			embedded(ResourceContents{uri: "mem://blob", mimeType: "application/octet-stream", blob: byte[9, 8, 7], binary: true}),
			link(Resource{uri: "config://app", name: "settings"}),
		]
	}

	check "MCP client" {
		@test()
		def TestClientStateless() !none {
			let pair = try mcpPair()
			assert pair.client.revision == "2026-07-28"
			try mcpReadsEverything(pair.client)
			let point = try pair.client.call("mcpPoint", map<string, any>{"x": 2})
			assert textOf(member(point.structured, "x")) == "" && intOf(member(point.structured, "y")) == 2
			try pair.end()
			return none
		}

		@test()
		def TestConnect() !none {
			let pair = new McpPair()
			try pair.server.discover()
			pair.serving = mcpServePair(pair)
			let client = try connect(pair.down, pair.up)
			assert client.revision == "2026-07-28" && client.info.name == "adm"
			let sum = try client.call("mcpAdd", map<string, any>{"a": 20, "b": 22})
			assert sum.content[0].text == "42"
			try client.close()
			let task = pair.serving
			await task unless task is none
			return none
		}

		@test()
		def TestClientHandshakeRevisions() !none {
			for let (_, revision) in ["2025-11-25", "2025-06-18", "2025-03-26", "2024-11-05"] {
				let pair = try mcpPair([revision])
				assert pair.client.revision == revision
				try mcpReadsEverything(pair.client)
				try pair.end()
			}
			return none
		}

		@test()
		def TestClientFindsTheEra() !none {
			// A server of the handshake revisions: the probe fails, initialize follows.
			let old = new McpPair()
			old.server.revisions = ["2025-11-25", "2025-06-18"]
			try old.open()
			assert old.client.revision == "2025-11-25"
			try old.end()
			// A client of the handshake revisions at a server that speaks them too.
			let both = try mcpPair(["2025-06-18", "2025-03-26"])
			assert both.client.revision == "2025-06-18"
			try both.end()
			// Nothing in common.
			let apart = new McpPair()
			apart.server.revisions = ["2026-07-28"]
			apart.client.revisions = ["2025-06-18"]
			let kind = ""
			apart.open() onerror (err error) {
				kind = err.kind.name when err is McpError
				recover none
			}
			assert kind == "InvalidParams" || kind == "UnsupportedVersion"
			let narrow = new McpPair()
			narrow.server.revisions = ["2025-06-18"]
			narrow.client.revisions = ["2026-07-28"]
			kind = ""
			narrow.open() onerror (err error) {
				kind = err.kind.name when err is McpError
				recover none
			}
			assert kind == "UnsupportedVersion"
			return none
		}

		@test()
		def TestClientAnswersTheServer() !none {
			for let (_, revision) in ["2026-07-28", "2025-11-25", "2025-06-18"] {
				let pair = new McpPair()
				pair.client.revisions = [revision]
				let asked = ""
				pair.client.elicitation = def (request ElicitationRequest) !Elicitation {
					asked = request.message
					return Elicitation{action: ElicitAction.Accept, content: map<string, any>{"name": "Ada"}}
				}
				try pair.open()
				let greeted = try pair.client.call("mcpGreet", map<string, any>{"greeting": "Hello"})
				assert greeted.content[0].text == "Hello, Ada" && asked == "Who?"
				try pair.end()
			}
			// Without a handler the client offers no forms, and the tool cannot ask.
			let plain = try mcpPair()
			let kind = ""
			plain.client.call("mcpGreet", map<string, any>{"greeting": "Hello"}) onerror (err error) {
				kind = err.kind.name when err is McpError
				recover ToolResult{}
			}
			assert kind == "MissingCapability"
			try plain.end()
			return none
		}

		@test()
		def TestClientProgressAndLogs() !none {
			for let (_, revision) in ["2026-07-28", "2025-06-18"] {
				let pair = new McpPair()
				pair.client.revisions = [revision]
				let logs = new channel<string>(8)
				pair.client.logged = def (level LogLevel, data any, logger string) {
					logs.offer("{level} {textOf(data)} {logger}")
				}
				try pair.open()
				try pair.client.logs(LogLevel.Info)
				let steps string[] = []
				let done = try pair.client.call("mcpCount", map<string, any>{"steps": 3}, def (at float, total float, message string) {
					steps.push("{int(at)}/{int(total)} {message}")
				})
				assert done.content[0].text == "done"
				assert mcpAwait(logs) == "Warning counted counter"
				assert steps.join(", ") == "1/3 step 1, 2/3 step 2, 3/3 step 3"
				try pair.end()
			}
			return none
		}

		@test()
		def TestClientChanges() !none {
			for let (_, revision) in ["2026-07-28", "2025-06-18"] {
				let pair = new McpPair()
				pair.client.revisions = [revision]
				let events = new channel<string>(8)
				pair.client.changed = def (kind string) {
					events.offer("changed {kind}")
				}
				pair.client.updated = def (uri string) {
					events.offer("updated {uri}")
				}
				try pair.open()
				try pair.client.watch()
				try pair.client.subscribe("config://app")
				pair.server.removeTool("stamp")
				assert mcpAwait(events) == "changed tools"
				pair.server.updated("config://app")
				assert mcpAwait(events) == "updated config://app"
				try pair.client.unsubscribe("config://app")
				pair.server.updated("config://app")
				pair.server.removePrompt("review")
				assert mcpAwait(events) == "changed prompts"
				try pair.end()
			}
			return none
		}

		@test()
		def TestClientTimeout() !none {
			let pair = try mcpPair()
			pair.client.timeout = 30ms
			let kind = ""
			pair.client.call("mcpWait") onerror (err error) {
				kind = err.kind.name when err is McpError
				recover ToolResult{}
			}
			assert kind == "Timeout"
			// The server was told to stop, and the connection goes on.
			pair.client.timeout = 5s
			let sum = try pair.client.call("mcpAdd", map<string, any>{"a": 1})
			assert sum.content[0].text == "11"
			try pair.end()
			return none
		}

		@test()
		def TestClientSamplingRootsAndState() !none {
			for let (_, revision) in ["2026-07-28", "2025-06-18"] {
				let pair = new McpPair()
				pair.client.revisions = [revision]
				pair.client.roots = def () !Root[] {
					return [Root{uri: "file:///work", name: "work"}]
				}
				let prompted = ""
				pair.client.sampling = def (request SamplingRequest) !SamplingResult {
					prompted = "{request.systemPrompt} {request.messages[0].content[0].text} {request.maxTokens}"
					return SamplingResult{role: Role.Assistant, content: [text("42")], model: "tiny", stopReason: "endTurn"}
				}
				try pair.open()
				let answer = try pair.client.call("mcpConsult", map<string, any>{"question": "why"})
				// With retries the last run sees the state the first one kept; a
				// handshake revision runs once.
				let state = revision == "2026-07-28" ?? ("asked:why", "")
				assert answer.content[0].text == "42 (tiny) in work after [{state}]" && prompted == "Be brief. why 50"
				try pair.end()
			}
			return none
		}

		@test()
		def TestClientContentKinds() !none {
			let pair = try mcpPair()
			let shown = try pair.client.call("mcpGallery")
			let got = shown.content
			assert got.len() == 5 && got[0].kind == ContentKind.Text && got[0].text == "caption"
			assert got[1].kind == ContentKind.Image && got[1].mimeType == "image/png" && got[1].data.hex() == "010203"
			assert got[2].kind == ContentKind.Audio && got[2].data.hex() == "0405"
			let held = got[3].resource
			fail "no embedded resource" when held is none
			assert got[3].kind == ContentKind.Resource && held.binary && held.blob.hex() == "090807" && held.uri == "mem://blob"
			let target = got[4].link
			fail "no resource link" when target is none
			assert got[4].kind == ContentKind.ResourceLink && target.uri == "config://app" && target.name == "settings"
			try pair.end()
			// 2024-11-05 has no audio and no links: they arrive as text.
			let old = try mcpPair(["2024-11-05"])
			let flat = try old.client.call("mcpGallery")
			assert flat.content[2].kind == ContentKind.Text && flat.content[2].text == "[audio audio/wav, 2 bytes]" && flat.content[4].text == "config://app"
			try old.end()
			return none
		}

		@test()
		def TestServerRegistry() !none {
			let pair = try mcpPair()
			pair.server.completion("review", "code", def (request Request, typed string, given map<string, string>) !Completion {
				return Completion{values: ["{typed}()", "{typed}[{given.len()}]"], total: 2}
			})
			let offered = try pair.client.complete("review", "code", "main", map<string, string>{"focus": "Bugs"})
			let total = offered.total
			fail "no total" when total is none
			assert offered.values.equals(string["main()", "main[1]"]) && total == 2
			try pair.server.resource(ResourceTemplate{uriTemplate: "logs://\{day\}", name: "log"}, def (request Request, uri string, parts map<string, string>) !ResourceContents[] {
				return [ResourceContents{text: "log of {parts["day"]}"}]
			})
			let log = try pair.client.read("logs://monday")
			assert log[0].text == "log of monday"
			assert pair.server.removeResource("logs://\{day\}") && pair.server.removeResource("config://app") && !pair.server.removeResource("config://app")
			assert pair.server.resources().len() == 0 && pair.server.templates().len() == 1 && pair.server.prompts().len() == 1 && pair.server.tools().len() >= 7
			try testing.expectError(pair.client.read("logs://monday"))
			try pair.end()
			return none
		}

		@test()
		def TestUrlElicitationCompletes() !none {
			let pair = new McpPair()
			pair.client.revisions = ["2025-11-25"]
			let seen = new channel<string>(4)
			pair.client.elicitationUrls = true
			pair.client.elicitation = def (request ElicitationRequest) !Elicitation {
				seen.offer("{request.url} {request.id}")
				return Elicitation{action: ElicitAction.Accept}
			}
			pair.client.elicitationCompleted = def (id string) {
				seen.offer("done {id}")
			}
			try pair.server.add(new McpTill())
			try pair.open()
			assert firstText(try pair.client.call("mcpPay")) == "opened"
			assert mcpAwait(seen) == "https://pay.example/7 pay-7"
			// The page behind the URL reports back; the client is told once.
			assert pair.server.elicitationComplete("pay-7") && !pair.server.elicitationComplete("pay-7")
			assert mcpAwait(seen) == "done pay-7"
			try pair.end()
			return none
		}

		@test()
		def TestLaunch() !none {
			// The compiler's own MCP server, started as a program and spoken
			// to over its standard streams.
			let client = try launch("adm", ["mcp"])
			assert client.revision != "" && client.server.name != ""
			let tools = try client.tools()
			assert tools.len() > 0 && !(tools.find(t => t.name == "adm_doc") is none)
			try client.close()
			// A program that is none, and one that is no MCP server.
			assert launch("no-such-program-of-mcp-tests") is error
			assert launch("true") is error
			return none
		}
	}
}
