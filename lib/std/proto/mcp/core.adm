// The server's registry and the answers to every method, for both protocol
// eras: revision 2026-07-28, where each request carries its own version and
// capabilities, and the revisions before it, which open with `initialize`.
internal partial module std.proto.mcp.session {
	use (
		std.time
		std.crypto::(constantTimeEqual)
		std.crypto.hash::(hmac, Hash)
		std.data.encoding::(Base64, JSON)
		std.net.url
		std.proto.auth.oauth2
		std.proto.jsonrpc
		std.proto.mcp::*
		std.proto.mcp.wire::*
	)

	struct ToolEntry {
		info Tool
		run  ToolHandler
	}

	struct ResourceEntry {
		info Resource
		run  ResourceHandler
	}

	struct TemplateEntry {
		info    ResourceTemplate
		pattern url.Template
		run     ResourceHandler
	}

	struct PromptEntry {
		info Prompt
		run  PromptHandler
	}

	struct CompletionEntry {
		// The prompt's name or the resource template's URI template.
		reference string
		argument  string
		run       CompletionHandler
	}

	// Every revision the module speaks, newest first.
	def allRevisions() string[] {
		return ["2026-07-28", "2025-11-25", "2025-06-18", "2025-03-26", "2024-11-05"]
	}

	// The first revision without the `initialize` handshake.
	const modernSince = "2026-07-28"

	const versionKey = "io.modelcontextprotocol/protocolVersion"

	const clientInfoKey = "io.modelcontextprotocol/clientInfo"

	const capabilitiesKey = "io.modelcontextprotocol/clientCapabilities"

	const logLevelKey = "io.modelcontextprotocol/logLevel"

	const serverInfoKey = "io.modelcontextprotocol/serverInfo"

	const subscriptionKey = "io.modelcontextprotocol/subscriptionId"

	// How often a listen stream checks that its client is still there.
	const listenCheck = 15s

	type Core {
		info         Implementation
		instructions string
		revisions    string[]
		pageSize     int                     = 0
		ttl          duration                = 0s
		shared       bool                    = true
		timeout      duration                = 60s
		// How long a stream's server finishes requests after its input ended.
		drain        duration                = 5s
		stateKey     byte[]
		stateTtl     duration                = 10min
		experimental map<string, any>
		extensions   map<string, any>
		rootsChanged ?def ()
		logging      bool                    = true
		// The Origin values a browser may send, beside the server's own.
		origins      string[]
		// How long a session of the revisions that have them may stay unused.
		sessionIdle  duration                = 1h
		// Checks the access token of every HTTP request; none serves anyone.
		guard        ?oauth2.ResourceServer
		// The scopes every HTTP request needs.
		guardScopes  string[]
		// How long a task is kept after it was made, and how long clients
		// are asked to wait between two looks at one.
		taskLifetime duration                = 1h
		taskPoll     duration                = 1s
		records      map<string, TaskRecord>
		recordOrder  string[]
		tagged       int                     = 0
		// The connections that were sent a URL elicitation, by its id.
		urlAsked     map<string, Link>

		tools       ToolEntry[]
		resources   ResourceEntry[]
		templates   TemplateEntry[]
		prompts     PromptEntry[]
		completions CompletionEntry[]
		listeners   Listener[]
		conns       Conn[]
		started     bool               = false
		closed      bool               = false
		dispatcher  jsonrpc.Dispatcher
		stops       (def ())[]

		def new(name string, version string) {
			info = Implementation{name: name, version: version}
			revisions = allRevisions()
			dispatcher = new jsonrpc.Dispatcher()
			let core = self
			for let (_, method) in ["server/discover", "initialize", "notifications/initialized", "ping", "tools/list", "tools/call", "resources/list", "resources/templates/list", "resources/read", "resources/subscribe", "resources/unsubscribe", "prompts/list", "prompts/get", "completion/complete", "logging/setLevel", "subscriptions/listen", "notifications/cancelled", "notifications/roots/list_changed", "tasks/get", "tasks/result", "tasks/list", "tasks/cancel", "tasks/update"] {
				dispatcher.handle(method, def (req jsonrpc.Request) !any {
					return try core.answer(req)
				})
			}
		}

		// Registry -------------------------------------------------------------

		atomic def addTool(entry ToolEntry) {
			let at = toolIndex(entry.info.name)
			if at >= 0 {
				tools[at] = entry
			} else {
				tools.push(entry)
			}
		}

		atomic def addResource(entry ResourceEntry) {
			let at = resourceIndex(entry.info.uri)
			if at >= 0 {
				resources[at] = entry
			} else {
				resources.push(entry)
			}
		}

		atomic def addTemplate(entry TemplateEntry) {
			let at = templateIndex(entry.info.uriTemplate)
			if at >= 0 {
				templates[at] = entry
			} else {
				templates.push(entry)
			}
		}

		atomic def addPrompt(entry PromptEntry) {
			let at = promptIndex(entry.info.name)
			if at >= 0 {
				prompts[at] = entry
			} else {
				prompts.push(entry)
			}
		}

		atomic def addCompletion(entry CompletionEntry) {
			let at = completionIndex(entry.reference, entry.argument)
			if at >= 0 {
				completions[at] = entry
			} else {
				completions.push(entry)
			}
		}

		def toolIndex(name string) int {
			for let (i, t) in tools {
				return i when t.info.name == name
			}
			return -1
		}

		def resourceIndex(uri string) int {
			for let (i, r) in resources {
				return i when r.info.uri == uri
			}
			return -1
		}

		def templateIndex(uriTemplate string) int {
			for let (i, t) in templates {
				return i when t.info.uriTemplate == uriTemplate
			}
			return -1
		}

		def promptIndex(name string) int {
			for let (i, p) in prompts {
				return i when p.info.name == name
			}
			return -1
		}

		def completionIndex(reference string, argument string) int {
			for let (i, c) in completions {
				return i when c.reference == reference && c.argument == argument
			}
			return -1
		}

		atomic def dropTool(name string) bool {
			let at = toolIndex(name)
			return false when at < 0
			tools.remove(at)
			return true
		}

		atomic def dropResource(uri string) bool {
			let at = resourceIndex(uri)
			if at >= 0 {
				resources.remove(at)
				return true
			}
			let held = templateIndex(uri)
			return false when held < 0
			templates.remove(held)
			return true
		}

		atomic def dropPrompt(name string) bool {
			let at = promptIndex(name)
			return false when at < 0
			prompts.remove(at)
			return true
		}

		def capabilities() ServerCapabilities {
			return ServerCapabilities{
				tools:                true,
				toolsListChanged:     true,
				resources:            true,
				resourcesSubscribe:   true,
				resourcesListChanged: true,
				prompts:              true,
				promptsListChanged:   true,
				logging:              logging,
				completions:          true,
				tasks:                !(tools.find(t => t.info.taskSupport != TaskSupport.Forbidden) is none),
				experimental:         experimental,
				extensions:           extensions,
			}
		}

		atomic def noteUrl(id string, link Link) {
			urlAsked.set(id, link)
		}

		atomic def takeUrl(id string) ?Link {
			let link = urlAsked.get(id)
			urlAsked.delete(id) unless link is none
			return link
		}

		// Tells the client that was sent the URL elicitation id that what the
		// URL led to is done. False when no such elicitation is open.
		def elicitationComplete(id string) bool {
			let link = takeUrl(id)
			return false when link is none
			link.notify("notifications/elicitation/complete", map<string, any>{"elicitationId": id}) onerror recover none
			return true
		}

		// Tasks ----------------------------------------------------------------------

		// Files a task, and drops the ones whose lifetime has passed.
		atomic def keepTask(record TaskRecord) {
			let kept string[] = []
			for let (_, id) in recordOrder {
				let held = records.get(id)
				continue when held is none
				if held.expired() {
					held.exchange.stop()
					records.delete(id)
					continue
				}
				kept.push(id)
			}
			kept.push(record.info.id)
			recordOrder = kept
			records.set(record.info.id, record)
		}

		// The task of an id; none when there is none or its lifetime has
		// passed.
		atomic def findTask(id string) ?TaskRecord {
			let record = records.get(id)
			return none when record is none
			return record unless record.expired()
			record.exchange.stop()
			records.delete(id)
			return none
		}

		atomic def tasksOf(owner string) TaskRecord[] {
			let out TaskRecord[] = []
			for let (_, id) in recordOrder {
				let record = records.get(id)
				out.push(record) when !(record is none) && record.owner == owner && !record.expired()
			}
			return out
		}

		// The name a connection owns its tasks under.
		atomic def tagOf(conn Conn) string {
			if conn.tag == "" {
				tagged++
				conn.tag = "connection {tagged}"
			}
			return conn.tag
		}

		// Connections and listeners ---------------------------------------------

		atomic def attach(conn Conn) {
			conns.push(conn)
		}

		atomic def detach(conn Conn) {
			let at = conns.indexOf(conn)
			conns.remove(at) when at >= 0
		}

		atomic def listen(listener Listener) {
			listeners.push(listener)
		}

		atomic def unlisten(listener Listener) {
			let at = listeners.indexOf(listener)
			listeners.remove(at) when at >= 0
		}

		atomic def everyListener() Listener[] {
			return listeners.clone()
		}

		atomic def everyConn() Conn[] {
			return conns.clone()
		}

		// Tells the clients that listen for it that a list changed: kind is
		// `tools`, `resources` or `prompts`.
		def changed(kind string) {
			return unless started
			let method = "notifications/{kind}/list_changed"
			for let (_, l) in everyListener() {
				let wanted = kind == "tools" ?? (l.tools, kind == "prompts" ?? (l.prompts, l.resources))
				continue unless wanted
				l.link.notify(method, tagged(l.id, new map<string, any>())) onerror recover none
			}
			for let (_, conn) in everyConn() {
				continue unless conn.legacy && conn.initialized
				conn.link.notify(method, new map<string, any>()) onerror recover none
			}
		}

		// Tells the clients subscribed to a resource that it changed.
		def updated(uri string) {
			for let (_, l) in everyListener() {
				continue unless uri in l.uris
				l.link.notify("notifications/resources/updated", tagged(l.id, map<string, any>{"uri": uri})) onerror recover none
			}
			for let (_, conn) in everyConn() {
				continue unless conn.legacy && conn.watches(uri)
				conn.link.notify("notifications/resources/updated", map<string, any>{"uri": uri}) onerror recover none
			}
		}

		// Ends every listen stream and marks the server closed.
		def close() {
			closed = true
			for let (_, l) in everyListener() {
				l.done.offer(true)
			}
			for let (_, stop) in stops {
				stop()
			}
		}

		// Registers what a transport must do when the server closes.
		def onClose(stop def ()) {
			stops.push(stop)
		}

		// Dispatch -----------------------------------------------------------------

		def answer(req jsonrpc.Request) !any {
			let env = envelopeOf(req.context)
			fail jsonrpc.errorOf(-32603, "mcp: a request without its connection") when env is none
			started = true
			let carried = member(req.params, "_meta")
			return try modern(req, env, carried) when has(carried, versionKey)
			return try legacy(req, env)
		}

		// Revision 2026-07-28: everything about the client is in `_meta`.
		def modern(req jsonrpc.Request, env Envelope, carried any) !any {
			let version = textOf(member(carried, versionKey))
			fail unsupported(version) unless version in revisions && atLeast(version, modernSince)
			if req.method == "notifications/cancelled" {
				cancel(env.conn, req.params)
				return none
			}
			fail jsonrpc.errorOf(-32602, "mcp: _meta has no {capabilitiesKey}") unless has(carried, capabilitiesKey)
			let x = exchangeOf(req, env, carried)
			x.modern = true
			x.revision = version
			x.client = implementationOf(member(carried, clientInfoKey))
			x.capabilities = clientCapabilitiesOf(member(carried, capabilitiesKey))
			if has(carried, logLevelKey) {
				let level = levelOf(member(carried, logLevelKey))
				fail jsonrpc.errorOf(-32602, "mcp: unknown log level") when level is none
				x.logLevel = level when logging
			}
			// What the client carries between the runs of a request: the
			// handler's own state and the answers of the earlier rounds, since
			// a retry brings only the answers of the last one.
			let sealed = textOf(member(req.params, "requestState"))
			if sealed != "" {
				let carriedState = try new JSON().parse(try opened(sealed, req.method))
				x.state = textOf(member(carriedState, "state"))
				x.nextState = x.state
				x.responses = objectOf(member(carriedState, "answers"))
			}
			for let (key, answer) in objectOf(member(req.params, "inputResponses")) {
				x.responses.set(key, answer)
			}
			let out map<string, any>
			match req.method {
				case "server/discover":
					out = cached(map<string, any>{"supportedVersions": textsJson(revisions), "capabilities": serverCapabilitiesJson(capabilities(), version)})
					put(out, "instructions", instructions)
				case "tools/list":
					out = cached(try listTools(req.params, version))
				case "resources/list":
					out = cached(try listResources(req.params, version))
				case "resources/templates/list":
					out = cached(try listTemplates(req.params, version))
				case "prompts/list":
					out = cached(try listPrompts(req.params, version))
				case "tools/call", "resources/read", "prompts/get":
					out = try guarded(req, env, x)
					out = cached(out) when req.method == "resources/read" && !out.hasKey("resultType")
				case "completion/complete":
					out = try complete(new Request(x), req.params)
				case "subscriptions/listen":
					out = try listenFor(req, env, x)
				case "tasks/get", "tasks/update", "tasks/cancel":
					fail missingTasks("{req.method} needs the tasks extension") unless x.capabilities.extensions.hasKey(tasksExtension)
					out = req.method == "tasks/get" ?? (try getTask(self, env, true, req.params), req.method == "tasks/update" ?? (try updateTask(self, env, req.params), try cancelTask(self, env, true, req.params)))
				default:
					fail jsonrpc.errorOf(-32601, "Method not found: {req.method}")
			}
			out.set("resultType", "complete") unless out.hasKey("resultType")
			let carriedBack = objectOf(member(out, "_meta"))
			carriedBack.set(serverInfoKey, implementationJson(info, version))
			out.set("_meta", carriedBack)
			return out
		}

		// The revisions before 2026-07-28: `initialize` first, then requests
		// that rely on what it agreed.
		def legacy(req jsonrpc.Request, env Envelope) !any {
			let conn = env.conn
			match req.method {
				case "initialize":
					return try initialize(conn, req.params)
				case "ping":
					return new map<string, any>()
				case "notifications/cancelled":
					cancel(conn, req.params)
					return none
			}
			if !conn.legacy {
				let supported = map<string, any>{"supported": textsJson(revisions)}
				fail jsonrpc.errorOf(-32600, "mcp: a request must carry {versionKey} in _meta, or follow initialize", supported)
			}
			let version = conn.revision
			match req.method {
				case "notifications/initialized":
					conn.initialized = true
					return none
				case "notifications/roots/list_changed":
					let told = rootsChanged
					told() unless told is none
					return none
				case "logging/setLevel":
					let level = levelOf(member(req.params, "level"))
					fail jsonrpc.errorOf(-32602, "mcp: unknown log level") when level is none
					conn.logLevel = level
					return new map<string, any>()
				case "tools/list":
					return try listTools(req.params, version)
				case "resources/list":
					return try listResources(req.params, version)
				case "resources/templates/list":
					return try listTemplates(req.params, version)
				case "prompts/list":
					return try listPrompts(req.params, version)
				case "resources/subscribe":
					conn.subscribe(textOf(member(req.params, "uri")))
					return new map<string, any>()
				case "resources/unsubscribe":
					conn.unsubscribe(textOf(member(req.params, "uri")))
					return new map<string, any>()
			}
			if version == "2025-11-25" {
				match req.method {
					case "tasks/get":
						return try getTask(self, env, false, req.params)
					case "tasks/result":
						return try taskResult(self, env, req.params)
					case "tasks/list":
						return try listTasks(self, env, req.params)
					case "tasks/cancel":
						return try cancelTask(self, env, false, req.params)
				}
			}
			let x = exchangeOf(req, env, member(req.params, "_meta"))
			x.revision = version
			x.client = conn.client
			x.capabilities = conn.capabilities
			x.logLevel = conn.logLevel when logging
			match req.method {
				case "tools/call", "resources/read", "prompts/get":
					return try guarded(req, env, x)
				case "completion/complete":
					return try complete(new Request(x), req.params)
			}
			fail jsonrpc.errorOf(-32601, "Method not found: {req.method}")
		}

		def initialize(conn Conn, params any) !any {
			let wanted = textOf(member(params, "protocolVersion"))
			let older string[] = []
			for let (_, revision) in revisions {
				older.push(revision) unless atLeast(revision, modernSince)
			}
			if older.len() == 0 {
				let supported = map<string, any>{"supported": textsJson(revisions), "requested": wanted}
				fail jsonrpc.errorOf(-32602, "Unsupported protocol version: this server speaks {revisions.join(", ")}, which have no initialize", supported)
			}
			// A revision the server lacks is answered with its newest one;
			// the client leaves when it cannot speak that.
			let chosen = wanted in older ?? (wanted, older[0])
			conn.legacy = true
			conn.revision = chosen
			conn.client = implementationOf(member(params, "clientInfo"))
			conn.capabilities = clientCapabilitiesOf(member(params, "capabilities"))
			let out = map<string, any>{"protocolVersion": chosen, "capabilities": serverCapabilitiesJson(capabilities(), chosen), "serverInfo": implementationJson(info, chosen)}
			put(out, "instructions", instructions)
			return out
		}

		// The state of a request about to be answered.
		def exchangeOf(req jsonrpc.Request, env Envelope, carried any) Exchange {
			let x = new Exchange(env.link)
			x.method = req.method
			x.id = req.id
			x.admission = env.admission
			let core = self
			x.urlAsked = def (id string) {
				core.noteUrl(id, env.conn.link)
			}
			x.progressToken = member(carried, "progressToken")
			for let (key, value) in objectOf(carried) {
				x.extra.set(key, value) unless key == "progressToken" || key.startsWith(metaPrefix)
			}
			return x
		}

		// Runs a tool call, a resource read or a prompt, cancellable while
		// it runs.
		def guarded(req jsonrpc.Request, env Envelope, x Exchange) !map<string, any> {
			let background = req.method == "tools/call" ?? (try runsAsTask(self, req, x), false)
			return try startTask(self, req, env, x) when background
			let key = idKey(req.id)
			env.conn.track(key, x)
			let failure ?error = none
			let out = run(req, x) onerror (err error) {
				failure = err
				recover new map<string, any>()
			}
			env.conn.release(key)
			fail jsonrpc.NoReply{message: "mcp: the request was cancelled"} when x.stopped() && !env.http
			fail failure unless failure is none
			return out
		}

		def run(req jsonrpc.Request, x Exchange) !map<string, any> {
			let request = new Request(x)
			let failure ?error = none
			let out = new map<string, any>()
			match req.method {
				case "tools/call":
					out = callTool(request, req.params, x.revision, x.modern) onerror (err error) {
						failure = err
						recover new map<string, any>()
					}
				case "resources/read":
					out = readResource(request, req.params, x) onerror (err error) {
						failure = err
						recover new map<string, any>()
					}
				default:
					out = getPrompt(request, req.params, x.revision) onerror (err error) {
						failure = err
						recover new map<string, any>()
					}
			}
			return out when failure is none
			if failure is InputRequired {
				let wanted = map<string, any>{"resultType": "input_required", "inputRequests": failure.requests}
				let kept = map<string, any>{"state": x.nextState, "answers": x.responses}
				wanted.set("requestState", sealed(string(new JSON().encode(kept)), req.method))
				return wanted
			}
			fail jsonrpc.errorOf(failure.number == 0 ?? (-32603, failure.number), failure.message, failure.data) when failure is McpError
			fail failure
		}

		// Tools ------------------------------------------------------------------

		def listTools(params any, rev string) !map<string, any> {
			let (from, to, next) = try page(params, tools.len())
			let items any[] = []
			for let i = from; i < to; i++ {
				items.push(toolJson(tools[i].info, rev))
			}
			let out = map<string, any>{"tools": items}
			put(out, "nextCursor", next)
			return out
		}

		// A tool that fails has run and says so in its result, which the
		// model reads; only a tool that does not exist is a protocol error.
		def callTool(request Request, params any, rev string, modern bool) !map<string, any> {
			let name = textOf(member(params, "name"))
			let entry = tools.find(t => t.info.name == name)
			fail jsonrpc.errorOf(-32602, "Unknown tool: {name}") when entry is none
			let failure ?error = none
			let run = entry.run
			let result = run(request, objectOf(member(params, "arguments"))) onerror (err error) {
				failure = err
				recover ToolResult{}
			}
			if !(failure is none) {
				fail failure when failure is InputRequired || failure is jsonrpc.RPCError
				fail failure when failure is McpError && modern
				result = ToolResult{content: [text(failure.message)], isError: true}
			}
			return toolResultJson(result, rev)
		}

		// Resources --------------------------------------------------------------

		def listResources(params any, rev string) !map<string, any> {
			let (from, to, next) = try page(params, resources.len())
			let items any[] = []
			for let i = from; i < to; i++ {
				items.push(resourceJson(resources[i].info, rev))
			}
			let out = map<string, any>{"resources": items}
			put(out, "nextCursor", next)
			return out
		}

		def listTemplates(params any, rev string) !map<string, any> {
			let (from, to, next) = try page(params, templates.len())
			let items any[] = []
			for let i = from; i < to; i++ {
				items.push(templateJson(templates[i].info, rev))
			}
			let out = map<string, any>{"resourceTemplates": items}
			put(out, "nextCursor", next)
			return out
		}

		def readResource(request Request, params any, x Exchange) !map<string, any> {
			let uri = textOf(member(params, "uri"))
			let contents ResourceContents[] = []
			let fixed = resources.find(r => r.info.uri == uri)
			if !(fixed is none) {
				let run = fixed.run
				contents = try run(request, uri, new map<string, string>())
				for let (i, c) in contents {
					contents[i].mimeType = fixed.info.mimeType when c.mimeType == ""
				}
			} else {
				let found = false
				for let (_, entry) in templates {
					let parts = entry.pattern.extract(uri)
					continue when parts is none
					let run = entry.run
					contents = try run(request, uri, parts)
					for let (i, c) in contents {
						contents[i].mimeType = entry.info.mimeType when c.mimeType == ""
					}
					found = true
					break
				}
				// -32002 is what the revisions with a handshake use.
				fail jsonrpc.errorOf(x.modern ?? (-32602, -32002), "Resource not found", map<string, any>{"uri": uri}) unless found
			}
			let items any[] = []
			for let (_, c) in contents {
				let item = c
				item.uri = uri when item.uri == ""
				items.push(contentsJson(item))
			}
			return map<string, any>{"contents": items}
		}

		// Prompts ----------------------------------------------------------------

		def listPrompts(params any, rev string) !map<string, any> {
			let (from, to, next) = try page(params, prompts.len())
			let items any[] = []
			for let i = from; i < to; i++ {
				items.push(promptJson(prompts[i].info, rev))
			}
			let out = map<string, any>{"prompts": items}
			put(out, "nextCursor", next)
			return out
		}

		def getPrompt(request Request, params any, rev string) !map<string, any> {
			let name = textOf(member(params, "name"))
			let entry = prompts.find(p => p.info.name == name)
			fail jsonrpc.errorOf(-32602, "Unknown prompt: {name}") when entry is none
			let given = new map<string, string>()
			for let (key, value) in objectOf(member(params, "arguments")) {
				given.set(key, textOf(value))
			}
			for let (_, a) in entry.info.arguments {
				fail jsonrpc.errorOf(-32602, "Missing required argument: {a.name}") when a.required && !given.hasKey(a.name)
			}
			let run = entry.run
			let result = try run(request, given)
			result.description = entry.info.description when result.description == ""
			return promptResultJson(result, rev)
		}

		// Completion ---------------------------------------------------------------

		def complete(request Request, params any) !map<string, any> {
			let target = member(params, "ref")
			let reference = textOf(member(target, "type")) == "ref/prompt" ?? (textOf(member(target, "name")), textOf(member(target, "uri")))
			let argument = textOf(member(member(params, "argument"), "name"))
			let value = textOf(member(member(params, "argument"), "value"))
			let entry = completions.find(c => c.reference == reference && c.argument == argument)
			return completionJson(Completion{}) when entry is none
			let given = new map<string, string>()
			for let (key, text) in objectOf(member(member(params, "context"), "arguments")) {
				given.set(key, textOf(text))
			}
			let run = entry.run
			return completionJson(try run(request, value, given))
		}

		// Subscriptions (2026-07-28) -----------------------------------------------

		// Answers `subscriptions/listen`: acknowledges, then holds the request
		// open until the client cancels, goes away, or the server closes.
		def listenFor(req jsonrpc.Request, env Envelope, x Exchange) !map<string, any> {
			let filter = member(req.params, "notifications")
			let listener = new Listener(req.id, env.link)
			listener.tools = boolOf(member(filter, "toolsListChanged"))
			listener.prompts = boolOf(member(filter, "promptsListChanged"))
			listener.resources = boolOf(member(filter, "resourcesListChanged"))
			listener.uris = textsOf(member(filter, "resourceSubscriptions"))
			let agreed = new map<string, any>()
			if has(filter, "taskIds") {
				fail missingTasks("task notifications need the tasks extension") unless x.capabilities.extensions.hasKey(tasksExtension)
				let owner = ownerOf(self, env, true)
				for let (_, id) in textsOf(member(filter, "taskIds")) {
					let record = findTask(id)
					listener.taskIds.push(id) when !(record is none) && record.owner == owner
				}
				agreed.set("taskIds", textsJson(listener.taskIds))
			}
			agreed.set("toolsListChanged", true) when listener.tools
			agreed.set("promptsListChanged", true) when listener.prompts
			agreed.set("resourcesListChanged", true) when listener.resources
			agreed.set("resourceSubscriptions", textsJson(listener.uris)) when has(filter, "resourceSubscriptions")
			try env.link.notify("notifications/subscriptions/acknowledged", tagged(req.id, map<string, any>{"notifications": agreed}))
			let key = idKey(req.id)
			env.conn.track(key, x)
			listen(listener)
			let ended = closed
			for !ended && !x.stopped() && env.link.alive() {
				let tick = time.sleepChan(listenCheck)
				select {
					case listener.done:
						ended = true
					case x.wake:
					case tick:
						env.link.beat()
				}
			}
			unlisten(listener)
			env.conn.release(key)
			fail jsonrpc.NoReply{message: "mcp: the subscription was cancelled"} unless ended
			// The server ends the stream: it says so, then answers the request.
			env.link.notify("notifications/cancelled", map<string, any>{"requestId": req.id, "reason": "the server is closing"}) onerror recover none
			return map<string, any>{"_meta": map<string, any>{subscriptionKey: req.id}}
		}

		// Utilities ------------------------------------------------------------------

		def cancel(conn Conn, params any) {
			let x = conn.find(idKey(member(params, "requestId")))
			return when x is none
			x.stop()
		}

		// The slice of a list a cursor selects and the cursor of the page
		// after it, "" on the last page. Fails with -32602 on a cursor this
		// server did not hand out.
		def page(params any, count int) !(int, int, string) {
			let cursor = textOf(member(params, "cursor"))
			let from = 0
			if cursor != "" {
				fail jsonrpc.errorOf(-32602, "Invalid cursor") unless /^[0-9]{1,9}$/.test(cursor)
				from = parseInt<int>(cursor)
				fail jsonrpc.errorOf(-32602, "Invalid cursor") when from > count
			}
			let to = pageSize > 0 && from + pageSize < count ?? (from + pageSize, count)
			return (from, to, to < count ?? ("{to}", ""))
		}

		// Adds the caching hints of a list, a read or a discovery.
		def cached(out map<string, any>) map<string, any> {
			out.set("ttlMs", int(ttl) / 1000000)
			out.set("cacheScope", shared ?? ("public", "private"))
			return out
		}

		def unsupported(requested string) jsonrpc.RPCError {
			return jsonrpc.errorOf(-32022, "Unsupported protocol version", map<string, any>{"supported": textsJson(revisions), "requested": requested})
		}

		// The state a handler keeps, as the client carries it: with the
		// method it belongs to and the time it lapses, under a MAC, so what
		// comes back is what was handed out.
		def sealed(state string, method string) string {
			let codec = new Base64()
			codec.urlSafe = true
			codec.padded = false
			let lapses = time.now().unixNs() + int64(int(stateTtl))
			let body = "{lapses}\n{method}\n{state}".bytes()
			return codec.encode(body) + "." + codec.encode(hmac(Hash.SHA256, stateKey, body))
		}

		// The state inside what the client sent back. Fails with -32602 when
		// it was changed, has lapsed, or belongs to another method.
		def opened(sealed string, method string) !string {
			let codec = new Base64()
			codec.urlSafe = true
			codec.padded = false
			let parts = sealed.split(".")
			fail jsonrpc.errorOf(-32602, "Invalid requestState") unless parts.len() == 2
			let body = codec.decode(parts[0]) onerror (err error) {
				fail jsonrpc.errorOf(-32602, "Invalid requestState")
			}
			let mac = codec.decode(parts[1]) onerror (err error) {
				fail jsonrpc.errorOf(-32602, "Invalid requestState")
			}
			fail jsonrpc.errorOf(-32602, "Invalid requestState") unless constantTimeEqual(mac, hmac(Hash.SHA256, stateKey, body))
			let fields = string(body).split("\n", 3)
			fail jsonrpc.errorOf(-32602, "Invalid requestState") unless fields.len() == 3 && fields[1] == method
			fail jsonrpc.errorOf(-32602, "The requestState has lapsed") when parseInt<int64>(fields[0]) < time.now().unixNs()
			return fields[2]
		}
	}

	// A notification's params with the subscription it belongs to.
	def tagged(id any, params map<string, any>) map<string, any> {
		params.set("_meta", map<string, any>{subscriptionKey: id})
		return params
	}

	def envelopeOf(context any) ?Envelope {
		match context {
			case Envelope:
				return context
			default:
				return none
		}
	}
}
