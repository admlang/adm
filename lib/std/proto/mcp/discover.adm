// Marked functions and methods as registry entries: what `@mcp.tool`,
// `@mcp.resource` and `@mcp.prompt` declare, run through reflection.
internal partial module std.proto.mcp.session {
	use (
		std.reflection
		std.reflection::(FunctionDescriptor, AttrHit, ReflectionKind, FieldKind)
		std.data.encoding::(JSON)
		std.data.encoding.jsonschema::(Callable, SchemaError)
		std.net.url
		std.proto.jsonrpc
		std.proto.mcp::*
		std.proto.mcp.wire::*
	)

	// Registers the marked declarations. With only set, the marked methods
	// of value's type, run on value; else the marked functions and the
	// marked methods of services. Fails when a URI template does not parse,
	// or, with only set, when the type has no marked method.
	def discoverInto(core Core, value any, only bool) !none {
		let owner = only ?? (reflection.typeName(value), "")
		let found = 0
		for let (_, hit) in reflection.attrs(tool) {
			let fn = reflection.asFunction(hit.node)
			continue when fn is none
			let (served, receiver) = receiverOf(fn, value, owner, only)
			continue unless served
			core.addTool(toolEntry(fn, hit, receiver))
			found++
		}
		for let (_, hit) in reflection.attrs(resource) {
			let fn = reflection.asFunction(hit.node)
			continue when fn is none
			let (served, receiver) = receiverOf(fn, value, owner, only)
			continue unless served
			try discoverResource(core, fn, hit, receiver)
			found++
		}
		for let (_, hit) in reflection.attrs(prompt) {
			let fn = reflection.asFunction(hit.node)
			continue when fn is none
			let (served, receiver) = receiverOf(fn, value, owner, only)
			continue unless served
			discoverPrompt(core, fn, hit, receiver)
			found++
		}
		fail McpError{message: "mcp: {owner} has no method marked @mcp.tool, @mcp.resource or @mcp.prompt", code: "NotFound", kind: McpErrorKind.NotFound} when only && found == 0
		if found > 0 {
			core.changed("tools")
			core.changed("resources")
			core.changed("prompts")
		}
		return none
	}

	// Whether a marked declaration is served in this pass, and the value its
	// method runs on.
	def receiverOf(fn FunctionDescriptor, value any, owner string, only bool) (bool, any) {
		return (!only, none) when fn.node.kind != ReflectionKind.Method
		let held = fn.ownerType.typeName
		return (held == owner, value) when only
		let instance = reflection.serviceInstance(held)
		return (!(instance is none), instance)
	}

	// How many leading parameters are the request rather than arguments.
	def leadingOf(fn FunctionDescriptor) int {
		let declared = fn.signature.parameters
		return declared.len() > 0 && declared[0].paramType.typeName == "std.proto.mcp.Request" ?? (1, 0)
	}

	def leadingValues(count int, request Request) any[] {
		let out any[] = []
		out.push(request) when count > 0
		return out
	}

	// The annotation argument by parameter name or position, without the
	// quotes of a string literal; "" when not written.
	def argument(hit AttrHit, name string, position int) string {
		let found = hit.attr.arguments.get(name)
		found = hit.attr.arguments.get("#{position}") when found is none
		return "" when found is none
		let written = string(found).trim()
		return written[1:written.len() - 1] when written.len() >= 2 && written.startsWith("\"") && written.endsWith("\"")
		return written
	}

	// A hint argument: none when not written.
	def hint(hit AttrHit, name string, position int) ?bool {
		let written = argument(hit, name, position)
		return none when written == ""
		return written == "true"
	}

	def toolEntry(fn FunctionDescriptor, hit AttrHit, receiver any) ToolEntry {
		let leading = leadingOf(fn)
		let callable = new Callable(fn, receiver, leading)
		let named = argument(hit, "name", 0)
		let info = Tool{
			name:         named == "" ?? (callable.name, named),
			title:        argument(hit, "title", 1),
			description:  callable.description,
			inputSchema:  callable.inputSchema(),
			outputSchema: callable.outputSchema(),
		}
		let hints = ToolHints{readOnly: hint(hit, "readOnly", 2), destructive: hint(hit, "destructive", 3), idempotent: hint(hit, "idempotent", 4), openWorld: hint(hit, "openWorld", 5)}
		let any = !(hints.readOnly is none) || !(hints.destructive is none) || !(hints.idempotent is none) || !(hints.openWorld is none)
		info.hints = hints when any
		// The argument as written: `TaskSupport.Optional`, with or without
		// its module.
		let support = argument(hit, "task", 6)
		info.taskSupport = TaskSupport.Optional when support.endsWith("Optional")
		info.taskSupport = TaskSupport.Required when support.endsWith("Required")
		let structured = !(info.outputSchema is none)
		return ToolEntry{
			info: info,
			run:  def (request Request, arguments map<string, any>) !ToolResult {
				let failure ?error = none
				let value = callable.call(arguments, leadingValues(leading, request)) onerror (err error) {
					failure = err
					recover none
				}
				if !(failure is none) {
					// Arguments that do not fit are the model's to correct.
					return ToolResult{content: [text("Invalid arguments: {failure.message}")], isError: true} when failure is SchemaError
					fail failure
				}
				return toolResult(value, structured)
			},
		}
	}

	// What a tool function returned, as a tool result.
	def toolResult(value any, structured bool) ToolResult {
		return ToolResult{} when value is none
		match value {
			case ToolResult:
				return value
			case Content:
				return ToolResult{content: [value]}
			case string:
				return ToolResult{content: [text(value)]}
			case byte[]:
				return ToolResult{content: [embedded(ResourceContents{uri: "bytes:result", mimeType: "application/octet-stream", blob: value, binary: true})]}
			default:
		}
		if reflection.kindOf(value) == FieldKind.Array {
			// A list of contents, read element by element: an array that came
			// back through reflection matches no array pattern.
			let items Content[] = []
			let uniform = true
			for let (_, element) in reflection.elements(value) {
				match element {
					case Content:
						items.push(element)
					default:
						uniform = false
				}
			}
			return ToolResult{content: items} when uniform
		}
		return ToolResult{content: [text("{value}")]} unless structured
		let json = new JSON()
		let encoded = json.encode(value)
		let parsed = json.parse(encoded) onerror recover none
		return ToolResult{content: [text(string(encoded))], structured: parsed}
	}

	def discoverResource(core Core, fn FunctionDescriptor, hit AttrHit, receiver any) !none {
		let leading = leadingOf(fn)
		let callable = new Callable(fn, receiver, leading)
		let address = argument(hit, "uri", 0)
		let named = argument(hit, "name", 1)
		let name = named == "" ?? (callable.name, named)
		let mimeType = argument(hit, "mimeType", 2)
		let title = argument(hit, "title", 3)
		let run = def (request Request, _ string, parts map<string, string>) !ResourceContents[] {
			let given = new map<string, any>()
			for let (key, value) in parts {
				given.set(key, value)
			}
			let failure ?error = none
			let value = callable.call(given, leadingValues(leading, request)) onerror (err error) {
				failure = err
				recover none
			}
			if !(failure is none) {
				fail jsonrpc.errorOf(-32602, "Invalid resource URI: {failure.message}") when failure is SchemaError
				fail failure
			}
			return resourceContents(value)
		}
		if !address.contains("\{") {
			core.addResource(ResourceEntry{info: Resource{uri: address, name: name, title: title, description: callable.description, mimeType: mimeType}, run: run})
			return none
		}
		let pattern = try url.parseTemplate(address)
		core.addTemplate(TemplateEntry{info: ResourceTemplate{uriTemplate: address, name: name, title: title, description: callable.description, mimeType: mimeType}, pattern: pattern, run: run})
		addChoices(core, address, callable)
		return none
	}

	// What a resource function returned, as contents.
	def resourceContents(value any) ResourceContents[] {
		return [] when value is none
		match value {
			case ResourceContents:
				return [value]
			case string:
				return [ResourceContents{text: value}]
			case byte[]:
				return [ResourceContents{blob: value, binary: true}]
			default:
		}
		if reflection.kindOf(value) == FieldKind.Array {
			let items ResourceContents[] = []
			let uniform = true
			for let (_, element) in reflection.elements(value) {
				match element {
					case ResourceContents:
						items.push(element)
					default:
						uniform = false
				}
			}
			return items when uniform
		}
		return [ResourceContents{text: string(new JSON().encode(value)), mimeType: "application/json"}]
	}

	def discoverPrompt(core Core, fn FunctionDescriptor, hit AttrHit, receiver any) {
		let leading = leadingOf(fn)
		let callable = new Callable(fn, receiver, leading)
		let named = argument(hit, "name", 0)
		let info = Prompt{name: named == "" ?? (callable.name, named), title: argument(hit, "title", 1), description: callable.description}
		for let (_, p) in callable.parameters {
			info.arguments.push(PromptArgument{name: p.name, description: p.description, required: p.required})
		}
		core.addPrompt(PromptEntry{
			info: info,
			run:  def (request Request, arguments map<string, string>) !PromptResult {
				let given = new map<string, any>()
				for let (key, value) in arguments {
					given.set(key, value)
				}
				let failure ?error = none
				let value = callable.call(given, leadingValues(leading, request)) onerror (err error) {
					failure = err
					recover none
				}
				if !(failure is none) {
					fail jsonrpc.errorOf(-32602, "Invalid arguments: {failure.message}") when failure is SchemaError
					fail failure
				}
				return promptResult(value)
			},
		})
		addChoices(core, info.name, callable)
	}

	// What a prompt function returned, as a prompt.
	def promptResult(value any) PromptResult {
		return PromptResult{} when value is none
		match value {
			case PromptResult:
				return value
			case PromptMessage:
				return PromptResult{messages: [value]}
			case Content:
				return PromptResult{messages: [PromptMessage{role: Role.User, content: value}]}
			case string:
				return PromptResult{messages: [PromptMessage{role: Role.User, content: text(value)}]}
			default:
		}
		if reflection.kindOf(value) == FieldKind.Array {
			let items PromptMessage[] = []
			let uniform = true
			for let (_, element) in reflection.elements(value) {
				match element {
					case PromptMessage:
						items.push(element)
					default:
						uniform = false
				}
			}
			return PromptResult{messages: items} when uniform
		}
		return PromptResult{messages: [PromptMessage{role: Role.User, content: text("{value}")}]}
	}

	// Offers the members of each enum parameter as its completions.
	def addChoices(core Core, reference string, callable Callable) {
		for let (_, p) in callable.parameters {
			let choices = textsOf(member(p.schema, "enum"))
			continue when choices.len() == 0
			core.addCompletion(CompletionEntry{
				reference: reference,
				argument:  p.name,
				run:       def (_request Request, typed string, _given map<string, string>) !Completion {
					let lowered = typed.lower()
					return Completion{values: choices.filter(c => c.lower().startsWith(lowered))}
				},
			})
		}
	}
}
