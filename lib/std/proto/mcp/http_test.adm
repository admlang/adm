partial module std.proto.mcp {
	use (
		std.testing
		std.time
		std.bytes
		std.data.encoding::(JSON)
		std.net.http
		std.net.http.httptest
		std.proto.mcp.wire::*
	)

	// An MCP server behind a loopback HTTP server.
	internal type McpSite {
		server Server
		site   httptest.Server
		target string

		def new(server Server, site httptest.Server) {
			self.server = server
			self.site = site
			target = site.url + "/mcp"
		}

		// Posts one message with the given headers and returns the status,
		// the content type and the body.
		def post(message map<string, any>, headers map<string, string>) !(int, string, string) {
			message.set("jsonrpc", "2.0")
			let req = try http.newRequest(http.Method.POST, target, new bytes.Reader(new JSON().encode(message)))
			req.headers.set("Content-Type", "application/json")
			req.headers.set("Accept", "application/json, text/event-stream")
			for let (name, value) in headers {
				req.headers.set(name, value)
			}
			let res = try site.client().do(req)
			let body = try res.text()
			return (res.status, res.headers.get("Content-Type"), body)
		}

		// A 2026-07-28 request with the headers that mirror it.
		def ask(id int, method string, params map<string, any> = {}, extra map<string, string> = {}, carried map<string, any> = {}) !(int, string, string) {
			carried.set("io.modelcontextprotocol/protocolVersion", "2026-07-28")
			carried.set("io.modelcontextprotocol/clientCapabilities", new map<string, any>())
			params.set("_meta", carried)
			let headers = map<string, string>{"MCP-Protocol-Version": "2026-07-28", "Mcp-Method": method}
			headers.set("Mcp-Name", textOf(member(params, "name"))) when has(params, "name")
			headers.set("Mcp-Name", textOf(member(params, "uri"))) when has(params, "uri")
			for let (name, value) in extra {
				if value == "" {
					headers.delete(name)
				} else {
					headers.set(name, value)
				}
			}
			return try post(map<string, any>{"id": id, "method": method, "params": params}, headers)
		}

		def end() !none {
			server.close()
			return try site.close()
		}
	}

	internal def mcpSite() !McpSite {
		let server = new Server("test-server", "1.2.3")
		try server.discover()
		try server.add(new McpDesk())
		let schema = map<string, any>{"type": "object", "properties": map<string, any>{"region": map<string, any>{"type": "string", "x-mcp-header": "Region"}, "query": map<string, any>{"type": "string"}}}
		server.tool(Tool{name: "regional", inputSchema: schema}, def (request Request, arguments map<string, any>) !ToolResult {
			return ToolResult{content: [text("in {textOf(member(arguments, "region"))}")]}
		})
		let mux = new http.ServeMux()
		try mux.handle("/mcp", server.handler())
		return new McpSite(server, try httptest.Server.start(mux))
	}

	internal def parsed(body string) !any {
		return try new JSON().parse(body)
	}

	check "MCP over HTTP" {
		@test()
		def TestHttpStatelessRequests() !none {
			let site = try mcpSite()
			let (status, kind, body) = try site.ask(1, "tools/list")
			assert status == 200 && kind.startsWith("application/json") && listOf(at(try parsed(body), "result.tools")).len() == 10
			// The headers must repeat the body.
			(status, kind, body) = try site.ask(2, "tools/list", new map<string, any>(), map<string, string>{"Mcp-Method": ""})
			assert status == 400 && jsonOf(at(try parsed(body), "error.code")) == "-32020"
			(status, kind, body) = try site.ask(3, "tools/call", map<string, any>{"name": "mcpAdd", "arguments": map<string, any>{"a": 1}}, map<string, string>{"Mcp-Name": "divide"})
			assert status == 400 && textOf(at(try parsed(body), "error.message")) == "Header mismatch: Mcp-Name header value 'divide' does not match body value 'mcpAdd'"
			(status, kind, body) = try site.ask(4, "tools/list", new map<string, any>(), map<string, string>{"MCP-Protocol-Version": "2025-06-18"})
			assert status == 400 && jsonOf(at(try parsed(body), "error.code")) == "-32020"
			// A name that is no plain header value travels in base64.
			(status, kind, body) = try site.ask(5, "resources/read", map<string, any>{"uri": "notes://3"}, map<string, string>{"Mcp-Name": "=?base64?bm90ZXM6Ly8z?="})
			assert status == 200 && textOf(at(try parsed(body), "result.contents.0.text")) == "note 3"
			// An argument marked x-mcp-header travels as a header too.
			let call = map<string, any>{"name": "regional", "arguments": map<string, any>{"region": "eu-west", "query": "q"}}
			(status, kind, body) = try site.ask(6, "tools/call", call.clone(), map<string, string>{"Mcp-Param-Region": "eu-west"})
			assert status == 200 && textOf(at(try parsed(body), "result.content.0.text")) == "in eu-west"
			(status, kind, body) = try site.ask(7, "tools/call", call.clone())
			assert status == 400 && textOf(at(try parsed(body), "error.message")) == "Header mismatch: the Mcp-Param-Region header is missing"
			(status, kind, body) = try site.ask(8, "tools/call", call.clone(), map<string, string>{"Mcp-Param-Region": "us-east"})
			assert status == 400
			// Status codes of the other refusals.
			(status, kind, body) = try site.ask(9, "ping")
			assert status == 404 && jsonOf(at(try parsed(body), "error.code")) == "-32601"
			let future = map<string, any>{"id": 10, "method": "tools/list", "params": map<string, any>{"_meta": map<string, any>{"io.modelcontextprotocol/protocolVersion": "2031-01-01", "io.modelcontextprotocol/clientCapabilities": new map<string, any>()}}}
			(status, kind, body) = try site.post(future, map<string, string>{"MCP-Protocol-Version": "2031-01-01", "Mcp-Method": "tools/list"})
			assert status == 400 && jsonOf(at(try parsed(body), "error.code")) == "-32022" && textOf(at(try parsed(body), "error.data.supported.0")) == "2026-07-28"
			(status, kind, body) = try site.ask(11, "tools/list", new map<string, any>(), map<string, string>{"Origin": "https://evil.example"})
			assert status == 403
			(status, kind, body) = try site.ask(12, "tools/list", new map<string, any>(), map<string, string>{"Origin": site.site.url})
			assert status == 200
			try site.end()
			return none
		}

		@test()
		def TestHttpResponseStream() !none {
			let site = try mcpSite()
			let (status, kind, body) = try site.ask(1, "tools/call", map<string, any>{"name": "mcpCount", "arguments": map<string, any>{"steps": 2}}, new map<string, string>(), map<string, any>{"progressToken": 5})
			assert status == 200 && kind.startsWith("text/event-stream")
			let events = new http.EventReader(new bytes.Reader(body.bytes()))
			let methods string[] = []
			for {
				let event = try events.next()
				break when event is none
				let message = try parsed(event.data)
				methods.push(has(message, "method") ?? (textOf(member(message, "method")), "response {jsonOf(member(message, "id"))}"))
			}
			assert methods.join(", ") == "notifications/progress, notifications/progress, response 1"
			try site.end()
			return none
		}

		@test()
		def TestHttpClientStateless() !none {
			let site = try mcpSite()
			let client = new Client("test-client", "0.1")
			let events = new channel<string>(8)
			client.changed = def (kind string) {
				events.offer("changed {kind}")
			}
			client.updated = def (uri string) {
				events.offer("updated {uri}")
			}
			client.elicitation = def (request ElicitationRequest) !Elicitation {
				return Elicitation{action: ElicitAction.Accept, content: map<string, any>{"name": "Ada"}}
			}
			try client.open(site.target)
			assert client.revision == "2026-07-28" && client.server.name == "test-server"
			let tools = try client.tools()
			assert tools.len() == 10
			let sum = try client.call("mcpAdd", map<string, any>{"a": 2, "b": 3})
			assert sum.content[0].text == "5"
			let note = try client.read("notes://4")
			assert note[0].text == "note 4"
			let regional = try client.call("regional", map<string, any>{"region": "Zürich", "query": "q"})
			assert regional.content[0].text == "in Zürich"
			let greeted = try client.call("mcpGreet", map<string, any>{"greeting": "Hello"})
			assert greeted.content[0].text == "Hello, Ada"
			let steps = 0
			let counted = try client.call("mcpCount", map<string, any>{"steps": 3}, def (done float, total float, message string) {
				steps++
			})
			assert counted.content[0].text == "done" && steps == 3
			try client.watch()
			try client.subscribe("config://app")
			site.server.removeTool("stamp")
			assert mcpAwait(events) == "changed tools"
			site.server.updated("config://app")
			assert mcpAwait(events) == "updated config://app"
			try client.close()
			try site.end()
			return none
		}

		@test()
		def TestHttpClientSessions() !none {
			for let (_, revision) in ["2025-11-25", "2025-03-26"] {
				let site = try mcpSite()
				let client = new Client("test-client", "0.1")
				client.revisions = [revision]
				let events = new channel<string>(8)
				client.changed = def (kind string) {
					events.offer("changed {kind}")
				}
				client.updated = def (uri string) {
					events.offer("updated {uri}")
				}
				client.elicitation = def (request ElicitationRequest) !Elicitation {
					return Elicitation{action: ElicitAction.Accept, content: map<string, any>{"name": "Bo"}}
				}
				try client.open(site.target)
				assert client.revision == revision
				try mcpReadsEverything(client)
				let steps = 0
				let counted = try client.call("mcpCount", map<string, any>{"steps": 2}, def (done float, total float, message string) {
					steps++
				})
				assert counted.content[0].text == "done" && steps == 2
				try client.subscribe("config://app")
				// The session's own stream opens beside the handshake.
				time.sleep(50ms)
				site.server.updated("config://app")
				assert mcpAwait(events) == "updated config://app"
				site.server.removeTool("stamp")
				assert mcpAwait(events) == "changed tools"
				if revision == "2025-11-25" {
					let greeted = try client.call("mcpGreet", map<string, any>{"greeting": "Hi"})
					assert greeted.content[0].text == "Hi, Bo"
				}
				try client.close()
				try site.end()
			}
			return none
		}

		@test()
		def TestHttpOldTransport() !none {
			// A server that answers POST only for the sessions its GET stream opened, as 2024-11-05 servers do.
			let server = new Server("old-server", "0.9")
			try server.discover()
			let inner = server.handler()
			let mux = new http.ServeMux()
			try mux.handle("/sse", def (ctx http.Context) !none {
				return try ctx.error(405) when ctx.method() == http.Method.POST && ctx.query("sessionId") is none
				return try inner.serve(ctx)
			})
			let site = try httptest.Server.start(mux)
			let client = new Client("test-client", "0.1")
			let events = new channel<string>(8)
			client.changed = def (kind string) {
				events.offer("changed {kind}")
			}
			client.elicitation = def (request ElicitationRequest) !Elicitation {
				return Elicitation{action: ElicitAction.Accept, content: map<string, any>{"name": "Cy"}}
			}
			client.timeout = 3s
			client.probeTimeout = 1s
			try client.open(site.url + "/sse")
			assert client.revision == "2025-11-25" && client.server.name == "old-server"
			let sum = try client.call("mcpAdd", map<string, any>{"a": 4, "b": 4})
			assert sum.content[0].text == "8"
			let greeted = try client.call("mcpGreet", map<string, any>{"greeting": "Hey"})
			assert greeted.content[0].text == "Hey, Cy"
			server.removeTool("divide")
			assert mcpAwait(events) == "changed tools"
			try client.close()
			server.close()
			try site.close()
			return none
		}

		@test()
		def TestHttpConnect() !none {
			let site = try mcpSite()
			let client = try connect(site.target)
			assert client.revision == "2026-07-28" && (try client.prompts()).len() == 1
			try client.close()
			try site.end()
			return none
		}

		@test()
		def TestHttpTimeout() !none {
			let site = try mcpSite()
			let client = new Client("test-client", "0.1")
			// A revision that cancels with a notification; 2026-07-28 cancels
			// by closing the response, which std.net.http does not yet report
			// to a running handler.
			client.revisions = ["2025-11-25"]
			try client.open(site.target)
			client.timeout = 50ms
			let kind = ""
			client.call("mcpWait") onerror (err error) {
				kind = err.kind.name when err is McpError
				recover ToolResult{}
			}
			assert kind == "Timeout"
			client.timeout = 5s
			let sum = try client.call("mcpAdd", map<string, any>{"a": 1})
			assert sum.content[0].text == "11"
			try client.close()
			try site.end()
			return none
		}

		@test()
		def TestHttpCancelledMidAnswer() !none {
			// A request given up while its answer is on the way must leave
			// the connection whole: the next request is answered.
			let site = try mcpSite()
			let client = new Client("test-client", "0.1")
			client.revisions = ["2025-11-25"]
			try client.open(site.target)
			for let (_, cut) in [15ms, 30ms, 45ms] {
				client.timeout = cut
				client.tools() onerror recover Tool[]
				client.timeout = 2s
				assert (try client.tools()).len() == 10
			}
			try client.close()
			try site.end()
			return none
		}
	}
}
