// The Model Context Protocol (modelcontextprotocol.io): how a program offers
// tools, data and prompt templates to an AI application, and how an AI
// application uses them. A server is a few marked functions and one call:
//
// ```
// use std.proto.mcp
//
// // Adds two numbers.
// // @param a the first number
// // @param b the second number
// @mcp.tool()
// def add(a int, b int) int {
// 	return a + b
// }
//
// // A note by its id.
// @mcp.resource("notes://\{id\}")
// def note(id string) !string { ... }
//
// // Asks for a review of some code.
// @mcp.prompt()
// def review(code string, focus string = "bugs") string { ... }
//
// try mcp.serve("calculator", "1.0.0")
// ```
//
// Revisions 2026-07-28, 2025-11-25, 2025-06-18, 2025-03-26 and 2024-11-05
// are spoken, over a stream of lines (standard input and output) and over
// HTTP.
partial module std.proto.mcp {
	use std.reflection::(DiscoveryMetaContext, FunctionMetaContext, MethodMetaContext)

	// Makes a function a tool of the MCP server. Its doc comment is the
	// tool's description and each `@param name text` tag its parameter's;
	// the parameters' names, types and defaults are the tool's arguments (a
	// default or an optional type makes one optional, an enum lists its
	// members, a struct is an object). A first parameter of type
	// `mcp.Request` is the request, not an argument.
	//
	// What the function returns is the result: a `ToolResult`, a `Content`
	// or `Content[]` as they are, a struct or a map as structured content
	// with its JSON as text, bytes as an embedded binary resource, anything
	// else as text. A failure is a result marked as an error, whose message
	// the model reads.
	//
	//     name         the tool's name instead of the function's
	//     title        a name to show to people
	//     readOnly     it does not change its environment
	//     destructive  it may destroy something (a client assumes so)
	//     idempotent   calling it again with the same arguments changes nothing more
	//     openWorld    it reaches things outside the server (a client assumes so)
	//     task         whether a call runs as a task, work the server carries
	//                  on after it answered: `TaskSupport.Optional` for a
	//                  client that can follow one, `Required` for no other
	//
	// The four hints are sent only when written.
	meta def tool(ctx DiscoveryMetaContext<FunctionMetaContext>, name string = "", title string = "", readOnly bool = false, destructive bool = true, idempotent bool = false, openWorld bool = true, task TaskSupport = TaskSupport.Forbidden) {}

	// Makes a method a tool, as the function form does. A method of a
	// service runs on the service and is found by `Server.discover`; a
	// method of another type is served only for a value given to
	// `Server.add`.
	meta def tool(ctx DiscoveryMetaContext<MethodMetaContext>, name string = "", title string = "", readOnly bool = false, destructive bool = true, idempotent bool = false, openWorld bool = true, task TaskSupport = TaskSupport.Forbidden) {}

	// Makes a function a resource of the MCP server. uri without holes is
	// the resource's address; with `\{name\}` holes (an RFC 6570 template) it
	// is a family of resources, and each hole is the function's parameter of
	// that name. The doc comment is the description. A first parameter of
	// type `mcp.Request` is the request.
	//
	// What the function returns is the contents: `ResourceContents` or an
	// array of them as they are, a string as text, bytes as a blob, anything
	// else as its JSON.
	//
	//     name      the resource's name instead of the function's
	//     mimeType  the media type of the contents
	//     title     a name to show to people
	meta def resource(ctx DiscoveryMetaContext<FunctionMetaContext>, uri string, name string = "", mimeType string = "", title string = "") {}

	// Makes a method a resource, as the function form does; see `tool` for
	// which value it runs on.
	meta def resource(ctx DiscoveryMetaContext<MethodMetaContext>, uri string, name string = "", mimeType string = "", title string = "") {}

	// Makes a function a prompt template of the MCP server. Its parameters
	// are the prompt's arguments, which arrive as text; its doc comment and
	// `@param` tags describe them. A parameter of an enum type offers its
	// members as completions. A first parameter of type `mcp.Request` is the
	// request.
	//
	// What the function returns is the prompt: a `PromptResult`, a
	// `PromptMessage` or an array of them as they are, a string or a
	// `Content` as one message of the user.
	//
	//     name   the prompt's name instead of the function's
	//     title  a name to show to people
	meta def prompt(ctx DiscoveryMetaContext<FunctionMetaContext>, name string = "", title string = "") {}

	// Makes a method a prompt template, as the function form does; see
	// `tool` for which value it runs on.
	meta def prompt(ctx DiscoveryMetaContext<MethodMetaContext>, name string = "", title string = "") {}

	// Serves every function marked `@mcp.tool`, `@mcp.resource` or
	// `@mcp.prompt` over standard input and output, until the input ends.
	// Fails when a marked resource's URI template does not parse.
	def serve(name string, version string) !none {
		let server = new Server(name, version)
		try server.discover()
		server.serve()
		return none
	}
}
