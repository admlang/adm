partial module std.proto.mcp {
	use (
		std.crypto::(rand)
		std.proto.auth.oauth2
		std.proto.jsonrpc
		std.proto.mcp.session::*
		std.proto.mcp.wire::*
	)

	// A request as its handler sees it: who asked, and what the handler may
	// send back while it works. A function marked `@mcp.tool`,
	// `@mcp.resource` or `@mcp.prompt` gets it by declaring it as its first
	// parameter; it is not part of the tool's arguments.
	//
	// ```
	// @mcp.tool()
	// def resize(request mcp.Request, path string, width int) !string {
	// 	request.progress(0.0, 2.0, "reading")
	// 	...
	// }
	// ```
	//
	// `elicit`, `sample` and `roots` ask the client for something. With a
	// client of revision 2026-07-28 the answer does not come back into the
	// running handler: the call fails, the client is told what is needed,
	// and it sends the request again with the answers, so the handler runs
	// from the top and the same call returns. Pass that failure on with
	// `try`, ask in the same order on every run, and do nothing before the
	// last of these calls that must not happen twice.
	type Request {
		// The method being answered: `tools/call`, `resources/read`, …
		method       string
		// The JSON-RPC id of the request.
		id           any
		// The protocol revision the client speaks, as `2026-07-28`.
		revision     string
		client       Implementation
		capabilities ClientCapabilities
		// The request's `_meta` without the protocol's own members.
		extra        map<string, any>
		// What an earlier run handed to `keep`, sent back by the client with
		// its retry; "" on a first run. It went through the client: a server
		// without a `stateKey` shared by its instances cannot trust it.
		state        string
		// The access token the request came with: who asks (`subject`,
		// `clientId`) and what they may do (`scopes`). None over a stream,
		// and over HTTP when the server is not protected.
		token        ?oauth2.AccessToken

		internal exchange Exchange

		def new(exchange Exchange) {
			self.exchange = exchange
			method = exchange.method
			id = exchange.id
			revision = exchange.revision
			client = exchange.client
			capabilities = exchange.capabilities
			extra = exchange.extra
			state = exchange.state
			let admission = exchange.admission
			token = admission.token unless admission is none
		}

		// Fails unless the request's access token carries every scope named.
		// Over HTTP the client is then answered 403 with the scopes to ask
		// for, and one that can asks the user for them and sends the request
		// again; call it before the handler sends anything, since a response
		// that has begun cannot turn into a 403 and ends in an error
		// instead. A request without a token passes: the server is not
		// protected, or serves a stream.
		def require(scopes ...string) !none {
			let admission = exchange.admission
			return none when admission is none
			let missing string[] = []
			for let scope in scopes {
				missing.push(scope) unless admission.token.has(scope)
			}
			return none when missing.len() == 0
			for let scope in scopes {
				admission.needed.push(scope) unless scope in admission.needed
			}
			fail jsonrpc.errorOf(-32003, "mcp: the access token lacks scope {missing.join(" ")}")
		}

		// Tells the client how far the work is, when it asked for progress.
		// done must grow from call to call; total is the value done ends at,
		// 0 when not known.
		def progress(done float, total float = 0.0, message string = "") {
			// A task shows the message as its own, to clients that only look.
			let task = exchange.task
			task.note(message) when !(task is none) && message.len() > 0
			return when exchange.progressToken is none || done <= exchange.lastProgress
			exchange.lastProgress = done
			let params = map<string, any>{"progressToken": exchange.progressToken, "progress": done}
			params.set("total", total) when total > 0.0
			params.set("message", message) when message.len() > 0 && atLeast(revision, "2025-03-26")
			exchange.link.notify("notifications/progress", params) onerror recover none
		}

		// Sends a log message to the client: data is any JSON value, logger
		// names its source. Dropped when the client asked for less severe
		// messages only, or for none.
		def log(level LogLevel, data any, logger string = "") {
			let least = exchange.logLevel
			return when least is none || level.ordinal < least.ordinal
			let params = map<string, any>{"level": levelText(level), "data": data}
			put(params, "logger", logger)
			exchange.link.notify("notifications/message", params) onerror recover none
		}

		// Whether the client cancelled the request or went away. A handler
		// that works for long checks it and returns early; what it returns
		// is dropped.
		def cancelled() bool {
			return exchange.stopped() || !exchange.link.alive()
		}

		// Stores text the client sends back when it retries this request
		// (revision 2026-07-28); it is in `state` on the next run. Without
		// effect on the earlier revisions, whose handlers keep running.
		def keep(state string) {
			exchange.nextState = state
		}

		// Asks the user for values through a form. schema is the JSON Schema
		// of a flat object: each property a string, number, integer, boolean
		// or a choice from a list.
		//
		// Fails when the client shows no forms, when it does not answer, and
		// as the type's comment says for revision 2026-07-28.
		def elicit(message string, schema map<string, any>) !Elicitation {
			fail missing("elicitation", map<string, any>{"form": new map<string, any>()}) unless capabilities.elicitation
			let params = map<string, any>{"message": message, "requestedSchema": schema}
			params.set("mode", "form") when atLeast(revision, "2025-11-25")
			return elicitationOf(try ask("elicitation/create", params))
		}

		// Asks the user to open a URL in a browser, for what must not pass
		// through the client: a login, a payment. The answer says whether the
		// user agreed to open it, not whether what happens there is done.
		//
		//
		// id names the elicitation for `Server.elicitationComplete`, which
		// tells a client of revision 2025-11-25 that what the URL led to is
		// done; put the same id in the URL so the page behind it can report
		// back. "" makes one up.
		//
		// Fails when the client opens no URLs (revisions before 2025-11-25
		// cannot), when it does not answer, and as the type's comment says
		// for revision 2026-07-28.
		def elicit(message string, url string, id string = "") !Elicitation {
			fail missing("elicitation", map<string, any>{"url": new map<string, any>()}) unless capabilities.elicitationUrl
			let params = map<string, any>{"mode": "url", "message": message, "url": url}
			if !exchange.modern {
				let named = id
				if named == "" {
					let made = try rand(16)
					named = made.hex()
				}
				params.set("elicitationId", named)
				let noted = exchange.urlAsked
				noted(named) unless noted is none
			}
			return elicitationOf(try ask("elicitation/create", params))
		}

		// Asks the client's model to write a message.
		//
		// Fails when the client offers no sampling, or none with tools when
		// the request has tools, when the user or the client refuses, and as
		// the type's comment says for revision 2026-07-28.
		def sample(request SamplingRequest) !SamplingResult {
			fail missing("sampling", new map<string, any>()) unless capabilities.sampling
			fail missing("sampling", map<string, any>{"tools": new map<string, any>()}) when request.tools.len() > 0 && !capabilities.samplingTools
			return samplingResultOf(try ask("sampling/createMessage", samplingRequestJson(request, revision)))
		}

		// The folders and files the client lets the server work in.
		//
		// Fails when the client has no roots to give, when it does not
		// answer, and as the type's comment says for revision 2026-07-28.
		def roots() !Root[] {
			fail missing("roots", new map<string, any>()) unless capabilities.roots
			return rootsOf(try ask("roots/list", none))
		}

		// The client's answer to a request of the server.
		internal def ask(method string, params any) !any {
			// A task waits for its answer where it stands; it is not run again.
			let task = exchange.task
			return try awaitInput(task, exchange, method, params) unless task is none
			return try exchange.link.call(method, params) unless exchange.modern
			let key = "{method.replace("/", "-")}-{exchange.asked}"
			exchange.asked++
			return exchange.responses[key] when exchange.responses.hasKey(key)
			let wanted = map<string, any>{"method": method}
			wanted.set("params", params) unless params is none
			fail InputRequired{message: "mcp: {method} needs the client's answer", code: "InputRequired", requests: map<string, any>{key: wanted}}
		}

		internal def missing(capability string, settings map<string, any>) McpError {
			return McpError{
				message: "mcp: the client does not offer {capability}",
				code:    "MissingCapability",
				kind:    McpErrorKind.MissingCapability,
				number:  -32021,
				data:    map<string, any>{"requiredCapabilities": map<string, any>{capability: settings}},
			}
		}
	}
}
