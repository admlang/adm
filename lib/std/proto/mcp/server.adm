partial module std.proto.mcp {
	use (
		std.io
		std.os
		std.crypto::(rand)
		std.net.url
		std.net.http
		std.proto.auth.oauth2
		std.proto.mcp.session::*
	)

	// Runs a tool: the arguments object of the call, as `JSON.parse` builds
	// it. A failure is sent as a tool result marked `isError`, whose text
	// the model reads; fail with a `jsonrpc.RPCError` to answer with a
	// protocol error instead.
	type ToolHandler = def(Request, map<string, any>) !ToolResult

	// Reads a resource: the URI asked for and, for a template, the values of
	// its holes by name. A failure is answered with an internal error
	// carrying its message.
	type ResourceHandler = def(Request, string, map<string, string>) !ResourceContents[]

	// Builds a prompt from its arguments by name.
	type PromptHandler = def(Request, map<string, string>) !PromptResult

	// Offers values for one argument of a prompt or one hole of a resource
	// template: the text typed so far, and the arguments already filled in.
	type CompletionHandler = def(Request, string, map<string, string>) !Completion

	// An MCP server: the tools, resources and prompts a program offers, and
	// the transports that serve them.
	//
	// ```
	// let server = new mcp.Server("calculator", "1.0.0")
	// server.discover()                 // every @mcp.tool, @mcp.resource and @mcp.prompt
	// server.add(new Notebook())        // the annotated methods of a value
	// try server.serve()                // standard input and output
	// ```
	//
	// It speaks revision 2026-07-28 and the four before it, and tells them
	// apart by how a client opens: with its version in each request, or with
	// `initialize`.
	type Server {
		internal core Core

		// Describes the server to clients. name and version are what the
		// constructor took.
		info Implementation {
			def get() Implementation {
				return core.info
			}

			def set(val Implementation) {
				core.info = val
			}
		}

		// Guidance for the model on how to use this server, shown by clients
		// that support it; "" for none.
		instructions string {
			def get() string {
				return core.instructions
			}

			def set(val string) {
				core.instructions = val
			}
		}

		// The protocol revisions served, newest first. Every revision the
		// module speaks unless narrowed.
		revisions string[] {
			def get() string[] {
				return core.revisions
			}

			def set(val string[]) {
				core.revisions = val
			}
		}

		// The most entries one page of a list holds; 0 for the whole list in
		// one page.
		pageSize int {
			def get() int {
				return core.pageSize
			}

			def set(val int) {
				core.pageSize = val
			}
		}

		// How long a client may reuse a list, a discovery or a resource it
		// read (revision 2026-07-28); 0s for not at all.
		ttl duration {
			def get() duration {
				return core.ttl
			}

			def set(val duration) {
				core.ttl = val
			}
		}

		// Whether lists and resources are the same for every caller, so a
		// cache between clients may share them. Set it to false when they
		// depend on who asks.
		shared bool {
			def get() bool {
				return core.shared
			}

			def set(val bool) {
				core.shared = val
			}
		}

		// How long a request to the client (`elicit`, `sample`, `roots` on
		// the revisions before 2026-07-28) waits for its answer.
		timeout duration {
			def get() duration {
				return core.timeout
			}

			def set(val duration) {
				core.timeout = val
			}
		}

		// The key that protects what `Request.keep` hands to the client.
		// Random for each server unless set; instances that answer each
		// other's retries share one.
		stateKey byte[] {
			def get() byte[] {
				return core.stateKey
			}

			def set(val byte[]) {
				core.stateKey = val
			}
		}

		// Whether log messages go to clients that ask for them.
		logging bool {
			def get() bool {
				return core.logging
			}

			def set(val bool) {
				core.logging = val
			}
		}

		// Settings of the extensions the server supports, by identifier
		// (`io.modelcontextprotocol/tasks`), as announced to clients.
		extensions map<string, any> {
			def get() map<string, any> {
				return core.extensions
			}

			def set(val map<string, any>) {
				core.extensions = val
			}
		}

		// Called when a client says its roots changed (revisions before
		// 2026-07-28).
		rootsChanged ?def () {
			def get() ?def () {
				return core.rootsChanged
			}

			def set(val ?def ()) {
				core.rootsChanged = val
			}
		}

		// The `Origin` values a browser may send to the HTTP endpoint, beside
		// the endpoint's own host; `*` for any. Requests without an Origin,
		// as programs send them, are always taken.
		origins string[] {
			def get() string[] {
				return core.origins
			}

			def set(val string[]) {
				core.origins = val
			}
		}

		// How long an HTTP session of a client of the revisions before
		// 2026-07-28 may stay unused before it is dropped.
		sessionIdle duration {
			def get() duration {
				return core.sessionIdle
			}

			def set(val duration) {
				core.sessionIdle = val
			}
		}

		// How long a task is kept after its call was made; a client of
		// revision 2025-11-25 may ask for less. The task's result is gone
		// with it.
		taskLifetime duration {
			def get() duration {
				return core.taskLifetime
			}

			def set(val duration) {
				core.taskLifetime = val
			}
		}

		// How long clients are asked to wait between two looks at a task.
		taskPollInterval duration {
			def get() duration {
				return core.taskPoll
			}

			def set(val duration) {
				core.taskPoll = val
			}
		}

		def new(name string, version string) {
			core = new Core(name, version)
			let key = rand(32) onerror recover byte[]
			core.stateKey = key
		}

		// Adds a tool, replacing one of the same name. Clients that listen
		// are told the list changed.
		def tool(info Tool, handler ToolHandler) {
			core.addTool(ToolEntry{info: info, run: handler})
			core.changed("tools")
		}

		// Adds a resource with a fixed URI, replacing one with the same URI.
		def resource(info Resource, handler ResourceHandler) {
			core.addResource(ResourceEntry{info: info, run: handler})
			core.changed("resources")
		}

		// Adds a family of resources addressed by a URI template (RFC 6570):
		// a read of a URI that fits it reaches the handler with the values
		// of the holes. Fails when the template does not parse.
		def resource(info ResourceTemplate, handler ResourceHandler) !none {
			let pattern = try url.parseTemplate(info.uriTemplate)
			core.addTemplate(TemplateEntry{info: info, pattern: pattern, run: handler})
			core.changed("resources")
			return none
		}

		// Adds a prompt, replacing one of the same name.
		def prompt(info Prompt, handler PromptHandler) {
			core.addPrompt(PromptEntry{info: info, run: handler})
			core.changed("prompts")
		}

		// Offers completions for one argument of a prompt (reference is its
		// name) or one hole of a resource template (reference is the URI
		// template).
		def completion(reference string, argument string, handler CompletionHandler) {
			core.addCompletion(CompletionEntry{reference: reference, argument: argument, run: handler})
		}

		// Removes a tool by name; false when there is none.
		def removeTool(name string) bool {
			let removed = core.dropTool(name)
			core.changed("tools") when removed
			return removed
		}

		// Removes a resource by URI, or a template by its URI template;
		// false when there is none.
		def removeResource(uri string) bool {
			let removed = core.dropResource(uri)
			core.changed("resources") when removed
			return removed
		}

		// Removes a prompt by name; false when there is none.
		def removePrompt(name string) bool {
			let removed = core.dropPrompt(name)
			core.changed("prompts") when removed
			return removed
		}

		// The tools, in the order they were added.
		def tools() Tool[] {
			let out Tool[] = []
			for let (_, entry) in core.tools {
				out.push(entry.info)
			}
			return out
		}

		// The resources with a fixed URI, in the order they were added.
		def resources() Resource[] {
			let out Resource[] = []
			for let (_, entry) in core.resources {
				out.push(entry.info)
			}
			return out
		}

		// The resource templates, in the order they were added.
		def templates() ResourceTemplate[] {
			let out ResourceTemplate[] = []
			for let (_, entry) in core.templates {
				out.push(entry.info)
			}
			return out
		}

		// The prompts, in the order they were added.
		def prompts() Prompt[] {
			let out Prompt[] = []
			for let (_, entry) in core.prompts {
				out.push(entry.info)
			}
			return out
		}

		// Adds every function marked `@mcp.tool`, `@mcp.resource` or
		// `@mcp.prompt`, and the marked methods of services, which run on
		// the service. Marked methods of other types wait for `add`. Fails
		// when a resource's URI template does not parse.
		def discover() !none {
			return try discoverInto(core, none, false)
		}

		// Adds the marked methods of value's type, each run on value. Fails
		// when the type has none, or a URI template does not parse.
		def add(value any) !none {
			return try discoverInto(core, value, true)
		}

		// Tells the clients subscribed to a resource that it changed.
		def updated(uri string) {
			core.updated(uri)
		}

		// Tells the client that was asked to open a URL (`Request.elicit`
		// with a URL and this id) that what the URL led to is done: the
		// login went through, the payment was made. Revision 2025-11-25
		// only; 2026-07-28 dropped the notification, and a client there
		// asks again. False when no elicitation of that id was sent, or it
		// was reported already.
		def elicitationComplete(id string) bool {
			return core.elicitationComplete(id)
		}

		// Serves one client over standard input and output until the input
		// ends. Nothing else may write to standard output meanwhile; the
		// `Logging` console writer goes to standard error unless configured
		// otherwise.
		def serve() {
			serveStream(core, os.stdin, os.stdout)
		}

		// Serves one client over a stream, one JSON message per line, until
		// the reader ends: a socket, a pipe.
		def serve(reader io.Reader, writer io.Writer) {
			serveStream(core, reader, writer)
		}

		// Protects the HTTP endpoint (the protocol's authorization, OAuth
		// 2.1): every request must carry an access token guard accepts, with
		// every scope of scopes, and is answered 401 or 403 with a challenge
		// otherwise. A handler reads the token from `Request.token` and asks
		// for more scopes with `Request.require`.
		//
		// ```
		// let guard = new oauth2.ResourceServer(try oauth2.discover(issuer), "https://tools.example.com/mcp")
		// guard.resource = new oauth2.ResourceMetadata("https://tools.example.com/mcp", [issuer])
		// server.protect(guard, ["tools"])
		// ```
		//
		// The guard's audience is the endpoint's URL as clients write it:
		// they ask the authorization server for a token for that resource,
		// and a token for another is refused. Its `resource` is the metadata
		// clients find the authorization server by; `serve(address)` serves
		// that document, and a program that mounts `handler()` itself mounts
		// `guard.resource.handler()` at `guard.resource.metadataPath()`,
		// outside any authorization of its own. Streams are not protected:
		// a server on standard input takes its credentials from the
		// environment.
		def protect(guard oauth2.ResourceServer, scopes string[] = []) {
			core.guard = guard
			core.guardScopes = scopes
		}

		// The MCP endpoint, to mount on an `http.Server` or a mux at one
		// path: `mux.handle("/mcp", server.handler())`. It answers POST, and
		// GET and DELETE for clients of the revisions before 2026-07-28.
		def handler() http.Handler {
			return new HttpEndpoint(core)
		}

		// Serves HTTP at address (`127.0.0.1:8080`) with the endpoint at
		// path, until the server stops. An address without a host
		// (`:8080`) listens on the loopback interface only; name
		// `0.0.0.0` to be reached from other machines, and `protect` the
		// server first. Fails when the address cannot be listened on.
		def serve(address string, path string = "/mcp") !none {
			let mux = new http.ServeMux()
			try mux.handle(path, handler())
			let guard = core.guard
			let described = guard is none ?? (none, guard.resource)
			try mux.handle(described.metadataPath(), described.handler()) unless described is none
			let bound = address.startsWith(":") ?? ("127.0.0.1" + address, address)
			return try new http.Server(bound, mux).listenAndServe()
		}

		// Ends the streams of the clients that listen for changes; the
		// transports end when their streams do.
		def close() {
			core.close()
		}
	}
}
