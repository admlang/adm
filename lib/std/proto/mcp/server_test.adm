partial module std.proto.mcp {
	use (
		std.testing
		std.time
		std.bytes
		std.data.encoding::(JSON)
		std.proto.mcp.wire::*
	)

	internal enum McpFocus {
		Bugs,
		Style,
		Speed
	}

	internal struct McpPoint {
		x int
		y int
	}

	// Adds two numbers.
	// @param a the first number
	// @param b the second number
	@tool(readOnly = true, title = "Add")
	internal def mcpAdd(a int, b int = 10) int {
		return a + b
	}

	// Divides a by b.
	@tool(name = "divide")
	internal def mcpDivide(a float, b float) !float {
		expects {
			assert b != 0.0 onerror fail "division by zero"
		}
		return a / b
	}

	// A point on the diagonal.
	@tool()
	internal def mcpPoint(x int) McpPoint {
		return McpPoint{x: x, y: x}
	}

	// Greets whoever the user says.
	@tool()
	internal def mcpGreet(request Request, greeting string) !string {
		let schema = map<string, any>{"type": "object", "properties": map<string, any>{"name": map<string, any>{"type": "string"}}, "required": ["name"]}
		let answer = try request.elicit("Who?", schema)
		return "nobody" unless answer.action == ElicitAction.Accept
		return "{greeting}, {textOf(member(answer.content, "name"))}"
	}

	// Counts to steps, reporting each.
	@tool()
	internal def mcpCount(request Request, steps int) string {
		for let i = 1; i <= steps; i++ {
			request.progress(float(i), float(steps), "step {i}")
		}
		request.log(LogLevel.Debug, "too quiet to send")
		request.log(LogLevel.Warning, "counted", "counter")
		return "done"
	}

	// Waits until it is cancelled.
	@tool()
	internal def mcpWait(request Request) string {
		for !request.cancelled() {
			time.sleep(1ms)
		}
		return "cancelled"
	}

	// The application's settings.
	@resource("config://app", mimeType = "application/json")
	internal def mcpConfig() string {
		return "\{\"debug\": true\}"
	}

	// A note by its number.
	@resource("notes://\{id\}", name = "note")
	internal def mcpNote(id int) !string {
		expects {
			assert id <= 9 onerror fail "no note {id}"
		}
		return "note {id}"
	}

	// Asks for a review of some code.
	// @param code the code to review
	// @param focus what to look for
	@prompt(name = "review")
	internal def mcpReview(code string, focus McpFocus = McpFocus.Bugs) string {
		return "Review for {focus}: {code}"
	}

	internal type McpDesk {
		prefix string = "#"

		// Stamps a text.
		@tool()
		def stamp(body string) string {
			return prefix + body
		}
	}

	// A server and the two pipes a test speaks to it through.
	internal type McpWire {
		server  Server
		toIt    bytes.Pipe
		fromIt  bytes.Pipe
		pending byte[]
		serving async none

		def new() {
			server = new Server("test-server", "1.2.3")
			toIt = new bytes.Pipe()
			fromIt = new bytes.Pipe()
		}

		def send(message map<string, any>) !none {
			message.set("jsonrpc", "2.0")
			try toIt.write(new JSON().encode(message) + [byte(0x0A)])
			return none
		}

		// The next message the server wrote.
		def next() !any {
			for {
				let at = pending.indexOf(byte(0x0A))
				if at >= 0 {
					let line = pending[0:at].clone()
					pending = pending[at + 1:].clone()
					return try new JSON().parse(line)
				}
				let buf byte[]
				buf.len(65536)
				let n = try fromIt.read(buf)
				fail "the server closed its stream" when n == 0
				pending += buf[0:n]
			}
			fail "unreachable"
		}

		// Sends a 2026-07-28 request and returns the response.
		def ask(id int, method string, params map<string, any> = {}, capabilities map<string, any> = {}, carried map<string, any> = {}) !any {
			carried.set("io.modelcontextprotocol/protocolVersion", "2026-07-28")
			carried.set("io.modelcontextprotocol/clientCapabilities", capabilities)
			carried.set("io.modelcontextprotocol/clientInfo", map<string, any>{"name": "test-client", "version": "0.1"})
			params.set("_meta", carried)
			try send(map<string, any>{"id": id, "method": method, "params": params})
			return try next()
		}

		// Opens the connection as revision does, with `initialize`.
		def initialize(revision string, capabilities map<string, any> = {}) !any {
			try send(map<string, any>{"id": 1000, "method": "initialize", "params": map<string, any>{"protocolVersion": revision, "capabilities": capabilities, "clientInfo": map<string, any>{"name": "old-client", "version": "0.1"}}})
			let reply = try next()
			try send(map<string, any>{"method": "notifications/initialized"})
			return reply
		}

		// Sends a request of a revision with a handshake.
		def call(id int, method string, params map<string, any> = {}) !any {
			try send(map<string, any>{"id": id, "method": method, "params": params})
			return try next()
		}

		def end() !none {
			try toIt.close()
			let task = serving
			await task unless task is none
			return none
		}
	}

	internal async def mcpServe(wire McpWire) {
		wire.server.serve(wire.toIt, wire.fromIt)
	}

	internal def mcpWire() !McpWire {
		let wire = new McpWire()
		try wire.server.discover()
		try wire.server.add(new McpDesk())
		wire.serving = mcpServe(wire)
		return wire
	}

	// The value at a dotted path of members and list indexes.
	internal def at(value any, path string) any {
		let current = value
		for let (_, step) in path.split(".") {
			if step.isNumeric() {
				let items = listOf(current)
				let i = step.toInt<int>()
				return none when i >= items.len()
				current = items[i]
			} else {
				current = member(current, step)
			}
		}
		return current
	}

	// The entry of a `tools/list` result with the given name.
	internal def toolNamed(listed any, name string) any {
		for let (_, t) in listOf(at(listed, "result.tools")) {
			return t when textOf(member(t, "name")) == name
		}
		return none
	}

	internal def jsonOf(value any) string {
		return string(new JSON().encode(value))
	}

	check "MCP server" {
		@test()
		def TestDiscoverAndTools() !none {
			let wire = try mcpWire()
			let found = try wire.ask(1, "server/discover")
			assert jsonOf(at(found, "result.supportedVersions")) == "[\"2026-07-28\",\"2025-11-25\",\"2025-06-18\",\"2025-03-26\",\"2024-11-05\"]"
			assert textOf(at(found, "result.resultType")) == "complete" && textOf(at(found, "result.cacheScope")) == "public" && jsonOf(at(found, "result.ttlMs")) == "0"
			assert textOf(at(member(at(found, "result._meta"), "io.modelcontextprotocol/serverInfo"), "name")) == "test-server"
			assert has(at(found, "result.capabilities"), "tools") && has(at(found, "result.capabilities"), "completions")
			let listed = try wire.ask(2, "tools/list")
			let names string[] = []
			for let (_, t) in listOf(at(listed, "result.tools")) {
				names.push(textOf(member(t, "name")))
			}
			assert names.join(",") == "mcpAdd,mcpConsult,mcpCount,divide,mcpGallery,mcpGreet,mcpPoint,mcpWait,stamp"
			assert jsonOf(at(listed, "result.tools.0")) == "\{\"name\":\"mcpAdd\",\"title\":\"Add\",\"description\":\"Adds two numbers.\",\"inputSchema\":\{\"type\":\"object\",\"properties\":\{\"a\":\{\"type\":\"integer\",\"description\":\"the first number\"\},\"b\":\{\"type\":\"integer\",\"description\":\"the second number\"\}\},\"required\":[\"a\"]\},\"annotations\":\{\"readOnlyHint\":true\}\}"
			// The request is no argument; a struct result has an output schema.
			assert jsonOf(at(toolNamed(listed, "mcpGreet"), "inputSchema.required")) == "[\"greeting\"]"
			assert textOf(at(toolNamed(listed, "mcpPoint"), "outputSchema.type")) == "object"
			assert has(at(listed, "result"), "ttlMs")
			try wire.end()
			return none
		}

		@test()
		def TestToolCalls() !none {
			let wire = try mcpWire()
			let sum = try wire.ask(1, "tools/call", map<string, any>{"name": "mcpAdd", "arguments": map<string, any>{"a": 2}})
			assert jsonOf(at(sum, "result.content")) == "[\{\"type\":\"text\",\"text\":\"12\"\}]" && !has(at(sum, "result"), "isError")
			let failed = try wire.ask(2, "tools/call", map<string, any>{"name": "divide", "arguments": map<string, any>{"a": 1, "b": 0}})
			assert boolOf(at(failed, "result.isError")) && textOf(at(failed, "result.content.0.text")) == "division by zero"
			let misfit = try wire.ask(3, "tools/call", map<string, any>{"name": "divide", "arguments": map<string, any>{"a": "x", "b": 1}})
			assert boolOf(at(misfit, "result.isError")) && textOf(at(misfit, "result.content.0.text")) == "Invalid arguments: a is not a number"
			let unknown = try wire.ask(4, "tools/call", map<string, any>{"name": "nothing"})
			assert jsonOf(at(unknown, "error.code")) == "-32602"
			let point = try wire.ask(5, "tools/call", map<string, any>{"name": "mcpPoint", "arguments": map<string, any>{"x": 3}})
			assert jsonOf(at(point, "result.structuredContent")) == "\{\"x\":3,\"y\":3\}" && textOf(at(point, "result.content.0.text")) == "\{\"x\":3,\"y\":3\}"
			let stamped = try wire.ask(6, "tools/call", map<string, any>{"name": "stamp", "arguments": map<string, any>{"body": "7"}})
			assert textOf(at(stamped, "result.content.0.text")) == "#7"
			try wire.end()
			return none
		}

		@test()
		def TestVersions() !none {
			let wire = try mcpWire()
			try wire.send(map<string, any>{"id": 1, "method": "tools/list", "params": map<string, any>{"_meta": map<string, any>{"io.modelcontextprotocol/protocolVersion": "2030-01-01", "io.modelcontextprotocol/clientCapabilities": new map<string, any>()}}})
			let refused = try wire.next()
			assert jsonOf(at(refused, "error.code")) == "-32022" && textOf(at(refused, "error.data.requested")) == "2030-01-01" && textOf(at(refused, "error.data.supported.0")) == "2026-07-28"
			// Neither a version nor a handshake.
			let bare = try wire.call(2, "tools/list")
			assert jsonOf(at(bare, "error.code")) == "-32600"
			// A method of the handshake revisions is unknown to 2026-07-28.
			let ping = try wire.ask(3, "ping")
			assert jsonOf(at(ping, "error.code")) == "-32601"
			try wire.end()
			// A server narrowed to 2026-07-28 names it when asked to initialize.
			let narrow = try mcpWire()
			narrow.server.revisions = ["2026-07-28"]
			let old = try narrow.initialize("2025-06-18")
			assert jsonOf(at(old, "error.code")) == "-32602" && textOf(at(old, "error.data.supported.0")) == "2026-07-28"
			try narrow.end()
			return none
		}

		@test()
		def TestHandshakeRevisions() !none {
			let wire = try mcpWire()
			let opened = try wire.initialize("2025-06-18")
			assert textOf(at(opened, "result.protocolVersion")) == "2025-06-18" && textOf(at(opened, "result.serverInfo.name")) == "test-server"
			assert boolOf(at(opened, "result.capabilities.resources.subscribe")) && boolOf(at(opened, "result.capabilities.tools.listChanged"))
			assert jsonOf(at(try wire.call(1, "ping"), "result")) == "\{\}"
			let listed = try wire.call(2, "tools/list")
			assert !has(at(listed, "result"), "resultType") && !has(at(listed, "result"), "ttlMs")
			assert textOf(at(listed, "result.tools.0.title")) == "Add"
			let point = try wire.call(3, "tools/call", map<string, any>{"name": "mcpPoint", "arguments": map<string, any>{"x": 1}})
			assert has(at(point, "result"), "structuredContent")
			try wire.end()
			// 2024-11-05 has no titles, tool annotations, output schemas or structured content.
			let oldest = try mcpWire()
			try oldest.initialize("2024-11-05")
			let plain = try oldest.call(2, "tools/list")
			assert jsonOf(at(plain, "result.tools.0")).contains("\"title\"") == false && !has(at(plain, "result.tools.0"), "annotations") && !has(toolNamed(plain, "mcpPoint"), "outputSchema")
			let flat = try oldest.call(3, "tools/call", map<string, any>{"name": "mcpPoint", "arguments": map<string, any>{"x": 1}})
			assert !has(at(flat, "result"), "structuredContent") && textOf(at(flat, "result.content.0.text")) == "\{\"x\":1,\"y\":1\}"
			try oldest.end()
			// A revision the server does not know is answered with its newest handshake revision.
			let future = try mcpWire()
			let offered = try future.initialize("2025-12-31")
			assert textOf(at(offered, "result.protocolVersion")) == "2025-11-25"
			try future.end()
			return none
		}

		@test()
		def TestInputRequired() !none {
			let wire = try mcpWire()
			let forms = map<string, any>{"elicitation": map<string, any>{"form": new map<string, any>()}}
			let call = map<string, any>{"name": "mcpGreet", "arguments": map<string, any>{"greeting": "Hello"}}
			let wanted = try wire.ask(1, "tools/call", call.clone(), forms)
			assert textOf(at(wanted, "result.resultType")) == "input_required"
			let asked = at(wanted, "result.inputRequests.elicitation-create-0")
			assert textOf(member(asked, "method")) == "elicitation/create" && textOf(at(asked, "params.message")) == "Who?" && textOf(at(asked, "params.mode")) == "form"
			let again = call.clone()
			again.set("inputResponses", map<string, any>{"elicitation-create-0": map<string, any>{"action": "accept", "content": map<string, any>{"name": "Ada"}}})
			let done = try wire.ask(2, "tools/call", again, forms)
			assert textOf(at(done, "result.resultType")) == "complete" && textOf(at(done, "result.content.0.text")) == "Hello, Ada"
			// A client that shows no forms cannot be asked.
			let refused = try wire.ask(3, "tools/call", call.clone())
			assert jsonOf(at(refused, "error.code")) == "-32021" && has(at(refused, "error.data.requiredCapabilities"), "elicitation")
			try wire.end()
			return none
		}

		@test()
		def TestServerRequestsWithHandshake() !none {
			let wire = try mcpWire()
			try wire.initialize("2025-06-18", map<string, any>{"elicitation": new map<string, any>()})
			try wire.send(map<string, any>{"id": 5, "method": "tools/call", "params": map<string, any>{"name": "mcpGreet", "arguments": map<string, any>{"greeting": "Hi"}}})
			// The server asks on the same stream and waits for the answer.
			let asked = try wire.next()
			assert textOf(member(asked, "method")) == "elicitation/create" && !has(member(asked, "params"), "mode")
			try wire.send(map<string, any>{"id": member(asked, "id"), "result": map<string, any>{"action": "accept", "content": map<string, any>{"name": "Bo"}}})
			let done = try wire.next()
			assert textOf(at(done, "result.content.0.text")) == "Hi, Bo"
			try wire.end()
			return none
		}

		@test()
		def TestProgressAndLogs() !none {
			let wire = try mcpWire()
			let carried = map<string, any>{"progressToken": "p1", "io.modelcontextprotocol/logLevel": "info"}
			try wire.ask(1, "tools/call", map<string, any>{"name": "mcpCount", "arguments": map<string, any>{"steps": 2}}, new map<string, any>(), carried)
			// ask returned the first message: the first progress notification.
			let second = try wire.next()
			assert textOf(member(second, "method")) == "notifications/progress" && jsonOf(at(second, "params")) == "\{\"progressToken\":\"p1\",\"progress\":2,\"total\":2,\"message\":\"step 2\"\}"
			let logged = try wire.next()
			assert textOf(member(logged, "method")) == "notifications/message" && jsonOf(member(logged, "params")) == "\{\"level\":\"warning\",\"data\":\"counted\",\"logger\":\"counter\"\}"
			let done = try wire.next()
			assert textOf(at(done, "result.content.0.text")) == "done"
			// Without a token and a level the client gets the result only.
			let quiet = try wire.ask(2, "tools/call", map<string, any>{"name": "mcpCount", "arguments": map<string, any>{"steps": 2}})
			assert textOf(at(quiet, "result.content.0.text")) == "done"
			let bad = try wire.ask(3, "tools/list", new map<string, any>(), new map<string, any>(), map<string, any>{"io.modelcontextprotocol/logLevel": "loud"})
			assert jsonOf(at(bad, "error.code")) == "-32602"
			try wire.end()
			return none
		}

		@test()
		def TestResources() !none {
			let wire = try mcpWire()
			let listed = try wire.ask(1, "resources/list")
			assert jsonOf(at(listed, "result.resources")) == "[\{\"uri\":\"config://app\",\"name\":\"mcpConfig\",\"description\":\"The application's settings.\",\"mimeType\":\"application/json\"\}]"
			let families = try wire.ask(2, "resources/templates/list")
			assert jsonOf(at(families, "result.resourceTemplates")) == "[\{\"uriTemplate\":\"notes://\{id\}\",\"name\":\"note\",\"description\":\"A note by its number.\"\}]"
			let config = try wire.ask(3, "resources/read", map<string, any>{"uri": "config://app"})
			assert jsonOf(at(config, "result.contents")) == "[\{\"uri\":\"config://app\",\"mimeType\":\"application/json\",\"text\":\"\{\\\"debug\\\": true\}\"\}]" && has(at(config, "result"), "ttlMs")
			let note = try wire.ask(4, "resources/read", map<string, any>{"uri": "notes://7"})
			assert jsonOf(at(note, "result.contents")) == "[\{\"uri\":\"notes://7\",\"text\":\"note 7\"\}]"
			let missing = try wire.ask(5, "resources/read", map<string, any>{"uri": "other://x"})
			assert jsonOf(at(missing, "error.code")) == "-32602" && textOf(at(missing, "error.data.uri")) == "other://x"
			let broken = try wire.ask(6, "resources/read", map<string, any>{"uri": "notes://12"})
			assert jsonOf(at(broken, "error.code")) == "-32603" && textOf(at(broken, "error.message")) == "no note 12"
			try wire.end()
			let old = try mcpWire()
			try old.initialize("2025-11-25")
			let gone = try old.call(2, "resources/read", map<string, any>{"uri": "other://x"})
			assert jsonOf(at(gone, "error.code")) == "-32002"
			try old.end()
			return none
		}

		@test()
		def TestPromptsAndCompletion() !none {
			let wire = try mcpWire()
			let listed = try wire.ask(1, "prompts/list")
			assert jsonOf(at(listed, "result.prompts")) == "[\{\"name\":\"review\",\"description\":\"Asks for a review of some code.\",\"arguments\":[\{\"name\":\"code\",\"description\":\"the code to review\",\"required\":true\},\{\"name\":\"focus\",\"description\":\"what to look for\"\}]\}]"
			let made = try wire.ask(2, "prompts/get", map<string, any>{"name": "review", "arguments": map<string, any>{"code": "x = 1", "focus": "Speed"}})
			assert jsonOf(at(made, "result.messages")) == "[\{\"role\":\"user\",\"content\":\{\"type\":\"text\",\"text\":\"Review for Speed: x = 1\"\}\}]" && textOf(at(made, "result.description")) == "Asks for a review of some code."
			let short = try wire.ask(3, "prompts/get", map<string, any>{"name": "review"})
			assert jsonOf(at(short, "error.code")) == "-32602" && textOf(at(short, "error.message")) == "Missing required argument: code"
			let unknown = try wire.ask(4, "prompts/get", map<string, any>{"name": "nothing"})
			assert jsonOf(at(unknown, "error.code")) == "-32602"
			let offered = try wire.ask(5, "completion/complete", map<string, any>{"ref": map<string, any>{"type": "ref/prompt", "name": "review"}, "argument": map<string, any>{"name": "focus", "value": "s"}})
			assert jsonOf(at(offered, "result.completion")) == "\{\"values\":[\"Style\",\"Speed\"]\}"
			let nothing = try wire.ask(6, "completion/complete", map<string, any>{"ref": map<string, any>{"type": "ref/prompt", "name": "review"}, "argument": map<string, any>{"name": "code", "value": ""}})
			assert jsonOf(at(nothing, "result.completion.values")) == "[]"
			try wire.end()
			return none
		}

		@test()
		def TestPagination() !none {
			let wire = try mcpWire()
			wire.server.pageSize = 3
			let seen string[] = []
			let cursor = ""
			let pages = 0
			for {
				let params = new map<string, any>()
				params.set("cursor", cursor) when cursor != ""
				let page = try wire.ask(pages + 1, "tools/list", params)
				for let (_, t) in listOf(at(page, "result.tools")) {
					seen.push(textOf(member(t, "name")))
				}
				pages++
				cursor = textOf(at(page, "result.nextCursor"))
				break when cursor == ""
			}
			assert pages == 3 && seen.len() == 9 && seen[8] == "stamp"
			let bad = try wire.ask(9, "tools/list", map<string, any>{"cursor": "elsewhere"})
			assert jsonOf(at(bad, "error.code")) == "-32602"
			try wire.end()
			return none
		}

		@test()
		def TestSubscriptions() !none {
			let wire = try mcpWire()
			let ack = try wire.ask(7, "subscriptions/listen", map<string, any>{"notifications": map<string, any>{"toolsListChanged": true, "resourceSubscriptions": ["config://app"]}})
			assert textOf(member(ack, "method")) == "notifications/subscriptions/acknowledged" && jsonOf(member(ack, "params")) == "\{\"notifications\":\{\"toolsListChanged\":true,\"resourceSubscriptions\":[\"config://app\"]\},\"_meta\":\{\"io.modelcontextprotocol/subscriptionId\":7\}\}"
			wire.server.tool(Tool{name: "late"}, def (request Request, arguments map<string, any>) !ToolResult {
				return ToolResult{content: [text("late")]}
			})
			let changed = try wire.next()
			assert textOf(member(changed, "method")) == "notifications/tools/list_changed" && jsonOf(member(at(changed, "params._meta"), "io.modelcontextprotocol/subscriptionId")) == "7"
			// Prompts were not asked for; the resource was.
			wire.server.removePrompt("review")
			wire.server.updated("other://x")
			wire.server.updated("config://app")
			let updated = try wire.next()
			assert textOf(member(updated, "method")) == "notifications/resources/updated" && textOf(at(updated, "params.uri")) == "config://app"
			// The client cancels: the request is never answered.
			try wire.send(map<string, any>{"method": "notifications/cancelled", "params": map<string, any>{"requestId": 7, "_meta": map<string, any>{"io.modelcontextprotocol/protocolVersion": "2026-07-28"}}})
			let late = try wire.ask(8, "tools/call", map<string, any>{"name": "late"})
			assert jsonOf(member(late, "id")) == "8" && textOf(at(late, "result.content.0.text")) == "late"
			// The server ends a stream: it says so and answers the request.
			let again = try wire.ask(9, "subscriptions/listen", map<string, any>{"notifications": map<string, any>{"promptsListChanged": true}})
			assert jsonOf(at(again, "params.notifications")) == "\{\"promptsListChanged\":true\}"
			wire.server.close()
			let ending = try wire.next()
			assert textOf(member(ending, "method")) == "notifications/cancelled" && jsonOf(at(ending, "params.requestId")) == "9"
			let closed = try wire.next()
			assert jsonOf(member(closed, "id")) == "9" && textOf(at(closed, "result.resultType")) == "complete" && jsonOf(member(at(closed, "result._meta"), "io.modelcontextprotocol/subscriptionId")) == "9"
			try wire.end()
			return none
		}

		@test()
		def TestHandshakeNotifications() !none {
			let wire = try mcpWire()
			try wire.initialize("2025-03-26")
			assert jsonOf(at(try wire.call(1, "resources/subscribe", map<string, any>{"uri": "config://app"}), "result")) == "\{\}"
			wire.server.updated("config://app")
			let updated = try wire.next()
			assert textOf(member(updated, "method")) == "notifications/resources/updated" && jsonOf(member(updated, "params")) == "\{\"uri\":\"config://app\"\}"
			wire.server.removeTool("stamp")
			let changed = try wire.next()
			assert textOf(member(changed, "method")) == "notifications/tools/list_changed"
			try wire.call(2, "resources/unsubscribe", map<string, any>{"uri": "config://app"})
			wire.server.updated("config://app")
			assert jsonOf(at(try wire.call(3, "logging/setLevel", map<string, any>{"level": "error"}), "result")) == "\{\}"
			// At level error the warning of mcpCount stays home: the result comes first.
			let done = try wire.call(4, "tools/call", map<string, any>{"name": "mcpCount", "arguments": map<string, any>{"steps": 1}})
			assert jsonOf(member(done, "id")) == "4"
			try wire.end()
			return none
		}

		@test()
		def TestCancellation() !none {
			let wire = try mcpWire()
			try wire.send(map<string, any>{"id": 1, "method": "tools/call", "params": map<string, any>{"name": "mcpWait", "_meta": map<string, any>{"io.modelcontextprotocol/protocolVersion": "2026-07-28", "io.modelcontextprotocol/clientCapabilities": new map<string, any>()}}})
			try wire.send(map<string, any>{"method": "notifications/cancelled", "params": map<string, any>{"requestId": 1, "reason": "enough"}})
			// The cancelled call is not answered; the next one is.
			let next = try wire.ask(2, "tools/call", map<string, any>{"name": "mcpAdd", "arguments": map<string, any>{"a": 1, "b": 1}})
			assert jsonOf(member(next, "id")) == "2"
			try wire.end()
			return none
		}
	}
}
