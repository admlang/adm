// What a server keeps while it answers: the connection a request came in on,
// the state of one request, and the listeners of change notifications.
internal partial module std.proto.mcp.session {
	use (
		std.errors
		std.proto.auth.oauth2
		std.proto.mcp::*
	)

	// Where a server sends what belongs to one request or one connection.
	interface Link {
		// Sends a notification. Fails when the other side is gone.
		def notify(method string, params map<string, any>) !none

		// Calls a method of the client and returns its result (revisions
		// before 2026-07-28). Fails with the client's error, or when the
		// transport cannot carry requests to the client.
		def call(method string, params any) !any

		// Whether the other side can still be reached, as far as is known
		// without writing to it.
		def alive() bool

		// Sends a keep-alive where the transport has one, which also finds a
		// client that left.
		def beat()
	}

	// The failure a handler ends with when it needs input from the client
	// before it can go on (revision 2026-07-28): the server answers with an
	// `input_required` result and the client sends the request again.
	struct InputRequired {
		message  string
		code     string
		cause    ?error
		stack    errors.StackTrace
		// The requests to the client, by key.
		requests map<string, any>
	}

	// What a protected endpoint knows of who asks: the access token it
	// accepted, and the scopes a handler then found missing.
	type Admission {
		token  oauth2.AccessToken
		needed string[]

		def new(token oauth2.AccessToken) {
			self.token = token
		}
	}

	// The state of one request while its handler runs.
	type Exchange {
		method        string
		id            any
		revision      string
		// Revision 2026-07-28 or later: no requests to the client, input
		// comes with a retry.
		modern        bool
		client        Implementation
		capabilities  ClientCapabilities
		extra         map<string, any>
		// The state the client sent back, verified; "" when there is none.
		state         string
		// The state to hand the client with an `input_required` result.
		nextState     string
		link          Link
		// The client's progress token; none when it wants no progress.
		progressToken any
		// The least severe level the client wants; none for no log messages.
		logLevel      ?LogLevel
		// Records the id of a URL elicitation with the connection it went
		// to, for the notification that it is complete (2025-11-25).
		urlAsked      ?def (string)
		// The access token of the request; none without authorization.
		admission     ?Admission
		// The task the request runs as; none for one answered in place. The
		// server's registry holds the task, which holds this request.
		weak task     ?TaskRecord
		// The client's answers to earlier input requests, by key.
		responses     map<string, any>
		// How many input requests the handler has made in this run.
		asked         int                = 0
		lastProgress  float              = -1.0
		halted        bool               = false
		// Receives a value when the request is cancelled.
		wake          channel<bool>

		def new(link Link) {
			self.link = link
			wake = new channel<bool>(1)
		}

		// Marks the request cancelled.
		atomic def stop() {
			halted = true
			wake.offer(true)
		}

		atomic def stopped() bool {
			return halted
		}
	}

	// One connection of a client: a stream, or an HTTP session of the
	// revisions that have sessions.
	type Conn {
		link         Link
		// Set by `initialize`: the connection speaks a revision with a
		// handshake.
		legacy       bool                  = false
		initialized  bool                  = false
		revision     string                = ""
		client       Implementation
		capabilities ClientCapabilities
		// The least severe level the client asked for with `logging/setLevel`.
		logLevel     LogLevel              = LogLevel.Debug
		uris         string[]
		active       map<string, Exchange>
		// Names the connection as the owner of its tasks; "" until one is
		// made.
		tag          string                = ""

		def new(link Link) {
			self.link = link
		}

		atomic def track(key string, exchange Exchange) {
			active.set(key, exchange) when key != ""
		}

		atomic def release(key string) {
			active.delete(key) when active.hasKey(key)
		}

		atomic def find(key string) ?Exchange {
			return active.get(key)
		}

		// Marks every request still running cancelled: the connection ended.
		atomic def stopAll() {
			for let (_, exchange) in active {
				exchange.stop()
			}
		}

		atomic def subscribe(uri string) {
			uris.push(uri) unless uri in uris
		}

		atomic def unsubscribe(uri string) {
			let at = uris.indexOf(uri)
			uris.remove(at) when at >= 0
		}

		atomic def watches(uri string) bool {
			return uri in uris
		}
	}

	// What a transport attaches to each message it hands the dispatcher.
	struct Envelope {
		conn      Conn
		// Where notifications about this request go.
		link      Link
		// The transport delivers a response to every request by itself
		// closing: a cancelled request needs no silence (HTTP).
		http      bool
		// Who asks, on a protected endpoint.
		admission ?Admission
	}

	// One `subscriptions/listen` stream.
	type Listener {
		id        any
		link      Link
		tools     bool
		prompts   bool
		resources bool
		uris      string[]
		// The tasks whose changes the stream carries.
		taskIds   string[]
		// Receives a value when the server ends the stream.
		done      channel<bool>

		def new(id any, link Link) {
			self.id = id
			self.link = link
			done = new channel<bool>(1)
		}
	}

	// The key a request id is filed under: "n5" for 5, "s…" for text; "" for
	// anything else.
	def idKey(id any) string {
		match id {
			case int:
				return "n{id}"
			case string:
				return "s{id}"
			default:
				return ""
		}
	}
}
