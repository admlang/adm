// MCP over a byte stream: one JSON message per line, as the stdio transport
// defines it and any pipe, socket or pair of streams can carry it.
internal partial module std.proto.mcp.session {
	use (
		std.io
		std.proto.jsonrpc
	)

	// The other side of a stream.
	type StreamLink {
		peer jsonrpc.Peer

		def new(peer jsonrpc.Peer) {
			self.peer = peer
		}

		// Implements Link.
		def notify(method string, params map<string, any>) !none {
			return try peer.notify(method, params)
		}

		// Implements Link.
		def call(method string, params any) !any {
			return try peer.call(method, params)
		}

		// Implements Link.
		def alive() bool {
			return peer.isOpen()
		}

		// Implements Link.
		def beat() {}
	}

	// Serves one client over a stream until it ends.
	def serveStream(core Core, reader io.Reader, writer io.Writer) {
		let peer = new jsonrpc.Peer(reader, writer, jsonrpc.Framing.Newline)
		peer.methods = core.dispatcher
		peer.timeout = core.timeout
		let link = new StreamLink(peer)
		let conn = new Conn(link)
		peer.context = Envelope{conn: conn, link: link}
		core.attach(conn)
		peer.start()
		peer.wait()
		// The input ended: what is being answered is answered first, and
		// what does not end by itself is told to stop.
		if !peer.drain(core.drain) {
			conn.stopAll()
			peer.drain(core.drain)
		}
		core.detach(conn)
	}
}
