partial module std.proto.mcp {
	use (
		std.testing
		std.time
		std.proto.mcp.wire::*
	)

	// Tools that take their time. Methods of a type are served only by a
	// server the value was added to, so the other suites' tool lists stay
	// as they are.
	internal type McpKitchen {
		def new() {}

		// Brews coffee, which takes a while.
		@tool(task = TaskSupport.Optional)
		def mcpBrew(request Request, cups int) string {
			request.progress(1.0, 2.0, "heating")
			return "brewed {cups}"
		}

		// Greets whoever the user says, once the user got round to saying.
		@tool(task = TaskSupport.Required)
		def mcpAskLater(request Request) !string {
			let schema = map<string, any>{"type": "object", "properties": map<string, any>{"name": map<string, any>{"type": "string"}}, "required": ["name"]}
			let answer = try request.elicit("Who?", schema)
			return "nobody" unless answer.action == ElicitAction.Accept
			return "later, {textOf(member(answer.content, "name"))}"
		}

		// Works until it is cancelled.
		@tool(task = TaskSupport.Optional)
		def mcpStall(request Request) string {
			for !request.cancelled() {
				time.sleep(1ms)
			}
			return "stopped"
		}
	}

	// The id of the task a tool was started as; "" when it was answered in
	// place.
	internal def mcpTaskId(run ToolRun) string {
		let task = run.task
		return task is none ?? ("", task.id)
	}

	// What a client that follows tasks declares in revision 2026-07-28.
	internal def mcpTaskAble(forms bool = false) map<string, any> {
		let out = map<string, any>{"extensions": map<string, any>{"io.modelcontextprotocol/tasks": new map<string, any>()}}
		out.set("elicitation", map<string, any>{"form": new map<string, any>()}) when forms
		return out
	}

	// Looks at a task until it is no longer working (2026-07-28).
	internal def mcpSettled(wire McpWire, id string) !any {
		for let i = 0; i < 400; i++ {
			let seen = try wire.ask(5000 + i, "tasks/get", map<string, any>{"taskId": id}, mcpTaskAble())
			return seen unless textOf(at(seen, "result.status")) == "working"
			time.sleep(5ms)
		}
		fail "task {id} did not settle"
	}

	// The response to request id, past what else the server sends first;
	// the methods of those messages are added to seen.
	internal def mcpReply(wire McpWire, id int, seen string[]) !any {
		for {
			let message = try wire.next()
			return message when jsonOf(member(message, "id")) == "{id}" && !has(message, "method")
			seen.push(textOf(member(message, "method")))
		}
		fail "unreachable"
	}

	check "MCP tasks" {
		@test()
		def TestTasksExtension() !none {
			let wire = try mcpWire()
			try wire.server.add(new McpKitchen())
			let found = try wire.ask(1, "server/discover")
			assert has(at(found, "result.capabilities.extensions"), "io.modelcontextprotocol/tasks")
			// The server decides: a client that cannot follow a task gets the result.
			let brew = map<string, any>{"name": "mcpBrew", "arguments": map<string, any>{"cups": 2}}
			let plain = try wire.ask(2, "tools/call", brew.clone())
			assert textOf(at(plain, "result.resultType")) == "complete" && textOf(at(plain, "result.content.0.text")) == "brewed 2"
			let made = try wire.ask(3, "tools/call", brew.clone(), mcpTaskAble())
			assert textOf(at(made, "result.resultType")) == "task" && textOf(at(made, "result.status")) == "working"
			assert jsonOf(at(made, "result.ttlMs")) == "3600000" && has(member(made, "result"), "createdAt")
			let id = textOf(at(made, "result.taskId"))
			assert id.len() == 32
			let done = try mcpSettled(wire, id)
			assert textOf(at(done, "result.status")) == "completed" && textOf(at(done, "result.resultType")) == "complete"
			assert textOf(at(done, "result.result.content.0.text")) == "brewed 2" && textOf(at(done, "result.statusMessage")) == "heating"
			// Who did not declare the extension has no task methods; nobody has the old ones.
			let undeclared = try wire.ask(4, "tasks/get", map<string, any>{"taskId": id})
			assert jsonOf(at(undeclared, "error.code")) == "-32021"
			let unknown = try wire.ask(5, "tasks/get", map<string, any>{"taskId": "nothing"}, mcpTaskAble())
			assert jsonOf(at(unknown, "error.code")) == "-32602"
			let removed = try wire.ask(6, "tasks/result", map<string, any>{"taskId": id}, mcpTaskAble())
			assert jsonOf(at(removed, "error.code")) == "-32601"
			// A tool that runs as a task only refuses a client that cannot follow one.
			let later = map<string, any>{"name": "mcpAskLater", "arguments": new map<string, any>()}
			let refused = try wire.ask(7, "tools/call", later.clone(), map<string, any>{"elicitation": map<string, any>{"form": new map<string, any>()}})
			assert jsonOf(at(refused, "error.code")) == "-32021" && has(at(refused, "error.data.requiredCapabilities.extensions"), "io.modelcontextprotocol/tasks")
			// A task asks through tasks/get and is answered through tasks/update.
			let asking = try wire.ask(8, "tools/call", later.clone(), mcpTaskAble(true))
			let askingId = textOf(at(asking, "result.taskId"))
			let waiting = try mcpSettled(wire, askingId)
			assert textOf(at(waiting, "result.status")) == "input_required"
			assert textOf(at(waiting, "result.inputRequests.elicitation-create-0.method")) == "elicitation/create"
			let stale = try wire.ask(9, "tasks/update", map<string, any>{"taskId": askingId, "inputResponses": map<string, any>{"other": new map<string, any>()}}, mcpTaskAble())
			assert has(stale, "result") && textOf(at(try mcpSettled(wire, askingId), "result.status")) == "input_required"
			let answers = map<string, any>{"elicitation-create-0": map<string, any>{"action": "accept", "content": map<string, any>{"name": "Ada"}}}
			let taken = try wire.ask(10, "tasks/update", map<string, any>{"taskId": askingId, "inputResponses": answers}, mcpTaskAble())
			assert textOf(at(taken, "result.resultType")) == "complete"
			let greeted = try mcpSettled(wire, askingId)
			assert textOf(at(greeted, "result.status")) == "completed" && textOf(at(greeted, "result.result.content.0.text")) == "later, Ada"
			// Cancelling is acknowledged, and the task stays cancelled.
			let stalled = try wire.ask(11, "tools/call", map<string, any>{"name": "mcpStall", "arguments": new map<string, any>()}, mcpTaskAble())
			let stalledId = textOf(at(stalled, "result.taskId"))
			// A listen stream that names the task is told of its end, in full.
			let undeclaredListen = try wire.ask(20, "subscriptions/listen", map<string, any>{"notifications": map<string, any>{"taskIds": [stalledId]}})
			assert jsonOf(at(undeclaredListen, "error.code")) == "-32021"
			let listening = try wire.ask(21, "subscriptions/listen", map<string, any>{"notifications": map<string, any>{"taskIds": [stalledId, "nothing"]}}, mcpTaskAble())
			assert textOf(member(listening, "method")) == "notifications/subscriptions/acknowledged" && listOf(at(listening, "params.notifications.taskIds")).len() == 1
			let change = try wire.ask(12, "tasks/cancel", map<string, any>{"taskId": stalledId}, mcpTaskAble())
			assert textOf(member(change, "method")) == "notifications/tasks" && textOf(at(change, "params.status")) == "cancelled" && textOf(at(change, "params.taskId")) == stalledId
			let stopped = try wire.next()
			assert has(stopped, "result") && !has(member(stopped, "result"), "status")
			assert textOf(at(try mcpSettled(wire, stalledId), "result.status")) == "cancelled"
			let twice = try wire.ask(13, "tasks/cancel", map<string, any>{"taskId": stalledId}, mcpTaskAble())
			assert has(twice, "result")
			try wire.end()
			return none
		}

		@test()
		def TestTasksOfRevision2025() !none {
			let wire = try mcpWire()
			try wire.server.add(new McpKitchen())
			let opened = try wire.initialize("2025-11-25", map<string, any>{"elicitation": new map<string, any>()})
			assert has(at(opened, "result.capabilities.tasks.requests.tools"), "call") && has(at(opened, "result.capabilities.tasks"), "list")
			let listed = try wire.call(1, "tools/list")
			assert textOf(at(toolNamed(listed, "mcpBrew"), "execution.taskSupport")) == "optional" && !has(toolNamed(listed, "mcpAdd"), "execution")
			// The client asks for a task; without `task` the call is answered in place.
			let brew = map<string, any>{"name": "mcpBrew", "arguments": map<string, any>{"cups": 3}}
			let plain = try wire.call(2, "tools/call", brew.clone())
			assert textOf(at(plain, "result.content.0.text")) == "brewed 3"
			let seen string[] = []
			let asked = brew.clone()
			asked.set("task", map<string, any>{"ttl": 60000})
			try wire.send(map<string, any>{"id": 3, "method": "tools/call", "params": asked})
			let made = try mcpReply(wire, 3, seen)
			let id = textOf(at(made, "result.task.taskId"))
			assert textOf(at(made, "result.task.status")) == "working" && jsonOf(at(made, "result.task.ttl")) == "60000" && id.len() == 32
			// tasks/result waits for the end and answers as the call would have.
			try wire.send(map<string, any>{"id": 4, "method": "tasks/result", "params": map<string, any>{"taskId": id}})
			let result = try mcpReply(wire, 4, seen)
			assert textOf(at(result, "result.content.0.text")) == "brewed 3"
			assert textOf(at(result, "result._meta.io.modelcontextprotocol/related-task.taskId")) == id || textOf(member(member(at(result, "result._meta"), "io.modelcontextprotocol/related-task"), "taskId")) == id
			try wire.send(map<string, any>{"id": 5, "method": "tasks/get", "params": map<string, any>{"taskId": id}})
			let state = try mcpReply(wire, 5, seen)
			assert textOf(at(state, "result.status")) == "completed" && "notifications/tasks/status" in seen
			try wire.send(map<string, any>{"id": 6, "method": "tasks/list"})
			let tasks = try mcpReply(wire, 6, seen)
			assert listOf(at(tasks, "result.tasks")).len() == 1
			// An ended task cannot be cancelled; tools say whether they run as tasks.
			try wire.send(map<string, any>{"id": 7, "method": "tasks/cancel", "params": map<string, any>{"taskId": id}})
			assert jsonOf(at(try mcpReply(wire, 7, seen), "error.code")) == "-32602"
			let later = map<string, any>{"name": "mcpAskLater", "arguments": new map<string, any>()}
			try wire.send(map<string, any>{"id": 8, "method": "tools/call", "params": later.clone()})
			assert jsonOf(at(try mcpReply(wire, 8, seen), "error.code")) == "-32601"
			try wire.send(map<string, any>{"id": 9, "method": "tools/call", "params": map<string, any>{"name": "mcpAdd", "arguments": map<string, any>{"a": 1}, "task": new map<string, any>()}})
			assert jsonOf(at(try mcpReply(wire, 9, seen), "error.code")) == "-32601"
			// A task's question arrives as a request tied to the task.
			later.set("task", new map<string, any>())
			try wire.send(map<string, any>{"id": 10, "method": "tools/call", "params": later})
			let asking = try mcpReply(wire, 10, seen)
			let askingId = textOf(at(asking, "result.task.taskId"))
			let question any = none
			for question is none {
				let message = try wire.next()
				question = message when textOf(member(message, "method")) == "elicitation/create"
			}
			assert textOf(member(member(at(question, "params._meta"), "io.modelcontextprotocol/related-task"), "taskId")) == askingId
			try wire.send(map<string, any>{"id": member(question, "id"), "result": map<string, any>{"action": "accept", "content": map<string, any>{"name": "Bo"}}})
			try wire.send(map<string, any>{"id": 11, "method": "tasks/result", "params": map<string, any>{"taskId": askingId}})
			assert textOf(at(try mcpReply(wire, 11, seen), "result.content.0.text")) == "later, Bo"
			// Cancelling answers with the cancelled task; its result is an error.
			try wire.send(map<string, any>{"id": 12, "method": "tools/call", "params": map<string, any>{"name": "mcpStall", "arguments": new map<string, any>(), "task": new map<string, any>()}})
			let stalledId = textOf(at(try mcpReply(wire, 12, seen), "result.task.taskId"))
			try wire.send(map<string, any>{"id": 13, "method": "tasks/cancel", "params": map<string, any>{"taskId": stalledId}})
			assert textOf(at(try mcpReply(wire, 13, seen), "result.status")) == "cancelled"
			try wire.send(map<string, any>{"id": 14, "method": "tasks/result", "params": map<string, any>{"taskId": stalledId}})
			assert has(try mcpReply(wire, 14, seen), "error")
			try wire.end()
			// The revisions before have no tasks: every tool is answered in place.
			let older = try mcpWire()
			try older.server.add(new McpKitchen())
			let before = try older.initialize("2025-06-18")
			assert !has(at(before, "result.capabilities"), "tasks")
			assert !has(toolNamed(try older.call(1, "tools/list"), "mcpBrew"), "execution")
			let inPlace = try older.call(2, "tools/call", map<string, any>{"name": "mcpBrew", "arguments": map<string, any>{"cups": 1}})
			assert textOf(at(inPlace, "result.content.0.text")) == "brewed 1"
			try older.end()
			return none
		}

		@test()
		def TestClientFollowsTasks() !none {
			for let (_, revision) in ["2026-07-28", "2025-11-25"] {
				let pair = new McpPair()
				pair.client.revisions = [revision]
				pair.server.taskPollInterval = 5ms
				try pair.server.add(new McpKitchen())
				pair.client.elicitation = def (request ElicitationRequest) !Elicitation {
					return Elicitation{action: ElicitAction.Accept, content: map<string, any>{"name": "Ada"}}
				}
				let events = new channel<string>(64)
				pair.client.taskChanged = def (task Task) {
					events.offer(task.status.value)
				}
				try pair.open()
				assert pair.client.capabilities.tasks
				// call returns the tool's result, task or not.
				assert firstText(try pair.client.call("mcpBrew", map<string, any>{"cups": 2})) == "brewed 2"
				assert firstText(try pair.client.call("mcpAskLater")) == "later, Ada"
				// start hands out the task; it can be looked at, followed, cancelled.
				let brewing = try pair.client.start("mcpBrew", map<string, any>{"cups": 4})
				let brewed = mcpTaskId(brewing)
				assert brewed != "" && brewing.result is none
				assert firstText(try pair.client.wait(brewed)) == "brewed 4"
				assert (try pair.client.task(brewed)).status == TaskStatus.Completed
				let stalling = try pair.client.start("mcpStall")
				let stalled = mcpTaskId(stalling)
				let seen = try pair.client.task(stalled)
				assert stalled != "" && seen.status == TaskStatus.Working && !(seen.lifetime is none)
				try pair.client.follow(stalled)
				try pair.client.cancelTask(stalled)
				let kind = McpErrorKind.Remote
				pair.client.wait(stalled) onerror (err error) {
					kind = err is McpError ?? (err.kind, McpErrorKind.Remote)
					recover ToolResult{}
				}
				if revision == "2026-07-28" {
					assert kind == McpErrorKind.Cancelled
					assert pair.client.tasks() is error
				} else {
					assert kind != McpErrorKind.Cancelled
					assert (try pair.client.tasks()).len() >= 3
				}
				let told = ""
				for told != "cancelled" {
					told = mcpAwait(events)
					fail "no cancelled notification in {revision}" when told == ""
				}
				// A tool that is answered in place still is.
				let sum = try pair.client.start("mcpAdd", map<string, any>{"a": 2, "b": 3})
				assert sum.task is none && !(sum.result is none)
				assert pair.client.task("nothing") is error
				try pair.end()
			}
			return none
		}

		@test()
		def TestTasksOverHTTP() !none {
			let site = try mcpSite()
			site.server.taskPollInterval = 5ms
			try site.server.add(new McpKitchen())
			// The task's id is the request's Mcp-Name, for whoever routes by it.
			let (status, _, body) = try site.ask(1, "tasks/get", map<string, any>{"taskId": "abc"})
			assert status == 400 && jsonOf(at(try parsed(body), "error.code")) == "-32020"
			let (named, _, known) = try site.ask(2, "tasks/get", map<string, any>{"taskId": "abc"}, map<string, string>{"Mcp-Name": "abc"})
			assert named == 400 && jsonOf(at(try parsed(known), "error.code")) == "-32021"
			let client = try connect(site.target)
			assert firstText(try client.call("mcpBrew", map<string, any>{"cups": 5})) == "brewed 5"
			let run = try client.start("mcpBrew", map<string, any>{"cups": 6})
			assert firstText(try client.wait(mcpTaskId(run))) == "brewed 6"
			try client.close()
			// A session of 2025-11-25 over HTTP: the task outlives its POST.
			let old = new Client()
			old.revisions = ["2025-11-25"]
			try old.open(site.target)
			let started = try old.start("mcpBrew", map<string, any>{"cups": 7})
			assert firstText(try old.wait(mcpTaskId(started))) == "brewed 7"
			try old.close()
			try site.end()
			return none
		}
	}
}
