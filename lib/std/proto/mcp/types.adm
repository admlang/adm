partial module std.proto.mcp {
	use (
		std.errors
		std.time
	)

	// Why an MCP call or a transport failed.
	enum McpErrorKind {
		// The other side answered with a JSON-RPC error object; `number` and
		// `data` hold its code and data.
		Remote,
		// The server implements none of the protocol revisions asked for;
		// `data` lists the ones it does.
		UnsupportedVersion,
		// The request needs a capability the other side did not declare.
		MissingCapability,
		// No tool, resource, prompt or method of that name.
		NotFound,
		// The parameters do not fit the method.
		InvalidParams,
		// The request was cancelled before it was answered.
		Cancelled,
		// No answer arrived in time.
		Timeout,
		// The connection ended.
		Closed,
		// The transport failed: an HTTP status, a broken stream, a message
		// that is not valid MCP.
		Transport,
		// The server refused the credentials, or asked for some.
		Unauthorized
	}

	// The error MCP calls fail with.
	struct McpError {
		message string
		code    string
		cause   ?error
		stack   errors.StackTrace
		kind    McpErrorKind
		// The JSON-RPC error code, 0 for a local failure.
		number  int
		// The error object's data member; none when absent.
		data    any
	}

	// Who speaks in a prompt or a sampled conversation.
	enum Role {
		User,
		Assistant
	}

	// Severity of a log message sent to the client, as syslog (RFC 5424)
	// names them.
	enum LogLevel {
		Debug,
		Info,
		Notice,
		Warning,
		Error,
		Critical,
		Alert,
		Emergency
	}

	// An icon of a server, a tool, a resource or a prompt (revision
	// 2025-11-25 and later).
	struct Icon {
		// An `https:` or `data:` URI of the image.
		src      string
		mimeType string
		// The sizes the image suits, as `48x48`, or `any` for a vector image.
		sizes    string[]
		// `light` or `dark` when the icon is made for one theme; "" for both.
		theme    string
	}

	// The name and version of a client or a server.
	struct Implementation {
		name        string
		version     string
		// A name to show to people; "" to show `name`.
		title       string
		description string
		websiteUrl  string
		icons       Icon[]
	}

	// Hints for the client about a piece of content or a resource.
	struct Annotations {
		// Who the content is for; empty for both.
		audience     Role[]
		// From 0 (least important) to 1 (required); none when not said.
		priority     ?float
		// When the resource last changed, as an ISO 8601 time; "" when not
		// said.
		lastModified string
	}

	// What a piece of content is.
	enum ContentKind {
		Text,
		Image,
		Audio,
		// The contents of a resource, embedded.
		Resource,
		// A link to a resource the client may read.
		ResourceLink,
		// A model's request to call a tool (sampling only).
		ToolUse,
		// The result of a tool call (sampling only).
		ToolResult
	}

	// One piece of content of a tool result, a prompt message or a sampled
	// message. Make one with `text`, `image`, `audio`, `embedded` or `link`.
	struct Content {
		kind        ContentKind
		// The text of a Text.
		text        string
		// The bytes of an Image or an Audio.
		data        byte[]
		// The media type of an Image or an Audio.
		mimeType    string
		// The contents of a Resource.
		resource    ?ResourceContents
		// The resource a ResourceLink points to.
		link        ?Resource
		// ToolUse: the id of the call; ToolResult: the id of the call it
		// answers.
		id          string
		// ToolUse: the name of the tool.
		name        string
		// ToolUse: the arguments.
		input       map<string, any>
		// ToolResult: what the tool returned.
		content     Content[]
		// ToolResult: the structured result, none when there is none.
		structured  any
		// ToolResult: whether the tool failed.
		isError     bool
		annotations ?Annotations
		// The `_meta` member: what an application attaches beside the protocol's own fields.
		extra       map<string, any>
	}

	// A text content.
	def text(text string) Content {
		return Content{kind: ContentKind.Text, text: text}
	}

	// An image content of the given media type (`image/png`).
	def image(data byte[], mimeType string) Content {
		return Content{kind: ContentKind.Image, data: data, mimeType: mimeType}
	}

	// An audio content of the given media type (`audio/wav`).
	def audio(data byte[], mimeType string) Content {
		return Content{kind: ContentKind.Audio, data: data, mimeType: mimeType}
	}

	// A content that embeds the contents of a resource.
	def embedded(contents ResourceContents) Content {
		return Content{kind: ContentKind.Resource, resource: contents}
	}

	// A content that points to a resource the client may read.
	def link(resource Resource) Content {
		return Content{kind: ContentKind.ResourceLink, link: resource}
	}

	// What a client may be told about a tool's behaviour. Each is a hint: a
	// client must not trust it from a server it does not trust. None leaves
	// the hint out, and the client assumes the default named here.
	struct ToolHints {
		// Does not change its environment (default false).
		readOnly    ?bool
		// May destroy something, when not read-only (default true).
		destructive ?bool
		// Calling it again with the same arguments changes nothing more,
		// when not read-only (default false).
		idempotent  ?bool
		// Reaches things outside the server, such as the web (default true).
		openWorld   ?bool
	}

	// Whether a call of a tool runs as a task: work the server carries on
	// after it answered, which the client looks at until it is done.
	enum TaskSupport {
		// The call is answered when the tool returns.
		Forbidden = "forbidden",
		// As a task for a client that can follow one, else answered when the
		// tool returns.
		Optional = "optional",
		// As a task only: a client that cannot follow one is refused.
		Required = "required",
	}

	// Where a task stands.
	enum TaskStatus {
		Working = "working",
		// The server waits for an answer of the client.
		InputRequired = "input_required",
		// The tool returned; a result marked `isError` counts.
		Completed = "completed",
		// The call ended in a protocol error.
		Failed = "failed",
		Cancelled = "cancelled",
	}

	// A task as its server describes it.
	struct Task {
		id           string
		status       TaskStatus
		// What the server says about the state; "" when it says nothing.
		message      string
		created      ?time.Time
		updated      ?time.Time
		// How long after `created` the server keeps the task; none for no
		// limit.
		lifetime     ?duration
		// How long the server asks to wait between two looks; 0s when it
		// names none.
		pollInterval duration
	}

	// What starting a tool gave: its result when the server answered at
	// once, else the task it runs as.
	struct ToolRun {
		task   ?Task
		result ?ToolResult
	}

	// A tool as `tools/list` describes it.
	struct Tool {
		name         string
		// A name to show to people; "" to show `name`.
		title        string
		description  string
		// The JSON Schema of the arguments object.
		inputSchema  map<string, any>
		// The JSON Schema of the structured result; none when the tool
		// returns none.
		outputSchema ?map<string, any>
		hints        ?ToolHints
		icons        Icon[]
		extra        map<string, any>
		// Whether a call runs as a task; a tool that works for long says
		// Optional or Required.
		taskSupport  TaskSupport
	}

	// What a tool call returns.
	struct ToolResult {
		content    Content[]
		// The structured result: a JSON value matching the tool's
		// `outputSchema`; none when there is none.
		structured any
		// The tool ran and failed; `content` says how.
		isError    bool
		extra      map<string, any>
	}

	// A resource as `resources/list` describes it.
	struct Resource {
		uri         string
		name        string
		title       string
		description string
		mimeType    string
		// Size of the contents in bytes; none when not known.
		size        ?int
		annotations ?Annotations
		icons       Icon[]
		extra       map<string, any>
	}

	// A family of resources addressed by a URI template (RFC 6570), as
	// `resources/templates/list` describes it.
	struct ResourceTemplate {
		uriTemplate string
		name        string
		title       string
		description string
		mimeType    string
		annotations ?Annotations
		icons       Icon[]
		extra       map<string, any>
	}

	// The contents of one resource: text, or bytes when `binary` is set.
	struct ResourceContents {
		uri      string
		mimeType string
		text     string
		blob     byte[]
		// The contents are `blob`, not `text`.
		binary   bool
		extra    map<string, any>
	}

	// One argument of a prompt.
	struct PromptArgument {
		name        string
		title       string
		description string
		required    bool
	}

	// A prompt template as `prompts/list` describes it.
	struct Prompt {
		name        string
		title       string
		description string
		arguments   PromptArgument[]
		icons       Icon[]
		extra       map<string, any>
	}

	// One message of a prompt.
	struct PromptMessage {
		role    Role
		content Content
	}

	// What `prompts/get` returns.
	struct PromptResult {
		description string
		messages    PromptMessage[]
		extra       map<string, any>
	}

	// A folder or a file the client lets the server work in.
	struct Root {
		// A `file://` URI.
		uri  string
		name string
	}

	// The values a completion offers for an argument.
	struct Completion {
		// At most 100 values, best first.
		values  string[]
		// How many values exist in all; none when not known.
		total   ?int
		// More values exist than `values` holds.
		hasMore bool
	}

	// What the user did with an elicitation.
	enum ElicitAction {
		// Submitted the form, or agreed to open the URL.
		Accept,
		// Said no.
		Decline,
		// Dismissed it without choosing.
		Cancel
	}

	// The answer to an elicitation.
	struct Elicitation {
		action  ElicitAction
		// The submitted values by property name, for an accepted form.
		content map<string, any>
	}

	// Which model a server would like a sampling request to go to. The
	// client chooses; these are hints.
	struct ModelPreferences {
		// Model names or name parts, best first (`claude-3-5-sonnet`,
		// `sonnet`).
		hints                string[]
		// How much low cost, speed and capability matter, each from 0 to 1;
		// none when not said.
		costPriority         ?float
		speedPriority        ?float
		intelligencePriority ?float
	}

	// One message of a sampled conversation.
	struct SamplingMessage {
		role    Role
		content Content[]
		extra   map<string, any>
	}

	// A request for the client's model to write a message
	// (`sampling/createMessage`).
	struct SamplingRequest {
		messages       SamplingMessage[]
		// The most tokens to write.
		maxTokens      int
		systemPrompt   string
		preferences    ?ModelPreferences
		// `none`, `thisServer` or `allServers`: which servers' context the
		// client may add; "" leaves it out. The last two are deprecated.
		includeContext string
		temperature    ?float
		stopSequences  string[]
		// Passed to the model provider as it is.
		metadata       map<string, any>
		// Tools the model may call (revision 2025-11-25 and later, clients
		// that declare sampling with tools).
		tools          Tool[]
		// `auto`, `required` or `none`; "" leaves it out.
		toolChoice     string
	}

	// The message the client's model wrote.
	struct SamplingResult {
		role       Role
		content    Content[]
		// The name of the model that wrote it.
		model      string
		// `endTurn`, `stopSequence`, `maxTokens`, `toolUse`, or what the
		// provider reported; "" when not said.
		stopReason string
		extra      map<string, any>
	}

	// What a client can do for a server.
	struct ClientCapabilities {
		// Answers `roots/list`.
		roots            bool
		// Tells when its roots change (revisions before 2026-07-28).
		rootsListChanged bool
		// Answers `sampling/createMessage`.
		sampling         bool
		// Honours `includeContext` in sampling.
		samplingContext  bool
		// Takes tools in sampling.
		samplingTools    bool
		// Shows elicitation forms.
		elicitation      bool
		// Opens elicitation URLs.
		elicitationUrl   bool
		// Settings of the experimental features it supports, by name.
		experimental     map<string, any>
		// Settings of the extensions it supports, by identifier.
		extensions       map<string, any>
	}

	// What a server offers.
	struct ServerCapabilities {
		tools                bool
		toolsListChanged     bool
		resources            bool
		resourcesSubscribe   bool
		resourcesListChanged bool
		prompts              bool
		promptsListChanged   bool
		logging              bool
		completions          bool
		// Runs tool calls as tasks: the `tasks` capability of 2025-11-25, the
		// `io.modelcontextprotocol/tasks` extension of 2026-07-28.
		tasks                bool
		experimental         map<string, any>
		extensions           map<string, any>
	}
}
