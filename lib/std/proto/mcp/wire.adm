// The JSON form of MCP's types: one `…Json` function that writes a value as
// the object the protocol sends, and one `…Of` function that reads it back.
// Readers never fail: a member that is absent or of another JSON type reads
// as its zero value, as the protocol asks of receivers that meet fields
// they do not know.
internal partial module std.proto.mcp.wire {
	use (
		std.data.encoding::(base64encode, base64decode)
		std.time
		std.proto.mcp::*
	)

	// The key prefix of the protocol's own `_meta` members.
	const metaPrefix = "io.modelcontextprotocol/"

	// Whether revision rev is `since` or a later one.
	def atLeast(rev string, since string) bool {
		return rev.compare(since) >= 0
	}

	// Reading JSON values --------------------------------------------------

	// The member of an object under key; none when absent or v is no object.
	def member(v any, key string) any {
		match v {
			case map<string, any>:
				return none unless v.hasKey(key)
				return v[key]
			default:
				return none
		}
	}

	def has(v any, key string) bool {
		match v {
			case map<string, any>:
				return v.hasKey(key)
			default:
				return false
		}
	}

	def textOf(v any) string {
		match v {
			case string:
				return v
			default:
				return ""
		}
	}

	def boolOf(v any) bool {
		match v {
			case bool:
				return v
			default:
				return false
		}
	}

	def optionalBool(v any) ?bool {
		match v {
			case bool:
				return v
			default:
				return none
		}
	}

	def optionalInt(v any) ?int {
		match v {
			case int:
				return v
			case float:
				return int(v)
			default:
				return none
		}
	}

	def optionalFloat(v any) ?float {
		match v {
			case float:
				return v
			case int:
				return float(v)
			default:
				return none
		}
	}

	def intOf(v any) int {
		let n = optionalInt(v)
		return n is none ?? (0, n)
	}

	def objectOf(v any) map<string, any> {
		match v {
			case map<string, any>:
				return v
			default:
				return new map<string, any>()
		}
	}

	def optionalObject(v any) ?map<string, any> {
		match v {
			case map<string, any>:
				return v
			default:
				return none
		}
	}

	def listOf(v any) any[] {
		match v {
			case any[]:
				return v
			default:
				return []
		}
	}

	def textsOf(v any) string[] {
		let out string[] = []
		for let (_, item) in listOf(v) {
			match item {
				case string:
					out.push(item)
				default:
			}
		}
		return out
	}

	def textsJson(values string[]) any[] {
		let out any[] = []
		for let (_, value) in values {
			out.push(value)
		}
		return out
	}

	// Sets key when the text is not empty.
	def put(out map<string, any>, key string, value string) {
		out.set(key, value) when value.len() > 0
	}

	// Sets `_meta` when extra holds anything.
	def putExtra(out map<string, any>, extra map<string, any>) {
		out.set("_meta", extra) when extra.len() > 0
	}

	// Small types ------------------------------------------------------------

	def roleText(role Role) string {
		return role == Role.Assistant ?? ("assistant", "user")
	}

	def roleOf(v any) Role {
		return textOf(v) == "assistant" ?? (Role.Assistant, Role.User)
	}

	def levelText(level LogLevel) string {
		return level.name.lower()
	}

	// The level a name spells; none for a name that is no level.
	def levelOf(v any) ?LogLevel {
		let name = textOf(v)
		for let (_, level) in [LogLevel.Debug, LogLevel.Info, LogLevel.Notice, LogLevel.Warning, LogLevel.Error, LogLevel.Critical, LogLevel.Alert, LogLevel.Emergency] {
			return level when level.name.lower() == name
		}
		return none
	}

	def iconsJson(icons Icon[]) any[] {
		let out any[] = []
		for let (_, icon) in icons {
			let item = map<string, any>{"src": icon.src}
			put(item, "mimeType", icon.mimeType)
			item.set("sizes", textsJson(icon.sizes)) when icon.sizes.len() > 0
			put(item, "theme", icon.theme)
			out.push(item)
		}
		return out
	}

	def iconsOf(v any) Icon[] {
		let out Icon[] = []
		for let (_, item) in listOf(v) {
			out.push(Icon{src: textOf(member(item, "src")), mimeType: textOf(member(item, "mimeType")), sizes: textsOf(member(item, "sizes")), theme: textOf(member(item, "theme"))})
		}
		return out
	}

	// Sets `title` (2025-06-18 and later) and `icons` (2025-11-25 and later).
	def putPresentation(out map<string, any>, title string, icons Icon[], rev string) {
		put(out, "title", title) when atLeast(rev, "2025-06-18")
		out.set("icons", iconsJson(icons)) when icons.len() > 0 && atLeast(rev, "2025-11-25")
	}

	def implementationJson(i Implementation, rev string) map<string, any> {
		let out = map<string, any>{"name": i.name, "version": i.version}
		putPresentation(out, i.title, i.icons, rev)
		if atLeast(rev, "2025-11-25") {
			put(out, "description", i.description)
			put(out, "websiteUrl", i.websiteUrl)
		}
		return out
	}

	def implementationOf(v any) Implementation {
		return Implementation{
			name:        textOf(member(v, "name")),
			version:     textOf(member(v, "version")),
			title:       textOf(member(v, "title")),
			description: textOf(member(v, "description")),
			websiteUrl:  textOf(member(v, "websiteUrl")),
			icons:       iconsOf(member(v, "icons")),
		}
	}

	def annotationsJson(a Annotations) map<string, any> {
		let out = new map<string, any>()
		if a.audience.len() > 0 {
			let audience any[] = []
			for let (_, role) in a.audience {
				audience.push(roleText(role))
			}
			out.set("audience", audience)
		}
		let priority = a.priority
		out.set("priority", priority) unless priority is none
		put(out, "lastModified", a.lastModified)
		return out
	}

	def annotationsOf(v any) ?Annotations {
		return none unless has(v, "audience") || has(v, "priority") || has(v, "lastModified")
		let out = Annotations{priority: optionalFloat(member(v, "priority")), lastModified: textOf(member(v, "lastModified"))}
		for let (_, role) in listOf(member(v, "audience")) {
			out.audience.push(roleOf(role))
		}
		return out
	}

	def putAnnotations(out map<string, any>, a ?Annotations) {
		return when a is none
		let made = annotationsJson(a)
		out.set("annotations", made) when made.len() > 0
	}

	// Resources ----------------------------------------------------------------

	def resourceJson(r Resource, rev string) map<string, any> {
		let out = map<string, any>{"uri": r.uri, "name": r.name}
		putPresentation(out, r.title, r.icons, rev)
		put(out, "description", r.description)
		put(out, "mimeType", r.mimeType)
		putAnnotations(out, r.annotations)
		let size = r.size
		out.set("size", size) unless size is none
		putExtra(out, r.extra)
		return out
	}

	def resourceOf(v any) Resource {
		return Resource{
			uri:         textOf(member(v, "uri")),
			name:        textOf(member(v, "name")),
			title:       textOf(member(v, "title")),
			description: textOf(member(v, "description")),
			mimeType:    textOf(member(v, "mimeType")),
			size:        optionalInt(member(v, "size")),
			annotations: annotationsOf(member(v, "annotations")),
			icons:       iconsOf(member(v, "icons")),
			extra:       objectOf(member(v, "_meta")),
		}
	}

	def templateJson(t ResourceTemplate, rev string) map<string, any> {
		let out = map<string, any>{"uriTemplate": t.uriTemplate, "name": t.name}
		putPresentation(out, t.title, t.icons, rev)
		put(out, "description", t.description)
		put(out, "mimeType", t.mimeType)
		putAnnotations(out, t.annotations)
		putExtra(out, t.extra)
		return out
	}

	def templateOf(v any) ResourceTemplate {
		return ResourceTemplate{
			uriTemplate: textOf(member(v, "uriTemplate")),
			name:        textOf(member(v, "name")),
			title:       textOf(member(v, "title")),
			description: textOf(member(v, "description")),
			mimeType:    textOf(member(v, "mimeType")),
			annotations: annotationsOf(member(v, "annotations")),
			icons:       iconsOf(member(v, "icons")),
			extra:       objectOf(member(v, "_meta")),
		}
	}

	def contentsJson(c ResourceContents) map<string, any> {
		let out = map<string, any>{"uri": c.uri}
		put(out, "mimeType", c.mimeType)
		if c.binary {
			out.set("blob", base64encode(c.blob))
		} else {
			out.set("text", c.text)
		}
		putExtra(out, c.extra)
		return out
	}

	def contentsOf(v any) ResourceContents {
		let out = ResourceContents{uri: textOf(member(v, "uri")), mimeType: textOf(member(v, "mimeType")), text: textOf(member(v, "text")), extra: objectOf(member(v, "_meta"))}
		if has(v, "blob") {
			out.binary = true
			out.blob = decoded(textOf(member(v, "blob")))
		}
		return out
	}

	// The bytes a base64 text spells; empty when it is not base64.
	def decoded(text string) byte[] {
		let out = base64decode(text) onerror recover byte[]
		return out
	}

	// Content ------------------------------------------------------------------

	// A content as revision rev knows it. An audio content is a text naming
	// it before 2025-03-26, a resource link an embedded resource's text
	// before 2025-06-18, since those revisions have neither.
	def contentJson(c Content, rev string) map<string, any> {
		let out = new map<string, any>()
		match c.kind {
			case ContentKind.Text:
				out.set("type", "text")
				out.set("text", c.text)
			case ContentKind.Image:
				out.set("type", "image")
				out.set("data", base64encode(c.data))
				out.set("mimeType", c.mimeType)
			case ContentKind.Audio:
				if atLeast(rev, "2025-03-26") {
					out.set("type", "audio")
					out.set("data", base64encode(c.data))
					out.set("mimeType", c.mimeType)
				} else {
					out.set("type", "text")
					out.set("text", "[audio {c.mimeType}, {c.data.len()} bytes]")
				}
			case ContentKind.Resource:
				out.set("type", "resource")
				let held = c.resource
				out.set("resource", held is none ?? (map<string, any>{"uri": "", "text": ""}, contentsJson(held)))
			case ContentKind.ResourceLink:
				let target = c.link
				let resource = target is none ?? (Resource{}, target)
				if atLeast(rev, "2025-06-18") {
					for let (key, value) in resourceJson(resource, rev) {
						out.set(key, value)
					}
					out.set("type", "resource_link")
				} else {
					out.set("type", "text")
					out.set("text", resource.uri)
				}
				return out
			case ContentKind.ToolUse:
				out.set("type", "tool_use")
				out.set("id", c.id)
				out.set("name", c.name)
				out.set("input", c.input)
			case ContentKind.ToolResult:
				out.set("type", "tool_result")
				out.set("toolUseId", c.id)
				out.set("content", contentListJson(c.content, rev))
				out.set("structuredContent", c.structured) unless c.structured is none
				out.set("isError", true) when c.isError
		}
		putAnnotations(out, c.annotations) unless c.kind := ContentKind.ToolUse || ContentKind.ToolResult
		putExtra(out, c.extra)
		return out
	}

	def contentListJson(items Content[], rev string) any[] {
		let out any[] = []
		for let (_, item) in items {
			out.push(contentJson(item, rev))
		}
		return out
	}

	// A content block; one of a kind this revision does not know reads as
	// an empty text.
	def contentOf(v any) Content {
		let out = Content{kind: ContentKind.Text, annotations: annotationsOf(member(v, "annotations")), extra: objectOf(member(v, "_meta"))}
		match textOf(member(v, "type")) {
			case "text":
				out.text = textOf(member(v, "text"))
			case "image":
				out.kind = ContentKind.Image
				out.data = decoded(textOf(member(v, "data")))
				out.mimeType = textOf(member(v, "mimeType"))
			case "audio":
				out.kind = ContentKind.Audio
				out.data = decoded(textOf(member(v, "data")))
				out.mimeType = textOf(member(v, "mimeType"))
			case "resource":
				out.kind = ContentKind.Resource
				out.resource = contentsOf(member(v, "resource"))
			case "resource_link":
				out.kind = ContentKind.ResourceLink
				out.link = resourceOf(v)
			case "tool_use":
				out.kind = ContentKind.ToolUse
				out.id = textOf(member(v, "id"))
				out.name = textOf(member(v, "name"))
				out.input = objectOf(member(v, "input"))
			case "tool_result":
				out.kind = ContentKind.ToolResult
				out.id = textOf(member(v, "toolUseId"))
				out.content = contentListOf(member(v, "content"))
				out.structured = member(v, "structuredContent")
				out.isError = boolOf(member(v, "isError"))
		}
		return out
	}

	// The content blocks of a member that holds one block or a list of them.
	def contentListOf(v any) Content[] {
		let out Content[] = []
		match v {
			case any[]:
				for let (_, item) in v {
					out.push(contentOf(item))
				}
			case map<string, any>:
				out.push(contentOf(v))
			default:
		}
		return out
	}

	// Tools ----------------------------------------------------------------------

	def toolJson(t Tool, rev string) map<string, any> {
		let out = map<string, any>{"name": t.name}
		putPresentation(out, t.title, t.icons, rev)
		put(out, "description", t.description)
		let schema = t.inputSchema
		schema = map<string, any>{"type": "object"} when schema.len() == 0
		out.set("inputSchema", schema)
		let output = t.outputSchema
		out.set("outputSchema", output) when !(output is none) && atLeast(rev, "2025-06-18")
		let hints = t.hints
		if !(hints is none) && atLeast(rev, "2025-03-26") {
			let made = new map<string, any>()
			let readOnly = hints.readOnly
			made.set("readOnlyHint", readOnly) unless readOnly is none
			let destructive = hints.destructive
			made.set("destructiveHint", destructive) unless destructive is none
			let idempotent = hints.idempotent
			made.set("idempotentHint", idempotent) unless idempotent is none
			let openWorld = hints.openWorld
			made.set("openWorldHint", openWorld) unless openWorld is none
			// Before `title` was a member of the tool itself it lived here.
			put(made, "title", t.title) unless atLeast(rev, "2025-06-18")
			out.set("annotations", made) when made.len() > 0
		}
		// Only 2025-11-25 lets a tool say so: there the client asks for a
		// task; from 2026-07-28 the server decides by itself.
		out.set("execution", map<string, any>{"taskSupport": t.taskSupport.value}) when t.taskSupport != TaskSupport.Forbidden && rev == "2025-11-25"
		putExtra(out, t.extra)
		return out
	}

	// Tasks ----------------------------------------------------------------------

	// The identifier of the tasks extension of revision 2026-07-28.
	const tasksExtension = "io.modelcontextprotocol/tasks"
	// The `_meta` key that ties a message to a task (2025-11-25).
	const relatedTaskKey = "io.modelcontextprotocol/related-task"

	def taskSupportOf(v any) TaskSupport {
		let name = textOf(v)
		return TaskSupport.Optional when name == "optional"
		return TaskSupport.Required when name == "required"
		return TaskSupport.Forbidden
	}

	def taskStatusOf(v any) TaskStatus {
		let name = textOf(v)
		for let (_, status) in [TaskStatus.InputRequired, TaskStatus.Completed, TaskStatus.Failed, TaskStatus.Cancelled] {
			return status when status.value == name
		}
		return TaskStatus.Working
	}

	// A task as the extension of 2026-07-28 writes it (`ttlMs`,
	// `pollIntervalMs`), or as 2025-11-25 did (`ttl`, `pollInterval`).
	def taskJson(t Task, modern bool) map<string, any> {
		let out = map<string, any>{"taskId": t.id, "status": t.status.value}
		put(out, "statusMessage", t.message)
		let created = t.created
		out.set("createdAt", created.str(time.TimeFormat.RFC3339)) unless created is none
		let updated = t.updated
		out.set("lastUpdatedAt", updated.str(time.TimeFormat.RFC3339)) unless updated is none
		let lifetime = t.lifetime
		out.set(modern ?? ("ttlMs", "ttl"), lifetime is none ?? (none, int(lifetime) / 1000000))
		out.set(modern ?? ("pollIntervalMs", "pollInterval"), int(t.pollInterval) / 1000000) when t.pollInterval > 0s
		return out
	}

	// An ISO 8601 timestamp; none when the text is not one.
	def instantOf(v any) ?time.Time {
		let readable = true
		let at = time.parse(textOf(v)) onerror (err error) {
			readable = false
			recover time.now()
		}
		return readable ?? (at, none)
	}

	def taskOf(v any) Task {
		let out = Task{id: textOf(member(v, "taskId")), status: taskStatusOf(member(v, "status")), message: textOf(member(v, "statusMessage"))}
		out.created = instantOf(member(v, "createdAt"))
		out.updated = instantOf(member(v, "lastUpdatedAt"))
		let ttl = optionalInt(member(v, has(v, "ttlMs") ?? ("ttlMs", "ttl")))
		out.lifetime = 1ms * float(ttl) unless ttl is none
		let poll = optionalInt(member(v, has(v, "pollIntervalMs") ?? ("pollIntervalMs", "pollInterval")))
		out.pollInterval = 1ms * float(poll) unless poll is none
		return out
	}

	def toolOf(v any) Tool {
		let out = Tool{
			name:         textOf(member(v, "name")),
			title:        textOf(member(v, "title")),
			description:  textOf(member(v, "description")),
			inputSchema:  objectOf(member(v, "inputSchema")),
			outputSchema: optionalObject(member(v, "outputSchema")),
			icons:        iconsOf(member(v, "icons")),
			extra:        objectOf(member(v, "_meta")),
			taskSupport:  taskSupportOf(member(member(v, "execution"), "taskSupport")),
		}
		let a = member(v, "annotations")
		if has(v, "annotations") {
			out.hints = ToolHints{readOnly: optionalBool(member(a, "readOnlyHint")), destructive: optionalBool(member(a, "destructiveHint")), idempotent: optionalBool(member(a, "idempotentHint")), openWorld: optionalBool(member(a, "openWorldHint"))}
			out.title = textOf(member(a, "title")) when out.title == ""
		}
		return out
	}

	def toolResultJson(r ToolResult, rev string) map<string, any> {
		let out = map<string, any>{"content": contentListJson(r.content, rev)}
		out.set("structuredContent", r.structured) when !(r.structured is none) && atLeast(rev, "2025-06-18")
		out.set("isError", true) when r.isError
		putExtra(out, r.extra)
		return out
	}

	def toolResultOf(v any) ToolResult {
		return ToolResult{content: contentListOf(member(v, "content")), structured: member(v, "structuredContent"), isError: boolOf(member(v, "isError")), extra: objectOf(member(v, "_meta"))}
	}

	// Prompts --------------------------------------------------------------------

	def promptJson(p Prompt, rev string) map<string, any> {
		let out = map<string, any>{"name": p.name}
		putPresentation(out, p.title, p.icons, rev)
		put(out, "description", p.description)
		if p.arguments.len() > 0 {
			let arguments any[] = []
			for let (_, a) in p.arguments {
				let item = map<string, any>{"name": a.name}
				put(item, "title", a.title) when atLeast(rev, "2025-06-18")
				put(item, "description", a.description)
				item.set("required", true) when a.required
				arguments.push(item)
			}
			out.set("arguments", arguments)
		}
		putExtra(out, p.extra)
		return out
	}

	def promptOf(v any) Prompt {
		let out = Prompt{name: textOf(member(v, "name")), title: textOf(member(v, "title")), description: textOf(member(v, "description")), icons: iconsOf(member(v, "icons")), extra: objectOf(member(v, "_meta"))}
		for let (_, a) in listOf(member(v, "arguments")) {
			out.arguments.push(PromptArgument{name: textOf(member(a, "name")), title: textOf(member(a, "title")), description: textOf(member(a, "description")), required: boolOf(member(a, "required"))})
		}
		return out
	}

	def promptResultJson(r PromptResult, rev string) map<string, any> {
		let messages any[] = []
		for let (_, m) in r.messages {
			messages.push(map<string, any>{"role": roleText(m.role), "content": contentJson(m.content, rev)})
		}
		let out = map<string, any>{"messages": messages}
		put(out, "description", r.description)
		putExtra(out, r.extra)
		return out
	}

	def promptResultOf(v any) PromptResult {
		let out = PromptResult{description: textOf(member(v, "description")), extra: objectOf(member(v, "_meta"))}
		for let (_, m) in listOf(member(v, "messages")) {
			out.messages.push(PromptMessage{role: roleOf(member(m, "role")), content: contentOf(member(m, "content"))})
		}
		return out
	}

	// Completion, roots, elicitation, sampling ----------------------------------

	def completionJson(c Completion) map<string, any> {
		let values = c.values.len() > 100 ?? (c.values[0:100], c.values)
		let out = map<string, any>{"values": textsJson(values)}
		let total = c.total
		out.set("total", total) unless total is none
		out.set("hasMore", true) when c.hasMore || c.values.len() > 100
		return map<string, any>{"completion": out}
	}

	def completionOf(v any) Completion {
		let c = member(v, "completion")
		return Completion{values: textsOf(member(c, "values")), total: optionalInt(member(c, "total")), hasMore: boolOf(member(c, "hasMore"))}
	}

	def rootsJson(roots Root[]) map<string, any> {
		let out any[] = []
		for let (_, root) in roots {
			let item = map<string, any>{"uri": root.uri}
			put(item, "name", root.name)
			out.push(item)
		}
		return map<string, any>{"roots": out}
	}

	def rootsOf(v any) Root[] {
		let out Root[] = []
		for let (_, item) in listOf(member(v, "roots")) {
			out.push(Root{uri: textOf(member(item, "uri")), name: textOf(member(item, "name"))})
		}
		return out
	}

	def elicitationJson(e Elicitation) map<string, any> {
		let out = map<string, any>{"action": e.action.name.lower()}
		out.set("content", e.content) when e.action == ElicitAction.Accept && e.content.len() > 0
		return out
	}

	def elicitationOf(v any) Elicitation {
		let action = ElicitAction.Cancel
		match textOf(member(v, "action")) {
			case "accept":
				action = ElicitAction.Accept
			case "decline":
				action = ElicitAction.Decline
		}
		return Elicitation{action: action, content: objectOf(member(v, "content"))}
	}

	def samplingMessageJson(role Role, content Content[], extra map<string, any>, rev string) map<string, any> {
		let out = map<string, any>{"role": roleText(role)}
		// One block is sent bare, as every revision reads it; a list is
		// 2025-11-25's.
		if content.len() == 1 {
			out.set("content", contentJson(content[0], rev))
		} else {
			out.set("content", contentListJson(content, rev))
		}
		putExtra(out, extra)
		return out
	}

	def samplingRequestJson(r SamplingRequest, rev string) map<string, any> {
		let messages any[] = []
		for let (_, m) in r.messages {
			messages.push(samplingMessageJson(m.role, m.content, m.extra, rev))
		}
		let out = map<string, any>{"messages": messages, "maxTokens": r.maxTokens}
		put(out, "systemPrompt", r.systemPrompt)
		put(out, "includeContext", r.includeContext)
		let temperature = r.temperature
		out.set("temperature", temperature) unless temperature is none
		out.set("stopSequences", textsJson(r.stopSequences)) when r.stopSequences.len() > 0
		out.set("metadata", r.metadata) when r.metadata.len() > 0
		let preferences = r.preferences
		if !(preferences is none) {
			let made = new map<string, any>()
			if preferences.hints.len() > 0 {
				let hints any[] = []
				for let (_, name) in preferences.hints {
					hints.push(map<string, any>{"name": name})
				}
				made.set("hints", hints)
			}
			let cost = preferences.costPriority
			made.set("costPriority", cost) unless cost is none
			let speed = preferences.speedPriority
			made.set("speedPriority", speed) unless speed is none
			let intelligence = preferences.intelligencePriority
			made.set("intelligencePriority", intelligence) unless intelligence is none
			out.set("modelPreferences", made)
		}
		if r.tools.len() > 0 && atLeast(rev, "2025-11-25") {
			let tools any[] = []
			for let (_, t) in r.tools {
				tools.push(toolJson(t, rev))
			}
			out.set("tools", tools)
			out.set("toolChoice", map<string, any>{"mode": r.toolChoice}) when r.toolChoice != ""
		}
		return out
	}

	def samplingRequestOf(v any) SamplingRequest {
		let out = SamplingRequest{
			maxTokens:      intOf(member(v, "maxTokens")),
			systemPrompt:   textOf(member(v, "systemPrompt")),
			includeContext: textOf(member(v, "includeContext")),
			temperature:    optionalFloat(member(v, "temperature")),
			stopSequences:  textsOf(member(v, "stopSequences")),
			metadata:       objectOf(member(v, "metadata")),
			toolChoice:     textOf(member(member(v, "toolChoice"), "mode")),
		}
		for let (_, m) in listOf(member(v, "messages")) {
			out.messages.push(SamplingMessage{role: roleOf(member(m, "role")), content: contentListOf(member(m, "content")), extra: objectOf(member(m, "_meta"))})
		}
		if has(v, "modelPreferences") {
			let p = member(v, "modelPreferences")
			let made = ModelPreferences{costPriority: optionalFloat(member(p, "costPriority")), speedPriority: optionalFloat(member(p, "speedPriority")), intelligencePriority: optionalFloat(member(p, "intelligencePriority"))}
			for let (_, hint) in listOf(member(p, "hints")) {
				made.hints.push(textOf(member(hint, "name")))
			}
			out.preferences = made
		}
		for let (_, t) in listOf(member(v, "tools")) {
			out.tools.push(toolOf(t))
		}
		return out
	}

	def samplingResultJson(r SamplingResult, rev string) map<string, any> {
		let out = samplingMessageJson(r.role, r.content, r.extra, rev)
		out.set("model", r.model)
		put(out, "stopReason", r.stopReason)
		return out
	}

	def samplingResultOf(v any) SamplingResult {
		return SamplingResult{role: roleOf(member(v, "role")), content: contentListOf(member(v, "content")), model: textOf(member(v, "model")), stopReason: textOf(member(v, "stopReason")), extra: objectOf(member(v, "_meta"))}
	}

	// Capabilities ---------------------------------------------------------------

	def clientCapabilitiesJson(c ClientCapabilities, rev string) map<string, any> {
		let out = new map<string, any>()
		if c.roots {
			let roots = new map<string, any>()
			roots.set("listChanged", true) when c.rootsListChanged && !atLeast(rev, "2026-07-28")
			out.set("roots", roots)
		}
		if c.sampling {
			let sampling = new map<string, any>()
			if atLeast(rev, "2025-11-25") {
				sampling.set("context", new map<string, any>()) when c.samplingContext
				sampling.set("tools", new map<string, any>()) when c.samplingTools
			}
			out.set("sampling", sampling)
		}
		if (c.elicitation || c.elicitationUrl) && atLeast(rev, "2025-06-18") {
			let elicitation = new map<string, any>()
			if atLeast(rev, "2025-11-25") {
				elicitation.set("form", new map<string, any>()) when c.elicitation
				elicitation.set("url", new map<string, any>()) when c.elicitationUrl
			}
			out.set("elicitation", elicitation)
		}
		out.set("experimental", c.experimental) when c.experimental.len() > 0
		out.set("extensions", c.extensions) when c.extensions.len() > 0 && atLeast(rev, "2026-07-28")
		return out
	}

	def clientCapabilitiesOf(v any) ClientCapabilities {
		let elicitation = member(v, "elicitation")
		// An empty elicitation object means forms, as the revisions before
		// URL mode declared it.
		let forms = has(v, "elicitation") && (has(elicitation, "form") || !has(elicitation, "url"))
		return ClientCapabilities{
			roots:            has(v, "roots"),
			rootsListChanged: boolOf(member(member(v, "roots"), "listChanged")),
			sampling:         has(v, "sampling"),
			samplingContext:  has(member(v, "sampling"), "context"),
			samplingTools:    has(member(v, "sampling"), "tools"),
			elicitation:      forms,
			elicitationUrl:   has(elicitation, "url"),
			experimental:     objectOf(member(v, "experimental")),
			extensions:       objectOf(member(v, "extensions")),
		}
	}

	def serverCapabilitiesJson(c ServerCapabilities, rev string) map<string, any> {
		let out = new map<string, any>()
		if c.tools {
			let tools = new map<string, any>()
			tools.set("listChanged", true) when c.toolsListChanged
			out.set("tools", tools)
		}
		if c.resources {
			let resources = new map<string, any>()
			resources.set("subscribe", true) when c.resourcesSubscribe
			resources.set("listChanged", true) when c.resourcesListChanged
			out.set("resources", resources)
		}
		if c.prompts {
			let prompts = new map<string, any>()
			prompts.set("listChanged", true) when c.promptsListChanged
			out.set("prompts", prompts)
		}
		out.set("logging", new map<string, any>()) when c.logging
		out.set("completions", new map<string, any>()) when c.completions && atLeast(rev, "2025-03-26")
		out.set("experimental", c.experimental) when c.experimental.len() > 0
		if c.tasks && rev == "2025-11-25" {
			let calls = map<string, any>{"tools": map<string, any>{"call": new map<string, any>()}}
			out.set("tasks", map<string, any>{"list": new map<string, any>(), "cancel": new map<string, any>(), "requests": calls})
		}
		let extensions = c.extensions.clone()
		extensions.set(tasksExtension, new map<string, any>()) when c.tasks && !extensions.hasKey(tasksExtension)
		out.set("extensions", extensions) when extensions.len() > 0 && atLeast(rev, "2026-07-28")
		return out
	}

	def serverCapabilitiesOf(v any) ServerCapabilities {
		return ServerCapabilities{
			tools:                has(v, "tools"),
			toolsListChanged:     boolOf(member(member(v, "tools"), "listChanged")),
			resources:            has(v, "resources"),
			resourcesSubscribe:   boolOf(member(member(v, "resources"), "subscribe")),
			resourcesListChanged: boolOf(member(member(v, "resources"), "listChanged")),
			prompts:              has(v, "prompts"),
			promptsListChanged:   boolOf(member(member(v, "prompts"), "listChanged")),
			logging:              has(v, "logging"),
			completions:          has(v, "completions"),
			tasks:                has(member(member(member(v, "tasks"), "requests"), "tools"), "call") || has(member(v, "extensions"), tasksExtension),
			experimental:         objectOf(member(v, "experimental")),
			extensions:           objectOf(member(v, "extensions")),
		}
	}
}
