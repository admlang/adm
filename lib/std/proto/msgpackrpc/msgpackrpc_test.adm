partial module std.proto.msgpackrpc {
	use (
		std.testing
		std.time
		std.data.encoding::(hexdecode, hexencode, msgpack, MsgPackValue)
	)

	// One direction of an in-memory stream; close makes the reader see the
	// end of the stream.
	type MpPipe {
		internal ch   channel<byte[]>
		internal rest byte[]
		internal eof  bool

		def new() {
			self.ch = new channel<byte[]>(256)
		}

		def write(buf byte[]) !int {
			ch <- buf.clone() when buf.len() > 0
			return buf.len()
		}

		def read(buf byte[]) !int {
			return 0 when eof
			if rest.len() == 0 {
				let chunk = <-ch
				if chunk.len() == 0 {
					eof = true
					return 0
				}
				rest = chunk
			}
			let n = rest.len() < buf.len() ?? (rest.len(), buf.len())
			for let i = 0; i < n; i++ {
				buf[i] = rest[i]
			}
			rest = rest.slice(n, rest.len() - n)
			return n
		}

		def close() {
			ch <- byte[]
		}
	}

	struct MpPoint {
		@msgpack("x")
		x int

		@msgpack("y")
		y int
	}

	// Reads one chunk the peer wrote.
	def mpRead(p MpPipe) string {
		let buf byte[]
		buf.len(4096)
		let n = p.read(buf) onerror recover 0
		return hexencode(buf.slice(0, n)).lower()
	}

	def mpRpcFails(fn def () !MsgPackValue, kind ErrorCode) bool {
		let got = ErrorCode.Protocol
		let failed = false
		fn() onerror (err error) {
			failed = true
			got = err.kind when err is RPCError
			recover new MsgPackValue()
		}
		println("wanted {kind.name}, failed={failed} got={got.name}") when !failed || got != kind
		return failed && got == kind
	}

	def mpCloseLater(pipe MpPipe, after duration) {
		time.sleep(after)
		pipe.close()
	}

	check "MessagePack-RPC" {
		@test()
		def TestWire() !none {
			let input = new MpPipe()
			let output = new MpPipe()
			let peer = new Peer(input, output)
			peer.handle("add", def (req Request) !any {
				return (try req.arg(0).asInt()) + (try req.arg(1).asInt())
			})
			peer.start()
			// The request arrives a byte at a time.
			for let b in (hexdecode("940007a3616464920102") onerror recover byte[]) {
				try input.write([b])
			}
			assert mpRead(output) == "940107c003"
			try input.write(hexdecode("940008a46e6f706590") onerror recover byte[])
			assert mpRead(output) == "940108b66d6574686f64206e6f7420666f756e643a206e6f7065c0"
			// A message of an unknown type ends the peer.
			try input.write(hexdecode("9109") onerror recover byte[])
			peer.wait()
			assert peer.endReason().contains("unknown message type 9")
			return none
		}

		@test()
		def TestPeers() !none {
			let toB = new MpPipe()
			let toA = new MpPipe()
			let a = new Peer(toA, toB)
			let b = new Peer(toB, toA)
			b.handle("add", def (req Request) !any {
				return (try req.arg(0).asInt()) + (try req.arg(1).asInt())
			})
			b.handle("swap", def (req Request) !any {
				let p = new MpPoint()
				try req.bind(0, p)
				let out = new MpPoint()
				out.x = p.y
				out.y = p.x
				return out
			})
			b.handle("refuse", def (_ Request) !any {
				let reason any[] = ["NotFound", 42]
				fail errorOf(reason)
			})
			b.handle("crash", def (req Request) !any {
				fail "plain failure"
			})
			let seen int[] = []
			b.handle("tick", def (req Request) !any {
				seen.push(try req.arg(0).asInt())
				return none
			})
			b.handle("count", def (req Request) !any {
				return seen.len()
			})
			b.handle("slow", def (_ Request) !any {
				time.sleep(300ms)
				return 1
			})
			a.handle("ping", def (req Request) !any {
				return "pong"
			})
			b.handle("relay", def (req Request) !any {
				return try b.call("ping")
			})
			a.start()
			b.start()
			assert (try (try a.call("add", [40, 2])).asInt()) == 42
			let p = new MpPoint()
			p.x = 1
			p.y = 2
			let swapped = new MpPoint()
			try a.call("swap", [p], swapped)
			assert swapped.x == 2 && swapped.y == 1
			a.call("refuse") onerror (err error) {
				if err is RPCError {
					assert err.kind == ErrorCode.Remote && err.object.str() == "[\"NotFound\", 42]"
				}
				recover new MsgPackValue()
			}
			a.call("crash") onerror (err error) {
				if err is RPCError {
					assert err.message == "plain failure"
				}
				recover new MsgPackValue()
			}
			assert mpRpcFails(() => a.call("nope"), ErrorCode.Remote)
			assert (try (try a.call("relay")).asString()) == "pong"
			for let i = 0; i < 30; i++ {
				try a.notify("tick", [i])
			}
			assert (try (try a.call("count")).asInt()) == 30
			for let i = 0; i < 30; i++ {
				assert seen[i] == i
			}
			a.timeout = 30ms
			assert mpRpcFails(() => a.call("slow"), ErrorCode.Timeout)
			a.timeout = 0s
			let closer = async mpCloseLater(toA, 30ms)
			closer.keepAlive()
			assert mpRpcFails(() => a.call("slow"), ErrorCode.Closed)
			a.wait()
			assert mpRpcFails(() => a.call("add", [1, 1]), ErrorCode.Closed)
			let early = new Peer(new MpPipe(), new MpPipe())
			assert mpRpcFails(() => early.call("add"), ErrorCode.Closed)
			toB.close()
			b.wait()
			return none
		}
	}
}
