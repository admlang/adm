// The build machine's side of build-time metas. The compiler writes a small
// program per `BuildMetaContext` annotation, which calls `run` with the meta;
// nothing else needs this module.
module std.reflection.buildhost {
	use (
		std.os
		std.reflection
		std.services::(Application)
	)

	// run calls one build-time meta with a context over the folder `dir` and
	// writes what it did to `resultPath` for the compiler: the value it set,
	// its diagnostics and the paths it read.
	// Fails when the result cannot be written.
	def run<T>(dir string, resultPath string, body def(ctx reflection.BuildMetaContext<T>)) !none {
		let host = new Host(dir)
		host.resultPath = resultPath
		let ctx = new reflection.BuildMetaContext<T>()
		ctx.editor = host
		ctx.files = host
		ctx.diagnostics = host
		ctx.source = host
		body(ctx)
		try os.writeFile(resultPath, host.report())
		return none
	}

	// runType calls one build-time meta of a type: `typeName` in `moduleName`, with
	// the fields its declaration wrote. The members and declarations the
	// meta adds go to `resultPath` beside its diagnostics and the paths it
	// read.
	// Fails when the result cannot be written.
	def runType(dir string, resultPath string, typeName string, moduleName string, fields reflection.SourceField[], body def(ctx reflection.BuildMetaContext<reflection.TypeDescriptor>)) !none {
		let host = new Host(dir)
		host.resultPath = resultPath
		host.sourceFields = fields
		let ctx = new reflection.BuildMetaContext<reflection.TypeDescriptor>()
		ctx.descriptor.node.kind = reflection.ReflectionKind.Type
		ctx.descriptor.node.name = typeName
		ctx.descriptor.node.qualifiedName = "{moduleName}.{typeName}"
		ctx.descriptor.kind = reflection.TypeKind.Struct
		ctx.descriptor.moduleNode.kind = reflection.ReflectionKind.Module
		ctx.descriptor.moduleNode.name = moduleName
		ctx.descriptor.moduleNode.qualifiedName = moduleName
		ctx.editor = host
		ctx.files = host
		ctx.diagnostics = host
		ctx.source = host
		body(ctx)
		try os.writeFile(resultPath, host.report())
		return none
	}

	// What one run collects. It is the context's editor, file system,
	// diagnostics and source editor at once.
	internal type Host {
		dir          string
		// Where the run's report goes: written early when a read fails.
		resultPath   string                   = ""
		kind         string                   = "none"
		literal      string                   = ""
		data         byte[]
		errors       string[]
		warnings     string[]
		reads        string[]
		sourceFields reflection.SourceField[]
		members      string[]
		declarations string[]

		def new(dir string) {
			self.dir = dir
		}

		def get() any {
			return none
		}

		def set(value any) {
			if value is byte[] {
				setBytes(value)
				return
			}
			let text = literalOf(value)
			if text == "" {
				errors.push("cannot write a {reflection.typeName(value)} as a literal")
				return
			}
			setLiteral(text)
		}

		def setLiteral(value string) {
			kind = "literal"
			literal = value
		}

		def setBytes(data byte[]) {
			kind = "bytes"
			self.data = data
		}

		def clear() {
			kind = "none"
		}

		def readFile(path string) byte[] {
			let full = os.join(dir, path)
			reads.push("f {full}")
			return os.readFile(full) onerror (err error) {
				stop("cannot read {path}: {refusal(err)}")
				recover byte[]
			}
		}

		def readDir(path string) reflection.EmbeddedEntry[] {
			let full = os.join(dir, path)
			reads.push("d {full}")
			let out reflection.EmbeddedEntry[] = []
			let entries = os.readDir(full, 0) onerror (err error) {
				stop("cannot list {path}: {refusal(err)}")
				recover os.DirEntry[]
			}
			for let entry in entries {
				continue when entry.info.isDir
				reads.push("f {entry.path}")
				let content = os.readFile(entry.path) onerror (err error) {
					stop("cannot read {entry.path}: {refusal(err)}")
					recover byte[]
				}
				out.push(reflection.EmbeddedEntry{path: os.base(entry.path), data: content})
			}
			return out
		}

		def error(message string) {
			errors.push(message)
		}

		// Ends the run with `message` as its error. A read that fails ends
		// the meta there: the build reports the read, and the meta is not
		// left to go on with nothing and report that too.
		internal def stop(message string) {
			errors.push(message)
			os.writeFile(resultPath, report()) onerror recover none
			Application.exit(0)
		}

		def warn(message string) {
			warnings.push(message)
		}

		def info(message string) {}

		def fields() reflection.SourceField[] {
			return sourceFields
		}

		def addMember(code string) {
			members.push(code)
		}

		def addDeclaration(code string) {
			declarations.push(code)
		}

		// report is the run as the compiler reads it: records of a line
		// `tag length` followed by that many bytes and a newline.
		def report() byte[] {
			let out byte[] = []
			record(out, "kind", kind.bytes())
			record(out, "literal", literal.bytes()) when kind == "literal"
			record(out, "bytes", data) when kind == "bytes"
			for let message in errors {
				record(out, "error", message.bytes())
			}
			for let message in warnings {
				record(out, "warn", message.bytes())
			}
			for let path in reads {
				record(out, "read", path.bytes())
			}
			for let code in members {
				record(out, "member", code.bytes())
			}
			for let code in declarations {
				record(out, "declaration", code.bytes())
			}
			return out
		}
	}

	// Why a read failed. A read the policy refused says what allows it: a
	// meta reads the project's sources, and a library's meta only with the
	// permission accepted at install.
	internal def refusal(err error) string {
		return err.message unless err.code := "policy.ask" || "policy.denied"
		return "{err.message} (a build-time meta reads the project's sources and the paths `[policy] build_read` lists in adm.toml; a library's meta also needs adm.storage.read accepted at install)"
	}

	internal def record(out byte[], tag string, payload byte[]) {
		out.push(..."{tag} {payload.len()}\n".bytes())
		out.push(...payload)
		out.push(byte('\n'))
	}

	// literalOf writes a value as the ADM literal that makes it again: a
	// number, a bool, a string, or an array of those. "" for anything else.
	internal def literalOf(value any) string {
		match reflection.kindOf(value) {
			case reflection.FieldKind.Bool, reflection.FieldKind.Int, reflection.FieldKind.Uint, reflection.FieldKind.Float:
				return "{value}"
			case reflection.FieldKind.String:
				return quoted(string(value))
			case reflection.FieldKind.Array:
				let parts string[] = []
				for let element in reflection.elements(value) {
					let part = literalOf(element)
					return "" when part == ""
					parts.push(part)
				}
				return "[{parts.join(", ")}]"
			default:
				return ""
		}
	}

	internal def quoted(text string) string {
		let out = text.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t")
		out = out.replace("\{", "\\\{").replace("\}", "\\\}")
		return "\"{out}\""
	}
}
