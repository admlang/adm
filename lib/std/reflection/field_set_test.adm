partial module std.reflection {
	use std.testing

	enum SetLevel {
		Low,
		High = 7,
	}

	type SetInner {
		n int = 1
	}

	// A marker with nothing to do, so the fields under it keep their doc
	// comments.
	meta def setMark(ctx FieldMetaContext) {}

	type SetBox {
		// Whether it is on.
		// A second line.
		@setMark
		on bool
		name string
		level SetLevel
		wait duration
		small int8
		big uint64
		ratio float32
		maybe ?int
		names string[]
		levels SetLevel[]
		limits map<string, int>
		inner SetInner
		loose any
	}

	check "Field.set" {
		def put(box SetBox, name string, value any) bool {
			let slot = field(box, name)
			return false when slot is none
			return slot.set(value)
		}

		@test()
		def TestScalarsEnumsAndDurations() {
			let box = new SetBox()
			assert put(box, "on", true) && box.on
			assert put(box, "name", "x") && box.name == "x"
			assert put(box, "level", SetLevel.High) && box.level == SetLevel.High
			assert put(box, "wait", 90s) && box.wait == 90s
			assert put(box, "small", int8(-3)) && box.small == -3
			assert put(box, "big", uint64(18446744073709551615)) && box.big == uint64(18446744073709551615)
			assert put(box, "ratio", float32(0.5)) && box.ratio == float32(0.5)
			let maybe = box.maybe
			assert maybe is none
			assert put(box, "maybe", 4)
			let filled = box.maybe
			assert !(filled is none)
		}

		@test()
		def TestListsMapsAndObjects() {
			let box = new SetBox()
			let names string[] = ["a", "b"]
			assert put(box, "names", names) && box.names.join("+") == "a+b"
			let levels SetLevel[] = [SetLevel.High, SetLevel.Low]
			assert put(box, "levels", levels) && box.levels.len() == 2 && box.levels[0] == SetLevel.High && box.levels[1] == SetLevel.Low
			assert put(box, "limits", map<string, int>{"cpu": 4}) && box.limits["cpu"] == 4
			assert put(box, "inner", new SetInner(n = 9)) && box.inner.n == 9
			assert put(box, "loose", "text")
		}

		@test()
		def TestAValueTheFieldCannotHoldIsRefused() {
			let box = new SetBox()
			assert !put(box, "on", "yes") && !box.on
			assert !put(box, "name", 3) && box.name == ""
			assert !put(box, "names", "a") && box.names.len() == 0
			assert !put(box, "limits", 5)
		}

		@test()
		def TestElementsOfAnEnumArrayAreBoxed() {
			let levels SetLevel[] = [SetLevel.High, SetLevel.Low]
			let items = elements(levels)
			assert items.len() == 2
			assert scalarText(items[0]) == "7" && scalarText(items[1]) == "0"
			assert typeName(items[0]) == "std.reflection.SetLevel"
		}

		@test()
		def TestDocOfAnAnnotatedField() {
			let box = new SetBox()
			let on = field(box, "on")
			let name = field(box, "name")
			assert !(on is none) && on.doc == "Whether it is on.\nA second line."
			assert !(name is none) && name.doc == ""
		}
	}
}
