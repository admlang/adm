partial module std.reflection {
	// Temporary stubs to allow semantic checking of reflection/testing helpers.
	def __meta_invoke(handle anydata);

	def __meta_skip(handle anydata);

	def __meta_has_result(handle anydata) bool;

	def __meta_result(handle anydata) any;

	def __meta_failed(handle anydata) bool;

	def __meta_resolve(handle anydata, value any);

	def __meta_detach(handle anydata) anydata;

	def __meta_slot_get(handle anydata) any;

	def __meta_slot_set(handle anydata, value any);

	def __meta_slot_clear(handle anydata);

	def __meta_store_load(scope string, key string) string;

	def __meta_store_save(scope string, key string, value string);

	def __meta_store_delete(scope string, key string);

	// Runtime metadata store implementation used by compiler-generated meta wrappers.
	type __RuntimeMetadataStore {
		prefix string

		def load(key string) string {
			return __meta_store_load(prefix, key)
		}

		def save(key string, value string) {
			__meta_store_save(prefix, key, value)
		}

		def delete(key string) {
			__meta_store_delete(prefix, key)
		}

		def scope() string {
			return prefix
		}
	}

	// metadata returns a scoped metadata store instance.
	def metadata(scope string) MetadataStore {
		return __RuntimeMetadataStore{prefix: scope}
	}

	// Scope helpers for runtime metadata.
	//
	// These helpers standardize the keys used by compiler-generated meta wrappers
	// so reflection consumers (e.g. serializers) can query metadata without
	// scanning attributes.
	def functionMetadata(qualifiedName string, signature string) MetadataStore {
		return metadata("fn:{qualifiedName}|{signature}")
	}

	def parameterMetadata(qualifiedName string, signature string, index int) MetadataStore {
		return metadata("param:{qualifiedName}|{signature}|{index}")
	}

	def fieldMetadata(typeName string, field string) MetadataStore {
		return metadata("field:{typeName}.{field}")
	}

	// fieldMetadataOf returns the field metadata store for a runtime value's type.
	def fieldMetadataOf(value any, field string) MetadataStore {
		return fieldMetadata(typeName(value), field)
	}

	enum MetaPhase {
		CompileTime,
		Runtime,
		Dual,
	}

	type MetaContext {
		phase       MetaPhase
		node        ReflectionNode
		diagnostics DiagnosticSink
		attributes  AttributeInfo[]
		storage     MetadataStore

		def isCompileTime() bool {
			return phase == MetaPhase.CompileTime || phase == MetaPhase.Dual
		}

		def isRuntime() bool {
			return phase == MetaPhase.Runtime || phase == MetaPhase.Dual
		}
	}

	type DeclarationMetaContext {
		ctx         MetaContext
		declaration ReflectionNode
	}

	type ModuleMetaContext {
		ctx        MetaContext
		moduleNode ReflectionNode
	}

	type ApplicationMetaContext {
		ctx             MetaContext
		applicationNode ApplicationDescriptor
	}

	type LibraryMetaContext {
		ctx        MetaContext
		descriptor LibraryDescriptor
	}

	type PluginMetaContext {
		ctx        MetaContext
		descriptor PluginDescriptor
	}

	type ServiceMetaContext {
		ctx        MetaContext
		descriptor ServiceDescriptor
	}

	type ComponentMetaContext {
		ctx        MetaContext
		descriptor ComponentDescriptor
	}

	type TypeMetaContext {
		ctx        MetaContext
		descriptor TypeDescriptor
	}

	type StructMetaContext {
		ctx        MetaContext
		descriptor TypeDescriptor
	}

	type EnumMetaContext {
		ctx        MetaContext
		descriptor TypeDescriptor
	}

	// A call taken out of its meta wrapper so it can run later.
	//
	// The wrapped function's arguments stay alive for as long as the detached
	// call does. `invoke()` runs the body once; a second call does nothing.
	type DetachedCall {
		handle  anydata
		storage MetadataStore

		def invoke() {
			__meta_invoke(handle)
		}

		// Returns the value the body produced, none before `invoke()` ran or
		// when the body returns nothing.
		def result() ?any {
			return none unless __meta_has_result(handle)
			return __meta_result(handle)
		}

		// Reports whether the body returned an error.
		def failed() bool {
			return __meta_failed(handle)
		}
	}

	type FunctionMetaContext {
		ctx        MetaContext
		descriptor FunctionDescriptor
		handle     anydata

		def invoke() {
			__meta_invoke(handle)
		}

		def skip() {
			__meta_skip(handle)
		}

		// Detaches the call so a meta can run it after the wrapped call has
		// returned, from a task or a timer.
		//
		// The wrapped function is skipped and its caller receives the zero
		// value right away. The context itself must not be used after the
		// wrapped call returns; the detached call carries its own copy of the
		// function's metadata store.
		def detach() DetachedCall {
			return DetachedCall{handle: __meta_detach(handle), storage: metadata(ctx.storage.scope())}
		}

		// Returns the value produced by the wrapped call.
		//
		// Returns none before `invoke()` runs, when the call was skipped, or when
		// the function returns nothing.
		def result() ?any {
			return none unless __meta_has_result(handle)
			return __meta_result(handle)
		}

		// Reports whether the wrapped body returned an error.
		//
		// Always false for a body whose return type is not errorable.
		def failed() bool {
			return __meta_failed(handle)
		}

		// Supplies the call's result without executing the wrapped function.
		//
		// The wrapped function is skipped and the caller receives `value`.
		def resolve(value any) {
			__meta_resolve(handle, value)
		}
	}

	type MethodMetaContext {
		ctx        MetaContext
		descriptor FunctionDescriptor
		receiver   TypeDescriptor
		handle     anydata

		def invoke() {
			__meta_invoke(handle)
		}

		def skip() {
			__meta_skip(handle)
		}

		// Detaches the call so a meta can run it after the wrapped call has
		// returned; see FunctionMetaContext.detach.
		def detach() DetachedCall {
			return DetachedCall{handle: __meta_detach(handle), storage: metadata(ctx.storage.scope())}
		}

		// Returns the value produced by the wrapped call.
		//
		// Returns none before `invoke()` runs, when the call was skipped, or when
		// the method returns nothing.
		def result() ?any {
			return none unless __meta_has_result(handle)
			return __meta_result(handle)
		}

		// Reports whether the wrapped body returned an error.
		//
		// Always false for a body whose return type is not errorable.
		def failed() bool {
			return __meta_failed(handle)
		}

		// Supplies the call's result without executing the wrapped method.
		//
		// The wrapped method is skipped and the caller receives `value`.
		def resolve(value any) {
			__meta_resolve(handle, value)
		}
	}

	type PropertyMetaContext {
		ctx        MetaContext
		descriptor PropertyDescriptor
		editor     ValueEditor
	}

	type FieldMetaContext {
		ctx        MetaContext
		descriptor FieldDescriptor
		editor     ValueEditor
	}

	type VariableMetaContext {
		ctx        MetaContext
		descriptor VariableDescriptor
		editor     ValueEditor
	}

	type ConstMetaContext {
		ctx        MetaContext
		descriptor ConstDescriptor
		editor     ValueEditor
		files      EmbeddedFileSystem
	}

	type LetMetaContext {
		ctx        MetaContext
		descriptor LetDescriptor
		editor     ValueEditor
		files      EmbeddedFileSystem
	}

	type ParameterMetaContext {
		ctx        MetaContext
		descriptor ParameterDescriptor
		editor     ValueEditor

		def get() any {
			return editor.get()
		}

		def set(value any) {
			editor.set(value)
		}

		def clear() {
			editor.clear()
		}
	}

	type CheckMetaContext {
		ctx   MetaContext
		suite ReflectionNode
	}

	// DiscoveryMetaContext is a compile-time meta context wrapper used for
	// "discovery" style annotations.
	//
	// Discovery annotations are intended to be *queried* at runtime through
	// std.reflection program APIs (e.g. `attrs(http.get)`), not executed as
	// runtime wrappers like FunctionMetaContext/MethodMetaContext.
	//
	// T is a normal meta context type (e.g. MethodMetaContext, TypeMetaContext)
	// and is used to constrain which declarations the annotation may target.
	//
	// Example:
	//
	// meta def get(ctx DiscoveryMetaContext<MethodMetaContext>, path string) {
	//     // validate ctx.inner.descriptor.signature, store metadata, etc
	// }
	type DiscoveryMetaContext<T> {
		ctx   MetaContext
		inner T
	}

	// Runtime-only ValueEditor implementation backed by compiler-generated meta slots.
	type __RuntimeValueEditor {
		handle anydata

		def get() any {
			return __meta_slot_get(handle)
		}

		def set(value any) {
			__meta_slot_set(handle, value)
		}

		def setLiteral(value string) {
			__meta_slot_set(handle, value)
		}

		def setBytes(data byte[]) {
			__meta_slot_set(handle, data)
		}

		def clear() {
			__meta_slot_clear(handle)
		}
	}
}
