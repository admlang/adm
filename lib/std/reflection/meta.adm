partial module std.reflection {
	// Temporary stubs to allow semantic checking of reflection/testing helpers.
	def __meta_invoke(handle anydata);

	// __meta_skip tells the runtime to leave the annotated function's body unrun
	// for the invocation behind the handle.
	def __meta_skip(handle anydata);

	// __meta_has_result reports whether the invocation behind the handle produced
	// a result.
	def __meta_has_result(handle anydata) bool;

	// __meta_result returns the result the invocation behind the handle produced.
	def __meta_result(handle anydata) any;

	// __meta_failed reports whether the invocation behind the handle failed.
	def __meta_failed(handle anydata) bool;

	// __meta_resolve sets the value the invocation behind the handle returns.
	def __meta_resolve(handle anydata, value any);

	// __meta_detach takes the invocation behind the handle out of the current
	// context so it can complete later, and returns the detached handle.
	def __meta_detach(handle anydata) anydata;

	// __meta_slot_get reads the value in the slot behind the handle.
	def __meta_slot_get(handle anydata) any;

	// __meta_slot_set stores a value in the slot behind the handle.
	def __meta_slot_set(handle anydata, value any);

	// __meta_slot_clear empties the slot behind the handle.
	def __meta_slot_clear(handle anydata);

	// __meta_store_load reads the value stored under key in the metadata scope,
	// empty when there is none.
	def __meta_store_load(scope string, key string) string;

	// __meta_store_save stores a value under key in the metadata scope.
	def __meta_store_save(scope string, key string, value string);

	// __meta_store_delete removes the key from the metadata scope.
	def __meta_store_delete(scope string, key string);

	// Runtime metadata store implementation used by compiler-generated meta wrappers.
	type __RuntimeMetadataStore {
		prefix string

		// load returns the value stored under key in this store's scope, empty when
		// there is none.
		def load(key string) string {
			return __meta_store_load(prefix, key)
		}

		// save stores a value under key in this store's scope.
		def save(key string, value string) {
			__meta_store_save(prefix, key, value)
		}

		// delete removes the key from this store's scope.
		def delete(key string) {
			__meta_store_delete(prefix, key)
		}

		// scope returns the prefix that names this store's scope.
		def scope() string {
			return prefix
		}
	}

	// metadata returns a scoped metadata store instance.
	def metadata(scope string) MetadataStore {
		return __RuntimeMetadataStore{prefix: scope}
	}

	// Scope helpers for runtime metadata.
	//
	// These helpers standardize the keys used by compiler-generated meta wrappers
	// so reflection consumers (e.g. serializers) can query metadata without
	// scanning attributes.
	def functionMetadata(qualifiedName string, signature string) MetadataStore {
		return metadata("fn:{qualifiedName}|{signature}")
	}

	// parameterMetadata returns the metadata store of one parameter of a
	// function, keyed by the function's qualified name, its signature and the
	// parameter's index.
	def parameterMetadata(qualifiedName string, signature string, index int) MetadataStore {
		return metadata("param:{qualifiedName}|{signature}|{index}")
	}

	// fieldMetadata returns the metadata store of a field of the named type.
	def fieldMetadata(typeName string, field string) MetadataStore {
		return metadata("field:{typeName}.{field}")
	}

	// fieldMetadataOf returns the field metadata store for a runtime value's type.
	def fieldMetadataOf(value any, field string) MetadataStore {
		return fieldMetadata(typeName(value), field)
	}

	// MetaPhase is when a meta function runs: at compile time, at run time, or
	// both.
	enum MetaPhase {
		CompileTime,
		Runtime,
		Dual,
	}

	// MetaContext is what every meta invocation receives: the phase, the node
	// the annotation sits on, a sink for diagnostics, and a metadata store.
	type MetaContext {
		phase       MetaPhase
		node        ReflectionNode
		diagnostics DiagnosticSink
		attributes  AttributeInfo[]
		storage     MetadataStore

		// isCompileTime reports whether the invocation runs at compile time, which a
		// Dual phase also does.
		def isCompileTime() bool {
			return phase == MetaPhase.CompileTime || phase == MetaPhase.Dual
		}

		// isRuntime reports whether the invocation runs at run time, which a Dual
		// phase also does.
		def isRuntime() bool {
			return phase == MetaPhase.Runtime || phase == MetaPhase.Dual
		}
	}

	// DeclarationMetaContext is the context of a meta function annotating any
	// declaration: the common context and the declaration's node.
	type DeclarationMetaContext {
		ctx         MetaContext
		declaration ReflectionNode
	}

	// ModuleMetaContext is the context of a meta function annotating a module:
	// the common context and the module's node.
	type ModuleMetaContext {
		ctx        MetaContext
		moduleNode ReflectionNode
	}

	// ApplicationMetaContext is the context of a meta function annotating an
	// application: the common context and the application's descriptor.
	type ApplicationMetaContext {
		ctx             MetaContext
		applicationNode ApplicationDescriptor
	}

	// LibraryMetaContext is the context of a meta function annotating a library:
	// the common context and the library's descriptor.
	type LibraryMetaContext {
		ctx        MetaContext
		descriptor LibraryDescriptor
	}

	// PluginMetaContext is the context of a meta function annotating a plugin:
	// the common context and the plugin's descriptor.
	type PluginMetaContext {
		ctx        MetaContext
		descriptor PluginDescriptor
	}

	// ServiceMetaContext is the context of a meta function annotating a service:
	// the common context and the service's descriptor.
	type ServiceMetaContext {
		ctx        MetaContext
		descriptor ServiceDescriptor
	}

	// ComponentMetaContext is the context of a meta function annotating a
	// component: the common context and the component's descriptor.
	type ComponentMetaContext {
		ctx        MetaContext
		descriptor ComponentDescriptor
	}

	// TypeMetaContext is the context of a meta function annotating a type: the
	// common context and the type's descriptor.
	type TypeMetaContext {
		ctx        MetaContext
		descriptor TypeDescriptor
	}

	// StructMetaContext is the context of a meta function annotating a struct:
	// the common context and the struct's descriptor.
	type StructMetaContext {
		ctx        MetaContext
		descriptor TypeDescriptor
	}

	// EnumMetaContext is the context of a meta function annotating an enum: the
	// common context and the enum's descriptor.
	type EnumMetaContext {
		ctx        MetaContext
		descriptor TypeDescriptor
	}

	// A call taken out of its meta wrapper so it can run later.
	//
	// The wrapped function's arguments stay alive for as long as the detached
	// call does. `invoke()` runs the body once; a second call does nothing.
	type DetachedCall {
		handle  anydata
		storage MetadataStore

		// invoke runs the annotated function's body.
		def invoke() {
			__meta_invoke(handle)
		}

		// Returns the value the body produced, none before `invoke()` ran or
		// when the body returns nothing.
		def result() ?any {
			return none unless __meta_has_result(handle)
			return __meta_result(handle)
		}

		// Reports whether the body returned an error.
		def failed() bool {
			return __meta_failed(handle)
		}
	}

	// FunctionMetaContext is the context of a meta function annotating a
	// function: its descriptor and a handle to the invocation, which the meta
	// function may run, skip or resolve.
	type FunctionMetaContext {
		ctx        MetaContext
		descriptor FunctionDescriptor
		handle     anydata

		// invoke runs the annotated function's body.
		def invoke() {
			__meta_invoke(handle)
		}

		// skip leaves the annotated function's body unrun for this invocation.
		def skip() {
			__meta_skip(handle)
		}

		// Detaches the call so a meta can run it after the wrapped call has
		// returned, from a task or a timer.
		//
		// The wrapped function is skipped and its caller receives the zero
		// value right away. The context itself must not be used after the
		// wrapped call returns; the detached call carries its own copy of the
		// function's metadata store.
		def detach() DetachedCall {
			return DetachedCall{handle: __meta_detach(handle), storage: metadata(ctx.storage.scope())}
		}

		// Returns the value produced by the wrapped call.
		//
		// Returns none before `invoke()` runs, when the call was skipped, or when
		// the function returns nothing.
		def result() ?any {
			return none unless __meta_has_result(handle)
			return __meta_result(handle)
		}

		// Reports whether the wrapped body returned an error.
		//
		// Always false for a body whose return type is not errorable.
		def failed() bool {
			return __meta_failed(handle)
		}

		// Supplies the call's result without executing the wrapped function.
		//
		// The wrapped function is skipped and the caller receives `value`.
		def resolve(value any) {
			__meta_resolve(handle, value)
		}
	}

	// MethodMetaContext is the context of a meta function annotating a method:
	// its descriptor, the receiver type and a handle to the invocation.
	type MethodMetaContext {
		ctx        MetaContext
		descriptor FunctionDescriptor
		receiver   TypeDescriptor
		handle     anydata

		// invoke runs the annotated method's body.
		def invoke() {
			__meta_invoke(handle)
		}

		// skip leaves the annotated method's body unrun for this invocation.
		def skip() {
			__meta_skip(handle)
		}

		// Detaches the call so a meta can run it after the wrapped call has
		// returned; see FunctionMetaContext.detach.
		def detach() DetachedCall {
			return DetachedCall{handle: __meta_detach(handle), storage: metadata(ctx.storage.scope())}
		}

		// Returns the value produced by the wrapped call.
		//
		// Returns none before `invoke()` runs, when the call was skipped, or when
		// the method returns nothing.
		def result() ?any {
			return none unless __meta_has_result(handle)
			return __meta_result(handle)
		}

		// Reports whether the wrapped body returned an error.
		//
		// Always false for a body whose return type is not errorable.
		def failed() bool {
			return __meta_failed(handle)
		}

		// Supplies the call's result without executing the wrapped method.
		//
		// The wrapped method is skipped and the caller receives `value`.
		def resolve(value any) {
			__meta_resolve(handle, value)
		}
	}

	// PropertyMetaContext is the context of a meta function annotating a
	// property: its descriptor and an editor for its value.
	type PropertyMetaContext {
		ctx        MetaContext
		descriptor PropertyDescriptor
		editor     ValueEditor
	}

	// FieldMetaContext is the context of a meta function annotating a field:
	// its descriptor and an editor for its value.
	type FieldMetaContext {
		ctx        MetaContext
		descriptor FieldDescriptor
		editor     ValueEditor
	}

	// VariableMetaContext is the context of a meta function annotating a
	// variable: its descriptor and an editor for its value.
	type VariableMetaContext {
		ctx        MetaContext
		descriptor VariableDescriptor
		editor     ValueEditor
	}

	// ConstMetaContext is the context of a meta function annotating a constant:
	// its descriptor and an editor for its value.
	type ConstMetaContext {
		ctx        MetaContext
		descriptor ConstDescriptor
		editor     ValueEditor
		files      EmbeddedFileSystem
	}

	// LetMetaContext is the context of a meta function annotating a let
	// variable: its descriptor and an editor for its value.
	type LetMetaContext {
		ctx        MetaContext
		descriptor LetDescriptor
		editor     ValueEditor
		files      EmbeddedFileSystem
	}

	// ParameterMetaContext is the context of a meta function annotating a
	// parameter: its descriptor and an editor for the argument's value.
	type ParameterMetaContext {
		ctx        MetaContext
		descriptor ParameterDescriptor
		editor     ValueEditor

		// get returns the argument's current value.
		def get() any {
			return editor.get()
		}

		// set replaces the argument's value.
		def set(value any) {
			editor.set(value)
		}

		// clear resets the argument to its default.
		def clear() {
			editor.clear()
		}
	}

	// CheckMetaContext is the context of a meta function annotating a check
	// suite: the common context and the suite's node.
	type CheckMetaContext {
		ctx   MetaContext
		suite ReflectionNode
	}

	// DiscoveryMetaContext is a compile-time meta context wrapper used for
	// "discovery" style annotations.
	//
	// Discovery annotations are intended to be *queried* at runtime through
	// std.reflection program APIs (e.g. `attrs(http.get)`), not executed as
	// runtime wrappers like FunctionMetaContext/MethodMetaContext.
	//
	// T is a normal meta context type (e.g. MethodMetaContext, TypeMetaContext)
	// and is used to constrain which declarations the annotation may target.
	//
	// Discovery only sees what the program links. A build compiles the modules
	// reached from its roots through `use`, and the registry `attrs` reads is
	// built from those modules, so an annotated declaration in a module nobody
	// imports is not there to find. A module kept for what it registers is
	// imported as `use the.module as _`, which links it without a name.
	//
	// Example:
	//
	// meta def get(ctx DiscoveryMetaContext<MethodMetaContext>, path string) {
	//     // validate ctx.inner.descriptor.signature, store metadata, etc
	// }
	type DiscoveryMetaContext<T> {
		ctx   MetaContext
		inner T
	}

	// Runtime-only ValueEditor implementation backed by compiler-generated meta slots.
	type __RuntimeValueEditor {
		handle anydata

		// get returns the value in the slot.
		def get() any {
			return __meta_slot_get(handle)
		}

		// set stores a value in the slot.
		def set(value any) {
			__meta_slot_set(handle, value)
		}

		// setLiteral stores a value given as source text.
		def setLiteral(value string) {
			__meta_slot_set(handle, value)
		}

		// setBytes stores raw bytes in the slot.
		def setBytes(data byte[]) {
			__meta_slot_set(handle, data)
		}

		// clear empties the slot.
		def clear() {
			__meta_slot_clear(handle)
		}
	}
}
