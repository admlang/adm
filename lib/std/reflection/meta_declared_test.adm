partial module std.reflection {
	use std.testing

	struct DeclaredItem {
		name  string
		price float
		tags  string[]
	}

	meta def declaredAnswers(target FunctionMetaContext, value int) {
		target.resolve(value)
	}

	meta def declaredSilent(target FunctionMetaContext) {}

	meta def declaredNone(target FunctionMetaContext) {
		target.resolve(none)
	}

	meta def declaredSkips(target FunctionMetaContext) {
		target.skip()
	}

	meta def declaredRejects(target FunctionMetaContext, message string) {
		target.reject(error{message: message})
	}

	// Resolves the sum of the int arguments.
	meta def declaredSums(target FunctionMetaContext) {
		let total = 0
		for let arg in target.args() {
			if arg is int {
				total += arg
			}
		}
		target.resolve(total)
	}

	// Resolves the total price of the first argument and renames its first
	// item, which the caller sees: the array is the caller's own.
	meta def declaredPrices(target FunctionMetaContext) {
		let total = 0.0
		let first = target.args()[0]
		match first {
			case DeclaredItem[]:
				let items DeclaredItem[] = first
				for let item in items {
					total += item.price
				}
				items[0].name = "seen"
		}
		target.resolve(total)
	}

	// Resolves what it sees of each argument: `none` for an absent optional,
	// the type name otherwise, and for an array its elements' field count.
	meta def declaredInspects(target FunctionMetaContext) {
		let text = ""
		for let arg in target.args() {
			if arg is none {
				text = "{text}none;"
			} else {
				text = "{text}{typeName(arg)}"
				for let element in elements(arg) {
					text = "{text}[{fields(element).len()}]"
				}
				text = "{text};"
			}
		}
		target.resolve(text)
	}

	// Named only as the element type of a declaration's parameter.
	struct DeclaredPart {
		name   string
		weight int
		spare  bool
	}

	// Builds one value of the result's type by name, as a decoder would:
	// an instance from the descriptor, filled through its fields.
	def declaredMake(target FunctionMetaContext, name string, price float) any {
		let made = instantiate(target.descriptor.signature.result)
		let nameField = field(made, "name")
		if !(nameField is none) {
			nameField.setString(name)
		}
		let priceField = field(made, "price")
		if !(priceField is none) {
			priceField.setFloat(price)
		}
		let tagsField = field(made, "tags")
		if !(tagsField is none) {
			tagsField.setLen(1)
			tagsField.at(0).setString(name)
		}
		return made
	}

	meta def declaredBuildsOne(target FunctionMetaContext) {
		target.resolve(declaredMake(target, "one", 1.5))
	}

	meta def declaredBuildsMany(target FunctionMetaContext) {
		let made any[]
		made.push(declaredMake(target, "a", 1.0))
		made.push(declaredMake(target, "b", 2.0))
		target.resolve(made)
	}

	meta def declaredBuildsTable(target FunctionMetaContext) {
		let made map<string, any>
		made["x"] = declaredMake(target, "x", 4.0)
		made["y"] = declaredMake(target, "y", 5.0)
		target.resolve(made)
	}

	meta def declaredBuildsNumbers(target FunctionMetaContext) {
		target.resolve([1.0, 2.0, 3.0])
	}

	meta def declaredBuildsNames(target FunctionMetaContext) {
		let made any[]
		made.push("a")
		made.push("b")
		target.resolve(made)
	}

	// Resolves how many times the declaration was called, kept in its slot.
	meta def declaredCounts(target FunctionMetaContext) {
		let seen = 0
		let kept = target.slot()
		if kept is int {
			seen = kept
		}
		target.slot(seen + 1)
		target.resolve(seen + 1)
	}

	// Resolves a text built from the declaration's descriptor.
	meta def declaredDescribes(target FunctionMetaContext) {
		let d = target.descriptor
		let text = "{d.node.name}/{d.signature.result.node.qualifiedName}"
		for let p in d.signature.parameters {
			text = "{text}/{p.node.name}:{p.paramType.node.qualifiedName}"
		}
		target.resolve(text)
	}

	meta def declaredFile(target FunctionMetaContext, file EmbeddedFile) {
		target.resolve("{file.path}={string(file.data).trim()}")
	}

	meta def declaredFileSize(target FunctionMetaContext, label string, file EmbeddedFile) {
		target.resolve(file.data.len())
	}

	// Doubles the first argument of a method that has a body.
	meta def declaredDoubles(target MethodMetaContext) {
		let first = target.args()[0]
		if first is int {
			target.resolve(first * 2)
		}
	}

	type DeclaredScaler {
		@declaredDoubles()
		def scale(value int) int {
			return value
		}
	}

	@declaredAnswers(7)
	def declaredInt() int;

	@declaredAnswers(7)
	def declaredByte() uint8;

	@declaredAnswers(7)
	def declaredFloat() float32;

	@declaredAnswers(7)
	def declaredOptional() ?int;

	@declaredAnswers(7)
	def declaredErrorable() !int;

	@declaredSilent()
	def declaredUnanswered() !int;

	@declaredNone()
	def declaredAbsent() ?int;

	@declaredSkips()
	def declaredQuiet(text string);

	@declaredRejects("no script")
	def declaredBroken() !int;

	@declaredSums()
	def declaredSum(a int, b int, c int) int;

	@declaredPrices()
	def declaredTotal(items DeclaredItem[]) float;

	@declaredCounts()
	def declaredCalls() int;

	@declaredBuildsOne()
	def declaredOne() !DeclaredItem;

	@declaredBuildsMany()
	def declaredMany() DeclaredItem[];

	@declaredBuildsTable()
	def declaredTable() !map<string, DeclaredItem>;

	@declaredBuildsNumbers()
	def declaredBytes() uint8[];

	@declaredBuildsNames()
	def declaredNames() ?string[];

	@declaredInspects()
	def declaredInspect(parts DeclaredPart[], label ?string, count ?int) string;

	@declaredDescribes()
	def declaredDescribe(items DeclaredItem[], limit ?int32) !string;

	@declaredFile("testdata/embedded.txt")
	def declaredFileText() string;

	@declaredFileSize("size", file = "testdata/embedded.txt")
	def declaredFileBytes() int;

	check "DeclaredFunctions" {
		@test()
		def resolvesAsTheDeclaredType() {
			assert declaredInt() == 7
			assert declaredByte() == 7
			assert declaredFloat() == 7.0
			let maybe = declaredOptional()
			assert maybe is int && maybe == 7
			let value = declaredErrorable() onerror recover 0
			assert value == 7
		}

		@test()
		def resolvesNone() {
			let gone = declaredAbsent()
			assert gone is none
			declaredQuiet("x")
		}

		@test()
		def unansweredCallFails() {
			let message = ""
			let value = declaredUnanswered() onerror (err error) {
				message = err.message
				recover 0
			}
			assert message.contains("declaredUnanswered has no body")
		}

		@test()
		def rejects() {
			let message = ""
			let value = declaredBroken() onerror (err error) {
				message = err.message
				recover 0
			}
			assert message == "no script"
		}

		@test()
		def readsArguments() {
			assert declaredSum(1, 2, 3) == 6
			let items = [DeclaredItem{name:"a", price:1.5}, DeclaredItem{name:"b", price:2.0}]
			assert declaredTotal(items) == 3.5
			assert items[0].name == "seen"
			assert new DeclaredScaler().scale(21) == 42
		}

		@test()
		def boxesOptionalsAndKeepsElementTypes() {
			let parts = [DeclaredPart{name:"a", weight:1, spare:false}]
			assert declaredInspect(parts, "x", none) == "std.reflection.DeclaredPart[][3];string;none;"
			assert declaredInspect([], none, 4) == "std.reflection.DeclaredPart[];none;int;"
		}

		@test()
		def buildsStructArrayAndMapResults() {
			let one = declaredOne() onerror recover DeclaredItem{}
			assert one.name == "one" && one.price == 1.5
			let many = declaredMany()
			assert many.len() == 2 && many[1].name == "b" && many[0].price == 1.0
			assert many[1].tags.len() == 1 && many[1].tags[0] == "b"
			let table = declaredTable() onerror recover {}
			assert table.len() == 2 && table["y"].price == 5.0 && table["x"].name == "x"
			assert table["y"].tags.len() == 1 && table["y"].tags[0] == "y"
			let bytes = declaredBytes()
			assert bytes.len() == 3 && bytes[2] == 3
			let names = declaredNames()
			assert !(names is none)
			if !(names is none) {
				assert names.len() == 2 && names[1] == "b"
			}
		}

		@test()
		def keepsASlotPerDeclaration() {
			assert declaredCalls() == 1
			assert declaredCalls() == 2
			assert declaredCalls() == 3
		}

		@test()
		def describesTheDeclaration() {
			let text = declaredDescribe([], none) onerror recover ""
			assert text == "declaredDescribe/!builtin.string/items:std.reflection.DeclaredItem[]/limit:?int32"
		}

		@test()
		def embedsTheNamedFile() {
			assert declaredFileText() == "testdata/embedded.txt=embedded by an annotation"
			assert declaredFileBytes() == 26
		}
	}
}
