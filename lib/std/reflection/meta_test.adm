partial module std.reflection {
	use std.testing

	// Records the detached call so a test can run it after the wrapper has
	// returned.
	let detached ?DetachedCall = none
	let detachedScope = ""

	meta def deferLater(target MethodMetaContext) {
		detachedScope = target.ctx.storage.scope()
		detached = target.detach()
	}

	meta def deferLater(target FunctionMetaContext) {
		detachedScope = target.ctx.storage.scope()
		detached = target.detach()
	}

	type Counter {
		total int

		@deferLater()
		def add(n int, label string) int {
			total += n
			return total
		}
	}

	type Bag {
		items int[]
	}

	let tallied = 0

	@deferLater()
	def tally(bag Bag) int {
		let sum = 0
		for let v in bag.items {
			sum += v
		}
		tallied = sum
		return sum
	}

	check "DetachedCall" {
		@test()
		def detachSkipsTheCaller() {
			detached = none
			let c = new Counter()
			assert c.add(5, "five") == 0
			assert c.total == 0
			assert !(detached is none)
		}

		@test()
		def invokeRunsTheBodyOnce() {
			detached = none
			let c = new Counter()
			c.add(3, "three")
			if detached is DetachedCall {
				assert detached.result() is none
				detached.invoke()
				assert c.total == 3
				detached.invoke()
				assert c.total == 3
				assert !detached.failed()
			}
		}

		@test()
		def argumentsOutliveTheCaller() {
			detached = none
			tallied = 0
			let bag = new Bag()
			bag.items = int[1, 2, 3]
			tally(bag)
			dispose bag
			assert tallied == 0
			if detached is DetachedCall {
				detached.invoke()
				assert tallied == 6
				assert !(detached.result() is none)
			}
		}

		@test()
		def storageMatchesTheFunction() {
			detached = none
			let c = new Counter()
			c.add(1, "one")
			if detached is DetachedCall {
				assert detachedScope != ""
				assert detached.storage.scope() == detachedScope
			}
		}
	}

	// What the last call of a `@countCalls` method counted.
	let countedCalls = 0

	// Counts the calls of the method in its metadata store, as `@debounce`
	// counts its generations.
	meta def countCalls(target MethodMetaContext) {
		let count = target.ctx.storage.load("count").toInt<int>() + 1
		target.ctx.storage.save("count", "{count}")
		countedCalls = count
		// Read once more into a text, which takes the loaded value over.
		countedText = "calls: {target.ctx.storage.load("count")}"
	}

	// The same count as a text.
	let countedText = ""

	type Tally {
		@countCalls()
		def hit() {}
	}

	check "metadata store" {
		// A value reads back as often as it is loaded, whatever the caller does
		// with the copy it got.
		@test()
		def valuesReadBackAgain() {
			let tally = new Tally()
			let filler string[]
			for let i = 0; i < 20; i++ {
				tally.hit()
				// Strings of the value's size in between, where a copy freed by
				// a load would be reused.
				filler.push("{i % 10}")
			}
			assert countedCalls == 20 && countedText == "calls: 20"
			let store = metadata("std.reflection.test.store")
			store.save("count", "7")
			assert store.load("count") == "7" && store.load("count").toInt<int>() == 7
			store.delete("count")
			assert store.load("count") == ""
		}
	}
}
