partial module std.reflection {
	use std.testing

	// Records the detached call so a test can run it after the wrapper has
	// returned.
	let detached ?DetachedCall = none
	let detachedScope = ""

	meta def deferLater(target MethodMetaContext) {
		detachedScope = target.ctx.storage.scope()
		detached = target.detach()
	}

	meta def deferLater(target FunctionMetaContext) {
		detachedScope = target.ctx.storage.scope()
		detached = target.detach()
	}

	type Counter {
		total int

		@deferLater()
		def add(n int, label string) int {
			total += n
			return total
		}
	}

	type Bag {
		items int[]
	}

	let tallied = 0

	@deferLater()
	def tally(bag Bag) int {
		let sum = 0
		for let v in bag.items {
			sum += v
		}
		tallied = sum
		return sum
	}

	check "DetachedCall" {
		@test()
		def detachSkipsTheCaller() {
			detached = none
			let c = new Counter()
			assert c.add(5, "five") == 0
			assert c.total == 0
			assert !(detached is none)
		}

		@test()
		def invokeRunsTheBodyOnce() {
			detached = none
			let c = new Counter()
			c.add(3, "three")
			if detached is DetachedCall {
				assert detached.result() is none
				detached.invoke()
				assert c.total == 3
				detached.invoke()
				assert c.total == 3
				assert !detached.failed()
			}
		}

		@test()
		def argumentsOutliveTheCaller() {
			detached = none
			tallied = 0
			let bag = new Bag()
			bag.items = int[1, 2, 3]
			tally(bag)
			dispose bag
			assert tallied == 0
			if detached is DetachedCall {
				detached.invoke()
				assert tallied == 6
				assert !(detached.result() is none)
			}
		}

		@test()
		def storageMatchesTheFunction() {
			detached = none
			let c = new Counter()
			c.add(1, "one")
			if detached is DetachedCall {
				assert detachedScope != ""
				assert detached.storage.scope() == detachedScope
			}
		}
	}
}
