partial module std.reflection {
	enum ReflectionKind {
		Application,
		Library,
		Plugin,
		Module,
		Type,
		Struct,
		Enum,
		Union,
		Interface,
		Datatype,
		Service,
		Style,
		View,
		Component,
		Function,
		Method,
		Property,
		Field,
		Let,
		Const,
		Parameter,
		Check,
	}

	enum TypeKind {
		Primitive,
		Alias,
		Struct,
		Enum,
		Union,
		Interface,
		Datatype,
		Component,
		Service,
	}

	enum Visibility {
		Public,
		Internal,
	}

	enum StorageKind {
		Const,
		Let,
		Field,
		Property,
		Parameter,
	}

	struct SourcePosition {
		line   int
		column int
	}

	struct SourceSpan {
		file  string
		start SourcePosition
		end   SourcePosition
	}

	struct AttributeInfo {
		// name is the canonical (compiler-resolved) name of the annotation meta
		// function, not the local token text used at the call site.
		//
		// Example:
		// - Source: `use std.net.http; @get("/x")`
		// - name:   "std.net.http.get" (canonical), not "get"
		name      string
		// sig is the canonical signature of the meta function overload that was
		// resolved for this annotation.
		sig       string
		arguments map<string, any>
	}

	struct ReflectionNode {
		kind          ReflectionKind
		name          string
		qualifiedName string
		// signature is set for callable nodes (functions/methods) to disambiguate
		// overloads. For non-callable declarations this is empty.
		signature     string
		span          SourceSpan
		visibility    Visibility
		attributes    AttributeInfo[]
		parentNode    ReflectionNode
		moduleNode    ReflectionNode
	}

	struct GenericParamDescriptor {
		name      string
		bound     TypeDescriptor
		ownerType TypeDescriptor
	}

	struct TypeDescriptor {
		node       ReflectionNode
		kind       TypeKind
		generics   GenericParamDescriptor[]
		moduleNode ReflectionNode
	}

	struct ParameterDescriptor {
		node           ReflectionNode
		paramType      TypeDescriptor
		defaultLiteral string
		attributes     AttributeInfo[]
		variadic       bool
		functionRef    FunctionDescriptor
	}

	struct FunctionSignature {
		parameters ParameterDescriptor[]
		result     TypeDescriptor
		generics   GenericParamDescriptor[]
	}

	struct FunctionModifiers {
		isAtomic bool
		isAsync  bool
		isAsm    bool
		isCuda   bool
		isSql    bool
		isMeta   bool
		isInfix  bool
	}

	struct FunctionDescriptor {
		node       ReflectionNode
		signature  FunctionSignature
		modifiers  FunctionModifiers
		receiver   TypeDescriptor
		ownerType  TypeDescriptor
		moduleNode ReflectionNode
	}

	struct FieldDescriptor {
		node                ReflectionNode
		typeDescriptor      TypeDescriptor
		mutable             bool
		ownerTypeDescriptor TypeDescriptor
		moduleNode          ReflectionNode
	}

	struct PropertyDescriptor {
		node             ReflectionNode
		typeDescriptor   TypeDescriptor
		getterDescriptor FunctionDescriptor
		setterDescriptor FunctionDescriptor
		ownerDescriptor  TypeDescriptor
		moduleNode       ReflectionNode
	}

	struct VariableDescriptor {
		node           ReflectionNode
		typeDescriptor TypeDescriptor
		storage        StorageKind
		moduleNode     ReflectionNode
		parentNode     ReflectionNode
	}

	struct ConstDescriptor {
		variable VariableDescriptor
	}

	struct LetDescriptor {
		variable VariableDescriptor
	}

	struct ApplicationDescriptor {
		node        ReflectionNode
		entryPoints FunctionDescriptor[]
		moduleNode  ReflectionNode
	}

	struct LibraryDescriptor {
		node       ReflectionNode
		exports    ReflectionNode[]
		moduleNode ReflectionNode
	}

	struct PluginDescriptor {
		node       ReflectionNode
		exports    ReflectionNode[]
		moduleNode ReflectionNode
	}

	struct ServiceDescriptor {
		node       ReflectionNode
		handles    FunctionDescriptor[]
		moduleNode ReflectionNode
	}

	struct ComponentDescriptor {
		node       ReflectionNode
		properties PropertyDescriptor[]
		moduleNode ReflectionNode
	}

	interface DiagnosticSink {
		def error(message string)
		def warn(message string)
		def info(message string)
	}

	interface MetadataStore {
		def load(key string) string
		def save(key string, value string)
		def delete(key string)
		// The key prefix this store reads and writes under; `metadata(scope)`
		// opens the same store again.
		def scope() string
	}

	struct EmbeddedEntry {
		path string
		data byte[]
	}

	interface EmbeddedFileSystem {
		def readFile(path string) byte[]
		def readDir(path string) EmbeddedEntry[]
	}

	interface ValueEditor {
		def get() any
		def set(value any)
		def setLiteral(value string)
		def setBytes(data byte[])
		def clear()
	}

	// Coarse classification of a field's declared type, so a generic consumer --
	// a JSON codec, an ORM, a config binder -- can decide how to read a field
	// without parsing its type name. Values must match ADMFieldKind in
	// adm_runtime.h and ir.FieldKind in the compiler.
	// What sort of value a field holds. Struct covers anything with fields to
	// descend into, whether it was declared with `struct` or with `type`.
	enum FieldKind {
		Other,
		Bool,
		Int,
		Uint,
		Float,
		String,
		Array,
		Map,
		Struct,
		Iface,
		Optional,
		Enum
	}

	// Runtime interface reflection.
	// All runtime reflection entry points take `any` (which the compiler lowers
	// to a tagged runtime value).
	def typeName(value any) string;

	// Runtime FIELD reflection.
	//
	// Everything above describes declarations the compiler knows about. These
	// describe a live value: given anything carried as `any`, walk its fields,
	// read and write them, and read the annotations they carry.
	//
	// A field is addressed by INDEX, which is stable for the lifetime of the
	// program -- it is the declaration order of the type. Look one up by name
	// once with `fieldIndex` and reuse the index rather than matching names in
	// a loop.
	//
	// Values are read through kind-specific accessors rather than a single
	// boxing `get`, so reading an int costs a load rather than an allocation.
	// Use `fieldKind` to pick the right one.

	// Number of reflectable fields on the concrete type inside `value`.
	// Zero for values whose type has no struct layout, such as primitives.
	internal def fieldCount(value any) int;

	// Declared name, in declaration order.
	internal def fieldName(value any, index int) string;

	// Declared ADM type, e.g. "int", "string", "Point[]".
	internal def fieldTypeName(value any, index int) string;

	// Coarse classification: see FieldKind. Anything the compiler cannot
	// classify reads as FieldKind.Other, and `fieldTypeName` is the fallback.
	internal def fieldKind(value any, index int) int;

	// Index of the named field, or -1 when the type has no such field.
	internal def fieldIndex(value any, name string) int;

	// One named argument of one annotation on a field. `attr` is the qualified
	// meta function name, e.g. "std.data.encoding.json", and `key` is the
	// PARAMETER name it was passed under -- so `@json("X", omitempty: true)`
	// answers "X" for "name" and "true" for "omitempty", whether or not the
	// call site used named arguments. Empty string when absent.
	internal def fieldAttr(value any, index int, attr string, key string) string;

	// Whether a field carries the named annotation at all.
	internal def hasFieldAttr(value any, index int, attr string) bool;

	internal def fieldInt(value any, index int) int;

	internal def fieldUint(value any, index int) uint;

	internal def fieldFloat(value any, index int) float;

	internal def fieldBool(value any, index int) bool;

	internal def fieldString(value any, index int) string;

	// Only for fields already declared as `any`; anything else needs its own
	// type descriptor to box against and yields none.
	internal def fieldAny(value any, index int) any;

	internal def setFieldInt(value any, index int, val int) bool;

	internal def setFieldUint(value any, index int, val uint) bool;

	internal def setFieldFloat(value any, index int, val float) bool;

	internal def setFieldBool(value any, index int, val bool) bool;

	internal def setFieldString(value any, index int, val string) bool;

	// Allocates a zeroed instance of a registered type, boxed as `any`. How a
	// decoder materialises a value it knows only by name. None when the type
	// was not linked into the binary.
	internal def newInstance(typeName string) any;

	// Boxes a nested struct field, sharing the field's storage. With create
	// set, allocates the nested value when the field is still empty.
	internal def fieldValue(value any, index int, create bool) any;

	internal def fieldHasValue(value any, index int) bool;

	internal def fieldElemKind(value any, index int) int;

	internal def arrayLen(value any, index int) int;

	internal def arrayInt(value any, index int, at int) int;

	internal def arrayUint(value any, index int, at int) uint;

	internal def arrayFloat(value any, index int, at int) float;

	internal def arrayBool(value any, index int, at int) bool;

	internal def arrayString(value any, index int, at int) string;

	internal def arraySetLen(value any, index int, n int) bool;

	internal def setArrayInt(value any, index int, at int, val int) bool;

	internal def setArrayUint(value any, index int, at int, val uint) bool;

	internal def setArrayFloat(value any, index int, at int, val float) bool;

	internal def setArrayBool(value any, index int, at int, val bool) bool;

	internal def setArrayString(value any, index int, at int, val string) bool;

	// Returns every reflectable field of value, in declaration order.
	//
	//     for let (_, f) in reflection.fields(cfg) {
	//         println(f.name(), f.kind())
	//     }
	def fields(value any) Field[] {
		let out = Field[]
		let n = fieldCount(value)
		for let i = 0; i < n; i++ {
			out.push(new Field(value, i))
		}
		return out
	}

	// Returns the named field of value, or none when it has no such field.
	//
	//     let f = reflection.field(cfg, "port")
	//     if f is not none {
	//         f.setInt(8080)
	//     }
	def field(value any, name string) ?Field {
		let i = fieldIndex(value, name)
		return none when i < 0
		return new Field(value, i)
	}

	// One field of a value, or one element of an array field.
	//
	// Reads and writes go straight through to the value it came from, so a
	// Field is only valid while that value is.
	//
	//     let f = reflection.field(cfg, "tags") ?? none
	//     f.len()              // number of elements
	//     f.at(0).asString()   // element 0
	//     f.at(0).set("x")     // write element 0
	type Field {
		internal owner any
		internal index int
		// -1 addresses the field itself; >= 0 addresses one element of it.
		internal elem  int = -1

		def new(owner any, index int) {
			self.owner = owner
			self.index = index
			self.elem = -1
		}

		// Declared name of the field.
		name string {
			def get() string {
				return fieldName(owner, index)
			}
		}

		// Declared ADM type, such as "int" or "string[]".
		typeName string {
			def get() string {
				return fieldTypeName(owner, index)
			}
		}

		// What sort of value the field holds.
		kind FieldKind {
			def get() FieldKind {
				return FieldKind(fieldKind(owner, index))
			}
		}

		// For an array field, what its elements hold. Otherwise Other.
		elemKind FieldKind {
			def get() FieldKind {
				return FieldKind(fieldElemKind(owner, index))
			}
		}

		// Value of one argument of an annotation on this field, by the
		// annotation's qualified name and the parameter name. Empty when
		// absent.
		//
		//     f.attr("std.data.encoding.json", "name")
		def attr(annotation string, key string) string {
			return fieldAttr(owner, index, annotation, key)
		}

		// Reports whether the field carries the named annotation.
		def hasAttr(annotation string) bool {
			return hasFieldAttr(owner, index, annotation)
		}

		// Number of elements, for an array field.
		def len() int {
			return arrayLen(owner, index)
		}

		// Addresses one element of an array field. The result reads and writes
		// with the same methods as a scalar field.
		def at(i int) Field {
			let f = new Field(owner, index)
			f.elem = i
			return f
		}

		def asInt() int {
			return elem < 0 ?? (fieldInt(owner, index), arrayInt(owner, index, elem))
		}

		def asUint() uint {
			return elem < 0 ?? (fieldUint(owner, index), arrayUint(owner, index, elem))
		}

		def asFloat() float {
			return elem < 0 ?? (fieldFloat(owner, index), arrayFloat(owner, index, elem))
		}

		def asBool() bool {
			return elem < 0 ?? (fieldBool(owner, index), arrayBool(owner, index, elem))
		}

		def asString() string {
			return elem < 0 ?? (fieldString(owner, index), arrayString(owner, index, elem))
		}

		def setInt(val int) bool {
			return elem < 0 ?? (setFieldInt(owner, index, val), setArrayInt(owner, index, elem, val))
		}

		def setUint(val uint) bool {
			return elem < 0 ?? (setFieldUint(owner, index, val), setArrayUint(owner, index, elem, val))
		}

		def setFloat(val float) bool {
			return elem < 0 ?? (setFieldFloat(owner, index, val), setArrayFloat(owner, index, elem, val))
		}

		def setBool(val bool) bool {
			return elem < 0 ?? (setFieldBool(owner, index, val), setArrayBool(owner, index, elem, val))
		}

		def setString(val string) bool {
			return elem < 0 ?? (setFieldString(owner, index, val), setArrayString(owner, index, elem, val))
		}

		// Resizes an array field. New elements are zero.
		def setLen(n int) bool {
			return arraySetLen(owner, index, n)
		}

		// The nested value of a Struct field, sharing the field's storage:
		// what is written through it is written into the field. None when the
		// field is not a Struct, or is still empty.
		//
		//     for let (_, f) in reflection.fields(config) {
		//         if f.kind == FieldKind.Struct {
		//             let inner = f.value()
		//         }
		//     }
		def value() ?any {
			if !fieldHasValue(owner, index) {
				return none
			}
			return fieldValue(owner, index, false)
		}

		// The nested value of a Struct field, allocating it when the field is
		// still empty. This is what a decoder wants: it is about to fill the
		// value in. None when the field is not a Struct.
		def ensureValue() ?any {
			if kind != FieldKind.Struct {
				return none
			}
			return fieldValue(owner, index, true)
		}
	}

	def implementedInterfaces(value any) string[];

	def attributeNames(value any) string[];

	// Symbol reflection ------------------------------------------------------
	//
	// These helpers let user code refer to annotations by passing the meta
	// function itself, rather than relying on strings.

	// fnName returns the canonical qualified name for a function value.
	// The returned name is stable across import aliases.
	def fnName(fn any) string;

	// fnSig returns the canonical signature string for a function value.
	// This is intended for identity/binding and is not a pretty-printed type.
	def fnSig(fn any) string;

	// Program reflection -----------------------------------------------------
	//
	// These APIs enumerate declarations and annotations that were linked into
	// the current program. They are the foundation for "discovery" systems
	// implemented purely in ADM (e.g. HTTP routing, image format registries).

	// AttrHit is a concrete occurrence of an annotation on a declaration.
	struct AttrHit {
		node ReflectionNode
		attr AttributeInfo
	}

	// attrs returns all annotation occurrences in the current program.
	def attrs() AttrHit[];

	// attrs returns all annotation occurrences for declarations annotated by
	// the given meta function.
	//
	// Example:
	// - `use std.net.http`
	// - `let hits = reflection.attrs(http.get)`
	def attrs(metafn any) AttrHit[]; // overload

	// decls returns all declarations annotated by the given meta function.
	// This is a convenience wrapper over attrs.
	def decls(metafn any) ReflectionNode[];

	// Decl descriptors -------------------------------------------------------
	//
	// These helpers let you move from a ReflectionNode to a richer descriptor.
	// Returning `?T` avoids panics for mismatched kinds.

	def asType(node ReflectionNode) ?TypeDescriptor;

	def asFunction(node ReflectionNode) ?FunctionDescriptor;

	def asField(node ReflectionNode) ?FieldDescriptor;

	def asProperty(node ReflectionNode) ?PropertyDescriptor;

	def asVariable(node ReflectionNode) ?VariableDescriptor;

	// Invocation -------------------------------------------------------------
	//
	// These are intentionally untyped (accept `any` + `any[]`) so discovery
	// systems can be built without compiler hardcoding.

	// invoke calls a reflected function/method.
	// For methods, pass the receiver value as `recv`. For free functions, pass
	// `none` for recv.
	def invoke(fn FunctionDescriptor, recv any, args any[]) any;

	// call invokes a discovered function or method by node.
	// For free functions, pass `none` for recv.
	def call(node ReflectionNode, recv any, args any[]) any;

	// Type member enumeration ------------------------------------------------
	//
	// These APIs let discovery systems start from a type annotation (e.g. an
	// image decoder type) and then enumerate the type’s callable surface.

	// methods returns all methods declared on the given type that are linked into
	// the current program.
	def methods(typ TypeDescriptor) FunctionDescriptor[];

	// instantiate creates a new zero-initialized instance of the given type.
	//
	// This is intended for discovery systems that start from type annotations.
	// If the type cannot be instantiated at runtime, returns `none`.
	def instantiate(typ TypeDescriptor) any;

	// serviceInstance returns the singleton of the service with this qualified name
	// (for example "std.services.Cache") boxed as `any`, starting it on first
	// use the way a service reference does; `none` when no such service is
	// linked into the program.
	def serviceInstance(qualifiedName string) any;
}
