partial module std.reflection {
	use std.testing

	internal struct Point {
		x int
		y int
	}

	check "Reflection over any" {
		@test()
		def classifiesBareValues() {
			assert kindOf("x") == FieldKind.String
			assert kindOf(1) == FieldKind.Int
			assert kindOf(uint8(1)) == FieldKind.Uint
			assert kindOf(1.5) == FieldKind.Float
			assert kindOf(true) == FieldKind.Bool
			assert kindOf([1, 2]) == FieldKind.Array
			assert kindOf(map<string, int>{"a": 1}) == FieldKind.Map
			assert kindOf(Point{x: 1, y: 2}) == FieldKind.Struct
			// A container box carries its element's descriptor; the name wins.
			assert kindOf(map<string, Point>{"p": Point{x: 1, y: 2}}) == FieldKind.Map
			assert kindOf([Point{x:1, y:2}]) == FieldKind.Array
		}

		@test()
		def readsScalarsElementsAndEntries() {
			assert scalarText(42) == "42"
			assert scalarText(int16(-3)) == "-3"
			assert scalarText(2.5) == "2.5"
			assert scalarText(false) == "false"
			assert scalarText("s") == "s"
			assert scalarText([1]) == ""
			let mixed any[] = ["a", 1, true]
			let items = elements(mixed)
			assert items.len() == 3
			assert kindOf(items[0]) == FieldKind.String
			assert scalarText(items[1]) == "1"
			assert kindOf(items[2]) == FieldKind.Bool
			let points = elements([Point{x:1, y:2}, Point{x:3, y:4}])
			assert points.len() == 2
			assert kindOf(points[1]) == FieldKind.Struct
			assert fields(points[1]).len() == 2
			assert fields(points[1])[1].asInt() == 4
			let m = map<string, any>{"a": "x", "n": 7}
			assert keysOf(m).join(",") == "a,n"
			let n = entryOf(m, "n")
			assert !(n is none)
			if !(n is none) {
				assert scalarText(n) == "7"
			}
			assert entryOf(m, "missing") is none
			assert keysOf("not a map").len() == 0
			assert elements(3).len() == 0
		}

		@test()
		def fieldValueBoxesElementsAndAnyFields() {
			let bag = Sack{items: [Point{x:1, y:2}], values: map<string, any>{"k": "v"}, single: 9}
			let items = field(bag, "items")
			assert !(items is none)
			if !(items is none) {
				let first = items.at(0).value()
				assert !(first is none)
				if !(first is none) {
					assert fields(first)[0].asInt() == 1
				}
			}
			let values = field(bag, "values")
			assert !(values is none)
			if !(values is none) {
				let entry = values.entry("k").value()
				assert !(entry is none)
				if !(entry is none) {
					assert scalarText(entry) == "v"
				}
			}
			let single = field(bag, "single")
			assert !(single is none)
			if !(single is none) {
				let held = single.value()
				assert !(held is none)
				if !(held is none) {
					assert scalarText(held) == "9"
				}
			}
		}
	}

	internal struct Sack {
		items  Point[]
		values map<string, any>
		single any
	}
}
