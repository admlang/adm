partial module std.reflection {
	use std.testing

	internal struct Point {
		x int
		y int
	}

	internal struct KeyHeld {
		first string
	}

	// The first key of a map held as `any`, kept in a struct field.
	internal def firstKeyHeld(value any) KeyHeld {
		let out = KeyHeld{}
		for let (_, key) in keysOf(value) {
			out.first = key
			return out
		}
		return out
	}

	// A map whose key is made from bytes at run time, not a literal.
	internal def runtimeKeyedMap() any {
		let m = new map<string, any>()
		let bytes byte[] = [byte(97), byte(108), byte(112), byte(104), byte(97)]
		m.set(string(bytes), 1)
		return m
	}

	// How strongly a probe runs.
	internal enum Strength {
		// The lightest setting.
		Low,
		Mid = 2,
		High = 4,
		// The middle and high settings at once.
		Both = Mid | High,
	}

	// Marks a method the doc comment checks discover.
	internal meta def docProbe(ctx DiscoveryMetaContext<MethodMetaContext>) {}

	internal type Prober {
		// Probes a target.
		// @param target what to probe
		@docProbe()
		def probe(target string, strength Strength = Strength.High) string {
			return "{target}:{strength}"
		}
	}

	check "Doc comments and enum members" {
		@test()
		def exposesDocsAndDefaults() {
			let hits = attrs(docProbe)
			assert hits.len() == 1
			assert hits[0].node.doc == "Probes a target."
			let fn = asFunction(hits[0].node)
			if fn is none {
				assert false
				return
			}
			let params = fn.signature.parameters
			assert params[0].node.doc == "what to probe"
			assert params[0].defaultLiteral == ""
			assert params[1].node.doc == ""
			assert params[1].defaultLiteral == "Strength.High"
		}

		@test()
		def listsEnumMembersInOrder() {
			let fn = asFunction(attrs(docProbe)[0].node)
			if fn is none {
				assert false
				return
			}
			let list = members(fn.signature.parameters[1].paramType)
			assert list.len() == 4
			assert list[0].node.name == "Low"
			assert list[0].node.kind == ReflectionKind.EnumMember
			assert list[0].node.doc == "The lightest setting."
			assert list[2].node.name == "High"
			let args any[] = ["x", list[2].value]
			assert string(invoke(fn, new Prober(), args)) == "x:High"
			assert list[3].node.name == "Both"
			assert list[3].node.doc == "The middle and high settings at once."
			let both any[] = ["y", list[3].value]
			assert string(invoke(fn, new Prober(), both)) == "y:Both"
		}
	}

	check "Reflection over any" {
		@test()
		def classifiesBareValues() {
			assert kindOf("x") == FieldKind.String
			assert kindOf(1) == FieldKind.Int
			assert kindOf(uint8(1)) == FieldKind.Uint
			assert kindOf(1.5) == FieldKind.Float
			assert kindOf(true) == FieldKind.Bool
			assert kindOf([1, 2]) == FieldKind.Array
			assert kindOf(map<string, int>{"a": 1}) == FieldKind.Map
			assert kindOf(Point{x: 1, y: 2}) == FieldKind.Struct
			// A container box carries its element's descriptor; the name wins.
			assert kindOf(map<string, Point>{"p": Point{x: 1, y: 2}}) == FieldKind.Map
			assert kindOf([Point{x:1, y:2}]) == FieldKind.Array
		}

		@test()
		def readsScalarsElementsAndEntries() {
			assert scalarText(42) == "42"
			assert scalarText(int16(-3)) == "-3"
			assert scalarText(2.5) == "2.5"
			assert scalarText(false) == "false"
			assert scalarText("s") == "s"
			assert scalarText([1]) == ""
			let mixed any[] = ["a", 1, true]
			let items = elements(mixed)
			assert items.len() == 3
			assert kindOf(items[0]) == FieldKind.String
			assert scalarText(items[1]) == "1"
			assert kindOf(items[2]) == FieldKind.Bool
			let points = elements([Point{x:1, y:2}, Point{x:3, y:4}])
			assert points.len() == 2
			assert kindOf(points[1]) == FieldKind.Struct
			assert fields(points[1]).len() == 2
			assert fields(points[1])[1].asInt() == 4
			let m = map<string, any>{"a": "x", "n": 7}
			assert keysOf(m).join(",") == "a,n"
			let n = entryOf(m, "n")
			assert !(n is none)
			if !(n is none) {
				assert scalarText(n) == "7"
			}
			assert entryOf(m, "missing") is none
			assert keysOf("not a map").len() == 0
			assert elements(3).len() == 0
		}

		// A key comes back as a reference of its own: kept in a struct past
		// the array it came in, with more strings allocated after it, it
		// still reads the same (it was handed out without a retain).
		@test()
		def returnedKeysOutliveTheirArray() {
			let held = firstKeyHeld(runtimeKeyedMap())
			let noise string[]
			for let i = 0; i < 1000; i++ {
				noise.push("junk{i}")
			}
			assert held.first == "alpha"
		}

		@test()
		def fieldValueBoxesElementsAndAnyFields() {
			let bag = Sack{items: [Point{x:1, y:2}], values: map<string, any>{"k": "v"}, single: 9}
			let items = field(bag, "items")
			assert !(items is none)
			if !(items is none) {
				let first = items.at(0).value()
				assert !(first is none)
				if !(first is none) {
					assert fields(first)[0].asInt() == 1
				}
			}
			let values = field(bag, "values")
			assert !(values is none)
			if !(values is none) {
				let entry = values.entry("k").value()
				assert !(entry is none)
				if !(entry is none) {
					assert scalarText(entry) == "v"
				}
			}
			let single = field(bag, "single")
			assert !(single is none)
			if !(single is none) {
				let held = single.value()
				assert !(held is none)
				if !(held is none) {
					assert scalarText(held) == "9"
				}
			}
		}

		// An array of nested objects is sized with setLen, whose new slots
		// are empty, and filled element by element with ensureValue.
		@test()
		def arrayOfObjectsFillsThroughEnsureValue() {
			let bag = Sack{}
			let items = field(bag, "items")
			assert !(items is none)
			if !(items is none) {
				assert items.elemKind == FieldKind.Struct
				assert items.setLen(2)
				assert items.at(0).value() is none
				let made = items.at(1).ensureValue()
				assert !(made is none)
				if !(made is none) {
					assert fields(made)[0].setInt(7)
				}
				assert bag.items.len() == 2
				assert bag.items[1].x == 7
			}
		}

		// An optional field reads and writes its value through the same
		// accessors, reports none until set, and can be set back to none.
		@test()
		def optionalFieldsHoldValues() {
			let o = Optionals{}
			let a = field(o, "a")
			assert !(a is none)
			if !(a is none) {
				assert a.kind == FieldKind.Optional
				assert a.elemKind == FieldKind.Int
				assert a.value() is none
				assert a.setInt(5)
				assert !(o.a is none)
				let av = o.a
				if !(av is none) {
					assert av == 5
				}
				assert a.asInt() == 5
				let held = a.value()
				assert !(held is none)
				if !(held is none) {
					assert scalarText(held) == "5"
				}
				assert a.setNone()
				assert o.a is none
			}
			let s = field(o, "s")
			assert !(s is none)
			if !(s is none) {
				assert s.elemKind == FieldKind.String
				assert s.setString("x")
				assert !(o.s is none)
				let sv = o.s
				if !(sv is none) {
					assert sv == "x"
				}
				assert s.asString() == "x"
				assert s.setNone()
				assert o.s is none
			}
			let p = field(o, "p")
			assert !(p is none)
			if !(p is none) {
				assert p.elemKind == FieldKind.Struct
				assert p.value() is none
				let made = p.ensureValue()
				assert !(made is none)
				if !(made is none) {
					assert fields(made)[1].setInt(3)
				}
				assert !(o.p is none)
				let pv = o.p
				if !(pv is none) {
					assert pv.y == 3
				}
			}
			let e = field(o, "e")
			assert !(e is none)
			if !(e is none) {
				assert e.elemKind == FieldKind.Enum
				assert e.setInt(4)
				assert e.asString() == "High"
			}
			let plain = field(o, "plain")
			assert !(plain is none)
			if !(plain is none) {
				assert !plain.setNone()
			}
		}

		// An `any` field, element or entry takes a value through set.
		@test()
		def anyFieldsTakeValuesThroughSet() {
			let bag = Sack{}
			let single = field(bag, "single")
			assert !(single is none)
			if !(single is none) {
				assert single.set("hello")
				let held = single.value()
				assert !(held is none)
				if !(held is none) {
					assert scalarText(held) == "hello"
				}
			}
			let values = field(bag, "values")
			assert !(values is none)
			if !(values is none) {
				assert values.entry("n").set(5)
				let n = values.entry("n").value()
				assert !(n is none)
				if !(n is none) {
					assert scalarText(n) == "5"
				}
			}
		}

		// A struct value is stored whole into a field, element, entry or
		// optional payload declared with its type; another type is refused.
		@test()
		def setStoresStructValues() {
			let h = Holds{}
			let origin = field(h, "origin")
			assert !(origin is none)
			if !(origin is none) {
				assert origin.set(Point{x: 1, y: 2})
				assert h.origin.y == 2
				assert !origin.set("text")
				assert !origin.set(KeyHeld{first: "k"})
			}
			let maybe = field(h, "maybe")
			assert !(maybe is none)
			if !(maybe is none) {
				assert maybe.set(Point{x: 3, y: 4})
				let mv = h.maybe
				assert !(mv is none)
				if !(mv is none) {
					assert mv.x == 3
				}
			}
			let pts = field(h, "pts")
			assert !(pts is none)
			if !(pts is none) {
				assert pts.setLen(1)
				assert pts.at(0).set(Point{x: 5, y: 6})
				assert h.pts[0].x == 5
			}
			let byName = field(h, "byName")
			assert !(byName is none)
			if !(byName is none) {
				assert byName.entry("a").set(Point{x: 7, y: 8})
				assert byName.has("a")
			}
		}

		// A field's descriptor names its declared type; an element's, value's
		// or payload's names the type held, and an enum's lists its members.
		@test()
		def descriptorsOfFieldsAndValues() {
			let o = Optionals{}
			let e = field(o, "e")
			assert !(e is none)
			if !(e is none) {
				let held = e.elemDescriptor
				assert !(held is none)
				if !(held is none) {
					assert held.node.qualifiedName == "std.reflection.Strength"
					let all = members(held)
					assert all.len() == 4
					// A member's value is the boxed enum: kind Enum, text its
					// discriminant.
					assert kindOf(all[1].value) == FieldKind.Enum
					assert scalarText(all[1].value) == "2"
				}
			}
			let bag = Sack{}
			let items = field(bag, "items")
			assert !(items is none)
			if !(items is none) {
				let whole = items.descriptor
				assert !(whole is none)
				if !(whole is none) {
					assert whole.node.qualifiedName == "std.reflection.Point[]"
				}
				let elem = items.elemDescriptor
				assert !(elem is none)
				if !(elem is none) {
					assert elem.node.qualifiedName == "std.reflection.Point"
				}
			}
			let plain = field(o, "plain")
			assert !(plain is none)
			if !(plain is none) {
				assert plain.elemDescriptor is none
			}
			let own = descriptorOf(Point{x: 1, y: 1})
			assert !(own is none)
			if !(own is none) {
				assert own.node.qualifiedName == "std.reflection.Point"
			}
			let nothing any = none
			assert descriptorOf(nothing) is none
		}

		// An annotation argument naming an enum member reads back as the
		// member's name.
		@test()
		def enumAnnotationArgumentsReadByName() {
			let t = Tagged{}
			let v = field(t, "v")
			assert !(v is none)
			if !(v is none) {
				assert v.attr("std.reflection.probeTag", "n") == "3"
				assert v.attr("std.reflection.probeTag", "strength") == "High"
			}
		}
	}

	internal struct Sack {
		items  Point[]
		values map<string, any>
		single any
	}

	internal struct Holds {
		origin Point
		maybe  ?Point
		pts    Point[]
		byName map<string, Point>
	}

	internal struct Optionals {
		a     ?int
		s     ?string
		p     ?Point
		e     ?Strength
		plain int
	}

	// A field annotation taking an enum argument.
	internal meta def probeTag(ctx FieldMetaContext, n int = 0, strength Strength = Strength.Low) {}

	internal struct Tagged {
		@probeTag(n = 3, strength = Strength.High)
		v int
	}
}
