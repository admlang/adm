partial module std.reflection {
	use std.testing

	internal struct Point {
		x int
		y int
	}

	internal struct KeyHeld {
		first string
	}

	// The first key of a map held as `any`, kept in a struct field.
	internal def firstKeyHeld(value any) KeyHeld {
		let out = KeyHeld{}
		for let (_, key) in keysOf(value) {
			out.first = key
			return out
		}
		return out
	}

	// A map whose key is made from bytes at run time, not a literal.
	internal def runtimeKeyedMap() any {
		let m = new map<string, any>()
		let bytes byte[] = [byte(97), byte(108), byte(112), byte(104), byte(97)]
		m.set(string(bytes), 1)
		return m
	}

	// How strongly a probe runs.
	internal enum Strength {
		// The lightest setting.
		Low,
		Mid = 2,
		High = 4,
		// The middle and high settings at once.
		Both = Mid | High,
	}

	// Marks a method the doc comment checks discover.
	internal meta def docProbe(ctx DiscoveryMetaContext<MethodMetaContext>) {}

	internal type Prober {
		// Probes a target.
		// @param target what to probe
		@docProbe()
		def probe(target string, strength Strength = Strength.High) string {
			return "{target}:{strength}"
		}
	}

	check "Doc comments and enum members" {
		@test()
		def exposesDocsAndDefaults() {
			let hits = attrs(docProbe)
			assert hits.len() == 1
			assert hits[0].node.doc == "Probes a target."
			let fn = asFunction(hits[0].node)
			if fn is none {
				assert false
				return
			}
			let params = fn.signature.parameters
			assert params[0].node.doc == "what to probe"
			assert params[0].defaultLiteral == ""
			assert params[1].node.doc == ""
			assert params[1].defaultLiteral == "Strength.High"
		}

		@test()
		def listsEnumMembersInOrder() {
			let fn = asFunction(attrs(docProbe)[0].node)
			if fn is none {
				assert false
				return
			}
			let list = members(fn.signature.parameters[1].paramType)
			assert list.len() == 4
			assert list[0].node.name == "Low"
			assert list[0].node.kind == ReflectionKind.EnumMember
			assert list[0].node.doc == "The lightest setting."
			assert list[2].node.name == "High"
			let args any[] = ["x", list[2].value]
			assert string(invoke(fn, new Prober(), args)) == "x:High"
			assert list[3].node.name == "Both"
			assert list[3].node.doc == "The middle and high settings at once."
			let both any[] = ["y", list[3].value]
			assert string(invoke(fn, new Prober(), both)) == "y:Both"
		}
	}

	check "Reflection over any" {
		@test()
		def classifiesBareValues() {
			assert kindOf("x") == FieldKind.String
			assert kindOf(1) == FieldKind.Int
			assert kindOf(uint8(1)) == FieldKind.Uint
			assert kindOf(1.5) == FieldKind.Float
			assert kindOf(true) == FieldKind.Bool
			assert kindOf([1, 2]) == FieldKind.Array
			assert kindOf(map<string, int>{"a": 1}) == FieldKind.Map
			assert kindOf(Point{x: 1, y: 2}) == FieldKind.Struct
			// A container box carries its element's descriptor; the name wins.
			assert kindOf(map<string, Point>{"p": Point{x: 1, y: 2}}) == FieldKind.Map
			assert kindOf([Point{x:1, y:2}]) == FieldKind.Array
		}

		@test()
		def readsScalarsElementsAndEntries() {
			assert scalarText(42) == "42"
			assert scalarText(int16(-3)) == "-3"
			assert scalarText(2.5) == "2.5"
			assert scalarText(false) == "false"
			assert scalarText("s") == "s"
			assert scalarText([1]) == ""
			let mixed any[] = ["a", 1, true]
			let items = elements(mixed)
			assert items.len() == 3
			assert kindOf(items[0]) == FieldKind.String
			assert scalarText(items[1]) == "1"
			assert kindOf(items[2]) == FieldKind.Bool
			let points = elements([Point{x:1, y:2}, Point{x:3, y:4}])
			assert points.len() == 2
			assert kindOf(points[1]) == FieldKind.Struct
			assert fields(points[1]).len() == 2
			assert fields(points[1])[1].asInt() == 4
			let m = map<string, any>{"a": "x", "n": 7}
			assert keysOf(m).join(",") == "a,n"
			let n = entryOf(m, "n")
			assert !(n is none)
			if !(n is none) {
				assert scalarText(n) == "7"
			}
			assert entryOf(m, "missing") is none
			assert keysOf("not a map").len() == 0
			assert elements(3).len() == 0
		}

		// A key comes back as a reference of its own: kept in a struct past
		// the array it came in, with more strings allocated after it, it
		// still reads the same (it was handed out without a retain).
		@test()
		def returnedKeysOutliveTheirArray() {
			let held = firstKeyHeld(runtimeKeyedMap())
			let noise string[]
			for let i = 0; i < 1000; i++ {
				noise.push("junk{i}")
			}
			assert held.first == "alpha"
		}

		@test()
		def fieldValueBoxesElementsAndAnyFields() {
			let bag = Sack{items: [Point{x:1, y:2}], values: map<string, any>{"k": "v"}, single: 9}
			let items = field(bag, "items")
			assert !(items is none)
			if !(items is none) {
				let first = items.at(0).value()
				assert !(first is none)
				if !(first is none) {
					assert fields(first)[0].asInt() == 1
				}
			}
			let values = field(bag, "values")
			assert !(values is none)
			if !(values is none) {
				let entry = values.entry("k").value()
				assert !(entry is none)
				if !(entry is none) {
					assert scalarText(entry) == "v"
				}
			}
			let single = field(bag, "single")
			assert !(single is none)
			if !(single is none) {
				let held = single.value()
				assert !(held is none)
				if !(held is none) {
					assert scalarText(held) == "9"
				}
			}
		}
	}

	internal struct Sack {
		items  Point[]
		values map<string, any>
		single any
	}
}
