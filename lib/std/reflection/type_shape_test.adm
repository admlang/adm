partial module std.reflection {
	use std.testing

	struct ShapeItem {
		name string
	}

	enum ShapeColor {
		Red,
		Green,
	}

	struct ShapeHolder {
		maybe ?int[]
		rows  map<string, ShapeItem[]>
	}

	// A descriptor as text: the flags, the kind, then what the type names.
	def shapeText(t TypeDescriptor) string {
		let flags = ""
		flags = "{flags}async " when t.future
		flags = "{flags}!" when t.errorable
		flags = "{flags}?" when t.optional
		match t.kind {
			case TypeKind.Array:
				let of = t.element
				return "{flags}Array" when of is none
				return "{flags}Array({shapeText(of)})"
			case TypeKind.Map:
				let k = t.key
				let v = t.element
				return "{flags}Map" when k is none || v is none
				return "{flags}Map({shapeText(k)}, {shapeText(v)})"
			case TypeKind.Tuple:
				let parts string[]
				for let e in t.elements {
					parts.push(shapeText(e))
				}
				return "{flags}Tuple({parts.join(", ")})"
			case TypeKind.Function:
				return "{flags}Function"
			case TypeKind.Union:
				return "{flags}Union"
			case TypeKind.Intersection:
				return "{flags}Intersection"
			case TypeKind.Struct:
				return "{flags}Struct {t.node.name}"
			case TypeKind.Enum:
				return "{flags}Enum {t.node.name}"
			default:
				// A prelude type is named with its module (`builtin.string`).
				return "{flags}{t.typeName.trimPrefix("builtin.")}"
		}
	}

	// Resolves the shape of the declaration's result and parameters.
	meta def shapeDescribes(target FunctionMetaContext) {
		let d = target.descriptor
		let parts string[]
		parts.push(shapeText(d.signature.result))
		for let p in d.signature.parameters {
			parts.push(shapeText(p.paramType))
		}
		target.resolve(parts.join("; "))
	}

	// Resolves how many members the first parameter's type lists.
	meta def shapeCountsMembers(target FunctionMetaContext) {
		target.resolve(members(target.descriptor.signature.parameters[0].paramType).len())
	}

	@shapeDescribes()
	def shapePlain(count int, item ShapeItem, color ShapeColor) string;

	@shapeDescribes()
	def shapeWrapped(limit ?int, items !ShapeItem[], colors ?ShapeColor[]) !?string;

	@shapeDescribes()
	def shapeContainers(byName map<string, ShapeItem[]>, nested int[][], holes array<?int>) string;

	@shapeDescribes()
	def shapeTuples(pair (int, ?string), rows map<string, (int, ShapeItem)>[]) string;

	@shapeDescribes()
	def shapeOthers(run def(int) int[], either int | string, grouped (int | string)[]) string;

	@shapeCountsMembers()
	def shapeMembers(color ?ShapeColor) int;

	check "TypeShapes" {
		@test()
		def namedTypesKeepTheirKind() {
			assert shapePlain(1, ShapeItem{}, ShapeColor.Red) == "string; int; Struct ShapeItem; Enum ShapeColor"
		}

		@test()
		def modifiersAreFlags() {
			let text = shapeWrapped(none, [], none) onerror recover "failed"
			assert !(text is none)
			if !(text is none) {
				assert text == "!?string; ?int; !Array(Struct ShapeItem); ?Array(Enum ShapeColor)"
			}
		}

		@test()
		def arraysAndMapsNameTheirElements() {
			let byName map<string, ShapeItem[]>
			assert shapeContainers(byName, [], []) == "string; Map(string, Array(Struct ShapeItem)); Array(Array(int)); Array(?int)"
		}

		@test()
		def tuplesListTheirElements() {
			assert shapeTuples((1, none), []) == "string; Tuple(int, ?string); Array(Map(string, Tuple(int, Struct ShapeItem)))"
		}

		@test()
		def functionsAndUnions() {
			assert shapeOthers(v => [v], 1, []) == "string; Function; Union; Array(Union)"
		}

		@test()
		def membersLookUnderModifiers() {
			assert shapeMembers(none) == 2
		}

		@test()
		def fieldDescriptorsCarryTheShape() {
			let holder = ShapeHolder{}
			let maybe = field(holder, "maybe")
			assert !(maybe is none)
			if !(maybe is none) {
				let whole = maybe.descriptor
				assert !(whole is none)
				if !(whole is none) {
					assert shapeText(whole) == "?Array(int)"
				}
				// The payload of an optional array is the array.
				let held = maybe.elemDescriptor
				assert !(held is none)
				if !(held is none) {
					assert shapeText(held) == "Array(int)"
				}
			}
			let rows = field(holder, "rows")
			assert !(rows is none)
			if !(rows is none) {
				let whole = rows.descriptor
				assert !(whole is none)
				if !(whole is none) {
					assert shapeText(whole) == "Map(string, Array(Struct ShapeItem))"
				}
				let value = rows.elemDescriptor
				assert !(value is none)
				if !(value is none) {
					assert shapeText(value) == "Array(Struct ShapeItem)"
				}
			}
			let own = descriptorOf(ShapeItem{})
			assert !(own is none)
			if !(own is none) {
				assert own.kind == TypeKind.Struct
				assert !own.optional && !own.errorable && !own.future
				assert own.element is none && own.key is none && own.elements.len() == 0
			}
		}
	}
}
