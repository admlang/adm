partial module std.services {
	use (
		std.data.semver
		std.reflection
		std.time::(Time)
	)

	// Marks a step that upgrades the application's home folder from one
	// version to another; see `Application.home()`.
	//
	// `from` is the version whose data the step understands; `to` is the
	// version it produces, or the next declared step's `from` when omitted.
	// Steps run in ascending order, and only those whose `to` is newer than
	// the version that last ran the folder. The annotated function takes the
	// home folder path and returns `!none`:
	//
	//     @migration(from = "3.54", to = "4.0")
	//     def settingsToJson(home string) !none { ... }
	meta def migration(ctx reflection.DiscoveryMetaContext<reflection.FunctionMetaContext>, from string, to string = "") {}

	// Lets the application open a home folder last written by a newer version
	// of itself. Without it, a downgrade fails in `Application.home()`.
	meta def allowDowngrade(ctx reflection.DiscoveryMetaContext<reflection.ApplicationMetaContext>) {}

	service Application {
		description           = ""
		dependencies          = Dependencies{
			hard: [Runtime],
			soft: []
		}
		lifecycle             = Lifecycle{
			start: StartMode.Automatic,
			restart: RestartMode.Always,
		}
		permissions  string[]

		def config<T>(val T) !none {}

		async def start() !none {
			return none
		}

		async def stop() !none {
			return none
		}

		async def restart() !none {
			return none
		}

		// Returns process id of the application
		@query()
		def pid() int {
			return __proc_pid()
		}

		// Returns path to the application executable.
		@query()
		def executablePath() string {
			return __proc_executable_path()
		}

		// Returns time when the application process started.
		@query()
		def startTime() Time {
			return new Time(duration(__proc_start_wall_ns()), duration(__proc_start_mono_ns()))
		}

		// Returns the name the application is known by: the `adm.toml` slug when
		// one is configured, else the declared application name.
		@query()
		def name() string {
			return __app_name__
		}

		// Returns the application version from `adm.toml`, or `0.1` when the
		// application is not versioned.
		@query()
		def version() string {
			return __app_version__
		}

		// Returns the per-user folder this application owns, creating it on
		// first use. Secrets (Vault), plugins, configuration and caches live
		// under it, so an application never writes anywhere else. It sits in
		// the platform's application-data location, named after the app:
		//
		//     Linux    $XDG_DATA_HOME/<name>, default ~/.local/share/<name>
		//     macOS    ~/Library/Application Support/<name>
		//     Windows  %APPDATA%\<name>
		//
		// `ADM_APP_HOME`, when set, names the folder directly (portable
		// installs, tests). A folder that already exists there with contents
		// but no `version` marker belongs to something else and is refused,
		// never adopted or overwritten.
		//
		// The first call also brings the folder up to date with this version:
		//
		//     version        last version that used the folder
		//     data/          the application's own files
		//     backup/<ver>/  snapshot of data/ taken before migrating from <ver>
		//
		// A folder last used by an older version has `data/` snapshotted to
		// `backup/<old>/`, then every `@migration` step newer than `<old>` runs
		// in order; a failing step restores the snapshot and fails this call.
		// A folder last used by a newer version fails unless the application is
		// annotated `@allowDowngrade`. Fails when no home directory is known
		// (`HOME`, or `USERPROFILE` on Windows).
		@commit()
		def home() !string {
			let dir = try homeDir()
			// Filesystem intrinsics rather than Storage: Storage depends on Policy,
			// which depends on Application, so a Storage dependency here would be
			// a cycle.
			if try __fs_exists(dir) {
				try ensureOwnHome(dir) unless homeUpgraded
			} else {
				try mkdirAll(dir)
			}
			try upgradeHome(dir) unless homeUpgraded
			homeUpgraded = true
			return dir
		}

		internal homeUpgraded bool

		// Fails when `dir` holds files but no `version` marker: it belongs to
		// some other program that happens to share the name.
		internal def ensureOwnHome(dir string) !none {
			return none when try __fs_exists(dir + "/version")
			let entries = try __fs_read_dir(dir)
			return none when entries.len() == 0
			fail "Application.home: {dir} already exists and is not an ADM application folder (no version marker); set ADM_APP_HOME to use another location"
		}

		internal def homeDir() !string {
			let override = Runtime.getEnv("ADM_APP_HOME")
			if !(override is none) {
				let dir string = override
				return dir when dir != ""
			}
			let base = try appDataDir()
			return base + "/" + __app_name__
		}

		// The platform's per-user application-data directory.
		internal def appDataDir() !string {
			if __os__ == "windows" {
				let appData = Runtime.getEnv("APPDATA")
				if !(appData is none) {
					let dir string = appData
					return dir when dir != ""
				}
				let profile = Runtime.getEnv("USERPROFILE")
				fail "Application.home: neither APPDATA nor USERPROFILE is set" when profile is none
				return profile + "\\AppData\\Roaming"
			}
			if __os__ == "linux" {
				let xdg = Runtime.getEnv("XDG_DATA_HOME")
				if !(xdg is none) {
					let dir string = xdg
					return dir when dir != ""
				}
			}
			let home = Runtime.getEnv("HOME")
			fail "Application.home: HOME is not set" when home is none
			return home + "/Library/Application Support" when __os__ == "darwin"
			return home + "/.local/share"
		}

		// Runs the version protocol described on `home()`.
		internal def upgradeHome(dir string) !none {
			let marker = dir + "/version"
			let current = __app_version__
			if !(try __fs_exists(marker)) {
				return __fs_write_all(marker, current.bytes())
			}
			let previous = string(try __fs_read_all(marker)).trim()
			return none when previous == current || previous == ""
			if compareVersions(previous, current) > 0 {
				fail "{__app_name__} {current} cannot open a home folder last used by version {previous}; annotate the application with @allowDowngrade to permit it" unless downgradeAllowed()
				return __fs_write_all(marker, current.bytes())
			}
			let data = dir + "/data"
			let backup = dir + "/backup/" + previous
			let hasData = try __fs_exists(data)
			if hasData {
				try removeTree(backup) when try __fs_exists(backup)
				try copyTree(data, backup)
			}
			let failed = runMigrations(previous, current, dir)
			if failed is error {
				if hasData {
					try removeTree(data)
					try copyTree(backup, data)
				}
				return failed
			}
			return __fs_write_all(marker, current.bytes())
		}

		internal def downgradeAllowed() bool {
			return reflection.attrs(allowDowngrade).len() > 0
		}

		// Runs, in ascending `from` order, every `@migration` step whose `to` is
		// newer than `previous` and whose `from` is older than `current`.
		internal def runMigrations(previous string, current string, dir string) !none {
			let hits = reflection.attrs(migration)
			let froms string[]
			let tos string[]
			for let (_, hit) in hits {
				froms.push(attrText(hit, "from"))
				tos.push(attrText(hit, "to"))
			}
			// Selection sort by `from`; migration lists are short.
			let order int[]
			let taken bool[]
			for let i = 0; i < hits.len(); i++ {
				taken.push(false)
			}
			for let n = 0; n < hits.len(); n++ {
				let best = -1
				for let i = 0; i < hits.len(); i++ {
					continue when taken[i]
					best = i when best < 0 || compareVersions(froms[i], froms[best]) < 0
				}
				taken[best] = true
				order.push(best)
			}
			for let k = 0; k < order.len(); k++ {
				let i = order[k]
				let to = tos[i]
				if to == "" {
					to = current
					to = froms[order[k + 1]] when k + 1 < order.len()
				}
				continue unless compareVersions(to, previous) > 0 && compareVersions(froms[i], current) < 0
				// Built as `any[]` explicitly: an array literal passed straight to an
				// `any[]` parameter keeps its elements unboxed today.
				let args any[]
				args.push(dir)
				let result = reflection.call(hits[i].node, none, args)
				fail "migration {froms[i]} -> {to} ({hits[i].node.qualifiedName}) failed: {result}" when result is error
			}
			return none
		}

		// An annotation argument as plain text: string literals arrive as their
		// source text, so surrounding quotes are dropped.
		internal def attrText(hit reflection.AttrHit, name string) string {
			let v = hit.attr.arguments.valueOf(name)
			return "" when v is none
			let text = string(v).trim()
			if text.len() >= 2 && text.startsWith("\"") && text.endsWith("\"") {
				text = text[1:text.len() - 1]
			}
			return text
		}

		// Orders two version strings. Semantic versions compare as semver
		// (`1.0.0-rc.1` < `1.0.0`, build metadata ignored); a string semver
		// rejects falls back to a numeric part-by-part comparison. Returns
		// negative, zero or positive.
		internal def compareVersions(a string, b string) int {
			let result = compareSemver(a, b) onerror recover compareParts(a, b)
			return result
		}

		internal def compareSemver(a string, b string) !int {
			let va = try semver.parse(a)
			let vb = try semver.parse(b)
			return semver.compare(va, vb)
		}

		// Compares dotted version strings numerically part by part ("3.54" <
		// "4.0" < "4.0.1"); a non-numeric part compares as text.
		internal def compareParts(a string, b string) int {
			let pa = a.trim().split(".")
			let pb = b.trim().split(".")
			let n = pa.len()
			n = pb.len() when pb.len() > n
			for let i = 0; i < n; i++ {
				let x = "0"
				let y = "0"
				x = pa[i] when i < pa.len()
				y = pb[i] when i < pb.len()
				if !x.isNumeric() || !y.isNumeric() {
					continue when x == y
					return -1 when x < y
					return 1
				}
				let xv = x.toInt<int>()
				let yv = y.toInt<int>()
				continue when xv == yv
				return -1 when xv < yv
				return 1
			}
			return 0
		}

		// Creates a directory and any missing parents.
		internal def mkdirAll(path string) !none {
			return none when path == "" || try __fs_exists(path)
			let cut = -1
			for let i = path.len() - 1; i >= 0; i-- {
				if path[i] == '/' {
					cut = i
					break
				}
			}
			try mkdirAll(path[:cut]) when cut > 0
			return __fs_mkdir(path)
		}

		// Copies a directory tree; `dst` and its parents are created.
		internal def copyTree(src string, dst string) !none {
			try mkdirAll(dst)
			for let (_, name) in try __fs_read_dir(src) {
				let from = src + "/" + name
				let to = dst + "/" + name
				let (_, _, isDir, _) = try __fs_stat(from)
				if isDir {
					try copyTree(from, to)
				} else {
					try __fs_write_all(to, try __fs_read_all(from))
				}
			}
			return none
		}

		// Deletes a directory tree.
		internal def removeTree(path string) !none {
			for let (_, name) in try __fs_read_dir(path) {
				let child = path + "/" + name
				let (_, _, isDir, _) = try __fs_stat(child)
				if isDir {
					try removeTree(child)
				} else {
					try __fs_remove(child)
				}
			}
			return __fs_rmdir(path)
		}

		// Returns application build number, or an empty string if unavailable.
		@query()
		def build() string {
			return ""
		}

		// Returns identifier of the current application instance.
		//
		// The identifier is unique to this running instance and changes between runs.
		@query()
		def instanceId() string {
			return ""
		}

		// Returns command-line arguments passed to the application.
		@query()
		def arguments() string[] {
			return string[]
		}

		// Returns how long the application has been running.
		@query()
		def uptime() duration {
			return duration(__proc_uptime_ns())
		}

		// Requests graceful application shutdown.
		@commit()
		def shutdown(code int = 0) !none {
			return none
		}

		// Returns whether graceful application shutdown has been requested.
		@query()
		def shuttingDown() bool {
			return false
		}

		// Emitted when graceful application shutdown is requested.
		@emit()
		def shutdownRequested(code int) int {
			return 0
		}

		// Terminates the application using the specified exit code.
		@commit()
		def exit(code int) {
			__proc_exit(code)
		}
	}
}
