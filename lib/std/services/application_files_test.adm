partial module std.services {
	use (
		std.testing
		std.os
	)

	check "Application files" {
		// A test binary's "application" is the tree it was built from, so the
		// development folder resolves to an existing directory.
		@test()
		def TestFilesOfTheProgramExist() !none {
			let dir = try Application.files()
			assert dir.len() > 0
			assert try __fs_exists(dir)
			return none
		}

		@test()
		def TestPackagePathResolves() !none {
			let dir = try Application.files()
			assert try Application.filePath("package://assets/logo.png") == dir + "/assets/logo.png"
			assert try Application.filePath("package://") == dir
			assert try Application.filePath("/etc/hosts") == "/etc/hosts"
			assert try Application.filePath("relative/file.txt") == "relative/file.txt"
			assert try Application.filePath("https://example.com/x") == "https://example.com/x"
			return none
		}

		// A test binary runs from a scratch folder while its files are in the
		// tree it was built from: the folder that holds the file is taken.
		@test()
		def TestPackagePathFindsTheFolderThatHoldsTheFile() !none {
			let tree = ""
			for let entry in __package_dirs__.split(";") {
				tree = entry[__app_name__.len() + 1:] when entry.startsWith(__app_name__ + "=")
			}
			assert tree != ""
			// The first file found going down the tree: the root itself may
			// hold only folders (`adm test std`).
			let name = ""
			let below = ""
			for let depth = 0; depth < 8 && name == ""; depth++ {
				let next = ""
				for let entry in try os.readDir(tree + below) {
					if entry.info.isDir {
						next = entry.info.name
					} else {
						name = below + "/" + entry.info.name
					}
				}
				below += "/" + next
			}
			assert name != ""
			assert try Application.filePath("package:/" + name) == tree + name
			// A file no folder holds is in the folder `files` answers.
			assert try Application.filePath("package://no/such.file") == (try Application.files()) + "/no/such.file"
			return none
		}

		@test()
		def TestUnknownPackageFails() !none {
			let message = ""
			Application.files("nobody:missing") onerror (err error) {
				message = err.message
				recover ""
			}
			assert message.contains("no shipped files for nobody:missing")
			assert message.contains("share/nobody/missing")
			return none
		}

		// std.os goes through Storage, which resolves the same way.
		@test()
		def TestOsSeesPackagePaths() !none {
			assert !(try os.exists("package://no/such/file"))
			let failed = false
			os.exists("nobody:missing://a") onerror (err error) {
				failed = true
				recover false
			}
			assert failed
			return none
		}
	}
}
