// The Application service's IDE panel: what the program is and how long it
// has run, and the button that shuts it down.

partial module std.services {
	use std.ide::(ide, IdeKind, IdeTable, hiddenValue, secretShaped)

	partial service Application {
		@ide(kind = IdeKind.Value, label = "Name", refresh = 60s)
		def ideName() string {
			return name()
		}

		@ide(kind = IdeKind.Value, label = "Version", refresh = 60s)
		def ideVersion() string {
			return version()
		}

		@ide(kind = IdeKind.Value, label = "Build", refresh = 60s)
		def ideBuild() string {
			return build()
		}

		@ide(kind = IdeKind.Value, label = "PID", refresh = 60s)
		def idePid() int {
			return pid()
		}

		@ide(kind = IdeKind.Value, label = "Up for", refresh = 1s)
		def ideUptime() duration {
			return uptime()
		}

		// The folder the program keeps its files in, "" when it has none yet.
		@ide(kind = IdeKind.Value, label = "Home", refresh = 10s)
		def ideHome() string {
			return homePath() onerror recover ""
		}

		// The command line; an argument that looks like it carries a secret
		// (`--token=...`) is hidden.
		@ide(kind = IdeKind.Table, label = "Arguments", refresh = 60s, rows = 6)
		def ideArguments() IdeTable {
			let rows = string[][]
			for let (i, arg) in arguments() {
				rows.push(["{i}", secretShaped(arg) ?? (hiddenValue(arg), arg)])
			}
			return IdeTable{columns: ["#", "Argument"], rows: rows}
		}

		// Shuts the program down as a signal would, with the exit code given.
		@ide(kind = IdeKind.Action, label = "Shut down", confirm = "Shut the program down?")
		def ideShutdown(code int = 0) !none {
			return shutdown(code)
		}
	}
}
