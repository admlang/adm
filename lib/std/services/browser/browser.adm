partial module std.services.browser {
	use (
		std.services::(Dependencies, Lifecycle, RestartMode, ServiceStatus, StartMode)
		std.services.policy::(Policy)
		std.data.encoding::(JSON)
		std.errors
		std.gfx.color::(Color)
		std.net.url
		std.time
	)

	// Why a `Browser` call failed.
	enum BrowserError {
		// Not running in a browser.
		Unavailable,
		// The browser lacks the feature.
		Unsupported,
		// The user or the browser refused.
		Denied,
		// The call needs a click or key press to have just happened.
		NeedsUserGesture,
	}

	// The payload of every `Browser` failure. `code` is the name of `kind`; a
	// handler that narrows with `err is BrowserFailure` reads `kind` and the
	// operation.
	struct BrowserFailure {
		message string
		code    string
		cause   ?error
		stack   errors.StackTrace
		kind    BrowserError
		// The call that failed: "location", "setCookie", ...
		op      string
	}

	// What the browser answers when asked about a permission.
	enum PermissionState {
		Granted,
		Denied,
		Prompt,
	}

	// Whether a cookie goes with requests other sites start.
	enum SameSite {
		Lax,
		Strict,
		None,
	}

	// A cookie of this site.
	struct Cookie {
		name     string
		value    string
		path     string     = "/"
		domain   string     = ""
		// none: a session cookie, gone when the browser closes.
		expires  ?time.Time = none
		secure   bool       = true
		sameSite SameSite   = SameSite.Lax
	}

	// What goes in the document's head.
	struct PageMetadata {
		title       string              = ""
		description string              = ""
		canonical   string              = ""
		// The picture a link to the page shows when shared.
		image       string              = ""
		language    string              = ""
		robots      string              = ""
		themeColor  ?Color              = none
		// Further <meta name=…> pairs.
		extra       map<string, string> = {}
	}

	// The browser the program runs in.
	struct BrowserInfo {
		name, version, engine, platform string
		languages                       string[]
		mobile                          bool
		// Running as an installed web app.
		standalone                      bool
	}

	// Controls the browser a web program runs in (`adm build --os wasm`): its
	// address and history, the document's head, cookies and storage, the
	// permissions it granted, installing the site as an app. Other services
	// reach the browser through it on the web; off the web every call fails
	// with `BrowserError.Unavailable` and `available()` is false.
	partial service Browser {
		description  = "The browser a web program runs in"
		dependencies = Dependencies{
			hard: [Policy]
		}
		lifecycle    = Lifecycle{
			start: StartMode.Manual,
			restart: RestartMode.Always,
		}
		permissions  = [
			Permission{name: "cookies", description: "Read and write this site's cookies"},
			Permission{name: "storage", description: "Read and write this site's browser storage"},
			Permission{name: "install", description: "Offer to install the site as an app"},
			Permission{name: "script", description: "Run JavaScript in the page"},
		]

		internal watching bool

		// Starts the service: from here on `locationChange` and `updateReady`
		// are emitted. Does not fail.
		async def start() !none {
			status = ServiceStatus.Started
			if available() && !watching {
				watching = true
				async watchLocation()
				async watchUpdates()
			}
			return none
		}

		// Stops the service. Does not fail.
		async def stop() !none {
			status = ServiceStatus.Stopped
			watching = false
			return none
		}

		// Stops the service and starts it again. Does not fail.
		async def restart() !none {
			status = ServiceStatus.Restarting
			try await stop()
			try await start()
			return none
		}

		// Whether the program runs in a browser.
		@query()
		def available() bool {
			return __os__ == "wasm"
		}

		// The browser, its version and engine, the platform it runs on and the
		// user's languages, preferred first.
		//
		// Fails off the web.
		@query()
		def info() !BrowserInfo {
			let out = BrowserInfo{}
			try decodeAnswer(try call("info"), out)
			return out
		}

		// --- address and history ---

		// The page's address.
		//
		// Fails off the web.
		@query()
		def location() !url.URL {
			return try url.parse(try textAnswer(try call("location")))
		}

		// Navigates the tab away to `to`, a full page load that ends the
		// program; `replace` leaves no history entry behind. In-app navigation
		// is the Router's.
		//
		// Fails off the web.
		@commit()
		def navigate(to url.URL, replace bool = false) !none {
			let _ = try call("navigate", encode(NavigateArgs{to: to.str(), replace: replace}))
			return none
		}

		// Goes one entry back in the tab's history.
		//
		// Fails off the web.
		@commit()
		def back() !none {
			let _ = try call("back")
			return none
		}

		// Goes one entry forward in the tab's history.
		//
		// Fails off the web.
		@commit()
		def forward() !none {
			let _ = try call("forward")
			return none
		}

		// Loads the page again, which starts the program afresh.
		//
		// Fails off the web.
		@commit()
		def reload() !none {
			let _ = try call("reload")
			return none
		}

		// The history entry changed: back or forward, or in-app navigation.
		@emit()
		def locationChange(to url.URL) url.URL {
			return to
		}

		// --- document ---

		// What the document's head holds.
		//
		// Fails off the web.
		@query()
		def metadata() !PageMetadata {
			let raw = MetadataArgs{}
			try decodeAnswer(try call("metadata"), raw)
			let out = PageMetadata{title: raw.title, description: raw.description, canonical: raw.canonical, image: raw.image, language: raw.language, robots: raw.robots, extra: raw.extra}
			out.themeColor = new Color(raw.themeColor) unless raw.themeColor == ""
			return out
		}

		// Writes the document's head: title, description, canonical address,
		// sharing picture, language, robots and theme colour, and the further
		// <meta> pairs. An empty field removes what the head had for it.
		//
		// Fails off the web.
		@commit()
		def setMetadata(metadata PageMetadata) !none {
			let raw = MetadataArgs{title: metadata.title, description: metadata.description, canonical: metadata.canonical, image: metadata.image, language: metadata.language, robots: metadata.robots, extra: metadata.extra}
			let theme = metadata.themeColor
			raw.themeColor = theme.hex.code unless theme is none
			let _ = try call("setMetadata", encode(raw))
			return none
		}

		// Makes the browser ask before the tab is closed or navigated away
		// (unsaved changes), or stop asking.
		//
		// Fails off the web.
		@commit()
		def confirmLeave(on bool) !none {
			let _ = try call("confirmLeave", encode(SwitchArgs{on: on}))
			return none
		}

		// --- cookies and web storage ---

		// The cookie called `name`, none when the site has none. The browser
		// tells a page a cookie's name and value only.
		//
		// Fails off the web, or when the policy denies `cookies`.
		@query(policy = "cookies")
		def cookie(name string) !?Cookie {
			for let found in try cookies() {
				return found when found.name == name
			}
			return none
		}

		// The site's cookies the page can read (not the HttpOnly ones).
		//
		// Fails off the web, or when the policy denies `cookies`.
		@query(policy = "cookies")
		def cookies() !Cookie[] {
			let raw = CookiesAnswer{}
			try decodeAnswer(try call("cookies"), raw)
			let out Cookie[]
			for let pair in raw.value {
				out.push(Cookie{name: pair.name, value: pair.value})
			}
			return out
		}

		// Sets a cookie, or replaces the one of that name and path.
		//
		// Fails off the web, when the policy denies `cookies`, or when the
		// browser refuses the cookie.
		@commit(policy = "cookies")
		def setCookie(cookie Cookie) !none {
			let _ = try call("setCookie", encode(TextArgs{text: cookieText(cookie)}))
			return none
		}

		// Removes the cookie called `name` at `path`.
		//
		// Fails off the web, or when the policy denies `cookies`.
		@commit(policy = "cookies")
		def removeCookie(name string, path string = "/") !none {
			let expired = Cookie{name: name, value: "", path: path, expires: time.fromUnixNs(0)}
			let _ = try call("setCookie", encode(TextArgs{text: cookieText(expired)}))
			return none
		}

		// The value stored under `key` in the site's storage (localStorage, or
		// sessionStorage, kept for the tab only, when `session`); none when it
		// holds none.
		//
		// Fails off the web, or when the policy denies `storage`.
		@query(policy = "storage")
		def storage(key string, session bool = false) !?string {
			let raw = OptionalTextAnswer{}
			try decodeAnswer(try call("storage", encode(StorageArgs{key: key, session: session})), raw)
			return none unless raw.found
			return raw.value
		}

		// Stores a value under `key` in the site's storage.
		//
		// Fails off the web, when the policy denies `storage`, or when the
		// storage is full or refused.
		@commit(policy = "storage")
		def setStorage(key string, value string, session bool = false) !none {
			let _ = try call("setStorage", encode(StorageArgs{key: key, value: value, session: session}))
			return none
		}

		// Removes the value under `key` from the site's storage.
		//
		// Fails off the web, or when the policy denies `storage`.
		@commit(policy = "storage")
		def removeStorage(key string, session bool = false) !none {
			let _ = try call("removeStorage", encode(StorageArgs{key: key, session: session}))
			return none
		}

		// --- permissions as the browser sees them ---

		// The browser's answer for a permission: "camera", "microphone",
		// "geolocation", "notifications", "clipboard-read", ...
		//
		// Fails off the web, or when the browser does not know the permission.
		@query()
		def permission(name string) !PermissionState {
			match try textAnswer(try call("permission", encode(TextArgs{text: name}))) {
				case "granted":
					return PermissionState.Granted
				case "denied":
					return PermissionState.Denied
			}
			return PermissionState.Prompt
		}

		// --- installed web app, offline ---

		// Whether the browser offers to install the site as an app now.
		@query()
		def installable() bool {
			let raw = FlagAnswer{}
			decodeAnswer(call("installable") onerror recover "", raw) onerror recover none
			return raw.value
		}

		// Shows the browser's install prompt; true when the user installed.
		//
		// Fails off the web, when the policy denies `install`, when the browser
		// offers no install now, or when the call does not follow a click or
		// key press.
		@commit(policy = "install")
		def install() !bool {
			let raw = FlagAnswer{}
			try decodeAnswer(try call("install"), raw)
			return raw.value
		}

		// Registers the service worker at `script`, which serves the site when
		// it is offline.
		//
		// Fails off the web, or when the browser refuses the worker.
		@commit()
		def registerWorker(script url.URL) !none {
			let _ = try call("registerWorker", encode(TextArgs{text: script.str()}))
			return none
		}

		// A new version of the site is cached and waiting: `version` is the
		// address of the waiting worker's script.
		@emit()
		def updateReady(version string) string {
			return version
		}

		// Makes the waiting version take over and loads the page again. The
		// worker activates when it receives `{type: "SKIP_WAITING"}`.
		//
		// Fails off the web, or when no version waits.
		@commit()
		def applyUpdate() !none {
			let _ = try call("applyUpdate")
			return none
		}

		// --- escape hatch ---

		// Runs JavaScript in the page and returns its result as JSON ("null"
		// for none), awaiting it when it is a promise. For browser APIs nothing
		// above covers.
		//
		// Fails off the web, when the policy denies `script`, or when the script
		// throws.
		@commit(policy = "script")
		def evaluate(script string) !string {
			return try textAnswer(try call("evaluate", encode(TextArgs{text: script})))
		}

		// Emits `locationChange` for each new history entry while the service runs.
		internal def watchLocation() {
			for watching {
				let changed = call("waitLocation") onerror recover ""
				break when changed == ""
				let at = textAnswer(changed) onerror recover ""
				let ok = true
				let parsed = url.parse(at) onerror (err error) {
					ok = false
					recover new url.URL()
				}
				if ok {
					let _ = locationChange(parsed)
				}
			}
		}

		// Emits `updateReady` for each new version that waits while the service runs.
		internal def watchUpdates() {
			for watching {
				let waiting = call("waitUpdate") onerror recover ""
				break when waiting == ""
				let script = textAnswer(waiting) onerror recover ""
				if script != "" {
					let _ = updateReady(script)
				}
			}
		}
	}

	// --- what crosses to the page's loader, as JSON ---

	struct NavigateArgs {
		to      string
		replace bool
	}

	struct SwitchArgs {
		on bool
	}

	struct TextArgs {
		text string
	}

	struct StorageArgs {
		key     string
		value   string = ""
		session bool
	}

	struct MetadataArgs {
		title       string              = ""
		description string              = ""
		canonical   string              = ""
		image       string              = ""
		language    string              = ""
		robots      string              = ""
		themeColor  string              = ""
		extra       map<string, string> = {}
	}

	struct TextAnswer {
		value string
	}

	struct OptionalTextAnswer {
		found bool
		value string = ""
	}

	struct FlagAnswer {
		value bool
	}

	struct CookiePair {
		name  string
		value string
	}

	struct CookiesAnswer {
		value CookiePair[] = []
	}

	internal def encode(value any) string {
		return string(new JSON().encode(value))
	}

	internal def decodeAnswer(text string, into any) !none {
		try new JSON().decode(text, into)
		return none
	}

	internal def textAnswer(text string) !string {
		let raw = TextAnswer{}
		try decodeAnswer(text, raw)
		return raw.value
	}

	// The `document.cookie` assignment that sets the cookie.
	internal def cookieText(cookie Cookie) string {
		let out = "{url.queryEscape(cookie.name)}={url.queryEscape(cookie.value)}; Path={cookie.path}"
		out += "; Domain={cookie.domain}" unless cookie.domain == ""
		let expires = cookie.expires
		if !(expires is none) {
			let seconds = int(expires - time.now()) / 1000000000
			seconds = 0 when seconds < 0
			out += "; Max-Age={seconds}"
		}
		out += "; Secure" when cookie.secure
		match cookie.sameSite {
			case SameSite.Strict:
				out += "; SameSite=Strict"
			case SameSite.None:
				out += "; SameSite=None"
			default:
				out += "; SameSite=Lax"
		}
		return out
	}

	// The failure a call into the browser ended with, for a std service that
	// calls the browser through the runtime's bridge itself: `code` is the
	// bridge's (internal/runtime/c/adm_web.h), `op` names the call.
	def browserFailure(op string, code int) BrowserFailure {
		let kind = BrowserError.Unsupported
		let why = "the browser lacks the feature"
		match code {
			case - 1:
				kind = BrowserError.Unavailable
				why = "not running in a browser"
			case - 3:
				kind = BrowserError.Denied
				why = "the user or the browser refused"
			case - 4:
				kind = BrowserError.NeedsUserGesture
				why = "it needs a click or key press to have just happened"
		}
		return BrowserFailure{message: "Browser.{op}: {why}", code: kind.name, kind: kind, op: op}
	}

	// Off the web there is no browser to call.
	@os("linux", "darwin", "windows", "android", "ios")
	internal def call(op string, args string = "\{}") !string {
		fail browserFailure(op, -1)
	}
}
