// The Browser service's IDE panel, for a program on the web: the page's
// address and whether it can be installed, and the buttons that move it.

partial module std.services.browser {
	use (
		std.ide::(ide, IdeKind)
		std.net.url
	)

	partial service Browser {
		@ide(kind = IdeKind.Value, label = "Address", refresh = 1s)
		def ideLocation() string {
			let at = location() onerror recover new url.URL()
			return at.str()
		}

		@ide(kind = IdeKind.Value, label = "Installable", refresh = 5s)
		def ideInstallable() bool {
			return installable()
		}

		@ide(kind = IdeKind.Action, label = "Reload")
		def ideReload() !none {
			return reload()
		}

		@ide(kind = IdeKind.Action, label = "Back")
		def ideBack() !none {
			return back()
		}

		@ide(kind = IdeKind.Action, label = "Forward")
		def ideForward() !none {
			return forward()
		}

		@ide(kind = IdeKind.Action, label = "Go to")
		def ideNavigate(address string) !none {
			let to = try url.parse(address)
			return navigate(to)
		}
	}
}
