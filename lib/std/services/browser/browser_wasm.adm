@os("wasm")
partial module std.services.browser {
	// Asks the page's loader to run op with its JSON arguments; answers with
	// the JSON the loader gave back.
	internal def call(op string, args string = "\{}") !string {
		let status = __webBrowser(op, args)
		fail browserFailure(op, int(status)) unless status == 0
		return __webAnswer()
	}

	@c("adm_web.h", symbol = "adm_web_browser", ret = "int32_t", params = ["const char*", "const char*"])
	def __webBrowser(op string, args string) int32;

	@c("adm_web.h", symbol = "adm_web_answer", ret = "const char*", params = [])
	def __webAnswer() string;
}
