// The Cache service's IDE panel: what it holds and the buttons that clear it.

partial module std.services.cache {
	use (
		std.glob::Glob
		std.ide::(ide, IdeKind, IdeTable)
		std.reflection
		std.time
	)

	partial service Cache {
		// The live entries with their remaining budgets.
		@ide(kind = IdeKind.Table, label = "Entries", refresh = 1s, rows = 0)
		atomic def ideEntries() IdeTable {
			purgeExpired(time.monoNs())
			let now = time.monoNs()
			let rows = string[][]
			for let (key, entry) in entries {
				let ttlMs = "-"
				ttlMs = "{int64(remainingTTL(entry, now)) / 1000000}" unless entry.ttl is none
				let idleMs = "-"
				idleMs = "{int64(remainingIdle(entry, now)) / 1000000}" unless entry.idle is none
				rows.push([key, reflection.typeName(entry.value), "{entry.memory}", ttlMs, idleMs])
			}
			return IdeTable{
				columns: ["Key", "Type", "Size (B)", "TTL (ms)", "Idle (ms)"],
				rows:    rows,
			}
		}

		// How many keys are live.
		@ide(kind = IdeKind.Value, label = "Keys", refresh = 1s)
		atomic def ideCount() int {
			purgeExpired(time.monoNs())
			return entries.len()
		}

		// Retained memory, graphed over time.
		@ide(kind = IdeKind.Series, label = "Memory", refresh = 500ms, unit = "B")
		def ideMemory() int {
			return memoryUsed
		}

		@ide(kind = IdeKind.Action, label = "Clear", confirm = "Remove every entry?")
		def ideClear() {
			clear()
		}

		@ide(kind = IdeKind.Action, label = "Delete key", row = "ideEntries.Key")
		def ideDelete(key string) {
			delete(key)
		}

		// Removes the keys a glob matches (`user:*`) and says how many.
		@ide(kind = IdeKind.Action, label = "Delete matching", confirm = "Remove every key the pattern matches?")
		def ideDeleteMatching(pattern string) string {
			let removed = delete(new Glob(pattern))
			return "{removed} removed"
		}

		// Gives a key a new time to live, counted from now.
		@ide(kind = IdeKind.Action, label = "Renew key", row = "ideEntries.Key")
		def ideRenew(key string, ttl duration) {
			renew(key, ttl)
		}
	}
}
