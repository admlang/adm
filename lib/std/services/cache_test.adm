partial module std.services {
	use (
		std.testing
		std.time
		std.glob::Glob
	)

	internal type CacheSizeNode {
		name string
		next ?CacheSizeNode

		def new(name string) {
			self.name = name
		}
	}

	check "Cache service" {
		def reset() !none {
			Cache.clear()
			try Cache.config(CacheConfig{})
			return none
		}

		def assertInt(key string, expected int) {
			let value = Cache.get(key)
			if value is none {
				assert false
			} else {
				assert int(value) == expected
			}
		}

		@test()
		def literalsAndBulkOperations() !none {
			try reset()
			Cache.set("users:1", 10)
			Cache.set("users:2", 20)
			Cache.set("users:*", 30)

			assert Cache.size() == 3
			assertInt("users:*", 30)

			let selected = Cache.get(new Glob("users:?"))
			assert selected.len() == 3
			assert int(selected["users:1"]) == 10
			assert int(selected["users:2"]) == 20
			assert int(selected["users:*"]) == 30

			let present = Cache.has(["users:1", "missing"])
			assert present["users:1"]
			assert !present["missing"]

			assert Cache.delete(new Glob("users:*")) == 3
			assert Cache.size() == 0
			return none
		}

		@test()
		def takeAndClear() !none {
			try reset()
			Cache.set("one", 1)
			Cache.set("two", 2)

			let value = Cache.take("one")
			if value is none {
				assert false
			} else {
				assert int(value) == 1
			}
			assert !Cache.has("one")

			Cache.clear()
			assert Cache.size() == 0
			return none
		}

		@test()
		def ttlAndRenewal() !none {
			try reset()
			Cache.set("short", 1, 5ms)
			time.sleep(10ms)
			assert !Cache.has("short")

			Cache.set("renewed", 2, 20ms)
			time.sleep(12ms)
			Cache.renew("renewed", 25ms)
			time.sleep(15ms)
			assert Cache.has("renewed")
			time.sleep(15ms)
			assert !Cache.has("renewed")
			return none
		}

		@test()
		def idleExpirationAndTouch() !none {
			try reset()
			Cache.set("session", 7, none, 30ms)
			time.sleep(20ms)
			Cache.touch("session")
			time.sleep(20ms)
			assert Cache.has("session")
			time.sleep(20ms)
			assert !Cache.has("session")
			return none
		}

		@test()
		def leastRecentlyUsedEntryEviction() !none {
			try reset()
			try Cache.config(CacheConfig{maxEntries: 2})
			Cache.set("a", 1)
			Cache.set("b", 2)
			assertInt("a", 1)
			Cache.set("c", 3)

			assert Cache.has("a")
			assert !Cache.has("b")
			assert Cache.has("c")
			return none
		}

		@test()
		def retainedMemoryEviction() !none {
			try reset()
			let oneEntry = 2 + Runtime.sizeOf(1)
			try Cache.config(CacheConfig{maxMemory: oneEntry})
			Cache.set("aa", 1)
			Cache.set("bb", 2)

			assert !Cache.has("aa")
			assert Cache.has("bb")
			return none
		}

		@test()
		def runtimeDeepSize() !none {
			assert Runtime.sizeOf(1) > 0
			assert Runtime.sizeOf("a substantially longer string") > Runtime.sizeOf("x")
			assert Runtime.sizeOf([1, 2, 3, 4]) > Runtime.sizeOf([1])

			let shared = new CacheSizeNode("shared payload")
			let sharedGraph = [shared, shared]
			let distinctGraph = [new CacheSizeNode("shared payload"), new CacheSizeNode("shared payload")]
			assert Runtime.sizeOf(sharedGraph) < Runtime.sizeOf(distinctGraph)

			// The traversal must terminate and count the node once.
			shared.next = shared
			assert Runtime.sizeOf(shared) > 0
			return none
		}
	}

	// Exercises the @cache / @cacheInvalidate annotations, which wrap the method
	// through the runtime meta machinery.
	internal type CachedReport {
		builds int

		@cache("report:total")
		def total() int {
			builds++
			return builds * 100
		}

		@cache("report:fresh", 5ms)
		def fresh() int {
			builds++
			return builds
		}

		@cacheInvalidate("report:total", "report:fresh")
		def publish() {
			builds++
		}
	}

	check "Cache annotations" {
		@test()
		def cachedResultSkipsTheMethod() {
			Cache.clear()
			let report = new CachedReport()

			assert report.total() == 100
			assert report.total() == 100
			assert report.builds == 1
			assert Cache.has("report:total")
		}

		@test()
		def explicitKeysAreInvalidated() {
			Cache.clear()
			let report = new CachedReport()

			assert report.total() == 100
			report.publish()
			assert !Cache.has("report:total")
			assert report.total() == 300
		}

		@test()
		def annotatedTTLExpires() !none {
			Cache.clear()
			let report = new CachedReport()

			assert report.fresh() == 1
			time.sleep(10ms)
			assert !Cache.has("report:fresh")
			assert report.fresh() == 2
			return none
		}
	}

	internal struct CacheAccount {
		email string
		id    int
	}

	internal def cacheKeyHash(value string) string {
		return "h{value.len()}"
	}

	// Exercises templated annotation arguments: the `{...}` segments are ordinary
	// ADM expressions over the annotated method's parameters (and `self`),
	// evaluated per call.
	internal type TemplatedReport {
		tenant string
		builds int

		def new(tenant string) {
			self.tenant = tenant
		}

		@cache("report:user:{email}")
		def byEmail(email string) int {
			builds++
			return email.len()
		}

		@cache("report:acct:{cacheKeyHash(account.email)}:{account.id}")
		def byAccount(account CacheAccount) int {
			builds++
			return account.id
		}

		@cache("report:{self.tenant}:{email}")
		def byTenant(email string) int {
			builds++
			return 7
		}

		@cacheInvalidate("report:user:{email}")
		def publish(email string) {
			builds++
		}
	}

	check "Cache annotation templates" {
		@test()
		def keyReadsAnArgument() {
			Cache.clear()
			let report = new TemplatedReport("acme")

			assert report.byEmail("a@b.com") == 7
			assert Cache.has("report:user:a@b.com")
			assert !Cache.has("report:user:\{email}")

			assert report.byEmail("a@b.com") == 7
			assert report.builds == 1

			assert report.byEmail("zz@q.io") == 7
			assert report.builds == 2
			assert Cache.has("report:user:zz@q.io")
		}

		@test()
		def keyReadsCallsAndFields() {
			Cache.clear()
			let report = new TemplatedReport("acme")

			assert report.byAccount(CacheAccount{email: "abc", id: 5}) == 5
			assert Cache.has("report:acct:h3:5")
		}

		@test()
		def keyReadsSelf() {
			Cache.clear()
			let report = new TemplatedReport("acme")

			assert report.byTenant("x@y.z") == 7
			assert Cache.has("report:acme:x@y.z")
		}

		@test()
		def templatedInvalidation() {
			Cache.clear()
			let report = new TemplatedReport("acme")

			assert report.byEmail("a@b.com") == 7
			assert report.byEmail("zz@q.io") == 7
			report.publish("a@b.com")
			assert !Cache.has("report:user:a@b.com")
			assert Cache.has("report:user:zz@q.io")
		}
	}
}
