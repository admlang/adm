partial module std.services {
	use (
		std.time
	)

	// The program a machine offers for its clipboard.
	enum ClipboardTool {
		// wl-copy and wl-paste on a Wayland desktop.
		WlClipboard,
		// xclip on an X11 display.
		Xclip,
		// xsel on an X11 display.
		Xsel,
		// pbcopy and pbpaste on macOS.
		Pasteboard,
	}

	// What the clipboard held when the watcher saw it change.
	struct ClipboardChange {
		// The text on the clipboard; "" when it was emptied.
		text string
		// Whether this program put the text there through `copy`.
		own  bool
		// When the watcher noticed the change.
		time time.Time
	}

	// What the clipboard on this machine can do.
	struct ClipboardCapabilities {
		// A clipboard program was found; `copy` and `paste` can work.
		available bool
		// The program in use: "wl-clipboard", "xclip", "xsel" or "pbcopy"; "" when there is none.
		tool      string
	}

	// The system clipboard, for text.
	//
	// The service drives the desktop's clipboard program: wl-copy and wl-paste on
	// Wayland, xclip or xsel on X11, pbcopy and pbpaste on macOS. A machine without
	// one reports nothing available and `copy` and `paste` fail. Reading needs the
	// `adm.clipboard.read` permission, writing `adm.clipboard.write`, and both run
	// the program through `Runtime.run`, so `adm.runtime.spawn` as well.
	//
	// `copy`, `paste` and `clear` are commits, so `@on(Clipboard.copy)`,
	// `@on(Clipboard.paste)` and `@on(Clipboard.clear)` observe them. `watch` starts
	// a task that polls the clipboard and emits `changed` whenever the text differs
	// from what it saw last, whichever program changed it.
	//
	// The OS sandbox (`ADM_SANDBOX`) refuses to start programs: under it every
	// clipboard call fails.
	service Clipboard {
		description  = "Copy and paste text through the system clipboard"
		dependencies = Dependencies{
			hard: [Policy, Runtime]
		}
		lifecycle    = Lifecycle{
			start: StartMode.Manual,
			restart: RestartMode.Always,
		}
		permissions  = [
			Permission{name: "read", description: "Read the text on the clipboard"},
			Permission{name: "write", description: "Put text on the clipboard or empty it"},
		]

		// The clipboard program found on this machine; none before the first use
		// and when there is none.
		tool     ?ClipboardTool    = none
		// Whether the machine was searched for a program yet.
		searched bool              = false
		// The running watcher; none until `watch`.
		watcher  ?ClipboardWatcher = none

		// Starts the service. The clipboard program is looked up on first use, so this does not fail.
		async def start() !none {
			status = ServiceStatus.Started
			return none
		}

		// Stops the watcher when one runs. Does not fail today.
		async def stop() !none {
			status = ServiceStatus.Stopped
			unwatch()
			return none
		}

		// Stops the service and starts it again. Does not fail today.
		async def restart() !none {
			status = ServiceStatus.Restarting
			try await stop()
			try await start()
			return none
		}

		// Puts the text on the clipboard, replacing what was there.
		//
		// Fails when the policy denies it, this machine has no clipboard program, or the program fails.
		@commit(policy = "write")
		def copy(text string) !none {
			let program = try program()
			try shellWrite(clipboardWriteCommand(program), text)
			noteCopied(text)
			return none
		}

		// Returns the text on the clipboard, "" when it holds none.
		//
		// Fails when the policy denies it, this machine has no clipboard program, or the program fails.
		@commit(policy = "read")
		def paste() !string {
			let program = try program()
			return try shellRead(clipboardReadCommand(program))
		}

		// Empties the clipboard.
		//
		// Fails when the policy denies it, this machine has no clipboard program, or the program fails.
		@commit(policy = "write")
		def clear() !none {
			let program = try program()
			try shellRun(clipboardClearCommand(program))
			noteCopied("")
			return none
		}

		// Whether the clipboard holds any text.
		//
		// Fails when the policy denies reading, this machine has no clipboard program, or the program fails.
		@query(policy = "read")
		def has() !bool {
			let program = try program()
			let text = try shellRead(clipboardReadCommand(program))
			return text.len() > 0
		}

		// Reports whether this machine has a clipboard program and which one.
		@query()
		def capabilities() ClipboardCapabilities {
			search()
			let found = tool
			return ClipboardCapabilities{available: false, tool: ""} when found is none
			let program ClipboardTool = found
			return ClipboardCapabilities{available: true, tool: clipboardToolName(program)}
		}

		// Whether the watcher task runs.
		@query()
		def watching() bool {
			return !(runningWatcher() is none)
		}

		// Starts watching the clipboard: a task reads it every `period` and emits
		// `changed` when the text differs from what it saw last. Calling it while
		// watching only changes the interval.
		//
		// Fails when the policy denies reading or this machine has no clipboard program.
		@commit(policy = "read")
		def watch(period duration = 500ms) !none {
			let program = try program()
			let current = runningWatcher()
			if current is none {
				let seen = shellRead(clipboardReadCommand(program)) onerror recover ""
				let started = new ClipboardWatcher(period, seen)
				watcher = started
				async watchLoop(program, started)
				return none
			}
			let running ClipboardWatcher = current
			running.changePeriod(period)
			return none
		}

		// Stops the watcher task; nothing happens when none runs.
		@commit()
		def unwatch() {
			let current = watcher
			return when current is none
			let running ClipboardWatcher = current
			running.stop()
		}

		// Emitted by the watcher when the clipboard text changed.
		@emit()
		def changed(change ClipboardChange) ClipboardChange {
			return change
		}

		// Looks the clipboard program up the first time.
		def search() {
			return when searched
			tool = findClipboardTool()
			searched = true
		}

		// The clipboard program on this machine.
		//
		// Fails when there is none.
		def program() !ClipboardTool {
			search()
			let found = tool
			fail "clipboard: no clipboard program on this machine (wl-clipboard, xclip, xsel or pbcopy)" when found is none
			let present ClipboardTool = found
			return present
		}

		// The watcher while its task runs; none before `watch` and after `unwatch`.
		def runningWatcher() ?ClipboardWatcher {
			let current = watcher
			return none when current is none
			let running ClipboardWatcher = current
			return none unless running.isRunning()
			return running
		}

		// Tells the watcher what this program copied, so its next change reads as own.
		def noteCopied(text string) {
			let current = watcher
			return when current is none
			let running ClipboardWatcher = current
			running.noteCopied(text)
		}

		// Polls the clipboard until the watcher is stopped.
		def watchLoop(program ClipboardTool, running ClipboardWatcher) {
			for running.isRunning() {
				let text = shellRead(clipboardReadCommand(program)) onerror recover running.lastSeen()
				if running.observe(text) {
					let _ = changed(ClipboardChange{text: text, own: text.len() > 0 && text == running.copied(), time: time.now()})
				}
				time.sleep(running.period())
			}
		}
	}

	// The watcher task's state, shared between the task and the service.
	internal type ClipboardWatcher {
		internal running    bool     = true
		internal delay      duration
		internal seen       string
		internal lastCopied string   = ""

		def new(period duration, seen string) {
			delay = period
			self.seen = seen
		}

		atomic def stop() {
			running = false
		}

		atomic def isRunning() bool {
			return running
		}

		atomic def changePeriod(period duration) {
			delay = period
		}

		atomic def period() duration {
			return delay
		}

		atomic def lastSeen() string {
			return seen
		}

		atomic def noteCopied(text string) {
			lastCopied = text
		}

		atomic def copied() string {
			return lastCopied
		}

		// Records the text and says whether it differs from the last one seen.
		atomic def observe(text string) bool {
			return false when text == seen
			seen = text
			return true
		}
	}

	// --- the clipboard programs -------------------------------------------------

	// The name `ClipboardCapabilities.tool` reports for a program.
	internal def clipboardToolName(tool ClipboardTool) string {
		match tool {
			case ClipboardTool.WlClipboard:
				return "wl-clipboard"
			case ClipboardTool.Xclip:
				return "xclip"
			case ClipboardTool.Xsel:
				return "xsel"
			case ClipboardTool.Pasteboard:
				return "pbcopy"
		}
		return ""
	}

	// The shell command that prints the clipboard text; it prints nothing when the clipboard is empty.
	internal def clipboardReadCommand(tool ClipboardTool) string {
		match tool {
			case ClipboardTool.WlClipboard:
				return "wl-paste --no-newline 2>/dev/null </dev/null"
			case ClipboardTool.Xclip:
				return "xclip -selection clipboard -o 2>/dev/null </dev/null"
			case ClipboardTool.Xsel:
				return "xsel --clipboard --output 2>/dev/null </dev/null"
			case ClipboardTool.Pasteboard:
				return "pbpaste 2>/dev/null </dev/null"
		}
		return ""
	}

	// The shell command that puts its standard input on the clipboard.
	internal def clipboardWriteCommand(tool ClipboardTool) string {
		match tool {
			case ClipboardTool.WlClipboard:
				return "wl-copy 2>/dev/null"
			case ClipboardTool.Xclip:
				return "xclip -selection clipboard -i 2>/dev/null"
			case ClipboardTool.Xsel:
				return "xsel --clipboard --input 2>/dev/null"
			case ClipboardTool.Pasteboard:
				return "pbcopy 2>/dev/null"
		}
		return ""
	}

	// The shell command that empties the clipboard.
	internal def clipboardClearCommand(tool ClipboardTool) string {
		match tool {
			case ClipboardTool.WlClipboard:
				return "wl-copy --clear 2>/dev/null"
			case ClipboardTool.Xclip:
				return "xclip -selection clipboard -i 2>/dev/null </dev/null"
			case ClipboardTool.Xsel:
				return "xsel --clipboard --clear 2>/dev/null"
			case ClipboardTool.Pasteboard:
				return "pbcopy 2>/dev/null </dev/null"
		}
		return ""
	}

	// The shell test that succeeds when the program is installed and its display is up.
	internal def clipboardProbeCommand(tool ClipboardTool) string {
		match tool {
			case ClipboardTool.WlClipboard:
				return "[ -n \"$WAYLAND_DISPLAY\" ] && command -v wl-paste >/dev/null 2>&1 && command -v wl-copy >/dev/null 2>&1"
			case ClipboardTool.Xclip:
				return "[ -n \"$DISPLAY\" ] && command -v xclip >/dev/null 2>&1"
			case ClipboardTool.Xsel:
				return "[ -n \"$DISPLAY\" ] && command -v xsel >/dev/null 2>&1"
			case ClipboardTool.Pasteboard:
				return "command -v pbpaste >/dev/null 2>&1 && command -v pbcopy >/dev/null 2>&1"
		}
		return "false"
	}

	// The programs worth trying on this platform, preferred first.
	@os("linux")
	internal def clipboardToolCandidates() ClipboardTool[] {
		return [ClipboardTool.WlClipboard, ClipboardTool.Xclip, ClipboardTool.Xsel]
	}

	// The programs worth trying on this platform, preferred first.
	@os("darwin")
	internal def clipboardToolCandidates() ClipboardTool[] {
		return [ClipboardTool.Pasteboard]
	}

	// The programs worth trying on this platform: none yet.
	@os("windows")
	internal def clipboardToolCandidates() ClipboardTool[] {
		return []
	}

	// The first candidate whose probe succeeds; none when no program is usable.
	internal def findClipboardTool() ?ClipboardTool {
		for let candidate in clipboardToolCandidates() {
			let code = shellExitCode(clipboardProbeCommand(candidate)) onerror recover 1
			return candidate when code == 0
		}
		return none
	}

	// --- running the programs ---------------------------------------------------

	// Runs the command and returns its exit code.
	//
	// Fails when the policy denies running programs or the shell could not be started.
	internal def shellExitCode(command string) !int {
		let ran = try Runtime.run(command)
		return ran.code
	}

	// Runs the command and returns what it printed.
	//
	// Fails when the policy denies running programs, the shell could not be started, or the command exited with an error and printed nothing.
	internal def shellRead(command string) !string {
		let ran = try Runtime.run(command)
		// wl-paste exits 1 for an empty clipboard, so an empty result is not an error.
		fail "clipboard: the clipboard program exited with {ran.code}" when ran.code != 0 && ran.output.len() > 0
		return ran.output
	}

	// Runs the command with the text as its standard input.
	//
	// Fails when the policy denies running programs, the shell could not be started, or the command exited with an error.
	internal def shellWrite(command string, text string) !none {
		let ran = try Runtime.run(command, text)
		fail "clipboard: the clipboard program exited with {ran.code}" when ran.code != 0
		return none
	}

	// Runs the command and fails when it exited with an error.
	internal def shellRun(command string) !none {
		let code = try shellExitCode(command)
		fail "clipboard: the clipboard program exited with {code}" when code != 0
		return none
	}
}
