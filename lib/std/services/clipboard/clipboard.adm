partial module std.services.clipboard {
	use (
		std.data.encoding::(base64decode, base64encode)
		std.services::(Dependencies, Lifecycle, RestartMode, ServiceStatus, StartMode)
		std.services.policy::(Policy)
		std.services.runtime::(Runtime)
		std.time
		std.services.clipboard.tools::*
	)

	// The program a machine offers for its clipboard.
	enum ClipboardTool {
		// wl-copy and wl-paste on a Wayland desktop.
		WlClipboard,
		// xclip on an X11 display.
		Xclip,
		// xsel on an X11 display.
		Xsel,
		// pbcopy and pbpaste on macOS.
		Pasteboard,
	}

	// What the clipboard held when the watcher saw it change.
	struct ClipboardChange {
		// The text on the clipboard; "" when it was emptied.
		text string
		// Whether this program put the text there through `copy`.
		own  bool
		// When the watcher noticed the change.
		time time.Time
	}

	// What the clipboard on this machine can do.
	struct ClipboardCapabilities {
		// A clipboard program was found; `copy` and `paste` can work.
		available bool
		// The program in use: "wl-clipboard", "xclip", "xsel" or "pbcopy"; "windows" for
		// Windows' own clipboard, "browser" on the web; "" when there is none.
		tool      string
	}

	// A read or a write of the clipboard, offered to the program's own window system
	// before a clipboard program is used: the `reading` and `writing` events carry one.
	// A handler that served it says so with `answer` or `done`; left alone, the service
	// goes on to the clipboard program.
	type ClipboardRequest {
		// The text to put on the clipboard, "" to empty it; after `answer`, the text read.
		text     string
		// The MIME type of the data offered or asked for (`image/png`); "" for text,
		// "*" for the list of the types the clipboard offers.
		mime     string   = ""
		// The data to put on the clipboard; after `answerData`, the data read, none
		// when the clipboard offers none of that type.
		data     ?byte[]  = none
		// After `answerFormats`: the types the clipboard offers.
		formats  string[] = []
		// Whether a handler served the request.
		answered bool     = false

		def new(text string = "", mime string = "", data ?byte[] = none) {
			self.text = text
			self.mime = mime
			self.data = data
		}

		// A handler of `reading`: this is the text on the clipboard.
		def answer(text string) {
			self.text = text
			answered = true
		}

		// A handler of `reading` for a type: this is the clipboard's data of it, none
		// when it offers none.
		def answerData(data ?byte[]) {
			self.data = data
			answered = true
		}

		// A handler of `reading` for the types ("*"): these are the types the
		// clipboard offers.
		def answerFormats(types string[]) {
			formats = types
			answered = true
		}

		// A handler of `writing`: the text is on the clipboard.
		def done() {
			answered = true
		}
	}

	// The system clipboard: text, and data of any MIME type (a picture as `image/png`,
	// `copyData`, `pasteData`, `formats`).
	//
	// A program with a window open uses the window system's clipboard: `std.ui` answers
	// the `reading` and `writing` events for calls made from the task that runs the
	// windows. Every other call drives the desktop's clipboard program: wl-copy and
	// wl-paste on Wayland, xclip or xsel on X11, pbcopy and pbpaste on macOS; on
	// Windows it is the system's own clipboard. A machine without one reports nothing
	// available and `copy` and `paste` fail. Of the programs, wl-clipboard and xclip
	// carry data; xsel, pbcopy and Windows' own clipboard carry text only, as the
	// browser's does. Reading needs the `adm.clipboard.read` permission, writing
	// `adm.clipboard.write`, and a clipboard program runs through `Runtime.run`, so
	// `adm.runtime.spawn` as well.
	//
	// `copy`, `paste` and `clear` are commits, so `@on(Clipboard.copy)`,
	// `@on(Clipboard.paste)` and `@on(Clipboard.clear)` observe them. `watch` starts
	// a task that polls the clipboard and emits `changed` whenever the text differs
	// from what it saw last, whichever program changed it.
	//
	// The OS sandbox (`ADM_SANDBOX`) refuses to start programs: under it every
	// clipboard call fails.
	partial service Clipboard {
		description  = "Copy and paste text through the system clipboard"
		dependencies = Dependencies{
			hard: [Policy, Runtime]
		}
		lifecycle    = Lifecycle{
			start: StartMode.Manual,
			restart: RestartMode.Always,
		}
		permissions  = [
			Permission{name: "read", description: "Read the text or data on the clipboard"},
			Permission{name: "write", description: "Put text or data on the clipboard or empty it"},
		]

		// The clipboard program found on this machine; none before the first use
		// and when there is none.
		tool     ?ClipboardTool    = none
		// Whether the machine was searched for a program yet.
		searched bool              = false
		// The running watcher; none until `watch`.
		watcher  ?ClipboardWatcher = none

		// Starts the service. The clipboard program is looked up on first use, so this does not fail.
		async def start() !none {
			status = ServiceStatus.Started
			return none
		}

		// Stops the watcher when one runs. Does not fail.
		async def stop() !none {
			status = ServiceStatus.Stopped
			unwatch()
			return none
		}

		// Stops the service and starts it again. Does not fail.
		async def restart() !none {
			status = ServiceStatus.Restarting
			try await stop()
			try await start()
			return none
		}

		// Puts the text on the clipboard, replacing what was there.
		//
		// Fails when the policy denies it, this machine has no clipboard program, or the program fails;
		// on the web, when the browser refuses (the user denied it, or no click or key press came just
		// before).
		@commit(policy = "write")
		def copy(text string) !none {
			let request = writing(new ClipboardRequest(text))
			try systemWrite(text) unless request.answered
			noteCopied(text)
			return none
		}

		// Returns the text on the clipboard, "" when it holds none.
		//
		// Fails when the policy denies it, this machine has no clipboard program, or the program fails;
		// on the web, when the browser refuses (the user denied it, or no click or key press came just
		// before).
		@commit(policy = "read")
		def paste() !string {
			return readText()
		}

		// Empties the clipboard.
		//
		// Fails when the policy denies it, this machine has no clipboard program, or the program fails;
		// on the web, when the browser refuses (the user denied it, or no click or key press came just
		// before).
		@commit(policy = "write")
		def clear() !none {
			let request = writing(new ClipboardRequest())
			try systemClear() unless request.answered
			noteCopied("")
			return none
		}

		// Whether the clipboard holds any text.
		//
		// Fails when the policy denies reading, this machine has no clipboard program, or the program fails.
		@query(policy = "read")
		def has() !bool {
			let text = try readText()
			return text.len() > 0
		}

		// Puts data of the MIME type on the clipboard (`image/png` for a picture),
		// replacing what was there.
		//
		// Fails when the policy denies it, the type is not a plain MIME type, nothing on this machine carries
		// data (no window, and the clipboard program is xsel or pbcopy, or Windows' own clipboard), or the
		// program fails.
		@commit(policy = "write")
		def copyData(mime string, data byte[]) !none {
			fail "clipboard: `{mime}` is not a MIME type" unless plainMime(mime)
			let request = writing(new ClipboardRequest("", mime, data))
			try systemWriteData(mime, data) unless request.answered
			return none
		}

		// The clipboard's data of the MIME type; none when it offers none of it.
		//
		// Fails when the policy denies it, the type is not a plain MIME type, nothing on this machine carries
		// data, or the program fails.
		@commit(policy = "read")
		def pasteData(mime string) !?byte[] {
			fail "clipboard: `{mime}` is not a MIME type" unless plainMime(mime)
			let request = reading(new ClipboardRequest("", mime))
			return request.data when request.answered
			return try systemReadData(mime)
		}

		// The MIME types the clipboard offers now (`text/plain;charset=utf-8`,
		// `image/png`, …); empty when it holds nothing. A program that carries text only
		// answers `text/plain` when there is text.
		//
		// Fails when the policy denies reading, this machine has no clipboard program, or the program fails.
		@query(policy = "read")
		def formats() !string[] {
			let request = reading(new ClipboardRequest("", "*"))
			return request.formats when request.answered
			return try systemFormats()
		}

		// Reports whether this machine has a clipboard program and which one. A window
		// system that answers `reading` and `writing` is not counted.
		@query()
		def capabilities() ClipboardCapabilities {
			return ClipboardCapabilities{available: true, tool: "browser"} when __os__ == "wasm"
			return ClipboardCapabilities{available: true, tool: "windows"} when __os__ == "windows"
			search()
			let found = tool
			return ClipboardCapabilities{available: false, tool: ""} when found is none
			let program ClipboardTool = found
			return ClipboardCapabilities{available: true, tool: clipboardToolName(program)}
		}

		// Whether the watcher task runs.
		@query()
		def watching() bool {
			return !(runningWatcher() is none)
		}

		// Starts watching the clipboard: a task reads it every `period` and emits
		// `changed` when the text differs from what it saw last. Calling it while
		// watching only changes the interval.
		//
		// Fails when the policy denies reading or this machine has no clipboard program.
		@commit(policy = "read")
		def watch(period duration = 500ms) !none {
			fail "clipboard: watching the clipboard is not available on the web: a page may read it only right after a click or key press" when __os__ == "wasm"
			if __os__ != "windows" {
				let _ = try program()
			}
			let current = runningWatcher()
			if current is none {
				let seen = systemRead() onerror recover ""
				let started = new ClipboardWatcher(period, seen)
				watcher = started
				async watchLoop(started)
				return none
			}
			let running ClipboardWatcher = current
			running.changePeriod(period)
			return none
		}

		// Stops the watcher task; nothing happens when none runs.
		@commit()
		def unwatch() {
			let current = watcher
			return when current is none
			let running ClipboardWatcher = current
			running.stop()
		}

		// Emitted by the watcher when the clipboard text changed.
		@emit()
		def changed(change ClipboardChange) ClipboardChange {
			return change
		}

		// Emitted before the clipboard is read, inside `paste` and `has`: a handler that
		// has the clipboard at hand calls `request.answer(text)`.
		@emit(immediate = true)
		def reading(request ClipboardRequest) ClipboardRequest {
			return request
		}

		// Emitted before the clipboard is written, inside `copy` and `clear`: a handler
		// that put `request.text` on the clipboard calls `request.done()`.
		@emit(immediate = true)
		def writing(request ClipboardRequest) ClipboardRequest {
			return request
		}

		// The clipboard text, from a `reading` handler when one answers, else from the clipboard program.
		//
		// Fails when no handler answers and this machine has no clipboard program or the program fails.
		def readText() !string {
			let request = reading(new ClipboardRequest())
			return request.text when request.answered
			return try systemRead()
		}

		// --- the system clipboard: a clipboard program, Windows' own, the browser's on the web ---

		@os("linux", "darwin", "android", "ios")
		def systemRead() !string {
			let program = try program()
			return try shellRead(clipboardReadCommand(program))
		}

		@os("linux", "darwin", "android", "ios")
		def systemWrite(text string) !none {
			let program = try program()
			return try shellWrite(clipboardWriteCommand(program), text)
		}

		@os("linux", "darwin", "android", "ios")
		def systemClear() !none {
			let program = try program()
			return try shellRun(clipboardClearCommand(program))
		}

		@os("linux", "darwin", "android", "ios")
		def systemReadData(mime string) !?byte[] {
			let program = try program()
			let command = clipboardReadDataCommand(program, mime)
			fail "clipboard: {clipboardToolName(program)} carries text only" when command == ""
			let text = try shellRead(command)
			return none when text.len() == 0
			return try base64decode(text)
		}

		@os("linux", "darwin", "android", "ios")
		def systemWriteData(mime string, data byte[]) !none {
			let program = try program()
			let command = clipboardWriteDataCommand(program, mime)
			fail "clipboard: {clipboardToolName(program)} carries text only" when command == ""
			return try shellWrite(command, base64encode(data))
		}

		@os("linux", "darwin", "android", "ios")
		def systemFormats() !string[] {
			let program = try program()
			let command = clipboardFormatsCommand(program)
			return textFormats(try systemRead()) when command == ""
			return clipboardFormatsOf(try shellRead(command))
		}

		@os("windows")
		def systemReadData(mime string) !?byte[] {
			fail "clipboard: Windows' own clipboard carries text only here"
		}

		@os("windows")
		def systemWriteData(mime string, data byte[]) !none {
			fail "clipboard: Windows' own clipboard carries text only here"
		}

		@os("windows")
		def systemFormats() !string[] {
			return textFormats(try systemRead())
		}

		@os("wasm")
		def systemReadData(mime string) !?byte[] {
			fail "clipboard: the browser's clipboard carries text only here"
		}

		@os("wasm")
		def systemWriteData(mime string, data byte[]) !none {
			fail "clipboard: the browser's clipboard carries text only here"
		}

		@os("wasm")
		def systemFormats() !string[] {
			return textFormats(try systemRead())
		}

		@os("windows")
		def systemRead() !string {
			return try windowsClipboard.read()
		}

		@os("windows")
		def systemWrite(text string) !none {
			return try windowsClipboard.write(text)
		}

		@os("windows")
		def systemClear() !none {
			return try windowsClipboard.write("")
		}

		@os("wasm")
		def systemRead() !string {
			return try browserClipboardRead()
		}

		@os("wasm")
		def systemWrite(text string) !none {
			return try browserClipboardWrite(text)
		}

		@os("wasm")
		def systemClear() !none {
			return try browserClipboardWrite("")
		}

		// Looks the clipboard program up the first time.
		def search() {
			return when searched
			tool = findClipboardTool()
			searched = true
		}

		// The clipboard program on this machine.
		//
		// Fails when there is none.
		def program() !ClipboardTool {
			search()
			let found = tool
			fail "clipboard: no clipboard program on this machine (wl-clipboard, xclip, xsel or pbcopy)" when found is none
			let present ClipboardTool = found
			return present
		}

		// The watcher while its task runs; none before `watch` and after `unwatch`.
		def runningWatcher() ?ClipboardWatcher {
			let current = watcher
			return none when current is none
			let running ClipboardWatcher = current
			return none unless running.isRunning()
			return running
		}

		// Tells the watcher what this program copied, so its next change reads as own.
		def noteCopied(text string) {
			let current = watcher
			return when current is none
			let running ClipboardWatcher = current
			running.noteCopied(text)
		}

		// Polls the clipboard until the watcher is stopped.
		def watchLoop(running ClipboardWatcher) {
			for running.isRunning() {
				let text = systemRead() onerror recover running.lastSeen()
				if running.observe(text) {
					let _ = changed(ClipboardChange{text: text, own: text.len() > 0 && text == running.copied(), time: time.now()})
				}
				time.sleep(running.period())
			}
		}
	}
	// --- the clipboard programs -------------------------------------------------

	// --- running the programs ---------------------------------------------------
}

internal partial module std.services.clipboard.tools {
	use (
		std.services.runtime::(Runtime)
		std.services.clipboard::(ClipboardTool)
		std.time
	)

	// The characters a MIME type is made of, which a shell leaves alone.
	const mimeCharacters = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789/.+-;=_"

	// Whether `mime` is a plain MIME type (`image/png`, `text/plain;charset=utf-8`):
	// a type, a slash, a subtype, nothing a shell would read.
	def plainMime(mime string) bool {
		return false when mime.len() == 0 || mime.len() > 127
		let allowed = mimeCharacters.bytes()
		for let b in mime.bytes() {
			return false unless allowed.includes(b)
		}
		let slash = mime.indexOf("/")
		return slash > 0 && slash < mime.len() - 1
	}

	// What a clipboard that carries text only offers: `text/plain` when there is text.
	def textFormats(text string) string[] {
		let out string[]
		out.push("text/plain") when text.len() > 0
		return out
	}

	// The MIME types in what a clipboard program listed, one a line: wl-paste lists
	// types, xclip X11 targets, whose text atoms (UTF8_STRING, STRING, TEXT) stand for
	// `text/plain`; the rest of the atoms (TARGETS, TIMESTAMP) are left out.
	def clipboardFormatsOf(listing string) string[] {
		let out string[]
		let atoms = false
		let typed = false
		for let line in listing.split("\n") {
			let name = line.trim()
			continue when name.len() == 0
			if name.contains("/") {
				out.push(name) unless out.includes(name)
				typed = true when name.startsWith("text/")
			} else if name == "UTF8_STRING" || name == "STRING" || name == "TEXT" {
				atoms = true
			}
		}
		out.push("text/plain") when atoms && !typed
		return out
	}

	// The shell command that prints the clipboard's data of a MIME type as base64 on one
	// line, nothing when it offers none; "" for a program that carries text only.
	def clipboardReadDataCommand(tool ClipboardTool, mime string) string {
		match tool {
			case ClipboardTool.WlClipboard:
				return "wl-paste --no-newline --type '{mime}' 2>/dev/null </dev/null | base64 | tr -d '\\n'"
			case ClipboardTool.Xclip:
				return "xclip -selection clipboard -t '{mime}' -o 2>/dev/null </dev/null | base64 | tr -d '\\n'"
			default:
				return ""
		}
	}

	// The shell command that puts its standard input, base64, on the clipboard as a MIME
	// type; "" for a program that carries text only.
	def clipboardWriteDataCommand(tool ClipboardTool, mime string) string {
		match tool {
			case ClipboardTool.WlClipboard:
				return "base64 -d | wl-copy --type '{mime}' 2>/dev/null"
			case ClipboardTool.Xclip:
				return "base64 -d | xclip -selection clipboard -t '{mime}' -i 2>/dev/null"
			default:
				return ""
		}
	}

	// The shell command that lists the types the clipboard offers, one a line; "" for a
	// program that cannot tell.
	def clipboardFormatsCommand(tool ClipboardTool) string {
		match tool {
			case ClipboardTool.WlClipboard:
				return "wl-paste --list-types 2>/dev/null </dev/null"
			case ClipboardTool.Xclip:
				return "xclip -selection clipboard -t TARGETS -o 2>/dev/null </dev/null"
			default:
				return ""
		}
	}

	// The watcher task's state, shared between the task and the service.
	type ClipboardWatcher {
		internal running    bool     = true
		internal delay      duration
		internal seen       string
		internal lastCopied string   = ""

		def new(period duration, seen string) {
			delay = period
			self.seen = seen
		}

		atomic def stop() {
			running = false
		}

		atomic def isRunning() bool {
			return running
		}

		atomic def changePeriod(period duration) {
			delay = period
		}

		atomic def period() duration {
			return delay
		}

		atomic def lastSeen() string {
			return seen
		}

		atomic def noteCopied(text string) {
			lastCopied = text
		}

		atomic def copied() string {
			return lastCopied
		}

		// Records the text and says whether it differs from the last one seen.
		atomic def observe(text string) bool {
			return false when text == seen
			seen = text
			return true
		}
	}

	// The name `ClipboardCapabilities.tool` reports for a program.
	def clipboardToolName(tool ClipboardTool) string {
		match tool {
			case ClipboardTool.WlClipboard:
				return "wl-clipboard"
			case ClipboardTool.Xclip:
				return "xclip"
			case ClipboardTool.Xsel:
				return "xsel"
			case ClipboardTool.Pasteboard:
				return "pbcopy"
		}
		return ""
	}

	// The shell command that prints the clipboard text; it prints nothing when the clipboard is empty.
	def clipboardReadCommand(tool ClipboardTool) string {
		match tool {
			case ClipboardTool.WlClipboard:
				return "wl-paste --no-newline 2>/dev/null </dev/null"
			case ClipboardTool.Xclip:
				return "xclip -selection clipboard -o 2>/dev/null </dev/null"
			case ClipboardTool.Xsel:
				return "xsel --clipboard --output 2>/dev/null </dev/null"
			case ClipboardTool.Pasteboard:
				return "pbpaste 2>/dev/null </dev/null"
		}
		return ""
	}

	// The shell command that puts its standard input on the clipboard.
	def clipboardWriteCommand(tool ClipboardTool) string {
		match tool {
			case ClipboardTool.WlClipboard:
				return "wl-copy 2>/dev/null"
			case ClipboardTool.Xclip:
				return "xclip -selection clipboard -i 2>/dev/null"
			case ClipboardTool.Xsel:
				return "xsel --clipboard --input 2>/dev/null"
			case ClipboardTool.Pasteboard:
				return "pbcopy 2>/dev/null"
		}
		return ""
	}

	// The shell command that empties the clipboard.
	def clipboardClearCommand(tool ClipboardTool) string {
		match tool {
			case ClipboardTool.WlClipboard:
				return "wl-copy --clear 2>/dev/null"
			case ClipboardTool.Xclip:
				return "xclip -selection clipboard -i 2>/dev/null </dev/null"
			case ClipboardTool.Xsel:
				return "xsel --clipboard --clear 2>/dev/null"
			case ClipboardTool.Pasteboard:
				return "pbcopy 2>/dev/null </dev/null"
		}
		return ""
	}

	// The shell test that succeeds when the program is installed and its display is up.
	def clipboardProbeCommand(tool ClipboardTool) string {
		match tool {
			case ClipboardTool.WlClipboard:
				return "[ -n \"$WAYLAND_DISPLAY\" ] && command -v wl-paste >/dev/null 2>&1 && command -v wl-copy >/dev/null 2>&1"
			case ClipboardTool.Xclip:
				return "[ -n \"$DISPLAY\" ] && command -v xclip >/dev/null 2>&1"
			case ClipboardTool.Xsel:
				return "[ -n \"$DISPLAY\" ] && command -v xsel >/dev/null 2>&1"
			case ClipboardTool.Pasteboard:
				return "command -v pbpaste >/dev/null 2>&1 && command -v pbcopy >/dev/null 2>&1"
		}
		return "false"
	}

	// The programs worth trying on this platform, preferred first.
	@os("linux")
	def clipboardToolCandidates() ClipboardTool[] {
		return [ClipboardTool.WlClipboard, ClipboardTool.Xclip, ClipboardTool.Xsel]
	}

	// The programs worth trying on this platform, preferred first.
	@os("darwin")
	def clipboardToolCandidates() ClipboardTool[] {
		return [ClipboardTool.Pasteboard]
	}

	// The programs worth trying on this platform: none.
	@os("windows", "android", "ios")
	def clipboardToolCandidates() ClipboardTool[] {
		return []
	}

	// The first candidate whose probe succeeds; none when no program is usable.
	def findClipboardTool() ?ClipboardTool {
		for let candidate in clipboardToolCandidates() {
			let code = shellExitCode(clipboardProbeCommand(candidate)) onerror recover 1
			return candidate when code == 0
		}
		return none
	}

	// Runs the command and returns its exit code.
	//
	// Fails when the policy denies running programs or the shell could not be started.
	def shellExitCode(command string) !int {
		let ran = try Runtime.run(command)
		return ran.code
	}

	// Runs the command and returns what it printed.
	//
	// Fails when the policy denies running programs, the shell could not be started, or the command exited with an error and printed nothing.
	def shellRead(command string) !string {
		let ran = try Runtime.run(command)
		// wl-paste exits 1 for an empty clipboard, so an empty result is not an error.
		fail "clipboard: the clipboard program exited with {ran.code}" when ran.code != 0 && ran.output.len() > 0
		return ran.output
	}

	// Runs the command with the text as its standard input.
	//
	// Fails when the policy denies running programs, the shell could not be started, or the command exited with an error.
	def shellWrite(command string, text string) !none {
		let ran = try Runtime.run(command, text)
		fail "clipboard: the clipboard program exited with {ran.code}" when ran.code != 0
		return none
	}

	// Runs the command and fails when it exited with an error.
	def shellRun(command string) !none {
		let code = try shellExitCode(command)
		fail "clipboard: the clipboard program exited with {code}" when code != 0
		return none
	}
}
