// The Clipboard service's IDE panel: the clipboard program in use and whether
// the program watches the clipboard.

partial module std.services.clipboard {
	use std.ide::(ide, IdeKind)

	partial service Clipboard {
		@ide(kind = IdeKind.Value, label = "Program", refresh = 10s)
		def ideTool() string {
			let caps = capabilities()
			return caps.available ?? (caps.tool, "none found")
		}

		@ide(kind = IdeKind.Value, label = "Watching", refresh = 1s)
		def ideWatching() bool {
			return watching()
		}
	}
}
