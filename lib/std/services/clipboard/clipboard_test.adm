partial module std.services.clipboard {
	use (
		std.testing
		std.time
		std.services.clipboard.tools::*
	)

	// Records what the observers below saw, so the tests can assert on it.
	internal type ClipboardLog {
		internal copies  string[]
		internal pastes  int               = 0
		internal changes ClipboardChange[]

		atomic def copied(text string) {
			copies.push(text)
		}

		atomic def pasted() {
			pastes += 1
		}

		atomic def changed(change ClipboardChange) {
			changes.push(change)
		}

		atomic def copyCount() int {
			return copies.len()
		}

		atomic def pasteCount() int {
			return pastes
		}

		atomic def changeCount() int {
			return changes.len()
		}

		atomic def lastChange() ?ClipboardChange {
			return none when changes.len() == 0
			return changes[changes.len() - 1]
		}
	}

	internal let clipboardLog = new ClipboardLog()

	// Stands for a window system's clipboard: while `serving`, the handlers below answer
	// the service from `held`.
	internal type HostedClipboard {
		serving bool                = false
		held    string              = ""
		reads   int                 = 0
		// The data held by type.
		data    map<string, byte[]> = map<string, byte[]>{}
	}

	internal let hostedClipboard = new HostedClipboard()

	check "Clipboard" {
		@on(Clipboard.copy)
		def onCopy(evt Event<!none>) {
			clipboardLog.copied(string(evt.params["text"]))
		}

		@on(Clipboard.paste)
		def onPaste(evt Event<!string>) {
			clipboardLog.pasted()
		}

		@on(Clipboard.changed)
		def onChanged(evt Event<ClipboardChange>) {
			clipboardLog.changed(evt.result)
		}

		@on(Clipboard.reading)
		def onReading(evt Event<ClipboardRequest>) {
			return unless hostedClipboard.serving
			hostedClipboard.reads += 1
			let request = evt.result
			if request.mime == "*" {
				let types string[]
				types.push("text/plain") when hostedClipboard.held.len() > 0
				for let (name, _) in hostedClipboard.data {
					types.push(name)
				}
				request.answerFormats(types)
				return
			}
			if request.mime != "" {
				request.answerData(hostedClipboard.data.get(request.mime))
				return
			}
			request.answer(hostedClipboard.held)
		}

		@on(Clipboard.writing)
		def onWriting(evt Event<ClipboardRequest>) {
			return unless hostedClipboard.serving
			let request = evt.result
			if request.mime != "" {
				let data = request.data
				hostedClipboard.data[request.mime] = data unless data is none
				request.done()
				return
			}
			hostedClipboard.held = request.text
			hostedClipboard.data = map<string, byte[]>{}
			request.done()
		}

		// A handler that answers `reading` and `writing` is the clipboard: no program is
		// looked for, `copy`, `paste`, `has` and `clear` go through it and are still
		// observed as commits.
		@test()
		def TestHandlersServeTheClipboard() !none {
			hostedClipboard.serving = true
			defer def () {
				hostedClipboard.serving = false
			}()
			let before = clipboardLog.copyCount()
			try Clipboard.copy("from a window")
			assert hostedClipboard.held == "from a window"
			assert clipboardLog.copyCount() == before + 1
			hostedClipboard.held = "put there by another program"
			assert try Clipboard.paste() == "put there by another program"
			assert try Clipboard.has()
			assert hostedClipboard.reads == 2
			try Clipboard.clear()
			assert hostedClipboard.held == ""
			assert !(try Clipboard.has())
			return none
		}

		// Data of a MIME type goes through the handlers as text does: `copyData` offers it
		// with its type, `pasteData` reads it back and answers none for a type the
		// clipboard lacks, `formats` lists what is offered; a type a shell would read is
		// refused.
		@test()
		def TestHandlersServeData() !none {
			hostedClipboard.serving = true
			hostedClipboard.reads = 0
			defer def () {
				hostedClipboard.serving = false
				hostedClipboard.reads = 0
				hostedClipboard.data = map<string, byte[]>{}
			}()
			let png = byte[137, 80, 78, 71, 13, 10, 26, 10]
			try Clipboard.copyData("image/png", png)
			let got = try Clipboard.pasteData("image/png")
			fail "no data" when got is none
			assert got.equals(png)
			assert try Clipboard.pasteData("image/webp") is none
			hostedClipboard.held = "words"
			let types = try Clipboard.formats()
			assert types.includes("image/png") && types.includes("text/plain")
			assert Clipboard.copyData("image/png; rm -rf x", png) is error
			assert Clipboard.pasteData("") is error
			return none
		}

		// The commands for data: wl-clipboard and xclip carry a type and base64 both
		// ways and list what the clipboard offers; xsel and pbcopy have none. A
		// listing's text atoms read as `text/plain`.
		@test()
		def TestDataCommands() {
			assert clipboardReadDataCommand(ClipboardTool.WlClipboard, "image/png").contains("--type 'image/png'")
			assert clipboardReadDataCommand(ClipboardTool.Xclip, "image/png").contains("-t 'image/png' -o")
			assert clipboardReadDataCommand(ClipboardTool.Xsel, "image/png") == "" && clipboardReadDataCommand(ClipboardTool.Pasteboard, "image/png") == ""
			assert clipboardWriteDataCommand(ClipboardTool.WlClipboard, "image/png").startsWith("base64 -d | wl-copy --type")
			assert clipboardWriteDataCommand(ClipboardTool.Xclip, "image/png").contains("-t 'image/png' -i")
			assert clipboardWriteDataCommand(ClipboardTool.Xsel, "image/png") == ""
			assert clipboardFormatsCommand(ClipboardTool.WlClipboard).contains("--list-types") && clipboardFormatsCommand(ClipboardTool.Xclip).contains("TARGETS")
			assert clipboardFormatsCommand(ClipboardTool.Pasteboard) == ""
			assert clipboardFormatsOf("TARGETS\nTIMESTAMP\nUTF8_STRING\nSTRING\nimage/png\n").join(",") == "image/png,text/plain"
			assert clipboardFormatsOf("text/plain;charset=utf-8\nimage/png\nimage/png\n").join(",") == "text/plain;charset=utf-8,image/png"
			assert clipboardFormatsOf("").len() == 0
			assert textFormats("x").join(",") == "text/plain" && textFormats("").len() == 0
			assert plainMime("image/png") && plainMime("text/plain;charset=utf-8") && !plainMime("png") && !plainMime("image/") && !plainMime("a b/c") && !plainMime("")
		}

		@test()
		def TestToolNames() {
			assert clipboardToolName(ClipboardTool.WlClipboard) == "wl-clipboard"
			assert clipboardToolName(ClipboardTool.Xclip) == "xclip"
			assert clipboardToolName(ClipboardTool.Xsel) == "xsel"
			assert clipboardToolName(ClipboardTool.Pasteboard) == "pbcopy"
		}

		@test()
		def TestCommandsNameTheProgram() {
			assert clipboardReadCommand(ClipboardTool.WlClipboard).startsWith("wl-paste ")
			assert clipboardWriteCommand(ClipboardTool.WlClipboard).startsWith("wl-copy")
			assert clipboardClearCommand(ClipboardTool.WlClipboard).contains("--clear")
			assert clipboardReadCommand(ClipboardTool.Xclip).contains("-selection clipboard -o")
			assert clipboardWriteCommand(ClipboardTool.Xclip).contains("-selection clipboard -i")
			assert clipboardReadCommand(ClipboardTool.Xsel).contains("--output")
			assert clipboardWriteCommand(ClipboardTool.Xsel).contains("--input")
			assert clipboardClearCommand(ClipboardTool.Xsel).contains("--clear")
			assert clipboardReadCommand(ClipboardTool.Pasteboard).startsWith("pbpaste")
			assert clipboardWriteCommand(ClipboardTool.Pasteboard).startsWith("pbcopy")
			assert clipboardProbeCommand(ClipboardTool.WlClipboard).contains("WAYLAND_DISPLAY")
			assert clipboardProbeCommand(ClipboardTool.Xclip).contains("DISPLAY")
		}

		// Every read command keeps its own standard input closed and its errors quiet,
		// so a program never waits on the terminal or writes over the caller's output.
		@test()
		def TestReadCommandsAreQuiet() {
			for let tool in [ClipboardTool.WlClipboard, ClipboardTool.Xclip, ClipboardTool.Xsel, ClipboardTool.Pasteboard] {
				assert clipboardReadCommand(tool).contains("</dev/null")
				assert clipboardReadCommand(tool).contains("2>/dev/null")
			}
		}

		@test()
		def TestShellReadsAndWrites() !none {
			// The system's shell: /bin/sh, or cmd.exe on Windows.
			let windows = __os__ == "windows"
			assert try shellRead(windows ?? ("<nul set /p =one two& exit 0", "printf 'one two'")) == "one two"
			assert try shellRead(windows ?? ("exit 0", "true")) == ""
			assert try shellExitCode("exit 4") == 4
			try shellWrite(windows ?? ("findstr x* >nul", "cat >/dev/null"), "hello")
			try shellRun(windows ?? ("exit 0", "true"))
			let failed = false
			shellRun("exit 2") onerror (err error) {
				failed = true
				recover none
			}
			assert failed
			return none
		}

		// Copies, pastes and watches when this machine has a clipboard program; a
		// machine without one only checks that capabilities say so and that the
		// calls fail.
		@test()
		def TestRoundTripWhenAProgramIsThere() !none {
			let caps = Clipboard.capabilities()
			if !caps.available {
				assert caps.tool == ""
				let failed = false
				Clipboard.paste() onerror (err error) {
					failed = true
					recover ""
				}
				assert failed
				return none
			}
			assert caps.tool.len() > 0
			let before = clipboardLog.copyCount()
			let text = "adm clipboard suite {time.now()}"
			try Clipboard.copy(text)
			assert try Clipboard.paste() == text
			assert try Clipboard.has()
			assert clipboardLog.copyCount() == before + 1
			assert clipboardLog.pasteCount() >= 1
			try Clipboard.clear()
			assert try Clipboard.paste() == ""
			assert !(try Clipboard.has())
			return none
		}

		@test()
		def TestWatchReportsChanges() !none {
			let caps = Clipboard.capabilities()
			return none unless caps.available
			try Clipboard.watch(50ms)
			assert Clipboard.watching()
			let text = "adm clipboard watch {time.now()}"
			try Clipboard.copy(text)
			time.sleep(400ms)
			Clipboard.unwatch()
			time.sleep(100ms)
			assert !Clipboard.watching()
			let last = clipboardLog.lastChange()
			fail "the watcher reported no change" when last is none
			let change ClipboardChange = last
			assert change.text == text
			assert change.own
			try Clipboard.clear()
			return none
		}
	}
}
