@os("wasm")
partial module std.services.clipboard {
	use std.services.browser::(browserFailure)

	// The clipboard's text, through the browser.
	//
	// Fails when the browser refuses.
	internal def browserClipboardRead() !string {
		let status = __webClipboardRead()
		fail browserFailure("clipboard read", int(status)) unless status == 0
		return __webAnswer()
	}

	// Puts the text on the clipboard, through the browser.
	//
	// Fails when the browser refuses.
	internal def browserClipboardWrite(text string) !none {
		let status = __webClipboardWrite(text)
		fail browserFailure("clipboard write", int(status)) unless status == 0
		return none
	}

	@c("adm_web.h", symbol = "adm_web_clipboard_read", ret = "int32_t", params = [])
	def __webClipboardRead() int32;

	@c("adm_web.h", symbol = "adm_web_clipboard_write", ret = "int32_t", params = ["const char*"])
	def __webClipboardWrite(text string) int32;

	@c("adm_web.h", symbol = "adm_web_answer", ret = "const char*", params = [])
	def __webAnswer() string;
}

@os("wasm")
internal partial module std.services.clipboard.tools {
	use std.services.clipboard::(ClipboardTool)

	// None: the web's clipboard is the browser's, which the service calls directly.
	def clipboardToolCandidates() ClipboardTool[] {
		return []
	}
}
