partial module std.services.clipboard {
	// Windows' own clipboard. Opening it is per process, so the service and its
	// watcher task take turns: one call at a time opens, uses and closes it,
	// and a read takes its text before the next one replaces it.
	internal type WindowsClipboard {
		// The clipboard's text; "" when it holds none.
		//
		// Fails when Windows refuses it, as while another program keeps it open.
		atomic def read() !string {
			let status = __winClipboardRead()
			fail windowsClipboardRefused("read", status) unless status == 0
			return __winClipboardAnswer()
		}

		// Puts the text on the clipboard, replacing what was there; "" empties it.
		//
		// Fails when Windows refuses it.
		atomic def write(text string) !none {
			let status = text == "" ?? (__winClipboardClear(), __winClipboardWrite(text))
			fail windowsClipboardRefused("write", status) unless status == 0
			return none
		}
	}

	internal let windowsClipboard = new WindowsClipboard()

	internal def windowsClipboardRefused(what string, status int32) string {
		return "clipboard: Windows refused to {what} the clipboard (error {status})"
	}

	@c(symbol = "adm_win_clipboard_read", ret = "int32_t", params = [])
	internal def __winClipboardRead() int32;

	@c(symbol = "adm_win_clipboard_answer", ret = "const char*", params = [])
	internal def __winClipboardAnswer() string;

	@c(symbol = "adm_win_clipboard_write", ret = "int32_t", params = ["const char*"])
	internal def __winClipboardWrite(text string) int32;

	@c(symbol = "adm_win_clipboard_clear", ret = "int32_t", params = [])
	internal def __winClipboardClear() int32;
}
