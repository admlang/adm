partial module std.services {
	use (
		std.testing
		std.time
	)

	// Records what the observers below saw, so the tests can assert on it.
	internal type ClipboardLog {
		internal copies  string[]
		internal pastes  int               = 0
		internal changes ClipboardChange[]

		atomic def copied(text string) {
			copies.push(text)
		}

		atomic def pasted() {
			pastes += 1
		}

		atomic def changed(change ClipboardChange) {
			changes.push(change)
		}

		atomic def copyCount() int {
			return copies.len()
		}

		atomic def pasteCount() int {
			return pastes
		}

		atomic def changeCount() int {
			return changes.len()
		}

		atomic def lastChange() ?ClipboardChange {
			return none when changes.len() == 0
			return changes[changes.len() - 1]
		}
	}

	internal let clipboardLog = new ClipboardLog()

	check "Clipboard" {
		@on(Clipboard.copy)
		def onCopy(evt Event<!none>) {
			clipboardLog.copied(string(evt.params["text"]))
		}

		@on(Clipboard.paste)
		def onPaste(evt Event<!string>) {
			clipboardLog.pasted()
		}

		@on(Clipboard.changed)
		def onChanged(evt Event<ClipboardChange>) {
			clipboardLog.changed(evt.result)
		}

		@test()
		def TestToolNames() {
			assert clipboardToolName(ClipboardTool.WlClipboard) == "wl-clipboard"
			assert clipboardToolName(ClipboardTool.Xclip) == "xclip"
			assert clipboardToolName(ClipboardTool.Xsel) == "xsel"
			assert clipboardToolName(ClipboardTool.Pasteboard) == "pbcopy"
		}

		@test()
		def TestCommandsNameTheProgram() {
			assert clipboardReadCommand(ClipboardTool.WlClipboard).startsWith("wl-paste ")
			assert clipboardWriteCommand(ClipboardTool.WlClipboard).startsWith("wl-copy")
			assert clipboardClearCommand(ClipboardTool.WlClipboard).contains("--clear")
			assert clipboardReadCommand(ClipboardTool.Xclip).contains("-selection clipboard -o")
			assert clipboardWriteCommand(ClipboardTool.Xclip).contains("-selection clipboard -i")
			assert clipboardReadCommand(ClipboardTool.Xsel).contains("--output")
			assert clipboardWriteCommand(ClipboardTool.Xsel).contains("--input")
			assert clipboardClearCommand(ClipboardTool.Xsel).contains("--clear")
			assert clipboardReadCommand(ClipboardTool.Pasteboard).startsWith("pbpaste")
			assert clipboardWriteCommand(ClipboardTool.Pasteboard).startsWith("pbcopy")
			assert clipboardProbeCommand(ClipboardTool.WlClipboard).contains("WAYLAND_DISPLAY")
			assert clipboardProbeCommand(ClipboardTool.Xclip).contains("DISPLAY")
		}

		// Every read command keeps its own standard input closed and its errors quiet,
		// so a program never waits on the terminal or writes over the caller's output.
		@test()
		def TestReadCommandsAreQuiet() {
			for let tool in [ClipboardTool.WlClipboard, ClipboardTool.Xclip, ClipboardTool.Xsel, ClipboardTool.Pasteboard] {
				assert clipboardReadCommand(tool).contains("</dev/null")
				assert clipboardReadCommand(tool).contains("2>/dev/null")
			}
		}

		@test()
		def TestShellReadsAndWrites() !none {
			assert try shellRead("printf 'one two'") == "one two"
			assert try shellRead("true") == ""
			assert try shellExitCode("exit 4") == 4
			try shellWrite("cat >/dev/null", "hello")
			try shellRun("true")
			let failed = false
			shellRun("exit 2") onerror (err error) {
				failed = true
				recover none
			}
			assert failed
			return none
		}

		// Copies, pastes and watches when this machine has a clipboard program; a
		// machine without one only checks that capabilities say so and that the
		// calls fail.
		@test()
		def TestRoundTripWhenAProgramIsThere() !none {
			let caps = Clipboard.capabilities()
			if !caps.available {
				assert caps.tool == ""
				let failed = false
				Clipboard.paste() onerror (err error) {
					failed = true
					recover ""
				}
				assert failed
				return none
			}
			assert caps.tool.len() > 0
			let before = clipboardLog.copyCount()
			let text = "adm clipboard suite {time.now()}"
			try Clipboard.copy(text)
			assert try Clipboard.paste() == text
			assert try Clipboard.has()
			assert clipboardLog.copyCount() == before + 1
			assert clipboardLog.pasteCount() >= 1
			try Clipboard.clear()
			assert try Clipboard.paste() == ""
			assert !(try Clipboard.has())
			return none
		}

		@test()
		def TestWatchReportsChanges() !none {
			let caps = Clipboard.capabilities()
			return none unless caps.available
			try Clipboard.watch(50ms)
			assert Clipboard.watching()
			let text = "adm clipboard watch {time.now()}"
			try Clipboard.copy(text)
			time.sleep(400ms)
			Clipboard.unwatch()
			time.sleep(100ms)
			assert !Clipboard.watching()
			let last = clipboardLog.lastChange()
			fail "the watcher reported no change" when last is none
			let change ClipboardChange = last
			assert change.text == text
			assert change.own
			try Clipboard.clear()
			return none
		}
	}
}
