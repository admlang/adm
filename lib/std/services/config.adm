partial module std.services {
	use (
		std.reflection::(VariableMetaContext, FieldMetaContext)
		std.time
	)

	interface ConfigSource {
		def name() string
		def load() !map<string, any>
	}

	interface WatchableConfigSource {
		def watch(changed def()) !none
		def unwatch() !none
	}

	struct ConfigSourceConfig {
		source   ConfigSource
		optional bool         = false
	}

	struct ConfigConfig {
		// Active configuration profile.
		//
		// When none, only non-profile/default configuration is loaded.
		profile ?string

		// Configuration sources in ascending precedence order.
		//
		// Values from later sources override values from earlier sources.
		sources ConfigSource[]
	}

	struct ConfigChange {
		key      string
		oldValue ?any
		newValue ?any
		source   ?string
	}

	struct ConfigReloadError {
		source ?string
		error  Error
	}

	service Config {
		description           = ""
		dependencies          = Dependencies{
			hard: [Runtime]
		}
		lifecycle             = Lifecycle{
			start: StartMode.Manual,
			restart: RestartMode.Always,
		}
		permissions  string[]

		def config(val ConfigConfig) !none {}

		async def start() !none {
			return none
		}

		async def stop() !none {
			return none
		}

		async def restart() !none {
			return none
		}

		// Switches the active configuration profile and reloads all sources.
		//
		// The profile is changed only if the resulting configuration can be loaded
		// successfully. Otherwise, the current profile and configuration remain active.
		@commit()
		def switchProfile(profile ?string) !none {}

		// Returns the currently active configuration profile.
		@query()
		def profile() ?string {
			return none
		}

		// Returns the effective value associated with the key.
		//
		// Returns none if the key is not defined by any source.
		@query()
		def get(key string) ?any {
			return none
		}

		// Returns the effective value associated with the key converted to T.
		//
		// Returns none if the key is not defined by any source.
		@query()
		def get<T>(key string) !?T {
			return none
		}

		// Returns whether an effective value exists for the key.
		@query()
		def has(key string) bool {
			return false
		}

		// Sets a runtime override for the key.
		//
		// Runtime overrides have precedence over configured sources and are not
		// written back to the source that originally provided the value.
		@commit()
		def set(key string, value any) {}

		// Removes the runtime override for the key.
		//
		// The effective value falls back to the highest-precedence configured
		// source that defines the key.
		@commit()
		def reset(key string) {}

		// Reloads all configured sources and recomputes the effective configuration.
		@commit()
		def reload() !none {}

		// Returns the configured sources in precedence order.
		@query()
		def sources() ConfigSourceConfig[] {
			return []
		}

		// Returns the configured source with the specified name.
		@query()
		def source(name string) ?ConfigSourceConfig {
			return none
		}

		// Returns the source currently providing the effective value for the key.
		//
		// Returns none if the value is a runtime override or the key does not exist.
		@query()
		def sourceOf(key string) ?ConfigSource {
			return none
		}

		// Returns the last time the effective configuration was successfully loaded.
		@query()
		def lastLoaded() time.Time {
			return time.Time{}
		}

		// Emitted when the effective value of a configuration key changes.
		//
		// Source changes that do not alter the effective value do not emit this event.
		@emit()
		def changed(change ConfigChange) ConfigChange {
			return change
		}

		// Emitted when a configuration source cannot be reloaded.
		//
		// The current effective configuration remains unchanged.
		@emit()
		def reloadFailed(event ConfigReloadError) ConfigReloadError {
			return event
		}
	}

	// Binds the annotated variable to the effective configuration value.
	//
	// The target's type determines the expected configuration value type.
	// An optional target resolves to none when the key is not defined.
	// A non-optional target causes configuration loading to fail when no value
	// or default value is available.
	meta def config(target VariableMetaContext, key string, defaultValue ?any = none) {}

	// Binds the annotated field to the effective configuration value.
	meta def config(target FieldMetaContext, key string, defaultValue ?any = none) {}
}
