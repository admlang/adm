partial module std.services.config {
	use (
		std.reflection
		std.reflection::(FieldMetaContext, TypeDescriptor, ValueEditor, VariableMetaContext)
		std.services::(Dependencies, Lifecycle, RestartMode, StartMode)
		std.services.config.values::(Difference, Loaded, Values, View, canonical, differences, fit, overridden, typed)
		std.services.runtime::(Runtime)
		std.services.storage::(Storage)
		std.time
	)

	// Where configuration values come from: a file, the environment, a remote store.
	//
	// name tells the sources of one configuration apart. load returns every key the source
	// holds: a value under a dotted key (`"db.host"`), or maps nested by name
	// (`{"db": {"host": ...}}`), which the service reads as the same keys. The keys under
	// `profiles.<name>.` belong to that profile: they replace the plain keys while the
	// profile is active and are left out otherwise. load runs while the service changes its
	// values, so it must not call `Config`.
	interface ConfigSource {
		def name() string
		def load() !map<string, any>
	}

	// A source that reports its own changes; the Config service reloads when changed
	// fires.
	interface WatchableConfigSource {
		def watch(changed def ()) !none
		def unwatch() !none
	}

	// A source and whether the service tolerates it failing to load.
	struct SourceConfig {
		source   ConfigSource
		optional bool         = false
	}

	// Settings for the Config service: the active profile and the sources.
	struct ConfigConfig {
		// Active configuration profile.
		//
		// When none, only non-profile/default configuration is loaded.
		profile ?string

		// Configuration sources in ascending precedence order.
		//
		// Values from later sources override values from earlier sources.
		sources SourceConfig[]
	}

	// One key's old and new value, and the source that changed it.
	struct ConfigChange {
		// The key as its source spells it.
		key      string
		// None for a key that had no value.
		oldValue ?any
		// None for a key that has no value any more.
		newValue ?any
		// The name of the source the new value comes from, or that held the old value of a
		// key that is gone; none for an override.
		source   ?string
	}

	// A source that failed to reload, with the error it raised.
	struct ConfigReloadError {
		source ?string
		error  error
	}

	// One source of the configuration and what it last loaded.
	internal type Layer {
		source   ConfigSource
		optional bool
		held     Loaded

		def new(source ConfigSource, optional bool) {
			self.source = source
			self.optional = optional
			held = new Loaded()
		}
	}

	// What reads answer from: the values in effect with the settings they were merged
	// under. Never changed once it is published; a change publishes another.
	internal type Snapshot {
		current View
		profile ?string
		// Lowest precedence first: the layer numbers of `current`.
		sources SourceConfig[]
		loaded  time.Time      = time.Time{}

		def new() {
			current = new View()
		}
	}

	// The snapshot reads answer from, behind a lock of its own: a read never waits for a
	// source that is loading.
	internal type Published {
		now Snapshot

		def new() {
			now = new Snapshot()
		}

		atomic def get() Snapshot {
			return now
		}

		atomic def set(next Snapshot) {
			now = next
		}
	}

	// A module variable filled by `@config`, kept to fill it again when its key changes.
	internal type Binding {
		key      string
		editor   ValueEditor
		declared TypeDescriptor
		fallback ?any

		def new(key string, editor ValueEditor, declared TypeDescriptor, fallback ?any) {
			self.key = key
			self.editor = editor
			self.declared = declared
			self.fallback = fallback
		}
	}

	// The `@config` variables read so far.
	internal type Bindings {
		all Binding[]

		def new() {}

		atomic def add(binding Binding) {
			all.push(binding)
		}

		// The variables whose key is one of the changed keys or holds one below it.
		atomic def touchedBy(changes Difference[]) Binding[] {
			let out Binding[] = []
			for let (_, binding) in all {
				let name = canonical(binding.key)
				let below = name + "."
				for let (_, change) in changes {
					let changed = canonical(change.key)
					continue unless changed == name || changed.startsWith(below)
					out.push(binding)
					break
				}
			}
			return out
		}
	}

	// What loading the sources came to: the keys that changed, the sources that failed,
	// and the failure that left the values as they were.
	internal struct Outcome {
		changes  ConfigChange[]
		failures ConfigReloadError[]
		refused  ?error
	}

	internal let published = new Published()
	internal let bindings = new Bindings()

	// Sets the value through editor to the key's value, else to the fallback, as one of the
	// declared type. With neither, a variable (`clears`) that is optional becomes none and
	// anything else keeps what it holds, as does one whose value does not read as its type.
	internal def fill(editor ValueEditor, declared TypeDescriptor, key string, value ?any, fallback ?any, clears bool) {
		let chosen = value
		chosen = fallback when chosen is none
		if chosen is none {
			editor.clear() when clears && declared.optional
			return
		}
		let read = true
		let fitted = fit(chosen, declared, key) onerror (err error) {
			read = false
			recover chosen
		}
		editor.set(fitted) when read
	}

	// The argument of an annotation as reflection lists it: by name, else by position.
	internal def argument(given map<string, any>, name string, position int) ?any {
		return given.get(name) when given.hasKey(name)
		return given.get("#{position}")
	}

	// A `@config` module variable of the program: what a load must give it.
	internal struct Demand {
		// The variable's qualified name.
		name     string
		key      string
		declared TypeDescriptor
		// Whether the key must have a value: the variable is not optional and has no default.
		needed   bool
	}

	// The `@config` module variables of the program, listed once for each state of the
	// reflection tables (a loaded plugin adds its own).
	internal type Demands {
		hits int      = -1
		all  Demand[]

		def new() {}

		atomic def list() Demand[] {
			let found = reflection.attrs(config)
			return all when found.len() == hits
			let next Demand[] = []
			for let (_, hit) in found {
				let variable = reflection.asVariable(hit.node)
				continue when variable is none
				let named = argument(hit.attr.arguments, "key", 0)
				continue when named is none
				let declared = variable.typeDescriptor
				let needed = !declared.optional && argument(hit.attr.arguments, "defaultValue", 1) is none
				next.push(Demand{name: hit.node.qualifiedName, key: reflection.scalarText(named), declared: declared, needed: needed})
			}
			all = next
			hits = found.len()
			return all
		}
	}

	internal let demands = new Demands()

	// Checks every `@config` module variable of the program against values: its key must
	// read as the variable's type, and a variable that is not optional and has no default
	// must have its key.
	//
	// Fails naming the first variable that does not hold.
	internal def demanded(values Values) !none {
		for let (_, demand) in demands.list() {
			let value = values.get(demand.key)
			if value is none {
				fail "config: {demand.key} is not set, and {demand.name} has no default" when demand.needed
				continue
			}
			fit(value, demand.declared, demand.key) onerror (err error) {
				fail "{err.message} ({demand.name})"
			}
		}
		return none
	}

	// Loads configuration from the configured sources, merges them by precedence and reports
	// changes.
	//
	// ```
	// try Config.config(
	// 	ConfigConfig{
	// 		sources: [
	// 			SourceConfig{source: new FileSource("app.toml")},
	// 			SourceConfig{source: new FileSource("local.toml"), optional: true},
	// 		],
	// 	}
	// )
	// try await Config.start()
	//
	// let port = try Config.get<int>("server.port")
	// ```
	//
	// Later sources win over earlier ones, and a source that is not optional must load. A
	// key is a path of names joined by dots, compared without case and without the `-` and
	// `_` inside its names: `db.maxConnections` and `DB.MAX_CONNECTIONS` are one key. A key
	// that names no value but has keys below it reads as the map of those.
	//
	// A profile is a set of keys a source keeps under `profiles.<name>.`: while the profile
	// is active they replace the same source's plain keys, and they are left out otherwise.
	//
	// Reads answer from memory and never wait for a source.
	service Config {
		description               = "Loads configuration from sources, merged by precedence"
		dependencies              = Dependencies{
			hard: [Runtime, Storage]
		}
		lifecycle                 = Lifecycle{
			start: StartMode.Manual,
			restart: RestartMode.Always,
		}
		permissions  Permission[]

		// The configured sources, lowest precedence first, and the active profile.
		layers    Layer[]
		chosen    ?string   = none
		overrides Values    = new Values()
		running   bool
		// When every source last loaded without error.
		loadedAt  time.Time = time.Time{}

		// Applies the profile and the sources. On a started service the new sources are
		// loaded at once and watched in place of the old ones; on one that is not, they are
		// loaded by `start`, and until then only overrides have values.
		//
		// Fails when a source has no name or two have the same one, and on a started
		// service as `reload` does: the sources and values of before then stay.
		def config(val ConfigConfig) !none {
			let next Layer[] = []
			let names = map<string, bool>{}
			for let (_, given) in val.sources {
				let name = given.source.name()
				fail "config: a source has no name" when name == ""
				fail "config: two sources are named '{name}'" when names.hasKey(name)
				names[name] = true
				next.push(new Layer(given.source, given.optional))
			}
			let adopted = adopt(next, val.profile)
			return try conclude(adopted) unless adopted is none
			let before = watched()
			let outcome = loadNow(next, val.profile)
			try conclude(outcome)
			unwatch(before)
			watch(next)
			return none
		}

		// Takes the sources and the profile of a service that is not started: what the
		// sources of before loaded is gone, and the overrides stay. None when the service
		// is started.
		atomic def adopt(next Layer[], profile ?string) ?Outcome {
			return none when running
			layers = next
			chosen = profile
			let loads Loaded[] = []
			for let (_, layer) in next {
				loads.push(layer.held)
			}
			return Outcome{changes: publish(new View(loads, profile, overrides))}
		}

		// Loads every source and starts watching the ones that can be watched.
		//
		// Fails when a source that is not optional cannot be loaded, when a `@config`
		// variable that is not optional and has no default finds no value for its key, and
		// when a value does not read as the type of the `@config` variable it fills.
		async def start() !none {
			let outcome = loadNow(watched(), profile())
			try conclude(outcome)
			watch(opened())
			return none
		}

		// Stops watching the sources. The values stay readable. Does not fail.
		async def stop() !none {
			unwatch(closed())
			return none
		}

		// Stops the service and starts it again, reloading every source.
		//
		// Fails as `start` does.
		async def restart() !none {
			try await stop()
			try await start()
			return none
		}

		// The configured sources.
		atomic def watched() Layer[] {
			return layers
		}

		// Marks the service started; its sources.
		atomic def opened() Layer[] {
			running = true
			return layers
		}

		// Marks the service stopped; the sources it watched.
		atomic def closed() Layer[] {
			let were Layer[] = []
			were = layers when running
			running = false
			return were
		}

		// Asks each source that reports its own changes to do so.
		def watch(sources Layer[]) {
			for let (_, layer) in sources {
				let source = layer.source
				continue unless source is WatchableConfigSource
				let live WatchableConfigSource = source
				live.watch(
					() => {
						Config.reload() onerror recover none
					}
				) onerror (err error) {
					reloadFailed(ConfigReloadError{source: layer.source.name(), error: err})
					recover none
				}
			}
		}

		def unwatch(sources Layer[]) {
			for let (_, layer) in sources {
				let source = layer.source
				continue unless source is WatchableConfigSource
				let live WatchableConfigSource = source
				live.unwatch() onerror recover none
			}
		}

		atomic def loadNow(next Layer[], profile ?string) Outcome {
			return load(next, profile)
		}

		// Loads the sources and, when every one that is not optional loaded and the
		// program's `@config` variables hold, makes them and the profile the service's
		// own. An optional source that fails keeps what it last loaded. The caller holds
		// the service's lock.
		def load(next Layer[], profile ?string) Outcome {
			let outcome = Outcome{}
			let loads Loaded[] = []
			for let (_, layer) in next {
				let failure ?error = none
				let given = layer.source.load() onerror (err error) {
					failure = err
					recover map<string, any>{}
				}
				if failure is none {
					loads.push(new Loaded(given))
					continue
				}
				outcome.failures.push(ConfigReloadError{source: layer.source.name(), error: failure})
				loads.push(layer.held)
				continue when layer.optional
				outcome.refused = failure
				return outcome
			}
			let merged = new View(loads, profile, overrides)
			demanded(merged.values) onerror (err error) {
				outcome.refused = err
				recover none
			}
			return outcome unless outcome.refused is none
			for let (index, layer) in next {
				layer.held = loads[index]
			}
			layers = next
			chosen = profile
			loadedAt = time.now() when outcome.failures.len() == 0
			outcome.changes = publish(merged)
			return outcome
		}

		// Makes merged what reads answer from, fills the `@config` variables whose keys
		// changed, and returns the changes. The caller holds the service's lock.
		def publish(merged View) ConfigChange[] {
			let before = published.get()
			let next = new Snapshot()
			next.current = merged
			next.profile = chosen
			next.loaded = loadedAt
			for let (_, layer) in layers {
				next.sources.push(SourceConfig{source: layer.source, optional: layer.optional})
			}
			published.set(next)
			let differing = differences(before.current, merged)
			for let (_, binding) in bindings.touchedBy(differing) {
				fill(binding.editor, binding.declared, binding.key, merged.values.get(binding.key), binding.fallback, true)
			}
			let out ConfigChange[] = []
			for let (_, change) in differing {
				let origin ?string = none
				origin = layers[change.layer].source.name() when change.layer != overridden && change.layer < layers.len()
				out.push(ConfigChange{key: change.key, oldValue: change.before, newValue: change.after, source: origin})
			}
			return out
		}

		// Emits what a load came to. Fails with the failure that refused it.
		def conclude(outcome Outcome) !none {
			for let (_, failure) in outcome.failures {
				reloadFailed(failure)
			}
			for let (_, change) in outcome.changes {
				changed(change)
			}
			let refused = outcome.refused
			fail refused unless refused is none
			return none
		}

		// Switches to the profile and reloads every source.
		//
		// When the reload fails the old profile and its values stay in place. Fails as
		// `reload` does.
		@commit()
		def switchProfile(profile ?string) !none {
			return try conclude(load(layers, profile))
		}

		// The active profile, or none when no profile is selected.
		@query()
		def profile() ?string {
			return published.get().profile
		}

		// The value the key resolves to, or none when no source defines it. A key that
		// names no value but has keys below it gives those as a `map<string, any>`.
		@query()
		def get(key string) ?any {
			return published.get().current.values.get(key)
		}

		// The value the key resolves to, converted to T; none when no source defines it, an error
		// when it does not convert.
		//
		// A number, a bool or a duration reads from its text too (what an environment
		// variable holds), an enum member from its name, a list from the texts between the
		// commas of a text, and a struct or a type from the keys below the key, by its
		// fields' names.
		//
		// Fails when the value does not read as a T or does not fit it.
		@query()
		def get<T>(key string) !?T {
			let value = published.get().current.values.get(key)
			return none when value is none
			return try typed<T>(value, key)
		}

		// Whether some source or an override defines the key, or a key below it.
		@query()
		def has(key string) bool {
			return published.get().current.values.has(key)
		}

		// Overrides the key for this process.
		//
		// An override wins over every source and is never written back to one. A map
		// overrides the keys below the key, one for each of its values.
		@commit()
		def set(key string, value any) {
			overrides.drop(key)
			overrides.add(key, value)
			merge()
		}

		// Drops the override on the key and on the keys below it.
		//
		// The key goes back to whatever the sources say.
		@commit()
		def reset(key string) {
			merge() when overrides.drop(key)
		}

		// Merges what the sources hold with the overrides again and emits the changes.
		def merge() {
			let loads Loaded[] = []
			for let (_, layer) in layers {
				loads.push(layer.held)
			}
			for let (_, change) in publish(new View(loads, chosen, overrides)) {
				changed(change)
			}
		}

		// Reloads every source.
		//
		// Fails when a source that is not optional cannot be loaded, and as `start` does
		// for the program's `@config` variables: the values of before then stay. A source
		// that fails is emitted as `reloadFailed` whether or not it is optional.
		@commit()
		def reload() !none {
			return try conclude(load(layers, chosen))
		}

		// The sources, highest precedence first.
		@query()
		def sources() SourceConfig[] {
			let out SourceConfig[] = []
			let held = published.get().sources
			for let i = held.len() - 1; i >= 0; i-- {
				out.push(held[i])
			}
			return out
		}

		// The source with that name, or none.
		@query()
		def source(name string) ?SourceConfig {
			for let (_, held) in published.get().sources {
				return held when held.source.name() == name
			}
			return none
		}

		// The source the key's value comes from; none for an override or an unknown key.
		@query()
		def sourceOf(key string) ?ConfigSource {
			let now = published.get()
			let layer = now.current.values.layerOf(key)
			return none when layer is none || layer == overridden || layer >= now.sources.len()
			return now.sources[layer].source
		}

		// When the sources last loaded without error; the zero time before that.
		@query()
		def lastLoaded() time.Time {
			return published.get().loaded
		}

		// Emitted when a key's value changes: by a reload, a change of profile or of
		// sources, `set` or `reset`. The first load of a run emits every key it defines.
		//
		// A reload that leaves the value as it was emits nothing.
		@emit()
		def changed(change ConfigChange) ConfigChange {
			return change
		}

		// Emitted when a source fails to load.
		//
		// The values from the last good load stay in place.
		@emit()
		def reloadFailed(event ConfigReloadError) ConfigReloadError {
			return event
		}
	}

	// Fills the variable from the configuration key.
	//
	// The value is converted to the variable's type, as `Config.get<T>` converts it. An
	// optional variable reads none when the key is missing; a non-optional one with no
	// default makes configuration loading fail. The variable is filled when the program
	// first reads it and again whenever its key changes.
	meta def config(target VariableMetaContext, key string, defaultValue ?any = none) {
		let declared = target.descriptor.typeDescriptor
		bindings.add(new Binding(key, target.editor, declared, defaultValue))
		fill(target.editor, declared, key, published.get().current.values.get(key), defaultValue, true)
	}

	// Fills the field from the configuration key.
	//
	// The value is converted to the field's type, as `Config.get<T>` converts it; a field
	// whose key is missing takes the default, and keeps what it holds when there is none.
	// The field is filled when its object is made and whenever it is assigned: while its
	// key has a value, that value is what the field holds.
	meta def config(target FieldMetaContext, key string, defaultValue ?any = none) {
		fill(target.editor, target.descriptor.typeDescriptor, key, published.get().current.values.get(key), defaultValue, false)
	}
}
