// The Config service's IDE panel: the profile, every value with the source
// it comes from, the sources, and the buttons that reload, switch profile,
// override a value and drop an override.

partial module std.services.config {
	use (
		std.ide::(ide, IdeKind, IdeTable, hiddenValue, secretShaped)
		std.services.config.values::(overridden)
	)

	partial service Config {
		@ide(kind = IdeKind.Value, label = "Profile", refresh = 1s)
		def ideProfile() string {
			let active = profile()
			return active is none ?? ("(none)", active)
		}

		@ide(kind = IdeKind.Value, label = "Last loaded", refresh = 1s)
		def ideLoaded() string {
			return "{lastLoaded()}"
		}

		@ide(kind = IdeKind.Table, label = "Values", refresh = 1s, rows = 0)
		def ideValues() IdeTable {
			let now = published.get()
			let entries = now.current.values.entries
			let names = entries.keys()
			names.sort((a, b) => a < b)
			let rows = string[][]
			for let (_, name) in names {
				let entry = entries[name]
				let source = "override"
				if entry.layer != overridden {
					source = entry.layer >= 0 && entry.layer < now.sources.len() ?? (now.sources[entry.layer].source.name(), "")
				}
				let shown = secretShaped(entry.key) ?? (hiddenValue("{entry.value}"), "{entry.value}")
				rows.push([entry.key, shown, source])
			}
			return IdeTable{columns: ["Key", "Value", "From"], rows: rows}
		}

		@ide(kind = IdeKind.Table, label = "Sources", refresh = 5s, rows = 4)
		def ideSources() IdeTable {
			let rows = string[][]
			for let (_, given) in sources() {
				rows.push([given.source.name(), given.optional ?? ("optional", "")])
			}
			return IdeTable{columns: ["Source, highest first", ""], rows: rows}
		}

		// A value the Values table hides because its key looks like a secret.
		@ide(kind = IdeKind.Action, label = "Show value", confirm = "Show this value? It may be a secret.", row = "ideValues.Key")
		def ideShowValue(key string) string {
			let value = get(key)
			return value is none ?? ("(not set)", "{value}")
		}

		@ide(kind = IdeKind.Action, label = "Reload")
		def ideReload() !none {
			return reload()
		}

		// Switches to the profile named, or to none when the name is empty.
		@ide(kind = IdeKind.Action, label = "Switch profile")
		def ideSwitchProfile(profile string) !none {
			if profile == "" {
				return switchProfile(none)
			}
			return switchProfile(profile)
		}

		// Overrides a key's value with the text given, for the rest of the run.
		@ide(kind = IdeKind.Action, label = "Override")
		def ideSet(key string, value string) {
			set(key, value)
		}

		@ide(kind = IdeKind.Action, label = "Drop override", row = "ideValues.Key")
		def ideReset(key string) {
			reset(key)
		}
	}
}
