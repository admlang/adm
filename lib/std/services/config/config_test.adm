partial module std.services.config {
	use (
		std.os
		std.services::(Application)
		std.services.runtime::(Runtime)
		std.services.config.values::(Boxed, Loaded, Values, View, canonical, differences, typed)
		std.testing
		std.time
	)

	// A source that holds what a test gives it, and fails while told to.
	internal type MemorySource {
		label  string
		held   map<string, any>
		broken bool             = false
		loads  int              = 0

		def new(label string, held map<string, any>) {
			self.label = label
			self.held = held
		}

		// name implements ConfigSource.
		def name() string {
			return label
		}

		// load implements ConfigSource. Fails while `broken` is set.
		def load() !map<string, any> {
			loads++
			fail "{label} cannot be reached" when broken
			return held
		}
	}

	internal enum Mode {
		Fast,
		Careful,
	}

	internal struct Pool {
		size int      = 4
		idle duration = 30s
	}

	internal struct Database {
		host           string   = "unset"
		port           int      = 0
		maxConnections int      = 1
		mode           Mode     = Mode.Fast
		replicas       string[]
		pool           Pool
		note           ?string  = none
	}

	internal let seenChanges = new channel<string>(256)
	internal let seenFailures = new channel<string>(64)

	@on(Config.changed)
	internal def onChanged(evt Event<ConfigChange>) {
		let change = evt.result
		let origin = change.source
		let before = change.oldValue
		let after = change.newValue
		let was = "none"
		was = "{before}" unless before is none
		let now = "none"
		now = "{after}" unless after is none
		seenChanges.offer("{change.key}: {was} -> {now} ({origin is none ?? ("override", origin)})")
	}

	@on(Config.reloadFailed)
	internal def onReloadFailed(evt Event<ConfigReloadError>) {
		let origin = evt.result.source
		seenFailures.offer("{origin is none ?? ("", origin)}: {evt.result.error.message}")
	}

	// The texts that come from the channel until none comes for a tenth of a second (for
	// `first`, while none has come), sorted.
	internal def collected(from channel<string>, first duration = 100ms) string[] {
		let out string[] = []
		for {
			let limit = time.sleepChan(out.len() == 0 ?? (first, 100ms))
			let got = ""
			select {
				case from:
					got = <-from
				case limit:
					return out.sort((a, b) => a < b)
			}
			out.push(got)
		}
		return out
	}

	// Stops the service and leaves it without sources, profile and events.
	internal def cleared() !none {
		try await Config.stop()
		try Config.config(ConfigConfig{})
		Config.set("bound.required", "given")
		seenChanges.flush()
		seenFailures.flush()
		return none
	}

	// Starts the service on the sources, lowest precedence first.
	internal def started(sources SourceConfig[], profile ?string = none) !none {
		try cleared()
		try Config.config(ConfigConfig{profile: profile, sources: sources})
		try await Config.start()
		return none
	}

	// A folder for the files of one test, emptied first.
	internal def scratch(name string) !string {
		let folder = (try Application.home()) + "/config-test/" + name
		os.remove(folder, true) onerror recover none
		try os.mkdir(folder, true)
		return folder
	}

	// The value of a key that has one, as a T. Fails when it has none or does not convert.
	internal def read<T>(key string) !T {
		let value = try Config.get<T>(key)
		fail "config test: {key} has no value" when value is none
		return value
	}

	// The message `typed<T>` refuses the value with, "" when it takes it.
	internal def refused<T>(value any, key string) string {
		let message = ""
		typed<T>(value, key) onerror (err error) {
			message = err.message
			recover Boxed<T>{}.value
		}
		return message
	}

	// The message reading the key as a T fails with, "" when it reads.
	internal def readRefusal<T>(key string) string {
		let message = ""
		Config.get<T>(key) onerror (err error) {
			message = err.message
			recover none
		}
		return message
	}

	internal def reloadRefusal() string {
		let message = ""
		Config.reload() onerror (err error) {
			message = err.message
			recover none
		}
		return message
	}

	internal def switchRefusal(profile string) string {
		let message = ""
		Config.switchProfile(profile) onerror (err error) {
			message = err.message
			recover none
		}
		return message
	}

	internal def configRefusal(settings ConfigConfig) string {
		let message = ""
		Config.config(settings) onerror (err error) {
			message = err.message
			recover none
		}
		return message
	}

	internal def loadRefusal(source FileSource) string {
		let message = ""
		source.load() onerror (err error) {
			message = err.message
			recover map<string, any>{}
		}
		return message
	}

	// The name of the source a key's value comes from, "" for none.
	internal def originOf(key string) string {
		let source = Config.sourceOf(key)
		return "" when source is none
		return source.name()
	}

	// The active profile, "" for none.
	internal def profileName() string {
		let profile = Config.profile()
		return "" when profile is none
		return profile
	}

	// Module variables filled from the configuration.
	@config("bound.port", 8080)
	internal let boundPort = 0

	@config("bound.host")
	internal let boundHost ?string = "declared"

	@config("bound.mode", "careful")
	internal let boundMode = Mode.Fast

	@config("bound.wait", 5s)
	internal let boundWait = 0s

	@config("bound.pool")
	internal let boundPool ?Pool = none

	// Has no default and is not optional: a load without its key is refused. `cleared`
	// gives it a value so that the other tests load.
	@config("bound.required")
	internal let boundRequired = ""

	// A type whose fields are filled from the configuration.
	internal type Worker {
		@config("bound.workers", 4)
		workers int = 1

		@config("bound.label")
		label string = "declared"

		@config("bound.note")
		note ?string = none

		def new() {}
	}

	check "Config values" {
		@test()
		def canonicalKeys() !none {
			assert canonical("db.host") == "db.host"
			assert canonical("DB.Max_Connections") == "db.maxconnections"
			assert canonical("db.max-connections") == "db.maxconnections"
			assert canonical("") == ""
			return none
		}

		@test()
		def nestedMapsBecomeDottedKeys() !none {
			let values = new Values()
			values.add("", {"db": {"host": "a", "pool": {"size": 8}}, "name": "app"})
			values.add("db.port", 5432)
			assert values.has("db.host") && values.has("DB.POOL.SIZE") && values.has("db")
			assert !values.has("db.user") && !values.has("d")
			assert "{values.get("db.pool.size")}" == "8"
			assert values.get("missing") is none
			let below = values.get("db.pool")
			assert below is map<string, any>
			assert values.drop("db.pool") && !values.has("db.pool.size") && values.has("db.host")
			assert !values.drop("db.pool")
			return none
		}

		@test()
		def profileKeysAreKeptApart() !none {
			let loaded = new Loaded({"db.host": "prod", "profiles": {"dev": {"db": {"host": "local"}}}, "profiles.Test.db.host": "ci", "profiles.stray": 1})
			assert "{loaded.plain.get("db.host")}" == "prod"
			assert !loaded.plain.has("profiles")
			assert loaded.profiles.keys().sort((a, b) => a < b).join(" | ") == "dev | test"
			assert "{loaded.profiles["dev"].get("db.host")}" == "local"
			return none
		}

		@test()
		def laterLayersAndProfilesWin() !none {
			let base = new Loaded({"a": 1, "b": 1, "c": 1, "profiles.dev.b": 2})
			let local = new Loaded({"c": 3})
			let plain = new View([base, local], none, new Values())
			assert "{plain.values.get("a")}{plain.values.get("b")}{plain.values.get("c")}" == "113"
			let forced = new Values()
			forced.put("a", 9)
			let dev = new View([base, local], "DEV", forced)
			assert "{dev.values.get("a")}{dev.values.get("b")}{dev.values.get("c")}" == "923"
			assert "{dev.values.layerOf("a")} {dev.values.layerOf("b")} {dev.values.layerOf("c")}" == "-1 0 1"
			let changed = differences(plain, dev)
			assert changed.len() == 2
			assert differences(dev, dev).len() == 0
			assert differences(dev, new View()).len() == 3
			return none
		}

		@test()
		def scalarsConvert() !none {
			assert (try typed<int>(8080, "k")) == 8080
			assert (try typed<int>("8080", "k")) == 8080
			assert (try typed<int>(" -12 ", "k")) == -12
			assert (try typed<int>(3.0, "k")) == 3
			assert (try typed<int64>(1 << 40, "k")) == int64(1) << int64(40)
			assert (try typed<uint8>("255", "k")) == uint8(255)
			assert (try typed<byte>(7, "k")) == byte(7)
			assert (try typed<float>(2, "k")) == 2.0
			assert (try typed<float>("1.5e1", "k")) == 15.0
			assert (try typed<float32>(0.5, "k")) == float32(0.5)
			assert (try typed<string>("text", "k")) == "text"
			assert (try typed<string>(8080, "k")) == "8080"
			assert (try typed<string>(true, "k")) == "true"
			assert (try typed<bool>(true, "k"))
			assert (try typed<bool>("Yes", "k"))
			assert !(try typed<bool>("off", "k"))
			assert (try typed<duration>(5s, "k")) == 5s
			assert (try typed<duration>("1m30s", "k")) == 90s
			let maybe = try typed<?int>("4", "k")
			assert !(maybe is none) && maybe == 4
			return none
		}

		@test()
		def whatDoesNotConvertFails() !none {
			assert refused<int>("eight", "port").contains("port is 'eight', which is not a whole number")
			assert refused<int>(1.5, "k").contains("not a whole number")
			assert refused<int>(true, "k").contains("not a whole number")
			assert refused<uint8>(256, "k").contains("does not fit a byte")
			assert refused<int8>("-129", "k").contains("does not fit int8")
			assert refused<uint>(-1, "k").contains("does not fit uint")
			assert refused<int>("99999999999999999999", "k").contains("does not fit int")
			assert refused<bool>("maybe", "k").contains("not true or false")
			assert refused<bool>(1, "k").contains("not true or false")
			assert refused<float>("1.2.3", "k").contains("not a number")
			assert refused<duration>("soon", "k").contains("not a duration")
			assert refused<duration>(30, "k").contains("not a duration")
			assert refused<string>(["a"], "k").contains("not a text")
			assert refused<string[]>(5, "k").contains("not a list")
			assert refused<Mode>("slow", "k").contains("not one of Fast, Careful")
			assert refused<Database>("text", "db").contains("not a table")
			assert refused<Database>({"port": "x"}, "db").contains("db.port is 'x'")
			return none
		}

		@test()
		def enumsListsAndMapsConvert() !none {
			assert (try typed<Mode>("careful", "k")) == Mode.Careful
			assert (try typed<Mode>("Fast", "k")) == Mode.Fast
			assert (try typed<Mode>(1, "k")) == Mode.Careful
			assert (try typed<Mode>(Mode.Careful, "k")) == Mode.Careful
			assert (try typed<string[]>(["a", "b"], "k")).join(" | ") == "a | b"
			let numbers = try typed<int[]>(["1", 2, 3.0], "k")
			assert numbers.len() == 3 && numbers[0] == 1 && numbers[1] == 2 && numbers[2] == 3
			assert (try typed<string[]>("eu, us ,ap", "k")).join(" | ") == "eu | us | ap"
			assert (try typed<int[]>("", "k")).len() == 0
			let modes = try typed<Mode[]>("fast,careful", "k")
			assert modes.len() == 2 && modes[0] == Mode.Fast && modes[1] == Mode.Careful
			let limits = try typed<map<string, int>>({"read": "10", "write": 2}, "k")
			assert limits.len() == 2 && limits["read"] == 10 && limits["write"] == 2
			return none
		}

		@test()
		def structsFillFromTables() !none {
			let db = try typed<Database>({"host": "db.internal", "PORT": "5432", "max_connections": 20, "mode": "careful", "replicas": "a,b", "pool": {"size": 16, "idle": "2m"}, "note": "main", "unknown": 1}, "db")
			assert db.host == "db.internal" && db.port == 5432 && db.maxConnections == 20
			assert db.mode == Mode.Careful && db.replicas.join(" | ") == "a | b"
			assert db.pool.size == 16 && db.pool.idle == 2min
			let note = db.note
			assert !(note is none) && note == "main"
			let sparse = try typed<Database>({"port": 1}, "db")
			assert sparse.host == "unset" && sparse.port == 1 && sparse.maxConnections == 1 && sparse.pool.size == 4 && sparse.note is none
			return none
		}
	}

	check "Config" {
		@test()
		def readsMergedSources() !none {
			let base = new MemorySource("base", {"server": {"port": 8080, "host": "0.0.0.0"}, "name": "app", "regions": ["eu", "us"]})
			let local = new MemorySource("local", {"server.port": "9090", "debug": true})
			try started([SourceConfig{source: base}, SourceConfig{source: local}])
			assert (try read<int>("server.port")) == 9090
			assert (try read<string>("server.host")) == "0.0.0.0"
			assert (try read<string>("SERVER.HOST")) == "0.0.0.0"
			assert (try read<bool>("debug"))
			assert (try read<string[]>("regions")).join(" | ") == "eu | us"
			assert (try Config.get<int>("missing")) is none
			assert Config.has("server.port") && Config.has("server") && !Config.has("serve")
			assert readRefusal<int>("name").contains("name is 'app', which is not a whole number")
			assert originOf("server.port") == "local"
			assert originOf("server.host") == "base"
			assert Config.sourceOf("missing") is none && Config.sourceOf("server") is none
			let sources = Config.sources()
			assert sources.len() == 2 && sources[0].source.name() == "local" && sources[1].source.name() == "base"
			assert !(Config.source("base") is none) && Config.source("other") is none
			assert Config.profile() is none
			assert time.since(Config.lastLoaded()) < 10s
			try cleared()
			return none
		}

		@test()
		def readsAStructFromTheKeysBelow() !none {
			let base = new MemorySource("base", {"db": {"host": "db.internal", "port": 5432, "pool": {"size": 8}}})
			let local = new MemorySource("local", {"db.max_connections": "50", "db.pool.idle": "1m"})
			try started([SourceConfig{source: base}, SourceConfig{source: local}])
			let db = try read<Database>("db")
			assert db.host == "db.internal" && db.port == 5432 && db.maxConnections == 50
			assert db.pool.size == 8 && db.pool.idle == 1min
			let pool = try read<Pool>("db.pool")
			assert pool.size == 8
			try cleared()
			return none
		}

		@test()
		def profilesReplacePlainKeys() !none {
			let base = new MemorySource("base", {"db": {"host": "prod", "port": 5432}, "profiles": {"dev": {"db": {"host": "localhost"}}, "ci": {"db": {"port": 1}}}})
			try started([SourceConfig{source: base}])
			assert (try read<string>("db.host")) == "prod"
			assert !Config.has("profiles") && !Config.has("profiles.dev.db.host")
			seenChanges.flush()
			try Config.switchProfile("dev")
			assert profileName() == "dev"
			assert (try read<string>("db.host")) == "localhost"
			assert (try read<int>("db.port")) == 5432
			assert collected(seenChanges).join(" | ") == "db.host: prod -> localhost (base)"
			try Config.switchProfile("ci")
			assert (try read<string>("db.host")) == "prod" && (try read<int>("db.port")) == 1
			try Config.switchProfile(none)
			assert Config.profile() is none && (try read<int>("db.port")) == 5432
			try started([SourceConfig{source: base}], "dev")
			assert profileName() == "dev" && (try read<string>("db.host")) == "localhost"
			try cleared()
			return none
		}

		@test()
		def overridesWinAndGoBack() !none {
			let base = new MemorySource("base", {"feature.flag": false, "limits": {"read": 10, "write": 5}})
			try started([SourceConfig{source: base}])
			seenChanges.flush()
			Config.set("feature.flag", true)
			Config.set("extra", "added")
			assert (try read<bool>("feature.flag")) && (try read<string>("extra")) == "added"
			assert Config.sourceOf("feature.flag") is none
			assert collected(seenChanges).join(" | ") == "extra: none -> added (override) | feature.flag: false -> true (override)"
			Config.set("feature.flag", true)
			assert collected(seenChanges).len() == 0
			Config.set("limits", {"read": 99})
			assert (try read<int>("limits.read")) == 99 && (try read<int>("limits.write")) == 5
			try Config.reload()
			assert (try read<bool>("feature.flag"))
			seenChanges.flush()
			Config.reset("feature.flag")
			Config.reset("extra")
			Config.reset("limits")
			Config.reset("never.set")
			assert !(try read<bool>("feature.flag")) && !Config.has("extra") && (try read<int>("limits.read")) == 10
			assert collected(seenChanges).join(" | ") == "extra: added -> none (override) | feature.flag: true -> false (base) | limits.read: 99 -> 10 (base)"
			try cleared()
			return none
		}

		@test()
		def reloadReportsWhatChanged() !none {
			let base = new MemorySource("base", {"a": 1, "b": 2, "c": 3})
			try started([SourceConfig{source: base}])
			assert collected(seenChanges).join(" | ") == "a: none -> 1 (base) | b: none -> 2 (base) | c: none -> 3 (base)"
			try Config.reload()
			assert collected(seenChanges).len() == 0
			base.held = {"a": 1, "b": 20, "d": 4}
			try Config.reload()
			assert collected(seenChanges).join(" | ") == "b: 2 -> 20 (base) | c: 3 -> none (base) | d: none -> 4 (base)"
			assert !Config.has("c") && (try read<int>("d")) == 4
			assert base.loads == 3
			try cleared()
			return none
		}

		@test()
		def aFailingSourceKeepsTheLastGoodLoad() !none {
			let base = new MemorySource("base", {"a": 1})
			let extra = new MemorySource("extra", {"b": 2})
			try started([SourceConfig{source: base}, SourceConfig{source: extra, optional: true}])
			let loaded = Config.lastLoaded()
			seenChanges.flush()

			// An optional source that fails keeps what it had, and the reload succeeds.
			extra.broken = true
			base.held = {"a": 10}
			try Config.reload()
			assert (try read<int>("a")) == 10 && (try read<int>("b")) == 2
			assert collected(seenFailures).join(" | ") == "extra: extra cannot be reached"
			assert Config.lastLoaded() == loaded

			// A source that must load fails the reload, and nothing seenChanges.
			base.broken = true
			base.held = {"a": 100}
			assert reloadRefusal() == "base cannot be reached"
			assert (try read<int>("a")) == 10
			assert collected(seenFailures).join(" | ") == "base: base cannot be reached"
			assert switchRefusal("dev") == "base cannot be reached"
			assert Config.profile() is none

			base.broken = false
			extra.broken = false
			try Config.reload()
			assert (try read<int>("a")) == 100
			assert Config.lastLoaded() != loaded
			try cleared()
			return none
		}

		@test()
		def startFailsWithoutARequiredSource() !none {
			let base = new MemorySource("base", {"a": 1})
			base.broken = true
			try cleared()
			try Config.config(ConfigConfig{sources: [SourceConfig{source: base}]})
			let message = ""
			await Config.start() onerror (err error) {
				message = err.message
				recover none
			}
			assert message == "base cannot be reached"
			assert !Config.has("a")
			base.broken = false
			try await Config.start()
			assert (try read<int>("a")) == 1
			try cleared()
			return none
		}

		@test()
		def sourcesNeedDistinctNames() !none {
			try cleared()
			let one = new MemorySource("same", {})
			let two = new MemorySource("same", {})
			assert configRefusal(ConfigConfig{sources: [SourceConfig{source: one}, SourceConfig{source: two}]}) == "config: two sources are named 'same'"
			assert configRefusal(ConfigConfig{sources: [SourceConfig{source: new MemorySource("", {})}]}) == "config: a source has no name"
			assert Config.sources().len() == 0
			return none
		}

		@test()
		def newSourcesOnAStartedService() !none {
			let first = new MemorySource("first", {"a": 1, "b": 2})
			let second = new MemorySource("second", {"b": 3})
			try started([SourceConfig{source: first}])
			seenChanges.flush()
			try Config.config(ConfigConfig{sources: [SourceConfig{source: second}]})
			assert !Config.has("a") && (try read<int>("b")) == 3
			assert collected(seenChanges).join(" | ") == "a: 1 -> none (second) | b: 2 -> 3 (second)"
			second.broken = true
			assert configRefusal(ConfigConfig{sources: [SourceConfig{source: first}, SourceConfig{source: second}]}) == "second cannot be reached"
			assert Config.sources().len() == 1 && (try read<int>("b")) == 3
			try cleared()
			return none
		}

		@test()
		def filesOfEachFormat() !none {
			let folder = try scratch("formats")
			try os.writeFile(folder + "/app.toml", "name = \"app\"\nregions = [\"eu\", \"us\"]\n\n[server]\nport = 8080\nratio = 0.5\n\n[server.tls]\nenabled = true\n\n[profiles.dev.server]\nport = 9090\n".bytes())
			try os.writeFile(folder + "/app.json", "\{\"server\": \{\"port\": 8081, \"hosts\": [\"a\", \"b\"]\}, \"gone\": null\}".bytes())
			try os.writeFile(folder + "/app.ini", "top = 1\n\n[server]\nport = 8082\nname = from ini\n".bytes())
			try os.writeFile(folder + "/.env.local", "SERVER_PORT=8083\nAPP_NAME=\"from env\"\n".bytes())
			try os.writeFile(folder + "/settings", "[server]\nport = 8084\n".bytes())

			try started([SourceConfig{source: new FileSource(folder + "/app.toml")}])
			assert (try read<int>("server.port")) == 8080 && (try read<float>("server.ratio")) == 0.5
			assert (try read<bool>("server.tls.enabled")) && (try read<string[]>("regions")).join(" | ") == "eu | us"
			try Config.switchProfile("dev")
			assert (try read<int>("server.port")) == 9090

			try started([SourceConfig{source: new FileSource(folder + "/app.json")}])
			assert (try read<int>("server.port")) == 8081 && (try read<string[]>("server.hosts")).join(" | ") == "a | b"
			assert !Config.has("gone")

			try started([SourceConfig{source: new FileSource(folder + "/app.ini")}])
			assert (try read<int>("server.port")) == 8082 && (try read<string>("server.name")) == "from ini"
			assert (try read<int>("top")) == 1

			try started([SourceConfig{source: new FileSource(folder + "/.env.local")}])
			assert (try read<int>("server.port")) == 8083 && (try read<string>("app.name")) == "from env"

			try started([SourceConfig{source: new FileSource(folder + "/settings", ConfigFormat.Toml)}])
			assert (try read<int>("server.port")) == 8084
			assert originOf("server.port") == folder + "/settings"
			try cleared()
			os.remove(folder, true) onerror recover none
			return none
		}

		@test()
		def filesThatCannotBeRead() !none {
			let folder = try scratch("unreadable")
			try os.writeFile(folder + "/broken.toml", "port = = 1\n".bytes())
			try os.writeFile(folder + "/list.json", "[1, 2]".bytes())
			try os.writeFile(folder + "/settings", "a = 1\n".bytes())
			try os.writeFile(folder + "/good.toml", "a = 1\n".bytes())
			assert loadRefusal(new FileSource(folder + "/absent.toml")) != ""
			assert loadRefusal(new FileSource(folder + "/broken.toml")) != ""
			assert loadRefusal(new FileSource(folder + "/list.json")).contains("does not hold a JSON object")
			assert loadRefusal(new FileSource(folder + "/settings")).contains("does not tell its format")

			// A missing optional file is left out; a missing required one refuses the start.
			try started([SourceConfig{source: new FileSource(folder + "/good.toml")}, SourceConfig{source: new FileSource(folder + "/absent.toml"), optional: true}])
			assert (try read<int>("a")) == 1
			assert collected(seenFailures).len() == 1
			try cleared()
			os.remove(folder, true) onerror recover none
			return none
		}

		@test()
		def plainReadsGiveTheValueAsItIs() !none {
			let base = new MemorySource("base", {"server": {"port": 8080}, "name": "app"})
			try started([SourceConfig{source: base}])
			let port = Config.get("server.port")
			assert !(port is none) && port is int
			let name = Config.get("NAME")
			assert !(name is none) && name is string
			let server = Config.get("server")
			assert !(server is none) && server is map<string, any>
			assert Config.get("missing") is none
			try cleared()
			return none
		}

		@test()
		def theEnvironmentIsASource() !none {
			try Runtime.setEnv("CFGTEST_DB_HOST", "from-env")
			try Runtime.setEnv("CFGTEST_DB_PORT", "6543")
			try Runtime.setEnv("CFGTEST_REGIONS", "eu,us")
			try Runtime.setEnv("CFGTEST", "bare")
			try Runtime.setEnv("CFGWIDE_DB__MAX_CONNECTIONS", "70")
			let base = new MemorySource("base", {"db": {"host": "file", "port": 5432, "maxConnections": 5}})
			try started([SourceConfig{source: base}, SourceConfig{source: new EnvSource("CFGTEST_")}, SourceConfig{source: new EnvSource("CFGWIDE_", "__")}])
			assert (try read<string>("db.host")) == "from-env" && (try read<int>("db.port")) == 6543
			assert (try read<string[]>("regions")).join(" | ") == "eu | us"
			assert (try read<int>("db.maxConnections")) == 70
			assert originOf("db.port") == "environment CFGTEST_*" && originOf("db.maxConnections") == "environment CFGWIDE_*"
			let db = try read<Database>("db")
			assert db.host == "from-env" && db.port == 6543 && db.maxConnections == 70

			// A variable set since is seen by the next load.
			try Runtime.setEnv("CFGTEST_DB_PORT", "7000")
			try Config.reload()
			assert (try read<int>("db.port")) == 7000
			assert new EnvSource().name() == "environment"
			let everything = try new EnvSource().load()
			assert everything.hasKey("cfgtest.db.host") && everything.hasKey("cfgtest")
			try cleared()
			return none
		}

		@test()
		def aWatchedFileReloadsWhenItChanges() !none {
			let folder = try scratch("watched")
			let path = folder + "/app.toml"
			try os.writeFile(path, "port = 1\n".bytes())
			try started([SourceConfig{source: new FileSource(path)}])
			assert (try read<int>("port")) == 1
			seenChanges.flush()

			try os.writeFile(path, "port = 2\n".bytes())
			assert collected(seenChanges, 3s).join(" | ") == "port: 1 -> 2 ({path})"

			// An editor that writes a new file and renames it over the old one.
			try os.writeFile(folder + "/app.toml.tmp", "port = 3\n".bytes())
			try os.rename(folder + "/app.toml.tmp", path)
			assert collected(seenChanges, 3s).join(" | ") == "port: 2 -> 3 ({path})"

			// A file that stops reading keeps its last values and is reported.
			try os.writeFile(path, "port = = 4\n".bytes())
			assert collected(seenFailures, 3s).len() == 1
			assert (try read<int>("port")) == 3

			// A stopped service does not follow the file.
			try await Config.stop()
			try os.writeFile(path, "port = 5\n".bytes())
			assert collected(seenChanges, 500ms).len() == 0
			assert (try read<int>("port")) == 3
			try cleared()
			os.remove(folder, true) onerror recover none
			return none
		}

		@test()
		def configVariablesAreFilledAndFollowTheirKeys() !none {
			let base = new MemorySource("base", {"bound": {"port": "9000", "mode": "fast", "pool": {"size": 12}}})
			try started([SourceConfig{source: base}])
			assert boundPort == 9000 && boundMode == Mode.Fast && boundWait == 5s
			assert boundHost is none
			assert boundRequired == "given"
			let pool = boundPool
			assert !(pool is none) && pool.size == 12 && pool.idle == 30s

			base.held = {"bound": {"port": 9100, "host": "h", "wait": "2m", "pool": {"size": 20, "idle": "1m"}}}
			try Config.reload()
			assert boundPort == 9100 && boundWait == 2min
			let host = boundHost
			assert !(host is none) && host == "h"
			// A key that is gone gives the default back.
			assert boundMode == Mode.Careful
			let wider = boundPool
			assert !(wider is none) && wider.size == 20 && wider.idle == 1min

			Config.set("bound.port", 1)
			assert boundPort == 1
			Config.reset("bound.port")
			assert boundPort == 9100

			base.held = {}
			try Config.reload()
			assert boundPort == 8080 && boundHost is none && boundPool is none && boundWait == 5s
			try cleared()
			return none
		}

		@test()
		def aLoadIsRefusedWhenAVariableCannotBeFilled() !none {
			let base = new MemorySource("base", {"a": 1})
			try started([SourceConfig{source: base}])

			// The key of a variable that needs one.
			Config.reset("bound.required")
			assert reloadRefusal() == "config: bound.required is not set, and std.services.config.boundRequired has no default"
			base.held = {"a": 2, "bound.required": "from the source"}
			try Config.reload()
			assert boundRequired == "from the source" && (try read<int>("a")) == 2

			// A value that does not read as its variable's type; nothing of the load is taken.
			base.held = {"a": 3, "bound.required": "x", "bound.port": "eighty"}
			assert reloadRefusal().contains("bound.port is 'eighty', which is not a whole number")
			assert (try read<int>("a")) == 2 && boundPort == 8080
			try cleared()
			return none
		}

		@test()
		def configFieldsAreFilledWhenTheirObjectIsMade() !none {
			try started([SourceConfig{source: new MemorySource("base", {})}])
			let plain = new Worker()
			assert plain.workers == 4 && plain.label == "declared" && plain.note is none
			plain.label = "assigned"
			plain.note = "kept"
			let kept = plain.note
			assert plain.label == "assigned" && !(kept is none) && kept == "kept"

			Config.set("bound", {"workers": "16", "label": "configured", "note": "n"})
			let filled = new Worker()
			let note = filled.note
			assert filled.workers == 16 && filled.label == "configured" && !(note is none) && note == "n"
			// While the key has a value, that value is what the field holds.
			filled.workers = 2
			assert filled.workers == 16
			// An object made before is not followed.
			assert plain.workers == 4
			Config.reset("bound")
			Config.set("bound.required", "given")
			try cleared()
			return none
		}

		@test()
		def aFileSourceReportsItsChanges() !none {
			let folder = try scratch("reports")
			let path = folder + "/app.ini"
			try os.writeFile(path, "a = 1\n".bytes())
			try os.writeFile(folder + "/other.ini", "a = 1\n".bytes())
			let source = new FileSource(path)
			let reported = new channel<string>(16)
			try source.watch(() => {
				reported.offer("changed")
			})

			// Another file of the folder is not this one.
			try os.writeFile(folder + "/other.ini", "a = 2\n".bytes())
			assert collected(reported, 500ms).len() == 0
			// Several writes in a row are one change.
			try os.writeFile(path, "a = 2\n".bytes())
			try os.writeFile(path, "a = 3\n".bytes())
			assert collected(reported, 3s).len() == 1
			try os.remove(path)
			assert collected(reported, 3s).len() == 1

			try source.unwatch()
			try os.writeFile(path, "a = 4\n".bytes())
			assert collected(reported, 500ms).len() == 0
			try source.unwatch()
			assert loadRefusal(new FileSource(folder + "/none/app.ini")) != ""
			os.remove(folder, true) onerror recover none
			return none
		}
	}
}
