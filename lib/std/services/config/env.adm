partial module std.services.config {
	use std.services.runtime::(Runtime)

	// The process's environment as a source of the Config service.
	//
	// ```
	// SourceConfig{source: new EnvSource("APP_")}     // APP_DB_HOST is db.host
	// ```
	//
	// Only the variables whose name starts with prefix are taken, without it. The rest of a
	// name is the key in lower case, each separator a dot: with the separator `"__"`,
	// `APP_DB__MAX_CONNECTIONS` is `db.max_connections`, the key `db.maxConnections` of a
	// file. Every value is a text, which a typed read converts. The environment is read at
	// each load, so a reload sees a variable set since.
	type EnvSource {
		internal prefix    string
		internal separator string

		// An empty prefix takes every variable of the environment.
		def new(prefix string = "", separator string = "_") {
			self.prefix = prefix
			self.separator = separator
		}

		// name implements ConfigSource: `environment`, with the prefix when there is one.
		def name() string {
			return prefix == "" ?? ("environment", "environment {prefix}*")
		}

		// load implements ConfigSource. Does not fail.
		def load() !map<string, any> {
			let out = map<string, any>{}
			for let (name, held) in Runtime.environment() {
				continue unless name.startsWith(prefix) && name.len() > prefix.len()
				out[environmentKey(name[prefix.len():], separator)] = held
			}
			return out
		}
	}
}
