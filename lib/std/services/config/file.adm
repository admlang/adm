partial module std.services.config {
	use (
		std.data.encoding::(JSON, TOML, TOMLArray, TOMLTable)
		std.formats.data::(DotEnv, INI)
		std.os
	)

	// How a configuration file is written.
	enum ConfigFormat {
		// Told by the file's name: `.toml`, `.json`, `.ini` (`.cfg`, `.conf`), and `.env`
		// or a name that starts with `.env` (`.env.local`).
		Auto,
		// Tables are the names of a key: `[db]` with `host = ...` is `db.host`.
		Toml,
		// An object whose members are the keys, nested objects the names of a key.
		Json,
		// `[section]` with `key = value` is `section.key`; every value is a text.
		Ini,
		// `NAME=value` lines as the environment holds them: `DB_HOST` is `db.host`; every
		// value is a text.
		Env,
	}

	// How long a file's changes must rest before the file is read again: an editor writes
	// and renames in several steps.
	internal const settleTime = 100ms

	// The key an environment variable's name stands for: lower case, each separator a dot.
	internal def environmentKey(name string, separator string) string {
		return name.lower().replace(separator, ".")
	}

	// What a TOML document holds as plain values: a table as a `map<string, any>`, an
	// array as an `any[]`.
	internal def plainValue(value any) any {
		match value {
			case TOMLTable:
				let table TOMLTable = value
				let out = map<string, any>{}
				for let (_, key) in table.keys() {
					let held = table.get(key)
					out[key] = plainValue(held) unless held is none
				}
				return out
			case TOMLArray:
				let list TOMLArray = value
				let out any[] = []
				for let (_, item) in list.items {
					out.push(plainValue(item))
				}
				return out
			default:
		}
		return value
	}

	// A configuration file as a source of the Config service.
	//
	// ```
	// SourceConfig{source: new FileSource("app.toml")}
	// SourceConfig{source: new FileSource("/etc/app/settings", ConfigFormat.Ini), optional: true}
	// ```
	//
	// The file is read at each load, so a reload sees what it holds then. The service
	// watches it while started and reloads when it changes, also when an editor replaces
	// it by a new file of the same name.
	type FileSource {
		internal path    string
		internal format  ConfigFormat
		internal watcher ?os.Watcher  = none

		// path is the file, from the working directory when it is not absolute.
		def new(path string, format ConfigFormat = ConfigFormat.Auto) {
			self.path = path
			self.format = format
		}

		// name implements ConfigSource: the file's path as it was given.
		def name() string {
			return path
		}

		// The format the file is read as.
		//
		// Fails when the format is `Auto` and the file's name does not tell it.
		internal def written() !ConfigFormat {
			return format unless format == ConfigFormat.Auto
			let file = os.base(path)
			return ConfigFormat.Env when file.startsWith(".env")
			match os.extension(file).lower() {
				case "toml":
					return ConfigFormat.Toml
				case "json":
					return ConfigFormat.Json
				case "ini", "cfg", "conf":
					return ConfigFormat.Ini
				case "env":
					return ConfigFormat.Env
				default:
			}
			fail "config: the name of {path} does not tell its format: give FileSource a ConfigFormat"
		}

		// load implements ConfigSource: the keys the file holds now.
		//
		// Fails when the file cannot be read, when its name does not tell its format and
		// none was given, and when its text is not of that format.
		def load() !map<string, any> {
			let kind = try written()
			let text = string(try os.readFile(path))
			let out = map<string, any>{}
			match kind {
				case ConfigFormat.Toml:
					let doc = new TOMLTable()
					try new TOML().decode(text, doc)
					for let (_, key) in doc.keys() {
						let held = doc.get(key)
						out[key] = plainValue(held) unless held is none
					}
				case ConfigFormat.Json:
					let doc = try new JSON().parse(text)
					fail "config: {path} does not hold a JSON object" unless doc is map<string, any>
					let members map<string, any> = doc
					for let (key, held) in members {
						out[key] = held
					}
				case ConfigFormat.Ini:
					let doc = try new INI().parse(text)
					for let (_, entry) in doc.global.entries {
						out[entry.key] = entry.value
					}
					for let (_, section) in doc.sections {
						for let (_, entry) in section.entries {
							out[section.name + "." + entry.key] = entry.value
						}
					}
				default:
					for let (name, held) in try new DotEnv().decode(text) {
						out[environmentKey(name, "_")] = held
					}
			}
			return out
		}

		// watch implements WatchableConfigSource: calls changed each time the file is
		// written, replaced, created or removed, once its changes rest.
		//
		// Fails when the file's directory does not exist or cannot be watched.
		def watch(changed def ()) !none {
			try unwatch()
			let folder = os.dir(path)
			let watching = try os.watch(folder == "" ?? (".", folder))
			watcher = watching
			async follow(watching, os.base(path), changed)
			return none
		}

		// unwatch implements WatchableConfigSource. Does not fail.
		def unwatch() !none {
			let watching = watcher
			return none when watching is none
			watcher = none
			watching.close() onerror recover none
			return none
		}

		// Reports the changes of the entry named file until the watcher is closed.
		internal def follow(watching os.Watcher, file string, changed def ()) {
			for {
				let ended = false
				let change = watching.next() onerror (err error) {
					ended = true
					recover os.Change{}
				}
				return when ended
				// A change with no path says that changes were lost: the file may be one.
				continue unless change.path == "" || os.base(change.path) == file
				for {
					let more = watching.next(settleTime) onerror (err error) {
						ended = true
						recover none
					}
					break when ended || more is none
				}
				return when ended
				changed()
			}
		}
	}
}
