// How the Config service holds and converts values: what a source loads flattened to dotted
// keys, keys compared without case and separators, the layers merged by precedence, and a
// value fitted to a declared type.
internal partial module std.services.config.values {
	use (
		std.reflection
		std.reflection::(FieldKind, TypeDescriptor, TypeKind)
		std.time
	)

	// The first name of the keys a source keeps for its profiles: `profiles.<name>.<key>`.
	const profilesRoot = "profiles"

	// The layer a value comes from when it is an override.
	const overridden = -1

	// The key as keys are compared: lower case, with the `-` and `_` inside its names left out,
	// so `db.maxConnections`, `db.max_connections` and `DB.MAX-CONNECTIONS` name one value.
	def canonical(key string) string {
		let plain = true
		for let c in key {
			plain = false when c == '-' || c == '_' || c.isUpper()
		}
		return key when plain
		return key.lower().replace("-", "").replace("_", "")
	}

	// One key's value.
	struct Entry {
		// The key as it was first spelled.
		key   string
		value any
		// The layer the value comes from, in a merged set: its index, `overridden` for an
		// override.
		layer int
	}

	// Values by canonical key.
	type Values {
		entries map<string, Entry>

		def new() {}

		// Sets the value of a key that names one value.
		def put(key string, value any, layer int = 0) {
			let name = canonical(key)
			let known = entries.get(name)
			entries[name] = Entry{key: known is none ?? (key, known.key), value: value, layer: layer}
		}

		// Sets what value holds under key: a map key by key, down to the values that are not
		// maps; anything else as the value of key. None sets nothing.
		def add(key string, value ?any) {
			return when value is none
			// A none inside an `any`: what a JSON null reads as.
			return when reflection.typeName(value) := "" || "none"
			if reflection.kindOf(value) == FieldKind.Map {
				for let (_, name) in reflection.keysOf(value) {
					add(key == "" ?? (name, key + "." + name), reflection.entryOf(value, name))
				}
				return
			}
			put(key, value) unless key == ""
		}

		// Drops key and every key below it; reports whether there was one.
		def drop(key string) bool {
			let name = canonical(key)
			let below = name + "."
			let gone string[] = []
			for let known in entries.keys() {
				gone.push(known) when known == name || known.startsWith(below)
			}
			for let (_, known) in gone {
				entries.delete(known)
			}
			return gone.len() > 0
		}

		// The value of key; for a key that names no value but has keys below it, those as a
		// map, the maps below them nested; none when neither.
		def get(key string) ?any {
			let name = canonical(key)
			let known = entries.get(name)
			return known.value unless known is none
			let below = tree(name + ".", name.split(".").len())
			return none when below.len() == 0
			return below
		}

		// The layer the key's value comes from; none when the key names no value.
		def layerOf(key string) ?int {
			let known = entries.get(canonical(key))
			return none when known is none
			return known.layer
		}

		// Whether key names a value or has keys below it.
		def has(key string) bool {
			let name = canonical(key)
			return true when entries.hasKey(name)
			let below = name + "."
			for let known in entries.keys() {
				return true when known.startsWith(below)
			}
			return false
		}

		// The keys that start with prefix as a map of the names at `depth`, each the value of
		// its key or the map of the keys below it.
		def tree(prefix string, depth int) map<string, any> {
			let out = map<string, any>{}
			let inner = map<string, string>{}
			for let (name, entry) in entries {
				continue unless name.startsWith(prefix)
				let names = name.split(".")
				let shown = entry.key.split(".")[depth]
				if names.len() == depth + 1 {
					out[shown] = entry.value
				} else {
					inner[names[depth]] = shown unless inner.hasKey(names[depth])
				}
			}
			for let (name, shown) in inner {
				out[shown] = tree(prefix + name + ".", depth + 1)
			}
			return out
		}
	}

	// What one source last loaded: its plain keys, and the keys of each profile by the
	// profile's canonical name.
	type Loaded {
		plain    Values
		profiles map<string, Values>

		def new() {
			plain = new Values()
		}

		// Takes what a source's `load` returned, apart into plain keys and profiles.
		def new(given map<string, any>) {
			plain = new Values()
			let all = new Values()
			for let (key, value) in given {
				all.add(key, value)
			}
			for let (name, entry) in all.entries {
				let names = name.split(".")
				if names[0] != profilesRoot {
					plain.put(entry.key, entry.value)
					continue
				}
				// `profiles.dev` holding a plain value names no key of a profile.
				continue when names.len() < 3
				let kept = profiles.get(names[1])
				if kept is none {
					let made = new Values()
					made.put(entry.key.split(".")[2:].join("."), entry.value)
					profiles[names[1]] = made
				} else {
					kept.put(entry.key.split(".")[2:].join("."), entry.value)
				}
			}
		}
	}

	// The values in effect, each with the layer it comes from.
	type View {
		values Values

		def new() {
			values = new Values()
		}

		// Merges the layers, lowest precedence first: in each, the active profile's keys
		// over the plain ones; a later layer over an earlier one; the overrides over all.
		def new(layers Loaded[], profile ?string, overrides Values) {
			values = new Values()
			for let (index, layer) in layers {
				take(layer.plain, index)
				continue when profile is none
				let chosen = layer.profiles.get(canonical(profile))
				take(chosen, index) unless chosen is none
			}
			take(overrides, overridden)
		}

		def take(from Values, layer int) {
			for let (_, entry) in from.entries {
				values.put(entry.key, entry.value, layer)
			}
		}
	}

	// One key whose value is not what it was.
	struct Difference {
		// The key as its source spells it.
		key    string
		before ?any
		after  ?any
		// The layer that holds the new value; the one that held the old value for a key
		// that is gone.
		layer  int
	}

	// The keys whose value differs between two views, in the order of the new view, then
	// the keys that are gone.
	def differences(before View, after View) Difference[] {
		let out Difference[] = []
		for let (name, now) in after.values.entries {
			let was = before.values.entries.get(name)
			if was is none {
				out.push(Difference{key: now.key, before: none, after: now.value, layer: now.layer})
				continue
			}
			continue when same(was.value, now.value)
			out.push(Difference{key: now.key, before: was.value, after: now.value, layer: now.layer})
		}
		for let (name, was) in before.values.entries {
			continue when after.values.entries.hasKey(name)
			out.push(Difference{key: was.key, before: was.value, after: none, layer: was.layer})
		}
		return out
	}

	// Whether two values are of one type and read the same.
	def same(a any, b any) bool {
		return reflection.typeName(a) == reflection.typeName(b) && shown(a) == shown(b)
	}

	// A value as text: a scalar as written, an array as its elements between brackets.
	def shown(value any) string {
		let kind = reflection.kindOf(value)
		return reflection.scalarText(value) unless kind := FieldKind.Array || FieldKind.Other
		return "{value}" when kind == FieldKind.Other
		let parts string[] = []
		for let (_, element) in reflection.elements(value) {
			parts.push(shown(element))
		}
		return "[" + parts.join(", ") + "]"
	}

	// A typed field to read the shape of a type from.
	struct Boxed<T> {
		value T
	}

	// The type a declaration spells, without the `builtin.` of the prelude's own types.
	def spelled(declared TypeDescriptor) string {
		return declared.typeName.replace("builtin.", "")
	}

	// The value as one of the declared type, boxed as exactly that type: itself when it is
	// one; a number, bool or duration from its text (what an environment variable holds) or
	// from a number that fits; a string from any scalar; an enum member from its name or its
	// number; an array element by element, or from the texts between the commas of a
	// string; a `map<string, V>` entry by entry; a struct or type from a map, field by
	// field, the fields it does not name keeping their defaults. key names the value in
	// errors.
	//
	// Fails when the value does not read as the declared type or does not fit it.
	def fit(value any, declared TypeDescriptor, key string) !any {
		let name = spelled(declared)
		return value when name == "any"
		match declared.kind {
			case TypeKind.Array:
				return try fitArray(value, declared, key)
			case TypeKind.Map:
				return try fitMap(value, declared, key)
			case TypeKind.Enum:
				return try fitEnum(value, declared, key)
			default:
		}
		return try fitText(value, key) when name == "string"
		return try fitBool(value, key) when name == "bool"
		return try fitDuration(value, key) when name == "duration"
		return try fitFloat(name, value, key) when name := "float" || "float32" || "float64"
		return try fitWhole("uint8", value, key) when name == "byte"
		return try fitWhole(name, value, key) when name := "int" || "int8" || "int16" || "int32" || "int64" || "uint" || "uint8" || "uint16" || "uint32" || "uint64"
		return try fitStruct(value, declared, key) when declared.kind == TypeKind.Struct
		return value when reflection.typeName(value) == declared.typeName
		fail "config: {key} cannot be read as {name}"
	}

	// What the value is, for an error.
	def unfit(value any, key string, wanted string) Error {
		let text = shown(value)
		text = text[0:40] + "..." when text.len() > 40
		return Error{message: "config: {key} is '{text}', which is not {wanted}", code: "BadValue"}
	}

	def fitText(value any, key string) !any {
		let kind = reflection.kindOf(value)
		return value when kind == FieldKind.String
		return reflection.scalarText(value) when kind := FieldKind.Bool || FieldKind.Int || FieldKind.Uint || FieldKind.Float
		return "{value}" when reflection.typeName(value) == "duration"
		fail unfit(value, key, "a text")
	}

	def fitBool(value any, key string) !any {
		let kind = reflection.kindOf(value)
		return value when kind == FieldKind.Bool
		fail unfit(value, key, "true or false") unless kind == FieldKind.String
		let word = reflection.scalarText(value).trim().lower()
		return true when word := "true" || "1" || "yes" || "on"
		return false when word := "false" || "0" || "no" || "off"
		fail unfit(value, key, "true or false")
	}

	def fitDuration(value any, key string) !any {
		return value when reflection.typeName(value) == "duration"
		fail unfit(value, key, "a duration, such as 30s or 5m") unless reflection.kindOf(value) == FieldKind.String
		let failed = false
		let span = time.parseDuration(reflection.scalarText(value).trim()) onerror (err error) {
			failed = true
			recover 0s
		}
		fail unfit(value, key, "a duration, such as 30s or 5m") when failed
		return span
	}

	def fitFloat(name string, value any, key string) !any {
		let kind = reflection.kindOf(value)
		let text = reflection.scalarText(value).trim()
		let reads = (kind := FieldKind.Int || FieldKind.Uint || FieldKind.Float) || kind == FieldKind.String && /^[+-]?([0-9]+(\.[0-9]*)?|\.[0-9]+)([eE][+-]?[0-9]+)?$/.test(text)
		fail unfit(value, key, "a number") unless reads
		return float32(parseFloat<float>(text)) when name == "float32"
		return parseFloat<float>(text)
	}

	// A whole number as the integer type named name.
	def fitWhole(name string, value any, key string) !any {
		let kind = reflection.kindOf(value)
		let text = reflection.scalarText(value).trim()
		if kind == FieldKind.Float {
			let number = parseFloat<float>(text)
			fail unfit(value, key, "a whole number") unless number > -9.2e18 && number < 9.2e18 && float(int64(number)) == number
			text = int64(number).str()
		} else {
			fail unfit(value, key, "a whole number") unless kind := FieldKind.Int || FieldKind.Uint || FieldKind.String
		}
		fail unfit(value, key, "a whole number") unless /^[+-]?[0-9]+$/.test(text)
		let negative = text.startsWith("-")
		let digits = text.trimPrefix("-").trimPrefix("+").trimStart("0")
		let unsigned = name.startsWith("uint")
		let bits = (name := "int" || "uint") ?? (64, parseInt<int>(name.trimPrefix("uint").trimPrefix("int")))
		let top = unsigned ?? ("18446744073709551615", negative ?? ("9223372036854775808", "9223372036854775807"))
		let fits = !(unsigned && negative && digits != "") && (digits.len() < top.len() || digits.len() == top.len() && digits.compare(top) <= 0)
		if fits && unsigned {
			let wide = parseInt<uint64>(digits)
			if bits == 64 || wide < uint64(1) << uint64(bits) {
				return uint8(wide) when bits == 8
				return uint16(wide) when bits == 16
				return uint32(wide) when bits == 32
				return uint(wide) when name == "uint"
				return wide
			}
		}
		if fits && !unsigned {
			let wide = parseInt<int64>(text)
			let limit = int64(1) << int64(bits - 1)
			if bits == 64 || wide >= -limit && wide < limit {
				return int8(wide) when bits == 8
				return int16(wide) when bits == 16
				return int32(wide) when bits == 32
				return int(wide) when name == "int"
				return wide
			}
		}
		fail Error{message: "config: {key} is {text}, which does not fit {name == "uint8" ?? ("a byte", name)}", code: "BadValue"}
	}

	def fitEnum(value any, declared TypeDescriptor, key string) !any {
		return value when reflection.typeName(value) == declared.typeName
		let kind = reflection.kindOf(value)
		let text = reflection.scalarText(value).trim()
		let wanted = canonical(text)
		let names string[] = []
		for let (_, member) in reflection.members(declared) {
			return member.value when kind == FieldKind.String && canonical(member.node.name) == wanted
			return member.value when (kind := FieldKind.Int || FieldKind.Uint) && reflection.scalarText(member.value) == text
			names.push(member.node.name)
		}
		fail unfit(value, key, "one of {names.join(", ")}")
	}

	def fitArray(value any, declared TypeDescriptor, key string) !any {
		let element = declared.element
		fail "config: {key} cannot be read as {spelled(declared)}" when element is none
		let given any[] = []
		let kind = reflection.kindOf(value)
		if kind == FieldKind.Array {
			given = reflection.elements(value)
		} else if kind == FieldKind.String {
			// The list an environment variable holds: the texts between its commas.
			let text = reflection.scalarText(value).trim()
			for let (_, part) in text.split(",") {
				given.push(part.trim()) unless text == ""
			}
		} else {
			fail unfit(value, key, "a list")
		}
		let fitted any[] = []
		for let (index, one) in given {
			fitted.push(try fit(one, element, "{key}[{index}]"))
		}
		let made = reflection.arrayOf(element, fitted)
		fail "config: {key} cannot be read as {spelled(declared)}" when made is none
		return made
	}

	def fitMap(value any, declared TypeDescriptor, key string) !any {
		let element = declared.element
		let keyed = declared.key
		fail "config: {key} cannot be read as {spelled(declared)}" when element is none || keyed is none
		fail "config: {key} cannot be read as {spelled(declared)}: its keys are not texts" unless spelled(keyed) == "string"
		fail unfit(value, key, "a table") unless reflection.kindOf(value) == FieldKind.Map
		let names = reflection.keysOf(value)
		let fitted any[] = []
		for let (_, name) in names {
			let entry = reflection.entryOf(value, name)
			fail "config: {key}.{name} has no value" when entry is none
			fitted.push(try fit(entry, element, key + "." + name))
		}
		let made = reflection.mapOf(element, names, fitted)
		fail "config: {key} cannot be read as {spelled(declared)}" when made is none
		return made
	}

	def fitStruct(value any, declared TypeDescriptor, key string) !any {
		fail unfit(value, key, "a table") unless reflection.kindOf(value) == FieldKind.Map
		let made = reflection.instantiate(declared)
		fail "config: {key}: a {spelled(declared)} cannot be made from configuration" when reflection.kindOf(made) != FieldKind.Struct
		let given = map<string, string>{}
		for let (_, name) in reflection.keysOf(value) {
			given[canonical(name)] = name
		}
		for let (_, field) in reflection.fields(made) {
			let name = given.get(canonical(field.name))
			continue when name is none
			let entry = reflection.entryOf(value, name)
			continue when entry is none
			let shape = field.descriptor
			let fitted = entry
			fitted = try fit(entry, shape, key + "." + field.name) unless shape is none
			fail "config: {key}.{field.name} cannot be stored as {field.typeName}" unless field.set(fitted)
		}
		return made
	}

	// The value as a T, as `fit` reads it.
	//
	// Fails as `fit` does.
	def typed<T>(value any, key string) !T {
		let box = Boxed<T>{}
		let slot = reflection.field(box, "value")
		fail "config: {key} cannot be read as this type" when slot is none
		let shape = slot.descriptor
		fail "config: {key} cannot be read as {slot.typeName}" when shape is none
		let fitted = try fit(value, shape, key)
		fail "config: {key} cannot be stored as {slot.typeName}" unless slot.set(fitted)
		return box.value
	}
}
