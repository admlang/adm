partial module std.services.database {
	use (
		std.data.db as data
		std.services::(Dependencies, Lifecycle, RestartMode, StartMode)
		std.services.runtime::(Runtime)
		std.reflection::(DiscoveryMetaContext, FunctionMetaContext, MethodMetaContext)
	)

	// db names the connection a `sql def` function runs on, for one that is
	// not a method of a type with a `@connection` property:
	//
	//     @db("reports")
	//     sql def dailyTotals(day time.Date) !Total[] {
	//         SELECT * FROM totals WHERE day = {day}
	//     }
	//
	// Without it such a function runs on the default connection
	// (`Database.get()`).
	meta def db(ctx DiscoveryMetaContext<FunctionMetaContext>, name string) {}

	// db names the connection of a `sql def` method, as the function form
	// above.
	meta def db(ctx DiscoveryMetaContext<MethodMetaContext>, name string) {}

	// The connection a `sql def` function asks the service for: by name, or
	// the default.
	internal def connectionFor(name ?string) !data.Queryable {
		return try Database.get() when name is none
		return try Database.get(name)
	}

	// Database holds the program's database connections by name. Each is a
	// pool (std.data.db.Pool), so tasks share it:
	//
	//     try Database.add("main", "postgres://app:secret@db.internal/shop")
	//     try Database.add("reports", "sqlite:reports.db", 2)
	//
	//     let rows = try Database.get("reports").query("SELECT * FROM daily")
	//     try Database.exec("UPDATE stock SET left = left - 1 WHERE id = $1", id)
	//
	// `get()`, and `exec` and `query` on the service itself, use the default
	// connection: the one added without a name, else the only one there is.
	// The driver for each URL's scheme must be linked into the program.
	service Database {
		description               = "Named database connections, each a pool"
		dependencies              = Dependencies{
			hard: [Runtime],
			soft: []
		}
		lifecycle                 = Lifecycle{
			start: StartMode.Manual,
			restart: RestartMode.Always,
		}
		permissions  Permission[]

		pools map<string, data.Pool> = map<string, data.Pool>{}

		// Applies the service's settings. There are none yet, and it does not
		// fail.
		def config<T>(val T) !none {}

		// Starts the service with no connections and makes it the place
		// `sql def` functions find theirs. Does not fail today.
		async def start() !none {
			data.provide(connectionFor)
			return none
		}

		// Stops the service: every pool is closed and forgotten, and
		// `sql def` functions find no connection here any more.
		// Fails with the first DbError a pool reports while closing.
		async def stop() !none {
			data.provide(none)
			let failure ?error = none
			for let (_, held) in takeAll() {
				held.close() onerror (err error) {
					failure = err when failure is none
					recover none
				}
			}
			fail failure unless failure is none
			return none
		}

		// Stops the service and starts it again. Fails when either step fails.
		async def restart() !none {
			try await stop()
			try await start()
			return none
		}

		// add registers a connection under a name: a pool of up to `limit`
		// connections to the database the URL names, opened as statements
		// need them. The name "" is the default connection's.
		// Fails with a DbError: ErrorKind.NoDriver when the program links no
		// driver for the URL's scheme, ErrorKind.Other when the name is
		// taken. Fails with a UrlError when the text is not a URL.
		@commit()
		atomic def add(name string, target string, limit int = 8) !none {
			fail data.errorOf(data.ErrorKind.Other, "a database connection named '{name}' exists already") when pools.hasKey(name)
			pools[name] = try data.pool(target, limit)
			return none
		}

		// add registers the default connection, the one `get()` returns.
		// Fails as the named form does.
		@commit()
		atomic def add(target string) !none {
			fail data.errorOf(data.ErrorKind.Other, "a default database connection exists already") when pools.hasKey("")
			pools[""] = try data.pool(target)
			return none
		}

		// remove closes a connection's pool and forgets its name. A name that
		// is not registered is left alone.
		// Fails with a DbError when the pool reports a failure while closing.
		@query()
		def remove(name string) !none {
			let held = take(name)
			return none when held is none
			return held.close()
		}

		// get returns the connection registered under a name.
		// Fails with a DbError of ErrorKind.Other when there is none.
		@query()
		atomic def get(name string) !data.Pool {
			let held = pools.get(name)
			fail data.errorOf(data.ErrorKind.Other, "no database connection named '{name}'") when held is none
			return held
		}

		// get returns the default connection: the one added without a name,
		// else the only one registered.
		// Fails with a DbError of ErrorKind.Other when none is registered, or
		// several are and none is the default.
		@query()
		atomic def get() !data.Pool {
			let unnamed = pools.get("")
			return unnamed unless unnamed is none
			fail data.errorOf(data.ErrorKind.Other, "no database connection is registered") when pools.len() == 0
			fail data.errorOf(data.ErrorKind.Other, "{pools.len()} database connections are registered and none is the default") when pools.len() > 1
			for let (_, only) in pools {
				return only
			}
			fail data.errorOf(data.ErrorKind.Other, "no database connection is registered")
		}

		// names returns the registered names, the default's as "".
		@query()
		atomic def names() string[] {
			return pools.keys()
		}

		// exec runs a statement on the default connection.
		// Fails as `get()` and the connection's `exec` do.
		@query()
		def exec(statement string, args ...any) !data.Result {
			let held = try get()
			return held.exec(statement, ...args)
		}

		// query runs a statement on the default connection and returns its
		// rows.
		// Fails as `get()` and the connection's `query` do.
		@query()
		def query(statement string, args ...any) !data.Rows {
			let held = try get()
			return held.query(statement, ...args)
		}

		// Forgets a name and hands over its pool.
		atomic def take(name string) ?data.Pool {
			let held = pools.get(name)
			pools.delete(name) unless held is none
			return held
		}

		// Forgets every name and hands over the pools.
		atomic def takeAll() data.Pool[] {
			let all = pools.values()
			pools = map<string, data.Pool>{}
			return all
		}
	}
}
