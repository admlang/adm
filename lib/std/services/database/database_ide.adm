// The Database service's IDE panel: the connections the program set up, and
// the button that removes one. Statements are not run from here: the
// developer queries the database with its own tools.

partial module std.services.database {
	use std.ide::(ide, IdeKind, IdeTable)

	partial service Database {
		@ide(kind = IdeKind.Table, label = "Connections", refresh = 2s, rows = 6)
		atomic def ideConnections() IdeTable {
			let rows = string[][]
			let names = pools.keys()
			names.sort((a, b) => a < b)
			for let (_, name) in names {
				let pool = pools[name]
				let versions = tables.get(name)
				rows.push([name == "" ?? ("(default)", name), pool.str(), "{pool.limit()}", "{pool.idleCount()}", versions is none ?? ("", versions)])
			}
			return IdeTable{columns: ["Name", "Target", "Limit", "Idle", "Versions table"], rows: rows}
		}

		@ide(kind = IdeKind.Action, label = "Remove connection", confirm = "Close and remove this connection?", row = "ideConnections.Name")
		def ideRemove(name string) !none {
			return remove(name)
		}
	}
}
