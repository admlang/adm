partial module std.services.database {
	use (
		std.data.db as data
		std.net.url
		std.testing
	)

	// A driver that keeps nothing: `exec` reports as many rows as it got
	// arguments, `query` returns no rows.
	@data.driver("nulldb")
	type NullDriver {
		def new() {}

		def placeholder() data.Placeholder {
			return data.Placeholder.Question
		}

		def connect(target url.URL) !data.Connection {
			return new NullConnection()
		}
	}

	type NullConnection {
		def new() {}

		def placeholder() data.Placeholder {
			return data.Placeholder.Question
		}

		def exec(statement string, args ...any) !data.Result {
			return data.Result{affected: args.len(), lastInsertId: 0}
		}

		def exec(statement string, named map<string, any>, args ...any) !data.Result {
			return data.Result{affected: named.len(), lastInsertId: 0}
		}

		def query(statement string, args ...any) !data.Rows {
			return new NullRows()
		}

		def query(statement string, named map<string, any>, args ...any) !data.Rows {
			return new NullRows()
		}

		def prepare(statement string) !data.Statement {
			fail data.errorOf(data.ErrorKind.Other, "nulldb prepares nothing")
		}

		def beginTx(isolation data.Isolation = data.Isolation.Default, readOnly bool = false) !data.Transaction {
			fail data.errorOf(data.ErrorKind.Other, "nulldb has no transactions")
		}

		def ping() !none {
			return none
		}

		def close() !none {
			return none
		}
	}

	type NullRows {
		def new() {}

		def columns() data.Column[] {
			return data.Column[]
		}

		def next() !bool {
			return false
		}

		def isNull(column int) bool {
			return true
		}

		def bool(column int) !bool {
			fail data.errorOf(data.ErrorKind.Type, "no row is current")
		}

		def int(column int) !int {
			fail data.errorOf(data.ErrorKind.Type, "no row is current")
		}

		def float(column int) !float {
			fail data.errorOf(data.ErrorKind.Type, "no row is current")
		}

		def string(column int) !string {
			fail data.errorOf(data.ErrorKind.Type, "no row is current")
		}

		def bytes(column int) !byte[] {
			fail data.errorOf(data.ErrorKind.Type, "no row is current")
		}

		def value(column int) !any {
			fail data.errorOf(data.ErrorKind.Type, "no row is current")
		}

		def close() !none {
			return none
		}
	}

	check "Database service" {
		def reset() !none {
			try await Database.stop()
			try await Database.start()
			return none
		}

		def messageOf(outcome ?string) string {
			return "" when outcome is none
			return outcome
		}

		@test()
		def TestNamedConnections() !none {
			try reset()
			let message = ""
			Database.get() onerror (err error) {
				message = err.message
				recover try data.pool("nulldb://x")
			}
			assert message == "no database connection is registered"

			try Database.add("main", "nulldb://host/main", 3)
			// The only connection is the default.
			let only = try Database.get()
			assert only.limit() == 3
			let res = try Database.exec("UPDATE t SET a = ? WHERE b = ?", 1, 2)
			assert res.affected == 2

			try Database.add("reports", "nulldb://host/reports")
			assert Database.names().join(",") == "main,reports"
			let reports = try Database.get("reports")
			assert reports.limit() == 8

			message = ""
			Database.get() onerror (err error) {
				message = err.message
				recover reports
			}
			assert message == "2 database connections are registered and none is the default"

			try Database.add("nulldb://host/default")
			let chosen = try Database.get()
			let rows = try Database.query("SELECT 1")
			assert !(try rows.next())
			assert chosen.idleCount() == 1

			message = ""
			Database.add("main", "nulldb://host/other") onerror (err error) {
				message = err.message
				recover none
			}
			assert message == "a database connection named 'main' exists already"
			message = ""
			Database.add("extra", "nosuchdb://host/x") onerror (err error) {
				message = err.message
				recover none
			}
			assert message == "no driver for 'nosuchdb'"
			message = ""
			Database.get("missing") onerror (err error) {
				message = err.message
				recover reports
			}
			assert message == "no database connection named 'missing'"

			try Database.remove("reports")
			try Database.remove("reports")
			assert Database.names().join(",") == "main,"

			// A removed or stopped connection lends nothing more.
			let kind = data.ErrorKind.Other
			reports.exec("SELECT 1") onerror (err error) {
				kind = err.kind when err is data.DbError
				recover data.Result{affected: 0, lastInsertId: 0}
			}
			assert kind == data.ErrorKind.Closed
			try reset()
			assert Database.names().len() == 0
		}

		@test()
		def TestProvidesConnectionsToSqlDef() !none {
			try await Database.stop()
			let message = ""
			let fallback = try data.pool("nulldb://x")
			data.sqlDefault() onerror (err error) {
				message = err.message
				recover fallback
			}
			assert message.startsWith("no database connection for this sql def")
			message = ""
			data.sqlNamed("reports") onerror (err error) {
				message = err.message
				recover fallback
			}
			assert message.startsWith("no database connection named 'reports' for this sql def")

			try await Database.start()
			try Database.add("nulldb://host/default")
			try Database.add("reports", "nulldb://host/reports", 2)
			let main = try data.sqlDefault()
			let res = try main.exec("UPDATE t SET a = ?", 1)
			assert res.affected == 1
			let reports = try data.sqlNamed("reports")
			try reports.exec("UPDATE t SET a = 1")
			let pooled = try Database.get("reports")
			assert pooled.idleCount() == 1

			message = ""
			data.sqlNamed("missing") onerror (err error) {
				message = err.message
				recover fallback
			}
			assert message == "no database connection named 'missing'"
			try reset()
		}
	}
}
