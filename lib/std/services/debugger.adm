partial module std.services {
	use (
		std.reflection
		std.errors
		std.time
		std.services.debugger::*
	)

	// Identifies a running profile; profileStart returns one and profileStop takes it.
	type ProfileId = string

	// What a profile records: CPU time, memory, the heap or the GPU.
	enum ProfileKind {
		CPU,
		Memory,
		Heap,
		GPU,
	}

	// One call stack a profile saw, innermost frame first, and how much of the
	// profile it accounts for.
	struct ProfileSample {
		stack errors.StackFrame[]
		count int // CPU: samples taken in this stack; Memory: allocations made from it
		bytes int // Memory: bytes those allocations asked for; 0 for CPU
	}

	// The data a stopped profile produced: its distinct stacks, heaviest first.
	// Frames show where each function is declared, not the line it was on.
	struct Profile {
		kind     ProfileKind
		duration duration
		interval duration // time between CPU samples; 0s for Memory
		samples  ProfileSample[]
	}

	// Identifies a running trace; traceStart returns one and traceStop takes it.
	type TraceId = string

	// One call of a @trace function or method that returned while a trace ran.
	struct TraceEvent {
		name     string // fully qualified: module.fn or module.Type.method
		location ?errors.Location // where the function is declared
		task     int // the task that made the call; 0 off the scheduler
		start    time.Time
		duration duration
		depth    int // frames below it on its task's stack
	}

	// The calls a stopped trace recorded, in the order they returned.
	struct Trace {
		events TraceEvent[]
	}

	// The live objects at one moment. Empty until snapshots are implemented.
	struct HeapSnapshot {}

	// Which accesses a @watch reports: reads, writes or both.
	enum WatchMode {
		Read,
		Write,
		ReadWrite,
	}

	// One access to a watched field or variable. Details come with the watch implementation.
	struct WatchEvent {
		// leave details for later
	}

	// Profiles, traces and watches for a running program.
	//
	// CPU and memory profiles and @trace spans read the shadow call stack, which
	// release builds drop. Heap snapshots, the other profile kinds and watches fail
	// with not implemented.
	service Debugger {
		description               = ""
		dependencies              = Dependencies{
			hard: [Runtime],
			soft: [Diagnostics]
		}
		lifecycle                 = Lifecycle{
			start: StartMode.Manual,
			restart: RestartMode.Always,
		}
		permissions  Permission[]

		// Applies the service's settings. There are none yet, and it does not fail.
		def config<T>(val T) !none {}

		// Starts the service. Does not fail today.
		async def start() !none {
			return none
		}

		// Stops the service. Does not fail today.
		async def stop() !none {
			return none
		}

		// Stops the service and starts it again. Does not fail today.
		async def restart() !none {
			return none
		}

		// Starts a profile of the given kind and returns its id. A CPU profile
		// samples every running task's stack 100 times a second; a Memory profile
		// records the stack and size of every allocation.
		//
		// Fails when a profile of that kind already runs, when the kind is Heap or
		// GPU (not implemented yet), on a platform without profiling signals (CPU),
		// and in release builds.
		@commit()
		def profileStart(kind ProfileKind) !ProfileId {
			let code = profileKindCode(kind)
			fail "not implemented" when code < 0

			let seq = __profileStart(int32(code))
			try failProfile(seq, "a {kind.str()} profile is already running")
			return "{code}:{seq}"
		}

		// Stops the profile and returns what it collected.
		//
		// Fails when id names no running profile.
		@commit()
		def profileStop(id ProfileId) !Profile {
			let parts = id.split(":")
			fail "no running profile {id}" unless parts.len() == 2

			let code = parts[0].toInt<int>()
			fail "no running profile {id}" unless __profileStop(int32(code), parts[1].toInt<int64>()) == 0

			let samples = ProfileSample[]
			let n = int(__profileResultLen())
			for let i = 0; i < n; i++ {
				let at = int32(i)
				let stack = errors.StackFrame[]
				let depth = int(__profileResultDepth(at))
				for let j = 0; j < depth; j++ {
					let f = int32(j)
					stack.push(errors.StackFrame{
						name:     __profileResultName(at, f),
						location: errors.Location{
							file:   __profileResultFile(at, f),
							line:   int(__profileResultLine(at, f)),
							column: int(__profileResultCol(at, f))
						}
					})
				}
				samples.push(ProfileSample{
					stack: stack,
					count: int(__profileResultCount(at)),
					bytes: int(__profileResultBytes(at))
				})
			}
			let profile = Profile{
				kind:     code == 0 ?? (ProfileKind.CPU, ProfileKind.Memory),
				duration: duration(__profileResultDurationNs()),
				interval: duration(__profileResultIntervalNs()),
				samples:  samples
			}
			__profileResultClear()
			return profile
		}

		// Starts recording the calls of every @trace function and method, and
		// returns the trace's id.
		//
		// Fails when a trace already runs, and in release builds.
		@commit()
		def traceStart() !TraceId {
			let seq = __traceStart()
			try failProfile(seq, "a trace is already running")
			return "{seq}"
		}

		// Stops the trace and returns what it recorded.
		//
		// Fails when id names no running trace.
		@commit()
		def traceStop(id TraceId) !Trace {
			fail "no running trace {id}" unless __traceStop(id.toInt<int64>()) == 0

			let events = TraceEvent[]
			let n = int(__traceResultLen())
			for let i = 0; i < n; i++ {
				let at = int32(i)
				let file = __traceResultFile(at)
				let location ?errors.Location = none
				if file != "" {
					location = errors.Location{file: file, line: int(__traceResultLine(at)), column: int(__traceResultCol(at))}
				}
				events.push(TraceEvent{
					name:     __traceResultName(at),
					location: location,
					task:     int(__traceResultTask(at)),
					start:    new time.Time(duration(__traceResultStartWallNs(at)), duration(__traceResultStartMonoNs(at))),
					duration: duration(__traceResultDurationNs(at)),
					depth:    int(__traceResultDepth(at))
				})
			}
			__traceResultClear()
			return Trace{events: events}
		}

		// The stack trace of the calling task.
		@query()
		def stackTrace() errors.StackTrace {
			return errors.StackTrace{}
		}

		// Takes a heap snapshot.
		//
		// Fails always: not implemented yet.
		@query()
		def heapSnapshot() !HeapSnapshot {
			fail "not implemented"
		}

		// Breaks into the debugger when one is attached; otherwise does nothing.
		//
		// Does not fail today.
		@commit()
		def pause() !none {
			return none
		}

		// Emitted when a watched field or variable is read or written.
		//
		// Which accesses count is the watch's mode.
		@emit()
		def watched(event WatchEvent) WatchEvent {
			return {}
		}
	}

	// Records the function's calls while a trace is running.
	//
	// Each call logs when it started, how long it took, who called it and what error it returned.
	//
	// Tracing itself is started with Debugger.traceStart and stopped with Debugger.traceStop.
	meta def trace(target reflection.FunctionMetaContext) {}

	// Records the method's calls while a trace is running.
	//
	// Each call logs when it started, how long it took, who called it and what error it returned.
	//
	// Tracing itself is started with Debugger.traceStart and stopped with Debugger.traceStop.
	meta def trace(target reflection.MethodMetaContext) {}

	// Compiles the function without optimisation.
	//
	// It is not inlined either, so a debugger sees it as written.
	meta def noOptimize(target FunctionMetaContext) {}

	// Compiles the method without optimisation and never inlines it.
	meta def noOptimize(target MethodMetaContext) {}

	// Reports the caller's location instead of the function's own in diagnostics.
	//
	// For helpers that fail on the caller's behalf, so the message points at the call, not at the
	// helper.
	meta def trackCaller(target reflection.FunctionMetaContext) {}

	// Reports the caller's location instead of the method's own in diagnostics.
	meta def trackCaller(target reflection.MethodMetaContext) {}

	// Emits Debugger.watched on every access to the field.
	//
	// mode picks reads, writes or both.
	//
	// Every access becomes a call, so leave it out of release builds.
	meta def watch(target reflection.FieldMetaContext, mode WatchMode = WatchMode.Write) {}

	// Emits Debugger.watched on every access to the variable.
	meta def watch(target reflection.VariableMetaContext, mode WatchMode = WatchMode.Write) {}
}

internal partial module std.services.debugger {
	use (
		std.services::*
		std.reflection
		std.errors
		std.time
	)

	// The runtime's code for a profile kind, or -1 for one it cannot record.
	def profileKindCode(kind ProfileKind) int {
		match kind {
			case ProfileKind.CPU:
				return 0
			case ProfileKind.Memory:
				return 1
			case ProfileKind.Heap, ProfileKind.GPU:
				return -1
		}
	}

	// Turns the runtime's negative start codes into failures.
	def failProfile(seq int64, running string) !none {
		fail running when seq == -1
		fail "not supported on this platform" when seq == -3
		fail "needs the shadow call stack, which release builds drop" when seq == -4
		fail "could not start" when seq <= 0
	}

	@c("adm_runtime.h", symbol = "adm_profile_start", ret = "int64_t", params = ["int32_t"])
	def __profileStart(kind int32) int64;

	@c("adm_runtime.h", symbol = "adm_profile_stop", ret = "int32_t", params = ["int32_t", "int64_t"])
	def __profileStop(kind int32, seq int64) int32;

	@c("adm_runtime.h", symbol = "adm_profile_result_duration_ns", ret = "int64_t", params = [])
	def __profileResultDurationNs() int64;

	@c("adm_runtime.h", symbol = "adm_profile_result_interval_ns", ret = "int64_t", params = [])
	def __profileResultIntervalNs() int64;

	@c("adm_runtime.h", symbol = "adm_profile_result_len", ret = "int32_t", params = [])
	def __profileResultLen() int32;

	@c("adm_runtime.h", symbol = "adm_profile_result_count", ret = "int64_t", params = ["int32_t"])
	def __profileResultCount(i int32) int64;

	@c("adm_runtime.h", symbol = "adm_profile_result_bytes", ret = "int64_t", params = ["int32_t"])
	def __profileResultBytes(i int32) int64;

	@c("adm_runtime.h", symbol = "adm_profile_result_depth", ret = "int32_t", params = ["int32_t"])
	def __profileResultDepth(i int32) int32;

	@c("adm_runtime.h", symbol = "adm_profile_result_name", ret = "const char*", params = ["int32_t", "int32_t"])
	def __profileResultName(i int32, frame int32) string;

	@c("adm_runtime.h", symbol = "adm_profile_result_file", ret = "const char*", params = ["int32_t", "int32_t"])
	def __profileResultFile(i int32, frame int32) string;

	@c("adm_runtime.h", symbol = "adm_profile_result_line", ret = "int32_t", params = ["int32_t", "int32_t"])
	def __profileResultLine(i int32, frame int32) int32;

	@c("adm_runtime.h", symbol = "adm_profile_result_col", ret = "int32_t", params = ["int32_t", "int32_t"])
	def __profileResultCol(i int32, frame int32) int32;

	@c("adm_runtime.h", symbol = "adm_profile_result_clear", ret = "void", params = [])
	def __profileResultClear();

	@c("adm_runtime.h", symbol = "adm_trace_start", ret = "int64_t", params = [])
	def __traceStart() int64;

	@c("adm_runtime.h", symbol = "adm_trace_stop", ret = "int32_t", params = ["int64_t"])
	def __traceStop(seq int64) int32;

	@c("adm_runtime.h", symbol = "adm_trace_result_len", ret = "int32_t", params = [])
	def __traceResultLen() int32;

	@c("adm_runtime.h", symbol = "adm_trace_result_name", ret = "const char*", params = ["int32_t"])
	def __traceResultName(i int32) string;

	@c("adm_runtime.h", symbol = "adm_trace_result_file", ret = "const char*", params = ["int32_t"])
	def __traceResultFile(i int32) string;

	@c("adm_runtime.h", symbol = "adm_trace_result_line", ret = "int32_t", params = ["int32_t"])
	def __traceResultLine(i int32) int32;

	@c("adm_runtime.h", symbol = "adm_trace_result_col", ret = "int32_t", params = ["int32_t"])
	def __traceResultCol(i int32) int32;

	@c("adm_runtime.h", symbol = "adm_trace_result_task", ret = "int64_t", params = ["int32_t"])
	def __traceResultTask(i int32) int64;

	@c("adm_runtime.h", symbol = "adm_trace_result_start_wall_ns", ret = "int64_t", params = ["int32_t"])
	def __traceResultStartWallNs(i int32) int64;

	@c("adm_runtime.h", symbol = "adm_trace_result_start_mono_ns", ret = "int64_t", params = ["int32_t"])
	def __traceResultStartMonoNs(i int32) int64;

	@c("adm_runtime.h", symbol = "adm_trace_result_duration_ns", ret = "int64_t", params = ["int32_t"])
	def __traceResultDurationNs(i int32) int64;

	@c("adm_runtime.h", symbol = "adm_trace_result_depth", ret = "int32_t", params = ["int32_t"])
	def __traceResultDepth(i int32) int32;

	@c("adm_runtime.h", symbol = "adm_trace_result_clear", ret = "void", params = [])
	def __traceResultClear();
}
