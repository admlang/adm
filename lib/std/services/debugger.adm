partial module std.services {
	use (
		std.reflection
		std.errors
	)

	type ProfileId = string

	enum ProfileKind {
		CPU,
		Memory,
		Heap,
		GC,
		GPU,
	}

	struct Profile {}

	type TraceId = string

	struct Trace {
		// leave empty for now
	}

	struct HeapSnapshot {}

	enum WatchMode {
		Read,
		Write,
		ReadWrite,
	}

	struct WatchEvent {
		// leave details for later
	}

	service Debugger {
		description           = ""
		dependencies          = Dependencies{
			hard: [Runtime],
			soft: [Diagnostics]
		}
		lifecycle             = Lifecycle{
			start: StartMode.Manual,
			restart: RestartMode.Always,
		}
		permissions  string[]

		def config<T>(val T) !none {}

		async def start() !none {
			return none
		}

		async def stop() !none {
			return none
		}

		async def restart() !none {
			return none
		}

		// Starts collecting profiling data of the specified kind.
		//
		// Returns an identifier that can be used to stop the profiling session.
		@commit()
		def profileStart(kind ProfileKind) !ProfileId {
			fail "not implemented"
		}

		// Stops the specified profiling session and returns the collected profile.
		@commit()
		def profileStop(id ProfileId) !Profile {
			fail "not implemented"
		}

		// Starts recording runtime execution events.
		@commit()
		def traceStart() !TraceId {
			fail "not implemented"
		}

		// Stops the specified trace and returns the recorded data.
		@commit()
		def traceStop(id TraceId) !Trace {
			fail "not implemented"
		}

		// Triggers a garbage collection cycle.
		@commit()
		def gc() !none {
			return none
		}

		// Returns the current stack trace for the calling execution.
		@query()
		def stackTrace() errors.StackTrace {
			return errors.StackTrace{}
		}

		// Captures a snapshot of the current heap.
		@query()
		def heapSnapshot() !HeapSnapshot {
			fail "not implemented"
		}

		// Pauses execution when an interactive debugger is attached.
		@commit()
		def pause() !none {
			return none
		}

		// Emitted when an access matches an active debugger watch.
		//
		// The event is emitted for reads, writes, or both according to the watch mode
		// configured on the watched field or variable.
		@emit()
		def watched(event WatchEvent) WatchEvent {
			return {}
		}
	}

	// Marks the annotated function for detailed debugger tracing.
	//
	// When a trace session is active, the debugger records execution information
	// for the function, such as invocation time, duration, caller relationships,
	// returned errors, and other runtime events available to the debugger.
	//
	// The annotation does not start or stop a trace session. Trace collection is
	// controlled through Debugger.traceStart() and Debugger.traceStop().
	meta def trace(target reflection.FunctionMetaContext) {}

	// Marks the annotated method for detailed debugger tracing.
	//
	// When a trace session is active, the debugger records execution information
	// for the method, such as invocation time, duration, caller relationships,
	// returned errors, and other runtime events available to the debugger.
	//
	// The annotation does not start or stop a trace session. Trace collection is
	// controlled through Debugger.traceStart() and Debugger.traceStop().
	meta def trace(target reflection.MethodMetaContext) {}

	// Prevents the annotated function from being inlined by the compiler.
	meta def noInline(target FunctionMetaContext) {}

	meta def noInline(target MethodMetaContext) {}

	// Disables compiler optimizations for the annotated function.
	//
	// The function is also prevented from being inlined to preserve its
	// source-level execution structure for debugging.
	meta def noOptimize(target FunctionMetaContext) {}

	meta def noOptimize(target MethodMetaContext) {}

	// Preserves the source location of the caller when invoking the annotated
	// function.
	//
	// Diagnostics originating from the function may report the caller's location
	// instead of the function's internal implementation location.
	meta def trackCaller(target reflection.FunctionMetaContext) {}

	meta def trackCaller(target reflection.MethodMetaContext) {}

	// Watches accesses to the annotated field.
	//
	// Emits debugger watch events whenever the field is read, written, or both,
	// according to the selected mode.
	//
	// Watch instrumentation may significantly affect performance and is intended
	// for debugging and development use.
	meta def watch(target reflection.FieldMetaContext, mode WatchMode = WatchMode.Write) {}

	meta def watch(target reflection.VariableMetaContext, mode WatchMode = WatchMode.Write) {}
}
