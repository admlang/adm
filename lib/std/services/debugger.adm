partial module std.services {
	use (
		std.reflection
		std.errors
	)

	// Identifies a running profile; profileStart returns one and profileStop takes it.
	type ProfileId = string

	// What a profile records: CPU time, memory, the heap, collections or the GPU.
	enum ProfileKind {
		CPU,
		Memory,
		Heap,
		GC,
		GPU,
	}

	// The data a stopped profile produced. Empty until profiling is implemented.
	struct Profile {}

	// Identifies a running trace; traceStart returns one and traceStop takes it.
	type TraceId = string

	// The events a stopped trace collected. Empty until tracing is implemented.
	struct Trace {
		// leave empty for now
	}

	// The live objects at one moment. Empty until snapshots are implemented.
	struct HeapSnapshot {}

	// Which accesses a @watch reports: reads, writes or both.
	enum WatchMode {
		Read,
		Write,
		ReadWrite,
	}

	// One access to a watched field or variable. Details come with the watch implementation.
	struct WatchEvent {
		// leave details for later
	}

	// Profiles, traces and watches for a running program.
	//
	// Most of it waits on the runtime exposing the data: profiling, tracing and heap
	// snapshots fail with not implemented.
	service Debugger {
		description               = ""
		dependencies              = Dependencies{
			hard: [Runtime],
			soft: [Diagnostics]
		}
		lifecycle                 = Lifecycle{
			start: StartMode.Manual,
			restart: RestartMode.Always,
		}
		permissions  Permission[]

		// Applies the service's settings. There are none yet, and it does not fail.
		def config<T>(val T) !none {}

		// Starts the service. Does not fail today.
		async def start() !none {
			return none
		}

		// Stops the service. Does not fail today.
		async def stop() !none {
			return none
		}

		// Stops the service and starts it again. Does not fail today.
		async def restart() !none {
			return none
		}

		// Starts a profile of the given kind and returns its id.
		//
		// Fails always: not implemented yet.
		@commit()
		def profileStart(kind ProfileKind) !ProfileId {
			fail "not implemented"
		}

		// Stops the profile and returns what it collected.
		//
		// Fails always: not implemented yet.
		@commit()
		def profileStop(id ProfileId) !Profile {
			fail "not implemented"
		}

		// Starts a trace and returns its id.
		//
		// Fails always: not implemented yet.
		@commit()
		def traceStart() !TraceId {
			fail "not implemented"
		}

		// Stops the trace and returns what it recorded.
		//
		// Fails always: not implemented yet.
		@commit()
		def traceStop(id TraceId) !Trace {
			fail "not implemented"
		}

		// Triggers a garbage collection cycle.
		//
		// Does not fail today: reference counting has no collection to run.
		@commit()
		def gc() !none {
			return none
		}

		// The stack trace of the calling task.
		@query()
		def stackTrace() errors.StackTrace {
			return errors.StackTrace{}
		}

		// Takes a heap snapshot.
		//
		// Fails always: not implemented yet.
		@query()
		def heapSnapshot() !HeapSnapshot {
			fail "not implemented"
		}

		// Breaks into the debugger when one is attached; otherwise does nothing.
		//
		// Does not fail today.
		@commit()
		def pause() !none {
			return none
		}

		// Emitted when a watched field or variable is read or written.
		//
		// Which accesses count is the watch's mode.
		@emit()
		def watched(event WatchEvent) WatchEvent {
			return {}
		}
	}

	// Records the function's calls while a trace is running.
	//
	// Each call logs when it started, how long it took, who called it and what error it returned.
	//
	// Tracing itself is started with Debugger.traceStart and stopped with Debugger.traceStop.
	meta def trace(target reflection.FunctionMetaContext) {}

	// Records the method's calls while a trace is running.
	//
	// Each call logs when it started, how long it took, who called it and what error it returned.
	//
	// Tracing itself is started with Debugger.traceStart and stopped with Debugger.traceStop.
	meta def trace(target reflection.MethodMetaContext) {}

	// Keeps the compiler from inlining the function.
	meta def noInline(target FunctionMetaContext) {}

	// Keeps the compiler from inlining the method.
	meta def noInline(target MethodMetaContext) {}

	// Compiles the function without optimisation.
	//
	// It is not inlined either, so a debugger sees it as written.
	meta def noOptimize(target FunctionMetaContext) {}

	// Compiles the method without optimisation and never inlines it.
	meta def noOptimize(target MethodMetaContext) {}

	// Reports the caller's location instead of the function's own in diagnostics.
	//
	// For helpers that fail on the caller's behalf, so the message points at the call, not at the
	// helper.
	meta def trackCaller(target reflection.FunctionMetaContext) {}

	// Reports the caller's location instead of the method's own in diagnostics.
	meta def trackCaller(target reflection.MethodMetaContext) {}

	// Emits Debugger.watched on every access to the field.
	//
	// mode picks reads, writes or both.
	//
	// Every access becomes a call, so leave it out of release builds.
	meta def watch(target reflection.FieldMetaContext, mode WatchMode = WatchMode.Write) {}

	// Emits Debugger.watched on every access to the variable.
	meta def watch(target reflection.VariableMetaContext, mode WatchMode = WatchMode.Write) {}
}
