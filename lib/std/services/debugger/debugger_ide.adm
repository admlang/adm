// The Debugger service's IDE panel: the buttons that profile the program for a
// while, take a heap snapshot and break into an attached debugger.

partial module std.services.debugger {
	use (
		std.ide::(ide, IdeKind)
		std.time
	)

	partial service Debugger {
		// Profiles the processor for the time given and answers the functions
		// it was found in most, with their share of the samples.
		@ide(kind = IdeKind.Action, label = "Profile processor")
		def ideProfileCpu(length duration = 5s) !string {
			let id = try profileStart(ProfileKind.CPU)
			time.sleep(length)
			let profile = try profileStop(id)
			return profileSummary(profile)
		}

		// The live heap: how many allocations and bytes.
		@ide(kind = IdeKind.Action, label = "Heap snapshot")
		def ideHeap() !string {
			let snapshot = try heapSnapshot()
			return "{snapshot.objects} allocations, {snapshot.bytes} bytes"
		}

		@ide(kind = IdeKind.Action, label = "Pause in the debugger")
		def idePause() !none {
			return pause()
		}
	}

	// A profile in a line: its sample count and the ten innermost functions
	// that took the most samples.
	internal def profileSummary(profile Profile) string {
		let total = 0
		let byName = map<string, int>{}
		for let (_, sample) in profile.samples {
			total += sample.count
			continue when sample.stack.len() == 0
			let name = sample.stack[0].name
			byName[name] = byName.get(name) is none ?? (sample.count, byName[name] + sample.count)
		}
		return "no samples" when total == 0
		let names = byName.keys()
		names.sort((a, b) => byName[a] > byName[b])
		let parts = string[]
		for let (i, name) in names {
			break when i >= 10
			parts.push("{name} {byName[name] * 100 / total}%")
		}
		return "{total} samples: {parts.join(", ")}"
	}
}
