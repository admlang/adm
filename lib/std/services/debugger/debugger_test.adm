partial module std.services.debugger {
	use (
		std.testing
		std.time
		std.errors
	)

	// Fields a check below watches.
	internal type WatchedBox {
		@watch(mode = WatchMode.ReadWrite)
		count int = 0

		@watch()
		label string = ""
	}

	@watch(mode = WatchMode.ReadWrite)
	internal let watchedTotal = 0

	internal let watchLog string[] = []

	// Logs every watched access; its own access to a watched variable reports
	// nothing.
	@on(Debugger.watched)
	internal def debuggerHeard(ev Event<WatchEvent>) {
		let e = ev.result
		let previous = e.previous is none ?? ("-", "{e.previous}")
		let location = e.location
		let line = location is none ?? (0, location.line)
		watchLog.push("{e.name} {e.write ?? ("write", "read")} {e.value} {previous} {line > 0}")
		watchedTotal = watchedTotal
	}

	// Burns CPU in a traced function so samples and spans land in it.
	@trace()
	internal def debuggerSpin(rounds int) int {
		let total = 0
		for let i = 0; i < rounds; i++ {
			total = (total + i * 7) % 1000003
		}
		return total
	}

	// Allocates from a known function for the memory profile.
	internal def debuggerAllocate(n int) int {
		let kept = string[]
		for let i = 0; i < n; i++ {
			kept.push("item {i}")
		}
		return kept.len()
	}

	// What a heap check keeps alive, made in a function of its own.
	internal let debuggerKept string[] = []

	internal def debuggerKeep(n int) {
		for let i = 0; i < n; i++ {
			debuggerKept.push("kept {i} {i * 7}")
		}
	}

	// Reports whether any sample's stack names the function.
	internal def debuggerSampled(profile Profile, name string) bool {
		for let (_, sample) in profile.samples {
			for let (_, frame) in sample.stack {
				return true when frame.name.endsWith(name)
			}
		}
		return false
	}

	check "Debugger" {
		@test()
		def TestCPUProfileSamplesBusyFunction() !none {
			let id = try Debugger.profileStart(ProfileKind.CPU)
			// Each round spins far longer than the clock read that ends the loop,
			// so nearly every sample lands in debuggerSpin. The exact total keeps
			// the optimizer from deleting the spin as dead code.
			let started = time.now()
			let total = 0
			let rounds = 0
			for time.since(started) < 300ms {
				total += debuggerSpin(20000000)
				rounds++
			}
			let profile = try Debugger.profileStop(id)
			assert total == rounds * 12810
			assert profile.kind == ProfileKind.CPU
			assert profile.interval == 10ms
			assert profile.duration >= 300ms
			assert profile.samples.len() > 0
			assert debuggerSampled(profile, "debuggerSpin")
			return none
		}

		@test()
		def TestMemoryProfileCountsAllocations() !none {
			let id = try Debugger.profileStart(ProfileKind.Memory)
			assert debuggerAllocate(1000) == 1000
			let profile = try Debugger.profileStop(id)
			assert profile.kind == ProfileKind.Memory
			assert debuggerSampled(profile, "debuggerAllocate")
			let bytes = 0
			for let (_, sample) in profile.samples {
				bytes += sample.bytes
			}
			assert bytes > 0
			return none
		}

		@test()
		def TestProfileOfSameKindRefusedWhileRunning() !none {
			let id = try Debugger.profileStart(ProfileKind.Memory)
			let again = Debugger.profileStart(ProfileKind.Memory)
			assert again is error
			let _ = try Debugger.profileStop(id)
			let stale = Debugger.profileStop(id)
			assert stale is error
			return none
		}

		@test()
		def TestUnimplementedKindFails() {
			assert Debugger.profileStart(ProfileKind.GPU) is error
		}

		@test()
		def TestTraceRecordsTracedCalls() !none {
			let id = try Debugger.traceStart()
			debuggerSpin(10)
			debuggerSpin(20)
			debuggerAllocate(3)
			let trace = try Debugger.traceStop(id)
			assert trace.events.len() == 2
			let first = trace.events[0]
			assert first.name.endsWith("debuggerSpin")
			assert first.location is errors.Location
			assert first.duration >= 0s
			assert first.depth > 0
			return none
		}

		@test()
		def TestUntracedCallsAfterStopAreNotRecorded() !none {
			let id = try Debugger.traceStart()
			let trace = try Debugger.traceStop(id)
			debuggerSpin(10)
			assert trace.events.len() == 0
			return none
		}
	}

	check "Watch" {
		@test()
		def fieldAccessesAreReported() {
			let box = new WatchedBox()
			watchLog.len(0)
			box.count += 2
			box.label = "a"
			let n = box.count
			assert n == 2
			assert watchLog.join("; ") == "std.services.debugger.WatchedBox.count read 0 - true; std.services.debugger.WatchedBox.count write 2 0 true; std.services.debugger.WatchedBox.label write a  true; std.services.debugger.WatchedBox.count read 2 - true"
		}

		// A read of a field whose watch takes stores only is not reported.
		@test()
		def modeLeavesOtherAccessesAlone() {
			let box = new WatchedBox()
			watchLog.len(0)
			let text = box.label
			assert text == ""
			assert watchLog.len() == 0
		}

		@test()
		def variableAccessesAreReported() {
			watchLog.len(0)
			watchedTotal = 5
			let t = watchedTotal
			assert t == 5
			// The handler's own store of watchedTotal reports nothing.
			assert watchLog.join("; ") == "std.services.debugger.watchedTotal write 5 0 true; std.services.debugger.watchedTotal read 5 - true"
		}
	}

	check "Heap" {
		// What is still live at the stop is reported by stack; what was freed
		// before it is not.
		@test()
		def heapProfileKeepsWhatIsLive() !none {
			let id = try Debugger.profileStart(ProfileKind.Heap)
			debuggerKeep(500)
			let dropped = debuggerAllocate(500)
			assert dropped == 500
			let profile = try Debugger.profileStop(id)
			assert profile.kind == ProfileKind.Heap
			assert profile.interval == 0s
			assert debuggerSampled(profile, "debuggerKeep")
			assert !debuggerSampled(profile, "debuggerAllocate")
			for let (_, sample) in profile.samples {
				assert sample.count > 0 && sample.bytes > 0
			}
			debuggerKept.len(0)
			return none
		}

		@test()
		def snapshotCountsTheHeap() !none {
			let plain = try Debugger.heapSnapshot()
			assert plain.objects > 0 && plain.bytes > 0
			assert plain.samples.len() == 0
			let id = try Debugger.profileStart(ProfileKind.Heap)
			debuggerKeep(200)
			let during = try Debugger.heapSnapshot()
			assert during.objects > 0
			let found = false
			for let (_, sample) in during.samples {
				for let (_, frame) in sample.stack {
					found = true when frame.name.endsWith("debuggerKeep")
				}
			}
			assert found
			let _ = try Debugger.profileStop(id)
			debuggerKept.len(0)
			return none
		}
	}
}
