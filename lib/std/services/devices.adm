		lifecycle                 = Lifecycle{
			start: StartMode.Manual,
			restart: RestartMode.Always,
		}
		permissions  Permission[]

		// Applies the service's settings. There are none yet, and it does not fail.
		def config<T>(val T) !none {}

		// Starts the service. Does not fail today.
		async def start() !none {
			return none
		}

		// Stops the service. Does not fail today.
		async def stop() !none {
			return none
		}

		// Stops the service and starts it again. Does not fail today.
		async def restart() !none {
			return none
		}
		// identifies and communicates with computer peripherals (usb devices, mouse, keyboard, etc)

		// Lists the connected devices. Not implemented yet.
		def list() {}

		// Watches for devices connecting and disconnecting. Not implemented yet.
		def watch() {}

		// Opens the device with the id. Not implemented yet.
		def open(id int) {}

		// Closes the device. Not implemented yet.
