partial module std.services.devices {
	use (
		std.services::(Dependencies, Lifecycle, RestartMode, ServiceStatus, StartMode)
		std.services.policy::(Policy, PolicyDenied)
		std.time
		std.services.devices.sysfs::*
	)

	// What a device is, from the bus and driver that expose it.
	enum DeviceKind {
		Usb,
		Camera,
		Keyboard,
		// A pointing device: a mouse, a touch pad, a pen tablet.
		Mouse,
		// A game pad, joystick, wheel or other game controller.
		Gamepad,
		// A sound card as a whole; its outputs and inputs are listed as Speaker and Microphone.
		Audio,
		// One sound output of a card: analog jack, HDMI, USB headset.
		Speaker,
		// One sound input of a card.
		Microphone,
		Storage,
		Hid,
		// A graphics card or integrated GPU, one per render node.
		Gpu,
		// A serial port: a USB serial adapter, a board's UART, a modem's or
		// a microcontroller's port (`std.devices.openSerial`).
		Serial,
		// A satellite navigation receiver: a serial port whose USB ids are a
		// GPS maker's, or a receiver gpsd serves (`std.devices.openGps`).
		Gps,
		Other,
	}

	// A connected device.
	struct Device {
		// Stable identifier while the device stays connected: the bus and its address, e.g. "usb:1-2", "video:video0", "input:event3".
		id        string
		kind      DeviceKind
		// Human name from the driver or the descriptor ("MX Brio").
		name      string
		// USB vendor and product ids, 0 when the bus has none.
		vendorId  int
		productId int
		vendor    string
		product   string
		serial    string
		// Device node a program opens ("/dev/video0"), empty when there is none.
		node      string
		// Bus the device hangs on: "usb", "pci", "platform", "virtual", ...
		bus       string
		// Whether this is the output or input the desktop sends sound to or takes it
		// from; only speakers and microphones listed by `std.devices` are ever default.
		isDefault bool       = false
		// For a Hid device, the usage page of its first top-level collection
		// (0xF1D0 for a FIDO security key, 0x01 for generic desktop); 0 otherwise.
		usagePage int        = 0
	}

	// The rule for the `camera` and `microphone` permissions: which devices
	// a package may open, by id (`video:video0`, `sound:pcmC1D0c`, or the
	// sound server's name for a speaker or microphone). In `policy.toml`:
	//
	// ```toml
	// [adm.devices.camera]
	// device.allow = ["video:video0"]
	// device.deny  = ["*"]
	// ```
	//
	// A pattern takes `*` for any run of characters.
	type DeviceSpec {
		device Rule<string>

		// Checks a device id against the rule.
		//
		// Fails with PolicyDenied when the rule denies it; an `ask` outcome
		// fails with the code `policy.ask` so the runtime can prompt.
		def validate(value string) !none {
			let decision = device.decide(value)
			fail PolicyDenied{message: "device denied by policy: {value}", permission: "", field: "device"} when decision == Decision.Deny
			fail PolicyDenied{message: "device asks: {value}", code: "policy.ask", permission: "", field: "device"} when decision == Decision.Ask
			return none
		}
	}

	// Finds the peripherals connected to this machine: USB devices, cameras,
	// keyboards, mice, sound cards, removable disks, GPUs, serial ports and
	// GPS receivers.
	//
	// On Linux the devices come from the kernel's own description of them under
	// `/sys`, read directly; no program is started and no device is opened to
	// list one. Other platforms report no devices yet, and `watch` there polls an
	// empty list. `list` and `get` need the `adm.devices.list` permission,
	// `open` none of its own. `camera`, `microphone`, `input`, `serial` and
	// `location` are declared here and required by the `std.devices`
	// functions that open those kinds, and `volume` by those that change a
	// speaker's or microphone's volume.
	//
	// A device's `id` names the bus entry it came from, so the same physical
	// camera appears once per video node it exposes, and once more as the USB
	// device behind them.
	//
	// `watch` starts a task that emits `connected` and `disconnected` for the
	// devices that appeared and went away since the listing before. On Linux
	// it re-lists when the kernel announces a device event (the uevents udev
	// reads, from a netlink socket); where it cannot have those it re-lists
	// every `period`.
	service Devices {
		description  = "See which devices are connected to this machine"
		dependencies = Dependencies{
			hard: [Policy]
		}
		lifecycle    = Lifecycle{
			start: StartMode.Manual,
			restart: RestartMode.Always,
		}
		permissions  = [
			Permission{name: "list", description: "See which devices are connected"},
			Permission{name: "camera", description: "Capture video from a camera", spec: DeviceSpec},
			Permission{name: "microphone", description: "Record sound from a microphone", spec: DeviceSpec},
			Permission{name: "input", description: "Read keyboards, mice and game pads directly, outside the program's windows", spec: DeviceSpec},
			Permission{name: "volume", description: "Change the volume of the speakers and microphones, and mute them", spec: DeviceSpec},
			Permission{name: "serial", description: "Talk to devices on serial ports", spec: DeviceSpec},
			Permission{name: "location", description: "Know where this computer is"},
		]

		// The running watcher; none until `watch` and after `unwatch`.
		watcher ?DeviceWatcher   = none
		// The device behind each descriptor `open` returned and `close` has not closed.
		held    map<int, Device> = map<int, Device>{}

		// Applies the service's settings. There are none yet, and it does not fail.
		def config<T>(val T) !none {
			return none
		}

		// Starts the service. Devices are read on each call, so this does not fail.
		async def start() !none {
			status = ServiceStatus.Started
			return none
		}

		// Stops the watcher when one runs. Does not fail today.
		async def stop() !none {
			status = ServiceStatus.Stopped
			stopWatcher()
			return none
		}

		// Stops the service and starts it again. Does not fail today.
		async def restart() !none {
			status = ServiceStatus.Restarting
			try await stop()
			try await start()
			return none
		}

		// Every connected device, or only those of one kind.
		//
		// Fails when the policy denies listing the devices.
		@query(policy = "list")
		def list(kind ?DeviceKind = none) !Device[] {
			let all = scanDevices()
			return all when kind is none
			let wanted DeviceKind = kind
			let out Device[]
			for let (_, device) in all {
				out.push(device) when device.kind == wanted
			}
			return out
		}

		// The GPUs, one per render node (`/dev/dri/renderD128`), in node
		// order. Listing them needs no permission: std opens one itself to
		// decode video on it.
		@query()
		def gpus() Device[] {
			return gpuDevices()
		}

		// The device with that id, or none.
		//
		// Fails when the policy denies listing the devices.
		@query(policy = "list")
		def get(id string) !?Device {
			return findDevice(id)
		}

		// Starts watching for devices connecting and disconnecting;
		// connected/disconnected fire for the changes. On Linux the kernel's
		// device events trigger a new listing; without them the devices are
		// listed again every period. The devices already there when watching
		// starts are not reported.
		//
		// Fails when already watching or the period is not positive.
		@commit()
		def watch(period duration = 1s) !none {
			expects {
				assert period > 0s onerror fail "devices: the watch period must be positive"
			}
			fail "devices: already watching" unless runningWatcher() is none
			let current = map<string, Device>{}
			for let (_, device) in scanDevices() {
				current[device.id] = device
			}
			let started = new DeviceWatcher(period, current, deviceEvents())
			watcher = started
			async watchLoop(started)
			return none
		}

		// Stops watching.
		//
		// Fails when not watching.
		@commit()
		def unwatch() !none {
			let running = runningWatcher()
			fail "devices: not watching" when running is none
			let watching DeviceWatcher = running
			watching.stop()
			watcher = none
			return none
		}

		// Whether the watching task runs.
		@query()
		def watching() bool {
			return !(runningWatcher() is none)
		}

		// Emitted when a device appears.
		@emit()
		def connected(device Device) Device {
			return device
		}

		// Emitted when a device goes away.
		@emit()
		def disconnected(device Device) Device {
			return device
		}

		// Opens the device's node for reading and writing and returns its descriptor for
		// Storage.read/write/control/map/wait. Opening asks no permission of its own: the
		// modules that drive a kind of device (`std.devices.openCamera`,
		// `openMicrophone`) require the kind's permission themselves.
		//
		// Fails when there is no such device, it has no node, or the node cannot be opened.
		@commit()
		def open(id string) !int {
			let found = findDevice(id)
			fail "devices: no device with the id {id}" when found is none
			let device Device = found
			fail "devices: {id} has no device node to open" when device.node == ""
			// A sound endpoint another program holds would block a plain open
			// until it is let go, and a serial port until its carrier is up.
			let waits = device.kind := DeviceKind.Speaker || DeviceKind.Microphone || DeviceKind.Serial || DeviceKind.Gps
			let fd = try (waits ?? (__fs_open_device(device.node, "r+"), __fs_open(device.node, "r+")))
			held[fd] = device
			return fd
		}

		// The device a descriptor `open` returned belongs to, none for one it
		// did not return or that is closed. Holding the descriptor is what
		// tells a program about the device, so this asks no permission.
		@query()
		def opened(fd int) ?Device {
			return held.get(fd)
		}

		// Closes a descriptor `open` returned. Fails when it is not open.
		@commit()
		def close(fd int) !none {
			held.delete(fd)
			return __fs_close(fd)
		}

		// The device with that id, or none; `open` looks it up without the `list`
		// permission, so a device's own permission alone opens it.
		def findDevice(id string) ?Device {
			for let (_, device) in scanDevices() {
				return device when device.id == id
			}
			return none
		}

		// The watcher while its task runs; none before `watch` and after `unwatch`.
		def runningWatcher() ?DeviceWatcher {
			let current = watcher
			return none when current is none
			let running DeviceWatcher = current
			return none unless running.isRunning()
			return running
		}

		// Stops the watcher when one runs; nothing happens when none does.
		def stopWatcher() {
			let current = watcher
			return when current is none
			let running DeviceWatcher = current
			running.stop()
			watcher = none
		}

		// Re-lists the devices until the watcher is stopped and reports what
		// changed: on each burst of device events when the watcher has them,
		// else every period.
		def watchLoop(running DeviceWatcher) {
			let events = running.events()
			if events >= 0 {
				for running.isRunning() {
					break unless running.awaitEvent(DEVICE_SETTLE)
					report(running)
				}
				__net_close(events) onerror recover none
				return
			}
			for running.isRunning() {
				let stopped = running.stopped()
				let sleep = time.sleepChan(running.period())
				select {
					case stopped:
						return
					case sleep:
					// the period passed, list again
				}
				return unless running.isRunning()
				report(running)
			}
		}

		// Lists the devices and emits what appeared and went away since the
		// watcher's last listing.
		def report(running DeviceWatcher) {
			let current = map<string, Device>{}
			for let (_, device) in scanDevices() {
				current[device.id] = device
			}
			let (appeared, disappeared) = running.observe(current)
			for let (_, device) in appeared {
				let _ = connected(device)
			}
			for let (_, device) in disappeared {
				let _ = disconnected(device)
			}
		}
	}
	// --- reading the system's description of its devices ------------------------
}

internal std partial module std.services.devices.sysfs {
	use (
		std.services.devices::(Device, DeviceKind)
		std.time
	)

	// The watcher task's state, shared between the task and the service.
	type DeviceWatcher {
		internal running  bool                = true
		internal delay    duration
		internal seen     map<string, Device>
		internal stopChan channel<none>
		// The socket the kernel's device events arrive on, -1 without one;
		// the task closes it when it ends.
		internal source   int                 = -1

		def new(period duration, devices map<string, Device>, events int) {
			delay = period
			seen = devices
			stopChan = new channel<none>(1)
			source = events
		}

		// Stops the task, waking it out of its wait.
		def stop() {
			markStopped()
			stopChan <- none
			// Shutting the socket down wakes a read in progress; the task
			// closes it once that read has left.
			if source >= 0 {
				__net_wake(source) onerror recover none
			}
		}

		// The device event socket, -1 when the watcher polls.
		def events() int {
			return source
		}

		// Waits for a device event the listing may show (a device of a bus
		// or class `scanDevices` reads), then for the burst it starts to end,
		// `settle` without another, so one plug is one listing. False once
		// the socket is shut down or fails.
		def awaitEvent(settle duration) bool {
			let buf byte[]
			buf.len(UEVENT_MAX)
			for isRunning() {
				let n = __net_read(source, buf, WAKE_EVERY) onerror (err error) {
					recover err.code == "ETIMEDOUT" ?? (-2, -1)
				}
				continue when n == -2
				return false when n <= 0
				continue unless listedSubsystem(buf.slice(0, n))
				// The rest of the burst: udev names the nodes meanwhile.
				for isRunning() {
					let more = __net_read(source, buf, settle) onerror (err error) {
						recover err.code == "ETIMEDOUT" ?? (-2, -1)
					}
					return true when more == -2
					return false when more <= 0
				}
			}
			return false
		}

		atomic def markStopped() {
			running = false
		}

		atomic def isRunning() bool {
			return running
		}

		atomic def period() duration {
			return delay
		}

		// The channel the task waits on, closed by `stop`.
		def stopped() channel<none> {
			return stopChan
		}

		// Records the devices seen now and returns the ones that appeared and
		// the ones that went away since the listing before.
		atomic def observe(current map<string, Device>) (Device[], Device[]) {
			let appeared Device[]
			let disappeared Device[]
			for let (id, device) in current {
				appeared.push(device) unless seen.hasKey(id)
			}
			for let (id, device) in seen {
				disappeared.push(device) unless current.hasKey(id)
			}
			seen = current
			return (appeared, disappeared)
		}
	}

	// A socket the kernel's device events arrive on (NETLINK_KOBJECT_UEVENT,
	// its kernel group), -1 where there is none: another platform, or a
	// sandbox or container that refuses netlink.
	def deviceEvents() int {
		return __net_netlink(NETLINK_KOBJECT_UEVENT, UEVENT_KERNEL_GROUP) onerror recover -1
	}

	// Whether a kernel uevent (`ACTION@DEVPATH`, then `KEY=value` fields,
	// each ended by a zero byte) is about a bus or class the listing reads.
	def listedSubsystem(message byte[]) bool {
		let start = 0
		for let i = 0; i <= message.len(); i++ {
			continue unless i == message.len() || message[i] == 0
			let field = string(message.slice(start, i - start))
			start = i + 1
			continue unless field.startsWith("SUBSYSTEM=")
			return field[10:] := "usb" || "video4linux" || "input" || "sound" || "block" || "hidraw" || "drm" || "tty"
		}
		return false
	}

	// linux/netlink.h: the protocol and multicast group of the kernel's
	// device events (udev's own rebroadcast is group 2).
	const NETLINK_KOBJECT_UEVENT = 15
	const UEVENT_KERNEL_GROUP = 1
	// The largest uevent the kernel sends (UEVENT_BUFFER_SIZE).
	const UEVENT_MAX = 2048
	// How long a quiet stretch ends a burst of device events.
	const DEVICE_SETTLE = 100ms
	// How often a waiting watcher looks whether it was stopped, should the
	// wake-up be lost.
	const WAKE_EVERY = 1s

	// The devices this machine reports.
	@os("linux")
	def scanDevices() Device[] {
		let out Device[]
		for let (_, device) in usbDevices() {
			out.push(device)
		}
		for let (_, device) in cameraDevices() {
			out.push(device)
		}
		for let (_, device) in inputDevices() {
			out.push(device)
		}
		for let (_, device) in audioDevices() {
			out.push(device)
		}
		for let (_, device) in soundEndpoints() {
			out.push(device)
		}
		for let (_, device) in blockDevices() {
			out.push(device)
		}
		for let (_, device) in hidDevices() {
			out.push(device)
		}
		for let (_, device) in gpuDevices() {
			out.push(device)
		}
		for let (_, device) in serialDevices() {
			out.push(device)
		}
		return out
	}

	// The devices this machine reports: none, this platform is not read yet.
	@os("darwin")
	def scanDevices() Device[] {
		return []
	}

	// The devices this machine reports: none, this platform is not read yet.
	@os("windows")
	def scanDevices() Device[] {
		return []
	}

	// The USB devices, one per entry of the USB bus that carries a descriptor.
	// An entry whose name holds a colon (`1-2:1.0`) is one interface of a device,
	// not a device. Hubs and host controllers carry descriptors too, so they are
	// listed like any other USB device.
	@os("linux")
	def usbDevices() Device[] {
		let out Device[]
		for let (_, name) in sysList("/sys/bus/usb/devices") {
			continue when name.contains(":")
			let dir = "/sys/bus/usb/devices/" + name
			let vendorId = sysRead(dir + "/idVendor")
			let productId = sysRead(dir + "/idProduct")
			continue when vendorId == "" || productId == ""
			out.push(Device{
				id:        "usb:" + name,
				kind:      DeviceKind.Usb,
				name:      usbName(dir),
				vendorId:  hexValue(vendorId),
				productId: hexValue(productId),
				vendor:    sysRead(dir + "/manufacturer"),
				product:   sysRead(dir + "/product"),
				serial:    sysRead(dir + "/serial"),
				node:      "",
				bus:       "usb",
			})
		}
		return out
	}

	// The cameras, one per video node: the same camera exposes several, one for
	// its images and the others for its metadata and controls.
	@os("linux")
	def cameraDevices() Device[] {
		let out Device[]
		for let (_, name) in sysList("/sys/class/video4linux") {
			let dir = "/sys/class/video4linux/" + name
			let parent = usbParent(dir + "/device", 4)
			out.push(Device{
				id:        "video:" + name,
				kind:      DeviceKind.Camera,
				name:      sysRead(dir + "/name"),
				vendorId:  hexValue(sysRead(parent + "/idVendor")),
				productId: hexValue(sysRead(parent + "/idProduct")),
				vendor:    sysRead(parent + "/manufacturer"),
				product:   sysRead(parent + "/product"),
				serial:    sysRead(parent + "/serial"),
				node:      "/dev/" + name,
				bus:       parent == "" ?? ("platform", "usb"),
			})
		}
		return out
	}

	// The input devices, one per event node.
	@os("linux")
	def inputDevices() Device[] {
		let out Device[]
		for let (_, name) in sysList("/sys/class/input") {
			continue unless name.startsWith("event")
			let dir = "/sys/class/input/" + name
			let parent = usbParent(dir + "/device", 4)
			out.push(Device{
				id:        "input:" + name,
				kind:      inputKind(dir + "/device/capabilities"),
				name:      sysRead(dir + "/device/name"),
				vendorId:  hexValue(sysRead(dir + "/device/id/vendor")),
				productId: hexValue(sysRead(dir + "/device/id/product")),
				vendor:    sysRead(parent + "/manufacturer"),
				product:   sysRead(parent + "/product"),
				serial:    sysRead(dir + "/device/uniq"),
				node:      "/dev/input/" + name,
				bus:       parent == "" ?? ("platform", "usb"),
			})
		}
		return out
	}

	// The sound cards.
	@os("linux")
	def audioDevices() Device[] {
		let out Device[]
		for let (_, name) in sysList("/sys/class/sound") {
			// The class holds the cards and their nodes (`controlC0`, `pcmC0D0p`); only the cards are devices.
			continue unless name.startsWith("card") && name.len() > 4 && name[4].isDigit()
			let dir = "/sys/class/sound/" + name
			let parent = usbParent(dir + "/device", 4)
			out.push(Device{
				id:        "sound:" + name,
				kind:      DeviceKind.Audio,
				name:      sysRead(dir + "/id"),
				vendorId:  hexValue(sysRead(parent + "/idVendor")),
				productId: hexValue(sysRead(parent + "/idProduct")),
				vendor:    sysRead(parent + "/manufacturer"),
				product:   sysRead(parent + "/product"),
				serial:    sysRead(parent + "/serial"),
				// The card's control node: its mixer and what changes on it.
				node: "/dev/snd/controlC" + name[4:],
				bus:  parent == "" ?? ("pci", "usb"),
			})
		}
		return out
	}

	// The speakers and microphones: one per PCM node of a card (`pcmC4D0p` plays,
	// `pcmC4D0c` records), outputs of a card before its HDMI and DisplayPort ones.
	@os("linux")
	def soundEndpoints() Device[] {
		let front Device[]
		let back Device[]
		for let (_, name) in sysList("/sys/class/sound") {
			let endpoint = soundEndpoint(name)
			continue when endpoint is none
			let device Device = endpoint
			let digital = device.name.contains("HDMI") || device.name.contains("DP")
			if digital {
				back.push(device)
			} else {
				front.push(device)
			}
		}
		for let (_, device) in back {
			front.push(device)
		}
		return front
	}

	// The speaker or microphone a `/sys/class/sound` entry names, or none when the
	// entry is not a PCM node (`card0`, `controlC0`, `hwC1D0`, `seq`).
	@os("linux")
	def soundEndpoint(name string) ?Device {
		return none unless name.startsWith("pcmC") && name.len() > 6
		let direction = name[name.len() - 1]
		return none unless direction := 'p' || 'c'
		let numbers = name[4:name.len() - 1].split("D")
		return none unless numbers.len() == 2
		let card = numbers[0]
		let pcm = numbers[1]
		let cardDir = "/sys/class/sound/card" + card
		let parent = usbParent(cardDir + "/device", 4)
		let label = procField("/proc/asound/card{card}/pcm{pcm}{direction}/info", "name")
		let cardName = sysRead(cardDir + "/id")
		return Device{
			id:        "sound:" + name,
			kind:      direction == 'p' ?? (DeviceKind.Speaker, DeviceKind.Microphone),
			name:      label == "" ?? (cardName, "{cardName}: {label}"),
			vendorId:  hexValue(sysRead(parent + "/idVendor")),
			productId: hexValue(sysRead(parent + "/idProduct")),
			vendor:    sysRead(parent + "/manufacturer"),
			product:   sysRead(parent + "/product"),
			serial:    sysRead(parent + "/serial"),
			node:      "/dev/snd/" + name,
			bus:       parent == "" ?? ("pci", "usb"),
		}
	}

	// The value of a `key: value` line in a `/proc` description, "" when there is
	// no such line.
	def procField(path string, key string) string {
		for let (_, line) in sysRead(path).split("\n") {
			let colon = line.indexOf(":")
			continue when colon < 0
			return line[colon + 1:].trim() when line[0:colon].trim() == key
		}
		return ""
	}

	// The GPUs, one per DRM render node, in node order. The name is the
	// model the NVIDIA driver reports, else the kernel driver's name
	// (`amdgpu`, `i915`); the ids are the PCI vendor and device.
	@os("linux")
	def gpuDevices() Device[] {
		let out Device[]
		for let (_, name) in sysList("/sys/class/drm") {
			continue unless name.startsWith("renderD")
			let dir = "/sys/class/drm/" + name + "/device"
			let vendorId = hexValue(sysRead(dir + "/vendor").trimPrefix("0x"))
			let driver = ueventField(dir + "/uevent", "DRIVER")
			let slot = ueventField(dir + "/uevent", "PCI_SLOT_NAME")
			let model = procField("/proc/driver/nvidia/gpus/" + slot + "/information", "Model")
			out.push(Device{
				id:        "gpu:" + name,
				kind:      DeviceKind.Gpu,
				name:      model != "" ?? (model, driver),
				vendorId:  vendorId,
				productId: hexValue(sysRead(dir + "/device").trimPrefix("0x")),
				vendor:    gpuVendor(vendorId),
				product:   model,
				serial:    "",
				node:      "/dev/dri/" + name,
				bus:       slot != "" ?? ("pci", "platform"),
			})
		}
		return out
	}

	// The GPUs this machine reports: none, this platform is not read yet.
	@os("darwin")
	def gpuDevices() Device[] {
		return []
	}

	// The GPUs this machine reports: none, this platform is not read yet.
	@os("windows")
	def gpuDevices() Device[] {
		return []
	}

	// The maker of a GPU by its PCI vendor id, empty for one not known here.
	def gpuVendor(vendorId int) string {
		return "NVIDIA" when vendorId == 0x10DE
		return "AMD" when vendorId == 0x1002
		return "Intel" when vendorId == 0x8086
		return ""
	}

	// The value of a `KEY=value` line in a sysfs `uevent` file, "" when there
	// is no such line.
	def ueventField(path string, key string) string {
		for let (_, line) in sysRead(path).split("\n") {
			return line[key.len() + 1:] when line.startsWith(key + "=")
		}
		return ""
	}

	// The whole disks that come and go: the removable ones and the ones hanging
	// off the USB bus. A partition carries a `partition` attribute and is part of
	// a disk, not a device of its own.
	@os("linux")
	def blockDevices() Device[] {
		let out Device[]
		for let (_, name) in sysList("/sys/class/block") {
			let dir = "/sys/class/block/" + name
			continue when sysRead(dir + "/partition") != ""
			let parent = usbParent(dir + "/device", 10)
			continue unless sysRead(dir + "/removable") == "1" || parent != ""
			out.push(Device{
				id:        "block:" + name,
				kind:      DeviceKind.Storage,
				name:      blockName(dir, name),
				vendorId:  hexValue(sysRead(parent + "/idVendor")),
				productId: hexValue(sysRead(parent + "/idProduct")),
				vendor:    sysRead(parent + "/manufacturer"),
				product:   sysRead(parent + "/product"),
				serial:    sysRead(parent + "/serial"),
				node:      "/dev/" + name,
				bus:       parent == "" ?? ("platform", "usb"),
			})
		}
		return out
	}

	// The name a USB device answers to: the descriptor's product name, else the
	// bus entry's own name.
	@os("linux")
	def usbName(dir string) string {
		let product = sysRead(dir + "/product")
		return product when product != ""
		return sysRead(dir + "/idProduct")
	}

	// The raw HID devices, one per hidraw node, with the usage page their
	// report descriptor opens with. The name and ids come from the HID
	// driver's uevent (`HID_NAME`, `HID_ID=bus:vendor:product`), which
	// Bluetooth and I2C devices carry as well as USB ones.
	@os("linux")
	def hidDevices() Device[] {
		let out Device[]
		for let (_, name) in sysList("/sys/class/hidraw") {
			let dir = "/sys/class/hidraw/" + name
			let uevent = dir + "/device/uevent"
			let ids = ueventField(uevent, "HID_ID").split(":")
			let parent = usbParent(dir + "/device", 6)
			let descriptor = __fs_read_all(dir + "/device/report_descriptor") onerror recover byte[]
			out.push(Device{
				id:        "hidraw:" + name,
				kind:      DeviceKind.Hid,
				name:      ueventField(uevent, "HID_NAME"),
				vendorId:  ids.len() == 3 ?? (hexValue(ids[1]), 0),
				productId: ids.len() == 3 ?? (hexValue(ids[2]), 0),
				vendor:    sysRead(parent + "/manufacturer"),
				product:   sysRead(parent + "/product"),
				serial:    ueventField(uevent, "HID_UNIQ"),
				node:      "/dev/" + name,
				bus:       parent == "" ?? (hidBus(ids.len() == 3 ?? (ids[0], "")), "usb"),
				usagePage: hidUsagePage(descriptor),
			})
		}
		return out
	}

	// The bus a HID_ID's bus number names (linux/input.h BUS_*).
	def hidBus(bus string) string {
		match hexValue(bus) {
			case 0x03:
				return "usb"
			case 0x05:
				return "bluetooth"
			case 0x18:
				return "i2c"
			case 0x06:
				return "virtual"
			default:
				return "other"
		}
	}

	// The usage page of the first top-level collection in a HID report
	// descriptor (HID 1.11 §6.2.2): the last Usage Page global item before
	// the first Collection main item. 0 when the descriptor has none.
	def hidUsagePage(descriptor byte[]) int {
		let page = 0
		let i = 0
		for i < descriptor.len() {
			let prefix = int(descriptor[i])
			if prefix == 0xFE {
				// A long item: data size, long tag, data.
				break when i + 1 >= descriptor.len()
				i += 3 + int(descriptor[i + 1])
				continue
			}
			let size = prefix & 0x03
			size = 4 when size == 3
			break when i + 1 + size > descriptor.len()
			let value = 0
			for let b = 0; b < size; b++ {
				value |= int(descriptor[i + 1 + b]) << (8 * b)
			}
			let typeTag = prefix & 0xFC
			page = value when typeTag == 0x04
			return page when typeTag == 0xA0
			i += 1 + size
		}
		return page
	}

	// The serial ports, one per tty node a driver backs: USB serial adapters
	// and modems (`ttyUSB`, `ttyACM`), boards' UARTs (`ttyAMA`, `ttyS`).
	// Virtual terminals and pseudo-terminals have no device behind them and
	// are left out, as are the `ttyS` slots the 8250 driver reserves with no
	// UART found (`type` 0). A port whose USB ids are a GPS maker's is a
	// `Gps`.
	@os("linux")
	def serialDevices() Device[] {
		let out Device[]
		for let (_, name) in sysList("/sys/class/tty") {
			let dir = "/sys/class/tty/" + name
			let uevent = sysRead(dir + "/device/uevent")
			continue when uevent == ""
			continue when name.startsWith("ttyS") && sysRead(dir + "/type") == "0"
			let parent = usbParent(dir + "/device", 4)
			let vendorId = hexValue(sysRead(parent + "/idVendor"))
			let productId = hexValue(sysRead(parent + "/idProduct"))
			let product = sysRead(parent + "/product")
			let driver = ueventField(dir + "/device/uevent", "DRIVER")
			out.push(Device{
				id:        "serial:" + name,
				kind:      isGpsReceiver(vendorId, productId) ?? (DeviceKind.Gps, DeviceKind.Serial),
				name:      product != "" ?? (product, driver != "" ?? (driver, name)),
				vendorId:  vendorId,
				productId: productId,
				vendor:    sysRead(parent + "/manufacturer"),
				product:   product,
				serial:    sysRead(parent + "/serial"),
				node:      "/dev/" + name,
				bus:       parent == "" ?? ("platform", "usb"),
			})
		}
		return out
	}

	// Whether USB ids are a GPS receiver's: every device of u-blox (0x1546),
	// Garmin (0x091E) and NovAtel (0x09D7), MediaTek's MT3329 (0E8D:3329),
	// Prolific's GPS bridge (067B:AAA0) and DeLorme's Earthmate (1163:0200).
	// Receivers on a general serial bridge (FTDI, CP210x, PL2303) cannot be
	// told from any other device on one, so they list as `Serial`.
	def isGpsReceiver(vendorId int, productId int) bool {
		return true when vendorId := 0x1546 || 0x091E || 0x09D7
		return vendorId == 0x0E8D && productId == 0x3329 || vendorId == 0x067B && productId == 0xAAA0 || vendorId == 0x1163 && productId == 0x0200
	}

	// The name a disk answers to: the model the driver reports, else the node name.
	@os("linux")
	def blockName(dir string, name string) string {
		let model = sysRead(dir + "/device/model")
		return model when model != ""
		return name
	}

	// The kind an input node is, from the event types, keys and axes its
	// capabilities (`dir`) list, the tests udev's `input_id` makes: a node
	// with absolute X and Y is a pen tablet or touch pad (pen or finger
	// tools), a mouse (mouse buttons) or a controller (controller axes or
	// buttons); one with relative X and Y and mouse buttons is a mouse; one
	// with game pad, joystick or D-pad buttons or controller axes is a
	// controller; one with keys 1 to 31 (Escape to S) is a keyboard; one that
	// reports anything else is another human-interface node. A device with
	// several nodes is classified node by node, so a mouse with media keys
	// shows up as a mouse and a `Hid` node.
	@os("linux")
	def inputKind(dir string) DeviceKind {
		return classifyInput(sysRead(dir + "/ev"), sysRead(dir + "/key"), sysRead(dir + "/rel"), sysRead(dir + "/abs"))
	}

	// The kind `inputKind` gives the capability bitmaps, as sysfs spells them.
	def classifyInput(evText string, keyText string, relText string, absText string) DeviceKind {
		let ev = capabilityBits(evText)
		return DeviceKind.Other when ev.len() == 0
		let key = capabilityBits(keyText)
		let rel = capabilityBits(relText)
		let abs = capabilityBits(absText)
		let mouseButton = key.hasKey(BTN_LEFT)
		let controller = anyBit(key, BTN_JOYSTICK, BTN_DIGI - 1) || anyBit(key, BTN_TRIGGER_HAPPY, BTN_TRIGGER_HAPPY_LAST) || anyBit(key, BTN_DPAD_UP, BTN_DPAD_RIGHT) || anyBit(abs, ABS_RX, ABS_BRAKE)
		if abs.hasKey(ABS_X) && abs.hasKey(ABS_Y) {
			return DeviceKind.Mouse when key.hasKey(BTN_STYLUS) || key.hasKey(BTN_TOOL_PEN) || key.hasKey(BTN_TOOL_FINGER) || mouseButton
			return DeviceKind.Gamepad when controller
		}
		return DeviceKind.Mouse when rel.hasKey(REL_X) && rel.hasKey(REL_Y) && mouseButton
		return DeviceKind.Gamepad when controller
		return DeviceKind.Keyboard when allBits(key, KEY_ESC, KEY_S)
		return DeviceKind.Hid
	}

	// The bits set in a sysfs capability bitmap: hexadecimal words of 64
	// bits separated by spaces, the highest first.
	def capabilityBits(text string) map<int, bool> {
		let out = map<int, bool>{}
		let words = text.trim().split(" ").filter((w) => w != "")
		for let w = 0; w < words.len(); w++ {
			let word = words[words.len() - 1 - w]
			for let d = 0; d < word.len(); d++ {
				let digit = hexDigit(word[word.len() - 1 - d])
				for let b = 0; b < 4; b++ {
					out[w * 64 + d * 4 + b] = true when (digit & (1 << b)) != 0
				}
			}
		}
		return out
	}

	// A hexadecimal digit's value, 0 for any other character.
	def hexDigit(c char) int {
		return int(c) - int('0') when c >= '0' && c <= '9'
		return int(c) - int('a') + 10 when c >= 'a' && c <= 'f'
		return int(c) - int('A') + 10 when c >= 'A' && c <= 'F'
		return 0
	}

	// Whether any of the bits from `low` to `high` is set.
	def anyBit(bits map<int, bool>, low int, high int) bool {
		for let i = low; i <= high; i++ {
			return true when bits.hasKey(i)
		}
		return false
	}

	// Whether every bit from `low` to `high` is set.
	def allBits(bits map<int, bool>, low int, high int) bool {
		for let i = low; i <= high; i++ {
			return false unless bits.hasKey(i)
		}
		return true
	}

	// The codes the classification reads (linux/input-event-codes.h).
	const KEY_ESC = 1
	const KEY_S = 31
	const BTN_LEFT = 0x110
	const BTN_JOYSTICK = 0x120
	const BTN_TOOL_PEN = 0x140
	const BTN_DIGI = 0x140
	const BTN_TOOL_FINGER = 0x145
	const BTN_STYLUS = 0x14b
	const BTN_DPAD_UP = 0x220
	const BTN_DPAD_RIGHT = 0x223
	const BTN_TRIGGER_HAPPY = 0x2c0
	const BTN_TRIGGER_HAPPY_LAST = 0x2e7
	const REL_X = 0x00
	const REL_Y = 0x01
	const ABS_X = 0x00
	const ABS_Y = 0x01
	const ABS_RX = 0x03
	const ABS_BRAKE = 0x0a

	// The USB device a sysfs node hangs off, as a path, walking up at most
	// `depth` parents; "" when no parent carries a USB descriptor. Every read
	// below it answers "" for a path that is not there, so the empty answer
	// reads as "the bus has no vendor or product".
	@os("linux")
	def usbParent(dir string, depth int) string {
		let path = dir
		for let i = 0; i < depth; i++ {
			path = path + "/.."
			return path when sysRead(path + "/idVendor") != ""
		}
		return ""
	}

	// The value of a sysfs attribute, without its trailing newline; "" when the
	// file is not there or cannot be read.
	//
	// The kernel reports these files as empty, so they are read through an open
	// handle rather than `Storage.readFile`, which trusts the reported size. The
	// read is the service's own, behind `adm.devices.list`, so it does not ask
	// the user about `adm.storage.read` as well.
	def sysRead(path string) string {
		return "" when path == ""
		let fd = __fs_open(path, "r") onerror recover -1
		return "" when fd < 0
		let buf byte[]
		buf.len(SYSFS_ATTRIBUTE_MAX)
		let n = __fs_read(fd, buf) onerror recover 0
		__fs_close(fd) onerror recover none
		return "" when n <= 0
		return string(buf[0:n]).trim()
	}

	// How much of a sysfs attribute is read. The kernel writes these in one page
	// and the values here are names and identifiers, far shorter.
	const SYSFS_ATTRIBUTE_MAX = 4096

	// The names in a sysfs directory, empty when it is not there or cannot be listed.
	// The directory's entries in name order, so listings are stable from one
	// scan to the next and `video0` comes before `video1`.
	def sysList(path string) string[] {
		let entries = __fs_read_dir(path) onerror recover []
		return entries.sort((i, j) => i < j)
	}

	// The number a sysfs identifier spells in hexadecimal (`046d`); 0 when it is
	// empty or not a number.
	def hexValue(text string) int {
		return 0 when text == ""
		return text.toInt<int>(16)
	}

	// The name of a device kind, for a listing or a log line.
	def deviceKindName(kind DeviceKind) string {
		match kind {
			case DeviceKind.Usb:
				return "usb"
			case DeviceKind.Camera:
				return "camera"
			case DeviceKind.Keyboard:
				return "keyboard"
			case DeviceKind.Mouse:
				return "mouse"
			case DeviceKind.Gamepad:
				return "gamepad"
			case DeviceKind.Audio:
				return "audio"
			case DeviceKind.Speaker:
				return "speaker"
			case DeviceKind.Microphone:
				return "microphone"
			case DeviceKind.Storage:
				return "storage"
			case DeviceKind.Hid:
				return "hid"
			case DeviceKind.Gpu:
				return "gpu"
			case DeviceKind.Serial:
				return "serial"
			case DeviceKind.Gps:
				return "gps"
			case DeviceKind.Other:
				return "other"
		}
		return "other"
	}
}
