// The Devices service's IDE panel: the devices connected and those the program
// opened, and the buttons that start and stop watching for changes.

partial module std.services.devices {
	use (
		std.ide::(ide, IdeKind, IdeTable)
		std.services.devices.sysfs::*
	)

	partial service Devices {
		@ide(kind = IdeKind.Table, label = "Connected", refresh = 2s, rows = 6)
		def ideDevices() IdeTable {
			let rows = string[][]
			for let (_, device) in scanDevices() {
				rows.push([device.id, device.kind.name, device.name, device.vendor, device.product])
			}
			return IdeTable{columns: ["Id", "Kind", "Name", "Vendor", "Product"], rows: rows}
		}

		@ide(kind = IdeKind.Table, label = "Opened", refresh = 1s, rows = 4)
		atomic def ideOpened() IdeTable {
			let rows = string[][]
			for let (fd, device) in held {
				rows.push(["{fd}", device.id, device.name])
			}
			return IdeTable{columns: ["Descriptor", "Device", "Name"], rows: rows}
		}

		@ide(kind = IdeKind.Value, label = "Watching", refresh = 1s)
		def ideWatching() bool {
			return watching()
		}

		@ide(kind = IdeKind.Action, label = "Watch")
		def ideWatch(period duration = 1s) !none {
			return watch(period)
		}

		@ide(kind = IdeKind.Action, label = "Stop watching")
		def ideUnwatch() !none {
			return unwatch()
		}
	}
}
