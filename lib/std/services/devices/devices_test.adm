partial module std.services.devices {
	use (
		std.testing
		std.time
		std.services.devices.sysfs::*
		std.services.policy::(Policy, PolicyDenied)
	)

	// Counts what the observers below saw, so the tests can assert on it.
	internal type DeviceLog {
		internal appeared    Device[]
		internal disappeared Device[]

		atomic def connected(device Device) {
			appeared.push(device)
		}

		atomic def disconnected(device Device) {
			disappeared.push(device)
		}

		atomic def connectedCount() int {
			return appeared.len()
		}

		atomic def disconnectedCount() int {
			return disappeared.len()
		}
	}

	internal let deviceLog = new DeviceLog()

	// A kernel uevent as it comes off the socket: each field ended by a zero
	// byte, which no string holds.
	internal def uevent(fields string[]) byte[] {
		let out byte[]
		for let (_, field) in fields {
			out.push(...field.bytes())
			out.push(byte(0))
		}
		return out
	}

	// An instance observing the service, so the tests cover `@on` on a type as
	// well as on a free function.
	internal type DeviceObserver {
		internal seen int = 0

		@on(Devices.connected)
		def onConnected(evt Event<Device>) {
			seen += 1
		}

		@on(Devices.disconnected)
		def onDisconnected(evt Event<Device>) {
			seen += 1
		}

		atomic def count() int {
			return seen
		}
	}

	// Opens the device behind the id and closes it again, so a test can assert
	// that opening fails without leaking a descriptor when it does not.
	//
	// Fails for the same reasons `Devices.open` does.
	internal def openChecked(id string) !none {
		let fd = try Devices.open(id)
		return Devices.close(fd)
	}

	check "Devices" {
		@on(Devices.connected)
		def onConnected(evt Event<Device>) {
			deviceLog.connected(evt.result)
		}

		@on(Devices.disconnected)
		def onDisconnected(evt Event<Device>) {
			deviceLog.disconnected(evt.result)
		}

		@test()
		def TestKindNames() {
			assert deviceKindName(DeviceKind.Usb) == "usb"
			assert deviceKindName(DeviceKind.Camera) == "camera"
			assert deviceKindName(DeviceKind.Keyboard) == "keyboard"
			assert deviceKindName(DeviceKind.Mouse) == "mouse"
			assert deviceKindName(DeviceKind.Audio) == "audio"
			assert deviceKindName(DeviceKind.Speaker) == "speaker"
			assert deviceKindName(DeviceKind.Microphone) == "microphone"
			assert deviceKindName(DeviceKind.Storage) == "storage"
			assert deviceKindName(DeviceKind.Hid) == "hid"
			assert deviceKindName(DeviceKind.Gpu) == "gpu"
			assert deviceKindName(DeviceKind.Serial) == "serial"
			assert deviceKindName(DeviceKind.Gps) == "gps"
			assert deviceKindName(DeviceKind.Other) == "other"
		}

		// A serial port is a GPS receiver by its USB ids: a GPS maker's, or
		// one of the few bridges made for receivers alone.
		@test()
		def TestGpsReceiverIds() {
			assert isGpsReceiver(0x1546, 0x01A8) && isGpsReceiver(0x091E, 0x0003) && isGpsReceiver(0x09D7, 0x0100)
			assert isGpsReceiver(0x0E8D, 0x3329) && isGpsReceiver(0x067B, 0xAAA0) && isGpsReceiver(0x1163, 0x0200)
			// A general bridge (Prolific, FTDI, CP210x) and a MediaTek device that is no receiver.
			assert !isGpsReceiver(0x067B, 0x2303) && !isGpsReceiver(0x0403, 0x6001) && !isGpsReceiver(0x10C4, 0xEA60)
			assert !isGpsReceiver(0x0E8D, 0x2000) && !isGpsReceiver(0, 0)
		}

		// Every serial port listed is a tty node a driver backs, and none is
		// a slot the 8250 driver reserved without a UART behind it.
		@os("linux")
		@test()
		def TestSerialPortsAreReal() !none {
			for let (_, d) in try Devices.list() {
				continue unless d.kind := DeviceKind.Serial || DeviceKind.Gps
				assert d.id.startsWith("serial:") && d.node == "/dev/" + d.id[7:]
				let name = d.id[7:]
				assert !(name.startsWith("ttyS") && sysRead("/sys/class/tty/" + name + "/type") == "0")
			}
			return none
		}

		@test()
		def TestGpuVendors() {
			assert gpuVendor(0x10DE) == "NVIDIA"
			assert gpuVendor(0x1002) == "AMD"
			assert gpuVendor(0x8086) == "Intel"
			assert gpuVendor(0x1234) == ""
		}

		@test()
		def TestGpusAreRenderNodes() !none {
			// Whatever this machine has: each GPU is a render node that
			// `list` reports too, and listing them needs no permission.
			let all = try Devices.list(DeviceKind.Gpu)
			let gpus = Devices.gpus()
			assert gpus.len() == all.len()
			for let gpu in gpus {
				assert gpu.kind == DeviceKind.Gpu
				assert gpu.id.startsWith("gpu:renderD")
				assert gpu.node.startsWith("/dev/dri/renderD")
			}
			return none
		}

		@test()
		def TestHidUsagePages() !none {
			// A FIDO security key (Feitian): Usage Page (0xF1D0), Usage (1), Collection.
			let fido = byte[0x06, 0xD0, 0xF1, 0x09, 0x01, 0xA1, 0x01, 0x09, 0x20, 0x15, 0x00, 0x26, 0xFF, 0x00, 0x75, 0x08, 0x95, 0x40, 0x81, 0x02, 0xC0]
			assert hidUsagePage(fido) == 0xF1D0
			// A keyboard: Usage Page (Generic Desktop), Usage (Keyboard), Collection.
			assert hidUsagePage(byte[0x05, 0x01, 0x09, 0x06, 0xA1, 0x01, 0xC0]) == 0x01
			// A long item before the page is skipped.
			assert hidUsagePage(byte[0xFE, 0x02, 0x10, 0xAA, 0xBB, 0x05, 0x0C, 0xA1, 0x01]) == 0x0C
			assert hidUsagePage(byte[]) == 0
			assert hidUsagePage(byte[0x06, 0xD0]) == 0

			// Whatever this machine has: each hidraw node is a Hid device.
			for let device in try Devices.list(DeviceKind.Hid) {
				continue when !device.id.startsWith("hidraw:")
				assert device.node == "/dev/" + device.id[7:]
			}
			return none
		}

		@test()
		def TestHexValues() {
			assert hexValue("046d") == 1133
			assert hexValue("00CC") == 204
			assert hexValue("0000") == 0
			assert hexValue("") == 0
		}

		// A path that is not there reads as empty rather than failing, so a
		// device missing an attribute still lists.
		@test()
		def TestMissingAttributesReadEmpty() {
			assert sysRead("/sys/no/such/attribute") == ""
			assert sysRead("") == ""
			assert sysList("/sys/no/such/directory").len() == 0
		}

		// Lists the devices and looks one up again. A machine with no devices
		// only checks that the listing is empty and that nothing is found.
		@test()
		def TestListAndGetRoundTrip() !none {
			let all = try Devices.list()
			for let (_, device) in all {
				assert device.id.len() > 0
				assert device.id.contains(":")
			} empty {
				assert try Devices.get("usb:1-2") is none
				return none
			}
			let first = all[0]
			let found = try Devices.get(first.id)
			fail "get did not find the id list reported: {first.id}" when found is none
			let same Device = found
			assert same.id == first.id
			assert same.kind == first.kind
			assert try Devices.get("no-such-bus:no-such-device") is none
			return none
		}

		// Filtering by kind never reports another kind, and the cameras carry a
		// node to open.
		@test()
		def TestListByKind() !none {
			let cameras = try Devices.list(DeviceKind.Camera)
			for let (_, device) in cameras {
				assert device.kind == DeviceKind.Camera
				assert device.id.startsWith("video:")
				assert device.node.startsWith("/dev/video")
			}
			let counted = 0
			for let (_, device) in try Devices.list() {
				counted += 1 when device.kind == DeviceKind.Camera
			}
			assert counted == cameras.len()
			return none
		}

		// Opening a device that is not there fails, and so does opening one that
		// is not a camera.
		@test()
		def TestOpenRejectsWhatIsNotACamera() !none {
			let missing = false
			openChecked("video:no-such-camera") onerror (err error) {
				missing = true
				recover none
			}
			assert missing
			for let (_, device) in try Devices.list() {
				continue when device.kind == DeviceKind.Camera
				let refused = false
				openChecked(device.id) onerror (err error) {
					refused = true
					recover none
				}
				assert refused
				return none
			}
			return none
		}

		@test()
		def TestWatchToggles() !none {
			assert !Devices.watching()
			let tooShort = false
			Devices.watch(0s) onerror (err error) {
				tooShort = true
				recover none
			}
			assert tooShort
			assert !Devices.watching()

			try Devices.watch(50ms)
			assert Devices.watching()
			let twice = false
			Devices.watch(50ms) onerror (err error) {
				twice = true
				recover none
			}
			assert twice

			// Nothing connects or disconnects while the suite runs, so the
			// watcher reports nothing.
			time.sleep(200ms)
			assert deviceLog.connectedCount() == 0
			assert deviceLog.disconnectedCount() == 0

			try Devices.unwatch()
			assert !Devices.watching()
			let stopped = false
			Devices.unwatch() onerror (err error) {
				stopped = true
				recover none
			}
			assert stopped
			return none
		}

		// The diff behind the watcher: what the listing gained and what it lost
		// since the listing before, with the rest passed over.
		@test()
		def TestWatcherDiffsById() {
			let keyboard = Device{id: "input:event0", kind: DeviceKind.Keyboard, name: "a keyboard"}
			let mouse = Device{id: "input:event1", kind: DeviceKind.Mouse, name: "a mouse"}
			let camera = Device{id: "video:video0", kind: DeviceKind.Camera, name: "a camera"}
			let watcher = new DeviceWatcher(1s, map<string, Device>{"input:event0": keyboard, "input:event1": mouse}, -1)

			let (appeared, disappeared) = watcher.observe(map<string, Device>{"input:event0": keyboard, "video:video0": camera})
			assert appeared.len() == 1
			assert appeared[0].id == "video:video0"
			assert disappeared.len() == 1
			assert disappeared[0].id == "input:event1"

			// The same listing again is no change at all.
			let (again, gone) = watcher.observe(map<string, Device>{"input:event0": keyboard, "video:video0": camera})
			assert again.len() == 0
			assert gone.len() == 0
			watcher.stop()
		}

		// Only the uevents of a bus or class the listing reads start a new
		// listing.
		@test()
		def TestDeviceEventsOfListedSubsystems() {
			assert listedSubsystem(uevent(["add@/devices/pci0000:00/usb3/3-2", "ACTION=add", "DEVPATH=/devices/pci0000:00/usb3/3-2", "SUBSYSTEM=usb", "SEQNUM=4711"]))
			// The last field needs no zero after it.
			let sound = uevent(["change@/devices/virtual/sound/card0", "ACTION=change", "SUBSYSTEM=sound"])
			assert listedSubsystem(sound.slice(0, sound.len() - 1))
			assert !listedSubsystem(uevent(["add@/devices/virtual/net/veth0", "ACTION=add", "SUBSYSTEM=net"]))
			assert listedSubsystem(uevent(["add@/devices/pci0000:00/usb1/1-3/1-3:1.0/tty/ttyACM0", "ACTION=add", "SUBSYSTEM=tty"]))
			assert !listedSubsystem(uevent(["SUBSYSTEMS=usb"]))
			assert !listedSubsystem(byte[])
		}

		// On Linux the watcher waits on the kernel's device events, and
		// stopping it wakes that wait at once rather than at the next look.
		@os("linux")
		@test()
		def TestStoppingWakesTheEventWait() !none {
			let events = deviceEvents()
			// A container or sandbox without netlink polls instead.
			return none when events < 0
			let watcher = new DeviceWatcher(1s, map<string, Device>{}, events)
			let waiting = async watcher.awaitEvent(DEVICE_SETTLE)
			time.sleep(50ms)
			let started = time.monoNs()
			watcher.stop()
			assert !(await waiting)
			assert time.monoNs() - started < 500000000
			__net_close(events) onerror recover none
			return none
		}

		// A type observing the service registers its instances; nothing connects
		// during the suite, so it only has to compile and stay at zero.
		@test()
		def TestObserverType() {
			let observer = new DeviceObserver()
			assert observer.count() == 0
		}
	}

	// What only the Linux listing does: read the kernel's own description of the
	// machine's devices under `/sys`.
	@os("linux")
	check "Device descriptors and policy" {
		// A descriptor `open` returned names its device until it is closed.
		@test()
		def TestOpenedNamesTheDevice() !none {
			let nodes = (try Devices.list()).filter((d) => d.node != "" && (d.kind := DeviceKind.Camera || DeviceKind.Gpu))
			return none when nodes.len() == 0
			let fd = Devices.open(nodes[0].id) onerror recover -1
			return none when fd < 0
			let device = Devices.opened(fd)
			fail "the descriptor names no device" when device is none
			let held Device = device
			assert held.id == nodes[0].id
			try Devices.close(fd)
			assert Devices.opened(fd) is none
			assert Devices.opened(-5) is none
			return none
		}

		// The `device` rules of the camera and microphone permissions decide
		// on the id: deny before allow, ask (with no one to answer) denies.
		@test()
		def TestDeviceRulesDecideOnTheId() !none {
			try Policy.configure("[adm.devices.camera]\ndevice.deny = [\"video:video9\"]\ndevice.allow = [\"video:*\"]\n\n[adm.devices.microphone]\ndevice.ask = [\"sound:*\"]\n")
			let spec = "std.services.devices.DeviceSpec"
			try Policy.validate("adm.devices.camera", spec, "video:video0")
			let denied = false
			Policy.validate("adm.devices.camera", spec, "video:video9") onerror (err error) {
				denied = err is PolicyDenied
				recover none
			}
			let asked = false
			Policy.validate("adm.devices.microphone", spec, "sound:pcmC1D0c") onerror (err error) {
				asked = true
				recover none
			}
			try Policy.validate("adm.devices.microphone", spec, "pulse:usb-mic")
			try Policy.configure("")
			assert denied && asked
			try DeviceSpec{device: Rule<string>{deny: ["video:*"]}}.validate("sound:card0")
			let refused = false
			DeviceSpec{device: Rule<string>{deny: ["video:*"]}}.validate("video:video0") onerror (err error) {
				refused = true
				recover none
			}
			assert refused
			return none
		}
	}

	// Sysfs and /proc are Linux's.
	@os("linux")
	check "Devices sysfs" {
		// The bitmaps here are real devices' (sysfs `capabilities/ev`, `key`,
		// `rel`, `abs`): a mouse, a keyboard and its media-key node, a power
		// button, an audio jack, an Xbox game pad and a laptop touch pad.
		@test()
		def TestInputKindReadsTheCapabilityBits() {
			assert classifyInput("17", "1f0000 0 0 0 0", "1943", "0") == DeviceKind.Mouse
			assert classifyInput("120013", "1000000000007 ff9f207ac14057ff febeffdfffefffff fffffffffffffffe", "0", "0") == DeviceKind.Keyboard
			assert classifyInput("10001f", "733eff 0 0 483ffff17aff32d bfd4444600000000 1 130c730b17c007 ffbf7bfad941dfff febeffdfffefffff fffffffffffffffe", "1040", "100000000") == DeviceKind.Keyboard
			assert classifyInput("1f", "733eff 0 0 483ffff17aff32d bfd4444600000000 1 130ff38b17c000 677bfad9415fed 9ed68000004400 10000002", "1040", "100000000") == DeviceKind.Hid
			assert classifyInput("3", "8000 10000000000000 0", "0", "0") == DeviceKind.Hid
			assert classifyInput("21", "0", "0", "0") == DeviceKind.Hid
			assert classifyInput("20000b", "7cdb000000000000 0 0 0 0", "0", "3003f") == DeviceKind.Gamepad
			assert classifyInput("b", "e520 10000 0 0 0 0", "0", "660800001000003") == DeviceKind.Mouse
			assert classifyInput("0", "", "", "") == DeviceKind.Other
			assert classifyInput("", "", "", "") == DeviceKind.Other
			let bits = capabilityBits("1f0000 0 0 0 0")
			assert bits.len() == 5 && bits.hasKey(0x110) && bits.hasKey(0x114) && !bits.hasKey(0x115)
		}

		// A sysfs attribute reports a size of zero, so it is read through an
		// open handle rather than in one call.
		@test()
		def TestSysfsReads() {
			assert sysRead("/proc/sys/kernel/ostype") == "Linux"
			assert sysList("/sys/class").len() > 0
		}

		// Only PCM nodes are sound endpoints; cards, controls and the sequencer
		// are not, and a PCM node that is not there names no device.
		@test()
		def TestSoundEndpointNames() {
			assert soundEndpoint("card0") is none
			assert soundEndpoint("controlC0") is none
			assert soundEndpoint("hwC1D0") is none
			assert soundEndpoint("seq") is none
			assert soundEndpoint("pcmC0D0x") is none
			assert soundEndpoint("pcmC0") is none
		}

		// A `key: value` line of a /proc description is found by its key.
		@test()
		def TestProcFieldOfAMissingFile() {
			assert procField("/proc/no/such/file", "name") == ""
		}

		// Outputs of a card come before its HDMI ones, and every endpoint is
		// openable by its node.
		@test()
		def TestSoundEndpointsListAnalogFirst() {
			let seenDigital = false
			for let (_, device) in soundEndpoints() {
				assert device.node.startsWith("/dev/snd/pcmC")
				let digital = device.name.contains("HDMI") || device.name.contains("DP")
				if digital {
					seenDigital = true
				} else {
					assert !seenDigital
				}
			}
		}

		// A node with no USB device above it has no parent, and every read
		// below the empty answer is empty too.
		@test()
		def TestUsbParentOfARootlessNode() {
			assert usbParent("/sys/no/such/node", 4) == ""
			assert sysRead("/idVendor") == ""
		}

		// Every listed device names the bus entry it came from and the kind that
		// bus reports.
		@test()
		def TestIdsNameTheirBus() !none {
			for let (_, device) in try Devices.list() {
				if device.id.startsWith("usb:") {
					assert device.kind == DeviceKind.Usb
					assert device.bus == "usb"
					assert device.vendorId > 0
				} else if device.id.startsWith("video:") {
					assert device.kind == DeviceKind.Camera
				} else if device.id.startsWith("sound:pcm") {
					assert device.kind == (device.id.endsWith("p") ?? (DeviceKind.Speaker, DeviceKind.Microphone))
					assert device.node == "/dev/snd/" + device.id[6:]
				} else if device.id.startsWith("sound:") {
					assert device.kind == DeviceKind.Audio
					assert device.node == "/dev/snd/controlC" + device.id[10:]
				} else if device.id.startsWith("block:") {
					assert device.kind == DeviceKind.Storage
					assert device.node.startsWith("/dev/")
				} else if device.id.startsWith("gpu:") {
					assert device.kind == DeviceKind.Gpu
					assert device.node.startsWith("/dev/dri/renderD")
				} else if device.id.startsWith("hidraw:") {
					assert device.kind == DeviceKind.Hid
					assert device.node.startsWith("/dev/hidraw")
				} else {
					assert device.id.startsWith("input:")
					assert device.node.startsWith("/dev/input/event")
				}
			}
			return none
		}
	}
}
