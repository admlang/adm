@os("wasm")
internal partial module std.services.devices.sysfs {
	use (
		std.services.devices::(Device, DeviceKind)
		std.data.encoding::(JSON)
	)

	// The cameras, microphones and speakers the browser reports: their names
	// only once the user granted the page a device of that kind, as browsers
	// do. Empty when the browser lists none.
	def scanDevices() Device[] {
		let raw = WebDevices{}
		let status = __webBrowser("devices", "\{}")
		return [] unless status == 0
		new JSON().decode(__webAnswer(), raw) onerror recover none
		let out Device[]
		for let d in raw.value {
			let kind = DeviceKind.Other
			match d.kind {
				case "Camera":
					kind = DeviceKind.Camera
				case "Microphone":
					kind = DeviceKind.Microphone
				case "Speaker":
					kind = DeviceKind.Speaker
			}
			out.push(Device{id: d.id, kind: kind, name: d.name, vendorId: 0, productId: 0, vendor: "", product: d.name, serial: "", node: "", bus: "web", isDefault: d.isDefault})
		}
		return out
	}

	// The GPU the page draws with, as WebGL names it; empty when the browser
	// does not say.
	def gpuDevices() Device[] {
		let raw = WebGpu{}
		let status = __webBrowser("gpu", "\{}")
		return [] unless status == 0
		new JSON().decode(__webAnswer(), raw) onerror recover none
		return [] when raw.name == ""
		return [Device{id: "gpu:webgl", kind: DeviceKind.Gpu, name: raw.name, vendorId: 0, productId: 0, vendor: raw.vendor, product: raw.name, serial: "", node: "", bus: "web"}]
	}

	// What the page's loader lists, as JSON.
	struct WebDevice {
		id        string
		kind      string
		name      string
		isDefault bool
	}

	struct WebDevices {
		value WebDevice[] = []
	}

	struct WebGpu {
		name   string = ""
		vendor string = ""
	}

	@c("adm_web.h", symbol = "adm_web_browser", ret = "int32_t", params = ["const char*", "const char*"])
	def __webBrowser(op string, args string) int32;

	@c("adm_web.h", symbol = "adm_web_answer", ret = "const char*", params = [])
	def __webAnswer() string;
}
