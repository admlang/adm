partial module std.services.diagnostics {
	use (
		std.services::(Dependencies, Lifecycle, RestartMode, StartMode)
		std.services.runtime::(Runtime)
		std.metrics::(Gauge, Counter, Histogram, Toggle)
		std.reflection::(FieldMetaContext, MethodMetaContext)
		std.time
	)

	// Any metric the Diagnostics service registers: a gauge, counter, histogram or toggle.
	type Metric = Gauge | Counter | Histogram | Toggle

	// One registered metric as `Diagnostics.series` reports it.
	struct MetricSeries {
		// The name it was registered under.
		name        string
		// What tells it apart from the other series of that name; empty for a metric
		// registered without labels.
		labels      map<string, string>
		// What the value counts, "" when the name was never given a unit.
		unit        string
		// What the metric means, "" when the name was never given a description.
		description string
		metric      Metric
	}

	// Keeps the application's metrics: gauges, counters, histograms and toggles registered
	// by name, and serves them to the IDE and to Telemetry.
	service Diagnostics {
		// registry of metrics
		atomic metrics                = map<string, Metric>{}
		// Every metric with its name and labels, in the order registered.
		registered     MetricSeries[]
		// The unit and description of each metric name that was given one.
		units                         = map<string, string>{}
		descriptions                  = map<string, string>{}

		description               = "Diagnostics service for tracking application metrics"
		dependencies              = Dependencies{
			hard: [Runtime]
		}
		lifecycle                 = Lifecycle{
			start: StartMode.Automatic,
			restart: RestartMode.Always,
		}
		permissions  Permission[]

		// Starts the service. Does not fail today.
		async def start() !none {
			return none
		}

		// Stops the service. Does not fail today.
		async def stop() !none {
			return none
		}

		// Stops the service and starts it again. Does not fail today.
		async def restart() !none {
			return none
		}

		// Registers a metric under the specified name.
		//
		// labels tell the series of one metric apart: `http.requests` once per route,
		// `register<Counter>("http.requests", {"route": "/orders"})`. unit says what the
		// value counts, in UCUM form (`ms`, `By`, `1`), and description what it means;
		// both belong to the name, and the first one given for a name stays.
		//
		// If a metric with the same name, labels and type already exists, it is returned.
		// Fails if the name and labels are already registered with a different metric type.
		@commit()
		def register<T: Metric>(name string, labels map<string, string> = {}, unit string = "", description string = "") !T {
			let key = seriesKey(name, labels)
			let existing = metrics.get(key)
			if !(existing is none) {
				match existing {
					case T:
						describe(name, unit, description)
						return existing
					default:
						fail "metric {key} is already registered with a different metric type"
				}
			}
			let created = new T()
			metrics[key] = created
			registered.push(MetricSeries{name: name, labels: labels.clone(), metric: created})
			describe(name, unit, description)
			return created
		}

		// Keeps the first unit and description given for a metric name.
		def describe(name string, unit string, description string) {
			units[name] = unit unless unit.isEmpty() || units.hasKey(name)
			descriptions[name] = description unless description.isEmpty() || descriptions.hasKey(name)
		}

		// Returns the metric registered under the specified name and labels.
		//
		// Returns none if no such metric exists.
		@query()
		def get(name string, labels map<string, string> = {}) ?Metric {
			return metrics.get(seriesKey(name, labels))
		}

		// Returns whether a metric with the specified name and labels is registered.
		@query()
		def has(name string, labels map<string, string> = {}) bool {
			return metrics.hasKey(seriesKey(name, labels))
		}

		// Returns all registered metrics by name; one with labels is under
		// `name{key="value",...}`, the labels sorted by key.
		@query()
		def list() map<string, Metric> {
			return metrics
		}

		// Returns the names `list` holds the metrics under.
		@query()
		def names() string[] {
			return metrics.keys()
		}

		// Returns every registered metric with its name, labels, unit and description, in
		// the order they were registered.
		@query()
		def series() MetricSeries[] {
			let out = MetricSeries[]
			for let (_, held) in registered {
				out.push(MetricSeries{
					name:        held.name,
					labels:      held.labels,
					unit:        units.hasKey(held.name) ?? (units[held.name], ""),
					description: descriptions.hasKey(held.name) ?? (descriptions[held.name], ""),
					metric:      held.metric,
				})
			}
			return out
		}
	}

	// What `list` holds a metric under: the name alone without labels, else
	// `name{key="value",...}` with the labels sorted by key.
	internal def seriesKey(name string, labels map<string, string>) string {
		return name when labels.len() == 0
		let parts = string[]
		for let (_, key) in labels.keys().sort((a, b) => a < b) {
			let value = labels.get(key)
			parts.push(key + "=" + quoted(value)) unless value is none
		}
		return name + braceOpen + parts.join(",") + braceClose
	}

	// A label's value between double quotes, a quote or backslash in it escaped.
	internal def quoted(value string) string {
		return "\"" + value.replace("\\", "\\\\").replace("\"", "\\\"") + "\""
	}

	// A brace in a string literal opens an interpolation.
	internal const braceOpen = "\u007B"
	internal const braceClose = "\u007D"

	// Registers a metric using the annotated field's metric type and assigns the
	// resulting metric handle to the field.
	//
	// If a metric with the same name and type already exists, the existing metric
	// is used. Registration fails if the name is already registered with a
	// different metric type.
	//
	// unit and description are what `Diagnostics.register` takes.
	meta def metric<T: Metric>(ctx FieldMetaContext, name string, unit string = "", description string = "") {
		let registered = Diagnostics.register<T>(name, unit = unit, description = description)
		if registered is error {
			let tmp T = new T()
			ctx.editor.set(tmp)
			return
		}
		ctx.editor.set(registered)
	}

	// Tracks how many times the annotated method is invoked.
	//
	// Registers a Counter under the specified metric name and increments it once
	// for every method invocation.
	meta def measureCount(ctx MethodMetaContext, name string) {
		let counter = Diagnostics.register<Counter>(name)
		counter.inc() unless (counter is error)
		ctx.invoke()
	}

	// Tracks the execution duration of the annotated method.
	//
	// Registers a Histogram under the specified metric name and records the
	// duration of every completed method invocation, in nanoseconds.
	meta def measureTime(ctx MethodMetaContext, name string) {
		let histogram = Diagnostics.register<Histogram>(name, unit = "ns")
		let start = time.monoNs()
		ctx.invoke()
		return when histogram is error
		histogram.update(float64(time.monoNs() - start))
	}

	// Tracks failed executions of the annotated method.
	//
	// Registers a Counter under the specified metric name and increments it when
	// the method returns an error. The original error is propagated unchanged.
	meta def measureErrors(ctx MethodMetaContext, name string) {
		let counter = Diagnostics.register<Counter>(name)
		ctx.invoke()
		return when counter is error
		counter.inc() when ctx.failed()
	}

	// Tracks the number of concurrently executing invocations of the annotated method.
	//
	// Registers a Gauge under the specified metric name. The gauge is incremented
	// when the method begins execution and decremented when the method completes,
	// including when the method returns an error.
	meta def measureConcurrency(ctx MethodMetaContext, name string) {
		let gauge = Diagnostics.register<Gauge>(name)
		if gauge is error {
			ctx.invoke()
			return
		}
		gauge.inc()
		ctx.invoke()
		gauge.dec()
	}
}
