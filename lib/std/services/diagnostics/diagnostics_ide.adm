// The Diagnostics service's IDE panel: every metric the program registered,
// with its current value.

partial module std.services.diagnostics {
	use std.ide::(ide, IdeKind, IdeTable, metricsTable)

	partial service Diagnostics {
		@ide(kind = IdeKind.Table, label = "Metrics", refresh = 1s, rows = 0, group = ".")
		def ideMetrics() IdeTable {
			return metricsTable()
		}
	}
}
