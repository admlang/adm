partial module std.services.diagnostics {
	use (
		std.testing
		std.metrics::(*)
	)

	internal type DiagCounted {
		@measureCount("diag.calls")
		def work() int {
			return 1
		}

		@measureErrors("diag.failures")
		def mayFail(shouldFail bool) !int {
			if shouldFail {
				fail "requested"
			}
			return 7
		}

		@measureTime("diag.duration")
		def timed() int {
			return 2
		}

		@measureConcurrency("diag.inflight")
		def inflight() int {
			return 3
		}
	}

	internal type DiagAnnotatedFields {
		@metric("diag.field.hits")
		hits Counter

		@metric("diag.field.level")
		level Gauge
	}

	check "Diagnostics service" {
		@test()
		def registersAndReturnsTheSameHandle() !none {
			let first = try Diagnostics.register<Counter>("diag.reg")
			first.inc()
			first.inc()

			let again = try Diagnostics.register<Counter>("diag.reg")
			assert again.value() == 2

			assert Diagnostics.has("diag.reg")
			assert Diagnostics.names().includes("diag.reg")
			return none
		}

		@test()
		def rejectsAConflictingType() !none {
			let counter = try Diagnostics.register<Counter>("diag.conflict")
			counter.inc()

			let mismatched = Diagnostics.register<Gauge>("diag.conflict")
			assert mismatched is error
			return none
		}

		@test()
		def reportsRegisteredMetrics() !none {
			let toggle = try Diagnostics.register<Toggle>("diag.toggle")
			toggle.update(true)

			let stored = Diagnostics.get("diag.toggle")
			match stored {
				case Toggle:
					assert stored.value()
				default:
					assert false
			}

			assert Diagnostics.list().hasKey("diag.toggle")

			assert Diagnostics.get("diag.absent") is none
			assert !Diagnostics.has("diag.absent")
			return none
		}

		@test()
		def countsInvocations() !none {
			let target = new DiagCounted()
			assert target.work() == 1
			assert target.work() == 1

			let counter = try Diagnostics.register<Counter>("diag.calls")
			assert counter.value() == 2
			return none
		}

		@test()
		def countsOnlyFailedInvocations() !none {
			let target = new DiagCounted()
			assert try target.mayFail(false) == 7
			assert target.mayFail(true) is error

			let counter = try Diagnostics.register<Counter>("diag.failures")
			assert counter.value() == 1
			return none
		}

		@test()
		def recordsDurations() !none {
			let target = new DiagCounted()
			assert target.timed() == 2

			let histogram = try Diagnostics.register<Histogram>("diag.duration")
			assert histogram.value().count == 1
			return none
		}

		@test()
		def balancesTheConcurrencyGauge() !none {
			let target = new DiagCounted()
			assert target.inflight() == 3

			let gauge = try Diagnostics.register<Gauge>("diag.inflight")
			assert gauge.value() == float64(0.0)
			return none
		}

		@test()
		def initializesAnnotatedFields() !none {
			let holder = new DiagAnnotatedFields()
			holder.hits.inc()
			holder.level.set(float64(4.0))

			let hits = try Diagnostics.register<Counter>("diag.field.hits")
			assert hits.value() == 1

			let level = try Diagnostics.register<Gauge>("diag.field.level")
			assert level.value() == float64(4.0)
			return none
		}

		@test()
		def histogramCountsByRange() !none {
			let sizes = new Histogram()
			try testing.expectEqual(0, sizes.distribution().counts.len(), "an empty histogram has no ranges")
			for let (_, value) in [1.0, 1.0, 3.0, 1000.0, 0.0] {
				sizes.update(value)
			}
			let spread = sizes.distribution()
			try testing.expectEqual(uint64(5), spread.count, "every value counted")
			try testing.expectEqual(1005.0, spread.sum, "and summed")
			try testing.expectEqual(spread.bounds.len() + 1, spread.counts.len(), "one range more than bounds")
			let counted = uint64(0)
			for let (_, held) in spread.counts {
				counted += held
			}
			try testing.expectEqual(uint64(5), counted, "the ranges hold every value")
			try testing.expectEqual(uint64(1), spread.counts[0], "zero falls in the first range")
			try testing.expectEqual(uint64(1), spread.counts[spread.counts.len() - 1], "the largest in the last")
			// 1.0 is the upper bound of its range, 3.0 lies within (2^1.5, 2^1.75].
			let ones = -1
			let three = -1
			for let (at, bound) in spread.bounds {
				ones = at when bound == 1.0
				three = at when three < 0 && bound >= 3.0
			}
			try testing.expectTrue(ones >= 0, "a range ends at 1")
			try testing.expectEqual(uint64(2), spread.counts[ones], "holding both ones")
			try testing.expectEqual(uint64(1), spread.counts[three], "3 in the range that ends above it")
			try testing.expectTrue(spread.bounds[three] / 3.0 < 1.19, "which ends less than 19% above")
			return none
		}

		@test()
		def labelsUnitsAndDescriptions() !none {
			let orders = try Diagnostics.register<Counter>("test.diag.requests", {"route": "/orders", "method": "GET"}, unit = "ms", description = "Requests served")
			let carts = try Diagnostics.register<Counter>("test.diag.requests", {"route": "/carts"}, unit = "ignored")
			orders.inc()
			carts.inc()
			carts.inc()
			let again = try Diagnostics.register<Counter>("test.diag.requests", {"method": "GET", "route": "/orders"})
			try testing.expectEqual(uint64(1), again.value(), "the same labels in another order are the same series")
			try testing.expectTrue(Diagnostics.has("test.diag.requests", {"route": "/carts"}), "a series is found by its labels")
			try testing.expectFalse(Diagnostics.has("test.diag.requests"), "the bare name is another series")
			try testing.expectTrue(Diagnostics.names().includes("test.diag.requests\u007Bmethod=\"GET\",route=\"/orders\"\u007D"), "list names a series with its sorted labels")
			let refused = false
			Diagnostics.register<Gauge>("test.diag.requests", {"route": "/carts"}) onerror (err error) {
				refused = true
				recover new Gauge()
			}
			try testing.expectTrue(refused, "a series keeps its type")
			let found = 0
			for let (_, held) in Diagnostics.series() {
				continue unless held.name == "test.diag.requests"
				found++
				try testing.expectEqual("ms", held.unit, "the first unit given for the name stays")
				try testing.expectEqual("Requests served", held.description, "and the description, for every series")
				let route = held.labels["route"]
				let counter = held.metric
				match counter {
					case Counter:
						try testing.expectEqual(route == "/carts" ?? (uint64(2), uint64(1)), counter.value(), "each series counts on its own")
					default:
						fail "a counter was registered"
				}
			}
			try testing.expectEqual(2, found, "series reports both")
			return none
		}
	}
}
