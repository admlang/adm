// The Features service's IDE panel: every flag and group with what decided
// it (the server or an override), and the buttons that refresh from the
// server, override a flag and take overrides back.

partial module std.services.features {
	use std.ide::(ide, IdeKind, IdeTable)

	partial service Features {
		@ide(kind = IdeKind.Table, label = "Flags", refresh = 1s, rows = 0)
		atomic def ideFlags() IdeTable {
			let rows = string[][]
			let names = held.features.keys()
			for let (_, name) in held.featureOverrides.keys() {
				names.push(name) unless names.includes(name)
			}
			names.sort((a, b) => a < b)
			for let (_, name) in names {
				let overridden = held.featureOverrides.get(name)
				let from = overridden is none ?? (held.features.get(name), overridden)
				continue when from is none
				let value = from.value is none ?? ("", "{from.value}")
				rows.push([name, from.enabled ?? ("on", "off"), value, overridden is none ?? ("server", "override")])
			}
			return IdeTable{columns: ["Flag", "State", "Value", "From"], rows: rows}
		}

		@ide(kind = IdeKind.Table, label = "Groups", refresh = 1s, rows = 4)
		atomic def ideGroups() IdeTable {
			let rows = string[][]
			let names = held.groups.keys()
			for let (_, name) in held.groupOverrides.keys() {
				names.push(name) unless names.includes(name)
			}
			names.sort((a, b) => a < b)
			for let (_, name) in names {
				let overridden = held.groupOverrides.get(name)
				let from = overridden is none ?? (held.groups.get(name), overridden)
				continue when from is none
				rows.push([name, from.arm, "{from.values}", overridden is none ?? ("server", "override")])
			}
			return IdeTable{columns: ["Group", "Arm", "Values", "From"], rows: rows}
		}

		@ide(kind = IdeKind.Value, label = "Failed requests in a row", refresh = 1s)
		def ideFailures() int {
			return failures
		}

		@ide(kind = IdeKind.Action, label = "Refresh")
		def ideRefresh() !none {
			return refresh()
		}

		// Turns a flag on or off for the rest of the run, whatever the server says.
		@ide(kind = IdeKind.Action, label = "Override flag")
		def ideOverride(name string, enabled bool) {
			override(name, enabled)
		}

		@ide(kind = IdeKind.Action, label = "Take override back", row = "ideFlags.Flag")
		def ideRestore(name string) {
			restore(name)
		}

		@ide(kind = IdeKind.Action, label = "Take every override back", confirm = "Take every override back?")
		def ideRestoreAll() {
			restore()
		}
	}
}
