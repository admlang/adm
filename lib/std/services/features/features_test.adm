partial module std.services.features {
	use (
		std.crypto::(generateEd25519Key)
		std.net.features
		std.net.features::(Assignments, Condition, Feature, FeatureServer, FeaturesError, FeaturesErrorKind, Group, MemoryRules, Rule, Rules, Segment, Variant)
		std.net.http
		std.net.http.httptest
		std.services.i18n::(I18n)
		std.services.telemetry::(Telemetry, TelemetryBatch, TelemetryConfig, TelemetrySignal)
		std.services.vault::(Vault, VaultConfig)
		std.testing
		std.time
	)

	// A feature server on a loopback port, with the rules it decides by.
	internal type Rig {
		server FeatureServer
		source MemoryRules
		web    httptest.Server

		def new(server FeatureServer, source MemoryRules, web httptest.Server) {
			self.server = server
			self.source = source
			self.web = web
		}

		// Replaces the server's rules.
		def decide(rules Rules) !none {
			source.replace(try features.compile(rules))
			return none
		}
	}

	// The rules most tests start from: a gate that is on, a limit of 25, a
	// ratio, a text, a struct, a list, a gate for the `pro` plan, and a
	// group for everyone with one arm.
	internal def usual() Rules {
		return Rules{
			segments: [Segment{name: "pro", attributes: [Condition{attribute: "plan", equals: "pro"}]}],
			features: [
				Feature{name: "new-checkout", enabled: true},
				Feature{name: "old-export"},
				Feature{name: "upload.limit", enabled: true, value: 25},
				Feature{name: "ratio", enabled: true, value: 2},
				Feature{name: "greeting", enabled: true, value: "hello"},
				Feature{name: "quota", enabled: true, value: {"rows": 500, "label": "large"}},
				Feature{name: "regions", enabled: true, value: ["eu", "us"]},
				Feature{name: "pro-only", rules: [Rule{segments: ["pro"]}]},
			],
			groups: [Group{
				name:     "login-page",
				keys:     {"button-color": "blue", "columns": 2},
				arms:     [Variant{name: "bold", values: {"button-color": "red"}}],
				everyone: true,
			}],
		}
	}

	internal struct Quota {
		rows  int    = 1
		label string = "small"
	}

	// Stops the service, forgets what it kept and every condition, and
	// starts it against a new server deciding by `rules`. The first reply
	// has arrived when it returns.
	internal def rigged(rules Rules) !Rig {
		Vault.config(VaultConfig{memoryKiB: 64, passes: 1}) onerror recover none
		try await Vault.start()
		try await Features.stop()
		Features.lab.reset()
		Features.restore()
		try Vault.remove("features.assignments")
		let source = new MemoryRules(try features.compile(rules))
		let server = new FeatureServer(source, try generateEd25519Key())
		let web = try httptest.Server.start(server.handler())
		try Features.config(FeaturesConfig{url: web.url + "/features", key: server.key.public, retry: 1h})
		try await Features.start()
		try Features.refresh()
		return new Rig(server, source, web)
	}

	// The kind `refresh` fails with; none when it succeeds.
	internal def refreshFailsAs(kind FeaturesErrorKind) bool {
		let matched = false
		Features.refresh() onerror (err error) {
			matched = err.kind == kind when err is FeaturesError
			recover none
		}
		return matched
	}

	internal let changes = new channel<string>(64)
	internal let failures = new channel<string>(64)

	@on(Features.changed)
	internal def onChanged(evt Event<FeaturesChange>) {
		changes.offer(evt.result.features.join(",") + "|" + evt.result.groups.join(","))
	}

	@on(Features.failed)
	internal def onFailed(evt Event<FeaturesError>) {
		failures.offer(evt.result.message)
	}

	// Empties a channel of what earlier tests left in it.
	internal def drained(from channel<string>) {
		from.flush()
	}

	// Whether nothing comes from the channel for a tenth of a second.
	internal def quiet(from channel<string>) bool {
		let limit = time.sleepChan(100ms)
		select {
			case from:
				return false
			case limit:
				return true
		}
		return true
	}

	// The next text of the channel, "" when none comes within `wait`.
	internal def next(from channel<string>, wait duration = 1s) string {
		let limit = time.sleepChan(wait)
		select {
			case from:
				return <- from
			case limit:
				return ""
		}
		return ""
	}

	// Keeps the usage events it is given.
	internal type Collector {
		events string[]

		def new() {}

		// Name implements Exporter.
		def name() string {
			return "features test"
		}

		// Export implements Exporter. Does not fail.
		def export(batch TelemetryBatch) !none {
			for let used in batch.events {
				let detail = used.properties.hasKey("arm") ?? ("{used.properties["group"]}={used.properties["arm"]}", "{used.properties["feature"]}={used.properties["enabled"]}")
				events.push("{used.name} {detail}")
			}
			return none
		}

		// Close implements Exporter. Does not fail.
		def close() !none {
			return none
		}
	}

	check "Features service" {
		@test()
		def readsGiveWhatTheServerDecided() !none {
			let rig = try rigged(usual())
			try testing.expectTrue(Features.enabled("new-checkout"), "a feature the server turned on")
			try testing.expectFalse(Features.enabled("old-export"), "a feature the server left off")
			try testing.expectFalse(Features.enabled("old-export", true), "the fallback is not for a feature the server decided")
			try testing.expectFalse(Features.enabled("never-heard-of"), "a feature the server did not mention is off")
			try testing.expectTrue(Features.enabled("never-heard-of", true), "or what the code says")
			try testing.expectEqual(25, Features.value<int>("upload.limit", 10))
			try testing.expectEqual("hello", Features.value<string>("greeting", "hi"))
			try testing.expectEqual(10, Features.value<int>("never-heard-of", 10), "the fallback for a feature the server did not mention")
			try testing.expectEqual(7, Features.value<int>("new-checkout", 7), "and for a feature without a value")
			try testing.expectEqual(3, Features.value<int>("greeting", 3), "and for a value of another type")

			try testing.expectEqual("bold", Features.arm("login-page"))
			try testing.expectEqual("red", Features.value<string>("login-page", "button-color", "green"), "the arm's value")
			try testing.expectEqual(2, Features.value<int>("login-page", "columns", 1), "the group's default for a key the arm leaves out")
			try testing.expectEqual("x", Features.value<string>("login-page", "no-such-key", "x"))
			try testing.expectEqual("", Features.arm("no-such-group"))
			try testing.expectEqual("x", Features.value<string>("no-such-group", "button-color", "x"))
			try rig.web.close()
			return none
		}

		@test()
		def valuesReadAsTheTypeAsked() !none {
			let rig = try rigged(usual())
			try testing.expectEqual(2.0, Features.value<float>("ratio", 0.5), "a whole number reads as a float")
			try testing.expectEqual(int64(25), Features.value<int64>("upload.limit", int64(1)))
			let quota = Features.value<Quota>("quota", Quota{})
			try testing.expectEqual(500, quota.rows, "an object reads as a struct")
			try testing.expectEqual("large", quota.label)
			let regions = Features.value<string[]>("regions", string[])
			try testing.expectEqual("eu,us", regions.join(","), "an array reads as a typed array")
			let mine = Quota{rows: 9}
			try testing.expectEqual(9, Features.value<Quota>("greeting", mine).rows, "a value that is not one gives the fallback")
			try testing.expectEqual(9, mine.rows, "which is left as it was")
			try rig.web.close()
			return none
		}

		@test()
		def nothingIsReadWithoutAReply() !none {
			let rig = try rigged(usual())
			try await Features.stop()
			try Vault.remove("features.assignments")
			Features.lab.conditions.unreachable = true
			try await Features.start()
			try testing.expectFalse(Features.enabled("new-checkout"), "no reply yet: off")
			try testing.expectTrue(Features.enabled("new-checkout", true), "or the fallback")
			try testing.expectEqual(10, Features.value<int>("upload.limit", 10))
			try testing.expectEqual("", Features.arm("login-page"))
			try testing.expectEqual("green", Features.value<string>("login-page", "button-color", "green"))
			try testing.expectTrue(refreshFailsAs(FeaturesErrorKind.Transport), "a server that cannot be reached fails refresh")
			Features.lab.reset()
			try rig.web.close()
			return none
		}

		@test()
		def startNeedsAServer() !none {
			try await Features.stop()
			try Features.config(FeaturesConfig{})
			let message = ""
			startOnly() onerror (err error) {
				message = err.message
				recover none
			}
			try testing.expectTrue(message.contains("give FeaturesConfig a url and the server's key"), "got: {message}")
			let refused = ""
			Features.config(FeaturesConfig{timeout: 0s}) onerror (err error) {
				refused = err.message
				recover none
			}
			try testing.expectTrue(refused.contains("timeout must be positive"), "got: {refused}")
			return none
		}

		@test()
		def theLastReplyIsKeptAcrossRuns() !none {
			let rig = try rigged(usual())
			try await Features.stop()
			Features.lab.conditions.unreachable = true
			try await Features.start()
			try testing.expectTrue(Features.enabled("new-checkout"), "a program that starts offline has what it had")
			try testing.expectEqual(25, Features.value<int>("upload.limit", 10))
			try testing.expectEqual("bold", Features.arm("login-page"))

			// Back online with nothing new: the server says so and the reply
			// held stays.
			Features.lab.reset()
			drained(changes)
			try Features.refresh()
			try testing.expectTrue(quiet(changes), "an unchanged reply changes nothing")
			try testing.expectEqual(25, Features.value<int>("upload.limit", 10))

			// The renewal is kept too, and is no use without the reply it extends.
			try await Features.restart()
			try testing.expectTrue(Features.enabled("new-checkout"))

			// A reply kept under another server's key is not believed.
			try await Features.stop()
			Features.lab.conditions.unreachable = true
			try Features.config(FeaturesConfig{url: rig.web.url + "/features", key: (try generateEd25519Key()).public, retry: 1h})
			try await Features.start()
			try testing.expectFalse(Features.enabled("new-checkout"), "what another key signed is dropped")
			Features.lab.reset()
			try testing.expectTrue(refreshFailsAs(FeaturesErrorKind.Signature), "and the server's replies do not verify")
			try rig.web.close()
			return none
		}

		@test()
		def aNewReplyTellsWhatChanged() !none {
			let rig = try rigged(usual())
			drained(changes)
			let rules = usual()
			rules.features[0].enabled = false
			rules.features[2].value = 50
			rules.features.remove(1)
			rules.features.push(Feature{name: "brand-new", enabled: true})
			rules.groups[0].keys["columns"] = 3
			try rig.decide(rules)
			try Features.refresh()
			try testing.expectEqual("brand-new,new-checkout,old-export,upload.limit|login-page", next(changes), "added, changed and removed names")
			try testing.expectFalse(Features.enabled("new-checkout"), "a kill switch reaches the program at its next refresh")
			try testing.expectEqual(50, Features.value<int>("upload.limit", 10))
			try testing.expectEqual(3, Features.value<int>("login-page", "columns", 1))
			try Features.refresh()
			try testing.expectTrue(quiet(changes), "the same reply again changes nothing")
			try rig.web.close()
			return none
		}

		@test()
		def attributesReachTheRules() !none {
			let rig = try rigged(usual())
			try testing.expectFalse(Features.enabled("pro-only"))
			Features.set("plan", "pro")
			try Features.refresh()
			try testing.expectTrue(Features.enabled("pro-only"), "a rule on an attribute the program set")
			Features.set("plan", "")
			try Features.refresh()
			try testing.expectFalse(Features.enabled("pro-only"), "an empty value takes the attribute away")
			try rig.web.close()
			return none
		}

		@test()
		def theLanguageInUseIsSent() !none {
			let spoken = I18n.language().str()
			let rules = usual()
			rules.segments.push(Segment{name: "spoken", locales: [spoken]})
			rules.features.push(Feature{name: "localized", rules: [Rule{segments: ["spoken"]}]})
			let rig = try rigged(rules)
			try testing.expectTrue(Features.enabled("localized"), "without a configured locale the language I18n has in use is sent ({spoken})")
			try Features.config(FeaturesConfig{url: rig.web.url + "/features", key: rig.server.key.public, retry: 1h, locale: "tlh-QQ"})
			try Features.refresh()
			try testing.expectFalse(Features.enabled("localized"), "a configured locale is sent instead")
			try rig.web.close()
			return none
		}

		@test()
		def refusedRepliesKeepWhatWasHeld() !none {
			let rig = try rigged(usual())
			drained(failures)
			let rules = usual()
			rules.features[0].enabled = false
			try rig.decide(rules)

			Features.lab.conditions.badSignature = true
			try testing.expectTrue(refreshFailsAs(FeaturesErrorKind.Signature))
			try testing.expectTrue(next(failures).contains("signature"), "a refused reply is emitted as failed")
			try testing.expectTrue(Features.enabled("new-checkout"), "and what was held stays")
			Features.lab.reset()

			rig.server.validity = 0s
			try testing.expectTrue(refreshFailsAs(FeaturesErrorKind.Expired), "a reply already past its validity is refused")
			try testing.expectTrue(Features.enabled("new-checkout"))
			rig.server.validity = 720h

			Features.lab.conditions.stale = true
			try testing.expectFalse(Features.enabled("new-checkout"), "a reply past its validity gives the fallbacks")
			try testing.expectEqual(10, Features.value<int>("upload.limit", 10))
			try testing.expectEqual("", Features.arm("login-page"))
			Features.lab.reset()
			try testing.expectTrue(Features.enabled("new-checkout"))

			try Features.refresh()
			try testing.expectFalse(Features.enabled("new-checkout"), "a good reply is taken again")
			try rig.web.close()
			return none
		}

		@test()
		def repliesForSomeoneElseAreRefused() !none {
			let rig = try rigged(usual())
			let key = rig.server.key
			let status = 200
			let impostor = try httptest.Server.start(new http.HandlerFunc(def (ctx http.Context) !none {
				return try ctx.error(status, "down") unless status == 200
				let other = Assignments{subject: "someone-else", issued: time.wallNs() / 1000000000, refresh: 60, expires: time.wallNs() / 1000000000 + 3600}
				return try ctx.blob(200, "application/json", try features.sign(other, key))
			}))
			try Features.config(FeaturesConfig{url: impostor.url + "/", key: key.public, retry: 1h})
			try testing.expectTrue(refreshFailsAs(FeaturesErrorKind.Subject), "a reply signed for another installation is refused")
			try testing.expectTrue(Features.enabled("new-checkout"), "and what was held stays")
			status = 503
			try testing.expectTrue(refreshFailsAs(FeaturesErrorKind.Transport), "a server that answers with an error fails refresh")
			try impostor.close()
			try rig.web.close()
			return none
		}

		@test()
		def overridesWinForThisRun() !none {
			let rig = try rigged(usual())
			Features.override("new-checkout", false)
			Features.override("never-heard-of", true, 99)
			Features.override("login-page", "control", {"button-color": "grey"})
			try testing.expectFalse(Features.enabled("new-checkout"), "an override wins over the server")
			try testing.expectTrue(Features.enabled("never-heard-of"))
			try testing.expectEqual(99, Features.value<int>("never-heard-of", 1))
			try testing.expectEqual("control", Features.arm("login-page"))
			try testing.expectEqual("grey", Features.value<string>("login-page", "button-color", "x"))
			try testing.expectEqual(2, Features.value<int>("login-page", "columns", 1), "a key the override leaves out stays as the server gave it")
			try Features.refresh()
			try testing.expectFalse(Features.enabled("new-checkout"), "and stays over a new reply")

			Features.restore("new-checkout")
			try testing.expectTrue(Features.enabled("new-checkout"))
			try testing.expectEqual("control", Features.arm("login-page"), "restoring one name leaves the others")
			Features.restore()
			try testing.expectEqual("bold", Features.arm("login-page"))
			try testing.expectFalse(Features.enabled("never-heard-of"))
			try rig.web.close()
			return none
		}

		@test()
		def theServerSetsTheInterval() !none {
			let rules = usual()
			let rig = try rigged(rules)
			try await Features.stop()
			rig.server.refresh = 1s
			try await Features.start()
			try Features.refresh()
			drained(changes)
			rules.features[0].enabled = false
			try rig.decide(rules)
			let first = next(changes, 3s)
			try testing.expectEqual("new-checkout|", first, "the service asks again after the interval the server gave, got \"{first}\"")
			try testing.expectFalse(Features.enabled("new-checkout"))
			try await Features.stop()
			try rig.web.close()
			return none
		}

		@test()
		def groupsTakeMeasuredUsersAndFirstReadsAreReported() !none {
			try await Telemetry.stop()
			let rules = usual()
			rules.groups[0].everyone = false
			let rig = try rigged(rules)
			try testing.expectEqual("", Features.arm("login-page"), "without telemetry the installation is outside the test")
			try testing.expectEqual("blue", Features.value<string>("login-page", "button-color", "x"), "and gets the group's defaults")

			let collector = new Collector()
			try Telemetry.config(TelemetryConfig{exporters: [collector], requireConsent: false, spool: false, interval: 1h, signals: [TelemetrySignal.Events]})
			try await Telemetry.start()
			try Features.refresh()
			try testing.expectEqual("bold", Features.arm("login-page"), "a measured installation is in the test")
			Features.arm("login-page")
			Features.value<string>("login-page", "button-color", "x")
			Features.enabled("new-checkout")
			Features.enabled("new-checkout")
			Features.value<int>("upload.limit", 1)
			Features.enabled("never-heard-of")
			Features.override("old-export", true)
			Features.enabled("old-export")
			Features.restore()
			try Telemetry.flush()
			try testing.expectEqual("group login-page=bold; feature new-checkout=true; feature upload.limit=true", collector.events.join("; "), "one event per feature and group read, none for unknown names and overrides")
			try await Telemetry.stop()
			try rig.web.close()
			return none
		}
	}

	internal def startOnly() !none {
		try await Features.start()
		return none
	}
}
