partial module std.services {
	// Translates strings and formats numbers, dates and plurals for the user's locale.
	//
	// Not implemented yet.
	service I18n {
		description  = ""
		dependencies = Dependencies{
			hard: [Storage]
		}
		lifecycle    = Lifecycle{
			start: StartMode.Manual,
			restart: RestartMode.Always,
		}

		permissions Permission[]

		// Applies the service's settings. There are none yet, and it does not fail.
		def config<T>(val T) !none {}

		// Starts the service. Does not fail today.
		async def start() !none {
			return none
		}

		// Stops the service. Does not fail today.
		async def stop() !none {
			return none
		}

		// Stops the service and starts it again. Does not fail today.
		async def restart() !none {
			return none
		}
	}
	/*
	owns
	    locale, language, timezone, number formatting, currency formatting, date/time formatting
	    plural rules, translation catalogs, measurement formatting, collation
	
	metas
	
	    @translate("user.greeting", name = user.name)
	    property greeting string
	
	
	*/
}
