partial module std.services.i18n {
	use (
		std.formats.translations
		std.i18n::(Catalog, Currency, DateTimeStyle, Locale, Message, PluralCategory, PluralType, TimeZone, ZonedDateTime, parseLocale, parseTimeZone, pluralCategory)
		std.math::(Decimal)
		std.services::(Application, Dependencies, Lifecycle, RestartMode, StartMode)
		std.services.debugger::(trackCaller)
		std.services.storage::(Storage)
		std.time::(Date, DateTime, Time, TimeOfDay)
	)

	// Settings of the I18n service.
	struct I18nConfig {
		// The language translated text is shown in: "de", "pt-BR", "de_AT".
		// "" is the system's.
		language string = ""

		// The region whose formats numbers, money, dates and times take: a
		// region code ("RO", the formats of its main language) or a locale
		// ("en-GB", "de-CH-u-nu-latn"). "" is the system's.
		region string = ""

		// The time zone instants are written in: an IANA name
		// ("Europe/Bucharest") or an offset ("+02:00"). "" is the system's.
		timeZone string = ""

		// The folder `start` loads the application's catalogs from, one file
		// for each language, named by it: `de.po`, `pt_BR.po`. A relative
		// path is looked for among the application's shipped files
		// (`[package] files` of `adm.toml`). "" loads `locales` when the
		// application ships one, and nothing otherwise.
		folder string = ""

		// The language the program's own texts are written in: the keys, and
		// the values of `@translate` fields. A user it serves is shown those
		// texts as they are, and no text is reported missing for them.
		source string = "en"
	}

	// Whose language or region a setter changes.
	enum I18nScope {
		// The whole program's.
		Application
		// The calling task's, and that of the tasks it starts from then on: a
		// server handler sets its request's.
		Task
	}

	// The language, the region and the time zone in use after one of them
	// changed.
	struct I18nChange {
		language Locale
		region   Locale
		timeZone TimeZone
	}

	// A text no catalog has in the language asked for.
	struct MissingText {
		key      string
		context  string
		// The language that was asked for.
		language Locale
		// The library whose code asked, as `namespace:name`; "" for the
		// application.
		package  string
	}

	// What a test can make the I18n service meet (`I18n.lab.conditions`).
	// The default changes nothing.
	struct I18nConditions {
		// Modules that count as a library's code: the module's name to the
		// library's `namespace:name`. Texts asked for from such a module, and
		// catalogs it loads, are that library's.
		libraries map<string, string>
	}

	// What the operating system says the user prefers.
	struct SystemLocales {
		// The first of `languages`.
		language  Locale
		// The languages the user reads, most preferred first.
		languages Locale[]
		// The locale whose formats numbers, dates and money take.
		region    Locale
		// The time zone the system runs in.
		timeZone  TimeZone = new TimeZone()
	}

	// Translates the program's texts and writes numbers, money, dates and
	// times the way the user's region writes them.
	//
	// ```
	// try I18n.config(I18nConfig{folder: "locales"})
	// try await I18n.start()
	//
	// I18n.text("basket.count", {"count": 3})   // "3 Artikel"
	// I18n.money(1999, "EUR")                   // "19,99 €"
	// I18n.date(time.now())                     // "12.10.2026"
	// try I18n.setLanguage("fr")                // texts follow; `changed` is emitted
	// ```
	//
	// The language, the region and the time zone are three settings, as an
	// operating system has them. The language picks the catalog translated
	// text comes from; the region picks how numbers, money, dates and times
	// are written; the time zone picks the wall clock an instant is shown
	// on. English text with Romanian formats is `setLanguage("en")` and
	// `setRegion("RO")`. Each starts as the system's.
	//
	// Catalogs are files of `std.formats.translations` (`.po`), one for each
	// language, loaded from a folder at start and with `load` later. A text
	// is a message in the ICU MessageFormat syntax (`std.i18n.Message`). It
	// is looked up in the catalog of the language asked for, then in those of
	// the languages close to it ("de" for "de-AT"); when none has it the
	// answer is the source text, and `missing` reports it once.
	//
	// A library ships its own catalogs in a `locales` folder of its
	// `[package] files`. A text asked for by a library's code, or by a
	// `@translate` field a library declares, is looked up in the library's
	// catalogs first, then in the application's, so an application can
	// translate a library into a language the library does not ship.
	//
	// A server answers each request in its user's language, region and time
	// zone: `setLanguage`, `setRegion` and `setTimeZone` with
	// `I18nScope.Task` set them for the calling task, so a handler sets them
	// once and the code it calls needs no arguments; the methods also take
	// them as arguments.
	//
	// Texts and formats are read without starting the service: without
	// catalogs every text is its source text.
	partial service I18n {
		description               = "Translated text and the user's formats for numbers, money, dates and times"
		dependencies              = Dependencies{
			hard: [Storage, Application]
		}
		lifecycle                 = Lifecycle{
			start: StartMode.Manual,
			restart: RestartMode.Always,
		}
		permissions  Permission[]

		lab = new ServiceLab<I18nConditions>()

		cfg      I18nConfig         = I18nConfig{}
		running  bool
		// The language and region set for the program; none is the system's.
		speaking ?Locale            = none
		writing  ?Locale            = none
		zone     ?TimeZone          = none
		// The source language, read once from the settings.
		origin   Locale             = new Locale("en")
		// The catalogs by package, "" for the application's. Replaced as a
		// whole when a package's catalogs are first loaded, so reads take no
		// lock.
		shelves  map<string, Shelf> = map<string, Shelf>{"": new Shelf()}
		lookups  Lookups            = new Lookups()
		formats  Formats            = new Formats()

		// Applies the settings. A started service loads the folder again when
		// it changed, and emits `changed` when the language or the region in
		// use did.
		//
		// Fails when `language`, `region` or `source` is not a well-formed
		// locale, when `timeZone` is not a zone of the tz database or an
		// offset, and on a started service as `start` does.
		@commit()
		def config(val I18nConfig) !none {
			let language = try chosen(val.language, false)
			let region = try chosen(val.region, true)
			let source = try parseLocale(val.source == "" ?? ("en", val.source))
			let clock = try chosenZone(val.timeZone)
			let before = current()
			// The new folder is read before anything changes, so a folder that
			// cannot be read leaves the service as it was.
			if running && val.folder != cfg.folder {
				let loaded = new Shelf()
				try stockApplication(loaded, val.folder)
				shelves = map<string, Shelf>{"": loaded}
			}
			cfg = val
			speaking = language
			writing = region
			zone = clock
			origin = source
			announce(before)
			return none
		}

		// Loads the catalogs of the configured folder. A started service does
		// nothing.
		//
		// Fails when the configured folder does not exist or cannot be read
		// (permission `adm.storage.read`), or a file in it is not a
		// well-formed catalog.
		async def start() !none {
			try open()
			return none
		}

		atomic def open() !none {
			return none when running
			try stockApplication(shelfOf(""), cfg.folder)
			running = true
			return none
		}

		// Stops the service. The catalogs stay loaded, and texts and formats
		// stay readable. Does not fail.
		async def stop() !none {
			close()
			return none
		}

		atomic def close() {
			running = false
		}

		// Stops the service and starts it again: every catalog is dropped and
		// the configured folder is loaded anew, which picks up files that
		// changed. Fails as `start` does.
		async def restart() !none {
			try await stop()
			drop()
			try await start()
			return none
		}

		atomic def drop() {
			shelves = map<string, Shelf>{"": new Shelf()}
			lookups = new Lookups()
		}

		// Loads the application's catalogs from a configured folder.
		def stockApplication(shelf Shelf, folder string) !none {
			if folder == "" {
				// The default folder is optional.
				let path = Application.filePath("package://" + defaultFolder) onerror recover ""
				let present = path != "" && (Storage.exists(path) onerror recover false)
				return none unless present
				return fill(shelf, path)
			}
			return fill(shelf, folder) when folder.startsWith("/") || folder.contains("://")
			// Among the application's shipped files when it is there, else
			// as the path is written.
			let shipped = Application.filePath("package://" + folder) onerror recover ""
			let present = shipped != "" && (Storage.exists(shipped) onerror recover false)
			return fill(shelf, present ?? (shipped, folder))
		}

		// The language translated text is shown in: the calling task's when
		// it set one, else the program's, else the system's.
		@query()
		def language() Locale {
			let own = taskLanguage.get()
			return own unless own is none
			let set = speaking
			return set unless set is none
			return hostLocales.language
		}

		// The locale whose formats numbers, money, dates and times take: the
		// calling task's when it set one, else the program's, else the
		// system's.
		@query()
		def region() Locale {
			let own = taskRegion.get()
			return own unless own is none
			let set = writing
			return set unless set is none
			return hostLocales.region
		}

		// The time zone instants are written in: the calling task's when it
		// set one, else the program's, else the system's.
		@query()
		def timeZone() TimeZone {
			let own = taskZone.get()
			return own unless own is none
			let set = zone
			return set unless set is none
			return lookups.hostZone()
		}

		// Sets the time zone instants are written in: an IANA name
		// ("Europe/Bucharest") or an offset ("+02:00"); "" goes back to the
		// system's, or for a task to the program's. For the program it emits
		// `changed` when the zone in use becomes another; a task's own emits
		// nothing. A `ZonedDateTime` is always written in its own zone, and
		// a plain date or time has none.
		//
		// Fails when the zone is neither in the tz database nor an offset.
		@commit()
		def setTimeZone(timeZone string, scope I18nScope = I18nScope.Application) !none {
			let asked = try chosenZone(timeZone)
			if scope == I18nScope.Task {
				taskZone.set(asked)
				return none
			}
			let before = current()
			zone = asked
			announce(before)
			return none
		}

		// Sets the language translated text is shown in ("de", "pt-BR",
		// "de_AT"); "" goes back to the system's, or for a task to the
		// program's. For the program it emits `changed` when the language in
		// use becomes another; a task's own emits nothing.
		//
		// Fails when the language is not a well-formed locale.
		@commit()
		def setLanguage(language string, scope I18nScope = I18nScope.Application) !none {
			let asked = try chosen(language, false)
			if scope == I18nScope.Task {
				taskLanguage.set(asked)
				return none
			}
			let before = current()
			speaking = asked
			announce(before)
			return none
		}

		// Sets the region whose formats numbers, money, dates and times take:
		// a region code ("RO") or a locale ("en-GB"); "" goes back to the
		// system's, or for a task to the program's. For the program it emits
		// `changed` when the region in use becomes another; a task's own
		// emits nothing.
		//
		// Fails when the region is neither a region code nor a well-formed
		// locale.
		@commit()
		def setRegion(region string, scope I18nScope = I18nScope.Application) !none {
			let asked = try chosen(region, true)
			if scope == I18nScope.Task {
				taskRegion.set(asked)
				return none
			}
			let before = current()
			writing = asked
			announce(before)
			return none
		}

		// The program's language, region and time zone, a task's own left
		// aside.
		def current() I18nChange {
			let language = speaking
			let region = writing
			let clock = zone
			return I18nChange{
				language: language is none ?? (hostLocales.language, language),
				region:   region is none ?? (hostLocales.region, region),
				timeZone: clock is none ?? (lookups.hostZone(), clock),
			}
		}

		// Emits `changed` when the program's language or region is no longer
		// what it was.
		def announce(before I18nChange) {
			let now = current()
			return when now.language.equals(before.language) && now.region.equals(before.region) && now.timeZone.id == before.timeZone.id
			changed(now)
		}

		// What the operating system says the user prefers: the languages of
		// `LANGUAGE`, `LC_ALL`, `LC_MESSAGES` and `LANG`, and the formats of
		// `LC_ALL`, `LC_NUMERIC`, `LC_TIME`, `LC_MONETARY` and `LANG`,
		// American English when the system says nothing; and the time zone
		// the system runs in (`std.i18n.systemTimeZone`).
		@query()
		def system() SystemLocales {
			return SystemLocales{language: hostLocales.language, languages: hostLocales.languages, region: hostLocales.region, timeZone: lookups.hostZone()}
		}

		// The languages the application has catalogs for, and its source
		// language, sorted by tag.
		@query()
		def languages() Locale[] {
			let out = shelfOf("").available()
			let has = false
			for let l in out {
				has = true when l.equals(origin)
			}
			out.push(origin) unless has
			out.sort((a, b) => a.str() < b.str())
			return out
		}

		// The language of `languages()` that best serves an HTTP
		// Accept-Language header ("de-CH, de;q=0.9, en;q=0.5"), by the CLDR
		// language matching data: "de" for "de-AT". None when nothing the
		// application has is close to anything the header asks for.
		@query()
		def negotiate(acceptLanguage string) ?Locale {
			return bestServed(acceptLanguage, languages())
		}

		// Loads a catalog file, or every catalog file of a folder (the files
		// whose extension a format of `std.formats.translations` has; other
		// files are left alone). A file's language is the one it names
		// inside, else the one in its name: `de.po`, `pt_BR.po`,
		// `messages.fr-CA.po`. A message already loaded for the language is
		// replaced. The catalogs become those of the package that calls:
		// the application's, or a library's own.
		//
		// Fails when the path does not exist or cannot be read (permission
		// `adm.storage.read`), a file is not a well-formed catalog, or a
		// file names no language.
		@trackCaller()
		@commit()
		def load(path string) !none {
			return fill(shelfOf(packageOf(__module__)), path)
		}

		// Loads a catalog made in code, or read by the program itself.
		//
		// Fails when the catalog's locale is undetermined ("und").
		@trackCaller()
		@commit()
		def load(catalog Catalog) !none {
			fail "i18n: the catalog names no language" when catalog.locale.language.code == "und"
			shelfOf(packageOf(__module__)).put(catalog)
			return none
		}

		// Reads the catalogs at a path into a shelf.
		def fill(shelf Shelf, path string) !none {
			let info = try Storage.stat(path)
			let files string[]
			if info.isDir {
				for let entry in try Storage.readDir(path) {
					files.push(entry.path) when !entry.info.isDir && translations.supports(entry.path)
				}
				files.sort((a, b) => a < b)
			} else {
				files.push(path)
			}
			for let file in files {
				let catalog = try translations.load(file)
				fail "i18n: {file} names no language: name it after one (de.po) or give it a Language header" when catalog.locale.language.code == "und"
				shelf.put(catalog)
			}
			return none
		}

		// The translated text of a message, with the values of `params`
		// (`{"count": 3}`) written in: in `language` when given, else the
		// language in use; numbers and dates in it as `region` writes them
		// when given, else the region in use. `context` tells apart messages
		// with the same key.
		//
		// When no catalog has the message, the answer is the key itself with
		// the values written in, and `missing` reports it.
		@trackCaller()
		@query()
		def text(key string, params map<string, any> = {}, language string = "", region string = "", context string = "") string {
			return render(packageOf(__module__), key, context, key, params, language, region)
		}

		// The translated text of a message asked for on behalf of the code of
		// the module `owner`, whose library's catalogs are looked in first; `fallback`
		// is the answer when no catalog has the message. This is what a
		// `@translate` field reads through.
		@query()
		def textIn(owner string, key string, fallback string, params map<string, any> = {}, language string = "") string {
			return render(packageOf(owner), key, "", fallback, params, language, "")
		}

		// Has reports whether a catalog has the message in `language` (the
		// language in use when not given) or in a language close to it.
		@trackCaller()
		@query()
		def has(key string, language string = "", context string = "") bool {
			let asked = language == "" ?? (self.language(), lookups.locale(language))
			return !(find(packageOf(__module__), key, context, asked) is none)
		}

		def render(package string, key string, context string, fallback string, params map<string, any>, language string, region string) string {
			let asked = language == "" ?? (self.language(), lookups.locale(language))
			let written = region == "" ?? (self.region(), lookups.region(region))
			let found = find(package, key, context, asked)
			let clock = self.timeZone()
			return found.format(params, written, clock) unless found is none
			report(package, key, context, asked)
			return lookups.source(fallback, origin).format(params, written, clock)
		}

		// The library a module belongs to, "" for the application's and std's.
		def packageOf(owner string) string {
			if __labs__ && lab.conditions.libraries.len() > 0 {
				let named = lab.conditions.libraries.get(owner)
				return named unless named is none
			}
			return lookups.package(owner)
		}

		// The message from the package's catalogs, then the application's.
		def find(package string, key string, context string, asked Locale) ?Message {
			let tag = asked.str()
			if package != "" {
				for let catalog in shelfOf(package).serving(asked, tag) {
					let found = catalog.message(key, context)
					return found unless found is none
				}
			}
			for let catalog in shelfOf("").serving(asked, tag) {
				let found = catalog.message(key, context)
				return found unless found is none
			}
			return none
		}

		// A package's catalogs ("" is the application's); a library's are
		// loaded from its shipped `locales` folder the first time they are
		// asked for.
		def shelfOf(package string) Shelf {
			let held = shelves.get(package)
			return held unless held is none
			return stock(package)
		}

		atomic def stock(package string) Shelf {
			let held = shelves.get(package)
			return held unless held is none
			let shelf = new Shelf()
			let folder = package == "" ?? ("", Application.filePath(package + "://" + defaultFolder) onerror recover "")
			if folder != "" {
				let present = Storage.exists(folder) onerror recover false
				// A library whose catalogs cannot be read is served by the
				// application's and by its own source texts.
				if present {
					fill(shelf, folder) onerror recover none
				}
			}
			let next = map<string, Shelf>{}
			for let (name, other) in shelves {
				next[name] = other
			}
			next[package] = shelf
			shelves = next
			return shelf
		}

		// Reports a text no catalog has, once for each key, context, language
		// and package; never for a language the source language serves.
		def report(package string, key string, context string, asked Locale) {
			return when lookups.servedBySource(asked, origin)
			return unless lookups.first(package + "\x1f" + asked.str() + "\x1f" + context + "\x1f" + key)
			missing(MissingText{key: key, context: context, language: asked, package: package})
		}

		// The time zone a setting names: none for "".
		def chosenZone(setting string) !?TimeZone {
			return none when setting.trim() == ""
			return parseTimeZone(setting.trim())
		}

		// The zone an instant is written in by a format method.
		def zoned(value Time, timeZone string) ZonedDateTime {
			return new ZonedDateTime(value, timeZone == "" ?? (self.timeZone(), lookups.zone(timeZone)))
		}

		// The locale a setting names: none for "", a region code as the
		// formats of its main language when `region`.
		def chosen(setting string, region bool) !?Locale {
			return none when setting.trim() == ""
			return regionLocale(setting) when region
			return parseLocale(setting)
		}

		// Number writes the number as the region does: "1.234,5".
		@query()
		def number(value int, region string = "") string {
			return formats.number(formatsFor(region), "n", "").format(value)
		}

		// Number writes the number as the region does: "1.234,5".
		@query()
		def number(value float, region string = "") string {
			return formats.number(formatsFor(region), "n", "").format(value)
		}

		// Number writes the number as the region does: "1.234,5".
		@query()
		def number(value Decimal, region string = "") string {
			return formats.number(formatsFor(region), "n", "").format(value)
		}

		// Percent writes a fraction as a percentage: 0.25 is "25 %".
		@query()
		def percent(value float, region string = "") string {
			return formats.number(formatsFor(region), "p", "").format(value)
		}

		// Percent writes a fraction as a percentage: 0.25 is "25 %".
		@query()
		def percent(value Decimal, region string = "") string {
			return formats.number(formatsFor(region), "p", "").format(value)
		}

		// Money writes an amount in a currency (ISO 4217: "EUR"), in the
		// region's own currency when none is given: "1.234,50 €".
		@query()
		def money(amount Decimal, currency string = "", region string = "") string {
			let locale = formatsFor(region)
			return formats.number(locale, "c", currencyOf(locale, currency)).format(amount)
		}

		// Money writes an amount in a currency.
		@query()
		def money(amount float, currency string = "", region string = "") string {
			let locale = formatsFor(region)
			return formats.number(locale, "c", currencyOf(locale, currency)).format(amount)
		}

		// Money writes an amount given in the currency's minor units: 1999
		// with "EUR" is 19.99 euros, with "JPY" 1999 yen.
		@query()
		def money(minorUnits int, currency string = "", region string = "") string {
			let locale = formatsFor(region)
			let code = currencyOf(locale, currency)
			return formats.number(locale, "c", code).format(new Currency(code).amount(minorUnits))
		}

		// Date writes the day an instant falls on in the time zone in use,
		// or in `timeZone` when given: "12.10.2026", or longer or shorter by
		// `width`.
		@query()
		def date(value Time, width DateTimeStyle = DateTimeStyle.Medium, region string = "", timeZone string = "") string {
			return formats.date(formatsFor(region), width, DateTimeStyle.Off).format(zoned(value, timeZone))
		}

		// Date writes the day of a zoned date-time, in its own time zone.
		@query()
		def date(value ZonedDateTime, width DateTimeStyle = DateTimeStyle.Medium, region string = "") string {
			return formats.date(formatsFor(region), width, DateTimeStyle.Off).format(value)
		}

		// Date writes a calendar date.
		@query()
		def date(value Date, width DateTimeStyle = DateTimeStyle.Medium, region string = "") string {
			return formats.date(formatsFor(region), width, DateTimeStyle.Off).format(value) onerror recover value.str()
		}

		// Date writes the day of a date and time.
		@query()
		def date(value DateTime, width DateTimeStyle = DateTimeStyle.Medium, region string = "") string {
			return formats.date(formatsFor(region), width, DateTimeStyle.Off).format(value) onerror recover value.str()
		}

		// Time writes the time of day of an instant in the time zone in use,
		// or in `timeZone` when given: "14:05", or longer by `width`.
		@query()
		def time(value Time, width DateTimeStyle = DateTimeStyle.Short, region string = "", timeZone string = "") string {
			return formats.date(formatsFor(region), DateTimeStyle.Off, width).format(zoned(value, timeZone))
		}

		// Time writes the time of day of a zoned date-time, in its own time
		// zone.
		@query()
		def time(value ZonedDateTime, width DateTimeStyle = DateTimeStyle.Short, region string = "") string {
			return formats.date(formatsFor(region), DateTimeStyle.Off, width).format(value)
		}

		// Time writes a time of day.
		@query()
		def time(value TimeOfDay, width DateTimeStyle = DateTimeStyle.Short, region string = "") string {
			return formats.date(formatsFor(region), DateTimeStyle.Off, width).format(value) onerror recover value.str()
		}

		// Time writes the time of day of a date and time.
		@query()
		def time(value DateTime, width DateTimeStyle = DateTimeStyle.Short, region string = "") string {
			return formats.date(formatsFor(region), DateTimeStyle.Off, width).format(value) onerror recover value.str()
		}

		// DateTime writes the day and the time of an instant in the time
		// zone in use, or in `timeZone` when given: "12.10.2026, 14:05".
		@query()
		def dateTime(value Time, dateWidth DateTimeStyle = DateTimeStyle.Medium, timeWidth DateTimeStyle = DateTimeStyle.Short, region string = "", timeZone string = "") string {
			return formats.date(formatsFor(region), dateWidth, timeWidth).format(zoned(value, timeZone))
		}

		// DateTime writes the day and the time of a zoned date-time, in its
		// own time zone.
		@query()
		def dateTime(value ZonedDateTime, dateWidth DateTimeStyle = DateTimeStyle.Medium, timeWidth DateTimeStyle = DateTimeStyle.Short, region string = "") string {
			return formats.date(formatsFor(region), dateWidth, timeWidth).format(value)
		}

		// DateTime writes a date and time.
		@query()
		def dateTime(value DateTime, dateWidth DateTimeStyle = DateTimeStyle.Medium, timeWidth DateTimeStyle = DateTimeStyle.Short, region string = "") string {
			return formats.date(formatsFor(region), dateWidth, timeWidth).format(value) onerror recover value.str()
		}

		// SpellOut writes the number in words ("one hundred twenty-three"),
		// or through another rule set of the region's language:
		// "%spellout-ordinal", "%digits-ordinal" ("21st"), and those
		// `std.i18n.SpellOut.ruleSets` lists.
		@query()
		def spellOut(value int, ruleSet string = "%spellout-numbering", region string = "") string {
			return formats.speller(formatsFor(region), ruleSet).format(value)
		}

		// SpellOut writes the number in words, its fraction digit by digit.
		@query()
		def spellOut(value float, ruleSet string = "%spellout-numbering", region string = "") string {
			return formats.speller(formatsFor(region), ruleSet).format(value)
		}

		// SpellOut writes the number in words, its fraction digit by digit.
		@query()
		def spellOut(value Decimal, ruleSet string = "%spellout-numbering", region string = "") string {
			return formats.speller(formatsFor(region), ruleSet).format(value)
		}

		// Plural returns the plural form the count takes in the language in
		// use, or in `language` when given: One for 1 in English, Few for 3
		// in Romanian. The form belongs to the language of the text it
		// picks, so the region has no say in it.
		@query()
		def plural(count int, kind PluralType = PluralType.Cardinal, language string = "") PluralCategory {
			return pluralCategory(spokenFor(language), count, kind)
		}

		// Plural returns the plural form the number takes in the language in
		// use, or in `language` when given, written in its shortest form.
		@query()
		def plural(count float, kind PluralType = PluralType.Cardinal, language string = "") PluralCategory {
			return pluralCategory(spokenFor(language), count, kind)
		}

		// Plural returns the plural form the number takes in the language in
		// use, or in `language` when given, its scale counting as visible
		// fraction digits.
		@query()
		def plural(count Decimal, kind PluralType = PluralType.Cardinal, language string = "") PluralCategory {
			return pluralCategory(spokenFor(language), count, kind)
		}

		// The language a plural form is asked in.
		def spokenFor(language string) Locale {
			return self.language() when language == ""
			return lookups.locale(language)
		}

		// The locale a format method writes for.
		def formatsFor(region string) Locale {
			return self.region() when region == ""
			return lookups.region(region)
		}

		// The currency a money amount is in: the one named, else the one in
		// use in the region, else the unknown currency.
		def currencyOf(locale Locale, currency string) string {
			return currency.upper() when currency != ""
			let own = locale.region.currency()
			own = locale.maximize().region.currency() when own is none
			return "XXX" when own is none
			return own.code
		}

		// Emitted when the program's language, region or time zone becomes
		// another, with all three as they are now. Interface code shows its texts again
		// on it; a task's own language and region emit nothing.
		@emit()
		def changed(change I18nChange) I18nChange {
			return change
		}

		// Emitted the first time a text is asked for that no catalog has in
		// the language asked for or one close to it, for each key, context,
		// language and package.
		@emit()
		def missing(text MissingText) MissingText {
			return text
		}
	}

	// The folder a package's catalogs are shipped in.
	internal const defaultFolder = "locales"

	// A task's own language, region and time zone, none for the program's.
	internal let taskLanguage = new TaskLocal<Locale>()
	internal let taskRegion = new TaskLocal<Locale>()
	internal let taskZone = new TaskLocal<TimeZone>()
}
