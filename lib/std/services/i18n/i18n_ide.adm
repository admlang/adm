// The I18n service's IDE panel: the language, region and time zone in use,
// the catalogs loaded, and the buttons that change them for the program.

partial module std.services.i18n {
	use (
		std.i18n::(timeZoneNames)
		std.ide::(ide, IdeKind, IdeTable)
	)

	partial service I18n {
		// The language in use.
		@ide(kind = IdeKind.Value, label = "Language", refresh = 1s)
		def ideLanguage() string {
			return current().language.str()
		}

		// The region in use.
		@ide(kind = IdeKind.Value, label = "Region", refresh = 1s)
		def ideRegion() string {
			return current().region.str()
		}

		// The time zone in use.
		@ide(kind = IdeKind.Value, label = "Time zone", refresh = 1s)
		def ideTimeZone() string {
			return current().timeZone.id
		}

		// The catalogs loaded, by package and language.
		@ide(kind = IdeKind.Table, label = "Catalogs", refresh = 1s, rows = 6)
		def ideCatalogs() IdeTable {
			let table = IdeTable{columns: ["Package", "Language", "Messages"]}
			let held = shelves
			let names = held.keys()
			names.sort((a, b) => a < b)
			for let name in names {
				let shelf = held.get(name)
				continue when shelf is none
				for let row in shelf.summary() {
					table.rows.push([name == "" ?? ("application", name), row[0], row[1]])
				}
			}
			return table
		}

		// The languages the application has catalogs for, which Set language
		// offers.
		@ide(kind = IdeKind.Choices, refresh = 10s)
		def ideLanguages() string[] {
			let out = string[]
			for let language in languages() {
				out.push(language.str())
			}
			return out
		}

		// Every time zone of the IANA database, which Set time zone offers.
		@ide(kind = IdeKind.Choices, refresh = 3600s)
		def ideTimeZones() string[] {
			return timeZoneNames()
		}

		// Sets the language for the whole program (`en`, `pt-BR`).
		@ide(kind = IdeKind.Action, label = "Set language", sets = "ideLanguage", choices = "ideLanguages")
		def ideSetLanguage(language string) !none {
			return setLanguage(language)
		}

		// Sets the region for the whole program (`DE`, `en-GB`).
		@ide(kind = IdeKind.Action, label = "Set region", sets = "ideRegion")
		def ideSetRegion(region string) !none {
			return setRegion(region)
		}

		// Sets the time zone for the whole program (`Europe/Paris`).
		@ide(kind = IdeKind.Action, label = "Set time zone", sets = "ideTimeZone", choices = "ideTimeZones")
		def ideSetTimeZone(timeZone string) !none {
			return setTimeZone(timeZone)
		}
	}
}
