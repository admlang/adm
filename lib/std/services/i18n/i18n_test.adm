partial module std.services.i18n {
	use (
		std.i18n::(Catalog, CatalogEntry, DateTimeFormat, DateTimeOptions, DateTimeStyle, Locale, Message, NumberFormat, NumberKind, NumberOptions, PluralCategory, PluralType, SpellOut, translate)
		std.math::(Decimal, parseDecimal)
		std.os
		std.testing
		std.time
		std.time::(Date, DateTime, TimeOfDay)
	)

	// Collects what the service announces.
	internal type I18nObserver {
		internal changes I18nChange[]
		internal missed  MissingText[]

		@on(I18n.changed)
		def onChanged(evt Event<I18nChange>) {
			changes.push(evt.result)
		}

		@on(I18n.missing)
		def onMissing(evt Event<MissingText>) {
			missed.push(evt.result)
		}
	}

	// A type with translated fields, as an application writes it.
	internal type Basket {
		count int
		owner string

		@translate("basket.title")
		title string = "Your basket"

		@translate("basket.count", params = {"count": count, "user": owner})
		summary string = "\{count, plural, one\{# item\} other\{# items\}\} for \{user\}"

		@translate("basket.title", lang = "fr")
		titleInFrench string = "Your basket"

		@translate("basket.unknown", params = {"count": count})
		untranslated string = "\{count\} left"

		def new(count int, owner string) {
			self.count = count
			self.owner = owner
		}
	}

	internal const germanCatalog = "msgid \"\"\nmsgstr \"\"\n\"Language: de\\n\"\n\"Content-Type: text/plain; charset=UTF-8\\n\"\n\nmsgid \"basket.title\"\nmsgstr \"Ihr Warenkorb\"\n\nmsgid \"basket.count\"\nmsgstr \"\{count, plural, one\{# Artikel\} other\{# Artikel\}\} für \{user\}\"\n\nmsgid \"total\"\nmsgstr \"Summe: \{amount, number, ::currency/EUR\} am \{day, date, medium\}\"\n\nmsgctxt \"menu\"\nmsgid \"Open\"\nmsgstr \"Öffnen\"\n\nmsgid \"only.german\"\nmsgstr \"nur deutsch\"\n"

	internal const austrianCatalog = "msgid \"\"\nmsgstr \"\"\n\"Language: de_AT\\n\"\n\"Content-Type: text/plain; charset=UTF-8\\n\"\n\nmsgid \"basket.title\"\nmsgstr \"Ihr Einkaufssackerl\"\n"

	internal const frenchCatalog = "msgid \"basket.title\"\nmsgstr \"Votre panier\"\n\nmsgid \"basket.count\"\nmsgstr \"\{count, plural, one\{# article\} other\{# articles\}\} pour \{user\}\"\n"

	internal const russianCatalog = "msgid \"\"\nmsgstr \"\"\n\"Language: ru\\n\"\n\"Content-Type: text/plain; charset=UTF-8\\n\"\n\"Plural-Forms: nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);\\n\"\n\nmsgid \"files\"\nmsgid_plural \"files\"\nmsgstr[0] \"\{count\} файл\"\nmsgstr[1] \"\{count\} файла\"\nmsgstr[2] \"\{count\} файлов\"\n"

	// Writes the catalogs to a new folder and returns it.
	internal def catalogFolder(name string) !string {
		let folder = "/tmp/adm-i18n-{name}-{time.now().unixNs()}"
		try os.mkdir(folder + "/locales", true)
		try os.writeFile(folder + "/locales/de.po", germanCatalog.bytes())
		try os.writeFile(folder + "/locales/de_AT.po", austrianCatalog.bytes())
		try os.writeFile(folder + "/locales/fr.po", frenchCatalog.bytes())
		try os.writeFile(folder + "/locales/ru.po", russianCatalog.bytes())
		try os.writeFile(folder + "/locales/readme.txt", "not a catalog".bytes())
		return folder
	}

	// Starts the service anew on a folder of catalogs, in English with
	// American formats, and returns the folder.
	internal def fresh(name string) !string {
		let folder = try catalogFolder(name)
		try I18n.setLanguage("", I18nScope.Task)
		try I18n.setRegion("", I18nScope.Task)
		try I18n.setTimeZone("", I18nScope.Task)
		try I18n.config(I18nConfig{language: "en", region: "en-US", folder: folder + "/locales"})
		try await I18n.restart()
		return folder
	}

	check "I18n" {
		@test()
		def textsComeFromTheConfiguredFolder() !none {
			let folder = try fresh("texts")
			assert I18n.text("basket.title") == "basket.title"
			try I18n.setLanguage("de")
			assert I18n.language().str() == "de"
			assert I18n.text("basket.title") == "Ihr Warenkorb"
			assert I18n.text("basket.count", {"count": 1, "user": "Ana"}) == "1 Artikel für Ana"
			assert I18n.text("Open", {}, "", "", "menu") == "Öffnen"
			assert I18n.text("Open") == "Open"
			assert I18n.has("basket.title") && !I18n.has("basket.nothing") && I18n.has("Open", "", "menu") && !I18n.has("Open")
			try I18n.setLanguage("fr")
			assert I18n.text("basket.title") == "Votre panier"
			assert I18n.text("basket.count", {"count": 2, "user": "Ana"}) == "2 articles pour Ana"
			try I18n.setLanguage("ru")
			assert I18n.text("files", {"count": 22}) == "22 файла"
			assert I18n.text("files", {"count": 5}) == "5 файлов"
			let tags string[]
			for let l in I18n.languages() {
				tags.push(l.str())
			}
			assert tags.join(",") == "de,de-AT,en,fr,ru"
			try os.remove(folder, true)
		}

		@test()
		def languageAndRegionAreSetApart() !none {
			let folder = try fresh("apart")
			try I18n.setLanguage("de")
			// German text, American formats.
			assert I18n.region().str() == "en-US"
			assert I18n.text("basket.count", {"count": 1234, "user": "Ana"}) == "1,234 Artikel für Ana"
			assert I18n.text("total", {"amount": 1234.5, "day": new Date(2026, 10, 12)}) == "Summe: €1,234.50 am Oct 12, 2026"
			// German text, Romanian formats.
			try I18n.setRegion("RO")
			assert I18n.region().str() == "ro-RO"
			assert I18n.language().str() == "de"
			assert I18n.text("basket.count", {"count": 1234, "user": "Ana"}) == "1.234 Artikel für Ana"
			assert I18n.text("total", {"amount": 1234.5, "day": new Date(2026, 10, 12)}) == "Summe: 1.234,50 EUR am 12 oct. 2026"
			// A region as a locale.
			try I18n.setRegion("de-CH")
			assert I18n.number(1234567) == "1'234'567"
			// English text, Romanian formats.
			try I18n.setLanguage("en")
			try I18n.setRegion("RO")
			assert I18n.text("\{n, plural, one\{# file\} other\{# files\}\}", {"n": 1500}) == "1.500 files"
			try os.remove(folder, true)
		}

		@test()
		def formatsOfTheRegion() !none {
			let folder = try fresh("formats")
			let exact = parseDecimal("1234.50") onerror recover new Decimal()
			assert I18n.number(1234567) == "1,234,567"
			assert I18n.number(1234.5) == "1,234.5"
			assert I18n.number(exact) == "1,234.5"
			assert I18n.percent(0.256) == "26%"
			assert I18n.money(1999, "EUR") == "€19.99"
			assert I18n.money(1999) == "$19.99"
			assert I18n.money(1999, "JPY") == "¥1,999"
			assert I18n.money(19.5, "USD") == "$19.50"
			assert I18n.money(exact, "GBP") == "£1,234.50"
			assert I18n.date(new Date(2026, 10, 12)) == "Oct 12, 2026"
			assert I18n.date(new Date(2026, 10, 12), DateTimeStyle.Full) == "Monday, October 12, 2026"
			assert I18n.date(new DateTime(2026, 10, 12, 14, 5, 9), DateTimeStyle.Short) == "10/12/26"
			assert I18n.time(new TimeOfDay(14, 5, 9)) == "2:05 PM"
			assert I18n.time(new TimeOfDay(14, 5, 9), DateTimeStyle.Medium) == "2:05:09 PM"
			assert I18n.dateTime(new DateTime(2026, 10, 12, 14, 5, 9)) == "Oct 12, 2026, 2:05 PM"
			assert I18n.spellOut(123) == "one hundred twenty-three"
			assert I18n.spellOut(21, "%spellout-ordinal") == "twenty-first"
			assert I18n.plural(1) == PluralCategory.One
			assert I18n.plural(3) == PluralCategory.Other
			assert I18n.plural(2, PluralType.Ordinal) == PluralCategory.Two
			try I18n.setRegion("RO")
			assert I18n.number(1234.5) == "1.234,5"
			assert I18n.percent(0.256) == "26 %"
			assert I18n.money(1999) == "19,99 RON"
			assert I18n.date(new Date(2026, 10, 12)) == "12 oct. 2026"
			assert I18n.time(new TimeOfDay(14, 5, 9)) == "14:05"
			assert I18n.dateTime(new DateTime(2026, 10, 12, 14, 5, 9)) == "12 oct. 2026, 14:05"
			assert I18n.spellOut(123) == "una sută douăzeci și trei"
			// The plural form is the language's: English text stays English under Romanian formats.
			assert I18n.plural(3) == PluralCategory.Other
			try I18n.setLanguage("ro")
			assert I18n.plural(3) == PluralCategory.Few
			assert I18n.plural(1) == PluralCategory.One
			try I18n.setLanguage("en")
			// An instant is written in the system's time zone: the day it names there.
			assert I18n.date(time.now(), DateTimeStyle.Short).len() > 0
			assert I18n.dateTime(time.now()).contains(I18n.date(time.now()))
			try os.remove(folder, true)
		}

		@test()
		def aRequestCarriesItsOwnByArgument() !none {
			let folder = try fresh("argument")
			assert I18n.text("basket.title", {}, "de") == "Ihr Warenkorb"
			assert I18n.text("basket.title", {}, "fr_FR") == "Votre panier"
			assert I18n.text("basket.count", {"count": 1234, "user": "Ana"}, "de", "de-CH") == "1'234 Artikel für Ana"
			assert I18n.text("basket.count", {"count": 1234, "user": "Ana"}, "de", "RO") == "1.234 Artikel für Ana"
			assert I18n.number(1234.5, "de-DE") == "1.234,5"
			assert I18n.money(1999, "", "DE") == "19,99 €"
			assert I18n.date(new Date(2026, 10, 12), DateTimeStyle.Long, "fr") == "12 octobre 2026"
			assert I18n.plural(3, PluralType.Cardinal, "ro") == PluralCategory.Few
			assert I18n.has("basket.title", "de") && !I18n.has("basket.title", "ja")
			// Nothing of it stays.
			assert I18n.language().str() == "en" && I18n.region().str() == "en-US"
			try os.remove(folder, true)
		}

		// What a task sees after setting its own language and region, sent
		// over the channel: its text, a number, and what a task it starts sees.
		def inItsOwnTask(done channel<string>) {
			I18n.setLanguage("de", I18nScope.Task) onerror recover none
			I18n.setRegion("RO", I18nScope.Task) onerror recover none
			let nested = new channel<string>(1)
			async inAStartedTask(nested)
			let inherited = <-nested
			done <- I18n.text("basket.title") + "|" + I18n.number(1234.5) + "|" + inherited
		}

		def inAStartedTask(done channel<string>) {
			done <- I18n.text("basket.title") + "/" + new NumberFormat().format(1234.5)
		}

		@test()
		def aTaskHasItsOwn() !none {
			let folder = try fresh("task")
			let observer = new I18nObserver()
			let done = new channel<string>(1)
			async inItsOwnTask(done)
			assert <- done == "Ihr Warenkorb|1.234,5|Ihr Warenkorb/1.234,5"
			// The task that started it keeps the program's, and nothing was announced.
			assert I18n.text("basket.title") == "basket.title"
			assert I18n.number(1234.5) == "1,234.5"
			assert observer.changes.len() == 0
			// A task's own goes back to the program's with "".
			try I18n.setLanguage("fr", I18nScope.Task)
			assert I18n.text("basket.title") == "Votre panier"
			try I18n.setLanguage("", I18nScope.Task)
			assert I18n.text("basket.title") == "basket.title"
			try os.remove(folder, true)
		}

		// What a task sees of an instant after setting its own time zone, and
		// what a task it starts sees.
		def clockInItsOwnTask(at time.Time, done channel<string>) {
			I18n.setTimeZone("Asia/Tokyo", I18nScope.Task) onerror recover none
			let nested = new channel<string>(1)
			async clockInAStartedTask(at, nested)
			let inherited = <-nested
			done <- I18n.time(at) + "|" + inherited
		}

		def clockInAStartedTask(at time.Time, done channel<string>) {
			done <- I18n.time(at)
		}

		@test()
		def instantsAreWrittenInTheTimeZoneInUse() !none {
			let folder = try fresh("zone")
			// A known zone first, so that what follows is a change whatever the system's is.
			try I18n.setTimeZone("Asia/Kolkata")
			let observer = new I18nObserver()
			// 2026-10-12 23:30 UTC.
			let at = time.fromUnixNs(int64(1791847800) * 1000000000)
			try I18n.setTimeZone("Europe/Bucharest")
			assert I18n.timeZone().id == "Europe/Bucharest"
			assert I18n.dateTime(at) == "Oct 13, 2026, 2:30\u202fAM"
			assert I18n.date(at) == "Oct 13, 2026"
			assert I18n.time(at) == "2:30\u202fAM"
			try I18n.setTimeZone("America/New_York")
			assert I18n.dateTime(at) == "Oct 12, 2026, 7:30\u202fPM"
			try I18n.setTimeZone("+05:30")
			assert I18n.time(at) == "5:00\u202fAM"
			assert observer.changes.len() == 3
			assert observer.changes[1].timeZone.id == "America/New_York" && observer.changes[1].language.str() == "en"
			try I18n.setTimeZone("+05:30")
			assert observer.changes.len() == 3
			// By argument, for one call.
			assert I18n.time(at, DateTimeStyle.Short, "", "Asia/Tokyo") == "8:30\u202fAM"
			assert I18n.date(at, DateTimeStyle.Medium, "de-DE", "Asia/Tokyo") == "13.10.2026"
			assert I18n.dateTime(at, DateTimeStyle.Short, DateTimeStyle.Short, "ro-RO", "UTC") == "12.10.2026, 23:30"
			// A text's dates and times, and a format made without a locale.
			try I18n.setTimeZone("Europe/Bucharest")
			assert I18n.text("at \{when, time, short\} on \{when, date, medium\}", {"when": at}) == "at 2:30\u202fAM on Oct 13, 2026"
			assert new DateTimeFormat(DateTimeOptions{timeStyle: DateTimeStyle.Short}).format(at) == "2:30\u202fAM"
			assert new DateTimeFormat(DateTimeOptions{timeStyle: DateTimeStyle.Short, timeZone: "UTC"}).format(at) == "11:30\u202fPM"
			// A zoned date-time keeps its own zone, and a plain time has none.
			assert I18n.time(new TimeOfDay(14, 5)) == "2:05\u202fPM"
			// A task's own, inherited by the task it starts; the program's stays.
			let done = new channel<string>(1)
			async clockInItsOwnTask(at, done)
			assert <- done == "8:30\u202fAM|8:30\u202fAM"
			assert I18n.time(at) == "2:30\u202fAM"
			assert observer.changes.len() == 4
			// What is no zone is refused, and "" is the system's again.
			let refused = 0
			for let bad in ["Mars/Phobos", "noon", "+25:00"] {
				I18n.setTimeZone(bad) onerror (err error) {
					refused++
					recover none
				}
			}
			assert refused == 3
			assert I18n.timeZone().id == "Europe/Bucharest"
			try I18n.setTimeZone("")
			assert I18n.timeZone().id == I18n.system().timeZone.id
			assert I18n.system().timeZone.id != ""
			try I18n.config(I18nConfig{language: "en", region: "en-US", timeZone: "Asia/Tokyo", folder: folder + "/locales"})
			assert I18n.time(at) == "8:30\u202fAM"
			try os.remove(folder, true)
		}

		@test()
		def changedIsEmittedWhenTheSettingInUseChanges() !none {
			let folder = try fresh("changed")
			let observer = new I18nObserver()
			try I18n.setLanguage("de")
			assert observer.changes.len() == 1
			assert observer.changes[0].language.str() == "de" && observer.changes[0].region.str() == "en-US"
			try I18n.setLanguage("de")
			assert observer.changes.len() == 1
			try I18n.setRegion("RO")
			assert observer.changes.len() == 2
			assert observer.changes[1].language.str() == "de" && observer.changes[1].region.str() == "ro-RO"
			try I18n.setRegion("ro-RO")
			assert observer.changes.len() == 2
			try I18n.config(I18nConfig{language: "fr", region: "ro-RO", folder: folder + "/locales"})
			assert observer.changes.len() == 3
			assert observer.changes[2].language.str() == "fr"
			let refused = 0
			for let bad in ["not a locale", "d", "x-"] {
				I18n.setLanguage(bad) onerror (err error) {
					refused++
					recover none
				}
			}
			I18n.setRegion("ZZ") onerror (err error) {
				refused++
				recover none
			}
			assert refused == 4
			assert observer.changes.len() == 3
			try os.remove(folder, true)
		}

		@test()
		def aCloseLanguageServes() !none {
			let folder = try fresh("close")
			// Austrian German has its own title, and Germany's for the rest.
			try I18n.setLanguage("de-AT")
			assert I18n.text("basket.title") == "Ihr Einkaufssackerl"
			assert I18n.text("only.german") == "nur deutsch"
			try I18n.setLanguage("de-CH")
			assert I18n.text("basket.title") == "Ihr Warenkorb"
			try I18n.setLanguage("fr-CA")
			assert I18n.text("basket.title") == "Votre panier"
			// Another language does not.
			try I18n.setLanguage("nl")
			assert I18n.text("basket.title") == "basket.title"
			try os.remove(folder, true)
		}

		@test()
		def aMissingTextIsReportedOnce() !none {
			let folder = try fresh("missing")
			let observer = new I18nObserver()
			// The source language is served by the source texts.
			assert I18n.text("Hello \{name\}", {"name": "Ana"}) == "Hello Ana"
			assert I18n.text("Hello \{name\}", {"name": "Ana"}, "en-GB") == "Hello Ana"
			assert observer.missed.len() == 0
			try I18n.setLanguage("de")
			assert I18n.text("Hello \{name\}", {"name": "Ana"}) == "Hello Ana"
			assert I18n.text("Hello \{name\}", {"name": "Bob"}) == "Hello Bob"
			assert observer.missed.len() == 1
			assert observer.missed[0].key == "Hello \{name\}" && observer.missed[0].language.str() == "de" && observer.missed[0].package == ""
			assert I18n.text("Hello \{name\}", {"name": "Ana"}, "fr") == "Hello Ana"
			assert I18n.text("Open", {}, "", "", "toolbar") == "Open"
			assert observer.missed.len() == 3
			assert observer.missed[1].language.str() == "fr"
			assert observer.missed[2].context == "toolbar"
			assert I18n.text("basket.title") == "Ihr Warenkorb"
			assert observer.missed.len() == 3
			try os.remove(folder, true)
		}

		@test()
		def negotiatesAnAcceptLanguageHeader() !none {
			let folder = try fresh("negotiate")
			let pick = def (header string) string {
				let best = I18n.negotiate(header)
				return "(none)" when best is none
				return best.str()
			}
			assert pick("de-CH, de;q=0.9, en;q=0.5") == "de"
			assert pick("de-AT") == "de-AT"
			assert pick("fr-CA, en;q=0.2") == "fr"
			assert pick("ja, en-GB;q=0.4") == "en"
			assert pick("ja, zh") == "(none)"
			assert pick("") == "(none)"
			try os.remove(folder, true)
		}

		@test()
		def loadAddsCatalogs() !none {
			let folder = try fresh("load")
			try os.writeFile(folder + "/extra.nl.po", "msgid \"basket.title\"\nmsgstr \"Uw winkelmand\"\n".bytes())
			try I18n.load(folder + "/extra.nl.po")
			assert I18n.text("basket.title", {}, "nl") == "Uw winkelmand"
			// A second file of a language adds to it and replaces what it repeats.
			try os.writeFile(folder + "/more.de.po", "msgid \"basket.title\"\nmsgstr \"Der Korb\"\n\nmsgid \"added\"\nmsgstr \"neu\"\n".bytes())
			try I18n.load(folder + "/more.de.po")
			assert I18n.text("basket.title", {}, "de") == "Der Korb"
			assert I18n.text("added", {}, "de") == "neu"
			assert I18n.text("only.german", {}, "de") == "nur deutsch"
			// A catalog made in code.
			let spanish = new Catalog(new Locale("es"))
			spanish.add(CatalogEntry{key: "basket.title", text: "Su cesta"})
			try I18n.load(spanish)
			assert I18n.text("basket.title", {}, "es-MX") == "Su cesta"
			let refused = string[]
			I18n.load(new Catalog(new Locale())) onerror (err error) {
				refused.push(err.message)
				recover none
			}
			I18n.load(folder + "/nothing.po") onerror (err error) {
				refused.push(err.message)
				recover none
			}
			try os.writeFile(folder + "/broken.de.po", "msgid \"a\"\nmsgstr \"b\n".bytes())
			I18n.load(folder + "/broken.de.po") onerror (err error) {
				refused.push(err.message)
				recover none
			}
			try os.writeFile(folder + "/messages.po", "msgid \"a\"\nmsgstr \"b\"\n".bytes())
			I18n.load(folder + "/messages.po") onerror (err error) {
				refused.push(err.message)
				recover none
			}
			assert refused.len() == 4
			assert refused[0].contains("names no language")
			assert refused[2].contains("line 2")
			assert refused[3].contains("names no language")
			// A folder that does not exist is refused, and the service stays as it was.
			let applied = true
			I18n.config(I18nConfig{language: "fr", region: "en-US", folder: folder + "/absent"}) onerror (err error) {
				applied = false
				recover none
			}
			assert !applied
			assert I18n.language().str() == "en"
			assert I18n.text("basket.title", {}, "nl") == "Uw winkelmand"
			// On a stopped service the folder is read by the start, which then fails.
			try await I18n.stop()
			try I18n.config(I18nConfig{language: "en", region: "en-US", folder: folder + "/absent"})
			let started = true
			await I18n.start() onerror (err error) {
				started = false
				recover none
			}
			assert !started
			try os.remove(folder, true)
		}

		@test()
		def aLibrarysCatalogsComeFirst() !none {
			let folder = try fresh("library")
			let observer = new I18nObserver()
			let own = new Catalog(new Locale("de"))
			own.add(CatalogEntry{key: "basket.title", text: "Korb der Bibliothek"})
			// From here on this module's code counts as the library acme:shop.
			I18n.lab.conditions.libraries["std.services.i18n"] = "acme:shop"
			try I18n.load(own)
			// The library's own catalog, then the application's, then the source text.
			assert I18n.text("basket.title", {}, "de") == "Korb der Bibliothek"
			assert I18n.text("only.german", {}, "de") == "nur deutsch"
			assert I18n.text("nowhere \{n\}", {"n": 1}, "de") == "nowhere 1"
			assert I18n.has("basket.title", "de") && I18n.has("only.german", "de") && !I18n.has("nowhere", "de")
			// The application translates a library into a language it does not ship.
			assert I18n.text("basket.title", {}, "fr") == "Votre panier"
			// A field the library declares reads through the library's catalogs.
			try I18n.setLanguage("de")
			assert new Basket(1, "Ana").title == "Korb der Bibliothek"
			assert observer.missed.len() == 1
			assert observer.missed[0].package == "acme:shop"
			I18n.lab.reset()
			// The application's code is not served by a library's catalogs.
			assert I18n.text("basket.title", {}, "de") == "Ihr Warenkorb"
			assert new Basket(1, "Ana").title == "Ihr Warenkorb"
			try os.remove(folder, true)
		}

		@test()
		def translatedFieldsFollowTheLanguage() !none {
			let folder = try fresh("fields")
			let basket = new Basket(3, "Ana")
			assert basket.title == "Your basket"
			assert basket.summary == "3 items for Ana"
			assert basket.titleInFrench == "Votre panier"
			try I18n.setLanguage("de")
			assert basket.title == "Ihr Warenkorb"
			assert basket.summary == "3 Artikel für Ana"
			assert basket.titleInFrench == "Votre panier"
			// The parameters are read on each read.
			basket.count = 1
			basket.owner = "Bob"
			assert basket.summary == "1 Artikel für Bob"
			// Without a translation the field's own text, with its parameters.
			assert basket.untranslated == "1 left"
			try I18n.setLanguage("fr")
			assert basket.title == "Votre panier"
			assert basket.summary == "1 article pour Bob"
			try os.remove(folder, true)
		}

		@test()
		def formatsMadeWithoutALocaleTakeTheServices() !none {
			let folder = try fresh("defaults")
			assert new NumberFormat().format(1234.5) == "1,234.5"
			try I18n.setRegion("DE")
			assert new NumberFormat().format(1234.5) == "1.234,5"
			assert new NumberFormat(NumberOptions{kind: NumberKind.Percent}).format(0.5) == "50 %"
			assert new SpellOut().format(21) == "ein­und­zwanzig"
			try I18n.setLanguage("ro")
			let files = new Message("\{n, plural, one\{# fișier\} few\{# fișiere\} other\{# de fișiere\}\}")
			assert files.locale.str() == "ro"
			assert files.format({"n": 3}) == "3 fișiere"
			assert files.format({"n": 1234}, I18n.region()) == "1.234 de fișiere"
			try os.remove(folder, true)
		}

		@test()
		def readsTheSystemsPreferences() {
			let tags = def (found SystemLocales) string {
				let names string[]
				for let l in found.languages {
					names.push(l.str())
				}
				return found.language.str() + " [" + names.join(",") + "] " + found.region.str()
			}
			assert tags(systemLocales("", "", "", "", "", "", "")) == "en-US [en-US] en-US"
			assert tags(systemLocales("", "", "", "de_DE.UTF-8", "", "", "")) == "de-DE [de-DE] de-DE"
			assert tags(systemLocales("", "", "", "en_US.UTF-8", "ro_RO.UTF-8", "ro_RO.UTF-8", "ro_RO.UTF-8")) == "en-US [en-US] ro-RO"
			assert tags(systemLocales("fr_CH:fr:de", "", "", "en_US.UTF-8", "", "", "")) == "fr-CH [fr-CH,fr,de,en-US] en-US"
			assert tags(systemLocales("fr", "", "pt_BR.UTF-8", "en_US.UTF-8", "", "de_DE.UTF-8", "")) == "fr [fr,pt-BR] de-DE"
			assert tags(systemLocales("fr", "ja_JP.UTF-8", "pt_BR.UTF-8", "en_US.UTF-8", "ro_RO", "", "")) == "fr [fr,ja-JP] ja-JP"
			// LANGUAGE does not count in the "C" locale, which has no language of its own.
			assert tags(systemLocales("fr", "", "", "C.UTF-8", "", "", "")) == "en-US [en-US] en-US"
			assert tags(systemLocales("", "", "", "POSIX", "", "", "")) == "en-US [en-US] en-US"
			assert tags(systemLocales("", "", "", "sr_RS@latin", "", "", "")) == "sr-Latn-RS [sr-Latn-RS] sr-Latn-RS"
			assert tags(systemLocales("!!:de", "", "", "en_US", "", "", "")) == "de [de,en-US] en-US"
			let host = I18n.system()
			assert host.languages.len() > 0 && host.language.equals(host.languages[0])
		}

		@test()
		def regionsByCodeOrLocale() {
			let named = def (setting string) string {
				let locale = regionLocale(setting) onerror recover new Locale()
				return locale.str()
			}
			assert named("RO") == "ro-RO"
			assert named("CH") == "de-CH"
			assert named("US") == "en-US"
			assert named("IN") == "hi-IN"
			assert named("en-GB") == "en-GB"
			assert named("en_GB") == "en-GB"
			// Lower case is a language: Catalan, not Canada.
			assert named("ca") == "ca"
			assert named("CA") == "en-CA"
			assert named("de-CH-u-nu-latn") == "de-CH-u-nu-latn"
			assert named("ZZ") == "und"
			assert named("!") == "und"
		}
	}
}
