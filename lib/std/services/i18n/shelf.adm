partial module std.services.i18n {
	use std.i18n::(Catalog, DateTimeFormat, DateTimeOptions, DateTimeStyle, Locale, Message, NumberFormat, NumberKind, NumberOptions, Region, SpellOut, TimeZone, negotiate, parseAcceptLanguage, parseLocale, systemTimeZone)

	// How many entries a cache of the service holds before it starts over: a
	// program that asks in languages without end does not grow without end.
	internal const cacheLimit = 4096

	// Shelf is the catalogs of one package, by language.
	internal type Shelf {
		catalogs map<string, Catalog>
		// The catalogs that serve a language asked for, nearest first, by
		// its tag.
		served   map<string, Catalog[]>

		def new() {}

		// Adds a catalog. Its messages go into the catalog already held for
		// its language, replacing those with the same key.
		atomic def put(catalog Catalog) {
			served = map<string, Catalog[]>{}
			let tag = catalog.locale.str()
			let held = catalogs.get(tag)
			if held is none {
				catalogs[tag] = catalog
				return
			}
			let rule = catalog.header("Plural-Forms")
			held.setHeader("Plural-Forms", rule) when held.header("Plural-Forms") is none && !(rule is none)
			for let entry in catalog.entries() {
				held.add(entry)
			}
		}

		// The catalogs to look in for a language, nearest first: its own,
		// then those of the languages the CLDR matching data counts close
		// ("de" for "de-AT", "pt-PT" for "pt-AO"); none of another language.
		atomic def serving(asked Locale, tag string) Catalog[] {
			let ready = served.get(tag)
			return ready unless ready is none
			let list Catalog[]
			let left Locale[]
			for let (_, catalog) in catalogs {
				left.push(catalog.locale)
			}
			left.sort((a, b) => a.str() < b.str())
			for left.len() > 0 {
				let best = negotiate([asked], left)
				break when best is none
				let name = best.str()
				let catalog = catalogs.get(name)
				list.push(catalog) unless catalog is none
				for let (i, l) in left {
					if l.str() == name {
						left.remove(i)
						break
					}
				}
			}
			served = map<string, Catalog[]>{} when served.len() >= cacheLimit
			served[tag] = list
			return list
		}

		// The languages the shelf has catalogs for.
		atomic def available() Locale[] {
			let out Locale[]
			for let (_, catalog) in catalogs {
				out.push(catalog.locale)
			}
			return out
		}

		// A row for each catalog: its language and how many messages it has.
		atomic def summary() string[][] {
			let rows string[][]
			let tags = catalogs.keys()
			tags.sort((a, b) => a < b)
			for let tag in tags {
				let catalog = catalogs.get(tag)
				rows.push([tag, catalog.len().str()]) unless catalog is none
			}
			return rows
		}
	}

	// Lookups holds what the service works out once and asks for on every
	// text: locales by their tag, source texts ready to format, the package
	// of each module, and which missing texts were reported.
	internal type Lookups {
		locales  map<string, Locale>
		regions  map<string, Locale>
		sources  map<string, Message>
		reported map<string, bool>
		packages map<string, string>
		read     bool
		bySource map<string, bool>
		zones    map<string, TimeZone>
		// The system's time zone, read the first time it is asked for.
		host     ?TimeZone             = none

		def new() {}

		// The time zone the system runs in.
		atomic def hostZone() TimeZone {
			let held = host
			return held unless held is none
			let read = systemTimeZone()
			host = read
			return read
		}

		// The time zone a name or an offset stands for; UTC for one the tz
		// database does not have.
		atomic def zone(setting string) TimeZone {
			let held = zones.get(setting)
			return held unless held is none
			zones = map<string, TimeZone>{} when zones.len() >= cacheLimit
			let made = new TimeZone(setting)
			zones[setting] = made
			return made
		}

		// The locale a tag names; the undetermined locale for one that is
		// not well-formed.
		atomic def locale(tag string) Locale {
			let held = locales.get(tag)
			return held unless held is none
			locales = map<string, Locale>{} when locales.len() >= cacheLimit
			let made = new Locale(tag)
			locales[tag] = made
			return made
		}

		// The locale a region setting names (see regionLocale); read as a
		// plain locale when it is not well-formed.
		atomic def region(setting string) Locale {
			let held = regions.get(setting)
			return held unless held is none
			regions = map<string, Locale>{} when regions.len() >= cacheLimit
			let made = regionLocale(setting) onerror recover new Locale(setting)
			regions[setting] = made
			return made
		}

		// A source text as a message of the source language.
		atomic def source(text string, origin Locale) Message {
			let held = sources.get(text)
			return held unless held is none
			sources = map<string, Message>{} when sources.len() >= cacheLimit
			let made = new Message(text, origin)
			sources[text] = made
			return made
		}

		// True the first time it is asked about the missing text.
		atomic def first(id string) bool {
			return false when reported.hasKey(id)
			reported = map<string, bool>{} when reported.len() >= cacheLimit * 4
			reported[id] = true
			return true
		}

		// The library a module belongs to, as `namespace:name`; "" for a
		// module of the application or of std.
		atomic def package(owner string) string {
			if !read {
				read = true
				for let entry in __module_packages__.split(";") {
					let separator = entry.indexOf("=")
					continue when separator < 0
					packages[entry[:separator]] = entry[separator + 1:]
				}
			}
			let held = packages.get(owner)
			return "" when held is none
			return held
		}

		// Whether the source language serves the language asked for, so the
		// source text is the right answer and nothing is missing.
		atomic def servedBySource(asked Locale, origin Locale) bool {
			let tag = asked.str()
			let held = bySource.get(tag)
			return held unless held is none
			bySource = map<string, bool>{} when bySource.len() >= cacheLimit
			let serves = !(negotiate([asked], [origin]) is none)
			bySource[tag] = serves
			return serves
		}
	}

	// Formats holds the formats the service's format methods write through,
	// by locale and kind, so each is built once.
	internal type Formats {
		numbers  map<string, NumberFormat>
		dates    map<string, DateTimeFormat>
		spellers map<string, SpellOut>

		def new() {}

		// The format of a kind: "n" a plain number, "p" a percentage, "c"
		// money in `currency`.
		atomic def number(locale Locale, kind string, currency string) NumberFormat {
			let key = locale.str() + "\x1f" + kind + currency
			let held = numbers.get(key)
			return held unless held is none
			numbers = map<string, NumberFormat>{} when numbers.len() >= cacheLimit
			let options = NumberOptions{}
			if kind == "p" {
				options.kind = NumberKind.Percent
			} else if kind == "c" {
				options.kind = NumberKind.Currency
				options.currency = currency
			}
			let made = new NumberFormat(locale, options)
			numbers[key] = made
			return made
		}

		atomic def date(locale Locale, dateWidth DateTimeStyle, timeWidth DateTimeStyle) DateTimeFormat {
			let key = locale.str() + "\x1f" + dateWidth.name + "/" + timeWidth.name
			let held = dates.get(key)
			return held unless held is none
			dates = map<string, DateTimeFormat>{} when dates.len() >= cacheLimit
			let made = new DateTimeFormat(locale, DateTimeOptions{dateStyle: dateWidth, timeStyle: timeWidth})
			dates[key] = made
			return made
		}

		atomic def speller(locale Locale, ruleSet string) SpellOut {
			let key = locale.str() + "\x1f" + ruleSet
			let held = spellers.get(key)
			return held unless held is none
			spellers = map<string, SpellOut>{} when spellers.len() >= cacheLimit
			let made = new SpellOut(locale, ruleSet)
			spellers[key] = made
			return made
		}
	}

	// The locale a region setting names: a region code in capitals ("RO",
	// "CH", or a UN M.49 number) is the formats of the region's main
	// language ("ro-RO", "de-CH"); anything else is read as a locale
	// ("en-GB", "ca").
	// Fails when the code is not a region CLDR knows, or the locale is not
	// well-formed.
	internal def regionLocale(setting string) !Locale {
		let code = setting.trim()
		let isCode = (code.len() == 2 && code.isAlpha() && code == code.upper()) || (code.len() == 3 && code.isNumeric())
		return parseLocale(code) unless isCode
		// A code CLDR has no name for is no region; "ZZ" is its name for none.
		let known = code != "ZZ" && new Region(code).name(new Locale("en")) != code
		fail "i18n: \"" + code + "\" is not a region" unless known
		let likely = new Locale("und-" + code).maximize()
		return new Locale(likely.language.code + "-" + likely.region.code)
	}

	// The available language that best serves an Accept-Language header.
	internal def bestServed(acceptLanguage string, available Locale[]) ?Locale {
		return negotiate(parseAcceptLanguage(acceptLanguage), available)
	}

	@env("LANGUAGE")
	internal const envLanguage string

	@env("LC_ALL")
	internal const envAll string

	@env("LC_MESSAGES")
	internal const envMessages string

	@env("LANG")
	internal const envLang string

	@env("LC_NUMERIC")
	internal const envNumeric string

	@env("LC_TIME")
	internal const envTime string

	@env("LC_MONETARY")
	internal const envMonetary string

	// What the system's environment says, read once.
	internal let hostLocales = systemLocales(envLanguage, envAll, envMessages, envLang, envNumeric, envTime, envMonetary)

	// The user's preferences from the POSIX locale variables. Languages: the
	// list in LANGUAGE (which counts only when the locale is not "C", as in
	// glibc), then the locale of messages (LC_ALL, else LC_MESSAGES, else
	// LANG). Formats: LC_ALL, else LC_NUMERIC, LC_TIME, LC_MONETARY, else
	// LANG. American English where nothing is set, or "C".
	internal def systemLocales(languageList string, all string, messages string, lang string, numeric string, time string, monetary string) SystemLocales {
		let fallback = new Locale("en-US")
		let named = firstSet([all, messages, lang])
		let main = posixLocale(named)
		let languages Locale[]
		// The "C" locale has no language of its own, and LANGUAGE does not
		// count under it.
		if !(main is none) && !plainC(named) {
			for let part in languageList.split(":") {
				let listed = posixLocale(part)
				continue when listed is none || plainC(part)
				let known = false
				for let l in languages {
					known = true when l.equals(listed)
				}
				languages.push(listed) unless known
			}
			let known = false
			for let l in languages {
				known = true when l.equals(main)
			}
			languages.push(main) unless known
		}
		languages.push(fallback) when languages.len() == 0
		let written = firstSet([all, numeric, time, monetary, lang])
		let region = fallback
		let formats = posixLocale(written)
		region = formats unless formats is none || plainC(written)
		return SystemLocales{language: languages[0], languages: languages, region: region}
	}

	internal def firstSet(values string[]) string {
		for let value in values {
			return value when value.trim() != ""
		}
		return ""
	}

	// Whether a POSIX locale name is the "C" locale, with or without a
	// codeset ("C.UTF-8").
	internal def plainC(name string) bool {
		let base = name.trim()
		let dot = base.indexOf(".")
		base = base[:dot] when dot >= 0
		return base := "C" || "POSIX"
	}

	// The locale a POSIX name stands for ("de_CH.UTF-8"); none for an empty
	// or ill-formed one.
	internal def posixLocale(name string) ?Locale {
		return none when name.trim() == ""
		let read = true
		let locale = parseLocale(name) onerror (err error) {
			read = false
			recover new Locale()
		}
		return none unless read
		return locale
	}
}
