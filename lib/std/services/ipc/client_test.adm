internal partial module std.services.ipc.link {
	use (
		std.net
		std.services.ipc::*
		std.services.ipc.wire::(Reader, decode)
		std.testing
		std.time
	)

	// A server that accepts one client, answers its handshake, and then
	// never answers anything again, not even a ping.
	def silentServer(ln net.Listener) !none {
		let conn = try ln.accept()
		try readPreface(conn, 5s)
		let nonce byte[]
		nonce.len(32)
		try net.writeAll(conn, frameBytes(frameHello, helloBytes(Hello{nonce: nonce, proofs: 0, maxCalls: 8, maxFrame: 1024})), 5s)
		let auth = try readFrame(conn, 1024, 0, 5s)
		assert auth.kind == frameAuth
		try net.writeAll(conn, frameBytes(frameWelcome, welcomeBytes([Answer{status: interfaceAccepted}])), 5s)
		time.sleep(2s)
		conn.close() onerror recover none
		return none
	}

	// The description of Orders with its first method spelled otherwise
	// and its hash changed, as a program built from another version would
	// have it.
	def otherOrders() InterfaceInfo {
		let real = describe<Orders>()
		let methods = real.methods.clone()
		methods[0] = "cancel(string)->none!"
		let hash = real.hash.startsWith("0") ?? ("1" + real.hash[1:], "0" + real.hash[1:])
		return InterfaceInfo{name: real.name, hash: hash, methods: methods, types: real.types}
	}

	check "IPC client" {
		testing.afterEach(def () {
			await IPC.stop() onerror recover none
		})

		@test()
		def TestMismatchNamesTheFirstDifference() !none {
			let info = InterfaceInfo{name: "m.I", hash: "", methods: ["a(int)->none!", "b()->int!"], types: ["record m.T\{x int\}"]}
			assert mismatchText(info, Answer{status: interfaceDiffers, methods: ["a(int)->none!", "b()->string!"], types: info.types}).contains("has no method b()->int!")
			assert mismatchText(info, Answer{status: interfaceDiffers, methods: ["a(int)->none!", "b()->int!", "c()->int!"], types: ["record m.T\{x int\}", "record m.U\{y int\}"]}).contains("another version")
			assert mismatchText(info, Answer{status: interfaceDiffers, methods: info.methods, types: ["record m.T\{x string\}"]}).contains("in type m.T")
		}

		@test()
		def TestAnotherVersionIsAMismatch() !none {
			await IPC.start() onerror recover none
			try IPC.provide(new Desk())
			let address = try IPC.listen("127.0.0.1:0", Listener{plain: true})
			let pool = new Pool(otherOrders(), [address], Auth{}, Link{plain: true})
			let message = ""
			let code = ""
			pool.start() onerror (err error) {
				message = err.message
				code = err.code
				recover none
			}
			assert code == "ipc.mismatch"
			assert message.contains("has no method cancel(string)->none!")
		}

		@test()
		def TestOlderClientCallsANewerServer() !none {
			await IPC.start() onerror recover none
			let desk = new Desk()
			try IPC.provide(desk)
			let address = try IPC.listen("127.0.0.1:0", Listener{plain: true})
			let real = describe<Orders>()
			// The client was built before `cancel`, the server's method 0.
			let methods = real.methods.clone()
			methods.remove(0)
			let hash = real.hash.startsWith("0") ?? ("1" + real.hash[1:], "0" + real.hash[1:])
			let older = InterfaceInfo{name: real.name, hash: hash, methods: methods, types: real.types}
			let pool = new Pool(older, [address], Auth{}, Link{plain: true})
			try pool.start()
			assert methods[0].startsWith("count(")
			let answer = try pool.call(0, [])
			let reader = new Reader(answer)
			assert decode<int>(reader) == 0
			try reader.done()

			let types = real.types.clone()
			types.push("record std.services.ipc.link.Ghost\{x int\}")
			let changed = InterfaceInfo{name: real.name, hash: hash, methods: methods, types: types}
			let refused = ""
			new Pool(changed, [address], Auth{}, Link{plain: true}).start() onerror (err error) {
				refused = err.message
				recover none
			}
			assert refused.contains("differs in type std.services.ipc.link.Ghost")
		}

		@test()
		def TestSilentServerIsLost() !none {
			let sock = try net.socket(net.SocketDomain.IPv4, net.SocketType.Stream)
			try sock.bind("127.0.0.1:0")
			let ln = try sock.listen(1)
			let server = async silentServer(ln)
			let pool = new Pool(describe<Orders>(), [ln.address().str()], Auth{}, Link{plain: true, keepAlive: 100ms})
			try pool.start()
			let started = time.now()
			let code = ""
			pool.call(1, []) onerror (err error) {
				code = err.code
				recover []
			}
			assert code == "ipc.lost"
			assert time.since(started) < 2s
			await server onerror recover none
			ln.close() onerror recover none
		}

		@test()
		def TestServerThatComesBackIsUsedAgain() !none {
			await IPC.start() onerror recover none
			try IPC.provide(new Desk())
			let address = try IPC.listen("127.0.0.1:0", Listener{plain: true})
			let orders = try IPC.connect<Orders>(address, Auth{}, Link{plain: true})
			assert try orders.count() == 0
			try IPC.close(address)
			time.sleep(50ms)
			let down = ""
			orders.count() onerror (err error) {
				down = err.code
				recover 0
			}
			assert down != ""
			try IPC.listen(address, Listener{plain: true})
			let back = false
			for let i = 0; i < 40 && !back; i++ {
				time.sleep(100ms)
				orders.count() onerror recover -1
				let n = orders.count() onerror recover -1
				back = n == 0
			}
			assert back
		}

		@test()
		def TestBalanceModes() !none {
			await IPC.start() onerror recover none
			let desk = new Desk()
			try IPC.provide(desk)
			let first = try IPC.listen("127.0.0.1:0", Listener{plain: true})
			let second = try IPC.listen("127.0.0.1:0", Listener{plain: true})
			let pinned = try IPC.connect<Counter>([first, second], Auth{}, Link{plain: true, balance: Balance.Pinned})
			assert busyServers(pinned) == 1
			let shared = try IPC.connect<Counter>([first, second], Auth{}, Link{plain: true})
			assert busyServers(shared) == 2
			let random = try IPC.connect<Counter>([first, second], Auth{}, Link{plain: true, balance: Balance.Random})
			for let i = 0; i < 6; i++ {
				try random.add(1)
			}
			assert desk.total == 6
			try pinned.add(0)
			try shared.add(0)
		}
	}

	// How many servers carry the calls of two slow calls made at once
	// through `counter`.
	def busyServers(counter Counter) int {
		let a = async counter.hold(300)
		let b = async counter.hold(300)
		time.sleep(100ms)
		let busy = 0
		for let (_, link) in IPC.links() {
			busy += 1 when !link.accepted && link.inFlight > 0
		}
		await a onerror recover 0
		await b onerror recover 0
		return busy
	}
}
