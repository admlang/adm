internal partial module std.services.ipc.link {
	use (
		std.services.ipc::*
		std.testing
		std.time
	)

	// One node of a test cluster: its registry, where it listens, and the
	// desk it provides.
	struct TestNode {
		registry Registry
		address  string
		desk     Desk
	}

	// Starts a node that asks `seeds` to join, with a fixed load when one is
	// given.
	def startNode(seeds string[], load float = -1.0, refuseAbove float = 0.0, forceAfter int = 3, failAbove float = 0.0) !TestNode {
		let registry = new Registry()
		let desk = new Desk()
		let owner any = desk
		try registry.catalog.add(served<Desk>(desk), owner)
		let address = try registry.listen("127.0.0.1:0", Listener{plain: true})
		let known = seeds.clone()
		known.push(address)
		let fixed ?def () float = none
		if load >= 0.0 {
			fixed = def () float {
				return load
			}
		}
		let settings = Cluster{
			name:         "test",
			advertise:    address,
			discovery:    new StaticNodes(known),
			link:         Link{plain: true, follow: false},
			gossipEvery:  50ms,
			suspectAfter: 400ms,
			deadAfter:    800ms,
			refuseAbove:  refuseAbove,
			forceAfter:   forceAfter,
			failAbove:    failAbove,
			load:         fixed,
		}
		let quiet = def (member Member) {}
		try registry.join(settings, quiet, quiet)
		return TestNode{registry: registry, address: address, desk: desk}
	}

	// The members `node` knows in `state`, itself left out.
	def othersIn(node TestNode, state MemberState) string[] {
		let held = node.registry.node()
		return [] when held is none
		let out string[] = []
		for let (_, member) in held.members() {
			out.push(member.address) when !member.own && member.state == state
		}
		return out
	}

	// Waits up to two seconds for `done`.
	def eventually(done def () bool) bool {
		for let i = 0; i < 100; i++ {
			return true when done()
			time.sleep(20ms)
		}
		return done()
	}

	// Stops a node: it leaves (or falls silent) and closes its listeners.
	def stopNode(node TestNode, farewell bool = true) {
		let held = node.registry.node()
		if farewell {
			node.registry.leave() onerror recover none
		} else if !(held is none) {
			held.stop(false)
		}
		let (listeners, _) = node.registry.takeAll()
		for let (_, listener) in listeners {
			listener.close()
		}
	}

	// A client of the cluster's Counter, starting from `address`.
	def counterAt(address string, follow bool = false, balance Balance = Balance.Pinned) !Counter {
		let info = describe<Counter>()
		let pool = new Pool(info, [address], Auth{}, Link{plain: true, follow: follow, balance: balance})
		try pool.start()
		return proxy<Counter>(new Remote(info, pool))
	}

	check "IPC cluster" {
		@test()
		def TestMembersFindEachOther() !none {
			let a = try startNode([])
			let b = try startNode([a.address])
			let c = try startNode([b.address])
			assert eventually(() => othersIn(a, MemberState.Alive).len() == 2 && othersIn(b, MemberState.Alive).len() == 2 && othersIn(c, MemberState.Alive).len() == 2)
			let held = a.registry.node()
			fail "no node" when held is none
			let listed = held.members()
			assert listed[0].own && listed[0].address == a.address
			assert listed[1].interfaces.includes("std.services.ipc.link.Orders")
			assert !listed[1].interfaces.includes("std.services.ipc.link.ClusterPeer")
			stopNode(a)
			stopNode(b)
			stopNode(c)
		}

		@test()
		def TestLeavingIsSeenAtOnce() !none {
			let a = try startNode([])
			let b = try startNode([a.address])
			assert eventually(() => othersIn(a, MemberState.Alive).len() == 1)
			stopNode(b)
			assert eventually(() => othersIn(a, MemberState.Left).includes(b.address))
			stopNode(a)
		}

		@test()
		def TestSilentNodeIsSuspectedThenDropped() !none {
			let a = try startNode([])
			let b = try startNode([a.address])
			assert eventually(() => othersIn(a, MemberState.Alive).len() == 1)
			stopNode(b, farewell = false)
			assert eventually(() => othersIn(a, MemberState.Suspect).includes(b.address))
			assert eventually(() => othersIn(a, MemberState.Suspect).len() == 0 && othersIn(a, MemberState.Alive).len() == 0)
			stopNode(a)
		}

		@test()
		def TestClientLearnsTheClusterFromOneNode() !none {
			let a = try startNode([])
			let b = try startNode([a.address])
			let c = try startNode([a.address])
			assert eventually(() => othersIn(a, MemberState.Alive).len() == 2)
			let info = describe<Counter>()
			let pool = new Pool(info, [a.address], Auth{}, Link{plain: true})
			try pool.start()
			let counter = proxy<Counter>(new Remote(info, pool))
			// A node tells the client of the others whenever its view changes;
			// calls let the pool take the list in.
			assert eventually(def () bool {
				counter.add(1) onerror recover 0
				return pool.links().len() == 3
			})
			for let i = 0; i < 9; i++ {
				try counter.add(1)
			}
			assert a.desk.total > 0 && b.desk.total > 0 && c.desk.total > 0
			stopNode(a)
			stopNode(b)
			stopNode(c)
		}

		@test()
		def TestBusyNodeSendsTheCallElsewhere() !none {
			let a = try startNode([], load = 9.0, refuseAbove = 1.0)
			let b = try startNode([a.address], load = 0.0, refuseAbove = 1.0)
			assert eventually(def () bool {
				let held = a.registry.node()
				return !(held is none) && held.lessLoaded("std.services.ipc.link.Counter", 9.0).len() == 1
			})
			let counter = try counterAt(a.address, follow = true)
			assert try counter.add(5) == 5
			assert a.desk.total == 0
			assert b.desk.total == 5
			stopNode(a)
			stopNode(b)
		}

		@test()
		def TestRefusedCallIsForcedAfterTheLimit() !none {
			let a = try startNode([], load = 9.0, refuseAbove = 1.0, forceAfter = 0)
			let b = try startNode([a.address], load = 0.0, refuseAbove = 1.0)
			assert eventually(def () bool {
				let held = a.registry.node()
				return !(held is none) && held.lessLoaded("std.services.ipc.link.Counter", 9.0).len() == 1
			})
			let counter = try counterAt(a.address, follow = true)
			assert try counter.add(2) == 2
			assert a.desk.total == 2
			assert b.desk.total == 0
			stopNode(a)
			stopNode(b)
		}

		@test()
		def TestForcedCallAboveFailAboveIsOverloaded() !none {
			let a = try startNode([], load = 9.0, refuseAbove = 1.0, forceAfter = 0, failAbove = 8.0)
			let b = try startNode([a.address], load = 0.0)
			assert eventually(def () bool {
				let held = a.registry.node()
				return !(held is none) && held.lessLoaded("std.services.ipc.link.Counter", 9.0).len() == 1
			})
			let counter = try counterAt(a.address, follow = true)
			let code = ""
			counter.add(1) onerror (err error) {
				code = err.code
				recover 0
			}
			assert code == "ipc.overloaded"
			stopNode(a)
			stopNode(b)
		}

		@test()
		def TestStaticAndDNSNodes() !none {
			let list = new StaticNodes(["10.0.0.1:7400"])
			try list.announce("x")
			assert (try list.nodes()).equals(["10.0.0.1:7400"])
			let named = new DNSNodes("localhost", port = 7400)
			let found = try named.nodes()
			assert found.len() > 0 && found[0].endsWith(":7400")
			let missing = new DNSNodes("localhost")
			assert missing.nodes() is error
		}
	}
}
