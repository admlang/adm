// The cluster layer's public surface: how
// nodes find each other, the settings of a cluster, and what a node knows of
// its members.
partial module std.services.ipc {
	use (
		std.net
		std.net.dns
	)

	// Finds some live nodes of a cluster, and records this node for the
	// others. Only introductions go through it: once in, nodes learn of each
	// other by talking, so a discovery that is unreachable for a while
	// disturbs nothing but a node starting then.
	interface Discovery {
		// Records this node, reachable at `address`, as a member. Called
		// when the node joins and again every `Cluster.announceEvery`, so a
		// record that expires stays while the node lives. Fails when the
		// record cannot be written.
		def announce(address string) !none

		// The addresses of nodes recorded as live, this node's perhaps among
		// them. Fails when the record cannot be read.
		def nodes() !string[]

		// Takes this node, recorded at `address`, out of the record. Fails
		// when the record cannot be written.
		def withdraw(address string) !none
	}

	// A fixed list of node addresses, as configuration gives them.
	type StaticNodes {
		addresses string[]

		def new(addresses string[]) {
			self.addresses = addresses
		}

		// Records nothing: the list is fixed. Does not fail.
		def announce(address string) !none {
			return none
		}

		// The addresses of the list. Does not fail.
		def nodes() !string[] {
			return addresses
		}

		// Records nothing. Does not fail.
		def withdraw(address string) !none {
			return none
		}
	}

	// The nodes a DNS name points at: the targets of its SRV records for
	// `serviceName` (`_serviceName._tcp.name`, each with its own port), or else the
	// name's addresses with `port`. The records are kept by whoever runs the
	// DNS (a Kubernetes headless service, a cloud's private zone).
	type DNSNodes {
		name        string
		port        int    = 0
		serviceName string = ""

		def new(name string, port int = 0, serviceName string = "") {
			self.name = name
			self.port = port
			self.serviceName = serviceName
		}

		// Records nothing: the DNS is kept elsewhere. Does not fail.
		def announce(address string) !none {
			return none
		}

		// The `host:port` of each SRV target when `serviceName` is set and the
		// name publishes them, else each address of the name with `port`.
		// Fails when the name does not resolve, or has no SRV records and no
		// port is set.
		def nodes() !string[] {
			if serviceName != "" {
				let targets = dns.serviceTargets(serviceName, "tcp", name)
				return targets when targets.len() > 0
			}
			fail "ipc: {name} has no SRV records for {serviceName}, and no port is set" when port <= 0
			let out string[] = []
			for let (_, address) in try net.resolve(name) {
				out.push(net.withPort(address, port))
			}
			return out
		}

		// Records nothing. Does not fail.
		def withdraw(address string) !none {
			return none
		}
	}

	// The settings of the cluster a node joins.
	struct Cluster {
		// The cluster's name; a node of another cluster is refused.
		name          string
		// This node's address as the other nodes and clients reach it: an
		// address it listens on, with the host name or IP others use.
		advertise     string
		discovery     Discovery
		// How this node proves itself to the others.
		auth          Auth          = Auth{}
		// Settings of this node's links to the others (TLS).
		link          Link          = Link{}
		// How often this node tells `fanout` others what it knows.
		gossipEvery   duration      = 1s
		fanout        int           = 2
		// How long a member may stay silent before it gets no new work, and
		// before it is dropped as dead.
		suspectAfter  duration      = 5s
		deadAfter     duration      = 30s
		// How often this node renews its record with `discovery`.
		announceEvery duration      = 10s
		// Load at which this node sends a call to a less busy member
		// instead of running it; 0 never does.
		refuseAbove   float         = 0.0
		// Members a client asks after a refusal before it insists on one.
		forceAfter    int           = 3
		// Load above which even an insisting call fails with
		// `IPCErrorKind.Overloaded`; 0 never does.
		failAbove     float         = 0.0
		// The load figure, in place of calls running plus the mean wait in
		// milliseconds before a call starts; every node must compute it alike.
		load          ?def () float = none
	}

	// Where a member stands in this node's view.
	enum MemberState {
		// It was heard from lately.
		Alive,
		// It has been silent longer than `suspectAfter`: it gets no new work.
		Suspect,
		// It said it was leaving.
		Left,
	}

	// A node of the cluster, as this node knows it.
	struct Member {
		address    string
		// The interfaces it provides, `module.Interface` each.
		interfaces string[]
		state      MemberState
		// Its load figure, and the parts of the default one.
		load       float
		running    int
		waitMs     float
		// True for this node.
		own        bool
	}
}
