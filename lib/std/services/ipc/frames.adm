// The protocol of a link: a preface
// from the client, then frames both ways, each `length(u32) type(u8) body`,
// little endian, the length counting the type and the body. Bodies are
// written with the wire module's Writer and read with its Reader.
internal partial module std.services.ipc.link {
	use (
		std.errors
		std.net
		std.services.ipc::*
		std.services.ipc.wire::(Reader, Writer)
	)

	// What a client sends first: "ADMIPC", a zero byte and the version.
	const prefaceText = "ADMIPC"
	const protocolVersion = 1

	// Frame types.
	const frameHello = 1
	const frameAuth = 2
	const frameWelcome = 3
	const frameRefuse = 4
	const frameCall = 5
	const frameResult = 6
	const frameFailure = 7
	const frameCancel = 8
	const frameCredit = 9
	const framePing = 10
	const framePong = 11
	const frameGoAway = 12
	const frameSeeOther = 13
	const frameLoad = 14
	const frameMembers = 15
	// Types from here up are skipped by a peer that does not know them;
	// below, an unknown type is a protocol error.
	const frameSkippable = 32

	// Bytes a frame's header takes ahead of its body: the length and the
	// type.
	const frameHeader = 5

	// Ways a client proves itself, as bits of `Hello` and kinds of `Auth`.
	const proofSecret = 1
	const proofToken = 2
	const proofCertificate = 4
	const proofUser = 8

	// How an interface fared in a `Welcome`.
	const interfaceAccepted = 0
	const interfaceDiffers = 1
	const interfaceMissing = 2

	// The label of the TLS exporter value a secret's proof covers, which ties
	// the proof to one connection.
	const exporterLabel = "EXPORTER-adm-ipc-auth"

	// One frame: its type and body.
	struct Frame {
		kind int
		body byte[]
	}

	// The failure of the link, with the kind that tells it apart.
	def linkError(kind IPCErrorKind, message string, address string = "") IPCError {
		return IPCError{message: "ipc: {message}", code: "ipc.{kind.str().lower()}", kind: kind, address: address}
	}

	// The bytes of the preface.
	def prefaceBytes() byte[] {
		let out = prefaceText.bytes()
		out.push(0)
		out.push(byte(protocolVersion))
		return out
	}

	// Reads the preface a client sends. Fails when it is something else or
	// another version.
	def readPreface(stream net.Stream, timeout duration) !none {
		let buf byte[]
		buf.len(prefaceText.len() + 2)
		try net.readFull(stream, buf, timeout)
		let want = prefaceBytes()
		for let i = 0; i < prefaceText.len() + 1; i++ {
			fail linkError(IPCErrorKind.Protocol, "the client does not speak this protocol") when buf[i] != want[i]
		}
		fail linkError(IPCErrorKind.Protocol, "the client speaks version {buf[prefaceText.len() + 1]}, this side {protocolVersion}") when int(buf[prefaceText.len() + 1]) != protocolVersion
		return none
	}

	// One frame as bytes: header and body.
	def frameBytes(kind int, body byte[]) byte[] {
		let out byte[]
		out.len(frameHeader + body.len())
		let size = uint32(body.len() + 1)
		out[0] = byte(size & 0xFF)
		out[1] = byte((size >> 8) & 0xFF)
		out[2] = byte((size >> 16) & 0xFF)
		out[3] = byte((size >> 24) & 0xFF)
		out[4] = byte(kind)
		for let i = 0; i < body.len(); i++ {
			out[frameHeader + i] = body[i]
		}
		return out
	}

	// Reads the next frame a peer sends, skipping the types from
	// `frameSkippable` up. A body longer than `maxFrame` (plus `slack` for
	// the frame's own fields), or an unknown type below `frameSkippable`, is a
	// protocol error. `timeout` bounds each read; 0 waits as long as it takes.
	def readFrame(stream net.Stream, maxFrame int, slack int, timeout duration) !Frame {
		for {
			let header byte[]
			header.len(frameHeader)
			try readAll(stream, header, timeout)
			let size = int(header[0]) | int(header[1]) << 8 | int(header[2]) << 16 | int(header[3]) << 24
			fail linkError(IPCErrorKind.Protocol, "a frame with no type") when size < 1
			let length = size - 1
			fail linkError(IPCErrorKind.Protocol, "a frame of {length} bytes, more than the {maxFrame} accepted") when length > maxFrame + slack
			let body byte[]
			body.len(length)
			try readAll(stream, body, timeout) when length > 0
			let kind = int(header[4])
			continue when kind >= frameSkippable
			fail linkError(IPCErrorKind.Protocol, "a frame of unknown type {kind}") when kind < frameHello || kind > frameMembers
			return Frame{kind: kind, body: body}
		}
	}

	// Fills buf from the stream; 0 waits as long as it takes. The end of
	// the stream fails as a lost link.
	def readAll(stream net.Stream, buf byte[], timeout duration) !none {
		let got = 0
		for got < buf.len() {
			let n = try stream.read(buf[got:], timeout == 0s ?? (8760h, timeout))
			fail linkError(IPCErrorKind.Lost, "the other side closed the connection") when n == 0
			got += n
		}
		return none
	}

	// The body of a `Hello`: the server's nonce, the proofs it accepts, how
	// many calls a connection may run and the largest frame it takes.
	struct Hello {
		nonce    byte[]
		proofs   int
		maxCalls int
		maxFrame int
	}

	def helloBytes(hello Hello) byte[] {
		let w = new Writer()
		w.putRaw(hello.nonce)
		w.putByte(byte(hello.proofs))
		w.putUint(uint64(hello.maxCalls))
		w.putUint(uint64(hello.maxFrame))
		return w.bytes()
	}

	def parseHello(body byte[]) !Hello {
		let r = new Reader(body)
		let nonce = r.readRaw(32)
		let proofs = int(r.readByte())
		let maxCalls = int(r.readUintOf(31))
		let maxFrame = int(r.readUintOf(31))
		try r.done()
		fail linkError(IPCErrorKind.Protocol, "the server grants no calls") when maxCalls < 1
		return Hello{nonce: nonce, proofs: proofs, maxCalls: maxCalls, maxFrame: maxFrame}
	}

	// An interface a client asks for: its name and the hash of its shape.
	struct Wanted {
		name string
		hash byte[]
	}

	// The body of an `Auth`: how the client proves itself, the largest frame
	// it takes, and the interfaces it will call.
	struct AuthFrame {
		kind     int
		proof    byte[]
		maxFrame int
		wanted   Wanted[]
	}

	def authBytes(auth AuthFrame) byte[] {
		let w = new Writer()
		w.putByte(byte(auth.kind))
		w.putBytes(auth.proof)
		w.putUint(uint64(auth.maxFrame))
		w.putCount(auth.wanted.len())
		for let (_, wanted) in auth.wanted {
			w.putString(wanted.name)
			w.putRaw(wanted.hash)
		}
		return w.bytes()
	}

	def parseAuth(body byte[]) !AuthFrame {
		let r = new Reader(body)
		let kind = int(r.readByte())
		let proof = r.readBytes()
		let maxFrame = int(r.readUintOf(31))
		let count = r.readCount(33)
		let wanted Wanted[] = []
		for let i = 0; i < count; i++ {
			let name = r.readString()
			wanted.push(Wanted{name: name, hash: r.readRaw(32)})
		}
		try r.done()
		return AuthFrame{kind: kind, proof: proof, maxFrame: maxFrame, wanted: wanted}
	}

	// How the server answers one interface of an `Auth`: accepted, provided
	// in another version (with the server's description), or not provided.
	struct Answer {
		status  int
		methods string[] = []
		types   string[] = []
	}

	def welcomeBytes(answers Answer[]) byte[] {
		let w = new Writer()
		w.putCount(answers.len())
		for let (_, answer) in answers {
			w.putByte(byte(answer.status))
			continue unless answer.status == interfaceDiffers
			w.putCount(answer.methods.len())
			for let (_, line) in answer.methods {
				w.putString(line)
			}
			w.putCount(answer.types.len())
			for let (_, line) in answer.types {
				w.putString(line)
			}
		}
		return w.bytes()
	}

	def parseWelcome(body byte[]) !Answer[] {
		let r = new Reader(body)
		let count = r.readCount()
		let answers Answer[] = []
		for let i = 0; i < count; i++ {
			let answer = Answer{status: int(r.readIndex(3))}
			if answer.status == interfaceDiffers {
				let methods = r.readCount()
				for let m = 0; m < methods; m++ {
					answer.methods.push(r.readString())
				}
				let types = r.readCount()
				for let t = 0; t < types; t++ {
					answer.types.push(r.readString())
				}
			}
			answers.push(answer)
		}
		try r.done()
		return answers
	}

	// The body of a `Refuse`: the kind of failure and why.
	def refuseBytes(kind IPCErrorKind, message string) byte[] {
		let w = new Writer()
		w.putUint(uint64(int(kind)))
		w.putString(message)
		return w.bytes()
	}

	def parseRefuse(body byte[], address string) IPCError {
		let r = new Reader(body)
		let kind = r.readUintOf(8)
		let message = r.readString()
		r.done() onerror recover none
		let known = kind == uint64(int(IPCErrorKind.Mismatch)) || kind == uint64(int(IPCErrorKind.Overloaded)) || kind == uint64(int(IPCErrorKind.Protocol))
		let errorKind = known ?? (IPCErrorKind(int(kind)), IPCErrorKind.Refused)
		return IPCError{message: message, code: "ipc.{errorKind.str().lower()}", kind: errorKind, address: address}
	}

	// Flags of a `Call`: run it whatever this node's load (the client
	// asked every other node already), and the load of the node that sent
	// the call on follows.
	const callForced = 1
	const callRefusedBefore = 2

	// The head of a `Call`: which call, interface and method, its flags, the
	// load of the node that refused it before (with `callRefusedBefore`), and
	// how long the caller waits (0 for no deadline). The arguments follow it.
	struct CallHead {
		id        int
		iface     int
		method    int
		flags     int
		previous  float = 0.0
		remaining int
	}

	def callBytes(head CallHead, arguments byte[]) byte[] {
		let w = new Writer()
		w.putUint(uint64(head.id))
		w.putUint(uint64(head.iface))
		w.putUint(uint64(head.method))
		w.putByte(byte(head.flags))
		w.putFloat(head.previous) when head.flags & callRefusedBefore != 0
		w.putUint(uint64(head.remaining))
		w.putRaw(arguments)
		return w.bytes()
	}

	// Reads the head of a `Call` and returns it with the reader left at the
	// arguments.
	def parseCall(r Reader) !CallHead {
		let head = CallHead{id: int(r.readUintOf(62)), iface: 0, method: 0, flags: 0, remaining: 0}
		head.iface = int(r.readUintOf(31))
		head.method = int(r.readUintOf(31))
		head.flags = int(r.readByte())
		head.previous = float(r.readFloat()) when head.flags & callRefusedBefore != 0
		head.remaining = int(r.readUintOf(62))
		try r.verify()
		return head
	}

	// The body of a `Result`: the call and its encoded result.
	def resultBytes(id int, value byte[]) byte[] {
		let w = new Writer()
		w.putUint(uint64(id))
		w.putRaw(value)
		return w.bytes()
	}

	// A failure as it crosses: the message and code of the error and of
	// each cause in turn.
	struct FailureLine {
		message string
		code    string
	}

	def failureBytes(id int, err error) byte[] {
		let w = new Writer()
		w.putUint(uint64(id))
		w.putString(err.message)
		w.putString(err.code)
		let causes FailureLine[] = []
		let cause = err.cause
		for causes.len() < 64 {
			let current = cause
			break when current is none
			causes.push(FailureLine{message: current.message, code: current.code})
			cause = current.cause
		}
		w.putCount(causes.len())
		for let (_, line) in causes {
			w.putString(line.message)
			w.putString(line.code)
		}
		return w.bytes()
	}

	// A failure the remote method returned, rebuilt on this side.
	struct RemoteFailure {
		message string
		code    string
		cause   ?error
		stack   errors.StackTrace
	}

	// Reads the failure after the call id, rebuilt with its causes.
	def parseFailure(r Reader) !error {
		let message = r.readString()
		let code = r.readString()
		let count = r.readCount(2)
		let lines FailureLine[] = []
		for let i = 0; i < count; i++ {
			let line = FailureLine{message: r.readString()}
			line.code = r.readString()
			lines.push(line)
		}
		try r.done()
		let cause ?error = none
		for let i = lines.len() - 1; i >= 0; i-- {
			cause = RemoteFailure{message: lines[i].message, code: lines[i].code, cause: cause}
		}
		return RemoteFailure{message: message, code: code, cause: cause}
	}

	// The body of a `SeeOther`: the refused call, the refusing node's load,
	// how many nodes the client asks before it insists, and the members to
	// ask, each with its load.
	struct Redirect {
		load       float
		forceAfter int
		candidates Candidate[]
	}

	def seeOtherBytes(id int, redirect Redirect) byte[] {
		let w = new Writer()
		w.putUint(uint64(id))
		w.putFloat(redirect.load)
		w.putUint(uint64(redirect.forceAfter))
		w.putCount(redirect.candidates.len())
		for let (_, candidate) in redirect.candidates {
			w.putString(candidate.address)
			w.putFloat(candidate.load)
		}
		return w.bytes()
	}

	// Reads a `SeeOther` body after its call id.
	def parseSeeOther(r Reader) !Redirect {
		let redirect = Redirect{load: float(r.readFloat()), forceAfter: int(r.readUintOf(16)), candidates: []}
		let count = r.readCount(9)
		for let i = 0; i < count; i++ {
			let address = r.readString()
			redirect.candidates.push(Candidate{address: address, load: float(r.readFloat())})
		}
		try r.done()
		return redirect
	}

	// The body of a `Members`: the sending node's own address, then the
	// other members a client may use, each with its load.
	def membersBytes(own string, members Candidate[]) byte[] {
		let w = new Writer()
		w.putString(own)
		w.putCount(members.len())
		for let (_, member) in members {
			w.putString(member.address)
			w.putFloat(member.load)
		}
		return w.bytes()
	}

	// Reads a `Members` body: the sender's address and the members.
	def parseMembers(body byte[]) !(string, Candidate[]) {
		let r = new Reader(body)
		let own = r.readString()
		let count = r.readCount(9)
		let out Candidate[] = []
		for let i = 0; i < count; i++ {
			let address = r.readString()
			out.push(Candidate{address: address, load: float(r.readFloat())})
		}
		try r.done()
		return (own, out)
	}

	// The body of a frame that holds one number: `Cancel`, `Credit`,
	// `GoAway`.
	def numberBytes(n int) byte[] {
		let w = new Writer()
		w.putUint(uint64(n))
		return w.bytes()
	}

	def parseNumber(body byte[]) !int {
		let r = new Reader(body)
		let n = int(r.readUintOf(62))
		try r.done()
		return n
	}
}
