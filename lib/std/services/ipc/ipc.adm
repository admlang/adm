partial module std.services.ipc {
	use (
		std.services::(Dependencies, Lifecycle, RestartMode, StartMode)
		std.services.network::(Network)
		std.services.ipc.link::(Pool, Proxied, Registry, Remote, currentCaller, describe, proxy, served)
		std.services.policy::(Endpoint, EndpointSpec, Policy)
		std.services.runtime::(Runtime)
		std.services.storage::(Storage)
		std.errors
		std.net.tls
		std.reflection
	)

	// Marks a type as the implementation of remote interface `I`: an instance
	// handed to `IPC.provide` answers the calls other processes make through
	// `IPC.connect<I>`. Only the methods `I` declares are served. A type may
	// carry the annotation once per interface.
	//
	// Every method of `I` must be errorable and not generic, and every type in
	// its signatures must be able to cross the wire; the build fails at the
	// annotation otherwise.
	//
	// Example: Serving an interface
	// ```example
	// @remote<Orders>
	// type Warehouse {
	//     def place(order Order) !Receipt { ... }
	// }
	//
	// try IPC.provide(new Warehouse())
	// try IPC.listen("0.0.0.0:7400", Listener{tls: config, secrets: [secret]})
	// ```
	meta def remote<I>(ctx reflection.DiscoveryMetaContext<reflection.TypeMetaContext>) {}

	// A type that chooses what of it crosses to another process: `toWire`
	// gives the value sent in its place, and `fromWire` fills an instance on
	// the other side from that value. Use it for a type whose fields are not
	// all meant to travel (a cache, a reading that means something only here),
	// or whose state is better sent in another form; a type whose fields are
	// its whole state is marked `@portable` instead. A type or struct with
	// these two methods crosses this way, whether or not it names the
	// interface; `W` is any type that can cross.
	//
	// `fromWire` is called on an instance made without running `new`, every
	// field holding its zero value. It fails when `wire` is not a valid state,
	// which fails the call the value arrived in.
	//
	// Example: Sending a reading without its cache
	// ```example
	// type Reading {
	//     celsius  float
	//     internal rendered ?string // rebuilt on demand
	//
	//     def toWire() float {
	//         return celsius
	//     }
	//
	//     def fromWire(wire float) !none {
	//         fail "below absolute zero" when wire < -273.15
	//         celsius = wire
	//     }
	// }
	// ```
	interface Portable<W> {
		// The value sent in place of this one.
		def toWire() W

		// Fills this instance from the value received. Fails when it is not
		// a valid state.
		def fromWire(wire W) !none
	}

	// Why a call or a connection failed on the way, as opposed to a failure the
	// remote method itself returned.
	enum IPCErrorKind {
		// No server could be reached.
		Unreachable,
		// The server refused the client: wrong secret, token or certificate, or
		// an address its lists do not allow.
		Refused,
		// The server provides another version of the interface, or none.
		Mismatch,
		// The deadline passed before the answer arrived.
		TimedOut,
		// The waiting task was cancelled.
		Canceled,
		// The link broke after the call was sent: it may have run.
		Lost,
		// The link was closed on this side while the call waited.
		Closed,
		// The other side sent something the protocol does not allow, or a value
		// too large or too deeply nested.
		Protocol,
		// The server is at its limit and takes no more calls.
		Overloaded,
	}

	// The payload of a failure of the link. A failure the remote method
	// returned arrives as that method's own `message` and `code` instead.
	struct IPCError {
		message string
		code    string
		cause   ?error
		stack   errors.StackTrace
		kind    IPCErrorKind
		// The server the failure concerns, empty when there is none.
		address string
	}

	// How a client proves itself to a server. Leave every field out for a
	// server that asks for no proof; set several when servers differ.
	struct Auth {
		// A secret both sides hold. It is never sent: the client answers the
		// server's challenge with it.
		secret ?Secret<string>
		// A token the server checks (`Listener.verifyToken`). Sent as is, so
		// only over TLS or a Unix socket.
		token  ?Secret<string>
	}

	// How a set of servers shares a client's calls.
	enum Balance {
		// Each call goes to the next server in turn.
		RoundRobin,
		// Each call goes to a server picked at random.
		Random,
		// Every call goes to the server that answered first; another is chosen
		// only when that one is lost.
		Pinned,
	}

	// Settings of a client's connection to the servers of one interface.
	struct Link {
		// TLS settings. None on a TCP address verifies the server against the
		// system roots and the address's host name; a client certificate goes
		// in `certificates`. None on a Unix socket means no TLS.
		tls            ?tls.Config
		// Turns TLS off on a TCP address.
		plain          bool        = false
		// How calls are shared when several addresses are given.
		balance        Balance     = Balance.RoundRobin
		// Connections kept open to each server.
		connections    int         = 1
		// Deadline of each call, measured from when it is made; 0 for none.
		timeout        duration    = 0s
		// How long connecting to one server may take.
		connectTimeout duration    = 10s
		// Idle time after which a ping checks the connection; a server that
		// does not answer within the same time is set aside.
		keepAlive      duration    = 15s
		// Largest message, in bytes, sent or accepted.
		maxFrame       int         = 16 * 1024 * 1024
		// Deepest nesting of a value sent or accepted.
		maxDepth       int         = 256
		// Learns the other nodes of a server's cluster and spreads calls
		// over them, and follows a node that sends a call to another.
		follow         bool        = true
	}

	// Settings of a listener: who may connect and how they prove themselves.
	struct Listener {
		// TLS settings with the server's certificate; required on a TCP
		// address unless `plain` is set. Client certificates are asked for
		// through `clientAuth` and `clientCAs`.
		tls         ?tls.Config
		// Turns TLS off on a TCP address.
		plain       bool                                = false
		// Shared secrets accepted; a client proves it holds one of them.
		secrets     Secret<string>[]                    = []
		// Checks a client's token and returns the identity it stands for;
		// fails to refuse it.
		verifyToken ?def (token Secret<string>) !string = none
		// User ids accepted on a Unix socket, read from the kernel; empty for
		// any user that can open the socket.
		users       int[]                               = []
		// Accepts clients that prove nothing on an address other machines can
		// reach. Without it `listen` refuses such a listener.
		open        bool                                = false
		// Addresses and CIDR ranges that may connect; empty for all.
		allow       string[]                            = []
		// Addresses and CIDR ranges that may not; wins over `allow`.
		deny        string[]                            = []
		// Calls one connection may have running at once; further calls wait
		// on the client.
		maxCalls    int                                 = 1024
		// Largest message, in bytes, sent or accepted.
		maxFrame    int                                 = 16 * 1024 * 1024
		// Deepest nesting of a value sent or accepted.
		maxDepth    int                                 = 256
	}

	// Who is calling a served method.
	struct Caller {
		// The client's address.
		address  string
		// Who the client proved to be: a certificate's subject, what
		// `verifyToken` returned, `"secret"` for a shared secret, the user id
		// on a Unix socket; empty when nothing was asked.
		identity string
		// The interface and method being called, as `module.Interface.method`.
		method   string
	}

	// One open connection, as `IPC.links` reports it.
	struct LinkInfo {
		// The interface the connection carries, as `module.Interface`.
		name     string
		// The server's address.
		address  string
		// True for a connection this process accepted.
		accepted bool
		// Calls waiting for their answer.
		inFlight int
	}

	// Connects processes, on one machine or several: a program calls the
	// methods of an interface and another process runs them.
	//
	// The interface and the types in its signatures live in a library both
	// programs import. The serving process marks a type `@remote<I>` and
	// passes an instance to `provide`; the calling process gets its own value
	// of `I` from `connect<I>`.
	service IPC {
		description  = "Remote interfaces between processes"
		dependencies = Dependencies{
			hard: [Runtime, Policy, Network, Storage]
		}
		lifecycle    = Lifecycle{
			start: StartMode.Manual,
			restart: RestartMode.Always,
		}
		permissions  = [
			Permission{name: "connect", description: "Call interfaces other processes provide", spec: EndpointSpec},
			Permission{name: "listen", description: "Provide interfaces to other processes", spec: EndpointSpec},
		]

		// The interfaces provided, the listeners and the pools `connect`
		// made.
		registry Registry = new Registry()

		// Applies the service's settings. There are none, and it does not fail.
		def config<T>(val T) !none {}

		// Starts the service. Does not fail.
		async def start() !none {
			return none
		}

		// Stops the service: closes every listener and every connection. Calls
		// in flight fail with `IPCErrorKind.Closed`.
		async def stop() !none {
			shutDown()
			return none
		}

		// Stops the service and starts it again. Listeners and connections do
		// not come back.
		async def restart() !none {
			shutDown()
			return none
		}

		def shutDown() {
			registry.leave() onerror recover none
			let (listeners, pools) = registry.takeAll()
			for let (_, listener) in listeners {
				listener.close()
			}
			for let (_, pool) in pools {
				pool.close()
			}
		}

		// Serves `instance` to other processes, for every interface its type
		// is marked `@remote` for, on every listener open now or later. Its
		// methods are called from many tasks at once. Fails when another
		// instance already serves one of those interfaces.
		@commit()
		def provide<T>(instance T) !none {
			let owner any = instance
			return try registry.catalog.add(served<T>(instance), owner)
		}

		// Stops serving `instance`. Calls already running finish; new ones are
		// answered as if the interface was never provided. Fails when it is not
		// provided.
		@commit()
		def withdraw<T>(instance T) !none {
			let owner any = instance
			return try registry.catalog.remove(owner)
		}

		// Starts accepting clients on `address`: `host:port`, `[v6]:port` or
		// `unix:/path`. Returns the address bound, with the port the system
		// chose for port 0. Fails when the address cannot be bound, when a TCP
		// address has neither a TLS certificate nor `plain`, or when the
		// listener asks clients for no proof on an address other machines can
		// reach and `open` is not set.
		@commit(policy = "listen")
		def listen(address Endpoint, options Listener = Listener{}) !string {
			return try registry.listen(address.value(), options)
		}

		// Stops accepting clients on `address` and closes its connections once
		// their running calls finish. Fails when nothing listens there.
		@query()
		def close(address string) !none {
			let listener = try registry.release(address)
			listener.close()
			return none
		}

		// Returns an `I` whose methods run in the process at `address`. Fails
		// with an `IPCError`: `Unreachable` when the server cannot be reached,
		// `Refused` when it does not accept `auth`, `Mismatch` when it
		// provides no `I`, or a version this program cannot call (the message
		// names the first method it lacks or type it declares otherwise). A
		// newer version that keeps every method and type this program uses
		// is called as it is.
		@query(policy = "connect")
		def connect<I>(address Endpoint, auth Auth = Auth{}, options Link = Link{}) !I {
			return try open<I>([address.value()], auth, options)
		}

		// Returns an `I` served by several processes; `options.balance` decides
		// which one takes each call. Succeeds when one server accepts. Fails
		// with an `IPCError`: `Unreachable` when none can be reached, `Refused`
		// or `Mismatch` when a reachable one refuses the client or provides a
		// version of `I` this program cannot call.
		@query(policy = "connect")
		def connect<I>(addresses string[], auth Auth = Auth{}, options Link = Link{}) !I {
			// Each address is checked against the endpoint rules, as the one
			// of the single-address overload is.
			for let (_, address) in addresses {
				try __policy_validate("adm.ipc.connect", "std.services.policy.EndpointSpec", address)
			}
			return try open<I>(addresses, auth, options)
		}

		// Connects a pool to the servers and returns its `I`.
		def open<I>(addresses string[], auth Auth, options Link) !I {
			let info = describe<I>()
			let pool = new Pool(info, addresses, auth, options)
			try pool.start()
			registry.remember(pool)
			return proxy<I>(new Remote(info, pool, options.maxDepth))
		}

		// Closes the connections behind a value `connect` returned. Calls in
		// flight fail with `IPCErrorKind.Closed`. Fails when `client` did not
		// come from `connect`.
		@query()
		def disconnect<I>(client I) !none {
			// A proxy is a Proxied whatever I is.
			match client {
				case Proxied:
					client.ipcRemote().calls.close()
					return none
			}
			fail "ipc: the value did not come from IPC.connect"
		}

		// Who is calling, inside a method a client called; none anywhere else.
		@query()
		def caller() ?Caller {
			return currentCaller()
		}

		// The connections open now, accepted and made.
		@query()
		def links() LinkInfo[] {
			let (listeners, pools) = registry.snapshot()
			let out LinkInfo[] = []
			for let (_, pool) in pools {
				out.push(...pool.links())
			}
			for let (_, listener) in listeners {
				out.push(...listener.links())
			}
			return out
		}

		// Makes this process a node of a cluster:
		// it serves gossip on its listeners, announces itself to
		// `cluster.discovery`, learns the other members from the nodes it
		// finds, and from then on tells its clients of them and, above
		// `refuseAbove`, sends calls to less busy ones. Listen first: the
		// other nodes reach this one at `cluster.advertise`. Fails when this
		// process is a node already, or when discovery cannot record it.
		@query(policy = "connect")
		def join(cluster Cluster) !none {
			let joinedBy = def (member Member) {
				joined(member)
			}
			let leftBy = def (member Member) {
				left(member)
			}
			try registry.join(cluster, joinedBy, leftBy)
			return none
		}

		// Leaves the cluster: the other members are told, discovery forgets
		// this node, and gossip is no longer served. Fails when this process
		// is in no cluster.
		@query()
		def leave() !none {
			return try registry.leave()
		}

		// The members of the cluster as this node knows them, itself first;
		// empty outside a cluster.
		@query()
		def members() Member[] {
			let node = registry.node()
			return [] when node is none
			return node.members()
		}

		// A member became alive in this node's view: it joined, or came back.
		@emit()
		def joined(member Member) Member {
			return member
		}

		// A member left the cluster, or was silent too long.
		@emit()
		def left(member Member) Member {
			return member
		}

		// The addresses being listened on.
		@query()
		def listeners() string[] {
			let (listeners, _) = registry.snapshot()
			let out string[] = []
			for let (_, open) in listeners {
				out.push(open.address)
			}
			return out
		}
	}
}
