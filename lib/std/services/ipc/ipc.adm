partial module std.services.ipc {
	use (
		std.services::(Dependencies, Lifecycle, RestartMode, StartMode)
		std.services.policy::(Policy)
		std.services.runtime::(Runtime)
	)

	// Talks to other processes on the same machine.
	//
	// Not implemented yet.
	service IPC {
		description               = ""
		dependencies              = Dependencies{
			hard: [Runtime, Policy]
		}
		lifecycle                 = Lifecycle{
			start: StartMode.Manual,
			restart: RestartMode.Always,
		}
		permissions  Permission[]

		// Applies the service's settings. There are none yet, and it does not fail.
		def config<T>(val T) !none {}

		// Starts the service. Does not fail today.
		async def start() !none {
			return none
		}

		// Stops the service. Does not fail today.
		async def stop() !none {
			return none
		}

		// Stops the service and starts it again. Does not fail today.
		async def restart() !none {
			return none
		}
	}
}
