// The IPC service's IDE panel: the program's links to other processes, the
// addresses it listens on and the cluster's members, and the buttons that
// stop listening and leave the cluster.

partial module std.services.ipc {
	use std.ide::(ide, IdeKind, IdeTable)

	partial service IPC {
		@ide(kind = IdeKind.Table, label = "Links", refresh = 1s, rows = 6)
		def ideLinks() IdeTable {
			let rows = string[][]
			for let (_, link) in links() {
				rows.push([link.name, link.address, link.accepted ?? ("accepted", "dialled"), "{link.inFlight}"])
			}
			return IdeTable{columns: ["Interface", "Address", "Side", "In flight"], rows: rows}
		}

		@ide(kind = IdeKind.Table, label = "Listening", refresh = 2s, rows = 4)
		def ideListeners() IdeTable {
			let rows = string[][]
			for let (_, address) in listeners() {
				rows.push([address])
			}
			return IdeTable{columns: ["Address"], rows: rows}
		}

		@ide(kind = IdeKind.Table, label = "Cluster", refresh = 2s, rows = 6)
		def ideMembers() IdeTable {
			let rows = string[][]
			for let (_, member) in members() {
				rows.push([member.address, member.state.name, "{member.load}", member.interfaces.join(", ")])
			}
			return IdeTable{columns: ["Member", "State", "Load", "Interfaces"], rows: rows}
		}

		@ide(kind = IdeKind.Action, label = "Stop listening", confirm = "Stop listening on this address?", row = "ideListeners.Address")
		def ideClose(address string) !none {
			return close(address)
		}

		@ide(kind = IdeKind.Action, label = "Leave cluster", confirm = "Leave the cluster?")
		def ideLeave() !none {
			return leave()
		}
	}
}
