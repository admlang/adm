partial module std.services.ipc {
	use (
		std.crypto
		std.crypto::(generateECDSAKey, p256)
		std.crypto.x509
		std.errors
		std.net
		std.net.tls
		std.os
		std.services.ipc.link
		std.testing
		std.time
	)

	struct Item {
		name     string
		quantity int
	}

	// A failure the desk reports with a code and a cause.
	struct DeskError {
		message string
		code    string
		cause   ?error
		stack   errors.StackTrace
	}

	interface Desk {
		def place(item Item) !int
		def who() !string
		def slow(ms int) !int
		def refuse(code string) !none
		def measure(data byte[]) !int
	}

	interface Absent {
		def ping() !none
	}

	@remote<Desk>
	type Clerk {
		placed   int = 0
		canceled int = 0
		running  int = 0
		busiest  int = 0

		def place(item Item) !int {
			fail "quantity must be positive" when item.quantity <= 0
			return add(item.quantity)
		}

		atomic def add(quantity int) int {
			placed += quantity
			return placed
		}

		def who() !string {
			let caller = IPC.caller()
			return "" when caller is none
			return "{caller.identity}|{caller.method}"
		}

		def slow(ms int) !int {
			enter()
			time.sleep((1ms).scale(float(ms)))
			leave(canceled())
			return ms
		}

		atomic def enter() {
			running += 1
			busiest = running when running > busiest
		}

		atomic def leave(wasCanceled bool) {
			running -= 1
			canceled += 1 when wasCanceled
		}

		def refuse(code string) !none {
			fail DeskError{message: "refused", code: code, cause: DeskError{message: "the shelf is empty", code: "shelf.empty"}}
		}

		def measure(data byte[]) !int {
			return data.len()
		}
	}

	// The IPCError kind a failure carries, "" for any other failure.
	def kindText(err error) string {
		return err.kind.str() when err is IPCError
		return ""
	}

	// How a call fails: its IPCError kind, or "" when it succeeds, "other"
	// when it fails with something else.
	def failureOf(outcome !int) string {
		if outcome is error {
			let kind = kindText(outcome)
			return "other" when kind == ""
			return kind
		}
		return ""
	}

	// A certificate for `name` and 127.0.0.1, signed by its own key.
	def selfSigned(name string) !tls.KeyPair {
		let key = try generateECDSAKey(p256)
		let template = x509.Template{dnsNames: [name], ipAddresses: [byte[127, 0, 0, 1]]}
		template.subject.commonName = name
		let der = try x509.createCertificate(template, crypto.publicKeyOf(key), none, key)
		return new tls.KeyPair([der], key, try x509.parseCertificate(der))
	}

	// A pool that trusts the certificate of `pair`.
	def trusting(pair tls.KeyPair) x509.CertPool {
		let pool = new x509.CertPool()
		let leaf = pair.leaf
		pool.addCert(leaf) unless leaf is none
		return pool
	}

	// A scratch path for a Unix socket.
	def socketPath(name string) string {
		return "/tmp/adm-ipc-{name}-{time.now().unixNs()}.sock"
	}

	// The user id this process runs as, read from a Unix socket connected
	// to itself.
	def ownUserId() !int {
		let path = socketPath("uid")
		let sock = try net.socket(net.SocketDomain.Unix, net.SocketType.Stream)
		try sock.bind(path)
		let ln = try sock.listen(1)
		let dialed = async net.dialStream(path, 5s)
		let accepted = try ln.accept()
		let other = try await dialed
		let uid = try accepted.peerUserId()
		other.close() onerror recover none
		accepted.close() onerror recover none
		ln.close() onerror recover none
		os.remove(path) onerror recover none
		return uid
	}

	// The secret both ends of the suites hold.
	def secret() Secret<string> {
		return new Secret<string>("open sesame")
	}

	// Connects to a desk on a plain listener with the suites' secret.
	def plainDesk(address string, options Link = Link{plain: true}) !Desk {
		return try IPC.connect<Desk>(address, Auth{secret: secret()}, options)
	}

	// Listens on a plain loopback address asking for the suites' secret.
	def plainListener(options Listener = Listener{plain: true, secrets: [secret()]}) !string {
		return try IPC.listen("127.0.0.1:0", options)
	}

	// Calls `place` once on a desk of its own and drops it.
	def placeOnce(address string) !int {
		let desk = try plainDesk(address)
		return try desk.place(Item{name: "lamp", quantity: 1})
	}

	internal let joinedMembers = new channel<string>(64)
	internal let leftMembers = new channel<string>(64)

	@on(IPC.joined)
	internal def onJoined(evt Event<Member>) {
		joinedMembers.offer(evt.result.address)
	}

	@on(IPC.left)
	internal def onLeft(evt Event<Member>) {
		leftMembers.offer(evt.result.address)
	}

	// Waits up to two seconds for a value on `from`.
	def nextOn(from channel<string>) string {
		let sleep = time.sleepChan(2s)
		let got = ""
		select {
			case from:
				got = <-from
			case sleep:
		}
		return got
	}

	check "IPC service" {
		testing.beforeEach(def () {
			await IPC.start() onerror recover none
		})

		testing.afterEach(def () {
			await IPC.stop() onerror recover none
		})

		@test()
		def TestCallsOverPlainTCPWithASecret() !none {
			let clerk = new Clerk()
			try IPC.provide(clerk)
			let address = try plainListener()
			assert address.startsWith("127.0.0.1:")
			assert IPC.listeners().equals([address])
			let desk = try plainDesk(address)
			assert try desk.place(Item{name: "lamp", quantity: 2}) == 2
			assert try desk.place(Item{name: "desk", quantity: 3}) == 5
			assert clerk.placed == 5
			assert try desk.who() == "secret|std.services.ipc.Desk.who"
			assert try desk.measure(byte[1, 2, 3]) == 3
			let links = IPC.links()
			assert links.len() == 2
			assert links.filter(l => l.accepted).len() == 1
			assert links[0].name == "std.services.ipc.Desk"
			assert IPC.caller() is none
			// The desk is used after the links are read: a value is dropped
			// at its last use, and its links close with it.
			assert try desk.place(Item{name: "lamp", quantity: 1}) == 6
		}

		@test()
		def TestFailuresCrossWithCodeAndCauses() !none {
			try IPC.provide(new Clerk())
			let desk = try plainDesk(try plainListener())
			let message = ""
			let code = ""
			let cause = ""
			desk.refuse("desk.closed") onerror (err error) {
				message = err.message
				code = err.code
				let inner = err.cause
				cause = inner is none ?? ("", "{inner.message}/{inner.code}")
				recover none
			}
			assert message == "refused"
			assert code == "desk.closed"
			assert cause == "the shelf is empty/shelf.empty"
			let refused = ""
			desk.place(Item{name: "lamp", quantity: 0}) onerror (err error) {
				refused = err.message
				recover 0
			}
			assert refused == "quantity must be positive"
		}

		@test()
		def TestWrongSecretIsRefused() !none {
			try IPC.provide(new Clerk())
			let address = try plainListener()
			let kind = ""
			IPC.connect<Desk>(address, Auth{secret: new Secret<string>("wrong")}, Link{plain: true}) onerror (err error) {
				kind = kindText(err)
				recover new Clerk()
			}
			assert kind == "Refused"
			IPC.connect<Desk>(address, Auth{}, Link{plain: true}) onerror (err error) {
				kind = kindText(err)
				recover new Clerk()
			}
			assert kind == "Refused"
		}

		@test()
		def TestListenerWithoutProofNeedsOpen() !none {
			let refused = ""
			IPC.listen("0.0.0.0:0", Listener{plain: true}) onerror (err error) {
				refused = err.message
				recover ""
			}
			assert refused.contains("asks clients for no proof")
			let tlsless = ""
			IPC.listen("127.0.0.1:0", Listener{}) onerror (err error) {
				tlsless = err.message
				recover ""
			}
			assert tlsless.contains("needs a certificate")
			try IPC.provide(new Clerk())
			let address = try IPC.listen("0.0.0.0:0", Listener{plain: true, open: true})
			let port = address.split(":").last()
			fail "no port in {address}" when port is none
			let desk = try IPC.connect<Desk>("127.0.0.1:{port}", Auth{}, Link{plain: true})
			assert try desk.who() == "|std.services.ipc.Desk.who"
		}

		@test()
		def TestInterfaceNotProvidedIsAMismatch() !none {
			try IPC.provide(new Clerk())
			let address = try plainListener()
			let message = ""
			let kind = ""
			IPC.connect<Absent>(address, Auth{secret: secret()}, Link{plain: true}) onerror (err error) {
				kind = kindText(err)
				message = err.message
				recover new Missing()
			}
			assert kind == "Mismatch"
			assert message.contains("does not provide std.services.ipc.Absent")
		}

		@test()
		def TestProvideOnceAndWithdraw() !none {
			let clerk = new Clerk()
			try IPC.provide(clerk)
			let twice = ""
			IPC.provide(new Clerk()) onerror (err error) {
				twice = err.message
				recover none
			}
			assert twice.contains("already provided")
			let address = try plainListener()
			let desk = try plainDesk(address)
			try IPC.withdraw(clerk)
			let after = ""
			desk.place(Item{name: "lamp", quantity: 1}) onerror (err error) {
				after = err.message
				recover 0
			}
			assert after.contains("no longer provided")
			let again = ""
			IPC.withdraw(clerk) onerror (err error) {
				again = err.message
				recover none
			}
			assert again.contains("not provided")
		}

		@test()
		def TestTLSWithATokenNamesTheCaller() !none {
			let pair = try selfSigned("localhost")
			try IPC.provide(new Clerk())
			let verify = def (token Secret<string>) !string {
				fail "unknown token" unless token.reveal() == "t-123"
				return "user-7"
			}
			let address = try IPC.listen("127.0.0.1:0", Listener{tls: tls.Config{certificates: [pair]}, verifyToken: verify})
			let link = Link{tls: tls.Config{serverName: "localhost", rootCAs: trusting(pair)}}
			let desk = try IPC.connect<Desk>(address, Auth{token: new Secret<string>("t-123")}, link)
			assert try desk.who() == "user-7|std.services.ipc.Desk.who"
			let kind = ""
			IPC.connect<Desk>(address, Auth{token: new Secret<string>("t-999")}, link) onerror (err error) {
				kind = kindText(err)
				recover new Clerk()
			}
			assert kind == "Refused"
			let untrusted = ""
			IPC.connect<Desk>(address, Auth{token: new Secret<string>("t-123")}, Link{tls: tls.Config{serverName: "localhost"}}) onerror (err error) {
				untrusted = kindText(err)
				recover new Clerk()
			}
			assert untrusted == "Refused"
		}

		@test()
		def TestSecretOverTLS() !none {
			let pair = try selfSigned("localhost")
			try IPC.provide(new Clerk())
			let address = try IPC.listen("127.0.0.1:0", Listener{tls: tls.Config{certificates: [pair]}, secrets: [new Secret<string>("old"), secret()]})
			let desk = try IPC.connect<Desk>(address, Auth{secret: secret()}, Link{tls: tls.Config{serverName: "localhost", rootCAs: trusting(pair)}})
			assert try desk.who() == "secret|std.services.ipc.Desk.who"
		}

		@test()
		def TestTokenIsNotSentOverPlainTCP() !none {
			try IPC.provide(new Clerk())
			let verify = def (token Secret<string>) !string {
				return "anyone"
			}
			let address = try IPC.listen("127.0.0.1:0", Listener{plain: true, verifyToken: verify})
			let message = ""
			IPC.connect<Desk>(address, Auth{token: new Secret<string>("t")}, Link{plain: true}) onerror (err error) {
				message = err.message
				recover new Clerk()
			}
			assert message.contains("only over TLS")
		}

		@test()
		def TestClientCertificateIsTheIdentity() !none {
			let server = try selfSigned("localhost")
			let client = try selfSigned("desk-client")
			try IPC.provide(new Clerk())
			let config = tls.Config{certificates: [server], clientAuth: tls.ClientAuthType.RequireAndVerifyClientCert, clientCAs: trusting(client)}
			let address = try IPC.listen("127.0.0.1:0", Listener{tls: config})
			let desk = try IPC.connect<Desk>(address, Auth{}, Link{tls: tls.Config{serverName: "localhost", rootCAs: trusting(server), certificates: [client]}})
			let who = try desk.who()
			assert who.contains("desk-client")
			let kind = ""
			IPC.connect<Desk>(address, Auth{}, Link{tls: tls.Config{serverName: "localhost", rootCAs: trusting(server)}}) onerror (err error) {
				kind = kindText(err)
				recover new Clerk()
			}
			assert kind != ""
		}

		@test()
		def TestUnixSocketChecksTheUser() !none {
			let uid = try ownUserId()
			try IPC.provide(new Clerk())
			let path = socketPath("desk")
			let address = try IPC.listen("unix:{path}", Listener{users: [uid]})
			assert address == "unix:{path}"
			let desk = try IPC.connect<Desk>(address)
			assert try desk.who() == "{uid}|std.services.ipc.Desk.who"
			try IPC.close(address)
			let strict = socketPath("strict")
			let other = try IPC.listen("unix:{strict}", Listener{users: [uid + 1]})
			let kind = ""
			IPC.connect<Desk>(other) onerror (err error) {
				kind = kindText(err)
				recover new Clerk()
			}
			assert kind == "Refused"
		}

		@test()
		def TestDeadlineCancelsTheServerCall() !none {
			let clerk = new Clerk()
			try IPC.provide(clerk)
			let desk = try plainDesk(try plainListener(), Link{plain: true, timeout: 100ms})
			assert failureOf(desk.slow(3000)) == "TimedOut"
			for let i = 0; i < 50 && clerk.canceled == 0; i++ {
				time.sleep(20ms)
			}
			assert clerk.canceled == 1
			assert try desk.slow(1) == 1
		}

		@test()
		def TestCancelingTheCallerCancelsTheServerCall() !none {
			let clerk = new Clerk()
			try IPC.provide(clerk)
			let desk = try plainDesk(try plainListener())
			let job = async desk.slow(3000)
			for let i = 0; i < 50 && clerk.running == 0; i++ {
				time.sleep(10ms)
			}
			job.cancel("stop")
			let outcome = await job
			assert outcome is error
			for let i = 0; i < 50 && clerk.canceled == 0; i++ {
				time.sleep(20ms)
			}
			assert clerk.canceled == 1
		}

		@test()
		def TestCallsWaitForTheServersGrant() !none {
			let clerk = new Clerk()
			try IPC.provide(clerk)
			let desk = try plainDesk(try plainListener(Listener{plain: true, secrets: [secret()], maxCalls: 1}))
			let first = async desk.slow(150)
			let second = async desk.slow(150)
			assert (try await first) == 150
			assert (try await second) == 150
			assert clerk.busiest == 1
		}

		@test()
		def TestLargeCallFailsBeforeItIsSent() !none {
			try IPC.provide(new Clerk())
			let desk = try plainDesk(try plainListener(Listener{plain: true, secrets: [secret()], maxFrame: 1024}))
			let big byte[]
			big.len(4096)
			assert failureOf(desk.measure(big)) == "Protocol"
			assert try desk.measure(byte[1, 2]) == 2
		}

		@test()
		def TestSeveralServersShareTheCalls() !none {
			let clerk = new Clerk()
			try IPC.provide(clerk)
			let first = try plainListener()
			let second = try plainListener()
			let desk = try IPC.connect<Desk>([first, second], Auth{secret: secret()}, Link{plain: true})
			let made = IPC.links().filter(l => !l.accepted)
			assert made.len() == 2
			for let i = 0; i < 4; i++ {
				try desk.place(Item{name: "lamp", quantity: 1})
			}
			assert clerk.placed == 4
			try IPC.close(first)
			for let i = 0; i < 4; i++ {
				try desk.place(Item{name: "lamp", quantity: 1})
			}
			assert clerk.placed == 8
			try IPC.close(second)
			let failed = failureOf(desk.place(Item{name: "lamp", quantity: 1}))
			assert failed == "Unreachable" || failed == "Closed" || failed == "Lost"
		}

		@test()
		def TestUnreachableServer() !none {
			let kind = ""
			IPC.connect<Desk>("127.0.0.1:1", Auth{}, Link{plain: true, connectTimeout: 2s}) onerror (err error) {
				kind = kindText(err)
				recover new Clerk()
			}
			assert kind == "Unreachable"
		}

		@test()
		def TestClosingAListenerLetsRunningCallsFinish() !none {
			try IPC.provide(new Clerk())
			let address = try plainListener()
			let desk = try plainDesk(address)
			let job = async desk.slow(300)
			time.sleep(50ms)
			try IPC.close(address)
			assert (try await job) == 300
			assert IPC.listeners().len() == 0
			let missing = ""
			IPC.close(address) onerror (err error) {
				missing = err.message
				recover none
			}
			assert missing.contains("nothing listens")
		}

		@test()
		def TestDisconnectClosesTheLink() !none {
			let clerk = new Clerk()
			try IPC.provide(clerk)
			let desk = try plainDesk(try plainListener())
			assert try desk.place(Item{name: "lamp", quantity: 1}) == 1
			try IPC.disconnect(desk)
			assert failureOf(desk.place(Item{name: "lamp", quantity: 1})) == "Closed"
			let local Desk = clerk
			let refused = ""
			IPC.disconnect(local) onerror (err error) {
				refused = err.message
				recover none
			}
			assert refused.contains("did not come from IPC.connect")
		}

		@test()
		def TestDroppedClientClosesItsLinks() !none {
			try IPC.provide(new Clerk())
			let address = try plainListener()
			assert try placeOnce(address) == 1
			assert IPC.links().filter(l => !l.accepted).len() == 0
			for let i = 0; i < 50 && IPC.links().len() > 0; i++ {
				time.sleep(20ms)
			}
			assert IPC.links().len() == 0
		}

		@test()
		def TestJoinAClusterAndLeave() !none {
			joinedMembers.flush()
			leftMembers.flush()
			try IPC.provide(new Clerk())
			let first = try plainListener()
			// A second node in this process: its own registry and listener.
			let other = new link.Registry()
			let otherAddress = try other.listen("127.0.0.1:0", Listener{plain: true})
			let quiet = def (member Member) {}
			try other.join(Cluster{name: "shop", advertise: otherAddress, discovery: new StaticNodes([otherAddress]), auth: Auth{secret: secret()}, link: Link{plain: true}, gossipEvery: 50ms}, quiet, quiet)
			try IPC.join(Cluster{name: "shop", advertise: first, discovery: new StaticNodes([first, otherAddress]), link: Link{plain: true}, gossipEvery: 50ms})
			assert nextOn(joinedMembers) == otherAddress
			let members = IPC.members()
			assert members.len() == 2
			assert members[0].own && members[0].address == first
			assert members[0].interfaces.includes("std.services.ipc.Desk")
			let twice = ""
			IPC.join(Cluster{name: "shop", advertise: first, discovery: new StaticNodes([first])}) onerror (err error) {
				twice = err.message
				recover none
			}
			assert twice.contains("already")
			try other.leave()
			assert nextOn(leftMembers) == otherAddress
			try IPC.leave()
			assert IPC.members().len() == 0
			assert IPC.leave() is error
			let (listeners, _) = other.takeAll()
			for let (_, listener) in listeners {
				listener.close()
			}
		}

		@test()
		def TestIdleLinkStaysOpen() !none {
			try IPC.provide(new Clerk())
			let desk = try plainDesk(try plainListener(), Link{plain: true, keepAlive: 50ms})
			time.sleep(300ms)
			assert try desk.place(Item{name: "lamp", quantity: 1}) == 1
		}
	}

	// A local Absent, to have a value where a connect fails.
	type Missing {
		def ping() !none {
			return none
		}
	}
}
