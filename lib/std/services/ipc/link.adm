// Calls of a remote interface, as values: what a client sends for each
// method and what a server runs for it, whatever carries the bytes between
// them (a socket, or a pair of objects in one process in the suites).
//
// The compiler writes the bodies of `proxy<I>`, `dispatch<I>`, `describe<I>`
// and `served<T>` for each type they are used with
// (internal/irgen/ipc_intrinsics.go), as a straight run of calls to the other
// functions of this file. Their names and parameters are what that code
// calls: change both together.
internal partial module std.services.ipc.link {
	use (
		std.services.ipc::*
		std.services.ipc.wire::(Reader, Writer, decode, encode)
	)

	// A remote interface as both sides know it: its name, the hash of its
	// whole shape, and its methods in the order calls number them.
	struct InterfaceInfo {
		// `module.Interface`, with its type arguments when it is generic.
		name    string
		// SHA-256 over the name, the method signatures and the shape of every
		// type they reach, in hex: equal on both sides when they were compiled
		// from the same declarations.
		hash    string
		// Each method as `name(parameters)->result`, with qualified type
		// names; a call's method number is its place here.
		methods string[]
		// The shape of each type the signatures reach, one line each, sorted:
		// what tells a client which type differs from the server's.
		types   string[]
	}

	// Builds the description `describe<I>` returns from the lines the
	// compiler wrote, newline-separated.
	def interfaceInfo(name string, hash string, methods string, types string) InterfaceInfo {
		return InterfaceInfo{
			name:    name,
			hash:    hash,
			methods: methods == "" ?? ([], methods.split("\n")),
			types:   types == "" ?? ([], types.split("\n")),
		}
	}

	// Carries the calls of a client to the process that runs them.
	interface Calls {
		// Sends one call of method number `method` with the encoded arguments
		// and returns the encoded result. Fails with the failure the remote
		// method returned, or with an `IPCError` when the call did not
		// complete.
		def call(method int, arguments byte[]) !byte[]

		// Closes what carries the calls; calls in flight fail with
		// `IPCErrorKind.Closed`.
		def close()

		// The connections open now.
		def links() LinkInfo[]
	}

	// What the value `proxy<I>` makes has besides the methods of `I`: the
	// `Remote` its calls go through. The compiler gives every proxy this
	// method; nothing else should declare it.
	interface Proxied {
		def ipcRemote() Remote
	}

	// The client end of one remote interface: what the methods of the value
	// `IPC.connect` returns send their calls through.
	type Remote {
		info     InterfaceInfo
		calls    Calls
		maxDepth int           = 256

		def new(info InterfaceInfo, calls Calls, maxDepth int = 256) {
			self.info = info
			self.calls = calls
			self.maxDepth = maxDepth
		}
	}

	// Starts the arguments of a call through `remote`.
	def beginCall(remote Remote) Writer {
		return new Writer(remote.maxDepth)
	}

	// Sends the call whose arguments `arguments` holds and reads its result
	// as `R`. Fails when an argument cannot cross, with the remote method's
	// failure, or with an `IPCError` from the link.
	def finishCall<R>(remote Remote, method int, arguments Writer) !R {
		try arguments.verify()
		let answer = try remote.calls.call(method, arguments.bytes())
		let reader = new Reader(answer, remote.maxDepth)
		let value = decode<R>(reader)
		try reader.done()
		return value
	}

	// One served interface: what calls of it are run on.
	struct Handler {
		info InterfaceInfo
		// Runs method number `method` with the arguments in `from` and writes
		// its result to `to`. Fails with the method's failure, or when the
		// arguments do not read as the method's.
		call def (method int, from Reader, to Writer) !none
	}

	// The handler of interface `I` over `target`.
	def handler<I>(target I) Handler {
		return Handler{
			info: describe<I>(),
			call: def (method int, from Reader, to Writer) !none {
				return dispatch<I>(target, method, from, to)
			},
		}
	}

	// The start of the list `served<T>` builds.
	def noHandlers() Handler[] {
		return []
	}

	// `list` with `handler` after its last entry.
	def addHandler(list Handler[], handler Handler) Handler[] {
		list.push(handler)
		return list
	}

	// Whether the arguments of a call were read whole: the reader holds no
	// failure and no bytes after them.
	def argumentsRead(from Reader) bool {
		let read = true
		from.done() onerror {
			read = false
			recover none
		}
		return read
	}

	// The failure of a call whose arguments did not read.
	def badArguments(from Reader) !none {
		try from.done()
		return none
	}

	// The failure of a call of a method number the interface does not have.
	def unknownMethod(method int, count int) !none {
		fail IPCError{message: "ipc: method {method} called, the interface has {count}", code: "ipc.protocol", kind: IPCErrorKind.Protocol}
	}

	// Writes what a served method returned, or passes on its failure.
	def answer<R>(to Writer, outcome !R) !none {
		let value = try outcome
		encode<R>(to, value)
		return to.verify()
	}

	// What `IPC.connect<I>` returns: an `I` whose methods send their calls
	// through `remote`. The body here is never run.
	def proxy<I>(remote Remote) I {
		let out I
		return out
	}

	// Runs method number `method` of `target` with the arguments read from
	// `from` and writes its result to `to`. The body here is never run.
	def dispatch<I>(target I, method int, from Reader, to Writer) !none {
		return none
	}

	// `I` as both sides of a link describe it. The body here is never run.
	def describe<I>() InterfaceInfo {
		return InterfaceInfo{}
	}

	// A handler for each interface `T` is marked `@remote` for, over
	// `instance`. The body here is never run.
	def served<T>(instance T) Handler[] {
		return []
	}
}
