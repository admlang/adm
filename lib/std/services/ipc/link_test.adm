internal partial module std.services.ipc.link {
	use (
		std.errors
		std.services.ipc::*
		std.services.ipc.wire::(Reader, Writer)
		std.testing
		std.time
	)

	struct Order {
		customer string
		item     string
		quantity int
	}

	// A failure the desk reports with a code.
	struct DeskError {
		message string
		code    string
		cause   ?error
		stack   errors.StackTrace
	}

	struct Receipt {
		id    int
		total float
	}

	enum Size {
		Small,
		Large = 10,
	}

	interface Orders {
		def place(order Order) !Receipt
		def spent(customer string) !float
		def cancel(id int) !none
		def count() !int
		def label(id int, size Size) !string
		def label(text string) !string
		def find(customer string) !?Receipt
		def mixed(value int | string) !int | string
	}

	interface Counter {
		def add(by int) !int
		def hold(ms int) !int
	}

	@remote<Orders>
	@remote<Counter>
	type Desk {
		internal placed Order[]
		internal gone   bool[]
		internal total  int     = 0

		def place(order Order) !Receipt {
			fail "quantity must be positive" when order.quantity <= 0
			placed.push(order)
			gone.push(false)
			return Receipt{id: placed.len(), total: 2.5 * float(order.quantity)}
		}

		def spent(customer string) !float {
			let sum = 0.0
			for let (i, order) in placed {
				continue when gone[i] || order.customer != customer
				sum += 2.5 * float(order.quantity)
			}
			return sum
		}

		def cancel(id int) !none {
			fail DeskError{message: "there is no order {id}", code: "desk.unknown"} when id < 1 || id > placed.len() || gone[id - 1]
			gone[id - 1] = true
			return none
		}

		def count() !int {
			return placed.len()
		}

		def label(id int, size Size) !string {
			return "{id}:{size}"
		}

		def label(text string) !string {
			return "text:{text}"
		}

		def find(customer string) !?Receipt {
			for let (i, order) in placed {
				return Receipt{id: i + 1, total: 2.5 * float(order.quantity)} when order.customer == customer
			}
			return none
		}

		def mixed(value int | string) !int | string {
			match value {
				case int:
					return "{value}"
				case string:
					return value.len()
			}
		}

		def add(by int) !int {
			total += by
			return total
		}

		def hold(ms int) !int {
			time.sleep((1ms).scale(float(ms)))
			return ms
		}

		// Not in either interface: no client reaches it.
		def secret() int {
			return 42
		}
	}

	// Calls a handler in this process, through the encoded bytes a link
	// would carry.
	type Loopback {
		internal handler Handler

		def new(handler Handler) {
			self.handler = handler
		}

		def call(method int, arguments byte[]) !byte[] {
			let from = new Reader(arguments)
			let to = new Writer()
			try handler.call(method, from, to)
			return to.bytes()
		}

		def close() {}

		def links() LinkInfo[] {
			return []
		}
	}

	// The handler of `name` among those served for an instance.
	def handlerFor(handlers Handler[], name string) !Handler {
		for let (_, handler) in handlers {
			return handler when handler.info.name == name
		}
		fail "no handler for {name}"
	}

	check "IPC calls" {
		@test()
		def TestDescribe() !none {
			let info = describe<Orders>()
			assert info.name == "std.services.ipc.link.Orders"
			assert info.methods.len() == 8
			assert info.methods[0].startsWith("cancel(")
			assert info.hash.len() == 64
			assert describe<Orders>().hash == info.hash
			assert describe<Counter>().hash != info.hash
			assert info.types.len() >= 3
		}

		@test()
		def TestServedListsEveryRemoteInterface() !none {
			let handlers = served<Desk>(new Desk())
			assert handlers.len() == 2
			assert handlers[0].info.name == "std.services.ipc.link.Orders"
			assert handlers[1].info.name == "std.services.ipc.link.Counter"
		}

		@test()
		def TestCallsCrossThroughTheProxy() !none {
			let desk = new Desk()
			let handlers = served<Desk>(desk)
			let orders = proxy<Orders>(new Remote(describe<Orders>(), new Loopback(try handlerFor(handlers, describe<Orders>().name))))
			let receipt = try orders.place(Order{customer: "ada", item: "desk", quantity: 2})
			assert receipt.id == 1
			assert receipt.total == 5.0
			try orders.place(Order{customer: "bob", item: "lamp", quantity: 4})
			assert try orders.spent("ada") == 5.0
			assert try orders.count() == 2
			assert desk.placed.len() == 2
			try orders.cancel(1)
			assert try orders.spent("ada") == 0.0
			assert try orders.label(7, Size.Large) == "7:Large"
			assert try orders.label("x") == "text:x"
			let found = try orders.find("bob")
			fail "bob has no receipt" when found is none
			assert found.id == 2
			assert try orders.find("eve") is none
			let back = try orders.mixed(12)
			assert back is string
			let length = try orders.mixed("four")
			assert length is int
		}

		@test()
		def TestFailuresCrossWithTheirCode() !none {
			let handlers = served<Desk>(new Desk())
			let orders = proxy<Orders>(new Remote(describe<Orders>(), new Loopback(try handlerFor(handlers, describe<Orders>().name))))
			let message = ""
			let code = ""
			orders.cancel(9) onerror (err error) {
				message = err.message
				code = err.code
				recover none
			}
			assert message == "there is no order 9"
			assert code == "desk.unknown"
			let refused = ""
			orders.place(Order{customer: "ada", item: "desk", quantity: 0}) onerror (err error) {
				refused = err.message
				recover Receipt{}
			}
			assert refused == "quantity must be positive"
		}

		@test()
		def TestSecondInterfaceSharesTheInstance() !none {
			let desk = new Desk()
			let handlers = served<Desk>(desk)
			let counter = proxy<Counter>(new Remote(describe<Counter>(), new Loopback(try handlerFor(handlers, describe<Counter>().name))))
			assert try counter.add(3) == 3
			assert try counter.add(4) == 7
			assert desk.total == 7
		}

		@test()
		def TestUnknownMethodAndBadArgumentsFail() !none {
			let handler = try handlerFor(served<Desk>(new Desk()), describe<Orders>().name)
			let to = new Writer()
			let unknown = ""
			handler.call(99, new Reader([]), to) onerror (err error) {
				unknown = err.message
				recover none
			}
			assert unknown.contains("method 99")
			let short = ""
			handler.call(0, new Reader([]), to) onerror (err error) {
				short = err.message
				recover none
			}
			assert short != ""
		}
	}
}
