partial module std.services.ipc {
	use std.services.ipc.wire::(Reader, Writer, decode, encode)

	// pack is `value` as it crosses a process link, as bytes to keep: every
	// type the table of `docs/requirements/ipc.md` admits, with no field
	// names or type tags, so the reader must ask for the same type. The
	// vault stores entries this way. Fails when the value holds something
	// that cannot cross (a function, a service).
	def pack<T>(value T) !byte[] {
		let writer = new Writer()
		encode<T>(writer, value)
		try writer.verify()
		return writer.bytes()
	}

	// unpack reads a value `pack` wrote, as `T`. Fails when the bytes do not
	// hold one value of that type, whole.
	def unpack<T>(data byte[]) !T {
		let reader = new Reader(data)
		let value = decode<T>(reader)
		try reader.done()
		return value
	}
}
