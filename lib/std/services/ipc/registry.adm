// What the IPC service holds: the interfaces this process provides, its
// listeners, and the pools its `connect` calls made. The state lives here,
// behind atomic methods, so the service needs no member beyond its API.
internal partial module std.services.ipc.link {
	use std.services.ipc::*

	// A pool `IPC.connect` made, held without keeping it alive: a pool
	// closes when the last value using it is dropped.
	type ClientRef {
		weak pool ?Pool

		def new(pool Pool) {
			self.pool = pool
		}
	}

	type Registry {
		// The interfaces provided, shared by every listener.
		catalog Catalog   = new Catalog()
		// How busy this process is serving calls.
		meter   LoadMeter = new LoadMeter()

		internal listening ServerListener[] = []
		internal clients   ClientRef[]      = []
		internal cluster   ?ClusterNode     = none

		// Starts a listener on `address`. Fails when one listens there
		// already, or as starting it does.
		atomic def listen(address string, options Listener) !string {
			for let (_, open) in listening {
				fail "ipc: {address} is listened on already" when open.address == address
			}
			let target = try targetOf(address)
			let listener = new ServerListener(target, options, self)
			let bound = try listener.start(address)
			listening.push(listener)
			return bound
		}

		// Takes the listener on `address` out of the list. Fails when
		// nothing listens there.
		atomic def release(address string) !ServerListener {
			let kept ServerListener[] = []
			let found ?ServerListener = none
			for let (_, open) in listening {
				if open.address == address {
					found = open
				} else {
					kept.push(open)
				}
			}
			fail "ipc: nothing listens on {address}" when found is none
			listening = kept
			return found
		}

		// Keeps a pool for `links` and `stop`, dropping the ones that are
		// gone.
		atomic def remember(pool Pool) {
			let kept ClientRef[] = []
			for let (_, client) in clients {
				kept.push(client) unless client.pool is none
			}
			kept.push(new ClientRef(pool))
			clients = kept
		}

		// The listeners and the pools still alive.
		atomic def snapshot() (ServerListener[], Pool[]) {
			return (listening, livePools())
		}

		// Empties the registry and returns what it held, to be closed.
		atomic def takeAll() (ServerListener[], Pool[]) {
			let listeners = listening
			let pools = livePools()
			listening = []
			clients = []
			catalog.clear()
			return (listeners, pools)
		}

		// The cluster this process is a node of, none when it is in none.
		atomic def node() ?ClusterNode {
			return cluster
		}

		// Makes this process a node of `settings`'s cluster. Fails when it
		// is a node already, or as starting the node does.
		def join(settings Cluster, onJoined def (member Member), onLeft def (member Member)) !ClusterNode {
			let node = try claim(settings)
			node.onJoined = onJoined
			node.onLeft = onLeft
			node.start() onerror (err error) {
				unclaim()
				fail err
			}
			return node
		}

		internal atomic def claim(settings Cluster) !ClusterNode {
			fail "ipc: this process is a node of cluster {cluster.settings.name} already" unless cluster is none
			let node = new ClusterNode(settings, self)
			cluster = node
			return node
		}

		internal atomic def unclaim() {
			cluster = none
		}

		// Leaves the cluster. Fails when this process is in none.
		def leave() !none {
			let node = try unjoin()
			node.stop()
			return none
		}

		internal atomic def unjoin() !ClusterNode {
			let held = cluster
			fail "ipc: this process is in no cluster" when held is none
			cluster = none
			return held
		}

		// This process's load figure: its cluster's, else the calls running
		// plus the mean wait in milliseconds before a call starts.
		def load() float {
			let held = node()
			return held.loadNow() unless held is none
			return float(meter.runningNow()) + meter.waitMean()
		}

		// Tells every connected client the members it may use now.
		def pushMembers() {
			let (listeners, _) = snapshot()
			for let (_, listener) in listeners {
				listener.pushMembers()
			}
		}

		// A registry that goes leaves its cluster.
		def dispose() {
			let held = cluster
			held.stop() unless held is none
		}

		internal def livePools() Pool[] {
			let pools Pool[] = []
			for let (_, client) in clients {
				let pool = client.pool
				pools.push(pool) unless pool is none
			}
			return pools
		}
	}
}
