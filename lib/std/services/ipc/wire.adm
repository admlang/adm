// How values are laid out in a message between processes: little endian,
// integers as LEB128 varints (signed ones zigzagged), no field names or type
// tags. Both sides know the types.
//
// Neither side fails in the middle of a value. A writer or reader that meets
// something it cannot accept keeps the first such failure, and from then on
// reads give zero values and take nothing; the caller asks `verify()` once per
// message. Code that writes or reads a whole value is then a straight run of
// calls.
internal partial module std.services.ipc.wire {
	use std.services.ipc::*

	// The bytes the longest varint of a 64-bit and of a 128-bit value takes.
	const maxVarint64 = 10
	const maxVarint128 = 19

	// The failure of a message that breaks the protocol.
	def malformed(message string) IPCError {
		return IPCError{message: "ipc: {message}", code: "ipc.protocol", kind: IPCErrorKind.Protocol}
	}

	// Maps a signed value onto an unsigned one that keeps small magnitudes
	// short: 0, -1, 1, -2 become 0, 1, 2, 3.
	def zigzag(v int64) uint64 {
		return uint64(v) << 1 when v >= 0
		return (uint64(-(v + 1)) << 1) | 1
	}

	// The signed value `zigzag` made this from.
	def unzigzag(v uint64) int64 {
		return int64(v >> 1) when (v & 1) == 0
		return -int64(v >> 1) - 1
	}

	// `zigzag` for 128-bit values.
	def zigzag(v int128) uint128 {
		return uint128(v) << 1 when v >= 0
		return (uint128(-(v + 1)) << 1) | 1
	}

	// `unzigzag` for 128-bit values.
	def unzigzag(v uint128) int128 {
		return int128(v >> 1) when (v & 1) == 0
		return -int128(v >> 1) - 1
	}

	// Builds one message.
	type Writer {
		// The message so far; its length is the bytes written.
		buf      byte[]    = []
		// How many values deep the value being written is.
		depth    int       = 0
		// Deepest nesting `enter` accepts.
		maxDepth int       = 256
		// The first thing that went wrong, none while the message is good.
		failure  ?IPCError
		// The objects whose fields are being written, outermost first: what
		// a `weak` field may point back at.
		objects  any[]     = []

		def new(maxDepth int = 256) {
			self.maxDepth = maxDepth
		}

		// Fails with the first thing that went wrong while writing.
		def verify() !none {
			let failed = failure
			fail failed unless failed is none
			return none
		}

		// The message written so far. The storage is the writer's own: copy
		// it before writing more.
		def bytes() byte[] {
			return buf
		}

		// The bytes written so far.
		def len() int {
			return buf.len()
		}

		// Drops what was written, and any failure, and keeps the storage.
		def reset() {
			buf.len(0)
			depth = 0
			failure = none
			objects.len(0)
		}

		// Records a failure, unless one is recorded already.
		def reject(message string) {
			failure = malformed(message) when failure is none
		}

		// Makes room for `count` more bytes and returns where they start.
		def room(count int) int {
			let at = buf.len()
			let need = at + count
			buf.cap(need.max(buf.cap() * 2).max(64)) when need > buf.cap()
			buf.len(need)
			return at
		}

		def putByte(v byte) {
			let at = room(1)
			buf[at] = v
		}

		def putBool(v bool) {
			putByte(v ?? (byte(1), byte(0)))
		}

		// Writes an unsigned varint: seven bits a byte, low bits first, the
		// high bit set on every byte but the last.
		def putUint(v uint64) {
			if v < 0x80 {
				putByte(byte(v))
				return
			}
			let at = room(maxVarint64)
			let rest = v
			for rest >= 0x80 {
				buf[at] = byte((rest & 0x7F) | 0x80)
				at++
				rest = rest >> 7
			}
			buf[at] = byte(rest)
			buf.len(at + 1)
		}

		// Writes a signed varint, zigzagged.
		def putInt(v int64) {
			putUint(zigzag(v))
		}

		// Writes an unsigned 128-bit varint.
		def putUint128(v uint128) {
			let at = room(maxVarint128)
			let rest = v
			for rest >= 0x80 {
				buf[at] = byte((rest & 0x7F) | 0x80)
				at++
				rest = rest >> 7
			}
			buf[at] = byte(rest)
			buf.len(at + 1)
		}

		// Writes a signed 128-bit varint, zigzagged.
		def putInt128(v int128) {
			putUint128(zigzag(v))
		}

		// Writes the length of what follows: an array's elements, a map's
		// entries, a string's bytes.
		def putCount(count int) {
			putUint(uint64(count))
		}

		// Writes `v` in two bytes.
		def putFixed16(v uint16) {
			let at = room(2)
			buf[at] = byte(v & 0xFF)
			buf[at + 1] = byte(v >> 8)
		}

		// Writes `v` in four bytes.
		def putFixed32(v uint32) {
			let at = room(4)
			buf[at] = byte(v & 0xFF)
			buf[at + 1] = byte((v >> 8) & 0xFF)
			buf[at + 2] = byte((v >> 16) & 0xFF)
			buf[at + 3] = byte(v >> 24)
		}

		// Writes `v` in eight bytes.
		def putFixed64(v uint64) {
			let at = room(8)
			for let i = 0; i < 8; i++ {
				buf[at + i] = byte((v >> (i * 8)) & 0xFF)
			}
		}

		def putFloat32(v float32) {
			putFixed32(__bitcast_u32_from_f32(v))
		}

		def putFloat(v float64) {
			putFixed64(__bitcast_u64_from_f64(v))
		}

		// Writes the bytes as they are, with no length before them.
		def putRaw(data byte[]) {
			return when data.len() == 0
			let at = room(data.len())
			data.copy(buf[at:])
		}

		// Writes the length of `data`, then its bytes.
		def putBytes(data byte[]) {
			putCount(data.len())
			putRaw(data)
		}

		// Writes the length of the text in bytes, then its UTF-8 bytes.
		def putString(text string) {
			putBytes(text.bytes())
		}

		// Starts a value and reports whether it may be written. It may not
		// when the writer has failed already or the value is nested deeper
		// than `maxDepth`, which is how a value that contains itself is
		// caught. Every `enter` that returned true is paired with a `leave`.
		def enter() bool {
			return false unless failure is none
			if depth >= maxDepth {
				reject("a value is nested deeper than {maxDepth} levels, or contains itself")
				return false
			}
			depth++
			return true
		}

		// Ends the value the last `enter` started.
		def leave() {
			depth--
		}
	}

	// Reads one message front to back. A message that ends early or holds
	// something the type being read does not allow sets `failure`
	// (`IPCErrorKind.Protocol`).
	type Reader {
		// The message.
		data     byte[]
		// The next byte to read.
		at       int       = 0
		// How many values deep the value being read is.
		depth    int       = 0
		// Deepest nesting `enter` accepts.
		maxDepth int       = 256
		// Most elements an array or map of values that take no bytes may
		// announce. Other counts are bounded by the bytes left.
		maxCount int       = 16 * 1024 * 1024
		// The first thing that went wrong, none while the message is good.
		failure  ?IPCError
		// The objects whose fields are being read, outermost first: what a
		// `weak` field may point back at.
		objects  any[]     = []

		def new(data byte[], maxDepth int = 256, maxCount int = 16 * 1024 * 1024) {
			self.data = data
			self.maxDepth = maxDepth
			self.maxCount = maxCount
		}

		// Fails with the first thing that went wrong while reading.
		def verify() !none {
			let failed = failure
			fail failed unless failed is none
			return none
		}

		// `verify`, and fails too when bytes follow what was read.
		def done() !none {
			reject("{left()} bytes follow the end of the message") when left() != 0
			return verify()
		}

		// Records a failure, unless one is recorded already, and gives up
		// the rest of the message.
		def reject(message string) {
			failure = malformed(message) when failure is none
			at = data.len()
		}

		// The bytes not read yet; 0 after a failure.
		def left() int {
			return data.len() - at
		}

		// Where the next `count` bytes start, or -1 (and a failure) when
		// the message does not hold that many.
		def take(count int) int {
			if count < 0 || count > left() {
				reject("the message ends {count - left()} bytes early")
				return -1
			}
			let from = at
			at += count
			return from
		}

		def readByte() byte {
			let from = take(1)
			return 0 when from < 0
			return data[from]
		}

		// Any byte but 0 and 1 is a failure.
		def readBool() bool {
			let v = readByte()
			reject("{v} is not a bool") when v > 1
			return v == 1
		}

		// Reads an unsigned varint. One that runs past 64 bits is a failure.
		def readUint() uint64 {
			let out uint64 = 0
			for let shift = 0; shift < 70; shift += 7 {
				let from = take(1)
				return 0 when from < 0
				let group = data[from]
				break when shift == 63 && group > 1
				out = out | (uint64(group & 0x7F) << shift)
				return out when (group & 0x80) == 0
			}
			reject("a number is longer than 64 bits")
			return 0
		}

		// Reads a signed varint.
		def readInt() int64 {
			return unzigzag(readUint())
		}

		// Reads a signed varint that must fit `bits` bits.
		def readIntOf(bits int) int64 {
			let v = readInt()
			let limit = int64(1) << (bits - 1)
			return v when v >= -limit && v < limit
			reject("{v} does not fit {bits} bits")
			return 0
		}

		// Reads an unsigned varint that must fit `bits` bits.
		def readUintOf(bits int) uint64 {
			let v = readUint()
			return v when (v >> bits) == 0
			reject("{v} does not fit {bits} bits")
			return 0
		}

		// Reads a char: a Unicode scalar value. A surrogate or a number past
		// U+10FFFF is a failure.
		def readChar() char {
			let v = readUint()
			return char(uint32(v)) when v < 0xD800 || (v > 0xDFFF && v <= 0x10FFFF)
			reject("{v} is not a character")
			return char(0)
		}

		// Reads a number that must be below `count`: which alternative of a
		// union follows, how far up a link points.
		def readIndex(count int) int {
			let v = readUint()
			return int(v) when v < uint64(count)
			reject("{v} is not below {count}")
			return 0
		}

		// Reads an unsigned 128-bit varint. One that runs past 128 bits is
		// a failure.
		def readUint128() uint128 {
			let out uint128 = 0
			for let shift = 0; shift < 133; shift += 7 {
				let from = take(1)
				return 0 when from < 0
				let group = data[from]
				break when shift == 126 && group > 3
				out = out | (uint128(group & 0x7F) << shift)
				return out when (group & 0x80) == 0
			}
			reject("a number is longer than 128 bits")
			return 0
		}

		// Reads a signed 128-bit varint.
		def readInt128() int128 {
			return unzigzag(readUint128())
		}

		// Reads the length of what follows, where each element takes at
		// least `unit` bytes. A length the message cannot hold is a failure
		// and reads as 0, so a count is never trusted further than the
		// bytes behind it.
		def readCount(unit int = 1) int {
			let count = readUint()
			let most = unit > 0 ?? (left() / unit, maxCount)
			if count > uint64(most) {
				reject("a length of {count} is more than the message holds")
				return 0
			}
			return int(count)
		}

		def readFixed16() uint16 {
			let from = take(2)
			return 0 when from < 0
			return uint16(data[from]) | (uint16(data[from + 1]) << 8)
		}

		def readFixed32() uint32 {
			let from = take(4)
			return 0 when from < 0
			return uint32(data[from]) | (uint32(data[from + 1]) << 8) | (uint32(data[from + 2]) << 16) | (uint32(data[from + 3]) << 24)
		}

		def readFixed64() uint64 {
			let from = take(8)
			return 0 when from < 0
			let out uint64 = 0
			for let i = 0; i < 8; i++ {
				out = out | (uint64(data[from + i]) << (i * 8))
			}
			return out
		}

		def readFloat32() float32 {
			return __bitcast_f32_from_u32(readFixed32())
		}

		def readFloat() float64 {
			return __bitcast_f64_from_u64(readFixed64())
		}

		// Reads `count` bytes into an array of their own.
		def readRaw(count int) byte[] {
			let out = byte[]
			let from = take(count)
			return out when from < 0 || count == 0
			out.len(count)
			(data[from:]).copy(out)
			return out
		}

		// Reads a length, then that many bytes.
		def readBytes() byte[] {
			return readRaw(readCount())
		}

		// Reads a length, then that many bytes of text. Bytes that are not
		// UTF-8 are a failure and read as "".
		def readString() string {
			let text = string(readBytes())
			return text when text.isUTF8()
			reject("a string is not UTF-8")
			return ""
		}

		// Starts a value and reports whether it may be read. It may not
		// when the reader has failed already or the value is nested deeper
		// than `maxDepth`. Every `enter` that returned true is paired with
		// a `leave`.
		def enter() bool {
			return false unless failure is none
			if depth >= maxDepth {
				reject("a value is nested deeper than {maxDepth} levels")
				return false
			}
			depth++
			return true
		}

		// Ends the value the last `enter` started.
		def leave() {
			depth--
		}
	}
}
