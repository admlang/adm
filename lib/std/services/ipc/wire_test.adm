internal partial module std.services.ipc.wire {
	use (
		std.data.encoding::(hexencode)
		std.services.ipc::*
		std.testing
	)

	// The kind of failure a reader holds, as text; "" when it holds none.
	def failureOf(r Reader) string {
		let failed = r.failure
		return "" when failed is none
		return "{failed.kind}"
	}

	def readsUint(data byte[]) string {
		let r = new Reader(data)
		r.readUint()
		return failureOf(r)
	}

	def readsUint128(data byte[]) string {
		let r = new Reader(data)
		r.readUint128()
		return failureOf(r)
	}

	def readsString(data byte[]) string {
		let r = new Reader(data)
		r.readString()
		return failureOf(r)
	}

	def readsBool(data byte[]) string {
		let r = new Reader(data)
		r.readBool()
		return failureOf(r)
	}

	def readsCount(data byte[], unit int, maxCount int) string {
		let r = new Reader(data, 256, maxCount)
		r.readCount(unit)
		return failureOf(r)
	}

	def readsFixed(data byte[], width int) string {
		let r = new Reader(data)
		match width {
			case 2:
				r.readFixed16()
			case 4:
				r.readFixed32()
			default:
				r.readFixed64()
		}
		return failureOf(r)
	}

	// How many of `levels` nested values a writer with that limit lets in.
	def nests(levels int, maxDepth int) int {
		let w = new Writer(maxDepth)
		let entered = 0
		for let i = 0; i < levels; i++ {
			entered++ when w.enter()
		}
		return entered
	}

	def readerNests(levels int, maxDepth int) int {
		let r = new Reader(byte[], maxDepth)
		let entered = 0
		for let i = 0; i < levels; i++ {
			entered++ when r.enter()
		}
		return entered
	}

	// Whether a message is exactly `reads` bytes long.
	def endsAt(data byte[], reads int) bool {
		let r = new Reader(data)
		for let i = 0; i < reads; i++ {
			r.readByte()
		}
		let ok = true
		r.done() onerror (err error) {
			ok = false
			recover none
		}
		return ok
	}

	check "IPC wire" {
		@test()
		def TestUnsignedVarints() !none {
			let samples = [(uint64(0), "00"), (uint64(1), "01"), (uint64(127), "7f"), (uint64(128), "8001"), (uint64(300), "ac02"), (uint64(16384), "808001"), (uint64(uint64(0).MAX()), "ffffffffffffffffff01")]
			let w = new Writer()
			for let sample in samples {
				let (value, text) = sample
				w.reset()
				w.putUint(value)
				assert hexencode(w.bytes()) == text
				let r = new Reader(w.bytes())
				assert r.readUint() == value
				try r.done()
			}
		}

		@test()
		def TestSignedVarints() !none {
			let samples = [(int64(0), "00"), (int64(-1), "01"), (int64(1), "02"), (int64(-2), "03"), (int64(63), "7e"), (int64(-64), "7f"), (int64(64), "8001"), (int64(int64(0).MAX()), "feffffffffffffffff01"), (int64(int64(0).MIN()), "ffffffffffffffffff01")]
			let w = new Writer()
			for let sample in samples {
				let (value, text) = sample
				w.reset()
				w.putInt(value)
				assert hexencode(w.bytes()) == text
				let r = new Reader(w.bytes())
				assert r.readInt() == value
				try r.done()
			}
		}

		@test()
		def TestWideVarints() !none {
			let unsigned = [uint128(0), uint128(127), uint128(128), uint128(uint64(0).MAX()), uint128(uint64(0).MAX()) + 1, uint128(0).MAX()]
			let w = new Writer()
			for let value in unsigned {
				w.reset()
				w.putUint128(value)
				let r = new Reader(w.bytes())
				assert r.readUint128() == value
				try r.done()
			}
			w.reset()
			w.putUint128(uint128(0).MAX())
			assert w.len() == 19
			w.reset()
			w.putUint128(300)
			assert hexencode(w.bytes()) == "ac02"

			let signed = [int128(0), int128(-1), int128(1), int128(int64(0).MIN()), int128(int64(0).MAX()), int128(0).MIN(), int128(0).MAX()]
			for let value in signed {
				w.reset()
				w.putInt128(value)
				let r = new Reader(w.bytes())
				assert r.readInt128() == value
				try r.done()
			}
		}

		@test()
		def TestVarintLimits() {
			// Ten bytes hold 64 bits only when the last carries one bit.
			assert readsUint([byte(0xFF), 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0x02]) == "Protocol"
			assert readsUint([byte(0xFF), 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0x81, 0x00]) == "Protocol"
			assert readsUint([byte(0xFF), 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0x01]) == ""
			// A varint cut before its last byte.
			assert readsUint([byte(0x80)]) == "Protocol"
			assert readsUint(byte[]) == "Protocol"

			let wide byte[] = []
			wide.len(18)
			wide.fill(0xFF)
			assert readsUint128(wide + [byte(0x03)]) == ""
			assert readsUint128(wide + [byte(0x04)]) == "Protocol"
			assert readsUint128(wide) == "Protocol"
		}

		@test()
		def TestFixedWidths() !none {
			let w = new Writer()
			w.putFixed16(0x1234)
			w.putFixed32(0x89ABCDEF)
			w.putFixed64(0x0123456789ABCDEF)
			w.putByte(0xFE)
			w.putBool(true)
			w.putBool(false)
			assert hexencode(w.bytes()) == "3412efcdab89efcdab8967452301fe0100"

			let r = new Reader(w.bytes())
			assert r.readFixed16() == 0x1234
			assert r.readFixed32() == 0x89ABCDEF
			assert r.readFixed64() == 0x0123456789ABCDEF
			assert r.readByte() == 0xFE
			assert r.readBool()
			assert !r.readBool()
			try r.done()

			assert readsFixed([byte(1)], 2) == "Protocol"
			assert readsFixed([byte(1), 2, 3], 4) == "Protocol"
			assert readsFixed([byte(1), 2, 3, 4, 5, 6, 7], 8) == "Protocol"
			assert readsBool([byte(2)]) == "Protocol"
			assert readsBool(byte[]) == "Protocol"
		}

		@test()
		def TestFloats() !none {
			let w = new Writer()
			w.putFloat(1.0)
			assert hexencode(w.bytes()) == "000000000000f03f"
			w.reset()
			w.putFloat32(float32(1.0))
			assert hexencode(w.bytes()) == "0000803f"

			let doubles float64[] = [0.0, -0.0, 1.5, -2.25, 1.0e300, 5.0e-324, float64(0).MAX()]
			for let value in doubles {
				w.reset()
				w.putFloat(value)
				assert w.len() == 8
				let r = new Reader(w.bytes())
				// Compared as bits: -0.0 and 0.0 are equal as numbers.
				assert __bitcast_u64_from_f64(r.readFloat()) == __bitcast_u64_from_f64(value)
			}
			let singles = [float32(0.0), float32(-0.0), float32(1.5), float32(-2.25), float32(0).MAX()]
			for let value in singles {
				w.reset()
				w.putFloat32(value)
				assert w.len() == 4
				let r = new Reader(w.bytes())
				assert __bitcast_u32_from_f32(r.readFloat32()) == __bitcast_u32_from_f32(value)
			}

			// A NaN keeps its payload.
			let nan = __bitcast_f64_from_u64(0x7FF8000000001234)
			w.reset()
			w.putFloat(nan)
			let r = new Reader(w.bytes())
			assert __bitcast_u64_from_f64(r.readFloat()) == 0x7FF8000000001234
		}

		@test()
		def TestBytesAndStrings() !none {
			let w = new Writer()
			w.putString("")
			w.putString("desk")
			w.putString("héllo, 世界")
			w.putBytes([byte(0), 255, 7])
			w.putBytes(byte[])
			w.putRaw([byte(9), 8])
			assert hexencode(w.bytes()[:6]) == "00046465736b"

			let r = new Reader(w.bytes())
			assert r.readString() == ""
			assert r.readString() == "desk"
			assert r.readString() == "héllo, 世界"
			assert hexencode(r.readBytes()) == "00ff07"
			assert r.readBytes().len() == 0
			assert hexencode(r.readRaw(2)) == "0908"
			try r.done()

			// What was read is a copy: the message may be reused.
			let message = [byte(2), 1, 2]
			let r2 = new Reader(message)
			let got = r2.readBytes()
			message[1] = 9
			assert hexencode(got) == "0102"

			// A length longer than the message, and bytes that are not UTF-8.
			assert readsString([byte(5), 0x61, 0x62]) == "Protocol"
			assert readsString([byte(2), 0xC3, 0x28]) == "Protocol"
			assert readsString([byte(1), 0xFF]) == "Protocol"
		}

		@test()
		def TestLargeMessage() !none {
			// Crosses every growth of the buffer.
			let w = new Writer()
			for let i = 0; i < 20000; i++ {
				w.putUint(uint64(i))
				w.putString("item {i}")
			}
			let r = new Reader(w.bytes())
			for let i = 0; i < 20000; i++ {
				assert r.readUint() == uint64(i)
				assert r.readString() == "item {i}"
			}
			try r.done()

			let block byte[] = []
			block.len(100000)
			for let i = 0; i < block.len(); i++ {
				block[i] = byte(i % 251)
			}
			w.reset()
			assert w.len() == 0
			w.putBytes(block)
			let r2 = new Reader(w.bytes())
			assert r2.readBytes().equals(block)
			try r2.done()
		}

		@test()
		def TestCounts() !none {
			let w = new Writer()
			w.putCount(3)
			w.putRaw([byte(1), 2, 3])
			let r = new Reader(w.bytes())
			assert r.readCount() == 3

			// Three elements of four bytes need twelve bytes behind the count.
			let twelve byte[] = [byte(3)]
			twelve.len(13)
			assert readsCount(twelve, 4, 100) == ""
			assert readsCount(twelve[:12], 4, 100) == "Protocol"
			// A count the message could never hold.
			assert readsCount([byte(0xFF), 0xFF, 0xFF, 0xFF, 0x0F], 1, 100) == "Protocol"
			// Elements that take no bytes are bounded by the limit alone.
			assert readsCount([byte(100)], 0, 100) == ""
			assert readsCount([byte(101)], 0, 100) == "Protocol"
		}

		@test()
		def TestNesting() {
			assert nests(4, 4) == 4
			assert nests(9, 4) == 4
			assert readerNests(4, 4) == 4
			assert readerNests(9, 4) == 4

			let w = new Writer(1)
			assert w.enter()
			w.leave()
			assert w.enter()
			assert w.failure is none
			assert !w.enter()
			let seen = ""
			w.verify() onerror (err error) {
				seen = err is IPCError ?? ("{err.kind}", "other")
				recover none
			}
			assert seen == "Protocol"
			// A failed writer lets nothing more in until it is reset.
			w.leave()
			assert !w.enter()
			w.reset()
			assert w.enter()
		}

		@test()
		def TestEndOfMessage() {
			assert endsAt([byte(1), 2], 2)
			assert !endsAt([byte(1), 2], 1)
			assert !endsAt([byte(1), 2], 3)
		}

		@test()
		def TestAfterAFailure() {
			// The first failure is kept, and nothing more is read.
			let r = new Reader([byte(2), 7, 7, 7])
			assert !r.readBool()
			assert failureOf(r) == "Protocol"
			let first = r.failure
			assert r.left() == 0
			assert r.readByte() == 0
			assert r.readUint() == 0
			assert r.readCount() == 0
			assert r.readString() == ""
			assert r.readBytes().len() == 0
			assert r.readFloat() == 0.0
			assert !r.enter()
			assert !(first is none)
			assert !(r.failure is none)
		}
	}
}
