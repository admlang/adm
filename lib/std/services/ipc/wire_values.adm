// Whole values on the wire. `encode<T>` writes a value of any type that can
// cross and `decode<T>` reads one back; what a type looks like on the wire is
// the table in docs/requirements/ipc.md.
//
// The compiler writes the bodies of `write<T>`, `read<T>` and `box<U, A>` for
// each type they are used with (internal/irgen/wire_intrinsics.go), as a
// straight run of calls to the other functions of this file. Their names and
// parameters are what that code calls: change both together.
internal partial module std.services.ipc.wire {
	use std.simd

	// Writes `value` by the shape of `T`. The body here is never run.
	def write<T>(to Writer, value T) {}

	// Reads a value by the shape of `T`. The body here is never run.
	def read<T>(from Reader) T {
		let out T
		return out
	}

	// `value` as the union `U` it is an alternative of. The body here is
	// never run.
	def box<U, A>(value A) U {
		let out U
		return out
	}

	// Fails the message being written: it holds a value of a type that
	// has no form on the wire.
	def refuse(to Writer, typeName string) {
		to.reject("a value of type {typeName} cannot cross to another process")
	}

	// Fails the message being read: it would hold a value of a type that
	// has no form on the wire.
	def refuseRead(from Reader, typeName string) {
		from.reject("a value of type {typeName} cannot cross to another process")
	}

	// Writes one value. A value nested deeper than the writer allows (one
	// that contains itself, in practice) is not written and fails the message.
	def encode<T>(to Writer, value T) {
		match T {
			case bool, byte, int8, uint8, int16, uint16, int32, uint32, int64, uint64, int, uint, int128, uint128, float32, float64, float, char, string, duration, bigint:
				writeScalar<T>(to, value)
				return
		}
		return unless to.enter()
		write<T>(to, value)
		to.leave()
	}

	// Reads one value. After a failure, or deeper than the reader allows,
	// it reads nothing and gives the zero value of `T`.
	def decode<T>(from Reader) T {
		match T {
			case bool, byte, int8, uint8, int16, uint16, int32, uint32, int64, uint64, int, uint, int128, uint128, float32, float64, float, char, string, duration, bigint:
				return readScalar<T>(from)
		}
		if from.enter() {
			let value = read<T>(from)
			from.leave()
			return value
		}
		let zero T
		return zero
	}

	// Writes a number, a bool, a char, a string or a duration. A `bigint` is
	// a sign byte (1 when negative), then the length and the big-endian bytes
	// of its magnitude.
	def writeScalar<T>(to Writer, value T) {
		match T {
			case bool:
				to.putBool(value)
			case byte, uint8:
				to.putByte(byte(value))
			case int8:
				to.putByte(byte(uint8(value)))
			case int16, int32, int64, int:
				to.putInt(int64(value))
			case uint16, uint32, uint64, uint:
				to.putUint(uint64(value))
			case int128:
				to.putInt128(value)
			case uint128:
				to.putUint128(value)
			case float32:
				to.putFloat32(value)
			case float64, float:
				to.putFloat(float64(value))
			case char:
				to.putUint(uint64(uint32(value)))
			case string:
				to.putString(value)
			case duration:
				to.putInt(int64(value))
			case bigint:
				to.putBool(value.sign() < 0)
				to.putBytes(value.bytes())
		}
	}

	// Reads what `writeScalar<T>` wrote. A number that does not fit `T`, a
	// char that is no Unicode scalar value, is a failure and reads as zero.
	def readScalar<T>(from Reader) T {
		match T {
			case bool:
				return from.readBool()
			case byte, uint8:
				return T(from.readByte())
			case int8:
				return T(int8(from.readByte()))
			case int16:
				return T(from.readIntOf(16))
			case int32:
				return T(from.readIntOf(32))
			case int64, int:
				return T(from.readInt())
			case uint16:
				return T(from.readUintOf(16))
			case uint32:
				return T(from.readUintOf(32))
			case uint64, uint:
				return T(from.readUint())
			case int128:
				return from.readInt128()
			case uint128:
				return from.readUint128()
			case float32:
				return from.readFloat32()
			case float64, float:
				return T(from.readFloat())
			case char:
				return from.readChar()
			case string:
				return from.readString()
			case duration:
				return duration(from.readInt())
			case bigint:
				let negative = from.readBool()
				let magnitude = parseBigInt(from.readBytes())
				return negative ?? (-magnitude, magnitude)
		}
		let zero T
		return zero
	}

	// Writes the count, then the elements. Arrays of fixed-size numbers are
	// one block of little-endian values.
	def writeArray<E>(to Writer, value E[]) {
		match E {
			case byte:
				to.putBytes(value)
				return
			case int8, uint8:
				to.putCount(value.len())
				let count = value.len()
				let at = to.room(count)
				let i = 0
				for i + 32 <= count {
					simd.store32<byte>(to.buf, at + i, simd.load32<E>(value, i).bitcast<byte>())
					i += 32
				}
				for i < count {
					to.buf[at + i] = byte(uint8(value[i]))
					i++
				}
				return
			case int16, uint16:
				to.putCount(value.len())
				let count = value.len()
				let at = to.room(count * 2)
				let i = 0
				for i + 16 <= count {
					simd.store32<byte>(to.buf, at + i * 2, simd.load16<E>(value, i).bitcast32<byte>())
					i += 16
				}
				for i < count {
					let bits = uint16(value[i])
					to.buf[at + i * 2] = byte(bits & 0xFF)
					to.buf[at + i * 2 + 1] = byte(bits >> 8)
					i++
				}
				return
			case int32, uint32, float32:
				to.putCount(value.len())
				let count = value.len()
				let at = to.room(count * 4)
				let i = 0
				for i + 8 <= count {
					simd.store32<byte>(to.buf, at + i * 4, simd.load8<E>(value, i).bitcast32<byte>())
					i += 8
				}
				for i < count {
					let bits uint32 = 0
					match E {
						case float32:
							bits = __bitcast_u32_from_f32(value[i])
						default:
							bits = uint32(value[i])
					}
					for let k = 0; k < 4; k++ {
						to.buf[at + i * 4 + k] = byte((bits >> (k * 8)) & 0xFF)
					}
					i++
				}
				return
			case int64, uint64, int, uint, float64, float:
				to.putCount(value.len())
				let count = value.len()
				let at = to.room(count * 8)
				let i = 0
				for i + 4 <= count {
					simd.store32<byte>(to.buf, at + i * 8, simd.load4<E>(value, i).bitcast32<byte>())
					i += 4
				}
				for i < count {
					let bits uint64 = 0
					match E {
						case float64, float:
							bits = __bitcast_u64_from_f64(float64(value[i]))
						default:
							bits = uint64(value[i])
					}
					for let k = 0; k < 8; k++ {
						to.buf[at + i * 8 + k] = byte((bits >> (k * 8)) & 0xFF)
					}
					i++
				}
				return
		}
		to.putCount(value.len())
		for let item in value {
			encode<E>(to, item)
		}
	}

	// Reads what `writeArray<E>` wrote. `unit` is the fewest bytes one
	// element takes, which bounds the count by the bytes left.
	def readArray<E>(from Reader, unit int) E[] {
		let out = E[]
		match E {
			case byte:
				return from.readBytes()
			case int8, uint8:
				let count = from.readCount(1)
				let at = from.take(count)
				return out when at < 0
				out.len(count)
				let i = 0
				for i + 32 <= count {
					simd.store32<E>(out, i, simd.load32<byte>(from.data, at + i).bitcast<E>())
					i += 32
				}
				for i < count {
					out[i] = E(from.data[at + i])
					i++
				}
				return out
			case int16, uint16:
				let count = from.readCount(2)
				let at = from.take(count * 2)
				return out when at < 0
				out.len(count)
				let i = 0
				for i + 16 <= count {
					simd.store16<E>(out, i, simd.load32<byte>(from.data, at + i * 2).bitcast16<E>())
					i += 16
				}
				for i < count {
					out[i] = E(uint16(from.data[at + i * 2]) | (uint16(from.data[at + i * 2 + 1]) << 8))
					i++
				}
				return out
			case int32, uint32, float32:
				let count = from.readCount(4)
				let at = from.take(count * 4)
				return out when at < 0
				out.len(count)
				let i = 0
				for i + 8 <= count {
					simd.store8<E>(out, i, simd.load32<byte>(from.data, at + i * 4).bitcast8<E>())
					i += 8
				}
				for i < count {
					let bits uint32 = 0
					for let k = 0; k < 4; k++ {
						bits = bits | (uint32(from.data[at + i * 4 + k]) << (k * 8))
					}
					match E {
						case float32:
							out[i] = __bitcast_f32_from_u32(bits)
						default:
							out[i] = E(bits)
					}
					i++
				}
				return out
			case int64, uint64, int, uint, float64, float:
				let count = from.readCount(8)
				let at = from.take(count * 8)
				return out when at < 0
				out.len(count)
				let i = 0
				for i + 4 <= count {
					simd.store4<E>(out, i, simd.load32<byte>(from.data, at + i * 8).bitcast4<E>())
					i += 4
				}
				for i < count {
					let bits uint64 = 0
					for let k = 0; k < 8; k++ {
						bits = bits | (uint64(from.data[at + i * 8 + k]) << (k * 8))
					}
					match E {
						case float64, float:
							out[i] = E(__bitcast_f64_from_u64(bits))
						default:
							out[i] = E(bits)
					}
					i++
				}
				return out
		}
		let count = from.readCount(unit)
		out.cap(count)
		for let i = 0; i < count; i++ {
			out.push(decode<E>(from))
			break unless from.failure is none
		}
		return out
	}

	// Writes the count, then each key and its value, in the map's order.
	def writeMap<K, V>(to Writer, value map<K, V>) {
		to.putCount(value.len())
		for let (key, item) in value {
			encode<K>(to, key)
			encode<V>(to, item)
		}
	}

	// Reads what `writeMap<K, V>` wrote; entries keep the order they were
	// written in. `unit` is the fewest bytes one entry takes.
	def readMap<K, V>(from Reader, unit int) map<K, V> {
		let out = map<K, V>{}
		let count = from.readCount(unit)
		for let i = 0; i < count; i++ {
			let key = decode<K>(from)
			let item = decode<V>(from)
			break unless from.failure is none
			out[key] = item
		}
		return out
	}

	// Writes one byte, 0 or 1, then the value when there is one.
	def writeOptional<E>(to Writer, value ?E) {
		if value is none {
			to.putByte(0)
			return
		}
		to.putByte(1)
		encode<E>(to, value)
	}

	// Reads what `writeOptional<E>` wrote.
	def readOptional<E>(from Reader) ?E {
		return none unless from.readBool()
		return decode<E>(from)
	}

	// Writes the union value `value` when it holds alternative `A`, the
	// `index`-th of `U`: the index, then the value. `done` says an earlier
	// alternative was written already; the result says one has been by now.
	def writeAlternative<U, A>(to Writer, value U, index int, done bool) bool {
		return true when done
		if value is A {
			to.putCount(index)
			encode<A>(to, value)
			return true
		}
		return false
	}

	// Ends a union value: one that held none of its alternatives (it was
	// never given a value) cannot be sent.
	def closeUnion(to Writer, done bool) {
		to.reject("a union value holds none of its alternatives") unless done
	}

	// Reads which of a union's `count` alternatives follows.
	def readIndex(from Reader, count int) int {
		return from.readIndex(count)
	}

	// Reads alternative `A`, the `index`-th of `U`, when it is the one the
	// message chose; otherwise gives `into` back.
	def readAlternative<U, A>(from Reader, chosen int, index int, into U) U {
		return into unless chosen == index
		return box<U, A>(decode<A>(from))
	}

	// Ends reading a value through its own `fromWire`: when that failed, its
	// reason fails the message.
	def settle(from Reader, failed bool, cause error) {
		from.reject("a value was refused: {cause.message}") when failed
	}

	// Writes the bytes of a `union` declaration: the low `size` bytes (1, 2,
	// 4 or 8) of `bits`, little endian.
	def writeRaw(to Writer, bits uint64, size int) {
		match size {
			case 1:
				to.putByte(byte(bits & 0xFF))
			case 2:
				to.putFixed16(uint16(bits & 0xFFFF))
			case 4:
				to.putFixed32(uint32(bits & 0xFFFFFFFF))
			default:
				to.putFixed64(bits)
		}
	}

	// Reads what `writeRaw` wrote for that size.
	def readRaw(from Reader, size int) uint64 {
		match size {
			case 1:
				return uint64(from.readByte())
			case 2:
				return uint64(from.readFixed16())
			case 4:
				return uint64(from.readFixed32())
		}
		return from.readFixed64()
	}

	// Starts the fields of an object a `weak` field further in may point
	// back at.
	def track<T>(to Writer, object T) {
		to.objects.push(object)
	}

	// Ends the fields of the object the last `track` started.
	def untrack(to Writer) {
		to.objects.pop()
	}

	// Writes a `weak` field: how many tracked objects up its target is (1 is
	// the object that holds the field), or 0 when it is none or points at an
	// object that is not being written around it.
	def writeLink<F>(to Writer, target ?F) {
		if target is none {
			to.putByte(0)
			return
		}
		let held any = target
		let count = to.objects.len()
		for let up = 1; up <= count; up++ {
			if to.objects[count - up] == held {
				to.putCount(up)
				return
			}
		}
		to.putByte(0)
	}

	// `track` for an object being read: it exists, with zero fields, before
	// its fields are read.
	def trackRead<T>(from Reader, object T) {
		from.objects.push(object)
	}

	// Ends the fields of the object the last `trackRead` started.
	def untrackRead(from Reader) {
		from.objects.pop()
	}

	// Reads what `writeLink<F>` wrote: the object that many levels up, or
	// none. A level that does not exist, or holds an object of another type,
	// is a failure.
	def readLink<F>(from Reader) ?F {
		let count = from.objects.len()
		let up = from.readIndex(count + 1)
		return none when up == 0
		let held = from.objects[count - up]
		if held is F {
			return held
		}
		from.reject("a link points at an object of another type")
		return none
	}
}
