internal partial module std.services.ipc.wire {
	use (
		std.crypto::(UUID, parseUUID)
		std.data.encoding::(hexencode, hexdecode)
		std.math::(Decimal, parseDecimal)
		std.net::(Address)
		std.net.url
		std.services.ipc::*
		std.testing
		std.time
		std.time::(Date, DateTime, TimeOfDay)
		std.units::(Pixels)
	)

	enum Level {
		Low,
		Mid  = 5,
		High,
	}

	enum Access {
		Read  = 1,
		Write = 2,
		Run   = 4,
	}

	enum Status {
		Ok     = "OK",
		Failed = "FAILED",
	}

	struct Order {
		customer string
		item     string
		quantity int
	}

	struct Inner {
		small int8
		note  ?string
	}

	struct Outer {
		id    uint32
		inner Inner
		tags  string[]
		ratio float32
		spare int | string
	}

	struct Pair<A, B> {
		first  A
		second B
	}

	struct Empty {}

	type Meters = float

	type Shape = Order | string | int

	@portable
	type Account {
		owner            string
		internal balance int64   = 0
		limits           int32[] = []
	}

	@portable
	type Branch {
		name        string
		weak parent ?Branch
		weak root   ?Branch
		kids        Branch[] = []
	}

	// Crosses as its reading alone, and refuses one below absolute zero.
	type Reading {
		celsius           float
		internal rendered ?string

		def toWire() float {
			return celsius
		}

		def fromWire(wire float) !none {
			fail "below absolute zero" when wire < -273.15
			celsius = wire
		}
	}

	// Crosses as a tuple of its two ends, whatever their type.
	type Span<T> {
		low    T
		high   T
		checks int = 0

		def toWire() (T, T) {
			return (low, high)
		}

		def fromWire(wire (T, T)) !none {
			(low, high) = wire
		}
	}

	union Bits {
		whole int32
		real  float
		flag  bool
	}

	union Narrow {
		small int16
		tiny  byte
	}

	struct Loop {
		next ?Loop
	}

	// The bytes of `value` on the wire, in hex.
	def wireOf<T>(value T) !string {
		let w = new Writer()
		encode<T>(w, value)
		try w.verify()
		return hexencode(w.bytes())
	}

	// The value read from a message given in hex, which must hold nothing
	// else.
	def valueOf<T>(message string) !T {
		let r = new Reader(try hexdecode(message))
		let out = decode<T>(r)
		try r.done()
		return out
	}

	// `value` after a trip over the wire.
	def crossed<T>(value T) !T {
		return valueOf<T>(try wireOf<T>(value))
	}

	// Why reading a `T` from the message fails; "" when it does not.
	def refusal<T>(message string) string {
		let why = ""
		valueOf<T>(message) onerror (err error) {
			why = err.message
			recover none
		}
		return why
	}

	// The text an optional holds, "<none>" when it holds none.
	def textOf(value ?string) string {
		return "<none>" when value is none
		return value
	}

	// Whether a weak field points at `expected` itself.
	def isBranch(link ?Branch, expected Branch) bool {
		return false when link is none
		return link == expected
	}

	check "IPC wire values" {
		@test()
		def TestOneByteValues() !none {
			assert try wireOf<bool>(true) == "01"
			assert try wireOf<bool>(false) == "00"
			assert try wireOf<byte>(byte(0xAB)) == "ab"
			assert try wireOf<int8>(int8(-1)) == "ff"
			assert try wireOf<uint8>(uint8(200)) == "c8"
			assert try crossed<bool>(true)
			assert try crossed<byte>(byte(0xAB)) == byte(0xAB)
			assert try crossed<int8>(int8(-128)) == int8(-128)
			assert try crossed<uint8>(uint8(200)) == uint8(200)
			assert refusal<bool>("02") != ""
		}

		@test()
		def TestIntegers() !none {
			assert try wireOf<int>(-1) == "01"
			assert try wireOf<int16>(int16(300)) == "d804"
			assert try wireOf<uint32>(uint32(300)) == "ac02"
			assert try wireOf<char>('é') == "e901"
			assert try crossed<int>(int(0).MIN()) == int(0).MIN()
			assert try crossed<int16>(int16(-32768)) == int16(-32768)
			assert try crossed<int32>(int32(0).MAX()) == int32(0).MAX()
			assert try crossed<int64>(int64(0).MAX()) == int64(0).MAX()
			assert try crossed<uint16>(uint16(65535)) == uint16(65535)
			assert try crossed<uint64>(uint64(0).MAX()) == uint64(0).MAX()
			assert try crossed<uint>(uint(77)) == uint(77)
			assert try crossed<int128>(int128(0).MIN()) == int128(0).MIN()
			assert try crossed<uint128>(uint128(0).MAX()) == uint128(0).MAX()
			assert try crossed<char>('€') == '€'
			assert try crossed<duration>(90s) == 90s
			// 40000 does not fit an int16, 70000 not a uint16.
			assert refusal<int16>(try wireOf<int>(40000)) != ""
			assert refusal<uint16>(try wireOf<uint>(uint(70000))) != ""
			assert refusal<int32>(try wireOf<int>(int(1) << 40)) != ""
			// A surrogate is no character.
			assert refusal<char>(try wireOf<uint>(uint(0xD800))) != ""
		}

		@test()
		def TestEnums() !none {
			assert try wireOf<Level>(Level.Mid) == "0a"
			assert try wireOf<Level>(Level.High) == "0c"
			assert try crossed<Level>(Level.Low) == Level.Low
			assert try crossed<Level>(Level.High) == Level.High
			// A combination of members is a value of the enum too.
			let both = Access.Read | Access.Write
			assert try wireOf<Access>(both) == "06"
			assert try crossed<Access>(both) == both
			assert try wireOf<Status>(Status.Failed) == "01"
			assert try crossed<Status>(Status.Failed) == Status.Failed
			assert (try crossed<Status>(Status.Ok)).value == "OK"
			assert refusal<Status>("02") != ""
		}

		@test()
		def TestFloats() !none {
			assert try wireOf<float32>(float32(1.5)) == "0000c03f"
			assert try wireOf<float64>(float64(1.5)) == "000000000000f83f"
			assert try wireOf<float>(1.5) == "000000000000f83f"
			assert try crossed<float32>(float32(-0.25)) == float32(-0.25)
			assert try crossed<float>(1e300) == 1e300
			assert refusal<float>("0000c03f") != ""
		}

		@test()
		def TestStringsAndBytes() !none {
			assert try wireOf<string>("hé") == "0368c3a9"
			assert try wireOf<string>("") == "00"
			assert try wireOf<byte[]>(byte[1, 2, 3]) == "03010203"
			assert try crossed<string>("hé €") == "hé €"
			assert hexencode(try crossed<byte[]>(byte[9, 8, 7, 6])) == "09080706"
			assert refusal<string>("02c328") != ""
			assert refusal<string>("0568") != ""
		}

		@test()
		def TestArrays() !none {
			assert try wireOf<string[]>(["a", "bc"]) == "020161026263"
			assert try wireOf<bool[]>([true, false, true]) == "03010001"
			assert try wireOf<int32[]>([int32(1), int32(-1)]) == "0201000000ffffffff"
			assert try wireOf<uint16[]>([uint16(0x0102), uint16(0xFFFE)]) == "020201feff"
			assert try wireOf<int[]>([1, -2]) == "020100000000000000feffffffffffffff"
			assert try wireOf<float32[]>([float32(1.5)]) == "010000c03f"
			assert try wireOf<float[]>([1.5]) == "01000000000000f83f"
			assert try wireOf<int8[]>([int8(-1), int8(2)]) == "02ff02"
			assert try wireOf<int[][]>([[1], []]) == "0201010000000000000000"
			let words = try crossed<string[]>(["x", "", "yz"])
			assert words.len() == 3 && words[0] == "x" && words[1] == "" && words[2] == "yz"
			let nothing = try crossed<int[]>(int[])
			assert nothing.len() == 0
			let nested = try crossed<int[][]>([[1, 2], [], [3]])
			assert nested.len() == 3 && nested[0][1] == 2 && nested[1].len() == 0 && nested[2][0] == 3
			// A count the message cannot hold is refused before anything
			// is allocated for it.
			assert refusal<string[]>("ffffffff0f") != ""
			assert refusal<int[]>("05010000") != ""
		}

		// Arrays of fixed-size numbers cross as one block, whole vectors at a
		// time: every length around a vector's width must give the same bytes
		// as writing the elements one by one.
		@test()
		def TestNumberBlocks() !none {
			for let count = 0; count <= 70; count++ {
				let bytes = int8[]
				let shorts = int16[]
				let words = uint32[]
				let singles = float32[]
				let longs = int64[]
				let doubles = float[]
				let expectShorts = new Writer()
				let expectWords = new Writer()
				let expectSingles = new Writer()
				let expectLongs = new Writer()
				let expectDoubles = new Writer()
				for let i = 0; i < count; i++ {
					let v = i * 2654435761 - 977
					bytes.push(int8(v % 128))
					shorts.push(int16(v % 32768))
					words.push(uint32(i * 2654435761))
					singles.push(float32(v) / 3)
					longs.push(int64(v) * 1000003)
					doubles.push(float(v) / 7)
					expectShorts.putFixed16(uint16(shorts[i]))
					expectWords.putFixed32(words[i])
					expectSingles.putFloat32(singles[i])
					expectLongs.putFixed64(uint64(longs[i]))
					expectDoubles.putFloat(doubles[i])
				}
				let head = new Writer()
				head.putCount(count)
				let prefix = hexencode(head.bytes())
				assert try wireOf<int16[]>(shorts) == prefix + hexencode(expectShorts.bytes())
				assert try wireOf<uint32[]>(words) == prefix + hexencode(expectWords.bytes())
				assert try wireOf<float32[]>(singles) == prefix + hexencode(expectSingles.bytes())
				assert try wireOf<int64[]>(longs) == prefix + hexencode(expectLongs.bytes())
				assert try wireOf<float[]>(doubles) == prefix + hexencode(expectDoubles.bytes())
				let gotBytes = try crossed<int8[]>(bytes)
				let gotShorts = try crossed<int16[]>(shorts)
				let gotWords = try crossed<uint32[]>(words)
				let gotSingles = try crossed<float32[]>(singles)
				let gotLongs = try crossed<int64[]>(longs)
				let gotDoubles = try crossed<float[]>(doubles)
				assert gotBytes.len() == count && gotShorts.len() == count && gotWords.len() == count
				assert gotSingles.len() == count && gotLongs.len() == count && gotDoubles.len() == count
				for let i = 0; i < count; i++ {
					assert gotBytes[i] == bytes[i] && gotShorts[i] == shorts[i] && gotWords[i] == words[i]
					assert gotSingles[i] == singles[i] && gotLongs[i] == longs[i] && gotDoubles[i] == doubles[i]
				}
			}
		}

		@test()
		def TestMaps() !none {
			assert try wireOf<map<string, int>>(map<string, int>{"a": 1, "b": -2}) == "020161020162" + "03"
			let ages = try crossed<map<string, int>>(map<string, int>{"zoe": 31, "al": 7})
			assert ages.len() == 2 && ages["zoe"] == 31 && ages["al"] == 7
			// Entries arrive in the order they were written.
			assert ages.keys()[0] == "zoe"
			let byLevel = try crossed<map<Level, string[]>>(map<Level, string[]>{Level.High: ["x", "y"]})
			assert byLevel[Level.High].len() == 2 && byLevel[Level.High][1] == "y"
			assert refusal<map<string, int>>("ffffff7f") != ""
		}

		@test()
		def TestOptionals() !none {
			let absent ?string = none
			let present ?string = "x"
			assert try wireOf<?string>(absent) == "00"
			assert try wireOf<?string>(present) == "010178"
			assert try crossed<?string>(absent) is none
			assert textOf(try crossed<?string>(present)) == "x"
			let order ?Order = Order{customer: "ada", item: "desk", quantity: 2}
			let got = try crossed<?Order>(order)
			assert !(got is none)
			assert refusal<?string>("020178") != ""
		}

		@test()
		def TestStructsAndTuples() !none {
			assert try wireOf<Order>(Order{customer: "ada", item: "desk", quantity: 2}) == "03616461" + "046465736b" + "04"
			let order = try crossed<Order>(Order{customer: "ada", item: "desk", quantity: -3})
			assert order.customer == "ada" && order.item == "desk" && order.quantity == -3
			let outer = try crossed<Outer>(Outer{id: uint32(9), inner: Inner{small: int8(-4), note: "n"}, tags: ["a", "b"], ratio: float32(0.5), spare: "s"})
			assert outer.id == uint32(9) && outer.inner.small == int8(-4) && textOf(outer.inner.note) == "n"
			assert outer.tags.len() == 2 && outer.tags[1] == "b" && outer.ratio == float32(0.5) && outer.spare is string
			assert try wireOf<(int, string, bool)>((7, "x", true)) == "0e" + "0178" + "01"
			let (number, text, flag) = try crossed<(int, string, bool)>((7, "x", true))
			assert number == 7 && text == "x" && flag
			let pair = try crossed<Pair<int, string>>(Pair<int, string>{first: 4, second: "four"})
			assert pair.first == 4 && pair.second == "four"
			let orders = try crossed<Order[]>([Order{customer:"a", item:"b", quantity:1}, Order{customer:"c", item:"d", quantity:2}])
			assert orders.len() == 2 && orders[1].customer == "c" && orders[1].quantity == 2
			// Values that take no bytes: the count alone is all there is.
			assert try wireOf<Empty[]>([Empty{}, Empty{}]) == "02"
			assert (try crossed<Empty[]>([Empty{}, Empty{}])).len() == 2
			// A struct of another module.
			let caller = try crossed<Caller>(Caller{address: "10.0.0.1:7400", identity: "ada", method: "shop.Orders.place"})
			assert caller.address == "10.0.0.1:7400" && caller.identity == "ada" && caller.method == "shop.Orders.place"
			assert refusal<Order>("0361646104646573") != ""
			assert refusal<Order>("03616461046465736b0400") != ""
		}

		@test()
		def TestPortableTypes() !none {
			let account = new Account()
			account.owner = "ada"
			account.balance = -250
			account.limits = [int32(10), int32(20)]
			assert try wireOf<Account>(account) == "03616461" + "f303" + "020a00000014000000"
			let got = try crossed<Account>(account)
			assert got.owner == "ada" && got.balance == -250 && got.limits.len() == 2 && got.limits[1] == int32(20)
		}

		// A weak field crosses as how far up its target is and is linked to
		// that object again on arrival.
		@test()
		def TestWeakFields() !none {
			let root = new Branch()
			root.name = "root"
			let left = new Branch()
			left.name = "left"
			left.parent = root
			left.root = root
			let leaf = new Branch()
			leaf.name = "leaf"
			leaf.parent = left
			leaf.root = root
			left.kids.push(leaf)
			root.kids.push(left)
			let stranger = new Branch()
			stranger.name = "stranger"
			let right = new Branch()
			right.name = "right"
			right.parent = stranger
			right.root = right
			root.kids.push(right)

			let got = try crossed<Branch>(root)
			assert got.name == "root" && got.parent is none && got.root is none && got.kids.len() == 2
			let gotLeft = got.kids[0]
			assert gotLeft.name == "left" && isBranch(gotLeft.parent, got) && isBranch(gotLeft.root, got)
			let gotLeaf = gotLeft.kids[0]
			assert gotLeaf.name == "leaf" && isBranch(gotLeaf.parent, gotLeft) && isBranch(gotLeaf.root, got)
			// A target that is not being sent around the field arrives as
			// none; one that is the object itself is itself.
			let gotRight = got.kids[1]
			assert gotRight.parent is none && isBranch(gotRight.root, gotRight)
			// A level that does not exist is refused: "root", no parent,
			// a root link two levels up from the outermost object.
			assert refusal<Branch>("04726f6f74" + "00" + "02" + "00") != ""
		}

		@test()
		def TestUnions() !none {
			let text Shape = "hi"
			let number Shape = 7
			let order Shape = Order{customer: "ada", item: "desk", quantity: 2}
			assert try wireOf<Shape>(text) == "01" + "026869"
			assert try wireOf<Shape>(number) == "02" + "0e"
			assert try wireOf<Shape>(order) == "00" + "03616461046465736b04"
			let gotText = try crossed<Shape>(text)
			assert gotText is string
			let gotNumber = try crossed<Shape>(number)
			assert gotNumber is int
			let gotOrder = try crossed<Shape>(order)
			if gotOrder is Order {
				assert gotOrder.item == "desk"
			} else {
				assert false
			}
			let shapes = try crossed<Shape[]>([text, number, order])
			assert shapes.len() == 3 && shapes[0] is string && shapes[1] is int && shapes[2] is Order
			assert refusal<Shape>("03") != ""
			// A union that was never given a value cannot be sent.
			let unset Shape
			let sent = true
			wireOf<Shape>(unset) onerror (err error) {
				sent = false
				recover ""
			}
			assert !sent
		}

		@test()
		def TestAliasesAndQuantities() !none {
			let length Meters = 1.5
			assert try wireOf<Meters>(length) == "000000000000f83f"
			assert try crossed<Meters>(length) == length
			let width Pixels = 12(px)
			assert try wireOf<Pixels>(width) == try wireOf<float>(12.0)
			assert try crossed<Pixels>(width) == width
		}

		@test()
		def TestBigIntegers() !none {
			let big = try parseBigInt("123456789012345678901234567890")
			assert try wireOf<bigint>(bigint(0)) == "0000"
			assert try wireOf<bigint>(bigint(-258)) == "01" + "020102"
			assert try crossed<bigint>(big) == big
			assert try crossed<bigint>(-big) == -big
			assert try crossed<bigint>(bigint(0)) == bigint(0)
			assert refusal<bigint>("0205") != ""
		}

		// A `union` declaration of numbers crosses as its bytes.
		@test()
		def TestUnionDeclarations() !none {
			let real = Bits.real(1.5)
			assert try wireOf<Bits>(real) == "000000000000f83f"
			assert (try crossed<Bits>(real)).real == 1.5
			let whole = Bits.whole(int32(-2))
			assert (try crossed<Bits>(whole)).whole == int32(-2)
			let small = Narrow.small(int16(-2))
			assert try wireOf<Narrow>(small) == "feff"
			assert (try crossed<Narrow>(small)).small == int16(-2)
			assert (try crossed<Narrow>(Narrow.tiny(byte(7)))).tiny == byte(7)
			assert refusal<Narrow>("fe") != ""
		}

		// A type with `toWire` and `fromWire` crosses as what they say.
		@test()
		def TestOwnWireForm() !none {
			let reading = new Reading()
			reading.celsius = 21.5
			reading.rendered = "21.5 °C"
			assert try wireOf<Reading>(reading) == try wireOf<float>(21.5)
			let got = try crossed<Reading>(reading)
			assert got.celsius == 21.5 && got.rendered is none
			let why = refusal<Reading>(try wireOf<float>(-300.0))
			assert why.contains("below absolute zero")
			let readings = try crossed<Reading[]>([reading, reading])
			assert readings.len() == 2 && readings[1].celsius == 21.5

			let span = new Span<int>()
			span.low = 3
			span.high = 9
			span.checks = 4
			assert try wireOf<Span<int>>(span) == try wireOf<(int, int)>((3, 9))
			let gotSpan = try crossed<Span<int>>(span)
			assert gotSpan.low == 3 && gotSpan.high == 9 && gotSpan.checks == 0

			let started = time.now()
			let arrived = try crossed<time.Time>(started)
			assert arrived.unixNs() == started.unixNs() && arrived.monotonicNs() == 0
		}

		// The value types of std that are marked `@portable`.
		@test()
		def TestStdValueTypes() !none {
			let id = try parseUUID("123e4567-e89b-42d3-a456-426614174000")
			assert (try crossed<UUID>(id)).str() == id.str()
			let link = try url.parse("https://ada:pw@example.com:8443/a%20b?q=1#top")
			assert (try crossed<url.URL>(link)).str() == link.str()
			let moment = new DateTime(new Date(2026, 10, 8), new TimeOfDay(17, 30, 5, 250))
			let gotWhen = try crossed<DateTime>(moment)
			assert gotWhen.date.year == 2026 && gotWhen.date.month == 10 && gotWhen.date.day == 8
			assert gotWhen.time.hour == 17 && gotWhen.time.minute == 30 && gotWhen.time.second == 5 && gotWhen.time.nanosecond == 250
			let endpoint = new Address()
			try endpoint.parse("[::1]:7400")
			let gotEndpoint = try crossed<Address>(endpoint)
			assert gotEndpoint.host == endpoint.host && gotEndpoint.port == 7400 && gotEndpoint.isIPv6
			let price = try parseDecimal("-19.99")
			assert (try crossed<Decimal>(price)).str() == "-19.99"
			let huge = try parseDecimal("123456789012345678901234567890.5")
			assert (try crossed<Decimal>(huge)).str() == huge.str()
			let token Secret<string> = "sk-live-1234"
			assert try wireOf<Secret<string>>(token) == try wireOf<string>("sk-live-1234")
			assert (try crossed<Secret<string>>(token)).reveal() == "sk-live-1234"
		}

		// A value that contains itself, and a message nested deeper than the
		// reader allows, fail instead of running the stack out.
		@test()
		def TestNestingLimit() !none {
			let loop = Loop{}
			loop.next = loop
			let sent = true
			wireOf<Loop>(loop) onerror (err error) {
				sent = false
				recover ""
			}
			assert !sent
			let deep = ""
			for let i = 0; i < 300; i++ {
				deep += "01"
			}
			assert refusal<Loop>(deep + "00") != ""
			let chain = Loop{next: Loop{next: Loop{}}}
			let got = try crossed<Loop>(chain)
			assert !(got.next is none)
		}
	}
}
