partial module std.services {
	use (
		std.reflection
		std.io::WriteCloser
	)

	// How important a log entry is, from Debug up to Fatal.
	//
	// Entries below the configured level are dropped.
	enum LogLevel {
		// Detailed diagnostic information intended primarily for development and debugging.
		Debug,
		// General informational messages describing normal application operation.
		Info,
		// Indicates a potentially problematic condition that does not prevent normal operation.
		Warning,
		// Indicates an operation or component failure that may require attention.
		Error,
		// Indicates a severe failure from which the application may not be able to recover.
		Fatal
	}

	// Represents a structured log entry.
	struct LogRecord {
		// Severity level of the log entry.
		level   LogLevel
		// Human-readable log message.
		message string
		// Structured fields associated with the log entry.
		fields  map<string, any>
	}

	// Encodes a structured log record into its output representation.
	//
	// Implementations may encode records as text, JSON, or any other supported format.
	interface LogEncoder {
		def encode(record LogRecord) !byte[]
	}

	// Configures a log writer and the records routed to it.
	struct LogWriterConfig {
		// Writer receiving encoded log records.
		//
		// The Logging service closes the writer when the service stops or the
		// writer is removed from configuration.
		writer  WriteCloser
		// Encoder used to serialize records before they are passed to the writer.
		encoder LogEncoder
		// Log levels routed to this writer.
		//
		// Only records whose level is explicitly included are written.
		levels  LogLevel[]
	}

	// Configures the Logging service.
	struct LogConfig {
		// Minimum log level processed by the Logging service.
		//
		// Records below this level are discarded before writer-specific routing.
		level LogLevel = LogLevel.Info

		// Writers receiving log records.
		//
		// Each writer independently defines its encoding and accepted log levels.
		writers LogWriterConfig[]
	}

	// Provides a structured representation of a value for logging.
	//
	// Types may implement LogValue to control how their values are represented
	// when included in structured log fields.
	//
	// The returned value should contain only information appropriate for logging
	// and may omit, redact, or transform sensitive or unnecessarily verbose data.
	interface LogValue {
		def logValue() any
	}

	// Writes log entries to the configured sinks, with the fields @logContext attaches and
	// entries below the configured level dropped.
	service Logging {
		description               = ""
		dependencies              = Dependencies{
			hard: [Storage]
		}
		lifecycle                 = Lifecycle{
			start: StartMode.Automatic,
			restart: RestartMode.Always,
		}
		permissions  Permission[]

		cfg LogConfig = LogConfig{}

		// Applies the level and the sinks. Does not fail today.
		def config<T>(val T) !none {}

		// Starts the service. Does not fail today.
		async def start() !none {
			return none
		}

		// Stops the service. Does not fail today.
		async def stop() !none {
			return none
		}

		// Stops the service and starts it again. Does not fail today.
		async def restart() !none {
			return none
		}

		// Writes a log entry at debug level.
		//
		// Fails when a sink cannot be written.
		@trackCaller()
		@commit()
		def debug(message string, fields map<string, any> = {}) !none {
			return none
		}

		// Writes a log entry at info level.
		//
		// Fails when a sink cannot be written.
		@trackCaller()
		@commit()
		def info(message string, fields map<string, any> = {}) !none {
			return none
		}

		// Writes a log entry at warning level.
		//
		// Fails when a sink cannot be written.
		@trackCaller()
		@commit()
		def warning(message string, fields map<string, any> = {}) !none {
			return none
		}

		// Writes a log entry at error level.
		@trackCaller()
		@commit()
		def error(message string, fields map<string, any> = {}) !none {
			return none
		}

		// Writes a log entry at fatal level.
		//
		// Fails when a sink cannot be written.
		@trackCaller()
		@commit()
		def fatal(message string, fields map<string, any> = {}) !none {
			return none
		}

		// Writes a log entry at the given level.
		//
		// Fails when a sink cannot be written.
		@trackCaller()
		@commit()
		def log(level LogLevel, message string, fields map<string, any> = {}) !none {
			return none
		}

		// The lowest level that is written.
		@query()
		def level() LogLevel {
			return cfg.level
		}

		// Sets the lowest level that is written.
		//
		// Entries below it are dropped before they reach any writer.
		@commit()
		def setLevel(level LogLevel) {
			cfg.level = level
		}
	}

	// Attaches fields to every log entry written from the type's methods.
	//
	// A closer @logContext or a field passed to the call itself wins on the same key.
	meta def logContext(target reflection.TypeMetaContext, fields map<string, any>) {}

	// Attaches fields to every log entry written from the method.
	meta def logContext(target reflection.MethodMetaContext, fields map<string, any>) {}

	// Attaches fields to every log entry written from the function.
	meta def logContext(target reflection.FunctionMetaContext, fields map<string, any>) {}

	// Writes a log entry each time the function is called.
	//
	// The arguments go in as fields.
	meta def log(target reflection.FunctionMetaContext, level LogLevel = LogLevel.Debug) {}

	// Writes a log entry each time the method is called.
	//
	// The arguments go in as fields.
	meta def log(target reflection.MethodMetaContext, level LogLevel = LogLevel.Debug) {}

	// Marks a value that must not show up in developer output.
	//
	// Logs, traces, watches, crash reports and the IDE inspector print it redacted.
	//
	// struct Credentials { username string @sensitive() password string }
	//
	// @log() def login(username string, @sensitive() password string) {}
	meta def sensitive(target reflection.ParameterMetaContext) {}

	// Marks a field that must not show up in developer output.
	meta def sensitive(target reflection.FieldMetaContext) {}

	// Marks a property that must not show up in developer output.
	meta def sensitive(target reflection.PropertyMetaContext) {}
}
