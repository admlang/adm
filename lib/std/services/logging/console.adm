partial module std.services.logging {
	use std.os

	// The standard stream a ConsoleWriter writes to.
	enum ConsoleStream {
		// Standard error, where diagnostics go.
		Stderr,
		// Standard output.
		Stdout
	}

	// Writes each record as one line on standard error or standard output.
	//
	// ```
	// LogWriterConfig{writer: new ConsoleWriter(ConsoleStream.Stdout), encoder: new TextEncoder()}
	// ```
	type ConsoleWriter {
		internal stream ConsoleStream = ConsoleStream.Stderr

		def new(stream ConsoleStream = ConsoleStream.Stderr) {
			self.stream = stream
		}

		// Implements `io.Writer`: writes data and a line break in one call, and returns the
		// length of data. Fails when the stream is closed or refuses the write.
		def write(data byte[]) !int {
			let line = data + '\n'
			let target = stream == ConsoleStream.Stdout ?? (os.stdout, os.stderr)
			try target.write(line)
			return data.len()
		}

		// Implements `io.Closer`. The stream belongs to the process and stays open. Does not
		// fail.
		def close() !none {
			return none
		}
	}
}
