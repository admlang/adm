partial module std.services.logging {
	use (
		std.cli.terminal
		std.cli.terminal::(Ansi)
		std.os
		std.time
	)

	// Which records an encoder writes the call site (`file:line`) of.
	enum LogSource {
		// None.
		Never,
		// Debug entries only, where the place in the code is what is looked for.
		Debug,
		// Every record.
		Always
	}

	// Encodes a record as one line made to be read on a terminal, in color:
	//
	// ```
	// 14:05:09.250 ERROR billing  amount=12 user="u 1"  card declined
	// 14:05:09.251 DEBUG billing  path=prices.toml  loading price list  prices.adm:16
	// ```
	//
	// The fields stand before the message, sorted by name, two spaces apart from what is
	// around them, and a debug entry ends with the place it was written from. The time, the
	// module, the field names and the call site are dimmed, the field values are cyan, the
	// level takes its color (`DEBUG` white, `INFO` light blue, `WARN` and `ERROR` in the
	// terminal theme's warning and failure styles, `FATAL` white on red, `LOG` bright white for a plain entry), and the message of
	// an error or a fatal entry is bold. The colors follow `std.cli.terminal`: they are left
	// out when the stream is not a terminal, when `NO_COLOR` is set or `TERM` is `dumb`, and
	// forced by `FORCE_COLOR`, so the same encoder writes plain lines into a pipe or a file.
	//
	// ```
	// LogWriterConfig{writer: new ConsoleWriter(), encoder: new ConsoleEncoder()}
	// ```
	type ConsoleEncoder {
		// How far east of UTC the written time is: `2h` writes 16:05 for 14:05 UTC.
		offset duration  = 0s
		// Which records end with their call site (`file:line`).
		source LogSource = LogSource.Debug

		// The stream whose terminal decides the colors: the one the writer writes to.
		internal stream ConsoleStream = ConsoleStream.Stderr

		def new(stream ConsoleStream = ConsoleStream.Stderr, offset duration = 0s, source LogSource = LogSource.Debug) {
			self.stream = stream
			self.offset = offset
			self.source = source
		}

		// Implements `LogEncoder`. Does not fail.
		def encode(record LogRecord) !byte[] {
			let out = stream == ConsoleStream.Stdout ?? (os.stdout, os.stderr)
			let level = record.level
			let grave = !(level is none) && level.ordinal >= LogLevel.Error.ordinal
			let message = oneLine(record.message)
			message = terminal.color(message, Ansi.Default, bold = true, stream = out) when grave
			let line = terminal.dim(clock(record.time), out) + " " + levelTag(level, out)
			line += " " + terminal.dim(record.caller.moduleName, out) when record.caller.moduleName != ""
			let names = record.fields.keys()
			names.sort((a, b) => a < b)
			if names.len() > 0 {
				let tags = ""
				for let (i, name) in names {
					tags += " " when i > 0
					tags += terminal.dim(name + "=", out) + terminal.color(fieldText(record.fields.get(name)), Ansi.Cyan, stream = out)
				}
				line += "  " + tags
			}
			line += "  " + message
			let placed = source == LogSource.Always || (source == LogSource.Debug && !(level is none) && level == LogLevel.Debug)
			line += "  " + terminal.dim("{record.caller.fileName}:{record.caller.line}", out) when placed && record.caller.fileName != ""
			return line.bytes()
		}

		// The time of day with milliseconds: `14:05:09.250`.
		internal def clock(at int64) string {
			let moment = time.fromUnixNs(at)
			let millis = "{moment.nanosecond() / 1000000}".padStart(3, "0")
			return moment.str(time.TimeFormat.TimeOnly, offset) + "." + millis
		}

		// The level as a tag of five characters, in its color; `LOG` in bright white for a plain
		// entry.
		internal def levelTag(level ?LogLevel, out os.File) string {
			return terminal.color("LOG  ", Ansi.BrightWhite, stream = out) when level is none
			match level {
				case LogLevel.Debug:
					return terminal.color("DEBUG", Ansi.White, stream = out)
				case LogLevel.Info:
					return terminal.color("INFO ", Ansi.BrightBlue, stream = out)
				case LogLevel.Warning:
					return terminal.warning("WARN ", out)
				case LogLevel.Error:
					return terminal.failure("ERROR", out)
				default:
					return terminal.color("FATAL", Ansi.BrightWhite, Ansi.Red, bold = true, stream = out)
			}
		}
	}
}
