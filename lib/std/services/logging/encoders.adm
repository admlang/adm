partial module std.services.logging {
	use (
		std.data.encoding::(JSON)
		std.services::(Application)
		std.time
	)

	// Encodes a record as one line in the form of the Apache error log:
	//
	// ```
	// [Mon Oct 12 14:05:09.250000 2026] [billing:error] [pid 4242] invoice.adm:17: card declined amount=12 user="u 1"
	// ```
	//
	// The bracketed parts are the time, the module the entry was written from with the level
	// (`debug`, `info`, `warn`, `error`, `crit`, and `log` for a plain entry), and the
	// process. The call site and the
	// message follow, then the fields sorted by name as `name=value`; a text value is quoted
	// when it is empty or holds a space, a quote or `=`, and a line break in the message or a
	// value is written as `\n`.
	type TextEncoder {
		// How far east of UTC the written time is: `2h` writes 16:05 for 14:05 UTC.
		offset duration = 0s
		// Whether the call site (`file:line:`) is written.
		source bool     = true
		// Whether the process (`[pid n]`) is written.
		pid    bool     = true

		def new(offset duration = 0s, source bool = true, pid bool = true) {
			self.offset = offset
			self.source = source
			self.pid = pid
		}

		// Implements `LogEncoder`. Does not fail.
		def encode(record LogRecord) !byte[] {
			let line = "[" + stamp(record.time) + "] [" + record.caller.moduleName + ":" + levelText(record.level) + "]"
			line += " [pid {Application.pid()}]" when pid
			line += " {record.caller.fileName}:{record.caller.line}:" when source && record.caller.fileName != ""
			line += " " + oneLine(record.message)
			let names = record.fields.keys()
			names.sort((a, b) => a < b)
			for let (_, name) in names {
				line += " " + name + "=" + fieldText(record.fields.get(name))
			}
			return line.bytes()
		}

		// The time as Apache writes it: `Mon Oct 12 14:05:09.250000 2026`.
		internal def stamp(at int64) string {
			let moment = time.fromUnixNs(at)
			// asctime: `Mon Oct 12 14:05:09 2026`, the day padded with a space.
			let text = moment.str(time.TimeFormat.ANSIC, offset)
			let day = text[8:9] == " " ?? ("0" + text[9:10], text[8:10])
			let micros = "{moment.nanosecond() / 1000}".padStart(6, "0")
			return text[:8] + day + text[10:19] + "." + micros + text[19:]
		}

		// The level under the name Apache gives it; `log` for a plain entry.
		internal def levelText(level ?LogLevel) string {
			return "log" when level is none
			match level {
				case LogLevel.Debug:
					return "debug"
				case LogLevel.Info:
					return "info"
				case LogLevel.Warning:
					return "warn"
				case LogLevel.Error:
					return "error"
				default:
					return "crit"
			}
		}
	}

	// Encodes a record as one JSON object on one line, for collectors that read a record per
	// line or per datagram:
	//
	// ```
	// {"time":"2026-10-12T14:05:09.25Z","level":"error","message":"card declined","module":"billing","file":"invoice.adm","line":17,"amount":12,"user":"u 1"}
	// ```
	//
	// `time` is RFC 3339 in UTC, `level` one of `debug`, `info`, `warning`, `error`, `fatal`,
	// and `log` for a plain entry.
	// `trace` and `span` follow for an entry written inside a span of `Telemetry`.
	// The fields follow sorted by name, each value encoded as `std.data.encoding.JSON` encodes
	// it. A field named like one of the record's own keys is written as `fields.<name>`.
	type JSONEncoder {
		// The key the fields go under as one object; empty writes them beside the record's
		// own keys.
		fieldsKey string = ""
		// Whether the call site (`module`, `file`, `line`) is written.
		source    bool   = true

		internal codec JSON = new JSON()

		def new(fieldsKey string = "", source bool = true) {
			self.fieldsKey = fieldsKey
			self.source = source
		}

		// Implements `LogEncoder`. Does not fail.
		def encode(record LogRecord) !byte[] {
			let level = record.level
			let levelName = level is none ?? ("log", level.name.lower())
			let out = "\u007B" + member("time", time.fromUnixNs(record.time).str()) + "," + member("level", levelName) + "," + member("message", record.message)
			out += "," + member("module", record.caller.moduleName) + "," + member("file", record.caller.fileName) + "," + member("line", record.caller.line) when source && record.caller.fileName != ""
			out += "," + member("trace", record.trace) when record.trace != ""
			out += "," + member("span", record.span) when record.span != ""
			let names = record.fields.keys()
			names.sort((a, b) => a < b)
			if fieldsKey != "" {
				out += "," + text(fieldsKey) + ":\u007B"
				for let (i, name) in names {
					out += "," when i > 0
					out += member(name, record.fields.get(name))
				}
				return (out + "\u007D\u007D").bytes()
			}
			for let (_, name) in names {
				let key = name in ["time", "level", "message", "module", "file", "line", "trace", "span"] ?? ("fields." + name, name)
				out += "," + member(key, record.fields.get(name))
			}
			return (out + "\u007D").bytes()
		}

		// One `"name":value` member.
		internal def member(name string, value ?any) string {
			return text(name) + ":null" when value is none
			return text(name) + ":" + text(value)
		}

		// A value as JSON text.
		internal def text(value any) string {
			return string(codec.encode(value))
		}
	}

	// A field's value: text quoted when a reader could not tell where it ends.
	internal def fieldText(value ?any) string {
		return "none" when value is none
		let text = oneLine("{value}")
		return text unless text == "" || text.contains(" ") || text.contains("\"") || text.contains("=")
		return "\"" + text.replace("\"", "\\\"") + "\""
	}

	// The text with its line breaks written as escapes, so a record stays one line.
	internal def oneLine(text string) string {
		return text unless text.contains("\n") || text.contains("\r")
		return text.replace("\r", "\\r").replace("\n", "\\n")
	}
}
