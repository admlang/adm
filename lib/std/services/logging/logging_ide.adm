// The Logging service's IDE panel: its level, writers, entries and counts.

partial module std.services.logging {
	use (
		std.ide::(ide, IdeKind, IdeLog, IdeLogEntry, IdeTable)
		std.reflection
	)

	// The configured writers as the IDE service panel lists them: what each one is, where it
	// writes, how it encodes and which levels it gets.
	internal def writersTable(sinks Sink[]) IdeTable {
		let rows = string[][]
		for let (_, sink) in sinks {
			let settings = sink.settings
			let levels = string[]
			for let (_, level) in settings.levels {
				levels.push(level.name)
			}
			rows.push([shortName(reflection.typeName(settings.writer)), writerTarget(settings.writer), shortName(reflection.typeName(settings.encoder)), levels.join(", ")])
		}
		return IdeTable{columns: ["Writer", "Target", "Encoder", "Levels"], rows: rows}
	}

	// A type's name without its module.
	internal def shortName(qualified string) string {
		let cut = qualified.lastIndexOf(".")
		return qualified when cut < 0
		return qualified[cut + 1:]
	}

	// Where one of this module's writers sends its records; empty for a writer from
	// elsewhere.
	internal def writerTarget(writer any) string {
		match writer {
			case ConsoleWriter:
				return writer.stream == ConsoleStream.Stdout ?? ("standard output", "standard error")
			case FileWriter:
				return writer.path + rotationText(writer.rotation)
			case NetworkWriter:
				return "{writer.address} ({writer.transport.name.lower()})"
			default:
				return ""
		}
	}

	// The rotation rules after a file's path; empty when the file never rotates.
	internal def rotationText(rotation LogRotation) string {
		let parts = string[]
		parts.push("at {rotation.maxSize} B") when rotation.maxSize > 0
		parts.push("every {rotation.period}") when rotation.period > 0s
		return "" when parts.len() == 0
		parts.push("keep {rotation.keep}") when rotation.keep > 0
		parts.push("for {rotation.maxAge}") when rotation.maxAge > 0s
		parts.push("gzip") when rotation.compress
		return ", new file " + parts.join(", ")
	}

	// The records as the IDE service panel shows them.
	internal def panelLog(records LogRecord[]) IdeLog {
		let entries = IdeLogEntry[]
		for let (_, record) in records {
			let level = record.level
			let names = record.fields.keys()
			names.sort((a, b) => a < b)
			let fields = string[][]
			for let (_, name) in names {
				fields.push([name, fieldText(record.fields.get(name))])
			}
			let caller = record.caller
			entries.push(IdeLogEntry{
				time:    record.time / 1000000,
				level:   level is none ?? ("log", level.name.lower()),
				source:  caller.moduleName,
				at:      caller.fileName == "" ?? ("", "{caller.fileName}:{caller.line}"),
				message: record.message,
				fields:  fields,
			})
		}
		return IdeLog{entries: entries}
	}

	partial service Logging {
		// The level below which entries are discarded.
		@ide(kind = IdeKind.Value, label = "Level", refresh = 1s)
		def ideLevel() string {
			return cfg.level.name
		}

		// The writers, where each writes, its encoder and its levels.
		@ide(kind = IdeKind.Table, label = "Writers", refresh = 1s, rows = 4)
		atomic def ideWriters() IdeTable {
			wire()
			return writersTable(sinks)
		}

		// The latest entries, kept from the first time the panel asks.
		@ide(kind = IdeKind.Log, label = "Entries", refresh = 1s, rows = 0)
		atomic def ideEntries() IdeLog {
			watched = true
			let from = recent.len() > panelEntries ?? (recent.len() - panelEntries, 0)
			return panelLog(recent[from:])
		}

		// Records handed to the writers, graphed over time.
		@ide(kind = IdeKind.Series, label = "Written", refresh = 1s, cumulative = true)
		def ideWritten() int {
			return int(written)
		}

		// Records waiting for the writer task.
		@ide(kind = IdeKind.Value, label = "Waiting", refresh = 1s)
		def ideWaiting() int {
			return int(accepted - written)
		}

		// Records dropped.
		@ide(kind = IdeKind.Value, label = "Dropped", refresh = 1s)
		def ideDropped() int {
			return int(lost)
		}

		@ide(kind = IdeKind.Action, label = "Set level", sets = "ideLevel")
		def ideSetLevel(level LogLevel) {
			setLevel(level)
		}

		// Waits until the writers have written what is queued.
		@ide(kind = IdeKind.Action, label = "Flush")
		def ideFlush() !none {
			try flush()
			return none
		}
	}
}
