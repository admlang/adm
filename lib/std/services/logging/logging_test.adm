partial module std.services.logging {
	use (
		std.ide::(ide, IdeLog, IdeLogEntry, IdeTable)
		std.reflection
		std.services.logging.tracing
		std.testing
		std.time
	)

	// Keeps what the service writes, for the tests to read.
	internal type MemoryWriter {
		lines  string[]
		closed int
		// Fails every write while set.
		broken bool

		def write(data byte[]) !int {
			fail "memory writer is broken" when broken
			lines.push(string(data))
			return data.len()
		}

		def close() !none {
			closed++
			return none
		}
	}

	// Encodes a record as `level message`, a plain entry as `- message`.
	internal type PlainEncoder {
		def encode(record LogRecord) !byte[] {
			let level = record.level
			return "- {record.message}".bytes() when level is none
			return "{level.name} {record.message}".bytes()
		}
	}

	internal type Masked {
		secret string

		def new(secret string) {
			self.secret = secret
		}

		def logValue() any {
			return "***"
		}
	}

	internal def sampleRecord() LogRecord {
		return LogRecord{
			level:   LogLevel.Error,
			message: "card declined",
			fields:  {"user": "u 1", "amount": 12},
			time:    1791813909250000000,
			caller:  CallerLocation{fileName: "invoice.adm", line: 17, moduleName: "billing"},
		}
	}

	// What a member Logging publishes to the IDE service panel answers, called as the IDE
	// service calls it.
	internal def panel(member string) ?any {
		for let (_, hit) in reflection.attrs(ide) {
			continue unless hit.node.qualifiedName == "std.services.logging.Logging." + member
			return reflection.call(hit.node, reflection.serviceInstance("std.services.logging.Logging"), [])
		}
		return none
	}

	internal def panelEntriesNow() !IdeLogEntry[] {
		let answer = panel("ideEntries")
		if answer is IdeLog {
			return answer.entries
		}
		fail "ideEntries did not answer an IdeLog"
	}

	internal struct Session {
		user  string
		token Secret<string>
	}

	@log(LogLevel.Info)
	internal def connectWith(host string, token Secret<string>) int {
		return host.len()
	}

	internal def writeFromATask(done channel<none>) {
		Logging.info("in a task started inside")
		done.offer(none)
	}

	@log(LogLevel.Info)
	internal def signIn(username string, @sensitive() password string, tries int = 1) int {
		return username.len() + tries
	}

	@logContext({"component": "billing", "order": 0})
	internal def refunded(amount int) int {
		Logging.info("refunding", {"order": 17})
		return amount
	}

	internal def noted(message string) {
		Logging.info(message)
	}

	@logErrors()
	internal def settle(account string, @sensitive() pin string, short bool) !int {
		expects {
			assert !(short) onerror fail "insufficient funds on {account}"
		}
		return pin.len()
	}

	internal let wrappedRuns = 0

	// Every call-wrapping annotation at once: the body must run once.
	@logContext({"component": "ledger"})
	@log(LogLevel.Info)
	@logErrors()
	@logSlow(0s)
	internal def wrapped(amount int) !int {
		wrappedRuns++
		Logging.info("inside")
		fail "over the limit" when amount > 100
		return amount
	}

	@logSlow(5ms)
	internal def crawl(pause duration) int {
		time.sleep(pause)
		return 1
	}

	internal struct Card {
		holder string
		@sensitive()
		number string
		limits int[]
	}

	internal struct Payment {
		amount int
		card   Card
		tags   map<string, string>
	}

	internal struct Plain {
		name string
		size int
	}

	internal type Till {
		@log()
		def ring(amount int) int {
			return amount * 2
		}
	}

	@logContext({"component": "ledger", "shard": 3, "live": true, "rate": 0.5, "region": {"zone": "eu"}})
	internal type Ledger {
		def post(amount int) {
			Logging.info("posted", {"amount": amount})
		}

		@logContext({"shard": 9, "op": "void"})
		def cancel() {
			Logging.info("voided", {"op": "void now"})
		}

		@log(LogLevel.Info)
		def audit(reason string) {
			let note = () => Logging.info("from a closure", {"why": reason})
			note()
		}
	}

	check "Logging annotations" {
		@test()
		def logWritesTheCallWithItsArguments() !none {
			let sink = new MemoryWriter()
			try Logging.config(LogConfig{level: LogLevel.Debug, writers: [LogWriterConfig{writer: sink, encoder: new JSONEncoder()}]})
			assert signIn("ada", "hunter2") == 4
			assert new Till().ring(21) == 42
			try Logging.flush()
			assert sink.lines.len() == 2
			let first = sink.lines[0]
			assert first.contains("\"level\":\"info\"")
			assert first.contains("\"message\":\"std.services.logging.signIn\"")
			// The entry names the function's own file and line as where it was written from.
			assert first.contains("\"module\":\"std.services.logging\",\"file\":\"logging_test.adm\",\"line\":")
			assert !first.contains("\"line\":0,")
			assert first.contains("\"password\":\"***\"")
			assert first.contains("\"username\":\"ada\"")
			assert first.contains("\"tries\":1")
			assert !first.contains("hunter2")
			let second = sink.lines[1]
			assert second.contains("\"level\":\"debug\"")
			assert second.contains("\"message\":\"std.services.logging.Till.ring\"")
			assert second.contains("\"module\":\"std.services.logging\",\"file\":\"logging_test.adm\"")
			assert second.contains("\"amount\":21")
			return none
		}

		@test()
		def logBelowTheLevelWritesNothingAndStillCalls() !none {
			let sink = new MemoryWriter()
			try Logging.config(LogConfig{level: LogLevel.Warning, writers: [LogWriterConfig{writer: sink, encoder: new JSONEncoder()}]})
			assert signIn("ada", "hunter2", 3) == 6
			assert refunded(5) == 5
			try Logging.flush()
			assert sink.lines.len() == 0
			return none
		}
	}

	check "Logging context and redaction" {
		@test()
		def contextGoesOnEveryEntryOfTheFunction() !none {
			let sink = new MemoryWriter()
			try Logging.config(LogConfig{writers: [LogWriterConfig{writer: sink, encoder: new JSONEncoder(source = false)}]})
			assert refunded(5) == 5
			Logging.info("elsewhere")
			try Logging.flush()
			assert sink.lines.len() == 2
			// A field of the call wins over the context's.
			assert sink.lines[0].endsWith("\"message\":\"refunding\",\"component\":\"billing\",\"order\":17\u007D")
			assert sink.lines[1].endsWith("\"message\":\"elsewhere\"\u007D")
			return none
		}

		@test()
		def contextOfATypeGoesOnItsMethodsEntries() !none {
			let sink = new MemoryWriter()
			try Logging.config(LogConfig{writers: [LogWriterConfig{writer: sink, encoder: new JSONEncoder(source = false)}]})
			let ledger = new Ledger()
			ledger.post(12)
			ledger.cancel()
			ledger.audit("month end")
			noted("outside the type")
			try Logging.flush()
			assert sink.lines.len() == 5
			// The type's fields, as the values their literals stand for.
			assert sink.lines[0].endsWith("\"message\":\"posted\",\"amount\":12,\"component\":\"ledger\",\"live\":true,\"rate\":0.5,\"region\":\u007B\"zone\":\"eu\"\u007D,\"shard\":3\u007D")
			// The method's own fields win over the type's, the call's over both.
			assert sink.lines[1].endsWith("\"message\":\"voided\",\"component\":\"ledger\",\"live\":true,\"op\":\"void now\",\"rate\":0.5,\"region\":\u007B\"zone\":\"eu\"\u007D,\"shard\":9\u007D")
			// An @log entry of a method and an entry written from a closure in it.
			assert sink.lines[2].contains("Ledger.audit\"") && sink.lines[2].contains("\"component\":\"ledger\"") && sink.lines[2].contains("\"reason\":\"month end\"")
			assert sink.lines[3].contains("\"message\":\"from a closure\"") && sink.lines[3].contains("\"component\":\"ledger\"")
			assert sink.lines[4].endsWith("\"message\":\"outside the type\"\u007D")
			return none
		}

		@test()
		def contextIsSetAndTakenAwayByName() !none {
			let sink = new MemoryWriter()
			try Logging.config(LogConfig{writers: [LogWriterConfig{writer: sink, encoder: new JSONEncoder(source = false)}]})
			Logging.context("std.services.logging.noted", {"run": 7})
			noted("with")
			Logging.context("std.services.logging.noted", {})
			noted("without")
			try Logging.flush()
			assert sink.lines[0].endsWith("\"message\":\"with\",\"run\":7\u007D")
			assert sink.lines[1].endsWith("\"message\":\"without\"\u007D")
			return none
		}

		@test()
		def sensitiveFieldsOfALoggedValueAreRedacted() !none {
			let sink = new MemoryWriter()
			try Logging.config(LogConfig{writers: [LogWriterConfig{writer: sink, encoder: new JSONEncoder(source = false)}]})
			let card = Card{holder: "Ada", number: "4111111111111111", limits: [10, 20]}
			Logging.info("card", {"card": card})
			Logging.info("payment", {"payment": Payment{amount: 12, card: card, tags: {"shop": "north"}}})
			Logging.info("plain", {"value": Plain{name: "box", size: 3}})
			try Logging.flush()
			assert sink.lines.len() == 3
			assert sink.lines[0].endsWith("\"card\":\u007B\"holder\":\"Ada\",\"number\":\"***\",\"limits\":[10,20]\u007D\u007D")
			assert sink.lines[1].endsWith("\"payment\":\u007B\"amount\":12,\"card\":\u007B\"holder\":\"Ada\",\"number\":\"***\",\"limits\":[10,20]\u007D,\"tags\":\u007B\"shop\":\"north\"\u007D\u007D\u007D")
			assert sink.lines[2].endsWith("\"value\":\u007B\"name\":\"box\",\"size\":3\u007D\u007D")
			for let (_, line) in sink.lines {
				assert !line.contains("4111")
			}
			return none
		}

		@test()
		def sensitiveFieldsInsideArraysAndMapsAreRedacted() !none {
			let sink = new MemoryWriter()
			try Logging.config(LogConfig{writers: [LogWriterConfig{writer: sink, encoder: new JSONEncoder(source = false)}]})
			let card = Card{holder: "Ada", number: "4111111111111111", limits: []}
			let cards Card[] = [card, card]
			Logging.info("list", {"cards": cards})
			Logging.info("map", {"byName": {"main": card}})
			Logging.info("untouched", {"sizes": [1, 2], "names": {"a": "b"}})
			try Logging.flush()
			assert sink.lines.len() == 3
			assert sink.lines[0].endsWith("\"cards\":[\u007B\"holder\":\"Ada\",\"number\":\"***\",\"limits\":[]\u007D,\u007B\"holder\":\"Ada\",\"number\":\"***\",\"limits\":[]\u007D]\u007D")
			assert sink.lines[1].endsWith("\"byName\":\u007B\"main\":\u007B\"holder\":\"Ada\",\"number\":\"***\",\"limits\":[]\u007D\u007D\u007D")
			assert sink.lines[2].endsWith("\"names\":\u007B\"a\":\"b\"\u007D,\"sizes\":[1,2]\u007D")
			for let (_, line) in sink.lines {
				assert !line.contains("4111")
			}
			return none
		}

		@test()
		def printingAValueHidesItsSensitiveFields() !none {
			let card = Card{holder: "Ada", number: "4111111111111111", limits: [10, 20]}
			assert "{card}" == "\{Ada *** [10, 20]}"
			let payment = Payment{amount: 12, card: card, tags: {"shop": "north"}}
			assert "{payment}" == "\{12 \{Ada *** [10, 20]} \{shop: north}}"
			let cards Card[] = [card]
			assert "{cards}" == "[\{Ada *** [10, 20]}]"
			assert sprint(card) == "\{Ada *** [10, 20]}" || !sprint(card).contains("4111")
			// A value with nothing marked prints as before.
			assert "{Plain{name: "box", size: 3}}" == "\{box 3}"
			return none
		}

		@test()
		def logErrorsWritesFailuresOnly() !none {
			let sink = new MemoryWriter()
			try Logging.config(LogConfig{writers: [LogWriterConfig{writer: sink, encoder: new JSONEncoder(source = false)}]})
			assert (try settle("acc-1", "1234", false)) == 4
			let failed = settle("acc-2", "9999", true)
			assert failed is error
			try Logging.flush()
			assert sink.lines.len() == 1
			let line = sink.lines[0]
			assert line.contains("\"level\":\"error\"")
			assert line.contains("settle failed\"")
			assert line.endsWith(",\"account\":\"acc-2\",\"error\":\"insufficient funds on acc-2\",\"pin\":\"***\",\"short\":true\u007D")
			return none
		}

		@test()
		def stackedAnnotationsRunTheBodyOnce() !none {
			let sink = new MemoryWriter()
			try Logging.config(LogConfig{writers: [LogWriterConfig{writer: sink, encoder: new JSONEncoder(source = false)}]})
			wrappedRuns = 0
			let failed = wrapped(250)
			assert failed is error
			assert wrappedRuns == 1
			try Logging.flush()
			// The call, the entry of its body, the slow call and the failure, each once and
			// each with the context's field.
			assert sink.lines.len() == 4
			assert sink.lines[0].contains("wrapped\",\"amount\":250,\"component\":\"ledger\"")
			assert sink.lines[1].endsWith("\"message\":\"inside\",\"component\":\"ledger\"\u007D")
			let rest = sink.lines[2] + sink.lines[3]
			assert rest.contains("wrapped was slow\"") && rest.contains("wrapped failed\"")
			assert rest.contains("\"error\":\"over the limit\"")
			for let (_, line) in sink.lines {
				assert line.contains("\"component\":\"ledger\"")
			}
			return none
		}

		@test()
		def logSlowWritesCallsPastTheThreshold() !none {
			let sink = new MemoryWriter()
			try Logging.config(LogConfig{writers: [LogWriterConfig{writer: sink, encoder: new JSONEncoder(source = false)}]})
			assert crawl(0s) == 1
			assert crawl(30ms) == 1
			try Logging.flush()
			assert sink.lines.len() == 1
			let line = sink.lines[0]
			assert line.contains("\"level\":\"warning\"")
			assert line.contains("crawl was slow\"")
			assert line.contains("\"duration\":")
			return none
		}
	}

	// Collects the records the service announces.
	internal type RecordObserver {
		internal seen LogRecord[]

		@on(Logging.recorded)
		def onRecorded(evt Event<LogRecord>) {
			seen.push(evt.result)
		}
	}

	check "Logging events" {
		@test()
		def panelShowsTheConfigurationAndTheLatestEntries() !none {
			let sink = new MemoryWriter()
			try Logging.config(
				LogConfig{
					level:   LogLevel.Debug,
					writers: [
						LogWriterConfig{writer: sink, encoder: new JSONEncoder(), levels: [LogLevel.Error, LogLevel.Fatal]},
						LogWriterConfig{writer: new FileWriter("logs/app.log", LogRotation{maxSize: 1000, keep: 3, compress: true}), encoder: new TextEncoder()},
						LogWriterConfig{writer: new NetworkWriter("logs.example.com:6514", LogTransport.Tls), encoder: new JSONEncoder()},
						LogWriterConfig{writer: new ConsoleWriter(), encoder: new ConsoleEncoder()},
					],
				}
			)
			let level = panel("ideLevel")
			assert !(level is none) && "{level}" == "Debug"
			let table = panel("ideWriters")
			fail "ideWriters did not answer an IdeTable" unless table is IdeTable
			let writers IdeTable = table
			assert writers.columns.equals(["Writer", "Target", "Encoder", "Levels"])
			assert writers.rows.len() == 4
			assert writers.rows[0].equals(["MemoryWriter", "", "JSONEncoder", "Error, Fatal"])
			assert writers.rows[1].equals(["FileWriter", "logs/app.log, new file at 1000 B, keep 3, gzip", "TextEncoder", "Debug, Info, Warning, Error, Fatal"])
			assert writers.rows[2][1] == "logs.example.com:6514 (tls)"
			assert writers.rows[3][1] == "standard error" && writers.rows[3][2] == "ConsoleEncoder"

			try Logging.config(LogConfig{level: LogLevel.Debug, writers: [LogWriterConfig{writer: sink, encoder: new JSONEncoder()}]})
			Logging.info("before the panel asked")
			assert (try panelEntriesNow()).len() == 0
			Logging.error("card declined", {"user": "u 1", "amount": 12})
			Logging.log("plain")
			for let i in 0..450 {
				Logging.debug("filler", {"i": i})
			}
			try Logging.flush()
			let entries = try panelEntriesNow()
			assert entries.len() == 200
			assert entries[199].message == "filler" && entries[199].fields[0].equals(["i", "449"])
			assert entries[0].fields[0].equals(["i", "250"])

			try Logging.config(LogConfig{writers: [LogWriterConfig{writer: sink, encoder: new JSONEncoder()}]})
			Logging.error("card declined", {"user": "u 1", "amount": 12, "token": new Masked("s3cret")})
			Logging.log("plain")
			let last = try panelEntriesNow()
			let declined = last[last.len() - 2]
			assert declined.level == "error" && declined.message == "card declined" && declined.source == "std.services.logging"
			assert declined.at.startsWith("logging_test.adm:") && declined.time > 1700000000000
			assert declined.fields.len() == 3
			assert declined.fields[0].equals(["amount", "12"]) && declined.fields[1].equals(["token", "***"]) && declined.fields[2].equals(["user", "\"u 1\""])
			assert last[last.len() - 1].level == "log"
			try Logging.flush()
			return try Logging.config(LogConfig{})
		}

		@test()
		def secretsAreNeverWritten() !none {
			let sink = new MemoryWriter()
			try Logging.config(LogConfig{writers: [LogWriterConfig{writer: sink, encoder: new JSONEncoder(source = false)}]})
			let token Secret<string> = "sk-live-1234"
			let key Secret<byte[]> = byte[7, 7, 7]
			Logging.info("alone", {"token": token, "key": key})
			Logging.info("held", {"session": Session{user: "ann", token: token}, "list": [Session{user: "bob", token: token}]})
			connectWith("db.example.com", token)
			try Logging.flush()
			assert sink.lines.len() == 3
			for let (_, line) in sink.lines {
				assert !line.contains("sk-live-1234") && !line.contains("inner")
			}
			assert sink.lines[0].contains("\"key\":\"***\",\"token\":\"***\"")
			assert sink.lines[1].contains("\"token\":\"***\"") && sink.lines[1].contains("\"user\":\"ann\"") && sink.lines[1].contains("\"user\":\"bob\"")
			assert sink.lines[2].contains("\"host\":\"db.example.com\"") && sink.lines[2].contains("\"token\":\"***\"")
			return none
		}

		@test()
		def recordsCarryTheTraceOfTheTaskThatWroteThem() !none {
			let sink = new MemoryWriter()
			try Logging.config(LogConfig{writers: [LogWriterConfig{writer: sink, encoder: new JSONEncoder(source = false)}]})
			Logging.info("outside")
			tracing.link.set("0af7651916cd43dd8448eb211c80319c-b7ad6b7169203331")
			Logging.info("inside", {"trace": "a field of the same name"})
			let done = new channel<none>(1)
			async writeFromATask(done)
			<-done
			Logging.write(LogRecord{message: "named", trace: "11111111111111111111111111111111", span: "2222222222222222"})
			tracing.link.set(none)
			Logging.info("after")
			try Logging.flush()
			assert sink.lines.len() == 5
			assert !sink.lines[0].contains("\"trace\"") && !sink.lines[0].contains("\"span\"")
			assert sink.lines[1].contains("\"trace\":\"0af7651916cd43dd8448eb211c80319c\",\"span\":\"b7ad6b7169203331\"")
			assert sink.lines[1].contains("\"fields.trace\":\"a field of the same name\"")
			assert sink.lines[2].contains("\"span\":\"b7ad6b7169203331\"")
			assert sink.lines[3].contains("\"trace\":\"11111111111111111111111111111111\",\"span\":\"2222222222222222\"")
			assert !sink.lines[4].contains("\"trace\"")
			return none
		}

		@test()
		def recordedCarriesWhatTheWritersGet() !none {
			let sink = new MemoryWriter()
			try Logging.config(LogConfig{level: LogLevel.Info, writers: [LogWriterConfig{writer: sink, encoder: new PlainEncoder()}]})
			let observer = new RecordObserver()
			Logging.debug("below the level")
			Logging.info("card", {"card": Card{holder: "Ada", number: "4111111111111111", limits: []}})
			Logging.error("second")
			try Logging.flush()
			assert observer.seen.len() == 2
			let first = observer.seen[0]
			let level = first.level
			assert !(level is none) && level == LogLevel.Info
			assert first.message == "card"
			assert first.time > 0
			assert first.caller.fileName == "logging_test.adm"
			let shown = string(try new JSONEncoder().encode(first))
			assert shown.contains("\"number\":\"***\"")
			assert !shown.contains("4111")
			assert observer.seen[1].message == "second"
			return none
		}
	}

	check "Logging service" {
		@test()
		def writesRecordsInOrderToTheRoutedWriters() !none {
			let all = new MemoryWriter()
			let errors = new MemoryWriter()
			try Logging.config(
				LogConfig{
					level:   LogLevel.Debug,
					writers: [
						LogWriterConfig{writer: all, encoder: new PlainEncoder()},
						LogWriterConfig{writer: errors, encoder: new PlainEncoder(), levels: [LogLevel.Error, LogLevel.Fatal]},
					],
				}
			)
			Logging.debug("one")
			Logging.info("two")
			Logging.warning("three")
			Logging.error("four")
			Logging.log(LogLevel.Info, "five")
			try Logging.flush()
			assert all.lines.equals(["Debug one", "Info two", "Warning three", "Error four", "Info five"])
			assert errors.lines.equals(["Error four"])
			return none
		}

		@test()
		def dropsRecordsBelowTheLevel() !none {
			let sink = new MemoryWriter()
			try Logging.config(LogConfig{level: LogLevel.Warning, writers: [LogWriterConfig{writer: sink, encoder: new PlainEncoder()}]})
			assert Logging.level() == LogLevel.Warning
			assert !Logging.enabled(LogLevel.Info)
			assert Logging.enabled(LogLevel.Error)
			Logging.info("quiet")
			Logging.error("loud")
			Logging.setLevel(LogLevel.Info)
			Logging.info("heard")
			try Logging.flush()
			assert sink.lines.equals(["Error loud", "Info heard"])
			return none
		}

		@test()
		def aPlainEntryHasNoLevelAndIsAlwaysWritten() !none {
			let all = new MemoryWriter()
			let errors = new MemoryWriter()
			try Logging.config(
				LogConfig{
					level:   LogLevel.Error,
					writers: [
						LogWriterConfig{writer: all, encoder: new PlainEncoder()},
						LogWriterConfig{writer: errors, encoder: new PlainEncoder(), levels: [LogLevel.Error]},
					],
				}
			)
			Logging.info("filtered")
			Logging.log("started", {"port": 8080})
			Logging.log("plain again")
			try Logging.flush()
			// No level filters it and every writer gets it.
			assert all.lines.equals(["- started", "- plain again"])
			assert errors.lines.equals(["- started", "- plain again"])
			return none
		}

		@test()
		def fatalIsWrittenBeforeItReturns() !none {
			let sink = new MemoryWriter()
			try Logging.config(LogConfig{writers: [LogWriterConfig{writer: sink, encoder: new PlainEncoder()}]})
			Logging.info("before")
			Logging.fatal("gone")
			assert sink.lines.equals(["Info before", "Fatal gone"])
			return none
		}

		@test()
		def recordsCarryTimeCallSiteAndLogValues() !none {
			let sink = new MemoryWriter()
			try Logging.config(LogConfig{writers: [LogWriterConfig{writer: sink, encoder: new JSONEncoder()}]})
			let before = time.wallNs()
			Logging.info("signed in", {"token": new Masked("hunter2"), "tries": 2})
			try Logging.flush()
			assert sink.lines.len() == 1
			let line = sink.lines[0]
			assert line.contains("\"message\":\"signed in\"")
			assert line.contains("\"file\":\"logging_test.adm\"")
			assert line.contains("\"module\":\"std.services.logging\"")
			assert line.contains("\"token\":\"***\"")
			assert line.contains("\"tries\":2")
			assert !line.contains("hunter2")
			assert line.contains("\"time\":\"{time.fromUnixNs(before).str()[:13]}")
			return none
		}

		@test()
		def aReplacedWriterIsClosedAfterItsRecords() !none {
			let first = new MemoryWriter()
			let second = new MemoryWriter()
			try Logging.config(LogConfig{writers: [LogWriterConfig{writer: first, encoder: new PlainEncoder()}]})
			Logging.info("to first")
			try Logging.config(LogConfig{writers: [LogWriterConfig{writer: second, encoder: new PlainEncoder()}]})
			Logging.info("to second")
			try Logging.flush()
			assert first.closed == 1
			assert second.closed == 0
			assert second.lines.equals(["Info to second"])
			assert first.lines.len() <= 1
			return none
		}

		@test()
		def aFailingWriterIsReportedAndTheOthersGoOn() !none {
			let bad = new MemoryWriter()
			bad.broken = true
			let good = new MemoryWriter()
			try Logging.config(
				LogConfig{
					writers: [
						LogWriterConfig{writer: bad, encoder: new PlainEncoder()},
						LogWriterConfig{writer: good, encoder: new PlainEncoder()},
					],
				}
			)
			Logging.info("kept")
			try Logging.flush()
			assert good.lines.equals(["Info kept"])
			assert bad.lines.len() == 0
			return none
		}

		@test()
		def aFullQueueDropsAndCounts() !none {
			let sink = new MemoryWriter()
			try Logging.config(LogConfig{capacity: 1, writers: [LogWriterConfig{writer: sink, encoder: new PlainEncoder()}]})
			try Logging.flush()
			let before = Logging.dropped()
			for let i in 0..200 {
				Logging.info("burst {i}")
			}
			try Logging.flush()
			assert sink.lines.len() >= 1
			assert sink.lines.len() + (Logging.dropped() - before) == 200
			return none
		}

		@test()
		def configRefusesBadSettings() !none {
			let noCapacity = Logging.config(LogConfig{capacity: 0})
			assert noCapacity is error
			let noLevels = Logging.config(LogConfig{writers: [LogWriterConfig{writer: new MemoryWriter(), encoder: new PlainEncoder(), levels: []}]})
			assert noLevels is error
			return none
		}

		@test()
		def writeTakesARecordAsItIs() !none {
			let sink = new MemoryWriter()
			try Logging.config(LogConfig{writers: [LogWriterConfig{writer: sink, encoder: new JSONEncoder()}]})
			Logging.write(sampleRecord())
			let debug = sampleRecord()
			debug.level = LogLevel.Debug
			Logging.write(debug)
			try Logging.flush()
			assert sink.lines.len() == 1
			assert sink.lines[0].startsWith("\u007B\"time\":\"2026-10-12T14:05:09.25Z\",\"level\":\"error\",\"message\":\"card declined\",\"module\":\"billing\",\"file\":\"invoice.adm\",\"line\":17")
			return none
		}

		@test()
		def stopWritesWhatWaitsAndClosesTheWriters() !none {
			let sink = new MemoryWriter()
			try Logging.config(LogConfig{writers: [LogWriterConfig{writer: sink, encoder: new PlainEncoder()}]})
			Logging.info("last words")
			try await Logging.stop()
			assert sink.lines.equals(["Info last words"])
			assert sink.closed == 1
			let before = Logging.dropped()
			Logging.info("after the end")
			assert Logging.dropped() == before + 1
			try await Logging.start()
			Logging.info("back")
			try Logging.flush()
			assert sink.lines.equals(["Info last words", "Info back"])
			return none
		}
	}

	check "Log encoders" {
		@test()
		def textIsOneApacheStyleLine() !none {
			let line = string(try new TextEncoder(pid = false).encode(sampleRecord()))
			assert line == "[Mon Oct 12 14:05:09.250000 2026] [billing:error] invoice.adm:17: card declined amount=12 user=\"u 1\""
			let shifted = string(try new TextEncoder(offset = 2h, source = false, pid = false).encode(sampleRecord()))
			assert shifted.startsWith("[Mon Oct 12 16:05:09.250000 2026] [billing:error] card declined")
			let withPid = string(try new TextEncoder().encode(sampleRecord()))
			assert withPid.contains("] [pid ")
			return none
		}

		@test()
		def textKeepsARecordOnOneLine() !none {
			let record = sampleRecord()
			record.message = "first\nsecond"
			record.fields = {"note": "a=b", "empty": "", "say": "he said \"hi\""}
			let line = string(try new TextEncoder(source = false, pid = false).encode(record))
			assert !line.contains("\n")
			assert line.endsWith("first\\nsecond empty=\"\" note=\"a=b\" say=\"he said \\\"hi\\\"\"")
			return none
		}

		@test()
		def consoleIsOneReadableLine() !none {
			// A test's output is no terminal, so the line carries no colors.
			let line = string(try new ConsoleEncoder().encode(sampleRecord()))
			assert line == "14:05:09.250 ERROR billing  amount=12 user=\"u 1\"  card declined"
			let placed = string(try new ConsoleEncoder(source = LogSource.Always).encode(sampleRecord()))
			assert placed == "14:05:09.250 ERROR billing  amount=12 user=\"u 1\"  card declined  invoice.adm:17"
			// A debug entry names its place; one without fields has only the message.
			let record = sampleRecord()
			record.level = LogLevel.Debug
			record.message = "first\nsecond"
			record.fields = {}
			let debug = string(try new ConsoleEncoder(ConsoleStream.Stdout, offset = 2h).encode(record))
			assert debug == "16:05:09.250 DEBUG billing  first\\nsecond  invoice.adm:17"
			let bare = string(try new ConsoleEncoder(source = LogSource.Never).encode(record))
			assert bare == "14:05:09.250 DEBUG billing  first\\nsecond"
			return none
		}

		@test()
		def aPlainEntryIsEncodedWithoutALevel() !none {
			let record = sampleRecord()
			record.level = none
			record.fields = {"port": 8080}
			record.message = "started"
			assert string(try new TextEncoder(pid = false).encode(record)) == "[Mon Oct 12 14:05:09.250000 2026] [billing:log] invoice.adm:17: started port=8080"
			assert string(try new ConsoleEncoder().encode(record)) == "14:05:09.250 LOG   billing  port=8080  started"
			assert string(try new JSONEncoder(source = false).encode(record)) == "\u007B\"time\":\"2026-10-12T14:05:09.25Z\",\"level\":\"log\",\"message\":\"started\",\"port\":8080\u007D"
			return none
		}

		@test()
		def jsonIsOneObject() !none {
			let line = string(try new JSONEncoder().encode(sampleRecord()))
			assert line == "{\"time\":\"2026-10-12T14:05:09.25Z\",\"level\":\"error\",\"message\":\"card declined\",\"module\":\"billing\",\"file\":\"invoice.adm\",\"line\":17,\"amount\":12,\"user\":\"u 1\"}"
			return none
		}

		@test()
		def jsonKeepsFieldsApartFromTheRecordsKeys() !none {
			let record = sampleRecord()
			record.fields = {"level": "gold", "note": "line\nbreak"}
			let flat = string(try new JSONEncoder(source = false).encode(record))
			assert flat.endsWith(",\"fields.level\":\"gold\",\"note\":\"line\\nbreak\"}")
			let nested = string(try new JSONEncoder("fields", false).encode(record))
			assert nested.endsWith(",\"fields\":{\"level\":\"gold\",\"note\":\"line\\nbreak\"}}")
			return none
		}
	}
}
