partial module std.services.logging {
	use (
		std.net
		std.net.tls
		std.time
	)

	// How a NetworkWriter carries records.
	enum LogTransport {
		// One connection, each record ended by a line break.
		Tcp,
		// One datagram per record. A lost datagram is not noticed.
		Udp,
		// One TLS connection, each record ended by a line break.
		Tls
	}

	// Sends each record to a collector at `host:port`, over TCP, UDP or TLS.
	//
	// It connects on the first record. Over TCP and TLS a failed send reconnects once and
	// tries again; when the collector cannot be reached, records fail at once for `retryAfter`
	// instead of each waiting for a connection, so an absent collector does not hold the
	// records of the other writers back. Connecting needs the `adm.network.connect`
	// permission for the address.
	//
	// ```
	// LogWriterConfig{
	// 	writer:  new NetworkWriter("logs.example.com:5170"),
	// 	encoder: new JSONEncoder(),
	// }
	// ```
	//
	// With `LogTransport.Tls` the collector's certificate is verified against the system's
	// roots for the host of the address; `tls` changes that:
	//
	// ```
	// let secure = new NetworkWriter("logs.example.com:6514", LogTransport.Tls)
	// secure.tls = tls.Config{rootCAs: pool}
	// ```
	type NetworkWriter {
		// How long a connect or a send may wait.
		timeout    duration    = 5s
		// How long records fail without a new attempt after the collector could not be
		// reached.
		retryAfter duration    = 5s
		// The TLS settings of `LogTransport.Tls`; none verifies the collector against the
		// system's roots, under the host of the address.
		tls        ?tls.Config = none

		internal address   string
		internal transport LogTransport
		internal stream    ?net.Stream  = none
		internal socket    ?net.Socket  = none
		// Monotonic time before which no connection is attempted; 0 for none.
		internal holdUntil int64

		def new(address string, transport LogTransport = LogTransport.Tcp) {
			self.address = address
			self.transport = transport
		}

		// Implements `io.Writer`: sends data as one record and returns its length.
		//
		// Fails when the collector cannot be reached or refuses the record, when the TLS
		// handshake fails, when the policy denies the address, and over UDP when the record is longer than a datagram holds
		// (65507 bytes).
		def write(data byte[]) !int {
			if transport == LogTransport.Udp {
				fail "logging: record of {data.len()} bytes does not fit a UDP datagram" when data.len() > 65507
				try connect()
				let dgram = socket
				fail "logging: not connected to {address}" when dgram is none
				try dgram.writeTo(data, address, timeout)
				return data.len()
			}
			let line = data + '\n'
			let wasOpen = isOpen()
			let failure ?error = none
			transmit(line) onerror (err error) {
				failure = err
				recover none
			}
			return data.len() when failure is none
			drop()
			// Only a connection that was open may have gone stale: one more attempt.
			fail failure unless wasOpen
			try transmit(line)
			return data.len()
		}

		// Whether a connection (TCP) or a socket (UDP) is open.
		def isOpen() bool {
			return !(stream is none) || !(socket is none)
		}

		// Implements `io.Closer`: closes the connection; the next record opens one again.
		// Does not fail.
		def close() !none {
			drop()
			holdUntil = 0
			return none
		}

		def dispose() {
			drop()
		}

		// Opens the connection or the socket when there is none.
		internal def connect() !none {
			return none when isOpen()
			let now = time.monoNs()
			fail "logging: {address} could not be reached, next attempt in {duration(holdUntil - now)}" when holdUntil > now
			open() onerror (err error) {
				holdUntil = now + int64(retryAfter)
				fail err
			}
			holdUntil = 0
			return none
		}

		internal def open() !none {
			if transport == LogTransport.Udp {
				let parsed = try net.parseAddress(address)
				socket = try net.socket(parsed.isIPv6 ?? (net.SocketDomain.IPv6, net.SocketDomain.IPv4), net.SocketType.Datagram)
				return none
			}
			if transport == LogTransport.Tls {
				stream = try secureStream(address, tls, timeout)
				return none
			}
			stream = try net.dialStream(address, timeout)
			return none
		}

		// Writes one framed record on the stream, connecting first when needed.
		internal def transmit(line byte[]) !none {
			try connect()
			let conn = stream
			fail "logging: not connected to {address}" when conn is none
			return try net.writeAll(conn, line, timeout)
		}

		internal def drop() {
			let conn = stream
			if !(conn is none) {
				conn.close() onerror recover none
			}
			stream = none
			let dgram = socket
			if !(dgram is none) {
				dgram.close() onerror recover none
			}
			socket = none
		}
	}

	// Connects to the address over TLS: with no settings the collector is verified against
	// the system's roots under the host of the address. Fails when the dial or the
	// handshake does.
	internal def secureStream(address string, settings ?tls.Config, timeout duration) !net.Stream {
		let config = tls.Config{}
		config = settings unless settings is none
		return try tls.dial(address, config, timeout)
	}
}
