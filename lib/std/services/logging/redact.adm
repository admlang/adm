// What the services do to a value before it leaves the program in a log entry, a telemetry
// event or a report: `LogValue` forms, `@sensitive` fields and `Secret` values. `std.services.logging` owns
// it; the other `std.services.*` modules reach it here.
internal std.services partial module std.services.logging.redaction {
	use (
		std.reflection
		std.reflection::(Field, FieldKind)
		std.services.logging::(LogValue)
	)

	// Qualified name of the `@sensitive` meta, as reflection reports it on a field.
	const sensitiveMeta = "std.services.logging.sensitive"

	// What is written in place of a sensitive value.
	const redactedText = "***"

	// How deep a logged value is searched for sensitive fields.
	const redactDepth = 8

	// The fields as they are logged; see `logged`. The map itself when nothing changes.
	def loggable(fields map<string, any>) map<string, any> {
		let out ?map<string, any> = none
		for let (name, value) in fields {
			continue unless replaced(value)
			let made = fields.clone()
			made = out unless out is none
			made[name] = logged(value, 0)
			out = made
		}
		return fields when out is none
		return out
	}

	// Whether a value is logged as something else than itself.
	def replaced(value any) bool {
		return guarded(value, 0)
	}

	// A value as it is logged: a `LogValue` gives its own form; a `Secret` becomes `***`
	// (the codecs write what it holds, a log entry never does); a struct or type that
	// holds a `@sensitive` field becomes a map of its fields with those written as `***`;
	// an array or a map holding such values, at any depth to `redactDepth`, becomes one of
	// their logged forms. Anything else is returned as it is.
	def logged(value any, depth int) any {
		match value {
			case LogValue:
				return value.logValue()
			default:
		}
		return value unless guarded(value, depth)
		let kind = reflection.kindOf(value)
		return redactedText when kind == FieldKind.Struct && isSecret(value)
		if kind == FieldKind.Array {
			let items = any[]
			for let (_, element) in reflection.elements(value) {
				items.push(logged(element, depth + 1))
			}
			return items
		}
		let out = map<string, any>{}
		if kind == FieldKind.Map {
			for let (_, key) in reflection.keysOf(value) {
				let entry = reflection.entryOf(value, key)
				if entry is none {
					out[key] = "none"
				} else {
					out[key] = logged(entry, depth + 1)
				}
			}
			return out
		}
		for let (_, f) in reflection.fields(value) {
			if f.hasAttr(sensitiveMeta) {
				out[f.name] = redactedText
			} else {
				out[f.name] = fieldValue(f, f.kind, depth + 1)
			}
		}
		return out
	}

	// Whether a value is a `LogValue` or a `Secret`, or a struct, type, array or map that
	// holds one of those or a `@sensitive` field within `redactDepth` levels.
	def guarded(value any, depth int) bool {
		match value {
			case LogValue:
				return true
			default:
		}
		return false when depth >= redactDepth
		let kind = reflection.kindOf(value)
		if kind == FieldKind.Array {
			for let (_, element) in reflection.elements(value) {
				return true when guarded(element, depth + 1)
			}
			return false
		}
		if kind == FieldKind.Map {
			for let (_, key) in reflection.keysOf(value) {
				let entry = reflection.entryOf(value, key)
				continue when entry is none
				return true when guarded(entry, depth + 1)
			}
			return false
		}
		return false unless kind == FieldKind.Struct
		return true when isSecret(value)
		for let (_, f) in reflection.fields(value) {
			return true when f.hasAttr(sensitiveMeta)
			return true when guardedField(f, f.kind, depth + 1)
		}
		return false
	}

	// Whether a struct value is a prelude `Secret<T>`; a program's own type called
	// `Secret` is not.
	def isSecret(value any) bool {
		return reflection.typeName(value).startsWith("builtin.Secret<")
	}

	// Whether what a field, an array element or a map entry holds is guarded.
	def guardedField(f Field, kind FieldKind, depth int) bool {
		match kind {
			case FieldKind.String, FieldKind.Bool, FieldKind.Int, FieldKind.Uint, FieldKind.Float, FieldKind.Enum:
				return false
			case FieldKind.Array:
				for let i in 0..f.len() {
					return true when guardedField(f.at(i), f.elemKind, depth)
				}
				return false
			case FieldKind.Map:
				for let (_, key) in f.keys() {
					return true when guardedField(f.entry(key), f.elemKind, depth)
				}
				return false
			default:
		}
		let nested = f.value()
		return false when nested is none
		return guarded(nested, depth)
	}

	// What a field, an array element or a map entry holds, as a value to log.
	def fieldValue(f Field, kind FieldKind, depth int) any {
		match kind {
			case FieldKind.String, FieldKind.Enum:
				return f.asString()
			case FieldKind.Bool:
				return f.asBool()
			case FieldKind.Int:
				return f.asInt()
			case FieldKind.Uint:
				return f.asUint()
			case FieldKind.Float:
				return f.asFloat()
			case FieldKind.Array:
				let items = any[]
				for let i in 0..f.len() {
					items.push(fieldValue(f.at(i), f.elemKind, depth))
				}
				return items
			case FieldKind.Map:
				let entries = map<string, any>{}
				for let (_, key) in f.keys() {
					entries[key] = fieldValue(f.entry(key), f.elemKind, depth)
				}
				return entries
			default:
		}
		let nested = f.value()
		return "none" when nested is none
		return logged(nested, depth)
	}
}
