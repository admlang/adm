// The trace a task is running in, for the records it writes. `std.services.telemetry` sets
// it when a span becomes the running one; `std.services.logging` reads it into each record.
internal std.services partial module std.services.logging.tracing {
	// The running task's trace and span as `<trace>-<span>` (32 and 16 hex digits); none
	// outside a span. A task started with `async` begins with its starter's value.
	let link = new TaskLocal<string>()

	// The trace and the span of the running task, both empty outside a span.
	def current() (string, string) {
		let held = link.get()
		return ("", "") when held is none
		let cut = held.indexOf("-")
		return (held, "") when cut < 0
		return (held[:cut], held[cut + 1:])
	}
}
