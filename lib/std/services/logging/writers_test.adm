partial module std.services.logging {
	use (
		std.bytes
		std.crypto.x509::(CertPool)
		std.data.compress.gzip
		std.io
		std.net
		std.net.tcp
		std.net.tls
		std.net.udp
		std.os
		std.testing
		std.time
	)

	// A self-signed P-256 certificate for 127.0.0.1, localhost and example.com, valid for
	// a century (the one httptest presents).
	internal const logCertPEM =
		"-----BEGIN CERTIFICATE-----\n" +
		"MIIByzCCAXCgAwIBAgIULZ61fkBLJqpHXo7Dg3TjjURKNKQwCgYIKoZIzj0EAwIw\n" +
		"EzERMA8GA1UEAwwIQURNIHRlc3QwIBcNMjYwOTE2MjEyNDQ4WhgPMjEyNjA4MjMy\n" +
		"MTI0NDhaMBMxETAPBgNVBAMMCEFETSB0ZXN0MFkwEwYHKoZIzj0CAQYIKoZIzj0D\n" +
		"AQcDQgAEWmnKIPFi8/hNfbTouWeJ0sX7jXIK0H2BdAa3ZlChTQUtkRXRuGnkYmY9\n" +
		"c9D2sLIU0D8YtBwSi1XCEXkyARGL3KOBnzCBnDAdBgNVHQ4EFgQUdGEQb1u97o8W\n" +
		"5FkheQ27r3JNU3AwHwYDVR0jBBgwFoAUdGEQb1u97o8W5FkheQ27r3JNU3AwDwYD\n" +
		"VR0TAQH/BAUwAwEB/zAnBgNVHREEIDAegglsb2NhbGhvc3SCC2V4YW1wbGUuY29t\n" +
		"hwR/AAABMAsGA1UdDwQEAwIHgDATBgNVHSUEDDAKBggrBgEFBQcDATAKBggqhkjO\n" +
		"PQQDAgNJADBGAiEA6p+D8so1nzo4nOkB8z0x1Tq+9iG1qIweVo/zTnSHG9cCIQDo\n" +
		"ANw/RkMk5iyYvJf8Qx75u8fY/n2s26d6Clj96iuH/g==\n" +
		"-----END CERTIFICATE-----\n"

	internal const logKeyPEM =
		"-----BEGIN PRIVATE KEY-----\n" +
		"MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgz6zLOlG3plulCC6J\n" +
		"73w4HvDFzW9lrGWy0U1PuM2M1gWhRANCAARaacog8WLz+E19tOi5Z4nSxfuNcgrQ\n" +
		"fYF0BrdmUKFNBS2RFdG4aeRiZj1z0PawshTQPxi0HBKLVcIReTIBEYvc\n" +
		"-----END PRIVATE KEY-----\n"

	// Reads what one client sends over TLS until it closes.
	internal async def collectSecure(server tcp.Server) !string {
		let conn = try server.accept()
		let pair = try tls.parseKeyPair(logCertPEM, logKeyPEM)
		let secured = tls.server(conn, tls.Config{certificates: [pair]})
		try secured.handshake(5s)
		let all = ""
		let buf byte[] = []
		buf.len(256)
		for {
			let n = secured.read(buf, 5s) onerror recover 0
			break when n <= 0
			all += string(buf[:n])
		}
		secured.close() onerror recover none
		return all
	}

	internal def scratchFolder(name string) string {
		return "/tmp/adm-logging-{name}-{time.now().unixNs()}"
	}

	internal def discard(folder string) {
		os.remove(folder, true) onerror recover none
	}

	// What a write fails with; empty when it works.
	internal def failureOf(out NetworkWriter, text string) string {
		let message = ""
		out.write(text.bytes()) onerror (err error) {
			message = err.message
			recover 0
		}
		return message
	}

	// The rotated files of a log, by name.
	internal def rotatedNames(folder string, log string) !string[] {
		let names = string[]
		for let (_, entry) in try os.readDir(folder) {
			names.push(entry.info.name) when entry.info.name != log
		}
		names.sort((a, b) => a < b)
		return names
	}

	// Reads what one client sends until it closes.
	internal async def collect(server tcp.Server) !string {
		let conn = try server.accept()
		let all = string(try io.readAll(conn))
		conn.close() onerror recover none
		return all
	}

	check "Log writers" {
		@test()
		def consoleWritesALineAndStaysOpen() !none {
			let out = new ConsoleWriter(ConsoleStream.Stdout)
			assert (try out.write("console writer line".bytes())) == 19
			try out.close()
			assert (try out.write("console writer line after close".bytes())) == 31
			assert (try new ConsoleWriter().write("console writer line on stderr".bytes())) == 29
			return none
		}

		@test()
		def fileAppendsLinesAndCreatesItsFolder() !none {
			let folder = scratchFolder("append")
			defer discard(folder)
			let path = "{folder}/nested/app.log"
			let log = new FileWriter(path)
			assert (try log.write("one".bytes())) == 3
			try log.write("two".bytes())
			try log.close()
			// A closed writer opens the file again and goes on at its end.
			try log.write("three".bytes())
			try log.close()
			assert string(try os.readFile(path)) == "one\ntwo\nthree\n"
			return none
		}

		@test()
		def fileRotatesBySizeAndKeepsTheNewest() !none {
			let folder = scratchFolder("size")
			defer discard(folder)
			let path = "{folder}/app.log"
			// Each record is 10 bytes with its line break: two fit, the third rotates.
			let log = new FileWriter(path, LogRotation{maxSize: 20, keep: 2})
			for let i in 0..9 {
				try log.write("record-0{i}".bytes())
			}
			try log.close()
			assert string(try os.readFile(path)) == "record-08\n"
			let old = try rotatedNames(folder, "app.log")
			assert old.len() == 2
			let kept = ""
			for let (_, name) in old {
				assert name.startsWith("app.log.")
				kept += string(try os.readFile("{folder}/{name}"))
			}
			assert kept == "record-04\nrecord-05\nrecord-06\nrecord-07\n"
			return none
		}

		@test()
		def fileCompressesRotatedFiles() !none {
			let folder = scratchFolder("gzip")
			defer discard(folder)
			let path = "{folder}/app.log"
			let log = new FileWriter(path, LogRotation{compress: true})
			try log.write("packed away".bytes())
			try log.rotate()
			try log.write("fresh".bytes())
			try log.close()
			assert string(try os.readFile(path)) == "fresh\n"
			let old = try rotatedNames(folder, "app.log")
			assert old.len() == 1
			assert old[0].endsWith("Z.gz")
			let packed = try os.readFile("{folder}/{old[0]}")
			let plain = try io.readAll(new gzip.Reader(new bytes.Reader(packed)))
			assert string(plain) == "packed away\n"
			return none
		}

		@test()
		def fileRotatesAFileLeftFromAnEarlierPeriod() !none {
			let folder = scratchFolder("period")
			defer discard(folder)
			let path = "{folder}/app.log"
			try os.mkdir(folder, true)
			try os.writeFile(path, "yesterday\n".bytes())
			try os.touch(path, time.fromUnixNs(time.wallNs() - int64(48h)))
			let log = new FileWriter(path, LogRotation{period: 24h})
			try log.write("today".bytes())
			try log.write("still today".bytes())
			try log.close()
			assert string(try os.readFile(path)) == "today\nstill today\n"
			let old = try rotatedNames(folder, "app.log")
			assert old.len() == 1
			assert string(try os.readFile("{folder}/{old[0]}")) == "yesterday\n"
			return none
		}

		@test()
		def fileRemovesRotatedFilesPastTheirAge() !none {
			let folder = scratchFolder("age")
			defer discard(folder)
			let path = "{folder}/app.log"
			try os.mkdir(folder, true)
			let stale = "{folder}/app.log.20200101T000000Z"
			try os.writeFile(stale, "ancient\n".bytes())
			try os.touch(stale, time.fromUnixNs(time.wallNs() - int64(72h)))
			// Not a rotated file of this log: left alone whatever its age.
			let other = "{folder}/app.log.backup"
			try os.writeFile(other, "mine\n".bytes())
			try os.touch(other, time.fromUnixNs(time.wallNs() - int64(72h)))
			let log = new FileWriter(path, LogRotation{maxAge: 24h})
			try log.write("now".bytes())
			try log.rotate()
			try log.close()
			assert !(try os.exists(stale))
			assert try os.exists(other)
			assert (try rotatedNames(folder, "app.log")).len() == 2
			return none
		}

		@test()
		def networkSendsLinesOverTcp() !none {
			let server = new tcp.Server("127.0.0.1:0")
			try server.start()
			let received = async collect(server)
			let out = new NetworkWriter(server.address().str())
			assert !out.isOpen()
			assert (try out.write("first".bytes())) == 5
			assert out.isOpen()
			try out.write("second".bytes())
			try out.close()
			assert !out.isOpen()
			assert (try await received) == "first\nsecond\n"
			try server.close()
			return none
		}

		@test()
		def networkSendsLinesOverTls() !none {
			let server = new tcp.Server("127.0.0.1:0")
			try server.start()
			let received = async collectSecure(server)
			let out = new NetworkWriter(server.address().str(), LogTransport.Tls)
			let pool = new CertPool()
			pool.appendCertsFromPEM(logCertPEM)
			out.tls = tls.Config{serverName: "localhost", rootCAs: pool}
			assert (try out.write("secret one".bytes())) == 10
			try out.write("secret two".bytes())
			try out.close()
			assert (try await received) == "secret one\nsecret two\n"
			try server.close()
			return none
		}

		@test()
		def networkRefusesAnUntrustedCollector() !none {
			let server = new tcp.Server("127.0.0.1:0")
			try server.start()
			let received = async collectSecure(server)
			// No roots given: the test certificate is not one the system trusts.
			let out = new NetworkWriter(server.address().str(), LogTransport.Tls)
			let message = ""
			out.write("never sent".bytes()) onerror (err error) {
				message = err.message
				recover 0
			}
			assert message != ""
			assert !out.isOpen()
			await received onerror recover ""
			try server.close()
			return none
		}

		@test()
		def networkSendsDatagramsOverUdp() !none {
			let server = new udp.Server("127.0.0.1:0")
			try server.start()
			let out = new NetworkWriter(server.address().str(), LogTransport.Udp)
			assert (try out.write("alone".bytes())) == 5
			let buf byte[] = []
			buf.len(64)
			let (n, _) = try server.recv(buf)
			assert string(buf[:n]) == "alone"
			let large byte[] = []
			large.len(70000)
			assert out.write(large) is error
			try out.close()
			try server.close()
			return none
		}

		@test()
		def networkFailsFastWhileTheCollectorIsAway() !none {
			let server = new tcp.Server("127.0.0.1:0")
			try server.start()
			let address = server.address().str()
			try server.close()
			let out = new NetworkWriter(address)
			out.retryAfter = 1h
			assert failureOf(out, "lost") != ""
			let started = time.monoNs()
			assert failureOf(out, "lost too").contains("next attempt")
			assert time.monoNs() - started < int64(1s)
			// close forgets the wait, so the next record tries the collector again.
			try out.close()
			let again = failureOf(out, "lost again")
			assert again != "" && !again.contains("next attempt")
			return none
		}
	}
}
