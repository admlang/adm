partial module std.services {
	service Messaging {
		description           = ""
		dependencies          = Dependencies{
			hard: [Runtime]
		}
		lifecycle             = Lifecycle{
			start: StartMode.Manual,
			restart: RestartMode.Always,
		}
		permissions  string[]

		def config<T>(val T) !none {}

		async def start() !none {
			return none
		}

		async def stop() !none {
			return none
		}

		async def restart() !none {
			return none
		}
	}

	/*
        queues
        topics
        publish
        consume
        ack/nack
        retry
        dead-letter
        delivery guarantees
    */
}
