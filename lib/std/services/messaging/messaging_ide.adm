// The Messaging service's IDE panel: its subscriptions and counts, and the
// buttons that publish a message and end a subscription.

partial module std.services.messaging {
	use std.ide::(ide, IdeKind, IdeTable)

	partial service Messaging {
		// The subscriptions with what waits on each.
		@ide(kind = IdeKind.Table, label = "Subscriptions", refresh = 1s, rows = 0)
		atomic def ideSubscriptions() IdeTable {
			let rows = string[][]
			for let (_, consumer) in consumers {
				let queue = consumer.queue
				rows.push(["{consumer.id}", queue.topic, queue.group, queue.payload, "{queue.pending()}", "{queue.inFlight}", "{queue.delivered}", "{queue.failed}"])
			}
			return IdeTable{
				columns: ["Id", "Topic", "Group", "Payload", "Pending", "In flight", "Delivered", "Failed"],
				rows:    rows,
			}
		}

		// Messages published, graphed over time.
		@ide(kind = IdeKind.Series, label = "Published", refresh = 1s, cumulative = true)
		def idePublished() int {
			return int(published)
		}

		// Messages that became dead letters.
		@ide(kind = IdeKind.Value, label = "Dead letters", refresh = 1s)
		def ideDead() int {
			return int(dead)
		}

		// Publishes a text message on a topic, as the program would.
		@ide(kind = IdeKind.Action, label = "Publish")
		def idePublish(topic string, text string) !string {
			let id = try publish(text, topic = topic)
			return "published {id}"
		}

		@ide(kind = IdeKind.Action, label = "Unsubscribe", confirm = "End this subscription?", row = "ideSubscriptions.Id")
		def ideUnsubscribe(id uint64) !none {
			return unsubscribe(id)
		}
	}
}
