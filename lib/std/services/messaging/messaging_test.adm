partial module std.services.messaging {
	use (
		std.services::(Dependencies, Lifecycle, RestartMode, StartMode)
		std.testing
		std.time
	)

	@topic("test.orders.created")
	internal struct OrderCreated {
		id int
	}

	// Published on the topic of its qualified name.
	internal struct StockCounted {
		units int
	}

	internal let ordersSeen = new channel<int>(64)
	internal let stockSeen = new channel<int>(64)
	internal let auditSeen = new channel<string>(64)
	internal let attachedSeen = new channel<int>(64)
	internal let ledgerSeen = new channel<int>(64)

	@subscribe()
	internal def onOrder(order OrderCreated) {
		ordersSeen <- order.id
	}

	@subscribe()
	internal def onStock(count StockCounted) !none {
		stockSeen <- count.units
		return none
	}

	@subscribe("test.audit.*", group = "audit", workers = 2)
	internal def audit(message Message) {
		auditSeen <- message.topic
	}

	internal type Tally {
		factor int

		def new(factor int) {
			self.factor = factor
		}

		@subscribe("test.attached")
		def count(units int) {
			attachedSeen <- units * factor
		}
	}

	internal service Ledger {
		description               = "Adds up what the Messaging suite publishes on test.ledger"
		dependencies              = Dependencies{
			hard: [Messaging]
		}
		lifecycle                 = Lifecycle{
			start: StartMode.Manual,
			restart: RestartMode.Never,
		}
		permissions  Permission[]

		total int

		async def start() !none {
			return none
		}

		async def stop() !none {
			return none
		}

		async def restart() !none {
			return none
		}

		@subscribe("test.ledger")
		def record(units int) {
			total += units
			ledgerSeen <- total
		}
	}

	// Waits up to two seconds for the next value; -1 when none comes.
	internal def nextInt(from channel<int>) int {
		let timeout = time.sleepChan(2s)
		select {
			case from:
				return <- from
			case timeout:
				return -1
		}
		return -1
	}

	// Waits up to two seconds for the next value; "" when none comes.
	internal def nextText(from channel<string>) string {
		let timeout = time.sleepChan(2s)
		select {
			case from:
				return <- from
			case timeout:
				return ""
		}
		return ""
	}

	// Waits for a message without a timeout and reports whether the wait ended with none.
	internal def reportEnd(inbox SubscriptionId, ended channel<bool>) {
		let message = Messaging.receive(inbox) onerror recover none
		ended <- message is none
	}

	// The kind of the failure a call ended with, "" when it is not a MessagingError.
	internal def kindOf(err error) string {
		return err is MessagingError ?? ("{err.kind}", "")
	}

	check "Messaging service" {
		@test()
		def annotatedFunctionsByPayloadType() !none {
			try Messaging.publish(OrderCreated{id: 7})
			try testing.expectEqual(7, nextInt(ordersSeen), "the @topic of the type routes the payload")
			try Messaging.publish(StockCounted{units: 3})
			try testing.expectEqual(3, nextInt(stockSeen), "a type without @topic uses its qualified name")

			// Another payload on the same topic is not for a function that takes an OrderCreated.
			try Messaging.publish("not an order", "test.orders.created")
			try Messaging.publish(OrderCreated{id: 8})
			try testing.expectEqual(8, nextInt(ordersSeen), "only the payload type is delivered")

			let typed = Messaging.subscriptions().filter(s => s.topic == "test.orders.created")
			try testing.expectEqual(1, typed.len(), "the annotated function is subscribed")
			try testing.expectEqual("std.services.messaging.OrderCreated", typed[0].payload, "its payload type")
			try testing.expectEqual(uint64(2), typed[0].delivered, "deliveries counted")
			return none
		}

		@test()
		def annotatedPatternAndGroup() !none {
			try Messaging.publish(1, "test.audit.login")
			try Messaging.publish(2, "test.audit.eu.logout")
			let seen = [nextText(auditSeen), nextText(auditSeen)]
			try testing.expectTrue(seen.includes("test.audit.login"), "a pattern takes a topic under it")
			try testing.expectTrue(seen.includes("test.audit.eu.logout"), "* runs over dots")
			let audits = Messaging.subscriptions().filter(s => s.topic == "test.audit.*")
			try testing.expectEqual(1, audits.len(), "the annotated function is subscribed")
			try testing.expectEqual("audit", audits[0].group, "in its group")
			return none
		}

		@test()
		def annotatedServiceMethod() !none {
			try Messaging.publish(2, "test.ledger")
			try Messaging.publish(5, "test.ledger")
			try testing.expectEqual(2, nextInt(ledgerSeen), "a service's @subscribe method runs on the service")
			try testing.expectEqual(7, nextInt(ledgerSeen), "and keeps its state")
			return none
		}

		@test()
		def attachedMethods() !none {
			let made = try Messaging.attach(new Tally(10))
			try testing.expectEqual(1, made.len(), "one @subscribe method")
			try Messaging.publish(4, "test.attached")
			try testing.expectEqual(40, nextInt(attachedSeen), "the method runs on the attached value")
			try Messaging.unsubscribe(made[0])

			let kind = ""
			Messaging.attach("no methods") onerror (err error) {
				kind = kindOf(err)
				recover SubscriptionId[]
			}
			try testing.expectEqual("InvalidHandler", kind, "a type without @subscribe methods")
			return none
		}

		@test()
		def fanOutAndGroups() !none {
			let got = new channel<int>(64)
			let handler = def (message Message) !none {
				got <- int(message.payload)
				return none
			}
			let first = try Messaging.subscribe("test.fan", handler)
			let second = try Messaging.subscribe("test.fan", handler)
			try Messaging.publish(1, "test.fan")
			try testing.expectEqual(1, nextInt(got), "first subscription")
			try testing.expectEqual(1, nextInt(got), "second subscription has its own copy")
			try Messaging.unsubscribe(first)
			try Messaging.unsubscribe(second)

			let shared = new channel<int>(64)
			let member = def (message Message) !none {
				shared <- int(message.payload)
				return none
			}
			let a = try Messaging.subscribe("test.fan", member, "workers")
			let b = try Messaging.subscribe("test.fan", member, "workers", 2)
			for let n in 0..6 {
				try Messaging.publish(n, "test.fan")
			}
			let sum = 0
			for let _ in 0..6 {
				sum += nextInt(shared)
			}
			try testing.expectEqual(15, sum, "each message goes to one member of the group")
			time.sleep(20ms)
			try testing.expectEqual(0, shared.len(), "and to one only")
			try Messaging.unsubscribe(a)
			try Messaging.unsubscribe(b)
			return none
		}

		@test()
		def priorityDelayAndReceive() !none {
			let inbox = try Messaging.subscribe("test.inbox")
			try testing.expectNone(try Messaging.receive(inbox, 0s), "nothing published yet")

			try Messaging.publish("low", "test.inbox", 1)
			try Messaging.publish("high", "test.inbox", 5)
			try Messaging.publish("high again", "test.inbox", 5)
			try Messaging.publish("late", "test.inbox", 9, 60ms)
			let order = string[]
			for let _ in 0..3 {
				let message = try Messaging.receive(inbox, 0s)
				fail "a published message is ready" when message is none
				order.push(string(message.payload))
				try Messaging.ack(message)
			}
			try testing.expectEqual("high,high again,low", order.join(","), "higher priority first, then publication order")
			try testing.expectNone(try Messaging.receive(inbox, 0s), "a delayed message is not ready")

			let started = time.monoNs()
			let late = try Messaging.receive(inbox, 2s)
			fail "the delayed message arrives" when late is none
			try testing.expectEqual("late", string(late.payload), "after its delay")
			try testing.expectTrue(time.monoNs() - started >= int64(40ms), "and not before")
			try Messaging.ack(late)

			started = time.monoNs()
			try testing.expectNone(try Messaging.receive(inbox, 30ms), "receive gives up at its timeout")
			try testing.expectTrue(time.monoNs() - started >= int64(30ms), "after waiting for it")
			try Messaging.unsubscribe(inbox)
			return none
		}

		@test()
		def nackAndAck() !none {
			let inbox = try Messaging.subscribe("test.nack")
			try Messaging.publish("again", "test.nack", headers = {"trace": "t1"})
			let first = try Messaging.receive(inbox, 1s)
			fail "published" when first is none
			try testing.expectEqual(1, first.attempt, "first delivery")
			try testing.expectEqual("t1", first.headers["trace"], "headers travel with the message")
			try Messaging.nack(first, 0s)

			let second = try Messaging.receive(inbox, 1s)
			fail "delivered again after a nack" when second is none
			try testing.expectEqual(2, second.attempt, "second delivery")
			try testing.expectEqual(first.id, second.id, "of the same message")
			try Messaging.ack(second)

			let kind = ""
			Messaging.ack(second) onerror (err error) {
				kind = kindOf(err)
				recover none
			}
			try testing.expectEqual("NotPending", kind, "a message is settled once")
			try Messaging.unsubscribe(inbox)
			return none
		}

		@test()
		def retriesThenDeadLetter() !none {
			try Messaging.config(MessagingConfig{maxAttempts: 3, retryDelay: 1ms})
			let letters = try Messaging.subscribe("messaging.dead")
			let attempts = new channel<int>(64)
			let failing = try Messaging.subscribe("test.poison", def (message Message) !none {
				attempts <- message.attempt
				fail "cannot handle"
			})
			try Messaging.publish("poison", "test.poison")
			try testing.expectEqual(1, nextInt(attempts), "first attempt")
			try testing.expectEqual(2, nextInt(attempts), "retried")
			try testing.expectEqual(3, nextInt(attempts), "last attempt")

			let letter = try Messaging.receive(letters, 2s)
			fail "a dead letter is published" when letter is none
			let content = letter.payload
			if content is DeadLetter {
				try testing.expectEqual("test.poison", content.message.topic, "the dead message")
				try testing.expectEqual(3, content.message.attempt, "after its last attempt")
				try testing.expectEqual("cannot handle", content.reason, "with the handler's error")
			} else {
				fail "the dead-letter topic carries DeadLetter values"
			}
			try Messaging.ack(letter)
			time.sleep(10ms)
			try testing.expectEqual(0, attempts.len(), "no delivery after the last attempt")
			try Messaging.unsubscribe(failing)
			try Messaging.unsubscribe(letters)
			try Messaging.config(MessagingConfig{})
			return none
		}

		@test()
		def refusals() !none {
			let kind = ""
			Messaging.publish(1, "test.*") onerror (err error) {
				kind = kindOf(err)
				recover MessageId(0)
			}
			try testing.expectEqual("InvalidTopic", kind, "a pattern is not a topic to publish on")

			kind = ""
			Messaging.publish("text") onerror (err error) {
				kind = kindOf(err)
				recover MessageId(0)
			}
			try testing.expectEqual("InvalidTopic", kind, "a string has no topic of its own")

			kind = ""
			Messaging.unsubscribe(SubscriptionId(999999)) onerror (err error) {
				kind = kindOf(err)
				recover none
			}
			try testing.expectEqual("UnknownSubscription", kind, "unknown subscription")

			let handled = try Messaging.subscribe("test.refusals", def (message Message) !none {
				return none
			})
			kind = ""
			Messaging.receive(handled, 0s) onerror (err error) {
				kind = kindOf(err)
				recover none
			}
			try testing.expectEqual("InvalidHandler", kind, "a handler takes the messages, receive cannot")
			try Messaging.unsubscribe(handled)

			try Messaging.config(MessagingConfig{capacity: 2})
			let small = try Messaging.subscribe("test.full")
			try Messaging.publish(1, "test.full")
			try Messaging.publish(2, "test.full")
			kind = ""
			Messaging.publish(3, "test.full") onerror (err error) {
				kind = kindOf(err)
				recover MessageId(0)
			}
			try testing.expectEqual("Full", kind, "a full subscription refuses the message")
			try Messaging.unsubscribe(small)
			try Messaging.config(MessagingConfig{})

			kind = ""
			Messaging.config(MessagingConfig{maxAttempts: 0}) onerror (err error) {
				kind = kindOf(err)
				recover none
			}
			try testing.expectEqual("InvalidConfig", kind, "at least one attempt")
			return none
		}

		@test()
		def unsubscribeEndsReceive() !none {
			let inbox = try Messaging.subscribe("test.ends")
			let ended = new channel<bool>(1)
			async reportEnd(inbox, ended)
			time.sleep(20ms)
			try Messaging.unsubscribe(inbox)
			let timeout = time.sleepChan(2s)
			select {
				case ended:
					try testing.expectTrue(<-ended, "receive returns none when its subscription ends")
				case timeout:
					fail "receive still waits after unsubscribe"
			}
			return none
		}

		@test()
		def restartKeepsAnnotatedSubscriptions() !none {
			let inbox = try Messaging.subscribe("test.restart")
			try await Messaging.restart()
			let ids = Messaging.subscriptions().mapElem(s => s.id)
			try testing.expectFalse(ids.includes(inbox), "a subscription made in code ends with the service")
			try Messaging.publish(OrderCreated{id: 21})
			try testing.expectEqual(21, nextInt(ordersSeen), "annotated functions are subscribed again")
			return none
		}
	}
}
