partial module std.services.network {
	use (
		std.services::(Dependencies, Lifecycle, RestartMode, StartMode)
		std.services.policy::(Endpoint, EndpointSpec, Policy)
		std.services.diagnostics::(Diagnostics)
		std.net
		std.net.dns
		std.net.stun
		std.time
		std.glob::(Glob)
	)

	// What a test can make the Network do (`Network.lab.conditions`). The
	// defaults change nothing.
	struct NetworkConditions {
		// Endpoints that cannot be reached, as a glob over the endpoint the
		// program names (`"*.example.com:443"`, `"*"` for no network at all):
		// connecting and sending there fails with `EHOSTUNREACH`.
		unreachable string = ""

		// Endpoints nobody listens on, in the same way: `ECONNREFUSED`.
		refused string = ""

		// Host names that do not resolve, as a glob.
		unresolved string = ""

		// The addresses of host names, asked before any resolver:
		// `{"api.example.com": ["127.0.0.1"]}` sends the program to a server of
		// the test's own.
		hosts map<string, string[]> = map<string, string[]>{}

		// How fast reads and writes move data, in bytes per second: each call
		// takes the time its bytes need. 0 is as fast as the link.
		bytesPerSecond int = 0

		// The most bytes one `read` or `write` moves, as a congested link does.
		chunk int = 0

		// The bytes that still pass before the connections break: reads and
		// writes use them up, and the one that does not fit fails with
		// `ECONNRESET`, as a link that drops in the middle of a transfer.
		breaksAfter ?int64 = none

		// The share of datagrams sent that never arrive; the sender is told
		// they left.
		datagramLoss float = 0.0

		// Nothing arrives: a read waits its timeout out and fails with
		// `ETIMEDOUT`, as with a peer that went silent.
		silent bool = false
	}

	// The Network's settings (`Network.config`).
	struct NetworkConfig {
		// The STUN servers (RFC 8489) `publicAddr` asks, in order, as
		// `host:port`: the first that answers gives the address. Both
		// defaults answer Binding requests without an account. Empty turns
		// `publicAddr` off.
		stunServers string[] = ["stun.l.google.com:19302", "stun.cloudflare.com:3478"]
	}

	// Describes an open socket. Only the descriptor for now.
	struct SocketInfo {
		// leave fields for later
		fd int
	}

	internal def checkNameServerQuery(query byte[], server string) !none {
		fail Error{message: "{server} is not a system name server", code: "EACCES"} unless dns.isSystemServer(server)
		let message = try dns.decode(query)
		fail Error{message: "not a DNS query", code: "EINVAL"} when message.response || message.questions.len() == 0
		for let (_, question) in message.questions {
			try Policy.validate("adm.network.connect", "std.services.policy.EndpointSpec", question.name)
		}
		return none
	}

	// One length-prefixed DNS message each way on a connected descriptor.
	internal def nameServerRoundTrip(fd int, query byte[], timeout duration) !byte[] {
		let frame byte[] = [byte(query.len() >> 8 & 0xff), byte(query.len() & 0xff)]
		for let i = 0; i < query.len(); i++ {
			frame.push(query[i])
		}
		let sent = 0
		for sent < frame.len() {
			let n = try __net_write(fd, frame[sent:], timeout)
			fail Error{message: "name server accepts no more bytes", code: "EPIPE"} when n <= 0
			sent += n
		}
		let head = try readExactly(fd, 2, timeout)
		return try readExactly(fd, int(head[0]) << 8 | int(head[1]), timeout)
	}

	internal def readExactly(fd int, size int, timeout duration) !byte[] {
		let out byte[] = []
		out.len(size)
		let got = 0
		for got < size {
			let n = try __net_read(fd, out[got:], timeout)
			fail Error{message: "name server closed the connection inside a message", code: "ECONNRESET"} when n <= 0
			got += n
		}
		return out
	}

	// candidates are the numeric endpoints to try for `host:port`: the
	// endpoint itself when the host is an IP literal, empty, or a Unix socket
	// path, else one per address the name resolves to.
	internal def candidates(addr string) !string[] {
		let parsed = net.parseAddress(addr) onerror recover new net.Address()
		return [addr] when parsed.isUnix || parsed.host == "" || parsed.host.isIP()
		let out string[]
		for let (_, ip) in try Network.resolve(parsed.host) {
			out.push(ip.contains(":") ?? ("[{ip}]:{parsed.port}", "{ip}:{parsed.port}"))
		}
		return out
	}

	// share is the part of the time left that one of `remaining` attempts
	// may take, so an address that never answers leaves time for the next.
	internal def share(left duration, remaining int) duration {
		return left when remaining <= 1
		let part = duration(int(left) / remaining)
		return part < 2s ?? (left < 2s ?? (left, 2s), part)
	}

	// Opens, connects, reads and writes sockets on the application's behalf.
	//
	// Every call is checked against the network policy; `std.net` builds on it and is the
	// usual way in.
	// Methods that block on a descriptor (accept, connect, read, write, the
	// datagram pair) are `@query`: a `@commit` holds the service lock, and a
	// read parked in the netpoller would keep every other task out of the
	// service until its timeout.
	service Network {
		description  = ""
		dependencies = Dependencies{
			hard: [Diagnostics, Policy]
		}
		lifecycle    = Lifecycle{
			start: StartMode.Automatic,
			restart: RestartMode.Always,
		}
		permissions  = [
			Permission{name: "connect", description: "Open outgoing connections", spec: EndpointSpec},
			Permission{name: "listen", description: "Accept incoming connections", spec: EndpointSpec},
		]

		lab = new ServiceLab<NetworkConditions>()

		settings = NetworkConfig{}

		// Applies the service's settings.
		//
		// Fails when a STUN server is not `host:port`.
		def config(val NetworkConfig) !none {
			for let (_, server) in val.stunServers {
				let parsed = net.parseAddress(server) onerror recover new net.Address()
				fail Error{message: "{server}: a STUN server is written host:port", code: "EINVAL"} when parsed.host == "" || parsed.port <= 0
			}
			settings = val
			return none
		}

		// Fails for an endpoint the lab makes unreachable or refusing.
		def reachable(endpoint string) !none {
			let unreachable = lab.conditions.unreachable
			fail Error{message: "{endpoint}: no route to host (lab)", code: "EHOSTUNREACH"} when unreachable != "" && new Glob(unreachable).matches(endpoint)
			let refused = lab.conditions.refused
			fail Error{message: "{endpoint}: connection refused (lab)", code: "ECONNREFUSED"} when refused != "" && new Glob(refused).matches(endpoint)
			return none
		}

		// The part of a buffer one call moves under the lab's chunk size.
		def portion(data byte[]) byte[] {
			let most = lab.conditions.chunk
			return data when most <= 0 || data.len() <= most
			return data[:most]
		}

		// Takes `bytes` from what the lab lets pass before the link breaks;
		// fails when they do not fit.
		def pass(bytes int) !none {
			let left = lab.conditions.breaksAfter
			return none when left is none
			if int64(bytes) > left {
				lab.conditions.breaksAfter = 0
				fail Error{message: "connection reset by peer (lab)", code: "ECONNRESET"}
			}
			lab.conditions.breaksAfter = left - int64(bytes)
			return none
		}

		// Holds the call for the time `n` bytes take at the lab's speed.
		def pace(n int) {
			let speed = lab.conditions.bytesPerSecond
			return when speed <= 0 || n <= 0
			time.sleep(duration(int64(n) * 1000000000 / int64(speed)))
		}

		// Under a silent lab, waits the timeout out and fails as a read that
		// got nothing.
		def heard(timeout duration) !none {
			return none unless lab.conditions.silent
			time.sleep(timeout)
			fail Error{message: "read timed out (lab)", code: "ETIMEDOUT"}
		}

		// Has a connected TCP socket send what it is given at once
		// (TCP_NODELAY): a request written in two parts, or a small reply on a
		// connection that stays open, otherwise waits for the peer's delayed
		// acknowledgement, 40 ms on Linux. `setNoDelay(fd, false)` puts the
		// batching back. A socket that is no TCP socket refuses the option,
		// which is nothing to report.
		def sendAtOnce(fd int) {
			__net_set_nodelay(fd, true) onerror recover none
		}

		// Starts the service. Does not fail today.
		async def start() !none {
			return none
		}

		// Stops the service. Does not fail today.
		async def stop() !none {
			return none
		}

		// Stops the service and starts it again. Does not fail today.
		async def restart() !none {
			return none
		}

		@os("linux", "darwin", "windows")
		internal const AF_UNIX = 1

		@os("linux", "darwin", "windows")
		internal const AF_INET = 2

		@os("linux")
		internal const AF_INET6 = 10
		@os("darwin")
		internal const AF_INET6 = 30
		@os("windows")
		internal const AF_INET6 = 23

		// wasi-libc's numbers: the web has no sockets, every call fails there.
		@os("wasm")
		internal const AF_UNIX = 3
		@os("wasm")
		internal const AF_INET = 1
		@os("wasm")
		internal const AF_INET6 = 2

		internal const SOCK_STREAM = 1
		internal const SOCK_DGRAM = 2

		// Opens a socket for the domain and type; the protocol follows from
		// them. The socket owns its descriptor and must be closed. Errors carry
		// the errno as `error.code` (`std.net.EAddrInUse`) and name the failing
		// operation.
		@commit()
		def socket(domain net.SocketDomain, typ net.SocketType) !net.Socket {
			let af = AF_INET
			if domain == net.SocketDomain.IPv6 {
				af = AF_INET6
			} else if domain == net.SocketDomain.Unix {
				af = AF_UNIX
			}

			let st = SOCK_STREAM
			if typ == net.SocketType.Datagram {
				st = SOCK_DGRAM
			}

			let fd = try __net_socket(af, st)
			return new net.Socket(fd)
		}

		// Opens a socket and returns its raw descriptor, for code that works
		// with descriptors rather than `std.net.Socket`.
		//
		// Fails when the policy denies it or the operating system cannot create the socket.
		@commit()
		def socketFd(domain net.SocketDomain, typ net.SocketType) !int {
			let af = AF_INET
			if domain == net.SocketDomain.IPv6 {
				af = AF_INET6
			} else if domain == net.SocketDomain.Unix {
				af = AF_UNIX
			}

			let st = SOCK_STREAM
			if typ == net.SocketType.Datagram {
				st = SOCK_DGRAM
			}

			return __net_socket(af, st)
		}

		// Binds a socket to a local address: `host:port` or `:port` for IPv4,
		// `[host]:port` or `[]:port` for IPv6, an absolute path for a Unix
		// socket. An empty host binds every interface, port 0 picks a free one
		// (`localAddr` tells which). An existing Unix socket path is not removed.
		//
		// Fails when the address does not parse, the policy denies it, or the operating system refuses, for example when the address is in use.
		@query(policy = "listen")
		def bind(fd int, addr Endpoint) !none {
			let failure ?error = none
			for let (_, candidate) in try candidates(addr.value()) {
				failure = none
				__net_bind(fd, candidate) onerror (err error) {
					failure = err
					recover none
				}
				return none when failure is none
			}
			fail failure unless failure is none
			return none
		}

		// Connects a socket to a remote endpoint, waiting at most `timeout` for
		// the handshake; a timeout fails with `ETIMEDOUT` and leaves the socket
		// open for the caller to close or retry.
		//
		// A host name is resolved by `resolve` and its addresses are tried in
		// turn. Fails when the name does not resolve, the policy denies the
		// endpoint, or no address connects.
		@query(policy = "connect")
		def connect(fd int, addr Endpoint, timeout duration = 30s) !none {
			try reachable(addr.value())
			let started = time.now()
			let targets = try candidates(addr.value())
			let failure ?error = none
			for let (i, candidate) in targets {
				failure = none
				__net_connect(fd, candidate, share(timeout - time.since(started), targets.len() - i)) onerror (err error) {
					failure = err
					recover none
				}
				continue unless failure is none
				sendAtOnce(fd)
				return none
			}
			fail failure unless failure is none
			return none
		}

		// Accept a new connection from a listening stream socket FD.
		//
		// Returns the accepted connection as a new file descriptor; the caller owns
		// the returned FD and must close it.
		//
		// Fails when fd is not listening or the operating system refuses.
		@query(policy = "listen")
		def accept(fd int) !int {
			let accepted = try __net_accept(fd)
			sendAtOnce(accepted)
			return accepted
		}

		// Close a socket FD.
		//
		// Closing an already-closed FD is an OS error; `std.net` wrappers typically
		// expose `close()` and forward to this method.
		@commit()
		def close(fd int) !none {
			return __net_close(fd)
		}

		// Mark a bound stream socket as a listener.
		//
		// `backlog` is passed through to the OS; its effective value may be clamped
		// by the platform.
		//
		// Fails when fd is not bound or the operating system refuses.
		@commit(policy = "listen")
		def listen(fd int, backlog int) !none {
			return __net_listen(fd, backlog)
		}

		// Write bytes to a connected stream socket FD.
		//
		// Returns the number of bytes written; short writes are normal and callers
		// must loop if they need to send the full buffer (see `std.net.Connection.writeAll`).
		//
		// `timeout` bounds the wait for the FD to become writable, not an end-to-end
		// "flush to peer" guarantee.
		//
		// Fails when fd is closed, the peer is gone, or the timeout passes.
		@query()
		def write(fd int, data byte[], timeout duration = 30s) !int {
			//bytesWrittenMetric.update(n)
			let part = portion(data)
			try pass(part.len())
			let n = try __net_write(fd, part, timeout)
			pace(n)
			return n
		}

		// Sends one byte of TCP urgent (out-of-band) data on a stream socket
		// FD; the peer's socket marks the point in the stream it sits at.
		//
		// Fails when fd is closed or the peer is gone.
		@query()
		def sendUrgent(fd int, value byte) !none {
			return __net_send_urgent(fd, int(value))
		}

		// Reports whether urgent data waits to be read on a stream socket FD,
		// without blocking.
		//
		// Fails when fd is not a socket.
		@query()
		def urgentPending(fd int) !bool {
			let pending = try __net_urgent_pending(fd)
			return pending != 0
		}

		// Makes urgent data arrive inline on a stream socket FD, in its place
		// among the other bytes, instead of apart.
		//
		// Fails when fd is not a socket.
		@query()
		def urgentInline(fd int, enabled bool) !none {
			return __net_urgent_inline(fd, enabled ?? (1, 0))
		}

		// Read bytes from a connected stream socket FD.
		//
		// Returns the number of bytes read (0 indicates EOF / peer shutdown).
		//
		// `timeout` bounds the wait for the FD to become readable.
		//
		// Fails when fd is closed or the timeout passes.
		@query()
		def read(fd int, data byte[], timeout duration = 30s) !int {
			//bytesReadMetric.update(n)
			try heard(timeout)
			let n = try __net_read(fd, portion(data), timeout)
			try pass(n)
			pace(n)
			return n
		}

		// Resolve a host name to IP literals (IPv4 and/or IPv6) through the
		// `std.net.dns` resolver: the hosts file, then the system's name
		// servers. An IP literal comes back as it is.
		//
		// The returned strings never include ports. For "host:port" parsing and
		// socket endpoint construction, see `std.net.Address`.
		//
		// Fails when the name does not resolve or the policy denies connecting to it.
		@query()
		def resolve(name string) !string[] {
			let unresolved = lab.conditions.unresolved
			fail Error{message: "{name}: no such host (lab)", code: "dns"} when unresolved != "" && new Glob(unresolved).matches(name)
			return lab.conditions.hosts[name] when lab.conditions.hosts.hasKey(name)
			return dns.resolver().lookupHost(name) onerror (err error) {
				fail Error{message: err.message, code: "dns", cause: err}
			}
		}

		// The system's resolver configuration in the `resolv.conf` format
		// (`/etc/resolv.conf`; on Windows the DNS servers of the adapters that
		// are up and the search list), "" when there is none. Read without a
		// storage permission: name resolution is part of connecting.
		@query()
		def resolverConfig() string {
			return systemResolverText()
		}

		// The text of the system's hosts file (`/etc/hosts`; on Windows
		// `System32\drivers\etc\hosts`), "" when it cannot be read. Read
		// without a storage permission, as `resolverConfig` is.
		@query()
		def hostsFile() string {
			return string(__fs_read_all(systemHostsPath()) onerror recover [])
		}

		// Sends a DNS query to one of the system's name servers from a datagram
		// socket. The server is not checked against the `connect` policy, since
		// resolving a name is part of connecting to it; the names the query asks
		// about are, as hosts.
		//
		// Fails when `server` is not one of `dns.systemConfig().servers`, the
		// bytes are not a DNS query, the policy denies one of its names, or the
		// send is refused or times out.
		@query()
		def sendToNameServer(fd int, query byte[], server string, timeout duration = 5s) !int {
			try checkNameServerQuery(query, server)
			return __net_send_to(fd, query, server, timeout)
		}

		// Sends a DNS query to one of the system's name servers over TCP and
		// returns the response, checked as `sendToNameServer` checks.
		//
		// Fails as `sendToNameServer` does, and when the connection fails, times
		// out or closes before a whole response arrived.
		@query()
		def exchangeWithNameServer(query byte[], server string, timeout duration = 5s) !byte[] {
			try checkNameServerQuery(query, server)
			let fd = try __net_dial_stream(server, timeout)
			let failure ?error = none
			let response = nameServerRoundTrip(fd, query, timeout) onerror (err error) {
				failure = err
				recover []
			}
			__net_close(fd) onerror recover none
			fail failure unless failure is none
			return response
		}

		// Resolve + connect a stream socket and return a connected file descriptor.
		//
		// This is the lowest-level "dial" helper: it returns a raw FD so higher-level
		// wrappers (`std.net.dialStream`, connection pools, etc.) can build on it.
		// A TCP socket comes back sending what it is given at once (TCP_NODELAY), as
		// one from `connect` or `accept` does; `setNoDelay(fd, false)` changes that.
		//
		// Fails when the name does not resolve, the policy denies it, or no address connects within the timeout.
		@query(policy = "connect")
		def dialStream(addr Endpoint, timeout duration = 30s) !int {
			try reachable(addr.value())
			let started = time.now()
			let targets = try candidates(addr.value())
			let failure ?error = none
			for let (i, candidate) in targets {
				let fd = -1
				fd = __net_dial_stream(candidate, share(timeout - time.since(started), targets.len() - i)) onerror (err error) {
					failure = err
					recover -1
				}
				continue when fd < 0
				sendAtOnce(fd)
				return fd
			}
			fail failure unless failure is none
			fail Error{message: "dial: no address to connect to", code: "EADDRNOTAVAIL"}
		}

		// Send a datagram to a remote address (UDP / Unix datagram).
		//
		// Returns the number of bytes sent. For datagrams this is usually either
		// `data.len()` or an error.
		@query(policy = "connect")
		def sendTo(fd int, data byte[], addr Endpoint, timeout duration = 30s) !int {
			let value = addr.value()
			try reachable(value)
			return data.len() when lab.chance(lab.conditions.datagramLoss)
			// An IP address goes out as written: the system takes numeric
			// addresses only, and fails with `dns` for a name, which is then
			// resolved here.
			let failure ?error = none
			let sent = __net_send_to(fd, data, value, timeout) onerror (err error) {
				failure = err
				recover -1
			}
			return sent when failure is none
			let refused error = failure
			fail refused unless refused.code == "dns"
			for let (_, candidate) in try candidates(value) {
				failure = none
				let n = __net_send_to(fd, data, candidate, timeout) onerror (err error) {
					failure = err
					recover -1
				}
				return n when failure is none
			}
			fail failure unless failure is none
			fail Error{message: "send: no address to send to", code: "EADDRNOTAVAIL"}
		}

		// Sends one datagram on a datagram socket connected to its peer
		// (`connect`): no address travels with the call, and the policy was
		// asked when the socket was connected.
		//
		// Returns the number of bytes sent. Fails when fd is closed, not
		// connected, or the send is refused or times out.
		@query()
		def send(fd int, data byte[], timeout duration = 30s) !int {
			return data.len() when lab.chance(lab.conditions.datagramLoss)
			return __net_write(fd, data, timeout)
		}

		// Receives the next datagram from the peer a datagram socket is
		// connected to into `data` and returns its length; one longer than
		// `data` is cut to it.
		//
		// Fails when fd is closed or the timeout passes.
		@query()
		def receive(fd int, data byte[], timeout duration = 30s) !int {
			try heard(timeout)
			return __net_read(fd, data, timeout)
		}

		// Receive a datagram and return the byte count and sender address string.
		//
		// The returned address uses the same string format accepted by `sendTo` and
		// `std.net.Address.parse`.
		//
		// Fails when fd is closed or the timeout passes.
		@query()
		def recvFrom(fd int, data byte[], timeout duration = 30s) !(int, string) {
			try heard(timeout)
			return __net_recv_from(fd, data, timeout)
		}

		// Hands an open descriptor (a file, a memory file, a socket) to the
		// process at the other end of a Unix socket, which gets a descriptor of
		// its own for the same open file; this one stays open and is the
		// caller's to close. `addr` is the path of the receiving socket for a
		// datagram socket that is not connected, and stays empty on a connected
		// one. On a stream socket one zero byte travels with the descriptor,
		// which `receiveDescriptor` takes off again.
		//
		// Fails when fd is not a Unix socket, the policy denies `addr`, the peer
		// is gone or its queue stays full for the timeout.
		@query()
		def sendDescriptor(fd int, descriptor int, addr string = "", timeout duration = 30s) !none {
			if addr != "" {
				try reachable(addr)
				try Policy.validate("adm.network.connect", "std.services.policy.EndpointSpec", addr)
			}
			return __net_send_fd(fd, descriptor, addr, timeout)
		}

		// Takes the next message of a Unix socket and returns the descriptor it
		// carries, which the caller owns and must close.
		//
		// Fails when fd is closed, the timeout passes, or the message carries no
		// descriptor (`ENOMSG`; the message is used up).
		@query()
		def receiveDescriptor(fd int, timeout duration = 30s) !int {
			try heard(timeout)
			return __net_receive_fd(fd, timeout)
		}

		// Shutdown one or both halves of a connection.
		//
		// `how` values:
		// - 0: read half (further reads fail/EOF)
		// - 1: write half (further writes fail)
		// - 2: both (full shutdown)
		@commit()
		def shutdown(fd int, how int = 2) !none {
			return __net_shutdown(fd, how)
		}

		// Enable or disable SO_REUSEADDR.
		//
		// This is typically required for servers that need to restart quickly.
		//
		// Fails when the operating system rejects the option for this socket.
		@commit()
		def setReuseAddr(fd int, enabled bool = true) !none {
			return __net_set_reuseaddr(fd, enabled)
		}

		// Enable or disable SO_BROADCAST, which a datagram socket needs to
		// send to a broadcast address (255.255.255.255, a subnet's last).
		//
		// Fails when the operating system rejects the option for this socket.
		@commit()
		def setBroadcast(fd int, enabled bool = true) !none {
			return __net_set_broadcast(fd, enabled)
		}

		// Enable or disable TCP_NODELAY (TCP only).
		//
		// For non-TCP sockets this may fail with an OS error.
		@commit()
		def setNoDelay(fd int, enabled bool = true) !none {
			return __net_set_nodelay(fd, enabled)
		}

		// Enable or disable SO_KEEPALIVE.
		//
		// Keepalive behavior is OS-configured; this only toggles it.
		//
		// Fails when the operating system rejects the option for this socket.
		@commit()
		def setKeepAlive(fd int, enabled bool = true) !none {
			return __net_set_keepalive(fd, enabled)
		}

		// Enable or disable port sharing: SO_REUSEPORT, or SO_REUSEADDR on
		// Windows, which is how sockets share a port there.
		//
		// Some OSes do not expose this option; in that case this returns an error.
		@commit()
		def setReusePort(fd int, enabled bool = true) !none {
			return __net_set_reuseport(fd, enabled)
		}

		// Control SO_LINGER.
		//
		// When enabled, `seconds` controls how long the OS may block during `close`
		// in an attempt to deliver queued data.
		//
		// Fails when the operating system rejects the option for this socket.
		@commit()
		def setLinger(fd int, enabled bool, seconds int = 0) !none {
			return __net_set_linger(fd, enabled, seconds)
		}

		// Set SO_RCVBUF.
		//
		// Fails when the operating system rejects the option for this socket.
		@commit()
		def setRecvBuf(fd int, bytes int) !none {
			return __net_set_recvbuf(fd, bytes)
		}

		// Set SO_SNDBUF.
		//
		// Fails when the operating system rejects the option for this socket.
		@commit()
		def setSendBuf(fd int, bytes int) !none {
			return __net_set_sendbuf(fd, bytes)
		}

		// Joins a multicast group on a datagram socket, so that what is sent
		// to the group reaches it: `224.0.0.251`, `ff02::fb`. `iface` names
		// the interface by its address (IPv4) or its name (IPv6); empty
		// leaves the choice to the system's routing.
		//
		// Fails when the address is no multicast group, the interface does
		// not exist or has no multicast, or the system refuses.
		@commit()
		def joinGroup(fd int, group string, iface string = "") !none {
			return __net_join_group(fd, group, iface, true)
		}

		// Leaves a multicast group joined with `joinGroup`.
		//
		// Fails when the socket is no member of the group.
		@commit()
		def leaveGroup(fd int, group string, iface string = "") !none {
			return __net_join_group(fd, group, iface, false)
		}

		// Sets how many hops what the socket sends to a multicast group may
		// travel (1 stays on the link, which is the system's default), and
		// whether this host's own members of the group get it too.
		//
		// Fails when the operating system rejects the option for this socket.
		@commit()
		def setMulticast(fd int, ttl int = 1, loop bool = true) !none {
			return __net_set_multicast(fd, ttl, loop)
		}

		// Sets an integer socket option by its `setsockopt` level and name, for
		// options `std.net.Socket` does not wrap.
		//
		// Fails when the operating system rejects the option for this socket.
		@commit()
		def setSockOptInt(fd int, level int, opt int, val int) !none {
			return __net_setsockopt_int(fd, level, opt, val)
		}

		// Read an integer socket option.
		//
		// Fails when the operating system rejects the option for this socket.
		@commit()
		def getSockOptInt(fd int, level int, opt int) !int {
			return __net_getsockopt_int(fd, level, opt)
		}

		// Return the local endpoint of a socket FD, formatted as an address string.
		//
		// For stream sockets, this is useful after binding `:0` to discover the
		// chosen ephemeral port. For Unix sockets, this is typically the bound path.
		//
		// Fails when fd is not a bound socket.
		@query()
		def localAddr(fd int) !string {
			return __net_local_addr(fd)
		}

		// The user id of the process at the other end of a connected Unix
		// socket, as the kernel recorded it when the connection was made: who
		// is calling, without anything the caller sends.
		//
		// Fails when fd is not a connected Unix socket, or on a platform that
		// does not report it (Windows).
		@query()
		def peerUserId(fd int) !int {
			return __net_peer_uid(fd)
		}

		// Return the remote endpoint of a connected socket FD, formatted as an
		// address string.
		//
		// Fails when fd is not a connected socket.
		@query()
		def remoteAddr(fd int) !string {
			return __net_remote_addr(fd)
		}

		// Returns the host's public address as seen from outside the local
		// network: the IP address a STUN server (RFC 8489) saw a Binding
		// request come from. Behind a NAT that is the NAT's outside address;
		// a host with an address of its own on the internet gets that one.
		// The servers of `NetworkConfig.stunServers` are asked in turn, each
		// with a request sent three times (after 0.5, 1 and 2 seconds of
		// silence), so a server that never answers costs 3.5 seconds.
		//
		// Fails when no STUN server is configured, the policy denies
		// connecting to one (`adm.network.connect`), or none answers.
		@query()
		def publicAddr() !string {
			let servers = settings.stunServers
			fail Error{message: "publicAddr: no STUN server is configured (NetworkConfig.stunServers)", code: "EINVAL"} when servers.len() == 0
			let failures string[] = []
			for let (_, server) in servers {
				let failure ?error = none
				let host = askStun(server) onerror (err error) {
					failure = err
					recover ""
				}
				return host when failure is none
				failures.push("{server}: {failure.message}")
			}
			fail Error{message: "publicAddr: no STUN server answered ({failures.join("; ")})", code: "EHOSTUNREACH"}
		}

		// The address `server` saw a Binding request come from, from the
		// first of its addresses that answers.
		def askStun(server string) !string {
			try Policy.validate("adm.network.connect", "std.services.policy.EndpointSpec", server)
			try reachable(server)
			let failure ?error = none
			for let (_, candidate) in try candidates(server) {
				failure = none
				let host = bindingFrom(candidate) onerror (err error) {
					failure = err
					recover ""
				}
				return host when failure is none
			}
			fail failure unless failure is none
			fail Error{message: "{server} has no address", code: "EADDRNOTAVAIL"}
		}

		// The address the STUN server at `candidate` (numeric) saw a
		// Binding request come from, over a UDP socket of its own.
		def bindingFrom(candidate string) !string {
			let fd = try __net_socket(candidate.startsWith("[") ?? (AF_INET6, AF_INET), SOCK_DGRAM)
			let failure ?error = none
			let host = bindingOn(fd, candidate) onerror (err error) {
				failure = err
				recover ""
			}
			__net_close(fd) onerror recover none
			fail failure unless failure is none
			return host
		}

		// One Binding transaction on `fd`, retransmitted as RFC 8489 §6.2.1
		// has it with Rc = 3. An answer that is not a STUN response to this
		// request is skipped.
		def bindingOn(fd int, candidate string) !string {
			try __net_connect(fd, candidate, 5s)
			let request = try stun.request(stun.Method.Binding)
			let bytes = request.encode()
			let buffer byte[] = []
			buffer.len(1500)
			let wait = 500ms
			for let attempt = 0; attempt < 3; attempt++ {
				if !lab.chance(lab.conditions.datagramLoss) {
					try __net_write(fd, bytes, wait)
				}
				let deadline = time.now() + wait
				for {
					let left = deadline - time.now()
					break when left <= 0s
					let timedOut = false
					try heard(left)
					let n = __net_read(fd, buffer, left) onerror (err error) {
						fail err unless err.code == "ETIMEDOUT"
						timedOut = true
						recover 0
					}
					break when timedOut
					let malformed = false
					let reply = stun.parseMessage(buffer[0:n].clone()) onerror (err error) {
						malformed = true
						recover request
					}
					continue when malformed
					continue unless reply.method == stun.Method.Binding && reply.transactionID.equals(request.transactionID)
					let refusal = reply.refusal()
					fail Error{message: "the server refused the Binding request: {refusal.code} {refusal.reason}", code: "ECONNREFUSED"} unless refusal is none
					continue unless reply.class == stun.MessageClass.SuccessResponse
					let mapped = reply.xorAddress(stun.AttributeType.XorMappedAddress)
					mapped = reply.address(stun.AttributeType.MappedAddress) when mapped is none
					fail Error{message: "the Binding response carries no address", code: "EPROTO"} when mapped is none
					return mapped.host
				}
				wait = wait + wait
			}
			fail Error{message: "no answer after 3 requests", code: "ETIMEDOUT"}
		}

		// Lists the host's network interfaces with their addresses and
		// `std.net.NetIface*` flags.
		//
		// Fails when the operating system cannot list the interfaces.
		@query()
		def netIface() !net.NetInterface[] {
			let (names, indices, flags, mtus, hwAddrs, addrs) = try __net_ifaces()
			let out net.NetInterface[]

			for let i = 0; i < names.len(); i++ {
				out.push(net.NetInterface{
					name:         names[i],
					index:        indices[i],
					flags:        flags[i],
					mtu:          mtus[i],
					hardwareAddr: hwAddrs[i],
					addrs:        addrs[i],
				})
			}
			return out
		}

		// Returns runtime information for all sockets owned by the Network service.
		@query()
		def sockets() SocketInfo[] {
			return []
		}

		// Returns runtime information for the specified socket.
		@query()
		def socketInfo(fd int) ?SocketInfo {
			return none
		}
	}
	/*
	    If every socket goes through this service, then ADM can provide centralized:
	
	    permissions
	    connection tracking
	    traffic metrics
	    DNS
	    interfaces
	    socket lifecycle
	    bandwidth
	    firewall-like policy
	*/
}
