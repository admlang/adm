// The Network service's IDE panel: the bytes the program's sockets move, its
// open sockets and the host's interfaces, and the buttons that close a socket
// and find the program's public address.

partial module std.services.network {
	use (
		std.ide::(ide, IdeKind, IdeTable, metricsTable)
		std.net
	)

	partial service Network {
		@ide(kind = IdeKind.Series, label = "Received", refresh = 1s, unit = "B", cumulative = true)
		def ideReceived() uint64 {
			return bytesReadMetric.value()
		}

		@ide(kind = IdeKind.Series, label = "Sent", refresh = 1s, unit = "B", cumulative = true)
		def ideSent() uint64 {
			return bytesWrittenMetric.value()
		}

		// What the protocols built on the service count (`net.http.server.requests.total`,
		// the FTP and SMTP byte counts, ...), with the service's own counters.
		@ide(kind = IdeKind.Table, label = "Counters", refresh = 1s, rows = 6)
		def ideCounters() IdeTable {
			let own = metricsTable("service.network.")
			let protocols = metricsTable("net.")
			own.rows.push(...protocols.rows)
			return own
		}

		@ide(kind = IdeKind.Table, label = "Sockets", refresh = 1s, rows = 0)
		def ideSockets() IdeTable {
			let rows = string[][]
			for let (_, info) in opened.all() {
				let held = withAddresses(info)
				rows.push(["{held.fd}", "{held.domain.name} {held.kind.name}", held.local, held.remote, "{held.opened}"])
			}
			return IdeTable{columns: ["Descriptor", "Kind", "Local", "Remote", "Opened"], rows: rows}
		}

		@ide(kind = IdeKind.Table, label = "Interfaces", refresh = 10s, rows = 4)
		def ideInterfaces() IdeTable {
			let rows = string[][]
			let ifaces = netIface() onerror recover net.NetInterface[]
			for let (_, iface) in ifaces {
				rows.push([iface.name, iface.up() ?? ("up", "down"), "{iface.mtu}", iface.hardwareAddr, iface.addrs.join(" ")])
			}
			return IdeTable{columns: ["Interface", "State", "MTU", "Hardware", "Addresses"], rows: rows}
		}

		// Closes a socket the program holds; its next read or write fails.
		@ide(kind = IdeKind.Action, label = "Close socket", confirm = "Close this socket?", row = "ideSockets.Descriptor")
		def ideCloseSocket(fd int) !none {
			return close(fd)
		}

		// Asks the configured STUN servers for the address the program is seen
		// at from outside.
		@ide(kind = IdeKind.Action, label = "Find public address")
		def idePublicAddress() !string {
			return publicAddr()
		}
	}
}
