partial module std.services.network {
	use (
		std.net
		std.net.stun
		std.os
		std.testing
		std.time
	)

	// A stream listener on a port of its own on this machine.
	internal def labListener() !net.Listener {
		let sock = try net.socket(net.SocketDomain.IPv4, net.SocketType.Stream)
		try sock.bind("127.0.0.1:0")
		return sock.listen(8)
	}

	// Accepts one connection, sends back what it reads once, and closes.
	internal async def labEcho(ln net.Listener) !none {
		let conn = try ln.accept()
		let buf byte[] = []
		buf.len(256)
		let n = try conn.read(buf, 5s)
		try conn.writeAll(buf[:n])
		try conn.close()
		return none
	}

	// Accepts one connection and holds it until the listener is closed.
	internal async def labHold(ln net.Listener) !none {
		let conn = try ln.accept()
		let buf byte[] = []
		buf.len(256)
		conn.read(buf, 2s) onerror recover 0
		try conn.close()
		return none
	}

	// Dials `addr` and closes the connection.
	internal def dialOnce(addr string) !none {
		let conn = try net.dialStream(addr, 2s)
		return conn.close()
	}

	// The error code a dial of `addr` fails with, "" when it connects.
	internal def dialCode(addr string) string {
		let code = ""
		dialOnce(addr) onerror (err error) {
			code = err.code
			recover none
		}
		return code
	}

	// `Network.lab.conditions`: what a test makes the network do.
	check "Network lab" {
		testing.beforeEach(def () {
			Network.lab.reset()
		})
		testing.afterAll(def () {
			Network.lab.reset()
		})

		@test()
		def TestUnreachableAndRefusedEndpoints() !none {
			let ln = try labListener()
			let addr = ln.address().str()
			let server = async labHold(ln)
			assert dialCode(addr) == ""
			await server onerror recover none

			Network.lab.conditions.unreachable = "*"
			assert dialCode(addr) == "EHOSTUNREACH"

			Network.lab.reset()
			Network.lab.conditions.refused = "127.0.0.1:*"
			assert dialCode(addr) == "ECONNREFUSED"
			try ln.close()
			return none
		}

		// A name is given an address of the test's choosing, or made unknown.
		@test()
		def TestHostsAndUnresolvedNames() !none {
			Network.lab.conditions.hosts = map<string, string[]>{"api.lab.test": ["127.0.0.1"]}
			let addrs = try Network.resolve("api.lab.test")
			assert addrs.len() == 1 && addrs[0] == "127.0.0.1"

			// The program dials the name and reaches the test's own server.
			let ln = try labListener()
			let server = async labEcho(ln)
			let conn = try net.dialStream("api.lab.test:{ln.address().port}", 2s)
			try conn.writeAll("ping".bytes())
			let buf byte[] = []
			buf.len(16)
			let n = try conn.read(buf, 5s)
			assert string(buf[:n]) == "ping"
			try conn.close()
			try await server
			try ln.close()

			Network.lab.conditions.unresolved = "*.lab.test"
			let code = ""
			Network.resolve("api.lab.test") onerror (err error) {
				code = err.code
				recover []
			}
			assert code == "dns"
			return none
		}

		@test()
		def TestChunkGivesShortWrites() !none {
			let ln = try labListener()
			let server = async labHold(ln)
			let conn = try net.dialStream(ln.address().str(), 2s)
			Network.lab.conditions.chunk = 4
			assert (try conn.write("0123456789".bytes(), 2s)) == 4
			Network.lab.reset()
			assert (try conn.write("456789".bytes(), 2s)) == 6
			try conn.close()
			await server onerror recover none
			try ln.close()
			return none
		}

		// The link carries a few bytes more, then every connection breaks.
		@test()
		def TestBreaksAfterSomeBytes() !none {
			let ln = try labListener()
			let server = async labHold(ln)
			let conn = try net.dialStream(ln.address().str(), 2s)
			Network.lab.conditions.breaksAfter = 5
			assert (try conn.write("hello".bytes(), 2s)) == 5
			let code = ""
			conn.write("!".bytes(), 2s) onerror (err error) {
				code = err.code
				recover 0
			}
			assert code == "ECONNRESET"
			Network.lab.reset()
			try conn.close()
			await server onerror recover none
			try ln.close()
			return none
		}

		// A silent peer: the bytes are there, the read does not get them.
		@test()
		def TestSilentPeerTimesReadsOut() !none {
			let ln = try labListener()
			let server = async labEcho(ln)
			let conn = try net.dialStream(ln.address().str(), 2s)
			try conn.writeAll("ping".bytes())
			try await server

			Network.lab.conditions.silent = true
			let buf byte[] = []
			buf.len(16)
			let started = time.now()
			let code = ""
			conn.read(buf, 60ms) onerror (err error) {
				code = err.code
				recover 0
			}
			assert code == "ETIMEDOUT"
			assert time.since(started) >= 60ms

			Network.lab.reset()
			let n = try conn.read(buf, 2s)
			assert string(buf[:n]) == "ping"
			try conn.close()
			try ln.close()
			return none
		}

		@test()
		def TestBytesPerSecondPacesWrites() !none {
			let ln = try labListener()
			let server = async labHold(ln)
			let conn = try net.dialStream(ln.address().str(), 2s)
			Network.lab.conditions.bytesPerSecond = 1000
			let data byte[] = []
			data.len(50)
			let started = time.now()
			try conn.write(data, 2s)
			assert time.since(started) >= 50ms
			Network.lab.reset()
			try conn.close()
			await server onerror recover none
			try ln.close()
			return none
		}

		// Lost datagrams: the sender is told they left, nothing arrives.
		@test()
		def TestDatagramLoss() !none {
			let receiver = try net.socket(net.SocketDomain.IPv4, net.SocketType.Datagram)
			try receiver.bind("127.0.0.1:0")
			let sender = try net.socket(net.SocketDomain.IPv4, net.SocketType.Datagram)
			let to = receiver.localAddr().str()
			let buf byte[] = []
			buf.len(16)

			Network.lab.conditions.datagramLoss = 1.0
			assert (try sender.writeTo("lost".bytes(), to, 1s)) == 4
			let code = ""
			receiver.readFrom(buf, 60ms) onerror (err error) {
				code = err.code
				recover (0, new net.Address())
			}
			assert code == "ETIMEDOUT"

			Network.lab.reset()
			assert (try sender.writeTo("kept".bytes(), to, 1s)) == 4
			let (n, _) = try receiver.readFrom(buf, 2s)
			assert string(buf[:n]) == "kept"
			try sender.close()
			try receiver.close()
			return none
		}
	}

	// A scratch path for a Unix socket.
	internal def socketPath(name string) string {
		return os.join(os.tempDir(), "adm-network-{name}-{time.now().unixNs()}.sock")
	}

	// The error code a call fails with, "" when it does not.
	internal def codeOf(outcome !int) string {
		return outcome.code when outcome is error
		return ""
	}

	// What the file behind a descriptor holds from its start.
	internal def contentOf(fd int) !string {
		let file = new os.File("", fd)
		try file.seek(0)
		let buf byte[] = []
		buf.len(64)
		let n = try file.read(buf)
		try file.close()
		return string(buf[:n])
	}

	// The descriptor a test passes: a memory file where the system has them
	// (Linux), a file on disk elsewhere.
	internal def passedFile(name string) !os.File {
		return try os.memoryFile() when __os__ == "linux"
		return try os.open(socketPath(name) + ".txt", "w+")
	}

	check "Network descriptors" {
		// Unix datagram sockets and memory files: Linux.
		@os("linux")
		@test()
		def TestDescriptorTravelsInADatagram() !none {
			let path = socketPath("fd-datagram")
			let receiver = try net.socket(net.SocketDomain.Unix, net.SocketType.Datagram)
			try receiver.bind(path)
			let sender = try net.socket(net.SocketDomain.Unix, net.SocketType.Datagram)

			let file = try os.memoryFile("passed")
			try file.write("through a datagram".bytes())
			try sender.sendDescriptor(file.descriptor(), path, 2s)
			// The receiver's descriptor outlives the sender's.
			try file.close()
			let got = try receiver.receiveDescriptor(2s)
			assert got >= 0
			assert (try contentOf(got)) == "through a datagram"

			try sender.close()
			try receiver.close()
			os.remove(path) onerror recover none
			return none
		}

		@test()
		def TestDescriptorTravelsOverAStream() !none {
			let path = socketPath("fd-stream")
			let listener = try Network.socketFd(net.SocketDomain.Unix, net.SocketType.Stream)
			try Network.bind(listener, path)
			try Network.listen(listener, 4)
			let near = try Network.socketFd(net.SocketDomain.Unix, net.SocketType.Stream)
			try Network.connect(near, path, 2s)
			let far = try Network.accept(listener)

			let file = try passedFile("fd-stream-file")
			try file.write("through a stream".bytes())
			try Network.sendDescriptor(near, file.descriptor())
			try Network.sendDescriptor(near, file.descriptor())
			try Network.write(near, "!".bytes(), 2s)
			let first = try Network.receiveDescriptor(far, 2s)
			let second = try Network.receiveDescriptor(far, 2s)
			assert first != second && first != file.descriptor()
			assert (try contentOf(first)) == "through a stream"
			try Network.close(second)
			// The byte that carried each descriptor is gone with it: what was written after is next.
			let buf byte[] = []
			buf.len(8)
			let n = try Network.read(far, buf, 2s)
			assert n == 1 && string(buf[:n]) == "!"

			try file.close()
			if file.path() != "" {
				os.remove(file.path()) onerror recover none
			}
			try Network.close(near)
			try Network.close(far)
			try Network.close(listener)
			os.remove(path) onerror recover none
			return none
		}

		// Unix datagram sockets, which Windows lacks.
		@os("linux", "darwin")
		@test()
		def TestMessageWithoutADescriptorIsRefused() !none {
			let path = socketPath("fd-none")
			let receiver = try Network.socketFd(net.SocketDomain.Unix, net.SocketType.Datagram)
			try Network.bind(receiver, path)
			let sender = try Network.socketFd(net.SocketDomain.Unix, net.SocketType.Datagram)

			assert codeOf(Network.receiveDescriptor(receiver, 40ms)) == "ETIMEDOUT"
			try Network.sendTo(sender, "plain".bytes(), path, 2s)
			assert codeOf(Network.receiveDescriptor(receiver, 2s)) == "ENOMSG"
			// The message is used up.
			assert codeOf(Network.receiveDescriptor(receiver, 40ms)) == "ETIMEDOUT"

			try Network.close(sender)
			try Network.close(receiver)
			os.remove(path) onerror recover none
			return none
		}

		// Windows keeps no user with a Unix socket's peer.
		@os("linux", "darwin")
		@test()
		def TestPeerUserIdOnAUnixSocket() !none {
			let path = socketPath("peer-uid")
			let listener = try Network.socketFd(net.SocketDomain.Unix, net.SocketType.Stream)
			try Network.bind(listener, path)
			try Network.listen(listener, 4)
			let near = try Network.socketFd(net.SocketDomain.Unix, net.SocketType.Stream)
			try Network.connect(near, path, 2s)
			let far = try Network.accept(listener)
			// Both ends belong to this process, so they report one user.
			let theirs = try Network.peerUserId(far)
			assert theirs >= 0
			assert (try Network.peerUserId(near)) == theirs
			assert (try new net.Connection(far).peerUserId()) == theirs
			try Network.close(near)
			try Network.close(listener)
			os.remove(path) onerror recover none

			let tcp = try Network.socketFd(net.SocketDomain.IPv4, net.SocketType.Stream)
			assert Network.peerUserId(tcp) is error
			try Network.close(tcp)
			return none
		}

		@test()
		def TestOnlyAUnixSocketCarriesADescriptor() !none {
			let sender = try net.socket(net.SocketDomain.IPv4, net.SocketType.Datagram)
			let file = try passedFile("fd-not-unix")
			assert sender.sendDescriptor(file.descriptor(), "127.0.0.1:9", 1s) is error
			assert sender.sendDescriptor(file.descriptor(), "", 1s) is error
			try file.close()
			if file.path() != "" {
				os.remove(file.path()) onerror recover none
			}
			try sender.close()
			return none
		}
	}

	// A loopback port nothing listens on: a datagram sent there is refused.
	internal def closedUDPPort() !string {
		let sock = try net.socket(net.SocketDomain.IPv4, net.SocketType.Datagram)
		try sock.bind("127.0.0.1:0")
		let addr = sock.localAddr().str()
		try sock.close()
		return addr
	}

	// What `publicAddr` failed with, "" when it answered.
	internal def publicAddrFailure() string {
		let failure = ""
		Network.publicAddr() onerror (err error) {
			failure = err.message
			recover ""
		}
		return failure
	}

	check "Network public address" {
		testing.afterEach(def () {
			Network.lab.reset()
			Network.config(NetworkConfig{}) onerror recover none
		})

		@test()
		def TestPublicAddrIsWhatTheStunServerSaw() !none {
			let server = new stun.Server("127.0.0.1:0")
			try server.start()
			try Network.config(NetworkConfig{stunServers: [server.address().str()]})
			assert (try Network.publicAddr()) == "127.0.0.1"
			try server.close()
			return none
		}

		@test()
		def TestPublicAddrAsksTheNextServer() !none {
			let server = new stun.Server("127.0.0.1:0")
			try server.start()
			let closed = try closedUDPPort()
			try Network.config(NetworkConfig{stunServers: [closed, server.address().str()]})
			assert (try Network.publicAddr()) == "127.0.0.1"
			try server.close()

			try Network.config(NetworkConfig{stunServers: [closed]})
			let failure = publicAddrFailure()
			assert failure.contains(closed)
			return none
		}

		@test()
		def TestPublicAddrNeedsAServer() !none {
			try Network.config(NetworkConfig{stunServers: []})
			let failure = publicAddrFailure()
			assert failure.contains("NetworkConfig.stunServers")
			assert Network.config(NetworkConfig{stunServers: ["stun.example.org"]}) is error
			assert Network.config(NetworkConfig{stunServers: [":3478"]}) is error
			return none
		}

		@test()
		def TestPublicAddrMeetsTheLab() !none {
			let server = new stun.Server("127.0.0.1:0")
			try server.start()
			try Network.config(NetworkConfig{stunServers: [server.address().str()]})
			Network.lab.conditions.unreachable = "*"
			let failure = publicAddrFailure()
			assert failure.contains("no route to host")
			try server.close()
			return none
		}
	}
}
