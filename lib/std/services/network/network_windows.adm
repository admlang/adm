partial module std.services.network {
	internal def systemResolverText() string {
		return __winResolverConfig()
	}

	internal def systemHostsPath() string {
		return __winHostsPath()
	}

	@c(symbol = "adm_win_resolver_config", ret = "const char*", params = [])
	internal def __winResolverConfig() string;

	@c(symbol = "adm_win_hosts_path", ret = "const char*", params = [])
	internal def __winHostsPath() string;
}
