partial module std.services {
	use (
		std.proto::(*)
		std.time
	)

	// The handle the notification server gave a shown notification.
	type NotificationId = uint32

	// How urgent a notification is. The server decides how each level shows:
	// Critical stays on screen until dismissed, Info goes away on its own.
	enum NotificationLevel {
		Info,
		Success,
		Warning,
		Error,
		Critical,
	}

	// A button the notification offers; `id` comes back in the `action` event
	// when the user presses it.
	struct NotificationActionDefinition {
		id    string
		label string
	}

	// What to show. Only the title is required.
	struct Notification {
		title    string
		body     string                         = ""
		// An icon name from the desktop theme (`dialog-information`) or an absolute image path.
		icon     string                         = ""
		level    NotificationLevel              = NotificationLevel.Info
		actions  NotificationActionDefinition[]
		// How long it stays on screen; none leaves it to the server.
		timeout  ?duration
		// A shown notification to replace, so a progress update does not stack a new one.
		replaces NotificationId                 = 0
	}

	// The user pressed a notification's action button.
	struct NotificationAction {
		notification NotificationId
		action       string
	}

	// What the notification server on this machine can do. Every flag is false
	// when there is no server.
	struct NotificationCapabilities {
		// A server answered; `show` can work.
		available   bool
		// Action buttons are shown.
		actions     bool
		// The body text is shown, not only the title.
		body        bool
		// The body may carry basic markup (`<b>`, `<i>`, `<a>`).
		markup      bool
		// Icons and image paths are shown.
		images      bool
		// A sound can accompany the notification.
		sound       bool
		// Notifications stay until dismissed.
		persistence bool
	}

	// Desktop notifications through the platform's notification server.
	//
	// On Linux this is the freedesktop `org.freedesktop.Notifications` service on
	// the D-Bus session bus, spoken directly over the bus socket (the `@os("linux")`
	// members). Other platforms have no server yet: `capabilities()` reports nothing
	// available and `show` fails.
	//
	// The connection opens on the first `show` and a listener task then delivers
	// the server's button presses and closes as `action` and `closed` events.
	service Notifications {
		description  = "Desktop notifications through the platform's notification server"
		dependencies = Dependencies{
			hard: [Policy, Application]
		}
		lifecycle    = Lifecycle{
			start: StartMode.Manual,
			restart: RestartMode.Always,
		}
		permissions  = [
			Permission{name: "show", description: "Show desktop notifications"},
		]

		caps NotificationCapabilities

		// Starts the service. The bus connection opens on the first `show`, so this does not fail.
		async def start() !none {
			status = ServiceStatus.Started
			return none
		}

		// Closes the connection to the notification server; shown notifications stay on screen. Does not fail today.
		async def stop() !none {
			status = ServiceStatus.Stopped
			disconnect()
			return none
		}

		// Stops the service and starts it again. Does not fail today.
		async def restart() !none {
			status = ServiceStatus.Restarting
			try await stop()
			try await start()
			return none
		}

		// Shows a notification and returns the id the server gave it.
		//
		// Fails when the policy denies it, there is no notification server, or the server refuses it.
		@commit(policy = "show")
		def show(notification Notification) !NotificationId {
			try ensureConnected()
			return try serverShow(notification)
		}

		// Shows a notification with a title and an optional body and returns its id.
		//
		// Fails when the policy denies it, there is no notification server, or the server refuses it.
		@commit(policy = "show")
		def show(title string, body string = "") !NotificationId {
			return try show(Notification{title: title, body: body})
		}

		// Takes a shown notification off the screen.
		//
		// Fails when there is no connection or the server does not know the id.
		@commit()
		def close(id NotificationId) !none {
			try ensureConnected()
			try serverClose(id)
			return none
		}

		// Shows a notification whose buttons are a question and waits for the
		// answer: the pressed action's id, or "" when the user dismissed it or
		// nobody answered within `wait` (the notification is then closed).
		//
		// Fails when there is no notification server or it refuses the notification.
		@commit()
		def ask(notification Notification, wait duration = 60s) !string {
			try ensureConnected()
			return try serverAsk(notification, wait)
		}

		// Reports what the notification server can do; nothing is available when there is none.
		@query()
		def capabilities() NotificationCapabilities {
			let ok = true
			ensureConnected() onerror (err error) {
				ok = false
				recover none
			}
			return NotificationCapabilities{} unless ok
			return caps
		}

		// The ids of the notifications shown by this program that the server has not closed yet.
		@query()
		def shown() NotificationId[] {
			return serverShown()
		}

		// Emitted when the user presses one of a notification's buttons.
		@emit()
		def action(event NotificationAction) NotificationAction {
			return event
		}

		// Emitted when a notification leaves the screen: dismissed, expired or closed.
		@emit()
		def closed(id NotificationId) NotificationId {
			return id
		}

		// --- platforms without a notification server ------------------------------

		@os("darwin")
		@os("windows")
		def ensureConnected() !none {
			fail "notifications: no notification server on this platform yet"
		}

		@os("darwin")
		@os("windows")
		def disconnect() {}

		// Shows a notification on this platform's server; there is none yet, so this fails.
		@os("darwin")
		@os("windows")
		def serverShow(notification Notification) !NotificationId {
			fail "notifications: no notification server on this platform yet"
		}

		// Closes a notification on this platform's server; there is none yet, so this fails.
		@os("darwin")
		@os("windows")
		def serverClose(id NotificationId) !none {
			fail "notifications: no notification server on this platform yet"
		}

		// The notifications still shown on this platform's server: none without a server.
		@os("darwin")
		@os("windows")
		def serverShown() NotificationId[] {
			return []
		}

		// Asks through this platform's server; there is none yet, so this fails.
		@os("darwin")
		@os("windows")
		def serverAsk(notification Notification, wait duration) !string {
			fail "notifications: no notification server on this platform yet"
		}

		// --- Linux: the freedesktop server on the D-Bus session bus ---------------

		@os("linux")
		const NOTIFICATIONS_NAME = "org.freedesktop.Notifications"
		@os("linux")
		const NOTIFICATIONS_PATH = "/org/freedesktop/Notifications"
		@os("linux")
		const NOTIFICATIONS_INTERFACE = "org.freedesktop.Notifications"

		// The open bus connection and what it showed; none until the first `show`.
		@os("linux")
		session ?NotificationSession = none

		// Opens the session bus connection the first time it is needed, then
		// starts the listener task.
		//
		// Fails when there is no session bus or no notification server answers on it.
		@os("linux")
		atomic def ensureConnected() !none {
			return none unless session is none
			let address = try dbusSessionBusAddress()
			let connection = try dbusConnect(address)
			connection.subscribe(NOTIFICATIONS_INTERFACE, "ActionInvoked") onerror (err error) {
				connection.close()
				fail err
			}
			connection.subscribe(NOTIFICATIONS_INTERFACE, "NotificationClosed") onerror (err error) {
				connection.close()
				fail err
			}
			let capsReply = connection.callSync(NOTIFICATIONS_NAME, NOTIFICATIONS_PATH, NOTIFICATIONS_INTERFACE, "GetCapabilities", "", []) onerror (err error) {
				connection.close()
				fail err
			}
			if capsReply.kind == DBUS_ERROR {
				connection.close()
				fail "notifications: no notification server on the session bus: {dbusErrorMessage(capsReply)}"
			}
			caps = notificationCapabilities(capsReply.body)
			let tracked = new NotificationTracker()
			session = new NotificationSession(connection, tracked)
			async listen(connection, tracked)
			return none
		}

		// Tells the listener to stop and closes the socket; it wakes on the
		// closed descriptor.
		@os("linux")
		atomic def disconnect() {
			let current = session
			return when current is none
			session = none
			let open NotificationSession = current
			open.bus.close()
		}

		// Sends Notify to the server and remembers the id it returns.
		//
		// Fails when the connection dropped or the server refuses the notification.
		@os("linux")
		def serverShow(notification Notification) !NotificationId {
			let connection = try connected()
			let body = notificationBody(Application.name(), notification)
			let reply = try connection.call(NOTIFICATIONS_NAME, NOTIFICATIONS_PATH, NOTIFICATIONS_INTERFACE, "Notify", "susssasa\{sv}i", body)
			fail "notifications: {dbusErrorMessage(reply)}" when reply.kind == DBUS_ERROR
			fail "notifications: the server returned no id" when reply.body.len() < 4
			let id = dbusReadUint32(reply.body, 0)
			let tracked = try tracked()
			tracked.markShown(id)
			return NotificationId(id)
		}

		// Sends CloseNotification for the id.
		//
		// Fails when the connection dropped or the server does not know the id.
		@os("linux")
		def serverClose(id NotificationId) !none {
			let connection = try connected()
			let w = new DBusWriter()
			w.putUint32(uint32(id))
			let reply = try connection.call(NOTIFICATIONS_NAME, NOTIFICATIONS_PATH, NOTIFICATIONS_INTERFACE, "CloseNotification", "u", w.bytes())
			fail "notifications: {dbusErrorMessage(reply)}" when reply.kind == DBUS_ERROR
			return none
		}

		// Shows the question and waits for ActionInvoked or NotificationClosed
		// on its id; an unanswered question is closed when the wait ends.
		//
		// Fails when the connection dropped or the server refuses the notification.
		@os("linux")
		def serverAsk(notification Notification, wait duration) !string {
			let tracked = try tracked()
			let id = uint32(try serverShow(notification))
			tracked.expectAnswer(id)
			let answer = tracked.awaitAnswer(id, wait)
			if answer is none {
				serverClose(NotificationId(id)) onerror recover none
				return ""
			}
			let pressed string = answer
			return pressed
		}

		// The ids this connection showed that the server has not closed yet.
		@os("linux")
		def serverShown() NotificationId[] {
			let out NotificationId[]
			let current = session
			return out when current is none
			let open NotificationSession = current
			for let id in open.tracker.shownIds() {
				out.push(NotificationId(id))
			}
			return out
		}

		// The open connection, for a call that already ran ensureConnected.
		//
		// Fails when the connection dropped in between.
		@os("linux")
		def connected() !DBusConnection {
			let current = session
			fail "notifications: the session bus connection closed" when current is none
			let open NotificationSession = current
			return open.bus
		}

		// The tracker, for a call that already ran ensureConnected.
		//
		// Fails when the connection dropped in between.
		@os("linux")
		def tracked() !NotificationTracker {
			let current = session
			fail "notifications: the session bus connection closed" when current is none
			let open NotificationSession = current
			return open.tracker
		}

		// Reads bus messages until the socket closes, answering waiting calls
		// and turning signals into events. Runs as its own task; it only
		// touches the connection's own state, never the service's, so a
		// `@commit` in flight cannot block it.
		@os("linux")
		def listen(connection DBusConnection, tracked NotificationTracker) {
			for {
				let message = connection.readMessage(30s) onerror (err error) {
					recover dbusReadFailure(err.code)
				}
				if message.kind == 0 {
					continue when message.errorName == "ETIMEDOUT" && !connection.stopping
					connection.lost()
					return
				}
				dispatch(connection, tracked, message)
			}
		}

		// Hands a reply to the call waiting for it and raises the events a
		// signal carries.
		@os("linux")
		def dispatch(connection DBusConnection, tracked NotificationTracker, message DBusMessage) {
			if message.kind == DBUS_REPLY || message.kind == DBUS_ERROR {
				connection.deliver(message.replySerial, message)
				return
			}
			return unless message.kind == DBUS_SIGNAL
			// Both signals are broadcast for every program's notifications; only ours become events.
			if message.member == "ActionInvoked" && message.body.len() >= 8 {
				let id = dbusReadUint32(message.body, 0)
				return unless tracked.isShown(id)
				let key = dbusReadString(message.body, 4)
				tracked.answer(id, key)
				let _ = action(NotificationAction{notification: NotificationId(id), action: key})
				return
			}
			if message.member == "NotificationClosed" && message.body.len() >= 4 {
				let id = dbusReadUint32(message.body, 0)
				return unless tracked.forget(id)
				tracked.answer(id, "")
				let _ = closed(NotificationId(id))
			}
		}
	}

	// One open connection to the notification server and its bookkeeping.
	@os("linux")
	internal type NotificationSession {
		bus     DBusConnection
		tracker NotificationTracker

		def new(bus DBusConnection, tracker NotificationTracker) {
			self.bus = bus
			self.tracker = tracker
		}
	}

	// The notifications a connection showed and the questions waiting for a
	// button press. Guarded by its own lock: the listener task writes here while
	// a `@commit` may hold the service's lock.
	@os("linux")
	internal type NotificationTracker {
		internal shown    map<uint32, bool>
		internal asked    map<uint32, bool>
		internal answered map<uint32, string>
		internal interval duration            = 5ms

		def new() {
			shown = map<uint32, bool>{}
			asked = map<uint32, bool>{}
			answered = map<uint32, string>{}
		}

		atomic def markShown(id uint32) {
			shown[id] = true
		}

		atomic def isShown(id uint32) bool {
			return shown.hasKey(id)
		}

		// Drops the id and reports whether it was one of ours; a server may
		// announce one close twice.
		atomic def forget(id uint32) bool {
			return false unless shown.hasKey(id)
			shown.delete(id)
			return true
		}

		atomic def shownIds() uint32[] {
			let out uint32[]
			for let (id, _) in shown {
				out.push(id)
			}
			return out
		}

		// Marks the notification as a question whose first press or close is its answer.
		atomic def expectAnswer(id uint32) {
			asked[id] = true
		}

		// Records the answer to a question still waiting; other notifications are ignored.
		atomic def answer(id uint32, key string) {
			return unless asked.hasKey(id)
			asked.delete(id)
			answered[id] = key
		}

		// The answer to the question, or none when nobody answered within the wait.
		def awaitAnswer(id uint32, wait duration) ?string {
			let waited = 0ms
			for {
				let answer = takeAnswer(id)
				return answer unless answer is none
				if waited >= wait {
					dropQuestion(id)
					return none
				}
				time.sleep(interval)
				waited += interval
			}
			return none
		}

		atomic def takeAnswer(id uint32) ?string {
			return none unless answered.hasKey(id)
			let key = answered[id]
			answered.delete(id)
			return key
		}

		atomic def dropQuestion(id uint32) {
			asked.delete(id)
		}
	}

	// The Notify arguments: app name, replaced id, icon, title, body, actions, hints, timeout.
	@os("linux")
	internal def notificationBody(app string, notification Notification) byte[] {
		let w = new DBusWriter()
		w.putString(app)
		w.putUint32(uint32(notification.replaces))
		w.putString(notification.icon)
		w.putString(notification.title)
		w.putString(notification.body)
		let actions string[]
		for let definition in notification.actions {
			actions.push(definition.id)
			actions.push(definition.label)
		}
		w.putStringArray(actions)
		w.beginDict()
		w.dictByte("urgency", notificationUrgency(notification.level))
		w.dictString("image-path", notification.icon) when notification.icon.startsWith("/")
		w.endDict()
		let timeout = -1
		let wanted = notification.timeout
		if !(wanted is none) {
			let d duration = wanted
			timeout = int(d) / 1000000
		}
		w.putInt32(int32(timeout))
		return w.bytes()
	}

	// The freedesktop urgency hint: 0 low, 1 normal, 2 critical.
	@os("linux")
	internal def notificationUrgency(level NotificationLevel) byte {
		return byte(2) when level == NotificationLevel.Critical || level == NotificationLevel.Error
		return byte(0) when level == NotificationLevel.Info
		return byte(1)
	}

	// Maps the server's capability strings onto the flags.
	@os("linux")
	internal def notificationCapabilities(body byte[]) NotificationCapabilities {
		let out = NotificationCapabilities{available: true}
		return out when body.len() < 4
		let end = 4 + int(dbusReadUint32(body, 0))
		let offset = 4
		for offset + 4 <= end && offset + 4 <= body.len() {
			let name = dbusReadString(body, offset)
			offset = dbusAlign(offset + 4 + name.bytes().len() + 1, 4)
			out.actions = true when name == "actions"
			out.body = true when name == "body"
			out.markup = true when name == "body-markup"
			out.images = true when name := "body-images" || "icon-static" || "icon-multi"
			out.sound = true when name == "sound"
			out.persistence = true when name == "persistence"
		}
		return out
	}
}
