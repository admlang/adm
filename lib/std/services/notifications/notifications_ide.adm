// The Notifications service's IDE panel: what the notification server
// offers and the notifications shown, and the buttons that show one and
// close one.

partial module std.services.notifications {
	use std.ide::(ide, IdeKind, IdeTable)

	partial service Notifications {
		@ide(kind = IdeKind.Table, label = "Server", refresh = 10s, rows = 4)
		def ideCapabilities() IdeTable {
			let caps = capabilities()
			return IdeTable{columns: ["Offers", ""], rows: [["Answers", "{caps.available}"], ["Action buttons", "{caps.actions}"], ["Body text", "{caps.body}"]]}
		}

		@ide(kind = IdeKind.Table, label = "Shown", refresh = 1s, rows = 6)
		def ideShown() IdeTable {
			let rows = string[][]
			for let (_, id) in shown() {
				rows.push(["{id}"])
			}
			return IdeTable{columns: ["Notification"], rows: rows}
		}

		@ide(kind = IdeKind.Action, label = "Show")
		def ideShow(title string, body string = "") !string {
			let id = try show(title, body)
			return "shown as {id}"
		}

		@ide(kind = IdeKind.Action, label = "Close", row = "ideShown.Notification")
		def ideClose(id uint32) !none {
			return close(id)
		}
	}
}
