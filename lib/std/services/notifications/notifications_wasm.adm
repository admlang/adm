@os("wasm")
partial module std.services.notifications {
	use (
		std.data.encoding::(JSON)
		std.services.browser::(browserFailure)
	)

	// A click on a notification of this page, or its close.
	internal struct WebNotificationEvent {
		id      uint32
		clicked bool
	}

	internal struct WebNotificationEvents {
		value WebNotificationEvent[] = []
	}

	// What `notifyShow` takes: the page's id of the notification it replaces
	// (0: a new one), and how long it stays (0: until the browser takes it away).
	internal struct WebNotificationArgs {
		replaces  uint32
		title     string
		body      string
		icon      string
		timeoutMs int
		sticky    bool
	}

	internal struct WebNotificationId {
		id uint32
	}

	// Asks the user to allow this page's notifications, once.
	//
	// Fails when the browser has no notifications or the user refuses them.
	internal def webNotificationsAllowed() !none {
		let _ = try webCall("notifyPermission", "\{}")
		return none
	}

	// Shows the notification and returns the id the page gave it.
	//
	// Fails when the browser refuses it.
	internal def webShow(notification Notification) !uint32 {
		let args = WebNotificationArgs{
			replaces: uint32(notification.replaces),
			title:    notification.title,
			body:     notification.body,
			icon:     notification.icon,
			sticky:   notification.level == NotificationLevel.Critical,
		}
		let timeout = notification.timeout
		args.timeoutMs = int(float(timeout) / float(1ms)) unless timeout is none
		let shown = WebNotificationId{}
		try new JSON().decode(try webCall("notifyShow", string(new JSON().encode(args))), shown)
		return shown.id
	}

	// Closes the notification; one the page does not know is no failure.
	//
	// Fails when the browser refuses.
	internal def webClose(id uint32) !none {
		let _ = try webCall("notifyClose", string(new JSON().encode(WebNotificationId{id: id})))
		return none
	}

	// Waits for the next clicks and closes.
	//
	// Fails when the page does not answer.
	internal def webEvents() !WebNotificationEvent[] {
		let happened = WebNotificationEvents{}
		try new JSON().decode(try webCall("notifyEvents", "\{}"), happened)
		return happened.value
	}

	internal def webCall(op string, args string) !string {
		let status = __webBrowser(op, args)
		fail browserFailure("notifications {op}", int(status)) unless status == 0
		return __webAnswer()
	}

	@c("adm_web.h", symbol = "adm_web_browser", ret = "int32_t", params = ["const char*", "const char*"])
	def __webBrowser(op string, args string) int32;

	@c("adm_web.h", symbol = "adm_web_answer", ret = "const char*", params = [])
	def __webAnswer() string;
}
