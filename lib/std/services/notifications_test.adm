partial module std.services {
	use (
		std.proto::(*)
		std.testing
	)

	@os("linux")
	check "Notifications" {
		@test()
		def TestNotifyBodyCarriesTheFields() {
			let body = notificationBody("suite", Notification{
				title: "Build finished",
				body: "3 warnings",
				icon: "dialog-information",
				level: NotificationLevel.Critical,
				actions: [NotificationActionDefinition{id: "open", label: "Open log"}],
				timeout: 2s,
				replaces: 5,
			})
			let offset = 0
			let app = dbusReadString(body, offset)
			assert app == "suite"
			offset = dbusAlign(offset + 4 + app.bytes().len() + 1, 4)
			assert dbusReadUint32(body, offset) == uint32(5)
			offset += 4
			assert dbusReadString(body, offset) == "dialog-information"
			offset = dbusAlign(offset + 4 + "dialog-information".len() + 1, 4)
			assert dbusReadString(body, offset) == "Build finished"
			offset = dbusAlign(offset + 4 + "Build finished".len() + 1, 4)
			assert dbusReadString(body, offset) == "3 warnings"
			offset = dbusAlign(offset + 4 + "3 warnings".len() + 1, 4)
			let actionsLen = int(dbusReadUint32(body, offset))
			offset += 4
			assert dbusReadString(body, offset) == "open"
			offset = dbusAlign(offset + 4 + 4 + 1, 4)
			assert dbusReadString(body, offset) == "Open log"
			offset += actionsLen - 9
			// the last four bytes are the timeout in milliseconds
			assert dbusReadUint32(body, body.len() - 4) == uint32(2000)
		}

		@test()
		def TestNotifyBodyDefaultsTimeout() {
			let body = notificationBody("suite", Notification{title: "x"})
			assert dbusReadUint32(body, body.len() - 4) == uint32(0xFFFFFFFF)
		}

		@test()
		def TestUrgencyFollowsLevel() {
			assert notificationUrgency(NotificationLevel.Info) == byte(0)
			assert notificationUrgency(NotificationLevel.Success) == byte(1)
			assert notificationUrgency(NotificationLevel.Warning) == byte(1)
			assert notificationUrgency(NotificationLevel.Error) == byte(2)
			assert notificationUrgency(NotificationLevel.Critical) == byte(2)
		}

		@test()
		def TestParseCapabilities() {
			let w = new DBusWriter()
			w.putStringArray(["actions", "body", "body-markup", "icon-static", "persistence"])
			let caps = notificationCapabilities(w.bytes())
			assert caps.available
			assert caps.actions
			assert caps.body
			assert caps.markup
			assert caps.images
			assert caps.persistence
			assert !caps.sound

			let noCaps = notificationCapabilities([])
			assert noCaps.available
			assert !noCaps.actions
		}

		// Asks a question nobody answers: the answer is empty after the wait
		// and the notification is taken down again.
		@test()
		def TestAskUnansweredIsEmpty() !none {
			let caps = Notifications.capabilities()
			return none unless caps.available
			let answer = try Notifications.ask(Notification{
				title: "ADM",
				body: "notifications suite question",
				actions: [NotificationActionDefinition{id: "yes", label: "Yes"}],
			}, 300ms)
			assert answer == ""
			assert Notifications.shown().len() == 0
			return none
		}

		// Shows and closes one notification when this machine has a server; a
		// machine without one only checks that capabilities say so.
		@test()
		def TestShowWhenAServerAnswers() !none {
			let caps = Notifications.capabilities()
			return none unless caps.available
			let id = try Notifications.show("ADM", "notifications suite")
			assert uint32(id) > 0
			assert Notifications.shown().len() == 1
			try Notifications.close(id)
			try await Notifications.stop()
			return none
		}
	}
}
