partial module std.services {
	use (
		std.data.encoding::(TOML, TOMLTable, TOMLArray)
		std.reflection
		std.errors
		std.time
		std.crypto.hash::(SHA256)
	)

	// The error a gated call fails with when the caller's package does not hold
	// the permission, or a constrained argument falls outside its grant.
	// `field` names the spec field that denied; the value never appears.
	struct PolicyDenied {
		message    string
		code       string            = "policy.denied"
		cause      ?error
		stack      errors.StackTrace
		permission string
		field      ?string
	}

	// The rule for `adm.storage.*` permissions: which paths a package may
	// name. `open` and `list` both check `path`.
	type PathSpec {
		path Rule<string>

		// Checks a path against the rule.
		//
		// Fails with PolicyDenied when the rule denies it; an `ask` outcome fails with the
		// code `policy.ask` so the runtime can prompt.
		def validate(value string) !none {
			let decision = path.decide(value)
			fail PolicyDenied{message: "path denied by policy: {value}", permission: "", field: "path"} when decision == Decision.Deny
			fail PolicyDenied{message: "path asks: {value}", code: "policy.ask", permission: "", field: "path"} when decision == Decision.Ask
			return none
		}
	}

	// The rule for `adm.network.*` permissions over an endpoint written as
	// `protocol://host[:port]`. Country matching has no data source yet and
	// is not applied.
	type EndpointSpec {
		protocol       Rule<string>
		host           Rule<string>
		country        Rule<string>
		maxConnections int          = 0

		// Splits the endpoint into protocol and host and checks each against its rule.
		//
		// Fails with PolicyDenied when either rule denies.
		def validate(value string) !none {
			let protocolText = ""
			let hostText = value
			let separator = value.indexOf("://")
			if separator >= 0 {
				protocolText = value[0:separator]
				hostText = value[separator + 3:]
			}
			let slash = hostText.indexOf("/")
			if slash >= 0 {
				hostText = hostText[0:slash]
			}
			let colon = hostText.indexOf(":")
			if colon >= 0 {
				hostText = hostText[0:colon]
			}
			let protocolDecision = protocol.decide(protocolText)
			fail PolicyDenied{message: "protocol denied by policy: {protocolText}", permission: "", field: "protocol"} when protocolDecision == Decision.Deny
			fail PolicyDenied{message: "protocol asks: {protocolText}", code: "policy.ask", permission: "", field: "protocol"} when protocolDecision == Decision.Ask
			let hostDecision = host.decide(hostText)
			fail PolicyDenied{message: "host denied by policy: {hostText}", permission: "", field: "host"} when hostDecision == Decision.Deny
			fail PolicyDenied{message: "host asks: {hostText}", code: "policy.ask", permission: "", field: "host"} when hostDecision == Decision.Ask
			return none
		}
	}

	// A path argument of a gated function, checked against the caller's
	// `PathSpec` before the body runs. Callers pass a plain string.
	type Path = Constrain<string, PathSpec>

	// An endpoint argument of a gated function, checked against the caller's
	// `EndpointSpec` before the body runs. Callers pass a plain string.
	type Endpoint = Constrain<string, EndpointSpec>

	// An action a package wants to perform, with the field values the rules constrain.
	struct PolicyRequest {
		action string
		fields map<string, any>
	}

	// One rule from a policy layer: the owner and action it covers, the field values it
	// matches, and whether it allows or denies.
	struct PolicyRule {
		owner  string
		action string
		fields map<string, any>
		allow  bool
	}

	// The outcome of evaluate: whether the request is allowed, the rule and reason behind
	// it, and the merged constraints per field.
	struct PolicyDecision {
		allowed     bool
		rule        ?PolicyRule
		reason      ?string
		constraints map<string, any>
	}

	// What a validator answers: allowed or not, why, and the constraints it applied.
	struct PolicyValidation {
		allowed     bool
		reason      ?string
		constraints map<string, any>
	}

	// Checks one field value of a request against a rule.
	type PolicyValidator = def (value any, request PolicyRequest, rule PolicyRule) !PolicyValidation

	// An owner's action and the validators for its fields, as Policy.register takes it.
	struct PolicyRegistration {
		owner      string
		action     string
		validators map<string, PolicyValidator>
	}

	// How a prompt was answered: allow or deny, once or for the rest of the run.
	enum PolicyResolution {
		AllowOnce,
		DenyOnce,
		AllowAlways,
		DenyAlways,
	}

	// What a resolver sees when an `ask` rule matches: the request, the rule and the value
	// that matched.
	struct PolicyPrompt {
		request PolicyRequest
		rule    ?PolicyRule
		// The constrained argument the `ask` rule matched.
		value   string
	}

	// Answers an `ask` rule. Runs on the asking task and may block it; a
	// UI resolver waits for the user there.
	type PolicyResolver = def (prompt PolicyPrompt) !PolicyResolution

	// A validator for one spec type: builds the spec from the merged rules
	// of its fields and checks one argument, keyed by the spec type's
	// qualified name. std registers its own at start; a library service
	// declaring permissions registers the spec types it names with
	// `Policy.registerSpec`.
	type PolicySpecFactory = def (fields map<string, Rule<string>>, value string) !none

	// One line of the decision log.
	struct PolicyLogEntry {
		time       string
		outcome    string
		permission string
		subject    string
		// The spec field that decided, "" when none did.
		field      string
		reason     string
	}

	// The std spec validators: build the spec from the merged rules and
	// check one argument.
	internal def buildPathSpec(fields map<string, Rule<string>>, value string) !none {
		let spec = PathSpec{}
		let path = fields.get("path")
		spec.path = path unless path is none
		// A `package://` path is checked as the file it stands for.
		let resolved = Application.filePath(value) onerror recover value
		return spec.validate(resolved)
	}

	internal def buildEndpointSpec(fields map<string, Rule<string>>, value string) !none {
		let spec = EndpointSpec{}
		let protocol = fields.get("protocol")
		spec.protocol = protocol unless protocol is none
		let host = fields.get("host")
		spec.host = host unless host is none
		let country = fields.get("country")
		spec.country = country unless country is none
		return spec.validate(value)
	}

	// Decides what the program may do.
	//
	// Three layers merge per permission and field: the grants compiled into the binary,
	// the application's `policy.toml`, and answers given at run time to `ask` rules.
	// Services declare the permissions their methods need; the runtime asks here before
	// running them.
	service Policy {
		/*
		The only thing that decides. Three layers, merged per (subject,
		permission, field):
		
		  0. fixed: the policy state is denied to every subject
		  1. compiled grants (`__policy_grants__`): what each package holds
		  2. the policy file `<app home>/policy.toml`, by program (`*`) or
		     by package; it narrows, never widens
		  3. live answers from the registered resolver; `Always` answers are
		     appended to the file
		
		`allow` and `ask` lists replace across layers, `deny` lists union,
		so deny only ever grows.
		*/

		description  = ""
		dependencies = Dependencies{
			hard: [Runtime, Application]
		}
		lifecycle    = Lifecycle{
			start: StartMode.Automatic,
			restart: RestartMode.Always,
		}

		atomic registrations                = map<string, PolicyRegistration>{}
		// The resolver answering `ask` rules; `hasResolver` says one was
		// registered (without one an `ask` denies).
		resolver             PolicyResolver
		hasResolver                         = false
		permissions          Permission[]
		// The compiled grant table (`__policy_grants__`), by package; loaded
		// on first use. The application's entry is what its own code
		// reaches, a dependency's what the developer accepted at install.
		grants                              = map<string, string[]>{}
		grantsLoaded                        = false
		// The catalog (`__policy_catalog__`): description and rule fields by
		// permission.
		descriptions                        = map<string, string>{}
		fields                              = map<string, string[]>{}
		// The policy file's rules, keyed `<subject>|<permission>|<field>`,
		// and its scalar settings keyed `<subject>|<permission>|<key>`.
		rules                               = map<string, Rule<string>>{}
		settings                            = map<string, string>{}
		// Tables of policy.toml naming a permission this build does not know,
		// collected while parsing and noted once the parse is done.
		ignored              string[]
		// Spec validators registered by libraries, by spec type name; the
		// std specs dispatch directly.
		specs                               = map<string, PolicySpecFactory>{}
		policyDir                           = ""
		policyFile                          = ""
		policyLog                           = ""
		fileLoaded                          = false
		loadError                           = ""

		// Applies the service's settings. There are none yet, and it does not fail.
		def config<T>(val T) !none {}

		// Loads the policy file and the compiled grants. Does not fail today: a policy file
		// that does not parse is reported on the first decision instead.
		async def start() !none {
			ensureLoaded()
			return none
		}

		// Stops the service. Does not fail today.
		async def stop() !none {
			return none
		}

		// Stops the service and starts it again. Does not fail today.
		async def restart() !none {
			fileLoaded = false
			ensureLoaded()
			return none
		}

		// Registers the spec type a permission names, so the file's rules for
		// it can be checked against arguments.
		//
		// Does not fail today; the error return is kept for the implementation.
		@commit()
		def registerSpec(name string, factory PolicySpecFactory) !none {
			specs[name] = factory
			return none
		}

		// Registers the resolver that answers `ask` rules. Without one an
		// `ask` denies.
		//
		// Does not fail today; the error return is kept for the implementation.
		@commit()
		def registerResolver(handler PolicyResolver) !none {
			resolver = handler
			hasResolver = true
			return none
		}

		// Loads rules from policy-file text instead of the file, replacing
		// what was loaded. Fails on an unknown field or kind, or a malformed
		// line, naming the line; a table for a permission this build does not
		// know is skipped and noted in the policy log.
		@commit()
		def configure(text string) !none {
			ensureLoaded()
			try parseRules(text)
			return none
		}

		// Fails unless every package on the call chain holds each permission.
		@query()
		def requirePermissions(permissions string[]) !none {
			for let permission in permissions {
				try require(PolicyRequest{action: permission})
			}
			return none
		}

		// Drops permissions from the application's own grants for the rest of
		// the run.
		//
		// Does not fail today; the error return is kept for the implementation.
		@commit()
		def revokePermissions(permissions string[]) !none {
			ensureLoaded()
			let granted = grants.get(__app_name__)
			return none when granted is none
			let kept string[]
			for let name in granted {
				let revoked = false
				for let permission in permissions {
					revoked = true when name == permission || name.startsWith(permission + ".")
				}
				kept.push(name) unless revoked
			}
			grants[__app_name__] = kept
			return none
		}

		// Whether every package on the call chain holds each permission.
		@query()
		def hasPermissions(permissions string[]) bool {
			for let permission in permissions {
				return false unless holdsAlong(permission) is none
			}
			return true
		}

		// Registers an owner's rules and validators for one action.
		//
		// Does not fail today; the error return is kept for the implementation.
		@commit()
		def register(registration PolicyRegistration) !none {
			registrations[registration.owner + "." + registration.action] = registration
			return none
		}

		// Decides a request and reports why: which package lacks the
		// permission, or the merged rules that apply.
		//
		// Does not fail today: a lacking permission is a denied decision, not an error.
		@query()
		def evaluate(request PolicyRequest) !PolicyDecision {
			ensureLoaded()
			let permission = request.action
			let lacking = holdsAlong(permission)
			if !(lacking is none) {
				return PolicyDecision{
					allowed: false,
					reason:  "{permission}: {lacking} does not hold it (compiled grants)",
				}
			}
			let constraints = map<string, any>{}
			let whole = mergedRule(permission, "*")
			if whole.allow.len() + whole.deny.len() + whole.ask.len() > 0 {
				constraints["*.allow"] = whole.allow
				constraints["*.deny"] = whole.deny
				constraints["*.ask"] = whole.ask
			}
			let names = fields.get(permission)
			if !(names is none) {
				for let field in names {
					let merged = mergedRule(permission, field)
					constraints[field + ".allow"] = merged.allow
					constraints[field + ".deny"] = merged.deny
					constraints[field + ".ask"] = merged.ask
				}
			}
			if whole.deny.includes("*") {
				return PolicyDecision{
					allowed:     false,
					reason:      "{permission}: denied as a whole by rule",
					constraints: constraints,
				}
			}
			return PolicyDecision{
				allowed:     true,
				reason:      "{permission}: held by every package on the chain",
				constraints: constraints,
			}
		}

		// Explains a request: the decision, the rule and layer behind it.
		//
		// Does not fail today: a lacking permission is a denied decision, not an error.
		@query()
		def explain(request PolicyRequest) !PolicyDecision {
			return evaluate(request)
		}

		// Evaluates the specified policy request against the compiled grant
		// table for every package on the current call chain, the application
		// first.
		//
		// Returns successfully when allowed. When denied, fails with a
		// `PolicyDenied` naming the permission and the package lacking it.
		@query()
		def require(request PolicyRequest) !none {
			ensureLoaded()
			fail PolicyDenied{message: loadError, permission: request.action} when loadError.len() > 0
			let permission = request.action
			let lacking = holdsAlong(permission)
			if !(lacking is none) {
				let package string = lacking
				note("deny", permission, package, "", "does not hold it")
				fail denied(permission, package)
			}
			return requireWhole(permission)
		}

		// The `*` rule of a permission, the one that names it as a whole and
		// is the only rule a permission without fields can have: deny wins,
		// then allow, then ask goes to the resolver. Field rules follow in
		// `validate`.
		//
		// Fails with PolicyDenied when the rule denies the permission or an ask is refused.
		def requireWhole(permission string) !none {
			let whole = mergedRule(permission, "*")
			if whole.deny.includes("*") {
				note("deny", permission, subjectLabel(), "*", "denied by rule")
				fail PolicyDenied{message: "{permission} denied", permission: permission, field: "*"}
			}
			return none when whole.allow.includes("*")
			return resolveAsk(permission, "*", "*") when whole.ask.includes("*")
			return none
		}

		// Checks one constrained argument of a gated function against the
		// merged rule for its permission: the file's rules for the program
		// and for every package on the chain, then the registered spec's
		// own check. An `ask` outcome goes to the resolver; without one it
		// denies. The policy state itself is denied to every subject.
		//
		// Fails with PolicyDenied when the policy file could not load, the value names the policy state itself, or the spec's rule denies it.
		@query()
		def validate(permission string, spec string, value string) !none {
			ensureLoaded()
			fail PolicyDenied{message: loadError, permission: permission} when loadError.len() > 0
			if permission.startsWith("adm.storage.") && isPolicyState(value) {
				note("deny", permission, subjectLabel(), "path", "the policy state is off-limits")
				fail PolicyDenied{message: "{permission} denied: the policy state is off-limits", permission: permission, field: "path"}
			}
			let registered = specs.get(spec)
			return none when registered is none && spec != "std.services.PathSpec" && spec != "std.services.EndpointSpec"
			let merged = map<string, Rule<string>>{}
			let names = fields.get(permission)
			if !(names is none) {
				for let field in names {
					merged[field] = mergedRule(permission, field)
				}
			}
			let asked = false
			let failure ?error = none
			runSpec(spec, registered, merged, value) onerror (err error) {
				if err.code == "policy.ask" {
					asked = true
				} else {
					failure = err
				}
				recover none
			}
			if !(failure is none) {
				let err error = failure
				note("deny", permission, subjectLabel(), fieldOf(err), err.message)
				fail err
			}
			return resolveAsk(permission, value) when asked
			return none
		}

		// Lists every permission the program's services declare.
		@query()
		def list() Permission[] {
			ensureLoaded()
			let out Permission[]
			for let (name, description) in descriptions {
				out.push(Permission{name: name, description: description})
			}
			return out
		}

		// Emitted for every denial, ask and live answer.
		@emit()
		def decided(entry PolicyLogEntry) PolicyLogEntry {
			return entry
		}

		// The registration for an action.
		//
		// Fails when none is registered for it.
		def resolve(action string) !PolicyRegistration {
			let registration = registrations.get(action)
			fail "no registration for {action}" when registration is none
			return registration
		}

		// Placeholder for connecting to a remote policy source. Does nothing yet.
		def connect() {}

		// --- decisions -------------------------------------------------------

		// The package on the chain lacking the permission, none when every
		// one holds it. The application is always the root of the chain.
		def holdsAlong(permission string) ?string {
			let chain = __policy_chain()
			// A chain rooted at `adm` is the runtime running a std service's
			// own hook: plumbing, not the application's request, so the
			// application is not asked. Every other package on the chain (a
			// library the hook calls back into) still is.
			let plumbing = chain.len() > 0 && chain[0] == "adm"
			return __app_name__ unless plumbing || holds(__app_name__, permission)
			for let package in chain {
				return package unless holds(package, permission)
			}
			return none
		}

		// The subjects a request is judged by, outermost first: the program
		// (`*`), the application, then each package on the chain.
		def subjects() string[] {
			let out = ["*", __app_name__]
			for let package in __policy_chain() {
				out.push(package)
			}
			return out
		}

		def subjectLabel() string {
			let chain = __policy_chain()
			return __app_name__ when chain.len() == 0
			return chain[chain.len() - 1]
		}

		// Whether a package's grants cover a permission; names form a tree,
		// so `adm.storage` covers `adm.storage.read`.
		def holds(package string, permission string) bool {
			return true when package == "adm"
			let granted = grants.get(package)
			return false when granted is none
			for let name in granted {
				return true when name == permission || permission.startsWith(name + ".")
			}
			return false
		}

		// The file's rule for a field, merged across the subjects: `allow`
		// and `ask` replace, `deny` unions.
		def mergedRule(permission string, field string) Rule<string> {
			let merged = Rule<string>{}
			for let subject in subjects() {
				let rule = rules.get(subject + "|" + permission + "|" + field)
				continue when rule is none
				merged.allow = rule.allow when rule.allow.len() > 0
				merged.ask = rule.ask when rule.ask.len() > 0
				merged.deny = merged.deny + rule.deny
			}
			return merged
		}

		def denied(permission string, package string) PolicyDenied {
			return PolicyDenied{
				message:    "{permission} denied: {package} does not hold it",
				permission: permission,
			}
		}

		def fieldOf(err error) string {
			return ""
		}

		// An `ask` outcome: the resolver decides, else a desktop notification
		// with Allow, Always allow and Deny buttons; an `Always` answer is
		// appended to the file as an `allow` or `deny` for the value.
		def resolveAsk(permission string, value string, field string = "") !none {
			let outcome = PolicyResolution.DenyOnce
			if hasResolver {
				let prompt = PolicyPrompt{request: PolicyRequest{action: permission}, value: value}
				outcome = try resolver(prompt)
			} else {
				outcome = try askByNotification(permission, value)
			}
			if field.len() == 0 {
				field = "value"
				let names = fields.get(permission)
				if !(names is none) {
					let declared string[] = names
					field = declared[0] when declared.len() > 0
				}
			}
			if outcome == PolicyResolution.AllowOnce {
				note("allow", permission, subjectLabel(), field, "allowed once: {value}")
				return none
			}
			if outcome == PolicyResolution.AllowAlways {
				try remember(permission, field, "allow", value)
				note("allow", permission, subjectLabel(), field, "allowed always: {value}")
				return none
			}
			if outcome == PolicyResolution.DenyAlways {
				try remember(permission, field, "deny", value)
			}
			note("deny", permission, subjectLabel(), field, "denied: {value}")
			fail PolicyDenied{message: "{permission} denied for {value}", permission: permission, field: field}
		}

		// Puts the question to the user as a desktop notification and waits for
		// a button: Allow, Always allow, Deny or Always deny; dismissed or unanswered is Deny.
		// `ADM_POLICY_PROMPT=0` turns the prompt off (`adm test` sets it), then
		// an `ask` without a resolver denies.
		//
		// Fails with PolicyDenied when prompts are off or no notification server can show one.
		def askByNotification(permission string, value string) !PolicyResolution {
			let prompting = __env_get("ADM_POLICY_PROMPT")
			if !(prompting is none) {
				let setting string = prompting
				if setting == "0" {
					note("deny", permission, subjectLabel(), "", "asks, no resolver is registered, and prompts are off")
					fail PolicyDenied{message: "{permission} asks for {value}, and no resolver is registered", permission: permission}
				}
			}
			let description = permission
			let known = descriptions.get(permission)
			if !(known is none) {
				let text string = known
				description = text when text.len() > 0
			}
			let answer = Notifications.ask(Notification{title: "{Application.name()} asks for permission", body: "{description}\n{permission}: {value}", icon: "dialog-question", level: NotificationLevel.Warning, actions: [NotificationActionDefinition{id:"allow", label:"Allow"}, NotificationActionDefinition{id:"always", label:"Always allow"}, NotificationActionDefinition{id:"deny", label:"Deny"},],}) onerror (err error) {
				note("deny", permission, subjectLabel(), "", "asks, no resolver is registered, and no prompt could be shown: {err.message}")
				fail PolicyDenied{message: "{permission} asks for {value}, and neither a resolver nor a notification server can answer", permission: permission}
			}
			return PolicyResolution.AllowOnce when answer == "allow"
			return PolicyResolution.AllowAlways when answer == "always"
			return PolicyResolution.DenyAlways when answer == "never"
			return PolicyResolution.DenyOnce
		}

		// Records a live `Always` answer: the value joins the asking package's
		// rule for the field in the loaded rules, and the file is written back
		// from them, so a permission has one table whatever the answer count.
		def remember(permission string, field string, kind string, value string) !none {
			let subject = subjectLabel()
			subject = "*" when subject.len() == 0
			let key = subject + "|" + permission + "|" + field
			let rule = rules.get(key)
			let current = Rule<string>{}
			current = rule unless rule is none
			if kind == "allow" {
				current.allow.push(value)
			} else {
				current.deny.push(value)
			}
			rules[key] = current
			return none when policyFile.len() == 0
			// the application's folder may not exist yet: the file is its first content
			let exists = __fs_exists(policyDir) onerror recover false
			try __fs_mkdir(policyDir) unless exists
			return writeText(policyFile, policyText(try currentText()))
		}

		// The policy file's text for the loaded rules and settings: the comment
		// preamble before the first table stays, then the TOML codec renders one
		// table per subject and permission.
		def policyText(existing string) string {
			let preamble string[]
			for let raw in existing.split("\n") {
				break when raw.trim().startsWith("[")
				preamble.push(raw)
			}
			let doc = new TOMLTable()
			for let key in sortedKeys(rules.keys()) {
				let parts = key.split("|")
				let table = doc.tableAt(tablePath(parts[0], parts[1]) + [parts[2]])
				let rule = rules[key]
				table.set("allow", stringItems(rule.allow)) when rule.allow.len() > 0
				table.set("deny", stringItems(rule.deny)) when rule.deny.len() > 0
				table.set("ask", stringItems(rule.ask)) when rule.ask.len() > 0
			}
			for let key in sortedKeys(settings.keys()) {
				let parts = key.split("|")
				setSetting(doc.tableAt(tablePath(parts[0], parts[1])), parts[2], settings[key])
			}
			let head = preamble.join("\n").trim()
			let codec = new TOML()
			codec.dottedKeys = true
			let body = string(codec.encode(doc))
			return body when head.len() == 0
			return head + "\n\n" + body
		}

		// The policy file as it would be written from the loaded rules and settings.
		@query()
		def text() string {
			let existing = currentText() onerror recover ""
			return policyText(existing)
		}

		// The policy file's text, empty when there is no file.
		//
		// Fails when the file exists but cannot be read.
		def currentText() !string {
			return "" when policyFile.len() == 0
			let exists = __fs_exists(policyFile) onerror recover false
			return "" unless exists
			let data = try __fs_read_all(policyFile)
			return string(data)
		}

		// The keys in ascending order, so the file is the same for the same rules.
		def sortedKeys(keys string[]) string[] {
			let out string[]
			for let key in keys {
				let placed = false
				let next string[]
				for let existing in out {
					if !placed && key < existing {
						next.push(key)
						placed = true
					}
					next.push(existing)
				}
				next.push(key) unless placed
				out = next
			}
			return out
		}

		// The table path for a subject and permission: the permission's segments,
		// after the package name when the subject is one.
		def tablePath(subject string, permission string) string[] {
			let path string[]
			path.push(subject) unless subject == "*"
			for let segment in permission.split(".") {
				path.push(segment)
			}
			return path
		}

		def stringItems(values string[]) TOMLArray {
			let out = new TOMLArray()
			for let value in values {
				out.push(value)
			}
			return out
		}

		// Writes a setting back with the type its text reads as: 20 stays a
		// number, true a boolean, anything else a string.
		def setSetting(table TOMLTable, name string, text string) {
			if text == "true" || text == "false" {
				let flag = text == "true"
				table.set(name, flag)
				return
			}
			let digits = text
			digits = text[1:] when text.startsWith("-")
			let numeric = digits.len() > 0
			for let c in digits {
				numeric = false unless c >= '0' && c <= '9'
			}
			if numeric {
				let n = parseInt<int>(text)
				table.set(name, n)
				return
			}
			table.set(name, text)
		}

		// --- the policy file ---------------------------------------------------

		// Runs the spec's check: std's directly, a registered one through
		// its factory.
		def runSpec(spec string, registered ?PolicySpecFactory, merged map<string, Rule<string>>, value string) !none {
			return buildPathSpec(merged, value) when spec == "std.services.PathSpec"
			return buildEndpointSpec(merged, value) when spec == "std.services.EndpointSpec"
			return none when registered is none
			let build PolicySpecFactory = registered
			return build(merged, value)
		}

		def ensureLoaded() {
			loadGrants() unless grantsLoaded
			return when fileLoaded
			fileLoaded = true
			loadError = ""
			// The folder is not created here: a program that never asked for
			// its home keeps not having one, and a missing file is simply no
			// rules. The log is written only while the folder exists.
			policyDir = Application.homePath() onerror recover ""
			return when policyDir.len() == 0
			policyFile = policyDir + "/policy.toml"
			policyLog = policyDir + "/policy.log"
			let sandbox = __sandbox_report()
			note("sandbox", "*", "*", "", sandbox) when sandbox.len() > 0
			let exists = __fs_exists(policyFile) onerror recover false
			return unless exists
			let data = __fs_read_all(policyFile) onerror (err error) {
				loadError = "policy.toml: {err.message}"
				recover []
			}
			return when loadError.len() > 0
			parseRules(string(data)) onerror (err error) {
				loadError = "policy.toml: {err.message}"
				recover none
			}
			let digest = new SHA256()
			note("load", "policy.toml", "*", "", "sha256=" + digest.hash(data).hex() + " bytes=" + data.len().str())
		}

		def loadGrants() {
			grantsLoaded = true
			for let entry in __policy_grants__.split(";") {
				continue when entry == ""
				let separator = entry.indexOf("=")
				continue when separator < 0
				let package = entry[0:separator]
				let names string[]
				for let name in entry[separator + 1:].split(",") {
					names.push(name) unless name == ""
				}
				grants[package] = names
			}
			for let entry in __policy_catalog__.split(";") {
				continue when entry == ""
				let separator = entry.indexOf("=")
				continue when separator < 0
				let name = entry[0:separator]
				let rest = entry[separator + 1:]
				let bar = rest.indexOf("|")
				let description = rest
				let names string[]
				if bar >= 0 {
					description = rest[0:bar]
					for let field in rest[bar + 1:].split(",") {
						names.push(field) unless field == ""
					}
				}
				descriptions[name] = description
				fields[name] = names
			}
		}

		// Reads policy-file text through the TOML codec: a table per
		// permission, `[permission]` for the program or `[package.permission]`
		// for one package (the package name may be quoted), `field.allow|deny|ask`
		// lists and `key = value` settings. `${app.home}` in a value is the
		// application's folder.
		//
		// Fails when the text is not TOML or names a permission, field or kind the program does not have.
		def parseRules(text string) !none {
			rules = map<string, Rule<string>>{}
			settings = map<string, string>{}
			let doc = new TOMLTable()
			(new TOML()).decode(text, doc) onerror (err error) {
				fail err.message.replace("toml: ", "")
			}
			ignored = []
			try collectRules(doc, [])
			for let name in ignored {
				note("ignore", name, "*", "", "unknown permission in policy.toml, table skipped")
			}
			ignored = []
			return none
		}

		// Walks the document's tables: a path that names a permission (after
		// an optional leading package) is a rule table; anything else nests deeper.
		//
		// Fails when a path is neither a permission nor the way to one.
		def collectRules(table TOMLTable, path string[]) !none {
			let subject = "*"
			let permission = path.join(".")
			if path.len() > 1 && !descriptions.hasKey(permission) {
				let rest = path[1:].join(".")
				if descriptions.hasKey(rest) {
					subject = path[0]
					permission = rest
				}
			}
			if descriptions.hasKey(permission) {
				try readRuleTable(table, subject, permission)
				return none
			}
			// A permission this build does not know, left behind by an older
			// build or another program: its table is skipped, noted in the log
			// once the parse is done, and the program starts.
			if unknownPermission(path) {
				ignored.push(path.join("."))
				return none
			}
			for let key in table.keys() {
				let child = table.table(key)
				if child is none {
					fail "{path.join(".")}.{key} needs a [permission] table" when path.len() > 0
					fail "{key} needs a [permission] table"
				}
				let nested TOMLTable = child
				try collectRules(nested, path + [key])
			}
			return none
		}

		// Whether a table path under a permission root (`adm`, or a package
		// name followed by one) leads to no permission this build declares:
		// neither a permission, nor a prefix of one, nor a table under one.
		def unknownPermission(path string[]) bool {
			return false when path.len() == 0
			return false when knownAround(path.join("."))
			return true when isPermissionRoot(path[0])
			return false when path.len() < 2
			return isPermissionRoot(path[1]) && !knownAround(path[1:].join("."))
		}

		// Whether the name is a declared permission, a prefix of one, or a
		// path under one.
		def knownAround(name string) bool {
			let below = name + "."
			for let known in descriptions.keys() {
				return true when known == name || known.startsWith(below) || name.startsWith(known + ".")
			}
			return false
		}

		// Whether a known permission starts with the segment (`adm` for the builtin ones).
		def isPermissionRoot(segment string) bool {
			let prefix = segment + "."
			for let name in descriptions.keys() {
				return true when name.startsWith(prefix)
			}
			return false
		}

		// A permission's table: sub-tables are fields holding `allow`, `deny`
		// and `ask` lists, scalars are settings.
		//
		// Fails when a field or kind is unknown, or a list holds something other than strings.
		def readRuleTable(table TOMLTable, subject string, permission string) !none {
			let declared string[]
			let names = fields.get(permission)
			if !(names is none) {
				let known string[] = names
				declared = known
			}
			for let key in table.keys() {
				let child = table.table(key)
				if child is none {
					let value = table.get(key)
					continue when value is none
					let v any = value
					match v {
						case TOMLArray:
							// `"*.deny" = ["*"]` written as one quoted key: read it as the rule it means
							let dot = key.indexOf(".")
							fail "{permission}: {key} needs a kind: {key}.allow, {key}.deny or {key}.ask" when dot < 0
							let field = key[0:dot]
							fail "{permission} has no field {field}; declared: {declared.join(", ")}" unless field == "*" || declared.includes(field)
							try setRule(subject, permission, field, key[dot + 1:], table.items(key))
							continue
						default:
					}
					settings[subject + "|" + permission + "|" + key] = table.string(key, scalarText(v))
					continue
				}
				fail "{permission} has no field {key}; declared: {declared.join(", ")}" unless key == "*" || declared.includes(key)
				let field TOMLTable = child
				for let kind in field.keys() {
					try setRule(subject, permission, key, kind, field.items(kind))
				}
			}
			return none
		}

		// One `field.kind = [...]` line into the loaded rules. `*` is the
		// whole permission and needs no declared field.
		//
		// Fails when the kind is not allow, deny or ask, or an item is not a string.
		def setRule(subject string, permission string, field string, kind string, items any[]) !none {
			fail "{permission}: {field}.{kind} is not allow, deny or ask" unless kind == "allow" || kind == "deny" || kind == "ask"
			let values string[]
			for let item in items {
				match item {
					case string:
						let text string = item
						values.push(expand(text))
					default:
						fail "{permission}: {field}.{kind} must be a list of strings"
				}
			}
			let ruleKey = subject + "|" + permission + "|" + field
			let rule = rules.get(ruleKey)
			let current = Rule<string>{}
			current = rule unless rule is none
			current.allow = values when kind == "allow"
			current.deny = values when kind == "deny"
			current.ask = values when kind == "ask"
			rules[ruleKey] = current
			return none
		}

		// A setting's scalar as text: numbers and booleans as written.
		def scalarText(value any) string {
			match value {
				case bool:
					let b bool = value
					return b ?? ("true", "false")
				case int:
					let n int = value
					return n.str()
				case float:
					let x float = value
					return x.str()
				default:
					return "{value}"
			}
		}

		def parseList(value string, number int) !string[] {
			fail "line {number}: expected a list like [\"a\", \"b\"]" unless value.startsWith("[") && value.endsWith("]")
			let out string[]
			for let item in value[1:value.len() - 1].split(",") {
				let text = item.trim()
				continue when text == ""
				fail "line {number}: list items must be quoted strings" unless text.startsWith("\"") && text.endsWith("\"") && text.len() >= 2
				out.push(expand(text[1:text.len() - 1]))
			}
			return out
		}

		def expand(value string) string {
			return value.replace("$\u007bapp.home}", policyDir)
		}

		def isPolicyState(path string) bool {
			return false when policyDir.len() == 0
			return path == policyFile || path == policyLog || path.startsWith(policyDir + "/policy.")
		}

		// --- the log -----------------------------------------------------------

		def note(outcome string, permission string, subject string, field string, reason string) {
			let entry = PolicyLogEntry{
				time:       time.now().str(),
				outcome:    outcome,
				permission: permission,
				subject:    subject,
				field:      field,
				reason:     reason,
			}
			decided(entry)
			return when policyLog.len() == 0
			let haveDir = __fs_exists(policyDir) onerror recover false
			return unless haveDir
			let fieldText = ""
			fieldText = " field=" + field when field.len() > 0
			appendText(policyLog, "{entry.time} {outcome} {permission} subject={subject}{fieldText} {reason}\n") onerror recover none
		}

		// Appends through the intrinsics: Storage is gated, and the policy
		// state is off-limits to every subject including this service's
		// callers.
		// Replaces the file's text through the intrinsics, like appendText.
		def writeText(path string, text string) !none {
			try __fs_write_all(path, text.bytes())
			return none
		}

		def appendText(path string, text string) !none {
			let fd = try __fs_open(path, "a")
			try __fs_write(fd, text.bytes())
			try __fs_close(fd)
			return none
		}
	}
	/*
	
	policy.check(...)
	policy.require(...)
	policy.grant(...)
	policy.revoke(...)
	policy.list(...)
	
	
	network.connect
	network.listen
	storage.read
	storage.write
	devices.camera
	devices.usb
	process.spawn
	
	
	*/
}
