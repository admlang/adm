partial module std.services {
	use std.reflection

	struct PolicyRequest {
		action string
		fields map<string, any>
	}

	struct PolicyRule {
		owner  string
		action string
		fields map<string, any>
		allow  bool
	}

	struct PolicyDecision {
		allowed     bool
		rule        ?PolicyRule
		reason      ?string
		constraints map<string, any>
	}

	struct PolicyValidation {
		allowed     bool
		reason      ?string
		constraints map<string, any>
	}

	type PolicyValidator = def (value any, request PolicyRequest, rule PolicyRule) !PolicyValidation

	struct PolicyRegistration {
		owner      string
		action     string
		validators map<string, PolicyValidator>
	}

	enum PolicyResolution {
		AllowOnce,
		DenyOnce,
		AllowAlways,
		DenyAlways,
	}

	struct PolicyPrompt {
		request PolicyRequest
		rule    ?PolicyRule
	}

	type PolicyResolver = async def(prompt PolicyPrompt) !PolicyResolution

	service Policy {
		/*
		Responsibilities:
		- permission checks
		- sandboxing
		- feature flags
		- role-based access
		
		@requires("network.outbound")
		def connect() { }
		
		Events:
		- Policy/Denied
		- Policy/Granted
		*/

		description  = ""
		dependencies = Dependencies{
			hard: [Runtime, Application]
		}
		lifecycle    = Lifecycle{
			start: StartMode.Automatic,
			restart: RestartMode.Always,
		}

		atomic registrations                 = map<string, PolicyRegistration>{}
		resolver             ?PolicyResolver
		permissions          string[]

		def config<T>(val T) !none {}

		async def start() !none {
			return none
		}

		async def stop() !none {
			return none
		}

		async def restart() !none {
			return none
		}

		// Requires the specified permissions, prompting the user when a decision is missing.
		//
		// Fails if any permission is denied.
		@query()
		def requirePermissions(permissions string[]) !none {
			return none
		}

		// Revokes the specified permissions for the current application.
		@commit()
		def revokePermissions(permissions string[]) !none {
			return none
		}

		// Returns whether every specified permission is currently granted.
		@query()
		def hasPermissions(permissions string[]) bool {
			return false
		}

		// Registers policy rules, validators, and resolvers for this application.
		@commit()
		def register(registration PolicyRegistration) !none {
			return none
		}

		// Evaluates the specified policy request and returns the complete decision,
		// including the rule and reason that produced it.
		@query()
		def evaluate(request PolicyRequest) !PolicyDecision {}

		// Evaluates the specified policy request.
		//
		// Returns successfully when allowed. When denied, fails with an error
		// describing the policy decision.
		@query()
		def require(request PolicyRequest) !none {}

		def resolve(action string) !PolicyRegistration {
			fail "not implemented"
		}

		def connect() {}
	}

	// Declares a policy-controlled operation and the validators used to evaluate
	// its policy fields.
	//
	// Validators are runtime code and are not persisted as part of policy rules.
	meta def policy(target reflection.MethodMetaContext, action string, fields map<string, PolicyValidator>) {}

	meta def requires(target reflection.FunctionMetaContext, permissions string[]) {}

	meta def requires(target reflection.MethodMetaContext, permissions string[]) {}
	/*
	
	policy.check(...)
	policy.require(...)
	policy.grant(...)
	policy.revoke(...)
	policy.list(...)
	
	
	network.connect
	network.listen
	storage.read
	storage.write
	devices.camera
	devices.usb
	process.spawn
	
	
	*/
}
