// The Policy service's IDE panel: the permissions, the rules in force and the
// latest decisions, and the buttons that change the rules and revoke a grant.

partial module std.services.policy {
	use std.ide::(ide, IdeKind, IdeTable)

	partial service Policy {
		@ide(kind = IdeKind.Table, label = "Permissions", refresh = 10s, rows = 8)
		def idePermissions() IdeTable {
			let rows = string[][]
			for let (_, permission) in list() {
				rows.push([permission.name, permission.description])
			}
			rows.sort((a, b) => a[0] < b[0])
			return IdeTable{columns: ["Permission", "What it allows"], rows: rows}
		}

		// The rules in force, as the policy file would hold them.
		@ide(kind = IdeKind.Text, label = "Rules", refresh = 2s)
		def ideRules() string {
			return text()
		}

		@ide(kind = IdeKind.Table, label = "Latest decisions", refresh = 1s, rows = 0)
		def ideDecisions() IdeTable {
			let rows = string[][]
			for let (_, entry) in decisions.all() {
				rows.push([entry.time, entry.outcome, entry.permission, entry.subject, entry.field, entry.reason])
			}
			return IdeTable{columns: ["Time", "Outcome", "Permission", "Subject", "Field", "Reason"], rows: rows}
		}

		// Replaces the rules in force with the text given, written as the policy
		// file is: grants and refusals alike, for this run.
		@ide(kind = IdeKind.Action, label = "Replace rules", confirm = "Replace the rules in force?")
		def ideReplaceRules(rules string) !none {
			return configure(rules)
		}

		// Takes a permission the program was granted away for the rest of the run.
		@ide(kind = IdeKind.Action, label = "Revoke", confirm = "Revoke this permission for the rest of the run?", row = "idePermissions.Permission")
		def ideRevoke(permission string) !none {
			return revokePermissions([permission])
		}
	}
}
