partial module std.services.policy {
	use std.testing

	@requires("adm.storage.read")
	internal def readable(path Path) !string {
		return path.value()
	}

	check "Policy" {
		@test()
		def TestPathAlias() {
			let got = readable("/etc/hosts") onerror recover ""
			assert got == "/etc/hosts"
			let p Path = "/tmp/x"
			assert "{p}" == "/tmp/x"
		}

		@test()
		def TestPathSpec() {
			let spec = PathSpec{path: Rule<string>{allow: ["/home/*"], deny: ["/home/*/private/*"]}}
			let ok = true
			spec.validate("/home/me/notes") onerror (err error) {
				ok = false
				recover none
			}
			assert ok

			let code = ""
			spec.validate("/home/me/private/keys") onerror (err error) {
				code = err.code
				recover none
			}
			assert code == "policy.denied"
		}

		// A path is checked as the file it reaches: `..` does not step out of
		// an allowed folder or around a denied one, and a relative path
		// starts at the working directory.
		@test()
		def TestPathSpecChecksTheFileNamed() {
			let spec = PathSpec{path: Rule<string>{allow: ["/home/me/notes/**"], deny: ["/home/me/notes/private/**"], ask: ["**"]}}
			let codes string[] = []
			for let path in ["/home/me/notes/a/../b.txt", "/home/me/notes/../.ssh/key", "/home/me/notes/x/../private/keys", "/home/me//notes/./c.txt"] {
				let code = "ok"
				spec.validate(path) onerror (err error) {
					code = err.code
					recover none
				}
				codes.push(code)
			}
			assert codes.join(" ") == "ok policy.ask policy.denied ok"

			let here = Rule<string>{allow: ["{__proc_working_dir()}/**"], ask: ["**"]}
			let local = PathSpec{path: here}
			let inside = "ok"
			local.validate("some/file.txt") onerror (err error) {
				inside = err.code
				recover none
			}
			assert inside == "ok"
			let outside = "ok"
			local.validate("../../../../../../../../etc/hosts") onerror (err error) {
				outside = err.code
				recover none
			}
			assert outside == "policy.ask"
		}

		@test()
		def TestEndpointSpec() {
			let spec = EndpointSpec{
				protocol: Rule<string>{allow: ["https"], deny: ["http"]},
				host:     Rule<string>{deny: ["*.example.net"]},
			}
			let ok = true
			spec.validate("https://api.example.com:443/v1") onerror (err error) {
				ok = false
				recover none
			}
			assert ok

			let denied = 0
			spec.validate("http://api.example.com") onerror (err error) {
				denied++
				recover none
			}
			spec.validate("https://a.example.net/x") onerror (err error) {
				denied++
				recover none
			}
			assert denied == 2
		}

		@test()
		def TestEndpointSpecHostForms() {
			let spec = EndpointSpec{
				protocol: Rule<string>{deny: ["unix"]},
				host:     Rule<string>{deny: ["::1", "10.0.0.0/8", "internal.example.com"]},
			}
			let denied = 0
			for let endpoint in ["[::1]:443", "https://[::1]:443/x", "::1", "10.1.2.3:80", "http://user:secret@internal.example.com:8080/", "/run/app.sock"] {
				spec.validate(endpoint) onerror (err error) {
					denied++
					recover none
				}
			}
			assert denied == 6

			let allowed = 0
			for let endpoint in ["[::2]:443", "example.com:80", "https://example.com", "11.0.0.1:80"] {
				spec.validate(endpoint) onerror (err error) {
					allowed--
					recover none
				}
				allowed++
			}
			assert allowed == 4
		}
	}
}
