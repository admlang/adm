partial module std.services {
	use std.testing

	check "Policy file" {
		@test()
		def TestConfigureAndValidate() !none {
			try Policy.configure("" + "\n" + "			# narrow the program" + "\n" + "			[adm.network.connect]" + "\n" + "			protocol.allow = [\"https\"]" + "\n" + "			host.deny = [\"*.example.net\"]" + "\n" + "			maxConnections = 20" + "\n" + "" + "\n" + "			[adm.storage.read]" + "\n" + "			path.deny = [\"/secret/*\"]" + "\n" + "			")
			let ok = true
			Policy.validate("adm.network.connect", "std.services.EndpointSpec", "https://api.example.com") onerror (err error) {
				ok = false
				recover none
			}
			assert ok

			let denied = 0
			Policy.validate("adm.network.connect", "std.services.EndpointSpec", "https://a.example.net") onerror (err error) {
				denied++
				recover none
			}
			Policy.validate("adm.storage.read", "std.services.PathSpec", "/secret/keys") onerror (err error) {
				denied++
				recover none
			}
			assert denied == 2

			// A permission without rules passes, and an unknown spec is not checked.
			try Policy.validate("adm.storage.write", "std.services.PathSpec", "/secret/keys")
			try Policy.validate("adm.storage.read", "acme.Unknown", "/secret/keys")
			try Policy.configure("")
			return none
		}

		@test()
		def TestConfigureRejectsUnknownNames() !none {
			let messages string[]
			Policy.configure("[adm.nothing.here]\npath.deny = []\n") onerror (err error) {
				messages.push(err.message)
				recover none
			}
			Policy.configure("[adm.storage.read]\nhost.deny = []\n") onerror (err error) {
				messages.push(err.message)
				recover none
			}
			Policy.configure("[adm.storage.read]\npath.maybe = []\n") onerror (err error) {
				messages.push(err.message)
				recover none
			}
			Policy.configure("path.deny = []\n") onerror (err error) {
				messages.push(err.message)
				recover none
			}
			// an unknown permission is skipped, not an error: an older build's
			// rules must not stop the program
			assert messages.len() == 3
			assert messages[0].contains("has no field host")
			assert messages[1].contains("is not allow, deny or ask")
			assert messages[2].contains("needs a [permission] table")
			// a package name may be bare or quoted
			try Policy.configure("[MyApp.adm.storage.read]\npath.deny = [\"/x\"]\n")
			assert Policy.text().contains("[MyApp.adm.storage.read]\npath.deny = [\"/x\"]\n")
			try Policy.configure("[\"MyApp\".adm.storage.read]\npath.deny = [\"/x\"]\n")
			assert Policy.text().contains("[MyApp.adm.storage.read]\npath.deny = [\"/x\"]\n")
			try Policy.configure("")
			return none
		}

		@test()
		def TestAskWithoutResolverOrPromptDenies() !none {
			try Policy.configure("[adm.storage.read]\npath.ask = [\"/ask/*\"]\n")
			let code = ""
			Policy.validate("adm.storage.read", "std.services.PathSpec", "/ask/me") onerror (err error) {
				code = err.code
				recover none
			}
			assert code == "policy.denied"
			try Policy.configure("")
			return none
		}

		@test()
		def TestRememberKeepsOneTablePerPermission() !none {
			try Policy.configure("[\"App\".adm.storage.read]\npath.ask = [\"*\"]\nmaxOpen = 3\n\n[adm.storage.read]\npath.ask = [\"/ask/*\"]\n")
			try Policy.registerResolver(def (prompt PolicyPrompt) !PolicyResolution {
				return PolicyResolution.AllowAlways
			})
			try Policy.validate("adm.storage.read", "std.services.PathSpec", "/ask/a")
			try Policy.validate("adm.storage.read", "std.services.PathSpec", "/ask/b")
			try Policy.registerResolver(def (prompt PolicyPrompt) !PolicyResolution {
				return PolicyResolution.DenyAlways
			})
			Policy.validate("adm.storage.read", "std.services.PathSpec", "/ask/c") onerror recover none
			let text = Policy.text()
			// the answers join the asking subject's table (the program here, no package on the chain)
			assert text.contains("[adm.storage.read]\npath.allow = [\"/ask/a\", \"/ask/b\"]\npath.deny = [\"/ask/c\"]\npath.ask = [\"/ask/*\"]\n")
			assert text.split("[adm.storage.read]").len() == 2
			assert text.contains("[App.adm.storage.read]\npath.ask = [\"*\"]\nmaxOpen = 3\n")
			try Policy.configure("")
			return none
		}

		@test()
		def TestResolverAnswers() !none {
			try Policy.configure("[adm.storage.read]\npath.ask = [\"/ask/*\"]\n")
			try Policy.registerResolver(def (prompt PolicyPrompt) !PolicyResolution {
				return PolicyResolution.AllowOnce
			})
			try Policy.validate("adm.storage.read", "std.services.PathSpec", "/ask/me")
			try Policy.registerResolver(def (prompt PolicyPrompt) !PolicyResolution {
				return PolicyResolution.DenyOnce
			})
			let denied = false
			Policy.validate("adm.storage.read", "std.services.PathSpec", "/ask/me") onerror (err error) {
				denied = true
				recover none
			}
			assert denied
			try Policy.configure("")
			return none
		}

		// `*` names a permission as a whole: the only rule a permission without
		// fields can have, applied before field rules, written either as the
		// dotted key `"*".deny` or as one quoted key `"*.deny"`.
		@test()
		def TestWholePermissionRules() !none {
			try Policy.configure("[adm.storage.read]\n\"*\".deny = [\"*\"]\n")
			let code = ""
			Policy.require(PolicyRequest{action: "adm.storage.read"}) onerror (err error) {
				code = err.code
				recover none
			}
			assert code == "policy.denied"
			let decision = try Policy.explain(PolicyRequest{action: "adm.storage.read"})
			assert !decision.allowed
			assert !(decision.constraints.get("*.deny") is none)

			try Policy.configure("[adm.storage.read]\n\"*.deny\" = [\"*\"]\n")
			code = ""
			Policy.require(PolicyRequest{action: "adm.storage.read"}) onerror (err error) {
				code = err.code
				recover none
			}
			assert code == "policy.denied"

			// allowed as a whole, the field rules still apply
			try Policy.configure("[adm.storage.read]\n\"*\".allow = [\"*\"]\npath.deny = [\"/secret/*\"]\n")
			try Policy.require(PolicyRequest{action: "adm.storage.read"})
			let denied = false
			Policy.validate("adm.storage.read", "std.services.PathSpec", "/secret/keys") onerror (err error) {
				denied = true
				recover none
			}
			assert denied

			// asked as a whole: an Always answer is written back under `*`
			try Policy.configure("[adm.storage.read]\n\"*\".ask = [\"*\"]\n")
			try Policy.registerResolver(def (prompt PolicyPrompt) !PolicyResolution {
				return PolicyResolution.AllowAlways
			})
			try Policy.require(PolicyRequest{action: "adm.storage.read"})
			assert Policy.text().contains("[adm.storage.read]\n\"*\".allow = [\"*\"]\n\"*\".ask = [\"*\"]\n")
			try Policy.registerResolver(def (prompt PolicyPrompt) !PolicyResolution {
				return PolicyResolution.DenyOnce
			})
			try Policy.require(PolicyRequest{action: "adm.storage.read"})

			// an unknown field is still a load error
			let messages string[]
			Policy.configure("[adm.storage.read]\nnope.deny = [\"*\"]\n") onerror (err error) {
				messages.push(err.message)
				recover none
			}
			assert messages.len() == 1
			assert messages[0].contains("has no field nope")
			try Policy.configure("")
			return none
		}

		@test()
		def TestExplainAndList() !none {
			try Policy.configure("[adm.storage.read]\npath.deny = [\"/secret/*\"]\n")
			let decision = try Policy.explain(PolicyRequest{action: "adm.storage.read"})
			assert decision.allowed
			let deny = decision.constraints.get("path.deny")
			assert !(deny is none)
			let missing = try Policy.explain(PolicyRequest{action: "adm.process.spawn"})
			assert !missing.allowed
			assert Policy.list().len() > 0
			try Policy.configure("")
			return none
		}
	}
}
