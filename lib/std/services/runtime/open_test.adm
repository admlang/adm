partial module std.services.runtime {
	use std.testing

	check "Runtime.open" {
		// An empty address and one an opener would read as an option are refused.
		@test()
		def refusesWhatIsNoAddress() {
			let refused = 0
			for let address in ["  ", "--help"] {
				Runtime.open(address) onerror (err error) {
					refused++
					recover none
				}
			}
			assert refused == 2
		}

		// The desktop's opener for this platform takes the address as its one argument.
		@test()
		@os("linux")
		def opensWithTheDesktopsOpener() {
			let (program, args) = openerFor("https://adm-lang.dev/")
			assert program == "xdg-open" && args.len() == 1 && args[0] == "https://adm-lang.dev/"
		}
	}
}
