// Plugins as a host sees them: a file read for its metadata, then asked for
// something of a shape the host declares.
partial module std.services.runtime {
	use (
		std.crypto::(newEd25519PublicKey)
		std.crypto.hash::(Hash, digest)
		std.data.encoding::(Base32, JSON, base64decode)
		std.os
		std.services.policy::(Policy)
	)

	// A method or a field of a type a plugin publishes.
	struct PluginMember {
		name      string
		// Its type in the spelling a host is matched with: `def(float[], int) bool`
		// for a method, the field's type for a field.
		signature string
	}

	// One name a plugin publishes.
	struct PluginExport {
		name      string
		// `function`, `type`, `struct`, `interface`, `const`, ...
		kind      string
		// The type of a function or constant, in the spelling a host is matched
		// with; empty for the other kinds.
		signature string
		// The doc comment of the declaration.
		doc       string
		// The methods of a type or the signatures of an interface, by name.
		methods   PluginMember[]
		// The fields of a type or struct, by name.
		fields    PluginMember[]
	}

	// A plugin package on disk, read for its metadata. Nothing of it runs
	// until `init`, `create` or `createAll` is called, and it is loaded once
	// for the life of the program.
	//
	//     for let (_, found) in Runtime.loadPlugins("./plugins") {
	//         effects.push(try found.create<Effect>()) when found.creates<Effect>()
	//     }
	type Plugin {
		name               string
		version            string
		// The package file the metadata came from.
		path               string
		// The id of the publisher that signed the package, empty when unsigned.
		publisher          string
		// Whether the package is what a publisher signed: it carries a signature
		// that verifies with the publisher's key over its name, version, exports,
		// permissions and the checksum of every part.
		signed             bool
		// What the plugin publishes, sorted by name.
		exports            PluginExport[]
		// The permissions the plugin's code reaches, as its package records
		// them (`adm.storage.read`), sorted. What it holds of them is decided
		// when it is loaded: see `init`.
		permissions        string[]
		internal entry     string
		internal abi       int
		internal compiler  string
		internal targets   string[]
		internal handle    int64          = 0
		internal loaded    bool           = false
		// The SHA-256 of each part by its name, in hex: the signed list of a
		// signed package, else the package's own. A part is used only when it
		// hashes to its entry here.
		internal sums                     = map<string, string>{}
		// Why nothing of the package may be used (a signature that does not
		// verify, a part that is not what its checksum says); empty when it may.
		internal fault     string         = ""
		// What each permission is, as the package records it:
		// `description|field,field` by permission name.
		internal described                = map<string, string>{}
		// How each type a host can meet through the exports is laid out, by
		// its name, as the package records it.
		internal layouts                  = map<string, string>{}

		// Reports whether the plugin provides a T, from the metadata alone. For
		// an interface T: an exported type that has every method of it, or
		// exported functions that together cover them. For a struct T: an
		// exported value whose type has the fields of T, in T's order.
		def creates<T>() bool {
			let shape = __plugin_shape<T>()
			return values(self, __plugin_layouts<T>()).len() > 0 when shape.len() == 0
			return providers(self, shape, __plugin_layouts<T>()).len() > 0
		}

		// Returns a T the plugin provides. For an interface T: a new object of
		// the first exported type that has every method of T, else one object
		// whose methods are the plugin's exported functions. For a struct T: a
		// copy of the first exported value whose type has the fields of T. Loads
		// the plugin on first use.
		//
		// Fails when the package does not verify, the plugin provides no T,
		// cannot be loaded (see `init`), or the type cannot be built without
		// arguments.
		def create<T>() !T {
			fail fault when fault != ""
			let shape = __plugin_shape<T>()
			let layouts = __plugin_layouts<T>()
			if shape.len() == 0 {
				let held = values(self, layouts)
				fail noValue(self, layouts) when held.len() == 0
				try init()
				return try __plugin_value<T>(handle, held[0])
			}
			let fits = providers(self, shape, layouts)
			fail notProvided(self, shape, layouts) when fits.len() == 0
			try init()
			return try __plugin_create<T>(handle, fits[0], shape)
		}

		// Returns every T the plugin provides. For an interface T: one for each
		// exported type that has every method of T, then one over the plugin's
		// exported functions when they cover T. For a struct T: a copy of each
		// exported value whose type has the fields of T, by name. Loads the
		// plugin on first use.
		//
		// Fails when the package does not verify, the plugin provides no T,
		// cannot be loaded (see `init`), or one of the types cannot be built
		// without arguments.
		def createAll<T>() !T[] {
			fail fault when fault != ""
			let shape = __plugin_shape<T>()
			let layouts = __plugin_layouts<T>()
			let out T[] = []
			if shape.len() == 0 {
				let held = values(self, layouts)
				fail noValue(self, layouts) when held.len() == 0
				try init()
				for let (_, exported) in held {
					out.push(try __plugin_value<T>(handle, exported))
				}
				return out
			}
			let fits = providers(self, shape, layouts)
			fail notProvided(self, shape, layouts) when fits.len() == 0
			try init()
			for let (_, exported) in fits {
				out.push(try __plugin_create<T>(handle, exported, shape))
			}
			return out
		}

		// Loads the plugin's code and runs its `new()`, once; later calls do
		// nothing. For a plugin that only registers things; `create` and
		// `createAll` call it themselves.
		//
		// Fails when the package's signature or a checksum does not verify,
		// the package is unsigned or signed by a publisher this program does not
		// trust (`[plugins]` in `adm.toml`), it holds no object for this
		// platform, was built for another plugin ABI or with another adm than
		// this program, the program was not built with `--runtime shared`, the
		// object cannot be read or loaded, or the plugin's `new()` fails.
		def init() !none {
			return none when loaded
			fail fault when fault != ""
			let refused = distrust(self)
			fail refused when refused != ""
			let target = "{__os__}-{__arch__}"
			fail "plugin {name}: {path} holds no object for {target}" unless holds(targets, target)
			handle = try openObject(self, target)
			loaded = true
			return none
		}
	}

	// The package files of a folder end with this.
	internal const pluginSuffix = ".admplugin"

	// Reads the metadata of the plugin package at the path. Returns none when
	// the path is not a readable plugin package.
	internal def readPlugin(path string) ?Plugin {
		// The Storage service answers for the path first: a path the policy
		// denies reads as no package.
		let readable = os.exists(path) onerror recover false
		return none unless readable
		let manifest = jsonPart(path, "manifest.json")
		return none when manifest is none
		let out = new Plugin()
		out.path = path
		out.name = text(manifest, "name")
		out.version = text(manifest, "version")
		out.entry = text(manifest, "entry")
		return none when out.name == "" || out.entry == ""
		let built = member(manifest, "adm")
		match built {
			case map<string, any>:
				out.compiler = text(built, "compiler")
				let abi = member(built, "abi")
				match abi {
					case int:
						out.abi = abi
					default:
				}
			default:
		}
		// What the package says about itself: the signed copy when it is
		// signed, so nothing below reads a field the signature does not cover.
		let identity = manifest
		if text(manifest, "signature") != "" || manifest.hasKey("publisher") {
			let signed = signedIdentity(path, manifest) onerror (err error) {
				out.fault = "plugin {out.name}: {path} {err.message}"
				return out
			}
			identity = signed
			out.signed = true
			out.name = text(identity, "name")
			out.version = text(identity, "version")
			out.entry = text(identity, "entry")
			let publisher = member(identity, "publisher")
			match publisher {
				case map<string, any>:
					out.publisher = text(publisher, "id")
				default:
			}
			out.sums = strings(member(identity, "checksums"))
		} else {
			let sums = jsonPart(path, "meta/checksums.json")
			if sums is none {
				out.fault = "plugin {out.name}: {path} has no meta/checksums.json"
				return out
			}
			out.sums = strings(sums)
		}
		out.targets = texts(member(identity, "targets"))
		let index = checkedPart(out, "meta/exports.json") onerror (err error) {
			out.fault = err.message
			return out
		}
		let laidOut = checkedPart(out, "meta/layouts.json") onerror (err error) {
			out.fault = err.message
			return out
		}
		out.layouts = strings(new JSON().parse(laidOut) onerror recover none)
		out.permissions = permissionNames(member(identity, "permissions"))
		out.described = permissionTexts(member(identity, "permissions"))
		out.exports = readExports(index)
		return out
	}

	// Verifies the publisher's signature of the package at the path and
	// returns what was signed: the package's name, version, targets, exports,
	// entry, permissions, publisher and the checksum of every part.
	//
	// Fails, with the reason after the path, when the package lacks the
	// signature, the publisher or the signed part, the key or the signature is
	// malformed, the signature does not verify, or the publisher's id is not
	// the one its key gives.
	internal def signedIdentity(path string, manifest map<string, any>) !map<string, any> {
		let signature = base64decode(text(manifest, "signature")) onerror (err error) {
			fail "has a signature that is not Base64"
		}
		fail "names a publisher but carries no signature" when signature.len() == 0
		// The exact bytes the publisher signed, stored beside the manifest.
		let signed = partOf(path, signedPart)
		fail "is signed but holds no {signedPart} (rebuild it with this adm)" when signed is none
		let identity = jsonPart(path, signedPart)
		fail "holds a {signedPart} that is not a JSON object" when identity is none
		let publisher = member(identity, "publisher")
		let id = ""
		let key = ""
		match publisher {
			case map<string, any>:
				id = text(publisher, "id")
				key = text(publisher, "pubkey")
			default:
		}
		fail "is signed but names no publisher key" unless key.startsWith(keyPrefix)
		let raw = base64decode(key.trimPrefix(keyPrefix)) onerror (err error) {
			fail "names a publisher key that is not Base64"
		}
		fail "names a publisher key that is not 32 bytes" when raw.len() != 32
		let public = newEd25519PublicKey(raw) onerror (err error) {
			fail "names a publisher key that is not an Ed25519 key"
		}
		fail "has a signature that does not verify: the package is not what its publisher signed" unless public.verify(signed, signature)
		fail "names publisher {id}, which is not the id of its key" when id != publisherID(raw)
		return identity
	}

	// The stored part of a package the signed bytes are in.
	internal const signedPart = "meta/signed.json"

	// How a publisher's public key is spelled in a package and in `adm.toml`.
	internal const keyPrefix = "ed25519:base64:"

	// The id of the publisher holding the public key: `admpub_` and the
	// SHA-256 of the key in lower-case Base32 without padding.
	internal def publisherID(key byte[]) string {
		let codec = new Base32()
		codec.padded = false
		return "admpub_" + codec.encode(digest(Hash.SHA256, key)).lower()
	}

	// The bytes of a part of the plugin's package, checked against the
	// checksum the package records for it.
	//
	// Fails when the package holds no such part, records no checksum for it,
	// or the part is not what the checksum says.
	internal def checkedPart(source Plugin, name string) !byte[] {
		let data = partOf(source.path, name)
		fail "plugin {source.name}: {source.path} holds no {name}" when data is none
		try checked(source, name, data)
		return data
	}

	// Fails unless the bytes are what the plugin's package records for the
	// part: its SHA-256 is the checksum of that name.
	internal def checked(source Plugin, name string, data byte[]) !none {
		fail "plugin {source.name}: {source.path} records no checksum for {name}" unless source.sums.hasKey(name)
		fail "plugin {source.name}: {name} of {source.path} does not match its checksum; the package was modified" when sha256(data) != source.sums[name].lower()
		return none
	}

	// The SHA-256 of the bytes in lower-case hex, as a package spells a checksum.
	internal def sha256(data byte[]) string {
		return digest(Hash.SHA256, data).hex().lower()
	}

	// Why this program does not load the plugin, by `[plugins]` of its
	// `adm.toml`; empty when it does. An unsigned package loads only with
	// `allow_unsigned = true`; a signed one when `trusted` is empty or names
	// its publisher, `self` naming this program's own.
	internal def distrust(source Plugin) string {
		if !source.signed {
			return "" when policyValues("unsigned").len() == 1 && policyValues("unsigned")[0] == "1"
			return "plugin {source.name}: {source.path} is not signed, and this program loads signed plugins only (`allow_unsigned = true` under [plugins] in adm.toml lets it)"
		}
		let trusted = policyValues("trusted")
		return "" when trusted.len() == 0
		for let (_, id) in trusted {
			return "" when id == source.publisher || (id == "self" && __publisher_id__ != "" && source.publisher == __publisher_id__)
		}
		return "plugin {source.name}: {source.path} is signed by {source.publisher}, which this program does not trust (`trusted` under [plugins] in adm.toml lists who it does)"
	}

	// The values of one entry of `__plugin_policy__`
	// (`unsigned=0;trusted=a,b;permissions=c`); empty when it has none.
	internal def policyValues(key string) string[] {
		let out = string[]
		for let entry in __plugin_policy__.split(";") {
			continue unless entry.startsWith(key + "=")
			for let value in entry[key.len() + 1:].split(",") {
				out.push(value) unless value == ""
			}
		}
		return out
	}

	// The entries of a package's export index; empty when it has none or it
	// does not parse.
	internal def readExports(index ?byte[]) PluginExport[] {
		let out = PluginExport[]
		return out when index is none
		let doc = new JSON().parse(index) onerror (err error) {
			recover none
		}
		match doc {
			case any[]:
				for let (_, item) in doc {
					match item {
						case map<string, any>:
							out.push(PluginExport{
								name:      text(item, "name"),
								kind:      text(item, "kind"),
								signature: text(item, "canonical"),
								doc:       text(item, "doc"),
								methods:   members(member(item, "methods")),
								fields:    members(member(item, "fields")),
							})
						default:
					}
				}
			default:
		}
		return out
	}

	// The exports of the plugin that fill the shape, in the order `createAll`
	// builds them: the name of each exported type that has every method of the
	// shape, then an empty name when the exported functions cover it. A shape
	// without a method is filled by nothing, and so is one that names a type
	// the plugin lays out another way than `layouts`, the program's own.
	internal def providers(source Plugin, shape string[], layouts string[]) string[] {
		let out = string[]
		return out when shape.len() < 3 || otherLayout(source, layouts) != ""
		for let (_, exported) in source.exports {
			continue unless exported.kind == "type"
			out.push(exported.name) when missingSlot(shape, exported.methods) == ""
		}
		let functions = PluginMember[]
		for let (_, exported) in source.exports {
			functions.push(PluginMember{name: exported.name, signature: exported.signature}) when exported.kind == "function"
		}
		out.push("") when missingSlot(shape, functions) == ""
		return out
	}

	// The first method of the shape that none of the members is, as
	// `name signature`; empty when every one is there.
	internal def missingSlot(shape string[], have PluginMember[]) string {
		let i = 1
		for i + 1 < shape.len() {
			let found = false
			for let (_, m) in have {
				if m.name == shape[i] && m.signature == shape[i + 1] {
					found = true
					break
				}
			}
			return "{shape[i]} {shape[i + 1]}" unless found
			i += 2
		}
		return ""
	}

	// The exported values of the plugin that fill a struct, by name: each
	// `const` or `let` whose type the plugin lays out as `layouts` says the
	// program lays the struct out. `layouts` is `__plugin_layouts<T>()`: the
	// struct first, then the types its fields name, which have to be laid out
	// alike on both sides too. Empty when it does not start with a struct.
	internal def values(source Plugin, layouts string[]) string[] {
		let out = string[]
		return out when layouts.len() < 2 || !(layouts[1].startsWith("struct") || layouts[1].startsWith("type"))
		return out when otherLayout(source, layouts[2:]) != ""
		for let (_, exported) in source.exports {
			continue unless (exported.kind := "const" || "let") && source.layouts.hasKey(exported.signature)
			out.push(exported.name) when source.layouts[exported.signature] == layouts[1]
		}
		return out
	}

	// Why the plugin has no value for the struct `layouts` starts with.
	internal def noValue(source Plugin, layouts string[]) string {
		return "plugin {source.name} was asked for a type that is neither an interface with methods nor a struct" when layouts.len() < 2 || !(layouts[1].startsWith("struct") || layouts[1].startsWith("type"))
		let other = otherLayout(source, layouts[2:])
		return "plugin {source.name} provides no {layouts[0]}: {other}" when other != ""
		return "plugin {source.name} provides no {layouts[0]}: no exported value is laid out as {layouts[1]}"
	}

	// The first type of `layouts` (a name and a layout per type, the program's
	// own) that the plugin lays out another way, said in full; empty when
	// every type both sides name is one type. A type the plugin does not name
	// is not compared: no signature of it can match one that does.
	internal def otherLayout(source Plugin, layouts string[]) string {
		let i = 0
		for i + 1 < layouts.len() {
			let name = layouts[i]
			if source.layouts.hasKey(name) && source.layouts[name] != layouts[i + 1] {
				return "its {name} is not this program's {name}: the plugin has {source.layouts[name]}, the program {layouts[i + 1]}"
			}
			i += 2
		}
		return ""
	}

	// Why the plugin fills no part of the shape.
	internal def notProvided(source Plugin, shape string[], layouts string[]) string {
		return "plugin {source.name} was asked for a type that is not an interface with methods" when shape.len() < 3
		let other = otherLayout(source, layouts)
		return "plugin {source.name} provides no {shape[0]}: {other}" when other != ""
		let closest = ""
		for let (_, exported) in source.exports {
			continue unless exported.kind == "type"
			closest = "; its type {exported.name} lacks {missingSlot(shape, exported.methods)}"
			break
		}
		return "plugin {source.name} provides no {shape[0]}: no exported type has every method of it and its exported functions do not cover it{closest}"
	}

	// Loads the plugin's object for the target and returns its handle: the
	// object unpacked beside the package when there is one, else the one
	// stored in the package, in place where the platform allows and through
	// the application's folder where it does not.
	@requires("adm.runtime.plugins")
	internal def openObject(source Plugin, target string) !int64 {
		// The plugin becomes a package of its own to the policy before any of
		// its code runs: what it holds is settled here.
		try Policy.admitPlugin(source.name, source.publisher, source.permissions, source.described)
		let file = objectName(source.name)
		let part = "{target}/{file}"
		let unpacked = source.path.trimSuffix(pluginSuffix) + os.extension(file)
		let isUnpacked = os.exists(unpacked) onerror recover false
		if isUnpacked {
			// The unpacked object is the package's, or it is not loaded.
			try checked(source, part, try os.readFile(unpacked))
			return try __plugin_load(unpacked, source.name, source.entry, __compiler_version__)
		}
		let object = try checkedPart(source, part)
		// From memory where the platform can: what runs is what was checked.
		return try __plugin_load_bytes(source.path, source.name, object, source.entry, __compiler_version__) when __plugin_loads_in_place()

		// A file the platform's loader can open, named by the object's
		// checksum so one copy serves every run.
		let sum = sha256(object)
		let folder = os.join(os.dir(source.path), ".cache")
		let home = os.appHome() onerror recover ""
		folder = os.join(home, "plugins") when home != ""
		let cached = os.join(folder, "{source.name}-{sum}{os.extension(file)}")
		let isCached = os.exists(cached) onerror recover false
		let intact = false
		if isCached {
			let kept = os.readFile(cached) onerror recover byte[]
			intact = sha256(kept) == sum
		}
		if !intact {
			try os.mkdir(folder, true)
			// Written whole, then renamed: another process never sees half a file.
			try os.writeFile(cached + ".tmp", object)
			try os.rename(cached + ".tmp", cached)
		}
		return try __plugin_load(cached, source.name, source.entry, __compiler_version__)
	}

	// The file name of a plugin's object on this platform.
	internal def objectName(name string) string {
		return "{name}.dll" when __os__ == "windows"
		return "lib{name}.dylib" when __os__ == "darwin"
		return "lib{name}.so"
	}

	// The bytes of a stored part of the package at the path; none when the
	// file is not a package or holds no such part.
	internal def partOf(path string, name string) ?byte[] {
		let data = __plugin_part(path, name) onerror (err error) {
			return none
		}
		return data
	}

	// A part of the package holding a JSON object; none when it is missing or
	// holds anything else.
	internal def jsonPart(path string, name string) ?map<string, any> {
		let data = partOf(path, name)
		return none when data is none
		let doc = new JSON().parse(data) onerror (err error) {
			recover none
		}
		match doc {
			case map<string, any>:
				return doc
			default:
				return none
		}
	}

	internal def member(obj map<string, any>, key string) any {
		return none unless obj.hasKey(key)
		return obj[key]
	}

	// The string under the key; empty when there is none.
	internal def text(obj map<string, any>, key string) string {
		let value = member(obj, key)
		match value {
			case string:
				return value
			default:
				return ""
		}
	}

	// The strings of a JSON array; empty for anything else.
	internal def texts(value any) string[] {
		let out = string[]
		match value {
			case any[]:
				for let (_, item) in value {
					match item {
						case string:
							out.push(item)
						default:
					}
				}
			default:
		}
		return out
	}

	// The string members of a JSON object, by key; empty for anything else.
	internal def strings(value any) map<string, string> {
		let out = map<string, string>{}
		match value {
			case map<string, any>:
				for let (key, item) in value {
					match item {
						case string:
							out[key] = item
						default:
					}
				}
			default:
		}
		return out
	}

	// The names of a manifest's permission entries, each once, sorted.
	internal def permissionNames(value any) string[] {
		let out = string[]
		match value {
			case any[]:
				for let (_, item) in value {
					match item {
						case map<string, any>:
							let name = text(item, "permission")
							out.push(name) unless name == "" || holds(out, name)
						default:
					}
				}
			default:
		}
		return out.sort((a, b) => a < b)
	}

	// What a manifest's permission entries say each permission is, by name:
	// its description, then `|` and its rule fields, comma-separated.
	internal def permissionTexts(value any) map<string, string> {
		let out = map<string, string>{}
		match value {
			case any[]:
				for let (_, item) in value {
					match item {
						case map<string, any>:
							let name = text(item, "permission")
							continue when name == ""
							out[name] = "{text(item, "description").replace("|", "/")}|{texts(member(item, "fields")).join(",")}"
						default:
					}
				}
			default:
		}
		return out
	}

	// The `name`/`canonical` pairs of a JSON array of members.
	internal def members(value any) PluginMember[] {
		let out = PluginMember[]
		match value {
			case any[]:
				for let (_, item) in value {
					match item {
						case map<string, any>:
							out.push(PluginMember{name: text(item, "name"), signature: text(item, "canonical")})
						default:
					}
				}
			default:
		}
		return out
	}

	internal def holds(items string[], item string) bool {
		for let (_, have) in items {
			return true when have == item
		}
		return false
	}
}
