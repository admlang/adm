partial module std.services.runtime {
	use (
		std.bytes
		std.crypto::(Ed25519PrivateKey, generateEd25519Key)
		std.formats.archive::(CompressionLevel, Entry, WriteOptions, Zip)
		std.os
		std.testing
	)

	interface TestEffect {
		def process(samples float[], rate int)
	}

	interface TestCodec {
		def decode(data byte[]) !string
		def name() string
	}

	interface TestOther {
		def nothing()
	}

	// Writes a package that holds the metadata parts given, stored as a plugin
	// package stores them, and no object. An empty part is left out.
	internal def writeTestPackage(path string, manifest string, exports string, sums string, signed string = "") !none {
		let out = new bytes.Buffer()
		let zip = try new Zip().create(out, WriteOptions{level: CompressionLevel.Default})
		try zip.add(Entry{name: "manifest.json", method: "store", attributes: new map<string, string>()}, new bytes.Reader(manifest.bytes()))
		try zip.add(Entry{name: "meta/exports.json", method: "store", attributes: new map<string, string>()}, new bytes.Reader(exports.bytes()))
		try zip.add(Entry{name: "meta/layouts.json", method: "store", attributes: new map<string, string>()}, new bytes.Reader(testLayouts.bytes()))
		if sums != "" {
			try zip.add(Entry{name: "meta/checksums.json", method: "store", attributes: new map<string, string>()}, new bytes.Reader(sums.bytes()))
		}
		if signed != "" {
			try zip.add(Entry{name: signedPart, method: "store", attributes: new map<string, string>()}, new bytes.Reader(signed.bytes()))
		}
		try zip.close()
		try os.writeFile(path, out.bytes())
		return none
	}

	// How the test packages say their one type is laid out.
	internal const testLayouts = "\{\"Echo\":\"type\{delay int\}\"\}"

	// The checksums of a package's export index and layouts.
	internal def testSums(exports string) string {
		return "\{\"meta/exports.json\":\"{sha256(exports.bytes())}\",\"meta/layouts.json\":\"{sha256(testLayouts.bytes())}\"\}"
	}

	// The manifest of an unsigned package.
	internal def testManifest(name string) string {
		return "\{\"name\":\"{name}\",\"version\":\"1.2.0\",\"adm\":\{\"abi\":2,\"compiler\":\"0.1\"\},\"targets\":[\"none-none\"],\"exports\":[\"Echo\",\"decode\",\"name\"],\"entry\":\"adm_plugin_{name}\"\}"
	}

	// What the publisher holding the key signs for the package: its identity
	// and the checksums of its parts.
	internal def testIdentity(name string, key Ed25519PrivateKey, exports string) string {
		let publisher = "\{\"id\":\"{publisherID(key.public.bytes)}\",\"pubkey\":\"{keyPrefix}{key.public.bytes.base64()}\"\}"
		return "\{\"name\":\"{name}\",\"version\":\"1.2.0\",\"targets\":[\"none-none\"],\"exports\":[\"Echo\",\"decode\",\"name\"],\"entry\":\"adm_plugin_{name}\",\"publisher\":{publisher},\"checksums\":{testSums(exports)}\}"
	}

	// Writes a package signed with the key. Its manifest states another
	// version than the signed part does, as a manifest changed after signing
	// would.
	internal def writeSignedPackage(path string, name string, key Ed25519PrivateKey, exports string, shipped string) !none {
		let identity = testIdentity(name, key, exports)
		let signature = key.sign(identity.bytes()).base64()
		let manifest = "\{\"name\":\"{name}\",\"version\":\"0.0.1\",\"adm\":\{\"abi\":2,\"compiler\":\"0.1\"\},\"entry\":\"adm_plugin_{name}\",\"publisher\":\{\"id\":\"someone\"\},\"signature\":\"{signature}\"\}"
		try writeTestPackage(path, manifest, shipped, "", identity)
		return none
	}

	// Why the package gives no TestOther, TestEffect, or does not load.
	internal def otherFailure(found Plugin) string {
		found.create<TestOther>() onerror (err error) {
			return err.message
		}
		return ""
	}

	internal def effectFailure(found Plugin) string {
		found.create<TestEffect>() onerror (err error) {
			return err.message
		}
		return ""
	}

	internal def initFailure(found Plugin) string {
		found.init() onerror (err error) {
			return err.message
		}
		return ""
	}

	internal const testExports = "[\{\"name\":\"Echo\",\"kind\":\"type\",\"methods\":[\{\"name\":\"process\",\"canonical\":\"def(float[], int)\"\}],\"fields\":[\{\"name\":\"delay\",\"canonical\":\"int\"\}]\},\{\"name\":\"decode\",\"kind\":\"function\",\"canonical\":\"def(byte[]) !string\",\"doc\":\"Decodes.\"\},\{\"name\":\"name\",\"kind\":\"function\",\"canonical\":\"def() string\"\}]"

	check "Plugins" {
		@test()
		def readsAPackageWithoutLoadingIt() !none {
			let folder = os.join(try os.appHome(), "plugins-read")
			try os.mkdir(folder, true)
			let path = os.join(folder, "Echoes-1.2.0.admplugin")
			let key = try generateEd25519Key()
			try writeSignedPackage(path, "Echoes", key, testExports, testExports)

			let found = Runtime.loadPlugin(path)
			fail "the package was not read" when found is none
			assert found.name == "Echoes"
			// What it says about itself is read from the signed part.
			assert found.version == "1.2.0"
			assert found.path == path
			assert found.signed
			assert found.publisher == publisherID(key.public.bytes)
			assert found.publisher.startsWith("admpub_") && found.publisher.len() == 59
			assert found.exports.len() == 3
			assert found.exports[0].name == "Echo"
			assert found.exports[0].kind == "type"
			assert found.exports[0].methods[0].signature == "def(float[], int)"
			assert found.exports[0].fields[0].name == "delay"
			assert found.exports[1].doc == "Decodes."
			assert found.exports[1].signature == "def(byte[]) !string"
			return none
		}

		@test()
		def matchesShapesFromTheMetadata() !none {
			let folder = os.join(try os.appHome(), "plugins-match")
			try os.mkdir(folder, true)
			let path = os.join(folder, "Echoes-1.2.0.admplugin")
			try writeSignedPackage(path, "Echoes", try generateEd25519Key(), testExports, testExports)
			let found = Runtime.loadPlugin(path)
			fail "the package was not read" when found is none

			// A type with every method, functions that cover the interface, nothing.
			assert found.creates<TestEffect>()
			assert found.creates<TestCodec>()
			assert !found.creates<TestOther>()

			let why = otherFailure(found)
			assert why.contains("provides no std.services.runtime.TestOther")
			assert why.contains("its type Echo lacks nothing def()")

			// It holds no object for this platform, which loading says.
			assert effectFailure(found).contains("holds no object for")
			assert initFailure(found).contains("holds no object for")
			return none
		}

		@test()
		def refusesAPackageThatDoesNotVerify() !none {
			let folder = os.join(try os.appHome(), "plugins-verify")
			try os.mkdir(folder, true)
			let key = try generateEd25519Key()

			// A part that is not the one the publisher signed.
			let changed = os.join(folder, "changed.admplugin")
			try writeSignedPackage(changed, "Echoes", key, testExports, testExports + " ")
			let found = Runtime.loadPlugin(changed)
			fail "the changed package was not read" when found is none
			assert found.signed && found.exports.len() == 0 && !found.creates<TestEffect>()
			assert effectFailure(found).contains("meta/exports.json of {changed} does not match its checksum")
			assert initFailure(found).contains("does not match its checksum")

			// A signed part that is not what the signature covers.
			let forged = os.join(folder, "forged.admplugin")
			let identity = testIdentity("Echoes", key, testExports)
			let manifest = "\{\"name\":\"Echoes\",\"entry\":\"adm_plugin_Echoes\",\"signature\":\"{key.sign(identity.bytes()).base64()}\"\}"
			try writeTestPackage(forged, manifest, testExports, "", identity.replace("1.2.0", "9.9.9"))
			found = Runtime.loadPlugin(forged)
			fail "the forged package was not read" when found is none
			assert !found.signed && found.publisher == "" && found.exports.len() == 0
			assert initFailure(found).contains("{forged} has a signature that does not verify")

			// A signature and no signed part; a publisher and no signature.
			let bare = os.join(folder, "bare.admplugin")
			try writeTestPackage(bare, manifest, testExports, testSums(testExports))
			found = Runtime.loadPlugin(bare)
			fail "the package without a signed part was not read" when found is none
			assert initFailure(found).contains("is signed but holds no meta/signed.json")
			try writeTestPackage(bare, "\{\"name\":\"Echoes\",\"entry\":\"adm_plugin_Echoes\",\"publisher\":\{\"id\":\"acme\"\}\}", testExports, testSums(testExports))
			found = Runtime.loadPlugin(bare)
			fail "the package without a signature was not read" when found is none
			assert initFailure(found).contains("names a publisher but carries no signature")

			// An unsigned package is read, and loads only where `[plugins]`
			// of adm.toml says so: a test program has no such table.
			let unsigned = os.join(folder, "unsigned.admplugin")
			try writeTestPackage(unsigned, testManifest("Echoes"), testExports, testSums(testExports))
			found = Runtime.loadPlugin(unsigned)
			fail "the unsigned package was not read" when found is none
			assert !found.signed && found.exports.len() == 3 && found.creates<TestEffect>()
			assert initFailure(found).contains("is not signed, and this program loads signed plugins only")

			// Without checksums nothing of it is used.
			try writeTestPackage(unsigned, testManifest("Echoes"), testExports, "")
			found = Runtime.loadPlugin(unsigned)
			fail "the package without checksums was not read" when found is none
			assert found.exports.len() == 0
			assert initFailure(found).contains("has no meta/checksums.json")
			return none
		}

		@test()
		def listsThePackagesOfAFolder() !none {
			let folder = os.join(try os.appHome(), "plugins-list")
			try os.mkdir(folder, true)
			try writeTestPackage(os.join(folder, "b.admplugin"), testManifest("Echoes"), testExports, testSums(testExports))
			try writeTestPackage(os.join(folder, "a.admplugin"), testManifest("First"), "[]", testSums("[]"))
			try os.writeFile(os.join(folder, "broken.admplugin"), "not a package".bytes())
			try os.writeFile(os.join(folder, "notes.txt"), "ignored".bytes())

			let found = Runtime.loadPlugins(folder)
			assert found.len() == 2
			assert found[0].name == "First"
			assert found[0].exports.len() == 0
			assert found[1].name == "Echoes"

			assert Runtime.loadPlugins(os.join(folder, "missing")).len() == 0
			assert Runtime.loadPlugin(os.join(folder, "missing.admplugin")) is none
			assert Runtime.loadPlugin(os.join(folder, "broken.admplugin")) is none
			return none
		}
	}
}
