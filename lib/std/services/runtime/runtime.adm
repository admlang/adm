partial module std.services.runtime {
	use (
		std.os
		std.services::(Dependencies, Lifecycle, RestartMode, ServiceInfo, ServiceStatus, ServiceStatusChange, StartMode)
	)

	// Allocator counters from the runtime: bytes live now and totals since start.
	struct MemoryUsage {
		// Bytes currently held by live allocations.
		liveBytes int64

		// Total number of bytes allocated since runtime startup.
		totalAllocBytes int64

		// Total number of bytes released since runtime startup.
		totalFreeBytes int64

		// Total number of allocations since runtime startup.
		allocCount int64

		// Total number of deallocations since runtime startup.
		freeCount int64
	}

	// The host as the runtime sees it: names, versions, CPU counts and timezone.
	struct SystemInfo {
		hostname        string
		kernelVersion   string
		osVersion       string
		architecture    string
		cpuCount        int
		logicalCpuCount int
		timezone        string
	}

	// What a program run by `Runtime.run` left behind.
	struct ProcessResult {
		// Everything the program wrote to its standard output.
		output string
		// Its exit code; 0 means success.
		code   int
	}

	// The process's view of itself and its host: memory, system information, environment
	// variables, and the services it manages.
	service Runtime {
		description               = "ADM Runtime Service"
		dependencies Dependencies
		lifecycle                 = Lifecycle{
			start: StartMode.Automatic,
			restart: RestartMode.Always,
		}
		permissions               = [
			Permission{name: "spawn", description: "Run other programs; granting it means trusting the package completely"},
			Permission{name: "plugins", description: "Load plugins: code of other publishers that runs inside this program"},
			Permission{name: "open", description: "Open addresses and files in the programs the desktop chooses for them: a web page in the browser, a document in its viewer"},
		]

		// Applies the service's settings. There are none yet, and it does not fail.
		def config<T>(val T) !none {}

		// Starts the service. Does not fail today.
		async def start() !none {
			return none
		}

		// Fails always: the Runtime service cannot be stopped.
		async def stop() !none {
			fail "Runtime service cannot be stopped"
		}

		// Fails always: the Runtime service cannot be stopped.
		async def restart() !none {
			fail "Runtime service cannot be stopped"
		}

		// Returns information about the host system running the ADM runtime.
		@query()
		def systemInfo() SystemInfo {
			return SystemInfo{}
		}

		// Returns current process working directory.
		@query()
		def workingDir() string {
			return __proc_working_dir()
		}

		// Returns memory usage statistics for the current ADM runtime.
		@query()
		def memoryUsage() MemoryUsage {
			return MemoryUsage{
				liveBytes:       __mem_live_bytes(),
				totalAllocBytes: __mem_total_alloc_bytes(),
				totalFreeBytes:  __mem_total_free_bytes(),
				allocCount:      __mem_alloc_count(),
				freeCount:       __mem_free_count(),
			}
		}

		// Returns the value's deep retained footprint in bytes. Runtime object and
		// allocation headers, collection capacity, and recursively retained values
		// are included; shared allocations are counted once. UTF-8 string storage is
		// counted even for literals, while unrelated static/external storage is not.
		@query()
		def sizeOf(val any) int {
			return int(__mem_size_of(val))
		}

		// Returns value of the specified environment variable.
		//
		// Returns none when the variable is not defined.
		@query()
		def getEnv(key string) ?string {
			return __env_get(key)
		}

		// Returns every environment variable of the process as it is now, by name.
		@query()
		def environment() map<string, string> {
			let out = map<string, string>{}
			for let (_, entry) in __env_list() {
				let cut = entry.indexOf("=")
				continue when cut <= 0
				out[entry[0:cut]] = entry[cut + 1:]
			}
			return out
		}

		// Returns runtime information for all registered services.
		@query()
		def services() ServiceInfo[] {
			let out = ServiceInfo[]
			for let (_, name) in __services_names() {
				out.push(ServiceInfo{
					name:   name,
					status: statusFromCode(__service_status(name)),
				})
			}
			return out
		}

		// Maps a runtime status code, the ADM ServiceStatus ordinal, back to the
		// enum value.
		internal def statusFromCode(code int) ServiceStatus {
			match code {
				case 1:
					return ServiceStatus.Starting
				case 2:
					return ServiceStatus.Started
				case 3:
					return ServiceStatus.Stopping
				case 4:
					return ServiceStatus.Stopped
				case 5:
					return ServiceStatus.Restarting
				case 6:
					return ServiceStatus.Failed
				default:
					return ServiceStatus.Unknown
			}
		}

		// Returns runtime information for the specified service.
		//
		// Returns none if the service is not registered with the runtime.
		@query()
		def serviceInfo(name service) ?ServiceInfo {
			return none
		}

		// Sets value of the specified environment variable for the current process.
		//
		// Fails when the operating system rejects the name or value, for example a name holding `=`.
		@commit()
		def setEnv(key string, value string) !none {
			return __env_set(key, value)
		}

		// Runs a command through the system shell with `input` as its standard input
		// and returns what it printed and its exit code, once the command has ended;
		// `start` returns while the program runs. These two are the only ways an ADM
		// program starts another program: a started program has every right the
		// process has, outside every service gate, so the `spawn` permission means
		// trusting the caller completely.
		//
		// Fails when the policy denies it or the process could not be started, which
		// the OS sandbox causes. A command that ran and exited with an error is not a
		// failure; its exit code says so (128 + signal when it was killed, 127 when the
		// shell could not start it).
		@commit(policy = "spawn")
		def run(command string, input string = "") !ProcessResult {
			let (output, code) = try __proc_run(command, input)
			return ProcessResult{output: output, code: code}
		}

		// Starts a program and returns while it runs. `program` is a path, or a
		// name looked up in `PATH`; `args` follow it as written, with no shell in
		// between. `env` adds to or replaces variables of this program's
		// environment for the started one, and `dir` is its working directory
		// (this program's when empty). Its standard input and output are the
		// pipes `input` and `output` of the result; its standard error is this
		// program's, or the pipe `errors` when `errors` is true. Needs the
		// `spawn` permission, as `run` does.
		//
		// Fails when the policy denies it or the program could not be started:
		// no such program, no right to run it, no such folder.
		@commit(policy = "spawn")
		def start(program string, args string[] = [], env map<string, string> = {}, dir string = "", errors bool = false) !os.Process {
			let vars string[]
			for let (name, value) in env {
				vars.push("{name}={value}")
			}
			let (handle, pid, input, output, errorsEnd) = try __proc_start(program, args, vars, dir, errors)
			return new os.Process(handle, pid, input, output, errorsEnd)
		}

		// Opens `address` in the program the desktop chooses for it: a web address in the
		// browser, a `mailto:` address in the mail program, a file in its viewer. The
		// desktop's opener (`xdg-open`, `open`, the Windows URL handler) is started with
		// the address as its one argument, no shell in between, and this waits until it
		// hands the address on. On the web the address opens in a new browser tab.
		// Needs the `open` permission, which is narrower than `spawn`: the program that
		// runs is the one the user chose for that kind of address.
		//
		// Fails when the policy denies it, the address is empty or starts with `-` (an
		// opener would read it as an option), no opener can be started, or it reports
		// that it could not open the address; on the web, when the browser blocks the
		// new tab (browsers allow one right after a click or key press).
		@commit(policy = "open")
		def open(address string) !none {
			fail "Runtime.open: an empty address" when address.trim() == ""
			fail "Runtime.open: \"{address}\" starts with -" when address.startsWith("-")
			try openAddress(address)
			return none
		}

		// Reads the metadata of the plugin package at the path: its name,
		// version, publisher and what it publishes. No code of the plugin is
		// loaded or run. Returns none when the path is not a readable plugin
		// package.
		@query()
		def loadPlugin(path string) ?Plugin {
			return readPlugin(path)
		}

		// Reads the metadata of every plugin package (`*.admplugin`) in the
		// folder, in file name order, loading no code. A file that is not a
		// readable package is left out; a folder that cannot be listed gives an
		// empty list.
		@query()
		def loadPlugins(folder string) Plugin[] {
			let out = Plugin[]
			let entries = os.readDir(folder) onerror (err error) {
				return out
			}
			let paths = string[]
			for let (_, entry) in entries {
				paths.push(entry.path) when entry.path.endsWith(pluginSuffix) && !entry.info.isDir
			}
			for let (_, path) in paths.sort((a, b) => a < b) {
				let found = readPlugin(path)
				out.push(found) unless found is none
			}
			return out
		}

		// Emitted when runtime status of a registered service changes.
		@emit()
		def serviceStatusChanged(change ServiceStatusChange) ServiceStatusChange {
			return ServiceStatusChange{}
		}
	}

	// Starts the desktop's opener with the address and waits until it hands it on.
	@os("linux", "darwin", "windows")
	internal def openAddress(address string) !none {
		let (program, args) = openerFor(address)
		let (handle, pid, input, output, errorsEnd) = try __proc_start(program, args, [], "", false)
		let opener = new os.Process(handle, pid, input, output, errorsEnd)
		let code = try opener.wait()
		fail "Runtime.open: {program} could not open \"{address}\" (exit code {code})" unless code == 0
		return none
	}

	// The program that opens an address on this platform, and its arguments.
	@os("linux")
	internal def openerFor(address string) (string, string[]) {
		return ("xdg-open", [address])
	}

	@os("darwin")
	internal def openerFor(address string) (string, string[]) {
		return ("open", [address])
	}

	@os("windows")
	internal def openerFor(address string) (string, string[]) {
		return ("rundll32", ["url.dll,FileProtocolHandler", address])
	}
}
