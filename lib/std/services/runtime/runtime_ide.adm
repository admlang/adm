// The Runtime service's IDE panel: processor and memory over time, the
// services and their state, the environment.

partial module std.services.runtime {
	use std.ide::(ide, IdeKind, IdeTable)

	partial service Runtime {
		// The share of the machine's processor time the program used in the
		// latest second.
		@ide(kind = IdeKind.Series, label = "Processor", refresh = 1s, unit = "%")
		def ideCpu() float64 {
			let last = cpuHistory.last()
			return last is none ?? (0.0, last)
		}

		// Bytes held by live allocations.
		@ide(kind = IdeKind.Series, label = "Memory", refresh = 1s, unit = "B")
		def ideMemory() int64 {
			return __mem_live_bytes()
		}

		@ide(kind = IdeKind.Value, label = "Allocations", refresh = 1s)
		def ideAllocations() int64 {
			return __mem_alloc_count() - __mem_free_count()
		}

		@ide(kind = IdeKind.Table, label = "Services", refresh = 1s, rows = 0)
		def ideServices() IdeTable {
			let rows = string[][]
			for let (_, info) in services() {
				rows.push([info.name, "{info.status}", "{info.restartCount}"])
			}
			return IdeTable{columns: ["Service", "Status", "Restarts"], rows: rows}
		}

		// The environment's variables by name; their values hold tokens and
		// passwords, so each is shown only on request (`ideShowVariable`).
		@ide(kind = IdeKind.Table, label = "Environment", refresh = 5s, rows = 10)
		def ideEnvironment() IdeTable {
			let names = environment().keys()
			names.sort((a, b) => a < b)
			let rows = string[][]
			for let (_, name) in names {
				rows.push([name])
			}
			return IdeTable{columns: ["Variable"], rows: rows}
		}

		@ide(kind = IdeKind.Action, label = "Show value", confirm = "Show this variable's value? It may be a secret.", row = "ideEnvironment.Variable")
		def ideShowVariable(name string) string {
			let value = getEnv(name)
			return value is none ?? ("(not set)", value)
		}

		@ide(kind = IdeKind.Value, label = "Working folder", refresh = 5s)
		def ideWorkingDir() string {
			return workingDir()
		}
	}
}
