partial module std.services.runtime {
	use (
		std.testing
		std.time
	)

	// A command line for the system's shell: /bin/sh, or cmd.exe on Windows.
	internal def shellLine(posix string, windows string) string {
		return __os__ == "windows" ?? (windows, posix)
	}

	// A value holding a type the prelude declares.
	internal struct SizedCall {
		caller CallerLocation
	}

	check "Runtime" {
		// The service samples the program's processor use once a second, each
		// sample a share of the machine in percent; a second of work shows.
		@test()
		def TestCpuUsageSamplesEverySecond() {
			// The distribution counts every sample; the window's `count` stops at its size once
			// the program has run a minute.
			let usage = Runtime.cpuUsage()
			let before = usage.distribution().count
			let busyUntil = time.monoNs() + 1200000000
			let spins = 0
			for time.monoNs() < busyUntil {
				spins++
			}
			let deadline = time.monoNs() + 3000000000
			for usage.distribution().count == before && time.monoNs() < deadline {
				time.sleep(50ms)
			}
			assert usage.distribution().count > before
			let newest = usage.last()
			assert !(newest is none)
			return when newest is none
			let share float64 = newest
			assert share >= 0.0 && share <= 100.0
			assert share > 0.0 unless __os__ == "wasm"
		}

		@test()
		def TestRunCapturesOutputAndCode() !none {
			let ran = try Runtime.run(shellLine("printf 'one two'; exit 3", "<nul set /p =one two& exit 3"))
			assert ran.output == "one two"
			assert ran.code == 3
			return none
		}

		@test()
		def TestRunFeedsInput() !none {
			// findstr writes each line it passes with a CRLF.
			let ran = try Runtime.run(shellLine("cat", "findstr x*"), "fed through stdin")
			assert ran.output == "fed through stdin" + (__os__ == "windows" ?? ("\r\n", ""))
			assert ran.code == 0
			return none
		}

		// A command that exits early leaves the input unread; that is not a failure.
		@test()
		def TestRunSurvivesUnreadInput() !none {
			let ran = try Runtime.run("exit 0", "never read")
			assert ran.output == ""
			assert ran.code == 0
			return none
		}

		@test()
		def TestRunReportsMissingProgram() !none {
			let ran = try Runtime.run(shellLine("adm-no-such-program-xyz 2>/dev/null", "adm-no-such-program-xyz 2>nul"))
			// sh says 127; cmd.exe 9009 (Wine's 1).
			assert __os__ == "windows" ?? (ran.code != 0, ran.code == 127)
			return none
		}

		@test()
		def TestEnvironmentIsListed() !none {
			try Runtime.setEnv("ADM_RUNTIME_TEST_LISTED", "a=b")
			let all = Runtime.environment()
			assert all.hasKey("ADM_RUNTIME_TEST_LISTED") && all["ADM_RUNTIME_TEST_LISTED"] == "a=b"
			// Names come as the system spells them: Windows calls it `Path`,
			// and its names match in any case.
			let path = __os__ == "windows" ?? (all.keys().filter(k => k.upper() == "PATH"), all.keys().filter(k => k == "PATH"))
			assert path.len() == 1 && !all.hasKey("")
			let one = Runtime.getEnv("ADM_RUNTIME_TEST_LISTED")
			assert !(one is none) && one == "a=b"
			return none
		}

		// A deep size walks into a field whose type the prelude declares, by
		// the name the type's record carries: the strings it holds count.
		@test()
		def TestSizeOfWalksIntoPreludeTypes() {
			let short = SizedCall{caller: CallerLocation{fileName: "a"}}
			let long = SizedCall{caller: CallerLocation{fileName: "a".repeat(4096)}}
			assert Runtime.sizeOf(long) > Runtime.sizeOf(short) + 4000
		}

		@test()
		def TestWorkingDirIsAbsolute() {
			let dir = Runtime.workingDir()
			assert __os__ == "windows" ?? (dir[1] == ':' || dir.startsWith("\\\\"), dir.startsWith("/"))
		}
	}
}
