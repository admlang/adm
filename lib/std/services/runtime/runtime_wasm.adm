@os("wasm")
partial module std.services.runtime {
	// Opens the address in a new browser tab.
	internal def openAddress(address string) !none {
		fail "Runtime.open: the browser blocked the new tab for \"{address}\"" when __webOpen(address) == 0
		return none
	}

	@c("adm_web.h", symbol = "adm_web_open", ret = "int32_t", params = ["const char*"])
	def __webOpen(address string) int32;
}
