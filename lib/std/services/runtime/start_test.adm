partial module std.services.runtime {
	use (
		std.io
		std.os
		std.testing
	)

	// Writes `data` to the program's input and closes it.
	internal async def feed(to os.Pipe, data byte[]) !none {
		try to.write(data)
		return try to.close()
	}

	// The message `Runtime.start` fails with, "" when it started the program.
	internal def startFailure(program string, dir string) string {
		let started = Runtime.start(program, dir = dir) onerror (err error) {
			return err.message
		}
		started.kill() onerror recover none
		return ""
	}

	check "Runtime.start" {
		@test()
		def TestStartPassesArgumentsWithoutAShell() !none {
			let echo = try Runtime.start("printf", ["%s|%s", "a b", "$HOME *"])
			let out = try io.readAll(echo.output)
			assert string(out) == "a b|$HOME *"
			assert try echo.wait() == 0
			assert echo.id() > 0
			return none
		}

		@test()
		def TestInputReachesTheProgramAndClosingEndsIt() !none {
			let cat = try Runtime.start("cat")
			assert try cat.input.write("first\n".bytes()) == 6
			let buf byte[]
			buf.len(64)
			let n = try cat.output.read(buf)
			assert string(buf[:n]) == "first\n"
			try cat.input.close()
			assert !cat.input.isOpen()
			assert try cat.output.read(buf) == 0
			assert try cat.wait() == 0
			assert try cat.wait() == 0
			return none
		}

		// More than a pipe holds: the writer waits for the reader.
		@test()
		def TestLargeDataFlowsBothWays() !none {
			let data byte[]
			data.len(3000000)
			for let i in 0..data.len() {
				data[i] = byte(i % 251)
			}
			let cat = try Runtime.start("cat")
			let fed = async feed(cat.input, data)
			let back = try io.readAll(cat.output)
			try await fed
			assert back.len() == data.len()
			assert back.equals(data)
			assert try cat.wait() == 0
			return none
		}

		@test()
		def TestExitCodeIsReported() !none {
			let sh = try Runtime.start("sh", ["-c", "exit 7"])
			assert try sh.wait() == 7
			return none
		}

		@test()
		def TestEnvironmentAndFolderReachTheProgram() !none {
			let sh = try Runtime.start("sh", ["-c", "test -n \"$PATH\" && printf '%s %s' \"$ADM_START_PROBE\" \"$PWD\""], {"ADM_START_PROBE": "probe value"}, "/")
			let out = try io.readAll(sh.output)
			assert string(out) == "probe value /"
			assert try sh.wait() == 0
			return none
		}

		@test()
		def TestErrorsPipeCarriesStandardError() !none {
			let sh = try Runtime.start("sh", ["-c", "printf out; printf oops >&2"], errors = true)
			let errors = sh.errors
			assert errors is os.Pipe
			if errors is os.Pipe {
				assert string(try io.readAll(errors)) == "oops"
			}
			assert string(try io.readAll(sh.output)) == "out"
			assert try sh.wait() == 0

			let plain = try Runtime.start("true")
			assert plain.errors is none
			assert try plain.wait() == 0
			return none
		}

		@test()
		def TestMissingProgramFailsToStart() {
			let message = startFailure("adm-no-such-program-xyz", "")
			assert message.contains("adm-no-such-program-xyz")
			assert message.contains("No such file")
		}

		@test()
		def TestMissingFolderFailsToStart() {
			let message = startFailure("true", "/adm-no-such-folder-xyz")
			assert message.contains("/adm-no-such-folder-xyz")
		}

		@test()
		def TestWaitWithATimeoutAndTerminate() !none {
			let sleeper = try Runtime.start("sleep", ["30"])
			assert try sleeper.wait(50ms) is none
			try sleeper.terminate()
			assert try sleeper.wait() == 128 + 15
			try sleeper.terminate()
			try sleeper.kill()
			return none
		}

		@test()
		def TestKillStopsAProgramThatIgnoresTerminate() !none {
			let stubborn = try Runtime.start("sh", ["-c", "trap '' TERM; printf ready; sleep 30"])
			let buf byte[]
			buf.len(8)
			assert try stubborn.output.read(buf) == 5
			try stubborn.terminate()
			assert try stubborn.wait(200ms) is none
			try stubborn.kill()
			let code = try stubborn.wait(5s)
			assert code is int
			assert try stubborn.wait() == 128 + 9
			return none
		}

		// A write to a program that is gone is an error, not the end of this one.
		@test()
		def TestWriteToAnExitedProgramFails() !none {
			let gone = try Runtime.start("true")
			assert try gone.wait() == 0
			let failed = false
			gone.input.write("late".bytes()) onerror (err error) {
				failed = true
				recover 0
			}
			assert failed
			return none
		}

		@test()
		def TestManyProgramsEachEndOnTheirOwnInput() !none {
			let cats os.Process[]
			for let i in 0..8 {
				cats.push(try Runtime.start("cat"))
			}
			for let (i, cat) in cats {
				try cat.input.write("{i}".bytes())
				try cat.input.close()
				assert string(try io.readAll(cat.output)) == "{i}"
				assert try cat.wait() == 0
			}
			return none
		}
	}
}
