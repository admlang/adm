partial module std.services.runtime {
	use (
		std.io
		std.os
		std.testing
	)

	// cmd.exe's built-ins stand in for the POSIX programs start_test.adm
	// starts. Passing arguments without a shell and moving megabytes both
	// ways are checked by the runtime's own process test (proc_test.c).
	check "Runtime.start on Windows" {
		@test()
		def exitCodesComeBack() !none {
			let cmd = try Runtime.start("cmd.exe", ["/d", "/c", "exit 7"])
			assert try cmd.wait() == 7
			assert cmd.id() > 0
			return none
		}

		@test()
		def environmentAndFolderReachTheProgram() !none {
			let cmd = try Runtime.start("cmd.exe", ["/d", "/c", "echo %ADM_START_PROBE% %CD%"], {"ADM_START_PROBE": "probe value"}, "C:\\")
			let out = try io.readAll(cmd.output)
			assert string(out) == "probe value C:\\\r\n"
			assert try cmd.wait() == 0
			return none
		}

		@test()
		def errorsPipeCarriesStandardError() !none {
			let cmd = try Runtime.start("cmd.exe", ["/d", "/c", "<nul set /p =out& <nul set /p =oops>&2"], errors = true)
			let errors = cmd.errors
			assert errors is os.Pipe
			if errors is os.Pipe {
				assert string(try io.readAll(errors)) == "oops"
			}
			assert string(try io.readAll(cmd.output)) == "out"
			assert try cmd.wait() == 0
			return none
		}

		// What is written comes back once the input is closed, which ends the
		// program; several run side by side, each on its own input.
		@test()
		def inputReachesTheProgramAndClosingEndsIt() !none {
			let finds os.Process[]
			for let i in 0..4 {
				finds.push(try Runtime.start("findstr", ["x*"]))
			}
			for let (i, find) in finds {
				assert try find.input.write("{i}\n".bytes()) == 2
				try find.input.close()
				assert !find.input.isOpen()
				// findstr writes a line as it came: with its `\n`.
				assert string(try io.readAll(find.output)) == "{i}\n"
				assert try find.wait() == 0
			}
			return none
		}

		@test()
		def missingProgramAndFolderFailToStart() {
			let message = startFailure("adm-no-such-program-xyz", "")
			assert message.contains("adm-no-such-program-xyz")
			assert message.contains("No such file")
			assert startFailure("cmd.exe", "C:\\adm-no-such-folder-xyz").contains("adm-no-such-folder-xyz")
		}

		// cmd.exe reading commands from its open input runs until told to
		// stop: terminate and kill end it with the codes a shell reports for
		// SIGTERM and SIGKILL.
		@test()
		def terminateAndKillEndAProgram() !none {
			let waiting = try Runtime.start("cmd.exe", ["/d", "/q"])
			assert try waiting.wait(50ms) is none
			try waiting.terminate()
			assert try waiting.wait() == 128 + 15
			let stubborn = try Runtime.start("cmd.exe", ["/d", "/q"])
			try stubborn.kill()
			let code = try stubborn.wait(5s)
			assert code is int
			assert try stubborn.wait() == 128 + 9
			return none
		}

		@test()
		def writeToAnExitedProgramFails() !none {
			let gone = try Runtime.start("cmd.exe", ["/d", "/c", "exit 0"])
			assert try gone.wait() == 0
			let failed = false
			gone.input.write("late".bytes()) onerror (err error) {
				failed = true
				recover 0
			}
			assert failed
			return none
		}
	}
}
