partial module std.services {
	use std.testing

	check "Runtime" {
		@test()
		def TestRunCapturesOutputAndCode() !none {
			let ran = try Runtime.run("printf 'one two'; exit 3")
			assert ran.output == "one two"
			assert ran.code == 3
			return none
		}

		@test()
		def TestRunFeedsInput() !none {
			let ran = try Runtime.run("cat", "fed through stdin")
			assert ran.output == "fed through stdin"
			assert ran.code == 0
			return none
		}

		// A command that exits early leaves the input unread; that is not a failure.
		@test()
		def TestRunSurvivesUnreadInput() !none {
			let ran = try Runtime.run("exit 0", "never read")
			assert ran.output == ""
			assert ran.code == 0
			return none
		}

		@test()
		def TestRunReportsMissingProgram() !none {
			let ran = try Runtime.run("adm-no-such-program-xyz 2>/dev/null")
			assert ran.code == 127
			return none
		}

		@test()
		def TestWorkingDirIsAbsolute() {
			assert Runtime.workingDir().startsWith("/")
		}
	}
}
