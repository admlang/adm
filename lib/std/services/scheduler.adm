partial module std.services {
	use (
		std.time
		std.crypto
		std.reflection
		std.reflection::(FunctionMetaContext)
	)

	// Identifies a schedule. Every add method returns one and cancel takes one.
	type ScheduleId = string

	// How a schedule fires: on a cron expression, every interval, or once at a time.
	enum ScheduleKind {
		Cron,
		Interval,
		At,
	}

	// Describes a scheduled job managed by the Scheduler service.
	struct Schedule {
		// Unique identifier of the schedule.
		id       ScheduleId
		// Scheduling strategy used by the job.
		kind     ScheduleKind
		// Human-readable name of the schedule.
		name     string
		// Whether the schedule is currently active.
		enabled  bool
		// Execution interval for interval schedules.
		interval duration
		// Cron expression for cron schedules.
		cron     string
		// Next time the schedule is expected to run.
		nextRun  time.Time
		// Last time the schedule was triggered.
		lastRun  time.Time
	}

	// Manages scheduled jobs, recurring intervals, and delayed executions.
	service Scheduler {
		// cron jobs, timeouts, timers
		description               = ""
		dependencies              = Dependencies{
			hard: [Runtime]
		}
		lifecycle                 = Lifecycle{
			start: StartMode.Automatic,
			restart: RestartMode.Always,
		}
		permissions  Permission[]

		jobs       Schedule[]
		stopChan   channel<none>
		jobsAdded  channel<none>
		// Functions annotated with @cron, @at, @after or @runEvery, by the schedule that calls them.
		handlers   map<string, reflection.ReflectionNode>
		// Whether start has registered the annotated functions; a restart does not add them again.
		discovered bool

		// Runs the scheduler loop and triggers schedules when they become due.
		def runner() {
			for {
				// find the next schedule to run
				let idx = findNextSchedule()

				if idx == -1 {
					// No schedules → wait until something changes
					select {
						case jobsAdded:
							// schedules changed → recompute everything
							jobsAdded.flush()
						case stopChan:
							return
					}
					continue
				}

				let now = time.now()
				let next = jobs[idx].nextRun

				if next.after(now) {
					// wait until either:
					// - time reaches nextRun
					// - schedules change
					let recompute = false
					let sleep = time.sleepChan(next - now)

					select {
						case jobsAdded:
							// schedules changed → recompute everything
							jobsAdded.flush()
							recompute = true
						case stopChan:
							return
						case sleep:
						// time reached = continue bellow
					}
				}

				// emit all due schedules
				now = time.now()
				for let job in jobs {
					if job.enabled && !job.nextRun.after(now) {
						trigger(job.id)
						let handler = handlers.get(string(job.id))
						if handler is reflection.ReflectionNode {
							async reflection.call(handler, none, [])
						}
						job.lastRun = now
						match job.kind {
							case ScheduleKind.Cron:
								let following = cronNext(job.cron, now)
								match following {
									case time.Time: job.nextRun = following
									case none: job.enabled = false
								}
							case ScheduleKind.Interval:
								job.nextRun = now + job.interval
							case ScheduleKind.At:
								job.enabled = false
						}
					}
				}
			}
		}

		// Returns the next execution time for a cron expression after the specified time,
		// or none when the expression is invalid or never matches again.
		def cronNext(expr string, now time.Time) ?time.Time {
			let cron = time.parseCron(expr) onerror recover new time.Cron()
			return none when cron.source.isEmpty()
			return cron.next(now)
		}

		// Returns the index of the enabled schedule with the earliest next execution.
		//
		// Returns -1 when no enabled schedules are available.
		def findNextSchedule() int {
			let idx = -1

			for let (i, job) in jobs {
				continue unless job.enabled
				if idx == -1 || job.nextRun.before(jobs[idx].nextRun) {
					idx = i
				}
			}
			return idx
		}

		// The schedule with that id, or none.
		//
		// Returns none when no matching schedule exists.
		def findSchedule(id ScheduleId) ?Schedule {
			for let job in jobs {
				if job.id == id {
					return job
				}
			}
			return none
		}

		// Validates a cron expression.
		//
		// Cron expressions use the format:
		//
		// second minute hour day month weekday
		//
		// For example:
		// "0 0 12 * * *"
		// runs every day at 12:00.
		//
		// Predefined schedules are also supported:
		// @hourly
		// @daily
		// @midnight
		// @weekly
		// @monthly
		// @yearly
		// @annually
		//
		// Fails when the expression does not parse.
		def parseCron(expr string) !none {
			let parsed = try time.parseCron(expr)
		}

		// Starts the runner task that fires schedules. Does not fail today.
		async def start() !none {
			stopChan = new channel<none>(1)
			jobsAdded = new channel<none>(1)
			if !discovered {
				discovered = true
				for let (_, hit) in annotatedFunctions() {
					let job = annotatedSchedule(hit)
					continue when job is none
					jobs += job
					handlers[string(job.id)] = hit.node
				}
			}
			async runner()
			return none
		}

		// Stops the runner. Pending schedules do not fire. Does not fail today.
		async def stop() !none {
			stopChan <- none
			stopChan.close()
			jobsAdded.close()
			return none
		}

		// Stops the runner and starts it again. Fails when either step fails.
		async def restart() !none {
			try await stop()
			try await start()
			return none
		}

		// Adds a schedule that fires on the cron expression and returns its id.
		//
		// Fails when the expression does not parse.
		@commit()
		def cron(cronExpression string, name string = "") !ScheduleId {
			try parseCron(cronExpression)
			let job = Schedule{
				id: ScheduleId((new crypto.UUID()).str()),
				kind: ScheduleKind.Cron,
				name: name,
				cron: cronExpression,
				enabled: true,
			}
			let first = cronNext(cronExpression, time.now())
			match first {
				case time.Time: job.nextRun = first
				case none: job.enabled = false
			}
			jobs += job
			jobsAdded <- none
			return job.id
		}

		// Adds a schedule that fires once at the given time and returns its id.
		//
		// The time must be in the future.
		//
		// Fails when the time is not in the future.
		@commit()
		def runAt(timestamp time.Time, name string = "") !ScheduleId {
			expects {
				assert timestamp.after(time.now()) onerror "timestamp needs to be in the future"
			}
			let job = Schedule{
				id: ScheduleId((new crypto.UUID()).str()),
				kind: ScheduleKind.At,
				name: name,
				enabled: true,
				nextRun: timestamp,
			}
			jobs += job
			jobsAdded <- none
			return job.id
		}

		// Adds a schedule that fires once after the duration and returns its id.
		//
		// The duration must be positive.
		//
		// Fails when the duration is not positive.
		@commit()
		def runAfter(dur duration, name string = "") !ScheduleId {
			expects {
				assert int(dur) > 0 onerror "negative duration"
			}
			let job = Schedule{
				id: ScheduleId((new crypto.UUID()).str()),
				kind: ScheduleKind.At,
				name: name,
				enabled: true,
				nextRun: time.now() + dur,
			}
			jobs += job
			jobsAdded <- none
			return job.id
		}

		// Adds a schedule that fires every interval and returns its id.
		//
		// The interval must be positive.
		//
		// Fails when the interval is not positive.
		@commit()
		def runEvery(interval duration, name string = "") !ScheduleId {
			expects {
				assert int(interval) > 0 onerror "negative interval"
			}
			let job = Schedule{
				id: ScheduleId((new crypto.UUID()).str()),
				kind: ScheduleKind.Interval,
				name: name,
				interval: interval,
				enabled: true,
				nextRun: time.now() + interval,
			}
			jobs += job
			jobsAdded <- none
			return job.id
		}

		// Removes the schedule.
		//
		// Fails when there is no such schedule.
		@commit()
		def cancel(id ScheduleId) !none {
			let job = findSchedule(id)
			if job is none {
				fail "job not found"
			}
			jobs -= job
			jobsAdded <- none
			return none
		}

		// Pauses the schedule.
		//
		// Its timing is untouched; firings that fall due while it is paused are skipped.
		//
		// Fails when there is no such schedule.
		@commit()
		def pause(id ScheduleId) !none {
			let job = findSchedule(id)
			if job is none {
				fail "job not found"
			}
			job.enabled = false
			jobsAdded <- none
			return none
		}

		// Resumes a paused schedule.
		//
		// It carries on with its original timing.
		//
		// Firings skipped while it was paused are not made up.
		//
		// Fails when there is no such schedule.
		@commit()
		def resume(id ScheduleId) !none {
			let job = findSchedule(id)
			if job is none {
				fail "job not found"
			}
			job.enabled = true
			jobsAdded <- none
			return none
		}

		// Every schedule.
		@query()
		def list() Schedule[] {
			return jobs
		}

		// The schedule with that id, or none.
		@query()
		def get(id ScheduleId) ?Schedule {
			return findSchedule(id)
		}

		// When the schedule next fires; none when there is no such schedule or it is paused.
		@query()
		def next(id ScheduleId) ?time.Time {
			let job = findSchedule(id)
			return none when job is none
			return none unless job.enabled
			return job.nextRun
		}

		// Emitted when a schedule becomes due.
		//
		// The service only keeps time; an observer does the work.
		@emit()
		def trigger(id ScheduleId) ScheduleId {
			return id
		}
	}

	// Calls the function whenever the cron expression fires.
	//
	// The Scheduler registers the schedule when it starts; name defaults to the function's qualified name.
	meta def cron(target FunctionMetaContext, cronExpression string, name string = "") {
		target.invoke()
	}

	// Calls the function once, at the given time.
	//
	// The Scheduler registers the schedule when it starts; name defaults to the function's qualified name.
	meta def at(target FunctionMetaContext, timestamp time.Time, name string = "") {
		target.invoke()
	}

	// Calls the function once, after the duration.
	//
	// The duration counts from when the Scheduler starts; name defaults to the function's qualified name.
	meta def after(target FunctionMetaContext, interval duration, name string = "") {
		target.invoke()
	}

	// Calls the function every interval.
	//
	// The first call is one interval after the Scheduler starts; name defaults to the function's qualified name.
	meta def runEvery(target FunctionMetaContext, interval duration, name string = "") {
		target.invoke()
	}

	// Every function the program annotates with @cron, @at, @after or @runEvery.
	internal def annotatedFunctions() reflection.AttrHit[] {
		let hits = reflection.attrs(cron)
		hits += reflection.attrs(at)
		hits += reflection.attrs(after)
		hits += reflection.attrs(runEvery)
		return hits
	}

	// The annotation argument by parameter name or position, as its source text.
	internal def annotationArgument(hit reflection.AttrHit, name string, position int) string {
		let named = hit.attr.arguments.get(name)
		return string(named) unless named is none
		let positional = hit.attr.arguments.get("#{position}")
		return string(positional) unless positional is none
		return ""
	}

	// The schedule an annotation asks for, or none when the function takes arguments or an argument
	// does not parse.
	internal def annotatedSchedule(hit reflection.AttrHit) ?Schedule {
		return none unless hit.node.signature.startsWith("()")
		let name = annotationArgument(hit, "name", 1)
		if name.isEmpty() {
			name = hit.node.qualifiedName
		}
		let job = Schedule{
			id: ScheduleId((new crypto.UUID()).str()),
			name: name,
			enabled: true,
		}
		let now = time.now()
		match hit.attr.name {
			case "std.services.cron":
				let expr = annotationArgument(hit, "cronExpression", 0)
				let cron = time.parseCron(expr) onerror return none
				let following = cron.next(now)
				return none when following is none
				job.kind = ScheduleKind.Cron
				job.cron = expr
				job.nextRun = following
			case "std.services.at":
				let timestamp = time.parse(annotationArgument(hit, "timestamp", 0)) onerror return none
				job.kind = ScheduleKind.At
				job.nextRun = timestamp
			case "std.services.after":
				let interval = time.parseDuration(annotationArgument(hit, "interval", 0)) onerror return none
				job.kind = ScheduleKind.At
				job.nextRun = now + interval
			case "std.services.runEvery":
				let interval = time.parseDuration(annotationArgument(hit, "interval", 0)) onerror return none
				return none unless int(interval) > 0
				job.kind = ScheduleKind.Interval
				job.interval = interval
				job.nextRun = now + interval
			default:
				return none
		}
		return job
	}
}
