// The Scheduler service's IDE panel: the schedules with their next and last
// runs, and the buttons that pause, resume, cancel and run one now.

partial module std.services.scheduler {
	use std.ide::(ide, IdeKind, IdeTable)

	partial service Scheduler {
		@ide(kind = IdeKind.Table, label = "Schedules", refresh = 1s, rows = 0)
		def ideSchedules() IdeTable {
			let rows = string[][]
			for let (_, job) in list() {
				let timing = job.kind == ScheduleKind.Cron ?? (job.cron, job.kind == ScheduleKind.Interval ?? ("every {job.interval}", "once"))
				rows.push([job.id, job.name, timing, job.enabled ?? ("active", "paused"), "{job.nextRun}", "{job.lastRun}"])
			}
			return IdeTable{columns: ["Id", "Name", "When", "State", "Next run", "Last run"], rows: rows}
		}

		@ide(kind = IdeKind.Action, label = "Pause", row = "ideSchedules.Id")
		def idePause(id string) !none {
			return pause(id)
		}

		@ide(kind = IdeKind.Action, label = "Resume", row = "ideSchedules.Id")
		def ideResume(id string) !none {
			return resume(id)
		}

		@ide(kind = IdeKind.Action, label = "Cancel", confirm = "Cancel this schedule?", row = "ideSchedules.Id")
		def ideCancel(id string) !none {
			return cancel(id)
		}

		// Runs a schedule now, leaving its next run where it was.
		@ide(kind = IdeKind.Action, label = "Run now", row = "ideSchedules.Id")
		def ideRunNow(id string) !none {
			fail "no schedule {id}" when findSchedule(id) is none
			fire(id)
			return none
		}
	}
}
