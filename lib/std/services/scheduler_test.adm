partial module std.services {
	use (
		std.testing
		std.time
	)

	type ASD {
		@on(Scheduler.trigger)
		def tmp(evt Event<ScheduleId>) {
			println("from ASD {self} {evt}")
		}
	}

	// Names of the annotated functions as the Scheduler calls them.
	internal let annotatedCalls = new channel<string>(64)

	@runEvery(100ms)
	internal def everyTick() {
		annotatedCalls <- "every"
	}

	@after(50ms, "scheduler.test.after")
	internal def afterTick() {
		annotatedCalls <- "after"
	}

	// Waits up to a second for the next annotated call; empty on timeout.
	internal def nextAnnotatedCall() string {
		let timeout = time.sleepChan(1s)
		select {
			case annotatedCalls:
				return <- annotatedCalls
			case timeout:
				return ""
		}
		return ""
	}

	check "Scheduler annotations" {
		@test()
		def annotatedFunctionsRun() !none {
		    new ASD()
			let names = Scheduler.list().mapElem(def(job Schedule) string {return job.name})
			try testing.expectTrue(names.includes("scheduler.test.after"), "@after registered under its name")
			try testing.expectTrue(names.includes("std.services.everyTick"), "@runEvery named after its function")
			let after = 0
			let repeated = 0
			for let _ in 0..5 {
				let name = nextAnnotatedCall()
				try testing.expectFalse(name.isEmpty(), "an annotated function ran")
				if name == "after" {
					after += 1
				} else {
					repeated += 1
				}
			}
			try testing.expectEqual(1, after)
			try testing.expectEqual(4, repeated)
		}
	}
}
