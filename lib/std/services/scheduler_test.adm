partial module std.services {
	use (
		std.testing
		std.time
	)

	type ASD {
		@on(Scheduler.trigger)
		def tmp(evt Event<ScheduleId>) {
			println("from ASD")
		}
	}

	check "Scheduler service" {
		@on(Scheduler.trigger)
		def logger(evt Event<ScheduleId>) {
			println("running", evt.result)
		}

		@test()
		def timer() !none {
			let id = try Scheduler.runEvery(500ms, "my.job")
			println("scheduling", string(id))
			let _ = new ASD()
			time.sleep(2s)
			try Scheduler.cancel(id)
		}
	}
}
