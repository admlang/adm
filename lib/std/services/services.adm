partial module std.services {
	use std.time

	// Where a service is in its lifecycle, as ServiceInfo and ServiceStatusChange report it.
	enum ServiceStatus {
		Unknown = "unknown",
		Starting = "starting",
		Started = "started",
		Stopping = "stopping",
		Stopped = "stopped",
		Restarting = "restarting",
		Failed = "failed",
	}

	// When the service manager starts a service: with the application, or only when asked.
	enum StartMode {
		Automatic,
		Manual,
	}

	// Whether the service manager brings a stopped service back: never, after a failure, or
	// always.
	enum RestartMode {
		Never,
		OnFailure,
		Always
	}

	// How a service is started and restarted. Every service declares one.
	struct Lifecycle {
		start   StartMode
		restart RestartMode
	}

	// The services a service needs before it starts.
	//
	// Hard dependencies must exist and start first; soft ones are used when present.
	struct Dependencies {
		// must exist
		hard service[]
		// optional, feature-gated
		soft service[]
	}

	// A service's name, status, start time and restart count, as the service manager
	// reports them.
	struct ServiceInfo {
		name         string
		status       ServiceStatus
		startTime    ?time.Time
		restartCount int
	}

	// A service's status transition, carried by the runtime's status change event.
	struct ServiceStatusChange {
		svc       service
		oldStatus ServiceStatus
		newStatus ServiceStatus
	}
}
