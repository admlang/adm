partial module std.services {
	use std.time

	enum ServiceStatus {
		Unknown = "unknown",
		Starting = "starting",
		Started = "started",
		Stopping = "stopping",
		Stopped = "stopped",
		Restarting = "restarting",
		Failed = "failed",
	}

	enum StartMode {
		Automatic,
		Manual,
	}

	enum RestartMode {
		Never,
		OnFailure,
		Always
	}

	struct Lifecycle {
		start   StartMode
		restart RestartMode
	}

	struct Dependencies {
		// must exist
		hard service[]
		// optional, feature-gated
		soft service[]
	}

	struct ServiceInfo {
		name         string
		status       ServiceStatus
		startTime    ?time.Time
		restartCount int
	}

	struct ServiceStatusChange {
		svc       service
		oldStatus ServiceStatus
		newStatus ServiceStatus
	}
}
