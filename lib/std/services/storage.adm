partial module std.services {
	// Storage service is the interface for interacting with permanent storage.
	service Storage {
		use (
			std.os
			std.bytes
			std.metrics
			std.time
		)

		description  = ""
		dependencies = Dependencies{
			hard: [Diagnostics, Policy]
		}

		lifecycle            = Lifecycle{
			start: StartMode.Automatic,
			restart: RestartMode.Always,
		}
		permissions string[]

		@metric("service.storage.opened_files")
		openedFilesMetric metrics.Gauge
		@metric("service.storage.read.total")
		bytesReadMetric metrics.Counter
		@metric("service.storage.write.total")
		bytesWrittenMetric metrics.Counter

		async def start() !none {
		    status = ServiceStatus.Started
			return none
		}

		async def stop() !none {
		    status = ServiceStatus.Stopped
			return none
		}

		async def restart() !none {
		    status = ServiceStatus.Restarting
		    stop()
		    start()
			return none
		}

		// Open a file or folder at the given path with the specified mode.
		@commit()
		def open(path string, mode string) !int {
			let fd = try __fs_open(path, mode)
			fileOpened(path)
			openedFilesMetric.inc()
			return fd
		}

		// Emitted after a file is opened.
		@emit()
		def fileOpened(path string) string {
			return path
		}

		// Closes an open file handle.
		@commit()
		def close(fd int) !none {
			try __fs_close(fd)
			openedFilesMetric.dec()
			return none
		}

		// Writes bytes at the handle's current position and returns how many were written.
		@commit()
		def write(fd int, data byte[]) !int {
			let n = try __fs_write(fd, data)
			bytesWrittenMetric.update(n)
			return n
		}

		// Reads into the buffer from the handle's current position and returns how many bytes were read.
		@commit()
		def read(fd int, data byte[]) !int {
			let n = try __fs_read(fd, data)
			bytesReadMetric.update(n)
			return n
		}

		// Reads a whole file into memory.
		@commit()
		def readFile(path string) !byte[] {
			let out = try __fs_read_all(path)
			bytesReadMetric.update(out.len())
			return out
		}

		// Writes the bytes to a file, replacing any existing content.
		@commit()
		def writeFile(path string, data byte[]) !none {
			try __fs_write_all(path, data)
			bytesWrittenMetric.update(data.len())
			return none
		}

		// Moves the handle's position and returns the new absolute offset.
		//
		// Whence follows the Whence enum: start, current, or end.
		@commit()
		def seek(fd int, offset int64, whence int) !int64 {
			return __fs_seek(fd, offset, whence)
		}

		// Reads into the buffer starting at an absolute offset, leaving the handle's position unchanged.
		@commit()
		def readAt(fd int, data byte[], offset int64) !int {
			let n = try __fs_read_at(fd, data, offset)
			bytesReadMetric.update(n)
			return n
		}

		// Writes bytes at an absolute offset, leaving the handle's position unchanged.
		@commit()
		def writeAt(fd int, data byte[], offset int64) !int {
			let n = try __fs_write_at(fd, data, offset)
			bytesWrittenMetric.update(n)
			return n
		}

		// Resizes the file to the given size, padding with zero bytes when it grows.
		@commit()
		def truncate(fd int, size int64) !none {
			return __fs_ftruncate(fd, size)
		}

		// Returns whether a file or directory exists at the path.
		@commit()
		def exists(path string) !bool {
			return __fs_exists(path)
		}

		// Removes a file.
		@commit()
		def remove(path string) !none {
			const val = __fs_remove(path) onerror recover none
			return val
		}

		// Renames or moves a file or directory.
		@commit()
		def rename(oldPath string, newPath string) !none {
			const val = __fs_rename(oldPath, newPath) onerror recover none
			return val
		}

		// Creates a directory, including any missing parents.
		@commit()
		def mkdir(path string) !none {
			const val = __fs_mkdir(path) onerror recover none
			return val
		}

		// Removes an empty directory.
		@commit()
		def rmdir(path string) !none {
			const val = __fs_rmdir(path) onerror recover none
			return val
		}

		internal def joinPath(dir string, name string) string {
			return name when dir.len() == 0
			let last = dir[dir.len() - 1]
			if last == '/' || last == '\\' {
				return dir + name
			}
			return dir + os.SEPARATOR + name
		}

		// Lists the entries of a directory.
		//
		// Depth 0 lists the directory itself; a larger depth descends that many levels.
		@query()
		def readDir(path string, depth int = 0) !os.DirEntry[] {
			let out os.DirEntry[]
			let stack (string, int)[]
			stack.push((path, 0))

			for stack.len() > 0 {
				let (dir, level) = stack.pop()
				let names = try __fs_read_dir(dir)

				for let (_, name) in names {
					let childPath = joinPath(dir, name)
					let (size, mode, isDir, mtimeNs) = try __fs_stat(childPath)
					let info = os.FileInfo{
						name:    name,
						size:    size,
						mode:    os.FileMode(mode),
						isDir:   isDir,
						modTime: time.fromUnixNs(mtimeNs),
					}
					out.push(os.DirEntry{path: childPath, info: info})

					let canDescend = isDir && depth != 0 && (depth < 0 || (level + 1) <= depth)
					if canDescend {
						stack.push((childPath, level + 1))
					}
				}
			}
			return out
		}

		// Delete a file or a folder at the given path
		@commit()
		def delete(path string) !none {
			return __fs_remove(path)
		}

		// Returns size, mode, and timestamps for a path.
		@query()
		def stat(path string) !os.FileInfo {
			let (size, mode, isDir, mtimeNs) = try __fs_stat(path)
			return os.FileInfo{
				name:    os.base(path),
				size:    size,
				mode:    os.FileMode(mode),
				isDir:   isDir,
				modTime: time.fromUnixNs(mtimeNs),
			}
		}

		// Return a list of opened file descriptors.
		@query()
		def openedFiles() {}

		// Changes a file's permission bits.
		@commit()
		def chmod(file string, mode int64) !none {
			return __fs_chmod(file, mode)
		}

		// Return read/write metrics for a file descriptor if a fd is provided or for all if not
		@query()
		def metrics(fd ?int) {}

		// Get the free space on a specific disk.
		@query()
		def freeSpace(disk string) {}

		// List of all available disks.
		@query()
		def disks() {}
	}
	/*
	
	own:
	    files
	    directories
	    file descriptors
	    mounts/disks
	    disk usage
	    watchers
	    temporary files
	    atomic writes
	    locks
	
	    @embed("./assets/logo.png")
	    const logo bytes
	
	*/
}
