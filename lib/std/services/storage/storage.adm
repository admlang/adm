partial module std.services.storage {
	// How a mapping sees the file.
	enum MapAccess {
		// Shared, read-only.
		Read,
		// Shared, writes reach the file.
		ReadWrite,
		// Private copy-on-write: writes stay in memory.
		Copy,
	}

	// Storage service is the interface for interacting with permanent storage.
	service Storage {
		use (
			std.services::(Application, Dependencies, Lifecycle, RestartMode, ServiceStatus, StartMode)
			std.services.policy::(Path, PathSpec, Policy)
			std.services.diagnostics::(Diagnostics, metric)
			std.os
			std.metrics
			std.time
		)

		description  = ""
		dependencies = Dependencies{
			hard: [Diagnostics, Policy, Application]
		}

		lifecycle   = Lifecycle{
			start: StartMode.Automatic,
			restart: RestartMode.Always,
		}
		permissions = [
			Permission{name: "read", description: "Read files and list directories", spec: PathSpec},
			Permission{name: "write", description: "Create, change and delete files", spec: PathSpec},
		]

		@metric("service.storage.opened_files")
		openedFilesMetric metrics.Gauge
		@metric("service.storage.read.total")
		bytesReadMetric metrics.Counter
		@metric("service.storage.write.total")
		bytesWrittenMetric metrics.Counter

		// Starts the service. Does not fail today.
		async def start() !none {
			status = ServiceStatus.Started
			return none
		}

		// Stops the service. Does not fail today.
		async def stop() !none {
			status = ServiceStatus.Stopped
			return none
		}

		// Stops the service and starts it again. Does not fail today.
		async def restart() !none {
			status = ServiceStatus.Restarting
			stop()
			start()
			return none
		}

		// Open a file or folder at the given path with the specified mode.
		//
		// Fails when the policy denies the path or the operating system cannot open it.
		@commit(policy = "read")
		def open(path Path, mode string) !int {
			let target = try at(path.value())
			let fd = try __fs_open(target, mode)
			fileOpened(target)
			openedFilesMetric.inc()
			return fd
		}

		// Emitted after a file is opened.
		@emit()
		def fileOpened(path string) string {
			return path
		}

		// Closes an open file handle.
		//
		// Fails when fd is not an open handle.
		@commit()
		def close(fd int) !none {
			try __fs_close(fd)
			openedFilesMetric.dec()
			return none
		}

		// Writes bytes at the handle's current position and returns how many were written.
		//
		// Fails when fd is not an open handle or the operating system refuses.
		@commit()
		def write(fd int, data byte[]) !int {
			let n = try __fs_write(fd, data)
			bytesWrittenMetric.update(n)
			return n
		}

		// Reads into the buffer from the handle's current position and returns how many bytes were read.
		//
		// Fails when fd is not an open handle or the operating system refuses.
		@commit()
		def read(fd int, data byte[]) !int {
			let n = try __fs_read(fd, data)
			bytesReadMetric.update(n)
			return n
		}

		// Reads a whole file into memory.
		//
		// Fails when the policy denies the path or the operating system refuses.
		@commit(policy = "read")
		def readFile(path Path) !byte[] {
			let out = try __fs_read_all(try at(path.value()))
			bytesReadMetric.update(out.len())
			return out
		}

		// Writes the bytes to a file, replacing any existing content.
		//
		// Fails when the policy denies the path or the operating system refuses.
		@commit(policy = "write")
		def writeFile(path Path, data byte[]) !none {
			try __fs_write_all(try at(path.value()), data)
			bytesWrittenMetric.update(data.len())
			return none
		}

		// Moves the handle's position and returns the new absolute offset.
		//
		// Whence follows the Whence enum: start, current, or end.
		//
		// Fails when fd is not an open handle or the operating system refuses.
		@commit()
		def seek(fd int, offset int64, whence int) !int64 {
			return __fs_seek(fd, offset, whence)
		}

		// Reads into the buffer starting at an absolute offset, leaving the handle's position unchanged.
		//
		// Fails when fd is not an open handle or the operating system refuses.
		@commit()
		def readAt(fd int, data byte[], offset int64) !int {
			let n = try __fs_read_at(fd, data, offset)
			bytesReadMetric.update(n)
			return n
		}

		// Writes bytes at an absolute offset, leaving the handle's position unchanged.
		//
		// Fails when fd is not an open handle or the operating system refuses.
		@commit()
		def writeAt(fd int, data byte[], offset int64) !int {
			let n = try __fs_write_at(fd, data, offset)
			bytesWrittenMetric.update(n)
			return n
		}

		// Resizes the file to the given size, padding with zero bytes when it grows.
		//
		// Fails when fd is not an open handle or the operating system refuses.
		@commit()
		def truncate(fd int, size int64) !none {
			return __fs_ftruncate(fd, size)
		}

		// Pushes what was written to the file through to the storage device, so it survives a
		// crash or a power cut. With dataOnly the content alone, without the file's times.
		//
		// Fails when fd is not an open handle or the device reports a write error.
		@query()
		def sync(fd int, dataOnly bool = false) !none {
			return __fs_sync(fd, dataOnly)
		}

		// Takes an advisory lock on the whole file: exclusive, or shared with other shared
		// holders. It binds programs that ask for it and nothing else. With wait it returns
		// once the lock is held; without, false when someone else holds it.
		//
		// Fails when fd is not an open handle or the file system has no locks.
		@query()
		def lock(fd int, exclusive bool = true, wait bool = true) !bool {
			return __fs_lock(fd, exclusive ?? (2, 1), wait)
		}

		// Gives up the lock `lock` took.
		//
		// Fails when fd is not an open handle.
		@query()
		def unlock(fd int) !none {
			try __fs_lock(fd, 0, false)
			return none
		}

		// Maps length bytes of the open descriptor from offset into memory and returns a mapping
		// handle; length 0 maps to the end of the file.
		//
		// A device node reports no size, so a caller mapping one passes the length itself.
		//
		// Fails when the descriptor cannot be mapped.
		@commit()
		def mmap(fd int, offset int = 0, length int = 0, access MapAccess = MapAccess.Read) !int {
			return __mem_map(fd, offset, length, int(access))
		}

		// The mapped bytes from offset.
		//
		// Fails when the range leaves the mapping.
		@commit()
		def mmapRead(handle int, offset int, length int) !byte[] {
			let out = try __mem_map_read(handle, offset, length)
			bytesReadMetric.update(out.len())
			return out
		}

		// Writes into the mapping at offset.
		//
		// Fails on a read-only mapping or a range that leaves it.
		@commit()
		def mmapWrite(handle int, offset int, data byte[]) !none {
			try __mem_map_write(handle, offset, data)
			bytesWrittenMetric.update(data.len())
			return none
		}

		// Bytes in the mapping, 0 for an unknown handle.
		@query()
		def mmapLength(handle int) int {
			return __mem_map_length(handle)
		}

		// Pushes a shared mapping's changes to the file.
		//
		// Fails when the handle is not a mapping.
		@commit()
		def mmapFlush(handle int) !none {
			return __mem_map_flush(handle)
		}

		// Releases the mapping.
		//
		// Fails when the handle is not a mapping.
		@commit()
		def munmap(handle int) !none {
			return __mem_unmap(handle)
		}

		// Sends a driver request on the descriptor with data as its argument, which the driver may
		// write back; returns the buffer as it is afterwards.
		//
		// Fails when the driver refuses.
		@commit()
		def control(fd int, request int, data byte[]) !byte[] {
			try __fs_ioctl(fd, request, data)
			return data
		}

		// Waits until the descriptor is readable, or writable when `write` is true, or the timeout
		// passes; true when it is ready.
		//
		// A query, not a commit: the wait must not hold the service's lock while it lasts.
		//
		// Fails when the descriptor cannot be waited on.
		@query()
		def wait(fd int, timeout duration, write bool = false) !bool {
			return __fs_wait(fd, timeout, write)
		}

		// Returns whether a file or directory exists at the path.
		//
		// Fails when the policy denies the path or the operating system refuses.
		@commit(policy = "read")
		def exists(path Path) !bool {
			return __fs_exists(try at(path.value()))
		}

		// Removes a file.
		//
		// Fails when the policy denies the path or the operating system refuses.
		@commit(policy = "write")
		def remove(path Path) !none {
			return __fs_remove(try at(path.value()))
		}

		// Renames or moves a file or directory.
		//
		// Fails when the policy denies the path or the operating system refuses.
		@commit(policy = "write")
		def rename(oldPath Path, newPath Path) !none {
			return __fs_rename(try at(oldPath.value()), try at(newPath.value()))
		}

		// Creates a directory.
		//
		// Fails when the policy denies the path, the directory exists or its
		// parent is missing.
		@commit(policy = "write")
		def mkdir(path Path) !none {
			return __fs_mkdir(try at(path.value()))
		}

		// Removes an empty directory.
		//
		// Fails when the policy denies the path or the operating system refuses.
		@commit(policy = "write")
		def rmdir(path Path) !none {
			return __fs_rmdir(try at(path.value()))
		}

		// The file system path behind a Path: a `package://` or
		// `namespace:name://` path resolves to the package's shipped files.
		//
		// Fails when the path names a package without shipped files.
		def at(path string) !string {
			return Application.filePath(path)
		}

		// Returns the user's home folder: `HOME`, or `USERPROFILE` on
		// Windows.
		//
		// Fails when the environment names none.
		@query()
		def homeDir() !string {
			let name = __os__ == "windows" ?? ("USERPROFILE", "HOME")
			let home = __env_get(name)
			fail "the user's home folder is not known: {name} is not set" when home is none || home == ""
			return home
		}

		// Returns the absolute path a path names, in its shortest form: `~`
		// and `~/...` start at the user's home folder, a relative path at
		// the working directory, and a package path (`package://...`) is
		// the file the package shipped, as `at` gives it.
		//
		// Fails when the path starts with `~` and no home folder is known,
		// or names a package without shipped files.
		@query()
		def resolve(path string) !string {
			let target = path
			if target == "~" || target.startsWith("~/") || target.startsWith("~" + os.SEPARATOR) {
				target = (try homeDir()) + target[1:]
			} else {
				target = try at(target)
			}
			target = joinPath(__proc_working_dir(), target) when target == "" || !os.isAbs(target)
			return os.clean(target)
		}

		def joinPath(dir string, name string) string {
			return name when dir.len() == 0
			let last = dir[dir.len() - 1]
			if last == '/' || last == '\\' {
				return dir + name
			}
			return dir + os.SEPARATOR + name
		}

		// Lists the entries of a directory.
		//
		// Depth 0 lists the directory itself; a larger depth descends that many levels.
		// A symbolic link is listed with what it points at (size, `isDir`,
		// times) and the `Symlink` bit set in its mode; a link whose target
		// is gone is listed as the link itself. Links are never descended into.
		//
		// Fails when the policy denies the path or the operating system refuses.
		@query(policy = "read")
		def readDir(path Path, depth int = 0) !os.DirEntry[] {
			let out os.DirEntry[]
			let stack (string, int)[]
			stack.push((try at(path.value()), 0))

			for stack.len() > 0 {
				let (dir, level) = stack.pop()
				let names = try __fs_read_dir(dir)

				for let (_, name) in names {
					let childPath = joinPath(dir, name)
					let info = try entryInfo(childPath, name)
					out.push(os.DirEntry{path: childPath, info: info})

					let linked = int(info.mode) & int(os.FileMode.Symlink) != 0
					let canDescend = info.isDir && !linked && depth != 0 && (depth < 0 || (level + 1) <= depth)
					if canDescend {
						stack.push((childPath, level + 1))
					}
				}
			}
			return out
		}

		// Delete a file or a folder at the given path
		//
		// Fails when the policy denies the path or the operating system refuses.
		@commit(policy = "write")
		def delete(path Path) !none {
			return __fs_remove(try at(path.value()))
		}

		// Returns size, mode, and timestamps for a path. A symbolic link is
		// followed to what it points at; with `followLinks` off the link
		// itself is described, its mode carrying the `Symlink` bit.
		//
		// Fails when the policy denies the path or the operating system refuses.
		@query(policy = "read")
		def stat(path Path, followLinks bool = true) !os.FileInfo {
			let target = try at(path.value())
			let (size, mode, isDir, mtimeNs) = try (followLinks ?? (__fs_stat(target), __fs_lstat(target)))
			return os.FileInfo{
				name:    os.base(target),
				size:    size,
				mode:    os.fromUnixMode(int(mode)),
				isDir:   isDir,
				modTime: time.fromUnixNs(mtimeNs),
			}
		}

		// What `readDir` reports for one entry.
		def entryInfo(path string, name string) !os.FileInfo {
			let (size, mode, isDir, mtimeNs) = try __fs_lstat(path)
			let kind = os.fromUnixMode(int(mode))
			if int(kind) & int(os.FileMode.Symlink) != 0 {
				// A link whose target is gone keeps the link's own numbers.
				let followed = __fs_stat(path) onerror recover (size, mode, false, mtimeNs)
				let (targetSize, targetMode, targetIsDir, targetTime) = followed
				size = targetSize
				isDir = targetIsDir
				mtimeNs = targetTime
				kind = os.FileMode(int(os.fromUnixMode(int(targetMode))) | int(os.FileMode.Symlink))
			}
			return os.FileInfo{
				name:    name,
				size:    size,
				mode:    kind,
				isDir:   isDir,
				modTime: time.fromUnixNs(mtimeNs),
			}
		}

		// Creates a symbolic link at `link` that holds `target` as written: a
		// relative target is relative to the link's folder, and the target
		// need not exist.
		//
		// Fails when the policy denies the link's path, something is at that
		// path already or the operating system refuses.
		@commit(policy = "write")
		def symlink(target string, link Path) !none {
			return __fs_symlink(target, try at(link.value()))
		}

		// Returns the target a symbolic link holds, as written in the link: a
		// relative target is relative to the link's folder and is not resolved.
		//
		// Fails when the policy denies the path, the path is not a link or the
		// operating system refuses.
		@query(policy = "read")
		def readLink(path Path) !string {
			return __fs_read_link(try at(path.value()))
		}

		// Return a list of opened file descriptors.
		@query()
		def openedFiles() {}

		// Changes a file's permission bits.
		//
		// Fails when the policy denies the path or the operating system refuses.
		@commit(policy = "write")
		def chmod(file Path, mode int64) !none {
			return __fs_chmod(try at(file.value()), mode)
		}

		// Sets a file's modification time; the access time is left as it is.
		//
		// Fails when the policy denies the path or the operating system refuses.
		@commit(policy = "write")
		def touch(file Path, modified time.Time) !none {
			return __fs_touch(try at(file.value()), modified.unixNs())
		}

		// Return read/write metrics for a file descriptor if a fd is provided or for all if not
		@query()
		def metrics(fd ?int) {}

		// The bytes still free for the program on the disk that holds the
		// path (the file system it is on).
		//
		// Fails when the policy denies the path or the operating system refuses.
		@query(policy = "read")
		def freeSpace(disk Path) !int64 {
			let (free, total) = try __fs_free_space(try at(disk.value()))
			return free
		}

		// The size in bytes of the disk that holds the path.
		//
		// Fails when the policy denies the path or the operating system refuses.
		@query(policy = "read")
		def totalSpace(disk Path) !int64 {
			let (free, total) = try __fs_free_space(try at(disk.value()))
			return total
		}

		// Opens a watcher: a descriptor that `wait` reports readable when
		// something changed under a path added to it with `watchAdd`. Close
		// it with `watchClose`. `std.os.watch` is the convenient form.
		//
		// Fails when the operating system has no watchers left or cannot
		// watch files at all (only Linux can today).
		@commit()
		def watchOpen() !int {
			return __fs_watch_open()
		}

		// Closes a watcher and ends its watches.
		//
		// Fails when the descriptor is not a watcher.
		@commit()
		def watchClose(watcher int) !none {
			return __fs_watch_close(watcher)
		}

		// Watches a file, or the entries of a directory (not those of the
		// directories in it), and returns the watch's number.
		//
		// Fails when the policy denies the path or the operating system refuses.
		@commit(policy = "read")
		def watchAdd(watcher int, path Path) !int {
			return __fs_watch_add(watcher, try at(path.value()))
		}

		// Ends one watch of a watcher.
		//
		// Fails when the watcher has no such watch.
		@commit()
		def watchRemove(watcher int, watch int) !none {
			return __fs_watch_remove(watcher, watch)
		}

		// The next change a watcher holds: the number of the watch it belongs
		// to (-1 when none is ready), the change bits and the entry's name in
		// the watched directory (empty for the watched path itself). The bits:
		// 1 created, 2 removed, 4 written, 8 moved away, 16 moved in,
		// 32 attributes changed, 64 the entry is a directory, 128 changes
		// were lost, 256 the watch ended.
		//
		// Fails when the descriptor is not a watcher.
		@query()
		def watchNext(watcher int) !(int, int64, string) {
			return __fs_watch_next(watcher)
		}

		// List of all available disks.
		@query()
		def disks() {}
	}
	/*
	
	own:
	    files
	    directories
	    file descriptors
	    mounts/disks
	    disk usage
	    watchers
	    temporary files
	    atomic writes
	    locks
	
	    @embed("./assets/logo.png")
	    const logo bytes
	
	*/
}
