partial module std.services.storage {
	use std.time

	// How a mapping sees the file.
	enum MapAccess {
		// Shared, read-only.
		Read,
		// Shared, writes reach the file.
		ReadWrite,
		// Private copy-on-write: writes stay in memory.
		Copy,
	}

	// What a test can make the Storage do (`Storage.lab.conditions`). The
	// defaults change nothing.
	struct StorageConditions {
		// Every change fails as on a read-only file system (`EROFS`): writing,
		// creating, removing, renaming, opening a file to write it.
		readOnly bool = false

		// The bytes the disk still has: writes use them up and fail with
		// `ENOSPC` when one does not fit, and `freeSpace` answers this number.
		freeSpace ?int64 = none

		// The most bytes one `read` or `write` moves, as a slow device does: a
		// caller that expects its whole buffer in one call sees it is wrong.
		chunk int = 0

		// The share of reads that come back with one bit flipped.
		corruptReads float = 0.0

		// Paths that look absent, as a glob over the whole path with `/`
		// between its elements on every system (`"*/settings.json"`): finding, opening and reading them fails with
		// `ENOENT`, and `exists` says no.
		missing string = ""

		// How fast reads and writes move data, in bytes per second: each call
		// takes the time its bytes need. 0 is as fast as the disk.
		bytesPerSecond int = 0
	}

	// A mounted file system that holds files: a disk, a partition, a
	// network share (`Storage.disks`).
	struct Disk {
		// What is mounted: the device (`/dev/nvme0n1p2`), the share
		// (`server:/export`), or on Windows the drive itself (`C:\`).
		device     string
		// Where its files appear (`/`, `/home`, `C:\`).
		mountPoint string
		// The file system's type as the operating system names it (`ext4`,
		// `apfs`, `NTFS`, `nfs4`).
		fileSystem string
		// Mounted read-only.
		readOnly   bool
		// Its files live on another machine.
		network    bool
	}

	// What reads and writes moved through the Storage service: the calls,
	// and the bytes each way (`Storage.metrics`).
	struct FileMetrics {
		reads        int64 = 0
		writes       int64 = 0
		bytesRead    int64 = 0
		bytesWritten int64 = 0
	}

	// A file the Storage service opened and has not closed
	// (`Storage.openedFiles`).
	struct OpenedFile {
		fd      int
		// The path it was opened at, resolved; for a memory file the name
		// it was given.
		path    string
		// The mode `open` was given; "" for a memory file.
		mode    string
		// A memory file (`Storage.memoryFile`), with no path on disk.
		memory  bool
		opened  time.Time
		// Its reads and writes so far.
		metrics FileMetrics
	}

	// The files the Storage service has open, and the reads and writes of
	// every file since the service started. Its methods take its lock, so
	// a `@query` reads it while a `@commit` changes it.
	internal type FileTable {
		files map<int, OpenedFile> = {}
		total FileMetrics          = FileMetrics{}

		atomic def opened(fd int, path string, mode string, memory bool) {
			files[fd] = OpenedFile{fd: fd, path: path, mode: mode, memory: memory, opened: time.now(), metrics: FileMetrics{}}
		}

		atomic def closed(fd int) {
			files.delete(fd)
		}

		// Counts a read of `n` bytes, of the open file `fd` when it is one
		// (-1 for none).
		atomic def read(fd int, n int) {
			total.reads += 1
			total.bytesRead += int64(n)
			let file = files.get(fd)
			return when file is none
			file.metrics.reads += 1
			file.metrics.bytesRead += int64(n)
		}

		// Counts a write of `n` bytes, as `read` does.
		atomic def wrote(fd int, n int) {
			total.writes += 1
			total.bytesWritten += int64(n)
			let file = files.get(fd)
			return when file is none
			file.metrics.writes += 1
			file.metrics.bytesWritten += int64(n)
		}

		// Copies, ordered by descriptor, that later calls leave as they are.
		atomic def list() OpenedFile[] {
			let out OpenedFile[] = []
			for let (_, file) in files {
				out.push(OpenedFile{fd: file.fd, path: file.path, mode: file.mode, memory: file.memory, opened: file.opened, metrics: copyOf(file.metrics)})
			}
			out.sort((a, b) => a.fd < b.fd)
			return out
		}

		// The metrics of the open file `fd`, or every file's when `fd` is
		// none; none when `fd` is not open here.
		atomic def metricsOf(fd ?int) ?FileMetrics {
			return copyOf(total) when fd is none
			let file = files.get(fd)
			return none when file is none
			return copyOf(file.metrics)
		}

		def copyOf(m FileMetrics) FileMetrics {
			return FileMetrics{reads: m.reads, writes: m.writes, bytesRead: m.bytesRead, bytesWritten: m.bytesWritten}
		}
	}

	// Storage service is the interface for interacting with permanent storage.
	service Storage {
		use (
			std.services::(Application, Dependencies, Lifecycle, RestartMode, ServiceStatus, StartMode)
			std.services.policy::(Path, PathSpec, Policy)
			std.services.diagnostics::(Diagnostics, metric)
			std.os
			std.metrics
			std.time
			std.glob::(Glob)
		)

		description  = ""
		dependencies = Dependencies{
			hard: [Diagnostics, Policy, Application]
		}

		lifecycle   = Lifecycle{
			start: StartMode.Automatic,
			restart: RestartMode.Always,
		}
		permissions = [
			Permission{name: "read", description: "Read files and list directories", spec: PathSpec},
			Permission{name: "write", description: "Create, change and delete files", spec: PathSpec},
		]

		lab = new ServiceLab<StorageConditions>()

		@metric("service.storage.opened_files")
		openedFilesMetric metrics.Gauge
		@metric("service.storage.read.total")
		bytesReadMetric metrics.Counter
		@metric("service.storage.write.total")
		bytesWrittenMetric metrics.Counter

		table = new FileTable()

		// Starts the service. Does not fail.
		async def start() !none {
			status = ServiceStatus.Started
			return none
		}

		// Stops the service. Does not fail.
		async def stop() !none {
			status = ServiceStatus.Stopped
			return none
		}

		// Stops the service and starts it again. Does not fail.
		async def restart() !none {
			status = ServiceStatus.Restarting
			stop()
			start()
			return none
		}

		// Open a file or folder at the given path with the specified mode: `r`
		// reads, `w` creates or truncates and writes, `a` creates and appends,
		// `+` adds the other direction, `b` is accepted and ignored. `x` beside
		// `w` or `a` creates the file only when nothing is at the path (`wx`),
		// the way lock files are taken.
		//
		// Fails when the policy denies the path, the mode is not one of those, the
		// mode has `x` and something is at the path, or the operating system cannot
		// open it.
		@commit(policy = "read")
		def open(path Path, mode string) !int {
			let reading = mode == "r" || mode == "rb"
			try writable() unless reading
			let target = try (reading ?? (found(path.value()), at(path.value())))
			let fd = try __fs_open(target, mode)
			table.opened(fd, target, mode, false)
			fileOpened(target)
			openedFilesMetric.inc()
			return fd
		}

		// Emitted after a file is opened.
		@emit()
		def fileOpened(path string) string {
			return path
		}

		// Closes an open file handle.
		//
		// Fails when fd is not an open handle.
		@commit()
		def close(fd int) !none {
			try __fs_close(fd)
			table.closed(fd)
			openedFilesMetric.dec()
			return none
		}

		// Writes bytes at the handle's current position and returns how many were written.
		//
		// Fails when fd is not an open handle or the operating system refuses.
		@commit()
		def write(fd int, data byte[]) !int {
			try writable()
			let part = portion(data)
			try spend(part.len())
			let n = try __fs_write(fd, part)
			bytesWrittenMetric.update(n)
			table.wrote(fd, n)
			pace(n)
			return n
		}

		// Reads into the buffer from the handle's current position and returns how many bytes were read.
		//
		// Fails when fd is not an open handle or the operating system refuses.
		@commit()
		def read(fd int, data byte[]) !int {
			let n = try __fs_read(fd, portion(data))
			bytesReadMetric.update(n)
			table.read(fd, n)
			afterRead(data, n)
			return n
		}

		// Reads a whole file into memory.
		//
		// Fails when the policy denies the path or the operating system refuses.
		@commit(policy = "read")
		def readFile(path Path) !byte[] {
			let out = try __fs_read_all(try found(path.value()))
			bytesReadMetric.update(out.len())
			table.read(-1, out.len())
			afterRead(out, out.len())
			return out
		}

		// Writes the bytes to a file, replacing any existing content.
		//
		// Fails when the policy denies the path or the operating system refuses.
		@commit(policy = "write")
		def writeFile(path Path, data byte[]) !none {
			let target = try changed(path.value())
			try spend(data.len())
			try __fs_write_all(target, data)
			bytesWrittenMetric.update(data.len())
			table.wrote(-1, data.len())
			pace(data.len())
			return none
		}

		// Moves the handle's position and returns the new absolute offset.
		//
		// Whence follows the Whence enum: start, current, or end.
		//
		// Fails when fd is not an open handle or the operating system refuses.
		@commit()
		def seek(fd int, offset int64, whence int) !int64 {
			return __fs_seek(fd, offset, whence)
		}

		// Reads into the buffer starting at an absolute offset, leaving the handle's position unchanged.
		//
		// Fails when fd is not an open handle or the operating system refuses.
		@commit()
		def readAt(fd int, data byte[], offset int64) !int {
			let n = try __fs_read_at(fd, portion(data), offset)
			bytesReadMetric.update(n)
			table.read(fd, n)
			afterRead(data, n)
			return n
		}

		// Writes bytes at an absolute offset, leaving the handle's position unchanged.
		//
		// Fails when fd is not an open handle or the operating system refuses.
		@commit()
		def writeAt(fd int, data byte[], offset int64) !int {
			try writable()
			let part = portion(data)
			try spend(part.len())
			let n = try __fs_write_at(fd, part, offset)
			bytesWrittenMetric.update(n)
			table.wrote(fd, n)
			pace(n)
			return n
		}

		// Resizes the file to the given size, padding with zero bytes when it grows.
		//
		// Fails when fd is not an open handle or the operating system refuses.
		@commit()
		def truncate(fd int, size int64) !none {
			try writable()
			return __fs_ftruncate(fd, size)
		}

		// Pushes what was written to the file through to the storage device, so it survives a
		// crash or a power cut. With dataOnly the content alone, without the file's times.
		//
		// Fails when fd is not an open handle or the device reports a write error.
		@query()
		def sync(fd int, dataOnly bool = false) !none {
			return __fs_sync(fd, dataOnly)
		}

		// Opens a file that lives in memory and has no path: it is read, written,
		// mapped and closed as any open file, and is gone when its last descriptor
		// closes. `name` only labels it for someone inspecting the process. It
		// is what a program hands to another over a Unix socket
		// (`Network.sendDescriptor`). No path permission applies: nothing on disk
		// is touched.
		//
		// Fails when the operating system has no memory files (only Linux has
		// them) or no descriptors left.
		@commit()
		def memoryFile(name string = "") !int {
			let fd = try __fs_memory_file(name)
			table.opened(fd, name, "", true)
			openedFilesMetric.inc()
			return fd
		}

		// Makes a memory file final: its bytes and its size cannot change again,
		// through this descriptor or any other, and that cannot be undone. A
		// receiver can then rely on what it was handed staying as it is.
		//
		// Fails when fd is not a memory file or part of it is mapped writable.
		@commit()
		def seal(fd int) !none {
			return __fs_seal(fd)
		}

		// Takes an advisory lock on the whole file: exclusive, or shared with other shared
		// holders. It binds programs that ask for it and nothing else. With wait it returns
		// once the lock is held; without, false when someone else holds it.
		//
		// Fails when fd is not an open handle or the file system has no locks.
		@query()
		def lock(fd int, exclusive bool = true, wait bool = true) !bool {
			return __fs_lock(fd, exclusive ?? (2, 1), wait)
		}

		// Gives up the lock `lock` took.
		//
		// Fails when fd is not an open handle.
		@query()
		def unlock(fd int) !none {
			try __fs_lock(fd, 0, false)
			return none
		}

		// Maps length bytes of the open descriptor from offset into memory and returns a mapping
		// handle; length 0 maps to the end of the file.
		//
		// A device node reports no size, so a caller mapping one passes the length itself.
		//
		// Fails when the descriptor cannot be mapped.
		@commit()
		def mmap(fd int, offset int = 0, length int = 0, access MapAccess = MapAccess.Read) !int {
			return __mem_map(fd, offset, length, int(access))
		}

		// The mapped bytes from offset.
		//
		// Fails when the range leaves the mapping.
		@commit()
		def mmapRead(handle int, offset int, length int) !byte[] {
			let out = try __mem_map_read(handle, offset, length)
			bytesReadMetric.update(out.len())
			table.read(-1, out.len())
			return out
		}

		// The mapped bytes from offset as an array over the mapping's own
		// pages, without a copy (see `os.Mapping.pages`).
		//
		// Fails on a read-only mapping or a range that leaves the mapping.
		@commit()
		def mmapView(handle int, offset int, length int) !byte[] {
			return __mem_map_view(handle, offset, length)
		}

		// Writes into the mapping at offset.
		//
		// Fails on a read-only mapping or a range that leaves it.
		@commit()
		def mmapWrite(handle int, offset int, data byte[]) !none {
			try writable()
			try __mem_map_write(handle, offset, data)
			bytesWrittenMetric.update(data.len())
			table.wrote(-1, data.len())
			return none
		}

		// Bytes in the mapping, 0 for an unknown handle.
		@query()
		def mmapLength(handle int) int {
			return __mem_map_length(handle)
		}

		// Pushes a shared mapping's changes to the file.
		//
		// Fails when the handle is not a mapping.
		@commit()
		def mmapFlush(handle int) !none {
			return __mem_map_flush(handle)
		}

		// Releases the mapping.
		//
		// Fails when the handle is not a mapping.
		@commit()
		def munmap(handle int) !none {
			return __mem_unmap(handle)
		}

		// Sends a driver request on the descriptor with data as its argument, which the driver
		// writes its answer back into, and returns the request's result: 0 for most requests, a
		// count for some (a feature report's length, a name's length, a new descriptor).
		//
		// Fails when the driver refuses.
		@commit()
		def control(fd int, request int, data byte[]) !int {
			return __fs_ioctl(fd, request, data)
		}

		// Sends a driver request whose argument is a number rather than a
		// buffer (grabbing an input device, removing a force-feedback effect,
		// flushing a terminal), and returns the request's result.
		//
		// Fails when the driver refuses.
		@commit()
		def control(fd int, request int, value int) !int {
			return __fs_ioctl_value(fd, request, value)
		}

		// Waits until the descriptor is readable, or writable when `write` is true, or the timeout
		// passes; true when it is ready.
		//
		// A query, not a commit: the wait must not hold the service's lock while it lasts.
		//
		// Fails when the descriptor cannot be waited on.
		@query()
		def wait(fd int, timeout duration, write bool = false) !bool {
			return __fs_wait(fd, timeout, write)
		}

		// Returns whether a file or directory exists at the path.
		//
		// Fails when the policy denies the path or the operating system refuses.
		@commit(policy = "read")
		def exists(path Path) !bool {
			let target = try at(path.value())
			return false when hidden(target)
			return __fs_exists(target)
		}

		// Removes a file.
		//
		// Fails when the policy denies the path or the operating system refuses.
		@commit(policy = "write")
		def remove(path Path) !none {
			try writable()
			return __fs_remove(try found(path.value()))
		}

		// Renames or moves a file or directory.
		//
		// Fails when the policy denies the path or the operating system refuses.
		@commit(policy = "write")
		def rename(oldPath Path, newPath Path) !none {
			try writable()
			return __fs_rename(try found(oldPath.value()), try at(newPath.value()))
		}

		// Creates a directory.
		//
		// Fails when the policy denies the path, the directory exists or its
		// parent is missing.
		@commit(policy = "write")
		def mkdir(path Path) !none {
			return __fs_mkdir(try changed(path.value()))
		}

		// Removes an empty directory.
		//
		// Fails when the policy denies the path or the operating system refuses.
		@commit(policy = "write")
		def rmdir(path Path) !none {
			return __fs_rmdir(try changed(path.value()))
		}

		// The file system path behind a Path: a `package://` or
		// `namespace:name://` path resolves to the package's shipped files.
		//
		// Fails when the path names a package without shipped files.
		def at(path string) !string {
			return Application.filePath(path)
		}

		// `at` for a path that is looked up: fails for one the lab hides.
		def found(path string) !string {
			let target = try at(path)
			fail Error{message: "{target}: no such file or directory (lab)", code: "ENOENT"} when hidden(target)
			return target
		}

		// `at` for a path that is changed: fails while the lab's disk is read-only.
		def changed(path string) !string {
			try writable()
			return at(path)
		}

		// Whether the lab hides the path. The pattern has `/` between
		// elements on every system, as policy rules do.
		def hidden(target string) bool {
			let pattern = lab.conditions.missing
			return false when pattern == ""
			return new Glob(pattern).matches(__os__ == "windows" ?? (target.replace("\\", "/"), target))
		}

		// Fails while the lab's disk is read-only.
		def writable() !none {
			fail Error{message: "read-only file system (lab)", code: "EROFS"} when lab.conditions.readOnly
			return none
		}

		// Takes the bytes of a write from the lab's free space; fails when
		// they do not fit.
		def spend(bytes int) !none {
			let free = lab.conditions.freeSpace
			return none when free is none
			fail Error{message: "no space left on device (lab)", code: "ENOSPC"} when int64(bytes) > free
			lab.conditions.freeSpace = free - int64(bytes)
			return none
		}

		// The part of a buffer one call moves under the lab's chunk size.
		def portion(data byte[]) byte[] {
			let most = lab.conditions.chunk
			return data when most <= 0 || data.len() <= most
			return data[:most]
		}

		// What a read hands back under the lab: now and then a flipped bit,
		// and the time the bytes take.
		def afterRead(data byte[], n int) {
			return when n <= 0
			data[0] = data[0] ^ 1 when lab.chance(lab.conditions.corruptReads)
			pace(n)
		}

		// Holds the call for the time `n` bytes take at the lab's speed.
		def pace(n int) {
			let speed = lab.conditions.bytesPerSecond
			return when speed <= 0 || n <= 0
			time.sleep(duration(int64(n) * 1000000000 / int64(speed)))
		}

		// Returns the user's home folder: `HOME`, or `USERPROFILE` on
		// Windows.
		//
		// Fails when the environment names none.
		@query()
		def homeDir() !string {
			let name = __os__ == "windows" ?? ("USERPROFILE", "HOME")
			let home = __env_get(name)
			fail "the user's home folder is not known: {name} is not set" when home is none || home == ""
			return home
		}

		// Returns the folder for temporary files: `TMPDIR`, else `/tmp`
		// (`/data/local/tmp` on Android); on Windows the first of `TMP`,
		// `TEMP` and `USERPROFILE` that is set, else the Windows folder, as
		// `GetTempPath` takes them. Without a trailing separator.
		@query()
		def tempDir() string {
			let names = __os__ == "windows" ?? (["TMP", "TEMP", "USERPROFILE", "SystemRoot"], ["TMPDIR"])
			for let name in names {
				let dir = __env_get(name)
				continue when dir is none || dir == ""
				let text string = dir
				for text.len() > 1 && (text.endsWith("/") || text.endsWith(os.SEPARATOR)) && !text.endsWith(":" + os.SEPARATOR) {
					text = text[:text.len() - 1]
				}
				return text
			}
			return __os__ == "windows" ?? ("C:\\Windows", __os__ == "android" ?? ("/data/local/tmp", "/tmp"))
		}

		// Returns the absolute path a path names, in its shortest form: `~`
		// and `~/...` start at the user's home folder, a relative path at
		// the working directory, and a package path (`package://...`) is
		// the file the package shipped, as `at` gives it.
		//
		// Fails when the path starts with `~` and no home folder is known,
		// or names a package without shipped files.
		@query()
		def resolve(path string) !string {
			let target = path
			if target == "~" || target.startsWith("~/") || target.startsWith("~" + os.SEPARATOR) {
				target = (try homeDir()) + target[1:]
			} else {
				target = try at(target)
			}
			return os.absolute(target, __proc_working_dir())
		}

		def joinPath(dir string, name string) string {
			return name when dir.len() == 0
			let last = dir[dir.len() - 1]
			if last == '/' || last == '\\' {
				return dir + name
			}
			return dir + os.SEPARATOR + name
		}

		// Lists the entries of a directory.
		//
		// Depth 0 lists the directory itself; a larger depth descends that many levels.
		// A symbolic link is listed with what it points at (size, `isDir`,
		// times) and the `Symlink` bit set in its mode; a link whose target
		// is gone is listed as the link itself. Links are never descended into.
		//
		// Fails when the policy denies the path or the operating system refuses.
		@query(policy = "read")
		def readDir(path Path, depth int = 0) !os.DirEntry[] {
			let out os.DirEntry[]
			let stack (string, int)[]
			stack.push((try found(path.value()), 0))

			for stack.len() > 0 {
				let (dir, level) = stack.pop()
				let names = try __fs_read_dir(dir)

				for let (_, name) in names {
					let childPath = joinPath(dir, name)
					let info = try entryInfo(childPath, name)
					out.push(os.DirEntry{path: childPath, info: info})

					let linked = int(info.mode) & int(os.FileMode.Symlink) != 0
					let canDescend = info.isDir && !linked && depth != 0 && (depth < 0 || (level + 1) <= depth)
					if canDescend {
						stack.push((childPath, level + 1))
					}
				}
			}
			return out
		}

		// Delete a file or a folder at the given path
		//
		// Fails when the policy denies the path or the operating system refuses.
		@commit(policy = "write")
		def delete(path Path) !none {
			try writable()
			return __fs_remove(try found(path.value()))
		}

		// Returns size, mode, timestamps and the file system's identity numbers
		// for a path. A symbolic link is followed to what it points at; with
		// `followLinks` off the link itself is described, its mode carrying the
		// `Symlink` bit.
		//
		// Fails when the policy denies the path or the operating system refuses.
		@query(policy = "read")
		def stat(path Path, followLinks bool = true) !os.FileInfo {
			let target = try found(path.value())
			let st = try (followLinks ?? (__fs_stat(target), __fs_lstat(target)))
			return fileInfo(os.base(target), st, os.fromUnixMode(int(st.1)))
		}

		// What `readDir` reports for one entry.
		def entryInfo(path string, name string) !os.FileInfo {
			let own = try __fs_lstat(path)
			let kind = os.fromUnixMode(int(own.1))
			if int(kind) & int(os.FileMode.Symlink) == 0 {
				return fileInfo(name, own, kind)
			}
			// A link whose target is gone keeps the link's own numbers.
			let target = __fs_stat(path) onerror recover own
			return fileInfo(name, target, os.FileMode(int(os.fromUnixMode(int(target.1))) | int(os.FileMode.Symlink)))
		}

		// The FileInfo of one `__fs_stat` result, with its mode already converted.
		def fileInfo(name string, st (int64, int64, bool, int64, int64, int64, int64, int64, int64, int64), mode os.FileMode) os.FileInfo {
			return os.FileInfo{
				name:       name,
				size:       st.0,
				mode:       mode,
				isDir:      st.2,
				modTime:    time.fromUnixNs(st.3),
				changeTime: time.fromUnixNs(st.4),
				device:     st.5,
				inode:      st.6,
				uid:        int(st.7),
				gid:        int(st.8),
				links:      int(st.9),
			}
		}

		// Creates a symbolic link at `link` that holds `target` as written: a
		// relative target is relative to the link's folder, and the target
		// need not exist.
		//
		// Fails when the policy denies the link's path, something is at that
		// path already or the operating system refuses.
		@commit(policy = "write")
		def symlink(target string, link Path) !none {
			return __fs_symlink(target, try changed(link.value()))
		}

		// Returns the target a symbolic link holds, as written in the link: a
		// relative target is relative to the link's folder and is not resolved.
		//
		// Fails when the policy denies the path, the path is not a link or the
		// operating system refuses.
		@query(policy = "read")
		def readLink(path Path) !string {
			return __fs_read_link(try found(path.value()))
		}

		// Returns the files the Storage service opened (`open`,
		// `memoryFile`) and has not closed, ordered by descriptor, each with
		// its reads and writes so far. A descriptor that came from elsewhere
		// (`Network.receiveDescriptor`) is not listed.
		@query()
		def openedFiles() OpenedFile[] {
			return table.list()
		}

		// Changes a file's permission bits.
		//
		// Fails when the policy denies the path or the operating system refuses.
		@commit(policy = "write")
		def chmod(file Path, mode int64) !none {
			return __fs_chmod(try changed(file.value()), mode)
		}

		// Sets a file's modification time; the access time is left as it is.
		//
		// Fails when the policy denies the path or the operating system refuses.
		@commit(policy = "write")
		def touch(file Path, modified time.Time) !none {
			return __fs_touch(try changed(file.value()), modified.unixNs())
		}

		// Returns the reads and writes of the open file `fd`, or with `fd`
		// none those of every file since the service started: closed files,
		// `readFile`, `writeFile` and mapped reads and writes included.
		//
		// Fails when `fd` is not a file the Storage service has open.
		@query()
		def metrics(fd ?int) !FileMetrics {
			let found = table.metricsOf(fd)
			fail Error{message: "metrics: {fd} is not a file Storage has open", code: "EBADF"} when found is none
			return found
		}

		// The bytes still free for the program on the disk that holds the
		// path (the file system it is on).
		//
		// Fails when the policy denies the path or the operating system refuses.
		@query(policy = "read")
		def freeSpace(disk Path) !int64 {
			let simulated = lab.conditions.freeSpace
			return simulated unless simulated is none
			let (free, total) = try __fs_free_space(try at(disk.value()))
			return free
		}

		// The size in bytes of the disk that holds the path.
		//
		// Fails when the policy denies the path or the operating system refuses.
		@query(policy = "read")
		def totalSpace(disk Path) !int64 {
			let (free, total) = try __fs_free_space(try at(disk.value()))
			return total
		}

		// Opens a watcher: a descriptor that `wait` reports readable when
		// something changed under a path added to it with `watchAdd`. Close
		// it with `watchClose`. `std.os.watch` is the convenient form.
		//
		// Fails when the operating system has no watchers left or cannot
		// watch files at all (Linux and Windows can).
		@commit()
		def watchOpen() !int {
			return __fs_watch_open()
		}

		// Closes a watcher and ends its watches.
		//
		// Fails when the descriptor is not a watcher.
		@commit()
		def watchClose(watcher int) !none {
			return __fs_watch_close(watcher)
		}

		// Watches a file, or the entries of a directory (not those of the
		// directories in it), and returns the watch's number.
		//
		// Fails when the policy denies the path or the operating system refuses.
		@commit(policy = "read")
		def watchAdd(watcher int, path Path) !int {
			return __fs_watch_add(watcher, try at(path.value()))
		}

		// Ends one watch of a watcher.
		//
		// Fails when the watcher has no such watch.
		@commit()
		def watchRemove(watcher int, watch int) !none {
			return __fs_watch_remove(watcher, watch)
		}

		// The next change a watcher holds: the number of the watch it belongs
		// to (-1 when none is ready), the change bits and the entry's name in
		// the watched directory (empty for the watched path itself). The bits:
		// 1 created, 2 removed, 4 written, 8 moved away, 16 moved in,
		// 32 attributes changed, 64 the entry is a directory, 128 changes
		// were lost, 256 the watch ended.
		//
		// Fails when the descriptor is not a watcher.
		@query()
		def watchNext(watcher int) !(int, int64, string) {
			return __fs_watch_next(watcher)
		}

		// Returns the mounted file systems that hold files: disks,
		// partitions, network shares; pseudo file systems (`proc`, `sysfs`,
		// `tmpfs`, `overlay`, ...) and package images (`squashfs`: snaps,
		// AppImages) are left out. Their sizes are
		// `freeSpace` and `totalSpace` of the mount point, which the read
		// policy decides on.
		//
		// Fails when the operating system cannot list its mounts.
		@query()
		def disks() !Disk[] {
			let (devices, points, types, flags) = try __fs_mounts()
			let out Disk[] = []
			for let (i, device) in devices {
				out.push(Disk{device: device, mountPoint: points[i], fileSystem: types[i], readOnly: flags[i] & 1 != 0, network: flags[i] & 2 != 0})
			}
			return out
		}
	}
	/*
	
	own:
	    files
	    directories
	    file descriptors
	    mounts/disks
	    disk usage
	    watchers
	    temporary files
	    atomic writes
	    locks
	
	    @embed("./assets/logo.png")
	    const logo bytes
	
	*/
}
