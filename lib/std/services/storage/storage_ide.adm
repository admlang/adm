// The Storage service's IDE panel: the bytes the program reads and writes,
// its open files and the machine's disks, and the button that closes a file.

partial module std.services.storage {
	use std.ide::(ide, IdeKind, IdeTable)

	partial service Storage {
		@ide(kind = IdeKind.Series, label = "Read", refresh = 1s, unit = "B", cumulative = true)
		def ideRead() uint64 {
			return bytesReadMetric.value()
		}

		@ide(kind = IdeKind.Series, label = "Written", refresh = 1s, unit = "B", cumulative = true)
		def ideWritten() uint64 {
			return bytesWrittenMetric.value()
		}

		// How many reads and writes the program made, beside the bytes.
		@ide(kind = IdeKind.Series, label = "Reads", refresh = 1s, cumulative = true)
		def ideReads() int64 {
			let total = metrics(none) onerror recover FileMetrics{}
			return total.reads
		}

		@ide(kind = IdeKind.Series, label = "Writes", refresh = 1s, cumulative = true)
		def ideWrites() int64 {
			let total = metrics(none) onerror recover FileMetrics{}
			return total.writes
		}

		@ide(kind = IdeKind.Table, label = "Open files", refresh = 1s, rows = 0)
		def ideOpenFiles() IdeTable {
			let rows = string[][]
			for let (_, file) in openedFiles() {
				let path = file.memory ?? ("{file.path} (memory)", file.path)
				rows.push(["{file.fd}", path, file.mode, "{file.metrics.reads}", "{file.metrics.bytesRead}", "{file.metrics.writes}", "{file.metrics.bytesWritten}", "{file.opened}"])
			}
			return IdeTable{columns: ["Descriptor", "Path", "Mode", "Reads", "Read (B)", "Writes", "Written (B)", "Opened"], rows: rows}
		}

		@ide(kind = IdeKind.Table, label = "Disks", refresh = 30s, rows = 6)
		def ideDisks() IdeTable {
			let rows = string[][]
			let found = disks() onerror recover Disk[]
			for let (_, disk) in found {
				rows.push([disk.mountPoint, disk.device, disk.fileSystem, disk.readOnly ?? ("read-only", "")])
			}
			return IdeTable{columns: ["Mounted at", "Device", "File system", ""], rows: rows}
		}

		// Closes a file the program holds; its next read or write fails.
		@ide(kind = IdeKind.Action, label = "Close file", confirm = "Close this file?", row = "ideOpenFiles.Descriptor")
		def ideCloseFile(fd int) !none {
			return close(fd)
		}
	}
}
