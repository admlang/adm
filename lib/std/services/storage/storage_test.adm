partial module std.services.storage {
	use (
		std.services.runtime::(Runtime)
		std.testing
		std.os
		std.time
	)

	// A scratch path nothing else in the suite uses.
	internal def scratchPath(name string) string {
		return "/tmp/adm-storage-{name}-{time.now().unixNs()}"
	}

	// Removes a scratch file, whether or not it is still there.
	internal def dropScratch(path string) {
		os.remove(path) onerror recover none
	}

	// `Storage.lab.conditions`: what a test makes the disk do.
	check "Storage lab" {
		testing.beforeEach(def () {
			Storage.lab.reset()
		})
		testing.afterAll(def () {
			Storage.lab.reset()
		})

		@test()
		def TestReadOnlyRefusesEveryChange() !none {
			let path = scratchPath("readonly")
			try Storage.writeFile(path, "before".bytes())

			Storage.lab.conditions.readOnly = true
			let code1 = ""
			Storage.writeFile(path, "after".bytes()) onerror (err error) {
				code1 = err.code
				recover none
			}
			assert code1 == "EROFS"
			let code2 = ""
			Storage.remove(path) onerror (err error) {
				code2 = err.code
				recover none
			}
			assert code2 == "EROFS"
			let code3 = ""
			Storage.mkdir(path + "-dir") onerror (err error) {
				code3 = err.code
				recover none
			}
			assert code3 == "EROFS"
			let opened = Storage.open(path, "w") onerror recover -1
			assert opened == -1

			// Reading goes on.
			assert string(try Storage.readFile(path)) == "before"
			let fd = try Storage.open(path, "r")
			try Storage.close(fd)

			Storage.lab.reset()
			try Storage.writeFile(path, "after".bytes())
			assert string(try Storage.readFile(path)) == "after"
			dropScratch(path)
			return none
		}

		@test()
		def TestFreeSpaceIsUsedUp() !none {
			let path = scratchPath("space")
			Storage.lab.conditions.freeSpace = 10
			assert (try Storage.freeSpace("/tmp")) == 10

			try Storage.writeFile(path, "sixsix".bytes())
			assert (try Storage.freeSpace("/tmp")) == 4

			let other = scratchPath("space-full")
			let code4 = ""
			Storage.writeFile(other, "sixsix".bytes()) onerror (err error) {
				code4 = err.code
				recover none
			}
			assert code4 == "ENOSPC"
			assert !(try Storage.exists(other))
			try Storage.writeFile(other, "four".bytes())
			assert (try Storage.freeSpace("/tmp")) == 0

			Storage.lab.reset()
			assert (try Storage.freeSpace("/tmp")) > 10
			dropScratch(path)
			dropScratch(other)
			return none
		}

		@test()
		def TestChunkGivesShortReadsAndWrites() !none {
			let path = scratchPath("chunk")
			Storage.lab.conditions.chunk = 4
			let fd = try Storage.open(path, "w")
			assert (try Storage.write(fd, "0123456789".bytes())) == 4
			assert (try Storage.write(fd, "456789".bytes())) == 4
			assert (try Storage.write(fd, "89".bytes())) == 2
			try Storage.close(fd)

			let back = try Storage.open(path, "r")
			let buffer byte[]
			buffer.len(10)
			assert (try Storage.read(back, buffer)) == 4
			assert string(buffer[:4]) == "0123"
			try Storage.close(back)

			Storage.lab.reset()
			assert string(try Storage.readFile(path)) == "0123456789"
			dropScratch(path)
			return none
		}

		@test()
		def TestCorruptReadsFlipABit() !none {
			let path = scratchPath("corrupt")
			try Storage.writeFile(path, "abc".bytes())

			Storage.lab.conditions.corruptReads = 1.0
			let damaged = try Storage.readFile(path)
			assert damaged.len() == 3
			assert string(damaged) != "abc"
			assert string(damaged[1:]) == "bc"

			// The file itself is whole.
			Storage.lab.reset()
			assert string(try Storage.readFile(path)) == "abc"
			dropScratch(path)
			return none
		}

		@test()
		def TestMissingHidesPaths() !none {
			let hidden = scratchPath("hidden")
			let seen = scratchPath("seen")
			try Storage.writeFile(hidden, "x".bytes())
			try Storage.writeFile(seen, "y".bytes())

			Storage.lab.conditions.missing = "*/adm-storage-hidden-*"
			assert !(try Storage.exists(hidden))
			let read = Storage.readFile(hidden) onerror (err error) {
				assert err.code == "ENOENT"
				recover []
			}
			assert read.len() == 0
			let code5 = ""
			Storage.remove(hidden) onerror (err error) {
				code5 = err.code
				recover none
			}
			assert code5 == "ENOENT"
			assert try Storage.exists(seen)
			assert string(try Storage.readFile(seen)) == "y"

			Storage.lab.reset()
			assert try Storage.exists(hidden)
			dropScratch(hidden)
			dropScratch(seen)
			return none
		}

		@test()
		def TestBytesPerSecondPacesTransfers() !none {
			let path = scratchPath("paced")
			Storage.lab.conditions.bytesPerSecond = 1000
			let data byte[]
			data.len(50)
			let started = time.now()
			try Storage.writeFile(path, data)
			assert time.since(started) >= 50ms

			let again = time.now()
			try Storage.readFile(path)
			assert time.since(again) >= 50ms
			Storage.lab.reset()
			dropScratch(path)
			return none
		}
	}

	check "Storage mappings" {
		// A read-only mapping hands back what the file holds, and refuses both a
		// range outside it and any write.
		@test()
		def TestReadMappingSeesTheFile() !none {
			let path = scratchPath("read")
			try os.writeFile(path, "mapped contents".bytes())

			let fd = try Storage.open(path, "r")
			let handle = try Storage.mmap(fd)
			try Storage.close(fd)

			assert Storage.mmapLength(handle) == 15
			assert string(try Storage.mmapRead(handle, 0, 15)) == "mapped contents"
			assert string(try Storage.mmapRead(handle, 7, 8)) == "contents"

			let outside = false
			Storage.mmapRead(handle, 10, 10) onerror (err error) {
				outside = true
				recover "".bytes()
			}
			assert outside

			let refused = false
			Storage.mmapWrite(handle, 0, "x".bytes()) onerror (err error) {
				refused = true
				recover none
			}
			assert refused

			try Storage.munmap(handle)
			// The handle is gone, so unmapping it again fails.
			let twice = false
			Storage.munmap(handle) onerror (err error) {
				twice = true
				recover none
			}
			assert twice
			assert Storage.mmapLength(handle) == 0

			dropScratch(path)
			return none
		}

		// A shared read-write mapping's changes reach the file.
		@test()
		def TestReadWriteMappingReachesTheFile() !none {
			let path = scratchPath("write")
			try os.writeFile(path, "0123456789".bytes())

			let fd = try Storage.open(path, "r+")
			let handle = try Storage.mmap(fd, 0, 0, MapAccess.ReadWrite)
			try Storage.close(fd)

			try Storage.mmapWrite(handle, 2, "AB".bytes())
			assert string(try Storage.mmapRead(handle, 0, 10)) == "01AB456789"
			try Storage.mmapFlush(handle)
			try Storage.munmap(handle)

			assert string(try os.readFile(path)) == "01AB456789"

			dropScratch(path)
			return none
		}

		// A private mapping takes the write, and the file does not.
		@test()
		def TestCopyMappingLeavesTheFileAlone() !none {
			let path = scratchPath("copy")
			try os.writeFile(path, "0123456789".bytes())

			let fd = try Storage.open(path, "r+")
			let handle = try Storage.mmap(fd, 0, 0, MapAccess.Copy)
			try Storage.close(fd)

			try Storage.mmapWrite(handle, 0, "XY".bytes())
			assert string(try Storage.mmapRead(handle, 0, 4)) == "XY23"
			try Storage.mmapFlush(handle)
			try Storage.munmap(handle)

			assert string(try os.readFile(path)) == "0123456789"

			dropScratch(path)
			return none
		}

		// An empty file has no pages, so there is nothing to map.
		@test()
		def TestMappingAnEmptyFileFails() !none {
			let path = scratchPath("empty")
			try os.writeFile(path, "".bytes())

			let fd = try Storage.open(path, "r")
			let failed = false
			Storage.mmap(fd) onerror (err error) {
				failed = true
				recover 0
			}
			assert failed

			try Storage.close(fd)
			dropScratch(path)
			return none
		}
	}

	check "Storage descriptors" {
		// A regular file takes no driver requests, so control reports what the
		// operating system says rather than pretending it worked.
		@test()
		def TestControlRefusesARegularFile() !none {
			let path = scratchPath("control")
			try os.writeFile(path, "not a device".bytes())

			let fd = try Storage.open(path, "r")
			let probe byte[]
			probe.len(4)
			let failed = false
			Storage.control(fd, 0, probe) onerror (err error) {
				failed = true
				recover "".bytes()
			}
			assert failed

			try Storage.close(fd)
			dropScratch(path)
			return none
		}

		// A regular file is always readable, whatever the timeout.
		@test()
		def TestWaitOnAFileIsAlwaysReady() !none {
			let path = scratchPath("wait-file")
			try os.writeFile(path, "ready".bytes())

			let fd = try Storage.open(path, "r")
			assert try Storage.wait(fd, 0s)

			try Storage.close(fd)
			dropScratch(path)
			return none
		}

		// A pipe with nothing in it times out; once something is, the wait
		// reports the descriptor readable.
		@test()
		def TestWaitOnAPipeTimesOutThenReports() !none {
			let path = scratchPath("fifo")
			let made = try Runtime.run("mkfifo {path}")
			assert made.code == 0

			// Read-write, so opening does not block until a writer appears.
			let fd = try Storage.open(path, "r+")
			assert !(try Storage.wait(fd, 20ms))

			assert try Storage.write(fd, "here".bytes()) == 4
			assert try Storage.wait(fd, 1s)

			try Storage.close(fd)
			dropScratch(path)
			return none
		}

		// A descriptor waited on and closed leaves nothing behind for the next
		// descriptor given the same number: its own waits see its own data.
		@test()
		def TestWaitAfterReusedDescriptor() !none {
			let first = scratchPath("fifo-first")
			let second = scratchPath("fifo-second")
			assert (try Runtime.run("mkfifo {first} {second}")).code == 0

			let fd = try Storage.open(first, "r+")
			assert !(try Storage.wait(fd, 20ms))
			try Storage.close(fd)

			let again = try Storage.open(second, "r+")
			assert !(try Storage.wait(again, 20ms))
			assert try Storage.write(again, "here".bytes()) == 4
			assert try Storage.wait(again, 1s)
			assert try Storage.wait(again, 1s, true)

			try Storage.close(again)
			dropScratch(first)
			dropScratch(second)
			return none
		}

		// An empty pipe has room, so a wait for writing reports it at once.
		@test()
		def TestWaitForWritingOnAnEmptyPipe() !none {
			let path = scratchPath("fifo-write")
			let made = try Runtime.run("mkfifo {path}")
			assert made.code == 0

			let fd = try Storage.open(path, "r+")
			assert try Storage.wait(fd, 1s, true)

			try Storage.close(fd)
			dropScratch(path)
			return none
		}
	}

	check "Storage memory files" {
		@test()
		def TestMemoryFileReadsBackWhatWasWritten() !none {
			let fd = try Storage.memoryFile("scratch")
			assert try Storage.write(fd, "kept in memory".bytes()) == 14
			assert try Storage.seek(fd, 0, 0) == 0
			let buf byte[] = []
			buf.len(32)
			let n = try Storage.read(fd, buf)
			assert string(buf[:n]) == "kept in memory"
			try Storage.truncate(fd, 4)
			assert try Storage.readAt(fd, buf, 0) == 4
			try Storage.close(fd)
			return none
		}

		@test()
		def TestSealedMemoryFileTakesNoChange() !none {
			let fd = try Storage.memoryFile()
			try Storage.write(fd, "final".bytes())
			try Storage.seal(fd)
			assert Storage.write(fd, "more".bytes()) is error
			assert Storage.writeAt(fd, "F".bytes(), 0) is error
			assert Storage.truncate(fd, 0) is error
			assert Storage.truncate(fd, 64) is error
			let buf byte[] = []
			buf.len(16)
			let n = try Storage.readAt(fd, buf, 0)
			assert string(buf[:n]) == "final"
			// Sealing again changes nothing and is refused: the seals are final too.
			assert Storage.seal(fd) is error
			try Storage.close(fd)
			return none
		}

		@test()
		def TestOnlyAMemoryFileSeals() !none {
			let path = scratchPath("seal")
			try Storage.writeFile(path, "on disk".bytes())
			let fd = try Storage.open(path, "r+")
			assert Storage.seal(fd) is error
			try Storage.close(fd)
			dropScratch(path)
			return none
		}
	}
}
