partial module std.services {
	use (
		std.testing
		std.os
		std.time
	)

	// A scratch path nothing else in the suite uses.
	internal def scratchPath(name string) string {
		return "/tmp/adm-storage-{name}-{time.now().unixNs()}"
	}

	// Removes a scratch file, whether or not it is still there.
	internal def dropScratch(path string) {
		os.remove(path) onerror recover none
	}

	check "Storage mappings" {
		// A read-only mapping hands back what the file holds, and refuses both a
		// range outside it and any write.
		@test()
		def TestReadMappingSeesTheFile() !none {
			let path = scratchPath("read")
			try os.writeFile(path, "mapped contents".bytes())

			let fd = try Storage.open(path, "r")
			let handle = try Storage.mmap(fd)
			try Storage.close(fd)

			assert Storage.mmapLength(handle) == 15
			assert string(try Storage.mmapRead(handle, 0, 15)) == "mapped contents"
			assert string(try Storage.mmapRead(handle, 7, 8)) == "contents"

			let outside = false
			Storage.mmapRead(handle, 10, 10) onerror (err error) {
				outside = true
				recover "".bytes()
			}
			assert outside

			let refused = false
			Storage.mmapWrite(handle, 0, "x".bytes()) onerror (err error) {
				refused = true
				recover none
			}
			assert refused

			try Storage.munmap(handle)
			// The handle is gone, so unmapping it again fails.
			let twice = false
			Storage.munmap(handle) onerror (err error) {
				twice = true
				recover none
			}
			assert twice
			assert Storage.mmapLength(handle) == 0

			dropScratch(path)
			return none
		}

		// A shared read-write mapping's changes reach the file.
		@test()
		def TestReadWriteMappingReachesTheFile() !none {
			let path = scratchPath("write")
			try os.writeFile(path, "0123456789".bytes())

			let fd = try Storage.open(path, "r+")
			let handle = try Storage.mmap(fd, 0, 0, MapAccess.ReadWrite)
			try Storage.close(fd)

			try Storage.mmapWrite(handle, 2, "AB".bytes())
			assert string(try Storage.mmapRead(handle, 0, 10)) == "01AB456789"
			try Storage.mmapFlush(handle)
			try Storage.munmap(handle)

			assert string(try os.readFile(path)) == "01AB456789"

			dropScratch(path)
			return none
		}

		// A private mapping takes the write, and the file does not.
		@test()
		def TestCopyMappingLeavesTheFileAlone() !none {
			let path = scratchPath("copy")
			try os.writeFile(path, "0123456789".bytes())

			let fd = try Storage.open(path, "r+")
			let handle = try Storage.mmap(fd, 0, 0, MapAccess.Copy)
			try Storage.close(fd)

			try Storage.mmapWrite(handle, 0, "XY".bytes())
			assert string(try Storage.mmapRead(handle, 0, 4)) == "XY23"
			try Storage.mmapFlush(handle)
			try Storage.munmap(handle)

			assert string(try os.readFile(path)) == "0123456789"

			dropScratch(path)
			return none
		}

		// An empty file has no pages, so there is nothing to map.
		@test()
		def TestMappingAnEmptyFileFails() !none {
			let path = scratchPath("empty")
			try os.writeFile(path, "".bytes())

			let fd = try Storage.open(path, "r")
			let failed = false
			Storage.mmap(fd) onerror (err error) {
				failed = true
				recover 0
			}
			assert failed

			try Storage.close(fd)
			dropScratch(path)
			return none
		}
	}

	check "Storage descriptors" {
		// A regular file takes no driver requests, so control reports what the
		// operating system says rather than pretending it worked.
		@test()
		def TestControlRefusesARegularFile() !none {
			let path = scratchPath("control")
			try os.writeFile(path, "not a device".bytes())

			let fd = try Storage.open(path, "r")
			let probe byte[]
			probe.len(4)
			let failed = false
			Storage.control(fd, 0, probe) onerror (err error) {
				failed = true
				recover "".bytes()
			}
			assert failed

			try Storage.close(fd)
			dropScratch(path)
			return none
		}

		// A regular file is always readable, whatever the timeout.
		@test()
		def TestWaitOnAFileIsAlwaysReady() !none {
			let path = scratchPath("wait-file")
			try os.writeFile(path, "ready".bytes())

			let fd = try Storage.open(path, "r")
			assert try Storage.wait(fd, 0s)

			try Storage.close(fd)
			dropScratch(path)
			return none
		}

		// A pipe with nothing in it times out; once something is, the wait
		// reports the descriptor readable.
		@test()
		def TestWaitOnAPipeTimesOutThenReports() !none {
			let path = scratchPath("fifo")
			let made = try Runtime.run("mkfifo {path}")
			assert made.code == 0

			// Read-write, so opening does not block until a writer appears.
			let fd = try Storage.open(path, "r+")
			assert !(try Storage.wait(fd, 20ms))

			assert try Storage.write(fd, "here".bytes()) == 4
			assert try Storage.wait(fd, 1s)

			try Storage.close(fd)
			dropScratch(path)
			return none
		}
	}
}
