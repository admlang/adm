partial module std.services {
	// Telemetry service is used to ship logs/metrics/errorReports to a remote server you configure
	service Telemetry {
		description           = ""
		dependencies          = Dependencies{
			hard: [Diagnostics]
		}
		lifecycle             = Lifecycle{
			start: StartMode.Manual,
			restart: RestartMode.Always,
		}
		permissions  string[]

		def config<T>(val T) !none {}

		async def start() !none {
			return none
		}

		async def stop() !none {
			return none
		}

		async def restart() !none {
			return none
		}
	}
}
