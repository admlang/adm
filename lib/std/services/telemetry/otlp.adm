internal partial module std.services.telemetry.otlp {
	use (
		std.services.telemetry::*
		std.services.logging::(LogLevel)
		std.data.encoding::(JSON, ProtoEncoding, Protobuf, ProtoWriter, hexdecode)
		std.reflection
		std.reflection::(FieldKind)
	)

	// The name the records are sent under as their instrumentation scope.
	const scopeName = "std.services.telemetry"

	// One OTLP message being built, as Protocol Buffers or as OTLP's JSON. The methods take
	// a field's number and its JSON name and write the form the node was made for.
	type Node {
		binary  bool
		wire    ProtoWriter
		members string[]

		def new(binary bool) {
			self.binary = binary
			wire = new ProtoWriter()
		}

		// Another node of the same form.
		def node() Node {
			return new Node(binary)
		}

		// A string field.
		def text(field int, name string, value string) {
			if binary {
				wire.write(field, value)
				return
			}
			members.push("{quote(name)}:{quote(value)}")
		}

		// A fixed64 field: a string in JSON, as every 64-bit integer is.
		def fixed(field int, name string, value uint64) {
			if binary {
				wire.write(field, value, ProtoEncoding.Fixed)
				return
			}
			members.push("{quote(name)}:\"{value}\"")
		}

		// An sfixed64 field: a string in JSON.
		def signed(field int, name string, value int) {
			if binary {
				wire.write(field, value, ProtoEncoding.Fixed)
				return
			}
			members.push("{quote(name)}:\"{value}\"")
		}

		// A fixed32 field.
		def flags(field int, name string, value uint32) {
			if binary {
				wire.write(field, value, ProtoEncoding.Fixed)
				return
			}
			members.push("{quote(name)}:{value}")
		}

		// An int64 field: a string in JSON.
		def integer(field int, name string, value int) {
			if binary {
				wire.write(field, value)
				return
			}
			members.push("{quote(name)}:\"{value}\"")
		}

		// An enum field, by its number in both forms.
		def member(field int, name string, value int) {
			if binary {
				wire.write(field, value)
				return
			}
			members.push("{quote(name)}:{value}")
		}

		// A bool field.
		def flag(field int, name string, value bool) {
			if binary {
				wire.write(field, value)
				return
			}
			members.push("{quote(name)}:{value}")
		}

		// A double field. JSON has no form for a value that is not finite: it goes as 0.
		def real(field int, name string, value float) {
			if binary {
				wire.write(field, value)
				return
			}
			members.push("{quote(name)}:{number(value)}")
		}

		// A bytes field holding a trace or span id: the bytes in Protocol Buffers, the
		// hexadecimal text in JSON. An id that is not hexadecimal is left out.
		def id(field int, name string, hex string) {
			return when hex.isEmpty()
			if binary {
				let raw = hexdecode(hex) onerror recover byte[]
				wire.write(field, raw) unless raw.len() == 0
				return
			}
			members.push("{quote(name)}:{quote(hex)}")
		}

		// A message field.
		def child(field int, name string, value Node) {
			if binary {
				wire.write(field, value.wire)
				return
			}
			members.push("{quote(name)}:{value.json()}")
		}

		// A repeated message field; nothing is written for an empty one.
		def children(field int, name string, values Node[]) {
			return when values.len() == 0
			if binary {
				for let (_, value) in values {
					wire.write(field, value.wire)
				}
				return
			}
			let parts = string[]
			for let (_, value) in values {
				parts.push(value.json())
			}
			members.push("{quote(name)}:[{parts.join(separator)}]")
		}

		// A packed repeated fixed64 field.
		def counts(field int, name string, values uint64[]) {
			if binary {
				wire.writePacked(field, values, ProtoEncoding.Fixed)
				return
			}
			let parts = string[]
			for let (_, value) in values {
				parts.push("\"{value}\"")
			}
			members.push("{quote(name)}:[{parts.join(separator)}]")
		}

		// A packed repeated double field.
		def reals(field int, name string, values float[]) {
			if binary {
				wire.writePacked(field, values)
				return
			}
			let parts = string[]
			for let (_, value) in values {
				parts.push(number(value))
			}
			members.push("{quote(name)}:[{parts.join(separator)}]")
		}

		// The node as a JSON object.
		def json() string {
			return opening + members.join(separator) + closing
		}

		// The finished message.
		def bytes() byte[] {
			return wire.bytes() when binary
			return json().bytes()
		}
	}

	// The braces of a JSON object, as constants: a brace in a string literal opens an
	// interpolation.
	const opening = "\u007B"
	const closing = "\u007D"

	let codec = new JSON()

	// A string as JSON writes it, quotes included.
	def quote(text string) string {
		return string(codec.encode(text))
	}

	// The bytes of a gRPC response, kept as they came.
	type Reply {
		bytes byte[]
	}

	// The gRPC codec of an OTLPExporter: requests are already encoded, and a response is
	// kept as its bytes in the Reply it is decoded into.
	type Passthrough {
		// Encode implements grpc.Codec: the bytes it is given.
		def encode(obj any) byte[] {
			match obj {
				case byte[]:
					return obj
				default:
					return byte[]
			}
		}

		// Decode implements grpc.Codec. Does not fail.
		def decode(input byte[], target any) !none {
			match target {
				case Reply:
					target.bytes = input
				default:
			}
			return none
		}
	}

	// What a collector said about a request it accepted: how many records it left out and
	// why. Zero and "" when it took them all.
	struct Answer {
		rejected int
		message  string
	}

	// The `partialSuccess` member of an export response in OTLP/JSON. Each export service
	// names its count after its records. A count is a 64-bit integer, which JSON carries as
	// a string; a number is read too.
	internal struct PartialSuccess {
		rejectedDataPoints any
		rejectedLogRecords any
		rejectedSpans      any
		errorMessage       string
	}

	// A count of PartialSuccess as an integer; 0 for one that is absent or no number.
	internal def countOf(value any) int {
		return 0 when value is none
		return /^[0-9]+$/.test(value) ?? (value.toInt<int>(), 0) when value is string
		let kind = reflection.kindOf(value)
		return 0 unless kind == FieldKind.Int || kind == FieldKind.Uint || kind == FieldKind.Float
		return int(parseFloat<float>(reflection.scalarText(value)))
	}

	// An export response in OTLP/JSON.
	internal struct ExportResponse {
		partialSuccess ?PartialSuccess = none
	}

	// A google.rpc.Status in JSON: the body of an OTLP/HTTP answer that is not success.
	internal struct StatusBody {
		message string
	}

	// Reads an Export*ServiceResponse, in Protocol Buffers when binary and in JSON
	// otherwise. A body that does not read as one says nothing: every record was taken.
	def answerOf(body byte[], binary bool) Answer {
		return Answer{} when body.len() == 0
		return readAnswer(body, binary) onerror recover Answer{}
	}

	internal def readAnswer(body byte[], binary bool) !Answer {
		if binary {
			let whole = try (new Protobuf()).parse(body)
			return Answer{} unless whole.has(1)
			let part = try whole.get(1).asMessage()
			return Answer{rejected: try part.get(1).asInt(), message: try part.get(2).asString()}
		}
		let whole = ExportResponse{}
		try codec.decode(body, whole)
		let part = whole.partialSuccess
		return Answer{} when part is none
		return Answer{rejected: countOf(part.rejectedDataPoints) + countOf(part.rejectedLogRecords) + countOf(part.rejectedSpans), message: part.errorMessage}
	}

	// The message of the google.rpc.Status an OTLP/HTTP collector answers a refused
	// request with; the body as text when it does not read as one.
	def refusalOf(body byte[], binary bool) string {
		return "" when body.len() == 0
		return readRefusal(body, binary) onerror recover string(body)
	}

	internal def readRefusal(body byte[], binary bool) !string {
		if binary {
			let whole = try (new Protobuf()).parse(body)
			return try whole.get(2).asString()
		}
		let whole = StatusBody{}
		try codec.decode(body, whole)
		return whole.message
	}

	// How long the collector asked to wait before the next try: the google.rpc.RetryInfo
	// among the details of a gRPC status (`grpc-status-details-bin`). None when it holds
	// none.
	def retryDelayOf(details byte[]) ?duration {
		return none when details.len() == 0
		return readRetryDelay(details) onerror recover none
	}

	internal def readRetryDelay(details byte[]) !?duration {
		let status = try (new Protobuf()).parse(details)
		for let (_, detail) in status.all(3) {
			let packed = try detail.asMessage()
			let kind = try packed.get(1).asString()
			continue unless kind.endsWith("/google.rpc.RetryInfo")
			let info = try packed.get(2).asMessage()
			let length = try info.get(1).asMessage()
			return duration((try length.get(1).asInt()) * 1000000000 + (try length.get(2).asInt()))
		}
		return none
	}

	// Between the members of a JSON object or array. A constant, since a string literal
	// inside an interpolation is not safe to write.
	const separator = ","

	// A double as JSON writes it.
	def number(value float) string {
		return "0" unless value == value && value - value == 0.0
		return string(codec.encode(value))
	}

	// A value as an OTLP AnyValue: a string, a bool, an integer, a double, an array of
	// those or a list of named ones. A struct or type goes as its fields, none as an
	// empty value, anything else as its text.
	def anyValue(from Node, value any, depth int = 0) Node {
		let out = from.node()
		if value is string {
			out.text(1, "stringValue", value)
			return out
		}
		if value is bool {
			out.flag(2, "boolValue", value)
			return out
		}
		let kind = reflection.kindOf(value)
		if depth >= 8 {
			out.text(1, "stringValue", "{value}")
			return out
		}
		switch kind {
			case FieldKind.Int, FieldKind.Uint:
				out.integer(3, "intValue", reflection.scalarText(value).toInt<int>())
			case FieldKind.Float:
				out.real(4, "doubleValue", parseFloat<float>(reflection.scalarText(value)))
			case FieldKind.Array:
				let list = from.node()
				let items = Node[]
				for let (_, item) in reflection.elements(value) {
					items.push(anyValue(from, item, depth + 1))
				}
				list.children(1, "values", items)
				out.child(5, "arrayValue", list)
			case FieldKind.Map:
				let list = from.node()
				let entries = Node[]
				for let (_, key) in reflection.keysOf(value) {
					let entry = reflection.entryOf(value, key)
					continue when entry is none
					entries.push(keyValue(from, key, entry, depth + 1))
				}
				list.children(1, "values", entries)
				out.child(6, "kvlistValue", list)
			case FieldKind.Struct:
				let list = from.node()
				let entries = Node[]
				for let (_, field) in reflection.fields(value) {
					let held = field.value()
					continue when held is none
					entries.push(keyValue(from, field.name, held, depth + 1))
				}
				list.children(1, "values", entries)
				out.child(6, "kvlistValue", list)
			case FieldKind.Other:
			default:
				out.text(1, "stringValue", "{value}")
		}
		return out
	}

	// One attribute: a KeyValue.
	def keyValue(from Node, key string, value any, depth int = 0) Node {
		let out = from.node()
		out.text(1, "key", key)
		out.child(2, "value", anyValue(from, value, depth))
		return out
	}

	// A map of values as attributes, sorted by key so a batch always encodes the same.
	def attributes(from Node, fields map<string, any>) Node[] {
		let out = Node[]
		for let (_, key) in fields.keys().sort((a, b) => a < b) {
			let value = fields.get(key)
			out.push(keyValue(from, key, value)) unless value is none
		}
		return out
	}

	// A map of texts as attributes, sorted by key.
	def labelled(from Node, labels map<string, string>) Node[] {
		let out = Node[]
		for let (_, key) in labels.keys().sort((a, b) => a < b) {
			let value = labels.get(key)
			out.push(keyValue(from, key, value)) unless value is none
		}
		return out
	}

	// The Resource of a batch.
	def resourceOf(from Node, batch TelemetryBatch) Node {
		let out = from.node()
		out.children(1, "attributes", labelled(from, batch.resource))
		return out
	}

	// The InstrumentationScope every record goes under.
	def scopeOf(from Node) Node {
		let out = from.node()
		out.text(1, "name", scopeName)
		return out
	}

	// Wraps records in the three layers every OTLP request has: the request holds the
	// resource's group, which holds the scope's group, which holds the records.
	def request(root Node, batch TelemetryBatch, resourceField string, scopeField string, recordField string, items Node[]) byte[] {
		let scoped = root.node()
		scoped.child(1, "scope", scopeOf(root))
		scoped.children(2, recordField, items)
		let grouped = root.node()
		grouped.child(1, "resource", resourceOf(root, batch))
		grouped.children(2, scopeField, [scoped])
		root.children(1, resourceField, [grouped])
		return root.bytes()
	}

	// The OTLP severity number of a log level.
	def severity(level LogLevel) int {
		switch level {
			case LogLevel.Debug:
				return 5
			case LogLevel.Info:
				return 9
			case LogLevel.Warning:
				return 13
			case LogLevel.Error:
				return 17
			default:
				return 21
		}
	}

	// The body of an ExportLogsServiceRequest for the batch's log records, errors and usage
	// events; empty when it has none. binary chooses Protocol Buffers over JSON.
	def logsRequest(batch TelemetryBatch, binary bool) byte[] {
		return byte[] when batch.logs.len() + batch.errors.len() + batch.events.len() == 0
		let root = new Node(binary)
		let items = Node[]
		for let (_, entry) in batch.logs {
			let out = root.node()
			out.fixed(1, "timeUnixNano", uint64(entry.time))
			// An entry written without a level has no severity: OTLP's unspecified.
			let level = entry.level
			if !(level is none) {
				out.member(2, "severityNumber", severity(level))
				out.text(3, "severityText", level.name.upper())
			}
			out.child(5, "body", anyValue(root, entry.message))
			let fields = entry.fields.clone()
			fields["code.function.name"] = "{entry.caller.moduleName}.{entry.caller.name}" unless entry.caller.name.isEmpty()
			fields["code.file.path"] = entry.caller.filePath unless entry.caller.filePath.isEmpty()
			fields["code.line.number"] = entry.caller.line unless entry.caller.line == 0
			out.children(6, "attributes", attributes(root, fields))
			out.id(9, "traceId", entry.trace)
			out.id(10, "spanId", entry.span)
			out.fixed(11, "observedTimeUnixNano", uint64(entry.time))
			items.push(out)
		}
		for let (_, report) in batch.errors {
			let out = root.node()
			out.fixed(1, "timeUnixNano", uint64(report.time))
			out.member(2, "severityNumber", report.fatal ?? (21, 17))
			out.text(3, "severityText", report.fatal ?? ("FATAL", "ERROR"))
			out.child(5, "body", anyValue(root, report.message))
			let fields = report.fields.clone()
			fields["exception.type"] = report.kind
			fields["exception.message"] = report.message
			fields["error.code"] = report.code unless report.code.isEmpty()
			let trace = stackText(report)
			fields["exception.stacktrace"] = trace unless trace.isEmpty()
			out.children(6, "attributes", attributes(root, fields))
			let within = report.span
			if !(within is none) {
				out.id(9, "traceId", within.trace)
				out.id(10, "spanId", within.span)
			}
			out.fixed(11, "observedTimeUnixNano", uint64(report.time))
			items.push(out)
		}
		for let (_, used) in batch.events {
			let out = root.node()
			out.fixed(1, "timeUnixNano", uint64(used.time))
			out.member(2, "severityNumber", 9)
			// The name goes as an attribute too: a collector older than the record's
			// event name field drops that field.
			let properties = used.properties.clone()
			properties["event.name"] = used.name
			out.children(6, "attributes", attributes(root, properties))
			out.fixed(11, "observedTimeUnixNano", uint64(used.time))
			out.text(12, "eventName", used.name)
			items.push(out)
		}
		return request(root, batch, "resourceLogs", "scopeLogs", "logRecords", items)
	}

	// An error's stack, one frame per line.
	def stackText(report ErrorReport) string {
		let lines = string[]
		for let (_, frame) in report.stack.frames {
			lines.push("{frame.name} ({frame.location.file}:{frame.location.line})")
		}
		return lines.join("\n")
	}

	// The body of an ExportTraceServiceRequest for the batch's spans; empty when it has none.
	def tracesRequest(batch TelemetryBatch, binary bool) byte[] {
		return byte[] when batch.spans.len() == 0
		let root = new Node(binary)
		let items = Node[]
		for let (_, timed) in batch.spans {
			let out = root.node()
			out.id(1, "traceId", timed.context.trace)
			out.id(2, "spanId", timed.context.span)
			out.id(4, "parentSpanId", timed.parent)
			out.text(5, "name", timed.name)
			// SPAN_KIND_INTERNAL: nothing says a span is a request served or made.
			out.member(6, "kind", 1)
			out.fixed(7, "startTimeUnixNano", uint64(timed.start))
			out.fixed(8, "endTimeUnixNano", uint64(timed.end))
			out.children(9, "attributes", attributes(root, timed.attributes))
			let moments = Node[]
			for let (_, moment) in timed.events {
				let at = root.node()
				at.fixed(1, "timeUnixNano", uint64(moment.time))
				at.text(2, "name", moment.name)
				at.children(3, "attributes", attributes(root, moment.attributes))
				moments.push(at)
			}
			out.children(11, "events", moments)
			if timed.failed {
				let status = root.node()
				status.text(2, "message", timed.error) unless timed.error.isEmpty()
				// STATUS_CODE_ERROR.
				status.member(3, "code", 2)
				out.child(15, "status", status)
			}
			// Bit 0 of the W3C trace flags: the trace is recorded.
			out.flags(16, "flags", uint32(1))
			items.push(out)
		}
		return request(root, batch, "resourceSpans", "scopeSpans", "spans", items)
	}

	// The body of an ExportMetricsServiceRequest for the batch's metrics; empty when it has
	// none. since is when counting began, in nanoseconds since the Unix epoch.
	//
	// A counter goes as a cumulative monotonic sum of integers, a gauge as a gauge, a
	// toggle as a gauge of 1 or 0, a histogram as a cumulative histogram with its ranges as
	// explicit bounds. The samples of one name and kind are the data points of one metric,
	// told apart by their labels as attributes.
	def metricsRequest(batch TelemetryBatch, binary bool, since int64) byte[] {
		return byte[] when batch.metrics.len() == 0
		let root = new Node(binary)
		// The samples of each metric as a chain through `next`, in the order they came.
		let first = int[]
		let last = map<string, int>{}
		let next = int[]
		for let (at, sample) in batch.metrics {
			next.push(-1)
			let key = sample.kind + " " + sample.name
			if last.hasKey(key) {
				next[last[key]] = at
			} else {
				first.push(at)
			}
			last[key] = at
		}
		let items = Node[]
		for let (_, head) in first {
			let named = batch.metrics[head]
			let out = root.node()
			out.text(1, "name", named.name)
			out.text(2, "description", named.description) unless named.description.isEmpty()
			out.text(3, "unit", named.unit) unless named.unit.isEmpty()
			let points = Node[]
			for let at = head; at >= 0; at = next[at] {
				points.push(dataPoint(root, batch.metrics[at], since))
			}
			let data = root.node()
			data.children(1, "dataPoints", points)
			switch named.kind {
				case "counter":
					// AGGREGATION_TEMPORALITY_CUMULATIVE.
					data.member(2, "aggregationTemporality", 2)
					data.flag(3, "isMonotonic", true)
					out.child(7, "sum", data)
				case "histogram":
					data.member(2, "aggregationTemporality", 2)
					out.child(9, "histogram", data)
				default:
					out.child(5, "gauge", data)
			}
			items.push(out)
		}
		return request(root, batch, "resourceMetrics", "scopeMetrics", "metrics", items)
	}

	// One sample as a NumberDataPoint, or a HistogramDataPoint for a histogram.
	def dataPoint(root Node, sample MetricSample, since int64) Node {
		let point = root.node()
		let spread = sample.distribution
		if sample.kind == "histogram" && !(spread is none) {
			point.fixed(2, "startTimeUnixNano", uint64(since))
			point.fixed(3, "timeUnixNano", uint64(sample.time))
			point.fixed(4, "count", spread.count)
			point.real(5, "sum", float(spread.sum))
			// An empty histogram still has its one range.
			point.counts(6, "bucketCounts", spread.counts.len() == 0 ?? ([uint64(0)], spread.counts))
			let bounds = float[]
			for let (_, bound) in spread.bounds {
				bounds.push(float(bound))
			}
			point.reals(7, "explicitBounds", bounds) unless bounds.len() == 0
			point.children(9, "attributes", labelled(root, sample.labels))
			return point
		}
		point.fixed(2, "startTimeUnixNano", uint64(since)) when sample.kind == "counter"
		point.fixed(3, "timeUnixNano", uint64(sample.time))
		switch sample.kind {
			case "counter":
				point.signed(6, "asInt", int(sample.count))
			case "toggle":
				point.signed(6, "asInt", sample.value == 0.0 ?? (0, 1))
			default:
				point.real(4, "asDouble", float(sample.value))
		}
		point.children(7, "attributes", labelled(root, sample.labels))
		return point
	}
}
