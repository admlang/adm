// The Telemetry service's IDE panel: consent, what it collects, what waits
// and what was lost, the latest failed export, and the buttons that send now
// and set the user's answer.

partial module std.services.telemetry {
	use std.ide::(ide, IdeKind, IdeTable)

	partial service Telemetry {
		@ide(kind = IdeKind.Value, label = "Consent", refresh = 1s)
		def ideConsent() string {
			let answer = consented()
			return answer is none ?? ("not asked", answer ?? ("given", "refused"))
		}

		@ide(kind = IdeKind.Value, label = "Collecting", refresh = 1s)
		def ideCollecting() string {
			let names = string[]
			for let (_, signal) in [TelemetrySignal.Metrics, TelemetrySignal.Logs, TelemetrySignal.Errors, TelemetrySignal.Events] {
				names.push(signal.name) when collecting(signal)
			}
			return names.len() == 0 ?? ("nothing", names.join(", "))
		}

		@ide(kind = IdeKind.Value, label = "Installation", refresh = 60s)
		def ideInstallation() string {
			return installation()
		}

		@ide(kind = IdeKind.Value, label = "Session", refresh = 60s)
		def ideSession() string {
			return session()
		}

		@ide(kind = IdeKind.Series, label = "Waiting", refresh = 1s)
		def ideWaiting() int {
			return waiting
		}

		@ide(kind = IdeKind.Value, label = "Dropped", refresh = 1s)
		def ideDropped() int {
			return dropped()
		}

		@ide(kind = IdeKind.Value, label = "Latest failed export", refresh = 1s)
		def ideLastFailure() string {
			let text = lastFailure.latest()
			return text == "" ?? ("none", text)
		}

		// Sends what waits now.
		@ide(kind = IdeKind.Action, label = "Send now")
		def ideFlush() !none {
			return flush()
		}

		// Records the user's answer, as the program's consent prompt would.
		@ide(kind = IdeKind.Action, label = "Set consent")
		def ideConsentTo(granted bool) !none {
			return consent(granted)
		}
	}
}
