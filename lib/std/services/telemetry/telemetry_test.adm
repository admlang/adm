partial module std.services.telemetry {
	use (
		std.services::(Application)
		std.services.diagnostics::(Diagnostics)
		std.services.vault::(Vault)
		std.services.logging::(Logging, LogLevel, LogRecord)
		std.metrics::(Counter, Histogram)
		std.data.encoding::(JSON)
		std.testing
		std.os
		std.time
	)

	// Keeps the batches it is given, refuses them while `refusing` is set, and fails the
	// next one with `failure` when that is set.
	internal type Collector {
		label    string           = "collector"
		batches  TelemetryBatch[]
		refusing bool
		failure  ?ExportFailure   = none
		// How many times export was called.
		asked    int
		closed   bool

		// Name implements Exporter.
		def name() string {
			return label
		}

		// Export implements Exporter. Fails while refusing is set, and once with failure.
		def export(batch TelemetryBatch) !none {
			asked++
			fail "collector is down" when refusing
			let prepared = failure
			if !(prepared is none) {
				failure = none
				fail prepared
			}
			batches.push(batch)
			return none
		}

		// Close implements Exporter. Does not fail.
		def close() !none {
			closed = true
			return none
		}

		// Every usage event received, by name, in order.
		def eventNames() string[] {
			let names = string[]
			for let (_, batch) in batches {
				for let (_, used) in batch.events {
					names.push(used.name)
				}
			}
			return names
		}
	}

	internal let failuresSeen = new channel<int>(64)

	@on(Telemetry.exportFailed)
	internal def onExportFailed(evt Event<TelemetryFailure>) {
		failuresSeen.offer(evt.result.records * 100 + evt.result.rejected)
	}

	@span()
	internal def timedWork(units int) int {
		return units * 2
	}

	@span("test.named")
	internal def timedFailure() !none {
		fail "no luck"
	}

	@span()
	internal def nestedWork(units int) int {
		return timedWork(units) * 2
	}

	// Begins and ends a span, and reports the span it found itself in: "" for none.
	internal def spanInTask() string {
		Telemetry.span("in.task").end()
		let around = Telemetry.current()
		return "" when around is none
		return around.context().span
	}

	// The span of that name among those recorded; fails when there is none.
	internal def spanNamed(recorded SpanRecord[], name string) !SpanRecord {
		for let (_, timed) in recorded {
			return timed when timed.name == name
		}
		fail "no span named {name}"
	}

	// Stops the service and starts it with one collector and the settings given.
	internal def restartWith(settings TelemetryConfig) !Collector {
		try await Telemetry.stop()
		let collector = new Collector()
		settings.exporters = [collector]
		try Telemetry.config(settings)
		try await Telemetry.start()
		return collector
	}

	// Settings that need no consent, keep nothing on disk and send only when flushed.
	internal def quiet() TelemetryConfig {
		return TelemetryConfig{requireConsent: false, spool: false, interval: 1h, signals: [TelemetrySignal.Errors, TelemetrySignal.Events, TelemetrySignal.Spans]}
	}

	check "Telemetry service" {
		@test()
		def nothingLeavesWithoutConsent() !none {
			let collector = try restartWith(TelemetryConfig{spool: false, interval: 1h, signals: [TelemetrySignal.Events]})
			// Earlier tests of this run ran without asking: start from a refusal.
			try Telemetry.consent(false)
			try testing.expectEqual(false, Telemetry.consented(), "the user refused")
			try testing.expectEqual("", Telemetry.installation(), "no installation id without consent")
			try testing.expectFalse(Telemetry.collecting(), "nothing is collected")
			Telemetry.event("before.consent")
			try Telemetry.flush()
			try testing.expectEqual(0, collector.eventNames().len(), "nothing is collected before consent")

			try Telemetry.consent(true)
			let installation = Telemetry.installation()
			try testing.expectEqual(36, installation.len(), "consent makes the installation id")
			try testing.expectTrue(Telemetry.collecting(TelemetrySignal.Events), "events are collected from then on")
			try testing.expectFalse(Telemetry.collecting(TelemetrySignal.Logs), "a signal that is not configured is not")
			Telemetry.set("experiment.checkout", "B")
			Telemetry.event("after.consent", {"format": "pdf"})
			try Telemetry.flush()
			try testing.expectEqual("after.consent", collector.eventNames().join(","), "collected once the user agreed")
			let resource = collector.batches[0].resource
			try testing.expectEqual(installation, resource["app.installation.id"], "the installation id goes with every batch")
			try testing.expectEqual(Telemetry.session(), resource["session.id"], "and the session id")
			try testing.expectEqual("B", resource["experiment.checkout"], "and what set added")
			try testing.expectEqual(Application.name(), resource["service.name"], "the application's name by default")

			try testing.expectEqual(true, try Vault.load<bool>("telemetry.consent"), "the answer is in the vault")
			try testing.expectEqual(installation, try Vault.id(), "the installation id is the vault's id")
			try await Telemetry.restart()
			try testing.expectEqual(true, Telemetry.consented(), "the answer is kept across runs")
			try testing.expectEqual(installation, Telemetry.installation(), "and the installation id")

			Telemetry.event("dropped.by.withdrawal")
			try Telemetry.consent(false)
			try testing.expectEqual("", Telemetry.installation(), "after withdrawing the id is no longer sent")
			try testing.expectEqual(installation, try Vault.id(), "and stays the vault's id")
			try Telemetry.flush()
			try testing.expectEqual("after.consent", collector.eventNames().join(","), "and drops what waited")
			return none
		}

		@test()
		def errorsEventsAndSignals() !none {
			let collector = try restartWith(quiet())
			let failure = os.readFile("/nonexistent/telemetry") onerror (err error) {
				Telemetry.report(err, {"order": 7})
				recover byte[]
			}
			try testing.expectEqual(0, failure.len(), "the read failed")
			Telemetry.event("export.finished", {"pages": 12})
			Logging.error("not collected: Logs is not among the signals")
			try Logging.flush()
			try Telemetry.flush()
			try testing.expectEqual(1, collector.batches.len(), "one batch")
			let batch = collector.batches[0]
			try testing.expectEqual(1, batch.errors.len(), "the reported error")
			try testing.expectFalse(batch.errors[0].message.isEmpty(), "with its message")
			try testing.expectEqual(7, int(batch.errors[0].fields["order"]), "and the caller's fields")
			try testing.expectFalse(batch.errors[0].fatal, "which did not end the program")
			try testing.expectEqual(12, int(batch.events[0].properties["pages"]), "the event's properties")
			try testing.expectEqual(0, batch.logs.len() + batch.metrics.len(), "signals left out are not collected")
			return none
		}

		@test()
		def metricsAndLogs() !none {
			let settings = quiet()
			settings.signals = [TelemetrySignal.Metrics, TelemetrySignal.Logs, TelemetrySignal.Errors]
			let collector = try restartWith(settings)
			let calls = try Diagnostics.register<Counter>("telemetry.test.calls")
			calls.inc()
			calls.inc()
			let routed = try Diagnostics.register<Counter>("telemetry.test.routes", {"route": "/orders"}, unit = "1", description = "Routes hit")
			routed.inc()
			let sizes = try Diagnostics.register<Histogram>("telemetry.test.sizes")
			sizes.update(4.0)
			sizes.update(16.0)
			Logging.error("card declined", {"order": 9})
			Logging.fatal("out of disk")
			try Logging.flush()
			try Telemetry.flush()
			let batch = collector.batches[0]
			let seen = 0
			for let (_, sample) in batch.metrics {
				if sample.name == "telemetry.test.calls" {
					seen++
					try testing.expectEqual("counter", sample.kind, "a counter")
					try testing.expectEqual(2.0, sample.value, "with its count")
				}
				if sample.name == "telemetry.test.sizes" {
					seen++
					let spread = sample.distribution
					fail "a histogram carries its distribution" when spread is none
					try testing.expectEqual(uint64(2), spread.count, "every value counted")
					try testing.expectEqual(10.0, sample.value, "the mean as its value")
				}
			}
			try testing.expectEqual(2, seen, "both metrics read from Diagnostics")
			let labelled = batch.metrics.filter(sample => sample.name == "telemetry.test.routes")
			try testing.expectEqual(1, labelled.len(), "a series with labels is read under its name")
			try testing.expectEqual("/orders", labelled[0].labels["route"], "with its labels")
			try testing.expectEqual("1", labelled[0].unit, "its unit")
			try testing.expectEqual("Routes hit", labelled[0].description, "its description")
			try testing.expectEqual(uint64(1), labelled[0].count, "and a counter's exact count")
			let messages = batch.logs.mapElem(entry => entry.message)
			try testing.expectTrue(messages.includes("card declined") && messages.includes("out of disk"), "the records Logging accepted")
			try testing.expectEqual(1, batch.errors.len(), "a fatal record is an error report too")
			try testing.expectTrue(batch.errors[0].fatal, "one that ended the program")
			try testing.expectEqual("out of disk", batch.errors[0].message, "with the record's message")
			return none
		}

		@test()
		def spans() !none {
			let collector = try restartWith(quiet())
			let outer = Telemetry.span("checkout", {"cart": 3})
			let inner = Telemetry.span("charge", parent = outer.context())
			inner.event("card.read")
			inner.set("amount", 12)
			inner.end()
			inner.end()
			outer.end()
			try testing.expectEqual(4, timedWork(2), "an annotated function still returns its result")
			timedFailure() onerror recover none

			let header = outer.traceparent()
			let parsed = parseTraceparent(header)
			fail "a span's own header parses" when parsed is none
			try testing.expectEqual(outer.context().trace, parsed.trace, "trace id round trip")
			try testing.expectEqual(outer.context().span, parsed.span, "span id round trip")
			try testing.expectTrue(parsed.sampled, "recorded")
			try testing.expectNone(parseTraceparent("00-00000000000000000000000000000000-00f067aa0ba902b7-01"), "an all-zero trace id is invalid")
			try testing.expectNone(parseTraceparent("garbage"), "not a header")
			let remote = parseTraceparent("00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-00")
			fail "the W3C example parses" when remote is none
			try testing.expectFalse(remote.sampled, "flag 00 is not recorded")
			let unrecorded = Telemetry.span("handled", parent = remote)
			unrecorded.end()

			try Telemetry.flush()
			let recorded = collector.batches[0].spans
			let names = recorded.mapElem(timed => timed.name)
			try testing.expectEqual("charge,checkout,std.services.telemetry.timedWork,test.named", names.join(","), "spans in the order they ended, the unrecorded trace left out")
			try testing.expectEqual(recorded[1].context.trace, recorded[0].context.trace, "a child is in its parent's trace")
			try testing.expectEqual(recorded[1].context.span, recorded[0].parent, "and names its parent")
			try testing.expectEqual("", recorded[1].parent, "the first span has none")
			try testing.expectEqual(32, recorded[0].context.trace.len(), "trace id length")
			try testing.expectEqual(16, recorded[0].context.span.len(), "span id length")
			try testing.expectEqual("card.read", recorded[0].events[0].name, "span events")
			try testing.expectEqual(12, int(recorded[0].attributes["amount"]), "span attributes")
			try testing.expectTrue(recorded[0].end >= recorded[0].start, "ended after it began")
			try testing.expectFalse(recorded[2].failed, "a call that returns is not failed")
			try testing.expectTrue(recorded[3].failed, "a call that fails is")
			try testing.expectTrue(remote.remote, "a parsed header names another program's span")
			try testing.expectFalse(outer.context().remote, "a span begun here does not")
			try testing.expectFalse(recorded[0].parentRemote || recorded[1].parentRemote, "nor do the spans of a trace begun here")

			let caller = parseTraceparent("00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01")
			fail "a recorded header parses" when caller is none
			let handled = Telemetry.span("handled", parent = caller)
			Telemetry.span("lookup").end()
			handled.end()
			try Telemetry.flush()
			let continued = collector.batches[collector.batches.len() - 1].spans
			try testing.expectEqual("lookup,handled", continued.mapElem(timed => timed.name).join(","), "a continued trace is recorded")
			try testing.expectTrue(continued[1].parentRemote, "its first span here has another program's parent")
			try testing.expectFalse(continued[0].parentRemote, "a span inside it has a parent here")

			let settings = quiet()
			settings.sampling = 0.0
			let silent = try restartWith(settings)
			Telemetry.span("unsampled").end()
			Telemetry.event("still.sent")
			try Telemetry.flush()
			try testing.expectEqual(0, silent.batches[0].spans.len(), "sampling 0 records no trace")
			try testing.expectEqual(1, silent.batches[0].events.len(), "and leaves the other signals alone")
			return none
		}

		@test()
		def aRefusedBatchIsKeptInMemory() !none {
			failuresSeen.flush()
			let collector = try restartWith(quiet())
			collector.refusing = true
			Telemetry.event("first")
			let refused = false
			Telemetry.flush() onerror (err error) {
				refused = true
				recover none
			}
			try testing.expectTrue(refused, "flush fails when the exporter refuses")
			let timeout = time.sleepChan(2s)
			select {
				case failuresSeen:
					try testing.expectEqual(100,<-failuresSeen, "exportFailed names the batch's size")
				case timeout:
					fail "exportFailed was not emitted"
			}
			Telemetry.event("second")
			collector.refusing = false
			try Telemetry.flush()
			try testing.expectEqual("first,second", collector.eventNames().join(","), "the kept batch goes first")
			try testing.expectEqual(0, Telemetry.dropped(), "nothing was lost")
			return none
		}

		@test()
		def aRefusedBatchSurvivesARestartOnDisk() !none {
			let settings = quiet()
			settings.spool = true
			let collector = try restartWith(settings)
			collector.refusing = true
			Telemetry.event("kept.on.disk", {"n": 5})
			Telemetry.flush() onerror recover none
			let spool = os.join(try Application.home(), "telemetry", "spool")
			let kept = try os.readDir(spool, 0)
			try testing.expectEqual(1, kept.len(), "the batch is a file in the spool")

			let later = try restartWith(settings)
			Telemetry.event("after.restart")
			try Telemetry.flush()
			try testing.expectEqual("kept.on.disk,after.restart", later.eventNames().join(","), "sent by the next run, before its own")
			try testing.expectEqual(5, int(later.batches[0].events[0].properties["n"]), "with its properties")
			try testing.expectTrue(collector.closed, "stop closed the earlier exporter")
			let left = try os.readDir(spool, 0)
			try testing.expectEqual(0, left.len(), "and the file is gone")
			return none
		}

		@test()
		def capacityScrubAndInterval() !none {
			let settings = quiet()
			settings.capacity = 2
			settings.scrub = def (batch TelemetryBatch) TelemetryBatch {
				batch.events = batch.events.filter(used => used.name != "secret")
				return batch
			}
			let collector = try restartWith(settings)
			let before = Telemetry.dropped()
			Telemetry.event("kept")
			Telemetry.event("secret")
			Telemetry.event("over.capacity")
			try testing.expectEqual(before + 1, Telemetry.dropped(), "a record beyond capacity is dropped and counted")
			try Telemetry.flush()
			try testing.expectEqual("kept", collector.eventNames().join(","), "scrub edits the batch before the exporters")

			settings = quiet()
			settings.interval = 30ms
			let timed = try restartWith(settings)
			Telemetry.event("on.the.timer")
			let waited = 0
			for timed.batches.len() == 0 && waited < 100 {
				time.sleep(10ms)
				waited++
			}
			try testing.expectEqual("on.the.timer", timed.eventNames().join(","), "a batch goes out every interval without a flush")
			return none
		}

		@test()
		def refusedSettings() !none {
			try await Telemetry.stop()
			for let (_, bad) in [TelemetryConfig{sampling: 1.5}, TelemetryConfig{interval: 0s}, TelemetryConfig{batch: 0}, TelemetryConfig{capacity: 0}, TelemetryConfig{spoolSize: 0}] {
				let refused = false
				Telemetry.config(bad) onerror (err error) {
					refused = true
					recover none
				}
				try testing.expectTrue(refused, "a setting out of range is refused")
			}
			return none
		}

		@test()
		def fileAndConsoleExporters() !none {
			try await Telemetry.stop()
			let path = os.join(try Application.home(), "telemetry-test.jsonl")
			os.remove(path, false) onerror recover none
			let settings = quiet()
			settings.exporters = [new FileExporter(path), new ConsoleExporter()]
			try Telemetry.config(settings)
			try await Telemetry.start()
			Telemetry.event("to.a.file", {"n": 1})
			try Telemetry.flush()
			Telemetry.event("second.line")
			try Telemetry.flush()
			try await Telemetry.stop()
			let lines = string(try os.readFile(path)).trim().split("\n")
			try testing.expectEqual(2, lines.len(), "one line per batch")
			let read = TelemetryBatch{}
			try (new JSON()).decode(lines[0], read)
			try testing.expectEqual("to.a.file", read.events[0].name, "each line reads back as a batch")
			try testing.expectFalse(read.resource["session.id"].isEmpty(), "with its resource")
			return none
		}

		@test()
		def aFreshStartHasNoAnswer() !none {
			try await Telemetry.stop()
			try await Vault.start()
			try Vault.remove("telemetry.consent")
			let collector = new Collector()
			try Telemetry.config(TelemetryConfig{exporters: [collector], spool: false, interval: 1h, signals: [TelemetrySignal.Events]})
			try await Telemetry.start()
			try testing.expectNone(Telemetry.consented(), "a user who was never asked has no answer")
			try testing.expectEqual("", Telemetry.installation(), "and no installation id")
			Telemetry.event("unasked")
			try Telemetry.flush()
			try testing.expectEqual(0, collector.eventNames().len(), "nothing is collected until they answer")
			return none
		}

		@test()
		def recordedSpans() !none {
			let collector = try restartWith(quiet())
			let trace = "4bf92f3577b34da6a3ce929d0e0e4736"
			Telemetry.record(SpanRecord{context: SpanContext{trace: trace, span: "00f067aa0ba902b7", sampled: true}, name: "built.by.hand", start: 10, end: 20})
			Telemetry.record(SpanRecord{context: SpanContext{trace: trace, span: "1111111111111111", sampled: false}, name: "unrecorded", start: 10, end: 20})
			try Telemetry.flush()
			let names = collector.batches[0].spans.mapElem(timed => timed.name)
			try testing.expectEqual("built.by.hand", names.join(","), "a span built by the caller is sent unless its trace is not recorded")
			return none
		}

		@test()
		def nestedSpans() !none {
			let settings = quiet()
			settings.signals = [TelemetrySignal.Logs, TelemetrySignal.Errors, TelemetrySignal.Spans]
			let collector = try restartWith(settings)
			try testing.expectNone(Telemetry.current(), "no current span outside any")
			let outer = Telemetry.span("outer")
			let inner = Telemetry.span("inner")
			let now = Telemetry.current()
			fail "a span begun is current" when now is none
			try testing.expectEqual(inner.context().span, now.context().span, "the last one begun")
			os.readFile("/nonexistent/telemetry") onerror (err error) {
				Telemetry.report(err)
				recover byte[]
			}
			Logging.error("inside the inner span")
			let started = async spanInTask()
			try testing.expectEqual(inner.context().span, await started, "a task started with async is inside its starter's span")
			inner.end()
			let back = Telemetry.current()
			fail "ending a span makes the one around it current" when back is none
			try testing.expectEqual(outer.context().span, back.context().span, "the one that was current before")
			try testing.expectEqual(8, nestedWork(2), "annotated functions nest too")
			outer.end()
			try testing.expectNone(Telemetry.current(), "and none after the outermost ends")

			try Logging.flush()
			try Telemetry.flush()
			let batch = collector.batches[0]
			let recorded = batch.spans
			let inside = try spanNamed(recorded, "inner")
			let task = try spanNamed(recorded, "in.task")
			let caller = try spanNamed(recorded, "std.services.telemetry.nestedWork")
			let callee = try spanNamed(recorded, "std.services.telemetry.timedWork")
			try testing.expectEqual(outer.context().span, inside.parent, "a span begun inside another is its child")
			try testing.expectEqual(inside.context.span, task.parent, "as is one begun in a task started there")
			try testing.expectEqual(outer.context().span, caller.parent, "an annotated function is a child of the current span")
			try testing.expectEqual(caller.context.span, callee.parent, "and the parent of what it calls")
			for let (_, timed) in recorded {
				try testing.expectEqual(outer.context().trace, timed.context.trace, "all in one trace")
			}
			let within = batch.errors[0].span
			fail "an error reported inside a span names it" when within is none
			try testing.expectEqual(inside.context.span, within.span, "the span that was current")
			try testing.expectEqual(outer.context().trace, within.trace, "and its trace")
			let entry = batch.logs.filter(written => written.message == "inside the inner span")
			try testing.expectEqual(1, entry.len(), "the record written inside the span")
			try testing.expectEqual(outer.context().trace, entry[0].trace, "carries its trace")
			try testing.expectEqual(inside.context.span, entry[0].span, "and its span")
			return none
		}

		@test()
		def partOfABatchIsKept() !none {
			failuresSeen.flush()
			let collector = try restartWith(quiet())
			let before = Telemetry.dropped()
			Telemetry.event("arrived")
			Telemetry.event("refused")
			Telemetry.event("later")
			collector.failure = ExportFailure{message: "took one, refused one", rest: TelemetryBatch{events: [UsageEvent{name: "later"}]}, rejected: 1}
			let failed = false
			Telemetry.flush() onerror (err error) {
				failed = true
				recover none
			}
			try testing.expectTrue(failed, "flush fails when part of the batch did not arrive")
			try testing.expectEqual(before + 1, Telemetry.dropped(), "what the receiver refused for good is dropped")
			let timeout = time.sleepChan(2s)
			select {
				case failuresSeen:
					try testing.expectEqual(201,<-failuresSeen, "exportFailed counts what did not arrive and what was refused")
				case timeout:
					fail "exportFailed was not emitted"
			}
			try Telemetry.flush()
			try testing.expectEqual("later", collector.eventNames().join(","), "only the rest is sent again")

			Telemetry.event("held")
			collector.failure = ExportFailure{message: "busy", rest: TelemetryBatch{events: [UsageEvent{name: "held"}]}, retryAfter: 300ms}
			Telemetry.flush() onerror recover none
			let asked = collector.asked
			Telemetry.event("behind")
			Telemetry.flush() onerror recover none
			try testing.expectEqual(asked, collector.asked, "an exporter whose receiver asked for a pause is left alone")
			time.sleep(350ms)
			try Telemetry.flush()
			try testing.expectEqual("later,held,behind", collector.eventNames().join(","), "and gets what was kept once the pause is over")
			try testing.expectEqual(before + 1, Telemetry.dropped(), "with nothing more lost")
			return none
		}

		@test()
		def keptBatchesFollowTheExporterByName() !none {
			try await Telemetry.stop()
			let first = new Collector()
			first.label = "first"
			let second = new Collector()
			second.label = "second"
			second.refusing = true
			let settings = quiet()
			settings.spool = true
			settings.exporters = [first, second]
			try Telemetry.config(settings)
			try await Telemetry.start()
			Telemetry.event("second.missed.it")
			Telemetry.flush() onerror recover none
			try testing.expectEqual("second.missed.it", first.eventNames().join(","), "one exporter took the batch")
			try await Telemetry.stop()

			let secondAgain = new Collector()
			secondAgain.label = "second"
			let firstAgain = new Collector()
			firstAgain.label = "first"
			settings.exporters = [secondAgain, firstAgain]
			try Telemetry.config(settings)
			try await Telemetry.start()
			Telemetry.event("after.reorder")
			try Telemetry.flush()
			try testing.expectEqual("second.missed.it,after.reorder", secondAgain.eventNames().join(","), "the kept batch returns to the exporter of that name, wherever it is listed")
			try testing.expectEqual("after.reorder", firstAgain.eventNames().join(","), "and to no other")

			try await Telemetry.stop()
			let twin = new Collector()
			twin.label = "first"
			settings.exporters = [firstAgain, twin]
			let refused = false
			Telemetry.config(settings) onerror (err error) {
				refused = err.message.contains("first")
				recover none
			}
			try testing.expectTrue(refused, "two exporters of one name are refused")
			return none
		}

		@test()
		def theSpoolStaysWithinItsSize() !none {
			let settings = quiet()
			settings.spool = true
			let collector = try restartWith(settings)
			collector.refusing = true
			Telemetry.event("oldest.a")
			Telemetry.event("oldest.b")
			Telemetry.flush() onerror recover none
			let spool = os.join(try Application.home(), "telemetry", "spool")
			let kept = try os.readDir(spool, 0)
			try testing.expectEqual(1, kept.len(), "the batch is kept")
			let size = int((try os.stat(kept[0].path, true)).size)

			// Room for one such batch, not for two.
			settings.spoolSize = size + size / 2
			try Telemetry.config(settings)
			let before = Telemetry.dropped()
			Telemetry.event("newest.a")
			Telemetry.event("newest.b")
			Telemetry.flush() onerror recover none
			let left = try os.readDir(spool, 0)
			try testing.expectEqual(1, left.len(), "the oldest kept batch makes room")
			try testing.expectEqual(before + 2, Telemetry.dropped(), "and each of its records counts as lost")
			collector.refusing = false
			try Telemetry.flush()
			try testing.expectEqual("newest.a,newest.b", collector.eventNames().join(","), "the newest is what is sent")
			return none
		}

		@test()
		def labConditions() !none {
			let settings = quiet()
			let collector = try restartWith(settings)
			Telemetry.lab.conditions.unreachable = true
			Telemetry.event("while.away")
			let failed = false
			Telemetry.flush() onerror (err error) {
				failed = true
				recover none
			}
			try testing.expectTrue(failed, "no exporter takes a batch while the lab has them unreachable")
			try testing.expectEqual(0, collector.asked, "and none is asked")
			Telemetry.lab.reset()
			try Telemetry.flush()
			try testing.expectEqual("while.away", collector.eventNames().join(","), "the batch was kept and goes out afterwards")

			settings.spool = true
			let spooling = try restartWith(settings)
			spooling.refusing = true
			Telemetry.lab.conditions.spoolFails = true
			Telemetry.event("in.memory")
			Telemetry.flush() onerror recover none
			let files = os.readDir(os.join(try Application.home(), "telemetry", "spool"), 0) onerror recover os.DirEntry[]
			try testing.expectEqual(0, files.len(), "a spool that cannot be written leaves the batch in memory")
			Telemetry.lab.reset()
			spooling.refusing = false
			try Telemetry.flush()
			try testing.expectEqual("in.memory", spooling.eventNames().join(","), "from where it is sent")
			return none
		}

		@test()
		def whatTheConsolePrints() !none {
			let lines = consoleLines(TelemetryBatch{
				metrics: [
					MetricSample{name: "http.requests", kind: "counter", count: 42, value: 42.0, labels: {"route": "/orders"}},
					MetricSample{name: "queue.depth", kind: "gauge", value: 3.5},
				],
				logs:   [LogRecord{level: LogLevel.Error, message: "card declined", fields: {"order": 7}}, LogRecord{message: "plain"}],
				errors: [ErrorReport{message: "boom", kind: "error"}],
				events: [UsageEvent{name: "export.finished", properties: {"format": "pdf"}}],
				spans:  [SpanRecord{name: "checkout", start: 0, end: 12500000}, SpanRecord{name: "charge", start: 0, end: 1000000, failed: true}],
			})
			let expected = [
				"telemetry metric http.requests counter 42 \{\"route\":\"/orders\"\}",
				"telemetry metric queue.depth gauge 3.5",
				"telemetry log error \"card declined\" \{\"order\":7\}",
				"telemetry log - \"plain\" \{\}",
				"telemetry error \"boom\" error \{\}",
				"telemetry event export.finished \{\"format\":\"pdf\"\}",
				"telemetry span checkout 12.5ms",
				"telemetry span charge 1ms failed",
			]
			try testing.expectEqual(expected.join("\n"), lines.join("\n"), "one line per record")
			return none
		}
	}
}
