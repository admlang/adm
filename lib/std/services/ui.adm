partial module std.services {
	use (
		std.time
		std.gfx.canvas::DrawContext
		std.gfx.color
		std.formats.image
		std.ui
		std.ui.renderer.opengl
		std.ui.renderer.cpu
		std.ui.renderer.vulkan
		std.ui.renderer.directx
		std.ui.renderer as r
		std.ui.renderer::(PlatformEventKind, getRenderer)
		std.reflection
	)

	// UIConfig controls how the UI service initializes and which renderer backend it uses.
	type UIConfig {
		// renderer provides platform windows, per-frame surfaces, and low-level input events.
		// If it is `none`, `UI.start()` fails.
		renderer ?r.Renderer = none

		// rendererName selects a renderer annotated with `@renderer(name=...)`.
		// It is only used when `renderer` is not provided.
		rendererName string = ""

		// defaultWindow is used when callers don't supply a window config.
		defaultWindow r.WindowConfig = new r.WindowConfig()

		// exitOnLastWindowClose determines whether the UI service should request application exit
		// when the last window is closed.
		exitOnLastWindowClose bool = true

		// show FPS information
		showFPS bool = false
	}

	internal type FPSState {
		last     time.Time
		frames   int
		lastText string
	}

	service UI {
		description           = "UI service owns windows, event dispatch, and rendering orchestration."
		dependencies          = Dependencies{hard: [Runtime]}
		lifecycle             = Lifecycle{start: StartMode.Manual, restart: RestartMode.Always}
		permissions  string[]

		internal cfg        UIConfig
		internal hasConfig  bool
		internal running    bool
		internal wins       r.Window[]
		internal roots      map<uint, ui.ComponentRenderer>
		internal baseTitles map<uint, string>
		internal fps        map<uint, FPSState>
		internal frameTimes map<uint, time.Time>

		internal def isConfigured() bool {
			return hasConfig || !(cfg.renderer is none) || cfg.rendererName.len() != 0
		}

		// Configure the UI service using the standard UIConfig schema.
		def config(val UIConfig) !none {
			cfg = val
			hasConfig = true
			return none
		}

		async def start() !none {
			status = ServiceStatus.Starting
			defer def () {
				println("UI start status {status}")
			}()

			fail "UI must be configured before start" unless isConfigured()

			let resolved = cfg.renderer
			if resolved is none {
				fail "UI renderer must be configured (renderer or rendererName)" when cfg.rendererName.len() == 0

				let found = getRenderer(cfg.rendererName)
				fail "UI renderer '{cfg.rendererName}' not found" when found is none

				resolved = found
			}

			fail "UI renderer must be configured (renderer or rendererName)" when resolved is none
			cfg.renderer = resolved
			hasConfig = true
			running = true
			roots = map<uint, ui.ComponentRenderer>{}
			baseTitles = map<uint, string>{}
			fps = map<uint, FPSState>{}
			frameTimes = map<uint, time.Time>{}
			// The service manager only tracks services it starts itself; a UI
			// started directly by the application keeps its own status honest.
			status = ServiceStatus.Started
			return none
		}

		async def stop() !none {
			return none unless running
			// Close every window the renderer still holds; the renderer itself
			// has no shutdown call, its windows are its only resources.
			let open r.Window[] = []
			for let (_, w) in wins {
				open.push(w)
			}
			for let (_, w) in open {
				closeWindow(w) onerror recover none
			}
			running = false
			status = ServiceStatus.Stopped
			return none
		}

		async def restart() !none {
			try await stop()
			try await start()
			return none
		}

		// Create a new window using the currently configured renderer backend.
		// The returned window handle is stable for the lifetime of the window.
		@commit()
		def openWindow(cfg r.WindowConfig) !r.Window {
			fail "UI service is not running" unless running
			fail "UI renderer is not configured" when self.cfg.renderer is none

			let ren = self.cfg.renderer
			fail "UI renderer is not configured" when ren is none

			let win = try ren.openWindow(cfg)
			wins.push(win)
			baseTitles = baseTitles.set(win.id(), cfg.title)
			return win
		}

		// Open a window and register a root component that the UI service will render.
		@commit()
		def openWindow<T: component>(root T, cfg r.WindowConfig) !r.Window {
			let win = try openWindow(cfg)
			let renderable ui.ComponentRenderer = root
			roots = roots.set(win.id(), renderable)
			return win
		}

		// Open a window using `UIConfig.defaultWindow`.
		@commit()
		def openDefaultWindow() !r.Window {
			return openWindow(cfg.defaultWindow)
		}

		// Open a window using `UIConfig.defaultWindow` and register a root component.
		@commit()
		def openDefaultWindow<T: component>(root T) !r.Window {
			return openWindow(root, cfg.defaultWindow)
		}

		// Close a previously opened window.
		@commit()
		def closeWindow(win r.Window) !none {
			fail "UI service is not running" unless running
			fail "UI renderer is not configured" when cfg.renderer is none

			let ren = cfg.renderer
			fail "UI renderer is not configured" when ren is none

			try ren.closeWindow(win)

			let out r.Window[]
			for let (_, w) in wins {
				out.push(w) unless w.id() == win.id()
			}
			wins = out
			roots = roots.delete(win.id()) when roots.hasKey(win.id())
			baseTitles = baseTitles.delete(win.id()) when baseTitles.hasKey(win.id())
			fps = fps.delete(win.id()) when fps.hasKey(win.id())
			frameTimes = frameTimes.delete(win.id()) when frameTimes.hasKey(win.id())
			return none
		}

		// Sets a window's title.
		@commit()
		def setWindowTitle(win r.Window, title string) !none {
			fail "UI service is not running" unless running
			fail "UI renderer is not configured" when cfg.renderer is none

			let ren = cfg.renderer
			fail "UI renderer is not configured" when ren is none

			let id = win.id()
			baseTitles = baseTitles.set(id, title)
			if cfg.showFPS && fps.hasKey(id) {
				let state = fps[id]
				if state.lastText.len() != 0 {
					return ren.setWindowTitle(win, sprintf("%s (%s)", title, state.lastText))
				}
			}
			return ren.setWindowTitle(win, title)
		}

		// Sets a window's icon.
		@commit()
		def setWindowIcon(win r.Window, icon image.Image) !none {
			fail "UI service is not running" unless running
			fail "UI renderer is not configured" when cfg.renderer is none

			let ren = cfg.renderer
			fail "UI renderer is not configured" when ren is none

			return ren.setWindowIcon(win, icon)
		}

		// Snapshot of currently tracked windows.
		@query()
		def windows() r.Window[] {
			return wins
		}

		// pollPlatformEvents retrieves low-level events for a given window from the configured renderer.
		// This does not emit any `std.ui` events; use pumpEvents/pumpAll to translate + emit.
		@query()
		def pollPlatformEvents(win r.Window) !r.PlatformEvent[] {
			fail "UI service is not running" unless running
			fail "UI renderer is not configured" when cfg.renderer is none

			let ren = cfg.renderer
			fail "UI renderer is not configured" when ren is none

			return ren.pollEvents(win)
		}

		internal def renderOne(win r.Window) !none {
			fail "UI renderer is not configured" when cfg.renderer is none
			let ren = cfg.renderer
			fail "UI renderer is not configured" when ren is none

			return none unless roots.hasKey(win.id())
			let renderable = roots[win.id()]

			let frame r.Frame = try ren.nextFrame(win)
			let ctx = frame.ctx
			// TODO: theme/background comes from style; default to dark gray for now.
			ctx.clear(new color.Color(color.RGBA{r: 50, g: 50, b: 50, a: 255}))
			let now = time.now()
			let delta = 0s
			if frameTimes.hasKey(win.id()) {
				delta = now.since(frameTimes[win.id()])
			}
			frameTimes = frameTimes.set(win.id(), now)
			ctx.setFrameTiming(delta, now)
			renderable.render(ctx)

			try ren.commit(win, frame)

			try updateFpsTitle(win, ren) when cfg.showFPS
			return none
		}

		internal def updateFpsTitle(win r.Window, ren r.Renderer) !none {
			return none unless cfg.showFPS

			let id = win.id()
			let now = time.now()

			if !fps.hasKey(id) {
				fps = fps.set(id, FPSState{last: now, frames: 0, lastText: ""})
			}

			let state = fps[id]
			state.frames = state.frames + 1

			let elapsed = now.since(state.last)
			if elapsed < 1s {
				fps = fps.set(id, state)
				return none
			}

			let secs = float(elapsed) / float(1s)
			let value = float(state.frames) / secs
			state.last = now
			state.frames = 0
			state.lastText = sprintf("%.1f FPS", value)
			fps = fps.set(id, state)

			let base = cfg.defaultWindow.title
			base = baseTitles[id] when baseTitles.hasKey(id)
			let title = sprintf("%s (%s)", base, state.lastText)
			let _ = ren.setWindowTitle(win, title)
			return none
		}

		// run opens a window for `root` and blocks (async) until the user closes it.
		// This is a convenience entrypoint for apps that want a single main window.
		@commit()
		async def run<T: component>(root T, cfg r.WindowConfig) !none {
			fail "UI must be configured before run" unless isConfigured()
			fail "UI service is not running" unless running

			let win = try openWindow(root, cfg)

			for {
				let evts = try pollPlatformEvents(win)
				let shouldClose = false
				for let (_, evt) in evts {
					shouldClose = true when evt.kind == PlatformEventKind.Close
					try pumpOne(win, evt)
				}

				break when shouldClose
				try renderOne(win)

				// Avoid pegging a core if vsync is disabled.
				time.sleep(1ms) when cfg.vsync == false
			}

			closeWindow(win)
			return none
		}

		// run opens a window for `root` using `UIConfig.defaultWindow` and blocks until close.
		@commit()
		async def run<T: component>(root T) !none {
			return await run(root, cfg.defaultWindow)
		}

		internal def pumpOne(win r.Window, evt r.PlatformEvent) !none {
			match evt.kind {
				case PlatformEventKind.Close:
					let _ = close(ui.CloseEvent{reason: "request"})
				case PlatformEventKind.Resize:
					let _ = resize(ui.ResizeEvent{size: evt.size})
				case PlatformEventKind.MouseMove:
					let _ = mouseMove(ui.MouseMoveEvent{target: "", position: evt.position, delta: evt.delta})
				case PlatformEventKind.MouseWheel:
					let _ = mouseWheel(ui.MouseWheelEvent{target: "", position: evt.position, delta: evt.delta})
				case PlatformEventKind.MouseUp:
					let _ = click(ui.ClickEvent{target: "", position: evt.position, button: evt.button, clicks: 1})
				case PlatformEventKind.KeyDown:
					let _ = keyDown(ui.KeyEvent{target: "", key: evt.key})
				case PlatformEventKind.KeyUp:
					let _ = keyUp(ui.KeyEvent{target: "", key: evt.key})
				case PlatformEventKind.TextInput:
					let _ = textInput(ui.TextInputEvent{target: "", rune: evt.rune})
				default:
			}
			return none
		}

		// pumpEvents polls the platform renderer for `win` and emits high-level UI events.
		// The returned list is the raw platform events consumed.
		@commit()
		def pumpEvents(win r.Window) !r.PlatformEvent[] {
			let evts = try pollPlatformEvents(win)
			for let (_, evt) in evts {
				try pumpOne(win, evt)
			}
			return evts
		}

		// pumpAll polls every tracked window and emits high-level UI events.
		@commit()
		def pumpAll() !none {
			fail "UI service is not running" unless running
			for let (_, win) in wins {
				let _ = try pumpEvents(win)
			}
			return none
		}

		// Emits a click event resolved to a target component/selector.
		@emit()
		def click(evt ui.ClickEvent) ui.ClickEvent {
			return evt
		}

		// Emits a pointer move event resolved to a target component/selector.
		@emit()
		def mouseMove(evt ui.MouseMoveEvent) ui.MouseMoveEvent {
			return evt
		}

		// Emits a scroll event (wheel / trackpad).
		@emit()
		def mouseWheel(evt ui.MouseWheelEvent) ui.MouseWheelEvent {
			return evt
		}

		// Emits a resize event for a window.
		@emit()
		def resize(evt ui.ResizeEvent) ui.ResizeEvent {
			return evt
		}

		// Emits a close request event.
		@emit()
		def close(evt ui.CloseEvent) ui.CloseEvent {
			return evt
		}

		// Emits a key down event.
		@emit()
		def keyDown(evt ui.KeyEvent) ui.KeyEvent {
			return evt
		}

		// Emits a key up event.
		@emit()
		def keyUp(evt ui.KeyEvent) ui.KeyEvent {
			return evt
		}

		// Emits text input events (character input).
		@emit()
		def textInput(evt ui.TextInputEvent) ui.TextInputEvent {
			return evt
		}
	}
	/*
	
	windows
	displays
	input
	clipboard
	renderer
	component tree
	focus
	cursor
	DPI/scaling
	
	*/
}
