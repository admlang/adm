partial module std.services {
	// Secure, integrity-protected persistent storage for trusted application state.
	service Vault {
		description           = ""
		dependencies          = Dependencies{
			hard: [Storage, Policy],
			soft: []
		}
		lifecycle             = Lifecycle{
			start: StartMode.Manual,
			restart: RestartMode.Always,
		}
		permissions  string[]

		def config<T>(val T) !none {}

		async def start() !none {
			// Secrets are scoped to `__app_id__`, which the compiler always fills:
			// from `adm.toml` when present, else from the application name.
			return none
		}

		async def stop() !none {
			return none
		}

		async def restart() !none {
			return none
		}
	}
	/*
	    credentials
	    tokens
	    private keys
	    secrets
	    encryption keys
	    permissions
	    user approvals
	
	
	    secret value
	    encrypted secret value
	    decrypted secret value
	    encrypted / decrypted secret value
	
	    secret value
	        encrypted + authenticated
	
	    trusted value
	        authenticated / integrity protected
	        encryption optional
	
	*/
}
