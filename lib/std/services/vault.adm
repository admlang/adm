partial module std.services {
	// Secure, integrity-protected persistent storage for trusted application state.
	service Vault {
		description               = ""
		dependencies              = Dependencies{
			hard: [Storage, Policy],
			soft: []
		}
		lifecycle                 = Lifecycle{
			start: StartMode.Manual,
			restart: RestartMode.Always,
		}
		permissions  Permission[]

		// Applies the service's settings. There are none yet, and it does not fail.
		def config<T>(val T) !none {}

		// Starts the service. Does not fail today.
		async def start() !none {
			// Secrets are scoped to `__app_id__`, which the compiler always fills:
			// from `adm.toml` when present, else from the application name.
			return none
		}

		// Stops the service. Does not fail today.
		async def stop() !none {
			return none
		}

		// Stops the service and starts it again. Does not fail today.
		async def restart() !none {
			return none
		}
	}
	/*
	    credentials
	    tokens
	    private keys
	    secrets
	    encryption keys
	    permissions
	    user approvals
	
	
	    secret value
	    encrypted secret value
	    decrypted secret value
	    encrypted / decrypted secret value
	
	    secret value
	        encrypted + authenticated
	
	    trusted value
	        authenticated / integrity protected
	        encryption optional
	
	*/
}
