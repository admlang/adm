// What a program keeps between runs: the `@persist(key)` fields of types, services and
// components, and the placement of the windows `std.ui` opens with `WindowConfig.persist`.
// Each is a value of the application's vault (`std.services.vault`), named `persist.<key>`.
internal std partial module std.services.vault.kept {
	use (
		std.services::(Dependencies, Lifecycle, RestartMode, StartMode)
		std.services.ipc::(pack, unpack)
		std.services.vault::Vault
		std.sync
		std.time
	)

	// Under which every kept value is named in the vault.
	const keptPrefix = "persist."

	// The prefix of version 0.1.2194. A value found under it is moved to `keptPrefix`.
	const keptPrefixBefore = "ui.persist."

	// The longest key: what a vault name holds after the longer of the two prefixes.
	const keptKeyMax = 244

	// How long a changed value waits for another change before it is written: a
	// divider being dragged writes the vault once, when it rests.
	const keepDelay = 500ms

	// Whether a value can be kept under `key`: 1 to 244 letters, digits, '.', '_' and '-'.
	def keepable(key string) bool {
		return false when key.len() == 0 || key.len() > keptKeyMax
		for let c in key {
			continue when c.isLetter() || c.isDigit() || c == '.' || c == '_' || c == '-'
			return false
		}
		return true
	}

	// What is stored for a key: the value in a struct, so that a kept `none` (an optional
	// field that was cleared) reads back as a value that is there.
	struct Kept<T> {
		value T
	}

	// What a change asks of whoever made it.
	enum AfterChange {
		// It waits with the others.
		Nothing,
		// A task is to be started that writes the waiting changes once they rest.
		StartWriter,
		// The service has stopped: the change is written at once.
		WriteNow,
	}

	// Held in place of a value for a key the vault holds nothing readable for.
	struct NothingKept {
		key string
	}

	// A change that is not written yet: what writes it, and which change of the run it
	// is, so that writing it does not count a later change of its key as written.
	struct WaitingChange {
		write  def () !none
		number int
	}

	// The changes `Persistence.pending` hands over: each one by key, and the keys in the
	// order they first changed.
	struct WaitingValues {
		writes map<string, WaitingChange>
		order  string[]
	}

	// Held by the task that writes kept values or removes one, so that one task does it
	// at a time: a value is never overwritten by an earlier one another task was still
	// writing, and `writeKept` returns once what waited is in the vault, whichever task
	// had started to write it.
	internal let writeLock = new sync.Mutex()

	// Opens the vault for kept values once a run; a task that asks while it opens waits.
	internal let opening = new sync.Once()

	// The kept values of this run: the ones read or changed, in the vault's encoding, and
	// the changes that are not written yet. Stopping it writes them, which is how a
	// change made in the last half second of a run is kept.
	service Persistence {
		description               = "The values a program keeps between runs"
		dependencies              = Dependencies{
			hard: [Vault],
			soft: []
		}
		lifecycle                 = Lifecycle{
			start: StartMode.Manual,
			restart: RestartMode.Never,
		}
		permissions  Permission[]

		// The encoded value of each key read or changed in this run, and the keys known
		// to hold none.
		held    map<string, byte[]>
		absent  map<string, bool>
		// The value itself, for the keys read or kept through `restoredPlain` and
		// `keepPlain`; a `NothingKept` for one the vault holds nothing readable for.
		plain   map<string, any>
		// The changes not written yet (one being written included), how many changes
		// the run made, and when the last of them was made.
		writes  map<string, WaitingChange>
		order   string[]
		made    int
		touched ?time.Time                 = none
		// A task is waiting for them to rest, and how long they rest before it writes.
		writing bool
		rest    duration                   = keepDelay
		// The service was stopped: nothing waits any more.
		ended   bool
		// The vault opened.
		open    bool

		// Applies the service's settings. There are none, and it does not fail.
		def config<T>(val T) !none {}

		// Does not fail: the vault is opened by the first value read or written.
		async def start() !none {
			end(false)
			return none
		}

		// Writes the changes that are waiting; a change made after it is written at
		// once. Does not fail: a value that cannot be written is given up.
		async def stop() !none {
			end(true)
			writeKept()
			return none
		}

		// Writes the changes that are waiting. Does not fail.
		async def restart() !none {
			writeKept()
			return none
		}

		// The encoded value known for `key`, none when the vault was not read for it yet
		// or holds none.
		@query()
		def recall(key string) ?byte[] {
			return held.get(key)
		}

		// The value known for `key` when it was read or kept as a plain value; a
		// `NothingKept` when the vault holds nothing readable for it.
		@query()
		def plainOf(key string) ?any {
			return plain.get(key)
		}

		// Records the plain value of `key`, or the `NothingKept` that stands for none.
		@commit()
		def learnPlain(key string, value any) {
			plain = plain.set(key, value)
		}

		// Records that the service was stopped, or started again.
		@commit()
		def end(stopped bool) {
			ended = stopped
		}

		// Sets how long a change rests before it is written; `keepDelay` at start.
		@commit()
		def restAfter(delay duration) {
			rest = delay
		}

		// Whether the vault is known to hold nothing for `key`.
		@query()
		def lacks(key string) bool {
			return absent.hasKey(key)
		}

		// Records what the vault holds for `key`: `data`, or nothing.
		@commit()
		def learn(key string, data ?byte[]) {
			plain = plain.delete(key) when plain.hasKey(key)
			if data is none {
				held = held.delete(key) when held.hasKey(key)
				absent = absent.set(key, true)
				return
			}
			absent = absent.delete(key) when absent.hasKey(key)
			held = held.set(key, data)
		}

		// Records a change of `key` at `now`: `data` is its value from here on, `value`
		// the same as a plain value when it was kept as one, and `write` stores it.
		// Returns what is left to the caller.
		@commit()
		def changed(key string, data byte[], value ?any, write def () !none, now time.Time) AfterChange {
			absent = absent.delete(key) when absent.hasKey(key)
			held = held.set(key, data)
			if value is none {
				plain = plain.delete(key) when plain.hasKey(key)
			} else {
				plain = plain.set(key, value)
			}
			return AfterChange.WriteNow when ended
			order.push(key) unless writes.hasKey(key)
			made += 1
			writes = writes.set(key, WaitingChange{write: write, number: made})
			touched = now
			return AfterChange.Nothing when writing
			writing = true
			return AfterChange.StartWriter
		}

		// The keys whose change is waiting, in the order they first changed.
		@query()
		def waiting() string[] {
			return order.clone()
		}

		// The waiting changes. They wait until `written` is told they were written.
		@query()
		def pending() WaitingValues {
			return WaitingValues{writes: writes, order: order.clone()}
		}

		// Records that the changes of `taken` were written or given up: each stops
		// waiting unless its key changed again since.
		@commit()
		def written(taken WaitingValues) {
			let left string[]
			for let key in order {
				let change = writes.get(key)
				let was = taken.writes.get(key)
				if !(change is none) && !(was is none) && change.number == was.number {
					writes = writes.delete(key)
				} else {
					left.push(key)
				}
			}
			order = left
			touched = none when order.len() == 0
		}

		// Forgets what is known and waiting for `key`.
		@commit()
		def drop(key string) {
			held = held.delete(key) when held.hasKey(key)
			absent = absent.delete(key) when absent.hasKey(key)
			plain = plain.delete(key) when plain.hasKey(key)
			return unless writes.hasKey(key)
			writes = writes.delete(key)
			let left string[]
			for let name in order {
				left.push(name) unless name == key
			}
			order = left
			touched = none when order.len() == 0
		}

		// How long from `now` until the waiting changes have rested for `rest`: zero
		// or less when they have, none when nothing waits. With `ending`, a none also
		// ends the wait of the task that asked.
		@commit()
		def restsIn(now time.Time, ending bool = false) ?duration {
			let last = touched
			if last is none {
				writing = false when ending
				return none
			}
			return last + rest - now
		}

		// Records whether the vault opened.
		@commit()
		def opened(did bool) {
			open = did
		}

		// Whether the vault is open.
		@query()
		def isOpen() bool {
			return open
		}
	}

	// Whether the vault is open, opening it on first use. A vault that cannot be opened
	// (no home folder, a file from another machine) is not asked again: nothing is kept
	// and nothing is restored in this run.
	def keptOpen() bool {
		opening.run(def () {
			let did = true
			await Vault.start() onerror (err error) {
				did = false
				recover none
			}
			// Started, the service is stopped with the others when the program ends, and
			// what waits is written then.
			await Persistence.start() onerror recover none
			Persistence.opened(did)
		})
		return Persistence.isOpen()
	}

	// The value the vault holds under `name`; none when there is none, and when the
	// entry does not read as `T`: it was kept as another type, by another version of
	// the program or by other code that uses the name. Such an entry is left as it is.
	def stored<T>(name string) ?Kept<T> {
		let found = Vault.load<Kept<T>>(name) onerror recover none
		return found
	}

	// `data` read as a kept `T`, none when it does not read as one.
	def decoded<T>(data byte[]) !?Kept<T> {
		return try unpack<Kept<T>>(data)
	}

	// What is kept under `key`, none when nothing is or it does not read as `T`. The
	// vault is read once for a key; later calls decode what was read or last kept, so
	// every call returns a value of its own.
	def keptValue<T>(key string) ?Kept<T> {
		let known = Persistence.recall(key)
		if !(known is none) {
			// None when the key was last kept as another type.
			let kept = decoded<T>(known) onerror recover none
			return kept
		}
		return none when Persistence.lacks(key)
		return none unless keptOpen()
		let name = keptPrefix + key
		let there = Vault.has(name) onerror recover false
		let found ?Kept<T> = none
		if there {
			found = stored<T>(name)
		} else {
			// Under the name version 0.1.2194 gave it: moved when it reads.
			found = stored<T>(keptPrefixBefore + key)
			if !(found is none) {
				let moved = true
				Vault.store<Kept<T>>(name, found) onerror (err error) {
					moved = false
					recover none
				}
				if moved {
					Vault.remove(keptPrefixBefore + key) onerror recover none
				}
			}
		}
		if found is none {
			Persistence.learn(key, none)
			return none
		}
		let data = pack<Kept<T>>(found) onerror recover []
		Persistence.learn(key, data) unless data.len() == 0
		return found
	}

	// The value kept under `key`, `fallback` when there is none or it does not read as
	// `T`. Every call returns a value of its own: an array changed in place by one
	// caller is not another's.
	//
	// A field marked `@persist(key)` starts with `restored(key, <its default>)` when
	// its type holds something a caller could change in place.
	def restored<T>(key string, fallback T) T {
		let found = keptValue<T>(key)
		return fallback when found is none
		return found.value
	}

	// `restored` for a type whose values cannot be changed in place (a number, a
	// bool, a character, a string, an enum): after the first read of a key the value
	// is answered as it is held, without decoding.
	def restoredPlain<T>(key string, fallback T) T {
		let known = Persistence.plainOf(key)
		if !(known is none) {
			// A `NothingKept`, or a value last kept as another type.
			return fallback unless known is T
			return known
		}
		let found = keptValue<T>(key)
		if found is none {
			Persistence.learnPlain(key, NothingKept{key: key})
			return fallback
		}
		Persistence.learnPlain(key, found.value)
		return found.value
	}

	// Keeps `value` under `key`: written to the vault once no kept value changed for
	// `keepDelay`, and when the program ends. A value that has no encoding is not kept.
	//
	// An assignment that changes a field marked `@persist(key)` calls it when the
	// field's type holds something a caller could change in place.
	def keep<T>(key string, value T) {
		recordKept<T>(key, value, none)
	}

	// `keep` for the types `restoredPlain` answers.
	def keepPlain<T>(key string, value T) {
		let held any = value
		recordKept<T>(key, value, held)
	}

	// Keeps `value` under `key`, with `plain` the value as `restoredPlain` answers it.
	def recordKept<T>(key string, value T, plain ?any) {
		let data = pack<Kept<T>>(Kept<T>{value: value}) onerror recover []
		return when data.len() == 0
		// What is written is the value as it was when kept: one changed in place since
		// is kept by its next assignment.
		let write = def () !none {
			return try Vault.store<Kept<T>>(keptPrefix + key, try unpack<Kept<T>>(data))
		}
		match Persistence.changed(key, data, plain, write, time.now()) {
			case AfterChange.StartWriter:
				async writeWhenRested()
			case AfterChange.WriteNow:
				writeLock.lock()
				if keptOpen() {
					write() onerror recover none
				}
				writeLock.unlock()
			case AfterChange.Nothing:
				return
		}
	}

	// Sleeps until the waiting changes have rested and writes them; ends
	// when nothing waits.
	def writeWhenRested() {
		for {
			let left = Persistence.restsIn(time.now(), true)
			return when left is none
			if left > 0s {
				time.sleep(left)
			} else {
				writeKept()
			}
		}
	}

	// Writes the waiting changes when they have rested at `now`.
	def writeKeptDue(now time.Time) {
		let left = Persistence.restsIn(now)
		return when left is none
		writeKept() when left <= 0s
	}

	// Writes every waiting change now, once a write another task started has ended. One
	// that cannot be written (the vault did not open, the disk is full) is given up.
	def writeKept() {
		writeLock.lock()
		defer writeLock.unlock()
		let waiting = Persistence.pending()
		return when waiting.order.len() == 0
		if keptOpen() {
			for let key in waiting.order {
				let change = waiting.writes.get(key)
				continue when change is none
				change.write() onerror recover none
			}
		}
		Persistence.written(waiting)
	}

	// Forgets the value kept under `key`.
	def forget(key string) {
		writeLock.lock()
		defer writeLock.unlock()
		Persistence.drop(key)
		return unless keptOpen()
		Vault.remove(keptPrefix + key) onerror recover none
		Vault.remove(keptPrefixBefore + key) onerror recover none
		Persistence.learn(key, none)
	}
}
