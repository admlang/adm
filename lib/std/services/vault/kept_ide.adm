// The Persistence service's IDE panel: the values `@persist` fields keep and
// the changes waiting to be written, and the buttons that write them now and
// forget one.

internal std partial module std.services.vault.kept {
	use (
		std.ide::(ide, IdeKind, IdeTable)
		std.services.vault::Vault
	)

	partial service Persistence {
		// The values `@persist` fields keep, as read or changed in this run.
		@ide(kind = IdeKind.Table, label = "Kept values", refresh = 1s, rows = 0)
		atomic def ideKept() IdeTable {
			let rows = string[][]
			let keys = held.keys()
			keys.sort((a, b) => a < b)
			for let (_, key) in keys {
				let data = held[key]
				rows.push([key, "{data.len()}", writes.hasKey(key) ?? ("waiting", "written")])
			}
			return IdeTable{columns: ["Key", "Size (B)", "State"], rows: rows}
		}

		@ide(kind = IdeKind.Value, label = "Waiting to be written", refresh = 1s)
		def ideWaiting() int {
			return order.len()
		}

		// Writes the changed values now instead of when the program rests.
		@ide(kind = IdeKind.Action, label = "Write now")
		def ideWriteNow() {
			writeKept()
		}

		// Forgets the value kept under `key`, in this run and in the vault: the
		// field starts from its default next time.
		@ide(kind = IdeKind.Action, label = "Forget", confirm = "Forget the value kept under this key?", row = "ideKept.Key")
		def ideForget(key string) !none {
			drop(key)
			return Vault.remove(keptPrefix + key)
		}
	}
}
