internal std partial module std.services.vault.kept {
	use (
		std.services::(Dependencies, Lifecycle, RestartMode, StartMode)
		std.services.vault::(Vault, VaultConfig)
		std.testing
		std.time
	)

	struct KeptPlace {
		name  string
		share float
	}

	// A service with a kept field.
	service KeptProbe {
		description               = "A service whose field is kept"
		dependencies              = Dependencies{
			hard: [],
			soft: []
		}
		lifecycle                 = Lifecycle{
			start: StartMode.Manual,
			restart: RestartMode.Never,
		}
		permissions  Permission[]

		@persist("kept.probe.level")
		level int = 5

		def config<T>(val T) !none {}

		async def start() !none {
			return none
		}

		async def stop() !none {
			return none
		}

		async def restart() !none {
			return none
		}

		@commit()
		def raise() int {
			level = level + 1
			return level
		}
	}

	check "Kept" {
		// An assignment that changes a service's `@persist` field keeps the value; the
		// field's first value, given when the service is made, keeps nothing.
		@test()
		def TestKeptFieldOfAService() !none {
			Vault.config(VaultConfig{memoryKiB: 64, passes: 1}) onerror recover none
			writeKept()
			assert Persistence.waiting().indexOf("kept.probe.level") < 0
			let level = KeptProbe.raise()
			assert Persistence.waiting().indexOf("kept.probe.level") >= 0
			assert restored<int>("kept.probe.level", 0) == level
			writeKept()
			let written = try Vault.load<Kept<int>>("persist.kept.probe.level")
			fail "the value is not in the vault" when written is none
			assert written.value == level
		}

		// What is kept under a key is what the next read of it returns, before it is
		// written and after; a key nothing was kept under gives the fallback.
		@test()
		def TestKeptValuesAreRestored() !none {
			Vault.config(VaultConfig{memoryKiB: 64, passes: 1}) onerror recover none
			for let key in ["kept.width", "kept.places", "kept.note"] {
				forget(key)
			}
			assert restored<int>("kept.width", 240) == 240
			let nobody ?string = "home"
			let unset ?string = none
			keep<int>("kept.width", 300)
			keep<KeptPlace[]>("kept.places", [KeptPlace{name: "files", share: 0.25}, KeptPlace{name: "editor", share: 0.75}])
			// An optional that was cleared is kept cleared.
			keep<?string>("kept.note", unset)
			assert Persistence.waiting().join(",") == "kept.width,kept.places,kept.note"
			assert restored<int>("kept.width", 240) == 300
			assert !(try Vault.has("persist.kept.width"))

			writeKept()
			assert Persistence.waiting().len() == 0
			assert try Vault.has("persist.kept.width")
			assert restored<int>("kept.width", 240) == 300
			let places = restored<KeptPlace[]>("kept.places", [])
			assert places.len() == 2 && places[1].name == "editor" && places[1].share == 0.75
			assert restored<?string>("kept.note", nobody) is none
			let width = try Vault.load<Kept<int>>("persist.kept.width")
			fail "the value is not in the vault" when width is none
			assert width.value == 300
		}

		// Every read returns a value of its own: changing one in place changes neither
		// what is kept nor what another read returns.
		@test()
		def TestKeptValuesAreNotShared() !none {
			Vault.config(VaultConfig{memoryKiB: 64, passes: 1}) onerror recover none
			forget("kept.places")
			let given = [KeptPlace{name: "files", share: 1.0}]
			keep<KeptPlace[]>("kept.places", given)
			given.push(KeptPlace{name: "late", share: 0.0})
			let first = restored<KeptPlace[]>("kept.places", [])
			first.push(KeptPlace{name: "mine", share: 0.5})
			assert first.len() == 2
			assert restored<KeptPlace[]>("kept.places", []).len() == 1
			writeKept()
			let written = try Vault.load<Kept<KeptPlace[]>>("persist.kept.places")
			fail "the value is not in the vault" when written is none
			assert written.value.len() == 1
		}

		// A change is written when it has rested, not before, and a later change of any
		// key starts the wait again.
		@test()
		def TestKeptValuesAreWrittenWhenTheyRest() !none {
			Vault.config(VaultConfig{memoryKiB: 64, passes: 1}) onerror recover none
			forget("kept.width")
			let before = time.now()
			keep<int>("kept.width", 310)
			let left = Persistence.restsIn(before)
			fail "the change is not waiting" when left is none
			assert left > 0s && left <= keepDelay + 1s
			writeKeptDue(before)
			assert Persistence.waiting().len() == 1
			assert !(try Vault.has("persist.kept.width"))
			writeKeptDue(time.now() + keepDelay)
			assert Persistence.waiting().len() == 0 && Persistence.restsIn(time.now()) is none
			assert try Vault.has("persist.kept.width")
		}

		// What the task a change starts does: it waits until the changes have rested,
		// writes them and ends.
		@test()
		def TestKeptValuesAreWrittenByTheirOwnTask() !none {
			Vault.config(VaultConfig{memoryKiB: 64, passes: 1}) onerror recover none
			forget("kept.width")
			Persistence.restAfter(1ms)
			keep<int>("kept.width", 320)
			writeWhenRested()
			Persistence.restAfter(keepDelay)
			assert Persistence.waiting().len() == 0 && Persistence.restsIn(time.now()) is none
			let written = try Vault.load<Kept<int>>("persist.kept.width")
			fail "the value is not in the vault" when written is none
			assert written.value == 320
		}

		// Writing the waiting changes waits for a write another task has started, so what
		// waited is in the vault when it returns.
		@test()
		def TestKeptValuesBeingWrittenAreWaitedFor() !none {
			Vault.config(VaultConfig{memoryKiB: 64, passes: 1}) onerror recover none
			forget("kept.width")
			keep<int>("kept.width", 340)
			Vault.lab.delay(20ms, method = "store")
			defer Vault.lab.reset()
			let other = async writeKept()
			// Until the other task is in the middle of writing the change.
			for let waited = 0; Vault.lab.calls("store") == 0; waited++ {
				fail "the other task never stored the change" when waited >= 5000
				time.sleep(1ms)
			}
			writeKept()
			let there = try Vault.has("persist.kept.width")
			let left = Persistence.waiting().len()
			await other
			assert there && left == 0
			let written = try Vault.load<Kept<int>>("persist.kept.width")
			fail "the value is not in the vault" when written is none
			assert written.value == 340
		}

		// A change made once the service has stopped is written at once.
		@test()
		def TestKeptValuesAreWrittenAtOnceAfterStop() !none {
			Vault.config(VaultConfig{memoryKiB: 64, passes: 1}) onerror recover none
			forget("kept.width")
			assert keptOpen()
			try await Persistence.stop()
			keep<int>("kept.width", 330)
			let written = try Vault.load<Kept<int>>("persist.kept.width")
			try await Persistence.start()
			assert Persistence.waiting().len() == 0
			fail "the value is not in the vault" when written is none
			assert written.value == 330
		}

		// A plain value is answered as it is held: read, kept, absent, and kept as
		// another type by a field read the other way.
		@test()
		def TestKeptPlainValues() !none {
			Vault.config(VaultConfig{memoryKiB: 64, passes: 1}) onerror recover none
			forget("kept.plain")
			forget("kept.name")
			assert restoredPlain<int>("kept.plain", 7) == 7
			// Nothing is kept: every fallback is answered, not the first one.
			assert restoredPlain<int>("kept.plain", 9) == 9
			keepPlain<int>("kept.plain", 41)
			assert restoredPlain<int>("kept.plain", 7) == 41
			assert restored<int>("kept.plain", 7) == 41
			assert restoredPlain<string>("kept.plain", "none") == "none"
			keepPlain<string>("kept.name", "left")
			assert restoredPlain<string>("kept.name", "") == "left"
			// Kept the other way, the plain value follows.
			keep<int>("kept.plain", 42)
			assert restoredPlain<int>("kept.plain", 7) == 42
			// A new run reads the vault once, then answers from what it holds.
			writeKept()
			Persistence.drop("kept.plain")
			assert restoredPlain<int>("kept.plain", 7) == 42
			try Vault.remove("persist.kept.plain")
			assert restoredPlain<int>("kept.plain", 7) == 42
		}

		// An entry that does not read as the type asked for is left as it is and the
		// fallback used, under either name; a forgotten key holds nothing, waiting
		// change included.
		@test()
		def TestKeptValuesOfAnotherTypeAreLeft() !none {
			Vault.config(VaultConfig{memoryKiB: 64, passes: 1}) onerror recover none
			forget("kept.width")
			forget("kept.older")
			assert keptOpen()
			try Vault.store("persist.kept.width", "wide")
			try Vault.store("ui.persist.kept.older", "wide")
			// `forget` recorded that the keys hold nothing; a new run has no such record.
			Persistence.drop("kept.width")
			Persistence.drop("kept.older")
			assert restored<int>("kept.width", 240) == 240
			assert restoredPlain<int>("kept.older", 240) == 240
			let left = try Vault.load<string>("persist.kept.width")
			fail "the entry was removed" when left is none
			assert left == "wide"
			assert try Vault.has("ui.persist.kept.older")
			assert !(try Vault.has("persist.kept.older"))
			// The next value kept under the key replaces it.
			keep<int>("kept.width", 5)
			writeKept()
			let kept = try Vault.load<Kept<int>>("persist.kept.width")
			fail "the value is not in the vault" when kept is none
			assert kept.value == 5

			keep<int>("kept.width", 6)
			forget("kept.width")
			assert Persistence.waiting().len() == 0
			assert restored<int>("kept.width", 240) == 240
			writeKept()
			assert !(try Vault.has("persist.kept.width"))
			try Vault.remove("ui.persist.kept.older")
		}

		// A value version 0.1.2194 kept as `ui.persist.<key>` is read and moved.
		@test()
		def TestKeptValuesMoveFromTheOldName() !none {
			Vault.config(VaultConfig{memoryKiB: 64, passes: 1}) onerror recover none
			forget("kept.old")
			assert keptOpen()
			try Vault.store("ui.persist.kept.old", Kept<int>{value: 7})
			// `forget` recorded that the key holds nothing; a new run has no such record.
			Persistence.drop("kept.old")
			assert restored<int>("kept.old", 1) == 7
			assert try Vault.has("persist.kept.old")
			assert !(try Vault.has("ui.persist.kept.old"))
		}

		@test()
		def TestKeepableKeys() {
			assert keepable("sidebar.width") && keepable("a")
			assert keepable("Pane_1-b")
			// The vault names entries with ASCII letters and digits.
			assert !keepable("Fenêtre")
			assert !keepable("") && !keepable("a b") && !keepable("a/b")
			assert !keepable("\{x\}")
			assert keepable("k".repeat(244))
			assert !keepable("k".repeat(245))
		}
	}
}
