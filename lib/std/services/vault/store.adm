// The vault's file: a header binding it to a machine, a user and an
// application, and sealed entries. `docs/requirements/vault.md`, "Storage".
internal partial module std.services.vault.store {
	use (
		std.crypto::(rand)
		std.crypto.cipher::(AES, ChaCha20Poly1305, unwrapKey, wrapKey)
		std.crypto.hash::(argon2id)
	)

	// The first bytes of a vault file, and the format they announce.
	const vaultMagic = "ADMV"
	const vaultFormat = 1
	// The key derivation the header names: 1 is Argon2id with the parameters
	// written after it.
	const vaultKdfArgon2id = 1
	// The parameters a new vault is written with: the cost is paid once per
	// process, when the service starts.
	const vaultMemoryKiB = 65536
	const vaultPasses = 3
	const vaultLanes = 1
	const vaultSaltBytes = 32
	const vaultKeyBytes = 32
	const vaultNonceBytes = 12

	// What an entry was stored as; the kind is sealed with the entry.
	const entrySecret = 1
	const entryValue = 2
	const entryKey = 3

	// One sealed entry as the file holds it.
	struct VaultEntry {
		name   string
		kind   int
		nonce  byte[]
		sealed byte[]
	}

	// A vault file in memory: its header and its entries, in file order.
	type VaultFile {
		memoryKiB int          = vaultMemoryKiB
		passes    int          = vaultPasses
		lanes     int          = vaultLanes
		salt      byte[]       = []
		// The data key wrapped under the master key (AES key wrap).
		wrapped   byte[]       = []
		entries   VaultEntry[] = []

		def new() {}

		// The entry called `name`, or -1.
		def find(name string) int {
			for let (i, entry) in entries {
				return i when entry.name == name
			}
			return -1
		}

		// The file's bytes.
		def encode() byte[] {
			let out = vaultMagic.bytes()
			putLE32(out, vaultFormat)
			putLE32(out, vaultKdfArgon2id)
			putLE32(out, memoryKiB)
			putLE32(out, passes)
			putLE32(out, lanes)
			putBytes(out, salt)
			putBytes(out, wrapped)
			putLE32(out, entries.len())
			for let entry in entries {
				putBytes(out, entry.name.bytes())
				putLE32(out, entry.kind)
				putBytes(out, entry.nonce)
				putBytes(out, entry.sealed)
			}
			return out
		}
	}

	// Reads a vault file. Fails when the bytes are not one, or name a format
	// or a key derivation this version does not know.
	def parseVaultFile(data byte[]) !VaultFile {
		expects {
			assert data.len() >= 4 && string(data[0:4]) == vaultMagic onerror fail "vault: not a vault file"
		}
		let reader = new ByteReader(data, 4)
		let format = try reader.le32()
		fail "vault: file format {format} is newer than this program knows" when format != vaultFormat
		let kdf = try reader.le32()
		fail "vault: unknown key derivation {kdf}" when kdf != vaultKdfArgon2id
		let file = new VaultFile()
		file.memoryKiB = try reader.le32()
		file.passes = try reader.le32()
		file.lanes = try reader.le32()
		file.salt = try reader.bytes()
		file.wrapped = try reader.bytes()
		let count = try reader.le32()
		fail "vault: damaged file" when count < 0
		for let i = 0; i < count; i++ {
			let name = string(try reader.bytes())
			let kind = try reader.le32()
			let nonce = try reader.bytes()
			let sealed = try reader.bytes()
			file.entries.push(VaultEntry{name: name, kind: kind, nonce: nonce, sealed: sealed})
		}
		fail "vault: damaged file" unless reader.atEnd()
		return file
	}

	// What binds a vault to where it lives: the machine's identity, the
	// folder it is in (one per user) and the application's identity.
	def bindingBytes(machine byte[], home string, appId string) byte[] {
		let out byte[]
		putBytes(out, machine)
		putBytes(out, home.bytes())
		putBytes(out, appId.bytes())
		return out
	}

	// The machine's identity: Linux writes one at installation. Fails on a
	// platform that gives none yet.
	def machineIdentity() !byte[] {
		for let path in ["/etc/machine-id", "/var/lib/dbus/machine-id"] {
			let found = __fs_exists(path) onerror recover false
			continue unless found
			let text = string(try __fs_read_all(path)).trim()
			return text.bytes() when text.len() > 0
		}
		fail "vault: no machine identity on this platform (no /etc/machine-id)"
	}

	// The master key of a file: Argon2id over the binding with the file's
	// salt and parameters.
	def masterKey(binding byte[], file VaultFile) !byte[] {
		return try argon2id(binding, file.salt, file.memoryKiB, file.passes, file.lanes, vaultKeyBytes)
	}

	// A new file: a random salt, a random data key wrapped under the master
	// key of `binding`. Returns the file and the data key.
	def newVaultFile(binding byte[], memoryKiB int = vaultMemoryKiB, passes int = vaultPasses) !(VaultFile, byte[]) {
		let file = new VaultFile()
		file.memoryKiB = memoryKiB
		file.passes = passes
		file.salt = try rand(vaultSaltBytes)
		let dataKey = try rand(vaultKeyBytes)
		let master = try masterKey(binding, file)
		file.wrapped = try wrapKey(new AES(master), dataKey)
		master.fill(0)
		return (file, dataKey)
	}

	// The data key of a file opened where `binding` holds. Fails when the
	// binding is another's: the wrapped key does not unwrap.
	def openVaultFile(binding byte[], file VaultFile) !byte[] {
		let master = try masterKey(binding, file)
		let dataKey = unwrapKey(new AES(master), file.wrapped) onerror (err error) {
			master.fill(0)
			fail "vault: the file belongs to another machine, user or application"
		}
		master.fill(0)
		return dataKey
	}

	// The associated data of an entry: what a sealed value is tied to.
	def entryAssociated(name string, kind int) byte[] {
		let out byte[]
		putLE32(out, vaultFormat)
		putLE32(out, kind)
		putBytes(out, name.bytes())
		return out
	}

	// Seals `plain` as the entry `name` of `kind`.
	def sealEntry(dataKey byte[], name string, kind int, plain byte[]) !VaultEntry {
		let nonce = try rand(vaultNonceBytes)
		let sealed = new ChaCha20Poly1305(dataKey).seal(nonce, plain, entryAssociated(name, kind))
		return VaultEntry{name: name, kind: kind, nonce: nonce, sealed: sealed}
	}

	// Opens an entry. Fails when it was moved, re-labelled or damaged.
	def openEntry(dataKey byte[], entry VaultEntry) !byte[] {
		let plain = new ChaCha20Poly1305(dataKey).open(entry.nonce, entry.sealed, entryAssociated(entry.name, entry.kind)) onerror (err error) {
			fail "vault: the entry \"{entry.name}\" does not open: damaged or moved"
		}
		return plain
	}

	// Writes `data` to `path` whole: a temporary beside it, then a rename, so
	// a reader never sees a part.
	def writeWhole(path string, data byte[]) !none {
		let tmp = path + ".tmp"
		try __fs_write_all(tmp, data)
		try __fs_rename(tmp, path)
		return none
	}

	// Whether `name` is a name an entry may have.
	def validName(name string) bool {
		return false when name.len() == 0 || name.len() > 255
		for let c in name {
			continue when c.isLetter() || c.isDigit() || c == '.' || c == '_' || c == '-'
			return false
		}
		return true
	}

	def putLE32(to byte[], value int) {
		to.push(byte(value & 0xFF))
		to.push(byte((value >> 8) & 0xFF))
		to.push(byte((value >> 16) & 0xFF))
		to.push(byte((value >> 24) & 0xFF))
	}

	def putBytes(to byte[], data byte[]) {
		putLE32(to, data.len())
		for let b in data {
			to.push(b)
		}
	}

	// Reads the file's fields front to back.
	type ByteReader {
		data byte[]
		at   int

		def new(data byte[], at int) {
			self.data = data
			self.at = at
		}

		def le32() !int {
			fail "vault: damaged file" when at + 4 > data.len()
			let v = int(data[at]) | (int(data[at + 1]) << 8) | (int(data[at + 2]) << 16) | (int(data[at + 3]) << 24)
			at += 4
			return v
		}

		def bytes() !byte[] {
			let n = try le32()
			fail "vault: damaged file" when n < 0 || at + n > data.len()
			let out = data[at:at + n].clone()
			at += n
			return out
		}

		def atEnd() bool {
			return at == data.len()
		}
	}
}
