// The machine's identity on macOS: the hardware identifier the system keeps
// for it (IOPlatformUUID).
internal partial module std.services.vault.store {
	// Writes the machine's 16-byte identifier into id, waiting at most the
	// seconds and nanoseconds in wait; 0 on success.
	@c("unistd.h", ret = "int", params = ["unsigned char*", "const struct timespec*"])
	def gethostuuid(id byte[], wait int64[]) int32;

	// The machine's identity: its 16-byte hardware identifier. Fails when the
	// system does not give it within five seconds.
	def machineIdentity() !byte[] {
		let id byte[] = []
		for let i in 0..16 {
			id.push(0)
		}
		let wait int64[] = [5, 0]
		fail "vault: no machine identity (gethostuuid failed)" when gethostuuid(id, wait) != 0
		return id
	}
}
