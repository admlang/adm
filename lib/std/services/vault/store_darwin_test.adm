internal partial module std.services.vault.store {
	use std.testing

	check "Machine identity on macOS" {
		// The identity is the machine's 16-byte hardware identifier, the same
		// on every call, and never all zero.
		@test()
		def TestMachineIdentityIsTheHardwareIdentifier() !none {
			let first = try machineIdentity()
			let second = try machineIdentity()
			assert first.len() == 16
			assert first.equals(second)
			let zero = first.filter(def (b byte) bool {
				return b == 0
			})
			assert zero.len() < 16
			return none
		}
	}
}
