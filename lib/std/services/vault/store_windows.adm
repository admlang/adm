// The machine's identity on Windows: the GUID the system writes at
// installation (MachineGuid under HKLM\SOFTWARE\Microsoft\Cryptography).
internal partial module std.services.vault.store {
	@c(symbol = "adm_win_machine_guid", ret = "const char*", params = [])
	internal def __winMachineGuid() string;

	// The machine's identity: its installation GUID. Fails when the registry
	// holds none.
	def machineIdentity() !byte[] {
		let guid = __winMachineGuid()
		fail "vault: no machine identity (no MachineGuid under HKLM\\SOFTWARE\\Microsoft\\Cryptography)" when guid == ""
		return guid.bytes()
	}
}
