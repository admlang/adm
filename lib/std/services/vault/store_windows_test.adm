internal partial module std.services.vault.store {
	use std.testing

	check "Machine identity on Windows" {
		// The identity is the installation GUID, the same on every call.
		@test()
		def TestMachineIdentityIsTheInstallationGuid() !none {
			let first = try machineIdentity()
			assert first.len() == 36 && string(first).count("-") == 4
			assert first.equals(try machineIdentity())
			return none
		}
	}
}
