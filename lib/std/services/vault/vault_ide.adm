// The Vault service's IDE panel: what the vault holds (values shown, private
// keys never), and the buttons that remove an entry and sign with a key.

partial module std.services.vault {
	use (
		std.crypto.hash::(Hash)
		std.data.encoding::(hexencode)
		std.ide::(ide, IdeKind, IdeTable, hiddenValue)
		std.services.ipc::(unpack)
		std.services.vault.store::*
	)

	partial service Vault {
		@ide(kind = IdeKind.Value, label = "File", refresh = 10s)
		def ideFile() string {
			return path
		}

		// Every entry: a value shown as text when it is one, else by its size and
		// first bytes; a secret hidden until `ideReveal` shows it; a key by its
		// kind only.
		@ide(kind = IdeKind.Table, label = "Entries", refresh = 2s, rows = 0)
		atomic def ideEntries() IdeTable {
			let rows = string[][]
			let held = file
			if !(held is none) {
				for let (_, entry) in held.entries {
					let shown = "(private key, not shown)"
					if entry.kind != entryKey {
						let plain = read(entry.name, entry.kind) onerror recover none
						shown = plain is none ?? ("(does not open)", shownValue(plain))
						shown = hiddenValue(shown) when entry.kind == entrySecret
					}
					rows.push([entry.name, kindName(entry.kind), shown])
				}
			}
			return IdeTable{columns: ["Name", "Kind", "Value"], rows: rows}
		}

		// A secret's value, which the Entries table hides.
		@ide(kind = IdeKind.Action, label = "Reveal", confirm = "Show this secret?", row = "ideEntries.Name")
		atomic def ideReveal(name string) !string {
			let plain = try read(name, entrySecret)
			return plain is none ?? ("(no secret called {name})", shownValue(plain))
		}

		@ide(kind = IdeKind.Action, label = "Remove entry", confirm = "Remove this entry from the vault?", row = "ideEntries.Name")
		atomic def ideRemove(name string) !none {
			return dropEntry(name)
		}

		// Signs a text with the key `key` (SHA-256 where the key signs a digest)
		// and gives the signature in hex.
		@ide(kind = IdeKind.Action, label = "Sign")
		atomic def ideSign(key string, text string) !string {
			let signature = try signWith(key, text.bytes(), Hash.SHA256)
			return hexencode(signature)
		}
	}

	// A stored value as the panel shows it: the text when it is one, else its
	// size and first bytes in hex.
	internal def shownValue(plain byte[]) string {
		let readable = true
		let text = unpack<string>(plain) onerror (err error) {
			readable = false
			recover ""
		}
		return text when readable
		let head = plain.len() > 24 ?? (plain[:24].clone(), plain)
		return "{plain.len()} bytes: {hexencode(head)}"
	}
}
