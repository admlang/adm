partial module std.services.vault {
	use (
		std.crypto::(ECDSAPublicKey, Ed25519PublicKey, X25519PublicKey, generateRSAKey, generateX25519Key)
		std.crypto.hash::(Hash, digest)
		std.data.encoding::(asn1Parse)
		std.services::(Application)
		std.services.vault.store::*
		std.testing
	)

	struct Placement {
		x, y  int
		title string
		tags  string[]
	}

	check "Vault" {
		// Secrets and values of several types round-trip through the file,
		// survive a restart, and are listed, found and removed by name.
		@test()
		def entriesRoundTrip() !none {
			// The derivation's cost is the file's, not the test's: 211 ms at
			// the defaults in a release build (`docs/std/crypto/how-it-works.md`).
			// The suites share one service: whichever runs first sets it.
			Vault.config(VaultConfig{memoryKiB: 64, passes: 1}) onerror recover none
			try await Vault.start()
			let token Secret<string> = "sk-live-1234"
			try Vault.put("rt.api.token", token)
			try Vault.store("rt.window.main", Placement{x: 10, y: 20, title: "Main", tags: ["a", "b"]})
			try Vault.store("rt.counter", 42)
			try Vault.store("rt.ratios", map<string, float>{"a": 0.5, "b": 1.5})
			let kept = try Vault.get<string>("rt.api.token")
			assert !(kept is none) && kept.reveal() == "sk-live-1234"
			let placement = try Vault.load<Placement>("rt.window.main")
			assert !(placement is none) && placement.x == 10 && placement.title == "Main" && placement.tags.len() == 2
			let counter = try Vault.load<int>("rt.counter")
			assert !(counter is none) && counter == 42
			let ratios = try Vault.load<map<string, float>>("rt.ratios")
			assert !(ratios is none) && ratios["b"] == 1.5
			assert try Vault.has("rt.counter")
			assert !(try Vault.has("rt.nothing"))
			assert (try Vault.list("rt.")).join(",") == "rt.api.token,rt.counter,rt.ratios,rt.window.main"
			assert (try Vault.list("rt.win")).join(",") == "rt.window.main"
			assert (try Vault.load<int>("rt.nothing")) is none
			assert (try Vault.get<string>("rt.nothing")) is none

			// The file is read back from disk with the key derived again.
			try await Vault.restart()
			let again = try Vault.get<string>("rt.api.token")
			assert !(again is none) && again.reveal() == "sk-live-1234"
			let counterAgain = try Vault.load<int>("rt.counter")
			assert !(counterAgain is none) && counterAgain == 42

			// Replaced in place, removed for good.
			try Vault.store("rt.counter", 43)
			let replaced = try Vault.load<int>("rt.counter")
			assert !(replaced is none) && replaced == 43
			try Vault.remove("rt.counter")
			assert !(try Vault.has("rt.counter"))
			try Vault.remove("rt.counter")
		}

		// A secret is not read as a value, a value not as a secret, a value
		// not as another type, and a name is a name.
		@test()
		def kindsAndNamesAreChecked() !none {
			try await Vault.start()
			let token Secret<string> = "s"
			try Vault.put("kinds.secret", token)
			try Vault.store("kinds.value", "v")
			let asValue = Vault.load<string>("kinds.secret") onerror recover ""
			assert asValue is none || asValue == ""
			let asSecret = Vault.get<string>("kinds.value") onerror recover none
			assert asSecret is none
			let wrongType = Vault.load<Placement>("kinds.value") onerror recover none
			assert wrongType is none
			let _ = Vault.store("not a name", 1) onerror (err error) {
				assert err.message.contains("is not a name")
				recover none
			}
			let _ = Vault.store("", 1) onerror (err error) {
				assert err.message.contains("is not a name")
				recover none
			}
		}
	}

	check "Vault settings" {
		// Settings given to a started vault are applied to its file where they
		// differ from it: equal ones write nothing, another cost wraps the key
		// again and keeps every entry, another path moves the file, and a
		// change that cannot be made leaves the vault as it was.
		@test()
		def settingsAreAppliedToAStartedVault() !none {
			let quick = VaultConfig{memoryKiB: 64, passes: 1}
			Vault.config(quick) onerror recover none
			try await Vault.start()
			try Vault.config(quick)
			let home = try Application.home()
			let usual = home + "/vault/vault.bin"
			try Vault.store("cfg.counter", 7)
			try Vault.put("cfg.token", new Secret<string>("kept"))

			// Equal settings: the file is the same bytes.
			let before = (try __fs_read_all(usual)).hex()
			try Vault.config(quick)
			try Vault.config(VaultConfig{path: usual, memoryKiB: 64, passes: 1})
			assert (try __fs_read_all(usual)).hex() == before

			// Another cost: the file records it, with a new salt, and opens.
			let was = try parseVaultFile(try __fs_read_all(usual))
			try Vault.config(VaultConfig{memoryKiB: 128, passes: 2})
			let now = try parseVaultFile(try __fs_read_all(usual))
			assert now.memoryKiB == 128 && now.passes == 2 && now.salt.hex() != was.salt.hex()
			assert now.entries.len() == was.entries.len()
			let counter = try Vault.load<int>("cfg.counter")
			fail "the value is gone" when counter is none
			assert counter == 7
			try await Vault.restart()
			let token = try Vault.get<string>("cfg.token")
			fail "the secret is gone" when token is none
			assert token.reveal() == "kept"

			// Another path, and another cost with it: one file, at the new place.
			let moved = home + "/vault/moved.bin"
			try Vault.config(VaultConfig{path: moved, memoryKiB: 64, passes: 1})
			assert try __fs_exists(moved)
			assert !(try __fs_exists(usual))
			let there = try parseVaultFile(try __fs_read_all(moved))
			assert there.memoryKiB == 64 && there.passes == 1
			try Vault.store("cfg.counter", 8)
			assert (try parseVaultFile(try __fs_read_all(moved))).entries.len() == there.entries.len()

			// A file already at the new path: nothing changes.
			try __fs_write_all(usual, "taken".bytes())
			let refused = false
			Vault.config(quick) onerror (err error) {
				refused = true
				recover none
			}
			assert refused && (try __fs_exists(moved))
			try __fs_remove(usual)

			// A place that cannot be written: the vault stays where it is and works.
			let failed = false
			Vault.config(VaultConfig{path: home + "/vault/missing/vault.bin", memoryKiB: 256, passes: 1}) onerror (err error) {
				failed = true
				recover none
			}
			assert failed && (try __fs_exists(moved))
			assert (try parseVaultFile(try __fs_read_all(moved))).memoryKiB == 64
			let still = try Vault.load<int>("cfg.counter")
			fail "the value is gone" when still is none
			assert still == 8

			// Back where the other suites expect it.
			try Vault.config(quick)
			assert (try __fs_exists(usual)) && !(try __fs_exists(moved))
			try Vault.remove("cfg.counter")
			try Vault.remove("cfg.token")
		}

		// A cost given before start is the file's after it, as when given after.
		@test()
		def settingsGivenBeforeStartAreApplied() !none {
			let quick = VaultConfig{memoryKiB: 64, passes: 1}
			Vault.config(quick) onerror recover none
			try await Vault.start()
			let usual = (try Application.home()) + "/vault/vault.bin"
			try Vault.store("cfg.early", 3)
			try await Vault.stop()
			try Vault.config(VaultConfig{memoryKiB: 96, passes: 1})
			try await Vault.start()
			assert (try parseVaultFile(try __fs_read_all(usual))).memoryKiB == 96
			let early = try Vault.load<int>("cfg.early")
			fail "the value is gone" when early is none
			assert early == 3
			try Vault.remove("cfg.early")
			try Vault.config(quick)
			assert (try parseVaultFile(try __fs_read_all(usual))).memoryKiB == 64
		}
	}

	check "Vault id" {
		// The id is made once, is a version 4 UUID, is the same on every call
		// and after a restart, and its entry is the vault's own.
		@test()
		def idIsMadeOnceAndKept() !none {
			Vault.config(VaultConfig{memoryKiB: 64, passes: 1}) onerror recover none
			try await Vault.start()
			let id = try Vault.id()
			let shaped = /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/.test(id)
			assert shaped
			assert (try Vault.id()) == id
			try await Vault.restart()
			assert (try Vault.id()) == id
			assert try Vault.has("vault.id")

			let refusedStore = false
			Vault.store("vault.id", "mine") onerror (err error) {
				refusedStore = err is VaultError
				recover none
			}
			assert refusedStore
			let refusedRemove = false
			Vault.remove("vault.id") onerror (err error) {
				refusedRemove = err is VaultError
				recover none
			}
			assert refusedRemove
			assert (try Vault.id()) == id
		}

		// A file made before vaults had an id is given one when it opens: the
		// installation id Telemetry kept in it when there is one, which is
		// then removed, else a new one.
		@test()
		def filesWithoutAnIdAreGivenOne() !none {
			Vault.config(VaultConfig{memoryKiB: 64, passes: 1}) onerror recover none
			try await Vault.start()
			let fresh = (try Application.home()) + "/vault/adopts.bin"
			try await Vault.stop()
			try Vault.config(VaultConfig{path: fresh, memoryKiB: 64, passes: 1})
			try await Vault.start()
			let made = try Vault.id()
			assert (try parseVaultFile(try __fs_read_all(fresh))).find("vault.id") >= 0
			let earlier = "0b6f3c52-7d1e-4c8a-9a3f-5e2d8c4b1a70"
			try Vault.store("telemetry.installation", earlier)
			try await Vault.stop()

			// The file as an earlier version left it: no id of its own.
			let old = try parseVaultFile(try __fs_read_all(fresh))
			old.entries.remove(old.find("vault.id"))
			try writeWhole(fresh, old.encode())
			try await Vault.start()
			assert (try Vault.id()) == earlier
			assert !(try Vault.has("telemetry.installation"))
			try await Vault.restart()
			assert (try Vault.id()) == earlier

			// Without Telemetry's entry either: a new id.
			try await Vault.stop()
			let bare = try parseVaultFile(try __fs_read_all(fresh))
			bare.entries.remove(bare.find("vault.id"))
			try writeWhole(fresh, bare.encode())
			try await Vault.start()
			let given = try Vault.id()
			assert given != earlier && given != made && given.len() == 36

			try await Vault.stop()
			let stopped = false
			idOnly() onerror (err error) {
				stopped = err is VaultError
				recover none
			}
			assert stopped
			try __fs_remove(fresh)
			try Vault.config(VaultConfig{memoryKiB: 64, passes: 1})
			try await Vault.start()
			assert (try Vault.id()) != earlier
		}
	}

	internal def idOnly() !none {
		try Vault.id()
		return none
	}

	check "Vault keys" {
		// Keys the vault makes or takes in are used without coming out: the
		// public half, signatures Ed25519, ECDSA and RSA verify, RSA
		// decryption, X25519 agreement; a key is not read as a value, an
		// agreement key does not sign, and a removed key is gone.
		@test()
		def keysAreUsedWithoutLeaving() !none {
			// The service may be started by the suite before this one; the
			// settings then stay as they are.
			Vault.config(VaultConfig{memoryKiB: 64, passes: 1}) onerror recover none
			try await Vault.start()
			let message = "sign me".bytes()

			try Vault.generateKey("keys.ed", KeyKind.Ed25519)
			let edPublic = try Vault.publicKey("keys.ed")
			let edSignature = try Vault.sign("keys.ed", message)
			match edPublic {
				case Ed25519PublicKey:
					assert edPublic.verify(message, edSignature)
				default:
					assert false
			}

			try Vault.generateKey("keys.ec", KeyKind.EcdsaP256)
			let ecSignature = try Vault.sign("keys.ec", message)
			let parts = try asn1Parse(ecSignature)
			let r = try (try parts.at(0)).asBigInt()
			let sigS = try (try parts.at(1)).asBigInt()
			let ecPublic = try Vault.publicKey("keys.ec")
			match ecPublic {
				case ECDSAPublicKey:
					assert ecPublic.verify(digest(Hash.SHA256, message), r, sigS)
				default:
					assert false
			}

			let rsa = try generateRSAKey(1024)
			try Vault.importKey("keys.rsa", rsa)
			let rsaSignature = try Vault.sign("keys.rsa", message)
			assert rsa.publicKey().verifyPKCS1v15(Hash.SHA256, digest(Hash.SHA256, message), rsaSignature)
			let sealed = try rsa.publicKey().encrypt("hello".bytes())
			assert string(try Vault.decrypt("keys.rsa", sealed)) == "hello"

			try Vault.generateKey("keys.x", KeyKind.X25519)
			let peer = try generateX25519Key()
			let ours = try Vault.publicKey("keys.x")
			match ours {
				case X25519PublicKey:
					assert (try Vault.agree("keys.x", peer.public)).equals(try peer.sharedSecret(ours))
				default:
					assert false
			}
			let noSign = Vault.sign("keys.x", message) onerror recover byte[]
			assert noSign.len() == 0

			// A key is an entry of its own kind.
			assert try Vault.has("keys.ed")
			let asValue = Vault.load<string>("keys.ed") onerror recover none
			assert asValue is none
			try Vault.removeKey("keys.ed")
			assert !(try Vault.has("keys.ed"))
			let _ = Vault.publicKey("keys.ed") onerror (err error) {
				assert err.message.contains("no key")
				recover edPublic
			}
		}
	}

	check "Vault file" {
		// A file made where one binding holds does not open where another
		// does: another machine, user or application.
		@test()
		def bindingIsEnforced() !none {
			let here = bindingBytes("machine-a".bytes(), "/home/a/.local/share/app", "app.one")
			let (file, dataKey) = try newVaultFile(here, 8, 1)
			let entry = try sealEntry(dataKey, "k", entryValue, "v".bytes())
			file.entries.push(entry)
			let parsed = try parseVaultFile(file.encode())
			assert (try openVaultFile(here, parsed)).equals(dataKey)
			for let other in [bindingBytes("machine-b".bytes(), "/home/a/.local/share/app", "app.one"), bindingBytes("machine-a".bytes(), "/home/b/.local/share/app", "app.one"), bindingBytes("machine-a".bytes(), "/home/a/.local/share/app", "app.two"),] {
				let opened = openVaultFile(other, parsed) onerror recover byte[]
				assert opened.len() == 0
			}
		}

		// An entry moved under another name, re-labelled or damaged does not
		// open; a damaged file does not parse.
		@test()
		def entriesAreTiedToTheirNameAndKind() !none {
			let binding = bindingBytes("m".bytes(), "/h", "a")
			let (file, dataKey) = try newVaultFile(binding, 8, 1)
			let entry = try sealEntry(dataKey, "first", entrySecret, "payload".bytes())
			assert string(try openEntry(dataKey, entry)) == "payload"
			let moved = VaultEntry{name: "second", kind: entry.kind, nonce: entry.nonce, sealed: entry.sealed}
			let opened = openEntry(dataKey, moved) onerror recover byte[]
			assert opened.len() == 0
			let relabelled = VaultEntry{name: "first", kind: entryValue, nonce: entry.nonce, sealed: entry.sealed}
			let opened2 = openEntry(dataKey, relabelled) onerror recover byte[]
			assert opened2.len() == 0
			let damaged = entry.sealed.clone()
			damaged[3] = damaged[3] ^ 1
			let opened3 = openEntry(dataKey, VaultEntry{name: "first", kind: entry.kind, nonce: entry.nonce, sealed: damaged}) onerror recover byte[]
			assert opened3.len() == 0
			file.entries.push(entry)
			let bytes = file.encode()
			let cut = parseVaultFile(bytes[0:bytes.len() - 3]) onerror recover new VaultFile()
			assert cut.entries.len() == 0
			let notOne = parseVaultFile("ADMX".bytes() + bytes[4:]) onerror recover new VaultFile()
			assert notOne.entries.len() == 0
		}
	}
}
