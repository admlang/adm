// Versions as `@migration` steps and the version markers write them, shared
// by the home folder's migrations (Application) and the databases'
// (Database).
internal partial module std.services.versions {
	use (
		std.data.semver
		std.reflection
	)

	// An annotation argument as plain text: string literals arrive as their
	// source text, so surrounding quotes are dropped.
	def attrText(hit reflection.AttrHit, name string) string {
		let v = hit.attr.arguments.valueOf(name)
		return "" when v is none
		let text = string(v).trim()
		if text.len() >= 2 && text.startsWith("\"") && text.endsWith("\"") {
			text = text[1:text.len() - 1]
		}
		return text
	}

	// Orders two version strings. Semantic versions compare as semver
	// (`1.0.0-rc.1` < `1.0.0`, build metadata ignored); a string semver
	// rejects falls back to a numeric part-by-part comparison. Returns
	// negative, zero or positive.
	def compareVersions(a string, b string) int {
		let result = compareSemver(a, b) onerror recover compareParts(a, b)
		return result
	}

	def compareSemver(a string, b string) !int {
		let va = try semver.parse(a)
		let vb = try semver.parse(b)
		return semver.compare(va, vb)
	}

	// Compares dotted version strings numerically part by part ("3.54" <
	// "4.0" < "4.0.1"); a non-numeric part compares as text.
	def compareParts(a string, b string) int {
		let pa = a.trim().split(".")
		let pb = b.trim().split(".")
		let n = pa.len()
		n = pb.len() when pb.len() > n
		for let i = 0; i < n; i++ {
			let x = "0"
			let y = "0"
			x = pa[i] when i < pa.len()
			y = pb[i] when i < pb.len()
			if !x.isNumeric() || !y.isNumeric() {
				continue when x == y
				return -1 when x < y
				return 1
			}
			let xv = x.toInt<int>()
			let yv = y.toInt<int>()
			continue when xv == yv
			return -1 when xv < yv
			return 1
		}
		return 0
	}

	// The indices of `froms` in ascending version order; equal versions
	// keep their order. Migration lists are short: a selection sort.
	def orderByVersion(froms string[]) int[] {
		let order int[]
		let taken bool[]
		for let i = 0; i < froms.len(); i++ {
			taken.push(false)
		}
		for let n = 0; n < froms.len(); n++ {
			let best = -1
			for let i = 0; i < froms.len(); i++ {
				continue when taken[i]
				best = i when best < 0 || compareVersions(froms[i], froms[best]) < 0
			}
			taken[best] = true
			order.push(best)
		}
		return order
	}
}
