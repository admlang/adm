	}

	// Mask utilities.
	def lane<T: SimdNumeric>(m mask4<T>, i int) bool {
		return m.lane(i)
	}

	// The value of lane i.
	def lane<T: SimdNumeric>(m mask8<T>, i int) bool {
		return m.lane(i)
	}

	// The value of lane i.
	def lane<T: SimdNumeric>(m mask16<T>, i int) bool {
		return m.lane(i)
	}

	// The value of lane i.
	def lane<T: SimdNumeric>(m mask32<T>, i int) bool {
		return m.lane(i)
	}

	// The value of lane i.
	def lane<T: SimdNumeric>(m mask64<T>, i int) bool {
		return m.lane(i)
	}

	// The value of lane i.
	def lane<T: SimdNumeric>(m mask128<T>, i int) bool {
		return m.lane(i)
	}

	// The mask's lanes as bits, bit i for lane i.
	def bits<T: SimdNumeric>(m mask4<T>) uint64 {
		return m.bits()
	}

	// The mask's lanes as bits, bit i for lane i.
	def bits<T: SimdNumeric>(m mask8<T>) uint64 {
		return m.bits()
	}

	// The mask's lanes as bits, bit i for lane i.
	def bits<T: SimdNumeric>(m mask16<T>) uint64 {
		return m.bits()
	}

	// The mask's lanes as bits, bit i for lane i.
	def bits<T: SimdNumeric>(m mask32<T>) uint64 {
		return m.bits()
	}

	// The mask's lanes as bits, bit i for lane i.
	def bits<T: SimdNumeric>(m mask64<T>) uint64 {
		return m.bits()
	}

	// Lanes 0 to 63 of the mask as bits, bit i for lane i.
	def bitsLo<T: SimdNumeric>(m mask128<T>) uint64 {
		return m.bitsLo()
	}

	// Lanes 64 to 127 of the mask as bits, bit i for lane 64 + i.
	def bitsHi<T: SimdNumeric>(m mask128<T>) uint64 {
		return m.bitsHi()
	}

	// Masked contiguous load/store (implemented via load + blend + store).
	def maskedLoad4<T: SimdNumeric>(src T[], index int, mask mask4<T>, fallback vec4<T>) vec4<T> {
		return blend(mask, load4<T>(src, index), fallback)
	}

	// Loads 8 elements from src at `index`, keeping fallback's lane where the mask is not set.
	def maskedLoad8<T: SimdNumeric>(src T[], index int, mask mask8<T>, fallback vec8<T>) vec8<T> {
		return blend(mask, load8<T>(src, index), fallback)
	}

	// Loads 16 elements from src at `index`, keeping fallback's lane where the mask is not set.
	def maskedLoad16<T: SimdNumeric>(src T[], index int, mask mask16<T>, fallback vec16<T>) vec16<T> {
		return blend(mask, load16<T>(src, index), fallback)
	}

	// Loads 32 elements from src at `index`, keeping fallback's lane where the mask is not set.
	def maskedLoad32<T: SimdNumeric>(src T[], index int, mask mask32<T>, fallback vec32<T>) vec32<T> {
		return blend(mask, load32<T>(src, index), fallback)
	}

	// Loads 64 elements from src at `index`, keeping fallback's lane where the mask is not set.
	def maskedLoad64<T: SimdNumeric>(src T[], index int, mask mask64<T>, fallback vec64<T>) vec64<T> {
		return blend(mask, load64<T>(src, index), fallback)
	}

	// Loads 128 elements from src at `index`, keeping fallback's lane where the mask is not set.
	def maskedLoad128<T: SimdNumeric>(src T[], index int, mask mask128<T>, fallback vec128<T>) vec128<T> {
		return blend(mask, load128<T>(src, index), fallback)
	}

	// Stores the lanes of value at `index` in dst where the mask is set; other elements stay.
	def maskedStore4<T: SimdNumeric>(dst T[], index int, mask mask4<T>, value vec4<T>) none {
		let cur = load4<T>(dst, index)
		store4<T>(dst, index, blend(mask, value, cur))
	}

	// Stores the lanes of value at `index` in dst where the mask is set; other elements stay.
	def maskedStore8<T: SimdNumeric>(dst T[], index int, mask mask8<T>, value vec8<T>) none {
		let cur = load8<T>(dst, index)
		store8<T>(dst, index, blend(mask, value, cur))
	}

	// Stores the lanes of value at `index` in dst where the mask is set; other elements stay.
	def maskedStore16<T: SimdNumeric>(dst T[], index int, mask mask16<T>, value vec16<T>) none {
		let cur = load16<T>(dst, index)
		store16<T>(dst, index, blend(mask, value, cur))
	}

	// Stores the lanes of value at `index` in dst where the mask is set; other elements stay.
	def maskedStore32<T: SimdNumeric>(dst T[], index int, mask mask32<T>, value vec32<T>) none {
		let cur = load32<T>(dst, index)
		store32<T>(dst, index, blend(mask, value, cur))
	}

	// Stores the lanes of value at `index` in dst where the mask is set; other elements stay.
	def maskedStore64<T: SimdNumeric>(dst T[], index int, mask mask64<T>, value vec64<T>) none {
		let cur = load64<T>(dst, index)
		store64<T>(dst, index, blend(mask, value, cur))
	}

	// Stores the lanes of value at `index` in dst where the mask is set; other elements stay.
	def maskedStore128<T: SimdNumeric>(dst T[], index int, mask mask128<T>, value vec128<T>) none {
		let cur = load128<T>(dst, index)
		store128<T>(dst, index, blend(mask, value, cur))
	}

	// Masked gather/scatter.
	def maskedGather4<T: SimdNumeric>(src T[], base int, indices vec4<int>, mask mask4<T>, fallback vec4<T>) vec4<T> {
		return blend(mask, gather4<T>(src, base, indices), fallback)
	}

	// A scatter that skips the lanes where the mask is not set.
	def maskedScatter4<T: SimdNumeric>(dst T[], base int, indices vec4<int>, mask mask4<T>, values vec4<T>) none {
		let i = 0
		for i < 4 {
			if mask.lane(i) {
				dst[base + indices.lane(i)] = values.lane(i)
			}
			i += 1
		}
	}

	// A gather that takes fallback's lane where the mask is not set.
	def maskedGather8<T: SimdNumeric>(src T[], base int, indices vec8<int>, mask mask8<T>, fallback vec8<T>) vec8<T> {
		return blend(mask, gather8<T>(src, base, indices), fallback)
	}

	// A scatter that skips the lanes where the mask is not set.
	def maskedScatter8<T: SimdNumeric>(dst T[], base int, indices vec8<int>, mask mask8<T>, values vec8<T>) none {
		let i = 0
		for i < 8 {
			if mask.lane(i) {
				dst[base + indices.lane(i)] = values.lane(i)
			}
			i += 1
		}
	}

	// A gather that takes fallback's lane where the mask is not set.
	def maskedGather16<T: SimdNumeric>(src T[], base int, indices vec16<int>, mask mask16<T>, fallback vec16<T>) vec16<T> {
		return blend(mask, gather16<T>(src, base, indices), fallback)
	}

	// A scatter that skips the lanes where the mask is not set.
	def maskedScatter16<T: SimdNumeric>(dst T[], base int, indices vec16<int>, mask mask16<T>, values vec16<T>) none {
		let i = 0
		for i < 16 {
			if mask.lane(i) {
				dst[base + indices.lane(i)] = values.lane(i)
			}
			i += 1
		}
	}

	// A gather that takes fallback's lane where the mask is not set.
	def maskedGather32<T: SimdNumeric>(src T[], base int, indices vec32<int>, mask mask32<T>, fallback vec32<T>) vec32<T> {
		return blend(mask, gather32<T>(src, base, indices), fallback)
	}

	// A scatter that skips the lanes where the mask is not set.
	def maskedScatter32<T: SimdNumeric>(dst T[], base int, indices vec32<int>, mask mask32<T>, values vec32<T>) none {
		let i = 0
		for i < 32 {
			if mask.lane(i) {
				dst[base + indices.lane(i)] = values.lane(i)
			}
