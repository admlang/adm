		}
		return out
	}

	// scatter writes `values[i]` into `dst[base + indices[i]]`.
	def scatter4<T: SimdNumeric>(dst T[], base int, indices vec4<int>, values vec4<T>) none {
		let i = 0
		for i < 4 {
			dst[base + indices.lane(i)] = values.lane(i)
