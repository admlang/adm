		}
	}

	// A gather that takes fallback's lane where the mask is not set.
	def maskedGather64<T: SimdNumeric>(src T[], base int, indices vec64<int>, mask mask64<T>, fallback vec64<T>) vec64<T> {
		return blend(mask, gather64<T>(src, base, indices), fallback)
	}

	// A scatter that skips the lanes where the mask is not set.
	def maskedScatter64<T: SimdNumeric>(dst T[], base int, indices vec64<int>, mask mask64<T>, values vec64<T>) none {
		let i = 0
		for i < 64 {
			if mask.lane(i) {
