partial module std.simd {
	// std.simd provides a stable, documented surface for SIMD operations.
	//
	// The underlying vector types live in the builtin module as `vec4<T>`,
	// `vec8<T>`, `vec16<T>`, `vec32<T>`, `vec64<T>`, and `vec128<T>`.
	// The supported lane types are `SimdInteger`, `SimdFloat`, and `SimdNumeric`
	// (declared in the builtin prelude).
	//
	// This module intentionally does not expose raw pointers. Prefer working
	// with existing ADM containers (e.g. `byte[]`) and higher-level APIs like
	// `std.gfx.canvas.DrawContext` for pixel work.

	// Type aliases for more discoverable constraints in user code.
	type ScalarInteger = SimdInteger
	// ScalarFloat is `SimdFloat`: any floating-point lane type.
	type ScalarFloat = SimdFloat
	// Scalar is `SimdNumeric`: any lane type.
	type Scalar = SimdNumeric
	// ScalarSigned is `SimdSigned`: any signed integer lane type.
	type ScalarSigned = SimdSigned
	// ScalarUnsigned is `SimdUnsigned`: any unsigned integer lane type.
	type ScalarUnsigned = SimdUnsigned

	// load4 reads 4 contiguous lane values from `src` starting at element index `index`.
	//
	// This is the entry point you want for "SIMD over arrays" without exposing raw pointers.
	// Backends are expected to lower this to an efficient vector load when possible.
	def load4<T: SimdNumeric>(src T[], index int) vec4<T> {
		let v vec4<T>
		return v.load(src, index)
	}

	// store4 writes `value` into `dst` starting at element index `index`.
	//
	// Backends are expected to lower this to an efficient vector store when possible.
	def store4<T: SimdNumeric>(dst T[], index int, value vec4<T>) none {
		return value.store(dst, index)
	}

	// load8 reads 8 contiguous lane values from `src` starting at element index `index`.
	def load8<T: SimdNumeric>(src T[], index int) vec8<T> {
		let v vec8<T>
		return v.load(src, index)
	}

	// store8 writes `value` into `dst` starting at element index `index`.
	def store8<T: SimdNumeric>(dst T[], index int, value vec8<T>) none {
		return value.store(dst, index)
	}

	// load16 reads 16 contiguous lane values from `src` starting at element index `index`.
	def load16<T: SimdNumeric>(src T[], index int) vec16<T> {
		let v vec16<T>
		return v.load(src, index)
	}

	// store16 writes `value` into `dst` starting at element index `index`.
	def store16<T: SimdNumeric>(dst T[], index int, value vec16<T>) none {
		return value.store(dst, index)
	}

	// load32 reads 32 contiguous lane values from `src` starting at element index `index`.
	def load32<T: SimdNumeric>(src T[], index int) vec32<T> {
		let v vec32<T>
		return v.load(src, index)
	}

	// store32 writes `value` into `dst` starting at element index `index`.
	def store32<T: SimdNumeric>(dst T[], index int, value vec32<T>) none {
		return value.store(dst, index)
	}

	// load64 reads 64 contiguous lane values from `src` starting at element index `index`.
	def load64<T: SimdNumeric>(src T[], index int) vec64<T> {
		let v vec64<T>
		return v.load(src, index)
	}

	// store64 writes `value` into `dst` starting at element index `index`.
	def store64<T: SimdNumeric>(dst T[], index int, value vec64<T>) none {
		return value.store(dst, index)
	}

	// load128 reads 128 contiguous lane values from `src` starting at element index `index`.
	def load128<T: SimdNumeric>(src T[], index int) vec128<T> {
		let v vec128<T>
		return v.load(src, index)
	}

	// store128 writes `value` into `dst` starting at element index `index`.
	def store128<T: SimdNumeric>(dst T[], index int, value vec128<T>) none {
		return value.store(dst, index)
	}

	// Byte-oriented helpers (useful for pixel and IO workloads).
	//
	// These helpers treat `byteOffset` as an element index because the lane type
	// is `byte` (1 byte per element).

	// loadBytes4 reads 4 bytes from `src` starting at `byteOffset`.
	def loadBytes4(src byte[], byteOffset int) vec4<byte> {
		return load4<byte>(src, byteOffset)
	}

	// storeBytes4 writes 4 bytes into `dst` starting at `byteOffset`.
	def storeBytes4(dst byte[], byteOffset int, value vec4<byte>) none {
		return store4<byte>(dst, byteOffset, value)
	}

	// loadBytes8 reads 8 bytes from `src` starting at `byteOffset`.
	def loadBytes8(src byte[], byteOffset int) vec8<byte> {
		return load8<byte>(src, byteOffset)
	}

	// storeBytes8 writes 8 bytes into `dst` starting at `byteOffset`.
	def storeBytes8(dst byte[], byteOffset int, value vec8<byte>) none {
		return store8<byte>(dst, byteOffset, value)
	}

	// loadBytes16 reads 16 bytes from `src` starting at `byteOffset`.
	def loadBytes16(src byte[], byteOffset int) vec16<byte> {
		return load16<byte>(src, byteOffset)
	}

	// storeBytes16 writes 16 bytes into `dst` starting at `byteOffset`.
	def storeBytes16(dst byte[], byteOffset int, value vec16<byte>) none {
		return store16<byte>(dst, byteOffset, value)
	}

	// loadBytes32 reads 32 bytes from `src` starting at `byteOffset`.
	def loadBytes32(src byte[], byteOffset int) vec32<byte> {
		return load32<byte>(src, byteOffset)
	}

	// storeBytes32 writes 32 bytes into `dst` starting at `byteOffset`.
	def storeBytes32(dst byte[], byteOffset int, value vec32<byte>) none {
		return store32<byte>(dst, byteOffset, value)
	}

	// loadBytes64 reads 64 bytes from `src` starting at `byteOffset`.
	def loadBytes64(src byte[], byteOffset int) vec64<byte> {
		return load64<byte>(src, byteOffset)
	}

	// storeBytes64 writes 64 bytes into `dst` starting at `byteOffset`.
	def storeBytes64(dst byte[], byteOffset int, value vec64<byte>) none {
		return store64<byte>(dst, byteOffset, value)
	}

	// loadBytes128 reads 128 bytes from `src` starting at `byteOffset`.
	def loadBytes128(src byte[], byteOffset int) vec128<byte> {
		return load128<byte>(src, byteOffset)
	}

	// storeBytes128 writes 128 bytes into `dst` starting at `byteOffset`.
	def storeBytes128(dst byte[], byteOffset int, value vec128<byte>) none {
		return store128<byte>(dst, byteOffset, value)
	}

	// eq compares lanes for equality and returns a mask.
	// A lane is "set" in the mask when `a[i] == b[i]`.
	def eq<T: SimdNumeric>(a vec4<T>, b vec4<T>) mask4<T> {
		return a.eq(b)
	}

	// Compares each lane of a with b and returns the mask of lanes equal to it.
	def eq<T: SimdNumeric>(a vec8<T>, b vec8<T>) mask8<T> {
		return a.eq(b)
	}

	// Compares each lane of a with b and returns the mask of lanes equal to it.
	def eq<T: SimdNumeric>(a vec16<T>, b vec16<T>) mask16<T> {
		return a.eq(b)
	}

	// Compares each lane of a with b and returns the mask of lanes equal to it.
	def eq<T: SimdNumeric>(a vec32<T>, b vec32<T>) mask32<T> {
		return a.eq(b)
	}

	// Compares each lane of a with b and returns the mask of lanes equal to it.
	def eq<T: SimdNumeric>(a vec64<T>, b vec64<T>) mask64<T> {
		return a.eq(b)
	}

	// Compares each lane of a with b and returns the mask of lanes equal to it.
	def eq<T: SimdNumeric>(a vec128<T>, b vec128<T>) mask128<T> {
		return a.eq(b)
	}

	// ne compares lanes for inequality and returns a mask.
	// A lane is "set" in the mask when `a[i] != b[i]`.
	def ne<T: SimdNumeric>(a vec4<T>, b vec4<T>) mask4<T> {
		return a.ne(b)
	}

	// Compares each lane of a with b and returns the mask of lanes not equal to it.
	def ne<T: SimdNumeric>(a vec8<T>, b vec8<T>) mask8<T> {
		return a.ne(b)
	}

	// Compares each lane of a with b and returns the mask of lanes not equal to it.
	def ne<T: SimdNumeric>(a vec16<T>, b vec16<T>) mask16<T> {
		return a.ne(b)
	}

	// Compares each lane of a with b and returns the mask of lanes not equal to it.
	def ne<T: SimdNumeric>(a vec32<T>, b vec32<T>) mask32<T> {
		return a.ne(b)
	}

	// Compares each lane of a with b and returns the mask of lanes not equal to it.
	def ne<T: SimdNumeric>(a vec64<T>, b vec64<T>) mask64<T> {
		return a.ne(b)
	}

	// Compares each lane of a with b and returns the mask of lanes not equal to it.
	def ne<T: SimdNumeric>(a vec128<T>, b vec128<T>) mask128<T> {
		return a.ne(b)
	}

	// lt compares lanes and returns a mask.
	// A lane is "set" in the mask when `a[i] < b[i]`.
	def lt<T: SimdNumeric>(a vec4<T>, b vec4<T>) mask4<T> {
		return a.lt(b)
	}

	// Compares each lane of a with b and returns the mask of lanes less than it.
	def lt<T: SimdNumeric>(a vec8<T>, b vec8<T>) mask8<T> {
		return a.lt(b)
	}

	// Compares each lane of a with b and returns the mask of lanes less than it.
	def lt<T: SimdNumeric>(a vec16<T>, b vec16<T>) mask16<T> {
		return a.lt(b)
	}

	// Compares each lane of a with b and returns the mask of lanes less than it.
	def lt<T: SimdNumeric>(a vec32<T>, b vec32<T>) mask32<T> {
		return a.lt(b)
	}

	// Compares each lane of a with b and returns the mask of lanes less than it.
	def lt<T: SimdNumeric>(a vec64<T>, b vec64<T>) mask64<T> {
		return a.lt(b)
	}

	// Compares each lane of a with b and returns the mask of lanes less than it.
	def lt<T: SimdNumeric>(a vec128<T>, b vec128<T>) mask128<T> {
		return a.lt(b)
	}

	// le compares lanes and returns a mask.
	// A lane is "set" in the mask when `a[i] <= b[i]`.
	def le<T: SimdNumeric>(a vec4<T>, b vec4<T>) mask4<T> {
		return a.le(b)
	}

	// Compares each lane of a with b and returns the mask of lanes less than or equal to it.
	def le<T: SimdNumeric>(a vec8<T>, b vec8<T>) mask8<T> {
		return a.le(b)
	}

	// Compares each lane of a with b and returns the mask of lanes less than or equal to it.
	def le<T: SimdNumeric>(a vec16<T>, b vec16<T>) mask16<T> {
		return a.le(b)
	}

	// Compares each lane of a with b and returns the mask of lanes less than or equal to it.
	def le<T: SimdNumeric>(a vec32<T>, b vec32<T>) mask32<T> {
		return a.le(b)
	}

	// Compares each lane of a with b and returns the mask of lanes less than or equal to it.
	def le<T: SimdNumeric>(a vec64<T>, b vec64<T>) mask64<T> {
		return a.le(b)
	}

	// Compares each lane of a with b and returns the mask of lanes less than or equal to it.
	def le<T: SimdNumeric>(a vec128<T>, b vec128<T>) mask128<T> {
		return a.le(b)
	}

	// gt compares lanes and returns a mask.
	// A lane is "set" in the mask when `a[i] > b[i]`.
	def gt<T: SimdNumeric>(a vec4<T>, b vec4<T>) mask4<T> {
		return a.gt(b)
	}

	// Compares each lane of a with b and returns the mask of lanes greater than it.
	def gt<T: SimdNumeric>(a vec8<T>, b vec8<T>) mask8<T> {
		return a.gt(b)
	}

	// Compares each lane of a with b and returns the mask of lanes greater than it.
	def gt<T: SimdNumeric>(a vec16<T>, b vec16<T>) mask16<T> {
		return a.gt(b)
	}

	// Compares each lane of a with b and returns the mask of lanes greater than it.
	def gt<T: SimdNumeric>(a vec32<T>, b vec32<T>) mask32<T> {
		return a.gt(b)
	}

	// Compares each lane of a with b and returns the mask of lanes greater than it.
	def gt<T: SimdNumeric>(a vec64<T>, b vec64<T>) mask64<T> {
		return a.gt(b)
	}

	// Compares each lane of a with b and returns the mask of lanes greater than it.
	def gt<T: SimdNumeric>(a vec128<T>, b vec128<T>) mask128<T> {
		return a.gt(b)
	}

	// ge compares lanes and returns a mask.
	// A lane is "set" in the mask when `a[i] >= b[i]`.
	def ge<T: SimdNumeric>(a vec4<T>, b vec4<T>) mask4<T> {
		return a.ge(b)
	}

	// Compares each lane of a with b and returns the mask of lanes greater than or equal to it.
	def ge<T: SimdNumeric>(a vec8<T>, b vec8<T>) mask8<T> {
		return a.ge(b)
	}

	// Compares each lane of a with b and returns the mask of lanes greater than or equal to it.
	def ge<T: SimdNumeric>(a vec16<T>, b vec16<T>) mask16<T> {
		return a.ge(b)
	}

	// Compares each lane of a with b and returns the mask of lanes greater than or equal to it.
	def ge<T: SimdNumeric>(a vec32<T>, b vec32<T>) mask32<T> {
		return a.ge(b)
	}

	// Compares each lane of a with b and returns the mask of lanes greater than or equal to it.
	def ge<T: SimdNumeric>(a vec64<T>, b vec64<T>) mask64<T> {
		return a.ge(b)
	}

	// Compares each lane of a with b and returns the mask of lanes greater than or equal to it.
	def ge<T: SimdNumeric>(a vec128<T>, b vec128<T>) mask128<T> {
		return a.ge(b)
	}

	// blend chooses lane values from `t` and `f` based on `mask`.
	//
	// For each lane i:
	// - if mask lane i is set, the result lane is `t[i]`
	// - otherwise, the result lane is `f[i]`
	//
	// This is the key operation for "branchless" SIMD code.
	def blend<T: SimdNumeric>(mask mask4<T>, t vec4<T>, f vec4<T>) vec4<T> {
		return mask.blend(t, f)
	}

	// Picks t's lane where the mask is set and f's lane where it is not.
	def blend<T: SimdNumeric>(mask mask8<T>, t vec8<T>, f vec8<T>) vec8<T> {
		return mask.blend(t, f)
	}

	// Picks t's lane where the mask is set and f's lane where it is not.
	def blend<T: SimdNumeric>(mask mask16<T>, t vec16<T>, f vec16<T>) vec16<T> {
		return mask.blend(t, f)
	}

	// Picks t's lane where the mask is set and f's lane where it is not.
	def blend<T: SimdNumeric>(mask mask32<T>, t vec32<T>, f vec32<T>) vec32<T> {
		return mask.blend(t, f)
	}

	// Picks t's lane where the mask is set and f's lane where it is not.
	def blend<T: SimdNumeric>(mask mask64<T>, t vec64<T>, f vec64<T>) vec64<T> {
		return mask.blend(t, f)
	}

	// Picks t's lane where the mask is set and f's lane where it is not.
	def blend<T: SimdNumeric>(mask mask128<T>, t vec128<T>, f vec128<T>) vec128<T> {
		return mask.blend(t, f)
	}

	// splat4 broadcasts `x` into all 4 lanes.
	def splat4<T: SimdNumeric>(x T) vec4<T> {
		let v vec4<T>
		return v.splat(x)
	}

	// splat8 broadcasts `x` into all 8 lanes.
	def splat8<T: SimdNumeric>(x T) vec8<T> {
		let v vec8<T>
		return v.splat(x)
	}

	// splat16 broadcasts `x` into all 16 lanes.
	def splat16<T: SimdNumeric>(x T) vec16<T> {
		let v vec16<T>
		return v.splat(x)
	}

	// splat32 broadcasts `x` into all 32 lanes.
	def splat32<T: SimdNumeric>(x T) vec32<T> {
		let v vec32<T>
		return v.splat(x)
	}

	// splat64 broadcasts `x` into all 64 lanes.
	def splat64<T: SimdNumeric>(x T) vec64<T> {
		let v vec64<T>
		return v.splat(x)
	}

	// splat128 broadcasts `x` into all 128 lanes.
	def splat128<T: SimdNumeric>(x T) vec128<T> {
		let v vec128<T>
		return v.splat(x)
	}

	// add performs lane-wise addition: `out[i] = a[i] + b[i]`.
	//
	// This is defined for all numeric SIMD lane types. For integer types this is
	// modular arithmetic (wraps on overflow) unless a future `addSaturating` API
	// is used.
	def add<T: SimdNumeric>(a vec4<T>, b vec4<T>) vec4<T> {
		return a + b
	}

	// Lane-wise sum of a and b.
	def add<T: SimdNumeric>(a vec8<T>, b vec8<T>) vec8<T> {
		return a + b
	}

	// Lane-wise sum of a and b.
	def add<T: SimdNumeric>(a vec16<T>, b vec16<T>) vec16<T> {
		return a + b
	}

	// Lane-wise sum of a and b.
	def add<T: SimdNumeric>(a vec32<T>, b vec32<T>) vec32<T> {
		return a + b
	}

	// Lane-wise sum of a and b.
	def add<T: SimdNumeric>(a vec64<T>, b vec64<T>) vec64<T> {
		return a + b
	}

	// Lane-wise sum of a and b.
	def add<T: SimdNumeric>(a vec128<T>, b vec128<T>) vec128<T> {
		return a + b
	}

	// sub performs lane-wise subtraction: `out[i] = a[i] - b[i]`.
	def sub<T: SimdNumeric>(a vec4<T>, b vec4<T>) vec4<T> {
		return a - b
	}

	// Lane-wise difference a minus b.
	def sub<T: SimdNumeric>(a vec8<T>, b vec8<T>) vec8<T> {
		return a - b
	}

	// Lane-wise difference a minus b.
	def sub<T: SimdNumeric>(a vec16<T>, b vec16<T>) vec16<T> {
		return a - b
	}

	// Lane-wise difference a minus b.
	def sub<T: SimdNumeric>(a vec32<T>, b vec32<T>) vec32<T> {
		return a - b
	}

	// Lane-wise difference a minus b.
	def sub<T: SimdNumeric>(a vec64<T>, b vec64<T>) vec64<T> {
		return a - b
	}

	// Lane-wise difference a minus b.
	def sub<T: SimdNumeric>(a vec128<T>, b vec128<T>) vec128<T> {
		return a - b
	}

	// mul performs lane-wise multiplication: `out[i] = a[i] * b[i]`.
	def mul<T: SimdNumeric>(a vec4<T>, b vec4<T>) vec4<T> {
		return a * b
	}

	// Lane-wise product of a and b.
	def mul<T: SimdNumeric>(a vec8<T>, b vec8<T>) vec8<T> {
		return a * b
	}

	// Lane-wise product of a and b.
	def mul<T: SimdNumeric>(a vec16<T>, b vec16<T>) vec16<T> {
		return a * b
	}

	// Lane-wise product of a and b.
	def mul<T: SimdNumeric>(a vec32<T>, b vec32<T>) vec32<T> {
		return a * b
	}

	// Lane-wise product of a and b.
	def mul<T: SimdNumeric>(a vec64<T>, b vec64<T>) vec64<T> {
		return a * b
	}

	// Lane-wise product of a and b.
	def mul<T: SimdNumeric>(a vec128<T>, b vec128<T>) vec128<T> {
		return a * b
	}

	// div performs lane-wise division: `out[i] = a[i] / b[i]`.
	//
	// Notes:
	// - For integer lane types, division semantics match ADM integer division.
	// - For floats, division follows IEEE behavior.
	def div<T: SimdNumeric>(a vec4<T>, b vec4<T>) vec4<T> {
		return a / b
	}

	// Lane-wise quotient a divided by b.
	def div<T: SimdNumeric>(a vec8<T>, b vec8<T>) vec8<T> {
		return a / b
	}

	// Lane-wise quotient a divided by b.
	def div<T: SimdNumeric>(a vec16<T>, b vec16<T>) vec16<T> {
		return a / b
	}

	// Lane-wise quotient a divided by b.
	def div<T: SimdNumeric>(a vec32<T>, b vec32<T>) vec32<T> {
		return a / b
	}

	// Lane-wise quotient a divided by b.
	def div<T: SimdNumeric>(a vec64<T>, b vec64<T>) vec64<T> {
		return a / b
	}

	// Lane-wise quotient a divided by b.
	def div<T: SimdNumeric>(a vec128<T>, b vec128<T>) vec128<T> {
		return a / b
	}

	// and performs lane-wise bitwise AND: `out[i] = a[i] & b[i]`.
	def and<T: SimdInteger>(a vec4<T>, b vec4<T>) vec4<T> {
		return a & b
	}

	// Lane-wise bitwise and.
	def and<T: SimdInteger>(a vec8<T>, b vec8<T>) vec8<T> {
		return a & b
	}

	// Lane-wise bitwise and.
	def and<T: SimdInteger>(a vec16<T>, b vec16<T>) vec16<T> {
		return a & b
	}

	// Lane-wise bitwise and.
	def and<T: SimdInteger>(a vec32<T>, b vec32<T>) vec32<T> {
		return a & b
	}

	// Lane-wise bitwise and.
	def and<T: SimdInteger>(a vec64<T>, b vec64<T>) vec64<T> {
		return a & b
	}

	// Lane-wise bitwise and.
	def and<T: SimdInteger>(a vec128<T>, b vec128<T>) vec128<T> {
		return a & b
	}

	// or performs lane-wise bitwise OR: `out[i] = a[i] | b[i]`.
	def or<T: SimdInteger>(a vec4<T>, b vec4<T>) vec4<T> {
		return a | b
	}

	// Lane-wise bitwise or.
	def or<T: SimdInteger>(a vec8<T>, b vec8<T>) vec8<T> {
		return a | b
	}

	// Lane-wise bitwise or.
	def or<T: SimdInteger>(a vec16<T>, b vec16<T>) vec16<T> {
		return a | b
	}

	// Lane-wise bitwise or.
	def or<T: SimdInteger>(a vec32<T>, b vec32<T>) vec32<T> {
		return a | b
	}

	// Lane-wise bitwise or.
	def or<T: SimdInteger>(a vec64<T>, b vec64<T>) vec64<T> {
		return a | b
	}

	// Lane-wise bitwise or.
	def or<T: SimdInteger>(a vec128<T>, b vec128<T>) vec128<T> {
		return a | b
	}

	// xor performs lane-wise bitwise XOR: `out[i] = a[i] ^ b[i]`.
	def xor<T: SimdInteger>(a vec4<T>, b vec4<T>) vec4<T> {
		return a ^ b
	}

	// Lane-wise bitwise exclusive or.
	def xor<T: SimdInteger>(a vec8<T>, b vec8<T>) vec8<T> {
		return a ^ b
	}

	// Lane-wise bitwise exclusive or.
	def xor<T: SimdInteger>(a vec16<T>, b vec16<T>) vec16<T> {
		return a ^ b
	}

	// Lane-wise bitwise exclusive or.
	def xor<T: SimdInteger>(a vec32<T>, b vec32<T>) vec32<T> {
		return a ^ b
	}

	// Lane-wise bitwise exclusive or.
	def xor<T: SimdInteger>(a vec64<T>, b vec64<T>) vec64<T> {
		return a ^ b
	}

	// Lane-wise bitwise exclusive or.
	def xor<T: SimdInteger>(a vec128<T>, b vec128<T>) vec128<T> {
		return a ^ b
	}

	// shl performs lane-wise shift-left by a scalar count.
	// Semantics match ADM's `<<` for the lane type `T`.
	def shl<T: SimdInteger>(v vec4<T>, count int) vec4<T> {
		return v << count
