	// gather loads `lane_count` elements from `src` at `base + indices[i]`.
	//
	// This is implemented in pure ADM using lane extraction, so it is always
	// correct even on backends that do not support vectorized gathers yet.
	def gather4<T: SimdNumeric>(src T[], base int, indices vec4<int>) vec4<T> {
		let out vec4<T>
		let i = 0
		for i < 4 {
			out = out.withLane(i, src[base + indices.lane(i)])
			i += 1
		}
		return out
	}

	// A vector whose lane i is `src[base + indices.lane(i)]`.
	def gather8<T: SimdNumeric>(src T[], base int, indices vec8<int>) vec8<T> {
		let out vec8<T>
		let i = 0
		for i < 8 {
			out = out.withLane(i, src[base + indices.lane(i)])
			i += 1
		}
		return out
	}

	// A vector whose lane i is `src[base + indices.lane(i)]`.
	def gather16<T: SimdNumeric>(src T[], base int, indices vec16<int>) vec16<T> {
		let out vec16<T>
		let i = 0
		for i < 16 {
			out = out.withLane(i, src[base + indices.lane(i)])
			i += 1
		}
		return out
	}

	// A vector whose lane i is `src[base + indices.lane(i)]`.
	def gather32<T: SimdNumeric>(src T[], base int, indices vec32<int>) vec32<T> {
		let out vec32<T>
		let i = 0
		for i < 32 {
			out = out.withLane(i, src[base + indices.lane(i)])
			i += 1
		}
		return out
	}

	// A vector whose lane i is `src[base + indices.lane(i)]`.
	def gather64<T: SimdNumeric>(src T[], base int, indices vec64<int>) vec64<T> {
		let out vec64<T>
