		return v.log()
	}

	// The natural logarithm of each lane.
	def log<T: SimdFloat>(v vec32<T>) vec32<T> {
		return v.log()
	}

	// The natural logarithm of each lane.
	def log<T: SimdFloat>(v vec64<T>) vec64<T> {
		return v.log()
	}

	// The natural logarithm of each lane.
	def log<T: SimdFloat>(v vec128<T>) vec128<T> {
		return v.log()
	}

	// The natural logarithm of each lane.
	def log2<T: SimdFloat>(v vec4<T>) vec4<T> {
		return v.log2()
	}

	// The natural logarithm of each lane.
	def log2<T: SimdFloat>(v vec8<T>) vec8<T> {
		return v.log2()
	}

	// The natural logarithm of each lane.
	def log2<T: SimdFloat>(v vec16<T>) vec16<T> {
