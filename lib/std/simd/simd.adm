	// shuffle permutes lanes in `v` according to `indices`.
	//
	// For each lane i:
	// - let j = indices[i] % lane_count
	// - out[i] = v[j]
	def shuffle<T: SimdNumeric>(v vec4<T>, indices vec4<byte>) vec4<T> {
		return v.shuffle(indices)
	}

	// A vector whose lane i is v's lane `indices[i]`.
	def shuffle<T: SimdNumeric>(v vec8<T>, indices vec8<byte>) vec8<T> {
