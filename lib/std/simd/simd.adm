		}
	}

	// A gather that takes fallback's lane where the mask is not set.
	def maskedGather128<T: SimdNumeric>(src T[], base int, indices vec128<int>, mask mask128<T>, fallback vec128<T>) vec128<T> {
		return blend(mask, gather128<T>(src, base, indices), fallback)
	}

	// A scatter that skips the lanes where the mask is not set.
	def maskedScatter128<T: SimdNumeric>(dst T[], base int, indices vec128<int>, mask mask128<T>, values vec128<T>) none {
