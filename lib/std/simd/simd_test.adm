partial module std.simd {
	use (
		std.testing
		std.math::(tan as scalarTan, atan as scalarAtan, acos as scalarAcos, tanh as scalarTanh, atan2 as scalarAtan2)
	)

	check "Bit counts" {
		@test()
		def popcount_clz_ctz_per_lane() {
			let zero = splat8<byte>(byte(0))
			assert zero.popcount().lane(0) == byte(0)
			assert zero.clz().lane(0) == byte(8) && zero.ctz().lane(0) == byte(8)
			let v = splat8<byte>(byte(0x28)).withLane(3, byte(0xff))
			assert v.popcount().lane(0) == byte(2) && v.popcount().lane(3) == byte(8)
			assert v.clz().lane(0) == byte(2) && v.ctz().lane(0) == byte(3)
			let wide = splat4<uint32>(uint32(0)).withLane(1, uint32(0xf0))
			assert wide.popcount().lane(0) == byte(0) && wide.popcount().lane(1) == byte(4)
			assert wide.clz().lane(0) == byte(32) && wide.ctz().lane(1) == byte(4)
			// The distance of two equal 256-bit strings is 0.
			let a byte[]
			for let i = 0; i < 32; i++ {
				a.push(byte(i * 37 + 11))
			}
			let x = load32<byte>(a, 0) ^ load32<byte>(a, 0)
			assert int(convert<byte, uint16>(x.popcount()).sum()) == 0
		}
	}

	check "Elementary functions" {
		// Every lane agrees with the scalar function to float32 or float64
		// rounding.
		def near(a, b float, tolerance float) bool {
			return (a - b).abs() <= tolerance * (1.0).max(b.abs())
		}

		@test()
		def inverse_and_hyperbolic_per_lane_float64() {
			let xs = float64[-0.9, -0.5, -0.1, 0.0, 0.2, 0.4, 0.7, 0.95]
			let ys = float64[1.0, -2.0, 0.5, -0.5, 3.0, 0.0, -1.0, 2.5]
			let v = load8<float64>(xs, 0)
			let y = load8<float64>(ys, 0)
			for let i = 0; i < 8; i++ {
				let x = xs[i]
				assert near(v.tan().lane(i), scalarTan(x), 1e-12)
				assert near(atan(v).lane(i), scalarAtan(x), 1e-12)
				assert near(acos(v).lane(i), scalarAcos(x), 1e-12)
				assert near(tanh(v).lane(i), scalarTanh(x), 1e-12)
				assert near(atan2(y, v).lane(i), scalarAtan2(ys[i], x), 1e-12)
			}
		}

		@test()
		def inverse_and_hyperbolic_per_lane_float32() {
			let xs = float32[-0.9, -0.1, 0.4, 0.95]
			let ys = float32[1.0, -2.0, 0.5, -0.5]
			let v = load4<float32>(xs, 0)
			let y = load4<float32>(ys, 0)
			for let i = 0; i < 4; i++ {
				let x = float(xs[i])
				assert near(float(tan(v).lane(i)), scalarTan(x), 1e-6)
				assert near(float(v.atan().lane(i)), scalarAtan(x), 1e-6)
				assert near(float(v.acos().lane(i)), scalarAcos(x), 1e-6)
				assert near(float(v.tanh().lane(i)), scalarTanh(x), 1e-6)
				assert near(float(y.atan2(v).lane(i)), scalarAtan2(float(ys[i]), x), 1e-6)
			}
		}
	}

	check "Two lanes" {
		@test()
		def arithmetic_loads_and_masks() {
			let xs = int64[10, -3, 7]
			let v = load2<int64>(xs, 1)
			assert v.lane(0) == -3 && v.lane(1) == 7
			let sum = v + splat2<int64>(int64(5))
			assert sum.lane(0) == 2 && sum.lane(1) == 12
			assert sum.sum() == 14
			let out = int64[0, 0, 0]
			store2<int64>(out, 0, sum)
			assert out[0] == 2 && out[1] == 12 && out[2] == 0
			let positive = v.gt(splat2<int64>(int64(0)))
			assert !positive.lane(0) && positive.lane(1) && positive.any() && !positive.all()
			let picked = positive.blend(v, splat2<int64>(int64(100)))
			assert picked.lane(0) == 100 && picked.lane(1) == 7
			let halves = splat2<float64>(float64(1.5)) * splat2<float64>(float64(2.0))
			assert halves.lane(0) == 3.0 && halves.sqrt().lane(1) > 1.7
		}
	}

	check "Bitcast between lane counts" {
		@test()
		def same_bits_reread_with_other_lanes() {
			let words = int64[0x0807060504030201, 0x100f0e0d0c0b0a09]
			let v = load2<int64>(words, 0)
			let bytes = v.bitcast16<byte>()
			for let i = 0; i < 16; i++ {
				assert bytes.lane(i) == byte(i + 1)
			}
			let quads = v.bitcast4<uint32>()
			assert quads.lane(0) == uint32(0x04030201) && quads.lane(3) == uint32(0x100f0e0d)
			let shorts = quads.bitcast8<uint16>()
			assert shorts.lane(0) == uint16(0x0201) && shorts.lane(7) == uint16(0x100f)
			let back = bytes.bitcast2<int64>()
			assert back.lane(0) == words[0] && back.lane(1) == words[1]
			let one = splat2<float64>(float64(1.0)).bitcast<uint64>()
			assert one.lane(0) == uint64(0x3ff0000000000000)
			let wide = splat8<uint32>(uint32(0x01010101)).bitcast32<byte>()
			assert wide.lane(31) == byte(1)
		}
	}
}
