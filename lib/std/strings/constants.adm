partial module std.strings {
	const (
		// ASCII_Lower is the lower-case ASCII letters.
		ASCII_Lower     = "abcdefghijklmnopqrstuvwxyz"
		// ASCII_Upper is the upper-case ASCII letters.
		ASCII_Upper     = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
		// ASCII_Digits is the decimal digits.
		ASCII_Digits    = "0123456789"
		// ASCII_Special is the printable ASCII punctuation and symbols.
		ASCII_Special   = "!@#$%^&*()-_=+[{]}\\|;:'\",.<>/?~`"
		// ASCII_Letters is every ASCII letter, lower case then upper case.
		// @see ASCII_Lower
		// @see ASCII_Upper
		ASCII_Letters   = ASCII_Lower + ASCII_Upper
		// ASCII_Alphanum is every ASCII letter and digit.
		// @see ASCII_Letters
		// @see ASCII_Digits
		ASCII_Alphanum  = ASCII_Letters + ASCII_Digits
		// ASCII_All is every printable ASCII character except whitespace.
		// @see ASCII_Lower
		// @see ASCII_Upper
		// @see ASCII_Digits
		// @see ASCII_Special
		ASCII_All       = ASCII_Lower + ASCII_Upper + ASCII_Digits + ASCII_Special
		// Whitespace is the whitespace characters: space, tab, carriage return and
		// line feed.
		Whitespace      = " \t\r\n"
		// ASCII_Printable is every printable ASCII character, whitespace included.
		// @see ASCII_Alphanum
		// @see ASCII_Special
		// @see Whitespace
		ASCII_Printable = ASCII_Alphanum + ASCII_Special + Whitespace
	)
}
