partial module std.strings {
	// Formats args according to a C-style format string.
	//
	// A conversion has the form `%[flags][width][.precision][length]verb`.
	// Each conversion consumes one argument, except `%%`, which writes a literal
	// percent sign without consuming an argument.
	//
	// Supported verbs:
	//
	//     %s  text: string, bool, char, or any Stringer via its str() method
	//     %c  one character, or the character represented by an integer
	//     %d  signed decimal integer
	//     %i  signed decimal integer; equivalent to %d
	//     %u  unsigned decimal integer
	//     %o  unsigned octal integer
	//     %x  unsigned hexadecimal integer using a-f
	//     %X  unsigned hexadecimal integer using A-F
	//     %f  decimal floating point, such as 3.140000
	//     %F  decimal floating point with uppercase special values
	//     %e  scientific notation, such as 3.140000e+00
	//     %E  scientific notation using an uppercase E
	//     %g  compact floating point; chooses %f or %e
	//     %G  compact floating point; chooses %F or %E
	//     %v  the natural representation of a primitive or Stringer value
	//     %%  a literal percent sign
	//
	// Flags control padding and signs:
	//
	//     -   left-align within the field width
	//     +   always include a numeric sign
	//     space  prefix positive numbers with a space when + is absent
	//     0   pad numeric values with leading zeroes
	//     #   use an alternate form, such as 0x for hexadecimal
	//
	// Width is the minimum output width. For example, `%4d` formats 7 as
	// `   7`, `%-4d` formats it as `7   `, and `%04d` formats it as `0007`.
	// Precision follows a dot: `%.2f` formats 3.14159 as `3.14`, while `%.3s`
	// writes at most three characters. Width and precision may be combined, as
	// in `%+8.2f`. Dynamic `*` widths and precisions are not supported.
	//
	// Integer length modifiers (`h`, `hh`, `l`, `ll`, `j`, `z`, `t`) are
	// accepted for familiarity but ADM uses the argument's actual type to choose
	// a safe native width. Thus `%d`, `%ld`, and `%lld` have the same ADM meaning.
	//
	// Unsupported or malformed conversions are preserved verbatim. Missing
	// arguments also leave their conversion unchanged; extra arguments are ignored.
	def format(pattern string, args ...any) string {
		let result = ""
		let argIndex = 0
		let i = 0

		for i < pattern.len() {
			if pattern[i] != '%' {
				result += string(pattern[i])
				i++
				continue
			}

			let start = i
			i++
			if i >= pattern.len() {
				result += "%"
				break
			}
			if pattern[i] == '%' {
				result += "%"
				i++
				continue
			}

			let prefix = "%"
			for i < pattern.len() && "-+ 0#".contains(string(pattern[i])) {
				prefix += string(pattern[i])
				i++
			}
			for i < pattern.len() && pattern[i] >= '0' && pattern[i] <= '9' {
				prefix += string(pattern[i])
				i++
			}
			if i < pattern.len() && pattern[i] == '.' {
				prefix += "."
				i++
				for i < pattern.len() && pattern[i] >= '0' && pattern[i] <= '9' {
					prefix += string(pattern[i])
					i++
				}
			}

			// Native widths come from the ADM value rather than the source modifier.
			for i < pattern.len() && "hlLzjt".contains(string(pattern[i])) {
				i++
			}

			if i >= pattern.len() {
				result += pattern[start:]
				break
			}

			let verb = pattern[i]
			i++
			let raw = pattern[start:i]
			if !"scdiuoxXfFeEgGv".contains(string(verb)) {
				result += raw
				continue
			}
			if argIndex >= args.len() {
				result += raw
				continue
			}

			let rendered = formatValue(prefix, verb, args[argIndex])
			argIndex++
			if rendered is none {
				result += raw
			} else {
				result += rendered
			}
		}
		return result
	}

	internal def formatValue(prefix string, verb char, value any) ?string {
		if verb == 's' {
			let text = textValue(value)
			return none when text is none
			return sprintf(prefix + "s", text)
		}

		if verb == 'v' {
			let text = textValue(value)
			return sprintf(prefix + "s", text) unless text is none

			let signed = signedValue(value)
			return sprintf(prefix + "lld", signed) unless signed is none

			let unsigned = unsignedValue(value)
			return sprintf(prefix + "llu", unsigned) unless unsigned is none

			let number = floatValue(value)
			return sprintf(prefix + "g", number) unless number is none
			return none
		}

		if verb == 'c' {
			match value {
				case (v); v is char:
					return sprintf(prefix + "c", int(char(v)))
				default:
			}
			let signed = signedValue(value)
			return none when signed is none
			return sprintf(prefix + "c", int(signed))
		}

		if verb == 'd' || verb == 'i' {
			match value {
				case (v); v is bool:
					return sprintf(prefix + "lld", bool(v) ?? (int64(1), int64(0)))
				default:
			}
			let signed = signedValue(value)
			return none when signed is none
			return sprintf(prefix + "lld", signed)
		}

		if verb == 'u' || verb == 'o' || verb == 'x' || verb == 'X' {
			let unsigned = unsignedValue(value)
			return none when unsigned is none
			return sprintf(prefix + "ll" + string(verb), unsigned)
		}

		if verb := 'f' || 'F' || 'e' || 'E' || 'g' || 'G' {
			let number = floatValue(value)
			return none when number is none
			return sprintf(prefix + string(verb), number)
		}

		return none
	}

	internal def textValue(value any) ?string {
		match value {
			case string:
				return value
			case bool:
				return value ?? ("true", "false")
			case char:
				return string(value)
			case Stringer:
				return value.str()
			default:
				return none
		}
	}

	internal def signedValue(value any) ?int64 {
		match value {
			case int:
				return int64(value)
			case int8:
				return int64(value)
			case int16:
				return int64(value)
			case int32:
				return int64(value)
			case int64:
				return value
			case int128:
				return int64(value)
			case char:
				return int64(value)
			default:
				return none
		}
	}

	internal def unsignedValue(value any) ?uint64 {
		match value {
			case uint:
				return uint64(value)
			case uint8:
				return uint64(value)
			case byte:
				return uint64(value)
			case uint16:
				return uint64(value)
			case uint32:
				return uint64(value)
			case uint64:
				return uint64(value)
			case uint128:
				return uint64(value)
			default:
				let signed = signedValue(value)
				return none when signed is none
				return uint64(signed)
		}
	}

	internal def floatValue(value any) ?float64 {
		match value {
			case float16:
				return float64(value)
			case float32:
				return float64(value)
			case float:
				return float64(value)
			case float64:
				return float64(value)
			case float128:
				return float64(value)
			default:
				let signed = signedValue(value)
				return float64(signed) unless signed is none
				let unsigned = unsignedValue(value)
				return float64(unsigned) unless unsigned is none
				return none
		}
	}
}
