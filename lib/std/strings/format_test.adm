partial module std.strings {
	internal type FormatTestValue {
		value int

		def str() string {
			return "value=" + value.str()
		}
	}

	check "String formatting" {
		use std.testing

		@test
		def cStyleFormatting() {
			assert format("%s:%04d", "item", 7) == "item:0007"
			assert format("%#x %.3f", uint16(255), 1.25) == "0xff 1.250"
			assert format("%c %% %v", char(65), false) == "A % false"
			assert format("custom: %s", FormatTestValue{value: 42}) == "custom: value=42"
			assert format("missing %d") == "missing %d"
			assert format("unknown %q", "value") == "unknown %q"
		}
	}
}
