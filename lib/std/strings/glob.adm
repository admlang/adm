partial module std.glob {
	// Glob is a shell-style pattern: `*` matches any run of characters, `?` one
	// character, and a backslash quotes the character after it.
	type Glob {
		pattern string

		def new(pattern string) {
			self.pattern = pattern
		}

		// matches reports whether the whole path matches the pattern.
		def matches(path string) bool {
			// Greedy glob matching with backtracking to the most recent `*`.
			// `*` matches any sequence (including empty), `?` matches one
			// character, and a backslash quotes the following character.
			let patternIndex = 0
			let pathIndex = 0
			let starIndex = -1
			let starPathIndex = -1

			for pathIndex < path.len() {
				if patternIndex < pattern.len() {
					let token = pattern[patternIndex]
					if token == '?' {
						patternIndex++
						pathIndex++
						continue
					}
					if token == '*' {
						starIndex = patternIndex
						patternIndex++
						starPathIndex = pathIndex
						continue
					}
					if token == '\\' && patternIndex + 1 < pattern.len() {
						patternIndex++
						token = pattern[patternIndex]
					}
					if token == path[pathIndex] {
						patternIndex++
						pathIndex++
						continue
					}
				}

				return false when starIndex == -1
				patternIndex = starIndex + 1
				starPathIndex++
				pathIndex = starPathIndex
			}

			for patternIndex < pattern.len() && pattern[patternIndex] == '*' {
				patternIndex++
			}
			return patternIndex == pattern.len()
		}
	}

	// Creates an explicit glob selector. Plain strings remain literal cache keys.
	def glob(pattern string) Glob {
		return new Glob(pattern)
	}
}
