partial module std.strings {
	use std.reflection

	meta def trim<string>(target reflection.ParameterMetaContext) {
		let v = string(target.get())
		target.set(v.trim())
	}

	meta def lower<string>(target reflection.ParameterMetaContext) {
	    let v = string(target.get())
        target.set(v.lower())
	}
}
