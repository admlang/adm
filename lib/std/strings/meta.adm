partial module std.strings {
	use std.reflection

	// trim strips the leading and trailing whitespace off the annotated string
	// parameter before the function body runs.
	meta def trim<string>(target reflection.ParameterMetaContext) {
		let v = string(target.get())
		target.set(v.trim())
	}

	// lower lower-cases the annotated string parameter before the function body
	// runs.
	meta def lower<string>(target reflection.ParameterMetaContext) {
		let v = string(target.get())
		target.set(v.lower())
	}
}
