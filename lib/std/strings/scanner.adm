partial module std.strings {
	// Scanner walks text one code point at a time with a cursor, the loop
	// every hand-written parser repeats: peek, take while a predicate holds,
	// expect a literal, remember where an error happened. `std.net.url`,
	// `std.data.encoding.json` and `toml` each wrote their own; this is the
	// shared one. It never fails on its own: `expect` and friends report a
	// bool, and the caller decides what an unexpected character means.
	//
	// ```
	// let s = new Scanner("key = 42")
	// let key = s.takeWhile(def (c char) bool { return c.isAlphanumeric() })
	// s.skipSpaces()
	// s.expect('=') && key == "key"
	// s.skipSpaces()
	// let n = s.takeWhile(def (c char) bool { return c.isDigit() })
	// n == "42" && s.atEnd()
	// ```
	type Scanner {
		internal text string
		internal pos  int    = 0

		def new(text string) {
			self.text = text
		}

		// atEnd is true once every character was consumed.
		def atEnd() bool {
			return pos >= text.len()
		}

		// peek is the next character without consuming it; none at the end.
		def peek() ?char {
			return none when pos >= text.len()
			return text[pos]
		}

		// peek at an offset ahead of the cursor; none past the end.
		def peek(offset int) ?char {
			let at = pos + offset
			return none when at < 0 || at >= text.len()
			return text[at]
		}

		// next consumes and returns the next character; none at the end.
		def next() ?char {
			return none when pos >= text.len()
			let ch = text[pos]
			pos++
			return ch
		}

		// expect consumes the character when it is next, else leaves the
		// cursor and reports false.
		def expect(ch char) bool {
			return false when pos >= text.len() || text[pos] != ch
			pos++
			return true
		}

		// expect a literal prefix.
		def expect(literal string) bool {
			return false unless text[pos:].startsWith(literal)
			pos += literal.len()
			return true
		}

		// takeWhile consumes characters while the predicate holds and returns
		// them, "" when the first one fails.
		def takeWhile(accept def (char) bool) string {
			let start = pos
			for pos < text.len() && accept(text[pos]) {
				pos++
			}
			return text[start:pos]
		}

		// takeUntil consumes up to (not including) the first character that
		// matches, or the rest of the text.
		def takeUntil(stop def (char) bool) string {
			let start = pos
			for pos < text.len() && !stop(text[pos]) {
				pos++
			}
			return text[start:pos]
		}

		// takeUntil a literal; the cursor stops before it.
		def takeUntil(literal string) string {
			let start = pos
			let at = text.indexOf(literal, pos)
			if at < 0 {
				pos = text.len()
			} else {
				pos = at
			}
			return text[start:pos]
		}

		// skipWhile consumes while the predicate holds and returns how many.
		def skipWhile(accept def (char) bool) int {
			let start = pos
			for pos < text.len() && accept(text[pos]) {
				pos++
			}
			return pos - start
		}

		// skipSpaces consumes ASCII white space.
		def skipSpaces() int {
			return skipWhile(def (c char) bool {
				return c.isSpace()
			})
		}

		// position is the cursor, in code points from the start.
		def position() int {
			return pos
		}

		// seek moves the cursor, for backtracking to a saved position.
		def seek(position int) {
			pos = position
			pos = 0 when pos < 0
			pos = text.len() when pos > text.len()
		}

		// rest is the unconsumed text.
		def rest() string {
			return text[pos:]
		}

		// line and column of the cursor, 1-based, for error messages.
		def line() int {
			let n = 1
			for let i = 0; i < pos && i < text.len(); i++ {
				n++ when text[i] == '\n'
			}
			return n
		}

		def column() int {
			let col = 1
			for let i = 0; i < pos && i < text.len(); i++ {
				if text[i] == '\n' {
					col = 1
				} else {
					col++
				}
			}
			return col
		}
	}
}
