partial module std.strings {
	use std.testing

	// orChar reads an optional character, `?` when absent.
	internal def orChar(value ?char) char {
		return '?' when value is none
		return value
	}

	check "Scanner" {
		@test()
		def walksTokens() {
			let s = new Scanner("key = 42")
			let key = s.takeWhile(def (c char) bool {
				return c.isAlphanumeric()
			})
			assert key == "key"
			assert s.skipSpaces() == 1
			assert s.expect('=')
			assert !s.expect('=')
			s.skipSpaces()
			let n = s.takeWhile(def (c char) bool {
				return c.isDigit()
			})
			assert n == "42"
			assert s.atEnd()
			assert s.peek() is none
			assert s.next() is none
		}

		@test()
		def peeksAndSeeks() {
			let s = new Scanner("abc")
			assert orChar(s.peek()) == 'a'
			assert orChar(s.peek(2)) == 'c'
			assert s.peek(3) is none
			assert orChar(s.next()) == 'a'
			assert s.position() == 1
			assert s.rest() == "bc"
			s.seek(0)
			assert s.rest() == "abc"
			s.seek(99)
			assert s.atEnd()
			s.seek(-5)
			assert s.position() == 0
		}

		@test()
		def literalsAndUntil() {
			let s = new Scanner("name: value; tail")
			assert s.takeUntil(":") == "name"
			assert s.expect(": ")
			assert s.takeUntil(def (c char) bool {
				return c == ';'
			}) == "value"
			assert s.expect(';')
			s.skipSpaces()
			assert s.takeUntil("missing") == "tail"
			assert s.atEnd()
		}

		@test()
		def linesAndColumns() {
			let s = new Scanner("ab" + '\n' + "cde")
			s.seek(4)
			assert s.line() == 2
			assert s.column() == 2
			s.seek(0)
			assert s.line() == 1 && s.column() == 1
		}
	}
}
