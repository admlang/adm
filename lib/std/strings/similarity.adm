partial module std.strings {
	// Selects the algorithm used to compare two strings.
	enum SimilarityAlgorithm {
		// Normalized edit similarity based on insertions, deletions, and substitutions.
		Levenshtein,
		// Sørensen-Dice similarity over adjacent character pairs.
		Dice,
		// Positional similarity; differing lengths count as additional mismatches.
		Hamming,
		// Similarity based on matching characters and transpositions.
		Jaro,
		// Jaro similarity with additional weight for a shared prefix.
		JaroWinkler,
	}

	// Returns a similarity score between a and b in the range 0.0 through 1.0.
	//
	// A score of 1.0 means the strings are equal. The default normalized
	// Levenshtein algorithm works well as a general-purpose comparison. All
	// algorithms compare ADM characters rather than raw UTF-8 bytes.
	def similarity(a, b string, algorithm SimilarityAlgorithm = SimilarityAlgorithm.Levenshtein) float {
		match algorithm {
			case SimilarityAlgorithm.Levenshtein:
				return levenshteinSimilarity(a, b)
			case SimilarityAlgorithm.Dice:
				return diceCoefficient(a, b)
			case SimilarityAlgorithm.Hamming:
				return hammingSimilarity(a, b)
			case SimilarityAlgorithm.Jaro:
				return jaroSimilarity(a, b)
			case SimilarityAlgorithm.JaroWinkler:
				return jaroWinklerSimilarity(a, b)
		}
		return levenshteinSimilarity(a, b)
	}

	// Returns the Levenshtein edit distance between a and b.
	def levenshteinDistance(a, b string) int {
		return b.len() when a.len() == 0
		return a.len() when b.len() == 0
		return 0 when a == b

		// Keep the working row on the shorter string so memory is O(min(a, b)).
		let columns = a
		let rows = b
		if a.len() > b.len() {
			columns = b
			rows = a
		}

		let row = int[]
		row.len(columns.len() + 1)
		for let j = 0; j <= columns.len(); j++ {
			row[j] = j
		}

		for let i = 1; i <= rows.len(); i++ {
			let previous = i
			for let j = 1; j <= columns.len(); j++ {
				let current = row[j - 1]
				if rows[i - 1] != columns[j - 1] {
					current = similarityMin3(row[j - 1] + 1, previous + 1, row[j] + 1)
				}
				row[j - 1] = previous
				previous = current
			}
			row[columns.len()] = previous
		}
		return row[columns.len()]
	}

	// Returns normalized Levenshtein similarity from 0.0 through 1.0.
	def levenshteinSimilarity(a, b string) float {
		let length = similarityMax(a.len(), b.len())
		return 1.0 when length == 0
		return 1.0 - float(levenshteinDistance(a, b)) / float(length)
	}

	// Returns the Sørensen-Dice coefficient over adjacent character pairs.
	// Duplicate pairs are counted, so repeated text is compared accurately.
	def diceCoefficient(a, b string) float {
		return 1.0 when a == b
		return 0.0 when a.len() < 2 || b.len() < 2

		let first = a
		let second = b
		if b.len() > a.len() {
			first = b
			second = a
		}

		let bigrams = map<string, int>{}
		for let i = 0; i < first.len() - 1; i++ {
			let bigram = first[i:i + 2]
			let count = bigrams.get(bigram)
			if count is none {
				bigrams[bigram] = 1
			} else {
				bigrams[bigram] = int(count) + 1
			}
		}

		let intersection = 0
		for let i = 0; i < second.len() - 1; i++ {
			let bigram = second[i:i + 2]
			let count = bigrams.get(bigram)
			continue when count is none
			let remaining = int(count)
			continue when remaining <= 0
			bigrams[bigram] = remaining - 1
			intersection++
		}

		return 2.0 * float(intersection) / float(first.len() + second.len() - 2)
	}

	// Returns the Hamming distance, including unmatched trailing characters.
	def hammingDistance(a, b string) int {
		let matchingLength = similarityMin(a.len(), b.len())
		let differences = similarityAbsDifference(a.len(), b.len())
		for let i = 0; i < matchingLength; i++ {
			differences++ when a[i] != b[i]
		}
		return differences
	}

	// Returns normalized positional similarity from 0.0 through 1.0.
	def hammingSimilarity(a, b string) float {
		let length = similarityMax(a.len(), b.len())
		return 1.0 when length == 0
		return 1.0 - float(hammingDistance(a, b)) / float(length)
	}

	// Returns Jaro similarity from 0.0 through 1.0.
	def jaroSimilarity(a, b string) float {
		return 1.0 when a == b
		return 0.0 when a.len() == 0 || b.len() == 0

		let matchDistance = similarityMax(similarityMax(a.len(), b.len()) / 2 - 1, 0)
		let aMatches = bool[]
		let bMatches = bool[]
		aMatches.len(a.len())
		bMatches.len(b.len())
		let matches = 0

		for let i = 0; i < a.len(); i++ {
			let start = similarityMax(0, i - matchDistance)
			let end = similarityMin(b.len(), i + matchDistance + 1)
			for let j = start; j < end; j++ {
				continue when bMatches[j] || a[i] != b[j]
				aMatches[i] = true
				bMatches[j] = true
				matches++
				break
			}
		}
		return 0.0 when matches == 0

		let bIndex = 0
		let transpositions = 0
		for let i = 0; i < a.len(); i++ {
			continue unless aMatches[i]
			for bIndex < b.len() && !bMatches[bIndex] {
				bIndex++
			}
			transpositions++ when a[i] != b[bIndex]
			bIndex++
		}

		let matchCount = float(matches)
		return (matchCount / float(a.len()) + matchCount / float(b.len()) + (matchCount - float(transpositions) / 2.0) / matchCount) / 3.0
	}

	// Returns Jaro-Winkler similarity from 0.0 through 1.0.
	// Up to four shared leading characters receive the standard 0.1 prefix bonus.
	def jaroWinklerSimilarity(a, b string) float {
		let prefixLimit = similarityMin(4, similarityMin(a.len(), b.len()))
		let prefixLength = 0
		for prefixLength < prefixLimit && a[prefixLength] == b[prefixLength] {
			prefixLength++
		}
		let score = jaroSimilarity(a, b)
		return score + float(prefixLength) * 0.1 * (1.0 - score)
	}

	internal def similarityMin(a, b int) int {
		return a when a < b
		return b
	}

	internal def similarityMax(a, b int) int {
		return a when a > b
		return b
	}

	internal def similarityMin3(a, b, c int) int {
		return similarityMin(similarityMin(a, b), c)
	}

	internal def similarityAbsDifference(a, b int) int {
		return a - b when a >= b
		return b - a
	}
}
