partial module std.strings {
	check "String similarity" {
		use (
			std.math
			std.testing
		)

		@test()
		def algorithms() {
			assert math.approx(similarity("kitten", "sitting"), 4.0 / 7.0, 1e-9)
			assert math.approx(similarity("night", "nacht", SimilarityAlgorithm.Dice), 0.25, 1e-9)
			assert math.approx(similarity("karolin", "kathrin", SimilarityAlgorithm.Hamming), 4.0 / 7.0, 1e-9)
			assert math.approx(similarity("MARTHA", "MARHTA", SimilarityAlgorithm.Jaro), 0.9444444444, 1e-9)
			assert math.approx(similarity("MARTHA", "MARHTA", SimilarityAlgorithm.JaroWinkler), 0.9611111111, 1e-9)
		}

		@test()
		def distancesAndEdges() {
			assert levenshteinDistance("kitten", "sitting") == 3
			assert hammingDistance("abc", "ax") == 2
			assert similarity("", "") == 1.0
			assert similarity("", "abc") == 0.0
			assert diceCoefficient("a", "a") == 1.0
			assert diceCoefficient("a", "b") == 0.0
			assert diceCoefficient("aaaa", "aa") == 0.5
			assert similarity("😀a", "😀b", SimilarityAlgorithm.Hamming) == 0.5
		}
	}
}
