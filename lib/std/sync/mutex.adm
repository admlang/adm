partial module std.sync {
	// Mutex is a lock one task holds at a time. It is not tied to the task
	// that locked it (another task may unlock it) and it is not reentrant:
	// a task that locks it twice waits for itself.
	//
	// ```
	// accounts.lock()
	// defer accounts.unlock()
	// ```
	type Mutex {
		internal permit Semaphore

		def new() {
			permit = new Semaphore(1)
		}

		// Takes the lock, waiting while another task holds it.
		def lock() {
			permit.acquire()
		}

		// Takes the lock when it is free now. Reports whether it did.
		def tryLock() bool {
			return permit.tryAcquire()
		}

		// Takes the lock, waiting up to `wait` for it. Reports whether it
		// got it.
		def tryLock(wait duration) bool {
			return permit.tryAcquire(wait)
		}

		// Frees the lock and lets one waiting task take it. Unlocking a
		// free lock changes nothing.
		def unlock() {
			permit.release()
		}

		// Whether a task holds the lock at this moment.
		def locked() bool {
			return permit.available() == 0
		}
	}

	// Once runs a function one time, however many tasks ask. A task that
	// asks while the function runs waits for it to end.
	//
	// ```
	// let setup = new Once()
	// setup.run(() => loadTables())
	// ```
	type Once {
		internal atomic ran bool
		internal gate       Mutex

		def new() {
			ran = false
			gate = new Mutex()
		}

		// Runs the function unless a call of `run` on this Once already
		// ran one to its end.
		def run(body def ()) {
			return when ran
			gate.lock()
			defer gate.unlock()
			return when ran
			body()
			ran = true
		}

		// Whether a function has run to its end.
		def done() bool {
			return ran
		}
	}
}
