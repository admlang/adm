partial module std.sync {
	// ReadWriteLock lets any number of tasks read together, or one task
	// write alone. A waiting writer goes before readers that ask after it,
	// so a stream of readers cannot keep a writer out. It is not reentrant.
	//
	// ```
	// table.lockRead()
	// defer table.unlockRead()
	// ```
	type ReadWriteLock {
		internal readers        int
		internal writing        bool
		internal readersWaiting int
		internal writersWaiting int
		// Each holds one token while a waiting reader or writer should
		// look again.
		internal readerWake     channel<bool>
		internal writerWake     channel<bool>

		def new() {
			readers = 0
			writing = false
			readersWaiting = 0
			writersWaiting = 0
			readerWake = new channel<bool>(size = 1)
			writerWake = new channel<bool>(size = 1)
		}

		// Takes the lock for writing, waiting until no task reads or
		// writes.
		def lock() {
			return when takeWrite(queue = true, queued = false)
			for {
				let _ = <-writerWake
				return when takeWrite(queue = false, queued = true)
			}
		}

		// Takes the lock for writing when no task reads or writes now.
		// Reports whether it did.
		def tryLock() bool {
			return takeWrite(queue = false, queued = false)
		}

		// Frees the lock after writing. A waiting writer goes next, else
		// every waiting reader.
		atomic def unlock() {
			return when !writing
			writing = false
			if writersWaiting > 0 {
				writerWake <- true when writerWake.len() == 0
			} else if readersWaiting > 0 {
				readerWake <- true when readerWake.len() == 0
			}
		}

		// Takes the lock for reading, waiting while a task writes or
		// waits to write.
		def lockRead() {
			return when takeRead(queue = true, queued = false)
			for {
				let _ = <-readerWake
				return when takeRead(queue = false, queued = true)
			}
		}

		// Takes the lock for reading when no task writes or waits to
		// write now. Reports whether it did.
		def tryLockRead() bool {
			return takeRead(queue = false, queued = false)
		}

		// Frees the lock after reading. The last reader out lets a
		// waiting writer in.
		atomic def unlockRead() {
			return when readers == 0
			readers--
			writerWake <- true when readers == 0 && writersWaiting > 0 && writerWake.len() == 0
		}

		// One attempt to write. `queue` counts the caller as waiting when
		// it fails; `queued` says it already counts.
		internal atomic def takeWrite(queue bool, queued bool) bool {
			if writing || readers > 0 {
				writersWaiting++ when queue
				return false
			}
			writing = true
			writersWaiting-- when queued
			return true
		}

		// One attempt to read, with the flags of `takeWrite`. A reader
		// that gets in lets the next waiting reader look too.
		internal atomic def takeRead(queue bool, queued bool) bool {
			if writing || writersWaiting > 0 {
				readersWaiting++ when queue
				return false
			}
			readers++
			readersWaiting-- when queued
			readerWake <- true when readersWaiting > 0 && readerWake.len() == 0
			return true
		}
	}
}
