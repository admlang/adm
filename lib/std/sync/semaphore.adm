partial module std.sync {
	use std.time

	// Semaphore holds a number of permits. `acquire` takes one, waiting
	// while none is free; `release` gives one back. Use it to bound how many
	// tasks do something at once.
	//
	// ```
	// let downloads = new Semaphore(4)
	// downloads.acquire()
	// defer downloads.release()
	// ```
	//
	// Waiting tasks are not served in order: a task that asks when a permit
	// is free takes it ahead of the ones already waiting.
	type Semaphore {
		internal permits int
		internal free    int
		internal waiting int
		// Holds one token while a waiting task should look again.
		internal wake    channel<bool>

		// A semaphore of `permits` permits, all free. Fewer than one counts
		// as one.
		def new(permits int = 1) {
			self.permits = permits.max(1)
			free = self.permits
			waiting = 0
			wake = new channel<bool>(size = 1)
		}

		// Takes a permit, waiting until one is free.
		def acquire() {
			return when take(true)
			for {
				let _ = <-wake
				return when retake()
			}
		}

		// Takes a permit when one is free now. Reports whether it did.
		def tryAcquire() bool {
			return take(false)
		}

		// Takes a permit, waiting up to `wait` for one. Reports whether it
		// got one.
		def tryAcquire(wait duration) bool {
			return true when take(true)
			let until = time.now() + wait
			for {
				let left = until - time.now()
				if left <= 0s {
					giveUp()
					return false
				}
				let timer = time.sleepChan(left)
				select {
					case wake:
						wake.flush()
					case timer:
				}
				return true when retake()
			}
			return false
		}

		// Gives a permit back and lets one waiting task go on. Releasing
		// more permits than were acquired changes nothing.
		atomic def release() {
			return when free >= permits
			free++
			wake <- true when waiting > 0 && wake.len() == 0
		}

		// The number of free permits at this moment.
		atomic def available() int {
			return free
		}

		// Takes a permit when one is free; otherwise counts the caller as
		// waiting when `queue` is set.
		internal atomic def take(queue bool) bool {
			if free > 0 {
				free--
				return true
			}
			waiting++ when queue
			return false
		}

		// The attempt of a task that was waiting. On success it stops
		// counting as waiting and, when permits are left, lets the next
		// waiting task look too.
		internal atomic def retake() bool {
			return false when free == 0
			free--
			waiting--
			wake <- true when free > 0 && waiting > 0 && wake.len() == 0
			return true
		}

		// A waiting task leaves without a permit.
		internal atomic def giveUp() {
			waiting--
			wake <- true when free > 0 && waiting > 0 && wake.len() == 0
		}
	}
}
