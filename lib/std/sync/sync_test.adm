partial module std.sync {
	use (
		std.testing
		std.time
	)

	// Shared state the tests reach from several tasks. `value` and `other`
	// are plain fields on purpose: only the lock under test protects them.
	internal type Shared {
		value int = 0
		other int = 0

		internal active int = 0
		internal most   int = 0

		def new() {}

		// Counts a task in, remembering the most that were in together.
		atomic def enter() {
			active++
			most = most.max(active)
		}

		atomic def leave() {
			active--
		}

		atomic def peak() int {
			return most
		}
	}

	internal def lockedAdds(lock Mutex, shared Shared, rounds int) int {
		for let i = 0; i < rounds; i++ {
			lock.lock()
			let seen = shared.value
			time.sleep(50us) when i % 8 == 0
			shared.value = seen + 1
			lock.unlock()
		}
		return rounds
	}

	internal def unlockAfter(lock Mutex, wait duration) int {
		time.sleep(wait)
		lock.unlock()
		return 0
	}

	internal def limitedWork(limit Semaphore, shared Shared, rounds int) int {
		for let i = 0; i < rounds; i++ {
			limit.acquire()
			shared.enter()
			time.sleep(200us)
			shared.leave()
			limit.release()
		}
		return rounds
	}

	internal def writes(lock ReadWriteLock, shared Shared, rounds int) int {
		for let i = 0; i < rounds; i++ {
			lock.lock()
			shared.value++
			time.sleep(20us) when i % 4 == 0
			shared.other++
			lock.unlock()
		}
		return rounds
	}

	// Counts the reads that saw the two fields apart: a writer in between.
	internal def reads(lock ReadWriteLock, shared Shared, rounds int) int {
		let torn = 0
		for let i = 0; i < rounds; i++ {
			lock.lockRead()
			shared.enter()
			torn++ when shared.value != shared.other
			shared.leave()
			lock.unlockRead()
		}
		return torn
	}

	internal def writeOnce(lock ReadWriteLock, shared Shared) int {
		lock.lock()
		shared.value = 100
		lock.unlock()
		return 0
	}

	internal def finishes(group WaitGroup, shared Shared, wait duration) int {
		time.sleep(wait)
		shared.enter()
		group.done()
		return 0
	}

	internal def runsOnce(once Once, shared Shared) int {
		once.run(def () {
			time.sleep(5ms)
			shared.value++
		})
		return 0
	}

	check "Sync" {
		@test()
		def TestMutexKeepsOneTaskIn() {
			let lock = new Mutex()
			let shared = new Shared()
			let tasks (async int)[]
			for let t = 0; t < 8; t++ {
				tasks.push(async lockedAdds(lock, shared, 400))
			}
			for let task in tasks {
				await task
			}
			assert shared.value == 3200
			assert !lock.locked()
		}

		@test()
		def TestMutexTryLock() {
			let lock = new Mutex()
			assert lock.tryLock() && lock.locked()
			assert !lock.tryLock()
			let started = time.now()
			assert !lock.tryLock(30ms)
			assert time.now() - started >= 30ms

			// Another task frees it while this one waits.
			let helper = async unlockAfter(lock, 20ms)
			assert lock.tryLock(2s)
			await helper
			lock.unlock()
			assert !lock.locked()
			lock.unlock()
			assert lock.tryLock()
		}

		@test()
		def TestSemaphoreBoundsTasks() {
			let limit = new Semaphore(3)
			let shared = new Shared()
			let tasks (async int)[]
			for let t = 0; t < 12; t++ {
				tasks.push(async limitedWork(limit, shared, 20))
			}
			for let task in tasks {
				await task
			}
			assert shared.peak() <= 3 && shared.peak() >= 2
			assert limit.available() == 3

			assert limit.tryAcquire() && limit.tryAcquire() && limit.tryAcquire()
			assert !limit.tryAcquire() && !limit.tryAcquire(10ms)
			limit.release()
			assert limit.available() == 1 && limit.tryAcquire(10ms)
			for let i = 0; i < 5; i++ {
				limit.release()
			}
			assert limit.available() == 3
		}

		@test()
		def TestReadWriteLock() {
			let lock = new ReadWriteLock()
			assert lock.tryLockRead() && lock.tryLockRead()
			assert !lock.tryLock()
			lock.unlockRead()
			assert !lock.tryLock()
			lock.unlockRead()
			assert lock.tryLock()
			assert !lock.tryLockRead() && !lock.tryLock()
			lock.unlock()

			// A waiting writer goes before a reader that asks after it.
			let shared = new Shared()
			lock.lockRead()
			let writer = async writeOnce(lock, shared)
			time.sleep(30ms)
			assert shared.value == 0
			assert !lock.tryLockRead()
			lock.unlockRead()
			await writer
			assert shared.value == 100
			assert lock.tryLockRead()
			lock.unlockRead()
		}

		@test()
		def TestReadWriteLockUnderLoad() {
			let lock = new ReadWriteLock()
			let shared = new Shared()
			let writers (async int)[]
			let readers (async int)[]
			for let t = 0; t < 4; t++ {
				writers.push(async writes(lock, shared, 300))
			}
			for let t = 0; t < 8; t++ {
				readers.push(async reads(lock, shared, 600))
			}
			let torn = 0
			for let task in readers {
				torn += await task
			}
			for let task in writers {
				await task
			}
			assert torn == 0
			assert shared.value == 1200 && shared.other == 1200
			assert lock.tryLock()
		}

		@test()
		def TestWaitGroup() {
			let group = new WaitGroup()
			group.wait()
			assert group.wait(1ms)

			let shared = new Shared()
			let tasks (async int)[]
			for let t = 0; t < 10; t++ {
				group.add()
				tasks.push(async finishes(group, shared, duration((t + 1) * 2000000)))
			}
			assert group.pending() > 0
			assert !group.wait(1ms)
			group.wait()
			assert group.pending() == 0 && shared.peak() == 10
			for let task in tasks {
				await task
			}
			group.done()
			assert group.pending() == 0
		}

		@test()
		def TestOnce() {
			let once = new Once()
			let shared = new Shared()
			assert !once.done()
			let tasks (async int)[]
			for let t = 0; t < 8; t++ {
				tasks.push(async runsOnce(once, shared))
			}
			for let task in tasks {
				await task
			}
			assert shared.value == 1 && once.done()
			once.run(def () {
				shared.value = 50
			})
			assert shared.value == 1
		}
	}
}
