partial module std.sync {
	use std.time

	// WaitGroup counts work in progress and lets tasks wait until there is
	// none: `add` before starting a piece of work, `done` when it ends,
	// `wait` to stay until the count is back at zero.
	//
	// ```
	// let jobs = new WaitGroup()
	// for let (_, file) in files {
	// 	jobs.add()
	// 	async convert(file, jobs)   // calls jobs.done() when it ends
	// }
	// jobs.wait()
	// ```
	type WaitGroup {
		internal count   int
		internal waiting int
		// Holds one token while a waiting task should look again.
		internal wake    channel<bool>

		def new() {
			count = 0
			waiting = 0
			wake = new channel<bool>(size = 1)
		}

		// Adds `n` pieces of work to the count. A count taken below zero
		// stays at zero.
		atomic def add(n int = 1) {
			count = (count + n).max(0)
			wake <- true when count == 0 && waiting > 0 && wake.len() == 0
		}

		// Takes one piece of work off the count.
		def done() {
			add(-1)
		}

		// Waits until the count is zero; returns at once when it is.
		def wait() {
			return when settled(queue = true, queued = false)
			for {
				let _ = <-wake
				return when settled(queue = false, queued = true)
			}
		}

		// Waits up to `limit` for the count to be zero. Reports whether it
		// got there.
		def wait(limit duration) bool {
			return true when settled(queue = true, queued = false)
			let until = time.now() + limit
			for {
				let left = until - time.now()
				if left <= 0s {
					giveUp()
					return false
				}
				let timer = time.sleepChan(left)
				select {
					case wake:
						wake.flush()
					case timer:
				}
				return true when settled(queue = false, queued = true)
			}
			return false
		}

		// The count at this moment.
		atomic def pending() int {
			return count
		}

		// Whether the count is zero. `queue` counts the caller as waiting
		// when it is not; `queued` says it already counts. A waiting task
		// that sees zero lets the next one look too.
		internal atomic def settled(queue bool, queued bool) bool {
			if count > 0 {
				waiting++ when queue
				return false
			}
			waiting-- when queued
			wake <- true when waiting > 0 && wake.len() == 0
			return true
		}

		// A waiting task leaves before the count reached zero.
		internal atomic def giveUp() {
			waiting--
		}
	}
}
