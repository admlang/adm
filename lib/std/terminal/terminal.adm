// A terminal emulator's screen: what the output of a program written for a
// VT100 or xterm terminal means, as a grid of cells with their attributes,
// a cursor, a scrollback and the modes the program set, for a window that
// draws it (`std.ui.components.TerminalView`) or a test that reads it. The
// bytes come from a pty, an SSH channel or a container's exec stream in
// whatever pieces arrive; `feed` carries a sequence cut between two pieces
// over. What the program asks back (its terminal's identity, the cursor's
// position) waits in `responses` for the caller to write to it.
partial module std.terminal {
	use (
		std.text.unicode::(displayWidth)
	)

	// How a cell's colour is given: the terminal's default for the ground,
	// one of the 256 indexed colours (0-15 the named ones, 16-231 a colour
	// cube, 232-255 greys), or a colour by its components.
	enum ColorMode {
		Default,
		Indexed,
		Rgb
	}

	// A cell's foreground or background.
	struct CellColor {
		mode  ColorMode = ColorMode.Default
		// 0 to 255 when indexed.
		index int       = 0
		// 0 to 255 each when given by components.
		red   int       = 0
		green int       = 0
		blue  int       = 0
	}

	// How a cell is underlined.
	enum Underline {
		None,
		Single,
		Double,
		Curly,
		Dotted,
		Dashed
	}

	// What a cell is drawn with: the pen a program sets with SGR.
	struct Attributes {
		foreground CellColor = CellColor{}
		background CellColor = CellColor{}
		bold       bool      = false
		faint      bool      = false
		italic     bool      = false
		underline  Underline = Underline.None
		blink      bool      = false
		// Foreground and background swapped.
		inverse    bool      = false
		invisible  bool      = false
		strike     bool      = false
	}

	// One cell of the grid.
	struct Cell {
		// The character shown, with any combining characters after it; "" for
		// the second column of a wide character.
		text  string     = " "
		// The columns the character takes: 1, 2 for a wide character, 0 for
		// the column after one.
		width int        = 1
		look  Attributes = Attributes{}
	}

	// Which pointer events the program asked to be told of (xterm's modes
	// 9, 1000, 1002, 1003).
	enum MouseReport {
		None,
		// Presses only (mode 9).
		Press,
		// Presses and releases (1000).
		Normal,
		// Presses, releases and moves while a button is down (1002).
		Button,
		// Every move (1003).
		Any
	}

	// The shape a program asked for the cursor (DECSCUSR).
	enum CursorShape {
		Block,
		Underline,
		Bar
	}

	// Where the cursor is: columns and rows from 0.
	struct Cursor {
		column int = 0
		row    int = 0
	}

	// The 256 indexed colours' components for the cube and the greys
	// (16-255); the sixteen named ones are the drawing side's, from its theme.
	def indexedRgb(index int) (int, int, int) {
		if index >= 232 {
			let grey = 8 + (index - 232) * 10
			return (grey, grey, grey)
		}
		let n = (index - 16).max(0)
		let levels = [0, 95, 135, 175, 215, 255]
		return (levels[n / 36], levels[(n / 6) % 6], levels[n % 6])
	}

	internal const stateGround = 0
	internal const stateEscape = 1
	internal const stateCsi = 2
	internal const stateOsc = 3
	internal const stateString = 4
	internal const stateEscapeString = 5
	internal const stateCharset = 6
	internal const stateHash = 7
	internal const stateCsiIgnore = 8

	internal const defaultScrollback = 10000

	// The box-drawing characters DEC special graphics puts at 0x60 to 0x7e.
	internal const decGraphics = "◆▒␉␌␍␊°±␤␋┘┐┌└┼⎺⎻─⎼⎽├┤┴┬│≤≥π≠£·"

	// Screen is a terminal's state: `columns` by `rows` cells, the cursor, the
	// lines that scrolled off the top (`scrollbackLines`), the alternate
	// screen a full-screen program switches to, and the modes a program sets.
	// Feed it the bytes the program writes; read it to draw.
	//
	// ```
	// let screen = new terminal.Screen(80, 24)
	// screen.feed("\u001b[1;31mError:\u001b[0m disk full\r\n".bytes())
	// println(screen.rowText(0))                       // Error: disk full
	// let answer = screen.responses()                 // what the program asked back
	// ```
	type Screen {
		columns               int
		rows                  int
		cursor                Cursor      = Cursor{}
		cursorVisible         bool        = true
		cursorShape           CursorShape = CursorShape.Block
		// The window title the program set (OSC 0 and 2).
		title                 string      = ""
		// The working directory the program told (OSC 7), as given.
		workingDirectory      string      = ""
		// How many times the program rang the bell.
		bells                 int         = 0
		// Lines kept once they scroll off the main screen's top; the oldest
		// are dropped past `scrollbackLimit`.
		scrollbackLimit       int         = defaultScrollback
		// Modes a program sets, read by the side that sends it keys.
		applicationCursorKeys bool        = false
		applicationKeypad     bool        = false
		bracketedPaste        bool        = false
		mouse                 MouseReport = MouseReport.None
		// Pointer reports in SGR form (mode 1006) rather than X10's bytes.
		mouseSgr              bool        = false
		focusReports          bool        = false
		// Whether the alternate screen is shown.
		alternate             bool        = false
		// Counts up on every change a drawing has to follow.
		generation            int         = 0

		internal lines        Cell[][]   = []
		internal other        Cell[][]   = []
		internal scrollback   Cell[][]   = []
		internal pen          Attributes = Attributes{}
		internal top          int        = 0
		internal bottom       int        = 0
		internal autoWrap     bool       = true
		internal wrapPending  bool       = false
		internal originMode   bool       = false
		internal insertMode   bool       = false
		internal newLineMode  bool       = false
		internal reverseVideo bool       = false
		internal tabs         bool[]     = []
		internal dirty        bool[]     = []
		internal savedCursor  Cursor     = Cursor{}
		internal savedPen     Attributes = Attributes{}
		internal savedOrigin  bool       = false
		internal savedWrap    bool       = true
		internal otherSaved   Cursor     = Cursor{}
		// Character sets: G0 and G1 as designated (`B` ASCII, `0` DEC
		// graphics) and which is in use.
		internal charsets     string[]   = ["B", "B"]
		internal charsetIn    int        = 0
		// The parser: its state, the parameters, intermediates and private
		// marker of the sequence being read, the string of an OSC, and the
		// bytes of a UTF-8 sequence cut by the end of a feed.
		internal state        int        = stateGround
		internal params       int[]      = []
		internal subparams    int[][]    = []
		internal paramText    string     = ""
		internal private      string     = ""
		internal intermediate string     = ""
		internal oscText      string     = ""
		internal cut          byte[]     = []
		internal pending      byte[]     = []

		def new(columns int = 80, rows int = 24) {
			self.columns = columns.max(1)
			self.rows = rows.max(1)
			lines = blankLines(self.rows)
			other = blankLines(self.rows)
			bottom = self.rows - 1
			tabs = defaultTabs()
			dirty = allRows(true)
		}

		// feed reads what the program wrote, however it was cut into
		// pieces, and applies it to the screen.
		def feed(data byte[]) {
			let i = 0
			let n = data.len()
			for i < n {
				let b = int(data[i])
				if cut.len() > 0 || b >= 0x80 {
					i = continueUTF8(data, i)
					continue
				}
				i++
				take(b)
			}
		}

		// feed reads text as the bytes of its UTF-8.
		def feed(text string) {
			feed(text.bytes())
		}

		// responses takes what the program asked back since the last call (its
		// terminal's identity, the cursor's position, the screen size), for the
		// caller to write to the program; empty when nothing waits.
		def responses() byte[] {
			let out = pending
			pending = []
			return out
		}

		// takeDirty tells which rows changed since the last call, and marks
		// them clean.
		def takeDirty() bool[] {
			let out = dirty
			dirty = allRows(false)
			return out
		}

		// resize gives the screen a new size: lines are cut or padded at the
		// right, lines at the bottom are dropped (the main screen keeps them
		// as scrollback when the cursor is below the new height) or added
		// blank, and the cursor and the scroll region are kept inside.
		def resize(columns int, rows int) {
			let wide = columns.max(1)
			let high = rows.max(1)
			return when wide == self.columns && high == self.rows
			// When the screen gets shorter, the lines above the cursor leave
			// first, so what was being typed stays in view.
			let above = cursor.row.min((self.rows - high).max(0))
			lines = resized(lines, wide, high, !alternate, above)
			other = resized(other, wide, high, false, above)
			self.columns = wide
			self.rows = high
			top = 0
			bottom = high - 1
			cursor.column = cursor.column.min(wide - 1)
			cursor.row = (cursor.row - above).max(0).min(high - 1)
			savedCursor.column = savedCursor.column.min(wide - 1)
			savedCursor.row = savedCursor.row.min(high - 1)
			wrapPending = false
			tabs = defaultTabs()
			dirty = allRows(true)
			generation++
		}

		// line is the cells of the visible row, as drawn.
		def line(row int) Cell[] {
			return lines[row.max(0).min(rows - 1)]
		}

		// line is the cells of row `row` of the screen scrolled back by `back`
		// lines: the scrollback's lines take the top, the screen's own move
		// down. The alternate screen has no scrollback.
		def line(row int, back int) Cell[] {
			let kept = scrollbackLines()
			let up = back.max(0).min(kept)
			let at = row - up
			return lines[at.min(rows - 1)] when at >= 0
			return scrollback[kept + at]
		}

		// scrollbackLines is how many lines scrolled off the top are kept.
		def scrollbackLines() int {
			return alternate ?? (0, scrollback.len())
		}

		// rowText is the text of a visible row with the blanks at its end
		// removed.
		def rowText(row int) string {
			return textOf(lines[row.max(0).min(rows - 1)])
		}

		// text is the visible screen as lines of text, each with its trailing
		// blanks removed, joined with line feeds.
		def text() string {
			let out string[] = []
			for let row in lines {
				out.push(textOf(row))
			}
			return out.join("\n")
		}

		// selection is the text between two cells of the screen scrolled back
		// by `back` lines, from the first (inclusive) to the second (exclusive
		// of its column), lines joined with line feeds and their trailing
		// blanks removed: what a copy takes.
		def selection(back int, fromColumn int, fromRow int, toColumn int, toRow int) string {
			let (c1, r1, c2, r2) = (fromColumn, fromRow, toColumn, toRow)
			(c1, r1, c2, r2) = (toColumn, toRow, fromColumn, fromRow) when r2 < r1 || (r2 == r1 && c2 < c1)
			let out string[] = []
			for let row = r1; row <= r2; row++ {
				let cells = line(row, back)
				let first = row == r1 ?? (c1, 0)
				let last = row == r2 ?? (c2, cells.len())
				let start = first.max(0).min(cells.len())
				let stop = last.max(start).min(cells.len())
				out.push(textOf(cells.slice(start, stop - start)))
			}
			return out.join("\n")
		}

		// reset puts the terminal in its starting state (RIS): a clear main
		// screen, the default pen, cursor at the top left, every mode off.
		def reset() {
			lines = blankLines(rows)
			other = blankLines(rows)
			scrollback = []
			alternate = false
			cursor = Cursor{}
			savedCursor = Cursor{}
			otherSaved = Cursor{}
			pen = Attributes{}
			savedPen = Attributes{}
			top = 0
			bottom = rows - 1
			autoWrap = true
			wrapPending = false
			originMode = false
			insertMode = false
			newLineMode = false
			reverseVideo = false
			applicationCursorKeys = false
			applicationKeypad = false
			bracketedPaste = false
			mouse = MouseReport.None
			mouseSgr = false
			focusReports = false
			cursorVisible = true
			cursorShape = CursorShape.Block
			charsets = ["B", "B"]
			charsetIn = 0
			tabs = defaultTabs()
			state = stateGround
			cut = []
			dirty = allRows(true)
			generation++
		}

		// --- bytes to characters ---

		// Reads one UTF-8 sequence starting at i (or continuing the one
		// `cut` holds) and returns where the next byte is. A sequence
		// the data ends inside is kept for the next feed; a malformed one
		// shows as U+FFFD.
		internal def continueUTF8(data byte[], i int) int {
			let at = i
			for at < data.len() {
				let b = int(data[at])
				if cut.len() == 0 {
					cut.push(data[at])
					at++
					continue
				}
				// A lead byte while a sequence is open: the open one was cut
				// short.
				if b < 0x80 || b >= 0xc0 {
					put(0xfffd)
					cut = []
					return at
				}
				cut.push(data[at])
				at++
				let need = sequenceLength(int(cut[0]))
				if cut.len() == need {
					put(decodeUTF8(cut))
					cut = []
					return at
				}
			}
			// The data ended: a complete sequence of one byte is a lead byte
			// alone, which needs more; the rest waits.
			if cut.len() > 0 && cut.len() >= sequenceLength(int(cut[0])) {
				put(decodeUTF8(cut))
				cut = []
			}
			return at
		}

		// A character read from the program's bytes: printed, or taken as a
		// control the parser is in the middle of.
		internal def put(point int) {
			if state == stateGround {
				print(point)
				return
			}
			if state == stateOsc || state == stateString {
				oscText += string(char(point)) when state == stateOsc
				return
			}
			// A non-ASCII character inside an escape sequence ends it.
			state = stateGround
			print(point)
		}

		// take handles one ASCII byte by the parser's state.
		internal def take(b int) {
			// C0 controls act in every state but a string's; ESC starts over.
			if b == 0x1b {
				if state == stateOsc {
					state = stateEscapeString
					return
				}
				if state == stateString {
					state = stateEscapeString
					return
				}
				beginEscape()
				return
			}
			if b < 0x20 {
				if state == stateOsc || state == stateString {
					endString() when b == 0x07
					return
				}
				control(b)
				return
			}
			switch state {
				case stateGround:
					print(b)
				case stateEscape:
					escape(b)
				case stateCsi:
					csiByte(b)
				case stateCsiIgnore:
					state = stateGround when b >= 0x40 && b <= 0x7e
				case stateOsc:
					oscText += string(char(b))
				case stateString:
					return
				case stateEscapeString:
					// ESC \ ends a string; anything else was a stray ESC.
					if b == 0x5c {
						endString()
					} else {
						state = stateGround
						beginEscape()
						escape(b)
					}
				case stateCharset:
					charsets[0] = string(char(b)) when intermediate == "("
					charsets[1] = string(char(b)) when intermediate == ")"
					state = stateGround
				case stateHash:
					fillWithE() when b == 0x38
					state = stateGround
				default:
					state = stateGround
			}
		}

		internal def beginEscape() {
			state = stateEscape
			params = []
			subparams = []
			paramText = ""
			private = ""
			intermediate = ""
			oscText = ""
		}

		internal def endString() {
			osc() when state == stateOsc || (state == stateEscapeString && oscText != "")
			state = stateGround
			oscText = ""
		}

		// A C0 control: the ones a terminal acts on.
		internal def control(b int) {
			switch b {
				case 0x07:
					bells++
				case 0x08:
					wrapPending = false
					cursor.column = (cursor.column - 1).max(0)
				case 0x09:
					tab()
				case 0x0a, 0x0b, 0x0c:
					lineFeed()
					cursor.column = 0 when newLineMode
				case 0x0d:
					wrapPending = false
					cursor.column = 0
				case 0x0e:
					charsetIn = 1
				case 0x0f:
					charsetIn = 0
				default:
			}
			generation++
		}

		// The byte after ESC.
		internal def escape(b int) {
			switch b {
				case 0x5b:
					state = stateCsi
					return
				case 0x5d:
					state = stateOsc
					return
				case 0x50, 0x5e, 0x5f, 0x58:
					state = stateString
					return
				case 0x28, 0x29:
					intermediate = string(char(b))
					state = stateCharset
					return
				case 0x23:
					state = stateHash
					return
				case 0x37:
					saveCursor()
				case 0x38:
					restoreCursor()
				case 0x44:
					lineFeed()
				case 0x45:
					lineFeed()
					cursor.column = 0
				case 0x48:
					tabs[cursor.column] = true
				case 0x4d:
					reverseLineFeed()
				case 0x63:
					reset()
				case 0x3d:
					applicationKeypad = true
				case 0x3e:
					applicationKeypad = false
				default:
			}
			state = stateGround
			generation++
		}

		// A byte of a CSI sequence: parameters, intermediates, then the
		// command.
		internal def csiByte(b int) {
			if b >= 0x30 && b <= 0x3f {
				if b == 0x3b {
					endParameter()
				} else if b == 0x3a {
					paramText += ":"
				} else if b >= 0x30 && b <= 0x39 {
					paramText += string(char(b))
				} else if params.len() == 0 && paramText == "" {
					private += string(char(b))
				} else {
					state = stateCsiIgnore
				}
				return
			}
			if b >= 0x20 && b <= 0x2f {
				intermediate += string(char(b))
				return
			}
			if b >= 0x40 && b <= 0x7e {
				endParameter() when paramText != "" || params.len() > 0 || true
				state = stateGround
				csi(b)
				generation++
				return
			}
			state = stateGround
		}

		// Closes the parameter being read: its number (0 when it has none)
		// and the sub-parameters after `:`.
		internal def endParameter() {
			let parts = paramText.split(":")
			let numbers int[] = []
			for let part in parts {
				numbers.push(part == "" ?? (0, part.toInt<int>()))
			}
			params.push(numbers[0])
			subparams.push(numbers.slice(1, numbers.len() - 1))
			paramText = ""
		}

		// param is the nth parameter (from 0), or `fallback` when it is
		// missing or 0.
		internal def param(n int, fallback int) int {
			return fallback when n >= params.len() || params[n] == 0
			return params[n]
		}

		// --- printing ---

		// print puts a character at the cursor and moves it on, wrapping at
		// the right edge when the program allows it.
		internal def print(point int) {
			if point >= 0x60 && point <= 0x7e && charsets[charsetIn] == "0" {
				let glyph = graphicOf(point)
				printText(glyph, displayWidth(glyph).max(1))
				return
			}
			let ch = char(point)
			let width = displayWidth(ch)
			if width == 0 && point >= 0x300 {
				// A combining character joins the cell before the cursor.
				let col = (cursor.column - (wrapPending ?? (0, 1))).max(0)
				let row = lines[cursor.row]
				col-- when col > 0 && row[col].width == 0
				row[col] = Cell{text: row[col].text + string(ch), width: row[col].width, look: row[col].look}
				dirty[cursor.row] = true
				generation++
				return
			}
			printText(string(ch), width.max(1))
		}

		internal def graphicOf(point int) string {
			let glyphs = decGraphics
			let i = point - 0x60
			let n = 0
			for let (_, c) in glyphs {
				return string(c) when n == i
				n++
			}
			return string(char(point))
		}

		internal def printText(glyph string, width int) {
			if wrapPending {
				wrapPending = false
				cursor.column = 0
				lineFeed()
			}
			if width == 2 && cursor.column == columns - 1 {
				// A wide character does not fit in the last column: the
				// column stays blank and the character wraps.
				if autoWrap {
					lines[cursor.row][cursor.column] = Cell{text: " ", width: 1, look: pen}
					cursor.column = 0
					lineFeed()
				} else {
					cursor.column = (columns - 2).max(0)
				}
			}
			let row = lines[cursor.row]
			if insertMode {
				let shift = width
				for let col = columns - 1; col >= cursor.column + shift; col-- {
					row[col] = row[col - shift]
				}
			}
			// Overwriting half of a wide character blanks the other half.
			clearWide(row, cursor.column)
			row[cursor.column] = Cell{text: glyph, width: width, look: penCopy()}
			if width == 2 {
				clearWide(row, cursor.column + 1)
				row[cursor.column + 1] = Cell{text: "", width: 0, look: penCopy()}
			}
			dirty[cursor.row] = true
			generation++
			let next = cursor.column + width
			if next >= columns {
				if autoWrap {
					cursor.column = columns - 1
					wrapPending = true
				} else {
					cursor.column = columns - 1
				}
				return
			}
			cursor.column = next
		}

		// clearWide blanks both halves of a wide character one of whose cells
		// is at col, so no half is left without the other.
		internal def clearWide(row Cell[], col int) {
			return when col < 0 || col >= columns
			row[col - 1] = Cell{text: " ", width: 1, look: row[col - 1].look} when row[col].width == 0 && col > 0
			row[col + 1] = Cell{text: " ", width: 1, look: row[col + 1].look} when row[col].width == 2 && col + 1 < columns
		}

		// --- cursor and scrolling ---

		internal def tab() {
			wrapPending = false
			let col = cursor.column + 1
			for col < columns - 1 && !tabs[col] {
				col++
			}
			cursor.column = col.min(columns - 1)
		}

		internal def backTab(count int) {
			wrapPending = false
			let col = cursor.column
			for let n = 0; n < count; n++ {
				col--
				for col > 0 && !tabs[col] {
					col--
				}
			}
			cursor.column = col.max(0)
		}

		// lineFeed moves the cursor down a line, scrolling the region when it
		// stands on its last line.
		internal def lineFeed() {
			wrapPending = false
			if cursor.row == bottom {
				scrollUp(1)
				return
			}
			cursor.row = (cursor.row + 1).min(rows - 1)
		}

		internal def reverseLineFeed() {
			wrapPending = false
			if cursor.row == top {
				scrollDown(1)
				return
			}
			cursor.row = (cursor.row - 1).max(0)
		}

		// scrollUp moves the region's lines up by count, the top ones leaving
		// (into the scrollback when the whole main screen scrolls) and blank
		// ones entering at the bottom.
		internal def scrollUp(count int) {
			let n = count.max(1).min(bottom - top + 1)
			for let k = 0; k < n; k++ {
				if top == 0 && bottom == rows - 1 && !alternate {
					scrollback.push(lines[0])
					scrollback.remove(0) when scrollback.len() > scrollbackLimit
				}
				for let row = top; row < bottom; row++ {
					lines[row] = lines[row + 1]
				}
				lines[bottom] = blankLine()
			}
			markRows(top, bottom)
		}

		// scrollDown moves the region's lines down by count, blank ones
		// entering at the top.
		internal def scrollDown(count int) {
			let n = count.max(1).min(bottom - top + 1)
			for let k = 0; k < n; k++ {
				for let row = bottom; row > top; row-- {
					lines[row] = lines[row - 1]
				}
				lines[top] = blankLine()
			}
			markRows(top, bottom)
		}

		internal def markRows(from int, to int) {
			for let row = from; row <= to; row++ {
				dirty[row] = true
			}
			generation++
		}

		// moveTo puts the cursor at a column and row (from 0), inside the
		// screen, and inside the scroll region when origin mode is on.
		internal def moveTo(column int, row int) {
			wrapPending = false
			let (lowest, highest) = originMode ?? ((top, bottom), (0, rows - 1))
			cursor.column = column.max(0).min(columns - 1)
			cursor.row = row.max(lowest).min(highest)
		}

		internal def moveBy(columns int, rows int) {
			wrapPending = false
			cursor.column = (cursor.column + columns).max(0).min(self.columns - 1)
			let (lowest, highest) = cursor.row >= top && cursor.row <= bottom ?? ((top, bottom), (0, self.rows - 1))
			cursor.row = (cursor.row + rows).max(lowest).min(highest)
		}

		// A struct is shared by reference: the pen and the cursor are copied
		// into what keeps them, or a later change would reach the keeper.
		internal def penCopy() Attributes {
			return Attributes{foreground: pen.foreground, background: pen.background, bold: pen.bold, faint: pen.faint, italic: pen.italic, underline: pen.underline, blink: pen.blink, inverse: pen.inverse, invisible: pen.invisible, strike: pen.strike}
		}

		internal def cursorCopy(from Cursor) Cursor {
			return Cursor{column: from.column, row: from.row}
		}

		internal def saveCursor() {
			savedCursor = cursorCopy(cursor)
			savedPen = penCopy()
			savedOrigin = originMode
			savedWrap = autoWrap
		}

		internal def restoreCursor() {
			cursor = cursorCopy(savedCursor)
			pen = savedPen
			savedPen = penCopy()
			originMode = savedOrigin
			autoWrap = savedWrap
			wrapPending = false
			cursor.column = cursor.column.min(columns - 1)
			cursor.row = cursor.row.min(rows - 1)
		}

		// --- CSI commands ---

		internal def csi(b int) {
			let command = string(char(b))
			if private == "?" {
				privateCsi(command)
				return
			}
			if private == ">" {
				// Secondary device attributes: a VT220 with firmware 0.
				pending.push(..."\u001b[>1;10;0c".bytes()) when command == "c"
				return
			}
			return unless private == ""
			if intermediate == "!" {
				softReset() when command == "p"
				return
			}
			if intermediate == " " {
				if command == "q" {
					let shape = param(0, 0)
					cursorShape = shape <= 2 ?? (CursorShape.Block, shape <= 4 ?? (CursorShape.Underline, CursorShape.Bar))
				}
				return
			}
			return unless intermediate == ""
			switch command {
				case "@":
					insertCells(param(0, 1))
				case "A":
					moveBy(0, -param(0, 1))
				case "B", "e":
					moveBy(0, param(0, 1))
				case "C", "a":
					moveBy(param(0, 1), 0)
				case "D":
					moveBy(-param(0, 1), 0)
				case "E":
					moveBy(0, param(0, 1))
					cursor.column = 0
				case "F":
					moveBy(0, -param(0, 1))
					cursor.column = 0
				case "G", "`":
					moveTo(param(0, 1) - 1, cursor.row)
				case "H", "f":
					moveTo(param(1, 1) - 1, (originMode ?? (top, 0)) + param(0, 1) - 1)
				case "I":
					for let n = 0; n < param(0, 1); n++ {
						tab()
					}
				case "J":
					eraseDisplay(params.len() == 0 ?? (0, params[0]))
				case "K":
					eraseLine(params.len() == 0 ?? (0, params[0]))
				case "L":
					insertLines(param(0, 1))
				case "M":
					deleteLines(param(0, 1))
				case "P":
					deleteCells(param(0, 1))
				case "S":
					scrollUp(param(0, 1))
				case "T":
					scrollDown(param(0, 1))
				case "X":
					eraseCells(param(0, 1))
				case "Z":
					backTab(param(0, 1))
				case "b":
					repeatLast(param(0, 1))
				case "c":
					// Primary device attributes: a VT220 with the features the
					// screen has.
					pending.push(..."\u001b[?62;1;2;6;9;15;22c".bytes())
				case "d":
					moveTo(cursor.column, (originMode ?? (top, 0)) + param(0, 1) - 1)
				case "g":
					if params.len() == 0 || params[0] == 0 {
						tabs[cursor.column] = false
					} else if params[0] == 3 {
						tabs = allColumns(false)
					}
				case "h":
					applyModes(true)
				case "l":
					applyModes(false)
				case "m":
					selectGraphics()
				case "n":
					if param(0, 0) == 5 {
						pending.push(..."\u001b[0n".bytes())
					} else if param(0, 0) == 6 {
						let row = cursor.row - (originMode ?? (top, 0)) + 1
						pending.push(..."\u001b[{row};{cursor.column + 1}R".bytes())
					}
				case "r":
					let first = param(0, 1) - 1
					let last = param(1, rows) - 1
					if first < last && last < rows {
						top = first
						bottom = last
						moveTo(0, originMode ?? (top, 0))
					}
				case "s":
					saveCursor()
				case "t":
					pending.push(..."\u001b[8;{rows};{columns}t".bytes()) when param(0, 0) == 18
				case "u":
					restoreCursor()
				default:
			}
		}

		// A `CSI ?` command: DEC private modes and the cursor save of 1048.
		internal def privateCsi(command string) {
			if command := "h" || "l" {
				let on = command == "h"
				for let mode in params {
					privateMode(mode, on)
				}
				return
			}
			if command := "J" || "K" {
				// Selective erase: no cell is protected here, so it erases as the
				// plain form does.
				eraseDisplay(params.len() == 0 ?? (0, params[0])) when command == "J"
				eraseLine(params.len() == 0 ?? (0, params[0])) when command == "K"
				return
			}
			if command == "n" && param(0, 0) == 6 {
				let row = cursor.row - (originMode ?? (top, 0)) + 1
				pending.push(..."\u001b[?{row};{cursor.column + 1}R".bytes())
			}
		}

		internal def privateMode(mode int, on bool) {
			switch mode {
				case 1:
					applicationCursorKeys = on
				case 5:
					reverseVideo = on
					markRows(0, rows - 1)
				case 6:
					originMode = on
					moveTo(0, on ?? (top, 0))
				case 7:
					autoWrap = on
					wrapPending = false
				case 9:
					mouse = on ?? (MouseReport.Press, MouseReport.None)
				case 25:
					cursorVisible = on
				case 47, 1047:
					switchScreen(on, false)
				case 1048:
					if on {
						saveCursor()
					} else {
						restoreCursor()
					}
				case 1049:
					switchScreen(on, true)
				case 1000:
					mouse = on ?? (MouseReport.Normal, MouseReport.None)
				case 1002:
					mouse = on ?? (MouseReport.Button, MouseReport.None)
				case 1003:
					mouse = on ?? (MouseReport.Any, MouseReport.None)
				case 1004:
					focusReports = on
				case 1006:
					mouseSgr = on
				case 2004:
					bracketedPaste = on
				default:
			}
		}

		// Plain SM/RM: insert mode and new line mode.
		internal def applyModes(on bool) {
			for let mode in params {
				insertMode = on when mode == 4
				newLineMode = on when mode == 20
			}
		}

		// switchScreen shows the alternate screen (on) or the main one; with
		// `cursor` the cursor is saved before and restored after, and the
		// alternate screen starts clear.
		internal def switchScreen(on bool, keepCursor bool) {
			return when on == alternate
			if on {
				saveCursor() when keepCursor
				otherSaved = cursorCopy(cursor)
			}
			let shown = lines
			lines = other
			other = shown
			alternate = on
			if on {
				lines = blankLines(rows) when keepCursor
			} else if keepCursor {
				restoreCursor()
			}
			wrapPending = false
			top = 0
			bottom = rows - 1
			dirty = allRows(true)
			generation++
		}

		// softReset is DECSTR: modes and the pen to their defaults, the
		// screen kept.
		internal def softReset() {
			pen = Attributes{}
			savedPen = Attributes{}
			autoWrap = true
			wrapPending = false
			originMode = false
			insertMode = false
			applicationCursorKeys = false
			applicationKeypad = false
			cursorVisible = true
			top = 0
			bottom = rows - 1
			charsets = ["B", "B"]
			charsetIn = 0
		}

		// --- erasing and editing ---

		internal def eraseDisplay(kind int) {
			wrapPending = false
			switch kind {
				case 0:
					eraseLine(0)
					for let row = cursor.row + 1; row < rows; row++ {
						lines[row] = blankLine()
					}
					markRows(cursor.row, rows - 1)
				case 1:
					eraseLine(1)
					for let row = 0; row < cursor.row; row++ {
						lines[row] = blankLine()
					}
					markRows(0, cursor.row)
				case 2:
					for let row = 0; row < rows; row++ {
						lines[row] = blankLine()
					}
					markRows(0, rows - 1)
				case 3:
					scrollback = []
					generation++
				default:
			}
		}

		internal def eraseLine(kind int) {
			wrapPending = false
			let row = lines[cursor.row]
			let (from, to) = kind == 0 ?? ((cursor.column, columns), kind == 1 ?? ((0, cursor.column + 1), (0, columns)))
			clearWide(row, from)
			clearWide(row, to - 1)
			for let col = from; col < to; col++ {
				row[col] = Cell{text: " ", width: 1, look: penCopy()}
			}
			dirty[cursor.row] = true
			generation++
		}

		internal def eraseCells(count int) {
			wrapPending = false
			let row = lines[cursor.row]
			let to = (cursor.column + count).min(columns)
			clearWide(row, cursor.column)
			clearWide(row, to - 1)
			for let col = cursor.column; col < to; col++ {
				row[col] = Cell{text: " ", width: 1, look: penCopy()}
			}
			dirty[cursor.row] = true
			generation++
		}

		internal def insertCells(count int) {
			wrapPending = false
			let row = lines[cursor.row]
			let n = count.min(columns - cursor.column)
			for let col = columns - 1; col >= cursor.column + n; col-- {
				row[col] = row[col - n]
			}
			for let col = cursor.column; col < cursor.column + n; col++ {
				row[col] = Cell{text: " ", width: 1, look: penCopy()}
			}
			dirty[cursor.row] = true
			generation++
		}

		internal def deleteCells(count int) {
			wrapPending = false
			let row = lines[cursor.row]
			let n = count.min(columns - cursor.column)
			for let col = cursor.column; col < columns - n; col++ {
				row[col] = row[col + n]
			}
			for let col = columns - n; col < columns; col++ {
				row[col] = Cell{text: " ", width: 1, look: penCopy()}
			}
			dirty[cursor.row] = true
			generation++
		}

		internal def insertLines(count int) {
			wrapPending = false
			return when cursor.row < top || cursor.row > bottom
			let n = count.min(bottom - cursor.row + 1)
			for let row = bottom; row >= cursor.row + n; row-- {
				lines[row] = lines[row - n]
			}
			for let row = cursor.row; row < cursor.row + n; row++ {
				lines[row] = blankLine()
			}
			cursor.column = 0
			markRows(cursor.row, bottom)
		}

		internal def deleteLines(count int) {
			wrapPending = false
			return when cursor.row < top || cursor.row > bottom
			let n = count.min(bottom - cursor.row + 1)
			for let row = cursor.row; row <= bottom - n; row++ {
				lines[row] = lines[row + n]
			}
			for let row = bottom - n + 1; row <= bottom; row++ {
				lines[row] = blankLine()
			}
			cursor.column = 0
			markRows(cursor.row, bottom)
		}

		// repeatLast prints the character before the cursor again.
		internal def repeatLast(count int) {
			let col = (cursor.column - (wrapPending ?? (0, 1))).max(0)
			let cell = lines[cursor.row][col]
			return when cell.width == 0 || cell.text == ""
			for let n = 0; n < count; n++ {
				printText(cell.text, cell.width)
			}
		}

		// fillWithE is DECALN, the alignment pattern.
		internal def fillWithE() {
			for let row = 0; row < rows; row++ {
				let cells Cell[] = []
				for let col = 0; col < columns; col++ {
					cells.push(Cell{text: "E", width: 1, look: Attributes{}})
				}
				lines[row] = cells
			}
			cursor = Cursor{}
			markRows(0, rows - 1)
		}

		// --- SGR ---

		internal def selectGraphics() {
			if params.len() == 0 {
				pen = Attributes{}
				return
			}
			let i = 0
			for i < params.len() {
				let p = params[i]
				let subs = subparams[i]
				switch p {
					case 0:
						pen = Attributes{}
					case 1:
						pen.bold = true
					case 2:
						pen.faint = true
					case 3:
						pen.italic = true
					case 4:
						pen.underline = subs.len() > 0 ?? (underlineOf(subs[0]), Underline.Single)
					case 5, 6:
						pen.blink = true
					case 7:
						pen.inverse = true
					case 8:
						pen.invisible = true
					case 9:
						pen.strike = true
					case 21:
						pen.underline = Underline.Double
					case 22:
						pen.bold = false
						pen.faint = false
					case 23:
						pen.italic = false
					case 24:
						pen.underline = Underline.None
					case 25:
						pen.blink = false
					case 27:
						pen.inverse = false
					case 28:
						pen.invisible = false
					case 29:
						pen.strike = false
					case 38, 48, 58:
						let (color, used) = extendedColor(i, subs)
						if p == 38 {
							pen.foreground = color
						} else if p == 48 {
							pen.background = color
						}
						i += used
					case 39:
						pen.foreground = CellColor{}
					case 49:
						pen.background = CellColor{}
					case 59:
					default:
						if p >= 30 && p <= 37 {
							pen.foreground = CellColor{mode: ColorMode.Indexed, index: p - 30}
						} else if p >= 40 && p <= 47 {
							pen.background = CellColor{mode: ColorMode.Indexed, index: p - 40}
						} else if p >= 90 && p <= 97 {
							pen.foreground = CellColor{mode: ColorMode.Indexed, index: p - 90 + 8}
						} else if p >= 100 && p <= 107 {
							pen.background = CellColor{mode: ColorMode.Indexed, index: p - 100 + 8}
						}
				}
				i++
			}
		}

		internal def underlineOf(kind int) Underline {
			switch kind {
				case 0:
					return Underline.None
				case 2:
					return Underline.Double
				case 3:
					return Underline.Curly
				case 4:
					return Underline.Dotted
				case 5:
					return Underline.Dashed
				default:
					return Underline.Single
			}
		}

		// extendedColor reads the colour after a 38, 48 or 58 at parameter i:
		// `5;n` or `5:n` for an indexed one, `2;r;g;b` or `2:r:g:b` (with an
		// optional colour space in the colon form) for components. Returns
		// the colour and how many further parameters it took.
		internal def extendedColor(i int, subs int[]) (CellColor, int) {
			if subs.len() > 0 {
				return (CellColor{mode: ColorMode.Indexed, index: subs[1].max(0).min(255)}, 0) when subs[0] == 5 && subs.len() >= 2
				if subs[0] == 2 && subs.len() >= 4 {
					let skip = subs.len() >= 5 ?? (1, 0)
					return (CellColor{mode: ColorMode.Rgb, red: subs[1 + skip].max(0).min(255), green: subs[2 + skip].max(0).min(255), blue: subs[3 + skip].max(0).min(255)}, 0)
				}
				return (CellColor{}, 0)
			}
			return (CellColor{}, 0) when i + 1 >= params.len()
			return (CellColor{mode: ColorMode.Indexed, index: params[i + 2].max(0).min(255)}, 2) when params[i + 1] == 5 && i + 2 < params.len()
			return (CellColor{mode: ColorMode.Rgb, red: params[i + 2].max(0).min(255), green: params[i + 3].max(0).min(255), blue: params[i + 4].max(0).min(255)}, 4) when params[i + 1] == 2 && i + 4 < params.len()
			return (CellColor{}, params.len() - i - 1)
		}

		// --- OSC ---

		internal def osc() {
			let semicolon = oscText.indexOf(";", 0)
			let code = semicolon < 0 ?? (oscText, oscText.slice(0, semicolon))
			let value = semicolon < 0 ?? ("", oscText.slice(semicolon + 1, oscText.len()))
			switch code {
				case "0", "2":
					title = value
					generation++
				case "7":
					workingDirectory = value
				default:
			}
		}

		// --- lines ---

		internal def blankLine() Cell[] {
			let cells Cell[] = []
			for let col = 0; col < columns; col++ {
				cells.push(Cell{text: " ", width: 1, look: Attributes{background: pen.background}})
			}
			return cells
		}

		internal def blankLines(count int) Cell[][] {
			let out Cell[][] = []
			for let row = 0; row < count; row++ {
				out.push(blankLine())
			}
			return out
		}

		internal def allRows(value bool) bool[] {
			let out bool[] = []
			for let row = 0; row < rows; row++ {
				out.push(value)
			}
			return out
		}

		internal def allColumns(value bool) bool[] {
			let out bool[] = []
			for let col = 0; col < columns; col++ {
				out.push(value)
			}
			return out
		}

		internal def defaultTabs() bool[] {
			let out bool[] = []
			for let col = 0; col < columns; col++ {
				out.push(col % 8 == 0)
			}
			return out
		}

		// resized cuts or pads every line to `wide` columns and the list to
		// `high` lines: `above` lines leave at the top (into the scrollback
		// when `keep`), the rest at the bottom.
		internal def resized(from Cell[][], wide int, high int, keep bool, above int) Cell[][] {
			let out Cell[][] = []
			for let row in from {
				let cells Cell[] = row.slice(0, row.len().min(wide))
				for cells.len() < wide {
					cells.push(Cell{text: " ", width: 1, look: Attributes{}})
				}
				clearWide(cells, wide - 1) when cells.len() == wide && wide > 0 && cells[wide - 1].width == 2
				out.push(cells)
			}
			for let n = 0; n < above && out.len() > high; n++ {
				scrollback.push(out[0]) when keep
				out.remove(0)
			}
			for out.len() > high {
				out.pop()
			}
			for out.len() < high {
				let cells Cell[] = []
				for let col = 0; col < wide; col++ {
					cells.push(Cell{text: " ", width: 1, look: Attributes{}})
				}
				out.push(cells)
			}
			return out
		}
	}

	// sequenceLength is how many bytes a UTF-8 sequence with this lead byte
	// has; 1 for a byte that leads none.
	internal def sequenceLength(lead int) int {
		return 2 when lead >= 0xc0 && lead < 0xe0
		return 3 when lead >= 0xe0 && lead < 0xf0
		return 4 when lead >= 0xf0 && lead < 0xf8
		return 1
	}

	// decodeUTF8 is the code point of one complete sequence, U+FFFD for an
	// invalid one.
	internal def decodeUTF8(seq byte[]) int {
		let lead = int(seq[0])
		let n = sequenceLength(lead)
		return 0xfffd when n == 1 || seq.len() != n
		let point = n == 2 ?? (lead & 0x1f, n == 3 ?? (lead & 0x0f, lead & 0x07))
		for let i = 1; i < n; i++ {
			let b = int(seq[i])
			return 0xfffd when b < 0x80 || b >= 0xc0
			point = (point << 6) | (b & 0x3f)
		}
		return 0xfffd when point > 0x10ffff || (point >= 0xd800 && point <= 0xdfff)
		return 0xfffd when (n == 2 && point < 0x80) || (n == 3 && point < 0x800) || (n == 4 && point < 0x10000)
		return point
	}

	// textOf is a line's text without the blanks at its end.
	internal def textOf(cells Cell[]) string {
		let out = ""
		let end = cells.len()
		for end > 0 && cells[end - 1].width == 1 && cells[end - 1].text == " " {
			end--
		}
		for let col = 0; col < end; col++ {
			out += cells[col].text
		}
		return out
	}
}
