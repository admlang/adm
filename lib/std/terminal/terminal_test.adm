partial module std.terminal {
	use std.testing

	check "terminal screen" {
		internal def fed(text string, columns int = 20, rows int = 5) Screen {
			let screen = new Screen(columns, rows)
			screen.feed(text)
			return screen
		}

		// Text prints at the cursor, control characters move it, and a line
		// past the right edge wraps on the next character, not at once.
		@test()
		def printsAndWraps() {
			let screen = fed("hello\r\nworld")
			assert screen.rowText(0) == "hello" && screen.rowText(1) == "world"
			assert screen.cursor.column == 5 && screen.cursor.row == 1
			let edge = fed("abcdefghij", 10, 3)
			assert edge.cursor.column == 9 && edge.cursor.row == 0 && edge.rowText(0) == "abcdefghij"
			edge.feed("k")
			assert edge.rowText(1) == "k" && edge.cursor.column == 1 && edge.cursor.row == 1
			let noWrap = fed("\u001b[?7labcdefghijkl", 10, 3)
			assert noWrap.rowText(0) == "abcdefghil" && noWrap.cursor.column == 9
			let tabs = fed("a\tb\tc")
			assert tabs.rowText(0) == "a       b       c"
			let back = fed("abc\bX")
			assert back.rowText(0) == "abX"
		}

		// Attributes come from SGR in every form a program writes them.
		@test()
		def readsGraphicAttributes() {
			let screen = fed("\u001b[1;3;4;31;44mA\u001b[0mB\u001b[38;5;208mC\u001b[48;2;1;2;3mD\u001b[38:2::9:8:7mE\u001b[4:3mF\u001b[22;24;39;49mG\u001b[91mH")
			let a = screen.line(0)[0].look
			assert a.bold && a.italic && a.underline == Underline.Single
			assert a.foreground.mode == ColorMode.Indexed && a.foreground.index == 1
			assert a.background.mode == ColorMode.Indexed && a.background.index == 4
			let b = screen.line(0)[1].look
			assert !b.bold && b.foreground.mode == ColorMode.Default && b.background.mode == ColorMode.Default
			let c = screen.line(0)[2].look
			assert c.foreground.mode == ColorMode.Indexed && c.foreground.index == 208
			let d = screen.line(0)[3].look
			assert d.background.mode == ColorMode.Rgb && d.background.red == 1 && d.background.green == 2 && d.background.blue == 3
			let e = screen.line(0)[4].look
			assert e.foreground.mode == ColorMode.Rgb && e.foreground.red == 9 && e.foreground.blue == 7
			assert screen.line(0)[5].look.underline == Underline.Curly
			let g = screen.line(0)[6].look
			assert !g.bold && g.underline == Underline.None && g.foreground.mode == ColorMode.Default && g.background.mode == ColorMode.Default
			let h = screen.line(0)[7].look
			assert h.foreground.mode == ColorMode.Indexed && h.foreground.index == 9
			let (r, g2, b2) = indexedRgb(208)
			assert r == 255 && g2 == 135 && b2 == 0
			let (grey, _, _) = indexedRgb(232)
			assert grey == 8
		}

		// Cursor movement, absolute and relative, stays inside the screen.
		@test()
		def movesTheCursor() {
			let screen = fed("\u001b[3;4HX")
			assert screen.line(2)[3].text == "X"
			screen.feed("\u001b[2A\u001b[1DY")
			assert screen.line(0)[3].text == "Y"
			screen.feed("\u001b[99;99H")
			assert screen.cursor.column == 19 && screen.cursor.row == 4
			screen.feed("\u001b[H\u001b[2CZ\u001b[5d")
			assert screen.line(0)[2].text == "Z" && screen.cursor.row == 4
			screen.feed("\u001b[1;1H\u001b[s\u001b[3;3H\u001b[uW")
			assert screen.line(0)[0].text == "W"
			screen.feed("\u001b7\u001b[4;4H\u001b8V")
			assert screen.line(0)[1].text == "V"
		}

		// Erasing: the display and the line, each in its three forms, and
		// cells by count; erased cells take the pen's background.
		@test()
		def erases() {
			let screen = fed("aaaa\r\nbbbb\r\ncccc\r\ndddd\r\neeee", 4, 5)
			screen.feed("\u001b[3;3H\u001b[0J")
			assert screen.rowText(2) == "cc" && screen.rowText(3) == "" && screen.rowText(1) == "bbbb"
			screen.feed("\u001b[2;2H\u001b[1J")
			assert screen.rowText(0) == "" && screen.rowText(1) == "  bb"
			let line = fed("abcdef", 6, 2)
			line.feed("\u001b[1;3H\u001b[K")
			assert line.rowText(0) == "ab"
			line.feed("\u001b[1;1Hxyzuvw\u001b[1;2H\u001b[1K")
			assert line.rowText(0) == "  zuvw"
			line.feed("\u001b[2K")
			assert line.rowText(0) == ""
			let cells = fed("abcdef", 6, 2)
			cells.feed("\u001b[1;2H\u001b[42m\u001b[2X")
			assert cells.rowText(0) == "a  def" && cells.line(0)[1].look.background.index == 2
			let all = fed("one\r\ntwo", 5, 2)
			all.feed("\u001b[2J")
			assert all.text() == "\n"
		}

		// Inserting and deleting lines and cells shift what follows.
		@test()
		def insertsAndDeletes() {
			let screen = fed("abcdef", 8, 3)
			screen.feed("\u001b[1;3H\u001b[2@")
			assert screen.rowText(0) == "ab  cdef"
			screen.feed("\u001b[3P")
			assert screen.rowText(0) == "abdef"
			let lines = fed("one\r\ntwo\r\nthree", 6, 4)
			lines.feed("\u001b[2;1H\u001b[L")
			assert lines.rowText(1) == "" && lines.rowText(2) == "two" && lines.rowText(3) == "three"
			lines.feed("\u001b[1;1H\u001b[2M")
			assert lines.rowText(0) == "two" && lines.rowText(1) == "three" && lines.rowText(2) == ""
			let insert = fed("\u001b[4habXc", 6, 2)
			assert insert.rowText(0) == "abXc"
			insert.feed("\u001b[1;3HY")
			assert insert.rowText(0) == "abYXc"
			let repeat = fed("x\u001b[3b", 8, 2)
			assert repeat.rowText(0) == "xxxx"
		}

		// A scroll region scrolls alone; only the whole main screen feeds the
		// scrollback, and the alternate screen never does.
		@test()
		def scrollsRegionsAndKeepsScrollback() {
			let screen = fed("1\r\n2\r\n3\r\n4\r\n5", 4, 5)
			screen.feed("\u001b[2;4r\u001b[4;1H\r\n")
			assert screen.rowText(0) == "1" && screen.rowText(1) == "3" && screen.rowText(2) == "4" && screen.rowText(3) == "" && screen.rowText(4) == "5"
			assert screen.scrollbackLines() == 0
			screen.feed("\u001b[2;1H\u001bM")
			assert screen.rowText(1) == "" && screen.rowText(2) == "3" && screen.rowText(4) == "5"
			screen.feed("\u001b[r\u001b[5;1H\r\nnew")
			assert screen.scrollbackLines() == 1 && screen.rowText(4) == "new"
			let back = screen.line(0, 1)
			assert back[0].text == "1"
			screen.feed("\u001b[2S")
			assert screen.scrollbackLines() == 3
			screen.feed("\u001b[3J")
			assert screen.scrollbackLines() == 0
			let small = new Screen(4, 2)
			small.scrollbackLimit = 2
			small.feed("a\r\nb\r\nc\r\nd\r\ne")
			assert small.scrollbackLines() == 2 && small.line(0, 2)[0].text == "b"
		}

		// The alternate screen starts clear, keeps the main screen aside, and
		// 1049 brings the cursor back where it was.
		@test()
		def switchesScreens() {
			let screen = fed("main text\u001b[2;3H", 12, 3)
			screen.feed("\u001b[?1049h")
			assert screen.alternate && screen.text() == "\n\n"
			screen.feed("\u001b[Hfull")
			assert screen.rowText(0) == "full"
			screen.feed("\r\n\r\n\r\n\r\n")
			assert screen.scrollbackLines() == 0
			screen.feed("\u001b[?1049l")
			assert !screen.alternate && screen.rowText(0) == "main text" && screen.cursor.row == 1 && screen.cursor.column == 2
			screen.feed("\u001b[?47h\u001b[?47l")
			assert screen.rowText(0) == "main text"
		}

		// Wide characters take two cells, do not split at the right edge,
		// and combining marks join the cell before them.
		@test()
		def placesWideAndCombiningCharacters() {
			let screen = fed("日本", 5, 2)
			let row = screen.line(0)
			assert row[0].text == "日" && row[0].width == 2 && row[1].width == 0 && row[2].text == "本"
			assert screen.cursor.column == 4
			screen.feed("語")
			assert screen.line(0)[4].text == " " && screen.line(1)[0].text == "語"
			let mark = fed("éx", 5, 1)
			assert mark.line(0)[0].text == "é" && mark.line(0)[1].text == "x"
			let over = fed("日本", 5, 1)
			over.feed("\u001b[1;2HX")
			assert over.line(0)[0].text == " " && over.line(0)[1].text == "X" && over.line(0)[2].text == "本"
			assert over.rowText(0) == " X本"
		}

		// A sequence or a character cut between two feeds reads as one.
		@test()
		def carriesCutSequencesOver() {
			let screen = new Screen(10, 2)
			let bytes = "\u001b[1;31mé日".bytes()
			for let i = 0; i < bytes.len(); i++ {
				screen.feed(byte[bytes[i]])
			}
			assert screen.rowText(0) == "é日"
			assert screen.line(0)[0].look.bold && screen.line(0)[0].look.foreground.index == 1
			let broken = new Screen(10, 1)
			broken.feed(byte[0xe6, 0x97])
			broken.feed(byte[0x41])
			assert broken.rowText(0) == "�A"
			let plain = new Screen(10, 1)
			plain.feed(byte[0xff, 0x42])
			assert plain.rowText(0) == "�B"
		}

		// What the program asks back waits in responses.
		@test()
		def answersQueries() {
			let screen = fed("\u001b[3;5H\u001b[6n\u001b[5n\u001b[c\u001b[18t\u001b[>c", 40, 10)
			let answer = string(screen.responses())
			assert answer == "\u001b[3;5R\u001b[0n\u001b[?62;1;2;6;9;15;22c\u001b[8;10;40t\u001b[>1;10;0c"
			assert screen.responses().len() == 0
			screen.feed("\u001b[2;5r\u001b[?6h\u001b[1;1H\u001b[?6n")
			assert string(screen.responses()) == "\u001b[?1;1R" && screen.cursor.row == 1
		}

		// Modes a program sets, titles it gives and the bell it rings are
		// kept for the drawing side.
		@test()
		def keepsModesTitlesAndBells() {
			let screen = fed("\u001b]0;Build\u0007\u001b]2;Shell\u001b\\\u001b]7;file:///tmp\u0007\u0007\u0007")
			assert screen.title == "Shell" && screen.workingDirectory == "file:///tmp" && screen.bells == 2
			screen.feed("\u001b[?1h\u001b[?2004h\u001b[?1002h\u001b[?1006h\u001b[?25l\u001b[?1004h\u001b=\u001b[3 q")
			assert screen.applicationCursorKeys && screen.bracketedPaste && screen.mouse == MouseReport.Button && screen.mouseSgr && !screen.cursorVisible && screen.focusReports && screen.applicationKeypad
			assert screen.cursorShape == CursorShape.Underline
			screen.feed("\u001b[?1l\u001b[?1002l\u001b[?25h\u001b>")
			assert !screen.applicationCursorKeys && screen.mouse == MouseReport.None && screen.cursorVisible && !screen.applicationKeypad
			screen.feed("\u001b[?1003h")
			assert screen.mouse == MouseReport.Any
			let unknown = fed("\u001b[?9999h\u001b[99z\u001bPq...\u001b\\\u001b_apc\u001b\\after")
			assert unknown.rowText(0) == "after"
		}

		// DEC special graphics draw boxes; an alignment pattern fills the
		// screen; a soft reset leaves text alone, a hard one clears it.
		@test()
		def drawsGraphicsAndResets() {
			let screen = fed("\u001b(0lqk\u001b(Bx", 8, 2)
			assert screen.rowText(0) == "┌─┐x"
			let shifted = fed("\u001b)0\u000eq\u000fq", 8, 2)
			assert shifted.rowText(0) == "─q"
			let pattern = fed("\u001b#8", 3, 2)
			assert pattern.text() == "EEE\nEEE"
			let soft = fed("\u001b[1;31mtext\u001b[?6h\u001b[!p", 8, 2)
			assert soft.rowText(0) == "text"
			soft.feed("x")
			assert !soft.line(0)[4].look.bold && soft.line(0)[4].look.foreground.mode == ColorMode.Default
			soft.feed("\u001bc")
			assert soft.text() == "\n" && soft.cursor.column == 0 && soft.cursor.row == 0
			let hard = fed("\u001b[?1049h\u001b[?2004hkept", 8, 2)
			hard.reset()
			assert !hard.alternate && !hard.bracketedPaste && hard.text() == "\n" && hard.generation > 0
		}

		// Resizing keeps the text, moves lines above the cursor into the
		// scrollback when the screen gets shorter, and pads when it grows.
		@test()
		def resizes() {
			let screen = fed("one\r\ntwo\r\nthree\r\nfour", 8, 4)
			screen.resize(4, 2)
			assert screen.columns == 4 && screen.rows == 2
			assert screen.rowText(0) == "thre" && screen.rowText(1) == "four" && screen.scrollbackLines() == 2
			assert screen.cursor.row == 1 && screen.cursor.column == 3
			screen.resize(6, 4)
			assert screen.rowText(3) == "" && screen.line(0).len() == 6 && screen.rowText(0) == "thre"
			let dirty = screen.takeDirty()
			assert dirty.len() == 4 && dirty[0] && dirty[3]
			screen.feed("\u001b[1;1Hz")
			let again = screen.takeDirty()
			assert again[0] && !again[1]
		}

		// A selection reads the text between two cells, across the
		// scrollback, without the blanks at the ends of lines.
		@test()
		def readsSelections() {
			let screen = fed("first line\r\nsecond\r\nthird", 12, 2)
			assert screen.scrollbackLines() == 1
			assert screen.selection(1, 6, 0, 3, 2) == "line\nsecond\nthi"
			assert screen.selection(0, 2, 1, 0, 0) == "second\nth"
			assert screen.selection(0, 0, 0, 3, 0) == "sec"
		}

		// Changes count up the generation a drawing side watches.
		@test()
		def countsChanges() {
			let screen = new Screen(4, 2)
			let start = screen.generation
			screen.feed("a")
			assert screen.generation > start
			let after = screen.generation
			screen.feed("\u001b[0m")
			assert screen.generation > after
		}
	}
}
