// Assertion helpers for `check` suites.

partial module std.testing {
	use std.reflection::(CheckMetaContext, FunctionMetaContext)

	// beforeAll, written as a statement of a check suite's body, makes handler
	// run once before the suite's first test or benchmark that runs, those of
	// nested suites included. handler is a function without parameters that
	// returns nothing or `!none`.
	//
	// A handler that fails (an error, a failed assert) fails the test about to
	// run, and the suite's other tests are reported failed without running.
	// A call anywhere else than a suite's body does nothing.
	def beforeAll(handler any) {}

	// beforeEach makes handler run before each test and benchmark of the suite,
	// nested suites included: an outer suite's handlers first, each suite's in
	// the order written. A handler that fails fails the test, which then does
	// not run. See beforeAll for where the call goes and what handler is.
	def beforeEach(handler any) {}

	// afterAll makes handler run once after the suite's last test or benchmark,
	// whether or not they passed; a suite none of whose tests ran is left
	// alone. Handlers run last written first. A handler that fails fails the
	// last test. See beforeAll for where the call goes and what handler is.
	def afterAll(handler any) {}

	// afterEach makes handler run after each test and benchmark of the suite,
	// passed or failed: an inner suite's handlers first, each suite's last
	// written first. A handler that fails fails the test. See beforeAll for
	// where the call goes and what handler is.
	def afterEach(handler any) {}

	// Fails with the caller's message when it gave one, and a described default
	// otherwise. Every helper below reports through this so a bare assertion
	// still says what it expected.
	internal def report(message string, fallback string) !none {
		fail message when message != ""
		fail fallback
	}

	// Fails unless the two values are equal.
	def expectEqual(expected any, actual any, message string = "") !none {
		return none when expected == actual
		return report(message, "expected {expected}, got {actual}")
	}

	// Fails when the two values are equal.
	def expectNotEqual(expected any, actual any, message string = "") !none {
		return none when expected != actual
		return report(message, "expected a value other than {expected}")
	}

	// Fails unless the condition holds.
	def expectTrue(actual bool, message string = "") !none {
		return none when actual
		return report(message, "expected true, got false")
	}

	// Fails when the condition holds.
	def expectFalse(actual bool, message string = "") !none {
		return none unless actual
		return report(message, "expected false, got true")
	}

	// Fails unless the optional is empty.
	//
	// Generic rather than taking `any` so the optional survives to the check:
	// boxing a `?T` into `any` loses the wrapper, and `is none` against the box
	// answers about the box rather than the value inside it.
	def expectNone<T>(actual ?T, message string = "") !none {
		return none when actual is none
		return report(message, "expected none, got {actual}")
	}

	// Fails when the optional is empty.
	def expectSome<T>(actual ?T, message string = "") !none {
		return none unless actual is none
		return report(message, "expected a value, got none")
	}

	// Fails unless the errorable carries an error.
	//
	// Generic for the same reason as `expectNone`: a `!T` boxed into `any` no
	// longer answers `is error`.
	def expectError<T>(actual !T, message string = "") !none {
		return none when actual is error
		return report(message, "expected an error, got {actual}")
	}

	// Fails when the errorable carries an error, reporting the error itself so a
	// failing test says what went wrong rather than only that something did.
	def expectOk<T>(actual !T, message string = "") !none {
		return none unless actual is error
		return report(message, "expected success, got error: {actual}")
	}

	// Fails unless `actual` equals `expected`. Argument order mirrors the way
	// assertions usually read aloud; `expectEqual` takes them the other way.
	def expect(actual any, expected any, message string = "") !none {
		return none when actual == expected
		return report(message, "expected {expected}, got {actual}")
	}

	// @test, @benchmark, @fuzz, etc. will be implemented as annotations in the stdlib runtime.
	meta def test(ctx FunctionMetaContext) {
		ctx.invoke()
	}

	// Functions annotated with example will be skipped and are only used for generating documentation
	meta def example(ctx FunctionMetaContext) {
		ctx.skip()
	}

	// benchmark marks a check function as a benchmark, run for its timing rather
	// than for its assertions.
	meta def benchmark(ctx FunctionMetaContext) {
		ctx.invoke()
	}

	// fuzz marks a check function as a fuzz target: the runner supplies its
	// parameters (`byte[]`, `string`, `bool`, `char`, `duration`, integers,
	// `float32`, `float64`). `adm test` runs it on the empty input and on each
	// file of `testdata/fuzz/<target>/` beside the source; `adm test --fuzz`
	// generates inputs and writes one that fails to that folder.
	meta def fuzz(ctx FunctionMetaContext) {
		ctx.invoke()
	}

	// timeout bounds how long a check function may run; the runner fails it once
	// the limit passes.
	meta def timeout(target FunctionMetaContext, limit duration) {
		target.invoke()
	}

	// On a check suite, timeout bounds how long its tests may take together,
	// counted from the first one to start. Once the limit passes the runner
	// fails the test that is running and every test of the suite still to run.
	meta def timeout(target CheckMetaContext, limit duration) {}

	// parallel lets a test run at the same time as the other `@parallel()` tests
	// of its suite, each on its own task, once the suite's other tests and
	// nested suites are done. They share one time limit, the longest of theirs,
	// and what they print is not kept apart. It has no effect on a benchmark
	// or a fuzz target.
	meta def parallel(target FunctionMetaContext) {
		target.invoke()
	}

	// skip leaves a check function out of the run and reports it as skipped, with
	// the reason when one is given.
	meta def skip(target FunctionMetaContext, reason string = "") {
		target.skip()
	}

	// On a check suite, skip leaves out every test and benchmark of the suite,
	// nested suites included.
	meta def skip(target CheckMetaContext, reason string = "") {}

	// golden compares what a test returns, a `string` or a `byte[]` (errorable
	// or not), with the bytes of file and fails the test where they differ.
	// file is a string literal; a relative path starts at the folder of the
	// test's source file. `adm test --update-golden` writes the file from what
	// the test returns.
	meta def golden(target FunctionMetaContext, file string) {
		target.invoke()
	}

	// only restricts a run to the check functions carrying it; the rest of the
	// suite is skipped.
	meta def only(target FunctionMetaContext) {
		target.invoke()
	}

	// On a check suite, only restricts a run to the suite's tests, nested suites
	// included.
	meta def only(target CheckMetaContext) {}
}
