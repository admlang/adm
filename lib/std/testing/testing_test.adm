partial module std.testing {
	check "assertions" {
		// Each helper is checked in both directions: that it passes when it
		// should, and that it actually fails when it should. The failing half
		// matters most -- these were stubs whose bodies were `return none`, so a
		// test written against them passed no matter what the code did.

		@test()
		def equality() !none {
			try expectEqual(1, 1)
			try expectEqual("a", "a")
			assert expectEqual(1, 2) is error // unequal values must fail
			assert expectEqual("a", "b") is error

			try expectNotEqual(1, 2)
			assert expectNotEqual(1, 1) is error // equal values must fail expectNotEqual

			try expect(1, 1)
			assert expect(1, 2) is error
		}

		@test()
		def booleans() !none {
			try expectTrue(true)
			assert expectTrue(false) is error // false must fail expectTrue

			try expectFalse(false)
			assert expectFalse(true) is error // true must fail expectFalse
		}

		@test()
		def optionals() !none {
			let missing ?int = none
			let present ?int = 5

			try expectNone(missing)
			assert expectNone(present) is error // a present value must fail expectNone

			try expectSome(present)
			assert expectSome(missing) is error // none must fail expectSome
		}

		@test()
		def errorables() !none {
			try expectError(failing())
			assert expectError(succeeding()) is error // success must fail expectError

			try expectOk(succeeding())
			assert expectOk(failing()) is error // an error must fail expectOk
		}

		// The caller's message is used when given, so a failure says what was
		// being checked rather than only that a comparison went wrong.
		@test()
		def carriesTheCallersMessage() !none {
			let e = expectEqual(1, 2, "widths must match")
			if e is error {
				assert e.message == "widths must match"
				return none
			}
			fail "expected the comparison to fail"
		}
	}

	// The failing side (a test or suite that runs out of time) is covered by the
	// runner's own test, internal/runtime/c/tests/test_timeout_test.c: it cannot
	// be shown in a suite that has to pass.
	@timeout(1min)
	check "time limits" {
		@timeout(30s)
		@test()
		def finishesInsideItsLimit() {
			assert succeeding() is int
		}

		@test()
		def runsInsideTheSuiteLimit() {
			assert true
		}

		@timeout(30s)
		check "nested" {
			@test()
			def runsInsideBothSuiteLimits() {
				assert true
			}
		}
	}

	// A plain run gives a target the empty input and each file of its seed
	// folder, `testdata/fuzz/std_testing.fuzz_targets.<name>/`. Generated
	// inputs, and the failing side, are covered by the runner's own test,
	// internal/runtime/c/tests/test_fuzz_test.c.
	check "fuzz targets" {
		// The seed is "abc", "hello", the 16-bit length of `data` (3) and
		// `count` (5): fixed-size arguments come off the end of the input,
		// then `data` takes its length and that many bytes off the front and
		// `text`, the last, takes what is left.
		@fuzz()
		def takesItsArgumentsFromTheInput(data byte[], count uint8, text string) {
			if count == 0 {
				assert data.len() == 0
				assert text == ""
				return
			}
			assert count == 5
			assert data.len() == 3
			assert data[0] == 97 && data[1] == 98 && data[2] == 99
			assert text == "hello"
		}

		// Without parameters there is nothing to generate: it runs once.
		@fuzz()
		def runsOnceWithoutParameters() {
			assert succeeding() is int
		}
	}

	// A skipped suite takes its nested suites with it: neither test may run.
	@skip("shows that a suite can be skipped")
	check "skipped suite" {
		@test()
		def neverRuns() {
			assert false
		}

		check "nested" {
			@test()
			def neverRunsEither() {
				assert false
			}
		}
	}

	// Hooks around a suite's tests, which run in name order: the nested
	// suite's `inner`, then `first` and `second`. Each test sees what the hooks
	// before it recorded.
	check "lifecycle hooks" {
		let trail string[] = []

		def recordAll() {
			trail.push("all")
		}

		beforeAll(recordAll)
		beforeEach(def () {
			trail.push("each")
		})
		afterEach(def () !none {
			trail.push("after")
			return none
		})
		// The second afterEach runs first: cleanup mirrors setup.
		afterEach(def () {
			trail.push("after2")
		})

		@test()
		def first() {
			assert trail.join(" ") == "all inner-all each inner-each inner-after after2 after inner-done each"
		}

		@test()
		def second() {
			assert trail.join(" ") == "all inner-all each inner-each inner-after after2 after inner-done each after2 after each"
		}

		check "nested" {
			beforeAll(def () {
				trail.push("inner-all")
			})
			beforeEach(def () {
				trail.push("inner-each")
			})
			afterEach(def () {
				trail.push("inner-after")
			})
			afterAll(def () {
				trail.push("inner-done")
			})

			@test()
			def inner() {
				assert trail.join(" ") == "all inner-all each inner-each"
			}
		}
	}

	// The statements of a suite without tests run as its `body` test; a
	// function literal among them crashed the runner until 2026-10-06.
	check "suite body" {
		let twice = def (x int) int {
			return x * 2
		}
		assert twice(2) == 4
	}

	// A skipped test opens no suite: beforeAll must not run for it.
	check "hooks of a suite without a test to run" {
		beforeAll(def () {
			assert false
		})

		@skip("shows that hooks wait for a test that runs")
		@test()
		def skipped() {}
	}

	// `@parallel()` tests of a suite run together, after its other tests: the
	// rendezvous on an unbuffered channel only completes when both are running.
	check "parallel tests" {
		let meet = new channel<int>()
		let sequentialRan = false

		@parallel()
		@test()
		def aSends() {
			assert sequentialRan
			meet <- 7
		}

		@parallel()
		@test()
		def bReceives() {
			let got = <-meet
			assert got == 7
		}

		@test()
		def zRunsBeforeTheParallelOnes() {
			sequentialRan = true
		}
	}

	check "golden files" {
		@golden("testdata/golden/report.txt")
		@test()
		def text() string {
			return "name: adm\nlines: {1 + 1}\n"
		}

		@golden("testdata/golden/header.bin")
		@test()
		def bytes() !byte[] {
			let header byte[] = [0x41, 0x44, 0x4d, 0x00, 0xff]
			return header
		}
	}

	internal def failing() !int {
		fail "nope"
	}

	internal def succeeding() !int {
		return 1
	}
}
