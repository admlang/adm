partial module std.text.grammar {
	// A block of text: what folds, and what nests. `label` is an index into its grammar's
	// `labels()`, -1 for one found by indentation; `grammar` is as a token's.
	struct Block {
		grammar   int
		label     int
		startLine int
		start     int
		endLine   int
		end       int
	}

	// BlockWalker pairs the tokens that open and close blocks, line by line: folds and
	// nesting for any grammar, kept out of the line states so an edit's rescan can stop
	// early. A close with no open is ignored, and one that passes opens of other labels ends
	// them too, so text that is being typed still gives blocks.
	type BlockWalker {
		internal finished Block[] = []
		internal stack    Block[] = []

		// Starts over.
		def reset() {
			finished.len(0)
			stack.len(0)
		}

		// Takes the tokens of line `line`, in order.
		def feed(line int, tokens TokenBuffer) {
			for let i = 0; i < tokens.count(); i++ {
				closeBlock(tokens.grammar(i), tokens.closeLabel(i), line, tokens.stop(i)) when tokens.closes(i)
				stack.push(Block{grammar: tokens.grammar(i), label: tokens.label(i), startLine: line, start: tokens.start(i), endLine: -1, end: -1}) when tokens.opens(i)
			}
		}

		internal def closeBlock(grammar int, label int, line int, at int) {
			let top = stack.len() - 1
			for top >= 0 && (stack[top].grammar != grammar || stack[top].label != label) {
				top--
			}
			return when top < 0
			for let i = stack.len() - 1; i >= top; i-- {
				let block = stack.pop()
				block.endLine = line
				block.end = at
				finished.push(block)
			}
		}

		// The blocks that have closed, inner ones first.
		def blocks() Block[] {
			return finished
		}

		// The blocks still open, outermost first: what surrounds the text fed so far. Their
		// ends are -1. An XML completion reads the element it stands in from the last one.
		def open() Block[] {
			return stack
		}
	}

	// The blocks of `raw` by indentation, for languages whose structure is that: a line
	// more indented than the one before it starts a block that belongs to that line, ending
	// at the last line indented more. Blank lines belong to no block and do not end one.
	// A tab counts `tabSize` columns. In order of their end.
	def indentBlocks(raw byte[], tabSize int = 4) Block[] {
		let out Block[] = []
		// Per open block, the line and offset it starts at and its head's indent.
		let (lines, starts, indents) = (int[], int[], int[])
		let (line, at, lastLine, lastEnd, lastIndent, lastStart) = (0, 0, -1, 0, -1, 0)
		let n = raw.len()
		for at <= n {
			let from = at
			let column = 0
			for at < n && (raw[at] == 32 || raw[at] == 9) {
				column += raw[at] == 9 ?? (tabSize - column % tabSize, 1)
				at++
			}
			let textAt = at
			for at < n && raw[at] != 10 {
				at++
			}
			let stop = at
			stop-- when stop > textAt && raw[stop - 1] == 13
			if stop > textAt {
				for indents.len() > 0 && indents[indents.len() - 1] >= column {
					out.push(Block{grammar: 0, label: -1, startLine: lines.pop(), start: starts.pop(), endLine: lastLine, end: lastEnd})
					indents.pop()
				}
				if lastLine >= 0 && column > lastIndent {
					lines.push(lastLine)
					starts.push(lastStart)
					indents.push(lastIndent)
				}
				(lastLine, lastEnd, lastIndent, lastStart) = (line, stop, column, from)
			}
			line++
			at++
		}
		for indents.len() > 0 {
			out.push(Block{grammar: 0, label: -1, startLine: lines.pop(), start: starts.pop(), endLine: lastLine, end: lastEnd})
			indents.pop()
		}
		return out
	}
}
