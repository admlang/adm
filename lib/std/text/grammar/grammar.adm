// Grammar-driven tokenizing for editors and tools: a grammar is data, named states of
// ordered rules, and the engine runs it line by line over bytes. It runs on linear-time
// regexes with its work counted, so a bad grammar costs a bad colouring and not a hang.
//
//     let grammar = try compile(`
//         name = "ini"
//         kinds = ["section", "key", "comment"]
//         start = "line"
//         [[states.line]]
//         match = '^\[[^\]]*\]'
//         kind = "section"
//         [[states.line]]
//         match = '^[#;].*$'
//         kind = "comment"
//         [[states.line]]
//         match = '^[\w.-]+'
//         kind = "key"
//         `)
//     let table = new StateTable()
//     let scanner = new Scanner(grammar, table)
//     let tokens = new TokenBuffer()
//     let stop = scanner.scan(raw, 0, raw.len(), grammar.startState(table), tokens)
//
// A line's end state is an int: comparing two says whether an edit changed what follows.
partial module std.text.grammar {
	use std.text.grammar.engine as engine

	// Grammar is a compiled grammar: read-only, shared between tasks and between state
	// tables. A task scans through a `Scanner` of its own.
	type Grammar {
		internal core engine.GrammarCore

		internal def new(core engine.GrammarCore) {
			self.core = core
		}

		// The name the grammar gives itself.
		def name() string {
			return core.grammarName
		}

		// The names of its kinds; a token's `kind` indexes them.
		def kinds() string[] {
			return core.kindNames
		}

		// The index of a kind by name, -1 when the grammar has no such kind.
		def kindOf(name string) int {
			let at = core.kindIndex.get(name)
			return at is none ?? (-1, at)
		}

		// The kinds a role names: `comment`, `string` and `escape` by the grammar's `roles`,
		// for finding them without knowing what a language calls them.
		def kindsWithRole(role string) int[] {
			let held = core.roles.get(role)
			return held is none ?? ([], held)
		}

		// The names of its block labels; a token's `label` indexes them.
		def labels() string[] {
			return core.labelNames
		}

		// How its blocks fold when no rule says: "indent", else "".
		def folding() string {
			return core.foldBy
		}

		// The state a text starts in, in `table`.
		def startState(table StateTable) int {
			return table.frames.startOf(core)
		}
	}

	// Compiles a grammar from its TOML text. `maxProgram` bounds what each state's rules
	// compile to; text from a source that is not trusted stays within the default.
	//
	// Fails naming the state, rule and line when a rule cannot be used: a pattern that does
	// not compile or compiles too large, a name the grammar does not declare, a rule that
	// can match nothing before the end of a line and changes nothing.
	def compile(source string, maxProgram int = engine.defaultMaxProgram) !Grammar {
		return new Grammar(try engine.compileText(source, maxProgram))
	}

	// Compiles a grammar from the tree its TOML text reads as, of prelude types only: maps
	// with string keys, `any[]`, strings, ints and bools. Fails as `compile(source)` does.
	def compile(source map<string, any>, maxProgram int = engine.defaultMaxProgram) !Grammar {
		return new Grammar(try engine.compileTree(source, maxProgram))
	}

	// StateTable gives each stack of states a small int, so comparing two is comparing ints:
	// an edit's rescan stops at the first line that ends in the state it did. Keep one per
	// document, shared by its scanners. Past `maxStates` new kept values are dropped and
	// then new stacks stay where they are, which can colour wrongly but cannot grow.
	type StateTable {
		internal frames engine.FrameTable

		def new(maxStates int = 1 << 16) {
			frames = new engine.FrameTable(maxStates)
		}

		// How many states it holds.
		def len() int {
			return frames.len()
		}
	}

	// TokenBuffer holds a scan's tokens in flat arrays, so a line of any size allocates
	// nothing per token. Text no rule took has no token.
	type TokenBuffer {
		internal store engine.TokenStore = new engine.TokenStore()

		// Empties it, keeping its room.
		def clear() {
			store.clear()
		}

		// How many tokens it holds.
		def count() int {
			return store.starts.len()
		}

		// The byte offset token `i` starts at.
		def start(i int) int {
			return store.starts[i]
		}

		// The byte offset token `i` ends at, one past its last byte.
		def stop(i int) int {
			return store.stops[i]
		}

		// The kind of token `i`, an index into its grammar's `kinds()`; -1 for a token that
		// is there only to mark a block.
		def kind(i int) int {
			return store.kinds[i]
		}

		// The grammar of token `i`, as `Scanner.grammarAt` reads it: inside an embedded
		// language, that language's.
		def grammar(i int) int {
			return store.owners[i]
		}

		// Whether token `i` opens a block.
		def opens(i int) bool {
			return store.openings[i] >= 0
		}

		// Whether token `i` closes a block. A token may close one and open another.
		def closes(i int) bool {
			return store.closings[i] >= 0
		}

		// The label of the block token `i` opens, else of the one it closes, -1 for neither:
		// an index into its grammar's `labels()`.
		def label(i int) int {
			return store.openings[i] >= 0 ?? (store.openings[i], store.closings[i])
		}

		// The label of the block token `i` closes, -1 for none.
		def closeLabel(i int) int {
			return store.closings[i]
		}
	}

	// Where a scan stopped.
	struct ScanStop {
		// The byte offset it stopped at.
		at    int
		// The state there.
		state int
		// Whether it reached the end it was given; false: it used its budget or reached
		// `pause`, and goes on from `at` in `state`.
		done  bool
	}

	// Finds a language an embedding rule names, none when there is no such language: its
	// text then stays plain. It runs during a scan, so it only looks up.
	type GrammarResolver = def (name string) ?Grammar

	// Scanner runs grammars over lines of bytes. It belongs to one task at a time; the
	// grammars and the state table are shared.
	type Scanner {
		internal core  engine.ScanCore
		internal table StateTable

		// A scanner of `grammar`, keeping its states in `table`. `resolve` finds the
		// languages rules embed; without it their text stays plain.
		def new(grammar Grammar, table StateTable, resolve ?GrammarResolver = none) {
			self.table = table
			let find ?def (string) ?engine.GrammarCore = none
			if !(resolve is none) {
				let named GrammarResolver = resolve
				find = def (name string) ?engine.GrammarCore {
					let found = named(name)
					return found is none ?? (none, found.core)
				}
			}
			core = new engine.ScanCore(grammar.core, table.frames, find)
		}

		// The state a text starts in.
		def startState() int {
			return table.frames.startOf(core.grammar)
		}

		// The grammar a token's `grammar(i)` names.
		def grammarAt(index int) Grammar {
			return new Grammar(table.frames.grammarAt(index))
		}

		// Scans `raw[from:end]`, one line or the part of one that follows a stop, from `state`,
		// adding the tokens to `out`. `^` and `$` hold at line breaks and at `end`.
		//
		// It stops at a token boundary once it has read `budget` bytes (negative: no budget) or
		// passed `pause` (negative: not until `end`), to go on from where it says. Bytes read
		// count, not bytes tokenized, so the work of a pattern that reads far is seen.
		def scan(raw byte[], from int, end int, state int, out TokenBuffer, budget int = -1, pause int = -1) ScanStop {
			let stop = core.scan(raw, from, end, state, out.store, budget, pause)
			return ScanStop{at: stop.at, state: stop.state, done: stop.done}
		}
	}
}
