partial module std.text.grammar {
	use (
		std.services.runtime::(Runtime)
		std.testing
		std.text.grammar.engine as engine
	)

	const xmlGrammar = `
		name = "xml"
		kinds = ["comment", "tag", "attribute", "value", "punctuation", "text", "entity"]
		start = "content"

		[roles]
		comment = ["comment"]
		string = ["value"]
		escape = ["entity"]

		[defaults]
		comment = "comment"

		[[states.content]]
		match = '<!--'
		kind = "comment"
		push = "comment"

		[[states.content]]
		match = '</[\w:.-]+'
		kind = "tag"
		close = "element"
		push = "closeTag"

		[[states.content]]
		match = '<[\w:.-]+'
		kind = "tag"
		open = "element"
		push = "tag"

		[[states.content]]
		match = '&\w+;'
		kind = "entity"

		[[states.content]]
		match = '[^<&]+'
		kind = "text"

		[[states.comment]]
		match = '-->'
		kind = "comment"
		pop = true

		[[states.tag]]
		match = '/>'
		kind = "punctuation"
		close = "element"
		pop = true

		[[states.tag]]
		match = '>'
		kind = "punctuation"
		pop = true

		[[states.tag]]
		match = '[\w:.-]+'
		kind = "attribute"

		[[states.tag]]
		match = '"[^"]*"'
		kind = "value"

		[[states.tag]]
		match = '='
		kind = "punctuation"

		[[states.closeTag]]
		match = '>'
		kind = "tag"
		pop = true
		`

	const markdownGrammar = `
		name = "markdown"
		kinds = ["heading", "fence", "language", "text"]
		start = "body"

		[[states.body]]
		match = '^(\x60{3,})(\w*)\s*$'
		kinds = ["fence", "language"]
		keep = { fence = 1 }
		embed = { group = 2 }
		until = { match = '^(\x60{3,})\s*$', kind = "fence", atLeast = { fence = 1 } }

		[[states.body]]
		match = '^#+ .*$'
		kind = "heading"
		`

	const cssGrammar = `
		name = "css"
		kinds = ["property", "comment"]
		start = "rules"

		[[states.rules]]
		match = '/\*'
		kind = "comment"
		push = "comment"

		[[states.rules]]
		match = '[a-z-]+'
		kind = "property"

		[defaults]
		comment = "comment"

		[[states.comment]]
		match = '\*/'
		kind = "comment"
		pop = true
		`

	check "Grammars" {
		// The tokens of `text`'s lines as `kind text` pairs, a line break as `|`.
		def tokensOf(g Grammar, text string, resolve ?GrammarResolver = none) string {
			let table = new StateTable()
			let scanner = new Scanner(g, table, resolve)
			let raw = text.bytes()
			let out = new TokenBuffer()
			let state = g.startState(table)
			let parts string[]
			let at = 0
			for at <= raw.len() {
				let end = at
				for end < raw.len() && raw[end] != 10 {
					end++
				}
				out.clear()
				let stop = scanner.scan(raw, at, end, state, out)
				assert stop.done && stop.at == end
				state = stop.state
				for let i = 0; i < out.count(); i++ {
					let kind = out.kind(i)
					let names = scanner.grammarAt(out.grammar(i)).kinds()
					parts.push("{kind < 0 ?? ("-", names[kind])} {string(raw[out.start(i):out.stop(i)])}")
				}
				parts.push("|") when end < raw.len()
				at = end + 1
			}
			return parts.join(",")
		}

		def named(g ...Grammar) GrammarResolver {
			let held = g
			return def (name string) ?Grammar {
				for let (_, one) in held {
					return one when one.name() == name
				}
				return none
			}
		}

		def must(source string) Grammar {
			let made = compile(source) onerror (err error) {
				assert err.message == ""
				return new Grammar(new engine.GrammarCore())
			}
			return made
		}

		def failureOf(source string) string {
			let made = compile(source) onerror (err error) {
				return err.message
			}
			return made.name()
		}

		@test()
		def TestDescribesItself() {
			let g = must(xmlGrammar)
			assert g.name() == "xml" && g.kinds().len() == 7 && g.kindOf("value") == 3 && g.kindOf("nope") == -1
			assert g.kindsWithRole("comment").join(",") == "0" && g.kindsWithRole("string").join(",") == "3"
			assert g.kindsWithRole("escape").join(",") == "6" && g.kindsWithRole("other").len() == 0
			assert g.labels().join(",") == "element" && g.folding() == ""
		}

		@test()
		def TestStatesAndKinds() {
			let g = must(xmlGrammar)
			assert tokensOf(g, "<a b=\"c\">x &amp; y</a>") == "tag <a,attribute b,punctuation =,value \"c\",punctuation >,text x ,entity &amp;,text  y,tag </a,tag >"
		}

		// A state crosses lines, and its text no rule takes has the state's default kind.
		@test()
		def TestStateCrossesLines() {
			let g = must(xmlGrammar)
			assert tokensOf(g, "<!-- one\ntwo --> x") == "comment <!--,comment  one,|,comment two ,comment -->,text  x"
			assert tokensOf(g, "<a\nb=\"c\"\n>") == "tag <a,|,attribute b,punctuation =,value \"c\",|,punctuation >"
		}

		// Text no rule takes and no default covers has no token.
		@test()
		def TestNoRuleNoToken() {
			let g = must("name = \"t\"\nkinds = [\"word\"]\nstart = \"a\"\n[[states.a]]\nmatch = '[a-z]+'\nkind = \"word\"\n")
			assert tokensOf(g, "1 ab 2 cd 3") == "word ab,word cd"
			assert tokensOf(g, "é ab é") == "word ab"
		}

		// Each group its kind, the rest of the match the rule's.
		@test()
		def TestKindsPerGroup() {
			let g = must("name = \"t\"\nkinds = [\"key\", \"value\", \"other\"]\nstart = \"a\"\n[[states.a]]\nmatch = '(\\w+) = (\\w+);'\nkind = \"other\"\nkinds = [\"key\", \"value\"]\n")
			assert tokensOf(g, "a = 1;") == "key a,other  = ,value 1,other ;"
		}

		@test()
		def TestGotoPopAndInclude() {
			let g = must(`
				name = "t"
				kinds = ["a", "b", "c"]
				start = "one"
				[[states.shared]]
				match = 'c'
				kind = "c"
				[[states.one]]
				include = "shared"
				[[states.one]]
				match = 'a'
				kind = "a"
				goto = "two"
				[[states.two]]
				match = 'b'
				kind = "b"
				push = "three"
				[[states.two]]
				match = 'a'
				kind = "a"
				[[states.three]]
				include = "shared"
				[[states.three]]
				match = 'a'
				kind = "a"
				pop = true
				`)
			// After goto, `c` is no rule of the state; after a push it is again, until the pop.
			assert tokensOf(g, "cacbcaca") == "c c,a a,b b,c c,a a,a a"
		}

		// `$` applies at the end of a line, so a state can end with its line.
		@test()
		def TestEndOfLineRules() {
			let g = must(`
				name = "t"
				kinds = ["comment", "word"]
				start = "code"
				[defaults]
				comment = "comment"
				[[states.code]]
				match = '//'
				kind = "comment"
				push = "comment"
				[[states.code]]
				match = '\w+'
				kind = "word"
				[[states.comment]]
				match = '$'
				pop = true
				`)
			assert tokensOf(g, "a // b\nc") == "word a,comment //,comment  b,|,word c"
			assert tokensOf(g, "//\nc") == "comment //,|,word c"
		}

		// A kept value decides which line closes, by plain comparison.
		@test()
		def TestKeptValues() {
			let g = must(`
				name = "t"
				kinds = ["mark", "body"]
				start = "code"
				[defaults]
				here = "body"
				[[states.code]]
				match = '<<(\w+)$'
				kind = "mark"
				push = "here"
				keep = { tag = 1 }
				[[states.here]]
				match = '^(\w+)$'
				kind = "mark"
				same = { tag = 1 }
				pop = true
				`)
			assert tokensOf(g, "<<EOF\nfoo\nEOF\nbar") == "mark <<EOF,|,body foo,|,mark EOF,|"
		}

		// A goto stays where the frame was and keeps what it kept; a rule's own value of the
		// same name takes over.
		@test()
		def TestGotoKeepsWhatTheFrameKept() {
			let g = must(`
				name = "t"
				kinds = ["mark", "first", "next", "other"]
				start = "code"
				[[states.code]]
				match = '<<(\w+)$'
				kind = "mark"
				push = "first"
				keep = { tag = 1 }
				[[states.first]]
				match = '^(\w+)$'
				kind = "mark"
				same = { tag = 1 }
				pop = true
				[[states.first]]
				match = '^=(\w+)$'
				kind = "other"
				goto = "first"
				keep = { tag = 1 }
				[[states.first]]
				match = '^\w+ \w+$'
				kind = "first"
				goto = "more"
				[[states.more]]
				match = '^(\w+)$'
				kind = "mark"
				same = { tag = 1 }
				pop = true
				[[states.more]]
				match = '^\w+ \w+$'
				kind = "next"
				`)
			assert tokensOf(g, "<<EOF\na b\nc d\nEOF") == "mark <<EOF,|,first a b,|,next c d,|,mark EOF"
			assert tokensOf(g, "<<EOF\n=END\nEOF\nEND") == "mark <<EOF,|,other =END,|,|,mark END"
		}

		// What an embedding keeps is its closing's, by its host's names: a goto in the language
		// carries it, and the language's own names are another matter though they number alike.
		@test()
		def TestClosingKeepsItsValueAcrossGoto() {
			let guest = must(`
				name = "guest"
				kinds = ["command", "argument", "same"]
				start = "first"
				[[states.first]]
				match = '^(\w+) (\w+)$'
				kinds = ["command", "argument"]
				keep = { own = 2 }
				goto = "rest"
				[[states.first]]
				match = '^\w+$'
				kind = "command"
				goto = "rest"
				[[states.rest]]
				match = '^(\w+)$'
				kind = "same"
				same = { own = 1 }
				[[states.rest]]
				match = '\w+'
				kind = "argument"
				`)
			let host = must(`
				name = "host"
				kinds = ["mark", "end", "other"]
				start = "line"
				[[states.line]]
				match = '^<<(\w+)$'
				kind = "mark"
				keep = { mark = 1 }
				embed = "guest"
				until = { match = '^(\w+)$', kind = "end", same = { mark = 1 } }
				[[states.line]]
				match = '\w+'
				kind = "other"
				`)
			let resolve = named(host, guest)
			assert tokensOf(host, "<<EOF\necho\nmore\nEOF\nnext", resolve) == "mark <<EOF,|,command echo,|,argument more,|,end EOF,|,other next"
			// `own` is the guest's first name and `mark` the host's: the guest's guard reads its own.
			assert tokensOf(host, "<<EOF\ndo it\nit\nnope\nEOF\nnext", resolve) == "mark <<EOF,|,command do,argument it,|,same it,|,argument nope,|,end EOF,|,other next"
			assert tokensOf(host, "<<EOF\necho\nEOF\nnext", resolve) == "mark <<EOF,|,command echo,|,end EOF,|,other next"
		}

		// A refused rule gives way to those after it.
		@test()
		def TestGuardGivesWay() {
			let g = must(`
				name = "t"
				kinds = ["mark", "word"]
				start = "code"
				[[states.code]]
				match = '<<(\w+)$'
				kind = "mark"
				push = "here"
				keep = { tag = 1 }
				[[states.here]]
				match = '^(\w+)$'
				kind = "mark"
				same = { tag = 1 }
				pop = true
				[[states.here]]
				match = '\w+'
				kind = "word"
				`)
			assert tokensOf(g, "<<E\nfoo\nE") == "mark <<E,|,word foo,|,mark E"
		}

		// A language inside a language, named by a group, ended by a closing it cannot swallow.
		@test()
		def TestEmbedding() {
			let (md, css) = (must(markdownGrammar), must(cssGrammar))
			let resolve = named(md, css)
			assert tokensOf(md, "# t\n```css\ncolor /* x\n```\n# u", resolve) == "heading # t,|,fence ```,language css,|,property color,comment /*,comment  x,|,fence ```,|,heading # u"
			// A shorter fence does not close, and goes to the language.
			assert tokensOf(md, "````css\ncolor\n```\n````\n# u", resolve) == "fence ````,language css,|,property color,|,|,fence ````,|,heading # u"
			// A language nobody knows stays plain, and still ends.
			assert tokensOf(md, "```nope\nanything\n```\n# u", resolve) == "fence ```,language nope,|,|,fence ```,|,heading # u"
			assert tokensOf(md, "```css\ncolor\n```\n# u") == "fence ```,language css,|,|,fence ```,|,heading # u"
		}

		// A closing after an odd run of the character that escapes does not close, and
		// nothing matched where it ended closes in its place.
		@test()
		def TestEscapedClosingIsRefused() {
			let shell = must(`
				name = "sh"
				kinds = ["word"]
				start = "code"
				[[states.code]]
				match = '\w+'
				kind = "word"
				`)
			let host = must(`
				name = "file"
				kinds = ["instruction", "quote", "other"]
				start = "line"
				[[states.line]]
				match = 'RUN\b'
				kind = "instruction"
				embed = "sh"
				until = { match = '[ \t]*\r?$', notEscapedBy = '\' }
				[[states.line]]
				match = '"'
				kind = "quote"
				embed = "sh"
				until = { match = '"', kind = "quote", notEscapedBy = '\' }
				[[states.line]]
				match = '\w+'
				kind = "other"
				`)
			let resolve = named(host, shell)
			let words = def (text string) string[] {
				return tokensOf(host, text, resolve).split(",").filter(part => !part.startsWith("- "))
			}
			// A line's end after one backslash goes on, on Windows' line ends and past blanks too.
			assert words("RUN a\\\nb\nc").join(",") == "instruction RUN,word a,|,word b,|,other c"
			assert words("RUN a\\\r\nb\r\nc").join(",") == "instruction RUN,word a,|,word b,|,other c"
			assert words("RUN a\\  \nb\nc").join(",") == "instruction RUN,word a,|,word b,|,other c"
			// Two backslashes are an escaped one: the line's end closes.
			assert words("RUN a\\\\\nb").join(",") == "instruction RUN,word a,|,other b"
			assert words("RUN a\nb").join(",") == "instruction RUN,word a,|,other b"
			// A quote too, wherever it stands.
			assert words("\"a\\\"b\" c").join(",") == "quote \",word a,word b,quote \",other c"
			assert words("\"a\\\\\" c").join(",") == "quote \",word a,quote \",other c"
			let head = "name = \"t\"\nkinds = [\"w\"]\nstart = \"a\"\n[[states.a]]\nmatch = 'x'\nembed = \"c\"\nuntil = \{ match = 'y', notEscapedBy = "
			assert failureOf(head + "'ab' }\n").contains("one ASCII character")
			assert failureOf(head + "1 }\n").contains("one ASCII character")
		}

		// The closing is found before the language sees the text, on the same line too.
		@test()
		def TestClosingComesFirst() {
			let host = must(`
				name = "html"
				kinds = ["tag", "text"]
				start = "body"
				[[states.body]]
				match = '<style>'
				kind = "tag"
				embed = "css"
				until = { match = '</style>', kind = "tag" }
				[[states.body]]
				match = '\w+'
				kind = "text"
				`)
			let css = must(cssGrammar)
			assert tokensOf(host, "<style>/* no end </style>after", named(css)) == "tag <style>,comment /*,comment  no end ,tag </style>,text after"
		}

		// Tokens say which grammar's kinds they use, and states are equal across lines.
		@test()
		def TestGrammarOfAToken() {
			let (md, css) = (must(markdownGrammar), must(cssGrammar))
			let table = new StateTable()
			let scanner = new Scanner(md, table, named(css))
			let raw = "```css".bytes()
			let out = new TokenBuffer()
			let stop = scanner.scan(raw, 0, raw.len(), md.startState(table), out)
			let inner = "color".bytes()
			out.clear()
			let next = scanner.scan(inner, 0, inner.len(), stop.state, out)
			assert out.count() == 1 && scanner.grammarAt(out.grammar(0)).name() == "css"
			assert out.kind(0) == css.kindOf("property") && next.state == stop.state
		}

		// A language's pop cannot leave it, and a text's first state stays.
		@test()
		def TestPopStaysWithin() {
			let popper = must("name = \"p\"\nkinds = [\"x\"]\nstart = \"a\"\n[[states.a]]\nmatch = 'x'\nkind = \"x\"\npop = 5\n")
			assert tokensOf(popper, "xx") == "x x,x x"
			let host = must(`
				name = "h"
				kinds = ["o"]
				start = "a"
				[[states.a]]
				match = '\['
				kind = "o"
				embed = "p"
				until = { match = '\]', kind = "o" }
				`)
			assert tokensOf(host, "[xx]", named(popper)) == "o [,x x,x x,o ]"
		}

		@test()
		def TestBothSourcesCompile() !none {
			let tree = map<string, any>{
				"name":   "t",
				"kinds":  any["w"],
				"start":  "a",
				"states": map<string, any>{
					"a": any[map<string, any>{"match": "\\w+", "kind": "w"}],
				},
			}
			let g = try compile(tree)
			assert tokensOf(g, "ab") == "w ab"
		}

		// A block goes on over blank lines and ends, unread, at the first line not indented
		// deeper: a rule matching nothing at the end of a line keeps a blank line in the
		// state, ahead of the rule that matches nothing to leave it.
		@test()
		def TestBlankLineStaysAheadOfALeavingRule() {
			let g = must(`
				name = "block"
				kinds = ["head", "text", "key"]
				start = "top"

				[[states.top]]
				match = '^( *)\w+: \|$'
				kind = "head"
				keep = { indent = 1 }
				push = "text"

				[[states.top]]
				match = '.+'
				kind = "key"

				[[states.text]]
				match = '^( *) .*$'
				kind = "text"
				atLeast = { indent = 1 }

				[[states.text]]
				match = '^[ \t\r]*$'

				[[states.text]]
				match = '^'
				pop = true
			`)
			assert tokensOf(g, "k: |\n  one\n\n   \n  two\nafter: x\n") == "head k: |,|,text   one,|,|,text    ,|,text   two,|,key after: x,|"
			let head = "name = \"t\"\nkinds = [\"w\"]\nstart = \"a\"\n"
			assert failureOf(head + "[[states.a]]\nmatch = '^'\n").contains("matches nothing")
			assert failureOf(head + "[[states.a]]\nmatch = '\\b'\n").contains("matches nothing")
			assert failureOf(head + "[[states.a]]\nmatch = '[^q]*'\n").contains("matches nothing")
			assert failureOf(head + "[[states.a]]\nmatch = '(?:x|)'\n").contains("matches nothing")
			assert failureOf(head + "[[states.a]]\nmatch = 'x*$'\n") == "t"
		}

		@test()
		def TestCompileErrorsNameTheRule() {
			let head = "name = \"t\"\nkinds = [\"w\"]\nstart = \"a\"\n"
			assert failureOf(head + "[[states.a]]\nmatch = '('\n").contains("rule 0")
			assert failureOf(head + "[[states.a]]\nmatch = 'x'\n[[states.a]]\nmatch = 'y'\nkind = \"nope\"\n") == "t: state a, rule 1 (line 6): `nope` is not a kind of the grammar"
			assert failureOf(head + "[[states.a]]\nmatch = 'x'\npush = \"b\"\n").contains("`push` must name a state")
			assert failureOf(head + "[[states.a]]\nmatch = 'x*'\n").contains("matches nothing")
			assert failureOf(head + "[[states.a]]\nmatch = '(x)'\nkeep = \{ v = 1 }\n").contains("`keep` needs")
			assert failureOf(head + "[[states.a]]\ninclude = \"a\"\n").contains("includes itself")
			assert failureOf(head + "[[states.a]]\nmatch = 'x'\nembed = \"c\"\n").contains("go together")
			assert failureOf("name = \"t\"\nkinds = [\"w\"]\nstart = \"z\"\n[[states.a]]\nmatch = 'x'\n").contains("`start`")
			assert failureOf("name =").len() > 0
			// A pattern too large for a grammar from elsewhere.
			assert failureOf(head + "[[states.a]]\nmatch = '\\pL\{1000}'\n").contains("too large")
		}

		// Rules that do not consume cannot hold a scan at a position, in any combination.
		@test()
		def TestNoProgressMovesOn() {
			let cycle = must(`
				name = "t"
				kinds = ["x"]
				start = "a"
				[[states.a]]
				match = ''
				push = "b"
				[[states.b]]
				match = ''
				pop = true
				`)
			let raw = "abc".bytes()
			let table = new StateTable()
			let scanner = new Scanner(cycle, table)
			let stop = scanner.scan(raw, 0, 3, cycle.startState(table), new TokenBuffer())
			assert stop.done && stop.at == 3
			// Pushing without end stops at the depth bound, and nothing grows past it.
			let deep = must(`
				name = "t"
				kinds = ["x"]
				start = "a"
				[[states.a]]
				match = 'x'
				kind = "x"
				push = "a"
				`)
			let long = "x".repeat(10000).bytes()
			let t2 = new StateTable()
			let s2 = new Scanner(deep, t2)
			let out = new TokenBuffer()
			assert s2.scan(long, 0, long.len(), deep.startState(t2), out).done
			assert out.count() == 10000 && t2.len() <= 70
		}

		// A pattern that reads to the end and fails, tried everywhere, is bounded by the
		// bytes it reads: the budget stops it, and scanning goes on from where it stopped.
		@test()
		def TestBudgetCountsWhatIsRead() {
			let g = must(`
				name = "t"
				kinds = ["x", "y"]
				start = "a"
				[[states.a]]
				match = 'x[^y]*y'
				kind = "x"
				[[states.a]]
				match = 'x'
				kind = "y"
				`)
			let raw = "x".repeat(20000).bytes()
			let table = new StateTable()
			let scanner = new Scanner(g, table)
			let out = new TokenBuffer()
			let stop = scanner.scan(raw, 0, raw.len(), g.startState(table), out, budget = 100000)
			assert !stop.done && stop.at < 20000 && stop.at > 0
			assert out.count() == stop.at
			out.clear()
			let rest = scanner.scan(raw, stop.at, raw.len(), stop.state, out, budget = 100000)
			assert rest.at > stop.at
		}

		// The longest token: past it the text goes on as it can.
		@test()
		def TestLongMatchIsCut() {
			let g = must("name = \"t\"\nkinds = [\"x\"]\nstart = \"a\"\n[[states.a]]\nmatch = 'x+'\nkind = \"x\"\n")
			let raw = "x".repeat(200000).bytes()
			let table = new StateTable()
			let out = new TokenBuffer()
			let stop = new Scanner(g, table).scan(raw, 0, raw.len(), g.startState(table), out)
			assert stop.done
			assert out.count() == 4 && out.stop(out.count() - 1) == 200000
			for let i = 1; i < out.count(); i++ {
				assert out.start(i) == out.stop(i - 1)
			}
		}

		// A full table keeps scanning; kept values go first, then new stacks.
		@test()
		def TestTableBound() {
			let g = must(`
				name = "t"
				kinds = ["x"]
				start = "a"
				[[states.a]]
				match = '(\d+)'
				kind = "x"
				goto = "a"
				keep = { n = 1 }
				`)
			let table = new StateTable(maxStates = 50)
			let scanner = new Scanner(g, table)
			let state = g.startState(table)
			let out = new TokenBuffer()
			for let i = 0; i < 500; i++ {
				let raw = "{i}".bytes()
				state = scanner.scan(raw, 0, raw.len(), state, out).state
			}
			assert table.len() <= 51
			assert out.count() == 500
		}

		// Two tables hold the same grammar apart, and a grammar is shared between tasks.
		@test()
		def TestTablesAndTasks() {
			let g = must(xmlGrammar)
			let (a, b) = (new StateTable(), new StateTable())
			assert g.startState(a) == 0 && g.startState(b) == 0
			let raw = "<a><b c=\"d\">t &amp; u</b></a>".repeat(200).bytes()
			let futures (async int)[]
			for let i = 0; i < 8; i++ {
				futures.push(async countTokens(g, raw))
			}
			for let f in futures {
				let n = await f
				assert n == 2800
			}
		}

		def countTokens(g Grammar, raw byte[]) int {
			let table = new StateTable()
			let out = new TokenBuffer()
			new Scanner(g, table).scan(raw, 0, raw.len(), g.startState(table), out)
			return out.count()
		}

		// Closing a document frees its table, an embedded language's frames too.
		@test()
		def TestTablesAreFreed() {
			let (md, css) = (must(markdownGrammar), must(cssGrammar))
			let resolve = named(css)
			let raw = "\x60\x60\x60css".bytes()
			let run = def () {
				let table = new StateTable()
				let out = new TokenBuffer()
				new Scanner(md, table, resolve).scan(raw, 0, raw.len(), md.startState(table), out)
			}
			for let i = 0; i < 100; i++ {
				run()
			}
			let before = Runtime.memoryUsage().liveBytes
			for let i = 0; i < 2000; i++ {
				run()
			}
			assert Runtime.memoryUsage().liveBytes - before <= 4096
		}

		// An edit's rescan stops where the state comes back to what it was.
		@test()
		def TestStatesCompareAcrossRescans() {
			let g = must(xmlGrammar)
			let table = new StateTable()
			let scanner = new Scanner(g, table)
			let out = new TokenBuffer()
			let endOf = def (text string, state int) int {
				let raw = text.bytes()
				return scanner.scan(raw, 0, raw.len(), state, out).state
			}
			let start = g.startState(table)
			let open = endOf("<!-- a", start)
			assert open != start
			assert endOf("b", open) == open
			assert endOf("--> c", open) == start
			assert endOf("<!-- other", start) == open
		}

		// Blocks pair up by label, and stay out of the states.
		@test()
		def TestBlocks() {
			let g = must(xmlGrammar)
			let table = new StateTable()
			let scanner = new Scanner(g, table)
			let out = new TokenBuffer()
			let walker = new BlockWalker()
			let state = g.startState(table)
			let lines = ["<a>", "  <b/>", "  <c>", "  </c>", "  <d>"]
			let raws byte[][]
			for let (i, line) in lines {
				let raw = line.bytes()
				out.clear()
				state = scanner.scan(raw, 0, raw.len(), state, out).state
				walker.feed(i, out)
				raws.push(raw)
				assert state == g.startState(table)
			}
			let done = walker.blocks()
			assert done.len() == 2
			assert done[0].startLine == 1 && done[0].endLine == 1
			assert done[1].startLine == 2 && done[1].endLine == 3
			assert g.labels()[done[1].label] == "element"
			// What still surrounds the end: `a`, then `d`, by offsets into their lines.
			let open = walker.open()
			assert open.len() == 2 && open[0].startLine == 0 && open[1].startLine == 4
			assert string(raws[4][open[1].start:open[1].start + 2]) == "<d"
			// A token says what it opens and closes.
			let marked = "<a/>".bytes()
			out.clear()
			scanner.scan(marked, 0, marked.len(), g.startState(table), out)
			assert out.opens(0) && !out.closes(0) && g.labels()[out.label(0)] == "element"
			assert out.closes(1) && !out.opens(1) && g.labels()[out.closeLabel(1)] == "element"
			// A close with no open is ignored; a close past another label ends that too.
			walker.reset()
			out.clear()
			let raw = "</x><a>".bytes()
			scanner.scan(raw, 0, raw.len(), g.startState(table), out)
			walker.feed(0, out)
			assert walker.blocks().len() == 0 && walker.open().len() == 1
		}

		@test()
		def TestIndentBlocks() {
			let text = "a:\n  b: 1\n  c:\n\n    d: 2\n    e: 3\nf: 4\n\tg: 5\n"
			let blocks = indentBlocks(text.bytes())
			let shown string[]
			for let (_, b) in blocks {
				shown.push("{b.startLine}-{b.endLine}")
			}
			assert shown.join(" ") == "2-5 0-5 6-7"
			assert indentBlocks("".bytes()).len() == 0
			assert indentBlocks("flat\nlines\n".bytes()).len() == 0
			assert must("name = \"t\"\nkinds = []\nfolding = \"indent\"\nstart = \"a\"\n[[states.a]]\nmatch = 'x'\n").folding() == "indent"
		}

		// Showing the middle of a long line scans from a checkpoint before it, and the
		// tokens are the ones a whole scan gives.
		@test()
		def TestCheckpoints() {
			let g = must(xmlGrammar)
			let raw = "<a b=\"c\">text &amp; <!-- note --></a>".repeat(5000).bytes()
			let table = new StateTable()
			let scanner = new Scanner(g, table)
			let whole = new TokenBuffer()
			scanner.scan(raw, 0, raw.len(), g.startState(table), whole)
			let marks = new LineCheckpoints(spacing = 4096)
			marks.reset(0, g.startState(table))
			let out = new TokenBuffer()
			let (from, to) = (100000, 100400)
			let stop = marks.visible(scanner, raw, from, to, raw.len(), out)
			assert !stop.done || stop.at >= to
			assert marks.count() > 10
			// Nothing was scanned twice to get there: what it holds now is within a spacing.
			assert out.start(0) >= from - 8192 && out.start(0) <= from
			let same = 0
			for let i = 0; i < whole.count(); i++ {
				continue when whole.start(i) < out.start(0)
				break when same >= out.count()
				assert whole.start(i) == out.start(same) && whole.stop(i) == out.stop(same) && whole.kind(i) == out.kind(same)
				same++
			}
			assert same == out.count()
			// A second look reuses them, and a budget splits the work of reaching far.
			let before = marks.count()
			out.clear()
			marks.visible(scanner, raw, 50000, 50100, raw.len(), out)
			assert marks.count() == before
			let slow = new LineCheckpoints(spacing = 4096)
			slow.reset(0, g.startState(table))
			out.clear()
			let part = slow.visible(scanner, raw, 150000, 150100, raw.len(), out, budget = 20000)
			assert !part.done && part.at < 30000 && out.count() == 0
			// Going on reaches it.
			let full = slow.visible(scanner, raw, 150000, 150100, raw.len(), out)
			assert full.at >= 150100 && out.count() > 0
			// An edit forgets what follows it.
			marks.forget(50000)
			assert marks.count() < before && marks.count() > 1
		}

		// A single line of 5 MB, as a minified document is.
		def bigLine() byte[] {
			let piece = "<rect id=\"r1\" x=\"10\" y=\"20\" width=\"300\" height=\"40\" fill=\"#a0b0c0\"/><text x=\"1\">some &amp; words</text><!-- note -->"
			return piece.repeat(5 * 1024 * 1024 / piece.len()).bytes()
		}

		let benchLine = bigLine()
		let benchXml = must(xmlGrammar)

		// All of the line, once.
		@benchmark()
		def BenchFiveMegabyteLineWhole() {
			let table = new StateTable()
			let out = new TokenBuffer()
			new Scanner(benchXml, table).scan(benchLine, 0, benchLine.len(), benchXml.startState(table), out)
		}

		// A screen of it, from checkpoints made earlier: what a frame's draw asks for.
		let benchTable = new StateTable()
		let benchScanner = new Scanner(benchXml, benchTable)
		let benchMarks = reachMiddle()
		let benchOut = new TokenBuffer()

		def reachMiddle() LineCheckpoints {
			let marks = new LineCheckpoints()
			marks.reset(0, benchXml.startState(benchTable))
			marks.visible(benchScanner, benchLine, benchLine.len() / 2, benchLine.len() / 2 + 4096, benchLine.len(), new TokenBuffer())
			return marks
		}

		@benchmark()
		def BenchFiveMegabyteLineVisible() {
			benchOut.clear()
			let at = benchLine.len() / 2
			benchMarks.visible(benchScanner, benchLine, at, at + 4096, benchLine.len(), benchOut)
		}

		// One small line, as editing ordinary text is.
		let benchShort = "<rect x=\"10\" y=\"20\" width=\"300\"/> text".bytes()

		@benchmark()
		def BenchOneLine() {
			benchOut.clear()
			benchScanner.scan(benchShort, 0, benchShort.len(), benchXml.startState(benchTable), benchOut)
		}
	}
}
