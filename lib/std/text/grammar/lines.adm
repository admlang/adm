partial module std.text.grammar {
	// LineCheckpoints makes one very long line cheap: states kept every so many bytes as
	// the line is scanned, so showing a part of it scans only from the checkpoint before
	// that part. Keep one per long line; an edit calls `forget`.
	type LineCheckpoints {
		internal spacing int
		internal offsets int[]       = []
		internal states  int[]       = []
		internal scratch TokenBuffer = new TokenBuffer()

		// `spacing` is how many bytes lie between two checkpoints.
		def new(spacing int = 1 << 14) {
			self.spacing = spacing.max(1)
		}

		// How many checkpoints it holds.
		def count() int {
			return offsets.len()
		}

		// Starts over for a line whose text starts at `from` in `state`.
		def reset(from int, state int) {
			offsets.len(0)
			states.len(0)
			offsets.push(from)
			states.push(state)
		}

		// Forgets what an edit at byte `at` changed: the checkpoints after it.
		def forget(at int) {
			let keep = offsets.len()
			for keep > 1 && offsets[keep - 1] > at {
				keep--
			}
			offsets.len(keep)
			states.len(keep)
		}

		// Scans what lies in `from` to `to` of the line that ends at `end`, adding its tokens
		// to `out`, from the nearest checkpoint before `from`. What lies between the last
		// checkpoint and `from` is scanned to reach it and leaves more checkpoints; `budget`
		// bounds that work per call (negative: no bound), and then `done` is false and a
		// later call goes on where this one stopped. Tokens may start before `from` and end
		// after `to`. Call `reset` first.
		def visible(scanner Scanner, raw byte[], from int, to int, end int, out TokenBuffer, budget int = -1) ScanStop {
			let spent = 0
			for offsets[offsets.len() - 1] + spacing <= from {
				let at = offsets[offsets.len() - 1]
				let pause = at + spacing
				scratch.clear()
				let left = budget < 0 ?? (-1, (budget - spent).max(1))
				let stop = scanner.scan(raw, at, end, states[states.len() - 1], scratch, left, pause)
				spent += stop.at - at
				if stop.done {
					break
				}
				if stop.at > at {
					offsets.push(stop.at)
					states.push(stop.state)
				}
				return ScanStop{at: stop.at, state: stop.state, done: false} when budget >= 0 && spent >= budget
			}
			let near = offsets.len() - 1
			for near > 0 && offsets[near] > from {
				near--
			}
			return scanner.scan(raw, offsets[near], end, states[near], out, -1, to)
		}
	}
}
