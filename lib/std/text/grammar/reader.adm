internal partial module std.text.grammar.engine {
	// The most states a grammar may have, as a state table packs the number.
	const maxGrammarStates = 4096

	// A rule of the source before `include`s are spliced in.
	struct RawRule {
		fields map<string, any>
		site   string
	}

	// Reads the tree of a grammar's source.
	type Reader {
		source     map<string, any>
		lines      map<string, int[]>
		maxProgram int
		grammar    GrammarCore        = new GrammarCore()
		raw        map<string, any[]> = map<string, any[]>{}

		def new(source map<string, any>, lines map<string, int[]>, maxProgram int) {
			self.source = source
			self.lines = lines
			self.maxProgram = maxProgram
		}

		def read() !GrammarCore {
			let g = grammar
			let name = source.get("name")
			fail "grammar: `name` must be a string" unless name is string
			g.grammarName = name
			try readKinds()
			let table = source.get("states")
			fail "{name}: `states` must hold the rules of each state" unless table is map<string, any>
			for let (state, rules) in table {
				fail "{name}: state {state} must be a list of rules" unless rules is any[]
				raw[state] = rules
				g.stateIndex[state] = g.states.len()
				g.states.push(new State(state, new RegexRules([])))
			}
			fail "{name}: more than {maxGrammarStates} states" when g.states.len() > maxGrammarStates
			let start = source.get("start")
			fail "{name}: `start` must name a state" unless start is string && g.stateIndex.hasKey(start)
			g.first = g.stateIndex[start]
			let folding = source.get("folding")
			if folding is string {
				fail "{name}: `folding` is \"indent\" or left out, not \"{folding}\"" unless folding == "indent"
				g.foldBy = folding
			}
			try readRoles()
			for let (_, state) in g.states {
				try readState(state)
			}
			try readDefaults()
			return g
		}

		def readKinds() !none {
			let kinds = source.get("kinds")
			fail "{grammar.grammarName}: `kinds` must list the kinds' names" unless kinds is any[]
			for let (_, kind) in kinds {
				fail "{grammar.grammarName}: a kind must be a string" unless kind is string
				fail "{grammar.grammarName}: kind {kind} is listed twice" when grammar.kindIndex.hasKey(kind)
				grammar.kindIndex[kind] = grammar.kindNames.len()
				grammar.kindNames.push(kind)
			}
			return none
		}

		def readRoles() !none {
			let roles = source.get("roles")
			return none when roles is none
			fail "{grammar.grammarName}: `roles` must map roles to kinds" unless roles is map<string, any>
			for let (role, kinds) in roles {
				fail "{grammar.grammarName}: role {role} must list kinds" unless kinds is any[]
				let held int[]
				for let (_, kind) in kinds {
					fail "{grammar.grammarName}: role {role} names an unknown kind" unless kind is string && grammar.kindIndex.hasKey(kind)
					held.push(grammar.kindIndex[kind])
				}
				grammar.roles[role] = held
			}
			return none
		}

		def readDefaults() !none {
			let defaults = source.get("defaults")
			return none when defaults is none
			fail "{grammar.grammarName}: `defaults` must map states to kinds" unless defaults is map<string, any>
			for let (state, kind) in defaults {
				fail "{grammar.grammarName}: `defaults` names unknown state {state}" unless grammar.stateIndex.hasKey(state)
				fail "{grammar.grammarName}: `defaults` of {state} names an unknown kind" unless kind is string && grammar.kindIndex.hasKey(kind)
				grammar.states[grammar.stateIndex[state]].fallback = grammar.kindIndex[kind]
			}
			return none
		}

		// A place in the source, for messages.
		def place(state string, at int) string {
			let held = lines.get(state)
			let line = !(held is none) && at < held.len() ?? (" (line {held[at]})", "")
			return "{grammar.grammarName}: state {state}, rule {at}{line}"
		}

		// The rules of a state with its `include`s spliced in, in order.
		def splice(state string, within string[], out RawRule[]) !none {
			expects {
				assert !(within.includes(state)) onerror fail "{grammar.grammarName}: state {state} includes itself"
			}
			within.push(state)
			let items = raw.get(state)
			return none when items is none
			for let (at, item) in items {
				let site = place(state, at)
				fail "{site}: a rule must be a table" unless item is map<string, any>
				let included = item.get("include")
				if !(included is none) {
					fail "{site}: `include` must name a state" unless included is string && raw.hasKey(included)
					try splice(included, within, out)
					continue
				}
				out.push(RawRule{fields: item, site: site})
			}
			within.pop()
			return none
		}

		def readState(state State) !none {
			let items RawRule[]
			try splice(state.name, [], items)
			let patterns string[]
			for let (_, item) in items {
				let pattern = item.fields.get("match")
				fail "{item.site}: `match` must be a pattern" unless pattern is string
				patterns.push(pattern)
			}
			let caseless = source.get("ignoreCase")
			let flags = caseless is bool && caseless ?? ("mi", "m")
			state.rules = new RegexRules(patterns, flags, maxProgram)
			fail "{grammar.grammarName}: state {state.name}: {state.rules.failure()}" unless state.rules.valid()
			for let (i, item) in items {
				let rule = try readRule(item, patterns[i], flags)
				rule.after = new RegexRules(patterns[i + 1:], flags, maxProgram) when rule.guard.any() && i + 1 < patterns.len()
				state.table.push(rule)
			}
			return none
		}

		def stateNamed(item RawRule, field string) !int {
			let named = item.fields.get(field)
			return -1 when named is none
			fail "{item.site}: `{field}` must name a state" unless named is string && grammar.stateIndex.hasKey(named)
			return grammar.stateIndex[named]
		}

		def kindNamed(site string, value any) !int {
			fail "{site}: `{value}` is not a kind of the grammar" unless value is string && grammar.kindIndex.hasKey(value)
			return grammar.kindIndex[value]
		}

		def labelNamed(site string, value any) !int {
			fail "{site}: a block label must be a string" unless value is string
			if !grammar.labelIndex.hasKey(value) {
				grammar.labelIndex[value] = grammar.labelNames.len()
				grammar.labelNames.push(value)
			}
			return grammar.labelIndex[value]
		}

		def keepNamed(name string) int {
			if !grammar.keepIndex.hasKey(name) {
				grammar.keepIndex[name] = grammar.keepNames.len()
				grammar.keepNames.push(name)
			}
			return grammar.keepIndex[name]
		}

		// Reads `same = { name = group }` and `atLeast = { name = group }` of a table.
		def readGuard(site string, fields map<string, any>, groups int, into Guard) !none {
			try readGuardField(site, fields, "same", groups, into.equalNames, into.equalGroups)
			try readGuardField(site, fields, "atLeast", groups, into.atLeastNames, into.atLeastGroups)
			return none
		}

		def readGuardField(site string, fields map<string, any>, field string, groups int, names int[], targets int[]) !none {
			let table = fields.get(field)
			return none when table is none
			fail "{site}: `{field}` must map kept values to groups" unless table is map<string, any>
			for let (name, group) in table {
				fail "{site}: `{field}` of {name} must be a group of the pattern" unless group is int && group >= 1 && group <= groups
				names.push(keepNamed(name))
				targets.push(group)
			}
			return none
		}

		def readRule(item RawRule, pattern string, flags string) !Rule {
			let (fields, site) = (item.fields, item.site)
			let rule = new Rule()
			rule.name = site
			let own = new RegexRules([pattern], flags, maxProgram)
			let groups = own.groups(0)
			let kind = fields.get("kind")
			rule.kind = try kindNamed(site, kind) unless kind is none
			let kinds = fields.get("kinds")
			if !(kinds is none) {
				fail "{site}: `kinds` must list a kind per group" unless kinds is any[]
				fail "{site}: `kinds` lists {kinds.len()}, the pattern has {groups} groups" unless kinds.len() <= groups
				for let (_, one) in kinds {
					if one is string && one == "" {
						rule.groupKinds.push(-1)
					} else {
						rule.groupKinds.push(try kindNamed(site, one))
					}
				}
			}
			let pop = fields.get("pop")
			if pop is bool {
				rule.pop = pop ?? (1, 0)
			} else if pop is int {
				rule.pop = pop
			} else if !(pop is none) {
				fail "{site}: `pop` must be true or a count"
			}
			rule.push = try stateNamed(item, "push")
			rule.next = try stateNamed(item, "goto")
			let keep = fields.get("keep")
			if !(keep is none) {
				fail "{site}: `keep` must map names to groups" unless keep is map<string, any>
				for let (name, group) in keep {
					fail "{site}: `keep` of {name} must be a group of the pattern" unless group is int && group >= 1 && group <= groups
					rule.keepNames.push(keepNamed(name))
					rule.keepGroups.push(group)
				}
			}
			try readGuard(site, fields, groups, rule.guard)
			try readEmbed(item, rule, groups, flags)
			fail "{site}: `keep` needs a `push`, `goto` or `embed` to keep it in" when rule.keepNames.len() > 0 && rule.push < 0 && rule.next < 0 && rule.embedGroup < 0 && rule.embedName == ""
			let opens = fields.get("open")
			rule.opens = try labelNamed(site, opens) unless opens is none
			let closes = fields.get("close")
			rule.closes = try labelNamed(site, closes) unless closes is none
			rule.readsGroups = rule.groupKinds.len() > 0 || rule.keepNames.len() > 0 || rule.guard.any() || rule.embedGroup >= 0
			rule.acts = rule.pop > 0 || rule.push >= 0 || rule.next >= 0 || rule.embedGroup >= 0 || rule.embedName != ""
			fail "{site}: `{pattern}` matches nothing and the rule changes no state" when !rule.acts && !rule.guard.any() && rule.opens < 0 && rule.closes < 0 && matchesNothingWithinLine(own)
			return rule
		}

		// Whether the pattern can match nothing where the line goes on: the scan would stop
		// there, with the rest of the line unread. A match of nothing at the end of a line
		// ends the line as it would have ended, and lets a blank line stay in its state ahead
		// of a later rule that matches nothing to leave it. What matches at a place depends
		// only on the assertions there, which one byte of text after the place decides.
		def matchesNothingWithinLine(pattern RegexRules) bool {
			let probe = pattern.searcher()
			let text byte[]
			text.len(1)
			for let b = 0; b < 256; b++ {
				continue when b == 10
				text[0] = byte(b)
				return true when probe.search(text, anchored = true) && probe.end() == 0
			}
			return false
		}

		def readEmbed(item RawRule, rule Rule, groups int, flags string) !none {
			let (fields, site) = (item.fields, item.site)
			let embed = fields.get("embed")
			let closing = fields.get("until")
			return none when embed is none && closing is none
			fail "{site}: `embed` and `until` go together" when embed is none || closing is none
			if embed is string {
				rule.embedName = embed
			} else if embed is map<string, any> {
				let group = embed.get("group")
				fail "{site}: `embed` takes the name from a group of the pattern" unless group is int && group >= 1 && group <= groups
				rule.embedGroup = group
			} else {
				fail "{site}: `embed` is a language's name or `\{ group = n }`"
			}
			let table map<string, any> = map<string, any>{}
			if closing is string {
				table["match"] = closing
			} else if closing is map<string, any> {
				table = closing
			} else {
				fail "{site}: `until` is a pattern or a table with `match`"
			}
			let pattern = table.get("match")
			fail "{site}: `until` must have a pattern" unless pattern is string
			let rules = new RegexRules([pattern], flags, maxProgram)
			fail "{site}: `until`: {rules.failure()}" unless rules.valid()
			let made = new Closing(rules)
			made.groups = rules.groups(0)
			let kind = table.get("kind")
			made.kind = try kindNamed(site, kind) unless kind is none
			try readGuard(site, table, made.groups, made.guard)
			let escape = table.get("notEscapedBy")
			if !(escape is none) {
				let one = escape is string ?? (escape.bytes(), byte[])
				fail "{site}: `notEscapedBy` is one ASCII character" unless one.len() == 1 && int(one[0]) < 128
				made.escape = int(one[0])
			}
			rule.closing = grammar.closings.len()
			grammar.closings.push(made)
			return none
		}
	}
}
