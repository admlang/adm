// Internationalized domain names: UTS #46 processing (the mapping browsers
// and resolvers apply, Unicode 18) over IDNA2008 (RFC 5890–5893): toASCII
// and toUnicode, Punycode (RFC 3492), the Bidi rule and the contextual rules
// of IDNA2008, and its registration rules when strict.
//
//     let host = try idna.toASCII("Bücher.example")   // xn--bcher-kva.example
//     let shown = try idna.toUnicode(host)             // bücher.example
partial module std.text.idna {
	use (
		std.errors
		std.text.unicode
		std.text.unicode::(BidiClass, Category, HangulSyllableType, JoiningType, NormalForm)
		std.text.idna.tables
	)

	// How a domain name is processed (UTS #46 §4). The defaults are the
	// flags of a resolver; `strict` adds IDNA2008's registration rules.
	struct IDNAOptions {
		// Refuse `--` in the third and fourth places and a leading or
		// trailing `-`.
		checkHyphens          bool = true
		// Apply the Bidi rule (RFC 5893) to the labels of a domain name that
		// holds right-to-left text.
		checkBidi             bool = true
		// Apply the CONTEXTJ rules of the joiners (RFC 5892 A.1, A.2).
		checkJoiners          bool = true
		// Allow only letters, digits and `-` of ASCII.
		useSTD3ASCIIRules     bool = true
		// Refuse names over 253 octets and labels over 63 or empty (toASCII).
		verifyDnsLength       bool = true
		// Keep a label whose Punycode does not decode instead of failing.
		ignoreInvalidPunycode bool = false
		// IDNA2008 registration: every code point PVALID, or CONTEXTJ or
		// CONTEXTO with its rule met (RFC 5891 §5.4, RFC 5892), as a
		// registry or a validator of host names applies them.
		strict                bool = false
	}

	// Why a domain name failed: the first problem, with its UTS #46 status
	// code (`V6`, `B1`, `C2`, `P4`, `A4_2`, ...) and the label at fault.
	struct IDNAError {
		message string
		code    string
		cause   ?error
		stack   errors.StackTrace
		label   string = ""
	}

	// The A-label form of a domain name: mapped (UTS #46), normalized,
	// checked label by label, each non-ASCII label as `xn--` and its
	// Punycode. Fails with an IDNAError for the first problem.
	def toASCII(domain string, options IDNAOptions = IDNAOptions{}) !string {
		let (labels, problems) = process(domain, options)
		fail problems[0] when problems.len() > 0
		let out string[] = []
		for let label in labels {
			if isASCII(label) {
				out.push(label)
				continue
			}
			let encoded = punycodeEncode(label) onerror (err error) {
				fail idnaError("A3", label, "the label cannot be written in Punycode: {err.message}")
			}
			out.push("xn--" + encoded)
		}
		if options.verifyDnsLength {
			let total = out.join(".")
			fail idnaError("A4_1", total, "the domain name is {total.len()} octets, more than 253") when total.len() > 253
			fail idnaError("A4_1", total, "the domain name is empty") when total.len() == 0
			for let label in out {
				fail idnaError("A4_2", label, label == "" ?? ("the domain name has an empty label", "the label {label} is {label.len()} octets, more than 63")) when label.len() == 0 || label.len() > 63
			}
		}
		return out.join(".")
	}

	// The Unicode form of a domain name: mapped, normalized and with its
	// A-labels decoded. Fails with an IDNAError for the first problem.
	def toUnicode(domain string, options IDNAOptions = IDNAOptions{}) !string {
		let (labels, problems) = process(domain, options)
		fail problems[0] when problems.len() > 0
		return labels.join(".")
	}

	// The labels of a domain name after UTS #46 processing (Map, Normalize,
	// Break, Convert/Validate), and the problems found.
	internal def process(domain string, options IDNAOptions) (string[], IDNAError[]) {
		let problems IDNAError[] = []
		let mapped byte[] = []
		for let ch in unicode.codePoints(domain) {
			let (status, mapping) = statusOf(ch)
			switch status {
				case statusIgnored:
				case statusMapped:
					mapped += mapping.bytes()
				default:
					mapped += string(ch).bytes()
			}
		}
		let normalized = unicode.normalize(string(mapped), NormalForm.NFC)
		let labels = normalized.split(".")
		let out string[] = []
		let unicodeLabels string[] = []
		for let label in labels {
			let text = label
			if label.lower().startsWith("xn--") && label.len() > 4 {
				if !isASCII(label) {
					problems.push(idnaError("P4", label, "the A-label {label} holds non-ASCII text"))
					out.push(label)
					unicodeLabels.push(label)
					continue
				}
				let decoded = punycodeDecode(label[4:]) onerror (err error) {
					problems.push(idnaError("P4", label, "the Punycode of {label} does not decode: {err.message}")) unless options.ignoreInvalidPunycode
					recover ""
				}
				if decoded == "" {
					out.push(label)
					unicodeLabels.push(label)
					continue
				}
				problems.push(idnaError("P4", label, "the A-label {label} decodes to ASCII only")) when isASCII(decoded)
				text = decoded
				validateLabel(text, options, problems)
			} else if label.lower() == "xn--" {
				problems.push(idnaError("P4", label, "the A-label xn-- is empty"))
			} else {
				validateLabel(text, options, problems)
			}
			out.push(text)
			unicodeLabels.push(text)
		}
		if options.checkBidi && isBidiDomain(unicodeLabels) {
			for let label in unicodeLabels {
				continue when label == ""
				let problem = bidiProblem(label)
				problems.push(problem) unless problem is none
			}
		}
		return (out, problems)
	}

	// The validity criteria of UTS #46 §4.1 (and IDNA2008's when strict).
	internal def validateLabel(label string, options IDNAOptions, problems IDNAError[]) {
		return when label == ""
		let chars = unicode.codePoints(label)
		problems.push(idnaError("V1", label, "the label {label} is not in NFC")) when unicode.normalize(label, NormalForm.NFC) != label
		if options.checkHyphens {
			problems.push(idnaError("V2", label, "the label {label} has -- in its third and fourth places")) when chars.len() >= 4 && chars[2] == '-' && chars[3] == '-'
			problems.push(idnaError("V3", label, "the label {label} starts or ends with -")) when chars[0] == '-' || chars[chars.len() - 1] == '-'
		} else if label.lower().startsWith("xn--") {
			problems.push(idnaError("V4", label, "the label {label} starts with xn--"))
		}
		if unicode.category(chars[0]) := Category.NonspacingMark || Category.SpacingMark || Category.EnclosingMark {
			problems.push(idnaError("V6", label, "the label {label} starts with a combining mark"))
		}
		for let (i, ch) in chars {
			let (status, _) = statusOf(ch)
			let cp = int(ch)
			if ch == '.' {
				problems.push(idnaError("V5", label, "the label {label} holds a full stop"))
			} else if !(status := statusValid || statusDeviation) {
				problems.push(idnaError("V7", label, "U+{hex(cp)} is not allowed in a domain name"))
			} else if options.useSTD3ASCIIRules && cp < 0x80 && !((cp >= 0x61 && cp <= 0x7A) || (cp >= 0x30 && cp <= 0x39) || cp == 0x2D) {
				problems.push(idnaError("U1", label, "U+{hex(cp)} is not a letter, digit or - of ASCII"))
			} else if options.checkJoiners && cp == 0x200C && !allowedInContext(chars, i) {
				problems.push(idnaError("C1", label, "ZERO WIDTH NON-JOINER is not allowed here in {label}"))
			} else if options.checkJoiners && cp == 0x200D && !allowedInContext(chars, i) {
				problems.push(idnaError("C2", label, "ZERO WIDTH JOINER is not allowed here in {label}"))
			} else if options.strict {
				let property = derivedProperty(ch)
				if property == DerivedProperty.ContextO || property == DerivedProperty.ContextJ {
					problems.push(idnaError("C3", label, "U+{hex(cp)} is not allowed here in {label}")) unless allowedInContext(chars, i)
				} else if property != DerivedProperty.PValid {
					problems.push(idnaError("V8", label, "U+{hex(cp)} is {property.name} in IDNA2008"))
				}
			}
		}
	}

	// The statuses in the low 3 bits of `tables.rangeCodes`; 4 is disallowed.
	internal const statusValid = 0
	internal const statusIgnored = 1
	internal const statusMapped = 2
	internal const statusDeviation = 3

	// The UTS #46 status of a code point and its mapping.
	internal def statusOf(ch char) (int, string) {
		let cp = int(ch)
		let starts = tables.rangeStarts
		let lo = 0
		let hi = starts.len() - 1
		for lo < hi {
			let mid = (lo + hi + 1) / 2
			if starts[mid] <= cp {
				lo = mid
			} else {
				hi = mid - 1
			}
		}
		let code = tables.rangeCodes[lo]
		let mapping = code >> 3
		return (code & 7, mapping == 0 ?? ("", tables.mappings[mapping - 1]))
	}

	// The IDNA2008 derived property of a code point (RFC 5892 §3).
	enum DerivedProperty {
		PValid,
		ContextJ,
		ContextO,
		Disallowed,
		Unassigned,
	}

	// The IDNA2008 exceptions (RFC 5892 §2.6): PVALID, then CONTEXTO, then
	// DISALLOWED.
	internal const exceptionPoints = [0x00DF, 0x03C2, 0x06FD, 0x06FE, 0x0F0B, 0x3007, 0x00B7, 0x0375, 0x05F3, 0x05F4, 0x30FB, 0x0660, 0x0661, 0x0662, 0x0663, 0x0664, 0x0665, 0x0666, 0x0667, 0x0668, 0x0669, 0x06F0, 0x06F1, 0x06F2, 0x06F3, 0x06F4, 0x06F5, 0x06F6, 0x06F7, 0x06F8, 0x06F9, 0x0640, 0x07FA, 0x302E, 0x302F, 0x3031, 0x3032, 0x3033, 0x3034, 0x3035, 0x303B]
	internal const exceptionsValid = 6
	internal const exceptionsContext = 31

	// The White_Space code points (PropList.txt).
	internal const whiteSpace = [0x0009, 0x000A, 0x000B, 0x000C, 0x000D, 0x0020, 0x0085, 0x00A0, 0x1680, 0x2000, 0x2001, 0x2002, 0x2003, 0x2004, 0x2005, 0x2006, 0x2007, 0x2008, 0x2009, 0x200A, 0x2028, 0x2029, 0x202F, 0x205F, 0x3000]

	// The derived property of a code point by the algorithm of RFC 5892
	// §3, over std.text.unicode's data.
	def derivedProperty(ch char) DerivedProperty {
		let cp = int(ch)
		for let (i, point) in exceptionPoints {
			continue unless point == cp
			return DerivedProperty.PValid when i < exceptionsValid
			return DerivedProperty.ContextO when i < exceptionsContext
			return DerivedProperty.Disallowed
		}
		let category = unicode.category(ch)
		return DerivedProperty.Unassigned when category == Category.Unassigned && !unicode.isNoncharacter(ch)
		return DerivedProperty.PValid when (cp >= 0x61 && cp <= 0x7A) || (cp >= 0x30 && cp <= 0x39) || cp == 0x2D
		return DerivedProperty.ContextJ when cp := 0x200C || 0x200D
		return DerivedProperty.Disallowed when unicode.hangulSyllableType(ch) := HangulSyllableType.LeadingJamo || HangulSyllableType.VowelJamo || HangulSyllableType.TrailingJamo
		let text = string(ch)
		let stable = unicode.normalize(unicode.caseFold(unicode.normalize(text, NormalForm.NFKC)), NormalForm.NFKC)
		return DerivedProperty.Disallowed when stable != text
		return DerivedProperty.Disallowed when unicode.isDefaultIgnorable(ch) || unicode.isNoncharacter(ch) || whiteSpace.includes(cp)
		return DerivedProperty.Disallowed when (cp >= 0x20D0 && cp <= 0x20FF) || (cp >= 0x1D100 && cp <= 0x1D24F)
		return DerivedProperty.PValid when category := Category.LowercaseLetter || Category.UppercaseLetter || Category.OtherLetter || Category.DecimalNumber || Category.ModifierLetter || Category.NonspacingMark || Category.SpacingMark
		return DerivedProperty.Disallowed
	}

	// Whether the code point at i meets its contextual rule (RFC 5892
	// Appendix A); false for one without a rule.
	def allowedInContext(chars char[], i int) bool {
		let cp = int(chars[i])
		let before = i > 0 ?? (int(chars[i - 1]), -1)
		let after = i + 1 < chars.len() ?? (int(chars[i + 1]), -1)
		switch {
			case cp == 0x200C:
				return true when before >= 0 && unicode.combiningClass(char(before)) == 9
				return joinerBetweenJoiningLetters(chars, i)
			case cp == 0x200D:
				return before >= 0 && unicode.combiningClass(char(before)) == 9
			case cp == 0x00B7:
				return before == 0x6C && after == 0x6C
			case cp == 0x0375:
				return after >= 0 && unicode.script(char(after)) == "Grek"
			case cp := 0x05F3 || 0x05F4:
				return before >= 0 && unicode.script(char(before)) == "Hebr"
			case cp == 0x30FB:
				for let (_, ch) in chars {
					continue when int(ch) == 0x30FB
					return true when unicode.script(ch) := "Hira" || "Kana" || "Hani"
				}
				return false
			case cp >= 0x0660 && cp <= 0x0669:
				for let (_, ch) in chars {
					return false when int(ch) >= 0x06F0 && int(ch) <= 0x06F9
				}
				return true
			case cp >= 0x06F0 && cp <= 0x06F9:
				for let (_, ch) in chars {
					return false when int(ch) >= 0x0660 && int(ch) <= 0x0669
				}
				return true
		}
		return false
	}

	// The second ZERO WIDTH NON-JOINER rule: (Joining_Type L or D) T*
	// U+200C T* (Joining_Type R or D).
	internal def joinerBetweenJoiningLetters(chars char[], i int) bool {
		let left = false
		for let j = i - 1; j >= 0; j-- {
			let t = unicode.joiningType(chars[j])
			continue when t == JoiningType.Transparent
			left = t := JoiningType.LeftJoining || JoiningType.DualJoining
			break
		}
		return false unless left
		for let j = i + 1; j < chars.len(); j++ {
			let t = unicode.joiningType(chars[j])
			continue when t == JoiningType.Transparent
			return t := JoiningType.RightJoining || JoiningType.DualJoining
		}
		return false
	}

	// Whether a domain name is a Bidi domain name (RFC 5893 §1.4): one with
	// a code point of bidi class R, AL or AN.
	internal def isBidiDomain(labels string[]) bool {
		for let label in labels {
			for let ch in unicode.codePoints(label) {
				return true when unicode.bidiClass(ch) := BidiClass.R || BidiClass.AL || BidiClass.AN
			}
		}
		return false
	}

	// Applies the Bidi rule of RFC 5893 §2 to a label of a Bidi domain name
	// (every label of it, whatever its own direction). Fails with an
	// IDNAError naming the condition (B1–B6) the label breaks.
	def bidiRule(label string) !none {
		let problem = bidiProblem(label)
		fail problem unless problem is none
		return none
	}

	internal def bidiProblem(label string) ?IDNAError {
		let classes = unicode.codePoints(label).mapElem(ch => unicode.bidiClass(ch))
		return none when classes.len() == 0
		let first = classes[0]
		return idnaError("B1", label, "text in a right-to-left domain name must start with a strong character") unless first := BidiClass.L || BidiClass.R || BidiClass.AL
		let end = classes.len() - 1
		for end > 0 && classes[end] == BidiClass.NSM {
			end--
		}
		let last = classes[end]
		if first == BidiClass.L {
			for let c in classes {
				return idnaError("B5", label, "left-to-right text holds a character of bidi class {c.name}") unless c := BidiClass.L || BidiClass.EN || BidiClass.ES || BidiClass.CS || BidiClass.ET || BidiClass.ON || BidiClass.BN || BidiClass.NSM
			}
			return idnaError("B6", label, "left-to-right text must end with L or EN") unless last := BidiClass.L || BidiClass.EN
			return none
		}
		let european = false
		let arabic = false
		for let c in classes {
			return idnaError("B2", label, "right-to-left text holds a character of bidi class {c.name}") unless c := BidiClass.R || BidiClass.AL || BidiClass.AN || BidiClass.EN || BidiClass.ES || BidiClass.CS || BidiClass.ET || BidiClass.ON || BidiClass.BN || BidiClass.NSM
			european = true when c == BidiClass.EN
			arabic = true when c == BidiClass.AN
		}
		return idnaError("B3", label, "right-to-left text must end with R, AL, EN or AN") unless last := BidiClass.R || BidiClass.AL || BidiClass.EN || BidiClass.AN
		return idnaError("B4", label, "right-to-left text mixes European and Arabic digits") when european && arabic
		return none
	}

	internal const punyBase = 36
	internal const punyTMin = 1
	internal const punyTMax = 26
	internal const punySkew = 38
	internal const punyDamp = 700
	internal const punyInitialBias = 72
	internal const punyInitialN = 128
	internal const punyLimit = 0x7FFFFFFF

	// Punycode (RFC 3492) of a text: its ASCII code points, `-` when there
	// are any, then the others as base-36 deltas. Fails on a value too large
	// to encode.
	def punycodeEncode(text string) !string {
		let input = unicode.codePoints(text).mapElem(c => int(c))
		let out byte[] = []
		for let cp in input {
			out.push(byte(cp)) when cp < 0x80
		}
		let basic = out.len()
		let handled = basic
		out.push(0x2D) when basic > 0
		let n = punyInitialN
		let delta = 0
		let bias = punyInitialBias
		for handled < input.len() {
			let m = punyLimit
			for let cp in input {
				m = cp when cp >= n && cp < m
			}
			fail idnaError("A3", text, "the text is too long for Punycode") when m - n > (punyLimit - delta) / (handled + 1)
			delta += (m - n) * (handled + 1)
			n = m
			for let cp in input {
				if cp < n {
					delta++
					fail idnaError("A3", text, "the text is too long for Punycode") when delta > punyLimit
				}
				if cp == n {
					let q = delta
					let k = punyBase
					for {
						let t = k <= bias ?? (punyTMin, k >= bias + punyTMax ?? (punyTMax, k - bias))
						break when q < t
						out.push(punyDigit(t + (q - t) % (punyBase - t)))
						q = (q - t) / (punyBase - t)
						k += punyBase
					}
					out.push(punyDigit(q))
					bias = punyAdapt(delta, handled + 1, handled == basic)
					delta = 0
					handled++
				}
			}
			delta++
			n++
		}
		return string(out)
	}

	// The text a Punycode string encodes. Fails on a character that is not
	// a Punycode digit, an overflow, or a code point that is not a Unicode
	// scalar value.
	def punycodeDecode(text string) !string {
		let input = text.bytes()
		let output int[] = []
		let delimiter = -1
		for let (i, b) in input {
			delimiter = i when b == 0x2D
		}
		if delimiter > 0 {
			for let i = 0; i < delimiter; i++ {
				fail idnaError("P4", text, "Punycode holds a non-ASCII character") when input[i] >= 0x80
				output.push(int(input[i]))
			}
		}
		let n = punyInitialN
		let i = 0
		let bias = punyInitialBias
		let at = delimiter > 0 ?? (delimiter + 1, 0)
		for at < input.len() {
			let old = i
			let w = 1
			let k = punyBase
			for {
				fail idnaError("P4", text, "Punycode ends in the middle of a number") when at >= input.len()
				let digit = punyValue(input[at])
				at++
				fail idnaError("P4", text, "\"{string(input[at - 1:at])}\" is not a Punycode digit") when digit < 0
				fail idnaError("P4", text, "Punycode overflows") when digit > (punyLimit - i) / w
				i += digit * w
				let t = k <= bias ?? (punyTMin, k >= bias + punyTMax ?? (punyTMax, k - bias))
				break when digit < t
				fail idnaError("P4", text, "Punycode overflows") when w > punyLimit / (punyBase - t)
				w *= punyBase - t
				k += punyBase
			}
			bias = punyAdapt(i - old, output.len() + 1, old == 0)
			fail idnaError("P4", text, "Punycode overflows") when i / (output.len() + 1) > punyLimit - n
			n += i / (output.len() + 1)
			i = i % (output.len() + 1)
			fail idnaError("P4", text, "Punycode decodes to U+{hex(n)}, not a character") unless (n >= 0x80 && n <= 0xD7FF) || (n >= 0xE000 && n <= 0x10FFFF)
			output.push(0)
			for let j = output.len() - 1; j > i; j-- {
				output[j] = output[j - 1]
			}
			output[i] = n
			i++
		}
		let out byte[] = []
		for let c in output {
			out += string(char(c)).bytes()
		}
		return string(out)
	}

	internal def punyAdapt(delta int, points int, first bool) int {
		let d = first ?? (delta / punyDamp, delta / 2)
		d += d / points
		let k = 0
		for d > ((punyBase - punyTMin) * punyTMax) / 2 {
			d /= punyBase - punyTMin
			k += punyBase
		}
		return k + (punyBase - punyTMin + 1) * d / (d + punySkew)
	}

	internal def punyDigit(d int) byte {
		return byte(d < 26 ?? (d + 0x61, d - 26 + 0x30))
	}

	internal def punyValue(b byte) int {
		return int(b) - 0x30 + 26 when b >= 0x30 && b <= 0x39
		return int(b) - 0x41 when b >= 0x41 && b <= 0x5A
		return int(b) - 0x61 when b >= 0x61 && b <= 0x7A
		return -1
	}

	internal def isASCII(text string) bool {
		for let b in text.bytes() {
			return false when b >= 0x80
		}
		return true
	}

	internal def hex(cp int) string {
		return "%04X".format(cp)
	}

	internal def idnaError(code string, label string, message string) IDNAError {
		return IDNAError{message: "idna: {message}", code: code, label: label}
	}
}
