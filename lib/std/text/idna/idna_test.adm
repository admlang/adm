partial module std.text.idna {
	use std.testing

	// The sample strings of RFC 3492 §7.1 and their Punycode.
	internal const punycodeSamples = [
		("ليهمابتكلموشعربي؟", "egbpdaj6bu4bxfgehfvwxn"),
		("他们为什么不说中文", "ihqwcrb4cv8a8dqg056pqjye"),
		("他們爲什麽不說中文", "ihqwctvzc91f659drss3x8bo0yb"),
		("Pročprostěnemluvíčesky", "Proprostnemluvesky-uyb24dma41a"),
		("למההםפשוטלאמדבריםעברית", "4dbcagdahymbxekheh6e0a7fei0b"),
		("यहलोगहिंदीक्योंनहींबोलसकतेहैं", "i1baaa6gcj3inw9b2ae1bj0hfcgg6iyaf8o0a1dig3c"),
		("なぜみんな日本語を話してくれないのか", "n8jok5ay5dzabd5bym9f0cm5685rrjetr6pdxa"),
		("세계의모든사람들이한국어를이해한다면얼마나좋을까", "989aomsvi5e83db1d2a355cv1e0vak1dwrv93d5xbh15a0dt30a5jpsd879ccm6fea98c"),
		("почемужеонинеговорятпорусски", "b1abfaaepdrnnbgefbadotcwatmq2g4l"),
		("PorquénopuedensimplementehablarenEspañol", "PorqunopuedensimplementehablarenEspaol-fmd56a"),
		("TạisaohọkhôngthểchỉnóitiếngViệt", "TisaohkhngthchnitingVit-kjcr8268qyxafd2f1b9g"),
		("3年B組金八先生", "3B-ww4c5e180e575a65lsy2b"),
		("安室奈美恵-with-SUPER-MONKEYS", "-with-SUPER-MONKEYS-pc58ag80a8qai00g7n9n"),
		("Hello-Another-Way-それぞれの場所", "Hello-Another-Way--fc4qua05auwb3674vfr0b"),
		("ひとつ屋根の下2", "2-u9tlzr9756bt3uc0v"),
		("MajiでKoiする5秒前", "MajiKoi5-783gue6qz075azm5e"),
		("パフィーdeルンバ", "de-jg4avhby1noc0d"),
		("そのスピードで", "d9juau41awczczp"),
		("-> $1.00 <-", "-> $1.00 <--"),
	]

	// The code of the error a domain name fails toASCII with, "" when it
	// passes.
	internal def asciiError(domain string, options IDNAOptions = IDNAOptions{}) string {
		let code = ""
		toASCII(domain, options) onerror (err error) {
			code = err is IDNAError ?? (err.code, "?")
			recover ""
		}
		return code
	}

	check "IDNA" {
		// RFC 3492's samples both ways; Punycode that does not decode fails.
		@test()
		def codesPunycode() !none {
			for let sample in punycodeSamples {
				let (text, encoded) = sample
				assert (try punycodeEncode(text)).lower() == encoded.lower()
				assert (try punycodeDecode(encoded)) == text
			}
			assert punycodeDecode("X") is error
			assert punycodeDecode("a-é") is error
			assert punycodeDecode("99999999999") is error
			return none
		}

		// UTS #46 processing, as lines of IdnaTestV2 (Unicode 18) give it:
		// deviation characters kept, mapping, A-labels decoded, the joiner,
		// hyphen, mark, STD3, Bidi and length rules.
		@test()
		def processesAsUts46() !none {
			assert (try toASCII("fass.de")) == "fass.de"
			assert (try toASCII("faß.de")) == "xn--fa-hia.de"
			assert (try toASCII("Faß.de")) == "xn--fa-hia.de"
			assert (try toUnicode("xn--fa-hia.de")) == "faß.de"
			assert (try toASCII("à.א̈")) == "xn--0ca.xn--ssa73l"
			assert (try toASCII("Bücher.example")) == "xn--bcher-kva.example"
			assert (try toASCII("ＥＸＡＭＰＬＥ。com")) == "example.com"
			assert (try toUnicode("a\u200Bb.com")) == "ab.com" && (try toUnicode("a\u00ADb.com")) == "ab.com"
			assert asciiError("xn--3-i0g.xn-----vue617w") != ""
			assert asciiError("xn--09e669a6x8j..xn--ye6h") != ""
			assert asciiError("a..b") == "A4_2"
			assert asciiError("-a.com") == "V3"
			assert asciiError("ab--c.com") == "V2"
			assert asciiError("́a.com") == "V6"
			assert asciiError("a_b.com") == "U1"
			assert asciiError("xn--X") == "P4"
			assert asciiError("xn--example-") == "P4"
			assert asciiError("a‍b.com") == "C2"
			assert asciiError("0a.א") == "B1"
			let long = "a".repeat(64)
			assert asciiError(long + ".com") == "A4_2"
			let relaxed = IDNAOptions{checkHyphens: false, useSTD3ASCIIRules: false, verifyDnsLength: false}
			assert (try toASCII("a_b--c.com", relaxed)) == "a_b--c.com"
			assert (try toASCII(long + ".com", relaxed)) == long + ".com"
			return none
		}

		// Strict processing applies IDNA2008's derived properties and its
		// CONTEXTO rules, as a validator of host names does.
		@test()
		def appliesIdna2008WhenStrict() !none {
			let strict = IDNAOptions{strict: true}
			assert (try toASCII("l·l", strict)) == "xn--ll-0ea"
			assert asciiError("a·l", strict) == "C3"
			assert asciiError("α͵S", strict) != ""
			assert (try toASCII("α͵β", strict)) != ""
			assert asciiError("def・abc", strict) == "C3"
			assert (try toASCII("・ぁ", strict)) != ""
			assert asciiError("〱〲〳〴〵〮〯〻", strict) != ""
			assert asciiError("ب٠۰", strict) != ""
			assert (try toASCII("ß", strict)) == "xn--zca"
			assert derivedProperty('a') == DerivedProperty.PValid
			assert derivedProperty('A') == DerivedProperty.Disallowed
			assert derivedProperty(char(0x200D)) == DerivedProperty.ContextJ
			assert derivedProperty(char(0x00B7)) == DerivedProperty.ContextO
			assert derivedProperty(char(0x0378)) == DerivedProperty.Unassigned
			assert allowedInContext(['l', char(0x00B7), 'l'], 1)
			assert !allowedInContext(['a', char(0x00B7), 'l'], 1)
			try bidiRule("אב")
			assert bidiRule("א0٠") is error
			return none
		}
	}
}
