// PRECIS (RFC 8264): preparation, enforcement and comparison of
// internationalized strings in protocols, with the profiles of RFC 8265
// (usernames and passwords) and RFC 8266 (nicknames).
//
//     let user = try precis.enforce("Juliet", precis.Profile.UsernameCaseMapped)   // "juliet"
//     let pass = try precis.enforce("correct\u1680horse", precis.Profile.OpaqueString)
//
// Code point properties come from std.text.unicode, so the classes follow its
// Unicode version.
module std.text.precis {
	use (
		std.errors
		std.text.unicode
		std.text.unicode::(Category, BidiClass, NormalForm, DecompositionType, JoiningType, HangulSyllableType)
	)

	// Profile names the PRECIS profiles this module implements.
	enum Profile {
		// Usernames compared without case (RFC 8265 §3.3): width mapping,
		// lowercase, NFC, the Bidi Rule; IdentifierClass.
		UsernameCaseMapped,
		// Usernames compared with case (RFC 8265 §3.4): width mapping, NFC,
		// the Bidi Rule; IdentifierClass.
		UsernameCasePreserved,
		// Passwords and other opaque strings (RFC 8265 §4.2): non-ASCII
		// spaces to SPACE, NFC; FreeformClass.
		OpaqueString,
		// Nicknames (RFC 8266): non-ASCII spaces to SPACE, outer spaces
		// removed and runs of spaces collapsed, NFKC; lowercase only when
		// comparing; FreeformClass.
		Nickname
	}

	// StringClass names the two PRECIS string classes (RFC 8264 §4).
	enum StringClass {
		// Letters and digits, and printable ASCII (RFC 8264 §4.2).
		Identifier,
		// Also spaces, symbols, punctuation and compatibility characters
		// (RFC 8264 §4.3).
		Freeform
	}

	// DerivedProperty is the PRECIS derived property value of a code point
	// (RFC 8264 §8).
	enum DerivedProperty {
		// Valid in both classes.
		PValid,
		// Valid in the FreeformClass only (ID_DIS or FREE_PVAL).
		FreePValid,
		// A join control, valid where its contextual rule holds.
		ContextJ,
		// Valid where its contextual rule holds (RFC 5892 Appendix A).
		ContextO,
		Disallowed,
		Unassigned
	}

	// PrecisError is the payload of a string a profile refuses: the reason,
	// and the index of the offending character, -1 when the string as a
	// whole is at fault.
	struct PrecisError {
		message  string
		code     string            = "precis"
		cause    ?error
		stack    errors.StackTrace
		position int               = -1
	}

	// The PRECIS Exceptions category (RFC 5892 §2.6), as code point, value
	// pairs.
	internal let exceptionPoints = [0x00DF, 0x03C2, 0x06FD, 0x06FE, 0x0F0B, 0x3007, 0x00B7, 0x0375, 0x05F3, 0x05F4, 0x30FB, 0x0660, 0x0661, 0x0662, 0x0663, 0x0664, 0x0665, 0x0666, 0x0667, 0x0668, 0x0669, 0x06F0, 0x06F1, 0x06F2, 0x06F3, 0x06F4, 0x06F5, 0x06F6, 0x06F7, 0x06F8, 0x06F9, 0x0640, 0x07FA, 0x302E, 0x302F, 0x3031, 0x3032, 0x3033, 0x3034, 0x3035, 0x303B]

	// The number of exception points that are PVALID, then CONTEXTO; the
	// rest are DISALLOWED.
	internal const exceptionsValid = 6
	internal const exceptionsContext = 31

	// derivedProperty is the derived property value of a code point by the
	// algorithm of RFC 8264 §8.
	def derivedProperty(ch char) DerivedProperty {
		let cp = int(ch)
		for let (i, point) in exceptionPoints {
			continue unless point == cp
			return DerivedProperty.PValid when i < exceptionsValid
			return DerivedProperty.ContextO when i < exceptionsContext
			return DerivedProperty.Disallowed
		}
		// BackwardCompatible (RFC 5892 §2.7) is empty.
		let category = unicode.category(ch)
		return DerivedProperty.Unassigned when category == Category.Unassigned && !unicode.isNoncharacter(ch)
		return DerivedProperty.PValid when cp >= 0x21 && cp <= 0x7E
		return DerivedProperty.ContextJ when cp := 0x200C || 0x200D
		let hangul = unicode.hangulSyllableType(ch)
		return DerivedProperty.Disallowed when hangul := HangulSyllableType.LeadingJamo || HangulSyllableType.VowelJamo || HangulSyllableType.TrailingJamo
		return DerivedProperty.Disallowed when unicode.isDefaultIgnorable(ch) || unicode.isNoncharacter(ch)
		return DerivedProperty.Disallowed when category == Category.Control
		return DerivedProperty.FreePValid when unicode.normalize(string(ch), NormalForm.NFKC) != string(ch)
		return DerivedProperty.PValid when category := Category.LowercaseLetter || Category.UppercaseLetter || Category.OtherLetter || Category.DecimalNumber || Category.ModifierLetter || Category.NonspacingMark || Category.SpacingMark
		return DerivedProperty.FreePValid when category := Category.TitlecaseLetter || Category.LetterNumber || Category.OtherNumber || Category.EnclosingMark
		return DerivedProperty.FreePValid when category == Category.SpaceSeparator
		return DerivedProperty.FreePValid when category := Category.MathSymbol || Category.CurrencySymbol || Category.ModifierSymbol || Category.OtherSymbol
		return DerivedProperty.FreePValid when category := Category.ConnectorPunctuation || Category.DashPunctuation || Category.OpenPunctuation || Category.ClosePunctuation || Category.InitialPunctuation || Category.FinalPunctuation || Category.OtherPunctuation
		return DerivedProperty.Disallowed
	}

	// stringClassOf is the class a profile builds on.
	def stringClassOf(profile Profile) StringClass {
		return StringClass.Identifier when profile := Profile.UsernameCaseMapped || Profile.UsernameCasePreserved
		return StringClass.Freeform
	}

	// allowed checks that every code point of the text is allowed in the
	// class: valid, or valid by its contextual rule (RFC 5892 Appendix A).
	// Fails with PrecisError naming the first that is not.
	def allowed(text string, stringClass StringClass) !none {
		let chars = unicode.codePoints(text)
		for let (i, ch) in chars {
			let property = derivedProperty(ch)
			switch {
				case property == DerivedProperty.PValid:
				case property == DerivedProperty.FreePValid:
					fail refusal("U+{int(ch).hex(4)} is not allowed in the IdentifierClass", i) when stringClass == StringClass.Identifier
				case property := DerivedProperty.ContextJ || DerivedProperty.ContextO:
					fail refusal("U+{int(ch).hex(4)} is not allowed in this context", i) unless contextAllows(chars, i)
				case property == DerivedProperty.Unassigned:
					fail refusal("U+{int(ch).hex(4)} is unassigned", i)
				default:
					fail refusal("U+{int(ch).hex(4)} is disallowed", i)
			}
		}
		return none
	}

	// prepare is the preparation of a profile (RFC 8265, RFC 8266): the
	// width mapping of the username profiles, then the check that every
	// code point belongs to the profile's class. Fails with PrecisError when
	// one does not.
	def prepare(text string, profile Profile) !string {
		let prepared = text
		prepared = mapWidth(text) when stringClassOf(profile) == StringClass.Identifier
		try allowed(prepared, stringClassOf(profile))
		return prepared
	}

	// enforce is the enforcement of a profile: preparation, the profile's
	// rules in order, and the check that the result is not empty. The rules
	// are applied until the result no longer changes, at most four times
	// (RFC 8264 §7). Fails with PrecisError for a string the profile
	// refuses, or one that does not settle.
	def enforce(text string, profile Profile) !string {
		return try settle(text, profile, false)
	}

	// compare reports whether two strings are equivalent under a profile:
	// both enforced (a nickname also lowercased) and then equal octet for
	// octet. Fails with PrecisError when either is refused.
	def compare(a string, b string, profile Profile) !bool {
		let first = try settle(a, profile, true)
		let second = try settle(b, profile, true)
		return first == second
	}

	// settle applies a profile's rules until the result is stable.
	internal def settle(text string, profile Profile, comparing bool) !string {
		// Printable ASCII is valid in both classes and none of the rules
		// but lowercasing changes it; a nickname's spaces still need them.
		if profile != Profile.Nickname && printableASCII(text, stringClassOf(profile) == StringClass.Freeform) {
			fail refusal("the string is empty", -1) when text.len() == 0
			return profile == Profile.UsernameCaseMapped ?? (text.lower(), text)
		}
		let current = text
		for let round = 0; round < 4; round++ {
			let next = try applyOnce(current, profile, comparing)
			return next when next == current
			current = next
		}
		fail refusal("the string does not settle under the profile's rules", -1)
	}

	// printableASCII reports whether the text is only U+0021 to U+007E, and
	// SPACE when `spaces`.
	internal def printableASCII(text string, spaces bool) bool {
		for let (_, b) in text.bytes() {
			continue when b >= 0x21 && b <= 0x7E
			return false unless spaces && b == 0x20
		}
		return true
	}

	// applyOnce is one pass of a profile's preparation and rules.
	internal def applyOnce(text string, profile Profile, comparing bool) !string {
		let out = try prepare(text, profile)
		switch {
			case profile == Profile.UsernameCaseMapped:
				out = unicode.normalize(unicode.toLower(out), NormalForm.NFC)
				try bidiRule(out)
			case profile == Profile.UsernameCasePreserved:
				out = unicode.normalize(out, NormalForm.NFC)
				try bidiRule(out)
			case profile == Profile.OpaqueString:
				out = unicode.normalize(mapSpaces(out), NormalForm.NFC)
			case profile == Profile.Nickname:
				out = collapseSpaces(mapSpaces(out))
				out = unicode.toLower(out) when comparing
				out = unicode.normalize(out, NormalForm.NFKC)
		}
		fail refusal("the string is empty", -1) when out.len() == 0
		return out
	}

	// mapWidth maps fullwidth and halfwidth code points to their
	// decompositions (UAX #11).
	internal def mapWidth(text string) string {
		let out = ""
		for let (_, ch) in text {
			let kind = unicode.decompositionType(ch)
			if kind := DecompositionType.Wide || DecompositionType.Narrow {
				for let (_, part) in unicode.decompose(ch, compatibility = true, full = false) {
					out += string(part)
				}
				continue
			}
			out += string(ch)
		}
		return out
	}

	// mapSpaces maps non-ASCII spaces (category Zs) to SPACE.
	internal def mapSpaces(text string) string {
		let out = ""
		for let (_, ch) in text {
			out += (unicode.category(ch) == Category.SpaceSeparator) ?? (" ", string(ch))
		}
		return out
	}

	// collapseSpaces removes spaces at both ends and turns each run of
	// spaces inside into one (RFC 8266 §2.1).
	internal def collapseSpaces(text string) string {
		let out = ""
		let pending = false
		for let (_, ch) in text {
			if ch == ' ' {
				pending = out.len() > 0
				continue
			}
			out += " " when pending
			pending = false
			out += string(ch)
		}
		return out
	}

	// bidiRule applies the Bidi Rule of RFC 5893 §2 to a string with
	// right-to-left code points (R, AL or AN); others pass. Fails with
	// PrecisError naming the condition broken.
	def bidiRule(text string) !none {
		let classes BidiClass[]
		let rtl = false
		for let (_, ch) in text {
			let c = unicode.bidiClass(ch)
			classes.push(c)
			rtl = true when c := BidiClass.R || BidiClass.AL || BidiClass.AN
		}
		return none unless rtl
		let first = classes[0]
		fail refusal("a right-to-left string must start with a strong character", 0) unless first := BidiClass.L || BidiClass.R || BidiClass.AL
		let end = classes.len() - 1
		for end > 0 && classes[end] == BidiClass.NSM {
			end--
		}
		let last = classes[end]
		if first == BidiClass.L {
			for let (i, c) in classes {
				fail refusal("a left-to-right string holds a character of bidi class {c}", i) unless c := BidiClass.L || BidiClass.EN || BidiClass.ES || BidiClass.CS || BidiClass.ET || BidiClass.ON || BidiClass.BN || BidiClass.NSM
			}
			fail refusal("a left-to-right string must end with L or EN", end) unless last := BidiClass.L || BidiClass.EN
			return none
		}
		let european = false
		let arabic = false
		for let (i, c) in classes {
			fail refusal("a right-to-left string holds a character of bidi class {c}", i) unless c := BidiClass.R || BidiClass.AL || BidiClass.AN || BidiClass.EN || BidiClass.ES || BidiClass.CS || BidiClass.ET || BidiClass.ON || BidiClass.BN || BidiClass.NSM
			european = true when c == BidiClass.EN
			arabic = true when c == BidiClass.AN
		}
		fail refusal("a right-to-left string must end with R, AL, EN or AN", end) unless last := BidiClass.R || BidiClass.AL || BidiClass.EN || BidiClass.AN
		fail refusal("a right-to-left string mixes European and Arabic digits", -1) when european && arabic
		return none
	}

	// contextAllows evaluates the contextual rule of the code point at i
	// (RFC 5892 Appendix A); false for a code point without one.
	internal def contextAllows(chars char[], i int) bool {
		let cp = int(chars[i])
		let before = i > 0 ?? (int(chars[i - 1]), -1)
		let after = i + 1 < chars.len() ?? (int(chars[i + 1]), -1)
		switch {
			case cp == 0x200C:
				return true when before >= 0 && unicode.combiningClass(char(before)) == 9
				return joinerBetweenJoiningLetters(chars, i)
			case cp == 0x200D:
				return before >= 0 && unicode.combiningClass(char(before)) == 9
			case cp == 0x00B7:
				return before == 0x6C && after == 0x6C
			case cp == 0x0375:
				return after >= 0 && unicode.script(char(after)) == "Grek"
			case cp := 0x05F3 || 0x05F4:
				return before >= 0 && unicode.script(char(before)) == "Hebr"
			case cp == 0x30FB:
				for let (_, ch) in chars {
					return true when unicode.script(ch) := "Hira" || "Kana" || "Hani"
				}
				return false
			case cp >= 0x0660 && cp <= 0x0669:
				for let (_, ch) in chars {
					return false when int(ch) >= 0x06F0 && int(ch) <= 0x06F9
				}
				return true
			case cp >= 0x06F0 && cp <= 0x06F9:
				for let (_, ch) in chars {
					return false when int(ch) >= 0x0660 && int(ch) <= 0x0669
				}
				return true
		}
		return false
	}

	// joinerBetweenJoiningLetters is the second ZERO WIDTH NON-JOINER rule:
	// (Joining_Type L or D) T* U+200C T* (Joining_Type R or D).
	internal def joinerBetweenJoiningLetters(chars char[], i int) bool {
		let b = i - 1
		for b >= 0 && unicode.joiningType(chars[b]) == JoiningType.Transparent {
			b--
		}
		return false when b < 0 || !(unicode.joiningType(chars[b]) := JoiningType.LeftJoining || JoiningType.DualJoining)
		let a = i + 1
		for a < chars.len() && unicode.joiningType(chars[a]) == JoiningType.Transparent {
			a++
		}
		return a < chars.len() && (unicode.joiningType(chars[a]) := JoiningType.RightJoining || JoiningType.DualJoining)
	}

	internal def refusal(message string, position int) PrecisError {
		return PrecisError{message: "precis: {message}", position: position}
	}
}
