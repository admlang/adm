module std.text.precis {
	use std.testing

	check "PRECIS" {
		// accepts enforces a string, "" when the profile refuses it.
		def accepts(text string, profile Profile) string {
			return enforce(text, profile) onerror recover ""
		}

		// Derived property values of RFC 8264 §8 for each category.
		@test()
		def derivedProperties() !none {
			assert derivedProperty('a') == DerivedProperty.PValid
			assert derivedProperty('@') == DerivedProperty.PValid // ASCII7
			assert derivedProperty(char(0x00DF)) == DerivedProperty.PValid // exception: sharp s
			assert derivedProperty(char(0x00B7)) == DerivedProperty.ContextO // middle dot
			assert derivedProperty(char(0x0640)) == DerivedProperty.Disallowed // tatweel
			assert derivedProperty(char(0x200C)) == DerivedProperty.ContextJ
			assert derivedProperty(char(0x1100)) == DerivedProperty.Disallowed // old Hangul jamo
			assert derivedProperty(char(0x00AD)) == DerivedProperty.Disallowed // soft hyphen, ignorable
			assert derivedProperty(char(0x0009)) == DerivedProperty.Disallowed // control
			assert derivedProperty(char(0x2163)) == DerivedProperty.FreePValid // Roman numeral four, HasCompat
			assert derivedProperty(char(0x221E)) == DerivedProperty.FreePValid // infinity, symbol
			assert derivedProperty(' ') == DerivedProperty.FreePValid
			assert derivedProperty(char(0x0378)) == DerivedProperty.Unassigned
			assert derivedProperty(char(0xFDD0)) == DerivedProperty.Disallowed // noncharacter
			assert derivedProperty(char(0xE000)) == DerivedProperty.Disallowed // private use
		}

		// The userparts of RFC 8265 Tables 1 and 2.
		@test()
		def usernames() !none {
			assert accepts("juliet@example.com", Profile.UsernameCaseMapped) == "juliet@example.com"
			assert accepts("fussball", Profile.UsernameCaseMapped) == "fussball"
			assert accepts("fußball", Profile.UsernameCaseMapped) == "fußball"
			assert accepts("π", Profile.UsernameCaseMapped) == "π"
			assert accepts("Σ", Profile.UsernameCaseMapped) == "σ"
			assert accepts("Σ", Profile.UsernameCasePreserved) == "Σ"
			assert accepts("ς", Profile.UsernameCaseMapped) == "ς"
			assert accepts("foo bar", Profile.UsernameCaseMapped) == ""
			assert accepts("", Profile.UsernameCaseMapped) == ""
			assert accepts("henryⅣ", Profile.UsernameCaseMapped) == ""
			assert accepts("∞", Profile.UsernameCaseMapped) == ""
			// Fullwidth letters map to ASCII before the class check.
			assert accepts("ＪＵＬＩＥＴ", Profile.UsernameCaseMapped) == "juliet"
			assert try compare("Juliet", "juliet", Profile.UsernameCaseMapped)
			assert !(try compare("Juliet", "juliet", Profile.UsernameCasePreserved))
		}

		// The passwords of RFC 8265 Tables 3 and 4.
		@test()
		def passwords() !none {
			assert accepts("correct horse battery staple", Profile.OpaqueString) == "correct horse battery staple"
			assert accepts("Correct Horse Battery Staple", Profile.OpaqueString) == "Correct Horse Battery Staple"
			assert accepts("πßå", Profile.OpaqueString) == "πßå"
			assert accepts("Jack of ♦s", Profile.OpaqueString) == "Jack of ♦s"
			assert accepts("foo" + string(char(0x1680)) + "bar", Profile.OpaqueString) == "foo bar"
			assert accepts("", Profile.OpaqueString) == ""
			assert accepts("my cat is a " + string(char(0x9)) + "by", Profile.OpaqueString) == ""
			// NFC composes "e" and a combining acute.
			assert accepts("e" + string(char(0x0301)), Profile.OpaqueString) == "é"
		}

		// The nicknames of RFC 8266 §3, as compared.
		@test()
		def nicknames() !none {
			assert try compare("Foo", "foo", Profile.Nickname)
			assert try compare("Foo Bar", "foo bar", Profile.Nickname)
			assert try compare("Σ", "σ", Profile.Nickname)
			assert !(try compare("σ", "ς", Profile.Nickname))
			assert try compare(string(char(0x03D4)), string(char(0x03CB)), Profile.Nickname)
			assert try compare("∞", "∞", Profile.Nickname)
			assert try compare("Richard Ⅳ", "richard iv", Profile.Nickname)
			assert accepts("  St   Peter ", Profile.Nickname) == "St Peter"
			assert accepts("   ", Profile.Nickname) == ""
		}

		// The Bidi Rule of RFC 5893 and the contextual rules of RFC 5892.
		@test()
		def rules() !none {
			assert accepts("שלום", Profile.UsernameCasePreserved) == "שלום"
			assert accepts("1שלום", Profile.UsernameCasePreserved) == "" // RTL must start strong
			assert accepts("abcש", Profile.UsernameCasePreserved) == "" // R in an LTR string
			assert accepts("ש1", Profile.UsernameCasePreserved) == "ש1" // ends with EN
			assert accepts("l·l", Profile.OpaqueString) == "l·l" // Catalan ela geminada
			assert accepts("a·b", Profile.OpaqueString) == ""
			assert accepts(string(char(0x0375)) + "α", Profile.OpaqueString) != "" // keraia before Greek
			assert accepts(string(char(0x0375)) + "a", Profile.OpaqueString) == ""
			assert accepts("ア" + string(char(0x30FB)) + "イ", Profile.OpaqueString) != ""
			assert accepts("a" + string(char(0x30FB)) + "b", Profile.OpaqueString) == ""
			assert accepts(string(char(0x0661)) + string(char(0x06F1)), Profile.OpaqueString) == ""
			// ZWNJ after a virama, and between joining letters.
			assert accepts("क" + string(char(0x094D)) + string(char(0x200C)) + "ष", Profile.OpaqueString) != ""
			assert accepts("ب" + string(char(0x200C)) + "ب", Profile.OpaqueString) != ""
			assert accepts("a" + string(char(0x200C)) + "b", Profile.OpaqueString) == ""
			assert stringClassOf(Profile.Nickname) == StringClass.Freeform && stringClassOf(Profile.UsernameCasePreserved) == StringClass.Identifier
			let mixed = true
			bidiRule("ש" + string(char(0x0661)) + "1") onerror (err error) {
				mixed = !(err is PrecisError)
				recover none
			}
			assert !mixed
			try allowed("a b", StringClass.Freeform)
			let refused = false
			allowed("a b", StringClass.Identifier) onerror (err error) {
				refused = true
				recover none
			}
			assert refused
			try bidiRule("plain ascii")
			let failure = prepare("ab" + string(char(0x7)), Profile.OpaqueString) onerror (err error) {
				assert err is PrecisError
				recover ""
			}
			assert failure == ""
		}
	}
}
