internal std partial module std.text.regex {
	// Where a match must lie in the text searched.
	enum Anchor {
		// Anywhere at or after the starting position.
		Unanchored,
		// Starting at the starting position.
		Start,
		// From the starting position to the end of the text.
		Both,
	}

	// The state of a Pike VM search of one program: the threads at the
	// current and the next position in priority order, each with its
	// capture slots. A matcher is reused from search to search, so a loop
	// over the matches of a text allocates once; it belongs to one task at
	// a time, while its program may be shared.
	type Matcher {
		program    Program
		// Per instruction, the list generation it was last added to.
		marks      int[]
		generation int
		// The two thread lists, the instructions of one in the first half
		// and of the other in the second; their capture slots likewise, a
		// row of slots per thread.
		lists      int[]
		listSlots  int[]
		// Instructions to follow, and (value, -1 - slot) entries that put a
		// capture slot back once the instructions pushed after them are
		// followed. Following visits an instruction once and pushes at
		// most three entries for it.
		stack      int[]
		// The capture slots of the thread being followed.
		work       int[]

		def new(program Program) {
			self.program = program
		}

		// Searches `raw` from byte `from` for the leftmost match, preferring
		// among the matches that start there as RE2 and Perl do (the first
		// alternative, the longer greedy and the shorter lazy repeat). On a
		// match `slots` holds byte offsets as (start, end) pairs: the match,
		// then each group in turn, -1 for a group outside the match; it
		// may be shorter than that, down to empty when only whether there is
		// a match counts (then the search stops at the first one found).
		// Assertions see the bytes before `from`.
		//
		// The forward DFA finds where the match ends, the reverse one where
		// it starts, and the Pike VM runs over that span alone, only when
		// groups are asked for.
		def search(raw byte[], from int, anchor Anchor = Anchor.Unanchored, slots int[] = []) bool {
			let p = program
			let most = 2 * p.names.len()
			let ns = slots.len() < most ?? (slots.len(), most)
			let n = raw.len()
			return false when from > n
			if anchor == Anchor.Both {
				let whole = p.whole
				return false unless whole is Dfa && whole.matchesWhole(raw, from)
				return true when ns == 0
				return pike(raw, from, n, Anchor.Both, slots) when ns > 2
				(slots[0], slots[1]) = (from, n)
				return true
			}
			// A pattern that starts at the start of the text is tried there
			// alone.
			return false when p.anchored && from > 0
			let loop = anchor == Anchor.Unanchored && !p.anchored
			let forward = p.forward
			let reverse = p.reverse
			return false unless forward is Dfa && reverse is Dfa
			let end = forward.matchEnd(raw, from, loop, ns == 0)
			return false when end < 0
			return true when ns == 0
			let start = loop ?? (reverse.matchStart(raw, end, from), from)
			return pike(raw, start, end, Anchor.Both, slots) when ns > 2
			(slots[0], slots[1]) = (start, end)
			return true
		}

		// The Pike VM: the leftmost-first match from byte `from` with its
		// groups, as `search` reports it, treating `end` as the end of the
		// text (assertions still see the bytes past it).
		def pike(raw byte[], from int, end int, anchor Anchor, slots int[]) bool {
			let p = program
			if lists.len() == 0 {
				let size = p.op.len()
				let width = 2 * p.names.len()
				marks.len(size)
				lists.len(2 * size)
				listSlots.len(2 * size * width)
				stack.len(3 * size + 2)
				work.len(width)
			}
			let (op, ia, ib, ic, table) = (p.op, p.a, p.b, p.c, p.table)
			let (marks, lists, listSlots, stack, work) = (self.marks, self.lists, self.listSlots, self.stack, self.work)
			let most = work.len()
			let ns = slots.len() < most ?? (slots.len(), most)
			let n = end
			let half = op.len()
			let unanchored = anchor == Anchor.Unanchored
			let whole = anchor == Anchor.Both
			let gen = generation
			let matched = false
			// The list at the position before `pos` starts at `cur`, the
			// one at `pos` being built at `nxt`.
			let (cur, nxt) = (0, half)
			let curN = 0
			// Each round steps the threads at pos - 1 over the byte between
			// them and pos, then adds a thread starting at pos with the
			// lowest priority; the round at n + 1 only collects matches.
			for let pos = from; pos <= n + 1; pos++ {
				gen++
				let nxtN = 0
				let ch = pos > from && pos <= n ?? (int(raw[pos - 1]), -1)
				let seeded = !matched && pos <= n && (pos == from || unanchored)
				let rounds = seeded ?? (curN + 1, curN)
				for let i = 0; i < rounds; i++ {
					let target = 0
					if i == curN {
						for let k = 0; k < ns; k++ {
							work[k] = -1
						}
					} else {
						let pc = lists[cur + i]
						let o = op[pc]
						target = -1
						if o == opByte {
							target = ic[pc] when ch >= ia[pc] && ch <= ib[pc]
						} else if o == opSwitch {
							target = switchTarget(table, ia[pc], ib[pc], ch)
						} else {
							continue when whole && pos - 1 != n
							let row = (cur + i) * most
							for let k = 0; k < ns; k++ {
								slots[k] = listSlots[row + k]
							}
							matched = true
							if ns == 0 && !whole {
								generation = gen
								return true
							}
							// Threads of lower priority than this match lose.
							break
						}
						continue when target < 0
						let row = (cur + i) * most
						for let k = 0; k < ns; k++ {
							work[k] = listSlots[row + k]
						}
					}
					// Follow the thread from target, in priority order.
					stack[0] = target
					let sp = 1
					for sp > 0 {
						sp--
						let x = stack[sp]
						if x < 0 {
							sp--
							work[-1 - x] = stack[sp]
							continue
						}
						continue when marks[x] == gen
						marks[x] = gen
						let o = op[x]
						if o == opJump {
							stack[sp] = ia[x]
							sp++
						} else if o == opSplit {
							stack[sp] = ib[x]
							stack[sp + 1] = ia[x]
							sp += 2
						} else if o == opSave {
							let s = ia[x]
							if s < ns {
								stack[sp] = work[s]
								stack[sp + 1] = -1 - s
								sp += 2
								work[s] = pos
							}
							stack[sp] = ic[x]
							sp++
						} else if o == opAssert {
							if holds(ia[x], raw, pos) {
								stack[sp] = ic[x]
								sp++
							}
						} else {
							lists[nxt + nxtN] = x
							let row = (nxt + nxtN) * most
							for let k = 0; k < ns; k++ {
								listSlots[row + k] = work[k]
							}
							nxtN++
						}
					}
				}
				(cur, nxt) = (nxt, cur)
				curN = nxtN
				break when curN == 0 && (matched || !unanchored || pos >= n)
			}
			generation = gen
			return matched
		}
	}

	// The instruction a switch whose `count` (first, last, target) triples
	// start at `base` in `table` goes on to after byte `ch`; -1 when no
	// range holds it.
	def switchTarget(table int[], base int, count int, ch int) int {
		if count <= 8 {
			for let i = base; i < base + 3 * count; i += 3 {
				return table[i + 2] when ch >= table[i] && ch <= table[i + 1]
			}
			return -1
		}
		// The last range starting at or below ch.
		let (lo, hi) = (0, count)
		for lo < hi {
			let m = (lo + hi) >> 1
			if table[base + 3 * m] <= ch {
				lo = m + 1
			} else {
				hi = m
			}
		}
		return -1 when lo == 0
		let i = base + 3 * (lo - 1)
		return ch <= table[i + 1] ?? (table[i + 2], -1)
	}

	// Whether zero-width assertion `a` holds at byte `pos` of `raw`. Word
	// boundaries are ASCII, as in RE2, so bytes are enough.
	def holds(a int, raw byte[], pos int) bool {
		let n = raw.len()
		let before = pos > 0 ?? (int(raw[pos - 1]), -1)
		let after = pos < n ?? (int(raw[pos]), -1)
		if a == beginText {
			return pos == 0
		} else if a == endText {
			return pos == n
		} else if a == beginLine {
			return pos == 0 || before == 10
		} else if a == endLine {
			return pos == n || after == 10
		} else if a == wordBoundary {
			return isWordChar(before) != isWordChar(after)
		}
		return isWordChar(before) == isWordChar(after)
	}
}
