internal std partial module std.text.regex {
	use std.text.unicode

	// The last code point.
	const maxRune = 0x10FFFF

	// Ranges (pairs of first and last code point) sorted, with overlapping
	// and touching ones merged.
	def normalize(r int[]) int[] {
		let keys int[]
		for let i = 0; i + 1 < r.len(); i += 2 {
			keys.push(r[i] << 21 | r[i + 1])
		}
		keys.sort((a, b int) => a < b)
		let out int[]
		for let (_, k) in keys {
			let (lo, hi) = (k >> 21, k & 0x1FFFFF)
			let n = out.len()
			if n > 0 && lo <= out[n - 1] + 1 {
				out[n - 1] = hi when hi > out[n - 1]
			} else {
				out.push(lo, hi)
			}
		}
		return out
	}

	// The code points not in the sorted, disjoint ranges `r`.
	def negateRanges(r int[]) int[] {
		let out int[]
		let next = 0
		for let i = 0; i + 1 < r.len(); i += 2 {
			out.push(next, r[i] - 1) when r[i] > next
			next = r[i + 1] + 1
		}
		out.push(next, maxRune) when next <= maxRune
		return out
	}

	// The ranges `r` with every code point's case orbit added, sorted and
	// disjoint.
	def foldRanges(r int[]) int[] {
		let out = r.clone()
		let keys = orbits.keys
		for let i = 0; i + 1 < r.len(); i += 2 {
			let (lo, hi) = (r[i], r[i + 1])
			// The first orbit member at or above lo.
			let (a, b) = (0, keys.len())
			for a < b {
				let m = (a + b) >> 1
				if keys[m] < lo {
					a = m + 1
				} else {
					b = m
				}
			}
			for let k = a; k < keys.len() && keys[k] <= hi; k++ {
				let o = orbits.next[k]
				for o != keys[k] {
					out.push(o, o)
					o = orbits.next[orbits.indexOf(o)]
				}
			}
		}
		return normalize(out)
	}

	// The code points of `ch`'s case orbit, `ch` first: those whose simple
	// case folds are equal (k, K and the Kelvin sign).
	def orbitOf(ch int) int[] {
		let out = [ch]
		let i = orbits.indexOf(ch)
		return out when i < 0
		let o = orbits.next[i]
		for o != ch {
			out.push(o)
			o = orbits.next[orbits.indexOf(o)]
		}
		return out
	}

	// The case orbits of Unicode as a cycle: `next[i]` is the orbit member
	// after `keys[i]`, in code point order, wrapping to the smallest (as
	// RE2's fold table walks them).
	type Orbits {
		keys int[]
		next int[]

		// The index of `ch` in keys, -1 when it has no orbit.
		def indexOf(ch int) int {
			let (a, b) = (0, keys.len())
			for a < b {
				let m = (a + b) >> 1
				if keys[m] < ch {
					a = m + 1
				} else {
					b = m
				}
			}
			return a < keys.len() && keys[a] == ch ?? (a, -1)
		}
	}

	// Made on first use: one pass over the cased code points.
	let orbits = buildOrbits()

	def buildOrbits() Orbits {
		let members = new map<int, int[]>()
		// Cased letters end below the Adlam block's end.
		for let cp = 0x41; cp < 0x1E950; cp++ {
			continue unless unicode.isCased(char(cp))
			let f = simpleFold(cp)
			let list = members.get(f)
			if list is int[] {
				list.push(cp) unless list.includes(cp)
			} else {
				members.set(f, f == cp ?? ([cp], [f, cp]))
			}
		}
		let pairs int[]
		for let (_, list) in members {
			continue when list.len() < 2
			list.sort((a, b int) => a < b)
			for let (i, cp) in list {
				pairs.push(cp, list[(i + 1) % list.len()])
			}
		}
		let order int[]
		for let i = 0; i < pairs.len(); i += 2 {
			order.push(pairs[i] << 21 | pairs[i + 1])
		}
		order.sort((a, b int) => a < b)
		let out = new Orbits()
		for let (_, k) in order {
			out.keys.push(k >> 21)
			out.next.push(k & 0x1FFFFF)
		}
		return out
	}

	// The simple case fold of code point `ch`: the one code point its case
	// folding gives, else its one-code-point lowercase, else itself.
	def simpleFold(ch int) int {
		return ch >= 65 && ch <= 90 ?? (ch + 32, ch) when ch < 0x80
		let s = unicode.caseFold(string(char(ch)))
		return int(s[0]) when s.len() == 1
		let l = unicode.toLower(string(char(ch)))
		return l.len() == 1 ?? (int(l[0]), ch)
	}

	// The code points of property `name` (see `knownProperty`) as sorted,
	// disjoint ranges.
	def propertyRanges(name string) int[] {
		return [0, maxRune] when name == "Any"
		let r = properties.get(name)
		return r is int[] ?? (r, [])
	}

	// Whether `name` is a property RE2 knows: Any, a general category (one
	// or two letters) or a script by its Unicode name.
	def knownProperty(name string) bool {
		return name == "Any" || properties.get(name) is int[]
	}

	// The ranges of every general category (two-letter and one-letter
	// abbreviations) and script (Unicode name), made on first use in one
	// pass over the code points.
	let properties = buildProperties()

	def buildProperties() map<string, int[]> {
		let out = new map<string, int[]>()
		let add = (name string, lo int, hi int) => {
			let list = out.get(name)
			if list is int[] {
				list.push(lo, hi)
			} else {
				out.set(name, [lo, hi])
			}
		}
		let category = unicode.category(char(0))
		let script = unicode.script(char(0))
		let (categoryStart, scriptStart) = (0, 0)
		for let cp = 1; cp <= maxRune + 1; cp++ {
			let last = cp > maxRune
			let c = last ?? (category, unicode.category(char(cp)))
			if last || c != category {
				let code = categoryCode(category)
				add(code, categoryStart, cp - 1)
				add(code.slice(0, 1), categoryStart, cp - 1)
				(category, categoryStart) = (c, cp)
			}
			let s = last ?? (script, unicode.script(char(cp)))
			if last || s != script {
				let long = scriptNames.get(script)
				add(long, scriptStart, cp - 1) when long is string
				(script, scriptStart) = (s, cp)
			}
		}
		for let (name, list) in out {
			out.set(name, normalize(list)) when name.len() == 1
		}
		return out
	}

	// The two-letter abbreviation of a general category.
	def categoryCode(c unicode.Category) string {
		match c {
			case unicode.Category.UppercaseLetter:
				return "Lu"
			case unicode.Category.LowercaseLetter:
				return "Ll"
			case unicode.Category.TitlecaseLetter:
				return "Lt"
			case unicode.Category.ModifierLetter:
				return "Lm"
			case unicode.Category.OtherLetter:
				return "Lo"
			case unicode.Category.NonspacingMark:
				return "Mn"
			case unicode.Category.SpacingMark:
				return "Mc"
			case unicode.Category.EnclosingMark:
				return "Me"
			case unicode.Category.DecimalNumber:
				return "Nd"
			case unicode.Category.LetterNumber:
				return "Nl"
			case unicode.Category.OtherNumber:
				return "No"
			case unicode.Category.ConnectorPunctuation:
				return "Pc"
			case unicode.Category.DashPunctuation:
				return "Pd"
			case unicode.Category.OpenPunctuation:
				return "Ps"
			case unicode.Category.ClosePunctuation:
				return "Pe"
			case unicode.Category.InitialPunctuation:
				return "Pi"
			case unicode.Category.FinalPunctuation:
				return "Pf"
			case unicode.Category.OtherPunctuation:
				return "Po"
			case unicode.Category.MathSymbol:
				return "Sm"
			case unicode.Category.CurrencySymbol:
				return "Sc"
			case unicode.Category.ModifierSymbol:
				return "Sk"
			case unicode.Category.OtherSymbol:
				return "So"
			case unicode.Category.SpaceSeparator:
				return "Zs"
			case unicode.Category.LineSeparator:
				return "Zl"
			case unicode.Category.ParagraphSeparator:
				return "Zp"
			case unicode.Category.Control:
				return "Cc"
			case unicode.Category.Format:
				return "Cf"
			case unicode.Category.Surrogate:
				return "Cs"
			case unicode.Category.PrivateUse:
				return "Co"
			default:
				return "Cn"
		}
	}

	// Unicode script names (as RE2's \p{Name} takes them) by ISO 15924 code.
	let scriptNames = map<string, string>{
		"Zyyy": "Common", "Zinh": "Inherited", "Zzzz": "Unknown", "Latn": "Latin", "Grek": "Greek", "Cyrl": "Cyrillic", "Armn": "Armenian", "Hebr": "Hebrew", "Arab": "Arabic", "Syrc": "Syriac", "Thaa": "Thaana", "Deva": "Devanagari", "Beng": "Bengali", "Guru": "Gurmukhi", "Gujr": "Gujarati", "Orya": "Oriya", "Taml": "Tamil", "Telu": "Telugu", "Knda": "Kannada", "Mlym": "Malayalam", "Sinh": "Sinhala", "Thai": "Thai", "Laoo": "Lao", "Tibt": "Tibetan", "Mymr": "Myanmar", "Geor": "Georgian", "Hang": "Hangul", "Ethi": "Ethiopic", "Cher": "Cherokee", "Cans": "Canadian_Aboriginal", "Ogam": "Ogham", "Runr": "Runic", "Khmr": "Khmer", "Mong": "Mongolian", "Hira": "Hiragana", "Kana": "Katakana", "Bopo": "Bopomofo", "Hani": "Han", "Yiii": "Yi", "Ital": "Old_Italic", "Goth": "Gothic", "Dsrt": "Deseret", "Tglg": "Tagalog", "Hano": "Hanunoo", "Buhd": "Buhid", "Tagb": "Tagbanwa", "Limb": "Limbu", "Tale": "Tai_Le", "Linb": "Linear_B", "Ugar": "Ugaritic", "Shaw": "Shavian", "Osma": "Osmanya", "Cprt": "Cypriot", "Brai": "Braille", "Bugi": "Buginese", "Copt": "Coptic", "Talu": "New_Tai_Lue", "Glag": "Glagolitic", "Tfng": "Tifinagh", "Sylo": "Syloti_Nagri", "Xpeo": "Old_Persian", "Khar": "Kharoshthi", "Bali": "Balinese", "Xsux": "Cuneiform", "Phnx": "Phoenician", "Phag": "Phags_Pa", "Nkoo": "Nko", "Sund": "Sundanese", "Lepc": "Lepcha", "Olck": "Ol_Chiki", "Vaii": "Vai", "Saur": "Saurashtra", "Kali": "Kayah_Li", "Rjng": "Rejang", "Lyci": "Lycian", "Cari": "Carian", "Lydi": "Lydian", "Cham": "Cham", "Lana": "Tai_Tham", "Tavt": "Tai_Viet", "Avst": "Avestan", "Egyp": "Egyptian_Hieroglyphs", "Samr": "Samaritan", "Lisu": "Lisu", "Bamu": "Bamum", "Java": "Javanese", "Mtei": "Meetei_Mayek", "Armi": "Imperial_Aramaic", "Sarb": "Old_South_Arabian", "Prti": "Inscriptional_Parthian", "Phli": "Inscriptional_Pahlavi", "Orkh": "Old_Turkic", "Kthi": "Kaithi", "Batk": "Batak", "Brah": "Brahmi", "Mand": "Mandaic", "Cakm": "Chakma", "Merc": "Meroitic_Cursive", "Mero": "Meroitic_Hieroglyphs", "Plrd": "Miao", "Shrd": "Sharada", "Sora": "Sora_Sompeng", "Takr": "Takri", "Aghb": "Caucasian_Albanian", "Bass": "Bassa_Vah", "Dupl": "Duployan", "Elba": "Elbasan", "Gran": "Grantha", "Hmng": "Pahawh_Hmong", "Khoj": "Khojki", "Lina": "Linear_A", "Mahj": "Mahajani", "Mani": "Manichaean", "Mend": "Mende_Kikakui", "Modi": "Modi", "Mroo": "Mro", "Narb": "Old_North_Arabian", "Nbat": "Nabataean", "Palm": "Palmyrene", "Pauc": "Pau_Cin_Hau", "Perm": "Old_Permic", "Phlp": "Psalter_Pahlavi", "Sidd": "Siddham", "Sind": "Khudawadi", "Tirh": "Tirhuta", "Wara": "Warang_Citi", "Ahom": "Ahom", "Hluw": "Anatolian_Hieroglyphs", "Hatr": "Hatran", "Mult": "Multani", "Hung": "Old_Hungarian", "Sgnw": "SignWriting", "Adlm": "Adlam", "Bhks": "Bhaiksuki", "Marc": "Marchen", "Newa": "Newa", "Osge": "Osage", "Tang": "Tangut", "Gonm": "Masaram_Gondi", "Nshu": "Nushu", "Soyo": "Soyombo", "Zanb": "Zanabazar_Square", "Dogr": "Dogra", "Gong": "Gunjala_Gondi", "Maka": "Makasar", "Medf": "Medefaidrin", "Rohg": "Hanifi_Rohingya", "Sogd": "Sogdian", "Sogo": "Old_Sogdian", "Elym": "Elymaic", "Nand": "Nandinagari", "Hmnp": "Nyiakeng_Puachue_Hmong", "Wcho": "Wancho", "Chrs": "Chorasmian", "Diak": "Dives_Akuru", "Kits": "Khitan_Small_Script", "Yezi": "Yezidi", "Cpmn": "Cypro_Minoan", "Ougr": "Old_Uyghur", "Tnsa": "Tangsa", "Toto": "Toto", "Vith": "Vithkuqi", "Kawi": "Kawi", "Nagm": "Nag_Mundari", "Gara": "Garay", "Gukh": "Gurung_Khema", "Krai": "Kirat_Rai", "Onao": "Ol_Onal", "Sunu": "Sunuwar", "Todr": "Todhri", "Tutg": "Tulu_Tigalari",
	}

	// The UTF-8 encodings of the code points `lo` to `hi` as sequences of
	// byte ranges, appended to `out` in code point order: each sequence is
	// its length (1 to 4) followed by that many pairs of first and last
	// byte, and matches exactly the code points whose encoding has each
	// byte in its range. Surrogates are left out (they have no encoding).
	def utf8Sequences(lo int, hi int, out int[]) {
		let pending int[]
		if lo < 0xD800 && hi > 0xDFFF {
			pending.push(0xE000, hi)
			hi = 0xD7FF
		} else if lo >= 0xD800 && lo <= 0xDFFF {
			lo = 0xE000
		} else if hi >= 0xD800 && hi <= 0xDFFF {
			hi = 0xD7FF
		}
		pending.push(lo, hi) when lo <= hi
		let a int[]
		let b int[]
		for pending.len() > 0 {
			let e = pending.pop()
			let s = pending.pop()
			let split = true
			for split {
				split = false
				// One encoded length at a time.
				for let (_, top) in [0x7F, 0x7FF, 0xFFFF] {
					if s <= top && top < e {
						pending.push(top + 1, e)
						e = top
					}
				}
				let n = utf8Length(s)
				// Ranges whose bytes after the first differ must cover whole
				// blocks of their continuation bytes.
				for let i = 1; i < n && !split; i++ {
					let m = (1 << (6 * i)) - 1
					continue when s >> (6 * i) == e >> (6 * i)
					if s & m != 0 {
						pending.push((s | m) + 1, e)
						e = s | m
						split = true
					} else if e & m != m {
						pending.push(e - (e & m), e)
						e = e - (e & m) - 1
						split = true
					}
				}
			}
			encodeUtf8(s, a)
			encodeUtf8(e, b)
			out.push(a.len())
			for let i = 0; i < a.len(); i++ {
				out.push(a[i], b[i])
			}
		}
	}

	// The length of code point `ch`'s UTF-8 encoding.
	def utf8Length(ch int) int {
		return ch < 0x80 ?? (1, ch < 0x800 ?? (2, ch < 0x10000 ?? (3, 4)))
	}

	// Replaces the contents of `out` with code point `ch`'s UTF-8 bytes.
	def encodeUtf8(ch int, out int[]) {
		out.len(0)
		if ch < 0x80 {
			out.push(ch)
		} else if ch < 0x800 {
			out.push(0xC0 | ch >> 6, 0x80 | ch & 0x3F)
		} else if ch < 0x10000 {
			out.push(0xE0 | ch >> 12, 0x80 | (ch >> 6) & 0x3F, 0x80 | ch & 0x3F)
		} else {
			out.push(0xF0 | ch >> 18, 0x80 | (ch >> 12) & 0x3F, 0x80 | (ch >> 6) & 0x3F, 0x80 | ch & 0x3F)
		}
	}
}
