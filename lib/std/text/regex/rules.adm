internal std partial module std.text.regex {
	use std.sync::(ReadWriteLock)

	// Patterns searched at once: a lexer's rules. One DFA pass says which
	// rule matched, the earliest in the list winning among those that match
	// at a position, as the alternatives of one pattern do. A rule with groups
	// keeps a program of its own, which the Pike VM runs over the match alone.
	type RuleSet {
		// The rules as one program, for finding the match and its rule.
		program Program
		// Per rule, its own program when it has groups.
		own     (?Program)[]
		// Per rule, its group count.
		groups  int[]
		// Why a pattern did not compile, naming it, "" when all did: the set
		// then matches nothing.
		fault   string
	}

	// A set of `patterns` with the flags in `flags`, as `compile` takes them.
	// `limit` bounds the instructions of the whole set and of each rule's own
	// program; a lower one also lowers what its DFAs may cache, in proportion.
	// Never fails: a pattern that does not compile makes a set that matches
	// nothing, and `fault` says which and why.
	def compileRules(patterns string[], flags string = "", limit int = programLimit) RuleSet {
		let set = new RuleSet()
		for let (i, pattern) in patterns {
			let own = parsed(pattern, flags) onerror (err error) {
				return failedRules("rule {i}: {err.message}")
			}
			set.groups.push(own.names.len() - 1)
			if own.names.len() > 1 {
				let program = buildLimited(own.tree, own.names, limit) onerror (err error) {
					return failedRules("rule {i}: {err.message}")
				}
				set.own.push(program)
			} else {
				set.own.push(none)
			}
		}
		set.program = rulesProgram(patterns, flags, limit) onerror (err error) {
			return failedRules(err.message)
		}
		return set
	}

	internal def failedRules(fault string) RuleSet {
		let set = new RuleSet()
		set.program = failedProgram(fault)
		set.fault = fault
		return set
	}

	// The rules as one program: a chain of splits in rule order, each rule
	// ending in a match that carries its number. It keeps no groups: each
	// rule's parser numbers its own, and they are read from its own program.
	internal def rulesProgram(patterns string[], flags string, limit int) !Program {
		let trees Node[]
		for let (_, pattern) in patterns {
			let own = try parsed(pattern, flags)
			trees.push(own.tree)
		}
		let program = new Program()
		program.limit = limit
		program.names = [""]
		program.add(opSave, 0, 0, 1)
		try emitRules(program, trees)
		for let (_, tree) in trees {
			tree.forget()
		}
		let back = new Program()
		back.limit = limit
		back.names = [""]
		back.reversed = true
		try emitRules(back, trees)
		program.classify()
		(back.classOf, back.classes) = (program.classOf, program.classes)
		program.lookMask = program.lookFlags()
		back.lookMask = back.lookFlags()
		program.firstByte = -1
		attachDfas(program, back, limit)
		return program
	}

	// Appends the alternatives: a split before each rule but the last, and
	// after each one a match carrying its number. No rule at all matches nothing.
	internal def emitRules(program Program, trees Node[]) !none {
		if trees.len() == 0 {
			let never = new Node(NodeKind.Class)
			never.set = new CharClass()
			try program.emit(never)
			program.add(opMatch, 0, 0, 0)
			return none
		}
		for let (i, tree) in trees {
			let split = i + 1 < trees.len() ?? (program.add(opSplit, program.op.len() + 1, 0, 0), -1)
			try program.emit(tree)
			program.add(opSave, 1, 0, program.op.len() + 1) unless program.reversed
			program.add(opMatch, i, 0, 0)
			program.b[split] = program.op.len() when split >= 0
		}
		return none
	}
}
