internal std partial module std.text.regex {
	use std.testing

	// Whether the trie takes the UTF-8 bytes of `ch`, read from the last to
	// the first when `backwards`, to an end.
	def trieTakes(trie ByteTrie, ch int, backwards bool) bool {
		let bytes int[]
		encodeUtf8(ch, bytes)
		bytes.reverse() when backwards
		let node = 0
		for let (k, v) in bytes {
			return false when node < 0
			let e = trie.edges[node]
			let next = -2
			for let j = 0; j < e.len(); j += 3 {
				next = e[j + 2] when v >= e[j] && v <= e[j + 1]
			}
			return false when next == -2
			return next == -1 when k + 1 == bytes.len()
			node = next
		}
		return false
	}

	def inRanges(r int[], ch int) bool {
		for let i = 0; i + 1 < r.len(); i += 2 {
			return true when ch >= r[i] && ch <= r[i + 1]
		}
		return false
	}

	check "Class tries" {
		// The trie of a class, forwards and backwards, takes the encodings of
		// the class's code points and no other, a byte following one edge at
		// most: checked at both ends of every range, beside them, and at
		// code points spread over the rest.
		@test()
		def TestTriesTakeTheClass() {
			let classes = [
				propertyRanges("L"),
				propertyRanges("N"),
				negateRanges(propertyRanges("L")),
				[0, maxRune],
				[0, 9, 11, maxRune],
				[0x61, 0x7A],
				[0x7F, 0x80],
				[0x7FF, 0x800],
				[0xD7FF, 0xE000],
				[0xFFFF, 0x10000],
				[0x3B1, 0x3C9, 0x4E00, 0x9FFF, 0x1F600, 0x1F64F],
				[0x10FFFF, 0x10FFFF],
				int[],
			]
			for let (_, r) in classes {
				let samples = [0, 0x7F, 0x80, 0x7FF, 0x800, 0xD7FF, 0xE000, 0xFFFF, 0x10000, maxRune]
				for let i = 0; i < r.len(); i++ {
					samples.push(r[i] - 1, r[i], r[i] + 1)
				}
				for let ch = 0; ch <= maxRune; ch += 997 {
					samples.push(ch)
				}
				for let (_, backwards) in [false, true] {
					let trie = backwards ?? (backwardTrie(r), forwardTrie(r))
					for let (_, e) in trie.edges {
						for let j = 3; j < e.len(); j += 3 {
							assert e[j] > e[j - 2]
						}
					}
					for let (_, ch) in samples {
						continue when ch < 0 || ch > maxRune || ch >= 0xD800 && ch <= 0xDFFF
						assert trieTakes(trie, ch, backwards) == inRanges(r, ch)
					}
				}
			}
		}

		// Read backwards, a class has a node per thing it leaves to read,
		// however many ranges it has.
		@test()
		def TestTheBackwardTrieSharesWhatIsLeft() {
			// Every code point: the bytes read so far, and the lead bytes
			// that take fewer trailing bytes (E0, ED, F0, F4).
			assert backwardTrie([0, maxRune]).edges.len() == 6
			// 200 code points 64 apart end in the same byte and differ in
			// the one before it.
			let spread int[]
			for let i = 0; i < 200; i++ {
				spread.push(0x1000 + 64 * i, 0x1000 + 64 * i)
			}
			assert backwardTrie(spread).edges.len() == 4
		}
	}
}
