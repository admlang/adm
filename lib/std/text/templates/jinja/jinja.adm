// Jinja templates: the language Jinja2 reads, as Hugging Face chat
// templates use it. `parse` reads a template once; `Template.render` fills
// it with values any number of times.
partial module std.text.templates.jinja {
	use (
		std.text.templates.jinja.syntax::*
		std.text.templates.jinja.runtime::*
	)

	// How the template text is read and its output written.
	struct Options {
		// Drops the first newline after a block tag (`{% ... %}`).
		trimBlocks   bool = false
		// Strips the spaces and tabs before a block tag that starts a line.
		lstripBlocks bool = false
		// Escapes `&`, `<`, `>`, `"` and `'` in every value written with
		// `{{ }}`, except values marked safe (the `safe` filter or `Safe`).
		autoescape   bool = false
	}

	// Text written as it is, even with `autoescape` on.
	struct Safe {
		text string
	}

	// A parsed template, rendered any number of times.
	type Template {
		internal body      Node[]
		internal options   Options
		internal functions map<string, def (args any[]) !any>

		// A template over parsed statements; use `parse`.
		def new(body Node[], options Options) {
			self.body = body
			self.options = options
			functions = new map<string, def (args any[]) !any>()
		}

		// Renders the template with `values` as its variables. Values may be
		// strings, numbers, booleans, `none`, arrays, maps with string keys
		// (in the order they were added, as Python dicts are), structs
		// (their fields by name, in declaration order) and `Safe`.
		// Fails on a call to an undefined function, an operation on the
		// wrong kind of value, or `raise_exception`, naming the line and
		// column in the template.
		def render(values map<string, any>) !string {
			let renderer = new Renderer(options.autoescape, functions)
			for let (name, value) in values {
				renderer.globals.set(name, fromAny(value))
			}
			return try renderer.run(body)
		}

		// Adds a function the template can call, such as `raise_exception`
		// or `strftime_now`. It gets the call's arguments as plain values
		// (lists as `any[]`, dicts as `map<string, any>`); its result goes
		// back the same way.
		def define(name string, fn def (args any[]) !any) {
			functions.set(name, fn)
		}
	}

	// Parses `source`.
	// Fails at the first syntax error, naming its line and column.
	def parse(source string, options Options = Options{}) !Template {
		let tokens = try (new Lexer(source, options)).tokens()
		let body = try (new Parser(tokens)).template()
		return new Template(body, options)
	}
}
