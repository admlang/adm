partial module std.text.templates.jinja {
	use std.testing

	check "Jinja templates" {
		internal def render(source string, values map<string, any> = new map<string, any>(), options Options = Options{}) !string {
			let template = try parse(source, options)
			return try template.render(values)
		}

		// Expected outputs are what Jinja2 3.1 renders.
		@test()
		def TestExpressions() !none {
			assert (try render("\{\{ 1 + 2 * 3 \}\}|\{\{ 7 // 2 \}\}|\{\{ -7 // 2 \}\}|\{\{ 7 % 3 \}\}|\{\{ -7 % 3 \}\}|\{\{ 2 ** 10 \}\}|\{\{ 7 / 2 \}\}")) == "7|3|-4|1|2|1024|3.5"
			assert (try render("\{\{ 'a' ~ 1 ~ none \}\}|\{\{ 'ab' * 3 \}\}|\{\{ [1, 2] + [3] \}\}|\{\{ (1, 'x') \}\}|\{\{ \{'k': [true, none]\} \}\}")) == "a1None|ababab|[1, 2, 3]|(1, 'x')|\{'k': [True, None]\}"
			assert (try render("\{\{ 1 < 2 < 3 \}\}|\{\{ 'b' in 'abc' \}\}|\{\{ 4 not in [1, 2] \}\}|\{\{ not 0 and 'yes' or 'no' \}\}|\{\{ 'x' if false \}\}|\{\{ 'y' if 0 else 'z' \}\}")) == "True|True|True|yes||z"
			assert (try render("\{\{ 0.1 + 0.2 \}\}|\{\{ 1e20 \}\}|\{\{ 2.0 \}\}|\{\{ 1e-5 \}\}|\{\{ 'it''s' \}\}|\{\{ \"say \\\"hi\\\"\" \}\}")) == "0.30000000000000004|1e+20|2.0|1e-05|its|say \"hi\""
			let values = map<string, any>{"s": "Hello World", "xs": int[3, 1, 2], "d": map<string, any>{"b": 1, "a": 2}}
			assert (try render("\{\{ s[0] \}\}\{\{ s[-1] \}\}|\{\{ s[1:4] \}\}|\{\{ s[::-1] \}\}|\{\{ xs[1:] \}\}|\{\{ d.b \}\}\{\{ d['a'] \}\}|\{\{ d.missing is defined \}\}", values)) == "Hd|ell|dlroW olleH|[1, 2]|12|False"
			return none
		}

		@test()
		def TestWhitespaceControl() !none {
			let source = "<ul>\n  \{% for x in xs %\}\n  <li>\{\{ x \}\}</li>\n  \{% endfor %\}\n</ul>"
			let values = map<string, any>{"xs": string["a", "b"]}
			assert (try render(source, values)) == "<ul>\n  \n  <li>a</li>\n  \n  <li>b</li>\n  \n</ul>"
			assert (try render(source, values, Options{trimBlocks: true, lstripBlocks: true})) == "<ul>\n  <li>a</li>\n  <li>b</li>\n</ul>"
			assert (try render("a  \{%- if true -%\}  b  \{%- endif %\} c")) == "ab c"
			assert (try render("x \{# note #\} y\n\{#- gone -#\}\nz")) == "x  yz"
			assert (try render("\{% raw %\}\{\{ kept \}\}\{% endraw %\}")) == "\{\{ kept \}\}"
			return none
		}

		@test()
		def TestStatements() !none {
			let loop = "\{% for x in xs if x != 2 %\}\{\{ loop.index \}\}/\{\{ loop.length \}\}:\{\{ x \}\}\{\{ ',' if not loop.last \}\}\{% else %\}none\{% endfor %\}"
			assert (try render(loop, map<string, any>{"xs": int[1, 2, 3]})) == "1/2:1,2/2:3"
			assert (try render(loop, map<string, any>{"xs": int[]})) == "none"
			assert (try render("\{% for k, v in d.items() %\}\{\{ k \}\}=\{\{ v \}\};\{% endfor %\}", map<string, any>{"d": map<string, any>{"x": 1, "y": 2}})) == "x=1;y=2;"
			assert (try render("\{% for x in range(5) %\}\{% if x == 1 %\}\{% continue %\}\{% endif %\}\{% if x == 3 %\}\{% break %\}\{% endif %\}\{\{ x \}\}\{% endfor %\}")) == "02"
			// A loop's `set` stays in the loop; a namespace carries it out.
			assert (try render("\{% set n = 0 %\}\{% set ns = namespace(n=0) %\}\{% for x in [1, 2] %\}\{% set n = n + x %\}\{% set ns.n = ns.n + x %\}\{% endfor %\}\{\{ n \}\} \{\{ ns.n \}\}")) == "0 3"
			assert (try render("\{% macro greet(name, greeting='Hi') %\}\{\{ greeting \}\} \{\{ name \}\}!\{% endmacro %\}\{\{ greet('Ann') \}\} \{\{ greet('Bo', greeting='Yo') \}\}")) == "Hi Ann! Yo Bo!"
			assert (try render("\{% macro box() %\}[\{\{ caller() \}\}]\{% endmacro %\}\{% call box() %\}in\{% endcall %\}")) == "[in]"
			assert (try render("\{% filter upper %\}shout\{% endfilter %\}|\{% set block %\}b\{\{ 1 \}\}\{% endset %\}\{\{ block \}\}")) == "SHOUT|b1"
			assert (try render("\{% if a %\}A\{% elif b %\}B\{% else %\}C\{% endif %\}", map<string, any>{"b": true})) == "B"
			return none
		}

		@test()
		def TestFilters() !none {
			let values = map<string, any>{"xs": string["b", "A", "c"], "people": [map<string, any>{"name":"Zed", "age":30}, map<string, any>{"name":"Amy", "age":25}]}
			assert (try render("\{\{ xs|sort|join(',') \}\}|\{\{ xs|length \}\}|\{\{ xs|first \}\}\{\{ xs|last \}\}|\{\{ xs|reverse|list \}\}|\{\{ ' x '|trim \}\}|\{\{ 'ab'|upper \}\}\{\{ 'CD'|lower \}\}", values)) == "A,b,c|3|bc|['c', 'A', 'b']|x|ABcd"
			assert (try render("\{\{ people|map(attribute='name')|join(' ') \}\}|\{\{ people|sort(attribute='age')|map(attribute='name')|first \}\}|\{\{ people|selectattr('age', 'gt', 26)|list|length \}\}", values)) == "Zed Amy|Amy|1"
			assert (try render("\{\{ undefined_thing|default('d') \}\}|\{\{ ''|default('e', true) \}\}|\{\{ 3.7|int \}\}|\{\{ '12'|int + 1 \}\}|\{\{ 2|float \}\}|\{\{ 2.567|round(2) \}\}|\{\{ -3|abs \}\}")) == "d|e|3|13|2.0|2.57|3"
			assert (try render("\{\{ 'a-b-c'.split('-') \}\}|\{\{ 'hello world'.title() \}\}|\{\{ '  x '.strip() \}\}|\{\{ 'abc'.startswith(('x', 'a')) \}\}|\{\{ '%s=%d'|format('n', 5) \}\}|\{\{ '\{\}-\{\}'.format(1, 2) \}\}")) == "['a', 'b', 'c']|Hello World|x|True|n=5|1-2"
			assert (try render("\{\{ 'line1\nline2'|indent(2) \}\}|\{\{ [1, 2, 2, 3]|unique|list \}\}|\{\{ [3, 1]|max \}\}\{\{ [3, 1]|min \}\}|\{\{ [1, 2, 3]|sum \}\}|\{\{ \{'b': 1, 'a': 2\}|dictsort \}\}")) == "line1\n  line2|[1, 2, 3]|31|6|[('a', 2), ('b', 1)]"
			return none
		}

		@test()
		def TestToJson() !none {
			let values = map<string, any>{"tool": map<string, any>{"name": "f", "args": map<string, any>{"x": 1.5, "ok": true, "none": none}, "list": int[1, 2], "text": "é \"q\"\n"}}
			assert (try render("\{\{ tool|tojson \}\}", values)) == "\{\"name\": \"f\", \"args\": \{\"x\": 1.5, \"ok\": true, \"none\": null\}, \"list\": [1, 2], \"text\": \"é \\\"q\\\"\\n\"\}"
			assert (try render("\{\{ tool.args|tojson(indent=2) \}\}", values)) == "\{\n  \"x\": 1.5,\n  \"ok\": true,\n  \"none\": null\n\}"
			assert (try render("\{\{ \{'b': 1, 'a': []\}|tojson(sort_keys=true) \}\}")) == "\{\"a\": [], \"b\": 1\}"
			return none
		}

		@test()
		def TestTests() !none {
			assert (try render("\{\{ x is defined \}\}\{\{ y is undefined \}\}\{\{ none is none \}\}\{\{ 'a' is string \}\}\{\{ 3 is number \}\}\{\{ 4 is even \}\}\{\{ \{\} is mapping \}\}\{\{ [] is iterable \}\}\{\{ 6 is divisibleby 3 \}\}\{\{ 'x' is not in 'abc' \}\}", map<string, any>{"x": 1})) == "TrueTrueTrueTrueTrueTrueTrueTrueTrueTrue"
			return none
		}

		@test()
		def TestAutoescape() !none {
			let values = map<string, any>{"html": "<b>&", "kept": Safe{text: "<i>"}}
			let options = Options{autoescape: true}
			assert (try render("\{\{ html \}\}\{\{ kept \}\}\{\{ '<u>'|safe \}\}", values, options)) == "&lt;b&gt;&amp;<i><u>"
			assert (try render("\{\{ html \}\}", values)) == "<b>&"
			assert (try render("\{\{ html|e \}\}", values)) == "&lt;b&gt;&amp;"
			return none
		}

		@test()
		def TestFunctionsAndErrors() !none {
			let template = try parse("\{\{ greet('Ann', loud=true) \}\}\{\{ raise_exception('stop') if fail \}\}")
			template.define("greet", def (args any[]) !any {
				return "hi {args[0]}"
			})
			template.define("raise_exception", def (args any[]) !any {
				fail "{args[0]}"
			})
			assert (try template.render(map<string, any>{"fail": false})) == "hi Ann"
			try testing.expectError(template.render(map<string, any>{"fail": true}))
			try testing.expectError(parse("\{% if x %\}open"))
			try testing.expectError(parse("\{\{ 1 + \}\}"))
			try testing.expectError(render("\{\{ missing.attribute \}\}"))
			return none
		}
	}
}
