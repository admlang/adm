internal partial module std.text.templates.jinja.runtime {
	use (
		std.reflection
		std.reflection::(FieldKind)
		std.math
		std.strings
		std.text.templates.jinja::*
		std.text.templates.jinja.syntax::*
	)

	// Values ---------------------------------------------------------------

	enum Kind {
		Undefined,
		None,
		Boolean,
		Integer,
		Float,
		String,
		List,
		Dict,
		Callable,
	}

	enum CallableKind {
		// A `macro`, or the `caller` of a `call` block.
		Macro,
		// A method of `receiver`, by `name`.
		Method,
		// A global function (`range`, `namespace`, ...), by `name`.
		Global,
		// A function the program added with `Template.define`, by `name`.
		Defined,
		// `loop.cycle`, `integer` being the loop's index0.
		Cycle,
		// A `joiner`: the separator in `receiver`, `integer` 1 once called.
		Joiner,
		// A `cycler`: its items in `receiver`.
		Cycler,
	}

	// A template value, with Python's semantics. The fields a kind uses:
	// Boolean flag; Integer integer; Float number; String text, flag =
	// safe; Undefined text = the name that was missing; List items, flag =
	// tuple; Dict keys + values, flag = namespace; Callable call.
	type Value {
		kind     Kind
		flag     bool
		integer  int
		number   float
		text     string
		items    Value[]
		keys     Value[]
		values   Value[]
		slots    map<string, int>
		call     CallableKind
		name     string
		node     Node
		receiver ?Value
		frame    int

		def new(kind Kind) {
			self.kind = kind
		}

		// The value of `key` in a dict; `none` when absent.
		def lookup(key Value) ?Value {
			return none unless kind == Kind.Dict
			let at = slots.get(identity(key))
			return at is none ?? (none, values[at])
		}

		def lookup(key string) ?Value {
			return lookup(textValue(key))
		}

		// Sets `key` in a dict, keeping the first position of a key.
		def put(key Value, value Value) {
			let id = identity(key)
			let at = slots.get(id)
			if at is none {
				slots.set(id, keys.len())
				keys.push(key)
				values.push(value)
			} else {
				values[at] = value
			}
		}

		def put(key string, value Value) {
			put(textValue(key), value)
		}

		def remove(key Value) {
			let id = identity(key)
			let at = slots.get(id)
			return when at is none
			keys.remove(at)
			values.remove(at)
			slots = new map<string, int>()
			for let (k, v) in keys {
				slots.set(identity(v), k)
			}
		}
	}

	// A key's identity in a dict: equal Python keys share one (1, 1.0 and
	// True do, as they hash alike).
	def identity(key Value) string {
		match key.kind {
			case Kind.String:
				return "s" + key.text
			case Kind.Integer:
				return "i{key.integer}"
			case Kind.Boolean:
				return key.flag ?? ("i1", "i0")
			case Kind.Float:
				return "i{int(key.number)}" when key.number == float(int(key.number))
				return "f" + floatRepr(key.number)
			case Kind.None:
				return "n"
			case Kind.List:
				let parts string[]
				for let (_, item) in key.items {
					parts.push(identity(item))
				}
				return "(" + parts.join(",") + ")"
			default:
		}
		return "?" + repr(key)
	}

	def undefined(name string) Value {
		let v = new Value(Kind.Undefined)
		v.text = name
		return v
	}

	def nothing() Value {
		return new Value(Kind.None)
	}

	def boolean(b bool) Value {
		let v = new Value(Kind.Boolean)
		v.flag = b
		return v
	}

	def integer(n int) Value {
		let v = new Value(Kind.Integer)
		v.integer = n
		return v
	}

	def number(f float) Value {
		let v = new Value(Kind.Float)
		v.number = f
		return v
	}

	def textValue(s string) Value {
		let v = new Value(Kind.String)
		v.text = s
		return v
	}

	def markup(s string) Value {
		let v = textValue(s)
		v.flag = true
		return v
	}

	def list(items Value[]) Value {
		let v = new Value(Kind.List)
		v.items = items
		return v
	}

	def tuple(items Value[]) Value {
		let v = list(items)
		v.flag = true
		return v
	}

	def dict() Value {
		let v = new Value(Kind.Dict)
		v.slots = new map<string, int>()
		return v
	}

	def callable(kind CallableKind, name string) Value {
		let v = new Value(Kind.Callable)
		v.call = kind
		v.name = name
		return v
	}

	def method(receiver Value, name string) Value {
		let v = callable(CallableKind.Method, name)
		v.receiver = receiver
		return v
	}

	// Python's truth value.
	def truthy(v Value) bool {
		match v.kind {
			case Kind.Undefined, Kind.None:
				return false
			case Kind.Boolean:
				return v.flag
			case Kind.Integer:
				return v.integer != 0
			case Kind.Float:
				return v.number != 0.0
			case Kind.String:
				return v.text.len() > 0
			case Kind.List:
				return v.items.len() > 0
			case Kind.Dict:
				return v.keys.len() > 0
			case Kind.Callable:
				return true
		}
		return false
	}

	def isNumber(v Value) bool {
		return v.kind := Kind.Integer || Kind.Float || Kind.Boolean
	}

	def isInteger(v Value) bool {
		return v.kind := Kind.Integer || Kind.Boolean
	}

	def asInt(v Value) int {
		match v.kind {
			case Kind.Integer:
				return v.integer
			case Kind.Boolean:
				return v.flag ?? (1, 0)
			case Kind.Float:
				return int(v.number)
			default:
		}
		return 0
	}

	def asFloat(v Value) float {
		return v.kind == Kind.Float ?? (v.number, float(asInt(v)))
	}

	// Python's `textValue()`, as `{{ }}` writes a value.
	def text(v Value) string {
		match v.kind {
			case Kind.Undefined:
				return ""
			case Kind.String:
				return v.text
			default:
		}
		return repr(v)
	}

	// Python's `repr()`, as a list or dict shows its members.
	def repr(v Value) string {
		match v.kind {
			case Kind.Undefined:
				return ""
			case Kind.None:
				return "None"
			case Kind.Boolean:
				return v.flag ?? ("True", "False")
			case Kind.Integer:
				return "{v.integer}"
			case Kind.Float:
				return floatRepr(v.number)
			case Kind.String:
				return quoteRepr(v.text)
			case Kind.List:
				let parts string[]
				for let (_, item) in v.items {
					parts.push(repr(item))
				}
				return "(" + parts.join(", ") + (parts.len() == 1 ?? (",)", ")")) when v.flag
				return "[" + parts.join(", ") + "]"
			case Kind.Dict:
				return "<Namespace>" when v.flag
				let parts string[]
				for let (k, key) in v.keys {
					parts.push(repr(key) + ": " + repr(v.values[k]))
				}
				return "\{" + parts.join(", ") + "\}"
			case Kind.Callable:
				return "<function {v.name}>"
		}
		return ""
	}

	// Python's repr of a string: single quotes unless it holds one and no
	// double quote.
	def quoteRepr(s string) string {
		let quote = (s.contains("'") && !s.contains("\"")) ?? ("\"", "'")
		let out byte[]
		out.push(...quote.bytes())
		for let (_, b) in s.bytes() {
			match int(b) {
				case 92:
					out.push(byte(92), byte(92))
				case 10:
					out.push(byte(92), byte(110))
				case 13:
					out.push(byte(92), byte(114))
				case 9:
					out.push(byte(92), byte(116))
				default:
					if b == quote.bytes()[0] {
						out.push(byte(92), b)
					} else if b < byte(32) || b == byte(127) {
						out.push(...("\\x" + hex2(int(b))).bytes())
					} else {
						out.push(b)
					}
			}
		}
		out.push(...quote.bytes())
		return string(out)
	}

	def hex2(n int) string {
		let digits = "0123456789abcdef"
		return digits.slice(n >> 4, (n >> 4) + 1) + digits.slice(n & 15, (n & 15) + 1)
	}

	// Python's `repr()` of a float: the shortest text that reads back as
	// the same number, positional from 1e-4 to 1e16, else with an exponent.
	def floatRepr(f float) string {
		return "nan" when f != f
		return "inf" when f > 1.7976931348623157e308
		return "-inf" when f < -1.7976931348623157e308
		return "0.0" when f == 0.0 && "{f}".startsWith("-") == false
		return "-0.0" when f == 0.0
		let sci = ""
		for let digits = 1; digits <= 17; digits++ {
			sci = strings.format("%." + "{digits - 1}" + "e", f)
			break when parseFloat<float>(sci) == f
		}
		// sci is d.ddde±XX
		let negative = sci.startsWith("-")
		let body = negative ?? (sci.slice(1), sci)
		let e = body.indexOf("e")
		let mantissa = body.slice(0, e).replace(".", "", -1)
		let exponent = parseInt<int>(body.slice(e + 1).trimPrefix("+"))
		for mantissa.len() > 1 && mantissa.endsWith("0") {
			mantissa = mantissa.slice(0, mantissa.len() - 1)
		}
		let out = ""
		if exponent >= -4 && exponent < 16 {
			if exponent >= 0 {
				let whole = mantissa.len() > exponent + 1 ?? (mantissa.slice(0, exponent + 1), mantissa + "0".repeat(exponent + 1 - mantissa.len()))
				let fraction = mantissa.len() > exponent + 1 ?? (mantissa.slice(exponent + 1), "0")
				out = whole + "." + fraction
			} else {
				out = "0." + "0".repeat(-exponent - 1) + mantissa
			}
		} else {
			let lead = mantissa.slice(0, 1)
			let rest = mantissa.slice(1)
			let expText = "{exponent.abs()}".padStart(2, "0")
			out = lead + (rest.len() > 0 ?? ("." + rest, "")) + "e" + (exponent < 0 ?? ("-", "+")) + expText
		}
		return negative ?? ("-" + out, out)
	}

	// Values from the program --------------------------------------------

	// A template value of a program value.
	def fromAny(value any) Value {
		return nothing() when value is none
		match value {
			case Safe:
				return markup(value.text)
			case Value:
				return value
			default:
		}
		let kind = reflection.kindOf(value)
		match kind {
			case FieldKind.String:
				return textValue(reflection.scalarText(value))
			case FieldKind.Bool:
				return boolean(reflection.scalarText(value) == "true")
			case FieldKind.Int, FieldKind.Uint:
				return integer(parseInt<int>(reflection.scalarText(value)))
			case FieldKind.Float:
				return number(parseFloat<float>(reflection.scalarText(value)))
			case FieldKind.Enum:
				return textValue(reflection.scalarText(value))
			case FieldKind.Array:
				let items Value[]
				for let (_, e) in reflection.elements(value) {
					items.push(fromAny(e))
				}
				return list(items)
			case FieldKind.Map:
				let d = dict()
				for let (_, key) in reflection.keysOf(value) {
					let e = reflection.entryOf(value, key)
					d.put(key, e is none ?? (nothing(), fromAny(e)))
				}
				return d
			default:
		}
		let d = dict()
		for let (_, f) in reflection.fields(value) {
			let e = f.value()
			d.put(f.name, e is none ?? (nothing(), fromAny(e)))
		}
		return d
	}

	// A program value of a template value: lists as `any[]`, dicts as
	// `map<string, any>` (keys as their text), undefined and none as `none`.
	def toAny(v Value) any {
		match v.kind {
			case Kind.Undefined, Kind.None:
				return none
			case Kind.Boolean:
				return v.flag
			case Kind.Integer:
				return v.integer
			case Kind.Float:
				return v.number
			case Kind.String:
				return v.text
			case Kind.List:
				let out any[]
				for let (_, item) in v.items {
					out.push(toAny(item))
				}
				return out
			case Kind.Dict:
				let out = new map<string, any>()
				for let (k, key) in v.keys {
					out.set(text(key), toAny(v.values[k]))
				}
				return out
			default:
		}
		return text(v)
	}

	// Rendering ------------------------------------------------------------

	enum Flow {
		Normal,
		Break,
		Continue,
	}

	// One scope: a `for` iteration, a macro call, the template itself.
	type Frame {
		vars map<string, Value>

		def new() {
			vars = new map<string, Value>()
		}
	}

	// Runs a parsed template.
	type Renderer {
		globals             map<string, Value>
		internal autoescape bool
		internal functions  map<string, def (args any[]) !any>
		internal output     string[]
		internal frames     Frame[]
		// The first frame a name is looked up in, going down: a macro sees
		// its own frames and the template's, not its caller's.
		internal base       int

		def new(autoescape bool, functions map<string, def (args any[]) !any>) {
			self.autoescape = autoescape
			self.functions = functions
			globals = new map<string, Value>()
			frames.push(new Frame())
		}

		def run(body Node[]) !string {
			try exec(body)
			return output.join("")
		}

		internal def error(at Node, message string) !none {
			fail "jinja: {at.line}:{at.col}: {message}"
		}

		internal def write(v Value) {
			let s = text(v)
			output.push((autoescape && !(v.kind == Kind.String && v.flag)) ?? (escapeHtml(s), s))
		}

		// Runs `body` and returns what it wrote instead of writing it.
		internal def capture(body Node[]) !string {
			let mark = output.len()
			try exec(body)
			let written = output[mark:].join("")
			output.len(mark)
			return written
		}

		internal def top() Frame {
			return frames[frames.len() - 1]
		}

		internal def lookup(name string) Value {
			for let k = frames.len() - 1; k >= base; k-- {
				let v = frames[k].vars.get(name)
				return v unless v is none
			}
			if base > 0 {
				let v = frames[0].vars.get(name)
				return v unless v is none
			}
			let g = globals.get(name)
			return g unless g is none
			return callable(CallableKind.Defined, name) when functions.hasKey(name)
			return callable(CallableKind.Global, name) when name := "range" || "dict" || "namespace" || "joiner" || "cycler" || "lipsum"
			return undefined(name)
		}

		internal def assign(names string[], value Value, at Node) !none {
			if names.len() == 1 {
				top().vars.set(names[0], value)
				return none
			}
			let items = try iterate(value, at)
			try error(at, "cannot unpack {items.len()} values into {names.len()} names") unless items.len() == names.len()
			for let (k, name) in names {
				top().vars.set(name, items[k])
			}
			return none
		}

		// The items a `for` walks: a list's items, a dict's keys, a string's
		// characters; none for undefined.
		internal def iterate(v Value, at Node) !Value[] {
			match v.kind {
				case Kind.List:
					return v.items
				case Kind.Dict:
					return v.keys
				case Kind.String:
					let out Value[]
					for let (_, c) in v.text {
						out.push(textValue("{c}"))
					}
					return out
				case Kind.Undefined:
					return Value[]
				default:
			}
			try error(at, "{typeName(v)} is not iterable")
			return Value[]
		}

		// Statements -------------------------------------------------------

		internal def exec(body Node[]) !Flow {
			for let (_, n) in body {
				match n.kind {
					case NodeKind.Text:
						output.push(n.text)
					case NodeKind.Output:
						write(try eval(n.children[0]))
					case NodeKind.If:
						let flow = try exec(truthy(try eval(n.children[0])) ?? (n.body, n.orelse))
						return flow unless flow == Flow.Normal
					case NodeKind.For:
						try loop(n)
					case NodeKind.Set:
						let value = try eval(n.children[0])
						if n.flag {
							let ns = lookup(n.text)
							try error(n, "cannot set '{n.targets[0]}' on {typeName(ns)}") unless ns.kind == Kind.Dict && ns.flag
							ns.put(n.targets[0], value)
						} else {
							try assign(n.targets, value, n)
						}
					case NodeKind.SetBlock:
						let written = try capture(n.body)
						try assign(n.targets, autoescape ?? (markup(written), textValue(written)), n)
					case NodeKind.Macro:
						let m = callable(CallableKind.Macro, n.text)
						m.node = n
						top().vars.set(n.text, m)
					case NodeKind.CallBlock:
						let caller = callable(CallableKind.Macro, "caller")
						caller.node = n
						caller.frame = frames.len()
						write(try call(n.children[0], caller))
					case NodeKind.FilterBlock:
						let written = try capture(n.body)
						let frame = new Frame()
						frame.vars.set("\u0000body", autoescape ?? (markup(written), textValue(written)))
						frames.push(frame)
						let result = eval(n.children[0]) onerror (err error) {
							frames.pop()
							return err
						}
						frames.pop()
						write(result)
					case NodeKind.Break:
						return Flow.Break
					case NodeKind.Continue:
						return Flow.Continue
					case NodeKind.Do:
						try eval(n.children[0])
					case NodeKind.Scope:
						let flow = try exec(n.body)
						return flow unless flow == Flow.Normal
					default:
						try error(n, "not a statement")
				}
			}
			return Flow.Normal
		}

		internal def loop(n Node) !none {
			let all = try iterate(try eval(n.children[0]), n)
			let items Value[]
			if n.flag {
				for let (_, item) in all {
					frames.push(new Frame())
					let keep = true
					assign(n.targets, item, n) onerror (err error) {
						frames.pop()
						return err
					}
					keep = truthy(eval(n.children[1]) onerror (err error) {
						frames.pop()
						return err
					})
					frames.pop()
					items.push(item) when keep
				}
			} else {
				items = all
			}
			if items.len() == 0 {
				try exec(n.orelse)
				return none
			}
			let count = items.len()
			for let (k, item) in items {
				let frame = new Frame()
				let info = dict()
				info.flag = true
				info.put("index", integer(k + 1))
				info.put("index0", integer(k))
				info.put("revindex", integer(count - k))
				info.put("revindex0", integer(count - k - 1))
				info.put("first", boolean(k == 0))
				info.put("last", boolean(k == count - 1))
				info.put("length", integer(count))
				info.put("depth", integer(1))
				info.put("depth0", integer(0))
				info.put("previtem", k > 0 ?? (items[k - 1], undefined("previtem")))
				info.put("nextitem", k < count - 1 ?? (items[k + 1], undefined("nextitem")))
				let cycle = callable(CallableKind.Cycle, "cycle")
				cycle.integer = k
				info.put("cycle", cycle)
				frame.vars.set("loop", info)
				frames.push(frame)
				assign(n.targets, item, n) onerror (err error) {
					frames.pop()
					return err
				}
				let flow = exec(n.body) onerror (err error) {
					frames.pop()
					return err
				}
				frames.pop()
				break when flow == Flow.Break
			}
			return none
		}

		// Expressions ------------------------------------------------------

		internal def eval(n Node) !Value {
			match n.kind {
				case NodeKind.Constant:
					match n.constant {
						case ConstantKind.String:
							return textValue(n.text)
						case ConstantKind.Integer:
							return integer(n.integer)
						case ConstantKind.Float:
							return number(n.number)
						case ConstantKind.Boolean:
							return boolean(n.flag)
						case ConstantKind.None:
							return nothing()
					}
				case NodeKind.Name:
					return lookup(n.text)
				case NodeKind.List, NodeKind.Tuple:
					let items Value[]
					for let (_, c) in n.children {
						items.push(try eval(c))
					}
					return n.kind == NodeKind.Tuple ?? (tuple(items), list(items))
				case NodeKind.Dict:
					let d = dict()
					for let k = 0; k + 1 < n.children.len(); k += 2 {
						d.put(try eval(n.children[k]), try eval(n.children[k + 1]))
					}
					return d
				case NodeKind.Attribute:
					return try attribute(try eval(n.children[0]), n.text, n)
				case NodeKind.Item:
					return try item(try eval(n.children[0]), try eval(n.children[1]), n)
				case NodeKind.Slice:
					return try slice(try eval(n.children[0]), try eval(n.children[1]), try eval(n.children[2]), try eval(n.children[3]), n)
				case NodeKind.Call:
					return try call(n, none)
				case NodeKind.Filter:
					let (args, names, kwargs) = try arguments(n, 1)
					return try filter(n.text, try eval(n.children[0]), args, names, kwargs, n)
				case NodeKind.Test:
					let (args, names, kwargs) = try arguments(n, 1)
					let passed = try test(n.text, try eval(n.children[0]), args, n)
					return boolean(passed != n.flag)
				case NodeKind.Negative:
					let v = try eval(n.children[0])
					return integer(-v.integer) when v.kind == Kind.Integer
					return number(-v.number) when v.kind == Kind.Float
					return integer(-asInt(v)) when v.kind == Kind.Boolean
					try error(n, "bad operand for unary -: {typeName(v)}")
				case NodeKind.Positive:
					return try eval(n.children[0])
				case NodeKind.Not:
					return boolean(!truthy(try eval(n.children[0])))
				case NodeKind.And:
					let left = try eval(n.children[0])
					return truthy(left) ?? (try eval(n.children[1]), left)
				case NodeKind.Or:
					let left = try eval(n.children[0])
					return truthy(left) ?? (left, try eval(n.children[1]))
				case NodeKind.Concat:
					return textValue(text(try eval(n.children[0])) + text(try eval(n.children[1])))
				case NodeKind.Binary:
					return try binary(n.text, try eval(n.children[0]), try eval(n.children[1]), n)
				case NodeKind.Compare:
					return boolean(try compare(n.text, try eval(n.children[0]), try eval(n.children[1]), n))
				case NodeKind.Conditional:
					return try eval(n.children[0]) when truthy(try eval(n.children[1]))
					return n.flag ?? (try eval(n.children[2]), undefined(""))
				default:
			}
			try error(n, "not an expression")
			return nothing()
		}

		// Evaluates the arguments of a call, filter or test from child `from` on.
		internal def arguments(n Node, from int) !(Value[], string[], Value[]) {
			let args Value[]
			for let k = from; k < n.children.len(); k++ {
				args.push(try eval(n.children[k]))
			}
			let kwargs Value[]
			for let (_, k) in n.kwargs {
				kwargs.push(try eval(k))
			}
			return (args, n.keywords, kwargs)
		}

		internal def attribute(v Value, name string, at Node) !Value {
			match v.kind {
				case Kind.Undefined:
					try error(at, "'{v.text.len() > 0 ?? (v.text, "value")}' is undefined")
				case Kind.Dict:
					if v.flag {
						let found = v.lookup(name)
						return found is none ?? (undefined(name), found)
					}
					return method(v, name) when isMethod(Kind.Dict, name)
					let found = v.lookup(name)
					return found is none ?? (undefined(name), found)
				case Kind.String, Kind.List:
					return method(v, name) when isMethod(v.kind, name)
				default:
			}
			return undefined(name)
		}

		internal def item(v Value, key Value, at Node) !Value {
			match v.kind {
				case Kind.Undefined:
					try error(at, "'{v.text.len() > 0 ?? (v.text, "value")}' is undefined")
				case Kind.Dict:
					let found = v.lookup(key)
					return found unless found is none
					return try attribute(v, key.text, at) when key.kind == Kind.String && !v.flag
					return undefined(text(key))
				case Kind.List:
					if isInteger(key) {
						let k = asInt(key)
						k += v.items.len() when k < 0
						return (k >= 0 && k < v.items.len()) ?? (v.items[k], undefined("[{asInt(key)}]"))
					}
				case Kind.String:
					if isInteger(key) {
						let n = v.text.len()
						let k = asInt(key)
						k += n when k < 0
						return (k >= 0 && k < n) ?? (textValue(v.text.slice(k, k + 1)), undefined("[{asInt(key)}]"))
					}
				default:
			}
			return try attribute(v, key.text, at) when key.kind == Kind.String
			return undefined(text(key))
		}

		internal def slice(v Value, startValue Value, stopValue Value, stepValue Value, at Node) !Value {
			let step = stepValue.kind == Kind.None ?? (1, asInt(stepValue))
			try error(at, "slice step cannot be zero") when step == 0
			let n = v.kind == Kind.String ?? (v.text.len(), v.items.len())
			try error(at, "cannot slice {typeName(v)}") unless v.kind := Kind.String || Kind.List
			let (start, stop) = sliceBounds(n, startValue, stopValue, step)
			let picked int[]
			if step > 0 {
				for let k = start; k < stop; k += step {
					picked.push(k)
				}
			} else {
				for let k = start; k > stop; k += step {
					picked.push(k)
				}
			}
			if v.kind == Kind.String {
				return textValue(start < stop ?? (v.text.slice(start, stop), "")) when step == 1
				let chars = charsOf(v.text)
				let s = ""
				for let (_, k) in picked {
					s = s + chars[k]
				}
				return textValue(s)
			}
			let items Value[]
			for let (_, k) in picked {
				items.push(v.items[k])
			}
			return v.flag ?? (tuple(items), list(items))
		}

		internal def call(n Node, caller ?Value) !Value {
			let callee = try eval(n.children[0])
			let (args, names, kwargs) = try arguments(n, 1)
			if !(caller is none) {
				names = names.clone()
				names.push("caller")
				kwargs = kwargs.clone()
				kwargs.push(caller)
			}
			return try invoke(callee, args, names, kwargs, n)
		}

		internal def invoke(callee Value, args Value[], names string[], kwargs Value[], at Node) !Value {
			if callee.kind != Kind.Callable {
				try error(at, callee.kind == Kind.Undefined ?? ("'{callee.text}' is undefined", "{typeName(callee)} is not callable"))
			}
			match callee.call {
				case CallableKind.Macro:
					return try macro(callee, args, names, kwargs)
				case CallableKind.Method:
					let receiver = callee.receiver
					return try callMethod(receiver is none ?? (nothing(), receiver), callee.name, args, names, kwargs, at)
				case CallableKind.Global:
					return try global(callee.name, args, names, kwargs, at)
				case CallableKind.Defined:
					let found = functions.get(callee.name)
					return nothing() when found is none
					let fn = found
					let plain any[]
					for let (_, a) in args {
						plain.push(toAny(a))
					}
					if names.len() > 0 {
						let named = new map<string, any>()
						for let (k, name) in names {
							named.set(name, toAny(kwargs[k]))
						}
						plain.push(named)
					}
					let result = fn(plain) onerror (err error) {
						return err
					}
					return fromAny(result)
				case CallableKind.Cycle:
					try error(at, "loop.cycle needs at least one value") when args.len() == 0
					return args[callee.integer % args.len()]
				case CallableKind.Joiner:
					if callee.integer == 0 {
						callee.integer = 1
						return textValue("")
					}
					let r = callee.receiver
					return r is none ?? (textValue(", "), r)
				case CallableKind.Cycler:
					try error(at, "call a cycler's next()")
			}
			return nothing()
		}

		internal def macro(m Value, args Value[], names string[], kwargs Value[]) !Value {
			let def_ = m.node
			let frame = new Frame()
			let params = def_.targets
			let extra Value[]
			for let (k, a) in args {
				if k < params.len() {
					frame.vars.set(params[k], a)
				} else {
					extra.push(a)
				}
			}
			let named = dict()
			for let (k, name) in names {
				if params.includes(name) || name == "caller" {
					frame.vars.set(name, kwargs[k])
				} else {
					named.put(name, kwargs[k])
				}
			}
			frame.vars.set("varargs", list(extra))
			frame.vars.set("kwargs", named)
			let savedBase = base
			// The caller of a call block sees the frames where the block is.
			let callerFrames = m.name == "caller" && def_.kind == NodeKind.CallBlock
			frames.push(frame)
			base = callerFrames ?? (savedBase, frames.len() - 1)
			for let (_, p) in params {
				continue when frame.vars.hasKey(p)
				let d = def_.defaults.get(p)
				let value = d is none ?? (undefined(p), eval(d) onerror (err error) {
					frames.pop()
					base = savedBase
					return err
				})
				frame.vars.set(p, value)
			}
			let written = capture(def_.body) onerror (err error) {
				frames.pop()
				base = savedBase
				return err
			}
			frames.pop()
			base = savedBase
			return autoescape ?? (markup(written), textValue(written))
		}

		// Operators and comparisons ---------------------------------------

		internal def binary(op string, a Value, b Value, at Node) !Value {
			if op == "+" {
				if a.kind == Kind.String && b.kind == Kind.String {
					// Markup + text escapes the text, as markupsafe does.
					return markup(a.text + escapeHtml(b.text)) when a.flag && !b.flag
					return markup(escapeHtml(a.text) + b.text) when b.flag && !a.flag
					return a.flag ?? (markup(a.text + b.text), textValue(a.text + b.text))
				}
				if a.kind == Kind.List && b.kind == Kind.List {
					let items = a.items.clone()
					items.push(...b.items)
					return a.flag ?? (tuple(items), list(items))
				}
			}
			if op == "*" {
				return textValue(a.text.repeat(asInt(b).max(0))) when a.kind == Kind.String && isInteger(b)
				if a.kind == Kind.List && isInteger(b) {
					let items Value[]
					for let k = 0; k < asInt(b); k++ {
						items.push(...a.items)
					}
					return list(items)
				}
			}
			return textValue(try percentFormat(a.text, b.kind == Kind.List && b.flag ?? (b.items, Value[b]), at)) when op == "%" && a.kind == Kind.String
			if !(isNumber(a) && isNumber(b)) {
				try error(at, "unsupported operand types for {op}: {typeName(a)} and {typeName(b)}")
			}
			let ints = isInteger(a) && isInteger(b)
			match op {
				case "+":
					return ints ?? (integer(asInt(a) + asInt(b)), number(asFloat(a) + asFloat(b)))
				case "-":
					return ints ?? (integer(asInt(a) - asInt(b)), number(asFloat(a) - asFloat(b)))
				case "*":
					return ints ?? (integer(asInt(a) * asInt(b)), number(asFloat(a) * asFloat(b)))
				case "/":
					try error(at, "division by zero") when asFloat(b) == 0.0
					return number(asFloat(a) / asFloat(b))
				case "//":
					try error(at, "division by zero") when asFloat(b) == 0.0
					if ints {
						let q = asInt(a) / asInt(b)
						q-- when (asInt(a) % asInt(b) != 0) && ((asInt(a) < 0) != (asInt(b) < 0))
						return integer(q)
					}
					return number((asFloat(a) / asFloat(b)).floor())
				case "%":
					try error(at, "modulo by zero") when asFloat(b) == 0.0
					if ints {
						let r = asInt(a) % asInt(b)
						r += asInt(b) when r != 0 && ((r < 0) != (asInt(b) < 0))
						return integer(r)
					}
					let x = asFloat(a)
					let y = asFloat(b)
					return number(x - y * (x / y).floor())
				case "**":
					if ints && asInt(b) >= 0 {
						let result = 1
						for let k = 0; k < asInt(b); k++ {
							result *= asInt(a)
						}
						return integer(result)
					}
					return number(power(asFloat(a), asFloat(b)))
			}
			try error(at, "unknown operator {op}")
			return nothing()
		}

		internal def compare(op string, a Value, b Value, at Node) !bool {
			match op {
				case "==":
					return equal(a, b)
				case "!=":
					return !equal(a, b)
				case "in":
					return try contains(b, a, at)
				case "notin":
					return !(try contains(b, a, at))
			}
			let order = try ordering(a, b, at)
			match op {
				case "<":
					return order < 0
				case "<=":
					return order <= 0
				case ">":
					return order > 0
			}
			return order >= 0
		}

		internal def contains(container Value, member Value, at Node) !bool {
			match container.kind {
				case Kind.String:
					try error(at, "'in <string>' needs a string, not {typeName(member)}") unless member.kind == Kind.String
					return container.text.contains(member.text)
				case Kind.List:
					for let (_, item) in container.items {
						return true when equal(item, member)
					}
					return false
				case Kind.Dict:
					return !(container.lookup(member) is none)
				case Kind.Undefined:
					return false
				default:
			}
			try error(at, "argument of type {typeName(container)} is not iterable")
			return false
		}

		internal def ordering(a Value, b Value, at Node) !int {
			if isNumber(a) && isNumber(b) {
				let x = asFloat(a)
				let y = asFloat(b)
				return x < y ?? (-1, x > y ?? (1, 0))
			}
			return a.text < b.text ?? (-1, a.text > b.text ?? (1, 0)) when a.kind == Kind.String && b.kind == Kind.String
			if a.kind == Kind.List && b.kind == Kind.List {
				let n = a.items.len().min(b.items.len())
				for let k = 0; k < n; k++ {
					let c = try ordering(a.items[k], b.items[k], at)
					return c unless c == 0
				}
				return a.items.len() - b.items.len()
			}
			try error(at, "cannot compare {typeName(a)} with {typeName(b)}")
			return 0
		}

		// Filters -----------------------------------------------------------

		internal def filter(name string, v Value, args Value[], names string[], kwargs Value[], at Node) !Value {
			let a = new Args(args, names, kwargs)
			match name {
				case "abs":
					return v.kind == Kind.Float ?? (number(v.number.abs()), integer(asInt(v).abs()))
				case "attr":
					return try attribute(v, text(a.at(0, "name", textValue(""))), at)
				case "capitalize":
					return textValue(capitalize(text(v)))
				case "center":
					let width = asInt(a.at(0, "width", integer(80)))
					let s = text(v)
					let pad = (width - s.len()).max(0)
					return textValue(" ".repeat(pad / 2) + s + " ".repeat(pad - pad / 2))
				case "count", "length":
					return integer(try size(v, at))
				case "default", "d":
					let fallback = a.at(0, "default_value", textValue(""))
					let byTruth = truthy(a.at(1, "boolean", boolean(false)))
					return (v.kind == Kind.Undefined || (byTruth && !truthy(v))) ?? (fallback, v)
				case "dictsort":
					try error(at, "dictsort needs a dict") unless v.kind == Kind.Dict
					let byValue = text(a.at(1, "by", textValue("key"))) == "value"
					let caseSensitive = truthy(a.at(0, "case_sensitive", boolean(false)))
					let pairs Value[]
					for let (k, key) in v.keys {
						pairs.push(tuple(Value[key, v.values[k]]))
					}
					let sorted = try sortValues(pairs, (p Value) => p.items[byValue ?? (1, 0)], caseSensitive, at)
					return list(truthy(a.at(2, "reverse", boolean(false))) ?? (sorted.reverse(), sorted))
				case "escape", "e":
					return (v.kind == Kind.String && v.flag) ?? (v, markup(escapeHtml(text(v))))
				case "forceescape":
					return markup(escapeHtml(text(v)))
				case "first":
					let items = try iterate(v, at)
					return items.len() > 0 ?? (items[0], undefined("first"))
				case "last":
					let items = try iterate(v, at)
					return items.len() > 0 ?? (items[items.len() - 1], undefined("last"))
				case "float":
					return try toFloat(v, a.at(0, "default", number(0.0)))
				case "int":
					return try toInt(v, a.at(0, "default", integer(0)), asInt(a.at(1, "base", integer(10))))
				case "format":
					return textValue(try percentFormat(text(v), args, at))
				case "groupby":
					let attr = text(a.at(0, "attribute", textValue("")))
					let items = try iterate(v, at)
					let sorted = try sortValues(items, (x Value) => path(x, attr), false, at)
					let groups Value[]
					for let (_, x) in sorted {
						let key = path(x, attr)
						if groups.len() > 0 && equal(groups[groups.len() - 1].items[0], key) {
							groups[groups.len() - 1].items[1].items.push(x)
						} else {
							groups.push(tuple(Value[key, list(Value[x])]))
						}
					}
					return list(groups)
				case "indent":
					let widthValue = a.at(0, "width", integer(4))
					let prefix = widthValue.kind == Kind.String ?? (widthValue.text, " ".repeat(asInt(widthValue)))
					let first = truthy(a.at(1, "first", boolean(false)))
					let blank = truthy(a.at(2, "blank", boolean(false)))
					let lines = text(v).split("\n")
					for let (k, line) in lines {
						continue when k == 0 && !first
						continue when line.len() == 0 && !blank
						lines[k] = prefix + line
					}
					return textValue(lines.join("\n"))
				case "items":
					return list(Value[]) when v.kind == Kind.Undefined
					try error(at, "items needs a dict") unless v.kind == Kind.Dict
					return try callMethod(v, "items", Value[], string[], Value[], at)
				case "join":
					let separator = text(a.at(0, "d", textValue("")))
					let attr = a.at(1, "attribute", nothing())
					let parts string[]
					let safe = true
					for let (_, x) in try iterate(v, at) {
						let y = attr.kind == Kind.None ?? (x, path(x, text(attr)))
						safe = safe && y.kind == Kind.String && y.flag
						parts.push(text(y))
					}
					return textValue(parts.join(separator))
				case "list":
					return list(try iterate(v, at))
				case "lower":
					return textValue(text(v).lower())
				case "upper":
					return textValue(text(v).upper())
				case "map":
					// Jinja2 yields nothing for a false value (none, "", []).
					return list(Value[]) unless truthy(v)
					let items = try iterate(v, at)
					let out Value[]
					let attr = a.named("attribute")
					if !(attr is none) {
						let fallback = a.named("default")
						for let (_, x) in items {
							let y = path(x, text(attr))
							out.push((y.kind == Kind.Undefined && !(fallback is none)) ?? (fallback, y))
						}
						return list(out)
					}
					try error(at, "map needs a filter name or attribute=") when args.len() == 0
					let inner = text(args[0])
					for let (_, x) in items {
						out.push(try filter(inner, x, args[1:], names, kwargs, at))
					}
					return list(out)
				case "max", "min":
					let items = try iterate(v, at)
					return undefined(name) when items.len() == 0
					let attr = a.at(1, "attribute", nothing())
					let key = def (x Value) Value {
						return attr.kind == Kind.None ?? (x, path(x, text(attr)))
					}
					let sorted = try sortValues(items, key, truthy(a.at(0, "case_sensitive", boolean(false))), at)
					return name == "min" ?? (sorted[0], sorted[sorted.len() - 1])
				case "reject", "select":
					// Jinja2 yields nothing for a false value (none, "", []).
					return list(Value[]) unless truthy(v)
					let out Value[]
					for let (_, x) in try iterate(v, at) {
						let passed = args.len() == 0 ?? (truthy(x), try test(text(args[0]), x, args[1:], at))
						out.push(x) when passed == (name == "select")
					}
					return list(out)
				case "rejectattr", "selectattr":
					// Jinja2 yields nothing for a false value (none, "", []).
					return list(Value[]) unless truthy(v)
					let out Value[]
					let attr = text(a.at(0, "attr", textValue("")))
					for let (_, x) in try iterate(v, at) {
						let y = path(x, attr)
						let passed = args.len() < 2 ?? (truthy(y), try test(text(args[1]), y, args[2:], at))
						out.push(x) when passed == (name == "selectattr")
					}
					return list(out)
				case "replace":
					let count = asInt(a.at(2, "count", integer(-1)))
					return textValue(text(v).replace(text(a.at(0, "old", textValue(""))), text(a.at(1, "new", textValue(""))), count))
				case "reverse":
					return textValue(reverseString(v.text)) when v.kind == Kind.String
					return list((try iterate(v, at)).clone().reverse())
				case "round":
					let precision = asInt(a.at(0, "precision", integer(0)))
					let how = text(a.at(1, "method", textValue("common")))
					let scale = power(10.0, float(precision))
					let x = asFloat(v) * scale
					let r = how == "floor" ?? (x.floor(), how == "ceil" ?? (x.ceil(), (x.abs() + 0.5).floor() * (x < 0.0 ?? (-1.0, 1.0))))
					return number(r / scale)
				case "safe":
					return markup(text(v))
				case "sort":
					let attr = a.at(2, "attribute", nothing())
					let key = def (x Value) Value {
						return attr.kind == Kind.None ?? (x, path(x, text(attr)))
					}
					let sorted = try sortValues(try iterate(v, at), key, truthy(a.at(1, "case_sensitive", boolean(false))), at)
					return list(truthy(a.at(0, "reverse", boolean(false))) ?? (sorted.reverse(), sorted))
				case "string":
					return (v.kind == Kind.String) ?? (v, textValue(text(v)))
				case "sum":
					let attr = a.at(0, "attribute", nothing())
					let total = a.at(1, "start", integer(0))
					for let (_, x) in try iterate(v, at) {
						total = try binary("+", total, attr.kind == Kind.None ?? (x, path(x, text(attr))), at)
					}
					return total
				case "title":
					return textValue(title(text(v)))
				case "tojson":
					let indentValue = a.at(0, "indent", nothing())
					let indent = indentValue.kind == Kind.None ?? (-1, asInt(indentValue))
					let sortKeys = truthy(a.at(99, "sort_keys", boolean(false)))
					let separators = a.named("separators")
					let itemSep = indent >= 0 ?? (",", ", ")
					let keySep = ": "
					if !(separators is none) && separators.kind == Kind.List && separators.items.len() == 2 {
						itemSep = text(separators.items[0])
						keySep = text(separators.items[1])
					}
					let ascii = truthy(a.at(99, "ensure_ascii", boolean(false)))
					return textValue(json(v, indent, 0, itemSep, keySep, sortKeys, ascii))
				case "trim":
					let chars = a.at(0, "chars", nothing())
					return textValue(chars.kind == Kind.None ?? (pyStrip(text(v), whitespace, left = true, right = true), pyStrip(text(v), text(chars), left = true, right = true)))
				case "truncate":
					let s = text(v)
					let length = asInt(a.at(0, "length", integer(255)))
					let end = text(a.at(2, "end", textValue("...")))
					return v when s.len() <= length + asInt(a.at(4, "leeway", integer(5)))
					return textValue(s.slice(0, (length - end.len()).max(0)) + end)
				case "unique":
					let out Value[]
					let seen = new map<string, bool>()
					let attr = a.at(1, "attribute", nothing())
					let caseSensitive = truthy(a.at(0, "case_sensitive", boolean(false)))
					for let (_, x) in try iterate(v, at) {
						let key = attr.kind == Kind.None ?? (x, path(x, text(attr)))
						let id = (key.kind == Kind.String && !caseSensitive) ?? ("s" + key.text.lower(), identity(key))
						continue when seen.hasKey(id)
						seen.set(id, true)
						out.push(x)
					}
					return list(out)
				case "wordcount":
					return integer(text(v).split(" ").filter(w => w.trim().len() > 0).len())
			}
			try error(at, "no filter named '{name}'")
			return nothing()
		}

		// Tests -------------------------------------------------------------

		internal def test(name string, v Value, args Value[], at Node) !bool {
			let arg = args.len() > 0 ?? (args[0], undefined(""))
			match name {
				case "defined":
					return v.kind != Kind.Undefined
				case "undefined":
					return v.kind == Kind.Undefined
				case "none":
					return v.kind == Kind.None
				case "boolean":
					return v.kind == Kind.Boolean
				case "true":
					return v.kind == Kind.Boolean && v.flag
				case "false":
					return v.kind == Kind.Boolean && !v.flag
				case "integer":
					return v.kind == Kind.Integer
				case "float":
					return v.kind == Kind.Float
				case "number":
					return isNumber(v)
				case "string":
					return v.kind == Kind.String
				case "mapping":
					return v.kind == Kind.Dict && !v.flag
				case "iterable":
					return v.kind := Kind.List || Kind.Dict || Kind.String
				case "sequence":
					return v.kind := Kind.List || Kind.Dict || Kind.String
				case "callable":
					return v.kind == Kind.Callable
				case "sameas":
					return equal(v, arg) && v.kind == arg.kind
				case "eq", "equalto", "==":
					return equal(v, arg)
				case "ne", "!=":
					return !equal(v, arg)
				case "lt", "lessthan", "<":
					return (try ordering(v, arg, at)) < 0
				case "le", "<=":
					return (try ordering(v, arg, at)) <= 0
				case "gt", "greaterthan", ">":
					return (try ordering(v, arg, at)) > 0
				case "ge", ">=":
					return (try ordering(v, arg, at)) >= 0
				case "in":
					return try contains(arg, v, at)
				case "even":
					return asInt(v) % 2 == 0
				case "odd":
					return asInt(v) % 2 != 0
				case "divisibleby":
					return asInt(arg) != 0 && asInt(v) % asInt(arg) == 0
				case "lower":
					return text(v) == text(v).lower()
				case "upper":
					return text(v) == text(v).upper()
				case "escaped":
					return v.kind == Kind.String && v.flag
			}
			try error(at, "no test named '{name}'")
			return false
		}

		// Methods -----------------------------------------------------------

		internal def callMethod(v Value, name string, args Value[], names string[], kwargs Value[], at Node) !Value {
			let a = new Args(args, names, kwargs)
			if v.kind == Kind.String {
				let s = v.text
				match name {
					case "startswith", "endswith":
						let arg = a.at(0, "prefix", textValue(""))
						let options = arg.kind == Kind.List ?? (arg.items, Value[arg])
						for let (_, o) in options {
							return boolean(true) when (name == "startswith" ?? (s.startsWith(text(o)), s.endsWith(text(o))))
						}
						return boolean(false)
					case "split", "rsplit":
						let sep = a.at(0, "sep", nothing())
						let limit = asInt(a.at(1, "maxsplit", integer(-1)))
						let parts = sep.kind == Kind.None ?? (splitWhitespace(s, limit, name == "rsplit"), splitBy(s, text(sep), limit, name == "rsplit"))
						let out Value[]
						for let (_, p) in parts {
							out.push(textValue(p))
						}
						return list(out)
					case "strip", "lstrip", "rstrip":
						let chars = a.at(0, "chars", nothing())
						let set = chars.kind == Kind.None ?? (whitespace, text(chars))
						return textValue(pyStrip(s, set, name != "rstrip", name != "lstrip"))
					case "replace":
						return textValue(s.replace(text(a.at(0, "old", textValue(""))), text(a.at(1, "new", textValue(""))), asInt(a.at(2, "count", integer(-1)))))
					case "lower":
						return textValue(s.lower())
					case "upper":
						return textValue(s.upper())
					case "title":
						return textValue(title(s))
					case "capitalize":
						return textValue(capitalize(s))
					case "find", "index":
						let at_ = s.indexOf(text(a.at(0, "sub", textValue(""))))
						try error(at, "substring not found") when at_ < 0 && name == "index"
						return integer(at_)
					case "count":
						return integer(s.split(text(a.at(0, "sub", textValue("")))).len() - 1)
					case "join":
						let parts string[]
						for let (_, x) in try iterate(a.at(0, "iterable", list(Value[])), at) {
							parts.push(text(x))
						}
						return textValue(parts.join(s))
					case "format":
						return textValue(try braceFormat(s, args, names, kwargs, at))
					case "isdigit", "isalpha", "isalnum", "isspace", "islower", "isupper":
						return boolean(classify(s, name))
				}
			}
			if v.kind == Kind.List {
				match name {
					case "append":
						v.items.push(a.at(0, "object", nothing()))
						return nothing()
					case "pop":
						try error(at, "pop from empty list") when v.items.len() == 0
						let k = asInt(a.at(0, "index", integer(-1)))
						k += v.items.len() when k < 0
						let x = v.items[k]
						v.items.remove(k)
						return x
					case "index":
						let target = a.at(0, "value", nothing())
						for let (k, x) in v.items {
							return integer(k) when equal(x, target)
						}
						try error(at, "value is not in list")
					case "count":
						let target = a.at(0, "value", nothing())
						let n = 0
						for let (_, x) in v.items {
							n++ when equal(x, target)
						}
						return integer(n)
					case "insert":
						let k = asInt(a.at(0, "index", integer(0))).clamp(0, v.items.len())
						v.items.push(nothing())
						for let j = v.items.len() - 1; j > k; j-- {
							v.items[j] = v.items[j - 1]
						}
						v.items[k] = a.at(1, "object", nothing())
						return nothing()
				}
			}
			if v.kind == Kind.Dict {
				match name {
					case "items":
						let out Value[]
						for let (k, key) in v.keys {
							out.push(tuple(Value[key, v.values[k]]))
						}
						return list(out)
					case "keys":
						return list(v.keys.clone())
					case "values":
						return list(v.values.clone())
					case "get":
						let found = v.lookup(a.at(0, "key", nothing()))
						return found is none ?? (a.at(1, "default", nothing()), found)
					case "update":
						let other = a.at(0, "other", dict())
						for let (k, key) in other.keys {
							v.put(key, other.values[k])
						}
						for let (k, n) in names {
							v.put(n, kwargs[k])
						}
						return nothing()
					case "pop":
						let key = a.at(0, "key", nothing())
						let found = v.lookup(key)
						return a.at(1, "default", undefined(text(key))) when found is none
						v.remove(key)
						return found
					case "copy":
						let d = dict()
						for let (k, key) in v.keys {
							d.put(key, v.values[k])
						}
						return d
				}
			}
			try error(at, "{typeName(v)} has no method '{name}'")
			return nothing()
		}

		// Globals -----------------------------------------------------------

		internal def global(name string, args Value[], names string[], kwargs Value[], at Node) !Value {
			match name {
				case "range":
					let start = args.len() > 1 ?? (asInt(args[0]), 0)
					let stop = args.len() > 1 ?? (asInt(args[1]), args.len() > 0 ?? (asInt(args[0]), 0))
					let step = args.len() > 2 ?? (asInt(args[2]), 1)
					try error(at, "range step cannot be zero") when step == 0
					let items Value[]
					for let k = start; (step > 0 ?? (k < stop, k > stop)); k += step {
						items.push(integer(k))
					}
					return list(items)
				case "dict", "namespace":
					let d = dict()
					d.flag = name == "namespace"
					for let (_, a) in args {
						continue unless a.kind == Kind.Dict
						for let (k, key) in a.keys {
							d.put(key, a.values[k])
						}
					}
					for let (k, n) in names {
						d.put(n, kwargs[k])
					}
					return d
				case "joiner":
					let j = callable(CallableKind.Joiner, "joiner")
					j.receiver = args.len() > 0 ?? (args[0], textValue(", "))
					return j
				case "cycler":
					let c = dict()
					c.flag = true
					c.put("items", list(args))
					return c
			}
			try error(at, "'{name}' is undefined")
			return nothing()
		}

		// Sorts by `key` of each value, as Python's sorted() does; strings
		// ignore case unless `caseSensitive`.
		internal def sortValues(items Value[], key def (x Value) Value, caseSensitive bool, at Node) !Value[] {
			let keys Value[]
			for let (_, x) in items {
				let k = key(x)
				keys.push((k.kind == Kind.String && !caseSensitive) ?? (textValue(k.text.lower()), k))
			}
			let order int[]
			for let k = 0; k < items.len(); k++ {
				order.push(k)
			}
			// Insertion sort keeps equal keys in order, as Python's does.
			for let i = 1; i < order.len(); i++ {
				let j = i
				for j > 0 && (try ordering(keys[order[j - 1]], keys[order[j]], at)) > 0 {
					let t = order[j - 1]
					order[j - 1] = order[j]
					order[j] = t
					j--
				}
			}
			let out Value[]
			for let (_, k) in order {
				out.push(items[k])
			}
			return out
		}

		// A value's length, as Python's len().
		internal def size(v Value, at Node) !int {
			match v.kind {
				case Kind.String:
					return v.text.len()
				case Kind.List:
					return v.items.len()
				case Kind.Dict:
					return v.keys.len()
				case Kind.Undefined:
					return 0
				default:
			}
			try error(at, "object of type {typeName(v)} has no len()")
			return 0
		}

		internal def toFloat(v Value, fallback Value) !Value {
			return number(asFloat(v)) when isNumber(v)
			if v.kind == Kind.String {
				let s = v.text.trim()
				return number(parseFloat<float>(s)) when looksNumeric(s)
			}
			return fallback
		}

		internal def toInt(v Value, fallback Value, base int) !Value {
			return integer(asInt(v)) when isNumber(v)
			if v.kind == Kind.String {
				let s = v.text.trim()
				return integer(parseInt<int>(s, base)) when s.len() > 0 && looksNumeric(s) && !s.contains(".")
				return integer(int(parseFloat<float>(s))) when looksNumeric(s)
			}
			return fallback
		}

		// Python's `"%s" % args`: %s, %r, %d, %i, %f (with precision), %x, %%.
		internal def percentFormat(pattern string, args Value[], at Node) !string {
			let out = ""
			let next = 0
			let chars = charsOf(pattern)
			for let k = 0; k < chars.len(); k++ {
				let c = chars[k]
				if c != "%" || k + 1 >= chars.len() {
					out = out + c
					continue
				}
				let spec = ""
				let j = k + 1
				for j < chars.len() && "0123456789.-+ #".contains(chars[j]) {
					spec = spec + chars[j]
					j++
				}
				let verb = chars[j]
				k = j
				if verb == "%" {
					out = out + "%"
					continue
				}
				try error(at, "not enough arguments for format string") when next >= args.len()
				let arg = args[next]
				next++
				match verb {
					case "s":
						out = out + strings.format("%" + spec + "s", text(arg))
					case "r":
						out = out + strings.format("%" + spec + "s", repr(arg))
					case "d", "i":
						out = out + strings.format("%" + spec + "d", asInt(arg))
					case "f", "e", "g":
						out = out + strings.format("%" + spec + verb, asFloat(arg))
					case "x", "X", "o":
						out = out + strings.format("%" + spec + verb, asInt(arg))
					default:
						try error(at, "unsupported format character '{verb}'")
				}
			}
			return out
		}

		// Python's `str.format`: `{}`, `{0}`, `{name}`, `{{` and `}}`.
		internal def braceFormat(pattern string, args Value[], names string[], kwargs Value[], at Node) !string {
			let out = ""
			let next = 0
			let chars = charsOf(pattern)
			for let k = 0; k < chars.len(); k++ {
				let c = chars[k]
				if c == "\{" && k + 1 < chars.len() && chars[k + 1] == "\{" {
					out = out + "\{"
					k++
					continue
				}
				if c == "\}" && k + 1 < chars.len() && chars[k + 1] == "\}" {
					out = out + "\}"
					k++
					continue
				}
				if c != "\{" {
					out = out + c
					continue
				}
				let field = ""
				let j = k + 1
				for j < chars.len() && chars[j] != "\}" {
					field = field + chars[j]
					j++
				}
				k = j
				let colon = field.indexOf(":")
				let key = colon >= 0 ?? (field.slice(0, colon), field)
				let v Value
				if key.len() == 0 {
					try error(at, "not enough arguments for format string") when next >= args.len()
					v = args[next]
					next++
				} else if looksNumeric(key) {
					let n = parseInt<int>(key)
					try error(at, "format index {n} out of range") when n >= args.len()
					v = args[n]
				} else {
					let n = names.indexOf(key)
					try error(at, "no argument named '{key}'") when n < 0
					v = kwargs[n]
				}
				out = out + text(v)
			}
			return out
		}
	}

	def typeName(v Value) string {
		match v.kind {
			case Kind.Undefined:
				return "undefined"
			case Kind.None:
				return "none"
			case Kind.Boolean:
				return "bool"
			case Kind.Integer:
				return "int"
			case Kind.Float:
				return "float"
			case Kind.String:
				return "str"
			case Kind.List:
				return v.flag ?? ("tuple", "list")
			case Kind.Dict:
				return "dict"
			default:
		}
		return "function"
	}

	def escapeHtml(s string) string {
		return s.replace("&", "&amp;", -1).replace("<", "&lt;", -1).replace(">", "&gt;", -1).replace("\"", "&#34;", -1).replace("'", "&#39;", -1)
	}

	// Python's slice bounds of `n` items: the first index and the one to
	// stop before.
	def sliceBounds(n int, startValue Value, stopValue Value, step int) (int, int) {
		let start = 0
		let stop = 0
		if step > 0 {
			start = startValue.kind == Kind.None ?? (0, asInt(startValue))
			stop = stopValue.kind == Kind.None ?? (n, asInt(stopValue))
			start = (start < 0 ?? (start + n, start)).clamp(0, n)
			stop = (stop < 0 ?? (stop + n, stop)).clamp(0, n)
		} else {
			start = startValue.kind == Kind.None ?? (n - 1, asInt(startValue))
			stop = stopValue.kind == Kind.None ?? (-1, asInt(stopValue))
			start = (start < 0 ?? (start + n, start)).clamp(-1, n - 1)
			stop = (stop < 0 ?? (stop + n, stop)).clamp(-1, n - 1) unless (stopValue.kind == Kind.None)
		}
		return (start, stop)
	}

	// Positional-or-keyword arguments of a filter or method, by position
	// and Python parameter name.
	type Args {
		internal args   Value[]
		internal names  string[]
		internal kwargs Value[]

		def new(args Value[], names string[], kwargs Value[]) {
			self.args = args
			self.names = names
			self.kwargs = kwargs
		}

		// Argument `index`, or the keyword `name`, or `fallback`.
		def at(index int, name string, fallback Value) Value {
			return args[index] when index < args.len()
			let k = names.indexOf(name)
			return k >= 0 ?? (kwargs[k], fallback)
		}

		// The keyword argument `name`; `none` when not given.
		def named(name string) ?Value {
			let k = names.indexOf(name)
			return k >= 0 ?? (kwargs[k], none)
		}
	}

	// Whether Python values `a` and `b` are equal.
	def equal(a Value, b Value) bool {
		return asFloat(a) == asFloat(b) when isNumber(a) && isNumber(b)
		return false unless a.kind == b.kind
		match a.kind {
			case Kind.Undefined, Kind.None:
				return true
			case Kind.String:
				return a.text == b.text
			case Kind.List:
				return false unless a.items.len() == b.items.len()
				for let (k, x) in a.items {
					return false unless equal(x, b.items[k])
				}
				return true
			case Kind.Dict:
				return false unless a.keys.len() == b.keys.len()
				for let (k, key) in a.keys {
					let other = b.lookup(key)
					return false when other is none || !equal(a.values[k], other)
				}
				return true
			default:
		}
		return false
	}

	// Whether values of `kind` have the method `name`.
	def isMethod(kind Kind, name string) bool {
		match kind {
			case Kind.String:
				return name := "startswith" || "endswith" || "split" || "rsplit" || "strip" || "lstrip" || "rstrip" || "replace" || "lower" || "upper" || "title" || "capitalize" || "find" || "index" || "count" || "join" || "format" || "isdigit" || "isalpha" || "isalnum" || "isspace" || "islower" || "isupper"
			case Kind.List:
				return name := "append" || "pop" || "index" || "count" || "insert"
			case Kind.Dict:
				return name := "items" || "keys" || "values" || "get" || "update" || "pop" || "copy"
			default:
		}
		return false
	}

	// Follows a dotted attribute path (`a.b`, `0` indexes a list), as the
	// `attribute=` arguments of filters read it; undefined when a step is missing.
	def path(v Value, dotted string) Value {
		let current = v
		for let (_, part) in dotted.split(".") {
			if current.kind == Kind.Dict {
				let found = current.lookup(part)
				return undefined(part) when found is none
				current = found
			} else if current.kind == Kind.List && looksNumeric(part) {
				let k = parseInt<int>(part)
				return undefined(part) unless k >= 0 && k < current.items.len()
				current = current.items[k]
			} else {
				return undefined(part)
			}
		}
		return current
	}

	def looksNumeric(s string) bool {
		return false when s.len() == 0
		let seen = false
		for let (k, c) in s {
			if c >= '0' && c <= '9' {
				seen = true
				continue
			}
			continue when (c == '-' || c == '+') && k == 0
			continue when c := '.' || 'e' || 'E'
			return false
		}
		return seen
	}

	// The whitespace Python's str.strip() and split() drop.
	const whitespace = " \t\n\r\u000B\u000C"

	// Python's strip with a set of characters.
	def pyStrip(s string, set string, left bool, right bool) string {
		let chars = charsOf(s)
		let from = 0
		let to = chars.len()
		if left {
			for from < to && set.contains(chars[from]) {
				from++
			}
		}
		if right {
			for to > from && set.contains(chars[to - 1]) {
				to--
			}
		}
		return s.slice(from, to)
	}

	// Python's split() without a separator: runs of whitespace, no empty parts.
	def splitWhitespace(s string, limit int, fromRight bool) string[] {
		let words string[]
		let current = ""
		for let (_, c) in s {
			if whitespace.contains("{c}") {
				if current.len() > 0 {
					words.push(current)
					current = ""
				}
			} else {
				current = current + "{c}"
			}
		}
		words.push(current) when current.len() > 0
		return words when limit < 0 || words.len() <= limit + 1
		if fromRight {
			let tail string[]
			for let k = words.len() - 1; k > words.len() - 1 - limit; k-- {
				tail.push(words[k])
			}
			let keep = words.len() - limit
			let first = words[:keep].join(" ")
			let out = string[first]
			out.push(...tail.reverse())
			return out
		}
		let out = words[:limit].clone()
		out.push(words[limit:].join(" "))
		return out
	}

	def splitBy(s string, sep string, limit int, fromRight bool) string[] {
		let parts = s.split(sep)
		return parts when limit < 0 || parts.len() <= limit + 1
		if fromRight {
			let keep = parts.len() - limit
			let out = string[parts[:keep].join(sep)]
			out.push(...parts[keep:])
			return out
		}
		let out = parts[:limit].clone()
		out.push(parts[limit:].join(sep))
		return out
	}

	def capitalize(s string) string {
		return s when s.len() == 0
		return s.slice(0, 1).upper() + s.slice(1).lower()
	}

	// Python's str.title(): each run of letters starts upper case.
	def title(s string) string {
		let out = ""
		let inWord = false
		for let (_, c) in s {
			let letter = "{c}".lower() != "{c}".upper()
			out = out + (letter ?? (inWord ?? ("{c}".lower(), "{c}".upper()), "{c}"))
			inWord = letter
		}
		return out
	}

	def classify(s string, name string) bool {
		return false when s.len() == 0
		for let (_, c) in s {
			let digit = c >= '0' && c <= '9'
			let letter = "{c}".lower() != "{c}".upper()
			let ok = true
			match name {
				case "isdigit":
					ok = digit
				case "isalpha":
					ok = letter
				case "isalnum":
					ok = digit || letter
				case "isspace":
					ok = whitespace.contains("{c}")
				case "islower":
					ok = !letter || "{c}" == "{c}".lower()
				case "isupper":
					ok = !letter || "{c}" == "{c}".upper()
			}
			return false unless ok
		}
		return true
	}

	// `x` to the power `y`: exact for whole exponents, through ln and exp
	// otherwise.
	def power(x float, y float) float {
		if y == float(int(y)) {
			let n = int(y).abs()
			let result = 1.0
			let base = x
			for n > 0 {
				result *= base when n & 1 == 1
				base *= base
				n = n >> 1
			}
			return y < 0.0 ?? (1.0 / result, result)
		}
		return 0.0 / 0.0 when x < 0.0
		return 0.0 when x == 0.0
		let t = y * math.ln(x)
		// e^t = 2^k · e^r with |r| ≤ ln2/2.
		let k = float(int(t / 0.6931471805599453 + (t < 0.0 ?? (-0.5, 0.5))))
		let r = t - k * 0.6931471805599453
		let term = 1.0
		let sum = 1.0
		for let i = 1; i < 25; i++ {
			term *= r / float(i)
			sum += term
		}
		return sum * power(2.0, k)
	}

	// The characters of `s`, each as a string.
	def charsOf(s string) string[] {
		return string[] when s.len() == 0
		return s.split("")
	}

	def reverseString(s string) string {
		let chars = charsOf(s)
		let out = ""
		for let k = chars.len() - 1; k >= 0; k-- {
			out = out + chars[k]
		}
		return out
	}

	// Python's json.dumps of a value: `itemSep` between items (and before
	// the newline when `indent` is 0 or more), `keySep` after keys.
	def json(v Value, indent int, depth int, itemSep string, keySep string, sortKeys bool, ascii bool) string {
		match v.kind {
			case Kind.Undefined, Kind.None:
				return "null"
			case Kind.Boolean:
				return v.flag ?? ("true", "false")
			case Kind.Integer:
				return "{v.integer}"
			case Kind.Float:
				return "NaN" when v.number != v.number
				return "Infinity" when v.number > 1.7976931348623157e308
				return "-Infinity" when v.number < -1.7976931348623157e308
				return floatRepr(v.number)
			case Kind.String:
				return jsonString(v.text, ascii)
			case Kind.List:
				return "[]" when v.items.len() == 0
				let parts string[]
				for let (_, item) in v.items {
					parts.push(json(item, indent, depth + 1, itemSep, keySep, sortKeys, ascii))
				}
				return "[" + layout(parts, indent, depth, itemSep) + "]"
			case Kind.Dict:
				return "\{\}" when v.keys.len() == 0
				let order int[]
				for let k = 0; k < v.keys.len(); k++ {
					order.push(k)
				}
				order = order.sort((a, b) => text(v.keys[a]) < text(v.keys[b]) ?? (-1, text(v.keys[a]) > text(v.keys[b]) ?? (1, 0))) when sortKeys
				let parts string[]
				for let (_, k) in order {
					let key = v.keys[k]
					let name = key.kind == Kind.String ?? (key.text, key.kind == Kind.Boolean ?? (key.flag ?? ("true", "false"), key.kind == Kind.None ?? ("null", text(key))))
					parts.push(jsonString(name, ascii) + keySep + json(v.values[k], indent, depth + 1, itemSep, keySep, sortKeys, ascii))
				}
				return "\{" + layout(parts, indent, depth, itemSep) + "\}"
			default:
		}
		return jsonString(text(v), ascii)
	}

	def layout(parts string[], indent int, depth int, itemSep string) string {
		return parts.join(itemSep) when indent < 0
		let inner = "\n" + " ".repeat(indent * (depth + 1))
		return inner + parts.join(itemSep + inner) + "\n" + " ".repeat(indent * depth)
	}

	// A JSON string as Python writes it: `\"`, `\\`, `\n`, `\r`, `\t`,
	// `\b`, `\f`, other control characters as `\u00XX`; with `ascii`, every
	// non-ASCII character as `\uXXXX` (surrogate pairs above U+FFFF).
	def jsonString(s string, ascii bool) string {
		let out byte[]
		out.push(byte(34))
		let data = s.bytes()
		let k = 0
		for k < data.len() {
			let b = data[k]
			match int(b) {
				case 34:
					out.push(byte(92), byte(34))
				case 92:
					out.push(byte(92), byte(92))
				case 10:
					out.push(byte(92), byte(110))
				case 13:
					out.push(byte(92), byte(114))
				case 9:
					out.push(byte(92), byte(116))
				case 8:
					out.push(byte(92), byte(98))
				case 12:
					out.push(byte(92), byte(102))
				default:
					if b < byte(32) {
						out.push(...("\\u00" + hex2(int(b))).bytes())
					} else if b >= byte(128) && ascii {
						let (code, size) = decodeUtf8(data, k)
						if code >= 0x10000 {
							let v = code - 0x10000
							out.push(...("\\u" + hex4(0xD800 + (v >> 10)) + "\\u" + hex4(0xDC00 + (v & 0x3FF))).bytes())
						} else {
							out.push(...("\\u" + hex4(code)).bytes())
						}
						k += size
						continue
					} else {
						out.push(b)
					}
			}
			k++
		}
		out.push(byte(34))
		return string(out)
	}

	def hex4(n int) string {
		return hex2(n >> 8) + hex2(n & 255)
	}

	def decodeUtf8(data byte[], k int) (int, int) {
		let b = int(data[k])
		return (b, 1) when b < 0x80
		return (((b & 0x1F) << 6) | (int(data[k + 1]) & 0x3F), 2) when b < 0xE0 && k + 1 < data.len()
		return (((b & 0x0F) << 12) | ((int(data[k + 1]) & 0x3F) << 6) | (int(data[k + 2]) & 0x3F), 3) when b < 0xF0 && k + 2 < data.len()
		return (((b & 0x07) << 18) | ((int(data[k + 1]) & 0x3F) << 12) | ((int(data[k + 2]) & 0x3F) << 6) | (int(data[k + 3]) & 0x3F), 4) when k + 3 < data.len()
		return (b, 1)
	}
}
