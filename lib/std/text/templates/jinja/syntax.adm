internal partial module std.text.templates.jinja.syntax {
	use std.text.templates.jinja::*

	enum TokenKind {
		Text,
		VariableBegin,
		VariableEnd,
		BlockBegin,
		BlockEnd,
		Name,
		String,
		Integer,
		Float,
		Operator,
		End,
	}

	struct Token {
		kind TokenKind
		text string
		line int
		col  int
	}

	enum NodeKind {
		// Statements.
		Text,
		Output,
		If,
		For,
		Set,
		SetBlock,
		Macro,
		CallBlock,
		FilterBlock,
		Break,
		Continue,
		Do,
		Scope,
		// Expressions.
		Constant,
		Name,
		List,
		Tuple,
		Dict,
		Attribute,
		Item,
		Slice,
		Call,
		Filter,
		Test,
		Negative,
		Positive,
		Binary,
		And,
		Or,
		Not,
		Compare,
		Conditional,
		Concat,
	}

	enum ConstantKind {
		String,
		Integer,
		Float,
		Boolean,
		None,
	}

	// One node of a parsed template. The fields a kind uses:
	//
	//   Text          text
	//   Output        children[0]
	//   If            children[0] condition, body, orelse
	//   For           targets, children[0] iterable, children[1] filter (when flag), body, orelse
	//   Set           targets (or text = namespace, targets[0] = attribute, when flag), children[0]
	//   SetBlock      targets, body
	//   Macro         text, targets = parameters, defaults, body
	//   CallBlock     children[0] call, targets = caller parameters, defaults, body
	//   FilterBlock   children[0] filter chain over the name "\0body", body
	//   Do            children[0]
	//   Scope         body (`generation` blocks)
	//   Constant      constant, text / integer / number / flag
	//   Name          text
	//   List, Tuple   children
	//   Dict          children: key, value, key, value, ...
	//   Attribute     children[0], text
	//   Item          children[0], children[1]
	//   Slice         children[0] value, children[1..3] start, stop, step (Constant None when absent)
	//   Call          children[0] callee, children[1..] positional, keywords + kwargs
	//   Filter        text, children[0] value, children[1..] positional, keywords + kwargs
	//   Test          text, flag = negated, children[0] value, children[1..] positional, keywords + kwargs
	//   Negative, Positive, Not   children[0]
	//   Binary        text = + - * / // % **, children[0..1]
	//   And, Or, Concat           children[0..1]
	//   Compare       text = == != < <= > >= in notin, children[0..1]
	//   Conditional   children[0] value, children[1] condition, children[2] else (when flag)
	struct Node {
		kind     NodeKind
		text     string
		constant ConstantKind
		integer  int
		number   float
		flag     bool
		children Node[]
		keywords string[]
		kwargs   Node[]
		targets  string[]
		defaults map<string, Node>
		body     Node[]
		orelse   Node[]
		line     int
		col      int
	}

	// Splits a template into text and tag tokens, applying whitespace
	// control the way Jinja2's lexer does.
	type Lexer {
		internal data        byte[]
		internal pos         int
		internal options     Options
		internal lineStarts  int[]
		internal out         Token[]
		// Strip the whitespace that starts the next text (`-` closed the tag).
		internal stripNext   bool
		// Drop one newline that starts the next text (trim_blocks).
		internal newlineNext bool

		def new(source string, options Options) {
			// Jinja2 drops one newline that ends the template.
			let text = source.endsWith("\r\n") ?? (source.slice(0, source.len() - 2), source.endsWith("\n") ?? (source.slice(0, source.len() - 1), source))
			data = text.bytes()
			self.options = options
			lineStarts.push(0)
			for let (k, b) in data {
				lineStarts.push(k + 1) when b == byte(10)
			}
		}

		def tokens() !Token[] {
			for {
				let start = findTag(pos)
				let textEnd = start < 0 ?? (data.len(), start)
				let text = data[pos:textEnd]
				let textAt = pos
				if newlineNext {
					if text.len() > 0 && text[0] == byte(10) {
						text = text[1:]
						textAt++
					} else if text.len() > 1 && text[0] == byte(13) && text[1] == byte(10) {
						text = text[2:]
						textAt += 2
					}
				}
				if stripNext {
					let k = 0
					for k < text.len() && isSpace(text[k]) {
						k++
					}
					text = text[k:]
					textAt += k
				}
				newlineNext = false
				stripNext = false
				if start < 0 {
					push(TokenKind.Text, string(text), textAt) when text.len() > 0
					break
				}
				let kind = data[start + 1]
				let modifier = start + 2 < data.len() ?? (data[start + 2], byte(0))
				if modifier == byte(45) {
					let n = text.len()
					for n > 0 && isSpace(text[n - 1]) {
						n--
					}
					text = text[:n]
				} else if modifier != byte(43) && options.lstripBlocks && kind != byte(123) {
					// Spaces and tabs between the start of the line and the tag.
					let n = text.len()
					for n > 0 && (text[n - 1] == byte(32) || text[n - 1] == byte(9)) {
						n--
					}
					let lineStart = n == 0 ?? (textAt == 0 || data[textAt - 1] == byte(10), text[n - 1] == byte(10))
					text = text[:n] when lineStart
				}
				push(TokenKind.Text, string(text), textAt) when text.len() > 0
				let inner = start + 2 + ((modifier == byte(45) || modifier == byte(43)) ?? (1, 0))
				if kind == byte(35) {
					try comment(start, inner)
				} else if kind == byte(37) && isRaw(inner) {
					try raw(start, inner)
				} else {
					try tag(start, inner, kind == byte(37))
				}
			}
			push(TokenKind.End, "", data.len())
			return out
		}

		// The next `{{`, `{%` or `{#` at or after `from`; -1 when none.
		internal def findTag(from int) int {
			for let k = from; k + 1 < data.len(); k++ {
				continue unless data[k] == byte(123)
				let next = data[k + 1]
				return k when next == byte(123) || next == byte(37) || next == byte(35)
			}
			return -1
		}

		internal def push(kind TokenKind, text string, at int) {
			let (line, col) = position(at)
			out.push(Token{kind: kind, text: text, line: line, col: col})
		}

		// The 1-based line and column of byte offset `at`.
		def position(at int) (int, int) {
			let lo = 0
			let hi = lineStarts.len() - 1
			for lo < hi {
				let mid = (lo + hi + 1) / 2
				if lineStarts[mid] <= at {
					lo = mid
				} else {
					hi = mid - 1
				}
			}
			return (lo + 1, at - lineStarts[lo] + 1)
		}

		internal def error(at int, message string) !none {
			let (line, col) = position(at)
			fail "jinja: {line}:{col}: {message}"
		}

		// Sets how the text after a tag starts from the tag's closing modifier.
		internal def closed(modifier byte, block bool) {
			stripNext = modifier == byte(45)
			newlineNext = block && options.trimBlocks && modifier != byte(43) && modifier != byte(45)
		}

		internal def comment(start int, inner int) !none {
			for let k = inner; k + 1 < data.len(); k++ {
				if data[k] == byte(35) && data[k + 1] == byte(125) {
					let modifier = k > inner ?? (data[k - 1], byte(0))
					closed(modifier, true)
					pos = k + 2
					return none
				}
			}
			try error(start, "comment is not closed")
			return none
		}

		// Whether the block tag starting at `inner` is `raw`.
		internal def isRaw(inner int) bool {
			let k = skipSpace(inner)
			return word(k) == "raw"
		}

		internal def raw(start int, inner int) !none {
			let k = skipSpace(inner) + 3
			k = skipSpace(k)
			let modifier = byte(0)
			if k < data.len() && (data[k] == byte(45) || data[k] == byte(43)) {
				modifier = data[k]
				k++
			}
			if !(k + 1 < data.len() && data[k] == byte(37) && data[k + 1] == byte(125)) {
				try error(start, "expected '%\}' after raw")
			}
			let bodyStart = k + 2
			for let at = bodyStart; at + 1 < data.len(); at++ {
				continue unless data[at] == byte(123) && data[at + 1] == byte(37)
				let open = at + 2
				let endModifier = open < data.len() ?? (data[open], byte(0))
				let j = skipSpace(open + ((endModifier == byte(45) || endModifier == byte(43)) ?? (1, 0)))
				continue unless word(j) == "endraw"
				j = skipSpace(j + 6)
				let closing = byte(0)
				if j < data.len() && (data[j] == byte(45) || data[j] == byte(43)) {
					closing = data[j]
					j++
				}
				continue unless j + 1 < data.len() && data[j] == byte(37) && data[j + 1] == byte(125)
				let body = data[bodyStart:at]
				if modifier == byte(45) {
					let s = 0
					for s < body.len() && isSpace(body[s]) {
						s++
					}
					body = body[s:]
				} else if options.trimBlocks && modifier != byte(43) && body.len() > 0 && body[0] == byte(10) {
					body = body[1:]
				}
				if endModifier == byte(45) {
					let n = body.len()
					for n > 0 && isSpace(body[n - 1]) {
						n--
					}
					body = body[:n]
				} else if endModifier != byte(43) && options.lstripBlocks {
					let n = body.len()
					for n > 0 && (body[n - 1] == byte(32) || body[n - 1] == byte(9)) {
						n--
					}
					body = body[:n] when n == 0 || body[n - 1] == byte(10)
				}
				push(TokenKind.Text, string(body), bodyStart) when body.len() > 0
				closed(closing, true)
				pos = j + 2
				return none
			}
			try error(start, "raw block is not closed")
			return none
		}

		internal def skipSpace(from int) int {
			let k = from
			for k < data.len() && isSpace(data[k]) {
				k++
			}
			return k
		}

		// The identifier starting at `from`, "" when none does.
		internal def word(from int) string {
			let k = from
			for k < data.len() && isNameByte(data[k], k > from) {
				k++
			}
			return string(data[from:k])
		}

		// Lexes the expression tokens of a `{{ }}` or `{% %}` tag up to its
		// closing delimiter.
		internal def tag(start int, inner int, block bool) !none {
			push(block ?? (TokenKind.BlockBegin, TokenKind.VariableBegin), "", start)
			let closer = block ?? (byte(37), byte(125))
			let depth = 0
			let k = inner
			for {
				k = skipSpace(k)
				if k >= data.len() {
					try error(start, block ?? ("block tag is not closed", "variable tag is not closed"))
				}
				let b = data[k]
				if depth == 0 && (b == byte(45) || b == byte(43)) && k + 2 < data.len() && data[k + 1] == closer && data[k + 2] == byte(125) {
					push(block ?? (TokenKind.BlockEnd, TokenKind.VariableEnd), "", k)
					closed(b, block)
					pos = k + 3
					return none
				}
				if depth == 0 && b == closer && k + 1 < data.len() && data[k + 1] == byte(125) {
					push(block ?? (TokenKind.BlockEnd, TokenKind.VariableEnd), "", k)
					closed(byte(0), block)
					pos = k + 2
					return none
				}
				if isNameByte(b, false) {
					let w = word(k)
					push(TokenKind.Name, w, k)
					k += w.bytes().len()
					continue
				}
				if isDigit(b) {
					k = number(k)
					continue
				}
				if b == byte(39) || b == byte(34) {
					k = try quoted(k)
					continue
				}
				let op = operator(k)
				if op.len() == 0 {
					try error(k, "unexpected character '{string(data[k:k + 1])}'")
				}
				if op := "(" || "[" || "\{" {
					depth++
				} else if op := ")" || "]" || "\}" {
					depth = (depth - 1).max(0)
				}
				push(TokenKind.Operator, op, k)
				k += op.len()
			}
			return none
		}

		internal def operator(k int) string {
			if k + 1 < data.len() {
				let two = string(data[k:k + 2])
				return two when two := "//" || "**" || "==" || "!=" || "<=" || ">="
			}
			let one = string(data[k:k + 1])
			return one when one := "+" || "-" || "*" || "/" || "%" || "~" || "<" || ">" || "=" || "(" || ")" || "[" || "]" || "\{" || "\}" || "." || "," || ":" || "|"
			return ""
		}

		internal def number(from int) int {
			let k = from
			let float = false
			for k < data.len() && (isDigit(data[k]) || data[k] == byte(95)) {
				k++
			}
			if k + 1 < data.len() && data[k] == byte(46) && isDigit(data[k + 1]) {
				float = true
				k++
				for k < data.len() && (isDigit(data[k]) || data[k] == byte(95)) {
					k++
				}
			}
			if k < data.len() && (data[k] == byte(101) || data[k] == byte(69)) {
				let e = k + 1
				e++ when e < data.len() && (data[e] == byte(43) || data[e] == byte(45))
				if e < data.len() && isDigit(data[e]) {
					float = true
					k = e
					for k < data.len() && isDigit(data[k]) {
						k++
					}
				}
			}
			let text = string(data[from:k]).replace("_", "", -1)
			push(float ?? (TokenKind.Float, TokenKind.Integer), text, from)
			return k
		}

		// Lexes a quoted string with Python's escapes; returns the offset after it.
		internal def quoted(from int) !int {
			let quote = data[from]
			let text byte[]
			let k = from + 1
			for k < data.len() {
				let b = data[k]
				if b == quote {
					push(TokenKind.String, string(text), from)
					return k + 1
				}
				if b != byte(92) || k + 1 >= data.len() {
					text.push(b)
					k++
					continue
				}
				let e = data[k + 1]
				k += 2
				match int(e) {
					case 110:
						text.push(byte(10))
					case 116:
						text.push(byte(9))
					case 114:
						text.push(byte(13))
					case 48:
						text.push(byte(0))
					case 98:
						text.push(byte(8))
					case 102:
						text.push(byte(12))
					case 118:
						text.push(byte(11))
					case 97:
						text.push(byte(7))
					case 92, 39, 34:
						text.push(e)
					case 10:
					case 120, 117, 85:
						let digits = e == byte(120) ?? (2, e == byte(117) ?? (4, 8))
						let code = 0
						let ok = k + digits <= data.len()
						for let d = 0; ok && d < digits; d++ {
							let v = hexValue(data[k + d])
							ok = v >= 0
							code = code * 16 + v
						}
						if ok {
							text.push(...encodeRune(code).bytes())
							k += digits
						} else {
							text.push(byte(92), e)
						}
					default:
						text.push(byte(92), e)
				}
			}
			try error(from, "string is not closed")
			return k
		}
	}

	def isSpace(b byte) bool {
		return b == byte(32) || b == byte(9) || b == byte(10) || b == byte(13) || b == byte(11) || b == byte(12)
	}

	def isDigit(b byte) bool {
		return b >= byte(48) && b <= byte(57)
	}

	// Letters, `_`, and digits after the first byte; bytes of non-ASCII
	// characters count as letters, as Python identifiers allow them.
	def isNameByte(b byte, later bool) bool {
		return (b >= byte(97) && b <= byte(122)) || (b >= byte(65) && b <= byte(90)) || b == byte(95) || b >= byte(128) || (later && isDigit(b))
	}

	def hexValue(b byte) int {
		return int(b) - 48 when isDigit(b)
		return int(b) - 87 when b >= byte(97) && b <= byte(102)
		return int(b) - 55 when b >= byte(65) && b <= byte(70)
		return -1
	}

	// UTF-8 text of one code point.
	def encodeRune(c int) string {
		let out byte[]
		if c < 0x80 {
			out.push(byte(c))
		} else if c < 0x800 {
			out.push(byte(0xC0 | (c >> 6)), byte(0x80 | (c & 0x3F)))
		} else if c < 0x10000 {
			out.push(byte(0xE0 | (c >> 12)), byte(0x80 | ((c >> 6) & 0x3F)), byte(0x80 | (c & 0x3F)))
		} else {
			out.push(byte(0xF0 | (c >> 18)), byte(0x80 | ((c >> 12) & 0x3F)), byte(0x80 | ((c >> 6) & 0x3F)), byte(0x80 | (c & 0x3F)))
		}
		return string(out)
	}

	// Builds the node tree from the tokens, with Jinja2's grammar and
	// operator precedence.
	type Parser {
		internal tokens Token[]
		internal pos    int

		def new(tokens Token[]) {
			self.tokens = tokens
		}

		// The whole template.
		def template() !Node[] {
			let (body, end) = try statements(string[])
			if end.len() > 0 {
				try error(current(), "unexpected '{end}'")
			}
			return body
		}

		internal def current() Token {
			return tokens[pos]
		}

		internal def peek(offset int) Token {
			return tokens[(pos + offset).min(tokens.len() - 1)]
		}

		internal def next() Token {
			let t = tokens[pos]
			pos++ when pos < tokens.len() - 1
			return t
		}

		internal def error(at Token, message string) !none {
			fail "jinja: {at.line}:{at.col}: {message}"
		}

		internal def isOp(text string) bool {
			let t = current()
			return t.kind == TokenKind.Operator && t.text == text
		}

		internal def isName(text string) bool {
			let t = current()
			return t.kind == TokenKind.Name && t.text == text
		}

		internal def skipOp(text string) bool {
			return false unless isOp(text)
			next()
			return true
		}

		internal def skipName(text string) bool {
			return false unless isName(text)
			next()
			return true
		}

		internal def expectOp(text string) !none {
			try error(current(), "expected '{text}'{found()}") unless skipOp(text)
			return none
		}

		internal def expectName(text string) !none {
			try error(current(), "expected '{text}'{found()}") unless skipName(text)
			return none
		}

		internal def expectKind(kind TokenKind, what string) !Token {
			let t = current()
			try error(t, "expected {what}{found()}") unless t.kind == kind
			return next()
		}

		internal def found() string {
			let t = current()
			match t.kind {
				case TokenKind.End:
					return ", found the end of the template"
				case TokenKind.BlockEnd:
					return ", found the end of the tag"
				case TokenKind.VariableEnd:
					return ", found '\}\}'"
				case TokenKind.Text:
					return ", found text"
				default:
			}
			return ", found '{t.text}'"
		}

		internal def node(kind NodeKind, at Token) Node {
			return Node{kind: kind, line: at.line, col: at.col}
		}

		// Statements up to a block tag whose name is in `ends` (consumed
		// up to the name, which is returned); "" at the end of the template.
		internal def statements(ends string[]) !(Node[], string) {
			let body Node[]
			for {
				let t = current()
				match t.kind {
					case TokenKind.End:
						return (body, "")
					case TokenKind.Text:
						next()
						let n = node(NodeKind.Text, t)
						n.text = t.text
						body.push(n)
					case TokenKind.VariableBegin:
						next()
						let n = node(NodeKind.Output, t)
						n.children.push(try tuple(true))
						try expectKind(TokenKind.VariableEnd, "'\}\}'")
						body.push(n)
					case TokenKind.BlockBegin:
						let name = peek(1)
						if name.kind == TokenKind.Name && ends.includes(name.text) {
							next()
							next()
							return (body, name.text)
						}
						next()
						body.push(try statement())
					default:
						try error(t, "unexpected token")
				}
			}
			return (body, "")
		}

		// Expects the end of the current block tag.
		internal def endTag() !none {
			try expectKind(TokenKind.BlockEnd, "'%\}'")
			return none
		}

		internal def statement() !Node {
			let t = try expectKind(TokenKind.Name, "a statement")
			match t.text {
				case "if":
					return try ifStatement(t)
				case "for":
					return try forStatement(t)
				case "set":
					return try assignment(t)
				case "macro":
					return try macroStatement(t)
				case "call":
					return try callStatement(t)
				case "filter":
					return try filterStatement(t)
				case "break", "continue":
					try endTag()
					return node(t.text == "break" ?? (NodeKind.Break, NodeKind.Continue), t)
				case "do":
					let n = node(NodeKind.Do, t)
					n.children.push(try tuple(true))
					try endTag()
					return n
				case "generation":
					try endTag()
					let n = node(NodeKind.Scope, t)
					let (body, _) = try statements(string["endgeneration"])
					n.body = body
					try endTag()
					return n
			}
			try error(t, "unknown statement '{t.text}'")
			return node(NodeKind.Text, t)
		}

		internal def ifStatement(at Token) !Node {
			let n = node(NodeKind.If, at)
			n.children.push(try tuple(true))
			try endTag()
			let (body, end) = try statements(string["elif", "else", "endif"])
			n.body = body
			match end {
				case "elif":
					let inner = try ifStatement(peek(-1))
					n.orelse.push(inner)
					return n
				case "else":
					try endTag()
					let (orelse, _) = try statements(string["endif"])
					n.orelse = orelse
				case "":
					try error(current(), "'if' is not closed with 'endif'")
			}
			try endTag()
			return n
		}

		internal def forStatement(at Token) !Node {
			let n = node(NodeKind.For, at)
			n.targets = try assignTargets()
			try expectName("in")
			n.children.push(try tuple(false))
			if skipName("if") {
				n.flag = true
				n.children.push(try expression(true))
			}
			skipName("recursive")
			try endTag()
			let (body, end) = try statements(string["else", "endfor"])
			n.body = body
			if end == "else" {
				try endTag()
				let (orelse, _) = try statements(string["endfor"])
				n.orelse = orelse
			} else if end == "" {
				try error(current(), "'for' is not closed with 'endfor'")
			}
			try endTag()
			return n
		}

		// A name or a tuple of names, as `for` and `set` assign to.
		internal def assignTargets() !string[] {
			let names string[]
			let open = skipOp("(")
			for {
				names.push((try expectKind(TokenKind.Name, "a name")).text)
				break unless skipOp(",")
				break when isName("in") || isOp("=") || isOp(")")
			}
			try expectOp(")") when open
			return names
		}

		internal def assignment(at Token) !Node {
			let first = current()
			if first.kind == TokenKind.Name && peek(1).kind == TokenKind.Operator && peek(1).text == "." {
				next()
				next()
				let n = node(NodeKind.Set, at)
				n.flag = true
				n.text = first.text
				n.targets.push((try expectKind(TokenKind.Name, "an attribute name")).text)
				try expectOp("=")
				n.children.push(try tuple(true))
				try endTag()
				return n
			}
			let targets = try assignTargets()
			if skipOp("=") {
				let n = node(NodeKind.Set, at)
				n.targets = targets
				n.children.push(try tuple(true))
				try endTag()
				return n
			}
			let n = node(NodeKind.SetBlock, at)
			n.targets = targets
			try endTag()
			let (body, end) = try statements(string["endset"])
			try error(current(), "'set' is not closed with 'endset'") when end == ""
			n.body = body
			try endTag()
			return n
		}

		// `(a, b=1, ...)` parameters into `n.targets` and `n.defaults`.
		internal def parameters(n Node) !none {
			try expectOp("(")
			for !isOp(")") {
				let name = (try expectKind(TokenKind.Name, "a parameter name")).text
				n.targets.push(name)
				n.defaults.set(name, try expression(true)) when skipOp("=")
				break unless skipOp(",")
			}
			try expectOp(")")
			return none
		}

		internal def macroStatement(at Token) !Node {
			let n = node(NodeKind.Macro, at)
			n.defaults = new map<string, Node>()
			n.text = (try expectKind(TokenKind.Name, "a macro name")).text
			try parameters(n)
			try endTag()
			let (body, end) = try statements(string["endmacro"])
			try error(current(), "'macro' is not closed with 'endmacro'") when end == ""
			n.body = body
			try endTag()
			return n
		}

		internal def callStatement(at Token) !Node {
			let n = node(NodeKind.CallBlock, at)
			n.defaults = new map<string, Node>()
			try parameters(n) when isOp("(")
			let call = try expression(true)
			try error(at, "'call' needs a macro call") unless call.kind == NodeKind.Call
			n.children.push(call)
			try endTag()
			let (body, end) = try statements(string["endcall"])
			try error(current(), "'call' is not closed with 'endcall'") when end == ""
			n.body = body
			try endTag()
			return n
		}

		internal def filterStatement(at Token) !Node {
			let n = node(NodeKind.FilterBlock, at)
			let body = node(NodeKind.Name, at)
			body.text = "\u0000body"
			let chain = body
			for {
				chain = try filter(chain)
				break unless skipOp("|")
			}
			n.children.push(chain)
			try endTag()
			let (inner, end) = try statements(string["endfilter"])
			try error(current(), "'filter' is not closed with 'endfilter'") when end == ""
			n.body = inner
			try endTag()
			return n
		}

		// Expressions --------------------------------------------------------

		// An expression, or several separated by commas as a tuple.
		internal def tuple(conditional bool) !Node {
			let at = current()
			let first = try expression(conditional)
			return first unless isOp(",")
			let n = node(NodeKind.Tuple, at)
			n.children.push(first)
			for skipOp(",") {
				break unless startsExpression()
				n.children.push(try expression(conditional))
			}
			return n
		}

		internal def startsExpression() bool {
			let t = current()
			match t.kind {
				case TokenKind.Name, TokenKind.String, TokenKind.Integer, TokenKind.Float:
					return true
				case TokenKind.Operator:
					return t.text := "(" || "[" || "\{" || "-" || "+"
				default:
			}
			return false
		}

		internal def expression(conditional bool) !Node {
			return try condition() when conditional
			return try or()
		}

		internal def condition() !Node {
			let value = try or()
			for isName("if") {
				let at = next()
				let n = node(NodeKind.Conditional, at)
				n.children.push(value)
				n.children.push(try or())
				if skipName("else") {
					n.flag = true
					n.children.push(try condition())
				}
				value = n
			}
			return value
		}

		internal def or() !Node {
			let left = try and()
			for isName("or") {
				let at = next()
				let n = node(NodeKind.Or, at)
				n.children.push(left, try and())
				left = n
			}
			return left
		}

		internal def and() !Node {
			let left = try not()
			for isName("and") {
				let at = next()
				let n = node(NodeKind.And, at)
				n.children.push(left, try not())
				left = n
			}
			return left
		}

		internal def not() !Node {
			if isName("not") {
				let at = next()
				let n = node(NodeKind.Not, at)
				n.children.push(try not())
				return n
			}
			return try compare()
		}

		internal def compare() !Node {
			let left = try sum()
			let result = left
			let chained = false
			for {
				let at = current()
				let op = ""
				if at.kind == TokenKind.Operator && (at.text := "==" || "!=" || "<" || "<=" || ">" || ">=") {
					op = at.text
					next()
				} else if isName("in") {
					op = "in"
					next()
				} else if isName("not") && peek(1).kind == TokenKind.Name && peek(1).text == "in" {
					op = "notin"
					next()
					next()
				} else {
					break
				}
				let right = try sum()
				let n = node(NodeKind.Compare, at)
				n.text = op
				n.children.push(left, right)
				if chained {
					let both = node(NodeKind.And, at)
					both.children.push(result, n)
					result = both
				} else {
					result = n
				}
				chained = true
				left = right
			}
			return result
		}

		internal def sum() !Node {
			let left = try concat()
			for isOp("+") || isOp("-") {
				let at = next()
				let n = node(NodeKind.Binary, at)
				n.text = at.text
				n.children.push(left, try concat())
				left = n
			}
			return left
		}

		internal def concat() !Node {
			let left = try product()
			for isOp("~") {
				let at = next()
				let n = node(NodeKind.Concat, at)
				n.children.push(left, try product())
				left = n
			}
			return left
		}

		internal def product() !Node {
			let left = try power()
			for isOp("*") || isOp("/") || isOp("//") || isOp("%") {
				let at = next()
				let n = node(NodeKind.Binary, at)
				n.text = at.text
				n.children.push(left, try power())
				left = n
			}
			return left
		}

		internal def power() !Node {
			let left = try unary(true)
			for isOp("**") {
				let at = next()
				let n = node(NodeKind.Binary, at)
				n.text = "**"
				n.children.push(left, try unary(true))
				left = n
			}
			return left
		}

		internal def unary(filters bool) !Node {
			let at = current()
			let value Node
			if isOp("-") || isOp("+") {
				next()
				value = node(at.text == "-" ?? (NodeKind.Negative, NodeKind.Positive), at)
				value.children.push(try unary(false))
			} else {
				value = try primary()
			}
			value = try postfix(value)
			return filters ?? (try filterExpression(value), value)
		}

		internal def primary() !Node {
			let t = current()
			match t.kind {
				case TokenKind.Name:
					next()
					let n = node(NodeKind.Constant, t)
					match t.text {
						case "true", "True":
							n.constant = ConstantKind.Boolean
							n.flag = true
							return n
						case "false", "False":
							n.constant = ConstantKind.Boolean
							return n
						case "none", "None":
							n.constant = ConstantKind.None
							return n
					}
					let name = node(NodeKind.Name, t)
					name.text = t.text
					return name
				case TokenKind.String:
					next()
					let n = node(NodeKind.Constant, t)
					n.constant = ConstantKind.String
					n.text = t.text
					// Adjacent strings join, as in Python.
					for current().kind == TokenKind.String {
						n.text = n.text + next().text
					}
					return n
				case TokenKind.Integer:
					next()
					let n = node(NodeKind.Constant, t)
					n.constant = ConstantKind.Integer
					n.integer = parseInt<int>(t.text)
					return n
				case TokenKind.Float:
					next()
					let n = node(NodeKind.Constant, t)
					n.constant = ConstantKind.Float
					n.number = parseFloat<float>(t.text)
					return n
				case TokenKind.Operator:
					if t.text == "(" {
						next()
						return node(NodeKind.Tuple, t) when skipOp(")")
						let inner = try tuple(true)
						try expectOp(")")
						return inner
					}
					if t.text == "[" {
						next()
						let n = node(NodeKind.List, t)
						for !isOp("]") {
							n.children.push(try expression(true))
							break unless skipOp(",")
						}
						try expectOp("]")
						return n
					}
					if t.text == "\{" {
						next()
						let n = node(NodeKind.Dict, t)
						for !isOp("\}") {
							n.children.push(try expression(true))
							try expectOp(":")
							n.children.push(try expression(true))
							break unless skipOp(",")
						}
						try expectOp("\}")
						return n
					}
				default:
			}
			try error(t, "expected an expression{found()}")
			return node(NodeKind.Constant, t)
		}

		internal def postfix(value Node) !Node {
			let result = value
			for {
				let at = current()
				if isOp(".") {
					next()
					let name = current()
					if name.kind == TokenKind.Integer {
						next()
						let n = node(NodeKind.Item, at)
						let index = node(NodeKind.Constant, name)
						index.constant = ConstantKind.Integer
						index.integer = parseInt<int>(name.text)
						n.children.push(result, index)
						result = n
						continue
					}
					let n = node(NodeKind.Attribute, at)
					n.text = (try expectKind(TokenKind.Name, "an attribute name")).text
					n.children.push(result)
					result = n
				} else if isOp("[") {
					next()
					result = try subscript(result, at)
					try expectOp("]")
				} else if isOp("(") {
					result = try call(result)
				} else {
					break
				}
			}
			return result
		}

		internal def subscript(value Node, at Token) !Node {
			let parts Node[]
			let slice = false
			for let k = 0; k < 3; k++ {
				if isOp(":") || isOp("]") {
					let missing = node(NodeKind.Constant, current())
					missing.constant = ConstantKind.None
					parts.push(missing)
				} else {
					parts.push(try expression(true))
				}
				break unless isOp(":")
				next()
				slice = true
			}
			if !slice {
				let n = node(NodeKind.Item, at)
				n.children.push(value, parts[0])
				return n
			}
			let n = node(NodeKind.Slice, at)
			n.children.push(value)
			for n.children.len() < 4 {
				let k = n.children.len() - 1
				if k < parts.len() {
					n.children.push(parts[k])
				} else {
					let missing = node(NodeKind.Constant, at)
					missing.constant = ConstantKind.None
					n.children.push(missing)
				}
			}
			return n
		}

		// `(args, name=value)` into `n.children` (after what is there) and
		// `n.keywords`/`n.kwargs`.
		internal def arguments(n Node) !none {
			try expectOp("(")
			for !isOp(")") {
				if current().kind == TokenKind.Name && peek(1).kind == TokenKind.Operator && peek(1).text == "=" {
					n.keywords.push(next().text)
					next()
					n.kwargs.push(try expression(true))
				} else {
					n.children.push(try expression(true))
				}
				break unless skipOp(",")
			}
			try expectOp(")")
			return none
		}

		internal def call(callee Node) !Node {
			let n = node(NodeKind.Call, current())
			n.children.push(callee)
			try arguments(n)
			return n
		}

		internal def filter(value Node) !Node {
			let at = current()
			let n = node(NodeKind.Filter, at)
			n.text = (try expectKind(TokenKind.Name, "a filter name")).text
			for skipOp(".") {
				n.text = n.text + "." + (try expectKind(TokenKind.Name, "a filter name")).text
			}
			n.children.push(value)
			try arguments(n) when isOp("(")
			return n
		}

		internal def filterExpression(value Node) !Node {
			let result = value
			for {
				if skipOp("|") {
					result = try filter(result)
				} else if isName("is") {
					let at = next()
					let n = node(NodeKind.Test, at)
					n.flag = skipName("not")
					n.text = (try expectKind(TokenKind.Name, "a test name")).text
					for skipOp(".") {
						n.text = n.text + "." + (try expectKind(TokenKind.Name, "a test name")).text
					}
					n.children.push(result)
					if isOp("(") {
						try arguments(n)
					} else if startsArgument() {
						n.children.push(try postfix(try primary()))
					}
					result = n
				} else if isOp("(") {
					result = try call(result)
				} else {
					break
				}
			}
			return result
		}

		// Whether a test's single argument without parentheses follows.
		internal def startsArgument() bool {
			let t = current()
			match t.kind {
				case TokenKind.Name:
					return !(t.text := "else" || "or" || "and" || "if" || "is" || "in" || "not")
				case TokenKind.String, TokenKind.Integer, TokenKind.Float:
					return true
				case TokenKind.Operator:
					return t.text := "[" || "\{"
				default:
			}
			return false
		}
	}
}
