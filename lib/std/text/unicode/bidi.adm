// The Unicode Bidirectional Algorithm (UAX #9): embedding levels of mixed
// left-to-right and right-to-left text, and its visual order line by line.

partial module std.text.unicode {
	use std.text.unicode.tables::*

	// BidiClass is a character's Bidi_Class: how it behaves in
	// bidirectional text.
	enum BidiClass {
		L,    // left-to-right letter
		R,    // right-to-left letter (Hebrew)
		AL,   // Arabic letter
		EN,   // European digit
		ES,   // European separator (plus, minus)
		ET,   // European terminator (currency, percent)
		AN,   // Arabic digit
		CS,   // common separator (comma, colon)
		NSM,  // non-spacing mark
		BN,   // boundary neutral (format controls)
		B,    // paragraph separator
		S,    // segment separator (tab)
		WS,   // white space
		ON,   // other neutral
		LRE,  // left-to-right embedding
		LRO,  // left-to-right override
		RLE,  // right-to-left embedding
		RLO,  // right-to-left override
		PDF,  // pop directional formatting
		LRI,  // left-to-right isolate
		RLI,  // right-to-left isolate
		FSI,  // first strong isolate
		PDI,  // pop directional isolate
	}

	// Direction is which way a paragraph of text runs.
	enum Direction {
		LeftToRight,
		RightToLeft,
	}

	// BidiRun is a stretch of a line at one embedding level: characters
	// [start, end) as `string.slice` counts them, right to left when the
	// level is odd.
	struct BidiRun {
		start       int
		end         int
		level       int
		rightToLeft bool
	}

	// The character's Bidi_Class.
	def bidiClass(ch char) BidiClass {
		return BidiClass(int(recordBidi[record(ch)]))
	}

	// The direction of the text's first strong character, skipping what
	// sits inside isolates (UAX #9 P2-P3): none when it has none, such as
	// digits and punctuation alone.
	def direction(text string) ?Direction {
		let cls int[]
		for let (_, ch) in text {
			cls.push(int(recordBidi[record(ch)]))
		}
		let d = firstStrong(cls, 0, cls.len(), false)
		return none when d < 0
		return d == 0 ?? (Direction.LeftToRight, Direction.RightToLeft)
	}

	// Bidi holds the embedding levels of a text, resolved once, for laying
	// out its lines: each paragraph (ended by a paragraph separator) takes
	// `direction`, or its first strong character's when none is given.
	type Bidi {
		internal chars      int[]
		internal original   int[]
		internal resolved   int[]
		internal paragraphs int[]
		// Per character: its paragraph's level.
		internal base       int[]

		def new(text string, direction ?Direction = none) {
			for let (_, ch) in text {
				chars.push(int(ch))
				original.push(int(recordBidi[record(ch)]))
			}
			let forced = -1
			forced = direction == Direction.LeftToRight ?? (0, 1) when direction is Direction
			resolve(forced)
		}

		// The embedding level of every character: even left to right, odd
		// right to left. Explicit formatting characters, which the
		// algorithm drops, take the level before them.
		def levels() int[] {
			return resolved.clone()
		}

		// The direction of the paragraph holding character `at`.
		def direction(at int = 0) Direction {
			return Direction.LeftToRight when base.len() == 0
			return base[at.clamp(0, base.len() - 1)] % 2 == 0 ?? (Direction.LeftToRight, Direction.RightToLeft)
		}

		// The runs of line [start, end) in visual order, left to right, with
		// trailing white space and separators back at the paragraph's level
		// (rules L1-L2).
		def runs(start int, end int) BidiRun[] {
			start = start.clamp(0, chars.len())
			end = end.clamp(start, chars.len())
			let out BidiRun[]
			let order = visual(start, end)
			let lv = lineLevels(start, end)
			let k = 0
			for k < order.len() {
				let level = lv[order[k] - start]
				let first = k
				k++
				for k < order.len() && lv[order[k] - start] == level {
					k++
				}
				let a = order[first]
				let b = order[k - 1]
				out.push(BidiRun{start: a.min(b), end: a.max(b) + 1, level: level, rightToLeft: level % 2 == 1})
			}
			return out
		}

		// Character indices of line [start, end) in visual order, left to
		// right (rule L2).
		def visual(start int, end int) int[] {
			start = start.clamp(0, chars.len())
			end = end.clamp(start, chars.len())
			let lv = lineLevels(start, end)
			let order int[]
			for let i = start; i < end; i++ {
				order.push(i)
			}
			return order when order.len() == 0
			let highest = 0
			let lowestOdd = 127
			for let (_, l) in lv {
				highest = highest.max(l)
				lowestOdd = lowestOdd.min(l) when l % 2 == 1
			}
			for let level = highest; level >= lowestOdd; level-- {
				let i = 0
				for i < lv.len() {
					if lv[order[i] - start] >= level {
						let j = i
						for j < lv.len() && lv[order[j] - start] >= level {
							j++
						}
						// Reverse order[i..j).
						let a = i
						let b = j - 1
						for a < b {
							let t = order[a]
							order[a] = order[b]
							order[b] = t
							a++
							b--
						}
						i = j
					} else {
						i++
					}
				}
			}
			return order
		}

		// The levels of line [start, end) after rule L1: segment and
		// paragraph separators, and white space (isolate formatting and
		// removed characters included) before them or at the line's end,
		// go back to the paragraph level.
		internal def lineLevels(start int, end int) int[] {
			let lv int[]
			for let i = start; i < end; i++ {
				lv.push(resolved[i])
			}
			let trailing = true
			for let i = end - 1; i >= start; i-- {
				let c = original[i]
				if c == bidiB || c == bidiS {
					lv[i - start] = base[i]
					trailing = true
				} else if c == bidiWS || isIsolateControl(c) || isRemoved(c) {
					lv[i - start] = base[i] when trailing
				} else {
					trailing = false
				}
			}
			return lv
		}

		// Splits the text into paragraphs and resolves each.
		internal def resolve(forced int) {
			resolved.len(original.len())
			resolved.fill(0)
			base.len(original.len())
			base.fill(0)
			let start = 0
			for start < original.len() {
				let end = start
				for end < original.len() && original[end] != bidiB {
					end++
				}
				end++ when end < original.len()
				let level = forced >= 0 ?? (forced, firstStrong(original, start, end, false).max(0))
				paragraphs.push(start)
				for let i = start; i < end; i++ {
					base[i] = level
				}
				new BidiParagraph(chars, original, resolved, start, end, level).resolve()
				start = end
			}
		}
	}

	// Class numbers, in BidiClass order.
	internal const (
		bidiL   = 0
		bidiR   = 1
		bidiAL  = 2
		bidiEN  = 3
		bidiES  = 4
		bidiET  = 5
		bidiAN  = 6
		bidiCS  = 7
		bidiNSM = 8
		bidiBN  = 9
		bidiB   = 10
		bidiS   = 11
		bidiWS  = 12
		bidiON  = 13
		bidiLRE = 14
		bidiLRO = 15
		bidiRLE = 16
		bidiRLO = 17
		bidiPDF = 18
		bidiLRI = 19
		bidiRLI = 20
		bidiFSI = 21
		bidiPDI = 22
	)

	// Deepest embedding level (BD2).
	internal const bidiMaxDepth = 125

	internal def isIsolateInitiator(c int) bool {
		return c == bidiLRI || c == bidiRLI || c == bidiFSI
	}

	internal def isIsolateControl(c int) bool {
		return isIsolateInitiator(c) || c == bidiPDI
	}

	// Characters rule X9 drops: embeddings, overrides, PDF and BN.
	internal def isRemoved(c int) bool {
		return c == bidiBN || (c >= bidiLRE && c <= bidiPDF)
	}

	// The direction of the first strong character in [start, end), skipping
	// isolates (P2-P3): 0 left to right, 1 right to left, -1 none. When
	// `stopAtPDI`, an unmatched PDI ends the search (FSI's own text).
	internal def firstStrong(cls int[], start int, end int, stopAtPDI bool) int {
		let depth = 0
		for let i = start; i < end; i++ {
			let c = cls[i]
			if isIsolateInitiator(c) {
				depth++
			} else if c == bidiPDI {
				if depth > 0 {
					depth--
				} else if stopAtPDI {
					return -1
				}
			} else if depth == 0 {
				return 0 when c == bidiL
				return 1 when c == bidiR || c == bidiAL
			} else if c == bidiB {
				return -1
			}
		}
		return -1
	}

	// One paragraph's resolution: explicit levels (X1-X10), then weak
	// types, brackets and neutrals (W1-N2) and implicit levels (I1-I2) per
	// isolating run sequence.
	internal type BidiParagraph {
		chars    int[]
		original int[]
		levels   int[]
		start    int
		end      int
		level    int
		// Working classes, by text index.
		types    int[]
		// The PDI matching each isolate initiator, -1 when none; and the
		// reverse.
		matchPDI int[]
		opener   int[]
		// Levels after the explicit rules, before the implicit ones raise
		// them: what sos and eos compare.
		explicit int[]

		def new(chars int[], original int[], levels int[], start int, end int, level int) {
			self.chars = chars
			self.original = original
			self.levels = levels
			self.start = start
			self.end = end
			self.level = level
			types = original.clone()
			matchPDI.len(original.len())
			matchPDI.fill(-1)
			opener.len(original.len())
			opener.fill(-1)
		}

		def resolve() {
			matchIsolates()
			explicitLevels()
			explicit = levels.clone()
			for let (_, seq) in sequences() {
				resolveSequence(seq)
			}
			// Dropped characters take the level before them (the paragraph's
			// at its start), so callers see a level for every character.
			for let i = start; i < end; i++ {
				levels[i] = i > start ?? (levels[i - 1], level) when isRemoved(original[i])
			}
		}

		// BD9: each isolate initiator's matching PDI.
		internal def matchIsolates() {
			let stack int[]
			for let i = start; i < end; i++ {
				let c = original[i]
				if isIsolateInitiator(c) {
					stack.push(i)
				} else if c == bidiPDI && stack.len() > 0 {
					let o = stack.pop()
					matchPDI[o] = i
					opener[i] = o
				}
			}
		}

		// X1-X8: levels and overrides from the explicit formatting
		// characters.
		internal def explicitLevels() {
			let stackLevel int[]
			let stackOverride int[]
			let stackIsolate bool[]
			stackLevel.push(level)
			stackOverride.push(-1)
			stackIsolate.push(false)
			let overflowIsolates = 0
			let overflowEmbeddings = 0
			let validIsolates = 0
			for let i = start; i < end; i++ {
				let c = original[i]
				let top = stackLevel.len() - 1
				if c == bidiRLE || c == bidiLRE || c == bidiRLO || c == bidiLRO {
					let rtl = c == bidiRLE || c == bidiRLO
					let next = rtl ?? ((stackLevel[top] + 1) | 1, (stackLevel[top] + 2) & ~1)
					levels[i] = stackLevel[top]
					if next <= bidiMaxDepth && overflowIsolates == 0 && overflowEmbeddings == 0 {
						stackLevel.push(next)
						stackOverride.push(c == bidiRLO ?? (bidiR, c == bidiLRO ?? (bidiL, -1)))
						stackIsolate.push(false)
					} else if overflowIsolates == 0 {
						overflowEmbeddings++
					}
				} else if isIsolateInitiator(c) {
					levels[i] = stackLevel[top]
					types[i] = stackOverride[top] when stackOverride[top] >= 0
					let rtl = c == bidiRLI
					if c == bidiFSI {
						let stop = matchPDI[i] >= 0 ?? (matchPDI[i], end)
						rtl = firstStrong(original, i + 1, stop, true) == 1
					}
					let next = rtl ?? ((stackLevel[top] + 1) | 1, (stackLevel[top] + 2) & ~1)
					if next <= bidiMaxDepth && overflowIsolates == 0 && overflowEmbeddings == 0 {
						validIsolates++
						stackLevel.push(next)
						stackOverride.push(-1)
						stackIsolate.push(true)
					} else {
						overflowIsolates++
					}
				} else if c == bidiPDI {
					if overflowIsolates > 0 {
						overflowIsolates--
					} else if validIsolates > 0 {
						overflowEmbeddings = 0
						for !stackIsolate[stackLevel.len() - 1] {
							stackLevel.pop()
							stackOverride.pop()
							stackIsolate.pop()
						}
						stackLevel.pop()
						stackOverride.pop()
						stackIsolate.pop()
						validIsolates--
					}
					let t = stackLevel.len() - 1
					levels[i] = stackLevel[t]
					types[i] = stackOverride[t] when stackOverride[t] >= 0
				} else if c == bidiPDF {
					levels[i] = stackLevel[top]
					if overflowIsolates > 0 {} else if overflowEmbeddings > 0 {
						overflowEmbeddings--
					} else if !stackIsolate[top] && stackLevel.len() >= 2 {
						stackLevel.pop()
						stackOverride.pop()
						stackIsolate.pop()
					}
				} else if c == bidiB {
					levels[i] = level
				} else {
					levels[i] = stackLevel[top]
					types[i] = stackOverride[top] when stackOverride[top] >= 0 && c != bidiBN
				}
			}
		}

		// X10: the isolating run sequences, as lists of the text indices
		// they hold (dropped characters left out).
		internal def sequences() int[][] {
			// Level runs.
			let runs int[][]
			let current int[]
			let runLevel = -1
			for let i = start; i < end; i++ {
				continue when isRemoved(original[i])
				if levels[i] != runLevel && current.len() > 0 {
					runs.push(current)
					current = int[]
				}
				runLevel = levels[i]
				current.push(i)
			}
			runs.push(current) when current.len() > 0
			// Chain runs through matched isolates.
			let runOf map<int, int> = map<int, int>{}
			for let (r, run) in runs {
				runOf[run[0]] = r
			}
			let out int[][]
			for let (_, run) in runs {
				let first = run[0]
				// A run starting with a matched PDI continues an earlier one.
				continue when original[first] == bidiPDI && opener[first] >= 0
				let seq = run.clone()
				for {
					let last = seq[seq.len() - 1]
					break unless isIsolateInitiator(original[last]) && matchPDI[last] >= 0
					let next = runOf.get(matchPDI[last])
					break when next is none
					seq = seq + runs[next]
				}
				out.push(seq)
			}
			return out
		}

		internal def resolveSequence(seq int[]) {
			let n = seq.len()
			let seqLevel = explicit[seq[0]]
			// sos and eos: the higher of this level and the neighbour's.
			let before = level
			for let i = seq[0] - 1; i >= start; i-- {
				if !isRemoved(original[i]) {
					before = explicit[i]
					break
				}
			}
			let after = level
			let last = seq[n - 1]
			if !(isIsolateInitiator(original[last])) {
				for let i = last + 1; i < end; i++ {
					if !isRemoved(original[i]) {
						after = explicit[i]
						break
					}
				}
			}
			let sos = seqLevel.max(before) % 2 == 0 ?? (bidiL, bidiR)
			let eos = seqLevel.max(after) % 2 == 0 ?? (bidiL, bidiR)
			let t int[]
			for let (_, i) in seq {
				t.push(types[i])
			}

			// W1: marks take the type before them; after an isolate control, ON.
			for let k = 0; k < n; k++ {
				if t[k] == bidiNSM {
					if k == 0 {
						t[k] = sos
					} else {
						t[k] = isIsolateControl(original[seq[k - 1]]) ?? (bidiON, t[k - 1])
					}
				}
			}
			// W2: European digits after Arabic letters are Arabic digits.
			let strong = sos
			for let k = 0; k < n; k++ {
				let c = t[k]
				if c == bidiL || c == bidiR || c == bidiAL {
					strong = c
				} else if c == bidiEN && strong == bidiAL {
					t[k] = bidiAN
				}
			}
			// W3
			for let k = 0; k < n; k++ {
				t[k] = bidiR when t[k] == bidiAL
			}
			// W4: one separator between two digits of a kind joins them.
			for let k = 1; k + 1 < n; k++ {
				if t[k] == bidiES && t[k - 1] == bidiEN && t[k + 1] == bidiEN {
					t[k] = bidiEN
				} else if t[k] == bidiCS && t[k - 1] == bidiEN && t[k + 1] == bidiEN {
					t[k] = bidiEN
				} else if t[k] == bidiCS && t[k - 1] == bidiAN && t[k + 1] == bidiAN {
					t[k] = bidiAN
				}
			}
			// W5: terminators next to European digits become digits.
			let k = 0
			for k < n {
				if t[k] == bidiET {
					let j = k
					for j < n && t[j] == bidiET {
						j++
					}
					let touches = (k > 0 && t[k - 1] == bidiEN) || (j < n && t[j] == bidiEN)
					if touches {
						for let m = k; m < j; m++ {
							t[m] = bidiEN
						}
					}
					k = j
				} else {
					k++
				}
			}
			// W6: other separators and terminators are neutral.
			for let m = 0; m < n; m++ {
				t[m] = bidiON when t[m] == bidiES || t[m] == bidiET || t[m] == bidiCS
			}
			// W7: European digits after left-to-right text are left to right.
			strong = sos
			for let m = 0; m < n; m++ {
				let c = t[m]
				if c == bidiL || c == bidiR {
					strong = c
				} else if c == bidiEN && strong == bidiL {
					t[m] = bidiL
				}
			}

			let e = seqLevel % 2 == 0 ?? (bidiL, bidiR)
			pairBrackets(seq, t, sos, e)

			// N1-N2: neutrals between text of one direction take it; others
			// the embedding direction. Digits count as right to left.
			k = 0
			for k < n {
				if isNeutral(t[k]) {
					let j = k
					for j < n && isNeutral(t[j]) {
						j++
					}
					let left = k == 0 ?? (sos, strongOf(t[k - 1]))
					let right = j == n ?? (eos, strongOf(t[j]))
					let dir = left == right ?? (left, e)
					for let m = k; m < j; m++ {
						t[m] = dir
					}
					k = j
				} else {
					k++
				}
			}

			// I1-I2
			for let m = 0; m < n; m++ {
				let i = seq[m]
				let c = t[m]
				if levels[i] % 2 == 0 {
					if c == bidiR {
						levels[i] += 1
					} else if c == bidiAN || c == bidiEN {
						levels[i] += 2
					}
				} else if c == bidiL || c == bidiEN || c == bidiAN {
					levels[i] += 1
				}
			}
		}

		internal def isNeutral(c int) bool {
			return c == bidiB || c == bidiS || c == bidiWS || c == bidiON || isIsolateControl(c)
		}

		// L or R for the strong side of a neutral run: digits read as R.
		internal def strongOf(c int) int {
			return c == bidiL ?? (bidiL, bidiR)
		}

		// N0: paired brackets (BD16) take the direction of the text inside
		// them, or of the text before them when only the other direction is
		// inside.
		internal def pairBrackets(seq int[], t int[], sos int, e int) {
			let n = seq.len()
			// Opening brackets waiting: position in the sequence and the
			// closing bracket they want.
			let stackAt int[]
			let stackWant int[]
			let pairs int[]
			for let k = 0; k < n; k++ {
				continue when t[k] != bidiON
				let cp = canonicalBracket(chars[seq[k]])
				let b = search(bracketKeys, cp)
				continue when b < 0
				if bracketOpens[b] == 1 {
					break when stackAt.len() == 63
					stackAt.push(k)
					stackWant.push(canonicalBracket(bracketPairs[b]))
				} else {
					for let s = stackAt.len() - 1; s >= 0; s-- {
						if stackWant[s] == cp {
							pairs.push(stackAt[s] << 32 | k)
							stackAt.len(s)
							stackWant.len(s)
							break
						}
					}
				}
			}
			pairs.sort((a int, b int) => a < b)
			for let (_, pr) in pairs {
				let open = pr >> 32
				let close = pr & 0xFFFFFFFF
				let foundE = false
				let foundOther = false
				for let m = open + 1; m < close; m++ {
					let c = t[m]
					continue unless c == bidiL || c == bidiR || c == bidiEN || c == bidiAN
					let d = strongOf(c)
					if d == e {
						foundE = true
						break
					}
					foundOther = true
				}
				let dir = -1
				if foundE {
					dir = e
				} else if foundOther {
					// The context before the opening bracket.
					let ctx = sos
					for let m = open - 1; m >= 0; m-- {
						let c = t[m]
						if c == bidiL || c == bidiR || c == bidiEN || c == bidiAN {
							ctx = strongOf(c)
							break
						}
					}
					dir = ctx != e ?? (ctx, e)
				}
				continue when dir < 0
				t[open] = dir
				t[close] = dir
				// Marks right after a bracket that changed follow it.
				for let (_, at) in [open, close] {
					for let m = at + 1; m < n && original[seq[m]] == bidiNSM; m++ {
						t[m] = dir
					}
				}
			}
		}

		// U+2329/U+232A are canonically U+3008/U+3009.
		internal def canonicalBracket(cp int) int {
			return 0x3008 when cp == 0x2329
			return 0x3009 when cp == 0x232A
			return cp
		}
	}
}
