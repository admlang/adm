partial module std.text.unicode {
	use (
		std.testing
		std.os
	)

	check "Bidirectional text" {
		// The visual order of the whole text as one line.
		def visualText(text string, direction ?Direction = none) string {
			let chars char[]
			for let (_, ch) in text {
				chars.push(ch)
			}
			let b = new Bidi(text, direction)
			let out = ""
			for let (_, i) in b.visual(0, chars.len()) {
				out += string(chars[i])
			}
			return out
		}

		def directionOf(text string) string {
			let d = direction(text)
			return "none" when d is none
			return d == Direction.LeftToRight ?? ("ltr", "rtl")
		}

		@test()
		def findsTheDirection() {
			assert directionOf("Hello") == "ltr" // first strong letter is Latin
			assert directionOf("123 שלום") == "rtl" // digits are not strong, Hebrew is
			assert directionOf("مرحبا world") == "rtl" // Arabic first
			assert directionOf("1, 2, 3") == "none" // no strong letter at all
			assert directionOf("⁧abc⁩ שלום") == "rtl" // isolated text is skipped
			assert bidiClass('a') == BidiClass.L && bidiClass('٣') == BidiClass.AN && bidiClass('+') == BidiClass.ES // classes
		}

		@test()
		def reordersMixedText() {
			// Hebrew inside English reads right to left within its run.
			assert visualText("abc אבג def") == "abc גבא def"
			// English inside a right-to-left paragraph keeps its order;
			// the runs swap.
			assert visualText("אבג abc", Direction.RightToLeft) == "abc גבא"
			// Numbers stay left to right inside Hebrew.
			assert visualText("אבג 123", Direction.RightToLeft) == "123 גבא"
			// Brackets around Hebrew in English mirror as a pair.
			let b = new Bidi("a (אב) c")
			let levels = b.levels()
			assert levels[2] == 0 && levels[5] == 0 // the brackets stay with the English
			assert levels[3] == 1 && levels[4] == 1 // the Hebrew inside is right to left
		}

		@test()
		def splitsLinesIntoRuns() {
			let b = new Bidi("one שתיים three")
			let runs = b.runs(0, 15)
			assert runs.len() == 3 // English, Hebrew, English
			assert !runs[0].rightToLeft && runs[1].rightToLeft && !runs[2].rightToLeft // directions
			assert runs[1].start == 4 && runs[1].end == 9 && runs[1].level == 1 // the Hebrew word
			// A line that ends in spaces after Hebrew keeps them at the
			// paragraph's level, not the Hebrew's.
			let tail = new Bidi("abc שלום  ").runs(0, 10)
			assert tail.len() == 3 && tail[2].start == 8 && tail[2].level == 0 // trailing spaces back at level 0
			assert new Bidi("שלום", Direction.RightToLeft).direction() == Direction.RightToLeft // the paragraph's direction
		}

		@test()
		def paragraphsResolveSeparately() {
			let b = new Bidi("abc אבג")
			assert b.direction(0) == Direction.LeftToRight // first paragraph
			assert b.direction(5) == Direction.RightToLeft // second paragraph
		}

		def classesOf(text string) int[] {
			let out int[]
			for let (_, ch) in text {
				out.push(int(bidiClass(ch)))
			}
			return out
		}

		// Levels after L1 for the whole text as one line, x for dropped ones.
		def levelString(b Bidi, cls int[]) string {
			let lv int[]
			lv.len(cls.len())
			for let (_, r) in b.runs(0, cls.len()) {
				for let i = r.start; i < r.end; i++ {
					lv[i] = r.level
				}
			}
			let parts string[]
			for let (i, c) in cls {
				parts.push(isRemoved(c) ?? ("x", "{lv[i]}"))
			}
			return parts.join(" ")
		}

		def orderString(b Bidi, cls int[]) string {
			let parts string[]
			for let (_, i) in b.visual(0, cls.len()) {
				parts.push("{i}") unless isRemoved(cls[i])
			}
			return parts.join(" ")
		}

		// One character of each class, in BidiClass order.
		let samples = [0x61, 0x5D0, 0x627, 0x31, 0x2B, 0x24, 0x661, 0x2C, 0x300, 0xAD, 0x2029, 0x9, 0x20, 0x21, 0x202A, 0x202D, 0x202B, 0x202E, 0x202C, 0x2066, 0x2067, 0x2068, 0x2069]

		// Every case of the UCD conformance file of class sequences, in each
		// paragraph direction it lists, when the system has it.
		@test()
		def passesBidiTest() !none {
			let data = os.readFile("/usr/share/unicode/ucd/BidiTest.txt")
			return none when data is error
			let levels = ""
			let order = ""
			let failures = 0
			let names = ["L", "R", "AL", "EN", "ES", "ET", "AN", "CS", "NSM", "BN", "B", "S", "WS", "ON", "LRE", "LRO", "RLE", "RLO", "PDF", "LRI", "RLI", "FSI", "PDI"]
			for let (_, line) in string(data).split("\n") {
				continue when line.len() == 0 || line.startsWith("#")
				if line.startsWith("@Levels:") {
					levels = line[8:].trim()
					continue
				}
				if line.startsWith("@Reorder:") {
					order = line[9:].trim()
					continue
				}
				let f = line.split(";")
				let cls int[]
				let text = ""
				for let (_, name) in f[0].trim().split(" ") {
					let c = names.indexOf(name)
					cls.push(c)
					text += string(char(samples[c]))
				}
				let set = parseInt<int>(f[1].trim())
				for let (_, dir) in [1, 2, 4] {
					continue when set & dir == 0
					let b = dir == 1 ?? (new Bidi(text), new Bidi(text, dir == 2 ?? (Direction.LeftToRight, Direction.RightToLeft)))
					if levelString(b, cls) != levels || orderString(b, cls) != order {
						println("bidi mismatch: {f[0].trim()} ({dir})") when failures < 10
						failures++
					}
				}
			}
			assert failures == 0 // levels and visual order of every case
		}

		// Every case of the UCD conformance file of real text (brackets,
		// isolates, numbers), when the system has it.
		@test()
		def passesBidiCharacterTest() !none {
			let data = os.readFile("/usr/share/unicode/ucd/BidiCharacterTest.txt")
			return none when data is error
			let failures = 0
			for let (_, line) in string(data).split("\n") {
				continue when line.len() == 0 || line.startsWith("#")
				let f = line.split(";")
				continue when f.len() < 5
				let text = ""
				for let (_, hex) in f[0].trim().split(" ") {
					text += string(char(parseInt<int>(hex, 16)))
				}
				let cls = classesOf(text)
				let given = parseInt<int>(f[1].trim())
				let b = given == 2 ?? (new Bidi(text), new Bidi(text, given == 0 ?? (Direction.LeftToRight, Direction.RightToLeft)))
				let paragraph = b.direction() == Direction.LeftToRight ?? (0, 1)
				if paragraph != parseInt<int>(f[2].trim()) || levelString(b, cls) != f[3].trim() || orderString(b, cls) != f[4].trim() {
					println("bidi mismatch: {f[0].trim()}") when failures < 10
					failures++
				}
			}
			assert failures == 0 // paragraph level, levels and order of every case
		}
	}
}
