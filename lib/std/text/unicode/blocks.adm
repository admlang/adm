// Unicode blocks (Blocks.txt): the named ranges the code space is divided
// into. Tables generated by tools/unicode/gen_unicode.py, apart from the
// property tables, so a program that asks for blocks does not load those.

partial module std.text.unicode {
	use std.text.unicode.blockdata::*

	// A Unicode block: a named range of code points.
	struct Block {
		// The name as Blocks.txt spells it: "Basic Latin", "CJK Unified
		// Ideographs". "No_Block" for a range outside every block.
		name  string
		// The first code point of the range.
		first char
		// The last code point of the range.
		last  char
	}

	// The block the code point belongs to. A code point outside every block
	// gets "No_Block" with the range of unassigned code points around it, up
	// to the blocks on either side.
	def block(ch char) Block {
		let cp = int(ch)
		let i = lastAtOrBelow(blockFirst, cp)
		return Block{name: blockNames[i], first: char(blockFirst[i]), last: char(blockLast[i])} when i >= 0 && cp <= blockLast[i]
		let first = i < 0 ?? (0, blockLast[i] + 1)
		let last = i + 1 < blockFirst.len() ?? (blockFirst[i + 1] - 1, 0x10FFFF)
		return Block{name: "No_Block", first: char(first), last: char(last)}
	}

	// Every block, in code point order.
	def blocks() Block[] {
		let out Block[]
		out.cap(blockFirst.len())
		for let (i, first) in blockFirst {
			out.push(Block{name: blockNames[i], first: char(first), last: char(blockLast[i])})
		}
		return out
	}

	// Index of the last key at or below `key` in the ascending array, or -1
	// when every key is above it.
	internal def lastAtOrBelow(keys int[], key int) int {
		let lo = 0
		let hi = keys.len()
		for lo < hi {
			let mid = (lo + hi) / 2
			if keys[mid] <= key {
				lo = mid + 1
			} else {
				hi = mid
			}
		}
		return lo - 1
	}
}
