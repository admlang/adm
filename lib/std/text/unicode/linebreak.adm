partial module std.text.unicode {
	use std.text.unicode.tables::*

	// LineBreak is a place a line may end, as `lineBreaks` reports it.
	struct LineBreak {
		// Where the next line starts: a character index, as `string.slice`
		// and `len` count.
		index     int
		// Whether the line must end here: after a newline, a line or
		// paragraph separator, a form feed, or at the end of the text.
		mandatory bool
	}

	// The places the text may break into lines, in order (UAX #14, the
	// Unicode line breaking algorithm, default rules): between words, after
	// hyphens and dashes, around ideographs, never inside a number with its
	// prefix or suffix, a closing bracket, or an emoji sequence. The last
	// entry is the end of the text; an empty text has none.
	def lineBreaks(text string) LineBreak[] {
		let chars char[]
		for let (_, ch) in text {
			chars.push(ch)
		}
		let out LineBreak[]
		return out when chars.len() == 0
		let lb = new LineBreaker(chars)
		for let k = 1; k <= chars.len(); k++ {
			let kind = lb.at(k)
			out.push(LineBreak{index: k, mandatory: kind == breakMandatory}) when kind != breakNever
		}
		return out
	}

	// Line_Break classes, in the order the tables store them.
	internal const (
		lbXX  = 0
		lbBK  = 1
		lbCR  = 2
		lbLF  = 3
		lbCM  = 4
		lbNL  = 5
		lbSG  = 6
		lbWJ  = 7
		lbZW  = 8
		lbGL  = 9
		lbSP  = 10
		lbZWJ = 11
		lbB2  = 12
		lbBA  = 13
		lbBB  = 14
		lbHY  = 15
		lbCB  = 16
		lbCL  = 17
		lbCP  = 18
		lbEX  = 19
		lbIN  = 20
		lbNS  = 21
		lbOP  = 22
		lbQU  = 23
		lbIS  = 24
		lbNU  = 25
		lbPO  = 26
		lbPR  = 27
		lbSY  = 28
		lbAI  = 29
		lbAK  = 30
		lbAL  = 31
		lbAP  = 32
		lbAS  = 33
		lbCJ  = 34
		lbEB  = 35
		lbEM  = 36
		lbH2  = 37
		lbH3  = 38
		lbHL  = 39
		lbID  = 40
		lbJL  = 41
		lbJV  = 42
		lbJT  = 43
		lbRI  = 44
		lbSA  = 45
		lbVF  = 46
		lbVI  = 47
		lbHH  = 48
	)

	// What a position between two characters allows.
	internal const (
		breakNever     = 0
		breakAllowed   = 1
		breakMandatory = 2
	)

	// The text's characters with what the rules read of each: the class
	// after LB1, and after LB9/LB10 the base each combining mark joins.
	internal type LineBreaker {
		internal chars    char[]
		// Class after LB1 (and LB10 for marks that join nothing).
		internal cls      int[]
		// The class each character had before LB9/LB10, for LB8a (ZWJ).
		internal raw      int[]
		// Marks absorbed into the character before them (LB9).
		internal absorbed bool[]
		// The characters that take part (no absorbed marks), in order, and
		// each character's place among them.
		internal sk       int[]
		internal place    int[]

		def new(chars char[]) {
			self.chars = chars
			let n = chars.len()
			cls.len(n)
			raw.len(n)
			absorbed.len(n)
			place.len(n)
			for let (i, ch) in chars {
				let c = int(recordLineBreak[record(ch)])
				// LB1: resolve the classes the default rules leave open.
				if c := lbAI || lbSG || lbXX {
					c = lbAL
				} else if c == lbSA {
					let g = category(ch)
					c = (g := Category.NonspacingMark || Category.SpacingMark) ?? (lbCM, lbAL)
				} else if c == lbCJ {
					c = lbNS
				}
				raw[i] = c
				// LB9: a mark after anything but a break or space joins it;
				// LB10: any other mark is a letter.
				if c := lbCM || lbZWJ {
					let base = sk.len() > 0 ?? (cls[sk[sk.len() - 1]], -1)
					if base >= 0 && !(base := lbBK || lbCR || lbLF || lbNL || lbSP || lbZW) {
						cls[i] = base
						absorbed[i] = true
						place[i] = sk.len() - 1
						continue
					}
					c = lbAL
				}
				cls[i] = c
				absorbed[i] = false
				place[i] = sk.len()
				sk.push(i)
			}
		}

		// The class of the j-th taking part character; -1 before the start
		// and after the end.
		internal def c(j int) int {
			return -1 when j < 0 || j >= sk.len()
			return cls[sk[j]]
		}

		internal def east(j int) bool {
			return false when j < 0 || j >= sk.len()
			return int(recordFlags[record(chars[sk[j]])]) & flagEastAsian != 0
		}

		internal def gc(j int) Category {
			return category(chars[sk[j]])
		}

		internal def dotted(j int) bool {
			return j >= 0 && j < sk.len() && int(chars[sk[j]]) == 0x25CC
		}

		// Initial (Pi) and final (Pf) quotation marks among QU.
		internal def quPi(j int) bool {
			return c(j) == lbQU && gc(j) == Category.InitialPunctuation
		}

		internal def quPf(j int) bool {
			return c(j) == lbQU && gc(j) == Category.FinalPunctuation
		}

		// The first taking part character at or before j that is not a
		// space.
		internal def beforeSpaces(j int) int {
			let q = j
			for q >= 0 && c(q) == lbSP {
				q--
			}
			return q
		}

		// The break between characters k - 1 and k (k == length: the end).
		def at(k int) int {
			let n = chars.len()
			// LB3: always break at the end.
			return breakMandatory when k >= n
			// LB9: an absorbed mark stays with its base.
			return breakNever when absorbed[k]
			let j = place[k]
			let a = c(j - 1)
			let b = cls[k]
			// LB4, LB5: after hard breaks.
			return breakMandatory when a == lbBK
			return breakNever when a == lbCR && b == lbLF
			return breakMandatory when (a := lbCR || lbLF || lbNL)
			// LB6, LB7.
			return breakNever when (b := lbBK || lbCR || lbLF || lbNL || lbSP || lbZW)
			// LB8: after a zero width space and any spaces.
			return breakAllowed when c(beforeSpaces(j - 1)) == lbZW
			// LB8a: after a zero width joiner.
			return breakNever when raw[k - 1] == lbZWJ
			// LB11, LB12, LB12a: word joiners and glue.
			return breakNever when a == lbWJ || b == lbWJ || a == lbGL
			return breakNever when b == lbGL && !(a := lbSP || lbHY || lbHH)
			// LB13: before closers and stops.
			return breakNever when (b := lbEX || lbCL || lbCP || lbSY)
			// LB14: after an opener and spaces.
			let q = beforeSpaces(j - 1)
			return breakNever when c(q) == lbOP
			// LB15a: after an initial quote that opens, and spaces.
			if quPi(q) {
				let p = c(q - 1)
				return breakNever when q - 1 < 0 || (p := lbBK || lbCR || lbLF || lbNL || lbOP || lbQU || lbGL || lbSP || lbZW)
			}
			// LB15b: before a final quote that closes.
			if quPf(j) {
				let nx = c(j + 1)
				return breakNever when j + 1 >= sk.len() || (nx := lbSP || lbGL || lbWJ || lbCL || lbQU || lbCP || lbEX || lbIS || lbSY || lbBK || lbCR || lbLF || lbNL || lbZW)
			}
			// LB15c, LB15d: a space before ".5" may break; otherwise none
			// before an infix separator.
			return breakAllowed when a == lbSP && b == lbIS && c(j + 1) == lbNU
			return breakNever when b == lbIS
			// LB16, LB17.
			return breakNever when b == lbNS && (c(q) := lbCL || lbCP)
			return breakNever when b == lbB2 && c(q) == lbB2
			// LB18: after spaces.
			return breakAllowed when a == lbSP
			// LB19, LB19a: quotation marks, unless between East Asian text.
			return breakNever when b == lbQU && !quPi(j)
			return breakNever when a == lbQU && !quPf(j - 1)
			if b == lbQU {
				return breakNever when !east(j - 1) || j + 1 >= sk.len() || !east(j + 1)
			}
			if a == lbQU {
				return breakNever when !east(j) || j - 2 < 0 || !east(j - 2)
			}
			// LB20: around contingent breaks.
			return breakAllowed when b == lbCB || a == lbCB
			// LB20a: a hyphen starting a word stays with it.
			if (a := lbHY || lbHH) && (b := lbAL || lbHL) {
				let p = c(j - 2)
				return breakNever when j - 2 < 0 || (p := lbBK || lbCR || lbLF || lbNL || lbSP || lbZW || lbCB || lbGL)
			}
			// LB21, LB21a, LB21b.
			return breakNever when (b := lbBA || lbHH || lbHY || lbNS) || a == lbBB
			return breakNever when (a := lbHY || lbHH) && c(j - 2) == lbHL && b != lbHL
			return breakNever when a == lbSY && b == lbHL
			// LB22.
			return breakNever when b == lbIN
			// LB23, LB23a: letters and numbers, prefixes on ideographs.
			return breakNever when ((a := lbAL || lbHL) && b == lbNU) || (a == lbNU && (b := lbAL || lbHL))
			return breakNever when (a == lbPR && (b := lbID || lbEB || lbEM)) || ((a := lbID || lbEB || lbEM) && b == lbPO)
			// LB24.
			return breakNever when ((a := lbPR || lbPO) && (b := lbAL || lbHL)) || ((a := lbAL || lbHL) && (b := lbPR || lbPO))
			// LB25: numbers with their prefix, suffix and separators.
			if (b := lbPO || lbPR) {
				let r = j - 1
				r-- when (c(r) := lbCL || lbCP)
				for r >= 0 && (c(r) := lbSY || lbIS) {
					r--
				}
				return breakNever when c(r) == lbNU
			}
			if (a := lbPO || lbPR) {
				return breakNever when b == lbOP && c(j + 1) == lbNU
				return breakNever when b == lbOP && c(j + 1) == lbIS && c(j + 2) == lbNU
				return breakNever when b == lbNU
			}
			return breakNever when (a := lbHY || lbIS) && b == lbNU
			if b == lbNU {
				let r = j - 1
				for r >= 0 && (c(r) := lbSY || lbIS) {
					r--
				}
				return breakNever when c(r) == lbNU
			}
			// LB26, LB27: Korean syllables.
			return breakNever when a == lbJL && (b := lbJL || lbJV || lbH2 || lbH3)
			return breakNever when (a := lbJV || lbH2) && (b := lbJV || lbJT)
			return breakNever when (a := lbJT || lbH3) && b == lbJT
			return breakNever when (a := lbJL || lbJV || lbJT || lbH2 || lbH3) && b == lbPO
			return breakNever when a == lbPR && (b := lbJL || lbJV || lbJT || lbH2 || lbH3)
			// LB28: between letters.
			return breakNever when (a := lbAL || lbHL) && (b := lbAL || lbHL)
			// LB28a: orthographic syllables of Brahmic scripts.
			let akA = (a := lbAK || lbAS) || dotted(j - 1)
			let akB = (b := lbAK || lbAS) || dotted(j)
			return breakNever when a == lbAP && akB
			return breakNever when akA && (b := lbVF || lbVI)
			return breakNever when a == lbVI && ((c(j - 2) := lbAK || lbAS) || dotted(j - 2)) && (b == lbAK || dotted(j))
			return breakNever when akA && akB && c(j + 1) == lbVF
			// LB29.
			return breakNever when a == lbIS && (b := lbAL || lbHL)
			// LB30: letters and numbers against brackets, unless East Asian.
			return breakNever when (a := lbAL || lbHL || lbNU) && b == lbOP && !east(j)
			return breakNever when a == lbCP && !east(j - 1) && (b := lbAL || lbHL || lbNU)
			// LB30a: regional indicators in pairs.
			if a == lbRI && b == lbRI {
				let r = j - 1
				for r >= 0 && c(r) == lbRI {
					r--
				}
				return (j - 1 - r) % 2 == 1 ?? (breakNever, breakAllowed)
			}
			// LB30b: emoji modifiers.
			return breakNever when a == lbEB && b == lbEM
			if b == lbEM {
				let ch = chars[sk[j - 1]]
				return breakNever when isExtendedPictographic(ch) && category(ch) == Category.Unassigned
			}
			// LB31: everywhere else.
			return breakAllowed
		}
	}
}
