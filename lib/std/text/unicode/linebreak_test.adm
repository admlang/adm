partial module std.text.unicode {
	use (
		std.testing
		std.os
	)

	check "Line breaking" {
		// The break positions as indexes, mandatory ones marked with "!".
		def positions(text string) string {
			let parts string[]
			for let (_, b) in lineBreaks(text) {
				parts.push(b.mandatory ?? ("{b.index}!", "{b.index}"))
			}
			return parts.join(" ")
		}

		@test()
		def breaksBetweenWordsAndAfterHyphens() {
			assert positions("Hello world") == "6 11!"
			assert positions("well-known fact") == "5 11 15!"
			assert positions("") == ""
			// No break before closing punctuation or inside a number with its
			// currency sign and decimals.
			assert positions("(cost: $1,234.50)") == "7 17!"
			// Newlines are mandatory breaks; CR LF stays together.
			assert positions("a\r\nb\nc") == "3! 5! 6!"
			// Ideographs break between any two; the full stop stays with the
			// character before it.
			assert positions("日本語。") == "1 2 4!"
			// A no-break space glues.
			assert positions("10" + string(char(0xA0)) + "km now") == "6 9!"
		}

		@test()
		def emojiSequencesStayWhole() {
			// Woman, ZWJ, laptop: one sequence; a flag is two indicators.
			assert positions("👩‍💻 🇬🇧🇫🇷") == "4 6 8!"
		}

		// Every line of the UCD conformance file, when the system has it, but
		// those with U+0000, which no string can hold.
		@test()
		def passesLineBreakTest() !none {
			let text = os.readFile("/usr/share/unicode/ucd/auxiliary/LineBreakTest.txt")
			return none when text is error

			let failures = 0
			let checked = 0
			for let (_, line) in string(text).split("\n") {
				let body = line.split("#")[0].trim()
				continue when body.len() == 0
				// "× 0023 × 0308 ÷ 0020 ÷": code points between break marks.
				// A string cannot hold U+0000 (spec, strings): those lines
				// cannot be asked.
				continue when (" " + body + " ").contains(" 0000 ")
				let s = ""
				let expected int[]
				let n = 0
				for let (_, tok) in body.split(" ") {
					if tok == "÷" {
						expected.push(n) when n > 0
					} else if tok != "×" && tok != "" {
						s += string(char(parseInt<int>(tok, 16)))
						n++
					}
				}
				let got int[]
				for let (_, b) in lineBreaks(s) {
					got.push(b.index)
				}
				checked++
				let same = got.len() == expected.len()
				if same {
					for let (i, v) in got {
						same = false when expected[i] != v
					}
				}
				if !same {
					println("line break mismatch: {body} got {got}") when failures < 10
					failures++
				}
			}
			assert checked > 18000 // the file was read
			assert failures == 0 // every line conforms
		}
	}
}
