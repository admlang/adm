// Character names (the Name property of the Unicode Character Database,
// extracted/DerivedName.txt). Ideographs and other ranges named by a pattern
// and the Hangul syllables are computed; the other names are embedded
// compressed and decoded on first use, so a program that never asks for a
// name carries no cost at startup.

partial module std.text.unicode {
	use (
		std.data.compress.flate
		std.text.unicode.namedata::*
	)

	// The stored names (tools/unicode/gen_unicode.py): raw deflate of
	// "ADMNAME1", the word count and the words in ASCII order (varint
	// length and ASCII bytes), then the name count and per name its code point's distance
	// from the previous one less one, its word count and its words'
	// indices, all varints.
	@embed("names.bin")
	internal const namesBlob byte[]

	// NameTable holds the stored names once decoded: each name is a run of
	// indices into `words`, which the names join with spaces. Every method
	// is atomic; what they fill is not changed afterwards.
	internal type NameTable {
		ready   bool
		words   string[]
		// Named code points, ascending, and where each name's indices start
		// in `indices` (one extra end entry).
		codes   int[]
		starts  int[]
		indices uint16[]
		// The parts hyphens separate in the words that hold one (TIBETAN
		// LETTER -A, HYPHEN-MINUS): part -> the indices of those words.
		// Filled by `searchable`.
		parts   map<string, int[]>
		indexed bool

		atomic def load() NameTable {
			return self when ready
			ready = true
			words = string[]
			codes = int[]
			starts = int[]
			indices = uint16[]
			// The blob is generated with the tables and every name is checked
			// by the suite, so it does not fail to decode; a damaged one
			// leaves no stored names rather than stopping the caller.
			let (data, _) = flate.inflate(namesBlob, 0, namesSize) onerror recover (byte[], 0)
			return self when data.len() < 8 || string(data[0:8]) != "ADMNAME1"
			let r = new NameReader(data, 8)
			let wordCount = r.varint()
			words.cap(wordCount)
			for let _ in 0..wordCount {
				let n = r.varint()
				words.push(string(data[r.pos:r.pos + n]))
				r.pos += n
			}
			let count = r.varint()
			codes.cap(count)
			starts.cap(count + 1)
			let cp = -1
			for let _ in 0..count {
				cp += r.varint() + 1
				codes.push(cp)
				starts.push(indices.len())
				let n = r.varint()
				for let _ in 0..n {
					indices.push(uint16(r.varint()))
				}
			}
			starts.push(indices.len())
			return self
		}

		// The table with `parts` filled.
		atomic def searchable() NameTable {
			load()
			return self when indexed
			indexed = true
			parts = map<string, int[]>{}
			for let (i, w) in words {
				continue unless w.contains("-")
				for let (_, part) in w.split("-") {
					continue when part.len() == 0
					let holders = parts.get(part)
					if holders is none {
						parts[part] = int[i]
					} else if holders[holders.len() - 1] != i {
						holders.push(i)
					}
				}
			}
			return self
		}
	}

	internal let nameTable = new NameTable()

	// NameReader reads the varints of the decoded name table.
	internal type NameReader {
		data byte[]
		pos  int

		def new(data byte[], pos int) {
			self.data = data
			self.pos = pos
		}

		def varint() int {
			let n = 0
			let shift = 0
			for pos < data.len() {
				let b = int(data[pos])
				pos++
				n |= (b & 0x7F) << shift
				return n when b < 0x80
				shift += 7
			}
			return n
		}
	}

	// The character's name, the Name property: "LATIN SMALL LETTER A",
	// "CJK UNIFIED IDEOGRAPH-4E00", "HANGUL SYLLABLE GAG". "" for a code
	// point without one: controls, private use, surrogates, unassigned.
	def name(ch char) string {
		let cp = int(ch)
		return "HANGUL SYLLABLE " + hangulShortName(cp - hangulFirst) when cp >= hangulFirst && cp <= hangulLast
		let p = lastAtOrBelow(patternFirst, cp)
		return patternPrefix[p] + cp.hex(4).upper() when p >= 0 && cp <= patternLast[p]
		let table = nameTable.load()
		let i = lastAtOrBelow(table.codes, cp)
		return "" when i < 0 || table.codes[i] != cp
		let out = ""
		for let j = table.starts[i]; j < table.starts[i + 1]; j++ {
			out += " " when j > table.starts[i]
			out += table.words[int(table.indices[j])]
		}
		return out
	}

	// The characters whose name holds every word of `words`, in code point
	// order. Words are separated by spaces or hyphens, in either text, and
	// compared whole and without regard to ASCII case: "latin small a"
	// finds U+0061 among others, "minus" finds HYPHEN-MINUS, "4e00" finds
	// CJK UNIFIED IDEOGRAPH-4E00. With `lastPrefix` the last word matches
	// any word it starts, for a query being typed ("latin small alp" finds
	// ALPHA), unless the query ends with a space or a hyphen. None when
	// `words` holds no word.
	def named(words string, lastPrefix bool = false) char[] {
		let tokens = nameWords(words)
		let found char[]
		return found when tokens.len() == 0
		let prefix = ""
		let last = words[-1]
		if lastPrefix && last != ' ' && last != '-' && last != '\t' {
			prefix = tokens[tokens.len() - 1]
			tokens.len(tokens.len() - 1)
		}
		let wanted string[]
		for let (_, t) in tokens {
			wanted.push(t) when !wanted.includes(t)
		}
		// A word also wanted whole is matched by that word.
		prefix = "" when wanted.includes(prefix)
		let rows = prefix == "" ?? (wanted.len(), wanted.len() + 1)

		// Stored names: per wanted word (the prefix last), which dictionary
		// words hold it.
		let table = nameTable.searchable()
		let count = table.words.len()
		let holds bool[]
		holds.len(rows * count)
		holds.fill(false)
		let possible = true
		for let (k, w) in wanted {
			let exact = lastAtOrBelow(table.words, w)
			let whole = exact >= 0 && table.words[exact] == w
			holds[k * count + exact] = true when whole
			let holders = table.parts.get(w)
			if holders is none {
				possible = possible && whole
				continue
			}
			for let (_, i) in holders {
				holds[k * count + i] = true
			}
		}
		if prefix != "" {
			let row = wanted.len() * count
			let any = false
			let i = lastAtOrBelow(table.words, prefix)
			i++ when i < 0 || table.words[i] != prefix
			for i < count && table.words[i].startsWith(prefix) {
				holds[row + i] = true
				any = true
				i++
			}
			for let (part, holders) in table.parts {
				continue unless part.startsWith(prefix)
				for let (_, h) in holders {
					holds[row + h] = true
				}
				any = true
			}
			possible = possible && any
		}
		let stored char[]
		if possible {
			for let (e, cp) in table.codes {
				let all = true
				for let k = 0; k < rows && all; k++ {
					let has = false
					for let j = table.starts[e]; j < table.starts[e + 1] && !has; j++ {
						has = holds[k * count + int(table.indices[j])]
					}
					all = has
				}
				stored.push(char(cp)) when all
			}
		}

		// Computed names, in code point order: the pattern ranges with the
		// Hangul syllables between them.
		let computed char[]
		let hangulDone = false
		for let (p, first) in patternFirst {
			if !hangulDone && first > hangulLast {
				hangulNamed(wanted, prefix, computed)
				hangulDone = true
			}
			patternNamed(wanted, prefix, p, computed)
		}
		hangulNamed(wanted, prefix, computed) when !hangulDone

		// Merge the two ascending lists.
		found.cap(stored.len() + computed.len())
		let a = 0
		let b = 0
		for a < stored.len() || b < computed.len() {
			if b >= computed.len() || (a < stored.len() && int(stored[a]) < int(computed[b])) {
				found.push(stored[a])
				a++
			} else {
				found.push(computed[b])
				b++
			}
		}
		return found
	}

	// The words of a query in order: split at spaces and hyphens, in ASCII
	// uppercase.
	internal def nameWords(text string) string[] {
		let out string[]
		for let (_, piece) in text.upper().split(" ") {
			for let (_, w) in piece.split("-") {
				let t = w.trim("\t\r\n")
				out.push(t) when t.len() > 0
			}
		}
		return out
	}

	// Appends the code points of pattern range `p` whose name holds every
	// wanted word, and a word starting with `prefix` unless it is empty:
	// words of the range's prefix match the whole range, a hexadecimal word
	// the one code point it names, a hexadecimal prefix the code points
	// whose hex starts with it.
	internal def patternNamed(wanted string[], prefix string, p int, out char[]) {
		let words = string[]
		for let (_, piece) in patternPrefix[p].split(" ") {
			for let (_, w) in piece.split("-") {
				words.push(w) when w.len() > 0
			}
		}
		let lo = patternFirst[p]
		let hi = patternLast[p]
		for let (_, w) in wanted {
			continue when words.includes(w)
			return when w.len() < 4 || w.len() > 6 || !isUpperHex(w)
			let v = w.toInt<int>(16)
			return when v.hex(4).upper() != w || v < lo || v > hi
			lo = v
			hi = v
		}
		let open = prefix == ""
		for let (_, w) in words {
			open = open || w.startsWith(prefix)
		}
		if open {
			for let cp = lo; cp <= hi; cp++ {
				out.push(char(cp))
			}
			return
		}
		return when prefix.len() > 6 || !isUpperHex(prefix)
		// Names spell the code point in four hex digits, zero-padded, or in
		// five or six without leading zeros.
		let start = prefix.toInt<int>(16)
		let digitRanges = [0, 0xFFFF, 0x10000, 0xFFFFF, 0x100000, 0x10FFFF]
		for let d = 4; d <= 6; d++ {
			continue when prefix.len() > d
			let shift = 4 * (d - prefix.len())
			let from = (start << shift).max(digitRanges[2 * (d - 4)]).max(lo)
			let to = (((start + 1) << shift) - 1).min(digitRanges[2 * (d - 4) + 1]).min(hi)
			for let cp = from; cp <= to; cp++ {
				out.push(char(cp))
			}
		}
	}

	// Appends the Hangul syllables whose name holds every wanted word, and
	// a word starting with `prefix` unless it is empty: HANGUL and SYLLABLE
	// match all of them, another word the syllables it spells, a prefix
	// the syllables whose spelling starts with it.
	internal def hangulNamed(wanted string[], prefix string, out char[]) {
		let spelled = ""
		for let (_, w) in wanted {
			continue when w := "HANGUL" || "SYLLABLE"
			return when spelled != ""
			spelled = w
		}
		let open = prefix == "" || "HANGUL".startsWith(prefix) || "SYLLABLE".startsWith(prefix)
		if spelled != "" {
			return unless open || spelled.startsWith(prefix)
			open = true
		}
		// With a spelled word each jamo must match it exactly; with only a
		// prefix, once the prefix is used up every following jamo does.
		let target = spelled != "" ?? (spelled, prefix)
		let exact = spelled != ""
		if !exact && open {
			for let cp = hangulFirst; cp <= hangulLast; cp++ {
				out.push(char(cp))
			}
			return
		}
		for let (l, lead) in jamoLeading {
			let afterLead = ""
			if target.startsWith(lead) {
				afterLead = target.slice(lead.len())
			} else {
				continue when exact || !lead.startsWith(target)
			}
			for let (v, vowel) in jamoVowel {
				let rest = ""
				if afterLead.startsWith(vowel) {
					rest = afterLead.slice(vowel.len())
				} else {
					continue when exact || !vowel.startsWith(afterLead)
				}
				for let (t, trail) in jamoTrailing {
					let fits = exact ?? (rest == trail, trail.startsWith(rest))
					out.push(char(hangulFirst + (l * jamoVowel.len() + v) * jamoTrailing.len() + t)) when fits
				}
			}
		}
	}

	// The jamo short names of syllable `s` (its offset from U+AC00) joined:
	// "GAG" for U+AC01.
	internal def hangulShortName(s int) string {
		let perLead = jamoVowel.len() * jamoTrailing.len()
		return jamoLeading[s / perLead] + jamoVowel[s % perLead / jamoTrailing.len()] + jamoTrailing[s % jamoTrailing.len()]
	}

	// Index of the last key at or below `key` in the ascending array, or -1.
	internal def lastAtOrBelow(keys string[], key string) int {
		let lo = 0
		let hi = keys.len()
		for lo < hi {
			let mid = (lo + hi) / 2
			if keys[mid] <= key {
				lo = mid + 1
			} else {
				hi = mid
			}
		}
		return lo - 1
	}

	internal def isUpperHex(w string) bool {
		for let (_, c) in w {
			return false unless (c >= '0' && c <= '9') || (c >= 'A' && c <= 'F')
		}
		return true
	}
}
