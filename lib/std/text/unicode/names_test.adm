partial module std.text.unicode {
	use (
		std.os
		std.testing
	)

	check "Unicode blocks and names" {
		def charCodes(chars char[]) int[] {
			let out int[]
			for let (_, ch) in chars {
				out.push(int(ch))
			}
			return out
		}

		def sameChars(got char[], want int[]) bool {
			return false when got.len() != want.len()
			for let (i, ch) in got {
				return false when int(ch) != want[i]
			}
			return true
		}

		@test()
		def blocksOfCodePoints() !none {
			let latin = block('A')
			assert latin.name == "Basic Latin"
			assert int(latin.first) == 0 && int(latin.last) == 0x7F
			let cjk = block(char(0x4E00))
			assert cjk.name == "CJK Unified Ideographs"
			assert int(cjk.first) == 0x4E00 && int(cjk.last) == 0x9FFF
			assert block(char(0x10FFFF)).name == "Supplementary Private Use Area-B"
			// Unassigned between Ideographic Description Characters and CJK
			// Symbols and Punctuation.
			let gap = block(char(0x2FE5))
			assert gap.name == "No_Block"
			assert int(gap.first) == 0x2FE0 && int(gap.last) == 0x2FEF
			let all = blocks()
			assert all[0].name == "Basic Latin"
			for let i = 1; i < all.len(); i++ {
				assert int(all[i - 1].last) < int(all[i].first)
			}
		}

		// Every block of the UCD file, when the system has it, and the
		// unassigned ranges between them.
		@test()
		def matchesBlocksTxt() !none {
			let text = os.readFile("/usr/share/unicode/ucd/Blocks.txt")
			return none when text is error
			let all = blocks()
			let n = 0
			let next = 0
			for let (_, line) in string(text).split("\n") {
				continue when line.len() == 0 || line.startsWith("#")
				let f = line.split(";")
				let range = f[0].split("..")
				let first = parseInt<int>(range[0], 16)
				let last = parseInt<int>(range[1], 16)
				let name = f[1].trim(" ")
				assert all[n].name == name && int(all[n].first) == first && int(all[n].last) == last
				assert block(char(first)).name == name && block(char(last)).name == name
				if first > next {
					let gap = block(char(first - 1))
					assert gap.name == "No_Block" && int(gap.first) == next && int(gap.last) == first - 1
				}
				next = last + 1
				n++
			}
			assert n == all.len() && n > 300
		}

		@test()
		def namesOfCodePoints() !none {
			assert name('A') == "LATIN CAPITAL LETTER A"
			assert name('-') == "HYPHEN-MINUS"
			assert name(char(0x0F60)) == "TIBETAN LETTER -A"
			assert name(char(0x1F600)) == "GRINNING FACE"
			assert name(char(0x4E00)) == "CJK UNIFIED IDEOGRAPH-4E00"
			assert name(char(0x20000)) == "CJK UNIFIED IDEOGRAPH-20000"
			assert name(char(0xF900)) == "CJK COMPATIBILITY IDEOGRAPH-F900"
			assert name(char(0xAC00)) == "HANGUL SYLLABLE GA"
			assert name(char(0xAC01)) == "HANGUL SYLLABLE GAG"
			assert name(char(0xC544)) == "HANGUL SYLLABLE A"
			assert name(char(0xD7A3)) == "HANGUL SYLLABLE HIH"
			assert name(char(0x0A)) == "" // control
			assert name(char(0xE000)) == "" // private use
			assert name(char(0x0378)) == "" // unassigned
		}

		@test()
		def searchesNames() !none {
			let a = named("latin capital letter a")
			assert a.len() > 10 && a[0] == 'A'
			assert sameChars(named("Hyphen-Minus"), [0x2D, 0xFE63, 0xFF0D, 0xE002D])
			let minus = named("minus")
			assert minus.includes('-') && minus.includes(char(0x2212))
			assert sameChars(named("4e00"), [0x4E00, 0x1F229]) // and SQUARED CJK UNIFIED IDEOGRAPH-4E00
			assert sameChars(named("cjk unified ideograph-4E00"), [0x4E00, 0x1F229])
			assert sameChars(named("ideograph 4E00 unified cjk"), [0x4E00, 0x1F229])
			assert named("cjk compatibility 4E00").len() == 0
			assert named("04E00").len() == 0
			assert sameChars(named("hangul syllable gag"), [0xAC01])
			assert sameChars(named("GAG"), [0xAC01, 0x1045C]) // and SHAVIAN LETTER GAG
			assert named("hangul syllable").len() == 11172
			assert named("").len() == 0
			assert named("  - ").len() == 0
			assert named("nosuchword").len() == 0
		}

		@test()
		def searchesWithTheLastWordAsAPrefix() !none {
			assert named("hira", lastPrefix = true).includes(char(0x3042)) // HIRAGANA LETTER A
			assert named("latin small letter alp", lastPrefix = true).includes(char(0x0251)) // ALPHA
			assert sameChars(named("arrow ", lastPrefix = true), charCodes(named("arrow")))
			assert named("arrow", lastPrefix = true).len() > named("arrow").len() // ARROWHEAD
			let fourE = named("4e", lastPrefix = true)
			assert fourE.includes(char(0x4E00)) && fourE.includes(char(0x4EFF)) && !fourE.includes(char(0x4F00))
			let ext = named("cjk unified ideograph 2000", lastPrefix = true)
			assert ext.len() == 16 && int(ext[0]) == 0x20000 && int(ext[15]) == 0x2000F
			assert sameChars(named("hangul syllable gag", lastPrefix = true), [0xAC01, 0xAC02, 0xAC03])
			assert named("hangul syllable ga", lastPrefix = true).len() == 56 // GA*, GAE*
			assert named("syllable ggw", lastPrefix = true).len() == 145 // Hangul GGWA, GGWAE, GGWEO, GGWE, GGWI (140), Ethiopic GGW* (5)
			assert named("hang", lastPrefix = true).len() > 11172
			assert named("cjk 4e00 syl", lastPrefix = true).len() == 0
			assert named("zzzz", lastPrefix = true).len() == 0
		}

		// Searches: words in many names, a word in a few, and the ideographs
		// (computed names); then names of one code point per stored name's
		// neighbourhood.
		@benchmark()
		def searchCommonWords() {
			let _ = named("latin small letter")
		}

		@benchmark()
		def searchRareWord() {
			let _ = named("grinning")
		}

		@benchmark()
		def searchIdeographs() {
			let _ = named("cjk ideograph")
		}

		// A query being typed: a short last word, and one letter, which
		// starts a word of most names.
		@benchmark()
		def searchTypedPrefix() {
			let _ = named("arr", lastPrefix = true)
		}

		@benchmark()
		def searchOneLetter() {
			let _ = named("l", lastPrefix = true)
		}

		@benchmark()
		def namesOfAPlane() {
			let n = 0
			for let cp = 0; cp < 0x10000; cp += 7 {
				n += name(char(cp)).len()
			}
		}

		// Every name of the UCD file, when the system has it: each listed code
		// point has its name, every other has none, and searches find what
		// the names hold.
		@test()
		def matchesDerivedName() !none {
			let text = os.readFile("/usr/share/unicode/ucd/extracted/DerivedName.txt")
			return none when text is error
			let firsts int[]
			let lasts int[]
			let listed string[]
			for let (_, line) in string(text).split("\n") {
				continue when line.len() == 0 || line.startsWith("#")
				let f = line.split(";")
				let range = f[0].trim(" ").split("..")
				firsts.push(parseInt<int>(range[0], 16))
				lasts.push(parseInt<int>(range[range.len() - 1], 16))
				listed.push(f[1].trim(" "))
			}
			assert listed.len() > 40000

			let queries = ["LATIN SMALL A", "ARROW", "IDEOGRAPH 2A700", "SYLLABLE GGWAEH", "EGYPTIAN"]
			let wordsOf string[][]
			let expected int[][]
			for let (_, q) in queries {
				wordsOf.push(q.split(" "))
				expected.push(int[])
			}
			// The same with the last word a prefix.
			let typed = ["LATIN SMALL LETTER AL", "ARR", "IDEOGRAPH 2A7", "SYLLABLE GGW", "HIRA", "4E"]
			let typedWords string[][]
			let typedExpected int[][]
			for let (_, q) in typed {
				typedWords.push(q.split(" "))
				typedExpected.push(int[])
			}

			let failures = 0
			let entry = 0
			for let cp = 0; cp <= 0x10FFFF; cp++ {
				entry++ when entry < listed.len() && cp > lasts[entry]
				let want = ""
				if entry < listed.len() && cp >= firsts[entry] {
					want = listed[entry]
					want = want.replace("*", "%04X".format(cp)) when want.endsWith("*")
				}
				let got = name(char(cp))
				if got != want {
					println("U+{"%04X".format(cp)}: {got} != {want}") when failures < 10
					failures++
				}
				continue when want == ""
				let has string[]
				for let (_, piece) in want.split(" ") {
					for let (_, w) in piece.split("-") {
						has.push(w)
					}
				}
				for let (k, ws) in wordsOf {
					let all = true
					for let (_, w) in ws {
						all = all && has.includes(w)
					}
					expected[k].push(cp) when all
				}
				for let (k, ws) in typedWords {
					let all = true
					for let i = 0; i < ws.len() - 1; i++ {
						all = all && has.includes(ws[i])
					}
					let started = false
					for let (_, w) in has {
						started = started || w.startsWith(ws[ws.len() - 1])
					}
					typedExpected[k].push(cp) when all && started
				}
			}
			assert failures == 0 // every code point has the file's name
			for let (k, q) in queries {
				assert expected[k].len() > 0
				assert sameChars(named(q), expected[k]) // the search finds the names holding the words
			}
			for let (k, q) in typed {
				assert typedExpected[k].len() > 0
				assert sameChars(named(q, lastPrefix = true), typedExpected[k]) // and with the last word a prefix
			}
		}
	}
}
