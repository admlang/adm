// Text segmentation (UAX #29): user-perceived characters (grapheme
// clusters), words and sentences.

partial module std.text.unicode {
	use std.text.unicode.tables::*

	// Grapheme_Cluster_Break values, in table order.
	internal const (
		gbCR          = 1
		gbLF          = 2
		gbControl     = 3
		gbExtend      = 4
		gbZWJ         = 5
		gbRI          = 6
		gbPrepend     = 7
		gbSpacingMark = 8
		gbL           = 9
		gbV           = 10
		gbT           = 11
		gbLV          = 12
		gbLVT         = 13
	)

	// Indic_Conjunct_Break values.
	internal const (
		incbLinker    = 1
		incbConsonant = 2
		incbExtend    = 3
	)

	// Word_Break values.
	internal const (
		wbCR           = 1
		wbLF           = 2
		wbNewline      = 3
		wbExtend       = 4
		wbZWJ          = 5
		wbRI           = 6
		wbFormat       = 7
		wbKatakana     = 8
		wbHebrew       = 9
		wbALetter      = 10
		wbSingleQuote  = 11
		wbDoubleQuote  = 12
		wbMidNumLet    = 13
		wbMidLetter    = 14
		wbMidNum       = 15
		wbNumeric      = 16
		wbExtendNumLet = 17
		wbWSegSpace    = 18
	)

	// Sentence_Break values.
	internal const (
		sbCR        = 1
		sbLF        = 2
		sbExtend    = 3
		sbSep       = 4
		sbFormat    = 5
		sbSp        = 6
		sbLower     = 7
		sbUpper     = 8
		sbOLetter   = 9
		sbNumeric   = 10
		sbATerm     = 11
		sbSContinue = 12
		sbSTerm     = 13
		sbClose     = 14
	)

	// Where the text's user-perceived characters (grapheme clusters) end,
	// as character indices (as `string.slice` and `len` count them): a
	// letter with its accents, a Hangul syllable, an emoji sequence, a flag,
	// CR LF. The last is the end of the text; an empty text has none. A
	// caret moves and a backspace deletes one at a time.
	def graphemeBreaks(text string) int[] {
		let gb int[]
		let incb int[]
		let pict bool[]
		for let (_, ch) in text {
			let r = record(ch)
			let v = int(recordGrapheme[r])
			gb.push(v & 0xF)
			incb.push(v >> 4)
			pict.push(int(recordFlags[r]) & flagPictographic != 0)
		}
		let out int[]
		let n = gb.len()
		for let i = 1; i < n; i++ {
			out.push(i) when graphemeBoundary(gb, incb, pict, i)
		}
		out.push(n) when n > 0
		return out
	}

	// Whether a grapheme cluster ends between characters i - 1 and i.
	internal def graphemeBoundary(gb int[], incb int[], pict bool[], i int) bool {
		let a = gb[i - 1]
		let b = gb[i]
		// GB3-GB5: CR LF stays whole; controls stand alone.
		return false when a == gbCR && b == gbLF
		return true when a == gbControl || a == gbCR || a == gbLF
		return true when b == gbControl || b == gbCR || b == gbLF
		// GB6-GB8: Hangul syllables.
		return false when a == gbL && (b == gbL || b == gbV || b == gbLV || b == gbLVT)
		return false when (a == gbLV || a == gbV) && (b == gbV || b == gbT)
		return false when (a == gbLVT || a == gbT) && b == gbT
		// GB9-GB9b: marks and joiners attach; prepends lead.
		return false when b == gbExtend || b == gbZWJ || b == gbSpacingMark || a == gbPrepend
		// GB9c: a consonant after a linker (a virama) and its extenders
		// joins the cluster.
		if incb[i] == incbConsonant {
			let j = i - 1
			for j >= 0 && incb[j] == incbExtend {
				j--
			}
			return false when j >= 0 && incb[j] == incbLinker
		}
		// GB11: emoji ZWJ sequences.
		if a == gbZWJ && pict[i] {
			let j = i - 2
			for j >= 0 && gb[j] == gbExtend {
				j--
			}
			return false when j >= 0 && pict[j]
		}
		// GB12-GB13: regional indicators pair up into flags.
		if a == gbRI && b == gbRI {
			let count = 0
			for let j = i - 1; j >= 0 && gb[j] == gbRI; j-- {
				count++
			}
			return count % 2 == 0
		}
		return true
	}

	// Where the text's words, and the spaces and punctuation between them,
	// end (UAX #29 word boundaries), as character indices; the last is the
	// end of the text. "can't", "3.14" and "e-mail"'s parts stay whole;
	// ideographs and emoji each stand alone. Double-click selection and
	// moving the caret by word use these.
	def wordBreaks(text string) int[] {
		let wb int[]
		let pict bool[]
		for let (_, ch) in text {
			let r = record(ch)
			wb.push(int(recordWord[r]))
			pict.push(int(recordFlags[r]) & flagPictographic != 0)
		}
		let out int[]
		let n = wb.len()
		for let i = 1; i < n; i++ {
			out.push(i) when wordBoundary(wb, pict, i)
		}
		out.push(n) when n > 0
		return out
	}

	internal def wordIgnorable(v int) bool {
		return v == wbExtend || v == wbFormat || v == wbZWJ
	}

	internal def isAHLetter(v int) bool {
		return v == wbALetter || v == wbHebrew
	}

	internal def isMidNumLetQ(v int) bool {
		return v == wbMidNumLet || v == wbSingleQuote
	}

	// The character before `i` that rule WB4 leaves visible, skipping
	// extends, formats and joiners; -1 at the start.
	internal def wordBefore(wb int[], i int) int {
		let j = i - 1
		for j > 0 && wordIgnorable(wb[j]) {
			j--
		}
		return j
	}

	// The visible character after `i`, or -1 past the end.
	internal def wordAfter(wb int[], i int) int {
		let j = i + 1
		for j < wb.len() && wordIgnorable(wb[j]) {
			j++
		}
		return j < wb.len() ?? (j, -1)
	}

	// Whether a word boundary falls between characters i - 1 and i.
	internal def wordBoundary(wb int[], pict bool[], i int) bool {
		let raw = wb[i - 1]
		let b = wb[i]
		// WB3-WB3d
		return false when raw == wbCR && b == wbLF
		return true when raw == wbNewline || raw == wbCR || raw == wbLF
		return true when b == wbNewline || b == wbCR || b == wbLF
		return false when raw == wbZWJ && pict[i]
		return false when raw == wbWSegSpace && b == wbWSegSpace
		// WB4: extends, formats and joiners belong to what they follow.
		return false when wordIgnorable(b)
		let p = wordBefore(wb, i)
		let a = wb[p]
		let pp = p > 0 ?? (wordBefore(wb, p), -1)
		let aa = pp >= 0 ?? (wb[pp], -1)
		let q = wordAfter(wb, i)
		let c = q >= 0 ?? (wb[q], -1)
		// WB5-WB7: letters, with an apostrophe or period between.
		return false when isAHLetter(a) && isAHLetter(b)
		return false when isAHLetter(a) && (b == wbMidLetter || isMidNumLetQ(b)) && c >= 0 && isAHLetter(c)
		return false when aa >= 0 && isAHLetter(aa) && (a == wbMidLetter || isMidNumLetQ(a)) && isAHLetter(b)
		// WB7a-WB7c: Hebrew quotes.
		return false when a == wbHebrew && b == wbSingleQuote
		return false when a == wbHebrew && b == wbDoubleQuote && c == wbHebrew
		return false when aa == wbHebrew && a == wbDoubleQuote && b == wbHebrew
		// WB8-WB12: numbers, with separators inside.
		return false when a == wbNumeric && b == wbNumeric
		return false when isAHLetter(a) && b == wbNumeric
		return false when a == wbNumeric && isAHLetter(b)
		return false when aa == wbNumeric && (a == wbMidNum || isMidNumLetQ(a)) && b == wbNumeric
		return false when a == wbNumeric && (b == wbMidNum || isMidNumLetQ(b)) && c == wbNumeric
		// WB13-WB13b
		return false when a == wbKatakana && b == wbKatakana
		return false when (isAHLetter(a) || a == wbNumeric || a == wbKatakana || a == wbExtendNumLet) && b == wbExtendNumLet
		return false when a == wbExtendNumLet && (isAHLetter(b) || b == wbNumeric || b == wbKatakana)
		// WB15-WB16: regional indicators pair up.
		if a == wbRI && b == wbRI {
			let count = 0
			let j = p
			for j >= 0 && wb[j] == wbRI {
				count++
				j = j > 0 ?? (wordBefore(wb, j), -1)
			}
			return count % 2 == 0
		}
		return true
	}

	// Where the text's sentences end (UAX #29 sentence boundaries), as
	// character indices, each sentence keeping the spaces after it; the
	// last is the end of the text. "3.5" and "e.g. this" do not end one; a
	// line or paragraph break always does. These are the default rules:
	// "Mr. Smith" ends one after "Mr.", as abbreviations need a
	// language's list.
	def sentenceBreaks(text string) int[] {
		let sb int[]
		for let (_, ch) in text {
			sb.push(int(recordSentence[record(ch)]))
		}
		let out int[]
		let n = sb.len()
		for let i = 1; i < n; i++ {
			out.push(i) when sentenceBoundary(sb, i)
		}
		out.push(n) when n > 0
		return out
	}

	internal def sentenceIgnorable(v int) bool {
		return v == sbExtend || v == sbFormat
	}

	internal def isParaSep(v int) bool {
		return v == sbSep || v == sbCR || v == sbLF
	}

	internal def isSATerm(v int) bool {
		return v == sbSTerm || v == sbATerm
	}

	// The character before `i` that rule SB5 leaves visible.
	internal def sentenceBefore(sb int[], i int) int {
		let j = i - 1
		for j > 0 && sentenceIgnorable(sb[j]) {
			j--
		}
		return j
	}

	// Whether a sentence ends between characters i - 1 and i.
	internal def sentenceBoundary(sb int[], i int) bool {
		let raw = sb[i - 1]
		let b = sb[i]
		// SB3-SB4
		return false when raw == sbCR && b == sbLF
		return true when isParaSep(raw)
		// SB5
		return false when sentenceIgnorable(b)
		let p = sentenceBefore(sb, i)
		let a = sb[p]
		let pp = p > 0 ?? (sentenceBefore(sb, p), -1)
		// SB6-SB7: a period inside a number or an abbreviation.
		return false when a == sbATerm && b == sbNumeric
		return false when a == sbATerm && b == sbUpper && pp >= 0 && (sb[pp] == sbUpper || sb[pp] == sbLower)
		// What precedes: (S|A)Term Close* Sp*.
		let j = p
		let spaces = false
		for j >= 0 && sb[j] == sbSp {
			spaces = true
			j = j > 0 ?? (sentenceBefore(sb, j), -1)
		}
		for j >= 0 && sb[j] == sbClose {
			j = j > 0 ?? (sentenceBefore(sb, j), -1)
		}
		return false when j < 0 || !isSATerm(sb[j])
		let term = sb[j]
		// SB8: a lowercase letter ahead, past anything but letters,
		// separators and terminators, means the ATerm did not end it.
		if term == sbATerm {
			for let k = i; k < sb.len(); k++ {
				let v = sb[k]
				return false when v == sbLower
				break when v == sbOLetter || v == sbUpper || isParaSep(v) || isSATerm(v)
			}
		}
		// SB8a-SB10
		return false when b == sbSContinue || isSATerm(b)
		return false when !spaces && (b == sbClose || b == sbSp || isParaSep(b))
		return false when b == sbSp || isParaSep(b)
		// SB11
		return true
	}
}
