partial module std.text.unicode {
	use (
		std.testing
		std.os
	)

	check "Text segmentation" {
		def joined(breaks int[]) string {
			let parts string[]
			for let (_, b) in breaks {
				parts.push("{b}")
			}
			return parts.join(" ")
		}

		@test()
		def graphemesKeepCharactersWhole() {
			assert joined(graphemeBreaks("abc")) == "1 2 3" // plain letters
			assert joined(graphemeBreaks("éx")) == "2 3" // e and its accent are one
			assert joined(graphemeBreaks("\r\nx")) == "2 3" // CR LF is one
			assert joined(graphemeBreaks("👩‍💻!")) == "3 4" // an emoji ZWJ sequence is one
			assert joined(graphemeBreaks("🇬🇧🇫🇷")) == "2 4" // flags pair up
			assert joined(graphemeBreaks("क्ष")) == "3" // a Devanagari conjunct is one
			assert graphemeBreaks("").len() == 0 // nothing to break
		}

		@test()
		def wordsKeepContractionsAndNumbers() {
			assert joined(wordBreaks("can't stop")) == "5 6 10" // the apostrophe stays inside
			assert joined(wordBreaks("pi is 3.14.")) == "2 3 5 6 10 11" // the decimal point stays, the full stop goes
			assert joined(wordBreaks("日本語")) == "1 2 3" // each ideograph stands alone
			assert joined(wordBreaks("a  b")) == "1 3 4" // runs of spaces are one segment
		}

		@test()
		def sentencesSkipAbbreviations() {
			assert joined(sentenceBreaks("Hi there. How are you? Fine.")) == "10 23 28" // after the spaces
			assert joined(sentenceBreaks("e.g. this one.")) == "14" // a period before a lowercase word does not end one
			assert joined(sentenceBreaks("Mr. Smith.")) == "4 10" // abbreviations need tailoring: the default rules end one
			assert joined(sentenceBreaks("It costs 3.50 now.")) == "18" // nor a decimal point
			assert joined(sentenceBreaks("one\ntwo")) == "4 7" // a line break always does
		}

		// The UCD conformance files, when the system has them, but lines
		// with U+0000, which no string can hold.
		def conformance(file string, kind int) !int {
			let data = os.readFile("/usr/share/unicode/ucd/auxiliary/" + file)
			return 0 when data is error
			let failures = 0
			for let (_, line) in string(data).split("\n") {
				let body = line.split("#")[0].trim()
				continue when body.len() == 0 || (" " + body + " ").contains(" 0000 ")
				let text = ""
				let expected int[]
				let n = 0
				for let (_, tok) in body.split(" ") {
					if tok == "÷" {
						expected.push(n) when n > 0
					} else if tok != "×" && tok != "" {
						text += string(char(parseInt<int>(tok, 16)))
						n++
					}
				}
				let got = kind == 0 ?? (graphemeBreaks(text), kind == 1 ?? (wordBreaks(text), sentenceBreaks(text)))
				if joined(got) != joined(expected) {
					println("{file} mismatch: {body} got {joined(got)}") when failures < 10
					failures++
				}
			}
			return failures
		}

		@test()
		def passesBreakTests() !none {
			assert (try conformance("GraphemeBreakTest.txt", 0)) == 0 // grapheme clusters
			assert (try conformance("WordBreakTest.txt", 1)) == 0 // words
			assert (try conformance("SentenceBreakTest.txt", 2)) == 0 // sentences
		}
	}
}
