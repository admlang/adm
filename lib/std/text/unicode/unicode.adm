// Unicode character properties and normalization, from the Unicode Character
// Database (tables generated by tools/unicode/gen_unicode.py).

partial module std.text.unicode {
	use std.text.unicode.tables::*

	// The Unicode version the tables come from: "18.0.0".
	const version = ucdVersion

	// General category of a code point (Unicode chapter 4.5).
	enum Category {
		UppercaseLetter,       // Lu
		LowercaseLetter,       // Ll
		TitlecaseLetter,       // Lt
		ModifierLetter,        // Lm
		OtherLetter,           // Lo
		NonspacingMark,        // Mn
		SpacingMark,           // Mc
		EnclosingMark,         // Me
		DecimalNumber,         // Nd
		LetterNumber,          // Nl
		OtherNumber,           // No
		ConnectorPunctuation,  // Pc
		DashPunctuation,       // Pd
		OpenPunctuation,       // Ps
		ClosePunctuation,      // Pe
		InitialPunctuation,    // Pi
		FinalPunctuation,      // Pf
		OtherPunctuation,      // Po
		MathSymbol,            // Sm
		CurrencySymbol,        // Sc
		ModifierSymbol,        // Sk
		OtherSymbol,           // So
		SpaceSeparator,        // Zs
		LineSeparator,         // Zl
		ParagraphSeparator,    // Zp
		Control,               // Cc
		Format,                // Cf
		Surrogate,             // Cs
		PrivateUse,            // Co
		Unassigned             // Cn
	}

	// The four normalization forms of UAX #15.
	enum NormalForm {
		// Canonical decomposition, then canonical composition.
		NFC,
		// Canonical decomposition.
		NFD,
		// Compatibility decomposition, then canonical composition.
		NFKC,
		// Compatibility decomposition.
		NFKD
	}

	internal def record(ch char) int {
		let cp = int(ch)
		return 0 when cp < 0 || cp > 0x10FFFF
		return int(recordOf[int(blockOf[cp >> blockShift]) << blockShift | cp & ((1 << blockShift) - 1)])
	}

	// The code point's general category. Unassigned for code points the
	// database does not list.
	def category(ch char) Category {
		return Category(int(recordCategory[record(ch)]))
	}

	// The canonical combining class: 0 for starters, otherwise the class that
	// orders marks against each other (230 above, 220 below, ...).
	def combiningClass(ch char) int {
		return int(recordCombining[record(ch)])
	}

	// The code point's script as an ISO 15924 code: "Latn", "Arab", "Deva".
	// "Zyyy" for characters shared by all scripts (punctuation, digits),
	// "Zinh" for marks that take the script of their base, "Zzzz" when
	// unassigned.
	def script(ch char) string {
		return scriptCodes[int(recordScript[record(ch)])]
	}

	// The dominant script of the text as an ISO 15924 code: the script most
	// of its letters belong to, ignoring shared ("Zyyy"), inherited ("Zinh")
	// and unassigned characters. A tie goes to the script that appears
	// first. "Zyyy" when no character names a script (empty text, digits,
	// punctuation).
	def script(text string) string {
		let counts int[]
		counts.len(scriptCodes.len())
		counts.fill(0)
		let best = -1
		for let (_, ch) in text {
			let s = int(recordScript[record(ch)])
			continue when scriptCodes[s] := "Zyyy" || "Zinh" || "Zzzz"
			counts[s]++
			best = s when best < 0 || counts[s] > counts[best]
		}
		return best < 0 ?? ("Zyyy", scriptCodes[best])
	}

	// Whether the code point is Default_Ignorable_Code_Point: invisible when
	// a font has no glyph for it (joiners, variation selectors, bidi controls).
	def isDefaultIgnorable(ch char) bool {
		return int(recordFlags[record(ch)]) & flagIgnorable != 0
	}

	// Whether the code point is Extended_Pictographic (UTS #51): emoji and
	// the pictographs a ZWJ sequence may join.
	def isExtendedPictographic(ch char) bool {
		return int(recordFlags[record(ch)]) & flagPictographic != 0
	}

	// The Bidi_Mirroring_Glyph of the code point -- ')' for '(' -- or none.
	def mirror(ch char) ?char {
		let i = search(mirrorKeys, int(ch))
		return none when i < 0
		return char(mirrorValues[i])
	}

	// The decomposition of one code point: canonical, or compatibility as
	// well when `compatibility` is set. `full` applies mappings recursively;
	// otherwise one step, as the database lists it (at most two code points
	// for a canonical mapping). Hangul syllables split into their jamo (LV
	// and T in one step). A code point without a mapping decomposes to
	// itself. Not canonically ordered; `normalize` does that.
	def decompose(ch char, compatibility bool = false, full bool = true) char[] {
		let out char[]
		if full {
			decomposeInto(int(ch), compatibility, out)
			return out
		}
		let cp = int(ch)
		let s = cp - hangulS
		if s >= 0 && s < hangulSCount {
			let t = s % hangulTCount
			if t != 0 {
				out.push(char(cp - t))
				out.push(char(hangulT + t))
			} else {
				out.push(char(hangulL + s / hangulNCount))
				out.push(char(hangulV + s % hangulNCount / hangulTCount))
			}
			return out
		}
		let i = search(decompositionKeys, cp)
		if i < 0 || (!compatibility && decompositionCompat[i] != 0) {
			out.push(ch)
			return out
		}
		for let j = decompositionStart[i]; j < decompositionStart[i + 1]; j++ {
			out.push(char(decompositionData[j]))
		}
		return out
	}

	// The primary composite of two code points -- 'é' for 'e' and U+0301 --
	// or none when they do not compose. Includes Hangul LV and LVT.
	def compose(first char, second char) ?char {
		let c = composeCodes(int(first), int(second))
		return none when c < 0
		return char(c)
	}

	// The text in normalization form `form` (UAX #15).
	def normalize(s string, form NormalForm = NormalForm.NFC) string {
		let compat = form == NormalForm.NFKC || form == NormalForm.NFKD
		let cps int[]
		for let (_, ch) in s {
			decomposeInto(int(ch), compat, cps)
		}
		reorder(cps)
		recompose(cps) when form == NormalForm.NFC || form == NormalForm.NFKC

		let out = ""
		for let (_, cp) in cps {
			out += string(char(cp))
		}
		return out
	}

	internal def decomposeInto(cp int, compat bool, out char[]) {
		let s = cp - hangulS
		if s >= 0 && s < hangulSCount {
			out.push(char(hangulL + s / hangulNCount))
			out.push(char(hangulV + s % hangulNCount / hangulTCount))
			out.push(char(hangulT + s % hangulTCount)) when s % hangulTCount != 0
			return
		}
		let i = search(decompositionKeys, cp)
		if i < 0 || (!compat && decompositionCompat[i] != 0) {
			out.push(char(cp))
			return
		}
		for let j = decompositionStart[i]; j < decompositionStart[i + 1]; j++ {
			decomposeInto(decompositionData[j], compat, out)
		}
	}

	internal def decomposeInto(cp int, compat bool, out int[]) {
		let chars char[]
		decomposeInto(cp, compat, chars)
		for let (_, ch) in chars {
			out.push(int(ch))
		}
	}

	internal def composeCodes(a int, b int) int {
		let l = a - hangulL
		let v = b - hangulV
		return hangulS + (l * hangulVCount + v) * hangulTCount when l >= 0 && l < hangulLCount && v >= 0 && v < hangulVCount
		let s = a - hangulS
		let t = b - hangulT
		return a + t when s >= 0 && s < hangulSCount && s % hangulTCount == 0 && t > 0 && t < hangulTCount
		let i = search(compositionKeys, a << 21 | b)
		return i < 0 ?? (-1, compositionValues[i])
	}

	// Canonical ordering: a stable sort of every run of non-starters by class.
	internal def reorder(cps int[]) {
		for let i = 1; i < cps.len(); i++ {
			let c = combiningClass(char(cps[i]))
			continue when c == 0
			let j = i
			for j > 0 && combiningClass(char(cps[j - 1])) > c {
				let t = cps[j - 1]
				cps[j - 1] = cps[j]
				cps[j] = t
				j--
			}
		}
	}

	// Canonical composition (UAX #15 section 1.3) in place.
	internal def recompose(cps int[]) {
		return when cps.len() == 0
		let starter = -1
		let lastClass = -1
		let w = 0
		for let r = 0; r < cps.len(); r++ {
			let cp = cps[r]
			let c = combiningClass(char(cp))
			// Not blocked: nothing kept since the starter, or only marks of a lower class.
			if starter >= 0 && lastClass < c {
				let composed = composeCodes(cps[starter], cp)
				if composed >= 0 {
					cps[starter] = composed
					continue
				}
			}
			if c == 0 {
				starter = w
				lastClass = -1
			} else {
				lastClass = c
			}
			cps[w] = cp
			w++
		}
		cps.len(w)
	}

	// Index of `key` in the ascending array, or -1.
	internal def search(keys int[], key int) int {
		let lo = 0
		let hi = keys.len() - 1
		for lo <= hi {
			let mid = (lo + hi) / 2
			if keys[mid] < key {
				lo = mid + 1
			} else if keys[mid] > key {
				hi = mid - 1
			} else {
				return mid
			}
		}
		return -1
	}
}
