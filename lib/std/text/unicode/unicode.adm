// Unicode character properties and normalization, from the Unicode Character
// Database (tables generated by tools/unicode/gen_unicode.py).

partial module std.text.unicode {
	use std.text.unicode.tables::*

	// The Unicode version the tables come from: "18.0.0".
	const version = ucdVersion

	// General category of a code point (Unicode chapter 4.5).
	enum Category {
		UppercaseLetter,       // Lu
		LowercaseLetter,       // Ll
		TitlecaseLetter,       // Lt
		ModifierLetter,        // Lm
		OtherLetter,           // Lo
		NonspacingMark,        // Mn
		SpacingMark,           // Mc
		EnclosingMark,         // Me
		DecimalNumber,         // Nd
		LetterNumber,          // Nl
		OtherNumber,           // No
		ConnectorPunctuation,  // Pc
		DashPunctuation,       // Pd
		OpenPunctuation,       // Ps
		ClosePunctuation,      // Pe
		InitialPunctuation,    // Pi
		FinalPunctuation,      // Pf
		OtherPunctuation,      // Po
		MathSymbol,            // Sm
		CurrencySymbol,        // Sc
		ModifierSymbol,        // Sk
		OtherSymbol,           // So
		SpaceSeparator,        // Zs
		LineSeparator,         // Zl
		ParagraphSeparator,    // Zp
		Control,               // Cc
		Format,                // Cf
		Surrogate,             // Cs
		PrivateUse,            // Co
		Unassigned             // Cn
	}

	// The four normalization forms of UAX #15.
	enum NormalForm {
		// Canonical decomposition, then canonical composition.
		NFC,
		// Canonical decomposition.
		NFD,
		// Compatibility decomposition, then canonical composition.
		NFKC,
		// Compatibility decomposition.
		NFKD
	}

	// How a code point's decomposition mapping relates it to the mapping:
	// canonically, or by a compatibility tag of UnicodeData.txt (a wide or
	// narrow form, a superscript, a ligature as Compat). None without a
	// mapping.
	enum DecompositionType {
		None,
		Canonical,
		Compat,
		Circle,
		Final,
		Font,
		Fraction,
		Initial,
		Isolated,
		Medial,
		Narrow,
		NoBreak,
		Small,
		Square,
		Sub,
		Super,
		Vertical,
		Wide
	}

	// How a code point joins its neighbours in cursive scripts (Joining_Type,
	// Unicode chapter 9.2).
	enum JoiningType {
		NonJoining,    // U
		JoinCausing,   // C, the zero width joiner and tatweel
		DualJoining,   // D
		LeftJoining,   // L
		RightJoining,  // R
		Transparent    // T, most marks
	}

	// The Hangul_Syllable_Type of a code point (Unicode chapter 3.12).
	enum HangulSyllableType {
		NotApplicable,
		LeadingJamo,   // L
		VowelJamo,     // V
		TrailingJamo,  // T
		LVSyllable,    // LV
		LVTSyllable    // LVT
	}

	internal def record(ch char) int {
		let cp = int(ch)
		return 0 when cp < 0 || cp > 0x10FFFF
		return int(recordOf[int(blockOf[cp >> blockShift]) << blockShift | cp & ((1 << blockShift) - 1)])
	}

	// The code point's general category. Unassigned for code points the
	// database does not list.
	def category(ch char) Category {
		return Category(int(recordCategory[record(ch)]))
	}

	// The canonical combining class: 0 for starters, otherwise the class that
	// orders marks against each other (230 above, 220 below, ...).
	def combiningClass(ch char) int {
		return int(recordCombining[record(ch)])
	}

	// The code point's script as an ISO 15924 code: "Latn", "Arab", "Deva".
	// "Zyyy" for characters shared by all scripts (punctuation, digits),
	// "Zinh" for marks that take the script of their base, "Zzzz" when
	// unassigned.
	def script(ch char) string {
		return scriptCodes[int(recordScript[record(ch)])]
	}

	// The dominant script of the text as an ISO 15924 code: the script most
	// of its letters belong to, ignoring shared ("Zyyy"), inherited ("Zinh")
	// and unassigned characters. A tie goes to the script that appears
	// first. "Zyyy" when no character names a script (empty text, digits,
	// punctuation).
	def script(text string) string {
		let counts int[]
		counts.len(scriptCodes.len())
		counts.fill(0)
		let best = -1
		for let (_, ch) in text {
			let s = int(recordScript[record(ch)])
			continue when scriptCodes[s] := "Zyyy" || "Zinh" || "Zzzz"
			counts[s]++
			best = s when best < 0 || counts[s] > counts[best]
		}
		return best < 0 ?? ("Zyyy", scriptCodes[best])
	}

	// Whether the code point is Default_Ignorable_Code_Point: invisible when
	// a font has no glyph for it (joiners, variation selectors, bidi controls).
	def isDefaultIgnorable(ch char) bool {
		return int(recordFlags[record(ch)]) & flagIgnorable != 0
	}

	// Whether the code point is Extended_Pictographic (UTS #51): emoji and
	// the pictographs a ZWJ sequence may join.
	def isExtendedPictographic(ch char) bool {
		return int(recordFlags[record(ch)]) & flagPictographic != 0
	}

	// Whether the code point is Emoji_Presentation (UTS #51): drawn as a
	// colour emoji by default, without a U+FE0F variation selector.
	def isEmojiPresentation(ch char) bool {
		return int(recordFlags[record(ch)]) & flagEmojiPresentation != 0
	}

	// The code point's decomposition type: Canonical or a compatibility tag
	// when it has a mapping, None otherwise. Hangul syllables are Canonical.
	def decompositionType(ch char) DecompositionType {
		let cp = int(ch)
		return DecompositionType.Canonical when cp >= hangulS && cp < hangulS + hangulSCount
		let i = search(decompositionKeys, cp)
		return DecompositionType.None when i < 0
		return DecompositionType(int(decompositionCompat[i]) + 1)
	}

	// The code point's Joining_Type: NonJoining unless the database lists
	// it.
	def joiningType(ch char) JoiningType {
		let cp = int(ch)
		let lo = 0
		let hi = joiningStarts.len() - 1
		for lo < hi {
			let mid = (lo + hi + 1) / 2
			if joiningStarts[mid] <= cp {
				lo = mid
			} else {
				hi = mid - 1
			}
		}
		return JoiningType(int(joiningTypes[lo]))
	}

	// The code point's Hangul_Syllable_Type: the jamo and precomposed
	// syllables of the Hangul script, NotApplicable for any other.
	def hangulSyllableType(ch char) HangulSyllableType {
		let v = int(recordGrapheme[record(ch)]) & 0x0F
		// Grapheme_Cluster_Break L, V, T, LV and LVT are exactly these.
		return v >= 9 && v <= 13 ?? (HangulSyllableType(v - 8), HangulSyllableType.NotApplicable)
	}

	// Whether the code point is a noncharacter (Noncharacter_Code_Point):
	// U+FDD0 to U+FDEF, and the last two of every plane.
	def isNoncharacter(ch char) bool {
		let cp = int(ch)
		return (cp >= 0xFDD0 && cp <= 0xFDEF) || (cp & 0xFFFE) == 0xFFFE
	}

	// Whether the code point is Cased: a letter with case, or one that
	// takes part in casing (U+0345, the modifier letters).
	def isCased(ch char) bool {
		return int(recordFlags[record(ch)]) & flagCased != 0
	}

	// Whether the code point is Case_Ignorable: marks, format characters,
	// modifiers and word-internal punctuation, which casing looks through.
	def isCaseIgnorable(ch char) bool {
		return int(recordFlags[record(ch)]) & flagCaseIgnorable != 0
	}

	// The text in lowercase by the default algorithm of Unicode chapter 3.13:
	// full mappings, with a capital sigma that ends a word as final sigma.
	// Language tailorings (Turkish dotless i, Lithuanian) are not applied.
	def toLower(text string) string {
		let chars = codePoints(text)
		let out = ""
		for let (i, ch) in chars {
			if int(ch) == 0x03A3 && finalSigma(chars, i) {
				out += string(char(0x03C2))
				continue
			}
			out += mapped(lowerKeys, lowerStart, lowerData, ch)
		}
		return out
	}

	// The text in uppercase by the default algorithm of Unicode chapter 3.13,
	// with full mappings ('ß' becomes "SS").
	def toUpper(text string) string {
		let out = ""
		for let (_, ch) in text {
			out += mapped(upperKeys, upperStart, upperData, ch)
		}
		return out
	}

	// The text in titlecase by the default algorithm of Unicode chapter 3.13:
	// in each word (UAX #29), the first cased character in titlecase and the
	// rest in lowercase.
	def toTitle(text string) string {
		let chars = codePoints(text)
		let out = ""
		let start = 0
		for let (_, end) in wordBreaks(text) {
			let titled = false
			for let i = start; i < end; i++ {
				let ch = chars[i]
				if !titled && isCased(ch) {
					out += mapped(titleKeys, titleStart, titleData, ch)
					titled = true
				} else if int(ch) == 0x03A3 && finalSigma(chars, i) {
					out += string(char(0x03C2))
				} else {
					out += mapped(lowerKeys, lowerStart, lowerData, ch)
				}
			}
			start = end
		}
		return out
	}

	// The text case folded (CaseFolding.txt, common and full mappings): two
	// texts that differ only in case fold to the same one. The Turkic
	// mappings are not applied.
	def caseFold(text string) string {
		let out = ""
		for let (_, ch) in text {
			out += mapped(foldKeys, foldStart, foldData, ch)
		}
		return out
	}

	// codePoints is the text's code points as an array, for code that looks
	// before and after a position.
	def codePoints(text string) char[] {
		let out char[]
		for let (_, ch) in text {
			out.push(ch)
		}
		return out
	}

	// mapped is a code point through one of the case mapping tables, itself
	// when the table does not list it.
	internal def mapped(keys int[], starts int[], data int[], ch char) string {
		let i = search(keys, int(ch))
		return string(ch) when i < 0
		let out = ""
		for let j = starts[i]; j < starts[i + 1]; j++ {
			out += string(char(data[j]))
		}
		return out
	}

	// finalSigma is the Final_Sigma condition of Unicode chapter 3.13 at
	// index i: a cased letter before it, past any case-ignorable ones, and
	// none after it.
	internal def finalSigma(chars char[], i int) bool {
		let before = i - 1
		for before >= 0 && isCaseIgnorable(chars[before]) {
			before--
		}
		return false when before < 0 || !isCased(chars[before])
		let after = i + 1
		for after < chars.len() && isCaseIgnorable(chars[after]) {
			after++
		}
		return after >= chars.len() || !isCased(chars[after])
	}

	// The Bidi_Mirroring_Glyph of the code point -- ')' for '(' -- or none.
	def mirror(ch char) ?char {
		let i = search(mirrorKeys, int(ch))
		return none when i < 0
		return char(mirrorValues[i])
	}

	// The decomposition of one code point: canonical, or compatibility as
	// well when `compatibility` is set. `full` applies mappings recursively;
	// otherwise one step, as the database lists it (at most two code points
	// for a canonical mapping). Hangul syllables split into their jamo (LV
	// and T in one step). A code point without a mapping decomposes to
	// itself. Not canonically ordered; `normalize` does that.
	def decompose(ch char, compatibility bool = false, full bool = true) char[] {
		let out char[]
		if full {
			decomposeInto(int(ch), compatibility, out)
			return out
		}
		let cp = int(ch)
		let s = cp - hangulS
		if s >= 0 && s < hangulSCount {
			let t = s % hangulTCount
			if t != 0 {
				out.push(char(cp - t))
				out.push(char(hangulT + t))
			} else {
				out.push(char(hangulL + s / hangulNCount))
				out.push(char(hangulV + s % hangulNCount / hangulTCount))
			}
			return out
		}
		let i = search(decompositionKeys, cp)
		if i < 0 || (!compatibility && decompositionCompat[i] != 0) {
			out.push(ch)
			return out
		}
		for let j = decompositionStart[i]; j < decompositionStart[i + 1]; j++ {
			out.push(char(decompositionData[j]))
		}
		return out
	}

	// The primary composite of two code points -- 'é' for 'e' and U+0301 --
	// or none when they do not compose. Includes Hangul LV and LVT.
	def compose(first char, second char) ?char {
		let c = composeCodes(int(first), int(second))
		return none when c < 0
		return char(c)
	}

	// The text in normalization form `form` (UAX #15).
	def normalize(s string, form NormalForm = NormalForm.NFC) string {
		let compat = form == NormalForm.NFKC || form == NormalForm.NFKD
		let cps int[]
		for let (_, ch) in s {
			decomposeInto(int(ch), compat, cps)
		}
		reorder(cps)
		recompose(cps) when form == NormalForm.NFC || form == NormalForm.NFKC

		let out = ""
		for let (_, cp) in cps {
			out += string(char(cp))
		}
		return out
	}

	internal def decomposeInto(cp int, compat bool, out char[]) {
		let s = cp - hangulS
		if s >= 0 && s < hangulSCount {
			out.push(char(hangulL + s / hangulNCount))
			out.push(char(hangulV + s % hangulNCount / hangulTCount))
			out.push(char(hangulT + s % hangulTCount)) when s % hangulTCount != 0
			return
		}
		let i = search(decompositionKeys, cp)
		if i < 0 || (!compat && decompositionCompat[i] != 0) {
			out.push(char(cp))
			return
		}
		for let j = decompositionStart[i]; j < decompositionStart[i + 1]; j++ {
			decomposeInto(decompositionData[j], compat, out)
		}
	}

	internal def decomposeInto(cp int, compat bool, out int[]) {
		let chars char[]
		decomposeInto(cp, compat, chars)
		for let (_, ch) in chars {
			out.push(int(ch))
		}
	}

	internal def composeCodes(a int, b int) int {
		let l = a - hangulL
		let v = b - hangulV
		return hangulS + (l * hangulVCount + v) * hangulTCount when l >= 0 && l < hangulLCount && v >= 0 && v < hangulVCount
		let s = a - hangulS
		let t = b - hangulT
		return a + t when s >= 0 && s < hangulSCount && s % hangulTCount == 0 && t > 0 && t < hangulTCount
		let i = search(compositionKeys, a << 21 | b)
		return i < 0 ?? (-1, compositionValues[i])
	}

	// Canonical ordering: a stable sort of every run of non-starters by class.
	internal def reorder(cps int[]) {
		for let i = 1; i < cps.len(); i++ {
			let c = combiningClass(char(cps[i]))
			continue when c == 0
			let j = i
			for j > 0 && combiningClass(char(cps[j - 1])) > c {
				let t = cps[j - 1]
				cps[j - 1] = cps[j]
				cps[j] = t
				j--
			}
		}
	}

	// Canonical composition (UAX #15 section 1.3) in place.
	internal def recompose(cps int[]) {
		return when cps.len() == 0
		let starter = -1
		let lastClass = -1
		let w = 0
		for let r = 0; r < cps.len(); r++ {
			let cp = cps[r]
			let c = combiningClass(char(cp))
			// Not blocked: nothing kept since the starter, or only marks of a lower class.
			if starter >= 0 && lastClass < c {
				let composed = composeCodes(cps[starter], cp)
				if composed >= 0 {
					cps[starter] = composed
					continue
				}
			}
			if c == 0 {
				starter = w
				lastClass = -1
			} else {
				lastClass = c
			}
			cps[w] = cp
			w++
		}
		cps.len(w)
	}

	// Index of `key` in the ascending array, or -1.
	internal def search(keys int[], key int) int {
		let lo = 0
		let hi = keys.len() - 1
		for lo <= hi {
			let mid = (lo + hi) / 2
			if keys[mid] < key {
				lo = mid + 1
			} else if keys[mid] > key {
				hi = mid - 1
			} else {
				return mid
			}
		}
		return -1
	}
}
