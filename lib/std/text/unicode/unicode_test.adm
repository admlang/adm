partial module std.text.unicode {
	use (
		std.os
		std.testing
	)

	check "Unicode properties" {
		def same(got ?char, want char) bool {
			return got is none ?? (false, got == want)
		}

		@test()
		def categories() !none {
			assert category('A') == Category.UppercaseLetter // Lu
			assert category('a') == Category.LowercaseLetter // Ll
			assert category('́') == Category.NonspacingMark // combining acute
			assert category('ः') == Category.SpacingMark // Devanagari visarga
			assert category('7') == Category.DecimalNumber // Nd
			assert category(' ') == Category.SpaceSeparator // Zs
			assert category('‍') == Category.Format // ZWJ
			assert category(char(0xE0080)) == Category.Unassigned // gap in the tag block
			assert category(char(0x10FFFD)) == Category.PrivateUse // plane 16
		}

		@test()
		def combiningClasses() !none {
			assert combiningClass('a') == 0 // starter
			assert combiningClass('́') == 230 // above
			assert combiningClass('̣') == 220 // below
			assert combiningClass('्') == 9 // virama
		}

		@test()
		def scripts() !none {
			assert script('A') == "Latn" // Latin
			assert script('ب') == "Arab" // beh
			assert script('क') == "Deva" // ka
			assert script('一') == "Hani" // CJK
			assert script('1') == "Zyyy" // common
			assert script('́') == "Zinh" // inherited
			assert script(char(0xE0080)) == "Zzzz" // unassigned
			assert script("Hello, мир!") == "Latn" // most letters are Latin
			assert script("«Привет», he") == "Cyrl" // Cyrillic outnumbers Latin
			assert script("ab бв") == "Latn" // a tie goes to the first script
			assert script("السلام 123") == "Arab" // digits and spaces count for nothing
			assert script("123 !?") == "Zyyy" // no script at all
			assert script("") == "Zyyy" // empty text
		}

		@test()
		def ignorablesAndMirrors() !none {
			assert isDefaultIgnorable('‍') // ZWJ
			assert isDefaultIgnorable('️') // variation selector
			assert !isDefaultIgnorable('a') // a letter
			assert same(mirror('('), ')') // parenthesis
			assert same(mirror('≮'), '≯') // not less-than
			assert mirror('a') is none // no mirror
			assert isExtendedPictographic(char(0x1F600)) // grinning face
			assert !isExtendedPictographic('a') // a letter
			assert isEmojiPresentation(char(0x1F600)) // grinning face
			assert !isEmojiPresentation(char(0x263A)) // white smiling face: text by default
			assert isEmojiPresentation(char(0x1F1EC)) // regional indicator
			assert !isEmojiPresentation('#')
		}

		@test()
		def decomposesAndComposes() !none {
			assert decompose('é').equals(['e', '́']) // é
			assert decompose('ṩ').equals(['s', '̣', '̇']) // recursive
			assert decompose('각').equals(['ᄀ', 'ᅡ', 'ᆨ']) // Hangul LVT
			assert decompose('ﬁ').equals(['ﬁ']) // fi ligature: compatibility only
			assert decompose('ﬁ', true).equals(['f', 'i']) // with compatibility
			assert decompose(char(0x1E69), compatibility = false, full = false).equals([char(0x1E63), char(0x0307)]) // one step
			assert decompose(char(0xAC01), compatibility = false, full = false).equals([char(0xAC00), char(0x11A8)]) // Hangul LV + T
			assert same(compose('e', '́'), 'é') // é
			assert same(compose('ᄀ', 'ᅡ'), '가') // Hangul LV
			assert same(compose('가', 'ᆨ'), '각') // Hangul LVT
			// U+0958 decomposes to U+0915 U+093C but is excluded from composition.
			assert compose('क', '़') is none // excluded from composition
			assert decompose(char(0x0958)).equals(['क', '़']) // still decomposes
		}

		// Every line of the UCD conformance file, when the system has it: for
		// each column c1..c5, NFC/NFD/NFKC/NFKD give the columns UAX #15 says.
		@test()
		def passesNormalizationTest() !none {
			let text = os.readFile("/usr/share/unicode/ucd/NormalizationTest.txt")
			return none when text is error

			let failures = 0
			let checked = 0
			for let (_, line) in string(text).split("\n") {
				continue when line.len() == 0 || line.startsWith("#") || line.startsWith("@")
				let f = line.split(";")
				continue when f.len() < 5
				let c string[]
				for let i = 0; i < 5; i++ {
					let s = ""
					for let (_, hex) in f[i].split(" ") {
						s += string(char(parseInt<int>(hex, 16)))
					}
					c.push(s)
				}
				checked++
				let ok = normalize(c[0], NormalForm.NFC) == c[1] && normalize(c[2], NormalForm.NFC) == c[1]
				ok = ok && normalize(c[0], NormalForm.NFD) == c[2] && normalize(c[2], NormalForm.NFD) == c[2]
				ok = ok && normalize(c[0], NormalForm.NFKC) == c[3] && normalize(c[4], NormalForm.NFKC) == c[3]
				ok = ok && normalize(c[0], NormalForm.NFKD) == c[4] && normalize(c[4], NormalForm.NFKD) == c[4]
				if !ok {
					println("normalization mismatch: {line}") when failures < 10
					failures++
				}
			}
			assert checked > 10000 // the file was read
			assert failures == 0 // every line conforms
		}
	}
}
