// How many columns text takes where every character sits in a cell: a
// terminal, a plain text table. Tables from East_Asian_Width and the general
// categories of the Unicode Character Database.

partial module std.text.unicode {
	use std.text.unicode.widths::*

	// Returns the columns a character takes in fixed-pitch text: 2 for an
	// East Asian wide or fullwidth character (CJK ideographs, kana, Hangul
	// syllables, most emoji), 0 for a combining mark, a format character or
	// a control character, 1 for every other.
	def displayWidth(ch char) int {
		let code = int(ch)
		return code < 0x20 || code == 0x7F ?? (0, 1) when code < 0xA0
		return 0 when inRanges(zeroRanges, code)
		return 2 when inRanges(wideRanges, code)
		return 1
	}

	// Returns the columns a text takes in fixed-pitch text: the sum over
	// its characters, with a character sequence drawn as one emoji counted
	// once. Those are an emoji followed by a skin tone, emoji joined by
	// U+200D (a family, a profession), a pair of regional indicators (a
	// flag), and a narrow symbol made an emoji by U+FE0F, which takes two
	// columns.
	def displayWidth(text string) int {
		let out = 0
		// The columns of the last character that took any, whether the
		// character before was a joiner, and whether a regional indicator
		// waits for its pair.
		let last = 0
		let joined = false
		let halfFlag = false
		for let (_, ch) in text {
			let code = int(ch)
			let width = displayWidth(ch)
			if code == 0x200D {
				joined = last == 2
				continue
			}
			if code == 0xFE0F {
				// Emoji presentation of a symbol that is narrow as text.
				if last == 1 {
					out++
					last = 2
				}
				continue
			}
			continue when width == 0
			let regional = code >= 0x1F1E6 && code <= 0x1F1FF
			let paired = regional && halfFlag
			halfFlag = regional && !halfFlag
			let tone = code >= 0x1F3FB && code <= 0x1F3FF && last == 2
			if joined || paired || tone {
				joined = false
				continue
			}
			out += width
			last = width
		}
		return out
	}

	// Whether code falls in one of the runs of ranges, which holds the first
	// and last code point of each, ascending.
	internal def inRanges(ranges int[], code int) bool {
		let low = 0
		let high = ranges.len() / 2 - 1
		for low <= high {
			let middle = (low + high) / 2
			if code < ranges[2 * middle] {
				high = middle - 1
			} else if code > ranges[2 * middle + 1] {
				low = middle + 1
			} else {
				return true
			}
		}
		return false
	}
}
