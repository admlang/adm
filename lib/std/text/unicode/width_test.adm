partial module std.text.unicode {
	use std.testing

	check "Display width" {
		@test()
		def TestCharacters() {
			assert displayWidth('a') == 1 && displayWidth('é') == 1 && displayWidth('ż') == 1
			assert displayWidth('中') == 2 && displayWidth('あ') == 2 && displayWidth('한') == 2
			assert displayWidth('Ａ') == 2
			assert displayWidth('ｱ') == 1
			assert displayWidth(char(0x1F600)) == 2
			assert displayWidth(char(0x0301)) == 0
			assert displayWidth(char(0x200B)) == 0 && displayWidth(char(0x200D)) == 0
			assert displayWidth(char(0x1B)) == 0 && displayWidth(char(0x7F)) == 0
			assert displayWidth(char(0xAD)) == 1
			assert displayWidth(char(0x1160)) == 0
			assert displayWidth('─') == 1 && displayWidth('│') == 1
		}

		@test()
		def TestText() {
			assert displayWidth("") == 0
			assert displayWidth("hello") == 5
			assert displayWidth("日本語") == 6
			assert displayWidth("a中b") == 4
			assert displayWidth("e" + string(char(0x0301))) == 1
		}

		def spelled(codes int[]) string {
			let out = ""
			for let (_, code) in codes {
				out += string(char(code))
			}
			return out
		}

		@test()
		def TestEmojiSequencesCountOnce() {
			// Woman technologist: woman, joiner, laptop.
			assert displayWidth(spelled([0x1F469, 0x200D, 0x1F4BB])) == 2
			// A family of four.
			assert displayWidth(spelled([0x1F468, 0x200D, 0x1F469, 0x200D, 0x1F467, 0x200D, 0x1F466])) == 2
			// Waving hand with a skin tone; a skin tone alone is a square.
			assert displayWidth(spelled([0x1F44B, 0x1F3FD])) == 2
			assert displayWidth(spelled([0x1F3FD])) == 2
			// Flags: two regional indicators each; three make a flag and a half.
			assert displayWidth(spelled([0x1F1F7, 0x1F1F4])) == displayWidth(char(0x1F1F7))
			assert displayWidth(spelled([0x1F1F7, 0x1F1F4, 0x1F1E9, 0x1F1EA])) == 2 * displayWidth(char(0x1F1F7))
			// A heart is narrow as text and wide as an emoji.
			assert displayWidth(spelled([0x2764])) == 1
			assert displayWidth(spelled([0x2764, 0xFE0F])) == 2
			// Couple with heart: woman, joiner, heart as emoji, joiner, man.
			assert displayWidth(spelled([0x1F469, 0x200D, 0x2764, 0xFE0F, 0x200D, 0x1F468])) == 2
			// A joiner between letters joins nothing a terminal draws as one.
			assert displayWidth(spelled([0x915, 0x94D, 0x200D, 0x937])) == 2
			assert displayWidth("a" + spelled([0x1F469, 0x200D, 0x1F4BB]) + "b") == 4
		}
	}
}
