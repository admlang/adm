partial module std.time {
	use std.testing

	// Expected values from Temporal (node 26.10).
	check "Civil dates and times" {
		@test()
		def computesDates() {
			let d = new Date(2026, 10, 1)
			assert d.weekday() == Weekday.Thursday
			assert d.dayOfYear() == 274
			assert d.plusMonths(4).str() == "2027-02-01"
			assert new Date(2024, 1, 31).plusMonths(1).str() == "2024-02-29"
			assert new Date(2024, 2, 29).plusYears(1).str() == "2025-02-28"
			assert d.daysUntil(new Date(2027, 1, 1)) == 92
			assert new Date(2026, 2, 30).str() == "2026-02-28"
			assert new Date(2026, 13, 0).str() == "2026-12-01"
			assert new Date(-1, 12, 31).str() == "-000001-12-31"
			assert new Date(12026, 1, 1).str() == "+012026-01-01"
			assert new Date(1970, 1, 1).plusDays(-1).str() == "1969-12-31"
			assert fromEpochDay(0).str() == "1970-01-01"
			assert new Date(2000, 2, 29).epochDay() == 11016
			assert new Date(2024, 3, 1).compare(new Date(2024, 2, 29)) == 1
			assert d.inLeapYear() == false && d.daysInYear() == 365 && d.daysInMonth() == 31
		}

		@test()
		def readsDates() !none {
			assert (try parseDate("2026-10-01")).equals(new Date(2026, 10, 1))
			assert (try parseDate("20261001")).equals(new Date(2026, 10, 1))
			assert (try parseDate("+012026-01-01")).year == 12026
			assert (try parseDate("-000001-12-31")).year == -1
			assert parseDate("2026-02-30") is error
			assert parseDate("2026-13-01") is error
			assert parseDate("2026-1-01") is error
			assert parseDate("-000000-01-01") is error
			return none
		}

		@test()
		def computesTimes() !none {
			let t = new TimeOfDay(23, 30, 0, 250000000)
			assert t.str() == "23:30:00.25"
			assert t.nanoOfDay() == int64(84600250000000)
			assert t.plus(2h).str() == "01:30:00.25"
			assert new TimeOfDay(25, -3).str() == "23:00:00"
			assert (try parseTimeOfDay("09:05")).str() == "09:05:00"
			assert (try parseTimeOfDay("090530,5")).str() == "09:05:30.5"
			assert (try parseTimeOfDay("23:59:60")).second == 59
			assert parseTimeOfDay("24:00") is error
			assert parseTimeOfDay("9:05") is error
			return none
		}

		@test()
		def computesDateTimes() !none {
			let dt = new DateTime(2026, 12, 31, 23)
			assert dt.plus(3h).str() == "2027-01-01T02:00:00"
			assert dt.until(new DateTime(2027, 1, 2, 1)) == 26h
			assert dt.plus(-24h).str() == "2026-12-30T23:00:00"
			assert (try parseDateTime("2026-10-01 09:05")).str() == "2026-10-01T09:05:00"
			assert (try parseDateTime("2026-10-01")).time.hour == 0
			assert parseDateTime("2026-10-01T09:05Z") is error
			let at = new DateTime(2026, 10, 1, 9, 5).toTime(2h)
			assert at.str() == "2026-10-01T07:05:00Z"
			assert at.dateTime(2h).str() == "2026-10-01T09:05:00"
			assert at.dateTime().str() == "2026-10-01T07:05:00"
			return none
		}
	}
}
