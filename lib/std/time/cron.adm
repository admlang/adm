partial module std.time {
	struct CronSpec {
		@range(0, 59)
		second uint8
		@range(0, 59)
		minute uint8
		@range(0, 23)
		hour uint8
		@range(1, 31)
		day uint8
		@range(0, 6)
		weekday uint8
	}

	// A parsed cron expression that reports whether an instant matches and
	// when the next match is. Six fields are `second minute hour day month
	// weekday`; five fields omit the second, which is then 0.
	//
	// Each field takes `*`, a number, a range `a-b`, a step `*/n` or `a-b/n`,
	// and comma-separated lists of those. Months and weekdays also take
	// three-letter names (`jan`, `mon`); weekday 7 is Sunday like 0. When both
	// the day and the weekday are restricted an instant matches when either
	// does, as in Vixie cron. The macros `@yearly`/`@annually`, `@monthly`,
	// `@weekly`, `@daily`/`@midnight` and `@hourly` are accepted. Times are
	// UTC.
	type Cron {
		// One flag per minute, hour, day of month (index 1-31), month (index
		// 1-12) and weekday (0 = Sunday); true when the field admits it.
		seconds    bool[]
		minutes    bool[]
		hours      bool[]
		days       bool[]
		months     bool[]
		weekdays   bool[]
		// Whether the day and weekday fields were `*`, which decides how the
		// two combine.
		anyDay     bool
		anyWeekday bool
		// The expression this was parsed from, with macros expanded; empty
		// for a `Cron` that was not parsed.
		source     string

		def new() {
			self.seconds = flags(60)
			self.minutes = flags(60)
			self.hours = flags(24)
			self.days = flags(32)
			self.months = flags(13)
			self.weekdays = flags(7)
			self.anyDay = true
			self.anyWeekday = true
			self.source = ""
		}

		// The expression this was parsed from, with macros expanded.
		def str() string {
			return source
		}

		// Reports whether the second holding `t` matches the expression.
		def matches(t Time) bool {
			return false unless months[t.month()]
			return false unless hours[t.hour()]
			return false unless minutes[t.minute()]
			return false unless seconds[t.second()]
			return matchesDay(t.day(), int(t.weekday()))
		}

		// Returns the first matching instant strictly after `t`, on a whole
		// second, or none when nothing matches within the next five years
		// (an expression such as `0 0 31 2 *` never matches).
		def next(after Time) ?Time {
			let second = floorDiv(after.unixNs(), nsPerSecond) + 1
			let limit = second + 5 * 366 * 24 * 60 * 60
			for second < limit {
				let t = fromUnixNs(second * nsPerSecond)
				let y, m, d = t.year(), t.month(), t.day()
				if !months[m] {
					// jump to the start of the next month
					let ny, nm = y, m + 1
					if nm > 12 {
						ny, nm = y + 1, 1
					}
					second = daysFromCivil(ny, nm, 1) * 86400
					continue
				}
				if !matchesDay(d, int(t.weekday())) {
					second = (daysFromCivil(y, m, d) + 1) * 86400
					continue
				}
				if !hours[t.hour()] {
					second = (second / 3600 + 1) * 3600
					continue
				}
				if !minutes[t.minute()] {
					second = (second / 60 + 1) * 60
					continue
				}
				if !seconds[t.second()] {
					second += 1
					continue
				}
				return t
			}
			return none
		}

		internal def matchesDay(day int, weekday int) bool {
			return days[day] || weekdays[weekday] when !anyDay && !anyWeekday
			return days[day] && weekdays[weekday]
		}
	}

	internal const noNames string[] = []
	internal const monthNames = ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"]
	internal const weekdayNames = ["sun", "mon", "tue", "wed", "thu", "fri", "sat"]

	internal def expandCronMacro(expr string) string {
		match expr.lower() {
			case "@yearly", "@annually":
				return "0 0 1 1 *"
			case "@monthly":
				return "0 0 1 * *"
			case "@weekly":
				return "0 0 * * 0"
			case "@daily", "@midnight":
				return "0 0 * * *"
			case "@hourly":
				return "0 * * * *"
		}
		return expr
	}

	internal def flags(count int) bool[] {
		let out bool[] = []
		for let i in 0..count {
			out.push(false)
		}
		return out
	}

	// Reports whether a field admits any value: `*` or `*/n`, alone or in a list.
	internal def isAnyField(field string) bool {
		for let item in field.split(",") {
			return true when item == "*" || item.startsWith("*/")
		}
		return false
	}

	// Fills `set` from one field. Names are matched against `names` starting
	// at `min`; weekday sets grow to index 7 so the caller can fold Sunday.
	internal def parseCronField(field string, min int, max int, names string[], set bool[]) !none {
		for set.len() <= max {
			set.push(false)
		}
		for let item in field.split(",") {
			fail "empty item in cron field: " + field when item.isEmpty()
			let step = 1
			let spec = item
			let slash = item.indexOf("/")
			if slash >= 0 {
				spec = item[0:slash]
				step = try parseCronNumber(item[slash + 1:], 1, max, noNames)
			}
			let lo, hi = min, max
			if spec != "*" {
				let dash = spec.indexOf("-")
				if dash >= 0 {
					lo = try parseCronNumber(spec[0:dash], min, max, names)
					hi = try parseCronNumber(spec[dash + 1:], min, max, names)
					fail "cron range out of order: " + spec when lo > hi
				} else {
					lo = try parseCronNumber(spec, min, max, names)
					hi = lo
					hi = max when slash >= 0
				}
			}
			let v = lo
			for v <= hi {
				set[v] = true
				v += step
			}
		}
	}

	internal def parseCronNumber(text string, min int, max int, names string[]) !int {
		fail "empty number in cron field" when text.isEmpty()
		let value = 0
		let digits = true
		for let c in text {
			if c < '0' || c > '9' {
				digits = false
				break
			}
			value = value * 10 + int(c) - int('0')
		}
		if !digits {
			let lowered = text.lower()
			let found = -1
			for let (i, name) in names {
				if name == lowered {
					found = i + min
					found = i when min == 0
				}
			}
			fail "unknown name in cron field: " + text when found < 0
			value = found
		}
		fail "cron value " + sprint(value) + " outside " + sprint(min) + "-" + sprint(max) when value < min || value > max
		return value
	}

	// Parses a cron expression; see `Cron` for the grammar. Fails on a
	// wrong field count, an out-of-range number, an unknown name or a
	// malformed range or step.
	def parseCron(expr string) !Cron {
		let text = expandCronMacro(expr.trim())
		let fields string[] = []
		for let part in text.split(" ") {
			fields.push(part) unless part.isEmpty()
		}
		fields.unshift("0") when fields.len() == 5
		fail "cron expression needs 5 or 6 fields, got " + sprint(fields.len()) + ": " + expr unless fields.len() == 6
		let cron = new Cron()
		try parseCronField(fields[0], 0, 59, noNames, cron.seconds)
		try parseCronField(fields[1], 0, 59, noNames, cron.minutes)
		try parseCronField(fields[2], 0, 23, noNames, cron.hours)
		try parseCronField(fields[3], 1, 31, noNames, cron.days)
		try parseCronField(fields[4], 1, 12, monthNames, cron.months)
		try parseCronField(fields[5], 0, 7, weekdayNames, cron.weekdays)
		cron.anyDay = isAnyField(fields[3])
		cron.anyWeekday = isAnyField(fields[5])
		if cron.weekdays.len() > 7 {
			// 7 is Sunday
			cron.weekdays[0] = cron.weekdays[0] || cron.weekdays[7]
			cron.weekdays.pop()
		}
		cron.source = fields.join(" ")
		return cron
	}

	check "Cron" {
		use std.testing

		def isValid(expr string) bool {
			let cron = parseCron(expr) onerror recover new Cron()
			return !cron.source.isEmpty()
		}

		def hasNext(expr string, after Time) !bool {
			let next = (try parseCron(expr)).next(after)
			match next {
				case Time:
					return true
				case none:
					return false
			}
		}

		@test()
		def parsesFields() !none {
			let c = try parseCron("*/15 9-17 * * mon-fri")
			assert c.minutes[0] && c.minutes[15] && c.minutes[45] && !c.minutes[10]
			assert c.hours[9] && c.hours[17] && !c.hours[8] && !c.hours[18]
			assert c.weekdays[1] && c.weekdays[5] && !c.weekdays[0] && !c.weekdays[6]
			assert c.anyDay && !c.anyWeekday
			assert c.str() == "0 */15 9-17 * * mon-fri"

			let sunday = try parseCron("0 0 * * 7")
			let withSeconds = try parseCron("30 0 12 * * *")
			assert withSeconds.seconds[30] && !withSeconds.seconds[0] && withSeconds.hours[12]
			assert sunday.weekdays[0] && sunday.weekdays.len() == 7

			let yearly = try parseCron("@yearly")
			assert yearly.str() == "0 0 0 1 1 *"
			assert yearly.months[1] && !yearly.months[2] && yearly.days[1]
		}

		@test()
		def rejectsBadExpressions() {
			assert !isValid("* * * *")
			assert !isValid("* * * * * * *")
			assert !isValid("60 * * * *")
			assert !isValid("* * * * fun")
			assert !isValid("5-1 * * * *")
			assert !isValid("*/0 * * * *")
		}

		@test()
		def matchesInstants() !none {
			// 2026-09-03T14:05:09Z is a Thursday
			let t = try parse("2026-09-03T14:05:09Z")
			assert (try parseCron("5 14 * * *")).matches(try parse("2026-09-03T14:05:00Z"))
			assert !(try parseCron("5 14 * * *")).matches(t)
			assert (try parseCron("9 5 14 * * *")).matches(t)
			assert (try parseCron("* 5 14 * * *")).matches(t)
			assert (try parseCron("* 5 14 3 9 thu")).matches(t)
			assert !(try parseCron("* 6 14 * * *")).matches(t)
			assert !(try parseCron("* 5 14 * * fri")).matches(t)
			// day or weekday when both are restricted
			assert (try parseCron("* 5 14 1 * thu")).matches(t)
			assert (try parseCron("* 5 14 3 * mon")).matches(t)
			assert !(try parseCron("* 5 14 1 * mon")).matches(t)
		}

		def assertNext(expr string, after Time, expected string) !none {
			let next = (try parseCron(expr)).next(after)
			match next {
				case Time: assert next.str() == expected
				case none: assert false
			}
		}

		@test()
		def findsNext() !none {
			let t = try parse("2026-09-03T14:05:09Z")
			try assertNext("*/15 * * * *", t, "2026-09-03T14:15:00Z")
			try assertNext("0 9 * * *", t, "2026-09-04T09:00:00Z")
			try assertNext("0 9 * * mon", t, "2026-09-07T09:00:00Z")
			try assertNext("30 6 1 * *", t, "2026-10-01T06:30:00Z")
			try assertNext("0 0 29 2 *", t, "2028-02-29T00:00:00Z")
			try assertNext("@yearly", t, "2027-01-01T00:00:00Z")
			assert !(try hasNext("0 0 31 2 *", t))
			// strictly after: a matching minute does not return itself
			let exact = try parse("2026-09-03T14:15:00Z")
			try assertNext("*/15 * * * *", exact, "2026-09-03T14:30:00Z")
		}
	}
}
