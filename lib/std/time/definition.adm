partial module std.time {
	// Month is a month of the year, January first.
	enum Month {
		January,
		February,
		March,
		April,
		May,
		June,
		July,
		August,
		September,
		October,
		November,
		December
	}

	// Weekday is a day of the week, Sunday first, as Time.weekday reports it.
	enum Weekday {
		Sunday,
		Monday,
		Tuesday,
		Wednesday,
		Thursday,
		Friday,
		Saturday
	}
}
