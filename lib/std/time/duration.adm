partial module std.time {
	// Parses a duration such as `1h30m`, `500ms`, `2.5s`, `-90s` or `1d`:
	// a sign, then one or more `<number><unit>` parts, where the number may
	// carry a decimal fraction and the unit is one of `ns`, `us` (or `µs`),
	// `ms`, `s`, `m`, `h`, `d`. Fails on an empty string, a missing unit or
	// an unknown one.
	def parseDuration(val string) !duration {
		let s = val.trim()
		fail "duration: empty string" when s == ""
		let i = 0
		let neg = false
		if s[0] == '-' || s[0] == '+' {
			neg = s[0] == '-'
			i = 1
		}
		fail "duration: \"{s}\" has no value" when i >= s.len()
		let total = int64(0)
		for i < s.len() {
			// Number: integer part and optional fraction.
			let whole = int64(0)
			let frac = int64(0)
			let fracScale = int64(1)
			let digits = 0
			for i < s.len() && s[i] >= '0' && s[i] <= '9' {
				whole = whole * 10 + int64(int(s[i]) - int('0'))
				digits += 1
				i += 1
			}
			if i < s.len() && s[i] == '.' {
				i += 1
				for i < s.len() && s[i] >= '0' && s[i] <= '9' {
					if fracScale < 1000000000 {
						frac = frac * 10 + int64(int(s[i]) - int('0'))
						fracScale *= 10
					}
					digits += 1
					i += 1
				}
			}
			fail "duration: \"{s}\" has a unit without a number" when digits == 0
			// Unit.
			let start = i
			for i < s.len() && !(s[i] >= '0' && s[i] <= '9') && s[i] != '.' && s[i] != '-' && s[i] != '+' {
				i += 1
			}
			let unit = s[start:i]
			fail "duration: \"{s}\" is missing a unit" when unit == ""
			let scale = int64(0)
			match unit {
				case "ns": scale = 1
				case "us": scale = 1000
				case "µs": scale = 1000
				case "ms": scale = 1000000
				case "s": scale = 1000000000
				case "m": scale = 60000000000
				case "h": scale = 3600000000000
				case "d": scale = 86400000000000
				default:
					fail "duration: unknown unit \"{unit}\" in \"{s}\""
			}
			total += whole * scale + (frac * scale) / fracScale
		}
		total = -total when neg
		return duration(total)
	}
}
