partial module std.time {
	// TimeFormat names a fixed textual form of a date and time. `str(format)`
	// on `Time`, `Date`, `TimeOfDay` and `DateTime` writes it; `parse`,
	// `parseDate`, `parseTimeOfDay` and `parseDateTime` given a format read
	// exactly that form, and without one try every form that fits.
	//
	// The ISO 8601 forms (`RFC3339`, `RFC3339Nano`, `ISO8601Basic`,
	// `ISOWeek`, `ISOOrdinal`, `DateOnly`, `TimeOnly`) are a date, a time and a
	// zone part: a value writes and reads the parts it has, so
	// `date.str(TimeFormat.RFC3339)` is `2026-10-03`. The other forms are
	// whole: a civil value fails to write one that shows a field it lacks
	// (a `Date` has no clock for `ANSIC`), and reads only the forms that carry
	// exactly its fields.
	//
	// Example:
	// ```example
	// let t = try time.parse("2026-10-03T14:05:09Z")
	// println(t.str(time.TimeFormat.HTTP))                // Sat, 03 Oct 2026 14:05:09 GMT
	// println(t.str(time.TimeFormat.RFC1123Z, offset = 2h)) // Sat, 03 Oct 2026 16:05:09 +0200
	// let u = try time.parse("Sat Oct  3 14:05:09 2026")  // asctime, recognised
	// ```
	enum TimeFormat {
		// `2026-10-03T14:05:09Z`, the fraction of a second when it is not
		// zero (`09.25Z`), an offset as `+02:00`. Reading takes `t` or a space
		// for the `T`.
		RFC3339,
		// `2026-10-03T14:05:09.000000000Z`: always nine fraction digits.
		RFC3339Nano,
		// `20261003T140509Z`: ISO 8601 basic format, an offset as `+0200`.
		// Reading takes the seconds as optional and a comma for the point.
		ISO8601Basic,
		// `2026-W40-6T14:05:09Z`: ISO 8601 week date, the week-numbering
		// year, the week and the weekday (1 Monday to 7 Sunday). Reading takes
		// the seconds as optional and a comma for the point.
		ISOWeek,
		// `2026-276T14:05:09Z`: ISO 8601 ordinal date, the year and the day
		// of the year. Reading takes the seconds as optional and a comma for
		// the point.
		ISOOrdinal,
		// `2026-10-03 14:05:09`: no zone.
		DateTime,
		// `2026-10-03`.
		DateOnly,
		// `14:05:09`.
		TimeOnly,
		// `Sat, 03 Oct 2026 14:05:09 GMT`: the HTTP date (RFC 9110, RFC 1123
		// in GMT), always written in UTC whatever the offset. Reading also
		// takes the RFC 850 and asctime forms, as RFC 9110 requires.
		HTTP,
		// `Sat, 03 Oct 2026 14:05:09 +0000`: RFC 1123 with a numeric zone,
		// the mail `Date:` form (RFC 5322). Reading also takes the obsolete
		// RFC 5322 forms: no weekday, no seconds, two- and three-digit years,
		// comments and zone names.
		RFC1123Z,
		// `Saturday, 03-Oct-26 14:05:09 GMT`; another offset as `+0200`.
		RFC850,
		// `03 Oct 26 14:05 GMT`; another offset as `+0200`.
		RFC822,
		// `03 Oct 26 14:05 +0000`.
		RFC822Z,
		// `Sat Oct  3 14:05:09 2026`: C `asctime`, no zone.
		ANSIC,
		// `Sat Oct  3 14:05:09 UTC 2026`; another offset as `+0200`.
		UnixDate,
		// `Sat Oct 03 14:05:09 +0000 2026`.
		RubyDate,
		// `2:05PM`.
		Kitchen,
		// `Oct  3 14:05:09`: no year, so only a time of day reads it.
		Stamp,
		// `Oct  3 14:05:09.000`.
		StampMilli,
		// `Oct  3 14:05:09.000000`.
		StampMicro,
		// `Oct  3 14:05:09.000000000`.
		StampNano
	}

	// How a format is written and read. Layout codes: `%Y` year (four digits,
	// or a sign and six), `%y` two-digit year (00-49 are 2000s), `%q`
	// two-digit year (00-69 are 2000s), `%m` month, `%b` month abbreviation,
	// `%d` day, `%e` day padded with a space, `%a`/`%A` weekday abbreviated
	// and in full, `%W` week-numbering year, `%V` ISO week, `%u` ISO weekday,
	// `%j` day of the year, `%H` hour, `%I` 12-hour hour, `%p` AM/PM, `%M`
	// minute, `%S` second, `%f` fraction when not zero (`.`), `%F` the same
	// reading `,` too, `%3`/`%6`/`%9` fixed fraction, `%T` the ISO `T`
	// (`t` or a space read too), `%Z` `Z` or `±hh:mm`, `%z` `±hhmm`, `%X` `Z`
	// or `±hhmm`, `%N` `GMT` or `±hhmm`, `%U` `UTC` or `±hhmm`, `%G` `GMT`.
	// `[...]` is optional when reading. ISO forms split into date, separator,
	// time and zone; whole forms keep everything in `date`.
	internal struct Layout {
		date string
		sep  string
		time string
		zone string
		iso  bool
	}

	// In TimeFormat order.
	internal let layouts = Layout[
		Layout{date: "%Y-%m-%d", sep: "%T", time: "%H:%M:%S%f", zone: "%Z", iso: true},
		Layout{date: "%Y-%m-%d", sep: "%T", time: "%H:%M:%S%9", zone: "%Z", iso: true},
		Layout{date: "%Y%m%d", sep: "T", time: "%H%M[%S%F]", zone: "%X", iso: true},
		Layout{date: "%W-W%V-%u", sep: "T", time: "%H:%M[:%S%F]", zone: "%Z", iso: true},
		Layout{date: "%Y-%j", sep: "T", time: "%H:%M[:%S%F]", zone: "%Z", iso: true},
		Layout{date: "%Y-%m-%d %H:%M:%S", sep: "", time: "", zone: "", iso: false},
		Layout{date: "%Y-%m-%d", sep: "", time: "", zone: "", iso: true},
		Layout{date: "", sep: "", time: "%H:%M:%S", zone: "", iso: true},
		Layout{date: "%a, %d %b %Y %H:%M:%S %G", sep: "", time: "", zone: "", iso: false},
		Layout{date: "%a, %d %b %Y %H:%M:%S %z", sep: "", time: "", zone: "", iso: false},
		Layout{date: "%A, %d-%b-%q %H:%M:%S %N", sep: "", time: "", zone: "", iso: false},
		Layout{date: "%d %b %y %H:%M %N", sep: "", time: "", zone: "", iso: false},
		Layout{date: "%d %b %y %H:%M %z", sep: "", time: "", zone: "", iso: false},
		Layout{date: "%a %b %e %H:%M:%S %Y", sep: "", time: "", zone: "", iso: false},
		Layout{date: "%a %b %e %H:%M:%S %U %Y", sep: "", time: "", zone: "", iso: false},
		Layout{date: "%a %b %d %H:%M:%S %z %Y", sep: "", time: "", zone: "", iso: false},
		Layout{date: "%I:%M%p", sep: "", time: "", zone: "", iso: false},
		Layout{date: "%b %e %H:%M:%S", sep: "", time: "", zone: "", iso: false},
		Layout{date: "%b %e %H:%M:%S%3", sep: "", time: "", zone: "", iso: false},
		Layout{date: "%b %e %H:%M:%S%6", sep: "", time: "", zone: "", iso: false},
		Layout{date: "%b %e %H:%M:%S%9", sep: "", time: "", zone: "", iso: false}
	]

	// The three forms an HTTP date is read in (RFC 9110 §5.6.7).
	internal let httpLayouts = string["%a, %d %b %Y %H:%M:%S %G", "%A, %d-%b-%q %H:%M:%S %G", "%a %b %e %H:%M:%S %Y"]

	// What `parse` tries without a format, after the ISO forms, the HTTP
	// forms and the mail form.
	internal let instantLayouts = string["%a %b %e %H:%M:%S %U %Y", "%a %b %d %H:%M:%S %z %Y"]

	// What the civil parsers try without a format.
	internal let autoDateLayouts = string["%Y-%m-%d", "%Y%m%d", "%W-W%V-%u", "%Y-%j"]
	internal let autoTimeLayouts = string["%H:%M[:%S%F]", "%H%M[%S%F]", "%I:%M%p"]
	internal let autoDateTimeLayouts = string["%Y-%m-%d[%T%H:%M[:%S%F]]", "%Y%m%d[T%H%M[%S%F]]", "%W-W%V-%u[T%H:%M[:%S%F]]", "%Y-%j[T%H:%M[:%S%F]]", "%Y-%m-%d %H:%M:%S", "%a %b %e %H:%M:%S %Y"]

	// The ISO forms `parse` tries without a format: a date, optionally a
	// time, optionally a zone.
	internal let autoInstantLayouts = string["%Y-%m-%d[%T%H:%M[:%S%F][%Z]]", "%Y%m%d[T%H%M[%S%F][%X]]", "%W-W%V-%u[T%H:%M[:%S%F][%Z]]", "%Y-%j[T%H:%M[:%S%F][%Z]]"]

	// The fields a value has, and those a reading set.
	internal const (
		hasDate = 1
		hasTime = 2
		hasZone = 4

		setYear    = 1
		setMonth   = 2
		setDay     = 4
		setHour    = 8
		setMinute  = 16
		setSecond  = 32
		setZone    = 64
		setWeek    = 128
		setOrdinal = 256
		setHour12  = 512
		setFrac    = 1024
	)

	// Whether a layout shows the year, which an instant cannot be read without.
	internal def carriesYear(layout string) bool {
		return layout.contains("%Y") || layout.contains("%y") || layout.contains("%q") || layout.contains("%W") || layout.contains("%j")
	}

	// The fields of a date and time as a layout writes or reads them.
	internal struct Reading {
		year     int  = 0
		month    int  = 1
		day      int  = 1
		hour     int  = 0
		minute   int  = 0
		second   int  = 0
		nanos    int  = 0
		offset   int  = 0 // seconds east of UTC
		weekYear int  = 0
		week     int  = 0
		weekday  int  = 0 // ISO, 1 Monday to 7 Sunday
		ordinal  int  = 0
		pm       bool = false
		set      int  = 0 // set* bits of the fields read
	}

	// The layout a value with the `has*` parts writes `format` in, "" when
	// the format shows a part the value lacks or none it has.
	internal def writeLayout(format TimeFormat, has int) string {
		let l = layouts[format.ordinal]
		return (layoutParts(l.date) | has) == has ?? (l.date, "") unless l.iso
		let out = ""
		out = l.date when l.date != "" && (has & hasDate) != 0
		if l.time != "" && (has & hasTime) != 0 {
			out = out == "" ?? (l.time, out + l.sep + l.time)
			out += l.zone when l.zone != "" && (has & hasZone) != 0
		}
		return out
	}

	// The layout a value with exactly the `has*` parts reads `format` in, ""
	// when the format does not carry them. A Time (all three parts) reads
	// any form with a full date, and takes a missing zone as UTC.
	internal def readLayout(format TimeFormat, has int) string {
		let l = layouts[format.ordinal]
		if !l.iso {
			let parts = layoutParts(l.date)
			return l.date when has == (hasDate | hasTime | hasZone) && carriesYear(l.date)
			return parts == has ?? (l.date, "")
		}
		if has == (hasDate | hasTime | hasZone) {
			return "" when l.date == ""
			return l.date when l.time == ""
			return l.date + l.sep + l.time + l.zone
		}
		let out = ""
		if (has & hasDate) != 0 {
			return "" when l.date == ""
			out = l.date
		}
		if (has & hasTime) != 0 {
			return "" when l.time == ""
			out = out == "" ?? (l.time, out + l.sep + l.time)
		}
		return out
	}

	// Which of date, time and zone a layout's codes show.
	internal def layoutParts(layout string) int {
		let parts = 0
		let i = 0
		for i + 1 < layout.len() {
			if layout[i] != '%' {
				i++
				continue
			}
			match layout[i + 1] {
				case 'Y', 'y', 'q', 'm', 'b', 'd', 'e', 'a', 'A', 'W', 'V', 'u', 'j':
					parts |= hasDate
				case 'H', 'I', 'p', 'M', 'S', 'f', 'F', '3', '6', '9':
					parts |= hasTime
				case 'Z', 'z', 'X', 'N', 'U', 'G':
					parts |= hasZone
			}
			i += 2
		}
		return parts
	}

	// The Reading of a date and time at an offset east of UTC.
	internal def readingOf(dt DateTime, offset duration) Reading {
		let r = Reading{}
		r.year = dt.date.year
		r.month = dt.date.month
		r.day = dt.date.day
		r.hour = dt.time.hour
		r.minute = dt.time.minute
		r.second = dt.time.second
		r.nanos = dt.time.nanosecond
		r.offset = int(int64(offset) / nsPerSecond)
		return r
	}

	// render writes r in the layout.
	internal def render(layout string, r Reading) string {
		let out byte[] = []
		let i = 0
		for i < layout.len() {
			let c = layout[i]
			i++
			continue when c := '[' || ']'
			if c != '%' {
				out.push(byte(int(c)))
				continue
			}
			let code = layout[i]
			i++
			match code {
				case 'Y':
					putText(out, isoYear(r.year))
				case 'y', 'q':
					putNum(out, int(floorMod(int64(r.year), 100)), 2)
				case 'm':
					putNum(out, r.month, 2)
				case 'b':
					putText(out, httpMonths[r.month - 1])
				case 'd':
					putNum(out, r.day, 2)
				case 'e':
					out.push(byte(32)) when r.day < 10
					putNum(out, r.day, 1)
				case 'a':
					putText(out, httpWeekdays[isoWeekday(r) % 7])
				case 'A':
					putText(out, Weekday(isoWeekday(r) % 7).str())
				case 'W':
					let (weekYear, _) = isoWeek(r)
					putText(out, isoYear(weekYear))
				case 'V':
					let (_, week) = isoWeek(r)
					putNum(out, week, 2)
				case 'u':
					putNum(out, isoWeekday(r), 1)
				case 'j':
					putNum(out, int(daysFromCivil(r.year, r.month, r.day) - daysFromCivil(r.year, 1, 1)) + 1, 3)
				case 'H':
					putNum(out, r.hour, 2)
				case 'I':
					putNum(out, r.hour % 12 == 0 ?? (12, r.hour % 12), 1)
				case 'p':
					putText(out, r.hour < 12 ?? ("AM", "PM"))
				case 'M':
					putNum(out, r.minute, 2)
				case 'S':
					putNum(out, r.second, 2)
				case 'f', 'F':
					if r.nanos != 0 {
						let digits = 9
						let value = r.nanos
						for value % 10 == 0 {
							value /= 10
							digits--
						}
						out.push(byte(46))
						putNum(out, value, digits)
					}
				case '3':
					out.push(byte(46))
					putNum(out, r.nanos / 1000000, 3)
				case '6':
					out.push(byte(46))
					putNum(out, r.nanos / 1000, 6)
				case '9':
					out.push(byte(46))
					putNum(out, r.nanos, 9)
				case 'T':
					out.push(byte(84))
				case 'Z':
					putOffset(out, r.offset, "Z", true)
				case 'X':
					putOffset(out, r.offset, "Z", false)
				case 'z':
					putOffset(out, r.offset, "", false)
				case 'N', 'G':
					putOffset(out, r.offset, "GMT", false)
				case 'U':
					putOffset(out, r.offset, "UTC", false)
			}
		}
		return string(out)
	}

	internal def putText(out byte[], text string) {
		for let b in text.bytes() {
			out.push(b)
		}
	}

	// putNum writes a non-negative value in at least `width` digits.
	internal def putNum(out byte[], value int, width int) {
		let digits = 1
		let scale = 1
		for value / scale >= 10 {
			scale *= 10
			digits++
		}
		for let i = digits; i < width; i++ {
			out.push(byte(48))
		}
		for scale > 0 {
			out.push(byte(48 + value / scale % 10))
			scale /= 10
		}
	}

	// putOffset writes seconds east of UTC as `±hh:mm` or `±hhmm`, or as
	// `utc` when it is zero and `utc` is not "".
	internal def putOffset(out byte[], seconds int, utc string, colon bool) {
		if seconds == 0 && utc != "" {
			putText(out, utc)
			return
		}
		let minutes = seconds / 60
		out.push(byte(minutes < 0 ?? (45, 43)))
		minutes = minutes < 0 ?? (-minutes, minutes)
		putNum(out, minutes / 60, 2)
		out.push(byte(58)) when colon
		putNum(out, minutes % 60, 2)
	}

	// The ISO weekday of r's date, 1 Monday to 7 Sunday.
	internal def isoWeekday(r Reading) int {
		return int(floorMod(daysFromCivil(r.year, r.month, r.day) + 3, 7)) + 1
	}

	// The ISO week-numbering year and week of r's date.
	internal def isoWeek(r Reading) (int, int) {
		return weekOfDay(daysFromCivil(r.year, r.month, r.day))
	}

	internal def weekOfDay(day int64) (int, int) {
		// The week belongs to the year its Thursday is in.
		let thursday = day + 3 - floorMod(day + 3, 7)
		let (year, _, _) = civilFromDays(thursday)
		return (year, int((thursday - daysFromCivil(year, 1, 1)) / 7) + 1)
	}

	// scan reads `s[si:]` against `layout[li:lend]` into r, returning where
	// the match ends in s, -1 when it does not match.
	internal def scan(layout string, li int, lend int, s string, si int, r Reading) int {
		let i = li
		let p = si
		for i < lend {
			let c = layout[i]
			if c == '[' {
				let close = groupEnd(layout, i)
				let saved = r.set
				let q = scan(layout, i + 1, close, s, p, r)
				if q < 0 {
					r.set = saved
				} else {
					p = q
				}
				i = close + 1
				continue
			}
			if c != '%' {
				return -1 unless p < s.len() && s[p] == c
				p++
				i++
				continue
			}
			p = scanCode(layout[i + 1], s, p, r)
			return -1 when p < 0
			i += 2
		}
		return p
	}

	// The index of the `]` closing the group opened at `open`.
	internal def groupEnd(layout string, open int) int {
		let depth = 0
		for let i = open; i < layout.len(); i++ {
			depth++ when layout[i] == '['
			if layout[i] == ']' {
				depth--
				return i when depth == 0
			}
		}
		return layout.len()
	}

	// scanCode reads one layout code at s[p], returning the index after it,
	// -1 when the text does not hold it.
	internal def scanCode(code char, s string, p int, r Reading) int {
		match code {
			case 'Y', 'W':
				let at = p
				let negative = false
				let value = 0
				if p < s.len() && (s[p] == '+' || s[p] == '-') {
					negative = s[p] == '-'
					value = digitsAt(s, p + 1, 6)
					return -1 when value < 0 || (negative && value == 0)
					at = p + 7
				} else {
					value = digitsAt(s, p, 4)
					return -1 when value < 0
					at = p + 4
				}
				value = negative ?? (-value, value)
				if code == 'Y' {
					r.year = value
					r.set |= setYear
				} else {
					r.weekYear = value
					r.set |= setWeek
				}
				return at
			case 'y', 'q':
				let value = digitsAt(s, p, 2)
				return -1 when value < 0
				let pivot = code == 'y' ?? (50, 70)
				r.year = value < pivot ?? (2000 + value, 1900 + value)
				r.set |= setYear
				return p + 2
			case 'm':
				r.month = digitsAt(s, p, 2)
				return -1 when r.month < 0
				r.set |= setMonth
				return p + 2
			case 'b':
				return -1 when p + 3 > s.len()
				let index = httpMonthIndex(s[p:p + 3])
				return -1 when index < 0
				r.month = index + 1
				r.set |= setMonth
				return p + 3
			case 'd':
				r.day = digitsAt(s, p, 2)
				return -1 when r.day < 0
				r.set |= setDay
				return p + 2
			case 'e':
				let at = p
				at++ when at < s.len() && s[at] == ' '
				let (value, end) = shortNumber(s, at)
				return -1 when end < 0
				r.day = value
				r.set |= setDay
				return end
			case 'a':
				return -1 when p + 3 > s.len()
				let name = s[p:p + 3].lower()
				for let day in httpWeekdays {
					return p + 3 when day.lower() == name
				}
				return -1
			case 'A':
				for let i = 0; i < 7; i++ {
					let day = Weekday(i).str()
					return p + day.len() when p + day.len() <= s.len() && s[p:p + day.len()].lower() == day.lower()
				}
				return -1
			case 'V':
				r.week = digitsAt(s, p, 2)
				return r.week < 0 ?? (-1, p + 2)
			case 'u':
				r.weekday = digitsAt(s, p, 1)
				return r.weekday < 0 ?? (-1, p + 1)
			case 'j':
				r.ordinal = digitsAt(s, p, 3)
				return -1 when r.ordinal < 0
				r.set |= setOrdinal
				return p + 3
			case 'H':
				r.hour = digitsAt(s, p, 2)
				return -1 when r.hour < 0
				r.set |= setHour
				return p + 2
			case 'I':
				let (value, end) = shortNumber(s, p)
				return -1 when end < 0
				r.hour = value
				r.set |= setHour12
				return end
			case 'p':
				return -1 when p + 2 > s.len()
				let mark = s[p:p + 2].upper()
				return -1 unless mark := "AM" || "PM"
				r.pm = mark == "PM"
				return p + 2
			case 'M':
				r.minute = digitsAt(s, p, 2)
				return -1 when r.minute < 0
				r.set |= setMinute
				return p + 2
			case 'S':
				r.second = digitsAt(s, p, 2)
				return -1 when r.second < 0
				r.set |= setSecond
				return p + 2
			case 'f', 'F':
				return p unless p < s.len() && (s[p] == '.' || (code == 'F' && s[p] == ','))
				let at = p + 1
				let nanos = 0
				let scale = 100000000
				for at < s.len() && s[at] >= '0' && s[at] <= '9' {
					nanos += (int(s[at]) - int('0')) * scale
					scale /= 10
					at++
				}
				return -1 when at == p + 1
				r.nanos = nanos
				r.set |= setFrac
				return at
			case '3', '6', '9':
				let width = int(code) - int('0')
				return -1 unless p < s.len() && s[p] == '.'
				let value = digitsAt(s, p + 1, width)
				return -1 when value < 0
				r.nanos = width == 3 ?? (value * 1000000, width == 6 ?? (value * 1000, value))
				r.set |= setFrac
				return p + 1 + width
			case 'T':
				return -1 unless p < s.len() && (s[p] == 'T' || s[p] == 't' || s[p] == ' ')
				return p + 1
			case 'Z', 'X':
				if p < s.len() && (s[p] == 'Z' || s[p] == 'z') {
					r.offset = 0
					r.set |= setZone
					return p + 1
				}
				return scanOffset(s, p, r, colon = code == 'Z', shortOk = code == 'X')
			case 'z':
				return scanOffset(s, p, r)
			case 'N', 'U':
				return scanOffset(s, p, r) when p < s.len() && (s[p] == '+' || s[p] == '-')
				let end = p
				for end < s.len() && ((s[end] >= 'A' && s[end] <= 'Z') || (s[end] >= 'a' && s[end] <= 'z')) {
					end++
				}
				return -1 when end == p
				let word = s[p:end].upper()
				let minutes = 0
				if word != "UTC" {
					let named = mailZoneMinutes(word)
					return -1 when named is none
					minutes = named
				}
				r.offset = minutes * 60
				r.set |= setZone
				return end
			case 'G':
				return -1 when p + 3 > s.len()
				let word = s[p:p + 3].upper()
				return -1 unless word := "GMT" || "UTC"
				r.offset = 0
				r.set |= setZone
				return p + 3
		}
		return -1
	}

	// scanOffset reads `±hh:mm` (colon), `±hhmm`, or with `shortOk` also
	// `±hh`, as seconds east of UTC.
	internal def scanOffset(s string, p int, r Reading, colon bool = false, shortOk bool = false) int {
		return -1 unless p < s.len() && (s[p] == '+' || s[p] == '-')
		let hours = digitsAt(s, p + 1, 2)
		return -1 when hours < 0 || hours > 23
		let at = p + 3
		let minutes = 0
		if colon {
			return -1 unless at < s.len() && s[at] == ':'
			minutes = digitsAt(s, at + 1, 2)
			at += 3
		} else if !shortOk || (at < s.len() && s[at] >= '0' && s[at] <= '9') {
			minutes = digitsAt(s, at, 2)
			at += 2
		}
		return -1 when minutes < 0 || minutes > 59
		let seconds = hours * 3600 + minutes * 60
		r.offset = s[p] == '-' ?? (-seconds, seconds)
		r.set |= setZone
		return at
	}

	// digitsAt reads exactly `n` decimal digits at s[p], -1 when they are not
	// there.
	internal def digitsAt(s string, p int, n int) int {
		return -1 when p + n > s.len()
		let value = 0
		for let i = p; i < p + n; i++ {
			let c = s[i]
			return -1 unless c >= '0' && c <= '9'
			value = value * 10 + (int(c) - int('0'))
		}
		return value
	}

	// shortNumber reads one or two digits at s[p]: the value and the index
	// after them, the index -1 when there is no digit.
	internal def shortNumber(s string, p int) (int, int) {
		let first = digitsAt(s, p, 1)
		return (0, -1) when first < 0
		let both = digitsAt(s, p + 1, 1)
		return (first, p + 1) when both < 0
		return (first * 10 + both, p + 2)
	}

	// readWith matches the whole text against the layout and checks the
	// fields it read; none when the text does not have the layout's shape.
	// Fails when it does but a field is out of range.
	internal def readWith(layout string, text string) !?Reading {
		let r = Reading{}
		return none when scan(layout, 0, layout.len(), text, 0, r) != text.len()
		try settle(r, text)
		return r
	}

	// settle turns the week, ordinal and 12-hour fields into the calendar
	// ones and checks every field's range.
	internal def settle(r Reading, text string) !none {
		// A field an optional group read before the group failed is dropped.
		r.hour = 0 unless (r.set & (setHour | setHour12)) != 0
		r.minute = 0 unless (r.set & setMinute) != 0
		r.second = 0 unless (r.set & setSecond) != 0
		r.nanos = 0 unless (r.set & setFrac) != 0
		r.offset = 0 unless (r.set & setZone) != 0
		if (r.set & setWeek) != 0 {
			fail "time: \"{text}\" has no week {r.week}" unless r.week >= 1 && r.week <= 53 && r.weekday >= 1 && r.weekday <= 7
			let jan4 = daysFromCivil(r.weekYear, 1, 4)
			let day = jan4 - floorMod(jan4 + 3, 7) + int64((r.week - 1) * 7 + r.weekday - 1)
			let (weekYear, _) = weekOfDay(day)
			fail "time: \"{text}\" has no week {r.week}" unless weekYear == r.weekYear
			let (y, m, d) = civilFromDays(day)
			r.year = y
			r.month = m
			r.day = d
			r.set |= setYear | setMonth | setDay
		}
		if (r.set & setOrdinal) != 0 {
			fail "time: \"{text}\" has no day {r.ordinal} in the year" unless r.ordinal >= 1 && r.ordinal <= (isLeapYear(r.year) ?? (366, 365))
			let (y, m, d) = civilFromDays(daysFromCivil(r.year, 1, 1) + int64(r.ordinal - 1))
			r.year = y
			r.month = m
			r.day = d
			r.set |= setMonth | setDay
		}
		if (r.set & setHour12) != 0 {
			fail "time: \"{text}\" has no hour {r.hour}" unless r.hour >= 1 && r.hour <= 12
			r.hour = r.hour % 12 + (r.pm ?? (12, 0))
			r.set |= setHour
		}
		fail "time: \"{text}\" has no month {r.month}" unless r.month >= 1 && r.month <= 12
		// Without a year (Stamp) a day reads against a leap year, so 02-29 stays possible.
		let last = (r.set & setYear) != 0 ?? (daysInMonth(r.year, r.month), daysInMonth(2000, r.month))
		fail "time: \"{text}\" has no day {r.day} in month {r.month}" unless r.day >= 1 && r.day <= last
		fail "time: \"{text}\" has an hour out of range" unless r.hour >= 0 && r.hour <= 23
		fail "time: \"{text}\" has a minute out of range" unless r.minute >= 0 && r.minute <= 59
		fail "time: \"{text}\" has a second out of range" unless r.second >= 0 && r.second <= 60
		return none
	}

	// readCivil reads text as a value with exactly the `has` parts: in the
	// format when given, else in the first of `auto` that fits.
	internal def readCivil(text string, format ?TimeFormat, has int, auto string[], kind string) !Reading {
		let s = text.trim()
		if format is none {
			for let layout in auto {
				let r = try readWith(layout, s)
				continue when r is none
				return r
			}
			fail "{kind} \"{text}\": not a recognised form"
		}
		let layout = readLayout(format, has)
		fail "{kind} \"{text}\": TimeFormat.{format} does not carry a {kind} alone" when layout == ""
		let r = try readWith(layout, s)
		fail "{kind} \"{text}\": not in the TimeFormat.{format} form" when r is none
		return r
	}

	// The instant a reading names: its zone, else UTC; its time, else midnight.
	internal def instantOf(r Reading) Time {
		let seconds = daysFromCivil(r.year, r.month, r.day) * 86400 + int64(r.hour * 3600 + r.minute * 60 + r.second - r.offset)
		return new Time(duration(seconds * nsPerSecond + int64(r.nanos)), 0s)
	}

	internal def dateOf(r Reading) Date {
		return new Date(r.year, r.month, r.day)
	}

	// A leap second 60 reads as 59.
	internal def timeOfDayOf(r Reading) TimeOfDay {
		return new TimeOfDay(r.hour, r.minute, r.second == 60 ?? (59, r.second), r.nanos)
	}
}
