partial module std.time {
	use std.testing

	check "TimeFormat" {
		// 1994-11-06T08:49:37Z, a Sunday.
		internal def sample() Time {
			return fromUnixNs(784111777 * 1000000000)
		}

		@test()
		def writesEveryFormat() !none {
			let t = sample()
			assert t.str(TimeFormat.RFC3339) == "1994-11-06T08:49:37Z"
			assert t.str(TimeFormat.RFC3339Nano) == "1994-11-06T08:49:37.000000000Z"
			assert t.str(TimeFormat.ISO8601Basic) == "19941106T084937Z"
			assert t.str(TimeFormat.ISOWeek) == "1994-W44-7T08:49:37Z"
			assert t.str(TimeFormat.ISOOrdinal) == "1994-310T08:49:37Z"
			assert t.str(TimeFormat.DateTime) == "1994-11-06 08:49:37"
			assert t.str(TimeFormat.DateOnly) == "1994-11-06"
			assert t.str(TimeFormat.TimeOnly) == "08:49:37"
			assert t.str(TimeFormat.HTTP) == "Sun, 06 Nov 1994 08:49:37 GMT"
			assert t.str(TimeFormat.RFC1123Z) == "Sun, 06 Nov 1994 08:49:37 +0000"
			assert t.str(TimeFormat.RFC850) == "Sunday, 06-Nov-94 08:49:37 GMT"
			assert t.str(TimeFormat.RFC822) == "06 Nov 94 08:49 GMT"
			assert t.str(TimeFormat.RFC822Z) == "06 Nov 94 08:49 +0000"
			assert t.str(TimeFormat.ANSIC) == "Sun Nov  6 08:49:37 1994"
			assert t.str(TimeFormat.UnixDate) == "Sun Nov  6 08:49:37 UTC 1994"
			assert t.str(TimeFormat.RubyDate) == "Sun Nov 06 08:49:37 +0000 1994"
			assert t.str(TimeFormat.Kitchen) == "8:49AM"
			assert t.str(TimeFormat.Stamp) == "Nov  6 08:49:37"
			assert t.str() == t.str(TimeFormat.RFC3339)
			return none
		}

		@test()
		def writesFractions() !none {
			let t = sample() + 250ms
			assert t.str(TimeFormat.RFC3339) == "1994-11-06T08:49:37.25Z"
			assert t.str(TimeFormat.RFC3339Nano) == "1994-11-06T08:49:37.250000000Z"
			assert t.str(TimeFormat.ISO8601Basic) == "19941106T084937.25Z"
			assert t.str(TimeFormat.StampMilli) == "Nov  6 08:49:37.250"
			assert t.str(TimeFormat.StampMicro) == "Nov  6 08:49:37.250000"
			assert t.str(TimeFormat.StampNano) == "Nov  6 08:49:37.250000000"
			return none
		}

		@test()
		def writesOffsets() !none {
			let t = sample()
			assert t.str(TimeFormat.RFC3339, offset = 2h) == "1994-11-06T10:49:37+02:00"
			assert t.str(TimeFormat.RFC3339, offset = -(5h + 30m)) == "1994-11-06T03:19:37-05:30"
			assert t.str(TimeFormat.ISO8601Basic, offset = 2h) == "19941106T104937+0200"
			assert t.str(TimeFormat.RFC850, offset = 1h) == "Sunday, 06-Nov-94 09:49:37 +0100"
			assert t.str(TimeFormat.UnixDate, offset = -8h) == "Sun Nov  6 00:49:37 -0800 1994"
			assert t.str(TimeFormat.Kitchen, offset = 6h) == "2:49PM"
			// HTTP dates are GMT whatever the offset.
			assert t.str(TimeFormat.HTTP, offset = 2h) == "Sun, 06 Nov 1994 08:49:37 GMT"
			return none
		}

		@test()
		def writesTwelveHourClock() !none {
			assert (try parse("2026-10-03T00:05:00Z")).str(TimeFormat.Kitchen) == "12:05AM"
			assert (try parse("2026-10-03T12:00:00Z")).str(TimeFormat.Kitchen) == "12:00PM"
			assert (try parse("2026-10-03T23:59:00Z")).str(TimeFormat.Kitchen) == "11:59PM"
			return none
		}

		@test()
		def roundTripsEachFormatWithAYear() !none {
			let t = sample() + 250ms
			let formats = [TimeFormat.RFC3339, TimeFormat.RFC3339Nano, TimeFormat.ISO8601Basic, TimeFormat.ISOWeek, TimeFormat.ISOOrdinal]
			for let f in formats {
				assert (try parse(t.str(f, offset = 3h), f)).equals(t)
				assert (try parse(t.str(f, offset = 3h))).equals(t)
			}
			let whole = sample()
			let seconds = [TimeFormat.DateTime, TimeFormat.HTTP, TimeFormat.RFC1123Z, TimeFormat.RFC850, TimeFormat.ANSIC, TimeFormat.UnixDate, TimeFormat.RubyDate]
			for let f in seconds {
				assert (try parse(whole.str(f), f)).equals(whole)
				assert (try parse(whole.str(f))).equals(whole)
			}
			let minute = whole - 37s
			for let f in [TimeFormat.RFC822, TimeFormat.RFC822Z] {
				assert (try parse(whole.str(f, offset = -4h), f)).equals(minute)
				assert (try parse(whole.str(f, offset = -4h))).equals(minute)
			}
			assert (try parse(whole.str(TimeFormat.DateOnly), TimeFormat.DateOnly)).equals(whole - 8h - 49m - 37s)
			return none
		}

		@test()
		def recognisesFormsWithoutAFormat() !none {
			let t = sample()
			assert (try parse("1994-11-06t08:49:37z")).equals(t)
			assert (try parse("1994-11-06 08:49:37")).equals(t)
			assert (try parse("1994-11-06T08:49")).equals(t - 37s)
			assert (try parse("1994-11-06T10:49:37.0+02:00")).equals(t)
			assert (try parse("19941106T104937+02")).equals(t)
			assert (try parse("1994-W44-7")).equals(t - 8h - 49m - 37s)
			assert (try parse("Sun, 6 Nov 1994 03:49:37 EST (comment)")).equals(t)
			assert (try parse("Sun Nov 06 10:49:37 +0200 1994")).equals(t)
			assert (try parse("  Sun Nov  6 08:49:37 UTC 1994  ")).equals(t)
			assert parse("hello") is error
			assert parse("1994-11-06T25:00:00Z") is error
			assert parse("2026-02-30") is error
			return none
		}

		@test()
		def explicitFormatIsStrict() !none {
			assert parse("1994-11-06", TimeFormat.RFC3339) is error
			assert parse("1994-11-06T08:49:37", TimeFormat.RFC3339) is error
			assert parse("1994-11-06T08:49:37.25Z", TimeFormat.RFC3339Nano) is error
			assert parse("Sun, 06 Nov 1994 08:49:37 GMT", TimeFormat.RFC3339) is error
			assert parse("1994-11-06T08:49:37Z", TimeFormat.HTTP) is error
			assert parse("Sun Nov  6 08:49:37 1994", TimeFormat.RubyDate) is error
			// No full date: the instant cannot be known.
			assert parse("8:49AM", TimeFormat.Kitchen) is error
			assert parse("Nov  6 08:49:37", TimeFormat.Stamp) is error
			assert parse("08:49:37", TimeFormat.TimeOnly) is error
			// HTTP reads all three RFC 9110 forms.
			assert (try parse("Sunday, 06-Nov-94 08:49:37 GMT", TimeFormat.HTTP)).equals(sample())
			assert (try parse("Sun Nov  6 08:49:37 1994", TimeFormat.HTTP)).equals(sample())
			return none
		}

		@test()
		def readsWeekAndOrdinalDates() !none {
			// 2020 has 53 ISO weeks; 2021 does not.
			assert (try parseDate("2020-W53-5")).equals(new Date(2021, 1, 1))
			assert parseDate("2021-W53-1") is error
			assert (try parseDate("2008-W01-1")).equals(new Date(2007, 12, 29).plusDays(2))
			assert parseDate("2026-W40-8") is error
			assert (try parseDate("2024-366")).equals(new Date(2024, 12, 31))
			assert parseDate("2026-366") is error
			assert (try new Date(2021, 1, 1).str(TimeFormat.ISOWeek)) == "2020-W53-5"
			assert (try new Date(2026, 1, 1).str(TimeFormat.ISOOrdinal)) == "2026-001"
			return none
		}

		@test()
		def civilValuesWriteTheirParts() !none {
			let d = new Date(2026, 10, 3)
			assert (try d.str(TimeFormat.ISOWeek)) == "2026-W40-6"
			assert (try d.str(TimeFormat.ISOOrdinal)) == "2026-276"
			assert (try d.str(TimeFormat.ISO8601Basic)) == "20261003"
			assert (try d.str(TimeFormat.RFC3339)) == "2026-10-03"
			assert (try d.str(TimeFormat.DateOnly)) == "2026-10-03"
			assert d.str(TimeFormat.ANSIC) is error
			assert d.str(TimeFormat.TimeOnly) is error
			assert d.str(TimeFormat.DateTime) is error

			let tod = new TimeOfDay(14, 5, 9)
			assert (try tod.str(TimeFormat.Kitchen)) == "2:05PM"
			assert (try tod.str(TimeFormat.ISO8601Basic)) == "140509"
			assert (try tod.str(TimeFormat.RFC3339Nano)) == "14:05:09.000000000"
			assert (try tod.str(TimeFormat.TimeOnly)) == "14:05:09"
			assert tod.str(TimeFormat.DateOnly) is error
			assert tod.str(TimeFormat.HTTP) is error

			let dt = new DateTime(2026, 10, 3, 14, 5, 9)
			assert (try dt.str(TimeFormat.ANSIC)) == "Sat Oct  3 14:05:09 2026"
			assert (try dt.str(TimeFormat.RFC3339)) == "2026-10-03T14:05:09"
			assert (try dt.str(TimeFormat.ISOWeek)) == "2026-W40-6T14:05:09"
			assert (try dt.str(TimeFormat.DateTime)) == "2026-10-03 14:05:09"
			assert (try dt.str(TimeFormat.Kitchen)) == "2:05PM"
			assert dt.str(TimeFormat.HTTP) is error
			assert dt.str(TimeFormat.RubyDate) is error
			return none
		}

		@test()
		def civilParsersTakeTheirParts() !none {
			let d = new Date(2026, 10, 3)
			assert (try parseDate("2026-W40-6")).equals(d)
			assert (try parseDate("2026-276", TimeFormat.ISOOrdinal)).equals(d)
			assert (try parseDate("20261003", TimeFormat.ISO8601Basic)).equals(d)
			assert parseDate("2026-10-03", TimeFormat.ISOOrdinal) is error
			assert parseDate("Sat Oct  3 14:05:09 2026", TimeFormat.ANSIC) is error

			assert (try parseTimeOfDay("2:05PM")).equals(new TimeOfDay(14, 5))
			assert (try parseTimeOfDay("12:30am")).equals(new TimeOfDay(0, 30))
			assert parseTimeOfDay("13:05PM") is error
			assert (try parseTimeOfDay("14:05:09", TimeFormat.TimeOnly)).equals(new TimeOfDay(14, 5, 9))
			assert parseTimeOfDay("14:05", TimeFormat.TimeOnly) is error
			assert (try parseTimeOfDay("1405", TimeFormat.ISO8601Basic)).equals(new TimeOfDay(14, 5))
			assert parseTimeOfDay("Oct  3 14:05:09", TimeFormat.Stamp) is error

			let dt = new DateTime(2026, 10, 3, 14, 5, 9)
			assert (try parseDateTime("Sat Oct  3 14:05:09 2026")).equals(dt)
			assert (try parseDateTime("2026-10-03 14:05:09", TimeFormat.DateTime)).equals(dt)
			assert (try parseDateTime("2026-W40-6T14:05:09")).equals(dt)
			assert (try parseDateTime("20261003T140509", TimeFormat.ISO8601Basic)).equals(dt)
			assert parseDateTime("2026-10-03T14:05:09", TimeFormat.DateTime) is error
			assert parseDateTime("Sat, 03 Oct 2026 14:05:09 GMT", TimeFormat.HTTP) is error
			return none
		}
	}
}
