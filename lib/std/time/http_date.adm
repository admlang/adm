partial module std.time {
	// formatHTTPDate renders a time in the RFC 9110 preferred form,
	// `Sun, 06 Nov 1994 08:49:37 GMT` (RFC 1123, always GMT), the only form
	// a sender may produce for `Date`, `Expires`, `Last-Modified` and cookie
	// `Expires`.
	//
	// Example:
	// ```example
	// println(time.formatHTTPDate(time.fromUnixNs(784111777 * 1000000000)))  // Sun, 06 Nov 1994 08:49:37 GMT
	// ```
	def formatHTTPDate(t Time) string {
		let day = httpWeekdays[int(t.weekday())]
		let month = httpMonths[t.month() - 1]
		return "{day}, {twoDigits(t.day())} {month} {t.year()} {twoDigits(t.hour())}:{twoDigits(t.minute())}:{twoDigits(t.second())} GMT"
	}

	// parseHTTPDate reads the three forms a receiver must accept (RFC 9110
	// §5.6.7): RFC 1123 `Sun, 06 Nov 1994 08:49:37 GMT`, RFC 850
	// `Sunday, 06-Nov-94 08:49:37 GMT`, and asctime `Sun Nov  6 08:49:37 1994`.
	// The result is UTC. Fails when the text matches none of them.
	def parseHTTPDate(text string) !Time {
		let parts = text.trim().split(" ").filter(p => p != "")
		let bad = "time: not an HTTP date: " + text
		let dayText = ""
		let monthText = ""
		let yearText = ""
		let clock = ""
		if parts.len() == 6 && parts[0].endsWith(",") {
			// RFC 1123: Sun, 06 Nov 1994 08:49:37 GMT
			dayText = parts[1]
			monthText = parts[2]
			yearText = parts[3]
			clock = parts[4]
			fail bad unless parts[5] := "GMT" || "UTC"
		} else if parts.len() == 4 && parts[0].endsWith(",") {
			// RFC 850: Sunday, 06-Nov-94 08:49:37 GMT
			let date = parts[1].split("-")
			fail bad unless date.len() == 3
			dayText = date[0]
			monthText = date[1]
			yearText = date[2]
			clock = parts[2]
			fail bad unless parts[3] := "GMT" || "UTC"
		} else if parts.len() == 5 {
			// asctime: Sun Nov  6 08:49:37 1994
			monthText = parts[1]
			dayText = parts[2]
			clock = parts[3]
			yearText = parts[4]
		} else {
			fail bad
		}
		let month = httpMonthIndex(monthText)
		fail bad when month < 0
		fail bad unless dayText.isNumeric() && yearText.isNumeric()
		let day = dayText.toInt<int>()
		let year = yearText.toInt<int>()
		// Two-digit years (RFC 850) read as RFC 6265 says: 70-99 are 19xx,
		// 0-69 are 20xx.
		year = year >= 70 ?? (1900 + year, 2000 + year) when yearText.len() <= 2
		let hms = clock.split(":")
		fail bad unless hms.len() == 3 && hms[0].isNumeric() && hms[1].isNumeric() && hms[2].isNumeric()
		let hour = hms[0].toInt<int>()
		let minute = hms[1].toInt<int>()
		let second = hms[2].toInt<int>()
		fail bad unless day >= 1 && day <= daysInMonth(year, month + 1)
		fail bad unless hour <= 23 && minute <= 59 && second <= 60
		let seconds = daysFromCivil(year, month + 1, day) * 86400 + int64(hour * 3600 + minute * 60 + second)
		return new Time(duration(seconds * nsPerSecond), 0s)
	}

	internal let httpWeekdays = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"]
	internal let httpMonths = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]

	// httpMonthIndex maps a three-letter month (any case) to 0..11, -1 when
	// unknown.
	internal def httpMonthIndex(text string) int {
		let want = text.lower()
		for let i = 0; i < httpMonths.len(); i++ {
			return i when httpMonths[i].lower() == want
		}
		return -1
	}

	internal def twoDigits(value int) string {
		return value < 10 ?? ("0" + "{value}", "{value}")
	}
}
