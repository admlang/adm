partial module std.time {
	use std.testing

	check "HTTP dates" {
		@test()
		def formatsRFC1123() !none {
			let t = fromUnixNs(784111777 * 1000000000)
			assert formatHTTPDate(t) == "Sun, 06 Nov 1994 08:49:37 GMT"
			assert formatHTTPDate(try parse("2026-10-21T07:28:00Z")) == "Wed, 21 Oct 2026 07:28:00 GMT"
			assert formatHTTPDate(fromUnixNs(0)) == "Thu, 01 Jan 1970 00:00:00 GMT"
			return none
		}

		@test()
		def parsesAllThreeForms() !none {
			let want = fromUnixNs(784111777 * 1000000000)
			assert (try parseHTTPDate("Sun, 06 Nov 1994 08:49:37 GMT")).equals(want)
			assert (try parseHTTPDate("Sunday, 06-Nov-94 08:49:37 GMT")).equals(want)
			assert (try parseHTTPDate("Sun Nov  6 08:49:37 1994")).equals(want)
			assert (try parseHTTPDate("  Sun, 06 Nov 1994 08:49:37 UTC ")).equals(want)
			assert (try parseHTTPDate("Wed, 21 Oct 2026 07:28:00 GMT")).equals(try parse("2026-10-21T07:28:00Z"))
			// RFC 850 two-digit years: 00-69 are 2000s.
			assert (try parseHTTPDate("Friday, 01-Jan-21 00:00:00 GMT")).year() == 2021
			assert parseHTTPDate("not a date") is error
			assert parseHTTPDate("Sun, 06 Nov 1994 08:49:37") is error
			assert parseHTTPDate("Sun, 31 Feb 1994 08:49:37 GMT") is error
			assert parseHTTPDate("Sun, 06 Nov 1994 25:00:00 GMT") is error
			assert parseHTTPDate("Sun, 06 Xyz 1994 08:49:37 GMT") is error
			return none
		}
	}
}
