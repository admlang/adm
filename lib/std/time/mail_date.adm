partial module std.time {
	// formatMailDate renders a time as an RFC 5322 `date-time`, the form of
	// a mail `Date:` header: `Tue, 01 Jul 2003 10:52:37 +0200`. `offset` is
	// the zone the reading is given in, east of UTC; the default writes UTC
	// as `+0000`.
	//
	// Example:
	// ```example
	// println(time.formatMailDate(time.fromUnixNs(784111777 * 1000000000)))  // Sun, 06 Nov 1994 08:49:37 +0000
	// ```
	def formatMailDate(t Time, offset duration = 0s) string {
		let local = fromUnixNs(t.unixNs() + int64(offset))
		let day = httpWeekdays[int(local.weekday())]
		let month = httpMonths[local.month() - 1]
		let minutes = int(int64(offset) / (60 * nsPerSecond))
		let sign = minutes < 0 ?? ("-", "+")
		minutes = minutes < 0 ?? (-minutes, minutes)
		let zone = sign + twoDigits(minutes / 60) + twoDigits(minutes % 60)
		return "{day}, {twoDigits(local.day())} {month} {local.year()} {twoDigits(local.hour())}:{twoDigits(local.minute())}:{twoDigits(local.second())} {zone}"
	}

	// parseMailDate reads an RFC 5322 `date-time` and returns the instant in
	// UTC. It takes the obsolete forms of RFC 5322 §4.3 as well: no day of
	// week, no seconds, two- and three-digit years, comments, and the zone
	// names `UT`, `GMT`, `EST`/`EDT`, `CST`/`CDT`, `MST`/`MDT`, `PST`/`PDT`
	// and the military letters (read as UTC, as the RFC advises). Fails when
	// the text is not such a date.
	//
	// Example:
	// ```example
	// let t = try time.parseMailDate("Tue, 1 Jul 2003 10:52:37 +0200")
	// println(time.formatHTTPDate(t))  // Tue, 01 Jul 2003 08:52:37 GMT
	// ```
	def parseMailDate(text string) !Time {
		let bad = "time: not a mail date: " + text
		let parts = stripMailComments(text).replace(",", " ").split(" ").filter(p => p != "")
		fail bad when parts.len() < 4
		// The day of week is optional and carries nothing the date does not.
		parts = parts.slice(1, none) unless parts[0].isNumeric()
		fail bad unless parts.len() == 4 || parts.len() == 5
		let dayText = parts[0]
		let month = httpMonthIndex(parts[1])
		let yearText = parts[2]
		fail bad when month < 0
		fail bad unless dayText.isNumeric() && yearText.isNumeric() && dayText.len() <= 2
		let day = dayText.toInt<int>()
		let year = yearText.toInt<int>()
		if yearText.len() == 2 {
			year = year < 50 ?? (2000 + year, 1900 + year)
		} else if yearText.len() == 3 {
			year += 1900
		}
		let hms = parts[3].split(":")
		fail bad unless hms.len() == 2 || hms.len() == 3
		for let piece in hms {
			fail bad unless piece.isNumeric() && piece.len() <= 2
		}
		let hour = hms[0].toInt<int>()
		let minute = hms[1].toInt<int>()
		let second = hms.len() == 3 ?? (hms[2].toInt<int>(), 0)
		fail bad unless day >= 1 && day <= daysInMonth(year, month + 1)
		fail bad unless hour <= 23 && minute <= 59 && second <= 60
		let zone = 0
		if parts.len() == 5 {
			let given = mailZoneMinutes(parts[4])
			fail bad when given is none
			zone = given
		}
		let seconds = daysFromCivil(year, month + 1, day) * 86400 + int64(hour * 3600 + minute * 60 + second) - int64(zone) * 60
		return new Time(duration(seconds * nsPerSecond), 0s)
	}

	// stripMailComments drops the parenthesised comments of a date, nested
	// ones included, leaving a space in their place.
	internal def stripMailComments(text string) string {
		return text unless text.contains("(")
		let out = ""
		let depth = 0
		for let c in text {
			if c == '(' {
				depth++
				out += " " when depth == 1
			} else if c == ')' && depth > 0 {
				depth--
			} else if depth == 0 {
				out += string(c)
			}
		}
		return out
	}

	// mailZoneMinutes reads a zone as minutes east of UTC, none when it is
	// not one.
	internal def mailZoneMinutes(zone string) ?int {
		if zone.len() == 5 && (zone[0] == '+' || zone[0] == '-') && zone[1:].isNumeric() {
			let minutes = zone[1:3].toInt<int>() * 60 + zone[3:5].toInt<int>()
			return zone[0] == '-' ?? (-minutes, minutes)
		}
		match zone.upper() {
			case "UT", "GMT", "Z":
				return 0
			case "EDT":
				return -4 * 60
			case "EST", "CDT":
				return -5 * 60
			case "CST", "MDT":
				return -6 * 60
			case "MST", "PDT":
				return -7 * 60
			case "PST":
				return -8 * 60
		}
		return 0 when zone.len() == 1 && zone.isAlpha()
		return none
	}
}
