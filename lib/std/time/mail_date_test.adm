partial module std.time {
	use std.testing

	check "mail dates" {
		@test()
		def formatsWithZone() !none {
			let t = fromUnixNs(784111777 * 1000000000)
			assert formatMailDate(t) == "Sun, 06 Nov 1994 08:49:37 +0000"
			assert formatMailDate(t, 2h) == "Sun, 06 Nov 1994 10:49:37 +0200"
			assert formatMailDate(t, -(5h + 30m)) == "Sun, 06 Nov 1994 03:19:37 -0530"
			return none
		}

		@test()
		def parsesCurrentAndObsoleteForms() !none {
			let want = fromUnixNs(784111777 * 1000000000)
			assert (try parseMailDate("Sun, 06 Nov 1994 08:49:37 +0000")).equals(want)
			assert (try parseMailDate("Sun, 6 Nov 1994 10:49:37 +0200")).equals(want)
			assert (try parseMailDate("6 Nov 1994 03:49:37 -0500")).equals(want)
			assert (try parseMailDate("Sun, 06 Nov 94 03:49:37 EST")).equals(want)
			assert (try parseMailDate("Sun, 06 Nov 1994 08:49:37 GMT (Greenwich)")).equals(want)
			assert (try parseMailDate("Sun,06 Nov 1994 08:49:37 Z")).equals(want)
			assert (try parseMailDate("Sun, 06 Nov 1994 08:49 +0000")).second() == 0
			assert (try parseMailDate("1 Jan 49 00:00:00 +0000")).year() == 2049
			assert (try parseMailDate("1 Jan 50 00:00:00 +0000")).year() == 1950
			assert parseMailDate("not a date") is error
			assert parseMailDate("Sun, 31 Feb 1994 08:49:37 +0000") is error
			assert parseMailDate("Sun, 06 Nov 1994 08:49:37 +02") is error
			assert parseMailDate("Sun, 06 Nov 1994 25:49:37 +0000") is error
			return none
		}
	}
}
