partial module std.time {
	// Time is an instant: a wall-clock reading in nanoseconds since the Unix
	// epoch, UTC, plus a monotonic reading when it came from now, which is what
	// elapsed time is measured on.
	//
	// Example:
	// ```example
	// let started = time.now()
	// doWork()
	// println("took {time.since(started)}")
	// println(started.str()) // 2026-09-06T00:15:09Z
	// ```
	type Time {
		internal wall duration
		internal mono duration

		def new() {
			self.wall = 0s
			self.mono = 0s
		}

		def new(wall duration, mono duration) {
			self.wall = wall
			self.mono = mono
		}

		// What of a time crosses to another process (`std.services.ipc`'s
		// `Portable`): its wall-clock reading in nanoseconds since the Unix
		// epoch. The monotonic reading means nothing elsewhere and stays.
		def toWire() int64 {
			return int64(wall)
		}

		// Fills the time from a wall-clock reading that crossed.
		def fromWire(wire int64) !none {
			wall = duration(wire)
			mono = 0s
		}

		// unixNs returns the wall-clock reading as nanoseconds since the Unix epoch.
		def unixNs() int64 {
			return int64(wall)
		}

		// monotonicNs returns the monotonic reading in nanoseconds, 0 when the time
		// did not come from now.
		def monotonicNs() int64 {
			return int64(mono)
		}

		// The elapsed time from `other` to this instant. Measured on the
		// monotonic clock when both times carry one (both came from `now()`
		// or arithmetic on it), so a wall-clock adjustment in between cannot
		// skew it; otherwise on the wall clock, which is all a parsed or
		// decoded time has.
		def since(other Time) duration {
			return mono - other.mono when mono != 0s && other.mono != 0s
			return wall - other.wall
		}

		// after reports whether this instant is later than other on the wall clock.
		def after(other Time) bool {
			return wall > other.wall
		}

		// before reports whether this instant is earlier than other on the wall clock.
		def before(other Time) bool {
			return wall < other.wall
		}

		// Returns -1 when this instant is earlier than other on the wall clock, 1
		// when it is later, and 0 when they are the same instant.
		def compare(other Time) int {
			return wall.compare(other.wall)
		}

		// between reports whether this instant lies strictly after start and before
		// end.
		def between(start Time, end Time) bool {
			return self.after(start) && self.before(end)
		}

		// Reports whether both denote the same instant, on the wall clock.
		// The monotonic reading is bookkeeping for `since`, not part of the
		// value: a time round-tripped through `str`/`parse` or JSON equals
		// the original.
		def equals(other Time) bool {
			return wall == other.wall
		}

		// Calendar fields, in UTC.
		def year() int {
			let (y, _, _) = civil()
			return y
		}

		// month returns the month of the year, 1 to 12, UTC.
		def month() int {
			let (_, m, _) = civil()
			return m
		}

		// day returns the day of the month, 1 to 31, UTC.
		def day() int {
			let (_, _, d) = civil()
			return d
		}

		// hour returns the hour of the day, 0 to 23, UTC.
		def hour() int {
			return int(secondOfDay() / 3600)
		}

		// minute returns the minute of the hour, 0 to 59.
		def minute() int {
			return int((secondOfDay() % 3600) / 60)
		}

		// second returns the second of the minute, 0 to 59.
		def second() int {
			return int(secondOfDay() % 60)
		}

		// Nanoseconds past the second, 0 to 999999999.
		def nanosecond() int {
			return int(floorMod(int64(wall), nsPerSecond))
		}

		// weekday returns the day of the week, UTC.
		def weekday() Weekday {
			// 1970-01-01 was a Thursday.
			let idx = int(floorMod(daysSinceEpoch() + 4, 7))
			return Weekday(idx)
		}

		// RFC 3339 in UTC: `2026-09-03T14:05:09Z`, with the fraction of a
		// second appended when it is not zero (`...09.25Z`).
		def str() string {
			let (y, m, d) = civil()
			let out = pad(y, 4) + "-" + pad(m, 2) + "-" + pad(d, 2) + "T" + pad(hour(), 2) + ":" + pad(minute(), 2) + ":" + pad(second(), 2)
			let frac = nanosecond()
			if frac != 0 {
				let digits = pad(frac, 9)
				for digits.endsWith("0") {
					digits = digits[:digits.len() - 1]
				}
				out += "." + digits
			}
			return out + "Z"
		}

		// Writes the instant in a format, at `offset` east of UTC (`2h` is
		// +02:00): the wall clock is shifted by it, and formats showing a
		// zone show it. `TimeFormat.HTTP` is always written in UTC.
		//
		// Example:
		// ```example
		// let t = time.fromUnixNs(784111777 * 1000000000)
		// println(t.str(time.TimeFormat.ANSIC))                // Sun Nov  6 08:49:37 1994
		// println(t.str(time.TimeFormat.RFC3339, offset = 2h)) // 1994-11-06T10:49:37+02:00
		// println(t.str(time.TimeFormat.ISOWeek))              // 1994-W44-7T08:49:37Z
		// ```
		def str(format TimeFormat, offset duration = 0s) string {
			let at = format == TimeFormat.HTTP ?? (0s, offset)
			return render(writeLayout(format, hasDate | hasTime | hasZone), readingOf(dateTime(at), at))
		}

		// Same as `str()`.
		def encode() string {
			return str()
		}

		// Sets the time from an RFC 3339 string; see `parse`.
		// Fails when the text is not an RFC 3339 timestamp.
		def decode(val string) !none {
			let parsed = try parse(val, TimeFormat.RFC3339)
			wall = parsed.wall
			mono = parsed.mono
			return none
		}

		// JSON: the RFC 3339 string, quoted.
		def json() byte[] {
			return ("\"" + str() + "\"").bytes()
		}

		// json sets the time from its JSON form, a quoted RFC 3339 string. Fails when
		// the data is not a quoted string or the timestamp does not parse.
		def json(data byte[]) !none {
			let text = string(data).trim()
			fail "time: expected a quoted RFC 3339 string" unless text.len() >= 2 && text.startsWith("\"") && text.endsWith("\"")
			return decode(text[1:text.len() - 1])
		}

		// - returns the wall-clock time from other to this instant.
		infix def - (other Time) duration {
			return wall - other.wall
		}

		// < reports whether this instant is earlier than other, as `before`.
		infix def < (other Time) bool {
			return wall < other.wall
		}

		// <= reports whether this instant is not later than other.
		infix def <= (other Time) bool {
			return wall <= other.wall
		}

		// > reports whether this instant is later than other, as `after`.
		infix def > (other Time) bool {
			return wall > other.wall
		}

		// >= reports whether this instant is not earlier than other.
		infix def >= (other Time) bool {
			return wall >= other.wall
		}

		// + returns the instant the duration later, on both clocks.
		infix def + (other duration) Time {
			return new Time(wall + other, mono + other)
		}

		// - returns the instant the duration earlier, on both clocks.
		infix def - (other duration) Time {
			return new Time(wall - other, mono - other)
		}

		// Year, month (1-12) and day (1-31) of the wall clock, UTC.
		internal def civil() (int, int, int) {
			return civilFromDays(daysSinceEpoch())
		}

		// DateTime returns the wall-clock date and time of this instant at the
		// given offset from UTC.
		def dateTime(offset duration = 0s) DateTime {
			let ns = int64(wall) + int64(offset)
			let days = floorDiv(ns, nsPerDay)
			return new DateTime(fromEpochDay(days), timeOfNano(ns - days * nsPerDay))
		}

		internal def daysSinceEpoch() int64 {
			return floorDiv(int64(wall), nsPerDay)
		}

		internal def secondOfDay() int64 {
			return floorMod(int64(wall), nsPerDay) / nsPerSecond
		}
	}

	internal const (
		nsPerSecond = int64(1000000000)
		nsPerDay    = int64(86400000000000)
	)

	internal def floorDiv(a int64, b int64) int64 {
		let q = a / b
		q -= 1 when a % b != 0 && ((a < 0) != (b < 0))
		return q
	}

	internal def floorMod(a int64, b int64) int64 {
		return a - floorDiv(a, b) * b
	}

	internal def pad(value int, width int) string {
		let text = value.str()
		let neg = value < 0
		text = text[1:] when neg
		for text.len() < width {
			text = "0" + text
		}
		return "-" + text when neg
		return text
	}

	// Proleptic Gregorian date of a day count since 1970-01-01 (Howard
	// Hinnant's civil_from_days).
	internal def civilFromDays(days int64) (int, int, int) {
		let z = days + 719468
		let era = floorDiv(z, 146097)
		let doe = z - era * 146097
		let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
		let y = yoe + era * 400
		let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
		let mp = (5 * doy + 2) / 153
		let d = doy - (153 * mp + 2) / 5 + 1
		let m = mp + 3
		m = mp - 9 when mp >= 10
		y += 1 when m <= 2
		return (int(y), int(m), int(d))
	}

	// Day count since 1970-01-01 of a proleptic Gregorian date.
	internal def daysFromCivil(year int, month int, day int) int64 {
		let y = int64(year)
		let m = int64(month)
		let d = int64(day)
		y -= 1 when m <= 2
		let era = floorDiv(y, 400)
		let yoe = y - era * 400
		let mp = m - 3
		mp = m + 9 when m <= 2
		let doy = (153 * mp + 2) / 5 + d - 1
		let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
		return era * 146097 + doe - 719468
	}

	// Reads a date and time as an instant in UTC; the monotonic clock is
	// zero. With a format the text must be in that form (see `TimeFormat`;
	// one without a zone reads as UTC, `DateOnly` as midnight). Without one,
	// every form that carries a year is tried: the ISO 8601 ones (extended,
	// basic, week and ordinal dates, with the time and the zone optional),
	// then the HTTP, mail (RFC 5322), `UnixDate` and `RubyDate` forms.
	// Fails when the text is in none of them, when a field is out of range,
	// or when the format carries no full date (`Kitchen`, `Stamp`,
	// `TimeOnly`).
	//
	// Example:
	// ```example
	// let a = try time.parse("2026-09-03T14:05:09.5+02:00")
	// let b = try time.parse("Thu, 03 Sep 2026 12:05:09 GMT")
	// let c = try time.parse("2026-W36-4", time.TimeFormat.ISOWeek)
	// ```
	def parse(text string, format ?TimeFormat = none) !Time {
		let s = text.trim()
		if format is none {
			for let layout in autoInstantLayouts {
				let r = try readWith(layout, s)
				return instantOf(r) unless r is none
			}
			for let layout in httpLayouts {
				let r = try readWith(layout, s)
				return instantOf(r) unless r is none
			}
			let mail = readMail(s)
			return mail unless mail is error
			for let layout in instantLayouts {
				let r = try readWith(layout, s)
				return instantOf(r) unless r is none
			}
			fail "time: \"{text}\" is not a date and time in a recognised form"
		}
		if format == TimeFormat.HTTP {
			for let layout in httpLayouts {
				let r = try readWith(layout, s)
				return instantOf(r) unless r is none
			}
			fail "time: \"{text}\" is not an HTTP date"
		}
		return readMail(s) when format == TimeFormat.RFC1123Z
		let layout = readLayout(format, hasDate | hasTime | hasZone)
		fail "time: TimeFormat.{format} carries no full date; read it with parseTimeOfDay" when layout == ""
		let r = try readWith(layout, s)
		fail "time: \"{text}\" is not in the TimeFormat.{format} form" when r is none
		return instantOf(r)
	}

	// Decimal digits of `s[from:to]` as an int; fails on any other character.
	internal def field(s string, from int, to int) !int {
		fail "time: \"{s}\" is truncated" when to > s.len()
		let value = 0
		for let i = from; i < to; i++ {
			let c = s[i]
			fail "time: \"{s}\" has a non-digit where a number is expected" unless c >= '0' && c <= '9'
			value = value * 10 + (int(c) - int('0'))
		}
		return value
	}

	// isLeapYear reports whether the year has 366 days in the Gregorian calendar.
	def isLeapYear(year int) bool {
		return year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)
	}

	// daysInMonth returns how many days the month (1 to 12) of the year has.
	def daysInMonth(year int, month int) int {
		return 29 when month == 2 && isLeapYear(year)
		return 28 when month == 2
		return 30 when month == 4 || month == 6 || month == 9 || month == 11
		return 31
	}

	// now returns the current instant, with both the wall and the monotonic
	// reading.
	def now() Time {
		return new Time(duration(__time_wall_ns()), duration(__time_mono_ns()))
	}

	// since returns the time elapsed from other to now.
	def since(other Time) duration {
		return now().since(other)
	}

	// wallNs returns the wall clock as nanoseconds since the Unix epoch.
	def wallNs() int64 {
		return __time_wall_ns()
	}

	// monoNs returns the monotonic clock in nanoseconds: it only moves forward
	// and ignores clock adjustments.
	def monoNs() int64 {
		return __time_mono_ns()
	}

	// fromUnixNs makes a Time from nanoseconds since the Unix epoch, with no
	// monotonic reading.
	def fromUnixNs(ns int64) Time {
		return new Time(duration(ns), 0s)
	}

	// sleep pauses the current task for the duration.
	def sleep(val duration) {
		__time_sleep(val)
	}

	internal def callSleep(val duration, ch channel<none>) {
		sleep(val)
		ch <- none
		ch.close()
	}

	// sleepChan returns a channel that receives once the duration has passed, for
	// use in a select.
	def sleepChan(val duration) channel<none> {
		let ch = new channel<none>(1)
		async callSleep(val, ch)
		return ch
	}
}
