partial module std.time {
	type Time {
		internal wall duration
		internal mono duration

		def new() {
			self.wall = 0s
			self.mono = 0s
		}

		def new(wall duration, mono duration) {
			self.wall = wall
			self.mono = mono
		}

		def unixNs() int64 {
			return int64(wall)
		}

		def monotonicNs() int64 {
			return int64(mono)
		}

		def since(other Time) duration {
			return mono - other.mono
		}

		def after(other Time) bool {
			return wall > other.wall
		}

		def before(other Time) bool {
			return wall < other.wall
		}

		def between(start Time, end Time) bool {
			return self.after(start) && self.before(end)
		}

		def equals(other Time) bool {
			return wall == other.wall && mono == other.mono
		}

		// Calendar fields, in UTC.
		def year() int {
			let (y, _, _) = civil()
			return y
		}

		def month() int {
			let (_, m, _) = civil()
			return m
		}

		def day() int {
			let (_, _, d) = civil()
			return d
		}

		def hour() int {
			return int(secondOfDay() / 3600)
		}

		def minute() int {
			return int((secondOfDay() % 3600) / 60)
		}

		def second() int {
			return int(secondOfDay() % 60)
		}

		// Nanoseconds past the second, 0 to 999999999.
		def nanosecond() int {
			return int(floorMod(int64(wall), nsPerSecond))
		}

		def weekday() Weekday {
			// 1970-01-01 was a Thursday.
			let idx = int(floorMod(daysSinceEpoch() + 4, 7))
			return Weekday(idx)
		}

		// RFC 3339 in UTC: `2026-09-03T14:05:09Z`, with the fraction of a
		// second appended when it is not zero (`...09.25Z`).
		def str() string {
			let (y, m, d) = civil()
			let out = pad(y, 4) + "-" + pad(m, 2) + "-" + pad(d, 2) + "T" + pad(hour(), 2) + ":" + pad(minute(), 2) + ":" + pad(second(), 2)
			let frac = nanosecond()
			if frac != 0 {
				let digits = pad(frac, 9)
				for digits.endsWith("0") {
					digits = digits[:digits.len() - 1]
				}
				out += "." + digits
			}
			return out + "Z"
		}

		// Same as `str()`.
		def encode() string {
			return str()
		}

		// Sets the time from an RFC 3339 string; see `parse`.
		def decode(val string) !none {
			let parsed = try parse(val)
			wall = parsed.wall
			mono = parsed.mono
			return none
		}

		// JSON: the RFC 3339 string, quoted.
		def json() byte[] {
			return ("\"" + str() + "\"").bytes()
		}

		def json(data byte[]) !none {
			let text = string(data).trim()
			fail "time: expected a quoted RFC 3339 string" unless text.len() >= 2 && text.startsWith("\"") && text.endsWith("\"")
			return decode(text[1:text.len() - 1])
		}

		infix def - (other Time) duration {
			return wall - other.wall
		}

		infix def + (other duration) Time {
			return new Time(wall + other, mono + other)
		}

		infix def - (other duration) Time {
			return new Time(wall - other, mono - other)
		}

		// Year, month (1-12) and day (1-31) of the wall clock, UTC.
		internal def civil() (int, int, int) {
			return civilFromDays(daysSinceEpoch())
		}

		internal def daysSinceEpoch() int64 {
			return floorDiv(int64(wall), nsPerDay)
		}

		internal def secondOfDay() int64 {
			return floorMod(int64(wall), nsPerDay) / nsPerSecond
		}
	}

	internal const (
		nsPerSecond = int64(1000000000)
		nsPerDay    = int64(86400000000000)
	)

	internal def floorDiv(a int64, b int64) int64 {
		let q = a / b
		q -= 1 when a % b != 0 && ((a < 0) != (b < 0))
		return q
	}

	internal def floorMod(a int64, b int64) int64 {
		return a - floorDiv(a, b) * b
	}

	internal def pad(value int, width int) string {
		let text = value.str()
		let neg = value < 0
		text = text[1:] when neg
		for text.len() < width {
			text = "0" + text
		}
		return "-" + text when neg
		return text
	}

	// Proleptic Gregorian date of a day count since 1970-01-01 (Howard
	// Hinnant's civil_from_days).
	internal def civilFromDays(days int64) (int, int, int) {
		let z = days + 719468
		let era = floorDiv(z, 146097)
		let doe = z - era * 146097
		let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
		let y = yoe + era * 400
		let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
		let mp = (5 * doy + 2) / 153
		let d = doy - (153 * mp + 2) / 5 + 1
		let m = mp + 3
		m = mp - 9 when mp >= 10
		y += 1 when m <= 2
		return (int(y), int(m), int(d))
	}

	// Day count since 1970-01-01 of a proleptic Gregorian date.
	internal def daysFromCivil(year int, month int, day int) int64 {
		let y = int64(year)
		let m = int64(month)
		let d = int64(day)
		y -= 1 when m <= 2
		let era = floorDiv(y, 400)
		let yoe = y - era * 400
		let mp = m - 3
		mp = m + 9 when m <= 2
		let doy = (153 * mp + 2) / 5 + d - 1
		let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
		return era * 146097 + doe - 719468
	}

	// Parses RFC 3339 (`2026-09-03T14:05:09Z`, `2026-09-03T14:05:09.5+02:00`,
	// a space instead of `T` is accepted) into a Time whose wall clock is the
	// instant in UTC; the monotonic clock is zero. Fails on anything else.
	def parse(val string) !Time {
		let s = val.trim()
		fail "time: \"{s}\" is not an RFC 3339 timestamp" when s.len() < 20
		fail "time: \"{s}\" is not an RFC 3339 timestamp" unless s[4] == '-' && s[7] == '-' && (s[10] == 'T' || s[10] == 't' || s[10] == ' ') && s[13] == ':' && s[16] == ':'
		let year = try field(s, 0, 4)
		let month = try field(s, 5, 7)
		let day = try field(s, 8, 10)
		let hour = try field(s, 11, 13)
		let minute = try field(s, 14, 16)
		let second = try field(s, 17, 19)
		fail "time: month {month} out of range" unless month >= 1 && month <= 12
		fail "time: day {day} out of range" unless day >= 1 && day <= daysInMonth(year, month)
		fail "time: hour {hour} out of range" unless hour >= 0 && hour <= 23
		fail "time: minute {minute} out of range" unless minute >= 0 && minute <= 59
		fail "time: second {second} out of range" unless second >= 0 && second <= 60
		let i = 19
		let nanos = int64(0)
		if i < s.len() && s[i] == '.' {
			i += 1
			let scale = int64(100000000)
			let digits = 0
			for i < s.len() && s[i] >= '0' && s[i] <= '9' {
				nanos += int64(int(s[i]) - int('0')) * scale when digits < 9
				scale /= 10
				digits += 1
				i += 1
			}
			fail "time: \"{s}\" has an empty fraction" when digits == 0
		}
		let offset = int64(0)
		fail "time: \"{s}\" lacks a zone (Z or ±HH:MM)" when i >= s.len()
		if s[i] == 'Z' || s[i] == 'z' {
			i += 1
		} else {
			fail "time: \"{s}\" has an invalid zone" unless (s[i] == '+' || s[i] == '-') && i + 6 <= s.len() && s[i + 3] == ':'
			let oh = try field(s, i + 1, i + 3)
			let om = try field(s, i + 4, i + 6)
			offset = int64(oh * 3600 + om * 60)
			offset = -offset when s[i] == '-'
			i += 6
		}
		fail "time: trailing characters in \"{s}\"" when i != s.len()
		let seconds = daysFromCivil(year, month, day) * 86400 + int64(hour * 3600 + minute * 60 + second) - offset
		return new Time(duration(seconds * nsPerSecond + nanos), 0s)
	}

	// Decimal digits of `s[from:to]` as an int; fails on any other character.
	internal def field(s string, from int, to int) !int {
		fail "time: \"{s}\" is truncated" when to > s.len()
		let value = 0
		for let i = from; i < to; i++ {
			let c = s[i]
			fail "time: \"{s}\" has a non-digit where a number is expected" unless c >= '0' && c <= '9'
			value = value * 10 + (int(c) - int('0'))
		}
		return value
	}

	def isLeapYear(year int) bool {
		return year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)
	}

	def daysInMonth(year int, month int) int {
		return 29 when month == 2 && isLeapYear(year)
		return 28 when month == 2
		return 30 when month == 4 || month == 6 || month == 9 || month == 11
		return 31
	}

	def now() Time {
		return new Time(duration(__time_wall_ns()), duration(__time_mono_ns()))
	}

	def since(other Time) duration {
		return now().since(other)
	}

	def wallNs() int64 {
		return __time_wall_ns()
	}

	def monoNs() int64 {
		return __time_mono_ns()
	}

	def fromUnixNs(ns int64) Time {
		return new Time(duration(ns), 0s)
	}

	def sleep(val duration) {
		__time_sleep(val)
	}

	internal def callSleep(val duration, ch channel<none>) {
		sleep(val)
		ch <- none
		ch.close()
	}

	def sleepChan(val duration) channel<none> {
		let ch = new channel<none>(1)
		async callSleep(val, ch)
		return ch
	}
}
