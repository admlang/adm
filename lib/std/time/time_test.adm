partial module std.time {
	use std.testing

	check "Time" {
		@test()
		def civilFields() !none {
			// 2026-09-03T14:05:09Z
			let t = fromUnixNs(int64(1788444309) * int64(1000000000))
			assert t.year() == 2026
			assert t.month() == 9
			assert t.day() == 3
			assert t.hour() == 14
			assert t.minute() == 5
			assert t.second() == 9
			assert t.weekday() == Weekday.Thursday
			assert t.str() == "2026-09-03T14:05:09Z"
		}

		@test()
		def epochAndBefore() !none {
			let epoch = fromUnixNs(0)
			assert epoch.str() == "1970-01-01T00:00:00Z"
			assert epoch.weekday() == Weekday.Thursday
			let before = fromUnixNs(-int64(1000000000))
			assert before.str() == "1969-12-31T23:59:59Z"
			assert before.weekday() == Weekday.Wednesday
			assert fromUnixNs(int64(951782400) * int64(1000000000)).str() == "2000-02-29T00:00:00Z"
		}

		@test()
		def fractions() !none {
			let t = fromUnixNs(int64(1788444309) * int64(1000000000) + int64(250000000))
			assert t.nanosecond() == 250000000
			assert t.str() == "2026-09-03T14:05:09.25Z"
		}

		@test()
		def parseRoundTrip() !none {
			let t = try parse("2026-09-03T14:05:09Z")
			assert t.unixNs() == int64(1788444309) * int64(1000000000)
			let offset = try parse("2026-09-03T16:05:09.5+02:00")
			assert offset.unixNs() == int64(1788444309) * int64(1000000000) + int64(500000000)
			let space = try parse("1970-01-01 00:00:00Z")
			assert space.unixNs() == 0
			assert parse("2026-13-01T00:00:00Z") is error
			assert parse("2026-02-30T00:00:00Z") is error
			assert parse("2026-09-03T14:05:09") is error
			assert parse("not a time") is error
			assert (try parse("2000-02-29T12:30:45Z")).str() == "2000-02-29T12:30:45Z"
		}

		@test()
		def jsonAndDecode() !none {
			let t = fromUnixNs(int64(1788444309) * int64(1000000000))
			assert string(t.json()) == "\"2026-09-03T14:05:09Z\""
			let back = new Time()
			try back.json(t.json())
			assert back.equals(t)
			try back.decode("1970-01-01T00:00:00Z")
			assert back.unixNs() == 0
			assert back.json("2026-09-03T14:05:09Z".bytes()) is error
		}

		@test()
		def arithmetic() !none {
			let t = fromUnixNs(int64(1000000000))
			let later = t + 90s
			assert later.unixNs() == int64(91) * int64(1000000000)
			assert (later - t) == 90s
			assert (later - 30s).unixNs() == int64(61) * int64(1000000000)
			assert later.after(t)
			assert t.before(later)
		}

		@test()
		def durations() !none {
			assert (try parseDuration("1h30m")) == 5400s
			assert (try parseDuration("500ms")) == 500ms
			assert (try parseDuration("2.5s")) == 2500ms
			assert (try parseDuration("-90s")) == -90s
			assert (try parseDuration("1d")) == 86400s
			assert (try parseDuration("1.5h")) == 5400s
			assert parseDuration("") is error
			assert parseDuration("10") is error
			assert parseDuration("3 apples") is error
			assert parseDuration("ms") is error
		}

		@test()
		def equalsIgnoresMonotonic() !none {
			let a = new Time(5s, 100s)
			let b = new Time(5s, 0s)
			assert a.equals(b)
			assert b.equals(a)
			assert !a.equals(new Time(6s, 100s))
			let t = fromUnixNs(int64(1788444309) * int64(1000000000))
			assert (try parse(t.str())).equals(t)
		}

		@test()
		def sinceFallsBackToWallClock() !none {
			let a = fromUnixNs(int64(1000000000))
			let b = fromUnixNs(int64(3000000000))
			assert b.since(a) == 2s
			let t = now()
			let later = t + 5s
			assert later.since(t) == 5s
			// A monotonic reading paired with a wall-only time compares on the wall clock.
			let wallOnly = fromUnixNs(t.unixNs() - int64(1000000000))
			assert t.since(wallOnly) == 1s
		}

		@test()
		def calendarHelpers() !none {
			assert isLeapYear(2000)
			assert !isLeapYear(1900)
			assert isLeapYear(2024)
			assert daysInMonth(2024, 2) == 29
			assert daysInMonth(2023, 2) == 28
			assert daysInMonth(2023, 4) == 30
			assert daysInMonth(2023, 12) == 31
		}
	}
}
