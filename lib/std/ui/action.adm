partial module std.ui {
	use (
		std.reflection
		std.reflection::(DiscoveryMetaContext, MethodMetaContext)
	)

	// Declares the method as an action: something a button, a menu item, the
	// command palette and a shortcut can run.
	//
	// label is its name in menus (a message key is translated), shortcut its
	// default keys ("Mod+S", "Mod+K Mod+S"), icon the name of its icon.
	// enabled names a method of the same controller that returns whether the
	// action can run now; none: always.
	meta def action(target DiscoveryMetaContext<MethodMetaContext>, label string, shortcut string = "", icon string = "", enabled ?def() bool = none) {
		// intrinsic
	}

	// An action of one component: a method its controller declares with `@action`,
	// named where an `Action` is expected (`Button(action = save)`, `MenuItem(action =
	// close)`), with what the annotation says of it. Running it runs the method on
	// that component.
	type Action {
		// The method's qualified name, `module.Component.method`: the same in every
		// build, what a keymap binds shortcuts to.
		id       string
		// Its name in menus and the command palette.
		label    string
		// Its default keys, as the annotation writes them ("Mod+S"); the user's
		// keymap may give others (`UI.keymap()`).
		shortcut string
		// The name of its icon; "" for none.
		icon     string

		internal perform def()
		internal allowed ?def() bool = none

		// Whether it can run now: what its `enabled` method answers; true without one.
		enabled bool {
			def get() bool {
				let allowed = self.allowed
				return true when allowed is none
				return allowed()
			}
		}

		// Runs the method when the action is enabled; returns whether it ran.
		def run() bool {
			return false unless enabled
			let perform = self.perform
			perform()
			return true
		}
	}

	// The action the compiler makes of an `@action` method named where an `Action` is
	// expected: `run` and `enabled` are the method and its `enabled` method on the
	// component the name was read from.
	def __ui_action(id string, label string, shortcut string, icon string, run def()) Action {
		let made = new Action()
		made.id = id
		made.label = label
		made.shortcut = shortcut
		made.icon = icon
		made.perform = run
		return made
	}

	// The same for an `@action` that names an `enabled` method.
	def __ui_action_checked(id string, label string, shortcut string, icon string, run def(), enabled def() bool) Action {
		let made = __ui_action(id, label, shortcut, icon, run)
		made.allowed = enabled
		return made
	}

	// An action as the program declares it, for a keymap editor: what `UI.actions()`
	// lists.
	struct ActionInfo {
		id       string
		label    string
		shortcut string
		icon     string
	}

	// The actions the controller of `owner` declares, bound to it: what its keys run
	// while the focus is in it, and what a command palette lists for the focus. In the
	// order the controller declares them; the compiler writes them
	// (`Component<T>.__actions()`).
	def actionsOf(owner component) Action[] {
		return owner.__actions()
	}

	type DeclaredTable {
		all ?ActionInfo[] = none
	}

	let declared = new DeclaredTable()

	// Every `@action` the program declares, in the order discovery finds them; read
	// once.
	internal def declaredActions() ActionInfo[] {
		let held = declared.all
		return held unless held is none
		let out ActionInfo[]
		for let (_, hit) in reflection.attrs(action) {
			out.push(ActionInfo{
				id:       hit.node.qualifiedName,
				label:    actionArgument(hit, "label", 0),
				shortcut: actionArgument(hit, "shortcut", 1),
				icon:     actionArgument(hit, "icon", 2),
			})
		}
		declared.all = out
		return out
	}

	// An argument of an `@action` by name or position; "" when it is not given.
	internal def actionArgument(hit reflection.AttrHit, name string, position int) string {
		let named = hit.attr.arguments.get(name)
		return string(named) unless named is none
		let placed = hit.attr.arguments.get("#{position}")
		return string(placed) unless placed is none
		return ""
	}
}
