partial module std.ui.charts {
	use (
		std.gfx.canvas
		std.gfx.color::Color
		std.math.geom::(Line, Point, Rect, StrokeStyle)
		std.ui::(Limit, RenderContext)
		std.ui.paint
		std.ui.styles::*
		std.units::Pixels
	)

	// The room an axis takes below or above the plot, and beside it.
	internal const axisRoomAcross = 28.0
	internal const axisRoomBeside = 56.0

	// The size of a chart's text, in pixels.
	internal const chartTextSize = 12.0

	// A text block for a chart, kept by its text in `held` so a frame that draws the same
	// labels makes none.
	internal def chartText(held map<string, paint.TextBlock>, text string, ink Color) paint.TextBlock {
		let found = held.get(text)
		if !(found is none) {
			let drawn = found.foreground
			let same = false
			same = drawn == ink when drawn is Color
			if !same {
				found.foreground = ink
				found.changed()
			}
			return found
		}
		let made = new paint.TextBlock(text, Font{family: "system-ui"}, chartTextSize * 1(px))
		made.foreground = ink
		held[text] = made
		return made
	}

	// A line along one side of a chart's plot with round values marked on it:
	// `Axis(side = AxisSide.Left, label = "ms", grid = true)`. About one mark to 80 pixels
	// across, one to 50 up; `format` says how a value reads (as many decimals as the
	// step needs, without).
	component Axis {
		type {
			@input(value = true)
			side AxisSide = AxisSide.Bottom

			// What the axis measures, at its end.
			@input
			label string = ""

			// Lines across the plot at the marks.
			@input
			grid bool = false

			@input
			format ?(def(float) string) = none

			// The texts as made last.
			texts map<string, paint.TextBlock> = map<string, paint.TextBlock>{}

			def across() bool {
				return side == AxisSide.Bottom || side == AxisSide.Top
			}

			def textOf(value float, step float) string {
				let run = format
				return run(value) unless run is none
				return tickText(value, step)
			}

			def drawOn(target canvas.Painter, chart Chart, at ChartTransform, ink Color, scale float) {
				let plot = at.plot
				let muted = chart.look.palette.foregroundMuted
				let gridInk = chart.look.palette.border
				let line = StrokeStyle{width: 1(px)}
				let (lo, hi) = across() ?? ((at.range.left, at.range.right), (at.range.bottom, at.range.top))
				let length = across() ?? (plot.right - plot.left, plot.bottom - plot.top)
				let ticks = niceTicks(lo, hi, int(length / (across() ?? (80.0, 50.0))).max(2))
				let step = ticks.len() > 1 ?? (ticks[1] - ticks[0], 1.0)
				let edge = 0.0
				match side {
					case AxisSide.Bottom:
						edge = plot.bottom
						target.stroke(new Line(new Point(plot.left, edge), new Point(plot.right, edge)), muted, line)
					case AxisSide.Top:
						edge = plot.top
						target.stroke(new Line(new Point(plot.left, edge), new Point(plot.right, edge)), muted, line)
					case AxisSide.Left:
						edge = plot.left
						target.stroke(new Line(new Point(edge, plot.top), new Point(edge, plot.bottom)), muted, line)
					case AxisSide.Right:
						edge = plot.right
						target.stroke(new Line(new Point(edge, plot.top), new Point(edge, plot.bottom)), muted, line)
				}
				for let value in ticks {
					let block = chartText(texts, textOf(value, step), muted)
					if across() {
						let x = at.x(value)
						continue when x < plot.left - 0.5 || x > plot.right + 0.5
						target.stroke(new Line(new Point(x, plot.top), new Point(x, plot.bottom)), gridInk, line) when grid
						let out = side == AxisSide.Bottom ?? (4.0, -4.0)
						target.stroke(new Line(new Point(x, edge), new Point(x, edge + out)), muted, line)
						let top = side == AxisSide.Bottom ?? (edge + 6.0, edge - 6.0 - chartTextSize * 1.4)
						paint.drawBlock(target, block, Rect{left: x - 40.0, top: top, right: x + 40.0, bottom: top + chartTextSize * 1.4}, Align{horizontal: Alignment.Center, vertical: Alignment.Start}, false, scale)
					} else {
						let y = at.y(value)
						continue when y < plot.top - 0.5 || y > plot.bottom + 0.5
						target.stroke(new Line(new Point(plot.left, y), new Point(plot.right, y)), gridInk, line) when grid
						let out = side == AxisSide.Left ?? (-4.0, 4.0)
						target.stroke(new Line(new Point(edge, y), new Point(edge + out, y)), muted, line)
						let area = side == AxisSide.Left ?? (Rect{left: edge - axisRoomBeside, top: y - chartTextSize, right: edge - 6.0, bottom: y + chartTextSize}, Rect{left: edge + 6.0, top: y - chartTextSize, right: edge + axisRoomBeside, bottom: y + chartTextSize})
						paint.drawBlock(target, block, area, Align{horizontal: side == AxisSide.Left ?? (Alignment.End, Alignment.Start), vertical: Alignment.Center}, false, scale)
					}
				}
				if label != "" {
					let block = chartText(texts, label, muted)
					if across() {
						let top = side == AxisSide.Bottom ?? (plot.bottom + 6.0, plot.top - 6.0 - chartTextSize * 1.4)
						paint.drawBlock(target, block, Rect{left: plot.right - 120.0, top: top, right: plot.right, bottom: top + chartTextSize * 1.4}, Align{horizontal: Alignment.End, vertical: Alignment.Start}, false, scale)
					} else {
						let left = side == AxisSide.Left ?? (plot.left + 6.0, plot.right - 126.0)
						paint.drawBlock(target, block, Rect{left: left, top: plot.top, right: left + 120.0, bottom: plot.top + chartTextSize * 1.4}, Align{horizontal: side == AxisSide.Left ?? (Alignment.Start, Alignment.End), vertical: Alignment.Start}, false, scale)
					}
				}
			}

			def render(ctx RenderContext) {
				drawInChart(self, ctx)
			}
		}

		view {}

		style ChartPartStyle
	}

	// The series of a chart with their colours, in the plot's top end corner:
	// `Legend()`. Series without a label are left out.
	component Legend {
		type {
			texts map<string, paint.TextBlock> = map<string, paint.TextBlock>{}

			def drawOn(target canvas.Painter, chart Chart, at ChartTransform, ink Color, scale float) {
				let all = chart.series()
				let lineHigh = chartTextSize * 1.5
				let rows int[]
				let widest = 0.0
				for let (i, one) in all {
					continue when one.seriesLabel() == ""
					rows.push(i)
					let size = chartText(texts, one.seriesLabel(), ink).measure(Limit{})
					widest = widest.max(float(size.width))
				}
				return when rows.len() == 0
				let wide = widest + 26.0
				let box = Rect{left: at.plot.right - wide - 8.0, top: at.plot.top + 8.0, right: at.plot.right - 8.0, bottom: at.plot.top + 16.0 + lineHigh * float(rows.len())}
				target.fill(box, 4.0, chart.look.palette.surfaceRaised.withOpacity(0.9))
				for let (row, i) in rows {
					let top = box.top + 4.0 + lineHigh * float(row)
					target.fill(Rect{left: box.left + 6.0, top: top + lineHigh / 2.0 - 5.0, right: box.left + 16.0, bottom: top + lineHigh / 2.0 + 5.0}, 2.0, chart.colorOf(i))
					paint.drawBlock(target, chartText(texts, all[i].seriesLabel(), ink), Rect{left: box.left + 20.0, top: top, right: box.right - 4.0, bottom: top + lineHigh}, Align{horizontal: Alignment.Start, vertical: Alignment.Center}, false, scale)
				}
			}

			def render(ctx RenderContext) {
				drawInChart(self, ctx)
			}
		}

		view {}

		style ChartPartStyle
	}
}
