partial module std.ui.charts {
	use (
		std.gfx.canvas
		std.gfx.color::Color
		std.math.geom::(Point, Rect)
		std.ui::(Key, KeyEvent, MouseButton, PointerEvent, PointerPhase, RenderContext, Theme, UI)
		std.ui.styles::*
		std.units::Pixels
	)

	// How far a press may move before it is a drag rather than a click, in pixels, and
	// how near a point must be for a click to pick it.
	internal const chartSlop = 4.0
	internal const pickRadius = 8.0

	// The style a part of a chart has: no box of its own in the layout, the whole chart
	// to draw in, and no part in hit testing (the chart takes the pointer).
	style ChartPartStyle {
		Box
		Interaction
		position = Position.Relative
		anchors = Anchors{left: new AnchorLine(0(px)), top: new AnchorLine(0(px)), right: new AnchorLine(0(px)), bottom: new AnchorLine(0(px))}
		hitTest = HitTest.None
	}

	// A plot of series with axes and a legend: `Chart(viewport = shown) { LineSeries(times,
	// values, label = "load"); Axis(side = AxisSide.Bottom); Axis(side = AxisSide.Left) }`.
	// The parts draw in block order. An axis of `viewport` whose range is empty fits the
	// data. With `zoomable` the wheel zooms round the pointer and a drag pans, which
	// writes `viewport`; with the focus `+` and `-` zoom, the arrows pan and Home fits the
	// data again. A click near a point of a series selects it.
	component Chart {
		type {
			// The part of the data shown; an axis with an empty range fits the data.
			@input(value = true, bind = true)
			@state
			viewport ChartViewport = ChartViewport{}

			// Whether the wheel, a drag and the keys move `viewport`.
			@input
			zoomable bool = true

			// Runs with the point a click picked.
			@input
			onPointSelected ?(def(ChartPoint)) = none

			// Tells every listener the point a click picked, after the handler ran:
			// heard with `@on(Chart.pointSelected)`.
			@emit()
			def pointSelected(point ChartPoint) ChartPoint {
				return point
			}

			look Theme = UI.theme()

			// A press that may become a drag: where it went down and the range shown then.
			pressing bool
			moved    bool
			pressAt  Point<Pixels> = new Point<Pixels>(0(px), 0(px))
			pressed  ChartViewport = ChartViewport{}

			def new() {
				focusable = true
				tabStop   = true
			}

			// Its parts, in block order.
			def parts() ChartPart[] {
				let found ChartPart[]
				for let child in childNodes {
					found.push(child) when child is ChartPart
				}
				return found
			}

			// Its series, in block order.
			def series() ChartSeries[] {
				let found ChartSeries[]
				for let child in childNodes {
					found.push(child) when child is ChartSeries
				}
				return found
			}

			// The colour the series at `index` is drawn in: its own, else the next of the
			// theme's accent, info, success, warning and danger, round again.
			def colorOf(index int) Color {
				let all = series()
				if index < all.len() {
					let own = all[index].seriesColor()
					return own unless own is none
				}
				let palette = look.palette
				let colors = [palette.accent, palette.info, palette.success, palette.warning, palette.danger]
				return colors[index % colors.len()]
			}

			// The range the data covers, with a twentieth of room on each side; 0 to 1 on
			// an axis without data.
			def dataRange() ChartViewport {
				let (left, right, bottom, top) = (0.0, -1.0, 0.0, -1.0)
				for let one in series() {
					let seen = one.extent()
					if seen.left <= seen.right {
						(left, right) = right < left ?? ((seen.left, seen.right), (left.min(seen.left), right.max(seen.right)))
					}
					if seen.bottom <= seen.top {
						(bottom, top) = top < bottom ?? ((seen.bottom, seen.top), (bottom.min(seen.bottom), top.max(seen.top)))
					}
				}
				(left, right) = (0.0, 1.0) when right < left
				(bottom, top) = (0.0, 1.0) when top < bottom
				(left, right) = (left - 0.5, right + 0.5) when right == left
				(bottom, top) = (bottom - 0.5, top + 0.5) when top == bottom
				let (padX, padY) = ((right - left) / 20.0, (top - bottom) / 20.0)
				return ChartViewport{left: left - padX, right: right + padX, bottom: bottom - padY, top: top + padY}
			}

			// The range shown: `viewport`, an empty axis fitted to the data.
			def shown() ChartViewport {
				let given = viewport
				let fits = given.left == given.right || given.bottom == given.top
				return given unless fits
				let fitted = dataRange()
				let out = given
				if given.left == given.right {
					(out.left, out.right) = (fitted.left, fitted.right)
				}
				if given.bottom == given.top {
					(out.bottom, out.top) = (fitted.bottom, fitted.top)
				}
				return out
			}

			// The plot in a chart `width` by `height`: less the room its axes take on
			// their sides.
			def plotIn(width float, height float) Rect {
				let room = Rect{left: 8.0, top: 8.0, right: width - 8.0, bottom: height - 8.0}
				for let child in childNodes {
					if child is Axis {
						match child.side {
							case AxisSide.Bottom:
								room.bottom = height - axisRoomAcross
							case AxisSide.Top:
								room.top = axisRoomAcross
							case AxisSide.Left:
								room.left = axisRoomBeside
							case AxisSide.Right:
								room.right = width - axisRoomBeside
						}
					}
				}
				room.right = room.right.max(room.left + 1.0)
				room.bottom = room.bottom.max(room.top + 1.0)
				return room
			}

			// From data to its pixels as it is laid out now; the one transform its parts
			// draw with and a click is tested against.
			def transform() ChartTransform {
				let frame = style.geom.frame
				return transformFor(float(frame.width), float(frame.height))
			}

			def transformFor(width float, height float) ChartTransform {
				return new ChartTransform(plotIn(width, height), shown())
			}

			// Draws it on `target`, `width` by `height` pixels: its background and its parts
			// as on the screen, for printing or an image.
			def drawTo(target canvas.Painter, width float, height float, scale float = 1.0) {
				let at = transformFor(width, height)
				target.fill(Rect{left: 0.0, top: 0.0, right: width, bottom: height}, look.palette.surface)
				for let child in childNodes {
					drawPart(target, child, at, scale)
				}
			}

			// Draws one part through `at`: a series inside the plot, in its colour.
			def drawPart(target canvas.Painter, part component, at ChartTransform, scale float) {
				let wanted component = part
				return unless part is ChartPart
				let index = -1
				let seen = 0
				for let child in childNodes {
					let candidate component = child
					if child is ChartSeries {
						if candidate == wanted {
							index = seen
							break
						}
						seen++
					}
				}
				if part is ChartPart {
					if index < 0 {
						part.drawOn(target, self, at, look.palette.foreground, scale)
						return
					}
					target.save()
					target.clip(at.plot)
					part.drawOn(target, self, at, colorOf(index), scale)
					target.restore()
				}
			}

			// Moves the range shown and writes it to `viewport`.
			def show(range ChartViewport) {
				return when range.right <= range.left || range.top <= range.bottom
				viewport = range
			}

			// Zooms by `factor` (above 1: closer) round the pixel (`x`, `y`).
			def zoom(factor float, x float, y float) {
				let at = transform()
				let (cx, cy) = (at.dataX(x), at.dataY(y))
				let r = at.range
				show(ChartViewport{left: cx - (cx - r.left) / factor, right: cx + (r.right - cx) / factor, bottom: cy - (cy - r.bottom) / factor, top: cy + (r.top - cy) / factor})
			}

			// Moves the range by a part of its width and height.
			def pan(across float, up float) {
				let r = transform().range
				let (dx, dy) = ((r.right - r.left) * across, (r.top - r.bottom) * up)
				show(ChartViewport{left: r.left + dx, right: r.right + dx, bottom: r.bottom + dy, top: r.top + dy})
			}

			// The point of a series nearest the pixel, within `pickRadius`; none.
			def pointAt(x float, y float) ?ChartPoint {
				let at = transform()
				let best ?ChartPoint = none
				let bestDistance = pickRadius
				for let (i, one) in series() {
					let (index, distance) = one.nearest(at, x, y)
					if index >= 0 && distance <= bestDistance {
						best         = ChartPoint{series: i, index: index}
						bestDistance = distance
					}
				}
				return best
			}

			def pick(point ChartPoint) {
				let run = onPointSelected
				run(point) unless run is none
				pointSelected(point)
			}

			def pointer(e PointerEvent) bool {
				return false when disabled
				let (x, y) = (float(e.position.x), float(e.position.y))
				match e.phase {
					case PointerPhase.Scroll:
						return false when !zoomable
						let notches = float(e.scroll.y)
						return false when notches == 0.0
						zoom(1.1 ** (notches / 40.0).clamp(-10.0, 10.0), x, y)
						return true
					case PointerPhase.Down:
						return false when e.button != MouseButton.Left
						e.capture()
						pressing = true
						moved    = false
						pressAt  = e.position
						pressed  = transform().range
						return true
					case PointerPhase.Move:
						return false when !pressing
						let (dx, dy) = (x - float(pressAt.x), y - float(pressAt.y))
						moved = true when dx * dx + dy * dy > chartSlop * chartSlop
						if moved && zoomable {
							let at = transform()
							let (spanX, spanY) = (pressed.right - pressed.left, pressed.top - pressed.bottom)
							let shiftX = -dx / (at.plot.right - at.plot.left) * spanX
							let shiftY = dy / (at.plot.bottom - at.plot.top) * spanY
							show(ChartViewport{left: pressed.left + shiftX, right: pressed.right + shiftX, bottom: pressed.bottom + shiftY, top: pressed.top + shiftY})
						}
						return true
					case PointerPhase.Up:
						return false when !pressing
						pressing = false
						if !moved {
							let picked = pointAt(x, y)
							pick(picked) unless picked is none
						}
						return true
					case PointerPhase.Cancel:
						pressing = false
						return false
					default:
						return false
				}
			}

			def key(e KeyEvent) bool {
				return false when !e.down || disabled || !zoomable
				let at = transform()
				let (cx, cy) = ((at.plot.left + at.plot.right) / 2.0, (at.plot.top + at.plot.bottom) / 2.0)
				match e.key {
					case Key.Equal, Key.KeypadAdd:
						zoom(1.25, cx, cy)
					case Key.Minus, Key.KeypadSubtract:
						zoom(0.8, cx, cy)
					case Key.Left:
						pan(-0.1, 0.0)
					case Key.Right:
						pan(0.1, 0.0)
					case Key.Up:
						pan(0.0, 0.1)
					case Key.Down:
						pan(0.0, -0.1)
					case Key.Home:
						viewport = ChartViewport{}
					default:
						return false
				}
				return true
			}

			def render(ctx RenderContext) {
				ctx.outerShadows()
				ctx.background()
				ctx.borders()
				ctx.childNodes()
				ctx.innerShadows()
			}
		}

		view {
			children()
		}

		style {
			Box
			Control
			width      = fill
			height     = 240(px)
			background = new BackgroundFill(theme.palette.surface)
			on         = {
				focusVisible: {outline: Ring{width: theme.metrics.focusWidth, paint: theme.palette.focus, offset: 1(px)}},
			}
		}
	}
}
