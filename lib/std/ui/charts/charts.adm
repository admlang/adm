// Charts as components: `Chart(viewport = view) { LineSeries(xs, ys); Axis(side = AxisSide.Bottom);
// Axis(side = AxisSide.Left); Legend() }`. The chart holds the parts in its block and one
// `ChartTransform` from data to pixels, which drawing, hit testing and `drawTo` share.
partial module std.ui.charts {
	use (
		std.gfx.canvas
		std.gfx.color::Color
		std.math
		std.math.geom::Rect
		std.simd
	)

	// The part of the data a chart shows: x from `left` to `right`, y from `bottom` to
	// `top`. An empty range on an axis (`left == right`) fits that axis to the data.
	struct ChartViewport {
		left   float = 0.0
		right  float = 0.0
		bottom float = 0.0
		top    float = 0.0
	}

	// A point of a series: which series of the chart, counted from 0 in the order of
	// its block, and which item.
	struct ChartPoint {
		series int
		index  int
	}

	// The side of the plot an `Axis` stands on.
	enum AxisSide {
		Bottom,
		Left,
		Top,
		Right,
	}

	// From data to the pixels of a chart and back: the plot's rectangle and the range of
	// the data it shows.
	type ChartTransform {
		plot  Rect
		range ChartViewport

		def new(plot Rect, range ChartViewport) {
			self.plot = plot
			self.range = range
		}

		// The horizontal pixel of a data `x`.
		def x(value float) float {
			return plot.left + (value - range.left) / (range.right - range.left) * (plot.right - plot.left)
		}

		// The vertical pixel of a data `y`: up is more.
		def y(value float) float {
			return plot.bottom - (value - range.bottom) / (range.top - range.bottom) * (plot.bottom - plot.top)
		}

		// The data `x` of a horizontal pixel.
		def dataX(pixel float) float {
			return range.left + (pixel - plot.left) / (plot.right - plot.left) * (range.right - range.left)
		}

		// The data `y` of a vertical pixel.
		def dataY(pixel float) float {
			return range.bottom + (plot.bottom - pixel) / (plot.bottom - plot.top) * (range.top - range.bottom)
		}
	}

	// What a chart draws in its plot: a series, an axis, a legend. The chart draws its
	// parts in block order with one transform.
	interface ChartPart {
		// Draws it on `target` through `at`; `ink` is the colour the chart gives it.
		def drawOn(target canvas.Painter, chart Chart, at ChartTransform, ink Color, scale float)
	}

	// A part that holds data: it reports its range, its colour and label, and the item
	// nearest a pixel.
	interface ChartSeries {
		// The range of its data; `left > right` when it has none.
		def extent() ChartViewport

		// The colour it asks for; none: the chart's next one.
		def seriesColor() ?Color

		def seriesLabel() string

		// The index of the item nearest the pixel (`x`, `y`) and how far it is, in pixels;
		// -1 when it has none.
		def nearest(at ChartTransform, x float, y float) (int, float)
	}

	// Not a number: what a missing value of a series is.
	internal const notANumber = 0.0 / 0.0

	// Whether `v` is not a number, the one value not equal to itself.
	internal def missing(v float) bool {
		return v != v
	}

	// The lowest and the highest of `ys` from `from` up to `to`, NaN skipped; (NaN, NaN)
	// when every one is NaN or the range is empty.
	internal def extremes(ys float[], from int, to int) (float, float) {
		let lo = notANumber
		let hi = notANumber
		let i = from
		if to - from >= 16 {
			let low = simd.load8(ys, i)
			let high = low
			i += 8
			for; i + 8 <= to; i += 8 {
				let next = simd.load8(ys, i)
				low = low.min(next)
				high = high.max(next)
			}
			lo = low.minLane()
			hi = high.maxLane()
		}
		for; i < to; i++ {
			let v = ys[i]
			continue when missing(v)
			lo = v when missing(lo) || v < lo
			hi = v when missing(hi) || v > hi
		}
		return (lo, hi)
	}

	// The first index of the ascending `xs` whose value is at least `value`.
	internal def firstAtLeast(xs float[], value float) int {
		let (lo, hi) = (0, xs.len())
		for lo < hi {
			let mid = (lo + hi) / 2
			if xs[mid] < value {
				lo = mid + 1
			} else {
				hi = mid
			}
		}
		return lo
	}

	// Whether `xs` never goes down.
	internal def ascending(xs float[]) bool {
		for let i = 1; i < xs.len(); i++ {
			return false when xs[i] < xs[i - 1]
		}
		return true
	}

	// The points a line through the ascending `xs`, `ys` draws in `at`'s plot, thinned
	// when there are more than two to a pixel column: per column its first, lowest,
	// highest and last points, so every peak stays. The pixels come in pairs, x then y.
	internal def linePoints(xs float[], ys float[], at ChartTransform) float[] {
		let n = xs.len().min(ys.len())
		let out float[]
		return out when n == 0
		// One point before the view and one after, so the line runs to the plot's edges.
		let first = (firstAtLeast(xs, at.range.left) - 1).max(0)
		let last = (firstAtLeast(xs, at.range.right) + 1).min(n)
		let columns = int((at.plot.right - at.plot.left).ceil()).max(1)
		if last - first <= columns * 2 {
			for let i = first; i < last; i++ {
				continue when missing(ys[i])
				out.push(at.x(xs[i]), at.y(ys[i]))
			}
			return out
		}
		let i = first
		for let column = 0; column <= columns && i < last; column++ {
			let edge = at.dataX(at.plot.left + float(column + 1))
			let end = firstAtLeast(xs, edge).max(i + 1).min(last)
			let (lo, hi) = extremes(ys, i, end)
			if !missing(lo) {
				let x = at.x(xs[i])
				out.push(x, at.y(ys[i]))
				// Down then up or up then down, in the order they come.
				out.push(x, at.y(lo), x, at.y(hi))
				out.push(at.x(xs[end - 1]), at.y(ys[end - 1]))
			}
			i = end
		}
		return out
	}

	// Round steps for an axis from `lo` to `hi` with about `count` of them: 1, 2 or 5
	// times a power of ten. Empty for an empty range.
	def niceTicks(lo float, hi float, count int) float[] {
		let ticks float[]
		return ticks when !(hi > lo) || count < 1
		let rough = (hi - lo) / float(count)
		let power = 10.0 ** math.log10(rough).floor()
		let step = power
		for let factor in [1.0, 2.0, 5.0, 10.0] {
			step = factor * power
			break when step >= rough
		}
		// A value on a step must not be lost to rounding (-0.3 / 0.1 is -2.9999...).
		let at = (lo / step - 1e-9).ceil() * step
		for; at <= hi + step * 1e-9; at += step {
			// -0 reads as 0.
			ticks.push(at.abs() < step * 1e-9 ?? (0.0, at))
		}
		return ticks
	}

	// How a tick reads: as many decimals as its step needs.
	def tickText(value float, step float) string {
		let decimals = step >= 1.0 ?? (0, int((-math.log10(step)).ceil()).max(0).min(9))
		return "%.{decimals}f".format(value)
	}
}
