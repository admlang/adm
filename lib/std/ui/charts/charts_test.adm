partial module std.ui.charts {
	use (
		std.gfx.canvas
		std.math.geom::(Point, Rect, Size)
		std.testing
		std.ui::(Key, KeyEvent, MouseButton, PointerPhase)
		std.ui.runtime::Scene
		std.ui.styles::*
		std.units::Pixels
	)

	internal let chartPicks = string[]

	internal def notePick(point ChartPoint) {
		chartPicks.push("{point.series}:{point.index}")
	}

	// A chart of a line and bars over 0 to 10, with axes and a legend.
	component Plotted {
		type {
			@bindable
			shown ChartViewport = ChartViewport{}

			def new() {
				style.width = 400(px)
				style.height = 300(px)
			}
		}

		view {
			Chart(shown, onPointSelected = notePick, style = {width: 400(px), height: 300(px)}) {
				LineSeries([0.0, 5.0, 10.0], xs = [0.0, 5.0, 10.0], label = "line")
				BarSeries([2.0, 4.0], xs = [2.0, 8.0], label = "bars")
				Axis(side = AxisSide.Bottom)
				Axis(side = AxisSide.Left, grid = true)
				Legend()
			}
		}

		style {
			Box
		}
	}

	check "Charts" {
		// Round steps: 1, 2 or 5 times a power of ten.
		@test()
		def TestTicks() {
			let ticks = niceTicks(0.0, 10.0, 5)
			assert ticks.len() == 6 && ticks[0] == 0.0 && ticks[5] == 10.0
			let small = niceTicks(-0.3, 0.3, 6)
			assert small.len() == 7 && small[3] == 0.0
			assert tickText(0.25, 0.05) == "0.25" && tickText(40.0, 20.0) == "40"
			assert niceTicks(1.0, 1.0, 4).len() == 0
		}

		// The lowest and highest of a run, through the vector loop and the rest, NaN
		// skipped.
		@test()
		def TestExtremes() {
			let ys float[]
			for let i = 0; i < 101; i++ {
				ys.push(float((i * 37) % 101))
			}
			ys[50] = notANumber
			ys[77] = -5.0
			let (lo, hi) = extremes(ys, 3, 100)
			assert lo == -5.0 && hi == 100.0
			let (none1, none2) = extremes(ys, 50, 51)
			assert missing(none1) && missing(none2)
		}

		// A line of many more points than pixels is thinned to four a column and keeps
		// its highest and lowest points.
		@test()
		def TestThinning() {
			let (xs, ys) = (float[], float[])
			for let i = 0; i < 100000; i++ {
				xs.push(float(i))
				ys.push(i == 61234 ?? (1000.0, i == 7000 ?? (-1000.0, float(i % 10))))
			}
			let at = new ChartTransform(Rect{left: 0.0, top: 0.0, right: 200.0, bottom: 100.0}, ChartViewport{left: 0.0, right: 100000.0, bottom: -1000.0, top: 1000.0})
			assert at.dataX(at.x(123.0)) == 123.0 && (at.dataY(at.y(-250.0)) + 250.0).abs() < 1e-9
			let points = linePoints(xs, ys, at)
			assert points.len() <= 202 * 8
			let (top, bottom) = (1000.0, 0.0)
			for let i = 1; i < points.len(); i += 2 {
				top = top.min(points[i])
				bottom = bottom.max(points[i])
			}
			assert top == at.y(1000.0) && bottom == at.y(-1000.0)
		}

		// An empty viewport fits the data with a twentieth of room each side; a click
		// near a point selects it; the wheel zooms round the pointer and writes the
		// viewport; a drag pans; Home fits again.
		@test()
		def TestChart() {
			chartPicks = string[]
			let page = Plotted()
			let scene = new Scene(page)
			let size = new Size<Pixels>(400(px), 300(px))
			scene.arrange(size)
			scene.arrange(size)
			let chart = page.children[0]
			assert chart is Chart
			if chart is Chart {
				let at = chart.transform()
				// The bars reach half their step (6) beside their xs: x from -1 to 11.
				let near = def (a float, b float) bool {
					return (a - b).abs() < 1e-9
				}
				assert near(at.range.left, -1.6) && near(at.range.right, 11.6) && near(at.range.bottom, -0.5) && near(at.range.top, 10.5)
				assert chart.series().len() == 2 && chart.parts().len() == 5
				// The line's middle point.
				let point = new Point<Pixels>(at.x(5.0) * 1(px), at.y(5.0) * 1(px))
				scene.pointer(PointerPhase.Down, point)
				scene.pointer(PointerPhase.Up, point)
				assert chartPicks.join(",") == "0:1"
				// The first bar.
				let bar = new Point<Pixels>(at.x(2.0) * 1(px), at.y(1.0) * 1(px))
				scene.pointer(PointerPhase.Down, bar)
				scene.pointer(PointerPhase.Up, bar)
				assert chartPicks.join(",") == "0:1,1:0"
				// Zoom in round the line's middle point: it stays where it was.
				scene.pointer(PointerPhase.Scroll, point, MouseButton.Left, new Point<Pixels>(0(px), 40(px)))
				scene.arrange(size)
				let zoomed = chart.transform()
				assert page.shown.right - page.shown.left < at.range.right - at.range.left - 0.5
				assert (zoomed.x(5.0) - at.x(5.0)).abs() < 0.01 && (zoomed.y(5.0) - at.y(5.0)).abs() < 0.01
				// A drag to the right shows what is further left.
				let before = page.shown.left
				scene.pointer(PointerPhase.Down, point)
				scene.pointer(PointerPhase.Move, new Point<Pixels>(point.x + 50(px), point.y))
				scene.pointer(PointerPhase.Up, new Point<Pixels>(point.x + 50(px), point.y))
				scene.arrange(size)
				assert page.shown.left < before && chartPicks.len() == 2
				// Home shows all the data again.
				chart.focus()
				scene.arrange(size)
				scene.key(KeyEvent{target: chart, key: Key.Home})
				scene.arrange(size)
				assert near(chart.transform().range.left, -1.6)
				// The same drawing goes to a canvas: the line's colour is on its middle point.
				let surface = new canvas.Canvas(400, 300)
				chart.drawTo(surface, 400.0, 300.0)
				let ink = chart.colorOf(0)
				let found = false
				for let dy = -2; dy <= 2; dy++ {
					for let dx = -2; dx <= 2; dx++ {
						let i = ((int(at.y(5.0)) + dy) * surface.width + int(at.x(5.0)) + dx) * 4
						found = true when (int(surface.pixels[i]) - int(ink.red)).abs() < 24 && (int(surface.pixels[i + 1]) - int(ink.green)).abs() < 24 && (int(surface.pixels[i + 2]) - int(ink.blue)).abs() < 24
					}
				}
				assert found
			}
			scene.close()
		}
	}
}
