partial module std.ui.charts {
	use (
		std.gfx.canvas
		std.gfx.color::Color
		std.math
		std.math.geom::(Circle, LineJoin, Path, Point, Rect, StrokeStyle)
		std.ui::RenderContext
		std.ui.styles::*
		std.units::Pixels
	)

	// The x of item `i`: `xs[i]`, else `i` when the series gives no xs.
	internal def xAt(xs float[], i int) float {
		return xs.len() == 0 ?? (float(i), xs[i])
	}

	// The xs of a series: its own, else 0, 1, 2 and on, as many as `ys`.
	internal def xsOf(xs float[], ys float[]) float[] {
		return xs unless xs.len() == 0
		let made float[]
		made.len(ys.len())
		for let i = 0; i < ys.len(); i++ {
			made[i] = float(i)
		}
		return made
	}

	// The range of the points (`xs`, `ys`), NaN skipped; `left > right` for none.
	internal def extentOf(xs float[], ys float[], withZero bool = false) ChartViewport {
		let n = ys.len()
		n = n.min(xs.len()) unless xs.len() == 0
		let out = ChartViewport{left: 0.0, right: -1.0, bottom: 0.0, top: -1.0}
		let first = true
		for let i = 0; i < n; i++ {
			let (x, y) = (xAt(xs, i), ys[i])
			continue when missing(x) || missing(y)
			if first {
				out = ChartViewport{left: x, right: x, bottom: y, top: y}
				first = false
			} else {
				out.left = out.left.min(x)
				out.right = out.right.max(x)
				out.bottom = out.bottom.min(y)
				out.top = out.top.max(y)
			}
		}
		if withZero && !first {
			out.bottom = out.bottom.min(0.0)
			out.top = out.top.max(0.0)
		}
		return out
	}

	// The index of the point of (`xs`, `ys`) nearest the pixel and how far it is.
	internal def nearestOf(xs float[], ys float[], at ChartTransform, x float, y float) (int, float) {
		let n = ys.len()
		n = n.min(xs.len()) unless xs.len() == 0
		let (best, distance) = (-1, 0.0)
		for let i = 0; i < n; i++ {
			continue when missing(ys[i])
			let (dx, dy) = (at.x(xAt(xs, i)) - x, at.y(ys[i]) - y)
			let d = math.sqrt(dx * dx + dy * dy)
			if best < 0 || d < distance {
				(best, distance) = (i, d)
			}
		}
		return (best, distance)
	}

	// The polyline of the pixel pairs `points`.
	internal def pathThrough(points float[]) Path {
		let path = new Path()
		for let i = 0; i + 1 < points.len(); i += 2 {
			if i == 0 {
				path = path.moveTo(points[i], points[i + 1])
			} else {
				path = path.lineTo(points[i], points[i + 1])
			}
		}
		return path
	}

	// Draws a part of the chart it is in through the chart's transform.
	internal def drawInChart(part component, ctx RenderContext) {
		let chart = part.closest<Chart>()
		return when chart is none
		chart.drawPart(ctx.draw, part, chart.transform(), ctx.scale)
	}

	// A line through the points of a series: `LineSeries(values, xs = times, label =
	// "load")`. Without `xs` the points are at 0, 1, 2 and on; `xs` go up. A NaN value is
	// skipped: the line goes from the point before to the point after. More points than
	// two to a pixel column are thinned to each column's first, lowest, highest and last,
	// so every peak is drawn.
	component LineSeries {
		type {
			@input(value = true)
			ys float[] = []

			@input
			xs float[] = []

			@input
			label string = ""

			// Its colour; none: the chart's next one.
			@input
			color ?Color = none

			@input
			width float = 2.0

			def extent() ChartViewport {
				return extentOf(xs, ys)
			}

			def seriesColor() ?Color {
				return color
			}

			def seriesLabel() string {
				return label
			}

			def nearest(at ChartTransform, x float, y float) (int, float) {
				return nearestOf(xs, ys, at, x, y)
			}

			def drawOn(target canvas.Painter, chart Chart, at ChartTransform, ink Color, scale float) {
				let points = linePoints(xsOf(xs, ys), ys, at)
				return when points.len() < 4
				target.stroke(pathThrough(points), ink, StrokeStyle{width: width * 1(px), join: LineJoin.Round})
			}

			def render(ctx RenderContext) {
				drawInChart(self, ctx)
			}
		}

		view {}

		style ChartPartStyle
	}

	// A line through the points of a series with the room under it, down to 0, filled
	// in its colour, lighter: `AreaSeries(values, xs = times)`.
	component AreaSeries {
		type {
			@input(value = true)
			ys float[] = []

			@input
			xs float[] = []

			@input
			label string = ""

			@input
			color ?Color = none

			// How much of the colour the fill takes, 0 to 1.
			@input
			opacity float = 0.25

			def extent() ChartViewport {
				return extentOf(xs, ys, withZero = true)
			}

			def seriesColor() ?Color {
				return color
			}

			def seriesLabel() string {
				return label
			}

			def nearest(at ChartTransform, x float, y float) (int, float) {
				return nearestOf(xs, ys, at, x, y)
			}

			def drawOn(target canvas.Painter, chart Chart, at ChartTransform, ink Color, scale float) {
				let points = linePoints(xsOf(xs, ys), ys, at)
				return when points.len() < 4
				let base = at.y(0.0).max(at.plot.top).min(at.plot.bottom)
				let fill = pathThrough(points).lineTo(points[points.len() - 2], base).lineTo(points[0], base).close()
				target.fill(fill, ink.withOpacity(opacity))
				target.stroke(pathThrough(points), ink, StrokeStyle{width: 2(px), join: LineJoin.Round})
			}

			def render(ctx RenderContext) {
				drawInChart(self, ctx)
			}
		}

		view {}

		style ChartPartStyle
	}

	// A bar from 0 to each value: `BarSeries(counts, xs = days)`. A bar is `band` of the
	// smallest step between two xs wide (1 without xs), centred on its x; several bar
	// series side by side give each their own `offset` within the step.
	component BarSeries {
		type {
			@input(value = true)
			ys float[] = []

			@input
			xs float[] = []

			@input
			label string = ""

			@input
			color ?Color = none

			// The part of the step between two xs a bar takes.
			@input
			band float = 0.8

			// Where the bar's centre sits from its x, in parts of the step.
			@input
			offset float = 0.0

			def extent() ChartViewport {
				let seen = extentOf(xs, ys, withZero = true)
				let half = step() / 2.0
				return seen when seen.right < seen.left
				return ChartViewport{left: seen.left - half, right: seen.right + half, bottom: seen.bottom, top: seen.top}
			}

			// The smallest step between two neighbouring xs; 1 with fewer than two.
			def step() float {
				return 1.0 when xs.len() < 2
				let least = (xs[1] - xs[0]).abs()
				for let i = 2; i < xs.len(); i++ {
					let gap = (xs[i] - xs[i - 1]).abs()
					least = gap when gap > 0.0 && (gap < least || least == 0.0)
				}
				return least > 0.0 ?? (least, 1.0)
			}

			def seriesColor() ?Color {
				return color
			}

			def seriesLabel() string {
				return label
			}

			// The bar of item `i` in pixels.
			def barOf(at ChartTransform, i int, wide float) Rect {
				let centre = xAt(xs, i) + offset * step()
				let (left, right) = (at.x(centre - wide / 2.0), at.x(centre + wide / 2.0))
				let (zero, value) = (at.y(0.0), at.y(ys[i]))
				return Rect{left: left.min(right), top: zero.min(value), right: left.max(right), bottom: zero.max(value)}
			}

			def nearest(at ChartTransform, x float, y float) (int, float) {
				let wide = step() * band
				let n = xs.len() == 0 ?? (ys.len(), ys.len().min(xs.len()))
				for let i = 0; i < n; i++ {
					continue when missing(ys[i])
					let bar = barOf(at, i, wide)
					return (i, 0.0) when x >= bar.left && x <= bar.right && y >= bar.top - 1.0 && y <= bar.bottom + 1.0
				}
				return (-1, 0.0)
			}

			def drawOn(target canvas.Painter, chart Chart, at ChartTransform, ink Color, scale float) {
				let wide = step() * band
				let n = xs.len() == 0 ?? (ys.len(), ys.len().min(xs.len()))
				let first = 0
				let last = n
				if xs.len() > 0 && ascending(xs) {
					// Only the bars in view.
					first = (firstAtLeast(xs, at.range.left - wide) - 1).max(0)
					last  = (firstAtLeast(xs, at.range.right + wide) + 1).min(n)
				}
				for let i = first; i < last; i++ {
					continue when missing(ys[i])
					target.fill(barOf(at, i, wide), ink)
				}
			}

			def render(ctx RenderContext) {
				drawInChart(self, ctx)
			}
		}

		view {}

		style ChartPartStyle
	}

	// A dot at each point: `ScatterSeries(heights, xs = weights)`.
	component ScatterSeries {
		type {
			@input(value = true)
			ys float[] = []

			@input
			xs float[] = []

			@input
			label string = ""

			@input
			color ?Color = none

			// The dots' radius, in pixels.
			@input
			radius float = 3.0

			def extent() ChartViewport {
				return extentOf(xs, ys)
			}

			def seriesColor() ?Color {
				return color
			}

			def seriesLabel() string {
				return label
			}

			def nearest(at ChartTransform, x float, y float) (int, float) {
				return nearestOf(xs, ys, at, x, y)
			}

			def drawOn(target canvas.Painter, chart Chart, at ChartTransform, ink Color, scale float) {
				let n = xs.len() == 0 ?? (ys.len(), ys.len().min(xs.len()))
				for let i = 0; i < n; i++ {
					continue when missing(ys[i])
					let (x, y) = (at.x(xAt(xs, i)), at.y(ys[i]))
					continue when x < at.plot.left - radius || x > at.plot.right + radius || y < at.plot.top - radius || y > at.plot.bottom + radius
					target.fill(new Circle(new Point(x, y), radius), ink)
				}
			}

			def render(ctx RenderContext) {
				drawInChart(self, ctx)
			}
		}

		view {}

		style ChartPartStyle
	}
}
