partial module std.ui.components {
	use (
		std.gfx.canvas
		std.math.geom::(Axes, Edges, Path)
		std.ui::(KeyEvent, RenderContext, Theme, UI)
		std.ui.paint
		std.ui.runtime::Boxed
		std.ui.styles::*
		std.units::Extent
	)

	// The style of an `AccordionItem`: its box, how it arranges what it holds, the look of
	// its text, how it takes the pointer and the keyboard, and the line under it.
	style AccordionItemStyle {
		Box
		Layout
		Borders
		Typography
		Interaction
		width = fill
		// The title's row above what it holds; the line under it is part of the box.
		padding = new Edges<Extent>(theme.metrics.controlHeight, theme.metrics.unit * 2.0, theme.metrics.unit - theme.metrics.borderWidth, theme.metrics.unit * 2.0)
		border = {bottom: canvas.Border{width: theme.metrics.borderWidth, paint: theme.palette.divider}}
	}

	// The arrow of an `AccordionItem`'s title line: the part named `arrow` of its `head`.
	// Down while `open`, toward the end of the line while closed, in its style's
	// `foreground`.
	internal component AccordionArrow {
		type {
			@input
			open bool = false

			look Theme = UI.theme()

			def render(ctx RenderContext) {
				let box = frameBox(ctx)
				let arm = box.right / 2.0
				let (cx, cy) = (arm, box.bottom / 2.0)
				let arrow = new Path()
				if open {
					arrow.moveTo(cx - arm, cy - arm / 2.0).lineTo(cx + arm, cy - arm / 2.0).lineTo(cx, cy + arm / 2.0).close()
				} else if ctx.direction == Direction.RightToLeft {
					arrow.moveTo(cx + arm / 2.0, cy - arm).lineTo(cx + arm / 2.0, cy + arm).lineTo(cx - arm / 2.0, cy).close()
				} else {
					arrow.moveTo(cx - arm / 2.0, cy - arm).lineTo(cx - arm / 2.0, cy + arm).lineTo(cx + arm / 2.0, cy).close()
				}
				ctx.draw.fill(arrow, inkOf(style.foreground, look.palette.foregroundMuted))
			}
		}

		view {}

		style {
			Box
			Foreground
			Interaction
			width      = 8(px)
			height     = 8(px)
			position   = Position.Relative
			anchors    = Anchors{left: new AnchorLine(theme.metrics.unit * 2.0), centerY: new AnchorLine(0(px))}
			foreground = theme.palette.foregroundMuted
			hitTest    = HitTest.None
			on         = {
				disabled: {foreground: theme.palette.foregroundDisabled},
			}
		}
	}

	// The title line of an `AccordionItem`: its part named `head`, along the top of the
	// section. It is lit under the pointer and while held down, a click on it runs
	// `onClick`, and it shows a ring while the section shows the keyboard focus
	// (`ringed`). The title is bold unless its style names another font.
	internal component AccordionHead {
		type {
			@input(value = true)
			title string = ""

			@input
			open bool = false

			@input
			@state
			ringed bool = false

			// What the line shows in place of `title`.
			@input
			line ?view = none

			block ?paint.TextBlock = none
			look  Theme = UI.theme()

			def render(ctx RenderContext) {
				ctx.outerShadows()
				ctx.background()
				ctx.borders()
				if line is none {
					let made = labelBlock(block, title, style.font, em * 1(px), style.foreground, style.paragraph, look.palette.foreground, decoration = style.decoration)
					block = made
					paint.drawBlock(ctx.draw, made, ctx.geometry.content.toFloat(), Align{horizontal: Alignment.Start, vertical: Alignment.Center}, ctx.direction == Direction.RightToLeft, ctx.scale)
				}
				ctx.childNodes()
				ctx.innerShadows()
			}
		}

		view {
			AccordionArrow(ref = arrow, open = open)
			if !(line is none) {
				line()
			}
		}

		style {
			Box
			Control
			Layout
			arrange  = Arrange.Row
			align    = Align{horizontal: Alignment.Start, vertical: Alignment.Center}
			gap      = new Axes<Extent>(theme.metrics.unit)
			height   = theme.metrics.controlHeight
			position = Position.Relative
			anchors  = Anchors{left: new AnchorLine(0(px)), top: new AnchorLine(0(px)), right: new AnchorLine(0(px))}
			// Room for the arrow before the title.
			padding    = new Edges<Extent>(0(px), theme.metrics.unit * 2.0, 0(px), theme.metrics.unit * 4.0 + 8(px))
			font       = Font{family: "system-ui", weight: FontWeight.Bold}
			foreground = theme.palette.foreground
			on         = {
				hover:    {background: new BackgroundFill(theme.palette.surface.mix(theme.palette.hover))},
				pressed:  {background: new BackgroundFill(theme.palette.surface.mix(theme.palette.pressed))},
				ringed:   {outline: Ring{width: theme.metrics.focusWidth, paint: theme.palette.focus, offset: -theme.metrics.focusWidth}},
				disabled: {foreground: theme.palette.foregroundDisabled},
			}
		}
	}

	// What holds `AccordionItem`s and is told when one opens.
	internal interface AccordionGroup {
		def sectionOpened(item component)
	}

	// A titled section that opens and closes: `AccordionItem(title = "Advanced") { ... }`.
	// A press on its title, Space or Enter shows or hides what it holds. It works alone,
	// and in an `Accordion`. `heading = view { Icon("gear"); Text("Advanced") }` composes
	// the title line in place of `title`.
	component AccordionItem {
		type {
			// What its title says.
			@input(value = true)
			title string = ""

			// What its title line shows in place of `title`, after the arrow.
			@input
			heading ?view = none

			// Whether what it holds is shown.
			@input(bind = true)
			@state
			open bool = false

			// Runs with the new state when it opens or closes.
			@input
			onToggle ?(def(bool)) = none

			// Tells every listener whether it is open now, after the handler ran: heard with
			// `@on(AccordionItem.toggled)`.
			@emit()
			def toggled(open bool) bool {
				return open
			}

			// How its content was last shown: 0 hidden, 1 shown, -1 not yet; and how many
			// components that was.
			applied int = -1
			count   int
			// The children it hid when it closed.
			hidden  component[]

			def new() {
				focusable = true
				tabStop   = true
			}

			// Shows or hides what it holds: closing hides the children that were shown
			// and remembers them, opening shows those again, so a child the application
			// hid itself stays hidden. True when that changed anything.
			def show() bool {
				let wanted = open ?? (1, 0)
				return false when wanted == applied && count == childNodes.len()
				applied = wanted
				count   = childNodes.len()
				if open {
					for let child in hidden {
						let box = child.style
						box.visible = true when box is Boxed
					}
					hidden = []
					return true
				}
				for let child in childNodes {
					// The title line stays.
					continue when child is AccordionHead
					let box = child.style
					if box is Boxed {
						continue when !box.visible
						box.visible = false
						hidden.push(child)
					}
				}
				return true
			}

			// Opens or closes it and tells the caller; no more when it is so already.
			def set(now bool) {
				return when now == open
				open = now
				let _ = show()
				redraw()
				let tell = onToggle
				tell(now) unless tell is none
				toggled(now)
			}

			// Opens it when closed and closes it when open, as a press on its title does.
			def toggle() {
				return when disabled
				set(!open)
				return when !open
				let above = parent()
				return when above is none
				let me component = self
				above.sectionOpened(me) when above is AccordionGroup
			}

			def key(e KeyEvent) bool {
				return false when !e.down
				// A key that comes up from something inside it is not its own.
				return false when !focused
				return keyRuns(e, !disabled, toggle)
			}

			def attached() {
				let _ = show()
			}

			def render(ctx RenderContext) {
				redraw() when show()
				ctx.outerShadows()
				ctx.background()
				ctx.borders()
				ctx.childNodes()
				ctx.innerShadows()
			}
		}

		// Its parts: `head`, the title line with its `arrow`; then what it holds.
		view {
			AccordionHead(title, ref = head, open = open, ringed = focusVisible, onClick = toggle, focusable = false, line = heading)
			children()
		}

		style AccordionItemStyle
	}

	// Sections of which one is open at a time:
	// `Accordion() { AccordionItem(title = "General") { ... }; AccordionItem(title = "Advanced") { ... } }`.
	// Opening one closes the others; `single = false` lets several be open.
	component Accordion {
		type {
			// Whether opening a section closes the others.
			@input
			single bool = true

			// A section opened: the others close.
			def sectionOpened(item component) {
				return when !single
				for let child in childNodes {
					continue when child == item
					child.set(false) when child is AccordionItem
				}
			}
		}

		view {
			children()
		}

		style {
			ColumnStyle
			width = fill
		}
	}
}
