partial module std.ui.components {
	use (
		std.math.geom::(Edges, Path, Rect)
		std.ui::(KeyEvent, PointerEvent, RenderContext, Theme, UI)
		std.ui.paint
		std.ui.runtime::Boxed
		std.ui.styles::*
		std.units::Extent
	)

	// The style of an `AccordionItem`: its box, how it arranges what it holds, the look of
	// its title, and how it takes the pointer and the keyboard.
	style AccordionItemStyle {
		Box
		Layout
		Typography
		Interaction
		width = fill
		// The title's row above what it holds.
		padding = new Edges<Extent>(theme.metrics.controlHeight, theme.metrics.unit * 2.0, theme.metrics.unit, theme.metrics.unit * 2.0)
	}

	// What holds `AccordionItem`s and is told when one opens.
	internal interface AccordionGroup {
		def sectionOpened(item component)
	}

	// A titled section that opens and closes: `AccordionItem(title = "Advanced") { ... }`.
	// A press on its title, Space or Enter shows or hides what it holds. It works alone,
	// and in an `Accordion`.
	component AccordionItem {
		type {
			// What its title says.
			@input(value = true)
			title string = ""

			// Whether what it holds is shown.
			@input(bind = true)
			@state
			open bool = false

			// Runs with the new state when it opens or closes.
			@input
			onToggle ?(def(bool)) = none

			// Tells every listener whether it is open now, after the handler ran: heard with
			// `@on(AccordionItem.toggled)`.
			@emit()
			def toggled(open bool) bool {
				return open
			}

			look    Theme = UI.theme()
			block   ?paint.TextBlock = none
			// How its content was last shown: 0 hidden, 1 shown, -1 not yet; and how many
			// components that was.
			applied int = -1
			count   int
			// The children it hid when it closed.
			hidden  component[]

			def new() {
				focusable = true
				tabStop   = true
			}

			// The height of the title's line.
			def header() float {
				return float(look.metrics.controlHeight)
			}

			// Shows or hides what it holds: closing hides the children that were shown
			// and remembers them, opening shows those again, so a child the application
			// hid itself stays hidden. True when that changed anything.
			def show() bool {
				let wanted = open ?? (1, 0)
				return false when wanted == applied && count == childNodes.len()
				applied = wanted
				count   = childNodes.len()
				if open {
					for let child in hidden {
						let box = child.style
						box.visible = true when box is Boxed
					}
					hidden = []
					return true
				}
				for let child in childNodes {
					let box = child.style
					if box is Boxed {
						continue when !box.visible
						box.visible = false
						hidden.push(child)
					}
				}
				return true
			}

			// Opens or closes it and tells the caller; no more when it is so already.
			def set(now bool) {
				return when now == open
				open = now
				let _ = show()
				redraw()
				let tell = onToggle
				tell(now) unless tell is none
				toggled(now)
			}

			// Opens it when closed and closes it when open, as a press on its title does.
			def toggle() {
				return when disabled
				set(!open)
				return when !open
				let above = parent()
				return when above is none
				let me component = self
				above.sectionOpened(me) when above is AccordionGroup
			}

			def pointer(e PointerEvent) bool {
				// Only the title's line: what it holds has the rest.
				return false when float(e.position.y) >= header()
				return pressRuns(e, style.geom, !disabled, toggle)
			}

			def key(e KeyEvent) bool {
				return false when !e.down
				// A key that comes up from something inside it is not its own.
				return false when !focused
				return keyRuns(e, !disabled, toggle)
			}

			def attached() {
				let _ = show()
			}

			def render(ctx RenderContext) {
				redraw() when show()
				let palette = look.palette
				let frame = ctx.geometry.frame
				let (width, high) = (float(frame.width), header())
				let rtl = ctx.direction == Direction.RightToLeft
				ctx.draw.fill(Rect{left: 0.0, top: 0.0, right: width, bottom: high}, palette.surface.mix(pressed ?? (palette.pressed, palette.hover))) when !disabled && hover
				// The arrow: down when open, toward the end of the line when closed.
				let pad = float(look.metrics.unit) * 2.0
				let arm = 4.0
				let (cx, cy) = (rtl ?? (width - pad - arm, pad + arm), high / 2.0)
				let arrow = new Path()
				if open {
					arrow.moveTo(cx - arm, cy - arm / 2.0).lineTo(cx + arm, cy - arm / 2.0).lineTo(cx, cy + arm / 2.0).close()
				} else if rtl {
					arrow.moveTo(cx + arm / 2.0, cy - arm).lineTo(cx + arm / 2.0, cy + arm).lineTo(cx - arm / 2.0, cy).close()
				} else {
					arrow.moveTo(cx - arm / 2.0, cy - arm).lineTo(cx - arm / 2.0, cy + arm).lineTo(cx + arm / 2.0, cy).close()
				}
				ctx.draw.fill(arrow, !disabled ?? (palette.foregroundMuted, palette.foregroundDisabled))
				// Bold unless its style names a font.
				let font = Font{family: "system-ui", weight: FontWeight.Bold}
				let given = style.font
				font = given unless given is none
				let made = labelBlock(block, title, font, style.foreground, style.paragraph, !disabled ?? (palette.foreground, palette.foregroundDisabled))
				block = made
				let room = pad + arm * 2.0 + float(look.metrics.unit) * 2.0
				let line = rtl ?? (Rect{left: pad, top: 0.0, right: width - room, bottom: high}, Rect{left: room, top: 0.0, right: width - pad, bottom: high})
				paint.drawBlock(ctx.draw, made, line, Align{horizontal: Alignment.Start, vertical: Alignment.Center}, rtl, ctx.scale)
				drawFocusRing(ctx, look, Rect{left: 3.0, top: 3.0, right: width - 3.0, bottom: high - 3.0}, float(look.metrics.radius)) when focusVisible
				let thick = float(look.metrics.borderWidth)
				ctx.draw.fill(Rect{left: 0.0, top: float(frame.height) - thick, right: width, bottom: float(frame.height)}, palette.divider)
				ctx.childNodes()
			}
		}

		view {
			children()
		}

		style AccordionItemStyle
	}

	// Sections of which one is open at a time:
	// `Accordion() { AccordionItem(title = "General") { ... }; AccordionItem(title = "Advanced") { ... } }`.
	// Opening one closes the others; `single = false` lets several be open.
	component Accordion {
		type {
			// Whether opening a section closes the others.
			@input
			single bool = true

			// A section opened: the others close.
			def sectionOpened(item component) {
				return when !single
				for let child in childNodes {
					continue when child == item
					child.set(false) when child is AccordionItem
				}
			}
		}

		view {
			children()
		}

		style {
			ColumnStyle
			width = fill
		}
	}
}
