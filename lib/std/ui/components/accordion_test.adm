partial module std.ui.components {
	use (
		std.math.geom::Size
		std.testing
		std.ui.runtime::Scene
		std.ui.styles::*
		std.units::Pixels
	)

	// A section whose title line is composed.
	component ComposedSection {
		type {}

		view {
			AccordionItem() {
				heading = view {
					Text("Advanced")
					Text("3 settings")
				}
				Text("inside")
			}
		}

		style StageStyle
	}

	check "Accordion" {
		// A `heading` view takes the title's place on the title line, after the arrow.
		@test()
		def TestComposedHeading() {
			let page = ComposedSection()
			let scene = new Scene(page)
			scene.arrange(new Size<Pixels>(300(px), 200(px)))
			let item = page.children[0]
			let head = item.childNodes[0]
			assert head.childNodes.len() == 3
			let arrow = head.childNodes[0]
			let first = head.childNodes[1]
			let second = head.childNodes[2]
			assert first is Text && second is Text
			assert float(first.style.geom.frame.left) > float(arrow.style.geom.frame.left)
			assert float(second.style.geom.frame.left) > float(first.style.geom.frame.left)
		}
	}
}
