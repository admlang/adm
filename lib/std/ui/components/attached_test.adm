partial module std.ui.components {
	use (
		std.math.geom::(Point, Size)
		std.testing
		std.ui::(MouseButton, PointerPhase)
		std.ui.runtime::Scene
		std.ui.styles::*
		std.units::Pixels
	)

	// A button and a link that each hold a context menu.
	component AttachedMenus {
		type {}

		view {
			Column(gap = 6(px)) {
				Button("Share", ref = share) {
					ContextMenu(ref = shareMenu) {
						MenuItem("Copy link")
					}
				}
				Link("Docs", ref = docs) {
					ContextMenu(ref = docsMenu) {
						MenuItem("Copy address")
					}
				}
			}
		}

		style StageStyle
	}

	check "Attached" {
		// A context menu in the block of a button or a link opens where the secondary
		// button comes up on it.
		@test()
		def TestMenusInButtonsAndLinks() {
			let page = AttachedMenus()
			let scene = new Scene(page)
			let lay = def () {
				nextFrame(scene, new Size<Pixels>(400(px), 300(px)))
				nextFrame(scene, new Size<Pixels>(400(px), 300(px)))
			}
			lay()
			let centre = def (c component) Point<Pixels> {
				let frame = c.style.geom.frame
				return new Point<Pixels>((float(frame.left) + float(frame.width) / 2.0) * 1(px), (float(frame.top) + float(frame.height) / 2.0) * 1(px))
			}
			let seen = def (c component) bool {
				return float(c.style.geom.frame.width) > 0.0
			}
			let share = page.share
			let menu = page.shareMenu
			let docs = page.docs
			let docsMenu = page.docsMenu
			assert !(share is none) && !(menu is none) && !(docs is none) && !(docsMenu is none)
			if !(share is none) && !(menu is none) {
				assert !seen(menu)
				let at = centre(share)
				scene.pointer(PointerPhase.Down, at, MouseButton.Right)
				scene.pointer(PointerPhase.Up, at, MouseButton.Right)
				lay()
				assert seen(menu)
			}
			if !(docs is none) && !(docsMenu is none) {
				let at = centre(docs)
				scene.pointer(PointerPhase.Down, at, MouseButton.Right)
				scene.pointer(PointerPhase.Up, at, MouseButton.Right)
				lay()
				assert seen(docsMenu)
			}
		}
	}
}
