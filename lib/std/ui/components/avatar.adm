partial module std.ui.components {
	use (
		std.formats.image
		std.math.geom::(Circle, Path, Point, Rect)
		std.ui::(RenderContext, Theme, UI)
		std.ui.paint
		std.ui.styles::*
		std.units::Pixels
	)

	// The first letters of the first and the last word of a name, as capitals: what an
	// `Avatar` without a picture shows.
	internal def initials(name string) string {
		let words = name.words()
		return "" when words.len() == 0
		let first = words[0].slice(0, 1).upper()
		return first when words.len() == 1
		return first + words[words.len() - 1].slice(0, 1).upper()
	}

	// Who something belongs to, in a circle: `Avatar(name = "Ada Lovelace")` shows the
	// initials on a colour of the theme; with `source` it shows the picture, filling the
	// circle. 32 pixels across unless its style says otherwise.
	component Avatar {
		type {
			// Whose it is.
			@input(value = true)
			name string = ""

			// Their picture; none: their initials.
			@input
			source ?image.Image = none

			block ?paint.TextBlock = none
			look  Theme = UI.theme()

			def render(ctx RenderContext) {
				let frame = ctx.geometry.frame
				let side = float(frame.width).min(float(frame.height))
				return when side <= 0.0
				let (left, top) = ((float(frame.width) - side) / 2.0, (float(frame.height) - side) / 2.0)
				let round = new Circle(new Point(left + side / 2.0, top + side / 2.0), side / 2.0)
				let picture = source
				if picture is none {
					ctx.draw.fill(round, look.palette.accent)
					let font = Font{family: "system-ui", weight: FontWeight.Bold, size: side * 0.4 * 1(px)}
					let made = labelBlock(block, initials(name), font, style.foreground, style.paragraph, look.palette.onAccent)
					block = made
					paint.drawBlock(ctx.draw, made, Rect{left: left, top: top, right: left + side, bottom: top + side}, Align{horizontal: Alignment.Center, vertical: Alignment.Center}, false, ctx.scale)
					return
				}
				// The picture covers the circle and is cut at it.
				let size = picture.size()
				let (wide, high) = (float(size.width), float(size.height))
				return when wide <= 0.0 || high <= 0.0
				let by = (side / wide).max(side / high)
				let (drawnWide, drawnHigh) = (wide * by, high * by)
				ctx.draw.save()
				ctx.draw.clip(new Path().circle(round.center, round.radius))
				ctx.draw.drawImage(picture, Rect{left: left + (side - drawnWide) / 2.0, top: top + (side - drawnHigh) / 2.0, right: left + (side + drawnWide) / 2.0, bottom: top + (side + drawnHigh) / 2.0})
				ctx.draw.restore()
			}
		}

		view {}

		style {
			FigureStyle
			width  = 32(px)
			height = 32(px)
		}
	}
}
