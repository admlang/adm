partial module std.ui.components {
	use (
		std.math.geom::(Edges, Size)
		std.ui::(Limit, RenderContext, Theme, UI)
		std.ui.paint
		std.ui.styles::*
		std.units::(Extent, Pixels)
	)

	// A short note on something, in a pill: a count, a state. `Badge(label = "3")`.
	component Badge {
		type {
			// The text in it.
			@input(value = true)
			label string = ""

			block ?paint.TextBlock = none
			look  Theme = UI.theme()

			def current() paint.TextBlock {
				let made = labelBlock(block, label, style.font, style.foreground, style.paragraph, look.palette.onAccent)
				block = made
				return made
			}

			def measure(limit Limit) Size<Pixels> {
				return current().measure(limit)
			}

			def render(ctx RenderContext) {
				let box = frameBox(ctx)
				ctx.draw.fill(box, box.bottom / 2.0, look.palette.accent)
				paint.drawBlock(ctx.draw, current(), ctx.geometry.content.toFloat(), Align{horizontal: Alignment.Center, vertical: Alignment.Center}, ctx.direction == Direction.RightToLeft, ctx.scale)
			}
		}

		view {}

		style {
			FigureStyle
			padding = new Edges<Extent>(1(px), theme.metrics.unit * 2.0)
		}
	}
}
