partial module std.ui.components {
	use (
		std.math.geom::(Axes, Edges, Rect)
		std.ui::(RenderContext, Theme, UI)
		std.ui.styles::*
		std.units::Extent
	)

	// A strip of controls along the top of a window or a panel:
	// `Toolbar() { Button("Run"); Button("Stop"); Spacer(); SearchField(…) }`. Its children
	// sit in a row with a gap, centred on its height, over a line that parts it from what
	// is under it.
	component Toolbar {
		type {
			// The space between neighbouring children.
			@input
			gap Extent = 4(px)

			look Theme = UI.theme()

			def render(ctx RenderContext) {
				ctx.background()
				ctx.childNodes()
				let box = frameBox(ctx)
				ctx.draw.fill(Rect{left: 0.0, top: box.bottom - float(look.metrics.borderWidth), right: box.right, bottom: box.bottom}, look.palette.divider)
			}
		}

		view {
			children()
		}

		style {
			Box
			Layout
			Background
			arrange    = Arrange.Row
			padding    = new Edges<Extent>(theme.metrics.unit * 1.0, theme.metrics.unit * 2.0)
			width      = fill
			align      = Align{horizontal: Alignment.Start, vertical: Alignment.Center}
			background = new BackgroundFill(theme.palette.surface)
			// The gap follows its input.
			gap = new Axes<Extent>(self.gap)
		}
	}

	// A strip of short notes along the bottom of a window:
	// `StatusBar() { Text("Ln 12, Col 4"); Spacer(); Text("UTF-8") }`. Its children sit in a
	// row under a line that parts it from what is above it.
	component StatusBar {
		type {
			// The space between neighbouring children.
			@input
			gap Extent = 12(px)

			look Theme = UI.theme()

			def render(ctx RenderContext) {
				ctx.background()
				ctx.childNodes()
				let box = frameBox(ctx)
				ctx.draw.fill(Rect{left: 0.0, top: 0.0, right: box.right, bottom: float(look.metrics.borderWidth)}, look.palette.divider)
			}
		}

		view {
			children()
		}

		style {
			Box
			Layout
			Background
			arrange    = Arrange.Row
			padding    = new Edges<Extent>(theme.metrics.unit * 0.5, theme.metrics.unit * 2.0)
			width      = fill
			align      = Align{horizontal: Alignment.Start, vertical: Alignment.Center}
			background = new BackgroundFill(theme.palette.surfaceSunken)
			// The gap follows its input.
			gap = new Axes<Extent>(self.gap)
		}
	}
}
