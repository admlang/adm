partial module std.ui.components {
	use (
		std.math.geom::Size
		std.testing
		std.ui.runtime::Scene
		std.ui.styles::*
		std.units::Pixels
	)

	// A toolbar with a group at each end.
	component GroupedBar {
		type {}

		view {
			Toolbar() {
				start = view {
					Button("Back")
				}
				end = view {
					Button("Help")
				}
				Button("Run")
			}
		}

		style StageStyle
	}

	check "Bars" {
		// The start group comes before the bar's children, the end group stands at its
		// far end.
		@test()
		def TestBarGroups() {
			let page = GroupedBar()
			let scene = new Scene(page)
			scene.arrange(new Size<Pixels>(400(px), 100(px)))
			let bar = page.children[0]
			let parts = bar.childNodes
			assert parts.len() == 4
			let left = def (c component) float {
				return float(c.style.geom.frame.left)
			}
			let right = def (c component) float {
				return float(c.style.geom.frame.right)
			}
			assert left(parts[0]) < left(parts[1]) && left(parts[1]) < left(parts[3])
			assert (right(parts[3]) - right(bar)).abs() < 20.0
		}
	}
}
