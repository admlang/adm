partial module std.ui.components {
	use (
		std.math.geom::(Line, Point, Rect, Size, StrokeStyle)
		std.ui::(Key, KeyEvent, Limit, MouseButton, PointerEvent, PointerPhase, RenderContext, Theme, UI)
		std.ui.paint
		std.ui.styles::*
		std.units::Pixels
	)

	// Where something is, as the steps that lead to it:
	// `Breadcrumbs(items = ["src", "ui", "main.adm"], onSelect = open)`. The last step is
	// where one is; a press on an earlier one picks it. With the focus, Left and Right
	// move between the steps and Space or Enter picks the one the keys are on.
	component Breadcrumbs {
		type {
			// The steps, the outermost first.
			@input(value = true)
			items string[] = []

			// Runs with a step's index when the user picks it.
			@input
			onSelect ?(def(int)) = none

			// Tells every listener which step was chosen, after the handler ran: heard with
			// `@on(Breadcrumbs.selected)`.
			@emit()
			def selected(index int) int {
				return index
			}

			look Theme = UI.theme()
			// The steps' titles and slots.
			row  TitleRow = new TitleRow()
			// The step under the pointer and the one the keys are on, -1 for none.
			over int = -1
			at   int = -1

			// Whether it is laid out right to left.
			def rtl() bool {
				return style.geom.direction == Direction.RightToLeft
			}

			def new() {
				focusable = true
				tabStop   = true
			}

			// Half the room between two steps: the mark between them is drawn in it.
			def pad() float {
				return float(look.metrics.unit) * 2.5
			}

			// Brings the titles and their slots in step with the inputs and the theme.
			def lay() {
				let palette = look.palette
				row.lay(items, items.len() - 1, !disabled, palette.foreground, palette.foregroundMuted, palette.foregroundDisabled, pad(), style.font, style.foreground, style.paragraph)
			}

			def measure(limit Limit) Size<Pixels> {
				lay()
				return new Size<Pixels>(row.width() * 1(px), float(look.metrics.controlHeight) * 1(px))
			}

			// Picks the step as a click on it does; the last one is where one is already.
			def pick(index int) {
				return when disabled || index < 0 || index >= items.len() - 1
				let tell = onSelect
				tell(index) unless tell is none
				selected(index)
			}

			// Notes the step under the pointer and asks to be drawn when it is another one.
			def point(index int) {
				return when index == over
				over = index
				redraw()
			}

			def pointer(e PointerEvent) bool {
				return false when disabled
				let along = rtl() ?? (float(style.geom.frame.width) - float(e.position.x), float(e.position.x))
				match e.phase {
					case PointerPhase.Move, PointerPhase.Enter:
						point(row.at(along))
						return false
					case PointerPhase.Leave, PointerPhase.Cancel:
						point(-1)
						return false
					case PointerPhase.Down:
						return false when e.button != MouseButton.Left
						pick(row.at(along))
						return true
					default:
						return false
				}
			}

			def key(e KeyEvent) bool {
				return false when !e.down
				return false when disabled || items.len() == 0
				if activates(e) {
					pick(at)
					return true
				}
				let step = rtl() ?? (-1, 1)
				let from = at < 0 ?? (items.len() - 1, at)
				match e.key {
					case Key.Left:
						at = (from - step).max(0).min(items.len() - 1)
					case Key.Right:
						at = (from + step).max(0).min(items.len() - 1)
					default:
						return false
				}
				return true
			}

			def render(ctx RenderContext) {
				lay()
				let palette = look.palette
				let box = frameBox(ctx)
				let (width, height) = (box.right, box.bottom)
				let mark = StrokeStyle{width: 1.5(px)}
				for let (i, block) in row.blocks {
					let slot = row.slot(i, width, height, rtl())
					let last = i == row.blocks.len() - 1
					ctx.draw.fill(Rect{left: slot.left + 2.0, top: 3.0, right: slot.right - 2.0, bottom: height - 3.0}, float(look.metrics.radius), palette.surface.mix(palette.hover)) when i == over && !last && !disabled
					paint.drawBlock(ctx.draw, block, slot, Align{horizontal: Alignment.Center, vertical: Alignment.Center}, rtl(), ctx.scale)
					drawFocusRing(ctx, look, Rect{left: slot.left + 3.0, top: 3.0, right: slot.right - 3.0, bottom: height - 3.0}, float(look.metrics.radius)) when i == at && focusVisible
					continue when last
					// The mark between this step and the next: an angle pointing onward.
					let edge = rtl() ?? (slot.left, slot.right)
					let onward = rtl() ?? (-3.0, 3.0)
					let middle = height / 2.0
					let tip = new Point(edge + onward / 2.0, middle)
					ctx.draw.stroke(new Line(new Point(edge - onward / 2.0, middle - 4.0), tip), palette.foregroundMuted, mark)
					ctx.draw.stroke(new Line(tip, new Point(edge - onward / 2.0, middle + 4.0)), palette.foregroundMuted, mark)
				}
			}
		}

		view {}

		style {
			ControlStyle
			height = theme.metrics.controlHeight
		}
	}
}
