partial module std.ui.components {
	use (
		std.math.geom::(Corners, Edges, Line, Point, Size, StrokeStyle)
		std.ui::(Key, KeyEvent, Limit, MouseButton, PointerEvent, PointerPhase, RenderContext, Theme, UI)
		std.ui.paint
		std.ui.styles::*
		std.units::(Extent, Pixels)
	)

	// One step of `Breadcrumbs`: a part of it, the steps in order. Its title is drawn in
	// its style's `foreground`: muted, the plain one on the step one is at (`last`). An
	// earlier step is lit under the pointer and a press on it tells `onPick` its index;
	// `ringed` is the step the keys are on while the keyboard focus shows.
	internal component Crumb {
		type {
			@input(value = true)
			label string = ""

			@input
			index int = 0

			@input
			@state
			last bool = false

			@input
			@state
			ringed bool = false

			@input
			onPick ?(def(int)) = none

			block ?paint.TextBlock = none
			look  Theme = UI.theme()

			def current() paint.TextBlock {
				let made = labelBlock(block, label, style.font, em * 1(px), style.foreground, style.paragraph, look.palette.foregroundMuted, decoration = style.decoration)
				block = made
				return made
			}

			def measure(limit Limit) Size<Pixels> {
				return current().measure(limit)
			}

			def pointer(e PointerEvent) bool {
				return false when disabled || e.phase != PointerPhase.Down || e.button != MouseButton.Left
				let tell = onPick
				tell(index) unless tell is none
				return true
			}

			def render(ctx RenderContext) {
				ctx.outerShadows()
				ctx.background()
				ctx.borders()
				paint.drawBlock(ctx.draw, current(), ctx.geometry.content.toFloat(), Align{horizontal: Alignment.Center, vertical: Alignment.Center}, ctx.direction == Direction.RightToLeft, ctx.scale)
				ctx.innerShadows()
			}
		}

		view {}

		style {
			Box
			Control
			// With the row's own padding and the mark between two steps, a step takes its
			// title and two and a half units on each side.
			padding    = new Edges<Extent>(0(px), theme.metrics.unit * 2.5 - 2(px))
			radius     = new Corners<Extent>(theme.metrics.radius)
			foreground = theme.palette.foregroundMuted
			on         = {
				hover:    {background: new BackgroundFill(theme.palette.surface.mix(theme.palette.hover))},
				last:     {foreground: theme.palette.foreground, background: new BackgroundFill([])},
				ringed:   {outline: focusRing()},
				disabled: {foreground: theme.palette.foregroundDisabled},
			}
		}
	}

	// The mark between two steps of `Breadcrumbs`: an angle pointing onward, in its
	// style's `foreground`.
	internal component CrumbMark {
		type {
			look Theme = UI.theme()

			def render(ctx RenderContext) {
				let box = frameBox(ctx)
				let ink = inkOf(style.foreground, look.palette.foregroundMuted)
				let mark = StrokeStyle{width: 1.5(px)}
				let onward = ctx.direction == Direction.RightToLeft ?? (-3.0, 3.0)
				let (edge, middle) = (box.right / 2.0, box.bottom / 2.0)
				let tip = new Point(edge + onward / 2.0, middle)
				ctx.draw.stroke(new Line(new Point(edge - onward / 2.0, middle - 4.0), tip), ink, mark)
				ctx.draw.stroke(new Line(tip, new Point(edge - onward / 2.0, middle + 4.0)), ink, mark)
			}
		}

		view {}

		style {
			Box
			Foreground
			Interaction
			width      = 4(px)
			foreground = theme.palette.foregroundMuted
			hitTest    = HitTest.None
		}
	}

	// Where something is, as the steps that lead to it:
	// `Breadcrumbs(items = ["src", "ui", "main.adm"], onSelect = open)`. The last step is
	// where one is; a press on an earlier one picks it. With the focus, Left and Right
	// move between the steps and Space or Enter picks the one the keys are on.
	component Breadcrumbs {
		type {
			// The steps, the outermost first.
			@input(value = true)
			items string[] = []

			// Runs with a step's index when the user picks it.
			@input
			onSelect ?(def(int)) = none

			// Tells every listener which step was chosen, after the handler ran: heard with
			// `@on(Breadcrumbs.selected)`.
			@emit()
			def selected(index int) int {
				return index
			}

			// The step the keys are on, -1 for none.
			at int = -1

			// Whether it is laid out right to left.
			def rtl() bool {
				return style.geom.direction == Direction.RightToLeft
			}

			def new() {
				focusable = true
				tabStop   = true
			}

			// Picks the step as a click on it does; the last one is where one is already.
			def pick(index int) {
				return when disabled || index < 0 || index >= items.len() - 1
				let tell = onSelect
				tell(index) unless tell is none
				selected(index)
			}

			def key(e KeyEvent) bool {
				return false when !e.down
				return false when disabled || items.len() == 0
				if activates(e) {
					pick(at)
					return true
				}
				let step = rtl() ?? (-1, 1)
				let from = at < 0 ?? (items.len() - 1, at)
				match e.key {
					case Key.Left:
						at = (from - step).max(0).min(items.len() - 1)
					case Key.Right:
						at = (from + step).max(0).min(items.len() - 1)
					default:
						return false
				}
				return true
			}
		}

		// Its parts: a `Crumb` per step and a `CrumbMark` between two of them.
		view {
			for let (i, item) in items {
				Crumb(item, index = i, last = i == items.len() - 1, ringed = focusVisible && i == at, onPick = pick)
				if i < items.len() - 1 {
					CrumbMark()
				}
			}
		}

		style {
			ControlStyle
			Layout
			height = theme.metrics.controlHeight
			// The room around a step's fill.
			padding = new Edges<Extent>(3(px), 2(px))
			arrange = Arrange.Row
			align   = Align{horizontal: Alignment.Start, vertical: Alignment.Fill}
		}
	}
}
