partial module std.ui.components {
	use (
		std.math.geom::(Axes, Corners, Edges, Rect, Size)
		std.ui::(Action, Limit, RenderContext, Theme, UI)
		std.ui.paint
		std.ui.runtime::drawIcon
		std.ui.styles::*
		std.units::(Extent, Pixels)
	)

	// The style of a `Button`: a raised surface with an edge, a step further from it
	// under the pointer and while held down, and a ring while it shows the keyboard focus.
	style ButtonStyle {
		Box
		Control
		Layout
		// What `start` and `end` give stands in a row with the label.
		arrange = Arrange.Row
		gap = new Axes<Extent>(theme.metrics.unit * 1.5)
		// The edge is part of the box: the padding is what is left of the room beside the label.
		padding = new Edges<Extent>(0(px), theme.metrics.unit * 3.0 - theme.metrics.borderWidth)
		minHeight = theme.metrics.controlHeight
		radius = new Corners<Extent>(theme.metrics.radius)
		align = Align{horizontal: Alignment.Center, vertical: Alignment.Center}
		background = new BackgroundFill(theme.palette.surfaceRaised)
		border = controlEdge(theme.palette.border)
		foreground = theme.palette.foreground
		on = {
			hover:        {background: raisedFill(theme.palette.hover), border: controlEdge(theme.palette.borderStrong)},
			pressed:      {background: raisedFill(theme.palette.pressed)},
			focusVisible: {outline: focusRing()},
			disabled:     {foreground: theme.palette.foregroundDisabled},
		}
	}

	// A control that runs something when pressed: `Button(label = "Save", onClick = save)`.
	// It is as large as its label plus its padding, takes the keyboard focus, and is
	// pressed with the pointer, Space or Enter.
	component Button {
		type {
			// The text on it.
			@input(value = true)
			label string = ""

			// The name of the icon before the label; empty: none.
			@input
			icon string = ""

			// The name of an icon after the label, at the button's end; empty: none.
			@input
			trailing string = ""

			// What stands before the label in place of `icon`, and after it in place of
			// `trailing`: `Button("Sync") { start = view { Spinner() } }`.
			@input
			start ?view = none

			@input
			end ?view = none

			// The icons as looked up last.
			before IconSlot = new IconSlot()
			after  IconSlot = new IconSlot()

			// The action it runs when pressed, an `@action` method of a controller
			// (`Button(action = save)`): its label and icon are the button's where the
			// button gives none, and the button is enabled while the action is.
			@input
			action ?Action = none

			// The label as set last.
			block ?paint.TextBlock = none

			// The theme its text and icons are drawn from.
			look Theme = UI.theme()

			// Runs its action when it is clicked, before `onClick`, and tells every listener:
			// heard with `@on(Button.clicked)`.
			@emit()
			def clicked() {
				let act = action
				if !(act is none) {
					let _ = act.run()
				}
			}

			// Its label: its own, else its action's.
			def shownLabel() string {
				let act = action
				return label when label != "" || act is none
				return act.label
			}

			// Its icon: its own, else its action's.
			def shownIcon() string {
				let act = action
				return icon when icon != "" || act is none
				return act.icon
			}

			// Enabled while its action is.
			def followAction() {
				let act = action
				return when act is none
				let can = act.enabled
				enabled = can when enabled != can
			}

			def current() paint.TextBlock {
				followAction()
				let made = controlLabel(block, shownLabel(), style.font, em * 1(px), style.foreground, style.paragraph, look, !disabled)
				block = made
				return made
			}

			// The room an icon takes beside the label: its square, and a gap when there is
			// a label.
			def iconRoom() float {
				return float(look.metrics.iconSize) + (shownLabel() == "" ?? (0.0, float(look.metrics.unit) * 1.5))
			}

			def measure(limit Limit) Size<Pixels> {
				let text = current().measure(limit)
				let icons = (shownIcon() != "" ?? (iconRoom(), 0.0)) + (trailing != "" ?? (iconRoom(), 0.0))
				return new Size<Pixels>(text.width + icons * 1(px), float(text.height).max(icons > 0.0 ?? (float(look.metrics.iconSize), 0.0)) * 1(px))
			}

			def firstBaseline() ?Pixels {
				return current().firstBaseline()
			}

			// A slot is given: the label and the icons are children in a row.
			def slotted() bool {
				return !(start is none) || !(end is none)
			}

			def render(ctx RenderContext) {
				let palette = look.palette
				ctx.outerShadows()
				ctx.background()
				ctx.borders()
				if slotted() {
					ctx.childNodes()
					ctx.innerShadows()
					return
				}
				// The label between the icons at the two ends of the content box.
				let area = ctx.geometry.content.toFloat()
				let side = float(look.metrics.iconSize)
				let middle = (area.top + area.bottom) / 2.0
				// The label's colour, the disabled one while disabled: the icons take it.
				let ink = inkOf(style.foreground, palette.foreground)
				let rtl = ctx.direction == Direction.RightToLeft
				let (first, last) = (before.get(shownIcon()), after.get(trailing))
				let leadRoom = first is none ?? (0.0, iconRoom())
				let tailRoom = last is none ?? (0.0, iconRoom())
				let text = Rect{left: area.left + (rtl ?? (tailRoom, leadRoom)), top: area.top, right: area.right - (rtl ?? (leadRoom, tailRoom)), bottom: area.bottom}
				// Where the label stands between them: its style's `align`, the middle by
				// default; a list's button puts it at the start.
				paint.drawBlock(ctx.draw, current(), text, style.align, rtl, ctx.scale)
				if !(first is none) {
					let left = rtl ?? (area.right - side, area.left)
					drawIcon(ctx.draw, first, Rect{left: left, top: middle - side / 2.0, right: left + side, bottom: middle + side / 2.0}, ink)
				}
				if !(last is none) {
					let left = rtl ?? (area.left, area.right - side)
					drawIcon(ctx.draw, last, Rect{left: left, top: middle - side / 2.0, right: left + side, bottom: middle + side / 2.0}, ink)
				}
				ctx.childNodes()
				ctx.innerShadows()
			}
		}

		// Its block holds what attaches to it, not what it shows: `Button("Share") {
		// HoverCard() { ... }; ContextMenu() { ... } }`.
		view {
			if slotted() {
				if start is none {
					if shownIcon() != "" {
						Icon(shownIcon())
					}
				} else {
					start()
				}
				if shownLabel() != "" {
					Text(shownLabel())
				}
				if end is none {
					if trailing != "" {
						Icon(trailing)
					}
				} else {
					end()
				}
			}
			children()
		}

		style ButtonStyle
	}
}
