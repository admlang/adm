partial module std.ui.components {
	use (
		std.math.geom::(Corners, Edges, Rect, Size)
		std.ui::(KeyEvent, Limit, PointerEvent, RenderContext, Theme, UI)
		std.ui.paint
		std.ui.runtime::drawIcon
		std.ui.styles::*
		std.units::(Extent, Pixels)
	)

	// The style of a `Button`: a raised surface with an edge, a step further from it
	// under the pointer and while held down, and a ring while it shows the keyboard focus.
	style ButtonStyle {
		Box
		Control
		// The edge is part of the box: the padding is what is left of the room beside the label.
		padding = new Edges<Extent>(0(px), theme.metrics.unit * 3.0 - theme.metrics.borderWidth)
		minHeight = theme.metrics.controlHeight
		radius = new Corners<Extent>(theme.metrics.radius)
		align = Align{horizontal: Alignment.Center, vertical: Alignment.Center}
		background = new BackgroundFill(theme.palette.surfaceRaised)
		border = controlEdge(theme.palette.border)
		on = {
			hover:        {background: raisedFill(theme.palette.hover), border: controlEdge(theme.palette.borderStrong)},
			pressed:      {background: raisedFill(theme.palette.pressed)},
			focusVisible: {outline: focusRing()},
		}
	}

	// A control that runs something when pressed: `Button(label = "Save", onClick = save)`.
	// It is as large as its label plus its padding, takes the keyboard focus, and is
	// pressed with the pointer, Space or Enter.
	component Button {
		type {
			// The text on it.
			@input(value = true)
			label string = ""

			// The name of the icon before the label; empty: none.
			@input
			icon string = ""

			// The name of an icon after the label, at the button's end; empty: none.
			@input
			trailing string = ""

			// The icons as looked up last.
			before IconSlot = new IconSlot()
			after  IconSlot = new IconSlot()

			// Runs when it is pressed.
			@input
			onClick ?(def()) = none

			// An `@action` method to run when it is pressed.
			@input
			action ?(def()) = none

			// The label as set last.
			block ?paint.TextBlock = none

			// The theme its text and icons are drawn from.
			look Theme = UI.theme()

			def new() {
				focusable = true
				tabStop   = true
			}

			// Tells every listener it was activated, after `onClick` ran: heard with
			// `@on(Button.clicked)`.
			@emit()
			def clicked() bool {
				return true
			}

			// Runs what the button is for.
			def press() {
				return when disabled
				let run = onClick
				run() unless run is none
				let command = action
				command() unless command is none
				clicked()
			}

			def current() paint.TextBlock {
				let made = controlLabel(block, label, style.font, style.foreground, style.paragraph, look, !disabled)
				block = made
				return made
			}

			// The room an icon takes beside the label: its square, and a gap when there is
			// a label.
			def iconRoom() float {
				return float(look.metrics.iconSize) + (label == "" ?? (0.0, float(look.metrics.unit) * 1.5))
			}

			def measure(limit Limit) Size<Pixels> {
				let text = current().measure(limit)
				let icons = (icon != "" ?? (iconRoom(), 0.0)) + (trailing != "" ?? (iconRoom(), 0.0))
				return new Size<Pixels>(text.width + icons * 1(px), float(text.height).max(icons > 0.0 ?? (float(look.metrics.iconSize), 0.0)) * 1(px))
			}

			def firstBaseline() ?Pixels {
				return baselineOf(current())
			}

			def pointer(e PointerEvent) bool {
				return pressRuns(e, style.geom, !disabled, press)
			}

			def key(e KeyEvent) bool {
				return false when !e.down
				return keyRuns(e, !disabled, press)
			}

			def render(ctx RenderContext) {
				let palette = look.palette
				ctx.outerShadows()
				ctx.background()
				ctx.borders()
				// The label between the icons at the two ends of the content box.
				let area = ctx.geometry.content.toFloat()
				let side = float(look.metrics.iconSize)
				let middle = (area.top + area.bottom) / 2.0
				let ink = !disabled ?? (palette.foreground, palette.foregroundDisabled)
				let rtl = ctx.direction == Direction.RightToLeft
				let (first, last) = (before.get(icon), after.get(trailing))
				let start = first is none ?? (0.0, iconRoom())
				let end = last is none ?? (0.0, iconRoom())
				let text = Rect{left: area.left + (rtl ?? (end, start)), top: area.top, right: area.right - (rtl ?? (start, end)), bottom: area.bottom}
				paint.drawBlock(ctx.draw, current(), text, Align{horizontal: Alignment.Center, vertical: Alignment.Center}, rtl, ctx.scale)
				if !(first is none) {
					let left = rtl ?? (area.right - side, area.left)
					drawIcon(ctx.draw, first, Rect{left: left, top: middle - side / 2.0, right: left + side, bottom: middle + side / 2.0}, ink)
				}
				if !(last is none) {
					let left = rtl ?? (area.left, area.right - side)
					drawIcon(ctx.draw, last, Rect{left: left, top: middle - side / 2.0, right: left + side, bottom: middle + side / 2.0}, ink)
				}
				ctx.childNodes()
				ctx.innerShadows()
			}
		}

		view {}

		style ButtonStyle
	}
}
