partial module std.ui.components {
	use (
		std.ui::RenderContext
		std.ui.styles::*
	)

	// A box the application draws in itself: `Canvas(draw = paint)`, with
	// `def paint(ctx RenderContext)`. `ctx.draw` takes the drawing in the component's own
	// logical pixels, (0, 0) at its top-left corner; `ctx.geometry.frame` says how large it
	// is. It fills the room it is given unless its style sets a size. It is drawn again
	// when something in the window changes; `animated = true` draws it on every frame the
	// display shows.
	component Canvas {
		type {
			// What draws it.
			@input(value = true)
			draw ?(def(RenderContext)) = none

			// Draws it again on every frame the display shows: for a picture that moves.
			@input
			animated bool = false

			def render(ctx RenderContext) {
				ctx.outerShadows()
				ctx.background()
				ctx.borders()
				let run = draw
				run(ctx) unless run is none
				ctx.childNodes()
				ctx.innerShadows()
				redraw() when animated
			}
		}

		view {}

		style {
			PanelStyle
			width  = fill
			height = fill
		}
	}
}
