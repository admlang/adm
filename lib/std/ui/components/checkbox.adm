partial module std.ui.components {
	use (
		std.math.geom::Size
		std.ui::(KeyEvent, Limit, PointerEvent, RenderContext, Theme, UI)
		std.ui.paint
		std.ui.styles::*
		std.units::Pixels
	)

	// A box that is checked or not, with a label after it:
	// `Checkbox(checked = agreed, label = "I agree", onChange = setAgreed)`. A click on the
	// box or the label, Space or Enter changes it.
	component Checkbox {
		type {
			// Whether it is checked.
			@input(value = true, bind = true)
			@state
			checked bool = false

			// The text after the box; empty: the box alone.
			@input
			label string = ""

			// Runs with the new state when the user changes it.
			@input
			onChange ?(def(bool)) = none

			// Tells every listener its new value, after the handler ran: heard with
			// `@on(Checkbox.changed)`.
			@emit()
			def changed(now bool) bool {
				return now
			}

			block ?paint.TextBlock = none
			look  Theme = UI.theme()

			def new() {
				focusable = true
				tabStop   = true
			}

			// Changes the state as a click does.
			def toggle() {
				return when disabled
				checked = !checked
				let tell = onChange
				tell(checked) unless tell is none
				changed(checked)
			}

			def current() paint.TextBlock {
				let made = controlLabel(block, label, style.font, style.foreground, style.paragraph, look, !disabled)
				block = made
				return made
			}

			def measure(limit Limit) Size<Pixels> {
				return markedSize(label, current(), markSide, limit)
			}

			def pointer(e PointerEvent) bool {
				return pressRuns(e, style.geom, !disabled, toggle)
			}

			def key(e KeyEvent) bool {
				return false when !e.down
				return keyRuns(e, !disabled, toggle)
			}

			def render(ctx RenderContext) {
				let palette = look.palette
				let box = markBox(ctx, markSide, markSide)
				let radius = float(look.metrics.radius).min(markSide / 4.5)
				ctx.draw.fill(box, radius, markFill(palette, checked, hover, pressed, !disabled))
				if !checked {
					drawEdge(ctx, look, box, radius, hover && !disabled)
				} else {
					drawTick(ctx, box.left, box.top, markSide, palette.onAccent)
				}
				drawMarkLabel(ctx, label, current(), markSide)
				drawFocusRing(ctx, look, box, radius) when focusVisible
			}
		}

		view {}

		style ControlStyle
	}
}
