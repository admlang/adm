partial module std.ui.components {
	use (
		std.math.geom::Corners
		std.ui::(RenderContext, Theme, UI)
		std.ui.styles::*
		std.units::Extent
	)

	// The box of a `Checkbox`: its part named `box`. It is told the control's states and
	// draws in its style's `foreground` a dash while `indeterminate`, else a tick while `on`.
	internal component CheckMark {
		type {
			@input
			@state
			on bool = false

			// The control is neither checked nor unchecked: the box is filled as when on
			// (the view passes `on` too) and draws a dash in place of the tick.
			@input
			@state
			indeterminate bool = false

			// The pointer is over the control, and holds it.
			@input
			@state
			over bool = false

			@input
			@state
			held bool = false

			// The control shows the keyboard focus.
			@input
			@state
			ringed bool = false

			look Theme = UI.theme()

			def render(ctx RenderContext) {
				ctx.outerShadows()
				ctx.background()
				ctx.borders()
				let box = frameBox(ctx)
				let ink = inkOf(style.foreground, look.palette.onAccent)
				if indeterminate {
					drawDash(ctx, box.left, box.top, box.right, ink)
				} else if on {
					drawTick(ctx, box.left, box.top, box.right, ink)
				}
				ctx.innerShadows()
			}
		}

		view {}

		style {
			MarkStyle
			width  = markSide * 1(px)
			height = markSide * 1(px)
			radius = new Corners<Extent>(float(theme.metrics.radius).min(markSide / 4.5) * 1(px))
		}
	}

	// A box that is checked or not, with a label after it:
	// `Checkbox(checked = agreed, label = "I agree", onChange = setAgreed)`. A click on the
	// box or the label, Space or Enter changes it. A box that stands for several values,
	// some checked and some not, is `indeterminate` and shows a dash; a click on it checks
	// it: `Checkbox(checked = all, indeterminate = some, label = "Files")`.
	component Checkbox {
		type {
			// Whether it is checked.
			@input(value = true, bind = true)
			@state
			checked bool = false

			// Neither checked nor unchecked: the box is filled as when checked and shows a
			// dash in place of the tick, whatever `checked` holds. A click clears it and
			// checks the box; the caller sets it again when its values disagree again.
			@input(bind = true)
			@state
			indeterminate bool = false

			// The text after the box; empty: the box alone.
			@input
			label string = ""

			// Runs with the new state when the user changes it.
			@input
			onChange ?(def(bool)) = none

			// Tells every listener its new value, after the handler ran: heard with
			// `@on(Checkbox.changed)`.
			@emit()
			def changed(now bool) bool {
				return now
			}


			// Changes the state as a click does: an indeterminate box becomes checked, any
			// other flips.
			def toggle() {
				return when disabled
				if indeterminate {
					indeterminate = false
					checked       = true
				} else {
					checked = !checked
				}
				let tell = onChange
				tell(checked) unless tell is none
				changed(checked)
			}

			// A click flips it.
			def clicked() {
				toggle()
			}
		}

		// Its parts: `box`, the box with its tick, and `text`, the label.
		view {
			CheckMark(ref = box, on = checked || indeterminate, indeterminate = indeterminate, over = hover, held = pressed, ringed = focusVisible)
			if label != "" {
				Text(label, ref = text)
			}
		}

		style MarkedStyle
	}
}
