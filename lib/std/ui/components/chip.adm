partial module std.ui.components {
	use (
		std.math.geom::(Axes, Corners, Edges)
		std.ui::(Key, KeyEvent, PointerEvent, RenderContext, Theme, UI)
		std.ui.styles::*
		std.units::Extent
	)

	// The side of the cross that removes a `Chip`, in logical pixels.
	internal const chipCross = 14.0

	// The cross of a `Chip`: its part named `cross`, drawn in its style's `foreground`: the
	// muted one, the disabled one while the chip is not enabled. The chip takes the
	// presses on it and around it.
	internal component ChipCross {
		type {
			look Theme = UI.theme()

			def render(ctx RenderContext) {
				let box = frameBox(ctx)
				drawCross(ctx, box.left, box.top, box.right, inkOf(style.foreground, look.palette.foregroundMuted))
			}
		}

		view {}

		style {
			Box
			Foreground
			Interaction
			width      = chipCross * 1(px)
			height     = chipCross * 1(px)
			foreground = theme.palette.foregroundMuted
			hitTest    = HitTest.None
			on         = {
				disabled: {foreground: theme.palette.foregroundDisabled},
			}
		}
	}

	// A small labelled token: a tag, a filter, a picked item. `Chip(label = "rust")`;
	// with `onRemove` it has a cross at its end that runs it, and Backspace or Delete do
	// the same while it has the focus; with `onClick` a press on it runs that.
	component Chip {
		type {
			// The text on it.
			@input(value = true)
			label string = ""

			// Runs when it is pressed.
			@input
			onClick ?(def()) = none

			// Runs when its cross is pressed; none: it has no cross.
			@input
			onRemove ?(def()) = none

			// Tells every listener its cross was pressed, after the handler ran: heard with
			// `@on(Chip.removed)`.
			@emit()
			def removed() bool {
				return true
			}

			look Theme = UI.theme()

			def new() {
				focusable = true
				tabStop   = true
			}

			// Tells every listener it was activated, after `onClick` ran: heard with
			// `@on(Chip.clicked)`.
			@emit()
			def clicked() bool {
				return true
			}

			def press() {
				let run = onClick
				run() unless run is none
				clicked()
			}

			def remove() {
				let run = onRemove
				run() unless run is none
				removed()
			}

			// Whether a point of the component is on the cross or beside it, up to the
			// chip's end.
			def onCross(x float) bool {
				return false when onRemove is none
				let wide = float(style.geom.frame.width)
				let room = chipCross + float(look.metrics.unit) * 2.0
				return style.geom.direction == Direction.RightToLeft ?? (x < room, x >= wide - room)
			}

			def pointer(e PointerEvent) bool {
				return pressRuns(e, style.geom, !disabled, remove) when onCross(float(e.position.x))
				return pressRuns(e, style.geom, !disabled, press)
			}

			def key(e KeyEvent) bool {
				return false when !e.down
				if !disabled && !(onRemove is none) && (e.key := Key.Backspace || Key.Delete) {
					remove()
					return true
				}
				return keyRuns(e, !disabled, press)
			}
		}

		// Its parts: `text`, the label, and `cross`, what removes it.
		view {
			Text(label, ref = text)
			if !(onRemove is none) {
				ChipCross(ref = cross)
			}
		}

		// A raised surface with an edge, round at its ends. Under the pointer and while
		// held down it is a step further only when a press on it does something.
		style {
			Box
			Control
			Layout
			padding    = new Edges<Extent>(2(px) - theme.metrics.borderWidth, theme.metrics.unit * 2.0 - theme.metrics.borderWidth)
			radius     = new Corners<Extent>(1000(px))
			arrange    = Arrange.Row
			gap        = new Axes<Extent>(theme.metrics.unit)
			align      = Align{horizontal: Alignment.Start, vertical: Alignment.Center}
			background = new BackgroundFill(theme.palette.surfaceRaised)
			border     = controlEdge(theme.palette.border)
			on         = {
				hover:        {background: new BackgroundFill(self.onClick is none ?? (theme.palette.surfaceRaised, theme.palette.surfaceRaised.mix(theme.palette.hover)))},
				pressed:      {background: new BackgroundFill(self.onClick is none ?? (theme.palette.surfaceRaised, theme.palette.surfaceRaised.mix(theme.palette.pressed)))},
				focusVisible: {outline: focusRing()},
			}
		}
	}
}
