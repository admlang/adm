partial module std.ui.components {
	use (
		std.gfx.canvas
		std.math.geom::(Corners, Edges, Rect, Size)
		std.ui::(Key, KeyEvent, Limit, PointerEvent, RenderContext, Theme, UI)
		std.ui.paint
		std.ui.styles::*
		std.units::(Extent, Pixels)
	)

	// The side of the cross that removes a `Chip`, in logical pixels.
	internal const chipCross = 14.0

	// A small labelled token: a tag, a filter, a picked item. `Chip(label = "rust")`;
	// with `onRemove` it has a cross at its end that runs it, and Backspace or Delete do
	// the same while it has the focus; with `onClick` a press on it runs that.
	component Chip {
		type {
			// The text on it.
			@input(value = true)
			label string = ""

			// Runs when it is pressed.
			@input
			onClick ?(def()) = none

			// Runs when its cross is pressed; none: it has no cross.
			@input
			onRemove ?(def()) = none

			// Tells every listener its cross was pressed, after the handler ran: heard with
			// `@on(Chip.removed)`.
			@emit()
			def removed() bool {
				return true
			}

			block ?paint.TextBlock = none
			look  Theme = UI.theme()

			def new() {
				focusable = true
				tabStop   = true
			}

			def current() paint.TextBlock {
				let made = controlLabel(block, label, style.font, style.foreground, style.paragraph, look, !disabled)
				block = made
				return made
			}

			// The room the cross takes after the label.
			def crossRoom() float {
				return onRemove is none ?? (0.0, chipCross + float(look.metrics.unit))
			}

			def measure(limit Limit) Size<Pixels> {
				let text = current().measure(limit)
				return new Size<Pixels>(text.width + crossRoom() * 1(px), text.height)
			}

			def firstBaseline() ?Pixels {
				return baselineOf(current())
			}

			// Tells every listener it was activated, after `onClick` ran: heard with
			// `@on(Chip.clicked)`.
			@emit()
			def clicked() bool {
				return true
			}

			def press() {
				let run = onClick
				run() unless run is none
				clicked()
			}

			def remove() {
				let run = onRemove
				run() unless run is none
				removed()
			}

			// Whether a point of the component is on the cross.
			def onCross(x float) bool {
				return false when onRemove is none
				let wide = float(style.geom.frame.width)
				let room = crossRoom() + float(look.metrics.unit)
				return style.geom.direction == Direction.RightToLeft ?? (x < room, x >= wide - room)
			}

			def pointer(e PointerEvent) bool {
				return pressRuns(e, style.geom, !disabled, remove) when onCross(float(e.position.x))
				return pressRuns(e, style.geom, !disabled, press)
			}

			def key(e KeyEvent) bool {
				return false when !e.down
				if !disabled && !(onRemove is none) && (e.key := Key.Backspace || Key.Delete) {
					remove()
					return true
				}
				return keyRuns(e, !disabled, press)
			}

			def render(ctx RenderContext) {
				let palette = look.palette
				let box = frameBox(ctx)
				let round = box.bottom / 2.0
				let fill = palette.surfaceRaised
				fill = fill.mix(pressed ?? (palette.pressed, palette.hover)) when !disabled && (hover || pressed) && !(onClick is none)
				ctx.draw.fill(box, round, fill)
				let edge = canvas.Border{width: look.metrics.borderWidth, paint: palette.border}
				ctx.draw.stroke(box, new Edges<canvas.Border>(edge), new Corners<Pixels>(round * 1(px)))
				let rtl = ctx.direction == Direction.RightToLeft
				let area = ctx.geometry.content.toFloat()
				let room = crossRoom()
				let text = rtl ?? (Rect{left: area.left + room, top: area.top, right: area.right, bottom: area.bottom}, Rect{left: area.left, top: area.top, right: area.right - room, bottom: area.bottom})
				paint.drawBlock(ctx.draw, current(), text, Align{horizontal: Alignment.Start, vertical: Alignment.Center}, rtl, ctx.scale)
				if room > 0.0 {
					// The cross, in a square at the end.
					let left = rtl ?? (area.left, area.right - chipCross)
					let top = (box.bottom - chipCross) / 2.0
					drawCross(ctx, left, top, chipCross, !disabled ?? (palette.foregroundMuted, palette.foregroundDisabled))
				}
				drawFocusRing(ctx, look, box, round) when focusVisible
			}
		}

		view {}

		style {
			ControlStyle
			padding = new Edges<Extent>(2(px), theme.metrics.unit * 2.0)
		}
	}
}
