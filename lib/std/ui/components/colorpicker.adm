partial module std.ui.components {
	use (
		std.gfx.canvas
		std.gfx.color::(Color, RGBA, parse)
		std.math.geom::(Axes, Circle, Corners, Edges, Point, Rect)
		std.ui::(Key, KeyEvent, MouseButton, PointerEvent, PointerPhase, RenderContext)
		std.ui.styles::*
		std.units::Extent
	)

	// The colour of hue `hue` (degrees), saturation `sat` and value `val` (0 to 1), with
	// alpha `alpha`.
	internal def hsvColor(hue float, sat float, val float, alpha uint8 = 255) Color {
		let h = (hue % 360.0 + 360.0) % 360.0 / 60.0
		let c = val * sat
		let x = c * (1.0 - (h % 2.0 - 1.0).abs())
		let m = val - c
		let (r, g, b) = (0.0, 0.0, 0.0)
		if h < 1.0 {
			(r, g, b) = (c, x, 0.0)
		} else if h < 2.0 {
			(r, g, b) = (x, c, 0.0)
		} else if h < 3.0 {
			(r, g, b) = (0.0, c, x)
		} else if h < 4.0 {
			(r, g, b) = (0.0, x, c)
		} else if h < 5.0 {
			(r, g, b) = (x, 0.0, c)
		} else {
			(r, g, b) = (c, 0.0, x)
		}
		let toByte = def (v float) uint8 {
			return uint8(((v + m) * 255.0).round().max(0.0).min(255.0))
		}
		return new Color(RGBA{r: toByte(r), g: toByte(g), b: toByte(b), a: alpha})
	}

	// The hue (degrees), saturation and value of `color`; `hue` when it has none (a grey).
	internal def hsvOf(color Color, hue float) (float, float, float) {
		let (r, g, b) = (float(color.red) / 255.0, float(color.green) / 255.0, float(color.blue) / 255.0)
		let most = r.max(g).max(b)
		let least = r.min(g).min(b)
		let span = most - least
		let sat = most > 0.0 ?? (span / most, 0.0)
		return (hue, sat, most) when span <= 0.0
		let h = 0.0
		if most == r {
			h = 60.0 * (((g - b) / span) % 6.0)
		} else if most == g {
			h = 60.0 * ((b - r) / span + 2.0)
		} else {
			h = 60.0 * ((r - g) / span + 4.0)
		}
		return ((h + 360.0) % 360.0, sat, most)
	}

	// `color` as `#rrggbb`, with `aa` after it when `alpha` and it is not opaque.
	internal def hexText(color Color, alpha bool) string {
		let text = "#{color.red.hex(2)}{color.green.hex(2)}{color.blue.hex(2)}"
		return text when !alpha || color.alpha == 255
		return text + color.alpha.hex(2)
	}

	// Squares of two greys under a colour that may be transparent, `side` pixels each.
	internal def drawChecks(ctx RenderContext, box Rect, side float) {
		ctx.draw.fill(box, new Color(RGBA{r: 255, g: 255, b: 255, a: 255}))
		let grey = new Color(RGBA{r: 204, g: 204, b: 204, a: 255})
		let rows = int((box.bottom - box.top) / side) + 1
		let columns = int((box.right - box.left) / side) + 1
		for let row = 0; row < rows; row++ {
			for let column = row % 2; column < columns; column += 2 {
				let left = box.left + float(column) * side
				let top = box.top + float(row) * side
				ctx.draw.fill(Rect{left: left, top: top, right: (left + side).min(box.right), bottom: (top + side).min(box.bottom)}, grey)
			}
		}
	}

	// The marker of a picked point: a white ring round the colour.
	internal def drawMarker(ctx RenderContext, x float, y float, color Color) {
		ctx.draw.fill(new Circle(new Point(x, y), 7.0), new Color(RGBA{r: 255, g: 255, b: 255, a: 255}))
		ctx.draw.fill(new Circle(new Point(x, y), 5.0), color.withAlpha(255))
	}

	// The saturation-value square of a `ColorPicker`: its part named `plane`, the hue at
	// its top-right corner, white at the top-left, black along the bottom. A press or a
	// drag picks the point under the pointer; with the focus the arrows move it by a
	// hundredth, with Shift by a tenth.
	internal component ColorPlane {
		type {
			@input
			hue float = 0.0

			@input
			sat float = 0.0

			@input
			val float = 1.0

			@input
			onPick ?(def(float, float)) = none

			dragging bool

			def new() {
				focusable = true
				tabStop   = true
			}

			def pick(sat float, val float) {
				let run = onPick
				run(sat.max(0.0).min(1.0), val.max(0.0).min(1.0)) unless run is none
			}

			def pickAt(e PointerEvent) {
				let frame = style.geom.frame
				let (wide, high) = (float(frame.width).max(1.0), float(frame.height).max(1.0))
				pick(float(e.position.x) / wide, 1.0 - float(e.position.y) / high)
			}

			def pointer(e PointerEvent) bool {
				return false when disabled
				match e.phase {
					case PointerPhase.Down:
						return false when e.button != MouseButton.Left
						e.capture()
						dragging = true
						pickAt(e)
						return true
					case PointerPhase.Move:
						return false when !dragging
						pickAt(e)
						return true
					case PointerPhase.Up, PointerPhase.Cancel:
						let was = dragging
						dragging = false
						return was
					default:
						return false
				}
			}

			def key(e KeyEvent) bool {
				return false when !e.down || disabled
				let by = e.modifiers.shift ?? (0.1, 0.01)
				match e.key {
					case Key.Left:
						pick(sat - by, val)
					case Key.Right:
						pick(sat + by, val)
					case Key.Up:
						pick(sat, val + by)
					case Key.Down:
						pick(sat, val - by)
					default:
						return false
				}
				return true
			}

			def render(ctx RenderContext) {
				let box = frameBox(ctx)
				let white = new Color(RGBA{r: 255, g: 255, b: 255, a: 255})
				let black = new Color(RGBA{r: 0, g: 0, b: 0, a: 255})
				ctx.draw.fill(box, canvas.linear(new Point(box.left, 0.0), new Point(box.right, 0.0), [white, hsvColor(hue, 1.0, 1.0)]))
				ctx.draw.fill(box, canvas.linear(new Point(0.0, box.top), new Point(0.0, box.bottom), [black.withAlpha(0), black]))
				drawMarker(ctx, box.left + sat * (box.right - box.left), box.top + (1.0 - val) * (box.bottom - box.top), hsvColor(hue, sat, val))
				ctx.borders()
			}
		}

		view {}

		style {
			Box
			Decorated
			Interaction
			width  = fill
			height = 150(px)
			radius = new Corners<Extent>(theme.metrics.radius)
			on     = {
				focusVisible: {outline: focusRing()},
			}
		}
	}

	// The kind of a `ColorStrip`.
	internal enum ColorStripKind {
		// The hues round the circle, red at both ends.
		Hue,
		// The colour from transparent to opaque, over squares.
		Alpha,
	}

	// A strip of a `ColorPicker` that picks one number, 0 at its start to 1 at its end:
	// the hue (`hue`) or the opacity (`alpha`). A press or a drag picks the point under the
	// pointer; with the focus the arrows move it by a hundredth, with Shift by a tenth,
	// Home and End to its ends.
	internal component ColorStrip {
		type {
			@input
			kind ColorStripKind = ColorStripKind.Hue

			// Where the marker sits, 0 to 1.
			@input
			along float = 0.0

			// The colour an alpha strip fades.
			@input
			color Color = new Color(RGBA{r: 0, g: 0, b: 0, a: 255})

			@input
			onPick ?(def(float)) = none

			dragging bool

			def new() {
				focusable = true
				tabStop   = true
			}

			def rtl() bool {
				return style.geom.direction == Direction.RightToLeft
			}

			def pick(at float) {
				let run = onPick
				run(at.max(0.0).min(1.0)) unless run is none
			}

			def pickAt(e PointerEvent) {
				let at = float(e.position.x) / float(style.geom.frame.width).max(1.0)
				pick(rtl() ?? (1.0 - at, at))
			}

			def pointer(e PointerEvent) bool {
				return false when disabled
				match e.phase {
					case PointerPhase.Down:
						return false when e.button != MouseButton.Left
						e.capture()
						dragging = true
						pickAt(e)
						return true
					case PointerPhase.Move:
						return false when !dragging
						pickAt(e)
						return true
					case PointerPhase.Up, PointerPhase.Cancel:
						let was = dragging
						dragging = false
						return was
					default:
						return false
				}
			}

			def key(e KeyEvent) bool {
				return false when !e.down || disabled
				let by = e.modifiers.shift ?? (0.1, 0.01)
				let forward = rtl() ?? (-by, by)
				match e.key {
					case Key.Left:
						pick(along - forward)
					case Key.Right:
						pick(along + forward)
					case Key.Down:
						pick(along - by)
					case Key.Up:
						pick(along + by)
					case Key.Home:
						pick(0.0)
					case Key.End:
						pick(1.0)
					default:
						return false
				}
				return true
			}

			def render(ctx RenderContext) {
				let box = frameBox(ctx)
				let (from, to) = (new Point(rtl() ?? (box.right, box.left), 0.0), new Point(rtl() ?? (box.left, box.right), 0.0))
				if kind == ColorStripKind.Hue {
					let hues Color[]
					for let i = 0; i <= 6; i++ {
						hues.push(hsvColor(float(i) * 60.0, 1.0, 1.0))
					}
					ctx.draw.fill(box, canvas.linear(from, to, hues))
				} else {
					drawChecks(ctx, box, (box.bottom - box.top) / 2.0)
					ctx.draw.fill(box, canvas.linear(from, to, [color.withAlpha(0), color.withAlpha(255)]))
				}
				let x = box.left + (rtl() ?? (1.0 - along, along)) * (box.right - box.left)
				drawMarker(ctx, x, (box.top + box.bottom) / 2.0, kind == ColorStripKind.Hue ?? (hsvColor(along * 360.0, 1.0, 1.0), color.withAlpha(uint8((along * 255.0).round()))))
				ctx.borders()
			}
		}

		view {}

		style {
			Box
			Decorated
			Interaction
			width  = fill
			height = 14(px)
			radius = new Corners<Extent>(7(px))
			on     = {
				focusVisible: {outline: focusRing()},
			}
		}
	}

	// A square of a colour: a `ColorPicker`'s swatches and its preview, and a
	// `ColorWell`'s face. Transparent colours show squares through them; `ringed` draws
	// the ring a picked swatch has.
	internal component ColorSquare {
		type {
			@input(value = true)
			color Color = new Color(RGBA{r: 0, g: 0, b: 0, a: 255})

			@input
			@state
			ringed bool = false

			def render(ctx RenderContext) {
				let box = frameBox(ctx)
				drawChecks(ctx, box, 4.0) when color.alpha < 255
				ctx.draw.fill(box, color)
				ctx.borders()
			}
		}

		view {}

		style {
			Box
			Control
			width  = 20(px)
			height = 20(px)
			radius = new Corners<Extent>(4(px))
			border = controlEdge(theme.palette.border)
			on     = {
				ringed:       {outline: focusRing()},
				focusVisible: {outline: focusRing()},
			}
		}
	}

	// A colour picked on a square of saturation and value, a strip of hues and one of
	// opacity, typed as hex, or taken from swatches:
	// `ColorPicker(value = accent, swatches = brand, onChange = setAccent)`. The hue is
	// kept while the colour is a grey, so dragging through black or white loses nothing.
	component ColorPicker {
		type {
			// The colour.
			@input(value = true, bind = true)
			@state
			value Color = new Color(RGBA{r: 0, g: 0, b: 0, a: 255})

			// Whether it picks an opacity too; false: the colour is opaque.
			@input
			alpha bool = true

			// Colours to pick with one click, in order.
			@input
			swatches Color[] = []

			// Runs with the new colour when the user changes it.
			@input
			onChange ?(def(Color)) = none

			// Tells every listener its new colour, after the handler ran: heard with
			// `@on(ColorPicker.changed)`.
			@emit()
			def changed(color Color) Color {
				return color
			}

			// The hue, saturation and value shown, and the colour they were read from: a
			// colour set from outside is read again.
			hue  float = 0.0
			sat  float = 0.0
			val  float = 0.0
			seen ?Color = none

			// Brings hue, saturation and value in step with `value` when it changed.
			def sync() {
				let held = seen
				return when !(held is none) && held == value
				(hue, sat, val) = hsvOf(value, hue)
				seen = value
			}

			def opacityAlong() float {
				return float(value.alpha) / 255.0
			}

			// Sets the colour as the user does, and reports it when it differs.
			def set(color Color) {
				let next = alpha ?? (color, color.withAlpha(255))
				return when next == value
				value = next
				seen  = next
				let tell = onChange
				tell(next) unless tell is none
				changed(next)
			}

			def pickPlane(s float, v float) {
				sync()
				(sat, val) = (s, v)
				set(hsvColor(hue, s, v, value.alpha))
			}

			def pickHue(along float) {
				sync()
				hue = along * 360.0
				set(hsvColor(hue, sat, val, value.alpha))
			}

			def pickAlpha(along float) {
				set(value.withAlpha(uint8((along * 255.0).round())))
			}

			// Takes typed hex once it is a whole colour: 6 digits, or 8 with opacity.
			def typed(text string) {
				let digits = text.trimPrefix("#").len()
				return unless digits == 6 || (alpha && digits == 8)
				let made = parse(text.startsWith("#") ?? (text, "#" + text))
				return when made is error
				set(made)
			}

			// What the hex field holds, taken when Enter is pressed in it.
			def submitted() {
				let field = hexField
				return when field is none
				let made = parse(field.value.startsWith("#") ?? (field.value, "#" + field.value))
				return when made is error
				set(made)
			}

			def shownHue() float {
				sync()
				return hue
			}
		}

		// Its parts: `plane`, `hues`, `opacity` (with `alpha`), the `preview` and the
		// `hexField`, then a row of swatches.
		view {
			ColorPlane(ref = plane, hue = shownHue(), sat = sat, val = val, enabled = !disabled, onPick = pickPlane)
			ColorStrip(ref = hues, along = shownHue() / 360.0, enabled = !disabled, onPick = pickHue)
			if alpha {
				ColorStrip(ref = opacity, kind = ColorStripKind.Alpha, along = opacityAlong(), color = value, enabled = !disabled, onPick = pickAlpha)
			}
			Row(gap = 8(px), style = {align: Align{horizontal: Alignment.Start, vertical: Alignment.Center}}) {
				ColorSquare(value, ref = preview)
				TextField(hexText(value, alpha), ref = hexField, enabled = !disabled, onChange = typed, onSubmit = submitted, style = {width: fill})
			}
			if swatches.len() > 0 {
				Row(gap = 6(px), style = {wrap: true}) {
					for let (i, swatch) in swatches {
						ColorSquare(swatch, key = i, ringed = swatch == value, enabled = !disabled, onClick = def () {
							set(swatch)
						})
					}
				}
			}
		}

		style {
			ColumnStyle
			gap   = new Axes<Extent>(8(px))
			width = 240(px)
		}
	}

	// A colour shown as a square button that opens a `ColorPicker` under it:
	// `ColorWell(value = background, onChange = setBackground)`.
	component ColorWell {
		type {
			// The colour.
			@input(value = true, bind = true)
			@state
			value Color = new Color(RGBA{r: 0, g: 0, b: 0, a: 255})

			// What the picker it opens takes: an opacity, and swatches.
			@input
			alpha bool = true

			@input
			swatches Color[] = []

			// Runs with the new colour when the user changes it.
			@input
			onChange ?(def(Color)) = none

			// Tells every listener its new colour, after the handler ran: heard with
			// `@on(ColorWell.changed)`.
			@emit()
			def changed(color Color) Color {
				return color
			}

			// Whether the picker is shown.
			@bindable
			opened bool

			// A click opens or closes the picker.
			def clicked() {
				opened = !opened
			}

			def picked(color Color) {
				return when color == value
				value = color
				let tell = onChange
				tell(color) unless tell is none
				changed(color)
			}
		}

		// Its parts: the `face`, a square of the colour, and the `picker` in a popover.
		view {
			ColorSquare(value, ref = face, style = {width: 28(px), height: 28(px)})
			Popover(open = opened) {
				ColorPicker(value, ref = picker, alpha = alpha, swatches = swatches, onChange = picked)
			}
		}

		style {
			Box
			Control
			Layout
			padding = new Edges<Extent>(3(px))
			radius  = new Corners<Extent>(theme.metrics.radius)
			border  = controlEdge(theme.palette.border)
			on      = {
				hover:        {background: new BackgroundFill(theme.palette.hover)},
				focusVisible: {outline: focusRing()},
			}
		}
	}
}
