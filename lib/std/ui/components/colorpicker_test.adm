partial module std.ui.components {
	use (
		std.gfx.color::(Color, RGBA)
		std.math.geom::(Point, Size)
		std.testing
		std.ui::(Key, KeyEvent, PointerPhase)
		std.ui.runtime::Scene
		std.ui.styles::*
		std.units::Pixels
	)

	internal let pickedColors = string[]

	internal def notePicked(color Color) {
		pickedColors.push(hexText(color, true))
	}

	internal def rgb(r uint8, g uint8, b uint8, a uint8 = 255) Color {
		return new Color(RGBA{r: r, g: g, b: b, a: a})
	}

	// A picker with two swatches, and a well.
	component Picking {
		type {
			@bindable
			start Color = rgb(255, 0, 0)

			@bindable
			well Color = rgb(0, 0, 0)

			def new() {
				style.width = 400(px)
				style.height = 500(px)
			}
		}

		view {
			Column(gap = 8(px)) {
				ColorPicker(start, swatches = [rgb(0, 0, 255), rgb(0, 128, 0, 128)], onChange = notePicked)
				ColorWell(well, alpha = false, onChange = notePicked)
			}
		}

		style StageStyle
	}

	// The point of the window at the given fractions of a component's box.
	internal def at(c component, x float, y float) Point<Pixels> {
		let frame = c.style.geom.frame
		return new Point<Pixels>(frame.left + float(frame.width) * x * 1(px), frame.top + float(frame.height) * y * 1(px))
	}

	check "ColorPicker" {
		// Hue, saturation and value turn into the colour and back; a grey keeps the hue
		// it is given.
		@test()
		def TestHsv() {
			assert hexText(hsvColor(0.0, 1.0, 1.0), false) == "#FF0000"
			assert hexText(hsvColor(120.0, 1.0, 0.5), false) == "#008000"
			assert hexText(hsvColor(240.0, 0.5, 1.0, 128), true) == "#8080FF80"
			let (h, s, v) = hsvOf(rgb(0, 128, 0), 0.0)
			assert (h - 120.0).abs() < 0.01 && (s - 1.0).abs() < 0.01 && (v - 128.0 / 255.0).abs() < 0.01
			let (grey, _, _) = hsvOf(rgb(90, 90, 90), 200.0)
			assert grey == 200.0
		}

		// A press on the square, a drag along the hues, the opacity, typed hex and a
		// swatch each pick a colour and report it.
		@test()
		def TestPicking() {
			pickedColors = string[]
			let page = Picking()
			let scene = new Scene(page)
			let size = new Size<Pixels>(400(px), 500(px))
			scene.arrange(size)
			scene.arrange(size)
			let picker = page.children[0].children[0]
			assert picker is ColorPicker
			if picker is ColorPicker {
				let (plane, hues, opacity) = (picker.children[0], picker.children[1], picker.children[2])
				// Near the bottom-left corner of the square is near black (the corners
				// themselves are rounded off).
				scene.pointer(PointerPhase.Down, at(plane, 0.05, 0.98))
				scene.pointer(PointerPhase.Up, at(plane, 0.05, 0.98))
				let dark = picker.value
				assert dark.red < 8 && dark.green < 8 && dark.blue < 8
				// Near the top-right corner is near the hue, which the dark colour kept.
				scene.pointer(PointerPhase.Down, at(plane, 0.98, 0.02))
				scene.pointer(PointerPhase.Up, at(plane, 0.98, 0.02))
				let bright = picker.value
				assert bright.red > 245 && bright.green < 16 && bright.blue < 16
				// A third of the way along the hues is green.
				scene.pointer(PointerPhase.Down, at(hues, 1.0 / 3.0, 0.5))
				scene.pointer(PointerPhase.Up, at(hues, 1.0 / 3.0, 0.5))
				scene.arrange(size)
				assert picker.value.green > 240 && picker.value.red < 16 && picker.value.blue < 16
				// Half of the opacity strip.
				scene.pointer(PointerPhase.Down, at(opacity, 0.5, 0.5))
				scene.pointer(PointerPhase.Up, at(opacity, 0.5, 0.5))
				assert picker.value.alpha >= 126 && picker.value.alpha <= 129
				// Typed hex is taken once it is a whole colour.
				let row = picker.children[3]
				let field = row.children[1]
				if field is TextField {
					field.focus()
					scene.arrange(size)
					field.value = "#12345"
					picker.typed("#12345")
					assert picker.value.alpha != 255
					picker.typed("#123456")
					assert hexText(picker.value, true) == "#123456"
				}
				// A swatch.
				let swatches = picker.children[4]
				scene.pointer(PointerPhase.Down, at(swatches.children[1], 0.5, 0.5))
				scene.pointer(PointerPhase.Up, at(swatches.children[1], 0.5, 0.5))
				assert hexText(picker.value, true) == "#00800080"
				// The arrows move the point on the square once it has the focus.
				plane.focus()
				scene.arrange(size)
				let before = picker.value
				scene.key(KeyEvent{target: plane, key: Key.Down})
				assert !(picker.value == before)
				assert pickedColors.len() >= 7
			}
			scene.close()
		}

		// A well opens its picker on a click; what is picked there is the well's colour,
		// opaque when it takes no opacity.
		@test()
		def TestWell() {
			pickedColors = string[]
			let page = Picking()
			let scene = new Scene(page)
			let size = new Size<Pixels>(400(px), 500(px))
			scene.arrange(size)
			let well = page.children[0].children[1]
			assert well is ColorWell
			if well is ColorWell {
				scene.pointer(PointerPhase.Down, at(well, 0.5, 0.5))
				scene.pointer(PointerPhase.Up, at(well, 0.5, 0.5))
				scene.arrange(size)
				assert well.opened
				let inner = well.find<ColorPicker>()
				assert !(inner is none)
				if !(inner is none) {
					inner.typed("#336699cc")
					inner.typed("#336699")
					scene.arrange(size)
					assert hexText(well.value, true) == "#336699" && pickedColors.join(",") == "#336699"
				}
			}
			scene.close()
		}
	}
}
