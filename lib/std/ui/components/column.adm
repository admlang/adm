partial module std.ui.components {
	use (
		std.math.geom::Axes
		std.ui.styles::*
		std.units::(Extent)
	)

	// The style of a `Column`: its box and how it arranges its children.
	style ColumnStyle {
		Box
		Layout
	}

	// Places its children top to bottom: `Column(gap = 8(px)) { ... }`.
	component Column {
		type {
			// The space between neighbouring children.
			@input
			gap Extent = 0(px)
		}

		view {
			children()
		}

		style {
			ColumnStyle
			arrange = Arrange.Column
			gap     = new Axes<Extent>(self.gap)
		}
	}
}
