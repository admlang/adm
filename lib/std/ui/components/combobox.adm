partial module std.ui.components {
	use (
		std.math.geom::Axes
		std.ui::(Key, KeyEvent)
		std.ui.styles::*
		std.units::Extent
	)

	// A field with a list of suggestions under it:
	// `ComboBox(value = city, options = cities, onChange = setCity)`. Typing shows the
	// options that hold the text, whatever their capitals; the arrow at the field's end shows them all. Down
	// goes into the list, where the arrows move and Enter picks; a pick puts the option in
	// the field. Text that is no option is allowed. The options may be any values, shown
	// and matched by `text`: `ComboBox(value = city, options = cities, text = (c City) =>
	// c.name)`.
	component ComboBox<T = string> {
		type {
			// The text in the field.
			@input(value = true, bind = true)
			value string = ""

			// What can be picked, in order.
			@input
			options T[] = []

			// How an option reads in the list and in the field once picked; none: as
			// it prints.
			@input
			text ?(def(T) string) = none

			// Shown while the field is empty.
			@input
			placeholder string = ""

			// Runs with the new text when the user types or picks.
			@input
			onChange ?(def(string)) = none

			// Tells every listener its new text, after the handler ran: heard with
			// `@on(ComboBox.changed)`.
			@emit()
			def changed(text string) string {
				return text
			}

			// Runs with the index of an option when it is picked.
			@input
			onSelect ?(def(int)) = none

			// What a line of the list shows in place of the option's text, the same as a
			// `List`'s rows: `ComboBox(query, options = people) { rowRenderer =
			// (it RowItem<Person>) => view { Avatar(name = it.content.name); Text(it.content.name) } }`.
			@input
			rowRenderer ?(def(RowItem<T>) view) = none

			// Tells every listener which option was chosen, after the handler ran: heard with
			// `@on(ComboBox.selected)`.
			@emit()
			def selected(index int) int {
				return index
			}

			// Whether the list is shown, whether it holds only the options that match the
			// text, and whether a key opened it (its first line then takes the focus).
			opened    bool
			filtering bool
			byKey     bool
			// The options as they were last looked at (the array, and its texts in small
			// letters), the indices of the options listed, and the text those were found for.
			seen      ?T[] = none
			shownText string[]
			lowered   string[]
			listed    int[]
			listedFor string
			found     bool

			// Notes the options when they are another array with other texts. True when
			// they changed.
			def take() bool {
				let had = seen
				return false when !(had is none) && had == options
				seen = options
				let texts string[]
				for let option in options {
					texts.push(textOf(option))
				}
				let same = texts.len() == lowered.len()
				if same {
					for let (i, read) in texts {
						same = false when lowered[i] != read.lower()
					}
				}
				shownText = texts
				return false when same
				let small string[]
				for let read in texts {
					small.push(read.lower())
				}
				lowered = small
				return true
			}

			// How `option` reads.
			def textOf(option T) string {
				let read = text
				return read(option) unless read is none
				return "{option}"
			}

			// The indices of the options the list shows: the same array until the text,
			// the options or the filtering change.
			def matches() int[] {
				let wanted = filtering ?? (value.lower(), "")
				return listed when !take() && found && wanted == listedFor
				let now int[]
				for let (i, small) in lowered {
					now.push(i) when wanted == "" || small.contains(wanted)
				}
				listed    = now
				listedFor = wanted
				found     = true
				return now
			}

			// The field's text changed: the list shows what matches it.
			def typed(text string) {
				// The field wrote `value` already: it passes the bound input on.
				value     = text
				filtering = true
				byKey     = false
				opened    = matches().len() > 0
				let tell = onChange
				tell(text) unless tell is none
				changed(text)
			}

			// The arrow: all the options, or none.
			def flip() {
				return when disabled
				filtering = false
				byKey     = false
				opened    = !opened
			}

			def shut() {
				opened = false
			}

			// Puts option `index` in the field as a click on its line does.
			def choose(index int) {
				opened = false
				return when index < 0 || index >= options.len()
				let _ = take()
				let picked = shownText[index]
				if picked != value {
					value = picked
					let tell = onChange
					tell(picked) unless tell is none
					changed(picked)
				}
				let told = onSelect
				told(index) unless told is none
				selected(index)
			}

			// Down from the field goes into the list, opening it first.
			def key(e KeyEvent) bool {
				return false when !e.down
				return false when disabled || e.key != Key.Down
				if !opened {
					filtering = false
					byKey     = true
					opened    = true
					return true
				}
				let lines = list
				focusFirst(lines.childNodes) unless lines is none
				return true
			}
		}

		view {
			TextField(value = value, placeholder = placeholder, enabled = !disabled, trailing = "chevron-down", onTrailing = flip, onChange = typed)
			Menu(ref = list, open = opened && matches().len() > 0, focusLines = byKey, onClose = shut) {
				let make = rowRenderer
				for let (_, at) in matches() {
					if make is none {
						MenuItem(label = shownText[at], key = at, checked = shownText[at] == value, onActivate = def () {
							choose(at)
						})
					} else {
						MenuItem(key = at, checked = shownText[at] == value, onActivate = def () {
							choose(at)
						}) {
							start = make(RowItem<T>{content: options[at], index: at, selected: shownText[at] == value})
						}
					}
				}
				// Lines the caller adds after the options.
				children()
			}
		}

		style {
			RowStyle
			arrange = Arrange.Row
			gap     = new Axes<Extent>(2(px))
		}
	}
}
