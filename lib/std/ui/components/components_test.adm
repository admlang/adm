	// State kept outside any component, every field of it bindable.
	@bindable
	internal type Shared {
		muted bool
	}

	internal let shared = new Shared()

	// Controls given `@bindable` fields and no handler: what the user does is written to
	// the fields.
	component Bound {
		type {
			@bindable
			agreed bool = false

			@bindable
			volume float = 20.0

			@bindable
			name string = "ada"

			@bindable
			page int = 0

			// Not bindable: a control given it edits its own copy.
			plain bool = false

			def new() {
				style.width = 400(px)
				style.height = 300(px)
			}
		}

		view {
			Column(gap = 6(px)) {
				Checkbox(agreed, label = "Agree")
				Slider(volume)
				TextField(name)
				TabStrip(["one", "two"], current = page)
				Dropdown(["one", "two"], selected = page)
				Checkbox(plain, label = "Plain")
				Switch(shared.muted, label = "Muted")
			}
		}

		style StageStyle
	}

