	internal let scopeLog = string[]

	// Hears the keys and presses of what it holds, and is not laid out.
	@scoped
	component Hears {
		type {
			def key(e KeyEvent) bool {
				return false when !e.down
				scopeLog.push("key {e.key}")
				return false
			}

			def attached() {
				scopeLog.push("attached")
			}

			def detached() {
				scopeLog.push("detached")
			}
		}

		view {
			children()
		}
	}

	internal let scopeShown = [true]

	// A row of three buttons, the first two inside a scope.
	component Rowed {
		type {
			def new() {
				style.width = 400(px)
				style.height = 300(px)
			}
		}

		view {
			Row(gap = 10(px)) {
				if scopeShown[0] {
					Hears(enabled = gate[0]) {
						Button("One", onClick = ran)
						Button("Two")
					}
				}
				Button("Three")
			}
		}

		style StageStyle
	}

	// A label before the field it names, and a button a popover names.
	component Named {
		type {
			def new() {
				style.width = 400(px)
				style.height = 300(px)
			}
		}

		view {
			Column(gap = 6(px)) {
				Label("Name", target = nameField)
				Text("in between")
				TextField("ada", ref = nameField)
				Button("More", ref = trigger)
				Popover(true, attach = trigger) {
					Text("beside the button")
				}
			}
		}

		style StageStyle
	}

	check "Components" {
		// The middle of a component's box, in the window.
		def middle(c component) Point<Pixels> {
			let look = c.style
			let frame = look.geom.frame
			return new Point<Pixels>((float(frame.left) + float(frame.width) / 2.0) * 1(px), (float(frame.top) + float(frame.height) / 2.0) * 1(px))
		}

		// A point on what a field shows at its end: the trailing icon, or the upper
		// (`part` 2) or lower (3) of its two arrows.
		def atEnd(c component, part int = 1) Point<Pixels> {
			let frame = c.style.geom.frame
			let down = part == 2 ?? (0.25, part == 3 ?? (0.75, 0.5))
			return new Point<Pixels>((float(frame.right) - 16.0) * 1(px), (float(frame.top) + float(frame.height) * down) * 1(px))
		}

		def box(c component) (float, float, float, float) {
			let frame = c.style.geom.frame
			return (float(frame.left), float(frame.top), float(frame.width), float(frame.height))
		}

		// The red, green and blue of the pixel at `at`.
		def shade(surface canvas.Canvas, at Point<Pixels>) string {
			let i = (int(float(at.y)) * surface.width + int(float(at.x))) * 4
			return "{surface.pixels[i]},{surface.pixels[i + 1]},{surface.pixels[i + 2]}"
		}

		@test()
		def TestToolbar() {
			pressLog = string[]
			let bar = ToolRow()
			let scene = new Scene(bar)
			scene.arrange(new Size<Pixels>(400(px), 200(px)))
			let column = bar.children[0]
			let row = column.children[0]
			let pressable = column.children[1]
			let (save, cancel, off) = (row.children[0], row.children[1], row.children[2])

			// A Row places its children side by side, a Column one under the other, each with its gap; a button is as large as its label and at least a control high.
			let (saveLeft, saveTop, saveWidth, saveHeight) = box(save)
			let (cancelLeft, cancelTop, _, _) = box(cancel)
			let (_, rowTop, _, rowHeight) = box(row)
			let (_, pressTop, _, _) = box(pressable)
			assert saveWidth > 24.0 && saveHeight >= 28.0 && cancelTop == saveTop
			assert cancelLeft == saveLeft + saveWidth + 4.0 && pressTop == rowTop + rowHeight + 6.0

			// A gap given after the row was made moves its children on the next layout.
			if row is Row {
				row.gap = 10(px)
			}
			scene.arrange(new Size<Pixels>(400(px), 200(px)))
			let (widerLeft, _, _, _) = box(cancel)
			assert widerLeft == saveLeft + saveWidth + 10.0

			// A click is a press and a release on the button; a release elsewhere drops it.
			scene.pointer(PointerPhase.Down, middle(save))
			assert save.pressed && save.focused
			scene.pointer(PointerPhase.Up, middle(save))
			scene.pointer(PointerPhase.Down, middle(cancel))
			scene.pointer(PointerPhase.Up, middle(cancel))
			scene.pointer(PointerPhase.Down, middle(save))
			scene.pointer(PointerPhase.Up, new Point<Pixels>(390(px), 190(px)))
			assert pressLog.join(",") == "save,cancel"

			// A disabled button does nothing; Enter and Space press the focused one.
			scene.pointer(PointerPhase.Down, middle(off))
			scene.pointer(PointerPhase.Up, middle(off))
			scene.pointer(PointerPhase.Down, middle(cancel))
			scene.pointer(PointerPhase.Up, middle(cancel))
			let whole component = bar
			scene.key(KeyEvent{target: whole, key: Key.Enter})
			scene.key(KeyEvent{target: whole, key: Key.Space})
			scene.key(KeyEvent{target: whole, key: Key.A})
			assert pressLog.join(",") == "save,cancel,cancel,cancel,cancel"

			// A Pressable takes the click for what is inside it, and the secondary button.
			pressLog = string[]
			let inside = pressable.children[0]
			scene.pointer(PointerPhase.Down, middle(inside))
			scene.pointer(PointerPhase.Up, middle(inside))
			scene.pointer(PointerPhase.Down, middle(inside), MouseButton.Right)
			scene.pointer(PointerPhase.Up, middle(inside), MouseButton.Right)
			assert pressLog.join(",") == "open,menu" && pressable.focused
		}

		// Controls live through any number of pointer events: a control once lost a
		// reference on each event it was handed and was freed while still mounted.
		@test()
		def TestControlsSurviveEvents() {
			let bar = ToolRow()
			let scene = new Scene(bar)
			let size = new Size<Pixels>(400(px), 200(px))
			scene.arrange(size)
			let column = bar.children[0]
			let row = column.children[0]
			let pressable = column.children[1]
			let (save, cancel) = (row.children[0], row.children[1])
			for let round = 0; round < 300; round++ {
				scene.pointer(PointerPhase.Move, middle(save))
				scene.arrange(size)
				scene.pointer(PointerPhase.Move, middle(cancel))
				scene.pointer(PointerPhase.Move, middle(pressable))
				scene.arrange(size)
				scene.pointer(PointerPhase.Leave, new Point<Pixels>(0(px), 0(px)))
			}
			assert row.children.len() == 3 && column.children.len() == 2 && bar.children.len() == 1
			let (_, _, saveWidth, _) = box(save)
			assert saveWidth > 24.0
		}

		// Tab goes from one enabled control to the next and round, Shift+Tab back; focus
		// moved by a key is visible, focus moved by a press is not; in a ScrollView the
		// focused control is scrolled into view.
		@test()
		def TestTab() {
			let bar = ToolRow()
			let scene = new Scene(bar)
			scene.arrange(new Size<Pixels>(400(px), 200(px)))
			let column = bar.children[0]
			let row = column.children[0]
			let pressable = column.children[1]
			let (save, cancel, off) = (row.children[0], row.children[1], row.children[2])
			let whole component = bar
			let tab = def () {
				scene.key(KeyEvent{target: whole, key: Key.Tab})
			}
			tab()
			assert save.focused && save.focusVisible
			tab()
			assert cancel.focused && !save.focused && !save.focusVisible
			tab()
			assert pressable.focused && !off.focused
			tab()
			assert save.focused
			scene.key(KeyEvent{target: whole, key: Key.LeftShift})
			tab()
			assert pressable.focused
			scene.keyUp(Key.LeftShift)
			tab()
			assert save.focused
			scene.pointer(PointerPhase.Down, middle(cancel))
			scene.pointer(PointerPhase.Up, middle(cancel))
			assert cancel.focused && !cancel.focusVisible

			let page = Reader()
			let reading = new Scene(page)
			let window = new Size<Pixels>(400(px), 200(px))
			reading.arrange(window)
			let last = page.children[0].children[5]
			let all component = page
			for let i = 0; i < 6; i++ {
				reading.key(KeyEvent{target: all, key: Key.Tab})
			}
			reading.arrange(window)
			let frame = last.style.geom.frame
			assert last.focused && float(frame.top) >= 0.0 && float(frame.bottom) <= 100.0

			// `reveal()` scrolls a component into view without giving it the focus.
			let again = Reader()
			let shown = new Scene(again)
			shown.arrange(window)
			let far = again.children[0].children[5]
			assert float(far.style.geom.frame.top) >= 100.0
			far.reveal()
			shown.arrange(window)
			shown.arrange(window)
			let place = far.style.geom.frame
			assert !far.focused && float(place.top) >= 0.0 && float(place.bottom) <= 100.0
			shown.close()
		}

		// One frame's views, styles and layout for five hundred buttons.
		@benchmark()
		def ArrangeButtons() {
			tipScenes.plain = tipScene(false) when tipScenes.plain is none
			let scene = tipScenes.plain
			return when scene is none
			scene.arrange(new Size<Pixels>(800(px), 600(px)))
		}

		// The same with every button under the pointer: each is given the look of its
		// style's `hover` on every frame.
		@benchmark()
		def ArrangeButtonsHovered() {
			if tipScenes.hovered is none {
				let made = tipScene(false)
				hoverAll(made.root)
				tipScenes.hovered = made
			}
			let scene = tipScenes.hovered
			return when scene is none
			scene.arrange(new Size<Pixels>(800(px), 600(px)))
		}

		// The same with each button in a `Tooltip` that has content of its own.
		@benchmark()
		def ArrangeTooltips() {
			tipScenes.wrapped = tipScene(true) when tipScenes.wrapped is none
			let scene = tipScenes.wrapped
			return when scene is none
			scene.arrange(new Size<Pixels>(800(px), 600(px)))
		}

		// A std component's named states are heard with `UI.stateChange` when the user
		// changes them, once per change; a selector picks the component and the state.
		@test()
		def TestStatesAreTold() {
			let page = Stateful()
			let scene = new Scene(page)
			let size = new Size<Pixels>(400(px), 200(px))
			scene.arrange(size)
			scene.arrange(size)
			let column = page.children[0]
			let (ticked, toggle, strip) = (column.children[0], column.children[1], column.children[2])
			stateLog = string[]
			let click = def (c component) {
				scene.pointer(PointerPhase.Down, middle(c))
				scene.pointer(PointerPhase.Up, middle(c))
				scene.arrange(size)
			}
			// Listeners of one event run in no promised order: the log is read sorted.
			let told = def () string {
				return stateLog.sort((a string, b string) => a < b).join(",")
			}
			click(ticked)
			assert page.agreed && told() == "checkbox,checked"
			click(toggle)
			assert page.lit && told() == "checkbox,checked,on"
			// From the switch, which the click focused, Tab goes to the strip.
			scene.key(KeyEvent{target: page, key: Key.Tab})
			assert strip.focused
			scene.key(KeyEvent{target: page, key: Key.Right})
			scene.arrange(size)
			assert page.tab == 1 && told() == "checkbox,checked,current,on,strip"
			scene.close()
		}

		// A tab is dragged past the middle of its neighbours: the caller's titles move
		// and the dragged tab stays current; without `onMove` nothing is dragged.
		@test()
		def TestTabStripMoves() {
			movedTabs = ["one", "two", "three"]
			movedLog = string[]
			let page = Movable()
			let scene = new Scene(page)
			let size = new Size<Pixels>(400(px), 100(px))
			let surface = new canvas.Canvas(400, 100)
			let lay = def () {
				scene.arrange(size)
				scene.paint(surface)
			}
			lay()
			let strip = page.children[0]
			if strip is TabStrip {
				let (_, top, _, high) = box(strip)
				let at = def (index int, part float) Point<Pixels> {
					let slot = strip.row.slot(index, float(strip.style.geom.frame.width), high, false)
					return new Point<Pixels>((float(strip.style.geom.frame.left) + slot.left + (slot.right - slot.left) * part) * 1(px), (top + high / 2.0) * 1(px))
				}
				// Grabbed in its middle, taken over the near half of the next tab: it stays;
				// past that tab's middle, it moves there.
				scene.pointer(PointerPhase.Down, at(0, 0.5))
				scene.pointer(PointerPhase.Move, at(1, 0.3))
				assert movedLog.len() == 0
				scene.pointer(PointerPhase.Move, at(1, 0.7))
				assert movedLog.join(",") == "0>1" && movedTabs.join(",") == "two,one,three" && page.shown == 1
				lay()
				// On to the end, then back to the start in one go.
				scene.pointer(PointerPhase.Move, at(2, 0.8))
				lay()
				assert movedTabs.join(",") == "two,three,one" && page.shown == 2
				scene.pointer(PointerPhase.Move, at(0, 0.2))
				lay()
				assert movedTabs.join(",") == "one,two,three" && page.shown == 0 && movedLog.join(",") == "0>1,1>2,2>0"
				// Let go of: a move after that drags nothing.
				scene.pointer(PointerPhase.Up, at(0, 0.2))
				scene.pointer(PointerPhase.Move, at(2, 0.9))
				assert movedLog.len() == 3

				// A click on a tab's cross closes that tab and picks none; a press on the
				// cross let go of elsewhere closes nothing; the middle button on a tab
				// closes it.
				lay()
				let cross = def (index int) Point<Pixels> {
					let mark = strip.crossBox(index)
					return new Point<Pixels>((float(strip.style.geom.frame.left) + (mark.left + mark.right) / 2.0) * 1(px), (top + high / 2.0) * 1(px))
				}
				scene.pointer(PointerPhase.Down, cross(1))
				scene.pointer(PointerPhase.Up, at(2, 0.3))
				assert movedLog.len() == 3 && page.shown == 0
				scene.pointer(PointerPhase.Down, cross(1))
				scene.pointer(PointerPhase.Up, cross(1))
				assert movedLog.join(",") == "0>1,1>2,2>0,close 1" && movedTabs.join(",") == "one,three" && page.shown == 0
				lay()
				scene.pointer(PointerPhase.Down, at(1, 0.3), MouseButton.Middle)
				scene.pointer(PointerPhase.Up, at(1, 0.3), MouseButton.Middle)
				assert movedTabs.join(",") == "one"
			}
			scene.close()
		}

		// A `FocusScope` gives the focus back to what had it last when Tab comes into it
		// again; one that traps keeps Tab among what it holds.
		@test()
		def TestFocusScope() {
			let panes = Panes()
			let scene = new Scene(panes)
			scene.arrange(new Size<Pixels>(400(px), 300(px)))
			let column = panes.children[0]
			let (before, kept, after, trap) = (column.children[0], column.children[1], column.children[2], column.children[3])
			let (one, two, three) = (kept.children[0], kept.children[1], kept.children[2])
			let (first, second) = (trap.children[0], trap.children[1])
			let whole component = panes
			let tab = def () {
				scene.key(KeyEvent{target: whole, key: Key.Tab})
			}
			assert kept is FocusScope && trap is FocusScope
			tab()
			tab()
			tab()
			assert two.focused
			// Out of the scope by a press, back in by Tab: to what had the focus there.
			scene.pointer(PointerPhase.Down, middle(before))
			scene.pointer(PointerPhase.Up, middle(before))
			assert before.focused
			tab()
			assert two.focused && !one.focused
			tab()
			tab()
			assert after.focused
			// Backwards into it: again to the one it kept, which is now the third.
			scene.key(KeyEvent{target: whole, key: Key.LeftShift})
			tab()
			assert three.focused
			scene.keyUp(Key.LeftShift)
			tab()
			tab()
			assert first.focused
			// Inside the trap Tab goes round, both ways.
			tab()
			assert second.focused
			tab()
			assert first.focused
			scene.key(KeyEvent{target: whole, key: Key.LeftShift})
			tab()
			assert second.focused
			scene.keyUp(Key.LeftShift)
			scene.close()
		}

		// A ScrollView keeps its content's size, moves it with the wheel, a drag of the
		// thumb and the keys, never past its ends, and cuts it off at its box.
		@test()
		def TestScrollView() {
			let page = Reader()
			let scene = new Scene(page)
			let window = new Size<Pixels>(400(px), 200(px))
			scene.arrange(window)
			let scroller = page.children[0]
			let first = scroller.children[0]
			let third = scroller.children[2]
			let (_, _, wide, high) = box(scroller)
			let (_, _, _, row) = box(first)
			assert wide == 200.0 && high == 100.0 && row >= 28.0
			let most = row * 6.0 - 100.0
			let top = def () float {
				scene.arrange(window)
				return float(first.style.geom.frame.top)
			}

			// The wheel; the content stops at its end and a wheel there is not taken.
			let inside = new Point<Pixels>(50(px), 50(px))
			scene.pointer(PointerPhase.Scroll, inside, MouseButton.Left, new Point<Pixels>(0(px), 40(px)))
			assert top() == -40.0
			scene.pointer(PointerPhase.Scroll, inside, MouseButton.Left, new Point<Pixels>(0(px), 1000(px)))
			assert top() == -most
			if scroller is ScrollView {
				assert !scroller.scrollBy(new Point<Pixels>(0(px), 10(px))) && float(scroller.extent.height) == row * 6.0
				// The bar takes its room from the content.
				assert float(scroller.style.geom.content.width) == 200.0 - float(scroller.style.scrollbar.thickness)
			}

			// What is scrolled out of the box is not under the pointer: the top of the box
			// shows a later button, and a point below the box none.
			assert scene.hit(new Point<Pixels>(20(px), 5(px))) != first
			let whole component = page
			assert scene.hit(new Point<Pixels>(20(px), 150(px))) == whole

			// Home and End from the keyboard, bubbling from the focused button.
			scene.pointer(PointerPhase.Down, middle(third))
			scene.pointer(PointerPhase.Up, middle(third))
			scene.key(KeyEvent{target: whole, key: Key.Home})
			assert top() == 0.0
			scene.key(KeyEvent{target: whole, key: Key.End})
			assert top() == -most
			scene.key(KeyEvent{target: whole, key: Key.Home})
			assert top() == 0.0

			// Dragging the thumb down by a tenth of the track scrolls a tenth of the way
			// it can go; a press under the thumb scrolls a page.
			let thumb = new Point<Pixels>(194(px), 10(px))
			scene.pointer(PointerPhase.Down, thumb)
			scene.pointer(PointerPhase.Move, new Point<Pixels>(194(px), 20(px)))
			let dragged = top()
			scene.pointer(PointerPhase.Up, new Point<Pixels>(194(px), 20(px)))
			assert dragged < 0.0 && top() == dragged
			scene.key(KeyEvent{target: whole, key: Key.Home})
			scene.pointer(PointerPhase.Down, new Point<Pixels>(194(px), 95(px)))
			scene.pointer(PointerPhase.Up, new Point<Pixels>(194(px), 95(px)))
			assert top() == -most.min(100.0)
		}

		// A view passes its arguments again on every frame: the text follows the number.
		@test()
		def TestViewFollows() {
			tallied.count = 1
			let page = Counted()
			let scene = new Scene(page)
			scene.arrange(new Size<Pixels>(400(px), 200(px)))
			let shown = page.children[0]
			if shown is Text {
				assert shown.text == "Count 1"
				tallied.count = 25
				scene.arrange(new Size<Pixels>(400(px), 200(px)))
				assert shown.text == "Count 25" && shown.current().text == "Count 25"
			} else {
				assert false
			}
		}

		// A TextField takes typed text at its caret, moves and selects with the keys and
		// the pointer, erases, submits on Enter, and hides a password.
		@test()
		def TestTextField() {
			pressLog = string[]
			let page = Form()
			let scene = new Scene(page)
			let window = new Size<Pixels>(400(px), 200(px))
			scene.arrange(window)
			let whole component = page
			let press = def (key Key) {
				scene.key(KeyEvent{target: whole, key: key})
			}
			let first = page.children[0]
			let second = page.children[1]
			let (left, top, wide, high) = box(first)
			assert wide == 200.0 && high >= 28.0

			if first is TextField {
				// A press past the end of the text puts the caret there; typing follows.
				let end = new Point<Pixels>((left + wide - 6.0) * 1(px), (top + high / 2.0) * 1(px))
				scene.pointer(PointerPhase.Down, end)
				scene.pointer(PointerPhase.Up, end)
				assert first.focused && first.selection().start == 5
				assert scene.text("!") && first.value == "hello!"

				// Home, a character, Shift+Right twice, a character over the selection.
				press(Key.Home)
				scene.text("A")
				press(Key.LeftShift)
				press(Key.Right)
				press(Key.Right)
				scene.keyUp(Key.LeftShift)
				assert first.selection().start == 1 && first.selection().end == 3
				scene.text("X")
				assert first.value == "AXllo!"

				// Backspace, then Control+A and Delete.
				press(Key.Backspace)
				assert first.value == "Allo!" && first.selection().start == 1
				press(Key.LeftControl)
				press(Key.A)
				scene.keyUp(Key.LeftControl)
				assert first.selection().start == 0 && first.selection().end == 5
				press(Key.Delete)
				assert first.value == "" && first.surrounding() == ""

				// A drag from the start to past the end selects everything.
				scene.text("some words")
				let start = new Point<Pixels>((left + 2.0) * 1(px), (top + high / 2.0) * 1(px))
				scene.pointer(PointerPhase.Down, start)
				scene.pointer(PointerPhase.Move, end)
				scene.pointer(PointerPhase.Up, end)
				assert first.selection().start == 0 && first.selection().end == 10

				// Control+Left goes back a word; the caret is inside the field.
				press(Key.End)
				press(Key.LeftControl)
				press(Key.Left)
				scene.keyUp(Key.LeftControl)
				assert first.selection().start == 5
				let caret = first.caretRect()
				assert float(caret.left) > left && float(caret.left) < left + wide && float(caret.top) >= top

				// The selected word is dragged along the field: a press on it that moves
				// lifts it, and letting go drops it at the place under the pointer; a
				// press on it that does not move puts the caret there.
				let place = def (index int) Point<Pixels> {
					press(Key.Home)
					for let i = 0; i < index; i++ {
						press(Key.Right)
					}
					return new Point<Pixels>(first.caretRect().left + 1(px), (top + high / 2.0) * 1(px))
				}
				let (inSome, pastWords, inWords) = (place(1), place(10), place(7))
				let pick = def () {
					press(Key.Home)
					press(Key.LeftShift)
					for let i = 0; i < 5; i++ {
						press(Key.Right)
					}
					scene.keyUp(Key.LeftShift)
				}
				pick()
				assert first.edit.selected() == "some "
				scene.pointer(PointerPhase.Down, inSome)
				scene.pointer(PointerPhase.Move, inWords)
				assert first.dragging && first.value == "some words"
				scene.pointer(PointerPhase.Move, pastWords)
				scene.pointer(PointerPhase.Up, pastWords)
				assert !first.dragging && first.value == "wordssome "
				// Back with a drop from outside: the text goes in under the pointer.
				press(Key.LeftControl)
				press(Key.A)
				scene.keyUp(Key.LeftControl)
				press(Key.Delete)
				scene.text("words")
				assert scene.drop(place(0), DragData{text: "some "}) && first.value == "some words"
				pick()
				scene.pointer(PointerPhase.Down, inSome)
				scene.pointer(PointerPhase.Up, inSome)
				assert first.value == "some words" && first.selection().start == 1 && first.selection().end == 1
				press(Key.End)
				press(Key.LeftControl)
				press(Key.Left)
				scene.keyUp(Key.LeftControl)
				assert first.selection().start == 5

				// What an input method composes shows at the caret and is not the value:
				// the caret moves with it, taking it back restores the line, committing
				// puts the text in.
				first.compose("abc", 3)
				assert first.value == "some words" && first.shown() == "some abcwords" && first.selection().start == 5
				let ahead = first.caretRect()
				assert float(ahead.left) > float(caret.left)
				first.compose("abc", 0)
				assert float(first.caretRect().left) == float(caret.left)
				first.compose("", 0)
				assert first.shown() == "some words" && float(first.caretRect().left) == float(caret.left)
				first.compose("xy", -1)
				assert scene.text("né") && first.value == "some néwords" && first.shown() == first.value
				press(Key.Backspace)
				press(Key.Backspace)
				// A composition takes the place of the selection.
				press(Key.LeftShift)
				press(Key.End)
				scene.keyUp(Key.LeftShift)
				first.compose("k", 1)
				assert first.value == "some " && first.shown() == "some k"
				first.compose("", 0)
				scene.text("words")
				assert first.value == "some words"

				// Text longer than the field scrolls so the caret stays in sight.
				press(Key.End)
				scene.text(" and many more words than two hundred pixels hold")
				let far = first.caretRect()
				assert first.shift > 0.0 && float(far.left) <= left + wide

				press(Key.Enter)
				assert pressLog.join(",") == "submit"
			} else {
				assert false
			}

			// Tab goes to the password field; its text is drawn as dots and not copied.
			press(Key.Tab)
			if second is TextField {
				assert second.focused && second.focusVisible
				scene.text("s3cret")
				assert second.value == "s3cret" && second.shown() == "••••••"
			} else {
				assert false
			}
			let surface = new canvas.Canvas(400, 200)
			scene.arrange(window)
			scene.paint(surface)
		}

		// A Popover hangs under its target, out of the layout, goes above it or slides
		// along it when the window has no room, and closes on Escape or a press outside.
		@test()
		def TestPopover() {
			pressLog = string[]
			menuState.open = false
			let window = new Size<Pixels>(400(px), 200(px))
			let frames = def (scene Scene) {
				scene.arrange(window)
				scene.arrange(window)
			}

			let page = Corner()
			let scene = new Scene(page)
			frames(scene)
			let holder = page.children[0]
			let button = holder.children[0]
			let popover = holder.children[1]
			let (holderLeft, holderTop, _, holderHigh) = box(holder)
			let (_, _, hiddenWide, _) = box(popover)
			let (_, _, _, buttonHigh) = box(button)
			assert hiddenWide == 0.0 && holderHigh == buttonHigh

			// Open: under the holder, a gap away, at its left edge, taking no room in it.
			scene.pointer(PointerPhase.Down, middle(button))
			scene.pointer(PointerPhase.Up, middle(button))
			frames(scene)
			let (left, top, wide, high) = box(popover)
			let (_, _, _, holderOpen) = box(holder)
			assert menuState.open && wide > 40.0 && high > 10.0 && holderOpen == buttonHigh
			assert left == holderLeft && top == holderTop + holderHigh + 4.0
			// The focus went from the button into the popover: to the dropdown's button.
			assert !button.focused && scene.focused() == popover.children[1].children[0]
			let inside = new Point<Pixels>((left + 5.0) * 1(px), (top + 5.0) * 1(px))
			assert scene.hit(inside) != button && scene.hit(inside) != page.children[0]

			// A press inside keeps it; Escape closes it.
			scene.pointer(PointerPhase.Down, inside)
			scene.pointer(PointerPhase.Up, inside)
			assert menuState.open
			let whole component = page
			scene.key(KeyEvent{target: whole, key: Key.Escape})
			frames(scene)
			let (_, _, closedWide, _) = box(popover)
			assert !menuState.open && closedWide == 0.0 && pressLog.join(",") == "closed"

			// A press on the target is the target's business; one elsewhere closes it.
			scene.pointer(PointerPhase.Down, middle(button))
			scene.pointer(PointerPhase.Up, middle(button))
			frames(scene)
			assert menuState.open
			scene.pointer(PointerPhase.Down, new Point<Pixels>(390(px), 190(px)))
			scene.pointer(PointerPhase.Up, new Point<Pixels>(390(px), 190(px)))
			frames(scene)
			assert !menuState.open && pressLog.join(",") == "closed,closed"

			// A dropdown in the open popover: closing its list returns the focus to its
			// button, and closing the popover then returns it to the page's button.
			scene.pointer(PointerPhase.Down, middle(button))
			scene.pointer(PointerPhase.Up, middle(button))
			frames(scene)
			let nested = popover.children[1]
			let (trigger, list) = (nested.children[0], nested.children[1])
			button.focus()
			frames(scene)
			trigger.focus()
			frames(scene)
			assert scene.focused() == trigger
			scene.pointer(PointerPhase.Down, middle(trigger))
			scene.pointer(PointerPhase.Up, middle(trigger))
			frames(scene)
			assert scene.focused() == list.children[0]
			scene.key(KeyEvent{target: whole, key: Key.Escape})
			frames(scene)
			assert scene.focused() == trigger && menuState.open
			scene.key(KeyEvent{target: whole, key: Key.Escape})
			frames(scene)
			assert !menuState.open && scene.focused() == button

			// No room below: it opens above. No room to the right: it slides left.
			menuState.open = true
			let low = Corner(down = 160(px), along = 340(px))
			let cornered = new Scene(low)
			frames(cornered)
			cornered.arrange(window)
			let anchor = low.children[0]
			let (_, anchorTop, _, _) = box(anchor)
			let (flippedLeft, flippedTop, flippedWide, flippedHigh) = box(anchor.children[1])
			assert flippedTop + flippedHigh == anchorTop - 4.0
			assert flippedLeft + flippedWide <= 400.0 && flippedLeft >= 0.0 && flippedLeft < 340.0
			menuState.open = false
		}

		// A button is filled with the theme's raised surface and follows the theme when it
		// changes; a hovered one is tinted.
		@test()
		def TestLook() {
			let theme = UI.theme()
			theme.follow(Appearance{})
			let bar = ToolRow()
			let scene = new Scene(bar)
			scene.arrange(new Size<Pixels>(400(px), 200(px)))
			let save = bar.children[0].children[0].children[0]
			let frame = save.style.geom.frame
			let inside = new Point<Pixels>(frame.left + 4(px), frame.top + 4(px))
			let surface = new canvas.Canvas(400, 200)
			scene.paint(surface)
			assert shade(surface, inside) == "255,255,255"
			// Its edge is its style's border, and nothing is drawn below it.
			let edge = new Point<Pixels>(frame.left, frame.top + 8(px))
			let around = new Point<Pixels>(frame.left + 8(px), frame.top + frame.height + 2(px))
			let bare = shade(surface, around)
			assert shade(surface, edge) == "211,211,217"
			let again = def () {
				scene.arrange(new Size<Pixels>(400(px), 200(px)))
				scene.paint(surface)
			}

			// A state's look is in the style the next frame arranges: a ring while the
			// keyboard focus shows.
			let whole component = bar
			scene.key(KeyEvent{target: whole, key: Key.Tab})
			again()
			assert save.focusVisible && shade(surface, around) != bare

			// A stronger edge and a fill a step away under the pointer, another step while
			// held down.
			scene.pointer(PointerPhase.Move, inside)
			again()
			assert save.hover && shade(surface, inside) == "240,240,240"
			assert shade(surface, edge) == "138,138,148"
			scene.pointer(PointerPhase.Down, inside)
			again()
			let held = shade(surface, inside)
			assert save.pressed && held != "240,240,240" && held != "255,255,255"
			scene.pointer(PointerPhase.Up, inside)
			scene.pointer(PointerPhase.Leave, inside)
			again()
			assert shade(surface, inside) == "255,255,255" && shade(surface, edge) == "211,211,217"

			theme.follow(Appearance{scheme: ColorScheme.Dark})
			scene.arrange(new Size<Pixels>(400(px), 200(px)))
			scene.arrange(new Size<Pixels>(400(px), 200(px)))
			scene.paint(surface)
			assert shade(surface, inside) == "46,46,51"
			theme.follow(Appearance{})
		}

		// A toggle button is a button while off; on, it is filled with the accent, with
		// another fill under the pointer and one more when it is not enabled.
		@test()
		def TestToggleLook() {
			UI.theme().follow(Appearance{})
			let shown = ToggleButton(label = "Bold")
			let scene = new Scene(shown)
			let window = new Size<Pixels>(400(px), 200(px))
			let surface = new canvas.Canvas(400, 200)
			let inside = new Point<Pixels>(4(px), 4(px))
			let fill = def () string {
				scene.arrange(window)
				scene.paint(surface)
				return shade(surface, inside)
			}
			assert fill() == "255,255,255"
			scene.pointer(PointerPhase.Move, inside)
			assert fill() == "240,240,240"
			scene.pointer(PointerPhase.Leave, inside)
			shown.on = true
			let accent = fill()
			assert accent != "255,255,255" && accent != "240,240,240"
			scene.pointer(PointerPhase.Move, inside)
			let over = fill()
			assert over != accent && over != "240,240,240"
			scene.pointer(PointerPhase.Leave, inside)
			shown.enabled = false
			let off = fill()
			assert off != accent && off != over && off != "255,255,255"
			// Its label still shows on that fill.
			let frame = shown.style.geom.frame
			let lettered = false
			for let y = 6; y < int(float(frame.height)) - 6; y++ {
				for let x = 6; x < int(float(frame.width)) - 6; x++ {
					lettered = true when shade(surface, new Point<Pixels>(x * 1(px), y * 1(px))) != off
				}
			}
			assert lettered
		}

		// A line of a menu has no fill of its own; its style gives it one under the
		// pointer, another while held down, and none while it is not enabled.
		@test()
		def TestMenuItemLook() {
			UI.theme().follow(Appearance{})
			let shown = MenuItem("Save")
			let scene = new Scene(shown)
			let window = new Size<Pixels>(400(px), 200(px))
			let inside = new Point<Pixels>(6(px), 6(px))
			// A line at rest draws nothing there: each drawing is on a canvas of its own.
			let fill = def () string {
				let surface = new canvas.Canvas(400, 200)
				scene.arrange(window)
				scene.paint(surface)
				return shade(surface, inside)
			}
			let rest = fill()
			scene.pointer(PointerPhase.Move, inside)
			let over = fill()
			assert over != rest
			scene.pointer(PointerPhase.Down, inside)
			let held = fill()
			assert held != rest && held != over
			scene.pointer(PointerPhase.Up, inside)
			assert fill() == over
			scene.pointer(PointerPhase.Leave, inside)
			assert fill() == rest
			shown.enabled = false
			scene.pointer(PointerPhase.Move, inside)
			assert fill() == rest
			scene.close()
		}

		// The fill of what `shown` draws just inside its corner, in the light theme and
		// after a change to the dark one.
		def fillsOf(shown component) string {
			let theme = UI.theme()
			theme.follow(Appearance{})
			let scene = new Scene(shown)
			let window = new Size<Pixels>(400(px), 200(px))
			scene.arrange(window)
			let frame = shown.style.geom.frame
			let inside = new Point<Pixels>(frame.left + 3(px), frame.top + 3(px))
			let surface = new canvas.Canvas(400, 200)
			scene.paint(surface)
			let light = shade(surface, inside)
			theme.follow(Appearance{scheme: ColorScheme.Dark})
			scene.arrange(window)
			scene.arrange(window)
			scene.paint(surface)
			let dark = shade(surface, inside)
			theme.follow(Appearance{})
			return "{light} {dark}"
		}

		// A text field and a text area are filled with the theme's sunken surface, and
		// with the new one after the theme changed.
		@test()
		def TestFieldsFollowTheTheme() {
			assert fillsOf(TextField(value = "abc")) == "233,233,236 21,21,23"
			assert fillsOf(TextArea(value = "abc")) == "233,233,236 21,21,23"
		}

		// The edge of what `shown` draws, halfway down its left side: at rest, under the
		// pointer, with the keyboard focus, and under the pointer while not enabled.
		def edgesOf(shown component) string[] {
			UI.theme().follow(Appearance{})
			let scene = new Scene(shown)
			let window = new Size<Pixels>(400(px), 200(px))
			let surface = new canvas.Canvas(400, 200)
			scene.arrange(window)
			let frame = shown.style.geom.frame
			let side = new Point<Pixels>(frame.left, frame.top + frame.height / 2.0)
			let inside = new Point<Pixels>(frame.left + 4(px), frame.top + 4(px))
			let edge = def () string {
				scene.arrange(window)
				scene.paint(surface)
				return shade(surface, side)
			}
			let seen string[] = [edge()]
			scene.pointer(PointerPhase.Move, inside)
			seen.push(edge())
			// The focus is given by the frame that follows the call, the look by the next.
			shown.focus()
			scene.arrange(window)
			seen.push(edge())
			shown.enabled = false
			seen.push(edge())
			scene.close()
			return seen
		}

		// A text field and a text area take their edge from their style: the theme's
		// strong border, the foreground under the pointer, the focus colour with the
		// keyboard focus (which wins over the pointer), and the strong border again while
		// not enabled.
		@test()
		def TestFieldEdges() {
			for let seen in [edgesOf(TextField(value = "abc")), edgesOf(TextArea(value = "abc"))] {
				let (rest, over, held, off) = (seen[0], seen[1], seen[2], seen[3])
				assert rest != "233,233,236"
				assert over != rest && held != rest && held != over
				assert off == rest
			}
		}

		// The controls that hold a value: a click or a key changes one and tells its
		// handler; a slider follows a drag and the arrows in steps and stays in its range;
		// a radio selects once; a disabled control does nothing.
		@test()
		def TestValueControls() {
			controlLog = string[]
			agreed[0] = false
			level[0] = 20.0
			let page = Settings()
			let scene = new Scene(page)
			scene.arrange(new Size<Pixels>(400(px), 300(px)))
			let column = page.children[0]
			let (tick, flip, radio, slider, bar, off) = (column.children[0], column.children[1], column.children[2], column.children[3], column.children[4], column.children[5])

			// A checkbox is its box and its label; a switch's track is wider than a box.
			let (_, _, checkWidth, checkHeight) = box(tick)
			assert checkWidth > 18.0 + 8.0 && checkHeight >= 18.0

			// A divider is as wide as the box it is in and one border thick.
			let ruled = Ruled()
			let rules = new Scene(ruled)
			rules.arrange(new Size<Pixels>(400(px), 300(px)))
			let (_, _, lineWidth, lineHeight) = box(ruled.children[0])
			assert lineHeight == 1.0 && lineWidth == 120.0
			// Stood upright after it was made, it is one border wide.
			let line = ruled.children[0]
			if line is Divider {
				line.vertical = true
			}
			rules.arrange(new Size<Pixels>(400(px), 300(px)))
			let (_, _, uprightWidth, _) = box(ruled.children[0])
			assert uprightWidth == 1.0

			let click = def (c component) {
				scene.pointer(PointerPhase.Down, middle(c))
				scene.pointer(PointerPhase.Up, middle(c))
			}
			let whole component = page
			click(tick)
			click(tick)
			click(flip)
			scene.key(KeyEvent{target: whole, key: Key.Space})
			click(radio)
			click(radio)
			click(off)
			assert controlLog.join(",") == "agreed true,agreed false,wrap true,wrap false,small"

			// A press on the slider's track puts the value there, rounded to the step; a
			// drag follows the pointer past the end and stops at the range.
			controlLog = string[]
			let (left, top, width, height) = box(slider)
			let at = def (part float) Point<Pixels> {
				return new Point<Pixels>((left + 8.0 + part * (width - 16.0)) * 1(px), (top + height / 2.0) * 1(px))
			}
			scene.pointer(PointerPhase.Down, at(0.52))
			scene.pointer(PointerPhase.Move, at(0.78))
			scene.pointer(PointerPhase.Move, new Point<Pixels>((left + width + 300.0) * 1(px), 0(px)))
			scene.pointer(PointerPhase.Up, new Point<Pixels>((left + width + 300.0) * 1(px), 0(px)))
			assert controlLog.join(",") == "level 50,level 80,level 100"

			// The arrows move it a step, Home and End to the ends; at an end nothing is told.
			controlLog = string[]
			scene.key(KeyEvent{target: whole, key: Key.Left})
			scene.key(KeyEvent{target: whole, key: Key.Right})
			scene.key(KeyEvent{target: whole, key: Key.Right})
			scene.key(KeyEvent{target: whole, key: Key.Home})
			scene.key(KeyEvent{target: whole, key: Key.Down})
			assert controlLog.join(",") == "level 90,level 100,level 0"

			// A progress bar at a half is filled with the accent on its first half only.
			let surface = new canvas.Canvas(400, 300)
			scene.arrange(new Size<Pixels>(400(px), 300(px)))
			scene.paint(surface)
			let (barLeft, barTop, barWidth, barHeight) = box(bar)
			let within = def (part float) string {
				return shade(surface, new Point<Pixels>((barLeft + part * barWidth) * 1(px), (barTop + barHeight / 2.0) * 1(px)))
			}
			assert within(0.25) != within(0.75) && within(0.1) == within(0.4) && within(0.6) == within(0.9)
		}

		// A toggle button turns on and off; a tab strip makes the tab under a press
		// current and moves with the arrows, Home and End, round the ends; a picture is as
		// large as its pixels and drawn in its colours; a badge and a spinner draw.
		@test()
		def TestMoreControls() {
			controlLog = string[]
			galleryTab[0] = 0
			let page = Gallery()
			let scene = new Scene(page)
			scene.arrange(new Size<Pixels>(400(px), 300(px)))
			let column = page.children[0]
			let (toggle, strip, badge, picture, spinner) = (column.children[0], column.children[1], column.children[2], column.children[3], column.children[4])

			scene.pointer(PointerPhase.Down, middle(toggle))
			scene.pointer(PointerPhase.Up, middle(toggle))
			scene.pointer(PointerPhase.Down, middle(toggle))
			scene.pointer(PointerPhase.Up, middle(toggle))
			assert controlLog.join(",") == "bold true,bold false"

			// Three tabs side by side, each as wide as its title and its padding.
			controlLog = string[]
			let (stripLeft, stripTop, stripWidth, stripHeight) = box(strip)
			assert stripWidth > 3.0 * 24.0 && stripHeight >= 28.0
			let onTab = def (part float) Point<Pixels> {
				return new Point<Pixels>((stripLeft + stripWidth * part) * 1(px), (stripTop + stripHeight / 2.0) * 1(px))
			}
			scene.pointer(PointerPhase.Down, onTab(0.95))
			scene.pointer(PointerPhase.Up, onTab(0.95))
			scene.pointer(PointerPhase.Down, onTab(0.05))
			scene.pointer(PointerPhase.Up, onTab(0.05))
			scene.pointer(PointerPhase.Down, onTab(0.05))
			scene.pointer(PointerPhase.Up, onTab(0.05))
			scene.arrange(new Size<Pixels>(400(px), 300(px)))
			let whole component = page
			scene.key(KeyEvent{target: whole, key: Key.Left})
			scene.arrange(new Size<Pixels>(400(px), 300(px)))
			scene.key(KeyEvent{target: whole, key: Key.Right})
			scene.arrange(new Size<Pixels>(400(px), 300(px)))
			scene.key(KeyEvent{target: whole, key: Key.End})
			assert controlLog.join(",") == "tab 2,tab 0,tab 2,tab 0,tab 2"

			let (pictureLeft, pictureTop, pictureWidth, pictureHeight) = box(picture)
			let (_, _, badgeWidth, badgeHeight) = box(badge)
			let (_, _, spinnerWidth, spinnerHeight) = box(spinner)
			assert pictureWidth == 40.0 && pictureHeight == 20.0
			assert badgeWidth > badgeHeight && spinnerWidth == 20.0 && spinnerHeight == 20.0
			let surface = new canvas.Canvas(400, 300)
			scene.arrange(new Size<Pixels>(400(px), 300(px)))
			scene.paint(surface)
			assert shade(surface, new Point<Pixels>((pictureLeft + 20.0) * 1(px), (pictureTop + 10.0) * 1(px))) == "255,0,0"
		}

		// A dropdown opens its list under its button and a pick selects and closes; a grid
		// puts its children in equal columns, row by row; a dialog sits in the middle of the
		// window, takes every press while it is open, and Escape closes it.
		@test()
		def TestDropdownGridDialog() {
			controlLog = string[]
			sizePicked[0] = 1
			asking[0] = false
			let desk = Desk()
			let scene = new Scene(desk)
			let lay = def () {
				scene.arrange(new Size<Pixels>(400(px), 300(px)))
			}
			lay()
			// A component that is not shown takes no room.
			let seen = def (c component) bool {
				return float(c.style.geom.frame.width) > 0.0
			}
			let column = desk.children[0]
			let (dropdown, grid, askButton, dialog) = (column.children[0], column.children[1], column.children[2], column.children[3])
			let click = def (at Point<Pixels>) {
				scene.pointer(PointerPhase.Down, at)
				scene.pointer(PointerPhase.Up, at)
				lay()
				lay()
			}

			// Two columns as wide as the widest button, the third child under the first.
			let (oneLeft, oneTop, oneWidth, _) = box(grid.children[0])
			let (twoLeft, twoTop, twoWidth, _) = box(grid.children[1])
			let (threeLeft, threeTop, threeWidth, _) = box(grid.children[2])
			let (fourLeft, _, fourWidth, _) = box(grid.children[3])
			let widest = oneWidth.max(twoWidth).max(threeWidth).max(fourWidth)
			assert oneTop == twoTop && twoLeft == oneLeft + widest + 4.0 && fourLeft == twoLeft
			assert threeLeft == oneLeft && threeTop > oneTop

			// The list is hidden until the button is pressed; its lines are as wide as the list.
			let (trigger, list) = (dropdown.children[0], dropdown.children[1])
			assert !seen(list)
			click(middle(trigger))
			assert seen(list) && list.children.len() == 3
			let (_, _, firstWidth, _) = box(list.children[0])
			let (_, _, lastWidth, _) = box(list.children[2])
			assert firstWidth == lastWidth && firstWidth > 40.0
			// The open list has the focus on its first line; a pick gives it back to the button.
			assert scene.focused() == list.children[0]
			click(middle(list.children[2]))
			assert controlLog.join(",") == "size 2" && !seen(list)
			assert scene.focused() == trigger
			// Picking the selected one again closes the list and tells nothing.
			click(middle(trigger))
			click(middle(list.children[2]))
			assert controlLog.join(",") == "size 2"

			// The dialog: centred, and a press on the page behind it does nothing.
			controlLog = string[]
			assert !seen(dialog)
			click(middle(askButton))
			assert seen(dialog)
			let (dialogLeft, dialogTop, dialogWidth, dialogHeight) = box(dialog)
			assert (dialogLeft + dialogWidth / 2.0 - 200.0).abs() <= 1.0 && (dialogTop + dialogHeight / 2.0 - 150.0).abs() <= 1.0
			click(middle(trigger))
			assert !seen(list) && seen(dialog)
			// The focus moved into the dialog, Tab keeps it there, and closing the dialog
			// gives it back to the button that had it.
			// Its title is a heading above what it holds.
			assert dialog.children.len() == 3 && dialog.children[0] is Heading
			let fine = dialog.children[2]
			assert fine.focused && !askButton.focused
			let whole component = desk
			scene.key(KeyEvent{target: whole, key: Key.Tab})
			assert fine.focused
			scene.key(KeyEvent{target: whole, key: Key.Escape})
			lay()
			assert !seen(dialog) && controlLog.join(",") == "closed" && askButton.focused
		}

		// One frame of a page of forty controls as the service makes it: the views run
		// again, the styles are read, the tree is laid out and recorded as draw commands.
		@benchmark()
		def FrameOfFortyControls() {
			busyScene = new Scene(Busy()) when busyScene is none
			let scene = busyScene
			return when scene is none
			scene.arrange(new Size<Pixels>(900(px), 640(px)))
			busyFrame.resetWithSize(new Size(900.0, 640.0))
			scene.paint(busyFrame)
		}

		// The same page laid out only.
		@benchmark()
		def ArrangeFortyControls() {
			busyScene = new Scene(Busy()) when busyScene is none
			let scene = busyScene
			return when scene is none
			scene.arrange(new Size<Pixels>(900(px), 640(px)))
		}

		// A toolbar spans its container and a spacer pushes what follows to its end; a
		// link runs its handler; a heading is larger the lower its level; breadcrumbs pick
		// an earlier step and not the last; layered children share one place.
		@test()
		def TestShellComponents() {
			controlLog = string[]
			let shell = Shell()
			let scene = new Scene(shell)
			scene.arrange(new Size<Pixels>(400(px), 300(px)))
			let (toolbar, large, small, crumbs, layered, status) = (shell.children[0], shell.children[1], shell.children[2], shell.children[3], shell.children[4], shell.children[5])
			let (barLeft, _, barWidth, _) = box(toolbar)
			let link = toolbar.children[3]
			// The toolbar's gap is the one it was given.
			let (runLeft, _, runWidth, _) = box(toolbar.children[0])
			let (stopLeft, _, _, _) = box(toolbar.children[1])
			assert stopLeft == runLeft + runWidth + 20.0
			let (linkLeft, _, linkWidth, _) = box(link)
			let (_, _, statusWidth, _) = box(status)
			assert barWidth == 400.0 && statusWidth == 400.0
			assert linkLeft + linkWidth == barLeft + barWidth - 8.0

			scene.pointer(PointerPhase.Down, middle(link))
			scene.pointer(PointerPhase.Up, middle(link))
			assert controlLog.join(",") == "link"

			let (_, _, _, largeHeight) = box(large)
			let (_, _, _, smallHeight) = box(small)
			assert largeHeight > smallHeight * 1.5

			controlLog = string[]
			let (crumbLeft, crumbTop, crumbWidth, crumbHeight) = box(crumbs)
			let onStep = def (part float) Point<Pixels> {
				return new Point<Pixels>((crumbLeft + crumbWidth * part) * 1(px), (crumbTop + crumbHeight / 2.0) * 1(px))
			}
			scene.pointer(PointerPhase.Down, onStep(0.97))
			scene.pointer(PointerPhase.Up, onStep(0.97))
			scene.pointer(PointerPhase.Down, onStep(0.05))
			scene.pointer(PointerPhase.Up, onStep(0.05))
			assert controlLog.join(",") == "crumb 0"

			let (pictureLeft, pictureTop, _, _) = box(layered.children[0])
			let (badgeLeft, badgeTop, _, _) = box(layered.children[1])
			assert pictureLeft == badgeLeft && pictureTop == badgeTop
		}

		// A text field tells its `onChange` the text after each change of the text, and
		// nothing when only the caret moved.
		@test()
		def TestTextFieldTellsChanges() {
			fieldLog = string[]
			let page = Form()
			let scene = new Scene(page)
			scene.arrange(new Size<Pixels>(400(px), 200(px)))
			let first = page.children[0]
			scene.pointer(PointerPhase.Down, middle(first))
			scene.pointer(PointerPhase.Up, middle(first))
			let whole component = page
			scene.key(KeyEvent{target: whole, key: Key.End})
			scene.text("!")
			scene.key(KeyEvent{target: whole, key: Key.Home})
			scene.key(KeyEvent{target: whole, key: Key.Right})
			scene.key(KeyEvent{target: whole, key: Key.Backspace})
			assert fieldLog.join(",") == "hello!,ello!"
		}

		// Closing a scene takes its components apart: each lets go of its children, so a
		// child that holds a method of its parent as a handler no longer keeps the tree
		// alive. The same root in a new scene builds its children again.
		@test()
		def TestCloseLetsGo() {
			let desk = Desk()
			let scene = new Scene(desk)
			let size = new Size<Pixels>(400(px), 300(px))
			scene.arrange(size)
			let column = desk.children[0]
			let dropdown = column.children[0]
			assert column.children.len() == 4 && dropdown.children.len() == 2
			scene.close()
			assert desk.children.len() == 0 && column.children.len() == 0 && dropdown.children.len() == 0

			let again = new Scene(desk)
			again.arrange(size)
			assert desk.children.len() == 1 && desk.children[0].children.len() == 4
			again.close()
		}
		// A press on a label gives the focus to the control after it; a context menu opens
		// where the secondary button comes up on its parent, the arrows move among its
		// enabled lines, and a pick closes it.
		@test()
		def TestLabelAndContextMenu() {
			filePicks = string[]
			let files = Files()
			let scene = new Scene(files)
			let lay = def () {
				scene.arrange(new Size<Pixels>(400(px), 300(px)))
				scene.arrange(new Size<Pixels>(400(px), 300(px)))
			}
			lay()
			let column = files.children[0]
			let (label, field, panel) = (column.children[0], column.children[1], column.children[3])
			let menu = panel.children[1]
			let seen = def (c component) bool {
				return float(c.style.geom.frame.width) > 0.0
			}

			scene.pointer(PointerPhase.Down, middle(label))
			scene.pointer(PointerPhase.Up, middle(label))
			lay()
			assert scene.focused() == field && !seen(menu)

			// The menu's start corner is where the button came up.
			let at = middle(panel.children[0])
			scene.pointer(PointerPhase.Down, at, MouseButton.Right)
			scene.pointer(PointerPhase.Up, at, MouseButton.Right)
			lay()
			let (left, top, _, _) = box(menu)
			assert seen(menu) && left == float(at.x) && top == float(at.y)
			let (rename, never, delete) = (menu.children[0], menu.children[1], menu.children[2])
			assert scene.focused() == rename

			// Down skips the line that is not enabled and goes round; Up comes back.
			let whole component = files
			scene.key(KeyEvent{target: whole, key: Key.Down})
			lay()
			assert scene.focused() == delete
			scene.key(KeyEvent{target: whole, key: Key.Down})
			lay()
			assert scene.focused() == rename
			scene.key(KeyEvent{target: whole, key: Key.Up})
			lay()
			assert scene.focused() == delete && never.enabled == false

			// Enter picks the focused line: the menu closes and its line loses the focus,
			// which nothing had before (the press that opened the menu was on plain text).
			scene.key(KeyEvent{target: whole, key: Key.Enter})
			lay()
			assert filePicks.join(",") == "delete,closed" && !seen(menu)
			assert scene.focused() == whole

			// A press elsewhere closes it too.
			scene.pointer(PointerPhase.Down, at, MouseButton.Right)
			scene.pointer(PointerPhase.Up, at, MouseButton.Right)
			lay()
			assert seen(menu)
			scene.pointer(PointerPhase.Down, new Point<Pixels>(390(px), 290(px)))
			scene.pointer(PointerPhase.Up, new Point<Pixels>(390(px), 290(px)))
			lay()
			assert !seen(menu) && filePicks.join(",") == "delete,closed,closed"
			scene.close()
		}

		// A tooltip shows under the pointer once it rested on a component that has one,
		// lets the pointer through, and goes on a press.
		@test()
		def TestTooltip() {
			let files = Files()
			let scene = new Scene(files)
			scene.tipDelay = 0s
			let size = new Size<Pixels>(400(px), 300(px))
			scene.arrange(size)
			let button = files.children[0].children[2]
			let nodes = def () int {
				return scene.tree.children.len()
			}
			assert nodes() == 1

			let at = middle(button)
			scene.pointer(PointerPhase.Move, at)
			scene.arrange(size)
			assert nodes() == 2
			let tip = scene.tree.children[1]
			let frame = tip.geom.frame
			assert float(frame.left) == float(at.x) && float(frame.top) == float(at.y) + 20.0
			assert float(frame.width) > 40.0 && float(frame.height) > 10.0
			let inside = new Point<Pixels>(frame.left + 3(px), frame.top + 3(px))
			assert scene.hit(inside) != button
			assert scene.hit(at) == button

			// Still there while the pointer stays on the button; gone on a press, and it
			// does not come back until the pointer went to another component.
			scene.pointer(PointerPhase.Move, new Point<Pixels>(at.x + 2(px), at.y))
			scene.arrange(size)
			assert nodes() == 2
			scene.pointer(PointerPhase.Down, at)
			scene.pointer(PointerPhase.Up, at)
			scene.arrange(size)
			assert nodes() == 1
			scene.pointer(PointerPhase.Move, at)
			scene.arrange(size)
			assert nodes() == 1

			// Tab onto the button shows it under the button.
			let field = files.children[0].children[1]
			scene.pointer(PointerPhase.Down, middle(field))
			scene.pointer(PointerPhase.Up, middle(field))
			let whole component = files
			scene.key(KeyEvent{target: whole, key: Key.Tab})
			scene.arrange(size)
			assert scene.focused() == button && nodes() == 2
			let (buttonLeft, buttonTop, _, buttonHigh) = box(button)
			let under = scene.tree.children[1].geom.frame
			assert float(under.left) == buttonLeft && float(under.top) == buttonTop + buttonHigh + 4.0
			scene.close()
		}
		// A search field tells what is typed, runs the search on Enter, and is emptied by
		// Escape or the cross at its end, which is there only while it holds text.
		@test()
		def TestSearchField() {
			benchLog = string[]
			benchQuery[0] = ""
			let page = Lookup()
			let scene = new Scene(page)
			let lay = def () {
				scene.arrange(new Size<Pixels>(400(px), 200(px)))
			}
			lay()
			let search = page.children[0]
			let field = search.children[0]
			assert search.children.len() == 1
			let (_, fieldTop, fieldWide, _) = box(field)
			// The cross is not there while the field is empty: a press at its end is a
			// press in the field.
			scene.pointer(PointerPhase.Down, atEnd(field))
			scene.pointer(PointerPhase.Up, atEnd(field))
			assert benchLog.len() == 0
			let whole component = page
			let press = def (key Key) {
				scene.key(KeyEvent{target: whole, key: key})
				lay()
			}

			scene.pointer(PointerPhase.Down, middle(field))
			scene.pointer(PointerPhase.Up, middle(field))
			assert scene.text("ab")
			lay()
			assert benchLog.join(",") == "q:ab"
			press(Key.Enter)
			assert benchLog.join(",") == "q:ab,go:ab"

			// Escape empties it; with nothing in it Escape is not its key.
			press(Key.Escape)
			assert benchLog.join(",") == "q:ab,go:ab,q:" && scene.focused() == field
			if field is TextField {
				assert field.value == ""
			}
			press(Key.Escape)
			assert benchLog.len() == 3

			// The cross empties it and the field has the focus again.
			scene.text("x")
			lay()
			scene.pointer(PointerPhase.Down, atEnd(field))
			scene.pointer(PointerPhase.Up, atEnd(field))
			lay()
			lay()
			assert benchLog.join(",") == "q:ab,go:ab,q:,q:x,q:" && scene.focused() == field
			scene.close()
		}

		// Panes share the width by their sizes and a drag of the divider moves it, no
		// pane under the least; of the pages of a `Tabs` the current one shows under the
		// strip; a text area moves its caret between lines and scrolls to keep it seen.
		@test()
		def TestSplitTabsTextArea() {
			benchLog = string[]
			benchPage[0] = 0
			let bench = Bench()
			let scene = new Scene(bench)
			let size = new Size<Pixels>(400(px), 300(px))
			let lay = def () {
				scene.arrange(size)
				scene.arrange(size)
			}
			lay()
			let split = bench.children[0]
			let (files, tabs) = (split.children[0], split.children[1])
			let (_, _, filesWide, filesHigh) = box(files)
			let (tabsLeft, _, tabsWide, _) = box(tabs)
			assert (filesWide - 393.0 / 4.0).abs() < 1.0 && (tabsWide - 393.0 * 3.0 / 4.0).abs() < 1.0
			assert (tabsLeft - filesWide - 7.0).abs() < 0.01 && filesHigh == 300.0

			// The divider follows the pointer, and stops where a pane would be under 40.
			let grip = new Point<Pixels>((filesWide + 3.0) * 1(px), 150(px))
			scene.pointer(PointerPhase.Down, grip)
			scene.pointer(PointerPhase.Move, new Point<Pixels>(grip.x + 50(px), 150(px)))
			lay()
			let (_, _, widened, _) = box(files)
			assert (widened - filesWide - 50.0).abs() < 1.0 && benchLog.join(",") == "split 2"
			scene.pointer(PointerPhase.Move, new Point<Pixels>(2(px), 150(px)))
			scene.pointer(PointerPhase.Up, new Point<Pixels>(2(px), 150(px)))
			lay()
			let (_, _, narrow, _) = box(files)
			assert (narrow - 40.0).abs() < 0.5

			// The strip is on top, the first page under it, the second not shown.
			let seen = def (c component) bool {
				return float(c.style.geom.frame.width) > 0.0
			}
			let (strip, first, second) = (tabs.children[0], tabs.children[1], tabs.children[2])
			let (_, tabsTop, _, _) = box(tabs)
			let (stripLeft, stripTop, _, stripHigh) = box(strip)
			let (_, firstTop, _, _) = box(first)
			assert seen(first) && !seen(second) && stripTop == tabsTop && firstTop == stripTop + stripHigh

			// Right on the strip shows the second page.
			let whole component = bench
			let press = def (key Key) {
				scene.key(KeyEvent{target: whole, key: key})
			}
			let title = new Point<Pixels>((stripLeft + 14.0) * 1(px), (stripTop + stripHigh / 2.0) * 1(px))
			scene.pointer(PointerPhase.Down, title)
			scene.pointer(PointerPhase.Up, title)
			press(Key.Right)
			lay()
			assert benchLog.join(",").endsWith("page 1") && !seen(first) && seen(second)
			press(Key.Left)
			lay()
			assert seen(first) && !seen(second)
			// A page the caller makes current shows on the frame that passes it.
			benchPage[0] = 1
			scene.arrange(size)
			assert !seen(first) && seen(second)
			benchPage[0] = 0
			scene.arrange(size)
			assert seen(first) && !seen(second)

			// The area is two lines high. A press at its start, then Down, End, Home.
			let area = first.children[0]
			let (areaLeft, areaTop, _, _) = box(area)
			if area is TextArea {
				let high = area.lineHigh()
				assert (float(area.style.geom.content.height) - high * 2.0).abs() <= 1.0
				let start = new Point<Pixels>((areaLeft + 9.0) * 1(px), (areaTop + 8.0) * 1(px))
				scene.pointer(PointerPhase.Down, start)
				scene.pointer(PointerPhase.Up, start)
				assert area.focused && area.selection().start == 0
				press(Key.Down)
				assert area.selection().start == 4
				press(Key.End)
				assert area.selection().start == 7
				// Down from the end of "two" lands inside "three", and scrolls it into sight.
				press(Key.Down)
				let third = area.selection().start
				assert third > 8 && third <= 13 && area.shift > 0.0
				press(Key.Home)
				assert area.selection().start == 8
				// Up twice keeps to the left edge; the text is back at its top.
				press(Key.Up)
				press(Key.Up)
				assert area.selection().start == 0 && area.shift == 0.0

				// Enter starts a line; typing goes after it.
				press(Key.End)
				press(Key.Enter)
				assert scene.text("x") && area.value == "one\nx\ntwo\nthree" && area.selection().start == 5

				// Shift+Down selects to the same place a line below; it draws.
				press(Key.LeftShift)
				press(Key.Down)
				scene.keyUp(Key.LeftShift)
				assert area.selection().start == 5 && area.selection().end == 7
				let surface = new canvas.Canvas(400, 300)
				scene.paint(surface)

				// The wheel scrolls as far as the text goes.
				press(Key.LeftControl)
				press(Key.End)
				scene.keyUp(Key.LeftControl)
				assert area.selection().start == area.value.len() && area.shift > 0.0
				let far = area.shift
				scene.pointer(PointerPhase.Scroll, start, MouseButton.Left, new Point<Pixels>(0(px), -500(px)))
				assert area.shift == 0.0
				scene.pointer(PointerPhase.Scroll, start, MouseButton.Left, new Point<Pixels>(0(px), 500(px)))
				assert area.shift == far
			}
			scene.close()
		}
		// A menu bar opens the menu under the title pressed and the one beside it for
		// Right; a number field steps, stays inside its limits and takes typed numbers;
		// a combo box lists the options that match, Down goes into the list and a pick
		// fills the field; a split button runs its action or one from its menu.
		@test()
		def TestBarsAndFields() {
			kitLog = string[]
			kitCount[0] = 3.0
			kitCity[0] = ""
			kitToast[0] = false
			let kit = Kit()
			let scene = new Scene(kit)
			let size = new Size<Pixels>(400(px), 400(px))
			let lay = def () {
				scene.arrange(size)
				scene.arrange(size)
			}
			lay()
			let seen = def (c component) bool {
				return float(c.style.geom.frame.width) > 0.0
			}
			let click = def (at Point<Pixels>) {
				scene.pointer(PointerPhase.Down, at)
				scene.pointer(PointerPhase.Up, at)
				lay()
			}
			let whole component = kit
			let press = def (key Key) {
				scene.key(KeyEvent{target: whole, key: key})
				lay()
			}
			let column = kit.children[0]
			let (bar, number, combo, split) = (column.children[0], column.children[1], column.children[2], column.children[3])

			// The bar: File opens under its title with its first line focused, Right opens
			// Edit, Escape closes it; a pick runs and closes.
			let (file, edit) = (bar.children[0], bar.children[1])
			let (barLeft, barTop, _, barHigh) = box(bar)
			let onFile = new Point<Pixels>((barLeft + 12.0) * 1(px), (barTop + barHigh / 2.0) * 1(px))
			assert !seen(file) && !seen(edit) && file.children.len() == 3
			click(onFile)
			let (fileLeft, fileTop, _, _) = box(file)
			assert seen(file) && !seen(edit) && fileLeft == barLeft && fileTop >= barTop + barHigh
			assert scene.focused() == file.children[0]
			let (_, _, _, separatorHigh) = box(file.children[1])
			assert separatorHigh < 12.0 && separatorHigh > 0.0
			press(Key.Right)
			let (editLeft, _, _, _) = box(edit)
			assert !seen(file) && seen(edit) && editLeft > fileLeft
			press(Key.Escape)
			assert !seen(edit)
			click(onFile)
			click(middle(file.children[0]))
			assert kitLog.join(",") == "run" && !seen(file)

			// The line's shortcut picks it from anywhere in the window; with Shift held too
			// it is another key.
			kitLog = string[]
			press(Key.LeftControl)
			press(Key.N)
			assert kitLog.join(",") == "run"
			press(Key.LeftShift)
			press(Key.N)
			scene.keyUp(Key.LeftShift)
			scene.keyUp(Key.LeftControl)
			assert kitLog.join(",") == "run"

			// The number field: the buttons step and stop at the limit, Down steps back,
			// a typed number is taken and text that is none is dropped on Enter.
			kitLog = string[]
			let digits = number.children[0]
			assert number.children.len() == 1
			click(atEnd(digits, 2))
			click(atEnd(digits, 2))
			click(atEnd(digits, 2))
			assert kitLog.join(",") == "count 4,count 5" && kitCount[0] == 5.0
			click(middle(digits))
			press(Key.Down)
			assert kitLog.join(",") == "count 4,count 5,count 4"
			click(atEnd(digits, 3))
			click(middle(digits))
			press(Key.LeftControl)
			press(Key.A)
			scene.keyUp(Key.LeftControl)
			assert scene.text("2")
			lay()
			assert kitLog.join(",").endsWith("count 3,count 2")
			scene.text("x")
			lay()
			if digits is TextField {
				assert digits.value == "2x" && kitCount[0] == 2.0
				press(Key.Enter)
				assert digits.value == "2"
				// A number past the limit waits for Enter, which brings it inside; one
				// with more digits than are shown is rounded then.
				press(Key.Backspace)
				scene.text("9")
				lay()
				assert kitCount[0] == 2.0 && digits.value == "9"
				press(Key.Enter)
				assert kitCount[0] == 5.0 && digits.value == "5"
				press(Key.Backspace)
				scene.text("1.6")
				lay()
				assert kitCount[0] == 5.0
				press(Key.Enter)
				assert kitCount[0] == 2.0 && digits.value == "2"
			}

			// The combo box.
			kitLog = string[]
			let (field, list) = (combo.children[0], combo.children[1])
			click(middle(field))
			scene.text("par")
			lay()
			assert seen(list) && list.children.len() == 2 && scene.focused() == field
			press(Key.Down)
			assert scene.focused() == list.children[0]
			press(Key.Down)
			assert scene.focused() == list.children[1]
			press(Key.Enter)
			assert kitLog.join(",") == "city par,city Parma,pick 1" && !seen(list)
			assert scene.focused() == field
			click(atEnd(field))
			assert seen(list) && list.children.len() == 3

			// A press on a line fills the field; the focus returns to the field.
			click(middle(list.children[2]))
			assert kitCity[0] == "Oslo" && !seen(list) && scene.focused() == field

			// The split button.
			kitLog = string[]
			let (main, opener, menu) = (split.children[0], split.children[1], split.children[2])
			click(middle(main))
			assert kitLog.join(",") == "run" && !seen(menu)
			click(middle(opener))
			assert seen(menu) && menu.children.len() == 2
			click(middle(menu.children[1]))
			assert kitLog.join(",") == "run,as 1" && !seen(menu)
			scene.close()
		}

		// A chip's cross removes it; an avatar is a circle's box; opening one section of an
		// accordion closes the other; a toast sits in the end corner until it is pressed;
		// a canvas is drawn by the function it is given.
		@test()
		def TestSmallComponents() {
			kitLog = string[]
			kitToast[0] = false
			let kit = Kit()
			let scene = new Scene(kit)
			let size = new Size<Pixels>(400(px), 400(px))
			let lay = def () {
				scene.arrange(size)
				scene.arrange(size)
			}
			lay()
			let seen = def (c component) bool {
				return float(c.style.geom.frame.width) > 0.0
			}
			let click = def (at Point<Pixels>) {
				scene.pointer(PointerPhase.Down, at)
				scene.pointer(PointerPhase.Up, at)
				lay()
			}
			let column = kit.children[0]
			let (tokens, accordion, toast) = (column.children[4], column.children[5], column.children[6])

			let (chip, avatar) = (tokens.children[0], tokens.children[1])
			let (chipLeft, chipTop, chipWide, chipHigh) = box(chip)
			let (_, _, avatarWide, avatarHigh) = box(avatar)
			assert avatarWide == 32.0 && avatarHigh == 32.0 && chipWide > 40.0
			click(new Point<Pixels>((chipLeft + 6.0) * 1(px), (chipTop + chipHigh / 2.0) * 1(px)))
			assert kitLog.len() == 0
			click(new Point<Pixels>((chipLeft + chipWide - 8.0) * 1(px), (chipTop + chipHigh / 2.0) * 1(px)))
			assert kitLog.join(",") == "removed"

			// The open section shows what it holds; a press on the other's title swaps them.
			kitLog = string[]
			let (general, advanced) = (accordion.children[0], accordion.children[1])
			assert seen(general.children[0]) && !seen(advanced.children[0])
			let (generalLeft, generalTop, _, generalHigh) = box(general)
			let (advancedLeft, advancedTop, _, advancedHigh) = box(advanced)
			assert generalHigh > advancedHigh && advancedHigh == 28.0 + 4.0
			click(new Point<Pixels>((advancedLeft + 30.0) * 1(px), (advancedTop + 10.0) * 1(px)))
			assert !seen(general.children[0]) && seen(advanced.children[0]) && kitLog.join(",") == "general false"
			// A press on what a section holds does not close it.
			click(middle(advanced.children[0]))
			assert seen(advanced.children[0])
			click(new Point<Pixels>((generalLeft + 30.0) * 1(px), (generalTop + 10.0) * 1(px)))
			assert seen(general.children[0]) && !seen(advanced.children[0])

			// The toast: in the end corner, left alone by a press elsewhere, closed by one
			// on it.
			kitLog = string[]
			assert !seen(toast)
			kitToast[0] = true
			lay()
			let (toastLeft, toastTop, toastWide, toastHigh) = box(toast)
			assert seen(toast) && toastLeft + toastWide == 400.0 - 16.0 && toastTop + toastHigh == 400.0 - 16.0
			click(new Point<Pixels>(5(px), 395(px)))
			assert seen(toast) && kitLog.len() == 0
			click(middle(toast))
			assert !seen(toast) && kitLog.join(",") == "toast"
			scene.close()

			// The canvas fills its window and is drawn by its function.
			kitLog = string[]
			let board = new Scene(Canvas(draw = drawKit))
			board.arrange(new Size<Pixels>(120(px), 80(px)))
			board.paint(new canvas.Canvas(120, 80))
			assert kitLog.join(",") == "draw 120"
			board.close()
		}

		// A hover card shows once the pointer rested on its container, goes when the
		// pointer left, and stays when a press inside pinned it, until Escape.
		@test()
		def TestHoverCard() {
			let page = Hovered()
			let scene = new Scene(page)
			let size = new Size<Pixels>(400(px), 300(px))
			let frames = def () {
				scene.arrange(size)
				scene.arrange(size)
				scene.arrange(size)
			}
			frames()
			let panel = page.children[0].children[0]
			let card = panel.children[1]
			let seen = def (c component) bool {
				return float(c.style.geom.frame.width) > 0.0
			}
			let away = new Point<Pixels>(390(px), 290(px))
			assert !seen(card)
			scene.pointer(PointerPhase.Move, middle(panel.children[0]))
			frames()
			let (_, panelTop, _, panelHigh) = box(panel)
			let (_, cardTop, _, _) = box(card)
			assert seen(card) && cardTop == panelTop + panelHigh + 4.0

			// The pointer may go into the card; away from both, the card goes.
			scene.pointer(PointerPhase.Move, middle(card))
			frames()
			assert seen(card)
			scene.pointer(PointerPhase.Move, away)
			frames()
			assert !seen(card)

			// Pinned by a press inside, it stays until Escape.
			scene.pointer(PointerPhase.Move, middle(panel.children[0]))
			frames()
			scene.pointer(PointerPhase.Down, middle(card))
			scene.pointer(PointerPhase.Up, middle(card))
			scene.pointer(PointerPhase.Move, away)
			frames()
			assert seen(card)
			let whole component = page
			scene.key(KeyEvent{target: whole, key: Key.Escape})
			frames()
			assert !seen(card)

			// Sent away with the pointer still on its container, it stays away until the
			// pointer left and came back.
			scene.pointer(PointerPhase.Move, middle(panel.children[0]))
			frames()
			assert seen(card)
			scene.key(KeyEvent{target: whole, key: Key.Escape})
			frames()
			frames()
			assert !seen(card)
			scene.pointer(PointerPhase.Move, away)
			frames()
			scene.pointer(PointerPhase.Move, middle(panel.children[0]))
			frames()
			assert seen(card)
			scene.close()
		}
		// A control writes what the user set to the `@bindable` field it was given, with
		// no handler; two controls on one field follow each other; a field that is not
		// bindable is left alone.
		@test()
		def TestBoundInputs() {
			let bound = Bound()
			let scene = new Scene(bound)
			let size = new Size<Pixels>(400(px), 300(px))
			let lay = def () {
				scene.arrange(size)
				scene.arrange(size)
			}
			lay()
			let click = def (at Point<Pixels>) {
				scene.pointer(PointerPhase.Down, at)
				scene.pointer(PointerPhase.Up, at)
				lay()
			}
			let whole component = bound
			let column = bound.children[0]
			let (agree, slider, field, strip, dropdown, plain) = (column.children[0], column.children[1], column.children[2], column.children[3], column.children[4], column.children[5])

			click(middle(agree))
			assert bound.agreed
			click(middle(agree))
			assert !bound.agreed

			// A press at the slider's middle: half of 0 to 100.
			click(middle(slider))
			assert (bound.volume - 50.0).abs() < 1.0

			click(middle(field))
			assert scene.text("!")
			lay()
			assert bound.name == "ada!"

			// The strip writes the page; the dropdown, given the same field, shows it.
			let (stripLeft, stripTop, _, stripHigh) = box(strip)
			click(new Point<Pixels>((stripLeft + 14.0) * 1(px), (stripTop + stripHigh / 2.0) * 1(px)))
			scene.key(KeyEvent{target: whole, key: Key.Right})
			lay()
			assert bound.page == 1
			if dropdown is Dropdown {
				assert dropdown.selected == 1 && dropdown.shown() == "two"
			}

			// The plain field stays as it was; the checkbox keeps its own state.
			click(middle(plain))
			assert !bound.plain
			if plain is Checkbox {
				assert plain.checked
			}

			// A field of a bindable object kept at module level is written too.
			shared.muted = false
			lay()
			click(middle(column.children[6]))
			assert shared.muted
			scene.close()
		}
		// The pointer is an I-beam over a field's text, an arrow over its icons, a hand
		// over a link and a resize shape over a split pane's divider; a field's icons
		// take room from its text and its trailing icon is pressed; a menu line with a
		// shortcut is wider; a named icon draws in the text's colour and an unknown one
		// draws a box.
		@test()
		def TestIconsAndCursors() {
			kitLog = string[]
			let marked = Marked()
			let scene = new Scene(marked)
			let size = new Size<Pixels>(400(px), 300(px))
			scene.arrange(size)
			let column = marked.children[0]
			let (field, link, plain, keyed, icon, missing) = (column.children[0], column.children[1], column.children[2], column.children[3], column.children[4], column.children[5])
			let (left, top, wide, high) = box(field)

			let overText = new Point<Pixels>((left + wide / 2.0) * 1(px), (top + high / 2.0) * 1(px))
			scene.pointer(PointerPhase.Move, overText)
			assert scene.cursor == Cursor.Text
			scene.pointer(PointerPhase.Move, atEnd(field))
			assert scene.cursor == Cursor.Default
			scene.pointer(PointerPhase.Move, middle(link))
			assert scene.cursor == Cursor.Pointer
			scene.pointer(PointerPhase.Move, new Point<Pixels>(390(px), 290(px)))
			assert scene.cursor == Cursor.Default

			// A press on the trailing icon runs its handler and leaves the caret alone; one
			// just after the leading icon puts the caret before the first character.
			scene.pointer(PointerPhase.Down, atEnd(field))
			scene.pointer(PointerPhase.Up, atEnd(field))
			assert kitLog.join(",") == "run"
			if field is TextField {
				assert field.selection().start == 3
				let start = new Point<Pixels>((left + 8.0 + 16.0 + 6.0 + 1.0) * 1(px), (top + high / 2.0) * 1(px))
				scene.pointer(PointerPhase.Down, start)
				scene.pointer(PointerPhase.Up, start)
				assert field.selection().start == 0
				let (spanLeft, spanRight) = field.textSpan()
				assert spanLeft == 8.0 + 22.0 && spanRight == wide - 8.0 - 22.0
			}

			let (_, _, plainWide, _) = box(plain)
			let (_, _, keyedWide, _) = box(keyed)
			assert plainWide == keyedWide
			if plain is MenuItem && keyed is MenuItem {
				assert float(keyed.measure(Limit{}).width) > float(plain.measure(Limit{}).width) + 40.0
			}

			// The icon is 16 a side, drawn in the foreground colour; the unknown one is a box.
			let (iconLeft, iconTop, iconWide, iconHigh) = box(icon)
			let (missingLeft, missingTop, _, _) = box(missing)
			assert iconWide == 16.0 && iconHigh == 16.0
			let surface = new canvas.Canvas(400, 300)
			scene.paint(surface)
			// The magnifier's glass passes the left of its ring; its middle is empty.
			assert shade(surface, new Point<Pixels>((iconLeft + 3.0) * 1(px), (iconTop + 7.0) * 1(px))) != shade(surface, new Point<Pixels>((iconLeft + 7.0) * 1(px), (iconTop + 7.0) * 1(px)))
			assert shade(surface, new Point<Pixels>(missingLeft * 1(px), (missingTop + 8.0) * 1(px))) != shade(surface, new Point<Pixels>((missingLeft + 8.0) * 1(px), (missingTop + 8.0) * 1(px)))
			scene.close()

			// A split pane's divider.
			let bench = Bench()
			let panes = new Scene(bench)
			panes.arrange(size)
			panes.arrange(size)
			let (_, _, filesWide, _) = box(bench.children[0].children[0])
			panes.pointer(PointerPhase.Move, new Point<Pixels>((filesWide + 3.0) * 1(px), 150(px)))
			assert panes.cursor == Cursor.ResizeColumn
			panes.pointer(PointerPhase.Move, new Point<Pixels>(20(px), 150(px)))
			assert panes.cursor == Cursor.Default
			panes.close()
		}
		// An arrow of a number field steps when it is pressed, and again while it is held:
		// after a pause, then at a steady rate, until the button comes up.
		@test()
		def TestHeldArrowRepeats() {
			kitLog = string[]
			kitCount[0] = 1.0
			let kit = Kit()
			let scene = new Scene(kit)
			let size = new Size<Pixels>(400(px), 400(px))
			scene.arrange(size)
			let digits = kit.children[0].children[1].children[0]
			let surface = new canvas.Canvas(400, 400)
			let start = time.now()
			// A frame at that moment.
			let frame = def (at time.Time) {
				scene.draw.setFrameTiming(0s, at)
				scene.arrange(size)
				scene.paint(surface)
			}

			scene.pointer(PointerPhase.Down, atEnd(digits, 2))
			assert kitCount[0] == 2.0
			// Too soon for a repeat.
			frame(start + 100ms)
			assert kitCount[0] == 2.0
			frame(start + 500ms)
			assert kitCount[0] == 3.0
			// The same moment again does not step twice; the next turn does.
			frame(start + 500ms)
			assert kitCount[0] == 3.0
			frame(start + 570ms)
			assert kitCount[0] == 4.0
			scene.pointer(PointerPhase.Up, atEnd(digits, 2))
			frame(start + 2s)
			assert kitCount[0] == 4.0 && kitLog.join(",") == "count 2,count 3,count 4"
			scene.close()
		}
		// A field marked `autofocus` has the focus from the first frame; a double press
		// selects a word and a triple one everything; Control+Z takes typing back; the
		// arrows move among radios and select; the Menu key opens the focused component's
		// context menu, and a letter goes to the next line that starts with it.
		@test()
		def TestEditingAndKeys() {
			choice[0] = "one"
			let keys = Keys()
			let scene = new Scene(keys)
			let size = new Size<Pixels>(400(px), 300(px))
			let lay = def () {
				scene.arrange(size)
				scene.arrange(size)
			}
			lay()
			let whole component = keys
			let press = def (key Key) {
				scene.key(KeyEvent{target: whole, key: key})
				lay()
			}
			let column = keys.children[0]
			let (field, one, two, three, target) = (column.children[0], column.children[1], column.children[2], column.children[3], column.children[4])
			assert scene.focused() == field

			if field is TextField {
				// The second press of a double click on "quick", then a third.
				let (left, top, _, high) = box(field)
				let at = new Point<Pixels>((left + 8.0 + field.caretX(6)) * 1(px), (top + high / 2.0) * 1(px))
				scene.pointer(PointerPhase.Down, at)
				scene.pointer(PointerPhase.Up, at)
				scene.pointer(PointerPhase.Down, at, MouseButton.Left, new Point<Pixels>(0(px), 0(px)), 1.0, 2)
				scene.pointer(PointerPhase.Up, at, MouseButton.Left, new Point<Pixels>(0(px), 0(px)), 1.0, 2)
				assert field.selection().start == 4 && field.selection().end == 9
				scene.pointer(PointerPhase.Down, at, MouseButton.Left, new Point<Pixels>(0(px), 0(px)), 1.0, 3)
				scene.pointer(PointerPhase.Up, at, MouseButton.Left, new Point<Pixels>(0(px), 0(px)), 1.0, 3)
				assert field.selection().start == 0 && field.selection().end == 13

				// Typing over the selection, then Control+Z and Control+Shift+Z.
				scene.text("x")
				assert field.value == "x"
				press(Key.LeftControl)
				press(Key.Z)
				assert field.value == "the quick fox"
				press(Key.LeftShift)
				press(Key.Z)
				scene.keyUp(Key.LeftShift)
				scene.keyUp(Key.LeftControl)
				assert field.value == "x"
			}

			// Tab to the first radio; Down selects the second, Up from the first the third.
			press(Key.Tab)
			assert scene.focused() == one
			press(Key.Down)
			assert scene.focused() == two && choice[0] == "two"
			press(Key.Up)
			press(Key.Up)
			assert scene.focused() == three && choice[0] == "three"

			// The Menu key on the pressable opens its menu; "d" goes to Delete, then to
			// Duplicate, then round to Delete.
			let menu = target.children[1]
			scene.pointer(PointerPhase.Down, middle(target.children[0]))
			scene.pointer(PointerPhase.Up, middle(target.children[0]))
			lay()
			assert scene.focused() == target
			press(Key.Menu)
			assert float(menu.style.geom.frame.width) > 0.0 && scene.focused() == menu.children[0]
			press(Key.D)
			assert scene.focused() == menu.children[1]
			press(Key.D)
			assert scene.focused() == menu.children[2]
			press(Key.D)
			assert scene.focused() == menu.children[1]
			press(Key.Escape)
			assert float(menu.style.geom.frame.width) == 0.0
			scene.close()
		}
		// What is in a container that is not enabled is not enabled either: it takes no
		// press, no focus and no Tab. The secondary button on a field opens its menu, where
		// Cut and Copy are off without a selection and Select all selects.
		@test()
		def TestDisabledInsideAndFieldMenu() {
			kitLog = string[]
			gate[0] = false
			let gated = Gated()
			let scene = new Scene(gated)
			let size = new Size<Pixels>(400(px), 300(px))
			let lay = def () {
				scene.arrange(size)
				scene.arrange(size)
			}
			lay()
			let panel = gated.children[0]
			let (button, field) = (panel.children[0], panel.children[1])
			assert button.disabled && field.disabled && button.enabled
			scene.pointer(PointerPhase.Down, middle(button))
			scene.pointer(PointerPhase.Up, middle(button))
			let whole component = gated
			scene.key(KeyEvent{target: whole, key: Key.Tab})
			assert kitLog.len() == 0 && scene.focused() == whole

			gate[0] = true
			lay()
			assert !button.disabled && !field.disabled
			scene.pointer(PointerPhase.Down, middle(button))
			scene.pointer(PointerPhase.Up, middle(button))
			assert kitLog.join(",") == "run"

			// The field's menu is built by the first secondary release and opens there.
			assert field.children.len() == 0
			let at = middle(field)
			scene.pointer(PointerPhase.Down, at, MouseButton.Right)
			scene.pointer(PointerPhase.Up, at, MouseButton.Right)
			let surface = new canvas.Canvas(400, 300)
			lay()
			scene.paint(surface)
			lay()
			assert field.children.len() == 1
			// What the field holds is its `FieldMenu`, which has no box: the menu in it.
			let menu = field.children[0].children[0]
			let (menuLeft, menuTop, menuWide, _) = box(menu)
			assert menuWide > 60.0 && menuLeft == float(at.x) && menuTop == float(at.y)
			// The field is still as large as its text asks, with the menu under it.
			let (_, _, fieldWide, fieldHigh) = box(field)
			assert fieldWide == 200.0 && fieldHigh >= 28.0
			assert menu.children.len() == 5 && menu.children[0].disabled && menu.children[1].disabled && !menu.children[2].disabled
			scene.pointer(PointerPhase.Down, middle(menu.children[4]))
			scene.pointer(PointerPhase.Up, middle(menu.children[4]))
			lay()
			if field is TextField {
				assert field.selection().start == 0 && field.selection().end == 14
			}
			assert float(menu.style.geom.frame.width) == 0.0 && scene.focused() == field

			// The second time the menu opens by itself, with Cut and Copy on.
			scene.pointer(PointerPhase.Down, at, MouseButton.Right)
			scene.pointer(PointerPhase.Up, at, MouseButton.Right)
			lay()
			assert float(menu.style.geom.frame.width) > 60.0 && !menu.children[0].disabled

			// The keys its lines show are the field's own: with the menu closed and the
			// focus on the button, Ctrl+X cuts nothing.
			scene.key(KeyEvent{target: whole, key: Key.Escape})
			lay()
			scene.pointer(PointerPhase.Down, middle(button))
			scene.pointer(PointerPhase.Up, middle(button))
			assert scene.focused() == button && float(menu.style.geom.frame.width) == 0.0
			let held = Modifiers{control: true, mod: true}
			scene.key(KeyEvent{target: whole, key: Key.LeftControl, modifiers: held})
			scene.key(KeyEvent{target: whole, key: Key.X, modifiers: held})
			scene.keyUp(Key.LeftControl)
			if field is TextField {
				assert field.value.len() == 14 && field.selection().end == 14
			}
			scene.close()

			// A text area's bar: the thumb follows a drag, a press under it moves a page.
			benchPage[0] = 0
			let bench = Bench()
			let panes = new Scene(bench)
			panes.arrange(size)
			panes.arrange(size)
			let area = bench.children[0].children[1].children[1].children[0]
			if area is TextArea {
				let (left, top, wide, high) = box(area)
				let (start, track, thumb, length) = area.bar()
				assert track > 0.0 && thumb == start && length < track
				let onThumb = new Point<Pixels>((left + wide - 4.0) * 1(px), (top + thumb + 2.0) * 1(px))
				panes.pointer(PointerPhase.Down, onThumb)
				panes.pointer(PointerPhase.Move, new Point<Pixels>(onThumb.x, onThumb.y + 100(px)))
				panes.pointer(PointerPhase.Up, new Point<Pixels>(onThumb.x, onThumb.y + 100(px)))
				assert area.shift == area.reach() && area.shift > 0.0
				let above = new Point<Pixels>((left + wide - 4.0) * 1(px), (top + start + 1.0) * 1(px))
				panes.pointer(PointerPhase.Down, above)
				panes.pointer(PointerPhase.Up, above)
				assert area.shift == 0.0
				assert high > 0.0
			}
			panes.close()
		}
		// A dialog's footer is a row at its end edge under its content; a tooltip shows the
		// content of its `tip`; a line that opens a menu of its own opens it beside itself
		// under the pointer or for Right, and a pick in it closes both menus.
		@test()
		def TestSlots() {
			let size = new Size<Pixels>(400(px), 300(px))
			let asked = Asked()
			let first = new Scene(asked)
			first.arrange(size)
			first.arrange(size)
			let dialog = asked.children[0]
			assert dialog.children.len() == 3 && dialog.children[0] is Heading && dialog.children[2] is DialogFooter
			let footer = dialog.children[2]
			let (cancel, save) = (footer.children[0], footer.children[1])
			let (dialogLeft, _, dialogWide, _) = box(dialog)
			let (_, bodyTop, _, bodyHigh) = box(dialog.children[1])
			let (cancelLeft, cancelTop, cancelWide, _) = box(cancel)
			let (saveLeft, _, saveWide, _) = box(save)
			assert footer.children.len() == 2 && cancelTop >= bodyTop + bodyHigh
			assert saveLeft == cancelLeft + cancelWide + 8.0 && (saveLeft + saveWide - (dialogLeft + dialogWide - 16.0)).abs() < 1.0
			first.close()

			kitLog = string[]
			let slotted = Slotted()
			let scene = new Scene(slotted)
			let frames = def () {
				scene.arrange(size)
				scene.arrange(size)
				scene.arrange(size)
			}
			frames()
			let seen = def (c component) bool {
				return float(c.style.geom.frame.width) > 0.0
			}
			let column = slotted.children[0]
			let (tooltip, panel) = (column.children[0], column.children[1])

			// The tooltip: its button, then the card, which holds the tip's two texts
			// only while it is open.
			let (button, card) = (tooltip.children[0], tooltip.children[1])
			assert button is Button && card.children.len() == 0 && !seen(card)
			scene.pointer(PointerPhase.Move, middle(button))
			frames()
			assert card.children.len() == 2 && seen(card) && seen(card.children[1])
			let away = new Point<Pixels>(390(px), 290(px))
			scene.pointer(PointerPhase.Move, away)
			frames()
			assert !seen(card)

			// The submenu: the pointer on its line opens it at the line's end; a pick in it
			// closes it and the menu it is in.
			let menu = panel.children[1]
			let at = middle(panel.children[0])
			let open = def () {
				scene.pointer(PointerPhase.Down, at, MouseButton.Right)
				scene.pointer(PointerPhase.Up, at, MouseButton.Right)
				frames()
			}
			open()
			let (plain, more) = (menu.children[0], menu.children[1])
			let inner = more.children[0]
			assert seen(menu) && !seen(inner) && inner.children.len() == 2
			scene.pointer(PointerPhase.Move, middle(more))
			frames()
			let (moreLeft, moreTop, moreWide, moreHigh) = box(more)
			let (innerLeft, _, _, _) = box(inner)
			// It starts where the line ends, so the pointer crosses from the line into it
			// over nothing else, and it stays open with the pointer in it.
			assert seen(inner) && innerLeft == moreLeft + moreWide
			scene.pointer(PointerPhase.Move, new Point<Pixels>((innerLeft - 1.0) * 1(px), (moreTop + moreHigh / 2.0) * 1(px)))
			scene.pointer(PointerPhase.Move, new Point<Pixels>((innerLeft + 1.0) * 1(px), (moreTop + moreHigh / 2.0) * 1(px)))
			frames()
			assert seen(inner)
			// On the line beside it, it closes; back on its own line, it opens again.
			scene.pointer(PointerPhase.Move, middle(plain))
			frames()
			assert !seen(inner) && seen(menu)
			scene.pointer(PointerPhase.Move, middle(more))
			frames()
			assert seen(inner)
			scene.pointer(PointerPhase.Move, middle(inner.children[0]))
			scene.pointer(PointerPhase.Down, middle(inner.children[0]))
			scene.pointer(PointerPhase.Up, middle(inner.children[0]))
			frames()
			assert kitLog.join(",") == "as 0" && !seen(inner) && !seen(menu)

			// By the keys: Down to the line, Right opens its menu with the first line
			// focused, Left closes it and the line has the focus again.
			scene.pointer(PointerPhase.Move, away)
			open()
			assert scene.focused() == plain
			let whole component = slotted
			let press = def (key Key) {
				scene.key(KeyEvent{target: whole, key: key})
				frames()
			}
			press(Key.Down)
			assert scene.focused() == more && !seen(inner)
			press(Key.Right)
			assert seen(inner) && scene.focused() == inner.children[0]
			press(Key.Left)
			assert !seen(inner) && scene.focused() == more
			press(Key.Escape)
			assert !seen(menu)
			scene.close()
		}
		// What a scoped component holds is laid out as its parent's: three buttons a gap
		// apart in one row. The scope is their parent, is hovered and holds the focus with
		// them, hears their keys, disables them,
		// and is told when it enters and leaves the tree.
		@test()
		def TestScopedComponent() {
			scopeLog = string[]
			kitLog = string[]
			gate[0] = true
			scopeShown[0] = true
			let rowed = Rowed()
			let scene = new Scene(rowed)
			let size = new Size<Pixels>(400(px), 300(px))
			let lay = def () {
				scene.arrange(size)
				scene.arrange(size)
			}
			lay()
			let row = rowed.children[0]
			let scope = row.children[0]
			let (one, two, three) = (scope.children[0], scope.children[1], row.children[1])
			assert scope.isScoped && row.children.len() == 2 && scopeLog.join(",") == "attached"
			let (oneLeft, oneTop, oneWide, _) = box(one)
			let (twoLeft, twoTop, twoWide, _) = box(two)
			let (threeLeft, threeTop, _, _) = box(three)
			assert oneTop == twoTop && twoTop == threeTop
			assert twoLeft == oneLeft + oneWide + 10.0 && threeLeft == twoLeft + twoWide + 10.0

			// Hover and focus reach it through what it holds; a key comes up to it.
			scene.pointer(PointerPhase.Move, middle(two))
			assert scope.hover && two.hover && !three.hover
			scene.pointer(PointerPhase.Move, middle(three))
			assert !scope.hover
			scene.pointer(PointerPhase.Down, middle(one))
			scene.pointer(PointerPhase.Up, middle(one))
			assert kitLog.join(",") == "run" && scope.focusWithin && one.focused
			let whole component = rowed
			scene.key(KeyEvent{target: whole, key: Key.F5})
			assert scopeLog.join(",") == "attached,key F5"
			// Tab from the first and from the second button both pass through it.
			scene.key(KeyEvent{target: whole, key: Key.Tab})
			scene.key(KeyEvent{target: whole, key: Key.Tab})
			assert three.focused && !scope.focusWithin

			// Not enabled, it disables what it holds and not the button beside it.
			gate[0] = false
			lay()
			assert one.disabled && two.disabled && !three.disabled
			gate[0] = true

			// Gone from the view, it is told, and the third button is the row's first.
			scopeShown[0] = false
			lay()
			let (movedLeft, _, _, _) = box(three)
			assert scopeLog.join(",") == "attached,key F5,key Tab,key Tab,detached" && movedLeft == oneLeft
			scopeShown[0] = true
			scene.close()
		}
		// A view names its children: a label focuses the field its `target` names though
		// another component stands between them, a popover hangs beside the button its
		// `attach` names, each named child carries its name, and `find` and `closest` reach
		// components by kind and by name.
		@test()
		def TestRefs() {
			let named = Named()
			let scene = new Scene(named)
			let size = new Size<Pixels>(400(px), 300(px))
			let lay = def () {
				scene.arrange(size)
				scene.arrange(size)
				scene.arrange(size)
			}
			lay()
			let column = named.children[0]
			let (label, field, button, popover) = (column.children[0], column.children[2], column.children[3], column.children[4])
			// The popover is under the button, not under the column it is in.
			let (buttonLeft, buttonTop, _, buttonHigh) = box(button)
			let (popLeft, popTop, popWide, _) = box(popover)
			assert popWide > 40.0 && popLeft == buttonLeft && popTop == buttonTop + buttonHigh + 4.0

			// A press on the label (which also closes the popover, being outside it).
			scene.pointer(PointerPhase.Down, middle(label))
			scene.pointer(PointerPhase.Up, middle(label))
			lay()
			assert scene.focused() == field

			assert field.refName == "nameField" && button.refName == "trigger"

			// By kind, by name, and upward.
			let found = named.find<TextField>()
			let byName = named.find<Button>("trigger")
			let wrong = named.find<Button>("nameField")
			assert !(found is none) && !(byName is none) && wrong is none
			if !(found is none) && !(byName is none) {
				assert found.value == "ada" && byName.label == "More"
				let above = found.closest<Column>()
				assert !(above is none)
			}
			scene.close()
		}

		// A control that is activated tells its listeners after it ran its handler:
		// every listener of the kind, and those whose selector matches the control.
		@test()
		def TestClickedEvents() {
			kitLog = string[]
			let clicks = Clicks()
			let scene = new Scene(clicks)
			let size = new Size<Pixels>(400(px), 300(px))
			scene.arrange(size)
			scene.arrange(size)
			let column = clicks.children[0]
			let press = def (c component) {
				scene.pointer(PointerPhase.Down, middle(c))
				scene.pointer(PointerPhase.Up, middle(c))
			}
			clicksHeard = string[]
			press(column.children[0])
			assert kitLog.join(",") == "run" && clicksHeard.join(",") == "button clicked "
			clicksHeard = string[]
			press(column.children[1])
			assert clicksHeard.len() == 2 && clicksHeard.includes("button clicked second") && clicksHeard.includes("second")
			clicksHeard = string[]
			press(column.children[2])
			press(column.children[3])
			assert clicksHeard.join(",") == "link,chip" && kitLog.join(",") == "run,run"

			// The other controls tell what they did: a new value, a line that was picked.
			clicksHeard = string[]
			press(column.children[4])
			press(column.children[5])
			press(column.children[6])
			assert clicksHeard.join(",") == "checkbox true,radio changed,line"
			scene.close()
		}

		// The window is dragged by its `WindowDrag`: by the bar and the text in it, not
		// by the button in it nor by what is outside it, and not while it is disabled.
		@test()
		def TestWindowDrag() {
			let framed = Framed()
			let scene = new Scene(framed)
			let size = new Size<Pixels>(400(px), 300(px))
			scene.arrange(size)
			scene.arrange(size)
			let column = framed.children[0]
			let (bar, content) = (column.children[0], column.children[1])
			let (title, button) = (bar.children[0], bar.children[1])
			assert bar is WindowDrag
			let (_, barTop, _, barHigh) = box(bar)
			assert scene.dragsWindow(middle(title)) && !scene.dragsWindow(middle(button)) && !scene.dragsWindow(middle(content))
			// The bar itself, in the room between the title and the button.
			let (buttonLeft, _, _, _) = box(button)
			assert scene.dragsWindow(new Point<Pixels>((buttonLeft - 5.0) * 1(px), (barTop + barHigh / 2.0) * 1(px)))
			assert !scene.dragsWindow(new Point<Pixels>(390(px), 290(px)))
			framed.loose = false
			scene.arrange(size)
			assert !scene.dragsWindow(middle(title))
			scene.close()
		}

		// What is dragged in from another application is offered to the `DropTarget`
		// under it: that one shows `dropTarget` through what it holds while the drag is
		// over it, and a drop goes to the nearest one that takes it.
		@test()
		def TestDropTarget() {
			dropLog = string[]
			let drops = Drops()
			let scene = new Scene(drops)
			let size = new Size<Pixels>(400(px), 300(px))
			scene.arrange(size)
			scene.arrange(size)
			let column = drops.children[0]
			let (outer, apart) = (column.children[0], column.children[1])
			let within = outer.children[0]
			let (inner, loose) = (within.children[0], within.children[1])
			let files = inner.children[0]
			assert outer is DropTarget && inner is DropTarget && !files.dropTarget

			// Over the inner one, then over the outer one, then away.
			assert scene.dragOver(middle(files)) && files.dropTarget && inner.dropTarget && !within.dropTarget
			assert !scene.dragOver(middle(files))
			assert scene.dragOver(middle(loose)) && !files.dropTarget && within.dropTarget
			assert scene.dragOver(middle(apart)) && !within.dropTarget && !scene.dragOver(middle(apart))
			assert scene.dragOver(middle(files)) && scene.dragLeave() && !files.dropTarget && !scene.dragLeave()

			// Files on the inner one are its own; a text there is the outer one's, which
			// takes anything; outside both nothing takes it.
			assert scene.drop(middle(files), DragData{files: ["/tmp/a.txt", "/tmp/b.txt"]})
			assert scene.drop(middle(files), DragData{text: "words"})
			assert !scene.drop(middle(apart), DragData{text: "lost"})
			assert dropLog.join(",") == "inner /tmp/a.txt+/tmp/b.txt,heard 2,outer words,heard 0"
			scene.close()
		}

		// A press in a `Draggable` that moves away drags it: it shows `dragging`, its
		// preview follows the pointer in the Drag layer, the zone under the pointer
		// that takes its data shows `dropTarget` and sets the pointer's shape, and the
		// release drops there. A press that stays is a click; Escape calls a drag off;
		// a slider in a `Draggable` keeps its thumb.
		@test()
		def TestDraggable() {
			dragLog = string[]
			let drags = Drags()
			let scene = new Scene(drags)
			let size = new Size<Pixels>(400(px), 300(px))
			scene.arrange(size)
			scene.arrange(size)
			let column = drags.children[0]
			let (first, second, items, loose, apart) = (column.children[0], column.children[1], column.children[2], column.children[3], column.children[4])
			let (text, button) = (first.children[0], first.children[1])
			let slider = second.children[0]
			let panel = items.children[0]
			let free = loose.children[0]
			assert first is Draggable && items is DropTarget && first.children.len() == 2
			let nodes = def () int {
				return scene.tree.children[0].children.len()
			}
			let count = nodes()
			let near = def (c component, dx float) Point<Pixels> {
				let at = middle(c)
				return new Point<Pixels>(at.x + dx * 1(px), at.y)
			}

			// A press that moves less than the slack drags nothing; further, it does.
			scene.pointer(PointerPhase.Down, middle(text))
			scene.pointer(PointerPhase.Move, near(text, 2.0))
			assert !first.dragging && text.pressed
			scene.pointer(PointerPhase.Move, near(text, 6.0))
			assert first.dragging && text.dragging && button.dragging && !text.pressed && !text.hover
			assert scene.cursor == Cursor.NotAllowed
			scene.arrange(size)
			assert nodes() == count + 1
			// It stands where its `Draggable` is among the column's nodes: after the text and the button.
			let ghost = scene.tree.children[0].children[2]
			assert ghost.box.layer == Layer.Drag
			let spot = near(text, 6.0)
			assert float(ghost.geom.frame.left) == float(spot.x) + 12.0 && float(ghost.geom.frame.top) == float(spot.y) + 12.0

			// Over the left half of the zone that takes items: Copy; over its right
			// half it refuses and nothing further out takes it; the zone that takes
			// anything moves.
			let left = new Point<Pixels>(20(px), middle(panel).y)
			let right = new Point<Pixels>(380(px), middle(panel).y)
			scene.pointer(PointerPhase.Move, left)
			assert panel.dropTarget && items.dropTarget && scene.cursor == Cursor.Copy
			assert !panel.hover
			scene.pointer(PointerPhase.Move, right)
			assert !panel.dropTarget && scene.cursor == Cursor.NotAllowed
			scene.pointer(PointerPhase.Move, middle(free))
			assert free.dropTarget && scene.cursor == Cursor.Move
			scene.arrange(size)
			assert float(scene.tree.children[0].children[2].geom.frame.left) == float(middle(free).x) + 12.0

			// Let go on the left half: dropped there, the drag is over, the preview is
			// gone and what is under the pointer is hovered again.
			scene.pointer(PointerPhase.Move, left)
			scene.pointer(PointerPhase.Up, left)
			assert dragLog.join(",") == "item 7 seven"
			assert !first.dragging && !text.dragging && !panel.dropTarget && scene.cursor == Cursor.Default
			scene.arrange(size)
			assert nodes() == count

			// Let go where nothing takes it: nothing is given it.
			scene.pointer(PointerPhase.Down, middle(text))
			scene.pointer(PointerPhase.Move, right)
			assert first.dragging
			scene.pointer(PointerPhase.Up, right)
			scene.pointer(PointerPhase.Down, middle(text))
			scene.pointer(PointerPhase.Move, middle(apart))
			scene.pointer(PointerPhase.Up, middle(apart))
			assert dragLog.len() == 1 && !first.dragging

			// Escape calls it off: the release that follows drops nothing.
			scene.pointer(PointerPhase.Down, middle(text))
			scene.pointer(PointerPhase.Move, middle(free))
			assert first.dragging && free.dropTarget
			scene.key(KeyEvent{target: drags, key: Key.Escape})
			assert !first.dragging && !free.dropTarget
			scene.pointer(PointerPhase.Up, middle(free))
			assert dragLog.len() == 1

			// The button in it: a press that stays clicks, one that moves away drags
			// and does not click.
			scene.pointer(PointerPhase.Down, middle(button))
			scene.pointer(PointerPhase.Up, middle(button))
			assert dragLog.join(",") == "item 7 seven,clicked" && !first.dragging
			scene.pointer(PointerPhase.Down, middle(button))
			scene.pointer(PointerPhase.Move, middle(free))
			assert first.dragging && !button.pressed
			scene.pointer(PointerPhase.Up, middle(free))
			assert dragLog.join(",") == "item 7 seven,clicked,any seven"

			// The slider takes the moves of a press on it: its `Draggable` is not
			// dragged.
			scene.pointer(PointerPhase.Down, middle(slider))
			scene.pointer(PointerPhase.Move, near(slider, 40.0))
			assert !second.dragging
			scene.pointer(PointerPhase.Up, near(slider, 40.0))
			assert dragLog.len() == 3
			scene.close()

			// A drag tells its handlers and listeners that it began and how it ended;
			// held near the lower edge of something that scrolls, the content moves
			// under it frame after frame, and stops when the pointer leaves the edge.
			dragLog = string[]
			let list = DragList()
			let rows = new Scene(list)
			let box = new Size<Pixels>(200(px), 100(px))
			rows.arrange(box)
			rows.arrange(box)
			let port = list.children[0]
			let row = port.children[0].children[0]
			rows.pointer(PointerPhase.Down, middle(row))
			rows.pointer(PointerPhase.Move, new Point<Pixels>(100(px), 50(px)))
			assert row.dragging && dragLog.join(",") == "began"
			if port is ScrollView {
				rows.arrange(box)
				assert float(port.scrollOffset().y) == 0.0
				rows.pointer(PointerPhase.Move, new Point<Pixels>(100(px), 92(px)))
				rows.arrange(box)
				rows.arrange(box)
				let moved = float(port.scrollOffset().y)
				assert moved == 24.0
				rows.pointer(PointerPhase.Move, new Point<Pixels>(100(px), 50(px)))
				rows.arrange(box)
				assert float(port.scrollOffset().y) == moved
			}
			rows.pointer(PointerPhase.Up, new Point<Pixels>(100(px), 50(px)))
			assert dragLog.join(",") == "began,ended false,heard false"
			rows.close()
		}
	}
}
