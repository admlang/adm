partial module std.ui.components {
	use (
		std.formats.image
		std.gfx.canvas
		std.math.geom::(Edges, Point, Size)
		std.testing
		std.time
		std.ui::(Appearance, ColorScheme, DragData, DropEffect, Key, KeyEvent, Limit, Modifiers, MouseButton, PointerPhase, RenderContext, StateChange, TextKind, UI, kind, ref)
		std.ui.runtime::Scene
		std.ui.styles::*
		std.units::(Extent, Pixels)
	)

	internal let pressLog = string[]

	internal def saved() {
		pressLog.push("save")
	}

	internal def cancelled() {
		pressLog.push("cancel")
	}

	internal def opened() {
		pressLog.push("open")
	}

	internal def asked() {
		pressLog.push("menu")
	}

	style StageStyle {
		Box
	}

	// What the controls of `Settings` reported, and the values it passes them.
	internal let controlLog = string[]
	internal let agreed = [false]
	internal let level = [20.0]

	internal def setAgreed(now bool) {
		agreed[0] = now
		controlLog.push("agreed {now}")
	}

	internal def setWrap(now bool) {
		controlLog.push("wrap {now}")
	}

	internal def pickSmall(on bool) {
		controlLog.push("small")
	}

	internal def setLevel(now float) {
		level[0] = now
		controlLog.push("level {int(now)}")
	}

	// A red picture 40 by 20.
	internal def redPicture() image.Image {
		let picture = new image.Image(40, 20)
		let data = picture.raw()
		for let i = 0; i < data.len(); i += 4 {
			data[i] = byte(255)
			data[i + 3] = byte(255)
		}
		return picture
	}

	internal let galleryPicture = redPicture()
	internal let galleryTab = [0]

	internal def setBold(now bool) {
		controlLog.push("bold {now}")
	}

	internal def showTab(index int) {
		galleryTab[0] = index
		controlLog.push("tab {index}")
	}

	// A toggle button, a tab strip, a badge, a picture and a spinner, in a column.
	component Gallery {
		type {}

		view {
			Column(gap = 6(px)) {
				ToggleButton(label = "Bold", onChange = setBold)
				TabStrip(tabs = ["main.adm", "lib.adm", "notes"], current = galleryTab[0], onChange = showTab)
				Badge(label = "12")
				Image(source = galleryPicture)
				Spinner()
			}
		}

		style StageStyle
	}

	internal let sizePicked = [1]
	internal let asking = [false]

	internal def setSize(index int) {
		sizePicked[0] = index
		controlLog.push("size {index}")
	}

	internal def ask() {
		asking[0] = true
	}

	internal def answered() {
		asking[0] = false
		controlLog.push("closed")
	}

	// A dropdown, a grid of four cells in two columns, and a dialog a button opens.
	component Desk {
		type {
			def new() {
				style.width = 400(px)
				style.height = 300(px)
			}
		}

		view {
			Column(gap = 6(px)) {
				Dropdown(options = ["Small", "Medium", "Large"], selected = sizePicked[0], onChange = setSize)
				Grid(columns = 2, gap = 4(px)) {
					Button(label = "One")
					Button(label = "Two")
					Button(label = "Three")
					Button(label = "Four")
				}
				Button(label = "Ask", onClick = ask)
				Dialog(open = asking[0], title = "Rename", onClose = answered) {
					Text(text = "A dialog over the page.")
					Button(label = "Fine", onClick = answered)
				}
			}
		}

		style StageStyle
	}

	// A page of some forty controls with text, as an application's settings screen has.
	component Busy {
		type {
			def new() {
				style.width = 900(px)
				style.height = 640(px)
			}
		}

		view {
			Column(gap = 8(px)) {
				TabStrip(tabs = ["General", "Editor", "Keys", "About"], current = 1)
				Text(text = "Text is as large as its words and wraps in the width it is given: this line is long enough to show it when the window is narrow.")
				Row(gap = 8(px)) {
					Button(label = "Save")
					Button(label = "Cancel")
					Button(label = "Apply", enabled = false)
					ToggleButton(label = "Bold", on = true)
					ToggleButton(label = "Italic")
					Badge(label = "12")
				}
				Row(gap = 24(px)) {
					Column(gap = 6(px)) {
						Checkbox(label = "Format on save", checked = true)
						Checkbox(label = "Trim trailing spaces")
						Checkbox(label = "Insert final newline", checked = true)
						Switch(label = "Wrap lines", on = true)
						Switch(label = "Show the minimap")
					}
					Column(gap = 6(px)) {
						Radio(label = "Small")
						Radio(label = "Medium", selected = true)
						Radio(label = "Large")
						Slider(value = 40.0)
						ProgressBar(value = 0.4)
					}
				}
				Divider()
				Grid(columns = 4, gap = 6(px)) {
					Button(label = "One")
					Button(label = "Two")
					Button(label = "Three")
					Button(label = "Four")
					Button(label = "Five")
					Button(label = "Six")
					Button(label = "Seven")
					Button(label = "Eight")
				}
				Row(gap = 8(px)) {
					TextField(placeholder = "Name")
					TextField(placeholder = "Email")
					Dropdown(options = ["Small", "Medium", "Large"], selected = 1)
				}
				Text(text = "A second paragraph, so that the page holds about as much text as a screen of settings does, with a few longer words: configuration, indentation, completion.")
			}
		}

		style StageStyle
	}

	internal let busyScene ?Scene = none
	internal let busyFrame = new canvas.DrawContext(new Size(900.0, 640.0))

	internal def followed() {
		controlLog.push("link")
	}

	internal def stepTo(index int) {
		controlLog.push("crumb {index}")
	}

	// An application's frame: a toolbar, a title, where one is, a picture under a badge,
	// and a status bar.
	component Shell {
		type {
			def new() {
				style.width = 400(px)
				style.height = 300(px)
			}
		}

		view {
			Toolbar(gap = 20(px)) {
				Button(label = "Run")
				Button(label = "Stop")
				Spacer()
				Link(label = "Docs", onClick = followed)
			}
			Heading(text = "Install", level = 1)
			Heading(text = "Notes", level = 3)
			Breadcrumbs(items = ["src", "ui", "main.adm"], onSelect = stepTo)
			Layered() {
				Image(source = galleryPicture)
				Badge(label = "new")
			}
			StatusBar() {
				Text(text = "Ln 12, Col 4")
			}
		}

		style StageStyle
	}

	// A box 120 wide with a divider in it.
	component Ruled {
		type {
			def new() {
				style.width = 120(px)
			}
		}

		view {
			Divider()
		}

		style StageStyle
	}

	// One of each control that holds a value, in a column.
	component Settings {
		type {}

		view {
			Column(gap = 6(px)) {
				Checkbox(checked = agreed[0], label = "I agree", onChange = setAgreed)
				Switch(label = "Wrap lines", onChange = setWrap)
				Radio(label = "Small", onChange = pickSmall)
				Slider(value = level[0], step = 10.0, onChange = setLevel)
				ProgressBar(value = 0.5)
				Checkbox(label = "Off", onChange = setAgreed, enabled = false)
			}
		}

		style StageStyle
	}

	// A column holding a row of three buttons and a pressable panel.
	component ToolRow {
		type {}

		view {
			Column(gap = 6(px)) {
				Row(gap = 4(px)) {
					Button(label = "Save", onClick = saved)
					Button(label = "Cancel", action = cancelled)
					Button(label = "Off", onClick = saved, enabled = false)
				}
				Pressable(onClick = opened, onContextMenu = asked) {
					Text(text = "Open the folder")
				}
			}
		}

		style StageStyle
	}

	// Six buttons in a box too short for them.
	component Reader {
		type {
			def new() {
				style.width = 200(px)
				style.height = 100(px)
			}
		}

		view {
			ScrollView() {
				Button(label = "One")
				Button(label = "Two")
				Button(label = "Three")
				Button(label = "Four")
				Button(label = "Five")
				Button(label = "Six")
			}
		}

		style StageStyle
	}

	internal type Tallied {
		count int
	}

	internal let tallied = new Tallied()

	// A text that shows a number kept outside it.
	component Counted {
		type {}

		view {
			Text(text = "Count {tallied.count}")
		}

		style StageStyle
	}

	internal def submitted() {
		pressLog.push("submit")
	}

	// A name field and a password field.
	internal let fieldLog = string[]

	internal def edited(text string) {
		fieldLog.push(text)
	}

	component Form {
		type {}

		view {
			TextField(value = "hello", placeholder = "Name", onSubmit = submitted, onChange = edited)
			TextField(kind = TextKind.Password)
		}

		style StageStyle
	}

	internal type Shown {
		open bool
	}

	internal let menuState = new Shown()

	internal def toggled() {
		menuState.open = !menuState.open
	}

	internal def closed() {
		menuState.open = false
		pressLog.push("closed")
	}

	// A button with a popover under it, in a corner of its page.
	component Corner {
		type {
			// The space left above and before the button.
			@input
			down Extent = 0(px)

			@input
			along Extent = 0(px)

			def new() {
				style.width = fill
				style.height = fill
				style.padding = new Edges<Extent>(down, 0(px), 0(px), along)
			}
		}

		view {
			Column() {
				Button(label = "More", onClick = toggled)
				Popover(open = menuState.open, onClose = closed) {
					Text(text = "What the popover holds")
					Dropdown(options = ["One", "Two"])
				}
			}
		}

		style StageStyle
	}

	internal let filePicks = string[]

	internal def renameFile() {
		filePicks.push("rename")
	}

	internal def deleteFile() {
		filePicks.push("delete")
	}

	internal def menuClosed() {
		filePicks.push("closed")
	}

	// A labelled field, a button with a tooltip, and a panel with a context menu.
	component Files {
		type {
			def new() {
				style.width = 400(px)
				style.height = 300(px)
			}
		}

		view {
			Column(gap = 6(px)) {
				Label(text = "Name")
				TextField(value = "notes.txt")
				Button(label = "Save", tooltip = "Writes the file")
				Panel() {
					Text(text = "notes.txt")
					ContextMenu(onClose = menuClosed) {
						MenuItem(label = "Rename", onActivate = renameFile)
						MenuItem(label = "Never", enabled = false)
						MenuItem(label = "Delete", onActivate = deleteFile)
					}
				}
			}
		}

		style StageStyle
	}

	internal let benchLog = string[]
	internal let benchQuery = [""]
	internal let benchPage = [0]

	internal def setQuery(text string) {
		benchQuery[0] = text
		benchLog.push("q:{text}")
	}

	internal def runSearch(text string) {
		benchLog.push("go:{text}")
	}

	internal def paneResized(shares float[]) {
		benchLog.push("split {shares.len()}")
	}

	internal def showPage(index int) {
		benchPage[0] = index
		benchLog.push("page {index}")
	}

	// A search field alone.
	component Lookup {
		type {}

		view {
			SearchField(value = benchQuery[0], onChange = setQuery, onSubmit = runSearch)
		}

		style StageStyle
	}

	// Two panes: a text, and two pages of which the first holds a text area.
	component Bench {
		type {
			def new() {
				style.width = 400(px)
				style.height = 300(px)
			}
		}

		view {
			SplitPane(sizes = [1.0, 3.0], onResize = paneResized) {
				Text(text = "files")
				Tabs(current = benchPage[0], onChange = showPage) {
					Tab(title = "main.adm") {
						TextArea(value = "one\ntwo\nthree", rows = 2)
					}
					Tab(title = "notes") {
						Text(text = "nothing yet")
					}
				}
			}
		}

		style StageStyle
	}

	internal let kitLog = string[]
	internal let kitCount = [3.0]
	internal let kitCity = [""]
	internal let kitToast = [false]

	internal def setCount(now float) {
		kitCount[0] = now
		kitLog.push("count {int(now)}")
	}

	internal def setCity(now string) {
		kitCity[0] = now
		kitLog.push("city {now}")
	}

	internal def pickedCity(index int) {
		kitLog.push("pick {index}")
	}

	internal def ran() {
		kitLog.push("run")
	}

	// What the listeners of `clicked` heard.
	let clicksHeard = string[]

	@on(Button.clicked)
	internal def heardButton(evt ComponentEvent<bool>) {
		clicksHeard.push("button {evt.name} {evt.source.refName}")
	}

	@on(Button.clicked, ref("second"))
	internal def heardSecond(evt ComponentEvent<bool>) {
		clicksHeard.push("second")
	}

	@on(Link.clicked)
	internal def heardLink(evt ComponentEvent<bool>) {
		clicksHeard.push("link")
	}

	@on(Chip.clicked, kind<Chip>().inside(kind<Clicks>()))
	internal def heardChip(evt ComponentEvent<bool>) {
		clicksHeard.push("chip")
	}

	@on(Checkbox.changed)
	internal def heardCheckbox(evt ComponentEvent<bool>) {
		clicksHeard.push("checkbox {evt.result}")
	}

	@on(Radio.changed, ref("only"))
	internal def heardRadio(evt ComponentEvent<bool>) {
		clicksHeard.push("radio {evt.name}")
	}

	@on(MenuItem.activated, ref("go"))
	internal def heardLine(evt ComponentEvent<bool>) {
		clicksHeard.push("line")
	}

	// What the drop targets of `Drops` were given.
	let dropLog = string[]

	internal def onlyFiles(data DragData) bool {
		return data.files.len() > 0
	}

	internal def tookInner(data DragData, at Point<Pixels>) {
		dropLog.push("inner {data.files.join("+")}")
	}

	internal def tookOuter(data DragData, at Point<Pixels>) {
		dropLog.push("outer {data.text}{data.files.join("+")}")
	}

	@on(DropTarget.dropped)
	internal def heardDrop(evt ComponentEvent<DragData>) {
		dropLog.push("heard {evt.result.files.len()}")
	}

	// A place that takes anything, with a place in it that takes only files, beside a
	// text nothing is dropped on.
	component Drops {
		type {
			def new() {
				style.width = 400(px)
				style.height = 300(px)
			}
		}

		view {
			Column(gap = 10(px)) {
				DropTarget(onDrop = tookOuter) {
					Column(gap = 10(px)) {
						DropTarget(accepts = onlyFiles, onDrop = tookInner) {
							Text("files here")
						}
						Text("anything here")
					}
				}
				Text("nothing here")
			}
		}

		style StageStyle
	}

	// The numbers of the buttons of `ManyTips`.
	internal let tipRows = int[]

	// Five hundred buttons, each in a `Tooltip` with content of its own when `wrapped`.
	component ManyTips {
		type {
			@input
			wrapped bool = false

			def new() {
				style.width = 800(px)
				style.height = 600(px)
			}
		}

		view {
			ScrollView() {
				for let (_, row) in tipRows {
					if wrapped {
						Tooltip() {
							tip = view {
								Text("more about it")
							}
							Button("row", key = row)
						}
					} else {
						Button("row", key = row)
					}
				}
			}
		}

		style StageStyle
	}

	internal type TipScenes {
		plain   ?Scene = none
		wrapped ?Scene = none
		hovered ?Scene = none
	}

	internal let tipScenes = new TipScenes()

	// A scene of `ManyTips`, arranged once.
	internal def tipScene(wrapped bool) Scene {
		if tipRows.len() == 0 {
			for let i = 0; i < 500; i++ {
				tipRows.push(i)
			}
		}
		let scene = new Scene(ManyTips(wrapped = wrapped))
		scene.arrange(new Size<Pixels>(800(px), 600(px)))
		return scene
	}

	// Marks `under` and everything below it as under the pointer.
	internal def hoverAll(under component) {
		under.isHover = true
		for let child in under.children {
			hoverAll(child)
		}
	}

	// The states std components reported, by name.
	internal let stateLog = string[]

	@on(UI.stateChange)
	internal def heardState(evt Event<StateChange>) {
		stateLog.push("{evt.result.state}")
	}

	// Only the `checked` of a checkbox, and only the `current` of the strip named "strip".
	@on(UI.stateChange, kind<Checkbox>().state("checked"))
	internal def heardChecked(evt Event<StateChange>) {
		stateLog.push("checkbox")
	}

	@on(UI.stateChange, ref("strip").state("current"))
	internal def heardStrip(evt Event<StateChange>) {
		stateLog.push("strip")
	}

	// A checkbox, a switch and a strip of tabs that keep their own values.
	component Stateful {
		type {
			@bindable
			agreed bool

			@bindable
			lit bool

			@bindable
			tab int

			def new() {
				style.width = 400(px)
				style.height = 200(px)
			}
		}

		view {
			Column(gap = 6(px)) {
				Checkbox(agreed, label = "Agree")
				Switch(lit)
				TabStrip(["one", "two"], current = tab, ref = strip)
			}
		}

		style StageStyle
	}

	// The titles of `Movable`, moved as its strip says.
	internal let movedTabs = ["one", "two", "three"]
	internal let movedLog = string[]

	internal def moveTab(from int, to int) {
		let title = movedTabs[from]
		let rest = movedTabs[:from] + movedTabs[from + 1:]
		movedTabs = rest[:to] + [title] + rest[to:]
		movedLog.push("{from}>{to}")
	}

	internal def closeTab(index int) {
		movedTabs = movedTabs[:index] + movedTabs[index + 1:]
		movedLog.push("close {index}")
	}

	// A strip whose tabs are dragged and closed.
	component Movable {
		type {
			@bindable
			shown int

			def new() {
				style.width = 400(px)
				style.height = 100(px)
			}
		}

		view {
			TabStrip(tabs = movedTabs, current = shown, onMove = moveTab, onClose = closeTab)
		}

		style StageStyle
	}

	// A button, three in a scope that remembers, a button, two in a scope that traps.
	component Panes {
		type {
			def new() {
				style.width = 400(px)
				style.height = 300(px)
			}
		}

		view {
			Column(gap = 6(px)) {
				Button("before")
				FocusScope() {
					Button("one")
					Button("two")
					Button("three")
				}
				Button("after")
				FocusScope(trap = true) {
					Button("first")
					Button("second")
				}
			}
		}

		style StageStyle
	}

	// What the zones of `Drags` were asked and given.
	let dragLog = string[]

	internal def onlyItems(data DragData) bool {
		return !(data.item is none)
	}

	// Copies on the left half of the stage, refuses on the right.
	internal def copyLeft(data DragData, at Point<Pixels>) DropEffect {
		return float(at.x) < 200.0 ?? (DropEffect.Copy, DropEffect.None)
	}

	internal def tookItem(data DragData, at Point<Pixels>) {
		let item = data.item
		dragLog.push("item {item} {data.text}")
	}

	internal def tookAny(data DragData, at Point<Pixels>) {
		dragLog.push("any {data.text}")
	}

	internal def dragBegun() {
		dragLog.push("began")
	}

	internal def dragOver(dropped bool) {
		dragLog.push("ended {dropped}")
	}

	@on(Draggable.ended, ref("listed"))
	internal def heardDragEnd(evt ComponentEvent<bool>) {
		dragLog.push("heard {evt.result}")
	}

	// A text that is dragged at the top of a list too long for its box.
	component DragList {
		type {
			def new() {
				style.width = 200(px)
				style.height = 100(px)
			}
		}

		view {
			ScrollView() {
				Draggable(data = DragData{text: "row"}, onStart = dragBegun, onEnd = dragOver, ref = listed) {
					Text("drag me")
				}
				Button(label = "Two")
				Button(label = "Three")
				Button(label = "Four")
				Button(label = "Five")
				Button(label = "Six")
			}
		}

		style StageStyle
	}

	internal def dragClicked() {
		dragLog.push("clicked")
	}

	// A text and a button that are dragged with a preview, a slider that is dragged
	// without one and keeps its thumb, a zone that takes items on its left half and
	// one that takes anything.
	component Drags {
		type {
			def new() {
				style.width = 400(px)
				style.height = 300(px)
			}
		}

		view {
			Column(gap = 10(px)) {
				Draggable(data = DragData{item: 7, text: "seven"}) {
					preview = view {
						Text("ghost")
					}
					Text("drag me")
					Button("press me", onClick = dragClicked)
				}
				Draggable(data = DragData{text: "level"}) {
					Slider(value = 20.0)
				}
				DropTarget(accepts = onlyItems, onOver = copyLeft, onDrop = tookItem) {
					Panel() {
						Text("items here")
					}
				}
				DropTarget(onDrop = tookAny) {
					Text("anything here")
				}
				Text("nothing here")
			}
		}

		style StageStyle
	}

	// A title bar the window is dragged by, with a title and a button, over a text.
	component Framed {
		type {
			// Whether the bar drags.
			@bindable
			loose bool = true

			def new() {
				style.width = 400(px)
				style.height = 300(px)
			}
		}

		view {
			Column(gap = 6(px)) {
				WindowDrag(gap = 10(px), enabled = loose) {
					Text("Title")
					Button("Close", onClick = ran)
				}
				Text("content")
			}
		}

		style StageStyle
	}

	// Two buttons, the second named, a link, a chip, a checkbox, a radio and a menu line.
	component Clicks {
		type {
			def new() {
				style.width = 400(px)
				style.height = 300(px)
			}
		}

		view {
			Column(gap = 6(px)) {
				Button("One", onClick = ran)
				Button("Two", ref = second)
				Link("Docs")
				Chip("Tag", onClick = ran)
				Checkbox(label = "Agree")
				Radio(label = "Only", ref = only)
				MenuItem("Go", ref = go)
			}
		}

		style StageStyle
	}

	internal def ranDebug() {
		kitLog.push("as 0")
	}

	internal def ranProfile() {
		kitLog.push("as 1")
	}

	internal def toastGone() {
		kitToast[0] = false
		kitLog.push("toast")
	}

	internal def chipRemoved() {
		kitLog.push("removed")
	}

	internal def generalToggled(now bool) {
		kitLog.push("general {now}")
	}

	internal def drawKit(ctx RenderContext) {
		kitLog.push("draw {int(float(ctx.geometry.frame.width))}")
	}

	// A menu bar, a number field, a combo box, a split button, a chip and an avatar, an
	// accordion and a toast.
	component Kit {
		type {
			def new() {
				style.width = 400(px)
				style.height = 400(px)
			}
		}

		view {
			Column(gap = 6(px)) {
				MenuBar() {
					Menu(title = "File") {
						MenuItem(label = "New", shortcut = "Ctrl+N", onActivate = ran)
						MenuSeparator()
						MenuItem(label = "Quit")
					}
					Menu(title = "Edit") {
						MenuItem(label = "Undo")
					}
				}
				NumberField(value = kitCount[0], min = 0.0, max = 5.0, onChange = setCount)
				ComboBox(value = kitCity[0], options = ["Paris", "Parma", "Oslo"], onChange = setCity, onSelect = pickedCity)
				SplitButton(label = "Run", onClick = ran) {
					MenuItem(label = "Debug", onActivate = ranDebug)
					MenuItem(label = "Profile", onActivate = ranProfile)
				}
				Row(gap = 4(px)) {
					Chip(label = "rust", onRemove = chipRemoved)
					Avatar(name = "Ada Lovelace")
				}
				Accordion() {
					AccordionItem(title = "General", open = true, onToggle = generalToggled) {
						Text(text = "one")
					}
					AccordionItem(title = "Advanced") {
						Text(text = "two")
					}
				}
				Toast(text = "Saved", open = kitToast[0], lasts = 0s, onClose = toastGone)
			}
		}

		style StageStyle
	}

