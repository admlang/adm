partial module std.ui.components {
	use (
		std.math.geom::(Point, Size)
		std.testing
		std.ui::(MouseButton, PointerPhase)
		std.ui.runtime::Scene
		std.ui.styles::*
		std.units::Pixels
	)

	internal struct Contact {
		name string
		mark string
	}

	internal let contacts = [Contact{name: "Ada", mark: "A"}, Contact{name: "Grace", mark: "G"}]

	// Controls given content beside their text.
	component Beside {
		type {
			def new() {
				style.width = 400(px)
				style.height = 300(px)
			}
		}

		view {
			Column(gap = 4(px)) {
				Button("Sync", icon = "refresh") {
					start = view {
						Badge("3")
					}
				}
				Chip("ada") {
					start = view {
						Badge("A")
					}
					end = view {
						Badge("!")
					}
				}
				MenuItem("Open", shortcut = "Ctrl+O") {
					end = view {
						Badge("new")
					}
				}
				TextField("query") {
					end = view {
						Badge("9")
					}
				}
				TextField("plain")
			}
		}

		style StageStyle
	}

	// The titles of `MarkedTabs`, which of them carry a mark, and what its strip closed.
	internal let markedTitles = ["one", "two", "three"]
	internal let markedMarks = [false, false, false]
	internal let markedLog = string[]

	internal def markOf(index int) ?view {
		return none when !markedMarks[index]
		return view {
			Text("•")
		}
	}

	internal def markedHeading(index int) view {
		return view {
			Badge("{index}")
			Text(markedTitles[index])
		}
	}

	internal def closeMarked(index int) {
		markedLog.push("close {index}")
	}

	internal def markedContext(index int) view {
		return view {
			MenuItem("Close {markedTitles[index]}")
		}
	}

	// Closable tabs with headings and a mark, in a column that can be made too narrow
	// for them.
	component MarkedTabs {
		type {
			@bindable
			narrow bool = false

			def new() {
				style.width = 400(px)
				style.height = 300(px)
			}
		}

		view {
			Column(style = {width: narrow ?? (120(px), 400(px))}) {
				TabStrip(markedTitles, current = 0, heading = markedHeading, mark = markOf, onClose = closeMarked, contextMenu = markedContext, ref = strip)
			}
		}

		style StageStyle
	}

	// Titles composed with `heading`.
	component Headed {
		type {
			def new() {
				style.width = 400(px)
				style.height = 300(px)
			}
		}

		view {
			Column() {
				Tabs() {
					Tab("one") {
						heading = view {
							Badge("1")
							Text("one")
						}
						Text("first page")
					}
					Tab("two") {
						Text("second page")
					}
				}
				MenuBar() {
					Menu(title = "File") {
						heading = view {
							Badge("F")
						}
						MenuItem("Open")
					}
					Menu(title = "Edit") {
						MenuItem("Copy")
					}
				}
			}
		}

		style StageStyle
	}

	// Choices whose lines a renderer draws.
	component Rendered {
		type {
			def new() {
				style.width = 400(px)
				style.height = 300(px)
			}
		}

		view {
			Column() {
				Dropdown<Contact>(contacts, selected = 1) {
					rowRenderer = (it RowItem<Contact>) => view {
						Badge(it.content.mark)
						Text(it.content.name)
					}
				}
				ComboBox<Contact>("", options = contacts, text = (p Contact) => p.name) {
					rowRenderer = (it RowItem<Contact>) => view {
						Badge(it.content.mark)
					}
				}
			}
		}

		style StageStyle
	}

	// The texts of the `Text` and `Badge` components at and under `c`, in order.
	internal def wordsUnder(c component) string[] {
		let words string[]
		if c is Text {
			words.push(c.text)
		}
		if c is Badge {
			words.push("[{c.label}]")
		}
		for let child in c.childNodes {
			words.push(...wordsUnder(child))
		}
		return words
	}

	check "Content slots" {
		// What `start` and `end` give stands beside the text, in place of the icon or
		// the shortcut; without a slot the control draws its text itself.
		@test()
		def TestStartAndEnd() {
			let page = Beside()
			let scene = new Scene(page)
			let size = new Size<Pixels>(400(px), 300(px))
			scene.arrange(size)
			scene.arrange(size)
			let column = page.children[0]
			let (button, chip, line, field, plain) = (column.children[0], column.children[1], column.children[2], column.children[3], column.children[4])
			assert wordsUnder(button).join(",") == "[3],Sync"
			assert !(button.childNodes[0] is Icon)
			assert wordsUnder(chip).join(",") == "[A],ada,[!]"
			assert wordsUnder(line).join(",") == "Open,[new]"
			// The field keeps its text between its start and what stands at its end.
			if field is TextField && plain is TextField {
				let (_, right) = field.textSpan()
				let (_, plainRight) = plain.textSpan()
				let part = field.childNodes[0]
				assert part is FieldEnd && wordsUnder(part).join(",") == "[9]"
				assert right < plainRight && right <= float(part.style.geom.frame.left)
			} else {
				assert false
			}
			scene.close()
		}

		// A tab or a menu with a `heading` shows it in its title; the others their text.
		@test()
		def TestHeadings() {
			let page = Headed()
			let scene = new Scene(page)
			let size = new Size<Pixels>(400(px), 300(px))
			scene.arrange(size)
			scene.arrange(size)
			scene.arrange(size)
			let column = page.children[0]
			let strip = column.children[0].children[0]
			assert strip is TabStrip
			let titles = strip.childNodes.filter((c component) => c is TabTitle)
			assert titles.len() == 2 && wordsUnder(titles[0]).join(",") == "[1],one" && wordsUnder(titles[1]).join(",") == "two"
			let bar = column.children[1]
			let menuTitles = bar.childNodes.filter((c component) => c is MenuTitle)
			assert menuTitles.len() == 2 && wordsUnder(menuTitles[0]).join(",") == "[F]" && wordsUnder(menuTitles[1]).len() == 0
			scene.close()
		}

		// With `mark`, a tab shows its mark at its end, from when it comes, and its cross
		// only while the pointer is on it; the secondary button on a tab opens the menu `contextMenu` gives for
		// it; the button the folded tabs stand behind counts them, and the menu's lines
		// show each tab's heading and mark and end in a cross that closes the tab, as the
		// middle button on the line does, the line unpicked and the menu still open; the
		// secondary button on a line opens the tab's context menu too.
		@test()
		def TestMarksAndFoldedCount() {
			markedLog = string[]
			markedMarks = [false, false, false]
			let page = MarkedTabs()
			let scene = new Scene(page)
			let size = new Size<Pixels>(400(px), 300(px))
			scene.arrange(size)
			scene.arrange(size)
			scene.arrange(size)
			let strip = page.strip
			assert !(strip is none)
			return when strip is none
			let middle = def (c component) Point<Pixels> {
				let frame = c.style.geom.frame
				return new Point<Pixels>((frame.left + frame.right) / 2.0, (frame.top + frame.bottom) / 2.0)
			}
			let titles = def () component[] {
				return strip.childNodes.filter((c component) => c is TabTitle)
			}
			let crossed = def (tab component) bool {
				for let child in tab.childNodes {
					return true when child is TabCross
				}
				return false
			}
			// At rest: no mark and no cross on any tab; the second's mark comes after the
			// tabs were built, and shows once the strip runs its view again.
			let tabs = titles()
			assert tabs.len() == 3
			assert wordsUnder(tabs[1]).join(",") == "[1],two"
			assert !crossed(tabs[0]) && !crossed(tabs[1]) && !crossed(tabs[2])
			markedMarks = [false, true, false]
			strip.redraw()
			scene.arrange(size)
			scene.arrange(size)
			tabs = titles()
			assert wordsUnder(tabs[0]).join(",") == "[0],one" && wordsUnder(tabs[1]).join(",") == "[1],two,•"

			// The pointer on the second: its cross in the mark's place; gone again when
			// the pointer leaves.
			scene.pointer(PointerPhase.Move, middle(tabs[1]))
			scene.arrange(size)
			scene.arrange(size)
			tabs = titles()
			assert crossed(tabs[1]) && !crossed(tabs[0]) && wordsUnder(tabs[1]).join(",") == "[1],two"
			scene.pointer(PointerPhase.Leave, middle(tabs[1]))
			scene.arrange(size)
			scene.arrange(size)
			tabs = titles()
			assert !crossed(tabs[1]) && wordsUnder(tabs[1]).join(",") == "[1],two,•"
			let lineCross = def (under component) ?component {
				let found ?component = none
				let walk = def (c component) {
					for let child in c.childNodes {
						found = child when child is TabLineCross
					}
				}
				walk(under)
				for let child in under.childNodes {
					walk(child) when found is none
				}
				return found
			}
			let contextOf = def () ?ContextMenu {
				let last = strip.children[strip.children.len() - 1]
				return last when last is ContextMenu
				return none
			}

			// The secondary button on the second tab: its context menu, with the lines
			// given for it; a press elsewhere closes it.
			scene.pointer(PointerPhase.Down, middle(tabs[1]), MouseButton.Right)
			scene.pointer(PointerPhase.Up, middle(tabs[1]), MouseButton.Right)
			scene.arrange(size)
			scene.arrange(size)
			let context = contextOf()
			assert !(context is none)
			if !(context is none) {
				assert context.open && context.children.len() == 1
				let line = context.children[0]
				assert line is MenuItem && line.label == "Close two"
			}
			scene.pointer(PointerPhase.Down, new Point<Pixels>(390(px), 290(px)))
			scene.pointer(PointerPhase.Up, new Point<Pixels>(390(px), 290(px)))
			scene.arrange(size)
			scene.arrange(size)
			context = contextOf()
			assert !(context is none)
			assert !context.open unless context is none

			// Too narrow: the button says how many tabs are folded, and its menu shows
			// each tab as the strip does.
			page.narrow = true
			scene.arrange(size)
			scene.arrange(size)
			strip.refit()
			scene.arrange(size)
			scene.arrange(size)
			strip.refit()
			scene.arrange(size)
			scene.arrange(size)
			let placed = strip.placed
			assert !(placed is none)
			return when placed is none
			assert placed.len() < 3 && placed.includes(0)
			let more = strip.more
			assert !(more is none)
			return when more is none
			assert more.label == "+{3 - placed.len()}"
			scene.pointer(PointerPhase.Down, middle(more))
			scene.pointer(PointerPhase.Up, middle(more))
			scene.arrange(size)
			scene.arrange(size)
			assert strip.menuOpen
			let menu = strip.children[strip.children.len() - 2]
			assert menu is Menu && menu.children.len() == 3
			assert wordsUnder(menu.children[0]).join(",") == "[0],one" && wordsUnder(menu.children[1]).join(",") == "[1],two,•"
			if menu is Menu {
				// Each line ends in a cross; a click on the third's closes that tab and
				// picks nothing.
				let third = lineCross(menu.children[2])
				assert !(lineCross(menu.children[0]) is none) && !(third is none)
				return when third is none
				scene.pointer(PointerPhase.Down, middle(third))
				scene.pointer(PointerPhase.Up, middle(third))
				scene.arrange(size)
				scene.arrange(size)
				assert markedLog.join(",") == "close 2" && strip.menuOpen && strip.current == 0
				// The middle button on the second line closes that tab, the line unpicked.
				scene.pointer(PointerPhase.Down, middle(menu.children[1]), MouseButton.Middle)
				scene.pointer(PointerPhase.Up, middle(menu.children[1]), MouseButton.Middle)
				scene.arrange(size)
				scene.arrange(size)
				assert markedLog.join(",") == "close 2,close 1" && strip.menuOpen && strip.current == 0
				// The secondary button on the second line: the context menu for that tab.
				scene.pointer(PointerPhase.Down, middle(menu.children[1]), MouseButton.Right)
				scene.pointer(PointerPhase.Up, middle(menu.children[1]), MouseButton.Right)
				scene.arrange(size)
				scene.arrange(size)
				context = contextOf()
				assert !(context is none)
				if !(context is none) {
					let line = context.children[0]
					assert context.open && line is MenuItem && line.label == "Close two"
				}
			}
			scene.close()
		}

		// `rowRenderer` draws the lines of the list, and the dropdown's button for the
		// selected option.
		@test()
		def TestRowRenderer() {
			let page = Rendered()
			let scene = new Scene(page)
			let size = new Size<Pixels>(400(px), 300(px))
			scene.arrange(size)
			scene.arrange(size)
			let column = page.children[0]
			let dropdown = column.children[0]
			let button = dropdown.children[0]
			assert button is Button && wordsUnder(button).join(",") == "[G],Grace"
			let menu = dropdown.children[1]
			let lines = menu.childNodes.filter((c component) => c is MenuItem)
			assert lines.len() == 2 && wordsUnder(lines[0]).join(",") == "[A],Ada" && wordsUnder(lines[1]).join(",") == "[G],Grace"
			let combo = column.children[1]
			let picks = combo.children[1].childNodes.filter((c component) => c is MenuItem)
			assert picks.len() == 2 && wordsUnder(picks[0]).join(",") == "[A]"
			scene.close()
		}
	}
}
