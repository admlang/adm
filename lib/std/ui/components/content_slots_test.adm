partial module std.ui.components {
	use (
		std.math.geom::Size
		std.testing
		std.ui.runtime::Scene
		std.ui.styles::*
		std.units::Pixels
	)

	internal struct Contact {
		name string
		mark string
	}

	internal let contacts = [Contact{name: "Ada", mark: "A"}, Contact{name: "Grace", mark: "G"}]

	// Controls given content beside their text.
	component Beside {
		type {
			def new() {
				style.width = 400(px)
				style.height = 300(px)
			}
		}

		view {
			Column(gap = 4(px)) {
				Button("Sync", icon = "refresh") {
					start = view {
						Badge("3")
					}
				}
				Chip("ada") {
					start = view {
						Badge("A")
					}
					end = view {
						Badge("!")
					}
				}
				MenuItem("Open", shortcut = "Ctrl+O") {
					end = view {
						Badge("new")
					}
				}
				TextField("query") {
					end = view {
						Badge("9")
					}
				}
				TextField("plain")
			}
		}

		style StageStyle
	}

	// Titles composed with `heading`.
	component Headed {
		type {
			def new() {
				style.width = 400(px)
				style.height = 300(px)
			}
		}

		view {
			Column() {
				Tabs() {
					Tab("one") {
						heading = view {
							Badge("1")
							Text("one")
						}
						Text("first page")
					}
					Tab("two") {
						Text("second page")
					}
				}
				MenuBar() {
					Menu(title = "File") {
						heading = view {
							Badge("F")
						}
						MenuItem("Open")
					}
					Menu(title = "Edit") {
						MenuItem("Copy")
					}
				}
			}
		}

		style StageStyle
	}

	// Choices whose lines a renderer draws.
	component Rendered {
		type {
			def new() {
				style.width = 400(px)
				style.height = 300(px)
			}
		}

		view {
			Column() {
				Dropdown<Contact>(contacts, selected = 1) {
					rowRenderer = (it RowItem<Contact>) => view {
						Badge(it.content.mark)
						Text(it.content.name)
					}
				}
				ComboBox<Contact>("", options = contacts, text = (p Contact) => p.name) {
					rowRenderer = (it RowItem<Contact>) => view {
						Badge(it.content.mark)
					}
				}
			}
		}

		style StageStyle
	}

	// The texts of the `Text` and `Badge` components at and under `c`, in order.
	internal def wordsUnder(c component) string[] {
		let words string[]
		if c is Text {
			words.push(c.text)
		}
		if c is Badge {
			words.push("[{c.label}]")
		}
		for let child in c.childNodes {
			words.push(...wordsUnder(child))
		}
		return words
	}

	check "Content slots" {
		// What `start` and `end` give stands beside the text, in place of the icon or
		// the shortcut; without a slot the control draws its text itself.
		@test()
		def TestStartAndEnd() {
			let page = Beside()
			let scene = new Scene(page)
			let size = new Size<Pixels>(400(px), 300(px))
			scene.arrange(size)
			scene.arrange(size)
			let column = page.children[0]
			let (button, chip, line, field, plain) = (column.children[0], column.children[1], column.children[2], column.children[3], column.children[4])
			assert wordsUnder(button).join(",") == "[3],Sync"
			assert !(button.childNodes[0] is Icon)
			assert wordsUnder(chip).join(",") == "[A],ada,[!]"
			assert wordsUnder(line).join(",") == "Open,[new]"
			// The field keeps its text between its start and what stands at its end.
			if field is TextField && plain is TextField {
				let (_, right) = field.textSpan()
				let (_, plainRight) = plain.textSpan()
				let part = field.childNodes[0]
				assert part is FieldEnd && wordsUnder(part).join(",") == "[9]"
				assert right < plainRight && right <= float(part.style.geom.frame.left)
			} else {
				assert false
			}
			scene.close()
		}

		// A tab or a menu with a `heading` shows it in its title; the others their text.
		@test()
		def TestHeadings() {
			let page = Headed()
			let scene = new Scene(page)
			let size = new Size<Pixels>(400(px), 300(px))
			scene.arrange(size)
			scene.arrange(size)
			scene.arrange(size)
			let column = page.children[0]
			let strip = column.children[0].children[0]
			assert strip is TabStrip
			let titles = strip.childNodes.filter((c component) => c is TabTitle)
			assert titles.len() == 2 && wordsUnder(titles[0]).join(",") == "[1],one" && wordsUnder(titles[1]).join(",") == "two"
			let bar = column.children[1]
			let menuTitles = bar.childNodes.filter((c component) => c is MenuTitle)
			assert menuTitles.len() == 2 && wordsUnder(menuTitles[0]).join(",") == "[F]" && wordsUnder(menuTitles[1]).len() == 0
			scene.close()
		}

		// `rowRenderer` draws the lines of the list, and the dropdown's button for the
		// selected option.
		@test()
		def TestRowRenderer() {
			let page = Rendered()
			let scene = new Scene(page)
			let size = new Size<Pixels>(400(px), 300(px))
			scene.arrange(size)
			scene.arrange(size)
			let column = page.children[0]
			let dropdown = column.children[0]
			let button = dropdown.children[0]
			assert button is Button && wordsUnder(button).join(",") == "[G],Grace"
			let menu = dropdown.children[1]
			let lines = menu.childNodes.filter((c component) => c is MenuItem)
			assert lines.len() == 2 && wordsUnder(lines[0]).join(",") == "[A],Ada" && wordsUnder(lines[1]).join(",") == "[G],Grace"
			let combo = column.children[1]
			let picks = combo.children[1].childNodes.filter((c component) => c is MenuItem)
			assert picks.len() == 2 && wordsUnder(picks[0]).join(",") == "[A]"
			scene.close()
		}
	}
}
