partial module std.ui.components {
	use (
		std.gfx.canvas
		std.gfx.color::Color
		std.math.geom::(Axes, Corners, Edges, Line, Point, Rect, StrokeStyle)
		std.ui::(Limit, RenderContext, Theme, UI)
		std.ui.paint
		std.ui.runtime::(FoundIcon, iconNamed, iconsVersion)
		std.ui.styles::*
		std.units::(Extent, Pixels)
	)

	// An icon a component names, looked up again when the name or the icon sets change.
	internal type IconSlot {
		name    string
		version int        = -1
		found   ?FoundIcon = none

		// The icon called `wanted`; none for an empty name and for one no set holds.
		def get(wanted string) ?FoundIcon {
			return none when wanted == ""
			if wanted != name || version != iconsVersion() {
				name = wanted
				version = iconsVersion()
				found = iconNamed(wanted)
			}
			return found
		}
	}

	// The styles the simple std components share, each named for what it holds.

	// A box, the look of its text, and how it takes the pointer and the keyboard: the
	// controls with a label (`Checkbox`, `Switch`, `Radio`, `ToggleButton`, `MenuItem`,
	// `TabStrip`).
	style ControlStyle {
		Box
		Typography
		Interaction
	}

	// A box and how it takes the pointer and the keyboard: `Slider`, `ProgressBar`.
	style BarStyle {
		Box
		Interaction
	}

	// A box and the look of its text: `Image`, `Badge`, `Spinner`.
	style FigureStyle {
		Box
		Typography
	}

	// A box alone: `Divider`, `Spacer`.
	style BoxStyle {
		Box
	}

	// The look of the mark of a `Checkbox`, a `Radio` or a `Switch`: a sunken surface
	// with an edge while off, filled with the accent while on, each a step further while
	// the pointer is over the control (`over`) or holds it (`held`), and a ring while the
	// control shows the keyboard focus (`ringed`). `foreground` is what the mark draws on
	// its fill: a tick, a dot.
	style MarkStyle {
		Box
		Decorated
		Foreground
		background = new BackgroundFill(theme.palette.surfaceSunken)
		border = controlEdge(theme.palette.border)
		foreground = theme.palette.onAccent
		on = {
			over:           {background: new BackgroundFill(theme.palette.surfaceSunken.mix(theme.palette.hover)), border: controlEdge(theme.palette.borderStrong)},
			held:           {background: new BackgroundFill(theme.palette.surfaceSunken.mix(theme.palette.pressed))},
			on:             {background: new BackgroundFill(theme.palette.accent), border: controlEdge(theme.palette.accent)},
			[on, over]:     {background: new BackgroundFill(theme.palette.accentHover), border: controlEdge(theme.palette.accentHover)},
			[on, held]:     {background: new BackgroundFill(theme.palette.accentPressed), border: controlEdge(theme.palette.accentPressed)},
			[on, disabled]: {background: new BackgroundFill(theme.palette.foregroundDisabled), border: controlEdge(theme.palette.foregroundDisabled)},
			ringed:         {outline: focusRing()},
		}
	}

	// A control that is a mark with its label after it, on one line: `Checkbox`, `Radio`,
	// `Switch`.
	style MarkedStyle {
		ControlStyle
		Layout
		arrange = Arrange.Row
		gap = new Axes<Extent>(markGap * 1(px))
		align = Align{horizontal: Alignment.Start, vertical: Alignment.Center}
	}

	// The side of the mark of a `Checkbox` or a `Radio`, and the room between a mark and
	// its label, in logical pixels.
	internal const markSide = 18.0
	internal const markGap = 8.0

	// The fill of a raised control in a state: the theme's raised surface under `over`
	// (its `hover` or `pressed`).
	internal def raisedFill(over Color) BackgroundFill {
		return new BackgroundFill(UI.theme().palette.surfaceRaised.mix(over))
	}

	// The fill of a line of a menu in a state: the theme's overlay surface under `over`
	// (its `hover` or `pressed`).
	internal def overlayFill(over Color) BackgroundFill {
		return new BackgroundFill(UI.theme().palette.overlay.mix(over))
	}

	// The line around a control as a style holds it: the theme's border width in `ink`
	// on the four sides.
	internal def controlEdge(ink Color) Edges<canvas.Border> {
		return new Edges<canvas.Border>(canvas.Border{width: UI.theme().metrics.borderWidth, paint: ink})
	}

	// The ring of a control that shows the keyboard focus, as a style holds it.
	internal def focusRing() Ring {
		let look = UI.theme()
		return Ring{width: look.metrics.focusWidth, paint: look.palette.focus, offset: 1(px)}
	}

	// The line around a control or a mark: the theme's border, stronger while `strong`
	// (the pointer is over an enabled control).
	internal def drawEdge(ctx RenderContext, look Theme, box Rect, radius float, strong bool) {
		let line = canvas.Border{width: look.metrics.borderWidth, paint: strong ?? (look.palette.borderStrong, look.palette.border)}
		ctx.draw.stroke(box, new Edges<canvas.Border>(line), new Corners<Pixels>(radius * 1(px)))
	}

	// The component's border box in its own coordinates, as a canvas draws it.
	internal def frameBox(ctx RenderContext) Rect {
		let frame = ctx.geometry.frame
		return Rect{left: 0.0, top: 0.0, right: float(frame.width), bottom: float(frame.height)}
	}

	// A check mark in a square `side` wide at (`left`, `top`): a short stroke down, a long
	// one up, in parts of the side.
	internal def drawTick(ctx RenderContext, left float, top float, side float, ink Color) {
		let stroke = StrokeStyle{width: side / 9.0 * 1(px)}
		let turn = new Point(left + side * 0.42, top + side * 0.72)
		ctx.draw.stroke(new Line(new Point(left + side * 0.22, top + side * 0.53), turn), ink, stroke)
		ctx.draw.stroke(new Line(turn, new Point(left + side * 0.78, top + side * 0.31)), ink, stroke)
	}

	// A cross in a square `side` wide at (`left`, `top`): what removes a chip or closes
	// a tab.
	internal def drawCross(ctx RenderContext, left float, top float, side float, ink Color) {
		let (near, far) = (side * 0.3, side * 0.7)
		let stroke = StrokeStyle{width: 1.5(px)}
		ctx.draw.stroke(new Line(new Point(left + near, top + near), new Point(left + far, top + far)), ink, stroke)
		ctx.draw.stroke(new Line(new Point(left + far, top + near), new Point(left + near, top + far)), ink, stroke)
	}

	// The text block of a control's label: `labelBlock` in the theme's foreground, or its
	// disabled one.
	internal def controlLabel(held ?paint.TextBlock, text string, typeface ?Font, foreground ?Paint, lines ?ParagraphLayout, look Theme, enabled bool) paint.TextBlock {
		return labelBlock(held, text, typeface, foreground, lines, enabled ?? (look.palette.foreground, look.palette.foregroundDisabled))
	}

	// The ring around a control that has the keyboard focus, `gap` outside `box`.
	internal def drawFocusRing(ctx RenderContext, look Theme, box Rect, radius float) {
		let metrics = look.metrics
		let gap = float(metrics.focusWidth) + 1.0
		let around = Rect{left: box.left - gap, top: box.top - gap, right: box.right + gap, bottom: box.bottom + gap}
		let ring = canvas.Border{width: metrics.focusWidth, paint: look.palette.focus}
		ctx.draw.stroke(around, new Edges<canvas.Border>(ring), new Corners<Pixels>((radius + gap) * 1(px)))
	}

	// A row of titles drawn by one component (the tabs of a `TabStrip`, the steps of
	// `Breadcrumbs`): their text blocks and where each starts, made again only when what
	// they show changed.
	internal type TitleRow {
		// The titles as set last.
		blocks  paint.TextBlock[]
		// The left edge of each title's slot, with the row's end last.
		edges   float[]
		// What they were last coloured and measured for.
		current int               = -2
		enabled bool              = true
		bright  ?Color            = none
		tail    float

		// Brings the blocks in step with `titles`: the one at `current` in `strong`, the
		// others in `faint`, all in `off` when not `enabled`; each slot is its title's
		// width plus `pad` on each side and `tail` after it (room for a mark at its end).
		def lay(titles string[], current int, enabled bool, strong Color, faint Color, off Color, pad float, typeface ?Font, foreground ?Paint, lines ?ParagraphLayout, tail float = 0.0) {
			let same = blocks.len() == titles.len()
			if same {
				for let (i, title) in titles {
					same = false when blocks[i].text != title
				}
			}
			if !same {
				let made paint.TextBlock[]
				for let title in titles {
					made.push(labelBlock(none, title, typeface, foreground, lines, strong))
				}
				blocks = made
			}
			let had = bright
			return when same && current == self.current && enabled == self.enabled && tail == self.tail && !(had is none) && had == strong && edges.len() == blocks.len() + 1
			self.tail = tail
			self.current = current
			self.enabled = enabled
			bright = strong
			let at float[] = [0.0]
			for let (i, block) in blocks {
				let shade = !enabled ?? (off, i == current ?? (strong, faint))
				blocks[i] = labelBlock(block, block.text, typeface, foreground, lines, shade)
				at.push(at[i] + float(blocks[i].measure(Limit{}).width) + pad * 2.0 + tail)
			}
			edges = at
		}

		// The width of the whole row.
		def width() float {
			return 0.0 when edges.len() == 0
			return edges[edges.len() - 1]
		}

		// The title whose slot holds a distance from the row's start, -1 for none.
		def at(along float) int {
			for let i = 0; i + 1 < edges.len(); i++ {
				return i when along >= edges[i] && along < edges[i + 1]
			}
			return -1
		}

		// The slot of title `i` in a row `width` wide, from the right under `rtl`.
		def slot(i int, width float, height float, rtl bool) Rect {
			return Rect{left: width - edges[i + 1], top: 0.0, right: width - edges[i], bottom: height} when rtl
			return Rect{left: edges[i], top: 0.0, right: edges[i + 1], bottom: height}
		}
	}
}
