partial module std.ui.components {
	use (
		std.math.geom::(Edges, Rect)
		std.services.vault.kept::(keep, keepable, restored)
		std.ui::(MouseButton, PointerEvent, PointerPhase, RenderContext, themeOf)
		std.ui.runtime::(afterArrange, drawIcon)
		std.ui.styles::*
		std.units::(Extent, Pixels)
	)

	// One column of a `DataGrid`:
	// `new GridColumn<File>("Size", cell = (it RowItem<File>) => Text("{it.content.size}"), width = 80(px), order = bySize)`.
	type GridColumn<T> {
		// What its header says.
		title string = ""

		// Draws the cell of a row; none: the row as text.
		cell ?(def(RowItem<T>) view) = none

		// The width it has; none: the columns without one share the room left.
		width ?Pixels = none

		// Orders two rows: below 0 when the first comes before the second. With it a
		// press on the header sorts the rows by this column.
		order ?(def(T, T) int) = none

		// Whether a press on the header asks for the rows to be sorted by this column
		// although it has no `order`: for a grid over a `Source`, which orders its
		// items itself when the grid tells `onSort`.
		sortable bool = false

		// Names the column in `sortBy` and in the widths a grid keeps; empty: its title.
		key string = ""

		// Whether the user can drag the end of its header to give it another width.
		resizable bool = true

		def new(title string, cell ?(def(RowItem<T>) view) = none, width ?Pixels = none, order ?(def(T, T) int) = none, sortable bool = false, key string = "", resizable bool = true) {
			self.title = title
			self.cell = cell
			self.width = width
			self.order = order
			self.sortable = sortable
			self.key = key
			self.resizable = resizable
		}
	}

	// What a grid tells when the user sorted it: the column's key (empty: not sorted any
	// more) and the direction.
	struct GridSort {
		key        string
		descending bool
	}

	// The style of a `DataGrid`.
	style DataGridStyle {
		Box
		Layout
		Background
		arrange = Arrange.Column
		width = fill
		height = fill
	}

	// What the header of a column shows after its title.
	internal enum HeadMark {
		// Nothing: a press does not sort by it.
		Plain,
		// Nothing yet: a press sorts by it.
		Sortable,
		Ascending,
		Descending,
	}

	// How near the end of a header the pointer takes it to drag, and the least width a
	// drag gives a column, in logical pixels.
	internal const gridEdge = 4.0
	internal const gridLeast = 24.0

	// The header of one column: its title, and an arrow while the rows are sorted by it.
	internal component GridHead {
		type {
			@input(value = true)
			title string = ""

			@input
			mark HeadMark = HeadMark.Plain

			arrow IconSlot = new IconSlot()

			def new() {
				role = Role.ColumnHeader
			}

			def render(ctx RenderContext) {
				ctx.childNodes()
				let name = ""
				name = "chevron-up" when mark == HeadMark.Ascending
				name = "chevron-down" when mark == HeadMark.Descending
				let found = arrow.get(name)
				return when found is none
				let look = themeOf(self)
				let box = frameBox(ctx)
				let side = float(look.metrics.iconSize)
				let gap = float(look.metrics.unit)
				let at = ctx.direction == Direction.RightToLeft ?? (gap, box.right - gap - side)
				drawIcon(ctx.draw, found, Rect{left: at, top: (box.bottom - side) / 2.0, right: at + side, bottom: (box.bottom + side) / 2.0}, look.palette.foregroundMuted)
			}
		}

		view {
			Text(title)
		}

		style {
			Box
			Layout
			Clipping
			Typography
			// One line, shortened with an ellipsis where the column is narrower.
			paragraph = ParagraphLayout{wrap: Wrap.None, overflow: TextOverflow.Ellipsis}
			clip      = true
			align     = Align{horizontal: Alignment.Start, vertical: Alignment.Center}
			// Room for the arrow after the title.
			padding = new Edges<Extent>(0(px), theme.metrics.unit * 2.0 + theme.metrics.iconSize, 0(px), theme.metrics.unit * 2.0)
		}
	}

	// The headers of a grid, in the grid's columns. A press on one asks for the rows to
	// be sorted by it; the end of one is dragged to give its column another width.
	internal component GridHeads {
		type {
			@input
			titles string[] = []

			@input
			marks HeadMark[] = []

			// The columns' tracks, as the rows have them.
			@input
			tracks Track[] = []

			// Which columns can be given another width.
			@input
			sizable bool[] = []

			// Runs with the column whose header was pressed.
			@input
			onSort ?(def(int)) = none

			// Runs with a column and the width the user drags it to.
			@input
			onSize ?(def(int, float)) = none

			// Runs with the column whose end was pressed twice: it is to be as wide as
			// what it holds.
			@input
			onFit ?(def(int)) = none

			// The column being dragged and the one whose end is under the pointer (-1:
			// none), where the pointer took it and the column's width then; the header a
			// button went down on.
			dragged int = -1
			over    int = -1
			from    float
			before  float
			armed   int = -1

			def new() {
				role = Role.Row
			}

			// Where header `i` starts and ends, in the component.
			def span(i int) (float, float) {
				let own = style.geom.frame
				let head = childNodes[i].style.geom.frame
				return (float(head.left) - float(own.left), float(head.right) - float(own.left))
			}

			// The column whose end is at `x` and can be dragged; -1: none.
			def edgeAt(x float) int {
				let rtl = style.geom.direction == Direction.RightToLeft
				for let i = 0; i < childNodes.len() && i < sizable.len(); i++ {
					continue unless sizable[i]
					let (start, end) = span(i)
					let edge = rtl ?? (start, end)
					return i when (x - edge).abs() <= gridEdge
				}
				return -1
			}

			// The header at `x`; -1: none.
			def headAt(x float) int {
				for let i = 0; i < childNodes.len(); i++ {
					let (start, end) = span(i)
					return i when x >= start && x < end
				}
				return -1
			}

			// Notes the end under the pointer, which then says that it can be dragged.
			def point(i int) {
				return when i == over
				over = i
				if i >= 0 {
					style.cursor = Cursor.ResizeColumn
				} else {
					style.cursor = none
				}
				redraw()
			}

			def pointer(e PointerEvent) bool {
				return false when disabled
				let x = float(e.position.x)
				match e.phase {
					case PointerPhase.Down:
						return false when e.button != MouseButton.Left
						let edge = edgeAt(x)
						if edge >= 0 && e.clicks >= 2 {
							let tell = onFit
							tell(edge) unless tell is none
							return true
						}
						if edge >= 0 {
							e.capture()
							dragged = edge
							from    = x
							let (start, end) = span(edge)
							before = end - start
							return true
						}
						armed = headAt(x)
						return armed >= 0
					case PointerPhase.Move:
						if dragged < 0 {
							point(edgeAt(x))
							return false
						}
						let by = x - from
						by = -by when style.geom.direction == Direction.RightToLeft
						let tell = onSize
						tell(dragged, (before + by).max(gridLeast)) unless tell is none
						return true
					case PointerPhase.Leave:
						point(-1)
						return false
					case PointerPhase.Up, PointerPhase.Cancel:
						if dragged >= 0 {
							dragged = -1
							return true
						}
						let pressed = armed
						armed = -1
						return false when pressed < 0 || e.phase == PointerPhase.Cancel || headAt(x) != pressed
						let tell = onSort
						tell(pressed) unless tell is none
						return true
					default:
						return false
				}
			}

			def render(ctx RenderContext) {
				ctx.childNodes()
				// A line under the headers, and one at the end of each.
				let look = themeOf(self)
				let box = frameBox(ctx)
				let thick = float(look.metrics.borderWidth)
				ctx.draw.fill(Rect{left: 0.0, top: box.bottom - thick, right: box.right, bottom: box.bottom}, look.palette.divider)
				let rtl = ctx.direction == Direction.RightToLeft
				for let i = 0; i < childNodes.len(); i++ {
					let (start, end) = span(i)
					let edge = rtl ?? (start, end - thick)
					let held = i == dragged || (i == over && dragged < 0)
					ctx.draw.fill(Rect{left: edge, top: 0.0, right: edge + thick, bottom: box.bottom}, held ?? (look.palette.borderStrong, look.palette.divider))
				}
			}
		}

		view {
			for let i = 0; i < titles.len(); i++ {
				GridHead(titles[i], mark = i < marks.len() ?? (marks[i], HeadMark.Plain), key = i)
			}
		}

		style {
			Box
			Layout
			Tracks
			Interaction
			Clipping
			arrange = Arrange.Grid
			columns = self.tracks
			rows    = [new Track(theme.metrics.controlHeight)]
			// Columns wider together than the grid end at its edge, as the rows under
			// them do.
			clip = true
			// A header or a cell is as wide as its track whatever its own size is.
			align  = Align{horizontal: Alignment.Fill, vertical: Alignment.Center}
			width  = fill
			height = theme.metrics.controlHeight
		}
	}

	// One row of a grid: its cells in the grid's columns.
	internal component GridLine {
		type {
			@input
			tracks Track[] = []

			def new() {
				role = Role.Row
			}
		}

		view {
			children()
		}

		style {
			Box
			Layout
			Tracks
			arrange = Arrange.Grid
			columns = self.tracks
			// A header or a cell is as wide as its track whatever its own size is.
			align = Align{horizontal: Alignment.Fill, vertical: Alignment.Center}
			width = fill
		}
	}

	// One cell of a grid; what does not fit its column is cut off.
	internal component GridCell {
		type {
			def new() {
				role = Role.Cell
			}
		}

		view {
			children()
		}

		style {
			Box
			Layout
			Clipping
			Typography
			// One line, shortened with an ellipsis where the column is narrower.
			paragraph = ParagraphLayout{wrap: Wrap.None, overflow: TextOverflow.Ellipsis}
			clip      = true
			align     = Align{horizontal: Alignment.Start, vertical: Alignment.Center}
			padding   = new Edges<Extent>(0(px), theme.metrics.unit * 2.0, 0(px), theme.metrics.unit * 2.0)
		}
	}

	// Rows in columns under a line of headers, scrolled and selected as a `List`:
	// `DataGrid(files, columns = [new GridColumn<File>("Name", cell = (it RowItem<File>) => Text(it.content.name), order = byName), new GridColumn<File>("Size", width = 80(px))])`.
	// Rows come as an array or as a `Source`; a cell is what its column's `cell` draws, or
	// the row as text.
	//
	// A press on the header of a column that has an `order` sorts the rows by it, a second
	// press the other way round, a third as they were given; `sortBy` and `descending` say
	// how they are sorted and can be set. The grid sorts a copy of `rows`, again when
	// `rows` is another array or another length. A grid over a `Source` sorts nothing: it
	// tells `onSort` and the source orders its items.
	//
	// The end of a header is dragged to give its column another width; a double click
	// there makes the column as wide as what it holds. With `persist` those widths are
	// kept between runs under that name. A cell's text is one line, shortened with an
	// ellipsis where its column is narrower.
	//
	// Rows are told apart, selected, moved through and opened as those of a `List`.
	component DataGrid<T, I = T> {
		type {
			// The rows, when they are an array.
			@input(value = true)
			rows T[] = []

			// The rows, when they are not an array; `rows` is then not read.
			@input
			source ?Source<T> = none

			@input
			columns GridColumn<T>[] = []

			// A row's identity; none: the row itself.
			@input
			id ?(def(T) I) = none

			// The ids of the selected rows, as on a `List`.
			@input(bind = true)
			@state
			selected I[] = []

			// How many rows can be selected.
			@input
			selection SelectionMode = SelectionMode.Single

			// The height every row has; none: each row is as high as its cells.
			@input
			rowHeight ?Pixels = none

			// The key of the column the rows are sorted by; empty: as they were given.
			@input(bind = true)
			@state
			sortBy string = ""

			// Whether they are sorted last to first.
			@input(bind = true)
			@state
			descending bool = false

			// A name to keep the widths the user gave the columns under between runs;
			// empty: not kept.
			@input
			persist string = ""

			// Runs when the selection changed, with the ids now selected.
			@input
			onChange ?(def(I[])) = none

			// Tells every listener the selection changed, after the handler ran.
			@emit()
			def changed(ids I[]) I[] {
				return ids
			}

			// Runs when a row is opened: Enter, or a double click on it.
			@input
			onOpen ?(def(T)) = none

			// Tells every listener a row was opened, after the handler ran.
			@emit()
			def opened(item T) T {
				return item
			}

			// Runs when the user sorted the rows: the column's key (empty: not sorted any
			// more) and whether last to first.
			@input
			onSort ?(def(string, bool)) = none

			// Tells every listener the user sorted the rows, after the handler ran.
			@emit()
			def sorted(by string, down bool) GridSort {
				return GridSort{key: by, descending: down}
			}

			// The widths the user gave columns, by their keys, and the name they were
			// read for.
			sized    map<string, float>
			sizedFor ?string = none

			// The column being made as wide as what it holds, whose track is `auto` until
			// the next layout was read; -1: none.
			fitting int = -1

			// The rows in order, and what they were ordered from.
			ordered     T[]
			orderedFrom ?T[] = none
			orderedSize int = -1
			orderedBy   string = ""
			orderedDown bool = false

			def new() {
				role = Role.Table
			}

			// The name a column has in `sortBy` and in the kept widths.
			def keyOf(column GridColumn<T>) string {
				return column.key == "" ?? (column.title, column.key)
			}

			// The column with this key; -1: none.
			def columnAt(name string) int {
				return -1 when name == ""
				for let (i, column) in columns {
					return i when keyOf(column) == name
				}
				return -1
			}

			// The id of the row the keyboard is on.
			def current() ?I {
				let inner = list
				return none when inner is none
				return inner.current()
			}

			// Scrolls so the row with this id shows.
			def reveal(key I) {
				let inner = list
				inner.reveal(key) unless inner is none
			}

			// Reads the kept widths when `persist` is another name.
			def recall() {
				let read = sizedFor
				return when !(read is none) && read == persist
				sizedFor = persist
				sized    = map<string, float>{}
				sized    = restored<map<string, float>>("{keptName(self, persist)}.columns", sized) when keepable(persist)
			}

			// The track of each column: the width the user gave it, else its own, else a
			// share of the room left. When every column has a width, the last one takes the
			// room left as well and is at least as wide as it was given, so the rows reach
			// the end of the grid as the headers' line does.
			def tracks() Track[] {
				recall()
				let all Track[]
				let least Extent = gridLeast * 1(px)
				let shares = false
				let last = 0.0
				for let (at, column) in columns {
					let name = keyOf(column)
					let own = column.width
					if at == fitting {
						all.push(new Track(auto))
						shares = true
					} else if sized.hasKey(name) {
						last = sized[name]
						all.push(new Track(last * 1(px)))
					} else if own is none {
						all.push(new Track(fill, least))
						shares = true
					} else {
						last = float(own)
						all.push(new Track(own))
					}
				}
				if !shares && all.len() > 0 {
					let floor Extent = last * 1(px)
					all[all.len() - 1] = new Track(fill, floor)
				}
				return all
			}

			def titles() string[] {
				let all string[]
				for let column in columns {
					all.push(column.title)
				}
				return all
			}

			def marks() HeadMark[] {
				let all HeadMark[]
				for let column in columns {
					if sortBy != "" && keyOf(column) == sortBy {
						all.push(descending ?? (HeadMark.Descending, HeadMark.Ascending))
					} else if column.sortable || !(column.order is none) {
						all.push(HeadMark.Sortable)
					} else {
						all.push(HeadMark.Plain)
					}
				}
				return all
			}

			def sizable() bool[] {
				let all bool[]
				for let column in columns {
					all.push(column.resizable)
				}
				return all
			}

			// The rows as they show: sorted by the column `sortBy` names when it has an
			// `order`, else as given.
			def shown() T[] {
				let at = columnAt(sortBy)
				return rows when at < 0 || !(source is none)
				let order = columns[at].order
				return rows when order is none
				let from = orderedFrom
				return ordered when !(from is none) && from == rows && orderedSize == rows.len() && orderedBy == sortBy && orderedDown == descending
				let down = descending
				ordered     = rows.clone().sort((a T, b T) => down ?? (order(b, a) < 0, order(a, b) < 0))
				orderedFrom = rows
				orderedSize = rows.len()
				orderedBy   = sortBy
				orderedDown = descending
				return ordered
			}

			// The header of column `index` was pressed: first to last, then last to
			// first, then as given.
			def sortOn(index int) {
				return when disabled || index < 0 || index >= columns.len()
				let column = columns[index]
				return unless column.sortable || !(column.order is none)
				let name = keyOf(column)
				if sortBy != name {
					sortBy     = name
					descending = false
				} else if !descending {
					descending = true
				} else {
					sortBy     = ""
					descending = false
				}
				let tell = onSort
				tell(sortBy, descending) unless tell is none
				sorted(sortBy, descending)
				redraw()
			}

			// The most column `index` can be dragged to: the room the grid has after the
			// columns before it, less what the columns after it keep (the width each was
			// given, by the user or by its column, else the least a drag gives one). Not
			// laid out yet: none, no limit.
			def roomFor(index int) ?float {
				let heads = childNodes[0]
				return none when index >= heads.childNodes.len()
				let line = heads.style.geom.frame
				let head = heads.childNodes[index].style.geom.frame
				let whole = float(line.width)
				return none when whole <= 0.0
				let before = style.geom.direction == Direction.RightToLeft ?? (float(line.right) - float(head.right), float(head.left) - float(line.left))
				let after = 0.0
				for let at = index + 1; at < columns.len(); at++ {
					let name = keyOf(columns[at])
					let own = columns[at].width
					if sized.hasKey(name) {
						after += sized[name]
					} else if own is none {
						after += gridLeast
					} else {
						after += float(own)
					}
				}
				return whole - before - after
			}

			// The user drags column `index` to `width`: no further than leaves the columns
			// after it in the grid, and never under the least width.
			def sizeTo(index int, given float) {
				return when index < 0 || index >= columns.len()
				recall()
				let room = roomFor(index)
				let width = given
				width = width.min(room) unless room is none
				width = width.max(gridLeast)
				let name = keyOf(columns[index])
				return when sized.hasKey(name) && sized[name] == width
				sized[name] = width
				keep<map<string, float>>("{keptName(self, persist)}.columns", sized) when keepable(persist)
				rerun()
				redraw()
			}

			// The end of column `index` was pressed twice: the column becomes as wide as
			// its header and the widest of its cells in the rows that show (rows not
			// mounted are not measured), within the room the grid has. Its track is `auto`
			// for the next layout, after which `fitted` takes the widths.
			def fitTo(index int) {
				return when index < 0 || index >= columns.len() || !columns[index].resizable
				fitting = index
				rerun()
				afterArrange(fitted)
				redraw()
			}

			// Takes the widest of the fitted column's header and cells, as laid out, for
			// the column's width.
			def fitted() {
				let at = fitting
				return when at < 0 || at >= columns.len()
				let widest = 0.0
				if childNodes.len() > 0 {
					let heads = childNodes[0]
					widest = float(heads.childNodes[at].style.geom.frame.width) when at < heads.childNodes.len()
				}
				let inner = list
				if !(inner is none) {
					let pane = inner.port
					if !(pane is none) {
						for let row in pane.childNodes {
							continue unless row is ListRow
							continue when row.childNodes.len() == 0
							let line = row.childNodes[0]
							continue unless line is GridLine
							continue when at >= line.childNodes.len()
							widest = widest.max(float(line.childNodes[at].style.geom.frame.width))
						}
					}
				}
				fitting = -1
				if widest > 0.0 {
					sized[keyOf(columns[at])] = widest.ceil().max(gridLeast)
					keep<map<string, float>>("{keptName(self, persist)}.columns", sized) when keepable(persist)
				}
				rerun()
				redraw()
			}

			// The list selected other rows. What the list was given is a copy of
			// `selected`, so the grid's own is assigned here.
			def picked(ids I[]) {
				selected = ids
				let tell = onChange
				tell(ids) unless tell is none
				changed(ids)
			}

			def entered(item T) {
				let tell = onOpen
				tell(item) unless tell is none
				opened(item)
			}

			// The cells of one row.
			def line(it RowItem<T>) view {
				return view {
					GridLine(tracks = tracks()) {
						for let column in columns {
							GridCell() {
								let make = column.cell
								if make is none {
									Text("{it.content}")
								} else {
									make(it)
								}
							}
						}
					}
				}
			}
		}

		view {
			GridHeads(titles = titles(), marks = marks(), tracks = tracks(), sizable = sizable(), onSort = sortOn, onSize = sizeTo, onFit = fitTo)
			List(shown(), source = source, id = id, selected = selected, selection = selection, rowHeight = rowHeight, rowRenderer = line, persist = persist, onChange = picked, onOpen = entered, ref = list)
		}

		style DataGridStyle
	}
}
