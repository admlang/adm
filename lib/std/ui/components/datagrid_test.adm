partial module std.ui.components {
	use (
		std.math.geom::(Point, Size)
		std.services.vault::(Vault, VaultConfig)
		std.services.vault.kept::forget
		std.testing
		std.ui::PointerPhase
		std.ui.runtime::Scene
		std.ui.styles::*
		std.units::Pixels
	)

	internal let gridLog = string[]

	// A row told from another by being that object.
	type Person {
		name string = ""
		age  int    = 0

		def new(name string, age int) {
			self.name = name
			self.age = age
		}
	}

	// Three people in a grid 300 wide: a name that takes the room left, an age 60 wide,
	// a column with neither cell nor order.
	component PeoplePage {
		type {
			@bindable
			by string = ""

			@bindable
			down bool = false

			@bindable
			picked string[] = []

			people Person[] = [new Person("cy", 30), new Person("ada", 41), new Person("bob", 25)]

			// The name the grid keeps its widths under.
			kept string = ""

			def new() {
				style.width = 300(px)
				style.height = 200(px)
			}

			def named(person Person) string {
				return person.name
			}

			def byName(a Person, b Person) int {
				return a.name.compare(b.name)
			}

			def byAge(a Person, b Person) int {
				return a.age - b.age
			}

			def noted(key string, last bool) {
				gridLog.push("{key} {last}")
			}
		}

		view {
			DataGrid(people, id = named, selected = picked, sortBy = by, descending = down, rowHeight = 20(px), persist = kept, onSort = noted, columns = [
				new GridColumn<Person>("Name", cell = (it RowItem<Person>) => Text(it.content.name), order = byName),
				new GridColumn<Person>("Age", cell = (it RowItem<Person>) => Text("{it.content.age}"), width = 60(px), order = byAge),
				new GridColumn<Person>("Note", resizable = false),
			], ref = grid)
		}

		style StageStyle
	}

	// A grid over a source, whose one column says that it sorts.
	component CountlessGridPage {
		type {
			numbers Countless = new Countless()

			def new() {
				style.width = 300(px)
				style.height = 200(px)
			}

			def noted(key string, last bool) {
				gridLog.push("{key} {last}")
			}
		}

		view {
			DataGrid(source = numbers, rowHeight = 20(px), onSort = noted, columns = [new GridColumn<int>("Number", sortable = true, key = "n")], ref = grid)
		}

		style StageStyle
	}

	check "DataGrid" {
		// The headers of a grid, in order.
		def headsOf(grid component) GridHead[] {
			let heads GridHead[]
			for let child in grid.childNodes[0].childNodes {
				heads.push(child) when child is GridHead
			}
			return heads
		}

		// The rows of a grid as mounted now, top to bottom.
		def linesOf(port component) GridLine[] {
			let lines GridLine[]
			for let child in port.childNodes {
				continue unless child is ListRow
				let inside = child.childNodes[0]
				lines.push(inside) when inside is GridLine
			}
			return lines
		}

		// What the first cells of the mounted rows say, joined with commas.
		def firstsOf(port component) string {
			let said string[]
			for let line in linesOf(port) {
				let label = line.childNodes[0].childNodes[0]
				said.push(label.text) when label is Text
			}
			return said.join(",")
		}

		// The middle of a component.
		def middle(c component) Point<Pixels> {
			let box = c.style.geom.frame
			return new Point<Pixels>((box.left + box.right) / 2.0, (box.top + box.bottom) / 2.0)
		}

		def click(scene Scene, at Point<Pixels>) {
			scene.pointer(PointerPhase.Down, at)
			scene.pointer(PointerPhase.Up, at)
		}

		// The cells of a row stand under the headers of their columns: a column with a
		// width has it, the others share the room left.
		@test()
		def TestGridLaysCellsUnderHeaders() {
			let page = PeoplePage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(300(px), 200(px))
			scene.arrange(size)
			scene.arrange(size)
			let grid = page.grid
			assert !(grid is none)
			return when grid is none
			let list = grid.list
			assert !(list is none)
			return when list is none
			let port = list.port
			return when port is none

			let heads = headsOf(grid)
			assert heads.len() == 3
			let lines = linesOf(port)
			assert lines.len() == 3
			assert firstsOf(port) == "cy,ada,bob"
			for let (i, head) in heads {
				let above = head.style.geom.frame
				let cell = lines[1].childNodes[i].style.geom.frame
				assert above.left == cell.left && above.right == cell.right
			}
			assert float(heads[1].style.geom.frame.width) == 60.0
			assert float(heads[0].style.geom.frame.width) == 120.0 && float(heads[2].style.geom.frame.width) == 120.0
			// A column without `cell` shows the row as text; the rows start under the headers.
			let age = lines[0].childNodes[1].childNodes[0]
			assert age is Text && age.text == "30"
			assert lines[0].style.geom.frame.top >= heads[0].style.geom.frame.bottom
			scene.close()
		}

		// A press on a header sorts by its column, a second the other way round, a third
		// as given; the selection stays on its row. A header without `order` sorts nothing.
		@test()
		def TestGridSortsByAColumn() {
			gridLog.len(0)
			let page = PeoplePage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(300(px), 200(px))
			scene.arrange(size)
			scene.arrange(size)
			let grid = page.grid
			return when grid is none
			let list = grid.list
			return when list is none
			let port = list.port
			return when port is none
			let heads = headsOf(grid)

			click(scene, middle(linesOf(port)[0]))
			assert page.picked.join(",") == "cy"

			click(scene, middle(heads[0]))
			scene.arrange(size)
			scene.arrange(size)
			assert page.by == "Name" && !page.down
			assert firstsOf(port) == "ada,bob,cy"
			assert headsOf(grid)[0].mark == HeadMark.Ascending && headsOf(grid)[1].mark == HeadMark.Sortable
			assert page.picked.join(",") == "cy"
			let rows ListRow[]
			for let child in port.childNodes {
				rows.push(child) when child is ListRow
			}
			assert rows[2].selected && !rows[0].selected

			click(scene, middle(heads[0]))
			scene.arrange(size)
			scene.arrange(size)
			assert page.by == "Name" && page.down
			assert firstsOf(port) == "cy,bob,ada"

			click(scene, middle(heads[1]))
			scene.arrange(size)
			scene.arrange(size)
			assert page.by == "Age" && !page.down
			assert firstsOf(port) == "bob,cy,ada"

			click(scene, middle(heads[2]))
			assert page.by == "Age"
			click(scene, middle(heads[1]))
			click(scene, middle(heads[1]))
			scene.arrange(size)
			scene.arrange(size)
			assert page.by == "" && !page.down
			assert firstsOf(port) == "cy,ada,bob"
			assert gridLog.join(",") == "Name false,Name true,Age false,Age true, false"

			// Set by the page.
			page.by = "Age"
			page.down = true
			scene.arrange(size)
			scene.arrange(size)
			assert firstsOf(port) == "ada,cy,bob"
			assert headsOf(grid)[1].mark == HeadMark.Descending
			scene.close()
		}

		// The end of a header is dragged to give its column another width, in the header
		// and in every row; a column that is not resizable stays.
		@test()
		def TestGridResizesAColumn() {
			gridLog.len(0)
			let page = PeoplePage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(300(px), 200(px))
			scene.arrange(size)
			scene.arrange(size)
			let grid = page.grid
			return when grid is none
			let list = grid.list
			return when list is none
			let port = list.port
			return when port is none
			let heads = headsOf(grid)

			let end = heads[1].style.geom.frame
			let from = new Point<Pixels>(end.right - 1(px), (end.top + end.bottom) / 2.0)
			let to = new Point<Pixels>(end.right + 39(px), (end.top + end.bottom) / 2.0)
			scene.pointer(PointerPhase.Down, from)
			scene.pointer(PointerPhase.Move, to)
			scene.pointer(PointerPhase.Up, to)
			scene.arrange(size)
			scene.arrange(size)
			assert float(headsOf(grid)[1].style.geom.frame.width) == 100.0
			assert float(linesOf(port)[2].childNodes[1].style.geom.frame.width) == 100.0
			assert float(headsOf(grid)[0].style.geom.frame.width) == 100.0
			// The drag sorted nothing.
			assert page.by == "" && gridLog.len() == 0

			// Dragged far back: not under the least width.
			let again = headsOf(grid)[1].style.geom.frame
			let hold = new Point<Pixels>(again.right - 1(px), (again.top + again.bottom) / 2.0)
			scene.pointer(PointerPhase.Down, hold)
			scene.pointer(PointerPhase.Move, new Point<Pixels>(0(px), hold.y))
			scene.pointer(PointerPhase.Up, new Point<Pixels>(0(px), hold.y))
			scene.arrange(size)
			scene.arrange(size)
			assert float(headsOf(grid)[1].style.geom.frame.width) == gridLeast

			// Every column with a width: the last one takes the room left, so the rows
			// reach the end of the grid.
			grid.sizeTo(0, 50.0)
			grid.sizeTo(2, 40.0)
			scene.arrange(size)
			scene.arrange(size)
			let all = headsOf(grid)
			assert float(all[0].style.geom.frame.width) == 50.0 && float(all[1].style.geom.frame.width) == gridLeast
			assert float(all[2].style.geom.frame.right) == 300.0
			assert float(linesOf(port)[0].childNodes[2].style.geom.frame.right) == 300.0

			// The last column cannot be dragged: the press is one on its header.
			let last = headsOf(grid)[2].style.geom.frame
			let edge = new Point<Pixels>(last.right - 1(px), (last.top + last.bottom) / 2.0)
			scene.pointer(PointerPhase.Down, edge)
			scene.pointer(PointerPhase.Move, new Point<Pixels>(last.right - 50(px), edge.y))
			scene.pointer(PointerPhase.Up, new Point<Pixels>(last.right - 50(px), edge.y))
			scene.arrange(size)
			scene.arrange(size)
			assert float(headsOf(grid)[1].style.geom.frame.width) == gridLeast
			scene.close()
		}

		// A grid over a source mounts only the rows that show and sorts nothing itself:
		// a press on a sortable header tells `onSort`.
		@test()
		def TestGridOverASource() {
			gridLog.len(0)
			let page = CountlessGridPage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(300(px), 200(px))
			scene.arrange(size)
			scene.arrange(size)
			let grid = page.grid
			return when grid is none
			let list = grid.list
			return when list is none
			let port = list.port
			return when port is none
			let lines = linesOf(port)
			assert lines.len() > 0 && lines.len() < 20
			assert firstsOf(port).startsWith("0,1,2")

			click(scene, middle(headsOf(grid)[0]))
			scene.arrange(size)
			scene.arrange(size)
			assert grid.sortBy == "n" && !grid.descending
			assert gridLog.join(",") == "n false"
			assert firstsOf(port).startsWith("0,1,2")
			assert headsOf(grid)[0].mark == HeadMark.Ascending
			scene.close()
		}

		// With `persist` the widths the user gave are there for the next grid of that name.
		@test()
		def TestGridKeepsWidths() !none {
			Vault.config(VaultConfig{memoryKiB: 64, passes: 1}) onerror recover none
			forget("test.people.columns")
			let size = new Size<Pixels>(300(px), 200(px))
			let page = PeoplePage()
			page.kept = "test.people"
			page.rerun()
			let scene = new Scene(page)
			scene.arrange(size)
			scene.arrange(size)
			let grid = page.grid
			return when grid is none
			let end = headsOf(grid)[1].style.geom.frame
			let from = new Point<Pixels>(end.right - 1(px), (end.top + end.bottom) / 2.0)
			let to = new Point<Pixels>(end.right + 19(px), (end.top + end.bottom) / 2.0)
			scene.pointer(PointerPhase.Down, from)
			scene.pointer(PointerPhase.Move, to)
			scene.pointer(PointerPhase.Up, to)
			scene.arrange(size)
			scene.arrange(size)
			assert float(headsOf(grid)[1].style.geom.frame.width) == 80.0
			scene.close()

			let next = PeoplePage()
			next.kept = "test.people"
			next.rerun()
			let again = new Scene(next)
			again.arrange(size)
			again.arrange(size)
			let other = next.grid
			return when other is none
			assert float(headsOf(other)[1].style.geom.frame.width) == 80.0
			again.close()
			forget("test.people.columns")
		}

		// A column narrower than its text keeps every row on one line and the cells
		// under their headers; a double click at the end of a header makes the column
		// as wide as its header and the widest of its cells.
		@test()
		def TestGridShortensTextAndFitsAColumn() {
			let page = PeoplePage()
			page.people = [new Person("a very long name that does not fit a narrow column", 30), new Person("ada", 41)]
			page.rerun()
			let scene = new Scene(page)
			let size = new Size<Pixels>(300(px), 200(px))
			let frames = def () {
				scene.arrange(size)
				scene.arrange(size)
				scene.arrange(size)
				scene.arrange(size)
			}
			frames()
			let grid = page.grid
			return when grid is none
			let list = grid.list
			return when list is none
			let port = list.port
			return when port is none
			let oneLine = float(linesOf(port)[1].style.geom.frame.height)

			grid.sizeTo(0, 30.0)
			frames()
			let heads = headsOf(grid)
			assert float(heads[0].style.geom.frame.width) == 30.0
			for let line in linesOf(port) {
				assert float(line.style.geom.frame.height) == oneLine
				for let (i, cell) in line.childNodes {
					let (above, box) = (heads[i].style.geom.frame, cell.style.geom.frame)
					assert above.left == box.left && above.right == box.right
					let label = cell.childNodes[0].style.geom.frame
					assert label.left >= box.left && label.right <= box.right
				}
			}
			let long = linesOf(port)[0].childNodes[0].childNodes[0]
			assert long is Text && long.current().shortens()

			// The double click: the first press, then the second on the same spot.
			let end = headsOf(grid)[0].style.geom.frame
			let edge = new Point<Pixels>(end.right - 1(px), (end.top + end.bottom) / 2.0)
			scene.pointer(PointerPhase.Down, edge)
			scene.pointer(PointerPhase.Up, edge)
			scene.pointer(PointerPhase.Down, edge, clicks = 2)
			scene.pointer(PointerPhase.Up, edge)
			frames()
			let wide = float(headsOf(grid)[0].style.geom.frame.width)
			assert wide > 200.0
			let cell = linesOf(port)[0].childNodes[0]
			assert float(cell.style.geom.frame.width) == wide
			let whole = cell.childNodes[0].style.geom.frame
			// The text is all there: as wide as the cell without its padding.
			assert float(whole.width) > 180.0 && whole.right <= cell.style.geom.frame.right
			// Fitted again with short names only, it is as wide as its header needs.
			page.people = [new Person("cy", 30), new Person("ada", 41)]
			page.rerun()
			frames()
			grid.fitTo(0)
			frames()
			let narrow = float(headsOf(grid)[0].style.geom.frame.width)
			assert narrow < 120.0 && narrow >= gridLeast
			assert float(linesOf(port)[0].childNodes[0].style.geom.frame.width) == narrow
			scene.close()
		}
	}
}
