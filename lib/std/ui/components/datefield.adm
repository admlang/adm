partial module std.ui.components {
	use (
		std.i18n
		std.gfx.color::Color
		std.math.geom::(Axes, Path, Point, Rect, Size, StrokeStyle)
		std.services.i18n::(I18n)
		std.time
		std.time::(Date, Weekday)
		std.ui::(Key, KeyEvent, Limit, MouseButton, PointerEvent, PointerPhase, RenderContext, Theme, UI, themeOf)
		std.ui.frames::askFrame
		std.ui.paint
		std.ui.styles::*
		std.units::(Extent, Pixels)
	)

	// The number a weekday has counting from Sunday as 0.
	internal def weekdayIndex(day Weekday) int {
		switch day {
			case Weekday.Sunday:
				return 0
			case Weekday.Monday:
				return 1
			case Weekday.Tuesday:
				return 2
			case Weekday.Wednesday:
				return 3
			case Weekday.Thursday:
				return 4
			case Weekday.Friday:
				return 5
			default:
				return 6
		}
	}

	// Today in the region's time zone.
	internal def todayInRegion() Date {
		return I18n.timeZone().dateTime(time.now()).date
	}

	// `d` kept between `least` and `most`, those that are set.
	internal def dateWithin(d Date, least ?Date, most ?Date) Date {
		let out = d
		out = least when !(least is none) && d.compare(least) < 0
		out = most when !(most is none) && out.compare(most) > 0
		return out
	}

	// The order the day, month and year take in the region's short date: "dmy" for
	// "30.11.26", "mdy" for "11/30/26", "ymd" for "2026-11-30", read off the date the
	// region writes for 31 December 2011.
	internal def shortDateOrder() string {
		let written = new i18n.DateTimeFormat(i18n.DateTimeOptions{dateStyle: i18n.DateTimeStyle.Short}).format(new Date(2011, 12, 31)) onerror recover ""
		let day = written.indexOf("31")
		let month = written.indexOf("12")
		let year = written.indexOf("2011")
		year = written.lastIndexOf("11") when year < 0
		return "ymd" when day < 0 || month < 0 || year < 0
		let out = ""
		for let step = 0; step < 3; step++ {
			// The field that stands first among those not taken yet.
			let at = -1
			let letter = ' '
			(at, letter) = (day, 'd') when day >= 0 && (at < 0 || day < at)
			(at, letter) = (month, 'm') when month >= 0 && (at < 0 || month < at)
			(at, letter) = (year, 'y') when year >= 0 && (at < 0 || year < at)
			out += letter
			day = -1 when letter == 'd'
			month = -1 when letter == 'm'
			year = -1 when letter == 'y'
		}
		return out
	}

	// The date `text` writes: its runs of digits taken in the region's order (a run of
	// four digits is the year wherever it stands, so an ISO date reads everywhere), a
	// two-digit year counted from 1950 to 2049. None for text that is no date.
	internal def parseDateText(text string, order string) ?Date {
		let runs string[]
		let run = ""
		for let ch in text {
			if ch >= '0' && ch <= '9' {
				run += ch
				continue
			}
			runs.push(run) when run != ""
			run = ""
		}
		runs.push(run) when run != ""
		return none when runs.len() != 3
		let letters = order
		for let (i, part) in runs {
			if part.len() == 4 {
				letters = i == 0 ?? ("y" + order.replace("y", ""), order.replace("y", "") + "y")
				break
			}
		}
		let (year, month, day) = (0, 0, 0)
		for let (i, part) in runs {
			return none when part.len() > 4
			let number = parseInt<int>(part)
			let letter = letters[i]
			if letter == 'y' {
				year = number
				year += part.len() <= 2 ?? (number < 50 ?? (2000, 1900), 0)
			} else if letter == 'm' {
				month = number
			} else {
				day = number
			}
		}
		return none when year < 1 || month < 1 || month > 12 || day < 1
		let made = new Date(year, month, 1)
		return none when day > made.daysInMonth()
		return new Date(year, month, day)
	}

	// The days of one month in a grid of seven columns, the `Calendar`'s part named
	// `grid`: it draws the day numbers under the weekday initials, in the region's week
	// order, the days of the months around it muted, today ringed, the chosen day in the
	// accent, the keyboard's day with the focus ring. A press picks a day; the arrows move
	// by a day and a week, Page Up and Page Down by a month, Home and End to the ends of
	// the month, Enter and Space pick.
	internal component MonthGrid {
		type {
			// The first day of the month shown.
			@input
			first Date = todayInRegion()

			// The chosen day.
			@input
			value ?Date = none

			// The day the keyboard is on.
			@input
			cursor Date = todayInRegion()

			// Days before `min` and after `max` cannot be picked.
			@input
			min ?Date = none

			@input
			max ?Date = none

			// Runs with the day picked.
			@input
			onPick ?(def(Date)) = none

			// Runs with the day the keyboard moved to, which may be in another month.
			@input
			onMove ?(def(Date)) = none

			look   Theme = UI.theme()
			// The weekday initials from the week's first day on, and the region they
			// were made for.
			names   string[]
			namesOf string = ""
			// The weekday the week starts on, counted from Sunday as 0.
			start   int = 1
			// The text blocks of the day numbers, 1 to 31, and of the initials.
			numbers paint.TextBlock[]
			heads   paint.TextBlock[]
			// The cell under the pointer: an index into the grid, -1 for none.
			over    int = -1

			def new() {
				focusable = true
			}

			// Reads the weekday names and the week's start for the region in use.
			def regional() {
				let region = I18n.region().str()
				return when region == namesOf
				namesOf = region
				let narrow = new i18n.DateTimeFormat(i18n.DateTimeOptions{weekday: i18n.TextField.Narrow})
				start = weekdayIndex(narrow.weekStart())
				names = []
				// 1 January 2023 was a Sunday.
				for let i = 0; i < 7; i++ {
					let day = new Date(2023, 1, 1).plusDays((start + i) % 7)
					names.push(narrow.format(day) onerror recover "")
				}
				heads   = []
				numbers = []
			}

			// The side of a cell and the height of the row of initials.
			def cell() float {
				return (em * 2.25).round()
			}

			def headHeight() float {
				return (em * 1.5).round()
			}

			// The date at grid index `i` (row by row from the first cell), which may be
			// before the month or after it.
			def dateAt(i int) Date {
				let lead = (weekdayIndex(first.weekday()) - start + 7) % 7
				return first.plusDays(i - lead)
			}

			// The grid index of a date, or -1 when the grid does not show it.
			def indexOf(d Date) int {
				let lead = (weekdayIndex(first.weekday()) - start + 7) % 7
				let i = first.daysUntil(d) + lead
				return i >= 0 && i < 42 ?? (i, -1)
			}

			def allowed(d Date) bool {
				let least = min
				return false when !(least is none) && d.compare(least) < 0
				let most = max
				return false when !(most is none) && d.compare(most) > 0
				return true
			}

			def pick(d Date) {
				return when disabled || !allowed(d)
				let tell = onPick
				tell(d) unless tell is none
			}

			// The keyboard's day moved: noted here too, so keys that follow in the same
			// frame count from it.
			def moveTo(d Date) {
				cursor = d
				let tell = onMove
				tell(d) unless tell is none
				redraw()
			}

			// The grid index under a point of the component, -1 outside the cells.
			def cellAt(at Point<Pixels>) int {
				let (x, y) = (float(at.x), float(at.y) - headHeight())
				let side = cell()
				return -1 when x < 0.0 || y < 0.0
				let (column, row) = (int(x / side), int(y / side))
				return -1 when column > 6 || row > 5
				column = 6 - column when style.geom.direction == Direction.RightToLeft
				return row * 7 + column
			}

			def pointer(e PointerEvent) bool {
				regional()
				match e.phase {
					case PointerPhase.Down:
						return false when disabled || e.button != MouseButton.Left
						let i = cellAt(e.position)
						return false when i < 0
						focus()
						moveTo(dateAt(i))
						pick(dateAt(i))
						return true
					case PointerPhase.Move:
						let i = cellAt(e.position)
						if i != over {
							over = i
							redraw()
						}
						return false
					case PointerPhase.Leave:
						if over >= 0 {
							over = -1
							redraw()
						}
						return false
					default:
						return false
				}
			}

			def key(e KeyEvent) bool {
				return false when !e.down || disabled
				regional()
				match e.key {
					case Key.Left:
						moveTo(cursor.plusDays(style.geom.direction == Direction.RightToLeft ?? (1, -1)))
					case Key.Right:
						moveTo(cursor.plusDays(style.geom.direction == Direction.RightToLeft ?? (-1, 1)))
					case Key.Up:
						moveTo(cursor.plusDays(-7))
					case Key.Down:
						moveTo(cursor.plusDays(7))
					case Key.PageUp:
						moveTo(cursor.plusMonths(-1))
					case Key.PageDown:
						moveTo(cursor.plusMonths(1))
					case Key.Home:
						moveTo(new Date(cursor.year, cursor.month, 1))
					case Key.End:
						moveTo(new Date(cursor.year, cursor.month, cursor.daysInMonth()))
					case Key.Enter, Key.KeypadEnter, Key.Space:
						pick(cursor)
					default:
						return false
				}
				return true
			}

			// Layout asks the size before anything is drawn: the week's order is read
			// here, so `dateAt` and `indexOf` answer for the region from the first frame.
			def measure(limit Limit) Size<Pixels> {
				regional()
				return new Size<Pixels>(cell() * 7.0 * 1(px), (headHeight() + cell() * 6.0) * 1(px))
			}

			// The block of the number `n` in the colour `ink`, kept for the next frame.
			def numberBlock(n int, ink Color) paint.TextBlock {
				for numbers.len() < 31 {
					numbers.push(labelBlock(none, (numbers.len() + 1).str(), style.font, em * 1(px), none, style.paragraph, ink))
				}
				let block = labelBlock(numbers[n - 1], n.str(), style.font, em * 1(px), none, style.paragraph, ink)
				numbers[n - 1] = block
				return block
			}

			def headBlock(i int) paint.TextBlock {
				for heads.len() < names.len() {
					heads.push(labelBlock(none, names[heads.len()], style.font, (em * 0.85) * 1(px), none, style.paragraph, look.palette.foregroundMuted))
				}
				return heads[i]
			}

			def render(ctx RenderContext) {
				regional()
				look = themeOf(self)
				let palette = look.palette
				let rtl = ctx.direction == Direction.RightToLeft
				let side = cell()
				let top = headHeight()
				let today = todayInRegion()
				let chosen = value
				for let i = 0; i < names.len(); i++ {
					let column = rtl ?? (6 - i, i)
					let box = Rect{left: float(column) * side, top: 0.0, right: float(column + 1) * side, bottom: top}
					paint.drawBlock(ctx.draw, headBlock(i), box, Align{horizontal: Alignment.Center, vertical: Alignment.Center}, rtl, ctx.scale)
				}
				for let i = 0; i < 42; i++ {
					let day = dateAt(i)
					let (row, column) = (i / 7, i % 7)
					column = 6 - column when rtl
					let box = Rect{left: float(column) * side, top: top + float(row) * side, right: float(column + 1) * side, bottom: top + float(row + 1) * side}
					let inner = Rect{left: box.left + 2.0, top: box.top + 2.0, right: box.right - 2.0, bottom: box.bottom - 2.0}
					let radius = side / 2.0 - 2.0
					let picked = !(chosen is none) && chosen.equals(day)
					let can = allowed(day)
					if picked {
						ctx.draw.fill(inner, radius, palette.accent)
					} else if i == over && can {
						ctx.draw.fill(inner, radius, palette.hover)
					}
					if today.equals(day) && !picked {
						ctx.draw.stroke(new Path().roundRect(inner, radius * 1(px)), palette.accent, StrokeStyle{width: 1.0(px)})
					}
					if focusVisible && cursor.equals(day) {
						ctx.draw.stroke(new Path().roundRect(inner, radius * 1(px)), palette.focus, StrokeStyle{width: look.metrics.focusWidth})
					}
					let ink = palette.foreground
					ink = palette.foregroundMuted when day.month != first.month
					ink = palette.foregroundDisabled unless can
					ink = palette.onAccent when picked
					paint.drawBlock(ctx.draw, numberBlock(day.day, ink), box, Align{horizontal: Alignment.Center, vertical: Alignment.Center}, rtl, ctx.scale)
				}
			}
		}

		view {}

		style {
			Box
			Control
			Layout
		}
	}

	// A month to pick a day from: `Calendar(value = due, onChange = setDue)`. Two buttons
	// and the month's name stand over the days (`MonthGrid`); the month shown is the
	// chosen day's, else today's, and follows the keyboard's day. `min` and `max` bound
	// what can be picked. Built from parts: `head` (the buttons `back` and `forward` with `monthTitle`
	// between them) and `grid`.
	component Calendar {
		type {
			// The chosen day; none for no choice.
			@input(value = true, bind = true)
			value ?Date = none

			// The least and the most it may be; none: no limit.
			@input
			min ?Date = none

			@input
			max ?Date = none

			// Runs with the day picked.
			@input
			onChange ?(def(Date)) = none

			// Tells every listener the day picked, after the handler ran: heard with
			// `@on(Calendar.changed)`.
			@emit()
			def changed(day Date) Date {
				return day
			}

			// The first day of the month shown, and the keyboard's day.
			shown  Date = todayInRegion()
			cursor Date = todayInRegion()
			// The chosen day the month was last shown for, and whether it was looked at.
			seen     ?Date = none
			followed bool = false
			// The month's name, and the region it was written for.
			titled   string = ""
			titledOf string = ""

			def new() {
				follow()
			}

			// Shows the chosen day's month when the caller changed the day.
			def follow() {
				let now = value
				let was = seen
				let same = (now is none && was is none) || (!(now is none) && !(was is none) && now.equals(was))
				return when same && followed
				followed = true
				seen     = now
				if !(now is none) {
					cursor = now
					show(now)
				}
			}

			// Shows the month of `d`.
			def show(d Date) {
				let month = new Date(d.year, d.month, 1)
				return when month.equals(shown)
				shown    = month
				titledOf = ""
			}

			// The month's name and year, in the region's words.
			def title() string {
				follow()
				let region = I18n.region().str()
				return titled when titledOf == region
				titledOf = region
				titled   = new i18n.DateTimeFormat(i18n.DateTimeOptions{month: i18n.MonthField.Long, year: i18n.NumericField.Numeric}).format(shown) onerror recover shown.str()
				return titled
			}

			def previous() {
				return when disabled
				moved(cursor.plusMonths(-1))
			}

			def next() {
				return when disabled
				moved(cursor.plusMonths(1))
			}

			// The keyboard's day moved: the month shown follows it.
			def moved(d Date) {
				cursor = d
				show(d)
			}

			// Picks `d`, inside the limits, and tells the caller when it is another day.
			def pick(d Date) {
				return when disabled || !dateWithin(d, min, max).equals(d)
				cursor = d
				show(d)
				seen = d
				let was = value
				return when !(was is none) && was.equals(d)
				value = d
				let tell = onChange
				tell(d) unless tell is none
				changed(d)
			}
		}

		view {
			Row(gap = 4(px), ref = head) {
				Button(icon = "chevron-left", onClick = previous, enabled = !disabled, ref = back)
				Text(title(), style = {width: fill, align: Align{horizontal: Alignment.Center, vertical: Alignment.Center}}, ref = monthTitle)
				Button(icon = "chevron-right", onClick = next, enabled = !disabled, ref = forward)
			}
			MonthGrid(first = shown, value = value, cursor = cursor, min = min, max = max, onPick = pick, onMove = moved, enabled = !disabled, ref = grid)
		}

		style {
			Box
			Layout
			arrange = Arrange.Column
			gap     = new Axes<Extent>(theme.metrics.unit)
		}
	}

	// A date typed or picked: `DateField(value = due, onChange = setDue)`. The field
	// shows and reads the date in the region's short form (`I18n.date`, "11/30/26" in
	// the United States, "30.11.26" in Germany; a four-digit year is read wherever it
	// stands, so "2026-11-30" reads everywhere). A date typed inside the limits is
	// taken as it is typed; other text changes nothing until Enter is pressed or the
	// focus leaves, when the field shows the date as it is, and empty text clears the
	// date. The button at its end, Down and Alt+Down open a `Calendar` under the
	// field, where a pick closes it; Escape closes it. `none` is no date.
	component DateField {
		type {
			// The date; none for empty.
			@input(value = true, bind = true)
			value ?Date = none

			// Shown while the field is empty.
			@input
			placeholder string = ""

			// The least and the most it may be; none: no limit.
			@input
			min ?Date = none

			@input
			max ?Date = none

			// Runs with the new date, or none when the field was cleared.
			@input
			onChange ?(def(?Date)) = none

			// Tells every listener its new date, after the handler ran: heard with
			// `@on(DateField.changed)`.
			@emit()
			def changed(now ?Date) ?Date {
				return now
			}

			// What the field shows, and the date that text was last made from or read as.
			text  string = ""
			known ?Date = none
			// Whether the focus was in it when it was drawn last.
			held  bool
			// Whether the calendar is shown, and whether a key opened it.
			opened bool
			byKey  bool
			// The region's order of day, month and year, and the region it was read for.
			order   string = ""
			orderOf string = ""

			def new() {
				text  = written(value)
				known = value
			}

			// The date as the field writes it: the region's short form.
			def written(d ?Date) string {
				return "" when d is none
				return I18n.date(d, i18n.DateTimeStyle.Short)
			}

			// The date `d` kept inside `min` and `max`.
			def bounded(d Date) Date {
				return dateWithin(d, min, max)
			}

			// The field's text: the date again when the caller changed it.
			def shown() string {
				let now = value
				let was = known
				let same = (now is none && was is none) || (!(now is none) && !(was is none) && now.equals(was))
				if !same {
					known = now
					text  = written(now)
				}
				return text
			}

			// Takes a date as the user set it and tells the caller when it is another.
			def take(d ?Date) {
				let to = d
				to    = bounded(d) unless d is none
				known = to
				let was = value
				return when (to is none && was is none) || (!(to is none) && !(was is none) && to.equals(was))
				value = to
				let tell = onChange
				tell(to) unless tell is none
				changed(to)
			}

			// The date `plain` writes in the region's order, none for other text.
			def read(plain string) ?Date {
				let region = I18n.region().str()
				if orderOf != region {
					orderOf = region
					order   = shortDateOrder()
				}
				return parseDateText(plain, order)
			}

			// The field's text changed: a date the field can hold as written is taken,
			// anything else waits for `settle`.
			def typed(now string) {
				text = now
				let plain = now.trim()
				if plain == "" {
					take(none)
					return
				}
				let d = read(plain)
				return when d is none
				take(d) when bounded(d).equals(d)
			}

			// Enter, or the focus left: typed text is taken as a date when it is one and
			// brought inside the limits, and the field shows the date as it is.
			def settle() {
				let plain = text.trim()
				if plain == "" {
					take(none)
				} else {
					let d = read(plain)
					take(d) unless d is none
				}
				text = written(value)
			}

			// The button at the end: the calendar, or none.
			def flip() {
				return when disabled
				byKey  = false
				opened = !opened
			}

			def shut() {
				opened = false
			}

			// A day picked in the calendar: taken, shown, and the calendar closed.
			def picked(d Date) {
				take(d)
				text   = written(value)
				opened = false
				let own = field
				own.focus() unless own is none
			}

			// Down opens the calendar at the date; the keyboard then moves in it.
			def key(e KeyEvent) bool {
				return false when !e.down || disabled
				return false when e.key != Key.Down
				return true when opened
				byKey  = true
				opened = true
				return true
			}

			def render(ctx RenderContext) {
				// The frame the focus leaves it, what was typed is settled.
				if held && !focusWithin && !opened {
					settle()
					askFrame(true)
				}
				held = focusWithin
				ctx.outerShadows()
				ctx.background()
				ctx.borders()
				ctx.childNodes()
				ctx.innerShadows()
			}
		}

		view {
			TextField(value = shown(), placeholder = placeholder, enabled = !disabled, trailing = "calendar", onTrailing = flip, onChange = typed, onSubmit = settle, ref = field, style = {width: fill})
			Popover(open = opened, attach = field, onClose = shut, ref = popover) {
				Calendar(value = value, min = min, max = max, onChange = picked, ref = calendar)
			}
		}

		// The field is its one child in the flow (the calendar floats): it fills the width
		// the date field has.
		style {
			Box
			Layout
			width = 200(px)
		}
	}
}
