partial module std.ui.components {
	use (
		std.math.geom::(Point, Size)
		std.services.i18n::(I18n, I18nScope)
		std.testing
		std.time::Date
		std.ui::(Key, KeyEvent, PointerPhase)
		std.ui.runtime::Scene
		std.ui.styles::*
		std.units::Pixels
	)

	// A due date between the start of 2026 and the end of 2027.
	component DueDate {
		type {
			@bindable
			due ?Date = none

			told string[]

			def changed(d ?Date) {
				told.push(d is none ?? ("none", d.str()))
			}
		}

		view {
			DateField(due, onChange = changed, min = new Date(2026, 1, 1), max = new Date(2027, 12, 31), ref = field)
		}

		style StageStyle
	}

	internal def sameDay(a ?Date, b Date) bool {
		return !(a is none) && a.equals(b)
	}

	check "DateField" {
		// The field reads and writes the region's short form, a four-digit year wherever
		// it stands, keeps a date inside its limits and clears on empty text.
		@test()
		def TestDateFieldReadsTheRegionsForm() !none {
			try I18n.setRegion("en-US", I18nScope.Task)
			let page = DueDate()
			let scene = new Scene(page)
			let size = new Size<Pixels>(300(px), 200(px))
			scene.arrange(size)
			scene.arrange(size)
			let field = page.field
			assert !(field is none)
			return none when field is none
			assert field.shown() == ""
			field.typed("11/30/2026")
			assert sameDay(page.due, new Date(2026, 11, 30))
			field.typed("2026-12-05")
			assert sameDay(page.due, new Date(2026, 12, 5))
			// Text that is no date changes nothing; Enter shows the date as it is.
			field.typed("13/40/2026")
			assert sameDay(page.due, new Date(2026, 12, 5))
			field.settle()
			assert field.text == "12/5/26"
			// A date before the limit waits for Enter, which brings it inside.
			field.typed("1/1/2020")
			assert sameDay(page.due, new Date(2026, 12, 5))
			field.settle()
			assert sameDay(page.due, new Date(2026, 1, 1)) && field.text == "1/1/26"
			field.typed("")
			assert page.due is none
			assert page.told.join(",") == "2026-11-30,2026-12-05,2026-01-01,none"
			// The caller's date shows in the region's form.
			page.due = new Date(2026, 3, 4)
			scene.arrange(size)
			assert field.shown() == "3/4/26"
			// Another region: day first, and two-digit years counted from 1950.
			try I18n.setRegion("de-DE", I18nScope.Task)
			field.typed("30.11.2026")
			assert sameDay(page.due, new Date(2026, 11, 30))
			field.typed("5.12.26")
			assert sameDay(page.due, new Date(2026, 12, 5))
			field.settle()
			assert field.text == "05.12.26"
			scene.close()
			return none
		}

		// The calendar opens under the field, shows the date's month in the region's
		// words and week order, picks with the pointer and the keys, and closes on a pick.
		@test()
		def TestDateFieldPicksFromTheCalendar() !none {
			try I18n.setRegion("en-US", I18nScope.Task)
			let page = DueDate()
			page.due = new Date(2026, 11, 10)
			let scene = new Scene(page)
			let size = new Size<Pixels>(400(px), 400(px))
			scene.arrange(size)
			scene.arrange(size)
			let field = page.field
			return none when field is none
			field.flip()
			scene.arrange(size)
			scene.arrange(size)
			assert field.opened
			let calendar = field.calendar
			assert !(calendar is none)
			return none when calendar is none
			let grid = calendar.grid
			assert !(grid is none)
			return none when grid is none
			assert calendar.title() == "November 2026"
			assert grid.names.join("") == "SMTWTFS" && grid.start == 0
			// November 2026 starts on a Sunday: the first cell is the 1st.
			assert grid.dateAt(0).equals(new Date(2026, 11, 1)) && grid.indexOf(new Date(2026, 11, 30)) == 29
			// A press on the 15th picks it and closes the calendar.
			let frame = grid.style.geom.frame
			let side = grid.cell()
			let i = grid.indexOf(new Date(2026, 11, 15))
			let at = new Point<Pixels>((float(frame.left) + float(i % 7) * side + side / 2.0) * 1(px), (float(frame.top) + grid.headHeight() + float(i / 7) * side + side / 2.0) * 1(px))
			scene.pointer(PointerPhase.Down, at)
			scene.pointer(PointerPhase.Up, at)
			scene.arrange(size)
			scene.arrange(size)
			assert sameDay(page.due, new Date(2026, 11, 15)) && !field.opened && field.text == "11/15/26"
			// Opened again with Down: the keys move the day and the month follows; Enter picks.
			let _ = field.key(KeyEvent{target: field, key: Key.Down, down: true})
			scene.arrange(size)
			scene.arrange(size)
			assert field.opened
			let again = field.calendar
			return none when again is none
			let keys = again.grid
			return none when keys is none
			let _ = keys.key(KeyEvent{target: keys, key: Key.End, down: true})
			assert again.cursor.equals(new Date(2026, 11, 30))
			let _ = keys.key(KeyEvent{target: keys, key: Key.Right, down: true})
			assert again.cursor.equals(new Date(2026, 12, 1)) && again.title() == "December 2026"
			let _ = keys.key(KeyEvent{target: keys, key: Key.PageUp, down: true})
			assert again.cursor.equals(new Date(2026, 11, 1)) && again.title() == "November 2026"
			let _ = keys.key(KeyEvent{target: keys, key: Key.Down, down: true})
			let _ = keys.key(KeyEvent{target: keys, key: Key.Enter, down: true})
			scene.arrange(size)
			assert sameDay(page.due, new Date(2026, 11, 8)) && !field.opened
			// Days outside the limits are not picked; the buttons turn the month.
			again.pick(new Date(2025, 12, 31))
			assert sameDay(page.due, new Date(2026, 11, 8))
			again.next()
			assert again.title() == "December 2026"
			again.previous()
			again.previous()
			assert again.title() == "October 2026"
			scene.close()
			return none
		}
	}
}
