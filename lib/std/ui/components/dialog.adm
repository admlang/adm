partial module std.ui.components {
	use (
		std.math.geom::(Axes, Corners, Edges, Rect, Size)
		std.ui::(RenderContext, Theme, UI)
		std.ui.styles::*
		std.units::(Extent, Pixels)
	)

	// The style of a `Dialog` and of a `Toast`: a surface over the page, out of the layout
	// and hidden until it is shown, in the layer its component names.
	style DialogStyle {
		Box
		Layout
		Background
		Typography
		Compositing
		position = Position.Relative
		visible = false
		background = new BackgroundFill(theme.palette.overlay)
		padding = new Edges<Extent>(theme.metrics.unit * 2.0)
		radius = new Corners<Extent>(theme.metrics.radius)
	}

	// The part of a `Dialog` that holds its `footer`: a row as wide as the dialog whose
	// content sits at the end edge.
	internal component DialogFooter {
		view {
			children()
		}

		style {
			RowStyle
			arrange = Arrange.Row
			width   = fill
			align   = Align{horizontal: Alignment.End, vertical: Alignment.Center}
			gap     = new Axes<Extent>(8(px))
		}
	}

	// A panel in the middle of the window, over everything else, that the user answers
	// before going on: `Dialog(open = asking, title = "Rename", onClose = cancel) { ... }`.
	// It is in the Modal layer, so while it is shown the page behind it is dimmed and takes
	// no pointer, and Tab stays inside it; Escape closes it.
	component Dialog {
		type {
			// Whether it is shown.
			@input(value = true, bind = true)
			@state
			open bool = false

			// The heading at its top; empty: none.
			@input
			title string = ""

			// Runs when it closes itself: on Escape.
			@input
			onClose ?(def()) = none

			// Tells every listener it closed itself, after the handler ran: heard with
			// `@on(Dialog.closed)`.
			@emit()
			def closed() bool {
				return true
			}

			// What goes along its bottom, at the end of the line: its buttons.
			// `footer = view { Button("Cancel"); Button("Save") }` in its block.
			@input
			footer ?view = none

			look   Theme = UI.theme()
			// What it was last placed for: the window and its own size. `placedWide` below 0: not placed since it opened.
			placedWindow Size<Pixels> = new Size<Pixels>(0(px), 0(px))
			placedWide float = -1.0
			placedHigh float

			def floating() bool {
				return open
			}

			// It hangs beside nothing: it is placed in the window.
			def floatTarget() ?component {
				return none
			}

			// Hides itself.
			def dismiss() {
				return when !open
				open = false
				let run = onClose
				run() unless run is none
				closed()
			}

			// Centres itself in the window. Its anchors are set again only when the window or
			// its own size changed.
			def place(window Size<Pixels>) {
				style.visible = open
				if !open {
					placedWide = -1.0
					return
				}
				let own = style.geom.frame
				let (wide, high) = (float(own.width), float(own.height))
				let (windowWide, windowHigh) = (float(window.width), float(window.height))
				return when placedWide == wide && placedHigh == high && placedWindow.width == window.width && placedWindow.height == window.height
				placedWide   = wide
				placedHigh   = high
				placedWindow = window
				let me component = self
				let root = windowRoot(me)
				let left = new AnchorLine(root, AnchorEdge.Left)
				let across Extent = ((windowWide - wide) / 2.0).max(0.0) * 1(px)
				left.offset = across
				let above = new AnchorLine(root, AnchorEdge.Top)
				let down Extent = ((windowHigh - high) / 2.0).max(0.0) * 1(px)
				above.offset = down
				style.anchors = Anchors{left: left, top: above}
			}

			def render(ctx RenderContext) {
				let frame = ctx.geometry.frame
				let (wide, high) = (float(frame.width), float(frame.height))
				ctx.outerShadows()
				ctx.background()
				ctx.borders()
				drawEdge(ctx, look, Rect{left: 0.0, top: 0.0, right: wide, bottom: high}, float(look.metrics.radius) * 2.0, false)
				ctx.childNodes()
				ctx.innerShadows()
			}
		}

		view {
			if title != "" {
				Heading(text = title, level = 5)
			}
			children()
			if !(footer is none) {
				DialogFooter() {
					footer()
				}
			}
		}

		style {
			DialogStyle
			layer    = Layer.Modal
			minWidth = 240(px)
			padding  = new Edges<Extent>(theme.metrics.unit * 4.0)
			gap      = new Axes<Extent>(theme.metrics.unit * 2.0)
			radius   = new Corners<Extent>(theme.metrics.radius * 2.0)
		}
	}
}
