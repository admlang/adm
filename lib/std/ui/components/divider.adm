partial module std.ui.components {
	use (
		std.ui::(RenderContext, Theme, UI)
		std.ui.styles::*
	)

	// A thin line between two parts: `Divider()` lies across a column,
	// `Divider(vertical = true)` stands between the parts of a row.
	component Divider {
		type {
			// Stands upright, for a row.
			@input
			vertical bool = false

			look Theme = UI.theme()

			def render(ctx RenderContext) {
				ctx.draw.fill(frameBox(ctx), look.palette.divider)
			}
		}

		view {}

		// As long as its container allows one way, as thin as the theme's border the other.
		style {
			BoxStyle
			width  = self.vertical ?? (theme.metrics.borderWidth, fill)
			height = self.vertical ?? (fill, theme.metrics.borderWidth)
		}
	}

	// Empty room that takes what is left over: `Row() { Text("Title"); Spacer(); Button("Close") }`
	// pushes the button to the end.
	component Spacer {
		view {}

		style {
			BoxStyle
			width  = fill
			height = fill
		}
	}
}
