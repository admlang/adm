partial module std.ui.components {
	use (
		std.math.geom::(Point, Size)
		std.ui::DragData
		std.ui.styles::*
		std.units::Pixels
	)

	// How far right of the pointer and under it a drag's preview starts, in logical
	// pixels: the pointer does not cover it.
	const previewAway = 12.0

	// The style of what shows a `Draggable`'s preview.
	style DragPreviewStyle {
		Box
		Interaction
		position = Position.Relative
		layer = Layer.Drag
		hitTest = HitTest.None
	}

	// What follows the pointer while a `Draggable` is dragged: it holds the preview, in
	// the Drag layer, and lets the pointer through to what is under it.
	internal component DragPreview {
		type {
			// Where the pointer is, in the window.
			@input
			at Point<Pixels> = new Point<Pixels>(0(px), 0(px))

			// At the pointer, a little away from it, inside the window.
			def place(window Size<Pixels>) {
				let me component = self
				let beside = new Point<Pixels>(at.x + previewAway * 1(px), at.y + previewAway * 1(px))
				style.anchors = pointAnchors(windowRoot(me), beside, style.geom.frame, window)
			}
		}

		view {
			children()
		}

		style DragPreviewStyle
	}

	// Makes what is inside it something the user drags onto a `DropTarget` of the same
	// window: `Draggable(data = DragData{item: file}) { preview = view { Chip(file.name) }; FileRow(file) }`.
	// A press on what it holds that moves a few pixels away starts the drag, unless a
	// component in it took the move for itself (the thumb of a slider, a selection in a
	// field); a button in it is still clicked by a press that stays in place. While it is
	// dragged it and what it holds have the `dragging` state, `preview` follows the
	// pointer, the `DropTarget` under the pointer that takes `data` has `dropTarget` and
	// the pointer shows what that one's `onOver` says. Letting go drops; Escape calls the
	// drag off. It has no box of its own: what it holds is laid out as if it were not
	// there. It cannot be dragged to another application or another window.
	@scoped
	component Draggable {
		type {
			// What it carries.
			@input
			data DragData = DragData{}

			// What follows the pointer while it is dragged; none: nothing does.
			@input
			preview ?view = none

			// Runs when a drag of it begins.
			@input
			onStart ?(def()) = none

			// Runs when a drag of it is over: true when a `DropTarget` took what it
			// carries, false when it was let go of elsewhere or called off.
			@input
			onEnd ?(def(bool)) = none

			// Tells every listener a drag of it began, after the handler ran: heard with
			// `@on(Draggable.started)`.
			@emit()
			def started() DragData {
				return data
			}

			// Tells every listener a drag of it is over and whether it was dropped on
			// something that took it, after the handler ran: heard with
			// `@on(Draggable.ended)`.
			@emit()
			def ended(dropped bool) bool {
				return dropped
			}

			// Where the pointer is while it is dragged, in the window.
			at Point<Pixels> = new Point<Pixels>(0(px), 0(px))

			def drags() bool {
				return !disabled
			}

			def dragData() DragData {
				return data
			}

			def dragMoved(to Point<Pixels>) {
				at = to
			}

			def dragBegan() {
				let run = onStart
				run() unless run is none
				started()
			}

			def dragEnded(dropped bool) {
				let run = onEnd
				run(dropped) unless run is none
				ended(dropped)
			}
		}

		view {
			children()
			if dragging && !(preview is none) {
				DragPreview(at = at) {
					preview()
				}
			}
		}
	}
}
