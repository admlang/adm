partial module std.ui.components {
	use (
		std.math.geom::(Axes, Corners, Edges, Rect, Size)
		std.ui::(RenderContext, themeOf)
		std.ui.styles::*
		std.units::(Extent, Percent, Pixels)
	)

	// How far a `Drawer` reaches in from the start or the end edge when it is not told.
	internal const drawerWide = 320.0

	// A panel that comes in from an edge of the window, over the page:
	// `Drawer(open = navigating, side = Side.Start, onClose = done) { ... }`. From the
	// start or the end edge it is as high as the window; from the top (`Side.Above`) or
	// the bottom (`Side.Below`, a sheet) it is as wide.
	//
	// It is in the Modal layer, so while it is shown the page behind it is dimmed and
	// takes no pointer, and Tab stays inside it; Escape and a press beside it close it.
	// With `modal = false` the page stays as it is, and a press on it closes the drawer.
	component Drawer {
		type {
			// Whether it is shown.
			@input(value = true, bind = true)
			@state
			open bool = false

			// The edge it comes from.
			@input
			side Side = Side.Start

			// How far it reaches into the window; none: 320 pixels from the start or the
			// end, as far as what it holds needs from the top or the bottom.
			@input
			extent ?Extent = none

			// The heading at its top; empty: none.
			@input
			title string = ""

			// Whether the page behind it is dimmed and takes no pointer while it shows.
			@input
			modal bool = true

			// Runs when it closes itself: on Escape or a press beside it.
			@input
			onClose ?(def()) = none

			// Tells every listener it closed itself, after the handler ran: heard with
			// `@on(Drawer.closed)`.
			@emit()
			def closed() bool {
				return true
			}

			// What it was last placed for: the window, the edge and `extent`, as text;
			// empty: not placed since it opened.
			placedAs string = ""

			def floating() bool {
				return open
			}

			// It hangs beside nothing: it is placed in the window.
			def floatTarget() ?component {
				return none
			}

			// Hides itself.
			def dismiss() {
				return when !open
				open = false
				let run = onClose
				run() unless run is none
				closed()
			}

			// While it is modal a press on the page behind it closes it (the runtime's
			// `PressedAway`); when it is not, the runtime dismisses it as any floating.
			def goesWhenPressedAway() bool {
				return open
			}

			// Whether it stands along the start or the end edge.
			def upright() bool {
				return side == Side.Start || side == Side.End
			}

			// Where it is when it is out of the window past its edge: its own size away,
			// which is where it comes in from and goes out to.
			def away() Offset {
				match side {
					case Side.Above:
						return Offset{y: -100(%)}
					case Side.Below:
						return Offset{y: 100(%)}
					default:
						let atLeft = (side == Side.Start) != (style.geom.direction == Direction.RightToLeft)
						return atLeft ?? (Offset{x: -100(%)}, Offset{x: 100(%)})
				}
			}

			// Puts itself along its edge of the window. Its size and anchors are set again
			// only when the window, the edge or `extent` changed.
			def place(window Size<Pixels>) {
				style.visible = open
				if !open {
					placedAs = ""
					return
				}
				let given = extent
				let reach = given is none ?? ("", "{given}")
				let now = "{side} {reach} {window.width} {window.height} {style.geom.direction}"
				return when now == placedAs
				placedAs = now
				let me component = self
				let root = windowRoot(me)
				if upright() {
					let across Sizing = drawerWide * 1(px)
					across = given unless given is none
					style.width = across
					style.height = window.height
				} else {
					let down Sizing = auto
					down = given unless given is none
					style.width = window.width
					style.height = down
				}
				let top = new AnchorLine(root, AnchorEdge.Top)
				let left = new AnchorLine(root, AnchorEdge.Left)
				let atLeft = (side == Side.Start) != (style.geom.direction == Direction.RightToLeft)
				match side {
					case Side.Above:
						style.anchors = Anchors{left: left, top: top}
					case Side.Below:
						style.anchors = Anchors{left: left, bottom: new AnchorLine(root, AnchorEdge.Bottom)}
					default:
						if atLeft {
							style.anchors = Anchors{left: left, top: top}
						} else {
							style.anchors = Anchors{right: new AnchorLine(root, AnchorEdge.Right), top: top}
						}
				}
			}

			def render(ctx RenderContext) {
				let frame = ctx.geometry.frame
				ctx.outerShadows()
				ctx.background()
				ctx.borders()
				drawEdge(ctx, themeOf(self), Rect{left: 0.0, top: 0.0, right: float(frame.width), bottom: float(frame.height)}, 0.0, false)
				ctx.childNodes()
				ctx.innerShadows()
			}
		}

		view {
			if title != "" {
				Heading(text = title, level = 5)
			}
			children()
		}

		style {
			DialogStyle
			layer   = self.modal ?? (Layer.Modal, Layer.Popup)
			padding = new Edges<Extent>(theme.metrics.unit * 4.0)
			gap     = new Axes<Extent>(theme.metrics.unit * 2.0)
			// It lies against the edge of the window.
			radius     = new Corners<Extent>(0(px))
			transition = Transition{duration: theme.motion.slow, easing: theme.motion.enter}
			enter      = {transform: {translate: self.away()}}
			exit       = {transform: {translate: self.away()}}
		}
	}
}
