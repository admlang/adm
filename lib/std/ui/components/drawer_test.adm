partial module std.ui.components {
	use (
		std.math.geom::(Point, Size)
		std.testing
		std.ui::(Key, KeyEvent, PointerPhase)
		std.ui.runtime::Scene
		std.ui.styles::*
		std.units::(Extent, Pixels)
	)

	internal let drawerLog = string[]

	// A page 400 by 300 with a button and a drawer whose edge, reach and kind the test sets.
	component DrawerPage {
		type {
			@bindable
			shown bool = false

			edge   Side = Side.Start
			reach  ?Extent = none
			blocks bool = true

			def new() {
				style.width = 400(px)
				style.height = 300(px)
			}

			def left() {
				drawerLog.push("closed")
			}

			def pressed() {
				drawerLog.push("page")
			}
		}

		view {
			Button(label = "Page", onClick = pressed, ref = behind)
			Drawer(open = shown, side = edge, extent = reach, modal = blocks, title = "Places", onClose = left, ref = drawer) {
				Text("Home")
			}
		}

		style StageStyle
	}

	check "Drawer" {
		def boxOf(c component) (float, float, float, float) {
			let box = c.style.geom.frame
			return (float(box.left), float(box.top), float(box.width), float(box.height))
		}

		def isSeen(c component) bool {
			return float(c.style.geom.frame.width) > 0.0
		}

		// A drawer lies along its edge of the window: as high as the window from the
		// start or the end, as wide from the top or the bottom.
		@test()
		def TestDrawerLiesAlongItsEdge() {
			let page = DrawerPage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(400(px), 300(px))
			let frames = def () {
				scene.arrange(size)
				scene.arrange(size)
				scene.arrange(size)
			}
			frames()
			let drawer = page.drawer
			assert !(drawer is none)
			return when drawer is none
			assert !isSeen(drawer)

			page.shown = true
			frames()
			let (left, top, wide, high) = boxOf(drawer)
			assert isSeen(drawer) && left == 0.0 && top == 0.0 && wide == 320.0 && high == 300.0
			assert drawer.children.len() == 2 && drawer.children[0] is Heading

			page.edge = Side.End
			page.reach = 100(px)
			page.rerun()
			frames()
			(left, top, wide, high) = boxOf(drawer)
			assert left == 300.0 && top == 0.0 && wide == 100.0 && high == 300.0

			page.edge = Side.Below
			page.rerun()
			frames()
			(left, top, wide, high) = boxOf(drawer)
			assert left == 0.0 && top == 200.0 && wide == 400.0 && high == 100.0

			// From the top, as high as what it holds.
			page.edge = Side.Above
			page.reach = none
			page.rerun()
			frames()
			(left, top, wide, high) = boxOf(drawer)
			assert left == 0.0 && top == 0.0 && wide == 400.0 && high > 0.0 && high < 300.0
			scene.close()
		}

		// While it shows the page behind takes no press; Escape and a press beside it
		// close it and tell the caller.
		@test()
		def TestDrawerClosesOnEscapeAndAPressBeside() {
			drawerLog.len(0)
			let page = DrawerPage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(400(px), 300(px))
			let frames = def () {
				nextFrame(scene, size)
				nextFrame(scene, size)
				nextFrame(scene, size)
			}
			page.shown = true
			frames()
			let drawer = page.drawer
			return when drawer is none
			assert isSeen(drawer)

			let whole component = page
			scene.key(KeyEvent{target: whole, key: Key.Escape})
			frames()
			assert !page.shown && !isSeen(drawer) && drawerLog.join(",") == "closed"

			page.shown = true
			frames()
			// A press on the drawer leaves it; one beside it closes it and is not the page's.
			scene.pointer(PointerPhase.Down, new Point<Pixels>(100(px), 200(px)))
			scene.pointer(PointerPhase.Up, new Point<Pixels>(100(px), 200(px)))
			frames()
			assert page.shown
			scene.pointer(PointerPhase.Down, new Point<Pixels>(380(px), 10(px)))
			scene.pointer(PointerPhase.Up, new Point<Pixels>(380(px), 10(px)))
			frames()
			assert !page.shown && drawerLog.join(",") == "closed,closed"
			scene.close()
		}
	}
}
