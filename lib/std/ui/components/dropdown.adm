partial module std.ui.components {
	use std.ui.styles::*

	// The style of a `Dropdown`: its box.
	style DropdownStyle {
		Box
		Layout
	}

	// One choice out of a list that opens under a button:
	// `Dropdown(options = ["Small", "Medium", "Large"], selected = size, onChange = setSize)`.
	// The button shows the selected option; a click opens the list, a pick closes it. The
	// options may be any values, shown by `text`: `Dropdown(options = countries, text =
	// (c Country) => c.name)`.
	component Dropdown<T = string> {
		type {
			// The choices, in order.
			@input(value = true)
			options T[] = []

			// How an option reads on the button and in the list; none: as it prints.
			@input
			text ?(def(T) string) = none

			// What a line of the list shows in place of the option's text, and the
			// button for the selected one: `Dropdown(countries) { rowRenderer =
			// (it RowItem<Country>) => view { Flag(it.content.code); Text(it.content.name) } }`.
			@input
			rowRenderer ?(def(RowItem<T>) view) = none

			// The index of the selected one; outside the list: none is.
			@input(bind = true)
			@state
			selected int = -1

			// What the button shows while nothing is selected.
			@input
			placeholder string = "Choose"

			// Runs with the new index when the user picks another option.
			@input
			onChange ?(def(int)) = none

			// Tells every listener which one is current now, after the handler ran: heard with
			// `@on(Dropdown.changed)`.
			@emit()
			def changed(index int) int {
				return index
			}

			// Whether the list is shown.
			@bindable
			opened bool

			// What the button shows.
			def shown() string {
				return placeholder when selected < 0 || selected >= options.len()
				return textOf(options[selected])
			}

			// How `option` reads.
			def textOf(option T) string {
				let read = text
				return read(option) unless read is none
				return "{option}"
			}

			// The option selected; none when none is.
			def current() ?T {
				return none when selected < 0 || selected >= options.len()
				return options[selected]
			}

			def flip() {
				opened = !opened when !disabled
			}

			// Selects the option as a click on its line does.
			def pick(index int) {
				opened = false
				return when index == selected || index < 0 || index >= options.len()
				selected = index
				let tell = onChange
				tell(index) unless tell is none
				changed(index)
			}
		}

		view {
			let make = rowRenderer
			let chosen = current()
			if make is none || chosen is none {
				Button(label = shown(), trailing = "chevron-down", onClick = flip, enabled = !disabled)
			} else {
				Button(trailing = "chevron-down", onClick = flip, enabled = !disabled) {
					start = make(RowItem<T>{content: chosen, index: selected, selected: true})
				}
			}
			Menu(open = opened) {
				for let (i, option) in options {
					if make is none {
						MenuItem(label = textOf(option), checked = i == selected, key = i, onActivate = def () {
							pick(i)
						})
					} else {
						MenuItem(checked = i == selected, key = i, onActivate = def () {
							pick(i)
						}) {
							start = make(RowItem<T>{content: option, index: i, selected: i == selected})
						}
					}
				}
				// Lines the caller adds after the options: `Dropdown(options = sizes) {
				// MenuItem("Custom…", onActivate = askSize) }`.
				children()
			}
		}

		style DropdownStyle
	}
}
