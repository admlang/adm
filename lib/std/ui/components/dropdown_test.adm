partial module std.ui.components {
	use (
		std.math.geom::Size
		std.testing
		std.ui.runtime::Scene
		std.ui.styles::*
		std.units::Pixels
	)

	internal let pickLog = string[]

	internal struct Country {
		code string
		name string
	}

	// A dropdown over countries, shown by name.
	component CountryPick {
		type {
			@bindable
			chosen int = -1

			countries Country[] = [Country{code: "ro", name: "Romania"}, Country{code: "no", name: "Norway"}]

			@on(Dropdown.changed)
			def heard(evt ComponentEvent<int>) {
				pickLog.push("changed {evt.result}")
			}
		}

		view {
			Dropdown(options = countries, text = (c Country) => c.name, selected = chosen, ref = pick)
		}

		style StageStyle
	}

	// A combo box over countries, matched and filled by name.
	component CountryField {
		type {
			@bindable
			typed string = ""

			picked int = -1

			countries Country[] = [Country{code: "ro", name: "Romania"}, Country{code: "no", name: "Norway"}]

			def chose(index int) {
				picked = index
			}
		}

		view {
			ComboBox(value = typed, options = countries, text = (c Country) => c.name, onSelect = chose, ref = field)
		}

		style StageStyle
	}

	// A dropdown with a line of the caller's after its options, and a search field with
	// a button after it.
	component ExtraLines {
		type {
			extra int = 0

			def more() {
				extra += 1
			}
		}

		view {
			Dropdown(options = ["a", "b"], ref = pick) {
				MenuItem("More…", onActivate = more, ref = moreLine)
			}
			SearchField(ref = search) {
				Button(icon = "filter", ref = filter)
			}
		}

		style StageStyle
	}

	check "Dropdown" {
		// What the caller's block gives a dropdown follows its options in the list; what
		// it gives a search field follows the field.
		@test()
		def TestCallerContent() {
			let page = ExtraLines()
			let scene = new Scene(page)
			let size = new Size<Pixels>(300(px), 300(px))
			scene.arrange(size)
			let pick = page.pick
			let line = page.moreLine
			let search = page.search
			let filter = page.filter
			assert !(pick is none) && !(line is none) && !(search is none) && !(filter is none)
			if !(line is none) {
				line.pick()
				assert page.extra == 1
			}
			if !(search is none) && !(filter is none) {
				let parts = search.childNodes
				let held component = filter
				assert parts.len() == 2 && parts[1] == held
				assert float(filter.style.geom.frame.left) > float(parts[0].style.geom.frame.left)
			}
		}

		// Options that are values match the typed text by `text`, and a pick puts that
		// text in the field.
		@test()
		def TestComboBoxOverValues() {
			let page = CountryField()
			let scene = new Scene(page)
			scene.arrange(new Size<Pixels>(300(px), 200(px)))
			let field = page.field
			assert !(field is none)
			if !(field is none) {
				field.typed("nor")
				assert field.matches().len() == 1 && field.matches()[0] == 1
				field.choose(1)
				scene.arrange(new Size<Pixels>(300(px), 200(px)))
				assert page.typed == "Norway" && page.picked == 1
			}
		}

		// Options that are values read through `text`; a pick selects by index and tells
		// `@on(Dropdown.changed)`.
		@test()
		def TestOptionsAreValues() {
			pickLog = string[]
			let page = CountryPick()
			let scene = new Scene(page)
			scene.arrange(new Size<Pixels>(300(px), 200(px)))
			let pick = page.pick
			assert !(pick is none)
			if !(pick is none) {
				assert pick.shown() == "Choose"
				pick.pick(1)
				scene.arrange(new Size<Pixels>(300(px), 200(px)))
				assert pick.shown() == "Norway" && page.chosen == 1
				let now = pick.current()
				assert !(now is none) && now.code == "no" unless now is none
				assert pickLog.join(",") == "changed 1"
			}
		}
	}
}
