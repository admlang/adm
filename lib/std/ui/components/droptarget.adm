partial module std.ui.components {
	use (
		std.math.geom::Point
		std.ui::(DragData, DropEffect)
		std.units::Pixels
	)

	// Makes what is inside it a place to drop things on: what a `Draggable` carries, and
	// files or text dragged in from another application.
	// `DropTarget(onDrop = open) { Panel() { Text("Drop a file here") } }`.
	// It has no box of its own: what it holds is laid out as if it were not there, and
	// has the `dropTarget` state, as it has, while something is dragged over it.
	@scoped
	component DropTarget {
		type {
			// Says whether it takes what was dropped; none: it takes everything. One
			// that refuses leaves the drop to a `DropTarget` around it.
			@input
			accepts ?(def(DragData) bool) = none

			// Says what a drop at that point of the window would do, while a `Draggable`
			// is dragged over it: the pointer shows it. None refuses the drop there, as
			// `accepts` does; unset: Move. It is not asked while something from another
			// application is dragged over it (what that is, is known only once dropped),
			// only when it is dropped.
			@input
			onOver ?(def(DragData, Point<Pixels>) DropEffect) = none

			// Runs with what was dropped and the point of the window it was dropped at.
			@input
			onDrop ?(def(DragData, Point<Pixels>)) = none

			// Tells every listener what was dropped on it, after the handler ran: heard
			// with `@on(DropTarget.dropped)`.
			@emit()
			def dropped(data DragData) DragData {
				return data
			}

			def takes(data DragData) bool {
				return false when disabled
				let ask = accepts
				return true when ask is none
				return ask(data)
			}

			def dropEffect(data DragData, at Point<Pixels>) DropEffect {
				let ask = onOver
				return DropEffect.Move when ask is none
				return ask(data, at)
			}

			def dropOn(data DragData, at Point<Pixels>) {
				let run = onDrop
				run(data, at) unless run is none
				dropped(data)
			}
		}

		view {
			children()
		}
	}
}
