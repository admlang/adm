partial module std.ui.components {
	use (
		std.services.clipboard::Clipboard
		std.time
		std.ui::(Key, KeyEvent, typesCharacter)
		std.ui.paint
		std.ui.runtime::wakeBy
	)

	// What a key meant to a text being edited.
	internal enum KeyTaken {
		// Not the text's key.
		No,
		// The text's, and it changed nothing.
		Yes,
		// The text's: the text, the caret or the selection changed.
		Changed,
	}

	// Copies the selection to the clipboard. False when nothing is selected, the text is
	// `secret`, or the clipboard cannot be written.
	internal def editCopy(edit paint.TextEdit, secret bool) bool {
		return false when secret || !edit.hasSelection()
		let copied = true
		Clipboard.copy(edit.selected()) onerror (err error) {
			copied = false
			recover none
		}
		return copied
	}

	// Copies the selection and removes it. True when the text changed.
	internal def editCut(edit paint.TextEdit, secret bool) bool {
		return false unless editCopy(edit, secret)
		return edit.erase(false)
	}

	// Puts the clipboard's text in place of the selection, or at the caret; in a `oneLine`
	// text its line breaks become spaces. True when the text changed.
	internal def editPaste(edit paint.TextEdit, oneLine bool) bool {
		let pasted = Clipboard.paste() onerror recover ""
		pasted = pasted.replace("\r\n", "\n").replace("\r", "\n")
		pasted = pasted.replace("\n", " ") when oneLine
		return false when pasted.len() == 0
		edit.insert(pasted)
		return true
	}

	// Takes a key no editing key matched: a key that types is the text's (its character
	// arrives as committed text), and Control or Command with A, C, X and V select all,
	// copy, cut and paste, with Z undo (redo with Shift) and with Y redo. A `secret` text is not copied
	// or cut; in a `oneLine` text the line breaks of what is pasted become spaces. A
	// clipboard that cannot be read or written leaves the text as it is.
	internal def editShortcut(edit paint.TextEdit, e KeyEvent, secret bool, oneLine bool) KeyTaken {
		// Control with Alt is how some layouts type a character (AltGr): no shortcut.
		return typesCharacter(e.key) ?? (KeyTaken.Yes, KeyTaken.No) when !e.modifiers.mod || e.modifiers.alt
		switch e.key {
			case Key.Z:
				// Undo; with Shift, redo.
				let done = e.modifiers.shift ?? (edit.redo(), edit.undo())
				return done ?? (KeyTaken.Changed, KeyTaken.Yes)
			case Key.Y:
				return edit.redo() ?? (KeyTaken.Changed, KeyTaken.Yes)
			case Key.A:
				edit.selectAll()
			case Key.C:
				let _ = editCopy(edit, secret)
				// A copy changed nothing in the text.
				return KeyTaken.Yes
			case Key.X:
				return KeyTaken.Yes unless editCut(edit, secret)
			case Key.V:
				return KeyTaken.Yes unless editPaste(edit, oneLine)
			default:
				return KeyTaken.No
		}
		return KeyTaken.Changed
	}

	// Whether a caret that was last moved at `moved` and is shown, then hidden, for
	// `period` each is in the shown half at `now`: always for one period after it moved,
	// and when it does not blink (0s).
	internal def caretShows(period duration, moved time.Time, now time.Time) bool {
		return true when period <= 0s
		let since = now - moved
		return true when since < period
		return int(float(since) / float(period)) % 2 == 0
	}

	// Asks for the frame of such a caret's next blink, which nothing else asks for.
	internal def caretWakes(period duration, moved time.Time, now time.Time) {
		return when period <= 0s
		wakeBy(moved + period * (float(now - moved) / float(period)).floor() + period)
	}
}
