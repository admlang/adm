partial module std.ui.components {
	use (
		std.math.geom::Point
		std.units::Pixels
	)

	// The menu of a field that edits text: cut, copy, paste and select all, each run by
	// the field. `TextField` and `TextArea` place one the first time it is asked for.
	@scoped
	internal component FieldMenu {
		type {
			// Whether there is something to cut or copy.
			@input
			marked bool = false

			@input
			onCut ?(def()) = none

			@input
			onCopy ?(def()) = none

			@input
			onPaste ?(def()) = none

			@input
			onSelectAll ?(def()) = none

			// Opens it at `at`, a point of the window.
			def context(at Point<Pixels>) {
				let built = lines
				built.context(at) unless built is none
			}
		}

		view {
			ContextMenu(ref = lines) {
				MenuItem("Cut", shortcut = "Ctrl+X", enabled = marked, onActivate = onCut)
				MenuItem("Copy", shortcut = "Ctrl+C", enabled = marked, onActivate = onCopy)
				MenuItem("Paste", shortcut = "Ctrl+V", onActivate = onPaste)
				MenuSeparator()
				MenuItem("Select all", shortcut = "Ctrl+A", onActivate = onSelectAll)
			}
		}
	}
}
