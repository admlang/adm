partial module std.ui.components {
	// Remembers which of the components it holds had the keyboard focus last, and gives
	// it back to that one when Tab comes into it again from outside: a tool window, a
	// side panel. `FocusScope(trap = true) { ... }` also keeps Tab among what it holds,
	// going round at its ends, while the focus is inside. It has no box of its own: what
	// it holds is laid out as if it were not there.
	@scoped
	component FocusScope {
		type {
			// Keeps Tab among what it holds while the focus is inside.
			@input
			trap bool = false

			// What it holds that had the focus last; none once that one is gone.
			weak last ?component = none

			def keepFocus(inside component) {
				last = inside
			}

			def keptFocus() ?component {
				return last
			}

			def trapsFocus() bool {
				return trap && !disabled
			}
		}

		view {
			children()
		}
	}
}
