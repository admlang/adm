partial module std.ui.components {
	use (
		std.math.geom::Axes
		std.ui::(Theme, themeOf)
		std.ui.styles::*
		std.units::Extent
	)

	// The style of a `Form` and of a `Field`: a box that stacks what it holds.
	style FormStyle {
		Box
		Layout
	}

	// A set of fields sent together: `Form(onSubmit = save) { Field("Email", error =
	// emailError()) { TextField(email) } }`. What is wrong with a value is the caller's
	// to say (a method the view calls for each field's `error`); the form runs `onSubmit`
	// only while no `Field` under it has an error. Enter in a `TextField` under it
	// submits, and so does `submit()`, for a button: `Button("Save", onClick = form.submit)`
	// with `ref = form` on the form. The components under it find it with
	// `context<Form>()`.
	component Form {
		type {
			// Runs when the form is submitted and no field has an error.
			@input
			onSubmit ?(def()) = none

			// The space between the fields.
			@input
			gap Extent = 12(px)

			// Emitted when the form was submitted with no field in error, after
			// `onSubmit` ran.
			@emit()
			def submitted() bool {
				return true
			}

			// Whether a `Field` under it has an error.
			def invalid() bool {
				return fieldInError(self)
			}

			// Submits the form: nothing happens while a field has an error.
			def submit() {
				return when invalid()
				let run = onSubmit
				run() unless run is none
				submitted()
			}

			// Makes it the `Form` of what it holds.
			def share() {
				provide<Form>(self)
			}

			// Enter in a text field of this form.
			@on(TextField.submitted)
			def fieldSubmitted(evt ComponentEvent<bool>) {
				let near = evt.source.closest<Form>()
				submit() when !(near is none) && near == self
			}
		}

		view {
			share()
			children()
		}

		style {
			FormStyle
			arrange = Arrange.Column
			gap     = new Axes<Extent>(self.gap)
		}
	}

	// One value of a form with its name and what is wrong with it: `Field("Email", error
	// = emailError()) { TextField(email) }`. The name is a `Label` for the control it
	// holds; the error, when there is one, stands under the control in the theme's
	// danger colour and holds the form's `onSubmit` back.
	component Field {
		type {
			// The name of the value.
			@input(value = true)
			label string = ""

			// What is wrong with the value; empty: nothing.
			@input
			error string = ""

			// The error's colour as a run over its whole text, made again when the
			// text or the theme is another one.
			tint     TextRun[] = []
			tintText string = ""
			tintLook ?Theme = none

			def errorRuns() TextRun[] {
				let look = themeOf(self)
				let seen = tintLook
				if tintText != error || seen is none || seen != look {
					tintText = error
					tintLook = look
					tint     = [TextRun{start: 0, end: error.len(), foreground: look.palette.danger}]
				}
				return tint
			}
		}

		view {
			Label(label)
			children()
			if error != "" {
				Text(error, runs = errorRuns())
			}
		}

		style {
			FormStyle
			arrange = Arrange.Column
			gap     = new Axes<Extent>(4(px))
		}
	}

	// Whether a `Field` under `from` has an error.
	internal def fieldInError(from component) bool {
		for let child in from.childNodes {
			if child is Field {
				return true when child.error != ""
			}
			return true when fieldInError(child)
		}
		return false
	}
}
