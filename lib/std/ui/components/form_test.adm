partial module std.ui.components {
	use (
		std.math.geom::Size
		std.testing
		std.ui::(Key, KeyEvent)
		std.ui.runtime::Scene
		std.ui.styles::*
		std.units::Pixels
	)

	internal let sentLog = string[]

	// A form of two values: what is wrong with each is this page's to say.
	component SignupPage {
		type {
			@bindable
			email string = ""

			@bindable
			name string = "Ada"

			def emailError() string {
				return "Email is required" when email == ""
				return "Not an address" unless email.contains("@")
				return ""
			}

			def sent() {
				sentLog.push("{name} {email}")
			}

			def save() {
				let held = form
				held.submit() unless held is none
			}
		}

		view {
			Form(onSubmit = sent, ref = form) {
				Field("Name") {
					TextField(name, ref = nameField)
				}
				Field("Email", error = emailError(), ref = emailRow) {
					TextField(email, ref = emailField)
				}
				Button("Save", onClick = save)
			}
		}

		style StageStyle
	}

	check "Form" {
		// A field shows its name, its control and what is wrong with its value; the form
		// runs `onSubmit` only while no field has an error, from `submit()` and from Enter
		// in one of its text fields.
		@test()
		def TestFormHoldsBackWhileAFieldIsWrong() {
			sentLog.len(0)
			let page = SignupPage()
			let scene = new Scene(page)
			let size = new Size<Pixels>(400(px), 400(px))
			scene.arrange(size)
			let form = page.form
			let row = page.emailRow
			let field = page.emailField
			assert !(form is none) && !(row is none) && !(field is none)
			return when form is none || row is none || field is none

			// Name, control and error; the error under the control.
			assert row.childNodes.len() == 3
			let shown = row.childNodes[2]
			assert shown is Text && shown.text == "Email is required"
			assert row.childNodes[0] is Label && row.childNodes[1] is TextField
			assert float(shown.style.geom.frame.top) >= float(field.style.geom.frame.bottom)
			assert form.invalid()
			form.submit()
			page.save()
			assert sentLog.len() == 0

			// The components under the form find it.
			let found = field.context<Form>()
			assert !(found is none) && found == form

			// Another thing wrong, then nothing: the error goes, the form submits.
			page.email = "ada"
			scene.arrange(size)
			let still = row.childNodes[2]
			assert still is Text && still.text == "Not an address"
			page.email = "ada@example.org"
			scene.arrange(size)
			assert row.childNodes.len() == 2 && !form.invalid()
			page.save()
			assert sentLog.join("|") == "Ada ada@example.org"

			// Enter in a text field of the form submits it.
			field.focus()
			scene.arrange(size)
			let whole component = page
			scene.key(KeyEvent{target: whole, key: Key.Enter})
			assert sentLog.len() == 2
			page.email = ""
			scene.arrange(size)
			scene.key(KeyEvent{target: whole, key: Key.Enter})
			assert sentLog.len() == 2
		}
	}
}
