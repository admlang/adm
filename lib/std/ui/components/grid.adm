partial module std.ui.components {
	use (
		std.math.geom::Axes
		std.ui::RenderContext
		std.ui.styles::*
		std.units::Extent
	)

	// The style of a `Grid`: its box, how it arranges its children, its columns and rows.
	style GridStyle {
		Box
		Layout
		Tracks
	}

	// Places its children in columns and rows, filling row by row:
	// `Grid(columns = 3, gap = 8(px)) { ... }` makes three equal columns;
	// `Grid(fit = 240(px)) { ... }` as many columns at least that wide as fit. Other
	// tracks are set through its style (`columns`, `rows`).
	component Grid {
		type {
			// How many equal columns; read when `fit` is none.
			@input
			columns int = 2

			// The least width of a column: as many equal columns as fit are made.
			@input
			fit ?Extent = none

			// The space between neighbouring columns and rows.
			@input
			gap Extent = 0(px)

			// The inputs its tracks were last made from.
			made string = ""

			def new() {
				track()
			}

			// Makes the columns again when `columns` or `fit` changed.
			def track() {
				let least = fit
				let now = least is none ?? ("{columns}", "fit {least}")
				return when now == made
				made = now
				if least is none {
					let equal Track[]
					for let i = 0; i < columns.max(1); i++ {
						equal.push(new Track(fill))
					}
					style.columns = equal
				} else {
					style.columns = TrackFit{min: least}
				}
			}

			def render(ctx RenderContext) {
				track()
				ctx.childNodes()
			}
		}

		view {
			children()
		}

		style {
			GridStyle
			arrange = Arrange.Grid
			gap     = new Axes<Extent>(self.gap)
		}
	}
}
