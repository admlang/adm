// An input of optional function type follows what the parent passes on every
// run of its view: a function, then none, then a function again.
partial module std.ui.components {
	use (
		std.math.geom::Size
		std.testing
		std.ui.runtime::Scene
		std.ui.styles::*
		std.units::Pixels
	)

	// Says whether it was given a handler.
	component HandlerHolder {
		type {
			@input
			onPick ?(def(int)) = none
			// How many times the view ran.
			views int = 0

			def said() string {
				views++
				return onPick is none ?? ("child none", "child set")
			}

			def pick(at int) {
				let handler = onPick
				handler(at) unless handler is none
			}
		}

		view {
			Text(said())
		}

		style {
			Box
			Layout
		}
	}

	component HandlerGiver {
		type {
			@state
			given bool = true
			picks int = 0

			def picked(at int) {
				picks += at
			}

			def handler() ?(def(int)) {
				return given ?? (picked, none)
			}


		}

		view {
			HandlerHolder(onPick = handler(), ref = computed)
			HandlerHolder(onPick = picked, ref = named)
			HandlerHolder(onPick = (at int) => picked(at * 10), ref = written)
		}

		style StageStyle
	}

	check "Handler inputs" {
		@test()
		def TestOptionalHandlerComesAndGoes() {
			let page = HandlerGiver()
			let scene = new Scene(page)
			let size = new Size<Pixels>(300(px), 200(px))
			scene.arrange(size)
			scene.arrange(size)
			assert slotTextsUnder(page).join(",") == "child set,child set,child set"
			let computed = page.computed
			let named = page.named
			let written = page.written
			assert !(computed is none) && !(named is none) && !(written is none)
			return when computed is none || named is none || written is none
			// The handler that comes and goes reaches the child each time.
			page.given = false
			scene.arrange(size)
			scene.arrange(size)
			assert slotTextsUnder(page).join(",") == "child none,child set,child set"
			let namedViews = named.views
			page.given = true
			scene.arrange(size)
			scene.arrange(size)
			assert slotTextsUnder(page).join(",") == "child set,child set,child set"
			// A method named is the same function on every run: that child
			// was not given it again, nor drawn again.
			assert named.views == namedViews
			// Each child calls the handler it holds now.
			computed.pick(1)
			named.pick(2)
			written.pick(3)
			assert page.picks == 1 + 2 + 30
			scene.close()
		}
	}
}
