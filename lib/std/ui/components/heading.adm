partial module std.ui.components {
	use (
		std.math.geom::Size
		std.ui::(Limit, RenderContext, Theme, UI)
		std.ui.paint
		std.ui.styles::*
		std.units::Pixels
	)

	// A title over what follows: `Heading(text = "Install", level = 2)`. Level 1 is the
	// largest, 6 the smallest; all are bold.
	component Heading {
		type {
			// What it says.
			@input(value = true)
			text string = ""

			// 1 to 6: how large it is; a level outside that is taken as the nearest of them.
			@input
			level int = 1

			block     ?paint.TextBlock = none
			look      Theme = UI.theme()
			// The level its font was last set for.
			fontLevel int = 0

			def new() {
				size()
			}

			// Sets the font for the level when the level changed: 2, 1.5, 1.25, 1.1, 1 and
			// 0.9 times the text size.
			def size() {
				return when fontLevel == level
				fontLevel = level
				let scale = [2.0, 1.5, 1.25, 1.1, 1.0, 0.9][level.max(1).min(6) - 1]
				style.font = Font{family: "system-ui", weight: FontWeight.Bold, size: 16.0 * scale * 1(px)}
			}

			def current() paint.TextBlock {
				size()
				let made = labelBlock(block, text, style.font, style.foreground, style.paragraph, look.palette.foreground)
				block = made
				return made
			}

			def measure(limit Limit) Size<Pixels> {
				return current().measure(limit)
			}

			def firstBaseline() ?Pixels {
				return baselineOf(current())
			}

			def render(ctx RenderContext) {
				paint.drawBlock(ctx.draw, current(), ctx.geometry.content.toFloat(), Align{}, ctx.direction == Direction.RightToLeft, ctx.scale)
			}
		}

		view {}

		style FigureStyle
	}
}
