partial module std.ui.components {
	use (
		std.math.geom::Size
		std.time
		std.ui::(PointerEvent, PointerPhase, RenderContext, Theme, UI)
		std.ui.runtime::wakeBy
		std.ui.styles::*
		std.units::Pixels
	)

	// Content that shows beside the container it is placed in once the pointer rested
	// there: `Panel() { Text("main.adm"); HoverCard() { Text("Opened yesterday") } }`. Unlike
	// a tooltip the pointer can go into it and use what it holds. It goes a moment after
	// the pointer left both; a press inside pins it, and so does the keyboard focus on
	// something it holds, until Escape or a press elsewhere.
	component HoverCard {
		type {
			// How long the pointer rests on the target before it shows.
			@input
			delay duration = 400ms

			// How long it stays after the pointer left it and its target.
			@input
			linger duration = 200ms

			// The side of the target it opens on when there is room.
			@input
			side Side = Side.Below

			look    Theme = UI.theme()
			// Whether it is shown, and whether a press inside keeps it.
			open    bool
			pinned  bool
			// Whether the pointer is resting on the target and since when; whether it
			// left the target and the card and since when.
			resting bool
			since   time.Time
			away bool
			left    time.Time
			// It was sent away and waits for the pointer to leave the target before it
			// counts a rest again.
			spent   bool
			// How many frames it has been open for, and whether it was open on the frame
			// before.
			frames  int
			settled bool

			// It floats from the frame after it opened: its content is built by then.
			def floating() bool {
				return open && frames > 0
			}

			def floatTarget() ?component {
				return parent()
			}

			// Hides itself.
			def dismiss() {
				return when !open
				open    = false
				pinned  = false
				resting = false
				spent   = true
				redraw()
			}

			// Whether the pointer is over the target, which the card is part of.
			def pointed() bool {
				let target = parent()
				return false when target is none
				return target.isHover && !disabled
			}

			// Follows the pointer: shows after it rested on the target for `delay`, hides
			// a moment after it left, then keeps itself beside the target.
			def place(window Size<Pixels>) {
				let over = pointed()
				let now = time.now()
				if !open {
					if !over {
						resting = false
						spent   = false
					} else if spent {
						resting = false
					} else if !resting {
						resting = true
						since   = now
						wakeBy(now + delay)
					} else if now >= since + delay {
						open = true
						away = false
						// It is measured on this frame and placed on the next.
						redraw()
					} else {
						wakeBy(since + delay)
					}
				} else if !pinned && !focusWithin {
					if over {
						away = false
					} else if !away {
						away = true
						left = now
						wakeBy(now + linger)
					} else if now >= left + linger {
						open    = false
						resting = false
					} else {
						wakeBy(left + linger)
					}
				}
				// The frame it opens on has no content yet: it shows from the next, which
				// measures it, and is placed on the one after.
				if !open {
					frames = 0
				} else {
					redraw() when frames < 2
					frames++ when settled
				}
				settled = open
				style.visible = floating()
				let target = parent()
				return when !floating() || target is none
				style.anchors = besideAnchors(target, style.geom.frame, side, style.geom.direction == Direction.RightToLeft, window, float(look.metrics.unit))
			}

			// A press inside that nothing it holds took pins it, and is not a press on the
			// target under it.
			def pointer(e PointerEvent) bool {
				pinned = true when e.phase == PointerPhase.Down
				return e.phase := PointerPhase.Down || PointerPhase.Up
			}

			def render(ctx RenderContext) {
				drawFloat(ctx, look)
			}
		}

		view {
			// What it holds is there only while it is open: a page of closed cards costs
			// their content nothing.
			if open {
				children()
			}
		}

		style PopoverStyle
	}
}
