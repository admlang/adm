partial module std.ui.components {
	use (
		std.gfx.canvas
		std.gfx.color::Color
		std.math.geom::Edges
		std.ui::(RenderContext, Theme, UI)
		std.ui.runtime::(FoundIcon, drawIcon)
		std.ui.styles::*
	)

	// A small picture by name: `Icon("search")`, from the icon sets the application added
	// (`UI.addIcons`) and std's own. It takes the colour of the text around it unless its
	// set keeps its own colours, and is `iconSize` of the theme on a side unless its style
	// says otherwise. `Icon(picture = drawn)` draws a picture as it is. A name no set holds
	// draws an empty box.
	component Icon {
		type {
			// The icon's name, `set/name` for the one of a set.
			@input(value = true)
			name string = ""

			// A picture to draw in place of a named icon, in its own colours.
			@input
			picture ?canvas.Picture = none

			slot IconSlot = new IconSlot()
			look Theme = UI.theme()

			def render(ctx RenderContext) {
				let box = frameBox(ctx)
				let ink = look.palette.foreground
				let own = style.foreground
				ink = own when own is Color
				let drawn = picture
				if !(drawn is none) {
					drawIcon(ctx.draw, FoundIcon{picture: drawn, tinted: false}, box, ink)
					return
				}
				let found = slot.get(name)
				if found is none {
					let line = canvas.Border{width: look.metrics.borderWidth, paint: look.palette.border}
					ctx.draw.stroke(box, new Edges<canvas.Border>(line))
					return
				}
				drawIcon(ctx.draw, found, box, ink)
			}
		}

		view {}

		style {
			FigureStyle
			width  = theme.metrics.iconSize
			height = theme.metrics.iconSize
		}
	}
}
