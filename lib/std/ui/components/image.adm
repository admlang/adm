partial module std.ui.components {
	use (
		std.formats.image
		std.gfx.canvas::Fit
		std.math.geom::(Rect, Size)
		std.ui::(Limit, RenderContext)
		std.ui.styles::*
		std.units::Pixels
	)

	// A picture: `Image(source = logo)`. It is as large as the picture, a logical pixel
	// to each of its pixels, unless its style gives it a size; `fit` says how the picture
	// fills a box of another shape.
	component Image {
		type {
			// The picture; none draws nothing and takes no room.
			@input(value = true)
			source ?image.Image = none

			// How the picture fills the component's box.
			@input
			fit Fit = Fit.Contain

			// The picture's width and height, 0 without one.
			def natural() (float, float) {
				let picture = source
				return (0.0, 0.0) when picture is none
				let size = picture.size()
				return (float(size.width), float(size.height))
			}

			def measure(limit Limit) Size<Pixels> {
				let (wide, high) = natural()
				return new Size<Pixels>(0(px), 0(px)) when wide <= 0.0 || high <= 0.0
				// Smaller, the ratio kept, when the room is narrower than the picture.
				let room = limit.width
				if !(room is none) && float(room) < wide {
					high = high * float(room) / wide
					wide = float(room)
				}
				return new Size<Pixels>(wide * 1(px), high * 1(px))
			}

			def render(ctx RenderContext) {
				let picture = source
				return when picture is none
				let (wide, high) = natural()
				return when wide <= 0.0 || high <= 0.0
				let box = ctx.geometry.content.toFloat()
				let (roomWide, roomHigh) = (box.right - box.left, box.bottom - box.top)
				return when roomWide <= 0.0 || roomHigh <= 0.0
				let (drawnWide, drawnHigh) = (roomWide, roomHigh)
				match fit {
					case Fit.Contain:
						let by = (roomWide / wide).min(roomHigh / high)
						(drawnWide, drawnHigh) = (wide * by, high * by)
					case Fit.Cover:
						let by = (roomWide / wide).max(roomHigh / high)
						(drawnWide, drawnHigh) = (wide * by, high * by)
					case Fit.None:
						(drawnWide, drawnHigh) = (wide, high)
					default:
				}
				// Centred; what does not fit is cut off at the box.
				let left = box.left + (roomWide - drawnWide) / 2.0
				let top = box.top + (roomHigh - drawnHigh) / 2.0
				let cut = drawnWide > roomWide || drawnHigh > roomHigh
				if cut {
					ctx.draw.save()
					ctx.draw.clip(box)
				}
				ctx.draw.drawImage(picture, Rect{left: left, top: top, right: left + drawnWide, bottom: top + drawnHigh})
				ctx.draw.restore() when cut
			}
		}

		view {}

		style FigureStyle
	}
}
