partial module std.ui.components {
	use (
		std.gfx.color::(Color, RGBA)
		std.math.geom::Size
		std.testing
		std.ui.runtime::(Lettered, Scene)
		std.ui.styles::*
		std.units::*
	)

	let inheritRed = new Color(RGBA{r: 200, g: 0, b: 0, a: 255})
	let inheritGreen = new Color(RGBA{r: 0, g: 200, b: 0, a: 255})
	let inheritBlue = new Color(RGBA{r: 0, g: 0, b: 200, a: 255})
	let inheritBlack = new Color(RGBA{r: 0, g: 0, b: 0, a: 255})

	// Sets nothing of its own: what it reads through `style` is what it inherits.
	component InheritLeaf {
		type {
			def ink() Color {
				return inkOf(style.foreground, inheritBlack)
			}

			def family() string {
				let font = style.font
				return "" when font is none
				return font.family
			}

			def bold() bool {
				let font = style.font
				return false when font is none
				return font.weight == FontWeight.Bold
			}

			def wraps() bool {
				return !(style.paragraph is none)
			}

			def size() float {
				return em
			}
		}

		view {}

		style {
			Box
			Typography
		}
	}

	// A box without typography between a style that sets it and one that inherits it.
	component InheritBox {
		view {
			children()
		}

		style {
			Box
		}
	}

	component InheritGreen {
		view {
			children()
		}

		style {
			Box
			Typography
			foreground = inheritGreen
			font       = Font{family: "monospace", size: 1.5(em)}
		}
	}

	component InheritTree {
		type {}

		view {
			InheritLeaf(ref = direct)
			InheritBox() {
				InheritLeaf(ref = through)
			}
			InheritGreen() {
				InheritLeaf(ref = shadowed)
				InheritBox() {
					InheritGreen() {
						InheritLeaf(ref = deepest)
					}
				}
			}
		}

		style {
			Box
			Typography
			foreground = inheritRed
			font       = Font{family: "serif", size: 20(px)}
			paragraph  = ParagraphLayout{}
		}
	}

	// Names one field of the font: the others are those of the font above.
	component InheritBold {
		view {
			children()
		}

		style {
			Box
			Typography
			font = {weight: FontWeight.Bold}
		}
	}

	component InheritLarge {
		view {
			children()
		}

		style {
			Box
			Typography
			font = {size: 2(em)}
		}
	}

	component InheritFields {
		type {}

		view {
			InheritBold(ref = heavy) {
				InheritLeaf(ref = bold)
				InheritLarge() {
					InheritLeaf(ref = large)
				}
			}
		}

		style {
			Box
			Typography
			font = Font{family: "serif", size: 20(px)}
		}
	}

	check "Inherited style properties" {
		// A property a style leaves unset reads, through the component's `style`, as the
		// nearest style above has it, past components whose style lacks the property.
		@test()
		def TestUnsetPropertiesTakeTheNearestStyleAbove() {
			let tree = InheritTree()
			let scene = new Scene(tree)
			let size = new Size<Pixels>(200(px), 200(px))
			scene.arrange(size)
			let (direct, through, shadowed, deepest) = (tree.direct, tree.through, tree.shadowed, tree.deepest)
			assert !(direct is none) && !(through is none) && !(shadowed is none) && !(deepest is none)
			return when direct is none || through is none || shadowed is none || deepest is none
			assert direct.ink() == inheritRed && direct.family() == "serif" && direct.wraps()
			assert through.ink() == inheritRed && through.family() == "serif" && through.wraps()
			// The nearer style wins for what it sets and passes on what it does not.
			assert shadowed.ink() == inheritGreen && shadowed.family() == "monospace" && shadowed.wraps()

			// The style itself holds only what was assigned to it.
			let held = direct.style
			if held is Lettered {
				assert held.font is none
			}

			// A value assigned above shows at the next layout.
			tree.style.foreground = inheritBlue
			scene.arrange(size)
			assert direct.ink() == inheritBlue && through.ink() == inheritBlue && shadowed.ink() == inheritGreen

			// A value of its own replaces the inherited one, and unsetting it takes it back.
			direct.style.foreground = inheritGreen
			assert direct.ink() == inheritGreen
			scene.arrange(size)
			assert direct.ink() == inheritGreen && through.ink() == inheritBlue
			direct.style.foreground = none
			scene.arrange(size)
			assert direct.ink() == inheritBlue
		}

		// A font size in `em` is of the font size around the style that sets it, once:
		// the components that inherit the font have that size, not the factor again.
		@test()
		def TestRelativeFontSizeIsResolvedWhereItIsSet() {
			let tree = InheritTree()
			let scene = new Scene(tree)
			scene.arrange(new Size<Pixels>(200(px), 200(px)))
			let (direct, through, shadowed, deepest) = (tree.direct, tree.through, tree.shadowed, tree.deepest)
			return when direct is none || through is none || shadowed is none || deepest is none
			assert tree.em == 20.0 && direct.size() == 20.0 && through.size() == 20.0
			assert shadowed.size() == 30.0
			assert deepest.size() == 45.0
		}

		// `font = {weight: FontWeight.Bold}` names the weight: the family and the size
		// stay those of the font above, and follow it when it changes.
		@test()
		def TestAFontIsInheritedFieldByField() {
			let tree = InheritFields()
			let scene = new Scene(tree)
			let size = new Size<Pixels>(200(px), 200(px))
			scene.arrange(size)
			let (heavy, bold, large) = (tree.heavy, tree.bold, tree.large)
			assert !(heavy is none) && !(bold is none) && !(large is none)
			return when heavy is none || bold is none || large is none
			assert bold.family() == "serif" && bold.bold() && bold.size() == 20.0 && heavy.em == 20.0
			// A size named below is of the size around it; the weight comes through.
			assert large.family() == "serif" && large.bold() && large.size() == 40.0

			tree.style.font = Font{family: "monospace", size: 10(px)}
			scene.arrange(size)
			assert bold.family() == "monospace" && bold.bold() && bold.size() == 10.0
			assert large.family() == "monospace" && large.size() == 20.0

			// The style itself holds what it named, and nothing while a layout made no font.
			let held = heavy.style
			if held is Lettered {
				let own = held.font
				assert !(own is none)
				assert own.weight == FontWeight.Bold && own.family == "" unless own is none
			}
		}
	}
}
