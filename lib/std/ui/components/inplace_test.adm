partial module std.ui.components {
	use (
		std.math.geom::Size
		std.testing
		std.ui.runtime::Scene
		std.ui.styles::*
		std.units::Pixels
	)

	// Shows how many entries the map it is given holds, and passes the map on.
	component TallyShown {
		type {
			@input
			counts map<string, int> = map<string, int>{}
		}

		view {
			Text("{counts.len()}", ref = line)
			TallyDeeper(counts = counts, ref = deeper)
		}

		style StageStyle
	}

	// Shows how many entries the map its parent passed on holds.
	component TallyDeeper {
		type {
			@input
			counts map<string, int> = map<string, int>{}
		}

		view {
			Text("{counts.len()}", ref = line)
		}

		style StageStyle
	}

	// Shows how many items the array it is given holds.
	component ItemsShown {
		type {
			@input
			items string[] = []
		}

		view {
			Text("{items.len()}", ref = line)
		}

		style StageStyle
	}

	// Holds a map and an array as states and changes them in place.
	component Tally {
		type {
			@state
			counts map<string, int> = map<string, int>{}

			@state
			items string[] = []

			def bump() {
				counts["k{counts.len()}"] = counts.len()
			}

			def add(item string) {
				items.push(item)
			}
		}

		view {
			TallyShown(counts = counts, ref = shown)
			ItemsShown(items = items, ref = listed)
		}

		style StageStyle
	}

	internal struct Chore {
		name string
		done bool
	}

	// One chore, as done or still to do.
	component ChoreRow {
		type {
			@input
			chore Chore = Chore{}
		}

		view {
			Text(chore.done ?? ("{chore.name} done", chore.name), ref = line)
		}

		style StageStyle
	}

	// Its chores as a state, one row each.
	component Chores {
		type {
			@state
			chores Chore[] = [Chore{name: "sweep"}, Chore{name: "cook"}]

			// Done in place: the chore the row was given is the one that changes.
			def complete(name string) {
				for let chore in chores {
					chore.done = true when chore.name == name
				}
			}
		}

		view {
			for let chore in chores {
				ChoreRow(chore = chore, key = chore.name)
			}
		}

		style StageStyle
	}

	internal def textOf(c ?Text) string {
		return c is none ?? ("", c.text)
	}

	check "State changed in place" {
		// A `@state` map changed in place reaches the child that takes it as an input
		// and the grandchild the child passes it to, at the next frame; so does an
		// array a method of the prelude changes in place.
		@test()
		def TestAStateChangedInPlaceReachesTheChildren() {
			let page = Tally()
			let scene = new Scene(page)
			let size = new Size<Pixels>(300(px), 200(px))
			scene.arrange(size)
			let (shown, listed) = (page.shown, page.listed)
			assert !(shown is none) && !(listed is none)
			return when shown is none || listed is none
			let deeper = shown.deeper
			assert !(deeper is none)
			return when deeper is none
			assert textOf(shown.line) == "0" && textOf(deeper.line) == "0" && textOf(listed.line) == "0"

			page.bump()
			page.bump()
			scene.arrange(size)
			assert textOf(shown.line) == "2" && textOf(deeper.line) == "2"

			page.add("a")
			scene.arrange(size)
			assert textOf(listed.line) == "1" && textOf(shown.line) == "2"
		}

		// A member of an element changed through the loop's variable reaches the row
		// the view's loop gave that element.
		@test()
		def TestAnElementChangedInPlaceReachesItsRow() {
			let page = Chores()
			let scene = new Scene(page)
			let size = new Size<Pixels>(300(px), 200(px))
			scene.arrange(size)
			let rows = page.childNodes
			assert rows.len() == 2
			return when rows.len() != 2
			let line = def (row component) string {
				let shown = row.find<Text>()
				return textOf(shown)
			}
			assert line(rows[0]) == "sweep" && line(rows[1]) == "cook"
			page.complete("cook")
			scene.arrange(size)
			assert line(rows[0]) == "sweep" && line(rows[1]) == "cook done"
		}
	}
}
