partial module std.ui.components {
	use (
		std.math.geom::(Size)
		std.testing
		std.ui.runtime::Scene
		std.ui.styles::*
		std.units::Pixels
	)

	internal let keyedHeard = string[]

	// A child with a state and a handler, the two things a view does not give again
	// when a child stays: they show whose child it is.
	component KeyedLeaf {
		type {
			@input
			name string = ""

			@state
			typed string = ""

			@input
			onPress ?def() = none

			def press() {
				let f = onPress
				f() unless f is none
			}
		}

		view {
			Text(name)
		}

		style StageStyle
	}

	component KeyedBox {
		view {
			children()
		}

		style StageStyle
	}

	// What a keyed child's block holds: a call, a branch, a loop and a keyed call in it.
	component KeyedRows {
		type {
			@state
			names string[] = ["a", "b", "c", "d"]

			@state
			extra bool = true

			def fire(n string) {
				keyedHeard.push(n)
			}
		}

		view {
			for let n in names {
				KeyedBox(key = n) {
					KeyedLeaf(name = n, onPress = () => fire(n))
					if extra && n != "d" {
						KeyedLeaf(name = n + "x", onPress = () => fire(n + "x"))
					}
					for let m in ["1", "2"] {
						KeyedBox(key = m) {
							KeyedLeaf(name = n + m, onPress = () => fire(n + m))
						}
					}
				}
			}
		}

		style StageStyle
	}

	component KeyedShelf {
		type {
			@input
			items string[] = []
		}

		view {
			Text("{items.len()}")
		}

		style StageStyle
	}

	// An argument in a keyed child's block from a field its view's component changes in place.
	component KeyedShelves {
		type {
			@state
			names string[] = ["a", "b"]

			@state
			items string[] = ["x"]
		}

		view {
			for let n in names {
				KeyedBox(key = n) {
					KeyedShelf(items = items)
				}
			}
		}

		style StageStyle
	}

	component KeyedOne {
		type {
			@state
			which string = "a"

			def fire(n string) {
				keyedHeard.push(n)
			}
		}

		view {
			KeyedBox(key = which) {
				KeyedLeaf(name = which, onPress = () => fire(which))
			}
		}

		style StageStyle
	}

	component KeyedRowsList {
		type {
			names string[] = ["a", "b", "c", "d"]

			def fire(n string) {
				keyedHeard.push(n)
			}
		}

		view {
			List(names) {
				rowRenderer = (it RowItem<string>) => KeyedLeaf(name = it.content, onPress = () => fire(it.content))
			}
		}

		style StageStyle
	}

	check "Keyed content" {
		def leavesOf(c component, out KeyedLeaf[]) {
			for let k in c.childNodes {
				out.push(k) when k is KeyedLeaf
				leavesOf(k, out)
			}
		}

		// Each leaf under c as `name/typed/what its handler says`.
		def shown(c component) string {
			let leaves KeyedLeaf[]
			leavesOf(c, leaves)
			let parts string[]
			for let leaf in leaves {
				keyedHeard.len(0)
				leaf.press()
				parts.push("{leaf.name}/{leaf.typed}/{keyedHeard.join(",")}")
			}
			return parts.join(" ")
		}

		def typeInEvery(c component) {
			let leaves KeyedLeaf[]
			leavesOf(c, leaves)
			for let leaf in leaves {
				leaf.typed = leaf.name
			}
		}

		def settle(scene Scene) {
			let size = new Size<Pixels>(200(px), 100(px))
			scene.arrange(size)
			scene.arrange(size)
		}

		// A keyed child moved by its key keeps what its block placed, with the state
		// and the handler of that key's content, whatever the block holds.
		@test()
		def TestBlockFollowsTheKey() {
			let page = KeyedRows()
			let scene = new Scene(page)
			settle(scene)
			typeInEvery(page)
			page.names = ["c", "d"]
			settle(scene)
			assert shown(page) == "c/c/c cx/cx/cx c1/c1/c1 c2/c2/c2 d/d/d d1/d1/d1 d2/d2/d2"
		}

		// A key that comes back is a new child with nothing kept, and the others keep theirs.
		@test()
		def TestKeyThatComesBackStartsOver() {
			let page = KeyedRows()
			let scene = new Scene(page)
			settle(scene)
			typeInEvery(page)
			page.names = ["c", "d"]
			settle(scene)
			page.names = ["d", "a", "c"]
			settle(scene)
			assert shown(page) == "d/d/d d1/d1/d1 d2/d2/d2 a//a ax//ax a1//a1 a2//a2 c/c/c cx/cx/cx c1/c1/c1 c2/c2/c2"
		}

		// A branch of the block closes in each child that has it.
		@test()
		def TestBranchInTheBlockCloses() {
			let page = KeyedRows()
			let scene = new Scene(page)
			settle(scene)
			typeInEvery(page)
			page.names = ["c", "d"]
			page.extra = false
			settle(scene)
			assert shown(page) == "c/c/c c1/c1/c1 c2/c2/c2 d/d/d d1/d1/d1 d2/d2/d2"
		}

		// A field changed in place reaches what a keyed child's block places.
		@test()
		def TestInPlaceChangeReachesTheBlock() {
			let page = KeyedShelves()
			let scene = new Scene(page)
			settle(scene)
			page.items.push("y")
			settle(scene)
			let shown string[]
			for let box in page.childNodes {
				for let shelf in box.childNodes {
					shown.push("{shelf.children.len()}")
				}
			}
			assert shown.len() == 2
		}

		// Outside a loop another key is another child, with a block of its own.
		@test()
		def TestAnotherKeyStartsOver() {
			let page = KeyedOne()
			let scene = new Scene(page)
			settle(scene)
			typeInEvery(page)
			page.which = "b"
			settle(scene)
			assert shown(page) == "b//b"
		}

		// A list's rows are keyed by their items: narrowing keeps what a row shows and
		// what it does together, with no key in `rowRenderer`.
		@test()
		def TestListRowKeepsItsHandler() {
			let page = KeyedRowsList()
			let scene = new Scene(page)
			settle(scene)
			typeInEvery(page)
			page.names = ["c", "d"]
			settle(scene)
			assert shown(page) == "c/c/c d/d/d"
		}
	}
}
