partial module std.ui.components {
	use (
		std.math.geom::Size
		std.ui::(Limit, PointerEvent, RenderContext, Theme, UI)
		std.ui.paint
		std.ui.styles::*
		std.units::Pixels
	)

	// The name of a control: `Label("Email")` before a `TextField`. A press on it gives
	// the keyboard focus to the control it names: `target`, or the component placed after
	// it when none is given.
	component Label {
		type {
			// What it shows.
			@input(value = true)
			text string = ""

			// The control it names; none: the component placed after it.
			@input
			target ?component = none

			block ?paint.TextBlock = none
			look  Theme = UI.theme()

			// The control it names.
			def named() ?component {
				let given = target
				return given unless given is none
				return next()
			}

			// Gives the focus to the control it names.
			def aim() {
				let control = named()
				control.focus() unless control is none
			}

			def current() paint.TextBlock {
				let made = controlLabel(block, text, style.font, style.foreground, style.paragraph, look, !disabled)
				block = made
				return made
			}

			def measure(limit Limit) Size<Pixels> {
				return current().measure(limit)
			}

			def firstBaseline() ?Pixels {
				return baselineOf(current())
			}

			def pointer(e PointerEvent) bool {
				return pressRuns(e, style.geom, !disabled, aim)
			}

			def render(ctx RenderContext) {
				paint.drawBlock(ctx.draw, current(), ctx.geometry.content.toFloat(), style.align, ctx.direction == Direction.RightToLeft, ctx.scale)
			}
		}

		view {}

		style ControlStyle
	}
}
