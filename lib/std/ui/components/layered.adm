partial module std.ui.components {
	use std.ui.styles::*

	// Puts its children on top of each other, each given its whole box, the last on top:
	// `Layered() { Image(photo); Badge("new") }`.
	component Layered {
		view {
			children()
		}

		style {
			ColumnStyle
			arrange = Arrange.Layered
		}
	}
}
