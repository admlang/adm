partial module std.ui.components {
	use (
		std.gfx.color::Color
		std.services.clipboard::Clipboard
		std.services.runtime::Runtime
		std.math.geom::(Rect, Size)
		std.ui::(Limit, RenderContext, Theme, UI)
		std.ui.navigation::Router
		std.ui.paint
		std.ui.styles::*
		std.units::Pixels
	)

	// Text that goes somewhere when pressed: `Link("Units", to = "/docs/units")` goes to that
	// location through the window's `Router` (std.ui.navigation), `Link("Open the docs",
	// onClick = openDocs)` runs what it is given. It is drawn in the theme's link colour,
	// underlined under the pointer and with the focus, and is pressed with the pointer,
	// Space or Enter. A link with `to` shows where it goes as its tooltip and offers
	// "Copy link" on the secondary button.
	component Link {
		type {
			// The text.
			@input(value = true)
			label string = ""

			// Where it goes: a location of the application (`/docs/units?tab=examples`),
			// or with `external` an address the desktop opens (`https://adm-lang.dev/`).
			// Empty: nowhere, `onClick` alone.
			@input
			to string = ""

			// `to` is outside the application.
			@input
			external bool = false

			block ?paint.TextBlock = none
			look  Theme = UI.theme()

			def new() {
				tooltip = to when tooltip == "" && to != ""
			}

			// Goes to `to` when it is clicked, before `onClick` runs, and tells every
			// listener: heard with `@on(Link.clicked)`. An `external` one is opened by the
			// desktop (`Runtime.open`, which needs the `open` permission); one it cannot
			// open does nothing.
			@emit()
			def clicked() {
				return when to == ""
				if external {
					Runtime.open(to) onerror recover none
					return
				}
				let router = context<Router>()
				router.go(to) unless router is none
			}

			// Puts `to` on the clipboard.
			def copyLink() {
				Clipboard.copy(to) onerror recover none
			}

			def current() paint.TextBlock {
				let made = labelBlock(block, label, style.font, em * 1(px), style.foreground, style.paragraph, look.palette.link, decoration = style.decoration)
				block = made
				return made
			}

			def measure(limit Limit) Size<Pixels> {
				return current().measure(limit)
			}

			def firstBaseline() ?Pixels {
				return current().firstBaseline()
			}

			def render(ctx RenderContext) {
				let area = ctx.geometry.content.toFloat()
				paint.drawBlock(ctx.draw, current(), area, Align{}, ctx.direction == Direction.RightToLeft, ctx.scale)
				// The line under it, when its style asks for one, in the text's colour unless
				// the decoration names its own.
				let lines = style.decoration
				if lines.underline {
					let thick = float(look.metrics.borderWidth)
					let ink = inkOf(style.foreground, look.palette.link)
					let own = lines.paint
					ink = own when own is Color
					ctx.draw.fill(Rect{left: area.left, top: area.bottom - thick, right: area.right, bottom: area.bottom}, ink)
				}
			}
		}

		// Its block holds what attaches to it: a `HoverCard`, a `ContextMenu`.
		view {
			if to != "" {
				ContextMenu() {
					MenuItem("Copy link", onActivate = copyLink)
				}
			}
			children()
		}

		style {
			ControlStyle
			cursor     = Cursor.Pointer
			foreground = theme.palette.link
			// Underlined under the pointer and with the keyboard focus.
			on = {
				hover:        {decoration: Decoration{underline: true}},
				focusVisible: {decoration: Decoration{underline: true}},
				disabled:     {foreground: theme.palette.foregroundDisabled},
			}
		}
	}
}
