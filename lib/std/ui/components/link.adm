partial module std.ui.components {
	use (
		std.math.geom::(Rect, Size)
		std.ui::(KeyEvent, Limit, PointerEvent, RenderContext, Theme, UI)
		std.ui.paint
		std.ui.styles::*
		std.units::Pixels
	)

	// Text that goes somewhere when pressed: `Link(label = "Open the docs", onClick = openDocs)`.
	// It is drawn in the theme's link colour, underlined under the pointer and with the
	// focus, and is pressed with the pointer, Space or Enter.
	component Link {
		type {
			// The text.
			@input(value = true)
			label string = ""

			// Runs when it is pressed.
			@input
			onClick ?(def()) = none

			block ?paint.TextBlock = none
			look  Theme = UI.theme()

			def new() {
				focusable = true
				tabStop   = true
			}

			// Tells every listener it was activated, after `onClick` ran: heard with
			// `@on(Link.clicked)`.
			@emit()
			def clicked() bool {
				return true
			}

			// Runs what the link is for.
			def press() {
				return when disabled
				let run = onClick
				run() unless run is none
				clicked()
			}

			def current() paint.TextBlock {
				let palette = look.palette
				let made = labelBlock(block, label, style.font, style.foreground, style.paragraph, !disabled ?? (palette.link, palette.foregroundDisabled))
				block = made
				return made
			}

			def measure(limit Limit) Size<Pixels> {
				return current().measure(limit)
			}

			def firstBaseline() ?Pixels {
				return baselineOf(current())
			}

			def pointer(e PointerEvent) bool {
				return pressRuns(e, style.geom, !disabled, press)
			}

			def key(e KeyEvent) bool {
				return false when !e.down
				return keyRuns(e, !disabled, press)
			}

			def render(ctx RenderContext) {
				let area = ctx.geometry.content.toFloat()
				paint.drawBlock(ctx.draw, current(), area, Align{}, ctx.direction == Direction.RightToLeft, ctx.scale)
				// The line under it: under the pointer and with the keyboard focus.
				if !disabled && (hover || focusVisible) {
					let thick = float(look.metrics.borderWidth)
					ctx.draw.fill(Rect{left: area.left, top: area.bottom - thick, right: area.right, bottom: area.bottom}, look.palette.link)
				}
			}
		}

		view {}

		style {
			ControlStyle
			cursor = Cursor.Pointer
		}
	}
}
